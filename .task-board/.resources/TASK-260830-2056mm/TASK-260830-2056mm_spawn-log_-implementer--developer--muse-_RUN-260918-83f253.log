title and its first subheading.\\n1078:func sectionClauseInventory(document *specdoc.Document, key string) ([]normativeClause, error) {\\n1079-\\tidentifier, err := sectionDocumentIdentifier(key)\\n1080-\\tif err != nil {\\n1081-\\t\\treturn nil, err\\n1082-\\t}\\n1083-\\tprefix := identifier + \\\".\\\"\\n1084-\\tvar result []normativeClause\\n1085-\\tfor line := 1; line <= document.LineCount(); line++ {\\n1086-\\t\\towner, ok := document.SectionID(line)\\n1087-\\t\\tif !ok || (owner != identifier && !strings.HasPrefix(owner, prefix)) {\\n1088-\\t\\t\\tcontinue\\n1089-\\t\\t}\\n1090-\\t\\ttext, ok := document.Line(line)\\n1091-\\t\\tif !ok {\\n1092-\\t\\t\\treturn nil, fmt.Errorf(\\\"pinned document line %d is unreadable\\\", line)\\n1093-\\t\\t}\\n1094-\\t\\tif !normativeKeywordPattern.MatchString(text) {\\n1095-\\t\\t\\tcontinue\\n1096-\\t\\t}\\n1097-\\t\\tresult = append(result, normativeClause{\\n1098-\\t\\t\\tID:   fmt.Sprintf(\\\"%s#%d\\\", identifier, len(result)+1),\\n1099-\\t\\t\\tLine: line,\\n1100-\\t\\t\\tText: strings.TrimSpace(text),\\n1101-\\t\\t})\\n1102-\\t}\\n1103-\\treturn result, nil\\n1104-}\\n1105-\\n1106-// coverageBucket is the measured coverage level. It is computed from the two\\n1107-// counts and never read from the registry.\\n1108:func coverageBucket(discharged, total int) coverageLevel {\\n1109-\\tswitch {\\n1110-\\tcase total == 0:\\n1111-\\t\\treturn coverageUnmeasured\\n1112-\\tcase discharged == 0:\\n1113-\\t\\treturn coverageUnevidenced\\n1114-\\tcase discharged >= total:\\n1115-\\t\\treturn coverageFull\\n1116-\\tcase discharged*2 >= total:\\n1117-\\t\\treturn coveragePartial\\n1118-\\tdefault:\\n1119-\\t\\treturn coverageSliver\\n1120-\\t}\\n1121-}\\n1122-\\n1123-// sectionCoverage is the measured result for one section binding.\\n1124-type sectionCoverage struct {\\n1125-\\tKey        string\\n1126-\\tLevel      coverageLevel\\n1127-\\tDischarged int\\n1128-\\tTotal      int\\n1129-\\tGap        string\\n1130-}\\n1131-\\n1132-// Ratio renders the measured coverage as the ratio it was computed from, so a\\n1133-// report never has to describe coverage in prose.\\n1134-func (coverage sectionCoverage) Ratio() string {\\n1135-\\treturn fmt.Sprintf(\\\"%d/%d\\\", coverage.Discharged, coverage.Total)\\n1136-}\\n1137-\\n1138-// verifySectionBindingCoverage measures one section binding against the pinned\\n\",\n  \"original_output_bytes\": 2930,\n  \"original_output_tokens\": 733,\n  \"truncated\": false\n}","final_result":true}}}
