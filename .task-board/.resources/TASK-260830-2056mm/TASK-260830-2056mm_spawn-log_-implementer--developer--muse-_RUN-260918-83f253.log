{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000df37","stream":{"kind":"session","id":"01a0b35d-fadf-7f82-925c-5ba6aefcf0a7"},"sequence":3574,"recorded_at":1780531400007143,"record_type":"event","durability":"durable","causation_id":"38ee7473-f77a-4937-9e67-866e0a213216","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38ee7473-f77a-4937-9e67-866e0a213216","run_stream":{"kind":"run","id":"38ee7473-f77a-4937-9e67-866e0a213216"},"task_stream":{"kind":"task","id":"01a0b378-6d9a-78b3-8375-548a7cbde370"},"task_id":"01a0b378-6d9a-78b3-8375-548a7cbde370","event":{"kind":"output","task_id":"01a0b378-6d9a-78b3-8375-548a7cbde370","chunk":"{\n  \"chunk_id\": \"exec-81-1\",\n  \"command\": \"grep -n \\\"TestEmitUnderLosingLeaseRefuses\\\" -A 60 internal/axpane/rework_test.go | head -n 75\",\n  \"description\": \"Read losing lease test\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"430:// TestEmitUnderLosingLeaseRefuses pins P1-1 (probe 9): Emit under a\\n431-// losing lease refuses at the AuthorizeMutation gate, never\\n432-// appends. The chain is foldable (failed), so the refusal comes\\n433-// from the mutation gate itself — not_owner under a remote winner,\\n434-// stale_owner under a local successor — and never from the fold\\n435-// pre-check. On rev1 (no mutation gate) this appended.\\n436:func TestEmitUnderLosingLeaseRefuses(t *testing.T) {\\n437-\\tt.Parallel()\\n438-\\tt.Run(\\\"remote\\\", func(t *testing.T) {\\n439-\\t\\tt.Parallel()\\n440-\\t\\tworld := buildRunWorld(t)\\n441-\\t\\tfailedID := appendChainEvent(t, world.repo, \\\"session.failed\\\", 1, fixtureLeaseA, 2, world.headID, map[string]any{\\n442-\\t\\t\\t\\\"error_code\\\": \\\"bootstrap_probe\\\", \\\"retryable\\\": false, \\\"operation_id\\\": nil,\\n443-\\t\\t})\\n444-\\t\\tsuccessorLease(t, world.repo, fixtureLeaseB, fixtureRemoteHost, seedDigest(0xC9))\\n445-\\t\\tobservation, err := ObserveOwnership(world.repo, fixtureSession, runObserve(fixtureNow()))\\n446-\\t\\tif err != nil {\\n447-\\t\\t\\tt.Fatal(err)\\n448-\\t\\t}\\n449-\\t\\tdecision := Decision{Action: ActionParked, ParkReason: fencing.ParkStaleOwner, WinningLeaseID: fixtureLeaseB}\\n450-\\t\\t_, _, err = EmitParked(world.repo, decision, EmitParams{\\n451-\\t\\t\\tSessionID: fixtureSession, CreatedByHost: fixtureLocalHost,\\n452-\\t\\t\\tLeaseEpoch: 1, LeaseID: fixtureLeaseA, LeaseSequence: 3,\\n453-\\t\\t\\tPredecessors: []string{failedID}, CreatedAt: fixtureCreatedAt,\\n454-\\t\\t\\tPresented:   fencing.PresentedToken{SessionID: fixtureSession, Epoch: 1, LeaseID: fixtureLeaseA},\\n455-\\t\\t\\tObservation: observation,\\n456-\\t\\t})\\n457-\\t\\tif err == nil {\\n458-\\t\\t\\tt.Fatal(\\\"EmitParked under losing lease succeeded, want refusal\\\")\\n459-\\t\\t}\\n460-\\t\\tif !errors.Is(err, fencing.ErrNotOwner) {\\n461-\\t\\t\\tt.Fatalf(\\\"EmitParked under losing lease error = %v, want the not_owner mutation refusal\\\", err)\\n462-\\t\\t}\\n463-\\t\\tif strings.Contains(err.Error(), \\\"does not fold\\\") {\\n464-\\t\\t\\tt.Fatalf(\\\"EmitParked refused at the fold pre-check (%v), want the mutation gate\\\", err)\\n465-\\t\\t}\\n466-\\t})\\n467-\\tt.Run(\\\"local\\\", func(t *testing.T) {\\n468-\\t\\tt.Parallel()\\n469-\\t\\tworld := buildRunWorld(t)\\n470-\\t\\tfailedID := appendChainEvent(t, world.repo, \\\"session.failed\\\", 1, fixtureLeaseA, 2, world.headID, map[string]any{\\n471-\\t\\t\\t\\\"error_code\\\": \\\"bootstrap_probe\\\", \\\"retryable\\\": false, \\\"operation_id\\\": nil,\\n472-\\t\\t})\\n473-\\t\\tsuccessor := \\\"cccccccc-dddd-4eee-8fff-000000000001\\\"\\n474-\\t\\tsuccessorLease(t, world.repo, successor, fixtureLocalHost, seedDigest(0xC9))\\n475-\\t\\tobservation, err := ObserveOwnership(world.repo, fixtureSession, runObserve(fixtureNow()))\\n476-\\t\\tif err != nil {\\n477-\\t\\t\\tt.Fatal(err)\\n478-\\t\\t}\\n479-\\t\\tdecision := Decision{Action: ActionParked, ParkReason: fencing.ParkStaleOwner, WinningLeaseID: successor}\\n480-\\t\\t_, _, err = EmitParked(world.repo, decision, EmitParams{\\n481-\\t\\t\\tSessionID: fixtureSession, CreatedByHost: fixtureLocalHost,\\n482-\\t\\t\\tLeaseEpoch: 1, LeaseID: fixtureLeaseA, LeaseSequence: 3,\\n483-\\t\\t\\tPredecessors: []string{failedID}, CreatedAt: fixtureCreatedAt,\\n484-\\t\\t\\tPresented:   fencing.PresentedToken{SessionID: fixtureSession, Epoch: 1, LeaseID: fixtureLeaseA},\\n485-\\t\\t\\tObservation: observation,\\n486-\\t\\t})\\n487-\\t\\tif err == nil {\\n488-\\t\\t\\tt.Fatal(\\\"EmitParked under losing lease succeeded, want refusal\\\")\\n489-\\t\\t}\\n490-\\t\\tif !errors.Is(err, fencing.ErrStaleOwner) {\\n491-\\t\\t\\tt.Fatalf(\\\"EmitParked under losing lease error = %v, want the stale_owner mutation refusal\\\", err)\\n492-\\t\\t}\\n493-\\t\\tif strings.Contains(err.Error(), \\\"does not fold\\\") {\\n494-\\t\\t\\tt.Fatalf(\\\"EmitParked refused at the fold pre-check (%v), want the mutation gate\\\", err)\\n495-\\t\\t}\\n496-\\t})\\n\",\n  \"original_output_bytes\": 3523,\n  \"original_output_tokens\": 881,\n  \"truncated\": false\n}","final_result":true}}}
