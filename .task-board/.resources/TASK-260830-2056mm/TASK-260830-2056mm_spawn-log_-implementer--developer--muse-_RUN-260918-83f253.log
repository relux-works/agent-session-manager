|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\"\n394|    if mutant.find2:\n395|        found2 = original.count(mutant.find2)\n396|        if found2 != mutant.count2:\n397|            return f\"ERROR: {mutant.name}: second anchors {found2}, want {mutant.count2}\"\n398|    with tempfile.TemporaryDirectory() as staging:\n399|        backup = Path(staging) / \"backup\"\n400|        shutil.copy2(target, backup)\n401|        try:\n402|            target.write_text(apply(mutant, original))\n403|            run = subprocess.run(\n404|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n405|                cwd=REPO,\n406|                capture_output=True,\n407|                text=True,\n408|                timeout=300,\n409|            )\n410|        finally:\n411|            shutil.copy2(backup, target)\n412|    output = (run.stdout + run.stderr).strip()\n413|    if os.environ.get(\"AX_MUTANT_VERBOSE\") == \"1\":\n414|        print(f\"--- raw: {mutant.name}: exit {run.returncode} ---\", flush=True)\n415|        print(output, flush=True)\n416|        print(f\"--- end raw: {mutant.name} ---\", flush=True)\n417|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n418|        return f\"ERROR: {mutant.name}: build broke under the patch\"\n419|    if run.returncode == 0:\n420|        verdict = \"SURVIVED\"\n421|    elif '--- FAIL' in output or 'FAIL:' in output:\n422|        verdict = \"KILLED\"\n423|    else:\n424|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\"\n425|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n426|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note} [exit {run.returncode}]\"\n427|\n428|\n429|def main(argv: list[str]) -> int:\n430|    selected = [m for m in MUTANTS if not argv or m.name in argv]\n431|    if argv and len(selected) != len(argv):\n432|        unknown = sorted(set(argv) - {m.name for m in selected})\n433|        print(f\"unknown mutants: {', '.join(unknown)}\")\n434|        return 2\n435|    failures = 0\n436|    for mutant in selected:\n437|        try:\n438|            line = run_mutant(mutant)\n439|        except subprocess.TimeoutExpired:\n440|            line = f\"ERROR: {mutant.name}: killer timed out\"\n441|        print(line, flush=True)\n442|        if not line.startswith(\"ok:\"):\n443|            failures += 1\n444|    return 1 if failures else 0\n445|\n446|\n447|if __name__ == \"__main__\":\n448|    sys.exit(main(sys.argv[1:]))","final_result":true}}}
