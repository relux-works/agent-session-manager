/sessrepo/sessrepo.go:30:\\tErrStaleLease      = errors.New(\\\"event lease epoch precedes the chain head\\\")\\ninternal/sessrepo/sessrepo.go:31:\\tErrChainCorrupt    = errors.New(\\\"session event chain is corrupt\\\")\\ninternal/sessrepo/sessrepo.go:313:\\t\\tif errors.Is(err, ErrDivergentBranch) || errors.Is(err, ErrStaleLease) {\\n===DECODE-REDUCE===\\ninternal/sessstate/decode.go:25:func DecodeRecord(recordJSON []byte) (Record, error) {\\ninternal/sessstate/decode.go:78:func DecodeEvent(eventJSON []byte) (Event, error) {\\ninternal/sessstate/decode.go:162:func stringMember(members map[string]json.RawMessage, name string) (string, error) {\\ninternal/sessstate/decode.go:177:func digestMembers(members map[string]json.RawMessage, name string) ([]string, error) {\\ninternal/sessstate/decode.go:196:func objectMember(members map[string]json.RawMessage, name string) (map[string]any, error) {\\ninternal/sessstate/decode.go:209:func payloadString(payload map[string]any, name string) (string, error) {\\ninternal/sessstate/decode.go:222:func payloadBool(payload map[string]any, name string) (bool, error) {\\ninternal/sessstate/decode.go:237:func payloadUint(payload map[string]any, name string) (uint64, error) {\\ninternal/sessstate/decode.go:252:func payloadNullableDigest(payload map[string]any, name string) (string, bool, error) {\\ninternal/sessstate/sessstate.go:40:func States() []string {\\ninternal/sessstate/sessstate.go:132:func (head LeaseHead) IsZero() bool {\\ninternal/sessstate/sessstate.go:140:func Compare(a, b LeaseHead) int {\\ninternal/sessstate/sessstate.go:303:func Reduce(input Input) (Projection, error) {\\ninternal/sessstate/sessstate.go:369:func (fold *chainFold) apply(event Event) error {\\ninternal/sessstate/sessstate.go:395:func what(event Event) string {\\ninternal/sessstate/sessstate.go:405:func (fold *chainFold) successionMove(name string) error {\\ninternal/sessstate/sessstate.go:421:func (fold *chainFold) checkContinuity(event Event) error {\\ni