{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ee49","stream":{"kind":"session","id":"01a0b35d-fadf-7f82-925c-5ba6aefcf0a7"},"sequence":5503,"recorded_at":1780531400011001,"record_type":"event","durability":"durable","causation_id":"38ee7473-f77a-4937-9e67-866e0a213216","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38ee7473-f77a-4937-9e67-866e0a213216","run_stream":{"kind":"run","id":"38ee7473-f77a-4937-9e67-866e0a213216"},"task_stream":{"kind":"task","id":"01a0b386-7f31-7af0-bd6d-6a62ccce75ef"},"task_id":"01a0b386-7f31-7af0-bd6d-6a62ccce75ef","event":{"kind":"output","task_id":"01a0b386-7f31-7af0-bd6d-6a62ccce75ef","chunk":"{\n  \"chunk_id\": \"exec-141-1\",\n  \"command\": \"python3 -c \\\"\\nimport json\\nd = json.load(open('internal/traceability/ownership.v0.7.0.json'))\\nfor e in d['ownership']:\\n    keys = ' '.join(e.get('keys', []))\\n    if any(s in keys for s in ['section:4', 'section:5.2', 'section:7', 'section:13']):\\n        print(json.dumps(e, indent=1)[:1600])\\n        print('---')\\n\\\"\",\n  \"description\": \"Show current bindings for story sections\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:4.B\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/catalog/catalog.go\\\",\\n  \\\"declaration\\\": \\\"ForRelease\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"catalog-v050-exact\\\"\\n ],\\n \\\"coverage\\\": \\\"unevidenced\\\",\\n \\\"gap\\\": \\\"ForRelease only returns the reviewed typed catalog rows that reference 4.B; no clause of 4.B is enumerated against an acceptance case, so the registry makes no clause-level claim about the 12 obligations it carries.\\\"\\n}\\n---\\n{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:4.C\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/catalog/catalog.go\\\",\\n  \\\"declaration\\\": \\\"ForRelease\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"catalog-v050-exact\\\"\\n ],\\n \\\"coverage\\\": \\\"unevidenced\\\",\\n \\\"gap\\\": \\\"ForRelease only returns the reviewed typed catalog rows that reference 4.C; no clause of 4.C is enumerated against an acceptance case, so the registry makes no clause-level claim about the 7 obligations it carries.\\\"\\n}\\n---\\n{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:4.D\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/catalog/catalog.go\\\",\\n  \\\"declaration\\\": \\\"ForRelease\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"catalog-v050-exact\\\"\\n ],\\n \\\"coverage\\\": \\\"unevidenced\\\",\\n \\\"gap\\\": \\\"ForRelease only returns the reviewed typed catalog rows that reference 4.D; no clause of 4.D is enumerated against an acceptance case, so the registry makes no clause-level claim about the 3 obligations it carries.\\\"\\n}\\n---\\n{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:5.2\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/canonicaljson/core_records.go\\\",\\n  \\\"declaration\\\": \\\"validateSessionEvent\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"catalog-v050-exact\\\",\\n  \\\"core-record-identity-validation\\\"\\n ],\\n \\\"coverage\\\": \\\"unevidenced\\\",\\n \\\"gap\\\": \\\"validateSessionEvent validates the Section 5.2 Session Event shape; the event authorship, ordering and epoch behaviour Section 5.2 requires is not implemented and no clause of Section 5.2 is enumerated.\\\"\\n}\\n---\\n{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:7.2\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/catalog/catalog.go\\\",\\n  \\\"declaration\\\": \\\"ForRelease\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"catalog-v050-exact\\\"\\n ],\\n \\\"coverage\\\": \\\"unevidenced\\\",\\n \\\"gap\\\": \\\"ForRelease only returns the reviewed typed catalog rows that reference 7.2; the Section 7.2 host envelope (framing, deadlines, size limits, dispatch, and recovery) is implemented in internal/provhost under the Section 7.6 and Section 7.7 bindings, and no clause of Section 7.2 is enumerated against an acceptance case, so the registry makes no clause-level claim about the 7 obligations it carries.\\\"\\n}\\n---\\n{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:7.3\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/catalog/catalog.go\\\",\\n  \\\"declaration\\\": \\\"ForRelease\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"catalog-v050-exact\\\"\\n ],\\n \\\"coverage\\\": \\\"unmeasured\\\",\\n \\\"gap\\\": \\\"ForRelease only returns the reviewed typed catalog rows that reference 7.3; the RFC 2119 scanner measures no clause line under 7.3, because the closed Provider Manifest states its obligations as a required-member table, a 16-entry operation registry and a nine-name capability registry (seven names under 1.0.0) rather than in uppercase keywords, so the gate cannot measure this section - and the 1.1.0 caller_launch_plan and stdin_resume_replay names are unimplemented. Pending implementation owner: STORY-260916-1ea7od; the seven-name 1.0.0 manifest stays implemented in internal/provhost DecodeManifest, exercised by the provhost conformance suite.\\\"\\n}\\n---\\n{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:7.4\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/catalog/catalog.go\\\",\\n  \\\"declaration\\\": \\\"ForRelease\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"catalog-v050-exact\\\"\\n ],\\n \\\"coverage\\\": \\\"unevidenced\\\",\\n \\\"gap\\\": \\\"ForRelease only returns the reviewed typed catalog rows that reference 7.4; the 1.1.0 probe response with nine capability keys is unimplemented, and no clause of 7.4 is enumerated against an acceptance case, so the registry makes no clause-level claim about the 1 obligation it carries. Pending implementation owner: STORY-260916-1ea7od.\\\"\\n}\\n---\\n{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:7.5\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/catalog/catalog.go\\\",\\n  \\\"declaration\\\": \\\"ForRelease\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"catalog-v050-exact\\\"\\n ],\\n \\\"coverage\\\": \\\"unevidenced\\\",\\n \\\"gap\\\": \\\"ForRelease only returns the reviewed typed catalog rows that reference 7.5; the host-side Section 7.5 operation conformance (SpawnPlan launch and resume bodies, identify-session results, materialize-status recovery, and the single operation plus operation_id mutation key) is implemented in internal/provhost under the Section 7.6 and Section 7.7 bindings, the SpawnPlan.stdin member, the resume.launch_plan member and the stdin replay rule are unimplemented, and no clause of Section 7.5 is enumerated against an acceptance case, so the registry makes no clause-level claim about the 56 obligations it carries. Pending implementation owner: STORY-260916-1kp1lx.\\\"\\n}\\n---\\n{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:7.A\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/terminalbackend/descriptor.go\\\",\\n  \\\"declaration\\\": \\\"AdmitProviderDescriptor\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"terminal-provider-descriptor-7a\\\"\\n ],\\n \\\"coverage\\\": \\\"unevidenced\\\",\\n \\\"gap\\\": \\\"AdmitProviderDescriptor is the complete Section 7.A provider-side gate: it parses the closed v3 TerminalDescriptor document and matches binding digest, backend ID/version, and generation against the AX-validated host-local binding, refusing mismatches before launch or observation. The v3 transport envelope stays with provhost's v2 machinery, which speaks major 2 only and refuses recognizable 3.x as incompatible_protocol per the Section 7.A mismatch rule; decoding v3 failures under Structured Error 1.3.0 awaits the dual-stack host follow-up described in TASK-260906-vmzk0y's outcome. No clause of 7.A is enumerated against an acceptance case, so the registry makes no clause-level claim about the 2 obligations it carries.\\\"\\n}\\n---\\n{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:7.1\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/provider/provider.go\\\",\\n  \\\"declaration\\\": \\\"Discover\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"provider-discovery-and-trust\\\"\\n ],\\n \\\"coverage\\\": \\\"unevidenced\\\",\\n \\\"gap\\\": \\\"Discover implements the Section 7.1 deterministic discovery, trust recording, and substitution detection with the section-mandated duplicate invalid_config refusal; no clause of Section 7.1 is enumerated against an acceptance case, so the registry makes no clause-level claim about the 6 obligations it carries.\\\"\\n}\\n---\\n{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:7.6\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/provhost/quiesce.go\\\",\\n  \\\"declaration\\\": \\\"DecodeQuiesceProof\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"provhost-quiesce-proof\\\"\\n ],\\n \\\"coverage\\\": \\\"unevidenced\\\",\\n \\\"gap\\\": \\\"DecodeQuiesceProof implements the Section 7.6 quiescence proof decoder with its fail-closed safe-bit rules; the Provider Identity Record it carries is additionally checked by CheckIdentity, and no clause of Section 7.6 is enumerated against an acceptance case, so the registry makes no clause-level claim about the 3 obligations it carries.\\\"\\n}\\n---\\n{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:7.7\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/provhost/profile_resolve.go\\\",\\n  \\\"declaration\\\": \\\"ResolveMapping\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"provhost-mapping-resolution\\\",\\n  \\\"provhost-profile-mapping\\\",\\n  \\\"provhost-launch-projection\\\"\\n ],\\n \\\"coverage\\\": \\\"partial\\\",\\n \\\"gap\\\": \\\"Section 7.7 clause 7.7#2 stays undisclosed: its omit rule is enforced, but its machine-local-alias sentence is only half-decided, because a shell word that expands to unrestricted mode without spelling a table token is beyond argv inspection (shell aliases never expand under execve, owned by secprim). ResolveMapping decides the exact-version probe rule the other three clauses need.\\\",\\n \\\"clauses\\\": [\\n  {\\n   \\\"id\\\": \\\"7.7#1\\\",\\n   \\\"line\\\": 3689,\\n   \\\"excerpt\\\": \\\"<code>standard</code> MUST use the provider's normal approval/sandbox behavior\\\",\\n   \\\"acceptance_cases\\\": [\\n    \\\"provhost-profile-mapping\\\",\\n    \\\"provhost-launch-projection\\\"\\n   ]\\n  },\\n  {\\n   \\\"id\\\": \\\"7.7#3\\\",\\n   \\\"line\\\": 3697,\\n   \\\"excerpt\\\": \\\"MUST disclose that equivalence;\\\",\\n   \\\"acceptance_cases\\\": [\\n    \\\"provhost-mapping-resolution\\\"\\n   ]\\n  },\\n  {\\n   \\\"id\\\": \\\"7.7#4\\\",\\n   \\\"line\\\": 3700,\\n   \\\"excerpt\\\": \\\"The adapter MUST probe the exact provider version before applying a mapping.\\\",\\n   \\\"acceptance_cases\\\": [\\n    \\\"provhost-mapping-resolution\\\"\\n   ]\\n  }\\n ]\\n}\\n---\\n{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:7.8\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/catalog/catalog.go\\\",\\n  \\\"declaration\\\": \\\"ForRelease\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"catalog-v050-exact\\\"\\n ],\\n \\\"coverage\\\": \\\"unevidenced\\\",\\n \\\"gap\\\": \\\"ForRelease only returns the reviewed typed catalog rows that reference 7.8; no clause of 7.8 is enumerated against an acceptance case, so the registry makes no clause-level claim about the 2 obligations it carries.\\\"\\n}\\n---\\n{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\