ctor_bootstrap_incomplete: the interrupted prefix is never\\n// silently omitted and never returned as a public summary.\\nfunc (reader *Reader) List() ([]Summary, error) {\\n\\tif reader == nil || reader.Local == nil {\\n\\t\\treturn nil, fmt.Errorf(\\\"%w: local repository is required\\\", ErrUnavailable)\\n\\t}\\n\\trows, err := reader.read(reader.Local)\\n\\tif err != nil {\\n\\t\\treturn nil, err\\n\\t}\\n\\tfor _, row := range rows {\\n\\t\\tif err := checkSummaryRepresentable(row); err != nil {\\n\\t\\t\\treturn nil, err\\n\\t\\t}\\n\\t}\\n\\treturn rows, nil\\n}\\n\\nfunc (reader *Reader) read(repo *sessrepo.Repository) ([]Summary, error) {\\n===CAS-INPUT===\\n106:type CreateLeaseInput struct {\\n107-\\tLeaseID        string\\n108-\\tHolderHostID   string\\n109-\\tIssuedByHostID string\\n110-\\tCreatedAt      string\\n111-}\\n112-\\n113-// SuccessorLeaseInput extends the bootstrap inputs with the two members\\n114-// a successor lease must carry: a reason and the validated materialized\\n115-// handoff base. Any of the four Section 5.3 reasons is admitted: the\\n116-// specification never declares a create-implies-epoch-1 direction, so\\n--\\n119:type SuccessorLeaseInput struct {\\n120-\\tCreateLeaseInput\\n121-\\tReason       string\\n122-\\tCheckpointID string\\n123-}\\n124-\\n125-// LeaseExpectation is the CAS compare value: the record digest the caller\\n126-// believes is the current head.\\n127:type LeaseExpectation struct {\\n128-\\tRecordID string\\n129-}\\n130-\\n131-// LeaseRef names one persisted lease: its session, record digest, fencing\\n132-// token, epoch, and holder.\\n133-type LeaseRef struct {\\n134-\\tSessionID    string\\n135-\\tRecordID     string\\n136-\\tLeaseID      string\\n137-\\tEpoch        uint64\\n\",\n  \"original_output_bytes\": 3989,\n  \"original_output_tokens\": 998,\n  \"truncated\": false\n}","final_result":true}}}
