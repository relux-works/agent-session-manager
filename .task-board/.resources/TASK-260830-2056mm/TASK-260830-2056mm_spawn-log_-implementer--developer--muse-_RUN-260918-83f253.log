{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000f293","stream":{"kind":"session","id":"01a0b35d-fadf-7f82-925c-5ba6aefcf0a7"},"sequence":6052,"recorded_at":1780531400012099,"record_type":"event","durability":"durable","causation_id":"38ee7473-f77a-4937-9e67-866e0a213216","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38ee7473-f77a-4937-9e67-866e0a213216","run_stream":{"kind":"run","id":"38ee7473-f77a-4937-9e67-866e0a213216"},"task_stream":{"kind":"task","id":"01a0b38b-bdc7-7482-82da-5078e45e662f"},"task_id":"01a0b38b-bdc7-7482-82da-5078e45e662f","event":{"kind":"output","task_id":"01a0b38b-bdc7-7482-82da-5078e45e662f","chunk":"{\n  \"chunk_id\": \"exec-162-1\",\n  \"command\": \"cat > /tmp/registry_patch.py <<'PYEOF'\\nimport json\\n\\npath = 'internal/traceability/ownership.v0.7.0.json'\\nd = json.load(open(path, encoding='utf-8'))\\n\\ndef case(cid, prod_path, prod_decl, tests):\\n    return {\\n        'id': cid,\\n        'production': {'path': prod_path, 'declaration': prod_decl},\\n        'tests': [{'path': p, 'declaration': t} for p, t in tests],\\n    }\\n\\nTI = 'internal/termbind/'\\nnew_cases = [\\n    case('terminal-instance-binding-exact', TI + 'identity.go', 'ParseTerminalBinding', [\\n        (TI + 'identity_test.go', 'TestParseTerminalBindingAdmitsClosedFixture'),\\n        (TI + 'identity_test.go', 'TestParseTerminalBindingClosedShape'),\\n        (TI + 'identity_test.go', 'TestBindingIdentityAgreesWithLandedAdmission'),\\n    ]),\\n    case('terminal-instance-identity-exact', TI + 'identity.go', 'CheckInstanceIdentity', [\\n        (TI + 'identity_test.go', 'TestCheckInstanceIdentityAdmitsUUIDv7'),\\n        (TI + 'identity_test.go', 'TestCheckInstanceIdentityRefusesForbiddenForms'),\\n        (TI + 'identity_test.go', 'TestParseTerminalBindingRefusesForbiddenIdentity'),\\n        (TI + 'identity_test.go', 'TestAdmitMutationContextRefusesForbiddenIdentity'),\\n        (TI + 'identity_test.go', 'TestAdmitStatusBodyRefusesForbiddenIdentity'),\\n        (TI + 'attach_test.go', 'TestAttachRefusesForbiddenIdentity'),\\n    ]),\\n    case('terminal-evidence-resolution-exact', TI + 'resolve.go', 'ResolveEvidence', [\\n        (TI + 'resolve_test.go', 'TestResolveEvidenceAdmitsUniverse'),\\n        (TI + 'resolve_test.go', 'TestResolveEvidenceShapeBounds'),\\n        (TI + 'resolve_test.go', 'TestResolveEvidenceRefusesForeignKinds'),\\n        (TI + 'resolve_test.go', 'TestResolveEvidenceRequiresManifestAndProbe'),\\n        (TI + 'resolve_test.go', 'TestResolveEvidenceBindsEventTuple'),\\n        (TI + 'resolve_test.go', 'TestResolveEvidenceRejectsSubstitution'),\\n        (TI + 'resolve_test.go', 'TestResolveEvidenceDrivesLandedAdmission'),\\n    ]),\\n    case('terminal-binding-events-exact', TI + 'emit.go', 'EmitTerminalCreated', [\\n        (TI + 'emit_test.go', 'TestEmitTerminalCreatedRoundTrip'),\\n        (TI + 'emit_test.go', 'TestEmitClosedShapeRefusals'),\\n        (TI + 'emit_test.go', 'TestEmitResolvesEvidence'),\\n        (TI + 'emit_test.go', 'TestEmitUnderLosingLeaseRefuses'),\\n        (TI + 'emit_test.go', 'TestEmitAppendsIdempotently'),\\n        (TI + 'emit_test.go', 'TestEmittedEventCarriesNoBindingObject'),\\n        (TI + 'skew_test.go', 'TestTakeoverSelectsNewBackendNewEvent'),\\n        (TI + 'skew_test.go', 'TestV4RetainedAsImmutableHistory'),\\n        (TI + 'crash_unix_test.go', 'TestEmitAppendHookSeams'),\\n    ]),\\n    case('terminal-binding-resumed-exact', TI + 'emit.go', 'EmitResumed', [\\n        (TI + 'emit_test.go', 'TestEmitResumedRoundTrip'),\\n        (TI + 'emit_test.go', 'TestEmitResolvesEvidence'),\\n    ]),\\n    case('terminal-create-recovery-exact', TI + 'recover.go', 'RecoverCreate', [\\n        (TI + 'recover_test.go', 'TestRecoverCreateProvesAbsence'),\\n        (TI + 'recover_test.go', 'TestRecoverCreateIdentifiesOneChild'),\\n        (TI + 'recover_test.go', 'TestRecoverCreateDuplicateRetrySameVerdict'),\\n        (TI + 'recover_test.go', 'TestRecoverCreateChangedOperationInWindowRefuses'),\\n        (TI + 'recover_test.go', 'TestRecoverCreateChangedOperationPostWindowProceeds'),\\n        (TI + 'recover_test.go', 'TestRecoverCreateLostResult'),\\n        (TI + 'recover_test.go', 'TestRecoverCreateNeverClaimsAbsent'),\\n        (TI + 'recover_test.go', 'TestRecoverCreateRecordedChildBackendAbsentReplays'),\\n        (TI + 'recover_test.go', 'TestRecoverCreateUnknownIsNotAbsent'),\\n        (TI + 'crash_unix_test.go', 'TestRecoverCreateAfterKillRecoversChild'),\\n    ]),\\n    case('terminal-attach-receipt-exact', TI + 'attach.go', 'Attach', [\\n        (TI + 'attach_test.go', 'TestAttachRoundTrip'),\\n        (TI + 'attach_test.go', 'TestAttachIdenticalRetryReplays'),\\n        (TI + 'attach_test.go', 'TestAttachSecondClientRecordsAlongside'),\\n        (TI + 'attach_test.go', 'TestAttachConflictRefusesMismatch'),\\n        (TI + 'attach_test.go', 'TestAttachRefusesForbiddenIdentity'),\\n        (TI + 'attach_test.go', 'TestAttachTransportVocabulary'),\\n        (TI + 'attach_test.go', 'TestAttachRequiresLiveAuth'),\\n        (TI + 'attach_test.go', 'TestAttachEmitsNeitherEventNorStateChange'),\\n        (TI + 'attach_test.go', 'TestAttachUnknownIsNotAbsent'),\\n        (TI + 'attach_test.go', 'TestAttachSessionMismatchRefuses'),\\n        (TI + 'crash_unix_test.go', 'TestAttachCrashChildSelfTerminates'),\\n    ]),\\n]\\n\\nexisting = {c['id'] for c in d['acceptance_cases']}\\nfor c in new_cases:\\n    assert c['id'] not in existing, c['id']\\nd['acceptance_cases'].extend(new_cases)\\n\\ndef binding(key):\\n    for e in d['ownership']:\\n        if e.get('kind') == 'section_binding' and e.get('keys') == [key]:\\n            return e\\n    raise KeyError(key)\\n\\nb = binding('section:4.B')\\nb['production'] = {'path': TI + 'identity.go', 'declaration': 'CheckInstanceIdentity'}\\nb['acceptance_cases'] = ['terminal-instance-identity-exact']\\nb['coverage'] = 'sliver'\\nb['gap'] = ('CheckInstanceIdentity enforces Section 4.B clause 4.B#11 (terminal instance identity is never a PID, handle, socket, path, pipe, URL, token, or endpoint) across the Binding, operation bodies, bootstrap binding, and attach surfaces; the Terminal Instance Binding 1.0.0 closed object itself is parsed by ParseTerminalBinding with ID recompute (terminal-instance-binding-exact covers the unmeasured table rules). The other 11 Section 4.B clauses (Manifest/Probe/evidence reconciliation rules, reader ID recompute, generation boundary cases) are implemented in internal/terminalbackend Reconcile/AdmitProbe and stay unenumerated here.')\\nb['clauses'] = [{'id': '4.B#11', 'line': 1076, 'excerpt': 'Identity MUST NOT be a PID, handle, socket, path, named pipe, URL, token, or', 'acceptance_cases': ['terminal-instance-identity-exact']}]\\n\\nb = binding('section:4.D')\\nb['production'] = {'path': TI + 'resolve.go', 'declaration': 'ResolveEvidence'}\\nb['acceptance_cases'] = ['terminal-evidence-resolution-exact']\\nb['coverage'] = 'sliver'\\nb['gap'] = ('ResolveEvidence discharges Section 4.D clause 4.D#2 by admitting every resolved Manifest, Probe, and Capability Evidence object through the landed Registry.AdmitProbe, which verifies the attestation signature before the object is treated as evidence; forged signatures refuse. The other Section 4.D clauses (registry-row equality 4.D#1 and the no-silent-fallback backend selection rule 4.D#3) are landed Reconcile behavior and explicit-selection behavior respectively and stay unenumerated here.')\\nb['clauses'] = [{'id': '4.D#2', 'line': 1296, 'excerpt': 'key registry and MUST verify the signature before treating the object as', 'acceptance_cases': ['terminal-evidence-resolution-exact']}]\\n\\nb = binding('section:5.2')\\nb['production'] = {'path': TI + 'resolve.go', 'declaration': 'ResolveEvidence'}\\nb['acceptance_cases'] = ['catalog-v050-exact', 'core-record-identity-validation', 'terminal-evidence-resolution-exact', 'terminal-binding-events-exact']\\nb['coverage'] = 'sliver'\\nb['gap'] = ('ResolveEvidence discharges Section 5.2 clauses 5.2#16 and 5.2#17 (evidence IDs resolve locally to validated Manifest/Probe/Evidence bound to the event tuple, never to a native reference or live-process fact); Section 5.2 clause 5.2#18 (v4 retained as inert immutable history, no derived state, no lower-version write) is pinned for Terminal Events by the EmitTerminalCreated emission path with sessrepo retention and the sessstate/sessquery readers. The other Section 5.2 envelope, table, authorship, ordering, and epoch clauses stay with the landed validateSessionEvent shape authority and sessrepo ordering, unenumerated here.')\\nb['clauses'] = [\\n    {'id': '5.2#16', 'line': 1971, 'excerpt': 'replicated. The evidence IDs MUST resolve locally to validated, sanitized', 'acceptance_cases': ['terminal-evidence-resolution-exact']},\\n    {'id': '5.2#17', 'line': 1973, 'excerpt': 'backend ID and versions. They MUST NOT resolve through the event to a native', 'acceptance_cases': ['terminal-evidence-resolution-exact']},\\n    {'id': '5.2#18', 'line': 1984, 'excerpt': 'as inert immutable history but MUST NOT derive runtime state or write a lower-', 'acceptance_cases': ['terminal-binding-events-exact']},\\n]\\n\\nb = binding('section:7.A')\\nb['acceptance_cases'] = ['terminal-provider-descriptor-7a', 'terminal-instance-identity-exact']\\nb['coverage'] = 'partial'\\nb['gap'] = ('AdmitProviderDescriptor discharges Section 7.A clause 7.A#1 (the Provider rejects a descriptor whose binding digest, backend, version, or generation does not match the AX-validated binding), pinned by the landed terminal-provider-descriptor-7a mismatch tests and the terminal-instance-identity-exact eight-form identity pin through the same entry. Section 7.A clause 7.A#2 (LeaseToken v2 fencing rules and the 3.x transport envelope) stays with provhost v2 machinery and the dual-stack follow-up, undisclosed here.')\\nb['clauses'] = [{'id': '7.A#1', 'line': 3724, 'excerpt': 'TerminalBackend. The Provider MUST reject a descriptor whose binding digest,', 'acceptance_cases': ['terminal-provider-descriptor-7a', 'terminal-instance-identity-exact']}]\\n\\nnew_binding = {\\n    'kind': 'section_binding',\\n    'keys': ['section:4.1'],\\n    'production': {'path': TI + 'recover.go', 'declaration': 'RecoverCreate'},\\n    'acceptance_cases': ['terminal-create-recovery-exact'],\\n    'coverage': 'sliver',\\n    'gap': ('RecoverCreate discharges Section 4.1 clause 4.1#5: after a lost create result, one status read plus the durable (session_id, bootstrap_operation_id) binding proves absence or identifies the ONE child (unavailable with status_first when the effect cannot be disproven, never a second child, never a false absence claim). The other Section 4.1 clauses (backend semantic operations, wrapper validation and safe parking, the durable pair bind) belong to the operation matrix, the axpane wrapper, and the terminal backend receipt owners and stay unenumerated here.'),\\n    'clauses': [{'id': '4.1#5', 'line': 1399, 'excerpt': '<code>status</code> plus that binding MUST prove absence or identify the one', 'acceptance_cases': ['terminal-create-recovery-exact']}],\\n}\\nidx = next(i for i, e in enumerate(d['ownership']) if e.get('keys') == ['section:4.B'])\\nd['ownership'].insert(idx, new_binding)\\n\\njson.dump(d, open(path, 'w', encoding='utf-8'), indent=2)\\nopen(path, 'a', encoding='utf-8').write('\\\\n')\\nprint('patched: cases=%d ownership=%d' % (len(d['acceptance_cases']), len(d['ownership'])))\\nPYEOF\\npython3 /tmp/registry_patch.py\",\n  \"description\": \"Apply registry patch\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"patched: cases=147 ownership=74\\n\",\n  \"original_output_bytes\": 32,\n  \"original_output_tokens\": 8,\n  \"truncated\": false\n}","final_result":true}}}
