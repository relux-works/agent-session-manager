{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c995","stream":{"kind":"session","id":"01a0b35d-fadf-7f82-925c-5ba6aefcf0a7"},"sequence":805,"recorded_at":1780531400001605,"record_type":"event","durability":"durable","causation_id":"38ee7473-f77a-4937-9e67-866e0a213216","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38ee7473-f77a-4937-9e67-866e0a213216","run_stream":{"kind":"run","id":"38ee7473-f77a-4937-9e67-866e0a213216"},"call_id":"call_01a0b35fd5de76f98c93282adf9bb009","text":"Read text file `internal/axpane/events_test.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n9|)\n10|\n11|func bindingFacts() TerminalBindingFacts {\n12|\treturn TerminalBindingFacts{\n13|\t\tBindingDigest:         seedDigest(0xB1),\n14|\t\tBackendID:             \"ax.tmux\",\n15|\t\tImplementationVersion: \"2.1.0\",\n16|\t\tProtocolVersion:       \"1.1.0\",\n17|\t\tProtocolVersions:      []string{\"1.0.0\", \"1.1.0\"},\n18|\t\tEvidenceIDs:           []string{seedDigest(0xE0), seedDigest(0xE1)},\n19|\t}\n20|}\n21|\n22|func TestParkedPayloadVocabulary(t *testing.T) {\n23|\tt.Parallel()\n24|\tfor _, reason := range []fencing.ParkReason{\n25|\t\tfencing.ParkRemoteOwner, fencing.ParkStaleOwner, fencing.ParkRestorePolicy, fencing.ParkFailedHandoff,\n26|\t} {\n27|\t\tpayload, err := ParkedPayload(reason, fixtureLeaseA)\n28|\t\tif err != nil {\n29|\t\t\tt.Fatalf(\"ParkedPayload(%q) error = %v\", string(reason), err)\n30|\t\t}\n31|\t\tif payload[\"reason\"] != string(reason) || payload[\"winning_lease_id\"] != fixtureLeaseA {\n32|\t\t\tt.Fatalf(\"ParkedPayload(%q) = %v\", string(reason), payload)\n33|\t\t}\n34|\t\tif len(payload) != 2 {\n35|\t\t\tt.Fatalf(\"ParkedPayload(%q) carries %d members, want exactly 2\", string(reason), len(payload))\n36|\t\t}\n37|\t}\n38|\tif _, err := ParkedPayload(fencing.ParkReason(\"bogus\"), fixtureLeaseA); err == nil {\n39|\t\tt.Fatal(\"ParkedPayload(bogus) succeeded, want refusal\")\n40|\t}\n41|\tif _, err := ParkedPayload(fencing.ParkRemoteOwner, \"not-a-lease\"); err == nil {\n42|\t\tt.Fatal(\"ParkedPayload(bad lease) succeeded, want refusal\")\n43|\t}\n44|}\n45|\n46|func TestTerminalCreatedPayload(t *testing.T) {\n47|\tt.Parallel()\n48|\tpayload, err := TerminalCreatedPayload(bindingFacts())\n49|\tif err != nil {\n50|\t\tt.Fatalf(\"TerminalCreatedPayload() error = %v\", err)\n51|\t}\n52|\twant := map[string]any{\n53|\t\t\"terminal_binding_id\":    seedDigest(0xB1),\n54|\t\t\"terminal_backend_id\":    \"ax.tmux\",\n55|\t\t\"implementation_version\": \"2.1.0\",\n56|\t\t\"protocol_version\":       \"1.1.0\",\n57|\t\t\"evidence_ids\":           []string{seedDigest(0xE0), seedDigest(0xE1)},\n58|\t}\n59|\traw, _ := json.Marshal(payload)\n60|\tvar decoded map[string]any\n61|\tif err := json.Unmarshal(raw, &decoded); err != nil {\n62|\t\tt.Fatal(err)\n63|\t}\n64|\tif len(decoded) != len(want) {\n65|\t\tt.Fatalf(\"TerminalCreatedPayload() members = %v, want exactly %v\", decoded, want)\n66|\t}\n67|\tfor name, value := range want {\n68|\t\tround, _ := json.Marshal(decoded[name])\n69|\t\texpect, _ := json.Marshal(value)\n70|\t\tif string(round) != string(expect) {\n71|\t\t\tt.Fatalf(\"TerminalCreatedPayload()[%q] = %s, want %s\", name, round, expect)\n72|\t\t}\n73|\t}\n74|\tcases := []struct {\n75|\t\tname   string\n76|\t\tmutate func(*TerminalBindingFacts)\n77|\t}{\n78|\t\t{\"bad digest\", func(facts *TerminalBindingFacts) { facts.BindingDigest = \"nope\" }},\n79|\t\t{\"bad backend\", func(facts *TerminalBindingFacts) { facts.BackendID = \"Bogus!\" }},\n80|\t\t{\"bad versions\", func(facts *TerminalBindingFacts) { facts.ProtocolVersion = \"2.0.0\" }},\n81|\t\t{\"empty evidence\", func(facts *TerminalBindingFacts) { facts.EvidenceIDs = nil }},\n82|\t\t{\"unsorted evidence\", func(facts *TerminalBindingFacts) {\n83|\t\t\tfacts.EvidenceIDs = []string{seedDigest(0xE1), seedDigest(0xE0)}\n84|\t\t}},\n85|\t\t{\"bad evidence digest\", func(facts *TerminalBindingFacts) { facts.EvidenceIDs = []string{\"nope\"} }},\n86|\t}\n87|\tfor _, testCase := range cases {\n88|\t\tt.Run(testCase.name, func(t *testing.T) {\n89|\t\t\tt.Parallel()\n90|\t\t\tfacts := bindingFacts()\n91|\t\t\ttestCase.mutate(&facts)\n92|\t\t\tif _, err := TerminalCreatedPayload(facts); err == nil {\n93|\t\t\t\tt.Fatalf(\"TerminalCreatedPayload(%s) succeeded, want refusal\", testCase.name)\n94|\t\t\t}\n95|\t\t})\n96|\t}\n97|}\n98|\n99|func TestResumedPayload(t *testing.T) {\n100|\tt.Parallel()\n101|\tpayload, err := ResumedPayload(seedDigest(0xC9), \"yolo\", seedDigest(0xCA), true, bindingFacts())\n102|\tif err != nil {\n103|\t\tt.Fatalf(\"ResumedPayload() error = %v\", err)\n104|\t}\n105|\tif payload[\"checkpoint_id\"] != seedDigest(0xC9) || payload[\"execution_profile\"] != \"yolo\" || payload[\"profile_source_event_id\"] != seedDigest(0xCA) {\n106|\t\tt.Fatalf(\"ResumedPayload() = %v\", payload)\n107|\t}\n108|\tif len(payload) != 8 {\n109|\t\tt.Fatalf(\"ResumedPayload() carries %d members, want exactly 8\", len(payload))\n110|\t}\n111|\tnullSource, err := ResumedPayload(seedDigest(0xC9), \"standard\", \"\", false, bindingFacts())\n112|\tif err != nil {\n113|\t\tt.Fatalf(\"ResumedPayload(null source) error = %v\", err)\n114|\t}\n115|\tif nullSource[\"profile_source_event_id\"] != nil {\n116|\t\tt.Fatalf(\"ResumedPayload(null source) source = %v, want null\", nullSource[\"profile_source_event_id\"])\n117|\t}\n118|\tif _, err := ResumedPayload(\"nope\", \"standard\", \"\", false, bindingFacts()); err == nil {\n119|\t\tt.Fatal(\"ResumedPayload(bad checkpoint) succeeded, want refusal\")\n120|\t}\n121|\tif _, err := ResumedPayload(seedDigest(0xC9), \"bogus\", \"\", false, bindingFacts()); err == nil {\n122|\t\tt.Fatal(\"ResumedPayload(bad profile) succeeded, want refusal\")\n123|\t}\n124|\tif _, err := ResumedPayload(seedDigest(0xC9), \"yolo\", \"nope\", true, bindingFacts()); err == nil {\n125|\t\tt.Fatal(\"ResumedPayload(bad source) succeeded, want refusal\")\n126|\t}\n127|}\n128|\n129|// TestEmitParkedRoundTrip authors the parked event for a Decide\n130|// parked outcome through the sessrepo owner under the locally held\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c997","stream":{"kind":"session","id":"01a0b35d-fadf-7f82-925c-5ba6aefcf0a7"},"sequence":806,"recorded_at":1780531400001607,"record_type":"event","durability":"durable","causation_id":"38ee7473-f77a-4937-9e67-866e0a213216","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38ee7473-f77a-4937-9e67-866e0a213216","run_stream":{"kind":"run","id":"38ee7473-f77a-4937-9e67-866e0a213216"},"call_id":"call_01a0b35fd7ec76e194fcbe2984a7987e","text":"Read text file `internal/axpane/descriptor.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"crypto/rand\"\n5|\t\"encoding/binary\"\n6|\t\"encoding/json\"\n7|\t\"fmt\"\n8|\t\"time\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|)\n12|\n13|// DescriptorParams carries the §7.A Terminal Instance binding context\n14|// the wrapper supplies: the validated host-local binding subset,\n15|// interactivity, and geometry.\n16|type DescriptorParams struct {\n17|\t// Binding is the AX-validated host-local binding subset the\n18|\t// descriptor must match.\n19|\tBinding BindingRef\n20|\t// InstanceID is the AX-allocated terminal instance UUIDv7;\n21|\t// empty mints a fresh one. It is never a PID, socket, path,\n22|\t// pipe, URL, handle, token, or native reference.\n23|\tInstanceID string\n24|\t// Interactive selects the presentation mode.\n25|\tInteractive bool\n26|\t// Columns and Rows carry the uint16[1..1000] geometry bound.\n27|\tColumns uint16\n28|\tRows    uint16\n29|}\n30|\n31|// BindingRef is the validated host-local binding subset: binding\n32|// digest, backend ID, versions, and generation.\n33|type BindingRef struct {\n34|\tBindingDigest         string\n35|\tBackendID             string\n36|\tImplementationVersion string\n37|\tProtocolVersion       string\n38|\tGeneration            string\n39|}\n40|\n41|// MintInstanceID allocates one terminal instance UUIDv7: 48-bit\n42|// millisecond timestamp, version and variant bits, and 74\n43|// cryptographic random bits. Time and randomness come from the\n44|// caller-supplied clock and reader so tests pin them; production\n45|// passes time.Now and crypto/rand.\n46|func MintInstanceID(now time.Time, random func([]byte) (int, error)) (string, error) {\n47|\tvar raw [16]byte\n48|\tmillis := uint64(now.UTC().UnixMilli())\n49|\tif millis>>48 != 0 {\n50|\t\treturn \"\", fmt.Errorf(\"instance clock is outside the UUIDv7 range\")\n51|\t}\n52|\traw[0] = byte(millis >> 40)\n53|\traw[1] = byte(millis >> 32)\n54|\traw[2] = byte(millis >> 24)\n55|\traw[3] = byte(millis >> 16)\n56|\traw[4] = byte(millis >> 8)\n57|\traw[5] = byte(millis)\n58|\ttail := make([]byte, 10)\n59|\tif _, err := random(tail); err != nil {\n60|\t\treturn \"\", fmt.Errorf(\"instance randomness failed: %w\", err)\n61|\t}\n62|\tcopy(raw[6:], tail)\n63|\traw[6] = raw[6]&0x0f | 0x70\n64|\traw[8] = raw[8]&0x3f | 0x80\n65|\tvalue := fmt.Sprintf(\"%08x-%04x-%04x-%04x-%012x\",\n66|\t\tbinary.BigEndian.Uint32(raw[0:4]),\n67|\t\tbinary.BigEndian.Uint16(raw[4:6]),\n68|\t\tbinary.BigEndian.Uint16(raw[6:8]),\n69|\t\tbinary.BigEndian.Uint16(raw[8:10]),\n70|\t\tuint64(raw[10])<<40|uint64(raw[11])<<32|uint64(raw[12])<<24|uint64(raw[13])<<16|uint64(raw[14])<<8|uint64(raw[15]))\n71|\tif _, err := scalar.ParseUUIDv7(value); err != nil {\n72|\t\treturn \"\", fmt.Errorf(\"minted instance id is not a UUIDv7: %w\", err)\n73|\t}\n74|\treturn value, nil\n75|}\n76|\n77|// MintInstanceIDRandom mints one terminal instance UUIDv7 from the\n78|// system clock and crypto/rand.\n79|func MintInstanceIDRandom() (string, error) {\n80|\treturn MintInstanceID(time.Now(), rand.Read)\n81|}\n82|\n83|// BuildDescriptor renders the closed §7.A descriptor document for the\n84|// launch path: the binding digest, the AX-allocated instance UUIDv7,\n85|// backend identity, generation, interactivity, and geometry. No\n86|// other member is permitted. Geometry outside uint16[1..1000]\n87|// refuses, and the instance ID must parse as UUIDv7.\n88|func BuildDescriptor(params DescriptorParams) ([]byte, error) {\n89|\tinstance := params.InstanceID\n90|\tif instance == \"\" {\n91|\t\tminted, err := MintInstanceIDRandom()\n92|\t\tif err != nil {\n93|\t\t\treturn nil, err\n94|\t\t}\n95|\t\tinstance = minted\n96|\t}\n97|\tif _, err := scalar.ParseUUIDv7(instance); err != nil {\n98|\t\treturn nil, fmt.Errorf(\"descriptor instance %q is not a UUIDv7: %w\", instance, err)\n99|\t}\n100|\tif params.Columns < 1 || params.Columns > 1000 || params.Rows < 1 || params.Rows > 1000 {\n101|\t\treturn nil, fmt.Errorf(\"descriptor geometry %dx%d is outside uint16[1..1000]\", params.Columns, params.Rows)\n102|\t}\n103|\tdocument := map[string]any{\n104|\t\t\"terminal_binding_id\":    params.Binding.BindingDigest,\n105|\t\t\"terminal_instance_id\":   instance,\n106|\t\t\"terminal_backend_id\":    params.Binding.BackendID,\n107|\t\t\"implementation_version\": params.Binding.ImplementationVersion,\n108|\t\t\"protocol_version\":       params.Binding.ProtocolVersion,\n109|\t\t\"backend_generation\":     params.Binding.Generation,\n110|\t\t\"interactive\":            params.Interactive,\n111|\t\t\"columns\":                params.Columns,\n112|\t\t\"rows\":                   params.Rows,\n113|\t}\n114|\traw, err := json.Marshal(document)\n115|\tif err != nil {\n116|\t\treturn nil, fmt.Errorf(\"encode provider descriptor: %w\", err)\n117|\t}\n118|\treturn raw, nil\n119|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
