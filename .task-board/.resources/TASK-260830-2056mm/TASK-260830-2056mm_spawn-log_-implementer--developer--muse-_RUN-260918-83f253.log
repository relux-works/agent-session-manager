{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000daf5","stream":{"kind":"session","id":"01a0b35d-fadf-7f82-925c-5ba6aefcf0a7"},"sequence":3029,"recorded_at":1780531400006053,"record_type":"event","durability":"durable","causation_id":"38ee7473-f77a-4937-9e67-866e0a213216","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38ee7473-f77a-4937-9e67-866e0a213216","run_stream":{"kind":"run","id":"38ee7473-f77a-4937-9e67-866e0a213216"},"task_stream":{"kind":"task","id":"01a0b373-4d22-76b1-934e-871c22fdd3cf"},"task_id":"01a0b373-4d22-76b1-934e-871c22fdd3cf","event":{"kind":"output","task_id":"01a0b373-4d22-76b1-934e-871c22fdd3cf","chunk":"edited\nchanged lines: lines 219-232\n--- original\n+++ updated\n@@\n-func TestResolveEvidenceRejectsSubstitution(t *testing.T) {\n-\tt.Parallel()\n-\tworld := buildTmuxUniverse(t)\n-\t// The universe returns the valid evidence bytes for an ID that is not\n-\t// the embedded evidence ID: the substitution fails closed instead of\n-\t// admitting document X under name Y.\n-\talias := seedDigest(0xA7)\n-\tuniverse := universeMap(t, world)\n-\tuniverse[alias] = mustJSON(t, world.evidence)\n-\tids := []string{world.manifestID, world.probeID, alias}\n-\tsort.Strings(ids)\n-\t_, err := ResolveEvidence(ids, tmuxTuple(), world.registry, universe, world.rawGeneration, world.now, world.verify)\n-\trequireCode(t, err, \"terminal_backend_manifest_probe_mismatch\")\n-}\n+func TestResolveEvidenceRejectsSubstitution(t *testing.T) {\n+\tt.Parallel()\n+\tt.Run(\"evidence alias\", func(t *testing.T) {\n+\t\tt.Parallel()\n+\t\tworld := buildTmuxUniverse(t)\n+\t\t// The universe returns the valid evidence bytes for an ID that is\n+\t\t// not the embedded evidence ID: the substitution fails closed\n+\t\t// instead of admitting document X under name Y.\n+\t\talias := seedDigest(0xA7)\n+\t\tuniverse := universeMap(t, world)\n+\t\tuniverse[alias] = mustJSON(t, world.evidence)\n+\t\tids := []