{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7a9","stream":{"kind":"session","id":"01a0b35d-fadf-7f82-925c-5ba6aefcf0a7"},"sequence":559,"recorded_at":1780531400001113,"record_type":"event","durability":"durable","causation_id":"38ee7473-f77a-4937-9e67-866e0a213216","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38ee7473-f77a-4937-9e67-866e0a213216","run_stream":{"kind":"run","id":"38ee7473-f77a-4937-9e67-866e0a213216"},"task_stream":{"kind":"task","id":"01a0b35f-20ae-74e3-9b7a-b756bb17a99a"},"task_id":"01a0b35f-20ae-74e3-9b7a-b756bb17a99a","event":{"kind":"output","task_id":"01a0b35f-20ae-74e3-9b7a-b756bb17a99a","chunk":"Read text file `internal/axpane/binding.go`.\n(499 line(s) above)\n500|\t}\n501|\tcutoff := time.Now().Add(-time.Minute)\n502|\tfor _, match := range matches {\n503|\t\tinfo, err := os.Stat(match)\n504|\t\tif err != nil {\n505|\t\t\tcontinue\n506|\t\t}\n507|\t\tif info.ModTime().After(cutoff) {\n508|\t\t\tcontinue\n509|\t\t}\n510|\t\t_ = os.Remove(match)\n511|\t}\n512|}\n513|\n514|func (store *Store) install(sessionID, operationID string, receipt []byte) error {\n515|\tdir := store.sessionDir(sessionID)\n516|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n517|\t\treturn fmt.Errorf(\"create bootstrap session directory: %w\", err)\n518|\t}\n519|\tsweepStaging(dir)\n520|\ttarget := store.bindingPath(sessionID)\n521|\tstaged, err := os.CreateTemp(dir, \"binding-*.tmp\")\n522|\tif err != nil {\n523|\t\treturn fmt.Errorf(\"stage bootstrap binding: %w\", err)\n524|\t}\n525|\tstagedPath := staged.Name()\n526|\tdefer func() { _ = os.Remove(stagedPath) }()\n527|\tif err := staged.Chmod(0o600); err != nil {\n528|\t\t_ = staged.Close()\n529|\t\treturn fmt.Errorf(\"protect bootstrap binding: %w\", err)\n530|\t}\n531|\tif _, err := staged.Write(receipt); err != nil {\n532|\t\t_ = staged.Close()\n533|\t\treturn fmt.Errorf(\"write bootstrap binding: %w\", err)\n534|\t}\n535|\tif err := staged.Sync(); err != nil {\n536|\t\t_ = staged.Close()\n537|\t\treturn fmt.Errorf(\"sync bootstrap binding: %w\", err)\n538|\t}\n539|\tif err := staged.Close(); err != nil {\n540|\t\treturn fmt.Errorf(\"close bootstrap binding: %w\", err)\n541|\t}\n542|\tif store.hooks != nil && store.hooks.AfterStage != nil {\n543|\t\tif err := store.hooks.AfterStage(stagedPath); err != nil {\n544|\t\t\treturn err\n545|\t\t}\n546|\t}\n547|\tif err := os.Link(stagedPath, target); err != nil {\n548|\t\tif errors.Is(err, os.ErrExist) {\n549|\t\t\t// A concurrent wrapper won the commit between our\n550|\t\t\t// Status and our link: re-read the winner. The\n551|\t\t\t// same operation converges its pair receipt from\n552|\t\t\t// the anchor bytes and reattaches to it; a changed\n553|\t\t\t// operation is the bootstrap-window mismatch.\n554|\t\t\twinner, found, readErr := store.Status(sessionID)\n555|\t\t\tif readErr != nil {\n556|\t\t\t\treturn readErr\n557|\t\t\t}\n558|\t\t\tif !found {\n559|\t\t\t\treturn &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \"bootstrap binding\"}\n560|\t\t\t}\n561|\t\t\tif winner.OperationID != operationID {\n562|\t\t\t\treturn &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \"bootstrap binding\"}\n563|\t\t\t}\n564|\t\t\tconverged, err := store.convergePairFromFirst(sessionID, operationID)\n565|\t\t\tif err != nil {\n566|\t\t\t\treturn err\n567|\t\t\t}\n568|\t\t\treturn errConcurrentWinner{bound: converged}\n569|\t\t}\n570|\t\treturn fmt.Errorf(\"install bootstrap binding: %w\", err)\n571|\t}\n572|\t_ = os.Remove(stagedPath)\n573|\tif store.hooks != nil && store.hooks.AfterInstall != nil {\n574|\t\tif err := store.hooks.AfterInstall(target); err != nil {\n575|\t\t\treturn err\n576|\t\t}\n577|\t}\n578|\tif err := syncDirectory(dir); err != nil {\n579|\t\treturn err\n580|\t}\n581|\t// The anchor committed: record the pair receipt from the same\n582|\t// bytes. A failure here still leaves the committed anchor;\n583|\t// the retry converges the pair from it.\n584|\tif _, _, err := store.installPair(sessionID, operationID, receipt); err != nil {\n585|\t\treturn err\n586|\t}\n587|\treturn nil\n588|}\n589|\n590|func checkBindingCandidate(candidate Binding) error {\n591|\tif _, err := scalar.ParseUUIDv7(candidate.SessionID); err != nil {\n592|\t\treturn fmt.Errorf(\"binding session %q is not a UUIDv7: %w\", candidate.SessionID, err)\n593|\t}\n594|\tif _, err := scalar.ParseUUIDv7(candidate.OperationID); err != nil {\n595|\t\treturn fmt.Errorf(\"binding operation %q is not a UUIDv7: %w\", candidate.OperationID, err)\n596|\t}\n597|\tif _, err := scalar.ParseUUIDv7(candidate.TerminalInstanceID); err != nil {\n598|\t\treturn fmt.Errorf(\"binding terminal instance %q is not a UUIDv7: %w\", candidate.TerminalInstanceID, err)\n599|\t}\n600|\tif _, err := scalar.ParseDigest(candidate.BindingDigest); err != nil {\n601|\t\treturn fmt.Errorf(\"binding digest is not a digest: %w\", err)\n602|\t}\n603|\t// The candidate carries no timestamp: the store stamps\n604|\t// created_at at install, so a caller clock never enters the\n605|\t// receipt. Stored receipts validate their stamp at decode.\n606|\treturn nil\n607|}\n608|\n609|func encodeBinding(candidate Binding, createdAt string) ([]byte, error) {\n610|\tstored := candidate\n611|\tstored.CreatedAt = createdAt\n612|\tdocument := map[string]string{\n613|\t\t\"schema\":                 bindingSchema,\n614|\t\t\"schema_version\":         bindingSchemaVersion,\n615|\t\t\"session_id\":             stored.SessionID,\n616|\t\t\"bootstrap_operation_id\": stored.OperationID,\n617|\t\t\"terminal_instance_id\":   stored.TerminalInstanceID,\n618|\t\t\"binding_digest\":         stored.BindingDigest,\n619|\t\t\"created_at\":             stored.CreatedAt,\n620|\t}\n621|\traw, err := json.Marshal(document)\n622|\tif err != nil {\n623|\t\treturn nil, fmt.Errorf(\"encode bootstrap binding: %w\", err)\n624|\t}\n625|\treturn raw, nil\n626|}\n627|\n628|func decodeBinding(raw []byte) (Binding, error) {\n629|\tempty := Binding{}\n630|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n631|\tdecoder.DisallowUnknownFields()\n632|\tvar document struct {\n633|\t\tSchema             string `json:\"schema\"`\n634|\t\tSchemaVersion      string `json:\"schema_version\"`\n635|\t\tSessionID          string `json:\"session_id\"`\n636|\t\tOperationID        string `json:\"bootstrap_operation_id\"`\n637|\t\tTerminalInstanceID string `json:\"terminal_instance_id\"`\n638|\t\tBindingDigest      string `json:\"binding_digest\"`\n639|\t\tCreatedAt          string `json:\"created_at\"`\n640|\t}\n641|\tif err := decoder.Decode(&document); err != nil {\n642|\t\treturn empty, fmt.Errorf(\"bootstrap binding is not the closed shape: %w\", err)\n643|\t}\n644|\tif decoder.More() {\n645|\t\treturn empty, fmt.Errorf(\"bootstrap binding carries trailing data\")\n646|\t}\n647|\tvar members map[string]json.RawMessage\n648|\tif err := json.Unmarshal(raw, &members); err != nil {\n649|\t\treturn empty, fmt.Errorf(\"bootstrap binding is not an object: %w\", err)\n650|\t}\n651|\tfor _, name := range bindingMembers {\n652|\t\tif _, ok := members[name]; !ok {\n653|\t\t\treturn empty, fmt.Errorf(\"bootstrap binding misses required member %q\", name)\n654|\t\t}\n655|\t}\n656|\tif document.Schema != bindingSchema || document.SchemaVersion != bindingSchemaVersion {\n657|\t\treturn empty, fmt.Errorf(\"bootstrap binding schema is not %s %s\", bindingSchema, bindingSchemaVersion)\n658|\t}\n659|\tbinding := Binding{\n660|\t\tSessionID:          document.SessionID,\n661|\t\tOperationID:        document.OperationID,\n662|\t\tTerminalInstanceID: document.TerminalInstanceID,\n663|\t\tBindingDigest:      document.BindingDigest,\n664|\t\tCreatedAt:          document.CreatedAt,\n665|\t}\n666|\tif err := checkBindingCandidate(binding); err != nil {\n667|\t\treturn empty, err\n668|\t}\n669|\tif _, err := scalar.ParseTimestamp(binding.CreatedAt); err != nil {\n670|\t\treturn empty, fmt.Errorf(\"binding timestamp is not a timestamp: %w\", err)\n671|\t}\n672|\treturn binding, nil\n673|}\n674|\n675|// BindingDigest computes the opaque binding digest over the canonical\n676|// receipt bytes: the value a §7.A descriptor carries as\n677|// terminal_binding_id. It reveals no generation, PID, or native\n678|// reference.\n679|func BindingDigest(binding Binding) string {\n680|\tsum := sha256.Sum256([]byte(binding.SessionID + \"\\x00\" + binding.OperationID + \"\\x00\" + binding.TerminalInstanceID))\n681|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n682|}","final_result":true}}}
