{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8df","stream":{"kind":"session","id":"01a0b35d-fadf-7f82-925c-5ba6aefcf0a7"},"sequence":714,"recorded_at":1780531400001423,"record_type":"event","durability":"durable","causation_id":"38ee7473-f77a-4937-9e67-866e0a213216","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38ee7473-f77a-4937-9e67-866e0a213216","run_stream":{"kind":"run","id":"38ee7473-f77a-4937-9e67-866e0a213216"},"task_stream":{"kind":"task","id":"01a0b35f-a3b8-7d61-a4b3-7c10476cd750"},"task_id":"01a0b35f-a3b8-7d61-a4b3-7c10476cd750","event":{"kind":"output","task_id":"01a0b35f-a3b8-7d61-a4b3-7c10476cd750","chunk":"Read text file `internal/sessstate/sessstate.go`.\n(539 line(s) above)\n540|// effect applies one event's lifecycle meaning after continuity and\n541|// lease tracking. Fact events return an empty target and keep the\n542|// state; unknown v1 types and the v2/v3/v4 non-lifecycle types are\n543|// inert by Section 5.2 (retained, never applied).\n544|func (fold *chainFold) effect(event Event, lease LeaseHead, succession bool) error {\n545|\tname := \"event \" + event.Type + \" \" + event.ID\n546|\tswitch event.Type {\n547|\tcase \"session.created\":\n548|\t\treturn fold.effectCreated(event, name)\n549|\tcase \"terminal.created\":\n550|\t\treturn fold.effectTerminalCreated(event, name)\n551|\tcase \"provider.launched\":\n552|\t\treturn fold.effectProviderLaunched(event, name)\n553|\tcase \"provider.identified\":\n554|\t\treturn fold.effectProviderIdentified(event, name)\n555|\tcase \"session.idle\":\n556|\t\treturn fold.step(StateIdle, name)\n557|\tcase \"session.quiescing\":\n558|\t\treturn fold.step(StateQuiescing, name)\n559|\tcase \"checkpoint.created\":\n560|\t\treturn fold.effectCheckpointCreated(event, name)\n561|\tcase \"sync.completed\":\n562|\t\treturn nil\n563|\tcase \"session.stopped\":\n564|\t\treturn fold.effectStopped(event, name)\n565|\tcase \"session.resumed\":\n566|\t\treturn fold.effectResumed(event, name)\n567|\tcase \"session.bootstrap_aborted\":\n568|\t\treturn fold.effectBootstrapAborted(event, name)\n569|\tcase \"lease.transferred\", \"lease.forced\":\n570|\t\treturn fold.effectLease(event, lease, name, succession)\n571|\tcase \"session.parked\":\n572|\t\treturn fold.step(StateParked, name)\n573|\tcase \"session.failed\":\n574|\t\treturn fold.step(StateFailed, name)\n575|\tcase \"fork.created\", \"profile.changed\", \"takeover.force_confirmed\",\n576|\t\t\"replica.replace_confirmed\", \"task_board.adopted\",\n577|\t\t\"tombstone.issued\", \"tombstone.resolved\":\n578|\t\treturn nil\n579|\tcase \"session.tombstoned\":\n580|\t\treturn fold.step(StateTombstoned, name)\n581|\tcase \"task_board.launched\":\n582|\t\treturn fold.effectTaskBoardLaunched(event, name)\n583|\tdefault:\n584|\t\treturn nil\n585|\t}\n586|}\n587|\n588|// effectCreated opens the bootstrap, including the Section 5.7\n589|// failed-to-creating retry: epoch 1 under the same winning create\n590|// lease, no validated checkpoint yet, and no authoritative bootstrap\n591|// abort on record. Anything else that reaches for creating refuses.\n592|func (fold *chainFold) effectCreated(event Event, what string) error {\n593|\tif fold.state == \"\" {\n594|\t\treturn fold.step(StateCreating, what)\n595|\t}\n596|\tif fold.state != StateFailed {\n597|\t\treturn fold.step(StateCreating, what)\n598|\t}\n599|\tif event.LeaseEpoch != 1 || event.LeaseID != fold.createLease.LeaseID ||\n600|\t\tevent.LeaseEpoch != fold.createLease.Epoch {\n601|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap under a new lease\", what)\n602|\t}\n603|\tif fold.seenCheckpoint {\n604|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap past a validated checkpoint\", what)\n605|\t}\n606|\tif fold.seenAbort {\n607|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap past an authoritative abort\", what)\n608|\t}\n609|\treturn fold.step(StateCreating, what)\n610|}\n611|\n612|// effectTerminalCreated records the terminal binding; as the first\n613|// event it also opens the bootstrap in creating.\n614|func (fold *chainFold) effectTerminalCreated(event Event, what string) error {\n615|\tif event.SchemaVersion == \"4.0.0\" {\n616|\t\tbinding, err := payloadString(event.Payload, \"terminal_binding_id\")\n617|\t\tif err != nil {\n618|\t\t\treturn err\n619|\t\t}\n620|\t\tif _, err := scalar.ParseDigest(binding); err != nil {\n621|\t\t\treturn refuse(ErrDerivation, \"%s carries malformed terminal_binding_id: %v\", what, err)\n622|\t\t}\n623|\t\tbackend, err := payloadString(event.Payload, \"terminal_backend_id\")\n624|\t\tif err != nil {\n625|\t\t\treturn err\n626|\t\t}\n627|\t\tif _, err := terminalbackend.ParseID(backend); err != nil {\n628|\t\t\treturn refuse(ErrDerivation, \"%s carries refused terminal backend: %v\", what, err)\n629|\t\t}\n630|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, BindingID: binding, EventID: event.ID}\n631|\t} else {\n632|\t\tbackend, err := payloadString(event.Payload, \"backend\")\n633|\t\tif err != nil {\n634|\t\t\treturn err\n635|\t\t}\n636|\t\tif backend != \"tmux\" && backend != \"conpty\" {\n637|\t\t\treturn refuse(ErrDerivation, \"%s carries unknown terminal backend %q\", what, backend)\n638|\t\t}\n639|\t\tterminalID, err := payloadString(event.Payload, \"terminal_id\")\n640|\t\tif err != nil {\n641|\t\t\treturn err\n642|\t\t}\n643|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, TerminalID: terminalID, EventID: event.ID}\n644|\t}\n645|\tfold.projection.HasTerminal = true\n646|\tif fold.state == \"\" {\n647|\t\treturn fold.step(StateCreating, what)\n648|\t}\n649|\treturn nil\n650|}\n651|\n652|// effectProviderLaunched moves to running and records the launched\n653|// version. The record provider stays authoritative: a launched event\n654|// naming another provider records a provider_mismatch conflict under\n655|// the record-pinned-provider-wins rule instead of rewriting identity.\n656|func (fold *chainFold) effectProviderLaunched(event Event, what string) error {\n657|\tproviderID, err := payloadString(event.Payload, \"provider_id\")\n658|\tif err != nil {\n659|\t\treturn err\n(more lines below)","final_result":true}}}
