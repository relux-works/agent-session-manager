{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c98d","stream":{"kind":"session","id":"01a0b35d-fadf-7f82-925c-5ba6aefcf0a7"},"sequence":801,"recorded_at":1780531400001597,"record_type":"event","durability":"durable","causation_id":"38ee7473-f77a-4937-9e67-866e0a213216","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38ee7473-f77a-4937-9e67-866e0a213216","run_stream":{"kind":"run","id":"38ee7473-f77a-4937-9e67-866e0a213216"},"task_stream":{"kind":"task","id":"01a0b35f-dbec-7981-90e2-3bd1e5710645"},"task_id":"01a0b35f-dbec-7981-90e2-3bd1e5710645","event":{"kind":"output","task_id":"01a0b35f-dbec-7981-90e2-3bd1e5710645","chunk":"Read text file `internal/axpane/events_test.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n9|)\n10|\n11|func bindingFacts() TerminalBindingFacts {\n12|\treturn TerminalBindingFacts{\n13|\t\tBindingDigest:         seedDigest(0xB1),\n14|\t\tBackendID:             \"ax.tmux\",\n15|\t\tImplementationVersion: \"2.1.0\",\n16|\t\tProtocolVersion:       \"1.1.0\",\n17|\t\tProtocolVersions:      []string{\"1.0.0\", \"1.1.0\"},\n18|\t\tEvidenceIDs:           []string{seedDigest(0xE0), seedDigest(0xE1)},\n19|\t}\n20|}\n21|\n22|func TestParkedPayloadVocabulary(t *testing.T) {\n23|\tt.Parallel()\n24|\tfor _, reason := range []fencing.ParkReason{\n25|\t\tfencing.ParkRemoteOwner, fencing.ParkStaleOwner, fencing.ParkRestorePolicy, fencing.ParkFailedHandoff,\n26|\t} {\n27|\t\tpayload, err := ParkedPayload(reason, fixtureLeaseA)\n28|\t\tif err != nil {\n29|\t\t\tt.Fatalf(\"ParkedPayload(%q) error = %v\", string(reason), err)\n30|\t\t}\n31|\t\tif payload[\"reason\"] != string(reason) || payload[\"winning_lease_id\"] != fixtureLeaseA {\n32|\t\t\tt.Fatalf(\"ParkedPayload(%q) = %v\", string(reason), payload)\n33|\t\t}\n34|\t\tif len(payload) != 2 {\n35|\t\t\tt.Fatalf(\"ParkedPayload(%q) carries %d members, want exactly 2\", string(reason), len(payload))\n36|\t\t}\n37|\t}\n38|\tif _, err := ParkedPayload(fencing.ParkReason(\"bogus\"), fixtureLeaseA); err == nil {\n39|\t\tt.Fatal(\"ParkedPayload(bogus) succeeded, want refusal\")\n40|\t}\n41|\tif _, err := ParkedPayload(fencing.ParkRemoteOwner, \"not-a-lease\"); err == nil {\n42|\t\tt.Fatal(\"ParkedPayload(bad lease) succeeded, want refusal\")\n43|\t}\n44|}\n45|\n46|func TestTerminalCreatedPayload(t *testing.T) {\n47|\tt.Parallel()\n48|\tpayload, err := TerminalCreatedPayload(bindingFacts())\n49|\tif err != nil {\n50|\t\tt.Fatalf(\"TerminalCreatedPayload() error = %v\", err)\n51|\t}\n52|\twant := map[string]any{\n53|\t\t\"terminal_binding_id\":    seedDigest(0xB1),\n54|\t\t\"terminal_backend_id\":    \"ax.tmux\",\n55|\t\t\"implementation_version\": \"2.1.0\",\n56|\t\t\"protocol_version\":       \"1.1.0\",\n57|\t\t\"evidence_ids\":           []string{seedDigest(0xE0), seedDigest(0xE1)},\n58|\t}\n59|\traw, _ := json.Marshal(payload)\n60|\tvar decoded map[string]any\n61|\tif err := json.Unmarshal(raw, &decoded); err != nil {\n62|\t\tt.Fatal(err)\n63|\t}\n64|\tif len(decoded) != len(want) {\n65|\t\tt.Fatalf(\"TerminalCreatedPayload() members = %v, want exactly %v\", decoded, want)\n66|\t}\n67|\tfor name, value := range want {\n68|\t\tround, _ := json.Marshal(decoded[name])\n69|\t\texpect, _ := json.Marshal(value)\n70|\t\tif string(round) != string(expect) {\n71|\t\t\tt.Fatalf(\"TerminalCreatedPayload()[%q] = %s, want %s\", name, round, expect)\n72|\t\t}\n73|\t}\n74|\tcases := []struct {\n75|\t\tname   string\n76|\t\tmutate func(*TerminalBindingFacts)\n77|\t}{\n78|\t\t{\"bad digest\", func(facts *TerminalBindingFacts) { facts.BindingDigest = \"nope\" }},\n79|\t\t{\"bad backend\", func(facts *TerminalBindingFacts) { facts.BackendID = \"Bogus!\" }},\n80|\t\t{\"bad versions\", func(facts *TerminalBindingFacts) { facts.ProtocolVersion = \"2.0.0\" }},\n81|\t\t{\"empty evidence\", func(facts *TerminalBindingFacts) { facts.EvidenceIDs = nil }},\n82|\t\t{\"unsorted evidence\", func(facts *TerminalBindingFacts) {\n83|\t\t\tfacts.EvidenceIDs = []string{seedDigest(0xE1), seedDigest(0xE0)}\n84|\t\t}},\n85|\t\t{\"bad evidence digest\", func(facts *TerminalBindingFacts) { facts.EvidenceIDs = []string{\"nope\"} }},\n86|\t}\n87|\tfor _, testCase := range cases {\n88|\t\tt.Run(testCase.name, func(t *testing.T) {\n89|\t\t\tt.Parallel()\n90|\t\t\tfacts := bindingFacts()\n91|\t\t\ttestCase.mutate(&facts)\n92|\t\t\tif _, err := TerminalCreatedPayload(facts); err == nil {\n93|\t\t\t\tt.Fatalf(\"TerminalCreatedPayload(%s) succeeded, want refusal\", testCase.name)\n94|\t\t\t}\n95|\t\t})\n96|\t}\n97|}\n98|\n99|func TestResumedPayload(t *testing.T) {\n100|\tt.Parallel()\n101|\tpayload, err := ResumedPayload(seedDigest(0xC9), \"yolo\", seedDigest(0xCA), true, bindingFacts())\n102|\tif err != nil {\n103|\t\tt.Fatalf(\"ResumedPayload() error = %v\", err)\n104|\t}\n105|\tif payload[\"checkpoint_id\"] != seedDigest(0xC9) || payload[\"execution_profile\"] != \"yolo\" || payload[\"profile_source_event_id\"] != seedDigest(0xCA) {\n106|\t\tt.Fatalf(\"ResumedPayload() = %v\", payload)\n107|\t}\n108|\tif len(payload) != 8 {\n109|\t\tt.Fatalf(\"ResumedPayload() carries %d members, want exactly 8\", len(payload))\n110|\t}\n111|\tnullSource, err := ResumedPayload(seedDigest(0xC9), \"standard\", \"\", false, bindingFacts())\n112|\tif err != nil {\n113|\t\tt.Fatalf(\"ResumedPayload(null source) error = %v\", err)\n114|\t}\n115|\tif nullSource[\"profile_source_event_id\"] != nil {\n116|\t\tt.Fatalf(\"ResumedPayload(null source) source = %v, want null\", nullSource[\"profile_source_event_id\"])\n117|\t}\n118|\tif _, err := ResumedPayload(\"nope\", \"standard\", \"\", false, bindingFacts()); err == nil {\n119|\t\tt.Fatal(\"ResumedPayload(bad checkpoint) succeeded, want refusal\")\n120|\t}\n121|\tif _, err := ResumedPayload(seedDigest(0xC9), \"bogus\", \"\", false, bindingFacts()); err == nil {\n122|\t\tt.Fatal(\"ResumedPayload(bad profile) succeeded, want refusal\")\n123|\t}\n124|\tif _, err := ResumedPayload(seedDigest(0xC9), \"yolo\", \"nope\", true, bindingFacts()); err == nil {\n125|\t\tt.Fatal(\"ResumedPayload(bad source) succeeded, want refusal\")\n126|\t}\n127|}\n128|\n129|// TestEmitParkedRoundTrip authors the parked event for a Decide\n130|// parked outcome through the sessrepo owner under the locally held\n(more lines below)","final_result":true}}}
