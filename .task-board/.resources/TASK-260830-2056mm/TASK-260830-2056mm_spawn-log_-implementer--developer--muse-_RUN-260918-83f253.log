{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc33","stream":{"kind":"session","id":"01a0b35d-fadf-7f82-925c-5ba6aefcf0a7"},"sequence":1140,"recorded_at":1780531400002275,"record_type":"event","durability":"durable","causation_id":"38ee7473-f77a-4937-9e67-866e0a213216","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38ee7473-f77a-4937-9e67-866e0a213216","run_stream":{"kind":"run","id":"38ee7473-f77a-4937-9e67-866e0a213216"},"call_id":"call_01a0b363b28270398936bc09456fe3c3","text":"{\n  \"chunk_id\": \"exec-28-1\",\n  \"command\": \"grep -n \\\"func DecodeStrictObject\\\" -A 3 internal/environ/*.go | grep -v _test | head -n 8\\necho \\\"===SCHEMA-CONSTS===\\\"\\ngrep -n \\\"SchemaManifest\\\\|SchemaProbe\\\\|SchemaCapabilityEvidence\\\\|BuiltinTmux\\\\|BuiltinConpty\\\\|IssuerLocalProbe\\\" internal/terminalbackend/manifest.go internal/terminalbackend/terminalbackend.go | grep -v _test | head -n 12\\necho \\\"===DISPOSITION===\\\"\\nsed -n '1,54p' internal/terminstance/disposition.go\\necho \\\"===SESSREPO-SIGS===\\\"\\ngrep -n \\\"^func Open\\\\|^func (repository \\\\*Repository)\\\" internal/sessrepo/*.go | grep -v _test | head -n 25\\necho \\\"===SESSQUERY-EXPORTS===\\\"\\ngrep -n \\\"^func [A-Z]\\\" internal/sessquery/*.go | grep -v _test | head -n 25\",\n  \"description\": \"Check helpers, consts, repo and query APIs\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"internal/environ/decode.go:58:func DecodeStrictObject(data []byte) (map[string]json.RawMessage, *Fault) {\\ninternal/environ/decode.go-59-\\tif !utf8.Valid(data) {\\ninternal/environ/decode.go-60-\\t\\treturn nil, &Fault{Detail: FaultNotUTF8}\\ninternal/environ/decode.go-61-\\t}\\n===SCHEMA-CONSTS===\\ninternal/terminalbackend/manifest.go:71:\\t// SchemaManifest is the Terminal Backend Manifest 1.0.0 schema URN.\\ninternal/terminalbackend/manifest.go:72:\\tSchemaManifest = \\\"urn:ax:schema:terminal-backend-manifest\\\"\\ninternal/terminalbackend/manifest.go:73:\\t// SchemaProbe is the Terminal Backend Probe 1.0.0 schema URN.\\ninternal/terminalbackend/manifest.go:74:\\tSchemaProbe = \\\"urn:ax:schema:terminal-backend-probe\\\"\\ninternal/terminalbackend/manifest.go:75:\\t// SchemaCapabilityEvidence is the Capability Evidence 1.0.0 schema URN.\\ninternal/terminalbackend/manifest.go:76:\\tSchemaCapabilityEvidence = \\\"urn:ax:schema:terminal-capability-evidence\\\"\\ninternal/terminalbackend/manifest.go:99:\\t// IssuerLocalProbe marks host-incarnation-signed capability evidence.\\ninternal/terminalbackend/manifest.go:100:\\tIssuerLocalProbe = \\\"ax_local_probe\\\"\\ninternal/terminalbackend/manifest.go:990:\\tif schema, err := stringMember(object, \\\"schema\\\"); err != nil || schema != SchemaManifest {\\ninternal/terminalbackend/manifest.go:1136:\\tif schema, err := stringMember(object, \\\"schema\\\"); err != nil || schema != SchemaProbe {\\ninternal/terminalbackend/manifest.go:1282:\\tif schema, err := stringMember(object, \\\"schema\\\"); err != nil || schema != SchemaCapabilityEvidence {\\ninternal/terminalbackend/manifest.go:1365:\\tif issuer != IssuerRelease && issuer != IssuerLocalProbe {\\n===DISPOSITION===\\npackage terminstance\\n\\n// RetryDisposition is the closed §4.C retry disposition enum. Every\\n// result carries exactly one.\\ntype RetryDisposition string\\n\\n// Retry dispositions.\\nconst (\\n\\tDispositionReplaySame             RetryDisposition = \\\"replay_same\\\"\\n\\tDispositionStatusFirst            RetryDisposition = \\\"status_first\\\"\\n\\tDispositionNewAuthorization       RetryDisposition = \\\"new_authorization\\\"\\n\\tDispositionRequiredOperatorAction RetryDisposition = \\\"required_operator_action\\\"\\n)\\n\\n// ParseRetryDisposition admits exactly the four §4.C dispositions.\\nfunc ParseRetryDisposition(value string) (RetryDisposition, error) {\\n\\tswitch RetryDisposition(value) {\\n\\tcase DispositionReplaySame, DispositionStatusFirst,\\n\\t\\tDispositionNewAuthorization, DispositionRequiredOperatorAction:\\n\\t\\treturn RetryDisposition(value), nil\\n\\tdefault:\\n\\t\\treturn \\\"\\\", refuse(CodeProtocolError, \\\"retry disposition vocabulary\\\")\\n\\t}\\n}\\n\\n// DispositionFor maps a terminal failure code to its retry disposition.\\n// committed reports whether any side effect committed before the failure:\\n// an error before the first effect restores the source state and may be\\n// retried or refused by class, while an error after a committed effect\\n// whose result cannot be proven funnels to status_first, because only a\\n// successful status read proves what happened. The spec pins the\\n// disposition vocabulary but not the per-code mapping, so this mapping is\\n// the leaf's contract, pinned literally per arm:\\n//\\n//   - terminal_backend_unauthorized names its own remedy in both cases:\\n//     the lease moved or lapsed and status cannot fix auth.\\n//   - terminal_backend_timeout and quiesce_timeout are clean before any\\n//     commit (retry the identical wait) and uncertain after one.\\n//   - stop_timeout, idempotency_mismatch, terminal_backend_stale_generation,\\n//     local_precondition_failed and terminal_backend_unavailable always\\n//     route through status: a stop wait, a window conflict, a drifted\\n//     generation, a refused precondition and an unserved backend all\\n//     require a fresh observation before any retry.\\n//   - terminal_backend_capability_unproven,\\n//     terminal_backend_integrity_failure, terminal_backend_process_failed,\\n//     terminal_backend_protocol_error and any unknown code stop automation\\n//     before any commit (an operator must prove the capability, heal the\\n//     backend, or fix the caller) and route through status after one,\\n//     because the committed effect's result is then unproven.\\n//\\n// A code the row forbids never reaches here: the engine routes backend\\n// reports through CheckErrorAllowed first, so the default arm below fires\\n// only for an uncoded failure the engine classified itself.\\nfunc DispositionFor(code string, committed bool) RetryDisposition {\\n===SESSREPO-SIGS===\\ninternal/sessrepo/chain.go:248:func (repository *Repository) sessionDir(sessionID string) string {\\ninternal/sessrepo/chain.go:256:func (repository *Repository) loadSessionLocked(sessionID string) (*sessionView, error) {\\ninternal/sessrepo/chain.go:389:func (repository *Repository) writeChain(directory string, chain storedChain) error {\\ninternal/sessrepo/lease_store.go:203:func (repository *Repository) leasesDir(sessionID string) string {\\ninternal/sessrepo/lease_store.go:249:func (repository *Repository) CreateLease(sessionID string, input CreateLeaseInput) (LeaseRef, error) {\\ninternal/sessrepo/lease_store.go:297:func (repository *Repository) CompareAndSwapLease(sessionID string, expected LeaseExpectation, input SuccessorLeaseInput) (LeaseRef, error) {\\ninternal/sessrepo/lease_store.go:365:func (repository *Repository) GetLease(sessionID, recordID string) ([]byte, error) {\\ninternal/sessrepo/lease_store.go:388:func (repository *Repository) ListLeases(sessionID string) ([]LeaseSummary, error) {\\ninternal/sessrepo/lease_store.go:405:func (repository *Repository) WinningLease(sessionID string) (LeaseSummary, error) {\\ninternal/sessrepo/lease_store.go:431:func (repository *Repository) VerifyFencingToken(sessionID string, token FencingToken) error {\\ninternal/sessrepo/lease_store.go:492:func (repository *Repository) loadLeasesLocked(directory, sessionID string) ([]LeaseSummary, error) {\\ninternal/sessrepo/lease_store.go:570:func (repository *Repository) installLeaseBlobLocked(directory, recordID string, data []byte) error {\\ninternal/sessrepo/sessrepo.go:148:func Open(dataRoot string) (*Repository, error) {\\ninternal/sessrepo/sessrepo.go:161:func (repository *Repository) CreateSession(recordJSON []byte) (SessionRef, error) {\\ninternal/sessrepo/sessrepo.go:220:func (repository *Repository) crashCreateStep(step CreateStep) error {\\ninternal/sessrepo/sessrepo.go:242:func (repository *Repository) resumeCreateLocked(directory string, record sessionRecord, recordJSON []byte) (bool, error) {\\ninternal/sessrepo/sessrepo.go:281:func (repository *Repository) AppendEvent(sessionID string, eventJSON []byte) (EventRef, error) {\\ninternal/sessrepo/store.go:33:func (repository *Repository) GetRecord(sessionID string) ([]byte, error) {\\ninternal/sessrepo/store.go:44:func (repository *Repository) GetEvent(sessionID, eventID string) ([]byte, error) {\\ninternal/sessrepo/store.go:67:func (repository *Repository) ListEvents(sessionID string) ([]EventSummary, error) {\\ninternal/sessrepo/store.go:97:func (repository *Repository) ListSessions() ([]SessionSummary, error) {\\ninternal/sessrepo/store.go:113:func (repository *Repository) Resolve(query string) (SessionSummary, error) {\\ninternal/sessrepo/store.go:151:func (repository *Repository) listSessionsLocked() ([]SessionSummary, error) {\\n===SESSQUERY-EXPORTS===\\ninternal/sessquery/plan.go:116:func BoundariesFor(action string) ([]string, bool) {\\ninternal/sessquery/revalidate.go:546:func ParsePlan(raw []byte) (SelectionPlan, error) {\\ninternal/sessquery/selector.go:92:func ParseSelector(argument string) (Selector, error) {\\n\",\n  \"original_output_bytes\": 7495,\n  \"original_output_tokens\": 1874,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
