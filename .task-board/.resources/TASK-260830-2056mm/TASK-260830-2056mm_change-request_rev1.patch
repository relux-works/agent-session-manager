+	world.manifestID = world.manifest["manifest_id"].(string)
+	world.evidence = map[string]any{
+		"schema":                     terminalbackend.SchemaCapabilityEvidence,
+		"schema_version":             "1.0.0",
+		"evidence_id":                "",
+		"terminal_backend_id":        backendID,
