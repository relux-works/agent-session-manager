+// rv3Digests mints n distinct valid digests in ascending bytewise order.
+func rv3Digests(n int) []string {
+	out := make([]string, 0, n)
+	for i := 0; i < n; i++ {
+		out = append(out, fmt.Sprintf("sha256:%064x", i))
+	}
+	return out
+}
