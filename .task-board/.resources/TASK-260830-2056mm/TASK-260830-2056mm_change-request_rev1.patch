+			digest := sha256.Sum256(message)
+			return rsa.VerifyPKCS1v15(&key.PublicKey, crypto.SHA256, digest[:], signature)
+		},
+		now: now,
+	}
+	generationDigest, err := terminalbackend.GenerationDigest(rawGeneration)
+	if err != nil {
