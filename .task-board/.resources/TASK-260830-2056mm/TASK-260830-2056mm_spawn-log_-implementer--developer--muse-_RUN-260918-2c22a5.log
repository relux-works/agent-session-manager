{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7d5","stream":{"kind":"session","id":"01a0b3be-22c5-72c2-9a68-fcdf0b06f553"},"sequence":581,"recorded_at":1780531400001157,"record_type":"event","durability":"durable","causation_id":"4c090c0f-8ac7-469e-b4bd-d568cdc91e07","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4c090c0f-8ac7-469e-b4bd-d568cdc91e07","run_stream":{"kind":"run","id":"4c090c0f-8ac7-469e-b4bd-d568cdc91e07"},"call_id":"call_01a0b3c018b570b78c8a8edc6fedbfb0","text":"Read text file `internal/termbind/resolve_test.go`.\n1|package termbind\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"sort\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n10|)\n11|\n12|func tmuxTuple() EventTuple {\n13|\treturn EventTuple{BackendID: terminalbackend.BuiltinTmux, ImplementationVersion: fixtureImpl, ProtocolVersion: fixtureProto}\n14|}\n15|\n16|func distinctDigest(index int) string {\n17|\treturn fmt.Sprintf(\"sha256:%064x\", index)\n18|}\n19|\n20|func TestResolveEvidenceAdmitsUniverse(t *testing.T) {\n21|\tt.Parallel()\n22|\tworld := buildTmuxUniverse(t)\n23|\tresolved, err := ResolveEvidence(world.ids, tmuxTuple(), world.registry, universeMap(t, world), world.rawGeneration, world.now, world.verify)\n24|\tif err != nil {\n25|\t\tt.Fatalf(\"ResolveEvidence() error = %v\", err)\n26|\t}\n27|\tif resolved.Manifest.ManifestID != world.manifestID {\n28|\t\tt.Fatalf(\"ManifestID = %q, want %q\", resolved.Manifest.ManifestID, world.manifestID)\n29|\t}\n30|\tif resolved.Probe.ProbeID != world.probeID {\n31|\t\tt.Fatalf(\"ProbeID = %q, want %q\", resolved.Probe.ProbeID, world.probeID)\n32|\t}\n33|\tif len(resolved.Evidence) != 1 || resolved.Evidence[0].EvidenceID != world.evidenceID {\n34|\t\tt.Fatalf(\"Evidence = %+v, want the one fixture evidence\", resolved.Evidence)\n35|\t}\n36|\tif !resolved.Admitted.Has(\"durable_disconnect\") {\n37|\t\tt.Fatalf(\"Admitted = %+v, want durable_disconnect\", resolved.Admitted)\n38|\t}\n39|}\n40|\n41|func TestResolveEvidenceShapeBounds(t *testing.T) {\n42|\tt.Parallel()\n43|\tworld := buildTmuxUniverse(t)\n44|\tuniverse := universeMap(t, world)\n45|\tresolve := func(ids []string) error {\n46|\t\t_, err := ResolveEvidence(ids, tmuxTuple(), world.registry, universe, world.rawGeneration, world.now, world.verify)\n47|\t\treturn err\n48|\t}\n49|\tt.Run(\"empty refuses\", func(t *testing.T) {\n50|\t\tt.Parallel()\n51|\t\terr := resolve(nil)\n52|\t\tif err == nil || !strings.Contains(err.Error(), \"1..256\") {\n53|\t\t\tt.Fatalf(\"ResolveEvidence(0) error = %v, want the 1..256 bound\", err)\n54|\t\t}\n55|\t})\n56|\tt.Run(\"257 refuses\", func(t *testing.T) {\n57|\t\tt.Parallel()\n58|\t\tids := make([]string, 0, 257)\n59|\t\tfor i := 0; i < 257; i++ {\n60|\t\t\tids = append(ids, distinctDigest(i))\n61|\t\t}\n62|\t\tsort.Strings(ids)\n63|\t\terr := resolve(ids)\n64|\t\tif err == nil || !strings.Contains(err.Error(), \"1..256\") {\n65|\t\t\tt.Fatalf(\"ResolveEvidence(257) error = %v, want the 1..256 bound\", err)\n66|\t\t}\n67|\t})\n68|\tt.Run(\"unsorted refuses\", func(t *testing.T) {\n69|\t\tt.Parallel()\n70|\t\tids := []string{world.manifestID, world.probeID}\n71|\t\tsort.Strings(ids)\n72|\t\tids[0], ids[1] = ids[1], ids[0]\n73|\t\terr := resolve(ids)\n74|\t\tif err == nil || !strings.Contains(err.Error(), \"sorted unique\") {\n75|\t\t\tt.Fatalf(\"ResolveEvidence(unsorted) error = %v, want sorted unique\", err)\n76|\t\t}\n77|\t})\n78|\tt.Run(\"duplicate refuses\", func(t *testing.T) {\n79|\t\tt.Parallel()\n80|\t\tids := []string{world.manifestID, world.manifestID, world.probeID}\n81|\t\tsort.Strings(ids)\n82|\t\terr := resolve(ids)\n83|\t\tif err == nil || !strings.Contains(err.Error(), \"sorted unique\") {\n84|\t\t\tt.Fatalf(\"ResolveEvidence(duplicate) error = %v, want sorted unique\", err)\n85|\t\t}\n86|\t})\n87|\tt.Run(\"non-digest refuses\", func(t *testing.T) {\n88|\t\tt.Parallel()\n89|\t\tif err := resolve([]string{\"not-a-digest\"}); err == nil || !strings.Contains(err.Error(), \"not a digest\") {\n90|\t\t\tt.Fatalf(\"ResolveEvidence(non-digest) error = %v, want digest grammar\", err)\n91|\t\t}\n92|\t})\n93|\tt.Run(\"one passes shape to partition\", func(t *testing.T) {\n94|\t\tt.Parallel()\n95|\t\t// A lone evidence ID passes the wire shape (1..256 admits one)\n96|\t\t// and refuses later at the manifest/probe partition: one digest\n97|\t\t// cannot name all three objects. The mismatch class proves the\n98|\t\t// shape arm admitted it.\n99|\t\terr := resolve([]string{world.evidenceID})\n100|\t\trequireCode(t, err, \"terminal_backend_manifest_probe_mismatch\")\n101|\t})\n102|\tt.Run(\"256 passes shape to lookup\", func(t *testing.T) {\n103|\t\tt.Parallel()\n104|\t\t// 256 sorted unique digests pass the wire shape and refuse at\n105|\t\t// lookup: no universe holds them. The mismatch class proves the\n106|\t\t// shape arm admitted the upper bound.\n107|\t\tids := make([]string, 0, 256)\n108|\t\tfor i := 0; i < 256; i++ {\n109|\t\t\tids = append(ids, distinctDigest(i))\n110|\t\t}\n111|\t\tsort.Strings(ids)\n112|\t\terr := resolve(ids)\n113|\t\trequireCode(t, err, \"terminal_backend_manifest_probe_mismatch\")\n114|\t})\n115|}\n116|\n117|func TestResolveEvidenceRefusesForeignKinds(t *testing.T) {\n118|\tt.Parallel()\n119|\ttargets := []struct {\n120|\t\tname  string\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
