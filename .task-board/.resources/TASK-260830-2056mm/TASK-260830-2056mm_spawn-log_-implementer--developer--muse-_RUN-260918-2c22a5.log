ignature\"] = tampered\n306|\t\tforged[\"evidence_id\"] = omitSelfIdentity(t, forged, \"evidence_id\")\n307|\t\tforgedID := forged[\"evidence_id\"].(string)\n308|\t\tprobe := cloneDoc(world.probe)\n309|\t\tprobe[\"evidence_ids\"] = []any{forgedID}\n310|\t\tprobe[\"probe_id\"] = omitSelfIdentity(t, probe, \"probe_id\")\n311|\t\tprobeID := probe[\"probe_id\"].(string)\n312|\t\tuniverse := mapUniverse{\n313|\t\t\tworld.manifestID: mustJSON(t, world.manifest),\n314|\t\t\tprobeID:          mustJSON(t, probe),\n315|\t\t\tforgedID:         mustJSON(t, forged),\n316|\t\t}\n317|\t\tids := []string{world.manifestID, probeID, forgedID}\n318|\t\tsort.Strings(ids)\n319|\t\t_, err := ResolveEvidence(ids, tmuxTuple(), world.registry, universe, world.rawGeneration, world.now, world.verify)\n320|\t\tif err == nil {\n321|\t\t\tt.Fatal(\"ResolveEvidence(forged signature) succeeded, want the landed refusal\")\n322|\t\t}\n323|\t\tif _, ok := err.(*terminalbackend.Error); !ok {\n324|\t\t\tt.Fatalf(\"error type = %T, want the landed *terminalbackend.Error\", err)\n325|\t\t}\n326|\t})\n327|\tt.Run(\"expired evidence\", func(t *testing.T) {\n328|\t\tt.Parallel()\n329|\t\tworld := buildTmuxUniverse(t)\n330|\t\tstale := cloneDoc(world.evidence)\n331|\t\tstale[\"expires_at\"] = \"2025-06-02T00:00:00.000Z\"\n332|\t\tstale[\"observed_at\"] = \"2025-06-01T00:00:00.000Z\"\n333|\t\tstale[\"evidence_id\"] = omitSelfIdentity(t, stale, \"evidence_id\")\n334|\t\tstaleID := stale[\"evidence_id\"].(string)\n335|\t\tprobe := cloneDoc(world.probe)\n336|\t\tprobe[\"evidence_ids\"] = []any{staleID}\n337|\t\tprobe[\"probe_id\"] = omitSelfIdentity(t, probe, \"probe_id\")\n338|\t\tprobeID := probe[\"probe_id\"].(string)\n339|\t\tuniverse := mapUniverse{\n340|\t\t\tworld.manifestID: mustJSON(t, world.manifest),\n341|\t\t\tprobeID:          mustJSON(t, probe),\n342|\t\t\tstaleID:          mustJSON(t, stale),\n343|\t\t}\n344|\t\tids := []string{world.manifestID, probeID, staleID}\n345|\t\tsort.Strings(ids)\n346|\t\t_, err := ResolveEvidence(ids, tmuxTuple(), world.registry, universe, world.rawGeneration, world.now, world.verify)\n347|\t\tif err == nil {\n348|\t\t\tt.Fatal(\"ResolveEvidence(expired evidence) succeeded, want the landed refusal\")\n349|\t\t}\n350|\t\tif _, ok := err.(*terminalbackend.Error); !ok {\n351|\t\t\tt.Fatalf(\"error type = %T, want the landed *terminalbackend.Error\", err)\n352|\t\t}\n353|\t})\n354|}\n355|\n356|func TestResolvedObjectsCarryNoLiveFacts(t *testing.T) {\n357|\tt.Parallel()\n358|\tworld := buildTmuxUniverse(t)\n359|\tresolved, err := ResolveEvidence(world.ids, tmuxTuple(), world.registry, universeMap(t, world), world.rawGeneration, world.now, world.verify)\n360|\tif err != nil {\n361|\t\tt.Fatal(err)\n362|\t}\n363|\tshown := []string{}\n364|\tfor _, object := range []struct {\n365|\t\tname string\n366|\t\traw  []byte\n367|\t}{\n368|\t\t{\"manifest\", mustJSON(t, world.manifest)},\n369|\t\t{\"probe\", mustJSON(t, world.probe)},\n370|\t\t{\"evidence\", mustJSON(t, world.evidence)},\n371|\t} {\n372|\t\tshown = append(shown, object.name+\"=\"+string(object.raw))\n373|\t}\n374|\tjoined := strings.Join(shown, \"\\n\")\n375|\tfor _, forbidden := range []string{world.rawGeneration, \"native_reference\", \"terminal_instance_id\", \"attach_descriptor\"} {\n376|\t\tif strings.Contains(joined, forbidden) {\n377|\t\t\tt.Fatalf(\"resolved %q leaks %q\", joined, forbidden)\n378|\t\t}\n379|\t}\n(more lines below)","final_result":true}}}
