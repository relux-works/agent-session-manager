atal(err)\n108|\t\t\t}\n109|\t\t\tbound := bindPair(t, store, fixtureSession, fixtureBootstrap, fixtureInstance)\n110|\t\t\tverdict, err := recoverWith(t, store, func(terminstance.StatusBody) (terminstance.StatusObservation, error) {\n111|\t\t\t\treturn exactObservation(state, true), nil\n112|\t\t\t}, recoveryRequest(fixtureBootstrap, true))\n113|\t\t\tif err != nil {\n114|\t\t\t\tt.Fatalf(\"RecoverCreate() error = %v\", err)\n115|\t\t\t}\n116|\t\t\tif verdict.Outcome != RecoveryChild || !verdict.HasBinding {\n117|\t\t\t\tt.Fatalf(\"verdict = %+v, want the one child\", verdict)\n118|\t\t\t}\n119|\t\t\tif verdict.Binding != bound {\n120|\t\t\t\tt.Fatalf(\"verdict binding = %+v, want %+v\", verdict.Binding, bound)\n121|\t\t\t}\n122|\t\t\tif verdict.State != state || verdict.Retry != terminstance.DispositionReplaySame {\n123|\t\t\t\tt.Fatalf(\"verdict = %+v, want state %q with replay_same\", verdict, string(state))\n124|\t\t\t}\n125|\t\t})\n126|\t}\n127|}\n128|\n129|func TestRecoverCreateDuplicateRetrySameVerdict(t *testing.T) {\n130|\tt.Parallel()\n131|\tstore, err := axpane.Open(t.TempDir())\n132|\tif err != nil {\n133|\t\tt.Fatal(err)\n134|\t}\n135|\tbindPair(t, store, fixtureSession, fixtureBootstrap, fixtureInstance)\n136|\tobserve := func(terminstance.StatusBody) (terminstance.StatusObservation, error) {\n137|\t\treturn exactObservation(terminalbackend.StateActive, true), nil\n138|\t}\n139|\tfirst, err := recoverWith(t, store, observe, recoveryRequest(fixtureBootstrap, true))\n140|\tif err != nil {\n141|\t\tt.Fatal(err)\n142|\t}\n143|\tsecond, err := recoverWith(t, store, observe, recoveryRequest(fixtureBootstrap, true))\n144|\tif err != nil {\n145|\t\tt.Fatal(err)\n146|\t}\n147|\tif first != second {\n148|\t\tt.Fatalf(\"retry verdict = %+v, want %+v\", second, first)\n149|\t}\n150|}\n151|\n152|func TestRecoverCreateChangedOperationInWindowRefuses(t *testing.T) {\n153|\tt.Parallel()\n154|\trepository, _ := chainFixture(t)\n155|\thasNewest, _ := foldNewest(t, repository)\n156|\tif hasNewest {\n157|\t\tt.Fatal(\"bootstrap chain folds a newest checkpoint, want the open window\")\n158|\t}\n159|\tstore, err := axpane.Open(t.TempDir())\n160|\tif err != nil {\n161|\t\tt.Fatal(err)\n162|\t}\n163|\tbindPair(t, store, fixtureSession, fixtureBootstrap, fixtureInstance)\n164|\t_, err = recoverWith(t, store, func(terminstance.StatusBody) (terminstance.StatusObservation, error) {\n165|\t\tt.Fatal(\"status runs past the window mismatch\")\n166|\t\treturn terminstance.StatusObservation{}, nil\n167|\t}, recoveryRequest(fixtureOtherOp, !hasNewest))\n168|\trequireCode(t, err, \"idempotency_mismatch\")\n169|}\n170|\n171|func checkpointChain(t *testing.T) *sessrepo.Repository {\n172|\tt.Helper()\n173|\trepository, _ := chainFixture(t)\n174|\ttail := chainTail(t, repository)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
