{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c709","stream":{"kind":"session","id":"01a0b3be-22c5-72c2-9a68-fcdf0b06f553"},"sequence":479,"recorded_at":1780531400000953,"record_type":"event","durability":"durable","causation_id":"4c090c0f-8ac7-469e-b4bd-d568cdc91e07","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"4c090c0f-8ac7-469e-b4bd-d568cdc91e07","run_stream":{"kind":"run","id":"4c090c0f-8ac7-469e-b4bd-d568cdc91e07"},"call_id":"call_01a0b3bfb15173848f95e5f651c35ef9","text":"Read text file `internal/termbind/fixtures_test.go`.\n(449 line(s) above)\n450|\tif err != nil {\n451|\t\tt.Fatalf(\"canonicalize omit-self object: %v\", err)\n452|\t}\n453|\tsum := sha256.Sum256(canonical)\n454|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n455|}\n456|\n457|func evidenceMessage(t *testing.T, object map[string]any) []byte {\n458|\tt.Helper()\n459|\tomitted := make(map[string]any, len(object))\n460|\tfor name, member := range object {\n461|\t\tif name != \"evidence_id\" && name != \"attestation_signature\" {\n462|\t\t\tomitted[name] = member\n463|\t\t}\n464|\t}\n465|\tserialized, err := json.Marshal(omitted)\n466|\tif err != nil {\n467|\t\tt.Fatalf(\"marshal unsigned evidence: %v\", err)\n468|\t}\n469|\tcanonical, err := jcs.Transform(serialized)\n470|\tif err != nil {\n471|\t\tt.Fatalf(\"canonicalize unsigned evidence: %v\", err)\n472|\t}\n473|\tmessage := append([]byte(\"ax-terminal-capability-evidence-v1\"), 0x00)\n474|\treturn append(message, canonical...)\n475|}\n476|\n477|func mustJSON(t *testing.T, object map[string]any) []byte {\n478|\tt.Helper()\n479|\traw, err := json.Marshal(object)\n480|\tif err != nil {\n481|\t\tt.Fatal(err)\n482|\t}\n483|\treturn raw\n484|}\n485|\n486|// mapUniverse is an EvidenceUniverse backed by an ID-keyed map.\n487|type mapUniverse map[string][]byte\n488|\n489|func (universe mapUniverse) Lookup(id string) ([]byte, bool) {\n490|\traw, found := universe[id]\n491|\treturn raw, found\n492|}\n493|\n494|func universeMap(t *testing.T, world *universe) mapUniverse {\n495|\tt.Helper()\n496|\treturn mapUniverse{\n497|\t\tworld.manifestID: mustJSON(t, world.manifest),\n498|\t\tworld.probeID:    mustJSON(t, world.probe),\n499|\t\tworld.evidenceID: mustJSON(t, world.evidence),\n500|\t}\n501|}\n502|\n503|// --- status engine fixtures ---\n504|\n505|type mockBackend struct {\n506|\tobserve func(body terminstance.StatusBody) (terminstance.StatusObservation, error)\n507|}\n508|\n509|func (backend *mockBackend) PerformEffect(_ context.Context, _ terminalbackend.SideEffect) (string, error) {\n510|\treturn \"\", errors.New(\"mock backend performs no effects\")\n511|}\n512|\n513|func (backend *mockBackend) ObserveStatus(_ context.Context, body terminstance.StatusBody) (terminstance.StatusObservation, error) {\n514|\treturn backend.observe(body)\n515|}\n516|\n517|func testEngine(backend terminstance.Backend) *terminstance.Engine {\n518|\treturn &terminstance.Engine{Backend: backend, Now: fixtureNow}\n519|}\n520|\n521|// --- attach fixtures ---\n522|\n523|func attachAuth(t *testing.T, transport string, inputAuthorized bool, issuedAt, expiresAt string) []byte {\n524|\tt.Helper()\n525|\traw, err := json.Marshal(map[string]any{\n526|\t\t\"policy_evidence_id\":  seedDigest(0xA0),\n527|\t\t\"authorizing_host_id\": fixtureLocalHost,\n528|\t\t\"transport\":           transport,\n529|\t\t\"input_authorized\":    inputAuthorized,\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
