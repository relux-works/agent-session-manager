{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c80f","stream":{"kind":"session","id":"01a0b3be-22c5-72c2-9a68-fcdf0b06f553"},"sequence":610,"recorded_at":1780531400001215,"record_type":"event","durability":"durable","causation_id":"4c090c0f-8ac7-469e-b4bd-d568cdc91e07","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4c090c0f-8ac7-469e-b4bd-d568cdc91e07","run_stream":{"kind":"run","id":"4c090c0f-8ac7-469e-b4bd-d568cdc91e07"},"task_stream":{"kind":"task","id":"01a0b3c0-501a-7891-a92b-204bb0198472"},"task_id":"01a0b3c0-501a-7891-a92b-204bb0198472","event":{"kind":"output","task_id":"01a0b3c0-501a-7891-a92b-204bb0198472","chunk":"Read text file `internal/termbind/recover_test.go`.\n(74 line(s) above)\n75|\tt.Helper()\n76|\tdeps := RecoveryDeps{Bindings: store, Engine: testEngine(&mockBackend{observe: observe})}\n77|\treturn RecoverCreate(context.Background(), deps, request)\n78|}\n79|\n80|func TestRecoverCreateProvesAbsence(t *testing.T) {\n81|\tt.Parallel()\n82|\tstore, err := axpane.Open(t.TempDir())\n83|\tif err != nil {\n84|\t\tt.Fatal(err)\n85|\t}\n86|\tverdict, err := recoverWith(t, store, func(terminstance.StatusBody) (terminstance.StatusObservation, error) {\n87|\t\treturn sessionObservation(terminalbackend.StateAbsent, fixtureSession), nil\n88|\t}, recoveryRequest(fixtureBootstrap, true))\n89|\tif err != nil {\n90|\t\tt.Fatalf(\"RecoverCreate() error = %v\", err)\n91|\t}\n92|\tif verdict.Outcome != RecoveryAbsent || verdict.Retry != terminstance.DispositionReplaySame {\n93|\t\tt.Fatalf(\"verdict = %+v, want absent with replay_same\", verdict)\n94|\t}\n95|\tif verdict.HasBinding {\n96|\t\tt.Fatalf(\"verdict carries a binding for proven absence: %+v\", verdict)\n97|\t}\n98|}\n99|\n100|func TestRecoverCreateIdentifiesOneChild(t *testing.T) {\n101|\tt.Parallel()\n102|\tfor _, state := range []terminalbackend.InstanceState{terminalbackend.StateActive, terminalbackend.StateParked} {\n103|\t\tt.Run(string(state), func(t *testing.T) {\n104|\t\t\tt.Parallel()\n105|\t\t\tstore, err := axpane.Open(t.TempDir())\n106|\t\t\tif err != nil {\n107|\t\t\t\tt.Fatal(err)\n108|\t\t\t}\n109|\t\t\tbound := bindPair(t, store, fixtureSession, fixtureBootstrap, fixtureInstance)\n110|\t\t\tverdict, err := recoverWith(t, store, func(terminstance.StatusBody) (terminstance.StatusObservation, error) {\n111|\t\t\t\treturn exactObservation(state, true), nil\n112|\t\t\t}, recoveryRequest(fixtureBootstrap, true))\n113|\t\t\tif err != nil {\n114|\t\t\t\tt.Fatalf(\"RecoverCreate() error = %v\", err)\n115|\t\t\t}\n116|\t\t\tif verdict.Outcome != RecoveryChild || !verdict.HasBinding {\n117|\t\t\t\tt.Fatalf(\"verdict = %+v, want the one child\", verdict)\n118|\t\t\t}\n119|\t\t\tif verdict.Binding != bound {\n120|\t\t\t\tt.Fatalf(\"verdict binding = %+v, want %+v\", verdict.Binding, bound)\n121|\t\t\t}\n122|\t\t\tif verdict.State != state || verdict.Retry != terminstance.DispositionReplaySame {\n123|\t\t\t\tt.Fatalf(\"verdict = %+v, want state %q with replay_same\", verdict, string(state))\n124|\t\t\t}\n125|\t\t})\n126|\t}\n127|}\n128|\n129|func TestRecoverCreateDuplicateRetrySameVerdict(t *testing.T) {\n130|\tt.Parallel()\n131|\tstore, err := axpane.Open(t.TempDir())\n132|\tif err != nil {\n133|\t\tt.Fatal(err)\n134|\t}\n135|\tbindPair(t, store, fixtureSession, fixtureBootstrap, fixtureInstance)\n136|\tobserve := func(terminstance.StatusBody) (terminstance.StatusObservation, error) {\n137|\t\treturn exactObservation(terminalbackend.StateActive, true), nil\n138|\t}\n139|\tfirst, err := recoverWith(t, store, observe, recoveryRequest(fixtureBootstrap, true))\n140|\tif err != nil {\n141|\t\tt.Fatal(err)\n142|\t}\n143|\tsecond, err := recoverWith(t, store, observe, recoveryRequest(fixtureBootstrap, true))\n144|\tif err != nil {\n145|\t\tt.Fatal(err)\n146|\t}\n147|\tif first != second {\n148|\t\tt.Fatalf(\"retry verdict = %+v, want %+v\", second, first)\n149|\t}\n150|}\n151|\n152|func TestR