T) {\n109|\tt.Parallel()\n110|\tt.Run(\"unknown transport\", func(t *testing.T) {\n111|\t\tt.Parallel()\n112|\t\tstore := openAttachStore(t)\n113|\t\t_, _, err := store.Attach(fixtureSession, fixtureInstance, fixtureClient, \"smoke_signal\", true, validAttachAuth(t, \"local_only\", true), fixtureNow())\n114|\t\trequireCode(t, err, \"terminal_backend_protocol_error\")\n115|\t\trequireDetail(t, err, \"attach transport\")\n116|\t})\n117|\tt.Run(\"relay refused by policy\", func(t *testing.T) {\n118|\t\tt.Parallel()\n119|\t\tstore := openAttachStore(t)\n120|\t\t_, _, err := store.Attach(fixtureSession, fixtureInstance, fixtureClient, \"third_party_relay\", true, validAttachAuth(t, \"third_party_relay\", true), fixtureNow())\n121|\t\trequireCode(t, err, \"terminal_backend_unauthorized\")\n122|\t})\n123|}\n124|\n125|func TestAttachRequiresLiveAuth(t *testing.T) {\n126|\tt.Parallel()\n127|\tt.Run(\"expired auth\", func(t *testing.T) {\n128|\t\tt.Parallel()\n129|\t\tstore := openAttachStore(t)\n130|\t\texpired := attachAuth(t, \"local_only\", true, \"2026-08-19T02:00:00.000Z\", \"2026-08-19T03:00:00.000Z\")\n131|\t\t_, _, err := store.Attach(fixtureSession, fixtureInstance, fixtureClient, \"local_only\", true, expired, fixtureNow())\n132|\t\trequireCode(t, err, \"terminal_backend_unauthorized\")\n133|\t})\n134|\tt.Run(\"replay with expired auth\", func(t *testing.T) {\n135|\t\tt.Parallel()\n136|\t\tstore := openAttachStore(t)\n137|\t\tattachClient(t, store, fixtureClient)\n138|\t\texpired := attachAuth(t, \"local_only\", true, \"2026-08-19T02:00:00.000Z\", \"2026-08-19T03:00:00.000Z\")\n139|\t\t_, _, err := store.Attach(fixtureSession, fixtureInstance, fixtureClient, \"local_only\", true, expired, fixtureNow())\n140|\t\trequireCode(t, err, \"terminal_backend_unauthorized\")\n141|\t})\n142|\tt.Run(\"auth bound to another transport\", func(t *testing.T) {\n143|\t\tt.Parallel()\n144|\t\tstore := openAttachStore(t)\n145|\t\t_, _, err := store.Attach(fixtureSession, fixtureInstance, fixtureClient, \"local_only\", true, validAttachAuth(t, \"trusted_private_mesh\", true), fixtureNow())\n146|\t\trequireCode(t, err, \"terminal_backend_unauthorized\")\n147|\t})\n148|\tt.Run(\"malformed auth\", func(t *testing.T) {\n149|\t\tt.Parallel()\n150|\t\tstore := openAttachStore(t)\n151|\t\tif _, _, err := store.Attach(fixtureSession, fixtureInstance, fixtureClient, \"local_only\", true, []byte(`{\"transport\":\"local_only\"}`), fixtureNow()); err == nil {\n152|\t\t\tt.Fatal(\"Attach(malformed auth) succeeded, want refusal\")\n153|\t\t}\n154|\t})\n155|}\n156|\n157|func TestAttachEmitsNeitherEventNorStateChange(t *testing.T) {\n158|\tt.Parallel()\n159|\trepository, _ := chainFixture(t)\n160|\tsnapshot := func() string {\n161|\t\tt.Helper()\n162|\t\tevents, err := repository.ListEvents(fixtureSession)\n163|\t\tif err != nil {\n164|\t\t\tt.Fatal(err)\n(more lines below)","final_result":true}}}
