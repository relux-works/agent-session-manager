{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8ab","stream":{"kind":"session","id":"01a0b3be-22c5-72c2-9a68-fcdf0b06f553"},"sequence":688,"recorded_at":1780531400001371,"record_type":"event","durability":"durable","causation_id":"4c090c0f-8ac7-469e-b4bd-d568cdc91e07","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"4c090c0f-8ac7-469e-b4bd-d568cdc91e07","run_stream":{"kind":"run","id":"4c090c0f-8ac7-469e-b4bd-d568cdc91e07"},"task_stream":{"kind":"task","id":"01a0b3c0-9422-77c3-94a5-96a10e1c8403"},"task_id":"01a0b3c0-9422-77c3-94a5-96a10e1c8403","event":{"kind":"output","task_id":"01a0b3c0-9422-77c3-94a5-96a10e1c8403","chunk":"Read text file `internal/termbind/skew_test.go`.\n(149 line(s) above)\n150|\t\t},\n151|\t}\n152|}\n153|\n154|func TestVersionSelectionBothDirections(t *testing.T) {\n155|\tt.Parallel()\n156|\trepository, recordID := chainFixture(t)\n157|\trecordJSON, err := repository.GetRecord(fixtureSession)\n158|\tif err != nil {\n159|\t\tt.Fatal(err)\n160|\t}\n161|\trecord, err := sessstate.DecodeRecord(recordJSON)\n162|\tif err != nil {\n163|\t\tt.Fatal(err)\n164|\t}\n165|\t_ = recordID\n166|\tcreated := createdEvent(record.RecordID)\n167|\tt.Run(\"v1 derives the v1 surface\", func(t *testing.T) {\n168|\t\tt.Parallel()\n169|\t\tv1 := sessstate.Event{\n170|\t\t\tID: \"sha256:2222222222222222222222222222222222222222222222222222222222222222\", Type: \"terminal.created\",\n171|\t\t\tSchemaVersion: \"1.0.0\", SessionID: fixtureSession, CreatedByHostID: fixtureLocalHost,\n172|\t\t\tLeaseEpoch: 1, LeaseID: fixtureLeaseA, Sequence: 2, Predecessors: []string{created.ID},\n173|\t\t\tPayload: map[string]any{\"backend\": \"tmux\", \"terminal_id\": \"tmux-session-1\"},\n174|\t\t}\n175|\t\tprojection, err := foldEvents(record, []sessstate.Event{created, v1})\n176|\t\tif err != nil {\n177|\t\t\tt.Fatalf(\"Reduce(v1) error = %v\", err)\n178|\t\t}\n179|\t\tif !projection.HasTerminal || projection.Terminal.TerminalID != \"tmux-session-1\" {\n180|\t\t\tt.Fatalf(\"v1 terminal = %+v, want the v1 handle\", projection.Terminal)\n181|\t\t}\n182|\t\tif projection.Terminal.BindingID != \"\" {\n183|\t\t\tt.Fatalf(\"v1 binding = %q, want empty\", projection.Terminal.BindingID)\n184|\t\t}\n185|\t})\n186|\tt.Run(\"v4 derives the v4 surface\", func(t *testing.T) {\n187|\t\tt.Parallel()\n188|\t\tv4 := sessstate.Event{\n189|\t\t\tID: \"sha256:3333333333333333333333333333333333333333333333333333333333333333\", Type: \"terminal.created\",\n190|\t\t\tSchemaVersion: \"4.0.0\", SessionID: fixtureSession, CreatedByHostID: fixtureLocalHost,\n191|\t\t\tLeaseEpoch: 1, LeaseID: fixtureLeaseA, Sequence: 2, Predecessors: []string{created.ID},\n192|\t\t\tPayload: map[string]any{\n193|\t\t\t\t\"terminal_binding_id\": seedDigest(0xB1), \"terminal_backend_id\": terminalbackend.BuiltinTmux,\n194|\t\t\t\t\"implementation_version\": fixtureImpl, \"protocol_version\": fixtureProto,\n195|\t\t\t\t\"evidence_ids\": []any{seedDigest(0xE0)},\n196|\t\t\t},\n197|\t\t}\n198|\t\tprojection, err := foldEvents(record, []sessstate.Event{created, v4})\n199|\t\tif err != nil {\n200|\t\t\tt.Fatalf(\"Reduce(v4) error = %v\", err)\n201|\t\t}\n202|\t\tif !projection.HasTerminal || projection.Terminal.BindingID != seedDigest(0xB1) {\n203|\t\t\tt.Fatalf(\"v4 terminal = %+v, want the binding digest\", projection.Terminal)\n204|\t\t}\n205|\t\tif projection.Terminal.TerminalID != \"\" {\n206|\t\t\tt.Fatalf(\"v4 terminal id = %q, want empty\", projection.Terminal.TerminalID)\n207|\t\t}\n208|\t})\n209|\tt.Run(\"v4 resumed records binding and newest\", func(t *testing.T) {\n210|\t\tt.Parallel()\n211|\t\tresumed := sessstate.Event{\n212|\t\t\tID: \"sha256:4444444444444444444444444444444444444444444444444444444444444444\", Type: \"session.resumed\",\n213|\t\t\tSchemaVersion: \"4.0.0\", SessionID: fixtureSession, CreatedByHostID: fixtureLocalHost,\n214|\t\t\tLeaseEpoch: 1, LeaseID: fixtureLeaseA, Sequence: 2, Predecessors: []string{created.ID},\n215|\t\t\tPayload: map[string]any{\n216|\t\t\t\t\"checkpoint_id\": seedDigest(0xC9), \"execution_profile\": \"standard\", \"profile_source_event_id\": nil,\n217|\t\t\t\t\"terminal_binding_id\": seedDigest(0xB1), \"terminal_backend_id\": terminalbackend.BuiltinTmux,\n218|\t\t\t\t\"implementation_version\": fixtureImpl, \"protocol_version\": fixtureProto,\n219|\t\t\t\t\"evidence_ids\": []any{seedDigest(0xE0)},\n220|\t\t\t},\n221|\t\t}\n222|\t\tprojection, err := foldEvents(record, []sessstate.Event{created, resumed})\n223|\t\tif err != nil {\n224|\t\t\tt.Fatalf(\"Reduce(resumed v4) error = %v\", err)\n225|\t\t}\n226|\t\tif projection.Terminal.BindingID != seedDigest(0xB1) {\n227|\t\t\tt.Fatalf(\"resumed terminal = %+v, want the binding digest\", projection.Terminal)\n228|\t\t}\n229|\t\tif !projection.HasCheckpoint || projection.Newest.ID != seedDigest(0xC9) {\n230|\t\t\tt.Fatalf(\"resumed newest = %+v, want the resumed checkpoint\", projection.Newest)\n231|\t\t}\n232|\t})\n233|}\n234|\n235|func TestV4RetainedAsImmutableHistory(t *testing.T) {\n236|\tt.Parallel()\n237|\trepository, _ := chainFixture(t)\n238|\tworld := buildTmuxUniverse(t)\n239|\treference, raw, _, err := EmitTerminalCreated(repository, emitParams(t, repository), emitFacts(world), emitAdmission(t, world))\n240|\tif err != nil {\n241|\t\tt.Fatal(err)\n242|\t}\n243|\tstored, err := repository.GetEvent(fixtureSession, reference.EventID)\n244|\tif err != nil {\n245|\t\tt.Fatal(err)\n246|\t}\n247|\tif string(stored) != string(raw) {\n248|\t\tt.Fatal(\"retained bytes differ from the emitted bytes\")\n249|\t}\n250|\tevents := mustListEvents(t, repository)\n251|\tversions := map[string]string{}\n252|\tfor _, summary := range events {\n253|\t\teventRaw, err := repository.GetEvent(fixtureSession, summary.EventID)\n254|\t\tif err != nil {\n255|\t\t\tt.Fatal(err)\n256|\t\t}\n257|\t\tvar decoded struct {\n258|\t\t\tSchemaVersion string `json:\"schema_version\"`\n259|\t\t\tEventType     string `json:\"event_type\"`\n260|\t\t}\n261|\t\tif err := json.Unmarshal(eventRaw, &decoded); err != nil {\n262|\t\t\tt.Fatal(err)\n263|\t\t}\n264|\t\tversions[decoded.EventType] = decoded.SchemaVersion\n265|\t}\n266|\tif len(events) != 2 || versions[\"session.created\"] != \"1.0.0\" || versions[\"terminal.created\"] != \"4.0.0\" {\n267|\t\tt.Fatalf(\"chain versions = %v, want exactly the appended events (no lower-version replacement)\", versions)\n268|\t}\n269|\treader := &sessquery.Reader{Local: repository}\n270|\tsummaries, err := reader.List()\n271|\tif err != nil {\n272|\t\tt.Fatalf(\"Reader.List() error = %v\", err)\n273|\t}\n274|\tif len(summaries) != 1 {\n275|\t\tt.Fatalf(\"Reader.List() rows = %d, want 1\", len(summaries))\n276|\t}\n277|\tif !summaries[0].Projection.HasTerminal || summaries[0].Projection.Terminal.BindingID != seedDigest(0xB1) {\n278|\t\tt.Fatalf(\"query terminal = %+v, want the v4 binding digest\", summaries[0].Projection.Terminal)\n279|\t}\n280|\tif after := mustListEvents(t, repository); len(after) != 2 {\n281|\t\tt.Fatalf(\"chain holds %d events after the query read, want 2 (reads write nothing)\", len(after))\n282|\t}\n283|}\n284|\n285|func TestV1ReaderSeesV4AsInert(t *testing.T) {\n286|\tt.Parallel()\n287|\trepository, _ := chainFixture(t)\n288|\tworld := buildTmuxUniverse(t)\n289|\treference, _, _, err := EmitTerminalCreated(repository, emitParams(t, repository), emitFacts(world), emitAdmission(t, world))\n(more lines below)","final_result":true}}}
