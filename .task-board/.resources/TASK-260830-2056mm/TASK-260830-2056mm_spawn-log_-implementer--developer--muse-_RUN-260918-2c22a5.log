D] = []byte(target.bytes)\n142|\t\t\tids := []string{world.manifestID, world.probeID, hostileID}\n143|\t\t\tsort.Strings(ids)\n144|\t\t\t_, err := ResolveEvidence(ids, tmuxTuple(), world.registry, universe, world.rawGeneration, world.now, world.verify)\n145|\t\t\trequireCode(t, err, \"terminal_backend_manifest_probe_mismatch\")\n146|\t\t\trequireDetail(t, err, \"evidence kind\")\n147|\t\t})\n148|\t}\n149|}\n150|\n151|func TestResolveEvidenceRequiresManifestAndProbe(t *testing.T) {\n152|\tt.Parallel()\n153|\tworld := buildTmuxUniverse(t)\n154|\tuniverse := universeMap(t, world)\n155|\tt.Run(\"missing manifest\", func(t *testing.T) {\n156|\t\tt.Parallel()\n157|\t\tids := []string{world.probeID, world.evidenceID}\n158|\t\tsort.Strings(ids)\n159|\t\t_, err := ResolveEvidence(ids, tmuxTuple(), world.registry, universe, world.rawGeneration, world.now, world.verify)\n160|\t\trequireCode(t, err, \"terminal_backend_manifest_probe_mismatch\")\n161|\t})\n162|\tt.Run(\"missing probe\", func(t *testing.T) {\n163|\t\tt.Parallel()\n164|\t\tids := []string{world.manifestID, world.evidenceID}\n165|\t\tsort.Strings(ids)\n166|\t\t_, err := ResolveEvidence(ids, tmuxTuple(), world.registry, universe, world.rawGeneration, world.now, world.verify)\n167|\t\trequireCode(t, err, \"terminal_backend_manifest_probe_mismatch\")\n168|\t})\n169|\tt.Run(\"second manifest\", func(t *testing.T) {\n170|\t\tt.Parallel()\n171|\t\textraID := seedDigest(0xE9)\n172|\t\tuniverse[extraID] = mustJSON(t, world.manifest)\n173|\t\tids := []string{world.manifestID, world.probeID, world.evidenceID, extraID}\n174|\t\tsort.Strings(ids)\n175|\t\t_, err := ResolveEvidence(ids, tmuxTuple(), world.registry, universe, world.rawGeneration, world.now, world.verify)\n176|\t\trequireCode(t, err, \"terminal_backend_manifest_probe_mismatch\")\n177|\t})\n178|\tt.Run(\"second probe\", func(t *testing.T) {\n179|\t\tt.Parallel()\n180|\t\textraID := seedDigest(0xE8)\n181|\t\tuniverse[extraID] = mustJSON(t, world.probe)\n182|\t\tids := []string{world.manifestID, world.probeID, world.evidenceID, extraID}\n183|\t\tsort.Strings(ids)\n184|\t\t_, err := ResolveEvidence(ids, tmuxTuple(), world.registry, universe, world.rawGeneration, world.now, world.verify)\n185|\t\trequireCode(t, err, \"terminal_backend_manifest_probe_mismatch\")\n186|\t})\n187|}\n188|\n189|func TestResolveEvidenceBindsEventTuple(t *testing.T) {\n190|\tt.Parallel()\n191|\tt.Run(\"foreign backend evidence\", func(t *testing.T) {\n192|\t\tt.Parallel()\n193|\t\ttmux := buildTmuxUniverse(t)\n194|\t\tconpty := buildConptyUniverse(t)\n195|\t\tuniverse := universeMap(t, tmux)\n196|\t\tuniverse[conpty.evidenceID] = mustJSON(t, conpty.evidence)\n197|\t\tids := []string{tmux.manifestID, tmux.probeID, conpty.evidenceID}\n198|\t\tsort.Strings(ids)\n199|\t\t_, err := ResolveEvidence(ids, tmuxTuple(), tmux.registry, universe, tmux.rawGeneration, tmux.now, tmux.verify)\n200|\t\trequireCode(t, err, \"terminal_backend_manifest_probe_mismatch\")\n201|\t\trequireDetail(t, err, \"evidence binding\")\n202|\t})\n203|\tt.Run(\"protocol drift evidence\", func(t *testing.T) {\n204|\t\tt.Parallel()\n205|\t\tworld := buildTmuxUniverse(t)\n206|\t\tdrifted := cloneDoc(world.evidence)\n207|\t\tdrifted[\"protocol_version\"] = \"1.0.0\"\n208|\t\tdrifted[\"evidence_id\"] = omitSelfIdentity(t, drifted, \"evidence_id\")\n209|\t\tdriftedID := drifted[\"evidence_id\"].(string)\n210|\t\tuniverse := universeMap(t, world)\n211|\t\tuniverse[driftedID] = mustJSON(t, drifted)\n212|\t\tids := []string{world.manifestID, world.probeID, driftedID}\n213|\t\tsort.Strings(ids)\n214|\t\t_, err := ResolveEvidence(ids, tmuxTuple(), world.registry, universe, world.rawGeneration, world.now, world.verify)\n215|\t\trequireCode(t, err, \"terminal_backend_manifest_probe_mismatch\")\n216|\t\trequireDetail(t, err, \"evidence binding\")\n217|\t})\n218|}\n219|\n220|func TestResolveEvidenceRejectsSubstitution(t *testing.T) {\n221|\tt.Parallel()\n222|\tt.Run(\"evidence alias\", func(t *testing.T) {\n223|\t\tt.Parallel()\n224|\t\tworld := buildTmuxUniverse(t)\n225|\t\t// The universe returns the valid evidence bytes for an ID that is\n226|\t\t// not the embedded evidence ID: the substitution fails closed\n227|\t\t// instead of admitting document X under name Y.\n228|\t\talias := seedDigest(0xA7)\n229|\t\tuniverse := universeMap(t, world)\n230|\t\tuniverse[alias] = mustJSON(t, world.evidence)\n231|\t\tids := []string{world.manifestID, world.probeID, alias}\n232|\t\tsort.Strings(ids)\n233|\t\t_, err := ResolveEvidence(ids, tmuxTuple(), world.registry, universe, world.rawGeneration, world.now, world.verify)\n234|\t\trequireCode(t, err, \"terminal_backend_manifest_probe_mismatch\")\n235|\t})\n236|\tt.Run(\"probe alias\", func(t *testing.T) {\n237|\t\tt.Parallel()\n238|\t\tworld := buildTmuxUniverse(t)\n239|\t\talias := seedDigest(0xA6)\n(more lines below)","final_result":true}}}
