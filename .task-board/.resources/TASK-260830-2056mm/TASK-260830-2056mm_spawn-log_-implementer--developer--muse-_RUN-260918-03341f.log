:\\t\\t// Bytewise >= refuses duplicates and misordering together: equal\\ninternal/terminalbackend/manifest.go:1783:// duplicate-free, so the index cannot collide.\\ninternal/terminalbackend/manifest.go:1831:// probe list is validated duplicate-free, so presence is unambiguous.\\ninternal/terminalbackend/manifest.go:1862:\\t\\tif previous, duplicate := seen[object.EvidenceID]; duplicate {\\ninternal/terminalbackend/terminalbackend.go:3:// executable trust admission, and duplicate or drift refusal.\\ninternal/terminalbackend/terminalbackend.go:38:\\t// CodeAmbiguous reports a duplicate or ambiguous backend ID. Re-registering\\ninternal/terminalbackend/terminalbackend.go:189:// validated record. It duplicates the ParseID rule so a Registry can never\\ninternal/terminalbackend/terminalbackend.go:331:// duplicates only the header, so every ingress and egress point must clone.\\ninternal/terminalbackend/terminalbackend.go:343:// handle on admitted registry state and can convert drift into a duplicate.\\ninternal/terminalbackend/terminalbackend.go:511:\\t\\treturn refuse(&Error{Code: CodeAmbiguous, BackendID: observed.ID, Detail: \\\"duplicate backend_id\\\"})\\n=== parse entry ===\\n975:func ParseManifest(raw []byte) (Manifest, error) {\\n\\t\\treturn Manifest{}, err\\n\\t}\\n\\tkindName, err := stringMember(object, \\\"implementation_kind\\\")\\n\\tif err != nil {\\n\\t\\treturn Manifest{}, err\\n\\t}\\n\\tkind, err := parseKind(kindName)\\n\\tif err != nil {\\n\\t\\treturn Manifest{}, mismatchf(\\\"manifest implementation kind\\\")\\n\\t}\\n\\tdigest, err := digestOrNullMember(object, \\\"executable_digest\\\")\\n\\tif err != nil {\\n\\t\\treturn Manifest{}, err\\n\\t}\\n\\tif needsDigest(kind) == (digest == \\\"\\\") {\\n\\t\\treturn Manifest{}, mismatchf(\\\"manifest executable digest\\\")\\n\\t}\\n\\tclaimsRaw, known := object[\\\"static_capability_claims\\\"]\\n\\tif !known {\\n\\t\\treturn Manifest{}, mismatchf(\\\"document members\\\")\\n\\t}\\n\\tclaims, err :=