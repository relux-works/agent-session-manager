{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6bf","stream":{"kind":"session","id":"01a0b3fc-2962-7bc0-91c2-787ae4899fa1"},"sequence":442,"recorded_at":1780531400000879,"record_type":"event","durability":"durable","causation_id":"6cf4561a-8326-47da-a916-4850b6a43e2a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6cf4561a-8326-47da-a916-4850b6a43e2a","run_stream":{"kind":"run","id":"6cf4561a-8326-47da-a916-4850b6a43e2a"},"task_stream":{"kind":"task","id":"01a0b3fd-51f0-77a2-a9bb-4619297c93e9"},"task_id":"01a0b3fd-51f0-77a2-a9bb-4619297c93e9","event":{"kind":"output","task_id":"01a0b3fd-51f0-77a2-a9bb-4619297c93e9","chunk":"Read text file `internal/termbind/identity.go`.\n1|package termbind\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"crypto/sha256\"\n6|\t\"encoding/hex\"\n7|\t\"encoding/json\"\n8|\n9|\t\"github.com/gowebpki/jcs\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n15|)\n16|\n17|// BindingSchema is the Terminal Instance Binding 1.0.0 schema URN from\n18|// Section 4.B.\n19|const BindingSchema = \"urn:ax:schema:terminal-instance-binding\"\n20|\n21|// BindingSchemaVersion is the only admitted binding schema version.\n22|const BindingSchemaVersion = \"1.0.0\"\n23|\n24|// CheckInstanceIdentity admits exactly the AX-allocated terminal instance\n25|// identity: a UUIDv7. A PID, handle, socket, path, named pipe, URL, token,\n26|// mutable endpoint, or native reference cannot spell a 36-character\n27|// hyphenated UUIDv7, so grammar admission is identity-shape admission (the\n28|// landed descriptor rationale, applied here as the story-level gate). Any\n29|// other value refuses terminal_backend_protocol_error: AX-local parsing of\n30|// a syntactically invalid identity, per the Section 4.C row note.\n31|func CheckInstanceIdentity(value string) error {\n32|\tif _, err := scalar.ParseUUIDv7(value); err != nil {\n33|\t\treturn &terminalbackend.Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminal instance identity\"}\n34|\t}\n35|\treturn nil\n36|}\n37|\n38|// Binding is the parsed Terminal Instance Binding 1.0.0 closed object: the\n39|// host-local durable metadata Section 4.B defines. It is never replicated;\n40|// replicated Session Events carry only its digest as an opaque audit\n41|// reference.\n42|type Binding struct {\n43|\tBindingID             string\n44|\tSessionID             string\n45|\tHostID                string\n46|\tHostIncarnationID     string\n47|\tTerminalInstanceID    string\n48|\tTerminalBackendID     string\n49|\tImplementationVersion string\n50|\tProtocolVersion       string\n51|\tBackendGeneration     string\n52|\tNativeReference       string\n53|\tCreatedAt             string\n54|\tSupersedesBindingID   string\n55|\tHasSupersedes         bool\n56|}\n57|\n58|// bindingMembers is the exact closed member set of the binding document,\n59|// in the order Section 4.B lists it.\n60|var bindingMembers = []string{\n61|\t\"schema\",\n62|\t\"schema_version\",\n63|\t\"binding_id\",\n64|\t\"session_id\",\n65|\t\"host_id\",\n66|\t\"host_incarnation_id\",\n67|\t\"terminal_instance_id\",\n68|\t\"terminal_backend_id\",\n69|\t\"implementation_version\",\n70|\t\"protocol_version\",\n71|\t\"backend_generation\",\n72|\t\"native_reference\",\n73|\t\"created_at\",\n74|\t\"supersedes_binding_id\",\n75|\t\"extensions\",\n76|}\n77|\n78|// ParseTerminalBinding admits one closed Terminal Instance Binding 1.0.0\n79|// document. No parser exists on trunk for this schema, so this entry owns\n80|// it; every grammar delegates to its landed owner (frame to environ,\n81|// UUIDv7/digest/timestamp to scalar, backend ID to terminalbackend,\n82|// semver to environ). The terminal_instance_id member passes through the\n83|// coded identity gate: a forbidden identity form refuses\n84|// terminal_backend_protocol_error. The binding_id member is recomputed by\n85|// the Section 4.B identity rule (digest of the RFC 8785 JCS bytes with the\n86|// ID member omitted) and must equal the carried value; a reader recompute\n87|// mismatch refuses terminal_backend_manifest_probe_mismatch. Member-type\n88|// faults refuse the same protocol class as the landed descriptor parser:\n89|// a mistyped binding member is a malformed local document.\n90|func ParseTerminalBinding(raw []byte) (Binding, error) {\n91|\tempty := Binding{}\n92|\tmembers, fault := environ.DecodeStrictObject(raw)\n93|\tif fault != nil {\n94|\t\treturn empty, protocolRefusal(\"binding frame\")\n95|\t}\n96|\tif len(members) != len(bindingMembers) {\n97|\t\treturn empty, protocolRefusal(\"binding member set\")\n98|\t}\n99|\tfor _, name := range bindingMembers {\n100|\t\tif _, known := members[name]; !known {\n101|\t\t\treturn empty, protocolRefusal(\"binding member set\")\n102|\t\t}\n103|\t}\n104|\tvar parsed Binding\n105|\ttext := func(name string) (string, error) {\n106|\t\tvar value string\n107|\t\tdecoder := json.NewDecoder(bytes.NewReader(members[name]))\n108|\t\tif err := decoder.Decode(&value); err != nil {\n109|\t\t\treturn \"\", protocolRefusal(\"binding \" + name)\n110|\t\t}\n111|\t\tif decoder.More() {\n112|\t\t\treturn \"\", protocolRefusal(\"binding \" + name)\n113|\t\t}\n114|\t\treturn value, nil\n115|\t}\n116|\tschema, err := text(\"schema\")\n117|\tif err != nil {\n118|\t\treturn empty, err\n119|\t}\n120|\tif schema != BindingSchema {\n121|\t\treturn empty, protocolRefusal(\"binding schema\")\n122|\t}\n123|\tversion, err := text(\"schema_version\")\n124|\tif err != nil {\n125|\t\treturn empty, err\n126|\t}\n127|\tif version != BindingSchemaVersion {\n128|\t\treturn empty, protocolRefusal(\"binding schema version\")\n129|\t}\n130|\tbindingID, err := text(\"binding_id\")\n131|\tif err != nil {\n132|\t\treturn empty, err\n133|\t}\n134|\tif _, err := scalar.ParseDigest(bindingID); err != nil {\n135|\t\treturn empty, protocolRefusal(\"binding digest\")\n136|\t}\n137|\tparsed.BindingID = bindingID\n138|\tfor _, name := range []string{\"session_id\", \"host_id\", \"host_incarnation_id\"} {\n139|\t\tvalue, err := text(name)\n140|\t\tif err != nil {\n141|\t\t\treturn empty, err\n142|\t\t}\n143|\t\tif _, err := scalar.ParseUUIDv7(value); err != nil {\n144|\t\t\treturn empty, protocolRefusal(\"binding \" + name)\n145|\t\t}\n146|\t\tswitch name {\n147|\t\tcase \"session_id\":\n148|\t\t\tparsed.SessionID = value\n149|\t\tcase \"host_id\":\n150|\t\t\tparsed.HostID = value\n151|\t\tcase \"host_incarnation_id\":\n152|\t\t\tparsed.HostIncarnationID = value\n153|\t\t}\n154|\t}\n155|\tinstance, err := text(\"terminal_instance_id\")\n156|\tif err != nil {\n157|\t\treturn empty, err\n158|\t}\n159|\tif err := CheckInstanceIdentity(instance); err != nil {\n160|\t\treturn empty, err\n161|\t}\n162|\tparsed.TerminalInstanceID = instance\n163|\tbackendID, err := text(\"terminal_backend_id\")\n164|\tif err != nil {\n165|\t\treturn empty, err\n166|\t}\n167|\tif _, err := terminalbackend.ParseID(backendID); err != nil {\n168|\t\treturn empty, err\n169|\t}\n170|\tparsed.TerminalBackendID = backendID\n171|\timplementation, err := text(\"implementation_version\")\n172|\tif err != nil {\n173|\t\treturn empty, err\n174|\t}\n175|\tif !environ.CheckSemver(implementation) {\n176|\t\treturn empty, protocolRefusal(\"binding implementation version\")\n177|\t}\n178|\tparsed.ImplementationVersion = implementation\n179|\tprotocol, err := text(\"protocol_version\")\n180|\tif err != nil {\n181|\t\treturn empty, err\n182|\t}\n183|\tif !environ.CheckSemver(protocol) {\n184|\t\treturn empty, protocolRefusal(\"binding protocol version\")\n185|\t}\n186|\tparsed.ProtocolVersion = protocol\n187|\tgeneration, err := text(\"backend_generation\")\n188|\tif err != nil {\n189|\t\treturn empty, err\n190|\t}\n191|\tif _, err := terminalbackend.GenerationDigest(generation); err != nil {\n192|\t\treturn empty, err\n193|\t}\n194|\tparsed.BackendGeneration = generation\n195|\tnative, err := text(\"native_reference\")\n196|\tif err != nil {\n197|\t\treturn empty, err\n198|\t}\n199|\tif _, ok := environ.CheckStringBounds(members[\"native_reference\"], 1, 512); !ok {\n200|\t\treturn empty, protocolRefusal(\"binding native reference\")\n201|\t}\n202|\tparsed.NativeReference = native\n203|\tcreated, err := text(\"created_at\")\n204|\tif err != nil {\n205|\t\treturn empty, err\n206|\t}\n207|\tif _, err := scalar.ParseTimestamp(created); err != nil {\n208|\t\treturn empty, protocolRefusal(\"binding timestamp\")\n209|\t}\n210|\tparsed.CreatedAt = created\n211|\tif !isExplicitNull(members[\"supersedes_binding_id\"]) {\n212|\t\tsupersedes, err := text(\"supersedes_binding_id\")\n213|\t\tif err != nil {\n214|\t\t\treturn empty, err\n215|\t\t}\n216|\t\tif _, err := scalar.ParseDigest(supersedes); err != nil {\n217|\t\t\treturn empty, protocolRefusal(\"binding supersedes\")\n218|\t\t}\n219|\t\tparsed.SupersedesBindingID = supersedes\n220|\t\tparsed.HasSupersedes = true\n221|\t}\n222|\tif !environ.CheckExtensions(members[\"extensions\"]) {\n223|\t\treturn empty, protocolRefusal(\"binding extensions\")\n224|\t}\n225|\trecomputed, err := bindingIdentity(raw, \"binding_id\")\n226|\tif err != nil {\n227|\t\treturn empty, err\n228|\t}\n229|\tif recomputed != bindingID {\n230|\t\treturn empty, &terminalbackend.Error{Code: terminalbackend.CodeMismatch, Detail: \"binding identity\"}\n231|\t}\n232|\treturn parsed, nil\n233|}\n234|\n235|// protocolRefusal builds the AX-local document refusal: the Section 4.C\n236|// protocol class for a malformed local parse.\n237|func protocolRefusal(detail string) error {\n238|\treturn &terminalbackend.Error{Code: terminalbackend.CodeProtocolError, Detail: detail}\n239|}\n240|\n241|// isExplicitNull reports whether raw is the explicit JSON null.\n242|func isExplicitNull(raw json.RawMessage) bool {\n243|\treturn string(bytes.TrimSpace(raw)) == \"null\"\n244|}\n245|\n246|// bindingIdentity computes the Section 4.B identity of one binding\n247|// document: the lowercase sha256 digest of the RFC 8785 JCS bytes with the\n248|// binding_id member omitted. canonicaljson explicitly rejects this schema\n249|// and terminalbackend.objectIdentity is schema-generic but unexported, so\n250|// this is the schema's own instance of the rule, built on the same JCS\n251|// library both owners use; TestBindingIdentityAgreesWithLandedAdmission\n252|// proves the construction agrees with the landed manifest admission on a\n253|// manifest-shaped object. Every member is type-checked before this runs,\n254|// so no JSON number can reach the digest bytes (the NUM-UNSAFE-NUMBER\n255|// rule holds by check ordering, not by a second walk).\n256|func bindingIdentity(raw []byte, selfField string) (string, error) {\n257|\tvar object map[string]any\n258|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n259|\tif err := decoder.Decode(&object); err != nil {\n260|\t\treturn \"\", protocolRefusal(\"binding identity\")\n261|\t}\n262|\tomitted := make(map[string]any, len(object))\n263|\tfor name, member := range object {\n264|\t\tif name != selfField {\n265|\t\t\tomitted[name] = member\n266|\t\t}\n267|\t}\n268|\tserialized, err := json.Marshal(omitted)\n269|\tif err != nil {\n270|\t\treturn \"\", protocolRefusal(\"binding identity\")\n271|\t}\n272|\tcanonical, err := jcs.Transform(serialized)\n273|\tif err != nil {\n274|\t\treturn \"\", protocolRefusal(\"binding identity\")\n275|\t}\n276|\tsum := sha256.Sum256(canonical)\n277|\treturn \"sha256:\" + hex.EncodeToString(sum[:]), nil\n278|}\n279|\n280|// AdmitMutationContext gates the terminal_instance_id member of one\n281|// Section 4.C mutation context document through the coded identity gate,\n282|// then admits the document through the landed terminstance parser. The\n283|// pre-scan only fires on a present string member; any other shape\n284|// delegates untouched, so the landed parser remains the shape authority\n285|// and only the identity class is added.\n286|func AdmitMutationContext(raw []byte) (terminstance.MutationContext, error) {\n287|\tif err := prescanIdentity(raw, \"terminal_instance_id\"); err != nil {\n288|\t\treturn terminstance.MutationContext{}, err\n289|\t}\n290|\treturn terminstance.ParseMutationContext(raw)\n291|}\n292|\n293|// AdmitStatusBody gates the terminal_instance_id member of one Section 4.C\n294|// status body through the coded identity gate when the member is a present\n295|// non-null string, then admits the body through the landed terminstance\n296|// parser. A null instance (the session-scoped lookup) skips the gate; any\n297|// non-string shape delegates untouched to the landed shape authority.\n298|func AdmitStatusBody(raw []byte) (terminstance.StatusBody, error) {\n299|\tmembers, fault := environ.DecodeStrictObject(raw)\n300|\tif fault != nil {\n301|\t\treturn terminstance.ParseStatusBody(raw)\n302|\t}\n303|\tencoded, known := members[\"terminal_instance_id\"]\n304|\tif !known || isExplicitNull(encoded) {\n305|\t\treturn terminstance.ParseStatusBody(raw)\n306|\t}\n307|\tvar value string\n308|\tdecoder := json.NewDecoder(bytes.NewReader(encoded))\n309|\tif err := decoder.Decode(&value); err != nil {\n310|\t\treturn terminstance.ParseStatusBody(raw)\n311|\t}\n312|\tif err := CheckInstanceIdentity(value); err != nil {\n313|\t\treturn terminstance.StatusBody{}, err\n314|\t}\n315|\treturn terminstance.ParseStatusBody(raw)\n316|}\n317|\n318|// prescanIdentity runs the identity gate over one present string member of\n319|// a raw document. A frame fault, a missing member, or a non-string member\n320|// returns nil so the caller delegates to the landed shape authority,\n321|// which refuses those shapes itself.\n322|func prescanIdentity(raw []byte, member string) error {\n323|\tmembers, fault := environ.DecodeStrictObject(raw)\n324|\tif fault != nil {\n325|\t\treturn nil\n326|\t}\n327|\tencoded, known := members[member]\n328|\tif !known {\n329|\t\treturn nil\n330|\t}\n331|\tvar value string\n332|\tdecoder := json.NewDecoder(bytes.NewReader(encoded))\n333|\tif err := decoder.Decode(&value); err != nil {\n334|\t\treturn nil\n335|\t}\n336|\treturn CheckInstanceIdentity(value)\n337|}","final_result":true}}}
