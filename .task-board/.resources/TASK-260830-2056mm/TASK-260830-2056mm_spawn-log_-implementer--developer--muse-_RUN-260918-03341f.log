{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c701","stream":{"kind":"session","id":"01a0b3fc-2962-7bc0-91c2-787ae4899fa1"},"sequence":475,"recorded_at":1780531400000945,"record_type":"event","durability":"durable","causation_id":"6cf4561a-8326-47da-a916-4850b6a43e2a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6cf4561a-8326-47da-a916-4850b6a43e2a","run_stream":{"kind":"run","id":"6cf4561a-8326-47da-a916-4850b6a43e2a"},"task_stream":{"kind":"task","id":"01a0b3fd-6112-7523-a8cf-dff9f0ec3b1b"},"task_id":"01a0b3fd-6112-7523-a8cf-dff9f0ec3b1b","event":{"kind":"output","task_id":"01a0b3fd-6112-7523-a8cf-dff9f0ec3b1b","chunk":"Read text file `internal/termbind/recover.go`.\n1|package termbind\n2|\n3|import (\n4|\t\"context\"\n5|\t\"errors\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n11|)\n12|\n13|// RecoveryOutcome is the lost-create recovery verdict: proven absence, the\n14|// one recorded child, or unavailable when the effect cannot be disproven.\n15|type RecoveryOutcome string\n16|\n17|// Recovery outcomes.\n18|const (\n19|\tRecoveryAbsent      RecoveryOutcome = \"absent\"\n20|\tRecoveryChild       RecoveryOutcome = \"child\"\n21|\tRecoveryUnavailable RecoveryOutcome = \"unavailable\"\n22|)\n23|\n24|// RecoveryRequest carries one lost-create recovery query: the bootstrap\n25|// pair, the caller-derived bootstrap window bit, the backend tuple and\n26|// host-local generation for the status read, and the status deadline.\n27|type RecoveryRequest struct {\n28|\tSessionID            string\n29|\tBootstrapOperationID string\n30|\t// WindowOpen is true while the bootstrap window is open: the sessstate\n31|\t// fold names no newest published checkpoint. The caller derives it\n32|\t// from the fold (the axpane precedent for caller-derived facts);\n33|\t// recovery tests close the loop by folding a real chain.\n34|\tWindowOpen                 bool\n35|\tBackendID                  string\n36|\tImplementationVersion      string\n37|\tProtocolVersion            string\n38|\tGeneration                 string\n39|\tIncludeProviderObservation bool\n40|\tDeadlineAt                 string\n41|}\n42|\n43|// RecoveryDeps carries the recovery inputs: the durable bootstrap binding\n44|// store, the status engine, and the admitted capabilities for the status\n45|// provider conditional.\n46|type RecoveryDeps struct {\n47|\tBindings *axpane.Store\n48|\tEngine   *terminstance.Engine\n49|\tAdmitted terminalbackend.Admitted\n50|}\n51|\n52|// RecoveryVerdict is the recovery decision: the outcome, the recorded\n53|// binding and adopted backend state for the child, and the retry\n54|// disposition. Absence and the child both carry replay_same (run or\n55|// re-run the one operation); unavailable carries status_first.\n56|type RecoveryVerdict struct {\n57|\tOutcome    RecoveryOutcome\n58|\tBinding    axpane.Binding\n59|\tHasBinding bool\n60|\tState      terminalbackend.InstanceState\n61|\tRetry      terminstance.RetryDisposition\n62|}\n63|\n64|// RecoverCreate recovers a lost create result by bootstrap operation ID\n65|// from the durable (session_id, bootstrap_operation_id) binding plus one\n66|// status read. It is read-only: it binds nothing and emits nothing.\n67|//\n68|//   - A changed operation inside the bootstrap window refuses\n69|//     idempotency_mismatch; outside the window a new pair proceeds.\n70|//   - No binding plus a status that proves absent yields absence with\n71|//     replay_same: creating under this pair is safe.\n72|//   - A binding plus an identity-matching status yields the ONE recorded\n73|//     child with replay_same: reattach to it, or (when the backend shows\n74|//     absent) re-run the same operation for the same recorded instance,\n75|//     never a second child.\n76|//   - Every other shape yields unavailable with status_first: a\n77|//     contradiction (binding without a backend match), the creating\n78|//     interim, a backend-reported unavailable, or a live backend instance\n79|//     under an unbound pair (unadoptable: it cannot be proven ours).\n80|//\n81|// A binding read failure or a status read failure is an error, never\n82|// absence: unknown is not absent.\n83|func RecoverCreate(ctx context.Context, deps RecoveryDeps, request RecoveryRequest) (RecoveryVerdict, error) {\n84|\tempty := RecoveryVerdict{}\n85|\tif deps.Bindings == nil {\n86|\t\treturn empty, errors.New(\"recovery carries no bootstrap binding store\")\n87|\t}\n88|\tif deps.Engine == nil {\n89|\t\treturn empty, errors.New(\"recovery carries no status engine\")\n90|\t}\n91|\tbinding, found, err := deps.Bindings.Lookup(request.SessionID, request.BootstrapOperationID)\n92|\tif err != nil {\n93|\t\treturn empty, err\n94|\t}\n95|\tif !found {\n96|\t\tanchor, anchored, err := deps.Bindings.Status(request.SessionID)\n97|\t\tif err != nil {\n98|\t\t\treturn empty, err\n99|\t\t}\n100|\t\tif anchored && anchor.OperationID != request.BootstrapOperationID && request.WindowOpen {\n101|\t\t\treturn empty, &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \"bootstrap binding\"}\n102|\t\t}\n103|\t}\n104|\tbody, err := recoveryStatusBody(request, binding, found)\n105|\tif err != nil {\n106|\t\treturn empty, err\n107|\t}\n108|\treport, err := deps.Engine.ExecuteStatus(ctx, body, \"\", deps.Admitted)\n109|\tif err != nil {\n110|\t\treturn empty, err\n111|\t}\n112|\tif !found {\n113|\t\tif report.IdentityMatch && report.State == terminalbackend.StateAbsent {\n114|\t\t\treturn RecoveryVerdict{Outcome: RecoveryAbsent, State: report.State, Retry: terminstance.DispositionReplaySame}, nil\n115|\t\t}\n116|\t\treturn RecoveryVerdict{Outcome: RecoveryUnavailable, State: report.State, Retry: terminstance.DispositionStatusFirst}, nil\n117|\t}\n118|\tif !report.IdentityMatch {\n119|\t\treturn RecoveryVerdict{Outcome: RecoveryUnavailable, State: report.State, Retry: terminstance.DispositionStatusFirst}, nil\n120|\t}\n121|\tswitch report.State {\n122|\tcase terminalbackend.StateCreating, terminalbackend.StateUnavailable:\n123|\t\treturn RecoveryVerdict{Outcome: RecoveryUnavailable, State: report.State, Retry: terminstance.DispositionStatusFirst}, nil\n124|\tdefault:\n125|\t\treturn RecoveryVerdict{Outcome: RecoveryChild, Binding: binding, HasBinding: true, State: report.State, Retry: terminstance.DispositionReplaySame}, nil\n126|\t}\n127|}\n128|\n129|// recoveryStatusBody builds the recovery status read: the exact-instance\n130|// lookup over the recorded binding when the pair is bound, else the\n131|// session-scoped lookup that can prove absence. The host-local generation\n132|// passes through the landed bound gate; the deadline parses through the\n133|// scalar owner.\n134|func recoveryStatusBody(request RecoveryRequest, binding axpane.Binding, found bool) (terminstance.StatusBody, error) {\n135|\tempty := terminstance.StatusBody{}\n136|\tdeadline, err := scalar.ParseTimestamp(request.DeadlineAt)\n137|\tif err != nil {\n138|\t\treturn empty, err\n139|\t}\n140|\tbody := terminstance.StatusBody{\n141|\t\tSessionID:                  request.SessionID,\n142|\t\tTerminalBackendID:          request.BackendID,\n143|\t\tImplementationVersion:      request.ImplementationVersion,\n144|\t\tProtocolVersion:            request.ProtocolVersion,\n145|\t\tIncludeProviderObservation: request.IncludeProviderObservation,\n146|\t\tDeadline:                   deadline,\n147|\t}\n148|\tif !found {\n149|\t\treturn body, nil\n150|\t}\n151|\tif _, err := terminalbackend.GenerationDigest(request.Generation); err != nil {\n152|\t\treturn empty, err\n153|\t}\n154|\tbody.TerminalInstanceID = binding.TerminalInstanceID\n155|\tbody.HasTerminalInstanceID = true\n156|\tbody.BackendGeneration = request.Generation\n157|\tbody.HasBackendGeneration = true\n158|\treturn body, nil\n159|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c703","stream":{"kind":"session","id":"01a0b3fc-2962-7bc0-91c2-787ae4899fa1"},"sequence":476,"recorded_at":1780531400000947,"record_type":"event","durability":"durable","causation_id":"6cf4561a-8326-47da-a916-4850b6a43e2a","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6cf4561a-8326-47da-a916-4850b6a43e2a","run_stream":{"kind":"run","id":"6cf4561a-8326-47da-a916-4850b6a43e2a"},"task_stream":{"kind":"task","id":"01a0b3fd-6112-7523-a8cf-dff9f0ec3b1b"},"task_id":"01a0b3fd-6112-7523-a8cf-dff9f0ec3b1b","event":{"kind":"completed","task_id":"01a0b3fd-6112-7523-a8cf-dff9f0ec3b1b"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c705","stream":{"kind":"session","id":"01a0b3fc-2962-7bc0-91c2-787ae4899fa1"},"sequence":477,"recorded_at":1780531400000949,"record_type":"event","durability":"durable","causation_id":"6cf4561a-8326-47da-a916-4850b6a43e2a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6cf4561a-8326-47da-a916-4850b6a43e2a","run_stream":{"kind":"run","id":"6cf4561a-8326-47da-a916-4850b6a43e2a"},"task_stream":{"kind":"task","id":"01a0b3fd-6147-70e1-b851-a3c983445f19"},"task_id":"01a0b3fd-6147-70e1-b851-a3c983445f19","event":{"kind":"output","task_id":"01a0b3fd-6147-70e1-b851-a3c983445f19","chunk":"Read text file `internal/termbind/emit.go`.\n1|package termbind\n2|\n3|import (\n4|\t\"time\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n9|)\n10|\n11|// Terminal event types and schema version from Section 5.2. The literals\n12|// are asserted at the emission entries, not referenced from the axpane\n13|// owner, so a drift between the two fails here.\n14|const (\n15|\teventTerminalCreated = \"terminal.created\"\n16|\teventSessionResumed  = \"session.resumed\"\n17|\teventSchemaV4        = \"4.0.0\"\n18|)\n19|\n20|// EvidenceAdmission carries the local evidence admission inputs: the\n21|// backend registry, the host-local evidence universe, the host-local raw\n22|// backend generation (never written to the event), the clock, and the\n23|// caller-supplied signature verifier.\n24|type EvidenceAdmission struct {\n25|\tRegistry      *terminalbackend.Registry\n26|\tUniverse      EvidenceUniverse\n27|\tRawGeneration string\n28|\tNow           time.Time\n29|\tVerify        terminalbackend.SignatureVerifier\n30|}\n31|\n32|// EmitTerminalCreated authors one Session Event 4.0.0 terminal.created\n33|// event through the sessrepo owner under a lease the local host holds. The\n34|// evidence IDs resolve first through the landed admission bound to the\n35|// payload's own backend tuple; only an admitted backend authors. The\n36|// payload is built by the axpane owner and appended by the axpane Emit\n37|// entry, which gates through fencing.AuthorizeMutation and the canonical\n38|// closed-shape boundary. The binding digest travels as the opaque audit\n39|// reference: the entry takes no binding object, generation string, or\n40|// native reference, so none can reach the event bytes.\n41|func EmitTerminalCreated(repository *sessrepo.Repository, params axpane.EmitParams, facts axpane.TerminalBindingFacts, admission EvidenceAdmission) (sessrepo.EventRef, []byte, ResolvedEvidence, error) {\n42|\tempty := sessrepo.EventRef{}\n43|\tresolved, err := ResolveEvidence(facts.EvidenceIDs, tupleFromFacts(facts), admission.Registry, admission.Universe, admission.RawGeneration, admission.Now, admission.Verify)\n44|\tif err != nil {\n45|\t\treturn empty, nil, ResolvedEvidence{}, err\n46|\t}\n47|\tpayload, err := axpane.TerminalCreatedPayload(facts)\n48|\tif err != nil {\n49|\t\treturn empty, nil, ResolvedEvidence{}, err\n50|\t}\n51|\tparams.EventType = eventTerminalCreated\n52|\tparams.SchemaVersion = eventSchemaV4\n53|\tparams.Payload = payload\n54|\treference, raw, err := axpane.Emit(repository, params)\n55|\tif err != nil {\n56|\t\treturn empty, nil, ResolvedEvidence{}, err\n57|\t}\n58|\treturn reference, raw, resolved, nil\n59|}\n60|\n61|// EmitResumed authors one Session Event 4.0.0 session.resumed event through\n62|// the same admission and lease authority as EmitTerminalCreated. The\n63|// checkpoint, execution profile, and nullable profile source arrive from\n64|// the caller (the effective Section 2.4 pair the decision carries); the\n65|// terminal binding and evidence members resolve and append exactly as the\n66|// created event does.\n67|func EmitResumed(repository *sessrepo.Repository, params axpane.EmitParams, checkpointID, profile, source string, hasSource bool, facts axpane.TerminalBindingFacts, admission EvidenceAdmission) (sessrepo.EventRef, []byte, ResolvedEvidence, error) {\n68|\tempty := sessrepo.EventRef{}\n69|\tresolved, err := ResolveEvidence(facts.EvidenceIDs, tupleFromFacts(facts), admission.Registry, admission.Universe, admission.RawGeneration, admission.Now, admission.Verify)\n70|\tif err != nil {\n71|\t\treturn empty, nil, ResolvedEvidence{}, err\n72|\t}\n73|\tpayload, err := axpane.ResumedPayload(checkpointID, profile, source, hasSource, facts)\n74|\tif err != nil {\n75|\t\treturn empty, nil, ResolvedEvidence{}, err\n76|\t}\n77|\tparams.EventType = eventSessionResumed\n78|\tparams.SchemaVersion = eventSchemaV4\n79|\tparams.Payload = payload\n80|\treference, raw, err := axpane.Emit(repository, params)\n81|\tif err != nil {\n82|\t\treturn empty, nil, ResolvedEvidence{}, err\n83|\t}\n84|\treturn reference, raw, resolved, nil\n85|}\n86|\n87|// tupleFromFacts derives the event tuple from the payload's own backend\n88|// members, so resolution always binds the resolved objects to the tuple\n89|// the emitted event carries. No second tuple is expressible.\n90|func tupleFromFacts(facts axpane.TerminalBindingFacts) EventTuple {\n91|\treturn EventTuple{\n92|\t\tBackendID:             facts.BackendID,\n93|\t\tImplementationVersion: facts.ImplementationVersion,\n94|\t\tProtocolVersion:       facts.ProtocolVersion,\n95|\t}\n96|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c707","stream":{"kind":"session","id":"01a0b3fc-2962-7bc0-91c2-787ae4899fa1"},"sequence":478,"recorded_at":1780531400000951,"record_type":"event","durability":"durable","causation_id":"6cf4561a-8326-47da-a916-4850b6a43e2a","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6cf4561a-8326-47da-a916-4850b6a43e2a","run_stream":{"kind":"run","id":"6cf4561a-8326-47da-a916-4850b6a43e2a"},"task_stream":{"kind":"task","id":"01a0b3fd-6147-70e1-b851-a3c983445f19"},"task_id":"01a0b3fd-6147-70e1-b851-a3c983445f19","event":{"kind":"completed","task_id":"01a0b3fd-6147-70e1-b851-a3c983445f19"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c709","stream":{"kind":"session","id":"01a0b3fc-2962-7bc0-91c2-787ae4899fa1"},"sequence":479,"recorded_at":1780531400000953,"record_type":"event","durability":"durable","causation_id":"6cf4561a-8326-47da-a916-4850b6a43e2a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6cf4561a-8326-47da-a916-4850b6a43e2a","run_stream":{"kind":"run","id":"6cf4561a-8326-47da-a916-4850b6a43e2a"},"task_stream":{"kind":"task","id":"01a0b3fd-60d8-7613-a47b-11e07af81e96"},"task_id":"01a0b3fd-60d8-7613-a47b-11e07af81e96","event":{"kind":"output","task_id":"01a0b3fd-60d8-7613-a47b-11e07af81e96","chunk":"Read text file `internal/termbind/resolve.go`.\n1|package termbind\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"fmt\"\n7|\t\"time\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n12|)\n13|\n14|// Evidence bounds from Section 5.2: evidence_ids is sorted unique\n15|// digest[1..256].\n16|const (\n17|\tminEvidenceIDs = 1\n18|\tmaxEvidenceIDs = 256\n19|)\n20|\n21|// EventTuple is the backend identity a v4 terminal event carries: the\n22|// admitted backend ID with the implementation and protocol versions every\n23|// resolved evidence object must bind to.\n24|type EventTuple struct {\n25|\tBackendID             string\n26|\tImplementationVersion string\n27|\tProtocolVersion       string\n28|}\n29|\n30|// EvidenceUniverse is the modeled host-local evidence store: evidence IDs\n31|// resolve through it to raw candidate documents. A production caller backs\n32|// it with validated local Manifest, Probe, and Capability Evidence\n33|// objects; tests model resolution, mismatch, and hostile documents through\n34|// it.\n35|type EvidenceUniverse interface {\n36|\t// Lookup returns the raw document the evidence ID names. Found is\n37|\t// false when the ID resolves to nothing locally.\n38|\tLookup(id string) ([]byte, bool)\n39|}\n40|\n41|// ResolvedEvidence is the admitted resolution of one event's evidence\n42|// IDs: the single Manifest, the single Probe, the Capability Evidence\n43|// objects, and the landed admission verdict over the set.\n44|type ResolvedEvidence struct {\n45|\tManifest terminalbackend.Manifest\n46|\tProbe    terminalbackend.Probe\n47|\tEvidence []terminalbackend.Evidence\n48|\tAdmitted terminalbackend.Admitted\n49|}\n50|\n51|// ResolveEvidence resolves one v4 event's evidence IDs locally to\n52|// validated Manifest, Probe, and Capability Evidence objects bound to the\n53|// event's backend tuple, and admits the set through the landed registry.\n54|// Every failure refuses terminal_backend_manifest_probe_mismatch: an\n55|// unresolvable ID, a document of any other kind (a native reference, a\n56|// generation string, a socket, a pipe, an endpoint, a token, a credential,\n57|// terminal output, a PID/handle, or any live-process fact), a malformed\n58|// document, an ID that does not name the returned document, a document\n59|// bound to another backend or version, or a set the landed admission\n60|// refuses.\n61|//\n62|// The resolution carries one stated contract where the specification pins\n63|// the requirement but not the cardinality: the resolved set holds exactly\n64|// one Manifest and exactly one Probe, the rest Capability Evidence. The\n65|// event tuple names one backend/version pair, so an ambiguous set (zero or\n66|// two manifests, zero or two probes) fails closed rather than selecting.\n67|// As a consequence a lone evidence ID passes the wire shape but never\n68|// resolves: one digest cannot name all three objects.\n69|//\n70|// The evidence_ids wire shape (sorted unique digest[1..256]) is pre-checked\n71|// here in three arms so each bound carries its own narrowing mutant; the\n72|// canonical owner re-enforces the identical shape at the append boundary\n73|// (validateTerminalV4Payload) and remains the shape authority.\n74|func ResolveEvidence(ids []string, tuple EventTuple, registry *terminalbackend.Registry, universe EvidenceUniverse, rawGeneration string, now time.Time, verify terminalbackend.SignatureVerifier) (ResolvedEvidence, error) {\n75|\tempty := ResolvedEvidence{}\n76|\tif universe == nil {\n77|\t\treturn empty, mismatchRefusal(\"evidence universe\")\n78|\t}\n79|\tif err := checkEvidenceIDs(ids); err != nil {\n80|\t\treturn empty, err\n81|\t}\n82|\tvar manifestRaw, probeRaw []byte\n83|\tvar manifestFound, probeFound bool\n84|\tvar evidenceRaws [][]byte\n85|\tfor _, id := range ids {\n86|\t\traw, found := universe.Lookup(id)\n87|\t\tif !found {\n88|\t\t\treturn empty, mismatchRefusal(\"evidence unresolvable\")\n89|\t\t}\n90|\t\tkind, err := evidenceSchema(raw)\n91|\t\tif err != nil {\n92|\t\t\treturn empty, err\n93|\t\t}\n94|\t\tswitch kind {\n95|\t\tcase terminalbackend.SchemaManifest:\n96|\t\t\tif manifestFound {\n97|\t\t\t\treturn empty, mismatchRefusal(\"evidence manifest\")\n98|\t\t\t}\n99|\t\t\tmanifestRaw, manifestFound = raw, true\n100|\t\tcase terminalbackend.SchemaProbe:\n101|\t\t\tif probeFound {\n102|\t\t\t\treturn empty, mismatchRefusal(\"evidence probe\")\n103|\t\t\t}\n104|\t\t\tprobeRaw, probeFound = raw, true\n105|\t\tdefault:\n106|\t\t\tevidenceRaws = append(evidenceRaws, raw)\n107|\t\t}\n108|\t}\n109|\tif !manifestFound || !probeFound {\n110|\t\treturn empty, mismatchRefusal(\"evidence set\")\n111|\t}\n112|\tmanifest, err := terminalbackend.ParseManifest(manifestRaw)\n113|\tif err != nil {\n114|\t\treturn empty, err\n115|\t}\n116|\tprobe, err := terminalbackend.ParseProbe(probeRaw)\n117|\tif err != nil {\n118|\t\treturn empty, err\n119|\t}\n120|\tevidence := make([]terminalbackend.Evidence, 0, len(evidenceRaws))\n121|\tfor _, raw := range evidenceRaws {\n122|\t\tobject, err := terminalbackend.ParseEvidence(raw)\n123|\t\tif err != nil {\n124|\t\t\treturn empty, err\n125|\t\t}\n126|\t\tevidence = append(evidence, object)\n127|\t}\n128|\tif err := checkResolvedIdentity(ids, manifest, probe, evidence); err != nil {\n129|\t\treturn empty, err\n130|\t}\n131|\tif err := checkEventBinding(tuple, manifest, probe, evidence); err != nil {\n132|\t\treturn empty, err\n133|\t}\n134|\tadmitted, err := registry.AdmitProbe(manifestRaw, probeRaw, evidenceRaws, rawGeneration, now, verify)\n135|\tif err != nil {\n136|\t\treturn empty, err\n137|\t}\n138|\treturn ResolvedEvidence{Manifest: manifest, Probe: probe, Evidence: evidence, Admitted: admitted}, nil\n139|}\n140|\n141|// checkEvidenceIDs pre-checks the evidence_ids wire shape: sorted unique\n142|// digest[1..256]. Digest grammar delegates to scalar; the count bounds are\n143|// the Section 5.2 literals; ordering is strict bytewise increase, the same\n144|// rule the landed sorted-unique checks enforce.\n145|func checkEvidenceIDs(ids []string) error {\n146|\tif len(ids) < minEvidenceIDs || len(ids) > maxEvidenceIDs {\n147|\t\treturn fmt.Errorf(\"evidence ids number %d, want 1..256\", len(ids))\n148|\t}\n149|\tprevious := \"\"\n150|\tfor index, id := range ids {\n151|\t\tif _, err := scalar.ParseDigest(id); err != nil {\n152|\t\t\treturn fmt.Errorf(\"evidence id is not a digest: %w\", err)\n153|\t\t}\n154|\t\tif index > 0 && id <= previous {\n155|\t\t\treturn fmt.Errorf(\"evidence ids are not sorted unique\")\n156|\t\t}\n157|\t\tprevious = id\n158|\t}\n159|\treturn nil\n160|}\n161|\n162|// evidenceSchema classifies one resolved document by its schema literal.\n163|// Only the three evidence schemas resolve; any other schema (or any bytes\n164|// that are not a strict object, such as a bare PID, token, or terminal\n165|// output) refuses the mismatch class, never a parse of the foreign bytes.\n166|func evidenceSchema(raw []byte) (string, error) {\n167|\tmembers, fault := environ.DecodeStrictObject(raw)\n168|\tif fault != nil {\n169|\t\treturn \"\", mismatchRefusal(\"evidence kind\")\n170|\t}\n171|\tencoded, known := members[\"schema\"]\n172|\tif !known {\n173|\t\treturn \"\", mismatchRefusal(\"evidence kind\")\n174|\t}\n175|\tvar schema string\n176|\tdecoder := json.NewDecoder(bytes.NewReader(encoded))\n177|\tif err := decoder.Decode(&schema); err != nil {\n178|\t\treturn \"\", mismatchRefusal(\"evidence kind\")\n179|\t}\n180|\tswitch schema {\n181|\tcase terminalbackend.SchemaManifest, terminalbackend.SchemaProbe, terminalbackend.SchemaCapabilityEvidence:\n182|\t\treturn schema, nil\n183|\tdefault:\n184|\t\treturn \"\", mismatchRefusal(\"evidence kind\")\n185|\t}\n186|}\n187|\n188|// checkResolvedIdentity requires every resolved document's self ID to equal\n189|// the evidence ID that named it: a universe that returns document X for ID\n190|// Y fails closed instead of admitting the substitution.\n191|func checkResolvedIdentity(ids []string, manifest terminalbackend.Manifest, probe terminalbackend.Probe, evidence []terminalbackend.Evidence) error {\n192|\tnamed := make(map[string]bool, len(ids))\n193|\tfor _, id := range ids {\n194|\t\tnamed[id] = true\n195|\t}\n196|\tif !named[manifest.ManifestID] || !named[probe.ProbeID] {\n197|\t\treturn mismatchRefusal(\"evidence identity\")\n198|\t}\n199|\tfor _, object := range evidence {\n200|\t\tif !named[object.EvidenceID] {\n201|\t\t\treturn mismatchRefusal(\"evidence identity\")\n202|\t\t}\n203|\t}\n204|\treturn nil\n205|}\n206|\n207|// checkEventBinding requires every resolved object to bind the event's\n208|// backend tuple: backend ID and implementation version everywhere, and the\n209|// protocol version on the Probe and Capability Evidence. Manifest protocol\n210|// membership (the event protocol is one of the Manifest's protocol\n211|// versions) is enforced by the landed admission the resolution finishes\n212|// through, not re-derived here.\n213|func checkEventBinding(tuple EventTuple, manifest terminalbackend.Manifest, probe terminalbackend.Probe, evidence []terminalbackend.Evidence) error {\n214|\tif manifest.TerminalBackendID != tuple.BackendID || manifest.ImplementationVersion != tuple.ImplementationVersion {\n215|\t\treturn mismatchRefusal(\"evidence binding\")\n216|\t}\n217|\tif probe.TerminalBackendID != tuple.BackendID || probe.ImplementationVersion != tuple.ImplementationVersion || probe.ProtocolVersion != tuple.ProtocolVersion {\n218|\t\treturn mismatchRefusal(\"evidence binding\")\n219|\t}\n220|\tfor _, object := range evidence {\n221|\t\tif object.TerminalBackendID != tuple.BackendID || object.ImplementationVersion != tuple.ImplementationVersion || object.ProtocolVersion != tuple.ProtocolVersion {\n222|\t\t\treturn mismatchRefusal(\"evidence binding\")\n223|\t\t}\n224|\t}\n225|\treturn nil\n226|}\n227|\n228|// mismatchRefusal builds the Section 4.B evidence refusal: any failed\n229|// evidence binding, coverage, or resolution rule.\n230|func mismatchRefusal(detail string) error {\n231|\treturn &terminalbackend.Error{Code: terminalbackend.CodeMismatch, Detail: detail}\n232|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c70b","stream":{"kind":"session","id":"01a0b3fc-2962-7bc0-91c2-787ae4899fa1"},"sequence":480,"recorded_at":1780531400000955,"record_type":"event","durability":"durable","causation_id":"6cf4561a-8326-47da-a916-4850b6a43e2a","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6cf4561a-8326-47da-a916-4850b6a43e2a","run_stream":{"kind":"run","id":"6cf4561a-8326-47da-a916-4850b6a43e2a"},"task_stream":{"kind":"task","id":"01a0b3fd-60d8-7613-a47b-11e07af81e96"},"task_id":"01a0b3fd-60d8-7613-a47b-11e07af81e96","event":{"kind":"completed","task_id":"01a0b3fd-60d8-7613-a47b-11e07af81e96"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c70d","stream":{"kind":"session","id":"01a0b3fc-2962-7bc0-91c2-787ae4899fa1"},"sequence":481,"recorded_at":1780531400000957,"record_type":"event","durability":"durable","causation_id":"6cf4561a-8326-47da-a916-4850b6a43e2a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"6cf4561a-8326-47da-a916-4850b6a43e2a","run_stream":{"kind":"run","id":"6cf4561a-8326-47da-a916-4850b6a43e2a"},"call_id":"call_01a0b3fd59d0733493b89555509ce821","text":"Read text file `internal/termbind/resolve.go`.\n1|package termbind\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"fmt\"\n7|\t\"time\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n12|)\n13|\n14|// Evidence bounds from Section 5.2: evidence_ids is sorted unique\n15|// digest[1..256].\n16|const (\n17|\tminEvidenceIDs = 1\n18|\tmaxEvidenceIDs = 256\n19|)\n20|\n21|// EventTuple is the backend identity a v4 terminal event carries: the\n22|// admitted backend ID with the implementation and protocol versions every\n23|// resolved evidence object must bind to.\n24|type EventTuple struct {\n25|\tBackendID             string\n26|\tImplementationVersion string\n27|\tProtocolVersion       string\n28|}\n29|\n30|// EvidenceUniverse is the modeled host-local evidence store: evidence IDs\n31|// resolve through it to raw candidate documents. A production caller backs\n32|// it with validated local Manifest, Probe, and Capability Evidence\n33|// objects; tests model resolution, mismatch, and hostile documents through\n34|// it.\n35|type EvidenceUniverse interface {\n36|\t// Lookup returns the raw document the evidence ID names. Found is\n37|\t// false when the ID resolves to nothing locally.\n38|\tLookup(id string) ([]byte, bool)\n39|}\n40|\n41|// ResolvedEvidence is the admitted resolution of one event's evidence\n42|// IDs: the single Manifest, the single Probe, the Capability Evidence\n43|// objects, and the landed admission verdict over the set.\n44|type ResolvedEvidence struct {\n45|\tManifest terminalbackend.Manifest\n46|\tProbe    terminalbackend.Probe\n47|\tEvidence []terminalbackend.Evidence\n48|\tAdmitted terminalbackend.Admitted\n49|}\n50|\n51|// ResolveEvidence resolves one v4 event's evidence IDs locally to\n52|// validated Manifest, Probe, and Capability Evidence objects bound to the\n53|// event's backend tuple, and admits the set through the landed registry.\n54|// Every failure refuses terminal_backend_manifest_probe_mismatch: an\n55|// unresolvable ID, a document of any other kind (a native reference, a\n56|// generation string, a socket, a pipe, an endpoint, a token, a credential,\n57|// terminal output, a PID/handle, or any live-process fact), a malformed\n58|// document, an ID that does not name the returned document, a document\n59|// bound to another backend or version, or a set the landed admission\n60|// refuses.\n61|//\n62|// The resolution carries one stated contract where the specification pins\n63|// the requirement but not the cardinality: the resolved set holds exactly\n64|// one Manifest and exactly one Probe, the rest Capability Evidence. The\n65|// event tuple names one backend/version pair, so an ambiguous set (zero or\n66|// two manifests, zero or two probes) fails closed rather than selecting.\n67|// As a consequence a lone evidence ID passes the wire shape but never\n68|// resolves: one digest cannot name all three objects.\n69|//\n70|// The evidence_ids wire shape (sorted unique digest[1..256]) is pre-checked\n71|// here in three arms so each bound carries its own narrowing mutant; the\n72|// canonical owner re-enforces the identical shape at the append boundary\n73|// (validateTerminalV4Payload) and remains the shape authority.\n74|func ResolveEvidence(ids []string, tuple EventTuple, registry *terminalbackend.Registry, universe EvidenceUniverse, rawGeneration string, now time.Time, verify terminalbackend.SignatureVerifier) (ResolvedEvidence, error) {\n75|\tempty := ResolvedEvidence{}\n76|\tif universe == nil {\n77|\t\treturn empty, mismatchRefusal(\"evidence universe\")\n78|\t}\n79|\tif err := checkEvidenceIDs(ids); err != nil {\n80|\t\treturn empty, err\n81|\t}\n82|\tvar manifestRaw, probeRaw []byte\n83|\tvar manifestFound, probeFound bool\n84|\tvar evidenceRaws [][]byte\n85|\tfor _, id := range ids {\n86|\t\traw, found := universe.Lookup(id)\n87|\t\tif !found {\n88|\t\t\treturn empty, mismatchRefusal(\"evidence unresolvable\")\n89|\t\t}\n90|\t\tkind, err := evidenceSchema(raw)\n91|\t\tif err != nil {\n92|\t\t\treturn empty, err\n93|\t\t}\n94|\t\tswitch kind {\n95|\t\tcase terminalbackend.SchemaManifest:\n96|\t\t\tif manifestFound {\n97|\t\t\t\treturn empty, mismatchRefusal(\"evidence manifest\")\n98|\t\t\t}\n99|\t\t\tmanifestRaw, manifestFound = raw, true\n100|\t\tcase terminalbackend.SchemaProbe:\n101|\t\t\tif probeFound {\n102|\t\t\t\treturn empty, mismatchRefusal(\"evidence probe\")\n103|\t\t\t}\n104|\t\t\tprobeRaw, probeFound = raw, true\n105|\t\tdefault:\n106|\t\t\tevidenceRaws = append(evidenceRaws, raw)\n107|\t\t}\n108|\t}\n109|\tif !manifestFound || !probeFound {\n110|\t\treturn empty, mismatchRefusal(\"evidence set\")\n111|\t}\n112|\tmanifest, err := terminalbackend.ParseManifest(manifestRaw)\n113|\tif err != nil {\n114|\t\treturn empty, err\n115|\t}\n116|\tprobe, err := terminalbackend.ParseProbe(probeRaw)\n117|\tif err != nil {\n118|\t\treturn empty, err\n119|\t}\n120|\tevidence := make([]terminalbackend.Evidence, 0, len(evidenceRaws))\n121|\tfor _, raw := range evidenceRaws {\n122|\t\tobject, err := terminalbackend.ParseEvidence(raw)\n123|\t\tif err != nil {\n124|\t\t\treturn empty, err\n125|\t\t}\n126|\t\tevidence = append(evidence, object)\n127|\t}\n128|\tif err := checkResolvedIdentity(ids, manifest, probe, evidence); err != nil {\n129|\t\treturn empty, err\n130|\t}\n131|\tif err := checkEventBinding(tuple, manifest, probe, evidence); err != nil {\n132|\t\treturn empty, err\n133|\t}\n134|\tadmitted, err := registry.AdmitProbe(manifestRaw, probeRaw, evidenceRaws, rawGeneration, now, verify)\n135|\tif err != nil {\n136|\t\treturn empty, err\n137|\t}\n138|\treturn ResolvedEvidence{Manifest: manifest, Probe: probe, Evidence: evidence, Admitted: admitted}, nil\n139|}\n140|\n141|// checkEvidenceIDs pre-checks the evidence_ids wire shape: sorted unique\n142|// digest[1..256]. Digest grammar delegates to scalar; the count bounds are\n143|// the Section 5.2 literals; ordering is strict bytewise increase, the same\n144|// rule the landed sorted-unique checks enforce.\n145|func checkEvidenceIDs(ids []string) error {\n146|\tif len(ids) < minEvidenceIDs || len(ids) > maxEvidenceIDs {\n147|\t\treturn fmt.Errorf(\"evidence ids number %d, want 1..256\", len(ids))\n148|\t}\n149|\tprevious := \"\"\n150|\tfor index, id := range ids {\n151|\t\tif _, err := scalar.ParseDigest(id); err != nil {\n152|\t\t\treturn fmt.Errorf(\"evidence id is not a digest: %w\", err)\n153|\t\t}\n154|\t\tif index > 0 && id <= previous {\n155|\t\t\treturn fmt.Errorf(\"evidence ids are not sorted unique\")\n156|\t\t}\n157|\t\tprevious = id\n158|\t}\n159|\treturn nil\n160|}\n161|\n162|// evidenceSchema classifies one resolved document by its schema literal.\n163|// Only the three evidence schemas resolve; any other schema (or any bytes\n164|// that are not a strict object, such as a bare PID, token, or terminal\n165|// output) refuses the mismatch class, never a parse of the foreign bytes.\n166|func evidenceSchema(raw []byte) (string, error) {\n167|\tmembers, fault := environ.DecodeStrictObject(raw)\n168|\tif fault != nil {\n169|\t\treturn \"\", mismatchRefusal(\"evidence kind\")\n170|\t}\n171|\tencoded, known := members[\"schema\"]\n172|\tif !known {\n173|\t\treturn \"\", mismatchRefusal(\"evidence kind\")\n174|\t}\n175|\tvar schema string\n176|\tdecoder := json.NewDecoder(bytes.NewReader(encoded))\n177|\tif err := decoder.Decode(&schema); err != nil {\n178|\t\treturn \"\", mismatchRefusal(\"evidence kind\")\n179|\t}\n180|\tswitch schema {\n181|\tcase terminalbackend.SchemaManifest, terminalbackend.SchemaProbe, terminalbackend.SchemaCapabilityEvidence:\n182|\t\treturn schema, nil\n183|\tdefault:\n184|\t\treturn \"\", mismatchRefusal(\"evidence kind\")\n185|\t}\n186|}\n187|\n188|// checkResolvedIdentity requires every resolved document's self ID to equal\n189|// the evidence ID that named it: a universe that returns document X for ID\n190|// Y fails closed instead of admitting the substitution.\n191|func checkResolvedIdentity(ids []string, manifest terminalbackend.Manifest, probe terminalbackend.Probe, evidence []terminalbackend.Evidence) error {\n192|\tnamed := make(map[string]bool, len(ids))\n193|\tfor _, id := range ids {\n194|\t\tnamed[id] = true\n195|\t}\n196|\tif !named[manifest.ManifestID] || !named[probe.ProbeID] {\n197|\t\treturn mismatchRefusal(\"evidence identity\")\n198|\t}\n199|\tfor _, object := range evidence {\n200|\t\tif !named[object.EvidenceID] {\n201|\t\t\treturn mismatchRefusal(\"evidence identity\")\n202|\t\t}\n203|\t}\n204|\treturn nil\n205|}\n206|\n207|// checkEventBinding requires every resolved object to bind the event's\n208|// backend tuple: backend ID and implementation version everywhere, and the\n209|// protocol version on the Probe and Capability Evidence. Manifest protocol\n210|// membership (the event protocol is one of the Manifest's protocol\n211|// versions) is enforced by the landed admission the resolution finishes\n212|// through, not re-derived here.\n213|func checkEventBinding(tuple EventTuple, manifest terminalbackend.Manifest, probe terminalbackend.Probe, evidence []terminalbackend.Evidence) error {\n214|\tif manifest.TerminalBackendID != tuple.BackendID || manifest.ImplementationVersion != tuple.ImplementationVersion {\n215|\t\treturn mismatchRefusal(\"evidence binding\")\n216|\t}\n217|\tif probe.TerminalBackendID != tuple.BackendID || probe.ImplementationVersion != tuple.ImplementationVersion || probe.ProtocolVersion != tuple.ProtocolVersion {\n218|\t\treturn mismatchRefusal(\"evidence binding\")\n219|\t}\n220|\tfor _, object := range evidence {\n221|\t\tif object.TerminalBackendID != tuple.BackendID || object.ImplementationVersion != tuple.ImplementationVersion || object.ProtocolVersion != tuple.ProtocolVersion {\n222|\t\t\treturn mismatchRefusal(\"evidence binding\")\n223|\t\t}\n224|\t}\n225|\treturn nil\n226|}\n227|\n228|// mismatchRefusal builds the Section 4.B evidence refusal: any failed\n229|// evidence binding, coverage, or resolution rule.\n230|func mismatchRefusal(detail string) error {\n231|\treturn &terminalbackend.Error{Code: terminalbackend.CodeMismatch, Detail: detail}\n232|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c70f","stream":{"kind":"session","id":"01a0b3fc-2962-7bc0-91c2-787ae4899fa1"},"sequence":482,"recorded_at":1780531400000959,"record_type":"event","durability":"durable","causation_id":"6cf4561a-8326-47da-a916-4850b6a43e2a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"6cf4561a-8326-47da-a916-4850b6a43e2a","run_stream":{"kind":"run","id":"6cf4561a-8326-47da-a916-4850b6a43e2a"},"call_id":"call_01a0b3fd5b65706abdae16e71bce26bf","text":"Read text file `internal/termbind/recover.go`.\n1|package termbind\n2|\n3|import (\n4|\t\"context\"\n5|\t\"errors\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n11|)\n12|\n13|// RecoveryOutcome is the lost-create recovery verdict: proven absence, the\n14|// one recorded child, or unavailable when the effect cannot be disproven.\n15|type RecoveryOutcome string\n16|\n17|// Recovery outcomes.\n18|const (\n19|\tRecoveryAbsent      RecoveryOutcome = \"absent\"\n20|\tRecoveryChild       RecoveryOutcome = \"child\"\n21|\tRecoveryUnavailable RecoveryOutcome = \"unavailable\"\n22|)\n23|\n24|// RecoveryRequest carries one lost-create recovery query: the bootstrap\n25|// pair, the caller-derived bootstrap window bit, the backend tuple and\n26|// host-local generation for the status read, and the status deadline.\n27|type RecoveryRequest struct {\n28|\tSessionID            string\n29|\tBootstrapOperationID string\n30|\t// WindowOpen is true while the bootstrap window is open: the sessstate\n31|\t// fold names no newest published checkpoint. The caller derives it\n32|\t// from the fold (the axpane precedent for caller-derived facts);\n33|\t// recovery tests close the loop by folding a real chain.\n34|\tWindowOpen                 bool\n35|\tBackendID                  string\n36|\tImplementationVersion      string\n37|\tProtocolVersion            string\n38|\tGeneration                 string\n39|\tIncludeProviderObservation bool\n40|\tDeadlineAt                 string\n41|}\n42|\n43|// RecoveryDeps carries the recovery inputs: the durable bootstrap binding\n44|// store, the status engine, and the admitted capabilities for the status\n45|// provider conditional.\n46|type RecoveryDeps struct {\n47|\tBindings *axpane.Store\n48|\tEngine   *terminstance.Engine\n49|\tAdmitted terminalbackend.Admitted\n50|}\n51|\n52|// RecoveryVerdict is the recovery decision: the outcome, the recorded\n53|// binding and adopted backend state for the child, and the retry\n54|// disposition. Absence and the child both carry replay_same (run or\n55|// re-run the one operation); unavailable carries status_first.\n56|type RecoveryVerdict struct {\n57|\tOutcome    RecoveryOutcome\n58|\tBinding    axpane.Binding\n59|\tHasBinding bool\n60|\tState      terminalbackend.InstanceState\n61|\tRetry      terminstance.RetryDisposition\n62|}\n63|\n64|// RecoverCreate recovers a lost create result by bootstrap operation ID\n65|// from the durable (session_id, bootstrap_operation_id) binding plus one\n66|// status read. It is read-only: it binds nothing and emits nothing.\n67|//\n68|//   - A changed operation inside the bootstrap window refuses\n69|//     idempotency_mismatch; outside the window a new pair proceeds.\n70|//   - No binding plus a status that proves absent yields absence with\n71|//     replay_same: creating under this pair is safe.\n72|//   - A binding plus an identity-matching status yields the ONE recorded\n73|//     child with replay_same: reattach to it, or (when the backend shows\n74|//     absent) re-run the same operation for the same recorded instance,\n75|//     never a second child.\n76|//   - Every other shape yields unavailable with status_first: a\n77|//     contradiction (binding without a backend match), the creating\n78|//     interim, a backend-reported unavailable, or a live backend instance\n79|//     under an unbound pair (unadoptable: it cannot be proven ours).\n80|//\n81|// A binding read failure or a status read failure is an error, never\n82|// absence: unknown is not absent.\n83|func RecoverCreate(ctx context.Context, deps RecoveryDeps, request RecoveryRequest) (RecoveryVerdict, error) {\n84|\tempty := RecoveryVerdict{}\n85|\tif deps.Bindings == nil {\n86|\t\treturn empty, errors.New(\"recovery carries no bootstrap binding store\")\n87|\t}\n88|\tif deps.Engine == nil {\n89|\t\treturn empty, errors.New(\"recovery carries no status engine\")\n90|\t}\n91|\tbinding, found, err := deps.Bindings.Lookup(request.SessionID, request.BootstrapOperationID)\n92|\tif err != nil {\n93|\t\treturn empty, err\n94|\t}\n95|\tif !found {\n96|\t\tanchor, anchored, err := deps.Bindings.Status(request.SessionID)\n97|\t\tif err != nil {\n98|\t\t\treturn empty, err\n99|\t\t}\n100|\t\tif anchored && anchor.OperationID != request.BootstrapOperationID && request.WindowOpen {\n101|\t\t\treturn empty, &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \"bootstrap binding\"}\n102|\t\t}\n103|\t}\n104|\tbody, err := recoveryStatusBody(request, binding, found)\n105|\tif err != nil {\n106|\t\treturn empty, err\n107|\t}\n108|\treport, err := deps.Engine.ExecuteStatus(ctx, body, \"\", deps.Admitted)\n109|\tif err != nil {\n110|\t\treturn empty, err\n111|\t}\n112|\tif !found {\n113|\t\tif report.IdentityMatch && report.State == terminalbackend.StateAbsent {\n114|\t\t\treturn RecoveryVerdict{Outcome: RecoveryAbsent, State: report.State, Retry: terminstance.DispositionReplaySame}, nil\n115|\t\t}\n116|\t\treturn RecoveryVerdict{Outcome: RecoveryUnavailable, State: report.State, Retry: terminstance.DispositionStatusFirst}, nil\n117|\t}\n118|\tif !report.IdentityMatch {\n119|\t\treturn RecoveryVerdict{Outcome: RecoveryUnavailable, State: report.State, Retry: terminstance.DispositionStatusFirst}, nil\n120|\t}\n121|\tswitch report.State {\n122|\tcase terminalbackend.StateCreating, terminalbackend.StateUnavailable:\n123|\t\treturn RecoveryVerdict{Outcome: RecoveryUnavailable, State: report.State, Retry: terminstance.DispositionStatusFirst}, nil\n124|\tdefault:\n125|\t\treturn RecoveryVerdict{Outcome: RecoveryChild, Binding: binding, HasBinding: true, State: report.State, Retry: terminstance.DispositionReplaySame}, nil\n126|\t}\n127|}\n128|\n129|// recoveryStatusBody builds the recovery status read: the exact-instance\n130|// lookup over the recorded binding when the pair is bound, else the\n131|// session-scoped lookup that can prove absence. The host-local generation\n132|// passes through the landed bound gate; the deadline parses through the\n133|// scalar owner.\n134|func recoveryStatusBody(request RecoveryRequest, binding axpane.Binding, found bool) (terminstance.StatusBody, error) {\n135|\tempty := terminstance.StatusBody{}\n136|\tdeadline, err := scalar.ParseTimestamp(request.DeadlineAt)\n137|\tif err != nil {\n138|\t\treturn empty, err\n139|\t}\n140|\tbody := terminstance.StatusBody{\n141|\t\tSessionID:                  request.SessionID,\n142|\t\tTerminalBackendID:          request.BackendID,\n143|\t\tImplementationVersion:      request.ImplementationVersion,\n144|\t\tProtocolVersion:            request.ProtocolVersion,\n145|\t\tIncludeProviderObservation: request.IncludeProviderObservation,\n146|\t\tDeadline:                   deadline,\n147|\t}\n148|\tif !found {\n149|\t\treturn body, nil\n150|\t}\n151|\tif _, err := terminalbackend.GenerationDigest(request.Generation); err != nil {\n152|\t\treturn empty, err\n153|\t}\n154|\tbody.TerminalInstanceID = binding.TerminalInstanceID\n155|\tbody.HasTerminalInstanceID = true\n156|\tbody.BackendGeneration = request.Generation\n157|\tbody.HasBackendGeneration = true\n158|\treturn body, nil\n159|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c711","stream":{"kind":"session","id":"01a0b3fc-2962-7bc0-91c2-787ae4899fa1"},"sequence":483,"recorded_at":1780531400000961,"record_type":"event","durability":"durable","causation_id":"6cf4561a-8326-47da-a916-4850b6a43e2a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"6cf4561a-8326-47da-a916-4850b6a43e2a","run_stream":{"kind":"run","id":"6cf4561a-8326-47da-a916-4850b6a43e2a"},"call_id":"call_01a0b3fd5ce97459a210785b689ea953","text":"Read text file `internal/termbind/emit.go`.\n1|package termbind\n2|\n3|import (\n4|\t\"time\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n9|)\n10|\n11|// Terminal event types and schema version from Section 5.2. The literals\n12|// are asserted at the emission entries, not referenced from the axpane\n13|// owner, so a drift between the two fails here.\n14|const (\n15|\teventTerminalCreated = \"terminal.created\"\n16|\teventSessionResumed  = \"session.resumed\"\n17|\teventSchemaV4        = \"4.0.0\"\n18|)\n19|\n20|// EvidenceAdmission carries the local evidence admission inputs: the\n21|// backend registry, the host-local evidence universe, the host-local raw\n22|// backend generation (never written to the event), the clock, and the\n23|// caller-supplied signature verifier.\n24|type EvidenceAdmission struct {\n25|\tRegistry      *terminalbackend.Registry\n26|\tUniverse      EvidenceUniverse\n27|\tRawGeneration string\n28|\tNow           time.Time\n29|\tVerify        terminalbackend.SignatureVerifier\n30|}\n31|\n32|// EmitTerminalCreated authors one Session Event 4.0.0 terminal.created\n33|// event through the sessrepo owner under a lease the local host holds. The\n34|// evidence IDs resolve first through the landed admission bound to the\n35|// payload's own backend tuple; only an admitted backend authors. The\n36|// payload is built by the axpane owner and appended by the axpane Emit\n37|// entry, which gates through fencing.AuthorizeMutation and the canonical\n38|// closed-shape boundary. The binding digest travels as the opaque audit\n39|// reference: the entry takes no binding object, generation string, or\n40|// native reference, so none can reach the event bytes.\n41|func EmitTerminalCreated(repository *sessrepo.Repository, params axpane.EmitParams, facts axpane.TerminalBindingFacts, admission EvidenceAdmission) (sessrepo.EventRef, []byte, ResolvedEvidence, error) {\n42|\tempty := sessrepo.EventRef{}\n43|\tresolved, err := ResolveEvidence(facts.EvidenceIDs, tupleFromFacts(facts), admission.Registry, admission.Universe, admission.RawGeneration, admission.Now, admission.Verify)\n44|\tif err != nil {\n45|\t\treturn empty, nil, ResolvedEvidence{}, err\n46|\t}\n47|\tpayload, err := axpane.TerminalCreatedPayload(facts)\n48|\tif err != nil {\n49|\t\treturn empty, nil, ResolvedEvidence{}, err\n50|\t}\n51|\tparams.EventType = eventTerminalCreated\n52|\tparams.SchemaVersion = eventSchemaV4\n53|\tparams.Payload = payload\n54|\treference, raw, err := axpane.Emit(repository, params)\n55|\tif err != nil {\n56|\t\treturn empty, nil, ResolvedEvidence{}, err\n57|\t}\n58|\treturn reference, raw, resolved, nil\n59|}\n60|\n61|// EmitResumed authors one Session Event 4.0.0 session.resumed event through\n62|// the same admission and lease authority as EmitTerminalCreated. The\n63|// checkpoint, execution profile, and nullable profile source arrive from\n64|// the caller (the effective Section 2.4 pair the decision carries); the\n65|// terminal binding and evidence members resolve and append exactly as the\n66|// created event does.\n67|func EmitResumed(repository *sessrepo.Repository, params axpane.EmitParams, checkpointID, profile, source string, hasSource bool, facts axpane.TerminalBindingFacts, admission EvidenceAdmission) (sessrepo.EventRef, []byte, ResolvedEvidence, error) {\n68|\tempty := sessrepo.EventRef{}\n69|\tresolved, err := ResolveEvidence(facts.EvidenceIDs, tupleFromFacts(facts), admission.Registry, admission.Universe, admission.RawGeneration, admission.Now, admission.Verify)\n70|\tif err != nil {\n71|\t\treturn empty, nil, ResolvedEvidence{}, err\n72|\t}\n73|\tpayload, err := axpane.ResumedPayload(checkpointID, profile, source, hasSource, facts)\n74|\tif err != nil {\n75|\t\treturn empty, nil, ResolvedEvidence{}, err\n76|\t}\n77|\tparams.EventType = eventSessionResumed\n78|\tparams.SchemaVersion = eventSchemaV4\n79|\tparams.Payload = payload\n80|\treference, raw, err := axpane.Emit(repository, params)\n81|\tif err != nil {\n82|\t\treturn empty, nil, ResolvedEvidence{}, err\n83|\t}\n84|\treturn reference, raw, resolved, nil\n85|}\n86|\n87|// tupleFromFacts derives the event tuple from the payload's own backend\n88|// members, so resolution always binds the resolved objects to the tuple\n89|// the emitted event carries. No second tuple is expressible.\n90|func tupleFromFacts(facts axpane.TerminalBindingFacts) EventTuple {\n91|\treturn EventTuple{\n92|\t\tBackendID:             facts.BackendID,\n93|\t\tImplementationVersion: facts.ImplementationVersion,\n94|\t\tProtocolVersion:       facts.ProtocolVersion,\n95|\t}\n96|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
