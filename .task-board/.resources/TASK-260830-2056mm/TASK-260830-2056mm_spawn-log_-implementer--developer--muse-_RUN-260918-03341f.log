ng.T, transport string, inputAuthorized bool) []byte {\n540|\tt.Helper()\n541|\treturn attachAuth(t, transport, inputAuthorized, \"2026-08-19T04:00:00.000Z\", \"2026-08-19T06:00:00.000Z\")\n542|}\n543|\n544|// --- binding fixtures ---\n545|\n546|func bindingDoc(t *testing.T, mutate func(object map[string]any)) []byte {\n547|\tt.Helper()\n548|\tobject := map[string]any{\n549|\t\t\"schema\":                 BindingSchema,\n550|\t\t\"schema_version\":         BindingSchemaVersion,\n551|\t\t\"binding_id\":             \"\",\n552|\t\t\"session_id\":             fixtureSession,\n553|\t\t\"host_id\":                fixtureLocalHost,\n554|\t\t\"host_incarnation_id\":    \"0198f4c8-4a10-7b22-8b3c-1234567890ad\",\n555|\t\t\"terminal_instance_id\":   fixtureInstance,\n556|\t\t\"terminal_backend_id\":    terminalbackend.BuiltinTmux,\n557|\t\t\"implementation_version\": fixtureImpl,\n558|\t\t\"protocol_version\":       fixtureProto,\n559|\t\t\"backend_generation\":     fixtureRawGen,\n560|\t\t\"native_reference\":       \"tmux-session-payments-0\",\n561|\t\t\"created_at\":             fixtureCreatedAt,\n562|\t\t\"supersedes_binding_id\":  nil,\n563|\t\t\"extensions\":             map[string]any{},\n564|\t}\n565|\tif mutate != nil {\n566|\t\tmutate(object)\n567|\t}\n568|\tif _, present := object[\"binding_id\"]; present {\n569|\t\tif id, ok := object[\"binding_id\"].(string); ok && id == \"\" {\n570|\t\t\tobject[\"binding_id\"] = omitSelfIdentity(t, object, \"binding_id\")\n571|\t\t}\n572|\t}\n573|\traw, err := json.Marshal(object)\n574|\tif err != nil {\n575|\t\tt.Fatal(err)\n576|\t}\n577|\treturn raw\n578|}\n579|\n580|func digestHex(raw []byte) string {\n581|\tsum := sha256.Sum256(raw)\n582|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n583|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
