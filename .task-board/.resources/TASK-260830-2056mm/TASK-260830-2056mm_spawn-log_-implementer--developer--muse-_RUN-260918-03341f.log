, want newest authoritative source %s\\\", source, want.Source)\\n\\t}\\n\\treturn nil\\n}\\n\\n// CheckBridgeProfile binds one observed bridge profile — the\\ninternal/axpane/doc.go:42:// (DecodeRecord, DecodeEvent, Derive, DeriveForHeads) with Section\\ninternal/axpane/decide.go:279:\\t// closure (DeriveForHeads), never the session head, so a\\n\",\n  \"original_output_bytes\": 2817,\n  \"original_output_tokens\": 705,\n  \"truncated\": false\n}","final_result":true}}}
