{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca55","stream":{"kind":"session","id":"01a0b3fc-2962-7bc0-91c2-787ae4899fa1"},"sequence":901,"recorded_at":1780531400001797,"record_type":"event","durability":"durable","causation_id":"6cf4561a-8326-47da-a916-4850b6a43e2a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"6cf4561a-8326-47da-a916-4850b6a43e2a","run_stream":{"kind":"run","id":"6cf4561a-8326-47da-a916-4850b6a43e2a"},"call_id":"call_01a0b3ffa7e77501bbfe59c7cb58fa4a","text":"Read text file `internal/termbind/recover_test.go`.\n1|package termbind\n2|\n3|import (\n4|\t\"context\"\n5|\t\"errors\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n13|)\n14|\n15|func bindPair(t *testing.T, store *axpane.Store, sessionID, operationID, instanceID string) axpane.Binding {\n16|\tt.Helper()\n17|\tbound, _, err := store.Bind(sessionID, operationID, axpane.Binding{\n18|\t\tSessionID:          sessionID,\n19|\t\tOperationID:        operationID,\n20|\t\tTerminalInstanceID: instanceID,\n21|\t\tBindingDigest:      seedDigest(0xB1),\n22|\t})\n23|\tif err != nil {\n24|\t\tt.Fatalf(\"Bind() error = %v\", err)\n25|\t}\n26|\treturn bound\n27|}\n28|\n29|func recoveryRequest(operationID string, windowOpen bool) RecoveryRequest {\n30|\treturn RecoveryRequest{\n31|\t\tSessionID:             fixtureSession,\n32|\t\tBootstrapOperationID:  operationID,\n33|\t\tWindowOpen:            windowOpen,\n34|\t\tBackendID:             terminalbackend.BuiltinTmux,\n35|\t\tImplementationVersion: fixtureImpl,\n36|\t\tProtocolVersion:       fixtureProto,\n37|\t\tGeneration:            fixtureRawGen,\n38|\t\tDeadlineAt:            fixtureDeadline,\n39|\t}\n40|}\n41|\n42|func exactObservation(state terminalbackend.InstanceState, match bool) terminstance.StatusObservation {\n43|\tobserved := terminstance.StatusObservation{\n44|\t\tState:         state,\n45|\t\tIdentityMatch: match,\n46|\t\tSessionID:     fixtureSession,\n47|\t\tInstanceID:    fixtureInstance,\n48|\t\tBackendID:     terminalbackend.BuiltinTmux,\n49|\t\tImplVersion:   fixtureImpl,\n50|\t\tProtoVersion:  fixtureProto,\n51|\t\tGeneration:    fixtureRawGen,\n52|\t}\n53|\tif match {\n54|\t\tobserved.WrapperPresent = state == terminalbackend.StateParked || state == terminalbackend.StateActive || state == terminalbackend.StateQuiescing\n55|\t} else {\n56|\t\tobserved.InstanceID = \"0198f4c9-9999-7eee-8eee-1234567890ab\"\n57|\t}\n58|\treturn observed\n59|}\n60|\n61|func sessionObservation(state terminalbackend.InstanceState, sessionID string) terminstance.StatusObservation {\n62|\treturn terminstance.StatusObservation{\n63|\t\tState:         state,\n64|\t\tIdentityMatch: sessionID == fixtureSession,\n65|\t\tSessionID:     sessionID,\n66|\t\tInstanceID:    fixtureInstance,\n67|\t\tBackendID:     terminalbackend.BuiltinTmux,\n68|\t\tImplVersion:   fixtureImpl,\n69|\t\tProtoVersion:  fixtureProto,\n70|\t\tGeneration:    fixtureRawGen,\n71|\t}\n72|}\n73|\n74|func recoverWith(t *testing.T, store *axpane.Store, observe func(terminstance.StatusBody) (terminstance.StatusObservation, error), request RecoveryRequest) (RecoveryVerdict, error) {\n75|\tt.Helper()\n76|\tdeps := RecoveryDeps{Bindings: store, Engine: testEngine(&mockBackend{observe: observe})}\n77|\treturn RecoverCreate(context.Background(), deps, request)\n78|}\n79|\n80|func TestRecoverCreateProvesAbsence(t *testing.T) {\n81|\tt.Parallel()\n82|\tstore, err := axpane.Open(t.TempDir())\n83|\tif err != nil {\n84|\t\tt.Fatal(err)\n85|\t}\n86|\tverdict, err := recoverWith(t, store, func(terminstance.StatusBody) (terminstance.StatusObservation, error) {\n87|\t\treturn sessionObservation(terminalbackend.StateAbsent, fixtureSession), nil\n88|\t}, recoveryRequest(fixtureBootstrap, true))\n89|\tif err != nil {\n90|\t\tt.Fatalf(\"RecoverCreate() error = %v\", err)\n91|\t}\n92|\tif verdict.Outcome != RecoveryAbsent || verdict.Retry != terminstance.DispositionReplaySame {\n93|\t\tt.Fatalf(\"verdict = %+v, want absent with replay_same\", verdict)\n94|\t}\n95|\tif verdict.HasBinding {\n96|\t\tt.Fatalf(\"verdict carries a binding for proven absence: %+v\", verdict)\n97|\t}\n98|}\n99|\n100|func TestRecoverCreateIdentifiesOneChild(t *testing.T) {\n101|\tt.Parallel()\n102|\tfor _, state := range []terminalbackend.InstanceState{terminalbackend.StateActive, terminalbackend.StateParked} {\n103|\t\tt.Run(string(state), func(t *testing.T) {\n104|\t\t\tt.Parallel()\n105|\t\t\tstore, err := axpane.Open(t.TempDir())\n106|\t\t\tif err != nil {\n107|\t\t\t\tt.Fatal(err)\n108|\t\t\t}\n109|\t\t\tbound := bindPair(t, store, fixtureSession, fixtureBootstrap, fixtureInstance)\n110|\t\t\tverdict, err := recoverWith(t, store, func(terminstance.StatusBody) (terminstance.StatusObservation, error) {\n111|\t\t\t\treturn exactObservation(state, true), nil\n112|\t\t\t}, recoveryRequest(fixtureBootstrap, true))\n113|\t\t\tif err != nil {\n114|\t\t\t\tt.Fatalf(\"RecoverCreate() error = %v\", err)\n115|\t\t\t}\n116|\t\t\tif verdict.Outcome != RecoveryChild || !verdict.HasBinding {\n117|\t\t\t\tt.Fatalf(\"verdict = %+v, want the one child\", verdict)\n118|\t\t\t}\n119|\t\t\tif verdict.Binding != bound {\n120|\t\t\t\tt.Fatalf(\"verdict binding = %+v, want %+v\", verdict.Binding, bound)\n121|\t\t\t}\n122|\t\t\tif verdict.State != state || verdict.Retry != terminstance.DispositionReplaySame {\n123|\t\t\t\tt.Fatalf(\"verdict = %+v, want state %q with replay_same\", verdict, string(state))\n124|\t\t\t}\n125|\t\t})\n126|\t}\n127|}\n128|\n129|func TestRecoverCreateDuplicateRetrySameVerdict(t *testing.T) {\n130|\tt.Parallel()\n131|\tstore, err := axpane.Open(t.TempDir())\n132|\tif err != nil {\n133|\t\tt.Fatal(err)\n134|\t}\n135|\tbindPair(t, store, fixtureSession, fixtureBootstrap, fixtureInstance)\n136|\tobserve := func(terminstance.StatusBody) (terminstance.StatusObservation, error) {\n137|\t\treturn exactObservation(terminalbackend.StateActive, true), nil\n138|\t}\n139|\tfirst, err := recoverWith(t, store, observe, recoveryRequest(fixtureBootstrap, true))\n140|\tif err != nil {\n141|\t\tt.Fatal(err)\n142|\t}\n143|\tsecond, err := recoverWith(t, store, observe, recoveryRequest(fixtureBootstrap, true))\n144|\tif err != nil {\n145|\t\tt.Fatal(err)\n146|\t}\n147|\tif first != second {\n148|\t\tt.Fatalf(\"retry verdict = %+v, want %+v\", second, first)\n149|\t}\n150|}\n151|\n152|func TestRecoverCreateChangedOperationInWindowRefuses(t *testing.T) {\n153|\tt.Parallel()\n154|\trepository, _ := chainFixture(t)\n155|\thasNewest, _ := foldNewest(t, repository)\n156|\tif hasNewest {\n157|\t\tt.Fatal(\"bootstrap chain folds a newest checkpoint, want the open window\")\n158|\t}\n159|\tstore, err := axpane.Open(t.TempDir())\n160|\tif err != nil {\n161|\t\tt.Fatal(err)\n162|\t}\n163|\tbindPair(t, store, fixtureSession, fixtureBootstrap, fixtureInstance)\n164|\t_, err = recoverWith(t, store, func(terminstance.StatusBody) (terminstance.StatusObservation, error) {\n165|\t\tt.Fatal(\"status runs past the window mismatch\")\n166|\t\treturn terminstance.StatusObservation{}, nil\n167|\t}, recoveryRequest(fixtureOtherOp, !hasNewest))\n168|\trequireCode(t, err, \"idempotency_mismatch\")\n169|}\n170|\n171|func checkpointChain(t *testing.T) *sessrepo.Repository {\n172|\tt.Helper()\n173|\trepository, _ := chainFixture(t)\n174|\ttail := chainTail(t, repository)\n175|\tnext := int(tail.LeaseSequence) + 1\n176|\tpredecessor := tail.EventID\n177|\tsteps := []struct {\n178|\t\teventType string\n179|\t\tpayload   map[string]any\n180|\t}{\n181|\t\t{\"terminal.created\", map[string]any{\"backend\": \"tmux\", \"terminal_id\": \"tmux-session-1\"}},\n182|\t\t{\"provider.launched\", map[string]any{\n183|\t\t\t\"provider_id\": \"codex\", \"provider_version\": \"0.147.0\",\n184|\t\t\t\"execution_profile\": \"standard\", \"profile_source_event_id\": nil,\n185|\t\t\t\"profile_mapping\": \"default\",\n186|\t\t}},\n187|\t\t{\"provider.identified\", map[string]any{\"provider_identity_record_id\": seedDigest(0xD1), \"confidence\": \"exact\"}},\n188|\t\t{\"session.idle\", map[string]any{\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true}},\n189|\t\t{\"session.quiescing\", map[string]any{\"operation_id\": fixtureBootstrap, \"reason\": \"checkpoint\", \"input_blocked\": true}},\n190|\t\t{\"checkpoint.created\", map[string]any{\"checkpoint_id\": seedDigest(0xC1), \"kind\": \"manual\"}},\n191|\t}\n192|\tfor _, step := range steps {\n193|\t\tpredecessor = appendEvent(t, repository, \"1.0.0\", step.eventType, 1, fixtureLeaseA, next, predecessor, step.payload)\n194|\t\tnext++\n195|\t}\n196|\treturn repository\n197|}\n198|\n199|func TestRecoverCreateChangedOperationPostWindowProceeds(t *testing.T) {\n200|\tt.Parallel()\n201|\trepository := checkpointChain(t)\n202|\thasNewest, _ := foldNewest(t, repository)\n203|\tif !hasNewest {\n204|\t\tt.Fatal(\"checkpoint chain folds no newest, want the closed window\")\n205|\t}\n206|\tstore, err := axpane.Open(t.TempDir())\n207|\tif err != nil {\n208|\t\tt.Fatal(err)\n209|\t}\n210|\tbindPair(t, store, fixtureSession, fixtureBootstrap, fixtureInstance)\n211|\tverdict, err := recoverWith(t, store, func(terminstance.StatusBody) (terminstance.StatusObservation, error) {\n212|\t\treturn sessionObservation(terminalbackend.StateAbsent, fixtureSession), nil\n213|\t}, recoveryRequest(fixtureOtherOp, !hasNewest))\n214|\tif err != nil {\n215|\t\tt.Fatalf(\"RecoverCreate(post-window) error = %v\", err)\n216|\t}\n217|\tif verdict.Outcome != RecoveryAbsent {\n218|\t\tt.Fatalf(\"verdict = %+v, want absence for the new post-window pair\", verdict)\n219|\t}\n220|}\n221|\n222|func TestRecoverCreateLostResult(t *testing.T) {\n223|\tt.Parallel()\n224|\t// The lost create result: the durable binding committed before the\n225|\t// first child side effect, the backend committed the effect, and the\n226|\t// result never reached the caller (dropped here to model the crash\n227|\t// between effect and result). Recovery must identify the ONE recorded\n228|\t// child, never a second one.\n229|\tstore, err := axpane.Open(t.TempDir())\n230|\tif err != nil {\n231|\t\tt.Fatal(err)\n232|\t}\n233|\tbound := bindPair(t, store, fixtureSession, fixtureBootstrap, fixtureInstance)\n234|\tcommitted := exactObservation(terminalbackend.StateActive, true)\n235|\t_ = committed\n236|\tverdict, err := recoverWith(t, store, func(terminstance.StatusBody) (terminstance.StatusObservation, error) {\n237|\t\treturn exactObservation(terminalbackend.StateActive, true), nil\n238|\t}, recoveryRequest(fixtureBootstrap, true))\n239|\tif err != nil {\n240|\t\tt.Fatalf(\"RecoverCreate() error = %v\", err)\n241|\t}\n242|\tif verdict.Outcome != RecoveryChild || verdict.Binding.TerminalInstanceID != bound.TerminalInstanceID {\n243|\t\tt.Fatalf(\"verdict = %+v, want the one recorded child %+v\", verdict, bound)\n244|\t}\n245|}\n246|\n247|func TestRecoverCreateNeverClaimsAbsent(t *testing.T) {\n248|\tt.Parallel()\n249|\tcases := []struct {\n250|\t\tname    string\n251|\t\tbound   bool\n252|\t\tobserve func() terminstance.StatusObservation\n253|\t\tverdict RecoveryOutcome\n254|\t}{\n255|\t\t{\"bound contradiction\", true, func() terminstance.StatusObservation {\n256|\t\t\treturn exactObservation(terminalbackend.StateAbsent, false)\n257|\t\t}, RecoveryUnavailable},\n258|\t\t{\"creating interim\", true, func() terminstance.StatusObservation {\n259|\t\t\treturn exactObservation(terminalbackend.StateCreating, true)\n260|\t\t}, RecoveryUnavailable},\n261|\t\t{\"backend unavailable\", true, func() terminstance.StatusObservation {\n262|\t\t\treturn exactObservation(terminalbackend.StateUnavailable, true)\n263|\t\t}, RecoveryUnavailable},\n264|\t\t{\"unbound live instance\", false, func() terminstance.StatusObservation {\n265|\t\t\treturn sessionObservation(terminalbackend.StateActive, fixtureSession)\n266|\t\t}, RecoveryUnavailable},\n267|\t\t{\"unbound session drift\", false, func() terminstance.StatusObservation {\n268|\t\t\treturn sessionObservation(terminalbackend.StateAbsent, \"0198f4c8-8e50-7f66-8f70-1234567890ab\")\n269|\t\t}, RecoveryUnavailable},\n270|\t}\n271|\tfor _, testCase := range cases {\n272|\t\tt.Run(testCase.name, func(t *testing.T) {\n273|\t\t\tt.Parallel()\n274|\t\t\tstore, err := axpane.Open(t.TempDir())\n275|\t\t\tif err != nil {\n276|\t\t\t\tt.Fatal(err)\n277|\t\t\t}\n278|\t\t\tif testCase.bound {\n279|\t\t\t\tbindPair(t, store, fixtureSession, fixtureBootstrap, fixtureInstance)\n280|\t\t\t}\n281|\t\t\tverdict, err := recoverWith(t, store, func(terminstance.StatusBody) (terminstance.StatusObservation, error) {\n282|\t\t\t\treturn testCase.observe(), nil\n283|\t\t\t}, recoveryRequest(fixtureBootstrap, true))\n284|\t\t\tif err != nil {\n285|\t\t\t\tt.Fatalf(\"RecoverCreate() error = %v\", err)\n286|\t\t\t}\n287|\t\t\tif verdict.Outcome != testCase.verdict || verdict.Retry != terminstance.DispositionStatusFirst {\n288|\t\t\t\tt.Fatalf(\"verdict = %+v, want unavailable with status_first\", verdict)\n289|\t\t\t}\n290|\t\t})\n291|\t}\n292|}\n293|\n294|func TestRecoverCreateRecordedChildBackendAbsentReplays(t *testing.T) {\n295|\tt.Parallel()\n296|\t// The binding committed but the backend shows absent: the effect never\n297|\t// committed or the backend lost it. The binding still identifies the\n298|\t// ONE child, so the same operation replays for the same recorded\n299|\t// instance instead of minting a second one.\n300|\tstore, err := axpane.Open(t.TempDir())\n301|\tif err != nil {\n302|\t\tt.Fatal(err)\n303|\t}\n304|\tbound := bindPair(t, store, fixtureSession, fixtureBootstrap, fixtureInstance)\n305|\tverdict, err := recoverWith(t, store, func(terminstance.StatusBody) (terminstance.StatusObservation, error) {\n306|\t\treturn exactObservation(terminalbackend.StateAbsent, true), nil\n307|\t}, recoveryRequest(fixtureBootstrap, true))\n308|\tif err != nil {\n309|\t\tt.Fatalf(\"RecoverCreate() error = %v\", err)\n310|\t}\n311|\tif verdict.Outcome != RecoveryChild || verdict.Binding != bound || verdict.Retry != terminstance.DispositionReplaySame {\n312|\t\tt.Fatalf(\"verdict = %+v, want the recorded child with replay_same\", verdict)\n313|\t}\n314|}\n315|\n316|func TestRecoverCreateUnknownIsNotAbsent(t *testing.T) {\n317|\tt.Parallel()\n318|\tt.Run(\"status read failure\", func(t *testing.T) {\n319|\t\tt.Parallel()\n320|\t\tstore, err := axpane.Open(t.TempDir())\n321|\t\tif err != nil {\n322|\t\t\tt.Fatal(err)\n323|\t\t}\n324|\t\t_, err = recoverWith(t, store, func(terminstance.StatusBody) (terminstance.StatusObservation, error) {\n325|\t\t\treturn terminstance.StatusObservation{}, errors.New(\"backend read failed\")\n326|\t\t}, recoveryRequest(fixtureBootstrap, true))\n327|\t\tif err == nil || !strings.Contains(err.Error(), \"terminal_backend_unavailable\") {\n328|\t\t\tt.Fatalf(\"RecoverCreate() error = %v, want the unknown-read refusal\", err)\n329|\t\t}\n330|\t})\n331|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
