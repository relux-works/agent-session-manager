{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c695","stream":{"kind":"session","id":"01a0b3fc-2962-7bc0-91c2-787ae4899fa1"},"sequence":421,"recorded_at":1780531400000837,"record_type":"event","durability":"durable","causation_id":"6cf4561a-8326-47da-a916-4850b6a43e2a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6cf4561a-8326-47da-a916-4850b6a43e2a","run_stream":{"kind":"run","id":"6cf4561a-8326-47da-a916-4850b6a43e2a"},"task_stream":{"kind":"task","id":"01a0b3fd-4694-7770-9901-908cf034b951"},"task_id":"01a0b3fd-4694-7770-9901-908cf034b951","event":{"kind":"output","task_id":"01a0b3fd-4694-7770-9901-908cf034b951","chunk":"Read text file `/tmp/tb2056/rev2ev/probes/review2_mutants.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Reviewer narrowing mutants for CR-TASK-260830-2056mm-2 (RUN-260918-acd5a8).\n3|\n4|Runs against the isolated copy given as argv[1] (default ./cand-m). Every\n5|row mutates one production file in place, runs the WHOLE committed\n6|internal/termbind suite (not only a named killer) so a survivor is a\n7|survivor against everything the producer committed, restores the file\n8|from a backup, and prints the verdict with the subprocess exit. Raw\n9|per-plant output is written under logs/rv2-mutants-pass<N>/<row>.log.\n10|\n11|Usage: PYTHONDONTWRITEBYTECODE=1 python3 review2_mutants.py <copy> <pass>\n12|\"\"\"\n13|\n14|import shutil\n15|import subprocess\n16|import sys\n17|import tempfile\n18|from dataclasses import dataclass\n19|from pathlib import Path\n20|\n21|\n22|@dataclass(frozen=True)\n23|class Mutant:\n24|    name: str\n25|    path: str\n26|    find: str\n27|    replace: str\n28|    kind: str\n29|    note: str\n30|\n31|\n32|PKG = \"internal/termbind\"\n33|\n34|MUTANTS = [\n35|    Mutant(\n36|        name=\"RV2-M3-binding-protocol-major-widen\",\n37|        path=f\"{PKG}/identity.go\",\n38|        find='\\tif !environ.CheckSemver(protocol) {\\n\\t\\treturn empty, protocolRefusal(\"binding protocol version\")\\n\\t}\\n',\n39|        replace='\\tif !environ.CheckSemver(protocol) && protocol != \"2.0.0\" {\\n\\t\\treturn empty, protocolRefusal(\"binding protocol version\")\\n\\t}\\n',\n40|        kind=\"narrowing\",\n41|        note=\"Admits exactly protocol 2.0.0 past the semver arm. Equivalent to the shipped code (no major-1 arm exists), so SURVIVED is expected and is the finding, not the mutant.\",\n42|    ),\n43|    Mutant(\n44|        name=\"RV2-M4-native-ref-513\",\n45|        path=f\"{PKG}/identity.go\",\n46|        find='\\tif _, ok := environ.CheckStringBounds(members[\"native_reference\"], 1, 512); !ok {\\n',\n47|        replace='\\tif _, ok := environ.CheckStringBounds(members[\"native_reference\"], 1, 513); !ok {\\n',\n48|        kind=\"narrowing (bound widened by one)\",\n49|        note=\"Admits exactly the 513-character native reference.\",\n50|    ),\n51|    Mutant(\n52|        name=\"RV2-M5-supersedes-any-string\",\n53|        path=f\"{PKG}/identity.go\",\n54|        find='\\t\\tif _, err := scalar.ParseDigest(supersedes); err != nil {\\n\\t\\t\\treturn empty, protocolRefusal(\"binding supersedes\")\\n\\t\\t}\\n',\n55|        replace='\\t\\tif _, err := scalar.ParseDigest(supersedes); err != nil && supersedes != \"not-a-digest\" {\\n\\t\\t\\treturn empty, protocolRefusal(\"binding supersedes\")\\n\\t\\t}\\n',\n56|        kind=\"narrowing (member check dropped for one member)\",\n57|        note=\"Admits exactly one non-digest supersedes_binding_id value.\",\n58|    ),\n59|    Mutant(\n60|        name=\"RV2-M6-resolve-manifest-impl-arm\",\n61|        path=f\"{PKG}/resolve.go\",\n62|        find=\"\\tif manifest.TerminalBackendID != tuple.BackendID || manifest.ImplementationVersion != tuple.ImplementationVersion {\\n\",\n63|        replace=\"\\tif manifest.TerminalBackendID != tuple.BackendID {\\n\",\n64|        kind=\"narrowing (member check dropped)\",\n65|        note=\"Drops the manifest implementation-version arm of the event binding; the landed admission may or may not catch the same member.\",\n66|    ),\n67|    Mutant(\n68|        name=\"RV2-M7-recover-absent-ignores-identity\",\n69|        path=f\"{PKG}/recover.go\",\n70|        find=\"\\t\\tif report.IdentityMatch && report.State == terminalbackend.StateAbsent {\\n\",\n71|        replace=\"\\t\\tif report.State == terminalbackend.StateAbsent {\\n\",\n72|        kind=\"narrowing (member check dropped)\",\n73|        note=\"Claims absence from an absent report that names another session (identity match dropped on the unbound arm).\",\n74|    ),\n75|    Mutant(\n76|        name=\"RV2-M8-recover-unavailable-as-child\",\n77|        path=f\"{PKG}/recover.go\",\n78|        find=\"\\tcase terminalbackend.StateCreating, terminalbackend.StateUnavailable:\\n\",\n79|        replace=\"\\tcase terminalbackend.StateCreating:\\n\",\n80|        kind=\"narrowing (one state admitted)\",\n81|        note=\"Reports a backend-unavailable observation as the ONE child with replay_same.\",\n82|    ),\n83|    Mutant(\n84|        name=\"RV2-M9-recover-generation-bound-skipped\",\n85|        path=f\"{PKG}/recover.go\",\n86|        find=\"\\tif _, err := terminalbackend.GenerationDigest(request.Generation); err != nil {\\n\\t\\treturn empty, err\\n\\t}\\n\",\n87|        replace=\"\\tif _, err := terminalbackend.GenerationDigest(request.Generation); err != nil && len(request.Generation) != 257 {\\n\\t\\treturn empty, err\\n\\t}\\n\",\n88|        kind=\"narrowing (pre-read revalidation skipped for one member)\",\n89|        note=\"Skips the generation bound exactly for a 257-character generation before the status read.\",\n90|    ),\n91|    Mutant(\n92|        name=\"RV2-M10-attach-lookup-session-unbound\",\n93|        path=f\"{PKG}/attach.go\",\n94|        find='\\tif receipt.SessionID != sessionID {\\n\\t\\treturn empty, false, errors.New(\"attach receipt names another session\")\\n\\t}\\n',\n95|        replace='\\tif receipt.SessionID != sessionID && sessionID != \"0198f4c8-8e50-7f66-8f70-1234567890ab\" {\\n\\t\\treturn empty, false, errors.New(\"attach receipt names another session\")\\n\\t}\\n',\n96|        kind=\"narrowing (one member admitted)\",\n97|        note=\"Lookup admits exactly one foreign session over a recorded receipt.\",\n98|    ),\n99|    Mutant(\n100|        name=\"RV2-M11-evidence-unsorted-first-pair\",\n101|        path=f\"{PKG}/resolve.go\",\n102|        find=\"\\t\\tif index > 0 && id <= previous {\\n\",\n103|        replace=\"\\t\\tif index > 1 && id <= previous {\\n\",\n104|        kind=\"narrowing (unsorted array admitted at one position)\",\n105|        note=\"Admits an evidence_ids array whose only inversion is between the first two members (the shipped N-evidence-unsorted twin, replanted by the reviewer).\",\n106|    ),\n107|    Mutant(\n108|        name=\"RV2-K-known-kill\",\n109|        path=f\"{PKG}/identity.go\",\n110|        find='\\tif _, err := scalar.ParseUUIDv7(value); err != nil {\\n\\t\\treturn &terminalbackend.Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminal instance identity\"}\\n\\t}\\n',\n111|        replace='\\tif _, err := scalar.ParseUUIDv7(value); err != nil && value != \"12345\" {\\n\\t\\treturn &terminalbackend.Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminal instance identity\"}\\n\\t}\\n',\n112|        kind=\"control (known kill, shipped N-identity-pid)\",\n113|        note=\"Harness control: must be KILLED.\",\n114|    ),\n115|    Mutant(\n116|        name=\"RV2-C-comment\",\n117|        path=f\"{PKG}/doc.go\",\n118|        find=\"// Package termbind writes versioned terminal binding events, recovers\\n\",\n119|        replace=\"// Package termbind writes versioned terminal binding events (reviewer control), recovers\\n\",\n120|        kind=\"control (harmless)\",\n121|        note=\"Harness control: comment-only edit must SURVIVE.\",\n122|    ),\n123|]\n124|\n125|\n126|def main(argv):\n127|    copy = Path(argv[0] if argv else \"cand-m\").resolve()\n128|    pass_no = argv[1] if len(argv) > 1 else \"1\"\n129|    logdir = Path(__file__).resolve().parent / \"logs\" / f\"rv2-mutants-pass{pass_no}\"\n130|    logdir.mkdir(parents=True, exist_ok=True)\n131|    failures = 0\n132|    for mutant in MUTANTS:\n133|        target = copy / mutant.path\n134|        original = target.read_text()\n135|        found = original.count(mutant.find)\n136|        if found != 1:\n137|            print(f\"ERROR: {mutant.name}: anchors={found}, want 1\", flush=True)\n138|            failures += 1\n139|            continue\n140|        with tempfile.TemporaryDirectory() as staging:\n141|            backup = Path(staging) / \"backup\"\n142|            shutil.copy2(target, backup)\n143|            try:\n144|                target.write_text(original.replace(mutant.find, mutant.replace))\n145|                run = subprocess.run(\n146|                    [\"go\", \"test\", f\"./{PKG}/\", \"-count=1\"],\n147|                    cwd=copy, capture_output=True, text=True, timeout=600,\n148|                )\n149|            finally:\n150|                shutil.copy2(backup, target)\n151|        output = (run.stdout + run.stderr).strip()\n152|        (logdir / f\"{mutant.name}.log\").write_text(\n153|            f\"# {mutant.name} [{mutant.kind}] exit {run.returncode}\\n# {mutant.note}\\n# --- find ---\\n{mutant.find}# --- replace ---\\n{mutant.replace}# --- raw ---\\n{output}\\n\")\n154|        if \"build failed\" in output or output.startswith(\"# \") or \"\\n# \" in output:\n155|            verdict = \"ERROR(build broke)\"\n156|        elif run.returncode == 0:\n157|            verdict = \"SURVIVED\"\n158|        elif \"--- FAIL\" in output or \"FAIL:\" in output:\n159|            verdict = \"KILLED\"\n160|        else:\n161|            verdict = f\"ERROR(exit {run.returncode}, no kill line)\"\n162|        killers = sorted({line.split()[2] for line in output.splitlines() if line.startswith(\"--- FAIL: \")})\n163|        print(f\"{mutant.name}: {verdict} [exit {run.returncode}] kind={mutant.kind} killers={','.join(killers) if killers else '-'} :: {mutant.note}\", flush=True)\n164|        if verdict.startswith(\"ERROR\"):\n165|            failures += 1\n166|    after = subprocess.run([\"go\", \"test\", f\"./{PKG}/\", \"-count=1\"], cwd=copy, capture_output=True, text=True)\n167|    print(f\"post-run pristine suite exit {after.returncode}\", flush=True)\n168|    return 1 if failures else 0\n169|\n170|\n171|if __name__ == \"__main__\":\n172|    sys.exit(main(sys.argv[1:]))","final_result":true}}}
