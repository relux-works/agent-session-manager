  4668	  "schema": "urn:ax:schema:chunk",
  4669	  "schema_version": "1.0.0",
  4670	  "blob_id": "sha256:9c21bad65c1b3d0403ac85d7d5bd134bb8d894432702a396a77b0477b8eb3b50",
  4671	  "index": 0,
  4672	  "offset": 0,
  4673	  "size": 11,
  4674	  "chunk_id": "sha256:9c21bad65c1b3d0403ac85d7d5bd134bb8d894432702a396a77b0477b8eb3b50"
  4675	}
