	runner := assemblyIntercept{input: func(ctx context.Context, dir string, input []byte, args []string) (GitResult, error) {
		result, err := (ExecGitRunner{}).RunInput(ctx, dir, input, args...)
		if err := os.Chmod(objects, 0755); err != nil {
