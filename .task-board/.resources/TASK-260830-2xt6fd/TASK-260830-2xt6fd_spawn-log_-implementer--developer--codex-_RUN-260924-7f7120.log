import json
from collections import Counter
from pathlib import Path

ROOT = Path('.temp/TASK-260830-2xt6fd')
groups = {
    'provhost': ('importer-provhost-suite-base.jsonl', 'importer-provhost-suite-candidate.jsonl'),
    'direct provhost importers': ('importer-direct-importers-base.jsonl', 'importer-direct-importers-candidate.jsonl'),
    'traceability + tracecheck': ('importer-traceability-suite-base.jsonl', 'importer-traceability-suite-candidate.jsonl'),
    'tmuxserver': ('importer-tmuxserver-suite-base.jsonl', 'importer-tmuxserver-suite-candidate.jsonl'),
}

def read(path):
    result = {}
    packages = set()
    for line in (ROOT / path).read_text().splitlines():
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        if event.get('Action') in {'pass', 'fail', 'skip'} and event.get('Test'):
            key = (event.get('Package', ''), event['Test'])
            result[key] = event['Action']
        if event.get('Action') in {'pass', 'fail', 'skip'} and not event.get('Test'):
            packages.add(event.get('Package', ''))
    result = {k:v for k,v in result.items() if not k[1].startswith('TestTaskImporter')}
    return result, packages

lines = ['# Independent importer outcome comparison (TASK-260830-2xt6fd)', '',
         'Base: `6d3bff999f75ed8585a7ef32074ab108f364ec51`; candidate: exact tree `13a8375c0e98fc5dec425389532d6d4e22417959` (source snapshot before task-scoped probe files).', '',
         'Shared keyed test outcomes compare `(package, test/input)`. A status move means pass/fail/skip changed for a shared test key. Added/removed keys are reported separately and are not inferred as status movements.', '',
         '| Importer package set | Base package runs | Candidate package runs | Shared test keys | Status moves | Base-only keys | Candidate-only keys |',
         '|---|---:|---:|---:|---:|---:|---:|']
all_moves=[]
for name, (bfile,cfile) in groups.items():
    b,bpkgs=read(bfile); c,cpkgs=read(cfile)
    shared=set(b)&set(c)
    moves=sorted((k,b[k],c[k]) for k in shared if b[k]!=c[k])
    bo=sorted(set(b)-set(c)); co=sorted(set(c)-set(b))
    lines.append(f'| {name} | {len(bpkgs)} | {len(cpkgs)} | {len(shared)} | {len(moves)} | {len(bo)} | {len(co)} |')
    for key, old, new in moves:
        all_moves.append(f'- `{key[0]}::{key[1]}`: {old} → {new}')
    if bo or co:
        lines += ['', f'### Test key additions/removals — {name}', '']
        if bo:
            lines.append('Base-only: ' + ', '.join(f'`{pkg}::{test}`' for pkg,test in bo))
        if co:
            lines.append('Candidate-only: ' + ', '.join(f'`{pkg}::{test}`' for pkg,test in co))
if all_moves:
    lines += ['', '### Shared test status movements', '', *all_moves]
else:
    lines += ['', '### Shared test status movements', '', 'None: every shared named test key has the same status.']

# Append import graph result over the affected packages.
def parse_importers(path):
    prefix='github.com/relux-works/agent-session-manager/'
    targets=['internal/gitsnap','internal/provhost','internal/tmuxserver','internal/traceability']
    out={}
    for line in (ROOT/path).read_text().splitlines():
        pkg,sep,imports=line.partition('|')
        if not sep: continue
        pkg=pkg.split(' [',1)[0].removesuffix('.test')
        imps={i.split(' [',1)[0].removesuffix('.test') for i in imports.split(',')}
        out.setdefault(pkg,set()).update(imps)
    data={}
    for target in targets:
        key=prefix+target
        data[target]=sorted(p for p,imps in out.items() if key in imps and p!=key)
    return data
bg=parse_importers('importer-graph-trunk-base.log'); cg=parse_importers('importer-graph-candidate.log')
lines += ['', '### Direct importer graph', '', '| Touched package | Trunk importers | Candidate importers | Added | Removed |', '|---|---|---|---|---|']
for key in bg:
    b=bg[key]; c=cg[key]
    lines.append(f'| `internal/{key.split("/")[-1]}` | {", ".join(x.rsplit("/",1)[-1] for x in b) or "(none)"} | {", ".join(x.rsplit("/",1)[-1] for x in c) or "(none)"} | {", ".join(x.rsplit("/",1)[-1] for x in sorted(set(c)-set(b))) or "(none)"} | {", ".join(x.rsplit("/",1)[-1] for x in sorted(set(b)-set(c))) or "(none)"} |')
lines += ['', '### Behavioral outcomes by production entry', '',
          '- `gitsnap.AssembleProvisional` and `Lifecycle.CaptureGitWorkspace` are absent at trunk; candidate package suites and the exact 22-row capture admission matrix pass. The base outcome is entry-absent, not inferred refusal.',
          '- `provhost.CheckIdentity` malformed self-digest probe passes on both trunk and candidate; candidate retains the documented shape-only behavior.',
          '- `UnixDialer.Dial` for ENOENT under an absent parent changes from `stale` (trunk injected probe, expected exit 1) to `unknown` (candidate `TestUnixDialerMissingDirectoryIsUnknown`, exit 0). The first long-absolute-path probe hit the Unix path-length error and is excluded; the corrected short-relative fixture lives under the task scratch copy.',
          '- `tracecheck` output changes with the Story registry: 160→163 acceptance cases, 70→73 bindings, 81/585→106/597 discharged normative clauses. This is the registered three-leaf coverage change.',
          '- The candidate `internal/gitsnap` package is new at trunk; its complete package suite exits 0.']
(ROOT/'importer-outcome-comparison-rev4.md').write_text('\n'.join(lines)+'\n')
print('\n'.join(lines[:20]))
print(f'\nSummary saved to {ROOT}/importer-outcome-comparison-rev4.md')

