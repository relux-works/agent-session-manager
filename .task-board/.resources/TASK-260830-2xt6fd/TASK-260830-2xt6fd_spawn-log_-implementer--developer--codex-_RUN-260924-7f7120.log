+import csv
+import json
+from collections import defaultdict
+from pathlib import Path
+
+root = Path('.temp/TASK-260830-2xt6fd')
+groups = [
+    ('internal/provhost', 'provhost', True),
+    ('internal/axpane', 'axpane', True),
+    ('internal/resumesmoke', 'resumesmoke', True),
+    ('internal/sessquery', 'sessquery', True),
+    ('internal/tmuxserver', 'tmuxserver', True),
+    ('internal/traceability', 'traceability', True),
+    ('internal/traceability/cmd/tracecheck', 'tracecheck', True),
+]
+
+def read(prefix):
+    tests = {}
+    package = None
+    for line in (root / f'importer-refresh-{prefix}.jsonl').read_text().splitlines():
+        event = json.loads(line)
+        if event.get('Action') in {'pass', 'fail', 'skip'}:
+            if event.get('Test'):
+                key = (event.get('Package', ''), event['Test'])
+                tests[key] = event['Action']
+            else:
+                package = event['Action']
+    return tests, package
+
+base_all, candidate_all = {}, {}
+package_rows = []
+grid_rows = []
+for package, stem, exists_base in groups:
+    base, bp = read(f'{stem}-base')
+    candidate, cp = read(f'{stem}-candidate')
+    base_all.update({k:v for k,v in base.items() if not k[1].startswith('TestTaskImporter')})
+    candidate_all.update({k:v for k,v in candidate.items() if not k[1].startswith('TestTaskImporter')})
+    b = {k:v for k,v in base.items() if not k[1].startswith('TestTaskImporter')}
+    c = {k:v for k,v in candidate.items() if not k[1].startswith('TestTaskImporter')}
+    shared = set(b) & set(c)
+    moves = sorted((key, b[key], c[key]) for key in shared if b[key] != c[key])
+    base_only = sorted(set(b) - set(c))
+    candidate_only = sorted(set(c) - set(b))
+    package_rows.append((package, bp, cp, len(shared), len(moves), len(base_only), len(candidate_only), moves, base_only, candidate_only))
+    for key in sorted(set(b) | set(c)):
+        grid_rows.append((key[0], key[1], b.get(key, 'absent'), c.get(key, 'absent'),
+                          'same' if key in shared and b[key] == c[key] else
+                          'status-moved' if key in shared else
+                          'candidate-only' if key in c else 'base-only'))
+
+with (root / 'importer-outcome-grid-refresh.csv').open('w', newline='') as f:
+    writer = csv.writer(f)
+    writer.writerow(['package', 'production-entry-test-input', 'base-action', 'candidate-action', 'movement'])
+    writer.writerows(grid_rows)
+
+lines = [
+    '# Importer outcome comparison — refreshed exact snapshots', '',
+    'Base source: `origin/main` commit `5b7876be29cf578ff02583660d77fc10944e855c`.',
+    'Candidate source: staged scratch-index tree `e36c3a076fd183288a9dc3a6ca0dfe1150514774` from the uncommitted Story worktree delta over two refreshed Story checkpoints.',
+    'All package runs used Go `GOWORK=off`, `GOTOOLCHAIN=local`, the same task-scoped `HOME` and shared Go build cache, `TMPDIR` unset, `go test -json -count=1`; each raw JSON log is named below. Grid keys are `(package, named production-entry test/input)`; subtests remain distinct keys in the CSV.', '',
+    '| Package / production importer set | Base suite | Candidate suite | Shared test keys | Status moves | Base-only | Candidate-only |',
+    '|---|---:|---:|---:|---:|---:|---:|'
+]
+for package, bp, cp, shared_count, moved_count, base_only_count, candidate_only_count, *_ in package_rows:
+    lines.append(f'| `{package}` | {bp or "missing/failed"} | {cp or "missing/failed"} | {shared_count} | {moved_count} | {base_only_count} | {candidate_only_count} |')
+
+lines += ['', '## Runtime class movements', '']
+all_moved = []
+for package, bp, cp, _, _, _, _, moves, base_only, candidate_only in package_rows:
+    if moves:
+        for (key, old, new) in moves:
+            all_moved.append((package, key[1], old, new))
+    if base_only or candidate_only:
+        def top_names(rows):
+            return sorted({key[1].split('/', 1)[0] for key in rows})
+        lines += [f'### `{package}` test-key membership', '',
+                  f'- Base-only test keys: {len(base_only)}; top-level names: ' + (', '.join(f'`{v}`' for v in top_names(base_only)) or '(none)'),
+                  f'- Candidate-only test keys: {len(candidate_only)}; top-level names: ' + (', '.join(f'`{v}`' for v in top_names(candidate_only)) or '(none)'), '']
+if all_moved:
+    lines += ['### Shared-key status moves', '']
+    for package, key, old, new in all_moved:
+        lines.append(f'- `{package}::{key}`: `{old}` → `{new}`.')
+else:
+    lines += ['No shared test key changed status.', '']
+
+lines += [
+    '## Entry-level interpretation', '',
+    '- `internal/gitsnap`: absent from base package discovery (46 packages); candidate adds it (47 packages). The candidate full `gitsnap` suite passed. Its `Capture` and `AssembleProvisional` entry classes have no base runtime outcome and are reported as new, not as inferred baseline refusals.',
+    '- `internal/tmuxserver`, `UnixDialer.Dial`, ENOENT beneath a missing parent: base full suite exits 1 at `TestUnixDialerMissingDirectoryIsUnknown` (`stale`, wanted `unknown`); candidate full suite exits 0. This is the only shared-key status movement in the comparison and is the intended fail-closed correction for a failed parent observation under §4.C.',
+    '- `internal/tmuxserver`, `(*Lifecycle).CaptureGitWorkspace`: new candidate production entry; candidate full suite is green. The exact capture admission tests and mutants are separately logged in the evidence pack.',
+    '- `internal/provhost`, `CheckIdentity`, and the unchanged direct production consumers `axpane`, `resumesmoke`, and `sessquery`: all shared named test keys retain their status. Candidate-only identity/callsite census additions are listed above and do not change the shape-only identity contract.',
+    '- `internal/traceability` and `internal/traceability/cmd/tracecheck`: candidate-only registry decode/coverage tests are listed above; shared test keys retain their status and the candidate tracecheck output is pinned to the re-derived digest.',
+    '',
+    'The base `internal/gitsnap` package suite was not run because `go list ./...` showed that the package did not exist at base; a direct attempted `go test ./internal/gitsnap` exited 1 with “directory not found” and is retained as `importer-refresh-gitsnap-base.jsonl`.',
+    '',
+    'Direct importer graph: `importer-refresh-graph.md`. Complete per-key status comparison: `importer-outcome-grid-refresh.csv`.'
+]
+(root / 'importer-outcome-comparison-refresh.md').write_text('\n'.join(lines) + '\n')
+print('\n'.join(lines))
