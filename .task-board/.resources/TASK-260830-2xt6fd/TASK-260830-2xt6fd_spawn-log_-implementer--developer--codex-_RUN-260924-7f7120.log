-func capturePackageRefusalDetails(t *testing.T) []string {
-	t.Helper()
-	entries, err := os.ReadDir(".")
-	if err != nil {
-		t.Fatal(err)
-	}
-	byName := map[string][]captureAdmissionFunction{}
-	var roots []captureAdmissionFunction
-	fset := token.NewFileSet()
-	for _, entry := range entries {
-		name := entry.Name()
-		if entry.IsDir() || filepath.Ext(name) != ".go" || strings.HasSuffix(name, "_test.go") {
-			continue
-		}
-		file, err := parser.ParseFile(fset, name, nil, 0)
-		if err != nil {
-			t.Fatalf("parse production Go source %s: %v", name, err)
-		}
-		imports := make(map[string]struct{}, len(file.Imports))
-		for _, spec := range file.Imports {
-			path, err := strconv.Unquote(spec.Path.Value)
-			if err != nil {
-				t.Fatalf("parse import path in %s: %v", name, err)
-			}
-			alias := filepath.Base(path)
-			if spec.Name != nil {
-				alias = spec.Name.Name
-			}
-			if alias != "_" && alias != "." {
-				imports[alias] = struct{}{}
-			}
-		}
-		for _, declaration := range file.Decls {
-			function, ok := declaration.(*ast.FuncDecl)
-			if !ok || function.Body == nil {
-				continue
-			}
-			item := captureAdmissionFunction{decl: function, imports: imports}
-			byName[function.Name.Name] = append(byName[function.Name.Name], item)
-			if function.Name.Name == "CaptureGitWorkspace" {
-				roots = append(roots, item)
-			}
-		}
-	}
-	if len(roots) != 1 {
-		t.Fatalf("production source has %d CaptureGitWorkspace roots, want one", len(roots))
-	}
-	var details []string
-	visited := map[token.Pos]bool{}
-	pending := []captureAdmissionFunction{roots[0]}
-	for len(pending) > 0 {
-		current := pending[0]
-		pending = pending[1:]
-		if visited[current.decl.Pos()] {
-			continue
-		}
-		visited[current.decl.Pos()] = true
-		ast.Inspect(current.decl.Body, func(node ast.Node) bool {
-			call, ok := node.(*ast.CallExpr)
-			if !ok {
-				return true
-			}
-			if ident, ok := call.Fun.(*ast.Ident); ok && ident.Name == "captureUnavailable" {
-				if len(call.Args) != 1 {
-					t.Errorf("%s captureUnavailable site has %d args, want one literal detail", current.decl.Name.Name, len(call.Args))
-					return true
-				}
-				literal, ok := call.Args[0].(*ast.BasicLit)
-				if !ok || literal.Kind != token.STRING {
-					t.Errorf("%s captureUnavailable site has non-literal detail %T", current.decl.Name.Name, call.Args[0])
-					return true
-				}
-				detail, err := strconv.Unquote(literal.Value)
-				if err != nil {
-					t.Errorf("%s captureUnavailable detail %q is invalid: %v", current.decl.Name.Name, literal.Value, err)
-					return true
-				}
-				details = append(details, detail)
-			}
-			for _, name := range captureCallNames(call, current.imports) {
-				pending = append(pending, byName[name]...)
-			}
-			return true
-		})
-	}
-	return details
-}
-
-func captureCallNames(call *ast.CallExpr, imports map[string]struct{}) []string {
-	expression := call.Fun
-	for {
-		switch indexed := expression.(type) {
-		case *ast.IndexExpr:
-			expression = indexed.X
-		case *ast.IndexListExpr:
-			expression = indexed.X
-		default:
-			goto resolved
-		}
-	}
-resolved:
-	switch function := expression.(type) {
-	case *ast.Ident:
-		return []string{function.Name}
-	case *ast.SelectorExpr:
-		if receiver, ok := function.X.(*ast.Ident); ok {
-			if _, imported := imports[receiver.Name]; imported {
-				return nil
-			}
-		}
-		return []string{function.Sel.Name}
-	default:
-		return nil
-	}
-}
-
-func captureAdmissionMatrixRows(t *testing.T) map[string]string {
-	t.Helper()
-	testFile, err := parser.ParseFile(token.NewFileSet(), "capture_git_workspace_test.go", nil, 0)
-	if err != nil {
-		t.Fatal(err)
-	}
-	rows := map[string]string{}
-	for _, declaration := range testFile.Decls {
-		function, ok := declaration.(*ast.FuncDecl)
-		if !ok || function.Body == nil || !strings.HasPrefix(function.Name.Name, "TestCaptureAdmission_") {
-			continue
-		}
-		entries := 0
-		assertions := 0
-		ast.Inspect(function.Body, func(node ast.Node) bool {
-			call, ok := node.(*ast.CallExpr)
-			if !ok {
-				return true
-			}
-			if selector, ok := call.Fun.(*ast.SelectorExpr); ok && selector.Sel.Name == "CaptureGitWorkspace" {
-				entries++
-			}
-			ident, ok := call.Fun.(*ast.Ident)
-			if !ok || ident.Name != "requireCaptureRefusal" {
-				return true
-			}
-			assertions++
-			if len(call.Args) != 4 {
-				t.Errorf("matrix test %s has a refusal assertion with %d args, want four", function.Name.Name, len(call.Args))
-				return true
-			}
-			code, codeOK := captureLiteralString(call.Args[2])
-			detail, detailOK := captureLiteralString(call.Args[3])
-			if !codeOK || code != "capability_unavailable" || !detailOK {
-				t.Errorf("matrix test %s must assert literal capability_unavailable code and literal detail", function.Name.Name)
-				return true
-			}
-			if prior, exists := rows[detail]; exists {
-				t.Errorf("matrix detail %q is claimed by both %s and %s", detail, prior, function.Name.Name)
-			} else {
-				rows[detail] = function.Name.Name
-			}
-			return true
-		})
-		if entries != 1 || assertions != 1 {
-			t.Errorf("matrix test %s has %d production entry calls and %d literal refusal assertions, want one each", function.Name.Name, entries, assertions)
-		}
-	}
-	if len(rows) == 0 {
-		t.Fatal("no TestCaptureAdmission_ matrix rows found")
-	}
-	return rows
-}
-
-func captureLiteralString(expression ast.Expr) (string, bool) {
-	literal, ok := expression.(*ast.BasicLit)
-	if !ok || literal.Kind != token.STRING {
-		return "", false
-	}
-	value, err := strconv.Unquote(literal.Value)
-	return value, err == nil
-}
