  --format json       Standard JSON (default)
  --format compact    Compact tabular output (~40% fewer tokens)
                      plan() switches to the super-compact planning shape:
                      flat waves of IDs, one-line critical path, id->status map

Examples:
  task-board q 'schema()'
  task-board q 'get(TASK-260211-abc) { id status assignee }'
  task-board q 'activity(TASK-260211-abc, limit=25, order=descending, view=effective)'
  task-board q 'list(type=task, status=development) { overview }'
  task-board q 'count(type=task, status=done)'
  task-board q 'summary()'
  task-board q 'summary() { observability-project }'
  task-board q 'get(STORY-1) { observability-story }'
  task-board q 'models()'
  task-board q 'models(agent=claude)'
  task-board q 'project_config()'
  task-board q 'provider_limits()'
