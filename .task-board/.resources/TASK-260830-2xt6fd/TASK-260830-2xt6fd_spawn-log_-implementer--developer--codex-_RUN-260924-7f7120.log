import ast,re,pathlib
src=pathlib.Path('internal/tmuxserver/mutant_harness.py').read_text()
tree=ast.parse(src); rows=[]
for n in ast.walk(tree):
 if isinstance(n,ast.Call) and isinstance(n.func,ast.Name) and n.func.id=='Mutant':
  kw={k.arg:k.value for k in n.keywords if k.arg}
  if isinstance(kw.get('name'),ast.Constant) and str(kw['name'].value).startswith('N-capture-admits-'):
   def val(k):
    v=kw.get(k)
    if isinstance(v,ast.Constant): return v.value
    if isinstance(v,ast.Name):
     for x in ast.walk(tree):
      if isinstance(x,ast.Assign) and any(isinstance(t,ast.Name) and t.id==v.id for t in x.targets):
       try: return ast.literal_eval(x.value)
       except: return v.id
     return v.id
    return ast.unparse(v) if v else ''
   rows.append((val('name'),val('run'),val('note')))
