func TestTaskImporterComparisonCheckIdentityMismatchedSelfDigest(t *testing.T) {
  const claimed = "sha256:c879d766da67a8cfb3a3f6eae2234faa5d52d8df987496eae2218f40e5e220c2"
  raw := []byte(strings.Replace(string(specIdentityExample), claimed, "sha256:"+strings.Repeat("0", 64), 1))
  if _, _, err := canonicaljson.VerifyObjectIdentity(raw); err == nil { t.Fatal("control self-digest unexpectedly verifies") }
