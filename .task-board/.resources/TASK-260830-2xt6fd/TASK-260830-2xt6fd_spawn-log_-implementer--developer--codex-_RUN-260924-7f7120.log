		seenClause := false
		for _, group := range registry.Ownership {
			if group.Kind != ownershipSectionBinding {
				continue
			}
			for _, clause := range group.Clauses {
				for _, owner := range clause.AcceptanceCases {
					if owner == id {
						seenClause = true
					}
				}
			}
		}

