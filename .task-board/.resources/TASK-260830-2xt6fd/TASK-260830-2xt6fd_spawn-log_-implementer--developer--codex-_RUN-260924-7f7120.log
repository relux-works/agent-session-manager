index 0000000000000000000000000000000000000000..a8e0df041aeb3911c38a7058137040e13e81eb44
--- /dev/null
+++ b/.temp/TASK-260830-2xt6fd/compare-importer-graphs-refresh.py
@@ -0,0 +1,29 @@
+from pathlib import Path
+
+root = Path('.temp/TASK-260830-2xt6fd')
+prefix = 'github.com/relux-works/agent-session-manager/'
+targets = ['internal/gitsnap', 'internal/provhost', 'internal/tmuxserver', 'internal/traceability']
+
+def parse(path):
+    imports = {}
+    for line in (root / path).read_text().splitlines():
+        package, sep, imports_text = line.partition('|')
+        if not sep:
+            raise ValueError(f'bad go list row: {line!r}')
+        imports[package] = set(imports_text.split(',')) if imports_text else set()
+    return imports
+
+base = parse('importer-refresh-base-imports.txt')
+candidate = parse('importer-refresh-candidate-imports.txt')
+out = ['# Production importer graph (refreshed comparison)', '',
+       '| Touched package | Base direct importers | Candidate direct importers | Added | Removed |',
+       '|---|---|---|---|---|']
+for target in targets:
+    full = prefix + target
+    bi = sorted(pkg for pkg, values in base.items() if full in values and pkg != full)
+    ci = sorted(pkg for pkg, values in candidate.items() if full in values and pkg != full)
+    added, removed = sorted(set(ci) - set(bi)), sorted(set(bi) - set(ci))
+    short = lambda values: ', '.join(v.removeprefix(prefix) for v in values) or '(none)'
+    out.append(f'| `{target}` | {short(bi)} | {short(ci)} | {short(added)} | {short(removed)} |')
+(root / 'importer-refresh-graph.md').write_text('\n'.join(out) + '\n')
+print('\n'.join(out))
