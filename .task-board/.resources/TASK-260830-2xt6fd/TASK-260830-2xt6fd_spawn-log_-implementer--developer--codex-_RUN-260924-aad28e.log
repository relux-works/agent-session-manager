+			assertions++
+			if len(call.Args) != 4 {
+				t.Errorf("matrix test %s has a refusal assertion with %d args, want four", function.Name.Name, len(call.Args))
+				return true
+			}
+			code, codeOK := captureLiteralString(call.Args[2])
+			detail, detailOK := captureLiteralString(call.Args[3])
+			if !codeOK || code != "capability_unavailable" || !detailOK {
+				t.Errorf("matrix test %s must assert literal capability_unavailable code and literal detail", function.Name.Name)
+				return true
+			}
+			if prior, exists := rows[detail]; exists {
+				t.Errorf("matrix detail %q is claimed by both %s and %s", detail, prior, function.Name.Name)
+			} else {
+				rows[detail] = function.Name.Name
+			}
 			return true
 		})
-		if !hasEntry || !hasCode || !hasDetail {
-			t.Errorf("gate row %q test %s lacks production-entry call or literal refusal code/detail", row.kind, row.testName)
+		if entries != 1 || assertions != 1 {
+			t.Errorf("matrix test %s has %d production entry calls and %d literal refusal assertions, want one each", function.Name.Name, entries, assertions)
 		}
-		return
 	}
-	t.Errorf("gate row %q has no named test %s", row.kind, row.testName)
+	if len(rows) == 0 {
+		t.Fatal("no TestCaptureAdmission_ matrix rows found")
+	}
+	return rows
+}
+
+func captureLiteralString(expression ast.Expr) (string, bool) {
+	literal, ok := expression.(*ast.BasicLit)
+	if !ok || literal.Kind != token.STRING {
+		return "", false
+	}
+	value, err := strconv.Unquote(literal.Value)
+	return value, err == nil
+}
+
+func captureInitialStateFixture(t *testing.T, state terminalbackend.InstanceState) (*lxFixture, GitWorkspaceCaptureRequest) {
+	t.Helper()
+	fx, request := captureValidRequestForState(t, terminalbackend.StateQuiescing)
+	if state == terminalbackend.StateCreating {
+		recordCaptureStateFixture(t, fx, state)
+	} else if err := fx.lc.States.Record(lxInstance, state); err != nil {
+		t.Fatal(err)
+	}
+	queueCaptureStateObservation(fx, state)
+	return fx, request
+}
+
+func captureBoundaryBodyWithContextMember(t *testing.T, raw []byte, member, value string) []byte {
+	t.Helper()
+	var body map[string]any
+	if err := json.Unmarshal(raw, &body); err != nil {
+		t.Fatal(err)
+	}
+	context, ok := body["context"].(map[string]any)
+	if !ok {
+		t.Fatal("boundary fixture has no context object")
+	}
+	context[member] = value
+	updated, err := json.Marshal(body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return updated
+}
