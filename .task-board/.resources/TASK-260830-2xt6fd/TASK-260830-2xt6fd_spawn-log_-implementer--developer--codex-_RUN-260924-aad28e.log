+	mutatingRunner := &capturePhaseRunner{afterPack: func() {
+		if err := fx.lc.States.RecordIncarnation(lxInstance, lxQuiesceKey()); err != nil {
+			t.Errorf("change closing incarnation: %v", err)
+		}
+	}}
