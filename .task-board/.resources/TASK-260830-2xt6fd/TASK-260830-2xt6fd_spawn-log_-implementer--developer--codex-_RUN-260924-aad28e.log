   827	func TestCaptureCoordinatorAdmissionGateCensus(t *testing.T) {
   828		production, err := parser.ParseFile(token.NewFileSet(), "capture_git_workspace.go", nil, 0)
   829		if err != nil {
   830			t.Fatal(err)
   831		}
   832		var method *ast.FuncDecl
   833		for _, declaration := range production.Decls {
   834			if function, ok := declaration.(*ast.FuncDecl); ok && function.Name.Name == "CaptureGitWorkspace" {
   835				method = function
   836				break
   837			}
   838		}
   839		if method == nil {
   840			t.Fatal("production capture entry is missing")
   841		}
   842		observed := map[string]string{}
   843		ast.Inspect(method.Body, func(node ast.Node) bool {
   844			branch, ok := node.(*ast.IfStmt)
   845			if !ok {
   846				return true
   847			}
   848			kind := captureAdmissionGateKind(branch.Cond)
   849			if kind == "" {
   850				return true
   851			}
   852			details := captureUnavailableDetails(branch.Body)
   853			if len(details) != 1 {
   854				t.Errorf("coordinator admission site %q has %d direct refusal sites, want one matrix row", kind, len(details))
   855				return true
   856			}
   857			if _, exists := observed[kind]; exists {
   858				t.Errorf("coordinator admission kind %q occurs more than once", kind)
   859			}
   860			observed[kind] = details[0]
   861			return true
   862		})
   863		rows := captureAdmissionGateRows()
   864		if len(observed) != len(rows) {
   865			t.Fatalf("coordinator admission census found %d sites, matrix has %d rows: %#v", len(observed), len(rows), observed)
   866		}
   867		for _, row := range rows {
   868			if observed[row.kind] != row.detail {
   869				t.Errorf("matrix row %q detail=%q, production refusal detail=%q", row.kind, row.detail, observed[row.kind])
   870			}
   871			assertCaptureGateTestDrivesEntry(t, row)
   872		}
   873	}
   874	
   875	func captureAdmissionGateKind(condition ast.Expr) string {
   876		hasSelector := func(receiver, field string) bool {
   877			found := false
   878			ast.Inspect(condition, func(node ast.Node) bool {
   879				selector, ok := node.(*ast.SelectorExpr)
   880				if !ok || selector.Sel.Name != field {
   881					return true
   882				}
   883				if receiver == "" {
   884					found = true
   885					return false
   886				}
   887				base, ok := selector.X.(*ast.Ident)
   888				if ok && base.Name == receiver {
   889					found = true
   890					return false
   891				}
   892				return true
   893			})
   894			return found
   895		}
   896		hasIdent := func(want string) bool {
   897			found := false
   898			ast.Inspect(condition, func(node ast.Node) bool {
   899				ident, ok := node.(*ast.Ident)
   900				if ok && ident.Name == want {
   901					found = true
   902					return false
   903				}
   904				return true
   905			})
   906			return found
   907		}
   908		switch {
   909		case hasSelector("", "ProviderProofKind"):
   910			return "provider-proof-kind"
   911		case hasSelector("quiesce", "Incarnation"):
   912			return "quiesce-receipt-incarnation"
   913		case hasIdent("proven"):
   914			return "closing-barrier"
   915		case hasIdent("final") && hasIdent("StateStopped"):
   916			return "stopped-closing-state"
   917		default:
   918			return ""
   919		}
   920	}
   921	
   922	func captureUnavailableDetails(body *ast.BlockStmt) []string {
   923		var details []string
   924		ast.Inspect(body, func(node ast.Node) bool {
   925			call, ok := node.(*ast.CallExpr)
   926			if !ok {
   927				return true
   928			}
   929			ident, ok := call.Fun.(*ast.Ident)
   930			if !ok || ident.Name != "captureUnavailable" || len(call.Args) != 1 {
   931				return true
   932			}
   933			literal, ok := call.Args[0].(*ast.BasicLit)
   934			if !ok || literal.Kind != token.STRING {
   935				details = append(details, "<non-literal>")
   936				return true
   937			}
   938			detail, err := strconv.Unquote(literal.Value)
   939			if err != nil {
   940				details = append(details, "<invalid-literal>")
   941				return true
   942			}
   943			details = append(details, detail)
   944			return true
   945		})
   946		return details
   947	}
