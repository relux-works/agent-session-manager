   951		testFile, err := parser.ParseFile(token.NewFileSet(), "capture_git_workspace_test.go", nil, 0)
   952		if err != nil {
   953			t.Fatal(err)
   954		}
   955		for _, declaration := range testFile.Decls {
   956			function, ok := declaration.(*ast.FuncDecl)
   957			if !ok || function.Name.Name != row.testName {
   958				continue
   959			}
   960			hasEntry, hasCode, hasDetail := false, false, false
   961			ast.Inspect(function.Body, func(node ast.Node) bool {
   962				switch value := node.(type) {
   963				case *ast.SelectorExpr:
   964					if value.Sel.Name == "CaptureGitWorkspace" {
   965						hasEntry = true
   966					}
   967				case *ast.BasicLit:
   968					if value.Kind != token.STRING {
   969						break
   970					}
   971					text, err := strconv.Unquote(value.Value)
   972					if err == nil && text == "capability_unavailable" {
   973						hasCode = true
   974					}
   975					if err == nil && text == row.detail {
   976						hasDetail = true
   977					}
   978				}
   979				return true
   980			})

