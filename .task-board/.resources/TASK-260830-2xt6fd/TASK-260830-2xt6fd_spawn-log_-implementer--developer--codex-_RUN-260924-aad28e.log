			return true
		}
		kind := captureAdmissionGateKind(branch.Cond)
		if kind == "" {
			return true
		}
		details := captureUnavailableDetails(branch.Body)
		if len(details) != 1 {
			t.Errorf("coordinator admission site %q has %d direct refusal sites, want one matrix row", kind, len(details))
			return true
		}
		if _, exists := observed[kind]; exists {
			t.Errorf("coordinator admission kind %q occurs more than once", kind)
		}
		observed[kind] = details[0]
		return true
	})
	rows := captureAdmissionGateRows()
	if len(observed) != len(rows) {
		t.Fatalf("coordinator admission census found %d sites, matrix has %d rows: %#v", len(observed), len(rows), observed)
	}
	for _, row := range rows {
		if observed[row.kind] != row.detail {
			t.Errorf("matrix row %q detail=%q, production refusal detail=%q", row.kind, row.detail, observed[row.kind])
		}
		assertCaptureGateTestDrivesEntry(t, row)
	}
}

func captureAdmissionGateKind(condition ast.Expr) string {
	hasSelector := func(receiver, field string) bool {
		found := false
		ast.Inspect(condition, func(node ast.Node) bool {
			selector, ok := node.(*ast.SelectorExpr)
			if !ok || selector.Sel.Name != field {
				return true
			}
			if receiver == "" {
				found = true
				return false
			}
			base, ok := selector.X.(*ast.Ident)
			if ok && base.Name == receiver {
				found = true
				return false
			}
			return true
		})
		return found
	}
	hasIdent := func(want string) bool {
		found := false
		ast.Inspect(condition, func(node ast.Node) bool {
			ident, ok := node.(*ast.Ident)
			if ok && ident.Name == want {
				found = true
				return false
			}
			return true
		})
		return found
	}
	switch {
	case hasSelector("", "ProviderProofKind"):
		return "provider-proof-kind"
	case hasSelector("quiesce", "Incarnation"):
		return "quiesce-receipt-incarnation"
	case hasIdent("proven"):
		return "closing-barrier"
	case hasIdent("final") && hasIdent("StateStopped"):
		return "stopped-closing-state"
	default:
		return ""
	}
}

func captureUnavailableDetails(body *ast.BlockStmt) []string {
	var details []string
	ast.Inspect(body, func(node ast.Node) bool {
		call, ok := node.(*ast.CallExpr)
		if !ok {
			return true
		}
		ident, ok := call.Fun.(*ast.Ident)
		if !ok || ident.Name != "captureUnavailable" || len(call.Args) != 1 {
			return true
		}
		literal, ok := call.Args[0].(*ast.BasicLit)
		if !ok || literal.Kind != token.STRING {
			details = append(details, "<non-literal>")
			return true
		}
		detail, err := strconv.Unquote(literal.Value)
		if err != nil {
			details = append(details, "<invalid-literal>")
			return true
		}
		details = append(details, detail)
		return true
	})
	return details
}

func assertCaptureGateTestDrivesEntry(t *testing.T, row captureAdmissionGateRow) {
	t.Helper()
	testFile, err := parser.ParseFile(token.NewFileSet(), "capture_git_workspace_test.go", nil, 0)
	if err != nil {
		t.Fatal(err)
	}
	for _, declaration := range testFile.Decls {
		function, ok := declaration.(*ast.FuncDecl)
		if !ok || function.Name.Name != row.testName {
			continue
		}
		hasEntry, hasCode, hasDetail := false, false, false
		ast.Inspect(function.Body, func(node ast.Node) bool {
			switch value := node.(type) {
			case *ast.SelectorExpr:
				if value.Sel.Name == "CaptureGitWorkspace" {
					hasEntry = true
				}
			case *ast.BasicLit:
				if value.Kind != token.STRING {
					break
				}
				text, err := strconv.Unquote(value.Value)
				if err == nil && text == "capability_unavailable" {
					hasCode = true
				}
				if err == nil && text == row.detail {
					hasDetail = true
				}
			}
			return true
		})
		if !hasEntry || !hasCode || !hasDetail {
			t.Errorf("gate row %q test %s lacks production-entry call or literal refusal code/detail", row.kind, row.testName)
		}
		return
	}
	t.Errorf("gate row %q has no named test %s", row.kind, row.testName)
}

func TestCaptureRejectsParkedEvenWithPriorQuiescenceReceipt(t *testing.T) {
	fx := captureLifecycleFixture(t)
	recordCaptureBinding(t, fx, terminalbackend.StateActive)
	fx.runner.queue("lock-session", "", 0).queue("detach-client", "", 0)
	if _, err := fx.lc.Execute(context.Background(), OpRequest{
		Operation: "quiesce-input", Body: lxQuiesceBody(t, nil), Source: "active", Admitted: fullLifecycleAdmitted(),
	}); err != nil {
		t.Fatal(err)
	}
	boundaryBody := captureBoundaryBody(t, lxQuiesce, "provider_quiescence")
	fx.runner.queue("wait-for", "", 0).queue("list-panes", "sh\n", 0)
	if _, err := fx.lc.Execute(context.Background(), OpRequest{
		Operation: "wait-safe-boundary", Body: boundaryBody, Source: "quiescing", Admitted: fullLifecycleAdmitted(),
	}); err != nil {
		t.Fatal(err)
	}
	if err := fx.lc.States.Record(lxInstance, terminalbackend.StateParked); err != nil {
		t.Fatal(err)
	}
	queuePresentStatus(fx, "0")
	queuePresentStatus(fx, "0")
	runner, assembly := captureAssemblyRequest(t)
	_, err := fx.lc.CaptureGitWorkspace(context.Background(), GitWorkspaceCaptureRequest{
		StatusBody: lxStatusBody(t, true, false, nil), BoundaryBody: boundaryBody,
		Admitted: fullLifecycleAdmitted(), Runner: runner, Assembly: assembly,
	})
	var refusal *gitsnap.Refusal
	if !errors.As(err, &refusal) || string(refusal.Code) != "capability_unavailable" {
		t.Fatalf("parked source refusal = %v, want literal capability_unavailable", err)
	}
}


