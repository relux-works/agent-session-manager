   705	func captureOperationLiteral(literal *ast.CompositeLit) string {
   706		if literal == nil || !isTypeIdent(literal.Type, "OpRequest") {
   707			return ""
   708		}
   709		for _, element := range literal.Elts {
   710			field, ok := element.(*ast.KeyValueExpr)
   711			if !ok {
   712				continue
   713			}
   714			name, ok := field.Key.(*ast.Ident)
   715			if !ok || name.Name != "Operation" {
   716				continue
   717			}
   718			value, ok := field.Value.(*ast.BasicLit)
   719			if !ok || value.Kind != token.STRING {
   720				return ""
   721			}
   722			operation, err := strconv.Unquote(value.Value)
   723			if err != nil {
   724				return ""
   725			}
   726			return operation
   727		}
   728		return ""
   729	}
   730	
   731	func isTypeIdent(expression ast.Expr, name string) bool {
   732		ident, ok := expression.(*ast.Ident)
   733		return ok && ident.Name == name
   734	}
