		InstanceID:        binding.TerminalInstanceID,
		BackendID:         binding.TerminalBackendID,
		ImplVersion:       binding.ImplementationVersion,
		ProtoVersion:      binding.ProtocolVersion,
		Generation:        binding.BackendGeneration,
	}, nil

