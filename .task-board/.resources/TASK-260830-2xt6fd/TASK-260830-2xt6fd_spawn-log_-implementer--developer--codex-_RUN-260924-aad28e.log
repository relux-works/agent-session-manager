+	request.Runner = nil
+	queuePresentStatus(fx, "0")
+	_, err := fx.lc.CaptureGitWorkspace(context.Background(), request)
+	requireCaptureRefusal(t, err, "capability_unavailable", "Git assembly runner is required")
+}
