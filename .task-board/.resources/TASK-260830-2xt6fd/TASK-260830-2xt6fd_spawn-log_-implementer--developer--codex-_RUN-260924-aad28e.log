+			}
 			return true
 		})
-		if !hasEntry || !hasCode || !hasDetail {
-			t.Errorf("gate row %q test %s lacks production-entry call or literal refusal code/detail", row.kind, row.testName)
+		if entries != 1 || assertions != 1 {
+			t.Errorf("matrix test %s has %d production entry calls and %d literal refusal assertions, want one each", function.Name.Name, entries, assertions)
 		}
-		return
 	}
-	t.Errorf("gate row %q has no named test %s", row.kind, row.testName)
+	if len(rows) == 0 {
+		t.Fatal("no TestCaptureAdmission_ matrix rows found")
+	}
+	return rows
+}
