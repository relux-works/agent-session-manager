				queueFull("has-session", "", "can't find session: "+lxInstance, 1).
				queue("kill-session", "", 0)
			seen := false
			fx.runner.onRun = func(argv []string) {
				if len(argv) >= 4 && argv[3] == "has-session" && !seen {
					seen = true
					if fact == "generation" {
