+	})
+	if !errors.As(err, &refusal) || string(refusal.Code) != "capability_unavailable" {
+		t.Fatalf("missing provider proof refusal = %v, want literal capability_unavailable", err)
+	}
+	if got := fx.runner.subcommands(); len(got) != 4 {
+		t.Fatalf("missing provider proof reached another owner transition: %v", got)
+	}
+}
