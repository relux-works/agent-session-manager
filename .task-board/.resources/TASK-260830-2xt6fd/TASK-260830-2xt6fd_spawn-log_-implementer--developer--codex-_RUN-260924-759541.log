		if err != nil {
			return nil, err
		}
		wire["workspace_id"] = member.WorkspaceID
		wire["kind"] = "git"
		wire["group_relative_path"] = member.GroupRelativePath
		wire["materialization_policy"] = member.MaterializationPolicy
