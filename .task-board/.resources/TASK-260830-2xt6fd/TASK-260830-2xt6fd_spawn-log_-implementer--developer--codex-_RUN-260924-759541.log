+func TestCaptureStopPointStateDomain(t *testing.T) {
+	cases := []struct {
+		state   terminalbackend.InstanceState
+		present bool
+		active  string
+	}{
+		{"absent", false, "0"},
+		{"parked", true, "0"},
+		{"active", true, "1"},
+		{"stale_fenced", false, "0"},
+		{"unavailable", false, "0"},
+	}
+	for _, tc := range cases {
+		t.Run(string(tc.state), func(t *testing.T) {
+			fx := captureLifecycleFixture(t)
+			recordCaptureBinding(t, fx, tc.state)
+			if tc.present {
+				queuePresentStatus(fx, tc.active)
+			} else {
+				queueAbsentStatus(fx)
+			}
+			_, err := fx.lc.CaptureGitWorkspace(context.Background(), GitWorkspaceCaptureRequest{
+				StatusBody: lxStatusBody(t, true, false, nil), Admitted: fullLifecycleAdmitted(),
+			})
+			var refusal *gitsnap.Refusal
+			if !errors.As(err, &refusal) || string(refusal.Code) != "capability_unavailable" {
+				t.Fatalf("capture refusal = %v, want literal capability_unavailable", err)
+			}
+			if len(fx.runner.subcommands()) != func() int {
+				if tc.present {
+					return 2
+				}
+				return 1
+			}() {
+				t.Fatalf("disallowed state reached a later lifecycle operation: %v", fx.runner.subcommands())
+			}
+		})
+	}
+	state, _, _, _ := ClassifyStatus(ClassifyInput{Present: true, Memory: terminalbackend.StateCreating, MemoryFound: true})
+	if state != "unavailable" {
+		t.Fatalf("transient creating status projection = %q, want unavailable", state)
+	}
+}
