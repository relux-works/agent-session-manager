	GateNotRepository     = gateRegistry[0]
	GateHeadCorrupt       = gateRegistry[1]
	GateHeadRef           = gateRegistry[2]
	GateHeadOIDFormat     = gateRegistry[3]
	GateRemotesRange      = gateRegistry[4]
