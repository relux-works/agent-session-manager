	lxImpl       = "1.2.3"
	lxProto      = "1.0.0"
	lxGeneration = "generation-one"
)

func lxNow() time.Time {
	now, err := time.Parse(time.RFC3339Nano, "2026-09-01T12:00:00.000Z")
	if err != nil {
		panic(err)
	}
	return now
