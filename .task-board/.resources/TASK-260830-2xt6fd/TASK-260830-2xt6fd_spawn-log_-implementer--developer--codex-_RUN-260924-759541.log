+		StatusBody: lxStatusBody(t, true, false, nil), Admitted: fullLifecycleAdmitted(),
+		Runner: runner, Assembly: assembly,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if result.FinalState != "stopped" || result.Assembly.RootID == "" {
+		t.Fatalf("retry outcome = %+v", result)
+	}
+}

