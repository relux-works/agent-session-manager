+				case "config-missing":
+					m["agent_project_config_paths"] = []string{"missing"}
+				case "tree-binding":
+					m["workspace_id"] = "01900000-0000-7000-8000-000000000009"
+				}
+				resealRoot(t, value, object)
+			}
+			if err := ValidateProvisional(value); err == nil {
+				t.Fatal("invalid closure admitted")
+			}
+		})
+	}
