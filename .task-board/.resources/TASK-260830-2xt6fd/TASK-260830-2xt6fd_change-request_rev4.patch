+				id, _, err := canonicaljson.CalculateObjectIdentity(raw)
+				if err != nil {
+					t.Fatal(err)
+				}
+				tree["manifest_id"] = id.String()
+				raw, _ = json.Marshal(tree)
+				value.Manifests[id.String()] = raw
+				object := wireRoot(t, value)
+				children := []string{treeID, id.String()}
