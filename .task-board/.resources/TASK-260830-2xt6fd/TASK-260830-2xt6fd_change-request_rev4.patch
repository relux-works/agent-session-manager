+func (r *capturePhaseRunner) RunInput(ctx context.Context, root string, input []byte, args ...string) (gitsnap.GitResult, error) {
+	result, err := r.ExecGitRunner.RunInput(ctx, root, input, args...)
+	r.after(args)
+	return result, err
+}
