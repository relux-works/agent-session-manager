+	"GateUpstreamRef":       "TestRefuseBadUpstream",
+	"GateDeltaStatus":       "TestRefuseUnknownDeltaStatus",
+	"GateWorktreeKind":      "TestRefuseSpecialWorktreeFile",
+	"GateConsistency":       "TestConsistencyRefusesIndexMutationArmedOnce",
+}
