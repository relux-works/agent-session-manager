+TMPDIR="$PWD/.temp/TASK-260830-2xt6fd" go test ./internal/tmuxserver -run '^(TestCaptureProviderProofRequirements|TestCaptureStopPointStateDomain|TestCaptureAdmissionGateValidControls|TestCaptureCoordinatorAdmissionGateCensus|TestCaptureRejectsCheckpointBoundaryAsProviderProof|TestCaptureRejectsQuiesceReceiptFromAnotherIncarnation|TestCaptureRejectsBarrierLostAfterAssembly|TestCaptureStoppedMustRemainStoppedAtClose|TestUnixDialerMissingDirectoryIsUnknown)$' -count=3 -v
+PYTHONDONTWRITEBYTECODE=1 TMPDIR="$PWD/.temp/TASK-260830-2xt6fd" python3 internal/tmuxserver/mutant_harness.py N-capture-admits-parked N-capture-admits-checkpoint-proof N-capture-admits-foreign-quiesce-receipt N-capture-admits-unproven-barrier-for-one-group N-capture-admits-stopped-to-quiescing-for-one-group C-capture-census-unlisted-refusal-site N-capture-restores-with-boundary-token-preserved N-unix-dialer-missing-parent-admits-stale C-control --log-dir .temp/TASK-260830-2xt6fd/mutants-capture-rework
