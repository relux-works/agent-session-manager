+func TestCaptureCoordinatorAdmissionGateCensus(t *testing.T) {
+	productionDetails := capturePackageRefusalDetails(t)
+	matrixRows := captureAdmissionMatrixRows(t)
+	productionCounts := make(map[string]int, len(productionDetails))
+	for _, detail := range productionDetails {
+		productionCounts[detail]++
+	}
+	for detail, count := range productionCounts {
+		if count != 1 {
+			t.Errorf("production refusal detail %q occurs at %d sites; matrix keys must identify one site", detail, count)
+		}
+		if _, ok := matrixRows[detail]; !ok {
+			t.Errorf("production refusal detail %q has no literal-code matrix test", detail)
+		}
+	}
+	for detail, testName := range matrixRows {
+		if productionCounts[detail] == 0 {
+			t.Errorf("matrix row %s for %q has no reachable production refusal site", testName, detail)
+		}
+	}
+	if len(productionDetails) == 0 {
+		t.Fatal("CaptureGitWorkspace call graph contains no captureUnavailable sites")
+	}
+}
