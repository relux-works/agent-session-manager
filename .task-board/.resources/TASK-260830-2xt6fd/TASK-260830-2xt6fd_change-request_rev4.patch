+func captureAdmissionMatrixRows(t *testing.T) map[string]string {
+	t.Helper()
+	testFile, err := parser.ParseFile(token.NewFileSet(), "capture_git_workspace_test.go", nil, 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	rows := map[string]string{}
+	for _, declaration := range testFile.Decls {
+		function, ok := declaration.(*ast.FuncDecl)
+		if !ok || function.Body == nil || !strings.HasPrefix(function.Name.Name, "TestCaptureAdmission_") {
+			continue
+		}
+		entries := 0
+		assertions := 0
+		ast.Inspect(function.Body, func(node ast.Node) bool {
+			call, ok := node.(*ast.CallExpr)
+			if !ok {
+				return true
+			}
+			if selector, ok := call.Fun.(*ast.SelectorExpr); ok && selector.Sel.Name == "CaptureGitWorkspace" {
+				entries++
+			}
+			ident, ok := call.Fun.(*ast.Ident)
+			if !ok || ident.Name != "requireCaptureRefusal" {
+				return true
+			}
+			assertions++
+			if len(call.Args) != 4 {
+				t.Errorf("matrix test %s has a refusal assertion with %d args, want four", function.Name.Name, len(call.Args))
+				return true
+			}
+			code, codeOK := captureLiteralString(call.Args[2])
+			detail, detailOK := captureLiteralString(call.Args[3])
+			if !codeOK || code != "capability_unavailable" || !detailOK {
+				t.Errorf("matrix test %s must assert literal capability_unavailable code and literal detail", function.Name.Name)
+				return true
+			}
+			if prior, exists := rows[detail]; exists {
+				t.Errorf("matrix detail %q is claimed by both %s and %s", detail, prior, function.Name.Name)
+			} else {
+				rows[detail] = function.Name.Name
+			}
+			return true
+		})
+		if entries != 1 || assertions != 1 {
+			t.Errorf("matrix test %s has %d production entry calls and %d literal refusal assertions, want one each", function.Name.Name, entries, assertions)
+		}
+	}
+	if len(rows) == 0 {
+		t.Fatal("no TestCaptureAdmission_ matrix rows found")
+	}
+	return rows
+}
+
+func captureLiteralString(expression ast.Expr) (string, bool) {
+	literal, ok := expression.(*ast.BasicLit)
+	if !ok || literal.Kind != token.STRING {
+		return "", false
+	}
+	value, err := strconv.Unquote(literal.Value)
+	return value, err == nil
+}
