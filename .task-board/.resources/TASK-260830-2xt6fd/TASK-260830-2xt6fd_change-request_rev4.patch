+	t.Parallel()
+	dir := copyPackageForControls(t)
+	appendControl(t, dir, "snapshot.go", "func plantedUnregisteredGate() *Refusal { return refuse(GatePlantedPositive, \"plant\") }\n")
+	sites := gateSites(t, dir)
