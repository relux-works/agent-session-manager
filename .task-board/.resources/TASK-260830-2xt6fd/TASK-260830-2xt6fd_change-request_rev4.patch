+func (r *capturePhaseRunner) after(args []string) {
+	if r.fired || len(args) == 0 || args[0] != "pack-objects" {
+		return
+	}
+	r.fired = true
+	if r.afterPack != nil {
+		r.afterPack()
+	}
+}
