/bin/zsh -lc "cat > .temp/TASK-260830-2xt6fd/summarize_importer_rev7.py <<'PY'
import csv
import json
from pathlib import Path

root = Path(\".temp/TASK-260830-2xt6fd/importer-rev7\")
touched = [
    \"github.com/relux-works/agent-session-manager/internal/gitsnap\",
    \"github.com/relux-works/agent-session-manager/internal/provhost\",
    \"github.com/relux-works/agent-session-manager/internal/tmuxserver\",
    \"github.com/relux-works/agent-session-manager/internal/traceability\",
]

def objects(path):
    data = path.read_text()
    decoder = json.JSONDecoder()
    offset = 0
    while offset < len(data):
        while offset < len(data) and data[offset].isspace():
            offset += 1
        if offset == len(data):
            break
        item, offset = decoder.raw_decode(data, offset)
        yield item

def graph(path):
    packages = list(objects(path))
    imports = {p.get(\"ImportPath\"): set(p.get(\"Imports\", [])) for p in packages if p.get(\"ImportPath\")}
    rows = {}
    for target in touched:
        rows[target] = sorted(source for source, direct in imports.items() if target in direct)
    return rows, len(packages)

base_graph, base_package_count = graph(root / \"base-packages.json\")
candidate_graph, candidate_package_count = graph(root / \"candidate-packages.json\")

def outcomes(stem, side, absent=False):
    if absent:
        return {}, \"absent\"
    tests = {}
    package_status = \"missing/failed\"
    for line in (root / f\"{stem}-{side}.jsonl\").read_text().splitlines():
        event = json.loads(line)
        action = event.get(\"Action\")
        if action in {\"pass\", \"fail\", \"skip\"}:
            test = event.get(\"Test\")
            package = event.get(\"Package\", \"\")
            if test:
                tests[(package, test)] = action
            else:
                package_status = action
    return tests, package_status

groups = [
    (\"internal/gitsnap\", \"gitsnap\", True),
