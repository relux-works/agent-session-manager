+			return false
+		}
+	}
+	// FileInfo is not part of Snapshot. JSON normalizes pointer identities and
+	// retains the actual content digests and exact recursive wire observations.
+	left, _ := json.Marshal(a)
+	right, _ := json.Marshal(b)
