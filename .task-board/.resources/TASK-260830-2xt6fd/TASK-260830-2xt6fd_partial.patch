+
+func sameObservation(a, b *Snapshot) bool {
+	if !a.observedIndex.equal(b.observedIndex) {
+		return false
+	}
+	if len(a.Content.Submodules) != len(b.Content.Submodules) {
+		return false
+	}
+	for i, sub := range a.Content.Submodules {
+		other := b.Content.Submodules[i]
