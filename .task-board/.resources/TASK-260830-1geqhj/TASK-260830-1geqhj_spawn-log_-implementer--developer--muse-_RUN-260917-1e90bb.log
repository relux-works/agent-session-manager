el()\n667|\tchild := exec.CommandContext(ctx, os.Args[0], \"-test.run=\"+pattern, \"-test.count=1\")\n668|\tchild.Env = append(os.Environ(), env...)\n669|\terr := child.Run()\n670|\tvar exitErr *exec.ExitError\n671|\tif !errors.As(err, &exitErr) {\n672|\t\tt.Fatalf(\"child run = %v, want a signal-kill exit\", err)\n673|\t}\n674|\tstatus, ok := exitErr.Sys().(syscall.WaitStatus)\n675|\tif !ok || !status.Signaled() || status.Signal() != syscall.SIGKILL {\n676|\t\tt.Fatalf(\"child status = %v, want killed by SIGKILL\", exitErr)\n677|\t}\n678|\treturn err\n679|}\n680|\n681|// PROBE 15 — §2.4 \"Losing-lease or ambiguous events MUST NOT change\n682|// [the effective profile]\": a profile.changed authored under the\n683|// superseded lease A (epoch 1) after a local successor lease A2 (epoch 2)\n684|// won is accepted by the chain (tail still at A) and then drives the\n685|// launch profile.\n686|func TestReviewProbeLosingLeaseProfileEventDrivesLaunch(t *testing.T) {\n687|\tworld := buildRunWorld(t)\n688|\tleases, err := world.repo.ListLeases(fixtureSession)\n689|\tif err != nil {\n690|\t\tt.Fatal(err)\n691|\t}\n692|\tsuccessor := \"cccccccc-dddd-4eee-8fff-000000000002\"\n693|\tif _, err := world.repo.CompareAndSwapLease(fixtureSession, sessrepo.LeaseExpectation{RecordID: leases[0].RecordID}, sessrepo.SuccessorLeaseInput{\n694|\t\tCreateLeaseInput: sessrepo.CreateLeaseInput{LeaseID: successor, HolderHostID: fixtureLocalHost, IssuedByHostID: fixtureLocalHost, CreatedAt: fixtureCreatedAt},\n695|\t\tReason:           \"graceful_takeover\",\n696|\t\tCheckpointID:     world.ckptID,\n697|\t}); err != nil {\n698|\t\tt.Fatalf(\"CompareAndSwapLease() error = %v\", err)\n699|\t}\n700|\t// losing-lease profile change (lease A epoch 1) after A2 epoch 2 won\n701|\tchanged := appendChainEvent(t, world.repo, \"profile.changed\", 1, fixtureLeaseA, 2, world.headID, map[string]any{\n702|\t\t\"from\": \"standard\", \"to\": \"yolo\", \"confirmed\": true,\n703|\t})\n704|\trequest := runRequest(