ut.Mode = ModeRestore\n33|\tinput.ExistingBinding = &Binding{SessionID: fixtureSession, OperationID: fixtureOtherOp, TerminalInstanceID: fixtureInstance, BindingDigest: seedDigest(0xB1), CreatedAt: fixtureCreatedAt}\n34|\tdecision := Decide(input)\n35|\tt.Logf(\"RM4 witness: restore mode + changed bootstrap operation -> action=%s class=%s\", decision.Action, decision.Class)\n36|}\n37|\n38|func TestReviewDeltaRM1ObserveFailure(t *testing.T) {\n39|\tworld := buildRunWorld(t)\n40|\troot := t.TempDir()\n41|\trepository, err := sessrepo.Open(root)\n42|\tif err != nil {\n43|\t\tt.Fatal(err)\n44|\t}\n45|\tvar record map[string]any\n46|\tif err := json.Unmarshal([]byte(sessionRecordFixture), &record); err != nil {\n47|\t\tt.Fatal(err)\n48|\t}\n49|\treference, err := repository.CreateSession(identifyObject(t, record, \"record_id\"))\n50|\tif err != nil {\n51|\t\tt.Fatal(err)\n52|\t}\n53|\tif _, err := repository.CreateLease(fixtureSession, sessrepo.CreateLeaseInput{LeaseID: fixtureLeaseA, HolderHostID: fixtureLocalHost, IssuedByHostID: fixtureLocalHost, CreatedAt: fixtureCreatedAt}); err != nil {\n54|\t\tt.Fatal(err)\n55|\t}\n56|\tappendChainEvent(t, repository, \"session.created\", 1, fixtureLeaseA, 1, reference.RecordID, map[string]any{\n57|\t\t\"session_record_id\": reference.RecordID, \"bootstrap_operation_id\": fixtureBootstrap, \"first_checkpoint_operation_id\": fixtureOtherOp,\n58|\t})\n59|\tworld.repo = repository\n60|\tmatches, _ := filepath.Glob(filepath.Join(root, \"sessions\", fixtureSession, \"leases\", \"*\"))\n61|\tt.Logf(\"lease blobs: %d\", len(matches))\n62|\tfor _, match := range matches {\n63|\t\tif err := os.WriteFile(match, []byte(\"{torn\"), 0o600); err != nil {\n64|\t\t\tt.Fatal(err)\n65|\t\t}\n66|\t}\n67|\toutcome, err := Run(world.stores(), runRequest(t, world))\n68|\tt.Logf(\"RM1 witness: Run with a torn lease blob -> action=%q emitted=%v err=%v\", outcome.Decision.Action, outcome.Emitted, err)\n69|}","final_result":true}}}
