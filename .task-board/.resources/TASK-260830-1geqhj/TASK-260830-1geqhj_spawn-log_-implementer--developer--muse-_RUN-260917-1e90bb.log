ck\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Mover acknowledgement required by version_control.confirm for Bug/Story done transitions\\\"},{\\\"name\\\":\\\"txn_id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Integration transaction token presented to satisfy a transition lease; it authorizes nothing else\\\"}],\\\"examples\\\":[\\\"handoff(TASK-260218-abc123, role=developer, status=to-review)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":true},\\\"integrate_external\\\":{\\\"description\\\":\\\"Close an integrating accepted empty-delta Change Request with explicit external-delivery evidence\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Integrating element carrying the accepted Change Request\\\",\\\"required\\\":true},{\\\"name\\\":\\\"evidence\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Written external landing or delivery evidence recorded on the CR and element notes\\\",\\\"required\\\":true}],\\\"examples\\\":[\\\"integrate_external(TASK-260803-323q82, evidence=\\\\\\\"https://git.example.test/project/merge_requests/42\\\\\\\")\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false},\\\"link\\\":{\\\"description\\\":\\\"Create dependency: element is blocked by another\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element that will be blocked\\\",\\\"required\\\":true},{\\\"name\\\":\\\"blocked_by\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element that blocks\\\",\\\"required\\\":true}],\\\"examples\\\":[\\\"link(TASK-260218-abc123, blocked_by=TASK-260218-def456)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":true},\\\"login\\\":{\\\"description\\\":\\\"Store auth token in Keychain and select the active user in non-versioned local state\\\",\\\"parameters\\\":[{\\