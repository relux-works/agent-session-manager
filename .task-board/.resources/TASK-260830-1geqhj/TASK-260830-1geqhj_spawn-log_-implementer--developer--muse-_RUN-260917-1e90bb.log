{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c615","stream":{"kind":"session","id":"01a0b0c0-ed80-7083-a928-581e7c42de76"},"sequence":357,"recorded_at":1780531400000709,"record_type":"event","durability":"durable","causation_id":"59f95e0c-e6e0-4829-ade8-6c5cffb39d86","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"59f95e0c-e6e0-4829-ade8-6c5cffb39d86","run_stream":{"kind":"run","id":"59f95e0c-e6e0-4829-ade8-6c5cffb39d86"},"task_stream":{"kind":"task","id":"01a0b0c2-045b-7443-ab14-783f6524215a"},"task_id":"01a0b0c2-045b-7443-ab14-783f6524215a","event":{"kind":"output","task_id":"01a0b0c2-045b-7443-ab14-783f6524215a","chunk":"Read text file `/tmp/rev1/evidence/probes/zz_review_probe_test.go`.\n(499 line(s) above)\n500|\tdecision := Decide(input)\n501|\tt.Logf(\"descriptor generation != host binding generation: action=%s class=%s\", decision.Action, decision.Class)\n502|\tif decision.Action != ActionRefused || decision.Class != terminalbackend.CodeStaleGeneration {\n503|\t\tt.Errorf(\"descriptor generation drift not refused stale_generation\")\n504|\t}\n505|}\n506|\n507|// PROBE 14 — non-interactive remote owner: §4.2 step 5 says parked in\n508|// all other cases; the wrapper labels it takeover_offer.\n509|func TestReviewProbeNonInteractiveRemoteOwnerLabel(t *testing.T) {\n510|\tdeps := buildDecideDeps(t, true)\n511|\tinput := validInput(t, deps)\n512|\tinput.Mode = ModeRestore\n513|\tinput.Observation.Winner.HolderHostID = fixtureRemoteHost\n514|\tinput.RemoteInteractive = false\n515|\tdecision := Decide(input)\n516|\tt.Logf(\"non-interactive remote owner in restore mode: action=%s reason=%s\", decision.Action, decision.ParkReason)\n517|\tif decision.Action != ActionParked {\n518|\t\tt.Errorf(\"FINDING (label): non-interactive remote owner yields %s, spec step 5 = parked\", decision.Action)\n519|\t}\n520|}\n521|\n522|// PROBE C1 — real SIGKILL BEFORE the no-replace commit (AfterStage):\n523|// restart must prove absence, and the retry must install exactly one\n524|// binding (never a second child).\n525|func TestReviewProbeCrashBeforeCommit(t *testing.T) {\n526|\tif os.Getenv(\"AX_REVIEW_CRASH_STAGE\") == \"1\" {\n527|\t\tstore, err := Open(os.Getenv(\"AX_REVIEW_CRASH_STORE\"))\n528|\t\tif err != nil {\n529|\t\t\tt.Fatal(err)\n530|\t\t}\n531|\t\tstore.WithHooks(&Hooks{AfterStage: func(path string) error {\n532|\t\t\tproc, _ := os.FindProcess(os.Getpid())\n533|\t\t\t_ = proc.Signal(syscall.SIGKILL)\n534|\t\t\tselect {}\n535|\t\t}})\n536|\t\t_, _, _ = store.Bind(fixtureSession, fixtureBootstrap, bindCandidate())\n537|\t\tt.Fatal(\"returned past SIGKILL\")\n538|\t\treturn\n539|\t}\n540|\tstoreDir := t.TempDir()\n541|\tif _, err := Open(storeDir); err != nil {\n542|\t\tt.Fatal(err)\n543|\t}\n544|\tchild := execSelf(t, \"^TestReviewProbeCrashBeforeCommit$\", \"AX_REVIEW_CRASH_STAGE=1\", \"AX_REVIEW_CRASH_STORE=\"+storeDir)\n545|\tt.Logf(\"child exit: %v\", child)\n546|\tstore, err := Open(storeDir)\n547|\tif err != nil {\n548|\t\tt.Fatal(err)\n549|\t}\n550|\t_, found, err := store.Status(fixtureSession)\n551|\tt.Logf(\"Status after kill-before-commit: found=%v err=%v\", found, err)\n552|\tif err != nil || found {\n553|\t\tt.Errorf(\"expected proven absence after a pre-commit kill, got found=%v err=%v\", found, err)\n554|\t}\n555|\tentries, _ := os.ReadDir(filepath.Join(storeDir, \"axpane\", \"bootstrap\", fixtureSession))\n556|\tvar names []string\n557|\tfor _, entry := range entries {\n558|\t\tnames = append(names, entry.Name())\n559|\t}\n560|\tt.Logf(\"session dir after kill-before-commit: %v\", names)\n561|\tbound, reattached, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate())\n562|\tif err != nil || reattached {\n563|\t\tt.Errorf(\"retry after pre-commit kill = (%+v, reattached=%v, err=%v), want a fresh install\", bound, reattached, err)\n564|\t}\n565|\tentries, _ = os.ReadDir(filepath.Join(storeDir, \"axpane\", \"bootstrap\", fixtureSession))\n566|\tnames = nil\n567|\tfor _, entry := range entries {\n568|\t\tnames = append(names, entry.Name())\n569|\t}\n570|\tt.Logf(\"session dir after retry: %v\", names)\n571|\tcount := 0\n572|\tfor _, name := range names {\n573|\t\tif name == \"binding.json\" {\n574|\t\t\tcount++\n575|\t\t}\n576|\t}\n577|\tif count != 1 {\n578|\t\tt.Errorf(\"binding count = %d, want exactly one\", count)\n579|\t}\n580|}\n581|\n582|// PROBE C2 — identical retries reattach without a second write: inode\n583|// and mtime census over the binding file.\n584|func TestReviewProbeIdenticalRetryInodeCensus(t *testing.T) {\n585|\tstore, err := Open(t.TempDir())\n586|\tif err != nil {\n587|\t\tt.Fatal(err)\n588|\t}\n589|\tfirst, reattached, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate())\n590|\tif err != nil || reattached {\n591|\t\tt.Fatalf(\"first bind = (%+v, %v, %v)\", first, reattached, err)\n592|\t}\n593|\tpath := store.bindingPath(fixtureSession)\n594|\tbefore, err := os.Stat(path)\n595|\tif err != nil {\n596|\t\tt.Fatal(err)\n597|\t}\n598|\tbeforeIno := before.Sys().(*syscall.Stat_t).Ino\n599|\tbeforeBytes, _ := os.ReadFile(path)\n600|\tfor round := 0; round < 3; round++ {\n601|\t\tother := bindCandidate()\n602|\t\tother.TerminalInstanceID = \"0198f4c9-3333-7ccc-8ccc-1234567890ab\" // different child facts on retry\n603|\t\tother.BindingDigest = BindingDigest(other)\n604|\t\tagain, reattached, err := store.Bind(fixtureSession, fixtureBootstrap, other)\n605|\t\tif err != nil || !reattached || again != first {\n606|\t\t\tt.Fatalf(\"retry %d = (%+v, %v, %v), want reattach to %+v\", round, again, reattached, err, first)\n607|\t\t}\n608|\t}\n609|\tafter, err := os.Stat(path)\n610|\tif err != nil {\n611|\t\tt.Fatal(err)\n612|\t}\n613|\tafterIno := after.Sys().(*syscall.Stat_t).Ino\n614|\tafterBytes, _ := os.ReadFile(path)\n615|\tt.Logf(\"inode before=%d after=%d mtime before=%v after=%v bytes-equal=%v\", beforeIno, afterIno, before.ModTime(), after.ModTime(), string(beforeBytes) == string(afterBytes))\n616|\tif beforeIno != afterIno || !before.ModTime().Equal(after.ModTime()) || string(beforeBytes) != string(afterBytes) {\n617|\t\tt.Errorf(\"identical retry rewrote the binding\")\n618|\t}\n619|\tentries, _ := os.ReadDir(filepath.Dir(path))\n620|\tif len(entries) != 1 {\n621|\t\tt.Errorf(\"session dir has %d entries, want 1 (no staging garbage)\", len(entries))\n622|\t}\n623|}\n624|\n625|func sessckptOpen(t *testing.T) (*sessckpt.Store, error) {\n626|\tt.Helper()\n627|\treturn sessckpt.Open(t.TempDir())\n628|}\n629|\n630|func checkpointFixtureFor(t *testing.T, repository *sessrepo.Repository, store *sessckpt.Store, sessionID string, heads []string) (string, []byte) {\n631|\tt.Helper()\n632|\treference, raw, err := store.Capture(repository, sessckpt.Inputs{\n633|\t\tOperationID:         fixtureBootstrap,\n634|\t\tSessionID:           sessionID,\n635|\t\tSessionKind:         sessckpt.SessionKindDirect,\n636|\t\tLeaseEpoch:          1,\n637|\t\tLeaseID:             fixtureLeaseA,\n638|\t\tCreatorHostID:       fixtureLocalHost,\n639|\t\tWorkspaceManifestID: seedDigest(0xE1),\n640|\t\tProviderManifestID:  seedDigest(0xE2),\n641|\t\tBoundary: sessckpt.SafeBoundary{\n642|\t\t\tProviderID:          \"codex\",\n643|\t\t\tProviderVersion:     \"0.147.0\",\n644|\t\t\tEvidence:            sessckpt.EvidenceAcceptedTest,\n645|\t\t\tInputBlocked:        true,\n646|\t\t\tForegroundIdle:      true,\n647|\t\t\tBackgroundIdle:      true,\n648|\t\t\tOpenProcesses:       0,\n649|\t\t\tOpenDatabaseHandles: 0,\n650|\t\t},\n651|\t\tEventHeads: heads,\n652|\t\tCreatedAt:  fixtureCreatedAt,\n653|\t\tExtensions: map[string]string{},\n654|\t})\n655|\tif err != nil {\n656|\t\tt.Fatalf(\"Capture() error = %v\", err)\n657|\t}\n658|\treturn reference.CheckpointID, raw\n659|}\n660|\n661|// execSelf re-executes the test binary for one test with extra env and\n662|// returns the run error (a SIGKILL exit is expected by the callers).\n663|func execSelf(t *testing.T, pattern string, env ...string) error {\n664|\tt.Helper()\n665|\tctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)\n666|\tdefer cancel()\n667|\tchild := exec.CommandContext(ctx, os.Args[0], \"-test.run=\"+pattern, \"-test.count=1\")\n668|\tchild.Env = append(os.Environ(), env...)\n669|\terr := child.Run()\n670|\tvar exitErr *exec.ExitError\n671|\tif !errors.As(err, &exitErr) {\n672|\t\tt.Fatalf(\"child run = %v, want a signal-kill exit\", err)\n673|\t}\n674|\tstatus, ok := exitErr.Sys().(syscall.WaitStatus)\n675|\tif !ok || !status.Signaled() || status.Signal() != syscall.SIGKILL {\n676|\t\tt.Fatalf(\"child status = %v, want killed by SIGKILL\", exitErr)\n677|\t}\n678|\treturn err\n679|}\n680|\n681|// PROBE 15 — §2.4 \"Losing-lease or ambiguous events MUST NOT change\n682|// [the effective profile]\": a profile.changed authored under the\n683|// superseded lease A (epoch 1) after a local successor lease A2 (epoch 2)\n684|// won is accepted by the chain (tail still at A) and then drives the\n685|// launch profile.\n686|func TestReviewProbeLosingLeaseProfileEventDrivesLaunch(t *testing.T) {\n687|\tworld := buildRunWorld(t)\n688|\tleases, err := world.repo.ListLeases(fixtureSession)\n689|\tif err != nil {\n690|\t\tt.Fatal(err)\n691|\t}\n692|\tsuccessor := \"cccccccc-dddd-4eee-8fff-000000000002\"\n693|\tif _, err := world.repo.CompareAndSwapLease(fixtureSession, sessrepo.LeaseExpectation{RecordID: leases[0].RecordID}, sessrepo.SuccessorLeaseInput{\n694|\t\tCreateLeaseInput: sessrepo.CreateLeaseInput{LeaseID: successor, HolderHostID: fixtureLocalHost, IssuedByHostID: fixtureLocalHost, CreatedAt: fixtureCreatedAt},\n695|\t\tReason:           \"graceful_takeover\",\n696|\t\tCheckpointID:     world.ckptID,\n697|\t}); err != nil {\n698|\t\tt.Fatalf(\"CompareAndSwapLease() error = %v\", err)\n699|\t}\n700|\t// losing-lease profile change (lease A epoch 1) after A2 epoch 2 won\n701|\tchanged := appendChainEvent(t, world.repo, \"profile.changed\", 1, fixtureLeaseA, 2, world.headID, map[string]any{\n702|\t\t\"from\": \"standard\", \"to\": \"yolo\", \"confirmed\": true,\n703|\t})\n704|\trequest := runRequest(t, world)\n705|\trequest.Presented = fencing.PresentedToken{SessionID: fixtureSession, Epoch: 2, LeaseID: successor}\n706|\toutcome, err := Run(world.stores(), request)\n707|\tif err != nil {\n708|\t\tt.Fatalf(\"Run() error = %v\", err)\n709|\t}\n710|\tt.Logf(\"launch under A2 epoch 2 with a losing-lease (A, epoch 1) profile.changed %s in the chain: action=%s profile=%+v mapping=%q\",\n711|\t\tchanged[:20], outcome.Decision.Action, outcome.Decision.Profile, outcome.Decision.Mapping)\n712|\tif outcome.Decision.Action == ActionLaunch && outcome.Decision.Profile.Source == changed {\n713|\t\tt.Errorf(\"FINDING: a profile.changed authored under a losing lease became the launch profile source (yolo mapping %q)\", outcome.Decision.Mapping)\n714|\t}\n715|}","final_result":true}}}
