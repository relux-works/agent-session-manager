{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c737","stream":{"kind":"session","id":"01a0b0c0-ed80-7083-a928-581e7c42de76"},"sequence":502,"recorded_at":1780531400000999,"record_type":"event","durability":"durable","causation_id":"59f95e0c-e6e0-4829-ade8-6c5cffb39d86","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"59f95e0c-e6e0-4829-ade8-6c5cffb39d86","run_stream":{"kind":"run","id":"59f95e0c-e6e0-4829-ade8-6c5cffb39d86"},"task_stream":{"kind":"task","id":"01a0b0c2-3d02-7763-90d4-f8776930de09"},"task_id":"01a0b0c2-3d02-7763-90d4-f8776930de09","event":{"kind":"output","task_id":"01a0b0c2-3d02-7763-90d4-f8776930de09","chunk":"Read text file `internal/axpane/descriptor.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"crypto/rand\"\n5|\t\"encoding/binary\"\n6|\t\"encoding/json\"\n7|\t\"fmt\"\n8|\t\"time\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|)\n12|\n13|// DescriptorParams carries the §7.A Terminal Instance binding context\n14|// the wrapper supplies: the validated host-local binding subset,\n15|// interactivity, and geometry.\n16|type DescriptorParams struct {\n17|\t// Binding is the AX-validated host-local binding subset the\n18|\t// descriptor must match.\n19|\tBinding BindingRef\n20|\t// InstanceID is the AX-allocated terminal instance UUIDv7;\n21|\t// empty mints a fresh one. It is never a PID, socket, path,\n22|\t// pipe, URL, handle, token, or native reference.\n23|\tInstanceID string\n24|\t// Interactive selects the presentation mode.\n25|\tInteractive bool\n26|\t// Columns and Rows carry the uint16[1..1000] geometry bound.\n27|\tColumns uint16\n28|\tRows    uint16\n29|}\n30|\n31|// BindingRef is the validated host-local binding subset: binding\n32|// digest, backend ID, versions, and generation.\n33|type BindingRef struct {\n34|\tBindingDigest         string\n35|\tBackendID             string\n36|\tImplementationVersion string\n37|\tProtocolVersion       string\n38|\tGeneration            string\n39|}\n40|\n41|// MintInstanceID allocates one terminal instance UUIDv7: 48-bit\n42|// millisecond timestamp, version and variant bits, and 74\n43|// cryptographic random bits. Time and randomness come from the\n44|// caller-supplied clock and reader so tests pin them; production\n45|// passes time.Now and crypto/rand.\n46|func MintInstanceID(now time.Time, random func([]byte) (int, error)) (string, error) {\n47|\tvar raw [16]byte\n48|\tmillis := uint64(now.UTC().UnixMilli())\n49|\tif millis>>48 != 0 {\n50|\t\treturn \"\", fmt.Errorf(\"instance clock is outside the UUIDv7 range\")\n51|\t}\n52|\traw[0] = byte(millis >> 40)\n53|\traw[1] = byte(millis >> 32)\n54|\traw[2] = byte(millis >> 24)\n55|\traw[3] = byte(millis >> 16)\n56|\traw[4] = byte(millis >> 8)\n57|\traw[5] = byte(millis)\n58|\ttail := make([]byte, 10)\n59|\tif _, err := random(tail); err != nil {\n60|\t\treturn \"\", fmt.Errorf(\"instance randomness failed: %w\", err)\n61|\t}\n62|\tcopy(raw[6:], tail)\n63|\traw[6] = raw[6]&0x0f | 0x70\n64|\traw[8] = raw[8]&0x3f | 0x80\n65|\tvalue := fmt.Sprintf(\"%08x-%04x-%04x-%04x-%012x\",\n66|\t\tbinary.BigEndian.Uint32(raw[0:4]),\n67|\t\tbinary.BigEndian.Uint16(raw[4:6]),\n68|\t\tbinary.BigEndian.Uint16(raw[6:8]),\n69|\t\tbinary.BigEndian.Uint16(raw[8:10]),\n70|\t\tuint64(raw[10])<<40|uint64(raw[11])<<32|uint64(raw[12])<<24|uint64(raw[13])<<16|uint64(raw[14])<<8|uint64(raw[15]))\n71|\tif _, err := scalar.ParseUUIDv7(value); err != nil {\n72|\t\treturn \"\", fmt.Errorf(\"minted instance id is not a UUIDv7: %w\", err)\n73|\t}\n74|\treturn value, nil\n75|}\n76|\n77|// MintInstanceIDRandom mints one terminal instance UUIDv7 from the\n78|// system clock and crypto/rand.\n79|func MintInstanceIDRandom() (string, error) {\n80|\treturn MintInstanceID(time.Now(), rand.Read)\n81|}\n82|\n83|// BuildDescriptor renders the closed §7.A descriptor document for the\n84|// launch path: the binding digest, the AX-allocated instance UUIDv7,\n85|// backend identity, generation, interactivity, and geometry. No\n86|// other member is permitted. Geometry outside uint16[1..1000]\n87|// refuses, and the instance ID must parse as UUIDv7.\n88|func BuildDescriptor(params DescriptorParams) ([]byte, error) {\n89|\tinstance := params.InstanceID\n90|\tif instance == \"\" {\n91|\t\tminted, err := MintInstanceIDRandom()\n92|\t\tif err != nil {\n93|\t\t\treturn nil, err\n94|\t\t}\n95|\t\tinstance = minted\n96|\t}\n97|\tif _, err := scalar.ParseUUIDv7(instance); err != nil {\n98|\t\treturn nil, fmt.Errorf(\"descriptor instance %q is not a UUIDv7: %w\", instance, err)\n99|\t}\n100|\tif params.Columns < 1 || params.Columns > 1000 || params.Rows < 1 || params.Rows > 1000 {\n101|\t\treturn nil, fmt.Errorf(\"descriptor geometry %dx%d is outside uint16[1..1000]\", params.Columns, params.Rows)\n102|\t}\n103|\tdocument := map[string]any{\n104|\t\t\"terminal_binding_id\":    params.Binding.BindingDigest,\n105|\t\t\"terminal_instance_id\":   instance,\n106|\t\t\"terminal_backend_id\":    params.Binding.BackendID,\n107|\t\t\"implementation_version\": params.Binding.ImplementationVersion,\n108|\t\t\"protocol_version\":       params.Binding.ProtocolVersion,\n109|\t\t\"backend_generation\":     params.Binding.Generation,\n110|\t\t\"interactive\":            params.Interactive,\n111|\t\t\"columns\":                params.Columns,\n112|\t\t\"rows\":                   params.Rows,\n113|\t}\n114|\traw, err := json.Marshal(document)\n115|\tif err != nil {\n116|\t\treturn nil, fmt.Errorf(\"encode provider descriptor: %w\", err)\n117|\t}\n118|\treturn raw, nil\n119|}","final_result":true}}}
