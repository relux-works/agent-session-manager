{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c733","stream":{"kind":"session","id":"01a0b0c0-ed80-7083-a928-581e7c42de76"},"sequence":500,"recorded_at":1780531400000995,"record_type":"event","durability":"durable","causation_id":"59f95e0c-e6e0-4829-ade8-6c5cffb39d86","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"59f95e0c-e6e0-4829-ade8-6c5cffb39d86","run_stream":{"kind":"run","id":"59f95e0c-e6e0-4829-ade8-6c5cffb39d86"},"task_stream":{"kind":"task","id":"01a0b0c2-3d1e-7693-be2c-7f4aa4ecce2a"},"task_id":"01a0b0c2-3d1e-7693-be2c-7f4aa4ecce2a","event":{"kind":"output","task_id":"01a0b0c2-3d1e-7693-be2c-7f4aa4ecce2a","chunk":"Read text file `internal/axpane/sync.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"os\"\n6|\t\"runtime\"\n7|)\n8|\n9|// syncDirectory fsyncs a directory so an install inside it survives\n10|// a crash. Opening a directory fails on Windows, where the install\n11|// itself is the durability boundary; there the sync is skipped,\n12|// never faked. This mirrors the landed matjournal discipline.\n13|func syncDirectory(path string) error {\n14|\tif runtime.GOOS == \"windows\" {\n15|\t\treturn nil\n16|\t}\n17|\tdirectory, err := os.Open(path)\n18|\tif err != nil {\n19|\t\treturn fmt.Errorf(\"open directory for fsync: %w\", err)\n20|\t}\n21|\tdefer func() { _ = directory.Close() }()\n22|\tif err := directory.Sync(); err != nil {\n23|\t\treturn fmt.Errorf(\"fsync directory: %w\", err)\n24|\t}\n25|\treturn nil\n26|}","final_result":true}}}
