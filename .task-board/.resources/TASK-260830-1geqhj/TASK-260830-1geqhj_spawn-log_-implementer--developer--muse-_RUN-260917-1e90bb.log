{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c96f","stream":{"kind":"session","id":"01a0b0c0-ed80-7083-a928-581e7c42de76"},"sequence":786,"recorded_at":1780531400001567,"record_type":"event","durability":"durable","causation_id":"59f95e0c-e6e0-4829-ade8-6c5cffb39d86","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"59f95e0c-e6e0-4829-ade8-6c5cffb39d86","run_stream":{"kind":"run","id":"59f95e0c-e6e0-4829-ade8-6c5cffb39d86"},"task_stream":{"kind":"task","id":"01a0b0c3-1622-73c0-abc5-d94f5b15b8b9"},"task_id":"01a0b0c3-1622-73c0-abc5-d94f5b15b8b9","event":{"kind":"output","task_id":"01a0b0c3-1622-73c0-abc5-d94f5b15b8b9","chunk":"{\n  \"chunk_id\": \"exec-26-1\",\n  \"command\": \"grep -n \\\"func AttestCheckpointRecord\\\\|type CheckpointMembers\\\\|EventHeads\\\\|SessionID\\\" internal/sessrepo/checkpoint.go | head -n 30; echo ===; sed -n 1,120p internal/sessrepo/checkpoint.go\",\n  \"description\": \"Inspect checkpoint attestation API\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"22:func AttestCheckpointRecord(raw []byte) (scalar.Digest, canonicaljson.SelfField, error) {\\n===\\n// Checkpoint Record attestation for the session-persistence leaf.\\n//\\n// Checkpoint Records (urn:ax:schema:checkpoint) are session-persistence\\n// objects alongside Session Records, Session Events, and Lease Records.\\n// This helper owns their canonical identity attestation through the\\n// canonicaljson owner, so query-layer admission (internal/sessquery)\\n// never attests the binding itself: it calls AttestCheckpointRecord\\n// and then extracts the already validated members. The provhost\\n// identity bound allowlists this site with the session record/event\\n// sites and the lease site.\\npackage sessrepo\\n\\nimport (\\n\\t\\\"github.com/relux-works/agent-session-manager/internal/canonicaljson\\\"\\n\\t\\\"github.com/relux-works/agent-session-manager/internal/scalar\\\"\\n)\\n\\n// AttestCheckpointRecord validates one canonical Checkpoint Record\\n// frame through the canonicaljson owner and returns its canonical\\n// digest with the self-identity field. Closed-shape and self-identity\\n// failures are returned for the caller to map to its refusal class.\\nfunc AttestCheckpointRecord(raw []byte) (scalar.Digest, canonicaljson.SelfField, error) {\\n\\treturn canonicaljson.VerifyObjectIdentity(raw)\\n}\\n\",\n  \"original_output_bytes\": 1264,\n  \"original_output_tokens\": 316,\n  \"truncated\": false\n}","final_result":true}}}
