ing; quarantines\\\",\\\"enum\\\":[\\\"known_falsehood\\\",\\\"contaminated\\\",\\\"integrity_failed\\\"]},{\\\"name\\\":\\\"at\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"RFC3339 audit instant\\\"}],\\\"examples\\\":[\\\"audit_context_validation(CTX-260728-a1b2c3, trigger=daily_audit)\\\",\\\"audit_context_validation(CTX-260728-a1b2c3, trigger=deep_audit, coverage_manifest_sha256=abc123, anchor_commit=def456)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false},\\\"check_item\\\":{\\\"description\\\":\\\"Check a checklist item\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\",\\\"required\\\":true},{\\\"name\\\":\\\"item\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Checklist item number (1-based)\\\",\\\"required\\\":true}],\\\"examples\\\":[\\\"check_item(TASK-260218-abc123, item=1)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":true},\\\"collect_context_retention\\\":{\\\"description\\\":\\\"Retire what a never-pruning provider left behind and name the payloads to delete\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"warn_days\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"default\\\":7,\\\"description\\\":\\\"Expiry warning horizon\\\"},{\\\"name\\\":\\\"include_pinned\\\",\\\"type\\\":\\\"bool\\\",\\\"optional\\\":true,\\\"default\\\":false,\\\"description\\\":\\\"Collect pinned contexts too\\\"}],\\\"examples\\\":[\\\"collect_context_retention()\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false},\\\"confirm_context_reclamation\\\":{\\\"description\\\":\\\"Record that a retired context's provider payload was deleted, so later sweeps stop asking\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"CTX identifier\\\",\\\"required\\\":true},{\\\"name\\\":\\\"archived_included\\\",\\\"type\\\":\\\"bool\\\",\\\"optional\\\":true,\\\"default\\\":false,\\\"description\\\":\\\"Archive location swept too; required where archiving moves rather than deletes\\\"},{\\\"name\\\":\\\"files\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Payload files removed\\\"},{\\\"name\\\":\\\"reclaimed_at\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"RFC3339 deletion time\\\"}],\\\"examples\\\":[\\\"confirm_context_reclamation(CTX-260728-a1b2c3, archived_included=true, files=2)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":true},\\\"correct_activity\\\":{\\\"description\\\":\\\"Append a privileged, append-only correction/supersession event referencing an earlier activity event. Never edits or deletes the original event.\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID whose activity stream receives the correction\\\",\\\"required\\\":true},{\\\"name\\\":\\\"target_event_id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Event ID being corrected or superseded\\\",\\\"required\\\":true},{\\\"name\\\":\\\"kind\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"\\\\\\\"corrects\\\\\\\" or \\\\\\\"supersedes\\\\\\\"\\\",\\\"enum\\\":[\\\"corrects\\\",\\\"supersedes\\\"],\\\"required\\\":true},{\\\"name\\\":\\\"reason\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Non-empty human-readable justification\\\",\\\"required\\\":true}],\\\"examples\\\":[\\\"correct_activity(TASK-260218-abc123, target_event_id=AEV-260218-000000000000000000000001, kind=corrects, reason=\\\\\\\"wrong status recorded\\\\\\\")\\\"],\\\"destructive\\\":true,\\\"idempotent\\\":false},\\\"create\\\":{\\\"description\\\":\\\"Create a new board element\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"type\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element type\\\",\\\"enum\\\":[\\\"epic\\\",\\\"story\\\",\\\"task\\\",\\\"bug\\\"],\\\"required\\\":true},{\\\"name\\\":\\\"name\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element name (kebab-case)\\\",\\\"required\\\":true},{\\\"name\\\":\\\"parent\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Parent element ID (required for story/task/bug)\\\"},{\\\"name\\\":\\\"description\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Element description\\\"},{\\\"name\\\":\\\"scope\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Element scope\\\"},{\\\"name\\\":\\\"ac\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Acceptance criteria\\\"},{\\\"name\\\":\\\"review\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Review policy\\\",\\\"enum\\\":[\\\"required\\\",\\\"light\\\",\\\"none\\\"]},{\\\"name\\\":\\\"task_class\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Task class\\\",\\\"enum\\\":[\\\"code\\\",\\\"metadata\\\",\\\"docs\\\",\\\"research\\\"]}],\\\"examples\\\":[\\\"create(type=epic, name=auth-system)\\\",\\\"create(type=task, name=implement-login, parent=STORY-260218-abc123)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false},\\\"defer_cr\\\":{\\\"description\\\":\\\"Mark an accepted Change Request revision as deferred by human decision, so `worktree integrating` reports it as parked rather than as landing backlog\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID carrying the Change Request\\\",\\\"required\\\":true},{\\\"name\\\":\\\"revision\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Change Request revision being deferred (expected-revision CAS)\\\",\\\"required\\\":true},{\\\"name\\\":\\\"reason\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\