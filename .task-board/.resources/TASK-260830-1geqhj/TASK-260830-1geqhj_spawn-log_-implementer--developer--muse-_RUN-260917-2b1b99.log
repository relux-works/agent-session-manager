{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8f1","stream":{"kind":"session","id":"01a0b0ab-f92f-74d3-a245-61ad42401b4b"},"sequence":723,"recorded_at":1780531400001441,"record_type":"event","durability":"durable","causation_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","run_stream":{"kind":"run","id":"8ab0c8df-167f-48db-b83c-f756aeede0a9"},"task_stream":{"kind":"task","id":"01a0b0ae-5cf8-7591-8280-da5a456608c9"},"task_id":"01a0b0ae-5cf8-7591-8280-da5a456608c9","event":{"kind":"output","task_id":"01a0b0ae-5cf8-7591-8280-da5a456608c9","chunk":"Read text file `internal/axpane/decide_test.go`.\n(698 line(s) above)\n699|\t\t\t\tinput.CheckpointRequired = true\n700|\t\t\t\tinput.CheckpointDoc = nil\n701|\t\t\t\tinput.CheckpointID = seedDigest(0xEE)\n702|\t\t\t},\n703|\t\t\twant:       ActionParked,\n704|\t\t\twantReason: fencing.ParkRestorePolicy,\n705|\t\t\twantLease:  fixtureLeaseA,\n706|\t\t},\n707|\t\t{\n708|\t\t\tname: \"parked_checkpoint_wrong_identity\",\n709|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n710|\t\t\t\tinput.CheckpointRequired = true\n711|\t\t\t\tinput.CheckpointDoc = deps.ckptDoc\n712|\t\t\t\tinput.CheckpointID = seedDigest(0xEE)\n713|\t\t\t},\n714|\t\t\twant:       ActionParked,\n715|\t\t\twantReason: fencing.ParkRestorePolicy,\n716|\t\t\twantLease:  fixtureLeaseA,\n717|\t\t},\n718|\t\t{\n719|\t\t\tname: \"parked_checkpoint_flipped_digest\",\n720|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n721|\t\t\t\tinput.CheckpointRequired = true\n722|\t\t\t\tinput.CheckpointDoc = deps.ckptDoc\n723|\t\t\t\tflipped := deps.ckptID[:len(deps.ckptID)-1] + \"0\"\n724|\t\t\t\tif flipped == deps.ckptID {\n725|\t\t\t\t\tflipped = deps.ckptID[:len(deps.ckptID)-1] + \"1\"\n726|\t\t\t\t}\n727|\t\t\t\tinput.CheckpointID = flipped\n728|\t\t\t},\n729|\t\t\twant:       ActionParked,\n730|\t\t\twantReason: fencing.ParkRestorePolicy,\n731|\t\t\twantLease:  fixtureLeaseA,\n732|\t\t},\n733|\t}\n734|\tfor _, testRow := range rows {\n735|\t\tt.Run(testRow.name, func(t *testing.T) {\n736|\t\t\tt.Parallel()\n737|\t\t\tdeps := buildDecideDeps(t, !testRow.attachProbe)\n738|\t\t\tif testRow.universe != nil {\n739|\t\t\t\ttestRow.universe(t, deps.universe)\n740|\t\t\t}\n741|\t\t\tinput := validInput(t, deps)\n742|\t\t\tif testRow.mutate != nil {\n743|\t\t\t\ttestRow.mutate(t, deps, &input)\n744|\t\t\t}\n745|\t\t\tdecision := Decide(input)\n746|\t\t\tif decision.Action != testRow.want {\n747|\t\t\t\tt.Fatalf(\"Decide() action = %q, class %q, reason %q, detail %q, cause %v, want %q\",\n748|\t\t\t\t\tdecision.Action, decision.Class, decision.ParkReason, decision.Detail, decision.Cause, testRow.want)\n749|\t\t\t}\n750|\t\t\tswitch testRow.want {\n751|\t\t\tcase ActionRefused:\n752|\t\t\t\tif decision.Class != testRow.wantClass {\n753|\t\t\t\t\tt.Fatalf(\"Decide() class = %q, want %q (cause %v)\", decision.Class, testRow.wantClass, decision.Cause)\n754|\t\t\t\t}\n755|\t\t\t\tif decision.Cause == nil {\n756|\t\t\t\t\tt.Fatal(\"Decide() refusal carries no cause\")\n757|\t\t\t\t}\n758|\t\t\t\tif decision.HasToken {\n759|\t\t\t\t\tt.Fatal(\"Decide() refusal mints a fencing token\")\n760|\t\t\t\t}\n761|\t\t\tcase ActionParked:\n762|\t\t\t\tif decision.ParkReason != testRow.wantReason || decision.WinningLeaseID != testRow.wantLease {\n763|\t\t\t\t\tt.Fatalf(\"Decide() park = (%q, %q), want (%q, %q)\",\n764|\t\t\t\t\t\tdecision.ParkReason, decision.WinningLeaseID, testRow.wantReason, testRow.wantLease)\n765|\t\t\t\t}\n766|\t\t\t\tif decision.Cause == nil {\n767|\t\t\t\t\tt.Fatal(\"Decide() park carries no cause\")\n768|\t\t\t\t}\n769|\t\t\t\tif decision.HasToken {\n770|\t\t\t\t\tt.Fatal(\"Decide() park mints a fencing token\")\n771|\t\t\t\t}\n772|\t\t\tcase ActionAttachRemote, ActionTakeoverOffer:\n773|\t\t\t\tif decision.ParkReason != fencing.ParkRemoteOwner || decision.WinningLeaseID != testRow.wantLease {\n774|\t\t\t\t\tt.Fatalf(\"Decide() offer = (%q, %q), want (remote_owner, %q)\",\n775|\t\t\t\t\t\tdecision.ParkReason, decision.WinningLeaseID, testRow.wantLease)\n776|\t\t\t\t}\n777|\t\t\t\tif decision.HasToken {\n778|\t\t\t\t\tt.Fatal(\"Decide() offer mints a fencing token\")\n779|\t\t\t\t}\n780|\t\t\tcase ActionLaunch, ActionReattach:\n781|\t\t\t\tif !decision.HasToken {\n782|\t\t\t\t\tt.Fatal(\"Decide() launch-path outcome carries no fencing token\")\n783|\t\t\t\t}\n784|\t\t\t}\n785|\t\t})\n786|\t}\n787|}\n788|\n789|func smokeTarget() axerror.TargetAuth {\n790|\treturn axerror.TargetAuth{\n791|\t\tProviderID:           \"codex\",\n792|\t\tProviderBuild:        \"0.147.0\",\n793|\t\tMacOSVersion:         \"14.5\",\n794|\t\tTmuxServerGeneration: \"generation-alpha\",\n795|\t\tRemediation:          \"rerun provider-auth smoke\",\n796|\t}\n797|}\n798|\n799|// TestDecideAfterRestoreSequence pins the §4.2 after-restore steps\n800|// 1-5 as a scenario table over the restore mode: read the local\n801|// lease, attempt the bounded mesh refresh, resume locally only with\n802|// the winning lease and a valid required materialization, offer\n803|// remote attach/takeover for a remote interactive owner, and park\n804|// in all other cases.\n805|func TestDecideAfterRestoreSequence(t *testing.T) {\n806|\tt.Parallel()\n807|\tt.Run(\"step3_resume_winning_lease_valid_materialization\", func(t *testing.T) {\n808|\t\tt.Parallel()\n809|\t\tdeps := buildDecideDeps(t, true)\n810|\t\tinput := validInput(t, deps)\n811|\t\tinput.Mode = ModeRestore\n812|\t\tinput.MaterializationRequired = true\n813|\t\tinput.Journal = matjournal.Journal{Phase: matjournal.PhaseCommitted}\n814|\t\tinput.JournalOK = true\n815|\t\tinput.CheckpointRequired = true\n816|\t\tinput.CheckpointDoc = deps.ckptDoc\n817|\t\tinput.CheckpointID = deps.ckptID\n818|\t\tdecision := Decide(input)\n819|\t\tif decision.Action != ActionLaunch {\n820|\t\t\tt.Fatalf(\"after-restore step 3 action = %q, cause %v, want launch\", decision.Action, decision.Cause)\n821|\t\t}\n822|\t})\n823|\tt.Run(\"step3_materializing_parks\", func(t *testing.T) {\n824|\t\tt.Parallel()\n825|\t\tdeps := buildDecideDeps(t, true)\n826|\t\tinput := validInput(t, deps)\n827|\t\tinput.Mode = ModeRestore\n828|\t\tinput.MaterializationRequired = true\n829|\t\tinput.Journal = matjournal.Journal{Phase: matjournal.PhaseValidating}\n830|\t\tinput.JournalOK = true\n831|\t\tdecision := Decide(input)\n832|\t\tif decision.Action != ActionParked || decision.ParkReason != fencing.ParkRestorePolicy {\n833|\t\t\tt.Fatalf(\"after-restore materializing action = %q (%q), want parked (restore_policy)\", decision.Action, decision.ParkReason)\n834|\t\t}\n835|\t})\n836|\tt.Run(\"step4_remote_interactive_attach\", func(t *testing.T) {\n837|\t\tt.Parallel()\n838|\t\tdeps := buildDecideDeps(t, true)\n839|\t\tinput := validInput(t, deps)\n840|\t\tinput.Mode = ModeRestore\n841|\t\tinput.Observation.Winner.HolderHostID = fixtureRemoteHost\n842|\t\tinput.RemoteInteractive = true\n843|\t\tdecision := Decide(input)\n844|\t\tif decision.Action != ActionAttachRemote {\n845|\t\t\tt.Fatalf(\"after-restore step 4 action = %q, want attach_remote\", decision.Action)\n846|\t\t}\n847|\t})\n848|\tt.Run(\"step4_remote_noninteractive_takeover\", func(t *testing.T) {\n849|\t\tt.Parallel()\n850|\t\tdeps := buildDecideDeps(t, true)\n851|\t\tinput := validInput(t, deps)\n852|\t\tinput.Mode = ModeRestore\n853|\t\tinput.Observation.Winner.HolderHostID = fixtureRemoteHost\n854|\t\tinput.RemoteInteractive = false\n855|\t\tdecision := Decide(input)\n856|\t\tif decision.Action != ActionTakeoverOffer {\n857|\t\t\tt.Fatalf(\"after-restore step 4 action = %q, want takeover_offer\", decision.Action)\n858|\t\t}\n859|\t})\n860|\tt.Run(\"step5_unverified_parks\", func(t *testing.T) {\n861|\t\tt.Parallel()\n862|\t\tdeps := buildDecideDeps(t, true)\n863|\t\tinput := validInput(t, deps)\n864|\t\tinput.Mode = ModeRestore\n865|\t\tinput.Observation.Verified = false\n866|\t\tdecision := Decide(input)\n867|\t\tif decision.Action != ActionParked || decision.ParkReason != fencing.ParkRestorePolicy {\n868|\t\t\tt.Fatalf(\"after-restore step 5 action = %q (%q), want parked (restore_policy)\", decision.Action, decision.ParkReason)\n869|\t\t}\n870|\t})\n871|\tt.Run(\"step1_no_local_lease_parks_without_winner\", func(t *testing.T) {\n872|\t\tt.Parallel()\n873|\t\tdeps := buildDecideDeps(t, true)\n874|\t\tinput := validInput(t, deps)\n875|\t\tinput.Mode = ModeRestore\n876|\t\tinput.Observation.HasWinner = false\n877|\t\tinput.Observation.Winner = sessrepo.LeaseSummary{}\n878|\t\tdecision := Decide(input)\n879|\t\tif decision.Action != ActionParked || decision.WinningLeaseID != \"\" {\n880|\t\t\tt.Fatalf(\"after-restore step 1 action = %q (%q), want parked with no winner\", decision.Action, decision.WinningLeaseID)\n881|\t\t}\n882|\t})\n883|}\n884|\n885|// TestDecideTypedRefusals pins the Structured Error composition of\n886|// the two typed refusals: capability_unavailable carries the §15.3\n887|// realm/readiness details and target_auth_missing the target-auth\n888|// details.\n889|func TestDecideTypedRefusals(t *testing.T) {\n890|\tt.Parallel()\n891|\tt.Run(\"capability_unavailable_details\", func(t *testing.T) {\n892|\t\tt.Parallel()\n893|\t\tdeps := buildDecideDeps(t, true)\n894|\t\tinput := validInput(t, deps)\n895|\t\tinput.Realm.Caller = CallerBackground\n896|\t\tdecision := Decide(input)\n897|\t\tif decision.Action != ActionRefused || decision.Class != \"capability_unavailable\" {\n898|\t\t\tt.Fatalf(\"Decide() = (%q, %q), want (refused, capability_unavailable)\", decision.Action, decision.Class)\n899|\t\t}\n900|\t\tif decision.RealmFailure == nil {\n901|\t\t\tt.Fatal(\"Decide() capability_unavailable carries no typed failure\")\n902|\t\t}\n903|\t\tif got := string(decision.RealmFailure.Code()); got != \"capability_unavailable\" {\n904|\t\t\tt.Fatalf(\"RealmFailure code = %q\", got)\n905|\t\t}\n906|\t})\n907|\tt.Run(\"target_auth_missing_details\", func(t *testing.T) {\n908|\t\tt.Parallel()\n909|\t\tdeps := buildDecideDeps(t, true)\n910|\t\tinput := validInput(t, deps)\n911|\t\tinput.Smoke.Required = true\n912|\t\tinput.Smoke.Target = smokeTarget()\n913|\t\tdecision := Decide(input)\n914|\t\tif decision.Action != ActionRefused || decision.Class != \"target_auth_missing\" {\n915|\t\t\tt.Fatalf(\"Decide() = (%q, %q), want (refused, target_auth_missing)\", decision.Action, decision.Class)\n916|\t\t}\n917|\t\tif decision.RealmFailure == nil {\n918|\t\t\tt.Fatal(\"Decide() target_auth_missing carries no typed failure\")\n919|\t\t}\n920|\t})\n921|}\n922|\n923|// TestRealmCarriesNoCachedEvidence pins the §4.2 cached-evidence\n924|// rule structurally: the Realm input has exactly the foreground/\n925|// background caller, the attested-server fact, and the typed\n926|// realm/readiness details. No member accepts a cached sentinel\n927|// result or a managername observation, so neither can authorize\n928|// resume through any input value.\n929|func TestRealmCarriesNoCachedEvidence(t *testing.T) {\n930|\tt.Parallel()\n931|\tfields := map[string]bool{}\n932|\tfor index := 0; index < reflect.TypeOf(Realm{}).NumField(); index++ {\n933|\t\tfields[reflect.TypeOf(Realm{}).Field(index).Name] = true\n934|\t}\n935|\twant := map[string]bool{\n936|\t\t\"Caller\": true, \"AttestedServer\": true, \"BrokerState\": true,\n937|\t\t\"ServerGeneration\": true, \"Remediation\": true,\n938|\t}\n939|\tif !reflect.DeepEqual(fields, want) {\n940|\t\tt.Fatalf(\"Realm fields = %v, want exactly %v\", fields, want)\n941|\t}\n942|}\n943|\n944|// TestDecideForgedTokensRefuse pins the token side of every\n945|// non-launch outcome: parked, refused, and offer decisions carry\n946|// the zero token, and the zero token refuses every provider\n947|// operation through the fencing owner.\n948|func TestDecideForgedTokensRefuse(t *testing.T) {\n949|\tt.Parallel()\n950|\tdeps := buildDecideDeps(t, true)\n951|\tinput := validInput(t, deps)\n952|\tinput.Observation.Verified = false\n953|\tdecision := Decide(input)\n954|\tif decision.Action != ActionParked || decision.HasToken {\n955|\t\tt.Fatalf(\"Decide() = (%q, hasToken %v), want parked with no token\", decision.Action, decision.HasToken)\n956|\t}\n957|\tfor _, operation := range []fencing.ProviderOperation{fencing.ProviderQuiesce, fencing.ProviderCapture, fencing.ProviderMaterialize} {\n958|\t\tif _, err := decision.Token.Bind(operation); err == nil {\n959|\t\t\tt.Fatalf(\"Token.Bind(%q) on a parked decision succeeded, want refusal\", string(operation))\n960|\t\t}\n961|\t}\n962|}\n963|\n964|// TestDecideProfileSourcePinsEvent pins the PROFILE-DIRECT-RESUME\n965|// direction: the launch carries the newest authoritative\n966|// profile.changed event as its source, never the creation value,\n967|// when the closure contains a later change.\n968|func TestDecideProfileSourcePinsEvent(t *testing.T) {\n969|\tt.Parallel()\n970|\tdeps := buildDecideDeps(t, true)\n971|\tchanged := appendChainEvent(t, deps.repo, \"profile.changed\", 1, fixtureLeaseA, 2, deps.createdID, map[string]any{\n972|\t\t\"from\": \"standard\", \"to\": \"yolo\", \"confirmed\": true,\n973|\t})\n974|\tinput := validInput(t, deps)\n975|\tdecision := Decide(input)\n976|\tif decision.Action != ActionLaunch {\n977|\t\tt.Fatalf(\"Decide() action = %q, cause %v, want launch\", decision.Action, decision.Cause)\n978|\t}\n979|\tif !decision.Profile.HasSource || decision.Profile.Source != changed {\n980|\t\tt.Fatalf(\"Decide() profile source = %+v, want the change event %s\", decision.Profile, changed)\n981|\t}\n982|}","final_result":true}}}
