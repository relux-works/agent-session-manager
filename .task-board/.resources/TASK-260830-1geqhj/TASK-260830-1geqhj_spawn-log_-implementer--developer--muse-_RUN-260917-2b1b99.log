s[len(events)-1].EventID\n40|\tckptStore, err := sessckpt.Open(t.TempDir())\n41|\tif err != nil {\n42|\t\tt.Fatal(err)\n43|\t}\n44|\tdeps.ckptID, deps.ckptDoc = checkpointFixture(t, deps.repo, ckptStore, []string{deps.createdID})\n45|\treturn deps\n46|}\n47|\n48|// validInput returns the ModeLaunch base that launches: every gate\n49|// passes through its landed owner with real documents.\n50|func validInput(t *testing.T, deps *decideDeps) Input {\n51|\tt.Helper()\n52|\tnow := fixtureNow()\n53|\tdescriptor, err := BuildDescriptor(DescriptorParams{\n54|\t\tBinding: BindingRef{\n55|\t\t\tBindingDigest:         deps.universe.hostBinding().TerminalBindingID,\n56|\t\t\tBackendID:             deps.universe.hostBinding().BackendID,\n57|\t\t\tImplementationVersion: deps.universe.hostBinding().ImplementationVersion,\n58|\t\t\tProtocolVersion:       deps.universe.hostBinding().ProtocolVersion,\n59|\t\t\tGeneration:            deps.universe.hostBinding().Generation,\n60|\t\t},\n61|\t\tInstanceID:  fixtureInstance,\n62|\t\tInteractive: true,\n63|\t\tColumns:     80,\n64|\t\tRows:        24,\n65|\t})\n66|\tif err != nil {\n67|\t\tt.Fatalf(\"BuildDescriptor() error = %v\", err)\n68|\t}\n69|\trecord, events, err := LoadProfile(deps.repo, fixtureSession)\n70|\tif err != nil {\n71|\t\tt.Fatalf(\"LoadProfile() error = %v\", err)\n72|\t}\n73|\treturn Input{\n74|\t\tSessionID:            fixtureSession,\n75|\t\tBootstrapOperationID: fixtureBootstrap,\n76|\t\tMode:                 ModeLaunch,\n77|\t\tSessionKnown:         true,\n78|\t\tPresented:            fixturePresented(),\n79|\t\tObservation:          fixtureObservation(now),\n80|\t\tBackend:              deps.universe.facts(t),\n81|\t\tProfileRecord:        record,\n82|\t\tProfileEvents:        events,\n83|\t\tProvider: ProviderFacts{\n84|\t\t\tBuild:    fixtureBuild(),\n85|\t\t\tIdentity: fixtureIdentity(t),\n86|\t\t},\n87|\t\tRealm: Realm{\n88|\t\t\tCaller:           CallerForeground,\n89|\t\t\tBrokerState:      \"broker-running\",\n90|\t\t\tServerGeneration: \"generation-alpha\",\n91|\t\t\tRemediation:      \"launch the aqua broker\",\n92|\t\t},\n93|\t\tEntrypoint:  []string{\"ax\", \"pane\", fixtureSession},\n94|\t\tDescriptor:  descriptor,\n95|\t\tHostBinding: deps.universe.hostBinding(),\n96|\t}\n97|}\n98|\n99|func lapsedObservation(now time.Time) fencing.Observation {\n100|\tobservation := fixtureObservation(now)\n101|\tobservation.Grant.ValidatedAt = now.Add(-2 * time.Hour)\n102|\treturn observation\n103|}\n104|\n105|func TestDecideLaunchPositive(t *testing.T) {\n106|\tt.Parallel()\n107|\tdeps := buildDecideDeps(t, true)\n108|\tdecision := Decide(validInput(t, deps))\n109|\tif decision.Action != ActionLaunch {\n110|\t\tt.Fatalf(\"Decide() action = %q, detail %q, cause %v, want launch\", decision.Action, decision.Detail, decision.Cause)\n111|\t}\n112|\tif !decision.HasToken {\n113|\t\tt.Fatal(\"Decide() launch carries no fencing token\")\n114|\t}\n115|\tbound, err := decision.Token.Bind(fencing.ProviderQuiesce)\n116|\tif err != nil {\n117|\t\tt.Fatalf(\"Token.Bind(quiesce) error = %v\", err)\n118|\t}\n119|\tif bound.SessionID != fixtureSession || bound.Epoch != 1 || bound.LeaseID != fixtureLeaseA {\n120|\t\tt.Fatalf(\"Token.Bind(quiesce) = %+v, want the winning triple\", bound)\n121|\t}\n122|\tif decision.Profile.Profile != \"standard\" || decision.Profile.HasSource {\n123|\t\tt.Fatalf(\"Decide() profile = %+v, want standard with no source\", decision.Profile)\n124|\t}\n125|\tif decision.Mapping != \"\" {\n126|\t\tt.Fatalf(\"Decide() mapping = %q, want empty for standard\", decision.Mapping)\n127|\t}\n128|\tif !decision.Admitted.Has(\"headless_creation\") {\n129|\t\tt.Fatalf(\"Decide() admitted = %v, want headless_creation\", decision.Admitted.Capabilities)\n130|\t}\n131|\tif decision.Descriptor.TerminalInstanceID != fixtureInstance {\n132|\t\tt.Fatalf(\"Decide() descriptor instance = %q, want the supplied instance\", decision.Descriptor.TerminalInstanceID)\n133|\t}\n134|}\n135|\n136|// TestDecideRestoreRequiresRestoreCapability pins the mode-selected\n137|// capability row: a backend admitting restore but not create\n138|// launches in restore mode. Forcing the create row (the N-backend-op\n139|// mutant) refuses capability_unproven instead.\n140|func TestDecideRestoreRequiresRestoreCapability(t *testing.T) {\n141|\tt.Parallel()\n142|\tdeps := buildDecideDeps(t, true)\n143|\tdrop := map[string]bool{\"durable_disconnect\": true, \"headless_creation\": true}\n144|\tkeepClaims := func(claims []any) []any {\n145|\t\tkept := make([]any, 0, len(claims))\n146|\t\tfor _, raw := range claims {\n147|\t\t\tif !drop[raw.(map[string]any)[\"capability\"].(string)] {\n148|\t\t\t\tkept = append(kept, raw)\n149|\t\t\t}\n150|\t\t}\n151|\t\treturn kept\n152|\t}\n153|\tdeps.universe.manifest[\"static_capability_claims\"] = keepClaims(deps.universe.manifest[\"static_capability_claims\"].([]any))\n154|\tdeps.universe.probe[\"capability_claims\"] = keepClaims(deps.universe.probe[\"capability_claims\"].([]any))\n155|\tkeptEvidence := deps.universe.evidence[:0]\n156|\tfor _, object := range deps.universe.evidence {\n157|\t\tif !drop[object[\"capability\"].(string)] {\n158|\t\t\tkeptEvidence = append(keptEvidence, object)\n159|\t\t}\n160|\t}\n161|\tdeps.universe.evidence = keptEvidence\n162|\tvar ids []any\n163|\tfor _, object := range deps.universe.evidence {\n164|\t\tids = append(ids, object[\"evidence_id\"])\n165|\t}\n166|\tsort.Slice(ids, func(i, j int) bool { return ids[i].(string) < ids[j].(string) })\n167|\tdeps.universe.probe[\"evidence_ids\"] = ids\n168|\tdeps.universe.manifest[\"manifest_id\"] = omitSelfIdentity(t, deps.universe.manifest, \"manifest_id\")\n169|\tdeps.universe.probe[\"probe_id\"] = omitSelfIdentity(t, deps.universe.probe, \"probe_id\")\n170|\tinput := validInput(t, deps)\n171|\tinput.Mode = ModeRestore\n172|\tdecision := Decide(input)\n173|\tif decision.Action != ActionLaunch {\n174|\t\tt.Fatalf(\"Decide() restore action = %q, cause %v, want launch\", decision.Action, decision.Cause)\n175|\t}\n176|\tif !decision.Admitted.Has(\"reboot_restoration\") {\n177|\t\tt.Fatalf(\"Decide() admitted = %v, want reboot_restoration\", decision.Admitted.Capabilities)\n178|\t}\n179|}\n180|\n181|func TestDecideYoloMapping(t *testing.T) {\n182|\tt.Parallel()\n183|\tdeps := buildDecideDeps(t, true)\n184|\tappendChainEvent(t, deps.repo, \"profile.changed\", 1, fixtureLeaseA, 2, deps.createdID, map[string]any{\n185|\t\t\"from\": \"standard\", \"to\": \"yolo\", \"confirmed\": true,\n186|\t})\n187|\tinput := validInput(t, deps)\n188|\tdecision := Decide(input)\n189|\tif decision.Action != ActionLaunch {\n190|\t\tt.Fatalf(\"Decide() action = %q, detail %q, cause %v, want launch\", decision.Action, decision.Detail, decision.Cause)\n191|\t}\n192|\tif decision.Profile.Profile != \"yolo\" || !decision.Profile.HasSource {\n193|\t\tt.Fatalf(\"Decide() profile = %+v, want yolo with a source\", decision.Profile)\n194|\t}\n195|\tif decision.Mapping != \"--dangerously-bypass-approvals-and-sandbox\" {\n196|\t\tt.Fatalf(\"Decide() mapping = %q, want the codex yolo flag\", decision.Mapping)\n197|\t}\n198|}\n199|\n200|func TestDecideTable(t *testing.T) {\n201|\tt.Parallel()\n202|\tnow := fixtureNow()\n203|\tcommitted := matjournal.Journal{Phase: matjournal.PhaseCommitted}\n204|\tstaging := matjournal.Journal{Phase: matjournal.PhaseStaging}\n205|\n206|\ttype row struct {\n207|\t\tname        string\n208|\t\tattachProbe bool\n209|\t\tuniverse    func(t *testing.T, universe *backendUniverse)\n210|\t\tmutate      func(t *testing.T, deps *decideDeps, input *Input)\n211|\t\twant        Action\n212|\t\twantClass   string\n213|\t\twantReason  fencing.ParkReason\n214|\t\twantLease   string\n215|\t}\n216|\trows := []row{\n217|\t\t{\n218|\t\t\tname: \"launch_restore_committed_checkpoint\",\n219|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n220|\t\t\t\tinput.Mode = ModeRestore\n221|\t\t\t\tinput.MaterializationRequired = true\n222|\t\t\t\tinput.Journal = committed\n223|\t\t\t\tinput.JournalOK = true\n224|\t\t\t\tinput.CheckpointRequired = true\n225|\t\t\t\tinput.CheckpointDoc = deps.ckptDoc\n226|\t\t\t\tinput.CheckpointID = deps.ckptID\n227|\t\t\t},\n228|\t\t\twant: ActionLaunch,\n229|\t\t},\n230|\t\t{\n231|\t\t\tname: \"reattach_same_pair\",\n232|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n233|\t\t\t\tinput.ExistingBinding = &Binding{SessionID: fixtureSession, OperationID: fixtureBootstrap, TerminalInstanceID: fixtureInstance, BindingDigest: seedDigest(0xB1), CreatedAt: fixtureCreatedAt}\n234|\t\t\t},\n235|\t\t\twant: ActionReattach,\n236|\t\t},\n237|\t\t{\n238|\t\t\tname: \"attach_remote_interactive\",\n239|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n240|\t\t\t\tinput.Observation.Winner.HolderHostID = fixtureRemoteHost\n241|\t\t\t\tinput.RemoteInteractive = true\n242|\t\t\t},\n243|\t\t\twant:      ActionAttachRemote,\n244|\t\t\twantLease: fixtureLeaseA,\n245|\t\t},\n246|\t\t{\n247|\t\t\tname: \"takeover_offer_noninteractive\",\n248|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n249|\t\t\t\tinput.Observation.Winner.HolderHostID = fixtureRemoteHost\n250|\t\t\t\tinput.RemoteInteractive = false\n251|\t\t\t},\n252|\t\t\twant:      ActionTakeoverOffer,\n253|\t\t\twantLease: fixtureLeaseA,\n254|\t\t},\n255|\t\t{\n256|\t\t\tname:        \"takeover_offer_attach_unproven\",\n257|\t\t\tattachProbe: true,\n258|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n259|\t\t\t\tinput.Observation.Winner.HolderHostID = fixtureRemoteHost\n260|\t\t\t\tinput.RemoteInteractive = true\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
