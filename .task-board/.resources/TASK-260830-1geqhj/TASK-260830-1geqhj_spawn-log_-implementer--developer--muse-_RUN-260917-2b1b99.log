{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c72f","stream":{"kind":"session","id":"01a0b0ab-f92f-74d3-a245-61ad42401b4b"},"sequence":498,"recorded_at":1780531400000991,"record_type":"event","durability":"durable","causation_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","run_stream":{"kind":"run","id":"8ab0c8df-167f-48db-b83c-f756aeede0a9"},"task_stream":{"kind":"task","id":"01a0b0ad-e11a-7720-b664-3f835c3a51f5"},"task_id":"01a0b0ad-e11a-7720-b664-3f835c3a51f5","event":{"kind":"output","task_id":"01a0b0ad-e11a-7720-b664-3f835c3a51f5","chunk":"Read text file `internal/axpane/decide.go`.\n(499 line(s) above)\n500|\tdigest, _, err := sessrepo.AttestCheckpointRecord(doc)\n501|\tif err != nil {\n502|\t\treturn err\n503|\t}\n504|\tif digest.String() != want {\n505|\t\treturn errCheckpointMismatch()\n506|\t}\n507|\treturn nil\n508|}\n509|\n510|// checkProviderIdentity composes the provhost resume gate: the exact\n511|// probed build tuple must pass the Section 8.4 direction, the stored\n512|// identity must validate for that provider at that exact version,\n513|// and the discovery proof, when present, must bind to the host-side\n514|// facts.\n515|func checkProviderIdentity(facts ProviderFacts) error {\n516|\tif err := provhost.CheckResumeTuple(facts.Build); err != nil {\n517|\t\treturn err\n518|\t}\n519|\tif err := provhost.VerifyIdentityBuild(facts.Identity, facts.Build); err != nil {\n520|\t\treturn err\n521|\t}\n522|\tif facts.HasDiscovery {\n523|\t\tif err := provhost.VerifyIdentityDiscovery(facts.Identity, facts.Discovery, facts.DiscoveryContext); err != nil {\n524|\t\t\treturn err\n525|\t\t}\n526|\t}\n527|\treturn nil\n528|}\n529|\n530|// checkSmoke enforces the provider-auth smoke precondition when the\n531|// path requires provider credentials. The stored record must verify\n532|// through the resumesmoke owner, its verdict must be pass, and its\n533|// exact claimed build must equal the probed build: a smoke result\n534|// for one build never authorizes another. A required smoke that is\n535|// absent, unverifiable, failing, or bound to another build refuses\n536|// target_auth_missing with the typed details Section 15.3 names.\n537|func checkSmoke(input Input) error {\n538|\tif !input.Smoke.Required {\n539|\t\treturn nil\n540|\t}\n541|\trecord, err := resumesmoke.VerifyRecord(input.Smoke.Record)\n542|\tif err != nil {\n543|\t\treturn smokeFailure(input, err)\n544|\t}\n545|\tif record.Verdict != resumesmoke.VerdictPass {\n546|\t\treturn smokeFailure(input, errSmokeVerdict(record.Verdict))\n547|\t}\n548|\tbuild := input.Provider.Build\n549|\tif record.Tuple.ProviderID != build.ProviderID ||\n550|\t\trecord.Tuple.ProviderVersion != build.ProviderVersion ||\n551|\t\trecord.Tuple.Platform != build.Platform ||\n552|\t\trecord.Tuple.Architecture != build.Architecture {\n553|\t\treturn smokeFailure(input, errSmokeTuple())\n554|\t}\n555|\treturn nil\n556|}\n557|\n558|// smokeFailure composes the typed target_auth_missing refusal. Typed\n559|// details are required members of the input: an input that omits\n560|// one is itself malformed and refuses invalid_arguments instead of\n561|// emitting an untyped refusal.\n562|func smokeFailure(input Input, cause error) error {\n563|\tfailure, err := axerror.NewTargetAuthMissing(axerror.Version130,\n564|\t\t\"provider-auth smoke did not pass for the probed build\",\n565|\t\taxerror.NoIDs(), input.Smoke.Target, cause)\n566|\tif err != nil {\n567|\t\treturn fmt.Errorf(\"%w: smoke refusal details are incomplete: %v\", errInvalidArguments{}, err)\n568|\t}\n569|\treturn failure\n570|}\n571|\n572|// checkRealm enforces the §4.2 background-caller rule: a background\n573|// caller may contact an already-running authenticated Aqua broker\n574|// and its attested AX tmux server, and otherwise returns\n575|// capability_unavailable with typed realm/readiness details. It\n576|// never falls back to direct server creation. A foreground caller\n577|// passes; there is no cached-sentinel or managername arm to pass\n578|// through, because neither authorizes resume. Typed details are\n579|// required input members: an input that omits one is itself\n580|// malformed and refuses invalid_arguments instead of emitting an\n581|// untyped capability_unavailable.\n582|func checkRealm(input Input) error {\n583|\tif input.Realm.Caller != CallerBackground {\n584|\t\treturn nil\n585|\t}\n586|\tif input.Realm.AttestedServer {\n587|\t\treturn nil\n588|\t}\n589|\tevidence := axerror.RealmEvidence{\n590|\t\tCapability:           \"credential_capable_execution_realm\",\n591|\t\tCallerRealm:          input.Realm.Caller,\n592|\t\tBrokerState:          input.Realm.BrokerState,\n593|\t\tTmuxServerGeneration: input.Realm.ServerGeneration,\n594|\t\tRemediation:          input.Realm.Remediation,\n595|\t}\n596|\tfailure, err := axerror.NewRealmEvidenceUnavailable(axerror.Version130,\n597|\t\t\"background caller has no attested tmux server\",\n598|\t\taxerror.NoIDs(), evidence, errNoAttestedServer())\n599|\tif err != nil {\n600|\t\treturn errInvalidArguments{detail: \"background caller realm details are incomplete\"}\n601|\t}\n602|\treturn failure\n603|}\n604|\n605|// checkRealmVocabulary closes the caller vocabulary: only\n606|// foreground and background name a caller.\n607|func checkRealmVocabulary(caller string) error {\n608|\tif caller != CallerForeground && caller != CallerBackground {\n609|\t\treturn errUnknownCaller(caller)\n610|\t}\n611|\treturn nil\n612|}\n613|\n614|// backendClass reads the Section 15 code off a terminalbackend\n615|// refusal. Landed codes pass through verbatim.\n616|func backendClass(err error) string {\n617|\tvar backend *terminalbackend.Error\n618|\tif errors.As(err, &backend) {\n619|\t\treturn backend.Code\n620|\t}\n621|\treturn terminalbackend.CodeMismatch\n622|}\n623|\n624|// fencingClass reads the Section 15 class off a fencing refusal:\n625|// invalid_arguments for malformed calls, lease_conflict for\n626|// foreign sessions and lapsed grants. Parks never reach here;\n627|// decideParked owns them.\n628|func fencingClass(err error) string {\n629|\tif errors.Is(err, fencing.ErrInvalidArguments) {\n630|\t\treturn ClassInvalidArguments\n631|\t}\n632|\treturn \"lease_conflict\"\n633|}\n634|\n635|// providerClass reads the Structured Error code off a provhost\n636|// refusal: invalid_config for tuple and mapping grammar, the\n637|// provider protocol code for identity and discovery failures.\n638|func providerClass(err error) string {\n639|\tvar failure *axerror.Error\n640|\tif errors.As(err, &failure) {\n641|\t\treturn string(failure.Code())\n642|\t}\n643|\treturn ClassInvalidConfig\n644|}\n645|\n646|// smokeClass reads the Structured Error code off a smoke refusal:\n647|// target_auth_missing for a required smoke that fails, or\n648|// invalid_arguments for a malformed smoke input.\n649|func smokeClass(err error) string {\n650|\tvar failure *axerror.Error\n651|\tif errors.As(err, &failure) {\n652|\t\treturn string(failure.Code())\n653|\t}\n654|\tvar malformed errInvalidArguments\n655|\tif errors.As(err, &malformed) {\n656|\t\treturn ClassInvalidArguments\n657|\t}\n658|\treturn \"target_auth_missing\"\n659|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c731","stream":{"kind":"session","id":"01a0b0ab-f92f-74d3-a245-61ad42401b4b"},"sequence":499,"recorded_at":1780531400000993,"record_type":"event","durability":"durable","causation_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","run_stream":{"kind":"run","id":"8ab0c8df-167f-48db-b83c-f756aeede0a9"},"task_stream":{"kind":"task","id":"01a0b0ad-e11a-7720-b664-3f835c3a51f5"},"task_id":"01a0b0ad-e11a-7720-b664-3f835c3a51f5","event":{"kind":"completed","task_id":"01a0b0ad-e11a-7720-b664-3f835c3a51f5"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c733","stream":{"kind":"session","id":"01a0b0ab-f92f-74d3-a245-61ad42401b4b"},"sequence":500,"recorded_at":1780531400000995,"record_type":"event","durability":"durable","causation_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","run_stream":{"kind":"run","id":"8ab0c8df-167f-48db-b83c-f756aeede0a9"},"call_id":"call_01a0b0addaa87065847068472b384ec2","text":"Read text file `internal/axpane/decide.go`.\n(499 line(s) above)\n500|\tdigest, _, err := sessrepo.AttestCheckpointRecord(doc)\n501|\tif err != nil {\n502|\t\treturn err\n503|\t}\n504|\tif digest.String() != want {\n505|\t\treturn errCheckpointMismatch()\n506|\t}\n507|\treturn nil\n508|}\n509|\n510|// checkProviderIdentity composes the provhost resume gate: the exact\n511|// probed build tuple must pass the Section 8.4 direction, the stored\n512|// identity must validate for that provider at that exact version,\n513|// and the discovery proof, when present, must bind to the host-side\n514|// facts.\n515|func checkProviderIdentity(facts ProviderFacts) error {\n516|\tif err := provhost.CheckResumeTuple(facts.Build); err != nil {\n517|\t\treturn err\n518|\t}\n519|\tif err := provhost.VerifyIdentityBuild(facts.Identity, facts.Build); err != nil {\n520|\t\treturn err\n521|\t}\n522|\tif facts.HasDiscovery {\n523|\t\tif err := provhost.VerifyIdentityDiscovery(facts.Identity, facts.Discovery, facts.DiscoveryContext); err != nil {\n524|\t\t\treturn err\n525|\t\t}\n526|\t}\n527|\treturn nil\n528|}\n529|\n530|// checkSmoke enforces the provider-auth smoke precondition when the\n531|// path requires provider credentials. The stored record must verify\n532|// through the resumesmoke owner, its verdict must be pass, and its\n533|// exact claimed build must equal the probed build: a smoke result\n534|// for one build never authorizes another. A required smoke that is\n535|// absent, unverifiable, failing, or bound to another build refuses\n536|// target_auth_missing with the typed details Section 15.3 names.\n537|func checkSmoke(input Input) error {\n538|\tif !input.Smoke.Required {\n539|\t\treturn nil\n540|\t}\n541|\trecord, err := resumesmoke.VerifyRecord(input.Smoke.Record)\n542|\tif err != nil {\n543|\t\treturn smokeFailure(input, err)\n544|\t}\n545|\tif record.Verdict != resumesmoke.VerdictPass {\n546|\t\treturn smokeFailure(input, errSmokeVerdict(record.Verdict))\n547|\t}\n548|\tbuild := input.Provider.Build\n549|\tif record.Tuple.ProviderID != build.ProviderID ||\n550|\t\trecord.Tuple.ProviderVersion != build.ProviderVersion ||\n551|\t\trecord.Tuple.Platform != build.Platform ||\n552|\t\trecord.Tuple.Architecture != build.Architecture {\n553|\t\treturn smokeFailure(input, errSmokeTuple())\n554|\t}\n555|\treturn nil\n556|}\n557|\n558|// smokeFailure composes the typed target_auth_missing refusal. Typed\n559|// details are required members of the input: an input that omits\n560|// one is itself malformed and refuses invalid_arguments instead of\n561|// emitting an untyped refusal.\n562|func smokeFailure(input Input, cause error) error {\n563|\tfailure, err := axerror.NewTargetAuthMissing(axerror.Version130,\n564|\t\t\"provider-auth smoke did not pass for the probed build\",\n565|\t\taxerror.NoIDs(), input.Smoke.Target, cause)\n566|\tif err != nil {\n567|\t\treturn fmt.Errorf(\"%w: smoke refusal details are incomplete: %v\", errInvalidArguments{}, err)\n568|\t}\n569|\treturn failure\n570|}\n571|\n572|// checkRealm enforces the §4.2 background-caller rule: a background\n573|// caller may contact an already-running authenticated Aqua broker\n574|// and its attested AX tmux server, and otherwise returns\n575|// capability_unavailable with typed realm/readiness details. It\n576|// never falls back to direct server creation. A foreground caller\n577|// passes; there is no cached-sentinel or managername arm to pass\n578|// through, because neither authorizes resume. Typed details are\n579|// required input members: an input that omits one is itself\n580|// malformed and refuses invalid_arguments instead of emitting an\n581|// untyped capability_unavailable.\n582|func checkRealm(input Input) error {\n583|\tif input.Realm.Caller != CallerBackground {\n584|\t\treturn nil\n585|\t}\n586|\tif input.Realm.AttestedServer {\n587|\t\treturn nil\n588|\t}\n589|\tevidence := axerror.RealmEvidence{\n590|\t\tCapability:           \"credential_capable_execution_realm\",\n591|\t\tCallerRealm:          input.Realm.Caller,\n592|\t\tBrokerState:          input.Realm.BrokerState,\n593|\t\tTmuxServerGeneration: input.Realm.ServerGeneration,\n594|\t\tRemediation:          input.Realm.Remediation,\n595|\t}\n596|\tfailure, err := axerror.NewRealmEvidenceUnavailable(axerror.Version130,\n597|\t\t\"background caller has no attested tmux server\",\n598|\t\taxerror.NoIDs(), evidence, errNoAttestedServer())\n599|\tif err != nil {\n600|\t\treturn errInvalidArguments{detail: \"background caller realm details are incomplete\"}\n601|\t}\n602|\treturn failure\n603|}\n604|\n605|// checkRealmVocabulary closes the caller vocabulary: only\n606|// foreground and background name a caller.\n607|func checkRealmVocabulary(caller string) error {\n608|\tif caller != CallerForeground && caller != CallerBackground {\n609|\t\treturn errUnknownCaller(caller)\n610|\t}\n611|\treturn nil\n612|}\n613|\n614|// backendClass reads the Section 15 code off a terminalbackend\n615|// refusal. Landed codes pass through verbatim.\n616|func backendClass(err error) string {\n617|\tvar backend *terminalbackend.Error\n618|\tif errors.As(err, &backend) {\n619|\t\treturn backend.Code\n620|\t}\n621|\treturn terminalbackend.CodeMismatch\n622|}\n623|\n624|// fencingClass reads the Section 15 class off a fencing refusal:\n625|// invalid_arguments for malformed calls, lease_conflict for\n626|// foreign sessions and lapsed grants. Parks never reach here;\n627|// decideParked owns them.\n628|func fencingClass(err error) string {\n629|\tif errors.Is(err, fencing.ErrInvalidArguments) {\n630|\t\treturn ClassInvalidArguments\n631|\t}\n632|\treturn \"lease_conflict\"\n633|}\n634|\n635|// providerClass reads the Structured Error code off a provhost\n636|// refusal: invalid_config for tuple and mapping grammar, the\n637|// provider protocol code for identity and discovery failures.\n638|func providerClass(err error) string {\n639|\tvar failure *axerror.Error\n640|\tif errors.As(err, &failure) {\n641|\t\treturn string(failure.Code())\n642|\t}\n643|\treturn ClassInvalidConfig\n644|}\n645|\n646|// smokeClass reads the Structured Error code off a smoke refusal:\n647|// target_auth_missing for a required smoke that fails, or\n648|// invalid_arguments for a malformed smoke input.\n649|func smokeClass(err error) string {\n650|\tvar failure *axerror.Error\n651|\tif errors.As(err, &failure) {\n652|\t\treturn string(failure.Code())\n653|\t}\n654|\tvar malformed errInvalidArguments\n655|\tif errors.As(err, &malformed) {\n656|\t\treturn ClassInvalidArguments\n657|\t}\n658|\treturn \"target_auth_missing\"\n659|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c735","stream":{"kind":"session","id":"01a0b0ab-f92f-74d3-a245-61ad42401b4b"},"sequence":501,"recorded_at":1780531400000997,"record_type":"event","durability":"durable","causation_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","run_stream":{"kind":"run","id":"8ab0c8df-167f-48db-b83c-f756aeede0a9"},"call_id":"call_01a0b0addd2a722fac73c95814b1cd4c","text":"Read text file `internal/axpane/run.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"fmt\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/config\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n10|)\n11|\n12|// Request is the complete Run surface: the session and bootstrap\n13|// operation under decision plus every modeled-caller fact the\n14|// adapters cannot load from the durable stores (sync state,\n15|// provider build and identity, backend documents, realm readiness,\n16|// presentation geometry). The stores supply configuration,\n17|// sessions, leases, journals, checkpoints, and bindings.\n18|type Request struct {\n19|\tSessionID            string\n20|\tBootstrapOperationID string\n21|\tMode                 Mode\n22|\n23|\tConfigInputs    config.Inputs\n24|\tConfigOverrides config.Overrides\n25|\n26|\t// Presented is the local fencing token; Observe carries the\n27|\t// caller-reported sync, handoff, grant, and clock facts.\n28|\tPresented fencing.PresentedToken\n29|\tObserve   fencing.ObserveInput\n30|\n31|\t// Materialization selects the required journal: when Required\n32|\t// is set the adapter loads ID and the decision requires the\n33|\t// committed phase (after-restore step 3).\n34|\tMaterializationID       string\n35|\tMaterializationRequired bool\n36|\n37|\t// Checkpoint selects the resume checkpoint: when Required is\n38|\t// set the adapter loads ID and the decision admits it.\n39|\tCheckpointID       string\n40|\tCheckpointRequired bool\n41|\n42|\tProvider ProviderFacts\n43|\tSmoke    SmokeFacts\n44|\tRealm    Realm\n45|\tBackend  BackendFacts\n46|\n47|\t// Entrypoint is the wrapper argv.\n48|\tEntrypoint []string\n49|\n50|\t// HostBinding is the AX-validated host-local binding subset\n51|\t// the supplied descriptor must match. Geometry and\n52|\t// interactivity shape the supplied descriptor; InstanceID\n53|\t// pins the terminal instance, or mints a fresh UUIDv7 when\n54|\t// empty.\n55|\tHostBinding terminalbackend.InstanceBinding\n56|\tInteractive bool\n57|\tColumns     uint16\n58|\tRows        uint16\n59|\tInstanceID  string\n60|\n61|\t// RemoteInteractive reports that the remote owner holds the\n62|\t// session in an interactive terminal (after-restore step 4).\n63|\tRemoteInteractive bool\n64|\n65|\t// LocalHostID authors parked events; CreatedAt stamps them.\n66|\tLocalHostID string\n67|\tCreatedAt   string\n68|\n69|\t// Hooks arms the bootstrap binding crash boundaries.\n70|\tHooks *Hooks\n71|}\n72|\n73|// Outcome is the one Run result: the decision plus the durable\n74|// effects it authorized. Exactly one effect applies: a launch binds\n75|// the bootstrap pair, a reattach returns the recorded binding, a\n76|// parked or remote-offer decision with an established winner\n77|// authors the parked event, and every other outcome writes nothing.\n78|type Outcome struct {\n79|\tDecision Decision\n80|\t// Binding is the bound receipt on launch and the recorded\n81|\t// receipt on reattach, nil otherwise.\n82|\tBinding *Binding\n83|\t// Event is the authored parked event reference and bytes;\n84|\t// Emitted is false when the decision parks without an\n85|\t// established winner (no authority authors an event) or when\n86|\t// the outcome is neither parked nor a remote offer.\n87|\tEvent     *sessrepo.EventRef\n88|\tEventJSON []byte\n89|\tEmitted   bool\n90|}\n91|\n92|// Run orchestrates the wrapper: validate configuration, load the\n93|// logical session, prove the bootstrap binding state, observe the\n94|// winning lease, load materialization, checkpoint, and profile\n95|// state, decide through the pure core, then apply exactly the\n96|// authorized durable effect. A store failure propagates as an\n97|// error with no decision: unknown is never absence and never a\n98|// launch.\n99|func Run(stores Stores, request Request) (Outcome, error) {\n100|\tempty := Outcome{}\n101|\tif stores.Repo == nil || stores.Pane == nil {\n102|\t\treturn empty, fmt.Errorf(\"axpane run carries no repository or binding store\")\n103|\t}\n104|\t// The request hooks arm a copy of the binding handle: Run never\n105|\t// mutates the caller's store.\n106|\tpane := *stores.Pane\n107|\tpaneStore := pane.WithHooks(request.Hooks)\n108|\tinput := Input{\n109|\t\tSessionID:               request.SessionID,\n110|\t\tBootstrapOperationID:    request.BootstrapOperationID,\n111|\t\tMode:                    request.Mode,\n112|\t\tPresented:               request.Presented,\n113|\t\tProvider:                request.Provider,\n114|\t\tSmoke:                   request.Smoke,\n115|\t\tRealm:                   request.Realm,\n116|\t\tBackend:                 request.Backend,\n117|\t\tEntrypoint:              request.Entrypoint,\n118|\t\tHostBinding:             request.HostBinding,\n119|\t\tRemoteInteractive:       request.RemoteInteractive,\n120|\t\tCheckpointRequired:      request.CheckpointRequired,\n121|\t\tCheckpointID:            request.CheckpointID,\n122|\t\tMaterializationRequired: request.MaterializationRequired,\n123|\t}\n124|\tinput.ConfigErr = ValidateConfig(request.ConfigInputs, request.ConfigOverrides)\n125|\n126|\tknown, _, err := LoadSession(stores.Repo, request.SessionID)\n127|\tif err != nil {\n128|\t\treturn empty, err\n129|\t}\n130|\tinput.SessionKnown = known\n131|\n132|\texisting, found, err := paneStore.Status(request.SessionID)\n133|\tif err != nil {\n134|\t\treturn empty, err\n135|\t}\n136|\tif found {\n137|\t\tduplicate := existing\n138|\t\tinput.ExistingBinding = &duplicate\n139|\t}\n140|\n141|\tvar observation fencing.Observation\n142|\tif known {\n143|\t\tobserved, err := ObserveOwnership(stores.Repo, request.SessionID, request.Observe)\n144|\t\tif err != nil {\n145|\t\t\treturn empty, err\n146|\t\t}\n147|\t\tobservation = observed\n148|\t}\n149|\tinput.Observation = observation\n150|\n151|\tif request.MaterializationRequired {\n152|\t\tif stores.Mat == nil {\n153|\t\t\treturn empty, fmt.Errorf(\"axpane run requires a materialization with no journal store\")\n154|\t\t}\n155|\t\tjournal, admitted, err := LoadMaterialization(stores.Mat, request.MaterializationID)\n156|\t\tif err != nil {\n157|\t\t\treturn empty, err\n158|\t\t}\n159|\t\tinput.Journal = journal\n160|\t\tinput.JournalOK = admitted\n161|\t}\n162|\tif request.CheckpointRequired {\n163|\t\tif stores.Ckpt == nil {\n164|\t\t\treturn empty, fmt.Errorf(\"axpane run requires a checkpoint with no checkpoint store\")\n165|\t\t}\n166|\t\tdoc, err := LoadCheckpoint(stores.Ckpt, request.CheckpointID)\n167|\t\tif err != nil {\n168|\t\t\treturn empty, err\n169|\t\t}\n170|\t\tinput.CheckpointDoc = doc\n171|\t}\n172|\tif known {\n173|\t\trecord, events, err := LoadProfile(stores.Repo, request.SessionID)\n174|\t\tif err != nil {\n175|\t\t\treturn empty, err\n176|\t\t}\n177|\t\tinput.ProfileRecord = record\n178|\t\tinput.ProfileEvents = events\n179|\t}\n180|\n181|\tinstance := request.InstanceID\n182|\tif instance == \"\" {\n183|\t\tminted, err := MintInstanceIDRandom()\n184|\t\tif err != nil {\n185|\t\t\treturn empty, err\n186|\t\t}\n187|\t\tinstance = minted\n188|\t}\n189|\tdescriptorDoc, err := BuildDescriptor(DescriptorParams{\n190|\t\tBinding: BindingRef{\n191|\t\t\tBindingDigest:         request.HostBinding.TerminalBindingID,\n192|\t\t\tBackendID:             request.HostBinding.BackendID,\n193|\t\t\tImplementationVersion: request.HostBinding.ImplementationVersion,\n194|\t\t\tProtocolVersion:       request.HostBinding.ProtocolVersion,\n195|\t\t\tGeneration:            request.HostBinding.Generation,\n196|\t\t},\n197|\t\tInstanceID:  instance,\n198|\t\tInteractive: request.Interactive,\n199|\t\tColumns:     request.Columns,\n200|\t\tRows:        request.Rows,\n201|\t})\n202|\tif err != nil {\n203|\t\treturn empty, err\n204|\t}\n205|\tinput.Descriptor = descriptorDoc\n206|\n207|\tdecision := Decide(input)\n208|\toutcome := Outcome{Decision: decision}\n209|\tswitch decision.Action {\n210|\tcase ActionLaunch:\n211|\t\tcandidate := Binding{\n212|\t\t\tSessionID:          request.SessionID,\n213|\t\t\tOperationID:        request.BootstrapOperationID,\n214|\t\t\tTerminalInstanceID: instance,\n215|\t\t}\n216|\t\tcandidate.BindingDigest = BindingDigest(candidate)\n217|\t\tbound, reattached, err := paneStore.Bind(request.SessionID, request.BootstrapOperationID, candidate)\n218|\t\tif err != nil {\n219|\t\t\t// A concurrent changed-operation commit surfaces\n220|\t\t\t// here as idempotency_mismatch: the caller's retry\n221|\t\t\t// observes the winner through Status and decides\n222|\t\t\t// the refused outcome.\n223|\t\t\treturn empty, err\n224|\t\t}\n225|\t\tif reattached {\n226|\t\t\t// A concurrent wrapper won the bind between Status\n227|\t\t\t// and Bind: the pair is bound, so this run\n228|\t\t\t// reattaches to the recorded child instead of\n229|\t\t\t// launching a second one.\n230|\t\t\toutcome.Decision.Action = ActionReattach\n231|\t\t\toutcome.Decision.Detail = \"reattach to the one recorded wrapper/child\"\n232|\t\t}\n233|\t\tduplicate := bound\n234|\t\toutcome.Binding = &duplicate\n235|\tcase ActionReattach:\n236|\t\tduplicate := *input.ExistingBinding\n237|\t\toutcome.Binding = &duplicate\n238|\tcase ActionParked, ActionAttachRemote, ActionTakeoverOffer:\n239|\t\tif !observation.HasWinner {\n240|\t\t\t// No winner establishes no authority: session.parked\n241|\t\t\t// requires a winning lease ID, so the decision\n242|\t\t\t// parks without authoring an event.\n243|\t\t\treturn outcome, nil\n244|\t\t}\n245|\t\treference, raw, err := emitParked(stores.Repo, decision, observation, request)\n246|\t\tif err != nil {\n247|\t\t\toutcome.Emitted = false\n248|\t\t\treturn outcome, err\n249|\t\t}\n250|\t\toutcome.Event = &reference\n251|\t\toutcome.EventJSON = raw\n252|\t\toutcome.Emitted = true\n253|\t}\n254|\treturn outcome, nil\n255|}\n256|\n257|// emitParked authors the parked event under the winning lease with\n258|// the current chain linkage: the next sequence under the winning\n259|// lease, or sequence 1 referencing the predecessor head when the\n260|// winner succeeded the tail lease.\n261|func emitParked(repository *sessrepo.Repository, decision Decision, observation fencing.Observation, request Request) (sessrepo.EventRef, []byte, error) {\n262|\trecordID, tail, err := ChainTail(repository, request.SessionID)\n263|\tif err != nil {\n264|\t\treturn sessrepo.EventRef{}, nil, err\n265|\t}\n266|\tvar sequence uint64 = 1\n267|\tpredecessors := []string{recordID}\n268|\tif tail != nil {\n269|\t\tif tail.LeaseID == observation.Winner.LeaseID {\n270|\t\t\tsequence = tail.LeaseSequence + 1\n271|\t\t}\n272|\t\tpredecessors = []string{tail.EventID}\n273|\t}\n274|\treturn EmitParked(repository, decision, EmitParams{\n275|\t\tSessionID:     request.SessionID,\n276|\t\tCreatedByHost: request.LocalHostID,\n277|\t\tLeaseEpoch:    observation.Winner.Epoch,\n278|\t\tLeaseID:       observation.Winner.LeaseID,\n279|\t\tLeaseSequence: sequence,\n280|\t\tPredecessors:  predecessors,\n281|\t\tCreatedAt:     request.CreatedAt,\n282|\t})\n283|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
