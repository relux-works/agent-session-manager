input.RemoteInteractive && terminalbackend.CheckOperation(\"attach\", admitted) == nil {\\n',\n276|        replace=\"\\tif input.RemoteInteractive {\\n\",\n277|        count=1,\n278|        run=\"TestDecideTable/takeover_offer_attach_unproven\",\n279|        expect=\"KILLED\",\n280|        note=\"Admits remote attach without the capability; non-interactive still offers takeover.\",\n281|    ),\n282|    Mutant(\n283|        name=\"N-reattach\",\n284|        path=f\"{PACKAGE}/decide.go\",\n285|        find=\"\"\"\\tif input.ExistingBinding != nil {\n286|\\t\\tdecision.Action = ActionReattach\n287|\"\"\",\n288|        replace=\"\"\"\\tif input.ExistingBinding != nil && input.Mode == ModeRestore {\n289|\\t\\tdecision.Action = ActionReattach\n290|\"\"\",\n291|        count=1,\n292|        run=\"TestDecideTable/reattach_same_pair\",\n293|        expect=\"KILLED\",\n294|        note=\"Selects launch instead of reattach exactly on launch mode.\",\n295|    ),\n296|    Mutant(\n297|        name=\"N-binding-prefix\",\n298|        path=f\"{PACKAGE}/binding.go\",\n299|        find=\"\\t\\t\\tif winner.OperationID != operationID {\\n\",\n300|        replace=\"\\t\\t\\tif winner.OperationID[:8] != operationID[:8] {\\n\",\n301|        count=1,\n302|        run=\"TestBindConcurrentChangedOperationRefuses\",\n303|        expect=\"KILLED\",\n304|        note=\"Admits exactly same-prefix changed operations; full comparison otherwise stays.\",\n305|    ),\n306|    Mutant(\n307|        name=\"N-binding-session\",\n308|        path=f\"{PACKAGE}/binding.go\",\n309|        find=\"\\tif binding.SessionID != sessionID {\\n\",\n310|        replace=\"\\tif binding.SessionID[:8] != sessionID[:8] {\\n\",\n311|        count=1,\n312|        run=\"TestStatusSessionMismatchRefuses\",\n313|        expect=\"KILLED\",\n314|        note=\"Admits exactly same-prefix foreign sessions; full comparison otherwise stays.\",\n315|    ),\n316|    Mutant(\n317|        name=\"N-parked-reason\",\n318|        path=f\"{PACKAGE}/events.go\",\n319|        find='\\tdefault:\\n\\t\\treturn nil, fmt.Errorf(\"parked reason %q is not the session.parked vocabulary\", string(reason))\\n\\t}\\n',\n320|        replace='\\tdefault:\\n\\t\\tif len(reason) != 5 {\\n\\t\\t\\treturn nil, fmt.Errorf(\"parked reason %q is not the session.parked vocabulary\", string(reason))\\n\\t\\t}\\n\\t}\\n',\n321|        count=1,\n322|        run=\"TestParkedPayloadVocabulary\",\n323|        expect=\"KILLED\",\n324|        note=\"Admits exactly five-letter reasons; the vocabulary check otherwise stays.\",\n325|    ),\n326|    Mutant(\n327|        name=\"C-doc-comment\",\n328|        path=f\"{PACKAGE}/doc.go\",\n329|        find=\"// `ax pane SESSION_ID` enforcement wrapper: the decision every managed\\n\",\n330|        replace=\"// `ax pane SESSION_ID` enforcement wrapper (control): the decision every managed\\n\",\n331|        count=1,\n332|        run=\"TestRealmCarriesNoCachedEvidence\",\n333|        expect=\"SURVIVED\",\n334|        note=\"Harmless control: a comment-only edit must survive.\",\n335|    ),\n336|]\n337|\n338|\n339|def run_mutant(mutant: Mutant) -> str:\n340|    target = REPO / mutant.path\n341|    original = target.read_text()\n342|    found = original.count(mutant.find)\n343|    if found != mutant.count:\n344|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\"\n345|    with tempfile.TemporaryDirectory() as staging:\n346|        backup = Path(staging) / \"backup\"\n347|        shutil.copy2(target, backup)\n348|        try:\n349|            target.write_text(original.replace(mutant.find, mutant.replace))\n350|            run = subprocess.run(\n351|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n352|                cwd=REPO,\n353|                capture_output=True,\n354|                text=True,\n355|                timeout=300,\n356|            )\n357|        finally:\n358|            shutil.copy2(backup, target)\n359|    output = (run.stdout + run.stderr).strip()\n360|    if os.environ.get(\"AX_MUTANT_VERBOSE\") == \"1\":\n361|        print(f\"--- raw: {mutant.name}: exit {run.returncode} ---\", flush=True)\n362|        print(output, flush=True)\n363|        print(f\"--- end raw: {mutant.name} ---\", flush=True)\n364|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n365|        return f\"ERROR: {mutant.name}: build broke under the patch\"\n366|    if run.returncode == 0:\n367|        verdict = \"SURVIVED\"\n368|    elif '--- FAIL' in output or 'FAIL:' in output:\n369|        verdict = \"KILLED\"\n370|    else:\n371|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\"\n372|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n373|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note} [exit {run.returncode}]\"\n374|\n375|\n376|def main(argv: list[str]) -> int:\n377|    selected = [m for m in MUTANTS if not argv or m.name in argv]\n378|    if argv and len(selected) != len(argv):\n379|        unknown = sorted(set(argv) - {m.name for m in selected})\n380|        print(f\"unknown mutants: {', '.join(unknown)}\")\n381|        return 2\n382|    failures = 0\n383|    for mutant in selected:\n384|        try:\n385|            line = run_mutant(mutant)\n386|        except subprocess.TimeoutExpired:\n387|            line = f\"ERROR: {mutant.name}: killer timed out\"\n388|        print(line, flush=True)\n389|        if not line.startswith(\"ok:\"):\n390|            failures += 1\n391|    return 1 if failures else 0\n392|\n393|\n394|if __name__ == \"__main__\":\n395|    sys.exit(main(sys.argv[1:]))","final_result":true}}}
