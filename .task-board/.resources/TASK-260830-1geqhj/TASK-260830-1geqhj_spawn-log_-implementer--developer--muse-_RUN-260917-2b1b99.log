{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb43","stream":{"kind":"session","id":"01a0b0ab-f92f-74d3-a245-61ad42401b4b"},"sequence":1020,"recorded_at":1780531400002035,"record_type":"event","durability":"durable","causation_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","run_stream":{"kind":"run","id":"8ab0c8df-167f-48db-b83c-f756aeede0a9"},"task_stream":{"kind":"task","id":"01a0b0af-17a5-71c0-816a-3d79efdfc16a"},"task_id":"01a0b0af-17a5-71c0-816a-3d79efdfc16a","event":{"kind":"output","task_id":"01a0b0af-17a5-71c0-816a-3d79efdfc16a","chunk":"Read text file `internal/terminalbackend/manifest.go`.\n(899 line(s) above)\n900|\t// claims.\n901|\tCapabilityClaims []Claim\n902|\t// EvidenceIDs are the sorted unique IDs of the evidence objects used\n903|\t// by true claims.\n904|\tEvidenceIDs []string\n905|\t// ProbedAt is the observation instant.\n906|\tProbedAt scalar.Timestamp\n907|}\n908|\n909|// Evidence is one validated Capability Evidence 1.0.0 object: the signed,\n910|// expiring, generation-bound proof of one true capability claim. Value is\n911|// always true by construction: a false claim has no matching evidence.\n912|type Evidence struct {\n913|\t// EvidenceID is the recomputed omit-self digest.\n914|\tEvidenceID string\n915|\t// TerminalBackendID equals the Manifest and Probe members.\n916|\tTerminalBackendID string\n917|\t// ImplementationVersion equals the Manifest and Probe members.\n918|\tImplementationVersion string\n919|\t// ProtocolVersion equals the Probe member.\n920|\tProtocolVersion string\n921|\t// BackendGenerationDigest equals the Probe member.\n922|\tBackendGenerationDigest string\n923|\t// Capability names the one true claim this object proves.\n924|\tCapability string\n925|\t// Platform equals the Probe member.\n926|\tPlatform scalar.Platform\n927|\t// OSVersion equals the Probe member.\n928|\tOSVersion string\n929|\t// ConformanceFixtureID equals the Manifest member.\n930|\tConformanceFixtureID string\n931|\t// ObservedAt opens the validity interval.\n932|\tObservedAt scalar.Timestamp\n933|\t// ExpiresAt closes the validity interval, strictly after ObservedAt.\n934|\tExpiresAt scalar.Timestamp\n935|\t// Issuer is ax_release or ax_local_probe.\n936|\tIssuer string\n937|\t// IssuerID is the digest of the trusted signing identity. A\n938|\t// caller-supplied issuer ID is not authentication: the signature must\n939|\t// verify through the trusted key registry.\n940|\tIssuerID string\n941|\t// AttestationSignature is the raw signature bytes (scheme stripped).\n942|\tAttestationSignature []byte\n943|\t// Facts are the sorted unique evidence facts covering the claim's\n944|\t// requirements through the requirement-to-fact mapping.\n945|\tFacts []string\n946|\t// TerminalBindingID is the opaque binding digest, required only for\n947|\t// credential_capable_execution_realm and empty otherwise.\n948|\tTerminalBindingID string\n949|\t// ProviderID is the provider-id, required only for\n950|\t// credential_capable_execution_realm and empty otherwise.\n951|\tProviderID string\n952|\t// ProviderBuild is the string[1..256] provider build, required only\n953|\t// for credential_capable_execution_realm and empty otherwise.\n954|\tProviderBuild string\n955|\t// SentinelResult is literal passed, required only for\n956|\t// credential_capable_execution_realm and empty otherwise.\n957|\tSentinelResult string\n958|\t// ProviderAuthSmokeResult is literal passed, required only for\n959|\t// credential_capable_execution_realm and empty otherwise.\n960|\tProviderAuthSmokeResult string\n961|}\n962|\n963|// manifestMembers is the exact closed Manifest member set.\n964|var manifestMembers = []string{\n965|\t\"schema\", \"schema_version\", \"manifest_id\", \"terminal_backend_id\",\n966|\t\"implementation_version\", \"protocol_versions\", \"platforms\",\n967|\t\"implementation_kind\", \"executable_digest\", \"static_capability_claims\",\n968|\t\"conformance_fixture_id\", \"extensions\",\n969|}\n970|\n971|// ParseManifest validates one Terminal Backend Manifest 1.0.0 document and\n972|// returns the typed observation. Any deviation from the closed shape,\n973|// vocabulary, bound, ordering, registry-row, or identity rule is\n974|// CodeMismatch: a malformed read is an error, never absence.\n975|func ParseManifest(raw []byte) (Manifest, error) {\n976|\tobject, err := decodeStrictObject(raw)\n977|\tif err != nil {\n978|\t\treturn Manifest{}, err\n979|\t}\n980|\treturn parseManifestObject(object)\n981|}\n982|\n983|// parseManifestObject validates a decoded Manifest member map. It is split\n984|// from ParseManifest so admission paths that already hold a decoded object\n985|// share the exact gate.\n986|func parseManifestObject(object map[string]any) (Manifest, error) {\n987|\tif err := checkExactMembers(object, manifestMembers); err != nil {\n988|\t\treturn Manifest{}, err\n989|\t}\n990|\tif schema, err := stringMember(object, \"schema\"); err != nil || schema != SchemaManifest {\n991|\t\treturn Manifest{}, mismatchf(\"manifest schema\")\n992|\t}\n993|\tif version, err := stringMember(object, \"schema_version\"); err != nil || version != SchemaVersion100 {\n994|\t\treturn Manifest{}, mismatchf(\"manifest schema version\")\n995|\t}\n996|\tmanifestID, err := stringMember(object, \"manifest_id\")\n997|\tif err != nil {\n998|\t\treturn Manifest{}, err\n999|\t}\n1000|\tbackendID, err := stringMember(object, \"terminal_backend_id\")\n1001|\tif err != nil {\n1002|\t\treturn Manifest{}, err\n1003|\t}\n1004|\tif _, err := ParseID(backendID); err != nil {\n1005|\t\treturn Manifest{}, mismatchf(\"manifest backend identity\")\n1006|\t}\n1007|\timplementationVersion, err := semverMember(object, \"implementation_version\")\n1008|\tif err != nil {\n1009|\t\treturn Manifest{}, err\n1010|\t}\n1011|\tprotocols, err := stringArrayMember(object, \"protocol_versions\")\n1012|\tif err != nil {\n1013|\t\treturn Manifest{}, err\n1014|\t}\n1015|\tif err := validateProtocolList(protocols); err != nil {\n1016|\t\treturn Manifest{}, err\n1017|\t}\n1018|\tplatforms, err := parsePlatformList(object)\n1019|\tif err != nil {\n1020|\t\treturn Manifest{}, err\n1021|\t}\n1022|\tkindName, err := stringMember(object, \"implementation_kind\")\n1023|\tif err != nil {\n1024|\t\treturn Manifest{}, err\n1025|\t}\n1026|\tkind, err := parseKind(kindName)\n1027|\tif err != nil {\n1028|\t\treturn Manifest{}, mismatchf(\"manifest implementation kind\")\n1029|\t}\n(more lines below)","final_result":true}}}
