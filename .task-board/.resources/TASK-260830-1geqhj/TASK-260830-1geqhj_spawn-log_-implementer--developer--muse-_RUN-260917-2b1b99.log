{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cdc1","stream":{"kind":"session","id":"01a0b0ab-f92f-74d3-a245-61ad42401b4b"},"sequence":1339,"recorded_at":1780531400002673,"record_type":"event","durability":"durable","causation_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","run_stream":{"kind":"run","id":"8ab0c8df-167f-48db-b83c-f756aeede0a9"},"task_stream":{"kind":"task","id":"01a0b0b6-5bb8-78e0-8d9b-ddbfd0edd92e"},"task_id":"01a0b0b6-5bb8-78e0-8d9b-ddbfd0edd92e","event":{"kind":"output","task_id":"01a0b0b6-5bb8-78e0-8d9b-ddbfd0edd92e","chunk":"Read text file `internal/sessckpt/capture.go`.\n(99 line(s) above)\n100|\treturn fmt.Errorf(\"%w: %w: %s\",\n101|\t\tErrInvalidCheckpoint, canonicaljson.ErrInvalidIdentity, fmt.Sprintf(format, arguments...))\n102|}\n103|\n104|// Capture builds the typed closure into a Checkpoint Record\n105|// 1.0.0, attests it through the sessrepo owner, and installs it\n106|// durably with its operation receipt. The same operation retried\n107|// with byte-identical inputs replays the recorded checkpoint\n108|// without writing; the same operation retried with moved inputs\n109|// refuses ErrCheckpointConflict and writes nothing.\n110|//\n111|// Chain binds the source-head leg: every head must resolve to a\n112|// chained event for the session at or before the owning lease. A\n113|// nil chain refuses closed rather than skipping the gate.\n114|func (store *Store) Capture(chain *sessrepo.Repository, inputs Inputs) (CheckpointRef, []byte, error) {\n115|\tcandidate, err := buildCandidate(inputs)\n116|\tif err != nil {\n117|\t\treturn CheckpointRef{}, nil, err\n118|\t}\n119|\tif err := checkHeadBinding(chain, inputs); err != nil {\n120|\t\treturn CheckpointRef{}, nil, err\n121|\t}\n122|\traw, digest, err := identifyCandidate(candidate)\n123|\tif err != nil {\n124|\t\treturn CheckpointRef{}, nil, err\n125|\t}\n126|\tinputDigest, err := digestInputs(candidate)\n127|\tif err != nil {\n128|\t\treturn CheckpointRef{}, nil, err\n129|\t}\n130|\toperation, err := checkOperationID(inputs.OperationID)\n131|\tif err != nil {\n132|\t\treturn CheckpointRef{}, nil, err\n133|\t}\n134|\tsession, err := checkSessionID(inputs.SessionID)\n135|\tif err != nil {\n136|\t\treturn CheckpointRef{}, nil, err\n137|\t}\n138|\treturn store.install(operation, session, digest, inputDigest, raw)\n139|}\n140|\n141|// Admit installs an externally built Checkpoint Record (for\n142|// example one received through sync) through the same attestation\n143|// and durability path as Capture. Raw bytes are attested through\n144|// the sessrepo owner first; the kind-selected persistence variant\n145|// and the head binding are then decided exactly as in Capture, so\n146|// an unpublishable record is refused before publication with the\n147|// same classes. The operation receipt binds the raw digest as the\n148|// input digest, so a byte-identical re-admit replays and moved\n149|// bytes under the same operation refuse.\n150|func (store *Store) Admit(chain *sessrepo.Repository, raw []byte, operationID, sessionKind string) (CheckpointRef, error) {\n151|\toperation, err := checkOperationID(operationID)\n152|\tif err != nil {\n153|\t\treturn CheckpointRef{}, err\n154|\t}\n155|\tmembers, fault := environ.DecodeStrictObject(raw)\n156|\tif fault != nil {\n157|\t\treturn CheckpointRef{}, invalid(\"decode checkpoint record frame: %v\", fault)\n158|\t}\n159|\tschema, err := stringMember(members, \"schema\")\n160|\tif err != nil || schema != checkpointSchema {\n161|\t\treturn CheckpointRef{}, invalid(\"checkpoint record schema %q, want %q\", schema, checkpointSchema)\n162|\t}\n163|\tdigest, field, err := sessrepo.AttestCheckpointRecord(raw)\n164|\tif err != nil {\n165|\t\treturn CheckpointRef{}, invalid(\"verify checkpoint record identity: %v\", err)\n166|\t}\n167|\tif field != canonicaljson.SelfCheckpointID {\n168|\t\treturn CheckpointRef{}, invalid(\"checkpoint record identity field %q, want checkpoint_id\", string(field))\n169|\t}\n170|\tadmitted, err := extractAdmitted(members)\n171|\tif err != nil {\n172|\t\treturn CheckpointRef{}, err\n173|\t}\n174|\tkind, err := checkSessionKind(sessionKind)\n175|\tif err != nil {\n176|\t\treturn CheckpointRef{}, err\n177|\t}\n178|\tif err := checkPersistenceVariant(kind, admitted.hasProvider, admitted.hasBoard); err != nil {\n179|\t\treturn CheckpointRef{}, err\n180|\t}\n181|\tif err := checkRawHeadBinding(chain, admitted); err != nil {\n182|\t\treturn CheckpointRef{}, err\n183|\t}\n184|\tinputDigest := scalar.SHA256Digest(raw).String()\n185|\tinstalled, _, err := store.install(operation, admitted.sessionID, digest.String(), inputDigest, append([]byte(nil), raw...))\n186|\treturn installed, err\n187|}\n188|\n189|// Get returns the byte-identical Checkpoint Record for its digest,\n190|// re-verified through the canonical owner on every read.\n191|func (store *Store) Get(checkpointID string) ([]byte, error) {\n192|\tdigest, err := scalar.ParseDigest(checkpointID)\n193|\tif err != nil {\n194|\t\treturn nil, invalid(\"checkpoint id %q: %v\", checkpointID, err)\n195|\t}\n196|\tstore.mutex.Lock()\n197|\tdefer store.mutex.Unlock()\n198|\traw, err := readBlob(store.blobPath(digest.String()))\n199|\tif err != nil {\n200|\t\treturn nil, err\n201|\t}\n202|\tif _, _, err := sessrepo.AttestCheckpointRecord(raw); err != nil {\n203|\t\treturn nil, invalid(\"verify stored checkpoint record identity: %v\", err)\n204|\t}\n205|\treturn raw, nil\n206|}\n207|\n208|// admittedMembers carries the closure legs extracted from attested\n209|// raw bytes for the variant and head gates.\n210|type admittedMembers struct {\n211|\tsessionID   string\n212|\tleaseEpoch  uint64\n213|\tleaseID     string\n214|\thasProvider bool\n215|\thasBoard    bool\n216|\theads       []string\n217|}\n218|\n219|// extractAdmitted reads the bound members after the owner\n220|// attested the closed shape. Grammar failures here cannot fire\n221|// on owner-admitted bytes; they stay invalid-class refusals so a\n222|// future shape drift fails closed into the same publication bar.\n223|func extractAdmitted(members map[string]json.RawMessage) (admittedMembers, error) {\n224|\tvar admitted admittedMembers\n225|\tsession, ok := environ.CheckUUIDv7(members[\"session_id\"])\n226|\tif !ok {\n227|\t\treturn admitted, invalid(\"checkpoint record carries no valid session_id member\")\n228|\t}\n229|\tadmitted.sessionID = session.String()\n230|\tepoch, ok := environ.CheckUint53Bounds(members[\"lease_epoch\"], 1, uint53Max)\n231|\tif !ok {\n232|\t\treturn admitted, invalid(\"checkpoint record carries no lease_epoch at or above 1\")\n233|\t}\n234|\tadmitted.leaseEpoch = epoch\n235|\tleaseID, err := stringMember(members, \"lease_id\")\n236|\tif err != nil {\n237|\t\treturn admitted, invalid(\"checkpoint record carries no lease_id member: %v\", err)\n238|\t}\n239|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n240|\t\treturn admitted, invalid(\"checkpoint record lease_id: %v\", err)\n241|\t}\n242|\tadmitted.leaseID = leaseID\n243|\tfor _, leg := range []struct {\n244|\t\tname    string\n245|\t\tpresent *bool\n246|\t}{\n247|\t\t{\"provider_manifest_id\", &admitted.hasProvider},\n248|\t\t{\"task_board_bundle_id\", &admitted.hasBoard},\n249|\t} {\n250|\t\traw, ok := members[leg.name]\n251|\t\tif !ok {\n252|\t\t\treturn admitted, invalid(\"checkpoint record member %q is absent\", leg.name)\n253|\t\t}\n254|\t\tif string(raw) == \"null\" {\n255|\t\t\tcontinue\n256|\t\t}\n257|\t\tif _, ok := environ.CheckDigest(raw); !ok {\n258|\t\t\treturn admitted, invalid(\"checkpoint record %s is neither a digest nor null\", leg.name)\n259|\t\t}\n260|\t\t*leg.present = true\n261|\t}\n262|\traw, ok := members[\"event_heads\"]\n263|\tif !ok {\n264|\t\treturn admitted, invalid(\"checkpoint record member %q is absent\", \"event_heads\")\n265|\t}\n266|\tvar heads []string\n267|\tif err := json.Unmarshal(raw, &heads); err != nil {\n268|\t\treturn admitted, invalid(\"checkpoint record event_heads is not a string array: %v\", err)\n269|\t}\n270|\tfor _, head := range heads {\n271|\t\tif _, err := scalar.ParseDigest(head); err != nil {\n272|\t\t\treturn admitted, invalid(\"checkpoint record event head %q: %v\", head, err)\n273|\t\t}\n274|\t\tadmitted.heads = append(admitted.heads, head)\n275|\t}\n276|\treturn admitted, nil\n277|}\n278|\n279|// uint53Max is the AX safe-integer ceiling from SPEC Section 1.6.\n280|// Bounds stay with the environ owner; the ceiling is passed, never\n281|// re-enforced here.\n282|const uint53Max = uint64(1<<53 - 1)\n283|\n284|// buildCandidate validates every typed closure leg and assembles\n285|// the candidate object with a zero placeholder identity. The\n286|// placeholder must parse as a digest because the identity owner\n287|// validates shape before omitting the self field; the real digest\n288|// is computed by identifyCandidate.\n289|func buildCandidate(inputs Inputs) (map[string]any, error) {\n(more lines below)","final_result":true}}}
