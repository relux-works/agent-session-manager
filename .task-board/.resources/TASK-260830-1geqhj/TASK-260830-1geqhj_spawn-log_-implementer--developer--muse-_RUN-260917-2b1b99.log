{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf17","stream":{"kind":"session","id":"01a0b0ab-f92f-74d3-a245-61ad42401b4b"},"sequence":1510,"recorded_at":1780531400003015,"record_type":"event","durability":"durable","causation_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","run_stream":{"kind":"run","id":"8ab0c8df-167f-48db-b83c-f756aeede0a9"},"task_stream":{"kind":"task","id":"01a0b0b9-b9b5-7c02-aae2-f18ad072f54d"},"task_id":"01a0b0b9-b9b5-7c02-aae2-f18ad072f54d","event":{"kind":"output","task_id":"01a0b0b9-b9b5-7c02-aae2-f18ad072f54d","chunk":"Read text file `internal/sessstate/sessstate.go`.\n(700 line(s) above)\n701|\tcheckpointID, err := payloadString(event.Payload, \"checkpoint_id\")\n702|\tif err != nil {\n703|\t\treturn err\n704|\t}\n705|\tif _, err := scalar.ParseDigest(checkpointID); err != nil {\n706|\t\treturn refuse(ErrDerivation, \"%s carries malformed checkpoint_id: %v\", what, err)\n707|\t}\n708|\tkind, err := payloadString(event.Payload, \"kind\")\n709|\tif err != nil {\n710|\t\treturn err\n711|\t}\n712|\tfold.noteCheckpoint(checkpointID, kind, event.ID)\n713|\tswitch fold.state {\n714|\tcase \"\", StateIdle, StateQuiescing:\n715|\t\tif fold.state == \"\" {\n716|\t\t\treturn refuse(ErrInvalidTransition, \"%s publishes a checkpoint before any bootstrap\", what)\n717|\t\t}\n718|\t\treturn fold.step(StateCheckpointing, what)\n719|\tcase StateCheckpointing:\n720|\t\treturn fold.step(StateIdle, what)\n721|\tdefault:\n722|\t\treturn fold.step(StateCheckpointing, what)\n723|\t}\n724|}\n725|\n726|// effectStopped derives stopped for a checkpointed closure and failed\n727|// for a bootstrap abort. No event may derive stopped while the newest\n728|// checkpoint is null: the event's own checkpoint counts, so a\n729|// checkpointed stop carries its resumable base with it. A bootstrap\n730|// abort requires the null checkpoint, false resumable and graceful\n731|// values the canonical owner admitted, plus a preceding authoritative\n732|// abort event; an ambiguous live process stays failed with recovery\n733|// diagnostics instead.\n734|func (fold *chainFold) effectStopped(event Event, what string) error {\n735|\tcheckpointID, hasCheckpoint, err := payloadNullableDigest(event.Payload, \"checkpoint_id\")\n736|\tif err != nil {\n737|\t\treturn err\n738|\t}\n739|\tresumable, err := payloadBool(event.Payload, \"resumable\")\n740|\tif err != nil {\n741|\t\treturn err\n742|\t}\n743|\tclosure, err := payloadString(event.Payload, \"closure_kind\")\n744|\tif err != nil {\n745|\t\treturn err\n746|\t}\n747|\tif closure == \"checkpointed\" {\n748|\t\tif !hasCheckpoint || !resumable {\n749|\t\t\treturn refuse(ErrIntegrity, \"%s closes checkpointed without a resumable checkpoint\", what)\n750|\t\t}\n751|\t\tfold.noteCheckpoint(checkpointID, \"\", event.ID)\n752|\t\treturn fold.step(StateStopped, what)\n753|\t}\n754|\tif hasCheckpoint || resumable {\n755|\t\treturn refuse(ErrIntegrity, \"%s closes bootstrap_abort with a checkpoint or resumable set\", what)\n756|\t}\n757|\tif !fold.seenAbort {\n758|\t\treturn refuse(ErrInvalidTransition, \"%s closes bootstrap_abort with no authoritative abort event\", what)\n759|\t}\n760|\treturn fold.step(StateFailed, what)\n761|}\n762|\n763|// effectResumed moves to running under the resumed checkpoint and\n764|// records the terminal binding the resume selected.\n765|func (fold *chainFold) effectResumed(event Event, what string) error {\n766|\tcheckpointID, err := payloadString(event.Payload, \"checkpoint_id\")\n767|\tif err != nil {\n768|\t\treturn err\n769|\t}\n770|\tif _, err := scalar.ParseDigest(checkpointID); err != nil {\n771|\t\treturn refuse(ErrDerivation, \"%s carries malformed checkpoint_id: %v\", what, err)\n772|\t}\n773|\tfold.noteCheckpoint(checkpointID, \"\", event.ID)\n774|\tif event.SchemaVersion == \"4.0.0\" {\n775|\t\tbinding, err := payloadString(event.Payload, \"terminal_binding_id\")\n776|\t\tif err != nil {\n777|\t\t\treturn err\n778|\t\t}\n779|\t\tif _, err := scalar.ParseDigest(binding); err != nil {\n780|\t\t\treturn refuse(ErrDerivation, \"%s carries malformed terminal_binding_id: %v\", what, err)\n781|\t\t}\n782|\t\tbackend, err := payloadString(event.Payload, \"terminal_backend_id\")\n783|\t\tif err != nil {\n784|\t\t\treturn err\n785|\t\t}\n786|\t\tif _, err := terminalbackend.ParseID(backend); err != nil {\n787|\t\t\treturn refuse(ErrDerivation, \"%s carries refused terminal backend: %v\", what, err)\n788|\t\t}\n789|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, BindingID: binding, EventID: event.ID}\n790|\t} else {\n791|\t\tbackend, err := payloadString(event.Payload, \"terminal_backend\")\n792|\t\tif err != nil {\n793|\t\t\treturn err\n794|\t\t}\n795|\t\tif backend != \"tmux\" && backend != \"conpty\" {\n796|\t\t\treturn refuse(ErrDerivation, \"%s carries unknown terminal backend %q\", what, backend)\n797|\t\t}\n798|\t\tnativeID, err := payloadString(event.Payload, \"native_session_id\")\n799|\t\tif err != nil {\n800|\t\t\treturn err\n801|\t\t}\n802|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, NativeSessionID: nativeID, EventID: event.ID}\n803|\t}\n804|\tfold.projection.HasTerminal = true\n805|\treturn fold.step(StateRunning, what)\n806|}\n807|\n808|// effectBootstrapAborted records the authoritative abort and fails the\n809|// bootstrap. Only the creating session can abort its bootstrap; any\n810|// later abort is invalid_state_transition.\n811|func (fold *chainFold) effectBootstrapAborted(event Event, what string) error {\n812|\tfold.seenAbort = true\n813|\tif fold.state != \"\" && fold.state != StateCreating {\n814|\t\treturn refuse(ErrInvalidTransition, \"%s aborts a bootstrap past creating\", what)\n815|\t}\n816|\treturn fold.step(StateFailed, what)\n817|}\n818|\n819|// effectLease checks the successor-lease payload linkage: the payload\n820|// must name the predecessor the chain stands on and the envelope it\n(more lines below)","final_result":true}}}
