{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb75","stream":{"kind":"session","id":"01a0b0ab-f92f-74d3-a245-61ad42401b4b"},"sequence":1045,"recorded_at":1780531400002085,"record_type":"event","durability":"durable","causation_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","run_stream":{"kind":"run","id":"8ab0c8df-167f-48db-b83c-f756aeede0a9"},"task_stream":{"kind":"task","id":"01a0b0af-261a-77d3-8b1a-fe5d39ec7d85"},"task_id":"01a0b0af-261a-77d3-8b1a-fe5d39ec7d85","event":{"kind":"output","task_id":"01a0b0af-261a-77d3-8b1a-fe5d39ec7d85","chunk":"Read text file `internal/terminalbackend/manifest.go`.\n(1593 line(s) above)\n1594|type Admitted struct {\n1595|\tCapabilities []string\n1596|\tEvidenceIDs  []string\n1597|}\n1598|\n1599|// Has reports whether capability is an admitted true claim.\n1600|func (admitted Admitted) Has(capability string) bool {\n1601|\tfor _, member := range admitted.Capabilities {\n1602|\t\tif member == capability {\n1603|\t\t\treturn true\n1604|\t\t}\n1605|\t}\n1606|\treturn false\n1607|}\n1608|\n1609|// HasOperation reports whether any admitted true capability confers the\n1610|// operation through its registry dependent_operations.\n1611|func (admitted Admitted) HasOperation(operation string) bool {\n1612|\tfor _, capability := range admitted.Capabilities {\n1613|\t\trow, known := capabilityRegistry[capability]\n1614|\t\tif !known {\n1615|\t\t\tcontinue\n1616|\t\t}\n1617|\t\tfor _, conferred := range row.dependentOperations {\n1618|\t\t\tif conferred == operation {\n1619|\t\t\t\treturn true\n1620|\t\t\t}\n1621|\t\t}\n1622|\t}\n1623|\treturn false\n1624|}\n1625|\n1626|// CapabilitiesForOperation returns the sorted registry capabilities whose\n1627|// dependent_operations confer the operation. manifest and probe confer\n1628|// through no capability and return an empty set: they carry no capability\n1629|// dependency. An unknown operation is refused: the operation vocabulary is\n1630|// closed.\n1631|func CapabilitiesForOperation(operation string) ([]string, error) {\n1632|\tif !operationVocabulary[operation] {\n1633|\t\treturn nil, mismatchf(\"operation vocabulary\")\n1634|\t}\n1635|\tvar capabilities []string\n1636|\tfor capability, row := range capabilityRegistry {\n1637|\t\tfor _, conferred := range row.dependentOperations {\n1638|\t\t\tif conferred == operation {\n1639|\t\t\t\tcapabilities = append(capabilities, capability)\n1640|\t\t\t\tbreak\n1641|\t\t\t}\n1642|\t\t}\n1643|\t}\n1644|\treturn capabilities, nil\n1645|}\n1646|\n1647|// CheckOperation gates one operation against the admitted set. manifest and\n1648|// probe carry no capability dependency (§4.D): they are admitted for any\n1649|// admitted set, including the empty one. Every other operation must be in\n1650|// the closed vocabulary and conferred by at least one admitted true\n1651|// capability, or it is refused with CodeCapabilityUnproven. Conditional §4.C\n1652|// dependencies (interactivity, credential need, attach overlap, provider\n1653|// observation) are evaluated by the lifecycle owner at the operation call\n1654|// site; this gate proves only the capability-confers-operation half, which\n1655|// is the bound this file owns.\n1656|func CheckOperation(operation string, admitted Admitted) error {\n1657|\tif !operationVocabulary[operation] {\n1658|\t\treturn mismatchf(\"operation vocabulary\")\n1659|\t}\n1660|\tif operation == \"manifest\" || operation == \"probe\" {\n1661|\t\treturn nil\n1662|\t}\n1663|\tif !admitted.HasOperation(operation) {\n1664|\t\treturn refuse(&Error{Code: CodeCapabilityUnproven, Detail: \"operation capability dependency\"})\n1665|\t}\n1666|\treturn nil\n1667|}\n1668|\n1669|// Reconcile admits one Probe against its Manifest with the returned\n1670|// evidence set, binding everything to the AX-known raw generation and the\n1671|// admission instant (§4.B keyed relation, §4.D evidence binding). The check\n1672|// order is deterministic: identity equality, protocol/platform membership,\n1673|// generation binding, claim relation, per-object evidence usability\n1674|// (tuple binding, liveness, signature), per-claim requirement coverage,\n1675|// then the exact evidence_ids set rule. The first failure wins; every\n1676|// failure fails closed before activation.\n1677|//\n1678|// Each supplied evidence object must independently prove its named claim:\n1679|// split-facts evidence (requirement coverage spread across several objects,\n1680|// none sufficient alone) is refused. That reading follows the singular\n1681|// rule-5 phrasing (\"Capability Evidence ... satisfies every listed evidence\n1682|// requirement\") and is stated here as the bound.\n1683|func Reconcile(manifest Manifest, probe Probe, evidence []Evidence, rawGeneration string, now time.Time, verify SignatureVerifier) (Admitted, error) {\n1684|\tif verify == nil {\n1685|\t\treturn Admitted{}, integrityFailure(\"evidence signature verifier\")\n1686|\t}\n1687|\t// Both identities pass ParseID before any check runs, like\n1688|\t// CheckVersionTuple and CheckProviderDescriptor already do: Manifest\n1689|\t// and Probe are plain structs any caller can build by hand, so the\n1690|\t// document admission in ParseManifest/ParseProbe cannot be the only\n1691|\t// validation. Without this gate a grammar-refused identity reaches\n1692|\t// checkProbeIdentity/checkProbeGeneration and renders verbatim into\n1693|\t// the refusal. A refused ID returns the ParseID refusal — whose\n1694|\t// bound and grammar arms carry no BackendID — and never reaches the\n1695|\t// naming arms.\n1696|\tif _, err := ParseID(manifest.TerminalBackendID); err != nil {\n1697|\t\treturn Admitted{}, err\n1698|\t}\n1699|\tif _, err := ParseID(probe.TerminalBackendID); err != nil {\n1700|\t\treturn Admitted{}, err\n1701|\t}\n1702|\tif err := checkProbeIdentity(manifest, probe); err != nil {\n1703|\t\treturn Admitted{}, err\n1704|\t}\n1705|\tif err := checkProbeMembership(manifest, probe); err != nil {\n1706|\t\treturn Admitted{}, err\n1707|\t}\n1708|\tif err := checkProbeGeneration(probe, rawGeneration); err != nil {\n1709|\t\treturn Admitted{}, err\n1710|\t}\n1711|\tmanifestClaims := indexClaims(manifest.StaticCapabilityClaims)\n1712|\tif err := checkClaimRelation(manifestClaims, probe.CapabilityClaims); err != nil {\n1713|\t\treturn Admitted{}, err\n1714|\t}\n1715|\tprobeClaims := indexClaims(probe.CapabilityClaims)\n1716|\tused, err := checkEvidenceSet(manifest, probe, probeClaims, evidence, now, verify)\n1717|\tif err != nil {\n1718|\t\treturn Admitted{}, err\n1719|\t}\n1720|\tif err := checkEvidenceCoverage(probeClaims, used); err != nil {\n1721|\t\treturn Admitted{}, err\n1722|\t}\n1723|\tif err := checkEvidenceIDs(probe, used); err != nil {\n1724|\t\treturn Admitted{}, err\n1725|\t}\n1726|\treturn admitCapabilities(probeClaims, used), nil\n1727|}\n1728|\n1729|// checkProbeIdentity enforces the §4.B identity equalities. Executable\n1730|// substitution additionally maps to the more specific untrusted code.\n1731|func checkProbeIdentity(manifest Manifest, probe Probe) error {\n1732|\tif probe.TerminalBackendID != manifest.TerminalBackendID ||\n1733|\t\tprobe.ImplementationVersion != manifest.ImplementationVersion ||\n1734|\t\tprobe.ImplementationKind != manifest.ImplementationKind {\n1735|\t\treturn mismatchf(\"probe manifest binding\")\n1736|\t}\n1737|\t// The backend IDs are already equal here (refused above), so a digest\n1738|\t// difference is always a substitution of the admitted executable: it\n1739|\t// is untrusted, never a plain mismatch.\n1740|\tif probe.ExecutableDigest != manifest.ExecutableDigest {\n1741|\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: probe.TerminalBackendID, Detail: \"executable substitution\"})\n1742|\t}\n1743|\treturn nil\n1744|}\n1745|\n1746|// checkProbeMembership enforces array-to-scalar selection as membership:\n1747|// the probe protocol version must be exactly one Manifest member and the\n1748|// probe platform exactly one Manifest platform member.\n1749|func checkProbeMembership(manifest Manifest, probe Probe) error {\n1750|\tmember := false\n1751|\tfor _, version := range manifest.ProtocolVersions {\n1752|\t\tif probe.ProtocolVersion == version {\n1753|\t\t\tmember = true\n1754|\t\t\tbreak\n1755|\t\t}\n1756|\t}\n1757|\tif !member {\n1758|\t\treturn mismatchf(\"probe protocol membership\")\n1759|\t}\n1760|\tfor _, platform := range manifest.Platforms {\n1761|\t\tif probe.Platform == platform {\n1762|\t\t\treturn nil\n1763|\t\t}\n1764|\t}\n1765|\treturn mismatchf(\"probe platform membership\")\n1766|}\n1767|\n1768|// checkProbeGeneration binds the probe to the AX-known raw generation. A\n1769|// digest mismatch (or an underivable raw generation, including empty, which\n1770|// would make every backend share one digest) is stale, never a retry hint.\n1771|func checkProbeGeneration(probe Probe, rawGeneration string) error {\n1772|\tdigest, err := GenerationDigest(rawGeneration)\n1773|\tif err != nil {\n1774|\t\treturn err\n1775|\t}\n1776|\tif digest != probe.BackendGenerationDigest {\n1777|\t\treturn refuse(&Error{Code: CodeStaleGeneration, BackendID: probe.TerminalBackendID, Detail: \"probe generation binding\"})\n1778|\t}\n1779|\treturn nil\n1780|}\n1781|\n1782|// indexClaims keys validated claims by capability. The validated lists are\n1783|// duplicate-free, so the index cannot collide.\n1784|func indexClaims(claims []Claim) map[string]Claim {\n1785|\tindexed := make(map[string]Claim, len(claims))\n1786|\tfor _, claim := range claims {\n1787|\t\tindexed[claim.Capability] = claim\n1788|\t}\n1789|\treturn indexed\n1790|}\n1791|\n1792|// checkClaimRelation enforces the complete §4.B keyed relation between the\n1793|// Manifest static claims M and the Probe claims P.\n(more lines below)","final_result":true}}}
