{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c951","stream":{"kind":"session","id":"01a0b0ab-f92f-74d3-a245-61ad42401b4b"},"sequence":771,"recorded_at":1780531400001537,"record_type":"event","durability":"durable","causation_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","run_stream":{"kind":"run","id":"8ab0c8df-167f-48db-b83c-f756aeede0a9"},"task_stream":{"kind":"task","id":"01a0b0ae-6fac-7ad1-9dd7-1ff36fc5c8bc"},"task_id":"01a0b0ae-6fac-7ad1-9dd7-1ff36fc5c8bc","event":{"kind":"output","task_id":"01a0b0ae-6fac-7ad1-9dd7-1ff36fc5c8bc","chunk":"Read text file `internal/axpane/run_test.go`.\n(499 line(s) above)\n500|\t}\n501|\tif !observation.HasWinner || observation.Winner.LeaseID != fixtureLeaseA || observation.Winner.Epoch != 1 {\n502|\t\tt.Fatalf(\"ObserveOwnership() winner = %+v, want the epoch-1 lease\", observation.Winner)\n503|\t}\n504|\ttoken, err := fencing.AuthorizeActivation(fixturePresented(), observation)\n505|\tif err != nil {\n506|\t\tt.Fatalf(\"AuthorizeActivation() over observed leases error = %v\", err)\n507|\t}\n508|\tif _, err := token.Bind(fencing.ProviderCapture); err != nil {\n509|\t\tt.Fatalf(\"observed token bind error = %v\", err)\n510|\t}\n511|\tvar _ = errors.Is\n512|}","final_result":true}}}
