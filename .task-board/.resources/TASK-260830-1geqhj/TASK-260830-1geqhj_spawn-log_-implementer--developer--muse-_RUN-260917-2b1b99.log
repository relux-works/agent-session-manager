{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cbef","stream":{"kind":"session","id":"01a0b0ab-f92f-74d3-a245-61ad42401b4b"},"sequence":1106,"recorded_at":1780531400002207,"record_type":"event","durability":"durable","causation_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","run_stream":{"kind":"run","id":"8ab0c8df-167f-48db-b83c-f756aeede0a9"},"task_stream":{"kind":"task","id":"01a0b0af-8181-7c53-9a42-e94bb7ad64b1"},"task_id":"01a0b0af-8181-7c53-9a42-e94bb7ad64b1","event":{"kind":"output","task_id":"01a0b0af-8181-7c53-9a42-e94bb7ad64b1","chunk":"Read text file `internal/terminalbackend/manifest.go`.\n(1847 line(s) above)\n1848|func checkEvidenceSet(manifest Manifest, probe Probe, probeClaims map[string]Claim, evidence []Evidence, now time.Time, verify SignatureVerifier) ([]Evidence, error) {\n1849|\tused := make([]Evidence, 0, len(evidence))\n1850|\tseen := make(map[string]Evidence, len(evidence))\n1851|\tfor _, object := range evidence {\n1852|\t\tclaim, present := probeClaims[object.Capability]\n1853|\t\tif !present || !claim.Value {\n1854|\t\t\treturn nil, mismatchf(\"evidence claim binding\")\n1855|\t\t}\n1856|\t\tif err := checkEvidenceTuple(manifest, probe, object); err != nil {\n1857|\t\t\treturn nil, err\n1858|\t\t}\n1859|\t\tif err := checkEvidenceLiveness(object, now); err != nil {\n1860|\t\t\treturn nil, err\n1861|\t\t}\n1862|\t\tif previous, duplicate := seen[object.EvidenceID]; duplicate {\n1863|\t\t\tif !equalEvidence(previous, object) {\n1864|\t\t\t\treturn nil, mismatchf(\"conflicting evidence\")\n1865|\t\t\t}\n1866|\t\t\tcontinue\n1867|\t\t}\n1868|\t\tseen[object.EvidenceID] = object\n1869|\t\tif err := checkEvidenceSignature(object, verify); err != nil {\n1870|\t\t\treturn nil, err\n1871|\t\t}\n1872|\t\tused = append(used, object)\n1873|\t}\n1874|\treturn used, nil\n1875|}\n1876|\n1877|// equalEvidence reports whether two evidence objects with the same ID carry\n1878|// identical members. Same-ID differing-bytes objects are conflicting\n1879|// evidence and invalidate the whole Probe.\n1880|func equalEvidence(left, right Evidence) bool {\n1881|\tif left.TerminalBackendID != right.TerminalBackendID ||\n1882|\t\tleft.ImplementationVersion != right.ImplementationVersion ||\n1883|\t\tleft.ProtocolVersion != right.ProtocolVersion ||\n1884|\t\tleft.BackendGenerationDigest != right.BackendGenerationDigest ||\n1885|\t\tleft.Capability != right.Capability ||\n1886|\t\tleft.Platform != right.Platform ||\n1887|\t\tleft.OSVersion != right.OSVersion ||\n1888|\t\tleft.ConformanceFixtureID != right.ConformanceFixtureID ||\n1889|\t\tleft.ObservedAt.String() != right.ObservedAt.String() ||\n1890|\t\tleft.ExpiresAt.String() != right.ExpiresAt.String() ||\n1891|\t\tleft.Issuer != right.Issuer ||\n1892|\t\tleft.IssuerID != right.IssuerID ||\n1893|\t\t!equalStrings(left.Facts, right.Facts) ||\n1894|\t\tleft.TerminalBindingID != right.TerminalBindingID ||\n1895|\t\tleft.ProviderID != right.ProviderID ||\n1896|\t\tleft.ProviderBuild != right.ProviderBuild ||\n1897|\t\tleft.SentinelResult != right.SentinelResult ||\n1898|\t\tleft.ProviderAuthSmokeResult != right.ProviderAuthSmokeResult {\n1899|\t\treturn false\n1900|\t}\n1901|\treturn bytes.Equal(left.AttestationSignature, right.AttestationSignature)\n1902|}\n1903|\n1904|// checkEvidenceTuple binds one evidence object to this exact Manifest/Probe\n1905|// tuple: backend, versions, generation digest, platform, os_version, and\n1906|// the Manifest conformance fixture must all match.\n1907|func checkEvidenceTuple(manifest Manifest, probe Probe, object Evidence) error {\n1908|\tif object.TerminalBackendID != probe.TerminalBackendID ||\n1909|\t\tobject.ImplementationVersion != probe.ImplementationVersion ||\n1910|\t\tobject.ProtocolVersion != probe.ProtocolVersion ||\n1911|\t\tobject.BackendGenerationDigest != probe.BackendGenerationDigest ||\n1912|\t\tobject.Platform != probe.Platform ||\n1913|\t\tobject.OSVersion != probe.OSVersion ||\n1914|\t\tobject.ConformanceFixtureID != manifest.ConformanceFixtureID {\n1915|\t\treturn mismatchf(\"evidence tuple binding\")\n1916|\t}\n1917|\treturn nil\n1918|}\n1919|\n1920|// checkEvidenceLiveness requires observed_at <= now < expires_at. Future\n1921|// observed instants and expired objects are both unusable: the former is\n1922|// not yet proof, the latter no longer is.\n1923|func checkEvidenceLiveness(object Evidence, now time.Time) error {\n1924|\tobserved, err := object.ObservedAt.Time()\n1925|\tif err != nil {\n1926|\t\treturn mismatchf(\"document timestamp\")\n1927|\t}\n1928|\texpires, err := object.ExpiresAt.Time()\n1929|\tif err != nil {\n1930|\t\treturn mismatchf(\"document timestamp\")\n1931|\t}\n1932|\tif observed.After(now) || !now.Before(expires) {\n1933|\t\treturn mismatchf(\"evidence liveness\")\n1934|\t}\n1935|\treturn nil\n1936|}\n1937|\n1938|// checkEvidenceSignature verifies the attestation through the caller's\n1939|// trusted key registry. Missing, unknown-key, or invalid signatures fail\n1940|// closed before capability admission; a caller-supplied issuer ID alone is\n1941|// never authentication.\n1942|func checkEvidenceSignature(object Evidence, verify SignatureVerifier) error {\n1943|\tmessage, err := UnsignedEvidenceBytes(object)\n1944|\tif err != nil {\n1945|\t\treturn err\n1946|\t}\n1947|\tif err := verify(object.IssuerID, message, object.AttestationSignature); err != nil {\n1948|\t\treturn integrityFailure(\"evidence attestation\")\n1949|\t}\n1950|\treturn nil\n1951|}\n1952|\n1953|// checkEvidenceCoverage requires every true probe claim to hold at least\n1954|// one usable evidence object whose facts cover every listed requirement\n1955|// through the requirement-to-fact mapping. False claims need no evidence\n1956|// and take none: evidence for a false claim was already refused as\n1957|// unbound in checkEvidenceSet.\n1958|func checkEvidenceCoverage(probeClaims map[string]Claim, used []Evidence) error {\n1959|\tbyCapability := make(map[string][]Evidence, len(used))\n1960|\tfor _, object := range used {\n1961|\t\tbyCapability[object.Capability] = append(byCapability[object.Capability], object)\n1962|\t}\n1963|\tfor capability, claim := range probeClaims {\n1964|\t\tif !claim.Value {\n1965|\t\t\tcontinue\n1966|\t\t}\n1967|\t\tcovered := false\n1968|\t\tfor _, object := range byCapability[capability] {\n1969|\t\t\tif factsCover(object.Facts, claim.EvidenceRequirements) {\n1970|\t\t\t\tcovered = true\n1971|\t\t\t\tbreak\n1972|\t\t\t}\n1973|\t\t}\n1974|\t\tif !covered {\n1975|\t\t\treturn mismatchf(\"evidence requirement coverage\")\n1976|\t\t}\n1977|\t}\n1978|\treturn nil\n1979|}\n1980|\n1981|// factsCover reports whether the fact set satisfies every listed\n1982|// requirement through the requirement-to-fact mapping. Supplementary facts\n1983|// (ui_absent, prompt_absent) never satisfy a requirement alone.\n1984|func factsCover(facts []string, requirements []string) bool {\n1985|\theld := make(map[string]bool, len(facts))\n1986|\tfor _, fact := range facts {\n1987|\t\theld[fact] = true\n1988|\t}\n1989|\tfor _, requirement := range requirements {\n1990|\t\tif !held[requirementFact[requirement]] {\n1991|\t\t\treturn false\n1992|\t\t}\n1993|\t}\n1994|\treturn true\n1995|}\n1996|\n1997|// checkEvidenceIDs enforces the exact rule-6 set equality: evidence_ids\n1998|// must be exactly the sorted unique IDs of the usable evidence objects.\n1999|// Dangling IDs, unlisted usable objects, and ordering deviations all fail.\n2000|func checkEvidenceIDs(probe Probe, used []Evidence) error {\n2001|\twant := make([]string, 0, len(used))\n2002|\tfor _, object := range used {\n2003|\t\twant = append(want, object.EvidenceID)\n2004|\t}\n2005|\tfor index := range want {\n2006|\t\tfor next := index + 1; next < len(want); next++ {\n2007|\t\t\tif want[next] < want[index] {\n2008|\t\t\t\twant[index], want[next] = want[next], want[index]\n2009|\t\t\t}\n2010|\t\t}\n2011|\t}\n2012|\tif !equalStrings(probe.EvidenceIDs, want) {\n2013|\t\treturn mismatchf(\"evidence id set binding\")\n2014|\t}\n2015|\treturn nil\n2016|}\n2017|\n2018|// admitCapabilities collects the sorted admitted true-claim names and the\n2019|// sorted evidence IDs that proved them.\n2020|func admitCapabilities(probeClaims map[string]Claim, used []Evidence) Admitted {\n2021|\tvar capabilities []string\n2022|\tfor capability, claim := range probeClaims {\n2023|\t\tif claim.Value {\n2024|\t\t\tcapabilities = append(capabilities, capability)\n2025|\t\t}\n2026|\t}\n2027|\tfor index := range capabilities {\n(more lines below)","final_result":true}}}
