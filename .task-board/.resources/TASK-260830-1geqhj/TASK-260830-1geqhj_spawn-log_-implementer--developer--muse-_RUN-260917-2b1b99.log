{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7ab","stream":{"kind":"session","id":"01a0b0ab-f92f-74d3-a245-61ad42401b4b"},"sequence":560,"recorded_at":1780531400001115,"record_type":"event","durability":"durable","causation_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","run_stream":{"kind":"run","id":"8ab0c8df-167f-48db-b83c-f756aeede0a9"},"task_stream":{"kind":"task","id":"01a0b0ae-0240-7fd0-b58b-ec7eb0b7642d"},"task_id":"01a0b0ae-0240-7fd0-b58b-ec7eb0b7642d","event":{"kind":"output","task_id":"01a0b0ae-0240-7fd0-b58b-ec7eb0b7642d","chunk":"Read text file `internal/axpane/binding.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"crypto/sha256\"\n6|\t\"encoding/hex\"\n7|\t\"encoding/json\"\n8|\t\"errors\"\n9|\t\"fmt\"\n10|\t\"os\"\n11|\t\"path/filepath\"\n12|\t\"time\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n16|)\n17|\n18|// Binding schema identity. This is an AX-internal host-local durable\n19|// record (the §4.E host-local durable metadata class: the\n20|// idempotency receipt for the bootstrap window), not a replicated\n21|// contract: it is never published to the mesh and never leaves the\n22|// host.\n23|const (\n24|\tbindingSchema        = \"urn:ax:schema:pane-bootstrap-binding\"\n25|\tbindingSchemaVersion = \"1.0.0\"\n26|)\n27|\n28|// Binding is the one recorded wrapper/child for a\n29|// (session_id, bootstrap_operation_id) pair. Identity is the\n30|// AX-allocated terminal instance UUIDv7 plus the binding digest; a\n31|// PID, handle, socket, path, or endpoint is never identity and never\n32|// persisted here.\n33|type Binding struct {\n34|\tSessionID          string `json:\"session_id\"`\n35|\tOperationID        string `json:\"bootstrap_operation_id\"`\n36|\tTerminalInstanceID string `json:\"terminal_instance_id\"`\n37|\tBindingDigest      string `json:\"binding_digest\"`\n38|\tCreatedAt          string `json:\"created_at\"`\n39|}\n40|\n41|// bindingMembers is the exact closed member set of the stored\n42|// document.\n43|var bindingMembers = []string{\n44|\t\"schema\",\n45|\t\"schema_version\",\n46|\t\"session_id\",\n47|\t\"bootstrap_operation_id\",\n48|\t\"terminal_instance_id\",\n49|\t\"binding_digest\",\n50|\t\"created_at\",\n51|}\n52|\n53|// Hooks arms the crash boundaries of Bind: after the receipt bytes\n54|// are staged to the temporary file (before the atomic install), and\n55|// after the install commits (before the directory sync makes the\n56|// commit durable). A nil hook is a no-op; a hook error aborts Bind\n57|// with that error and installs nothing further.\n58|type Hooks struct {\n59|\tAfterStage   func(path string) error\n60|\tAfterInstall func(path string) error\n61|}\n62|\n63|// Store is the durable bootstrap binding store rooted at one data\n64|// directory. Bindings live under\n65|// <root>/axpane/bootstrap/<session_id>/binding.json.\n66|type Store struct {\n67|\troot  string\n68|\thooks *Hooks\n69|\tnow   func() time.Time\n70|}\n71|\n72|// Open creates the store, ensuring the root exists. It creates no\n73|// session directories: those appear with the first Bind.\n74|func Open(root string) (*Store, error) {\n75|\tif root == \"\" {\n76|\t\treturn nil, errors.New(\"axpane bootstrap store root is empty\")\n77|\t}\n78|\tbase := filepath.Join(root, \"axpane\", \"bootstrap\")\n79|\tif err := os.MkdirAll(base, 0o755); err != nil {\n80|\t\treturn nil, fmt.Errorf(\"create axpane bootstrap root: %w\", err)\n81|\t}\n82|\treturn &Store{root: root, now: time.Now}, nil\n83|}\n84|\n85|// WithHooks returns the store with crash hooks armed. It mutates the\n86|// receiver and returns it for call chaining.\n87|func (store *Store) WithHooks(hooks *Hooks) *Store {\n88|\tstore.hooks = hooks\n89|\treturn store\n90|}\n91|\n92|func (store *Store) sessionDir(sessionID string) string {\n93|\treturn filepath.Join(store.root, \"axpane\", \"bootstrap\", sessionID)\n94|}\n95|\n96|func (store *Store) bindingPath(sessionID string) string {\n97|\treturn filepath.Join(store.sessionDir(sessionID), \"binding.json\")\n98|}\n99|\n100|// Bind durably binds (session_id, bootstrap_operation_id) to the one\n101|// recorded wrapper/child before any launch side effect. The first\n102|// call for a session installs the candidate receipt; an identical\n103|// retry returns the stored receipt with reattached true; a changed\n104|// operation inside the bootstrap window refuses\n105|// idempotency_mismatch. The candidate's session and operation must\n106|// equal the call arguments; its instance ID and binding digest are\n107|// validated, and the store stamps created_at at install. The stored\n108|// receipt is authoritative on retry: a retry carrying different\n109|// child facts still reattaches to the one recorded child, never to\n110|// a second child.\n111|func (store *Store) Bind(sessionID, operationID string, candidate Binding) (Binding, bool, error) {\n112|\tempty := Binding{}\n113|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n114|\t\treturn empty, false, fmt.Errorf(\"bind session %q is not a UUIDv7: %w\", sessionID, err)\n115|\t}\n116|\tif _, err := scalar.ParseUUIDv7(operationID); err != nil {\n117|\t\treturn empty, false, fmt.Errorf(\"bind operation %q is not a UUIDv7: %w\", operationID, err)\n118|\t}\n119|\tif candidate.SessionID != sessionID || candidate.OperationID != operationID {\n120|\t\treturn empty, false, fmt.Errorf(\"bind candidate names another bootstrap pair\")\n121|\t}\n122|\tif err := checkBindingCandidate(candidate); err != nil {\n123|\t\treturn empty, false, err\n124|\t}\n125|\texisting, found, err := store.Status(sessionID)\n126|\tif err != nil {\n127|\t\treturn empty, false, err\n128|\t}\n129|\tif found {\n130|\t\tif existing.OperationID != operationID {\n131|\t\t\treturn empty, false, &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \"bootstrap binding\"}\n132|\t\t}\n133|\t\treturn existing, true, nil\n134|\t}\n135|\treceipt, err := encodeBinding(candidate, store.timestamp())\n136|\tif err != nil {\n137|\t\treturn empty, false, err\n138|\t}\n139|\tif err := store.install(sessionID, operationID, receipt); err != nil {\n140|\t\tvar concurrent errConcurrentWinner\n141|\t\tif errors.As(err, &concurrent) {\n142|\t\t\treturn concurrent.bound, true, nil\n143|\t\t}\n144|\t\treturn empty, false, err\n145|\t}\n146|\tstored, found, err := store.Status(sessionID)\n147|\tif err != nil {\n148|\t\treturn empty, false, err\n149|\t}\n150|\tif !found {\n151|\t\treturn empty, false, errors.New(\"bootstrap binding vanished after install\")\n152|\t}\n153|\treturn stored, false, nil\n154|}\n155|\n156|// Status proves absence or identifies the one recorded\n157|// wrapper/child: found is true with the stored receipt, or false\n158|// when no binding exists. A read or validation failure is an error,\n159|// never absence: unknown is not absent.\n160|func (store *Store) Status(sessionID string) (Binding, bool, error) {\n161|\tempty := Binding{}\n162|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n163|\t\treturn empty, false, fmt.Errorf(\"binding status session %q is not a UUIDv7: %w\", sessionID, err)\n164|\t}\n165|\traw, err := os.ReadFile(store.bindingPath(sessionID))\n166|\tif err != nil {\n167|\t\tif errors.Is(err, os.ErrNotExist) {\n168|\t\t\treturn empty, false, nil\n169|\t\t}\n170|\t\treturn empty, false, fmt.Errorf(\"read bootstrap binding: %w\", err)\n171|\t}\n172|\tbinding, err := decodeBinding(raw)\n173|\tif err != nil {\n174|\t\treturn empty, false, err\n175|\t}\n176|\tif binding.SessionID != sessionID {\n177|\t\treturn empty, false, errors.New(\"bootstrap binding names another session\")\n178|\t}\n179|\treturn binding, true, nil\n180|}\n181|\n182|func (store *Store) timestamp() string {\n183|\tnow := time.Now().UTC()\n184|\tif store.now != nil {\n185|\t\tnow = store.now().UTC()\n186|\t}\n187|\treturn now.Format(\"2006-01-02T15:04:05.000Z07:00\")\n188|}\n189|\n190|// install stages the receipt to a same-directory temporary file,\n191|// fsyncs it, atomically links it to the binding path (which must\n192|// not exist: the link is the no-replace commit), removes the\n193|// staging name, and fsyncs the directory. Readers see absence or\n194|// the complete receipt, never a torn prefix: a crash before the\n195|// link leaves only ignored staging garbage, and a crash after it\n196|// leaves the complete binding the identical retry reattaches to.\n197|// Any pre-existing binding refuses without replacement.\n198|// errConcurrentWinner carries the winning receipt when a concurrent\n199|// wrapper commits first: the loser reattaches instead of failing.\n200|type errConcurrentWinner struct {\n201|\tbound Binding\n202|}\n203|\n204|func (err errConcurrentWinner) Error() string {\n205|\treturn \"bootstrap binding concurrently committed by another wrapper\"\n206|}\n207|\n208|func (store *Store) install(sessionID, operationID string, receipt []byte) error {\n209|\tdir := store.sessionDir(sessionID)\n210|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n211|\t\treturn fmt.Errorf(\"create bootstrap session directory: %w\", err)\n212|\t}\n213|\ttarget := store.bindingPath(sessionID)\n214|\tstaged, err := os.CreateTemp(dir, \"binding-*.tmp\")\n215|\tif err != nil {\n216|\t\treturn fmt.Errorf(\"stage bootstrap binding: %w\", err)\n217|\t}\n218|\tstagedPath := staged.Name()\n219|\tdefer func() { _ = os.Remove(stagedPath) }()\n220|\tif err := staged.Chmod(0o600); err != nil {\n221|\t\t_ = staged.Close()\n222|\t\treturn fmt.Errorf(\"protect bootstrap binding: %w\", err)\n223|\t}\n224|\tif _, err := staged.Write(receipt); err != nil {\n225|\t\t_ = staged.Close()\n226|\t\treturn fmt.Errorf(\"write bootstrap binding: %w\", err)\n227|\t}\n228|\tif err := staged.Sync(); err != nil {\n229|\t\t_ = staged.Close()\n230|\t\treturn fmt.Errorf(\"sync bootstrap binding: %w\", err)\n231|\t}\n232|\tif err := staged.Close(); err != nil {\n233|\t\treturn fmt.Errorf(\"close bootstrap binding: %w\", err)\n234|\t}\n235|\tif store.hooks != nil && store.hooks.AfterStage != nil {\n236|\t\tif err := store.hooks.AfterStage(stagedPath); err != nil {\n237|\t\t\treturn err\n238|\t\t}\n239|\t}\n240|\tif err := os.Link(stagedPath, target); err != nil {\n241|\t\tif errors.Is(err, os.ErrExist) {\n242|\t\t\t// A concurrent wrapper won the commit between our\n243|\t\t\t// Status and our link: re-read the winner. The\n244|\t\t\t// same operation reattaches to it; a changed\n245|\t\t\t// operation is the bootstrap-window mismatch.\n246|\t\t\twinner, found, readErr := store.Status(sessionID)\n247|\t\t\tif readErr != nil {\n248|\t\t\t\treturn readErr\n249|\t\t\t}\n250|\t\t\tif !found {\n251|\t\t\t\treturn &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \"bootstrap binding\"}\n252|\t\t\t}\n253|\t\t\tif winner.OperationID != operationID {\n254|\t\t\t\treturn &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \"bootstrap binding\"}\n255|\t\t\t}\n256|\t\t\treturn errConcurrentWinner{bound: winner}\n257|\t\t}\n258|\t\treturn fmt.Errorf(\"install bootstrap binding: %w\", err)\n259|\t}\n260|\t_ = os.Remove(stagedPath)\n261|\tif store.hooks != nil && store.hooks.AfterInstall != nil {\n262|\t\tif err := store.hooks.AfterInstall(target); err != nil {\n263|\t\t\treturn err\n264|\t\t}\n265|\t}\n266|\tif err := syncDirectory(dir); err != nil {\n267|\t\treturn err\n268|\t}\n269|\treturn nil\n270|}\n271|\n272|func checkBindingCandidate(candidate Binding) error {\n273|\tif _, err := scalar.ParseUUIDv7(candidate.SessionID); err != nil {\n274|\t\treturn fmt.Errorf(\"binding session %q is not a UUIDv7: %w\", candidate.SessionID, err)\n275|\t}\n276|\tif _, err := scalar.ParseUUIDv7(candidate.OperationID); err != nil {\n277|\t\treturn fmt.Errorf(\"binding operation %q is not a UUIDv7: %w\", candidate.OperationID, err)\n278|\t}\n279|\tif _, err := scalar.ParseUUIDv7(candidate.TerminalInstanceID); err != nil {\n280|\t\treturn fmt.Errorf(\"binding terminal instance %q is not a UUIDv7: %w\", candidate.TerminalInstanceID, err)\n281|\t}\n282|\tif _, err := scalar.ParseDigest(candidate.BindingDigest); err != nil {\n283|\t\treturn fmt.Errorf(\"binding digest is not a digest: %w\", err)\n284|\t}\n285|\t// The candidate carries no timestamp: the store stamps\n286|\t// created_at at install, so a caller clock never enters the\n287|\t// receipt. Stored receipts validate their stamp at decode.\n288|\treturn nil\n289|}\n290|\n291|func encodeBinding(candidate Binding, createdAt string) ([]byte, error) {\n292|\tstored := candidate\n293|\tstored.CreatedAt = createdAt\n294|\tdocument := map[string]string{\n295|\t\t\"schema\":                 bindingSchema,\n296|\t\t\"schema_version\":         bindingSchemaVersion,\n297|\t\t\"session_id\":             stored.SessionID,\n298|\t\t\"bootstrap_operation_id\": stored.OperationID,\n299|\t\t\"terminal_instance_id\":   stored.TerminalInstanceID,\n300|\t\t\"binding_digest\":         stored.BindingDigest,\n301|\t\t\"created_at\":             stored.CreatedAt,\n302|\t}\n303|\traw, err := json.Marshal(document)\n304|\tif err != nil {\n305|\t\treturn nil, fmt.Errorf(\"encode bootstrap binding: %w\", err)\n306|\t}\n307|\treturn raw, nil\n308|}\n309|\n310|func decodeBinding(raw []byte) (Binding, error) {\n311|\tempty := Binding{}\n312|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n313|\tdecoder.DisallowUnknownFields()\n314|\tvar document struct {\n315|\t\tSchema             string `json:\"schema\"`\n316|\t\tSchemaVersion      string `json:\"schema_version\"`\n317|\t\tSessionID          string `json:\"session_id\"`\n318|\t\tOperationID        string `json:\"bootstrap_operation_id\"`\n319|\t\tTerminalInstanceID string `json:\"terminal_instance_id\"`\n320|\t\tBindingDigest      string `json:\"binding_digest\"`\n321|\t\tCreatedAt          string `json:\"created_at\"`\n322|\t}\n323|\tif err := decoder.Decode(&document); err != nil {\n324|\t\treturn empty, fmt.Errorf(\"bootstrap binding is not the closed shape: %w\", err)\n325|\t}\n326|\tif decoder.More() {\n327|\t\treturn empty, fmt.Errorf(\"bootstrap binding carries trailing data\")\n328|\t}\n329|\tvar members map[string]json.RawMessage\n330|\tif err := json.Unmarshal(raw, &members); err != nil {\n331|\t\treturn empty, fmt.Errorf(\"bootstrap binding is not an object: %w\", err)\n332|\t}\n333|\tfor _, name := range bindingMembers {\n334|\t\tif _, ok := members[name]; !ok {\n335|\t\t\treturn empty, fmt.Errorf(\"bootstrap binding misses required member %q\", name)\n336|\t\t}\n337|\t}\n338|\tif document.Schema != bindingSchema || document.SchemaVersion != bindingSchemaVersion {\n339|\t\treturn empty, fmt.Errorf(\"bootstrap binding schema is not %s %s\", bindingSchema, bindingSchemaVersion)\n340|\t}\n341|\tbinding := Binding{\n342|\t\tSessionID:          document.SessionID,\n343|\t\tOperationID:        document.OperationID,\n344|\t\tTerminalInstanceID: document.TerminalInstanceID,\n345|\t\tBindingDigest:      document.BindingDigest,\n346|\t\tCreatedAt:          document.CreatedAt,\n347|\t}\n348|\tif err := checkBindingCandidate(binding); err != nil {\n349|\t\treturn empty, err\n350|\t}\n351|\tif _, err := scalar.ParseTimestamp(binding.CreatedAt); err != nil {\n352|\t\treturn empty, fmt.Errorf(\"binding timestamp is not a timestamp: %w\", err)\n353|\t}\n354|\treturn binding, nil\n355|}\n356|\n357|// BindingDigest computes the opaque binding digest over the canonical\n358|// receipt bytes: the value a §7.A descriptor carries as\n359|// terminal_binding_id. It reveals no generation, PID, or native\n360|// reference.\n361|func BindingDigest(binding Binding) string {\n362|\tsum := sha256.Sum256([]byte(binding.SessionID + \"\\x00\" + binding.OperationID + \"\\x00\" + binding.TerminalInstanceID))\n363|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n364|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7ad","stream":{"kind":"session","id":"01a0b0ab-f92f-74d3-a245-61ad42401b4b"},"sequence":561,"recorded_at":1780531400001117,"record_type":"event","durability":"durable","causation_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","run_stream":{"kind":"run","id":"8ab0c8df-167f-48db-b83c-f756aeede0a9"},"task_stream":{"kind":"task","id":"01a0b0ae-0240-7fd0-b58b-ec7eb0b7642d"},"task_id":"01a0b0ae-0240-7fd0-b58b-ec7eb0b7642d","event":{"kind":"completed","task_id":"01a0b0ae-0240-7fd0-b58b-ec7eb0b7642d"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7af","stream":{"kind":"session","id":"01a0b0ab-f92f-74d3-a245-61ad42401b4b"},"sequence":562,"recorded_at":1780531400001119,"record_type":"event","durability":"durable","causation_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","run_stream":{"kind":"run","id":"8ab0c8df-167f-48db-b83c-f756aeede0a9"},"task_stream":{"kind":"task","id":"01a0b0ae-034f-75c2-8bdf-133286219cae"},"task_id":"01a0b0ae-034f-75c2-8bdf-133286219cae","event":{"kind":"output","task_id":"01a0b0ae-034f-75c2-8bdf-133286219cae","chunk":"Read text file `internal/axpane/doc.go`.\n1|// Package axpane implements the validation core of the\n2|// `ax pane SESSION_ID` enforcement wrapper: the decision every managed\n3|// pane runs before launching, reattaching, offering, parking, or\n4|// refusing a provider.\n5|//\n6|// Normative scope: AX v0.6.0 Section 4.B (Terminal Backend\n7|// Manifest/Probe identity through the landed terminalbackend registry\n8|// and contract), Section 4.C/4.1/4.2 (the wrapper rule: validate\n9|// configuration, load the logical session, synchronize known lease\n10|// records when possible, compare the local fencing token before\n11|// launching a provider, park safely when ownership is remote,\n12|// ambiguous, or unverified; the after-restore sequence 1-5; terminal\n13|// creation and the wrapper's first child start idempotent on\n14|// (session_id, bootstrap_operation_id); no credential-dependent tmux\n15|// server creation from a background caller; a cached sentinel or\n16|// managername observation never authorizes resume), Section 4.D\n17|// (closed capabilities and evidence: only the exact admitted\n18|// capability rows authorize an action), Section 5.2 Terminal Events\n19|// (session.parked with its reason vocabulary, terminal.created and\n20|// session.resumed v4 terminal binding/evidence payloads), Section 7.A\n21|// (Provider Protocol 3.0.0 Terminal Instance binding descriptor),\n22|// and Section 13.1 Direct-session launch steps 3-4 (durable terminal\n23|// entry with the bootstrap operation ID, then provider launch with\n24|// its validated argv/env plan).\n25|//\n26|// Division of authority (no second model): every check is composed\n27|// from a landed gate, never re-implemented. Owner epoch and fencing\n28|// come from internal/fencing (AuthorizeActivation, AuthorizeRestore,\n29|// AuthorizeInput, the sealed LeaseToken projection, the parked\n30|// vocabulary); materialization validity from internal/matjournal\n31|// (Store.Get with its grammar and cross-reference validation plus\n32|// the committed-phase rule this package states) and checkpoint\n33|// admission from internal/sessckpt with internal/sessrepo attestation;\n34|// the effective persisted profile from internal/sessprofile\n35|// (Projector/Derive) with Section 7.7 mapping refusals from\n36|// internal/provhost (ResolveMapping, profile_mapping_unavailable);\n37|// provider identity from internal/provhost (CheckResumeTuple,\n38|// VerifyIdentityBuild, VerifyIdentityDiscovery) with\n39|// internal/resumesmoke evidence (VerifyRecord) as a precondition\n40|// input; backend identity from internal/terminalbackend\n41|// (ParseManifest, ParseProbe, ParseEvidence, GenerationDigest,\n42|// Reconcile, CapabilitiesForOperation, CheckOperation,\n43|// CheckEntrypoint, AdmitProviderDescriptor); configuration validity\n44|// from internal/config (Load); session, lease, and event durability\n45|// from internal/sessrepo (GetRecord, ListEvents, Observe/WinningLease,\n46|// AppendEvent); refusal shapes from internal/axerror\n47|// (NewRealmEvidenceUnavailable for the background-caller\n48|// capability_unavailable with typed realm/readiness details).\n49|//\n50|// The pure core is Decide: exactly one of\n51|// launch|reattach|attach_remote|takeover_offer|parked(reason)|\n52|// refused(class). Arm order is precedence and is pinned by the\n53|// decision table: configuration, session, bootstrap idempotency,\n54|// backend identity and capability admission, fencing (activation or\n55|// restore entry), materialization, checkpoint, provider identity,\n56|// provider-auth smoke, realm readiness, profile derivation and\n57|// mapping, entrypoint, provider descriptor, then the outcome\n58|// selection (reattach, remote attach/takeover offer, launch).\n59|//\n60|// Durable state: the bootstrap binding store (binding.go) binds\n61|// (session_id, bootstrap_operation_id) to the one recorded\n62|// wrapper/child before any launch side effect under the landed\n63|// no-replace + fsync discipline with crash hooks. It never persists\n64|// or replicates a PID: identity is the AX-allocated UUIDv7 terminal\n65|// instance ID plus the binding digest. Parked decisions are authored\n66|// through sessrepo.AppendEvent under the current lease (events.go).\n67|//\n68|// Bounds: no `ax` CLI surface, no tmux/ConPTY process control, no\n69|// provider process supervision, no mesh transport, and no GUI/Keychain\n70|// broker live here. Those are modeled callers (their facts arrive as\n71|// Decide inputs) and later leaves. The mesh lease refresh of\n72|// after-restore step 2 is a caller-reported fact (Verified), not a\n73|// network call. Signature verification is caller-supplied through\n74|// terminalbackend.SignatureVerifier.\n75|package axpane","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7b1","stream":{"kind":"session","id":"01a0b0ab-f92f-74d3-a245-61ad42401b4b"},"sequence":563,"recorded_at":1780531400001121,"record_type":"event","durability":"durable","causation_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","run_stream":{"kind":"run","id":"8ab0c8df-167f-48db-b83c-f756aeede0a9"},"task_stream":{"kind":"task","id":"01a0b0ae-034f-75c2-8bdf-133286219cae"},"task_id":"01a0b0ae-034f-75c2-8bdf-133286219cae","event":{"kind":"completed","task_id":"01a0b0ae-034f-75c2-8bdf-133286219cae"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7b3","stream":{"kind":"session","id":"01a0b0ab-f92f-74d3-a245-61ad42401b4b"},"sequence":564,"recorded_at":1780531400001123,"record_type":"event","durability":"durable","causation_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","run_stream":{"kind":"run","id":"8ab0c8df-167f-48db-b83c-f756aeede0a9"},"call_id":"call_01a0b0adfb3972da8b631b48230b9238","text":"Read text file `internal/axpane/binding.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"crypto/sha256\"\n6|\t\"encoding/hex\"\n7|\t\"encoding/json\"\n8|\t\"errors\"\n9|\t\"fmt\"\n10|\t\"os\"\n11|\t\"path/filepath\"\n12|\t\"time\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n16|)\n17|\n18|// Binding schema identity. This is an AX-internal host-local durable\n19|// record (the §4.E host-local durable metadata class: the\n20|// idempotency receipt for the bootstrap window), not a replicated\n21|// contract: it is never published to the mesh and never leaves the\n22|// host.\n23|const (\n24|\tbindingSchema        = \"urn:ax:schema:pane-bootstrap-binding\"\n25|\tbindingSchemaVersion = \"1.0.0\"\n26|)\n27|\n28|// Binding is the one recorded wrapper/child for a\n29|// (session_id, bootstrap_operation_id) pair. Identity is the\n30|// AX-allocated terminal instance UUIDv7 plus the binding digest; a\n31|// PID, handle, socket, path, or endpoint is never identity and never\n32|// persisted here.\n33|type Binding struct {\n34|\tSessionID          string `json:\"session_id\"`\n35|\tOperationID        string `json:\"bootstrap_operation_id\"`\n36|\tTerminalInstanceID string `json:\"terminal_instance_id\"`\n37|\tBindingDigest      string `json:\"binding_digest\"`\n38|\tCreatedAt          string `json:\"created_at\"`\n39|}\n40|\n41|// bindingMembers is the exact closed member set of the stored\n42|// document.\n43|var bindingMembers = []string{\n44|\t\"schema\",\n45|\t\"schema_version\",\n46|\t\"session_id\",\n47|\t\"bootstrap_operation_id\",\n48|\t\"terminal_instance_id\",\n49|\t\"binding_digest\",\n50|\t\"created_at\",\n51|}\n52|\n53|// Hooks arms the crash boundaries of Bind: after the receipt bytes\n54|// are staged to the temporary file (before the atomic install), and\n55|// after the install commits (before the directory sync makes the\n56|// commit durable). A nil hook is a no-op; a hook error aborts Bind\n57|// with that error and installs nothing further.\n58|type Hooks struct {\n59|\tAfterStage   func(path string) error\n60|\tAfterInstall func(path string) error\n61|}\n62|\n63|// Store is the durable bootstrap binding store rooted at one data\n64|// directory. Bindings live under\n65|// <root>/axpane/bootstrap/<session_id>/binding.json.\n66|type Store struct {\n67|\troot  string\n68|\thooks *Hooks\n69|\tnow   func() time.Time\n70|}\n71|\n72|// Open creates the store, ensuring the root exists. It creates no\n73|// session directories: those appear with the first Bind.\n74|func Open(root string) (*Store, error) {\n75|\tif root == \"\" {\n76|\t\treturn nil, errors.New(\"axpane bootstrap store root is empty\")\n77|\t}\n78|\tbase := filepath.Join(root, \"axpane\", \"bootstrap\")\n79|\tif err := os.MkdirAll(base, 0o755); err != nil {\n80|\t\treturn nil, fmt.Errorf(\"create axpane bootstrap root: %w\", err)\n81|\t}\n82|\treturn &Store{root: root, now: time.Now}, nil\n83|}\n84|\n85|// WithHooks returns the store with crash hooks armed. It mutates the\n86|// receiver and returns it for call chaining.\n87|func (store *Store) WithHooks(hooks *Hooks) *Store {\n88|\tstore.hooks = hooks\n89|\treturn store\n90|}\n91|\n92|func (store *Store) sessionDir(sessionID string) string {\n93|\treturn filepath.Join(store.root, \"axpane\", \"bootstrap\", sessionID)\n94|}\n95|\n96|func (store *Store) bindingPath(sessionID string) string {\n97|\treturn filepath.Join(store.sessionDir(sessionID), \"binding.json\")\n98|}\n99|\n100|// Bind durably binds (session_id, bootstrap_operation_id) to the one\n101|// recorded wrapper/child before any launch side effect. The first\n102|// call for a session installs the candidate receipt; an identical\n103|// retry returns the stored receipt with reattached true; a changed\n104|// operation inside the bootstrap window refuses\n105|// idempotency_mismatch. The candidate's session and operation must\n106|// equal the call arguments; its instance ID and binding digest are\n107|// validated, and the store stamps created_at at install. The stored\n108|// receipt is authoritative on retry: a retry carrying different\n109|// child facts still reattaches to the one recorded child, never to\n110|// a second child.\n111|func (store *Store) Bind(sessionID, operationID string, candidate Binding) (Binding, bool, error) {\n112|\tempty := Binding{}\n113|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n114|\t\treturn empty, false, fmt.Errorf(\"bind session %q is not a UUIDv7: %w\", sessionID, err)\n115|\t}\n116|\tif _, err := scalar.ParseUUIDv7(operationID); err != nil {\n117|\t\treturn empty, false, fmt.Errorf(\"bind operation %q is not a UUIDv7: %w\", operationID, err)\n118|\t}\n119|\tif candidate.SessionID != sessionID || candidate.OperationID != operationID {\n120|\t\treturn empty, false, fmt.Errorf(\"bind candidate names another bootstrap pair\")\n121|\t}\n122|\tif err := checkBindingCandidate(candidate); err != nil {\n123|\t\treturn empty, false, err\n124|\t}\n125|\texisting, found, err := store.Status(sessionID)\n126|\tif err != nil {\n127|\t\treturn empty, false, err\n128|\t}\n129|\tif found {\n130|\t\tif existing.OperationID != operationID {\n131|\t\t\treturn empty, false, &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \"bootstrap binding\"}\n132|\t\t}\n133|\t\treturn existing, true, nil\n134|\t}\n135|\treceipt, err := encodeBinding(candidate, store.timestamp())\n136|\tif err != nil {\n137|\t\treturn empty, false, err\n138|\t}\n139|\tif err := store.install(sessionID, operationID, receipt); err != nil {\n140|\t\tvar concurrent errConcurrentWinner\n141|\t\tif errors.As(err, &concurrent) {\n142|\t\t\treturn concurrent.bound, true, nil\n143|\t\t}\n144|\t\treturn empty, false, err\n145|\t}\n146|\tstored, found, err := store.Status(sessionID)\n147|\tif err != nil {\n148|\t\treturn empty, false, err\n149|\t}\n150|\tif !found {\n151|\t\treturn empty, false, errors.New(\"bootstrap binding vanished after install\")\n152|\t}\n153|\treturn stored, false, nil\n154|}\n155|\n156|// Status proves absence or identifies the one recorded\n157|// wrapper/child: found is true with the stored receipt, or false\n158|// when no binding exists. A read or validation failure is an error,\n159|// never absence: unknown is not absent.\n160|func (store *Store) Status(sessionID string) (Binding, bool, error) {\n161|\tempty := Binding{}\n162|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n163|\t\treturn empty, false, fmt.Errorf(\"binding status session %q is not a UUIDv7: %w\", sessionID, err)\n164|\t}\n165|\traw, err := os.ReadFile(store.bindingPath(sessionID))\n166|\tif err != nil {\n167|\t\tif errors.Is(err, os.ErrNotExist) {\n168|\t\t\treturn empty, false, nil\n169|\t\t}\n170|\t\treturn empty, false, fmt.Errorf(\"read bootstrap binding: %w\", err)\n171|\t}\n172|\tbinding, err := decodeBinding(raw)\n173|\tif err != nil {\n174|\t\treturn empty, false, err\n175|\t}\n176|\tif binding.SessionID != sessionID {\n177|\t\treturn empty, false, errors.New(\"bootstrap binding names another session\")\n178|\t}\n179|\treturn binding, true, nil\n180|}\n181|\n182|func (store *Store) timestamp() string {\n183|\tnow := time.Now().UTC()\n184|\tif store.now != nil {\n185|\t\tnow = store.now().UTC()\n186|\t}\n187|\treturn now.Format(\"2006-01-02T15:04:05.000Z07:00\")\n188|}\n189|\n190|// install stages the receipt to a same-directory temporary file,\n191|// fsyncs it, atomically links it to the binding path (which must\n192|// not exist: the link is the no-replace commit), removes the\n193|// staging name, and fsyncs the directory. Readers see absence or\n194|// the complete receipt, never a torn prefix: a crash before the\n195|// link leaves only ignored staging garbage, and a crash after it\n196|// leaves the complete binding the identical retry reattaches to.\n197|// Any pre-existing binding refuses without replacement.\n198|// errConcurrentWinner carries the winning receipt when a concurrent\n199|// wrapper commits first: the loser reattaches instead of failing.\n200|type errConcurrentWinner struct {\n201|\tbound Binding\n202|}\n203|\n204|func (err errConcurrentWinner) Error() string {\n205|\treturn \"bootstrap binding concurrently committed by another wrapper\"\n206|}\n207|\n208|func (store *Store) install(sessionID, operationID string, receipt []byte) error {\n209|\tdir := store.sessionDir(sessionID)\n210|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n211|\t\treturn fmt.Errorf(\"create bootstrap session directory: %w\", err)\n212|\t}\n213|\ttarget := store.bindingPath(sessionID)\n214|\tstaged, err := os.CreateTemp(dir, \"binding-*.tmp\")\n215|\tif err != nil {\n216|\t\treturn fmt.Errorf(\"stage bootstrap binding: %w\", err)\n217|\t}\n218|\tstagedPath := staged.Name()\n219|\tdefer func() { _ = os.Remove(stagedPath) }()\n220|\tif err := staged.Chmod(0o600); err != nil {\n221|\t\t_ = staged.Close()\n222|\t\treturn fmt.Errorf(\"protect bootstrap binding: %w\", err)\n223|\t}\n224|\tif _, err := staged.Write(receipt); err != nil {\n225|\t\t_ = staged.Close()\n226|\t\treturn fmt.Errorf(\"write bootstrap binding: %w\", err)\n227|\t}\n228|\tif err := staged.Sync(); err != nil {\n229|\t\t_ = staged.Close()\n230|\t\treturn fmt.Errorf(\"sync bootstrap binding: %w\", err)\n231|\t}\n232|\tif err := staged.Close(); err != nil {\n233|\t\treturn fmt.Errorf(\"close bootstrap binding: %w\", err)\n234|\t}\n235|\tif store.hooks != nil && store.hooks.AfterStage != nil {\n236|\t\tif err := store.hooks.AfterStage(stagedPath); err != nil {\n237|\t\t\treturn err\n238|\t\t}\n239|\t}\n240|\tif err := os.Link(stagedPath, target); err != nil {\n241|\t\tif errors.Is(err, os.ErrExist) {\n242|\t\t\t// A concurrent wrapper won the commit between our\n243|\t\t\t// Status and our link: re-read the winner. The\n244|\t\t\t// same operation reattaches to it; a changed\n245|\t\t\t// operation is the bootstrap-window mismatch.\n246|\t\t\twinner, found, readErr := store.Status(sessionID)\n247|\t\t\tif readErr != nil {\n248|\t\t\t\treturn readErr\n249|\t\t\t}\n250|\t\t\tif !found {\n251|\t\t\t\treturn &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \"bootstrap binding\"}\n252|\t\t\t}\n253|\t\t\tif winner.OperationID != operationID {\n254|\t\t\t\treturn &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \"bootstrap binding\"}\n255|\t\t\t}\n256|\t\t\treturn errConcurrentWinner{bound: winner}\n257|\t\t}\n258|\t\treturn fmt.Errorf(\"install bootstrap binding: %w\", err)\n259|\t}\n260|\t_ = os.Remove(stagedPath)\n261|\tif store.hooks != nil && store.hooks.AfterInstall != nil {\n262|\t\tif err := store.hooks.AfterInstall(target); err != nil {\n263|\t\t\treturn err\n264|\t\t}\n265|\t}\n266|\tif err := syncDirectory(dir); err != nil {\n267|\t\treturn err\n268|\t}\n269|\treturn nil\n270|}\n271|\n272|func checkBindingCandidate(candidate Binding) error {\n273|\tif _, err := scalar.ParseUUIDv7(candidate.SessionID); err != nil {\n274|\t\treturn fmt.Errorf(\"binding session %q is not a UUIDv7: %w\", candidate.SessionID, err)\n275|\t}\n276|\tif _, err := scalar.ParseUUIDv7(candidate.OperationID); err != nil {\n277|\t\treturn fmt.Errorf(\"binding operation %q is not a UUIDv7: %w\", candidate.OperationID, err)\n278|\t}\n279|\tif _, err := scalar.ParseUUIDv7(candidate.TerminalInstanceID); err != nil {\n280|\t\treturn fmt.Errorf(\"binding terminal instance %q is not a UUIDv7: %w\", candidate.TerminalInstanceID, err)\n281|\t}\n282|\tif _, err := scalar.ParseDigest(candidate.BindingDigest); err != nil {\n283|\t\treturn fmt.Errorf(\"binding digest is not a digest: %w\", err)\n284|\t}\n285|\t// The candidate carries no timestamp: the store stamps\n286|\t// created_at at install, so a caller clock never enters the\n287|\t// receipt. Stored receipts validate their stamp at decode.\n288|\treturn nil\n289|}\n290|\n291|func encodeBinding(candidate Binding, createdAt string) ([]byte, error) {\n292|\tstored := candidate\n293|\tstored.CreatedAt = createdAt\n294|\tdocument := map[string]string{\n295|\t\t\"schema\":                 bindingSchema,\n296|\t\t\"schema_version\":         bindingSchemaVersion,\n297|\t\t\"session_id\":             stored.SessionID,\n298|\t\t\"bootstrap_operation_id\": stored.OperationID,\n299|\t\t\"terminal_instance_id\":   stored.TerminalInstanceID,\n300|\t\t\"binding_digest\":         stored.BindingDigest,\n301|\t\t\"created_at\":             stored.CreatedAt,\n302|\t}\n303|\traw, err := json.Marshal(document)\n304|\tif err != nil {\n305|\t\treturn nil, fmt.Errorf(\"encode bootstrap binding: %w\", err)\n306|\t}\n307|\treturn raw, nil\n308|}\n309|\n310|func decodeBinding(raw []byte) (Binding, error) {\n311|\tempty := Binding{}\n312|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n313|\tdecoder.DisallowUnknownFields()\n314|\tvar document struct {\n315|\t\tSchema             string `json:\"schema\"`\n316|\t\tSchemaVersion      string `json:\"schema_version\"`\n317|\t\tSessionID          string `json:\"session_id\"`\n318|\t\tOperationID        string `json:\"bootstrap_operation_id\"`\n319|\t\tTerminalInstanceID string `json:\"terminal_instance_id\"`\n320|\t\tBindingDigest      string `json:\"binding_digest\"`\n321|\t\tCreatedAt          string `json:\"created_at\"`\n322|\t}\n323|\tif err := decoder.Decode(&document); err != nil {\n324|\t\treturn empty, fmt.Errorf(\"bootstrap binding is not the closed shape: %w\", err)\n325|\t}\n326|\tif decoder.More() {\n327|\t\treturn empty, fmt.Errorf(\"bootstrap binding carries trailing data\")\n328|\t}\n329|\tvar members map[string]json.RawMessage\n330|\tif err := json.Unmarshal(raw, &members); err != nil {\n331|\t\treturn empty, fmt.Errorf(\"bootstrap binding is not an object: %w\", err)\n332|\t}\n333|\tfor _, name := range bindingMembers {\n334|\t\tif _, ok := members[name]; !ok {\n335|\t\t\treturn empty, fmt.Errorf(\"bootstrap binding misses required member %q\", name)\n336|\t\t}\n337|\t}\n338|\tif document.Schema != bindingSchema || document.SchemaVersion != bindingSchemaVersion {\n339|\t\treturn empty, fmt.Errorf(\"bootstrap binding schema is not %s %s\", bindingSchema, bindingSchemaVersion)\n340|\t}\n341|\tbinding := Binding{\n342|\t\tSessionID:          document.SessionID,\n343|\t\tOperationID:        document.OperationID,\n344|\t\tTerminalInstanceID: document.TerminalInstanceID,\n345|\t\tBindingDigest:      document.BindingDigest,\n346|\t\tCreatedAt:          document.CreatedAt,\n347|\t}\n348|\tif err := checkBindingCandidate(binding); err != nil {\n349|\t\treturn empty, err\n350|\t}\n351|\tif _, err := scalar.ParseTimestamp(binding.CreatedAt); err != nil {\n352|\t\treturn empty, fmt.Errorf(\"binding timestamp is not a timestamp: %w\", err)\n353|\t}\n354|\treturn binding, nil\n355|}\n356|\n357|// BindingDigest computes the opaque binding digest over the canonical\n358|// receipt bytes: the value a §7.A descriptor carries as\n359|// terminal_binding_id. It reveals no generation, PID, or native\n360|// reference.\n361|func BindingDigest(binding Binding) string {\n362|\tsum := sha256.Sum256([]byte(binding.SessionID + \"\\x00\" + binding.OperationID + \"\\x00\" + binding.TerminalInstanceID))\n363|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n364|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7b5","stream":{"kind":"session","id":"01a0b0ab-f92f-74d3-a245-61ad42401b4b"},"sequence":565,"recorded_at":1780531400001125,"record_type":"event","durability":"durable","causation_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","run_stream":{"kind":"run","id":"8ab0c8df-167f-48db-b83c-f756aeede0a9"},"call_id":"call_01a0b0adfdbb72318aaecbdad9b2d2f5","text":"Read text file `internal/axpane/doc.go`.\n1|// Package axpane implements the validation core of the\n2|// `ax pane SESSION_ID` enforcement wrapper: the decision every managed\n3|// pane runs before launching, reattaching, offering, parking, or\n4|// refusing a provider.\n5|//\n6|// Normative scope: AX v0.6.0 Section 4.B (Terminal Backend\n7|// Manifest/Probe identity through the landed terminalbackend registry\n8|// and contract), Section 4.C/4.1/4.2 (the wrapper rule: validate\n9|// configuration, load the logical session, synchronize known lease\n10|// records when possible, compare the local fencing token before\n11|// launching a provider, park safely when ownership is remote,\n12|// ambiguous, or unverified; the after-restore sequence 1-5; terminal\n13|// creation and the wrapper's first child start idempotent on\n14|// (session_id, bootstrap_operation_id); no credential-dependent tmux\n15|// server creation from a background caller; a cached sentinel or\n16|// managername observation never authorizes resume), Section 4.D\n17|// (closed capabilities and evidence: only the exact admitted\n18|// capability rows authorize an action), Section 5.2 Terminal Events\n19|// (session.parked with its reason vocabulary, terminal.created and\n20|// session.resumed v4 terminal binding/evidence payloads), Section 7.A\n21|// (Provider Protocol 3.0.0 Terminal Instance binding descriptor),\n22|// and Section 13.1 Direct-session launch steps 3-4 (durable terminal\n23|// entry with the bootstrap operation ID, then provider launch with\n24|// its validated argv/env plan).\n25|//\n26|// Division of authority (no second model): every check is composed\n27|// from a landed gate, never re-implemented. Owner epoch and fencing\n28|// come from internal/fencing (AuthorizeActivation, AuthorizeRestore,\n29|// AuthorizeInput, the sealed LeaseToken projection, the parked\n30|// vocabulary); materialization validity from internal/matjournal\n31|// (Store.Get with its grammar and cross-reference validation plus\n32|// the committed-phase rule this package states) and checkpoint\n33|// admission from internal/sessckpt with internal/sessrepo attestation;\n34|// the effective persisted profile from internal/sessprofile\n35|// (Projector/Derive) with Section 7.7 mapping refusals from\n36|// internal/provhost (ResolveMapping, profile_mapping_unavailable);\n37|// provider identity from internal/provhost (CheckResumeTuple,\n38|// VerifyIdentityBuild, VerifyIdentityDiscovery) with\n39|// internal/resumesmoke evidence (VerifyRecord) as a precondition\n40|// input; backend identity from internal/terminalbackend\n41|// (ParseManifest, ParseProbe, ParseEvidence, GenerationDigest,\n42|// Reconcile, CapabilitiesForOperation, CheckOperation,\n43|// CheckEntrypoint, AdmitProviderDescriptor); configuration validity\n44|// from internal/config (Load); session, lease, and event durability\n45|// from internal/sessrepo (GetRecord, ListEvents, Observe/WinningLease,\n46|// AppendEvent); refusal shapes from internal/axerror\n47|// (NewRealmEvidenceUnavailable for the background-caller\n48|// capability_unavailable with typed realm/readiness details).\n49|//\n50|// The pure core is Decide: exactly one of\n51|// launch|reattach|attach_remote|takeover_offer|parked(reason)|\n52|// refused(class). Arm order is precedence and is pinned by the\n53|// decision table: configuration, session, bootstrap idempotency,\n54|// backend identity and capability admission, fencing (activation or\n55|// restore entry), materialization, checkpoint, provider identity,\n56|// provider-auth smoke, realm readiness, profile derivation and\n57|// mapping, entrypoint, provider descriptor, then the outcome\n58|// selection (reattach, remote attach/takeover offer, launch).\n59|//\n60|// Durable state: the bootstrap binding store (binding.go) binds\n61|// (session_id, bootstrap_operation_id) to the one recorded\n62|// wrapper/child before any launch side effect under the landed\n63|// no-replace + fsync discipline with crash hooks. It never persists\n64|// or replicates a PID: identity is the AX-allocated UUIDv7 terminal\n65|// instance ID plus the binding digest. Parked decisions are authored\n66|// through sessrepo.AppendEvent under the current lease (events.go).\n67|//\n68|// Bounds: no `ax` CLI surface, no tmux/ConPTY process control, no\n69|// provider process supervision, no mesh transport, and no GUI/Keychain\n70|// broker live here. Those are modeled callers (their facts arrive as\n71|// Decide inputs) and later leaves. The mesh lease refresh of\n72|// after-restore step 2 is a caller-reported fact (Verified), not a\n73|// network call. Signature verification is caller-supplied through\n74|// terminalbackend.SignatureVerifier.\n75|package axpane","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
