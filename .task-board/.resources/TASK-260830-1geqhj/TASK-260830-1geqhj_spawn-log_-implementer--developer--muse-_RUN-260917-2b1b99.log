{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6f5","stream":{"kind":"session","id":"01a0b0ab-f92f-74d3-a245-61ad42401b4b"},"sequence":469,"recorded_at":1780531400000933,"record_type":"event","durability":"durable","causation_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","run_stream":{"kind":"run","id":"8ab0c8df-167f-48db-b83c-f756aeede0a9"},"task_stream":{"kind":"task","id":"01a0b0ad-d404-77a2-bc36-5a716ffb1429"},"task_id":"01a0b0ad-d404-77a2-bc36-5a716ffb1429","event":{"kind":"output","task_id":"01a0b0ad-d404-77a2-bc36-5a716ffb1429","chunk":"Read text file `internal/axpane/decide.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|\t\"time\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/matjournal\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/resumesmoke\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessprofile\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n16|)\n17|\n18|// Action is exactly one wrapper outcome. Decide returns one and only\n19|// one; there is no combined or fallback outcome.\n20|type Action string\n21|\n22|const (\n23|\t// ActionLaunch starts the provider under the winning lease with\n24|\t// the validated descriptor and fencing token.\n25|\tActionLaunch Action = \"launch\"\n26|\t// ActionReattach reattaches to the one recorded wrapper/child\n27|\t// after a lost result: the bootstrap pair matches the durable\n28|\t// binding and every gate passes again.\n29|\tActionReattach Action = \"reattach\"\n30|\t// ActionAttachRemote offers remote attach: another host owns the\n31|\t// session in an interactive terminal and the attach capability\n32|\t// is admitted. It authorizes no lease mutation.\n33|\tActionAttachRemote Action = \"attach_remote\"\n34|\t// ActionTakeoverOffer offers takeover: another host owns the\n35|\t// session but remote attach is not available (non-interactive\n36|\t// or attach capability unproven). It starts no runtime.\n37|\tActionTakeoverOffer Action = \"takeover_offer\"\n38|\t// ActionParked parks without launching the provider, carrying\n39|\t// the Section 5.2 session.parked reason vocabulary.\n40|\tActionParked Action = \"parked\"\n41|\t// ActionRefused refuses: a static validation failed and there is\n42|\t// no parked direction that a state change could resolve.\n43|\tActionRefused Action = \"refused\"\n44|)\n45|\n46|// Refusal classes are the Section 15 codes the wrapper surfaces.\n47|// Landed-gate codes pass through verbatim; the wrapper mints no code.\n48|const (\n49|\t// ClassInvalidConfig reports a configuration that fails\n50|\t// validation (config.Load through ValidateConfig).\n51|\tClassInvalidConfig = \"invalid_config\"\n52|\t// ClassInvalidArguments reports a malformed wrapper call: an\n53|\t// unknown SESSION_ID, an unknown caller kind or mode, or a\n54|\t// malformed presented fencing token.\n55|\tClassInvalidArguments = \"invalid_arguments\"\n56|\t// ClassIntegrityFailure reports profile derivation input the\n57|\t// reducer refuses: the chain cannot be trusted.\n58|\tClassIntegrityFailure = \"integrity_failure\"\n59|\t// ClassProfileMappingUnavailable is the Section 2.4 resume\n60|\t// failure: the adapter cannot map the stored profile for the\n61|\t// probed provider version.\n62|\tClassProfileMappingUnavailable = \"profile_mapping_unavailable\"\n63|)\n64|\n65|// Mode selects the wrapper path: a fresh activation (the Section 4.C\n66|// create row) or the after-restore first start (the restore row). It\n67|// selects both the fencing entry and the backend capability the\n68|// admitted set must confer.\n69|type Mode string\n70|\n71|const (\n72|\t// ModeLaunch gates through fencing AuthorizeActivation and the\n73|\t// create capability dependencies.\n74|\tModeLaunch Mode = \"launch\"\n75|\t// ModeRestore gates through fencing AuthorizeRestore and the\n76|\t// restore capability dependencies.\n77|\tModeRestore Mode = \"restore\"\n78|)\n79|\n80|// Caller kinds are the closed §4.2 realm vocabulary.\n81|const (\n82|\t// CallerForeground is an interactive operator-side caller.\n83|\tCallerForeground = \"foreground\"\n84|\t// CallerBackground is a background CLI, SSH RPC process, daemon,\n85|\t// or restore worker: it must never create a\n86|\t// credential-dependent tmux server.\n87|\tCallerBackground = \"background\"\n88|)\n89|\n90|// Realm carries the §4.2 caller realm and broker readiness the\n91|// background-caller arm decides over. There is deliberately no member\n92|// for a cached sentinel result or a managername observation: neither\n93|// authorizes resume, so neither is an input.\n94|type Realm struct {\n95|\t// Caller is CallerForeground or CallerBackground.\n96|\tCaller string\n97|\t// AttestedServer reports an already-running authenticated Aqua\n98|\t// broker with its attested AX tmux server.\n99|\tAttestedServer bool\n100|\t// BrokerState, ServerGeneration, and Remediation are the typed\n101|\t// realm/readiness details the capability_unavailable refusal\n102|\t// carries. They are required: an empty member refuses\n103|\t// invalid_arguments instead of emitting an untyped refusal.\n104|\tBrokerState      string\n105|\tServerGeneration string\n106|\tRemediation      string\n107|}\n108|\n109|// ProviderFacts carries the probed provider build, the stored\n110|// identity, and the optional discovery proof the provider-identity\n111|// arm decides over.\n112|type ProviderFacts struct {\n113|\t// Build is the exact probed build tuple.\n114|\tBuild provhost.BuildTuple\n115|\t// Identity is the stored Provider Identity Record document.\n116|\tIdentity []byte\n117|\t// Discovery is the NativeDiscoveryProof document, meaningful\n118|\t// only when HasDiscovery is set.\n119|\tDiscovery    []byte\n120|\tHasDiscovery bool\n121|\t// DiscoveryContext binds the proof to host-side facts.\n122|\tDiscoveryContext provhost.DiscoveryContext\n123|}\n124|\n125|// SmokeFacts carries the provider-auth smoke precondition: the\n126|// stored smoke record plus the typed target-auth details the\n127|// target_auth_missing refusal carries when the smoke is required\n128|// and fails.\n129|type SmokeFacts struct {\n130|\t// Required reports that provider credentials are required, so\n131|\t// the smoke must pass (the §4.C create/restore rows).\n132|\tRequired bool\n133|\t// Record is the stored smoke record document.\n134|\tRecord []byte\n135|\t// Target carries the typed provider/build/version/generation\n136|\t// details. Every member is required when the smoke is\n137|\t// required: an empty member refuses invalid_arguments instead\n138|\t// of emitting an untyped refusal.\n139|\tTarget axerror.TargetAuth\n140|\t// MacOSVersion is recorded here because TargetAuth carries it;\n141|\t// it is the version the smoke evidence binds, not a fresh\n142|\t// observation.\n143|}\n144|\n145|// BackendFacts carries the backend identity documents the §4.B arm\n146|// decides over.\n147|type BackendFacts struct {\n148|\t// Manifest, Probe, and Evidence are the raw documents parsed by\n149|\t// the terminalbackend owner.\n150|\tManifest []byte\n151|\tProbe    []byte\n152|\tEvidence [][]byte\n153|\t// RawGeneration is the AX-known raw generation the admission\n154|\t// binds to; Verify checks evidence signatures.\n155|\tRawGeneration string\n156|\tVerify        terminalbackend.SignatureVerifier\n157|\t// Now is the admission instant for evidence liveness.\n158|\tNow time.Time\n159|}\n160|\n161|// Input is the complete Decide surface: validated configuration,\n162|// the loaded session, the local lease view, materialization and\n163|// checkpoint state, the profile chain, provider identity, backend\n164|// identity, realm readiness, and the bootstrap binding. I/O-free\n165|// callers build it by hand; Run builds it through the gates.go\n166|// adapters over the durable stores.\n167|type Input struct {\n168|\t// SessionID is the logical session under decision.\n169|\tSessionID string\n170|\t// BootstrapOperationID is the caller-stable bootstrap operation.\n171|\tBootstrapOperationID string\n172|\t// Mode selects the fencing entry and capability row.\n173|\tMode Mode\n174|\n175|\t// ConfigErr is the ValidateConfig outcome; non-nil refuses\n176|\t// invalid_config.\n177|\tConfigErr error\n178|\t// SessionKnown reports that the logical session loaded; false\n179|\t// refuses invalid_arguments.\n180|\tSessionKnown bool\n181|\n182|\t// ExistingBinding is the proven bootstrap binding, or nil when\n183|\t// Status proved absence. A changed operation refuses\n184|\t// idempotency_mismatch; a matching pair reattaches.\n185|\tExistingBinding *Binding\n186|\n187|\t// Presented is the local fencing token; Observation is the\n188|\t// verified lease view, built by fencing.Observe.\n189|\tPresented   fencing.PresentedToken\n190|\tObservation fencing.Observation\n191|\n192|\t// Backend carries the §4.B identity documents.\n193|\tBackend BackendFacts\n194|\n195|\t// Journal is the loaded materialization journal; JournalOK\n196|\t// reports that the matjournal owner admitted it. When\n197|\t// MaterializationRequired is set (the after-restore step 3),\n198|\t// a local launch additionally requires the committed phase.\n199|\t// A fresh launch (§13.1 steps 3-4) runs before the journal\n200|\t// commits and leaves the requirement unset.\n201|\tMaterializationRequired bool\n202|\tJournal                 matjournal.Journal\n203|\tJournalOK               bool\n204|\n205|\t// Checkpoint carries the resume checkpoint: Required when the\n206|\t// path resumes from a checkpoint, Doc with its bytes, ID with\n207|\t// the expected digest. Admission runs through the sessrepo\n208|\t// attestation owner.\n209|\tCheckpointRequired bool\n210|\tCheckpointDoc      []byte\n211|\tCheckpointID       string\n212|\n213|\t// ProfileRecord and ProfileEvents are the decoded session\n214|\t// surface the sessprofile reducer derives the effective pair\n215|\t// from.\n216|\tProfileRecord sessprofile.Record\n217|\tProfileEvents []sessprofile.Event\n218|\n219|\t// Provider carries the probed build, stored identity, and\n220|\t// optional discovery proof.\n221|\tProvider ProviderFacts\n222|\n223|\t// Smoke carries the provider-auth smoke precondition.\n224|\tSmoke SmokeFacts\n225|\n226|\t// Realm carries the caller realm and broker readiness.\n227|\tRealm Realm\n228|\n229|\t// Entrypoint is the wrapper argv, checked against the §4.A\n230|\t// stable entrypoint rule.\n231|\tEntrypoint []string\n232|\n233|\t// Descriptor is the §7.A provider descriptor document the\n234|\t// wrapper supplies; HostBinding is the AX-validated host-local\n235|\t// binding it must match. Admission runs on the launch and\n236|\t// reattach paths only: parked, refused, and remote-offer\n237|\t// outcomes start no local provider.\n238|\tDescriptor  []byte\n239|\tHostBinding terminalbackend.InstanceBinding\n240|\n241|\t// RemoteInteractive reports that the remote owner holds the\n242|\t// session in an interactive terminal (after-restore step 4).\n243|\tRemoteInteractive bool\n244|}\n245|\n246|// Decision is the one outcome Decide returns.\n247|type Decision struct {\n248|\t// Action is the outcome.\n249|\tAction Action\n250|\t// ParkReason and WinningLeaseID carry the session.parked\n251|\t// vocabulary when Action is parked. The lease ID is empty when\n252|\t// no winner is established.\n253|\tParkReason     fencing.ParkReason\n254|\tWinningLeaseID string\n255|\t// Class is the Section 15 refusal code when Action is refused.\n256|\tClass string\n257|\t// Detail is the static refusal or park detail. It carries\n258|\t// member names and the landed cause, never credentials,\n259|\t// generations, or native references.\n260|\tDetail string\n261|\t// Cause is the underlying landed error.\n262|\tCause error\n263|\t// Token is the sealed fencing token the passed gate minted,\n264|\t// set on launch and reattach only. The provider receives it\n265|\t// separately from the descriptor (§7.A).\n266|\tToken fencing.LeaseToken\n267|\t// HasToken reports that Token is minted. The zero token never\n268|\t// authorizes: decisions without a passed gate carry none.\n269|\tHasToken bool\n270|\t// Profile is the effective persisted pair the launch carries.\n271|\tProfile sessprofile.Pair\n272|\t// Mapping is the resolved provider adapter flag (empty for\n273|\t// standard).\n274|\tMapping string\n275|\t// Admitted is the reconciled backend capability set.\n276|\tAdmitted terminalbackend.Admitted\n277|\t// Descriptor is the admitted §7.A provider descriptor, set on\n278|\t// launch and reattach only.\n279|\tDescriptor terminalbackend.ProviderDescriptor\n280|\t// RealmFailure is the composed typed Structured Error for the\n281|\t// capability_unavailable and target_auth_missing refusals.\n282|\tRealmFailure *axerror.Error\n283|}\n284|\n285|func refused(class, detail string, cause error) Decision {\n286|\treturn Decision{Action: ActionRefused, Class: class, Detail: detail, Cause: cause}\n287|}\n288|\n289|func parked(reason fencing.ParkReason, winningLeaseID string, cause error) Decision {\n290|\treturn Decision{\n291|\t\tAction:         ActionParked,\n292|\t\tParkReason:     reason,\n293|\t\tWinningLeaseID: winningLeaseID,\n294|\t\tDetail:         \"park (\" + string(reason) + \") without launching the provider\",\n295|\t\tCause:          cause,\n296|\t}\n297|}\n298|\n299|// Decide is the pure wrapper core: configuration, session, bootstrap\n300|// idempotency, backend identity and capability admission, fencing,\n301|// materialization, checkpoint, provider identity, provider-auth\n302|// smoke, realm readiness, profile derivation and mapping,\n303|// entrypoint, and provider descriptor, in that precedence, then the\n304|// outcome selection. The tuple gate precedes mapping so a tuple\n305|// refusal keeps its own class instead of wearing\n306|// profile_mapping_unavailable. Decide performs no I/O, reads no\n307|// clock except the instants the input carries, and mints no lease,\n308|// binding, or event: Run owns the durable effects. Every refusal\n309|// carries the Section 15 code the arm names; every park carries the\n310|// session.parked vocabulary.\n311|func Decide(input Input) Decision {\n312|\tif input.ConfigErr != nil {\n313|\t\treturn refused(ClassInvalidConfig, \"configuration is invalid\", input.ConfigErr)\n314|\t}\n315|\tif input.Mode != ModeLaunch && input.Mode != ModeRestore {\n316|\t\treturn refused(ClassInvalidArguments, \"wrapper mode is not launch or restore\", errWrapperMode(input.Mode))\n317|\t}\n318|\tif !input.SessionKnown {\n319|\t\treturn refused(ClassInvalidArguments, \"logical session is unknown\", errUnknownSession(input.SessionID))\n320|\t}\n321|\tif input.ExistingBinding != nil && input.ExistingBinding.OperationID != input.BootstrapOperationID {\n322|\t\treturn refused(terminalbackend.CodeIdempotencyMismatch,\n323|\t\t\t\"bootstrap operation changed inside the bootstrap window\",\n324|\t\t\terrIdempotencyChanged(input.SessionID))\n325|\t}\n326|\tif err := checkRealmVocabulary(input.Realm.Caller); err != nil {\n327|\t\treturn refused(ClassInvalidArguments, \"caller realm is not foreground or background\", err)\n328|\t}\n329|\n330|\tadmitted, err := admitBackend(input)\n331|\tif err != nil {\n332|\t\treturn refused(backendClass(err), \"terminal backend identity or capability admission failed\", err)\n333|\t}\n334|\n335|\ttoken, err := authorize(input)\n336|\tif err != nil {\n337|\t\tif fencing.IsParked(err) {\n338|\t\t\treason, winning, _ := fencing.ParkDetails(err)\n339|\t\t\treturn decideParked(input, admitted, reason, winning, err)\n340|\t\t}\n341|\t\treturn refused(fencingClass(err), \"fencing refused the wrapper\", err)\n342|\t}\n343|\n344|\tif input.MaterializationRequired && (!input.JournalOK || input.Journal.Phase != matjournal.PhaseCommitted) {\n345|\t\treturn parked(fencing.ParkRestorePolicy, input.Observation.Winner.LeaseID,\n346|\t\t\terrMaterializationNotValid(input.Journal.Phase, input.JournalOK))\n347|\t}\n348|\tif input.CheckpointRequired {\n349|\t\tif err := admitCheckpoint(input.CheckpointDoc, input.CheckpointID); err != nil {\n350|\t\t\treturn parked(fencing.ParkRestorePolicy, input.Observation.Winner.LeaseID, err)\n351|\t\t}\n352|\t}\n353|\n354|\tif err := checkProviderIdentity(input.Provider); err != nil {\n355|\t\treturn refused(providerClass(err), \"provider identity is unresolved\", err)\n356|\t}\n357|\tif err := checkSmoke(input); err != nil {\n358|\t\tdecision := refused(smokeClass(err), \"provider-auth smoke precondition failed\", err)\n359|\t\tvar typed *axerror.Error\n360|\t\tif errors.As(err, &typed) {\n361|\t\t\tdecision.RealmFailure = typed\n362|\t\t}\n363|\t\treturn decision\n364|\t}\n365|\tif err := checkRealm(input); err != nil {\n366|\t\tvar malformed errInvalidArguments\n367|\t\tif errors.As(err, &malformed) {\n368|\t\t\treturn refused(ClassInvalidArguments, \"background caller realm details are incomplete\", err)\n369|\t\t}\n370|\t\tvar typed *axerror.Error\n371|\t\tif errors.As(err, &typed) {\n372|\t\t\tdecision := refused(string(typed.Code()), \"background caller has no attested server\", err)\n373|\t\t\tdecision.RealmFailure = typed\n374|\t\t\treturn decision\n375|\t\t}\n376|\t\treturn refused(ClassInvalidArguments, \"background caller realm is unverifiable\", err)\n377|\t}\n378|\tpair, err := sessprofile.Derive(input.ProfileRecord, input.ProfileEvents)\n379|\tif err != nil {\n380|\t\treturn refused(ClassIntegrityFailure, \"effective profile derivation failed\", err)\n381|\t}\n382|\t// The tuple gate above already admitted the probed build, so a\n383|\t// ResolveMapping failure here is the mapping gap Section 2.4\n384|\t// names, never a tuple refusal wearing the mapping class.\n385|\tresolved, err := provhost.ResolveMapping(input.Provider.Build.ProviderID, pair.Profile, input.Provider.Build)\n386|\tif err != nil {\n387|\t\treturn refused(ClassProfileMappingUnavailable, \"adapter cannot map the stored profile\", err)\n388|\t}\n389|\tif err := terminalbackend.CheckEntrypoint(input.Entrypoint, input.SessionID); err != nil {\n390|\t\treturn refused(backendClass(err), \"stable entrypoint is not ax pane SESSION_ID\", err)\n391|\t}\n392|\n393|\tdecision := Decision{\n394|\t\tAction:   ActionLaunch,\n395|\t\tToken:    token,\n396|\t\tHasToken: true,\n397|\t\tProfile:  pair,\n398|\t\tMapping:  resolved.Mapping,\n399|\t\tAdmitted: admitted,\n400|\t\tDetail:   \"launch under the winning lease\",\n401|\t}\n402|\tif input.ExistingBinding != nil {\n403|\t\tdecision.Action = ActionReattach\n404|\t\tdecision.Detail = \"reattach to the one recorded wrapper/child\"\n405|\t}\n406|\tdescriptor, err := terminalbackend.AdmitProviderDescriptor(input.Descriptor, input.HostBinding)\n407|\tif err != nil {\n408|\t\treturn refused(backendClass(err), \"provider descriptor does not match the validated binding\", err)\n409|\t}\n410|\tdecision.Descriptor = descriptor\n411|\treturn decision\n412|}\n413|\n414|// decideParked resolves a fencing park into the parked outcome or,\n415|// for a remote owner, the attach/takeover offer. Attach requires the\n416|// remote interactive terminal of after-restore step 4 with an\n417|// admitted attach capability; any other remote park offers takeover\n418|// instead of starting a runtime. Non-remote parks carry the fencing\n419|// reason unchanged.\n420|func decideParked(input Input, admitted terminalbackend.Admitted, reason fencing.ParkReason, winning string, cause error) Decision {\n421|\tif reason != fencing.ParkRemoteOwner {\n422|\t\treturn parked(reason, winning, cause)\n423|\t}\n424|\tif input.RemoteInteractive && terminalbackend.CheckOperation(\"attach\", admitted) == nil {\n425|\t\treturn Decision{\n426|\t\t\tAction:         ActionAttachRemote,\n427|\t\t\tParkReason:     reason,\n428|\t\t\tWinningLeaseID: winning,\n429|\t\t\tAdmitted:       admitted,\n430|\t\t\tDetail:         \"offer remote attach; no lease mutation\",\n431|\t\t\tCause:          cause,\n432|\t\t}\n433|\t}\n434|\treturn Decision{\n435|\t\tAction:         ActionTakeoverOffer,\n436|\t\tParkReason:     reason,\n437|\t\tWinningLeaseID: winning,\n438|\t\tAdmitted:       admitted,\n439|\t\tDetail:         \"offer takeover; no runtime started\",\n440|\t\tCause:          cause,\n441|\t}\n442|}\n443|\n444|// authorize selects the fencing entry by mode: activation for a\n445|// fresh launch, restore for the after-restore first start. Both are\n446|// launch-class entries: ownership that is remote, ambiguous,\n447|// unverified, or absent parks with the session.parked vocabulary,\n448|// while malformed calls, foreign sessions, and lapsed grants refuse.\n449|func authorize(input Input) (fencing.LeaseToken, error) {\n450|\tif input.Mode == ModeRestore {\n451|\t\treturn fencing.AuthorizeRestore(input.Presented, input.Observation)\n452|\t}\n453|\treturn fencing.AuthorizeActivation(input.Presented, input.Observation)\n454|}\n455|\n456|// admitBackend parses the §4.B identity documents through the\n457|// terminalbackend owner, reconciles the Probe against the Manifest\n458|// with the returned evidence bound to the AX-known raw generation,\n459|// and gates the mode operation against the admitted set. Only the\n460|// exact admitted capability rows authorize the action; no\n461|// capability map is invented here.\n462|func admitBackend(input Input) (terminalbackend.Admitted, error) {\n463|\tmanifest, err := terminalbackend.ParseManifest(input.Backend.Manifest)\n464|\tif err != nil {\n465|\t\treturn terminalbackend.Admitted{}, err\n466|\t}\n467|\tprobe, err := terminalbackend.ParseProbe(input.Backend.Probe)\n468|\tif err != nil {\n469|\t\treturn terminalbackend.Admitted{}, err\n470|\t}\n471|\tevidence := make([]terminalbackend.Evidence, 0, len(input.Backend.Evidence))\n472|\tfor _, doc := range input.Backend.Evidence {\n473|\t\tparsed, err := terminalbackend.ParseEvidence(doc)\n474|\t\tif err != nil {\n475|\t\t\treturn terminalbackend.Admitted{}, err\n476|\t\t}\n477|\t\tevidence = append(evidence, parsed)\n478|\t}\n479|\tadmitted, err := terminalbackend.Reconcile(manifest, probe, evidence, input.Backend.RawGeneration, input.Backend.Now, input.Backend.Verify)\n480|\tif err != nil {\n481|\t\treturn terminalbackend.Admitted{}, err\n482|\t}\n483|\toperation := \"create\"\n484|\tif input.Mode == ModeRestore {\n485|\t\toperation = \"restore\"\n486|\t}\n487|\tif err := terminalbackend.CheckOperation(operation, admitted); err != nil {\n488|\t\treturn terminalbackend.Admitted{}, err\n489|\t}\n490|\treturn admitted, nil\n491|}\n492|\n493|// admitCheckpoint admits the resume checkpoint through the sessrepo\n494|// attestation owner: the closed shape must verify and the computed\n495|// identity must equal the expected checkpoint digest.\n496|func admitCheckpoint(doc []byte, want string) error {\n497|\tif len(doc) == 0 {\n498|\t\treturn errCheckpointAbsent()\n499|\t}\n500|\tdigest, _, err := sessrepo.AttestCheckpointRecord(doc)\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6f7","stream":{"kind":"session","id":"01a0b0ab-f92f-74d3-a245-61ad42401b4b"},"sequence":470,"recorded_at":1780531400000935,"record_type":"event","durability":"durable","causation_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","run_stream":{"kind":"run","id":"8ab0c8df-167f-48db-b83c-f756aeede0a9"},"task_stream":{"kind":"task","id":"01a0b0ad-d404-77a2-bc36-5a716ffb1429"},"task_id":"01a0b0ad-d404-77a2-bc36-5a716ffb1429","event":{"kind":"completed","task_id":"01a0b0ad-d404-77a2-bc36-5a716ffb1429"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6f9","stream":{"kind":"session","id":"01a0b0ab-f92f-74d3-a245-61ad42401b4b"},"sequence":471,"recorded_at":1780531400000937,"record_type":"event","durability":"durable","causation_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","run_stream":{"kind":"run","id":"8ab0c8df-167f-48db-b83c-f756aeede0a9"},"call_id":"call_01a0b0add1a3753499f680d7f228b4a6","text":"Read text file `internal/axpane/decide.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|\t\"time\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/matjournal\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/resumesmoke\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessprofile\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n16|)\n17|\n18|// Action is exactly one wrapper outcome. Decide returns one and only\n19|// one; there is no combined or fallback outcome.\n20|type Action string\n21|\n22|const (\n23|\t// ActionLaunch starts the provider under the winning lease with\n24|\t// the validated descriptor and fencing token.\n25|\tActionLaunch Action = \"launch\"\n26|\t// ActionReattach reattaches to the one recorded wrapper/child\n27|\t// after a lost result: the bootstrap pair matches the durable\n28|\t// binding and every gate passes again.\n29|\tActionReattach Action = \"reattach\"\n30|\t// ActionAttachRemote offers remote attach: another host owns the\n31|\t// session in an interactive terminal and the attach capability\n32|\t// is admitted. It authorizes no lease mutation.\n33|\tActionAttachRemote Action = \"attach_remote\"\n34|\t// ActionTakeoverOffer offers takeover: another host owns the\n35|\t// session but remote attach is not available (non-interactive\n36|\t// or attach capability unproven). It starts no runtime.\n37|\tActionTakeoverOffer Action = \"takeover_offer\"\n38|\t// ActionParked parks without launching the provider, carrying\n39|\t// the Section 5.2 session.parked reason vocabulary.\n40|\tActionParked Action = \"parked\"\n41|\t// ActionRefused refuses: a static validation failed and there is\n42|\t// no parked direction that a state change could resolve.\n43|\tActionRefused Action = \"refused\"\n44|)\n45|\n46|// Refusal classes are the Section 15 codes the wrapper surfaces.\n47|// Landed-gate codes pass through verbatim; the wrapper mints no code.\n48|const (\n49|\t// ClassInvalidConfig reports a configuration that fails\n50|\t// validation (config.Load through ValidateConfig).\n51|\tClassInvalidConfig = \"invalid_config\"\n52|\t// ClassInvalidArguments reports a malformed wrapper call: an\n53|\t// unknown SESSION_ID, an unknown caller kind or mode, or a\n54|\t// malformed presented fencing token.\n55|\tClassInvalidArguments = \"invalid_arguments\"\n56|\t// ClassIntegrityFailure reports profile derivation input the\n57|\t// reducer refuses: the chain cannot be trusted.\n58|\tClassIntegrityFailure = \"integrity_failure\"\n59|\t// ClassProfileMappingUnavailable is the Section 2.4 resume\n60|\t// failure: the adapter cannot map the stored profile for the\n61|\t// probed provider version.\n62|\tClassProfileMappingUnavailable = \"profile_mapping_unavailable\"\n63|)\n64|\n65|// Mode selects the wrapper path: a fresh activation (the Section 4.C\n66|// create row) or the after-restore first start (the restore row). It\n67|// selects both the fencing entry and the backend capability the\n68|// admitted set must confer.\n69|type Mode string\n70|\n71|const (\n72|\t// ModeLaunch gates through fencing AuthorizeActivation and the\n73|\t// create capability dependencies.\n74|\tModeLaunch Mode = \"launch\"\n75|\t// ModeRestore gates through fencing AuthorizeRestore and the\n76|\t// restore capability dependencies.\n77|\tModeRestore Mode = \"restore\"\n78|)\n79|\n80|// Caller kinds are the closed §4.2 realm vocabulary.\n81|const (\n82|\t// CallerForeground is an interactive operator-side caller.\n83|\tCallerForeground = \"foreground\"\n84|\t// CallerBackground is a background CLI, SSH RPC process, daemon,\n85|\t// or restore worker: it must never create a\n86|\t// credential-dependent tmux server.\n87|\tCallerBackground = \"background\"\n88|)\n89|\n90|// Realm carries the §4.2 caller realm and broker readiness the\n91|// background-caller arm decides over. There is deliberately no member\n92|// for a cached sentinel result or a managername observation: neither\n93|// authorizes resume, so neither is an input.\n94|type Realm struct {\n95|\t// Caller is CallerForeground or CallerBackground.\n96|\tCaller string\n97|\t// AttestedServer reports an already-running authenticated Aqua\n98|\t// broker with its attested AX tmux server.\n99|\tAttestedServer bool\n100|\t// BrokerState, ServerGeneration, and Remediation are the typed\n101|\t// realm/readiness details the capability_unavailable refusal\n102|\t// carries. They are required: an empty member refuses\n103|\t// invalid_arguments instead of emitting an untyped refusal.\n104|\tBrokerState      string\n105|\tServerGeneration string\n106|\tRemediation      string\n107|}\n108|\n109|// ProviderFacts carries the probed provider build, the stored\n110|// identity, and the optional discovery proof the provider-identity\n111|// arm decides over.\n112|type ProviderFacts struct {\n113|\t// Build is the exact probed build tuple.\n114|\tBuild provhost.BuildTuple\n115|\t// Identity is the stored Provider Identity Record document.\n116|\tIdentity []byte\n117|\t// Discovery is the NativeDiscoveryProof document, meaningful\n118|\t// only when HasDiscovery is set.\n119|\tDiscovery    []byte\n120|\tHasDiscovery bool\n121|\t// DiscoveryContext binds the proof to host-side facts.\n122|\tDiscoveryContext provhost.DiscoveryContext\n123|}\n124|\n125|// SmokeFacts carries the provider-auth smoke precondition: the\n126|// stored smoke record plus the typed target-auth details the\n127|// target_auth_missing refusal carries when the smoke is required\n128|// and fails.\n129|type SmokeFacts struct {\n130|\t// Required reports that provider credentials are required, so\n131|\t// the smoke must pass (the §4.C create/restore rows).\n132|\tRequired bool\n133|\t// Record is the stored smoke record document.\n134|\tRecord []byte\n135|\t// Target carries the typed provider/build/version/generation\n136|\t// details. Every member is required when the smoke is\n137|\t// required: an empty member refuses invalid_arguments instead\n138|\t// of emitting an untyped refusal.\n139|\tTarget axerror.TargetAuth\n140|\t// MacOSVersion is recorded here because TargetAuth carries it;\n141|\t// it is the version the smoke evidence binds, not a fresh\n142|\t// observation.\n143|}\n144|\n145|// BackendFacts carries the backend identity documents the §4.B arm\n146|// decides over.\n147|type BackendFacts struct {\n148|\t// Manifest, Probe, and Evidence are the raw documents parsed by\n149|\t// the terminalbackend owner.\n150|\tManifest []byte\n151|\tProbe    []byte\n152|\tEvidence [][]byte\n153|\t// RawGeneration is the AX-known raw generation the admission\n154|\t// binds to; Verify checks evidence signatures.\n155|\tRawGeneration string\n156|\tVerify        terminalbackend.SignatureVerifier\n157|\t// Now is the admission instant for evidence liveness.\n158|\tNow time.Time\n159|}\n160|\n161|// Input is the complete Decide surface: validated configuration,\n162|// the loaded session, the local lease view, materialization and\n163|// checkpoint state, the profile chain, provider identity, backend\n164|// identity, realm readiness, and the bootstrap binding. I/O-free\n165|// callers build it by hand; Run builds it through the gates.go\n166|// adapters over the durable stores.\n167|type Input struct {\n168|\t// SessionID is the logical session under decision.\n169|\tSessionID string\n170|\t// BootstrapOperationID is the caller-stable bootstrap operation.\n171|\tBootstrapOperationID string\n172|\t// Mode selects the fencing entry and capability row.\n173|\tMode Mode\n174|\n175|\t// ConfigErr is the ValidateConfig outcome; non-nil refuses\n176|\t// invalid_config.\n177|\tConfigErr error\n178|\t// SessionKnown reports that the logical session loaded; false\n179|\t// refuses invalid_arguments.\n180|\tSessionKnown bool\n181|\n182|\t// ExistingBinding is the proven bootstrap binding, or nil when\n183|\t// Status proved absence. A changed operation refuses\n184|\t// idempotency_mismatch; a matching pair reattaches.\n185|\tExistingBinding *Binding\n186|\n187|\t// Presented is the local fencing token; Observation is the\n188|\t// verified lease view, built by fencing.Observe.\n189|\tPresented   fencing.PresentedToken\n190|\tObservation fencing.Observation\n191|\n192|\t// Backend carries the §4.B identity documents.\n193|\tBackend BackendFacts\n194|\n195|\t// Journal is the loaded materialization journal; JournalOK\n196|\t// reports that the matjournal owner admitted it. When\n197|\t// MaterializationRequired is set (the after-restore step 3),\n198|\t// a local launch additionally requires the committed phase.\n199|\t// A fresh launch (§13.1 steps 3-4) runs before the journal\n200|\t// commits and leaves the requirement unset.\n201|\tMaterializationRequired bool\n202|\tJournal                 matjournal.Journal\n203|\tJournalOK               bool\n204|\n205|\t// Checkpoint carries the resume checkpoint: Required when the\n206|\t// path resumes from a checkpoint, Doc with its bytes, ID with\n207|\t// the expected digest. Admission runs through the sessrepo\n208|\t// attestation owner.\n209|\tCheckpointRequired bool\n210|\tCheckpointDoc      []byte\n211|\tCheckpointID       string\n212|\n213|\t// ProfileRecord and ProfileEvents are the decoded session\n214|\t// surface the sessprofile reducer derives the effective pair\n215|\t// from.\n216|\tProfileRecord sessprofile.Record\n217|\tProfileEvents []sessprofile.Event\n218|\n219|\t// Provider carries the probed build, stored identity, and\n220|\t// optional discovery proof.\n221|\tProvider ProviderFacts\n222|\n223|\t// Smoke carries the provider-auth smoke precondition.\n224|\tSmoke SmokeFacts\n225|\n226|\t// Realm carries the caller realm and broker readiness.\n227|\tRealm Realm\n228|\n229|\t// Entrypoint is the wrapper argv, checked against the §4.A\n230|\t// stable entrypoint rule.\n231|\tEntrypoint []string\n232|\n233|\t// Descriptor is the §7.A provider descriptor document the\n234|\t// wrapper supplies; HostBinding is the AX-validated host-local\n235|\t// binding it must match. Admission runs on the launch and\n236|\t// reattach paths only: parked, refused, and remote-offer\n237|\t// outcomes start no local provider.\n238|\tDescriptor  []byte\n239|\tHostBinding terminalbackend.InstanceBinding\n240|\n241|\t// RemoteInteractive reports that the remote owner holds the\n242|\t// session in an interactive terminal (after-restore step 4).\n243|\tRemoteInteractive bool\n244|}\n245|\n246|// Decision is the one outcome Decide returns.\n247|type Decision struct {\n248|\t// Action is the outcome.\n249|\tAction Action\n250|\t// ParkReason and WinningLeaseID carry the session.parked\n251|\t// vocabulary when Action is parked. The lease ID is empty when\n252|\t// no winner is established.\n253|\tParkReason     fencing.ParkReason\n254|\tWinningLeaseID string\n255|\t// Class is the Section 15 refusal code when Action is refused.\n256|\tClass string\n257|\t// Detail is the static refusal or park detail. It carries\n258|\t// member names and the landed cause, never credentials,\n259|\t// generations, or native references.\n260|\tDetail string\n261|\t// Cause is the underlying landed error.\n262|\tCause error\n263|\t// Token is the sealed fencing token the passed gate minted,\n264|\t// set on launch and reattach only. The provider receives it\n265|\t// separately from the descriptor (§7.A).\n266|\tToken fencing.LeaseToken\n267|\t// HasToken reports that Token is minted. The zero token never\n268|\t// authorizes: decisions without a passed gate carry none.\n269|\tHasToken bool\n270|\t// Profile is the effective persisted pair the launch carries.\n271|\tProfile sessprofile.Pair\n272|\t// Mapping is the resolved provider adapter flag (empty for\n273|\t// standard).\n274|\tMapping string\n275|\t// Admitted is the reconciled backend capability set.\n276|\tAdmitted terminalbackend.Admitted\n277|\t// Descriptor is the admitted §7.A provider descriptor, set on\n278|\t// launch and reattach only.\n279|\tDescriptor terminalbackend.ProviderDescriptor\n280|\t// RealmFailure is the composed typed Structured Error for the\n281|\t// capability_unavailable and target_auth_missing refusals.\n282|\tRealmFailure *axerror.Error\n283|}\n284|\n285|func refused(class, detail string, cause error) Decision {\n286|\treturn Decision{Action: ActionRefused, Class: class, Detail: detail, Cause: cause}\n287|}\n288|\n289|func parked(reason fencing.ParkReason, winningLeaseID string, cause error) Decision {\n290|\treturn Decision{\n291|\t\tAction:         ActionParked,\n292|\t\tParkReason:     reason,\n293|\t\tWinningLeaseID: winningLeaseID,\n294|\t\tDetail:         \"park (\" + string(reason) + \") without launching the provider\",\n295|\t\tCause:          cause,\n296|\t}\n297|}\n298|\n299|// Decide is the pure wrapper core: configuration, session, bootstrap\n300|// idempotency, backend identity and capability admission, fencing,\n301|// materialization, checkpoint, provider identity, provider-auth\n302|// smoke, realm readiness, profile derivation and mapping,\n303|// entrypoint, and provider descriptor, in that precedence, then the\n304|// outcome selection. The tuple gate precedes mapping so a tuple\n305|// refusal keeps its own class instead of wearing\n306|// profile_mapping_unavailable. Decide performs no I/O, reads no\n307|// clock except the instants the input carries, and mints no lease,\n308|// binding, or event: Run owns the durable effects. Every refusal\n309|// carries the Section 15 code the arm names; every park carries the\n310|// session.parked vocabulary.\n311|func Decide(input Input) Decision {\n312|\tif input.ConfigErr != nil {\n313|\t\treturn refused(ClassInvalidConfig, \"configuration is invalid\", input.ConfigErr)\n314|\t}\n315|\tif input.Mode != ModeLaunch && input.Mode != ModeRestore {\n316|\t\treturn refused(ClassInvalidArguments, \"wrapper mode is not launch or restore\", errWrapperMode(input.Mode))\n317|\t}\n318|\tif !input.SessionKnown {\n319|\t\treturn refused(ClassInvalidArguments, \"logical session is unknown\", errUnknownSession(input.SessionID))\n320|\t}\n321|\tif input.ExistingBinding != nil && input.ExistingBinding.OperationID != input.BootstrapOperationID {\n322|\t\treturn refused(terminalbackend.CodeIdempotencyMismatch,\n323|\t\t\t\"bootstrap operation changed inside the bootstrap window\",\n324|\t\t\terrIdempotencyChanged(input.SessionID))\n325|\t}\n326|\tif err := checkRealmVocabulary(input.Realm.Caller); err != nil {\n327|\t\treturn refused(ClassInvalidArguments, \"caller realm is not foreground or background\", err)\n328|\t}\n329|\n330|\tadmitted, err := admitBackend(input)\n331|\tif err != nil {\n332|\t\treturn refused(backendClass(err), \"terminal backend identity or capability admission failed\", err)\n333|\t}\n334|\n335|\ttoken, err := authorize(input)\n336|\tif err != nil {\n337|\t\tif fencing.IsParked(err) {\n338|\t\t\treason, winning, _ := fencing.ParkDetails(err)\n339|\t\t\treturn decideParked(input, admitted, reason, winning, err)\n340|\t\t}\n341|\t\treturn refused(fencingClass(err), \"fencing refused the wrapper\", err)\n342|\t}\n343|\n344|\tif input.MaterializationRequired && (!input.JournalOK || input.Journal.Phase != matjournal.PhaseCommitted) {\n345|\t\treturn parked(fencing.ParkRestorePolicy, input.Observation.Winner.LeaseID,\n346|\t\t\terrMaterializationNotValid(input.Journal.Phase, input.JournalOK))\n347|\t}\n348|\tif input.CheckpointRequired {\n349|\t\tif err := admitCheckpoint(input.CheckpointDoc, input.CheckpointID); err != nil {\n350|\t\t\treturn parked(fencing.ParkRestorePolicy, input.Observation.Winner.LeaseID, err)\n351|\t\t}\n352|\t}\n353|\n354|\tif err := checkProviderIdentity(input.Provider); err != nil {\n355|\t\treturn refused(providerClass(err), \"provider identity is unresolved\", err)\n356|\t}\n357|\tif err := checkSmoke(input); err != nil {\n358|\t\tdecision := refused(smokeClass(err), \"provider-auth smoke precondition failed\", err)\n359|\t\tvar typed *axerror.Error\n360|\t\tif errors.As(err, &typed) {\n361|\t\t\tdecision.RealmFailure = typed\n362|\t\t}\n363|\t\treturn decision\n364|\t}\n365|\tif err := checkRealm(input); err != nil {\n366|\t\tvar malformed errInvalidArguments\n367|\t\tif errors.As(err, &malformed) {\n368|\t\t\treturn refused(ClassInvalidArguments, \"background caller realm details are incomplete\", err)\n369|\t\t}\n370|\t\tvar typed *axerror.Error\n371|\t\tif errors.As(err, &typed) {\n372|\t\t\tdecision := refused(string(typed.Code()), \"background caller has no attested server\", err)\n373|\t\t\tdecision.RealmFailure = typed\n374|\t\t\treturn decision\n375|\t\t}\n376|\t\treturn refused(ClassInvalidArguments, \"background caller realm is unverifiable\", err)\n377|\t}\n378|\tpair, err := sessprofile.Derive(input.ProfileRecord, input.ProfileEvents)\n379|\tif err != nil {\n380|\t\treturn refused(ClassIntegrityFailure, \"effective profile derivation failed\", err)\n381|\t}\n382|\t// The tuple gate above already admitted the probed build, so a\n383|\t// ResolveMapping failure here is the mapping gap Section 2.4\n384|\t// names, never a tuple refusal wearing the mapping class.\n385|\tresolved, err := provhost.ResolveMapping(input.Provider.Build.ProviderID, pair.Profile, input.Provider.Build)\n386|\tif err != nil {\n387|\t\treturn refused(ClassProfileMappingUnavailable, \"adapter cannot map the stored profile\", err)\n388|\t}\n389|\tif err := terminalbackend.CheckEntrypoint(input.Entrypoint, input.SessionID); err != nil {\n390|\t\treturn refused(backendClass(err), \"stable entrypoint is not ax pane SESSION_ID\", err)\n391|\t}\n392|\n393|\tdecision := Decision{\n394|\t\tAction:   ActionLaunch,\n395|\t\tToken:    token,\n396|\t\tHasToken: true,\n397|\t\tProfile:  pair,\n398|\t\tMapping:  resolved.Mapping,\n399|\t\tAdmitted: admitted,\n400|\t\tDetail:   \"launch under the winning lease\",\n401|\t}\n402|\tif input.ExistingBinding != nil {\n403|\t\tdecision.Action = ActionReattach\n404|\t\tdecision.Detail = \"reattach to the one recorded wrapper/child\"\n405|\t}\n406|\tdescriptor, err := terminalbackend.AdmitProviderDescriptor(input.Descriptor, input.HostBinding)\n407|\tif err != nil {\n408|\t\treturn refused(backendClass(err), \"provider descriptor does not match the validated binding\", err)\n409|\t}\n410|\tdecision.Descriptor = descriptor\n411|\treturn decision\n412|}\n413|\n414|// decideParked resolves a fencing park into the parked outcome or,\n415|// for a remote owner, the attach/takeover offer. Attach requires the\n416|// remote interactive terminal of after-restore step 4 with an\n417|// admitted attach capability; any other remote park offers takeover\n418|// instead of starting a runtime. Non-remote parks carry the fencing\n419|// reason unchanged.\n420|func decideParked(input Input, admitted terminalbackend.Admitted, reason fencing.ParkReason, winning string, cause error) Decision {\n421|\tif reason != fencing.ParkRemoteOwner {\n422|\t\treturn parked(reason, winning, cause)\n423|\t}\n424|\tif input.RemoteInteractive && terminalbackend.CheckOperation(\"attach\", admitted) == nil {\n425|\t\treturn Decision{\n426|\t\t\tAction:         ActionAttachRemote,\n427|\t\t\tParkReason:     reason,\n428|\t\t\tWinningLeaseID: winning,\n429|\t\t\tAdmitted:       admitted,\n430|\t\t\tDetail:         \"offer remote attach; no lease mutation\",\n431|\t\t\tCause:          cause,\n432|\t\t}\n433|\t}\n434|\treturn Decision{\n435|\t\tAction:         ActionTakeoverOffer,\n436|\t\tParkReason:     reason,\n437|\t\tWinningLeaseID: winning,\n438|\t\tAdmitted:       admitted,\n439|\t\tDetail:         \"offer takeover; no runtime started\",\n440|\t\tCause:          cause,\n441|\t}\n442|}\n443|\n444|// authorize selects the fencing entry by mode: activation for a\n445|// fresh launch, restore for the after-restore first start. Both are\n446|// launch-class entries: ownership that is remote, ambiguous,\n447|// unverified, or absent parks with the session.parked vocabulary,\n448|// while malformed calls, foreign sessions, and lapsed grants refuse.\n449|func authorize(input Input) (fencing.LeaseToken, error) {\n450|\tif input.Mode == ModeRestore {\n451|\t\treturn fencing.AuthorizeRestore(input.Presented, input.Observation)\n452|\t}\n453|\treturn fencing.AuthorizeActivation(input.Presented, input.Observation)\n454|}\n455|\n456|// admitBackend parses the §4.B identity documents through the\n457|// terminalbackend owner, reconciles the Probe against the Manifest\n458|// with the returned evidence bound to the AX-known raw generation,\n459|// and gates the mode operation against the admitted set. Only the\n460|// exact admitted capability rows authorize the action; no\n461|// capability map is invented here.\n462|func admitBackend(input Input) (terminalbackend.Admitted, error) {\n463|\tmanifest, err := terminalbackend.ParseManifest(input.Backend.Manifest)\n464|\tif err != nil {\n465|\t\treturn terminalbackend.Admitted{}, err\n466|\t}\n467|\tprobe, err := terminalbackend.ParseProbe(input.Backend.Probe)\n468|\tif err != nil {\n469|\t\treturn terminalbackend.Admitted{}, err\n470|\t}\n471|\tevidence := make([]terminalbackend.Evidence, 0, len(input.Backend.Evidence))\n472|\tfor _, doc := range input.Backend.Evidence {\n473|\t\tparsed, err := terminalbackend.ParseEvidence(doc)\n474|\t\tif err != nil {\n475|\t\t\treturn terminalbackend.Admitted{}, err\n476|\t\t}\n477|\t\tevidence = append(evidence, parsed)\n478|\t}\n479|\tadmitted, err := terminalbackend.Reconcile(manifest, probe, evidence, input.Backend.RawGeneration, input.Backend.Now, input.Backend.Verify)\n480|\tif err != nil {\n481|\t\treturn terminalbackend.Admitted{}, err\n482|\t}\n483|\toperation := \"create\"\n484|\tif input.Mode == ModeRestore {\n485|\t\toperation = \"restore\"\n486|\t}\n487|\tif err := terminalbackend.CheckOperation(operation, admitted); err != nil {\n488|\t\treturn terminalbackend.Admitted{}, err\n489|\t}\n490|\treturn admitted, nil\n491|}\n492|\n493|// admitCheckpoint admits the resume checkpoint through the sessrepo\n494|// attestation owner: the closed shape must verify and the computed\n495|// identity must equal the expected checkpoint digest.\n496|func admitCheckpoint(doc []byte, want string) error {\n497|\tif len(doc) == 0 {\n498|\t\treturn errCheckpointAbsent()\n499|\t}\n500|\tdigest, _, err := sessrepo.AttestCheckpointRecord(doc)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
