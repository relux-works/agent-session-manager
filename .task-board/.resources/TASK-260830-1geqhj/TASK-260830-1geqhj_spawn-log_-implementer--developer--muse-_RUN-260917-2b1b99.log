{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7fb","stream":{"kind":"session","id":"01a0b0ab-f92f-74d3-a245-61ad42401b4b"},"sequence":600,"recorded_at":1780531400001195,"record_type":"event","durability":"durable","causation_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","run_stream":{"kind":"run","id":"8ab0c8df-167f-48db-b83c-f756aeede0a9"},"task_stream":{"kind":"task","id":"01a0b0ae-15ef-7a60-a1e7-1d774198ae5b"},"task_id":"01a0b0ae-15ef-7a60-a1e7-1d774198ae5b","event":{"kind":"output","task_id":"01a0b0ae-15ef-7a60-a1e7-1d774198ae5b","chunk":"Read text file `internal/axpane/sync.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"os\"\n6|\t\"runtime\"\n7|)\n8|\n9|// syncDirectory fsyncs a directory so an install inside it survives\n10|// a crash. Opening a directory fails on Windows, where the install\n11|// itself is the durability boundary; there the sync is skipped,\n12|// never faked. This mirrors the landed matjournal discipline.\n13|func syncDirectory(path string) error {\n14|\tif runtime.GOOS == \"windows\" {\n15|\t\treturn nil\n16|\t}\n17|\tdirectory, err := os.Open(path)\n18|\tif err != nil {\n19|\t\treturn fmt.Errorf(\"open directory for fsync: %w\", err)\n20|\t}\n21|\tdefer func() { _ = directory.Close() }()\n22|\tif err := directory.Sync(); err != nil {\n23|\t\treturn fmt.Errorf(\"fsync directory: %w\", err)\n24|\t}\n25|\treturn nil\n26|}","final_result":true}}}
