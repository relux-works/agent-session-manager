e discovery; every other proof still verifies.\",\n160|    ),\n161|    Mutant(\n162|        name=\"N-smoke-verdict\",\n163|        path=f\"{PACKAGE}/decide.go\",\n164|        find=\"\\tif record.Verdict != resumesmoke.VerdictPass {\\n\",\n165|        replace=\"\\tif record.Verdict != resumesmoke.VerdictPass && record.Verdict != resumesmoke.VerdictFail {\\n\",\n166|        count=1,\n167|        run=\"TestDecideTable/refused_smoke_failing_verdict\",\n168|        expect=\"KILLED\",\n169|        note=\"Admits exactly failing verdicts; gated, unsupported, and unknown still refuse.\",\n170|    ),\n171|    Mutant(\n172|        name=\"N-smoke-version\",\n173|        path=f\"{PACKAGE}/decide.go\",\n174|        find=\"\"\"\\tif record.Tuple.ProviderID != build.ProviderID ||\n175|\\t\\trecord.Tuple.ProviderVersion != build.ProviderVersion ||\n176|\\t\\trecord.Tuple.Platform != build.Platform ||\n177|\\t\\trecord.Tuple.Architecture != build.Architecture {\n178|\"\"\",\n179|        replace=\"\"\"\\tif record.Tuple.ProviderID != build.ProviderID ||\n180|\\t\\trecord.Tuple.Platform != build.Platform ||\n181|\\t\\trecord.Tuple.Architecture != build.Architecture {\n182|\"\"\",\n183|        count=1,\n184|        run=\"TestDecideTable/refused_smoke_wrong_build\",\n185|        expect=\"KILLED\",\n186|        note=\"Admits exactly version drift; provider, platform, and arch still bind.\",\n187|    ),\n188|    Mutant(\n189|        name=\"N-smoke-mode\",\n190|        path=f\"{PACKAGE}/decide.go\",\n191|        find=\"\\tif !input.Smoke.Required {\\n\",\n192|        replace=\"\\tif !input.Smoke.Required || input.Mode == ModeLaunch {\\n\",\n193|        count=1,\n194|        run=\"TestDecideTable/refused_smoke_absent\",\n195|        expect=\"KILLED\",\n196|        note=\"Skips the required smoke exactly on launch; restore-mode still enforces it.\",\n197|    ),\n198|    Mutant(\n199|        name=\"N-profile-derive\",\n200|        path=f\"{PACKAGE}/decide.go\",\n201|        find=\"\"\"\\tpair, err := sessprofile.Derive(input.ProfileRecord, input.ProfileEvents)\n202|\\tif err != nil {\n203|\\t\\treturn refused(ClassIntegrityFailure, \"effective profile derivation failed\", err)\n204|\\t}\n205|\"\"\",\n206|        replace=\"\"\"\\tpair, err := sessprofile.Derive(input.ProfileRecord, input.ProfileEvents)\n207|\\tif err != nil && input.Provider.Build.ProviderID != \"codex\" {\n208|\\t\\treturn refused(ClassIntegrityFailure, \"effective profile derivation failed\", err)\n209|\\t}\n210|\"\"\",\n211|        count=1,\n212|        run=\"TestDecideTable/refused_profile_derivation_corrupt\",\n213|        expect=\"KILLED\",\n214|        note=\"Admits corrupt derivation exactly for codex, surfacing the wrong class.\",\n215|    ),\n216|    Mutant(\n217|        name=\"N-mapping\",\n218|        path=f\"{PACKAGE}/decide.go\",\n219|        find=\"\"\"\\tresolved, err := provhost.ResolveMapping(input.Provider.Build.ProviderID, pair.Profile, input.Provider.Build)\n220|\\tif err != nil {\n221|\\t\\treturn refused(ClassProfileMappingUnavailable, \"adapter cannot map the stored profile\", err)\n222|\\t}\n223|\"\"\",\n224|        replace=\"\"\"\\tresolved, err := provhost.ResolveMapping(input.Provider.Build.ProviderID, pair.Profile, input.Provider.Build)\n225|\\tif err != nil && pair.Profile != \"standard\" {\n226|\\t\\treturn refused(ClassProfileMappingUnavailable, \"adapter cannot map the stored profile\", err)\n227|\\t}\n228|\"\"\",\n229|        count=1,\n230|        run=\"TestDecideTable/refused_profile_mapping_unavailable\",\n231|        expect=\"KILLED\",\n232|        note=\"Admits exactly standard mapping gaps; yolo gaps still refuse.\",\n233|    ),\n234|    Mutant(\n235|        name=\"N-realm\",\n236|        path=f\"{PACKAGE}/decide.go\",\n237|        find=\"\\tif input.Realm.Caller != CallerBackground {\\n\",\n238|        replace='\\tif input.Realm.Caller != CallerBackground || input.Realm.BrokerState == \"broker-running\" {\\n',\n239|        count=1,\n240|        run=\"TestDecideTable/refused_realm_background_no_server\",\n241|        expect=\"KILLED\",\n242|        note=\"Admits exactly broker-running background callers; other states still refuse.\",\n243|    ),\n244|    Mutant(\n245|        name=\"N-entrypoint\",\n246|        path=f\"{PACKAGE}/decide.go\",\n247|        find=\"\\tif err := terminalbackend.CheckEntrypoint(input.Entrypoint, input.SessionID); err != nil {\\n\",\n248|        replace=\"\\tif err := terminalbackend.CheckEntrypoint(input.Entrypoint, input.SessionID); err != nil && len(input.Entrypoint) != 2 {\\n\",\n249|        count=1,\n250|        run=\"TestDecideTable/refused_entrypoint_raw_provider\",\n251|        expect=\"KILLED\",\n252|        note=\"Admits exactly two-element argv; other arities still refuse.\",\n253|    ),\n254|    Mutant(\n255|        name=\"N-descriptor\",\n256|        path=f\"{PACKAGE}/decide.go\",\n257|        find=\"\"\"\\tdescriptor, err := terminalbackend.AdmitProviderDescriptor(input.Descriptor, input.HostBinding)\n258|\\tif err != nil {\n259|\\t\\treturn refused(backendClass(err), \"provider descriptor does not match the validated binding\", err)\n260|\\t}\n261|\"\"\",\n262|        replace=\"\"\"\\tdescriptor, err := terminalbackend.AdmitProviderDescriptor(input.Descriptor, input.HostBinding)\n263|\\tif err != nil && input.Mode != ModeLaunch {\n264|\\t\\treturn refused(backendClass(err), \"provider descriptor does not match the validated binding\", err)\n265|\\t}\n266|\"\"\",\n267|        count=1,\n268|        run=\"TestDecideTable/refused_descriptor_generation_drift\",\n269|        expect=\"KILLED\",\n270|        note=\"Admits exactly launch-mode descriptor mismatch; restore-mode still refuses.\",\n271|    ),\n272|    Mutant(\n273|        name=\"N-attach\",\n274|        path=f\"{PACKAGE}/decide.go\",\n275|        find='\\tif input.RemoteInteractive && terminalbackend.CheckOperation(\"attach\", admitted) == nil {\\n',\n276|        replace=\"\\tif input.RemoteInteractive {\\n\",\n277|        count=1,\n278|        run=\"TestDecideTable/takeover_offer_attach_unproven\",\n279|        expect=\"KILLED\",\n280|        note=\"Admits remote attach without the capability; non-interactive still offers takeover.\",\n281|    ),\n282|    Mutant(\n283|        name=\"N-reattach\",\n284|        path=f\"{PACKAGE}/decide.go\",\n285|        find=\"\"\"\\tif input.ExistingBinding != nil {\n286|\\t\\tdecision.Action = ActionReattach\n287|\"\"\",\n288|        replace=\"\"\"\\tif input.ExistingBinding != nil && input.Mode == ModeRestore {\n289|\\t\\tdecision.Action = ActionReattach\n290|\"\"\",\n291|        count=1,\n292|        run=\"TestDecideTable/reattach_same_pair\",\n293|        expect=\"KILLED\",\n294|        note=\"Selects launch instead of reattach exactly on launch mode.\",\n295|    ),\n296|    Mutant(\n297|        name=\"N-binding-prefix\",\n298|        path=f\"{PACKAGE}/binding.go\",\n299|        find=\"\\t\\t\\tif winner.OperationID != operationID {\\n\",\n300|        replace=\"\\t\\t\\tif winner.OperationID[:8] != operationID[:8] {\\n\",\n301|        count=1,\n302|        run=\"TestBindConcurrentChangedOperationRefuses\",\n303|        expect=\"KILLED\",\n304|        note=\"Admits exactly same-prefix changed operations; full comparison otherwise stays.\",\n305|    ),\n306|    Mutant(\n307|        name=\"N-binding-session\",\n308|        path=f\"{PACKAGE}/binding.go\",\n309|        find=\"\\tif binding.SessionID != sessionID {\\n\",\n310|        replace=\"\\tif binding.SessionID[:8] != sessionID[:8] {\\n\",\n311|        count=1,\n312|        run=\"TestStatusSessionMismatchRefuses\",\n313|        expect=\"KILLED\",\n314|        note=\"Admits exactly same-prefix foreign sessions; full comparison otherwise stays.\",\n315|    ),\n316|    Mutant(\n317|        name=\"N-parked-reason\",\n318|        path=f\"{PACKAGE}/events.go\",\n319|        find='\\tdefault:\\n\\t\\treturn nil, fmt.Errorf(\"parked reason %q is not the session.parked vocabulary\", string(reason))\\n\\t}\\n',\n320|        replace='\\tdefault:\\n\\t\\tif len(reason) != 5 {\\n\\t\\t\\treturn nil, fmt.Errorf(\"parked reason %q is not the session.parked vocabulary\", string(reason))\\n\\t\\t}\\n\\t}\\n',\n321|        count=1,\n322|        run=\"TestParkedPayloadVocabulary\",\n323|        expect=\"KILLED\",\n324|        note=\"Admits exactly five-letter reasons; the vocabulary check otherwise stays.\",\n325|    ),\n326|    Mutant(\n327|        name=\"C-doc-comment\",\n328|        path=f\"{PACKAGE}/doc.go\",\n329|        find=\"// `ax pane SESSION_ID` enforcement wrapper: the decision every managed\\n\",\n330|        replace=\"// `ax pane SESSION_ID` enforcement wrapper (control): the decision every managed\\n\",\n331|        count=1,\n332|        run=\"TestRealmCarriesNoCachedEvidence\",\n333|        expect=\"SURVIVED\",\n334|        note=\"Harmless control: a comment-only edit must survive.\",\n335|    ),\n336|]\n337|\n338|\n339|def run_mutant(mutant: Mutant) -> str:\n340|    target = REPO / mutant.path\n341|    original = target.read_text()\n342|    found = original.count(mutant.find)\n343|    if found != mutant.count:\n344|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\"\n345|    with tempfile.TemporaryDirectory() as staging:\n346|        backup = Path(staging) / \"backup\"\n347|        shutil.copy2(target, backup)\n348|        try:\n349|            target.write_text(original.replace(mutant.find, mutant.replace))\n350|            run = subprocess.run(\n351|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n352|                cwd=REPO,\n353|                capture_output=True,\n354|                text=True,\n355|                timeout=300,\n356|            )\n357|        finally:\n358|            shutil.copy2(backup, target)\n359|    output = (run.stdout + run.stderr).strip()\n360|    if os.environ.get(\"AX_MUTANT_VERBOSE\") == \"1\":\n361|        print(f\"--- raw: {mutant.name}: exit {run.returncode} ---\", flush=True)\n362|        print(output, flush=True)\n363|        print(f\"--- end raw: {mutant.name} ---\", flush=True)\n364|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n365|        return f\"ERROR: {mutant.name}: build broke under the patch\"\n366|    if run.returncode == 0:\n367|        verdict = \"SURVIVED\"\n368|    elif '--- FAIL' in output or 'FAIL:' in output:\n369|        verdict = \"KILLED\"\n370|    else:\n371|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\"\n372|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n373|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note} [exit {run.returncode}]\"\n374|\n375|\n376|def main(argv: list[str]) -> int:\n377|    selected = [m for m in MUTANTS if not argv or m.name in argv]\n378|    if argv and len(selected) != len(argv):\n379|        unknown = sorted(set(argv) - {m.name for m in selected})\n380|        print(f\"unknown mutants: {', '.join(unknown)}\")\n381|        return 2\n382|    failures = 0\n383|    for mutant in selected:\n384|        try:\n385|            line = run_mutant(mutant)\n386|        except subprocess.TimeoutExpired:\n387|            line = f\"ERROR: {mutant.name}: killer timed out\"\n388|        print(line, flush=True)\n389|        if not line.startswith(\"ok:\"):\n390|            failures += 1\n391|    return 1 if failures else 0\n392|\n393|\n394|if __name__ == \"__main__\":\n395|    sys.exit(main(sys.argv[1:]))","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c99f","stream":{"kind":"session","id":"01a0b0ab-f92f-74d3-a245-61ad42401b4b"},"sequence":810,"recorded_at":1780531400001615,"record_type":"event","durability":"durable","causation_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","run_stream":{"kind":"run","id":"8ab0c8df-167f-48db-b83c-f756aeede0a9"},"call_id":"call_01a0b0ae78317165b86a0ce36736de9a","text":"Read text file `internal/axpane/conformance_test.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"os/exec\"\n5|\t\"regexp\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n10|)\n11|\n12|// TestDecideArmPrecedence pins the §4.C wrapper-rule order: with\n13|// every arm faulted at once, the first arm wins. Configuration\n14|// precedes session, which precedes bootstrap idempotency, which\n15|// precedes backend admission, which precedes fencing.\n16|func TestDecideArmPrecedence(t *testing.T) {\n17|\tt.Parallel()\n18|\tdeps := buildDecideDeps(t, true)\n19|\tinput := validInput(t, deps)\n20|\tinput.ConfigErr = errFixtureConfig\n21|\tinput.SessionKnown = false\n22|\tinput.ExistingBinding = &Binding{SessionID: fixtureSession, OperationID: fixtureOtherOp}\n23|\tinput.Backend.Manifest = []byte(`{\"broken\":true}`)\n24|\tinput.Presented.Epoch = 0\n25|\tdecision := Decide(input)\n26|\tif decision.Action != ActionRefused || decision.Class != ClassInvalidConfig {\n27|\t\tt.Fatalf(\"Decide() all-faulted = (%q, %q), want (refused, invalid_config)\", decision.Action, decision.Class)\n28|\t}\n29|\tinput.ConfigErr = nil\n30|\tdecision = Decide(input)\n31|\tif decision.Action != ActionRefused || decision.Class != ClassInvalidArguments {\n32|\t\tt.Fatalf(\"Decide() peeled-config = (%q, %q), want the session arm\", decision.Action, decision.Class)\n33|\t}\n34|}\n35|\n36|// TestEmitParkedVocabularyLoop authors all four session.parked\n37|// reasons through the production emission path and reads each back\n38|// with its exact closed payload.\n39|func TestEmitParkedVocabularyLoop(t *testing.T) {\n40|\tt.Parallel()\n41|\tdeps := buildDecideDeps(t, true)\n42|\tcases := []struct {\n43|\t\treason fencing.ParkReason\n44|\t\taction Action\n45|\t\tmutate func(*Input)\n46|\t}{\n47|\t\t{fencing.ParkRemoteOwner, ActionTakeoverOffer, func(input *Input) { input.Observation.Winner.HolderHostID = fixtureRemoteHost }},\n48|\t\t{fencing.ParkStaleOwner, ActionParked, func(input *Input) { input.Presented.LeaseID = fixtureLeaseB }},\n49|\t\t{fencing.ParkRestorePolicy, ActionParked, func(input *Input) { input.Observation.Verified = false }},\n50|\t\t{fencing.ParkFailedHandoff, ActionParked, func(input *Input) { input.Observation.HandoffFailed = true }},\n51|\t}\n52|\tsequence := uint64(2)\n53|\tpredecessor := deps.createdID\n54|\tfor _, testCase := range cases {\n55|\t\tinput := validInput(t, deps)\n56|\t\ttestCase.mutate(&input)\n57|\t\tdecision := Decide(input)\n58|\t\tif decision.Action != testCase.action || decision.ParkReason != testCase.reason {\n59|\t\t\tt.Fatalf(\"Decide() = (%q, %q), want (%q, %q)\", decision.Action, decision.ParkReason, testCase.action, testCase.reason)\n60|\t\t}\n61|\t\treference, _, err := EmitParked(deps.repo, decision, EmitParams{\n62|\t\t\tSessionID: fixtureSession, CreatedByHost: fixtureLocalHost,\n63|\t\t\tLeaseEpoch: 1, LeaseID: fixtureLeaseA, LeaseSequence: sequence,\n64|\t\t\tPredecessors: []string{predecessor}, CreatedAt: fixtureCreatedAt,\n65|\t\t})\n66|\t\tif err != nil {\n67|\t\t\tt.Fatalf(\"EmitParked(%q) error = %v\", testCase.reason, err)\n68|\t\t}\n69|\t\tstored, err := deps.repo.GetEvent(fixtureSession, reference.EventID)\n70|\t\tif err != nil {\n71|\t\t\tt.Fatal(err)\n72|\t\t}\n73|\t\tif !strings.Contains(string(stored), `\"reason\":\"`+string(testCase.reason)+`\"`) {\n74|\t\t\tt.Fatalf(\"parked event for %q carries no reason member: %s\", testCase.reason, stored)\n75|\t\t}\n76|\t\tsequence++\n77|\t\tpredecessor = reference.EventID\n78|\t}\n79|}\n80|\n81|// TestLaunchCarriesValidatedPlan pins the §13.1 step-4 surface the\n82|// wrapper hands to the later provider-launch leaf: the resolved\n83|// adapter mapping, the admitted §7.A descriptor, and the sealed\n84|// fencing token travel together on every launch, and no launch\n85|// ships a partial plan.\n86|func TestLaunchCarriesValidatedPlan(t *testing.T) {\n87|\tt.Parallel()\n88|\tdeps := buildDecideDeps(t, true)\n89|\tdecision := Decide(validInput(t, deps))\n90|\tif decision.Action != ActionLaunch {\n91|\t\tt.Fatalf(\"Decide() action = %q, want launch\", decision.Action)\n92|\t}\n93|\tif !decision.HasToken {\n94|\t\tt.Fatal(\"launch carries no fencing token\")\n95|\t}\n96|\tif decision.Descriptor.TerminalInstanceID == \"\" {\n97|\t\tt.Fatal(\"launch carries no admitted descriptor\")\n98|\t}\n99|\tif len(decision.Admitted.Capabilities) == 0 {\n100|\t\tt.Fatal(\"launch carries no admitted capabilities\")\n101|\t}\n102|}\n103|\n104|// TestConformanceMatrixCompleteness enumerates the pinned clauses\n105|// and the named top-level test that drives each through a\n106|// production entry, then verifies every named test exists in this\n107|// package through the go list entry. A row fails if its test is\n108|// removed or renamed without updating the matrix; subtest rows in\n109|// TRACEABILITY.md refine these top-level drivers.\n110|func TestConformanceMatrixCompleteness(t *testing.T) {\n111|\tt.Parallel()\n112|\trows := []struct {\n113|\t\tclause string\n114|\t\ttest   string\n115|\t}{\n116|\t\t{\"4.B manifest/probe/evidence identity\", \"TestDecideLaunchPositive\"},\n117|\t\t{\"4.B mismatch fails before activation\", \"TestDecideTable\"},\n118|\t\t{\"4.C wrapper rule order\", \"TestDecideArmPrecedence\"},\n119|\t\t{\"4.C bootstrap idempotency mismatch\", \"TestDecideTable\"},\n120|\t\t{\"4.C identical retry reattaches\", \"TestBindIdenticalRetryReattaches\"},\n121|\t\t{\"4.C concurrent commit reattaches\", \"TestBindConcurrentSameOperationReattaches\"},\n122|\t\t{\"4.C status proves absence\", \"TestBindInstallsAndStatusProves\"},\n123|\t\t{\"4.C unknown is not absent\", \"TestStatusUnknownIsNotAbsent\"},\n124|\t\t{\"4.C no PID persisted\", \"TestBindingPersistsNoPID\"},\n125|\t\t{\"4.C crash at the binding seam\", \"TestBindCrashChildSelfTerminates\"},\n126|\t\t{\"4.D only admitted rows authorize\", \"TestDecideTable\"},\n127|\t\t{\"4.2 background caller capability_unavailable\", \"TestDecideTypedRefusals\"},\n128|\t\t{\"4.2 cached evidence never authorizes\", \"TestRealmCarriesNoCachedEvidence\"},\n129|\t\t{\"4.2 after-restore sequence\", \"TestDecideAfterRestoreSequence\"},\n130|\t\t{\"5.2 session.parked vocabulary\", \"TestEmitParkedVocabularyLoop\"},\n131|\t\t{\"5.2 parked emission under lease\", \"TestEmitParkedRoundTrip\"},\n132|\t\t{\"5.2 v4 terminal payloads\", \"TestEmitTerminalV4RoundTrip\"},\n133|\t\t{\"7.A descriptor build and admit\", \"TestDescriptorBuildAdmitRoundTrip\"},\n134|\t\t{\"7.A descriptor mismatch refuses\", \"TestDescriptorMismatchRefuses\"},\n135|\t\t{\"7.A generation bounds\", \"TestDescriptorGenerationBounds\"},\n136|\t\t{\"7.A token passed separately\", \"TestDecideForgedTokensRefuse\"},\n137|\t\t{\"13.1 step 3 durable terminal entry\", \"TestRunLaunchBinds\"},\n138|\t\t{\"13.1 step 4 validated plan\", \"TestLaunchCarriesValidatedPlan\"},\n139|\t\t{\"2.4 effective profile and source\", \"TestDecideProfileSourcePinsEvent\"},\n140|\t\t{\"2.4 mapping refusal\", \"TestDecideYoloMapping\"},\n141|\t\t{\"orchestrated launch/reattach/park/refuse\", \"TestRunParkedEmits\"},\n142|\t\t{\"ownership observation over leases\", \"TestObserveLoadsWinningLease\"},\n143|\t}\n144|\tlisted, err := exec.Command(\"go\", \"test\", \".\", \"-list\", \".\", \"-count=1\").CombinedOutput()\n145|\tif err != nil {\n146|\t\tt.Fatalf(\"go test -list error = %v: %s\", err, listed)\n147|\t}\n148|\tpresent := map[string]bool{}\n149|\tfor _, line := range strings.Split(string(listed), \"\\n\") {\n150|\t\tmatched, _ := regexp.MatchString(`^Test[A-Za-z0-9_]+$`, strings.TrimSpace(line))\n151|\t\tif matched {\n152|\t\t\tpresent[strings.TrimSpace(line)] = true\n153|\t\t}\n154|\t}\n155|\tif len(present) == 0 {\n156|\t\tt.Fatalf(\"go test -list found no tests: %s\", listed)\n157|\t}\n158|\tfor _, row := range rows {\n159|\t\tif !present[row.test] {\n160|\t\t\tt.Errorf(\"clause %q names missing test %q\", row.clause, row.test)\n161|\t\t}\n162|\t}\n163|\tt.Logf(\"%d pinned clauses mapped to named tests\", len(rows))\n164|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
