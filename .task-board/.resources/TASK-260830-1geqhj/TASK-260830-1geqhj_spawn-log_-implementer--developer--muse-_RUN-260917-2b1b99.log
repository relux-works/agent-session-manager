{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5d1","stream":{"kind":"session","id":"01a0b0ab-f92f-74d3-a245-61ad42401b4b"},"sequence":323,"recorded_at":1780531400000641,"record_type":"event","durability":"durable","causation_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","run_stream":{"kind":"run","id":"8ab0c8df-167f-48db-b83c-f756aeede0a9"},"task_stream":{"kind":"task","id":"01a0b0ac-cc4a-7180-9a28-cc3d50cfee1f"},"task_id":"01a0b0ac-cc4a-7180-9a28-cc3d50cfee1f","event":{"kind":"output","task_id":"01a0b0ac-cc4a-7180-9a28-cc3d50cfee1f","chunk":"Read text file `/tmp/rev1/evidence/review_mutants.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Reviewer narrowing mutants for CR-TASK-260830-1geqhj-1 (isolated copy only).\n3|\n4|Each row: M (patch one production file in the isolated copy), R (run the\n5|WHOLE behavioral suite of internal/axpane minus the reviewer probes),\n6|V (KILLED iff a --- FAIL line appears with a non-zero exit; SURVIVED iff\n7|exit 0; ERROR otherwise). Raw logs per plant are written next to this\n8|script. Files are restored from backup after every row.\n9|\"\"\"\n10|import os\n11|import shutil\n12|import subprocess\n13|import sys\n14|import tempfile\n15|from dataclasses import dataclass\n16|from pathlib import Path\n17|\n18|HERE = Path(__file__).resolve().parent\n19|REPO = HERE / \"cand\"\n20|PACKAGE = \"internal/axpane\"\n21|LOGS = HERE / \"logs\" / \"mutants\"\n22|LOGS.mkdir(parents=True, exist_ok=True)\n23|\n24|\n25|@dataclass(frozen=True)\n26|class Mutant:\n27|    name: str\n28|    path: str\n29|    find: str\n30|    replace: str\n31|    expect: str\n32|    note: str\n33|\n34|\n35|MATERIALIZATION_BLOCK = (\n36|    \"\\tif input.MaterializationRequired && (!input.JournalOK || input.Journal.Phase != matjournal.PhaseCommitted) {\\n\"\n37|    \"\\t\\treturn parked(fencing.ParkRestorePolicy, input.Observation.Winner.LeaseID,\\n\"\n38|    \"\\t\\t\\terrMaterializationNotValid(input.Journal.Phase, input.JournalOK))\\n\"\n39|    \"\\t}\\n\"\n40|)\n41|\n42|MUTANTS = [\n43|    Mutant(\n44|        name=\"RM1-observe-error-ignored\",\n45|        path=f\"{PACKAGE}/run.go\",\n46|        find=(\n47|            \"\\t\\tobserved, err := ObserveOwnership(stores.Repo, request.SessionID, request.Observe)\\n\"\n48|            \"\\t\\tif err != nil {\\n\"\n49|            \"\\t\\t\\treturn empty, err\\n\"\n50|            \"\\t\\t}\\n\"\n51|        ),\n52|        replace=(\n53|            \"\\t\\tobserved, err := ObserveOwnership(stores.Repo, request.SessionID, request.Observe)\\n\"\n54|            \"\\t\\tif err != nil {\\n\"\n55|            \"\\t\\t\\tobserved = fencing.Observation{SessionID: request.SessionID}\\n\"\n56|            \"\\t\\t}\\n\"\n57|        ),\n58|        expect=\"KILLED\",\n59|        note=\"One gate result ignored: an ObserveOwnership failure is swallowed into an empty observation (parks instead of propagating).\",\n60|    ),\n61|    Mutant(\n62|        name=\"RM2-steps-3-4-swapped\",\n63|        path=f\"{PACKAGE}/decide.go\",\n64|        find=MATERIALIZATION_BLOCK + \"\\tif input.CheckpointRequired {\\n\",\n65|        replace=\"\\tif input.CheckpointRequired {\\n\",\n66|        expect=\"KILLED\",\n67|        note=\"After-restore order swapped at steps 3/4: materialization validity evaluated before ownership (a remote owner with a stale materialization parks restore_policy instead of offering attach/takeover). Second edit inserts the block before authorize.\",\n68|    ),\n69|    Mutant(\n70|        name=\"RM3-park-reason-collapsed\",\n71|        path=f\"{PACKAGE}/decide.go\",\n72|        find=\"\\tif reason != fencing.ParkRemoteOwner {\\n\\t\\treturn parked(reason, winning, cause)\\n\\t}\\n\",\n73|        replace=\"\\tif reason != fencing.ParkRemoteOwner {\\n\\t\\treturn parked(fencing.ParkRestorePolicy, winning, cause)\\n\\t}\\n\",\n74|        expect=\"KILLED\",\n75|        note=\"Park reason collapsed to one value for every non-remote park.\",\n76|    ),\n77|    Mutant(\n78|        name=\"RM4-idempotency-dropped-in-restore\",\n79|        path=f\"{PACKAGE}/decide.go\",\n80|        find=\"\\tif input.ExistingBinding != nil && input.ExistingBinding.OperationID != input.BootstrapOperationID {\\n\",\n81|        replace=\"\\tif input.ExistingBinding != nil && input.ExistingBinding.OperationID != input.BootstrapOperationID && input.Mode == ModeLaunch {\\n\",\n82|        expect=\"KILLED\",\n83|        note=\"Bootstrap-window mismatch check dropped for restore mode (the mirror of the producer's N-idempotency).\",\n84|    ),\n85|    Mutant(\n86|        name=\"RM5-attested-server-narrowed\",\n87|        path=f\"{PACKAGE}/decide.go\",\n88|        find=\"\\tif input.Realm.AttestedServer {\\n\",\n89|        replace='\\tif input.Realm.AttestedServer || input.Realm.ServerGeneration == \"generation-alpha\" {\\n',\n90|        expect=\"KILLED\",\n91|        note=\"The authorizing realm arm (not mutated by the producer) admits one generation string without an attested server.\",\n92|    ),\n93|    Mutant(\n94|        name=\"RM6-offer-emission-dropped\",\n95|        path=f\"{PACKAGE}/run.go\",\n96|        find=\"\\tcase ActionParked, ActionAttachRemote, ActionTakeoverOffer:\\n\\t\\tif !observation.HasWinner {\\n\",\n97|        replace=\"\\tcase ActionParked, ActionAttachRemote:\\n\\t\\tif !observation.HasWinner {\\n\",\n98|        expect=\"KILLED\",\n99|        note=\"Takeover offers no longer author the parked event.\",\n100|    ),\n101|    Mutant(\n102|        name=\"RM7-successor-sequence\",\n103|        path=f\"{PACKAGE}/run.go\",\n104|        find=\"\\t\\tif tail.LeaseID == observation.Winner.LeaseID {\\n\\t\\t\\tsequence = tail.LeaseSequence + 1\\n\\t\\t}\\n\",\n105|        replace=\"\\t\\tif tail.LeaseID == observation.Winner.LeaseID || true {\\n\\t\\t\\tsequence = tail.LeaseSequence + 1\\n\\t\\t}\\n\",\n106|        expect=\"KILLED\",\n107|        note=\"Successor-lease events no longer restart at sequence 1.\",\n108|    ),\n109|    Mutant(\n110|        name=\"RC-detail-string\",\n111|        path=f\"{PACKAGE}/decide.go\",\n112|        find='\\t\\tDetail:   \"launch under the winning lease\",\\n',\n113|        replace='\\t\\tDetail:   \"launch under the winning lease.\",\\n',\n114|        expect=\"SURVIVED\",\n115|        note=\"Harmless control: a detail-string edit no test asserts must survive.\",\n116|    ),\n117|]\n118|\n119|\n120|def apply(mutant: Mutant, original: str) -> str:\n121|    patched = original.replace(mutant.find, mutant.replace)\n122|    if mutant.name == \"RM2-steps-3-4-swapped\":\n123|        anchor = \"\\ttoken, err := authorize(input)\\n\"\n124|        assert patched.count(anchor) == 1\n125|        patched = patched.replace(anchor, MATERIALIZATION_BLOCK + anchor)\n126|    return patched\n127|\n128|\n129|def run_mutant(mutant: Mutant) -> str:\n130|    target = REPO / mutant.path\n131|    original = target.read_text()\n132|    found = original.count(mutant.find)\n133|    if found != 1:\n134|        return f\"ERROR: {mutant.name}: patch anchors {found}, want 1\"\n135|    with tempfile.TemporaryDirectory() as staging:\n136|        backup = Path(staging) / \"backup\"\n137|        shutil.copy2(target, backup)\n138|        try:\n139|            target.write_text(apply(mutant, original))\n140|            run = subprocess.run(\n141|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-skip\", \"TestReviewProbe\", \"-count=1\"],\n142|                cwd=REPO, capture_output=True, text=True, timeout=600,\n143|            )\n144|        finally:\n145|            shutil.copy2(backup, target)\n146|    output = (run.stdout + run.stderr).strip()\n147|    (LOGS / f\"{mutant.name}.log\").write_text(f\"exit={run.returncode}\\n{output}\\n\")\n148|    if \"build failed\" in output or \"\\n# \" in output or output.startswith(\"# \"):\n149|        return f\"ERROR: {mutant.name}: build broke under the patch [exit {run.returncode}]\"\n150|    if run.returncode == 0:\n151|        verdict = \"SURVIVED\"\n152|    elif \"--- FAIL\" in output or \"FAIL:\" in output:\n153|        verdict = \"KILLED\"\n154|    else:\n155|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\"\n156|    killers = sorted({line.strip().split()[2] for line in output.splitlines() if line.strip().startswith(\"--- FAIL\")})\n157|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n158|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) [exit {run.returncode}] killers={killers} :: {mutant.note}\"\n159|\n160|\n161|def main(argv):\n162|    selected = [m for m in MUTANTS if not argv or m.name in argv]\n163|    failures = 0\n164|    for mutant in selected:\n165|        try:\n166|            line = run_mutant(mutant)\n167|        except subprocess.TimeoutExpired:\n168|            line = f\"ERROR: {mutant.name}: killer timed out\"\n169|        print(line, flush=True)\n170|        if not line.startswith(\"ok:\"):\n171|            failures += 1\n172|    return 1 if failures else 0\n173|\n174|\n175|if __name__ == \"__main__\":\n176|    sys.exit(main(sys.argv[1:]))","final_result":true}}}
