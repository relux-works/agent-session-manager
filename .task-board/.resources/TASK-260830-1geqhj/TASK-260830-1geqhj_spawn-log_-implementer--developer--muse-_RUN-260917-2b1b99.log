y: %v\", names)\n571|\tcount := 0\n572|\tfor _, name := range names {\n573|\t\tif name == \"binding.json\" {\n574|\t\t\tcount++\n575|\t\t}\n576|\t}\n577|\tif count != 1 {\n578|\t\tt.Errorf(\"binding count = %d, want exactly one\", count)\n579|\t}\n580|}\n581|\n582|// PROBE C2 — identical retries reattach without a second write: inode\n583|// and mtime census over the binding file.\n584|func TestReviewProbeIdenticalRetryInodeCensus(t *testing.T) {\n585|\tstore, err := Open(t.TempDir())\n586|\tif err != nil {\n587|\t\tt.Fatal(err)\n588|\t}\n589|\tfirst, reattached, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate())\n590|\tif err != nil || reattached {\n591|\t\tt.Fatalf(\"first bind = (%+v, %v, %v)\", first, reattached, err)\n592|\t}\n593|\tpath := store.bindingPath(fixtureSession)\n594|\tbefore, err := os.Stat(path)\n595|\tif err != nil {\n596|\t\tt.Fatal(err)\n597|\t}\n598|\tbeforeIno := before.Sys().(*syscall.Stat_t).Ino\n599|\tbeforeBytes, _ := os.ReadFile(path)\n600|\tfor round := 0; round < 3; round++ {\n601|\t\tother := bindCandidate()\n602|\t\tother.TerminalInstanceID = \"0198f4c9-3333-7ccc-8ccc-1234567890ab\" // different child facts on retry\n603|\t\tother.BindingDigest = BindingDigest(other)\n604|\t\tagain, reattached, err := store.Bind(fixtureSession, fixtureBootstrap, other)\n605|\t\tif err != nil || !reattached || again != first {\n606|\t\t\tt.Fatalf(\"retry %d = (%+v, %v, %v), want reattach to %+v\", round, again, reattached, err, first)\n607|\t\t}\n608|\t}\n609|\tafter, err := os.Stat(path)\n610|\tif err != nil {\n611|\t\tt.Fatal(err)\n612|\t}\n613|\tafterIno := after.Sys().(*syscall.Stat_t).Ino\n614|\tafterBytes, _ := os.ReadFile(path)\n615|\tt.Logf(\"inode before=%d after=%d mtime before=%v after=%v bytes-equal=%v\", beforeIno, afterIno, before.ModTime(), after.ModTime(), string(beforeBytes) == string(afterBytes))\n616|\tif beforeIno != afterIno || !before.ModTime().Equal(after.ModTime()) || string(beforeBytes) != string(afterBytes) {\n617|\t\tt.Errorf(\"identical retry rewrote the binding\")\n618|\t}\n619|\tentries, _ := os.ReadDir(filepath.Dir(path))\n620|\tif len(entries) != 1 {\n621|\t\tt.Errorf(\"session dir has %d entries, want 1 (no staging garbage)\", len(entries))\n622|\t}\n623|}\n624|\n625|func sessckptOpen(t *testing.T) (*sessckpt.Store, error) {\n626|\tt.Helper()\n627|\treturn sessckpt.Open(t.TempDir())\n628|}\n629|\n630|func checkpointFixtureFor(t *testing.T, repository *sessrepo.Repository, store *sessckpt.Store, sessionID string, heads []string) (string, []byte) {\n631|\tt.Helper()\n632|\treference, raw, err := store.Capture(repository, sessckpt.Inputs{\n633|\t\tOperationID:         fixtureBootstrap,\n634|\t\tSessionID:           sessionID,\n635|\t\tSessionKind:         sessckpt.SessionKindDirect,\n636|\t\tLeaseEpoch:          1,\n637|\t\tLeaseID:             fixtureLeaseA,\n638|\t\tCreatorHostID:       fixtureLocalHost,\n639|\t\tWorkspaceManifestID: seedDigest(0xE1),\n640|\t\tProviderManifestID:  seedDigest(0xE2),\n641|\t\tBoundary: sessckpt.SafeBoundary{\n642|\t\t\tProviderID:          \"codex\",\n643|\t\t\tProviderVersion:     \"0.147.0\",\n644|\t\t\tEvidence:            sessckpt.EvidenceAcceptedTest,\n645|\t\t\tInputBlocked:        true,\n646|\t\t\tForegroundIdle:      true,\n647|\t\t\tBackgroundIdle:      true,\n648|\t\t\tOpenProcesses:       0,\n649|\t\t\tOpenDatabaseHandles: 0,\n650|\t\t},\n651|\t\tEventHeads: heads,\n652|\t\tCreatedAt:  fixtureCreatedAt,\n653|\t\tExtensions: map[string]string{},\n654|\t})\n655|\tif err != nil {\n656|\t\tt.Fatalf(\"Capture() error = %v\", err)\n657|\t}\n658|\treturn reference.CheckpointID, raw\n659|}\n660|\n661|// execSelf re-executes the test binary for one test with extra env and\n662|// returns the run error (a SIGKILL exit is expected by the callers).\n663|func execSelf(t *testing.T, pattern string, env ...string) error {\n664|\tt.Helper()\n665|\tctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)\n666|\tdefer cancel()\n667|\tchild := exec.CommandContext(ctx, os.Args[0], \"-test.run=\"+pattern, \"-test.count=1\")\n668|\tchild.Env = append(os.Environ(), env...)\n669|\terr := child.Run()\n670|\tvar exitErr *exec.ExitError\n671|\tif !errors.As(err, &exitErr) {\n672|\t\tt.Fatalf(\"child run = %v, want a signal-kill exit\", err)\n673|\t}\n674|\tstatus, ok := exitErr.Sys().(syscall.WaitStatus)\n675|\tif !ok || !status.Signaled() || status.Signal() != syscall.SIGKILL {\n676|\t\tt.Fatalf(\"child status = %v, want killed by SIGKILL\", exitErr)\n677|\t}\n678|\treturn err\n679|}\n680|\n681|// PROBE 15 — §2.4 \"Losing-lease or ambiguous events MUST NOT change\n682|// [the effective profile]\": a profile.changed authored under the\n683|// superseded lease A (epoch 1) after a local successor lease A2 (epoch 2)\n684|// won is accepted by the chain (tail still at A) and then drives the\n685|// launch profile.\n686|func TestReviewProbeLosingLeaseProfileEventDrivesLaunch(t *testing.T) {\n687|\tworld := buildRunWorld(t)\n688|\tleases, err := world.repo.ListLeases(fixtureSession)\n689|\tif err != nil {\n690|\t\tt.Fatal(err)\n691|\t}\n692|\tsuccessor := \"cccccccc-dddd-4eee-8fff-000000000002\"\n693|\tif _, err := world.repo.CompareAndSwapLease(fixtureSession, sessrepo.LeaseExpectation{RecordID: leases[0].RecordID}, sessrepo.SuccessorLeaseInput{\n694|\t\tCreateLeaseInput: sessrepo.CreateLeaseInput{LeaseID: successor, HolderHostID: fixtureLocalHost, IssuedByHostID: fixtureLocalHost, CreatedAt: fixtureCreatedAt},\n695|\t\tReason:           \"graceful_takeover\",\n696|\t\tCheckpointID:     world.ckptID,\n697|\t}); err != nil {\n698|\t\tt.Fatalf(\"CompareAndSwapLease() error = %v\", err)\n699|\t}\n700|\t// losing-lease profile change (lease A epoch 1) after A2 epoch 2 won\n701|\tchanged := appendChainEvent(t, world.repo, \"profile.changed\", 1, fixtureLeaseA, 2, world.headID, map[string]any{\n702|\t\t\"from\": \"standard\", \"to\": \"yolo\", \"confirmed\": true,\n703|\t})\n704|\trequest := runRequest(t, world)\n705|\trequest.Presented = fencing.PresentedToken{SessionID: fixtureSession, Epoch: 2, LeaseID: successor}\n706|\toutcome, err := Run(world.stores(), request)\n707|\tif err != nil {\n708|\t\tt.Fatalf(\"Run() error = %v\", err)\n709|\t}\n710|\tt.Logf(\"launch under A2 epoch 2 with a losing-lease (A, epoch 1) profile.changed %s in the chain: action=%s profile=%+v mapping=%q\",\n711|\t\tchanged[:20], outcome.Decision.Action, outcome.Decision.Profile, outcome.Decision.Mapping)\n712|\tif outcome.Decision.Action == ActionLaunch && outcome.Decision.Profile.Source == changed {\n713|\t\tt.Errorf(\"FINDING: a profile.changed authored under a losing lease became the launch profile source (yolo mapping %q)\", outcome.Decision.Mapping)\n714|\t}\n715|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c59f","stream":{"kind":"session","id":"01a0b0ab-f92f-74d3-a245-61ad42401b4b"},"sequence":298,"recorded_at":1780531400000591,"record_type":"event","durability":"durable","causation_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","run_stream":{"kind":"run","id":"8ab0c8df-167f-48db-b83c-f756aeede0a9"},"call_id":"call_01a0b0ac9af5769c8660dc9b2aca0d1a","text":"Read text file `/tmp/rev1/evidence/probes/zz_review_delta_test.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/matjournal\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n11|)\n12|\n13|// Delta witnesses for the surviving reviewer mutants: each logs the\n14|// outcome so the same test run under the mutant shows the behavioral\n15|// change the suite never observes.\n16|func TestReviewDeltaRM2RemoteOwnerStaleMaterialization(t *testing.T) {\n17|\tdeps := buildDecideDeps(t, true)\n18|\tinput := validInput(t, deps)\n19|\tinput.Mode = ModeRestore\n20|\tinput.Observation.Winner.HolderHostID = fixtureRemoteHost\n21|\tinput.RemoteInteractive = true\n22|\tinput.MaterializationRequired = true\n23|\tinput.JournalOK = true\n24|\tinput.Journal = matjournal.Journal{Phase: matjournal.PhaseStaging}\n25|\tdecision := Decide(input)\n26|\tt.Logf(\"RM2 witness: remote interactive owner + staging materialization -> action=%s reason=%s\", decision.Action, decision.ParkReason)\n27|}\n28|\n29|func TestReviewDeltaRM4RestoreChangedOperation(t *testing.T) {\n30|\tdeps := buildDecideDeps(t, true)\n31|\tinput := validInput(t, deps)\n32|\tinput.Mode = ModeRestore\n33|\tinput.ExistingBinding = &Binding{SessionID: fixtureSession, OperationID: fixtureOtherOp, TerminalInstanceID: fixtureInstance, BindingDigest: seedDigest(0xB1), CreatedAt: fixtureCreatedAt}\n34|\tdecision := Decide(input)\n35|\tt.Logf(\"RM4 witness: restore mode + changed bootstrap operation -> action=%s class=%s\", decision.Action, decision.Class)\n36|}\n37|\n38|func TestReviewDeltaRM1ObserveFailure(t *testing.T) {\n39|\tworld := buildRunWorld(t)\n40|\troot := t.TempDir()\n41|\trepository, err := sessrepo.Open(root)\n42|\tif err != nil {\n43|\t\tt.Fatal(err)\n44|\t}\n45|\tvar record map[string]any\n46|\tif err := json.Unmarshal([]byte(sessionRecordFixture), &record); err != nil {\n47|\t\tt.Fatal(err)\n48|\t}\n49|\treference, err := repository.CreateSession(identifyObject(t, record, \"record_id\"))\n50|\tif err != nil {\n51|\t\tt.Fatal(err)\n52|\t}\n53|\tif _, err := repository.CreateLease(fixtureSession, sessrepo.CreateLeaseInput{LeaseID: fixtureLeaseA, HolderHostID: fixtureLocalHost, IssuedByHostID: fixtureLocalHost, CreatedAt: fixtureCreatedAt}); err != nil {\n54|\t\tt.Fatal(err)\n55|\t}\n56|\tappendChainEvent(t, repository, \"session.created\", 1, fixtureLeaseA, 1, reference.RecordID, map[string]any{\n57|\t\t\"session_record_id\": reference.RecordID, \"bootstrap_operation_id\": fixtureBootstrap, \"first_checkpoint_operation_id\": fixtureOtherOp,\n58|\t})\n59|\tworld.repo = repository\n60|\tmatches, _ := filepath.Glob(filepath.Join(root, \"sessions\", fixtureSession, \"leases\", \"*\"))\n61|\tt.Logf(\"lease blobs: %d\", len(matches))\n62|\tfor _, match := range matches {\n63|\t\tif err := os.WriteFile(match, []byte(\"{torn\"), 0o600); err != nil {\n64|\t\t\tt.Fatal(err)\n65|\t\t}\n66|\t}\n67|\toutcome, err := Run(world.stores(), runRequest(t, world))\n68|\tt.Logf(\"RM1 witness: Run with a torn lease blob -> action=%q emitted=%v err=%v\", outcome.Decision.Action, outcome.Emitted, err)\n69|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
