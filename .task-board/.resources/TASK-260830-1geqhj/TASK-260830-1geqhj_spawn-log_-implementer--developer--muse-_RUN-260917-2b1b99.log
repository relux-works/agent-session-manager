{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c999","stream":{"kind":"session","id":"01a0b0ab-f92f-74d3-a245-61ad42401b4b"},"sequence":807,"recorded_at":1780531400001609,"record_type":"event","durability":"durable","causation_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"8ab0c8df-167f-48db-b83c-f756aeede0a9","run_stream":{"kind":"run","id":"8ab0c8df-167f-48db-b83c-f756aeede0a9"},"task_stream":{"kind":"task","id":"01a0b0ae-7a75-7341-81fe-c1e265eca624"},"task_id":"01a0b0ae-7a75-7341-81fe-c1e265eca624","event":{"kind":"output","task_id":"01a0b0ae-7a75-7341-81fe-c1e265eca624","chunk":"Read text file `internal/axpane/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/axpane.\n3|\n4|Every gate ships a narrowing mutant: the gate stays present and is\n5|weakened to admit exactly one member of the class it must reject, and\n6|the named killer test must fail. A delete-only mutant proves only that\n7|the gate exists and is not accepted as evidence.\n8|\n9|Each row runs M (mutate one production file in place), R (run the\n10|scoped Go killer through the production entry point), V (verdict from\n11|the Go exit code plus a FAIL kill-line: KILLED iff R fails with a test\n12|failure line, SURVIVED iff R passes, ERROR for anything else —\n13|unapplied patches, build breaks, timeouts). M failures and R\n14|infrastructure errors are ERROR, never kills or survivals. The file is\n15|restored from its backup after every row, pass or fail.\n16|\n17|Row C-doc-comment is the harmless control: a comment-only edit that\n18|must SURVIVE, proving the harness observes test outcomes instead of\n19|hard-coding kills.\n20|\n21|Usage:\n22|  PYTHONDONTWRITEBYTECODE=1 python3 internal/axpane/mutant_harness.py\n23|  PYTHONDONTWRITEBYTECODE=1 python3 internal/axpane/mutant_harness.py N-config\n24|\"\"\"\n25|\n26|import os\n27|import shutil\n28|import subprocess\n29|import sys\n30|import tempfile\n31|from dataclasses import dataclass\n32|from pathlib import Path\n33|\n34|REPO = Path(__file__).resolve().parents[2]\n35|PACKAGE = \"internal/axpane\"\n36|\n37|\n38|@dataclass(frozen=True)\n39|class Mutant:\n40|    name: str\n41|    path: str\n42|    find: str\n43|    replace: str\n44|    count: int\n45|    run: str\n46|    expect: str\n47|    note: str\n48|\n49|\n50|MUTANTS = [\n51|    Mutant(\n52|        name=\"N-config\",\n53|        path=f\"{PACKAGE}/decide.go\",\n54|        find=\"\\tif input.ConfigErr != nil {\\n\",\n55|        replace=\"\\tif input.ConfigErr != nil && input.Mode == ModeRestore {\\n\",\n56|        count=1,\n57|        run=\"TestDecideTable/refused_config_invalid\",\n58|        expect=\"KILLED\",\n59|        note=\"Admits exactly launch-mode invalid config; restore-mode still refuses.\",\n60|    ),\n61|    Mutant(\n62|        name=\"N-mode\",\n63|        path=f\"{PACKAGE}/decide.go\",\n64|        find=\"\\tif input.Mode != ModeLaunch && input.Mode != ModeRestore {\\n\",\n65|        replace='\\tif input.Mode != ModeLaunch && input.Mode != ModeRestore && input.Mode != Mode(\"\") {\\n',\n66|        count=1,\n67|        run=\"TestDecideTable/refused_empty_mode\",\n68|        expect=\"KILLED\",\n69|        note=\"Admits exactly the empty mode; every other non-mode still refuses.\",\n70|    ),\n71|    Mutant(\n72|        name=\"N-session\",\n73|        path=f\"{PACKAGE}/decide.go\",\n74|        find=\"\\tif !input.SessionKnown {\\n\",\n75|        replace=\"\\tif !input.SessionKnown && input.Mode == ModeRestore {\\n\",\n76|        count=1,\n77|        run=\"TestDecideTable/refused_unknown_session\",\n78|        expect=\"KILLED\",\n79|        note=\"Admits exactly launch-mode unknown sessions; restore-mode still refuses.\",\n80|    ),\n81|    Mutant(\n82|        name=\"N-idempotency\",\n83|        path=f\"{PACKAGE}/decide.go\",\n84|        find=\"\\tif input.ExistingBinding != nil && input.ExistingBinding.OperationID != input.BootstrapOperationID {\\n\",\n85|        replace=\"\\tif input.ExistingBinding != nil && input.ExistingBinding.OperationID != input.BootstrapOperationID && input.Mode == ModeRestore {\\n\",\n86|        count=1,\n87|        run=\"TestDecideTable/refused_idempotency_mismatch\",\n88|        expect=\"KILLED\",\n89|        note=\"Admits exactly launch-mode changed operations; restore-mode still refuses.\",\n90|    ),\n91|    Mutant(\n92|        name=\"N-caller\",\n93|        path=f\"{PACKAGE}/decide.go\",\n94|        find=\"\\tif caller != CallerForeground && caller != CallerBackground {\\n\",\n95|        replace='\\tif caller != CallerForeground && caller != CallerBackground && caller != \"batch\" {\\n',\n96|        count=1,\n97|        run=\"TestDecideTable/refused_unknown_caller\",\n98|        expect=\"KILLED\",\n99|        note=\"Admits exactly the batch caller; every other non-caller still refuses.\",\n100|    ),\n101|    Mutant(\n102|        name=\"N-backend-op\",\n103|        path=f\"{PACKAGE}/decide.go\",\n104|        find='\\toperation := \"create\"\\n\\tif input.Mode == ModeRestore {\\n\\t\\toperation = \"restore\"\\n\\t}\\n',\n105|        replace='\\toperation := \"create\"\\n\\tif input.Mode == ModeRestore {\\n\\t\\toperation = \"create\"\\n\\t}\\n',\n106|        count=1,\n107|        run=\"TestDecideRestoreRequiresRestoreCapability\",\n108|        expect=\"KILLED\",\n109|        note=\"Admits restore-mode callers to the create row; the mode selection stays.\",\n110|    ),\n111|    Mutant(\n112|        name=\"N-materialization\",\n113|        path=f\"{PACKAGE}/decide.go\",\n114|        find=\"\\tif input.MaterializationRequired && (!input.JournalOK || input.Journal.Phase != matjournal.PhaseCommitted) {\\n\",\n115|        replace=\"\\tif input.MaterializationRequired && (!input.JournalOK || (input.Journal.Phase != matjournal.PhaseCommitted && input.Journal.Phase != matjournal.PhaseStaging)) {\\n\",\n116|        count=1,\n117|        run=\"TestDecideTable/parked_materialization_not_committed\",\n118|        expect=\"KILLED\",\n119|        note=\"Admits exactly staging journals; absent and other phases still park.\",\n120|    ),\n121|    Mutant(\n122|        name=\"N-checkpoint-absent\",\n123|        path=f\"{PACKAGE}/decide.go\",\n124|        find=\"\\tif input.CheckpointRequired {\\n\",\n125|        replace=\"\\tif input.CheckpointRequired && len(input.CheckpointDoc) > 0 {\\n\",\n126|        count=1,\n127|        run=\"TestDecideTable/parked_checkpoint_absent\",\n128|        expect=\"KILLED\",\n129|        note=\"Admits exactly absent checkpoints; inadmissible bytes still park.\",\n130|    ),\n131|    Mutant(\n132|        name=\"N-checkpoint-prefix\",\n133|        path=f\"{PACKAGE}/decide.go\",\n134|        find=\"\\tif digest.String() != want {\\n\",\n135|        replace=\"\\tif digest.String()[:16] != want[:16] {\\n\",\n136|        count=1,\n137|        run=\"TestDecideTable/parked_checkpoint_flipped_digest\",\n138|        expect=\"KILLED\",\n139|        note=\"Admits exactly same-prefix digests; full comparison otherwise stays.\",\n140|    ),\n141|    Mutant(\n142|        name=\"N-identity-version\",\n143|        path=f\"{PACKAGE}/decide.go\",\n144|        find=\"\\tif err := provhost.VerifyIdentityBuild(facts.Identity, facts.Build); err != nil {\\n\",\n145|        replace='\\tif err := provhost.VerifyIdentityBuild(facts.Identity, facts.Build); err != nil && facts.Build.ProviderVersion != \"0.147.0\" {\\n',\n146|        count=1,\n147|        run=\"TestDecideTable/refused_provider_identity_other_provider\",\n148|        expect=\"KILLED\",\n149|        note=\"Admits exactly 0.147.0 identity mismatches; other versions still refuse.\",\n150|    ),\n151|    Mutant(\n152|        name=\"N-discovery\",\n153|        path=f\"{PACKAGE}/decide.go\",\n154|        find=\"\\tif facts.HasDiscovery {\\n\",\n155|        replace='\\tif facts.HasDiscovery && facts.DiscoveryContext.Home != \"\" {\\n',\n156|        count=1,\n157|        run=\"TestDecideTable/refused_discovery_empty_home\",\n158|        expect=\"KILLED\",\n159|        note=\"Admits exactly empty-home discovery; every other proof still verifies.\",\n160|    ),\n161|    Mutant(\n162|        name=\"N-smoke-verdict\",\n163|        path=f\"{PACKAGE}/decide.go\",\n164|        find=\"\\tif record.Verdict != resumesmoke.VerdictPass {\\n\",\n165|        replace=\"\\tif record.Verdict != resumesmoke.VerdictPass && record.Verdict != resumesmoke.VerdictFail {\\n\",\n166|        count=1,\n167|        run=\"TestDecideTable/refused_smoke_failing_verdict\",\n168|        expect=\"KILLED\",\n169|        note=\"Admits exactly failing verdicts; gated, unsupported, and unknown still refuse.\",\n170|    ),\n171|    Mutant(\n172|        name=\"N-smoke-version\",\n173|        path=f\"{PACKAGE}/decide.go\",\n174|        find=\"\"\"\\tif record.Tuple.ProviderID != build.ProviderID ||\n175|\\t\\trecord.Tuple.ProviderVersion != build.ProviderVersion ||\n176|\\t\\trecord.Tuple.Platform != build.Platform ||\n177|\\t\\trecord.Tuple.Architecture != build.Architecture {\n178|\"\"\",\n179|        replace=\"\"\"\\tif record.Tuple.ProviderID != build.ProviderID ||\n180|\\t\\trecord.Tuple.Platform != build.Platform ||\n181|\\t\\trecord.Tuple.Architecture != build.Architecture {\n182|\"\"\",\n183|        count=1,\n184|        run=\"TestDecideTable/refused_smoke_wrong_build\",\n185|        expect=\"KILLED\",\n186|        note=\"Admits exactly version drift; provider, platform, and arch still bind.\",\n187|    ),\n188|    Mutant(\n189|        name=\"N-smoke-mode\",\n190|        path=f\"{PACKAGE}/decide.go\",\n191|        find=\"\\tif !input.Smoke.Required {\\n\",\n192|        replace=\"\\tif !input.Smoke.Required || input.Mode == ModeLaunch {\\n\",\n193|        count=1,\n194|        run=\"TestDecideTable/refused_smoke_absent\",\n195|        expect=\"KILLED\",\n196|        note=\"Skips the required smoke exactly on launch; restore-mode still enforces it.\",\n197|    ),\n198|    Mutant(\n199|        name=\"N-profile-derive\",\n200|        path=f\"{PACKAGE}/decide.go\",\n201|        find=\"\"\"\\tpair, err := sessprofile.Derive(input.ProfileRecord, input.ProfileEvents)\n202|\\tif err != nil {\n203|\\t\\treturn refused(ClassIntegrityFailure, \"effective profile derivation failed\", err)\n204|\\t}\n205|\"\"\",\n206|        replace=\"\"\"\\tpair, err := sessprofile.Derive(input.ProfileRecord, input.ProfileEvents)\n207|\\tif err != nil && input.Provider.Build.ProviderID != \"codex\" {\n208|\\t\\treturn refused(ClassIntegrityFailure, \"effective profile derivation failed\", err)\n209|\\t}\n210|\"\"\",\n211|        count=1,\n212|        run=\"TestDecideTable/refused_profile_derivation_corrupt\",\n213|        expect=\"KILLED\",\n214|        note=\"Admits corrupt derivation exactly for codex, surfacing the wrong class.\",\n215|    ),\n216|    Mutant(\n217|        name=\"N-mapping\",\n218|        path=f\"{PACKAGE}/decide.go\",\n219|        find=\"\"\"\\tresolved, err := provhost.ResolveMapping(input.Provider.Build.ProviderID, pair.Profile, input.Provider.Build)\n220|\\tif err != nil {\n221|\\t\\treturn refused(ClassProfileMappingUnavailable, \"adapter cannot map the stored profile\", err)\n222|\\t}\n223|\"\"\",\n224|        replace=\"\"\"\\tresolved, err := provhost.ResolveMapping(input.Provider.Build.ProviderID, pair.Profile, input.Provider.Build)\n225|\\tif err != nil && pair.Profile != \"standard\" {\n226|\\t\\treturn refused(ClassProfileMappingUnavailable, \"adapter cannot map the stored profile\", err)\n227|\\t}\n228|\"\"\",\n229|        count=1,\n230|        run=\"TestDecideTable/refused_profile_mapping_unavailable\",\n231|        expect=\"KILLED\",\n232|        note=\"Admits exactly standard mapping gaps; yolo gaps still refuse.\",\n233|    ),\n234|    Mutant(\n235|        name=\"N-realm\",\n236|        path=f\"{PACKAGE}/decide.go\",\n237|        find=\"\\tif input.Realm.Caller != CallerBackground {\\n\",\n