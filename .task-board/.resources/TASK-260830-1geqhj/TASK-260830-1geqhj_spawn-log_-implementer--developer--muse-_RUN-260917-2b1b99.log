d: {}, StateStale: {},\n64|\t},\n65|\tStateQuiescing: {\n66|\t\tStateIdle: {}, StateCheckpointing: {}, StateFailed: {}, StateStale: {},\n67|\t},\n68|\tStateCheckpointing: {\n69|\t\tStateIdle: {}, StateStopped: {}, StateMaterializing: {}, StateFailed: {},\n70|\t},\n71|\tStateMaterializing: {\n72|\t\tStateStopped: {}, StateRunning: {}, StateParked: {}, StateFailed: {},\n73|\t},\n74|\tStateStopped: {\n75|\t\tStateMaterializing: {}, StateRunning: {}, StateParked: {}, StateTombstoned: {},\n76|\t},\n77|\tStateParked: {\n78|\t\tStateMaterializing: {}, StateRunning: {}, StateStopped: {}, StateStale: {},\n79|\t},\n80|\tStateFailed: {\n81|\t\tStateCreating: {}, StateStopped: {}, StateParked: {},\n82|\t\tStateMaterializing: {}, StateStale: {}, StateTombstoned: {},\n83|\t},\n84|\tStateStale: {\n85|\t\tStateStopped: {}, StateTombstoned: {},\n86|\t},\n87|}\n88|\n89|// initialTargets bounds the first event of a chain: a session opens in\n90|// one of these states, and only through its bootstrap event. Any other\n91|// first event is invalid_state_transition, not a silent default.\n92|var initialTargets = map[State]struct{}{\n93|\tStateCreating: {}, StateRunning: {}, StateIdle: {}, StateFailed: {},\n94|}\n95|\n96|// staleSources bounds the local-stale override the same way the table\n97|// bounds every other move into stale: the override applies only when\n98|// the winner projection stands in a state the table lets go stale,\n99|// otherwise the winner state stands with the lease conflict recorded.\n100|var staleSources = map[State]struct{}{\n101|\tStateRunning: {}, StateIdle: {}, StateQuiescing: {},\n102|\tStateFailed: {}, StateParked: {},\n103|}\n104|\n105|var (\n106|\tErrInvalidRecord     = errors.New(\"invalid session record\")\n107|\tErrInvalidEvent      = errors.New(\"invalid session event\")\n108|\tErrInvalidTransition = errors.New(\"invalid_state_transition\")\n109|\tErrIntegrity         = errors.New(\"integrity_failure\")\n110|\tErrDerivation        = errors.New(\"derivation input is corrupt\")\n111|\tErrUnknownSession    = errors.New(\"unknown session\")\n112|\tErrStaleLease        = errors.New(\"event lease epoch precedes the chain head\")\n113|\tErrDivergentLease    = errors.New(\"divergent lease branch cannot be authoritative\")\n114|)\n115|\n116|// refuse is the single refusal funnel every sessstate rejection flows\n117|// through. It is a var so the census TestMain can wrap it and record\n118|// the production file:line behind each exercised refusal. No production\n119|// path wraps a sentinel with fmt.Errorf directly.\n120|var refuse = func(sentinel error, format string, arguments ...any) error {\n121|\treturn fmt.Errorf(\"%w: %s\", sentinel, fmt.Sprintf(format, arguments...))\n122|}\n123|\n124|// LeaseHead is one observed fencing token: the winning-lease pair\n125|// carried by every owner-authored event and mutation.\n126|type LeaseHead struct {\n127|\tEpoch   uint64\n128|\tLeaseID string\n129|}\n130|\n131|// IsZero reports an unset lease head: no local lease was supplied.\n132|func (head LeaseHead) IsZero() bool {\n133|\treturn head.Epoch == 0 && head.LeaseID == \"\"\n134|}\n135|\n136|// Compare orders two lease heads by the Section 5.3 tuple rule: the\n137|// greatest (epoch, lease_id) wins, where lease_id uses bytewise UUID\n138|// order. Lease IDs are canonical lowercase UUIDv4, so string order is\n139|// bytewise order.\n140|func Compare(a, b LeaseHead) int {\n141|\tif a.Epoch != b.Epoch {\n142|\t\tif a.Epoch < b.Epoch {\n143|\t\t\treturn -1\n144|\t\t}\n145|\t\treturn 1\n146|\t}\n147|\tswitch {\n148|\tcase a.LeaseID < b.LeaseID:\n149|\t\treturn -1\n150|\tcase a.LeaseID > b.LeaseID:\n151|\t\treturn 1\n152|\t}\n153|\treturn 0\n154|}\n155|\n156|// Conflict kinds. A conflict is reported data, never an error: both\n157|// sides were individually admittable, so the projection names the rule\n158|// that resolved them.\n159|const (\n160|\t// ConflictSameEpochTie ResolveRuleGreatestLeaseIDWins: two distinct\n161|\t// leases share the winning epoch (concurrent force takeovers under\n162|\t// partition); the bytewise-greater lease ID wins.\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
