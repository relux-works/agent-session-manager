wire\n126|// requires, so row comparison is element-wise.\n127|var capabilityRegistry = map[string]capabilityRow{\n128|\t\"durable_disconnect\": {\n129|\t\tgenerationVariable:   false,\n130|\t\tdependentOperations:  []string{\"create\", \"status\"},\n131|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n132|\t},\n133|\t\"local_attach\": {\n134|\t\tgenerationVariable:   true,\n135|\t\tdependentOperations:  []string{\"attach\"},\n136|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n137|\t},\n138|\t\"remote_attach\": {\n139|\t\tgenerationVariable:   true,\n140|\t\tdependentOperations:  []string{\"attach\"},\n141|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n142|\t},\n143|\t\"web_attach\": {\n144|\t\tgenerationVariable:   true,\n145|\t\tdependentOperations:  []string{\"attach\"},\n146|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n147|\t},\n148|\t\"multi_attach\": {\n149|\t\tgenerationVariable:   true,\n150|\t\tdependentOperations:  []string{\"attach\"},\n151|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n152|\t},\n153|\t\"headless_creation\": {\n154|\t\tgenerationVariable:   true,\n155|\t\tdependentOperations:  []string{\"create\"},\n156|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n157|\t},\n158|\t\"reboot_restoration\": {\n159|\t\tgenerationVariable:   true,\n160|\t\tdependentOperations:  []string{\"restore\"},\n161|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n162|\t},\n163|\t\"input_quiescence\": {\n164|\t\tgenerationVariable:   true,\n165|\t\tdependentOperations:  []string{\"quiesce-input\"},\n166|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n167|\t},\n168|\t\"safe_boundary_observation\": {\n169|\t\tgenerationVariable:   true,\n170|\t\tdependentOperations:  []string{\"wait-safe-boundary\"},\n171|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n172|\t},\n173|\t\"provider_process_observation\": {\n174|\t\tgenerationVariable:   true,\n175|\t\tdependentOperations:  []string{\"status\", \"terminate-stale\", \"wait-safe-boundary\"},\n176|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n177|\t},\n178|\t\"graceful_stop\": {\n179|\t\tgenerationVariable:   true,\n180|\t\tdependentOperations:  []string{\"request-stop\"},\n181|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n182|\t},\n183|\t\"stale_process_termination\": {\n184|\t\tgenerationVariable:   true,\n185|\t\tdependentOperations:  []string{\"terminate-stale\"},\n186|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n187|\t},\n188|\t\"terminal_state_retention\": {\n189|\t\tgenerationVariable:   true,\n190|\t\tdependentOperations:  []string{\"create\", \"restore\", \"status\"},\n191|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n192|\t},\n193|\t\"scrollback_retention\": {\n194|\t\tgenerationVariable:   true,\n195|\t\tdependentOperations:  []string{\"create\", \"restore\", \"status\"},\n196|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n197|\t},\n198|\t\"credential_capable_execution_realm\": {\n199|\t\tgenerationVariable:  true,\n200|\t\tdependentOperations: []string{\"create\", \"restore\"},\n201|\t\tevidenceRequirements: []string{\n202|\t\t\t\"conformance_fixture\", \"credential_sentinel\", \"provider_auth_smoke\", \"runtime_probe\",\n203|\t\t},\n204|\t},\n205|\t\"multiple_input_clients\": {\n206|\t\tgenerationVariable:   true,\n207|\t\tdependentOperations:  []string{\"attach\"},\n208|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n209|\t},\n210|}\n211|\n212|// credentialRealmCapability is the one capability whose evidence carries the\n213|// terminal-binding, provider, sentinel, and smoke members (§4.D). Every other\n214|// capability's evidence must leave those members null.\n215|const credentialRealmCapability = \"credential_capable_execution_realm\"\n216|\n217|// requirementFact maps every CapabilityEvidenceRequirement to the\n218|// CapabilityEvidenceFact that satisfies it (§4.D). ui_absent and\n219|// prompt_absent are supplementary facts with no requirement mapping: they\n220|// may accompany evidence but never satisfy a requirement alone.\n221|var requirementFact = map[string]string{\n222|\t\"conformance_fixture\":  \"fixture_passed\",\n223|\t\"runtime_probe\":        \"runtime_probe_passed\",\n224|\t\"credential_sentinel\":  \"sentinel_passed\",\n225|\t\"provider_auth_smoke\":  \"provider_auth_passed\",\n226|\t\"policy_authorization\": \"policy_checked\",\n227|}\n228|\n229|// Closed TerminalBackendOperation vocabulary (§4.D).\n230|var operationVocabulary = map[string]bool{\n231|\t\"manifest\": true, \"probe\": true, \"create\": true, \"attach\": true,\n232|\t\"status\": true, \"quiesce-input\": true, \"wait-safe-boundary\": true,\n233|\t\"request-stop\": true, \"terminate-stale\": true, \"restore\": true,\n234|}\n235|\n236|// Closed CapabilityEvidenceRequirement vocabulary (§4.D).\n237|var evidenceRequirementVocabulary = map[string]bool{\n238|\t\"conformance_fixture\": true, \"runtime_probe\": true,\n239|\t\"credential_sentinel\": true, \"provider_auth_smoke\": true,\n240|\t\"policy_authorization\": true,\n241|}\n242|\n243|// Closed CapabilityEvidenceFact vocabulary (§4.D).\n244|var evidenceFactVocabulary = map[string]bool{\n245|\t\"fixture_passed\": true, \"runtime_probe_passed\": true,\n246|\t\"sentinel_passed\": true, \"provider_auth_passed\": true,\n247|\t\"policy_checked\": true, \"ui_absent\": true, \"prompt_absent\": true,\n248|}\n249|\n250|// Document bounds shared by the three closed schemas.\n251|const (\n252|\tmaxClaims          = 16\n253|\tmaxEvidenceIDs     = 256\n254|\tmaxOperations      = 10\n255|\tmaxRequirements    = 5\n256|\tmaxFacts           = 7\n257|\tmaxOpaqueString    = 256\n258|\tmaxJSONDepth       = 32\n259|\tmaxNativeReference = 512\n260|\t// maxIdentityDocumentBytes is the AX omit-self identity bound the\n261|\t// canonical owner enforces before any identity calculation: an\n262|\t// encoded identity object over 5 MiB is refused before decoding,\n263|\t// so this package refuses it at the same gate rather than\n264|\t// admitting through the direct parse entries what the shared\n265|\t// identity entry refuses.\n266|\tmaxIdentityDocumentBytes = 5_242_880\n267|)\n268|\n269|// mismatchf refuses with CodeMismatch and a static detail clause. The clause\n270|// must never interpolate local data: paths, digests, generations, and\n271|// document bytes stay out of errors.\n272|//\n273|//go:noinline\n274|func mismatchf(format string, arguments ...any) *Error {\n(more lines below)","final_result":true}}}
