ent, name)\n553|\tcase \"provider.identified\":\n554|\t\treturn fold.effectProviderIdentified(event, name)\n555|\tcase \"session.idle\":\n556|\t\treturn fold.step(StateIdle, name)\n557|\tcase \"session.quiescing\":\n558|\t\treturn fold.step(StateQuiescing, name)\n559|\tcase \"checkpoint.created\":\n560|\t\treturn fold.effectCheckpointCreated(event, name)\n561|\tcase \"sync.completed\":\n562|\t\treturn nil\n563|\tcase \"session.stopped\":\n564|\t\treturn fold.effectStopped(event, name)\n565|\tcase \"session.resumed\":\n566|\t\treturn fold.effectResumed(event, name)\n567|\tcase \"session.bootstrap_aborted\":\n568|\t\treturn fold.effectBootstrapAborted(event, name)\n569|\tcase \"lease.transferred\", \"lease.forced\":\n570|\t\treturn fold.effectLease(event, lease, name, succession)\n571|\tcase \"session.parked\":\n572|\t\treturn fold.step(StateParked, name)\n573|\tcase \"session.failed\":\n574|\t\treturn fold.step(StateFailed, name)\n575|\tcase \"fork.created\", \"profile.changed\", \"takeover.force_confirmed\",\n576|\t\t\"replica.replace_confirmed\", \"task_board.adopted\",\n577|\t\t\"tombstone.issued\", \"tombstone.resolved\":\n578|\t\treturn nil\n579|\tcase \"session.tombstoned\":\n580|\t\treturn fold.step(StateTombstoned, name)\n581|\tcase \"task_board.launched\":\n582|\t\treturn fold.effectTaskBoardLaunched(event, name)\n583|\tdefault:\n584|\t\treturn nil\n585|\t}\n586|}\n587|\n588|// effectCreated opens the bootstrap, including the Section 5.7\n589|// failed-to-creating retry: epoch 1 under the same winning create\n590|// lease, no validated checkpoint yet, and no authoritative bootstrap\n591|// abort on record. Anything else that reaches for creating refuses.\n592|func (fold *chainFold) effectCreated(event Event, what string) error {\n593|\tif fold.state == \"\" {\n594|\t\treturn fold.step(StateCreating, what)\n595|\t}\n596|\tif fold.state != StateFailed {\n597|\t\treturn fold.step(StateCreating, what)\n598|\t}\n599|\tif event.LeaseEpoch != 1 || event.LeaseID != fold.createLease.LeaseID ||\n600|\t\tevent.LeaseEpoch != fold.createLease.Epoch {\n601|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap under a new lease\", what)\n602|\t}\n603|\tif fold.seenCheckpoint {\n604|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap past a validated checkpoint\", what)\n605|\t}\n606|\tif fold.seenAbort {\n607|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap past an authoritative abort\", what)\n608|\t}\n609|\treturn fold.step(StateCreating, what)\n610|}\n611|\n612|// effectTerminalCreated records the terminal binding; as the first\n613|// event it also opens the bootstrap in creating.\n614|func (fold *chainFold) effectTerminalCreated(event Event, what string) error {\n615|\tif event.SchemaVersion == \"4.0.0\" {\n616|\t\tbinding, err := payloadString(event.Payload, \"terminal_binding_id\")\n617|\t\tif err != nil {\n618|\t\t\treturn err\n619|\t\t}\n620|\t\tif _, err := scalar.ParseDigest(binding); err != nil {\n621|\t\t\treturn refuse(ErrDerivation, \"%s carries malformed terminal_binding_id: %v\", what, err)\n622|\t\t}\n623|\t\tbackend, err := payloadString(event.Payload, \"terminal_backend_id\")\n624|\t\tif err != nil {\n625|\t\t\treturn err\n626|\t\t}\n627|\t\tif _, err := terminalbackend.ParseID(backend); err != nil {\n628|\t\t\treturn refuse(ErrDerivation, \"%s carries refused terminal backend: %v\", what, err)\n629|\t\t}\n630|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, BindingID: binding, EventID: event.ID}\n631|\t} else {\n632|\t\tbackend, err := payloadString(event.Payload, \"backend\")\n633|\t\tif err != nil {\n634|\t\t\treturn err\n635|\t\t}\n636|\t\tif backend != \"tmux\" && backend != \"conpty\" {\n637|\t\t\treturn refuse(ErrDerivation, \"%s carries unknown terminal backend %q\", what, backend)\n638|\t\t}\n639|\t\tterminalID, err := payloadString(event.Payload, \"terminal_id\")\n640|\t\tif err != nil {\n641|\t\t\treturn err\n642|\t\t}\n643|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, TerminalID: terminalID, EventID: event.ID}\n644|\t}\n645|\tfold.projection.HasTerminal = true\n646|\tif fold.state == \"\" {\n647|\t\treturn fold.step(StateCreating, what)\n648|\t}\n649|\treturn nil\n650|}\n651|\n652|// effectProviderLaunched moves to running and records the launched\n653|// version. The record provider stays authoritative: a launched event\n654|// naming another provider records a provider_mismatch conflict under\n655|// the record-pinned-provider-wins rule instead of rewriting identity.\n656|func (fold *chainFold) effectProviderLaunched(event Event, what string) error {\n657|\tproviderID, err := payloadString(event.Payload, \"provider_id\")\n658|\tif err != nil {\n659|\t\treturn err\n660|\t}\n661|\tversion, err := payloadString(event.Payload, \"provider_version\")\n662|\tif err != nil {\n663|\t\treturn err\n664|\t}\n665|\tif providerID != fold.recordProvider {\n666|\t\tfold.conflict(ConflictProviderMismatch, ResolveRuleRecordPinnedProviderWins,\n667|\t\t\t\"event %s launches provider %q under record provider %q; the record value stays authoritative\",\n668|\t\t\tevent.ID, providerID, fold.recordProvider)\n669|\t} else {\n670|\t\tfold.projection.Provider.Version = version\n671|\t}\n672|\treturn fold.step(StateRunning, what)\n673|}\n674|\n675|// effectProviderIdentified records the newest identity record with\n676|// its confidence.\n677|func (fold *chainFold) effectProviderIdentified(event Event, what string) error {\n678|\trecordID, err := payloadString(event.Payload, \"provider_identity_record_id\")\n679|\tif err != nil {\n680|\t\treturn err\n681|\t}\n682|\tif _, err := scalar.ParseDigest(recordID); err != nil {\n683|\t\treturn refuse(ErrDerivation, \"%s carries malformed provider_identity_record_id: %v\", what, err)\n684|\t}\n685|\tconfidence, err := payloadString(event.Payload, \"confidence\")\n686|\tif err != nil {\n687|\t\treturn err\n688|\t}\n689|\tfold.projection.Provider.IdentityRecordID = recordID\n690|\tfold.projection.Provider.Confidence = confidence\n691|\treturn nil\n692|}\n693|\n694|// effectCheckpointCreated records the newest validated checkpoint and\n695|// moves idle or quiescing into checkpointing, or checkpointing back to\n696|// idle at the validated boundary. Any other lifecycle position refuses:\n697|// a checkpoint cannot land while running, creating, stopped, parked,\n698|// failed, stale, materializing, or tombstoned without the quiesce or\n699|// resume the table requires.\n700|func (fold *chainFold) effectCheckpointCreated(event Event, what string) error {\n701|\tcheckpointID, err := payloadString(event.Payload, \"checkpoint_id\")\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
