ids[i].(string) < ids[j].(string) })\n381|\t\t\t\tuniverse.probe[\"evidence_ids\"] = ids\n382|\t\t\t\tuniverse.manifest[\"manifest_id\"] = omitSelfIdentity(t, universe.manifest, \"manifest_id\")\n383|\t\t\t\tuniverse.probe[\"probe_id\"] = omitSelfIdentity(t, universe.probe, \"probe_id\")\n384|\t\t\t},\n385|\t\t\twant:      ActionRefused,\n386|\t\t\twantClass: terminalbackend.CodeCapabilityUnproven,\n387|\t\t},\n388|\t\t{\n389|\t\t\tname: \"refused_fencing_malformed_token\",\n390|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n391|\t\t\t\tinput.Presented.Epoch = 0\n392|\t\t\t},\n393|\t\t\twant:      ActionRefused,\n394|\t\t\twantClass: ClassInvalidArguments,\n395|\t\t},\n396|\t\t{\n397|\t\t\tname: \"refused_fencing_foreign_session\",\n398|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n399|\t\t\t\tinput.Presented.SessionID = fixtureForeign\n400|\t\t\t},\n401|\t\t\twant:      ActionRefused,\n402|\t\t\twantClass: \"lease_conflict\",\n403|\t\t},\n404|\t\t{\n405|\t\t\tname: \"refused_fencing_expired_grant\",\n406|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n407|\t\t\t\tinput.Observation = lapsedObservation(now)\n408|\t\t\t},\n409|\t\t\twant:      ActionRefused,\n410|\t\t\twantClass: \"lease_conflict\",\n411|\t\t},\n412|\t\t{\n413|\t\t\tname: \"refused_provider_tuple_qwen\",\n414|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n415|\t\t\t\tinput.Provider.Build = provhost.BuildTuple{ProviderID: \"qwen\", ProviderVersion: \"1.0.0\", Platform: \"linux\", Architecture: \"amd64\"}\n416|\t\t\t},\n417|\t\t\twant:      ActionRefused,\n418|\t\t\twantClass: \"invalid_config\",\n419|\t\t},\n420|\t\t{\n421|\t\t\tname: \"launch_discovery_bound\",\n422|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n423|\t\t\t\tinput.Provider.HasDiscovery = true\n424|\t\t\t\tinput.Provider.Discovery = []byte(`{\"native_session_id\":\"native-session-alpha\",\"discovered\":true,\"discovery_root\":\"/home