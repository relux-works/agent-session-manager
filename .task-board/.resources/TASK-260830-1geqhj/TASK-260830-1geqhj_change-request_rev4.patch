+			name: "parked_same_epoch_loser",
+			mutate: func(t *testing.T, deps *decideDeps, input *Input) {
+				input.Presented.LeaseID = fixtureLeaseB
+			},
+			want:       ActionParked,
+			wantReason: fencing.ParkStaleOwner,
+			wantLease:  fixtureLeaseA,
