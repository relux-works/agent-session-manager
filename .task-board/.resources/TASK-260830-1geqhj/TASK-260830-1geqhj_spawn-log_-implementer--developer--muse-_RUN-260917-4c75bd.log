"` + seedDigest(0xD1) + `\"}`)\n621|\tinputs := matjournal.CreateInputs{\n622|\t\tMaterializationID:  fixtureMat,\n623|\t\tPrepareOperationID: fixturePrepareOp,\n624|\t\tRequestBody:        request,\n625|\t\tPlanID:             seedDigest(0xD1),\n626|\t\tSourceCheckpointID: seedDigest(0xD2),\n627|\t\tPlan: []matjournal.PlanAuthority{\n628|\t\t\t{ID: \"workspace_relux\", Kind: matjournal.PlanKindWorkspace, Platform: \"linux\", RootPath: \"/home/ivan/work/relux\"},\n629|\t\t},\n630|\t\tHostPlatform: \"linux\",\n631|\t\tExtensions:   map[string]string{},\n632|\t}\n633|\tif _, _, err := store.Create(inputs); err != nil {\n634|\t\tt.Fatalf(\"Create() error = %v\", err)\n635|\t}\n636|\tfor _, phase := range []string{matjournal.PhaseValidating, matjournal.PhasePrepared, matjournal.PhaseCommitting} {\n637|\t\tif _, err := store.Transition(fixtureMat, phase, matjournal.TransitionOpts{}); err != nil {\n638|\t\t\tt.Fatalf(\"Transition(%s) error = %v\", phase, err)\n639|\t\t}\n640|\t}\n641|\trollback := \"/home/ivan/work/relux.prior\"\n642|\tif _, err := store.UpdateAuthority(fixtureMat, \"workspace_relux\", matjournal.AuthorityState{\n643|\t\tRootPath:           \"/home/ivan/work/relux\",\n644|\t\tCompletedSequences: []uint64{1},\n645|\t\tRollbackRoot:       &rollback,\n646|\t\tState:              matjournal.AuthorityPrepared,\n647|\t}); err != nil {\n648|\t\tt.Fatalf(\"UpdateAuthority(prepared) error = %v\", err)\n649|\t}\n650|\tif _, err := store.UpdateAuthority(fixtureMat, \"workspace_relux\", matjournal.AuthorityState{\n651|\t\tRootPath:           \"/home/ivan/work/relux\",\n652|\t\tCompletedSequences: []uint64{1},\n653|\t\tState:              matjournal.AuthorityCommitted,\n654|\t}); err != nil {\n655|\t\tt.Fatalf(\"UpdateAuthority(committed) error = %v\", err)\n656|\t}\n657|\tjournal, err := store.Transition(fixtureMat, matjournal.PhaseCommitted, matjournal.TransitionOpts{})\n658|\tif err != nil {\n659|\t\tt.Fatalf(\"Transition(committed) error = %v\", err)\n660|\t}\n661|\treturn journal\n662|}\n663|\n664|// --- checkpoint fixtures ---\n665|\n666|// checkpointFixture captures a direct checkpoint over the chain\n667|// fixture heads and returns its digest and bytes.\n668|func checkpointFixture(t *testing.T, repository *sessrepo.Repository, store *sessckpt.Store, heads []string) (string, []byte) {\n669|\tt.Helper()\n670|\treference, raw, err := store.Capture(repository, sessckpt.Inputs{\n671|\t\tOperationID:         fixtureBootstrap,\n672|\t\tSessionID:           fixtureSession,\n673|\t\tSessionKind:         sessckpt.SessionKindDirect,\n674|\t\tLeaseEpoch:          1,\n675|\t\tLeaseID:             fixtureLeaseA,\n676|\t\tCreatorHostID:       fixtureLocalHost,\n677|\t\tWorkspaceManifestID: seedDigest(0xE1),\n678|\t\tProviderManifestID:  seedDigest(0xE2),\n679|\t\tBoundary: sessckpt.SafeBoundary{\n680|\t\t\tProviderID:          \"codex\",\n681|\t\t\tProviderVersion:     \"0.147.0\",\n682|\t\t\tEvidence:            sessckpt.EvidenceAcceptedTest,\n683|\t\t\tInputBlocked:        true,\n684|\t\t\tForegroundIdle:      true,\n685|\t\t\tBackgroundIdle:      true,\n686|\t\t\tOpenProcesses:       0,\n687|\t\t\tOpenDatabaseHandles: 0,\n688|\t\t},\n689|\t\tEventHeads: heads,\n690|\t\tCreatedAt:  fixtureCreatedAt,\n691|\t\tExtensions: map[string]string{},\n692|\t})\n693|\tif err != nil {\n694|\t\tt.Fatalf(\"Capture() error = %v\", err)\n695|\t}\n696|\treturn reference.CheckpointID, raw\n697|}\n698|\n699|var errFixtureConfig = errors.New(\"fixture configuration is invalid\")","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
