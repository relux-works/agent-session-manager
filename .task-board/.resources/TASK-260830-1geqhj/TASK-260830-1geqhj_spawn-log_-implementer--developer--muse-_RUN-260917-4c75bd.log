{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb09","stream":{"kind":"session","id":"01a0b131-d4f6-7b82-a7a6-5363cf3ac7fb"},"sequence":991,"recorded_at":1780531400001977,"record_type":"event","durability":"durable","causation_id":"2237b1e3-856b-4a22-9f46-61adba667efd","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2237b1e3-856b-4a22-9f46-61adba667efd","run_stream":{"kind":"run","id":"2237b1e3-856b-4a22-9f46-61adba667efd"},"task_stream":{"kind":"task","id":"01a0b136-ee8e-7b80-b569-76c1c1821fe7"},"task_id":"01a0b136-ee8e-7b80-b569-76c1c1821fe7","event":{"kind":"output","task_id":"01a0b136-ee8e-7b80-b569-76c1c1821fe7","chunk":"Read text file `internal/axpane/sync.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"os\"\n6|\t\"runtime\"\n7|)\n8|\n9|// syncDirectory fsyncs a directory so an install inside it survives\n10|// a crash. Opening a directory fails on Windows, where the install\n11|// itself is the durability boundary; there the sync is skipped,\n12|// never faked. This mirrors the landed matjournal discipline.\n13|func syncDirectory(path string) error {\n14|\tif runtime.GOOS == \"windows\" {\n15|\t\treturn nil\n16|\t}\n17|\tdirectory, err := os.Open(path)\n18|\tif err != nil {\n19|\t\treturn fmt.Errorf(\"open directory for fsync: %w\", err)\n20|\t}\n21|\tdefer func() { _ = directory.Close() }()\n22|\tif err := directory.Sync(); err != nil {\n23|\t\treturn fmt.Errorf(\"fsync directory: %w\", err)\n24|\t}\n25|\treturn nil\n26|}","final_result":true}}}
