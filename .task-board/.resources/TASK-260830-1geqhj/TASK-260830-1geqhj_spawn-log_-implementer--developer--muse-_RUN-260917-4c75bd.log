{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9e1","stream":{"kind":"session","id":"01a0b131-d4f6-7b82-a7a6-5363cf3ac7fb"},"sequence":843,"recorded_at":1780531400001681,"record_type":"event","durability":"durable","causation_id":"2237b1e3-856b-4a22-9f46-61adba667efd","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2237b1e3-856b-4a22-9f46-61adba667efd","run_stream":{"kind":"run","id":"2237b1e3-856b-4a22-9f46-61adba667efd"},"task_stream":{"kind":"task","id":"01a0b135-28e6-76c3-a47f-1465ecdf1550"},"task_id":"01a0b135-28e6-76c3-a47f-1465ecdf1550","event":{"kind":"output","task_id":"01a0b135-28e6-76c3-a47f-1465ecdf1550","chunk":"Read text file `internal/axpane/binding.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"crypto/sha256\"\n6|\t\"encoding/hex\"\n7|\t\"encoding/json\"\n8|\t\"errors\"\n9|\t\"fmt\"\n10|\t\"os\"\n11|\t\"path/filepath\"\n12|\t\"time\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n16|)\n17|\n18|// Binding schema identity. This is an AX-internal host-local durable\n19|// record (the §4.E host-local durable metadata class: the\n20|// idempotency receipt for the bootstrap window), not a replicated\n21|// contract: it is never published to the mesh and never leaves the\n22|// host.\n23|const (\n24|\tbindingSchema        = \"urn:ax:schema:pane-bootstrap-binding\"\n25|\tbindingSchemaVersion = \"1.0.0\"\n26|)\n27|\n28|// Binding is the one recorded wrapper/child for a\n29|// (session_id, bootstrap_operation_id) pair. Identity is the\n30|// AX-allocated terminal instance UUIDv7 plus the binding digest; a\n31|// PID, handle, socket, path, or endpoint is never identity and never\n32|// persisted here.\n33|type Binding struct {\n34|\tSessionID          string `json:\"session_id\"`\n35|\tOperationID        string `json:\"bootstrap_operation_id\"`\n36|\tTerminalInstanceID string `json:\"terminal_instance_id\"`\n37|\tBindingDigest      string `json:\"binding_digest\"`\n38|\tCreatedAt          string `json:\"created_at\"`\n39|}\n40|\n41|// bindingMembers is the exact closed member set of the stored\n42|// document.\n43|var bindingMembers = []string{\n44|\t\"schema\",\n45|\t\"schema_version\",\n46|\t\"session_id\",\n47|\t\"bootstrap_operation_id\",\n48|\t\"terminal_instance_id\",\n49|\t\"binding_digest\",\n50|\t\"created_at\",\n51|}\n52|\n53|// Hooks arms the crash boundaries of Bind: after the receipt bytes\n54|// are staged to the temporary file (before the atomic install), and\n55|// after the install commits (before the directory sync makes the\n56|// commit durable). A nil hook is a no-op; a hook error aborts Bind\n57|// with that error and installs nothing further.\n58|type Hooks struct {\n59|\tAfterStage   func(path string) error\n60|\tAfterInstall func(path string) error\n61|}\n62|\n63|// Store is the durable bootstrap binding store rooted at one data\n64|// directory. Bindings live under\n65|// <root>/axpane/bootstrap/<session_id>/binding.json.\n66|type Store struct {\n67|\troot  string\n68|\thooks *Hooks\n69|\tnow   func() time.Time\n70|}\n71|\n72|// Open creates the store, ensuring the root exists. It creates no\n73|// session directories: those appear with the first Bind.\n74|func Open(root string) (*Store, error) {\n75|\tif root == \"\" {\n76|\t\treturn nil, errors.New(\"axpane bootstrap store root is empty\")\n77|\t}\n78|\tbase := filepath.Join(root, \"axpane\", \"bootstrap\")\n79|\tif err := os.MkdirAll(base, 0o755); err != nil {\n80|\t\treturn nil, fmt.Errorf(\"create axpane bootstrap root: %w\", err)\n81|\t}\n82|\treturn &Store{root: root, now: time.Now}, nil\n83|}\n84|\n85|// WithHooks returns the store with crash hooks armed. It mutates the\n86|// receiver and returns it for call chaining.\n87|func (store *Store) WithHooks(hooks *Hooks) *Store {\n88|\tstore.hooks = hooks\n89|\treturn store\n90|}\n91|\n92|func (store *Store) sessionDir(sessionID string) string {\n93|\treturn filepath.Join(store.root, \"axpane\", \"bootstrap\", sessionID)\n94|}\n95|\n96|func (store *Store) bindingPath(sessionID string) string {\n97|\treturn filepath.Join(store.sessionDir(sessionID), \"binding.json\")\n98|}\n99|\n100|// Bind durably binds (session_id, bootstrap_operation_id) to the one\n101|// recorded wrapper/child before any launch side effect. The first\n102|// call for a session installs the candidate receipt; an identical\n103|// retry returns the stored receipt with reattached true; a changed\n104|// operation refuses idempotency_mismatch while the bootstrap window\n105|// is open. After the window closes (the winner carries a\n106|// checkpoint) a new operation supersedes through Supersede, never\n107|// through this no-replace entry. The candidate's session and\n108|// operation must equal the call arguments; its instance ID and\n109|// binding digest are validated, and the store stamps created_at at\n110|// install. The stored receipt is authoritative on retry: a retry\n111|// carrying different child facts still reattaches to the one\n112|// recorded child, never to a second child. Stale staging files\n113|// from a pre-commit crash are swept before the install.\n114|func (store *Store) Bind(sessionID, operationID string, candidate Binding) (Binding, bool, error) {\n115|\tempty := Binding{}\n116|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n117|\t\treturn empty, false, fmt.Errorf(\"bind session %q is not a UUIDv7: %w\", sessionID, err)\n118|\t}\n119|\tif _, err := scalar.ParseUUIDv7(operationID); err != nil {\n120|\t\treturn empty, false, fmt.Errorf(\"bind operation %q is not a UUIDv7: %w\", operationID, err)\n121|\t}\n122|\tif candidate.SessionID != sessionID || candidate.OperationID != operationID {\n123|\t\treturn empty, false, fmt.Errorf(\"bind candidate names another bootstrap pair\")\n124|\t}\n125|\tif err := checkBindingCandidate(candidate); err != nil {\n126|\t\treturn empty, false, err\n127|\t}\n128|\texisting, found, err := store.Status(sessionID)\n129|\tif err != nil {\n130|\t\treturn empty, false, err\n131|\t}\n132|\tif found {\n133|\t\tif existing.OperationID != operationID {\n134|\t\t\treturn empty, false, &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \"bootstrap binding\"}\n135|\t\t}\n136|\t\treturn existing, true, nil\n137|\t}\n138|\treceipt, err := encodeBinding(candidate, store.timestamp())\n139|\tif err != nil {\n140|\t\treturn empty, false, err\n141|\t}\n142|\tif err := store.install(sessionID, operationID, receipt); err != nil {\n143|\t\tvar concurrent errConcurrentWinner\n144|\t\tif errors.As(err, &concurrent) {\n145|\t\t\treturn concurrent.bound, true, nil\n146|\t\t}\n147|\t\treturn empty, false, err\n148|\t}\n149|\tstored, found, err := store.Status(sessionID)\n150|\tif err != nil {\n151|\t\treturn empty, false, err\n152|\t}\n153|\tif !found {\n154|\t\treturn empty, false, errors.New(\"bootstrap binding vanished after install\")\n155|\t}\n156|\treturn stored, false, nil\n157|}\n158|\n159|// Status proves absence or identifies the one recorded\n160|// wrapper/child: found is true with the stored receipt, or false\n161|// when no binding exists. A read or validation failure is an error,\n162|// never absence: unknown is not absent.\n163|func (store *Store) Status(sessionID string) (Binding, bool, error) {\n164|\tempty := Binding{}\n165|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n166|\t\treturn empty, false, fmt.Errorf(\"binding status session %q is not a UUIDv7: %w\", sessionID, err)\n167|\t}\n168|\traw, err := os.ReadFile(store.bindingPath(sessionID))\n169|\tif err != nil {\n170|\t\tif errors.Is(err, os.ErrNotExist) {\n171|\t\t\treturn empty, false, nil\n172|\t\t}\n173|\t\treturn empty, false, fmt.Errorf(\"read bootstrap binding: %w\", err)\n174|\t}\n175|\tbinding, err := decodeBinding(raw)\n176|\tif err != nil {\n177|\t\treturn empty, false, err\n178|\t}\n179|\tif binding.SessionID != sessionID {\n180|\t\treturn empty, false, errors.New(\"bootstrap binding names another session\")\n181|\t}\n182|\treturn binding, true, nil\n183|}\n184|\n185|func (store *Store) timestamp() string {\n186|\tnow := time.Now().UTC()\n187|\tif store.now != nil {\n188|\t\tnow = store.now().UTC()\n189|\t}\n190|\treturn now.Format(\"2006-01-02T15:04:05.000Z07:00\")\n191|}\n192|\n193|// install stages the receipt to a same-directory temporary file,\n194|// fsyncs it, atomically links it to the binding path (which must\n195|// not exist: the link is the no-replace commit), removes the\n196|// staging name, and fsyncs the directory. Readers see absence or\n197|// the complete receipt, never a torn prefix: a crash before the\n198|// link leaves only ignored staging garbage, and a crash after it\n199|// leaves the complete binding the identical retry reattaches to.\n200|// Any pre-existing binding refuses without replacement.\n201|// errConcurrentWinner carries the winning receipt when a concurrent\n202|// wrapper commits first: the loser reattaches instead of failing.\n203|type errConcurrentWinner struct {\n204|\tbound Binding\n205|}\n206|\n207|func (err errConcurrentWinner) Error() string {\n208|\treturn \"bootstrap binding concurrently committed by another wrapper\"\n209|}\n210|\n211|// Supersede durably replaces the bootstrap binding after the\n212|// window closed: the caller proved (through the winner's checkpoint)\n213|// that a new bootstrap operation is legitimate, and the store\n214|// atomically installs the new receipt over the old one. The commit\n215|// is a staged fsync plus an atomic rename, so readers see the old\n216|// complete receipt or the new complete receipt, never a torn\n217|// prefix. A crash before the rename leaves the old binding with\n218|// ignored staging garbage the retry sweeps; a crash after it leaves\n219|// the new binding the identical retry reattaches to. Supersede\n220|// refuses malformed candidates exactly like Bind.\n221|func (store *Store) Supersede(sessionID, operationID string, candidate Binding) (Binding, error) {\n222|\tempty := Binding{}\n223|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n224|\t\treturn empty, fmt.Errorf(\"bind session %q is not a UUIDv7: %w\", sessionID, err)\n225|\t}\n226|\tif _, err := scalar.ParseUUIDv7(operationID); err != nil {\n227|\t\treturn empty, fmt.Errorf(\"bind operation %q is not a UUIDv7: %w\", operationID, err)\n228|\t}\n229|\tif candidate.SessionID != sessionID || candidate.OperationID != operationID {\n230|\t\treturn empty, fmt.Errorf(\"bind candidate names another bootstrap pair\")\n231|\t}\n232|\tif err := checkBindingCandidate(candidate); err != nil {\n233|\t\treturn empty, err\n234|\t}\n235|\treceipt, err := encodeBinding(candidate, store.timestamp())\n236|\tif err != nil {\n237|\t\treturn empty, err\n238|\t}\n239|\tif err := store.replace(sessionID, receipt); err != nil {\n240|\t\treturn empty, err\n241|\t}\n242|\tstored, found, err := store.Status(sessionID)\n243|\tif err != nil {\n244|\t\treturn empty, err\n245|\t}\n246|\tif !found {\n247|\t\treturn empty, errors.New(\"bootstrap binding vanished after install\")\n248|\t}\n249|\tif stored.OperationID != operationID {\n250|\t\treturn empty, errors.New(\"bootstrap binding names another operation after supersede\")\n251|\t}\n252|\treturn stored, nil\n253|}\n254|\n255|// replace stages the receipt and atomically renames it over the\n256|// binding path: the post-window commit. Staging garbage from a\n257|// pre-commit crash is swept first.\n258|func (store *Store) replace(sessionID string, receipt []byte) error {\n259|\tdir := store.sessionDir(sessionID)\n260|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n261|\t\treturn fmt.Errorf(\"create bootstrap session directory: %w\", err)\n262|\t}\n263|\tsweepStaging(dir)\n264|\ttarget := store.bindingPath(sessionID)\n265|\tstaged, err := os.CreateTemp(dir, \"binding-*.tmp\")\n266|\tif err != nil {\n267|\t\treturn fmt.Errorf(\"stage bootstrap binding: %w\", err)\n268|\t}\n269|\tstagedPath := staged.Name()\n270|\tdefer func() { _ = os.Remove(stagedPath) }()\n271|\tif err := staged.Chmod(0o600); err != nil {\n272|\t\t_ = staged.Close()\n273|\t\treturn fmt.Errorf(\"protect bootstrap binding: %w\", err)\n274|\t}\n275|\tif _, err := staged.Write(receipt); err != nil {\n276|\t\t_ = staged.Close()\n277|\t\treturn fmt.Errorf(\"write bootstrap binding: %w\", err)\n278|\t}\n279|\tif err := staged.Sync(); err != nil {\n280|\t\t_ = staged.Close()\n281|\t\treturn fmt.Errorf(\"sync bootstrap binding: %w\", err)\n282|\t}\n283|\tif err := staged.Close(); err != nil {\n284|\t\treturn fmt.Errorf(\"close bootstrap binding: %w\", err)\n285|\t}\n286|\tif store.hooks != nil && store.hooks.AfterStage != nil {\n287|\t\tif err := store.hooks.AfterStage(stagedPath); err != nil {\n288|\t\t\treturn err\n289|\t\t}\n290|\t}\n291|\tif err := os.Rename(stagedPath, target); err != nil {\n292|\t\treturn fmt.Errorf(\"install bootstrap binding: %w\", err)\n293|\t}\n294|\tif store.hooks != nil && store.hooks.AfterInstall != nil {\n295|\t\tif err := store.hooks.AfterInstall(target); err != nil {\n296|\t\t\treturn err\n297|\t\t}\n298|\t}\n299|\tif err := syncDirectory(dir); err != nil {\n300|\t\treturn err\n301|\t}\n302|\treturn nil\n303|}\n304|\n305|// sweepStaging removes stale binding-*.tmp files left by a\n306|// pre-commit crash. Only files older than a minute are removed: a\n307|// concurrent live wrapper stages under the same pattern, and an\n308|// age gate keeps the sweep from deleting its in-flight receipt. It\n309|// is best-effort: a sweep failure never fails the binding, and\n310|// only the staging pattern is removed.\n311|func sweepStaging(dir string) {\n312|\tmatches, err := filepath.Glob(filepath.Join(dir, \"binding-*.tmp\"))\n313|\tif err != nil {\n314|\t\treturn\n315|\t}\n316|\tcutoff := time.Now().Add(-time.Minute)\n317|\tfor _, match := range matches {\n318|\t\tinfo, err := os.Stat(match)\n319|\t\tif err != nil {\n320|\t\t\tcontinue\n321|\t\t}\n322|\t\tif info.ModTime().After(cutoff) {\n323|\t\t\tcontinue\n324|\t\t}\n325|\t\t_ = os.Remove(match)\n326|\t}\n327|}\n328|\n329|func (store *Store) install(sessionID, operationID string, receipt []byte) error {\n330|\tdir := store.sessionDir(sessionID)\n331|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n332|\t\treturn fmt.Errorf(\"create bootstrap session directory: %w\", err)\n333|\t}\n334|\tsweepStaging(dir)\n335|\ttarget := store.bindingPath(sessionID)\n336|\tstaged, err := os.CreateTemp(dir, \"binding-*.tmp\")\n337|\tif err != nil {\n338|\t\treturn fmt.Errorf(\"stage bootstrap binding: %w\", err)\n339|\t}\n340|\tstagedPath := staged.Name()\n341|\tdefer func() { _ = os.Remove(stagedPath) }()\n342|\tif err := staged.Chmod(0o600); err != nil {\n343|\t\t_ = staged.Close()\n344|\t\treturn fmt.Errorf(\"protect bootstrap binding: %w\", err)\n345|\t}\n346|\tif _, err := staged.Write(receipt); err != nil {\n347|\t\t_ = staged.Close()\n348|\t\treturn fmt.Errorf(\"write bootstrap binding: %w\", err)\n349|\t}\n350|\tif err := staged.Sync(); err != nil {\n351|\t\t_ = staged.Close()\n352|\t\treturn fmt.Errorf(\"sync bootstrap binding: %w\", err)\n353|\t}\n354|\tif err := staged.Close(); err != nil {\n355|\t\treturn fmt.Errorf(\"close bootstrap binding: %w\", err)\n356|\t}\n357|\tif store.hooks != nil && store.hooks.AfterStage != nil {\n358|\t\tif err := store.hooks.AfterStage(stagedPath); err != nil {\n359|\t\t\treturn err\n360|\t\t}\n361|\t}\n362|\tif err := os.Link(stagedPath, target); err != nil {\n363|\t\tif errors.Is(err, os.ErrExist) {\n364|\t\t\t// A concurrent wrapper won the commit between our\n365|\t\t\t// Status and our link: re-read the winner. The\n366|\t\t\t// same operation reattaches to it; a changed\n367|\t\t\t// operation is the bootstrap-window mismatch.\n368|\t\t\twinner, found, readErr := store.Status(sessionID)\n369|\t\t\tif readErr != nil {\n370|\t\t\t\treturn readErr\n371|\t\t\t}\n372|\t\t\tif !found {\n373|\t\t\t\treturn &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \"bootstrap binding\"}\n374|\t\t\t}\n375|\t\t\tif winner.OperationID != operationID {\n376|\t\t\t\treturn &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \"bootstrap binding\"}\n377|\t\t\t}\n378|\t\t\treturn errConcurrentWinner{bound: winner}\n379|\t\t}\n380|\t\treturn fmt.Errorf(\"install bootstrap binding: %w\", err)\n381|\t}\n382|\t_ = os.Remove(stagedPath)\n383|\tif store.hooks != nil && store.hooks.AfterInstall != nil {\n384|\t\tif err := store.hooks.AfterInstall(target); err != nil {\n385|\t\t\treturn err\n386|\t\t}\n387|\t}\n388|\tif err := syncDirectory(dir); err != nil {\n389|\t\treturn err\n390|\t}\n391|\treturn nil\n392|}\n393|\n394|func checkBindingCandidate(candidate Binding) error {\n395|\tif _, err := scalar.ParseUUIDv7(candidate.SessionID); err != nil {\n396|\t\treturn fmt.Errorf(\"binding session %q is not a UUIDv7: %w\", candidate.SessionID, err)\n397|\t}\n398|\tif _, err := scalar.ParseUUIDv7(candidate.OperationID); err != nil {\n399|\t\treturn fmt.Errorf(\"binding operation %q is not a UUIDv7: %w\", candidate.OperationID, err)\n400|\t}\n401|\tif _, err := scalar.ParseUUIDv7(candidate.TerminalInstanceID); err != nil {\n402|\t\treturn fmt.Errorf(\"binding terminal instance %q is not a UUIDv7: %w\", candidate.TerminalInstanceID, err)\n403|\t}\n404|\tif _, err := scalar.ParseDigest(candidate.BindingDigest); err != nil {\n405|\t\treturn fmt.Errorf(\"binding digest is not a digest: %w\", err)\n406|\t}\n407|\t// The candidate carries no timestamp: the store stamps\n408|\t// created_at at install, so a caller clock never enters the\n409|\t// receipt. Stored receipts validate their stamp at decode.\n410|\treturn nil\n411|}\n412|\n413|func encodeBinding(candidate Binding, createdAt string) ([]byte, error) {\n414|\tstored := candidate\n415|\tstored.CreatedAt = createdAt\n416|\tdocument := map[string]string{\n417|\t\t\"schema\":                 bindingSchema,\n418|\t\t\"schema_version\":         bindingSchemaVersion,\n419|\t\t\"session_id\":             stored.SessionID,\n420|\t\t\"bootstrap_operation_id\": stored.OperationID,\n421|\t\t\"terminal_instance_id\":   stored.TerminalInstanceID,\n422|\t\t\"binding_digest\":         stored.BindingDigest,\n423|\t\t\"created_at\":             stored.CreatedAt,\n424|\t}\n425|\traw, err := json.Marshal(document)\n426|\tif err != nil {\n427|\t\treturn nil, fmt.Errorf(\"encode bootstrap binding: %w\", err)\n428|\t}\n429|\treturn raw, nil\n430|}\n431|\n432|func decodeBinding(raw []byte) (Binding, error) {\n433|\tempty := Binding{}\n434|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n435|\tdecoder.DisallowUnknownFields()\n436|\tvar document struct {\n437|\t\tSchema             string `json:\"schema\"`\n438|\t\tSchemaVersion      string `json:\"schema_version\"`\n439|\t\tSessionID          string `json:\"session_id\"`\n440|\t\tOperationID        string `json:\"bootstrap_operation_id\"`\n441|\t\tTerminalInstanceID string `json:\"terminal_instance_id\"`\n442|\t\tBindingDigest      string `json:\"binding_digest\"`\n443|\t\tCreatedAt          string `json:\"created_at\"`\n444|\t}\n445|\tif err := decoder.Decode(&document); err != nil {\n446|\t\treturn empty, fmt.Errorf(\"bootstrap binding is not the closed shape: %w\", err)\n447|\t}\n448|\tif decoder.More() {\n449|\t\treturn empty, fmt.Errorf(\"bootstrap binding carries trailing data\")\n450|\t}\n451|\tvar members map[string]json.RawMessage\n452|\tif err := json.Unmarshal(raw, &members); err != nil {\n453|\t\treturn empty, fmt.Errorf(\"bootstrap binding is not an object: %w\", err)\n454|\t}\n455|\tfor _, name := range bindingMembers {\n456|\t\tif _, ok := members[name]; !ok {\n457|\t\t\treturn empty, fmt.Errorf(\"bootstrap binding misses required member %q\", name)\n458|\t\t}\n459|\t}\n460|\tif document.Schema != bindingSchema || document.SchemaVersion != bindingSchemaVersion {\n461|\t\treturn empty, fmt.Errorf(\"bootstrap binding schema is not %s %s\", bindingSchema, bindingSchemaVersion)\n462|\t}\n463|\tbinding := Binding{\n464|\t\tSessionID:          document.SessionID,\n465|\t\tOperationID:        document.OperationID,\n466|\t\tTerminalInstanceID: document.TerminalInstanceID,\n467|\t\tBindingDigest:      document.BindingDigest,\n468|\t\tCreatedAt:          document.CreatedAt,\n469|\t}\n470|\tif err := checkBindingCandidate(binding); err != nil {\n471|\t\treturn empty, err\n472|\t}\n473|\tif _, err := scalar.ParseTimestamp(binding.CreatedAt); err != nil {\n474|\t\treturn empty, fmt.Errorf(\"binding timestamp is not a timestamp: %w\", err)\n475|\t}\n476|\treturn binding, nil\n477|}\n478|\n479|// BindingDigest computes the opaque binding digest over the canonical\n480|// receipt bytes: the value a §7.A descriptor carries as\n481|// terminal_binding_id. It reveals no generation, PID, or native\n482|// reference.\n483|func BindingDigest(binding Binding) string {\n484|\tsum := sha256.Sum256([]byte(binding.SessionID + \"\\x00\" + binding.OperationID + \"\\x00\" + binding.TerminalInstanceID))\n485|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n486|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9e3","stream":{"kind":"session","id":"01a0b131-d4f6-7b82-a7a6-5363cf3ac7fb"},"sequence":844,"recorded_at":1780531400001683,"record_type":"event","durability":"durable","causation_id":"2237b1e3-856b-4a22-9f46-61adba667efd","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2237b1e3-856b-4a22-9f46-61adba667efd","run_stream":{"kind":"run","id":"2237b1e3-856b-4a22-9f46-61adba667efd"},"task_stream":{"kind":"task","id":"01a0b135-28e6-76c3-a47f-1465ecdf1550"},"task_id":"01a0b135-28e6-76c3-a47f-1465ecdf1550","event":{"kind":"completed","task_id":"01a0b135-28e6-76c3-a47f-1465ecdf1550"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9e5","stream":{"kind":"session","id":"01a0b131-d4f6-7b82-a7a6-5363cf3ac7fb"},"sequence":845,"recorded_at":1780531400001685,"record_type":"event","durability":"durable","causation_id":"2237b1e3-856b-4a22-9f46-61adba667efd","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"2237b1e3-856b-4a22-9f46-61adba667efd","run_stream":{"kind":"run","id":"2237b1e3-856b-4a22-9f46-61adba667efd"},"call_id":"call_01a0b135262270d3a560da6cd4ec36cd","text":"Read text file `internal/axpane/binding.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"crypto/sha256\"\n6|\t\"encoding/hex\"\n7|\t\"encoding/json\"\n8|\t\"errors\"\n9|\t\"fmt\"\n10|\t\"os\"\n11|\t\"path/filepath\"\n12|\t\"time\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n16|)\n17|\n18|// Binding schema identity. This is an AX-internal host-local durable\n19|// record (the §4.E host-local durable metadata class: the\n20|// idempotency receipt for the bootstrap window), not a replicated\n21|// contract: it is never published to the mesh and never leaves the\n22|// host.\n23|const (\n24|\tbindingSchema        = \"urn:ax:schema:pane-bootstrap-binding\"\n25|\tbindingSchemaVersion = \"1.0.0\"\n26|)\n27|\n28|// Binding is the one recorded wrapper/child for a\n29|// (session_id, bootstrap_operation_id) pair. Identity is the\n30|// AX-allocated terminal instance UUIDv7 plus the binding digest; a\n31|// PID, handle, socket, path, or endpoint is never identity and never\n32|// persisted here.\n33|type Binding struct {\n34|\tSessionID          string `json:\"session_id\"`\n35|\tOperationID        string `json:\"bootstrap_operation_id\"`\n36|\tTerminalInstanceID string `json:\"terminal_instance_id\"`\n37|\tBindingDigest      string `json:\"binding_digest\"`\n38|\tCreatedAt          string `json:\"created_at\"`\n39|}\n40|\n41|// bindingMembers is the exact closed member set of the stored\n42|// document.\n43|var bindingMembers = []string{\n44|\t\"schema\",\n45|\t\"schema_version\",\n46|\t\"session_id\",\n47|\t\"bootstrap_operation_id\",\n48|\t\"terminal_instance_id\",\n49|\t\"binding_digest\",\n50|\t\"created_at\",\n51|}\n52|\n53|// Hooks arms the crash boundaries of Bind: after the receipt bytes\n54|// are staged to the temporary file (before the atomic install), and\n55|// after the install commits (before the directory sync makes the\n56|// commit durable). A nil hook is a no-op; a hook error aborts Bind\n57|// with that error and installs nothing further.\n58|type Hooks struct {\n59|\tAfterStage   func(path string) error\n60|\tAfterInstall func(path string) error\n61|}\n62|\n63|// Store is the durable bootstrap binding store rooted at one data\n64|// directory. Bindings live under\n65|// <root>/axpane/bootstrap/<session_id>/binding.json.\n66|type Store struct {\n67|\troot  string\n68|\thooks *Hooks\n69|\tnow   func() time.Time\n70|}\n71|\n72|// Open creates the store, ensuring the root exists. It creates no\n73|// session directories: those appear with the first Bind.\n74|func Open(root string) (*Store, error) {\n75|\tif root == \"\" {\n76|\t\treturn nil, errors.New(\"axpane bootstrap store root is empty\")\n77|\t}\n78|\tbase := filepath.Join(root, \"axpane\", \"bootstrap\")\n79|\tif err := os.MkdirAll(base, 0o755); err != nil {\n80|\t\treturn nil, fmt.Errorf(\"create axpane bootstrap root: %w\", err)\n81|\t}\n82|\treturn &Store{root: root, now: time.Now}, nil\n83|}\n84|\n85|// WithHooks returns the store with crash hooks armed. It mutates the\n86|// receiver and returns it for call chaining.\n87|func (store *Store) WithHooks(hooks *Hooks) *Store {\n88|\tstore.hooks = hooks\n89|\treturn store\n90|}\n91|\n92|func (store *Store) sessionDir(sessionID string) string {\n93|\treturn filepath.Join(store.root, \"axpane\", \"bootstrap\", sessionID)\n94|}\n95|\n96|func (store *Store) bindingPath(sessionID string) string {\n97|\treturn filepath.Join(store.sessionDir(sessionID), \"binding.json\")\n98|}\n99|\n100|// Bind durably binds (session_id, bootstrap_operation_id) to the one\n101|// recorded wrapper/child before any launch side effect. The first\n102|// call for a session installs the candidate receipt; an identical\n103|// retry returns the stored receipt with reattached true; a changed\n104|// operation refuses idempotency_mismatch while the bootstrap window\n105|// is open. After the window closes (the winner carries a\n106|// checkpoint) a new operation supersedes through Supersede, never\n107|// through this no-replace entry. The candidate's session and\n108|// operation must equal the call arguments; its instance ID and\n109|// binding digest are validated, and the store stamps created_at at\n110|// install. The stored receipt is authoritative on retry: a retry\n111|// carrying different child facts still reattaches to the one\n112|// recorded child, never to a second child. Stale staging files\n113|// from a pre-commit crash are swept before the install.\n114|func (store *Store) Bind(sessionID, operationID string, candidate Binding) (Binding, bool, error) {\n115|\tempty := Binding{}\n116|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n117|\t\treturn empty, false, fmt.Errorf(\"bind session %q is not a UUIDv7: %w\", sessionID, err)\n118|\t}\n119|\tif _, err := scalar.ParseUUIDv7(operationID); err != nil {\n120|\t\treturn empty, false, fmt.Errorf(\"bind operation %q is not a UUIDv7: %w\", operationID, err)\n121|\t}\n122|\tif candidate.SessionID != sessionID || candidate.OperationID != operationID {\n123|\t\treturn empty, false, fmt.Errorf(\"bind candidate names another bootstrap pair\")\n124|\t}\n125|\tif err := checkBindingCandidate(candidate); err != nil {\n126|\t\treturn empty, false, err\n127|\t}\n128|\texisting, found, err := store.Status(sessionID)\n129|\tif err != nil {\n130|\t\treturn empty, false, err\n131|\t}\n132|\tif found {\n133|\t\tif existing.OperationID != operationID {\n134|\t\t\treturn empty, false, &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \"bootstrap binding\"}\n135|\t\t}\n136|\t\treturn existing, true, nil\n137|\t}\n138|\treceipt, err := encodeBinding(candidate, store.timestamp())\n139|\tif err != nil {\n140|\t\treturn empty, false, err\n141|\t}\n142|\tif err := store.install(sessionID, operationID, receipt); err != nil {\n143|\t\tvar concurrent errConcurrentWinner\n144|\t\tif errors.As(err, &concurrent) {\n145|\t\t\treturn concurrent.bound, true, nil\n146|\t\t}\n147|\t\treturn empty, false, err\n148|\t}\n149|\tstored, found, err := store.Status(sessionID)\n150|\tif err != nil {\n151|\t\treturn empty, false, err\n152|\t}\n153|\tif !found {\n154|\t\treturn empty, false, errors.New(\"bootstrap binding vanished after install\")\n155|\t}\n156|\treturn stored, false, nil\n157|}\n158|\n159|// Status proves absence or identifies the one recorded\n160|// wrapper/child: found is true with the stored receipt, or false\n161|// when no binding exists. A read or validation failure is an error,\n162|// never absence: unknown is not absent.\n163|func (store *Store) Status(sessionID string) (Binding, bool, error) {\n164|\tempty := Binding{}\n165|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n166|\t\treturn empty, false, fmt.Errorf(\"binding status session %q is not a UUIDv7: %w\", sessionID, err)\n167|\t}\n168|\traw, err := os.ReadFile(store.bindingPath(sessionID))\n169|\tif err != nil {\n170|\t\tif errors.Is(err, os.ErrNotExist) {\n171|\t\t\treturn empty, false, nil\n172|\t\t}\n173|\t\treturn empty, false, fmt.Errorf(\"read bootstrap binding: %w\", err)\n174|\t}\n175|\tbinding, err := decodeBinding(raw)\n176|\tif err != nil {\n177|\t\treturn empty, false, err\n178|\t}\n179|\tif binding.SessionID != sessionID {\n180|\t\treturn empty, false, errors.New(\"bootstrap binding names another session\")\n181|\t}\n182|\treturn binding, true, nil\n183|}\n184|\n185|func (store *Store) timestamp() string {\n186|\tnow := time.Now().UTC()\n187|\tif store.now != nil {\n188|\t\tnow = store.now().UTC()\n189|\t}\n190|\treturn now.Format(\"2006-01-02T15:04:05.000Z07:00\")\n191|}\n192|\n193|// install stages the receipt to a same-directory temporary file,\n194|// fsyncs it, atomically links it to the binding path (which must\n195|// not exist: the link is the no-replace commit), removes the\n196|// staging name, and fsyncs the directory. Readers see absence or\n197|// the complete receipt, never a torn prefix: a crash before the\n198|// link leaves only ignored staging garbage, and a crash after it\n199|// leaves the complete binding the identical retry reattaches to.\n200|// Any pre-existing binding refuses without replacement.\n201|// errConcurrentWinner carries the winning receipt when a concurrent\n202|// wrapper commits first: the loser reattaches instead of failing.\n203|type errConcurrentWinner struct {\n204|\tbound Binding\n205|}\n206|\n207|func (err errConcurrentWinner) Error() string {\n208|\treturn \"bootstrap binding concurrently committed by another wrapper\"\n209|}\n210|\n211|// Supersede durably replaces the bootstrap binding after the\n212|// window closed: the caller proved (through the winner's checkpoint)\n213|// that a new bootstrap operation is legitimate, and the store\n214|// atomically installs the new receipt over the old one. The commit\n215|// is a staged fsync plus an atomic rename, so readers see the old\n216|// complete receipt or the new complete receipt, never a torn\n217|// prefix. A crash before the rename leaves the old binding with\n218|// ignored staging garbage the retry sweeps; a crash after it leaves\n219|// the new binding the identical retry reattaches to. Supersede\n220|// refuses malformed candidates exactly like Bind.\n221|func (store *Store) Supersede(sessionID, operationID string, candidate Binding) (Binding, error) {\n222|\tempty := Binding{}\n223|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n224|\t\treturn empty, fmt.Errorf(\"bind session %q is not a UUIDv7: %w\", sessionID, err)\n225|\t}\n226|\tif _, err := scalar.ParseUUIDv7(operationID); err != nil {\n227|\t\treturn empty, fmt.Errorf(\"bind operation %q is not a UUIDv7: %w\", operationID, err)\n228|\t}\n229|\tif candidate.SessionID != sessionID || candidate.OperationID != operationID {\n230|\t\treturn empty, fmt.Errorf(\"bind candidate names another bootstrap pair\")\n231|\t}\n232|\tif err := checkBindingCandidate(candidate); err != nil {\n233|\t\treturn empty, err\n234|\t}\n235|\treceipt, err := encodeBinding(candidate, store.timestamp())\n236|\tif err != nil {\n237|\t\treturn empty, err\n238|\t}\n239|\tif err := store.replace(sessionID, receipt); err != nil {\n240|\t\treturn empty, err\n241|\t}\n242|\tstored, found, err := store.Status(sessionID)\n243|\tif err != nil {\n244|\t\treturn empty, err\n245|\t}\n246|\tif !found {\n247|\t\treturn empty, errors.New(\"bootstrap binding vanished after install\")\n248|\t}\n249|\tif stored.OperationID != operationID {\n250|\t\treturn empty, errors.New(\"bootstrap binding names another operation after supersede\")\n251|\t}\n252|\treturn stored, nil\n253|}\n254|\n255|// replace stages the receipt and atomically renames it over the\n256|// binding path: the post-window commit. Staging garbage from a\n257|// pre-commit crash is swept first.\n258|func (store *Store) replace(sessionID string, receipt []byte) error {\n259|\tdir := store.sessionDir(sessionID)\n260|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n261|\t\treturn fmt.Errorf(\"create bootstrap session directory: %w\", err)\n262|\t}\n263|\tsweepStaging(dir)\n264|\ttarget := store.bindingPath(sessionID)\n265|\tstaged, err := os.CreateTemp(dir, \"binding-*.tmp\")\n266|\tif err != nil {\n267|\t\treturn fmt.Errorf(\"stage bootstrap binding: %w\", err)\n268|\t}\n269|\tstagedPath := staged.Name()\n270|\tdefer func() { _ = os.Remove(stagedPath) }()\n271|\tif err := staged.Chmod(0o600); err != nil {\n272|\t\t_ = staged.Close()\n273|\t\treturn fmt.Errorf(\"protect bootstrap binding: %w\", err)\n274|\t}\n275|\tif _, err := staged.Write(receipt); err != nil {\n276|\t\t_ = staged.Close()\n277|\t\treturn fmt.Errorf(\"write bootstrap binding: %w\", err)\n278|\t}\n279|\tif err := staged.Sync(); err != nil {\n280|\t\t_ = staged.Close()\n281|\t\treturn fmt.Errorf(\"sync bootstrap binding: %w\", err)\n282|\t}\n283|\tif err := staged.Close(); err != nil {\n284|\t\treturn fmt.Errorf(\"close bootstrap binding: %w\", err)\n285|\t}\n286|\tif store.hooks != nil && store.hooks.AfterStage != nil {\n287|\t\tif err := store.hooks.AfterStage(stagedPath); err != nil {\n288|\t\t\treturn err\n289|\t\t}\n290|\t}\n291|\tif err := os.Rename(stagedPath, target); err != nil {\n292|\t\treturn fmt.Errorf(\"install bootstrap binding: %w\", err)\n293|\t}\n294|\tif store.hooks != nil && store.hooks.AfterInstall != nil {\n295|\t\tif err := store.hooks.AfterInstall(target); err != nil {\n296|\t\t\treturn err\n297|\t\t}\n298|\t}\n299|\tif err := syncDirectory(dir); err != nil {\n300|\t\treturn err\n301|\t}\n302|\treturn nil\n303|}\n304|\n305|// sweepStaging removes stale binding-*.tmp files left by a\n306|// pre-commit crash. Only files older than a minute are removed: a\n307|// concurrent live wrapper stages under the same pattern, and an\n308|// age gate keeps the sweep from deleting its in-flight receipt. It\n309|// is best-effort: a sweep failure never fails the binding, and\n310|// only the staging pattern is removed.\n311|func sweepStaging(dir string) {\n312|\tmatches, err := filepath.Glob(filepath.Join(dir, \"binding-*.tmp\"))\n313|\tif err != nil {\n314|\t\treturn\n315|\t}\n316|\tcutoff := time.Now().Add(-time.Minute)\n317|\tfor _, match := range matches {\n318|\t\tinfo, err := os.Stat(match)\n319|\t\tif err != nil {\n320|\t\t\tcontinue\n321|\t\t}\n322|\t\tif info.ModTime().After(cutoff) {\n323|\t\t\tcontinue\n324|\t\t}\n325|\t\t_ = os.Remove(match)\n326|\t}\n327|}\n328|\n329|func (store *Store) install(sessionID, operationID string, receipt []byte) error {\n330|\tdir := store.sessionDir(sessionID)\n331|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n332|\t\treturn fmt.Errorf(\"create bootstrap session directory: %w\", err)\n333|\t}\n334|\tsweepStaging(dir)\n335|\ttarget := store.bindingPath(sessionID)\n336|\tstaged, err := os.CreateTemp(dir, \"binding-*.tmp\")\n337|\tif err != nil {\n338|\t\treturn fmt.Errorf(\"stage bootstrap binding: %w\", err)\n339|\t}\n340|\tstagedPath := staged.Name()\n341|\tdefer func() { _ = os.Remove(stagedPath) }()\n342|\tif err := staged.Chmod(0o600); err != nil {\n343|\t\t_ = staged.Close()\n344|\t\treturn fmt.Errorf(\"protect bootstrap binding: %w\", err)\n345|\t}\n346|\tif _, err := staged.Write(receipt); err != nil {\n347|\t\t_ = staged.Close()\n348|\t\treturn fmt.Errorf(\"write bootstrap binding: %w\", err)\n349|\t}\n350|\tif err := staged.Sync(); err != nil {\n351|\t\t_ = staged.Close()\n352|\t\treturn fmt.Errorf(\"sync bootstrap binding: %w\", err)\n353|\t}\n354|\tif err := staged.Close(); err != nil {\n355|\t\treturn fmt.Errorf(\"close bootstrap binding: %w\", err)\n356|\t}\n357|\tif store.hooks != nil && store.hooks.AfterStage != nil {\n358|\t\tif err := store.hooks.AfterStage(stagedPath); err != nil {\n359|\t\t\treturn err\n360|\t\t}\n361|\t}\n362|\tif err := os.Link(stagedPath, target); err != nil {\n363|\t\tif errors.Is(err, os.ErrExist) {\n364|\t\t\t// A concurrent wrapper won the commit between our\n365|\t\t\t// Status and our link: re-read the winner. The\n366|\t\t\t// same operation reattaches to it; a changed\n367|\t\t\t// operation is the bootstrap-window mismatch.\n368|\t\t\twinner, found, readErr := store.Status(sessionID)\n369|\t\t\tif readErr != nil {\n370|\t\t\t\treturn readErr\n371|\t\t\t}\n372|\t\t\tif !found {\n373|\t\t\t\treturn &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \"bootstrap binding\"}\n374|\t\t\t}\n375|\t\t\tif winner.OperationID != operationID {\n376|\t\t\t\treturn &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \"bootstrap binding\"}\n377|\t\t\t}\n378|\t\t\treturn errConcurrentWinner{bound: winner}\n379|\t\t}\n380|\t\treturn fmt.Errorf(\"install bootstrap binding: %w\", err)\n381|\t}\n382|\t_ = os.Remove(stagedPath)\n383|\tif store.hooks != nil && store.hooks.AfterInstall != nil {\n384|\t\tif err := store.hooks.AfterInstall(target); err != nil {\n385|\t\t\treturn err\n386|\t\t}\n387|\t}\n388|\tif err := syncDirectory(dir); err != nil {\n389|\t\treturn err\n390|\t}\n391|\treturn nil\n392|}\n393|\n394|func checkBindingCandidate(candidate Binding) error {\n395|\tif _, err := scalar.ParseUUIDv7(candidate.SessionID); err != nil {\n396|\t\treturn fmt.Errorf(\"binding session %q is not a UUIDv7: %w\", candidate.SessionID, err)\n397|\t}\n398|\tif _, err := scalar.ParseUUIDv7(candidate.OperationID); err != nil {\n399|\t\treturn fmt.Errorf(\"binding operation %q is not a UUIDv7: %w\", candidate.OperationID, err)\n400|\t}\n401|\tif _, err := scalar.ParseUUIDv7(candidate.TerminalInstanceID); err != nil {\n402|\t\treturn fmt.Errorf(\"binding terminal instance %q is not a UUIDv7: %w\", candidate.TerminalInstanceID, err)\n403|\t}\n404|\tif _, err := scalar.ParseDigest(candidate.BindingDigest); err != nil {\n405|\t\treturn fmt.Errorf(\"binding digest is not a digest: %w\", err)\n406|\t}\n407|\t// The candidate carries no timestamp: the store stamps\n408|\t// created_at at install, so a caller clock never enters the\n409|\t// receipt. Stored receipts validate their stamp at decode.\n410|\treturn nil\n411|}\n412|\n413|func encodeBinding(candidate Binding, createdAt string) ([]byte, error) {\n414|\tstored := candidate\n415|\tstored.CreatedAt = createdAt\n416|\tdocument := map[string]string{\n417|\t\t\"schema\":                 bindingSchema,\n418|\t\t\"schema_version\":         bindingSchemaVersion,\n419|\t\t\"session_id\":             stored.SessionID,\n420|\t\t\"bootstrap_operation_id\": stored.OperationID,\n421|\t\t\"terminal_instance_id\":   stored.TerminalInstanceID,\n422|\t\t\"binding_digest\":         stored.BindingDigest,\n423|\t\t\"created_at\":             stored.CreatedAt,\n424|\t}\n425|\traw, err := json.Marshal(document)\n426|\tif err != nil {\n427|\t\treturn nil, fmt.Errorf(\"encode bootstrap binding: %w\", err)\n428|\t}\n429|\treturn raw, nil\n430|}\n431|\n432|func decodeBinding(raw []byte) (Binding, error) {\n433|\tempty := Binding{}\n434|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n435|\tdecoder.DisallowUnknownFields()\n436|\tvar document struct {\n437|\t\tSchema             string `json:\"schema\"`\n438|\t\tSchemaVersion      string `json:\"schema_version\"`\n439|\t\tSessionID          string `json:\"session_id\"`\n440|\t\tOperationID        string `json:\"bootstrap_operation_id\"`\n441|\t\tTerminalInstanceID string `json:\"terminal_instance_id\"`\n442|\t\tBindingDigest      string `json:\"binding_digest\"`\n443|\t\tCreatedAt          string `json:\"created_at\"`\n444|\t}\n445|\tif err := decoder.Decode(&document); err != nil {\n446|\t\treturn empty, fmt.Errorf(\"bootstrap binding is not the closed shape: %w\", err)\n447|\t}\n448|\tif decoder.More() {\n449|\t\treturn empty, fmt.Errorf(\"bootstrap binding carries trailing data\")\n450|\t}\n451|\tvar members map[string]json.RawMessage\n452|\tif err := json.Unmarshal(raw, &members); err != nil {\n453|\t\treturn empty, fmt.Errorf(\"bootstrap binding is not an object: %w\", err)\n454|\t}\n455|\tfor _, name := range bindingMembers {\n456|\t\tif _, ok := members[name]; !ok {\n457|\t\t\treturn empty, fmt.Errorf(\"bootstrap binding misses required member %q\", name)\n458|\t\t}\n459|\t}\n460|\tif document.Schema != bindingSchema || document.SchemaVersion != bindingSchemaVersion {\n461|\t\treturn empty, fmt.Errorf(\"bootstrap binding schema is not %s %s\", bindingSchema, bindingSchemaVersion)\n462|\t}\n463|\tbinding := Binding{\n464|\t\tSessionID:          document.SessionID,\n465|\t\tOperationID:        document.OperationID,\n466|\t\tTerminalInstanceID: document.TerminalInstanceID,\n467|\t\tBindingDigest:      document.BindingDigest,\n468|\t\tCreatedAt:          document.CreatedAt,\n469|\t}\n470|\tif err := checkBindingCandidate(binding); err != nil {\n471|\t\treturn empty, err\n472|\t}\n473|\tif _, err := scalar.ParseTimestamp(binding.CreatedAt); err != nil {\n474|\t\treturn empty, fmt.Errorf(\"binding timestamp is not a timestamp: %w\", err)\n475|\t}\n476|\treturn binding, nil\n477|}\n478|\n479|// BindingDigest computes the opaque binding digest over the canonical\n480|// receipt bytes: the value a §7.A descriptor carries as\n481|// terminal_binding_id. It reveals no generation, PID, or native\n482|// reference.\n483|func BindingDigest(binding Binding) string {\n484|\tsum := sha256.Sum256([]byte(binding.SessionID + \"\\x00\" + binding.OperationID + \"\\x00\" + binding.TerminalInstanceID))\n485|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n486|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
