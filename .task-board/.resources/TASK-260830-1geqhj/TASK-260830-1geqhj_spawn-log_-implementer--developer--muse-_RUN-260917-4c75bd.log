{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c92d","stream":{"kind":"session","id":"01a0b131-d4f6-7b82-a7a6-5363cf3ac7fb"},"sequence":753,"recorded_at":1780531400001501,"record_type":"event","durability":"durable","causation_id":"2237b1e3-856b-4a22-9f46-61adba667efd","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"2237b1e3-856b-4a22-9f46-61adba667efd","run_stream":{"kind":"run","id":"2237b1e3-856b-4a22-9f46-61adba667efd"},"call_id":"call_01a0b134e09371d987659e38913cc20b","text":"Read text file `internal/axpane/decide.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"fmt\"\n7|\t\"time\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/matjournal\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/resumesmoke\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/sessprofile\"\n17|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n18|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n19|)\n20|\n21|// Action is exactly one wrapper outcome. Decide returns one and only\n22|// one; there is no combined or fallback outcome.\n23|type Action string\n24|\n25|const (\n26|\t// ActionLaunch starts the provider under the winning lease with\n27|\t// the validated descriptor and fencing token.\n28|\tActionLaunch Action = \"launch\"\n29|\t// ActionReattach reattaches to the one recorded wrapper/child\n30|\t// after a lost result: the bootstrap pair matches the durable\n31|\t// binding and every gate passes again.\n32|\tActionReattach Action = \"reattach\"\n33|\t// ActionAttachRemote offers remote attach: another host owns the\n34|\t// session in an interactive terminal and the attach capability\n35|\t// is admitted. It authorizes no lease mutation.\n36|\tActionAttachRemote Action = \"attach_remote\"\n37|\t// ActionTakeoverOffer offers takeover: another host owns the\n38|\t// session in an interactive terminal but remote attach is not\n39|\t// available (attach capability unproven). It starts no runtime.\n40|\t// A remote owner outside an interactive terminal parks instead\n41|\t// (§4.2 step 5: parked in all other cases).\n42|\tActionTakeoverOffer Action = \"takeover_offer\"\n43|\t// ActionParked parks without launching the provider, carrying\n44|\t// the Section 5.2 session.parked reason vocabulary.\n45|\tActionParked Action = \"parked\"\n46|\t// ActionRefused refuses: a static validation failed and there is\n47|\t// no parked direction that a state change could resolve.\n48|\tActionRefused Action = \"refused\"\n49|)\n50|\n51|// Refusal classes are the Section 15 codes the wrapper surfaces.\n52|// Landed-gate codes pass through verbatim; the wrapper mints no code.\n53|const (\n54|\t// ClassInvalidConfig reports a configuration that fails\n55|\t// validation (config.Load through ValidateConfig).\n56|\tClassInvalidConfig = \"invalid_config\"\n57|\t// ClassInvalidArguments reports a malformed wrapper call: an\n58|\t// unknown SESSION_ID, an unknown caller kind or mode, or a\n59|\t// malformed presented fencing token.\n60|\tClassInvalidArguments = \"invalid_arguments\"\n61|\t// ClassIntegrityFailure reports profile derivation input the\n62|\t// reducer refuses: the chain cannot be trusted.\n63|\tClassIntegrityFailure = \"integrity_failure\"\n64|\t// ClassProfileMappingUnavailable is the Section 2.4 resume\n65|\t// failure: the adapter cannot map the stored profile for the\n66|\t// probed provider version.\n67|\tClassProfileMappingUnavailable = \"profile_mapping_unavailable\"\n68|)\n69|\n70|// Mode selects the wrapper path: a fresh activation (the Section 4.C\n71|// create row) or the after-restore first start (the restore row). It\n72|// selects both the fencing entry and the backend capability the\n73|// admitted set must confer.\n74|type Mode string\n75|\n76|const (\n77|\t// ModeLaunch gates through fencing AuthorizeActivation and the\n78|\t// create capability dependencies.\n79|\tModeLaunch Mode = \"launch\"\n80|\t// ModeRestore gates through fencing AuthorizeRestore and the\n81|\t// restore capability dependencies.\n82|\tModeRestore Mode = \"restore\"\n83|)\n84|\n85|// Caller kinds are the closed §4.2 realm vocabulary.\n86|const (\n87|\t// CallerForeground is an interactive operator-side caller.\n88|\tCallerForeground = \"foreground\"\n89|\t// CallerBackground is a background CLI, SSH RPC process, daemon,\n90|\t// or restore worker: it must never create a\n91|\t// credential-dependent tmux server.\n92|\tCallerBackground = \"background\"\n93|)\n94|\n95|// Realm carries the §4.2 caller realm and broker readiness the\n96|// background-caller arm decides over. There is deliberately no member\n97|// for a cached sentinel result, a managername observation, or any\n98|// attested-server boolean: none authorizes resume, so none is an\n99|// input. A background caller authorizes only through the admitted\n100|// credential_capable_execution_realm Capability Evidence row bound to\n101|// the exact host binding, probed provider build, and current\n102|// generation (§4.2, §4.D); the bare boolean previously carried here\n103|// never authorizes and is removed.\n104|type Realm struct {\n105|\t// Caller is CallerForeground or CallerBackground.\n106|\tCaller string\n107|\t// BrokerState, ServerGeneration, and Remediation are the typed\n108|\t// realm/readiness details the capability_unavailable refusal\n109|\t// carries. They are required: an empty member refuses\n110|\t// invalid_arguments instead of emitting an untyped refusal.\n111|\t// ServerGeneration must equal the current AX-known raw\n112|\t// generation the backend admission binds to; a stale generation\n113|\t// refuses capability_unavailable, never launches.\n114|\tBrokerState      string\n115|\tServerGeneration string\n116|\tRemediation      string\n117|}\n118|\n119|// Closed capability names the wrapper's conditional arms evaluate.\n120|// They repeat the §4.D registry rows the backend admission proves;\n121|// the wrapper invents no capability.\n122|const (\n123|\t// credentialRealmCapability is the §4.D row a background caller\n124|\t// must hold: the exact-instance sentinel plus provider-auth\n125|\t// smoke bound to the terminal binding, provider build,\n126|\t// generation digest, OS version, and expiry.\n127|\tcredentialRealmCapability = \"credential_capable_execution_realm\"\n128|\t// headlessCreationCapability is the §4.C create-row conditional\n129|\t// a non-interactive create must hold.\n130|\theadlessCreationCapability = \"headless_creation\"\n131|)\n132|\n133|// ProviderFacts carries the probed provider build, the stored\n134|// identity, and the optional discovery proof the provider-identity\n135|// arm decides over.\n136|type ProviderFacts struct {\n137|\t// Build is the exact probed build tuple.\n138|\tBuild provhost.BuildTuple\n139|\t// Identity is the stored Provider Identity Record document.\n140|\tIdentity []byte\n141|\t// Discovery is the NativeDiscoveryProof document, meaningful\n142|\t// only when HasDiscovery is set.\n143|\tDiscovery    []byte\n144|\tHasDiscovery bool\n145|\t// DiscoveryContext binds the proof to host-side facts.\n146|\tDiscoveryContext provhost.DiscoveryContext\n147|}\n148|\n149|// SmokeFacts carries the provider-auth smoke precondition: the\n150|// stored smoke record plus the typed target-auth details the\n151|// target_auth_missing refusal carries when the smoke is required\n152|// and fails.\n153|type SmokeFacts struct {\n154|\t// Required reports that provider credentials are required, so\n155|\t// the smoke must pass (the §4.C create/restore rows).\n156|\tRequired bool\n157|\t// Record is the stored smoke record document.\n158|\tRecord []byte\n159|\t// Target carries the typed provider/build/version/generation\n160|\t// details. Every member is required when the smoke is\n161|\t// required: an empty member refuses invalid_arguments instead\n162|\t// of emitting an untyped refusal.\n163|\tTarget axerror.TargetAuth\n164|\t// MacOSVersion is recorded here because TargetAuth carries it;\n165|\t// it is the version the smoke evidence binds, not a fresh\n166|\t// observation.\n167|}\n168|\n169|// BackendFacts carries the backend identity documents the §4.B arm\n170|// decides over.\n171|type BackendFacts struct {\n172|\t// Manifest, Probe, and Evidence are the raw documents parsed by\n173|\t// the terminalbackend owner.\n174|\tManifest []byte\n175|\tProbe    []byte\n176|\tEvidence [][]byte\n177|\t// RawGeneration is the AX-known raw generation the admission\n178|\t// binds to; Verify checks evidence signatures.\n179|\tRawGeneration string\n180|\tVerify        terminalbackend.SignatureVerifier\n181|\t// Now is the admission instant for evidence liveness.\n182|\tNow time.Time\n183|}\n184|\n185|// Input is the complete Decide surface: validated configuration,\n186|// the loaded session, the local lease view, materialization and\n187|// checkpoint state, the profile chain, provider identity, backend\n188|// identity, realm readiness, and the bootstrap binding. I/O-free\n189|// callers build it by hand; Run builds it through the gates.go\n190|// adapters over the durable stores.\n191|type Input struct {\n192|\t// SessionID is the logical session under decision.\n193|\tSessionID string\n194|\t// BootstrapOperationID is the caller-stable bootstrap operation.\n195|\tBootstrapOperationID string\n196|\t// Mode selects the fencing entry and capability row.\n197|\tMode Mode\n198|\n199|\t// ConfigErr is the ValidateConfig outcome; non-nil refuses\n200|\t// invalid_config.\n201|\tConfigErr error\n202|\t// SessionKnown reports that the logical session loaded; false\n203|\t// refuses invalid_arguments.\n204|\tSessionKnown bool\n205|\n206|\t// ExistingBinding is the proven bootstrap binding, or nil when\n207|\t// Status proved absence. A changed operation inside the\n208|\t// bootstrap window refuses idempotency_mismatch; a matching\n209|\t// pair reattaches; a changed operation after the window closed\n210|\t// (the winner carries a checkpoint) installs a new binding and\n211|\t// launches. The window predicate reads the winner's own\n212|\t// HasCheckpoint, never a caller claim.\n213|\tExistingBinding *Binding\n214|\n215|\t// Presented is the local fencing token; Observation is the\n216|\t// verified lease view, built by fencing.Observe.\n217|\tPresented   fencing.PresentedToken\n218|\tObservation fencing.Observation\n219|\n220|\t// Backend carries the §4.B identity documents.\n221|\tBackend BackendFacts\n222|\n223|\t// Journal is the loaded materialization journal; JournalOK\n224|\t// reports that the matjournal owner admitted it. When\n225|\t// MaterializationRequired is set (the after-restore step 3),\n226|\t// a local launch additionally requires the committed phase.\n227|\t// A fresh launch (§13.1 steps 3-4) runs before the journal\n228|\t// commits and leaves the requirement unset.\n229|\tMaterializationRequired bool\n230|\tJournal                 matjournal.Journal\n231|\tJournalOK               bool\n232|\n233|\t// Checkpoint carries the resume checkpoint: Required when the\n234|\t// path resumes from a checkpoint, Doc with its bytes, ID with\n235|\t// the expected digest. Admission attests through the sessrepo\n236|\t// owner, requires exactly the winning lease's checkpoint, and\n237|\t// binds the checkpoint's own session_id to this session.\n238|\tCheckpointRequired bool\n239|\tCheckpointDoc      []byte\n240|\tCheckpointID       string\n241|\n242|\t// ProfileRecord and ProfileEvents are the decoded session\n243|\t// surface the sessprofile reducer derives the effective pair\n244|\t// from. ProfileHeads, when non-empty, is the validated\n245|\t// checkpoint's event-head closure: resume derives from the\n246|\t// closure (DeriveForHeads), never the session head, so a\n247|\t// head-only or losing-lease change cannot become the launch\n248|\t// profile. Run loads the heads from the winner's checkpoint;\n249|\t// I/O-free callers supply them by hand.\n250|\tProfileRecord sessprofile.Record\n251|\tProfileEvents []sessprofile.Event\n252|\tProfileHeads  []string\n253|\n254|\t// Provider carries the probed build, stored identity, and\n255|\t// optional discovery proof.\n256|\tProvider ProviderFacts\n257|\n258|\t// Smoke carries the provider-auth smoke precondition.\n259|\tSmoke SmokeFacts\n260|\n261|\t// Realm carries the caller realm and broker readiness.\n262|\tRealm Realm\n263|\n264|\t// Entrypoint is the wrapper argv, checked against the §4.A\n265|\t// stable entrypoint rule.\n266|\tEntrypoint []string\n267|\n268|\t// Descriptor is the §7.A provider descriptor document the\n269|\t// wrapper supplies; HostBinding is the AX-validated host-local\n270|\t// binding it must match. Admission runs on the launch and\n271|\t// reattach paths only: parked, refused, and remote-offer\n272|\t// outcomes start no local provider.\n273|\tDescriptor  []byte\n274|\tHostBinding terminalbackend.InstanceBinding\n275|\n276|\t// RemoteInteractive reports that the remote owner holds the\n277|\t// session in an interactive terminal (after-restore step 4).\n278|\tRemoteInteractive bool\n279|\n280|\t// Interactive reports that the local pane runs in an\n281|\t// interactive terminal. A non-interactive create must hold the\n282|\t// headless_creation conditional (§4.C create row); the field\n283|\t// selects that arm and shapes the supplied descriptor.\n284|\tInteractive bool\n285|}\n286|\n287|// Decision is the one outcome Decide returns.\n288|type Decision struct {\n289|\t// Action is the outcome.\n290|\tAction Action\n291|\t// ParkReason and WinningLeaseID carry the session.parked\n292|\t// vocabulary when Action is parked. The lease ID is empty when\n293|\t// no winner is established.\n294|\tParkReason     fencing.ParkReason\n295|\tWinningLeaseID string\n296|\t// Class is the Section 15 refusal code when Action is refused.\n297|\tClass string\n298|\t// Detail is the static refusal or park detail. It carries\n299|\t// member names and the landed cause, never credentials,\n300|\t// generations, or native references.\n301|\tDetail string\n302|\t// Cause is the underlying landed error.\n303|\tCause error\n304|\t// Token is the sealed fencing token the passed gate minted,\n305|\t// set on launch and reattach only. The provider receives it\n306|\t// separately from the descriptor (§7.A).\n307|\tToken fencing.LeaseToken\n308|\t// HasToken reports that Token is minted. The zero token never\n309|\t// authorizes: decisions without a passed gate carry none.\n310|\tHasToken bool\n311|\t// Profile is the effective persisted pair the launch carries.\n312|\tProfile sessprofile.Pair\n313|\t// Mapping is the resolved provider adapter flag (empty for\n314|\t// standard).\n315|\tMapping string\n316|\t// Admitted is the reconciled backend capability set.\n317|\tAdmitted terminalbackend.Admitted\n318|\t// Descriptor is the admitted §7.A provider descriptor, set on\n319|\t// launch and reattach only.\n320|\tDescriptor terminalbackend.ProviderDescriptor\n321|\t// RealmFailure is the composed typed Structured Error for the\n322|\t// capability_unavailable and target_auth_missing refusals.\n323|\tRealmFailure *axerror.Error\n324|}\n325|\n326|func refused(class, detail string, cause error) Decision {\n327|\treturn Decision{Action: ActionRefused, Class: class, Detail: detail, Cause: cause}\n328|}\n329|\n330|func parked(reason fencing.ParkReason, winningLeaseID string, cause error) Decision {\n331|\treturn Decision{\n332|\t\tAction:         ActionParked,\n333|\t\tParkReason:     reason,\n334|\t\tWinningLeaseID: winningLeaseID,\n335|\t\tDetail:         \"park (\" + string(reason) + \") without launching the provider\",\n336|\t\tCause:          cause,\n337|\t}\n338|}\n339|\n340|// Decide is the pure wrapper core: configuration, session, bootstrap\n341|// idempotency with the window predicate, backend identity and\n342|// capability admission with the §4.C conditionals, fencing,\n343|// materialization with the lease-checkpoint binding, checkpoint\n344|// admission bound to the winning lease and session, provider\n345|// identity, provider-auth smoke with the target binding, realm\n346|// evidence, profile derivation from the checkpoint closure on\n347|// resume and mapping, entrypoint, and provider descriptor, in that\n348|// precedence, then the outcome selection. Fencing precedes\n349|// materialization: a remote owner offers attach/takeover even when\n350|// the local materialization is stale (the after-restore order).\n351|// The tuple gate precedes mapping so a tuple refusal keeps its own\n352|// class instead of wearing profile_mapping_unavailable. Decide\n353|// performs no I/O, reads no clock except the instants the input\n354|// carries, and mints no lease, binding, or event: Run owns the\n355|// durable effects. Every refusal carries the Section 15 code the\n356|// arm names; every park carries the session.parked vocabulary.\n357|func Decide(input Input) Decision {\n358|\tif input.ConfigErr != nil {\n359|\t\treturn refused(ClassInvalidConfig, \"configuration is invalid\", input.ConfigErr)\n360|\t}\n361|\tif input.Mode != ModeLaunch && input.Mode != ModeRestore {\n362|\t\treturn refused(ClassInvalidArguments, \"wrapper mode is not launch or restore\", errWrapperMode(input.Mode))\n363|\t}\n364|\tif !input.SessionKnown {\n365|\t\treturn refused(ClassInvalidArguments, \"logical session is unknown\", errUnknownSession(input.SessionID))\n366|\t}\n367|\tif input.ExistingBinding != nil && input.ExistingBinding.OperationID != input.BootstrapOperationID && !bootstrapWindowClosed(input.Observation) {\n368|\t\treturn refused(terminalbackend.CodeIdempotencyMismatch,\n369|\t\t\t\"bootstrap operation changed inside the bootstrap window\",\n370|\t\t\terrIdempotencyChanged(input.SessionID))\n371|\t}\n372|\tif err := checkRealmVocabulary(input.Realm.Caller); err != nil {\n373|\t\treturn refused(ClassInvalidArguments, \"caller realm is not foreground or background\", err)\n374|\t}\n375|\n376|\tadmitted, evidence, err := admitBackend(input)\n377|\tif err != nil {\n378|\t\treturn refused(backendClass(err), \"terminal backend identity or capability admission failed\", err)\n379|\t}\n380|\tif input.Mode == ModeLaunch && !input.Interactive && !admitted.Has(headlessCreationCapability) {\n381|\t\treturn refused(terminalbackend.CodeCapabilityUnproven,\n382|\t\t\t\"non-interactive create requires headless_creation\",\n383|\t\t\terrHeadlessRequired())\n384|\t}\n385|\n386|\ttoken, err := authorize(input)\n387|\tif err != nil {\n388|\t\tif fencing.IsParked(err) {\n389|\t\t\treason, winning, _ := fencing.ParkDetails(err)\n390|\t\t\treturn decideParked(input, admitted, reason, winning, err)\n391|\t\t}\n392|\t\treturn refused(fencingClass(err), \"fencing refused the wrapper\", err)\n393|\t}\n394|\n395|\tif input.MaterializationRequired {\n396|\t\tif err := checkMaterialization(input); err != nil {\n397|\t\t\treturn parked(fencing.ParkRestorePolicy, input.Observation.Winner.LeaseID, err)\n398|\t\t}\n399|\t}\n400|\tif input.CheckpointRequired {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
