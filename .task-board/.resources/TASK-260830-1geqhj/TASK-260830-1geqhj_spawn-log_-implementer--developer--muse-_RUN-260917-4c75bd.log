{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cd0b","stream":{"kind":"session","id":"01a0b131-d4f6-7b82-a7a6-5363cf3ac7fb"},"sequence":1248,"recorded_at":1780531400002491,"record_type":"event","durability":"durable","causation_id":"2237b1e3-856b-4a22-9f46-61adba667efd","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"2237b1e3-856b-4a22-9f46-61adba667efd","run_stream":{"kind":"run","id":"2237b1e3-856b-4a22-9f46-61adba667efd"},"call_id":"call_01a0b1379eee708b8021aef214cc9e36","text":"Read text file `internal/axpane/run_test.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"io/fs\"\n7|\t\"os\"\n8|\t\"testing\"\n9|\t\"time\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/config\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/matjournal\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/sessckpt\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n17|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n18|)\n19|\n20|// runWorld binds real durable stores: the session chain with its\n21|// epoch-1 lease, a committed journal, a captured checkpoint, and an\n22|// empty binding store.\n23|type runWorld struct {\n24|\trepo     *sessrepo.Repository\n25|\trecordID string\n26|\theadID   string\n27|\tmat      *matjournal.Store\n28|\tckpt     *sessckpt.Store\n29|\tckptID   string\n30|\tpane     *Store\n31|\tpaneRoot string\n32|\tuniverse *backendUniverse\n33|}\n34|\n35|func buildRunWorld(t *testing.T) *runWorld {\n36|\tt.Helper()\n37|\tworld := &runWorld{universe: buildBackendUniverse(t, true)}\n38|\tworld.repo, world.recordID = chainFixture(t)\n39|\tevents, err := world.repo.ListEvents(fixtureSession)\n40|\tif err != nil {\n41|\t\tt.Fatal(err)\n42|\t}\n43|\tworld.headID = events[len(events)-1].EventID\n44|\tmatStore, err := matjournal.Open(t.TempDir())\n45|\tif err != nil {\n46|\t\tt.Fatal(err)\n47|\t}\n48|\tworld.mat = matStore\n49|\tjournalFixture(t, matStore)\n50|\tckptStore, err := sessckpt.Open(t.TempDir())\n51|\tif err != nil {\n52|\t\tt.Fatal(err)\n53|\t}\n54|\tworld.ckpt = ckptStore\n55|\tworld.ckptID, _ = checkpointFixture(t, world.repo, ckptStore, []string{world.headID})\n56|\tworld.paneRoot = t.TempDir()\n57|\tpaneStore, err := Open(world.paneRoot)\n58|\tif err != nil {\n59|\t\tt.Fatal(err)\n60|\t}\n61|\tworld.pane = paneStore\n62|\treturn world\n63|}\n64|\n65|func (world *runWorld) stores() Stores {\n66|\treturn Stores{Repo: world.repo, Mat: world.mat, Ckpt: world.ckpt, Pane: world.pane}\n67|}\n68|\n69|func configInputs(t *testing.T) (config.Inputs, config.Overrides) {\n70|\tt.Helper()\n71|\thome := t.TempDir()\n72|\tplatform, err := scalar.ParsePlatform(\"linux\")\n73|\tif err != nil {\n74|\t\tt.Fatal(err)\n75|\t}\n76|\tfor _, dir := range []string{\"config\", \"data\", \"state\", \"cache\", \"runtime\"} {\n77|\t\tif err := os.MkdirAll(home+\"/\"+dir, 0o755); err != nil {\n78|\t\t\tt.Fatal(err)\n79|\t\t}\n80|\t}\n81|\treturn config.Inputs{\n82|\t\t\tPlatform:   platform,\n83|\t\t\tHomeDir:    home,\n84|\t\t\tTempDir:    home,\n85|\t\t\tWorkingDir: home,\n86|\t\t\tLookupEnv:  func(string) (string, bool) { return \"\", false },\n87|\t\t\tStat:       func(path string) (fs.FileInfo, error) { return os.Stat(path) },\n88|\t\t\tReadFile:   os.ReadFile,\n89|\t\t}, config.Overrides{\n90|\t\t\tconfig.ConfigFile:  home + \"/config/config.toml\",\n91|\t\t\tconfig.DataRoot:    home + \"/data\",\n92|\t\t\tconfig.StateRoot:   home + \"/state\",\n93|\t\t\tconfig.CacheRoot:   home + \"/cache\",\n94|\t\t\tconfig.RuntimeRoot: home + \"/runtime\",\n95|\t\t}\n96|}\n97|\n98|func runObserve(now time.Time) fencing.ObserveInput {\n99|\tgrant, policy := fixtureGrant(now)\n100|\treturn fencing.ObserveInput{\n101|\t\tLocalHostID: fixtureLocalHost,\n102|\t\tVerified:    true,\n103|\t\tGrant:       grant,\n104|\t\tHasGrant:    true,\n105|\t\tPolicy:      policy,\n106|\t\tNow:         now,\n107|\t}\n108|}\n109|\n110|func runRequest(t *testing.T, world *runWorld) Request {\n111|\tt.Helper()\n112|\tinputs, overrides := configInputs(t)\n113|\treturn Request{\n114|\t\tSessionID:            fixtureSession,\n115|\t\tBootstrapOperationID: fixtureBootstrap,\n116|\t\tMode:                 ModeLaunch,\n117|\t\tConfigInputs:         inputs,\n118|\t\tConfigOverrides:      overrides,\n119|\t\tPresented:            fixturePresented(),\n120|\t\tObserve:              runObserve(fixtureNow()),\n121|\t\tProvider: ProviderFacts{\n122|\t\t\tBuild:    fixtureBuild(),\n123|\t\t\tIdentity: fixtureIdentity(t),\n124|\t\t},\n125|\t\tRealm: Realm{\n126|\t\t\tCaller:           CallerForeground,\n127|\t\t\tBrokerState:      \"broker-running\",\n128|\t\t\tServerGeneration: \"generation-alpha\",\n129|\t\t\tRemediation:      \"launch the aqua broker\",\n130|\t\t},\n131|\t\tBackend:     world.universe.facts(t),\n132|\t\tEntrypoint:  []string{\"ax\", \"pane\", fixtureSession},\n133|\t\tHostBinding: world.universe.hostBinding(),\n134|\t\tInteractive: true,\n135|\t\tColumns:     80,\n136|\t\tRows:        24,\n137|\t\tInstanceID:  fixtureInstance,\n138|\t\tLocalHostID: fixtureLocalHost,\n139|\t\tCreatedAt:   fixtureCreatedAt,\n140|\t}\n141|}\n142|\n143|func eventCount(t *testing.T, repository *sessrepo.Repository) int {\n144|\tt.Helper()\n145|\tevents, err := repository.ListEvents(fixtureSession)\n146|\tif err != nil {\n147|\t\tt.Fatal(err)\n148|\t}\n149|\treturn len(events)\n150|}\n151|\n152|func TestRunLaunchBinds(t *testing.T) {\n153|\tt.Parallel()\n154|\tworld := buildRunWorld(t)\n155|\toutcome, err := Run(world.stores(), runRequest(t, world))\n156|\tif err != nil {\n157|\t\tt.Fatalf(\"Run() error = %v\", err)\n158|\t}\n159|\tif outcome.Decision.Action != ActionLaunch {\n160|\t\tt.Fatalf(\"Run() action = %q, detail %q, cause %v, want launch\",\n161|\t\t\toutcome.Decision.Action, outcome.Decision.Detail, outcome.Decision.Cause)\n162|\t}\n163|\tif outcome.Binding == nil {\n164|\t\tt.Fatal(\"Run() launch binds no bootstrap pair\")\n165|\t}\n166|\tif outcome.Binding.OperationID != fixtureBootstrap || outcome.Binding.TerminalInstanceID != fixtureInstance {\n167|\t\tt.Fatalf(\"Run() binding = %+v\", outcome.Binding)\n168|\t}\n169|\tproven, found, err := world.pane.Status(fixtureSession)\n170|\tif err != nil || !found || proven != *outcome.Binding {\n171|\t\tt.Fatalf(\"Status() = (%+v, %v, %v), want the bound receipt\", proven, found, err)\n172|\t}\n173|\tif _, err := outcome.Decision.Token.Bind(fencing.ProviderQuiesce); err != nil {\n174|\t\tt.Fatalf(\"launch token bind error = %v\", err)\n175|\t}\n176|\tif outcome.Emitted {\n177|\t\tt.Fatal(\"Run() launch authors an event, want the binding only\")\n178|\t}\n179|}\n180|\n181|func TestRunReattaches(t *testing.T) {\n182|\tt.Parallel()\n183|\tworld := buildRunWorld(t)\n184|\tfirst, _, err := world.pane.Bind(fixtureSession, fixtureBootstrap, bindCandidate())\n185|\tif err != nil {\n186|\t\tt.Fatal(err)\n187|\t}\n188|\toutcome, err := Run(world.stores(), runRequest(t, world))\n189|\tif err != nil {\n190|\t\tt.Fatalf(\"Run() error = %v\", err)\n191|\t}\n192|\tif outcome.Decision.Action != ActionReattach {\n193|\t\tt.Fatalf(\"Run() action = %q, want reattach\", outcome.Decision.Action)\n194|\t}\n195|\tif outcome.Binding == nil || *outcome.Binding != first {\n196|\t\tt.Fatalf(\"Run() binding = %+v, want the recorded %+v\", outcome.Binding, first)\n197|\t}\n198|}\n199|\n200|func TestRunConcurrentLaunchReattaches(t *testing.T) {\n201|\tt.Parallel()\n202|\tworld := buildRunWorld(t)\n203|\trequest := runRequest(t, world)\n204|\twinner := bindCandidate()\n205|\twinner.TerminalInstanceID = \"0198f4c9-2222-7bbb-8bbb-1234567890ab\"\n206|\twinner.BindingDigest = BindingDigest(winner)\n207|\trequest.Hooks = &Hooks{\n208|\t\tAfterStage: func(path string) error {\n209|\t\t\tinner, err := Open(world.paneRoot)\n210|\t\t\tif err != nil {\n211|\t\t\t\treturn err\n212|\t\t\t}\n213|\t\t\t_, _, err = inner.Bind(fixtureSession, fixtureBootstrap, winner)\n214|\t\t\treturn err\n215|\t\t},\n216|\t}\n217|\toutcome, err := Run(world.stores(), request)\n218|\tif err != nil {\n219|\t\tt.Fatalf(\"Run() error = %v\", err)\n220|\t}\n221|\tif outcome.Decision.Action != ActionReattach {\n222|\t\tt.Fatalf(\"Run() action = %q, want reattach to the concurrent winner\", outcome.Decision.Action)\n223|\t}\n224|\tif outcome.Binding == nil || outcome.Binding.TerminalInstanceID != winner.TerminalInstanceID {\n225|\t\tt.Fatalf(\"Run() binding = %+v, want the winner's receipt\", outcome.Binding)\n226|\t}\n227|}\n228|\n229|func TestRunParkedEmits(t *testing.T) {\n230|\tt.Parallel()\n231|\tworld := buildRunWorld(t)\n232|\tappendChainEvent(t, world.repo, \"session.failed\", 1, fixtureLeaseA, 2, world.headID, map[string]any{\n233|\t\t\"error_code\": \"bootstrap_probe\", \"retryable\": false, \"operation_id\": nil,\n234|\t})\n235|\tevents, err := world.repo.ListEvents(fixtureSession)\n236|\tif err != nil {\n237|\t\tt.Fatal(err)\n238|\t}\n239|\tworld.headID = events[len(events)-1].EventID\n240|\trequest := runRequest(t, world)\n241|\trequest.Mode = ModeRestore\n242|\trequest.MaterializationRequired = true\n243|\trequest.MaterializationID = \"0198f4c8-9a10-7b22-8b3c-1234567890ff\"\n244|\trequest.CheckpointRequired = true\n245|\trequest.CheckpointID = world.ckptID\n246|\tbefore := eventCount(t, world.repo)\n247|\toutcome, err := Run(world.stores(), request)\n248|\tif err != nil {\n249|\t\tt.Fatalf(\"Run() error = %v\", err)\n250|\t}\n251|\tif outcome.Decision.Action != ActionParked {\n252|\t\tt.Fatalf(\"Run() action = %q, want parked\", outcome.Decision.Action)\n253|\t}\n254|\tif !outcome.Emitted || outcome.Event == nil {\n255|\t\tt.Fatal(\"Run() parked decision authors no event\")\n256|\t}\n257|\tif after := eventCount(t, world.repo); after != before+1 {\n258|\t\tt.Fatalf(\"Run() parked event count = %d, want %d\", after, before+1)\n259|\t}\n260|\tstored, err := world.repo.GetEvent(fixtureSession, outcome.Event.EventID)\n261|\tif err != nil {\n262|\t\tt.Fatal(err)\n263|\t}\n264|\tvar decoded struct {\n265|\t\tEventType string `json:\"event_type\"`\n266|\t\tLeaseID   string `json:\"lease_id\"`\n267|\t\tPayload   struct {\n268|\t\t\tReason string `json:\"reason\"`\n269|\t\t} `json:\"payload\"`\n270|\t}\n271|\tif err := json.Unmarshal(stored, &decoded); err != nil {\n272|\t\tt.Fatal(err)\n273|\t}\n274|\tif decoded.EventType != \"session.parked\" || decoded.LeaseID != fixtureLeaseA || decoded.Payload.Reason != \"restore_policy\" {\n275|\t\tt.Fatalf(\"parked event = %+v\", decoded)\n276|\t}\n277|\tif _, found, err := world.pane.Status(fixtureSession); err != nil || found {\n278|\t\tt.Fatalf(\"Status() after parked = (%v, %v), want no binding\", found, err)\n279|\t}\n280|}\n281|\n282|func TestRunTakeoverOfferEmitsParked(t *testing.T) {\n283|\tt.Parallel()\n284|\tworld := buildRunWorld(t)\n285|\tleases, err := world.repo.ListLeases(fixtureSession)\n286|\tif err != nil {\n287|\t\tt.Fatal(err)\n288|\t}\n289|\tif _, err := world.repo.CompareAndSwapLease(fixtureSession, sessrepo.LeaseExpectation{RecordID: leases[0].RecordID}, sessrepo.SuccessorLeaseInput{\n290|\t\tCreateLeaseInput: sessrepo.CreateLeaseInput{\n291|\t\t\tLeaseID:        fixtureLeaseB,\n292|\t\t\tHolderHostID:   fixtureRemoteHost,\n293|\t\t\tIssuedByHostID: fixtureRemoteHost,\n294|\t\t\tCreatedAt:      fixtureCreatedAt,\n295|\t\t},\n296|\t\tReason:       \"graceful_takeover\",\n297|\t\tCheckpointID: seedDigest(0xC9),\n298|\t}); err != nil {\n299|\t\tt.Fatalf(\"CompareAndSwapLease() error = %v\", err)\n300|\t}\n301|\t// A remote winner parks without chain emission: the local wrapper\n302|\t// must not manufacture a sequence collision under another host's\n303|\t// lease (§5.2). The non-interactive remote owner parks with the\n304|\t// remote_owner reason and no event.\n305|\tbefore := eventCount(t, world.repo)\n306|\toutcome, err := Run(world.stores(), runRequest(t, world))\n307|\tif err != nil {\n308|\t\tt.Fatalf(\"Run() error = %v\", err)\n309|\t}\n310|\tif outcome.Decision.Action != ActionParked || outcome.Decision.ParkReason != fencing.ParkRemoteOwner {\n311|\t\tt.Fatalf(\"Run() = (%q, %q), want parked remote_owner for non-interactive remote\", outcome.Decision.Action, outcome.Decision.ParkReason)\n312|\t}\n313|\tif outcome.Emitted {\n314|\t\tt.Fatal(\"Run() remote park authors a chain event under another host's lease, want no emission\")\n315|\t}\n316|\tif after := eventCount(t, world.repo); after != before {\n317|\t\tt.Fatalf(\"event count = %d, want %d (no remote emission)\", after, before)\n318|\t}\n319|\tif outcome.Decision.WinningLeaseID != fixtureLeaseB {\n320|\t\tt.Fatalf(\"WinningLeaseID = %q, want the remote winner\", outcome.Decision.WinningLeaseID)\n321|\t}\n322|}\n323|\n324|func TestRunParkedWithoutWinnerSkipsEmission(t *testing.T) {\n325|\tt.Parallel()\n326|\tworld := buildRunWorld(t)\n327|\t// A session with no leases yet: remove the epoch-1 lease the\n328|\t// chain fixture installed by working on a lease-free sibling.\n329|\trepository, err := sessrepo.Open(t.TempDir())\n330|\tif err != nil {\n331|\t\tt.Fatal(err)\n332|\t}\n333|\tvar record map[string]any\n334|\tif err := json.Unmarshal([]byte(sessionRecordFixture), &record); err != nil {\n335|\t\tt.Fatal(err)\n336|\t}\n337|\tif _, err := repository.CreateSession(identifyObject(t, record, \"record_id\")); err != nil {\n338|\t\tt.Fatal(err)\n339|\t}\n340|\tworld.repo = repository\n341|\trequest := runRequest(t, world)\n342|\toutcome, err := Run(world.stores(), request)\n343|\tif err != nil {\n344|\t\tt.Fatalf(\"Run() error = %v\", err)\n345|\t}\n346|\tif outcome.Decision.Action != ActionParked {\n347|\t\tt.Fatalf(\"Run() action = %q, want parked\", outcome.Decision.Action)\n348|\t}\n349|\tif outcome.Emitted {\n350|\t\tt.Fatal(\"Run() parked without a winner authors an event, want none\")\n351|\t}\n352|}\n353|\n354|func TestRunRefusedWritesNothing(t *testing.T) {\n355|\tt.Parallel()\n356|\tworld := buildRunWorld(t)\n357|\trequest := runRequest(t, world)\n358|\trequest.Entrypoint = []string{\"codex\", \"--yolo\"}\n359|\tbefore := eventCount(t, world.repo)\n360|\toutcome, err := Run(world.stores(), request)\n361|\tif err != nil {\n362|\t\tt.Fatalf(\"Run() error = %v\", err)\n363|\t}\n364|\tif outcome.Decision.Action != ActionRefused || outcome.Decision.Class != terminalbackend.CodePreconditionFailed {\n365|\t\tt.Fatalf(\"Run() = (%q, %q), want refused local_precondition_failed\", outcome.Decision.Action, outcome.Decision.Class)\n366|\t}\n367|\tif outcome.Binding != nil || outcome.Emitted {\n368|\t\tt.Fatal(\"Run() refusal writes durable state\")\n369|\t}\n370|\tif _, found, err := world.pane.Status(fixtureSession); err != nil || found {\n371|\t\tt.Fatalf(\"Status() after refusal = (%v, %v), want absence\", found, err)\n372|\t}\n373|\tif after := eventCount(t, world.repo); after != before {\n374|\t\tt.Fatalf(\"event count = %d, want %d\", after, before)\n375|\t}\n376|}\n377|\n378|func TestRunIdempotencyMismatch(t *testing.T) {\n379|\tt.Parallel()\n380|\tworld := buildRunWorld(t)\n381|\tother := bindCandidate()\n382|\tother.OperationID = fixtureOtherOp\n383|\tif _, _, err := world.pane.Bind(fixtureSession, fixtureOtherOp, other); err != nil {\n384|\t\tt.Fatal(err)\n385|\t}\n386|\toutcome, err := Run(world.stores(), runRequest(t, world))\n387|\tif err != nil {\n388|\t\tt.Fatalf(\"Run() error = %v\", err)\n389|\t}\n390|\tif outcome.Decision.Action != ActionRefused || outcome.Decision.Class != terminalbackend.CodeIdempotencyMismatch {\n391|\t\tt.Fatalf(\"Run() = (%q, %q), want refused idempotency_mismatch\", outcome.Decision.Action, outcome.Decision.Class)\n392|\t}\n393|}\n394|\n395|func TestRunRestoreCommitted(t *testing.T) {\n396|\tt.Parallel()\n397|\tworld := buildRunWorld(t)\n398|\trequest := runRequest(t, world)\n399|\trequest.Mode = ModeRestore\n400|\trequest.MaterializationRequired = true\n401|\trequest.MaterializationID = fixtureMat\n402|\trequest.CheckpointRequired = true\n403|\trequest.CheckpointID = world.ckptID\n404|\toutcome, err := Run(world.stores(), request)\n405|\tif err != nil {\n406|\t\tt.Fatalf(\"Run() error = %v\", err)\n407|\t}\n408|\tif outcome.Decision.Action != ActionLaunch {\n409|\t\tt.Fatalf(\"Run() action = %q, detail %q, cause %v, want launch\",\n410|\t\t\toutcome.Decision.Action, outcome.Decision.Detail, outcome.Decision.Cause)\n411|\t}\n412|\tif outcome.Binding == nil {\n413|\t\tt.Fatal(\"Run() restore launch binds no bootstrap pair\")\n414|\t}\n415|}\n416|\n417|func TestRunRestoreMaterializingParks(t *testing.T) {\n418|\tt.Parallel()\n419|\tworld := buildRunWorld(t)\n420|\trequest := runRequest(t, world)\n421|\trequest.Mode = ModeRestore\n422|\trequest.MaterializationRequired = true\n423|\trequest.MaterializationID = \"0198f4c8-9a10-7b22-8b3c-1234567890ff\"\n424|\trequest.CheckpointRequired = true\n425|\trequest.CheckpointID = world.ckptID\n426|\toutcome, err := Run(world.stores(), request)\n427|\tif err != nil {\n428|\t\tt.Fatalf(\"Run() error = %v\", err)\n429|\t}\n430|\tif outcome.Decision.Action != ActionParked || outcome.Decision.ParkReason != fencing.ParkRestorePolicy {\n431|\t\tt.Fatalf(\"Run() = (%q, %q), want parked restore_policy\", outcome.Decision.Action, outcome.Decision.ParkReason)\n432|\t}\n433|}\n434|\n435|func TestRunUnknownSession(t *testing.T) {\n436|\tt.Parallel()\n437|\tworld := buildRunWorld(t)\n438|\trequest := runRequest(t, world)\n439|\trequest.SessionID = fixtureForeign\n440|\trequest.Entrypoint = []string{\"ax\", \"pane\", fixtureForeign}\n441|\toutcome, err := Run(world.stores(), request)\n442|\tif err != nil {\n443|\t\tt.Fatalf(\"Run() error = %v\", err)\n444|\t}\n445|\tif outcome.Decision.Action != ActionRefused || outcome.Decision.Class != ClassInvalidArguments {\n446|\t\tt.Fatalf(\"Run() = (%q, %q), want refused invalid_arguments\", outcome.Decision.Action, outcome.Decision.Class)\n447|\t}\n448|}\n449|\n450|func TestRunInvalidConfig(t *testing.T) {\n451|\tt.Parallel()\n452|\tworld := buildRunWorld(t)\n453|\trequest := runRequest(t, world)\n454|\trequest.ConfigOverrides = config.Overrides{\n455|\t\tconfig.ConfigFile: \"/nonexistent-axpane-dir-7f3a/config.toml\",\n456|\t}\n457|\toutcome, err := Run(world.stores(), request)\n458|\tif err != nil {\n459|\t\tt.Fatalf(\"Run() error = %v\", err)\n460|\t}\n461|\tif outcome.Decision.Action != ActionRefused || outcome.Decision.Class != ClassInvalidConfig {\n462|\t\tt.Fatalf(\"Run() = (%q, %q), want refused invalid_config\", outcome.Decision.Action, outcome.Decision.Class)\n463|\t}\n464|}\n465|\n466|func TestRunSmokeRequiredPasses(t *testing.T) {\n467|\tt.Parallel()\n468|\tworld := buildRunWorld(t)\n469|\trequest := runRequest(t, world)\n470|\trecord := smokeRecord(t, \"pass\", \"A\", passingSmokeChecks(), smokeTuple())\n471|\trequest.Smoke.Required = true\n472|\trequest.Smoke.Record = record\n473|\trequest.Smoke.Target = smokeTarget()\n474|\toutcome, err := Run(world.stores(), request)\n475|\tif err != nil {\n476|\t\tt.Fatalf(\"Run() error = %v\", err)\n477|\t}\n478|\tif outcome.Decision.Action != ActionLaunch {\n479|\t\tt.Fatalf(\"Run() action = %q, cause %v, want launch\", outcome.Decision.Action, outcome.Decision.Cause)\n480|\t}\n481|}\n482|\n483|func TestRunTornBindingPropagates(t *testing.T) {\n484|\tt.Parallel()\n485|\tworld := buildRunWorld(t)\n486|\tif _, _, err := world.pane.Bind(fixtureSession, fixtureBootstrap, bindCandidate()); err != nil {\n487|\t\tt.Fatal(err)\n488|\t}\n489|\tif err := os.WriteFile(world.pane.bindingPath(fixtureSession), []byte(`{\"torn\":true}`), 0o600); err != nil {\n490|\t\tt.Fatal(err)\n491|\t}\n492|\toutcome, err := Run(world.stores(), runRequest(t, world))\n493|\tif err == nil {\n494|\t\tt.Fatalf(\"Run() over torn binding succeeded with %+v, want the read error\", outcome.Decision)\n495|\t}\n496|\tif outcome.Decision.Action != \"\" {\n497|\t\tt.Fatalf(\"Run() over torn binding decides %q, want no decision\", outcome.Decision.Action)\n498|\t}\n499|}\n500|\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
