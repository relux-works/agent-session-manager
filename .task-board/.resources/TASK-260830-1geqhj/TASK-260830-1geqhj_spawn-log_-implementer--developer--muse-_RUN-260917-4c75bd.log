onID, candidate)\n+\t\t\tif err != nil {\n+\t\t\t\treturn empty, err\n+\t\t\t}\n+\t\t\tduplicate := bound\n+\t\t\toutcome.Binding = &duplicate\n+\t\t\tbreak\n+\t\t}\n","edit_facts":{"tool_name":"edit_file","path":"internal/axpane/run.go","added":19,"removed":15},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
