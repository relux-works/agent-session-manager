{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ce83","stream":{"kind":"session","id":"01a0b131-d4f6-7b82-a7a6-5363cf3ac7fb"},"sequence":1436,"recorded_at":1780531400002867,"record_type":"event","durability":"durable","causation_id":"2237b1e3-856b-4a22-9f46-61adba667efd","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2237b1e3-856b-4a22-9f46-61adba667efd","run_stream":{"kind":"run","id":"2237b1e3-856b-4a22-9f46-61adba667efd"},"task_stream":{"kind":"task","id":"01a0b138-234a-7522-a069-68aa972032c5"},"task_id":"01a0b138-234a-7522-a069-68aa972032c5","event":{"kind":"output","task_id":"01a0b138-234a-7522-a069-68aa972032c5","chunk":"Read text file `internal/axpane/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/axpane.\n3|\n4|Every gate ships a narrowing mutant: the gate stays present and is\n5|weakened to admit exactly one member of the class it must reject, and\n6|the named killer test must fail. A delete-only mutant proves only that\n7|the gate exists and is not accepted as evidence.\n8|\n9|Each row runs M (mutate one production file in place), R (run the\n10|scoped Go killer through the production entry point), V (verdict from\n11|the Go exit code plus a FAIL kill-line: KILLED iff R fails with a test\n12|failure line, SURVIVED iff R passes, ERROR for anything else —\n13|unapplied patches, build breaks, timeouts). M failures and R\n14|infrastructure errors are ERROR, never kills or survivals. The file is\n15|restored from its backup after every row, pass or fail.\n16|\n17|Row C-doc-comment is the harmless control: a comment-only edit that\n18|must SURVIVE, proving the harness observes test outcomes instead of\n19|hard-coding kills.\n20|\n21|Usage:\n22|  PYTHONDONTWRITEBYTECODE=1 python3 internal/axpane/mutant_harness.py\n23|  PYTHONDONTWRITEBYTECODE=1 python3 internal/axpane/mutant_harness.py N-config\n24|\"\"\"\n25|\n26|import os\n27|import shutil\n28|import subprocess\n29|import sys\n30|import tempfile\n31|from dataclasses import dataclass\n32|from pathlib import Path\n33|\n34|REPO = Path(__file__).resolve().parents[2]\n35|PACKAGE = \"internal/axpane\"\n36|\n37|\n38|@dataclass(frozen=True)\n39|class Mutant:\n40|    name: str\n41|    path: str\n42|    find: str\n43|    replace: str\n44|    count: int\n45|    run: str\n46|    expect: str\n47|    note: str\n48|\n49|\n50|MUTANTS = [\n51|    Mutant(\n52|        name=\"N-config\",\n53|        path=f\"{PACKAGE}/decide.go\",\n54|        find=\"\\tif input.ConfigErr != nil {\\n\",\n55|        replace=\"\\tif input.ConfigErr != nil && input.Mode == ModeRestore {\\n\",\n56|        count=1,\n57|        run=\"TestDecideTable/refused_config_invalid\",\n58|        expect=\"KILLED\",\n59|        note=\"Admits exactly launch-mode invalid config; restore-mode still refuses.\",\n60|    ),\n61|    Mutant(\n62|        name=\"N-mode\",\n63|        path=f\"{PACKAGE}/decide.go\",\n64|        find=\"\\tif input.Mode != ModeLaunch && input.Mode != ModeRestore {\\n\",\n65|        replace='\\tif input.Mode != ModeLaunch && input.Mode != ModeRestore && input.Mode != Mode(\"\") {\\n',\n66|        count=1,\n67|        run=\"TestDecideTable/refused_empty_mode\",\n68|        expect=\"KILLED\",\n69|        note=\"Admits exactly the empty mode; every other non-mode still refuses.\",\n70|    ),\n71|    Mutant(\n72|        name=\"N-session\",\n73|        path=f\"{PACKAGE}/decide.go\",\n74|        find=\"\\tif !input.SessionKnown {\\n\",\n75|        replace=\"\\tif !input.SessionKnown && input.Mode == ModeRestore {\\n\",\n76|        count=1,\n77|        run=\"TestDecideTable/refused_unknown_session\",\n78|        expect=\"KILLED\",\n79|        note=\"Admits exactly launch-mode unknown sessions; restore-mode still refuses.\",\n80|    ),\n81|    Mutant(\n82|        name=\"N-idempotency\",\n83|        path=f\"{PACKAGE}/decide.go\",\n84|        find=\"\\tif input.ExistingBinding != nil && input.ExistingBinding.OperationID != input.BootstrapOperationID && !bootstrapWindowClosed(input.Observation) {\\n\",\n85|        replace=\"\\tif input.ExistingBinding != nil && input.ExistingBinding.OperationID != input.BootstrapOperationID && !bootstrapWindowClosed(input.Observation) && input.Mode == ModeRestore {\\n\",\n86|        count=1,\n87|        run=\"TestDecideTable/refused_idempotency_mismatch\",\n88|        expect=\"KILLED\",\n89|        note=\"Admits exactly launch-mode changed operations inside the window; restore-mode still refuses.\",\n90|    ),\n91|    Mutant(\n92|        name=\"N-idempotency-restore\",\n93|        path=f\"{PACKAGE}/decide.go\",\n94|        find=\"\\tif input.ExistingBinding != nil && input.ExistingBinding.OperationID != input.BootstrapOperationID && !bootstrapWindowClosed(input.Observation) {\\n\",\n95|        replace=\"\\tif input.ExistingBinding != nil && input.ExistingBinding.OperationID != input.BootstrapOperationID && !bootstrapWindowClosed(input.Observation) && input.Mode == ModeLaunch {\\n\",\n96|        count=1,\n97|        run=\"TestDecideRestoreChangedOperationRefuses\",\n98|        expect=\"KILLED\",\n99|        note=\"Admits exactly restore-mode changed operations inside the window; launch-mode still refuses.\",\n100|    ),\n101|    Mutant(\n102|        name=\"N-caller\",\n103|        path=f\"{PACKAGE}/decide.go\",\n104|        find=\"\\tif caller != CallerForeground && caller != CallerBackground {\\n\",\n105|        replace='\\tif caller != CallerForeground && caller != CallerBackground && caller != \"batch\" {\\n',\n106|        count=1,\n107|        run=\"TestDecideTable/refused_unknown_caller\",\n108|        expect=\"KILLED\",\n109|        note=\"Admits exactly the batch caller; every other non-caller still refuses.\",\n110|    ),\n111|    Mutant(\n112|        name=\"N-backend-op\",\n113|        path=f\"{PACKAGE}/decide.go\",\n114|        find='\\toperation := \"create\"\\n\\tif input.Mode == ModeRestore {\\n\\t\\toperation = \"restore\"\\n\\t}\\n',\n115|        replace='\\toperation := \"create\"\\n\\tif input.Mode == ModeRestore {\\n\\t\\toperation = \"create\"\\n\\t}\\n',\n116|        count=1,\n117|        run=\"TestDecideRestoreRequiresRestoreCapability\",\n118|        expect=\"KILLED\",\n119|        note=\"Admits restore-mode callers to the create row; the mode selection stays.\",\n120|    ),\n121|    Mutant(\n122|        name=\"N-materialization\",\n123|        path=f\"{PACKAGE}/decide.go\",\n124|        find=\"\\tif !input.JournalOK || input.Journal.Phase != matjournal.PhaseCommitted {\\n\",\n125|        replace=\"\\tif !input.JournalOK || (input.Journal.Phase != matjournal.PhaseCommitted && input.Journal.Phase != matjournal.PhaseStaging) {\\n\",\n126|        count=1,\n127|        run=\"TestDecideTable/parked_materialization_not_committed\",\n128|        expect=\"KILLED\",\n129|        note=\"Admits exactly staging journals; absent and other phases still park.\",\n130|    ),\n131|    Mutant(\n132|        name=\"N-materialization-source\",\n133|        path=f\"{PACKAGE}/decide.go\",\n134|        find=\"\\t\\tif input.Journal.SourceCheckpointID != input.Observation.Winner.Checkpoint {\\n\",\n135|        replace='\\t\\tif input.Journal.SourceCheckpointID != input.Observation.Winner.Checkpoint && input.Journal.SourceCheckpointID != \"sha256:d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2\" {\\n',\n136|        count=1,\n137|        run=\"TestDecideMaterializationStaleParks\",\n138|        expect=\"KILLED\",\n139|        note=\"Admits exactly the stale source generation; other stale sources still park.\",\n140|    ),\n141|    Mutant(\n142|        name=\"N-checkpoint-absent\",\n143|        path=f\"{PACKAGE}/decide.go\",\n144|        find=\"\\tif input.CheckpointRequired {\\n\",\n145|        replace=\"\\tif input.CheckpointRequired && len(input.CheckpointDoc) > 0 {\\n\",\n146|        count=1,\n147|        run=\"TestDecideTable/parked_checkpoint_absent\",\n148|        expect=\"KILLED\",\n149|        note=\"Admits exactly absent checkpoints; inadmissible bytes still park.\",\n150|    ),\n151|    Mutant(\n152|        name=\"N-checkpoint-prefix\",\n153|        path=f\"{PACKAGE}/decide.go\",\n154|        find=\"\\tif digest.String() != want {\\n\",\n155|        replace=\"\\tif digest.String()[:16] != want[:16] {\\n\",\n156|        count=1,\n157|        run=\"TestDecideTable/parked_checkpoint_flipped_digest\",\n158|        expect=\"KILLED\",\n159|        note=\"Admits exactly same-prefix digests; full comparison otherwise stays.\",\n160|    ),\n161|    Mutant(\n162|        name=\"N-identity-version\",\n163|        path=f\"{PACKAGE}/decide.go\",\n164|        find=\"\\tif err := provhost.VerifyIdentityBuild(facts.Identity, facts.Build); err != nil {\\n\",\n165|        replace='\\tif err := provhost.VerifyIdentityBuild(facts.Identity, facts.Build); err != nil && facts.Build.ProviderVersion != \"0.147.0\" {\\n',\n166|        count=1,\n167|        run=\"TestDecideTable/refused_provider_identity_other_provider\",\n168|        expect=\"KILLED\",\n169|        note=\"Admits exactly 0.147.0 identity mismatches; other versions still refuse.\",\n170|    ),\n171|    Mutant(\n172|        name=\"N-discovery\",\n173|        path=f\"{PACKAGE}/decide.go\",\n174|        find=\"\\tif facts.HasDiscovery {\\n\",\n175|        replace='\\tif facts.HasDiscovery && facts.DiscoveryContext.Home != \"\" {\\n',\n176|        count=1,\n177|        run=\"TestDecideTable/refused_discovery_empty_home\",\n178|        expect=\"KILLED\",\n179|        note=\"Admits exactly empty-home discovery; every other proof still verifies.\",\n180|    ),\n181|    Mutant(\n182|        name=\"N-smoke-verdict\",\n183|        path=f\"{PACKAGE}/decide.go\",\n184|        find=\"\\tif record.Verdict != resumesmoke.VerdictPass {\\n\",\n185|        replace=\"\\tif record.Verdict != resumesmoke.VerdictPass && record.Verdict != resumesmoke.VerdictFail {\\n\",\n186|        count=1,\n187|        run=\"TestDecideTable/refused_smoke_failing_verdict\",\n188|        expect=\"KILLED\",\n189|        note=\"Admits exactly failing verdicts; gated, unsupported, and unknown still refuse.\",\n190|    ),\n191|    Mutant(\n192|        name=\"N-smoke-version\",\n193|        path=f\"{PACKAGE}/decide.go\",\n194|        find=\"\"\"\\tif record.Tuple.ProviderID != build.ProviderID ||\n195|\\t\\trecord.Tuple.ProviderVersion != build.ProviderVersion ||\n196|\\t\\trecord.Tuple.Platform != build.Platform ||\n197|\\t\\trecord.Tuple.Architecture != build.Architecture {\n198|\"\"\",\n199|        replace=\"\"\"\\tif record.Tuple.ProviderID != build.ProviderID ||\n200|\\t\\trecord.Tuple.Platform != build.Platform ||\n201|\\t\\trecord.Tuple.Architecture != build.Architecture {\n202|\"\"\",\n203|        count=1,\n204|        run=\"TestDecideTable/refused_smoke_wrong_build\",\n205|        expect=\"KILLED\",\n206|        note=\"Admits exactly version drift; provider, platform, and arch still bind.\",\n207|    ),\n208|    Mutant(\n209|        name=\"N-smoke-mode\",\n210|        path=f\"{PACKAGE}/decide.go\",\n211|        find=\"\\tif !input.Smoke.Required {\\n\",\n212|        replace=\"\\tif !input.Smoke.Required || input.Mode == ModeLaunch {\\n\",\n213|        count=1,\n214|        run=\"TestDecideTable/refused_smoke_absent\",\n215|        expect=\"KILLED\",\n216|        note=\"Skips the required smoke exactly on launch; restore-mode still enforces it.\",\n217|    ),\n218|    Mutant(\n219|        name=\"N-profile-derive\",\n220|        path=f\"{PACKAGE}/decide.go\",\n221|        find=\"\"\"\\tpair, err := deriveProfile(input)\n222|\\tif err != nil {\n223|\\t\\treturn refused(ClassIntegrityFailure, \"effective profile derivation failed\", err)\n224|\\t}\n225|\"\"\",\n226|        replace=\"\"\"\\tpair, err := deriveProfile(input)\n227|\\tif err != nil && input.Provider.Build.ProviderID != \"codex\" {\n228|\\t\\treturn refused(ClassIntegrityFailure, \"effective profile derivation failed\", err)\n229|\\t}\n230|\"\"\",\n231|        count=1,\n232|        run=\"TestDecideTable/refused_profile_derivation_corrupt\",\n233|        expect=\"KILLED\",\n234|        note=\"Admits corrupt derivation exactly for codex, surfacing the wrong class.\",\n235|    ),\n236|    Mutant(\n237|        name=\"N-profile-closure\",\n238|        path=f\"{PACKAGE}/decide.go\",\n239|        find=\"\"\"\\tif len(heads) > 0 {\n240|\\t\\treturn sessprofile.DeriveForHeads(input.ProfileRecord, input.ProfileEvents, heads)\n241|\\t}\n242|\"\"\",\n243|        replace=\"\"\"\\tif len(heads) > 0 && input.Mode != ModeRestore {\n244|\\t\\treturn sessprofile.DeriveForHeads(input.ProfileRecord, input.ProfileEvents, heads)\n245|\\t}\n246|\"\"\",\n247|        count=1,\n248|        run=\"TestDecideResumeProfileUsesClosure\",\n249|        expect=\"KILLED\",\n250|        note=\"Derives the session head instead of the closure exactly on restore; launch closure still holds.\",\n251|    ),\n252|    Mutant(\n253|        name=\"N-mapping\",\n254|        path=f\"{PACKAGE}/decide.go\",\n255|        find=\"\"\"\\tresolved, err := provhost.ResolveMapping(input.Provider.Build.ProviderID, pair.Profile, input.Provider.Build)\n256|\\tif err != nil {\n257|\\t\\treturn refused(ClassProfileMappingUnavailable, \"adapter cannot map the stored profile\", err)\n258|\\t}\n259|\"\"\",\n260|        replace=\"\"\"\\tresolved, err := provhost.ResolveMapping(input.Provider.Build.ProviderID, pair.Profile, input.Provider.Build)\n261|\\tif err != nil && pair.Profile != \"standard\" {\n262|\\t\\treturn refused(ClassProfileMappingUnavailable, \"adapter cannot map the stored profile\", err)\n263|\\t}\n264|\"\"\",\n265|        count=1,\n266|        run=\"TestDecideTable/refused_profile_mapping_unavailable\",\n267|        expect=\"KILLED\",\n268|        note=\"Admits exactly standard mapping gaps; yolo gaps still refuse.\",\n269|    ),\n270|    Mutant(\n271|        name=\"N-realm\",\n272|        path=f\"{PACKAGE}/decide.go\",\n273|        find=\"\\tif input.Realm.Caller != CallerBackground {\\n\",\n274|        replace='\\tif input.Realm.Caller != CallerBackground || input.Realm.BrokerState == \"broker-running\" {\\n',\n275|        count=1,\n276|        run=\"TestDecideTable/refused_realm_background_no_server\",\n277|        expect=\"KILLED\",\n278|        note=\"Admits exactly broker-running background callers; other states still refuse.\",\n279|    ),\n280|    Mutant(\n281|        name=\"N-entrypoint\",\n282|        path=f\"{PACKAGE}/decide.go\",\n283|        find=\"\\tif err := terminalbackend.CheckEntrypoint(input.Entrypoint, input.SessionID); err != nil {\\n\",\n284|        replace=\"\\tif err := terminalbackend.CheckEntrypoint(input.Entrypoint, input.SessionID); err != nil && len(input.Entrypoint) != 2 {\\n\",\n285|        count=1,\n286|        run=\"TestDecideTable/refused_entrypoint_raw_provider\",\n287|        expect=\"KILLED\",\n288|        note=\"Admits exactly two-element argv; other arities still refuse.\",\n289|    ),\n290|    Mutant(\n291|        name=\"N-descriptor\",\n292|        path=f\"{PACKAGE}/decide.go\",\n293|        find=\"\"\"\\tdescriptor, err := terminalbackend.AdmitProviderDescriptor(input.Descriptor, input.HostBinding)\n294|\\tif err != nil {\n295|\\t\\treturn refused(backendClass(err), \"provider descriptor does not match the validated binding\", err)\n296|\\t}\n297|\"\"\",\n298|        replace=\"\"\"\\tdescriptor, err := terminalbackend.AdmitProviderDescriptor(input.Descriptor, input.HostBinding)\n299|\\tif err != nil && input.Mode != ModeLaunch {\n300|\\t\\treturn refused(backendClass(err), \"provider descriptor does not match the validated binding\", err)\n301|\\t}\n302|\"\"\",\n303|        count=1,\n304|        run=\"TestDecideTable/refused_descriptor_generation_drift\",\n305|        expect=\"KILLED\",\n306|        note=\"Admits exactly launch-mode descriptor mismatch; restore-mode still refuses.\",\n307|    ),\n308|    Mutant(\n309|        name=\"N-attach\",\n310|        path=f\"{PACKAGE}/decide.go\",\n311|        find='\\tif terminalbackend.CheckOperation(\"attach\", admitted) == nil {\\n',\n312|        replace=\"\\tif true {\\n\",\n313|        count=1,\n314|        run=\"TestDecideTable/takeover_offer_attach_unproven\",\n315|        expect=\"KILLED\",\n316|        note=\"Admits remote attach without the capability; attach-proven still offers attach.\",\n317|    ),\n318|    Mutant(\n319|        name=\"N-reattach\",\n320|        path=f\"{PACKAGE}/decide.go\",\n321|        find=\"\"\"\\tif input.ExistingBinding != nil && input.ExistingBinding.OperationID == input.BootstrapOperationID {\n322|\\t\\tdecision.Action = ActionReattach\n323|\"\"\",\n324|        replace=\"\"\"\\tif input.ExistingBinding != nil && input.ExistingBinding.OperationID == input.BootstrapOperationID && input.Mode == ModeRestore {\n325|\\t\\tdecision.Action = ActionReattach\n326|\"\"\",\n327|        count=1,\n328|        run=\"TestDecideTable/reattach_same_pair\",\n329|        expect=\"KILLED\",\n330|        note=\"Selects launch instead of reattach exactly on launch mode.\",\n331|    ),\n332|    Mutant(\n333|        name=\"N-binding-prefix\",\n334|        path=f\"{PACKAGE}/binding.go\",\n335|        find=\"\\t\\t\\tif winner.OperationID != operationID {\\n\",\n336|        replace=\"\\t\\t\\tif winner.OperationID[:8] != operationID[:8] {\\n\",\n337|        count=1,\n338|        run=\"TestBindConcurrentChangedOperationRefuses\",\n339|        expect=\"KILLED\",\n340|        note=\"Admits exactly same-prefix changed operations; full comparison otherwise stays.\",\n341|    ),\n342|    Mutant(\n343|        name=\"N-binding-session\",\n344|        path=f\"{PACKAGE}/binding.go\",\n345|        find=\"\\tif binding.SessionID != sessionID {\\n\",\n346|        replace=\"\\tif binding.SessionID[:8] != sessionID[:8] {\\n\",\n347|        count=1,\n348|        run=\"TestStatusSessionMismatchRefuses\",\n349|        expect=\"KILLED\",\n350|        note=\"Admits exactly same-prefix foreign sessions; full comparison otherwise stays.\",\n351|    ),\n352|    Mutant(\n353|        name=\"N-parked-reason\",\n354|        path=f\"{PACKAGE}/events.go\",\n355|        find='\\tdefault:\\n\\t\\treturn nil, fmt.Errorf(\"parked reason %q is not the session.parked vocabulary\", string(reason))\\n\\t}\\n',\n356|        replace='\\tdefault:\\n\\t\\tif len(reason) != 5 {\\n\\t\\t\\treturn nil, fmt.Errorf(\"parked reason %q is not the session.parked vocabulary\", string(reason))\\n\\t\\t}\\n\\t}\\n',\n357|        count=1,\n358|        run=\"TestParkedPayloadVocabulary\",\n359|        expect=\"KILLED\",\n360|        note=\"Admits exactly five-letter reasons; the vocabulary check otherwise stays.\",\n361|    ),\n362|    Mutant(\n363|        name=\"N-checkpoint-lease\",\n364|        path=f\"{PACKAGE}/decide.go\",\n365|        find=\"\\tif input.Observation.HasWinner && input.Observation.Winner.HasCheckpoint {\\n\\t\\tif want != input.Observation.Winner.Checkpoint {\\n\",\n366|        replace=\"\\tif input.Observation.HasWinner && input.Observation.Winner.HasCheckpoint && input.Mode == ModeLaunch {\\n\\t\\tif want != input.Observation.Winner.Checkpoint {\\n\",\n367|        count=1,\n368|        run=\"TestDecideCheckpointNotLeaseParks\",\n369|        expect=\"KILLED\",\n370|        note=\"Admits exactly restore-mode non-lease checkpoints; launch-mode still parks.\",\n371|    ),\n372|    Mutant(\n373|        name=\"N-checkpoint-session\",\n374|        path=f\"{PACKAGE}/decide.go\",\n375|        find=\"\\tif sessionID != input.SessionID {\\n\",\n376|        replace='\\tif sessionID != input.SessionID && sessionID != \"0198f4c8-3e70-7a11-8a2b-1234567890ff\" {\\n',\n377|        count=1,\n378|        run=\"TestDecideForeignCheckpointParks\",\n379|        expect=\"KILLED\",\n380|        note=\"Admits exactly the foreign fixture session; other foreign sessions still park.\",\n381|    ),\n382|\n383|    Mutant(\n384|        name=\"N-realm-binding\",\n385|        path=f\"{PACKAGE}/decide.go\",\n386|        find=\"\\t\\tif object.TerminalBindingID != input.HostBinding.TerminalBindingID {\\n\",\n387|        replace='\\t\\tif object.TerminalBindingID != input.HostBinding.TerminalBindingID && object.TerminalBindingID != \"sha256:b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2\" {\\n',\n388|        count=1,\n389|        run=\"TestDecideRealmBindingMismatchRefuses/binding\",\n390|        expect=\"KILLED\",\n391|        note=\"Admits exactly the mismatched test binding; other mismatches still refuse.\",\n392|    ),\n393|    Mutant(\n394|        name=\"N-realm-generation\",\n395|        path=f\"{PACKAGE}/decide.go\",\n396|        find=\"\\tif input.Realm.ServerGeneration != input.Backend.RawGeneration {\\n\",\n397|        replace='\\tif input.Realm.ServerGeneration != input.Backend.RawGeneration && input.Realm.ServerGeneration != \"generation-stale\" {\\n',\n398|        count=1,\n399|        run=\"TestDecideRealmBindingMismatchRefuses/generation\",\n400|        expect=\"KILLED\",\n401|        note=\"Admits exactly the stale test generation; other stale generations still refuse.\",\n402|    ),\n403|    Mutant(\n404|        name=\"N-headless\",\n405|        path=f\"{PACKAGE}/decide.go\",\n406|        find=\"\\tif input.Mode == ModeLaunch && !input.Interactive && !admitted.Has(headlessCreationCapability) {\\n\",\n407|        replace='\\tif input.Mode == ModeLaunch && !input.Interactive && !admitted.Has(headlessCreationCapability) && !admitted.Has(\"durable_disconnect\") {\\n',\n408|        count=1,\n409|        run=\"TestDecideNonInteractiveRequiresHeadless\",\n410|        expect=\"KILLED\",\n411|        note=\"Admits exactly durable-holding non-interactive creates without headless; other creates still refuse.\",\n412|    ),\n413|    Mutant(\n414|        name=\"N-emit-mutation\",\n415|        path=f\"{PACKAGE}/events.go\",\n416|        find=\"\\tif _, err := fencing.AuthorizeMutation(params.Presented, params.Observation); err != nil {\\n\",\n417|        replace=\"\\tif _, err := fencing.AuthorizeMutation(params.Presented, params.Observation); err != nil && params.Observation.Verified {\\n\",\n418|        count=1,\n419|        run=\"TestEmitParkedVocabularyLoop/refuses_unverified\",\n420|        expect=\"KILLED\",\n421|        note=\"Admits exactly unverified emissions; verified refusals still refuse.\",\n422|    ),\n423|    Mutant(\n424|        name=\"N-parked-fold\",\n425|        path=f\"{PACKAGE}/events.go\",\n426|        find=\"\\tif !foldable {\\n\",\n427|        replace=\"\\tif !foldable && decision.ParkReason != fencing.ParkRestorePolicy {\\n\",\n428|        count=1,\n429|        run=\"TestEmitParkedUnfoldableRefuses\",\n430|        expect=\"KILLED\",\n431|        note=\"Admits exactly unfolderable restore_policy parks; other unfolderable reasons still refuse.\",\n432|    ),\n433|    Mutant(\n434|        name=\"N-run-fold\",\n435|        path=f\"{PACKAGE}/run.go\",\n436|        find=\"\\t\\tif !foldable {\\n\",\n437|        replace=\"\\t\\tif !foldable && decision.ParkReason != fencing.ParkRestorePolicy {\\n\",\n438|        count=1,\n439|        run=\"TestRunParkedUnfoldableSkipsEmission\",\n440|        expect=\"KILLED\",\n441|        note=\"Run admits exactly unfolderable restore_policy parks; other unfolderable still skip.\",\n442|    ),\n443|    Mutant(\n444|        name=\"C-doc-comment\",\n445|        path=f\"{PACKAGE}/doc.go\",\n446|        find=\"// `ax pane SESSION_ID` enforcement wrapper: the decision every managed\\n\",\n447|        replace=\"// `ax pane SESSION_ID` enforcement wrapper (control): the decision every managed\\n\",\n448|        count=1,\n449|        run=\"TestRealmCarriesNoCachedEvidence\",\n450|        expect=\"SURVIVED\",\n451|        note=\"Harmless control: a comment-only edit must survive.\",\n452|    ),\n453|]\n454|\n455|\n456|def run_mutant(mutant: Mutant) -> str:\n457|    target = REPO / mutant.path\n458|    original = target.read_text()\n459|    found = original.count(mutant.find)\n460|    if found != mutant.count:\n461|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\"\n462|    with tempfile.TemporaryDirectory() as staging:\n463|        backup = Path(staging) / \"backup\"\n464|        shutil.copy2(target, backup)\n465|        try:\n466|            target.write_text(original.replace(mutant.find, mutant.replace))\n467|            run = subprocess.run(\n468|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n469|                cwd=REPO,\n470|                capture_output=True,\n471|                text=True,\n472|                timeout=300,\n473|            )\n474|        finally:\n475|            shutil.copy2(backup, target)\n476|    output = (run.stdout + run.stderr).strip()\n477|    if os.environ.get(\"AX_MUTANT_VERBOSE\") == \"1\":\n478|        print(f\"--- raw: {mutant.name}: exit {run.returncode} ---\", flush=True)\n479|        print(output, flush=True)\n480|        print(f\"--- end raw: {mutant.name} ---\", flush=True)\n481|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n482|        return f\"ERROR: {mutant.name}: build broke under the patch\"\n483|    if run.returncode == 0:\n484|        verdict = \"SURVIVED\"\n485|    elif '--- FAIL' in output or 'FAIL:' in output:\n486|        verdict = \"KILLED\"\n487|    else:\n488|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\"\n489|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n490|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note} [exit {run.returncode}]\"\n491|\n492|\n493|def main(argv: list[str]) -> int:\n494|    selected = [m for m in MUTANTS if not argv or m.name in argv]\n495|    if argv and len(selected) != len(argv):\n496|        unknown = sorted(set(argv) - {m.name for m in selected})\n497|        print(f\"unknown mutants: {', '.join(unknown)}\")\n498|        return 2\n499|    failures = 0\n500|    for mutant in selected:\n(more lines below)","final_result":true}}}
