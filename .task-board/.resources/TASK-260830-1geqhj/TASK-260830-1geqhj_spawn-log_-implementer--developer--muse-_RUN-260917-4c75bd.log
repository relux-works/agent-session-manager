{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c985","stream":{"kind":"session","id":"01a0b131-d4f6-7b82-a7a6-5363cf3ac7fb"},"sequence":797,"recorded_at":1780531400001589,"record_type":"event","durability":"durable","causation_id":"2237b1e3-856b-4a22-9f46-61adba667efd","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2237b1e3-856b-4a22-9f46-61adba667efd","run_stream":{"kind":"run","id":"2237b1e3-856b-4a22-9f46-61adba667efd"},"task_stream":{"kind":"task","id":"01a0b135-0d6e-7382-bd10-ee6471e6d352"},"task_id":"01a0b135-0d6e-7382-bd10-ee6471e6d352","event":{"kind":"output","task_id":"01a0b135-0d6e-7382-bd10-ee6471e6d352","chunk":"Read text file `internal/axpane/decide.go`.\n(799 line(s) above)\n800|\tif input.Realm.ServerGeneration != input.Backend.RawGeneration {\n801|\t\treturn realmFailure(input, errRealmGenerationStale())\n802|\t}\n803|\tif err := checkRealmBinding(input, evidence); err != nil {\n804|\t\treturn realmFailure(input, err)\n805|\t}\n806|\treturn nil\n807|}\n808|\n809|// checkRealmBinding binds the admitted realm row to the exact host\n810|// binding and probed provider build: the evidence terminal binding\n811|// must equal the validated host-local binding, and the evidence\n812|// provider id/build must equal the probed build. Generation,\n813|// platform, OS version, expiry, and signature are the reconcile\n814|// binding the admission already proves; this is only the\n815|// wrapper-side cross-bind the lifecycle owner evaluates.\n816|func checkRealmBinding(input Input, evidence []terminalbackend.Evidence) error {\n817|\tfor _, object := range evidence {\n818|\t\tif object.Capability != credentialRealmCapability {\n819|\t\t\tcontinue\n820|\t\t}\n821|\t\tif object.TerminalBindingID != input.HostBinding.TerminalBindingID {\n822|\t\t\treturn errRealmBinding()\n823|\t\t}\n824|\t\tif object.ProviderID != input.Provider.Build.ProviderID ||\n825|\t\t\tobject.ProviderBuild != input.Provider.Build.ProviderVersion {\n826|\t\t\treturn errRealmBinding()\n827|\t\t}\n828|\t\treturn nil\n829|\t}\n830|\treturn errNoRealmEvidence()\n831|}\n832|\n833|// realmFailure composes the typed capability_unavailable refusal.\n834|// Typed details are required members of the input: an input that\n835|// omits one is itself malformed and refuses invalid_arguments\n836|// instead of emitting an untyped refusal.\n837|func realmFailure(input Input, cause error) error {\n838|\tdetails := axerror.RealmEvidence{\n839|\t\tCapability:           credentialRealmCapability,\n840|\t\tCallerRealm:          input.Realm.Caller,\n841|\t\tBrokerState:          input.Realm.BrokerState,\n842|\t\tTmuxServerGeneration: input.Realm.ServerGeneration,\n843|\t\tRemediation:          input.Realm.Remediation,\n844|\t}\n845|\tfailure, err := axerror.NewRealmEvidenceUnavailable(axerror.Version130,\n846|\t\t\"background caller has no admitted realm evidence\",\n847|\t\taxerror.NoIDs(), details, cause)\n848|\tif err != nil {\n849|\t\treturn errInvalidArguments{detail: \"background caller realm details are incomplete\"}\n850|\t}\n851|\treturn failure\n852|}\n853|\n854|// checkRealmVocabulary closes the caller vocabulary: only\n855|// foreground and background name a caller.\n856|func checkRealmVocabulary(caller string) error {\n857|\tif caller != CallerForeground && caller != CallerBackground {\n858|\t\treturn errUnknownCaller(caller)\n859|\t}\n860|\treturn nil\n861|}\n862|\n863|// backendClass reads the Section 15 code off a terminalbackend\n864|// refusal. Landed codes pass through verbatim.\n865|func backendClass(err error) string {\n866|\tvar backend *terminalbackend.Error\n867|\tif errors.As(err, &backend) {\n868|\t\treturn backend.Code\n869|\t}\n870|\treturn terminalbackend.CodeMismatch\n871|}\n872|\n873|// fencingClass reads the Section 15 class off a fencing refusal:\n874|// invalid_arguments for malformed calls, lease_conflict for\n875|// foreign sessions and lapsed grants. Parks never reach here;\n876|// decideParked owns them.\n877|func fencingClass(err error) string {\n878|\tif errors.Is(err, fencing.ErrInvalidArguments) {\n879|\t\treturn ClassInvalidArguments\n880|\t}\n881|\treturn \"lease_conflict\"\n882|}\n883|\n884|// providerClass reads the Structured Error code off a provhost\n885|// refusal: invalid_config for tuple and mapping grammar, the\n886|// provider protocol code for identity and discovery failures.\n887|func providerClass(err error) string {\n888|\tvar failure *axerror.Error\n889|\tif errors.As(err, &failure) {\n890|\t\treturn string(failure.Code())\n891|\t}\n892|\treturn ClassInvalidConfig\n893|}\n894|\n895|// smokeClass reads the Structured Error code off a smoke refusal:\n896|// target_auth_missing for a required smoke that fails, or\n897|// invalid_arguments for a malformed smoke input.\n898|func smokeClass(err error) string {\n899|\tvar failure *axerror.Error\n900|\tif errors.As(err, &failure) {\n901|\t\treturn string(failure.Code())\n902|\t}\n903|\tvar malformed errInvalidArguments\n904|\tif errors.As(err, &malformed) {\n905|\t\treturn ClassInvalidArguments\n906|\t}\n907|\treturn \"target_auth_missing\"\n908|}","final_result":true}}}
