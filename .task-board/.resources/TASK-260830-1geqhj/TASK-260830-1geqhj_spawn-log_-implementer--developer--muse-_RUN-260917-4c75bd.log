{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000da5f","stream":{"kind":"session","id":"01a0b131-d4f6-7b82-a7a6-5363cf3ac7fb"},"sequence":2954,"recorded_at":1780531400005903,"record_type":"event","durability":"durable","causation_id":"2237b1e3-856b-4a22-9f46-61adba667efd","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"2237b1e3-856b-4a22-9f46-61adba667efd","run_stream":{"kind":"run","id":"2237b1e3-856b-4a22-9f46-61adba667efd"},"call_id":"call_01a0b14176a272b7aa92e07f108f2935","text":"Read text file `internal/axpane/binding_test.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n13|)\n14|\n15|func openPaneStore(t *testing.T) *Store {\n16|\tt.Helper()\n17|\tstore, err := Open(t.TempDir())\n18|\tif err != nil {\n19|\t\tt.Fatalf(\"Open() error = %v\", err)\n20|\t}\n21|\treturn store\n22|}\n23|\n24|func bindCandidate() Binding {\n25|\tcandidate := Binding{\n26|\t\tSessionID:          fixtureSession,\n27|\t\tOperationID:        fixtureBootstrap,\n28|\t\tTerminalInstanceID: fixtureInstance,\n29|\t\tCreatedAt:          fixtureCreatedAt,\n30|\t}\n31|\tcandidate.BindingDigest = BindingDigest(candidate)\n32|\treturn candidate\n33|}\n34|\n35|func TestBindInstallsAndStatusProves(t *testing.T) {\n36|\tt.Parallel()\n37|\tstore := openPaneStore(t)\n38|\tif _, found, err := store.Status(fixtureSession); err != nil || found {\n39|\t\tt.Fatalf(\"Status() before bind = (%v, %v), want (false, nil)\", found, err)\n40|\t}\n41|\tbound, reattached, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate())\n42|\tif err != nil {\n43|\t\tt.Fatalf(\"Bind() error = %v\", err)\n44|\t}\n45|\tif reattached {\n46|\t\tt.Fatal(\"Bind() first call reports reattached\")\n47|\t}\n48|\tif bound.SessionID != fixtureSession || bound.OperationID != fixtureBootstrap || bound.TerminalInstanceID != fixtureInstance {\n49|\t\tt.Fatalf(\"Bind() = %+v, want the candidate pair\", bound)\n50|\t}\n51|\tif bound.CreatedAt == \"\" {\n52|\t\tt.Fatal(\"Bind() receipt carries no timestamp\")\n53|\t}\n54|\tif _, err := scalar.ParseTimestamp(bound.CreatedAt); err != nil {\n55|\t\tt.Fatalf(\"Bind() receipt timestamp is not a scalar timestamp: %v\", err)\n56|\t}\n57|\tproven, found, err := store.Status(fixtureSession)\n58|\tif err != nil {\n59|\t\tt.Fatalf(\"Status() error = %v\", err)\n60|\t}\n61|\tif !found {\n62|\t\tt.Fatal(\"Status() after bind reports absence\")\n63|\t}\n64|\tif proven != bound {\n65|\t\tt.Fatalf(\"Status() = %+v, want %+v\", proven, bound)\n66|\t}\n67|}\n68|\n69|func TestBindIdenticalRetryReattaches(t *testing.T) {\n70|\tt.Parallel()\n71|\tstore := openPaneStore(t)\n72|\tfirst, _, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate())\n73|\tif err != nil {\n74|\t\tt.Fatalf(\"Bind() error = %v\", err)\n75|\t}\n76|\t// A retry carrying different child facts still reattaches to the\n77|\t// one recorded child: the stored receipt is authoritative.\n78|\tretry := bindCandidate()\n79|\tretry.TerminalInstanceID = \"0198f4c9-2222-7bbb-8bbb-1234567890ab\"\n80|\tretry.BindingDigest = BindingDigest(retry)\n81|\tsecond, reattached, err := store.Bind(fixtureSession, fixtureBootstrap, retry)\n82|\tif err != nil {\n83|\t\tt.Fatalf(\"Bind() retry error = %v\", err)\n84|\t}\n85|\tif !reattached {\n86|\t\tt.Fatal(\"Bind() identical retry does not report reattached\")\n87|\t}\n88|\tif second != first {\n89|\t\tt.Fatalf(\"Bind() retry = %+v, want the recorded %+v\", second, first)\n90|\t}\n91|}\n92|\n93|func TestBindChangedOperationRefusesMismatch(t *testing.T) {\n94|\tt.Parallel()\n95|\tstore := openPaneStore(t)\n96|\tif _, _, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate()); err != nil {\n97|\t\tt.Fatalf(\"Bind() error = %v\", err)\n98|\t}\n99|\tother := bindCandidate()\n100|\tother.OperationID = fixtureOtherOp\n101|\tif _, _, err := store.Bind(fixtureSession, fixtureOtherOp, other); err == nil {\n102|\t\tt.Fatal(\"Bind() changed operation succeeded, want idempotency_mismatch\")\n103|\t} else {\n104|\t\tvar backend *terminalbackend.Error\n105|\t\tif !errors.As(err, &backend) || backend.Code != terminalbackend.CodeIdempotencyMismatch {\n106|\t\t\tt.Fatalf(\"Bind() changed operation error = %v, want idempotency_mismatch\", err)\n107|\t\t}\n108|\t}\n109|\tproven, found, err := store.Status(fixtureSession)\n110|\tif err != nil || !found {\n111|\t\tt.Fatalf(\"Status() after mismatch = (%v, %v), want the recorded binding\", found, err)\n112|\t}\n113|\tif proven.OperationID != fixtureBootstrap {\n114|\t\tt.Fatalf(\"Status() operation = %q, want the first operation\", proven.OperationID)\n115|\t}\n116|}\n117|\n118|func TestBindRefusesMalformedCandidates(t *testing.T) {\n119|\tt.Parallel()\n120|\tstore := openPaneStore(t)\n121|\tbase := bindCandidate()\n122|\tcases := []struct {\n123|\t\tname      string\n124|\t\tsessionID string\n125|\t\toperation string\n126|\t\tmutate    func(*Binding)\n127|\t}{\n128|\t\t{\"bad session\", \"not-a-uuid\", fixtureBootstrap, func(*Binding) {}},\n129|\t\t{\"bad operation\", fixtureSession, \"not-a-uuid\", func(candidate *Binding) { candidate.OperationID = \"not-a-uuid\" }},\n130|\t\t{\"candidate pair mismatch\", fixtureSession, fixtureBootstrap, func(candidate *Binding) { candidate.OperationID = fixtureOtherOp }},\n131|\t\t{\"bad instance\", fixtureSession, fixtureBootstrap, func(candidate *Binding) { candidate.TerminalInstanceID = \"1234\" }},\n132|\t\t{\"bad digest\", fixtureSession, fixtureBootstrap, func(candidate *Binding) { candidate.BindingDigest = \"nope\" }},\n133|\t}\n134|\tfor _, testCase := range cases {\n135|\t\tt.Run(testCase.name, func(t *testing.T) {\n136|\t\t\tt.Parallel()\n137|\t\t\tcandidate := base\n138|\t\t\ttestCase.mutate(&candidate)\n139|\t\t\tif _, _, err := store.Bind(testCase.sessionID, testCase.operation, candidate); err == nil {\n140|\t\t\t\tt.Fatalf(\"Bind(%q, %q) succeeded, want refusal\", testCase.sessionID, testCase.operation)\n141|\t\t\t}\n142|\t\t})\n143|\t}\n144|}\n145|\n146|func TestStatusUnknownIsNotAbsent(t *testing.T) {\n147|\tt.Parallel()\n148|\tstore := openPaneStore(t)\n149|\tif _, _, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate()); err != nil {\n150|\t\tt.Fatalf(\"Bind() error = %v\", err)\n151|\t}\n152|\t// Corrupt the receipt behind the store: Status must fail, never\n153|\t// report absence.\n154|\tdir := store.sessionDir(fixtureSession)\n155|\tif err := os.WriteFile(filepath.Join(dir, \"binding.json\"), []byte(`{\"schema\":42}`), 0o600); err != nil {\n156|\t\tt.Fatal(err)\n157|\t}\n158|\tif _, found, err := store.Status(fixtureSession); err == nil || found {\n159|\t\tt.Fatalf(\"Status() over torn bytes = (%v, %v), want an error\", found, err)\n160|\t}\n161|\tif _, _, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate()); err == nil {\n162|\t\tt.Fatal(\"Bind() over torn bytes succeeded, want the read error\")\n163|\t}\n164|}\n165|\n166|func TestBindHookAfterStageAbortsWithoutInstall(t *testing.T) {\n167|\tt.Parallel()\n168|\tstore := openPaneStore(t).WithHooks(&Hooks{\n169|\t\tAfterStage: func(path string) error { return errFixtureConfig },\n170|\t})\n171|\tif _, _, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate()); !errors.Is(err, errFixtureConfig) {\n172|\t\tt.Fatalf(\"Bind() hook error = %v, want the hook error\", err)\n173|\t}\n174|\tif _, found, err := store.Status(fixtureSession); err != nil || found {\n175|\t\tt.Fatalf(\"Status() after aborted stage = (%v, %v), want absence\", found, err)\n176|\t}\n177|\t// The identical retry converges: staging garbage never blocks it.\n178|\tstore.WithHooks(nil)\n179|\tif _, reattached, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate()); err != nil || reattached {\n180|\t\tt.Fatalf(\"Bind() retry = (reattached %v, %v), want a fresh install\", reattached, err)\n181|\t}\n182|}\n183|\n184|func TestBindHookAfterInstallKeepsTheCommit(t *testing.T) {\n185|\tt.Parallel()\n186|\tstore := openPaneStore(t).WithHooks(&Hooks{\n187|\t\tAfterInstall: func(path string) error { return errFixtureConfig },\n188|\t})\n189|\tif _, _, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate()); !errors.Is(err, errFixtureConfig) {\n190|\t\tt.Fatalf(\"Bind() hook error = %v, want the hook error\", err)\n191|\t}\n192|\t// The hook runs after the no-replace commit: the binding stands\n193|\t// and the identical retry reattaches to it.\n194|\tproven, found, err := store.Status(fixtureSession)\n195|\tif err != nil || !found {\n196|\t\tt.Fatalf(\"Status() after post-commit hook = (%v, %v), want the binding\", found, err)\n197|\t}\n198|\tstore.WithHooks(nil)\n199|\tsecond, reattached, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate())\n200|\tif err != nil || !reattached {\n201|\t\tt.Fatalf(\"Bind() retry = (reattached %v, %v), want reattach\", reattached, err)\n202|\t}\n203|\tif second != proven {\n204|\t\tt.Fatalf(\"Bind() retry = %+v, want %+v\", second, proven)\n205|\t}\n206|}\n207|\n208|// TestBindConcurrentSameOperationReattaches pins the linearizable\n209|// race: a second wrapper committing between Status and link wins,\n210|// and the loser reattaches to the winner's receipt instead of\n211|// failing or installing a second child. The AfterStage hook plays\n212|// the concurrent winner deterministically.\n213|func TestBindConcurrentSameOperationReattaches(t *testing.T) {\n214|\tt.Parallel()\n215|\troot := t.TempDir()\n216|\touter, err := Open(root)\n217|\tif err != nil {\n218|\t\tt.Fatal(err)\n219|\t}\n220|\twinner := bindCandidate()\n221|\twinner.TerminalInstanceID = \"0198f4c9-2222-7bbb-8bbb-1234567890ab\"\n222|\twinner.BindingDigest = BindingDigest(winner)\n223|\touter.WithHooks(&Hooks{\n224|\t\tAfterStage: func(path string) error {\n225|\t\t\tinner, err := Open(root)\n226|\t\t\tif err != nil {\n227|\t\t\t\treturn err\n228|\t\t\t}\n229|\t\t\tif _, _, err := inner.Bind(fixtureSession, fixtureBootstrap, winner); err != nil {\n230|\t\t\t\treturn err\n231|\t\t\t}\n232|\t\t\treturn nil\n233|\t\t},\n234|\t})\n235|\tbound, reattached, err := outer.Bind(fixtureSession, fixtureBootstrap, bindCandidate())\n236|\tif err != nil {\n237|\t\tt.Fatalf(\"Bind() race loser error = %v\", err)\n238|\t}\n239|\tif !reattached {\n240|\t\tt.Fatal(\"Bind() race loser installs fresh, want reattach to the winner\")\n241|\t}\n242|\tif bound.TerminalInstanceID != winner.TerminalInstanceID {\n243|\t\tt.Fatalf(\"Bind() race loser = %+v, want the winner's receipt\", bound)\n244|\t}\n245|\tproven, found, err := outer.Status(fixtureSession)\n246|\tif err != nil || !found || proven != bound {\n247|\t\tt.Fatalf(\"Status() = (%+v, %v, %v), want the one receipt\", proven, found, err)\n248|\t}\n249|}\n250|\n251|// TestBindConcurrentChangedOperationRefuses pins the losing side of\n252|// the commit race: a concurrent winner with a changed operation is\n253|// the bootstrap-window mismatch, never a reattach.\n254|func TestBindConcurrentChangedOperationRefuses(t *testing.T) {\n255|\tt.Parallel()\n256|\troot := t.TempDir()\n257|\touter, err := Open(root)\n258|\tif err != nil {\n259|\t\tt.Fatal(err)\n260|\t}\n261|\twinner := bindCandidate()\n262|\twinner.OperationID = fixtureOtherOp\n263|\touter.WithHooks(&Hooks{\n264|\t\tAfterStage: func(path string) error {\n265|\t\t\tinner, err := Open(root)\n266|\t\t\tif err != nil {\n267|\t\t\t\treturn err\n268|\t\t\t}\n269|\t\t\t_, _, err = inner.Bind(fixtureSession, fixtureOtherOp, winner)\n270|\t\t\treturn err\n271|\t\t},\n272|\t})\n273|\tif _, _, err := outer.Bind(fixtureSession, fixtureBootstrap, bindCandidate()); err == nil {\n274|\t\tt.Fatal(\"Bind() changed-op race loser reattached, want idempotency_mismatch\")\n275|\t} else {\n276|\t\tvar backend *terminalbackend.Error\n277|\t\tif !errors.As(err, &backend) || backend.Code != terminalbackend.CodeIdempotencyMismatch {\n278|\t\t\tt.Fatalf(\"Bind() changed-op race loser error = %v, want idempotency_mismatch\", err)\n279|\t\t}\n280|\t}\n281|}\n282|\n283|// TestStatusSessionMismatchRefuses pins the binding-to-directory\n284|// check: a receipt read under another session refuses, even when\n285|// the two session IDs share a prefix.\n286|func TestStatusSessionMismatchRefuses(t *testing.T) {\n287|\tt.Parallel()\n288|\tstore := openPaneStore(t)\n289|\tif _, _, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate()); err != nil {\n290|\t\tt.Fatal(err)\n291|\t}\n292|\traw, err := os.ReadFile(store.bindingPath(fixtureSession))\n293|\tif err != nil {\n294|\t\tt.Fatal(err)\n295|\t}\n296|\tforeignDir := store.sessionDir(fixtureForeign)\n297|\tif err := os.MkdirAll(foreignDir, 0o755); err != nil {\n298|\t\tt.Fatal(err)\n299|\t}\n300|\tif err := os.WriteFile(filepath.Join(foreignDir, \"binding.json\"), raw, 0o600); err != nil {\n301|\t\tt.Fatal(err)\n302|\t}\n303|\tif _, found, err := store.Status(fixtureForeign); err == nil || found {\n304|\t\tt.Fatalf(\"Status(foreign) = (%v, %v), want the session-mismatch error\", found, err)\n305|\t}\n306|}\n307|\n308|// TestBindingPersistsNoPID pins the §4.C identity rule on the stored\n309|// bytes: the closed receipt carries the AX-allocated UUIDv7 instance\n310|// and the opaque digest, and no PID, handle, socket, path, endpoint,\n311|// or token member exists to mistake for identity.\n312|func TestBindingPersistsNoPID(t *testing.T) {\n313|\tt.Parallel()\n314|\tstore := openPaneStore(t)\n315|\tif _, _, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate()); err != nil {\n316|\t\tt.Fatalf(\"Bind() error = %v\", err)\n317|\t}\n318|\traw, err := os.ReadFile(store.bindingPath(fixtureSession))\n319|\tif err != nil {\n320|\t\tt.Fatal(err)\n321|\t}\n322|\tvar members map[string]any\n323|\tif err := json.Unmarshal(raw, &members); err != nil {\n324|\t\tt.Fatal(err)\n325|\t}\n326|\twant := map[string]bool{\n327|\t\t\"schema\": true, \"schema_version\": true, \"session_id\": true,\n328|\t\t\"bootstrap_operation_id\": true, \"terminal_instance_id\": true,\n329|\t\t\"binding_digest\": true, \"created_at\": true,\n330|\t}\n331|\tif len(members) != len(want) {\n332|\t\tt.Fatalf(\"receipt members = %v, want exactly %v\", members, want)\n333|\t}\n334|\tfor name := range members {\n335|\t\tif !want[name] {\n336|\t\t\tt.Fatalf(\"receipt carries unexpected member %q\", name)\n337|\t\t}\n338|\t\tlowered := strings.ToLower(name)\n339|\t\tfor _, forbidden := range []string{\"pid\", \"handle\", \"socket\", \"endpoint\", \"token\", \"pipe\", \"url\", \"path\"} {\n340|\t\t\tif strings.Contains(lowered, forbidden) {\n341|\t\t\t\tt.Fatalf(\"receipt member %q names a forbidden identity class\", name)\n342|\t\t\t}\n343|\t\t}\n344|\t}\n345|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
