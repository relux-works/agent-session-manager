{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cda1","stream":{"kind":"session","id":"01a0b131-d4f6-7b82-a7a6-5363cf3ac7fb"},"sequence":1323,"recorded_at":1780531400002641,"record_type":"event","durability":"durable","causation_id":"2237b1e3-856b-4a22-9f46-61adba667efd","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2237b1e3-856b-4a22-9f46-61adba667efd","run_stream":{"kind":"run","id":"2237b1e3-856b-4a22-9f46-61adba667efd"},"task_stream":{"kind":"task","id":"01a0b137-d62d-7b70-bbae-63973cf4fad3"},"task_id":"01a0b137-d62d-7b70-bbae-63973cf4fad3","event":{"kind":"output","task_id":"01a0b137-d62d-7b70-bbae-63973cf4fad3","chunk":"Read text file `internal/axpane/decide_test.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"sort\"\n6|\t\"testing\"\n7|\t\"time\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/matjournal\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessckpt\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n16|)\n17|\n18|// decideDeps carries the heavy fixtures one table row may need:\n19|// the backend universe (mutable before facts are drawn), a real\n20|// session chain, and a real captured checkpoint.\n21|type decideDeps struct {\n22|\tuniverse  *backendUniverse\n23|\trepo      *sessrepo.Repository\n24|\trecordID  string\n25|\tcreatedID string\n26|\tckptID    string\n27|\tckptDoc   []byte\n28|}\n29|\n30|func buildDecideDeps(t *testing.T, attachAdmitted bool) *decideDeps {\n31|\tt.Helper()\n32|\tdeps := &decideDeps{universe: buildBackendUniverse(t, attachAdmitted)}\n33|\tdeps.repo, deps.recordID = chainFixture(t)\n34|\tevents, err := deps.repo.ListEvents(fixtureSession)\n35|\tif err != nil {\n36|\t\tt.Fatal(err)\n37|\t}\n38|\tdeps.createdID = events[len(events)-1].EventID\n39|\tckptStore, err := sessckpt.Open(t.TempDir())\n40|\tif err != nil {\n41|\t\tt.Fatal(err)\n42|\t}\n43|\tdeps.ckptID, deps.ckptDoc = checkpointFixture(t, deps.repo, ckptStore, []string{deps.createdID})\n44|\treturn deps\n45|}\n46|\n47|// validInput returns the ModeLaunch base that launches: every gate\n48|// passes through its landed owner with real documents.\n49|func validInput(t *testing.T, deps *decideDeps) Input {\n50|\tt.Helper()\n51|\tnow := fixtureNow()\n52|\tdescriptor, err := BuildDescriptor(DescriptorParams{\n53|\t\tBinding: BindingRef{\n54|\t\t\tBindingDigest:         deps.universe.hostBinding().TerminalBindingID,\n55|\t\t\tBackendID:             deps.universe.hostBinding().BackendID,\n56|\t\t\tImplementationVersion: deps.universe.hostBinding().ImplementationVersion,\n57|\t\t\tProtocolVersion:       deps.universe.hostBinding().ProtocolVersion,\n58|\t\t\tGeneration:            deps.universe.hostBinding().Generation,\n59|\t\t},\n60|\t\tInstanceID:  fixtureInstance,\n61|\t\tInteractive: true,\n62|\t\tColumns:     80,\n63|\t\tRows:        24,\n64|\t})\n65|\tif err != nil {\n66|\t\tt.Fatalf(\"BuildDescriptor() error = %v\", err)\n67|\t}\n68|\trecord, events, err := LoadProfile(deps.repo, fixtureSession)\n69|\tif err != nil {\n70|\t\tt.Fatalf(\"LoadProfile() error = %v\", err)\n71|\t}\n72|\treturn Input{\n73|\t\tSessionID:            fixtureSession,\n74|\t\tBootstrapOperationID: fixtureBootstrap,\n75|\t\tMode:                 ModeLaunch,\n76|\t\tSessionKnown:         true,\n77|\t\tPresented:            fixturePresented(),\n78|\t\tObservation:          fixtureObservation(now),\n79|\t\tBackend:              deps.universe.facts(t),\n80|\t\tProfileRecord:        record,\n81|\t\tProfileEvents:        events,\n82|\t\tProvider: ProviderFacts{\n83|\t\t\tBuild:    fixtureBuild(),\n84|\t\t\tIdentity: fixtureIdentity(t),\n85|\t\t},\n86|\t\tRealm: Realm{\n87|\t\t\tCaller:           CallerForeground,\n88|\t\t\tBrokerState:      \"broker-running\",\n89|\t\t\tServerGeneration: \"generation-alpha\",\n90|\t\t\tRemediation:      \"launch the aqua broker\",\n91|\t\t},\n92|\t\tEntrypoint:        []string{\"ax\", \"pane\", fixtureSession},\n93|\t\tDescriptor:        descriptor,\n94|\t\tHostBinding:       deps.universe.hostBinding(),\n95|\t\tInteractive:       true,\n96|\t\tRemoteInteractive: true,\n97|\t}\n98|}\n99|\n100|func lapsedObservation(now time.Time) fencing.Observation {\n101|\tobservation := fixtureObservation(now)\n102|\tobservation.Grant.ValidatedAt = now.Add(-2 * time.Hour)\n103|\treturn observation\n104|}\n105|\n106|func TestDecideLaunchPositive(t *testing.T) {\n107|\tt.Parallel()\n108|\tdeps := buildDecideDeps(t, true)\n109|\tdecision := Decide(validInput(t, deps))\n110|\tif decision.Action != ActionLaunch {\n(more lines below)","final_result":true}}}
