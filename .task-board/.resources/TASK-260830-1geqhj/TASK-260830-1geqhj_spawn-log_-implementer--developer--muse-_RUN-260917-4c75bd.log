{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d145","stream":{"kind":"session","id":"01a0b131-d4f6-7b82-a7a6-5363cf3ac7fb"},"sequence":1789,"recorded_at":1780531400003573,"record_type":"event","durability":"durable","causation_id":"2237b1e3-856b-4a22-9f46-61adba667efd","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"2237b1e3-856b-4a22-9f46-61adba667efd","run_stream":{"kind":"run","id":"2237b1e3-856b-4a22-9f46-61adba667efd"},"call_id":"call_01a0b13a030575d192844d634bb55975","text":"Read text file `internal/axpane/crash_unix_test.go`.\n1|//go:build darwin || linux\n2|\n3|package axpane\n4|\n5|import (\n6|\t\"context\"\n7|\t\"errors\"\n8|\t\"os\"\n9|\t\"os/exec\"\n10|\t\"syscall\"\n11|\t\"testing\"\n12|\t\"time\"\n13|)\n14|\n15|// Real process-termination evidence for the bootstrap binding seam:\n16|// the child runs the genuine production Bind entry and SIGKILLs\n17|// itself in the AfterInstall hook, after the no-replace commit and\n18|// before the directory sync. The parent then proves the interrupted\n19|// bind left the complete binding behind (never a torn prefix and\n20|// never a second child), and the identical retry reattaches to it.\n21|const (\n22|\tcrashChildEnv   = \"AX_AXPANE_CRASH_CHILD\"\n23|\tcrashChildStore = \"AX_AXPANE_CRASH_STORE\"\n24|)\n25|\n26|func TestBindCrashChildSelfTerminates(t *testing.T) {\n27|\tif os.Getenv(crashChildEnv) == \"1\" {\n28|\t\tbindCrashChild(t)\n29|\t\treturn\n30|\t}\n31|\tstoreDir := t.TempDir()\n32|\tif _, err := Open(storeDir); err != nil {\n33|\t\tt.Fatal(err)\n34|\t}\n35|\tctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)\n36|\tdefer cancel()\n37|\tchild := exec.CommandContext(ctx, os.Args[0],\n38|\t\t\"-test.run=^TestBindCrashChildSelfTerminates$\",\n39|\t\t\"-test.count=1\",\n40|\t)\n41|\tchild.Env = append(os.Environ(),\n42|\t\tcrashChildEnv+\"=1\",\n43|\t\tcrashChildStore+\"=\"+storeDir,\n44|\t)\n45|\trunErr := child.Run()\n46|\tvar exitErr *exec.ExitError\n47|\tif !errors.As(runErr, &exitErr) {\n48|\t\tt.Fatalf(\"child run = %v, want a signal-kill exit\", runErr)\n49|\t}\n50|\tstatus, ok := exitErr.Sys().(syscall.WaitStatus)\n51|\tif !ok || !status.Signaled() || status.Signal() != syscall.SIGKILL {\n52|\t\tt.Fatalf(\"child status = %v, want killed by SIGKILL\", exitErr)\n53|\t}\n54|\tstore, err := Open(storeDir)\n55|\tif err != nil {\n56|\t\tt.Fatal(err)\n57|\t}\n58|\tproven, found, err := store.Status(fixtureSession)\n59|\tif err != nil {\n60|\t\tt.Fatalf(\"Status() after kill error = %v\", err)\n61|\t}\n62|\tif !found {\n63|\t\tt.Fatal(\"Status() after kill reports absence, want the committed binding\")\n64|\t}\n65|\tif proven.SessionID != fixtureSession || proven.OperationID != fixtureBootstrap || proven.TerminalInstanceID != fixtureInstance {\n66|\t\tt.Fatalf(\"Status() after kill = %+v, want the complete receipt\", proven)\n67|\t}\n68|\tsecond, reattached, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate())\n69|\tif err != nil {\n70|\t\tt.Fatalf(\"Bind() retry after kill error = %v\", err)\n71|\t}\n72|\tif !reattached {\n73|\t\tt.Fatal(\"Bind() retry after kill installs fresh, want reattach to the one child\")\n74|\t}\n75|\tif second != proven {\n76|\t\tt.Fatalf(\"Bind() retry = %+v, want %+v\", second, proven)\n77|\t}\n78|}\n79|\n80|func bindCrashChild(t *testing.T) {\n81|\tt.Helper()\n82|\tstore, err := Open(os.Getenv(crashChildStore))\n83|\tif err != nil {\n84|\t\tt.Fatalf(\"child Open() error = %v\", err)\n85|\t}\n86|\tcandidate := bindCandidate()\n87|\tstore.WithHooks(&Hooks{\n88|\t\tAfterInstall: func(path string) error {\n89|\t\t\tproc, err := os.FindProcess(os.Getpid())\n90|\t\t\tif err != nil {\n91|\t\t\t\tt.Fatalf(\"child find self: %v\", err)\n92|\t\t\t}\n93|\t\t\t_ = proc.Signal(syscall.SIGKILL)\n94|\t\t\tselect {}\n95|\t\t},\n96|\t})\n97|\t_, _, _ = store.Bind(fixtureSession, fixtureBootstrap, candidate)\n98|\tt.Fatal(\"child Bind() returned past SIGKILL\")\n99|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
