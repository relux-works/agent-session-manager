{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca1f","stream":{"kind":"session","id":"01a0b131-d4f6-7b82-a7a6-5363cf3ac7fb"},"sequence":874,"recorded_at":1780531400001743,"record_type":"event","durability":"durable","causation_id":"2237b1e3-856b-4a22-9f46-61adba667efd","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2237b1e3-856b-4a22-9f46-61adba667efd","run_stream":{"kind":"run","id":"2237b1e3-856b-4a22-9f46-61adba667efd"},"task_stream":{"kind":"task","id":"01a0b135-3899-7ba0-af00-179d4da6d200"},"task_id":"01a0b135-3899-7ba0-af00-179d4da6d200","event":{"kind":"output","task_id":"01a0b135-3899-7ba0-af00-179d4da6d200","chunk":"Read text file `internal/axpane/gates.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|\t\"os\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/config\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/matjournal\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/sessckpt\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/sessprofile\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n14|)\n15|\n16|// Stores binds the durable owners the adapters read: sessions,\n17|// leases, and events; materialization journals; checkpoints; and\n18|// the wrapper's own bootstrap bindings.\n19|type Stores struct {\n20|\tRepo *sessrepo.Repository\n21|\tMat  *matjournal.Store\n22|\tCkpt *sessckpt.Store\n23|\tPane *Store\n24|}\n25|\n26|// ValidateConfig validates the configuration through the config\n27|// owner. A nil error is the valid outcome Decide gates on; the\n28|// loaded snapshot itself is the caller's to keep.\n29|func ValidateConfig(inputs config.Inputs, overrides config.Overrides) error {\n30|\t_, err := config.Load(inputs, overrides)\n31|\treturn err\n32|}\n33|\n34|// LoadSession loads the logical session through the sessrepo owner.\n35|// known is false only when the session is absent; any read or\n36|// verification failure propagates as an error, never as absence.\n37|func LoadSession(repository *sessrepo.Repository, sessionID string) (known bool, record []byte, err error) {\n38|\tif repository == nil {\n39|\t\treturn false, nil, errors.New(\"axpane session load carries no repository\")\n40|\t}\n41|\traw, err := repository.GetRecord(sessionID)\n42|\tif err != nil {\n43|\t\tif errors.Is(err, sessrepo.ErrUnknownSession) {\n44|\t\t\treturn false, nil, nil\n45|\t\t}\n46|\t\treturn false, nil, err\n47|\t}\n48|\treturn true, raw, nil\n49|}\n50|\n51|// ObserveOwnership loads the winning lease and combines it with the\n52|// caller-reported sync, handoff, grant, and clock facts through the\n53|// fencing owner. A session with no leases yet yields HasWinner\n54|// false without an error: absence is data the gate parks on.\n55|func ObserveOwnership(repository *sessrepo.Repository, sessionID string, input fencing.ObserveInput) (fencing.Observation, error) {\n56|\tif repository == nil {\n57|\t\treturn fencing.Observation{}, errors.New(\"axpane ownership observation carries no repository\")\n58|\t}\n59|\treturn fencing.Observe(repository, sessionID, input)\n60|}\n61|\n62|// LoadProfile loads the decoded session surface the sessprofile\n63|// reducer derives the effective pair from: the Session Record plus\n64|// the authoritative chain in index order.\n65|func LoadProfile(repository *sessrepo.Repository, sessionID string) (sessprofile.Record, []sessprofile.Event, error) {\n66|\tempty := sessprofile.Record{}\n67|\tif repository == nil {\n68|\t\treturn empty, nil, errors.New(\"axpane profile load carries no repository\")\n69|\t}\n70|\trecordJSON, err := repository.GetRecord(sessionID)\n71|\tif err != nil {\n72|\t\treturn empty, nil, err\n73|\t}\n74|\trecord, err := sessprofile.DecodeRecord(recordJSON)\n75|\tif err != nil {\n76|\t\treturn empty, nil, err\n77|\t}\n78|\tsummaries, err := repository.ListEvents(sessionID)\n79|\tif err != nil {\n80|\t\treturn empty, nil, err\n81|\t}\n82|\tevents := make([]sessprofile.Event, 0, len(summaries))\n83|\tfor _, summary := range summaries {\n84|\t\teventJSON, err := repository.GetEvent(sessionID, summary.EventID)\n85|\t\tif err != nil {\n86|\t\t\treturn empty, nil, err\n87|\t\t}\n88|\t\tevent, err := sessprofile.DecodeEvent(eventJSON)\n89|\t\tif err != nil {\n90|\t\t\treturn empty, nil, err\n91|\t\t}\n92|\t\tevents = append(events, event)\n93|\t}\n94|\treturn record, events, nil\n95|}\n96|\n97|// LoadMaterialization loads the required materialization journal\n98|// through the matjournal owner: grammar and cross-reference\n99|// validation run on every read. Admitted is false only when the\n100|// journal is absent; any read or validation failure propagates as\n101|// an error, never as absence.\n102|func LoadMaterialization(store *matjournal.Store, materializationID string) (matjournal.Journal, bool, error) {\n103|\tif store == nil {\n104|\t\treturn matjournal.Journal{}, false, errors.New(\"axpane materialization load carries no store\")\n105|\t}\n106|\tjournal, _, err := store.Get(materializationID)\n107|\tif err != nil {\n108|\t\tif errors.Is(err, matjournal.ErrUnknownJournal) {\n109|\t\t\treturn matjournal.Journal{}, false, nil\n110|\t\t}\n111|\t\treturn matjournal.Journal{}, false, err\n112|\t}\n113|\treturn journal, true, nil\n114|}\n115|\n116|// LoadCheckpoint loads the resume checkpoint through the sessckpt\n117|// owner, which re-attests the closed shape and identity on every\n118|// read. A nil document with a nil error is absence; any read or\n119|// attestation failure propagates as an error, never as absence.\n120|func LoadCheckpoint(store *sessckpt.Store, checkpointID string) ([]byte, error) {\n121|\tif store == nil {\n122|\t\treturn nil, errors.New(\"axpane checkpoint load carries no store\")\n123|\t}\n124|\traw, err := store.Get(checkpointID)\n125|\tif err != nil {\n126|\t\tif os.IsNotExist(err) {\n127|\t\t\treturn nil, nil\n128|\t\t}\n129|\t\treturn nil, err\n130|\t}\n131|\treturn raw, nil\n132|}\n133|\n134|// ChainTail returns the record digest and the current tail of the\n135|// authoritative chain for parked-event linkage: the next sequence\n136|// and the predecessor set the emission must reference.\n137|func ChainTail(repository *sessrepo.Repository, sessionID string) (recordID string, tail *sessrepo.EventSummary, err error) {\n138|\tif repository == nil {\n139|\t\treturn \"\", nil, errors.New(\"axpane chain tail carries no repository\")\n140|\t}\n141|\tsummaries, err := repository.ListSessions()\n142|\tif err != nil {\n143|\t\treturn \"\", nil, err\n144|\t}\n145|\tfound := false\n146|\tfor index := range summaries {\n147|\t\tif summaries[index].SessionID == sessionID {\n148|\t\t\trecordID = summaries[index].RecordID\n149|\t\t\tfound = true\n150|\t\t\tbreak\n151|\t\t}\n152|\t}\n153|\tif !found {\n154|\t\treturn \"\", nil, fmt.Errorf(\"chain tail for unknown session %s\", sessionID)\n155|\t}\n156|\tevents, err := repository.ListEvents(sessionID)\n157|\tif err != nil {\n158|\t\treturn \"\", nil, err\n159|\t}\n160|\tif len(events) == 0 {\n161|\t\treturn recordID, nil, nil\n162|\t}\n163|\tprevious := events[len(events)-1]\n164|\treturn recordID, &previous, nil\n165|}","final_result":true}}}
