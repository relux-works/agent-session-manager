{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000da85","stream":{"kind":"session","id":"01a0b131-d4f6-7b82-a7a6-5363cf3ac7fb"},"sequence":2973,"recorded_at":1780531400005941,"record_type":"event","durability":"durable","causation_id":"2237b1e3-856b-4a22-9f46-61adba667efd","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2237b1e3-856b-4a22-9f46-61adba667efd","run_stream":{"kind":"run","id":"2237b1e3-856b-4a22-9f46-61adba667efd"},"task_stream":{"kind":"task","id":"01a0b142-b641-7471-8d23-d331e7d20d4c"},"task_id":"01a0b142-b641-7471-8d23-d331e7d20d4c","event":{"kind":"output","task_id":"01a0b142-b641-7471-8d23-d331e7d20d4c","chunk":"Read text file `internal/axpane/conformance_test.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"os/exec\"\n5|\t\"regexp\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n10|)\n11|\n12|// TestDecideArmPrecedence pins the §4.C wrapper-rule order: with\n13|// every arm faulted at once, the first arm wins. Configuration\n14|// precedes session, which precedes bootstrap idempotency, which\n15|// precedes backend admission, which precedes fencing.\n16|func TestDecideArmPrecedence(t *testing.T) {\n17|\tt.Parallel()\n18|\tdeps := buildDecideDeps(t, true)\n19|\tinput := validInput(t, deps)\n20|\tinput.ConfigErr = errFixtureConfig\n21|\tinput.SessionKnown = false\n22|\tinput.ExistingBinding = &Binding{SessionID: fixtureSession, OperationID: fixtureOtherOp}\n23|\tinput.Backend.Manifest = []byte(`{\"broken\":true}`)\n24|\tinput.Presented.Epoch = 0\n25|\tdecision := Decide(input)\n26|\tif decision.Action != ActionRefused || decision.Class != ClassInvalidConfig {\n27|\t\tt.Fatalf(\"Decide() all-faulted = (%q, %q), want (refused, invalid_config)\", decision.Action, decision.Class)\n28|\t}\n29|\tinput.ConfigErr = nil\n30|\tdecision = Decide(input)\n31|\tif decision.Action != ActionRefused || decision.Class != ClassInvalidArguments {\n32|\t\tt.Fatalf(\"Decide() peeled-config = (%q, %q), want the session arm\", decision.Action, decision.Class)\n33|\t}\n34|}\n35|\n36|// TestEmitParkedVocabularyLoop authors the locally emittable\n37|// session.parked reasons through the production emission path and\n38|// reads each back with its exact closed payload, and proves the\n39|// remotely held or unverifiable reasons refuse chain emission\n40|// rather than manufacturing a collision. Only a verified,\n41|// locally held winner with a foldable lifecycle authors: stale and\n42|// materialization-based restore_policy emit; remote, unverified,\n43|// and failed-handoff parks refuse.\n44|func TestEmitParkedVocabularyLoop(t *testing.T) {\n45|\tt.Parallel()\n46|\tdeps := buildDecideDeps(t, true)\n47|\t// Move the fixture chain to failed so session.parked folds\n48|\t// (§5.7: only materializing, stopped, failed, or parked park).\n49|\tfailedID := appendChainEvent(t, deps.repo, \"session.failed\", 1, fixtureLeaseA, 2, deps.createdID, map[string]any{\n50|\t\t\"error_code\": \"bootstrap_probe\", \"retryable\": false, \"operation_id\": nil,\n51|\t})\n52|\tnow := fixtureNow()\n53|\tobservation := fixtureObservation(now)\n54|\tpresented := fixturePresented()\n55|\temittable := []struct {\n56|\t\treason fencing.ParkReason\n57|\t\taction Action\n58|\t\tmutate func(*Input)\n59|\t}{\n60|\t\t{fencing.ParkStaleOwner, ActionParked, func(input *Input) { input.Presented.LeaseID = fixtureLeaseB }},\n61|\t\t{fencing.ParkRestorePolicy, ActionParked, func(input *Input) {\n62|\t\t\tinput.MaterializationRequired = true\n63|\t\t\tinput.JournalOK = true\n64|\t\t}},\n65|\t}\n66|\tsequence := uint64(3)\n67|\tpredecessor := failedID\n68|\tfor _, testCase := range emittable {\n69|\t\tinput := validInput(t, deps)\n70|\t\ttestCase.mutate(&input)\n71|\t\tdecision := Decide(input)\n72|\t\tif decision.Action != testCase.action || decision.ParkReason != testCase.reason {\n73|\t\t\tt.Fatalf(\"Decide() = (%q, %q), want (%q, %q)\", decision.Action, decision.ParkReason, testCase.action, testCase.reason)\n74|\t\t}\n75|\t\treference, _, err := EmitParked(deps.repo, decision, EmitParams{\n76|\t\t\tSessionID: fixtureSession, CreatedByHost: fixtureLocalHost,\n77|\t\t\tLeaseEpoch: 1, LeaseID: fixtureLeaseA, LeaseSequence: sequence,\n78|\t\t\tPredecessors: []string{predecessor}, CreatedAt: fixtureCreatedAt,\n79|\t\t\tPresented: presented, Observation: observation,\n80|\t\t})\n81|\t\tif err != nil {\n82|\t\t\tt.Fatalf(\"EmitParked(%q) error = %v\", testCase.reason, err)\n83|\t\t}\n84|\t\tstored, err := deps.repo.GetEvent(fixtureSession, reference.EventID)\n85|\t\tif err != nil {\n86|\t\t\tt.Fatal(err)\n87|\t\t}\n88|\t\tif !strings.Contains(string(stored), `\"reason\":\"`+string(testCase.reason)+`\"`) {\n89|\t\t\tt.Fatalf(\"parked event for %q carries no reason member: %s\", testCase.reason, stored)\n90|\t\t}\n91|\t\tsequence++\n92|\t\tpredecessor = reference.EventID\n93|\t}\n94|\trefusing := []struct {\n95|\t\tname    string\n96|\t\treason  fencing.ParkReason\n97|\t\taction  Action\n98|\t\tmutate  func(*Input)\n99|\t\tobserve func(*fencing.Observation)\n100|\t}{\n101|\t\t{\"remote_owner\", fencing.ParkRemoteOwner, ActionAttachRemote,\n102|\t\t\tfunc(input *Input) { input.Observation.Winner.HolderHostID = fixtureRemoteHost },\n103|\t\t\tfunc(obs *fencing.Observation) { obs.Winner.HolderHostID = fixtureRemoteHost }},\n104|\t\t{\"unverified\", fencing.ParkRestorePolicy, ActionParked,\n105|\t\t\tfunc(input *Input) { input.Observation.Verified = false },\n106|\t\t\tfunc(obs *fencing.Observation) { obs.Verified = false }},\n107|\t\t{\"failed_handoff\", fencing.ParkFailedHandoff, ActionParked,\n108|\t\t\tfunc(input *Input) { input.Observation.HandoffFailed = true },\n109|\t\t\tfunc(obs *fencing.Observation) { obs.HandoffFailed = true }},\n110|\t}\n111|\tfor _, testCase := range refusing {\n112|\t\tt.Run(\"refuses_\"+testCase.name, func(t *testing.T) {\n113|\t\t\tt.Parallel()\n114|\t\t\tnested := buildDecideDeps(t, true)\n115|\t\t\tnestedFailed := appendChainEvent(t, nested.repo, \"session.failed\", 1, fixtureLeaseA, 2, nested.createdID, map[string]any{\n116|\t\t\t\t\"error_code\": \"bootstrap_probe\", \"retryable\": false, \"operation_id\": nil,\n117|\t\t\t})\n118|\t\t\tinput := validInput(t, nested)\n119|\t\t\ttestCase.mutate(&input)\n120|\t\t\tdecision := Decide(input)\n121|\t\t\tif decision.Action != testCase.action || decision.ParkReason != testCase.reason {\n122|\t\t\t\tt.Fatalf(\"Decide() = (%q, %q), want (%q, %q)\", decision.Action, decision.ParkReason, testCase.action, testCase.reason)\n123|\t\t\t}\n124|\t\t\trefusingObs := fixtureObservation(fixtureNow())\n125|\t\t\ttestCase.observe(&refusingObs)\n126|\t\t\tif _, _, err := EmitParked(nested.repo, decision, EmitParams{\n127|\t\t\t\tSessionID: fixtureSession, CreatedByHost: fixtureLocalHost,\n128|\t\t\t\tLeaseEpoch: 1, LeaseID: fixtureLeaseA, LeaseSequence: 3,\n129|\t\t\t\tPredecessors: []string{nestedFailed}, CreatedAt: fixtureCreatedAt,\n130|\t\t\t\tPresented: fixturePresented(), Observation: refusingObs,\n131|\t\t\t}); err == nil {\n132|\t\t\t\tt.Fatalf(\"EmitParked(%q) succeeded under a non-held lease, want refusal\", testCase.reason)\n133|\t\t\t}\n134|\t\t})\n135|\t}\n136|}\n137|\n138|// TestLaunchCarriesValidatedPlan pins the §13.1 step-4 surface the\n139|// wrapper hands to the later provider-launch leaf: the resolved\n140|// adapter mapping, the admitted §7.A descriptor, and the sealed\n141|// fencing token travel together on every launch, and no launch\n142|// ships a partial plan.\n143|func TestLaunchCarriesValidatedPlan(t *testing.T) {\n144|\tt.Parallel()\n145|\tdeps := buildDecideDeps(t, true)\n146|\tdecision := Decide(validInput(t, deps))\n147|\tif decision.Action != ActionLaunch {\n148|\t\tt.Fatalf(\"Decide() action = %q, want launch\", decision.Action)\n149|\t}\n150|\tif !decision.HasToken {\n151|\t\tt.Fatal(\"launch carries no fencing token\")\n152|\t}\n153|\tif decision.Descriptor.TerminalInstanceID == \"\" {\n154|\t\tt.Fatal(\"launch carries no admitted descriptor\")\n155|\t}\n156|\tif len(decision.Admitted.Capabilities) == 0 {\n157|\t\tt.Fatal(\"launch carries no admitted capabilities\")\n158|\t}\n159|}\n160|\n161|// TestConformanceMatrixCompleteness enumerates the pinned clauses\n162|// and the named top-level test that drives each through a\n163|// production entry, then verifies every named test exists in this\n164|// package through the go list entry. A row fails if its test is\n165|// removed or renamed without updating the matrix; subtest rows in\n166|// TRACEABILITY.md refine these top-level drivers.\n167|func TestConformanceMatrixCompleteness(t *testing.T) {\n168|\tt.Parallel()\n169|\trows := []struct {\n170|\t\tclause string\n171|\t\ttest   string\n172|\t}{\n173|\t\t{\"4.B manifest/probe/evidence identity\", \"TestDecideLaunchPositive\"},\n174|\t\t{\"4.B mismatch fails before activation\", \"TestDecideTable\"},\n175|\t\t{\"4.C wrapper rule order\", \"TestDecideArmPrecedence\"},\n176|\t\t{\"4.C bootstrap idempotency mismatch\", \"TestDecideTable\"},\n177|\t\t{\"4.C identical retry reattaches\", \"TestBindIdenticalRetryReattaches\"},\n178|\t\t{\"4.C concurrent commit reattaches\", \"TestBindConcurrentSameOperationReattaches\"},\n179|\t\t{\"4.C status proves absence\", \"TestBindInstallsAndStatusProves\"},\n180|\t\t{\"4.C unknown is not absent\", \"TestStatusUnknownIsNotAbsent\"},\n181|\t\t{\"4.C no PID persisted\", \"TestBindingPersistsNoPID\"},\n182|\t\t{\"4.C crash at the binding seam\", \"TestBindCrashChildSelfTerminates\"},\n183|\t\t{\"4.D only admitted rows authorize\", \"TestDecideTable\"},\n184|\t\t{\"4.2 background caller capability_unavailable\", \"TestDecideTypedRefusals\"},\n185|\t\t{\"4.2 cached evidence never authorizes\", \"TestRealmCarriesNoCachedEvidence\"},\n186|\t\t{\"4.2 after-restore sequence\", \"TestDecideAfterRestoreSequence\"},\n187|\t\t{\"5.2 session.parked vocabulary\", \"TestEmitParkedVocabularyLoop\"},\n188|\t\t{\"5.2 parked emission under lease\", \"TestEmitParkedRoundTrip\"},\n189|\t\t{\"5.2 v4 terminal payloads\", \"TestEmitTerminalV4RoundTrip\"},\n190|\t\t{\"7.A descriptor build and admit\", \"TestDescriptorBuildAdmitRoundTrip\"},\n191|\t\t{\"7.A descriptor mismatch refuses\", \"TestDescriptorMismatchRefuses\"},\n192|\t\t{\"7.A generation bounds\", \"TestDescriptorGenerationBounds\"},\n193|\t\t{\"7.A token passed separately\", \"TestDecideForgedTokensRefuse\"},\n194|\t\t{\"13.1 step 3 durable terminal entry\", \"TestRunLaunchBinds\"},\n195|\t\t{\"13.1 step 4 validated plan\", \"TestLaunchCarriesValidatedPlan\"},\n196|\t\t{\"2.4 effective profile and source\", \"TestDecideProfileSourcePinsEvent\"},\n197|\t\t{\"2.4 mapping refusal\", \"TestDecideYoloMapping\"},\n198|\t\t{\"orchestrated launch/reattach/park/refuse\", \"TestRunParkedEmits\"},\n199|\t\t{\"ownership observation over leases\", \"TestObserveLoadsWinningLease\"},\n200|\t}\n201|\tlisted, err := exec.Command(\"go\", \"test\", \".\", \"-list\", \".\", \"-count=1\").CombinedOutput()\n202|\tif err != nil {\n203|\t\tt.Fatalf(\"go test -list error = %v: %s\", err, listed)\n204|\t}\n205|\tpresent := map[string]bool{}\n206|\tfor _, line := range strings.Split(string(listed), \"\\n\") {\n207|\t\tmatched, _ := regexp.MatchString(`^Test[A-Za-z0-9_]+$`, strings.TrimSpace(line))\n208|\t\tif matched {\n209|\t\t\tpresent[strings.TrimSpace(line)] = true\n210|\t\t}\n211|\t}\n212|\tif len(present) == 0 {\n213|\t\tt.Fatalf(\"go test -list found no tests: %s\", listed)\n214|\t}\n215|\tfor _, row := range rows {\n216|\t\tif !present[row.test] {\n217|\t\t\tt.Errorf(\"clause %q names missing test %q\", row.clause, row.test)\n218|\t\t}\n219|\t}\n220|\tt.Logf(\"%d pinned clauses mapped to named tests\", len(rows))\n221|}","final_result":true}}}
