{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf2f","stream":{"kind":"session","id":"01a0b131-d4f6-7b82-a7a6-5363cf3ac7fb"},"sequence":1522,"recorded_at":1780531400003039,"record_type":"event","durability":"durable","causation_id":"2237b1e3-856b-4a22-9f46-61adba667efd","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2237b1e3-856b-4a22-9f46-61adba667efd","run_stream":{"kind":"run","id":"2237b1e3-856b-4a22-9f46-61adba667efd"},"task_stream":{"kind":"task","id":"01a0b138-8001-7340-a14d-7cfce12302bf"},"task_id":"01a0b138-8001-7340-a14d-7cfce12302bf","event":{"kind":"output","task_id":"01a0b138-8001-7340-a14d-7cfce12302bf","chunk":"{\n  \"chunk_id\": \"exec-46-1\",\n  \"command\": \"grep -n \\\"func checkEvidenceSet\\\" -A 60 internal/terminalbackend/manifest.go | head -n 75; echo ====; grep -n \\\"type Evidence struct\\\" -A 30 internal/terminalbackend/manifest.go | head -n 40\",\n  \"description\": \"Read evidence set check and Evidence shape\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"1848:func checkEvidenceSet(manifest Manifest, probe Probe, probeClaims map[string]Claim, evidence []Evidence, now time.Time, verify SignatureVerifier) ([]Evidence, error) {\\n1849-\\tused := make([]Evidence, 0, len(evidence))\\n1850-\\tseen := make(map[string]Evidence, len(evidence))\\n1851-\\tfor _, object := range evidence {\\n1852-\\t\\tclaim, present := probeClaims[object.Capability]\\n1853-\\t\\tif !present || !claim.Value {\\n1854-\\t\\t\\treturn nil, mismatchf(\\\"evidence claim binding\\\")\\n1855-\\t\\t}\\n1856-\\t\\tif err := checkEvidenceTuple(manifest, probe, object); err != nil {\\n1857-\\t\\t\\treturn nil, err\\n1858-\\t\\t}\\n1859-\\t\\tif err := checkEvidenceLiveness(object, now); err != nil {\\n1860-\\t\\t\\treturn nil, err\\n1861-\\t\\t}\\n1862-\\t\\tif previous, duplicate := seen[object.EvidenceID]; duplicate {\\n1863-\\t\\t\\tif !equalEvidence(previous, object) {\\n1864-\\t\\t\\t\\treturn nil, mismatchf(\\\"conflicting evidence\\\")\\n1865-\\t\\t\\t}\\n1866-\\t\\t\\tcontinue\\n1867-\\t\\t}\\n1868-\\t\\tseen[object.EvidenceID] = object\\n1869-\\t\\tif err := checkEvidenceSignature(object, verify); err != nil {\\n1870-\\t\\t\\treturn nil, err\\n1871-\\t\\t}\\n1872-\\t\\tused = append(used, object)\\n1873-\\t}\\n1874-\\treturn used, nil\\n1875-}\\n1876-\\n1877-// equalEvidence reports whether two evidence objects with the same ID carry\\n1878-// identical members. Same-ID differing-bytes objects are conflicting\\n1879-// evidence and invalidate the whole Probe.\\n1880-func equalEvidence(left, right Evidence) bool {\\n1881-\\tif left.TerminalBackendID != right.TerminalBackendID ||\\n1882-\\t\\tleft.ImplementationVersion != right.ImplementationVersion ||\\n1883-\\t\\tleft.ProtocolVersion != right.ProtocolVersion ||\\n1884-\\t\\tleft.BackendGenerationDigest != right.BackendGenerationDigest ||\\n1885-\\t\\tleft.Capability != right.Capability ||\\n1886-\\t\\tleft.Platform != right.Platform ||\\n1887-\\t\\tleft.OSVersion != right.OSVersion ||\\n1888-\\t\\tleft.ConformanceFixtureID != right.ConformanceFixtureID ||\\n1889-\\t\\tleft.ObservedAt.String() != right.ObservedAt.String() ||\\n1890-\\t\\tleft.ExpiresAt.String() != right.ExpiresAt.String() ||\\n1891-\\t\\tleft.Issuer != right.Issuer ||\\n1892-\\t\\tleft.IssuerID != right.IssuerID ||\\n1893-\\t\\t!equalStrings(left.Facts, right.Facts) ||\\n1894-\\t\\tleft.TerminalBindingID != right.TerminalBindingID ||\\n1895-\\t\\tleft.ProviderID != right.ProviderID ||\\n1896-\\t\\tleft.ProviderBuild != right.ProviderBuild ||\\n1897-\\t\\tleft.SentinelResult != right.SentinelResult ||\\n1898-\\t\\tleft.ProviderAuthSmokeResult != right.ProviderAuthSmokeResult {\\n1899-\\t\\treturn false\\n1900-\\t}\\n1901-\\treturn bytes.Equal(left.AttestationSignature, right.AttestationSignature)\\n1902-}\\n1903-\\n1904-// checkEvidenceTuple binds one evidence object to this exact Manifest/Probe\\n1905-// tuple: backend, versions, generation digest, platform, os_version, and\\n1906-// the Manifest conformance fixture must all match.\\n1907-func checkEvidenceTuple(manifest Manifest, probe Probe, object Evidence) error {\\n1908-\\tif object.TerminalBackendID != probe.TerminalBackendID ||\\n====\\n912:type Evidence struct {\\n913-\\t// EvidenceID is the recomputed omit-self digest.\\n914-\\tEvidenceID string\\n915-\\t// TerminalBackendID equals the Manifest and Probe members.\\n916-\\tTerminalBackendID string\\n917-\\t// ImplementationVersion equals the Manifest and Probe members.\\n918-\\tImplementationVersion string\\n919-\\t// ProtocolVersion equals the Probe member.\\n920-\\tProtocolVersion string\\n921-\\t// BackendGenerationDigest equals the Probe member.\\n922-\\tBackendGenerationDigest string\\n923-\\t// Capability names the one true claim this object proves.\\n924-\\tCapability string\\n925-\\t// Platform equals the Probe member.\\n926-\\tPlatform scalar.Platform\\n927-\\t// OSVersion equals the Probe member.\\n928-\\tOSVersion string\\n929-\\t// ConformanceFixtureID equals the Manifest member.\\n930-\\tConformanceFixtureID string\\n931-\\t// ObservedAt opens the validity interval.\\n932-\\tObservedAt scalar.Timestamp\\n933-\\t// ExpiresAt closes the validity interval, strictly after ObservedAt.\\n934-\\tExpiresAt scalar.Timestamp\\n935-\\t// Issuer is ax_release or ax_local_probe.\\n936-\\tIssuer string\\n937-\\t// IssuerID is the digest of the trusted signing identity. A\\n938-\\t// caller-supplied issuer ID is not authentication: the signature must\\n939-\\t// verify through the trusted key registry.\\n940-\\tIssuerID string\\n941-\\t// AttestationSignature is the raw signature bytes (scheme stripped).\\n942-\\tAttestationSignature []byte\\n\",\n  \"original_output_bytes\": 4220,\n  \"original_output_tokens\": 1055,\n  \"truncated\": false\n}","final_result":true}}}
