{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4a5","stream":{"kind":"session","id":"01a0b131-d4f6-7b82-a7a6-5363cf3ac7fb"},"sequence":173,"recorded_at":1780531400000341,"record_type":"event","durability":"durable","causation_id":"2237b1e3-856b-4a22-9f46-61adba667efd","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2237b1e3-856b-4a22-9f46-61adba667efd","run_stream":{"kind":"run","id":"2237b1e3-856b-4a22-9f46-61adba667efd"},"task_stream":{"kind":"task","id":"01a0b132-42f7-71e3-902c-dffd0274cfbf"},"task_id":"01a0b132-42f7-71e3-902c-dffd0274cfbf","event":{"kind":"output","task_id":"01a0b132-42f7-71e3-902c-dffd0274cfbf","chunk":"{\n  \"chunk_id\": \"exec-6-1\",\n  \"command\": \"task-board m 'list_resources(TASK-260830-1geqhj)' 2>&1 | head -n 60; echo ===; /Users/iv/.curator/global/bin/task-board --help 2>&1 | head -n 40\",\n  \"description\": \"List task resources and CLI help\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"mutation error: parse error at 1:1: unknown operation \\\"list_resources\\\" (got \\\"list_resources\\\"); known operations: accept_cr, add_checklist_item, add_resource, assign, audit_context_validation, check_item, collect_context_retention, confirm_context_reclamation, correct_activity, create, defer_cr, delete, delete_resource, handoff, integrate_external, link, login, logout, mark_context_stale, normalize_legacy_status, publish_context, reclassify_context, record_ledger_event, register_context, remove_checklist_item, rename, retire_context, retry_context_payload_withdrawal, set_details, set_estimate, set_notes, set_parent, set_status, sweep_context_retention, sweep_context_validation_audits, switch_user, unassign, uncheck_item, undefer_cr, unlink, update_resource, withdraw_cr; see schema() for the contract and schema(mutation=NAME) for one signature\\n===\\nManage a file-based task board with epics, stories, tasks, and bugs.\\n\\nUsage:\\n  task-board [command]\\n\\nAvailable Commands:\\n  admin                  Server administration (users, tokens, access)\\n  boards                 List boards accessible to the current user (remote mode)\\n  claude                 Launch Claude through the Task-board Session Manager\\n  codex                  Attach Codex to the Task-board Session Manager\\n  completion             Generate the autocompletion script for the specified shell\\n  export                 Export current board into a tar.gz archive\\n  goal                   Read and align the board-scoped parent primary goal\\n  grep                   Full-text search across board files\\n  handoff                Verify role handoff evidence and move to the role end status\\n  help                   Help about any command\\n  import                 Import a tar.gz archive into the current board\\n  init                   Install task-board project integrations\\n  limits                 Inspect and control provider rate-limit state\\n  login                  Store a token for the current remote\\n  logout                 Remove active user's token for current remote\\n  m                      Execute a mutation (write operation)\\n  migrate-keychain       Import legacy remote credentials into macOS Keychain\\n  migrate-project-config Preview or apply guarded deprecated project-config alias migration\\n  plan                   Show execution plan with phases and critical path\\n  q                      Query the board with a mini DSL\\n  repair-links           List or remove unsupported container dependency links\\n  resource               Upload, update, download, and delete board resources\\n  self-update            Update task-board to the latest version\\n  session                Inspect and stop Task-board Session Manager sessions\\n  spawn                  Queue an agent spawn run for a board task\\n  switch-user            Switch active user for current remote\\n  tree                   Show board as hierarchical tree\\n  tui                    Launch interactive TUI\\n  validate               Validate board structure\\n  whoami                 Show current remote and active user\\n  worktree               Inspect and repair managed Story workspaces\\n\\nFlags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n\",\n  \"original_output_bytes\": 3273,\n  \"original_output_tokens\": 819,\n  \"truncated\": false\n}","final_result":true}}}
