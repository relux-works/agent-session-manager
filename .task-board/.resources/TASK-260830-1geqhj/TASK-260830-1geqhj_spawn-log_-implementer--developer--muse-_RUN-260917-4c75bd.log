{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cdd9","stream":{"kind":"session","id":"01a0b131-d4f6-7b82-a7a6-5363cf3ac7fb"},"sequence":1351,"recorded_at":1780531400002697,"record_type":"event","durability":"durable","causation_id":"2237b1e3-856b-4a22-9f46-61adba667efd","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2237b1e3-856b-4a22-9f46-61adba667efd","run_stream":{"kind":"run","id":"2237b1e3-856b-4a22-9f46-61adba667efd"},"task_stream":{"kind":"task","id":"01a0b137-e476-7f13-b068-2145bc6f22dd"},"task_id":"01a0b137-e476-7f13-b068-2145bc6f22dd","event":{"kind":"output","task_id":"01a0b137-e476-7f13-b068-2145bc6f22dd","chunk":"Read text file `internal/axpane/rework_test.go`.\n(339 line(s) above)\n340|\troot := t.TempDir()\n341|\trepository, err := sessrepo.Open(root)\n342|\tif err != nil {\n343|\t\tt.Fatal(err)\n344|\t}\n345|\tvar record map[string]any\n346|\tif err := json.Unmarshal([]byte(sessionRecordFixture), &record); err != nil {\n347|\t\tt.Fatal(err)\n348|\t}\n349|\treference, err := repository.CreateSession(identifyObject(t, record, \"record_id\"))\n350|\tif err != nil {\n351|\t\tt.Fatal(err)\n352|\t}\n353|\tif _, err := repository.CreateLease(fixtureSession, sessrepo.CreateLeaseInput{LeaseID: fixtureLeaseA, HolderHostID: fixtureLocalHost, IssuedByHostID: fixtureLocalHost, CreatedAt: fixtureCreatedAt}); err != nil {\n354|\t\tt.Fatal(err)\n355|\t}\n356|\tappendChainEvent(t, repository, \"session.created\", 1, fixtureLeaseA, 1, reference.RecordID, map[string]any{\n357|\t\t\"session_record_id\": reference.RecordID, \"bootstrap_operation_id\": fixtureBootstrap, \"first_checkpoint_operation_id\": fixtureOtherOp,\n358|\t})\n359|\tworld.repo = repository\n360|\tmatches, _ := filepath.Glob(filepath.Join(root, \"sessions\", fixtureSession, \"leases\", \"*\"))\n361|\tif len(matches) == 0 {\n362|\t\tt.Fatal(\"no lease blobs to tear\")\n363|\t}\n364|\tfor _, match := range matches {\n365|\t\tif err := os.WriteFile(match, []byte(\"{torn\"), 0o600); err != nil {\n366|\t\t\tt.Fatal(err)\n367|\t\t}\n368|\t}\n369|\toutcome, err := Run(world.stores(), runRequest(t, world))\n370|\tif err == nil {\n371|\t\tt.Fatalf(\"Run() over torn lease succeeded with %+v, want the read error\", outcome.Decision)\n372|\t}\n373|\tif outcome.Decision.Action != \"\" {\n374|\t\tt.Fatalf(\"Run() over torn lease decides %q, want no decision\", outcome.Decision.Action)\n375|\t}\n376|}\n377|\n378|// TestRunParkedUnfoldableSkipsEmission pins P1-1 (probe 2): a verified\n379|// local park from a creating chain parks without authoring the\n380|// unfolderable session.parked event. On rev1 this authored creating\n381|// -> parked, which sessstate refuses.\n382|func TestRunParkedUnfoldableSkipsEmission(t *testing.T) {\n383|\tt.Parallel()\n384|\tworld := buildRunWorld(t)\n385|\trequest := runRequest(t, world)\n386|\trequest.Mode = ModeRestore\n387|\trequest.MaterializationRequired = true\n388|\trequest.MaterializationID = \"0198f4c8-9a10-7b22-8b3c-1234567890ff\"\n389|\trequest.CheckpointRequired = true\n390|\trequest.CheckpointID = world.ckptID\n391|\tbefore := eventCount(t, world.repo)\n392|\toutcome, err := Run(world.stores(), request)\n393|\tif err != nil {\n394|\t\tt.Fatalf(\"Run() error = %v\", err)\n395|\t}\n396|\tif outcome.Decision.Action != ActionParked {\n397|\t\tt.Fatalf(\"Run() action = %q, want parked\", outcome.Decision.Action)\n398|\t}\n399|\tif outcome.Emitted {\n400|\t\tt.Fatal(\"Run() authored session.parked from creating, want no emission\")\n401|\t}\n402|\tif after := eventCount(t, world.repo); after != before {\n403|\t\tt.Fatalf(\"event count = %d, want %d (no unfolderable emission)\", after, before)\n404|\t}\n405|\t// The chain without the parked event still folds; with it, the\n406|\t// landed reducer refuses (the rev1 collision).\n407|\trecordJSON, err := world.repo.GetRecord(fixtureSession)\n408|\tif err != nil {\n409|\t\tt.Fatal(err)\n410|\t}\n411|\trecord, err := sessstate.DecodeRecord(recordJSON)\n412|\tif err != nil {\n413|\t\tt.Fatal(err)\n414|\t}\n415|\tsummaries, err := world.repo.ListEvents(fixtureSession)\n416|\tif err != nil {\n417|\t\tt.Fatal(err)\n418|\t}\n419|\tvar events []sessstate.Event\n420|\tfor _, summary := range summaries {\n421|\t\traw, err := world.repo.GetEvent(fixtureSession, summary.EventID)\n422|\t\tif err != nil {\n423|\t\t\tt.Fatal(err)\n424|\t\t}\n425|\t\tevent, err := sessstate.DecodeEvent(raw)\n426|\t\tif err != nil {\n427|\t\t\tt.Fatal(err)\n428|\t\t}\n429|\t\tevents = append(events, event)\n430|\t}\n431|\tif _, err := sessstate.Reduce(sessstate.Input{Record: record, Events: events, LocalHostID: fixtureLocalHost}); err != nil {\n432|\t\tt.Fatalf(\"sessstate.Reduce over parked-without-emission chain error = %v\", err)\n433|\t}\n434|}\n435|\n436|// TestEmitUnderLosingLeaseRefuses pins P1-1 (probe 9): Emit under a\n437|// losing lease refuses through AuthorizeMutation, never appends. On\n438|// rev1 (no mutation gate) this appended.\n439|func TestEmitUnderLosingLeaseRefuses(t *testing.T) {\n440|\tt.Parallel()\n441|\tworld := buildRunWorld(t)\n442|\tleases, err := world.repo.ListLeases(fixtureSession)\n443|\tif err != nil {\n444|\t\tt.Fatal(err)\n445|\t}\n446|\tif _, err := world.repo.CompareAndSwapLease(fixtureSession, sessrepo.LeaseExpectation{RecordID: leases[0].RecordID}, sessrepo.SuccessorLeaseInput{\n447|\t\tCreateLeaseInput: sessrepo.CreateLeaseInput{LeaseID: fixtureLeaseB, HolderHostID: fixtureRemoteHost, IssuedByHostID: fixtureRemoteHost, CreatedAt: fixtureCreatedAt},\n448|\t\tReason:           \"graceful_takeover\",\n449|\t\tCheckpointID:     seedDigest(0xC9),\n450|\t}); err != nil {\n451|\t\tt.Fatal(err)\n452|\t}\n453|\tobservation := fixtureObservation(fixtureNow())\n454|\tobservation.Winner = sessrepo.LeaseSummary{SessionID: fixtureSession, LeaseID: fixtureLeaseB, Epoch: 2, HolderHostID: fixtureRemoteHost, Reason: \"graceful_takeover\"}\n455|\tdecision := Decision{Action: ActionParked, ParkReason: fencing.ParkStaleOwner, WinningLeaseID: fixtureLeaseB}\n456|\tif _, _, err := EmitParked(world.repo, decision, EmitParams{\n457|\t\tSessionID: fixtureSession, CreatedByHost: fixtureLocalHost,\n458|\t\tLeaseEpoch: 1, LeaseID: fixtureLeaseA, LeaseSequence: 2,\n459|\t\tPredecessors: []string{world.headID}, CreatedAt: fixtureCreatedAt,\n460|\t\tPresented:   fencing.PresentedToken{SessionID: fixtureSession, Epoch: 1, LeaseID: fixtureLeaseA},\n461|\t\tObservation: observation,\n462|\t}); err == nil {\n463|\t\tt.Fatal(\"EmitParked under losing lease succeeded, want refusal\")\n464|\t}\n465|}\n466|\n467|// TestLosingLeaseProfileEventIgnored pins P1-1 (probe 15, §2.4): a\n468|// profile.changed authored under the superseded lease after a local\n469|// successor won never becomes the launch profile. On rev1 this\n470|// drove yolo/E2.\n471|func TestLosingLeaseProfileEventIgnored(t *testing.T) {\n472|\tt.Parallel()\n473|\tworld := buildRunWorld(t)\n474|\tleases, err := world.repo.ListLeases(fixtureSession)\n475|\tif err != nil {\n476|\t\tt.Fatal(err)\n477|\t}\n478|\tsuccessor := \"cccccccc-dddd-4eee-8fff-000000000002\"\n479|\tif _, err := world.repo.CompareAndSwapLease(fixtureSession, sessrepo.LeaseExpectation{RecordID: leases[0].RecordID}, sessrepo.SuccessorLeaseInput{\n480|\t\tCreateLeaseInput: sessrepo.CreateLeaseInput{LeaseID: successor, HolderHostID: fixtureLocalHost, IssuedByHostID: fixtureLocalHost, CreatedAt: fixtureCreatedAt},\n481|\t\tReason:           \"graceful_takeover\",\n482|\t\tCheckpointID:     world.ckptID,\n483|\t}); err != nil {\n484|\t\tt.Fatalf(\"CompareAndSwapLease() error = %v\", err)\n485|\t}\n486|\tchanged := appendChainEvent(t, world.repo, \"profile.changed\", 1, fixtureLeaseA, 2, world.headID, map[string]any{\n487|\t\t\"from\": \"standard\", \"to\": \"yolo\", \"confirmed\": true,\n488|\t})\n489|\trequest := runRequest(t, world)\n490|\trequest.Presented = fencing.PresentedToken{SessionID: fixtureSession, Epoch: 2, LeaseID: successor}\n491|\toutcome, err := Run(world.stores(), request)\n492|\tif err != nil {\n493|\t\tt.Fatalf(\"Run() error = %v\", err)\n494|\t}\n495|\tif outcome.Decision.Action == ActionLaunch && outcome.Decision.Profile.Source == changed {\n496|\t\tt.Fatalf(\"Run() launch profile source = losing-lease %s, want the checkpoint closure\", changed[:20])\n497|\t}\n498|\tif outcome.Decision.Action == ActionLaunch && outcome.Decision.Profile.Profile != \"standard\" {\n499|\t\tt.Fatalf(\"Run() launch profile = %+v, want standard from the closure\", outcome.Decision.Profile)\n500|\t}\n501|}\n502|\n503|// TestDecideRealmBindingMismatchRefuses pins P1-2: realm evidence\n504|// bound to another host binding or provider build refuses\n505|// capability_unavailable, never launches.\n506|func TestDecideRealmBindingMismatchRefuses(t *testing.T) {\n507|\tt.Parallel()\n508|\tt.Run(\"binding\", func(t *testing.T) {\n509|\t\tt.Parallel()\n510|\t\tdeps := buildDecideDeps(t, true)\n511|\t\taddRealmEvidence(t, deps.universe, seedDigest(0xB2), \"codex\", \"0.147.0\")\n512|\t\tinput := validInput(t, deps)\n513|\t\tinput.Realm.Caller = CallerBackground\n514|\t\tdecision := Decide(input)\n515|\t\tif decision.Action != ActionRefused || decision.Class != \"capability_unavailable\" {\n516|\t\t\tt.Fatalf(\"Decide() = (%q, %q), want refused for binding mismatch\", decision.Action, decision.Class)\n517|\t\t}\n518|\t})\n519|\tt.Run(\"build\", func(t *testing.T) {\n520|\t\tt.Parallel()\n521|\t\tdeps := buildDecideDeps(t, true)\n522|\t\taddRealmEvidence(t, deps.universe, seedDigest(0xB1), \"codex\", \"9.9.9\")\n523|\t\tinput := validInput(t, deps)\n524|\t\tinput.Realm.Caller = CallerBackground\n525|\t\tdecision := Decide(input)\n526|\t\tif decision.Action != ActionRefused || decision.Class != \"capability_unavailable\" {\n527|\t\t\tt.Fatalf(\"Decide() = (%q, %q), want refused for build mismatch\", decision.Action, decision.Class)\n528|\t\t}\n529|\t})\n530|\tt.Run(\"generation\", func(t *testing.T) {\n531|\t\tt.Parallel()\n532|\t\tdeps := buildDecideDeps(t, true)\n533|\t\taddRealmEvidence(t, deps.universe, seedDigest(0xB1), \"codex\", \"0.147.0\")\n534|\t\tinput := validInput(t, deps)\n535|\t\tinput.Realm.Caller = CallerBackground\n536|\t\tinput.Realm.ServerGeneration = \"generation-stale\"\n537|\t\tdecision := Decide(input)\n538|\t\tif decision.Action != ActionRefused || decision.Class != \"capability_unavailable\" {\n539|\t\t\tt.Fatalf(\"Decide() = (%q, %q), want refused for stale generation\", decision.Action, decision.Class)\n540|\t\t}\n541|\t})\n542|}\n543|\n544|// TestEmitParkedUnfoldableRefuses pins P1-1 through the direct\n545|// EmitParked entry: a restore_policy park from a creating chain\n546|// refuses, never appends. On rev1 this appended creating -> parked.\n547|func TestEmitParkedUnfoldableRefuses(t *testing.T) {\n548|\tt.Parallel()\n549|\tdeps := buildDecideDeps(t, true)\n550|\tinput := validInput(t, deps)\n551|\tinput.MaterializationRequired = true\n552|\tinput.JournalOK = true\n553|\tdecision := Decide(input)\n554|\tif decision.Action != ActionParked {\n555|\t\tt.Fatalf(\"Decide() action = %q, want parked\", decision.Action)\n556|\t}\n557|\t_, tail, err := ChainTail(deps.repo, fixtureSession)\n558|\tif err != nil {\n559|\t\tt.Fatal(err)\n560|\t}\n561|\tobservation := fixtureObservation(fixtureNow())\n562|\tif _, _, err := EmitParked(deps.repo, decision, EmitParams{\n563|\t\tSessionID: fixtureSession, CreatedByHost: fixtureLocalHost,\n564|\t\tLeaseEpoch: 1, LeaseID: fixtureLeaseA, LeaseSequence: tail.LeaseSequence + 1,\n565|\t\tPredecessors: []string{tail.EventID}, CreatedAt: fixtureCreatedAt,\n566|\t\tPresented:   fixturePresented(),\n567|\t\tObservation: observation,\n568|\t}); err == nil {\n569|\t\tt.Fatal(\"EmitParked from creating succeeded, want refusal\")\n570|\t}\n571|}\n572|\n573|// TestDecideSmokeTargetBindingRefuses pins P1-2: a required smoke\n574|// with a typed target bound to another build or OS version refuses\n575|// target_auth_missing, never launches.\n576|func TestDecideSmokeTargetBindingRefuses(t *testing.T) {\n577|\tt.Parallel()\n578|\tt.Run(\"build\", func(t *testing.T) {\n579|\t\tt.Parallel()\n580|\t\tdeps := buildDecideDeps(t, true)\n581|\t\tinput := validInput(t, deps)\n582|\t\tinput.Smoke.Required = true\n583|\t\tinput.Smoke.Record = smokeRecord(t, \"pass\", \"A\", passingSmokeChecks(), smokeTuple())\n584|\t\ttarget := smokeTarget()\n585|\t\ttarget.ProviderBuild = \"9.9.9\"\n586|\t\tinput.Smoke.Target = target\n587|\t\tdecision := Decide(input)\n588|\t\tif decision.Action != ActionRefused || decision.Class != \"target_auth_missing\" {\n589|\t\t\tt.Fatalf(\"Decide() = (%q, %q), want refused target_auth_missing for target build drift\", decision.Action, decision.Class)\n590|\t\t}\n591|\t})\n592|\tt.Run(\"os\", func(t *testing.T) {\n593|\t\tt.Parallel()\n594|\t\tdeps := buildDecideDeps(t, true)\n595|\t\tinput := validInput(t, deps)\n596|\t\tinput.Smoke.Required = true\n597|\t\tinput.Smoke.Record = smokeRecord(t, \"pass\", \"A\", passingSmokeChecks(), smokeTuple())\n598|\t\ttarget := smokeTarget()\n599|\t\ttarget.MacOSVersion = \"15.0\"\n600|\t\tinput.Smoke.Target = target\n601|\t\tdecision := Decide(input)\n602|\t\tif decision.Action != ActionRefused || decision.Class != \"target_auth_missing\" {\n603|\t\t\tt.Fatalf(\"Decide() = (%q, %q), want refused target_auth_missing for target OS drift\", decision.Action, decision.Class)\n604|\t\t}\n605|\t})\n606|}\n607|\n608|// TestIsFencingRefusal covers the Run emission error classifier: a\n609|// fencing gate refusal parks without evidence, while a repository\n610|// failure propagates.\n611|func TestIsFencingRefusal(t *testing.T) {\n612|\tt.Parallel()\n613|\tif isFencingRefusal(nil) {\n614|\t\tt.Fatal(\"isFencingRefusal(nil) = true, want false\")\n615|\t}\n616|\tif !isFencingRefusal(fencing.ErrNotOwner) {\n617|\t\tt.Fatal(\"isFencingRefusal(ErrNotOwner) = false, want true\")\n618|\t}\n619|\tif isFencingRefusal(errCheckpointMembers()) {\n620|\t\tt.Fatal(\"isFencingRefusal(checkpoint) = true, want false\")\n621|\t}\n622|}\n623|\n624|// TestBindSweepsStaleStaging pins P3-1: a pre-commit crash staging\n625|// file older than a minute is swept by the next Bind, while fresh\n626|// concurrent staging is left alone.\n627|func TestBindSweepsStaleStaging(t *testing.T) {\n628|\tt.Parallel()\n629|\tstore := openPaneStore(t)\n630|\tdir := store.sessionDir(fixtureSession)\n631|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n632|\t\tt.Fatal(err)\n633|\t}\n634|\tstale := filepath.Join(dir, \"binding-9999999999.tmp\")\n635|\tif err := os.WriteFile(stale, []byte(\"stale\"), 0o600); err != nil {\n636|\t\tt.Fatal(err)\n637|\t}\n638|\told := time.Now().Add(-2 * time.Minute)\n639|\tif err := os.Chtimes(stale, old, old); err != nil {\n640|\t\tt.Fatal(err)\n641|\t}\n642|\tif _, _, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate()); err != nil {\n643|\t\tt.Fatalf(\"Bind() error = %v\", err)\n644|\t}\n645|\tif _, err := os.Stat(stale); !os.IsNotExist(err) {\n646|\t\tt.Fatalf(\"stale staging file survives Bind: %v\", err)\n647|\t}\n648|}","final_result":true}}}
