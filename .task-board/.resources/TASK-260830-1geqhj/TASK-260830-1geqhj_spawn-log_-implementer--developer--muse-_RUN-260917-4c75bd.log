{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d6e3","stream":{"kind":"session","id":"01a0b131-d4f6-7b82-a7a6-5363cf3ac7fb"},"sequence":2508,"recorded_at":1780531400005011,"record_type":"event","durability":"durable","causation_id":"2237b1e3-856b-4a22-9f46-61adba667efd","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2237b1e3-856b-4a22-9f46-61adba667efd","run_stream":{"kind":"run","id":"2237b1e3-856b-4a22-9f46-61adba667efd"},"task_stream":{"kind":"task","id":"01a0b13e-7b84-7880-b844-83bf4f2989c0"},"task_id":"01a0b13e-7b84-7880-b844-83bf4f2989c0","event":{"kind":"output","task_id":"01a0b13e-7b84-7880-b844-83bf4f2989c0","chunk":"edited\nchanged lines: lines 53-70\n--- original\n+++ updated\n@@\n-// Hooks arms the crash boundaries of Bind: after the receipt bytes\n-// are staged to the temporary file (before the atomic install), and\n-// after the install commits (before the directory sync makes the\n-// commit durable). A nil hook is a no-op; a hook error aborts Bind\n-// with that error and installs nothing further.\n-type Hooks struct {\n-\tAfterStage   func(path string) error\n-\tAfterInstall func(path string) error\n-}\n-\n-// Store is the durable bootstrap binding store rooted at one data\n-// directory. Bindings live under\n-// <root>/axpane/bootstrap/<session_id>/binding.json.\n-type Store struct {\n-\troot  string\n-\thooks *Hooks\n-\tnow   func() time.Time\n-}\n+// Hooks arms the crash boundaries of the staged installs: after\n+// the receipt bytes are staged to the temporary file (before the\n+// atomic install), and after the install commits (before the\n+// directory sync makes the commit durable). The hooks fire on\n+// whichever install path runs: Bind's first-anchor install and\n+// Supersede's pair-receipt install. A nil hook is a no-op; a hook\n+// error aborts the call with that error and installs nothing\n+// further on that path.\n+type Hooks struct {\n+\tAfterStage   func(path string) error\n+\tAfterInstall func(path string) error\n+}\n+\n+// Store is the durable bootstrap binding store rooted at one data\n+// directory. The session's first binding anchors at\n+// <root>/axpane/bootstrap/<session_id>/binding.json, and every\n+// recorded (session_id, bootstrap_operation_id) pair keeps its own\n+// receipt at\n+// <root>/axpane/bootstrap/<session_id>/receipts/<operation_id>.json.\n+// Superseded pairs keep their receipts: an identical retry of any\n+// recorded pair replays its own receipt.\n+type Store struct {\n+\troot  string\n+\thooks *Hooks\n+\tnow   func() time.Time\n+}\n","final_result":true}}}
