 input *Input) {\n234|\t\t\t\tinput.ExistingBinding = &Binding{SessionID: fixtureSession, OperationID: fixtureBootstrap, TerminalInstanceID: fixtureInstance, BindingDigest: seedDigest(0xB1), CreatedAt: fixtureCreatedAt}\n235|\t\t\t},\n236|\t\t\twant: ActionReattach,\n237|\t\t},\n238|\t\t{\n239|\t\t\tname: \"attach_remote_interactive\",\n240|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n241|\t\t\t\tinput.Observation.Winner.HolderHostID = fixtureRemoteHost\n242|\t\t\t\tinput.RemoteInteractive = true\n243|\t\t\t},\n244|\t\t\twant:      ActionAttachRemote,\n245|\t\t\twantLease: fixtureLeaseA,\n246|\t\t},\n247|\t\t{\n248|\t\t\tname: \"takeover_offer_noninteractive\",\n249|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n250|\t\t\t\tinput.Observation.Winner.HolderHostID = fixtureRemoteHost\n251|\t\t\t\tinput.RemoteInteractive = false\n252|\t\t\t},\n253|\t\t\twant:       ActionParked,\n254|\t\t\twantReason: fencing.ParkRemoteOwner,\n255|\t\t\twantLease:  fixtureLeaseA,\n256|\t\t},\n257|\t\t{\n258|\t\t\tname:        \"takeover_offer_attach_unproven\",\n259|\t\t\tattachProbe: true,\n260|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n261|\t\t\t\tinput.Observation.Winner.HolderHostID = fixtureRemoteHost\n262|\t\t\t\tinput.RemoteInteractive = true\n263|\t\t\t},\n264|\t\t\twant:      ActionTakeoverOffer,\n265|\t\t\twantLease: fixtureLeaseA,\n266|\t\t},\n267|\t\t{\n268|\t\t\tname: \"refused_config_invalid\",\n269|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n270|\t\t\t\tinput.ConfigErr = errFixtureConfig\n271|\t\t\t},\n272|\t\t\twant:      ActionRefused,\n273|\t\t\twantClass: ClassInvalidConfig,\n274|\t\t},\n275|\t\t{\n276|\t\t\tname: \"refused_unknown_mode\",\n277|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n278|\t\t\t\tinput.Mode = Mode(\"bogus\")\n279|\t\t\t},\n280|\t\t\twant:      ActionRefused,\n281|\t\t\twantClass: ClassInvalidArguments,\n282|\t\t},\n283|\t\t{\n284|\t\t\tname: \"refused_empty_mode\",\n285|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n286|\t\t\t\tinput.Mode = Mode(\"\")\n287|\t\t\t},\n288|\t\t\twant:      ActionRefused,\n289|\t\t\twantClass: ClassInvalidArguments,\n290|\t\t},\n291|\t\t{\n292|\t\t\tname: \"refused_unknown_session\",\n293|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n294|\t\t\t\tinput.SessionKnown = false\n295|\t\t\t},\n296|\t\t\twant:      ActionRefused,\n297|\t\t\twantClass: ClassInvalidArguments,\n298|\t\t},\n299|\t\t{\n300|\t\t\tname: \"refused_idempotency_mismatch\",\n301|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n302|\t\t\t\tinput.ExistingBinding = &Binding{SessionID: fixtureSession, OperationID: fixtureOtherOp, TerminalInstanceID: fixtureInstance, BindingDigest: seedDigest(0xB1), CreatedAt: fixtureCreatedAt}\n303|\t\t\t},\n304|\t\t\twant:      ActionRefused,\n305|\t\t\twantClass: terminalbackend.CodeIdempotencyMismatch,\n306|\t\t},\n307|\t\t{\n308|\t\t\tname: \"refused_unknown_caller\",\n309|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n310|\t\t\t\tinput.Realm.Caller = \"batch\"\n311|\t\t\t},\n312|\t\t\twant:      ActionRefused,\n313|\t\t\twantClass: ClassInvalidArguments,\n314|\t\t},\n315|\t\t{\n316|\t\t\tname: \"refused_backend_generation_mismatch\",\n317|\t\t\tuniverse: func(t *testing.T, universe *backendUniverse) {\n318|\t\t\t\tuniverse.probe[\"backend_generation_digest\"] = seedDigest(0x99)\n319|\t\t\t\tuniverse.probe[\"probe_id\"] = omitSelfIdentity(t, universe.probe, \"probe_id\")\n320|\t\t\t},\n321|\t\t\twant:      ActionRefused,\n322|\t\t\twantClass: terminalbackend.CodeStaleGeneration,\n323|\t\t},\n324|\t\t{\n325|\t\t\tname: \"refused_backend_protocol_membership\",\n326|\t\t\tuniverse: func(t *testing.T, universe *backendUniverse) {\n327|\t\t\t\tuniverse.probe[\"protocol_version\"] = \"2.0.0\"\n328|\t\t\t\tuniverse.probe[\"probe_id\"] = omitSelfIdentity(t, universe.probe, \"probe_id\")\n329|\