{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c953","stream":{"kind":"session","id":"01a0b131-d4f6-7b82-a7a6-5363cf3ac7fb"},"sequence":772,"recorded_at":1780531400001539,"record_type":"event","durability":"durable","causation_id":"2237b1e3-856b-4a22-9f46-61adba667efd","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2237b1e3-856b-4a22-9f46-61adba667efd","run_stream":{"kind":"run","id":"2237b1e3-856b-4a22-9f46-61adba667efd"},"task_stream":{"kind":"task","id":"01a0b135-0537-7163-849c-8962f60c3271"},"task_id":"01a0b135-0537-7163-849c-8962f60c3271","event":{"kind":"output","task_id":"01a0b135-0537-7163-849c-8962f60c3271","chunk":"Read text file `internal/axpane/decide.go`.\n(399 line(s) above)\n400|\tif input.CheckpointRequired {\n401|\t\tif _, err := admitCheckpoint(input); err != nil {\n402|\t\t\treturn parked(fencing.ParkRestorePolicy, input.Observation.Winner.LeaseID, err)\n403|\t\t}\n404|\t}\n405|\n406|\tif err := checkProviderIdentity(input.Provider); err != nil {\n407|\t\treturn refused(providerClass(err), \"provider identity is unresolved\", err)\n408|\t}\n409|\tif err := checkSmoke(input); err != nil {\n410|\t\tdecision := refused(smokeClass(err), \"provider-auth smoke precondition failed\", err)\n411|\t\tvar typed *axerror.Error\n412|\t\tif errors.As(err, &typed) {\n413|\t\t\tdecision.RealmFailure = typed\n414|\t\t}\n415|\t\treturn decision\n416|\t}\n417|\tif err := checkRealm(input, admitted, evidence); err != nil {\n418|\t\tvar malformed errInvalidArguments\n419|\t\tif errors.As(err, &malformed) {\n420|\t\t\treturn refused(ClassInvalidArguments, \"background caller realm details are incomplete\", err)\n421|\t\t}\n422|\t\tvar typed *axerror.Error\n423|\t\tif errors.As(err, &typed) {\n424|\t\t\tdecision := refused(string(typed.Code()), \"background caller has no admitted realm evidence\", err)\n425|\t\t\tdecision.RealmFailure = typed\n426|\t\t\treturn decision\n427|\t\t}\n428|\t\treturn refused(ClassInvalidArguments, \"background caller realm is unverifiable\", err)\n429|\t}\n430|\tpair, err := deriveProfile(input)\n431|\tif err != nil {\n432|\t\treturn refused(ClassIntegrityFailure, \"effective profile derivation failed\", err)\n433|\t}\n434|\t// The tuple gate above already admitted the probed build, so a\n435|\t// ResolveMapping failure here is the mapping gap Section 2.4\n436|\t// names, never a tuple refusal wearing the mapping class.\n437|\tresolved, err := provhost.ResolveMapping(input.Provider.Build.ProviderID, pair.Profile, input.Provider.Build)\n438|\tif err != nil {\n439|\t\treturn refused(ClassProfileMappingUnavailable, \"adapter cannot map the stored profile\", err)\n440|\t}\n441|\tif err := terminalbackend.CheckEntrypoint(input.Entrypoint, input.SessionID); err != nil {\n442|\t\treturn refused(backendClass(err), \"stable entrypoint is not ax pane SESSION_ID\", err)\n443|\t}\n444|\n445|\tdecision := Decision{\n446|\t\tAction:   ActionLaunch,\n447|\t\tToken:    token,\n448|\t\tHasToken: true,\n449|\t\tProfile:  pair,\n450|\t\tMapping:  resolved.Mapping,\n451|\t\tAdmitted: admitted,\n452|\t\tDetail:   \"launch under the winning lease\",\n453|\t}\n454|\tif input.ExistingBinding != nil && input.ExistingBinding.OperationID == input.BootstrapOperationID {\n455|\t\tdecision.Action = ActionReattach\n456|\t\tdecision.Detail = \"reattach to the one recorded wrapper/child\"\n457|\t}\n458|\tdescriptor, err := terminalbackend.AdmitProviderDescriptor(input.Descriptor, input.HostBinding)\n459|\tif err != nil {\n460|\t\treturn refused(backendClass(err), \"provider descriptor does not match the validated binding\", err)\n461|\t}\n462|\tdecision.Descriptor = descriptor\n463|\treturn decision\n464|}\n465|\n466|// decideParked resolves a fencing park into the parked outcome or,\n467|// for a remote owner in an interactive terminal, the attach/takeover\n468|// offer of after-restore step 4. Attach requires the admitted attach\n469|// capability; an interactive remote owner without it offers takeover\n470|// instead of starting a runtime. A remote owner outside an\n471|// interactive terminal parks with the remote_owner reason (§4.2 step\n472|// 5: parked in all other cases). Non-remote parks carry the fencing\n473|// reason unchanged.\n474|func decideParked(input Input, admitted terminalbackend.Admitted, reason fencing.ParkReason, winning string, cause error) Decision {\n475|\tif reason != fencing.ParkRemoteOwner {\n476|\t\treturn parked(reason, winning, cause)\n477|\t}\n478|\tif !input.RemoteInteractive {\n479|\t\treturn parked(reason, winning, cause)\n480|\t}\n481|\tif terminalbackend.CheckOperation(\"attach\", admitted) == nil {\n482|\t\treturn Decision{\n483|\t\t\tAction:         ActionAttachRemote,\n484|\t\t\tParkReason:     reason,\n485|\t\t\tWinningLeaseID: winning,\n486|\t\t\tAdmitted:       admitted,\n487|\t\t\tDetail:         \"offer remote attach; no lease mutation\",\n488|\t\t\tCause:          cause,\n489|\t\t}\n490|\t}\n491|\treturn Decision{\n492|\t\tAction:         ActionTakeoverOffer,\n493|\t\tParkReason:     reason,\n494|\t\tWinningLeaseID: winning,\n495|\t\tAdmitted:       admitted,\n496|\t\tDetail:         \"offer takeover; no runtime started\",\n497|\t\tCause:          cause,\n498|\t}\n499|}\n500|\n501|// bootstrapWindowClosed reports whether the §13.1 bootstrap window\n502|// has closed: the winner carries a checkpoint, so the first\n503|// checkpoint is published and a new bootstrap operation is a\n504|// legitimate post-window binding, not an in-window mismatch. The\n505|// predicate reads only the winner's own HasCheckpoint; a caller\n506|// claim never closes the window.\n507|func bootstrapWindowClosed(observation fencing.Observation) bool {\n508|\treturn observation.HasWinner && observation.Winner.HasCheckpoint\n509|}\n510|\n511|// authorize selects the fencing entry by mode: activation for a\n512|// fresh launch, restore for the after-restore first start. Both are\n513|// launch-class entries: ownership that is remote, ambiguous,\n514|// unverified, or absent parks with the session.parked vocabulary,\n515|// while malformed calls, foreign sessions, and lapsed grants refuse.\n516|func authorize(input Input) (fencing.LeaseToken, error) {\n517|\tif input.Mode == ModeRestore {\n518|\t\treturn fencing.AuthorizeRestore(input.Presented, input.Observation)\n519|\t}\n520|\treturn fencing.AuthorizeActivation(input.Presented, input.Observation)\n521|}\n522|\n523|// admitBackend parses the §4.B identity documents through the\n524|// terminalbackend owner, reconciles the Probe against the Manifest\n525|// with the returned evidence bound to the AX-known raw generation,\n526|// and gates the mode operation against the admitted set. Only the\n527|// exact admitted capability rows authorize the action; no\n528|// capability map is invented here. The parsed evidence is returned\n529|// alongside the admitted set so the realm arm can bind the\n530|// credential-realm row to the host binding and probed build\n531|// without re-parsing.\n532|func admitBackend(input Input) (terminalbackend.Admitted, []terminalbackend.Evidence, error) {\n533|\tmanifest, err := terminalbackend.ParseManifest(input.Backend.Manifest)\n534|\tif err != nil {\n535|\t\treturn terminalbackend.Admitted{}, nil, err\n536|\t}\n537|\tprobe, err := terminalbackend.ParseProbe(input.Backend.Probe)\n538|\tif err != nil {\n539|\t\treturn terminalbackend.Admitted{}, nil, err\n540|\t}\n541|\tevidence := make([]terminalbackend.Evidence, 0, len(input.Backend.Evidence))\n542|\tfor _, doc := range input.Backend.Evidence {\n543|\t\tparsed, err := terminalbackend.ParseEvidence(doc)\n544|\t\tif err != nil {\n545|\t\t\treturn terminalbackend.Admitted{}, nil, err\n546|\t\t}\n547|\t\tevidence = append(evidence, parsed)\n548|\t}\n549|\tadmitted, err := terminalbackend.Reconcile(manifest, probe, evidence, input.Backend.RawGeneration, input.Backend.Now, input.Backend.Verify)\n550|\tif err != nil {\n551|\t\treturn terminalbackend.Admitted{}, nil, err\n552|\t}\n553|\toperation := \"create\"\n554|\tif input.Mode == ModeRestore {\n555|\t\toperation = \"restore\"\n556|\t}\n557|\tif err := terminalbackend.CheckOperation(operation, admitted); err != nil {\n558|\t\treturn terminalbackend.Admitted{}, nil, err\n559|\t}\n560|\treturn admitted, evidence, nil\n561|}\n562|\n563|// checkMaterialization enforces after-restore step 3: the required\n564|// journal must be admitted by the matjournal owner, committed, and\n565|// sourced from the winning lease's checkpoint. A committed journal\n566|// one generation behind the lease checkpoint is stale, never valid.\n567|func checkMaterialization(input Input) error {\n568|\tif !input.JournalOK || input.Journal.Phase != matjournal.PhaseCommitted {\n569|\t\treturn errMaterializationNotValid(input.Journal.Phase, input.JournalOK)\n570|\t}\n571|\tif input.Observation.HasWinner && input.Observation.Winner.HasCheckpoint {\n572|\t\tif input.Journal.SourceCheckpointID != input.Observation.Winner.Checkpoint {\n573|\t\t\treturn errMaterializationStale()\n574|\t\t}\n575|\t}\n576|\treturn nil\n577|}\n578|\n579|// admitCheckpoint admits exactly the winning lease's checkpoint for\n580|// resume (§13.11 step 5: validate the newest checkpoint). The closed\n581|// shape must attest through the sessrepo owner, the computed\n582|// identity must equal the required digest, the required digest must\n583|// equal the winner's checkpoint when the winner carries one, and the\n584|// checkpoint's own session_id must name this session. It returns the\n585|// checkpoint's event-head closure for the profile derivation.\n586|func admitCheckpoint(input Input) ([]string, error) {\n587|\tdoc := input.CheckpointDoc\n588|\twant := input.CheckpointID\n589|\tif len(doc) == 0 {\n590|\t\treturn nil, errCheckpointAbsent()\n591|\t}\n592|\tdigest, _, err := sessrepo.AttestCheckpointRecord(doc)\n593|\tif err != nil {\n594|\t\treturn nil, err\n595|\t}\n596|\tif digest.String() != want {\n597|\t\treturn nil, errCheckpointMismatch()\n598|\t}\n599|\tif input.Observation.HasWinner && input.Observation.Winner.HasCheckpoint {\n600|\t\tif want != input.Observation.Winner.Checkpoint {\n601|\t\t\treturn nil, errCheckpointNotLease()\n602|\t\t}\n603|\t}\n604|\tsessionID, _, _, heads, err := decodeCheckpointMembers(doc)\n605|\tif err != nil {\n606|\t\treturn nil, err\n607|\t}\n608|\tif sessionID != input.SessionID {\n609|\t\treturn nil, errCheckpointForeign()\n610|\t}\n611|\treturn heads, nil\n612|}\n613|\n614|// decodeCheckpointMembers reads the bound members from checkpoint\n615|// bytes the sessrepo owner already attested: the subject session,\n616|// the owning lease, and the event-head closure. It mirrors the\n617|// sessquery extraction after AttestCheckpointRecord: shape and\n618|// identity are the owner's, this is only the member read.\n619|func decodeCheckpointMembers(doc []byte) (sessionID string, leaseEpoch uint64, leaseID string, heads []string, err error) {\n620|\tmembers, fault := environ.DecodeStrictObject(doc)\n621|\tif fault != nil {\n622|\t\treturn \"\", 0, \"\", nil, errCheckpointMembers()\n623|\t}\n624|\tsession, ok := environ.CheckUUIDv7(members[\"session_id\"])\n625|\tif !ok {\n626|\t\treturn \"\", 0, \"\", nil, errCheckpointMembers()\n627|\t}\n628|\tsessionID = session.String()\n629|\trawEpoch, ok := members[\"lease_epoch\"]\n630|\tif !ok {\n631|\t\treturn \"\", 0, \"\", nil, errCheckpointMembers()\n632|\t}\n633|\tvar epochFloat float64\n634|\tif err := json.Unmarshal(rawEpoch, &epochFloat); err != nil || epochFloat < 1 {\n635|\t\treturn \"\", 0, \"\", nil, errCheckpointMembers()\n636|\t}\n637|\tleaseEpoch = uint64(epochFloat)\n638|\tvar lease string\n639|\tif rawLease, ok := members[\"lease_id\"]; ok {\n640|\t\t_ = json.Unmarshal(rawLease, &lease)\n641|\t}\n642|\tif _, err := scalar.ParseUUIDv4(lease); err != nil {\n643|\t\treturn \"\", 0, \"\", nil, errCheckpointMembers()\n644|\t}\n645|\tleaseID = lease\n646|\trawHeads, ok := members[\"event_heads\"]\n647|\tif !ok {\n648|\t\treturn \"\", 0, \"\", nil, errCheckpointMembers()\n649|\t}\n650|\tvar values []string\n651|\tif err := json.Unmarshal(rawHeads, &values); err != nil {\n652|\t\treturn \"\", 0, \"\", nil, errCheckpointMembers()\n653|\t}\n654|\tfor _, value := range values {\n655|\t\thead, err := scalar.ParseDigest(value)\n656|\t\tif err != nil {\n657|\t\t\treturn \"\", 0, \"\", nil, errCheckpointMembers()\n658|\t\t}\n659|\t\theads = append(heads, head.String())\n660|\t}\n661|\treturn sessionID, leaseEpoch, leaseID, heads, nil\n662|}\n663|\n664|// checkpointHeads extracts the event-head closure from checkpoint\n665|// bytes for the profile derivation. It attests through the sessrepo\n666|// owner first; unattested bytes never supply a closure.\n667|func checkpointHeads(doc []byte) ([]string, error) {\n668|\tif len(doc) == 0 {\n669|\t\treturn nil, errCheckpointAbsent()\n670|\t}\n671|\tif _, _, err := sessrepo.AttestCheckpointRecord(doc); err != nil {\n672|\t\treturn nil, err\n673|\t}\n674|\t_, _, _, heads, err := decodeCheckpointMembers(doc)\n675|\treturn heads, err\n676|}\n677|\n678|// deriveProfile derives the effective persisted pair: from the\n679|// validated checkpoint's event-head closure on resume (§13.10),\n680|// from the session head otherwise. The closure heads arrive from\n681|// the winner's checkpoint through Run, or from the required\n682|// checkpoint's own closure when the winner's heads are not\n683|// supplied; a head-only or losing-lease change outside the closure\n684|// never becomes the launch profile.\n685|func deriveProfile(input Input) (sessprofile.Pair, error) {\n686|\theads := input.ProfileHeads\n687|\tif len(heads) == 0 && input.CheckpointRequired && len(input.CheckpointDoc) > 0 {\n688|\t\tclosure, err := checkpointHeads(input.CheckpointDoc)\n689|\t\tif err != nil {\n690|\t\t\treturn sessprofile.Pair{}, err\n691|\t\t}\n692|\t\theads = closure\n693|\t}\n694|\tif len(heads) > 0 {\n695|\t\treturn sessprofile.DeriveForHeads(input.ProfileRecord, input.ProfileEvents, heads)\n696|\t}\n697|\treturn sessprofile.Derive(input.ProfileRecord, input.ProfileEvents)\n698|}\n699|\n700|// checkProviderIdentity composes the provhost resume gate: the exact\n701|// probed build tuple must pass the Section 8.4 direction, the stored\n702|// identity must validate for that provider at that exact version,\n703|// and the discovery proof, when present, must bind to the host-side\n704|// facts.\n705|func checkProviderIdentity(facts ProviderFacts) error {\n706|\tif err := provhost.CheckResumeTuple(facts.Build); err != nil {\n707|\t\treturn err\n708|\t}\n709|\tif err := provhost.VerifyIdentityBuild(facts.Identity, facts.Build); err != nil {\n710|\t\treturn err\n711|\t}\n712|\tif facts.HasDiscovery {\n713|\t\tif err := provhost.VerifyIdentityDiscovery(facts.Identity, facts.Discovery, facts.DiscoveryContext); err != nil {\n714|\t\t\treturn err\n715|\t\t}\n716|\t}\n717|\treturn nil\n718|}\n719|\n720|// checkSmoke enforces the provider-auth smoke precondition when the\n721|// path requires provider credentials. The stored record must verify\n722|// through the resumesmoke owner, its verdict must be pass, its exact\n723|// claimed build must equal the probed build, and the typed target\n724|// must bind the same build with the current generation and the\n725|// probed OS version: a smoke result for one build, generation, or\n726|// OS version never authorizes another. A required smoke that is\n727|// absent, unverifiable, failing, or bound to another\n728|// build/generation/version refuses target_auth_missing with the\n729|// typed details Section 15.3 names.\n730|func checkSmoke(input Input) error {\n731|\tif !input.Smoke.Required {\n732|\t\treturn nil\n733|\t}\n734|\trecord, err := resumesmoke.VerifyRecord(input.Smoke.Record)\n735|\tif err != nil {\n736|\t\treturn smokeFailure(input, err)\n737|\t}\n738|\tif record.Verdict != resumesmoke.VerdictPass {\n739|\t\treturn smokeFailure(input, errSmokeVerdict(record.Verdict))\n740|\t}\n741|\tbuild := input.Provider.Build\n742|\tif record.Tuple.ProviderID != build.ProviderID ||\n743|\t\trecord.Tuple.ProviderVersion != build.ProviderVersion ||\n744|\t\trecord.Tuple.Platform != build.Platform ||\n745|\t\trecord.Tuple.Architecture != build.Architecture {\n746|\t\treturn smokeFailure(input, errSmokeTuple())\n747|\t}\n748|\ttarget := input.Smoke.Target\n749|\tif target.ProviderID != build.ProviderID || target.ProviderBuild != build.ProviderVersion {\n750|\t\treturn smokeFailure(input, errSmokeTargetBuild())\n751|\t}\n752|\tif target.TmuxServerGeneration != input.Backend.RawGeneration {\n753|\t\treturn smokeFailure(input, errSmokeTargetGeneration())\n754|\t}\n755|\tprobe, err := terminalbackend.ParseProbe(input.Backend.Probe)\n756|\tif err != nil {\n757|\t\treturn smokeFailure(input, err)\n758|\t}\n759|\tif target.MacOSVersion != probe.OSVersion {\n760|\t\treturn smokeFailure(input, errSmokeTargetOS())\n761|\t}\n762|\treturn nil\n763|}\n764|\n765|// smokeFailure composes the typed target_auth_missing refusal. Typed\n766|// details are required members of the input: an input that omits\n767|// one is itself malformed and refuses invalid_arguments instead of\n768|// emitting an untyped refusal.\n769|func smokeFailure(input Input, cause error) error {\n770|\tfailure, err := axerror.NewTargetAuthMissing(axerror.Version130,\n771|\t\t\"provider-auth smoke did not pass for the probed build\",\n772|\t\taxerror.NoIDs(), input.Smoke.Target, cause)\n773|\tif err != nil {\n774|\t\treturn fmt.Errorf(\"%w: smoke refusal details are incomplete: %v\", errInvalidArguments{}, err)\n775|\t}\n776|\treturn failure\n777|}\n778|\n779|// checkRealm enforces the §4.2 background-caller rule: a background\n780|// caller authorizes only through the admitted\n781|// credential_capable_execution_realm Capability Evidence row bound\n782|// to the exact host binding, the probed provider build, and the\n783|// current generation, admitted through the landed terminalbackend\n784|// reconcile path. It never falls back to direct server creation,\n785|// and no cached sentinel, managername observation, or bare boolean\n786|// authorizes resume. A foreground caller passes. Expiry, logout,\n787|// and reboot invalidation are the reconcile liveness and generation\n788|// binding the admission already enforces; a stale generation in the\n789|// typed details refuses as well. Typed details are required input\n790|// members: an input that omits one is itself malformed and refuses\n791|// invalid_arguments instead of emitting an untyped\n792|// capability_unavailable.\n793|func checkRealm(input Input, admitted terminalbackend.Admitted, evidence []terminalbackend.Evidence) error {\n794|\tif input.Realm.Caller != CallerBackground {\n795|\t\treturn nil\n796|\t}\n797|\tif !admitted.Has(credentialRealmCapability) {\n798|\t\treturn realmFailure(input, errNoRealmEvidence())\n799|\t}\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c955","stream":{"kind":"session","id":"01a0b131-d4f6-7b82-a7a6-5363cf3ac7fb"},"sequence":773,"recorded_at":1780531400001541,"record_type":"event","durability":"durable","causation_id":"2237b1e3-856b-4a22-9f46-61adba667efd","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2237b1e3-856b-4a22-9f46-61adba667efd","run_stream":{"kind":"run","id":"2237b1e3-856b-4a22-9f46-61adba667efd"},"task_stream":{"kind":"task","id":"01a0b135-0537-7163-849c-8962f60c3271"},"task_id":"01a0b135-0537-7163-849c-8962f60c3271","event":{"kind":"completed","task_id":"01a0b135-0537-7163-849c-8962f60c3271"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c957","stream":{"kind":"session","id":"01a0b131-d4f6-7b82-a7a6-5363cf3ac7fb"},"sequence":774,"recorded_at":1780531400001543,"record_type":"event","durability":"durable","causation_id":"2237b1e3-856b-4a22-9f46-61adba667efd","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"2237b1e3-856b-4a22-9f46-61adba667efd","run_stream":{"kind":"run","id":"2237b1e3-856b-4a22-9f46-61adba667efd"},"call_id":"call_01a0b135026f771bb4e8a32c607f1e38","text":"Read text file `internal/axpane/decide.go`.\n(399 line(s) above)\n400|\tif input.CheckpointRequired {\n401|\t\tif _, err := admitCheckpoint(input); err != nil {\n402|\t\t\treturn parked(fencing.ParkRestorePolicy, input.Observation.Winner.LeaseID, err)\n403|\t\t}\n404|\t}\n405|\n406|\tif err := checkProviderIdentity(input.Provider); err != nil {\n407|\t\treturn refused(providerClass(err), \"provider identity is unresolved\", err)\n408|\t}\n409|\tif err := checkSmoke(input); err != nil {\n410|\t\tdecision := refused(smokeClass(err), \"provider-auth smoke precondition failed\", err)\n411|\t\tvar typed *axerror.Error\n412|\t\tif errors.As(err, &typed) {\n413|\t\t\tdecision.RealmFailure = typed\n414|\t\t}\n415|\t\treturn decision\n416|\t}\n417|\tif err := checkRealm(input, admitted, evidence); err != nil {\n418|\t\tvar malformed errInvalidArguments\n419|\t\tif errors.As(err, &malformed) {\n420|\t\t\treturn refused(ClassInvalidArguments, \"background caller realm details are incomplete\", err)\n421|\t\t}\n422|\t\tvar typed *axerror.Error\n423|\t\tif errors.As(err, &typed) {\n424|\t\t\tdecision := refused(string(typed.Code()), \"background caller has no admitted realm evidence\", err)\n425|\t\t\tdecision.RealmFailure = typed\n426|\t\t\treturn decision\n427|\t\t}\n428|\t\treturn refused(ClassInvalidArguments, \"background caller realm is unverifiable\", err)\n429|\t}\n430|\tpair, err := deriveProfile(input)\n431|\tif err != nil {\n432|\t\treturn refused(ClassIntegrityFailure, \"effective profile derivation failed\", err)\n433|\t}\n434|\t// The tuple gate above already admitted the probed build, so a\n435|\t// ResolveMapping failure here is the mapping gap Section 2.4\n436|\t// names, never a tuple refusal wearing the mapping class.\n437|\tresolved, err := provhost.ResolveMapping(input.Provider.Build.ProviderID, pair.Profile, input.Provider.Build)\n438|\tif err != nil {\n439|\t\treturn refused(ClassProfileMappingUnavailable, \"adapter cannot map the stored profile\", err)\n440|\t}\n441|\tif err := terminalbackend.CheckEntrypoint(input.Entrypoint, input.SessionID); err != nil {\n442|\t\treturn refused(backendClass(err), \"stable entrypoint is not ax pane SESSION_ID\", err)\n443|\t}\n444|\n445|\tdecision := Decision{\n446|\t\tAction:   ActionLaunch,\n447|\t\tToken:    token,\n448|\t\tHasToken: true,\n449|\t\tProfile:  pair,\n450|\t\tMapping:  resolved.Mapping,\n451|\t\tAdmitted: admitted,\n452|\t\tDetail:   \"launch under the winning lease\",\n453|\t}\n454|\tif input.ExistingBinding != nil && input.ExistingBinding.OperationID == input.BootstrapOperationID {\n455|\t\tdecision.Action = ActionReattach\n456|\t\tdecision.Detail = \"reattach to the one recorded wrapper/child\"\n457|\t}\n458|\tdescriptor, err := terminalbackend.AdmitProviderDescriptor(input.Descriptor, input.HostBinding)\n459|\tif err != nil {\n460|\t\treturn refused(backendClass(err), \"provider descriptor does not match the validated binding\", err)\n461|\t}\n462|\tdecision.Descriptor = descriptor\n463|\treturn decision\n464|}\n465|\n466|// decideParked resolves a fencing park into the parked outcome or,\n467|// for a remote owner in an interactive terminal, the attach/takeover\n468|// offer of after-restore step 4. Attach requires the admitted attach\n469|// capability; an interactive remote owner without it offers takeover\n470|// instead of starting a runtime. A remote owner outside an\n471|// interactive terminal parks with the remote_owner reason (§4.2 step\n472|// 5: parked in all other cases). Non-remote parks carry the fencing\n473|// reason unchanged.\n474|func decideParked(input Input, admitted terminalbackend.Admitted, reason fencing.ParkReason, winning string, cause error) Decision {\n475|\tif reason != fencing.ParkRemoteOwner {\n476|\t\treturn parked(reason, winning, cause)\n477|\t}\n478|\tif !input.RemoteInteractive {\n479|\t\treturn parked(reason, winning, cause)\n480|\t}\n481|\tif terminalbackend.CheckOperation(\"attach\", admitted) == nil {\n482|\t\treturn Decision{\n483|\t\t\tAction:         ActionAttachRemote,\n484|\t\t\tParkReason:     reason,\n485|\t\t\tWinningLeaseID: winning,\n486|\t\t\tAdmitted:       admitted,\n487|\t\t\tDetail:         \"offer remote attach; no lease mutation\",\n488|\t\t\tCause:          cause,\n489|\t\t}\n490|\t}\n491|\treturn Decision{\n492|\t\tAction:         ActionTakeoverOffer,\n493|\t\tParkReason:     reason,\n494|\t\tWinningLeaseID: winning,\n495|\t\tAdmitted:       admitted,\n496|\t\tDetail:         \"offer takeover; no runtime started\",\n497|\t\tCause:          cause,\n498|\t}\n499|}\n500|\n501|// bootstrapWindowClosed reports whether the §13.1 bootstrap window\n502|// has closed: the winner carries a checkpoint, so the first\n503|// checkpoint is published and a new bootstrap operation is a\n504|// legitimate post-window binding, not an in-window mismatch. The\n505|// predicate reads only the winner's own HasCheckpoint; a caller\n506|// claim never closes the window.\n507|func bootstrapWindowClosed(observation fencing.Observation) bool {\n508|\treturn observation.HasWinner && observation.Winner.HasCheckpoint\n509|}\n510|\n511|// authorize selects the fencing entry by mode: activation for a\n512|// fresh launch, restore for the after-restore first start. Both are\n513|// launch-class entries: ownership that is remote, ambiguous,\n514|// unverified, or absent parks with the session.parked vocabulary,\n515|// while malformed calls, foreign sessions, and lapsed grants refuse.\n516|func authorize(input Input) (fencing.LeaseToken, error) {\n517|\tif input.Mode == ModeRestore {\n518|\t\treturn fencing.AuthorizeRestore(input.Presented, input.Observation)\n519|\t}\n520|\treturn fencing.AuthorizeActivation(input.Presented, input.Observation)\n521|}\n522|\n523|// admitBackend parses the §4.B identity documents through the\n524|// terminalbackend owner, reconciles the Probe against the Manifest\n525|// with the returned evidence bound to the AX-known raw generation,\n526|// and gates the mode operation against the admitted set. Only the\n527|// exact admitted capability rows authorize the action; no\n528|// capability map is invented here. The parsed evidence is returned\n529|// alongside the admitted set so the realm arm can bind the\n530|// credential-realm row to the host binding and probed build\n531|// without re-parsing.\n532|func admitBackend(input Input) (terminalbackend.Admitted, []terminalbackend.Evidence, error) {\n533|\tmanifest, err := terminalbackend.ParseManifest(input.Backend.Manifest)\n534|\tif err != nil {\n535|\t\treturn terminalbackend.Admitted{}, nil, err\n536|\t}\n537|\tprobe, err := terminalbackend.ParseProbe(input.Backend.Probe)\n538|\tif err != nil {\n539|\t\treturn terminalbackend.Admitted{}, nil, err\n540|\t}\n541|\tevidence := make([]terminalbackend.Evidence, 0, len(input.Backend.Evidence))\n542|\tfor _, doc := range input.Backend.Evidence {\n543|\t\tparsed, err := terminalbackend.ParseEvidence(doc)\n544|\t\tif err != nil {\n545|\t\t\treturn terminalbackend.Admitted{}, nil, err\n546|\t\t}\n547|\t\tevidence = append(evidence, parsed)\n548|\t}\n549|\tadmitted, err := terminalbackend.Reconcile(manifest, probe, evidence, input.Backend.RawGeneration, input.Backend.Now, input.Backend.Verify)\n550|\tif err != nil {\n551|\t\treturn terminalbackend.Admitted{}, nil, err\n552|\t}\n553|\toperation := \"create\"\n554|\tif input.Mode == ModeRestore {\n555|\t\toperation = \"restore\"\n556|\t}\n557|\tif err := terminalbackend.CheckOperation(operation, admitted); err != nil {\n558|\t\treturn terminalbackend.Admitted{}, nil, err\n559|\t}\n560|\treturn admitted, evidence, nil\n561|}\n562|\n563|// checkMaterialization enforces after-restore step 3: the required\n564|// journal must be admitted by the matjournal owner, committed, and\n565|// sourced from the winning lease's checkpoint. A committed journal\n566|// one generation behind the lease checkpoint is stale, never valid.\n567|func checkMaterialization(input Input) error {\n568|\tif !input.JournalOK || input.Journal.Phase != matjournal.PhaseCommitted {\n569|\t\treturn errMaterializationNotValid(input.Journal.Phase, input.JournalOK)\n570|\t}\n571|\tif input.Observation.HasWinner && input.Observation.Winner.HasCheckpoint {\n572|\t\tif input.Journal.SourceCheckpointID != input.Observation.Winner.Checkpoint {\n573|\t\t\treturn errMaterializationStale()\n574|\t\t}\n575|\t}\n576|\treturn nil\n577|}\n578|\n579|// admitCheckpoint admits exactly the winning lease's checkpoint for\n580|// resume (§13.11 step 5: validate the newest checkpoint). The closed\n581|// shape must attest through the sessrepo owner, the computed\n582|// identity must equal the required digest, the required digest must\n583|// equal the winner's checkpoint when the winner carries one, and the\n584|// checkpoint's own session_id must name this session. It returns the\n585|// checkpoint's event-head closure for the profile derivation.\n586|func admitCheckpoint(input Input) ([]string, error) {\n587|\tdoc := input.CheckpointDoc\n588|\twant := input.CheckpointID\n589|\tif len(doc) == 0 {\n590|\t\treturn nil, errCheckpointAbsent()\n591|\t}\n592|\tdigest, _, err := sessrepo.AttestCheckpointRecord(doc)\n593|\tif err != nil {\n594|\t\treturn nil, err\n595|\t}\n596|\tif digest.String() != want {\n597|\t\treturn nil, errCheckpointMismatch()\n598|\t}\n599|\tif input.Observation.HasWinner && input.Observation.Winner.HasCheckpoint {\n600|\t\tif want != input.Observation.Winner.Checkpoint {\n601|\t\t\treturn nil, errCheckpointNotLease()\n602|\t\t}\n603|\t}\n604|\tsessionID, _, _, heads, err := decodeCheckpointMembers(doc)\n605|\tif err != nil {\n606|\t\treturn nil, err\n607|\t}\n608|\tif sessionID != input.SessionID {\n609|\t\treturn nil, errCheckpointForeign()\n610|\t}\n611|\treturn heads, nil\n612|}\n613|\n614|// decodeCheckpointMembers reads the bound members from checkpoint\n615|// bytes the sessrepo owner already attested: the subject session,\n616|// the owning lease, and the event-head closure. It mirrors the\n617|// sessquery extraction after AttestCheckpointRecord: shape and\n618|// identity are the owner's, this is only the member read.\n619|func decodeCheckpointMembers(doc []byte) (sessionID string, leaseEpoch uint64, leaseID string, heads []string, err error) {\n620|\tmembers, fault := environ.DecodeStrictObject(doc)\n621|\tif fault != nil {\n622|\t\treturn \"\", 0, \"\", nil, errCheckpointMembers()\n623|\t}\n624|\tsession, ok := environ.CheckUUIDv7(members[\"session_id\"])\n625|\tif !ok {\n626|\t\treturn \"\", 0, \"\", nil, errCheckpointMembers()\n627|\t}\n628|\tsessionID = session.String()\n629|\trawEpoch, ok := members[\"lease_epoch\"]\n630|\tif !ok {\n631|\t\treturn \"\", 0, \"\", nil, errCheckpointMembers()\n632|\t}\n633|\tvar epochFloat float64\n634|\tif err := json.Unmarshal(rawEpoch, &epochFloat); err != nil || epochFloat < 1 {\n635|\t\treturn \"\", 0, \"\", nil, errCheckpointMembers()\n636|\t}\n637|\tleaseEpoch = uint64(epochFloat)\n638|\tvar lease string\n639|\tif rawLease, ok := members[\"lease_id\"]; ok {\n640|\t\t_ = json.Unmarshal(rawLease, &lease)\n641|\t}\n642|\tif _, err := scalar.ParseUUIDv4(lease); err != nil {\n643|\t\treturn \"\", 0, \"\", nil, errCheckpointMembers()\n644|\t}\n645|\tleaseID = lease\n646|\trawHeads, ok := members[\"event_heads\"]\n647|\tif !ok {\n648|\t\treturn \"\", 0, \"\", nil, errCheckpointMembers()\n649|\t}\n650|\tvar values []string\n651|\tif err := json.Unmarshal(rawHeads, &values); err != nil {\n652|\t\treturn \"\", 0, \"\", nil, errCheckpointMembers()\n653|\t}\n654|\tfor _, value := range values {\n655|\t\thead, err := scalar.ParseDigest(value)\n656|\t\tif err != nil {\n657|\t\t\treturn \"\", 0, \"\", nil, errCheckpointMembers()\n658|\t\t}\n659|\t\theads = append(heads, head.String())\n660|\t}\n661|\treturn sessionID, leaseEpoch, leaseID, heads, nil\n662|}\n663|\n664|// checkpointHeads extracts the event-head closure from checkpoint\n665|// bytes for the profile derivation. It attests through the sessrepo\n666|// owner first; unattested bytes never supply a closure.\n667|func checkpointHeads(doc []byte) ([]string, error) {\n668|\tif len(doc) == 0 {\n669|\t\treturn nil, errCheckpointAbsent()\n670|\t}\n671|\tif _, _, err := sessrepo.AttestCheckpointRecord(doc); err != nil {\n672|\t\treturn nil, err\n673|\t}\n674|\t_, _, _, heads, err := decodeCheckpointMembers(doc)\n675|\treturn heads, err\n676|}\n677|\n678|// deriveProfile derives the effective persisted pair: from the\n679|// validated checkpoint's event-head closure on resume (§13.10),\n680|// from the session head otherwise. The closure heads arrive from\n681|// the winner's checkpoint through Run, or from the required\n682|// checkpoint's own closure when the winner's heads are not\n683|// supplied; a head-only or losing-lease change outside the closure\n684|// never becomes the launch profile.\n685|func deriveProfile(input Input) (sessprofile.Pair, error) {\n686|\theads := input.ProfileHeads\n687|\tif len(heads) == 0 && input.CheckpointRequired && len(input.CheckpointDoc) > 0 {\n688|\t\tclosure, err := checkpointHeads(input.CheckpointDoc)\n689|\t\tif err != nil {\n690|\t\t\treturn sessprofile.Pair{}, err\n691|\t\t}\n692|\t\theads = closure\n693|\t}\n694|\tif len(heads) > 0 {\n695|\t\treturn sessprofile.DeriveForHeads(input.ProfileRecord, input.ProfileEvents, heads)\n696|\t}\n697|\treturn sessprofile.Derive(input.ProfileRecord, input.ProfileEvents)\n698|}\n699|\n700|// checkProviderIdentity composes the provhost resume gate: the exact\n701|// probed build tuple must pass the Section 8.4 direction, the stored\n702|// identity must validate for that provider at that exact version,\n703|// and the discovery proof, when present, must bind to the host-side\n704|// facts.\n705|func checkProviderIdentity(facts ProviderFacts) error {\n706|\tif err := provhost.CheckResumeTuple(facts.Build); err != nil {\n707|\t\treturn err\n708|\t}\n709|\tif err := provhost.VerifyIdentityBuild(facts.Identity, facts.Build); err != nil {\n710|\t\treturn err\n711|\t}\n712|\tif facts.HasDiscovery {\n713|\t\tif err := provhost.VerifyIdentityDiscovery(facts.Identity, facts.Discovery, facts.DiscoveryContext); err != nil {\n714|\t\t\treturn err\n715|\t\t}\n716|\t}\n717|\treturn nil\n718|}\n719|\n720|// checkSmoke enforces the provider-auth smoke precondition when the\n721|// path requires provider credentials. The stored record must verify\n722|// through the resumesmoke owner, its verdict must be pass, its exact\n723|// claimed build must equal the probed build, and the typed target\n724|// must bind the same build with the current generation and the\n725|// probed OS version: a smoke result for one build, generation, or\n726|// OS version never authorizes another. A required smoke that is\n727|// absent, unverifiable, failing, or bound to another\n728|// build/generation/version refuses target_auth_missing with the\n729|// typed details Section 15.3 names.\n730|func checkSmoke(input Input) error {\n731|\tif !input.Smoke.Required {\n732|\t\treturn nil\n733|\t}\n734|\trecord, err := resumesmoke.VerifyRecord(input.Smoke.Record)\n735|\tif err != nil {\n736|\t\treturn smokeFailure(input, err)\n737|\t}\n738|\tif record.Verdict != resumesmoke.VerdictPass {\n739|\t\treturn smokeFailure(input, errSmokeVerdict(record.Verdict))\n740|\t}\n741|\tbuild := input.Provider.Build\n742|\tif record.Tuple.ProviderID != build.ProviderID ||\n743|\t\trecord.Tuple.ProviderVersion != build.ProviderVersion ||\n744|\t\trecord.Tuple.Platform != build.Platform ||\n745|\t\trecord.Tuple.Architecture != build.Architecture {\n746|\t\treturn smokeFailure(input, errSmokeTuple())\n747|\t}\n748|\ttarget := input.Smoke.Target\n749|\tif target.ProviderID != build.ProviderID || target.ProviderBuild != build.ProviderVersion {\n750|\t\treturn smokeFailure(input, errSmokeTargetBuild())\n751|\t}\n752|\tif target.TmuxServerGeneration != input.Backend.RawGeneration {\n753|\t\treturn smokeFailure(input, errSmokeTargetGeneration())\n754|\t}\n755|\tprobe, err := terminalbackend.ParseProbe(input.Backend.Probe)\n756|\tif err != nil {\n757|\t\treturn smokeFailure(input, err)\n758|\t}\n759|\tif target.MacOSVersion != probe.OSVersion {\n760|\t\treturn smokeFailure(input, errSmokeTargetOS())\n761|\t}\n762|\treturn nil\n763|}\n764|\n765|// smokeFailure composes the typed target_auth_missing refusal. Typed\n766|// details are required members of the input: an input that omits\n767|// one is itself malformed and refuses invalid_arguments instead of\n768|// emitting an untyped refusal.\n769|func smokeFailure(input Input, cause error) error {\n770|\tfailure, err := axerror.NewTargetAuthMissing(axerror.Version130,\n771|\t\t\"provider-auth smoke did not pass for the probed build\",\n772|\t\taxerror.NoIDs(), input.Smoke.Target, cause)\n773|\tif err != nil {\n774|\t\treturn fmt.Errorf(\"%w: smoke refusal details are incomplete: %v\", errInvalidArguments{}, err)\n775|\t}\n776|\treturn failure\n777|}\n778|\n779|// checkRealm enforces the §4.2 background-caller rule: a background\n780|// caller authorizes only through the admitted\n781|// credential_capable_execution_realm Capability Evidence row bound\n782|// to the exact host binding, the probed provider build, and the\n783|// current generation, admitted through the landed terminalbackend\n784|// reconcile path. It never falls back to direct server creation,\n785|// and no cached sentinel, managername observation, or bare boolean\n786|// authorizes resume. A foreground caller passes. Expiry, logout,\n787|// and reboot invalidation are the reconcile liveness and generation\n788|// binding the admission already enforces; a stale generation in the\n789|// typed details refuses as well. Typed details are required input\n790|// members: an input that omits one is itself malformed and refuses\n791|// invalid_arguments instead of emitting an untyped\n792|// capability_unavailable.\n793|func checkRealm(input Input, admitted terminalbackend.Admitted, evidence []terminalbackend.Evidence) error {\n794|\tif input.Realm.Caller != CallerBackground {\n795|\t\treturn nil\n796|\t}\n797|\tif !admitted.Has(credentialRealmCapability) {\n798|\t\treturn realmFailure(input, errNoRealmEvidence())\n799|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
