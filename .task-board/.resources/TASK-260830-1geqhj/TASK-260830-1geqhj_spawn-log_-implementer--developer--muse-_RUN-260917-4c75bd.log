{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cddd","stream":{"kind":"session","id":"01a0b131-d4f6-7b82-a7a6-5363cf3ac7fb"},"sequence":1353,"recorded_at":1780531400002701,"record_type":"event","durability":"durable","causation_id":"2237b1e3-856b-4a22-9f46-61adba667efd","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"2237b1e3-856b-4a22-9f46-61adba667efd","run_stream":{"kind":"run","id":"2237b1e3-856b-4a22-9f46-61adba667efd"},"call_id":"call_01a0b137e06e71f0b9f8f912e6c344ec","text":"Read text file `internal/axpane/rework_test.go`.\n(339 line(s) above)\n340|\troot := t.TempDir()\n341|\trepository, err := sessrepo.Open(root)\n342|\tif err != nil {\n343|\t\tt.Fatal(err)\n344|\t}\n345|\tvar record map[string]any\n346|\tif err := json.Unmarshal([]byte(sessionRecordFixture), &record); err != nil {\n347|\t\tt.Fatal(err)\n348|\t}\n349|\treference, err := repository.CreateSession(identifyObject(t, record, \"record_id\"))\n350|\tif err != nil {\n351|\t\tt.Fatal(err)\n352|\t}\n353|\tif _, err := repository.CreateLease(fixtureSession, sessrepo.CreateLeaseInput{LeaseID: fixtureLeaseA, HolderHostID: fixtureLocalHost, IssuedByHostID: fixtureLocalHost, CreatedAt: fixtureCreatedAt}); err != nil {\n354|\t\tt.Fatal(err)\n355|\t}\n356|\tappendChainEvent(t, repository, \"session.created\", 1, fixtureLeaseA, 1, reference.RecordID, map[string]any{\n357|\t\t\"session_record_id\": reference.RecordID, \"bootstrap_operation_id\": fixtureBootstrap, \"first_checkpoint_operation_id\": fixtureOtherOp,\n358|\t})\n359|\tworld.repo = repository\n360|\tmatches, _ := filepath.Glob(filepath.Join(root, \"sessions\", fixtureSession, \"leases\", \"*\"))\n361|\tif len(matches) == 0 {\n362|\t\tt.Fatal(\"no lease blobs to tear\")\n363|\t}\n364|\tfor _, match := range matches {\n365|\t\tif err := os.WriteFile(match, []byte(\"{torn\"), 0o600); err != nil {\n366|\t\t\tt.Fatal(err)\n367|\t\t}\n368|\t}\n369|\toutcome, err := Run(world.stores(), runRequest(t, world))\n370|\tif err == nil {\n371|\t\tt.Fatalf(\"Run() over torn lease succeeded with %+v, want the read error\", outcome.Decision)\n372|\t}\n373|\tif outcome.Decision.Action != \"\" {\n374|\t\tt.Fatalf(\"Run() over torn lease decides %q, want no decision\", outcome.Decision.Action)\n375|\t}\n376|}\n377|\n378|// TestRunParkedUnfoldableSkipsEmission pins P1-1 (probe 2): a verified\n379|// local park from a creating chain parks without authoring the\n380|// unfolderable session.parked event. On rev1 this authored creating\n381|// -> parked, which sessstate refuses.\n382|func TestRunParkedUnfoldableSkipsEmission(t *testing.T) {\n383|\tt.Parallel()\n384|\tworld := buildRunWorld(t)\n385|\trequest := runRequest(t, world)\n386|\trequest.Mode = ModeRestore\n387|\trequest.MaterializationRequired = true\n388|\trequest.MaterializationID = \"0198f4c8-9a10-7b22-8b3c-1234567890ff\"\n389|\trequest.CheckpointRequired = true\n390|\trequest.CheckpointID = world.ckptID\n391|\tbefore := eventCount(t, world.repo)\n392|\toutcome, err := Run(world.stores(), request)\n393|\tif err != nil {\n394|\t\tt.Fatalf(\"Run() error = %v\", err)\n395|\t}\n396|\tif outcome.Decision.Action != ActionParked {\n397|\t\tt.Fatalf(\"Run() action = %q, want parked\", outcome.Decision.Action)\n398|\t}\n399|\tif outcome.Emitted {\n400|\t\tt.Fatal(\"Run() authored session.parked from creating, want no emission\")\n401|\t}\n402|\tif after := eventCount(t, world.repo); after != before {\n403|\t\tt.Fatalf(\"event count = %d, want %d (no unfolderable emission)\", after, before)\n404|\t}\n405|\t// The chain without the parked event still folds; with it, the\n406|\t// landed reducer refuses (the rev1 collision).\n407|\trecordJSON, err := world.repo.GetRecord(fixtureSession)\n408|\tif err != nil {\n409|\t\tt.Fatal(err)\n410|\t}\n411|\trecord, err := sessstate.DecodeRecord(recordJSON)\n412|\tif err != nil {\n413|\t\tt.Fatal(err)\n414|\t}\n415|\tsummaries, err := world.repo.ListEvents(fixtureSession)\n416|\tif err != nil {\n417|\t\tt.Fatal(err)\n418|\t}\n419|\tvar events []sessstate.Event\n420|\tfor _, summary := range summaries {\n421|\t\traw, err := world.repo.GetEvent(fixtureSession, summary.EventID)\n422|\t\tif err != nil {\n423|\t\t\tt.Fatal(err)\n424|\t\t}\n425|\t\tevent, err := sessstate.DecodeEvent(raw)\n426|\t\tif err != nil {\n427|\t\t\tt.Fatal(err)\n428|\t\t}\n429|\t\tevents = append(events, event)\n430|\t}\n431|\tif _, err := sessstate.Reduce(sessstate.Input{Record: record, Events: events, LocalHostID: fixtureLocalHost}); err != nil {\n432|\t\tt.Fatalf(\"sessstate.Reduce over parked-without-emission chain error = %v\", err)\n433|\t}\n434|}\n435|\n436|// TestEmitUnderLosingLeaseRefuses pins P1-1 (probe 9): Emit under a\n437|// losing lease refuses through AuthorizeMutation, never appends. On\n438|// rev1 (no mutation gate) this appended.\n439|func TestEmitUnderLosingLeaseRefuses(t *testing.T) {\n440|\tt.Parallel()\n441|\tworld := buildRunWorld(t)\n442|\tleases, err := world.repo.ListLeases(fixtureSession)\n443|\tif err != nil {\n444|\t\tt.Fatal(err)\n445|\t}\n446|\tif _, err := world.repo.CompareAndSwapLease(fixtureSession, sessrepo.LeaseExpectation{RecordID: leases[0].RecordID}, sessrepo.SuccessorLeaseInput{\n447|\t\tCreateLeaseInput: sessrepo.CreateLeaseInput{LeaseID: fixtureLeaseB, HolderHostID: fixtureRemoteHost, IssuedByHostID: fixtureRemoteHost, CreatedAt: fixtureCreatedAt},\n448|\t\tReason:           \"graceful_takeover\",\n449|\t\tCheckpointID:     seedDigest(0xC9),\n450|\t}); err != nil {\n451|\t\tt.Fatal(err)\n452|\t}\n453|\tobservation := fixtureObservation(fixtureNow())\n454|\tobservation.Winner = sessrepo.LeaseSummary{SessionID: fixtureSession, LeaseID: fixtureLeaseB, Epoch: 2, HolderHostID: fixtureRemoteHost, Reason: \"graceful_takeover\"}\n455|\tdecision := Decision{Action: ActionParked, ParkReason: fencing.ParkStaleOwner, WinningLeaseID: fixtureLeaseB}\n456|\tif _, _, err := EmitParked(world.repo, decision, EmitParams{\n457|\t\tSessionID: fixtur