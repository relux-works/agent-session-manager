{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d359","stream":{"kind":"session","id":"01a0b131-d4f6-7b82-a7a6-5363cf3ac7fb"},"sequence":2055,"recorded_at":1780531400004105,"record_type":"event","durability":"durable","causation_id":"2237b1e3-856b-4a22-9f46-61adba667efd","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2237b1e3-856b-4a22-9f46-61adba667efd","run_stream":{"kind":"run","id":"2237b1e3-856b-4a22-9f46-61adba667efd"},"task_stream":{"kind":"task","id":"01a0b13c-550e-7323-864f-342a1ea4b3ab"},"task_id":"01a0b13c-550e-7323-864f-342a1ea4b3ab","event":{"kind":"output","task_id":"01a0b13c-550e-7323-864f-342a1ea4b3ab","chunk":"edited\nchanged lines: lines 612-661\n--- original\n+++ updated\n@@\n-// checkMaterialization enforces after-restore step 3: the required\n-// journal must be admitted by the matjournal owner, committed, and\n-// sourced from the winning lease's checkpoint. A committed journal\n-// one generation behind the lease checkpoint is stale, never valid.\n-func checkMaterialization(input Input) error {\n-\tif !input.JournalOK || input.Journal.Phase != matjournal.PhaseCommitted {\n-\t\treturn errMaterializationNotValid(input.Journal.Phase, input.JournalOK)\n-\t}\n-\tif input.Observation.HasWinner && input.Observation.Winner.HasCheckpoint {\n-\t\tif input.Journal.SourceCheckpointID != input.Observation.Winner.Checkpoint {\n-\t\t\treturn errMaterializationStale()\n-\t\t}\n-\t}\n-\treturn nil\n-}\n-\n-// admitCheckpoint admits exactly the winning lease's checkpoint for\n-// resume (§13.11 step 5: validate the newest checkpoint). The closed\n-// shape must attest through the sessrepo owner, the computed\n-// identity must equal the required digest, the required digest must\n-// equal the winner's checkpoint when the winner carries one, and the\n-// checkpoint's own session_id must name this session. It returns the\n-// checkpoint's event-head closure for the profile derivation.\n-func admitCheckpoint(input Input) ([]string, error) {\n-\tdoc := input.CheckpointDoc\n-\twant := input.CheckpointID\n-\tif len(doc) == 0 {\n-\t\treturn nil, errCheckpointAbsent()\n-\t}\n-\tdigest, _, err := sessrepo.AttestCheckpointRecord(doc)\n-\tif err != nil {\n-\t\treturn nil, err\n-\t}\n-\tif digest.String() != want {\n-\t\treturn nil, errCheckpointMismatch()\n-\t}\n-\tif input.Observation.HasWinner && input.Observation.Winner.HasCheckpoint {\n-\t\tif want != input.Observation.Winner.Checkpoint {\n-\t\t\treturn nil, errCheckpointNotLease()\n-\t\t}\n-\t}\n-\tsessionID, _, _, heads, err := decodeCheckpointMembers(doc)\n-\tif err != nil {\n-\t\treturn nil, err\n-\t}\n-\tif sessionID != input.SessionID {\n-\t\treturn nil, errCheckpointForeign()\n-\t}\n-\treturn heads, nil\n-}\n+// checkMaterialization enforces after-restore step 3: the required\n+// journal must be admitted by the matjournal owner, committed, and\n+// sourced from the fold's newest published checkpoint, with the\n+// winning lease's handoff base agreeing when the winner carries\n+// one. A committed journal one generation behind the newest\n+// checkpoint is stale, never valid; with no published checkpoint\n+// the requirement parks, never launches.\n+func checkMaterialization(input Input) error {\n+\tif !input.JournalOK || input.Journal.Phase != matjournal.PhaseCommitted {\n+\t\treturn errMaterializationNotValid(input.Journal.Phase, input.JournalOK)\n+\t}\n+\tif !input.HasNewestCheckpoint {\n+\t\treturn errMaterializationNoCheckpoint()\n+\t}\n+\tif input.Journal.SourceCheckpointID != input.NewestCheckpointID {\n+\t\treturn errMaterializationStale()\n+\t}\n+\tif !leaseCheckpointAgrees(input) {\n+\t\treturn errMaterializationLeaseDisagree()\n+\t}\n+\treturn nil\n+}\n+\n+// admitCheckpoint admits exactly the fold's newest published\n+// checkpoint for resume (§13.11 step 5: validate the newest\n+// checkpoint). The closed shape must attest through the sessrepo\n+// owner, the computed identity must equal the required digest, the\n+// required digest must equal the newest published checkpoint, a\n+// winning lease that carries a checkpoint must agree with it (the\n+// successor handoff base), and the checkpoint's own session_id\n+// must name this session. With no published checkpoint the\n+// requirement parks: an unpublished checkpoint is never admitted.\n+// It returns the checkpoint's event-head closure for the profile\n+// derivation.\n+func admitCheckpoint(input Input) ([]string, error) {\n+\tdoc := input.CheckpointDoc\n+\twant := input.CheckpointID\n+\tif len(doc) == 0 {\n+\t\treturn nil, errCheckpointAbsent()\n+\t}\n+\tdigest, _, err := sessrepo.AttestCheckpointRecord(doc)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\tif digest.String() != want {\n+\t\treturn nil, errCheckpointMismatch()\n+\t}\n+\tif !input.HasNewestCheckpoint {\n+\t\treturn nil, errCheckpointNoPublished()\n+\t}\n+\tif want != input.NewestCheckpointID {\n+\t\treturn nil, errCheckpointNotNewest()\n+\t}\n+\tif !leaseCheckpointAgrees(input) {\n+\t\treturn nil, errCheckpointLeaseDisagree()\n+\t}\n+\tsessionID, _, _, heads, err := decodeCheckpointMembers(doc)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\tif sessionID != input.SessionID {\n+\t\treturn nil, errCheckpointForeign()\n+\t}\n+\treturn heads, nil\n+}\n+\n+// leaseCheckpointAgrees asserts the winning lease's checkpoint\n+// against the chain fold's newest: a successor lease's Checkpoint\n+// is the handoff base and must agree with the published newest.\n+// The fold stays the authority — this asserts agreement, it never\n+// selects one fact and ignores the other. A winner that carries\n+// no checkpoint (every epoch-1 owner) trivially agrees; callers\n+// park on a null fold before consulting this.\n+func leaseCheckpointAgrees(input Input) bool {\n+\tif !input.Observation.HasWinner || !input.Observation.Winner.HasCheckpoint {\n+\t\treturn true\n+\t}\n+\tif !input.HasNewestCheckpoint {\n+\t\treturn false\n+\t}\n+\treturn input.Observation.Winner.Checkpoint == input.NewestCheckpointID\n+}\n","final_result":true}}}
