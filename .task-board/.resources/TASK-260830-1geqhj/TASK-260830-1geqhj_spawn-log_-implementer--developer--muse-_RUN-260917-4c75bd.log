{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d0fd","stream":{"kind":"session","id":"01a0b131-d4f6-7b82-a7a6-5363cf3ac7fb"},"sequence":1753,"recorded_at":1780531400003501,"record_type":"event","durability":"durable","causation_id":"2237b1e3-856b-4a22-9f46-61adba667efd","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"2237b1e3-856b-4a22-9f46-61adba667efd","run_stream":{"kind":"run","id":"2237b1e3-856b-4a22-9f46-61adba667efd"},"task_stream":{"kind":"task","id":"01a0b139-7831-7593-9fb5-600c66c2a268"},"task_id":"01a0b139-7831-7593-9fb5-600c66c2a268","event":{"kind":"output","task_id":"01a0b139-7831-7593-9fb5-600c66c2a268","chunk":"Read text file `internal/axpane/decide_test.go`.\n(779 line(s) above)\n780|\t\t\t\t\tt.Fatal(\"Decide() offer mints a fencing token\")\n781|\t\t\t\t}\n782|\t\t\tcase ActionLaunch, ActionReattach:\n783|\t\t\t\tif !decision.HasToken {\n784|\t\t\t\t\tt.Fatal(\"Decide() launch-path outcome carries no fencing token\")\n785|\t\t\t\t}\n786|\t\t\t}\n787|\t\t})\n788|\t}\n789|}\n790|\n791|func smokeTarget() axerror.TargetAuth {\n792|\treturn axerror.TargetAuth{\n793|\t\tProviderID:           \"codex\",\n794|\t\tProviderBuild:        \"0.147.0\",\n795|\t\tMacOSVersion:         \"14.5\",\n796|\t\tTmuxServerGeneration: \"generation-alpha\",\n797|\t\tRemediation:          \"rerun provider-auth smoke\",\n798|\t}\n799|}\n800|\n801|// TestDecideAfterRestoreSequence pins the §4.2 after-restore steps\n802|// 1-5 as a scenario table over the restore mode: read the local\n803|// lease, attempt the bounded mesh refresh, resume locally only with\n804|// the winning lease and a valid required materialization, offer\n805|// remote attach/takeover for a remote interactive owner, and park\n806|// in all other cases.\n807|func TestDecideAfterRestoreSequence(t *testing.T) {\n808|\tt.Parallel()\n809|\tt.Run(\"step3_resume_winning_lease_valid_materialization\", func(t *testing.T) {\n810|\t\tt.Parallel()\n811|\t\tdeps := buildDecideDeps(t, true)\n812|\t\tinput := validInput(t, deps)\n813|\t\tinput.Mode = ModeRestore\n814|\t\tinput.MaterializationRequired = true\n815|\t\tinput.Journal = matjournal.Journal{Phase: matjournal.PhaseCommitted}\n816|\t\tinput.JournalOK = true\n817|\t\tinput.CheckpointRequired = true\n818|\t\tinput.CheckpointDoc = deps.ckptDoc\n819|\t\tinput.CheckpointID = deps.ckptID\n820|\t\tdecision := Decide(input)\n821|\t\tif decision.Action != ActionLaunch {\n822|\t\t\tt.Fatalf(\"after-restore step 3 action = %q, cause %v, want launch\", decision.Action, decision.Cause)\n823|\t\t}\n824|\t})\n825|\tt.Run(\"step3_materializing_parks\", func(t *testing.T) {\n826|\t\tt.Parallel()\n827|\t\tdeps := buildDecideDeps(t, true)\n828|\t\tinput := validInput(t, deps)\n829|\t\tinput.Mode = ModeRestore\n830|\t\tinput.MaterializationRequired = true\n831|\t\tinput.Journal = matjournal.Journal{Phase: matjournal.PhaseValidating}\n832|\t\tinput.JournalOK = true\n833|\t\tdecision := Decide(input)\n834|\t\tif decision.Action != ActionParked || decision.ParkReason != fencing.ParkRestorePolicy {\n835|\t\t\tt.Fatalf(\"after-restore materializing action = %q (%q), want parked (restore_policy)\", decision.Action, decision.ParkReason)\n836|\t\t}\n837|\t})\n838|\tt.Run(\"step4_remote_interactive_attach\", func(t *testing.T) {\n839|\t\tt.Parallel()\n840|\t\tdeps := buildDecideDeps(t, true)\n841|\t\tinput := validInput(t, deps)\n842|\t\tinput.Mode = ModeRestore\n843|\t\tinput.Observation.Winner.HolderHostID = fixtureRemoteHost\n844|\t\tinput.RemoteInteractive = true\n845|\t\tdecision := Decide(input)\n846|\t\tif decision.Action != ActionAttachRemote {\n847|\t\t\tt.Fatalf(\"after-restore step 4 action = %q, want attach_remote\", decision.Action)\n848|\t\t}\n849|\t})\n850|\tt.Run(\"step4_remote_noninteractive_takeover\", func(t *testing.T) {\n851|\t\tt.Parallel()\n852|\t\tdeps := buildDecideDeps(t, true)\n853|\t\tinput := validInput(t, deps)\n854|\t\tinput.Mode = ModeRestore\n855|\t\tinput.Observation.Winner.HolderHostID = fixtureRemoteHost\n856|\t\tinput.RemoteInteractive = false\n857|\t\tdecision := Decide(input)\n858|\t\tif decision.Action != ActionParked || decision.ParkReason != fencing.ParkRemoteOwner {\n859|\t\t\tt.Fatalf(\"after-restore step 5 action = %q (%q), want parked (remote_owner)\", decision.Action, decision.ParkReason)\n860|\t\t}\n861|\t})\n862|\tt.Run(\"step5_unverified_parks\", func(t *testing.T) {\n863|\t\tt.Parallel()\n864|\t\tdeps := buildDecideDeps(t, true)\n865|\t\tinput := validInput(t, deps)\n866|\t\tinput.Mode = ModeRestore\n867|\t\tinput.Observation.Verified = false\n868|\t\tdecision := Decide(input)\n869|\t\tif decision.Action != ActionParked || decision.ParkReason != fencing.ParkRestorePolicy {\n870|\t\t\tt.Fatalf(\"after-restore step 5 action = %q (%q), want parked (restore_policy)\", decision.Action, decision.ParkReason)\n871|\t\t}\n872|\t})\n873|\tt.Run(\"step1_no_local_lease_parks_without_winner\", func(t *testing.T) {\n874|\t\tt.Parallel()\n875|\t\tdeps := buildDecideDeps(t, true)\n876|\t\tinput := validInput(t, deps)\n877|\t\tinput.Mode = ModeRestore\n878|\t\tinput.Observation.HasWinner = false\n879|\t\tinput.Observation.Winner = sessrepo.LeaseSummary{}\n880|\t\tdecision := Decide(input)\n881|\t\tif decision.Action != ActionParked || decision.WinningLeaseID != \"\" {\n882|\t\t\tt.Fatalf(\"after-restore step 1 action = %q (%q), want parked with no winner\", decision.Action, decision.WinningLeaseID)\n883|\t\t}\n884|\t})\n885|}\n886|\n887|// TestDecideTypedRefusals pins the Structured Error composition of\n888|// the two typed refusals: capability_unavailable carries the §15.3\n889|// realm/readiness details and target_auth_missing the target-auth\n890|// details.\n891|func TestDecideTypedRefusals(t *testing.T) {\n892|\tt.Parallel()\n893|\tt.Run(\"capability_unavailable_details\", func(t *testing.T) {\n894|\t\tt.Parallel()\n895|\t\tdeps := buildDecideDeps(t, true)\n896|\t\tinput := validInput(t, deps)\n897|\t\tinput.Realm.Caller = CallerBackground\n898|\t\tdecision := Decide(input)\n899|\t\tif decision.Action != ActionRefused || decision.Class != \"capability_unavailable\" {\n900|\t\t\tt.Fatalf(\"Decide() = (%q, %q), want (refused, capability_unavailable)\", decision.Action, decision.Class)\n901|\t\t}\n902|\t\tif decision.RealmFailure == nil {\n903|\t\t\tt.Fatal(\"Decide() capability_unavailable carries no typed failure\")\n904|\t\t}\n905|\t\tif got := string(decision.RealmFailure.Code()); got != \"capability_unavailable\" {\n906|\t\t\tt.Fatalf(\"RealmFailure code = %q\", got)\n907|\t\t}\n908|\t})\n909|\tt.Run(\"target_auth_missing_details\", func(t *testing.T) {\n910|\t\tt.Parallel()\n911|\t\tdeps := buildDecideDeps(t, true)\n912|\t\tinput := validInput(t, deps)\n913|\t\tinput.Smoke.Required = true\n914|\t\tinput.Smoke.Target = smokeTarget()\n915|\t\tdecision := Decide(input)\n916|\t\tif decision.Action != ActionRefused || decision.Class != \"target_auth_missing\" {\n917|\t\t\tt.Fatalf(\"Decide() = (%q, %q), want (refused, target_auth_missing)\", decision.Action, decision.Class)\n918|\t\t}\n919|\t\tif decision.RealmFailure == nil {\n920|\t\t\tt.Fatal(\"Decide() target_auth_missing carries no typed failure\")\n921|\t\t}\n922|\t})\n923|}\n924|\n925|// TestRealmCarriesNoCachedEvidence pins the §4.2 cached-evidence\n926|// rule behaviorally: no cached sentinel result, managername\n927|// observation, or bare boolean authorizes resume. A background\n928|// caller with a passing smoke record but no admitted realm row\n929|// refuses; a background caller with a passing smoke record and an\n930|// admitted realm row bound to a stale generation refuses; only the\n931|// admitted row bound to the current generation, host binding, and\n932|// probed build launches.\n933|func TestRealmCarriesNoCachedEvidence(t *testing.T) {\n934|\tt.Parallel()\n935|\tt.Run(\"cached_smoke_without_realm_refuses\", func(t *testing.T) {\n936|\t\tt.Parallel()\n937|\t\tdeps := buildDecideDeps(t, true)\n938|\t\tinput := validInput(t, deps)\n939|\t\tinput.Realm.Caller = CallerBackground\n940|\t\tinput.Smoke.Required = true\n941|\t\tinput.Smoke.Record = smokeRecord(t, \"pass\", \"A\", passingSmokeChecks(), smokeTuple())\n942|\t\tinput.Smoke.Target = smokeTarget()\n943|\t\tdecision := Decide(input)\n944|\t\tif decision.Action != ActionRefused || decision.Class != \"capability_unavailable\" {\n945|\t\t\tt.Fatalf(\"Decide() = (%q, %q), want refused capability_unavailable for cached smoke without realm\", decision.Action, decision.Class)\n946|\t\t}\n947|\t})\n948|\tt.Run(\"stale_generation_with_realm_refuses\", func(t *testing.T) {\n949|\t\tt.Parallel()\n950|\t\tdeps := buildDecideDeps(t, true)\n951|\t\taddRealmEvidence(t, deps.universe, seedDigest(0xB1), \"codex\", \"0.147.0\")\n952|\t\tinput := validInput(t, deps)\n953|\t\tinput.Realm.Caller = CallerBackground\n954|\t\tinput.Realm.ServerGeneration = \"generation-STALE-pre-reboot\"\n955|\t\tinput.Smoke.Required = true\n956|\t\tinput.Smoke.Record = smokeRecord(t, \"pass\", \"A\", passingSmokeChecks(), smokeTuple())\n957|\t\ttarget := smokeTarget()\n958|\t\ttarget.TmuxServerGeneration = \"generation-STALE-pre-reboot\"\n959|\t\tinput.Smoke.Target = target\n960|\t\tdecision := Decide(input)\n961|\t\tif decision.Action != ActionRefused {\n962|\t\t\tt.Fatalf(\"Decide() action = %q, want refused for stale generation\", decision.Action)\n963|\t\t}\n964|\t})\n965|\tt.Run(\"admitted_realm_launches\", func(t *testing.T) {\n966|\t\tt.Parallel()\n967|\t\tdeps := buildDecideDeps(t, true)\n968|\t\taddRealmEvidence(t, deps.universe, seedDigest(0xB1), \"codex\", \"0.147.0\")\n969|\t\tinput := validInput(t, deps)\n970|\t\tinput.Realm.Caller = CallerBackground\n971|\t\tdecision := Decide(input)\n972|\t\tif decision.Action != ActionLaunch {\n973|\t\t\tt.Fatalf(\"Decide() action = %q, cause %v, want launch for admitted realm\", decision.Action, decision.Cause)\n974|\t\t}\n975|\t})\n976|}\n977|\n978|// TestDecideForgedTokensRefuse pins the token side of every\n979|// non-launch outcome: parked, refused, and offer decisions carry\n(more lines below)","final_result":true}}}
