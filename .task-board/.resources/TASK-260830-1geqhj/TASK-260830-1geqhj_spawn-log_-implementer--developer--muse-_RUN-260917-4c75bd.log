rver generation\"}\n99|}\n100|\n101|func errSmokeTargetOS() error {\n102|\treturn errSmoke{detail: \"provider-auth smoke target binds another OS version\"}\n103|}\n104|\n105|type errRealmValue struct{ detail string }\n106|\n107|func (err errRealmValue) Error() string { return err.detail }\n108|\n109|func errNoRealmEvidence() error {\n110|\treturn errRealmValue{detail: \"no admitted credential realm evidence authorizes a background caller\"}\n111|}\n112|\n113|func errRealmGenerationStale() error {\n114|\treturn errRealmValue{detail: \"background caller realm generation is stale\"}\n115|}\n116|\n117|func errRealmBinding() error {\n118|\treturn errRealmValue{detail: \"credential realm evidence binds another host binding or provider build\"}\n119|}\n120|\n121|type errHeadlessValue struct{}\n122|\n123|func (err errHeadlessValue) Error() string {\n124|\treturn \"non-interactive create requires headless_creation\"\n125|}\n126|\n127|func errHeadlessRequired() error { return errHeadlessValue{} }\n128|\n129|type errUnknownCaller string\n130|\n131|func (caller errUnknownCaller) Error() string {\n132|\treturn fmt.Sprintf(\"caller realm %q is not foreground or background\", string(caller))\n133|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
