{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c437","stream":{"kind":"session","id":"01a0b1e8-6498-7322-b5d6-d665ebf7eabc"},"sequence":118,"recorded_at":1780531400000231,"record_type":"event","durability":"durable","causation_id":"5c20913d-2f3d-47fb-bfa3-cadda84f302f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5c20913d-2f3d-47fb-bfa3-cadda84f302f","run_stream":{"kind":"run","id":"5c20913d-2f3d-47fb-bfa3-cadda84f302f"},"call_id":"call_01a0b1e8c3517085b5fed1e774942dd5","text":"{\n  \"chunk_id\": \"exec-5-1\",\n  \"command\": \"echo \\\"RUN_ID=${TASK_BOARD_RUN_ID:-unset}\\\"\\nexport TASK_BOARD_DIR=/Users/iv/Developer/ReluxWorks/agent-session-manager/.task-board\\n/Users/iv/.curator/global/bin/task-board q 'get(TASK-260830-1geqhj) { status }' 2>&1 | head -20\\necho \\\"---\\\"\\n/Users/iv/.curator/global/bin/task-board worktree --help 2>&1 | head -40\",\n  \"description\": \"Check run ID, task status, worktree help\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"RUN_ID=RUN-260918-2f42b7\\n{\\\"status\\\":\\\"integrating\\\"}\\n---\\nInspect and repair the Story-scoped Git workspaces that repository-mutating\\nspawns run in.\\n\\nEach Story gets one managed worktree under .temp/<STORY-ID>/worktree on a\\nshort-lived task-board/story/<STORY-ID> branch forked from trunk. Trunk is\\nspawn.worktree_isolation.integration_base_branch when configured, and otherwise\\nresolves from refs/remotes/origin/HEAD and then the current branch.\\n\\nThese commands require a local authoritative board. On a remote board they\\nrefuse with worktree_isolation_requires_local_board and do nothing else.\\n\\nUsage:\\n  task-board worktree [command]\\n\\nAvailable Commands:\\n  abort                 Stop using a Story workspace, preserving its work by default\\n  checkpoint            Commit an accepted leaf onto its Story branch while preserving integrating\\n  close-landed          Close an element whose accepted candidate is already on the protected trunk\\n  complete              Prove an accepted Story's code landed on its own repository, then record its board state in the board repository\\n  converge              Refresh a pinned Story workspace onto fresh trunk, carrying its uncommitted delta\\n  gc                    Release Story leases whose holding runs are provably terminal\\n  integrate             Land an accepted Story candidate on trunk and commit its board state\\n  integrating           Classify every element parked at integrating: awaiting a landing, board-only, already on trunk, or deferred\\n  invalidate-acceptance Release an invalidated or failed-revalidation acceptance back to rework\\n  obligations           List Change Request revisions that no live run owns\\n  prepare-landed-review Export a signed current-default tree for a new producer handoff and exact-tree review\\n  reconcile-trunk       Move the control root's trunk onto fresh protected authority when every local commit is already delivered there\\n  refresh-candidate     Refresh an initial or rework candidate base without losing uncommitted files\\n  repair                Re-materialize a recorded workspace whose worktree is missing\\n  start-landed-rework   Reprove a landed-review export and durably authorize normal producer rework\\n  status                Report managed Story workspaces and what blocks their cleanup\\n  transaction           Inspect and dispose of a refused or abandoned integration transaction\\n  trunk-rewrite         Report and migrate Story workspaces orphaned by a rewrite of protected trunk history\\n\\nFlags:\\n  -h, --help   help for worktree\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n\",\n  \"original_output_bytes\": 2758,\n  \"original_output_tokens\": 690,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
