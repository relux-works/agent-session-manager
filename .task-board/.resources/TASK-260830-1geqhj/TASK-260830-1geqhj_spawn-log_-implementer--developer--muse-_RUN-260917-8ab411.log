{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d043","stream":{"kind":"session","id":"01a0b0c8-2197-71f2-b37c-575c8ab978c8"},"sequence":1660,"recorded_at":1780531400003315,"record_type":"event","durability":"durable","causation_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","run_stream":{"kind":"run","id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3"},"task_stream":{"kind":"task","id":"01a0b0d1-0809-7fc3-b6e5-6219e15c84de"},"task_id":"01a0b0d1-0809-7fc3-b6e5-6219e15c84de","event":{"kind":"output","task_id":"01a0b0d1-0809-7fc3-b6e5-6219e15c84de","chunk":"edited\nchanged lines: lines 466-494\n--- original\n+++ updated\n@@\n-// decideParked resolves a fencing park into the parked outcome or,\n-// for a remote owner, the attach/takeover offer. Attach requires the\n-// remote interactive terminal of after-restore step 4 with an\n-// admitted attach capability; any other remote park offers takeover\n-// instead of starting a runtime. Non-remote parks carry the fencing\n-// reason unchanged.\n-func decideParked(input Input, admitted terminalbackend.Admitted, reason fencing.ParkReason, winning string, cause error) Decision {\n-\tif reason != fencing.ParkRemoteOwner {\n-\t\treturn parked(reason, winning, cause)\n-\t}\n-\tif input.RemoteInteractive && terminalbackend.CheckOperation(\"attach\", admitted) == nil {\n-\t\treturn Decision{\n-\t\t\tAction:         ActionAttachRemote,\n-\t\t\tParkReason:     reason,\n-\t\t\tWinningLeaseID: winning,\n-\t\t\tAdmitted:       admitted,\n-\t\t\tDetail:         \"offer remote attach; no lease mutation\",\n-\t\t\tCause:          cause,\n-\t\t}\n-\t}\n-\treturn Decision{\n-\t\tAction:         ActionTakeoverOffer,\n-\t\tParkReason:     reason,\n-\t\tWinningLeaseID: winning,\n-\t\tAdmitted:       admitted,\n-\t\tDetail:         \"offer takeover; no runtime started\",\n-\t\tCause:          cause,\n-\t}\n-}\n+// decideParked resolves a fencing park into the parked outcome or,\n+// for a remote owner in an interactive terminal, the attach/takeover\n+// offer of after-restore step 4. Attach requires the admitted attach\n+// capability; an interactive remote owner without it offers takeover\n+// instead of starting a runtime. A remote owner outside an\n+// interactive terminal parks with the remote_owner reason (§4.2 step\n+// 5: parked in all other cases). Non-remote parks carry the fencing\n+// reason unchanged.\n+func decideParked(input Input, admitted terminalbackend.Admitted, reason fencing.ParkReason, winning string, cause error) Decision {\n+\tif reason != fencing.ParkRemoteOwner {\n+\t\treturn parked(reason, winning, cause)\n+\t}\n+\tif !input.RemoteInteractive {\n+\t\treturn parked(reason, winning, cause)\n+\t}\n+\tif terminalbackend.CheckOperation(\"attach\", admitted) == nil {\n+\t\treturn Decision{\n+\t\t\tAction:         ActionAttachRemote,\n+\t\t\tParkReason:     reason,\n+\t\t\tWinningLeaseID: winning,\n+\t\t\tAdmitted:       admitted,\n+\t\t\tDetail:         \"offer remote attach; no lease mutation\",\n+\t\t\tCause:          cause,\n+\t\t}\n+\t}\n+\treturn Decision{\n+\t\tAction:         ActionTakeoverOffer,\n+\t\tParkReason:     reason,\n+\t\tWinningLeaseID: winning,\n+\t\tAdmitted:       admitted,\n+\t\tDetail:         \"offer takeover; no runtime started\",\n+\t\tCause:          cause,\n+\t}\n+}\n+\n+// bootstrapWindowClosed reports whether the §13.1 bootstrap window\n+// has closed: the winner carries a checkpoint, so the first\n+// checkpoint is published and a new bootstrap operation is a\n+// legitimate post-window binding, not an in-window mismatch. The\n+// predicate reads only the winner's own HasCheckpoint; a caller\n+// claim never closes the window.\n+func bootstrapWindowClosed(observation fencing.Observation) bool {\n+\treturn observation.HasWinner && observation.Winner.HasCheckpoint\n+}\n","final_result":true}}}
