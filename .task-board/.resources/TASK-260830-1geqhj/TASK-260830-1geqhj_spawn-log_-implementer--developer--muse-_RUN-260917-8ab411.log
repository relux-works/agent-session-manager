{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c66b","stream":{"kind":"session","id":"01a0b0c8-2197-71f2-b37c-575c8ab978c8"},"sequence":400,"recorded_at":1780531400000795,"record_type":"event","durability":"durable","causation_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","run_stream":{"kind":"run","id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3"},"task_stream":{"kind":"task","id":"01a0b0c9-4540-74e2-b696-0652ebd589fc"},"task_id":"01a0b0c9-4540-74e2-b696-0652ebd589fc","event":{"kind":"output","task_id":"01a0b0c9-4540-74e2-b696-0652ebd589fc","chunk":"Read text file `internal/axpane/decide.go`.\n(499 line(s) above)\n500|\tdigest, _, err := sessrepo.AttestCheckpointRecord(doc)\n501|\tif err != nil {\n502|\t\treturn err\n503|\t}\n504|\tif digest.String() != want {\n505|\t\treturn errCheckpointMismatch()\n506|\t}\n507|\treturn nil\n508|}\n509|\n510|// checkProviderIdentity composes the provhost resume gate: the exact\n511|// probed build tuple must pass the Section 8.4 direction, the stored\n512|// identity must validate for that provider at that exact version,\n513|// and the discovery proof, when present, must bind to the host-side\n514|// facts.\n515|func checkProviderIdentity(facts ProviderFacts) error {\n516|\tif err := provhost.CheckResumeTuple(facts.Build); err != nil {\n517|\t\treturn err\n518|\t}\n519|\tif err := provhost.VerifyIdentityBuild(facts.Identity, facts.Build); err != nil {\n520|\t\treturn err\n521|\t}\n522|\tif facts.HasDiscovery {\n523|\t\tif err := provhost.VerifyIdentityDiscovery(facts.Identity, facts.Discovery, facts.DiscoveryContext); err != nil {\n524|\t\t\treturn err\n525|\t\t}\n526|\t}\n527|\treturn nil\n528|}\n529|\n530|// checkSmoke enforces the provider-auth smoke precondition when the\n531|// path requires provider credentials. The stored record must verify\n532|// through the resumesmoke owner, its verdict must be pass, and its\n533|// exact claimed build must equal the probed build: a smoke result\n534|// for one build never authorizes another. A required smoke that is\n535|// absent, unverifiable, failing, or bound to another build refuses\n536|// target_auth_missing with the typed details Section 15.3 names.\n537|func checkSmoke(input Input) error {\n538|\tif !input.Smoke.Required {\n539|\t\treturn nil\n540|\t}\n541|\trecord, err := resumesmoke.VerifyRecord(input.Smoke.Record)\n542|\tif err != nil {\n543|\t\treturn smokeFailure(input, err)\n544|\t}\n545|\tif record.Verdict != resumesmoke.VerdictPass {\n546|\t\treturn smokeFailure(input, errSmokeVerdict(record.Verdict))\n547|\t}\n548|\tbuild := input.Provider.Build\n549|\tif record.Tuple.ProviderID != build.ProviderID ||\n550|\t\trecord.Tuple.ProviderVersion != build.ProviderVersion ||\n551|\t\trecord.Tuple.Platform != build.Platform ||\n552|\t\trecord.Tuple.Architecture != build.Architecture {\n553|\t\treturn smokeFailure(input, errSmokeTuple())\n554|\t}\n555|\treturn nil\n556|}\n557|\n558|// smokeFailure composes the typed target_auth_missing refusal. Typed\n559|// details are required members of the input: an input that omits\n560|// one is itself malformed and refuses invalid_arguments instead of\n561|// emitting an untyped refusal.\n562|func smokeFailure(input Input, cause error) error {\n563|\tfailure, err := axerror.NewTargetAuthMissing(axerror.Version130,\n564|\t\t\"provider-auth smoke did not pass for the probed build\",\n565|\t\taxerror.NoIDs(), input.Smoke.Target, cause)\n566|\tif err != nil {\n567|\t\treturn fmt.Errorf(\"%w: smoke refusal details are incomplete: %v\", errInvalidArguments{}, err)\n568|\t}\n569|\treturn failure\n570|}\n571|\n572|// checkRealm enforces the §4.2 background-caller rule: a background\n573|// caller may contact an already-running authenticated Aqua broker\n574|// and its attested AX tmux server, and otherwise returns\n575|// capability_unavailable with typed realm/readiness details. It\n576|// never falls back to direct server creation. A foreground caller\n577|// passes; there is no cached-sentinel or managername arm to pass\n578|// through, because neither authorizes resume. Typed details are\n579|// required input members: an input that omits one is itself\n580|// malformed and refuses invalid_arguments instead of emitting an\n581|// untyped capability_unavailable.\n582|func checkRealm(input Input) error {\n583|\tif input.Realm.Caller != CallerBackground {\n584|\t\treturn nil\n585|\t}\n586|\tif input.Realm.AttestedServer {\n587|\t\treturn nil\n588|\t}\n589|\tevidence := axerror.RealmEvidence{\n590|\t\tCapability:           \"credential_capable_execution_realm\",\n591|\t\tCallerRealm:          input.Realm.Caller,\n592|\t\tBrokerState:          input.Realm.BrokerState,\n593|\t\tTmuxServerGeneration: input.Realm.ServerGeneration,\n594|\t\tRemediation:          input.Realm.Remediation,\n595|\t}\n596|\tfailure, err := axerror.NewRealmEvidenceUnavailable(axerror.Version130,\n597|\t\t\"background caller has no attested tmux server\",\n598|\t\taxerror.NoIDs(), evidence, errNoAttestedServer())\n599|\tif err != nil {\n600|\t\treturn errInvalidArguments{detail: \"background caller realm details are incomplete\"}\n601|\t}\n602|\treturn failure\n603|}\n604|\n605|// checkRealmVocabulary closes the caller vocabulary: only\n606|// foreground and background name a caller.\n607|func checkRealmVocabulary(caller string) error {\n608|\tif caller != CallerForeground && caller != CallerBackground {\n609|\t\treturn errUnknownCaller(caller)\n610|\t}\n611|\treturn nil\n612|}\n613|\n614|// backendClass reads the Section 15 code off a terminalbackend\n615|// refusal. Landed codes pass through verbatim.\n616|func backendClass(err error) string {\n617|\tvar backend *terminalbackend.Error\n618|\tif errors.As(err, &backend) {\n619|\t\treturn backend.Code\n620|\t}\n621|\treturn terminalbackend.CodeMismatch\n622|}\n623|\n624|// fencingClass reads the Section 15 class off a fencing refusal:\n625|// invalid_arguments for malformed calls, lease_conflict for\n626|// foreign sessions and lapsed grants. Parks never reach here;\n627|// decideParked owns them.\n628|func fencingClass(err error) string {\n629|\tif errors.Is(err, fencing.ErrInvalidArguments) {\n630|\t\treturn ClassInvalidArguments\n631|\t}\n632|\treturn \"lease_conflict\"\n633|}\n634|\n635|// providerClass reads the Structured Error code off a provhost\n636|// refusal: invalid_config for tuple and mapping grammar, the\n637|// provider protocol code for identity and discovery failures.\n638|func providerClass(err error) string {\n639|\tvar failure *axerror.Error\n640|\tif errors.As(err, &failure) {\n641|\t\treturn string(failure.Code())\n642|\t}\n643|\treturn ClassInvalidConfig\n644|}\n645|\n646|// smokeClass reads the Structured Error code off a smoke refusal:\n647|// target_auth_missing for a required smoke that fails, or\n648|// invalid_arguments for a malformed smoke input.\n649|func smokeClass(err error) string {\n650|\tvar failure *axerror.Error\n651|\tif errors.As(err, &failure) {\n652|\t\treturn string(failure.Code())\n653|\t}\n654|\tvar malformed errInvalidArguments\n655|\tif errors.As(err, &malformed) {\n656|\t\treturn ClassInvalidArguments\n657|\t}\n658|\treturn \"target_auth_missing\"\n659|}","final_result":true}}}
