topped, parked,\\n// failed, stale, materializing, or tombstoned without the quiesce or\\n// resume the table requires.\\nfunc (fold *chainFold) effectCheckpointCreated(event Event, what string) error {\\n\",\n  \"original_output_bytes\": 9712,\n  \"original_output_tokens\": 2428,\n  \"truncated\": false\n}","final_result":true}}}
