{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000da89","stream":{"kind":"session","id":"01a0b0c8-2197-71f2-b37c-575c8ab978c8"},"sequence":2975,"recorded_at":1780531400005945,"record_type":"event","durability":"durable","causation_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","run_stream":{"kind":"run","id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3"},"task_stream":{"kind":"task","id":"01a0b0d9-2e84-7f10-a654-96f69e337ace"},"task_id":"01a0b0d9-2e84-7f10-a654-96f69e337ace","event":{"kind":"output","task_id":"01a0b0d9-2e84-7f10-a654-96f69e337ace","chunk":"edited\nchanged lines: lines 305-316\n--- original\n+++ updated\n@@\n-// sweepStaging removes stale binding-*.tmp files left by a\n-// pre-commit crash. It is best-effort: a sweep failure never fails\n-// the binding, and only the staging pattern is removed.\n-func sweepStaging(dir string) {\n-\tmatches, err := filepath.Glob(filepath.Join(dir, \"binding-*.tmp\"))\n-\tif err != nil {\n-\t\treturn\n-\t}\n-\tfor _, match := range matches {\n-\t\t_ = os.Remove(match)\n-\t}\n-}\n+// sweepStaging removes stale binding-*.tmp files left by a\n+// pre-commit crash. Only files older than a minute are removed: a\n+// concurrent live wrapper stages under the same pattern, and an\n+// age gate keeps the sweep from deleting its in-flight receipt. It\n+// is best-effort: a sweep failure never fails the binding, and\n+// only the staging pattern is removed.\n+func sweepStaging(dir string) {\n+\tmatches, err := filepath.Glob(filepath.Join(dir, \"binding-*.tmp\"))\n+\tif err != nil {\n+\t\treturn\n+\t}\n+\tcutoff := time.Now().Add(-time.Minute)\n+\tfor _, match := range matches {\n+\t\tinfo, err := os.Stat(match)\n+\t\tif err != nil {\n+\t\t\tcontinue\n+\t\t}\n+\t\tif info.ModTime().After(cutoff) {\n+\t\t\tcontinue\n+\t\t}\n+\t\t_ = os.Remove(match)\n+\t}\n+}\n","final_result":true}}}
