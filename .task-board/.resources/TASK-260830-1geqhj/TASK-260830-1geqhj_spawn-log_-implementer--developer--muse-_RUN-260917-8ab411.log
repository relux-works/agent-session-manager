nLaunch,\n447|\t\tToken:    token,\n448|\t\tHasToken: true,\n449|\t\tProfile:  pair,\n450|\t\tMapping:  resolved.Mapping,\n451|\t\tAdmitted: admitted,\n452|\t\tDetail:   \"launch under the winning lease\",\n453|\t}\n454|\tif input.ExistingBinding != nil {\n455|\t\tdecision.Action = ActionReattach\n456|\t\tdecision.Detail = \"reattach to the one recorded wrapper/child\"\n457|\t}\n458|\tdescriptor, err := terminalbackend.AdmitProviderDescriptor(input.Descriptor, input.HostBinding)\n459|\tif err != nil {\n460|\t\treturn refused(backendClass(err), \"provider descriptor does not match the validated binding\", err)\n461|\t}\n462|\tdecision.Descriptor = descriptor\n463|\treturn decision\n464|}\n465|\n466|// decideParked resolves a fencing park into the parked outcome or,\n467|// for a remote owner, the attach/takeover offer. Attach requires the\n468|// remote interactive terminal of after-restore step 4 with an\n469|// admitted attach capability; any other remote park offers takeover\n470|// instead of starting a runtime. Non-remote parks carry the fencing\n471|// reason unchanged.\n472|func decideParked(input Input, admitted terminalbackend.Admitted, reason fencing.ParkReason, winning string, cause error) Decision {\n473|\tif reason != fencing.ParkRemoteOwner {\n474|\t\treturn parked(reason, winning, cause)\n475|\t}\n476|\tif input.RemoteInteractive && terminalbackend.CheckOperation(\"attach\", admitted) == nil {\n477|\t\treturn Decision{\n478|\t\t\tAction:         ActionAttachRemote,\n479|\t\t\tParkReason:     reason,\n480|\t\t\tWinningLeaseID: winning,\n481|\t\t\tAdmitted:       admitted,\n482|\t\t\tDetail:         \"offer remote attach; no lease mutation\",\n483|\t\t\tCause:          cause,\n484|\t\t}\n485|\t}\n486|\treturn Decision{\n487|\t\tAction:         ActionTakeoverOffer,\n488|\t\tParkReason:     reason,\n489|\t\tWinningLeaseID: winning,\n490|\t\tAdmitted:       admitted,\n491|\t\tDetail:         \"offer takeover; no runtime started\",\n492|\t\tCause:          cause,\n493|\t}\n494|}\n495|\n496|// authorize selects the fencing entry by mode: activation for a\n497|// fresh launch, restore for the after-restore first start. Both are\n498|// launch-class entries: ownership that is remote, ambiguous,\n499|// unverified, or absent parks with the session.parked vocabulary,\n500|// while malformed calls, foreign sessions, and lapsed grants refuse.\n501|func authorize(input Input) (fencing.LeaseToken, error) {\n502|\tif input.Mode == ModeRestore {\n(more lines below)","final_result":true}}}
