261|\t}\n262|\tif decoded.EventType != \"session.parked\" || decoded.LeaseID != fixtureLeaseA || decoded.Payload.Reason != \"restore_policy\" {\n263|\t\tt.Fatalf(\"parked event = %+v\", decoded)\n264|\t}\n265|\tif _, found, err := world.pane.Status(fixtureSession); err != nil || found {\n266|\t\tt.Fatalf(\"Status() after parked = (%v, %v), want no binding\", found, err)\n267|\t}\n268|}\n269|\n270|func TestRunTakeoverOfferEmitsParked(t *testing.T) {\n271|\tt.Parallel()\n272|\tworld := buildRunWorld(t)\n273|\tleases, err := world.repo.ListLeases(fixtureSession)\n274|\tif err != nil {\n275|\t\tt.Fatal(err)\n276|\t}\n277|\tif _, err := world.repo.CompareAndSwapLease(fixtureSession, sessrepo.LeaseExpectation{RecordID: leases[0].RecordID}, sessrepo.SuccessorLeaseInput{\n278|\t\tCreateLeaseInput: sessrepo.CreateLeaseInput{\n279|\t\t\tLeaseID:        fixtureLeaseB,\n280|\t\t\tHolderHostID:   fixtureRemoteHost,\n281|\t\t\tIssuedByHostID: fixtureRemoteHost,\n282|\t\t\tCreatedAt:      fixtureCreatedAt,\n283|\t\t},\n284|\t\tReason:       \"graceful_takeover\",\n285|\t\tCheckpointID: seedDigest(0xC9),\n286|\t}); err != nil {\n287|\t\tt.Fatalf(\"CompareAndSwapLease() error = %v\", err)\n288|\t}\n289|\toutcome, err := Run(world.stores(), runRequest(t, world))\n290|\tif err != nil {\n291|\t\tt.Fatalf(\"Run() error = %v\", err)\n292|\t}\n293|\tif outcome.Decision.Action != ActionTakeoverOffer {\n294|\t\tt.Fatalf(\"Run() action = %q, want takeover_offer\", outcome.Decision.Action)\n295|\t}\n296|\tif !outcome.Emitted || outcome.Event == nil {\n297|\t\tt.Fatal(\"Run() takeover offer authors no parked event\")\n298|\t}\n299|\tstored, err := world.repo.GetEvent(fixtureSession, outcome.Event.EventID)\n300|\tif err != nil {\n301|\t\tt.Fatal(err)\n302|\t}\n303|\tvar decoded struct {\n304|\t\tEventType string `json:\"event_type\"`\n305|\t\tPayload   struct {\n306|\t\t\tReason string `json:\"reason\"`\n307|\t\t} `json:\"payload\"`\n308|\t}\n309|\tif err := json.Unmarshal(stored, &decoded); err != nil {\n310|\t\tt.Fatal(err)\n311|\t}\n312|\tif decoded.EventType != \"session.parked\" || decoded.Payload.Reason != \"remote_owner\" {\n313|\t\tt.Fatalf(\"offer parked event = %+v\", decoded)\n314|\t}\n315|}\n316|\n317|func TestRunParkedWithoutWinnerSkipsEmission(t *testing.T) {\n318|\tt.Parallel()\n(more lines below)","final_result":true}}}
