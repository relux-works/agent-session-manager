{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cfb1","stream":{"kind":"session","id":"01a0b0c8-2197-71f2-b37c-575c8ab978c8"},"sequence":1587,"recorded_at":1780531400003169,"record_type":"event","durability":"durable","causation_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","run_stream":{"kind":"run","id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3"},"task_stream":{"kind":"task","id":"01a0b0d0-d523-7702-9026-04bb864a4970"},"task_id":"01a0b0d0-d523-7702-9026-04bb864a4970","event":{"kind":"output","task_id":"01a0b0d0-d523-7702-9026-04bb864a4970","chunk":"edited\nchanged lines: lines 340-422\n--- original\n+++ updated\n@@\n-// Decide is the pure wrapper core: configuration, session, bootstrap\n-// idempotency, backend identity and capability admission, fencing,\n-// materialization, checkpoint, provider identity, provider-auth\n-// smoke, realm readiness, profile derivation and mapping,\n-// entrypoint, and provider descriptor, in that precedence, then the\n-// outcome selection. The tuple gate precedes mapping so a tuple\n-// refusal keeps its own class instead of wearing\n-// profile_mapping_unavailable. Decide performs no I/O, reads no\n-// clock except the instants the input carries, and mints no lease,\n-// binding, or event: Run owns the durable effects. Every refusal\n-// carries the Section 15 code the arm names; every park carries the\n-// session.parked vocabulary.\n-func Decide(input Input) Decision {\n-\tif input.ConfigErr != nil {\n-\t\treturn refused(ClassInvalidConfig, \"configuration is invalid\", input.ConfigErr)\n-\t}\n-\tif input.Mode != ModeLaunch && input.Mode != ModeRestore {\n-\t\treturn refused(ClassInvalidArguments, \"wrapper mode is not launch or restore\", errWrapperMode(input.Mode))\n-\t}\n-\tif !input.SessionKnown {\n-\t\treturn refused(ClassInvalidArguments, \"logical session is unknown\"