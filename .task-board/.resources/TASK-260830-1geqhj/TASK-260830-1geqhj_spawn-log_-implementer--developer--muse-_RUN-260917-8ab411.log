{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9bb","stream":{"kind":"session","id":"01a0b0c8-2197-71f2-b37c-575c8ab978c8"},"sequence":824,"recorded_at":1780531400001643,"record_type":"event","durability":"durable","causation_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","run_stream":{"kind":"run","id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3"},"task_stream":{"kind":"task","id":"01a0b0ca-77ba-7561-be97-5121943616a3"},"task_id":"01a0b0ca-77ba-7561-be97-5121943616a3","event":{"kind":"output","task_id":"01a0b0ca-77ba-7561-be97-5121943616a3","chunk":"Read text file `internal/axpane/conformance_test.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"os/exec\"\n5|\t\"regexp\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n10|)\n11|\n12|// TestDecideArmPrecedence pins the §4.C wrapper-rule order: with\n13|// every arm faulted at once, the first arm wins. Configuration\n14|// precedes session, which precedes bootstrap idempotency, which\n15|// precedes backend admission, which precedes fencing.\n16|func TestDecideArmPrecedence(t *testing.T) {\n17|\tt.Parallel()\n18|\tdeps := buildDecideDeps(t, true)\n19|\tinput := validInput(t, deps)\n20|\tinput.ConfigErr = errFixtureConfig\n21|\tinput.SessionKnown = false\n22|\tinput.ExistingBinding = &Binding{SessionID: fixtureSession, OperationID: fixtureOtherOp}\n23|\tinput.Backend.Manifest = []byte(`{\"broken\":true}`)\n24|\tinput.Presented.Epoch = 0\n25|\tdecision := Decide(input)\n26|\tif decision.Action != ActionRefused || decision.Class != ClassInvalidConfig {\n27|\t\tt.Fatalf(\"Decide() all-faulted = (%q, %q), want (refused, invalid_config)\", decision.Action, decision.Class)\n28|\t}\n29|\tinput.ConfigErr = nil\n30|\tdecision = Decide(input)\n31|\tif decision.Action != ActionRefused || decision.Class != ClassInvalidArguments {\n32|\t\tt.Fatalf(\"Decide() peeled-config = (%q, %q), want the session arm\", decision.Action, decision.Class)\n33|\t}\n34|}\n35|\n36|// TestEmitParkedVocabularyLoop authors all four session.parked\n37|// reasons through the production emission path and reads each back\n38|// with its exact closed payload.\n39|func TestEmitParkedVocabularyLoop(t *testing.T) {\n40|\tt.Parallel()\n41|\tdeps := buildDecideDeps(t, true)\n42|\tcases := []struct {\n43|\t\treason fencing.ParkReason\n44|\t\taction Action\n45|\t\tmutate func(*Input)\n46|\t}{\n47|\t\t{fencing.ParkRemoteOwner, ActionTakeoverOffer, func(input *Input) { input.Observation.Winner.HolderHostID = fixtureRemoteHost }},\n48|\t\t{fencing.ParkStaleOwner, ActionParked, func(input *Input) { input.Presented.LeaseID = fixtureLeaseB }},\n49|\t\t{fencing.ParkRestorePolicy, ActionParked, func(input *Input) { input.Observation.Verified = false }},\n50|\t\t{fencing.ParkFailedHandoff, ActionParked, func(input *Input) { input.Observation.HandoffFailed = true }},\n51|\t}\n52|\tsequence := uint64(2)\n53|\tpredecessor := deps.createdID\n54|\tfor _, testCase := range cases {\n55|\t\tinput := validInput(t, deps)\n56|\t\ttestCase.mutate(&input)\n57|\t\tdecision := Decide(input)\n58|\t\tif decision.Action != testCase.action || decision.ParkReason != testCase.reason {\n59|\t\t\tt.Fatalf(\"Decide() = (%q, %q), want (%q, %q)\", decision.Action, decision.ParkReason, testCase.action, testCase.reason)\n60|\t\t}\n61|\t\treference, _, err := EmitParked(deps.repo, decision, EmitParams{\n62|\t\t\tSessionID: fixtureSession, CreatedByHost: fixtureLocalHost,\n63|\t\t\tLeaseEpoch: 1, LeaseID: fixtureLeaseA, LeaseSequence: sequence,\n64|\t\t\tPredecessors: []string{predecessor}, CreatedAt: fixtureCreatedAt,\n65|\t\t})\n66|\t\tif err != nil {\n67|\t\t\tt.Fatalf(\"EmitParked(%q) error = %v\", testCase.reason, err)\n68|\t\t}\n69|\t\tstored, err := deps.repo.GetEvent(fixtureSession, reference.EventID)\n70|\t\tif err != nil {\n71|\t\t\tt.Fatal(err)\n72|\t\t}\n73|\t\tif !strings.Contains(string(stored), `\"reason\":\"`+string(testCase.reason)+`\"`) {\n74|\t\t\tt.Fatalf(\"parked event for %q carries no reason member: %s\", testCase.reason, stored)\n75|\t\t}\n76|\t\tsequence++\n77|\t\tpredecessor = reference.EventID\n78|\t}\n79|}\n80|\n81|// TestLaunchCarriesValidatedPlan pins the §13.1 step-4 surface the\n82|// wrapper hands to the later provider-launch leaf: the resolved\n83|// adapter mapping, the admitted §7.A descriptor, and the sealed\n84|// fencing token travel together on every launch, and no launch\n85|// ships a partial plan.\n86|func TestLaunchCarriesValidatedPlan(t *testing.T) {\n87|\tt.Parallel()\n88|\tdeps := buildDecideDeps(t, true)\n89|\tdecision := Decide(validInput(t, deps))\n90|\tif decision.Action != ActionLaunch {\n91|\t\tt.Fatalf(\"Decide() action = %q, want launch\", decision.Action)\n92|\t}\n93|\tif !decision.HasToken {\n94|\t\tt.Fatal(\"launch carries no fencing token\")\n95|\t}\n96|\tif decision.Descriptor.TerminalInstanceID == \"\" {\n97|\t\tt.Fatal(\"launch carries no admitted descriptor\")\n98|\t}\n99|\tif len(decision.Admitted.Capabilities) == 0 {\n100|\t\tt.Fatal(\"launch carries no admitted capabilities\")\n101|\t}\n102|}\n103|\n104|// TestConformanceMatrixCompleteness enumerates the pinned clauses\n105|// and the named top-level test that drives each through a\n106|// production entry, then verifies every named test exists in this\n107|// package through the go list entry. A row fails if its test is\n108|// removed or renamed without updating the matrix; subtest rows in\n109|// TRACEABILITY.md refine these top-level drivers.\n110|func TestConformanceMatrixCompleteness(t *testing.T) {\n111|\tt.Parallel()\n112|\trows := []struct {\n113|\t\tclause string\n114|\t\ttest   string\n115|\t}{\n116|\t\t{\"4.B manifest/probe/evidence identity\", \"TestDecideLaunchPositive\"},\n117|\t\t{\"4.B mismatch fails before activation\", \"TestDecideTable\"},\n118|\t\t{\"4.C wrapper rule order\", \"TestDecideArmPrecedence\"},\n119|\t\t{\"4.C bootstrap idempotency mismatch\", \"TestDecideTable\"},\n120|\t\t{\"4.C identical retry reattaches\", \"TestBindIdenticalRetryReattaches\"},\n121|\t\t{\"4.C concurrent commit reattaches\", \"TestBindConcurrentSameOperationReattaches\"},\n122|\t\t{\"4.C status proves absence\", \"TestBindInstallsAndStatusProves\"},\n123|\t\t{\"4.C unknown is not absent\", \"TestStatusUnknownIsNotAbsent\"},\n124|\t\t{\"4.C no PID persisted\", \"TestBindingPersistsNoPID\"},\n125|\t\t{\"4.C crash at the binding seam\", \"TestBindCrashChildSelfTerminates\"},\n126|\t\t{\"4.D only admitted rows authorize\", \"TestDecideTable\"},\n127|\t\t{\"4.2 background caller capability_unavailable\", \"TestDecideTypedRefusals\"},\n128|\t\t{\"4.2 cached evidence never authorizes\", \"TestRealmCarriesNoCachedEvidence\"},\n129|\t\t{\"4.2 after-restore sequence\", \"TestDecideAfterRestoreSequence\"},\n130|\t\t{\"5.2 session.parked vocabulary\", \"TestEmitParkedVocabularyLoop\"},\n131|\t\t{\"5.2 parked emission under lease\", \"TestEmitParkedRoundTrip\"},\n132|\t\t{\"5.2 v4 terminal payloads\", \"TestEmitTerminalV4RoundTrip\"},\n133|\t\t{\"7.A descriptor build and admit\", \"TestDescriptorBuildAdmitRoundTrip\"},\n134|\t\t{\"7.A descriptor mismatch refuses\", \"TestDescriptorMismatchRefuses\"},\n135|\t\t{\"7.A generation bounds\", \"TestDescriptorGenerationBounds\"},\n136|\t\t{\"7.A token passed separately\", \"TestDecideForgedTokensRefuse\"},\n137|\t\t{\"13.1 step 3 durable terminal entry\", \"TestRunLaunchBinds\"},\n138|\t\t{\"13.1 step 4 validated plan\", \"TestLaunchCarriesValidatedPlan\"},\n139|\t\t{\"2.4 effective profile and source\", \"TestDecideProfileSourcePinsEvent\"},\n140|\t\t{\"2.4 mapping refusal\", \"TestDecideYoloMapping\"},\n141|\t\t{\"orchestrated launch/reattach/park/refuse\", \"TestRunParkedEmits\"},\n142|\t\t{\"ownership observation over leases\", \"TestObserveLoadsWinningLease\"},\n143|\t}\n144|\tlisted, err := exec.Command(\"go\", \"test\", \".\", \"-list\", \".\", \"-count=1\").CombinedOutput()\n145|\tif err != nil {\n146|\t\tt.Fatalf(\"go test -list error = %v: %s\", err, listed)\n147|\t}\n148|\tpresent := map[string]bool{}\n149|\tfor _, line := range strings.Split(string(listed), \"\\n\") {\n150|\t\tmatched, _ := regexp.MatchString(`^Test[A-Za-z0-9_]+$`, strings.TrimSpace(line))\n151|\t\tif matched {\n152|\t\t\tpresent[strings.TrimSpace(line)] = true\n153|\t\t}\n154|\t}\n155|\tif len(present) == 0 {\n156|\t\tt.Fatalf(\"go test -list found no tests: %s\", listed)\n157|\t}\n158|\tfor _, row := range rows {\n159|\t\tif !present[row.test] {\n160|\t\t\tt.Errorf(\"clause %q names missing test %q\", row.clause, row.test)\n161|\t\t}\n162|\t}\n163|\tt.Logf(\"%d pinned clauses mapped to named tests\", len(rows))\n164|}","final_result":true}}}
