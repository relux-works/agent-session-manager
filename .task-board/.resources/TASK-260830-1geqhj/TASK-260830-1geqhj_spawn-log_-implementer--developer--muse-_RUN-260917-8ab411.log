{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5ed","stream":{"kind":"session","id":"01a0b0c8-2197-71f2-b37c-575c8ab978c8"},"sequence":337,"recorded_at":1780531400000669,"record_type":"event","durability":"durable","causation_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","run_stream":{"kind":"run","id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3"},"task_stream":{"kind":"task","id":"01a0b0c9-2b86-7f02-88c5-614faddb4b11"},"task_id":"01a0b0c9-2b86-7f02-88c5-614faddb4b11","event":{"kind":"output","task_id":"01a0b0c9-2b86-7f02-88c5-614faddb4b11","chunk":"Read text file `/tmp/rev1/evidence/probes/zz_review_delta_test.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/matjournal\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n11|)\n12|\n13|// Delta witnesses for the surviving reviewer mutants: each logs the\n14|// outcome so the same test run under the mutant shows the behavioral\n15|// change the suite never observes.\n16|func TestReviewDeltaRM2RemoteOwnerStaleMaterialization(t *testing.T) {\n17|\tdeps := buildDecideDeps(t, true)\n18|\tinput := validInput(t, deps)\n19|\tinput.Mode = ModeRestore\n20|\tinput.Observation.Winner.HolderHostID = fixtureRemoteHost\n21|\tinput.RemoteInteractive = true\n22|\tinput.MaterializationRequired = true\n23|\tinput.JournalOK = true\n24|\tinput.Journal = matjournal.Journal{Phase: matjournal.PhaseStaging}\n25|\tdecision := Decide(input)\n26|\tt.Logf(\"RM2 witness: remote interactive owner + staging materialization -> action=%s reason=%s\", decision.Action, decision.ParkReason)\n27|}\n28|\n29|func TestReviewDeltaRM4RestoreChangedOperation(t *testing.T) {\n30|\tdeps := buildDecideDeps(t, true)\n31|\tinput := validInput(t, deps)\n32|\tinput.Mode = ModeRestore\n33|\tinput.ExistingBinding = &Binding{SessionID: fixtureSession, OperationID: fixtureOtherOp, TerminalInstanceID: fixtureInstance, BindingDigest: seedDigest(0xB1), CreatedAt: fixtureCreatedAt}\n34|\tdecision := Decide(input)\n35|\tt.Logf(\"RM4 witness: restore mode + changed bootstrap operation -> action=%s class=%s\", decision.Action, decision.Class)\n36|}\n37|\n38|func TestReviewDeltaRM1ObserveFailure(t *testing.T) {\n39|\tworld := buildRunWorld(t)\n40|\troot := t.TempDir()\n41|\trepository, err := sessrepo.Open(root)\n42|\tif err != nil {\n43|\t\tt.Fatal(err)\n44|\t}\n45|\tvar record map[string]any\n46|\tif err := json.Unmarshal([]byte(sessionRecordFixture), &record); err != nil {\n47|\t\tt.Fatal(err)\n48|\t}\n49|\treference, err := repository.CreateSession(identifyObject(t, record, \"record_id\"))\n50|\tif err != nil {\n51|\t\tt.Fatal(err)\n52|\t}\n53|\tif _, err := repository.CreateLease(fixtureSession, sessrepo.CreateLeaseInput{LeaseID: fixtureLeaseA, HolderHostID: fixtureLocalHost, IssuedByHostID: fixtureLocalHost, CreatedAt: fixtureCreatedAt}); err != nil {\n54|\t\tt.Fatal(err)\n55|\t}\n56|\tappendChainEvent(t, repository, \"session.created\", 1, fixtureLeaseA, 1, reference.RecordID, map[string]any{\n57|\t\t\"session_record_id\": reference.RecordID, \"bootstrap_operation_id\": fixtureBootstrap, \"first_checkpoint_operation_id\": fixtureOtherOp,\n58|\t})\n59|\tworld.repo = repository\n60|\tmatches, _ := filepath.Glob(filepath.Join(root, \"sessions\", fixtureSession, \"leases\", \"*\"))\n61|\tt.Logf(\"lease blobs: %d\", len(matches))\n62|\tfor _, match := range matches {\n63|\t\tif err := os.WriteFile(match, []byte(\"{torn\"), 0o600); err != nil {\n64|\t\t\tt.Fatal(err)\n65|\t\t}\n66|\t}\n67|\toutcome, err := Run(world.stores(), runRequest(t, world))\n68|\tt.Logf(\"RM1 witness: Run with a torn lease blob -> action=%q emitted=%v err=%v\", outcome.Decision.Action, outcome.Emitted, err)\n69|}","final_result":true}}}
