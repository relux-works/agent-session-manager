{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf85","stream":{"kind":"session","id":"01a0b0c8-2197-71f2-b37c-575c8ab978c8"},"sequence":1565,"recorded_at":1780531400003125,"record_type":"event","durability":"durable","causation_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","run_stream":{"kind":"run","id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3"},"task_stream":{"kind":"task","id":"01a0b0d0-9915-7e11-8ff5-8575018f4f30"},"task_id":"01a0b0d0-9915-7e11-8ff5-8575018f4f30","event":{"kind":"output","task_id":"01a0b0d0-9915-7e11-8ff5-8575018f4f30","chunk":"Read text file `internal/axpane/decide.go`.\n(322 line(s) above)\n323|\tRealmFailure *axerror.Error\n324|}\n325|\n326|func refused(class, detail string, cause error) Decision {\n327|\treturn Decision{Action: ActionRefused, Class: class, Detail: detail, Cause: cause}\n328|}\n329|\n330|func parked(reason fencing.ParkReason, winningLeaseID string, cause error) Decision {\n331|\treturn Decision{\n332|\t\tAction:         ActionParked,\n333|\t\tParkReason:     reason,\n334|\t\tWinningLeaseID: winningLeaseID,\n335|\t\tDetail:         \"park (\" + string(reason) + \") without launching the provider\",\n336|\t\tCause:          cause,\n337|\t}\n338|}\n339|\n340|// Decide is the pure wrapper core: configuration, session, bootstrap\n341|// idempotency, backend identity and capability admission, fencing,\n342|// materialization, checkpoint, provider identity, provider-auth\n343|// smoke, realm readiness, profile derivation and mapping,\n344|// entrypoint, and provider descriptor, in that precedence, then the\n345|// outcome selection. The tuple gate precedes mapping so a tuple\n346|// refusal keeps its own class instead of wearing\n347|// profile_mapping_unavailable. Decide performs no I/O, reads no\n348|// clock except the instants the input carries, and mints no lease,\n349|// binding, or event: Run owns the durable effects. Every refusal\n350|// carries the Section 15 code the arm names; every park carries the\n351|// session.parked vocabulary.\n352|func Decide(input Input) Decision {\n353|\tif input.ConfigErr != nil {\n354|\t\treturn refused(ClassInvalidConfig, \"configuration is invalid\", input.ConfigErr)\n355|\t}\n356|\tif input.Mode != ModeLaunch && input.Mode != ModeRestore {\n357|\t\treturn refused(ClassInvalidArguments, \"wrapper mode is not launch or restore\", errWrapperMode(input.Mode))\n358|\t}\n359|\tif !input.SessionKnown {\n360|\t\treturn refused(ClassInvalidArguments, \"logical session is unknown\", errUnknownSession(input.SessionID))\n361|\t}\n362|\tif input.ExistingBinding != nil && input.ExistingBinding.OperationID != input.BootstrapOperationID {\n363|\t\treturn refused(terminalbackend.CodeIdempotencyMismatch,\n364|\t\t\t\"bootstrap operation changed inside the bootstrap window\",\n365|\t\t\terrIdempotencyChanged(input.SessionID))\n366|\t}\n367|\tif err := checkRealmVocabulary(input.Realm.Caller); err != nil {\n368|\t\treturn refused(ClassInvalidArguments, \"caller realm is not foreground or background\", err)\n369|\t}\n370|\n371|\tadmitted, err := admitBackend(input)\n372|\tif err != nil {\n373|\t\treturn refused(backendClass(err), \"terminal backend identity or capability admission failed\", err)\n374|\t}\n375|\n376|\ttoken, err := authorize(input)\n377|\tif err != nil {\n378|\t\tif fencing.IsParked(err) {\n379|\t\t\treason, winning, _ := fencing.ParkDetails(err)\n380|\t\t\treturn decideParked(input, admitted, reason, winning, err)\n381|\t\t}\n382|\t\treturn refused(fencingClass(err), \"fencing refused the wrapper\", err)\n383|\t}\n384|\n385|\tif input.MaterializationRequired && (!input.JournalOK || input.Journal.Phase != matjournal.PhaseCommitted) {\n386|\t\treturn parked(fencing.ParkRestorePolicy, input.Observation.Winner.LeaseID,\n387|\t\t\terrMaterializationNotValid(input.Journal.Phase, input.JournalOK))\n388|\t}\n389|\tif input.CheckpointRequired {\n390|\t\tif err := admitCheckpoint(input.CheckpointDoc, input.CheckpointID); err != nil {\n391|\t\t\treturn parked(fencing.ParkRestorePolicy, input.Observation.Winner.LeaseID, err)\n392|\t\t}\n393|\t}\n394|\n395|\tif err := checkProviderIdentity(input.Provider); err != nil {\n396|\t\treturn refused(providerClass(err), \"provider identity is unresolved\", err)\n397|\t}\n398|\tif err := checkSmoke(input); err != nil {\n399|\t\tdecision := refused(smokeClass(err), \"provider-auth smoke precondition failed\", err)\n400|\t\tvar typed *axerror.Error\n401|\t\tif errors.As(err, &typed) {\n402|\t\t\tdecision.RealmFailure = typed\n403|\t\t}\n404|\t\treturn decision\n405|\t}\n406|\tif err := checkRealm(input); err != nil {\n407|\t\tvar malformed errInvalidArguments\n408|\t\tif errors.As(err, &malformed) {\n409|\t\t\treturn refused(ClassInvalidArguments, \"background caller realm details are incomplete\", err)\n410|\t\t}\n411|\t\tvar typed *axerror.Error\n412|\t\tif errors.As(err, &typed) {\n413|\t\t\tdecision := refused(string(typed.Code()), \"background caller has no attested server\", err)\n414|\t\t\tdecision.RealmFailure = typed\n415|\t\t\treturn decision\n416|\t\t}\n417|\t\treturn refused(ClassInvalidArguments, \"background caller realm is unverifiable\", err)\n418|\t}\n419|\tpair, err := sessprofile.Derive(input.ProfileRecord, input.ProfileEvents)\n420|\tif err != nil {\n421|\t\treturn refused(ClassIntegrityFailure, \"effective profile derivation failed\", err)\n422|\t}\n423|\t// The tuple gate above already admitted the probed build, so a\n424|\t// ResolveMapping failure here is the mapping gap Section 2.4\n425|\t// names, never a tuple refusal wearing the mapping class.\n426|\tresolved, err := provhost.ResolveMapping(input.Provider.Build.ProviderID, pair.Profile, input.Provider.Build)\n427|\tif err != nil {\n428|\t\treturn refused(ClassProfileMappingUnavailable, \"adapter cannot map the stored profile\", err)\n429|\t}\n430|\tif err := terminalbackend.CheckEntrypoint(input.Entrypoint, input.SessionID); err != nil {\n431|\t\treturn refused(backendClass(err), \"stable entrypoint is not ax pane SESSION_ID\", err)\n432|\t}\n433|\n434|\tdecision := Decision{\n435|\t\tAction:   ActionLaunch,\n436|\t\tToken:    token,\n437|\t\tHasToken: true,\n438|\t\tProfile:  pair,\n439|\t\tMapping:  resolved.Mapping,\n440|\t\tAdmitted: admitted,\n441|\t\tDetail:   \"launch under the winning lease\",\n442|\t}\n443|\tif input.ExistingBinding != nil {\n444|\t\tdecision.Action = ActionReattach\n445|\t\tdecision.Detail = \"reattach to the one recorded wrapper/child\"\n446|\t}\n447|\tdescriptor, err := terminalbackend.AdmitProviderDescriptor(input.Descriptor, input.HostBinding)\n448|\tif err != nil {\n449|\t\treturn refused(backendClass(err), \"provider descriptor does not match the validated binding\", err)\n450|\t}\n451|\tdecision.Descriptor = descriptor\n452|\treturn decision\n453|}\n454|\n455|// decideParked resolves a fencing park into the parked outcome or,\n456|// for a remote owner, the attach/takeover offer. Attach requires the\n457|// remote interactive terminal of after-restore step 4 with an\n458|// admitted attach capability; any other remote park offers takeover\n459|// instead of starting a runtime. Non-remote parks carry the fencing\n460|// reason unchanged.\n461|func decideParked(input Input, admitted terminalbackend.Admitted, reason fencing.ParkReason, winning string, cause error) Decision {\n462|\tif reason != fencing.ParkRemoteOwner {\n463|\t\treturn parked(reason, winning, cause)\n464|\t}\n465|\tif input.RemoteInteractive && terminalbackend.CheckOperation(\"attach\", admitted) == nil {\n466|\t\treturn Decision{\n467|\t\t\tAction:         ActionAttachRemote,\n468|\t\t\tParkReason:     reason,\n469|\t\t\tWinningLeaseID: winning,\n470|\t\t\tAdmitted:       admitted,\n471|\t\t\tDetail:         \"offer remote attach; no lease mutation\",\n472|\t\t\tCause:          cause,\n473|\t\t}\n474|\t}\n475|\treturn Decision{\n476|\t\tAction:         ActionTakeoverOffer,\n477|\t\tParkReason:     reason,\n478|\t\tWinningLeaseID: winning,\n479|\t\tAdmitted:       admitted,\n480|\t\tDetail:         \"offer takeover; no runtime started\",\n481|\t\tCause:          cause,\n482|\t}\n(more lines below)","final_result":true}}}
