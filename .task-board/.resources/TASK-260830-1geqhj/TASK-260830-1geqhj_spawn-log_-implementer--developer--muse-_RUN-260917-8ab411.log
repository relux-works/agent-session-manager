{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d8bf","stream":{"kind":"session","id":"01a0b0c8-2197-71f2-b37c-575c8ab978c8"},"sequence":2746,"recorded_at":1780531400005487,"record_type":"event","durability":"durable","causation_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","run_stream":{"kind":"run","id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3"},"task_stream":{"kind":"task","id":"01a0b0d7-3e82-7070-af04-d90feaa4fda7"},"task_id":"01a0b0d7-3e82-7070-af04-d90feaa4fda7","event":{"kind":"output","task_id":"01a0b0d7-3e82-7070-af04-d90feaa4fda7","chunk":"Read text file `internal/axpane/decide_test.go`.\n(922 line(s) above)\n923|\t})\n924|}\n925|\n926|// TestRealmCarriesNoCachedEvidence pins the §4.2 cached-evidence\n927|// rule structurally: the Realm input has exactly the foreground/\n928|// background caller, the attested-server fact, and the typed\n929|// realm/readiness details. No member accepts a cached sentinel\n930|// result or a managername observation, so neither can authorize\n931|// resume through any input value.\n932|func TestRealmCarriesNoCachedEvidence(t *testing.T) {\n933|\tt.Parallel()\n934|\tfields := map[string]bool{}\n935|\tfor index := 0; index < reflect.TypeOf(Realm{}).NumField(); index++ {\n936|\t\tfields[reflect.TypeOf(Realm{}).Field(index).Name] = true\n937|\t}\n938|\twant := map[string]bool{\n939|\t\t\"Caller\": true, \"AttestedServer\": true, \"BrokerState\": true,\n940|\t\t\"ServerGeneration\": true, \"Remediation\": true,\n941|\t}\n942|\tif !reflect.DeepEqual(fields, want) {\n943|\t\tt.Fatalf(\"Realm fields = %v, want exactly %v\", fields, want)\n944|\t}\n945|}\n946|\n947|// TestDecideForgedTokensRefuse pins the token side of every\n948|// non-launch outcome: parked, refused, and offer decisions carry\n949|// the zero token, and the zero token refuses every provider\n950|// operation through the fencing owner.\n951|func TestDecideForgedTokensRefuse(t *testing.T) {\n952|\tt.Parallel()\n953|\tdeps := buildDecideDeps(t, true)\n954|\tinput := validInput(t, deps)\n955|\tinput.Observation.Verified = false\n956|\tdecision := Decide(input)\n957|\tif decision.Action != ActionParked || decision.HasToken {\n958|\t\tt.Fatalf(\"Decide() = (%q, hasToken %v), want parked with no token\", decision.Action, decision.HasToken)\n959|\t}\n960|\tfor _, operation := range []fencing.ProviderOperation{fencing.ProviderQuiesce, fencing.ProviderCapture, fencing.ProviderMaterialize} {\n961|\t\tif _, err := decision.Token.Bind(operation); err == nil {\n962|\t\t\tt.Fatalf(\"Token.Bind(%q) on a parked decision succeeded, want refusal\", string(operation))\n963|\t\t}\n964|\t}\n965|}\n966|\n967|// TestDecideProfileSourcePinsEvent pins the PROFILE-DIRECT-RESUME\n968|// direction: the launch carries the newest authoritative\n969|// profile.changed event as its source, never the creation value,\n970|// when the closure contains a later change.\n971|func TestDecideProfileSourcePinsEvent(t *testing.T) {\n972|\tt.Parallel()\n973|\tdeps := buildDecideDeps(t, true)\n974|\tchanged := appendChainEvent(t, deps.repo, \"profile.changed\", 1, fixtureLeaseA, 2, deps.createdID, map[string]any{\n975|\t\t\"from\": \"standard\", \"to\": \"yolo\", \"confirmed\": true,\n976|\t})\n977|\tinput := validInput(t, deps)\n978|\tdecision := Decide(input)\n979|\tif decision.Action != ActionLaunch {\n980|\t\tt.Fatalf(\"Decide() action = %q, cause %v, want launch\", decision.Action, decision.Cause)\n981|\t}\n982|\tif !decision.Profile.HasSource || decision.Profile.Source != changed {\n(more lines below)","final_result":true}}}
