{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8d5","stream":{"kind":"session","id":"01a0b0c8-2197-71f2-b37c-575c8ab978c8"},"sequence":709,"recorded_at":1780531400001413,"record_type":"event","durability":"durable","causation_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","run_stream":{"kind":"run","id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3"},"task_stream":{"kind":"task","id":"01a0b0ca-4685-7f72-bfb9-c8dade1d8038"},"task_id":"01a0b0ca-4685-7f72-bfb9-c8dade1d8038","event":{"kind":"output","task_id":"01a0b0ca-4685-7f72-bfb9-c8dade1d8038","chunk":"Read text file `internal/axpane/run_test.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"io/fs\"\n7|\t\"os\"\n8|\t\"testing\"\n9|\t\"time\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/config\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/matjournal\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/sessckpt\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n17|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n18|)\n19|\n20|// runWorld binds real durable stores: the session chain with its\n21|// epoch-1 lease, a committed journal, a captured checkpoint, and an\n22|// empty binding store.\n23|type runWorld struct {\n24|\trepo     *sessrepo.Repository\n25|\trecordID string\n26|\theadID   string\n27|\tmat      *matjournal.Store\n28|\tckpt     *sessckpt.Store\n29|\tckptID   string\n30|\tpane     *Store\n31|\tpaneRoot string\n32|\tuniverse *backendUniverse\n33|}\n34|\n35|func buildRunWorld(t *testing.T) *runWorld {\n36|\tt.Helper()\n37|\tworld := &runWorld{universe: buildBackendUniverse(t, true)}\n38|\tworld.repo, world.recordID = chainFixture(t)\n39|\tevents, err := world.repo.ListEvents(fixtureSession)\n40|\tif err != nil {\n41|\t\tt.Fatal(err)\n42|\t}\n43|\tworld.headID = events[len(events)-1].EventID\n44|\tmatStore, err := matjournal.Open(t.TempDir())\n45|\tif err != nil {\n46|\t\tt.Fatal(err)\n47|\t}\n48|\tworld.mat = matStore\n49|\tjournalFixture(t, matStore)\n50|\tckptStore, err := sessckpt.Open(t.TempDir())\n51|\tif err != nil {\n52|\t\tt.Fatal(err)\n53|\t}\n54|\tworld.ckpt = ckptStore\n55|\tworld.ckptID, _ = checkpointFixture(t, world.repo, ckptStore, []string{world.headID})\n56|\tworld.paneRoot = t.TempDir()\n57|\tpaneStore, err := Open(world.paneRoot)\n58|\tif err != nil {\n59|\t\tt.Fatal(err)\n60|\t}\n61|\tworld.pane = paneStore\n62|\treturn world\n63|}\n64|\n65|func (world *runWorld) stores() Stores {\n66|\treturn Stores{Repo: world.repo, Mat: world.mat, Ckpt: world.ckpt, Pane: world.pane}\n67|}\n68|\n69|func configInputs(t *testing.T) (config.Inputs, config.Overrides) {\n70|\tt.Helper()\n71|\thome := t.TempDir()\n72|\tplatform, err := scalar.ParsePlatform(\"linux\")\n73|\tif err != nil {\n74|\t\tt.Fatal(err)\n75|\t}\n76|\tfor _, dir := range []string{\"config\", \"data\", \"state\", \"cache\", \"runtime\"} {\n77|\t\tif err := os.MkdirAll(home+\"/\"+dir, 0o755); err != nil {\n78|\t\t\tt.Fatal(err)\n79|\t\t}\n80|\t}\n81|\treturn config.Inputs{\n82|\t\t\tPlatform:   platform,\n83|\t\t\tHomeDir:    home,\n84|\t\t\tTempDir:    home,\n85|\t\t\tWorkingDir: home,\n86|\t\t\tLookupEnv:  func(string) (string, bool) { return \"\", false },\n87|\t\t\tStat:       func(path string) (fs.FileInfo, error) { return os.Stat(path) },\n88|\t\t\tReadFile:   os.ReadFile,\n89|\t\t}, config.Overrides{\n90|\t\t\tconfig.ConfigFile:  home + \"/config/config.toml\",\n91|\t\t\tconfig.DataRoot:    home + \"/data\",\n92|\t\t\tconfig.StateRoot:   home + \"/state\",\n93|\t\t\tconfig.CacheRoot:   home + \"/cache\",\n94|\t\t\tconfig.RuntimeRoot: home + \"/runtime\",\n95|\t\t}\n96|}\n97|\n98|func runObserve(now time.Time) fencing.ObserveInput {\n99|\tgrant, policy := fixtureGrant(now)\n100|\treturn fencing.ObserveInput{\n101|\t\tLocalHostID: fixtureLocalHost,\n102|\t\tVerified:    true,\n103|\t\tGrant:       grant,\n104|\t\tHasGrant:    true,\n105|\t\tPolicy:      policy,\n106|\t\tNow:         now,\n107|\t}\n108|}\n109|\n110|func runRequest(t *testing.T, world *runWorld) Request {\n111|\tt.Helper()\n112|\tinputs, overrides := configInputs(t)\n113|\treturn Request{\n114|\t\tSessionID:            fixtureSession,\n115|\t\tBootstrapOperationID: fixtureBootstrap,\n116|\t\tMode:                 ModeLaunch,\n117|\t\tConfigInputs:         inputs,\n118|\t\tConfigOverrides:      overrides,\n119|\t\tPresented:            fixturePresented(),\n120|\t\tObserve:              runObserve(fixtureNow()),\n121|\t\tProvider: ProviderFacts{\n122|\t\t\tBuild:    fixtureBuild(),\n123|\t\t\tIdentity: fixtureIdentity(t),\n124|\t\t},\n125|\t\tRealm: Realm{\n126|\t\t\tCaller:           CallerForeground,\n127|\t\t\tBrokerState:      \"broker-running\",\n128|\t\t\tServerGeneration: \"generation-alpha\",\n129|\t\t\tRemediation:      \"launch the aqua broker\",\n130|\t\t},\n131|\t\tBackend:     world.universe.facts(t),\n132|\t\tEntrypoint:  []string{\"ax\", \"pane\", fixtureSession},\n133|\t\tHostBinding: world.universe.hostBinding(),\n134|\t\tInteractive: true,\n135|\t\tColumns:     80,\n136|\t\tRows:        24,\n137|\t\tInstanceID:  fixtureInstance,\n138|\t\tLocalHostID: fixtureLocalHost,\n139|\t\tCreatedAt:   fixtureCreatedAt,\n140|\t}\n141|}\n142|\n143|func eventCount(t *testing.T, repository *sessrepo.Repository) int {\n144|\tt.Helper()\n145|\tevents, err := repository.ListEvents(fixtureSession)\n146|\tif err != nil {\n147|\t\tt.Fatal(err)\n148|\t}\n149|\treturn len(events)\n150|}\n151|\n152|func TestRunLaunchBinds(t *testing.T) {\n153|\tt.Parallel()\n154|\tworld := buildRunWorld(t)\n155|\toutcome, err := Run(world.stores(), runRequest(t, world))\n156|\tif err != nil {\n157|\t\tt.Fatalf(\"Run() error = %v\", err)\n158|\t}\n159|\tif outcome.Decision.Action != ActionLaunch {\n160|\t\tt.Fatalf(\"Run() action = %q, detail %q, cause %v, want launch\",\n161|\t\t\toutcome.Decision.Action, outcome.Decision.Detail, outcome.Decision.Cause)\n162|\t}\n163|\tif outcome.Binding == nil {\n164|\t\tt.Fatal(\"Run() launch binds no bootstrap pair\")\n165|\t}\n166|\tif outcome.Binding.OperationID != fixtureBootstrap || outcome.Binding.TerminalInstanceID != fixtureInstance {\n167|\t\tt.Fatalf(\"Run() binding = %+v\", outcome.Binding)\n168|\t}\n169|\tproven, found, err := world.pane.Status(fixtureSession)\n170|\tif err != nil || !found || proven != *outcome.Binding {\n171|\t\tt.Fatalf(\"Status() = (%+v, %v, %v), want the bound receipt\", proven, found, err)\n172|\t}\n173|\tif _, err := outcome.Decision.Token.Bind(fencing.ProviderQuiesce); err != nil {\n174|\t\tt.Fatalf(\"launch token bind error = %v\", err)\n175|\t}\n176|\tif outcome.Emitted {\n177|\t\tt.Fatal(\"Run() launch authors an event, want the binding only\")\n178|\t}\n179|}\n180|\n181|func TestRunReattaches(t *testing.T) {\n182|\tt.Parallel()\n183|\tworld := buildRunWorld(t)\n184|\tfirst, _, err := world.pane.Bind(fixtureSession, fixtureBootstrap, bindCandidate())\n185|\tif err != nil {\n186|\t\tt.Fatal(err)\n187|\t}\n188|\toutcome, err := Run(world.stores(), runRequest(t, world))\n189|\tif err != nil {\n190|\t\tt.Fatalf(\"Run() error = %v\", err)\n191|\t}\n192|\tif outcome.Decision.Action != ActionReattach {\n193|\t\tt.Fatalf(\"Run() action = %q, want reattach\", outcome.Decision.Action)\n194|\t}\n195|\tif outcome.Binding == nil || *outcome.Binding != first {\n196|\t\tt.Fatalf(\"Run() binding = %+v, want the recorded %+v\", outcome.Binding, first)\n197|\t}\n198|}\n199|\n200|func TestRunConcurrentLaunchReattaches(t *testing.T) {\n201|\tt.Parallel()\n202|\tworld := buildRunWorld(t)\n203|\trequest := runRequest(t, world)\n204|\twinner := bindCandidate()\n205|\twinner.TerminalInstanceID = \"0198f4c9-2222-7bbb-8bbb-1234567890ab\"\n206|\twinner.BindingDigest = BindingDigest(winner)\n207|\trequest.Hooks = &Hooks{\n208|\t\tAfterStage: func(path string) error {\n209|\t\t\tinner, err := Open(world.paneRoot)\n210|\t\t\tif err != nil {\n211|\t\t\t\treturn err\n212|\t\t\t}\n213|\t\t\t_, _, err = inner.Bind(fixtureSession, fixtureBootstrap, winner)\n214|\t\t\treturn err\n215|\t\t},\n216|\t}\n217|\toutcome, err := Run(world.stores(), request)\n218|\tif err != nil {\n219|\t\tt.Fatalf(\"Run() error = %v\", err)\n220|\t}\n221|\tif outcome.Decision.Action != ActionReattach {\n222|\t\tt.Fatalf(\"Run() action = %q, want reattach to the concurrent winner\", outcome.Decision.Action)\n223|\t}\n224|\tif outcome.Binding == nil || outcome.Binding.TerminalInstanceID != winner.TerminalInstanceID {\n225|\t\tt.Fatalf(\"Run() binding = %+v, want the winner's receipt\", outcome.Binding)\n226|\t}\n227|}\n228|\n229|func TestRunParkedEmits(t *testing.T) {\n230|\tt.Parallel()\n231|\tworld := buildRunWorld(t)\n232|\trequest := runRequest(t, world)\n233|\trequest.Observe.Verified = false\n234|\tbefore := eventCount(t, world.repo)\n235|\toutcome, err := Run(world.stores(), request)\n236|\tif err != nil {\n237|\t\tt.Fatalf(\"Run() error = %v\", err)\n238|\t}\n239|\tif outcome.Decision.Action != ActionParked {\n240|\t\tt.Fatalf(\"Run() action = %q, want parked\", outcome.Decision.Action)\n241|\t}\n242|\tif !outcome.Emitted || outcome.Event == nil {\n243|\t\tt.Fatal(\"Run() parked decision authors no event\")\n244|\t}\n245|\tif after := eventCount(t, world.repo); after != before+1 {\n246|\t\tt.Fatalf(\"Run() parked event count = %d, want %d\", after, before+1)\n247|\t}\n248|\tstored, err := world.repo.GetEvent(fixtureSession, outcome.Event.EventID)\n249|\tif err != nil {\n250|\t\tt.Fatal(err)\n251|\t}\n252|\tvar decoded struct {\n253|\t\tEventType string `json:\"event_type\"`\n254|\t\tLeaseID   string `json:\"lease_id\"`\n255|\t\tPayload   struct {\n256|\t\t\tReason string `json:\"reason\"`\n257|\t\t} `json:\"payload\"`\n258|\t}\n259|\tif err := json.Unmarshal(stored, &decoded); err != nil {\n260|\t\tt.Fatal(err)\n261|\t}\n262|\tif decoded.EventType != \"session.parked\" || decoded.LeaseID != fixtureLeaseA || decoded.Payload.Reason != \"restore_policy\" {\n263|\t\tt.Fatalf(\"parked event = %+v\", decoded)\n264|\t}\n265|\tif _, found, err := world.pane.Status(fixtureSession); err != nil || found {\n266|\t\tt.Fatalf(\"Status() after parked = (%v, %v), want no binding\", found, err)\n267|\t}\n268|}\n269|\n270|func TestRunTakeoverOfferEmitsParked(t *testing.T) {\n271|\tt.Parallel()\n272|\tworld := buildRunWorld(t)\n273|\tleases, err := world.repo.ListLeases(fixtureSession)\n274|\tif err != nil {\n275|\t\tt.Fatal(err)\n276|\t}\n277|\tif _, err := world.repo.CompareAndSwapLease(fixtureSession, sessrepo.LeaseExpectation{RecordID: leases[0].RecordID}, sessrepo.SuccessorLeaseInput{\n278|\t\tCreateLeaseInput: sessrepo.CreateLeaseInput{\n279|\t\t\tLeaseID:        fixtureLeaseB,\n280|\t\t\tHolderHostID:   fixtureRemoteHost,\n281|\t\t\tIssuedByHostID: fixtureRemoteHost,\n282|\t\t\tCreatedAt:      fixtureCreatedAt,\n283|\t\t},\n284|\t\tReason:       \"graceful_takeover\",\n285|\t\tCheckpointID: seedDigest(0xC9),\n286|\t}); err != nil {\n287|\t\tt.Fatalf(\"CompareAndSwapLease() error = %v\", err)\n288|\t}\n289|\toutcome, err := Run(world.stores(), runRequest(t, world))\n290|\tif err != nil {\n291|\t\tt.Fatalf(\"Run() error = %v\", err)\n292|\t}\n293|\tif outcome.Decision.Action != ActionTakeoverOffer {\n294|\t\tt.Fatalf(\"Run() action = %q, want takeover_offer\", outcome.Decision.Action)\n295|\t}\n296|\tif !outcome.Emitted || outcome.Event == nil {\n297|\t\tt.Fatal(\"Run() takeover offer authors no parked event\")\n298|\t}\n299|\tstored, err := world.repo.GetEvent(fixtureSession, outcome.Event.EventID)\n300|\tif err != nil {\n301|\t\tt.Fatal(err)\n302|\t}\n303|\tvar decoded struct {\n304|\t\tEventType string `json:\"event_type\"`\n305|\t\tPayload   struct {\n306|\t\t\tReason string `json:\"reason\"`\n307|\t\t} `json:\"payload\"`\n308|\t}\n309|\tif err := json.Unmarshal(stored, &decoded); err != nil {\n310|\t\tt.Fatal(err)\n311|\t}\n312|\tif decoded.EventType != \"session.parked\" || decoded.Payload.Reason != \"remote_owner\" {\n313|\t\tt.Fatalf(\"offer parked event = %+v\", decoded)\n314|\t}\n315|}\n316|\n317|func TestRunParkedWithoutWinnerSkipsEmission(t *testing.T) {\n318|\tt.Parallel()\n319|\tworld := buildRunWorld(t)\n320|\t// A session with no leases yet: remove the epoch-1 lease the\n321|\t// chain fixture installed by working on a lease-free sibling.\n322|\trepository, err := sessrepo.Open(t.TempDir())\n323|\tif err != nil {\n324|\t\tt.Fatal(err)\n325|\t}\n326|\tvar record map[string]any\n327|\tif err := json.Unmarshal([]byte(sessionRecordFixture), &record); err != nil {\n328|\t\tt.Fatal(err)\n329|\t}\n330|\tif _, err := repository.CreateSession(identifyObject(t, record, \"record_id\")); err != nil {\n331|\t\tt.Fatal(err)\n332|\t}\n333|\tworld.repo = repository\n334|\trequest := runRequest(t, world)\n335|\toutcome, err := Run(world.stores(), request)\n336|\tif err != nil {\n337|\t\tt.Fatalf(\"Run() error = %v\", err)\n338|\t}\n339|\tif outcome.Decision.Action != ActionParked {\n340|\t\tt.Fatalf(\"Run() action = %q, want parked\", outcome.Decision.Action)\n341|\t}\n342|\tif outcome.Emitted {\n343|\t\tt.Fatal(\"Run() parked without a winner authors an event, want none\")\n344|\t}\n345|}\n346|\n347|func TestRunRefusedWritesNothing(t *testing.T) {\n348|\tt.Parallel()\n349|\tworld := buildRunWorld(t)\n350|\trequest := runRequest(t, world)\n351|\trequest.Entrypoint = []string{\"codex\", \"--yolo\"}\n352|\tbefore := eventCount(t, world.repo)\n353|\toutcome, err := Run(world.stores(), request)\n354|\tif err != nil {\n355|\t\tt.Fatalf(\"Run() error = %v\", err)\n356|\t}\n357|\tif outcome.Decision.Action != ActionRefused || outcome.Decision.Class != terminalbackend.CodePreconditionFailed {\n358|\t\tt.Fatalf(\"Run() = (%q, %q), want refused local_precondition_failed\", outcome.Decision.Action, outcome.Decision.Class)\n359|\t}\n360|\tif outcome.Binding != nil || outcome.Emitted {\n361|\t\tt.Fatal(\"Run() refusal writes durable state\")\n362|\t}\n363|\tif _, found, err := world.pane.Status(fixtureSession); err != nil || found {\n364|\t\tt.Fatalf(\"Status() after refusal = (%v, %v), want absence\", found, err)\n365|\t}\n366|\tif after := eventCount(t, world.repo); after != before {\n367|\t\tt.Fatalf(\"event count = %d, want %d\", after, before)\n368|\t}\n369|}\n370|\n371|func TestRunIdempotencyMismatch(t *testing.T) {\n372|\tt.Parallel()\n373|\tworld := buildRunWorld(t)\n374|\tother := bindCandidate()\n375|\tother.OperationID = fixtureOtherOp\n376|\tif _, _, err := world.pane.Bind(fixtureSession, fixtureOtherOp, other); err != nil {\n377|\t\tt.Fatal(err)\n378|\t}\n379|\toutcome, err := Run(world.stores(), runRequest(t, world))\n380|\tif err != nil {\n381|\t\tt.Fatalf(\"Run() error = %v\", err)\n382|\t}\n383|\tif outcome.Decision.Action != ActionRefused || outcome.Decision.Class != terminalbackend.CodeIdempotencyMismatch {\n384|\t\tt.Fatalf(\"Run() = (%q, %q), want refused idempotency_mismatch\", outcome.Decision.Action, outcome.Decision.Class)\n385|\t}\n386|}\n387|\n388|func TestRunRestoreCommitted(t *testing.T) {\n389|\tt.Parallel()\n390|\tworld := buildRunWorld(t)\n391|\trequest := runRequest(t, world)\n392|\trequest.Mode = ModeRestore\n393|\trequest.MaterializationRequired = true\n394|\trequest.MaterializationID = fixtureMat\n395|\trequest.CheckpointRequired = true\n396|\trequest.CheckpointID = world.ckptID\n397|\toutcome, err := Run(world.stores(), request)\n398|\tif err != nil {\n399|\t\tt.Fatalf(\"Run() error = %v\", err)\n400|\t}\n401|\tif outcome.Decision.Action != ActionLaunch {\n402|\t\tt.Fatalf(\"Run() action = %q, detail %q, cause %v, want launch\",\n403|\t\t\toutcome.Decision.Action, outcome.Decision.Detail, outcome.Decision.Cause)\n404|\t}\n405|\tif outcome.Binding == nil {\n406|\t\tt.Fatal(\"Run() restore launch binds no bootstrap pair\")\n407|\t}\n408|}\n409|\n410|func TestRunRestoreMaterializingParks(t *testing.T) {\n411|\tt.Parallel()\n412|\tworld := buildRunWorld(t)\n413|\trequest := runRequest(t, world)\n414|\trequest.Mode = ModeRestore\n415|\trequest.MaterializationRequired = true\n416|\trequest.MaterializationID = \"0198f4c8-9a10-7b22-8b3c-1234567890ff\"\n417|\trequest.CheckpointRequired = true\n418|\trequest.CheckpointID = world.ckptID\n419|\toutcome, err := Run(world.stores(), request)\n420|\tif err != nil {\n421|\t\tt.Fatalf(\"Run() error = %v\", err)\n422|\t}\n423|\tif outcome.Decision.Action != ActionParked || outcome.Decision.ParkReason != fencing.ParkRestorePolicy {\n424|\t\tt.Fatalf(\"Run() = (%q, %q), want parked restore_policy\", outcome.Decision.Action, outcome.Decision.ParkReason)\n425|\t}\n426|}\n427|\n428|func TestRunUnknownSession(t *testing.T) {\n429|\tt.Parallel()\n430|\tworld := buildRunWorld(t)\n431|\trequest := runRequest(t, world)\n432|\trequest.SessionID = fixtureForeign\n433|\trequest.Entrypoint = []string{\"ax\", \"pane\", fixtureForeign}\n434|\toutcome, err := Run(world.stores(), request)\n435|\tif err != nil {\n436|\t\tt.Fatalf(\"Run() error = %v\", err)\n437|\t}\n438|\tif outcome.Decision.Action != ActionRefused || outcome.Decision.Class != ClassInvalidArguments {\n439|\t\tt.Fatalf(\"Run() = (%q, %q), want refused invalid_arguments\", outcome.Decision.Action, outcome.Decision.Class)\n440|\t}\n441|}\n442|\n443|func TestRunInvalidConfig(t *testing.T) {\n444|\tt.Parallel()\n445|\tworld := buildRunWorld(t)\n446|\trequest := runRequest(t, world)\n447|\trequest.ConfigOverrides = config.Overrides{\n448|\t\tconfig.ConfigFile: \"/nonexistent-axpane-dir-7f3a/config.toml\",\n449|\t}\n450|\toutcome, err := Run(world.stores(), request)\n451|\tif err != nil {\n452|\t\tt.Fatalf(\"Run() error = %v\", err)\n453|\t}\n454|\tif outcome.Decision.Action != ActionRefused || outcome.Decision.Class != ClassInvalidConfig {\n455|\t\tt.Fatalf(\"Run() = (%q, %q), want refused invalid_config\", outcome.Decision.Action, outcome.Decision.Class)\n456|\t}\n457|}\n458|\n459|func TestRunSmokeRequiredPasses(t *testing.T) {\n460|\tt.Parallel()\n461|\tworld := buildRunWorld(t)\n462|\trequest := runRequest(t, world)\n463|\trecord := smokeRecord(t, \"pass\", \"A\", passingSmokeChecks(), smokeTuple())\n464|\trequest.Smoke.Required = true\n465|\trequest.Smoke.Record = record\n466|\trequest.Smoke.Target = smokeTarget()\n467|\toutcome, err := Run(world.stores(), request)\n468|\tif err != nil {\n469|\t\tt.Fatalf(\"Run() error = %v\", err)\n470|\t}\n471|\tif outcome.Decision.Action != ActionLaunch {\n472|\t\tt.Fatalf(\"Run() action = %q, cause %v, want launch\", outcome.Decision.Action, outcome.Decision.Cause)\n473|\t}\n474|}\n475|\n476|func TestRunTornBindingPropagates(t *testing.T) {\n477|\tt.Parallel()\n478|\tworld := buildRunWorld(t)\n479|\tif _, _, err := world.pane.Bind(fixtureSession, fixtureBootstrap, bindCandidate()); err != nil {\n480|\t\tt.Fatal(err)\n481|\t}\n482|\tif err := os.WriteFile(world.pane.bindingPath(fixtureSession), []byte(`{\"torn\":true}`), 0o600); err != nil {\n483|\t\tt.Fatal(err)\n484|\t}\n485|\toutcome, err := Run(world.stores(), runRequest(t, world))\n486|\tif err == nil {\n487|\t\tt.Fatalf(\"Run() over torn binding succeeded with %+v, want the read error\", outcome.Decision)\n488|\t}\n489|\tif outcome.Decision.Action != \"\" {\n490|\t\tt.Fatalf(\"Run() over torn binding decides %q, want no decision\", outcome.Decision.Action)\n491|\t}\n492|}\n493|\n494|func TestObserveLoadsWinningLease(t *testing.T) {\n495|\tt.Parallel()\n496|\tworld := buildRunWorld(t)\n497|\tobservation, err := ObserveOwnership(world.repo, fixtureSession, runObserve(fixtureNow()))\n498|\tif err != nil {\n499|\t\tt.Fatalf(\"ObserveOwnership() error = %v\", err)\n500|\t}\n(more lines below)","final_result":true}}}
