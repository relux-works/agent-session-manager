{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d075","stream":{"kind":"session","id":"01a0b0c8-2197-71f2-b37c-575c8ab978c8"},"sequence":1685,"recorded_at":1780531400003365,"record_type":"event","durability":"durable","causation_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","run_stream":{"kind":"run","id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3"},"task_stream":{"kind":"task","id":"01a0b0d1-234f-7f02-9d47-43c8ff94bd20"},"task_id":"01a0b0d1-234f-7f02-9d47-43c8ff94bd20","event":{"kind":"output","task_id":"01a0b0d1-234f-7f02-9d47-43c8ff94bd20","chunk":"Read text file `internal/axpane/decide.go`.\n(504 line(s) above)\n505|// predicate reads only the winner's own HasCheckpoint; a caller\n506|// claim never closes the window.\n507|func bootstrapWindowClosed(observation fencing.Observation) bool {\n508|\treturn observation.HasWinner && observation.Winner.HasCheckpoint\n509|}\n510|\n511|// authorize selects the fencing entry by mode: activation for a\n512|// fresh launch, restore for the after-restore first start. Both are\n513|// launch-class entries: ownership that is remote, ambiguous,\n514|// unverified, or absent parks with the session.parked vocabulary,\n515|// while malformed calls, foreign sessions, and lapsed grants refuse.\n516|func authorize(input Input) (fencing.LeaseToken, error) {\n517|\tif input.Mode == ModeRestore {\n518|\t\treturn fencing.AuthorizeRestore(input.Presented, input.Observation)\n519|\t}\n520|\treturn fencing.AuthorizeActivation(input.Presented, input.Observation)\n521|}\n522|\n523|// admitBackend parses the §4.B identity documents through the\n524|// terminalbackend owner, reconciles the Probe against the Manifest\n525|// with the returned evidence bound to the AX-known raw generation,\n526|// and gates the mode operation against the admitted set. Only the\n527|// exact admitted capability rows authorize the action; no\n528|// capability map is invented here.\n529|func admitBackend(input Input) (terminalbackend.Admitted, error) {\n530|\tmanifest, err := terminalbackend.ParseManifest(input.Backend.Manifest)\n531|\tif err != nil {\n532|\t\treturn terminalbackend.Admitted{}, err\n533|\t}\n534|\tprobe, err := terminalbackend.ParseProbe(input.Backend.Probe)\n535|\tif err != nil {\n536|\t\treturn terminalbackend.Admitted{}, err\n537|\t}\n538|\tevidence := make([]terminalbackend.Evidence, 0, len(input.Backend.Evidence))\n539|\tfor _, doc := range input.Backend.Evidence {\n540|\t\tparsed, err := terminalbackend.ParseEvidence(doc)\n541|\t\tif err != nil {\n542|\t\t\treturn terminalbackend.Admitted{}, err\n543|\t\t}\n544|\t\tevidence = append(evidence, parsed)\n545|\t}\n546|\tadmitted, err := terminalbackend.Reconcile(manifest, probe, evidence, input.Backend.RawGeneration, input.Backend.Now, input.Backend.Verify)\n547|\tif err != nil {\n548|\t\treturn terminalbackend.Admitted{}, err\n549|\t}\n550|\toperation := \"create\"\n551|\tif input.Mode == ModeRestore {\n552|\t\toperation = \"restore\"\n553|\t}\n554|\tif err := terminalbackend.CheckOperation(operation, admitted); err != nil {\n555|\t\treturn terminalbackend.Admitted{}, err\n556|\t}\n557|\treturn admitted, nil\n558|}\n559|\n560|// admitCheckpoint admits the resume checkpoint through the sessrepo\n561|// attestation owner: the closed shape must verify and the computed\n562|// identity must equal the expected checkpoint digest.\n563|func admitCheckpoint(doc []byte, want string) error {\n564|\tif len(doc) == 0 {\n565|\t\treturn errCheckpointAbsent()\n566|\t}\n567|\tdigest, _, err := sessrepo.AttestCheckpointRecord(doc)\n568|\tif err != nil {\n569|\t\treturn err\n570|\t}\n571|\tif digest.String() != want {\n572|\t\treturn errCheckpointMismatch()\n573|\t}\n574|\treturn nil\n575|}\n576|\n577|// checkProviderIdentity composes the provhost resume gate: the exact\n578|// probed build tuple must pass the Section 8.4 direction, the stored\n579|// identity must validate for that provider at that exact version,\n580|// and the discovery proof, when present, must bind to the host-side\n581|// facts.\n582|func checkProviderIdentity(facts ProviderFacts) error {\n583|\tif err := provhost.CheckResumeTuple(facts.Build); err != nil {\n584|\t\treturn err\n585|\t}\n586|\tif err := provhost.VerifyIdentityBuild(facts.Identity, facts.Build); err != nil {\n587|\t\treturn err\n588|\t}\n589|\tif facts.HasDiscovery {\n590|\t\tif err := provhost.VerifyIdentityDiscovery(facts.Identity, facts.Discovery, facts.DiscoveryContext); err != nil {\n591|\t\t\treturn err\n592|\t\t}\n593|\t}\n594|\treturn nil\n595|}\n596|\n597|// checkSmoke enforces the provider-auth smoke precondition when the\n598|// path requires provider credentials. The stored record must verify\n599|// through the resumesmoke owner, its verdict must be pass, and its\n600|// exact claimed build must equal the probed build: a smoke result\n601|// for one build never authorizes another. A required smoke that is\n602|// absent, unverifiable, failing, or bound to another build refuses\n603|// target_auth_missing with the typed details Section 15.3 names.\n604|func checkSmoke(input Input) error {\n605|\tif !input.Smoke.Required {\n606|\t\treturn nil\n607|\t}\n608|\trecord, err := resumesmoke.VerifyRecord(input.Smoke.Record)\n609|\tif err != nil {\n610|\t\treturn smokeFailure(input, err)\n611|\t}\n612|\tif record.Verdict != resumesmoke.VerdictPass {\n613|\t\treturn smokeFailure(input, errSmokeVerdict(record.Verdict))\n614|\t}\n615|\tbuild := input.Provider.Build\n616|\tif record.Tuple.ProviderID != build.ProviderID ||\n617|\t\trecord.Tuple.ProviderVersion != build.ProviderVersion ||\n618|\t\trecord.Tuple.Platform != build.Platform ||\n619|\t\trecord.Tuple.Architecture != build.Architecture {\n620|\t\treturn smokeFailure(input, errSmokeTuple())\n621|\t}\n622|\treturn nil\n623|}\n624|\n625|// smokeFailure composes the typed target_auth_missing refusal. Typed\n626|// details are required members of the input: an input that omits\n627|// one is itself malformed and refuses invalid_arguments instead of\n628|// emitting an untyped refusal.\n629|func smokeFailure(input Input, cause error) error {\n630|\tfailure, err := axerror.NewTargetAuthMissing(axerror.Version130,\n631|\t\t\"provider-auth smoke did not pass for the probed build\",\n632|\t\taxerror.NoIDs(), input.Smoke.Target, cause)\n633|\tif err != nil {\n634|\t\treturn fmt.Errorf(\"%w: smoke refusal details are incomplete: %v\", errInvalidArguments{}, err)\n635|\t}\n636|\treturn failure\n637|}\n638|\n639|// checkRealm enforces the §4.2 background-caller rule: a background\n640|// caller may contact an already-running authenticated Aqua broker\n641|// and its attested AX tmux server, and otherwise returns\n642|// capability_unavailable with typed realm/readiness details. It\n643|// never falls back to direct server creation. A foreground caller\n644|// passes; there is no cached-sentinel or managername arm to pass\n645|// through, because neither authorizes resume. Typed details are\n646|// required input members: an input that omits one is itself\n647|// malformed and refuses invalid_arguments instead of emitting an\n648|// untyped capability_unavailable.\n649|func checkRealm(input Input) error {\n650|\tif input.Realm.Caller != CallerBackground {\n651|\t\treturn nil\n652|\t}\n653|\tif input.Realm.AttestedServer {\n654|\t\treturn nil\n655|\t}\n656|\tevidence := axerror.RealmEvidence{\n657|\t\tCapability:           \"credential_capable_execution_realm\",\n658|\t\tCallerRealm:          input.Realm.Caller,\n659|\t\tBrokerState:          input.Realm.BrokerState,\n660|\t\tTmuxServerGeneration: input.Realm.ServerGeneration,\n661|\t\tRemediation:          input.Realm.Remediation,\n662|\t}\n663|\tfailure, err := axerror.NewRealmEvidenceUnavailable(axerror.Version130,\n664|\t\t\"background caller has no attested tmux server\",\n665|\t\taxerror.NoIDs(), evidence, errNoAttestedServer())\n666|\tif err != nil {\n667|\t\treturn errInvalidArguments{detail: \"background caller realm details are incomplete\"}\n668|\t}\n669|\treturn failure\n670|}\n671|\n672|// checkRealmVocabulary closes the caller vocabulary: only\n673|// foreground and background name a caller.\n674|func checkRealmVocabulary(caller string) error {\n675|\tif caller != CallerForeground && caller != CallerBackground {\n676|\t\treturn errUnknownCaller(caller)\n677|\t}\n678|\treturn nil\n679|}\n680|\n681|// backendClass reads the Section 15 code off a terminalbackend\n682|// refusal. Landed codes pass through verbatim.\n683|func backendClass(err error) string {\n684|\tvar backend *terminalbackend.Error\n685|\tif errors.As(err, &backend) {\n686|\t\treturn backend.Code\n687|\t}\n688|\treturn terminalbackend.CodeMismatch\n689|}\n690|\n691|// fencingClass reads the Section 15 class off a fencing refusal:\n692|// invalid_arguments for malformed calls, lease_conflict for\n693|// foreign sessions and lapsed grants. Parks never reach here;\n694|// decideParked owns them.\n695|func fencingClass(err error) string {\n696|\tif errors.Is(err, fencing.ErrInvalidArguments) {\n697|\t\treturn ClassInvalidArguments\n698|\t}\n699|\treturn \"lease_conflict\"\n700|}\n701|\n702|// providerClass reads the Structured Error code off a provhost\n703|// refusal: invalid_config for tuple and mapping grammar, the\n704|// provider protocol code for identity and discovery failures.\n705|func providerClass(err error) string {\n706|\tvar failure *axerror.Error\n707|\tif errors.As(err, &failure) {\n708|\t\treturn string(failure.Code())\n709|\t}\n710|\treturn ClassInvalidConfig\n711|}\n712|\n713|// smokeClass reads the Structured Error code off a smoke refusal:\n714|// target_auth_missing for a required smoke that fails, or\n715|// invalid_arguments for a malformed smoke input.\n716|func smokeClass(err error) string {\n717|\tvar failure *axerror.Error\n718|\tif errors.As(err, &failure) {\n719|\t\treturn string(failure.Code())\n720|\t}\n721|\tvar malformed errInvalidArguments\n722|\tif errors.As(err, &malformed) {\n723|\t\treturn ClassInvalidArguments\n724|\t}\n725|\treturn \"target_auth_missing\"\n726|}","final_result":true}}}
