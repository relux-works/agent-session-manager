{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d13b","stream":{"kind":"session","id":"01a0b0c8-2197-71f2-b37c-575c8ab978c8"},"sequence":1784,"recorded_at":1780531400003563,"record_type":"event","durability":"durable","causation_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","run_stream":{"kind":"run","id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3"},"task_stream":{"kind":"task","id":"01a0b0d1-b9df-7f20-ad95-d9222617ee29"},"task_id":"01a0b0d1-b9df-7f20-ad95-d9222617ee29","event":{"kind":"output","task_id":"01a0b0d1-b9df-7f20-ad95-d9222617ee29","chunk":"Read text file `internal/axpane/errors.go`.\n1|package axpane\n2|\n3|import \"fmt\"\n4|\n5|// Wrapper errors are static, narrow causes: they name the failed\n6|// member and the violated rule, never credentials, generations,\n7|// native references, or terminal output. Landed-gate errors pass\n8|// through as the decision Cause unchanged; these exist only for the\n9|// wrapper's own composition arms.\n10|\n11|type errInvalidArguments struct{ detail string }\n12|\n13|func (err errInvalidArguments) Error() string { return \"invalid_arguments: \" + err.detail }\n14|\n15|type errWrapperMode string\n16|\n17|func (mode errWrapperMode) Error() string {\n18|\treturn fmt.Sprintf(\"wrapper mode %q is not launch or restore\", string(mode))\n19|}\n20|\n21|type errUnknownSession string\n22|\n23|func (session errUnknownSession) Error() string {\n24|\treturn fmt.Sprintf(\"logical session %q is unknown\", string(session))\n25|}\n26|\n27|type errIdempotencyChanged string\n28|\n29|func (session errIdempotencyChanged) Error() string {\n30|\treturn fmt.Sprintf(\"bootstrap operation for session %q changed inside the bootstrap window\", string(session))\n31|}\n32|\n33|type errMaterializationState struct {\n34|\tphase    string\n35|\tadmitted bool\n36|}\n37|\n38|func (err errMaterializationState) Error() string {\n39|\tif !err.admitted {\n40|\t\treturn \"required materialization is not admitted\"\n41|\t}\n42|\treturn fmt.Sprintf(\"required materialization is in phase %q, want committed\", err.phase)\n43|}\n44|\n45|func errMaterializationNotValid(phase string, admitted bool) error {\n46|\treturn errMaterializationState{phase: phase, admitted: admitted}\n47|}\n48|\n49|type errCheckpoint struct{ detail string }\n50|\n51|func (err errCheckpoint) Error() string { return err.detail }\n52|\n53|func errCheckpointAbsent() error {\n54|\treturn errCheckpoint{detail: \"resume requires a checkpoint and none is admitted\"}\n55|}\n56|\n57|func errCheckpointMismatch() error {\n58|\treturn errCheckpoint{detail: \"admitted checkpoint identity does not match the required checkpoint\"}\n59|}\n60|\n61|type errSmoke struct{ detail string }\n62|\n63|func (err errSmoke) Error() string { return err.detail }\n64|\n65|func errSmokeVerdict(verdict any) error {\n66|\treturn errSmoke{detail: fmt.Sprintf(\"provider-auth smoke verdict is %v, want pass\", verdict)}\n67|}\n68|\n69|func errSmokeTuple() error {\n70|\treturn errSmoke{detail: \"provider-auth smoke binds another probed build\"}\n71|}\n72|\n73|type errNoAttestedServerValue struct{}\n74|\n75|func (err errNoAttestedServerValue) Error() string {\n76|\treturn \"no attested tmux server is available to a background caller\"\n77|}\n78|\n79|func errNoAttestedServer() error { return errNoAttestedServerValue{} }\n80|\n81|type errUnknownCaller string\n82|\n83|func (caller errUnknownCaller) Error() string {\n84|\treturn fmt.Sprintf(\"caller realm %q is not foreground or background\", string(caller))\n85|}","final_result":true}}}
