{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d623","stream":{"kind":"session","id":"01a0b0c8-2197-71f2-b37c-575c8ab978c8"},"sequence":2412,"recorded_at":1780531400004819,"record_type":"event","durability":"durable","causation_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","run_stream":{"kind":"run","id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3"},"task_stream":{"kind":"task","id":"01a0b0d4-c1cd-7dc0-9e9d-e224fe5811a7"},"task_id":"01a0b0d4-c1cd-7dc0-9e9d-e224fe5811a7","event":{"kind":"output","task_id":"01a0b0d4-c1cd-7dc0-9e9d-e224fe5811a7","chunk":"Read text file `internal/axpane/fixtures_test.go`.\n(87 line(s) above)\n88|// --- backend identity fixtures ---\n89|\n90|// claimRows transcribes the §4.D registry rows this package needs,\n91|// copied from the specification table rather than from production,\n92|// so row drift fails.\n93|func claimRows() map[string]map[string]any {\n94|\treturn map[string]map[string]any{\n95|\t\t\"durable_disconnect\": {\n96|\t\t\t\"generation_variable\":   false,\n97|\t\t\t\"dependent_operations\":  []any{\"create\", \"status\"},\n98|\t\t\t\"evidence_requirements\": []any{\"conformance_fixture\", \"runtime_probe\"},\n99|\t\t},\n100|\t\t\"headless_creation\": {\n101|\t\t\t\"generation_variable\":   true,\n102|\t\t\t\"dependent_operations\":  []any{\"create\"},\n103|\t\t\t\"evidence_requirements\": []any{\"conformance_fixture\", \"runtime_probe\"},\n104|\t\t},\n105|\t\t\"reboot_restoration\": {\n106|\t\t\t\"generation_variable\":   true,\n107|\t\t\t\"dependent_operations\":  []any{\"restore\"},\n108|\t\t\t\"evidence_requirements\": []any{\"conformance_fixture\", \"runtime_probe\"},\n109|\t\t},\n110|\t\t\"local_attach\": {\n111|\t\t\t\"generation_variable\":   true,\n112|\t\t\t\"dependent_operations\":  []any{\"attach\"},\n113|\t\t\t\"evidence_requirements\": []any{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n114|\t\t},\n115|\t}\n116|}\n117|\n118|func claimMap(capability, origin string, value bool) map[string]any {\n119|\trow := claimRows()[capability]\n120|\treturn map[string]any{\n121|\t\t\"capability\":            capability,\n122|\t\t\"origin\":                origin,\n123|\t\t\"value\":                 value,\n124|\t\t\"generation_variable\":   row[\"generation_variable\"],\n125|\t\t\"dependent_operations\":  row[\"dependent_operations\"],\n126|\t\t\"evidence_requirements\": row[\"evidence_requirements\"],\n127|\t}\n128|}\n129|\n130|func omitSelfIdentity(t *testing.T, object map[string]any, selfField string) string {\n131|\tt.Helper()\n132|\tomitted := make(map[string]any, len(object))\n133|\tfor name, member := range object {\n134|\t\tif name != selfField {\n135|\t\t\tomitted[name] = member\n136|\t\t}\n137|\t}\n138|\tserialized, err := json.Marshal(omitted)\n139|\tif err != nil {\n140|\t\tt.Fatalf(\"marshal omit-self object: %v\", err)\n141|\t}\n142|\tcanonical, err := jcs.Transform(serialized)\n143|\tif err != nil {\n144|\t\tt.Fatalf(\"canonicalize omit-self object: %v\", err)\n145|\t}\n146|\tsum := sha256.Sum256(canonical)\n147|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n148|}\n149|\n150|func evidenceMessage(t *testing.T, object map[string]any) []byte {\n151|\tt.Helper()\n152|\tomitted := make(map[string]any, len(object))\n153|\tfor name, member := range object {\n154|\t\tif name != \"evidence_id\" && name != \"attestation_signature\" {\n155|\t\t\tomitted[name] = member\n156|\t\t}\n157|\t}\n158|\tserialized, err := json.Marshal(omitted)\n159|\tif err != nil {\n160|\t\tt.Fatalf(\"marshal unsigned evidence: %v\", err)\n161|\t}\n162|\tcanonical, err := jcs.Transform(serialized)\n163|\tif err != nil {\n164|\t\tt.Fatalf(\"canonicalize unsigned evidence: %v\", err)\n165|\t}\n166|\tmessage := append([]byte(\"ax-terminal-capability-evidence-v1\"), 0x00)\n167|\treturn append(message, canonical...)\n168|}\n169|\n170|// backendUniverse is one coherent admission world: a builtin ax.tmux\n171|// manifest with static true claims, its probe, and the evidence set\n172|// proving the true claims. attachAdmitted selects whether the probe\n173|// carries local_attach true (remote attach offered) or false\n174|// (takeover offered instead).\n175|type backendUniverse struct {\n176|\trawGeneration string\n177|\tmanifest      map[string]any\n178|\tprobe         map[string]any\n179|\tevidence      []map[string]any\n180|\tverify        terminalbackend.SignatureVerifier\n181|\tnow           time.Time\n182|}\n183|\n184|func buildBackendUniverse(t *testing.T, attachAdmitted bool) *backendUniverse {\n185|\tt.Helper()\n186|\tkey, err := rsa.GenerateKey(rand.Reader, 1024)\n187|\tif err != nil {\n188|\t\tt.Fatalf(\"generate attestation key: %v\", err)\n189|\t}\n190|\tuniverse := &backendUniverse{\n191|\t\trawGeneration: \"generation-alpha\",\n192|\t\tnow:           time.Date(2026, time.January, 20, 0, 0, 0, 0, time.UTC),\n193|\t\tverify: func(issuerID string, message, signature []byte) error {\n194|\t\t\tdigest := sha256.Sum256(message)\n195|\t\t\treturn rsa.VerifyPKCS1v15(&key.PublicKey, crypto.SHA256, digest[:], signature)\n196|\t\t},\n197|\t}\n198|\tgenerationDigest, err := terminalbackend.GenerationDigest(universe.rawGeneration)\n199|\tif err != nil {\n200|\t\tt.Fatalf(\"GenerationDigest() error = %v\", err)\n201|\t}\n202|\tfixtureID := seedDigest(0xF1)\n203|\tuniverse.manifest = map[string]any{\n204|\t\t\"schema\":                 terminalbackend.SchemaManifest,\n205|\t\t\"schema_version\":         \"1.0.0\",\n206|\t\t\"manifest_id\":            \"\",\n207|\t\t\"terminal_backend_id\":    terminalbackend.BuiltinTmux,\n208|\t\t\"implementation_version\": \"2.1.0\",\n209|\t\t\"protocol_versions\":      []any{\"1.0.0\", \"1.1.0\"},\n210|\t\t\"platforms\":              []any{\"linux\", \"macos\", \"wsl2\"},\n211|\t\t\"implementation_kind\":    \"builtin_go\",\n212|\t\t\"executable_digest\":      nil,\n213|\t\t\"static_capability_claims\": []any{\n214|\t\t\tclaimMap(\"durable_disconnect\", \"static\", true),\n215|\t\t\tclaimMap(\"headless_creation\", \"static\", true),\n216|\t\t\tclaimMap(\"local_attach\", \"static\", true),\n217|\t\t\tclaimMap(\"reboot_restoration\", \"static\", true),\n218|\t\t},\n219|\t\t\"conformance_fixture_id\": fixtureID,\n220|\t\t\"extensions\":             map[string]any{},\n221|\t}\n222|\tuniverse.manifest[\"manifest_id\"] = omitSelfIdentity(t, universe.manifest, \"manifest_id\")\n223|\n224|\tprobeClaims := []any{\n225|\t\tclaimMap(\"durable_disconnect\", \"static\", true),\n226|\t\tclaimMap(\"headless_creation\", \"probed\", true),\n227|\t\tclaimMap(\"local_attach\", \"probed\", attachAdmitted),\n(more lines below)","final_result":true}}}
