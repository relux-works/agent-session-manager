{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9b7","stream":{"kind":"session","id":"01a0b0c8-2197-71f2-b37c-575c8ab978c8"},"sequence":822,"recorded_at":1780531400001639,"record_type":"event","durability":"durable","causation_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","run_stream":{"kind":"run","id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3"},"task_stream":{"kind":"task","id":"01a0b0ca-7772-7b41-8706-689cd3ae79d8"},"task_id":"01a0b0ca-7772-7b41-8706-689cd3ae79d8","event":{"kind":"output","task_id":"01a0b0ca-7772-7b41-8706-689cd3ae79d8","chunk":"Read text file `internal/axpane/events_test.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n9|)\n10|\n11|func bindingFacts() TerminalBindingFacts {\n12|\treturn TerminalBindingFacts{\n13|\t\tBindingDigest:         seedDigest(0xB1),\n14|\t\tBackendID:             \"ax.tmux\",\n15|\t\tImplementationVersion: \"2.1.0\",\n16|\t\tProtocolVersion:       \"1.1.0\",\n17|\t\tProtocolVersions:      []string{\"1.0.0\", \"1.1.0\"},\n18|\t\tEvidenceIDs:           []string{seedDigest(0xE0), seedDigest(0xE1)},\n19|\t}\n20|}\n21|\n22|func TestParkedPayloadVocabulary(t *testing.T) {\n23|\tt.Parallel()\n24|\tfor _, reason := range []fencing.ParkReason{\n25|\t\tfencing.ParkRemoteOwner, fencing.ParkStaleOwner, fencing.ParkRestorePolicy, fencing.ParkFailedHandoff,\n26|\t} {\n27|\t\tpayload, err := ParkedPayload(reason, fixtureLeaseA)\n28|\t\tif err != nil {\n29|\t\t\tt.Fatalf(\"ParkedPayload(%q) error = %v\", string(reason), err)\n30|\t\t}\n31|\t\tif payload[\"reason\"] != string(reason) || payload[\"winning_lease_id\"] != fixtureLeaseA {\n32|\t\t\tt.Fatalf(\"ParkedPayload(%q) = %v\", string(reason), payload)\n33|\t\t}\n34|\t\tif len(payload) != 2 {\n35|\t\t\tt.Fatalf(\"ParkedPayload(%q) carries %d members, want exactly 2\", string(reason), len(payload))\n36|\t\t}\n37|\t}\n38|\tif _, err := ParkedPayload(fencing.ParkReason(\"bogus\"), fixtureLeaseA); err == nil {\n39|\t\tt.Fatal(\"ParkedPayload(bogus) succeeded, want refusal\")\n40|\t}\n41|\tif _, err := ParkedPayload(fencing.ParkRemoteOwner, \"not-a-lease\"); err == nil {\n42|\t\tt.Fatal(\"ParkedPayload(bad lease) succeeded, want refusal\")\n43|\t}\n44|}\n45|\n46|func TestTerminalCreatedPayload(t *testing.T) {\n47|\tt.Parallel()\n48|\tpayload, err := TerminalCreatedPayload(bindingFacts())\n49|\tif err != nil {\n50|\t\tt.Fatalf(\"TerminalCreatedPayload() error = %v\", err)\n51|\t}\n52|\twant := map[string]any{\n53|\t\t\"terminal_binding_id\":    seedDigest(0xB1),\n54|\t\t\"terminal_backend_id\":    \"ax.tmux\",\n55|\t\t\"implementation_version\": \"2.1.0\",\n56|\t\t\"protocol_version\":       \"1.1.0\",\n57|\t\t\"evidence_ids\":           []string{seedDigest(0xE0), seedDigest(0xE1)},\n58|\t}\n59|\traw, _ := json.Marshal(payload)\n60|\tvar decoded map[string]any\n61|\tif err := json.Unmarshal(raw, &decoded); err != nil {\n62|\t\tt.Fatal(err)\n63|\t}\n64|\tif len(decoded) != len(want) {\n65|\t\tt.Fatalf(\"TerminalCreatedPayload() members = %v, want exactly %v\", decoded, want)\n66|\t}\n67|\tfor name, value := range want {\n68|\t\tround, _ := json.Marshal(decoded[name])\n69|\t\texpect, _ := json.Marshal(value)\n70|\t\tif string(round) != string(expect) {\n71|\t\t\tt.Fatalf(\"TerminalCreatedPayload()[%q] = %s, want %s\", name, round, expect)\n72|\t\t}\n73|\t}\n74|\tcases := []struct {\n75|\t\tname   string\n76|\t\tmutate func(*TerminalBindingFacts)\n77|\t}{\n78|\t\t{\"bad digest\", func(facts *TerminalBindingFacts) { facts.BindingDigest = \"nope\" }},\n79|\t\t{\"bad backend\", func(facts *TerminalBindingFacts) { facts.BackendID = \"Bogus!\" }},\n80|\t\t{\"bad versions\", func(facts *TerminalBindingFacts) { facts.ProtocolVersion = \"2.0.0\" }},\n81|\t\t{\"empty evidence\", func(facts *TerminalBindingFacts) { facts.EvidenceIDs = nil }},\n82|\t\t{\"unsorted evidence\", func(facts *TerminalBindingFacts) {\n83|\t\t\tfacts.EvidenceIDs = []string{seedDigest(0xE1), seedDigest(0xE0)}\n84|\t\t}},\n85|\t\t{\"bad evidence digest\", func(facts *TerminalBindingFacts) { facts.EvidenceIDs = []string{\"nope\"} }},\n86|\t}\n87|\tfor _, testCase := range cases {\n88|\t\tt.Run(testCase.name, func(t *testing.T) {\n89|\t\t\tt.Parallel()\n90|\t\t\tfacts := bindingFacts()\n91|\t\t\ttestCase.mutate(&facts)\n92|\t\t\tif _, err := TerminalCreatedPayload(facts); err == nil {\n93|\t\t\t\tt.Fatalf(\"TerminalCreatedPayload(%s) succeeded, want refusal\", testCase.name)\n94|\t\t\t}\n95|\t\t})\n96|\t}\n97|}\n98|\n99|func TestResumedPayload(t *testing.T) {\n100|\tt.Parallel()\n101|\tpayload, err := ResumedPayload(seedDigest(0xC9), \"yolo\", seedDigest(0xCA), true, bindingFacts())\n102|\tif err != nil {\n103|\t\tt.Fatalf(\"ResumedPayload() error = %v\", err)\n104|\t}\n105|\tif payload[\"checkpoint_id\"] != seedDigest(0xC9) || payload[\"execution_profile\"] != \"yolo\" || payload[\"profile_source_event_id\"] != seedDigest(0xCA) {\n106|\t\tt.Fatalf(\"ResumedPayload() = %v\", payload)\n107|\t}\n108|\tif len(payload) != 8 {\n109|\t\tt.Fatalf(\"ResumedPayload() carries %d members, want exactly 8\", len(payload))\n110|\t}\n111|\tnullSource, err := ResumedPayload(seedDigest(0xC9), \"standard\", \"\", false, bindingFacts())\n112|\tif err != nil {\n113|\t\tt.Fatalf(\"ResumedPayload(null source) error = %v\", err)\n114|\t}\n115|\tif nullSource[\"profile_source_event_id\"] != nil {\n116|\t\tt.Fatalf(\"ResumedPayload(null source) source = %v, want null\", nullSource[\"profile_source_event_id\"])\n117|\t}\n118|\tif _, err := ResumedPayload(\"nope\", \"standard\", \"\", false, bindingFacts()); err == nil {\n119|\t\tt.Fatal(\"ResumedPayload(bad checkpoint) succeeded, want refusal\")\n120|\t}\n121|\tif _, err := ResumedPayload(seedDigest(0xC9), \"bogus\", \"\", false, bindingFacts()); err == nil {\n122|\t\tt.Fatal(\"ResumedPayload(bad profile) succeeded, want refusal\")\n123|\t}\n124|\tif _, err := ResumedPayload(seedDigest(0xC9), \"yolo\", \"nope\", true, bindingFacts()); err == nil {\n125|\t\tt.Fatal(\"ResumedPayload(bad source) succeeded, want refusal\")\n126|\t}\n127|}\n128|\n129|// TestEmitParkedRoundTrip authors the parked event for a Decide\n130|// parked outcome through the sessrepo owner under the current\n131|// lease, then reads it back: the envelope lease repeats the\n132|// winner and the payload carries the exact closed members.\n133|func TestEmitParkedRoundTrip(t *testing.T) {\n134|\tt.Parallel()\n135|\tdeps := buildDecideDeps(t, true)\n136|\tinput := validInput(t, deps)\n137|\tinput.Observation.Verified = false\n138|\tdecision := Decide(input)\n139|\tif decision.Action != ActionParked {\n140|\t\tt.Fatalf(\"Decide() action = %q, want parked\", decision.Action)\n141|\t}\n142|\trecordID, tail, err := ChainTail(deps.repo, fixtureSession)\n143|\tif err != nil {\n144|\t\tt.Fatalf(\"ChainTail() error = %v\", err)\n145|\t}\n146|\t_ = recordID\n147|\treference, raw, err := EmitParked(deps.repo, decision, EmitParams{\n148|\t\tSessionID:     fixtureSession,\n149|\t\tCreatedByHost: fixtureLocalHost,\n150|\t\tLeaseEpoch:    input.Observation.Winner.Epoch,\n151|\t\tLeaseID:       input.Observation.Winner.LeaseID,\n152|\t\tLeaseSequence: tail.LeaseSequence + 1,\n153|\t\tPredecessors:  []string{tail.EventID},\n154|\t\tCreatedAt:     fixtureCreatedAt,\n155|\t})\n156|\tif err != nil {\n157|\t\tt.Fatalf(\"EmitParked() error = %v\", err)\n158|\t}\n159|\tstored, err := deps.repo.GetEvent(fixtureSession, reference.EventID)\n160|\tif err != nil {\n161|\t\tt.Fatalf(\"GetEvent() error = %v\", err)\n162|\t}\n163|\tif string(stored) != string(raw) {\n164|\t\tt.Fatal(\"GetEvent() bytes differ from the emitted bytes\")\n165|\t}\n166|\tvar decoded struct {\n167|\t\tSchemaVersion string `json:\"schema_version\"`\n168|\t\tEventType     string `json:\"event_type\"`\n169|\t\tLeaseEpoch    uint64 `json:\"lease_epoch\"`\n170|\t\tLeaseID       string `json:\"lease_id\"`\n171|\t\tPayload       struct {\n172|\t\t\tReason       string `json:\"reason\"`\n173|\t\t\tWinningLease string `json:\"winning_lease_id\"`\n174|\t\t} `json:\"payload\"`\n175|\t}\n176|\tif err := json.Unmarshal(stored, &decoded); err != nil {\n177|\t\tt.Fatal(err)\n178|\t}\n179|\tif decoded.SchemaVersion != \"1.0.0\" || decoded.EventType != \"session.parked\" {\n180|\t\tt.Fatalf(\"emitted event = (%q, %q), want (1.0.0, session.parked)\", decoded.SchemaVersion, decoded.EventType)\n181|\t}\n182|\tif decoded.LeaseEpoch != 1 || decoded.LeaseID != fixtureLeaseA {\n183|\t\tt.Fatalf(\"emitted lease = (%d, %q), want the winner\", decoded.LeaseEpoch, decoded.LeaseID)\n184|\t}\n185|\tif decoded.Payload.Reason != \"restore_policy\" || decoded.Payload.WinningLease != fixtureLeaseA {\n186|\t\tt.Fatalf(\"emitted payload = %+v, want the parked vocabulary\", decoded.Payload)\n187|\t}\n188|}\n189|\n190|func TestEmitTerminalV4RoundTrip(t *testing.T) {\n191|\tt.Parallel()\n192|\trepository, _ := chainFixture(t)\n193|\tevents, err := repository.ListEvents(fixtureSession)\n194|\tif err != nil {\n195|\t\tt.Fatal(err)\n196|\t}\n197|\ttail := events[len(events)-1]\n198|\tcreated, err := TerminalCreatedPayload(bindingFacts())\n199|\tif err != nil {\n200|\t\tt.Fatal(err)\n201|\t}\n202|\treference, _, err := Emit(repository, EmitParams{\n203|\t\tSessionID: fixtureSession, CreatedByHost: fixtureLocalHost,\n204|\t\tLeaseEpoch: 1, LeaseID: fixtureLeaseA, LeaseSequence: tail.LeaseSequence + 1,\n205|\t\tPredecessors: []string{tail.EventID}, CreatedAt: fixtureCreatedAt,\n206|\t\tEventType: \"terminal.created\", SchemaVersion: \"4.0.0\", Payload: created,\n207|\t})\n208|\tif err != nil {\n209|\t\tt.Fatalf(\"Emit(terminal.created v4) error = %v\", err)\n210|\t}\n211|\tresumed, err := ResumedPayload(seedDigest(0xC9), \"standard\", \"\", false, bindingFacts())\n212|\tif err != nil {\n213|\t\tt.Fatal(err)\n214|\t}\n215|\tsecond, _, err := Emit(repository, EmitParams{\n216|\t\tSessionID: fixtureSession, CreatedByHost: fixtureLocalHost,\n217|\t\tLeaseEpoch: 1, LeaseID: fixtureLeaseA, LeaseSequence: tail.LeaseSequence + 2,\n218|\t\tPredecessors: []string{reference.EventID}, CreatedAt: fixtureCreatedAt,\n219|\t\tEventType: \"session.resumed\", SchemaVersion: \"4.0.0\", Payload: resumed,\n220|\t})\n221|\tif err != nil {\n222|\t\tt.Fatalf(\"Emit(session.resumed v4) error = %v\", err)\n223|\t}\n224|\tfor _, eventID := range []string{reference.EventID, second.EventID} {\n225|\t\tstored, err := repository.GetEvent(fixtureSession, eventID)\n226|\t\tif err != nil {\n227|\t\t\tt.Fatalf(\"GetEvent() error = %v\", err)\n228|\t\t}\n229|\t\tvar decoded struct {\n230|\t\t\tSchemaVersion string `json:\"schema_version\"`\n231|\t\t}\n232|\t\tif err := json.Unmarshal(stored, &decoded); err != nil {\n233|\t\t\tt.Fatal(err)\n234|\t\t}\n235|\t\tif decoded.SchemaVersion != \"4.0.0\" {\n236|\t\t\tt.Fatalf(\"emitted schema_version = %q, want 4.0.0\", decoded.SchemaVersion)\n237|\t\t}\n238|\t}\n239|}\n240|\n241|func TestEmitParkedRefusesNonParked(t *testing.T) {\n242|\tt.Parallel()\n243|\tdeps := buildDecideDeps(t, true)\n244|\tdecision := Decide(validInput(t, deps))\n245|\tif decision.Action != ActionLaunch {\n246|\t\tt.Fatalf(\"Decide() action = %q, want launch\", decision.Action)\n247|\t}\n248|\tif _, _, err := EmitParked(deps.repo, decision, EmitParams{}); err == nil {\n249|\t\tt.Fatal(\"EmitParked(launch) succeeded, want refusal\")\n250|\t}\n251|\tvar _ = sessrepo.EventRef{}\n252|}","final_result":true}}}
