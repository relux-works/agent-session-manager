\\\\t\\\\treturn empty, err\\\\n\\\\t\\\\t}\\\\n\\\",\\n\\\"\\\\t\\\\tobserved, err := ObserveOwnership(stores.Repo, request.SessionID, request.Observe)\\\\n\\\\t\\\\tif err != nil {\\\\n\\\\t\\\\t\\\\tobserved = fencing.Observation{SessionID: request.SessionID}\\\\n\\\\t\\\\t}\\\\n\\\",\\n\\\"TestRunTornLeasePropagates\\\")\\n# RM4\\nrun_mut(\\\"RM4\\\", \\\"internal/axpane/decide.go\\\",\\n\\\"\\\\tif input.ExistingBinding != nil && input.ExistingBinding.OperationID != input.BootstrapOperationID && !bootstrapWindowClosed(input.Observation) {\\\\n\\\",\\n\\\"\\\\tif input.ExistingBinding != nil && input.ExistingBinding.OperationID != input.BootstrapOperationID && !bootstrapWindowClosed(input.Observation) && input.Mode == ModeLaunch {\\\\n\\\",\\n\\\"TestDecideRestoreChangedOperationRefuses\\\")\\nPY\\nPYTHONDONTWRITEBYTECODE=1 python3 /tmp/check_rm.py 2>&1 | tail -n 20\",\n  \"description\": \"Check RM1 and RM4 killed\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"RM1: exit=1 killed=True run=TestRunTornLeasePropagates\\nRM4: exit=1 killed=True run=TestDecideRestoreChangedOperationRefuses\\n\",\n  \"original_output_bytes\": 124,\n  \"original_output_tokens\": 31,\n  \"truncated\": false\n}","final_result":true}}}
