Frames(t *testing.T) {\\ninternal/sessckpt/refusal_test.go:349:func TestAdmitRefusesSameEpochForeignLeaseHead(t *testing.T) {\\ninternal/sessrepo/checkpoint.go:22:func AttestCheckpointRecord(raw []byte) (scalar.Digest, canonicaljson.SelfField, error) {\\ninternal/sessrepo/lease_store.go:476:func CheckFencingExpiry(grant FencingGrant, policy FencingPolicy, now time.Time) error {\\ninternal/sessrepo/lease.go:23:func AttestLeaseRecord(raw []byte) (scalar.Digest, canonicaljson.SelfField, error) {\\n===sessckpt store Get===\\npackage sessckpt\\n\\nimport (\\n\\t\\\"errors\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"os\\\"\\n\\t\\\"path/filepath\\\"\\n\\t\\\"runtime\\\"\\n\\t\\\"sync\\\"\\n\\n\\t\\\"github.com/relux-works/agent-session-manager/internal/scalar\\\"\\n)\\n\\n// ErrInvalidCheckpoint reports a checkpoint closure that must be\\n// refused before publication. It always wraps\\n// canonicaljson.ErrInvalidIdentity, so errors.Is proves the SPEC\\n// Section 5.4 incompatible_schema class for every unpublishable\\n// closure, including the CP-N1..CP-N4 fixtures.\\nvar ErrInvalidCheckpoint = errors.New(\\\"invalid checkpoint closure\\\")\\n\\n// ErrCheckpointConflict reports the idempotency boundary: the same\\n// capture operation retried with moved inputs\\n// (idempotency_mismatch), or a digest path holding bytes that\\n// disagree with the installing candidate (a torn store, never a\\n// second version of an immutable record).\\nvar ErrCheckpointConflict = errors.New(\\\"checkpoint capture conflict\\\")\\n\\n// Store durably installs Checkpoint Records and their operation\\n// receipts under one data root. Checkpoint blobs are\\n// content-addressed and installed no-replace, so capture is\\n// append-only by construction and there is no update or delete\\n// entry to test.\\n//\\n// BeforeWrite fires after validation and before the first durable\\n// byte; AfterBlob fires after the checkpoint blob is durable and\\n// before the operation receipt; AfterCommit fires after the receipt\\n// is durable. All three are nil in normal operation. Tests connect\\n// them to a secconftest Injector firing the owner's own points: a\\n// fault before any durable byte carries safe_retry, a fault past\\n// any durable step carries recoverable_parked_state until the\\n// identical retry replays the recorded result, and a fault past\\n// the receipt carries safe_retry through the replayed receipt.\\ntype Store struct {\\n\\troot        string\\n\\tmutex       sync.Mutex\\n\\tBeforeWrite func() error\\n\\tAfterBlob   func() error\\n\\tAfterCommit func() error\\n}\\n\\n// Open binds a checkpoint store to the checkpoints namespace beneath\\n// dataRoot, creating it owner-only when absent. The root must be\\n// absolute.\\nfunc Open(dataRoot string) (*Store, error) {\\n\\tif !filepath.IsAbs(dataRoot) {\\n\\t\\treturn nil, fmt.Errorf(\\\"%w: data root %q is not absolute\\\", ErrInvalidCheckpoint, dataRoot)\\n\\t}\\n\\troot := filepath.Join(dataRoot, \\\"checkpoints\\\")\\n\\tif err := os.MkdirAll(root, 0o700); err != nil {\\n\\t\\treturn nil, fmt.Errorf(\\\"create checkpoints root %q: %w\\\", root, err)\\n\\t}\\n\\t// The operations namespace shares the root so one data-root\\n\\t// fsync discipline covers blobs and receipts together.\\n\\tif err := os.MkdirAll(filepath.Join(root, \\\"operations\\\"), 0o700); err != nil {\\n\\t\\treturn nil, fmt.Errorf(\\\"create checkpoint operations root: %w\\\", err)\\n\\t}\\n\\treturn &Store{root: root}, nil\\n}\\n\\n// CheckpointRef names one durably installed Checkpoint Record: its\\n// canonical digest and the operation receipt that installed it.\\ntype CheckpointRef struct {\\n\\tCheckpointID string\\n\\tOperationID  string\\n}\\n\\n// checkpointFileName maps a validated checkpoint digest to its blob\\n// file name. The digest passed scalar grammar before install;\\n// invalid input maps to a sentinel name that can never collide\\n// with a real blob.\\nfunc checkpointFileName(checkpointID string) string {\\n\\tdigest, err := scalar.ParseDigest(checkpointID)\\n\\tif err != nil {\\n\\t\\treturn \\\"invalid.json\\\"\\n\\t}\\n\\treturn digest.Hex() + \\\".json\\\"\\n}\\n\\n// operationFileName maps a validated operation UUID to its receipt\\n// file name. UUIDv7 grammar keeps the file name an exact,\\n// case-stable rendering of the operation identity.\\nfunc operationFileName(operationID string) string {\\n\\tid, err := scalar.ParseUUIDv7(operationID)\\n\\tif err != nil {\\n\\t\\treturn \\\"invalid.json\\\"\\n\\t}\\n\\treturn id.String() + \\\".json\\\"\\n}\\n\\n// installBlob installs one content-addressed blob idempotently\\n// through the no-replace open first: a fresh path is created\\n// atomically, and only an EEXIST loser falls back to comparing\\n// against the winner's bytes — identical bytes are reused,\\n// disagreeing bytes report the torn store for refusal. Leading\\n// with the exclusive create (instead of stat-then-act) keeps the\\n// no-replace property a filesystem fact under a second process,\\n// not a check-then-act race the store mutex cannot see: the mutex\\n// serializes one process, while O_EXCL serializes all of them.\\nfunc installBlob(path string, data []byte) error {\\n\\tif err := writeExclusive(path, data); err == nil {\\n\\t\\treturn syncDirectory(filepath.Dir(path))\\n\\t} else if !os.IsExist(err) {\\n\\t\\treturn fmt.Errorf(\\\"install checkpoint blob: %w\\\", err)\\n\\t}\\n\\texisting, readErr := os.ReadFile(path)\\n\\tif readErr != nil {\\n\\t\\treturn fmt.Errorf(\\\"read checkpoint blob for compare: %w\\\", readErr)\\n\\t}\\n\\tif string(existing) != string(data) {\\n\\t\\treturn fmt.Errorf(\\\"%w: digest path holds disagreeing bytes\\\", ErrCheckpointConflict)\\n\\t}\\n\\treturn nil\\n}\\n\\n// writeExclusive installs bytes at a path that must not exist. The\\n// no-replace open makes append-only a filesystem property, not a\\n// convention. Bytes fsync before close so a crash never leaves a\\n// torn prefix behind.\\nfunc writeExclusive(path string, data []byte) error {\\n\\tfile, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600)\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif _, err := file.Write(data); err != nil {\\n\\t\\t_ = file.Close()\\n\\t\\treturn fmt.Errorf(\\\"write exclusive file: %w\\\", err)\\n\\t}\\n\\tif err := file.Sync(); err != nil {\\n\\t\\t_ = file.Close()\\n\\t\\treturn fmt.Errorf(\\\"fsync exclusive file: %w\\\", err)\\n\\t}\\n\\tif err := file.Close(); err != nil {\\n\\t\\treturn fmt.Errorf(\\\"close exclusive file: %w\\\", err)\\n\\t}\\n\\treturn nil\\n}\\n\\n// syncDirectory fsyncs a directory so an install inside it survives\\n// a crash. Opening a directory fails on Windows, where the install\\n// itself is the durability boundary; there the sync is skipped,\\n// never faked.\\nfunc syncDirectory(path string) error {\\n\\tif runtime.GOOS == \\\"windows\\\" {\\n\\t\\treturn nil\\n\\t}\\n\\tdirectory, err := os.Open(path)\\n\\tif err != nil {\\n\\t\\treturn fmt.Errorf(\\\"open directory for fsync: %w\\\", err)\\n\\t}\\n\\tdefer func() { _ = directory.Close() }()\\n\\tif err := directory.Sync(); err != nil {\\n\\t\\treturn fmt.Errorf(\\\"fsync directory: %w\\\", err)\\n\\t}\\n\\treturn nil\\n}\\n===sessstate Reduce transitions===\\ninternal/sessstate/arms_test.go:136:// TestReduceRefusesContinuityVectors drives every chain-continuity arm\\ninternal/sessstate/arms_test.go:138:func TestReduceRefusesContinuityVectors(t *testing.T) {\\ninternal/sessstate/arms_test.go:152:\\t\\t_, err := Reduce(Input{Record: record, Events: []Event{event}})\\ninternal/sessstate/arms_test.go:153:\\t\\tmustErrorIs(t, err, ErrInvalidTransition, \\\"Reduce(zero sequence)\\\")\\ninternal/sessstate/arms_test.go:159:\\t\\t_, err := Reduce(Input{Record: record, Events: []Event{event}})\\ninternal/sessstate/arms_test.go:160:\\t\\tmustErrorIs(t, err, ErrInvalidTransition, \\\"Reduce(no predecessors)\\\")\\ninternal/sessstate/arms_test.go:165:\\t\\t_, err := Reduce(Input{Record: record, Events: []Event{event}})\\ninternal/sessstate/arms_test.go:166:\\t\\tmustErrorIs(t, err, ErrInvalidTransition, \\\"Reduce(first links extras)\\\")\\ninternal/sessstate/arms_test.go:171:\\t\\t_, err := Reduce(Input{Record: record, Events: []Event{event}})\\ninternal/sessstate/arms_test.go:172:\\t\\tmustErrorIs(t, err, ErrInvalidTransition, \\\"Reduce(first opens past one)\\\")\\ninternal/sessstate/arms_test.go:176:\\t\\t_, err := Reduce(Input{Record: record, Events: append(append([]Event{}, events...), event)})\\ninternal/sessstate/arms_test.go:177:\\t\\tmustErrorIs(t, err, ErrInvalidTransition, \\\"Reduce(gap)\\\")\\ninternal/sessstate/arms_test.go:181:\\t\\t_, err := Reduce(Input{Record: record, Events: append(append([]Event{}, events...), event)})\\ninternal/sessstate/arms_test.go:182:\\t\\tmustErrorIs(t, err, ErrInvalidTransition, \\\"Reduce(successor restarts past one)\\\")\\ninternal/sessstate/arms_test.go:186:\\t\\t_, err := Reduce(Input{Record: record, Events: append(append([]Event{}, events...), event)})\\ninternal/sessstate/arms_test.go:187:\\t\\tmustErrorIs(t, err, ErrInvalidTransition, \\\"Reduce(omits prior head)\\\")\\ninternal/sessstate/arms_test.go:192:\\t\\t_, err := Reduce(Input{Record: record, Events: []Event{event}})\\ninternal/sessstate/arms_test.go:193:\\t\\tmustErrorIs(t, err, ErrInvalidEvent, \\\"Reduce(unregistered version)\\\")\\ninternal/sessstate/arms_test.go:196:\\t\\t_, err := Reduce(Input{Record: Record{}, Events: events})\\ninternal/sessstate/arms_test.go:197:\\t\\tmustErrorIs(t, err, ErrInvalidRecord, \\\"Reduce(empty record)\\\")\\ninternal/sessstate/arms_test.go:201:\\t\\t_, err := Reduce(Input{Record: record, Events: []Event{event}})\\ninternal/sessstate/arms_test.go:202:\\t\\tmustErrorIs(t, err, ErrInvalidTransition, \\\"Reduce(stopped opens chain)\\\")\\ninternal/sessstate/arms_test.go:206:\\t\\t_, err := Reduce(Input{Record: record, Events: []Event{event}})\\ninternal/sessstate/arms_test.go:207:\\t\\tmustErrorIs(t, err, ErrInvalidTransition, \\\"Reduce(checkpoint opens chain)\\\")\\ninternal/sessstate/arms_test.go:211:// TestReduceRefusesDerivationVectors drives every payload-derivation\\ninternal/sessstate/arms_test.go:214:func TestReduceRefusesDerivationVectors(t *testing.T) {\\ninternal/sessstate/arms_test.go:231:\\t\\t_, err := Reduce(Input{Record: record, Events: append(append([]Event{}, headEvents...), event)})\\ninternal/sessstate/arms_test.go:263:\\t\\t\\t// task_board vectors need the creating bootstrap only: the\\ninternal/sessstate/arms_test.go:270:\\t\\t\\t\\t_, err := Reduce(Input{Record: record, Events: append(append([]Event{}, created...), event)})\\ninternal/sessstate/arms_test.go:271:\\t\\t\\t\\tmustErrorIs(t, err, ErrDerivation, \\\"Reduce(\\\"+tc.name+\\\")\\\")\\ninternal/sessstate/arms_test.go:279:\\t\\t\\t\\tmustErrorIs(t, err, ErrIntegrity, \\\"Reduce(\\\"+tc.name+\\\")\\\")\\ninternal/sessstate/arms_test.go:282:\\t\\t\\tmustErrorIs(t, err, ErrDerivation, \\\"Reduce(\\\"+tc.name+\\\")\\\")\\ninternal/sessstate/arms_test.go:287:// TestReduceRefusesUnionVectors drives the union-input arms: an empty\\ninternal/sessstate/arms_test.go:289:func TestReduceRefusesUnionVectors(t *testing.T) {\\ninternal/sessstate/arms_test.go:297:\\t\\tmustErrorIs(t, err, ErrInvalidEvent, \\\"Reduce(union empty lease)\\\")\\ninternal/sessstate/arms_test.go:301:\\t\\tmustErrorIs(t, err, ErrInvalidEvent, \\\"Reduce(union malformed lease)\\\")\\ninternal/sessstate/arms_test.go:305:// TestReduceEmptyChainValidatesUnion requires the empty-chain path to\\ninternal/sessstate/arms_test.go:308:// union moves only the reported winner and leaves state creating.\\ninternal/sessstate/arms_test.go:309:func TestReduceEmptyChainValidatesUnion(t *testing.T) {\\ninternal/sessstate/arms_test.go:312:\\t\\t_, err := Reduce(Input{Record: record, Union: []LeaseHead{{Epoch: 4, LeaseID: \\\"not-a-uuid\\\"}, {}}})\\ninternal/sessstate/arms_test.go:313:\\t\\tmustErrorIs(t, err, ErrInvalidEvent, \\\"Reduce(empty chain malformed union)\\\")\\ninternal/sessstate/arms_test.go:316:\\t\\t_, err := Reduce(Input{Record: record, Union: []LeaseHead{{Epoch: 1, LeaseID: \\\"nope\\\"}}})\\ninternal/sessstate/arms_test.go:317:\\t\\tmustErrorIs(t, err, ErrInvalidEvent, \\\"Reduce(empty chain malformed union)\\\")\\ninternal/sessstate/arms_test.go:319:\\tt.Run(\\\"well-formed union keeps creating\\\", func(t *testing.T) {\\ninternal/sessstate/arms_test.go:320:\\t\\tprojection, err := Reduce(Input{Record: record, Union: []LeaseHead{{Epoch: 3, LeaseID: testLeaseIDC}}})\\ninternal/sessstate/arms_test.go:322:\\t\\t\\tt.Fatalf(\\\"Reduce error = %v\\\", err)\\ninternal/sessstate/arms_test.go:325:\\t\\t\\tt.Fatalf(\\\"state = %q, want creating: the union never rewrites authoritative state\\\", projection.State)\\ninternal/sessstate/arms_test.go:335:\\t\\tprojection, err := Reduce(Input{Record: record})\\ninternal/sessstate/arms_test.go:337:\\t\\t\\tt.Fatalf(\\\"Reduce error = %v\\\", err)\\ninternal/sessstate/arms_test.go:340:\\t\\t\\tt.Fatalf(\\\"state = %q, want creating\\\", projection.State)\\ninternal/sessstate/census_plants_test.go:232:\\t\\trows := map[string]struct{}{\\\"creating\\\": {}, \\\"no-such-state\\\": {}}\\ninternal/sessstate/census_plants_test.go:233:\\t\\tderived := map[string]struct{}{\\\"creating\\\": {}}\\ninternal/sessstate/census_plants_test.go:255:// These plants remain wired into Reduce -> apply -> effect. They are not\\ninternal/sessstate/census_plants_test.go:453:\\t\\t\\t\\tif results[\\\"behavior\\\"] == 0 || !strings.Contains(outputs[\\\"behavior\\\"], \\\"--- FAIL: TestReduceTreatsUnknownV1TypeAsInert\\\") {\\ninternal/sessstate/census_plants_test.go:467:\\t\\t\\t\\t// and proves the control changes Reduce, not a dead helper.\\ninternal/sessstate/census_state_test.go:44:\\t\\t\\\"decode.go:212\\\":    \\\"TestReduceRefusesDerivationVectors/string_absent\\\",\\ninternal/sessstate/census_state_test.go:45:\\t\\t\\\"decode.go:216\\\":    \\\"TestReduceRefusesDerivationVectors/