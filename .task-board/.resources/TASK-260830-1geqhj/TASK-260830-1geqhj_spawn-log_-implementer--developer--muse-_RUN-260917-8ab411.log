{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000e065","stream":{"kind":"session","id":"01a0b0c8-2197-71f2-b37c-575c8ab978c8"},"sequence":3725,"recorded_at":1780531400007445,"record_type":"event","durability":"durable","causation_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","run_stream":{"kind":"run","id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3"},"task_stream":{"kind":"task","id":"01a0b0e2-6c69-7621-87aa-a1161b967118"},"task_id":"01a0b0e2-6c69-7621-87aa-a1161b967118","event":{"kind":"output","task_id":"01a0b0e2-6c69-7621-87aa-a1161b967118","chunk":"{\n  \"chunk_id\": \"exec-56-1\",\n  \"command\": \"cat > /tmp/check_rm2.py <<'PY'\\nimport shutil, subprocess, tempfile\\nfrom pathlib import Path\\nREPO = Path(\\\".\\\")\\ntarget = REPO / \\\"internal/axpane/decide.go\\\"\\norig = target.read_text()\\n# RM2: move materialization block before authorize\\nmat_block = \\\"\\\\tif input.MaterializationRequired {\\\\n\\\\t\\\\tif err := checkMaterialization(input); err != nil {\\\\n\\\\t\\\\t\\\\treturn parked(fencing.ParkRestorePolicy, input.Observation.Winner.LeaseID, err)\\\\n\\\\t\\\\t}\\\\n\\\\t}\\\\n\\\"\\nif orig.count(mat_block) != 1:\\n    print(f\\\"mat anchors {orig.count(mat_block)}\\\")\\nelse:\\n    patched = orig.replace(mat_block, \\\"\\\")\\n    anchor = \\\"\\\\ttoken, err := authorize(input)\\\\n\\\"\\n    assert patched.count(anchor)==1\\n    patched = patched.replace(anchor, mat_block+anchor)\\n    with tempfile.TemporaryDirectory() as td:\\n        bak = Path(td)/\\\"bak\\\"\\n        shutil.copy2(target, bak)\\n        try:\\n            target.write_text(patched)\\n            r = subprocess.run([\\\"go\\\",\\\"test\\\",\\\"./internal/axpane/\\\",\\\"-run\\\",\\\"TestDecideRemoteOwnerPrecedesMaterialization\\\",\\\"-count=1\\\"], cwd=REPO, capture_output=True, text=True, timeout=300)\\n        finally:\\n            shutil.copy2(bak, target)\\n    out = r.stdout+r.stderr\\n    killed = r.returncode!=0 and (\\\"--- FAIL\\\" in out or \\\"FAIL:\\\" in out)\\n    print(f\\\"RM2: exit={r.returncode} killed={killed}\\\")\\n    if not killed:\\n        print(out[:3000])\\nPY\\nPYTHONDONTWRITEBYTECODE=1 python3 /tmp/check_rm2.py 2>&1 | tail -n 20\",\n  \"description\": \"Check RM2 killed\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"RM2: exit=1 killed=True\\n\",\n  \"original_output_bytes\": 24,\n  \"original_output_tokens\": 6,\n  \"truncated\": false\n}","final_result":true}}}
