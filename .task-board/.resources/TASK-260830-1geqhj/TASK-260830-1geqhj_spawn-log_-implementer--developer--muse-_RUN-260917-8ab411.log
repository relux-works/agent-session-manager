{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c917","stream":{"kind":"session","id":"01a0b0c8-2197-71f2-b37c-575c8ab978c8"},"sequence":742,"recorded_at":1780531400001479,"record_type":"event","durability":"durable","causation_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","run_stream":{"kind":"run","id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3"},"task_stream":{"kind":"task","id":"01a0b0ca-5418-7172-97ea-b923f1810136"},"task_id":"01a0b0ca-5418-7172-97ea-b923f1810136","event":{"kind":"output","task_id":"01a0b0ca-5418-7172-97ea-b923f1810136","chunk":"Read text file `internal/axpane/decide_test.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"reflect\"\n6|\t\"sort\"\n7|\t\"testing\"\n8|\t\"time\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/matjournal\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/sessckpt\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n17|)\n18|\n19|// decideDeps carries the heavy fixtures one table row may need:\n20|// the backend universe (mutable before facts are drawn), a real\n21|// session chain, and a real captured checkpoint.\n22|type decideDeps struct {\n23|\tuniverse  *backendUniverse\n24|\trepo      *sessrepo.Repository\n25|\trecordID  string\n26|\tcreatedID string\n27|\tckptID    string\n28|\tckptDoc   []byte\n29|}\n30|\n31|func buildDecideDeps(t *testing.T, attachAdmitted bool) *decideDeps {\n32|\tt.Helper()\n33|\tdeps := &decideDeps{universe: buildBackendUniverse(t, attachAdmitted)}\n34|\tdeps.repo, deps.recordID = chainFixture(t)\n35|\tevents, err := deps.repo.ListEvents(fixtureSession)\n36|\tif err != nil {\n37|\t\tt.Fatal(err)\n38|\t}\n39|\tdeps.createdID = events[len(events)-1].EventID\n40|\tckptStore, err := sessckpt.Open(t.TempDir())\n41|\tif err != nil {\n42|\t\tt.Fatal(err)\n43|\t}\n44|\tdeps.ckptID, deps.ckptDoc = checkpointFixture(t, deps.repo, ckptStore, []string{deps.createdID})\n45|\treturn deps\n46|}\n47|\n48|// validInput returns the ModeLaunch base that launches: every gate\n49|// passes through its landed owner with real documents.\n50|func validInput(t *testing.T, deps *decideDeps) Input {\n51|\tt.Helper()\n52|\tnow := fixtureNow()\n53|\tdescriptor, err := BuildDescriptor(DescriptorParams{\n54|\t\tBinding: BindingRef{\n55|\t\t\tBindingDigest:         deps.universe.hostBinding().TerminalBindingID,\n56|\t\t\tBackendID:             deps.universe.hostBinding().BackendID,\n57|\t\t\tImplementationVersion: deps.universe.hostBinding().ImplementationVersion,\n58|\t\t\tProtocolVersion:       deps.universe.hostBinding().ProtocolVersion,\n59|\t\t\tGeneration:            deps.universe.hostBinding().Generation,\n60|\t\t},\n61|\t\tInstanceID:  fixtureInstance,\n62|\t\tInteractive: true,\n63|\t\tColumns:     80,\n64|\t\tRows:        24,\n65|\t})\n66|\tif err != nil {\n67|\t\tt.Fatalf(\"BuildDescriptor() error = %v\", err)\n68|\t}\n69|\trecord, events, err := LoadProfile(deps.repo, fixtureSession)\n70|\tif err != nil {\n71|\t\tt.Fatalf(\"LoadProfile() error = %v\", err)\n72|\t}\n73|\treturn Input{\n74|\t\tSessionID:            fixtureSession,\n75|\t\tBootstrapOperationID: fixtureBootstrap,\n76|\t\tMode:                 ModeLaunch,\n77|\t\tSessionKnown:         true,\n78|\t\tPresented:            fixturePresented(),\n79|\t\tObservation:          fixtureObservation(now),\n80|\t\tBackend:              deps.universe.facts(t),\n81|\t\tProfileRecord:        record,\n82|\t\tProfileEvents:        events,\n83|\t\tProvider: ProviderFacts{\n84|\t\t\tBuild:    fixtureBuild(),\n85|\t\t\tIdentity: fixtureIdentity(t),\n86|\t\t},\n87|\t\tRealm: Realm{\n88|\t\t\tCaller:           CallerForeground,\n89|\t\t\tBrokerState:      \"broker-running\",\n90|\t\t\tServerGeneration: \"generation-alpha\",\n91|\t\t\tRemediation:      \"launch the aqua broker\",\n92|\t\t},\n93|\t\tEntrypoint:  []string{\"ax\", \"pane\", fixtureSession},\n94|\t\tDescriptor:  descriptor,\n95|\t\tHostBinding: deps.universe.hostBinding(),\n96|\t}\n97|}\n98|\n99|func lapsedObservation(now time.Time) fencing.Observation {\n100|\tobservation := fixtureObservation(now)\n101|\tobservation.Grant.ValidatedAt = now.Add(-2 * time.Hour)\n102|\treturn observation\n103|}\n104|\n105|func TestDecideLaunchPositive(t *testing.T) {\n106|\tt.Parallel()\n107|\tdeps := buildDecideDeps(t, true)\n108|\tdecision := Decide(validInput(t, deps))\n109|\tif decision.Action != ActionLaunch {\n110|\t\tt.Fatalf(\"Decide() action = %q, detail %q, cause %v, want launch\", decision.Action, decision.Detail, decision.Cause)\n111|\t}\n112|\tif !decision.HasToken {\n113|\t\tt.Fatal(\"Decide() launch carries no fencing token\")\n114|\t}\n115|\tbound, err := decision.Token.Bind(fencing.ProviderQuiesce)\n116|\tif err != nil {\n117|\t\tt.Fatalf(\"Token.Bind(quiesce) error = %v\", err)\n118|\t}\n119|\tif bound.SessionID != fixtureSession || bound.Epoch != 1 || bound.LeaseID != fixtureLeaseA {\n120|\t\tt.Fatalf(\"Token.Bind(quiesce) = %+v, want the winning triple\", bound)\n121|\t}\n122|\tif decision.Profile.Profile != \"standard\" || decision.Profile.HasSource {\n123|\t\tt.Fatalf(\"Decide() profile = %+v, want standard with no source\", decision.Profile)\n124|\t}\n125|\tif decision.Mapping != \"\" {\n126|\t\tt.Fatalf(\"Decide() mapping = %q, want empty for standard\", decision.Mapping)\n127|\t}\n128|\tif !decision.Admitted.Has(\"headless_creation\") {\n129|\t\tt.Fatalf(\"Decide() admitted = %v, want headless_creation\", decision.Admitted.Capabilities)\n130|\t}\n131|\tif decision.Descriptor.TerminalInstanceID != fixtureInstance {\n132|\t\tt.Fatalf(\"Decide() descriptor instance = %q, want the supplied instance\", decision.Descriptor.TerminalInstanceID)\n133|\t}\n134|}\n135|\n136|// TestDecideRestoreRequiresRestoreCapability pins the mode-selected\n137|// capability row: a backend admitting restore but not create\n138|// launches in restore mode. Forcing the create row (the N-backend-op\n139|// mutant) refuses capability_unproven instead.\n140|func TestDecideRestoreRequiresRestoreCapability(t *testing.T) {\n141|\tt.Parallel()\n142|\tdeps := buildDecideDeps(t, true)\n143|\tdrop := map[string]bool{\"durable_disconnect\": true, \"headless_creation\": true}\n144|\tkeepClaims := func(claims []any) []any {\n145|\t\tkept := make([]any, 0, len(claims))\n146|\t\tfor _, raw := range claims {\n147|\t\t\tif !drop[raw.(map[string]any)[\"capability\"].(string)] {\n148|\t\t\t\tkept = append(kept, raw)\n149|\t\t\t}\n150|\t\t}\n151|\t\treturn kept\n152|\t}\n153|\tdeps.universe.manifest[\"static_capability_claims\"] = keepClaims(deps.universe.manifest[\"static_capability_claims\"].([]any))\n154|\tdeps.universe.probe[\"capability_claims\"] = keepClaims(deps.universe.probe[\"capability_claims\"].([]any))\n155|\tkeptEvidence := deps.universe.evidence[:0]\n156|\tfor _, object := range deps.universe.evidence {\n157|\t\tif !drop[object[\"capability\"].(string)] {\n158|\t\t\tkeptEvidence = append(keptEvidence, object)\n159|\t\t}\n160|\t}\n161|\tdeps.universe.evidence = keptEvidence\n162|\tvar ids []any\n163|\tfor _, object := range deps.universe.evidence {\n164|\t\tids = append(ids, object[\"evidence_id\"])\n165|\t}\n166|\tsort.Slice(ids, func(i, j int) bool { return ids[i].(string) < ids[j].(string) })\n167|\tdeps.universe.probe[\"evidence_ids\"] = ids\n168|\tdeps.universe.manifest[\"manifest_id\"] = omitSelfIdentity(t, deps.universe.manifest, \"manifest_id\")\n169|\tdeps.universe.probe[\"probe_id\"] = omitSelfIdentity(t, deps.universe.probe, \"probe_id\")\n170|\tinput := validInput(t, deps)\n171|\tinput.Mode = ModeRestore\n172|\tdecision := Decide(input)\n173|\tif decision.Action != ActionLaunch {\n174|\t\tt.Fatalf(\"Decide() restore action = %q, cause %v, want launch\", decision.Action, decision.Cause)\n175|\t}\n176|\tif !decision.Admitted.Has(\"reboot_restoration\") {\n177|\t\tt.Fatalf(\"Decide() admitted = %v, want reboot_restoration\", decision.Admitted.Capabilities)\n178|\t}\n179|}\n180|\n181|func TestDecideYoloMapping(t *testing.T) {\n182|\tt.Parallel()\n183|\tdeps := buildDecideDeps(t, true)\n184|\tappendChainEvent(t, deps.repo, \"profile.changed\", 1, fixtureLeaseA, 2, deps.createdID, map[string]any{\n185|\t\t\"from\": \"standard\", \"to\": \"yolo\", \"confirmed\": true,\n186|\t})\n187|\tinput := validInput(t, deps)\n188|\tdecision := Decide(input)\n189|\tif decision.Action != ActionLaunch {\n190|\t\tt.Fatalf(\"Decide() action = %q, detail %q, cause %v, want launch\", decision.Action, decision.Detail, decision.Cause)\n191|\t}\n192|\tif decision.Profile.Profile != \"yolo\" || !decision.Profile.HasSource {\n193|\t\tt.Fatalf(\"Decide() profile = %+v, want yolo with a source\", decision.Profile)\n194|\t}\n195|\tif decision.Mapping != \"--dangerously-bypass-approvals-and-sandbox\" {\n196|\t\tt.Fatalf(\"Decide() mapping = %q, want the codex yolo flag\", decision.Mapping)\n197|\t}\n198|}\n199|\n200|func TestDecideTable(t *testing.T) {\n201|\tt.Parallel()\n202|\tnow := fixtureNow()\n203|\tcommitted := matjournal.Journal{Phase: matjournal.PhaseCommitted}\n204|\tstaging := matjournal.Journal{Phase: matjournal.PhaseStaging}\n205|\n206|\ttype row struct {\n207|\t\tname        string\n208|\t\tattachProbe bool\n209|\t\tuniverse    func(t *testing.T, universe *backendUniverse)\n210|\t\tmutate      func(t *testing.T, deps *decideDeps, input *Input)\n211|\t\twant        Action\n212|\t\twantClass   string\n213|\t\twantReason  fencing.ParkReason\n214|\t\twantLease   string\n215|\t}\n216|\trows := []row{\n217|\t\t{\n218|\t\t\tname: \"launch_restore_committed_checkpoint\",\n219|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n220|\t\t\t\tinput.Mode = ModeRestore\n221|\t\t\t\tinput.MaterializationRequired = true\n222|\t\t\t\tinput.Journal = committed\n223|\t\t\t\tinput.JournalOK = true\n224|\t\t\t\tinput.CheckpointRequired = true\n225|\t\t\t\tinput.CheckpointDoc = deps.ckptDoc\n226|\t\t\t\tinput.CheckpointID = deps.ckptID\n227|\t\t\t},\n228|\t\t\twant: ActionLaunch,\n229|\t\t},\n230|\t\t{\n231|\t\t\tname: \"reattach_same_pair\",\n232|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n233|\t\t\t\tinput.ExistingBinding = &Binding{SessionID: fixtureSession, OperationID: fixtureBootstrap, TerminalInstanceID: fixtureInstance, BindingDigest: seedDigest(0xB1), CreatedAt: fixtureCreatedAt}\n234|\t\t\t},\n235|\t\t\twant: ActionReattach,\n236|\t\t},\n237|\t\t{\n238|\t\t\tname: \"attach_remote_interactive\",\n239|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n240|\t\t\t\tinput.Observation.Winner.HolderHostID = fixtureRemoteHost\n241|\t\t\t\tinput.RemoteInteractive = true\n242|\t\t\t},\n243|\t\t\twant:      ActionAttachRemote,\n244|\t\t\twantLease: fixtureLeaseA,\n245|\t\t},\n246|\t\t{\n247|\t\t\tname: \"takeover_offer_noninteractive\",\n248|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n249|\t\t\t\tinput.Observation.Winner.HolderHostID = fixtureRemoteHost\n250|\t\t\t\tinput.RemoteInteractive = false\n251|\t\t\t},\n252|\t\t\twant:      ActionTakeoverOffer,\n253|\t\t\twantLease: fixtureLeaseA,\n254|\t\t},\n255|\t\t{\n256|\t\t\tname:        \"takeover_offer_attach_unproven\",\n257|\t\t\tattachProbe: true,\n258|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n259|\t\t\t\tinput.Observation.Winner.HolderHostID = fixtureRemoteHost\n260|\t\t\t\tinput.RemoteInteractive = true\n261|\t\t\t},\n262|\t\t\twant:      ActionTakeoverOffer,\n263|\t\t\twantLease: fixtureLeaseA,\n264|\t\t},\n265|\t\t{\n266|\t\t\tname: \"refused_config_invalid\",\n267|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n268|\t\t\t\tinput.ConfigErr = errFixtureConfig\n269|\t\t\t},\n270|\t\t\twant:      ActionRefused,\n271|\t\t\twantClass: ClassInvalidConfig,\n272|\t\t},\n273|\t\t{\n274|\t\t\tname: \"refused_unknown_mode\",\n275|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n276|\t\t\t\tinput.Mode = Mode(\"bogus\")\n277|\t\t\t},\n278|\t\t\twant:      ActionRefused,\n279|\t\t\twantClass: ClassInvalidArguments,\n280|\t\t},\n281|\t\t{\n282|\t\t\tname: \"refused_empty_mode\",\n283|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n284|\t\t\t\tinput.Mode = Mode(\"\")\n285|\t\t\t},\n286|\t\t\twant:      ActionRefused,\n287|\t\t\twantClass: ClassInvalidArguments,\n288|\t\t},\n289|\t\t{\n290|\t\t\tname: \"refused_unknown_session\",\n291|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n292|\t\t\t\tinput.SessionKnown = false\n293|\t\t\t},\n294|\t\t\twant:      ActionRefused,\n295|\t\t\twantClass: ClassInvalidArguments,\n296|\t\t},\n297|\t\t{\n298|\t\t\tname: \"refused_idempotency_mismatch\",\n299|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n300|\t\t\t\tinput.ExistingBinding = &Binding{SessionID: fixtureSession, OperationID: fixtureOtherOp, TerminalInstanceID: fixtureInstance, BindingDigest: seedDigest(0xB1), CreatedAt: fixtureCreatedAt}\n301|\t\t\t},\n302|\t\t\twant:      ActionRefused,\n303|\t\t\twantClass: terminalbackend.CodeIdempotencyMismatch,\n304|\t\t},\n305|\t\t{\n306|\t\t\tname: \"refused_unknown_caller\",\n307|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n308|\t\t\t\tinput.Realm.Caller = \"batch\"\n309|\t\t\t},\n310|\t\t\twant:      ActionRefused,\n311|\t\t\twantClass: ClassInvalidArguments,\n312|\t\t},\n313|\t\t{\n314|\t\t\tname: \"refused_backend_generation_mismatch\",\n315|\t\t\tuniverse: func(t *testing.T, universe *backendUniverse) {\n316|\t\t\t\tuniverse.probe[\"backend_generation_digest\"] = seedDigest(0x99)\n317|\t\t\t\tuniverse.probe[\"probe_id\"] = omitSelfIdentity(t, universe.probe, \"probe_id\")\n318|\t\t\t},\n319|\t\t\twant:      ActionRefused,\n320|\t\t\twantClass: terminalbackend.CodeStaleGeneration,\n321|\t\t},\n322|\t\t{\n323|\t\t\tname: \"refused_backend_protocol_membership\",\n324|\t\t\tuniverse: func(t *testing.T, universe *backendUniverse) {\n325|\t\t\t\tuniverse.probe[\"protocol_version\"] = \"2.0.0\"\n326|\t\t\t\tuniverse.probe[\"probe_id\"] = omitSelfIdentity(t, universe.probe, \"probe_id\")\n327|\t\t\t},\n328|\t\t\twant:      ActionRefused,\n329|\t\t\twantClass: terminalbackend.CodeMismatch,\n330|\t\t},\n331|\t\t{\n332|\t\t\tname: \"refused_backend_evidence_expired\",\n333|\t\t\tuniverse: func(t *testing.T, universe *backendUniverse) {\n334|\t\t\t\tuniverse.now = time.Date(2028, time.January, 20, 0, 0, 0, 0, time.UTC)\n335|\t\t\t},\n336|\t\t\twant:      ActionRefused,\n337|\t\t\twantClass: terminalbackend.CodeMismatch,\n338|\t\t},\n339|\t\t{\n340|\t\t\tname: \"refused_backend_signature_untrusted\",\n341|\t\t\tuniverse: func(t *testing.T, universe *backendUniverse) {\n342|\t\t\t\tuniverse.verify = func(issuerID string, message, signature []byte) error {\n343|\t\t\t\t\treturn errFixtureConfig\n344|\t\t\t\t}\n345|\t\t\t},\n346|\t\t\twant:      ActionRefused,\n347|\t\t\twantClass: terminalbackend.CodeIntegrityFailure,\n348|\t\t},\n349|\t\t{\n350|\t\t\tname: \"refused_backend_capability_unproven\",\n351|\t\t\tuniverse: func(t *testing.T, universe *backendUniverse) {\n352|\t\t\t\t// create is conferred by durable_disconnect and\n353|\t\t\t\t// headless_creation; both must stay unadmitted\n354|\t\t\t\t// for the operation to be unproven. Neither is\n355|\t\t\t\t// claimed at all, so no evidence rule fires and\n356|\t\t\t\t// the admitted set simply confers no create.\n357|\t\t\t\tdrop := map[string]bool{\"durable_disconnect\": true, \"headless_creation\": true}\n358|\t\t\t\tkeepClaims := func(claims []any) []any {\n359|\t\t\t\t\tkept := make([]any, 0, len(claims))\n360|\t\t\t\t\tfor _, raw := range claims {\n361|\t\t\t\t\t\tif !drop[raw.(map[string]any)[\"capability\"].(string)] {\n362|\t\t\t\t\t\t\tkept = append(kept, raw)\n363|\t\t\t\t\t\t}\n364|\t\t\t\t\t}\n365|\t\t\t\t\treturn kept\n366|\t\t\t\t}\n367|\t\t\t\tuniverse.manifest[\"static_capability_claims\"] = keepClaims(universe.manifest[\"static_capability_claims\"].([]any))\n368|\t\t\t\tuniverse.probe[\"capability_claims\"] = keepClaims(universe.probe[\"capability_claims\"].([]any))\n369|\t\t\t\tkeptEvidence := universe.evidence[:0]\n370|\t\t\t\tfor _, object := range universe.evidence {\n371|\t\t\t\t\tif !drop[object[\"capability\"].(string)] {\n372|\t\t\t\t\t\tkeptEvidence = append(keptEvidence, object)\n373|\t\t\t\t\t}\n374|\t\t\t\t}\n375|\t\t\t\tuniverse.evidence = keptEvidence\n376|\t\t\t\tvar ids []any\n377|\t\t\t\tfor _, object := range universe.evidence {\n378|\t\t\t\t\tids = append(ids, object[\"evidence_id\"])\n379|\t\t\t\t}\n380|\t\t\t\tsort.Slice(ids, func(i, j int) bool { return ids[i].(string) < ids[j].(string) })\n381|\t\t\t\tuniverse.probe[\"evidence_ids\"] = ids\n382|\t\t\t\tuniverse.manifest[\"manifest_id\"] = omitSelfIdentity(t, universe.manifest, \"manifest_id\")\n383|\t\t\t\tuniverse.probe[\"probe_id\"] = omitSelfIdentity(t, universe.probe, \"probe_id\")\n384|\t\t\t},\n385|\t\t\twant:      ActionRefused,\n386|\t\t\twantClass: terminalbackend.CodeCapabilityUnproven,\n387|\t\t},\n388|\t\t{\n389|\t\t\tname: \"refused_fencing_malformed_token\",\n390|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n391|\t\t\t\tinput.Presented.Epoch = 0\n392|\t\t\t},\n393|\t\t\twant:      ActionRefused,\n394|\t\t\twantClass: ClassInvalidArguments,\n395|\t\t},\n396|\t\t{\n397|\t\t\tname: \"refused_fencing_foreign_session\",\n398|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n399|\t\t\t\tinput.Presented.SessionID = fixtureForeign\n400|\t\t\t},\n401|\t\t\twant:      ActionRefused,\n402|\t\t\twantClass: \"lease_conflict\",\n403|\t\t},\n404|\t\t{\n405|\t\t\tname: \"refused_fencing_expired_grant\",\n406|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n407|\t\t\t\tinput.Observation = lapsedObservation(now)\n408|\t\t\t},\n409|\t\t\twant:      ActionRefused,\n410|\t\t\twantClass: \"lease_conflict\",\n411|\t\t},\n412|\t\t{\n413|\t\t\tname: \"refused_provider_tuple_qwen\",\n414|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n415|\t\t\t\tinput.Provider.Build = provhost.BuildTuple{ProviderID: \"qwen\", ProviderVersion: \"1.0.0\", Platform: \"linux\", Architecture: \"amd64\"}\n416|\t\t\t},\n417|\t\t\twant:      ActionRefused,\n418|\t\t\twantClass: \"invalid_config\",\n419|\t\t},\n420|\t\t{\n421|\t\t\tname: \"launch_discovery_bound\",\n422|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n423|\t\t\t\tinput.Provider.HasDiscovery = true\n424|\t\t\t\tinput.Provider.Discovery = []byte(`{\"native_session_id\":\"native-session-alpha\",\"discovered\":true,\"discovery_root\":\"/home/test/.codex/sessions/native-session-alpha\",\"backend_resolved\":false}`)\n425|\t\t\t\tinput.Provider.DiscoveryContext = provhost.DiscoveryContext{\n426|\t\t\t\t\tBuild: fixtureBuild(), Home: \"/home/test\",\n427|\t\t\t\t}\n428|\t\t\t},\n429|\t\t\twant: ActionLaunch,\n430|\t\t},\n431|\t\t{\n432|\t\t\tname: \"refused_discovery_native_mismatch\",\n433|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n434|\t\t\t\tinput.Provider.HasDiscovery = true\n435|\t\t\t\tinput.Provider.Discovery = []byte(`{\"native_session_id\":\"native-session-other\",\"discovered\":true,\"discovery_root\":\"/home/test/.codex/sessions/native-session-other\",\"backend_resolved\":false}`)\n436|\t\t\t\tinput.Provider.DiscoveryContext = provhost.DiscoveryContext{\n437|\t\t\t\t\tBuild: fixtureBuild(), Home: \"/home/test\",\n438|\t\t\t\t}\n439|\t\t\t},\n440|\t\t\twant:      ActionRefused,\n441|\t\t\twantClass: \"invalid_config\",\n442|\t\t},\n443|\t\t{\n444|\t\t\tname: \"refused_discovery_root_outside\",\n445|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n446|\t\t\t\tinput.Provider.HasDiscovery = true\n447|\t\t\t\tinput.Provider.Discovery = []byte(`{\"native_session_id\":\"native-session-alpha\",\"discovered\":true,\"discovery_root\":\"/tmp/evil\",\"backend_resolved\":false}`)\n448|\t\t\t\tinput.Provider.DiscoveryContext = provhost.DiscoveryContext{\n449|\t\t\t\t\tBuild: fixtureBuild(), Home: \"/home/test\",\n450|\t\t\t\t}\n451|\t\t\t},\n452|\t\t\twant:      ActionRefused,\n453|\t\t\twantClass: \"invalid_config\",\n454|\t\t},\n455|\t\t{\n456|\t\t\tname: \"refused_discovery_empty_home\",\n457|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n458|\t\t\t\tinput.Provider.HasDiscovery = true\n459|\t\t\t\tinput.Provider.Discovery = []byte(`{\"native_session_id\":\"native-session-alpha\",\"discovered\":true,\"discovery_root\":\"/home/test/.codex/sessions/native-session-alpha\",\"backend_resolved\":false}`)\n460|\t\t\t\tinput.Provider.DiscoveryContext = provhost.DiscoveryContext{\n461|\t\t\t\t\tBuild: fixtureBuild(), Home: \"\",\n462|\t\t\t\t}\n463|\t\t\t},\n464|\t\t\twant:      ActionRefused,\n465|\t\t\twantClass: \"invalid_config\",\n466|\t\t},\n467|\t\t{\n468|\t\t\tname: \"refused_provider_identity_other_provider\",\n469|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n470|\t\t\t\trecord, err := provhost.CreateIdentity(provhost.IdentityParams{\n471|\t\t\t\t\tSessionID: fixtureSession, ProviderID: \"claude\", ProviderVersion: \"0.147.0\",\n472|\t\t\t\t\tProviderVersionRange: \"opaque-range\", NativeSessionID: \"native-session-alpha\",\n473|\t\t\t\t\tIdentityKind: \"session_uuid\", LogicalWorkspaceID: fixtureLocalHost,\n474|\t\t\t\t\tCreatedByHostID: fixtureLocalHost, CreatedAt: fixtureCreatedAt,\n475|\t\t\t\t})\n476|\t\t\t\tif err != nil {\n477|\t\t\t\t\tt.Fatalf(\"CreateIdentity() error = %v\", err)\n478|\t\t\t\t}\n479|\t\t\t\tinput.Provider.Identity = record\n480|\t\t\t},\n481|\t\t\twant:      ActionRefused,\n482|\t\t\twantClass: \"invalid_config\",\n483|\t\t},\n484|\t\t{\n485|\t\t\tname: \"refused_smoke_failing_verdict\",\n486|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n487|\t\t\t\tinput.Smoke.Required = true\n488|\t\t\t\tinput.Smoke.Record = smokeRecord(t, \"fail\", \"A\", []any{\n489|\t\t\t\t\tmap[string]any{\"name\": \"resume-cell\", \"outcome\": \"pass\", \"detail\": \"cell A\"},\n490|\t\t\t\t\tmap[string]any{\"name\": \"probe\", \"outcome\": \"fail\", \"detail\": \"probe refused\"},\n491|\t\t\t\t}, smokeTuple())\n492|\t\t\t\tinput.Smoke.Target = smokeTarget()\n493|\t\t\t},\n494|\t\t\twant:      ActionRefused,\n495|\t\t\twantClass: \"target_auth_missing\",\n496|\t\t},\n497|\t\t{\n498|\t\t\tname: \"refused_smoke_absent\",\n499|\t\t\tmutate: func(t *testing.T, deps *decideDeps, input *Input) {\n500|\t\t\t\tinput.Smoke.Required = true\n(more lines below)","final_result":true}}}
