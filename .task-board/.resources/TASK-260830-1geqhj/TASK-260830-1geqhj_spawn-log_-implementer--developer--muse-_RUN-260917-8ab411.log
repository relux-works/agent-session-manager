{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000e8c1","stream":{"kind":"session","id":"01a0b0c8-2197-71f2-b37c-575c8ab978c8"},"sequence":4795,"recorded_at":1780531400009585,"record_type":"event","durability":"durable","causation_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","run_stream":{"kind":"run","id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3"},"task_stream":{"kind":"task","id":"01a0b0f3-9a93-7e42-8e76-62f91ed7281f"},"task_id":"01a0b0f3-9a93-7e42-8e76-62f91ed7281f","event":{"kind":"output","task_id":"01a0b0f3-9a93-7e42-8e76-62f91ed7281f","chunk":"{\n  \"chunk_id\": \"exec-82-1\",\n  \"command\": \"task-board resource --help 2>&1 | head -n 60\\ntask-board m 'schema(mutation=add_resource)' 2>&1 | head -n 60\",\n  \"description\": \"Check resource upload\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Manage attached resources such as screenshots, docs, logs, and other files.\\n\\nUse \\\"task-board resource add\\\" to create a new attached resource, \\\"task-board\\nresource adopt\\\" to register an orphaned local payload, \\\"task-board resource\\nupdate\\\" to replace an existing one, \\\"task-board resource delete\\\" to remove it,\\nand \\\"task-board resource get\\\" to materialize a resource back to the local\\nfilesystem for inspection.\\n\\nUsage:\\n  task-board resource [command]\\n\\nAvailable Commands:\\n  add         Attach a new file resource to an element\\n  adopt       Register an existing unreferenced local resource payload\\n  delete      Delete a resource from an element (requires --confirm)\\n  get         Download a resource to the local filesystem\\n  update      Replace an existing file resource on an element\\n\\nFlags:\\n  -h, --help   help for resource\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\\nUse \\\"task-board resource [command] --help\\\" for more information about a command.\\n{\\\"defaultFields\\\":[\\\"id\\\",\\\"name\\\",\\\"status\\\"],\\\"fields\\\":[\\\"id\\\",\\\"type\\\",\\\"name\\\",\\\"title\\\",\\\"status\\\",\\\"integrationCheckpointed\\\",\\\"review\\\",\\\"task_class\\\",\\\"estimate\\\",\\\"observability\\\",\\\"parent\\\",\\\"assignee\\\",\\\"description\\\",\\\"scope\\\",\\\"ac\\\",\\\"blockedBy\\\",\\\"blocks\\\",\\\"derivedBlockedBy\\\",\\\"derivedBlocks\\\",\\\"checklist\\\",\\\"notes\\\",\\\"created\\\",\\\"updated\\\",\\\"isBlocked\\\",\\\"isAdvisoryBlocked\\\",\\\"children\\\",\\\"preconditionResources\\\",\\\"outcomeResources\\\",\\\"identity\\\",\\\"binding\\\",\\\"lineage\\\",\\\"lifecycle\\\",\\\"freshness\\\",\\\"actualization\\\",\\\"security\\\",\\\"payload\\\"],\\\"grammar\\\":{\\\"statement\\\":\\\"OPERATION(ARGUMENTS) { PROJECTION }; the projection block is optional\\\",\\\"batch\\\":\\\"STATEMENT; STATEMENT — statements separated by ';', results keep source order\\\",\\\"arguments\\\":\\\"comma-separated arguments: the first bare positional value is the element/identifier argument; remaining arguments use key=value; no operators or lists (not key in [a,b], not key!=value)\\\",\\\"values\\\":\\\"a bare identifier (letters, digits, '_', '-', '.', '/'), an int, a bool (true|false), or a \\\\\\\"double-quoted string\\\\\\\"; quote any value containing spaces, commas or parentheses\\\",\\\"escapes\\\":[\\\"\\\\\\\\\\\\\\\"\\\",\\\"\\\\\\\\\\\\\\\\\\\",\\\"\\\\\\\\n\\\",\\\"\\\\\\\\t\\\"],\\\"projection\\\":\\\"field projection: { field preset ... } — space-separated field names and preset names inside braces; omitted means the default fields\\\",\\\"tokens\\\":[\\\"identifier\\\",\\\"string\\\",\\\"'('\\\",\\\"')'\\\",\\\"'{'\\\",\\\"'}'\\\",\\\"'='\\\",\\\"','\\\",\\\"';'\\\",\\\"end of input\\\"],\\\"examples\\\":[\\\"op()\\\",\\\"op(key=value)\\\",\\\"op(key=value, other=42, flag=true)\\\",\\\"op(key=\\\\\\\"quoted value with \\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\\ \\\\\\\\n \\\\\\\\t\\\\\\\")\\\",\\\"op(positional)\\\",\\\"op() { field preset }\\\",\\\"op(key=value) { field }; other()\\\"]},\\\"mutationMetadata\\\":{\\\"accept_cr\\\":{\\\"description\\\":\\\"Record an evidence-backed reviewer acceptance and route the element to integrating\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID carrying the Change Request\\\",\\\"required\\\":true},{\\\"name\\\":\\\"revision\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Change Request revision being accepted (expected-revision CAS)\\\",\\\"required\\\":true},{\\\"name\\\":\\\"evidence\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Task-scoped outcome resource name carrying the verdict evidence\\\",\\\"required\\\":true}],\\\"examples\\\":[\\\"accept_cr(TASK-260803-323q82, revision=2, evidence=TASK-260803-323q82_review-verdict-rev2.md)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false},\\\"add_checklist_item\\\":{\\\"description\\\":\\\"Add a new checklist item\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\",\\\"required\\\":true},{\\\"name\\\":\\\"text\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Checklist item text\\\",\\\"required\\\":true}],\\\"examples\\\":[\\\"add_checklist_item(TASK-260218-abc123, text=\\\\\\\"Write unit tests\\\\\\\")\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false},\\\"add_resource\\\":{\\\"description\\\":\\\"Add a text resource to an element\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\",\\\"required\\\":true},{\\\"name\\\":\\\"name\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Resource name (e.g. research.md)\\\",\\\"required\\\":true},{\\\"name\\\":\\\"content\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Resource content (text); required if path is not provided\\\"},{\\\"name\\\":\\\"path\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Client-local file path (remote CLI inlines content; board-server rejects raw paths)\\\"},{\\\"name\\\":\\\"type\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"default\\\":\\\"outcome\\\",\\\"description\\\":\\\"Resource type\\\",\\\"enum\\\":[\\\"precondition\\\",\\\"outcome\\\"]},{\\\"name\\\":\\\"description\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"One-line description\\\"}],\\\"examples\\\":[\\\"add_resource(TASK-260218-abc123, name=\\\\\\\"research.md\\\\\\\", content=\\\\\\\"...\\\\\\\", type=outcome)\\\",\\\"add_resource(TASK-260218-abc123, name=\\\\\\\"spec.md\\\\\\\", path=\\\\\\\".temp/spec.md\\\\\\\", type=precondition)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false},\\\"assign\\\":{\\\"description\\\":\\\"Assign an agent to an element\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\",\\\"required\\\":true},{\\\"name\\\":\\\"agent\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Agent name\\\",\\\"required\\\":true}],\\\"examples\\\":[\\\"assign(TASK-260218-abc123, agent=clau