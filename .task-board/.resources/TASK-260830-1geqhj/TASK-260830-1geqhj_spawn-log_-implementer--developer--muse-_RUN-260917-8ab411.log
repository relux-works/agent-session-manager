{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9c3","stream":{"kind":"session","id":"01a0b0c8-2197-71f2-b37c-575c8ab978c8"},"sequence":828,"recorded_at":1780531400001651,"record_type":"event","durability":"durable","causation_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","run_stream":{"kind":"run","id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3"},"call_id":"call_01a0b0ca6fd8757492fee27be312b6bf","text":"Read text file `internal/axpane/events_test.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n9|)\n10|\n11|func bindingFacts() TerminalBindingFacts {\n12|\treturn TerminalBindingFacts{\n13|\t\tBindingDigest:         seedDigest(0xB1),\n14|\t\tBackendID:             \"ax.tmux\",\n15|\t\tImplementationVersion: \"2.1.0\",\n16|\t\tProtocolVersion:       \"1.1.0\",\n17|\t\tProtocolVersions:      []string{\"1.0.0\", \"1.1.0\"},\n18|\t\tEvidenceIDs:           []string{seedDigest(0xE0), seedDigest(0xE1)},\n19|\t}\n20|}\n21|\n22|func TestParkedPayloadVocabulary(t *testing.T) {\n23|\tt.Parallel()\n24|\tfor _, reason := range []fencing.ParkReason{\n25|\t\tfencing.ParkRemoteOwner, fencing.ParkStaleOwner, fencing.ParkRestorePolicy, fencing.ParkFailedHandoff,\n26|\t} {\n27|\t\tpayload, err := ParkedPayload(reason, fixtureLeaseA)\n28|\t\tif err != nil {\n29|\t\t\tt.Fatalf(\"ParkedPayload(%q) error = %v\", string(reason), err)\n30|\t\t}\n31|\t\tif payload[\"reason\"] != string(reason) || payload[\"winning_lease_id\"] != fixtureLeaseA {\n32|\t\t\tt.Fatalf(\"ParkedPayload(%q) = %v\", string(reason), payload)\n33|\t\t}\n34|\t\tif len(payload) != 2 {\n35|\t\t\tt.Fatalf(\"ParkedPayload(%q) carries %d members, want exactly 2\", string(reason), len(payload))\n36|\t\t}\n37|\t}\n38|\tif _, err := ParkedPayload(fencing.ParkReason(\"bogus\"), fixtureLeaseA); err == nil {\n39|\t\tt.Fatal(\"ParkedPayload(bogus) succeeded, want refusal\")\n40|\t}\n41|\tif _, err := ParkedPayload(fencing.ParkRemoteOwner, \"not-a-lease\"); err == nil {\n42|\t\tt.Fatal(\"ParkedPayload(bad lease) succeeded, want refusal\")\n43|\t}\n44|}\n45|\n46|func TestTerminalCreatedPayload(t *testing.T) {\n47|\tt.Parallel()\n48|\tpayload, err := TerminalCreatedPayload(bindingFacts())\n49|\tif err != nil {\n50|\t\tt.Fatalf(\"TerminalCreatedPayload() error = %v\", err)\n51|\t}\n52|\twant := map[string]any{\n53|\t\t\"terminal_binding_id\":    seedDigest(0xB1),\n54|\t\t\"terminal_backend_id\":    \"ax.tmux\",\n55|\t\t\"implementation_version\": \"2.1.0\",\n56|\t\t\"protocol_version\":       \"1.1.0\",\n57|\t\t\"evidence_ids\":           []string{seedDigest(0xE0), seedDigest(0xE1)},\n58|\t}\n59|\traw, _ := json.Marshal(payload)\n60|\tvar decoded map[string]any\n61|\tif err := json.Unmarshal(raw, &decoded); err != nil {\n62|\t\tt.Fatal(err)\n63|\t}\n64|\tif len(decoded) != len(want) {\n65|\t\tt.Fatalf(\"TerminalCreatedPayload() members = %v, want exactly %v\", decoded, want)\n66|\t}\n67|\tfor name, value := range want {\n68|\t\tround, _ := json.Marshal(decoded[name])\n69|\t\texpect, _ := json.Marshal(value)\n70|\t\tif string(round) != string(expect) {\n71|\t\t\tt.Fatalf(\"TerminalCreatedPayload()[%q] = %s, want %s\", name, round, expect)\n72|\t\t}\n73|\t}\n74|\tcases := []struct {\n75|\t\tname   string\n76|\t\tmutate func(*TerminalBindingFacts)\n77|\t}{\n78|\t\t{\"bad digest\", func(facts *TerminalBindingFacts) { facts.BindingDigest = \"nope\" }},\n79|\t\t{\"bad backend\", func(facts *TerminalBindingFacts) { facts.BackendID = \"Bogus!\" }},\n80|\t\t{\"bad versions\", func(facts *TerminalBindingFacts) { facts.ProtocolVersion = \"2.0.0\" }},\n81|\t\t{\"empty evidence\", func(facts *TerminalBindingFacts) { facts.EvidenceIDs = nil }},\n82|\t\t{\"unsorted evidence\", func(facts *TerminalBindingFacts) {\n83|\t\t\tfacts.EvidenceIDs = []string{seedDigest(0xE1), seedDigest(0xE0)}\n84|\t\t}},\n85|\t\t{\"bad evidence digest\", func(facts *TerminalBindingFacts) { facts.EvidenceIDs = []string{\"nope\"} }},\n86|\t}\n87|\tfor _, testCase := range cases {\n88|\t\tt.Run(testCase.name, func(t *testing.T) {\n89|\t\t\tt.Parallel()\n90|\t\t\tfacts := bindingFacts()\n91|\t\t\ttestCase.mutate(&facts)\n92|\t\t\tif _, err := TerminalCreatedPayload(facts); err == nil {\n93|\t\t\t\tt.Fatalf(\"TerminalCreatedPayload(%s) succeeded, want refusal\", testCase.name)\n94|\t\t\t}\n95|\t\t})\n96|\t}\n97|}\n98|\n99|func TestResumedPayload(t *testing.T) {\n100|\tt.Parallel()\n101|\tpayload, err := ResumedPayload(seedDigest(0xC9), \"yolo\", seedDigest(0xCA), true, bindingFacts())\n102|\tif err != nil {\n103|\t\tt.Fatalf(\"ResumedPayload() error = %v\", err)\n104|\t}\n105|\tif payload[\"checkpoint_id\"] != seedDigest(0xC9) || payload[\"execution_profile\"] != \"yolo\" || payload[\"profile_source_event_id\"] != seedDigest(0xCA) {\n106|\t\tt.Fatalf(\"ResumedPayload() = %v\", payload)\n107|\t}\n108|\tif len(payload) != 8 {\n109|\t\tt.Fatalf(\"ResumedPayload() carries %d members, want exactly 8\", len(payload))\n110|\t}\n111|\tnullSource, err := ResumedPayload(seedDigest(0xC9), \"standard\", \"\", false, bindingFacts())\n112|\tif err != nil {\n113|\t\tt.Fatalf(\"ResumedPayload(null source) error = %v\", err)\n114|\t}\n115|\tif nullSource[\"profile_source_event_id\"] != nil {\n116|\t\tt.Fatalf(\"ResumedPayload(null source) source = %v, want null\", nullSource[\"profile_source_event_id\"])\n117|\t}\n118|\tif _, err := ResumedPayload(\"nope\", \"standard\", \"\", false, bindingFacts()); err == nil {\n119|\t\tt.Fatal(\"ResumedPayload(bad checkpoint) succeeded, want refusal\")\n120|\t}\n121|\tif _, err := ResumedPayload(seedDigest(0xC9), \"bogus\", \"\", false, bindingFacts()); err == nil {\n122|\t\tt.Fatal(\"ResumedPayload(bad profile) succeeded, want refusal\")\n123|\t}\n124|\tif _, err := ResumedPayload(seedDigest(0xC9), \"yolo\", \"nope\", true, bindingFacts()); err == nil {\n125|\t\tt.Fatal(\"ResumedPayload(bad source) succeeded, want refusal\")\n126|\t}\n127|}\n128|\n129|// TestEmitParkedRoundTrip authors the parked event for a Decide\n130|// parked outcome through the sessrepo owner under the current\n131|// lease, then reads it back: the envelope lease repeats the\n132|// winner and the payload carries the exact closed members.\n133|func TestEmitParkedRoundTrip(t *testing.T) {\n134|\tt.Parallel()\n135|\tdeps := buildDecideDeps(t, true)\n136|\tinput := validInput(t, deps)\n137|\tinput.Observation.Verified = false\n138|\tdecision := Decide(input)\n139|\tif decision.Action != ActionParked {\n140|\t\tt.Fatalf(\"Decide() action = %q, want parked\", decision.Action)\n141|\t}\n142|\trecordID, tail, err := ChainTail(deps.repo, fixtureSession)\n143|\tif err != nil {\n144|\t\tt.Fatalf(\"ChainTail() error = %v\", err)\n145|\t}\n146|\t_ = recordID\n147|\treference, raw, err := EmitParked(deps.repo, decision, EmitParams{\n148|\t\tSessionID:     fixtureSession,\n149|\t\tCreatedByHost: fixtureLocalHost,\n150|\t\tLeaseEpoch:    input.Observation.Winner.Epoch,\n151|\t\tLeaseID:       input.Observation.Winner.LeaseID,\n152|\t\tLeaseSequence: tail.LeaseSequence + 1,\n153|\t\tPredecessors:  []string{tail.EventID},\n154|\t\tCreatedAt:     fixtureCreatedAt,\n155|\t})\n156|\tif err != nil {\n157|\t\tt.Fatalf(\"EmitParked() error = %v\", err)\n158|\t}\n159|\tstored, err := deps.repo.GetEvent(fixtureSession, reference.EventID)\n160|\tif err != nil {\n161|\t\tt.Fatalf(\"GetEvent() error = %v\", err)\n162|\t}\n163|\tif string(stored) != string(raw) {\n164|\t\tt.Fatal(\"GetEvent() bytes differ from the emitted bytes\")\n165|\t}\n166|\tvar decoded struct {\n167|\t\tSchemaVersion string `json:\"schema_version\"`\n168|\t\tEventType     string `json:\"event_type\"`\n169|\t\tLeaseEpoch    uint64 `json:\"lease_epoch\"`\n170|\t\tLeaseID       string `json:\"lease_id\"`\n171|\t\tPayload       struct {\n172|\t\t\tReason       string `json:\"reason\"`\n173|\t\t\tWinningLease string `json:\"winning_lease_id\"`\n174|\t\t} `json:\"payload\"`\n175|\t}\n176|\tif err := json.Unmarshal(stored, &decoded); err != nil {\n177|\t\tt.Fatal(err)\n178|\t}\n179|\tif decoded.SchemaVersion != \"1.0.0\" || decoded.EventType != \"session.parked\" {\n180|\t\tt.Fatalf(\"emitted event = (%q, %q), want (1.0.0, session.parked)\", decoded.SchemaVersion, decoded.EventType)\n181|\t}\n182|\tif decoded.LeaseEpoch != 1 || decoded.LeaseID != fixtureLeaseA {\n183|\t\tt.Fatalf(\"emitted lease = (%d, %q), want the winner\", decoded.LeaseEpoch, decoded.LeaseID)\n184|\t}\n185|\tif decoded.Payload.Reason != \"restore_policy\" || decoded.Payload.WinningLease != fixtureLeaseA {\n186|\t\tt.Fatalf(\"emitted payload = %+v, want the parked vocabulary\", decoded.Payload)\n187|\t}\n188|}\n189|\n190|func TestEmitTerminalV4RoundTrip(t *testing.T) {\n191|\tt.Parallel()\n192|\trepository, _ := chainFixture(t)\n193|\tevents, err := repository.ListEvents(fixtureSession)\n194|\tif err != nil {\n195|\t\tt.Fatal(err)\n196|\t}\n197|\ttail := events[len(events)-1]\n198|\tcreated, err := TerminalCreatedPayload(bindingFacts())\n199|\tif err != nil {\n200|\t\tt.Fatal(err)\n201|\t}\n202|\treference, _, err := Emit(repository, EmitParams{\n203|\t\tSessionID: fixtureSession, CreatedByHost: fixtureLocalHost,\n204|\t\tLeaseEpoch: 1, LeaseID: fixtureLeaseA, LeaseSequence: tail.LeaseSequence + 1,\n205|\t\tPredecessors: []string{tail.EventID}, CreatedAt: fixtureCreatedAt,\n206|\t\tEventType: \"terminal.created\", SchemaVersion: \"4.0.0\", Payload: created,\n207|\t})\n208|\tif err != nil {\n209|\t\tt.Fatalf(\"Emit(terminal.created v4) error = %v\", err)\n210|\t}\n211|\tresumed, err := ResumedPayload(seedDigest(0xC9), \"standard\", \"\", false, bindingFacts())\n212|\tif err != nil {\n213|\t\tt.Fatal(err)\n214|\t}\n215|\tsecond, _, err := Emit(repository, EmitParams{\n216|\t\tSessionID: fixtureSession, CreatedByHost: fixtureLocalHost,\n217|\t\tLeaseEpoch: 1, LeaseID: fixtureLeaseA, LeaseSequence: tail.LeaseSequence + 2,\n218|\t\tPredecessors: []string{reference.EventID}, CreatedAt: fixtureCreatedAt,\n219|\t\tEventType: \"session.resumed\", SchemaVersion: \"4.0.0\", Payload: resumed,\n220|\t})\n221|\tif err != nil {\n222|\t\tt.Fatalf(\"Emit(session.resumed v4) error = %v\", err)\n223|\t}\n224|\tfor _, eventID := range []string{reference.EventID, second.EventID} {\n225|\t\tstored, err := repository.GetEvent(fixtureSession, eventID)\n226|\t\tif err != nil {\n227|\t\t\tt.Fatalf(\"GetEvent() error = %v\", err)\n228|\t\t}\n229|\t\tvar decoded struct {\n230|\t\t\tSchemaVersion string `json:\"schema_version\"`\n231|\t\t}\n232|\t\tif err := json.Unmarshal(stored, &decoded); err != nil {\n233|\t\t\tt.Fatal(err)\n234|\t\t}\n235|\t\tif decoded.SchemaVersion != \"4.0.0\" {\n236|\t\t\tt.Fatalf(\"emitted schema_version = %q, want 4.0.0\", decoded.SchemaVersion)\n237|\t\t}\n238|\t}\n239|}\n240|\n241|func TestEmitParkedRefusesNonParked(t *testing.T) {\n242|\tt.Parallel()\n243|\tdeps := buildDecideDeps(t, true)\n244|\tdecision := Decide(validInput(t, deps))\n245|\tif decision.Action != ActionLaunch {\n246|\t\tt.Fatalf(\"Decide() action = %q, want launch\", decision.Action)\n247|\t}\n248|\tif _, _, err := EmitParked(deps.repo, decision, EmitParams{}); err == nil {\n249|\t\tt.Fatal(\"EmitParked(launch) succeeded, want refusal\")\n250|\t}\n251|\tvar _ = sessrepo.EventRef{}\n252|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9c5","stream":{"kind":"session","id":"01a0b0c8-2197-71f2-b37c-575c8ab978c8"},"sequence":829,"recorded_at":1780531400001653,"record_type":"event","durability":"durable","causation_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","run_stream":{"kind":"run","id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3"},"call_id":"call_01a0b0ca724b72c8be8c7edaed2c3363","text":"Read text file `internal/axpane/conformance_test.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"os/exec\"\n5|\t\"regexp\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n10|)\n11|\n12|// TestDecideArmPrecedence pins the §4.C wrapper-rule order: with\n13|// every arm faulted at once, the first arm wins. Configuration\n14|// precedes session, which precedes bootstrap idempotency, which\n15|// precedes backend admission, which precedes fencing.\n16|func TestDecideArmPrecedence(t *testing.T) {\n17|\tt.Parallel()\n18|\tdeps := buildDecideDeps(t, true)\n19|\tinput := validInput(t, deps)\n20|\tinput.ConfigErr = errFixtureConfig\n21|\tinput.SessionKnown = false\n22|\tinput.ExistingBinding = &Binding{SessionID: fixtureSession, OperationID: fixtureOtherOp}\n23|\tinput.Backend.Manifest = []byte(`{\"broken\":true}`)\n24|\tinput.Presented.Epoch = 0\n25|\tdecision := Decide(input)\n26|\tif decision.Action != ActionRefused || decision.Class != ClassInvalidConfig {\n27|\t\tt.Fatalf(\"Decide() all-faulted = (%q, %q), want (refused, invalid_config)\", decision.Action, decision.Class)\n28|\t}\n29|\tinput.ConfigErr = nil\n30|\tdecision = Decide(input)\n31|\tif decision.Action != ActionRefused || decision.Class != ClassInvalidArguments {\n32|\t\tt.Fatalf(\"Decide() peeled-config = (%q, %q), want the session arm\", decision.Action, decision.Class)\n33|\t}\n34|}\n35|\n36|// TestEmitParkedVocabularyLoop authors all four session.parked\n37|// reasons through the production emission path and reads each back\n38|// with its exact closed payload.\n39|func TestEmitParkedVocabularyLoop(t *testing.T) {\n40|\tt.Parallel()\n41|\tdeps := buildDecideDeps(t, true)\n42|\tcases := []struct {\n43|\t\treason fencing.ParkReason\n44|\t\taction Action\n45|\t\tmutate func(*Input)\n46|\t}{\n47|\t\t{fencing.ParkRemoteOwner, ActionTakeoverOffer, func(input *Input) { input.Observation.Winner.HolderHostID = fixtureRemoteHost }},\n48|\t\t{fencing.ParkStaleOwner, ActionParked, func(input *Input) { input.Presented.LeaseID = fixtureLeaseB }},\n49|\t\t{fencing.ParkRestorePolicy, ActionParked, func(input *Input) { input.Observation.Verified = false }},\n50|\t\t{fencing.ParkFailedHandoff, ActionParked, func(input *Input) { input.Observation.HandoffFailed = true }},\n51|\t}\n52|\tsequence := uint64(2)\n53|\tpredecessor := deps.createdID\n54|\tfor _, testCase := range cases {\n55|\t\tinput := validInput(t, deps)\n56|\t\ttestCase.mutate(&input)\n57|\t\tdecision := Decide(input)\n58|\t\tif decision.Action != testCase.action || decision.ParkReason != testCase.reason {\n59|\t\t\tt.Fatalf(\"Decide() = (%q, %q), want (%q, %q)\", decision.Action, decision.ParkReason, testCase.action, testCase.reason)\n60|\t\t}\n61|\t\treference, _, err := EmitParked(deps.repo, decision, EmitParams{\n62|\t\t\tSessionID: fixtureSession, CreatedByHost: fixtureLocalHost,\n63|\t\t\tLeaseEpoch: 1, LeaseID: fixtureLeaseA, LeaseSequence: sequence,\n64|\t\t\tPredecessors: []string{predecessor}, CreatedAt: fixtureCreatedAt,\n65|\t\t})\n66|\t\tif err != nil {\n67|\t\t\tt.Fatalf(\"EmitParked(%q) error = %v\", testCase.reason, err)\n68|\t\t}\n69|\t\tstored, err := deps.repo.GetEvent(fixtureSession, reference.EventID)\n70|\t\tif err != nil {\n71|\t\t\tt.Fatal(err)\n72|\t\t}\n73|\t\tif !strings.Contains(string(stored), `\"reason\":\"`+string(testCase.reason)+`\"`) {\n74|\t\t\tt.Fatalf(\"parked event for %q carries no reason member: %s\", testCase.reason, stored)\n75|\t\t}\n76|\t\tsequence++\n77|\t\tpredecessor = reference.EventID\n78|\t}\n79|}\n80|\n81|// TestLaunchCarriesValidatedPlan pins the §13.1 step-4 surface the\n82|// wrapper hands to the later provider-launch leaf: the resolved\n83|// adapter mapping, the admitted §7.A descriptor, and the sealed\n84|// fencing token travel together on every launch, and no launch\n85|// ships a partial plan.\n86|func TestLaunchCarriesValidatedPlan(t *testing.T) {\n87|\tt.Parallel()\n88|\tdeps := buildDecideDeps(t, true)\n89|\tdecision := Decide(validInput(t, deps))\n90|\tif decision.Action != ActionLaunch {\n91|\t\tt.Fatalf(\"Decide() action = %q, want launch\", decision.Action)\n92|\t}\n93|\tif !decision.HasToken {\n94|\t\tt.Fatal(\"launch carries no fencing token\")\n95|\t}\n96|\tif decision.Descriptor.TerminalInstanceID == \"\" {\n97|\t\tt.Fatal(\"launch carries no admitted descriptor\")\n98|\t}\n99|\tif len(decision.Admitted.Capabilities) == 0 {\n100|\t\tt.Fatal(\"launch carries no admitted capabilities\")\n101|\t}\n102|}\n103|\n104|// TestConformanceMatrixCompleteness enumerates the pinned clauses\n105|// and the named top-level test that drives each through a\n106|// production entry, then verifies every named test exists in this\n107|// package through the go list entry. A row fails if its test is\n108|// removed or renamed without updating the matrix; subtest rows in\n109|// TRACEABILITY.md refine these top-level drivers.\n110|func TestConformanceMatrixCompleteness(t *testing.T) {\n111|\tt.Parallel()\n112|\trows := []struct {\n113|\t\tclause string\n114|\t\ttest   string\n115|\t}{\n116|\t\t{\"4.B manifest/probe/evidence identity\", \"TestDecideLaunchPositive\"},\n117|\t\t{\"4.B mismatch fails before activation\", \"TestDecideTable\"},\n118|\t\t{\"4.C wrapper rule order\", \"TestDecideArmPrecedence\"},\n119|\t\t{\"4.C bootstrap idempotency mismatch\", \"TestDecideTable\"},\n120|\t\t{\"4.C identical retry reattaches\", \"TestBindIdenticalRetryReattaches\"},\n121|\t\t{\"4.C concurrent commit reattaches\", \"TestBindConcurrentSameOperationReattaches\"},\n122|\t\t{\"4.C status proves absence\", \"TestBindInstallsAndStatusProves\"},\n123|\t\t{\"4.C unknown is not absent\", \"TestStatusUnknownIsNotAbsent\"},\n124|\t\t{\"4.C no PID persisted\", \"TestBindingPersistsNoPID\"},\n125|\t\t{\"4.C crash at the binding seam\", \"TestBindCrashChildSelfTerminates\"},\n126|\t\t{\"4.D only admitted rows authorize\", \"TestDecideTable\"},\n127|\t\t{\"4.2 background caller capability_unavailable\", \"TestDecideTypedRefusals\"},\n128|\t\t{\"4.2 cached evidence never authorizes\", \"TestRealmCarriesNoCachedEvidence\"},\n129|\t\t{\"4.2 after-restore sequence\", \"TestDecideAfterRestoreSequence\"},\n130|\t\t{\"5.2 session.parked vocabulary\", \"TestEmitParkedVocabularyLoop\"},\n131|\t\t{\"5.2 parked emission under lease\", \"TestEmitParkedRoundTrip\"},\n132|\t\t{\"5.2 v4 terminal payloads\", \"TestEmitTerminalV4RoundTrip\"},\n133|\t\t{\"7.A descriptor build and admit\", \"TestDescriptorBuildAdmitRoundTrip\"},\n134|\t\t{\"7.A descriptor mismatch refuses\", \"TestDescriptorMismatchRefuses\"},\n135|\t\t{\"7.A generation bounds\", \"TestDescriptorGenerationBounds\"},\n136|\t\t{\"7.A token passed separately\", \"TestDecideForgedTokensRefuse\"},\n137|\t\t{\"13.1 step 3 durable terminal entry\", \"TestRunLaunchBinds\"},\n138|\t\t{\"13.1 step 4 validated plan\", \"TestLaunchCarriesValidatedPlan\"},\n139|\t\t{\"2.4 effective profile and source\", \"TestDecideProfileSourcePinsEvent\"},\n140|\t\t{\"2.4 mapping refusal\", \"TestDecideYoloMapping\"},\n141|\t\t{\"orchestrated launch/reattach/park/refuse\", \"TestRunParkedEmits\"},\n142|\t\t{\"ownership observation over leases\", \"TestObserveLoadsWinningLease\"},\n143|\t}\n144|\tlisted, err := exec.Command(\"go\", \"test\", \".\", \"-list\", \".\", \"-count=1\").CombinedOutput()\n145|\tif err != nil {\n146|\t\tt.Fatalf(\"go test -list error = %v: %s\", err, listed)\n147|\t}\n148|\tpresent := map[string]bool{}\n149|\tfor _, line := range strings.Split(string(listed), \"\\n\") {\n150|\t\tmatched, _ := regexp.MatchString(`^Test[A-Za-z0-9_]+$`, strings.TrimSpace(line))\n151|\t\tif matched {\n152|\t\t\tpresent[strings.TrimSpace(line)] = true\n153|\t\t}\n154|\t}\n155|\tif len(present) == 0 {\n156|\t\tt.Fatalf(\"go test -list found no tests: %s\", listed)\n157|\t}\n158|\tfor _, row := range rows {\n159|\t\tif !present[row.test] {\n160|\t\t\tt.Errorf(\"clause %q names missing test %q\", row.clause, row.test)\n161|\t\t}\n162|\t}\n163|\tt.Logf(\"%d pinned clauses mapped to named tests\", len(rows))\n164|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9c7","stream":{"kind":"session","id":"01a0b0c8-2197-71f2-b37c-575c8ab978c8"},"sequence":830,"recorded_at":1780531400001655,"record_type":"event","durability":"durable","causation_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3","run_stream":{"kind":"run","id":"53d7abd4-2111-4f48-89d8-7ded249d4ac3"},"call_id":"call_01a0b0ca747675ac81a34c7fbde33d14","text":"Read text file `internal/axpane/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/axpane.\n3|\n4|Every gate ships a narrowing mutant: the gate stays present and is\n5|weakened to admit exactly one member of the class it must reject, and\n6|the named killer test must fail. A delete-only mutant proves only that\n7|the gate exists and is not accepted as evidence.\n8|\n9|Each row runs M (mutate one production file in place), R (run the\n10|scoped Go killer through the production entry point), V (verdict from\n11|the Go exit code plus a FAIL kill-line: KILLED iff R fails with a test\n12|failure line, SURVIVED iff R passes, ERROR for anything else —\n13|unapplied patches, build breaks, timeouts). M failures and R\n14|infrastructure errors are ERROR, never kills or survivals. The file is\n15|restored from its backup after every row, pass or fail.\n16|\n17|Row C-doc-comment is the harmless control: a comment-only edit that\n18|must SURVIVE, proving the harness observes test outcomes instead of\n19|hard-coding kills.\n20|\n21|Usage:\n22|  PYTHONDONTWRITEBYTECODE=1 python3 internal/axpane/mutant_harness.py\n23|  PYTHONDONTWRITEBYTECODE=1 python3 internal/axpane/mutant_harness.py N-config\n24|\"\"\"\n25|\n26|import os\n27|import shutil\n28|import subprocess\n29|import sys\n30|import tempfile\n31|from dataclasses import dataclass\n32|from pathlib import Path\n33|\n34|REPO = Path(__file__).resolve().parents[2]\n35|PACKAGE = \"internal/axpane\"\n36|\n37|\n38|@dataclass(frozen=True)\n39|class Mutant:\n40|    name: str\n41|    path: str\n42|    find: str\n43|    replace: str\n44|    count: int\n45|    run: str\n46|    expect: str\n47|    note: str\n48|\n49|\n50|MUTANTS = [\n51|    Mutant(\n52|        name=\"N-config\",\n53|        path=f\"{PACKAGE}/decide.go\",\n54|        find=\"\\tif input.ConfigErr != nil {\\n\",\n55|        replace=\"\\tif input.ConfigErr != nil && input.Mode == ModeRestore {\\n\",\n56|        count=1,\n57|        run=\"TestDecideTable/refused_config_invalid\",\n58|        expect=\"KILLED\",\n59|        note=\"Admits exactly launch-mode invalid config; restore-mode still refuses.\",\n60|    ),\n61|    Mutant(\n62|        name=\"N-mode\",\n63|        path=f\"{PACKAGE}/decide.go\",\n64|        find=\"\\tif input.Mode != ModeLaunch && input.Mode != ModeRestore {\\n\",\n65|        replace='\\tif input.Mode != ModeLaunch && input.Mode != ModeRestore && input.Mode != Mode(\"\") {\\n',\n66|        count=1,\n67|        run=\"TestDecideTable/refused_empty_mode\",\n68|        expect=\"KILLED\",\n69|        note=\"Admits exactly the empty mode; every other non-mode still refuses.\",\n70|    ),\n71|    Mutant(\n72|        name=\"N-session\",\n73|        path=f\"{PACKAGE}/decide.go\",\n74|        find=\"\\tif !input.SessionKnown {\\n\",\n75|        replace=\"\\tif !input.SessionKnown && input.Mode == ModeRestore {\\n\",\n76|        count=1,\n77|        run=\"TestDecideTable/refused_unknown_session\",\n78|        expect=\"KILLED\",\n79|        note=\"Admits exactly launch-mode unknown sessions; restore-mode still refuses.\",\n80|    ),\n81|    Mutant(\n82|        name=\"N-idempotency\",\n83|        path=f\"{PACKAGE}/decide.go\",\n84|        find=\"\\tif input.ExistingBinding != nil && input.ExistingBinding.OperationID != input.BootstrapOperationID {\\n\",\n85|        replace=\"\\tif input.ExistingBinding != nil && input.ExistingBinding.OperationID != input.BootstrapOperationID && input.Mode == ModeRestore {\\n\",\n86|        count=1,\n87|        run=\"TestDecideTable/refused_idempotency_mismatch\",\n88|        expect=\"KILLED\",\n89|        note=\"Admits exactly launch-mode changed operations; restore-mode still refuses.\",\n90|    ),\n91|    Mutant(\n92|        name=\"N-caller\",\n93|        path=f\"{PACKAGE}/decide.go\",\n94|        find=\"\\tif caller != CallerForeground && caller != CallerBackground {\\n\",\n95|        replace='\\tif caller != CallerForeground && caller != CallerBackground && caller != \"batch\" {\\n',\n96|        count=1,\n97|        run=\"TestDecideTable/refused_unknown_caller\",\n98|        expect=\"KILLED\",\n99|        note=\"Admits exactly the batch caller; every other non-caller still refuses.\",\n100|    ),\n101|    Mutant(\n102|        name=\"N-backend-op\",\n103|        path=f\"{PACKAGE}/decide.go\",\n104|        find='\\toperation := \"create\"\\n\\tif input.Mode == ModeRestore {\\n\\t\\toperation = \"restore\"\\n\\t}\\n',\n105|        replace='\\toperation := \"create\"\\n\\tif input.Mode == ModeRestore {\\n\\t\\toperation = \"create\"\\n\\t}\\n',\n106|        count=1,\n107|        run=\"TestDecideRestoreRequiresRestoreCapability\",\n108|        expect=\"KILLED\",\n109|        note=\"Admits restore-mode callers to the create row; the mode selection stays.\",\n110|    ),\n111|    Mutant(\n112|        name=\"N-materialization\",\n113|        path=f\"{PACKAGE}/decide.go\",\n114|        find=\"\\tif input.MaterializationRequired && (!input.JournalOK || input.Journal.Phase != matjournal.PhaseCommitted) {\\n\",\n115|        replace=\"\\tif input.MaterializationRequired && (!input.JournalOK || (input.Journal.Phase != matjournal.PhaseCommitted && input.Journal.Phase != matjournal.PhaseStaging)) {\\n\",\n116|        count=1,\n117|        run=\"TestDecideTable/parked_materialization_not_committed\",\n118|        expect=\"KILLED\",\n119|        note=\"Admits exactly staging journals; absent and other phases still park.\",\n120|    ),\n121|    Mutant(\n122|        name=\"N-checkpoint-absent\",\n123|        path=f\"{PACKAGE}/decide.go\",\n124|        find=\"\\tif input.CheckpointRequired {\\n\",\n125|        replace=\"\\tif input.CheckpointRequired && len(input.CheckpointDoc) > 0 {\\n\",\n126|        count=1,\n127|        run=\"TestDecideTable/parked_checkpoint_absent\",\n128|        expect=\"KILLED\",\n129|        note=\"Admits exactly absent checkpoints; inadmissible bytes still park.\",\n130|    ),\n131|    Mutant(\n132|        name=\"N-checkpoint-prefix\",\n133|        path=f\"{PACKAGE}/decide.go\",\n134|        find=\"\\tif digest.String() != want {\\n\",\n135|        replace=\"\\tif digest.String()[:16] != want[:16] {\\n\",\n136|        count=1,\n137|        run=\"TestDecideTable/parked_checkpoint_flipped_digest\",\n138|        expect=\"KILLED\",\n139|        note=\"Admits exactly same-prefix digests; full comparison otherwise stays.\",\n140|    ),\n141|    Mutant(\n142|        name=\"N-identity-version\",\n143|        path=f\"{PACKAGE}/decide.go\",\n144|        find=\"\\tif err := provhost.VerifyIdentityBuild(facts.Identity, facts.Build); err != nil {\\n\",\n145|        replace='\\tif err := provhost.VerifyIdentityBuild(facts.Identity, facts.Build); err != nil && facts.Build.ProviderVersion != \"0.147.0\" {\\n',\n146|        count=1,\n147|        run=\"TestDecideTable/refused_provider_identity_other_provider\",\n148|        expect=\"KILLED\",\n149|        note=\"Admits exactly 0.147.0 identity mismatches; other versions still refuse.\",\n150|    ),\n151|    Mutant(\n152|        name=\"N-discovery\",\n153|        path=f\"{PACKAGE}/decide.go\",\n154|        find=\"\\tif facts.HasDiscovery {\\n\",\n155|        replace='\\tif facts.HasDiscovery && facts.DiscoveryContext.Home != \"\" {\\n',\n156|        count=1,\n157|        run=\"TestDecideTable/refused_discovery_empty_home\",\n158|        expect=\"KILLED\",\n159|        note=\"Admits exactly empty-home discovery; every other proof still verifies.\",\n160|    ),\n161|    Mutant(\n162|        name=\"N-smoke-verdict\",\n163|        path=f\"{PACKAGE}/decide.go\",\n164|        find=\"\\tif record.Verdict != resumesmoke.VerdictPass {\\n\",\n165|        replace=\"\\tif record.Verdict != resumesmoke.VerdictPass && record.Verdict != resumesmoke.VerdictFail {\\n\",\n166|        count=1,\n167|        run=\"TestDecideTable/refused_smoke_failing_verdict\",\n168|        expect=\"KILLED\",\n169|        note=\"Admits exactly failing verdicts; gated, unsupported, and unknown still refuse.\",\n170|    ),\n171|    Mutant(\n172|        name=\"N-smoke-version\",\n173|        path=f\"{PACKAGE}/decide.go\",\n174|        find=\"\"\"\\tif record.Tuple.ProviderID != build.ProviderID ||\n175|\\t\\trecord.Tuple.ProviderVersion != build.ProviderVersion ||\n176|\\t\\trecord.Tuple.Platform != build.Platform ||\n177|\\t\\trecord.Tuple.Architecture != build.Architecture {\n178|\"\"\",\n179|        replace=\"\"\"\\tif record.Tuple.ProviderID != build.ProviderID ||\n180|\\t\\trecord.Tuple.Platform != build.Platform ||\n181|\\t\\trecord.Tuple.Architecture != build.Architecture {\n182|\"\"\",\n183|        count=1,\n184|        run=\"TestDecideTable/refused_smoke_wrong_build\",\n185|        expect=\"KILLED\",\n186|        note=\"Admits exactly version drift; provider, platform, and arch still bind.\",\n187|    ),\n188|    Mutant(\n189|        name=\"N-smoke-mode\",\n190|        path=f\"{PACKAGE}/decide.go\",\n191|        find=\"\\tif !input.Smoke.Required {\\n\",\n192|        replace=\"\\tif !input.Smoke.Required || input.Mode == ModeLaunch {\\n\",\n193|        count=1,\n194|        run=\"TestDecideTable/refused_smoke_absent\",\n195|        expect=\"KILLED\",\n196|        note=\"Skips the required smoke exactly on launch; restore-mode still enforces it.\",\n197|    ),\n198|    Mutant(\n199|        name=\"N-profile-derive\",\n200|        path=f\"{PACKAGE}/decide.go\",\n201|        find=\"\"\"\\tpair, err := sessprofile.Derive(input.ProfileRecord, input.ProfileEvents)\n202|\\tif err != nil {\n203|\\t\\treturn refused(ClassIntegrityFailure, \"effective profile derivation failed\", err)\n204|\\t}\n205|\"\"\",\n206|        replace=\"\"\"\\tpair, err := sessprofile.Derive(input.ProfileRecord, input.ProfileEvents)\n207|\\tif err != nil && input.Provider.Build.ProviderID != \"codex\" {\n208|\\t\\treturn refused(ClassIntegrityFailure, \"effective profile derivation failed\", err)\n209|\\t}\n210|\"\"\",\n211|        count=1,\n212|        run=\"TestDecideTable/refused_profile_derivation_corrupt\",\n213|        expect=\"KILLED\",\n214|        note=\"Admits corrupt derivation exactly for codex, surfacing the wrong class.\",\n215|    ),\n216|    Mutant(\n217|        name=\"N-mapping\",\n218|        path=f\"{PACKAGE}/decide.go\",\n219|        find=\"\"\"\\tresolved, err := provhost.ResolveMapping(input.Provider.Build.ProviderID, pair.Profile, input.Provider.Build)\n220|\\tif err != nil {\n221|\\t\\treturn refused(ClassProfileMappingUnavailable, \"adapter cannot map the stored profile\", err)\n222|\\t}\n223|\"\"\",\n224|        replace=\"\"\"\\tresolved, err := provhost.ResolveMapping(input.Provider.Build.ProviderID, pair.Profile, input.Provider.Build)\n225|\\tif err != nil && pair.Profile != \"standard\" {\n226|\\t\\treturn refused(ClassProfileMappingUnavailable, \"adapter cannot map the stored profile\", err)\n227|\\t}\n228|\"\"\",\n229|        count=1,\n230|        run=\"TestDecideTable/refused_profile_mapping_unavailable\",\n231|        expect=\"KILLED\",\n232|        note=\"Admits exactly standard mapping gaps; yolo gaps still refuse.\",\n233|    ),\n234|    Mutant(\n235|        name=\"N-realm\",\n236|        path=f\"{PACKAGE}/decide.go\",\n237|        find=\"\\tif input.Realm.Caller != CallerBackground {\\n\",\n238|        replace='\\tif input.Realm.Caller != CallerBackground || input.Realm.BrokerState == \"broker-running\" {\\n',\n239|        count=1,\n240|        run=\"TestDecideTable/refused_realm_background_no_server\",\n241|        expect=\"KILLED\",\n242|        note=\"Admits exactly broker-running background callers; other states still refuse.\",\n243|    ),\n244|    Mutant(\n245|        name=\"N-entrypoint\",\n246|        path=f\"{PACKAGE}/decide.go\",\n247|        find=\"\\tif err := terminalbackend.CheckEntrypoint(input.Entrypoint, input.SessionID); err != nil {\\n\",\n248|        replace=\"\\tif err := terminalbackend.CheckEntrypoint(input.Entrypoint, input.SessionID); err != nil && len(input.Entrypoint) != 2 {\\n\",\n249|        count=1,\n250|        run=\"TestDecideTable/refused_entrypoint_raw_provider\",\n251|        expect=\"KILLED\",\n252|        note=\"Admits exactly two-element argv; other arities still refuse.\",\n253|    ),\n254|    Mutant(\n255|        name=\"N-descriptor\",\n256|        path=f\"{PACKAGE}/decide.go\",\n257|        find=\"\"\"\\tdescriptor, err := terminalbackend.AdmitProviderDescriptor(input.Descriptor, input.HostBinding)\n258|\\tif err != nil {\n259|\\t\\treturn refused(backendClass(err), \"provider descriptor does not match the validated binding\", err)\n260|\\t}\n261|\"\"\",\n262|        replace=\"\"\"\\tdescriptor, err := terminalbackend.AdmitProviderDescriptor(input.Descriptor, input.HostBinding)\n263|\\tif err != nil && input.Mode != ModeLaunch {\n264|\\t\\treturn refused(backendClass(err), \"provider descriptor does not match the validated binding\", err)\n265|\\t}\n266|\"\"\",\n267|        count=1,\n268|        run=\"TestDecideTable/refused_descriptor_generation_drift\",\n269|        expect=\"KILLED\",\n270|        note=\"Admits exactly launch-mode descriptor mismatch; restore-mode still refuses.\",\n271|    ),\n272|    Mutant(\n273|        name=\"N-attach\",\n274|        path=f\"{PACKAGE}/decide.go\",\n275|        find='\\tif input.RemoteInteractive && terminalbackend.CheckOperation(\"attach\", admitted) == nil {\\n',\n276|        replace=\"\\tif input.RemoteInteractive {\\n\",\n277|        count=1,\n278|        run=\"TestDecideTable/takeover_offer_attach_unproven\",\n279|        expect=\"KILLED\",\n280|        note=\"Admits remote attach without the capability; non-interactive still offers takeover.\",\n281|    ),\n282|    Mutant(\n283|        name=\"N-reattach\",\n284|        path=f\"{PACKAGE}/decide.go\",\n285|        find=\"\"\"\\tif input.ExistingBinding != nil {\n286|\\t\\tdecision.Action = ActionReattach\n287|\"\"\",\n288|        replace=\"\"\"\\tif input.ExistingBinding != nil && input.Mode == ModeRestore {\n289|\\t\\tdecision.Action = ActionReattach\n290|\"\"\",\n291|        count=1,\n292|        run=\"TestDecideTable/reattach_same_pair\",\n293|        expect=\"KILLED\",\n294|        note=\"Selects launch instead of reattach exactly on launch mode.\",\n295|    ),\n296|    Mutant(\n297|        name=\"N-binding-prefix\",\n298|        path=f\"{PACKAGE}/binding.go\",\n299|        find=\"\\t\\t\\tif winner.OperationID != operationID {\\n\",\n300|        replace=\"\\t\\t\\tif winner.OperationID[:8] != operationID[:8] {\\n\",\n301|        count=1,\n302|        run=\"TestBindConcurrentChangedOperationRefuses\",\n303|        expect=\"KILLED\",\n304|        note=\"Admits exactly same-prefix changed operations; full comparison otherwise stays.\",\n305|    ),\n306|    Mutant(\n307|        name=\"N-binding-session\",\n308|        path=f\"{PACKAGE}/binding.go\",\n309|        find=\"\\tif binding.SessionID != sessionID {\\n\",\n310|        replace=\"\\tif binding.SessionID[:8] != sessionID[:8] {\\n\",\n311|        count=1,\n312|        run=\"TestStatusSessionMismatchRefuses\",\n313|        expect=\"KILLED\",\n314|        note=\"Admits exactly same-prefix foreign sessions; full comparison otherwise stays.\",\n315|    ),\n316|    Mutant(\n317|        name=\"N-parked-reason\",\n318|        path=f\"{PACKAGE}/events.go\",\n319|        find='\\tdefault:\\n\\t\\treturn nil, fmt.Errorf(\"parked reason %q is not the session.parked vocabulary\", string(reason))\\n\\t}\\n',\n320|        replace='\\tdefault:\\n\\t\\tif len(reason) != 5 {\\n\\t\\t\\treturn nil, fmt.Errorf(\"parked reason %q is not the session.parked vocabulary\", string(reason))\\n\\t\\t}\\n\\t}\\n',\n321|        count=1,\n322|        run=\"TestParkedPayloadVocabulary\",\n323|        expect=\"KILLED\",\n324|        note=\"Admits exactly five-letter reasons; the vocabulary check otherwise stays.\",\n325|    ),\n326|    Mutant(\n327|        name=\"C-doc-comment\",\n328|        path=f\"{PACKAGE}/doc.go\",\n329|        find=\"// `ax pane SESSION_ID` enforcement wrapper: the decision every managed\\n\",\n330|        replace=\"// `ax pane SESSION_ID` enforcement wrapper (control): the decision every managed\\n\",\n331|        count=1,\n332|        run=\"TestRealmCarriesNoCachedEvidence\",\n333|        expect=\"SURVIVED\",\n334|        note=\"Harmless control: a comment-only edit must survive.\",\n335|    ),\n336|]\n337|\n338|\n339|def run_mutant(mutant: Mutant) -> str:\n340|    target = REPO / mutant.path\n341|    original = target.read_text()\n342|    found = original.count(mutant.find)\n343|    if found != mutant.count:\n344|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\"\n345|    with tempfile.TemporaryDirectory() as staging:\n346|        backup = Path(staging) / \"backup\"\n347|        shutil.copy2(target, backup)\n348|        try:\n349|            target.write_text(original.replace(mutant.find, mutant.replace))\n350|            run = subprocess.run(\n351|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n352|                cwd=REPO,\n353|                capture_output=True,\n354|                text=True,\n355|                timeout=300,\n356|            )\n357|        finally:\n358|            shutil.copy2(backup, target)\n359|    output = (run.stdout + run.stderr).strip()\n360|    if os.environ.get(\"AX_MUTANT_VERBOSE\") == \"1\":\n361|        print(f\"--- raw: {mutant.name}: exit {run.returncode} ---\", flush=True)\n362|        print(output, flush=True)\n363|        print(f\"--- end raw: {mutant.name} ---\", flush=True)\n364|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n365|        return f\"ERROR: {mutant.name}: build broke under the patch\"\n366|    if run.returncode == 0:\n367|        verdict = \"SURVIVED\"\n368|    elif '--- FAIL' in output or 'FAIL:' in output:\n369|        verdict = \"KILLED\"\n370|    else:\n371|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\"\n372|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n373|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note} [exit {run.returncode}]\"\n374|\n375|\n376|def main(argv: list[str]) -> int:\n377|    selected = [m for m in MUTANTS if not argv or m.name in argv]\n378|    if argv and len(selected) != len(argv):\n379|        unknown = sorted(set(argv) - {m.name for m in selected})\n380|        print(f\"unknown mutants: {', '.join(unknown)}\")\n381|        return 2\n382|    failures = 0\n383|    for mutant in selected:\n384|        try:\n385|            line = run_mutant(mutant)\n386|        except subprocess.TimeoutExpired:\n387|            line = f\"ERROR: {mutant.name}: killer timed out\"\n388|        print(line, flush=True)\n389|        if not line.startswith(\"ok:\"):\n390|            failures += 1\n391|    return 1 if failures else 0\n392|\n393|\n394|if __name__ == \"__main__\":\n395|    sys.exit(main(sys.argv[1:]))","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
