{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c939","stream":{"kind":"session","id":"01a0b194-ebfd-7972-8291-a2a8c88f871f"},"sequence":759,"recorded_at":1780531400001513,"record_type":"event","durability":"durable","causation_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","run_stream":{"kind":"run","id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e"},"task_stream":{"kind":"task","id":"01a0b197-4934-7cd2-a757-a6c5a39a0e04"},"task_id":"01a0b197-4934-7cd2-a757-a6c5a39a0e04","event":{"kind":"output","task_id":"01a0b197-4934-7cd2-a757-a6c5a39a0e04","chunk":"Read text file `internal/axpane/rev3_test.go`.\n(499 line(s) above)\n500|\t}\n501|}\n502|\n503|// TestLookupSessionMismatchRefuses pins the pair receipt's\n504|// binding-to-directory checks: a receipt read under another\n505|// session, or under another operation, refuses.\n506|func TestLookupSessionMismatchRefuses(t *testing.T) {\n507|\tt.Parallel()\n508|\tt.Run(\"session\", func(t *testing.T) {\n509|\t\tt.Parallel()\n510|\t\tstore := openPaneStore(t)\n511|\t\tif _, _, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate()); err != nil {\n512|\t\t\tt.Fatal(err)\n513|\t\t}\n514|\t\traw, err := os.ReadFile(store.receiptPath(fixtureSession, fixtureBootstrap))\n515|\t\tif err != nil {\n516|\t\t\tt.Fatal(err)\n517|\t\t}\n518|\t\tforeignReceipts := store.receiptsDir(fixtureForeign)\n519|\t\tif err := os.MkdirAll(foreignReceipts, 0o755); err != nil {\n520|\t\t\tt.Fatal(err)\n521|\t\t}\n522|\t\tif err := os.WriteFile(filepath.Join(foreignReceipts, fixtureBootstrap+\".json\"), raw, 0o600); err != nil {\n523|\t\t\tt.Fatal(err)\n524|\t\t}\n525|\t\tif _, found, err := store.Lookup(fixtureForeign, fixtureBootstrap); err == nil || found {\n526|\t\t\tt.Fatalf(\"Lookup(foreign) = (%v, %v), want the session-mismatch error\", found, err)\n527|\t\t}\n528|\t})\n529|\tt.Run(\"operation\", func(t *testing.T) {\n530|\t\tt.Parallel()\n531|\t\tstore := openPaneStore(t)\n532|\t\tif _, _, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate()); err != nil {\n533|\t\t\tt.Fatal(err)\n534|\t\t}\n535|\t\traw, err := os.ReadFile(store.receiptPath(fixtureSession, fixtureBootstrap))\n536|\t\tif err != nil {\n537|\t\t\tt.Fatal(err)\n538|\t\t}\n539|\t\tif err := os.WriteFile(filepath.Join(store.receiptsDir(fixtureSession), fixtureOtherOp+\".json\"), raw, 0o600); err != nil {\n540|\t\t\tt.Fatal(err)\n541|\t\t}\n542|\t\tif _, found, err := store.Lookup(fixtureSession, fixtureOtherOp); err == nil || found {\n543|\t\t\tt.Fatalf(\"Lookup(other op) = (%v, %v), want the operation-mismatch error\", found, err)\n544|\t\t}\n545|\t})\n546|}\n547|\n548|// TestRunNoCkptStoreWinnerCheckpointFails pins P2-2: a winner that\n549|// carries a checkpoint with no checkpoint store bound fails the\n550|// run — an absent store is unknown, not \"no closure\". With the\n551|// store bound, the same launch carries the closure pair.\n552|func TestRunNoCkptStoreWinnerCheckpointFails(t *testing.T) {\n553|\tt.Parallel()\n554|\tworld := buildRunWorld(t)\n555|\tsuccessor := \"cccccccc-dddd-4eee-8fff-000000000001\"\n556|\tsuccessorLease(t, world.repo, successor, fixtureLocalHost, world.ckptID)\n557|\tchanged := appendChainEvent(t, world.repo, \"profile.changed\", 1, fixtureLeaseA, 2, world.headID, map[string]any{\n558|\t\t\"from\": \"standard\", \"to\": \"yolo\", \"confirmed\": true,\n559|\t})\n560|\trequest := runRequest(t, world)\n561|\trequest.Mode = ModeLaunch\n562|\trequest.BootstrapOperationID = fixtureOtherOp\n563|\trequest.Presented = fencing.PresentedToken{SessionID: fixtureSession, Epoch: 2, LeaseID: successor}\n564|\tstores := world.stores()\n565|\tstores.Ckpt = nil\n566|\toutcome, err := Run(stores, request)\n567|\tif err == nil {\n568|\t\tt.Fatalf(\"Run() without a checkpoint store succeeded with %+v, want the store error\", outcome.Decision)\n569|\t}\n570|\tif outcome.Decision.Action != \"\" {\n571|\t\tt.Fatalf(\"Run() without a checkpoint store decides %q, want no decision\", outcome.Decision.Action)\n572|\t}\n573|\t// Control: with the store bound the launch carries the\n574|\t// winner checkpoint's closure, never the head pair.\n575|\tcontrol, err := Run(world.stores(), request)\n576|\tif err != nil {\n577|\t\tt.Fatalf(\"Run() control error = %v\", err)\n578|\t}\n579|\tif control.Decision.Action != ActionLaunch {\n580|\t\tt.Fatalf(\"Run() control action = %q, want launch\", control.Decision.Action)\n581|\t}\n582|\tif control.Decision.Profile.Profile != \"standard\" || control.Decision.Profile.HasSource {\n583|\t\tt.Fatalf(\"Run() control profile = %+v, want standard with no source from the closure\", control.Decision.Profile)\n584|\t}\n585|\tif control.Decision.Profile.Source == changed {\n586|\t\tt.Fatalf(\"Run() control profile source = head %s, want the checkpoint closure\", changed[:20])\n587|\t}\n588|}\n589|\n590|// TestRunCreateFromStoppedPostWindow pins P3-2 through Run:\n591|// launch-mode create from a stopped, checkpoint-published session\n592|// with a changed bootstrap operation launches with its own pair\n593|// receipt.\n594|func TestRunCreateFromStoppedPostWindow(t *testing.T) {\n595|\tt.Parallel()\n596|\tworld := buildRunWorld(t)\n597|\tif _, err := Run(world.stores(), runRequest(t, world)); err != nil {\n598|\t\tt.Fatal(err)\n599|\t}\n600|\tsuccessor := \"cccccccc-dddd-4eee-8fff-000000000001\"\n601|\tsuccessorLease(t, world.repo, successor, fixtureLocalHost, world.ckptID)\n602|\tworld.headID = publishCheckpoint(t, world.repo, world.headID, 2, world.ckptID)\n603|\trequest := runRequest(t, world)\n604|\trequest.Mode = ModeLaunch\n605|\trequest.BootstrapOperationID = fixtureOtherOp\n606|\trequest.InstanceID = \"0198f4c9-2222-7bbb-8bbb-1234567890ab\"\n607|\trequest.Presented = fencing.PresentedToken{SessionID: fixtureSession, Epoch: 2, LeaseID: successor}\n608|\toutcome, err := Run(world.stores(), request)\n609|\tif err != nil {\n610|\t\tt.Fatalf(\"Run() error = %v\", err)\n611|\t}\n612|\tif outcome.Decision.Action != ActionLaunch {\n613|\t\tt.Fatalf(\"Run() action = %q, class %q, cause %v, want launch for create-from-stopped\",\n614|\t\t\toutcome.Decision.Action, outcome.Decision.Class, outcome.Decision.Cause)\n615|\t}\n616|\tif outcome.Binding == nil || outcome.Binding.OperationID != fixtureOtherOp {\n617|\t\tt.Fatalf(\"Run() binding = %+v, want the op2 pair receipt\", outcome.Binding)\n618|\t}\n619|}\n620|\n621|// TestDecideForegroundCredentialRequiresRealm pins P3-4: the §4.C\n622|// credential conditional applies to every caller, so a foreground\n623|// caller on a credential-requiring path authorizes only through\n624|// the admitted realm row — a passing smoke record plus\n625|// caller-supplied target claims never suffice alone.\n626|func TestDecideForegroundCredentialRequiresRealm(t *testing.T) {\n627|\tt.Parallel()\n628|\tdeps := buildDecideDeps(t, true)\n629|\tinput := validInput(t, deps)\n630|\tinput.Realm.Caller = CallerForeground\n631|\tinput.Smoke.Required = true\n632|\tinput.Smoke.Record = smokeRecord(t, \"pass\", \"A\", passingSmokeChecks(), smokeTuple())\n633|\tinput.Smoke.Target = smokeTarget()\n634|\tdecision := Decide(input)\n635|\tif decision.Action != ActionRefused || decision.Class != \"capability_unavailable\" {\n636|\t\tt.Fatalf(\"Decide() = (%q, %q), want refused capability_unavailable for foreground without the realm row\",\n637|\t\t\tdecision.Action, decision.Class)\n638|\t}\n639|\tif decision.RealmFailure == nil {\n640|\t\tt.Fatal(\"Decide() capability_unavailable carries no typed failure\")\n641|\t}\n642|}\n643|\n644|// TestDecideRealmEvidenceOrderIndependent pins P3-5: the realm\n645|// cross-bind accepts when any admitted realm object binds this\n646|// host and build, so the outcome never depends on evidence order.\n647|func TestDecideRealmEvidenceOrderIndependent(t *testing.T) {\n648|\tt.Parallel()\n649|\tlaunch := func(t *testing.T, swap bool) Decision {\n650|\t\tt.Helper()\n651|\t\tdeps := buildDecideDeps(t, true)\n652|\t\taddRealmEvidence(t, deps.universe, seedDigest(0xB2), \"codex\", \"0.147.0\")\n653|\t\taddSecondRealmEvidence(t, deps.universe, seedDigest(0xB1), \"codex\", \"0.147.0\")\n654|\t\tif swap {\n655|\t\t\tlast := len(deps.universe.evidence) - 1\n656|\t\t\tdeps.universe.evidence[last-1], deps.universe.evidence[last] = deps.universe.evidence[last], deps.universe.evidence[last-1]\n657|\t\t}\n658|\t\tinput := validInput(t, deps)\n659|\t\tinput.Realm.Caller = CallerBackground\n660|\t\treturn Decide(input)\n661|\t}\n662|\tt.Run(\"foreign_first\", func(t *testing.T) {\n663|\t\tt.Parallel()\n664|\t\tdecision := launch(t, false)\n665|\t\tif decision.Action != ActionLaunch {\n666|\t\t\tt.Fatalf(\"Decide() = (%q, %q, %v), want launch with the binding object second\",\n667|\t\t\t\tdecision.Action, decision.Class, decision.Cause)\n668|\t\t}\n669|\t})\n670|\tt.Run(\"binding_first\", func(t *testing.T) {\n671|\t\tt.Parallel()\n672|\t\tdecision := launch(t, true)\n673|\t\tif decision.Action != ActionLaunch {\n674|\t\t\tt.Fatalf(\"Decide() = (%q, %q, %v), want launch with the binding object first\",\n675|\t\t\t\tdecision.Action, decision.Class, decision.Cause)\n676|\t\t}\n677|\t})\n678|\tt.Run(\"none_binds\", func(t *testing.T) {\n679|\t\tt.Parallel()\n680|\t\tdeps := buildDecideDeps(t, true)\n681|\t\taddRealmEvidence(t, deps.universe, seedDigest(0xB2), \"codex\", \"0.147.0\")\n682|\t\taddSecondRealmEvidence(t, deps.universe, seedDigest(0xB3), \"codex\", \"0.147.0\")\n683|\t\tinput := validInput(t, deps)\n684|\t\tinput.Realm.Caller = CallerBackground\n685|\t\tdecision := Decide(input)\n686|\t\tif decision.Action != ActionRefused || decision.Class != \"capability_unavailable\" {\n687|\t\t\tt.Fatalf(\"Decide() = (%q, %q), want refused when no realm object binds\", decision.Action, decision.Class)\n688|\t\t}\n689|\t})\n690|}\n691|\n692|// TestDecideExpiredRealmRowRefusesUnavailable pins P3-6: a\n693|// background caller whose only realm evidence expired at the\n694|// admission instant refuses the §4.2 capability_unavailable with\n695|// typed realm/readiness details — not the reconcile class — with\n696|// the liveness failure as the cause.\n697|func TestDecideExpiredRealmRowRefusesUnavailable(t *testing.T) {\n698|\tt.Parallel()\n699|\tdeps := buildDecideDeps(t, true)\n700|\taddRealmEvidence(t, deps.universe, seedDigest(0xB1), \"codex\", \"0.147.0\")\n701|\tdeps.universe.now = deps.universe.now.AddDate(2, 0, 0)\n702|\tinput := validInput(t, deps)\n703|\tinput.Realm.Caller = CallerBackground\n704|\tdecision := Decide(input)\n705|\tif decision.Action != ActionRefused || decision.Class != \"capability_unavailable\" {\n706|\t\tt.Fatalf(\"Decide() = (%q, %q, %v), want refused capability_unavailable for the expired realm row\",\n707|\t\t\tdecision.Action, decision.Class, decision.Cause)\n708|\t}\n709|\tif decision.RealmFailure == nil {\n710|\t\tt.Fatal(\"Decide() capability_unavailable carries no typed failure\")\n711|\t}\n712|\t// The admission-branch detail pins the dead-realm mapping\n713|\t// (not the no-row arm): the reconcile liveness failure is\n714|\t// the typed refusal's cause.\n715|\tif decision.Detail != \"caller has no usable realm evidence\" {\n716|\t\tt.Fatalf(\"Decide() detail = %q, want the dead-realm mapping\", decision.Detail)\n717|\t}\n718|\tinner := errors.Unwrap(decision.Cause)\n719|\tif inner == nil || !strings.Contains(inner.Error(), \"evidence liveness\") {\n720|\t\tt.Fatalf(\"Decide() cause chain = %v, want the reconcile liveness failure\", decision.Cause)\n721|\t}\n722|}\n723|\n724|// TestDecidePreRebootRealmRowRefusesUnavailable pins P3-6: a\n725|// background caller whose realm evidence binds a superseded\n726|// generation (the raw generation moved) refuses the §4.2\n727|// capability_unavailable with typed details, not\n728|// terminal_backend_stale_generation.\n729|func TestDecidePreRebootRealmRowRefusesUnavailable(t *testing.T) {\n730|\tt.Parallel()\n731|\tdeps := buildDecideDeps(t, true)\n732|\taddRealmEvidence(t, deps.universe, seedDigest(0xB1), \"codex\", \"0.147.0\")\n733|\tinput := validInput(t, deps)\n734|\tinput.Realm.Caller = CallerBackground\n735|\tinput.Realm.ServerGeneration = \"generation-beta\"\n736|\tinput.Backend.RawGeneration = \"generation-beta\"\n737|\tdecision := Decide(input)\n738|\tif decision.Action != ActionRefused || decision.Class != \"capability_unavailable\" {\n739|\t\tt.Fatalf(\"Decide() = (%q, %q, %v), want refused capability_unavailable for the pre-reboot realm row\",\n740|\t\t\tdecision.Action, decision.Class, decision.Cause)\n741|\t}\n742|\tif decision.RealmFailure == nil {\n743|\t\tt.Fatal(\"Decide() capability_unavailable carries no typed failure\")\n744|\t}\n745|}\n746|\n747|// TestDecideLiveRealmRowBackendFaultStands bounds P3-6: with a\n748|// usable realm row submitted, an unrelated backend fault keeps\n749|// its own class instead of wearing capability_unavailable.\n750|func TestDecideLiveRealmRowBackendFaultStands(t *testing.T) {\n751|\tt.Parallel()\n752|\tdeps := buildDecideDeps(t, true)\n753|\taddRealmEvidence(t, deps.universe, seedDigest(0xB1), \"codex\", \"0.147.0\")\n754|\tinput := validInput(t, deps)\n755|\tinput.Realm.Caller = CallerBackground\n756|\t// Protocol drift is unrelated to the realm evidence: the\n757|\t// backend mismatch stands.\n758|\tdeps.universe.probe[\"protocol_version\"] = \"2.0.0\"\n759|\tdeps.universe.probe[\"probe_id\"] = omitSelfIdentity(t, deps.universe.probe, \"probe_id\")\n760|\tinput.Backend = deps.universe.facts(t)\n761|\tdecision := Decide(input)\n762|\tif decision.Action != ActionRefused || decision.Class != terminalbackend.CodeMismatch {\n763|\t\tt.Fatalf(\"Decide() = (%q, %q, %v), want refused manifest_probe_mismatch with a usable realm row\",\n764|\t\t\tdecision.Action, decision.Class, decision.Cause)\n765|\t}\n766|}","final_result":true}}}
