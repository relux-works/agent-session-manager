{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9bb","stream":{"kind":"session","id":"01a0b194-ebfd-7972-8291-a2a8c88f871f"},"sequence":824,"recorded_at":1780531400001643,"record_type":"event","durability":"durable","causation_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","run_stream":{"kind":"run","id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e"},"call_id":"call_01a0b19765ab70bb9605d1673dc8b7bb","text":"Read text file `internal/axpane/rework_test.go`.\n(499 line(s) above)\n500|// profile.changed authored under the superseded lease after a local\n501|// successor won never becomes the launch profile. On rev1 this\n502|// drove yolo/E2.\n503|func TestLosingLeaseProfileEventIgnored(t *testing.T) {\n504|\tt.Parallel()\n505|\tworld := buildRunWorld(t)\n506|\tleases, err := world.repo.ListLeases(fixtureSession)\n507|\tif err != nil {\n508|\t\tt.Fatal(err)\n509|\t}\n510|\tsuccessor := \"cccccccc-dddd-4eee-8fff-000000000002\"\n511|\tif _, err := world.repo.CompareAndSwapLease(fixtureSession, sessrepo.LeaseExpectation{RecordID: leases[0].RecordID}, sessrepo.SuccessorLeaseInput{\n512|\t\tCreateLeaseInput: sessrepo.CreateLeaseInput{LeaseID: successor, HolderHostID: fixtureLocalHost, IssuedByHostID: fixtureLocalHost, CreatedAt: fixtureCreatedAt},\n513|\t\tReason:           \"graceful_takeover\",\n514|\t\tCheckpointID:     world.ckptID,\n515|\t}); err != nil {\n516|\t\tt.Fatalf(\"CompareAndSwapLease() error = %v\", err)\n517|\t}\n518|\tchanged := appendChainEvent(t, world.repo, \"profile.changed\", 1, fixtureLeaseA, 2, world.headID, map[string]any{\n519|\t\t\"from\": \"standard\", \"to\": \"yolo\", \"confirmed\": true,\n520|\t})\n521|\trequest := runRequest(t, world)\n522|\trequest.Presented = fencing.PresentedToken{SessionID: fixtureSession, Epoch: 2, LeaseID: successor}\n523|\toutcome, err := Run(world.stores(), request)\n524|\tif err != nil {\n525|\t\tt.Fatalf(\"Run() error = %v\", err)\n526|\t}\n527|\tif outcome.Decision.Action == ActionLaunch && outcome.Decision.Profile.Source == changed {\n528|\t\tt.Fatalf(\"Run() launch profile source = losing-lease %s, want the checkpoint closure\", changed[:20])\n529|\t}\n530|\tif outcome.Decision.Action == ActionLaunch && outcome.Decision.Profile.Profile != \"standard\" {\n531|\t\tt.Fatalf(\"Run() launch profile = %+v, want standard from the closure\", outcome.Decision.Profile)\n532|\t}\n533|}\n534|\n535|// TestDecideRealmBindingMismatchRefuses pins P1-2: realm evidence\n536|// bound to another host binding or provider build refuses\n537|// capability_unavailable, never launches.\n538|func TestDecideRealmBindingMismatchRefuses(t *testing.T) {\n539|\tt.Parallel()\n540|\tt.Run(\"binding\", func(t *testing.T) {\n541|\t\tt.Parallel()\n542|\t\tdeps := buildDecideDeps(t, true)\n543|\t\taddRealmEvidence(t, deps.universe, seedDigest(0xB2), \"codex\", \"0.147.0\")\n544|\t\tinput := validInput(t, deps)\n545|\t\tinput.Realm.Caller = CallerBackground\n546|\t\tdecision := Decide(input)\n547|\t\tif decision.Action != ActionRefused || decision.Class != \"capability_unavailable\" {\n548|\t\t\tt.Fatalf(\"Decide() = (%q, %q), want refused for binding mismatch\", decision.Action, decision.Class)\n549|\t\t}\n550|\t})\n551|\tt.Run(\"build\", func(t *testing.T) {\n552|\t\tt.Parallel()\n553|\t\tdeps := buildDecideDeps(t, true)\n554|\t\taddRealmEvidence(t, deps.universe, seedDigest(0xB1), \"codex\", \"9.9.9\")\n555|\t\tinput := validInput(t, deps)\n556|\t\tinput.Realm.Caller = CallerBackground\n557|\t\tdecision := Decide(input)\n558|\t\tif decision.Action != ActionRefused || decision.Class != \"capability_unavailable\" {\n559|\t\t\tt.Fatalf(\"Decide() = (%q, %q), want refused for build mismatch\", decision.Action, decision.Class)\n560|\t\t}\n561|\t})\n562|\tt.Run(\"generation\", func(t *testing.T) {\n563|\t\tt.Parallel()\n564|\t\tdeps := buildDecideDeps(t, true)\n565|\t\taddRealmEvidence(t, deps.universe, seedDigest(0xB1), \"codex\", \"0.147.0\")\n566|\t\tinput := validInput(t, deps)\n567|\t\tinput.Realm.Caller = CallerBackground\n568|\t\tinput.Realm.ServerGeneration = \"generation-stale\"\n569|\t\tdecision := Decide(input)\n570|\t\tif decision.Action != ActionRefused || decision.Class != \"capability_unavailable\" {\n571|\t\t\tt.Fatalf(\"Decide() = (%q, %q), want refused for stale generation\", decision.Action, decision.Class)\n572|\t\t}\n573|\t})\n574|}\n575|\n576|// TestEmitParkedUnfoldableRefuses pins P1-1 through the direct\n577|// EmitParked entry: a restore_policy park from a creating chain\n578|// refuses, never appends. On rev1 this appended creating -> parked.\n579|func TestEmitParkedUnfoldableRefuses(t *testing.T) {\n580|\tt.Parallel()\n581|\tdeps := buildDecideDeps(t, true)\n582|\tinput := validInput(t, deps)\n583|\tinput.MaterializationRequired = true\n584|\tinput.JournalOK = true\n585|\tdecision := Decide(input)\n586|\tif decision.Action != ActionParked {\n587|\t\tt.Fatalf(\"Decide() action = %q, want parked\", decision.Action)\n588|\t}\n589|\t_, tail, err := ChainTail(deps.repo, fixtureSession)\n590|\tif err != nil {\n591|\t\tt.Fatal(err)\n592|\t}\n593|\tobservation := fixtureObservation(fixtureNow())\n594|\tif _, _, err := EmitParked(deps.repo, decision, EmitParams{\n595|\t\tSessionID: fixtureSession, CreatedByHost: fixtureLocalHost,\n596|\t\tLeaseEpoch: 1, LeaseID: fixtureLeaseA, LeaseSequence: tail.LeaseSequence + 1,\n597|\t\tPredecessors: []string{tail.EventID}, CreatedAt: fixtureCreatedAt,\n598|\t\tPresented:   fixturePresented(),\n599|\t\tObservation: observation,\n600|\t}); err == nil {\n601|\t\tt.Fatal(\"EmitParked from creating succeeded, want refusal\")\n602|\t}\n603|}\n604|\n605|// TestDecideSmokeTargetBindingRefuses pins P1-2: a required smoke\n606|// with a typed target bound to another build or OS version refuses\n607|// target_auth_missing, never launches.\n608|func TestDecideSmokeTargetBindingRefuses(t *testing.T) {\n609|\tt.Parallel()\n610|\tt.Run(\"build\", func(t *testing.T) {\n611|\t\tt.Parallel()\n612|\t\tdeps := buildDecideDeps(t, true)\n613|\t\tinput := validInput(t, deps)\n614|\t\tinput.Smoke.Required = true\n615|\t\tinput.Smoke.Record = smokeRecord(t, \"pass\", \"A\", passingSmokeChecks(), smokeTuple())\n616|\t\ttarget := smokeTarget()\n617|\t\ttarget.ProviderBuild = \"9.9.9\"\n618|\t\tinput.Smoke.Target = target\n619|\t\tdecision := Decide(input)\n620|\t\tif decision.Action != ActionRefused || decision.Class != \"target_auth_missing\" {\n621|\t\t\tt.Fatalf(\"Decide() = (%q, %q), want refused target_auth_missing for target build drift\", decision.Action, decision.Class)\n622|\t\t}\n623|\t})\n624|\tt.Run(\"os\", func(t *testing.T) {\n625|\t\tt.Parallel()\n626|\t\tdeps := buildDecideDeps(t, true)\n627|\t\tinput := validInput(t, deps)\n628|\t\tinput.Smoke.Required = true\n629|\t\tinput.Smoke.Record = smokeRecord(t, \"pass\", \"A\", passingSmokeChecks(), smokeTuple())\n630|\t\ttarget := smokeTarget()\n631|\t\ttarget.MacOSVersion = \"15.0\"\n632|\t\tinput.Smoke.Target = target\n633|\t\tdecision := Decide(input)\n634|\t\tif decision.Action != ActionRefused || decision.Class != \"target_auth_missing\" {\n635|\t\t\tt.Fatalf(\"Decide() = (%q, %q), want refused target_auth_missing for target OS drift\", decision.Action, decision.Class)\n636|\t\t}\n637|\t})\n638|}\n639|\n640|// TestIsFencingRefusal covers the Run emission error classifier: a\n641|// fencing gate refusal parks without evidence, while a repository\n642|// failure propagates.\n643|func TestIsFencingRefusal(t *testing.T) {\n644|\tt.Parallel()\n645|\tif isFencingRefusal(nil) {\n646|\t\tt.Fatal(\"isFencingRefusal(nil) = true, want false\")\n647|\t}\n648|\tif !isFencingRefusal(fencing.ErrNotOwner) {\n649|\t\tt.Fatal(\"isFencingRefusal(ErrNotOwner) = false, want true\")\n650|\t}\n651|\tif isFencingRefusal(errCheckpointMembers()) {\n652|\t\tt.Fatal(\"isFencingRefusal(checkpoint) = true, want false\")\n653|\t}\n654|}\n655|\n656|// TestBindSweepsStaleStaging pins P3-1: a pre-commit crash staging\n657|// file older than a minute is swept by the next Bind, while fresh\n658|// concurrent staging is left alone.\n659|func TestBindSweepsStaleStaging(t *testing.T) {\n660|\tt.Parallel()\n661|\tstore := openPaneStore(t)\n662|\tdir := store.sessionDir(fixtureSession)\n663|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n664|\t\tt.Fatal(err)\n665|\t}\n666|\tstale := filepath.Join(dir, \"binding-9999999999.tmp\")\n667|\tif err := os.WriteFile(stale, []byte(\"stale\"), 0o600); err != nil {\n668|\t\tt.Fatal(err)\n669|\t}\n670|\told := time.Now().Add(-2 * time.Minute)\n671|\tif err := os.Chtimes(stale, old, old); err != nil {\n672|\t\tt.Fatal(err)\n673|\t}\n674|\tif _, _, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate()); err != nil {\n675|\t\tt.Fatalf(\"Bind() error = %v\", err)\n676|\t}\n677|\tif _, err := os.Stat(stale); !os.IsNotExist(err) {\n678|\t\tt.Fatalf(\"stale staging file survives Bind: %v\", err)\n679|\t}\n680|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9bd","stream":{"kind":"session","id":"01a0b194-ebfd-7972-8291-a2a8c88f871f"},"sequence":825,"recorded_at":1780531400001645,"record_type":"event","durability":"durable","causation_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","run_stream":{"kind":"run","id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e"},"call_id":"call_01a0b19767cf706d9b70db2b7956a84f","text":"Read text file `internal/axpane/binding_test.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n13|)\n14|\n15|func openPaneStore(t *testing.T) *Store {\n16|\tt.Helper()\n17|\tstore, err := Open(t.TempDir())\n18|\tif err != nil {\n19|\t\tt.Fatalf(\"Open() error = %v\", err)\n20|\t}\n21|\treturn store\n22|}\n23|\n24|func bindCandidate() Binding {\n25|\tcandidate := Binding{\n26|\t\tSessionID:          fixtureSession,\n27|\t\tOperationID:        fixtureBootstrap,\n28|\t\tTerminalInstanceID: fixtureInstance,\n29|\t\tCreatedAt:          fixtureCreatedAt,\n30|\t}\n31|\tcandidate.BindingDigest = BindingDigest(candidate)\n32|\treturn candidate\n33|}\n34|\n35|func TestBindInstallsAndStatusProves(t *testing.T) {\n36|\tt.Parallel()\n37|\tstore := openPaneStore(t)\n38|\tif _, found, err := store.Status(fixtureSession); err != nil || found {\n39|\t\tt.Fatalf(\"Status() before bind = (%v, %v), want (false, nil)\", found, err)\n40|\t}\n41|\tbound, reattached, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate())\n42|\tif err != nil {\n43|\t\tt.Fatalf(\"Bind() error = %v\", err)\n44|\t}\n45|\tif reattached {\n46|\t\tt.Fatal(\"Bind() first call reports reattached\")\n47|\t}\n48|\tif bound.SessionID != fixtureSession || bound.OperationID != fixtureBootstrap || bound.TerminalInstanceID != fixtureInstance {\n49|\t\tt.Fatalf(\"Bind() = %+v, want the candidate pair\", bound)\n50|\t}\n51|\tif bound.CreatedAt == \"\" {\n52|\t\tt.Fatal(\"Bind() receipt carries no timestamp\")\n53|\t}\n54|\tif _, err := scalar.ParseTimestamp(bound.CreatedAt); err != nil {\n55|\t\tt.Fatalf(\"Bind() receipt timestamp is not a scalar timestamp: %v\", err)\n56|\t}\n57|\tproven, found, err := store.Status(fixtureSession)\n58|\tif err != nil {\n59|\t\tt.Fatalf(\"Status() error = %v\", err)\n60|\t}\n61|\tif !found {\n62|\t\tt.Fatal(\"Status() after bind reports absence\")\n63|\t}\n64|\tif proven != bound {\n65|\t\tt.Fatalf(\"Status() = %+v, want %+v\", proven, bound)\n66|\t}\n67|}\n68|\n69|func TestBindIdenticalRetryReattaches(t *testing.T) {\n70|\tt.Parallel()\n71|\tstore := openPaneStore(t)\n72|\tfirst, _, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate())\n73|\tif err != nil {\n74|\t\tt.Fatalf(\"Bind() error = %v\", err)\n75|\t}\n76|\t// A retry carrying different child facts still reattaches to the\n77|\t// one recorded child: the stored receipt is authoritative.\n78|\tretry := bindCandidate()\n79|\tretry.TerminalInstanceID = \"0198f4c9-2222-7bbb-8bbb-1234567890ab\"\n80|\tretry.BindingDigest = BindingDigest(retry)\n81|\tsecond, reattached, err := store.Bind(fixtureSession, fixtureBootstrap, retry)\n82|\tif err != nil {\n83|\t\tt.Fatalf(\"Bind() retry error = %v\", err)\n84|\t}\n85|\tif !reattached {\n86|\t\tt.Fatal(\"Bind() identical retry does not report reattached\")\n87|\t}\n88|\tif second != first {\n89|\t\tt.Fatalf(\"Bind() retry = %+v, want the recorded %+v\", second, first)\n90|\t}\n91|}\n92|\n93|func TestBindChangedOperationRefusesMismatch(t *testing.T) {\n94|\tt.Parallel()\n95|\tstore := openPaneStore(t)\n96|\tif _, _, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate()); err != nil {\n97|\t\tt.Fatalf(\"Bind() error = %v\", err)\n98|\t}\n99|\tother := bindCandidate()\n100|\tother.OperationID = fixtureOtherOp\n101|\tif _, _, err := store.Bind(fixtureSession, fixtureOtherOp, other); err == nil {\n102|\t\tt.Fatal(\"Bind() changed operation succeeded, want idempotency_mismatch\")\n103|\t} else {\n104|\t\tvar backend *terminalbackend.Error\n105|\t\tif !errors.As(err, &backend) || backend.Code != terminalbackend.CodeIdempotencyMismatch {\n106|\t\t\tt.Fatalf(\"Bind() changed operation error = %v, want idempotency_mismatch\", err)\n107|\t\t}\n108|\t}\n109|\tproven, found, err := store.Status(fixtureSession)\n110|\tif err != nil || !found {\n111|\t\tt.Fatalf(\"Status() after mismatch = (%v, %v), want the recorded binding\", found, err)\n112|\t}\n113|\tif proven.OperationID != fixtureBootstrap {\n114|\t\tt.Fatalf(\"Status() operation = %q, want the first operation\", proven.OperationID)\n115|\t}\n116|}\n117|\n118|func TestBindRefusesMalformedCandidates(t *testing.T) {\n119|\tt.Parallel()\n120|\tstore := openPaneStore(t)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
