{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c759","stream":{"kind":"session","id":"01a0b194-ebfd-7972-8291-a2a8c88f871f"},"sequence":519,"recorded_at":1780531400001033,"record_type":"event","durability":"durable","causation_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","run_stream":{"kind":"run","id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e"},"task_stream":{"kind":"task","id":"01a0b196-c721-7612-af5f-f5285d94ca74"},"task_id":"01a0b196-c721-7612-af5f-f5285d94ca74","event":{"kind":"output","task_id":"01a0b196-c721-7612-af5f-f5285d94ca74","chunk":"Read text file `/tmp/rev3ev/probes/zz_review3_delta_test.go`.\n1|package axpane\n2|\n3|// Delta witnesses for surviving reviewer mutants: run once on the\n4|// pristine tree and once under the mutant; the logged outcome is the\n5|// witness. Assertions are the SPEC-expected behavior.\n6|\n7|import (\n8|\t\"testing\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n12|)\n13|\n14|// RV3-4b witness: successor lease carrying a checkpoint the chain never\n15|// published, session bound in-window, changed operation.\n16|func TestDX_WindowLeaseCheckpointNullFold(t *testing.T) {\n17|\tworld := buildRunWorld(t)\n18|\tif _, err := Run(world.stores(), runRequest(t, world)); err != nil {\n19|\t\tt.Fatal(err)\n20|\t}\n21|\tsuccessorLease(t, world.repo, \"cccccccc-dddd-4eee-8fff-000000000001\", fixtureLocalHost, world.ckptID)\n22|\trequest := runRequest(t, world)\n23|\trequest.BootstrapOperationID = fixtureOtherOp\n24|\trequest.InstanceID = \"0198f4c9-2222-7bbb-8bbb-1234567890ab\"\n25|\trequest.Presented = fencing.PresentedToken{SessionID: fixtureSession, Epoch: 2, LeaseID: \"cccccccc-dddd-4eee-8fff-000000000001\"}\n26|\toutcome, err := Run(world.stores(), request)\n27|\tt.Logf(\"successor lease with unpublished checkpoint, fold null, in-window changed op: action=%s class=%q err=%v\", outcome.Decision.Action, outcome.Decision.Class, err)\n28|\tif err != nil || outcome.Decision.Action != ActionRefused || outcome.Decision.Class != terminalbackend.CodeIdempotencyMismatch {\n29|\t\tt.Fatalf(\"WITNESS: in-window changed op admitted on a null fold because the lease carries a checkpoint\")\n30|\t}\n31|}\n32|\n33|// RV3-11 witness: a chain the landed reducer refuses (profile.changed\n34|// under a successor lease while creating) reaches Run.\n35|func TestDX_UnfolderableChainThroughRun(t *testing.T) {\n36|\tworld := buildRunWorld(t)\n37|\tsuccessorLease(t, world.repo, \"cccccccc-dddd-4eee-8fff-000000000001\", fixtureLocalHost, world.ckptID)\n38|\tappendChainEvent(t, world.repo, \"profile.changed\", 2, \"cccccccc-dddd-4eee-8fff-000000000001\", 1, world.headID, map[string]any{\n39|\t\t\"from\": \"standard\", \"to\": \"yolo\", \"confirmed\": true,\n40|\t})\n41|\tif _, _, err := LoadNewestCheckpoint(world.repo, fixtureSession); err == nil {\n42|\t\tt.Fatalf(\"fixture chain unexpectedly folds\")\n43|\t}\n44|\trequest := runRequest(t, world)\n45|\trequest.Presented = fencing.PresentedToken{SessionID: fixtureSession, Epoch: 2, LeaseID: \"cccccccc-dddd-4eee-8fff-000000000001\"}\n46|\toutcome, err := Run(world.stores(), request)\n47|\tt.Logf(\"unfolderable chain through Run: action=%q err=%v\", outcome.Decision.Action, err)\n48|\tif err == nil {\n49|\t\tt.Fatalf(\"WITNESS: Run decided %q over a chain the reducer refuses (profile %+v)\", outcome.Decision.Action, outcome.Decision.Profile)\n50|\t}\n51|}","final_result":true}}}
