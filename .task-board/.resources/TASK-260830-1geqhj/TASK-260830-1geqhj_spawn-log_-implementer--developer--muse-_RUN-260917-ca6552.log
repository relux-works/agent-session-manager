{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9b3","stream":{"kind":"session","id":"01a0b194-ebfd-7972-8291-a2a8c88f871f"},"sequence":820,"recorded_at":1780531400001635,"record_type":"event","durability":"durable","causation_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","run_stream":{"kind":"run","id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e"},"task_stream":{"kind":"task","id":"01a0b197-6dff-7561-83a0-92b8610b1f9a"},"task_id":"01a0b197-6dff-7561-83a0-92b8610b1f9a","event":{"kind":"output","task_id":"01a0b197-6dff-7561-83a0-92b8610b1f9a","chunk":"Read text file `internal/axpane/binding_test.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n13|)\n14|\n15|func openPaneStore(t *testing.T) *Store {\n16|\tt.Helper()\n17|\tstore, err := Open(t.TempDir())\n18|\tif err != nil {\n19|\t\tt.Fatalf(\"Open() error = %v\", err)\n20|\t}\n21|\treturn store\n22|}\n23|\n24|func bindCandidate() Binding {\n25|\tcandidate := Binding{\n26|\t\tSessionID:          fixtureSession,\n27|\t\tOperationID:        fixtureBootstrap,\n28|\t\tTerminalInstanceID: fixtureInstance,\n29|\t\tCreatedAt:          fixtureCreatedAt,\n30|\t}\n31|\tcandidate.BindingDigest = BindingDigest(candidate)\n32|\treturn candidate\n33|}\n34|\n35|func TestBindInstallsAndStatusProves(t *testing.T) {\n36|\tt.Parallel()\n37|\tstore := openPaneStore(t)\n38|\tif _, found, err := store.Status(fixtureSession); err != nil || found {\n39|\t\tt.Fatalf(\"Status() before bind = (%v, %v), want (false, nil)\", found, err)\n40|\t}\n41|\tbound, reattached, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate())\n42|\tif err != nil {\n43|\t\tt.Fatalf(\"Bind() error = %v\", err)\n44|\t}\n45|\tif reattached {\n46|\t\tt.Fatal(\"Bind() first call reports reattached\")\n47|\t}\n48|\tif bound.SessionID != fixtureSession || bound.OperationID != fixtureBootstrap || bound.TerminalInstanceID != fixtureInstance {\n49|\t\tt.Fatalf(\"Bind() = %+v, want the candidate pair\", bound)\n50|\t}\n51|\tif bound.CreatedAt == \"\" {\n52|\t\tt.Fatal(\"Bind() receipt carries no timestamp\")\n53|\t}\n54|\tif _, err := scalar.ParseTimestamp(bound.CreatedAt); err != nil {\n55|\t\tt.Fatalf(\"Bind() receipt timestamp is not a scalar timestamp: %v\", err)\n56|\t}\n57|\tproven, found, err := store.Status(fixtureSession)\n58|\tif err != nil {\n59|\t\tt.Fatalf(\"Status() error = %v\", err)\n60|\t}\n61|\tif !found {\n62|\t\tt.Fatal(\"Status() after bind reports absence\")\n63|\t}\n64|\tif proven != bound {\n65|\t\tt.Fatalf(\"Status() = %+v, want %+v\", proven, bound)\n66|\t}\n67|}\n68|\n69|func TestBindIdenticalRetryReattaches(t *testing.T) {\n70|\tt.Parallel()\n71|\tstore := openPaneStore(t)\n72|\tfirst, _, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate())\n73|\tif err != nil {\n74|\t\tt.Fatalf(\"Bind() error = %v\", err)\n75|\t}\n76|\t// A retry carrying different child facts still reattaches to the\n77|\t// one recorded child: the stored receipt is authoritative.\n78|\tretry := bindCandidate()\n79|\tretry.TerminalInstanceID = \"0198f4c9-2222-7bbb-8bbb-1234567890ab\"\n80|\tretry.BindingDigest = BindingDigest(retry)\n81|\tsecond, reattached, err := store.Bind(fixtureSession, fixtureBootstrap, retry)\n82|\tif err != nil {\n83|\t\tt.Fatalf(\"Bind() retry error = %v\", err)\n84|\t}\n85|\tif !reattached {\n86|\t\tt.Fatal(\"Bind() identical retry does not report reattached\")\n87|\t}\n88|\tif second != first {\n89|\t\tt.Fatalf(\"Bind() retry = %+v, want the recorded %+v\", second, first)\n90|\t}\n91|}\n92|\n93|func TestBindChangedOperationRefusesMismatch(t *testing.T) {\n94|\tt.Parallel()\n95|\tstore := openPaneStore(t)\n96|\tif _, _, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate()); err != nil {\n97|\t\tt.Fatalf(\"Bind() error = %v\", err)\n98|\t}\n99|\tother := bindCandidate()\n100|\tother.OperationID = fixtureOtherOp\n101|\tif _, _, err := store.Bind(fixtureSession, fixtureOtherOp, other); err == nil {\n102|\t\tt.Fatal(\"Bind() changed operation succeeded, want idempotency_mismatch\")\n103|\t} else {\n104|\t\tvar backend *terminalbackend.Error\n105|\t\tif !errors.As(err, &backend) || backend.Code != terminalbackend.CodeIdempotencyMismatch {\n106|\t\t\tt.Fatalf(\"Bind() changed operation error = %v, want idempotency_mismatch\", err)\n107|\t\t}\n108|\t}\n109|\tproven, found, err := store.Status(fixtureSession)\n110|\tif err != nil || !found {\n111|\t\tt.Fatalf(\"Status() after mismatch = (%v, %v), want the recorded binding\", found, err)\n112|\t}\n113|\tif proven.OperationID != fixtureBootstrap {\n114|\t\tt.Fatalf(\"Status() operation = %q, want the first operation\", proven.OperationID)\n115|\t}\n116|}\n117|\n118|func TestBindRefusesMalformedCandidates(t *testing.T) {\n119|\tt.Parallel()\n120|\tstore := openPaneStore(t)\n(more lines below)","final_result":true}}}
