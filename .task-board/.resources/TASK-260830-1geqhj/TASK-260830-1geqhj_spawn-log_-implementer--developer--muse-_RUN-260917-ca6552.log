{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c84d","stream":{"kind":"session","id":"01a0b194-ebfd-7972-8291-a2a8c88f871f"},"sequence":641,"recorded_at":1780531400001277,"record_type":"event","durability":"durable","causation_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","run_stream":{"kind":"run","id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e"},"task_stream":{"kind":"task","id":"01a0b197-0d0a-7bd0-a4d7-544bcea7b880"},"task_id":"01a0b197-0d0a-7bd0-a4d7-544bcea7b880","event":{"kind":"output","task_id":"01a0b197-0d0a-7bd0-a4d7-544bcea7b880","chunk":"Read text file `internal/axpane/decide_test.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"sort\"\n6|\t\"testing\"\n7|\t\"time\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/matjournal\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessckpt\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n16|)\n17|\n18|// decideDeps carries the heavy fixtures one table row may need:\n19|// the backend universe (mutable before facts are drawn), a real\n20|// session chain, a real captured checkpoint, and the checkpoint\n21|// store for unpublished captures.\n22|type decideDeps struct {\n23|\tuniverse  *backendUniverse\n24|\trepo      *sessrepo.Repository\n25|\trecordID  string\n26|\tcreatedID string\n27|\tckpt      *sessckpt.Store\n28|\tckptID    string\n29|\tckptDoc   []byte\n30|}\n31|\n32|func buildDecideDeps(t *testing.T, attachAdmitted bool) *decideDeps {\n33|\tt.Helper()\n34|\tdeps := &decideDeps{universe: buildBackendUniverse(t, attachAdmitted)}\n35|\tdeps.repo, deps.recordID = chainFixture(t)\n36|\tevents, err := deps.repo.ListEvents(fixtureSession)\n37|\tif err != nil {\n38|\t\tt.Fatal(err)\n39|\t}\n40|\tdeps.createdID = events[len(events)-1].EventID\n41|\tckptStore, err := sessckpt.Open(t.TempDir())\n42|\tif err != nil {\n43|\t\tt.Fatal(err)\n44|\t}\n45|\tdeps.ckpt = ckptStore\n46|\tdeps.ckptID, deps.ckptDoc = checkpointFixture(t, deps.repo, ckptStore, []string{deps.createdID})\n47|\treturn deps\n48|}\n49|\n50|// validInput returns the ModeLaunch base that launches: every gate\n51|// passes through its landed owner with real documents.\n52|func validInput(t *testing.T, deps *decideDeps) Input {\n53|\tt.Helper()\n54|\tnow := fixtureNow()\n55|\tdescriptor, err := BuildDescriptor(DescriptorParams{\n56|\t\tBinding: BindingRef{\n57|\t\t\tBindingDigest:         deps.universe.hostBinding().TerminalBindingID,\n58|\t\t\tBackendID:             deps.universe.hostBinding().BackendID,\n59|\t\t\tImplementationVersion: deps.universe.hostBinding().ImplementationVersion,\n60|\t\t\tProtocolVersion:       deps.universe.hostBinding().ProtocolVersion,\n61|\t\t\tGeneration:            deps.universe.hostBinding().Generation,\n62|\t\t},\n63|\t\tInstanceID:  fixtureInstance,\n64|\t\tInteractive: true,\n65|\t\tColumns:     80,\n66|\t\tRows:        24,\n67|\t})\n68|\tif err != nil {\n69|\t\tt.Fatalf(\"BuildDescriptor() error = %v\", err)\n70|\t}\n71|\trecord, events, err := LoadProfile(deps.repo, fixtureSession)\n72|\tif err != nil {\n73|\t\tt.Fatalf(\"LoadProfile() error = %v\", err)\n74|\t}\n75|\treturn Input{\n76|\t\tSessionID:            fixtureSession,\n77|\t\tBootstrapOperationID: fixtureBootstrap,\n78|\t\tMode:                 ModeLaunch,\n79|\t\tSessionKnown:         true,\n80|\t\tPresented:            fixturePresented(),\n81|\t\tObservation:          fixtureObservation(now),\n82|\t\tBackend:              deps.universe.facts(t),\n83|\t\tProfileRecord:        record,\n84|\t\tProfileEvents:        events,\n85|\t\tProvider: ProviderFacts{\n86|\t\t\tBuild:    fixtureBuild(),\n87|\t\t\tIdentity: fixtureIdentity(t),\n88|\t\t},\n89|\t\tRealm: Realm{\n90|\t\t\tCaller:           CallerForeground,\n91|\t\t\tBrokerState:      \"broker-running\",\n92|\t\t\tServerGeneration: \"generation-alpha\",\n93|\t\t\tRemediation:      \"launch the aqua broker\",\n94|\t\t},\n95|\t\tEntrypoint:        []string{\"ax\", \"pane\", fixtureSession},\n96|\t\tDescriptor:        descriptor,\n97|\t\tHostBinding:       deps.universe.hostBinding(),\n98|\t\tInteractive:       true,\n99|\t\tRemoteInteractive: true,\n100|\t}\n101|}\n102|\n103|func lapsedObservation(now time.Time) fencing.Observation {\n104|\tobservation := fixtureObservation(now)\n105|\tobservation.Grant.ValidatedAt = now.Add(-2 * time.Hour)\n106|\treturn observation\n107|}\n108|\n109|func TestDecideLaunchPositive(t *testing.T) {\n110|\tt.Parallel()\n111|\tdeps := buildDecideDeps(t, true)\n112|\tdecision := Decide(validInput(t, deps))\n113|\tif decision.Action != ActionLaunch {\n114|\t\tt.Fatalf(\"Decide() action = %q, detail %q, cause %v, want launch\", decision.Action, decision.Detail, decision.Cause)\n115|\t}\n116|\tif !decision.HasToken {\n117|\t\tt.Fatal(\"Decide() launch carries no fencing token\")\n118|\t}\n119|\tbound, err := decision.Token.Bind(fencing.ProviderQuiesce)\n120|\tif err != nil {\n121|\t\tt.Fatalf(\"Token.Bind(quiesce) error = %v\", err)\n122|\t}\n123|\tif bound.SessionID != fixtureSession || bound.Epoch != 1 || bound.LeaseID != fixtureLeaseA {\n124|\t\tt.Fatalf(\"Token.Bind(quiesce) = %+v, want the winning triple\", bound)\n125|\t}\n126|\tif decision.Profile.Profile != \"standard\" || decision.Profile.HasSource {\n127|\t\tt.Fatalf(\"Decide() profile = %+v, want standard with no source\", decision.Profile)\n128|\t}\n129|\tif decision.Mapping != \"\" {\n130|\t\tt.Fatalf(\"Decide() mapping = %q, want empty for standard\", decision.Mapping)\n(more lines below)","final_result":true}}}
