{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c717","stream":{"kind":"session","id":"01a0b194-ebfd-7972-8291-a2a8c88f871f"},"sequence":486,"recorded_at":1780531400000967,"record_type":"event","durability":"durable","causation_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","run_stream":{"kind":"run","id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e"},"task_stream":{"kind":"task","id":"01a0b196-b439-77e1-bc39-531919865e48"},"task_id":"01a0b196-b439-77e1-bc39-531919865e48","event":{"kind":"output","task_id":"01a0b196-b439-77e1-bc39-531919865e48","chunk":"Read text file `/tmp/rev3ev/probes/zz_review3_probe_test.go`.\n(499 line(s) above)\n500|\t\t\tsecond.OperationID = fixtureOtherOp\n501|\t\t\tsecond.TerminalInstanceID = r3Inst3\n502|\t\t\tsecond.BindingDigest = BindingDigest(second)\n503|\t\t\treplayed, err := reopened.Supersede(fixtureSession, fixtureOtherOp, second)\n504|\t\t\tif err != nil {\n505|\t\t\t\tt.Fatalf(\"retry Supersede error = %v\", err)\n506|\t\t\t}\n507|\t\t\tif seam == \"install\" && replayed.TerminalInstanceID != r3Inst2 {\n508|\t\t\t\tt.Fatalf(\"retry after kill-after-install installed a second child %s\", replayed.TerminalInstanceID)\n509|\t\t\t}\n510|\t\t\tif seam == \"stage\" && replayed.TerminalInstanceID != r3Inst3 {\n511|\t\t\t\tt.Fatalf(\"retry after kill-after-stage did not install fresh: %+v\", replayed)\n512|\t\t\t}\n513|\t\t\tafter, _ := filepath.Glob(filepath.Join(reopened.receiptsDir(fixtureSession), \"*.json\"))\n514|\t\t\tif len(after) != 2 {\n515|\t\t\t\tt.Fatalf(\"receipts after retry = %v, want op1 and op2\", after)\n516|\t\t\t}\n517|\t\t})\n518|\t}\n519|}\n520|\n521|// ---------------------------------------------------------------\n522|// P2-2 rework verification (absent checkpoint store is unknown)\n523|// ---------------------------------------------------------------\n524|\n525|// R3-7: with a FOLDABLE chain (the rev2 probe world did not fold), a\n526|// winner carrying a checkpoint and no checkpoint store fails the run\n527|// with no decision; with the store it launches with the closure\n528|// pair; an epoch-1 winner without a checkpoint still launches with\n529|// no store on a checkpoint-free path.\n530|func TestR3NoCkptStoreIsUnknownNotNoClosure(t *testing.T) {\n531|\tworld := buildRunWorld(t)\n532|\tworld.headID = publishCheckpoint(t, world.repo, world.headID, 2, world.ckptID)\n533|\tsuccessorLease(t, world.repo, r3Successor, fixtureLocalHost, world.ckptID)\n534|\t// A head-only authoritative profile change under the successor.\n535|\tresumedID := appendChainEvent(t, world.repo, \"session.resumed\", 2, r3Successor, 1, world.headID, map[string]any{\n536|\t\t\"checkpoint_id\": world.ckptID, \"execution_profile\": \"standard\", \"profile_source_event_id\": nil,\n537|\t\t\"terminal_backend\": \"tmux\", \"native_session_id\": \"native-session-alpha\",\n538|\t})\n539|\tchanged := appendChainEvent(t, world.repo, \"profile.changed\", 2, r3Successor, 2, resumedID, map[string]any{\n540|\t\t\"from\": \"standard\", \"to\": \"yolo\", \"confirmed\": true,\n541|\t})\n542|\tif _, _, err := LoadNewestCheckpoint(world.repo, fixtureSession); err != nil {\n543|\t\tt.Fatalf(\"chain must fold: %v\", err)\n544|\t}\n545|\trequest := runRequest(t, world)\n546|\trequest.BootstrapOperationID = fixtureOtherOp\n547|\trequest.InstanceID = r3Inst2\n548|\trequest.Presented = fencing.PresentedToken{SessionID: fixtureSession, Epoch: 2, LeaseID: r3Successor}\n549|\tstores := world.stores()\n550|\tstores.Ckpt = nil\n551|\toutcome, err := Run(stores, request)\n552|\tt.Logf(\"no Ckpt store, winner carries checkpoint, head-only profile.changed: action=%q err=%v\", outcome.Decision.Action, err)\n553|\tif err == nil || outcome.Decision.Action != \"\" {\n554|\t\tt.Fatalf(\"FINDING: Run without a checkpoint store decided %q (profile %+v)\", outcome.Decision.Action, outcome.Decision.Profile)\n555|\t}\n556|\tcontrol, err := Run(world.stores(), request)\n557|\tif err != nil {\n558|\t\tt.Fatalf(\"control Run() error = %v\", err)\n559|\t}\n560|\tt.Logf(\"control with the store: action=%s profile=%+v (head change %s)\", control.Decision.Action, control.Decision.Profile, changed[:20])\n561|\tif control.Decision.Action != ActionLaunch || control.Decision.Profile.Profile != \"standard\" || control.Decision.Profile.Source == changed {\n562|\t\tt.Fatalf(\"FINDING: control launch carried the head pair instead of the closure\")\n563|\t}\n564|\t// Bound: epoch-1 winner (null checkpoint) with no store on a\n565|\t// checkpoint-free launch still launches.\n566|\tfresh := buildRunWorld(t)\n567|\tfreshStores := fresh.stores()\n568|\tfreshStores.Ckpt = nil\n569|\tplain, err := Run(freshStores, runRequest(t, fresh))\n570|\tt.Logf(\"epoch-1 winner, no store, launch: action=%s err=%v\", plain.Decision.Action, err)\n571|\tif err != nil || plain.Decision.Action != ActionLaunch {\n572|\t\tt.Fatalf(\"over-refusal: a checkpoint-free launch failed without a store\")\n573|\t}\n574|}\n575|\n576|// ---------------------------------------------------------------\n577|// P3-4 / P3-5 / P3-6 one step away\n578|// ---------------------------------------------------------------\n579|\n580|// N3-4: a FOREGROUND caller on a credential-requiring path whose only\n581|// realm row expired refuses the typed capability_unavailable (the\n582|// P3-4 conditional composed with the P3-6 mapping).\n583|func TestN3ForegroundExpiredRealmRowTyped(t *testing.T) {\n584|\tdeps := buildDecideDeps(t, true)\n585|\taddRealmEvidence(t, deps.universe, seedDigest(0xB1), \"codex\", \"0.147.0\")\n586|\tdeps.universe.now = deps.universe.now.AddDate(2, 0, 0)\n587|\tinput := validInput(t, deps)\n588|\tinput.Realm.Caller = CallerForeground\n589|\tinput.Smoke.Required = true\n590|\tinput.Smoke.Record = smokeRecord(t, \"pass\", \"A\", passingSmokeChecks(), smokeTuple())\n591|\tinput.Smoke.Target = smokeTarget()\n592|\tdecision := Decide(input)\n593|\tt.Logf(\"foreground + smoke required + expired realm row: action=%s class=%q typed=%v\", decision.Action, decision.Class, decision.RealmFailure != nil)\n594|\tif decision.Action != ActionRefused || decision.Class != \"capability_unavailable\" || decision.RealmFailure == nil {\n595|\t\tt.Fatalf(\"FINDING: foreground credential path with a dead realm row is not the typed refusal\")\n596|\t}\n597|}\n598|\n599|// N3-5 (bound of P3-6): a caller that needs NO realm row (foreground,\n600|// no credentials) with an expired realm row submitted keeps the\n601|// backend class — the mapping must not widen to every reconcile\n602|// failure.\n603|func TestN3DeadRealmRowWithoutNeedKeepsBackendClass(t *testing.T) {\n604|\tdeps := buildDecideDeps(t, true)\n605|\taddRealmEvidence(t, deps.universe, seedDigest(0xB1), \"codex\", \"0.147.0\")\n606|\tdeps.universe.now = deps.universe.now.AddDate(2, 0, 0)\n607|\tinput := validInput(t, deps)\n608|\tdecision := Decide(input)\n609|\tt.Logf(\"foreground, no credentials, expired realm row among expired evidence: action=%s class=%q\", decision.Action, decision.Class)\n610|\tif decision.Action != ActionRefused || decision.Class == \"capability_unavailable\" {\n611|\t\tt.Fatalf(\"FINDING: the dead-realm mapping fired for a caller that needs no realm row (or admitted): %s %q\", decision.Action, decision.Class)\n612|\t}\n613|}\n614|\n615|// N3-6: three realm objects, only the LAST binds this host+build and\n616|// the first two are foreign: launch (order independence past two).\n617|func TestN3RealmThreeObjectsLastBinds(t *testing.T) {\n618|\tdeps := buildDecideDeps(t, true)\n619|\taddRealmEvidence(t, deps.universe, seedDigest(0xB2), \"codex\", \"0.147.0\")\n620|\taddSecondRealmEvidence(t, deps.universe, seedDigest(0xB3), \"codex\", \"0.147.0\")\n621|\taddSecondRealmEvidence(t, deps.universe, seedDigest(0xB1), \"codex\", \"0.147.0\")\n622|\tinput := validInput(t, deps)\n623|\tinput.Realm.Caller = CallerBackground\n624|\tdecision := Decide(input)\n625|\tt.Logf(\"three realm objects, last binds: action=%s class=%q cause=%v\", decision.Action, decision.Class, decision.Cause)\n626|\tif decision.Action != ActionLaunch {\n627|\t\tt.Fatalf(\"FINDING: order dependence with three objects\")\n628|\t}\n629|}\n630|\n631|// ---------------------------------------------------------------\n632|// Decision-table plants (brief item 3)\n633|// ---------------------------------------------------------------\n634|\n635|func TestN3DecisionPlants(t *testing.T) {\n636|\tt.Run(\"conflicting_arms_remote_owner_and_stale_journal\", func(t *testing.T) {\n637|\t\tdeps := buildDecideDeps(t, true)\n638|\t\tinput := validInput(t, deps)\n639|\t\tinput.Mode = ModeRestore\n640|\t\tinput.Observation.Winner.HolderHostID = fixtureRemoteHost\n641|\t\tinput.RemoteInteractive = true\n642|\t\tinput.MaterializationRequired = true\n643|\t\tinput.JournalOK = true\n644|\t\tinput.HasNewestCheckpoint = true\n645|\t\tinput.NewestCheckpointID = deps.ckptID\n646|\t\tinput.Journal = matjournal.Journal{Phase: matjournal.PhaseCommitted, SourceCheckpointID: seedDigest(0xD2), MaterializationID: fixtureMat}\n647|\t\tdecision := Decide(input)\n648|\t\tt.Logf(\"remote interactive owner + stale journal: action=%s reason=%s\", decision.Action, decision.ParkReason)\n649|\t\tif decision.Action != ActionAttachRemote {\n650|\t\t\tt.Fatalf(\"expected attach_remote (fencing precedes materialization)\")\n651|\t\t}\n652|\t})\n653|\tt.Run(\"interactive_remote_owner_expired_grant\", func(t *testing.T) {\n654|\t\tdeps := buildDecideDeps(t, true)\n655|\t\tinput := validInput(t, deps)\n656|\t\tinput.Observation = lapsedObservation(fixtureNow())\n657|\t\tinput.Observation.Winner.HolderHostID = fixtureRemoteHost\n658|\t\tinput.RemoteInteractive = true\n659|\t\tdecision := Decide(input)\n660|\t\tt.Logf(\"interactive remote owner + lapsed grant: action=%s class=%q reason=%s (landed fencing order: grant expiry precedes direction)\", decision.Action, decision.Class, decision.ParkReason)\n661|\t\tif decision.Action == ActionLaunch || decision.HasToken {\n662|\t\t\tt.Fatalf(\"launched under a lapsed grant with a remote owner\")\n663|\t\t}\n664|\t})\n665|\tt.Run(\"materialization_one_generation_behind\", func(t *testing.T) {\n666|\t\tdeps := buildDecideDeps(t, true)\n667|\t\tinput := validInput(t, deps)\n668|\t\tinput.Mode = ModeRestore\n669|\t\tinput.HasNewestCheckpoint = true\n670|\t\tinput.NewestCheckpointID = deps.ckptID\n671|\t\tinput.MaterializationRequired = true\n672|\t\tinput.JournalOK = true\n673|\t\tinput.Journal = matjournal.Journal{Phase: matjournal.PhaseCommitted, SourceCheckpointID: seedDigest(0xC0), MaterializationID: fixtureMat}\n674|\t\tdecision := Decide(input)\n675|\t\tt.Logf(\"journal one generation behind the newest: action=%s reason=%s cause=%v\", decision.Action, decision.ParkReason, decision.Cause)\n676|\t\tif decision.Action != ActionParked || decision.ParkReason != fencing.ParkRestorePolicy {\n677|\t\t\tt.Fatalf(\"stale materialization admitted\")\n678|\t\t}\n679|\t})\n680|\tt.Run(\"profile_source_not_authoritative\", func(t *testing.T) {\n681|\t\tdeps := buildDecideDeps(t, true)\n682|\t\tchanged := appendChainEvent(t, deps.repo, \"profile.changed\", 1, fixtureLeaseA, 2, deps.createdID, map[string]any{\n683|\t\t\t\"from\": \"standard\", \"to\": \"yolo\", \"confirmed\": true,\n684|\t\t})\n685|\t\tinput := validInput(t, deps)\n686|\t\tinput.Mode = ModeRestore\n687|\t\tinput.HasNewestCheckpoint = true\n688|\t\tinput.NewestCheckpointID = deps.ckptID\n689|\t\tinput.CheckpointRequired = true\n690|\t\tinput.CheckpointDoc = deps.ckptDoc\n691|\t\tinput.CheckpointID = deps.ckptID\n692|\t\tdecision := Decide(input)\n693|\t\tt.Logf(\"head-only profile change outside the closure: action=%s profile=%+v (change %s)\", decision.Action, decision.Profile, changed[:20])\n694|\t\tif decision.Action != ActionLaunch || decision.Profile.Source == changed || decision.Profile.Profile != \"standard\" {\n695|\t\t\tt.Fatalf(\"non-authoritative source became the launch profile\")\n696|\t\t}\n697|\t})\n698|\tt.Run(\"descriptor_generation_differs\", func(t *testing.T) {\n699|\t\tdeps := buildDecideDeps(t, true)\n700|\t\tinput := validInput(t, deps)\n701|\t\tvar document map[string]any\n702|\t\t_ = json.Unmarshal(input.Descriptor, &document)\n703|\t\tdocument[\"backend_generation\"] = \"generation-omega\"\n704|\t\tinput.Descriptor, _ = json.Marshal(document)\n705|\t\tdecision := Decide(input)\n706|\t\tt.Logf(\"descriptor generation differs: action=%s class=%q\", decision.Action, decision.Class)\n707|\t\tif decision.Action != ActionRefused || decision.Class != terminalbackend.CodeStaleGeneration {\n708|\t\t\tt.Fatalf(\"descriptor generation drift admitted\")\n709|\t\t}\n710|\t})\n711|\tt.Run(\"capability_outside_closed_set\", func(t *testing.T) {\n712|\t\tdeps := buildDecideDeps(t, true)\n713|\t\tclaims := deps.universe.probe[\"capability_claims\"].([]any)\n714|\t\tclaims = append(claims, map[string]any{\n715|\t\t\t\"capability\": \"teleport\", \"origin\": \"probed\", \"value\": true, \"generation_variable\": true,\n716|\t\t\t\"dependent_operations\": []any{\"create\"}, \"evidence_requirements\": []any{\"conformance_fixture\", \"runtime_probe\"},\n717|\t\t})\n718|\t\tdeps.universe.probe[\"capability_claims\"] = claims\n719|\t\tdeps.universe.probe[\"probe_id\"] = omitSelfIdentity(t, deps.universe.probe, \"probe_id\")\n720|\t\tinput := validInput(t, deps)\n721|\t\tdecision := Decide(input)\n722|\t\tt.Logf(\"capability outside the closed §4.D set: action=%s class=%q\", decision.Action, decision.Class)\n723|\t\tif decision.Action != ActionRefused {\n724|\t\t\tt.Fatalf(\"unregistered capability admitted\")\n725|\t\t}\n726|\t})\n727|}\n728|\n729|// ---------------------------------------------------------------\n730|// Composition bypass plants (brief item 2)\n731|// ---------------------------------------------------------------\n732|\n733|func TestN3CompositionBypassPlants(t *testing.T) {\n734|\tt.Run(\"fencing_malformed_winner_holder\", func(t *testing.T) {\n735|\t\tdeps := buildDecideDeps(t, true)\n736|\t\tinput := validInput(t, deps)\n737|\t\tinput.Observation.Winner.HolderHostID = \"not-a-host\"\n738|\t\tinput.Observation.LocalHostID = \"not-a-host\"\n739|\t\tdecision := Decide(input)\n740|\t\tt.Logf(\"malformed winner holder equal to local: action=%s class=%q\", decision.Action, decision.Class)\n741|\t\tif decision.Action != ActionRefused || decision.Class != ClassInvalidArguments {\n742|\t\t\tt.Fatalf(\"fencing grammar bypassed\")\n743|\t\t}\n744|\t})\n745|\tt.Run(\"fencing_no_grant\", func(t *testing.T) {\n746|\t\tdeps := buildDecideDeps(t, true)\n747|\t\tinput := validInput(t, deps)\n748|\t\tinput.Observation.HasGrant = false\n749|\t\tdecision := Decide(input)\n750|\t\tt.Logf(\"no fencing grant: action=%s class=%q\", decision.Action, decision.Class)\n751|\t\tif decision.Action != ActionRefused {\n752|\t\t\tt.Fatalf(\"grantless activation admitted\")\n753|\t\t}\n754|\t})\n755|\tt.Run(\"journal_committed_without_source\", func(t *testing.T) {\n756|\t\tdeps := buildDecideDeps(t, true)\n757|\t\tinput := validInput(t, deps)\n758|\t\tinput.Mode = ModeRestore\n759|\t\tinput.HasNewestCheckpoint = true\n760|\t\tinput.NewestCheckpointID = deps.ckptID\n761|\t\tinput.MaterializationRequired = true\n762|\t\tinput.JournalOK = true\n763|\t\tinput.Journal = matjournal.Journal{Phase: matjournal.PhaseCommitted, MaterializationID: fixtureMat}\n764|\t\tdecision := Decide(input)\n765|\t\tt.Logf(\"committed journal with an empty source: action=%s cause=%v\", decision.Action, decision.Cause)\n766|\t\tif decision.Action != ActionParked {\n767|\t\t\tt.Fatalf(\"sourceless journal admitted\")\n768|\t\t}\n769|\t})\n770|\tt.Run(\"checkpoint_newest_named_but_doc_differs\", func(t *testing.T) {\n771|\t\tdeps := buildDecideDeps(t, true)\n772|\t\tidleID := appendChainEvent(t, deps.repo, \"session.idle\", 1, fixtureLeaseA, 2, deps.createdID, map[string]any{\n773|\t\t\t\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true,\n774|\t\t})\n775|\t\t_, c2Doc := captureUnpublished(t, deps.repo, deps.ckpt, fixtureOtherOp, []string{idleID})\n776|\t\tinput := validInput(t, deps)\n777|\t\tinput.Mode = ModeRestore\n778|\t\tinput.HasNewestCheckpoint = true\n779|\t\tinput.NewestCheckpointID = deps.ckptID\n780|\t\tinput.CheckpointRequired = true\n781|\t\tinput.CheckpointDoc = c2Doc // bytes of C2 presented under C's digest\n782|\t\tinput.CheckpointID = deps.ckptID\n783|\t\tdecision := Decide(input)\n784|\t\tt.Logf(\"newest digest named, other checkpoint's bytes: action=%s cause=%v\", decision.Action, decision.Cause)\n785|\t\tif decision.Action != ActionParked {\n786|\t\t\tt.Fatalf(\"checkpoint identity bypassed\")\n787|\t\t}\n788|\t})\n789|\tt.Run(\"profile_heads_unknown\", func(t *testing.T) {\n790|\t\tdeps := buildDecideDeps(t, true)\n791|\t\tinput := validInput(t, deps)\n792|\t\tinput.ProfileHeads = []string{seedDigest(0xAB)}\n793|\t\tdecision := Decide(input)\n794|\t\tt.Logf(\"closure heads naming no chain event: action=%s class=%q cause=%v\", decision.Action, decision.Class, decision.Cause)\n795|\t\tif decision.Action == ActionLaunch {\n796|\t\t\tt.Fatalf(\"unknown closure heads admitted\")\n797|\t\t}\n798|\t})\n799|\tt.Run(\"identity_record_for_another_session\", func(t *testing.T) {\n800|\t\tdeps := buildDecideDeps(t, true)\n801|\t\tinput := validInput(t, deps)\n802|\t\trecord, err := provhost.CreateIdentity(provhost.IdentityParams{\n803|\t\t\tSessionID: fixtureForeign, ProviderID: \"codex\", ProviderVersion: \"0.147.0\",\n804|\t\t\tProviderVersionRange: \"opaque-range\", NativeSessionID: \"native-session-other\",\n805|\t\t\tIdentityKind: \"session_uuid\", LogicalWorkspaceID: fixtureLocalHost,\n806|\t\t\tCreatedByHostID: fixtureLocalHost, CreatedAt: fixtureCreatedAt,\n807|\t\t})\n808|\t\tif err != nil {\n809|\t\t\tt.Fatal(err)\n810|\t\t}\n811|\t\tinput.Provider.Identity = record\n812|\t\tdecision := Decide(input)\n813|\t\tt.Logf(\"identity record minted for ANOTHER session (same provider/version): action=%s class=%q (characterization: session binding of the identity record)\", decision.Action, decision.Class)\n814|\t})\n815|\tt.Run(\"realm_evidence_missing_smoke_result\", func(t *testing.T) {\n816|\t\tdeps := buildDecideDeps(t, true)\n817|\t\taddRealmEvidence(t, deps.universe, seedDigest(0xB1), \"codex\", \"0.147.0\")\n818|\t\tlast := deps.universe.evidence[len(deps.universe.evidence)-1]\n819|\t\tlast[\"provider_auth_smoke_result\"] = nil\n820|\t\tinput := validInput(t, deps)\n821|\t\tinput.Realm.Caller = CallerBackground\n822|\t\tdecision := Decide(input)\n823|\t\tt.Logf(\"realm row with a null smoke result (signature now stale too): action=%s class=%q\", decision.Action, decision.Class)\n824|\t\tif decision.Action == ActionLaunch {\n825|\t\t\tt.Fatalf(\"sentinel-only realm evidence authorized\")\n826|\t\t}\n827|\t})\n828|\tt.Run(\"entrypoint_uppercase_session\", func(t *testing.T) {\n829|\t\tdeps := buildDecideDeps(t, true)\n830|\t\tinput := validInput(t, deps)\n831|\t\tinput.Entrypoint = []string{\"ax\", \"pane\", strings.ToUpper(fixtureSession)}\n832|\t\tdecision := Decide(input)\n833|\t\tt.Logf(\"entrypoint with an uppercase session spelling: action=%s class=%q\", decision.Action, decision.Class)\n834|\t\tif decision.Action == ActionLaunch {\n835|\t\t\tt.Fatalf(\"non-canonical entrypoint admitted\")\n836|\t\t}\n837|\t})\n838|\tt.Run(\"window_closed_by_caller_claim_only\", func(t *testing.T) {\n839|\t\t// The window predicate must read the fold fact Run derives,\n840|\t\t// never a caller claim: through Run there is no claim to\n841|\t\t// plant, so this asserts Run's derivation refuses a changed op\n842|\t\t// on a bound session whose chain never published.\n843|\t\tworld := buildRunWorld(t)\n844|\t\tif _, err := Run(world.stores(), runRequest(t, world)); err != nil {\n845|\t\t\tt.Fatal(err)\n846|\t\t}\n847|\t\trequest := runRequest(t, world)\n848|\t\trequest.BootstrapOperationID = fixtureOtherOp\n849|\t\toutcome, err := Run(world.stores(), request)\n850|\t\tif err != nil {\n851|\t\t\tt.Fatal(err)\n852|\t\t}\n853|\t\tt.Logf(\"in-window changed op through Run: action=%s class=%q\", outcome.Decision.Action, outcome.Decision.Class)\n854|\t\tif outcome.Decision.Action != ActionRefused || outcome.Decision.Class != terminalbackend.CodeIdempotencyMismatch {\n855|\t\t\tt.Fatalf(\"in-window changed op admitted through Run\")\n856|\t\t}\n857|\t})\n858|}\n859|\n860|// ---------------------------------------------------------------\n861|// Events (brief item 5)\n862|// ---------------------------------------------------------------\n863|\n864|// N3-7: a park with a local winner whose chain folds, emitted through\n865|// Run, authors under the winner; then a direct Emit under the LOSING\n866|// presented tuple (the stale lease) refuses at the mutation gate.\n867|func TestN3EmitUnderLosingTupleRefusesAfterRunPark(t *testing.T) {\n868|\tworld := buildRunWorld(t)\n869|\tappendChainEvent(t, world.repo, \"session.failed\", 1, fixtureLeaseA, 2, world.headID, map[string]any{\n870|\t\t\"error_code\": \"bootstrap_probe\", \"retryable\": false, \"operation_id\": nil,\n871|\t})\n872|\tsuccessorLease(t, world.repo, r3Successor, fixtureLocalHost, seedDigest(0xC9))\n873|\trequest := runRequest(t, world) // presented (1,A) — losing under (2,S)\n874|\tbefore := eventCount(t, world.repo)\n875|\toutcome, err := Run(world.stores(), request)\n876|\tif err != nil {\n877|\t\tt.Fatal(err)\n878|\t}\n879|\tafter := eventCount(t, world.repo)\n880|\tt.Logf(\"losing presented (1,A) under local winner (2,S), failed chain: action=%s reason=%s emitted=%v events %d->%d\", outcome.Decision.Action, outcome.Decision.ParkReason, outcome.Emitted, before, after)\n881|\tif outcome.Decision.Action != ActionParked || outcome.Decision.ParkReason != fencing.ParkStaleOwner {\n882|\t\tt.Fatalf(\"expected parked stale_owner\")\n883|\t}\n884|\tif outcome.Emitted {\n885|\t\tstored, _ := world.repo.GetEvent(fixtureSession, outcome.Event.EventID)\n886|\t\tvar decoded struct {\n887|\t\t\tLeaseEpoch uint64 `json:\"lease_epoch\"`\n888|\t\t\tLeaseID    string `json:\"lease_id\"`\n889|\t\t}\n890|\t\t_ = json.Unmarshal(stored, &decoded)\n891|\t\tt.Logf(\"authored under (%d,%s)\", decoded.LeaseEpoch, decoded.LeaseID[:8])\n892|\t\tif decoded.LeaseEpoch != 2 || decoded.LeaseID != r3Successor {\n893|\t\t\tt.Fatalf(\"FINDING: parked event authored under a non-winning lease\")\n894|\t\t}\n895|\t}\n896|\tobservation, err := ObserveOwnership(world.repo, fixtureSession, runObserve(fixtureNow()))\n897|\tif err != nil {\n898|\t\tt.Fatal(err)\n899|\t}\n900|\t_, tail, err := ChainTail(world.repo, fixtureSession)\n901|\tif err != nil {\n902|\t\tt.Fatal(err)\n903|\t}\n904|\t_, _, err = EmitParked(world.repo, outcome.Decision, EmitParams{\n905|\t\tSessionID: fixtureSession, CreatedByHost: fixtureLocalHost,\n906|\t\tLeaseEpoch: 1, LeaseID: fixtureLeaseA, LeaseSequence: tail.LeaseSequence + 1,\n907|\t\tPredecessors: []string{tail.EventID}, CreatedAt: fixtureCreatedAt,\n908|\t\tPresented:   fencing.PresentedToken{SessionID: fixtureSession, Epoch: 1, LeaseID: fixtureLeaseA},\n909|\t\tObservation: observation,\n910|\t})\n911|\tt.Logf(\"direct Emit under the losing tuple (1,A): err=%v\", err)\n912|\tif err == nil || !errors.Is(err, fencing.ErrStaleOwner) {\n913|\t\tt.Fatalf(\"FINDING: losing tuple appended or refused at the wrong arm: %v\", err)\n914|\t}\n915|}\n916|\n917|// ---------------------------------------------------------------\n918|// Hygiene: the ratio and the table\n919|// ---------------------------------------------------------------\n920|\n921|// N3-8: every named test in the TRACEABILITY acceptance table exists\n922|// in the package (independent of the producer's completeness test).\n923|func TestN3TraceabilityNamesExist(t *testing.T) {\n924|\traw, err := os.ReadFile(\"TRACEABILITY.md\")\n925|\tif err != nil {\n926|\t\tt.Fatal(err)\n927|\t}\n928|\tlisted, err := exec.Command(\"go\", \"test\", \".\", \"-list\", \".\", \"-count=1\").CombinedOutput()\n929|\tif err != nil {\n930|\t\tt.Fatal(err)\n931|\t}\n932|\tpresent := map[string]bool{}\n933|\tfor _, line := range strings.Split(string(listed), \"\\n\") {\n934|\t\tpresent[strings.TrimSpace(line)] = true\n935|\t}\n936|\trows := 0\n937|\tmissing := []string{}\n938|\tinTable := false\n939|\tfor _, line := range strings.Split(string(raw), \"\\n\") {\n940|\t\tif strings.HasPrefix(line, \"| AC row |\") {\n941|\t\t\tinTable = true\n942|\t\t\tcontinue\n943|\t\t}\n944|\t\tif inTable && !strings.HasPrefix(line, \"|\") {\n945|\t\t\tinTable = false\n946|\t\t}\n947|\t\tif !inTable || strings.HasPrefix(line, \"| ---\") {\n948|\t\t\tcontinue\n949|\t\t}\n950|\t\trows++\n951|\t\tfor _, field := range strings.Split(line, \"`\") {\n952|\t\t\tif strings.HasPrefix(field, \"Test\") {\n953|\t\t\t\ttop := strings.SplitN(field, \"/\", 2)[0]\n954|\t\t\t\tif !present[top] {\n955|\t\t\t\t\tmissing = append(missing, field)\n956|\t\t\t\t}\n957|\t\t\t}\n958|\t\t}\n959|\t}\n960|\tt.Logf(\"acceptance table rows=%d missing tests=%v\", rows, missing)\n961|\tif rows != 43 || len(missing) != 0 {\n962|\t\tt.Fatalf(\"table rows=%d (want 43) missing=%v\", rows, missing)\n963|\t}\n964|}\n965|\n966|// N3-9: in the post-takeover world where the successor owner changed\n967|// the profile (authoritative, under (2,S)) and stopped with C1, a\n968|// LAUNCH-mode start (create from stopped, no checkpoint required)\n969|// launches — and Run derives the profile closure from the lease's\n970|// handoff base C0, not from the newest checkpoint C1 whose closure\n971|// carries the change (§13.10: derive the effective profile from the\n972|// validated checkpoint's event-head closure).\n973|func TestN3PostTakeoverLaunchModeProfileFromHandoffBase(t *testing.T) {\n974|\tworld := buildRunWorld(t)\n975|\tc0 := world.ckptID\n976|\tworld.headID = publishCheckpoint(t, world.repo, world.headID, 2, c0)\n977|\tsuccessorLease(t, world.repo, r3Successor, fixtureLocalHost, c0)\n978|\tresumedID := appendChainEvent(t, world.repo, \"session.resumed\", 2, r3Successor, 1, world.headID, map[string]any{\n979|\t\t\"checkpoint_id\": c0, \"execution_profile\": \"standard\", \"profile_source_event_id\": nil,\n980|\t\t\"terminal_backend\": \"tmux\", \"native_session_id\": \"native-session-alpha\",\n981|\t})\n982|\tchanged := appendChainEvent(t, world.repo, \"profile.changed\", 2, r3Successor, 2, resumedID, map[string]any{\n983|\t\t\"from\": \"standard\", \"to\": \"yolo\", \"confirmed\": true,\n984|\t})\n985|\tidleID := appendChainEvent(t, world.repo, \"session.idle\", 2, r3Successor, 3, changed, map[string]any{\n986|\t\t\"boundary_ref\": \"turn-2\", \"foreground_idle\": true, \"background_idle\": true,\n987|\t})\n988|\tc1, _ := r3Capture(t, world.repo, world.ckpt, r3Op3, 2, r3Successor, []string{idleID})\n989|\tworld.headID = appendChainEvent(t, world.repo, \"session.stopped\", 2, r3Successor, 4, idleID, map[string]any{\n990|\t\t\"graceful\": true, \"checkpoint_id\": c1, \"resumable\": true, \"closure_kind\": \"checkpointed\", \"process_closed\": true, \"store_closed\": true,\n991|\t})\n992|\thas, newest, err := LoadNewestCheckpoint(world.repo, fixtureSession)\n993|\tif err != nil || !has || newest != c1 {\n994|\t\tt.Fatalf(\"fold = (%v, %s, %v), want C1\", has, newest, err)\n995|\t}\n996|\trequest := runRequest(t, world)\n997|\trequest.Mode = ModeLaunch\n998|\trequest.BootstrapOperationID = fixtureOtherOp\n999|\trequest.InstanceID = r3Inst2\n1000|\trequest.Presented = fencing.PresentedToken{SessionID: fixtureSession, Epoch: 2, LeaseID: r3Successor}\n1001|\toutcome, err := Run(world.stores(), request)\n1002|\tif err != nil {\n1003|\t\tt.Fatalf(\"Run() error = %v\", err)\n1004|\t}\n1005|\tt.Logf(\"launch mode from stopped (newest C1, lease base C0, yolo change %s in C1's closure): action=%s profile=%+v\",\n1006|\t\tchanged[:20], outcome.Decision.Action, outcome.Decision.Profile)\n1007|\tif outcome.Decision.Action != ActionLaunch {\n1008|\t\tt.Fatalf(\"expected launch: %v\", outcome.Decision.Cause)\n1009|\t}\n1010|\tif outcome.Decision.Profile.Profile != \"yolo\" || outcome.Decision.Profile.Source != changed {\n1011|\t\tt.Fatalf(\"FINDING: launch carried the handoff base's closure profile %+v instead of the newest checkpoint's (yolo/%s)\", outcome.Decision.Profile, changed[:20])\n1012|\t}\n1013|}\n1014|\n1015|// N3-10 (dangerous direction of N3-9): the epoch-1 owner set yolo\n1016|// before C0; the successor owner set the profile BACK to standard\n1017|// (authoritative, under (2,S)) and stopped with C1. A launch-mode\n1018|// start from stopped must carry standard; deriving from the handoff\n1019|// base C0 launches yolo — the codex bypass-approvals mapping — on a\n1020|// session whose authoritative profile is standard.\n1021|func TestN3PostTakeoverLaunchModeYoloFromStaleBase(t *testing.T) {\n1022|\tworld := buildRunWorld(t)\n1023|\ttoYolo := appendChainEvent(t, world.repo, \"profile.changed\", 1, fixtureLeaseA, 2, world.headID, map[string]any{\n1024|\t\t\"from\": \"standard\", \"to\": \"yolo\", \"confirmed\": true,\n1025|\t})\n1026|\tc0, _ := r3Capture(t, world.repo, world.ckpt, r3Op4, 1, fixtureLeaseA, []string{toYolo})\n1027|\tworld.headID = publishCheckpoint(t, world.repo, toYolo, 3, c0)\n1028|\tsuccessorLease(t, world.repo, r3Successor, fixtureLocalHost, c0)\n1029|\tresumedID := appendChainEvent(t, world.repo, \"session.resumed\", 2, r3Successor, 1, world.headID, map[string]any{\n1030|\t\t\"checkpoint_id\": c0, \"execution_profile\": \"yolo\", \"profile_source_event_id\": toYolo,\n1031|\t\t\"terminal_backend\": \"tmux\", \"native_session_id\": \"native-session-alpha\",\n1032|\t})\n1033|\ttoStandard := appendChainEvent(t, world.repo, \"profile.changed\", 2, r3Successor, 2, resumedID, map[string]any{\n1034|\t\t\"from\": \"yolo\", \"to\": \"standard\", \"confirmed\": true,\n1035|\t})\n1036|\tidleID := appendChainEvent(t, world.repo, \"session.idle\", 2, r3Successor, 3, toStandard, map[string]any{\n1037|\t\t\"boundary_ref\": \"turn-2\", \"foreground_idle\": true, \"background_idle\": true,\n1038|\t})\n1039|\tc1, _ := r3Capture(t, world.repo, world.ckpt, r3Op3, 2, r3Successor, []string{idleID})\n1040|\tworld.headID = appendChainEvent(t, world.repo, \"session.stopped\", 2, r3Successor, 4, idleID, map[string]any{\n1041|\t\t\"graceful\": true, \"checkpoint_id\": c1, \"resumable\": true, \"closure_kind\": \"checkpointed\", \"process_closed\": true, \"store_closed\": true,\n1042|\t})\n1043|\trequest := runRequest(t, world)\n1044|\trequest.Mode = ModeLaunch\n1045|\trequest.BootstrapOperationID = fixtureOtherOp\n1046|\trequest.InstanceID = r3Inst2\n1047|\trequest.Presented = fencing.PresentedToken{SessionID: fixtureSession, Epoch: 2, LeaseID: r3Successor}\n1048|\toutcome, err := Run(world.stores(), request)\n1049|\tif err != nil {\n1050|\t\tt.Fatalf(\"Run() error = %v\", err)\n1051|\t}\n1052|\tt.Logf(\"launch from stopped, authoritative profile standard (C1 closure), lease base C0 closure yolo: action=%s profile=%+v mapping=%q\",\n1053|\t\toutcome.Decision.Action, outcome.Decision.Profile, outcome.Decision.Mapping)\n1054|\tif outcome.Decision.Action == ActionLaunch && outcome.Decision.Profile.Profile == \"yolo\" {\n1055|\t\tt.Fatalf(\"FINDING: launch carries yolo (%q) on a session whose authoritative profile is standard (%s)\", outcome.Decision.Mapping, toStandard[:20])\n1056|\t}\n1057|}\n1058|\n1059|// N3-11: post-window, two wrappers race on the SAME new pair through\n1060|// Run: the loser must reattach to the winner's child (§4.1 \"identical\n1061|// retry returns or reattaches to the one recorded wrapper/child\"),\n1062|// not report a launch of a child it did not create.\n1063|func TestN3PostWindowSamePairRaceThroughRun(t *testing.T) {\n1064|\tworld := buildRunWorld(t)\n1065|\tif _, err := Run(world.stores(), runRequest(t, world)); err != nil {\n1066|\t\tt.Fatal(err)\n1067|\t}\n1068|\tworld.headID = publishCheckpoint(t, world.repo, world.headID, 2, world.ckptID)\n1069|\tworld.mat = journalSourced(t, world.ckptID)\n1070|\twinner := bindCandidate()\n1071|\twinner.OperationID = fixtureOtherOp\n1072|\twinner.TerminalInstanceID = r3Inst3\n1073|\twinner.BindingDigest = BindingDigest(winner)\n1074|\trequest := r3RestoreRequest(t, world, fixtureOtherOp, r3Inst2, 1, fixtureLeaseA, world.ckptID)\n1075|\trequest.Hooks = &Hooks{\n1076|\t\tAfterStage: func(path string) error {\n1077|\t\t\tinner, err := Open(world.paneRoot)\n1078|\t\t\tif err != nil {\n1079|\t\t\t\treturn err\n1080|\t\t\t}\n1081|\t\t\t_, err = inner.Supersede(fixtureSession, fixtureOtherOp, winner)\n1082|\t\t\treturn err\n1083|\t\t},\n1084|\t}\n1085|\toutcome, err := Run(world.stores(), request)\n1086|\tif err != nil {\n1087|\t\tt.Fatalf(\"Run() error = %v\", err)\n1088|\t}\n1089|\tt.Logf(\"post-window same-pair race loser through Run: action=%s binding instance=%s (winner %s, loser's own %s)\",\n1090|\t\toutcome.Decision.Action, outcome.Binding.TerminalInstanceID[9:13], r3Inst3[9:13], r3Inst2[9:13])\n1091|\tif outcome.Binding.TerminalInstanceID != winner.TerminalInstanceID {\n1092|\t\tt.Fatalf(\"loser did not converge on the winner's receipt\")\n1093|\t}\n1094|\tif outcome.Decision.Action != ActionReattach {\n1095|\t\tt.Fatalf(\"FINDING: the race loser reports %q while holding the winner's child\", outcome.Decision.Action)\n1096|\t}\n1097|}","final_result":true}}}
