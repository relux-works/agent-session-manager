{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cdfd","stream":{"kind":"session","id":"01a0b194-ebfd-7972-8291-a2a8c88f871f"},"sequence":1369,"recorded_at":1780531400002733,"record_type":"event","durability":"durable","causation_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","run_stream":{"kind":"run","id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e"},"task_stream":{"kind":"task","id":"01a0b19b-8eef-73c2-b154-7cd222790c98"},"task_id":"01a0b19b-8eef-73c2-b154-7cd222790c98","event":{"kind":"output","task_id":"01a0b19b-8eef-73c2-b154-7cd222790c98","chunk":"edited\nchanged lines: lines 659-717\n--- original\n+++ updated\n@@\n-// admitCheckpoint admits exactly the fold's newest published\n-// checkpoint for resume (§13.11 step 5: validate the newest\n-// checkpoint). The closed shape must attest through the sessrepo\n-// owner, the computed identity must equal the required digest, the\n-// required digest must equal the newest published checkpoint, a\n-// winning lease that carries a checkpoint must agree with it (the\n-// successor handoff base), and the checkpoint's own session_id\n-// must name this session. With no published checkpoint the\n-// requirement parks: an unpublished checkpoint is never admitted.\n-// It returns the checkpoint's event-head closure for the profile\n-// derivation.\n-func admitCheckpoint(input Input) ([]string, error) {\n-\tdoc := input.CheckpointDoc\n-\twant := input.CheckpointID\n-\tif len(doc) == 0 {\n-\t\treturn nil, errCheckpointAbsent()\n-\t}\n-\tdigest, _, err := sessrepo.AttestCheckpointRecord(doc)\n-\tif err != nil {\n-\t\treturn nil, err\n-\t}\n-\tif digest.String() != want {\n-\t\treturn nil, errCheckpointMismatch()\n-\t}\n-\tif !input.HasNewestCheckpoint {\n-\t\treturn nil, errCheckpointNoPublished()\n-\t}\n-\tif want != input.NewestCheckpointID {\n-\t\treturn nil, errCheckpointNotNewest()\n-\t}\n-\tif !leaseCheckpointAgrees(input) {\n-\t\treturn nil, errCheckpointLeaseDisagree()\n-\t}\n-\tsessionID, _, _, heads, err := decodeCheckpointMembers(doc)\n-\tif err != nil {\n-\t\treturn nil, err\n-\t}\n-\tif sessionID != input.SessionID {\n-\t\treturn nil, errCheckpointForeign()\n-\t}\n-\treturn heads, nil\n-}\n-\n-// leaseCheckpointAgrees asserts the winning lease's checkpoint\n-// against the chain fold's newest: a successor lease's Checkpoint\n-// is the handoff base and must agree with the published newest.\n-// The fold stays the authority — this asserts agreement, it never\n-// selects one fact and ignores the other. A winner that carries\n-// no checkpoint (every epoch-1 owner) trivially agrees; callers\n-// park on a null fold before consulting this.\n-func leaseCheckpointAgrees(input Input) bool {\n-\tif !input.Observation.HasWinner || !input.Observation.Winner.HasCheckpoint {\n-\t\treturn true\n-\t}\n-\tif !input.HasNewestCheckpoint {\n-\t\treturn false\n-\t}\n-\treturn input.Observation.Winner.Checkpoint == input.NewestCheckpointID\n-}\n+// admitCheckpoint admits exactly the fold's newest published\n+// checkpoint for resume (§13.11 step 5: validate the newest\n+// checkpoint). The closed shape must attest through the sessrepo\n+// owner, the computed identity must equal the required digest, the\n+// required digest must equal the newest published checkpoint, and\n+// the checkpoint's own session_id must name this session. With no\n+// published checkpoint the requirement parks: an unpublished\n+// checkpoint is never admitted. The winning lease's handoff base\n+// is never compared: the fold is the sole newest authority. It\n+// returns the checkpoint's event-head closure for the profile\n+// derivation.\n+func admitCheckpoint(input Input) ([]string, error) {\n+\tdoc := input.CheckpointDoc\n+\twant := input.CheckpointID\n+\tif len(doc) == 0 {\n+\t\treturn nil, errCheckpointAbsent()\n+\t}\n+\tdigest, _, err := sessrepo.AttestCheckpointRecord(doc)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\tif digest.String() != want {\n+\t\treturn nil, errCheckpointMismatch()\n+\t}\n+\tif !input.HasNewestCheckpoint {\n+\t\treturn nil, errCheckpointNoPublished()\n+\t}\n+\tif want != input.NewestCheckpointID {\n+\t\treturn nil, errCheckpointNotNewest()\n+\t}\n+\tsessionID, _, _, heads, err := decodeCheckpointMembers(doc)\n+\tif err != nil {\n+\t\treturn nil, err\n+\t}\n+\tif sessionID != input.SessionID {\n+\t\treturn nil, errCheckpointForeign()\n+\t}\n+\treturn heads, nil\n+}\n","final_result":true}}}
