eason != fencing.ParkRestorePolicy {\\n\",\n561|        count=1,\n562|        run=\"TestRunParkedUnfoldableSkipsEmission\",\n563|        expect=\"KILLED\",\n564|        note=\"Run admits exactly unfolderable restore_policy parks; other unfolderable still skip.\",\n565|    ),\n566|    Mutant(\n567|        name=\"N-run-ckpt-store\",\n568|        path=f\"{PACKAGE}/run.go\",\n569|        find=\"\\tif known && observation.HasWinner && observation.Winner.HasCheckpoint && stores.Ckpt == nil {\\n\",\n570|        replace=\"\\tif known && observation.HasWinner && observation.Winner.HasCheckpoint && stores.Ckpt == nil && request.Mode == ModeRestore {\\n\",\n571|        count=1,\n572|        run=\"TestRunNoCkptStoreWinnerCheckpointFails\",\n573|        expect=\"KILLED\",\n574|        note=\"Admits exactly launch-mode runs with a checkpoint-carrying winner and no store; restore-mode still fails.\",\n575|    ),\n576|    Mutant(\n577|        name=\"N-emit-losing-epoch\",\n578|        path=f\"{PACKAGE}/events.go\",\n579|        find=\"\\tif _, err := fencing.AuthorizeMutation(params.Presented, params.Observation); err != nil {\\n\",\n580|        replace=\"\\tif _, err := fencing.AuthorizeMutation(params.Presented, params.Observation); err != nil && params.Presented.Epoch >= params.Observation.Winner.Epoch {\\n\",\n581|        count=1,\n582|        run=\"TestEmitUnderLosingLeaseRefuses\",\n583|        expect=\"KILLED\",\n584|        note=\"Admits exactly losing-epoch emissions; same-or-winning-epoch refusals still refuse.\",\n585|    ),\n586|    Mutant(\n587|        name=\"C-doc-comment\",\n588|        path=f\"{PACKAGE}/doc.go\",\n589|        find=\"// `ax pane SESSION_ID` enforcement wrapper: the decision every managed\\n\",\n590|        replace=\"// `ax pane SESSION_ID` enforcement wrapper (control): the decision every managed\\n\",\n591|        count=1,\n592|        run=\"TestRealmCarriesNoCachedEvidence\",\n593|        expect=\"SURVIVED\",\n594|        note=\"Harmless control: a comment-only edit must survive.\",\n595|    ),\n596|]\n597|\n598|\n599|def run_mutant(mutant: Mutant) -> str:\n600|    target = REPO / mutant.path\n601|    original = target.read_text()\n602|    found = original.count(mutant.find)\n603|    if found != mutant.count:\n604|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\"\n605|    with tempfile.TemporaryDirectory() as staging:\n606|        backup = Path(staging) / \"backup\"\n607|        shutil.copy2(target, backup)\n608|        try:\n609|            target.write_text(original.replace(mutant.find, mutant.replace))\n610|            run = subprocess.run(\n611|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n612|                cwd=REPO,\n613|                capture_output=True,\n614|                text=True,\n615|                timeout=300,\n616|            )\n617|        finally:\n618|            shutil.copy2(backup, target)\n619|    output = (run.stdout + run.stderr).strip()\n620|    if os.environ.get(\"AX_MUTANT_VERBOSE\") == \"1\":\n621|        print(f\"--- raw: {mutant.name}: exit {run.returncode} ---\", flush=True)\n622|        print(output, flush=True)\n623|        print(f\"--- end raw: {mutant.name} ---\", flush=True)\n624|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n625|        return f\"ERROR: {mutant.name}: build broke under the patch\"\n626|    if run.returncode == 0:\n627|        verdict = \"SURVIVED\"\n628|    elif '--- FAIL' in output or 'FAIL:' in output:\n629|        verdict = \"KILLED\"\n630|    else:\n631|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\"\n632|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n633|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note} [exit {run.returncode}]\"\n634|\n635|\n636|def main(argv: list[str]) -> int:\n637|    selected = [m for m in MUTANTS if not argv or m.name in argv]\n638|    if argv and len(selected) != len(argv):\n639|        unknown = sorted(set(argv) - {m.name for m in selected})\n640|        print(f\"unknown mutants: {', '.join(unknown)}\")\n641|        return 2\n642|    failures = 0\n643|    for mutant in selected:\n644|        try:\n645|            line = run_mutant(mutant)\n646|        except subprocess.TimeoutExpired:\n647|            line = f\"ERROR: {mutant.name}: killer timed out\"\n648|        print(line, flush=True)\n649|        if not line.startswith(\"ok:\"):\n650|            failures += 1\n651|    return 1 if failures else 0\n652|\n653|\n654|if __name__ == \"__main__\":\n655|    sys.exit(main(sys.argv[1:]))","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
