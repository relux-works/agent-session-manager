lt\\\":{\\\"id\\\":\\\"TASK-260830-1geqhj\\\",\\\"item\\\":9,\\\"text\\\":\\\"Every gate ships at least one NARROWING mutant — the gate stays present and is weakened to admit exactly one member of the class it must reject, and a named test must fail. A delete-only mutant proves only that the gate exists and is not accepted as evidence.\\\",\\\"unchecked\\\":true}},{\\\"ok\\\":true,\\\"result\\\":{\\\"id\\\":\\\"TASK-260830-1geqhj\\\",\\\"item\\\":10,\\\"text\\\":\\\"A gate that inspects source text is additionally attacked by a mutant that PRESERVES the searched-for token and changes behavior, and the mutant harness executes the behavioral suite, not only the static checker.\\\",\\\"unchecked\\\":true}},{\\\"ok\\\":true,\\\"result\\\":{\\\"id\\\":\\\"TASK-260830-1geqhj\\\",\\\"item\\\":11,\\\"text\\\":\\\"Lint clean\\\",\\\"unchecked\\\":true}},{\\\"ok\\\":true,\\\"result\\\":{\\\"id\\\":\\\"TASK-260830-1geqhj\\\",\\\"item\\\":12,\\\"text\\\":\\\"Relevant build/validation commands run after changes and build not broken\\\",\\\"unchecked\\\":true}},{\\\"ok\\\":true,\\\"result\\\":{\\\"id\\\":\\\"TASK-260830-1geqhj\\\",\\\"item\\\":13,\\\"text\\\":\\\"New outcome artifact attached on the board with a task-scoped name when the work produces notes, logs, screenshots, or other deliverables\\\",\\\"unchecked\\\":true}},{\\\"ok\\\":true,\\\"result\\\":{\\\"id\\\":\\\"TASK-260830-1geqhj\\\",\\\"item\\\":14,\\\"text\\\":\\\"Important findings, decisions, anomalies, or regressions recorded in logbook when relevant\\\",\\\"unchecked\\\":true}},{\\\"ok\\\":true,\\\"result\\\":{\\\"id\\\":\\\"TASK-260830-1geqhj\\\",\\\"item\\\":15,\\\"text\\\":\\\"Implementation matches AC\\\",\\\"unchecked\\\":true}},{\\\"ok\\\":true,\\\"result\\\":{\\\"id\\\":\\\"TASK-260830-1geqhj\\\",\\\"item\\\":16,\\\"text\\\":\\\"Solution fits project architecture\\\",\\\"unchecked\\\":true}},{\\\"ok\\\":true,\\\"result\\\":{\\\"id\\\":\\\"TASK-260830-1geqhj\\\",\\\"item\\\":17,\\\"text\\\":\\\"Tests green\\\",\\\"unchecked\\\":true}},{\\\"ok\\\":true,\\\"result\\\":{\\\"id\\\":\\\"TASK-260830-1geqhj\\\",\\\"item\\\":18,\\\"text\\\":\\\"Gate, refusal, validation, authorization, and attestation behavior attacked, not read — positive-path-only evidence is not accepted\\\",\\\"unchecked\\\":true}},{\\\"ok\\\":true,\\\"result\\\":{\\\"id\\\":\\\"TASK-260830-1geqhj\\\",\\\"item\\\":19,\\\"text\\\":\\\"If review does not accept the work — verdict evidence added and status routed by the explicit verdict branches\\\",\\\"unchecked\\\":true}}]\\n\",\n  \"original_output_bytes\": 4068,\n  \"original_output_tokens\": 1017,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
