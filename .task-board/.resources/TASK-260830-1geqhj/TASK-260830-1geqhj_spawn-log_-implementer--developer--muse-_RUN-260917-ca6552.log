aceManifestID: seedDigest(0xE1), ProviderManifestID: seedDigest(0xE2),\n30|\t\tBoundary: sessckpt.SafeBoundary{\n31|\t\t\tProviderID: \"codex\", ProviderVersion: \"0.147.0\", Evidence: sessckpt.EvidenceAcceptedTest,\n32|\t\t\tInputBlocked: true, ForegroundIdle: true, BackgroundIdle: true, OpenProcesses: 0, OpenDatabaseHandles: 0,\n33|\t\t},\n34|\t\tEventHeads: heads, CreatedAt: fixtureCreatedAt, Extensions: map[string]string{},\n35|\t})\n36|\tif err != nil {\n37|\t\tt.Fatalf(\"Capture(epoch %d) error = %v\", epoch, err)\n38|\t}\n39|\treturn reference.CheckpointID, raw\n40|}\n41|\n42|// The successor owner changes the profile to yolo (authoritative,\n43|// under (2,S)) and then stops with C1 whose closure contains that\n44|// change. A restore from C1 must carry yolo with that source\n45|// (§13.10: derive the effective profile from ITS event-head closure).\n46|func TestFX_PostTakeoverProfileClosureSource(t *testing.T) {\n47|\tworld := buildRunWorld(t)\n48|\tc0 := world.ckptID\n49|\tworld.headID = publishCheckpoint(t, world.repo, world.headID, 2, c0)\n50|\tsuccessorLease(t, world.repo, fxSuccessor, fixtureLocalHost, c0)\n51|\tresumedID := appendChainEvent(t, world.repo, \"session.resumed\", 2, fxSuccessor, 1, world.headID, map[string]any{\n52|\t\t\"checkpoint_id\": c0, \"execution_profile\": \"standard\", \"profile_source_event_id\": nil,\n53|\t\t\"terminal_backend\": \"tmux\", \"native_session_id\": \"native-session-alpha\",\n54|\t})\n55|\tchanged := appendChainEvent(t, world.repo, \"profile.changed\", 2, fxSuccessor, 2, resumedID, map[string]any{\n56|\t\t\"from\": \"standard\", \"to\": \"yolo\", \"confirmed\": true,\n57|\t})\n58|\tidleID := appendChainEvent(t, world.repo, \"session.idle\", 2, fxSuccessor, 3, changed, map[string]any{\n59|\t\t\"boundary_ref\": \"turn-2\", \"foreground_idle\": true, \"background_idle\": true,\n60|\t})\n61|\tc1, _ := fxCapture(t, world.repo, world.ckpt, fxOp3, 2, fxSuccessor, []string{idleID})\n62|\tworld.headID = appendChainEvent(t, world.repo, \"session.stopped\", 2, fxSuccessor, 4, idleID, map[string]any{\n63|\t\t\"graceful\": true, \"checkpoint_id\": c1, \"resumable\": true, \"closure_kind\": \"checkpointed\", \"process_closed\": true, \"store_closed\": true,\n64|\t})\n65|\thas, newest, err := LoadNewestCheckpoint(world.repo, fixtureSession)\n66|\tif err != nil || !has || newest != c1 {\n67|\t\tt.Fatalf(\"fold = (%v, %s, %v), want C1\", has, newest, err)\n68|\t}\n69|\tworld.mat = journalSourced(t, c1)\n70|\trequest := runRequest(t, world)\n71|\trequest.Mode = ModeRestore\n72|\trequest.BootstrapOperationID = fixtureOtherOp\n73|\trequest.InstanceID = fxInst2\n74|\trequest.Presented = fencing.PresentedToken{SessionID: fixtureSession, Epoch: 2, LeaseID: fxSuccessor}\n75|\trequest.MaterializationRequired = true\n76|\trequest.MaterializationID = fixtureMat\n77|\trequest.CheckpointRequired = true\n78|\trequest.CheckpointID = c1\n79|\toutcome, err := Run(world.stores(), request)\n80|\tif err != nil {\n81|\t\tt.Fatalf(\"Run() error = %v\", err)\n82|\t}\n83|\tt.Logf(\"post-takeover restore from C1 under the relaxed agreement: action=%s cause=%v profile=%+v (yolo change event %s)\",\n84|\t\toutcome.Decision.Action, outcome.Decision.Cause, outcome.Decision.Profile, changed[:20])\n85|\tif outcome.Decision.Action != ActionLaunch {\n86|\t\tt.Fatalf(\"relaxed agreement still does not launch: %v\", outcome.Decision.Cause)\n87|\t}\n88|\tif outcome.Decision.Profile.Profile != \"yolo\" || outcome.Decision.Profile.Source != changed {\n89|\t\tt.Fatalf(\"FINDING: the resume carried the handoff base's closure profile %+v instead of the resumed checkpoint's (yolo/%s)\", outcome.Decision.Profile, changed[:20])\n90|\t}\n91|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
