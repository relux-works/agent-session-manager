{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8ab","stream":{"kind":"session","id":"01a0b194-ebfd-7972-8291-a2a8c88f871f"},"sequence":688,"recorded_at":1780531400001371,"record_type":"event","durability":"durable","causation_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","run_stream":{"kind":"run","id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e"},"task_stream":{"kind":"task","id":"01a0b197-1ef3-7820-a49d-98bb77ca0109"},"task_id":"01a0b197-1ef3-7820-a49d-98bb77ca0109","event":{"kind":"output","task_id":"01a0b197-1ef3-7820-a49d-98bb77ca0109","chunk":"Read text file `internal/axpane/mutant_harness.py`.\n(499 line(s) above)\n500|        count=1,\n501|        run=\"TestDecideForeignCheckpointParks\",\n502|        expect=\"KILLED\",\n503|        note=\"Admits exactly the foreign fixture session; other foreign sessions still park.\",\n504|    ),\n505|\n506|    Mutant(\n507|        name=\"N-realm-binding\",\n508|        path=f\"{PACKAGE}/decide.go\",\n509|        find=\"\\t\\tif object.TerminalBindingID != input.HostBinding.TerminalBindingID {\\n\",\n510|        replace='\\t\\tif object.TerminalBindingID != input.HostBinding.TerminalBindingID && object.TerminalBindingID != \"sha256:b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2\" {\\n',\n511|        count=1,\n512|        run=\"TestDecideRealmBindingMismatchRefuses/binding\",\n513|        expect=\"KILLED\",\n514|        note=\"Admits exactly the mismatched test binding; other mismatches still refuse.\",\n515|    ),\n516|    Mutant(\n517|        name=\"N-realm-generation\",\n518|        path=f\"{PACKAGE}/decide.go\",\n519|        find=\"\\tif input.Realm.ServerGeneration != input.Backend.RawGeneration {\\n\",\n520|        replace='\\tif input.Realm.ServerGeneration != input.Backend.RawGeneration && input.Realm.ServerGeneration != \"generation-stale\" {\\n',\n521|        count=1,\n522|        run=\"TestDecideRealmBindingMismatchRefuses/generation\",\n523|        expect=\"KILLED\",\n524|        note=\"Admits exactly the stale test generation; other stale generations still refuse.\",\n525|    ),\n526|    Mutant(\n527|        name=\"N-headless\",\n528|        path=f\"{PACKAGE}/decide.go\",\n529|        find=\"\\tif input.Mode == ModeLaunch && !input.Interactive && !admitted.Has(headlessCreationCapability) {\\n\",\n530|        replace='\\tif input.Mode == ModeLaunch && !input.Interactive && !admitted.Has(headlessCreationCapability) && !admitted.Has(\"durable_disconnect\") {\\n',\n531|        count=1,\n532|        run=\"TestDecideNonInteractiveRequiresHeadless\",\n533|        expect=\"KILLED\",\n534|        note=\"Admits exactly durable-holding non-interactive creates without headless; other creates still refuse.\",\n535|    ),\n536|    Mutant(\n537|        name=\"N-emit-mutation\",\n538|        path=f\"{PACKAGE}/events.go\",\n539|        find=\"\\tif _, err := fencing.AuthorizeMutation(params.Presented, params.Observation); err != nil {\\n\",\n540|        replace=\"\\tif _, err := fencing.AuthorizeMutation(params.Presented, params.Observation); err != nil && params.Observation.Verified {\\n\",\n541|        count=1,\n542|        run=\"TestEmitParkedVocabularyLoop/refuses_unverified\",\n543|        expect=\"KILLED\",\n544|        note=\"Admits exactly unverified emissions; verified refusals still refuse.\",\n545|    ),\n546|    Mutant(\n547|        name=\"N-parked-fold\",\n548|        path=f\"{PACKAGE}/events.go\",\n549|        find=\"\\tif !foldable {\\n\",\n550|        replace=\"\\tif !foldable && decision.ParkReason != fencing.ParkRestorePolicy {\\n\",\n551|        count=1,\n552|        run=\"TestEmitParkedUnfoldableRefuses\",\n553|        expect=\"KILLED\",\n554|        note=\"Admits exactly unfolderable restore_policy parks; other unfolderable reasons still refuse.\",\n555|    ),\n556|    Mutant(\n557|        name=\"N-run-fold\",\n558|        path=f\"{PACKAGE}/run.go\",\n559|        find=\"\\t\\tif !foldable {\\n\",\n560|        replace=\"\\t\\tif !foldable && decision.ParkReason != fencing.ParkRestorePolicy {\\n\",\n561|        count=1,\n562|        run=\"TestRunParkedUnfoldableSkipsEmission\",\n563|        expect=\"KILLED\",\n564|        note=\"Run admits exactly unfolderable restore_policy parks; other unfolderable still skip.\",\n565|    ),\n566|    Mutant(\n567|        name=\"N-run-ckpt-store\",\n568|        path=f\"{PACKAGE}/run.go\",\n569|        find=\"\\tif known && observation.HasWinner && observation.Winner.HasCheckpoint && stores.Ckpt == nil {\\n\",\n570|        replace=\"\\tif known && observation.HasWinner && observation.Winner.HasCheckpoint && stores.Ckpt == nil && request.Mode == ModeRestore {\\n\",\n571|        count=1,\n572|        run=\"TestRunNoCkptStoreWinnerCheckpointFails\",\n573|        expect=\"KILLED\",\n574|        note=\"Admits exactly launch-mode runs with a checkpoint-carrying winner and no store; restore-mode still fails.\",\n575|    ),\n576|    Mutant(\n577|        name=\"N-emit-losing-epoch\",\n578|        path=f\"{PACKAGE}/events.go\",\n579|        find=\"\\tif _, err := fencing.AuthorizeMutation(params.Presented, params.Observation); err != nil {\\n\",\n580|        replace=\"\\tif _, err := fencing.AuthorizeMutation(params.Presented, params.Observation); err != nil && params.Presented.Epoch >= params.Observation.Winner.Epoch {\\n\",\n581|        count=1,\n582|        run=\"TestEmitUnderLosingLeaseRefuses\",\n583|        expect=\"KILLED\",\n584|        note=\"Admits exactly losing-epoch emissions; same-or-winning-epoch refusals still refuse.\",\n585|    ),\n586|    Mutant(\n587|        name=\"C-doc-comment\",\n588|        path=f\"{PACKAGE}/doc.go\",\n589|        find=\"// `ax pane SESSION_ID` enforcement wrapper: the decision every managed\\n\",\n590|        replace=\"// `ax pane SESSION_ID` enforcement wrapper (control): the decision every managed\\n\",\n591|        count=1,\n592|        run=\"TestRealmCarriesNoCachedEvidence\",\n593|        expect=\"SURVIVED\",\n594|        note=\"Harmless control: a comment-only edit must survive.\",\n595|    ),\n596|]\n597|\n598|\n599|def run_mutant(mutant: Mutant) -> str:\n600|    target = REPO / mutant.path\n601|    original = target.read_text()\n602|    found = original.count(mutant.find)\n603|    if found != mutant.count:\n604|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\"\n605|    with tempfile.TemporaryDirectory() as staging:\n606|        backup = Path(staging) / \"backup\"\n607|        shutil.copy2(target, backup)\n608|        try:\n609|            target.write_text(original.replace(mutant.find, mutant.replace))\n610|            run = subprocess.run(\n611|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n612|                cwd=REPO,\n613|                capture_output=True,\n614|                text=True,\n615|                timeout=300,\n616|            )\n617|        finally:\n618|            shutil.copy2(backup, target)\n619|    output = (run.stdout + run.stderr).strip()\n620|    if os.environ.get(\"AX_MUTANT_VERBOSE\") == \"1\":\n621|        print(f\"--- raw: {mutant.name}: exit {run.returncode} ---\", flush=True)\n622|        print(output, flush=True)\n623|        print(f\"--- end raw: {mutant.name} ---\", flush=True)\n624|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n625|        return f\"ERROR: {mutant.name}: build broke under the patch\"\n626|    if run.returncode == 0:\n627|        verdict = \"SURVIVED\"\n628|    elif '--- FAIL' in output or 'FAIL:' in output:\n629|        verdict = \"KILLED\"\n630|    else:\n631|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\"\n632|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n633|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note} [exit {run.returncode}]\"\n634|\n635|\n636|def main(argv: list[str]) -> int:\n637|    selected = [m for m in MUTANTS if not argv or m.name in argv]\n638|    if argv and len(selected) != len(argv):\n639|        unknown = sorted(set(argv) - {m.name for m in selected})\n640|        print(f\"unknown mutants: {', '.join(unknown)}\")\n641|        return 2\n642|    failures = 0\n643|    for mutant in selected:\n644|        try:\n645|            line = run_mutant(mutant)\n646|        except subprocess.TimeoutExpired:\n647|            line = f\"ERROR: {mutant.name}: killer timed out\"\n648|        print(line, flush=True)\n649|        if not line.startswith(\"ok:\"):\n650|            failures += 1\n651|    return 1 if failures else 0\n652|\n653|\n654|if __name__ == \"__main__\":\n655|    sys.exit(main(sys.argv[1:]))","final_result":true}}}
