{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cfb1","stream":{"kind":"session","id":"01a0b194-ebfd-7972-8291-a2a8c88f871f"},"sequence":1587,"recorded_at":1780531400003169,"record_type":"event","durability":"durable","causation_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","run_stream":{"kind":"run","id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e"},"task_stream":{"kind":"task","id":"01a0b19c-2916-7bb3-b3c2-1a97aced9ea3"},"task_id":"01a0b19c-2916-7bb3-b3c2-1a97aced9ea3","event":{"kind":"output","task_id":"01a0b19c-2916-7bb3-b3c2-1a97aced9ea3","chunk":"edited\nchanged lines: lines 171-178\n--- original\n+++ updated\n@@\n-\t// The winner's checkpoint closure drives the resume profile,\n-\t// so a winner that carries a checkpoint with no checkpoint\n-\t// store bound is unknown, not \"no closure\": deriving from\n-\t// the session head instead would silently promote a\n-\t// head-only change to the launch profile. Fail the run.\n-\tif known && observation.HasWinner && observation.Winner.HasCheckpoint && stores.Ckpt == nil {\n-\t\treturn empty, fmt.Errorf(\"axpane run requires the winner checkpoint closure with no checkpoint store\")\n-\t}\n+\t// The fold's newest checkpoint drives the resume profile\n+\t// closure, so a published newest with no checkpoint store\n+\t// bound is unknown, not \"no closure\": deriving from the\n+\t// session head instead would silently promote a head-only\n+\t// change to the launch profile. Fail the run. (A required\n+\t// checkpoint with no store fails at its own load below; a\n+\t// null fold needs no store at all.)\n+\tif known && input.HasNewestCheckpoint && stores.Ckpt == nil {\n+\t\treturn empty, fmt.Errorf(\"axpane run requires the newest checkpoint closure with no checkpoint store\")\n+\t}\n","final_result":true}}}
