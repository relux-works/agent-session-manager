{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6ab","stream":{"kind":"session","id":"01a0b194-ebfd-7972-8291-a2a8c88f871f"},"sequence":432,"recorded_at":1780531400000859,"record_type":"event","durability":"durable","causation_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","run_stream":{"kind":"run","id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e"},"task_stream":{"kind":"task","id":"01a0b196-71d1-7c63-82a6-028361c2219d"},"task_id":"01a0b196-71d1-7c63-82a6-028361c2219d","event":{"kind":"output","task_id":"01a0b196-71d1-7c63-82a6-028361c2219d","chunk":"Read text file `internal/axpane/gates.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|\t\"os\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/config\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/matjournal\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/sessckpt\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/sessprofile\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n15|)\n16|\n17|// Stores binds the durable owners the adapters read: sessions,\n18|// leases, and events; materialization journals; checkpoints; and\n19|// the wrapper's own bootstrap bindings.\n20|type Stores struct {\n21|\tRepo *sessrepo.Repository\n22|\tMat  *matjournal.Store\n23|\tCkpt *sessckpt.Store\n24|\tPane *Store\n25|}\n26|\n27|// ValidateConfig validates the configuration through the config\n28|// owner. A nil error is the valid outcome Decide gates on; the\n29|// loaded snapshot itself is the caller's to keep.\n30|func ValidateConfig(inputs config.Inputs, overrides config.Overrides) error {\n31|\t_, err := config.Load(inputs, overrides)\n32|\treturn err\n33|}\n34|\n35|// LoadSession loads the logical session through the sessrepo owner.\n36|// known is false only when the session is absent; any read or\n37|// verification failure propagates as an error, never as absence.\n38|func LoadSession(repository *sessrepo.Repository, sessionID string) (known bool, record []byte, err error) {\n39|\tif repository == nil {\n40|\t\treturn false, nil, errors.New(\"axpane session load carries no repository\")\n41|\t}\n42|\traw, err := repository.GetRecord(sessionID)\n43|\tif err != nil {\n44|\t\tif errors.Is(err, sessrepo.ErrUnknownSession) {\n45|\t\t\treturn false, nil, nil\n46|\t\t}\n47|\t\treturn false, nil, err\n48|\t}\n49|\treturn true, raw, nil\n50|}\n51|\n52|// ObserveOwnership loads the winning lease and combines it with the\n53|// caller-reported sync, handoff, grant, and clock facts through the\n54|// fencing owner. A session with no leases yet yields HasWinner\n55|// false without an error: absence is data the gate parks on.\n56|func ObserveOwnership(repository *sessrepo.Repository, sessionID string, input fencing.ObserveInput) (fencing.Observation, error) {\n57|\tif repository == nil {\n58|\t\treturn fencing.Observation{}, errors.New(\"axpane ownership observation carries no repository\")\n59|\t}\n60|\treturn fencing.Observe(repository, sessionID, input)\n61|}\n62|\n63|// LoadProfile loads the decoded session surface the sessprofile\n64|// reducer derives the effective pair from: the Session Record plus\n65|// the authoritative chain in index order.\n66|func LoadProfile(repository *sessrepo.Repository, sessionID string) (sessprofile.Record, []sessprofile.Event, error) {\n67|\tempty := sessprofile.Record{}\n68|\tif repository == nil {\n69|\t\treturn empty, nil, errors.New(\"axpane profile load carries no repository\")\n70|\t}\n71|\trecordJSON, err := repository.GetRecord(sessionID)\n72|\tif err != nil {\n73|\t\treturn empty, nil, err\n74|\t}\n75|\trecord, err := sessprofile.DecodeRecord(recordJSON)\n76|\tif err != nil {\n77|\t\treturn empty, nil, err\n78|\t}\n79|\tsummaries, err := repository.ListEvents(sessionID)\n80|\tif err != nil {\n81|\t\treturn empty, nil, err\n82|\t}\n83|\tevents := make([]sessprofile.Event, 0, len(summaries))\n84|\tfor _, summary := range summaries {\n85|\t\teventJSON, err := repository.GetEvent(sessionID, summary.EventID)\n86|\t\tif err != nil {\n87|\t\t\treturn empty, nil, err\n88|\t\t}\n89|\t\tevent, err := sessprofile.DecodeEvent(eventJSON)\n90|\t\tif err != nil {\n91|\t\t\treturn empty, nil, err\n92|\t\t}\n93|\t\tevents = append(events, event)\n94|\t}\n95|\treturn record, events, nil\n96|}\n97|\n98|// LoadMaterialization loads the required materialization journal\n99|// through the matjournal owner: grammar and cross-reference\n100|// validation run on every read. Admitted is false only when the\n101|// journal is absent; any read or validation failure propagates as\n102|// an error, never as absence.\n103|func LoadMaterialization(store *matjournal.Store, materializationID string) (matjournal.Journal, bool, error) {\n104|\tif store == nil {\n105|\t\treturn matjournal.Journal{}, false, errors.New(\"axpane materialization load carries no store\")\n106|\t}\n107|\tjournal, _, err := store.Get(materializationID)\n108|\tif err != nil {\n109|\t\tif errors.Is(err, matjournal.ErrUnknownJournal) {\n110|\t\t\treturn matjournal.Journal{}, false, nil\n111|\t\t}\n112|\t\treturn matjournal.Journal{}, false, err\n113|\t}\n114|\treturn journal, true, nil\n115|}\n116|\n117|// LoadCheckpoint loads the resume checkpoint through the sessckpt\n118|// owner, which re-attests the closed shape and identity on every\n119|// read. A nil document with a nil error is absence; any read or\n120|// attestation failure propagates as an error, never as absence.\n121|func LoadCheckpoint(store *sessckpt.Store, checkpointID string) ([]byte, error) {\n122|\tif store == nil {\n123|\t\treturn nil, errors.New(\"axpane checkpoint load carries no store\")\n124|\t}\n125|\traw, err := store.Get(checkpointID)\n126|\tif err != nil {\n127|\t\tif os.IsNotExist(err) {\n128|\t\t\treturn nil, nil\n129|\t\t}\n130|\t\treturn nil, err\n131|\t}\n132|\treturn raw, nil\n133|}\n134|\n135|// loadFoldInput loads the session record with its authoritative\n136|// chain in index order as one reducer input. It is the one\n137|// chain-fold reader: the parked-emission fold gate and the\n138|// newest-checkpoint adapter both compose it, never a second fold.\n139|// A read or decode failure propagates as an error, never as an\n140|// empty chain.\n141|func loadFoldInput(repository *sessrepo.Repository, sessionID string) (sessstate.Input, error) {\n142|\tempty := sessstate.Input{}\n143|\tif repository == nil {\n144|\t\treturn empty, errors.New(\"axpane chain fold carries no repository\")\n145|\t}\n146|\trecordJSON, err := repository.GetRecord(sessionID)\n147|\tif err != nil {\n148|\t\treturn empty, err\n149|\t}\n150|\trecord, err := sessstate.DecodeRecord(recordJSON)\n151|\tif err != nil {\n152|\t\treturn empty, err\n153|\t}\n154|\tsummaries, err := repository.ListEvents(sessionID)\n155|\tif err != nil {\n156|\t\treturn empty, err\n157|\t}\n158|\tevents := make([]sessstate.Event, 0, len(summaries))\n159|\tfor _, summary := range summaries {\n160|\t\traw, err := repository.GetEvent(sessionID, summary.EventID)\n161|\t\tif err != nil {\n162|\t\t\treturn empty, err\n163|\t\t}\n164|\t\tevent, err := sessstate.DecodeEvent(raw)\n165|\t\tif err != nil {\n166|\t\t\treturn empty, err\n167|\t\t}\n168|\t\tevents = append(events, event)\n169|\t}\n170|\treturn sessstate.Input{Record: record, Events: events}, nil\n171|}\n172|\n173|// foldChain loads the session record with its authoritative chain\n174|// and folds it through the landed sessstate reducer. A read,\n175|// decode, or reducer failure propagates as an error: the caller\n176|// decides whether an unfolderable chain is untrusted (the newest\n177|// adapter) or simply not emittable (the parked fold gate).\n178|func foldChain(repository *sessrepo.Repository, sessionID string) (sessstate.Projection, error) {\n179|\tempty := sessstate.Projection{}\n180|\tfoldInput, err := loadFoldInput(repository, sessionID)\n181|\tif err != nil {\n182|\t\treturn empty, err\n183|\t}\n184|\treturn sessstate.Reduce(foldInput)\n185|}\n186|\n187|// LoadNewestCheckpoint derives the authoritative newest checkpoint\n188|// through the landed chain fold (sessstate.Reduce over the\n189|// record with its authoritative chain: Projection.HasCheckpoint\n190|// and Newest.ID from checkpoint.created, checkpointed\n191|// session.stopped, and session.resumed). It returns has false with\n192|// an empty ID when the chain publishes no checkpoint. A read,\n193|// decode, or reducer failure propagates as an error, never as\n194|// absence: an unfolderable chain is untrusted, not checkpoint-free.\n195|func LoadNewestCheckpoint(repository *sessrepo.Repository, sessionID string) (has bool, newest string, err error) {\n196|\tprojection, err := foldChain(repository, sessionID)\n197|\tif err != nil {\n198|\t\treturn false, \"\", err\n199|\t}\n200|\tif !projection.HasCheckpoint {\n201|\t\treturn false, \"\", nil\n202|\t}\n203|\treturn true, projection.Newest.ID, nil\n204|}\n205|\n206|// ChainTail returns the record digest and the current tail of the\n207|// authoritative chain for parked-event linkage: the next sequence\n208|// and the predecessor set the emission must reference.\n209|func ChainTail(repository *sessrepo.Repository, sessionID string) (recordID string, tail *sessrepo.EventSummary, err error) {\n210|\tif repository == nil {\n211|\t\treturn \"\", nil, errors.New(\"axpane chain tail carries no repository\")\n212|\t}\n213|\tsummaries, err := repository.ListSessions()\n214|\tif err != nil {\n215|\t\treturn \"\", nil, err\n216|\t}\n217|\tfound := false\n218|\tfor index := range summaries {\n219|\t\tif summaries[index].SessionID == sessionID {\n220|\t\t\trecordID = summaries[index].RecordID\n221|\t\t\tfound = true\n222|\t\t\tbreak\n223|\t\t}\n224|\t}\n225|\tif !found {\n226|\t\treturn \"\", nil, fmt.Errorf(\"chain tail for unknown session %s\", sessionID)\n227|\t}\n228|\tevents, err := repository.ListEvents(sessionID)\n229|\tif err != nil {\n230|\t\treturn \"\", nil, err\n231|\t}\n232|\tif len(events) == 0 {\n233|\t\treturn recordID, nil, nil\n234|\t}\n235|\tprevious := events[len(events)-1]\n236|\treturn recordID, &previous, nil\n237|}","final_result":true}}}
