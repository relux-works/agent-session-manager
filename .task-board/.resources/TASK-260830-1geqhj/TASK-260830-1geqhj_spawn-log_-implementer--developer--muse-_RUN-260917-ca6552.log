re-mode journals under a disagreeing lease; launch-mode still parks.\",\n180|    ),\n181|    Mutant(\n182|        name=\"N-checkpoint-nullfold\",\n183|        path=f\"{PACKAGE}/decide.go\",\n184|        find=\"\\tif !input.HasNewestCheckpoint {\\n\\t\\treturn nil, errCheckpointNoPublished()\\n\\t}\\n\",\n185|        replace=\"\\tif !input.HasNewestCheckpoint && input.Mode == ModeLaunch {\\n\\t\\treturn nil, errCheckpointNoPublished()\\n\\t}\\n\",\n186|        count=1,\n187|        run=\"TestDecideCheckpointNullFoldParks\",\n188|        expect=\"KILLED\",\n189|        note=\"Admits exactly restore-mode checkpoints with no published checkpoint past the null-fold arm; launch-mode still parks with the null cause.\",\n190|    ),\n191|    Mutant(\n192|        name=\"N-checkpoint-agreement\",\n193|        path=f\"{PACKAGE}/decide.go\",\n194|        find=\"\\tif !leaseCheckpointAgrees(input) {\\n\\t\\treturn nil, errCheckpointLeaseDisagree()\\n\\t}\\n\",\n195|        replace=\"\\tif !leaseCheckpointAgrees(input) && input.Mode == ModeLaunch {\\n\\t\\treturn nil, errCheckpointLeaseDisagree()\\n\\t}\\n\",\n196|        count=1,\n197|        run=\"TestDecideCheckpointLeaseFoldDisagreeParks\",\n198|        expect=\"KILLED\",\n199|        note=\"Admits exactly restore-mode checkpoints under a disagreeing lease; launch-mode still parks.\",\n200|    ),\n201|    Mutant(\n202|        name=\"N-checkpoint-absent\",\n203|        path=f\"{PACKAGE}/decide.go\",\n204|        find=\"\\tif input.CheckpointRequired {\\n\",\n205|        replace=\"\\tif input.CheckpointRequired && len(input.CheckpointDoc) > 0 {\\n\",\n206|        count=1,\n207|        run=\"TestDecideTable/parked_checkpoint_absent\",\n208|        expect=\"KILLED\",\n209|        note=\"Admits exactly absent checkpoints; inadmissible bytes still park.\",\n210|    ),\n211|    Mutant(\n212|        name=\"N-checkpoint-prefix\",\n213|        path=f\"{PACKAGE}/decide.go\",\n214|        find=\"\\tif digest.String() != want {\\n\",\n215|