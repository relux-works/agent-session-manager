|\t\t\treturn err\n537|\t\t}\n538|\t}\n539|\tif err := os.Link(stagedPath, target); err != nil {\n540|\t\tif errors.Is(err, os.ErrExist) {\n541|\t\t\t// A concurrent wrapper won the commit between our\n542|\t\t\t// Status and our link: re-read the winner. The\n543|\t\t\t// same operation converges its pair receipt from\n544|\t\t\t// the anchor bytes and reattaches to it; a changed\n545|\t\t\t// operation is the bootstrap-window mismatch.\n546|\t\t\twinner, found, readErr := store.Status(sessionID)\n547|\t\t\tif readErr != nil {\n548|\t\t\t\treturn readErr\n549|\t\t\t}\n550|\t\t\tif !found {\n551|\t\t\t\treturn &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \"bootstrap binding\"}\n552|\t\t\t}\n553|\t\t\tif winner.OperationID != operationID {\n554|\t\t\t\treturn &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \"bootstrap binding\"}\n555|\t\t\t}\n556|\t\t\tconverged, err := store.convergePairFromFirst(sessionID, operationID)\n557|\t\t\tif err != nil {\n558|\t\t\t\treturn err\n559|\t\t\t}\n560|\t\t\treturn errConcurrentWinner{bound: converged}\n561|\t\t}\n562|\t\treturn fmt.Errorf(\"install bootstrap binding: %w\", err)\n563|\t}\n564|\t_ = os.Remove(stagedPath)\n565|\tif store.hooks != nil && store.hooks.AfterInstall != nil {\n566|\t\tif err := store.hooks.AfterInstall(target); err != nil {\n567|\t\t\treturn err\n568|\t\t}\n569|\t}\n570|\tif err := syncDirectory(dir); err != nil {\n571|\t\treturn err\n572|\t}\n573|\t// The anchor committed: record the pair receipt from the same\n574|\t// bytes. A failure here still leaves the committed anchor;\n575|\t// the retry converges the pair from it.\n576|\tif _, err := store.installPair(sessionID, operationID, receipt); err != nil {\n577|\t\treturn err\n578|\t}\n579|\treturn nil\n580|}\n581|\n582|func checkBindingCandidate(candidate Binding) error {\n583|\tif _, err := scalar.ParseUUIDv7(candidate.SessionID); err != nil {\n584|\t\treturn fmt.Errorf(\"binding session %q is not a UUIDv7: %w\", candidate.SessionID, err)\n585|\t}\n586|\tif _, err := scalar.ParseUUIDv7(candidate.OperationID); err != nil {\n587|\t\treturn fmt.Errorf(\"binding operation %q is not a UUIDv7: %w\", candidate.OperationID, err)\n588|\t}\n589|\tif _, err := scalar.ParseUUIDv7(candidate.TerminalInstanceID); err != nil {\n590|\t\treturn fmt.Errorf(\"binding terminal instance %q is not a UUIDv7: %w\", candidate.TerminalInstanceID, err)\n591|\t}\n592|\tif _, err := scalar.ParseDigest(candidate.BindingDigest); err != nil {\n593|\t\treturn fmt.Errorf(\"binding digest is not a digest: %w\", err)\n594|\t}\n595|\t// The candidate carries no timestamp: the store stamps\n596|\t// created_at at install, so a caller clock never enters the\n597|\t// receipt. Stored receipts validate their stamp at decode.\n598|\treturn nil\n599|}\n600|\n601|func encodeBinding(candidate Binding, createdAt string) ([]byte, error) {\n602|\tstored := candidate\n603|\tstored.CreatedAt = createdAt\n604|\tdocument := map[string]string{\n605|\t\t\"schema\":                 bindingSchema,\n606|\t\t\"schema_version\":         bindingSchemaVersion,\n607|\t\t\"session_id\":             stored.SessionID,\n608|\t\t\"bootstrap_operation_id\": stored.OperationID,\n609|\t\t\"terminal_instance_id\":   stored.TerminalInstanceID,\n610|\t\t\"binding_digest\":         stored.BindingDigest,\n611|\t\t\"created_at\":             stored.CreatedAt,\n612|\t}\n613|\traw, err := json.Marshal(document)\n614|\tif err != nil {\n615|\t\treturn nil, fmt.Errorf(\"encode bootstrap binding: %w\", err)\n616|\t}\n617|\treturn raw, nil\n618|}\n619|\n620|func decodeBinding(raw []byte) (Binding, error) {\n621|\tempty := Binding{}\n622|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n623|\tdecoder.DisallowUnknownFields()\n624|\tvar document struct {\n625|\t\tSchema             string `json:\"schema\"`\n626|\t\tSchemaVersion      string `json:\"schema_version\"`\n627|\t\tSessionID          string `json:\"session_id\"`\n628|\t\tOperationID        string `json:\"bootstrap_operation_id\"`\n629|\t\tTerminalInstanceID string `json:\"terminal_instance_id\"`\n630|\t\tBindingDigest      string `json:\"binding_digest\"`\n631|\t\tCreatedAt          string `json:\"created_at\"`\n632|\t}\n633|\tif err := decoder.Decode(&document); err != nil {\n634|\t\treturn empty, fmt.Errorf(\"bootstrap binding is not the closed shape: %w\", err)\n635|\t}\n636|\tif decoder.More() {\n637|\t\treturn empty, fmt.Errorf(\"bootstrap binding carries trailing data\")\n638|\t}\n639|\tvar members map[string]json.RawMessage\n640|\tif err := json.Unmarshal(raw, &members); err != nil {\n641|\t\treturn empty, fmt.Errorf(\"bootstrap binding is not an object: %w\", err)\n642|\t}\n643|\tfor _, name := range bindingMembers {\n644|\t\tif _, ok := members[name]; !ok {\n645|\t\t\treturn empty, fmt.Errorf(\"bootstrap binding misses required member %q\", name)\n646|\t\t}\n647|\t}\n648|\tif document.Schema != bindingSchema || document.SchemaVersion != bindingSchemaVersion {\n649|\t\treturn empty, fmt.Errorf(\"bootstrap binding schema is not %s %s\", bindingSchema, bindingSchemaVersion)\n650|\t}\n651|\tbinding := Binding{\n652|\t\tSessionID:          document.SessionID,\n653|\t\tOperationID:        document.OperationID,\n654|\t\tTerminalInstanceID: document.TerminalInstanceID,\n655|\t\tBindingDigest:      document.BindingDigest,\n656|\t\tCreatedAt:          document.CreatedAt,\n657|\t}\n658|\tif err := checkBindingCandidate(binding); err != nil {\n659|\t\treturn empty, err\n660|\t}\n661|\tif _, err := scalar.ParseTimestamp(binding.CreatedAt); err != nil {\n662|\t\treturn empty, fmt.Errorf(\"binding timestamp is not a timestamp: %w\", err)\n663|\t}\n664|\treturn binding, nil\n665|}\n666|\n667|// BindingDigest computes the opaque binding digest over the canonical\n668|// receipt bytes: the value a §7.A descriptor carries as\n669|// terminal_binding_id. It reveals no generation, PID, or native\n670|// reference.\n671|func BindingDigest(binding Binding) string {\n672|\tsum := sha256.Sum256([]byte(binding.SessionID + \"\\x00\" + binding.OperationID + \"\\x00\" + binding.TerminalInstanceID))\n673|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n674|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6b5","stream":{"kind":"session","id":"01a0b194-ebfd-7972-8291-a2a8c88f871f"},"sequence":437,"recorded_at":1780531400000869,"record_type":"event","durability":"durable","causation_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","run_stream":{"kind":"run","id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e"},"call_id":"call_01a0b1966b617345b5511138a39cd766","text":"Read text file `internal/axpane/errors.go`.\n1|package axpane\n2|\n3|import \"fmt\"\n4|\n5|// Wrapper errors are static, narrow causes: they name the failed\n6|// member and the violated rule, never credentials, generations,\n7|// native references, or terminal output. Landed-gate errors pass\n8|// through as the decision Cause unchanged; these exist only for the\n9|// wrapper's own composition arms.\n10|\n11|type errInvalidArguments struct{ detail string }\n12|\n13|func (err errInvalidArguments) Error() string { return \"invalid_arguments: \" + err.detail }\n14|\n15|type errWrapperMode string\n16|\n17|func (mode errWrapperMode) Error() string {\n18|\treturn fmt.Sprintf(\"wrapper mode %q is not launch or restore\", string(mode))\n19|}\n20|\n21|type errUnknownSession string\n22|\n23|func (session errUnknownSession) Error() string {\n24|\treturn fmt.Sprintf(\"logical session %q is unknown\", string(session))\n25|}\n26|\n27|type errIdempotencyChanged string\n28|\n29|func (session errIdempotencyChanged) Error() string {\n30|\treturn fmt.Sprintf(\"bootstrap operation for session %q changed inside the bootstrap window\", string(session))\n31|}\n32|\n33|type errMaterializationState struct {\n34|\tphase    string\n35|\tadmitted bool\n36|}\n37|\n38|func (err errMaterializationState) Error() string {\n39|\tif !err.admitted {\n40|\t\treturn \"required materialization is not admitted\"\n41|\t}\n42|\treturn fmt.Sprintf(\"required materialization is in phase %q, want committed\", err.phase)\n43|}\n44|\n45|func errMaterializationNotValid(phase string, admitted bool) error {\n46|\treturn errMaterializationState{phase: phase, admitted: admitted}\n47|}\n48|\n49|type errMaterializationStaleValue struct{}\n50|\n51|func (err errMaterializationStaleValue) Error() string {\n52|\treturn \"required materialization is sourced from a superseded checkpoint\"\n53|}\n54|\n55|func errMaterializationStale() error { return errMaterializationStaleValue{} }\n56|\n57|type errCheckpoint struct{ detail string }\n58|\n59|func (err errCheckpoint) Error() string { return err.detail }\n60|\n61|func errCheckpointAbsent() error {\n62|\treturn errCheckpoint{detail: \"resume requires a checkpoint and none is admitted\"}\n63|}\n64|\n65|func errCheckpointMismatch() error {\n66|\treturn errCheckpoint{detail: \"admitted checkpoint identity does not match the required checkpoint\"}\n67|}\n68|\n69|func errCheckpointNoPublished() error {\n70|\treturn errCheckpoint{detail: \"resume requires a published checkpoint and the chain names none\"}\n71|}\n72|\n73|func errCheckpointNotNewest() error {\n74|\treturn errCheckpoint{detail: \"required checkpoint is not the newest published checkpoint\"}\n75|}\n76|\n77|func errCheckpointLeaseDisagree() error {\n78|\treturn errCheckpoint{detail: \"winning lease checkpoint disagrees with the newest published checkpoint\"}\n79|}\n80|\n81|func errMaterializationNoCheckpoint() error {\n82|\treturn errMaterializationSource{detail: \"required materialization names no published checkpoint to bind\"}\n83|}\n84|\n85|func errMaterializationLeaseDisagree() error {\n86|\treturn errMaterializationSource{detail: \"winning lease checkpoint disagrees with the newest published checkpoint\"}\n87|}\n88|\n89|type errMaterializationSource struct{ detail string }\n90|\n91|func (err errMaterializationSource) Error() string { return err.detail }\n92|\n93|func errCheckpointForeign() error {\n94|\treturn errCheckpoint{detail: \"checkpoint names another session\"}\n95|}\n96|\n97|func errCheckpointMembers() error {\n98|\treturn errCheckpoint{detail: \"checkpoint carries no readable bound members\"}\n99|}\n100|\n101|type errSmoke struct{ detail string }\n102|\n103|func (err errSmoke) Error() string { return err.detail }\n104|\n105|func errSmokeVerdict(verdict any) error {\n106|\treturn errSmoke{detail: fmt.Sprintf(\"provider-auth smoke verdict is %v, want pass\", verdict)}\n107|}\n108|\n109|func errSmokeTuple() error {\n110|\treturn errSmoke{detail: \"provider-auth smoke binds another probed build\"}\n111|}\n112|\n113|func errSmokeTargetBuild() error {\n114|\treturn errSmoke{detail: \"provider-auth smoke target binds another probed build\"}\n115|}\n116|\n117|func errSmokeTargetGeneration() error {\n118|\treturn errSmoke{detail: \"provider-auth smoke target binds a stale server generation\"}\n119|}\n120|\n121|func errSmokeTargetOS() error {\n122|\treturn errSmoke{detail: \"provider-auth smoke target binds another OS version\"}\n123|}\n124|\n125|type errRealmValue struct{ detail string }\n126|\n127|func (err errRealmValue) Error() string { return err.detail }\n128|\n129|func errNoRealmEvidence() error {\n130|\treturn errRealmValue{detail: \"no admitted credential realm evidence authorizes the caller\"}\n131|}\n132|\n133|func errRealmGenerationStale() error {\n134|\treturn errRealmValue{detail: \"caller realm generation is stale\"}\n135|}\n136|\n137|func errRealmBinding() error {\n138|\treturn errRealmValue{detail: \"credential realm evidence binds another host binding or provider build\"}\n139|}\n140|\n141|type errHeadlessValue struct{}\n142|\n143|func (err errHeadlessValue) Error() string {\n144|\treturn \"non-interactive create requires headless_creation\"\n145|}\n146|\n147|func errHeadlessRequired() error { return errHeadlessValue{} }\n148|\n149|type errUnknownCaller string\n150|\n151|func (caller errUnknownCaller) Error() string {\n152|\treturn fmt.Sprintf(\"caller realm %q is not foreground or background\", string(caller))\n153|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6b7","stream":{"kind":"session","id":"01a0b194-ebfd-7972-8291-a2a8c88f871f"},"sequence":438,"recorded_at":1780531400000871,"record_type":"event","durability":"durable","causation_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","run_stream":{"kind":"run","id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e"},"call_id":"call_01a0b1966c4e75b4acb89d5b83293766","text":"Read text file `internal/axpane/gates.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|\t\"os\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/config\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/matjournal\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/sessckpt\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/sessprofile\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n15|)\n16|\n17|// Stores binds the durable owners the adapters read: sessions,\n18|// leases, and events; materialization journals; checkpoints; and\n19|// the wrapper's own bootstrap bindings.\n20|type Stores struct {\n21|\tRepo *sessrepo.Repository\n22|\tMat  *matjournal.Store\n23|\tCkpt *sessckpt.Store\n24|\tPane *Store\n25|}\n26|\n27|// ValidateConfig validates the configuration through the config\n28|// owner. A nil error is the valid outcome Decide gates on; the\n29|// loaded snapshot itself is the caller's to keep.\n30|func ValidateConfig(inputs config.Inputs, overrides config.Overrides) error {\n31|\t_, err := config.Load(inputs, overrides)\n32|\treturn err\n33|}\n34|\n35|// LoadSession loads the logical session through the sessrepo owner.\n36|// known is false only when the session is absent; any read or\n37|// verification failure propagates as an error, never as absence.\n38|func LoadSession(repository *sessrepo.Repository, sessionID string) (known bool, record []byte, err error) {\n39|\tif repository == nil {\n40|\t\treturn false, nil, errors.New(\"axpane session load carries no repository\")\n41|\t}\n42|\traw, err := repository.GetRecord(sessionID)\n43|\tif err != nil {\n44|\t\tif errors.Is(err, sessrepo.ErrUnknownSession) {\n45|\t\t\treturn false, nil, nil\n46|\t\t}\n47|\t\treturn false, nil, err\n48|\t}\n49|\treturn true, raw, nil\n50|}\n51|\n52|// ObserveOwnership loads the winning lease and combines it with the\n53|// caller-reported sync, handoff, grant, and clock facts through the\n54|// fencing owner. A session with no leases yet yields HasWinner\n55|// false without an error: absence is data the gate parks on.\n56|func ObserveOwnership(repository *sessrepo.Repository, sessionID string, input fencing.ObserveInput) (fencing.Observation, error) {\n57|\tif repository == nil {\n58|\t\treturn fencing.Observation{}, errors.New(\"axpane ownership observation carries no repository\")\n59|\t}\n60|\treturn fencing.Observe(repository, sessionID, input)\n61|}\n62|\n63|// LoadProfile loads the decoded session surface the sessprofile\n64|// reducer derives the effective pair from: the Session Record plus\n65|// the authoritative chain in index order.\n66|func LoadProfile(repository *sessrepo.Repository, sessionID string) (sessprofile.Record, []sessprofile.Event, error) {\n67|\tempty := sessprofile.Record{}\n68|\tif repository == nil {\n69|\t\treturn empty, nil, errors.New(\"axpane profile load carries no repository\")\n70|\t}\n71|\trecordJSON, err := repository.GetRecord(sessionID)\n72|\tif err != nil {\n73|\t\treturn empty, nil, err\n74|\t}\n75|\trecord, err := sessprofile.DecodeRecord(recordJSON)\n76|\tif err != nil {\n77|\t\treturn empty, nil, err\n78|\t}\n79|\tsummaries, err := repository.ListEvents(sessionID)\n80|\tif err != nil {\n81|\t\treturn empty, nil, err\n82|\t}\n83|\tevents := make([]sessprofile.Event, 0, len(summaries))\n84|\tfor _, summary := range summaries {\n85|\t\teventJSON, err := repository.GetEvent(sessionID, summary.EventID)\n86|\t\tif err != nil {\n87|\t\t\treturn empty, nil, err\n88|\t\t}\n89|\t\tevent, err := sessprofile.DecodeEvent(eventJSON)\n90|\t\tif err != nil {\n91|\t\t\treturn empty, nil, err\n92|\t\t}\n93|\t\tevents = append(events, event)\n94|\t}\n95|\treturn record, events, nil\n96|}\n97|\n98|// LoadMaterialization loads the required materialization journal\n99|// through the matjournal owner: grammar and cross-reference\n100|// validation run on every read. Admitted is false only when the\n101|// journal is absent; any read or validation failure propagates as\n102|// an error, never as absence.\n103|func LoadMaterialization(store *matjournal.Store, materializationID string) (matjournal.Journal, bool, error) {\n104|\tif store == nil {\n105|\t\treturn matjournal.Journal{}, false, errors.New(\"axpane materialization load carries no store\")\n106|\t}\n107|\tjournal, _, err := store.Get(materializationID)\n108|\tif err != nil {\n109|\t\tif errors.Is(err, matjournal.ErrUnknownJournal) {\n110|\t\t\treturn matjournal.Journal{}, false, nil\n111|\t\t}\n112|\t\treturn matjournal.Journal{}, false, err\n113|\t}\n114|\treturn journal, true, nil\n115|}\n116|\n117|// LoadCheckpoint loads the resume checkpoint through the sessckpt\n118|// owner, which re-attests the closed shape and identity on every\n119|// read. A nil document with a nil error is absence; any read or\n120|// attestation failure propagates as an error, never as absence.\n121|func LoadCheckpoint(store *sessckpt.Store, checkpointID string) ([]byte, error) {\n122|\tif store == nil {\n123|\t\treturn nil, errors.New(\"axpane checkpoint load carries no store\")\n124|\t}\n125|\traw, err := store.Get(checkpointID)\n126|\tif err != nil {\n127|\t\tif os.IsNotExist(err) {\n128|\t\t\treturn nil, nil\n129|\t\t}\n130|\t\treturn nil, err\n131|\t}\n132|\treturn raw, nil\n133|}\n134|\n135|// loadFoldInput loads the session record with its authoritative\n136|// chain in index order as one reducer input. It is the one\n137|// chain-fold reader: the parked-emission fold gate and the\n138|// newest-checkpoint adapter both compose it, never a second fold.\n139|// A read or decode failure propagates as an error, never as an\n140|// empty chain.\n141|func loadFoldInput(repository *sessrepo.Repository, sessionID string) (sessstate.Input, error) {\n142|\tempty := sessstate.Input{}\n143|\tif repository == nil {\n144|\t\treturn empty, errors.New(\"axpane chain fold carries no repository\")\n145|\t}\n146|\trecordJSON, err := repository.GetRecord(sessionID)\n147|\tif err != nil {\n148|\t\treturn empty, err\n149|\t}\n150|\trecord, err := sessstate.DecodeRecord(recordJSON)\n151|\tif err != nil {\n152|\t\treturn empty, err\n153|\t}\n154|\tsummaries, err := repository.ListEvents(sessionID)\n155|\tif err != nil {\n156|\t\treturn empty, err\n157|\t}\n158|\tevents := make([]sessstate.Event, 0, len(summaries))\n159|\tfor _, summary := range summaries {\n160|\t\traw, err := repository.GetEvent(sessionID, summary.EventID)\n161|\t\tif err != nil {\n162|\t\t\treturn empty, err\n163|\t\t}\n164|\t\tevent, err := sessstate.DecodeEvent(raw)\n165|\t\tif err != nil {\n166|\t\t\treturn empty, err\n167|\t\t}\n168|\t\tevents = append(events, event)\n169|\t}\n170|\treturn sessstate.Input{Record: record, Events: events}, nil\n171|}\n172|\n173|// foldChain loads the session record with its authoritative chain\n174|// and folds it through the landed sessstate reducer. A read,\n175|// decode, or reducer failure propagates as an error: the caller\n176|// decides whether an unfolderable chain is untrusted (the newest\n177|// adapter) or simply not emittable (the parked fold gate).\n178|func foldChain(repository *sessrepo.Repository, sessionID string) (sessstate.Projection, error) {\n179|\tempty := sessstate.Projection{}\n180|\tfoldInput, err := loadFoldInput(repository, sessionID)\n181|\tif err != nil {\n182|\t\treturn empty, err\n183|\t}\n184|\treturn sessstate.Reduce(foldInput)\n185|}\n186|\n187|// LoadNewestCheckpoint derives the authoritative newest checkpoint\n188|// through the landed chain fold (sessstate.Reduce over the\n189|// record with its authoritative chain: Projection.HasCheckpoint\n190|// and Newest.ID from checkpoint.created, checkpointed\n191|// session.stopped, and session.resumed). It returns has false with\n192|// an empty ID when the chain publishes no checkpoint. A read,\n193|// decode, or reducer failure propagates as an error, never as\n194|// absence: an unfolderable chain is untrusted, not checkpoint-free.\n195|func LoadNewestCheckpoint(repository *sessrepo.Repository, sessionID string) (has bool, newest string, err error) {\n196|\tprojection, err := foldChain(repository, sessionID)\n197|\tif err != nil {\n198|\t\treturn false, \"\", err\n199|\t}\n200|\tif !projection.HasCheckpoint {\n201|\t\treturn false, \"\", nil\n202|\t}\n203|\treturn true, projection.Newest.ID, nil\n204|}\n205|\n206|// ChainTail returns the record digest and the current tail of the\n207|// authoritative chain for parked-event linkage: the next sequence\n208|// and the predecessor set the emission must reference.\n209|func ChainTail(repository *sessrepo.Repository, sessionID string) (recordID string, tail *sessrepo.EventSummary, err error) {\n210|\tif repository == nil {\n211|\t\treturn \"\", nil, errors.New(\"axpane chain tail carries no repository\")\n212|\t}\n213|\tsummaries, err := repository.ListSessions()\n214|\tif err != nil {\n215|\t\treturn \"\", nil, err\n216|\t}\n217|\tfound := false\n218|\tfor index := range summaries {\n219|\t\tif summaries[index].SessionID == sessionID {\n220|\t\t\trecordID = summaries[index].RecordID\n221|\t\t\tfound = true\n222|\t\t\tbreak\n223|\t\t}\n224|\t}\n225|\tif !found {\n226|\t\treturn \"\", nil, fmt.Errorf(\"chain tail for unknown session %s\", sessionID)\n227|\t}\n228|\tevents, err := repository.ListEvents(sessionID)\n229|\tif err != nil {\n230|\t\treturn \"\", nil, err\n231|\t}\n232|\tif len(events) == 0 {\n233|\t\treturn recordID, nil, nil\n234|\t}\n235|\tprevious := events[len(events)-1]\n236|\treturn recordID, &previous, nil\n237|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
