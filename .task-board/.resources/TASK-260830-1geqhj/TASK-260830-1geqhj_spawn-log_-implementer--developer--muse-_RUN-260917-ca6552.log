{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c62b","stream":{"kind":"session","id":"01a0b194-ebfd-7972-8291-a2a8c88f871f"},"sequence":368,"recorded_at":1780531400000731,"record_type":"event","durability":"durable","causation_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","run_stream":{"kind":"run","id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e"},"task_stream":{"kind":"task","id":"01a0b196-4fdc-7d43-9d53-e4a94f3efdcc"},"task_id":"01a0b196-4fdc-7d43-9d53-e4a94f3efdcc","event":{"kind":"output","task_id":"01a0b196-4fdc-7d43-9d53-e4a94f3efdcc","chunk":"Read text file `internal/axpane/decide.go`.\n(399 line(s) above)\n400|\t}\n401|\tif err := checkRealmVocabulary(input.Realm.Caller); err != nil {\n402|\t\treturn refused(ClassInvalidArguments, \"caller realm is not foreground or background\", err)\n403|\t}\n404|\n405|\tadmitted, evidence, err := admitBackend(input)\n406|\tif err != nil {\n407|\t\tvar malformed errInvalidArguments\n408|\t\tif errors.As(err, &malformed) {\n409|\t\t\treturn refused(ClassInvalidArguments, \"caller realm details are incomplete\", err)\n410|\t\t}\n411|\t\tvar typed *axerror.Error\n412|\t\tif errors.As(err, &typed) {\n413|\t\t\tdecision := refused(string(typed.Code()), \"caller has no usable realm evidence\", err)\n414|\t\t\tdecision.RealmFailure = typed\n415|\t\t\treturn decision\n416|\t\t}\n417|\t\treturn refused(backendClass(err), \"terminal backend identity or capability admission failed\", err)\n418|\t}\n419|\tif input.Mode == ModeLaunch && !input.Interactive && !admitted.Has(headlessCreationCapability) {\n420|\t\treturn refused(terminalbackend.CodeCapabilityUnproven,\n421|\t\t\t\"non-interactive create requires headless_creation\",\n422|\t\t\terrHeadlessRequired())\n423|\t}\n424|\n425|\ttoken, err := authorize(input)\n426|\tif err != nil {\n427|\t\tif fencing.IsParked(err) {\n428|\t\t\treason, winning, _ := fencing.ParkDetails(err)\n429|\t\t\treturn decideParked(input, admitted, reason, winning, err)\n430|\t\t}\n431|\t\treturn refused(fencingClass(err), \"fencing refused the wrapper\", err)\n432|\t}\n433|\n434|\tif input.MaterializationRequired {\n435|\t\tif err := checkMaterialization(input); err != nil {\n436|\t\t\treturn parked(fencing.ParkRestorePolicy, input.Observation.Winner.LeaseID, err)\n437|\t\t}\n438|\t}\n439|\tif input.CheckpointRequired {\n440|\t\tif _, err := admitCheckpoint(input); err != nil {\n441|\t\t\treturn parked(fencing.ParkRestorePolicy, input.Observation.Winner.LeaseID, err)\n442|\t\t}\n443|\t}\n444|\n445|\tif err := checkProviderIdentity(input.Provider); err != nil {\n446|\t\treturn refused(providerClass(err), \"provider identity is unresolved\", err)\n447|\t}\n448|\tif err := checkSmoke(input); err != nil {\n449|\t\tdecision := refused(smokeClass(err), \"provider-auth smoke precondition failed\", err)\n450|\t\tvar typed *axerror.Error\n451|\t\tif errors.As(err, &typed) {\n452|\t\t\tdecision.RealmFailure = typed\n453|\t\t}\n454|\t\treturn decision\n455|\t}\n456|\tif err := checkRealm(input, admitted, evidence); err != nil {\n457|\t\tvar malformed errInvalidArguments\n458|\t\tif errors.As(err, &malformed) {\n459|\t\t\treturn refused(ClassInvalidArguments, \"caller realm details are incomplete\", err)\n460|\t\t}\n461|\t\tvar typed *axerror.Error\n462|\t\tif errors.As(err, &typed) {\n463|\t\t\tdecision := refused(string(typed.Code()), \"caller has no admitted realm evidence\", err)\n464|\t\t\tdecision.RealmFailure = typed\n465|\t\t\treturn decision\n466|\t\t}\n467|\t\treturn refused(ClassInvalidArguments, \"caller realm is unverifiable\", err)\n468|\t}\n469|\tpair, err := deriveProfile(input)\n470|\tif err != nil {\n471|\t\treturn refused(ClassIntegrityFailure, \"effective profile derivation failed\", err)\n472|\t}\n473|\t// The tuple gate above already admitted the probed build, so a\n474|\t// ResolveMapping failure here is the mapping gap Section 2.4\n475|\t// names, never a tuple refusal wearing the mapping class.\n476|\tresolved, err := provhost.ResolveMapping(input.Provider.Build.ProviderID, pair.Profile, input.Provider.Build)\n477|\tif err != nil {\n478|\t\treturn refused(ClassProfileMappingUnavailable, \"adapter cannot map the stored profile\", err)\n479|\t}\n480|\tif err := terminalbackend.CheckEntrypoint(input.Entrypoint, input.SessionID); err != nil {\n481|\t\treturn refused(backendClass(err), \"stable entrypoint is not ax pane SESSION_ID\", err)\n482|\t}\n483|\n484|\tdecision := Decision{\n485|\t\tAction:   ActionLaunch,\n486|\t\tToken:    token,\n487|\t\tHasToken: true,\n488|\t\tProfile:  pair,\n489|\t\tMapping:  resolved.Mapping,\n490|\t\tAdmitted: admitted,\n491|\t\tDetail:   \"launch under the winning lease\",\n492|\t}\n493|\tif input.ExistingBinding != nil && input.ExistingBinding.OperationID == input.BootstrapOperationID {\n494|\t\tdecision.Action = ActionReattach\n495|\t\tdecision.Detail = \"reattach to the one recorded wrapper/child\"\n496|\t}\n497|\tdescriptor, err := terminalbackend.AdmitProviderDescriptor(input.Descriptor, input.HostBinding)\n498|\tif err != nil {\n499|\t\treturn refused(backendClass(err), \"provider descriptor does not match the validated binding\", err)\n500|\t}\n501|\tdecision.Descriptor = descriptor\n502|\treturn decision\n503|}\n504|\n505|// decideParked resolves a fencing park into the parked outcome or,\n506|// for a remote owner in an interactive terminal, the attach/takeover\n507|// offer of after-restore step 4. Attach requires the admitted attach\n508|// capability; an interactive remote owner without it offers takeover\n509|// instead of starting a runtime. A remote owner outside an\n510|// interactive terminal parks with the remote_owner reason (§4.2 step\n511|// 5: parked in all other cases). Non-remote parks carry the fencing\n512|// reason unchanged.\n513|func decideParked(input Input, admitted terminalbackend.Admitted, reason fencing.ParkReason, winning string, cause error) Decision {\n514|\tif reason != fencing.ParkRemoteOwner {\n515|\t\treturn parked(reason, winning, cause)\n516|\t}\n517|\tif !input.RemoteInteractive {\n518|\t\treturn parked(reason, winning, cause)\n519|\t}\n520|\tif terminalbackend.CheckOperation(\"attach\", admitted) == nil {\n521|\t\treturn Decision{\n522|\t\t\tAction:         ActionAttachRemote,\n523|\t\t\tParkReason:     reason,\n524|\t\t\tWinningLeaseID: winning,\n525|\t\t\tAdmitted:       admitted,\n526|\t\t\tDetail:         \"offer remote attach; no lease mutation\",\n527|\t\t\tCause:          cause,\n528|\t\t}\n529|\t}\n530|\treturn Decision{\n531|\t\tAction:         ActionTakeoverOffer,\n532|\t\tParkReason:     reason,\n533|\t\tWinningLeaseID: winning,\n534|\t\tAdmitted:       admitted,\n535|\t\tDetail:         \"offer takeover; no runtime started\",\n536|\t\tCause:          cause,\n537|\t}\n538|}\n539|\n540|// bootstrapWindowClosed reports whether the §13.1 bootstrap window\n541|// has closed: the chain fold published a newest checkpoint, so a\n542|// new bootstrap operation is a legitimate post-window binding, not\n543|// an in-window mismatch. The predicate reads only the fold fact,\n544|// never a caller claim and never the lease record's own\n545|// checkpoint, which is null for every epoch-1 owner. A successor\n546|// lease (epoch 2 or later) carries the handoff checkpoint and so\n547|// implies a published newest, but the fold is the authority the\n548|// window closes on.\n549|func bootstrapWindowClosed(input Input) bool {\n550|\treturn input.HasNewestCheckpoint\n551|}\n552|\n553|// authorize selects the fencing entry by mode: activation for a\n554|// fresh launch, restore for the after-restore first start. Both are\n555|// launch-class entries: ownership that is remote, ambiguous,\n556|// unverified, or absent parks with the session.parked vocabulary,\n557|// while malformed calls, foreign sessions, and lapsed grants refuse.\n558|func authorize(input Input) (fencing.LeaseToken, error) {\n559|\tif input.Mode == ModeRestore {\n560|\t\treturn fencing.AuthorizeRestore(input.Presented, input.Observation)\n561|\t}\n562|\treturn fencing.AuthorizeActivation(input.Presented, input.Observation)\n563|}\n564|\n565|// admitBackend parses the §4.B identity documents through the\n566|// terminalbackend owner, reconciles the Probe against the Manifest\n567|// with the returned evidence bound to the AX-known raw generation,\n568|// and gates the mode operation against the admitted set. Only the\n569|// exact admitted capability rows authorize the action; no\n570|// capability map is invented here. The parsed evidence is returned\n571|// alongside the admitted set so the realm arm can bind the\n572|// credential-realm row to the host binding and probed build\n573|// without re-parsing.\n574|func admitBackend(input Input) (terminalbackend.Admitted, []terminalbackend.Evidence, error) {\n575|\tmanifest, err := terminalbackend.ParseManifest(input.Backend.Manifest)\n576|\tif err != nil {\n577|\t\treturn terminalbackend.Admitted{}, nil, err\n578|\t}\n579|\tprobe, err := terminalbackend.ParseProbe(input.Backend.Probe)\n580|\tif err != nil {\n581|\t\treturn terminalbackend.Admitted{}, nil, err\n582|\t}\n583|\tevidence := make([]terminalbackend.Evidence, 0, len(input.Backend.Evidence))\n584|\tfor _, doc := range input.Backend.Evidence {\n585|\t\tparsed, err := terminalbackend.ParseEvidence(doc)\n586|\t\tif err != nil {\n587|\t\t\treturn terminalbackend.Admitted{}, nil, err\n588|\t\t}\n589|\t\tevidence = append(evidence, parsed)\n590|\t}\n591|\tadmitted, err := terminalbackend.Reconcile(manifest, probe, evidence, input.Backend.RawGeneration, input.Backend.Now, input.Backend.Verify)\n592|\tif err != nil {\n593|\t\t// A caller that needs the realm row but submitted only\n594|\t\t// dead realm evidence (expired at the admission instant\n595|\t\t// or bound to a superseded generation) refuses the §4.2\n596|\t\t// capability_unavailable with typed realm/readiness\n597|\t\t// details, not the backend reconcile class: the realm\n598|\t\t// evidence is unusable however the reconcile failed.\n599|\t\tif realmErr := deadRealmRefusal(input, evidence, err); realmErr != nil {\n600|\t\t\treturn terminalbackend.Admitted{}, nil, realmErr\n601|\t\t}\n602|\t\treturn terminalbackend.Admitted{}, nil, err\n603|\t}\n604|\toperation := \"create\"\n605|\tif input.Mode == ModeRestore {\n606|\t\toperation = \"restore\"\n607|\t}\n608|\tif err := terminalbackend.CheckOperation(operation, admitted); err != nil {\n609|\t\treturn terminalbackend.Admitted{}, nil, err\n610|\t}\n611|\treturn admitted, evidence, nil\n612|}\n613|\n614|// checkMaterialization enforces after-restore step 3: the required\n615|// journal must be admitted by the matjournal owner, committed, and\n616|// sourced from the fold's newest published checkpoint, with the\n617|// winning lease's handoff base agreeing when the winner carries\n618|// one. A committed journal one generation behind the newest\n619|// checkpoint is stale, never valid; with no published checkpoint\n620|// the requirement parks, never launches.\n621|func checkMaterialization(input Input) error {\n622|\tif !input.JournalOK || input.Journal.Phase != matjournal.PhaseCommitted {\n623|\t\treturn errMaterializationNotValid(input.Journal.Phase, input.JournalOK)\n624|\t}\n625|\tif !input.HasNewestCheckpoint {\n626|\t\treturn errMaterializationNoCheckpoint()\n627|\t}\n628|\tif input.Journal.SourceCheckpointID != input.NewestCheckpointID {\n629|\t\treturn errMaterializationStale()\n630|\t}\n631|\tif !leaseCheckpointAgrees(input) {\n632|\t\treturn errMaterializationLeaseDisagree()\n633|\t}\n634|\treturn nil\n635|}\n636|\n637|// admitCheckpoint admits exactly the fold's newest published\n638|// checkpoint for resume (§13.11 step 5: validate the newest\n639|// checkpoint). The closed shape must attest through the sessrepo\n640|// owner, the computed identity must equal the required digest, the\n641|// required digest must equal the newest published checkpoint, a\n642|// winning lease that carries a checkpoint must agree with it (the\n643|// successor handoff base), and the checkpoint's own session_id\n644|// must name this session. With no published checkpoint the\n645|// requirement parks: an unpublished checkpoint is never admitted.\n646|// It returns the checkpoint's event-head closure for the profile\n647|// derivation.\n648|func admitCheckpoint(input Input) ([]string, error) {\n649|\tdoc := input.CheckpointDoc\n650|\twant := input.CheckpointID\n651|\tif len(doc) == 0 {\n652|\t\treturn nil, errCheckpointAbsent()\n653|\t}\n654|\tdigest, _, err := sessrepo.AttestCheckpointRecord(doc)\n655|\tif err != nil {\n656|\t\treturn nil, err\n657|\t}\n658|\tif digest.String() != want {\n659|\t\treturn nil, errCheckpointMismatch()\n660|\t}\n661|\tif !input.HasNewestCheckpoint {\n662|\t\treturn nil, errCheckpointNoPublished()\n663|\t}\n664|\tif want != input.NewestCheckpointID {\n665|\t\treturn nil, errCheckpointNotNewest()\n666|\t}\n667|\tif !leaseCheckpointAgrees(input) {\n668|\t\treturn nil, errCheckpointLeaseDisagree()\n669|\t}\n670|\tsessionID, _, _, heads, err := decodeCheckpointMembers(doc)\n671|\tif err != nil {\n672|\t\treturn nil, err\n673|\t}\n674|\tif sessionID != input.SessionID {\n675|\t\treturn nil, errCheckpointForeign()\n676|\t}\n677|\treturn heads, nil\n678|}\n679|\n680|// leaseCheckpointAgrees asserts the winning lease's checkpoint\n681|// against the chain fold's newest: a successor lease's Checkpoint\n682|// is the handoff base and must agree with the published newest.\n683|// The fold stays the authority — this asserts agreement, it never\n684|// selects one fact and ignores the other. A winner that carries\n685|// no checkpoint (every epoch-1 owner) trivially agrees; callers\n686|// park on a null fold before consulting this.\n687|func leaseCheckpointAgrees(input Input) bool {\n688|\tif !input.Observation.HasWinner || !input.Observation.Winner.HasCheckpoint {\n689|\t\treturn true\n690|\t}\n691|\tif !input.HasNewestCheckpoint {\n692|\t\treturn false\n693|\t}\n694|\treturn input.Observation.Winner.Checkpoint == input.NewestCheckpointID\n695|}\n696|\n697|// decodeCheckpointMembers reads the bound members from checkpoint\n698|// bytes the sessrepo owner already attested: the subject session,\n699|// the owning lease, and the event-head closure. It mirrors the\n700|// sessquery extraction after AttestCheckpointRecord: shape and\n701|// identity are the owner's, this is only the member read.\n702|func decodeCheckpointMembers(doc []byte) (sessionID string, leaseEpoch uint64, leaseID string, heads []string, err error) {\n703|\tmembers, fault := environ.DecodeStrictObject(doc)\n704|\tif fault != nil {\n705|\t\treturn \"\", 0, \"\", nil, errCheckpointMembers()\n706|\t}\n707|\tsession, ok := environ.CheckUUIDv7(members[\"session_id\"])\n708|\tif !ok {\n709|\t\treturn \"\", 0, \"\", nil, errCheckpointMembers()\n710|\t}\n711|\tsessionID = session.String()\n712|\trawEpoch, ok := members[\"lease_epoch\"]\n713|\tif !ok {\n714|\t\treturn \"\", 0, \"\", nil, errCheckpointMembers()\n715|\t}\n716|\tvar epochFloat float64\n717|\tif err := json.Unmarshal(rawEpoch, &epochFloat); err != nil || epochFloat < 1 {\n718|\t\treturn \"\", 0, \"\", nil, errCheckpointMembers()\n719|\t}\n720|\tleaseEpoch = uint64(epochFloat)\n721|\tvar lease string\n722|\tif rawLease, ok := members[\"lease_id\"]; ok {\n723|\t\t_ = json.Unmarshal(rawLease, &lease)\n724|\t}\n725|\tif _, err := scalar.ParseUUIDv4(lease); err != nil {\n726|\t\treturn \"\", 0, \"\", nil, errCheckpointMembers()\n727|\t}\n728|\tleaseID = lease\n729|\trawHeads, ok := members[\"event_heads\"]\n730|\tif !ok {\n731|\t\treturn \"\", 0, \"\", nil, errCheckpointMembers()\n732|\t}\n733|\tvar values []string\n734|\tif err := json.Unmarshal(rawHeads, &values); err != nil {\n735|\t\treturn \"\", 0, \"\", nil, errCheckpointMembers()\n736|\t}\n737|\tfor _, value := range values {\n738|\t\thead, err := scalar.ParseDigest(value)\n739|\t\tif err != nil {\n740|\t\t\treturn \"\", 0, \"\", nil, errCheckpointMembers()\n741|\t\t}\n742|\t\theads = append(heads, head.String())\n743|\t}\n744|\treturn sessionID, leaseEpoch, leaseID, heads, nil\n745|}\n746|\n747|// checkpointHeads extracts the event-head closure from checkpoint\n748|// bytes for the profile derivation. It attests through the sessrepo\n749|// owner first; unattested bytes never supply a closure.\n750|func checkpointHeads(doc []byte) ([]string, error) {\n751|\tif len(doc) == 0 {\n752|\t\treturn nil, errCheckpointAbsent()\n753|\t}\n754|\tif _, _, err := sessrepo.AttestCheckpointRecord(doc); err != nil {\n755|\t\treturn nil, err\n756|\t}\n757|\t_, _, _, heads, err := decodeCheckpointMembers(doc)\n758|\treturn heads, err\n759|}\n760|\n761|// deriveProfile derives the effective persisted pair: from the\n762|// validated checkpoint's event-head closure on resume (§13.10),\n763|// from the session head otherwise. The closure heads arrive from\n764|// the winner's checkpoint through Run, or from the required\n765|// checkpoint's own closure when the winner's heads are not\n766|// supplied; a head-only or losing-lease change outside the closure\n767|// never becomes the launch profile.\n768|func deriveProfile(input Input) (sessprofile.Pair, error) {\n769|\theads := input.ProfileHeads\n770|\tif len(heads) == 0 && input.CheckpointRequired && len(input.CheckpointDoc) > 0 {\n771|\t\tclosure, err := checkpointHeads(input.CheckpointDoc)\n772|\t\tif err != nil {\n773|\t\t\treturn sessprofile.Pair{}, err\n774|\t\t}\n775|\t\theads = closure\n776|\t}\n777|\tif len(heads) > 0 {\n778|\t\treturn sessprofile.DeriveForHeads(input.ProfileRecord, input.ProfileEvents, heads)\n779|\t}\n780|\treturn sessprofile.Derive(input.ProfileRecord, input.ProfileEvents)\n781|}\n782|\n783|// checkProviderIdentity composes the provhost resume gate: the exact\n784|// probed build tuple must pass the Section 8.4 direction, the stored\n785|// identity must validate for that provider at that exact version,\n786|// and the discovery proof, when present, must bind to the host-side\n787|// facts.\n788|func checkProviderIdentity(facts ProviderFacts) error {\n789|\tif err := provhost.CheckResumeTuple(facts.Build); err != nil {\n790|\t\treturn err\n791|\t}\n792|\tif err := provhost.VerifyIdentityBuild(facts.Identity, facts.Build); err != nil {\n793|\t\treturn err\n794|\t}\n795|\tif facts.HasDiscovery {\n796|\t\tif err := provhost.VerifyIdentityDiscovery(facts.Identity, facts.Discovery, facts.DiscoveryContext); err != nil {\n797|\t\t\treturn err\n798|\t\t}\n799|\t}\n800|\treturn nil\n801|}\n802|\n803|// checkSmoke enforces the provider-auth smoke precondition when the\n804|// path requires provider credentials. The stored record must verify\n805|// through the resumesmoke owner, its verdict must be pass, its exact\n806|// claimed build must equal the probed build, and the typed target\n807|// must bind the same build with the current generation and the\n808|// probed OS version: a smoke result for one build, generation, or\n809|// OS version never authorizes another. A required smoke that is\n810|// absent, unverifiable, failing, or bound to another\n811|// build/generation/version refuses target_auth_missing with the\n812|// typed details Section 15.3 names.\n813|func checkSmoke(input Input) error {\n814|\tif !input.Smoke.Required {\n815|\t\treturn nil\n816|\t}\n817|\trecord, err := resumesmoke.VerifyRecord(input.Smoke.Record)\n818|\tif err != nil {\n819|\t\treturn smokeFailure(input, err)\n820|\t}\n821|\tif record.Verdict != resumesmoke.VerdictPass {\n822|\t\treturn smokeFailure(input, errSmokeVerdict(record.Verdict))\n823|\t}\n824|\tbuild := input.Provider.Build\n825|\tif record.Tuple.ProviderID != build.ProviderID ||\n826|\t\trecord.Tuple.ProviderVersion != build.ProviderVersion ||\n827|\t\trecord.Tuple.Platform != build.Platform ||\n828|\t\trecord.Tuple.Architecture != build.Architecture {\n829|\t\treturn smokeFailure(input, errSmokeTuple())\n830|\t}\n831|\ttarget := input.Smoke.Target\n832|\tif target.ProviderID != build.ProviderID || target.ProviderBuild != build.ProviderVersion {\n833|\t\treturn smokeFailure(input, errSmokeTargetBuild())\n834|\t}\n835|\tif target.TmuxServerGeneration != input.Backend.RawGeneration {\n836|\t\treturn smokeFailure(input, errSmokeTargetGeneration())\n837|\t}\n838|\tprobe, err := terminalbackend.ParseProbe(input.Backend.Probe)\n839|\tif err != nil {\n840|\t\treturn smokeFailure(input, err)\n841|\t}\n842|\tif target.MacOSVersion != probe.OSVersion {\n843|\t\treturn smokeFailure(input, errSmokeTargetOS())\n844|\t}\n845|\treturn nil\n846|}\n847|\n848|// smokeFailure composes the typed target_auth_missing refusal. Typed\n849|// details are required members of the input: an input that omits\n850|// one is itself malformed and refuses invalid_arguments instead of\n851|// emitting an untyped refusal.\n852|func smokeFailure(input Input, cause error) error {\n853|\tfailure, err := axerror.NewTargetAuthMissing(axerror.Version130,\n854|\t\t\"provider-auth smoke did not pass for the probed build\",\n855|\t\taxerror.NoIDs(), input.Smoke.Target, cause)\n856|\tif err != nil {\n857|\t\treturn fmt.Errorf(\"%w: smoke refusal details are incomplete: %v\", errInvalidArguments{}, err)\n858|\t}\n859|\treturn failure\n860|}\n861|\n862|// checkRealm enforces the §4.C credential conditional with the\n863|// §4.2 background-caller rule: a background caller, and any caller\n864|// on a path that requires provider credentials, authorizes only\n865|// through the admitted credential_capable_execution_realm\n866|// Capability Evidence row bound to the exact host binding, the\n867|// probed provider build, and the current generation, admitted\n868|// through the landed terminalbackend reconcile path. It never falls\n869|// back to direct server creation, and no cached sentinel,\n870|// managername observation, or bare boolean authorizes resume. A\n871|// foreground caller on a credential-free path passes. Expiry,\n872|// logout, and reboot invalidation are the reconcile liveness and\n873|// generation binding the admission already enforces; a stale\n874|// generation in the typed details refuses as well. Typed details\n875|// are required input members: an input that omits one is itself\n876|// malformed and refuses invalid_arguments instead of emitting an\n877|// untyped capability_unavailable.\n878|func checkRealm(input Input, admitted terminalbackend.Admitted, evidence []terminalbackend.Evidence) error {\n879|\tif input.Realm.Caller != CallerBackground && !input.Smoke.Required {\n880|\t\treturn nil\n881|\t}\n882|\tif !admitted.Has(credentialRealmCapability) {\n883|\t\treturn realmFailure(input, errNoRealmEvidence())\n884|\t}\n885|\tif input.Realm.ServerGeneration != input.Backend.RawGeneration {\n886|\t\treturn realmFailure(input, errRealmGenerationStale())\n887|\t}\n888|\tif err := checkRealmBinding(input, evidence); err != nil {\n889|\t\treturn realmFailure(input, err)\n890|\t}\n891|\treturn nil\n892|}\n893|\n894|// checkRealmBinding binds the admitted realm row to the exact host\n895|// binding and probed provider build: some submitted realm evidence\n896|// object must carry the validated host-local terminal binding and\n897|// the probed provider id/build. The scan accepts when any realm\n898|// object binds, so the outcome never depends on evidence order.\n899|// Generation, platform, OS version, expiry, and signature are the\n900|// reconcile binding the admission already proves; this is only the\n901|// wrapper-side cross-bind the lifecycle owner evaluates.\n902|func checkRealmBinding(input Input, evidence []terminalbackend.Evidence) error {\n903|\tseen := false\n904|\tfor _, object := range evidence {\n905|\t\tif object.Capability != credentialRealmCapability {\n906|\t\t\tcontinue\n907|\t\t}\n908|\t\tseen = true\n909|\t\tif object.TerminalBindingID != input.HostBinding.TerminalBindingID {\n910|\t\t\tcontinue\n911|\t\t}\n912|\t\tif object.ProviderID != input.Provider.Build.ProviderID ||\n913|\t\t\tobject.ProviderBuild != input.Provider.Build.ProviderVersion {\n914|\t\t\tcontinue\n915|\t\t}\n916|\t\treturn nil\n917|\t}\n918|\tif !seen {\n919|\t\treturn errNoRealmEvidence()\n920|\t}\n921|\treturn errRealmBinding()\n922|}\n923|\n924|// deadRealmRefusal maps a backend admission failure to the typed\n925|// capability_unavailable refusal when the caller needs the realm\n926|// row, submitted at least one realm evidence object, and none is\n927|// usable (live at the admission instant and bound to the current\n928|// generation). An expired or pre-reboot realm row fails reconcile\n929|// first; the wrapper reports the §4.2 typed refusal the spec\n930|// names, with the reconcile failure as the cause. It returns nil\n931|// when the backend class stands: a caller that needs no realm\n932|// row, no submitted realm row at all, or any usable realm row.\n933|func deadRealmRefusal(input Input, evidence []terminalbackend.Evidence, cause error) error {\n934|\tif input.Realm.Caller != CallerBackground && !input.Smoke.Required {\n935|\t\treturn nil\n936|\t}\n937|\tsubmitted := false\n938|\tfor _, object := range evidence {\n939|\t\tif object.Capability != credentialRealmCapability {\n940|\t\t\tcontinue\n941|\t\t}\n942|\t\tsubmitted = true\n943|\t\tif realmRowUsable(input, object) {\n944|\t\t\treturn nil\n945|\t\t}\n946|\t}\n947|\tif !submitted {\n948|\t\treturn nil\n949|\t}\n950|\treturn realmFailure(input, cause)\n951|}\n952|\n953|// realmRowUsable classifies one parsed realm evidence object for\n954|// the refusal mapping: live at the admission instant and bound to\n955|// the AX-known raw generation. It classifies the refusal only —\n956|// the admission decision (refuse) is already made by Reconcile,\n957|// which re-proves liveness and generation on the admitted path.\n958|func realmRowUsable(input Input, object terminalbackend.Evidence) bool {\n959|\tdigest, err := terminalbackend.GenerationDigest(input.Backend.RawGeneration)\n960|\tif err != nil {\n961|\t\treturn false\n962|\t}\n963|\tif object.BackendGenerationDigest != digest {\n964|\t\treturn false\n965|\t}\n966|\tobserved, err := object.ObservedAt.Time()\n967|\tif err != nil {\n968|\t\treturn false\n969|\t}\n970|\texpires, err := object.ExpiresAt.Time()\n971|\tif err != nil {\n972|\t\treturn false\n973|\t}\n974|\tif observed.After(input.Backend.Now) || !input.Backend.Now.Before(expires) {\n975|\t\treturn false\n976|\t}\n977|\treturn true\n978|}\n979|\n980|// realmFailure composes the typed capability_unavailable refusal.\n981|// Typed details are required members of the input: an input that\n982|// omits one is itself malformed and refuses invalid_arguments\n983|// instead of emitting an untyped refusal.\n984|func realmFailure(input Input, cause error) error {\n985|\tdetails := axerror.RealmEvidence{\n986|\t\tCapability:           credentialRealmCapability,\n987|\t\tCallerRealm:          input.Realm.Caller,\n988|\t\tBrokerState:          input.Realm.BrokerState,\n989|\t\tTmuxServerGeneration: input.Realm.ServerGeneration,\n990|\t\tRemediation:          input.Realm.Remediation,\n991|\t}\n992|\tfailure, err := axerror.NewRealmEvidenceUnavailable(axerror.Version130,\n993|\t\t\"caller has no admitted realm evidence\",\n994|\t\taxerror.NoIDs(), details, cause)\n995|\tif err != nil {\n996|\t\treturn errInvalidArguments{detail: \"background caller realm details are incomplete\"}\n997|\t}\n998|\treturn failure\n999|}\n1000|\n1001|// checkRealmVocabulary closes the caller vocabulary: only\n1002|// foreground and background name a caller.\n1003|func checkRealmVocabulary(caller string) error {\n1004|\tif caller != CallerForeground && caller != CallerBackground {\n1005|\t\treturn errUnknownCaller(caller)\n1006|\t}\n1007|\treturn nil\n1008|}\n1009|\n1010|// backendClass reads the Section 15 code off a terminalbackend\n1011|// refusal. Landed codes pass through verbatim.\n1012|func backendClass(err error) string {\n1013|\tvar backend *terminalbackend.Error\n1014|\tif errors.As(err, &backend) {\n1015|\t\treturn backend.Code\n1016|\t}\n1017|\treturn terminalbackend.CodeMismatch\n1018|}\n1019|\n1020|// fencingClass reads the Section 15 class off a fencing refusal:\n1021|// invalid_arguments for malformed calls, lease_conflict for\n1022|// foreign sessions and lapsed grants. Parks never reach here;\n1023|// decideParked owns them.\n1024|func fencingClass(err error) string {\n1025|\tif errors.Is(err, fencing.ErrInvalidArguments) {\n1026|\t\treturn ClassInvalidArguments\n1027|\t}\n1028|\treturn \"lease_conflict\"\n1029|}\n1030|\n1031|// providerClass reads the Structured Error code off a provhost\n1032|// refusal: invalid_config for tuple and mapping grammar, the\n1033|// provider protocol code for identity and discovery failures.\n1034|func providerClass(err error) string {\n1035|\tvar failure *axerror.Error\n1036|\tif errors.As(err, &failure) {\n1037|\t\treturn string(failure.Code())\n1038|\t}\n1039|\treturn ClassInvalidConfig\n1040|}\n1041|\n1042|// smokeClass reads the Structured Error code off a smoke refusal:\n1043|// target_auth_missing for a required smoke that fails, or\n1044|// invalid_arguments for a malformed smoke input.\n1045|func smokeClass(err error) string {\n1046|\tvar failure *axerror.Error\n1047|\tif errors.As(err, &failure) {\n1048|\t\treturn string(failure.Code())\n1049|\t}\n1050|\tvar malformed errInvalidArguments\n1051|\tif errors.As(err, &malformed) {\n1052|\t\treturn ClassInvalidArguments\n1053|\t}\n1054|\treturn \"target_auth_missing\"\n1055|}","final_result":true}}}
