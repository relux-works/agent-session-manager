{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6a7","stream":{"kind":"session","id":"01a0b194-ebfd-7972-8291-a2a8c88f871f"},"sequence":430,"recorded_at":1780531400000855,"record_type":"event","durability":"durable","causation_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","run_stream":{"kind":"run","id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e"},"task_stream":{"kind":"task","id":"01a0b196-7189-7f50-8a1e-abf6db70f793"},"task_id":"01a0b196-7189-7f50-8a1e-abf6db70f793","event":{"kind":"output","task_id":"01a0b196-7189-7f50-8a1e-abf6db70f793","chunk":"Read text file `internal/axpane/errors.go`.\n1|package axpane\n2|\n3|import \"fmt\"\n4|\n5|// Wrapper errors are static, narrow causes: they name the failed\n6|// member and the violated rule, never credentials, generations,\n7|// native references, or terminal output. Landed-gate errors pass\n8|// through as the decision Cause unchanged; these exist only for the\n9|// wrapper's own composition arms.\n10|\n11|type errInvalidArguments struct{ detail string }\n12|\n13|func (err errInvalidArguments) Error() string { return \"invalid_arguments: \" + err.detail }\n14|\n15|type errWrapperMode string\n16|\n17|func (mode errWrapperMode) Error() string {\n18|\treturn fmt.Sprintf(\"wrapper mode %q is not launch or restore\", string(mode))\n19|}\n20|\n21|type errUnknownSession string\n22|\n23|func (session errUnknownSession) Error() string {\n24|\treturn fmt.Sprintf(\"logical session %q is unknown\", string(session))\n25|}\n26|\n27|type errIdempotencyChanged string\n28|\n29|func (session errIdempotencyChanged) Error() string {\n30|\treturn fmt.Sprintf(\"bootstrap operation for session %q changed inside the bootstrap window\", string(session))\n31|}\n32|\n33|type errMaterializationState struct {\n34|\tphase    string\n35|\tadmitted bool\n36|}\n37|\n38|func (err errMaterializationState) Error() string {\n39|\tif !err.admitted {\n40|\t\treturn \"required materialization is not admitted\"\n41|\t}\n42|\treturn fmt.Sprintf(\"required materialization is in phase %q, want committed\", err.phase)\n43|}\n44|\n45|func errMaterializationNotValid(phase string, admitted bool) error {\n46|\treturn errMaterializationState{phase: phase, admitted: admitted}\n47|}\n48|\n49|type errMaterializationStaleValue struct{}\n50|\n51|func (err errMaterializationStaleValue) Error() string {\n52|\treturn \"required materialization is sourced from a superseded checkpoint\"\n53|}\n54|\n55|func errMaterializationStale() error { return errMaterializationStaleValue{} }\n56|\n57|type errCheckpoint struct{ detail string }\n58|\n59|func (err errCheckpoint) Error() string { return err.detail }\n60|\n61|func errCheckpointAbsent() error {\n62|\treturn errCheckpoint{detail: \"resume requires a checkpoint and none is admitted\"}\n63|}\n64|\n65|func errCheckpointMismatch() error {\n66|\treturn errCheckpoint{detail: \"admitted checkpoint identity does not match the required checkpoint\"}\n67|}\n68|\n69|func errCheckpointNoPublished() error {\n70|\treturn errCheckpoint{detail: \"resume requires a published checkpoint and the chain names none\"}\n71|}\n72|\n73|func errCheckpointNotNewest() error {\n74|\treturn errCheckpoint{detail: \"required checkpoint is not the newest published checkpoint\"}\n75|}\n76|\n77|func errCheckpointLeaseDisagree() error {\n78|\treturn errCheckpoint{detail: \"winning lease checkpoint disagrees with the newest published checkpoint\"}\n79|}\n80|\n81|func errMaterializationNoCheckpoint() error {\n82|\treturn errMaterializationSource{detail: \"required materialization names no published checkpoint to bind\"}\n83|}\n84|\n85|func errMaterializationLeaseDisagree() error {\n86|\treturn errMaterializationSource{detail: \"winning lease checkpoint disagrees with the newest published checkpoint\"}\n87|}\n88|\n89|type errMaterializationSource struct{ detail string }\n90|\n91|func (err errMaterializationSource) Error() string { return err.detail }\n92|\n93|func errCheckpointForeign() error {\n94|\treturn errCheckpoint{detail: \"checkpoint names another session\"}\n95|}\n96|\n97|func errCheckpointMembers() error {\n98|\treturn errCheckpoint{detail: \"checkpoint carries no readable bound members\"}\n99|}\n100|\n101|type errSmoke struct{ detail string }\n102|\n103|func (err errSmoke) Error() string { return err.detail }\n104|\n105|func errSmokeVerdict(verdict any) error {\n106|\treturn errSmoke{detail: fmt.Sprintf(\"provider-auth smoke verdict is %v, want pass\", verdict)}\n107|}\n108|\n109|func errSmokeTuple() error {\n110|\treturn errSmoke{detail: \"provider-auth smoke binds another probed build\"}\n111|}\n112|\n113|func errSmokeTargetBuild() error {\n114|\treturn errSmoke{detail: \"provider-auth smoke target binds another probed build\"}\n115|}\n116|\n117|func errSmokeTargetGeneration() error {\n118|\treturn errSmoke{detail: \"provider-auth smoke target binds a stale server generation\"}\n119|}\n120|\n121|func errSmokeTargetOS() error {\n122|\treturn errSmoke{detail: \"provider-auth smoke target binds another OS version\"}\n123|}\n124|\n125|type errRealmValue struct{ detail string }\n126|\n127|func (err errRealmValue) Error() string { return err.detail }\n128|\n129|func errNoRealmEvidence() error {\n130|\treturn errRealmValue{detail: \"no admitted credential realm evidence authorizes the caller\"}\n131|}\n132|\n133|func errRealmGenerationStale() error {\n134|\treturn errRealmValue{detail: \"caller realm generation is stale\"}\n135|}\n136|\n137|func errRealmBinding() error {\n138|\treturn errRealmValue{detail: \"credential realm evidence binds another host binding or provider build\"}\n139|}\n140|\n141|type errHeadlessValue struct{}\n142|\n143|func (err errHeadlessValue) Error() string {\n144|\treturn \"non-interactive create requires headless_creation\"\n145|}\n146|\n147|func errHeadlessRequired() error { return errHeadlessValue{} }\n148|\n149|type errUnknownCaller string\n150|\n151|func (caller errUnknownCaller) Error() string {\n152|\treturn fmt.Sprintf(\"caller realm %q is not foreground or background\", string(caller))\n153|}","final_result":true}}}
