{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c913","stream":{"kind":"session","id":"01a0b194-ebfd-7972-8291-a2a8c88f871f"},"sequence":740,"recorded_at":1780531400001475,"record_type":"event","durability":"durable","causation_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","run_stream":{"kind":"run","id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e"},"call_id":"call_01a0b1973c05764a80676cb6f5383c05","text":"Read text file `internal/axpane/rev3_test.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"strings\"\n8|\t\"testing\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/matjournal\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n13|)\n14|\n15|// Rev3 rework tests: one root-cause class (P1-1, the fold's newest\n16|// checkpoint versus the lease record's checkpoint), two P2\n17|// (receipt retention, unknown checkpoint store), and the P3\n18|// hardening rows. Each test drives a production entry; the\n19|// narrowing-mutant row that attacks its gate is named in\n20|// TRACEABILITY.md.\n21|\n22|// TestDecideWindowEpochOneOwnerCloses pins P1-1 (window): the\n23|// bootstrap window closes on the fold's newest checkpoint, not on\n24|// the lease record's checkpoint. An epoch-1 winner (null lease\n25|// checkpoint) with a published newest launches a post-window new\n26|// operation. Before the fix (Winner.HasCheckpoint) this refused\n27|// idempotency_mismatch on the creating host.\n28|func TestDecideWindowEpochOneOwnerCloses(t *testing.T) {\n29|\tt.Parallel()\n30|\tdeps := buildDecideDeps(t, true)\n31|\tinput := validInput(t, deps)\n32|\tinput.Mode = ModeRestore\n33|\tinput.BootstrapOperationID = fixtureOtherOp\n34|\tinput.SessionBound = true\n35|\tif input.Observation.Winner.HasCheckpoint {\n36|\t\tt.Fatal(\"fixture winner unexpectedly carries a checkpoint\")\n37|\t}\n38|\tinput.HasNewestCheckpoint = true\n39|\tinput.NewestCheckpointID = deps.ckptID\n40|\tinput.MaterializationRequired = true\n41|\tinput.JournalOK = true\n42|\tinput.Journal = matjournal.Journal{Phase: matjournal.PhaseCommitted, SourceCheckpointID: deps.ckptID, MaterializationID: fixtureMat}\n43|\tinput.CheckpointRequired = true\n44|\tinput.CheckpointDoc = deps.ckptDoc\n45|\tinput.CheckpointID = deps.ckptID\n46|\tdecision := Decide(input)\n47|\tif decision.Action != ActionLaunch {\n48|\t\tt.Fatalf(\"Decide() = (%q, %q, %v), want launch for the epoch-1 owner past its first checkpoint\", decision.Action, decision.Class, decision.Cause)\n49|\t}\n50|}\n51|\n52|// TestDecideCheckpointNullFoldParks pins P1-1 (admission): with no\n53|// published checkpoint, a required checkpoint parks restore_policy\n54|// — even a self-consistent checkpoint of this session. The cause\n55|// pins the null-fold arm (killer for N-checkpoint-nullfold).\n56|func TestDecideCheckpointNullFoldParks(t *testing.T) {\n57|\tt.Parallel()\n58|\tdeps := buildDecideDeps(t, true)\n59|\tinput := validInput(t, deps)\n60|\tinput.Mode = ModeRestore\n61|\tinput.CheckpointRequired = true\n62|\tinput.CheckpointDoc = deps.ckptDoc\n63|\tinput.CheckpointID = deps.ckptID\n64|\tdecision := Decide(input)\n65|\tif decision.Action != ActionParked || decision.ParkReason != fencing.ParkRestorePolicy {\n66|\t\tt.Fatalf(\"Decide() = (%q, %q), want parked restore_policy with no published checkpoint\", decision.Action, decision.ParkReason)\n67|\t}\n68|\tif decision.Cause == nil || !strings.Contains(decision.Cause.Error(), \"resume requires a published checkpoint and the chain names none\") {\n69|\t\tt.Fatalf(\"Decide() cause = %v, want the null-fold arm\", decision.Cause)\n70|\t}\n71|}\n72|\n73|// TestDecideCheckpointUnpublishedParks pins P1-1 (admission): with\n74|// the chain's newest at C, a second attested checkpoint C2 of this\n75|// session that the chain never published parks restore_policy,\n76|// never launches. Before the fix (null lease checkpoint admits\n77|// anything) this launched.\n78|func TestDecideCheckpointUnpublishedParks(t *testing.T) {\n79|\tt.Parallel()\n80|\tdeps := buildDecideDeps(t, true)\n81|\tidleID := appendChainEvent(t, deps.repo, \"session.idle\", 1, fixtureLeaseA, 2, deps.createdID, map[string]any{\n82|\t\t\"boundary_ref\": \"turn-1\", \"foreground_idle\": true, \"background_idle\": true,\n83|\t})\n84|\tc2ID, c2Doc := captureUnpublished(t, deps.repo, deps.ckpt, fixtureOtherOp, []string{idleID})\n85|\tif c2ID == deps.ckptID {\n86|\t\tt.Fatal(\"fixture produced the published checkpoint, want an unpublished one\")\n87|\t}\n88|\tinput := validInput(t, deps)\n89|\tinput.Mode = ModeRestore\n90|\tinput.HasNewestCheckpoint = true\n91|\tinput.NewestCheckpointID = deps.ckptID\n92|\tinput.CheckpointRequired = true\n93|\tinput.CheckpointDoc = c2Doc\n94|\tinput.CheckpointID = c2ID\n95|\tdecision := Decide(input)\n96|\tif decision.Action != ActionParked || decision.ParkReason != fencing.ParkRestorePolicy {\n97|\t\tt.Fatalf(\"Decide() = (%q, %q), want parked restore_policy for the unpublished checkpoint\", decision.Action, decision.ParkReason)\n98|\t}\n99|\tif decision.Cause == nil || !strings.Contains(decision.Cause.Error(), \"not the newest published checkpoint\") {\n100|\t\tt.Fatalf(\"Decide() cause = %v, want the newest arm\", decision.Cause)\n101|\t}\n102|}\n103|\n104|// TestDecideCheckpointLeaseFoldDisagreeParks pins P1-1 (agreement):\n105|// a winning lease whose handoff base disagrees with the fold's\n106|// newest parks restore_policy, even when the caller names the\n107|// newest. The fold stays the authority; agreement is asserted,\n108|// never selected around.\n109|func TestDecideCheckpointLeaseFoldDisagreeParks(t *testing.T) {\n110|\tt.Parallel()\n111|\tdeps := buildDecideDeps(t, true)\n112|\tinput := validInput(t, deps)\n113|\tinput.Mode = ModeRestore\n114|\tinput.HasNewestCheckpoint = true\n115|\tinput.NewestCheckpointID = deps.ckptID\n116|\tinput.Observation.Winner.Checkpoint = seedDigest(0xC9)\n117|\tinput.Observation.Winner.HasCheckpoint = true\n118|\tinput.CheckpointRequired = true\n119|\tinput.CheckpointDoc = deps.ckptDoc\n120|\tinput.CheckpointID = deps.ckptID\n121|\tdecision := Decide(input)\n122|\tif decision.Action != ActionParked || decision.ParkReason != fencing.ParkRestorePolicy {\n123|\t\tt.Fatalf(\"Decide() = (%q, %q), want parked restore_policy for lease/fold disagreement\", decision.Action, decision.ParkReason)\n124|\t}\n125|}\n126|\n127|// TestDecideJournalNullFoldParks pins P1-1 (journal): with no\n128|// published checkpoint, a committed journal sourced from any\n129|// digest parks restore_policy. The cause pins the null-fold arm\n130|// (killer for N-materialization-nullfold).\n131|func TestDecideJournalNullFoldParks(t *testing.T) {\n132|\tt.Parallel()\n133|\tdeps := buildDecideDeps(t, true)\n134|\tinput := validInput(t, deps)\n135|\tinput.Mode = ModeRestore\n136|\tinput.MaterializationRequired = true\n137|\tinput.JournalOK = true\n138|\tinput.Journal = matjournal.Journal{Phase: matjournal.PhaseCommitted, SourceCheckpointID: seedDigest(0xD2), MaterializationID: fixtureMat}\n139|\tdecision := Decide(input)\n140|\tif decision.Action != ActionParked || decision.ParkReason != fencing.ParkRestorePolicy {\n141|\t\tt.Fatalf(\"Decide() = (%q, %q), want parked restore_policy with no published checkpoint\", decision.Action, decision.ParkReason)\n142|\t}\n143|\tif decision.Cause == nil || !strings.Contains(decision.Cause.Error(), \"required materialization names no published checkpoint to bind\") {\n144|\t\tt.Fatalf(\"Decide() cause = %v, want the null-fold arm\", decision.Cause)\n145|\t}\n146|}\n147|\n148|// TestDecideJournalLeaseFoldDisagreeParks pins P1-1 (agreement): a\n149|// journal sourced from the newest still parks when the winning\n150|// lease's handoff base disagrees with the fold.\n151|func TestDecideJournalLeaseFoldDisagreeParks(t *testing.T) {\n152|\tt.Parallel()\n153|\tdeps := buildDecideDeps(t, true)\n154|\tinput := validInput(t, deps)\n155|\tinput.Mode = ModeRestore\n156|\tinput.HasNewestCheckpoint = true\n157|\tinput.NewestCheckpointID = deps.ckptID\n158|\tinput.Observation.Winner.Checkpoint = seedDigest(0xC9)\n159|\tinput.Observation.Winner.HasCheckpoint = true\n160|\tinput.MaterializationRequired = true\n161|\tinput.JournalOK = true\n162|\tinput.Journal = matjournal.Journal{Phase: matjournal.PhaseCommitted, SourceCheckpointID: deps.ckptID, MaterializationID: fixtureMat}\n163|\tdecision := Decide(input)\n164|\tif decision.Action != ActionParked || decision.ParkReason != fencing.ParkRestorePolicy {\n165|\t\tt.Fatalf(\"Decide() = (%q, %q), want parked restore_policy for lease/fold disagreement\", decision.Action, decision.ParkReason)\n166|\t}\n167|}\n168|\n169|// TestRunEpochOneOwnerAfterCheckpoint pins P1-1 through Run: the\n170|// ordinary same-host story — created, idle, stopped with\n171|// checkpoint C on the epoch-1 lease — restores with a new\n172|// bootstrap operation and launches; an unpublished C2 and a\n173|// journal sourced from an unnamed digest park instead of\n174|// launching.\n175|func TestRunEpochOneOwnerAfterCheckpoint(t *testing.T) {\n176|\tt.Parallel()\n177|\tworld := buildRunWorld(t)\n178|\tfirst, err := Run(world.stores(), runRequest(t, world))\n179|\tif err != nil || first.Decision.Action != ActionLaunch {\n180|\t\tt.Fatalf(\"first launch = (%v, %v)\", first.Decision.Action, err)\n181|\t}\n182|\tworld.headID = publishCheckpoint(t, world.repo, world.headID, 2, world.ckptID)\n183|\thas, newest, err := LoadNewestCheckpoint(world.repo, fixtureSession)\n184|\tif err != nil || !has || newest != world.ckptID {\n185|\t\tt.Fatalf(\"LoadNewestCheckpoint() = (%v, %q, %v), want the published checkpoint\", has, newest, err)\n186|\t}\n187|\tobservation, err := ObserveOwnership(world.repo, fixtureSession, runObserve(fixtureNow()))\n188|\tif err != nil {\n189|\t\tt.Fatal(err)\n190|\t}\n191|\tif observation.Winner.Epoch != 1 || observation.Winner.HasCheckpoint {\n192|\t\tt.Fatalf(\"winner = %+v, want the epoch-1 lease with a null checkpoint\", observation.Winner)\n193|\t}\n194|\tworld.mat = journalSourced(t, world.ckptID)\n195|\trequest := runRequest(t, world)\n196|\trequest.Mode = ModeRestore\n197|\trequest.BootstrapOperationID = fixtureOtherOp\n198|\trequest.InstanceID = \"0198f4c9-2222-7bbb-8bbb-1234567890ab\"\n199|\trequest.MaterializationRequired = true\n200|\trequest.MaterializationID = fixtureMat\n201|\trequest.CheckpointRequired = true\n202|\trequest.CheckpointID = world.ckptID\n203|\toutcome, err := Run(world.stores(), request)\n204|\tif err != nil {\n205|\t\tt.Fatalf(\"Run() error = %v\", err)\n206|\t}\n207|\tif outcome.Decision.Action != ActionLaunch {\n208|\t\tt.Fatalf(\"Run() action = %q, class %q, cause %v, want launch for the epoch-1 post-checkpoint restore\",\n209|\t\t\toutcome.Decision.Action, outcome.Decision.Class, outcome.Decision.Cause)\n210|\t}\n211|\tif outcome.Binding == nil || outcome.Binding.OperationID != fixtureOtherOp {\n212|\t\tt.Fatalf(\"Run() binding = %+v, want the op2 pair receipt\", outcome.Binding)\n213|\t}\n214|\n215|\t// The same state with an unpublished C2 required: parks.\n216|\tc2ID, _ := captureUnpublished(t, world.repo, world.ckpt, \"0198f4c8-7d40-7e55-8e6f-1234567890ad\", []string{world.headID})\n217|\top3 := \"0198f4c8-7d40-7e55-8e6f-1234567890ad\"\n218|\tunpublished := runRequest(t, world)\n219|\tunpublished.Mode = ModeRestore\n220|\tunpublished.BootstrapOperationID = op3\n221|\tunpublished.MaterializationRequired = true\n222|\tunpublished.MaterializationID = fixtureMat\n223|\tunpublished.CheckpointRequired = true\n224|\tunpublished.CheckpointID = c2ID\n225|\tparked, err := Run(world.stores(), unpublished)\n226|\tif err != nil {\n227|\t\tt.Fatalf(\"Run() error = %v\", err)\n228|\t}\n229|\tif parked.Decision.Action != ActionParked {\n230|\t\tt.Fatalf(\"Run() action = %q, want parked for the unpublished checkpoint\", parked.Decision.Action)\n231|\t}\n232|\tif _, found, err := world.pane.Lookup(fixtureSession, op3); err != nil || found {\n233|\t\tt.Fatalf(\"Lookup(op3) = (%v, %v), want no binding for the parked retry\", found, err)\n234|\t}\n235|\n236|\t// The same state with a journal sourced from a digest no lease\n237|\t// and no event names: parks.\n238|\tworld.mat = journalSourced(t, seedDigest(0xD2))\n239|\tnameless := runRequest(t, world)\n240|\tnameless.Mode = ModeRestore\n241|\tnameless.BootstrapOperationID = op3\n242|\tnameless.MaterializationRequired = true\n243|\tnameless.MaterializationID = fixtureMat\n244|\tnameless.CheckpointRequired = true\n245|\tnameless.CheckpointID = world.ckptID\n246|\tstale, err := Run(world.stores(), nameless)\n247|\tif err != nil {\n248|\t\tt.Fatalf(\"Run() error = %v\", err)\n249|\t}\n250|\tif stale.Decision.Action != ActionParked {\n251|\t\tt.Fatalf(\"Run() action = %q, want parked for the unnamed-digest journal\", stale.Decision.Action)\n252|\t}\n253|}\n254|\n255|// TestRunNullFoldRestoreParks pins P1-1 through Run: a restore with\n256|// a stored checkpoint and a committed journal parks when the chain\n257|// publishes no checkpoint — captured objects are never relabeled\n258|// as authoritative (§13.1), and no binding installs.\n259|func TestRunNullFoldRestoreParks(t *testing.T) {\n260|\tt.Parallel()\n261|\tworld := buildRunWorld(t)\n262|\trequest := runRequest(t, world)\n263|\trequest.Mode = ModeRestore\n264|\trequest.MaterializationRequired = true\n265|\trequest.MaterializationID = fixtureMat\n266|\trequest.CheckpointRequired = true\n267|\trequest.CheckpointID = world.ckptID\n268|\toutcome, err := Run(world.stores(), request)\n269|\tif err != nil {\n270|\t\tt.Fatalf(\"Run() error = %v\", err)\n271|\t}\n272|\tif outcome.Decision.Action != ActionParked || outcome.Decision.ParkReason != fencing.ParkRestorePolicy {\n273|\t\tt.Fatalf(\"Run() = (%q, %q), want parked restore_policy with no published checkpoint\",\n274|\t\t\toutcome.Decision.Action, outcome.Decision.ParkReason)\n275|\t}\n276|\tif outcome.Binding != nil {\n277|\t\tt.Fatalf(\"Run() binding = %+v, want no binding for the parked restore\", outcome.Binding)\n278|\t}\n279|\tif _, found, err := world.pane.Lookup(fixtureSession, fixtureBootstrap); err != nil || found {\n280|\t\tt.Fatalf(\"Lookup() = (%v, %v), want no binding for the parked restore\", found, err)\n281|\t}\n282|}\n283|\n284|// TestSupersedeKeepsReceipts pins P2-1: post-window pairs record\n285|// alongside — never over — their superseded receipts. An\n286|// identical retry of any recorded pair replays its own receipt,\n287|// and Status keeps pointing at the first binding.\n288|func TestSupersedeKeepsReceipts(t *testing.T) {\n289|\tt.Parallel()\n290|\tstore := openPaneStore(t)\n291|\tfirst, _, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate())\n292|\tif err != nil {\n293|\t\tt.Fatal(err)\n294|\t}\n295|\top3 := \"0198f4c8-7d40-7e55-8e6f-1234567890ad\"\n296|\tsecond := bindCandidate()\n297|\tsecond.OperationID = fixtureOtherOp\n298|\tsecond.TerminalInstanceID = \"0198f4c9-2222-7bbb-8bbb-1234567890ab\"\n299|\tsecond.BindingDigest = BindingDigest(second)\n300|\tthird := bindCandidate()\n301|\tthird.OperationID = op3\n302|\tthird.TerminalInstanceID = \"0198f4c9-3333-7ccc-8ccc-1234567890ab\"\n303|\tthird.BindingDigest = BindingDigest(third)\n304|\tboundSecond, err := store.Supersede(fixtureSession, fixtureOtherOp, second)\n305|\tif err != nil {\n306|\t\tt.Fatalf(\"Supersede(op2) error = %v\", err)\n307|\t}\n308|\tboundThird, err := store.Supersede(fixtureSession, op3, third)\n309|\tif err != nil {\n310|\t\tt.Fatalf(\"Supersede(op3) error = %v\", err)\n311|\t}\n312|\tfor _, want := range []Binding{first, boundSecond, boundThird} {\n313|\t\treplayed, found, err := store.Lookup(fixtureSession, want.OperationID)\n314|\t\tif err != nil || !found || replayed != want {\n315|\t\t\tt.Fatalf(\"Lookup(%q) = (%+v, %v, %v), want the recorded %+v\", want.OperationID, replayed, found, err, want)\n316|\t\t}\n317|\t}\n318|\tanchor, found, err := store.Status(fixtureSession)\n319|\tif err != nil || !found || anchor != first {\n320|\t\tt.Fatalf(\"Status() = (%+v, %v, %v), want the first-binding anchor\", anchor, found, err)\n321|\t}\n322|\tbound, err := store.SessionBound(fixtureSession)\n323|\tif err != nil || !bound {\n324|\t\tt.Fatalf(\"SessionBound() = (%v, %v), want true\", bound, err)\n325|\t}\n326|}\n327|\n328|// TestSupersedeConcurrentDifferentOps pins P2-1: the post-window\n329|// install is no-replace per pair, so two Supersede calls with\n330|// different operations each record their own child.\n331|func TestSupersedeConcurrentDifferentOps(t *testing.T) {\n332|\tt.Parallel()\n333|\tstore := openPaneStore(t)\n334|\tif _, _, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate()); err != nil {\n335|\t\tt.Fatal(err)\n336|\t}\n337|\top3 := \"0198f4c8-7d40-7e55-8e6f-1234567890ad\"\n338|\tsecond := bindCandidate()\n339|\tsecond.OperationID = fixtureOtherOp\n340|\tsecond.TerminalInstanceID = \"0198f4c9-2222-7bbb-8bbb-1234567890ab\"\n341|\tsecond.BindingDigest = BindingDigest(second)\n342|\tthird := bindCandidate()\n343|\tthird.OperationID = op3\n344|\tthird.TerminalInstanceID = \"0198f4c9-3333-7ccc-8ccc-1234567890ab\"\n345|\tthird.BindingDigest = BindingDigest(third)\n346|\tboundSecond, errSecond := store.Supersede(fixtureSession, fixtureOtherOp, second)\n347|\tboundThird, errThird := store.Supersede(fixtureSession, op3, third)\n348|\tif errSecond != nil || errThird != nil {\n349|\t\tt.Fatalf(\"Supersede(op2, op3) = (%v, %v), want both recorded\", errSecond, errThird)\n350|\t}\n351|\tif boundSecond.TerminalInstanceID != second.TerminalInstanceID || boundThird.TerminalInstanceID != third.TerminalInstanceID {\n352|\t\tt.Fatalf(\"Supersede receipts = (%+v, %+v), want one child per pair\", boundSecond, boundThird)\n353|\t}\n354|}\n355|\n356|// TestSupersedeConcurrentSamePairReplays pins P2-1: a second\n357|// wrapper recording the same pair between Lookup and link wins,\n358|// and the loser replays the winner's receipt instead of replacing\n359|// it. The AfterStage hook plays the concurrent winner\n360|// deterministically (killer for N-supersede-no-replace).\n361|func TestSupersedeConcurrentSamePairReplays(t *testing.T) {\n362|\tt.Parallel()\n363|\troot := t.TempDir()\n364|\touter, err := Open(root)\n365|\tif err != nil {\n366|\t\tt.Fatal(err)\n367|\t}\n368|\tif _, _, err := outer.Bind(fixtureSession, fixtureBootstrap, bindCandidate()); err != nil {\n369|\t\tt.Fatal(err)\n370|\t}\n371|\twinner := bindCandidate()\n372|\twinner.OperationID = fixtureOtherOp\n373|\twinner.TerminalInstanceID = \"0198f4c9-2222-7bbb-8bbb-1234567890ab\"\n374|\twinner.BindingDigest = BindingDigest(winner)\n375|\touter.WithHooks(&Hooks{\n376|\t\tAfterStage: func(path string) error {\n377|\t\t\tinner, err := Open(root)\n378|\t\t\tif err != nil {\n379|\t\t\t\treturn err\n380|\t\t\t}\n381|\t\t\tif _, err := inner.Supersede(fixtureSession, fixtureOtherOp, winner); err != nil {\n382|\t\t\t\treturn err\n383|\t\t\t}\n384|\t\t\treturn nil\n385|\t\t},\n386|\t})\n387|\tloser := bindCandidate()\n388|\tloser.OperationID = fixtureOtherOp\n389|\tloser.TerminalInstanceID = \"0198f4c9-4444-7ddd-8ddd-1234567890ab\"\n390|\tloser.BindingDigest = BindingDigest(loser)\n391|\tbound, err := outer.Supersede(fixtureSession, fixtureOtherOp, loser)\n392|\tif err != nil {\n393|\t\tt.Fatalf(\"Supersede() race loser error = %v\", err)\n394|\t}\n395|\tif bound.TerminalInstanceID != winner.TerminalInstanceID {\n396|\t\tt.Fatalf(\"Supersede() race loser = %+v, want the winner's receipt\", bound)\n397|\t}\n398|}\n399|\n400|// TestSupersedeCrashSeams pins P2-1 crash convergence: an aborted\n401|// stage records nothing and keeps the anchor, while a post-commit\n402|// hook error keeps the recorded pair receipt the retry replays.\n403|func TestSupersedeCrashSeams(t *testing.T) {\n404|\tt.Parallel()\n405|\tt.Run(\"stage\", func(t *testing.T) {\n406|\t\tt.Parallel()\n407|\t\tstore := openPaneStore(t)\n408|\t\tfirst, _, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate())\n409|\t\tif err != nil {\n410|\t\t\tt.Fatal(err)\n411|\t\t}\n412|\t\tstore.WithHooks(&Hooks{\n413|\t\t\tAfterStage: func(path string) error { return errFixtureConfig },\n414|\t\t})\n415|\t\tsecond := bindCandidate()\n416|\t\tsecond.OperationID = fixtureOtherOp\n417|\t\tif _, err := store.Supersede(fixtureSession, fixtureOtherOp, second); err == nil {\n418|\t\t\tt.Fatal(\"Supersede() over aborted stage succeeded, want the hook error\")\n419|\t\t}\n420|\t\tif _, found, err := store.Lookup(fixtureSession, fixtureOtherOp); err != nil || found {\n421|\t\t\tt.Fatalf(\"Lookup(op2) = (%v, %v), want absence after the aborted stage\", found, err)\n422|\t\t}\n423|\t\tanchor, found, err := store.Status(fixtureSession)\n424|\t\tif err != nil || !found || anchor != first {\n425|\t\t\tt.Fatalf(\"Status() = (%+v, %v, %v), want the intact anchor\", anchor, found, err)\n426|\t\t}\n427|\t})\n428|\tt.Run(\"install\", func(t *testing.T) {\n429|\t\tt.Parallel()\n430|\t\tstore := openPaneStore(t)\n431|\t\tif _, _, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate()); err != nil {\n432|\t\t\tt.Fatal(err)\n433|\t\t}\n434|\t\tstore.WithHooks(&Hooks{\n435|\t\t\tAfterInstall: func(path string) error { return errFixtureConfig },\n436|\t\t})\n437|\t\tsecond := bindCandidate()\n438|\t\tsecond.OperationID = fixtureOtherOp\n439|\t\tif _, err := store.Supersede(fixtureSession, fixtureOtherOp, second); err == nil {\n440|\t\t\tt.Fatal(\"Supersede() over post-commit hook succeeded, want the hook error\")\n441|\t\t}\n442|\t\tcommitted, found, err := store.Lookup(fixtureSession, fixtureOtherOp)\n443|\t\tif err != nil || !found {\n444|\t\t\tt.Fatalf(\"Lookup(op2) = (%v, %v), want the committed pair receipt\", found, err)\n445|\t\t}\n446|\t\tstore.WithHooks(nil)\n447|\t\treplayed, err := store.Supersede(fixtureSession, fixtureOtherOp, second)\n448|\t\tif err != nil || replayed != committed {\n449|\t\t\tt.Fatalf(\"Supersede() retry = (%+v, %v), want the recorded %+v\", replayed, err, committed)\n450|\t\t}\n451|\t})\n452|}\n453|\n454|// TestRunSupersededPairIdenticalRetry pins P2-1 through Run (§4.1):\n455|// after op2 and op3 each recorded post-window, an identical retry\n456|// of op2 reattaches to op2's own child instead of launching a\n457|// third one.\n458|func TestRunSupersededPairIdenticalRetry(t *testing.T) {\n459|\tt.Parallel()\n460|\tworld := buildRunWorld(t)\n461|\tfirst, err := Run(world.stores(), runRequest(t, world))\n462|\tif err != nil || first.Decision.Action != ActionLaunch {\n463|\t\tt.Fatalf(\"first launch = (%v, %v)\", first.Decision.Action, err)\n464|\t}\n465|\tsuccessor := \"cccccccc-dddd-4eee-8fff-000000000001\"\n466|\tsuccessorLease(t, world.repo, successor, fixtureLocalHost, world.ckptID)\n467|\tworld.headID = publishCheckpoint(t, world.repo, world.headID, 2, world.ckptID)\n468|\tworld.mat = journalSourced(t, world.ckptID)\n469|\trun := func(op, instance string) Outcome {\n470|\t\trequest := runRequest(t, world)\n471|\t\trequest.Mode = ModeRestore\n472|\t\trequest.BootstrapOperationID = op\n473|\t\trequest.InstanceID = instance\n474|\t\trequest.Presented = fencing.PresentedToken{SessionID: fixtureSession, Epoch: 2, LeaseID: successor}\n475|\t\trequest.MaterializationRequired = true\n476|\t\trequest.MaterializationID = fixtureMat\n477|\t\trequest.CheckpointRequired = true\n478|\t\trequest.CheckpointID = world.ckptID\n479|\t\toutcome, err := Run(world.stores(), request)\n480|\t\tif err != nil {\n481|\t\t\tt.Fatalf(\"Run(%s) error = %v\", op, err)\n482|\t\t}\n483|\t\treturn outcome\n484|\t}\n485|\top3 := \"0198f4c8-7d40-7e55-8e6f-1234567890ad\"\n486|\tsecond := run(fixtureOtherOp, \"0198f4c9-2222-7bbb-8bbb-1234567890ab\")\n487|\tif second.Decision.Action != ActionLaunch {\n488|\t\tt.Fatalf(\"Run(op2) action = %q, want launch\", second.Decision.Action)\n489|\t}\n490|\tthird := run(op3, \"0198f4c9-3333-7ccc-8ccc-1234567890ab\")\n491|\tif third.Decision.Action != ActionLaunch {\n492|\t\tt.Fatalf(\"Run(op3) action = %q, want launch\", third.Decision.Action)\n493|\t}\n494|\tretry := run(fixtureOtherOp, \"0198f4c9-4444-7ddd-8ddd-1234567890ab\")\n495|\tif retry.Decision.Action != ActionReattach {\n496|\t\tt.Fatalf(\"Run(op2 retry) action = %q, want reattach to op2's own child\", retry.Decision.Action)\n497|\t}\n498|\tif retry.Binding == nil || retry.Binding.TerminalInstanceID != second.Binding.TerminalInstanceID {\n499|\t\tt.Fatalf(\"Run(op2 retry) binding = %+v, want op2's recorded %+v\", retry.Binding, second.Binding)\n500|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
