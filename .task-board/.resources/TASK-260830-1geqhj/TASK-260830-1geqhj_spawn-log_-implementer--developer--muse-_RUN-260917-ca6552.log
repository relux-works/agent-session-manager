{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6e5","stream":{"kind":"session","id":"01a0b194-ebfd-7972-8291-a2a8c88f871f"},"sequence":461,"recorded_at":1780531400000917,"record_type":"event","durability":"durable","causation_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","run_stream":{"kind":"run","id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e"},"task_stream":{"kind":"task","id":"01a0b196-92aa-7ab1-8076-8ebff252d562"},"task_id":"01a0b196-92aa-7ab1-8076-8ebff252d562","event":{"kind":"output","task_id":"01a0b196-92aa-7ab1-8076-8ebff252d562","chunk":"Read text file `/tmp/rev3ev/probes/zz_review3_probe_test.go`.\n1|package axpane\n2|\n3|// Reviewer probes for CR-TASK-260830-1geqhj-3 (rev 3). These live only\n4|// in the isolated review copy. Each probe asserts the SPEC-expected\n5|// behavior so a RED probe is a finding, not a harness fault; probes\n6|// that only characterize a boundary log it and say so.\n7|//\n8|// R3 = rework verification of the rev2 findings (P1-1, P2-1, P2-2,\n9|// P3-x), each re-driven through a production entry with the rev3\n10|// fixtures (chain-published checkpoints); N3 = new plants one step\n11|// away from the reworked vectors.\n12|\n13|import (\n14|\t\"context\"\n15|\t\"encoding/json\"\n16|\t\"errors\"\n17|\t\"os\"\n18|\t\"os/exec\"\n19|\t\"path/filepath\"\n20|\t\"strings\"\n21|\t\"syscall\"\n22|\t\"testing\"\n23|\t\"time\"\n24|\n25|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n26|\t\"github.com/relux-works/agent-session-manager/internal/matjournal\"\n27|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n28|\t\"github.com/relux-works/agent-session-manager/internal/sessckpt\"\n29|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n30|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n31|)\n32|\n33|const (\n34|\tr3Successor = \"cccccccc-dddd-4eee-8fff-000000000001\"\n35|\tr3Op3       = \"0198f4c8-7d40-7e55-8e6f-1234567890ad\"\n36|\tr3Op4       = \"0198f4c8-7d40-7e55-8e6f-1234567890ae\"\n37|\tr3Inst2     = \"0198f4c9-2222-7bbb-8bbb-1234567890ab\"\n38|\tr3Inst3     = \"0198f4c9-3333-7ccc-8ccc-1234567890ab\"\n39|\tr3Inst4     = \"0198f4c9-4444-7ddd-8ddd-1234567890ab\"\n40|)\n41|\n42|// r3Capture captures a checkpoint of the fixture session under an\n43|// arbitrary owning (epoch, lease) tuple over the given heads.\n44|func r3Capture(t *testing.T, repository *sessrepo.Repository, store *sessckpt.Store, operation string, epoch uint64, leaseID string, heads []string) (string, []byte) {\n45|\tt.Helper()\n46|\treference, raw, err := store.Capture(repository, sessckpt.Inputs{\n47|\t\tOperationID:         operation,\n48|\t\tSessionID:           fixtureSession,\n49|\t\tSessionKind:         sessckpt.SessionKindDirect,\n50|\t\tLeaseEpoch:          epoch,\n51|\t\tLeaseID:             leaseID,\n52|\t\tCreatorHostID:       fixtureLocalHost,\n53|\t\tWorkspaceManifestID: seedDigest(0xE1),\n54|\t\tProviderManifestID:  seedDigest(0xE2),\n55|\t\tBoundary: sessckpt.SafeBoundary{\n56|\t\t\tProviderID: \"codex\", ProviderVersion: \"0.147.0\", Evidence: sessckpt.EvidenceAcceptedTest,\n57|\t\t\tInputBlocked: true, ForegroundIdle: true, BackgroundIdle: true, OpenProcesses: 0, OpenDatabaseHandles: 0,\n58|\t\t},\n59|\t\tEventHeads: heads,\n60|\t\tCreatedAt:  fixtureCreatedAt,\n61|\t\tExtensions: map[string]string{},\n62|\t})\n63|\tif err != nil {\n64|\t\tt.Fatalf(\"Capture(epoch %d) error = %v\", epoch, err)\n65|\t}\n66|\treturn reference.CheckpointID, raw\n67|}\n68|\n69|// r3PostTakeoverWorld builds the ordinary post-takeover story: the\n70|// epoch-1 owner stops with checkpoint C0 (published on the chain), a\n71|// LOCAL successor lease (2,S) is minted with handoff base C0, the\n72|// successor owner resumes from C0, goes idle, and stops with a NEW\n73|// checkpoint C1 published under (2,S). The lease record's checkpoint\n74|// stays C0 forever (immutable record); the chain fold's newest is C1.\n75|func r3PostTakeoverWorld(t *testing.T) (*runWorld, string, string) {\n76|\tt.Helper()\n77|\tworld := buildRunWorld(t)\n78|\tc0 := world.ckptID\n79|\tworld.headID = publishCheckpoint(t, world.repo, world.headID, 2, c0)\n80|\tsuccessorLease(t, world.repo, r3Successor, fixtureLocalHost, c0)\n81|\tresumedID := appendChainEvent(t, world.repo, \"session.resumed\", 2, r3Successor, 1, world.headID, map[string]any{\n82|\t\t\"checkpoint_id\": c0, \"execution_profile\": \"standard\", \"profile_source_event_id\": nil,\n83|\t\t\"terminal_backend\": \"tmux\", \"native_session_id\": \"native-session-alpha\",\n84|\t})\n85|\tidleID := appendChainEvent(t, world.repo, \"session.idle\", 2, r3Successor, 2, resumedID, map[string]any{\n86|\t\t\"boundary_ref\": \"turn-2\", \"foreground_idle\": true, \"background_idle\": true,\n87|\t})\n88|\tc1, _ := r3Capture(t, world.repo, world.ckpt, r3Op3, 2, r3Successor, []string{idleID})\n89|\tworld.headID = appendChainEvent(t, world.repo, \"session.stopped\", 2, r3Successor, 3, idleID, map[string]any{\n90|\t\t\"graceful\": true, \"checkpoint_id\": c1, \"resumable\": true, \"closure_kind\": \"checkpointed\", \"process_closed\": true, \"store_closed\": true,\n91|\t})\n92|\treturn world, c0, c1\n93|}\n94|\n95|func r3RestoreRequest(t *testing.T, world *runWorld, op, instance string, epoch uint64, lease, ckpt string) Request {\n96|\tt.Helper()\n97|\trequest := runRequest(t, world)\n98|\trequest.Mode = ModeRestore\n99|\trequest.BootstrapOperationID = op\n100|\trequest.InstanceID = instance\n101|\trequest.Presented = fencing.PresentedToken{SessionID: fixtureSession, Epoch: epoch, LeaseID: lease}\n102|\trequest.MaterializationRequired = true\n103|\trequest.MaterializationID = fixtureMat\n104|\trequest.CheckpointRequired = true\n105|\trequest.CheckpointID = ckpt\n106|\treturn request\n107|}\n108|\n109|// ---------------------------------------------------------------\n110|// P1-1 rework verification (window / admission / journal keyed on\n111|// the chain fold, epoch-1 owner)\n112|// ---------------------------------------------------------------\n113|\n114|// R3-1: the ordinary same-host story restores with a new bootstrap\n115|// operation through Run, and an identical retry of that operation\n116|// reattaches to the one child.\n117|func TestR3EpochOneOwnerRestoreLaunchesAndRetryReattaches(t *testing.T) {\n118|\tworld := buildRunWorld(t)\n119|\tfirst, err := Run(world.stores(), runRequest(t, world))\n120|\tif err != nil || first.Decision.Action != ActionLaunch {\n121|\t\tt.Fatalf(\"first launch = (%v, %v)\", first.Decision.Action, err)\n122|\t}\n123|\tworld.headID = publishCheckpoint(t, world.repo, world.headID, 2, world.ckptID)\n124|\tobservation, err := ObserveOwnership(world.repo, fixtureSession, runObserve(fixtureNow()))\n125|\tif err != nil {\n126|\t\tt.Fatal(err)\n127|\t}\n128|\thas, newest, err := LoadNewestCheckpoint(world.repo, fixtureSession)\n129|\tif err != nil {\n130|\t\tt.Fatal(err)\n131|\t}\n132|\tt.Logf(\"lease: epoch=%d HasCheckpoint=%v | fold: has=%v newest=%s\", observation.Winner.Epoch, observation.Winner.HasCheckpoint, has, newest[:20])\n133|\tif observation.Winner.HasCheckpoint || !has || newest != world.ckptID {\n134|\t\tt.Fatalf(\"fixture does not reproduce the epoch-1 null-lease-checkpoint state\")\n135|\t}\n136|\tworld.mat = journalSourced(t, world.ckptID)\n137|\trestore := r3RestoreRequest(t, world, fixtureOtherOp, r3Inst2, 1, fixtureLeaseA, world.ckptID)\n138|\toutcome, err := Run(world.stores(), restore)\n139|\tif err != nil {\n140|\t\tt.Fatalf(\"Run() error = %v\", err)\n141|\t}\n142|\tt.Logf(\"epoch-1 owner post-checkpoint restore, new op: action=%s class=%q cause=%v\", outcome.Decision.Action, outcome.Decision.Class, outcome.Decision.Cause)\n143|\tif outcome.Decision.Action != ActionLaunch || outcome.Binding == nil || outcome.Binding.OperationID != fixtureOtherOp {\n144|\t\tt.Fatalf(\"FINDING: epoch-1 owner restore with a new operation did not launch with the op2 receipt: %+v\", outcome.Binding)\n145|\t}\n146|\tretry := r3RestoreRequest(t, world, fixtureOtherOp, r3Inst4, 1, fixtureLeaseA, world.ckptID)\n147|\tagain, err := Run(world.stores(), retry)\n148|\tif err != nil {\n149|\t\tt.Fatalf(\"Run() retry error = %v\", err)\n150|\t}\n151|\tt.Logf(\"identical retry of op2 with different child facts: action=%s instance=%s\", again.Decision.Action, again.Binding.TerminalInstanceID)\n152|\tif again.Decision.Action != ActionReattach || again.Binding.TerminalInstanceID != outcome.Binding.TerminalInstanceID {\n153|\t\tt.Fatalf(\"FINDING: identical retry did not reattach to the one child\")\n154|\t}\n155|}\n156|\n157|// R3-2: with the chain newest at C, a second attested checkpoint C2\n158|// the chain never published parks at the \"not newest\" arm through\n159|// Run, and no binding installs.\n160|func TestR3UnpublishedCheckpointParksAtNewestArm(t *testing.T) {\n161|\tworld := buildRunWorld(t)\n162|\tworld.headID = publishCheckpoint(t, world.repo, world.headID, 2, world.ckptID)\n163|\tc2, _ := captureUnpublished(t, world.repo, world.ckpt, r3Op3, []string{world.headID})\n164|\tworld.mat = journalSourced(t, world.ckptID)\n165|\trequest := r3RestoreRequest(t, world, fixtureOtherOp, r3Inst2, 1, fixtureLeaseA, c2)\n166|\toutcome, err := Run(world.stores(), request)\n167|\tif err != nil {\n168|\t\tt.Fatalf(\"Run() error = %v\", err)\n169|\t}\n170|\tt.Logf(\"chain newest=C, caller C2 unpublished: action=%s reason=%s cause=%v\", outcome.Decision.Action, outcome.Decision.ParkReason, outcome.Decision.Cause)\n171|\tif outcome.Decision.Action != ActionParked || outcome.Decision.ParkReason != fencing.ParkRestorePolicy {\n172|\t\tt.Fatalf(\"FINDING: unpublished checkpoint did not park\")\n173|\t}\n174|\tif outcome.Decision.Cause == nil || !strings.Contains(outcome.Decision.Cause.Error(), \"not the newest published checkpoint\") {\n175|\t\tt.Fatalf(\"FINDING: parked at the wrong arm: %v\", outcome.Decision.Cause)\n176|\t}\n177|\tif _, found, err := world.pane.Lookup(fixtureSession, fixtureOtherOp); err != nil || found {\n178|\t\tt.Fatalf(\"binding installed for a parked restore: found=%v err=%v\", found, err)\n179|\t}\n180|}\n181|\n182|// R3-3: a committed journal sourced from a digest no lease and no\n183|// event names parks at the stale-source arm through Run.\n184|func TestR3UnnamedSourceJournalParks(t *testing.T) {\n185|\tworld := buildRunWorld(t)\n186|\tworld.headID = publishCheckpoint(t, world.repo, world.headID, 2, world.ckptID)\n187|\tworld.mat = journalSourced(t, seedDigest(0xD2))\n188|\trequest := r3RestoreRequest(t, world, fixtureOtherOp, r3Inst2, 1, fixtureLeaseA, world.ckptID)\n189|\toutcome, err := Run(world.stores(), request)\n190|\tif err != nil {\n191|\t\tt.Fatalf(\"Run() error = %v\", err)\n192|\t}\n193|\tt.Logf(\"journal sourced from 0xD2, chain newest=C: action=%s cause=%v\", outcome.Decision.Action, outcome.Decision.Cause)\n194|\tif outcome.Decision.Action != ActionParked || outcome.Decision.Cause == nil || !strings.Contains(outcome.Decision.Cause.Error(), \"superseded checkpoint\") {\n195|\t\tt.Fatalf(\"FINDING: unnamed-source journal did not park at the stale-source arm\")\n196|\t}\n197|}\n198|\n199|// N3-1 (one step past P1-1): the ordinary POST-TAKEOVER story. The\n200|// successor lease's checkpoint is the handoff base C0 (immutable\n201|// lease record); the successor owner then publishes C1. A restore\n202|// on that owner with a journal sourced from C1 and checkpoint C1 is\n203|// the after-restore step-3 positive: winning lease + valid required\n204|// materialization. §5.3 fixes the lease checkpoint at the handoff\n205|// base; §5.7/§13.11 step 5 validate the NEWEST checkpoint. The spec\n206|// expects launch.\n207|func TestN3PostTakeoverLifecycleRestoreLaunches(t *testing.T) {\n208|\tworld, c0, c1 := r3PostTakeoverWorld(t)\n209|\tobservation, err := ObserveOwnership(world.repo, fixtureSession, runObserve(fixtureNow()))\n210|\tif err != nil {\n211|\t\tt.Fatal(err)\n212|\t}\n213|\thas, newest, err := LoadNewestCheckpoint(world.repo, fixtureSession)\n214|\tif err != nil {\n215|\t\tt.Fatalf(\"LoadNewestCheckpoint() error = %v (the post-takeover chain must fold)\", err)\n216|\t}\n217|\tt.Logf(\"winner: epoch=%d lease=%s HasCheckpoint=%v Checkpoint=%s | fold newest: has=%v %s | C0=%s C1=%s\",\n218|\t\tobservation.Winner.Epoch, observation.Winner.LeaseID[:8], observation.Winner.HasCheckpoint, observation.Winner.Checkpoint[:20], has, newest[:20], c0[:20], c1[:20])\n219|\tif observation.Winner.Epoch != 2 || observation.Winner.Checkpoint != c0 || newest != c1 {\n220|\t\tt.Fatalf(\"fixture does not reproduce the post-takeover state\")\n221|\t}\n222|\tworld.mat = journalSourced(t, c1)\n223|\trequest := r3RestoreRequest(t, world, fixtureOtherOp, r3Inst2, 2, r3Successor, c1)\n224|\toutcome, err := Run(world.stores(), request)\n225|\tif err != nil {\n226|\t\tt.Fatalf(\"Run() error = %v\", err)\n227|\t}\n228|\tt.Logf(\"post-takeover restore (journal from C1, checkpoint C1, presented (2,S)): action=%s reason=%s cause=%v\",\n229|\t\toutcome.Decision.Action, outcome.Decision.ParkReason, outcome.Decision.Cause)\n230|\tif outcome.Decision.Action != ActionLaunch {\n231|\t\tt.Fatalf(\"FINDING: the successor owner cannot restore after publishing its own checkpoint: action=%s cause=%v\", outcome.Decision.Action, outcome.Decision.Cause)\n232|\t}\n233|}\n234|\n235|// N3-1b: the same through the pure core, with the Decide input built\n236|// exactly as Run would build it.\n237|func TestN3PostTakeoverLifecycleDecide(t *testing.T) {\n238|\tdeps := buildDecideDeps(t, true)\n239|\tinput := validInput(t, deps)\n240|\tinput.Mode = ModeRestore\n241|\tinput.Presented = fencing.PresentedToken{SessionID: fixtureSession, Epoch: 2, LeaseID: r3Successor}\n242|\tinput.Observation.Winner.Epoch = 2\n243|\tinput.Observation.Winner.LeaseID = r3Successor\n244|\tinput.Observation.Winner.HasCheckpoint = true\n245|\tinput.Observation.Winner.Checkpoint = seedDigest(0xC0) // handoff base C0\n246|\tinput.Observation.Grant.Token = sessrepo.FencingToken{Epoch: 2, LeaseID: r3Successor, HolderHostID: fixtureLocalHost}\n247|\tinput.HasNewestCheckpoint = true\n248|\tinput.NewestCheckpointID = deps.ckptID // C1 published by the successor\n249|\tinput.MaterializationRequired = true\n250|\tinput.JournalOK = true\n251|\tinput.Journal = matjournal.Journal{Phase: matjournal.PhaseCommitted, SourceCheckpointID: deps.ckptID, MaterializationID: fixtureMat}\n252|\tinput.CheckpointRequired = true\n253|\tinput.CheckpointDoc = deps.ckptDoc\n254|\tinput.CheckpointID = deps.ckptID\n255|\tdecision := Decide(input)\n256|\tt.Logf(\"Decide post-takeover (lease base C0 != fold newest C1): action=%s reason=%s cause=%v\", decision.Action, decision.ParkReason, decision.Cause)\n257|\tif decision.Action != ActionLaunch {\n258|\t\tt.Fatalf(\"FINDING: Decide parks the successor owner after it published a newer checkpoint: %v\", decision.Cause)\n259|\t}\n260|}\n261|\n262|// N3-2: in the post-takeover world, a caller that names the handoff\n263|// base C0 (stale) instead of the newest C1 parks at the newest arm.\n264|func TestN3PostTakeoverStaleBaseParks(t *testing.T) {\n265|\tworld, c0, _ := r3PostTakeoverWorld(t)\n266|\tworld.mat = journalSourced(t, c0)\n267|\trequest := r3RestoreRequest(t, world, fixtureOtherOp, r3Inst2, 2, r3Successor, c0)\n268|\toutcome, err := Run(world.stores(), request)\n269|\tif err != nil {\n270|\t\tt.Fatalf(\"Run() error = %v\", err)\n271|\t}\n272|\tt.Logf(\"post-takeover restore naming the stale base C0: action=%s cause=%v\", outcome.Decision.Action, outcome.Decision.Cause)\n273|\tif outcome.Decision.Action != ActionParked {\n274|\t\tt.Fatalf(\"FINDING: the stale handoff base was admitted for resume\")\n275|\t}\n276|}\n277|\n278|// N3-3: launch mode with a successor lease carrying a checkpoint the\n279|// chain never published: the lease/fold agreement is consulted only\n280|// on the required-materialization/checkpoint arms. This probe\n281|// characterizes the boundary (logs it) and asserts only that no\n282|// unpublished checkpoint is admitted as a REQUIRED checkpoint.\n283|func TestN3LaunchModeLeaseFoldDisagreementCharacterized(t *testing.T) {\n284|\tworld := buildRunWorld(t)\n285|\tif _, err := Run(world.stores(), runRequest(t, world)); err != nil {\n286|\t\tt.Fatal(err)\n287|\t}\n288|\tsuccessorLease(t, world.repo, r3Successor, fixtureLocalHost, world.ckptID)\n289|\thas, _, err := LoadNewestCheckpoint(world.repo, fixtureSession)\n290|\tif err != nil {\n291|\t\tt.Fatal(err)\n292|\t}\n293|\trequest := runRequest(t, world)\n294|\trequest.Mode = ModeLaunch\n295|\trequest.BootstrapOperationID = fixtureOtherOp\n296|\trequest.InstanceID = r3Inst2\n297|\trequest.Presented = fencing.PresentedToken{SessionID: fixtureSession, Epoch: 2, LeaseID: r3Successor}\n298|\toutcome, err := Run(world.stores(), request)\n299|\tt.Logf(\"launch mode, successor lease carries unpublished C, fold has=%v: action=%s class=%q err=%v\", has, outcome.Decision.Action, outcome.Decision.Class, err)\n300|\tif err == nil && outcome.Decision.Action == ActionLaunch {\n301|\t\tt.Fatalf(\"FINDING-CANDIDATE: launch-mode changed op with an inconsistent lease/fold pair launched with binding %+v\", outcome.Binding)\n302|\t}\n303|\trequired := request\n304|\trequired.CheckpointRequired = true\n305|\trequired.CheckpointID = world.ckptID\n306|\toutcome, err = Run(world.stores(), required)\n307|\tif err != nil {\n308|\t\tt.Fatalf(\"Run() error = %v\", err)\n309|\t}\n310|\tt.Logf(\"same with the unpublished checkpoint REQUIRED: action=%s cause=%v\", outcome.Decision.Action, outcome.Decision.Cause)\n311|\tif outcome.Decision.Action == ActionLaunch {\n312|\t\tt.Fatalf(\"FINDING: an unpublished checkpoint was admitted as a required checkpoint\")\n313|\t}\n314|}\n315|\n316|// ---------------------------------------------------------------\n317|// P2-1 rework verification (per-pair receipts survive supersession)\n318|// ---------------------------------------------------------------\n319|\n320|func r3Inode(t *testing.T, path string) (uint64, time.Time) {\n321|\tt.Helper()\n322|\tinfo, err := os.Stat(path)\n323|\tif err != nil {\n324|\t\tt.Fatalf(\"stat %s: %v\", path, err)\n325|\t}\n326|\tstat, ok := info.Sys().(*syscall.Stat_t)\n327|\tif !ok {\n328|\t\tt.Fatal(\"no inode on this platform\")\n329|\t}\n330|\treturn stat.Ino, info.ModTime()\n331|}\n332|\n333|// R3-4: post-window op2 and op3 each launch their own child; an\n334|// identical retry of op2 (different child facts) reattaches to op2's\n335|// own child without rewriting its receipt; Status keeps the first\n336|// anchor; every pair replays through Lookup.\n337|func TestR3SupersededPairIdenticalRetryReattaches(t *testing.T) {\n338|\tworld := buildRunWorld(t)\n339|\tfirst, err := Run(world.stores(), runRequest(t, world))\n340|\tif err != nil || first.Decision.Action != ActionLaunch {\n341|\t\tt.Fatalf(\"first launch = (%v, %v)\", first.Decision.Action, err)\n342|\t}\n343|\tworld.headID = publishCheckpoint(t, world.repo, world.headID, 2, world.ckptID)\n344|\tworld.mat = journalSourced(t, world.ckptID)\n345|\trun := func(op, instance string) Outcome {\n346|\t\toutcome, err := Run(world.stores(), r3RestoreRequest(t, world, op, instance, 1, fixtureLeaseA, world.ckptID))\n347|\t\tif err != nil {\n348|\t\t\tt.Fatalf(\"Run(%s) error = %v\", op[len(op)-2:], err)\n349|\t\t}\n350|\t\treturn outcome\n351|\t}\n352|\tsecond := run(fixtureOtherOp, r3Inst2)\n353|\tthird := run(r3Op3, r3Inst3)\n354|\tt.Logf(\"op2: action=%s inst=%s | op3: action=%s inst=%s\", second.Decision.Action, second.Binding.TerminalInstanceID[9:13], third.Decision.Action, third.Binding.TerminalInstanceID[9:13])\n355|\tif second.Decision.Action != ActionLaunch || third.Decision.Action != ActionLaunch {\n356|\t\tt.Fatalf(\"post-window launches did not both launch\")\n357|\t}\n358|\treceipt := world.pane.receiptPath(fixtureSession, fixtureOtherOp)\n359|\tinoBefore, mtimeBefore := r3Inode(t, receipt)\n360|\tretry := run(fixtureOtherOp, r3Inst4)\n361|\tinoAfter, mtimeAfter := r3Inode(t, receipt)\n362|\tt.Logf(\"identical retry of op2 after op3: action=%s inst=%s receipt inode %d->%d mtime-equal=%v\",\n363|\t\tretry.Decision.Action, retry.Binding.TerminalInstanceID[9:13], inoBefore, inoAfter, mtimeBefore.Equal(mtimeAfter))\n364|\tif retry.Decision.Action != ActionReattach || retry.Binding.TerminalInstanceID != second.Binding.TerminalInstanceID {\n365|\t\tt.Fatalf(\"FINDING: identical retry of a superseded pair launched a third child\")\n366|\t}\n367|\tif inoBefore != inoAfter || !mtimeBefore.Equal(mtimeAfter) {\n368|\t\tt.Fatalf(\"FINDING: identical retry rewrote the pair receipt\")\n369|\t}\n370|\tanchor, found, err := world.pane.Status(fixtureSession)\n371|\tif err != nil || !found || anchor.OperationID != fixtureBootstrap {\n372|\t\tt.Fatalf(\"Status() = (%+v, %v, %v), want the first anchor\", anchor, found, err)\n373|\t}\n374|\tfor _, want := range []*Binding{first.Binding, second.Binding, third.Binding} {\n375|\t\tgot, found, err := world.pane.Lookup(fixtureSession, want.OperationID)\n376|\t\tif err != nil || !found || got != *want {\n377|\t\t\tt.Fatalf(\"Lookup(%s) = (%+v, %v, %v), want %+v\", want.OperationID[len(want.OperationID)-2:], got, found, err, *want)\n378|\t\t}\n379|\t}\n380|\tentries, _ := os.ReadDir(world.pane.receiptsDir(fixtureSession))\n381|\tnames := make([]string, 0, len(entries))\n382|\tfor _, entry := range entries {\n383|\t\tnames = append(names, entry.Name())\n384|\t}\n385|\tt.Logf(\"receipts dir: %v\", names)\n386|\tif len(entries) != 3 {\n387|\t\tt.Fatalf(\"receipts = %d, want exactly 3\", len(entries))\n388|\t}\n389|}\n390|\n391|// R3-5: Supersede is no-replace per pair: a same-pair Supersede with\n392|// different child facts replays the recorded receipt (same inode,\n393|// same bytes) instead of replacing it.\n394|func TestR3SupersedeSamePairNoReplace(t *testing.T) {\n395|\tstore := openPaneStore(t)\n396|\tif _, _, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate()); err != nil {\n397|\t\tt.Fatal(err)\n398|\t}\n399|\tsecond := bindCandidate()\n400|\tsecond.OperationID = fixtureOtherOp\n401|\tsecond.TerminalInstanceID = r3Inst2\n402|\tsecond.BindingDigest = BindingDigest(second)\n403|\trecorded, err := store.Supersede(fixtureSession, fixtureOtherOp, second)\n404|\tif err != nil {\n405|\t\tt.Fatal(err)\n406|\t}\n407|\tpath := store.receiptPath(fixtureSession, fixtureOtherOp)\n408|\tinoBefore, _ := r3Inode(t, path)\n409|\tbytesBefore, _ := os.ReadFile(path)\n410|\tother := second\n411|\tother.TerminalInstanceID = r3Inst3\n412|\tother.BindingDigest = BindingDigest(other)\n413|\treplayed, err := store.Supersede(fixtureSession, fixtureOtherOp, other)\n414|\tif err != nil {\n415|\t\tt.Fatal(err)\n416|\t}\n417|\tinoAfter, _ := r3Inode(t, path)\n418|\tbytesAfter, _ := os.ReadFile(path)\n419|\tt.Logf(\"same-pair Supersede with different facts: replayed inst=%s recorded inst=%s inode %d->%d bytes-equal=%v\",\n420|\t\treplayed.TerminalInstanceID[9:13], recorded.TerminalInstanceID[9:13], inoBefore, inoAfter, string(bytesBefore) == string(bytesAfter))\n421|\tif replayed != recorded || inoBefore != inoAfter || string(bytesBefore) != string(bytesAfter) {\n422|\t\tt.Fatalf(\"FINDING: same-pair Supersede replaced the recorded receipt\")\n423|\t}\n424|}\n425|\n426|// R3-6: real SIGKILL at both Supersede seams through the genuine\n427|// production entry. Kill after stage: no receipt, anchor intact,\n428|// retry installs exactly one. Kill after install: the receipt is\n429|// complete and the retry replays it (same inode).\n430|func TestR3SupersedeRealKillSeams(t *testing.T) {\n431|\tif os.Getenv(\"AX_R3_SUPERSEDE_CHILD\") != \"\" {\n432|\t\tstore, err := Open(os.Getenv(\"AX_R3_SUPERSEDE_STORE\"))\n433|\t\tif err != nil {\n434|\t\t\tt.Fatal(err)\n435|\t\t}\n436|\t\tkill := func(string) error {\n437|\t\t\tproc, _ := os.FindProcess(os.Getpid())\n438|\t\t\t_ = proc.Signal(syscall.SIGKILL)\n439|\t\t\tselect {}\n440|\t\t}\n441|\t\thooks := &Hooks{}\n442|\t\tif os.Getenv(\"AX_R3_SUPERSEDE_CHILD\") == \"stage\" {\n443|\t\t\thooks.AfterStage = kill\n444|\t\t} else {\n445|\t\t\thooks.AfterInstall = kill\n446|\t\t}\n447|\t\tstore.WithHooks(hooks)\n448|\t\tsecond := bindCandidate()\n449|\t\tsecond.OperationID = fixtureOtherOp\n450|\t\tsecond.TerminalInstanceID = r3Inst2\n451|\t\tsecond.BindingDigest = BindingDigest(second)\n452|\t\t_, _ = store.Supersede(fixtureSession, fixtureOtherOp, second)\n453|\t\tt.Fatal(\"child returned past SIGKILL\")\n454|\t\treturn\n455|\t}\n456|\tfor _, seam := range []string{\"stage\", \"install\"} {\n457|\t\tt.Run(seam, func(t *testing.T) {\n458|\t\t\troot := t.TempDir()\n459|\t\t\tstore, err := Open(root)\n460|\t\t\tif err != nil {\n461|\t\t\t\tt.Fatal(err)\n462|\t\t\t}\n463|\t\t\tfirst, _, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate())\n464|\t\t\tif err != nil {\n465|\t\t\t\tt.Fatal(err)\n466|\t\t\t}\n467|\t\t\tctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)\n468|\t\t\tdefer cancel()\n469|\t\t\tchild := exec.CommandContext(ctx, os.Args[0], \"-test.run=^TestR3SupersedeRealKillSeams$\", \"-test.count=1\")\n470|\t\t\tchild.Env = append(os.Environ(), \"AX_R3_SUPERSEDE_CHILD=\"+seam, \"AX_R3_SUPERSEDE_STORE=\"+root)\n471|\t\t\trunErr := child.Run()\n472|\t\t\tvar exitErr *exec.ExitError\n473|\t\t\tif !errors.As(runErr, &exitErr) {\n474|\t\t\t\tt.Fatalf(\"child run = %v, want a signal exit\", runErr)\n475|\t\t\t}\n476|\t\t\tstatus, _ := exitErr.Sys().(syscall.WaitStatus)\n477|\t\t\tif !status.Signaled() || status.Signal() != syscall.SIGKILL {\n478|\t\t\t\tt.Fatalf(\"child status = %v, want SIGKILL\", exitErr)\n479|\t\t\t}\n480|\t\t\treopened, err := Open(root)\n481|\t\t\tif err != nil {\n482|\t\t\t\tt.Fatal(err)\n483|\t\t\t}\n484|\t\t\tgot, found, err := reopened.Lookup(fixtureSession, fixtureOtherOp)\n485|\t\t\tanchor, anchorFound, anchorErr := reopened.Status(fixtureSession)\n486|\t\t\tentries, _ := filepath.Glob(filepath.Join(reopened.sessionDir(fixtureSession), \"*\"))\n487|\t\t\treceipts, _ := filepath.Glob(filepath.Join(reopened.receiptsDir(fixtureSession), \"*\"))\n488|\t\t\tt.Logf(\"kill-after-%s: Lookup(op2)=(found %v, err %v) Status=(op %s, found %v, err %v) session=%d entries receipts=%v\",\n489|\t\t\t\tseam, found, err, anchor.OperationID[len(anchor.OperationID)-2:], anchorFound, anchorErr, len(entries), receipts)\n490|\t\t\tif anchorErr != nil || !anchorFound || anchor != first {\n491|\t\t\t\tt.Fatalf(\"anchor torn after kill-after-%s\", seam)\n492|\t\t\t}\n493|\t\t\tif seam == \"stage\" && (err != nil || found) {\n494|\t\t\t\tt.Fatalf(\"kill-after-stage left a pair receipt: found=%v err=%v\", found, err)\n495|\t\t\t}\n496|\t\t\tif seam == \"install\" && (err != nil || !found || got.TerminalInstanceID != r3Inst2) {\n497|\t\t\t\tt.Fatalf(\"kill-after-install lost the committed receipt: found=%v err=%v\", found, err)\n498|\t\t\t}\n499|\t\t\tsecond := bindCandidate()\n500|\t\t\tsecond.OperationID = fixtureOtherOp\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6e7","stream":{"kind":"session","id":"01a0b194-ebfd-7972-8291-a2a8c88f871f"},"sequence":462,"recorded_at":1780531400000919,"record_type":"event","durability":"durable","causation_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","run_stream":{"kind":"run","id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e"},"task_stream":{"kind":"task","id":"01a0b196-92aa-7ab1-8076-8ebff252d562"},"task_id":"01a0b196-92aa-7ab1-8076-8ebff252d562","event":{"kind":"completed","task_id":"01a0b196-92aa-7ab1-8076-8ebff252d562"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6e9","stream":{"kind":"session","id":"01a0b194-ebfd-7972-8291-a2a8c88f871f"},"sequence":463,"recorded_at":1780531400000921,"record_type":"event","durability":"durable","causation_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","run_stream":{"kind":"run","id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e"},"call_id":"call_01a0b196909770728b7b8457ed36f2ab","text":"Read text file `/tmp/rev3ev/probes/zz_review3_probe_test.go`.\n1|package axpane\n2|\n3|// Reviewer probes for CR-TASK-260830-1geqhj-3 (rev 3). These live only\n4|// in the isolated review copy. Each probe asserts the SPEC-expected\n5|// behavior so a RED probe is a finding, not a harness fault; probes\n6|// that only characterize a boundary log it and say so.\n7|//\n8|// R3 = rework verification of the rev2 findings (P1-1, P2-1, P2-2,\n9|// P3-x), each re-driven through a production entry with the rev3\n10|// fixtures (chain-published checkpoints); N3 = new plants one step\n11|// away from the reworked vectors.\n12|\n13|import (\n14|\t\"context\"\n15|\t\"encoding/json\"\n16|\t\"errors\"\n17|\t\"os\"\n18|\t\"os/exec\"\n19|\t\"path/filepath\"\n20|\t\"strings\"\n21|\t\"syscall\"\n22|\t\"testing\"\n23|\t\"time\"\n24|\n25|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n26|\t\"github.com/relux-works/agent-session-manager/internal/matjournal\"\n27|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n28|\t\"github.com/relux-works/agent-session-manager/internal/sessckpt\"\n29|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n30|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n31|)\n32|\n33|const (\n34|\tr3Successor = \"cccccccc-dddd-4eee-8fff-000000000001\"\n35|\tr3Op3       = \"0198f4c8-7d40-7e55-8e6f-1234567890ad\"\n36|\tr3Op4       = \"0198f4c8-7d40-7e55-8e6f-1234567890ae\"\n37|\tr3Inst2     = \"0198f4c9-2222-7bbb-8bbb-1234567890ab\"\n38|\tr3Inst3     = \"0198f4c9-3333-7ccc-8ccc-1234567890ab\"\n39|\tr3Inst4     = \"0198f4c9-4444-7ddd-8ddd-1234567890ab\"\n40|)\n41|\n42|// r3Capture captures a checkpoint of the fixture session under an\n43|// arbitrary owning (epoch, lease) tuple over the given heads.\n44|func r3Capture(t *testing.T, repository *sessrepo.Repository, store *sessckpt.Store, operation string, epoch uint64, leaseID string, heads []string) (string, []byte) {\n45|\tt.Helper()\n46|\treference, raw, err := store.Capture(repository, sessckpt.Inputs{\n47|\t\tOperationID:         operation,\n48|\t\tSessionID:           fixtureSession,\n49|\t\tSessionKind:         sessckpt.SessionKindDirect,\n50|\t\tLeaseEpoch:          epoch,\n51|\t\tLeaseID:             leaseID,\n52|\t\tCreatorHostID:       fixtureLocalHost,\n53|\t\tWorkspaceManifestID: seedDigest(0xE1),\n54|\t\tProviderManifestID:  seedDigest(0xE2),\n55|\t\tBoundary: sessckpt.SafeBoundary{\n56|\t\t\tProviderID: \"codex\", ProviderVersion: \"0.147.0\", Evidence: sessckpt.EvidenceAcceptedTest,\n57|\t\t\tInputBlocked: true, ForegroundIdle: true, BackgroundIdle: true, OpenProcesses: 0, OpenDatabaseHandles: 0,\n58|\t\t},\n59|\t\tEventHeads: heads,\n60|\t\tCreatedAt:  fixtureCreatedAt,\n61|\t\tExtensions: map[string]string{},\n62|\t})\n63|\tif err != nil {\n64|\t\tt.Fatalf(\"Capture(epoch %d) error = %v\", epoch, err)\n65|\t}\n66|\treturn reference.CheckpointID, raw\n67|}\n68|\n69|// r3PostTakeoverWorld builds the ordinary post-takeover story: the\n70|// epoch-1 owner stops with checkpoint C0 (published on the chain), a\n71|// LOCAL successor lease (2,S) is minted with handoff base C0, the\n72|// successor owner resumes from C0, goes idle, and stops with a NEW\n73|// checkpoint C1 published under (2,S). The lease record's checkpoint\n74|// stays C0 forever (immutable record); the chain fold's newest is C1.\n75|func r3PostTakeoverWorld(t *testing.T) (*runWorld, string, string) {\n76|\tt.Helper()\n77|\tworld := buildRunWorld(t)\n78|\tc0 := world.ckptID\n79|\tworld.headID = publishCheckpoint(t, world.repo, world.headID, 2, c0)\n80|\tsuccessorLease(t, world.repo, r3Successor, fixtureLocalHost, c0)\n81|\tresumedID := appendChainEvent(t, world.repo, \"session.resumed\", 2, r3Successor, 1, world.headID, map[string]any{\n82|\t\t\"checkpoint_id\": c0, \"execution_profile\": \"standard\", \"profile_source_event_id\": nil,\n83|\t\t\"terminal_backend\": \"tmux\", \"native_session_id\": \"native-session-alpha\",\n84|\t})\n85|\tidleID := appendChainEvent(t, world.repo, \"session.idle\", 2, r3Successor, 2, resumedID, map[string]any{\n86|\t\t\"boundary_ref\": \"turn-2\", \"foreground_idle\": true, \"background_idle\": true,\n87|\t})\n88|\tc1, _ := r3Capture(t, world.repo, world.ckpt, r3Op3, 2, r3Successor, []string{idleID})\n89|\tworld.headID = appendChainEvent(t, world.repo, \"session.stopped\", 2, r3Successor, 3, idleID, map[string]any{\n90|\t\t\"graceful\": true, \"checkpoint_id\": c1, \"resumable\": true, \"closure_kind\": \"checkpointed\", \"process_closed\": true, \"store_closed\": true,\n91|\t})\n92|\treturn world, c0, c1\n93|}\n94|\n95|func r3RestoreRequest(t *testing.T, world *runWorld, op, instance string, epoch uint64, lease, ckpt string) Request {\n96|\tt.Helper()\n97|\trequest := runRequest(t, world)\n98|\trequest.Mode = ModeRestore\n99|\trequest.BootstrapOperationID = op\n100|\trequest.InstanceID = instance\n101|\trequest.Presented = fencing.PresentedToken{SessionID: fixtureSession, Epoch: epoch, LeaseID: lease}\n102|\trequest.MaterializationRequired = true\n103|\trequest.MaterializationID = fixtureMat\n104|\trequest.CheckpointRequired = true\n105|\trequest.CheckpointID = ckpt\n106|\treturn request\n107|}\n108|\n109|// ---------------------------------------------------------------\n110|// P1-1 rework verification (window / admission / journal keyed on\n111|// the chain fold, epoch-1 owner)\n112|// ---------------------------------------------------------------\n113|\n114|// R3-1: the ordinary same-host story restores with a new bootstrap\n115|// operation through Run, and an identical retry of that operation\n116|// reattaches to the one child.\n117|func TestR3EpochOneOwnerRestoreLaunchesAndRetryReattaches(t *testing.T) {\n118|\tworld := buildRunWorld(t)\n119|\tfirst, err := Run(world.stores(), runRequest(t, world))\n120|\tif err != nil || first.Decision.Action != ActionLaunch {\n121|\t\tt.Fatalf(\"first launch = (%v, %v)\", first.Decision.Action, err)\n122|\t}\n123|\tworld.headID = publishCheckpoint(t, world.repo, world.headID, 2, world.ckptID)\n124|\tobservation, err := ObserveOwnership(world.repo, fixtureSession, runObserve(fixtureNow()))\n125|\tif err != nil {\n126|\t\tt.Fatal(err)\n127|\t}\n128|\thas, newest, err := LoadNewestCheckpoint(world.repo, fixtureSession)\n129|\tif err != nil {\n130|\t\tt.Fatal(err)\n131|\t}\n132|\tt.Logf(\"lease: epoch=%d HasCheckpoint=%v | fold: has=%v newest=%s\", observation.Winner.Epoch, observation.Winner.HasCheckpoint, has, newest[:20])\n133|\tif observation.Winner.HasCheckpoint || !has || newest != world.ckptID {\n134|\t\tt.Fatalf(\"fixture does not reproduce the epoch-1 null-lease-checkpoint state\")\n135|\t}\n136|\tworld.mat = journalSourced(t, world.ckptID)\n137|\trestore := r3RestoreRequest(t, world, fixtureOtherOp, r3Inst2, 1, fixtureLeaseA, world.ckptID)\n138|\toutcome, err := Run(world.stores(), restore)\n139|\tif err != nil {\n140|\t\tt.Fatalf(\"Run() error = %v\", err)\n141|\t}\n142|\tt.Logf(\"epoch-1 owner post-checkpoint restore, new op: action=%s class=%q cause=%v\", outcome.Decision.Action, outcome.Decision.Class, outcome.Decision.Cause)\n143|\tif outcome.Decision.Action != ActionLaunch || outcome.Binding == nil || outcome.Binding.OperationID != fixtureOtherOp {\n144|\t\tt.Fatalf(\"FINDING: epoch-1 owner restore with a new operation did not launch with the op2 receipt: %+v\", outcome.Binding)\n145|\t}\n146|\tretry := r3RestoreRequest(t, world, fixtureOtherOp, r3Inst4, 1, fixtureLeaseA, world.ckptID)\n147|\tagain, err := Run(world.stores(), retry)\n148|\tif err != nil {\n149|\t\tt.Fatalf(\"Run() retry error = %v\", err)\n150|\t}\n151|\tt.Logf(\"identical retry of op2 with different child facts: action=%s instance=%s\", again.Decision.Action, again.Binding.TerminalInstanceID)\n152|\tif again.Decision.Action != ActionReattach || again.Binding.TerminalInstanceID != outcome.Binding.TerminalInstanceID {\n153|\t\tt.Fatalf(\"FINDING: identical retry did not reattach to the one child\")\n154|\t}\n155|}\n156|\n157|// R3-2: with the chain newest at C, a second attested checkpoint C2\n158|// the chain never published parks at the \"not newest\" arm through\n159|// Run, and no binding installs.\n160|func TestR3UnpublishedCheckpointParksAtNewestArm(t *testing.T) {\n161|\tworld := buildRunWorld(t)\n162|\tworld.headID = publishCheckpoint(t, world.repo, world.headID, 2, world.ckptID)\n163|\tc2, _ := captureUnpublished(t, world.repo, world.ckpt, r3Op3, []string{world.headID})\n164|\tworld.mat = journalSourced(t, world.ckptID)\n165|\trequest := r3RestoreRequest(t, world, fixtureOtherOp, r3Inst2, 1, fixtureLeaseA, c2)\n166|\toutcome, err := Run(world.stores(), request)\n167|\tif err != nil {\n168|\t\tt.Fatalf(\"Run() error = %v\", err)\n169|\t}\n170|\tt.Logf(\"chain newest=C, caller C2 unpublished: action=%s reason=%s cause=%v\", outcome.Decision.Action, outcome.Decision.ParkReason, outcome.Decision.Cause)\n171|\tif outcome.Decision.Action != ActionParked || outcome.Decision.ParkReason != fencing.ParkRestorePolicy {\n172|\t\tt.Fatalf(\"FINDING: unpublished checkpoint did not park\")\n173|\t}\n174|\tif outcome.Decision.Cause == nil || !strings.Contains(outcome.Decision.Cause.Error(), \"not the newest published checkpoint\") {\n175|\t\tt.Fatalf(\"FINDING: parked at the wrong arm: %v\", outcome.Decision.Cause)\n176|\t}\n177|\tif _, found, err := world.pane.Lookup(fixtureSession, fixtureOtherOp); err != nil || found {\n178|\t\tt.Fatalf(\"binding installed for a parked restore: found=%v err=%v\", found, err)\n179|\t}\n180|}\n181|\n182|// R3-3: a committed journal sourced from a digest no lease and no\n183|// event names parks at the stale-source arm through Run.\n184|func TestR3UnnamedSourceJournalParks(t *testing.T) {\n185|\tworld := buildRunWorld(t)\n186|\tworld.headID = publishCheckpoint(t, world.repo, world.headID, 2, world.ckptID)\n187|\tworld.mat = journalSourced(t, seedDigest(0xD2))\n188|\trequest := r3RestoreRequest(t, world, fixtureOtherOp, r3Inst2, 1, fixtureLeaseA, world.ckptID)\n189|\toutcome, err := Run(world.stores(), request)\n190|\tif err != nil {\n191|\t\tt.Fatalf(\"Run() error = %v\", err)\n192|\t}\n193|\tt.Logf(\"journal sourced from 0xD2, chain newest=C: action=%s cause=%v\", outcome.Decision.Action, outcome.Decision.Cause)\n194|\tif outcome.Decision.Action != ActionParked || outcome.Decision.Cause == nil || !strings.Contains(outcome.Decision.Cause.Error(), \"superseded checkpoint\") {\n195|\t\tt.Fatalf(\"FINDING: unnamed-source journal did not park at the stale-source arm\")\n196|\t}\n197|}\n198|\n199|// N3-1 (one step past P1-1): the ordinary POST-TAKEOVER story. The\n200|// successor lease's checkpoint is the handoff base C0 (immutable\n201|// lease record); the successor owner then publishes C1. A restore\n202|// on that owner with a journal sourced from C1 and checkpoint C1 is\n203|// the after-restore step-3 positive: winning lease + valid required\n204|// materialization. §5.3 fixes the lease checkpoint at the handoff\n205|// base; §5.7/§13.11 step 5 validate the NEWEST checkpoint. The spec\n206|// expects launch.\n207|func TestN3PostTakeoverLifecycleRestoreLaunches(t *testing.T) {\n208|\tworld, c0, c1 := r3PostTakeoverWorld(t)\n209|\tobservation, err := ObserveOwnership(world.repo, fixtureSession, runObserve(fixtureNow()))\n210|\tif err != nil {\n211|\t\tt.Fatal(err)\n212|\t}\n213|\thas, newest, err := LoadNewestCheckpoint(world.repo, fixtureSession)\n214|\tif err != nil {\n215|\t\tt.Fatalf(\"LoadNewestCheckpoint() error = %v (the post-takeover chain must fold)\", err)\n216|\t}\n217|\tt.Logf(\"winner: epoch=%d lease=%s HasCheckpoint=%v Checkpoint=%s | fold newest: has=%v %s | C0=%s C1=%s\",\n218|\t\tobservation.Winner.Epoch, observation.Winner.LeaseID[:8], observation.Winner.HasCheckpoint, observation.Winner.Checkpoint[:20], has, newest[:20], c0[:20], c1[:20])\n219|\tif observation.Winner.Epoch != 2 || observation.Winner.Checkpoint != c0 || newest != c1 {\n220|\t\tt.Fatalf(\"fixture does not reproduce the post-takeover state\")\n221|\t}\n222|\tworld.mat = journalSourced(t, c1)\n223|\trequest := r3RestoreRequest(t, world, fixtureOtherOp, r3Inst2, 2, r3Successor, c1)\n224|\toutcome, err := Run(world.stores(), request)\n225|\tif err != nil {\n226|\t\tt.Fatalf(\"Run() error = %v\", err)\n227|\t}\n228|\tt.Logf(\"post-takeover restore (journal from C1, checkpoint C1, presented (2,S)): action=%s reason=%s cause=%v\",\n229|\t\toutcome.Decision.Action, outcome.Decision.ParkReason, outcome.Decision.Cause)\n230|\tif outcome.Decision.Action != ActionLaunch {\n231|\t\tt.Fatalf(\"FINDING: the successor owner cannot restore after publishing its own checkpoint: action=%s cause=%v\", outcome.Decision.Action, outcome.Decision.Cause)\n232|\t}\n233|}\n234|\n235|// N3-1b: the same through the pure core, with the Decide input built\n236|// exactly as Run would build it.\n237|func TestN3PostTakeoverLifecycleDecide(t *testing.T) {\n238|\tdeps := buildDecideDeps(t, true)\n239|\tinput := validInput(t, deps)\n240|\tinput.Mode = ModeRestore\n241|\tinput.Presented = fencing.PresentedToken{SessionID: fixtureSession, Epoch: 2, LeaseID: r3Successor}\n242|\tinput.Observation.Winner.Epoch = 2\n243|\tinput.Observation.Winner.LeaseID = r3Successor\n244|\tinput.Observation.Winner.HasCheckpoint = true\n245|\tinput.Observation.Winner.Checkpoint = seedDigest(0xC0) // handoff base C0\n246|\tinput.Observation.Grant.Token = sessrepo.FencingToken{Epoch: 2, LeaseID: r3Successor, HolderHostID: fixtureLocalHost}\n247|\tinput.HasNewestCheckpoint = true\n248|\tinput.NewestCheckpointID = deps.ckptID // C1 published by the successor\n249|\tinput.MaterializationRequired = true\n250|\tinput.JournalOK = true\n251|\tinput.Journal = matjournal.Journal{Phase: matjournal.PhaseCommitted, SourceCheckpointID: deps.ckptID, MaterializationID: fixtureMat}\n252|\tinput.CheckpointRequired = true\n253|\tinput.CheckpointDoc = deps.ckptDoc\n254|\tinput.CheckpointID = deps.ckptID\n255|\tdecision := Decide(input)\n256|\tt.Logf(\"Decide post-takeover (lease base C0 != fold newest C1): action=%s reason=%s cause=%v\", decision.Action, decision.ParkReason, decision.Cause)\n257|\tif decision.Action != ActionLaunch {\n258|\t\tt.Fatalf(\"FINDING: Decide parks the successor owner after it published a newer checkpoint: %v\", decision.Cause)\n259|\t}\n260|}\n261|\n262|// N3-2: in the post-takeover world, a caller that names the handoff\n263|// base C0 (stale) instead of the newest C1 parks at the newest arm.\n264|func TestN3PostTakeoverStaleBaseParks(t *testing.T) {\n265|\tworld, c0, _ := r3PostTakeoverWorld(t)\n266|\tworld.mat = journalSourced(t, c0)\n267|\trequest := r3RestoreRequest(t, world, fixtureOtherOp, r3Inst2, 2, r3Successor, c0)\n268|\toutcome, err := Run(world.stores(), request)\n269|\tif err != nil {\n270|\t\tt.Fatalf(\"Run() error = %v\", err)\n271|\t}\n272|\tt.Logf(\"post-takeover restore naming the stale base C0: action=%s cause=%v\", outcome.Decision.Action, outcome.Decision.Cause)\n273|\tif outcome.Decision.Action != ActionParked {\n274|\t\tt.Fatalf(\"FINDING: the stale handoff base was admitted for resume\")\n275|\t}\n276|}\n277|\n278|// N3-3: launch mode with a successor lease carrying a checkpoint the\n279|// chain never published: the lease/fold agreement is consulted only\n280|// on the required-materialization/checkpoint arms. This probe\n281|// characterizes the boundary (logs it) and asserts only that no\n282|// unpublished checkpoint is admitted as a REQUIRED checkpoint.\n283|func TestN3LaunchModeLeaseFoldDisagreementCharacterized(t *testing.T) {\n284|\tworld := buildRunWorld(t)\n285|\tif _, err := Run(world.stores(), runRequest(t, world)); err != nil {\n286|\t\tt.Fatal(err)\n287|\t}\n288|\tsuccessorLease(t, world.repo, r3Successor, fixtureLocalHost, world.ckptID)\n289|\thas, _, err := LoadNewestCheckpoint(world.repo, fixtureSession)\n290|\tif err != nil {\n291|\t\tt.Fatal(err)\n292|\t}\n293|\trequest := runRequest(t, world)\n294|\trequest.Mode = ModeLaunch\n295|\trequest.BootstrapOperationID = fixtureOtherOp\n296|\trequest.InstanceID = r3Inst2\n297|\trequest.Presented = fencing.PresentedToken{SessionID: fixtureSession, Epoch: 2, LeaseID: r3Successor}\n298|\toutcome, err := Run(world.stores(), request)\n299|\tt.Logf(\"launch mode, successor lease carries unpublished C, fold has=%v: action=%s class=%q err=%v\", has, outcome.Decision.Action, outcome.Decision.Class, err)\n300|\tif err == nil && outcome.Decision.Action == ActionLaunch {\n301|\t\tt.Fatalf(\"FINDING-CANDIDATE: launch-mode changed op with an inconsistent lease/fold pair launched with binding %+v\", outcome.Binding)\n302|\t}\n303|\trequired := request\n304|\trequired.CheckpointRequired = true\n305|\trequired.CheckpointID = world.ckptID\n306|\toutcome, err = Run(world.stores(), required)\n307|\tif err != nil {\n308|\t\tt.Fatalf(\"Run() error = %v\", err)\n309|\t}\n310|\tt.Logf(\"same with the unpublished checkpoint REQUIRED: action=%s cause=%v\", outcome.Decision.Action, outcome.Decision.Cause)\n311|\tif outcome.Decision.Action == ActionLaunch {\n312|\t\tt.Fatalf(\"FINDING: an unpublished checkpoint was admitted as a required checkpoint\")\n313|\t}\n314|}\n315|\n316|// ---------------------------------------------------------------\n317|// P2-1 rework verification (per-pair receipts survive supersession)\n318|// ---------------------------------------------------------------\n319|\n320|func r3Inode(t *testing.T, path string) (uint64, time.Time) {\n321|\tt.Helper()\n322|\tinfo, err := os.Stat(path)\n323|\tif err != nil {\n324|\t\tt.Fatalf(\"stat %s: %v\", path, err)\n325|\t}\n326|\tstat, ok := info.Sys().(*syscall.Stat_t)\n327|\tif !ok {\n328|\t\tt.Fatal(\"no inode on this platform\")\n329|\t}\n330|\treturn stat.Ino, info.ModTime()\n331|}\n332|\n333|// R3-4: post-window op2 and op3 each launch their own child; an\n334|// identical retry of op2 (different child facts) reattaches to op2's\n335|// own child without rewriting its receipt; Status keeps the first\n336|// anchor; every pair replays through Lookup.\n337|func TestR3SupersededPairIdenticalRetryReattaches(t *testing.T) {\n338|\tworld := buildRunWorld(t)\n339|\tfirst, err := Run(world.stores(), runRequest(t, world))\n340|\tif err != nil || first.Decision.Action != ActionLaunch {\n341|\t\tt.Fatalf(\"first launch = (%v, %v)\", first.Decision.Action, err)\n342|\t}\n343|\tworld.headID = publishCheckpoint(t, world.repo, world.headID, 2, world.ckptID)\n344|\tworld.mat = journalSourced(t, world.ckptID)\n345|\trun := func(op, instance string) Outcome {\n346|\t\toutcome, err := Run(world.stores(), r3RestoreRequest(t, world, op, instance, 1, fixtureLeaseA, world.ckptID))\n347|\t\tif err != nil {\n348|\t\t\tt.Fatalf(\"Run(%s) error = %v\", op[len(op)-2:], err)\n349|\t\t}\n350|\t\treturn outcome\n351|\t}\n352|\tsecond := run(fixtureOtherOp, r3Inst2)\n353|\tthird := run(r3Op3, r3Inst3)\n354|\tt.Logf(\"op2: action=%s inst=%s | op3: action=%s inst=%s\", second.Decision.Action, second.Binding.TerminalInstanceID[9:13], third.Decision.Action, third.Binding.TerminalInstanceID[9:13])\n355|\tif second.Decision.Action != ActionLaunch || third.Decision.Action != ActionLaunch {\n356|\t\tt.Fatalf(\"post-window launches did not both launch\")\n357|\t}\n358|\treceipt := world.pane.receiptPath(fixtureSession, fixtureOtherOp)\n359|\tinoBefore, mtimeBefore := r3Inode(t, receipt)\n360|\tretry := run(fixtureOtherOp, r3Inst4)\n361|\tinoAfter, mtimeAfter := r3Inode(t, receipt)\n362|\tt.Logf(\"identical retry of op2 after op3: action=%s inst=%s receipt inode %d->%d mtime-equal=%v\",\n363|\t\tretry.Decision.Action, retry.Binding.TerminalInstanceID[9:13], inoBefore, inoAfter, mtimeBefore.Equal(mtimeAfter))\n364|\tif retry.Decision.Action != ActionReattach || retry.Binding.TerminalInstanceID != second.Binding.TerminalInstanceID {\n365|\t\tt.Fatalf(\"FINDING: identical retry of a superseded pair launched a third child\")\n366|\t}\n367|\tif inoBefore != inoAfter || !mtimeBefore.Equal(mtimeAfter) {\n368|\t\tt.Fatalf(\"FINDING: identical retry rewrote the pair receipt\")\n369|\t}\n370|\tanchor, found, err := world.pane.Status(fixtureSession)\n371|\tif err != nil || !found || anchor.OperationID != fixtureBootstrap {\n372|\t\tt.Fatalf(\"Status() = (%+v, %v, %v), want the first anchor\", anchor, found, err)\n373|\t}\n374|\tfor _, want := range []*Binding{first.Binding, second.Binding, third.Binding} {\n375|\t\tgot, found, err := world.pane.Lookup(fixtureSession, want.OperationID)\n376|\t\tif err != nil || !found || got != *want {\n377|\t\t\tt.Fatalf(\"Lookup(%s) = (%+v, %v, %v), want %+v\", want.OperationID[len(want.OperationID)-2:], got, found, err, *want)\n378|\t\t}\n379|\t}\n380|\tentries, _ := os.ReadDir(world.pane.receiptsDir(fixtureSession))\n381|\tnames := make([]string, 0, len(entries))\n382|\tfor _, entry := range entries {\n383|\t\tnames = append(names, entry.Name())\n384|\t}\n385|\tt.Logf(\"receipts dir: %v\", names)\n386|\tif len(entries) != 3 {\n387|\t\tt.Fatalf(\"receipts = %d, want exactly 3\", len(entries))\n388|\t}\n389|}\n390|\n391|// R3-5: Supersede is no-replace per pair: a same-pair Supersede with\n392|// different child facts replays the recorded receipt (same inode,\n393|// same bytes) instead of replacing it.\n394|func TestR3SupersedeSamePairNoReplace(t *testing.T) {\n395|\tstore := openPaneStore(t)\n396|\tif _, _, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate()); err != nil {\n397|\t\tt.Fatal(err)\n398|\t}\n399|\tsecond := bindCandidate()\n400|\tsecond.OperationID = fixtureOtherOp\n401|\tsecond.TerminalInstanceID = r3Inst2\n402|\tsecond.BindingDigest = BindingDigest(second)\n403|\trecorded, err := store.Supersede(fixtureSession, fixtureOtherOp, second)\n404|\tif err != nil {\n405|\t\tt.Fatal(err)\n406|\t}\n407|\tpath := store.receiptPath(fixtureSession, fixtureOtherOp)\n408|\tinoBefore, _ := r3Inode(t, path)\n409|\tbytesBefore, _ := os.ReadFile(path)\n410|\tother := second\n411|\tother.TerminalInstanceID = r3Inst3\n412|\tother.BindingDigest = BindingDigest(other)\n413|\treplayed, err := store.Supersede(fixtureSession, fixtureOtherOp, other)\n414|\tif err != nil {\n415|\t\tt.Fatal(err)\n416|\t}\n417|\tinoAfter, _ := r3Inode(t, path)\n418|\tbytesAfter, _ := os.ReadFile(path)\n419|\tt.Logf(\"same-pair Supersede with different facts: replayed inst=%s recorded inst=%s inode %d->%d bytes-equal=%v\",\n420|\t\treplayed.TerminalInstanceID[9:13], recorded.TerminalInstanceID[9:13], inoBefore, inoAfter, string(bytesBefore) == string(bytesAfter))\n421|\tif replayed != recorded || inoBefore != inoAfter || string(bytesBefore) != string(bytesAfter) {\n422|\t\tt.Fatalf(\"FINDING: same-pair Supersede replaced the recorded receipt\")\n423|\t}\n424|}\n425|\n426|// R3-6: real SIGKILL at both Supersede seams through the genuine\n427|// production entry. Kill after stage: no receipt, anchor intact,\n428|// retry installs exactly one. Kill after install: the receipt is\n429|// complete and the retry replays it (same inode).\n430|func TestR3SupersedeRealKillSeams(t *testing.T) {\n431|\tif os.Getenv(\"AX_R3_SUPERSEDE_CHILD\") != \"\" {\n432|\t\tstore, err := Open(os.Getenv(\"AX_R3_SUPERSEDE_STORE\"))\n433|\t\tif err != nil {\n434|\t\t\tt.Fatal(err)\n435|\t\t}\n436|\t\tkill := func(string) error {\n437|\t\t\tproc, _ := os.FindProcess(os.Getpid())\n438|\t\t\t_ = proc.Signal(syscall.SIGKILL)\n439|\t\t\tselect {}\n440|\t\t}\n441|\t\thooks := &Hooks{}\n442|\t\tif os.Getenv(\"AX_R3_SUPERSEDE_CHILD\") == \"stage\" {\n443|\t\t\thooks.AfterStage = kill\n444|\t\t} else {\n445|\t\t\thooks.AfterInstall = kill\n446|\t\t}\n447|\t\tstore.WithHooks(hooks)\n448|\t\tsecond := bindCandidate()\n449|\t\tsecond.OperationID = fixtureOtherOp\n450|\t\tsecond.TerminalInstanceID = r3Inst2\n451|\t\tsecond.BindingDigest = BindingDigest(second)\n452|\t\t_, _ = store.Supersede(fixtureSession, fixtureOtherOp, second)\n453|\t\tt.Fatal(\"child returned past SIGKILL\")\n454|\t\treturn\n455|\t}\n456|\tfor _, seam := range []string{\"stage\", \"install\"} {\n457|\t\tt.Run(seam, func(t *testing.T) {\n458|\t\t\troot := t.TempDir()\n459|\t\t\tstore, err := Open(root)\n460|\t\t\tif err != nil {\n461|\t\t\t\tt.Fatal(err)\n462|\t\t\t}\n463|\t\t\tfirst, _, err := store.Bind(fixtureSession, fixtureBootstrap, bindCandidate())\n464|\t\t\tif err != nil {\n465|\t\t\t\tt.Fatal(err)\n466|\t\t\t}\n467|\t\t\tctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)\n468|\t\t\tdefer cancel()\n469|\t\t\tchild := exec.CommandContext(ctx, os.Args[0], \"-test.run=^TestR3SupersedeRealKillSeams$\", \"-test.count=1\")\n470|\t\t\tchild.Env = append(os.Environ(), \"AX_R3_SUPERSEDE_CHILD=\"+seam, \"AX_R3_SUPERSEDE_STORE=\"+root)\n471|\t\t\trunErr := child.Run()\n472|\t\t\tvar exitErr *exec.ExitError\n473|\t\t\tif !errors.As(runErr, &exitErr) {\n474|\t\t\t\tt.Fatalf(\"child run = %v, want a signal exit\", runErr)\n475|\t\t\t}\n476|\t\t\tstatus, _ := exitErr.Sys().(syscall.WaitStatus)\n477|\t\t\tif !status.Signaled() || status.Signal() != syscall.SIGKILL {\n478|\t\t\t\tt.Fatalf(\"child status = %v, want SIGKILL\", exitErr)\n479|\t\t\t}\n480|\t\t\treopened, err := Open(root)\n481|\t\t\tif err != nil {\n482|\t\t\t\tt.Fatal(err)\n483|\t\t\t}\n484|\t\t\tgot, found, err := reopened.Lookup(fixtureSession, fixtureOtherOp)\n485|\t\t\tanchor, anchorFound, anchorErr := reopened.Status(fixtureSession)\n486|\t\t\tentries, _ := filepath.Glob(filepath.Join(reopened.sessionDir(fixtureSession), \"*\"))\n487|\t\t\treceipts, _ := filepath.Glob(filepath.Join(reopened.receiptsDir(fixtureSession), \"*\"))\n488|\t\t\tt.Logf(\"kill-after-%s: Lookup(op2)=(found %v, err %v) Status=(op %s, found %v, err %v) session=%d entries receipts=%v\",\n489|\t\t\t\tseam, found, err, anchor.OperationID[len(anchor.OperationID)-2:], anchorFound, anchorErr, len(entries), receipts)\n490|\t\t\tif anchorErr != nil || !anchorFound || anchor != first {\n491|\t\t\t\tt.Fatalf(\"anchor torn after kill-after-%s\", seam)\n492|\t\t\t}\n493|\t\t\tif seam == \"stage\" && (err != nil || found) {\n494|\t\t\t\tt.Fatalf(\"kill-after-stage left a pair receipt: found=%v err=%v\", found, err)\n495|\t\t\t}\n496|\t\t\tif seam == \"install\" && (err != nil || !found || got.TerminalInstanceID != r3Inst2) {\n497|\t\t\t\tt.Fatalf(\"kill-after-install lost the committed receipt: found=%v err=%v\", found, err)\n498|\t\t\t}\n499|\t\t\tsecond := bindCandidate()\n500|\t\t\tsecond.OperationID = fixtureOtherOp\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
