\n40|        note=\"P3-1 re-run: mutation gate narrowed so a presented epoch below the winner's appends (survived twice in rev2).\",\n41|    ),\n42|    Mutant(\n43|        name=\"RV11-supersede-restore-only-in-run\",\n44|        path=f\"{PACKAGE}/run.go\",\n45|        find=\"\\t\\tif input.SessionBound {\\n\\t\\t\\tbound, err := paneStore.Supersede(\",\n46|        replace=\"\\t\\tif input.SessionBound && input.Mode == ModeRestore {\\n\\t\\t\\tbound, err := paneStore.Supersede(\",\n47|        expect=\"KILLED\",\n48|        note=\"P3-2 re-run: Run's post-window pair install narrowed to restore mode (launch-mode create-from-stopped falls to Bind).\",\n49|    ),\n50|    Mutant(\n51|        name=\"RV3-1-agreement-result-ignored\",\n52|        path=f\"{PACKAGE}/decide.go\",\n53|        find=\"\\tif !leaseCheckpointAgrees(input) {\\n\\t\\treturn nil, errCheckpointLeaseDisagree()\\n\\t}\\n\",\n54|        replace=\"\\t_ = leaseCheckpointAgrees(input)\\n\",\n55|        expect=\"KILLED\",\n56|        note=\"Gate result ignored: the lease/fold agreement runs on the checkpoint arm but its verdict is dropped.\",\n57|    ),\n58|    Mutant(\n59|        name=\"RV3-2-steps-3-4-swapped\",\n60|        path=f\"{PACKAGE}/decide.go\",\n61|        find=(\n62|            \"\\ttoken, err := authorize(input)\\n\"\n63|            \"\\tif err != nil {\\n\"\n64|            \"\\t\\tif fencing.IsParked(err) {\\n\"\n65|            \"\\t\\t\\treason, winning, _ := fencing.ParkDetails(err)\\n\"\n66|            \"\\t\\t\\treturn decideParked(input, admitted, reason, winning, err)\\n\"\n67|            \"\\t\\t}\\n\"\n68|            \"\\t\\treturn refused(fencingClass(err), \\\"fencing refused the wrapper\\\", err)\\n\"\n69|            \"\\t}\\n\"\n70|            \"\\n\"\n71|            \"\\tif input.MaterializationRequired {\\n\"\n72|            \"\\t\\tif err := checkMaterialization(input); err != nil {\\n\"\n73|            \"\\t\\t\\treturn parked(fencing.ParkRestorePolicy, input.Observation.Winner.LeaseID, err)\\n\"\n74|            \"\\t\\t}\\n\"\n75|            \"\\t}\\n\"\n76|        ),\n77|        replace=(\n78|            \"\\tif input.MaterializationRequired {\\n\"\n79|            \"\\t\\tif err := checkMaterialization(input); err != nil {\\n\"\n80|            \"\\t\\t\\treturn parked(fencing.ParkRestorePolicy, input.Observation.Winner.LeaseID, err)\\n\"\n81|            \"\\t\\t}\\n\"\n82|            \"\\t}\\n\"\n83|            \"\\ttoken, err := authorize(input)\\n\"\n84|            \"\\tif err != nil {\\n\"\n85|            \"\\t\\tif fencing.IsParked(err) {\\n\"\n86|            \"\\t\\t\\treason, winning, _ := fencing.ParkDetails(err)\\n\"\n87|            \"\\t\\t\\treturn decideParked(input, admitted, reason, winning, err)\\n\"\n88|            \"\\t\\t}\\n\"\n89|            \"\\t\\treturn refused(fencingClass(err), \\\"fencing refused the wrapper\\\", err)\\n\"\n90|            \"\\t}\\n\"\n91|            \"\\n\"\n92|        ),\n93|        expect=\"KILLED\",\n94|        note=\"After-restore order: materialization arm moved before the fencing authorize arm (steps 3/4 swapped).\",\n95|    ),\n96|    Mutant(\n97|        name=\"RV3-3-park-reason-collapsed\",\n98|        path=f\"{PACKAGE}/decide.go\",\n99|        find=\"func parked(reason fencing.ParkReason, winningLeaseID string, cause error) Decision {\\n\\treturn Decision{\\n\",\n100|        replace=\"func parked(reason fencing.ParkReason, winningLeaseID string, cause error) Decision {\\n\\treason = fencing.ParkRestorePolicy\\n\\treturn Decision{\\n\",\n101|        expect=\"KILLED\",\n102|        note=\"Park reason vocabulary collapsed to restore_policy for every park.\",\n103|    ),\n104|    Mutant(\n105|        name=\"RV3-4-window-check-dropped\",\n106|        path=f\"{PACKAGE}/decide.go\",\n107|        find=\"\\treturn input.HasNewestCheckpoint\\n}\\n\",\n108|        replace=\"\\treturn true\\n}\\n\",\n109|        expect=\"KILLED\",\n110|        note=\"Bootstrap window predicate dropped: every session reads as post-window (delete-class, requested by the brief).\",\n111|    ),\n112|    Mutant(\n113|        name=\"RV3-4b-window-closes-on-lease-checkpoint\",\n114|        path=f\"{PACKAGE}/decide.go\",\n115|        find=\"\\treturn input.HasNewestCheckpoint\\n}\\n\",\n116|        replace=\"\\treturn input.HasNewestCheckpoint || (input.Observation.HasWinner && input.Observation.Winner.HasCheckpoint)\\n}\\n\",\n117|        expect=\"KILLED\",\n118|        note=\"Widening: the window also closes on the LEASE record's checkpoint while the fold names none (the rev2 keying regrown as an OR).\",\n119|    ),\n120|    Mutant(\n121|        name=\"RV3-5-realm-foreground-conditional-dropped\",\n122|        path=f\"{PACKAGE}/decide.go\",\n123|        find=\"\\tif input.Realm.Caller != CallerBackground && !input.Smoke.Required {\\n\\t\\treturn nil\\n\\t}\\n\\tif !admitted.Has(credentialRealmCapability) {\\n\",\n124|        replace=\"\\tif input.Realm.Caller != CallerBackground {\\n\\t\\treturn nil\\n\\t}\\n\\tif !admitted.Has(credentialRealmCapability) {\\n\",\n125|        expect=\"KILLED\",\n126|        note=\"P3-4: the credential conditional narrowed back to background callers only.\",\n127|    ),\n128|    Mutant(\n129|        name=\"RV3-6-dead-realm-mapping-dropped\",\n130|        path=f\"{PACKAGE}/decide.go\",\n131|        find=\"\\t\\tif realmErr := deadRealmRefusal(input, evidence, err); realmErr != nil {\\n\\t\\t\\treturn terminalbackend.Admitted{}, nil, realmErr\\n\\t\\t}\\n\",\n132|        replace=\"\\t\\t_ = deadRealmRefusal(input, evidence, err)\\n\",\n133|        expect=\"KILLED\",\n134|        note=\"P3-6: the typed dead-realm refusal mapping result ignored (backend class surfaces).\",\n135|    ),\n136|    Mutant(\n137|        name=\"RV3-7-ckpt-store-guard-restore-only\",\n138|        path=f\"{PACKAGE}/run.go\",\n139|        find=\"\\tif known && observation.HasWinner && observation.Winner.HasCheckpoint && stores.Ckpt == nil {\\n\",\n140|        replace=\"\\tif known && observation.HasWinner && observation.Winner.HasCheckpoint && stores.Ckpt == nil && request.Mode == ModeRestore {\\n\",\n141|        expect=\"KILLED\",\n142|        note=\"P2-2: the unknown-store guard narrowed to restore mode (launch mode falls back to the head).\",\n143|    ),\n144|    Mutant(\n145|        name=\"RV3-8-supersede-replace-over\",\n146|        path=f\"{PACKAGE}/binding.go\",\n147|        find=\"\\tif err := os.Link(stagedPath, target); err != nil {\\n\\t\\tif errors.Is(err, os.ErrExist) {\\n\\t\\t\\t// A concurrent wrapper recorded this pair\\n\",\n148|        replace=\"\\tif err := os.Rename(stagedPath, target); err != nil {\\n\\t\\tif errors.Is(err, os.ErrExist) {\\n\\t\\t\\t// A concurrent wrapper recorded this pair\\n\",\n149|        expect=\"KILLED\",\n150|        note=\"P2-1: the pair-receipt commit becomes a replace-over rename (no-replace guard lost).\",\n151|    ),\n152|    Mutant(\n153|        name=\"RV3-9-lookup-operation-prefix\",\n154|        path=f\"{PACKAGE}/binding.go\",\n155|        find=\"\\tif binding.OperationID != operationID {\\n\\t\\treturn empty, false, errors.New(\\\"bootstrap pair receipt names another operation\\\")\\n\\t}\\n\",\n156|        replace=\"\\tif binding.OperationID[:len(binding.OperationID)-1] != operationID[:len(operationID)-1] {\\n\\t\\treturn empty, false, errors.New(\\\"bootstrap pair receipt names another operation\\\")\\n\\t}\\n\",\n157|        expect=\"KILLED\",\n158|        note=\"Lookup's receipt-to-operation check narrowed to a prefix compare (same-prefix operations admitted).\",\n159|    ),\n160|    Mutant(\n161|        name=\"RV3-10-sessionbound-ignores-receipts\",\n162|        path=f\"{PACKAGE}/binding.go\",\n163|        find=\"\\tmatches, err := filepath.Glob(filepath.Join(store.receiptsDir(sessionID), \\\"*.json\\\"))\\n\\tif err != nil {\\n\\t\\treturn false, err\\n\\t}\\n\\treturn len(matches) > 0, nil\\n\",\n164|        replace=\"\\treturn false, nil\\n\",\n165|        expect=\"SURVIVED\",\n166|        note=\"Equivalence probe: receipts-only sessions cannot arise (the anchor is always installed first); a survival marks the scan unmeasured, not defective.\",\n167|    ),\n168|    Mutant(\n169|        name=\"RV3-11-fold-error-laundered-as-absence\",\n170|        path=f\"{PACKAGE}/run.go\",\n171|        find=\"\\t\\thas, newest, err := LoadNewestCheckpoint(stores.Repo, request.SessionID)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn empty, err\\n\\t\\t}\\n\",\n172|        replace=\"\\t\\thas, newest, err := LoadNewestCheckpoint(stores.Repo, request.SessionID)\\n\\t\\tif err != nil {\\n\\t\\t\\thas, newest = false, \\\"\\\"\\n\\t\\t}\\n\",\n173|        expect=\"KILLED\",\n174|        note=\"Absence vs failure: an unfolderable chain through Run becomes 'no checkpoint' instead of an error.\",\n175|    ),\n176|    Mutant(\n177|        name=\"RV3-12-profile-closure-from-required-not-winner\",\n178|        path=f\"{PACKAGE}/run.go\",\n179|        find=\"\\t\\tif observation.HasWinner && observation.Winner.HasCheckpoint && stores.Ckpt != nil {\\n\\t\\t\\tdoc := input.CheckpointDoc\\n\",\n180|        replace=\"\\t\\tif false && observation.HasWinner && observation.Winner.HasCheckpoint && stores.Ckpt != nil {\\n\\t\\t\\tdoc := input.CheckpointDoc\\n\",\n181|        expect=\"KILLED\",\n182|        note=\"Run's winner-checkpoint closure branch disabled (falls to the required checkpoint's closure or the head): measures how the closure source is pinned.\",\n183|    ),\n184|    Mutant(\n185|        name=\"RC3-control-comment\",\n186|        path=f\"{PACKAGE}/decide.go\",\n187|        find=\"// Decide is the pure wrapper core: configuration, session, bootstrap\\n\",\n188|        replace=\"// Decide is the pure wrapper core (reviewer control): configuration, session, bootstrap\\n\",\n189|        expect=\"SURVIVED\",\n190|        note=\"Harmless control: comment-only edit must survive.\",\n191|    ),\n192|]\n193|\n194|\n195|def run_mutant(repo: Path, logdir: Path, mutant: Mutant) -> str:\n196|    target = repo / mutant.path\n197|    original = target.read_text()\n198|    found = original.count(mutant.find)\n199|    if found != 1:\n200|        return f\"ERROR: {mutant.name}: patch anchors {found}, want 1\"\n201|    with tempfile.TemporaryDirectory() as staging:\n202|        backup = Path(staging) / \"backup\"\n203|        shutil.copy2(target, backup)\n204|        try:\n205|            target.write_text(original.replace(mutant.find, mutant.replace))\n206|            run = subprocess.run(\n207|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-count=1\"],\n208|                cwd=repo, capture_output=True, text=True, timeout=900,\n209|            )\n210|        finally:\n211|            shutil.copy2(backup, target)\n212|    output = (run.stdout + run.stderr).strip()\n213|    (logdir / f\"{mutant.name}.log\").write_text(f\"exit {run.returncode}\\n{output}\\n\")\n214|    if \"build failed\" in output or \"\\n# \" in output or output.startswith(\"# \"):\n215|        return f\"ERROR: {mutant.name}: build broke under the patch [exit {run.returncode}]\"\n216|    if run.returncode == 0:\n217|        verdict = \"SURVIVED\"\n218|    elif \"--- FAIL\" in output or \"FAIL:\" in output:\n219|        verdict = \"KILLED\"\n220|    else:\n221|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\"\n222|    killers = sorted({line.split()[2] for line in output.splitlines() if line.startswith(\"--- FAIL\")})\n223|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n224|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) killers={killers} :: {mutant.note} [exit {run.returncode}]\"\n225|\n226|\n227|def main(argv: list[str]) -> int:\n228|    repo = Path(argv[0]).resolve()\n229|    logdir = Path(argv[1]).resolve()\n230|    logdir.mkdir(parents=True, exist_ok=True)\n231|    names = argv[2:]\n232|    selected = [m for m in MUTANTS if not names or m.name in names]\n233|    failures = 0\n234|    for mutant in selected:\n235|        try:\n236|            line = run_mutant(repo, logdir, mutant)\n237|        except subprocess.TimeoutExpired:\n238|            line = f\"ERROR: {mutant.name}: killer timed out\"\n239|        print(line, flush=True)\n240|        if not line.startswith(\"ok:\"):\n241|            failures += 1\n242|    return 1 if failures else 0\n243|\n244|\n245|if __name__ == \"__main__\":\n246|    sys.exit(main(sys.argv[1:]))","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
