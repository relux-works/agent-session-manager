{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c65d","stream":{"kind":"session","id":"01a0b194-ebfd-7972-8291-a2a8c88f871f"},"sequence":393,"recorded_at":1780531400000781,"record_type":"event","durability":"durable","causation_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","run_stream":{"kind":"run","id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e"},"task_stream":{"kind":"task","id":"01a0b196-5e3a-74e3-a58d-57d2007385a1"},"task_id":"01a0b196-5e3a-74e3-a58d-57d2007385a1","event":{"kind":"output","task_id":"01a0b196-5e3a-74e3-a58d-57d2007385a1","chunk":"Read text file `internal/axpane/binding.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"crypto/sha256\"\n6|\t\"encoding/hex\"\n7|\t\"encoding/json\"\n8|\t\"errors\"\n9|\t\"fmt\"\n10|\t\"os\"\n11|\t\"path/filepath\"\n12|\t\"time\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n16|)\n17|\n18|// Binding schema identity. This is an AX-internal host-local durable\n19|// record (the §4.E host-local durable metadata class: the\n20|// idempotency receipt for the bootstrap window), not a replicated\n21|// contract: it is never published to the mesh and never leaves the\n22|// host.\n23|const (\n24|\tbindingSchema        = \"urn:ax:schema:pane-bootstrap-binding\"\n25|\tbindingSchemaVersion = \"1.0.0\"\n26|)\n27|\n28|// Binding is the one recorded wrapper/child for a\n29|// (session_id, bootstrap_operation_id) pair. Identity is the\n30|// AX-allocated terminal instance UUIDv7 plus the binding digest; a\n31|// PID, handle, socket, path, or endpoint is never identity and never\n32|// persisted here.\n33|type Binding struct {\n34|\tSessionID          string `json:\"session_id\"`\n35|\tOperationID        string `json:\"bootstrap_operation_id\"`\n36|\tTerminalInstanceID string `json:\"terminal_instance_id\"`\n37|\tBindingDigest      string `json:\"binding_digest\"`\n38|\tCreatedAt          string `json:\"created_at\"`\n39|}\n40|\n41|// bindingMembers is the exact closed member set of the stored\n42|// document.\n43|var bindingMembers = []string{\n44|\t\"schema\",\n45|\t\"schema_version\",\n46|\t\"session_id\",\n47|\t\"bootstrap_operation_id\",\n48|\t\"terminal_instance_id\",\n49|\t\"binding_digest\",\n50|\t\"created_at\",\n51|}\n52|\n53|// Hooks arms the crash boundaries of the staged installs: after\n54|// the receipt bytes are staged to the temporary file (before the\n55|// atomic install), and after the install commits (before the\n56|// directory sync makes the commit durable). The hooks fire on\n57|// whichever install path runs: Bind's first-anchor install and\n58|// Supersede's pair-receipt install. A nil hook is a no-op; a hook\n59|// error aborts the call with that error and installs nothing\n60|// further on that path.\n61|type Hooks struct {\n62|\tAfterStage   func(path string) error\n63|\tAfterInstall func(path string) error\n64|}\n65|\n66|// Store is the durable bootstrap binding store rooted at one data\n67|// directory. The session's first binding anchors at\n68|// <root>/axpane/bootstrap/<session_id>/binding.json, and every\n69|// recorded (session_id, bootstrap_operation_id) pair keeps its own\n70|// receipt at\n71|// <root>/axpane/bootstrap/<session_id>/receipts/<operation_id>.json.\n72|// Superseded pairs keep their receipts: an identical retry of any\n73|// recorded pair replays its own receipt.\n74|type Store struct {\n75|\troot  string\n76|\thooks *Hooks\n77|\tnow   func() time.Time\n78|}\n79|\n80|// Open creates the store, ensuring the root exists. It creates no\n81|// session directories: those appear with the first Bind.\n82|func Open(root string) (*Store, error) {\n83|\tif root == \"\" {\n84|\t\treturn nil, errors.New(\"axpane bootstrap store root is empty\")\n85|\t}\n86|\tbase := filepath.Join(root, \"axpane\", \"bootstrap\")\n87|\tif err := os.MkdirAll(base, 0o755); err != nil {\n88|\t\treturn nil, fmt.Errorf(\"create axpane bootstrap root: %w\", err)\n89|\t}\n90|\treturn &Store{root: root, now: time.Now}, nil\n91|}\n92|\n93|// WithHooks returns the store with crash hooks armed. It mutates the\n94|// receiver and returns it for call chaining.\n95|func (store *Store) WithHooks(hooks *Hooks) *Store {\n96|\tstore.hooks = hooks\n97|\treturn store\n98|}\n99|\n100|func (store *Store) sessionDir(sessionID string) string {\n101|\treturn filepath.Join(store.root, \"axpane\", \"bootstrap\", sessionID)\n102|}\n103|\n104|func (store *Store) bindingPath(sessionID string) string {\n105|\treturn filepath.Join(store.sessionDir(sessionID), \"binding.json\")\n106|}\n107|\n108|func (store *Store) receiptsDir(sessionID string) string {\n109|\treturn filepath.Join(store.sessionDir(sessionID), \"receipts\")\n110|}\n111|\n112|func (store *Store) receiptPath(sessionID, operationID string) string {\n113|\treturn filepath.Join(store.receiptsDir(sessionID), operationID+\".json\")\n114|}\n115|\n116|// Bind durably binds (session_id, bootstrap_operation_id) to the one\n117|// recorded wrapper/child before any launch side effect. The first\n118|// call for a session anchors the candidate receipt and records its\n119|// pair receipt from the same bytes; an identical retry returns the\n120|// stored pair receipt with reattached true; a changed operation\n121|// refuses idempotency_mismatch while the bootstrap window is open.\n122|// After the window closes a new operation records its own pair\n123|// receipt through Supersede, never through this no-replace entry.\n124|// The candidate's session and operation must equal the call\n125|// arguments; its instance ID and binding digest are validated, and\n126|// the store stamps created_at at install. The stored receipt is\n127|// authoritative on retry: a retry carrying different child facts\n128|// still reattaches to the one recorded child, never to a second\n129|// child. Stale staging files from a pre-commit crash are swept\n130|// before the install.\n131|func (store *Store) Bind(sessionID, operationID string, candidate Binding) (Binding, bool, error) {\n132|\tempty := Binding{}\n133|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n134|\t\treturn empty, false, fmt.Errorf(\"bind session %q is not a UUIDv7: %w\", sessionID, err)\n135|\t}\n136|\tif _, err := scalar.ParseUUIDv7(operationID); err != nil {\n137|\t\treturn empty, false, fmt.Errorf(\"bind operation %q is not a UUIDv7: %w\", operationID, err)\n138|\t}\n139|\tif candidate.SessionID != sessionID || candidate.OperationID != operationID {\n140|\t\treturn empty, false, fmt.Errorf(\"bind candidate names another bootstrap pair\")\n141|\t}\n142|\tif err := checkBindingCandidate(candidate); err != nil {\n143|\t\treturn empty, false, err\n144|\t}\n145|\tpair, pairFound, err := store.Lookup(sessionID, operationID)\n146|\tif err != nil {\n147|\t\treturn empty, false, err\n148|\t}\n149|\tif pairFound {\n150|\t\treturn pair, true, nil\n151|\t}\n152|\texisting, found, err := store.Status(sessionID)\n153|\tif err != nil {\n154|\t\treturn empty, false, err\n155|\t}\n156|\tif found {\n157|\t\tif existing.OperationID != operationID {\n158|\t\t\treturn empty, false, &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \"bootstrap binding\"}\n159|\t\t}\n160|\t\t// The anchor names this operation but the pair\n161|\t\t// receipt is absent: a crash landed between the two\n162|\t\t// installs. Converge the pair receipt from the\n163|\t\t// anchor bytes and reattach to the one child.\n164|\t\tconverged, err := store.convergePairFromFirst(sessionID, operationID)\n165|\t\tif err != nil {\n166|\t\t\treturn empty, false, err\n167|\t\t}\n168|\t\treturn converged, true, nil\n169|\t}\n170|\treceipt, err := encodeBinding(candidate, store.timestamp())\n171|\tif err != nil {\n172|\t\treturn empty, false, err\n173|\t}\n174|\tif err := store.install(sessionID, operationID, receipt); err != nil {\n175|\t\tvar concurrent errConcurrentWinner\n176|\t\tif errors.As(err, &concurrent) {\n177|\t\t\treturn concurrent.bound, true, nil\n178|\t\t}\n179|\t\treturn empty, false, err\n180|\t}\n181|\tstored, found, err := store.Lookup(sessionID, operationID)\n182|\tif err != nil {\n183|\t\treturn empty, false, err\n184|\t}\n185|\tif !found {\n186|\t\treturn empty, false, errors.New(\"bootstrap binding vanished after install\")\n187|\t}\n188|\treturn stored, false, nil\n189|}\n190|\n191|// Status proves absence or identifies the session's first recorded\n192|// wrapper/child: found is true with the anchor receipt, or false\n193|// when no binding exists. A read or validation failure is an\n194|// error, never absence: unknown is not absent. Pair-scoped replay\n195|// reads through Lookup: superseded pairs keep their receipts while\n196|// the anchor keeps pointing at the first.\n197|func (store *Store) Status(sessionID string) (Binding, bool, error) {\n198|\tempty := Binding{}\n199|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n200|\t\treturn empty, false, fmt.Errorf(\"binding status session %q is not a UUIDv7: %w\", sessionID, err)\n201|\t}\n202|\traw, err := os.ReadFile(store.bindingPath(sessionID))\n203|\tif err != nil {\n204|\t\tif errors.Is(err, os.ErrNotExist) {\n205|\t\t\treturn empty, false, nil\n206|\t\t}\n207|\t\treturn empty, false, fmt.Errorf(\"read bootstrap binding: %w\", err)\n208|\t}\n209|\tbinding, err := decodeBinding(raw)\n210|\tif err != nil {\n211|\t\treturn empty, false, err\n212|\t}\n213|\tif binding.SessionID != sessionID {\n214|\t\treturn empty, false, errors.New(\"bootstrap binding names another session\")\n215|\t}\n216|\treturn binding, true, nil\n217|}\n218|\n219|// Lookup proves absence or replays the one recorded wrapper/child\n220|// for a (session_id, bootstrap_operation_id) pair: found is true\n221|// with that pair's own receipt, or false when the pair is\n222|// unrecorded. A read or validation failure is an error, never\n223|// absence: unknown is not absent. An identical retry of any\n224|// recorded pair replays its receipt here, including pairs later\n225|// pairs superseded.\n226|func (store *Store) Lookup(sessionID, operationID string) (Binding, bool, error) {\n227|\tempty := Binding{}\n228|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n229|\t\treturn empty, false, fmt.Errorf(\"binding lookup session %q is not a UUIDv7: %w\", sessionID, err)\n230|\t}\n231|\tif _, err := scalar.ParseUUIDv7(operationID); err != nil {\n232|\t\treturn empty, false, fmt.Errorf(\"binding lookup operation %q is not a UUIDv7: %w\", operationID, err)\n233|\t}\n234|\traw, err := os.ReadFile(store.receiptPath(sessionID, operationID))\n235|\tif err != nil {\n236|\t\tif errors.Is(err, os.ErrNotExist) {\n237|\t\t\treturn empty, false, nil\n238|\t\t}\n239|\t\treturn empty, false, fmt.Errorf(\"read bootstrap pair receipt: %w\", err)\n240|\t}\n241|\tbinding, err := decodeBinding(raw)\n242|\tif err != nil {\n243|\t\treturn empty, false, err\n244|\t}\n245|\tif binding.SessionID != sessionID {\n246|\t\treturn empty, false, errors.New(\"bootstrap pair receipt names another session\")\n247|\t}\n248|\tif binding.OperationID != operationID {\n249|\t\treturn empty, false, errors.New(\"bootstrap pair receipt names another operation\")\n250|\t}\n251|\treturn binding, true, nil\n252|}\n253|\n254|// SessionBound reports whether the session has any recorded\n255|// binding: the first-binding anchor or any pair receipt. A torn\n256|// anchor fails the read (unknown, never unbound); pair receipts\n257|// count by presence, since each pair validates on its own Lookup.\n258|func (store *Store) SessionBound(sessionID string) (bool, error) {\n259|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n260|\t\treturn false, fmt.Errorf(\"binding session %q is not a UUIDv7: %w\", sessionID, err)\n261|\t}\n262|\t_, found, err := store.Status(sessionID)\n263|\tif err != nil {\n264|\t\treturn false, err\n265|\t}\n266|\tif found {\n267|\t\treturn true, nil\n268|\t}\n269|\tmatches, err := filepath.Glob(filepath.Join(store.receiptsDir(sessionID), \"*.json\"))\n270|\tif err != nil {\n271|\t\treturn false, err\n272|\t}\n273|\treturn len(matches) > 0, nil\n274|}\n275|\n276|func (store *Store) timestamp() string {\n277|\tnow := time.Now().UTC()\n278|\tif store.now != nil {\n279|\t\tnow = store.now().UTC()\n280|\t}\n281|\treturn now.Format(\"2006-01-02T15:04:05.000Z07:00\")\n282|}\n283|\n284|// install stages the receipt to a same-directory temporary file,\n285|// fsyncs it, atomically links it to the binding path (which must\n286|// not exist: the link is the no-replace commit), removes the\n287|// staging name, and fsyncs the directory. Readers see absence or\n288|// the complete receipt, never a torn prefix: a crash before the\n289|// link leaves only ignored staging garbage, and a crash after it\n290|// leaves the complete binding the identical retry reattaches to.\n291|// Any pre-existing binding refuses without replacement.\n292|// errConcurrentWinner carries the winning receipt when a concurrent\n293|// wrapper commits first: the loser reattaches instead of failing.\n294|type errConcurrentWinner struct {\n295|\tbound Binding\n296|}\n297|\n298|func (err errConcurrentWinner) Error() string {\n299|\treturn \"bootstrap binding concurrently committed by another wrapper\"\n300|}\n301|\n302|// Supersede durably records a post-window bootstrap pair: the\n303|// caller proved (through the fold's newest checkpoint) that a new\n304|// bootstrap operation is legitimate, and the store installs that\n305|// pair's own receipt no-replace. Superseded pairs keep their\n306|// receipts — nothing is renamed over — so an identical retry of\n307|// any recorded pair replays its own receipt, and two post-window\n308|// Supersede calls with different operations each record their own\n309|// child. A recorded pair replays idempotently: Supersede never\n310|// replaces a pair receipt. The session's first-binding anchor is\n311|// claimed when absent so the anchor always names the first\n312|// recorded pair. Supersede refuses malformed candidates exactly\n313|// like Bind.\n314|func (store *Store) Supersede(sessionID, operationID string, candidate Binding) (Binding, error) {\n315|\tempty := Binding{}\n316|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n317|\t\treturn empty, fmt.Errorf(\"bind session %q is not a UUIDv7: %w\", sessionID, err)\n318|\t}\n319|\tif _, err := scalar.ParseUUIDv7(operationID); err != nil {\n320|\t\treturn empty, fmt.Errorf(\"bind operation %q is not a UUIDv7: %w\", operationID, err)\n321|\t}\n322|\tif candidate.SessionID != sessionID || candidate.OperationID != operationID {\n323|\t\treturn empty, fmt.Errorf(\"bind candidate names another bootstrap pair\")\n324|\t}\n325|\tif err := checkBindingCandidate(candidate); err != nil {\n326|\t\treturn empty, err\n327|\t}\n328|\tstored, found, err := store.Lookup(sessionID, operationID)\n329|\tif err != nil {\n330|\t\treturn empty, err\n331|\t}\n332|\tif !found {\n333|\t\treceipt, err := encodeBinding(candidate, store.timestamp())\n334|\t\tif err != nil {\n335|\t\t\treturn empty, err\n336|\t\t}\n337|\t\tstored, err = store.installPair(sessionID, operationID, receipt)\n338|\t\tif err != nil {\n339|\t\t\treturn empty, err\n340|\t\t}\n341|\t}\n342|\t// The anchor claim runs on every return path, including the\n343|\t// idempotent replay: a crash between the pair install and\n344|\t// the anchor claim converges on retry.\n345|\tif err := store.ensureFirstFromPair(sessionID, operationID); err != nil {\n346|\t\treturn empty, err\n347|\t}\n348|\treturn stored, nil\n349|}\n350|\n351|// installPair stages the pair receipt and atomically links it to\n352|// the pair path, which must not exist: the link is the no-replace\n353|// commit. Readers see absence or the complete receipt, never a\n354|// torn prefix: a crash before the link leaves only ignored staging\n355|// garbage, and a crash after it leaves the complete receipt the\n356|// identical retry replays. A concurrent same-pair commit wins and\n357|// the loser replays the winner's receipt. Staging garbage from a\n358|// pre-commit crash is swept first.\n359|func (store *Store) installPair(sessionID, operationID string, receipt []byte) (Binding, error) {\n360|\tempty := Binding{}\n361|\tdir := store.receiptsDir(sessionID)\n362|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n363|\t\treturn empty, fmt.Errorf(\"create bootstrap receipts directory: %w\", err)\n364|\t}\n365|\tsweepReceiptsStaging(dir)\n366|\ttarget := store.receiptPath(sessionID, operationID)\n367|\tstaged, err := os.CreateTemp(dir, \"receipt-*.tmp\")\n368|\tif err != nil {\n369|\t\treturn empty, fmt.Errorf(\"stage bootstrap pair receipt: %w\", err)\n370|\t}\n371|\tstagedPath := staged.Name()\n372|\tdefer func() { _ = os.Remove(stagedPath) }()\n373|\tif err := staged.Chmod(0o600); err != nil {\n374|\t\t_ = staged.Close()\n375|\t\treturn empty, fmt.Errorf(\"protect bootstrap pair receipt: %w\", err)\n376|\t}\n377|\tif _, err := staged.Write(receipt); err != nil {\n378|\t\t_ = staged.Close()\n379|\t\treturn empty, fmt.Errorf(\"write bootstrap pair receipt: %w\", err)\n380|\t}\n381|\tif err := staged.Sync(); err != nil {\n382|\t\t_ = staged.Close()\n383|\t\treturn empty, fmt.Errorf(\"sync bootstrap pair receipt: %w\", err)\n384|\t}\n385|\tif err := staged.Close(); err != nil {\n386|\t\treturn empty, fmt.Errorf(\"close bootstrap pair receipt: %w\", err)\n387|\t}\n388|\tif store.hooks != nil && store.hooks.AfterStage != nil {\n389|\t\tif err := store.hooks.AfterStage(stagedPath); err != nil {\n390|\t\t\treturn empty, err\n391|\t\t}\n392|\t}\n393|\tif err := os.Link(stagedPath, target); err != nil {\n394|\t\tif errors.Is(err, os.ErrExist) {\n395|\t\t\t// A concurrent wrapper recorded this pair\n396|\t\t\t// between our Lookup and our link: replay the\n397|\t\t\t// winner's receipt.\n398|\t\t\twinner, found, readErr := store.Lookup(sessionID, operationID)\n399|\t\t\tif readErr != nil {\n400|\t\t\t\treturn empty, readErr\n401|\t\t\t}\n402|\t\t\tif !found {\n403|\t\t\t\treturn empty, errors.New(\"bootstrap pair receipt vanished after concurrent commit\")\n404|\t\t\t}\n405|\t\t\treturn winner, nil\n406|\t\t}\n407|\t\treturn empty, fmt.Errorf(\"install bootstrap pair receipt: %w\", err)\n408|\t}\n409|\t_ = os.Remove(stagedPath)\n410|\tif store.hooks != nil && store.hooks.AfterInstall != nil {\n411|\t\tif err := store.hooks.AfterInstall(target); err != nil {\n412|\t\t\treturn empty, err\n413|\t\t}\n414|\t}\n415|\tif err := syncDirectory(dir); err != nil {\n416|\t\treturn empty, err\n417|\t}\n418|\tif err := syncDirectory(store.sessionDir(sessionID)); err != nil {\n419|\t\treturn empty, err\n420|\t}\n421|\tstored, found, err := store.Lookup(sessionID, operationID)\n422|\tif err != nil {\n423|\t\treturn empty, err\n424|\t}\n425|\tif !found {\n426|\t\treturn empty, errors.New(\"bootstrap pair receipt vanished after install\")\n427|\t}\n428|\treturn stored, nil\n429|}\n430|\n431|// convergePairFromFirst records the pair receipt from the anchor\n432|// bytes after a crash landed between the anchor install and the\n433|// pair install. The anchor names this operation (checked by the\n434|// caller): the pair receipt carries the identical bytes, so the\n435|// anchor and the pair agree byte for byte.\n436|func (store *Store) convergePairFromFirst(sessionID, operationID string) (Binding, error) {\n437|\tempty := Binding{}\n438|\traw, err := os.ReadFile(store.bindingPath(sessionID))\n439|\tif err != nil {\n440|\t\treturn empty, fmt.Errorf(\"read bootstrap binding for pair convergence: %w\", err)\n441|\t}\n442|\tbinding, err := decodeBinding(raw)\n443|\tif err != nil {\n444|\t\treturn empty, err\n445|\t}\n446|\tif binding.SessionID != sessionID || binding.OperationID != operationID {\n447|\t\treturn empty, fmt.Errorf(\"bind anchor names another bootstrap pair\")\n448|\t}\n449|\treturn store.installPair(sessionID, operationID, raw)\n450|}\n451|\n452|// ensureFirstFromPair claims the session's first-binding anchor\n453|// from an already-recorded pair receipt when the anchor is absent.\n454|// The link carries the no-replace guard: a concurrent claim wins\n455|// and this call converges to it. It is a no-op when the anchor\n456|// exists.\n457|func (store *Store) ensureFirstFromPair(sessionID, operationID string) error {\n458|\tif _, err := os.Lstat(store.bindingPath(sessionID)); err == nil {\n459|\t\treturn nil\n460|\t} else if !errors.Is(err, os.ErrNotExist) {\n461|\t\treturn fmt.Errorf(\"stat bootstrap binding: %w\", err)\n462|\t}\n463|\tif err := os.Link(store.receiptPath(sessionID, operationID), store.bindingPath(sessionID)); err != nil {\n464|\t\tif errors.Is(err, os.ErrExist) {\n465|\t\t\treturn nil\n466|\t\t}\n467|\t\treturn fmt.Errorf(\"claim first bootstrap binding: %w\", err)\n468|\t}\n469|\treturn syncDirectory(store.sessionDir(sessionID))\n470|}\n471|\n472|// sweepStaging removes stale binding-*.tmp files left by a\n473|// pre-commit crash. Only files older than a minute are removed: a\n474|// concurrent live wrapper stages under the same pattern, and an\n475|// age gate keeps the sweep from deleting its in-flight receipt. It\n476|// is best-effort: a sweep failure never fails the binding, and\n477|// only the staging pattern is removed.\n478|func sweepStaging(dir string) {\n479|\tsweepStagingPattern(dir, \"binding-*.tmp\")\n480|}\n481|\n482|// sweepReceiptsStaging removes stale receipt-*.tmp files left by a\n483|// pre-commit pair-receipt crash, under the same age gate.\n484|func sweepReceiptsStaging(dir string) {\n485|\tsweepStagingPattern(dir, \"receipt-*.tmp\")\n486|}\n487|\n488|func sweepStagingPattern(dir, pattern string) {\n489|\tmatches, err := filepath.Glob(filepath.Join(dir, pattern))\n490|\tif err != nil {\n491|\t\treturn\n492|\t}\n493|\tcutoff := time.Now().Add(-time.Minute)\n494|\tfor _, match := range matches {\n495|\t\tinfo, err := os.Stat(match)\n496|\t\tif err != nil {\n497|\t\t\tcontinue\n498|\t\t}\n499|\t\tif info.ModTime().After(cutoff) {\n500|\t\t\tcontinue\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c65f","stream":{"kind":"session","id":"01a0b194-ebfd-7972-8291-a2a8c88f871f"},"sequence":394,"recorded_at":1780531400000783,"record_type":"event","durability":"durable","causation_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","run_stream":{"kind":"run","id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e"},"task_stream":{"kind":"task","id":"01a0b196-5e3a-74e3-a58d-57d2007385a1"},"task_id":"01a0b196-5e3a-74e3-a58d-57d2007385a1","event":{"kind":"completed","task_id":"01a0b196-5e3a-74e3-a58d-57d2007385a1"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c661","stream":{"kind":"session","id":"01a0b194-ebfd-7972-8291-a2a8c88f871f"},"sequence":395,"recorded_at":1780531400000785,"record_type":"event","durability":"durable","causation_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","run_stream":{"kind":"run","id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e"},"call_id":"call_01a0b196592c7345a34981b88b49f7d1","text":"Read text file `internal/axpane/binding.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"crypto/sha256\"\n6|\t\"encoding/hex\"\n7|\t\"encoding/json\"\n8|\t\"errors\"\n9|\t\"fmt\"\n10|\t\"os\"\n11|\t\"path/filepath\"\n12|\t\"time\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n16|)\n17|\n18|// Binding schema identity. This is an AX-internal host-local durable\n19|// record (the §4.E host-local durable metadata class: the\n20|// idempotency receipt for the bootstrap window), not a replicated\n21|// contract: it is never published to the mesh and never leaves the\n22|// host.\n23|const (\n24|\tbindingSchema        = \"urn:ax:schema:pane-bootstrap-binding\"\n25|\tbindingSchemaVersion = \"1.0.0\"\n26|)\n27|\n28|// Binding is the one recorded wrapper/child for a\n29|// (session_id, bootstrap_operation_id) pair. Identity is the\n30|// AX-allocated terminal instance UUIDv7 plus the binding digest; a\n31|// PID, handle, socket, path, or endpoint is never identity and never\n32|// persisted here.\n33|type Binding struct {\n34|\tSessionID          string `json:\"session_id\"`\n35|\tOperationID        string `json:\"bootstrap_operation_id\"`\n36|\tTerminalInstanceID string `json:\"terminal_instance_id\"`\n37|\tBindingDigest      string `json:\"binding_digest\"`\n38|\tCreatedAt          string `json:\"created_at\"`\n39|}\n40|\n41|// bindingMembers is the exact closed member set of the stored\n42|// document.\n43|var bindingMembers = []string{\n44|\t\"schema\",\n45|\t\"schema_version\",\n46|\t\"session_id\",\n47|\t\"bootstrap_operation_id\",\n48|\t\"terminal_instance_id\",\n49|\t\"binding_digest\",\n50|\t\"created_at\",\n51|}\n52|\n53|// Hooks arms the crash boundaries of the staged installs: after\n54|// the receipt bytes are staged to the temporary file (before the\n55|// atomic install), and after the install commits (before the\n56|// directory sync makes the commit durable). The hooks fire on\n57|// whichever install path runs: Bind's first-anchor install and\n58|// Supersede's pair-receipt install. A nil hook is a no-op; a hook\n59|// error aborts the call with that error and installs nothing\n60|// further on that path.\n61|type Hooks struct {\n62|\tAfterStage   func(path string) error\n63|\tAfterInstall func(path string) error\n64|}\n65|\n66|// Store is the durable bootstrap binding store rooted at one data\n67|// directory. The session's first binding anchors at\n68|// <root>/axpane/bootstrap/<session_id>/binding.json, and every\n69|// recorded (session_id, bootstrap_operation_id) pair keeps its own\n70|// receipt at\n71|// <root>/axpane/bootstrap/<session_id>/receipts/<operation_id>.json.\n72|// Superseded pairs keep their receipts: an identical retry of any\n73|// recorded pair replays its own receipt.\n74|type Store struct {\n75|\troot  string\n76|\thooks *Hooks\n77|\tnow   func() time.Time\n78|}\n79|\n80|// Open creates the store, ensuring the root exists. It creates no\n81|// session directories: those appear with the first Bind.\n82|func Open(root string) (*Store, error) {\n83|\tif root == \"\" {\n84|\t\treturn nil, errors.New(\"axpane bootstrap store root is empty\")\n85|\t}\n86|\tbase := filepath.Join(root, \"axpane\", \"bootstrap\")\n87|\tif err := os.MkdirAll(base, 0o755); err != nil {\n88|\t\treturn nil, fmt.Errorf(\"create axpane bootstrap root: %w\", err)\n89|\t}\n90|\treturn &Store{root: root, now: time.Now}, nil\n91|}\n92|\n93|// WithHooks returns the store with crash hooks armed. It mutates the\n94|// receiver and returns it for call chaining.\n95|func (store *Store) WithHooks(hooks *Hooks) *Store {\n96|\tstore.hooks = hooks\n97|\treturn store\n98|}\n99|\n100|func (store *Store) sessionDir(sessionID string) string {\n101|\treturn filepath.Join(store.root, \"axpane\", \"bootstrap\", sessionID)\n102|}\n103|\n104|func (store *Store) bindingPath(sessionID string) string {\n105|\treturn filepath.Join(store.sessionDir(sessionID), \"binding.json\")\n106|}\n107|\n108|func (store *Store) receiptsDir(sessionID string) string {\n109|\treturn filepath.Join(store.sessionDir(sessionID), \"receipts\")\n110|}\n111|\n112|func (store *Store) receiptPath(sessionID, operationID string) string {\n113|\treturn filepath.Join(store.receiptsDir(sessionID), operationID+\".json\")\n114|}\n115|\n116|// Bind durably binds (session_id, bootstrap_operation_id) to the one\n117|// recorded wrapper/child before any launch side effect. The first\n118|// call for a session anchors the candidate receipt and records its\n119|// pair receipt from the same bytes; an identical retry returns the\n120|// stored pair receipt with reattached true; a changed operation\n121|// refuses idempotency_mismatch while the bootstrap window is open.\n122|// After the window closes a new operation records its own pair\n123|// receipt through Supersede, never through this no-replace entry.\n124|// The candidate's session and operation must equal the call\n125|// arguments; its instance ID and binding digest are validated, and\n126|// the store stamps created_at at install. The stored receipt is\n127|// authoritative on retry: a retry carrying different child facts\n128|// still reattaches to the one recorded child, never to a second\n129|// child. Stale staging files from a pre-commit crash are swept\n130|// before the install.\n131|func (store *Store) Bind(sessionID, operationID string, candidate Binding) (Binding, bool, error) {\n132|\tempty := Binding{}\n133|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n134|\t\treturn empty, false, fmt.Errorf(\"bind session %q is not a UUIDv7: %w\", sessionID, err)\n135|\t}\n136|\tif _, err := scalar.ParseUUIDv7(operationID); err != nil {\n137|\t\treturn empty, false, fmt.Errorf(\"bind operation %q is not a UUIDv7: %w\", operationID, err)\n138|\t}\n139|\tif candidate.SessionID != sessionID || candidate.OperationID != operationID {\n140|\t\treturn empty, false, fmt.Errorf(\"bind candidate names another bootstrap pair\")\n141|\t}\n142|\tif err := checkBindingCandidate(candidate); err != nil {\n143|\t\treturn empty, false, err\n144|\t}\n145|\tpair, pairFound, err := store.Lookup(sessionID, operationID)\n146|\tif err != nil {\n147|\t\treturn empty, false, err\n148|\t}\n149|\tif pairFound {\n150|\t\treturn pair, true, nil\n151|\t}\n152|\texisting, found, err := store.Status(sessionID)\n153|\tif err != nil {\n154|\t\treturn empty, false, err\n155|\t}\n156|\tif found {\n157|\t\tif existing.OperationID != operationID {\n158|\t\t\treturn empty, false, &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \"bootstrap binding\"}\n159|\t\t}\n160|\t\t// The anchor names this operation but the pair\n161|\t\t// receipt is absent: a crash landed between the two\n162|\t\t// installs. Converge the pair receipt from the\n163|\t\t// anchor bytes and reattach to the one child.\n164|\t\tconverged, err := store.convergePairFromFirst(sessionID, operationID)\n165|\t\tif err != nil {\n166|\t\t\treturn empty, false, err\n167|\t\t}\n168|\t\treturn converged, true, nil\n169|\t}\n170|\treceipt, err := encodeBinding(candidate, store.timestamp())\n171|\tif err != nil {\n172|\t\treturn empty, false, err\n173|\t}\n174|\tif err := store.install(sessionID, operationID, receipt); err != nil {\n175|\t\tvar concurrent errConcurrentWinner\n176|\t\tif errors.As(err, &concurrent) {\n177|\t\t\treturn concurrent.bound, true, nil\n178|\t\t}\n179|\t\treturn empty, false, err\n180|\t}\n181|\tstored, found, err := store.Lookup(sessionID, operationID)\n182|\tif err != nil {\n183|\t\treturn empty, false, err\n184|\t}\n185|\tif !found {\n186|\t\treturn empty, false, errors.New(\"bootstrap binding vanished after install\")\n187|\t}\n188|\treturn stored, false, nil\n189|}\n190|\n191|// Status proves absence or identifies the session's first recorded\n192|// wrapper/child: found is true with the anchor receipt, or false\n193|// when no binding exists. A read or validation failure is an\n194|// error, never absence: unknown is not absent. Pair-scoped replay\n195|// reads through Lookup: superseded pairs keep their receipts while\n196|// the anchor keeps pointing at the first.\n197|func (store *Store) Status(sessionID string) (Binding, bool, error) {\n198|\tempty := Binding{}\n199|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n200|\t\treturn empty, false, fmt.Errorf(\"binding status session %q is not a UUIDv7: %w\", sessionID, err)\n201|\t}\n202|\traw, err := os.ReadFile(store.bindingPath(sessionID))\n203|\tif err != nil {\n204|\t\tif errors.Is(err, os.ErrNotExist) {\n205|\t\t\treturn empty, false, nil\n206|\t\t}\n207|\t\treturn empty, false, fmt.Errorf(\"read bootstrap binding: %w\", err)\n208|\t}\n209|\tbinding, err := decodeBinding(raw)\n210|\tif err != nil {\n211|\t\treturn empty, false, err\n212|\t}\n213|\tif binding.SessionID != sessionID {\n214|\t\treturn empty, false, errors.New(\"bootstrap binding names another session\")\n215|\t}\n216|\treturn binding, true, nil\n217|}\n218|\n219|// Lookup proves absence or replays the one recorded wrapper/child\n220|// for a (session_id, bootstrap_operation_id) pair: found is true\n221|// with that pair's own receipt, or false when the pair is\n222|// unrecorded. A read or validation failure is an error, never\n223|// absence: unknown is not absent. An identical retry of any\n224|// recorded pair replays its receipt here, including pairs later\n225|// pairs superseded.\n226|func (store *Store) Lookup(sessionID, operationID string) (Binding, bool, error) {\n227|\tempty := Binding{}\n228|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n229|\t\treturn empty, false, fmt.Errorf(\"binding lookup session %q is not a UUIDv7: %w\", sessionID, err)\n230|\t}\n231|\tif _, err := scalar.ParseUUIDv7(operationID); err != nil {\n232|\t\treturn empty, false, fmt.Errorf(\"binding lookup operation %q is not a UUIDv7: %w\", operationID, err)\n233|\t}\n234|\traw, err := os.ReadFile(store.receiptPath(sessionID, operationID))\n235|\tif err != nil {\n236|\t\tif errors.Is(err, os.ErrNotExist) {\n237|\t\t\treturn empty, false, nil\n238|\t\t}\n239|\t\treturn empty, false, fmt.Errorf(\"read bootstrap pair receipt: %w\", err)\n240|\t}\n241|\tbinding, err := decodeBinding(raw)\n242|\tif err != nil {\n243|\t\treturn empty, false, err\n244|\t}\n245|\tif binding.SessionID != sessionID {\n246|\t\treturn empty, false, errors.New(\"bootstrap pair receipt names another session\")\n247|\t}\n248|\tif binding.OperationID != operationID {\n249|\t\treturn empty, false, errors.New(\"bootstrap pair receipt names another operation\")\n250|\t}\n251|\treturn binding, true, nil\n252|}\n253|\n254|// SessionBound reports whether the session has any recorded\n255|// binding: the first-binding anchor or any pair receipt. A torn\n256|// anchor fails the read (unknown, never unbound); pair receipts\n257|// count by presence, since each pair validates on its own Lookup.\n258|func (store *Store) SessionBound(sessionID string) (bool, error) {\n259|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n260|\t\treturn false, fmt.Errorf(\"binding session %q is not a UUIDv7: %w\", sessionID, err)\n261|\t}\n262|\t_, found, err := store.Status(sessionID)\n263|\tif err != nil {\n264|\t\treturn false, err\n265|\t}\n266|\tif found {\n267|\t\treturn true, nil\n268|\t}\n269|\tmatches, err := filepath.Glob(filepath.Join(store.receiptsDir(sessionID), \"*.json\"))\n270|\tif err != nil {\n271|\t\treturn false, err\n272|\t}\n273|\treturn len(matches) > 0, nil\n274|}\n275|\n276|func (store *Store) timestamp() string {\n277|\tnow := time.Now().UTC()\n278|\tif store.now != nil {\n279|\t\tnow = store.now().UTC()\n280|\t}\n281|\treturn now.Format(\"2006-01-02T15:04:05.000Z07:00\")\n282|}\n283|\n284|// install stages the receipt to a same-directory temporary file,\n285|// fsyncs it, atomically links it to the binding path (which must\n286|// not exist: the link is the no-replace commit), removes the\n287|// staging name, and fsyncs the directory. Readers see absence or\n288|// the complete receipt, never a torn prefix: a crash before the\n289|// link leaves only ignored staging garbage, and a crash after it\n290|// leaves the complete binding the identical retry reattaches to.\n291|// Any pre-existing binding refuses without replacement.\n292|// errConcurrentWinner carries the winning receipt when a concurrent\n293|// wrapper commits first: the loser reattaches instead of failing.\n294|type errConcurrentWinner struct {\n295|\tbound Binding\n296|}\n297|\n298|func (err errConcurrentWinner) Error() string {\n299|\treturn \"bootstrap binding concurrently committed by another wrapper\"\n300|}\n301|\n302|// Supersede durably records a post-window bootstrap pair: the\n303|// caller proved (through the fold's newest checkpoint) that a new\n304|// bootstrap operation is legitimate, and the store installs that\n305|// pair's own receipt no-replace. Superseded pairs keep their\n306|// receipts — nothing is renamed over — so an identical retry of\n307|// any recorded pair replays its own receipt, and two post-window\n308|// Supersede calls with different operations each record their own\n309|// child. A recorded pair replays idempotently: Supersede never\n310|// replaces a pair receipt. The session's first-binding anchor is\n311|// claimed when absent so the anchor always names the first\n312|// recorded pair. Supersede refuses malformed candidates exactly\n313|// like Bind.\n314|func (store *Store) Supersede(sessionID, operationID string, candidate Binding) (Binding, error) {\n315|\tempty := Binding{}\n316|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n317|\t\treturn empty, fmt.Errorf(\"bind session %q is not a UUIDv7: %w\", sessionID, err)\n318|\t}\n319|\tif _, err := scalar.ParseUUIDv7(operationID); err != nil {\n320|\t\treturn empty, fmt.Errorf(\"bind operation %q is not a UUIDv7: %w\", operationID, err)\n321|\t}\n322|\tif candidate.SessionID != sessionID || candidate.OperationID != operationID {\n323|\t\treturn empty, fmt.Errorf(\"bind candidate names another bootstrap pair\")\n324|\t}\n325|\tif err := checkBindingCandidate(candidate); err != nil {\n326|\t\treturn empty, err\n327|\t}\n328|\tstored, found, err := store.Lookup(sessionID, operationID)\n329|\tif err != nil {\n330|\t\treturn empty, err\n331|\t}\n332|\tif !found {\n333|\t\treceipt, err := encodeBinding(candidate, store.timestamp())\n334|\t\tif err != nil {\n335|\t\t\treturn empty, err\n336|\t\t}\n337|\t\tstored, err = store.installPair(sessionID, operationID, receipt)\n338|\t\tif err != nil {\n339|\t\t\treturn empty, err\n340|\t\t}\n341|\t}\n342|\t// The anchor claim runs on every return path, including the\n343|\t// idempotent replay: a crash between the pair install and\n344|\t// the anchor claim converges on retry.\n345|\tif err := store.ensureFirstFromPair(sessionID, operationID); err != nil {\n346|\t\treturn empty, err\n347|\t}\n348|\treturn stored, nil\n349|}\n350|\n351|// installPair stages the pair receipt and atomically links it to\n352|// the pair path, which must not exist: the link is the no-replace\n353|// commit. Readers see absence or the complete receipt, never a\n354|// torn prefix: a crash before the link leaves only ignored staging\n355|// garbage, and a crash after it leaves the complete receipt the\n356|// identical retry replays. A concurrent same-pair commit wins and\n357|// the loser replays the winner's receipt. Staging garbage from a\n358|// pre-commit crash is swept first.\n359|func (store *Store) installPair(sessionID, operationID string, receipt []byte) (Binding, error) {\n360|\tempty := Binding{}\n361|\tdir := store.receiptsDir(sessionID)\n362|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n363|\t\treturn empty, fmt.Errorf(\"create bootstrap receipts directory: %w\", err)\n364|\t}\n365|\tsweepReceiptsStaging(dir)\n366|\ttarget := store.receiptPath(sessionID, operationID)\n367|\tstaged, err := os.CreateTemp(dir, \"receipt-*.tmp\")\n368|\tif err != nil {\n369|\t\treturn empty, fmt.Errorf(\"stage bootstrap pair receipt: %w\", err)\n370|\t}\n371|\tstagedPath := staged.Name()\n372|\tdefer func() { _ = os.Remove(stagedPath) }()\n373|\tif err := staged.Chmod(0o600); err != nil {\n374|\t\t_ = staged.Close()\n375|\t\treturn empty, fmt.Errorf(\"protect bootstrap pair receipt: %w\", err)\n376|\t}\n377|\tif _, err := staged.Write(receipt); err != nil {\n378|\t\t_ = staged.Close()\n379|\t\treturn empty, fmt.Errorf(\"write bootstrap pair receipt: %w\", err)\n380|\t}\n381|\tif err := staged.Sync(); err != nil {\n382|\t\t_ = staged.Close()\n383|\t\treturn empty, fmt.Errorf(\"sync bootstrap pair receipt: %w\", err)\n384|\t}\n385|\tif err := staged.Close(); err != nil {\n386|\t\treturn empty, fmt.Errorf(\"close bootstrap pair receipt: %w\", err)\n387|\t}\n388|\tif store.hooks != nil && store.hooks.AfterStage != nil {\n389|\t\tif err := store.hooks.AfterStage(stagedPath); err != nil {\n390|\t\t\treturn empty, err\n391|\t\t}\n392|\t}\n393|\tif err := os.Link(stagedPath, target); err != nil {\n394|\t\tif errors.Is(err, os.ErrExist) {\n395|\t\t\t// A concurrent wrapper recorded this pair\n396|\t\t\t// between our Lookup and our link: replay the\n397|\t\t\t// winner's receipt.\n398|\t\t\twinner, found, readErr := store.Lookup(sessionID, operationID)\n399|\t\t\tif readErr != nil {\n400|\t\t\t\treturn empty, readErr\n401|\t\t\t}\n402|\t\t\tif !found {\n403|\t\t\t\treturn empty, errors.New(\"bootstrap pair receipt vanished after concurrent commit\")\n404|\t\t\t}\n405|\t\t\treturn winner, nil\n406|\t\t}\n407|\t\treturn empty, fmt.Errorf(\"install bootstrap pair receipt: %w\", err)\n408|\t}\n409|\t_ = os.Remove(stagedPath)\n410|\tif store.hooks != nil && store.hooks.AfterInstall != nil {\n411|\t\tif err := store.hooks.AfterInstall(target); err != nil {\n412|\t\t\treturn empty, err\n413|\t\t}\n414|\t}\n415|\tif err := syncDirectory(dir); err != nil {\n416|\t\treturn empty, err\n417|\t}\n418|\tif err := syncDirectory(store.sessionDir(sessionID)); err != nil {\n419|\t\treturn empty, err\n420|\t}\n421|\tstored, found, err := store.Lookup(sessionID, operationID)\n422|\tif err != nil {\n423|\t\treturn empty, err\n424|\t}\n425|\tif !found {\n426|\t\treturn empty, errors.New(\"bootstrap pair receipt vanished after install\")\n427|\t}\n428|\treturn stored, nil\n429|}\n430|\n431|// convergePairFromFirst records the pair receipt from the anchor\n432|// bytes after a crash landed between the anchor install and the\n433|// pair install. The anchor names this operation (checked by the\n434|// caller): the pair receipt carries the identical bytes, so the\n435|// anchor and the pair agree byte for byte.\n436|func (store *Store) convergePairFromFirst(sessionID, operationID string) (Binding, error) {\n437|\tempty := Binding{}\n438|\traw, err := os.ReadFile(store.bindingPath(sessionID))\n439|\tif err != nil {\n440|\t\treturn empty, fmt.Errorf(\"read bootstrap binding for pair convergence: %w\", err)\n441|\t}\n442|\tbinding, err := decodeBinding(raw)\n443|\tif err != nil {\n444|\t\treturn empty, err\n445|\t}\n446|\tif binding.SessionID != sessionID || binding.OperationID != operationID {\n447|\t\treturn empty, fmt.Errorf(\"bind anchor names another bootstrap pair\")\n448|\t}\n449|\treturn store.installPair(sessionID, operationID, raw)\n450|}\n451|\n452|// ensureFirstFromPair claims the session's first-binding anchor\n453|// from an already-recorded pair receipt when the anchor is absent.\n454|// The link carries the no-replace guard: a concurrent claim wins\n455|// and this call converges to it. It is a no-op when the anchor\n456|// exists.\n457|func (store *Store) ensureFirstFromPair(sessionID, operationID string) error {\n458|\tif _, err := os.Lstat(store.bindingPath(sessionID)); err == nil {\n459|\t\treturn nil\n460|\t} else if !errors.Is(err, os.ErrNotExist) {\n461|\t\treturn fmt.Errorf(\"stat bootstrap binding: %w\", err)\n462|\t}\n463|\tif err := os.Link(store.receiptPath(sessionID, operationID), store.bindingPath(sessionID)); err != nil {\n464|\t\tif errors.Is(err, os.ErrExist) {\n465|\t\t\treturn nil\n466|\t\t}\n467|\t\treturn fmt.Errorf(\"claim first bootstrap binding: %w\", err)\n468|\t}\n469|\treturn syncDirectory(store.sessionDir(sessionID))\n470|}\n471|\n472|// sweepStaging removes stale binding-*.tmp files left by a\n473|// pre-commit crash. Only files older than a minute are removed: a\n474|// concurrent live wrapper stages under the same pattern, and an\n475|// age gate keeps the sweep from deleting its in-flight receipt. It\n476|// is best-effort: a sweep failure never fails the binding, and\n477|// only the staging pattern is removed.\n478|func sweepStaging(dir string) {\n479|\tsweepStagingPattern(dir, \"binding-*.tmp\")\n480|}\n481|\n482|// sweepReceiptsStaging removes stale receipt-*.tmp files left by a\n483|// pre-commit pair-receipt crash, under the same age gate.\n484|func sweepReceiptsStaging(dir string) {\n485|\tsweepStagingPattern(dir, \"receipt-*.tmp\")\n486|}\n487|\n488|func sweepStagingPattern(dir, pattern string) {\n489|\tmatches, err := filepath.Glob(filepath.Join(dir, pattern))\n490|\tif err != nil {\n491|\t\treturn\n492|\t}\n493|\tcutoff := time.Now().Add(-time.Minute)\n494|\tfor _, match := range matches {\n495|\t\tinfo, err := os.Stat(match)\n496|\t\tif err != nil {\n497|\t\t\tcontinue\n498|\t\t}\n499|\t\tif info.ModTime().After(cutoff) {\n500|\t\t\tcontinue\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
