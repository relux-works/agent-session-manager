{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c97b","stream":{"kind":"session","id":"01a0b194-ebfd-7972-8291-a2a8c88f871f"},"sequence":792,"recorded_at":1780531400001579,"record_type":"event","durability":"durable","causation_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e","run_stream":{"kind":"run","id":"df48a3ca-89bc-4d9a-855b-51fcacb1bf2e"},"task_stream":{"kind":"task","id":"01a0b197-5b60-70d0-8e88-1c9e88fff2ca"},"task_id":"01a0b197-5b60-70d0-8e88-1c9e88fff2ca","event":{"kind":"output","task_id":"01a0b197-5b60-70d0-8e88-1c9e88fff2ca","chunk":"Read text file `internal/axpane/conformance_test.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"os/exec\"\n5|\t\"regexp\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n10|)\n11|\n12|// TestDecideArmPrecedence pins the §4.C wrapper-rule order: with\n13|// every arm faulted at once, the first arm wins. Configuration\n14|// precedes session, which precedes bootstrap idempotency, which\n15|// precedes backend admission, which precedes fencing.\n16|func TestDecideArmPrecedence(t *testing.T) {\n17|\tt.Parallel()\n18|\tdeps := buildDecideDeps(t, true)\n19|\tinput := validInput(t, deps)\n20|\tinput.ConfigErr = errFixtureConfig\n21|\tinput.SessionKnown = false\n22|\tinput.ExistingBinding = &Binding{SessionID: fixtureSession, OperationID: fixtureOtherOp}\n23|\tinput.SessionBound = true\n24|\tinput.Backend.Manifest = []byte(`{\"broken\":true}`)\n25|\tinput.Presented.Epoch = 0\n26|\tdecision := Decide(input)\n27|\tif decision.Action != ActionRefused || decision.Class != ClassInvalidConfig {\n28|\t\tt.Fatalf(\"Decide() all-faulted = (%q, %q), want (refused, invalid_config)\", decision.Action, decision.Class)\n29|\t}\n30|\tinput.ConfigErr = nil\n31|\tdecision = Decide(input)\n32|\tif decision.Action != ActionRefused || decision.Class != ClassInvalidArguments {\n33|\t\tt.Fatalf(\"Decide() peeled-config = (%q, %q), want the session arm\", decision.Action, decision.Class)\n34|\t}\n35|}\n36|\n37|// TestEmitParkedVocabularyLoop authors the locally emittable\n38|// session.parked reasons through the production emission path and\n39|// reads each back with its exact closed payload, and proves the\n40|// remotely held or unverifiable reasons refuse chain emission\n41|// rather than manufacturing a collision. Only a verified,\n42|// locally held winner with a foldable lifecycle authors: stale and\n43|// materialization-based restore_policy emit; remote, unverified,\n44|// and failed-handoff parks refuse.\n45|func TestEmitParkedVocabularyLoop(t *testing.T) {\n46|\tt.Parallel()\n47|\tdeps := buildDecideDeps(t, true)\n48|\t// Move the fixture chain to failed so session.parked folds\n49|\t// (§5.7: only materializing, stopped, failed, or parked park).\n50|\tfailedID := appendChainEvent(t, deps.repo, \"session.failed\", 1, fixtureLeaseA, 2, deps.createdID, map[string]any{\n51|\t\t\"error_code\": \"bootstrap_probe\", \"retryable\": false, \"operation_id\": nil,\n52|\t})\n53|\tnow := fixtureNow()\n54|\tobservation := fixtureObservation(now)\n55|\tpresented := fixturePresented()\n56|\temittable := []struct {\n57|\t\treason fencing.ParkReason\n58|\t\taction Action\n59|\t\tmutate func(*Input)\n60|\t}{\n61|\t\t{fencing.ParkStaleOwner, ActionParked, func(input *Input) { input.Presented.LeaseID = fixtureLeaseB }},\n62|\t\t{fencing.ParkRestorePolicy, ActionParked, func(input *Input) {\n63|\t\t\tinput.MaterializationRequired = true\n64|\t\t\tinput.JournalOK = true\n65|\t\t}},\n66|\t}\n67|\tsequence := uint64(3)\n68|\tpredecessor := failedID\n69|\tfor _, testCase := range emittable {\n70|\t\tinput := validInput(t, deps)\n71|\t\ttestCase.mutate(&input)\n72|\t\tdecision := Decide(input)\n73|\t\tif decision.Action != testCase.action || decision.ParkReason != testCase.reason {\n74|\t\t\tt.Fatalf(\"Decide() = (%q, %q), want (%q, %q)\", decision.Action, decision.ParkReason, testCase.action, testCase.reason)\n75|\t\t}\n76|\t\treference, _, err := EmitParked(deps.repo, decision, EmitParams{\n77|\t\t\tSessionID: fixtureSession, CreatedByHost: fixtureLocalHost,\n78|\t\t\tLeaseEpoch: 1, LeaseID: fixtureLeaseA, LeaseSequence: sequence,\n79|\t\t\tPredecessors: []string{predecessor}, CreatedAt: fixtureCreatedAt,\n80|\t\t\tPresented: presented, Observation: observation,\n81|\t\t})\n82|\t\tif err != nil {\n83|\t\t\tt.Fatalf(\"EmitParked(%q) error = %v\", testCase.reason, err)\n84|\t\t}\n85|\t\tstored, err := deps.repo.GetEvent(fixtureSession, reference.EventID)\n86|\t\tif err != nil {\n87|\t\t\tt.Fatal(err)\n88|\t\t}\n89|\t\tif !strings.Contains(string(stored), `\"reason\":\"`+string(testCase.reason)+`\"`) {\n90|\t\t\tt.Fatalf(\"parked event for %q carries no reason member: %s\", testCase.reason, stored)\n91|\t\t}\n92|\t\tsequence++\n93|\t\tpredecessor = reference.EventID\n94|\t}\n95|\trefusing := []struct {\n96|\t\tname    string\n97|\t\treason  fencing.ParkReason\n98|\t\taction  Action\n99|\t\tmutate  func(*Input)\n100|\t\tobserve func(*fencing.Observation)\n101|\t}{\n102|\t\t{\"remote_owner\", fencing.ParkRemoteOwner, ActionAttachRemote,\n103|\t\t\tfunc(input *Input) { input.Observation.Winner.HolderHostID = fixtureRemoteHost },\n104|\t\t\tfunc(obs *fencing.Observation) { obs.Winner.HolderHostID = fixtureRemoteHost }},\n105|\t\t{\"unverified\", fencing.ParkRestorePolicy, ActionParked,\n106|\t\t\tfunc(input *Input) { input.Observation.Verified = false },\n107|\t\t\tfunc(obs *fencing.Observation) { obs.Verified = false }},\n108|\t\t{\"failed_handoff\", fencing.ParkFailedHandoff, ActionParked,\n109|\t\t\tfunc(input *Input) { input.Observation.HandoffFailed = true },\n110|\t\t\tfunc(obs *fencing.Observation) { obs.HandoffFailed = true }},\n111|\t}\n112|\tfor _, testCase := range refusing {\n113|\t\tt.Run(\"refuses_\"+testCase.name, func(t *testing.T) {\n114|\t\t\tt.Parallel()\n115|\t\t\tnested := buildDecideDeps(t, true)\n116|\t\t\tnestedFailed := appendChainEvent(t, nested.repo, \"session.failed\", 1, fixtureLeaseA, 2, nested.createdID, map[string]any{\n117|\t\t\t\t\"error_code\": \"bootstrap_probe\", \"retryable\": false, \"operation_id\": nil,\n118|\t\t\t})\n119|\t\t\tinput := validInput(t, nested)\n120|\t\t\ttestCase.mutate(&input)\n121|\t\t\tdecision := Decide(input)\n122|\t\t\tif decision.Action != testCase.action || decision.ParkReason != testCase.reason {\n123|\t\t\t\tt.Fatalf(\"Decide() = (%q, %q), want (%q, %q)\", decision.Action, decision.ParkReason, testCase.action, testCase.reason)\n124|\t\t\t}\n125|\t\t\trefusingObs := fixtureObservation(fixtureNow())\n126|\t\t\ttestCase.observe(&refusingObs)\n127|\t\t\tif _, _, err := EmitParked(nested.repo, decision, EmitParams{\n128|\t\t\t\tSessionID: fixtureSession, CreatedByHost: fixtureLocalHost,\n129|\t\t\t\tLeaseEpoch: 1, LeaseID: fixtureLeaseA, LeaseSequence: 3,\n130|\t\t\t\tPredecessors: []string{nestedFailed}, CreatedAt: fixtureCreatedAt,\n131|\t\t\t\tPresented: fixturePresented(), Observation: refusingObs,\n132|\t\t\t}); err == nil {\n133|\t\t\t\tt.Fatalf(\"EmitParked(%q) succeeded under a non-held lease, want refusal\", testCase.reason)\n134|\t\t\t}\n135|\t\t})\n136|\t}\n137|}\n138|\n139|// TestLaunchCarriesValidatedPlan pins the §13.1 step-4 surface the\n140|// wrapper hands to the later provider-launch leaf: the resolved\n141|// adapter mapping, the admitted §7.A descriptor, and the sealed\n142|// fencing token travel together on every launch, and no launch\n143|// ships a partial plan.\n144|func TestLaunchCarriesValidatedPlan(t *testing.T) {\n145|\tt.Parallel()\n146|\tdeps := buildDecideDeps(t, true)\n147|\tdecision := Decide(validInput(t, deps))\n148|\tif decision.Action != ActionLaunch {\n149|\t\tt.Fatalf(\"Decide() action = %q, want launch\", decision.Action)\n150|\t}\n151|\tif !decision.HasToken {\n152|\t\tt.Fatal(\"launch carries no fencing token\")\n153|\t}\n154|\tif decision.Descriptor.TerminalInstanceID == \"\" {\n155|\t\tt.Fatal(\"launch carries no admitted descriptor\")\n156|\t}\n157|\tif len(decision.Admitted.Capabilities) == 0 {\n158|\t\tt.Fatal(\"launch carries no admitted capabilities\")\n159|\t}\n160|}\n161|\n162|// TestConformanceMatrixCompleteness enumerates the pinned clauses\n163|// and the named top-level test that drives each through a\n164|// production entry, then verifies every named test exists in this\n165|// package through the go list entry. A row fails if its test is\n166|// removed or renamed without updating the matrix; subtest rows in\n167|// TRACEABILITY.md refine these top-level drivers.\n168|func TestConformanceMatrixCompleteness(t *testing.T) {\n169|\tt.Parallel()\n170|\trows := []struct {\n171|\t\tclause string\n172|\t\ttest   string\n173|\t}{\n174|\t\t{\"4.B manifest/probe/evidence identity\", \"TestDecideLaunchPositive\"},\n175|\t\t{\"4.B mismatch fails before activation\", \"TestDecideTable\"},\n176|\t\t{\"4.C wrapper rule order\", \"TestDecideArmPrecedence\"},\n177|\t\t{\"4.C bootstrap idempotency mismatch\", \"TestDecideTable\"},\n178|\t\t{\"4.C identical retry reattaches\", \"TestBindIdenticalRetryReattaches\"},\n179|\t\t{\"4.C concurrent commit reattaches\", \"TestBindConcurrentSameOperationReattaches\"},\n180|\t\t{\"4.C status proves absence\", \"TestBindInstallsAndStatusProves\"},\n181|\t\t{\"4.C unknown is not absent\", \"TestStatusUnknownIsNotAbsent\"},\n182|\t\t{\"4.C no PID persisted\", \"TestBindingPersistsNoPID\"},\n183|\t\t{\"4.C crash at the binding seam\", \"TestBindCrashChildSelfTerminates\"},\n184|\t\t{\"4.C per-pair receipt retention\", \"TestRunSupersededPairIdenticalRetry\"},\n185|\t\t{\"4.C create from stopped post-window\", \"TestRunCreateFromStoppedPostWindow\"},\n186|\t\t{\"4.C credential conditional every caller\", \"TestDecideForegroundCredentialRequiresRealm\"},\n187|\t\t{\"4.D only admitted rows authorize\", \"TestDecideTable\"},\n188|\t\t{\"4.2 background caller capability_unavailable\", \"TestDecideTypedRefusals\"},\n189|\t\t{\"4.2 cached evidence never authorizes\", \"TestRealmCarriesNoCachedEvidence\"},\n190|\t\t{\"4.2 dead realm row typed refusal\", \"TestDecideExpiredRealmRowRefusesUnavailable\"},\n191|\t\t{\"4.2 realm evidence order independent\", \"TestDecideRealmEvidenceOrderIndependent\"},\n192|\t\t{\"4.2 after-restore sequence\", \"TestDecideAfterRestoreSequence\"},\n193|\t\t{\"5.7 newest checkpoint gates resume\", \"TestRunEpochOneOwnerAfterCheckpoint\"},\n194|\t\t{\"5.2 session.parked vocabulary\", \"TestEmitParkedVocabularyLoop\"},\n195|\t\t{\"5.2 parked emission under lease\", \"TestEmitParkedRoundTrip\"},\n196|\t\t{\"5.2 v4 terminal payloads\", \"TestEmitTerminalV4RoundTrip\"},\n197|\t\t{\"7.A descriptor build and admit\", \"TestDescriptorBuildAdmitRoundTrip\"},\n198|\t\t{\"7.A descriptor mismatch refuses\", \"TestDescriptorMismatchRefuses\"},\n199|\t\t{\"7.A generation bounds\", \"TestDescriptorGenerationBounds\"},\n200|\t\t{\"7.A token passed separately\", \"TestDecideForgedTokensRefuse\"},\n201|\t\t{\"13.1 step 3 durable terminal entry\", \"TestRunLaunchBinds\"},\n202|\t\t{\"13.1 step 4 validated plan\", \"TestLaunchCarriesValidatedPlan\"},\n203|\t\t{\"2.4 effective profile and source\", \"TestDecideProfileSourcePinsEvent\"},\n204|\t\t{\"2.4 mapping refusal\", \"TestDecideYoloMapping\"},\n205|\t\t{\"2.4 unknown checkpoint store fails\", \"TestRunNoCkptStoreWinnerCheckpointFails\"},\n206|\t\t{\"orchestrated launch/reattach/park/refuse\", \"TestRunParkedEmits\"},\n207|\t\t{\"ownership observation over leases\", \"TestObserveLoadsWinningLease\"},\n208|\t}\n209|\tlisted, err := exec.Command(\"go\", \"test\", \".\", \"-list\", \".\", \"-count=1\").CombinedOutput()\n210|\tif err != nil {\n211|\t\tt.Fatalf(\"go test -list error = %v: %s\", err, listed)\n212|\t}\n213|\tpresent := map[string]bool{}\n214|\tfor _, line := range strings.Split(string(listed), \"\\n\") {\n215|\t\tmatched, _ := regexp.MatchString(`^Test[A-Za-z0-9_]+$`, strings.TrimSpace(line))\n216|\t\tif matched {\n217|\t\t\tpresent[strings.TrimSpace(line)] = true\n218|\t\t}\n219|\t}\n220|\tif len(present) == 0 {\n221|\t\tt.Fatalf(\"go test -list found no tests: %s\", listed)\n222|\t}\n223|\tfor _, row := range rows {\n224|\t\tif !present[row.test] {\n225|\t\t\tt.Errorf(\"clause %q names missing test %q\", row.clause, row.test)\n226|\t\t}\n227|\t}\n228|\tt.Logf(\"%d pinned clauses mapped to named tests\", len(rows))\n229|}","final_result":true}}}
