, directory, and name facts.\\ntype sessionView struct {\\n\\tdirectory string\\n\\trecord    sessionRecord\\n\\tchain     storedChain\\n}\\n\\n// decodeSessionRecord runs the three validation layers in order: strict\\n// frame (environ owner), member shape, then canonical identity and closed\\n// shape (canonicaljson owner). Each layer refuses before the next runs,\\n// so every site below is reachable with a vector that clears the earlier\\n// layers and fails exactly this one.\\n====\\n46:// SelfField is one of the pinned AX immutable-object self-identity namespaces.\\n49:type SelfField string\\n52:\\tSelfRecordID                   SelfField = \\\"record_id\\\"\\n53:\\tSelfEventID                    SelfField = \\\"event_id\\\"\\n54:\\tSelfCheckpointID               SelfField = \\\"checkpoint_id\\\"\\n55:\\tSelfDescriptorID               SelfField = \\\"descriptor_id\\\"\\n56:\\tSelfManifestID                 SelfField = \\\"manifest_id\\\"\\n57:\\tSelfPlanID                     SelfField = \\\"plan_id\\\"\\n58:\\tSelfTombstoneID                SelfField = \\\"tombstone_id\\\"\\n59:\\tSelfAckID                      SelfField = \\\"ack_id\\\"\\n====\\ninternal/sessrepo/sessrepo_test.go:143:func buildEvent(t *testing.T, options eventOptions) []byte {\\ninternal/sessprofile/fixtures_test.go:135:func buildEvent(t *testing.T, options eventOptions) []byte {\\n\",\n  \"original_output_bytes\": 2058,\n  \"original_output_tokens\": 515,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
