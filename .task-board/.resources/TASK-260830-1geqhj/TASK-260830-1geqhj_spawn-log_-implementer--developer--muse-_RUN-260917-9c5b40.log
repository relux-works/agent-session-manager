{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5bb","stream":{"kind":"session","id":"01a0b01d-784f-7181-a3b3-aa8522f5745f"},"sequence":312,"recorded_at":1780531400000619,"record_type":"event","durability":"durable","causation_id":"5349c8a7-2a8a-407b-af90-af29b38e6bc7","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5349c8a7-2a8a-407b-af90-af29b38e6bc7","run_stream":{"kind":"run","id":"5349c8a7-2a8a-407b-af90-af29b38e6bc7"},"call_id":"call_01a0b01e29fa74c89965f6f0d5610798","text":"{\n  \"chunk_id\": \"exec-7-1\",\n  \"command\": \"head -80 internal/fencing/doc.go; echo =====; grep -n \\\"^func \\\\|^type \\\" internal/fencing/gate.go internal/fencing/token.go | head -40\",\n  \"description\": \"Survey fencing gate API\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"// Package fencing gates every activation-class action on the winning\\n// lease and the exact fencing epoch.\\n//\\n// Normative scope: AX v0.6.0 Section 2.2 global invariants (the winning\\n// committed lease is the only authority that may create a destination\\n// runtime; a fencing token is the winning lease_id + epoch pair carried\\n// by every owner-authored event and mutation; force takeover fences the\\n// prior owner logically), Section 5.3 Lease Record (epoch, predecessor,\\n// holder, fencing token, revalidation before input, turn, checkpoint,\\n// push, and resume), Sections 13.6-13.10 (graceful takeover, force\\n// takeover, fork, stop, resume: which steps require the winning lease\\n// and the exact epoch), the Section 4 terminal wrapper rule (compare the\\n// local fencing token before launching a provider; park safely when\\n// ownership is remote, ambiguous, or unverified), and the Section 7.5\\n// Provider Protocol LeaseToken carried by quiesce, capture, and\\n// materialize operations.\\n//\\n// Division of authority (no second lease model):\\n//\\n//   - The Lease Record shape, identity, and lifecycle (CreateLease,\\n//     CompareAndSwapLease, WinningLease, VerifyFencingToken,\\n//     CheckFencingExpiry, CompareLeaseTuple) are owned by\\n//     internal/sessrepo. This package never mints, persists, orders, or\\n//     revalidates a lease itself: Observe loads the winning summary\\n//     through ListLeases, and the expiry arm calls CheckFencingExpiry.\\n//   - The winning-tuple rule is owned by internal/sessstate (Compare).\\n//     This package never compares two leases against each other; it\\n//     compares one presented token for exact equality with the one\\n//     winning summary the store reports.\\n//   - Takeover, fork, stop, and resume transactions, terminal backends,\\n//     and provider plugin processes are callers, not members: the gates\\n//     model their entry points (AuthorizeActivation, AuthorizeInput,\\n//     AuthorizeMutation, AuthorizeCheckpoint, AuthorizeRestore,\\n//     AuthorizeTerminateStale) and the callers report their own sync,\\n//     handoff, and grant facts through Observation.\\n//\\n// The gates are pure over durable inputs: they perform no writes, hold\\n// no cache, and read no clock except the Now the caller supplies, so\\n// there is no crash seam and no idempotency hazard to evidence beyond\\n// the no-write test. Every refusal carries a Section 15 registered code\\n// and nothing else: lease_conflict, not_owner, and stale_owner at exit\\n// 10, invalid_arguments at exit 2, and local_precondition_failed at exit\\n// 3. Launch-class entries (activation, restore) park instead of refusing\\n// when ownership is remote, ambiguous, unverified, or absent, carrying\\n// the Section 5.2 session.parked vocabulary\\n// (remote_owner|stale_owner|restore_policy|failed_handoff) with the\\n// winning lease ID; every other entry refuses outright.\\npackage fencing\\n=====\\ninternal/fencing/gate.go:54:type ParkReason string\\ninternal/fencing/gate.go:75:type parkRefusal struct {\\ninternal/fencing/gate.go:81:func (refusal *parkRefusal) Error() string {\\ninternal/fencing/gate.go:88:func (refusal *parkRefusal) Unwrap() []error {\\ninternal/fencing/gate.go:95:func IsParked(err error) bool {\\ninternal/fencing/gate.go:102:func ParkDetails(err error) (ParkReason, string, bool) {\\ninternal/fencing/gate.go:113:func park(reason ParkReason, winningLeaseID string, cause error) error {\\ninternal/fencing/gate.go:118:type Operation string\\ninternal/fencing/gate.go:141:func validOperation(op Operation) bool {\\ninternal/fencing/gate.go:152:func launchClass(op Operation) bool {\\ninternal/fencing/gate.go:160:type PresentedToken struct {\\ninternal/fencing/gate.go:171:type Observation struct {\\ninternal/fencing/gate.go:207:type ObserveInput struct {\\ninternal/fencing/gate.go:226:func Observe(repository *sessrepo.Repository, sessionID string, input ObserveInput) (Observation, error) {\\ninternal/fencing/gate.go:251:func AuthorizeActivation(presented PresentedToken, observation Observation) (LeaseToken, error) {\\ninternal/fencing/gate.go:257:func AuthorizeInput(presented PresentedToken, observation Observation) (LeaseToken, error) {\\ninternal/fencing/gate.go:263:func AuthorizeMutation(presented PresentedToken, observation Observation) (LeaseToken, error) {\\ninternal/fencing/gate.go:269:func AuthorizeCheckpoint(presented PresentedToken, observation Observation) (LeaseToken, error) {\\ninternal/fencing/gate.go:275:func AuthorizeRestore(presented PresentedToken, observation Observation) (LeaseToken, error) {\\ninternal/fencing/gate.go:295:func Authorize(operation Operation, presented PresentedToken, observation Observation) (LeaseToken, error) {\\ninternal/fencing/gate.go:381:func validLeaseID(id string) bool {\\ninternal/fencing/gate.go:389:func validHostID(id string) bool {\\ninternal/fencing/token.go:9:type leaseSealToken struct{}\\ninternal/fencing/token.go:15:type leaseSeal struct {\\ninternal/fencing/token.go:27:type LeaseToken struct {\\ninternal/fencing/token.go:34:func mintLeaseToken(