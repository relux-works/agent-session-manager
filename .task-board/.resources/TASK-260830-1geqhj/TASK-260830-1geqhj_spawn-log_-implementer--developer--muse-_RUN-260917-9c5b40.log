{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d305","stream":{"kind":"session","id":"01a0b01d-784f-7181-a3b3-aa8522f5745f"},"sequence":2013,"recorded_at":1780531400004021,"record_type":"event","durability":"durable","causation_id":"5349c8a7-2a8a-407b-af90-af29b38e6bc7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5349c8a7-2a8a-407b-af90-af29b38e6bc7","run_stream":{"kind":"run","id":"5349c8a7-2a8a-407b-af90-af29b38e6bc7"},"task_stream":{"kind":"task","id":"01a0b02c-1f7a-7e60-960c-f84fa32bcd29"},"task_id":"01a0b02c-1f7a-7e60-960c-f84fa32bcd29","event":{"kind":"output","task_id":"01a0b02c-1f7a-7e60-960c-f84fa32bcd29","chunk":"{\n  \"chunk_id\": \"exec-65-1\",\n  \"command\": \"sed -n '240,395p' internal/terminalbackend/manifest_test.go\",\n  \"description\": \"Read universe manifest probe evidence maps\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"\\tt.Helper()\\n\\n\\tuniverse := &fixtureUniverse{\\n\\t\\trawGeneration: \\\"generation-alpha\\\",\\n\\t\\tfixtureID:     testSeedDigest(0xF1),\\n\\t\\tissuerID:      testSeedDigest(0x1D),\\n\\t\\tnow:           time.Date(2026, time.January, 20, 0, 0, 0, 0, time.UTC),\\n\\t\\tkey:           testKey(t),\\n\\t\\tevidenceByCap: make(map[string]map[string]any),\\n\\t}\\n\\tdigest, err := terminalbackend.GenerationDigest(universe.rawGeneration)\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"GenerationDigest() error = %v\\\", err)\\n\\t}\\n\\tuniverse.generationDigest = digest\\n\\n\\tuniverse.manifest = map[string]any{\\n\\t\\t\\\"schema\\\":                 terminalbackend.SchemaManifest,\\n\\t\\t\\\"schema_version\\\":         \\\"1.0.0\\\",\\n\\t\\t\\\"manifest_id\\\":            \\\"\\\",\\n\\t\\t\\\"terminal_backend_id\\\":    terminalbackend.BuiltinTmux,\\n\\t\\t\\\"implementation_version\\\": \\\"2.1.0\\\",\\n\\t\\t\\\"protocol_versions\\\":      []any{\\\"1.0.0\\\", \\\"1.1.0\\\"},\\n\\t\\t\\\"platforms\\\":    