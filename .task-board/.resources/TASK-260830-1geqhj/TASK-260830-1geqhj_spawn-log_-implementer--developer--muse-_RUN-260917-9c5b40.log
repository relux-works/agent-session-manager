{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cde7","stream":{"kind":"session","id":"01a0b01d-784f-7181-a3b3-aa8522f5745f"},"sequence":1358,"recorded_at":1780531400002711,"record_type":"event","durability":"durable","causation_id":"5349c8a7-2a8a-407b-af90-af29b38e6bc7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5349c8a7-2a8a-407b-af90-af29b38e6bc7","run_stream":{"kind":"run","id":"5349c8a7-2a8a-407b-af90-af29b38e6bc7"},"task_stream":{"kind":"task","id":"01a0b027-165b-7e12-ae92-9ccf48938d37"},"task_id":"01a0b027-165b-7e12-ae92-9ccf48938d37","event":{"kind":"output","task_id":"01a0b027-165b-7e12-ae92-9ccf48938d37","chunk":"edited\nchanged lines: lines 563-605\n--- original\n+++ updated\n@@\n-// checkRealm enforces the §4.2 background-caller rule: a background\n-// caller may contact an already-running authenticated Aqua broker\n-// and its attested AX tmux server, and otherwise returns\n-// capability_unavailable with typed realm/readiness details. It\n-// never falls back to direct server creation. A foreground caller\n-// passes; there is no cached-sentinel or managername arm to pass\n-// through, because neither authorizes resume.\n-func checkRealm(input Input) *axerror.Error {\n-\tif input.Realm.Caller != CallerBackground {\n-\t\treturn nil\n-\t}\n-\tif input.Realm.AttestedServer {\n-\t\treturn nil\n-\t}\n-\tevidence := axerror.RealmEvidence{\n-\t\tCapability:           \"credential_capable_execution_realm\",\n-\t\tCallerRealm:          input.Realm.Caller,\n-\t\tBrokerState:          input.Realm.BrokerState,\n-\t\tTmuxServerGeneration: input.Realm.ServerGeneration,\n-\t\tRemediation:          input.Realm.Remediation,\n-\t}\n-\tfailure, err := axerror.NewRealmEvidenceUnavailable(axerror.Version130,\n-\t\t\"background caller has no attested tmux server\",\n-\t\taxerror.NoIDs(), evidence, errNoAttestedServer())\n-\tif err != nil {\n-\t\t// Typed details are required input members; an input that\n-\t\t// omits one cannot produce the typed refusal, so the\n-\t\t// refusal degrades to the malformed-call class rather\n-\t\t// than inventing an untyped capability_unavailable.\n-\t\tdegraded, degradeErr := axerror.New(axerror.Spec{\n-\t\t\tVersion: axerror.Version130,\n-\t\t\tCode:    ClassInvalidArguments,\n-\t\t\tMessage: \"background caller realm details are incomplete\",\n-\t\t\tIDs:     axerror.NoIDs(),\n-\t\t})\n-\t\tif degradeErr != nil {\n-\t\t\treturn nil\n-\t\t}\n-\t\t_ = err\n-\t\treturn degraded\n-\t}\n-\treturn failure\n-}\n+// checkRealm enforces the §4.2 background-caller rule: a background\n+// caller may contact an already-running authenticated Aqua broker\n+// and its attested AX tmux server, and otherwise returns\n+// capability_unavailable with typed realm/readiness details. It\n+// never falls back to direct server creation. A foreground caller\n+// passes; there is no cached-sentinel or managername arm to pass\n+// through, because neither authorizes resume. Typed details are\n+// required input members: an input that omits one is itself\n+// malformed and refuses invalid_arguments instead of emitting an\n+// untyped capability_unavailable.\n+func checkRealm(input Input) error {\n+\tif input.Realm.Caller != CallerBackground {\n+\t\treturn nil\n+\t}\n+\tif input.Realm.AttestedServer {\n+\t\treturn nil\n+\t}\n+\tevidence := axerror.RealmEvidence{\n+\t\tCapability:           \"credential_capable_execution_realm\",\n+\t\tCallerRealm:          input.Realm.Caller,\n+\t\tBrokerState:          input.Realm.BrokerState,\n+\t\tTmuxServerGeneration: input.Realm.ServerGeneration,\n+\t\tRemediation:          input.Realm.Remediation,\n+\t}\n+\tfailure, err := axerror.NewRealmEvidenceUnavailable(axerror.Version130,\n+\t\t\"background caller has no attested tmux server\",\n+\t\taxerror.NoIDs(), evidence, errNoAttestedServer())\n+\tif err != nil {\n+\t\treturn errInvalidArguments{detail: \"background caller realm details are incomplete\"}\n+\t}\n+\treturn failure\n+}\n","final_result":true}}}
