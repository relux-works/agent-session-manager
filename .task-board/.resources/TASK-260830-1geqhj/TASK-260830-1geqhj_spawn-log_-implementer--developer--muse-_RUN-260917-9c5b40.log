n131|\t}\n132|\tif found {\n133|\t\tduplicate := existing\n134|\t\tinput.ExistingBinding = &duplicate\n135|\t}\n136|\n137|\tvar observation fencing.Observation\n138|\tif known {\n139|\t\tobserved, err := ObserveOwnership(stores.Repo, request.SessionID, request.Observe)\n140|\t\tif err != nil {\n141|\t\t\treturn empty, err\n142|\t\t}\n143|\t\tobservation = observed\n144|\t}\n145|\tinput.Observation = observation\n146|\n147|\tif request.MaterializationRequired {\n148|\t\tif stores.Mat == nil {\n149|\t\t\treturn empty, fmt.Errorf(\"axpane run requires a materialization with no journal store\")\n150|\t\t}\n151|\t\tjournal, admitted, err := LoadMaterialization(stores.Mat, request.MaterializationID)\n152|\t\tif err != nil {\n153|\t\t\treturn empty, err\n154|\t\t}\n155|\t\tinput.Journal = journal\n156|\t\tinput.JournalOK = admitted\n157|\t}\n158|\tif request.CheckpointRequired {\n159|\t\tif stores.Ckpt == nil {\n160|\t\t\treturn empty, fmt.Errorf(\"axpane run requires a checkpoint with no checkpoint store\")\n161|\t\t}\n162|\t\tdoc, err := LoadCheckpoint(stores.Ckpt, request.CheckpointID)\n163|\t\tif err != nil {\n164|\t\t\treturn empty, err\n165|\t\t}\n166|\t\tinput.CheckpointDoc = doc\n167|\t}\n168|\tif known {\n169|\t\trecord, events, err := LoadProfile(stores.Repo, request.SessionID)\n170|\t\tif err != nil {\n171|\t\t\treturn empty, err\n172|\t\t}\n173|\t\tinput.ProfileRecord = record\n174|\t\tinput.ProfileEvents = events\n175|\t}\n176|\n177|\tinstance := request.InstanceID\n178|\tif instance == \"\" {\n179|\t\tminted, err := MintInstanceIDRandom()\n180|\t\tif err != nil {\n181|\t\t\treturn empty, err\n182|\t\t}\n183|\t\tinstance = minted\n184|\t}\n185|\tdescriptorDoc, err := BuildDescriptor(DescriptorParams{\n186|\t\tBinding: BindingRef{\n187|\t\t\tBindingDigest:         request.HostBinding.TerminalBindingID,\n188|\t\t\tBackendID:             request.HostBinding.BackendID,\n189|\t\t\tImplementationVersion: request.HostBinding.ImplementationVersion,\n190|\t\t\tProtocolVersion:       request.HostBinding.ProtocolVersion,\n191|\t\t\tGeneration:            request.HostBinding.Generation,\n192|\t\t},\n193|\t\tInstanceID:  instance,\n194|\t\tInteractive: request.Interactive,\n195|\t\tColumns:     request.Columns,\n196|\t\tRows:        request.Rows,\n197|\t})\n198|\tif err != nil {\n199|\t\treturn empty, err\n200|\t}\n201|\tinput.Descriptor = descriptorDoc\n202|\n203|\tdecision := Decide(input)\n204|\toutcome := Outcome{Decision: decision}\n205|\tswitch decision.Action {\n206|\tcase ActionLaunch:\n207|\t\tcandidate := Binding{\n208|\t\t\tSessionID:          request.SessionID,\n209|\t\t\tOperationID:        request.BootstrapOperationID,\n210|\t\t\tTerminalInstanceID: instance,\n211|\t\t}\n212|\t\tcandidate.BindingDigest = BindingDigest(candidate)\n213|\t\tbound, reattached, err := stores.Pane.WithHooks(request.Hooks).Bind(request.SessionID, request.BootstrapOperationID, candidate)\n214|\t\tif err != nil {\n215|\t\t\treturn empty, err\n216|\t\t}\n217|\t\tif reattached {\n218|\t\t\t// A concurrent wrapper won the bind between Status\n219|\t\t\t// and Bind: the pair is bound, so this run\n220|\t\t\t// reattaches to the recorded child instead of\n221|\t\t\t// launching a second one.\n222|\t\t\toutcome.Decision.Action = ActionReattach\n223|\t\t\toutcome.Decision.Detail = \"reattach to the one recorded wrapper/child\"\n224|\t\t}\n225|\t\tduplicate := bound\n226|\t\toutcome.Binding = &duplicate\n227|\tcase ActionReattach:\n228|\t\tduplicate := *input.ExistingBinding\n229|\t\toutcome.Binding = &duplicate\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
