testCheckpointRecord(raw []byte) (scalar.Digest, canonicaljson.SelfField, error) {\\n\\treturn canonicaljson.VerifyObjectIdentity(raw)\\n}\\n====\\n1341:var authorityTransitions = map[string][]string{\\n1342-\\tAuthorityStaging:  {AuthorityPrepared, AuthorityRolledBack},\\n1343-\\tAuthorityPrepared: {AuthorityCommitted, AuthorityRolledBack},\\n1344-}\\n1345-\\n1346-// legalAuthorityTransition reports whether the authority edge exists.\\n1347-// A same-state update is not a transition and is always allowed.\\n1348-func legalAuthorityTransition(from, to string) bool {\\n1349-\\tif from == to {\\n1350-\\t\\treturn true\\n1351-\\t}\\n\",\n  \"original_output_bytes\": 1628,\n  \"original_output_tokens\": 407,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
