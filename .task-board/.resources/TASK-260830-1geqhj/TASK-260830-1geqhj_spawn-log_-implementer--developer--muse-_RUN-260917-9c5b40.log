{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000eef7","stream":{"kind":"session","id":"01a0b01d-784f-7181-a3b3-aa8522f5745f"},"sequence":5590,"recorded_at":1780531400011175,"record_type":"event","durability":"durable","causation_id":"5349c8a7-2a8a-407b-af90-af29b38e6bc7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5349c8a7-2a8a-407b-af90-af29b38e6bc7","run_stream":{"kind":"run","id":"5349c8a7-2a8a-407b-af90-af29b38e6bc7"},"task_stream":{"kind":"task","id":"01a0b057-94fa-72e3-ae79-267bc415357a"},"task_id":"01a0b057-94fa-72e3-ae79-267bc415357a","event":{"kind":"output","task_id":"01a0b057-94fa-72e3-ae79-267bc415357a","chunk":"Read text file `internal/axpane/decide.go`.\n(298 line(s) above)\n299|// Decide is the pure wrapper core: configuration, session, bootstrap\n300|// idempotency, backend identity and capability admission, fencing,\n301|// materialization, checkpoint, provider identity, provider-auth\n302|// smoke, profile derivation and mapping, realm readiness,\n303|// entrypoint, and provider descriptor, in that precedence, then the\n304|// outcome selection. The tuple gate precedes mapping so a tuple\n305|// refusal keeps its own class instead of wearing\n306|// profile_mapping_unavailable. Decide performs no I/O, reads no\n307|// clock except the instants the input carries, and mints no lease,\n308|// binding, or event: Run owns the durable effects. Every refusal\n309|// carries the Section 15 code the arm names; every park carries the\n310|// session.parked vocabulary.\n311|func Decide(input Input) Decision {\n312|\tif input.ConfigErr != nil {\n313|\t\treturn refused(ClassInvalidConfig, \"configuration is invalid\", input.ConfigErr)\n314|\t}\n315|\tif input.Mode != ModeLaunch && input.Mode != ModeRestore {\n316|\t\treturn refused(ClassInvalidArguments, \"wrapper mode is not launch or restore\", errWrapperMode(input.Mode))\n317|\t}\n318|\tif !input.SessionKnown {\n319|\t\treturn refused(ClassInvalidArguments, \"logical session is unknown\", errUnknownSession(input.SessionID))\n320|\t}\n321|\tif input.ExistingBinding != nil && input.ExistingBinding.OperationID != input.BootstrapOperationID {\n322|\t\treturn refused(terminalbackend.CodeIdempotencyMismatch,\n323|\t\t\t\"bootstrap operation changed inside the bootstrap window\",\n324|\t\t\terrIdempotencyChanged(input.SessionID))\n325|\t}\n326|\tif err := checkRealmVocabulary(input.Realm.Caller); err != nil {\n327|\t\treturn refused(ClassInvalidArguments, \"caller realm is not foreground or background\", err)\n328|\t}\n329|\n330|\tadmitted, err := admitBackend(input)\n331|\tif err != nil {\n332|\t\treturn refused(backendClass(err), \"terminal backend identity or capability admission failed\", err)\n333|\t}\n334|\n335|\ttoken, err := authorize(input)\n336|\tif err != nil {\n337|\t\tif fencing.IsParked(err) {\n338|\t\t\treason, winning, _ := fencing.ParkDetails(err)\n339|\t\t\treturn decideParked(input, admitted, reason, winning, err)\n340|\t\t}\n341|\t\treturn refused(fencingClass(err), \"fencing refused the wrapper\", err)\n342|\t}\n343|\n344|\tif input.MaterializationRequired && (!input.JournalOK || input.Journal.Phase != matjournal.PhaseCommitted) {\n345|\t\treturn parked(fencing.ParkRestorePolicy, input.Observation.Winner.LeaseID,\n346|\t\t\terrMaterializationNotValid(input.Journal.Phase, input.JournalOK))\n347|\t}\n348|\tif input.CheckpointRequired {\n349|\t\tif err := admitCheckpoint(input.CheckpointDoc, input.CheckpointID); err != nil {\n350|\t\t\treturn parked(fencing.ParkRestorePolicy, input.Observation.Winner.LeaseID, err)\n351|\t\t}\n352|\t}\n353|\n354|\tif err := checkProviderIdentity(input.Provider); err != nil {\n355|\t\treturn refused(providerClass(err), \"provider identity is unresolved\", err)\n356|\t}\n357|\tif err := checkSmoke(input); err != nil {\n358|\t\tdecision := refused(smokeClass(err), \"provider-auth smoke precondition failed\", err)\n359|\t\tvar typed *axerror.Error\n360|\t\tif errors.As(err, &typed) {\n361|\t\t\tdecision.RealmFailure = typed\n362|\t\t}\n363|\t\treturn decision\n364|\t}\n365|\tif err := checkRealm(input); err != nil {\n366|\t\tvar malformed errInvalidArguments\n367|\t\tif errors.As(err, &malformed) {\n368|\t\t\treturn refused(ClassInvalidArguments, \"background caller realm details are incomplete\", err)\n369|\t\t}\n370|\t\tvar typed *axerror.Error\n371|\t\tif errors.As(err, &typed) {\n372|\t\t\tdecision := refused(string(typed.Code()), \"background caller has no attested server\", err)\n373|\t\t\tdecision.RealmFailure = typed\n374|\t\t\treturn decision\n375|\t\t}\n376|\t\treturn refused(ClassInvalidArguments, \"background caller realm is unverifiable\", err)\n377|\t}\n378|\tpair, err := sessprofile.Derive(input.ProfileRecord, input.ProfileEvents)\n379|\tif err != nil {\n380|\t\treturn refused(ClassIntegrityFailure, \"effective profile derivation failed\", err)\n381|\t}\n382|\t// The tuple gate above already admitted the probed build, so a\n383|\t// ResolveMapping failure here is the mapping gap Section 2.4\n384|\t// names, never a tuple refusal wearing the mapping class.\n385|\tresolved, err := provhost.ResolveMapping(input.Provider.Build.ProviderID, pair.Profile, input.Provider.Build)\n386|\tif err != nil {\n387|\t\treturn refused(ClassProfileMappingUnavailable, \"adapter cannot map the stored profile\", err)\n388|\t}\n389|\tif err := terminalbackend.CheckEntrypoint(input.Entrypoint, input.SessionID); err != nil {\n390|\t\treturn refused(backendClass(err), \"stable entrypoint is not ax pane SESSION_ID\", err)\n391|\t}\n392|\n393|\tdecision := Decision{\n394|\t\tAction:   ActionLaunch,\n395|\t\tToken:    token,\n396|\t\tHasToken: true,\n397|\t\tProfile:  pair,\n398|\t\tMapping:  resolved.Mapping,\n399|\t\tAdmitted: admitted,\n400|\t\tDetail:   \"launch under the winning lease\",\n401|\t}\n402|\tif input.ExistingBinding != nil {\n403|\t\tdecision.Action = ActionReattach\n404|\t\tdecision.Detail = \"reattach to the one recorded wrapper/child\"\n405|\t}\n406|\tdescriptor, err := terminalbackend.AdmitProviderDescriptor(input.Descriptor, input.HostBinding)\n407|\tif err != nil {\n408|\t\treturn refused(backendClass(err), \"provider descriptor does not match the validated binding\", err)\n409|\t}\n410|\tdecision.Descriptor = descriptor\n411|\treturn decision\n412|}\n413|\n414|// decideParked resolves a fencing park into the parked outcome or,\n415|// for a remote owner, the attach/takeover offer. Attach requires the\n416|// remote interactive terminal of after-restore step 4 with an\n417|// admitted attach capability; any other remote park offers takeover\n418|// instead of starting a runtime. Non-remote parks carry the fencing\n(more lines below)","final_result":true}}}
