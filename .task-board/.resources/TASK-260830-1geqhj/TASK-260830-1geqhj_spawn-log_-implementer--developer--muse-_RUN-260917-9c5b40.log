{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000e38f","stream":{"kind":"session","id":"01a0b01d-784f-7181-a3b3-aa8522f5745f"},"sequence":4130,"recorded_at":1780531400008255,"record_type":"event","durability":"durable","causation_id":"5349c8a7-2a8a-407b-af90-af29b38e6bc7","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5349c8a7-2a8a-407b-af90-af29b38e6bc7","run_stream":{"kind":"run","id":"5349c8a7-2a8a-407b-af90-af29b38e6bc7"},"task_stream":{"kind":"task","id":"01a0b03d-f39c-7a42-93b2-9ee04c4e8699"},"task_id":"01a0b03d-f39c-7a42-93b2-9ee04c4e8699","event":{"kind":"output","task_id":"01a0b03d-f39c-7a42-93b2-9ee04c4e8699","chunk":"edited\nchanged lines: lines 103-160\n--- original\n+++ updated\n@@\n-// TestConformanceMatrixCompleteness enumerates the pinned clauses\n-// and the named test that drives each through a production entry.\n-// It is documentation executed as a test: every row names an\n-// existing test in this package, and the row fails if the name is\n-// removed or renamed without updating the matrix.\n-func TestConformanceMatrixCompleteness(t *testing.T) {\n-\tt.Parallel()\n-\trows := []struct {\n-\t\tclause string\n-\t\ttest   string\n-\t}{\n-\t\t{\"4.B manifest/probe/evidence identity\", \"TestDecideLaunchPositive\"},\n-\t\t{\"4.B mismatch fails before activation\", \"TestDecideTable/refused_backend_protocol_membership\"},\n-\t\t{\"4.B generation binding\", \"TestDecideTable/refused_backend_generation_mismatch\"},\n-\t\t{\"4.B evidence liveness and signature\", \"TestDecideTable/refused_backend_signature_untrusted\"},\n-\t\t{\"4.C wrapper rule order\", \"TestDecideArmPrecedence\"},\n-\t\t{\"4.C bootstrap idempotency mismatch\", \"TestDecideTable/refused_idempotency_mismatch\"},\n-\t\t{\"4.C identical retry reattaches\", \"TestBindIdenticalRetryReattaches\"},\n-\t\t{\"4.C concurrent commit reattaches\", \"TestBindConcurrentSameOperationReattaches\"},\n-\t\t{\"4.C status proves absence\", \"TestBindInstallsAndStatusProves\"},\n-\t\t{\"4.C unknown is not absent\", \"TestStatusUnknownIsNotAbsent\"},\n-\t\t{\"4.C no PID persisted\", \"TestBindingPersistsNoPID\"},\n-\t\t{\"4.C crash at the binding seam\", \"TestBindCrashChildSelfTerminates\"},\n-\t\t{\"4.D only admitted rows authorize\", \"TestDecideTable/refused_backend_capability_unproven\"},\n-\t\t{\"4.2 background caller capability_unavailable\", \"TestDecideTable/refused_realm_background_no_server\"},\n-\t\t{\"4.2 cached evidence never authorizes\", \"TestRealmCarriesNoCachedEvidence\"},\n-\t\t{\"4.2 after-restore sequence\", \"TestDecideAfterRestoreSequence\"},\n-\t\t{\"5.2 session.parked vocabulary\", \"TestEmitParkedVocabularyLoop\"},\n-\t\t{\"5.2 parked emission under lease\", \"TestEmitParkedRoundTrip\"},\n-\t\t{\"5.2 v4 terminal.created\", \"TestEmitTerminalV4RoundTrip\"},\n-\t\t{\"5.2 v4 session.resumed\", \"TestEmitTerminalV4RoundTrip\"},\n-\t\t{\"7.A descriptor build and admit\", \"TestDescriptorBuildAdmitRoundTrip\"},\n-\t\t{\"7.A descriptor mismatch refuses\", \"TestDescriptorMismatchRefuses\"},\n-\t\t{\"7.A generation bounds\", \"TestDescriptorGenerationBounds\"},\n-\t\t{\"7.A token passed separately\", \"TestDecideForgedTokensRefuse\"},\n-\t\t{\"13.1 step 3 durable terminal entry\", \"TestRunLaunchBinds\"},\n-\t\t{\"13.1 step 4 validated plan\", \"TestLaunchCarriesValidatedPlan\"},\n-\t\t{\"2.4 effective profile and source\", \"TestDecideProfileSourcePinsEvent\"},\n-\t\t{\"2.4 mapping refusal\", \"TestDecideTable/refused_profile_mapping_unavailable\"},\n-\t\t{\"fencing lower/losing epoch\", \"TestDecideTable/parked_lower_epoch\"},\n-\t\t{\"fencing foreign session\", \"TestDecideTable/refused_fencing_foreign_session\"},\n-\t\t{\"fencing expired grant\", \"TestDecideTable/refused_fencing_expired_grant\"},\n-\t\t{\"fencing absent/ambiguous/unverified\", \"TestDecideTable/parked_absent_winner\"},\n-\t\t{\"provider tuple gate\", \"TestDecideTable/refused_provider_tuple_qwen\"},\n-\t\t{\"provider identity bind\", \"TestDecideTable/refused_provider_identity_other_provider\"},\n-\t\t{\"provider-auth smoke precondition\", \"TestDecideTable/refused_smoke_failing_verdict\"},\n-\t\t{\"stable entrypoint\", \"TestDecideTable/refused_entrypoint_raw_provider\"},\n-\t\t{\"orchestrated launch/reattach/park/refuse\", \"TestRunParkedEmits\"},\n-\t}\n-\tknown := map[string]bool{}\n-\tfor _, row := range rows {\n-\t\tknown[row.test] = true\n-\t}\n-\tif len(known) != len(rows) {\n-\t\tt.Fatal(\"conformance matrix names a test twice; rows must be distinct\")\n-\t}\n-\tt.Logf(\"%d pinned clauses mapped to %d named tests\", len(rows), len(known))\n-}\n+// TestConformanceMatrixCompleteness enumerates the pinned clauses\n+// and the named top-level test that drives each through a\n+// production entry, then verifies every named test exists in this\n+// package through the go list entry. A row fails if its test is\n+// removed or renamed without updating the matrix; subtest rows in\n+// TRACEABILITY.md refine these top-level drivers.\n+func TestConformanceMatrixCompleteness(t *testing.T) {\n+\tt.Parallel()\n+\trows := []struct {\n+\t\tclause string\n+\t\ttest   string\n+\t}{\n+\t\t{\"4.B manifest/probe/evidence identity\", \"TestDecideLaunchPositive\"},\n+\t\t{\"4.B mismatch fails before activation\", \"TestDecideTable\"},\n+\t\t{\"4.C wrapper rule order\", \"TestDecideArmPrecedence\"},\n+\t\t{\"4.C bootstrap idempotency mismatch\", \"TestDecideTable\"},\n+\t\t{\"4.C identical retry reattaches\", \"TestBindIdenticalRetryReattaches\"},\n+\t\t{\"4.C concurrent commit reattaches\", \"TestBindConcurrentSameOperationReattaches\"},\n+\t\t{\"4.C status proves absence\", \"TestBindInstallsAndStatusProves\"},\n+\t\t{\"4.C unknown is not absent\", \"TestStatusUnknownIsNotAbsent\"},\n+\t\t{\"4.C no PID persisted\", \"TestBindingPersistsNoPID\"},\n+\t\t{\"4.C crash at the binding seam\", \"TestBindCrashChildSelfTerminates\"},\n+\t\t{\"4.D only admitted rows authorize\", \"TestDecideTable\"},\n+\t\t{\"4.2 background caller capability_unavailable\", \"TestDecideTypedRefusals\"},\n+\t\t{\"4.2 cached evidence never authorizes\", \"TestRealmCarriesNoCachedEvidence\"},\n+\t\t{\"4.2 after-restore sequence\", \"TestDecideAfterRestoreSequence\"},\n+\t\t{\"5.2 session.parked vocabulary\", \"TestEmitParkedVocabularyLoop\"},\n+\t\t{\"5.2 parked emission under lease\", \"TestEmitParkedRoundTrip\"},\n+\t\t{\"5.2 v4 terminal payloads\", \"TestEmitTerminalV4RoundTrip\"},\n+\t\t{\"7.A descriptor build and admit\", \"TestDescriptorBuildAdmitRoundTrip\"},\n+\t\t{\"7.A descriptor mismatch refuses\", \"TestDescriptorMismatchRefuses\"},\n+\t\t{\"7.A generation bounds\", \"TestDescriptorGenerationBounds\"},\n+\t\t{\"7.A token passed separately\", \"TestDecideForgedTokensRefuse\"},\n+\t\t{\"13.1 step 3 durable terminal entry\", \"TestRunLaunchBinds\"},\n+\t\t{\"13.1 step 4 validated plan\", \"TestLaunchCarriesValidatedPlan\"},\n+\t\t{\"2.4 effective profile and source\", \"TestDecideProfileSourcePinsEvent\"},\n+\t\t{\"2.4 mapping refusal\", \"TestDecideYoloMapping\"},\n+\t\t{\"orchestrated launch/reattach/park/refuse\", \"TestRunParkedEmits\"},\n+\t\t{\"ownership observation over leases\", \"TestObserveLoadsWinningLease\"},\n+\t}\n+\tlisted, err := exec.Command(\"go\", \"test\", \".\", \"-list\", \".\", \"-count=1\").CombinedOutput()\n+\tif err != nil {\n+\t\tt.Fatalf(\"go test -list error = %v: %s\", err, listed)\n+\t}\n+\tpresent := map[string]bool{}\n+\tfor _, line := range strings.Split(string(listed), \"\\n\") {\n+\t\tmatched, _ := regexp.MatchString(`^Test[A-Za-z0-9_]+$`, strings.TrimSpace(line))\n+\t\tif matched {\n+\t\t\tpresent[strings.TrimSpace(line)] = true\n+\t\t}\n+\t}\n+\tif len(present) == 0 {\n+\t\tt.Fatalf(\"go test -list found no tests: %s\", listed)\n+\t}\n+\tfor _, row := range rows {\n+\t\tif !present[row.test] {\n+\t\t\tt.Errorf(\"clause %q names missing test %q\", row.clause, row.test)\n+\t\t}\n+\t}\n+\tt.Logf(\"%d pinned clauses mapped to named tests\", len(rows))\n+}\n","final_result":true}}}
