{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c479","stream":{"kind":"session","id":"01a0785b-9847-7fa3-b40c-313061570fc0"},"sequence":151,"recorded_at":1780531400000297,"record_type":"event","durability":"durable","causation_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","run_stream":{"kind":"run","id":"5f283545-6d77-4246-bbdf-5a980fc43a74"},"task_stream":{"kind":"task","id":"1c2249a7-d116-406a-8ee1-6054a8f07665"},"task_id":"1c2249a7-d116-406a-8ee1-6054a8f07665","event":{"kind":"output","task_id":"1c2249a7-d116-406a-8ee1-6054a8f07665","chunk":"Read text file `internal/canonicaljson/terminal_backend_id_test.go`.\n1|package canonicaljson\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|)\n7|\n8|// terminalBackendIDEventTypes are the two Session Event 4.0.0 payloads whose\n9|// pinned member table declares terminal_backend_id. Both reach the grammar\n10|// through validateTerminalV4Payload, which validateSessionEvent selects from\n11|// sessionEventPayloadShapes for schema_version 4.0.0.\n12|var terminalBackendIDEventTypes = []string{\"terminal.created\", \"session.resumed\"}\n13|\n14|func sessionEventWithTerminalBackendID(eventType string, value any) map[string]any {\n15|\tobject := validSessionEventObject(\"4.0.0\", eventType)\n16|\tobject[\"payload\"].(map[string]any)[\"terminal_backend_id\"] = value\n17|\treturn object\n18|}\n19|\n20|// TestTerminalBackendIDGrammarRefusedAtBothIdentityEntries attacks the Section\n21|// 4.B terminal-backend-id grammar at the real identity entries. Every case\n22|// widens exactly one part of the declared character class or separator rule, so\n23|// admitting any of them means the production pattern has been widened rather\n24|// than merely deleted.\n25|func TestTerminalBackendIDGrammarRefusedAtBothIdentityEntries(t *testing.T) {\n26|\tgrammar := \"must match the terminal-backend-id grammar\"\n27|\tbound := \"must contain 1..128 ASCII bytes\"\n28|\n29|\tcases := []struct {\n30|\t\tname   string\n31|\t\tvalue  string\n32|\t\treason string\n33|\t}{\n34|\t\t// The declared minimum is subsumed by requireString, which refuses the\n35|\t\t// empty string before requireTerminalBackendID measures the bound; the\n36|\t\t// subsuming refusal is pinned here rather than asserted as the bound.\n37|\t\t{\"empty string\", \"\", \"must be a non-empty UTF-8 string\"},\n38|\t\t// The pinned bound is 128; 129 is the smallest refused length.\n39|\t\t{\"one byte past the declared bound\", strings.Repeat(\"a\", 129), bound},\n40|\t\t{\"far past the declared bound\", strings.Repeat(\"a\", 5000), bound},\n41|\t\t{\"uppercase widens the lowercase class\", \"AX.TMUX\", grammar},\n42|\t\t{\"mixed case widens the lowercase class\", \"Ax.Tmux\", grammar},\n43|\t\t{\"leading digit widens the first character class\", \"1ax\", grammar},\n44|\t\t{\"underscore widens the separator class\", \"ax_tmux\", grammar},\n45|\t\t{\"space widens the label class\", \"ax tmux\", grammar},\n46|\t\t{\"slash widens the label class\", \"../../etc/passwd\", grammar},\n47|\t\t{\"colon widens the label class\", \"urn:ax:schema:blob\", grammar},\n48|\t\t{\"at sign widens the label class\", \"ax@tmux\", grammar},\n49|\t\t{\"non-ASCII widens the label class\", \"ax.tmux界\", grammar},\n50|\t\t{\"leading separator drops the required first label\", \"-leading-dash\", grammar},\n51|\t\t{\"leading dot drops the required first label\", \".ax\", grammar},\n52|\t\t{\"trailing separator makes the trailing label optional\", \"ax.\", grammar},\n53|\t\t{\"trailing dash makes the trailing label optional\", \"ax-\", grammar},\n54|\t\t{\"consecutive separators make the label optional\", \"ax..tmux\", grammar},\n55|\t\t{\"consecutive mixed separators make the label optional\", \"ax.-tmux\", grammar},\n56|\t\t// RE2 anchors $ at end of text, so a trailing newline cannot smuggle a\n57|\t\t// second line past an otherwise matching first line.\n58|\t\t{\"trailing newline\", \"ax.tmux\\n\", grammar},\n59|\t\t{\"embedded newline\", \"ax\\n.tmux\", grammar},\n60|\t\t{\"embedded NUL\", \"ax\\x00tmux\", grammar},\n61|\t}\n62|\n63|\tfor _, eventType := range terminalBackendIDEventTypes {\n64|\t\tfor _, testCase := range cases {\n65|\t\t\tt.Run(eventType+\"/\"+testCase.name, func(t *testing.T) {\n66|\t\t\t\tobject := sessionEventWithTerminalBackendID(eventType, testCase.value)\n67|\t\t\t\tassertIdentityEntriesRefuseWithReason(t, mustJSON(t, object), SelfEventID, testCase.reason)\n68|\t\t\t})\n69|\t\t}\n70|\t}\n71|}\n72|\n73|// TestTerminalBackendIDNonStringRefusedAtBothIdentityEntries keeps the declared\n74|// scalar from being satisfied by a non-string JSON value.\n75|func TestTerminalBackendIDNonStringRefusedAtBothIdentityEntries(t *testing.T) {\n76|\tfor _, eventType := range terminalBackendIDEventTypes {\n77|\t\tfor _, value := range []any{nil, true, []any{\"ax.tmux\"}, map[string]any{\"id\": \"ax.tmux\"}} {\n78|\t\t\tobject := sessionEventWithTerminalBackendID(eventType, value)\n79|\t\t\tassertIdentityEntriesRefuseShape(t, mustJSON(t, object), SelfEventID)\n80|\t\t}\n81|\t}\n82|}\n83|\n84|// TestTerminalBackendIDAcceptsDeclaredGrammarAtBothIdentityEntries proves the\n85|// grammar is not merely refusing everything: the canonical built-ins and the\n86|// other forms the declared pattern admits must still attest.\n87|func TestTerminalBackendIDAcceptsDeclaredGrammarAtBothIdentityEntries(t *testing.T) {\n88|\taccepted := []string{\n89|\t\t\"ax.tmux\",\n90|\t\t\"ax.conpty\",\n91|\t\t\"a\",\n92|\t\t\"tmux\",\n93|\t\t\"ax-tmux\",\n94|\t\t\"ax.tmux2\",\n95|\t\t\"vendor.backend-1\",\n96|\t\t\"a0.b1-c2.d3\",\n97|\t\t// The reserved ax. namespace is a registry rule in Section 4.B, not a\n98|\t\t// payload constraint, so a vendor namespace is equally admissible.\n99|\t\t\"example.terminal-backend\",\n100|\t}\n101|\tfor _, eventType := range terminalBackendIDEventTypes {\n102|\t\tfor _, value := range accepted {\n103|\t\t\tobject := sessionEventWithTerminalBackendID(eventType, value)\n104|\t\t\tassertIdentityEntriesAcceptShape(t, mustJSON(t, object), SelfEventID)\n105|\t\t}\n106|\t}\n107|}\n108|\n109|// TestTerminalBackendIDBoundIsProvenInBothDirections asserts the bound against\n110|// the number the pinned specification declares, not against the production\n111|// constant it derives from. Section 4.B: \"terminal_backend_id is 1-128 ASCII\n112|// bytes\". The declared grammar admits only ASCII, so the byte count and the\n113|// Unicode character count coincide for every admitted value.\n114|func TestTerminalBackendIDBoundIsProvenInBothDirections(t *testing.T) {\n115|\tconst declaredMaximum = 128\n116|\tconst declaredMinimum = 1\n117|\n118|\tatMinimum := strings.Repeat(\"a\", declaredMinimum)\n119|\tatMaximum := \"a\" + strings.Repeat(\"0\", declaredMaximum-1)\n120|\tif len(atMaximum) != declaredMaximum || len(atMinimum) != declaredMinimum {\n121|\t\tt.Fatalf(\"bound fixtures are %d and %d bytes, want %d and %d\", len(atMinimum), len(atMaximum), declaredMinimum, declaredMaximum)\n122|\t}\n123|\tpastMaximum := atMaximum + \"0\"\n124|\tbelowMinimum := \"\"\n125|\n126|\tfor _, eventType := range terminalBackendIDEventTypes {\n127|\t\tassertIdentityEntriesAcceptShape(t, mustJSON(t, sessionEventWithTerminalBackendID(eventType, atMinimum)), SelfEventID)\n128|\t\tassertIdentityEntriesAcceptShape(t, mustJSON(t, sessionEventWithTerminalBackendID(eventType, atMaximum)), SelfEventID)\n129|\t\tassertIdentityEntriesRefuseWithReason(t, mustJSON(t, sessionEventWithTerminalBackendID(eventType, pastMaximum)), SelfEventID, \"1..128 ASCII bytes\")\n130|\t\t// Below the minimum the subsuming non-empty string check refuses first.\n131|\t\tassertIdentityEntriesRefuseWithReason(t, mustJSON(t, sessionEventWithTerminalBackendID(eventType, belowMinimum)), SelfEventID, \"must be a non-empty UTF-8 string\")\n132|\t}\n133|}"}}}
