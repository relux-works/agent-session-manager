{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c79b","stream":{"kind":"session","id":"01a0785b-9847-7fa3-b40c-313061570fc0"},"sequence":552,"recorded_at":1780531400001099,"record_type":"event","durability":"durable","causation_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","run_stream":{"kind":"run","id":"5f283545-6d77-4246-bbdf-5a980fc43a74"},"task_stream":{"kind":"task","id":"f432a3c9-c971-4f7d-8d14-240e4345fa76"},"task_id":"f432a3c9-c971-4f7d-8d14-240e4345fa76","event":{"kind":"output","task_id":"f432a3c9-c971-4f7d-8d14-240e4345fa76","chunk":"Read text file `internal/provhost/identity_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|)\n7|\n8|// specIdentityExample is the Section 5.5 Provider Identity Record\n9|// example, copied verbatim from the pinned document: an Antigravity\n10|// backend_conversation_uuid with a non-null realm fingerprint.\n11|const specIdentityExample = `{\n12|  \"schema\": \"urn:ax:schema:provider-identity\",\n13|  \"schema_version\": \"1.0.0\",\n14|  \"record_id\": \"sha256:c879d766da67a8cfb3a3f6eae2234faa5d52d8df987496eae2218f40e5e220c2\",\n15|  \"subject_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\",\n16|  \"session_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\",\n17|  \"provider_id\": \"antigravity\",\n18|  \"provider_version\": \"1.1.14\",\n19|  \"provider_version_range\": \">=1.1.14 <1.2.0\",\n20|  \"native_session_id\": \"11111111-2222-4333-8444-555555555555\",\n21|  \"identity_kind\": \"backend_conversation_uuid\",\n22|  \"logical_workspace_id\": \"0198f4c8-6c30-7d44-8d5e-1234567890ab\",\n23|  \"backend_realm_fingerprint\": \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaad\",\n24|  \"opaque_identity\": {},\n25|  \"created_by_host_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890ab\",\n26|  \"created_at\": \"2026-08-19T04:09:45.000Z\",\n27|  \"extensions\": {}\n28|}`\n29|\n30|// TestSpecIdentityExampleDecodes proves the Section 5.5 example\n31|// passes the production entry point for its provider.\n32|func TestSpecIdentityExampleDecodes(t *testing.T) {\n33|\tif err := CheckIdentity([]byte(specIdentityExample), \"antigravity\"); err != nil {\n34|\t\tt.Fatalf(\"CheckIdentity(spec example): %v\", err)\n35|\t}\n36|}\n37|\n38|// identityVariant rewrites one unique substring of the example.\n39|func identityVariant(t *testing.T, old, new string) []byte {\n40|\tt.Helper()\n41|\tif strings.Count(specIdentityExample, old) != 1 {\n42|\t\tt.Fatalf(\"identity variant anchor %q is not unique\", old)\n43|\t}\n44|\treturn []byte(strings.Replace(specIdentityExample, old, new, 1))\n45|}\n46|\n47|// TestCheckIdentityRefusals drives every identity rule, including\n48|// the five normative Section 5.5 negatives: unknown identity_kind,\n49|// absent opaque_identity, an object opaque value, an absolute source\n50|// path in that map, and an Antigravity backend_conversation_uuid\n51|// with a null realm fingerprint.\n52|func TestCheckIdentityRefusals(t *testing.T) {\n53|\tlong128 := strings.Repeat(\"v\", 128)\n54|\tlong129 := strings.Repeat(\"v\", 129)\n55|\tlong1024 := strings.Repeat(\"v\", 1024)\n56|\tlong1025 := strings.Repeat(\"v\", 1025)\n57|\tlong256 := strings.Repeat(\"r\", 256)\n58|\tlong257 := strings.Repeat(\"r\", 257)\n59|\tlong512 := strings.Repeat(\"s\", 512)\n60|\tlong513 := strings.Repeat(\"s\", 513)\n61|\tkey64 := \"k\" + strings.Repeat(\"e\", 63)\n62|\tkey65 := \"k\" + strings.Repeat(\"e\", 64)\n63|\trows := []struct {\n64|\t\tname   string\n65|\t\tbody   []byte\n66|\t\tmember string\n67|\t\tdetail string\n68|\t}{\n69|\t\t{\"unknown member\", identityVariant(t, `\"extensions\": {}`, `\"extensions\": {}, \"score\": 1`), \"score\", \"unknown member\"},\n70|\t\t{\"absent opaque_identity\", []byte(strings.Replace(specIdentityExample, \"  \\\"opaque_identity\\\": {},\\n\", \"\", 1)), \"opaque_identity\", \"misses a required member\"},\n71|\t\t{\"wrong schema\", identityVariant(t, `\"urn:ax:schema:provider-identity\"`, `\"urn:ax:schema:provider-manifest\"`), \"schema\", \"not the provider identity\"},\n72|\t\t{\"wrong schema version\", identityVariant(t, `\"schema_version\": \"1.0.0\"`, `\"schema_version\": \"1.1.0\"`), \"schema_version\", \"not 1.0.0\"},\n73|\t\t{\"bad record digest\", identityVariant(t, `\"record_id\": \"sha256:c879d766da67a8cfb3a3f6eae2234faa5d52d8df987496eae2218f40e5e220c2\"`, `\"record_id\": \"sha256:zzzz\"`), \"record_id\", \"not a digest\"},\n74|\t\t{\"bad subject uuid\", identityVariant(t, `\"subject_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\"`, `\"subject_id\": \"not-a-uuid\"`), \"subject_id\", \"not a UUIDv7\"},\n75|\t\t{\"bad session uuid\", identityVariant(t, `\"session_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\"`, `\"session_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ax\"`), \"session_id\", \"not a UUIDv7\"},\n76|\t\t{\"subject differs\", identityVariant(t, `\"subject_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\"`, `\"subject_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890ab\"`), \"subject_id\", \"does not equal session_id\"},\n77|\t\t{\"bad provider grammar\", identityVariant(t, `\"provider_id\": \"antigravity\"`, `\"provider_id\": \"Antigravity\"`), \"provider_id\", \"not a provider id\"},\n78|\t\t{\"empty provider version\", identityVariant(t, `\"provider_version\": \"1.1.14\"`, `\"provider_version\": \"\"`), \"provider_version\", \"not 1..128 characters\"},\n79|\t\t{\"provider version 129\", identityVariant(t, `\"provider_version\": \"1.1.14\"`, `\"provider_version\": \"`+long129+`\"`), \"provider_version\", \"not 1..128 characters\"},\n80|\t\t{\"empty version range\", identityVariant(t, `\"provider_version_range\": \">=1.1.14 <1.2.0\"`, `\"provider_version_range\": \"\"`), \"provider_version_range\", \"not 1..256 characters\"},\n81|\t\t{\"version range 257\", identityVariant(t, `\"provider_version_range\": \">=1.1.14 <1.2.0\"`, `\"provider_version_range\": \"`+long257+`\"`), \"provider_version_range\", \"not 1..256 characters\"},\n82|\t\t{\"empty native session\", identityVariant(t, `\"native_session_id\": \"11111111-2222-4333-8444-555555555555\"`, `\"native_session_id\": \"\"`), \"native_session_id\", \"not 1..512 characters\"},\n83|\t\t{\"native session 513\", identityVariant(t, `\"native_session_id\": \"11111111-2222-4333-8444-555555555555\"`, `\"native_session_id\": \"`+long513+`\"`), \"native_session_id\", \"not 1..512 characters\"},\n84|\t\t{\"unknown identity_kind\", identityVariant(t, `\"identity_kind\": \"backend_conversation_uuid\"`, `\"identity_kind\": \"window_handle\"`), \"identity_kind\", \"not a registry member\"},\n85|\t\t{\"bad workspace uuid\", identityVariant(t, `\"logical_workspace_id\": \"0198f4c8-6c30-7d44-8d5e-1234567890ab\"`, `\"logical_workspace_id\": \"0198f4c8-6c30-7d44-8d5e-1234567890aX\"`), \"logical_workspace_id\", \"not a UUIDv7\"},\n86|\t\t{\"bad realm digest\", identityVariant(t, `\"backend_realm_fingerprint\": \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaad\"`, `\"backend_realm_fingerprint\": \"nope\"`), \"backend_realm_fingerprint\", \"not a digest or null\"},\n87|\t\t{\"antigravity null realm\", identityVariant(t, `\"backend_realm_fingerprint\": \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaad\"`, `\"backend_realm_fingerprint\": null`), \"backend_realm_fingerprint\", \"required for this backend kind\"},\n88|\t\t{\"opaque object value\", identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"adapter\": {\"nested\": true}}`), \"opaque_identity\", \"not 1..1024 characters\"},\n89|\t\t{\"opaque absolute path\", identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"workdir\": \"/Users/iv/work\"}`), \"opaque_identity\", \"begins with an absolute path\"},\n90|\t\t{\"opaque windows path\", identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"workdir\": \"C:\\\\work\"}`), \"opaque_identity\", \"begins with an absolute path\"},\n91|\t\t{\"opaque bad key\", identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"Bad Key!\": \"x\"}`), \"opaque_identity\", \"not a provider key\"},\n92|\t\t{\"opaque digit-first key\", identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"0adapter\": \"x\"}`), \"opaque_identity\", \"not a provider key\"},\n93|\t\t{\"opaque 65-character key\", identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"`+key65+`\": \"x\"}`), \"opaque_identity\", \"not a provider key\"},\n94|\t\t{\"opaque empty value\", identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"adapter\": \"\"}`), \"opaque_identity\", \"not 1..1024 characters\"},\n95|\t\t{\"opaque long value\", identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"adapter\": \"`+long1025+`\"}`), \"opaque_identity\", \"not 1..1024 characters\"},\n96|\t\t{\"bad host uuid\", identityVariant(t, `\"created_by_host_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890ab\"`, `\"created_by_host_id\": \"0198f4c8-4a10-7b22-8b3c-1234567890aG\"`), \"created_by_host_id\", \"not a UUIDv7\"},\n97|\t\t{\"bad timestamp\", identityVariant(t, `\"created_at\": \"2026-08-19T04:09:45.000Z\"`, `\"created_at\": \"yesterday\"`), \"created_at\", \"not a timestamp\"},\n98|\t\t{\"extensions array\", identityVariant(t, `\"extensions\": {}`, `\"extensions\": []`), \"extensions\", \"not an object\"},\n99|\t\t{\"raw WTF-8 surrogate\", identityVariant(t, `\"native_session_id\": \"11111111-2222-4333-8444-555555555555\"`, \"\\\"native_session_id\\\": \\\"11111\\xed\\xa0\\x801111-2222-4333-8444-555555555555\\\"\"), \"\", \"not valid UTF-8\"},\n100|\t}\n101|\tfor _, row := range rows {\n102|\t\tt.Run(row.name, func(t *testing.T) {\n103|\t\t\trequireFrameRefusal(t, CheckIdentity(row.body, \"antigravity\"), row.member, row.detail)\n104|\t\t})\n105|\t}\n106|\tif err := CheckIdentity(identityVariant(t, `\"provider_version\": \"1.1.14\"`, `\"provider_version\": \"`+long128+`\"`), \"antigravity\"); err != nil {\n107|\t\tt.Fatalf(\"128-character provider version refused: %v\", err)\n108|\t}\n109|\tif err := CheckIdentity(identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"adapter\": \"`+long1024+`\"}`), \"antigravity\"); err != nil {\n110|\t\tt.Fatalf(\"1024-character opaque value refused: %v\", err)\n111|\t}\n112|\tif err := CheckIdentity(identityVariant(t, `\"provider_version_range\": \">=1.1.14 <1.2.0\"`, `\"provider_version_range\": \"`+long256+`\"`), \"antigravity\"); err != nil {\n113|\t\tt.Fatalf(\"256-character version range refused: %v\", err)\n114|\t}\n115|\tif err := CheckIdentity(identityVariant(t, `\"native_session_id\": \"11111111-2222-4333-8444-555555555555\"`, `\"native_session_id\": \"`+long512+`\"`), \"antigravity\"); err != nil {\n116|\t\tt.Fatalf(\"512-character native session refused: %v\", err)\n117|\t}\n118|\tif err := CheckIdentity(identityVariant(t, `\"opaque_identity\": {}`, `\"opaque_identity\": {\"`+key64+`\": \"x\"}`), \"antigravity\"); err != nil {\n119|\t\tt.Fatalf(\"64-character opaque key refused: %v\", err)\n120|\t}\n121|}\n122|\n123|// TestCheckIdentityNamesAnotherProvider proves the caller seat: a\n124|// well-formed record for another provider is a caller error, not a\n125|// frame error, and a null realm is honest for non-Antigravity kinds.\n126|func TestCheckIdentityNamesAnotherProvider(t *testing.T) {\n127|\trequireLocalRefusal(t, CheckIdentity([]byte(specIdentityExample), \"codex\"), \"invalid_config\", \"names another provider\")\n128|\t// Equal-length pair: claude and gemini are both six characters,\n129|\t// so a length-based correlation passes this fixture and fails in\n130|\t// production. The gate must compare the provider itself.\n131|\tclaude := identityVariant(t, `\"identity_kind\": \"backend_conversation_uuid\"`, `\"identity_kind\": \"session_uuid\"`)\n132|\tclaude = []byte(strings.Replace(string(claude), `\"provider_id\": \"antigravity\"`, `\"provider_id\": \"claude\"`, 1))\n133|\tclaude = []byte(strings.Replace(string(claude), `\"backend_realm_fingerprint\": \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaad\"`, `\"backend_realm_fingerprint\": null`, 1))\n134|\tif len(\"claude\") != len(\"gemini\") {\n135|\t\tt.Fatal(\"claude and gemini are no longer the same length; the fixture is blind\")\n136|\t}\n137|\trequireLocalRefusal(t, CheckIdentity(claude, \"gemini\"), \"invalid_config\", \"names another provider\")\n138|\totherKind := identityVariant(t, `\"identity_kind\": \"backend_conversation_uuid\"`, `\"identity_kind\": \"session_uuid\"`)\n139|\totherKind = []byte(strings.Replace(string(otherKind), `\"provider_id\": \"antigravity\"`, `\"provider_id\": \"codex\"`, 1))\n140|\totherKind = []byte(strings.Replace(string(otherKind), `\"backend_realm_fingerprint\": \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaad\"`, `\"backend_realm_fingerprint\": null`, 1))\n141|\tif err := CheckIdentity(otherKind, \"codex\"); err != nil {\n142|\t\tt.Fatalf(\"codex session_uuid with null realm refused: %v\", err)\n143|\t}\n144|}\n145|\n146|// specIdentifyResult wraps the identity example in the\n147|// identify-session success shape.\n148|const specIdentifyResultPrefix = `{\n149|  \"identity\": `\n150|\n151|// TestDecodeIdentifyResultFixtures proves the wrapper: the example\n152|// record with exact confidence and one evidence member validates,\n153|// and every wrapper rule refuses with its own arm.\n154|func TestDecodeIdentifyResultFixtures(t *testing.T) {\n155|\tindented := strings.ReplaceAll(specIdentityExample, \"\\n\", \"\\n  \")\n156|\tbody := []byte(specIdentifyResultPrefix + \"  \" + strings.TrimPrefix(indented, \"  \") + `,\n157|  \"confidence\": \"exact\",\n158|  \"matched_evidence\": [\"native_id\"]\n159|}`)\n160|\tif err := DecodeIdentifyResult(body, \"antigravity\"); err != nil {\n161|\t\tt.Fatalf(\"DecodeIdentifyResult(spec): %v\", err)\n162|\t}\n163|\twith := func(old, new string) []byte {\n164|\t\tt.Helper()\n165|\t\tfull := string(body)\n166|\t\tif strings.Count(full, old) != 1 {\n167|\t\t\tt.Fatalf(\"identify variant anchor %q is not unique\", old)\n168|\t\t}\n169|\t\treturn []byte(strings.Replace(full, old, new, 1))\n170|\t}\n171|\trows := []struct {\n172|\t\tname   string\n173|\t\tbody   []byte\n174|\t\tmember string\n175|\t\tdetail string\n176|\t}{\n177|\t\t{\"unknown member\", with(`\"matched_evidence\": [\"native_id\"]`, `\"matched_evidence\": [\"native_id\"], \"score\": 1`), \"score\", \"unknown member\"},\n178|\t\t{\"missing member\", []byte(strings.Replace(string(body), \"  \\\"confidence\\\": \\\"exact\\\",\\n\", \"\", 1)), \"confidence\", \"misses a required member\"},\n179|\t\t{\"bad confidence\", with(`\"confidence\": \"exact\"`, `\"confidence\": \"certain\"`), \"confidence\", \"not exact strong or weak\"},\n180|\t\t{\"evidence empty\", with(`\"matched_evidence\": [\"native_id\"]`, `\"matched_evidence\": []`), \"matched_evidence\", \"not 1..4 members\"},\n181|\t\t{\"evidence five\", with(`\"matched_evidence\": [\"native_id\"]`, `\"matched_evidence\": [\"native_id\", \"store_path\", \"provider_event\", \"backend_lookup\", \"native_id\"]`), \"matched_evidence\", \"not 1..4 members\"},\n182|\t\t{\"evidence unknown\", with(`\"matched_evidence\": [\"native_id\"]`, `\"matched_evidence\": [\"window_title\"]`), \"matched_evidence\", \"unknown member\"},\n183|\t\t{\"evidence unsorted\", with(`\"matched_evidence\": [\"native_id\"]`, `\"matched_evidence\": [\"store_path\", \"native_id\"]`), \"matched_evidence\", \"not sorted unique\"},\n184|\t\t{\"evidence duplicated\", with(`\"matched_evidence\": [\"native_id\"]`, `\"matched_evidence\": [\"native_id\", \"native_id\"]`), \"matched_evidence\", \"not sorted unique\"},\n185|\t\t{\"identity not object\", []byte(`{\"identity\": [], \"confidence\": \"exact\", \"matched_evidence\": [\"native_id\"]}`), \"identity\", \"not an object\"},\n186|\t}\n187|\tfor _, row := range rows {\n188|\t\tt.Run(row.name, func(t *testing.T) {\n189|\t\t\trequireFrameRefusal(t, DecodeIdentifyResult(row.body, \"antigravity\"), row.member, row.detail)\n190|\t\t})\n191|\t}\n192|\t// A well-formed record for another provider is a caller error,\n193|\t// not a frame error.\n194|\trequireLocalRefusal(t, DecodeIdentifyResult(body, \"codex\"), \"invalid_config\", \"names another provider\")\n195|}"}}}
