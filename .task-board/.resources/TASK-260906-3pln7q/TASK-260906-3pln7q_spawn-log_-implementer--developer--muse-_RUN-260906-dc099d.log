{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c42b","stream":{"kind":"session","id":"01a0785b-9847-7fa3-b40c-313061570fc0"},"sequence":112,"recorded_at":1780531400000219,"record_type":"event","durability":"durable","causation_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","run_stream":{"kind":"run","id":"5f283545-6d77-4246-bbdf-5a980fc43a74"},"task_stream":{"kind":"task","id":"4d109bbe-61fc-4068-a4f8-d5024b5066e0"},"task_id":"4d109bbe-61fc-4068-a4f8-d5024b5066e0","event":{"kind":"output","task_id":"4d109bbe-61fc-4068-a4f8-d5024b5066e0","chunk":"Read text file `internal/terminalbackend/manifest.go`.\n1|// Manifest, Probe, and Capability Evidence admission for the\n2|// TerminalBackend registry.\n3|//\n4|// Normative scope is relux-works/agent-session-manager-spec@v0.5.0 §4.B\n5|// (Manifest/Probe closed schemas, generation digest, reconciliation,\n6|// identity rule), §4.D (closed capability registry, claim rows, evidence\n7|// schema, fact mapping), §6.5 (trust established before any probe;\n8|// configuration admission), and §7.A (generation-bound descriptor binding).\n9|// Lifecycle operations other than admission (create, attach, status, and\n10|// friends) belong to the sibling lifecycle task; this file gates only which\n11|// capabilities an operation may rely on, never the operations themselves.\n12|//\n13|// Fail-closed conventions shared with the registry half of this package:\n14|// every refusal is an *Error with a wire code from the pinned catalog error\n15|// vocabulary and a static Detail clause that never echoes paths, digests,\n16|// generations, or other local data. A partial, malformed, stale, or failed\n17|// Manifest, Probe, or evidence read is an error, never absence or\n18|// availability, so callers must not fall back to a default or to PATH\n19|// discovery.\n20|package terminalbackend\n21|\n22|import (\n23|\t\"bytes\"\n24|\t\"crypto/sha256\"\n25|\t\"encoding/base64\"\n26|\t\"encoding/hex\"\n27|\t\"encoding/json\"\n28|\t\"fmt\"\n29|\t\"strings\"\n30|\t\"time\"\n31|\t\"unicode/utf8\"\n32|\n33|\t\"github.com/gowebpki/jcs\"\n34|\n35|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n36|)\n37|\n38|// Wire error codes this file may report. They extend the registry-half codes\n39|// with the exact Section 15.3 codes for manifest/probe disagreement,\n40|// unevidenced capability use, and integrity failure; every one is a member of\n41|// the pinned catalog error vocabulary.\n42|const (\n43|\t// CodeMismatch reports any failed Manifest/Probe equality, membership,\n44|\t// keyed claim relation, evidence binding, or evidence coverage rule\n45|\t// (§4.B). Malformed Manifest, Probe, or evidence documents also report\n46|\t// this code: a malformed read is an error, never absence.\n47|\tCodeMismatch = \"terminal_backend_manifest_probe_mismatch\"\n48|\t// CodeCapabilityUnproven reports an operation gate evaluated against an\n49|\t// admitted capability set that confers no true capability for the\n50|\t// requested operation (§4.C capability dependencies).\n51|\tCodeCapabilityUnproven = \"terminal_backend_capability_unproven\"\n52|\t// CodeIntegrityFailure reports a missing, malformed, unknown-key, or\n53|\t// invalid capability-evidence signature, or a signature verification\n54|\t// subsystem that is unavailable (§4.D). It fails before capability\n55|\t// admission.\n56|\tCodeIntegrityFailure = \"terminal_backend_integrity_failure\"\n57|)\n58|\n59|// IsMismatch reports CodeMismatch refusals.\n60|func IsMismatch(err error) bool { return errorCode(err, CodeMismatch) }\n61|\n62|// IsCapabilityUnproven reports CodeCapabilityUnproven refusals.\n63|func IsCapabilityUnproven(err error) bool { return errorCode(err, CodeCapabilityUnproven) }\n64|\n65|// IsIntegrityFailure reports CodeIntegrityFailure refusals.\n66|func IsIntegrityFailure(err error) bool { return errorCode(err, CodeIntegrityFailure) }\n67|\n68|// Closed schema literals (§4.B, §4.D). No other schema or version is\n69|// admitted by this file.\n70|const (\n71|\t// SchemaManifest is the Terminal Backend Manifest 1.0.0 schema URN.\n72|\tSchemaManifest = \"urn:ax:schema:terminal-backend-manifest\"\n73|\t// SchemaProbe is the Terminal Backend Probe 1.0.0 schema URN.\n74|\tSchemaProbe = \"urn:ax:schema:terminal-backend-probe\"\n75|\t// SchemaCapabilityEvidence is the Capability Evidence 1.0.0 schema URN.\n76|\tSchemaCapabilityEvidence = \"urn:ax:schema:terminal-capability-evidence\"\n77|\t// SchemaVersion100 is the only contract version this file implements.\n78|\tSchemaVersion100 = \"1.0.0\"\n79|)\n80|\n81|// Closed small vocabularies (§4.B, §4.D).\n82|const (\n83|\t// OriginStatic marks a static manifest echo claim.\n84|\tOriginStatic = \"static\"\n85|\t// OriginProbed marks a live probe observation claim.\n86|\tOriginProbed = \"probed\"\n87|\n88|\t// AvailabilityAvailable marks a ready backend.\n89|\tAvailabilityAvailable = \"available\"\n90|\t// AvailabilityConditional marks a backend that needs operator action.\n91|\tAvailabilityConditional = \"conditional\"\n92|\t// AvailabilityUnavailable marks a backend that cannot serve.\n93|\tAvailabilityUnavailable = \"unavailable\"\n94|\t// AvailabilityUnknown marks a backend whose readiness is not established.\n95|\tAvailabilityUnknown = \"unknown\"\n96|\n97|\t// IssuerRelease marks release-signed capability evidence.\n98|\tIssuerRelease = \"ax_release\"\n99|\t// IssuerLocalProbe marks host-incarnation-signed capability evidence.\n100|\tIssuerLocalProbe = \"ax_local_probe\"\n101|)\n102|\n103|// signatureSchemePrefix is the literal attestation_signature scheme (§4.D).\n104|const signatureSchemePrefix = \"rsa-sha256:\"\n105|\n106|// generationDigestDomain is the UTF-8 domain separator prepended to the\n107|// backend's host-local raw generation bytes before SHA-256 (§4.B). It\n108|// neither reveals nor reconstructs that generation.\n109|const generationDigestDomain = \"ax-terminal-backend-generation-v1\\x00\"\n110|\n111|// evidenceSignatureDomain is the ASCII domain separator prepended to the\n112|// canonical evidence bytes before signing (§4.D).\n113|const evidenceSignatureDomain = \"ax-terminal-capability-evidence-v1\"\n114|\n115|// Closed TerminalBackendCapability registry (§4.D). The map key is the\n116|// capability name; the row carries the exact registry members a Manifest or\n117|// Probe claim must repeat verbatim.\n118|type capabilityRow struct {\n119|\tgenerationVariable   bool\n120|\tdependentOperations  []string\n121|\tevidenceRequirements []string\n122|}\n123|\n124|// capabilityRegistry is the exact 16-value Section 4.D table. Dependent\n125|// operations and evidence requirements are stored sorted as the wire\n126|// requires, so row comparison is element-wise.\n127|var capabilityRegistry = map[string]capabilityRow{\n128|\t\"durable_disconnect\": {\n129|\t\tgenerationVariable:   false,\n130|\t\tdependentOperations:  []string{\"create\", \"status\"},\n131|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n132|\t},\n133|\t\"local_attach\": {\n134|\t\tgenerationVariable:   true,\n135|\t\tdependentOperations:  []string{\"attach\"},\n136|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n137|\t},\n138|\t\"remote_attach\": {\n139|\t\tgenerationVariable:   true,\n140|\t\tdependentOperations:  []string{\"attach\"},\n141|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n142|\t},\n143|\t\"web_attach\": {\n144|\t\tgenerationVariable:   true,\n145|\t\tdependentOperations:  []string{\"attach\"},\n146|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n147|\t},\n148|\t\"multi_attach\": {\n149|\t\tgenerationVariable:   true,\n150|\t\tdependentOperations:  []string{\"attach\"},\n151|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n152|\t},\n153|\t\"headless_creation\": {\n154|\t\tgenerationVariable:   true,\n155|\t\tdependentOperations:  []string{\"create\"},\n156|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n157|\t},\n158|\t\"reboot_restoration\": {\n159|\t\tgenerationVariable:   true,\n160|\t\tdependentOperations:  []string{\"restore\"},\n161|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n162|\t},\n163|\t\"input_quiescence\": {\n164|\t\tgenerationVariable:   true,\n165|\t\tdependentOperations:  []string{\"quiesce-input\"},\n166|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n167|\t},\n168|\t\"safe_boundary_observation\": {\n169|\t\tgenerationVariable:   true,\n170|\t\tdependentOperations:  []string{\"wait-safe-boundary\"},\n171|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n172|\t},\n173|\t\"provider_process_observation\": {\n174|\t\tgenerationVariable:   true,\n175|\t\tdependentOperations:  []string{\"status\", \"terminate-stale\", \"wait-safe-boundary\"},\n176|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n177|\t},\n178|\t\"graceful_stop\": {\n179|\t\tgenerationVariable:   true,\n180|\t\tdependentOperations:  []string{\"request-stop\"},\n181|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n182|\t},\n183|\t\"stale_process_termination\": {\n184|\t\tgenerationVariable:   true,\n185|\t\tdependentOperations:  []string{\"terminate-stale\"},\n186|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n187|\t},\n188|\t\"terminal_state_retention\": {\n189|\t\tgenerationVariable:   true,\n190|\t\tdependentOperations:  []string{\"create\", \"restore\", \"status\"},\n191|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n192|\t},\n193|\t\"scrollback_retention\": {\n194|\t\tgenerationVariable:   true,\n195|\t\tdependentOperations:  []string{\"create\", \"restore\", \"status\"},\n196|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n197|\t},\n198|\t\"credential_capable_execution_realm\": {\n199|\t\tgenerationVariable:  true,\n200|\t\tdependentOperations: []string{\"create\", \"restore\"},\n201|\t\tevidenceRequirements: []string{\n202|\t\t\t\"conformance_fixture\", \"credential_sentinel\", \"provider_auth_smoke\", \"runtime_probe\",\n203|\t\t},\n204|\t},\n205|\t\"multiple_input_clients\": {\n206|\t\tgenerationVariable:   true,\n207|\t\tdependentOperations:  []string{\"attach\"},\n208|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n209|\t},\n210|}\n211|\n212|// credentialRealmCapability is the one capability whose evidence carries the\n213|// terminal-binding, provider, sentinel, and smoke members (§4.D). Every other\n214|// capability's evidence must leave those members null.\n215|const credentialRealmCapability = \"credential_capable_execution_realm\"\n216|\n217|// requirementFact maps every CapabilityEvidenceRequirement to the\n218|// CapabilityEvidenceFact that satisfies it (§4.D). ui_absent and\n219|// prompt_absent are supplementary facts with no requirement mapping: they\n220|// may accompany evidence but never satisfy a requirement alone.\n221|var requirementFact = map[string]string{\n222|\t\"conformance_fixture\":  \"fixture_passed\",\n223|\t\"runtime_probe\":        \"runtime_probe_passed\",\n224|\t\"credential_sentinel\":  \"sentinel_passed\",\n225|\t\"provider_auth_smoke\":  \"provider_auth_passed\",\n226|\t\"policy_authorization\": \"policy_checked\",\n227|}\n228|\n229|// Closed TerminalBackendOperation vocabulary (§4.D).\n230|var operationVocabulary = map[string]bool{\n231|\t\"manifest\": true, \"probe\": true, \"create\": true, \"attach\": true,\n232|\t\"status\": true, \"quiesce-input\": true, \"wait-safe-boundary\": true,\n233|\t\"request-stop\": true, \"terminate-stale\": true, \"restore\": true,\n234|}\n235|\n236|// Closed CapabilityEvidenceRequirement vocabulary (§4.D).\n237|var evidenceRequirementVocabulary = map[string]bool{\n238|\t\"conformance_fixture\": true, \"runtime_probe\": true,\n239|\t\"credential_sentinel\": true, \"provider_auth_smoke\": true,\n240|\t\"policy_authorization\": true,\n241|}\n242|\n243|// Closed CapabilityEvidenceFact vocabulary (§4.D).\n244|var evidenceFactVocabulary = map[string]bool{\n245|\t\"fixture_passed\": true, \"runtime_probe_passed\": true,\n246|\t\"sentinel_passed\": true, \"provider_auth_passed\": true,\n247|\t\"policy_checked\": true, \"ui_absent\": true, \"prompt_absent\": true,\n248|}\n249|\n250|// Document bounds shared by the three closed schemas.\n251|const (\n252|\tmaxClaims          = 16\n253|\tmaxEvidenceIDs     = 256\n254|\tmaxOperations      = 10\n255|\tmaxRequirements    = 5\n256|\tmaxFacts           = 7\n257|\tmaxOpaqueString    = 256\n258|\tmaxJSONDepth       = 32\n259|\tmaxNativeReference = 512\n260|)\n261|\n262|// mismatchf refuses with CodeMismatch and a static detail clause. The clause\n263|// must never interpolate local data: paths, digests, generations, and\n264|// document bytes stay out of errors.\n265|func mismatchf(format string, arguments ...any) *Error {\n266|\treturn &Error{Code: CodeMismatch, Detail: fmt.Sprintf(format, arguments...)}\n267|}\n268|\n269|// hasLoneSurrogateEscape reports whether raw JSON carries a lone surrogate\n270|// code point inside any string literal, either as a \\uXXXX escape or as raw\n271|// WTF-8 (CESU-8) bytes ED A0..BF 80..BF, which decode to U+D800..U+DFFF.\n272|// It answers only the surrogate question: malformed escapes, other invalid\n273|// UTF-8, unescaped control characters, and unterminated strings are left\n274|// for the decoder's syntax and encoding arms, which refuse them with their\n275|// own details. The scan mirrors internal/canonicaljson\n276|// validateSurrogateEscapes without importing it: canonicaljson is\n277|// byte-identical across stories and must not be edited at integration, so\n278|// the two copies are pinned equal by\n279|// TestSurrogateGateAgreesWithCanonicalJSON instead of shared.\n280|func hasLoneSurrogateEscape(raw []byte) bool {\n281|\tfor index := 0; index < len(raw); index++ {\n282|\t\tif raw[index] != '\"' {\n283|\t\t\tcontinue\n284|\t\t}\n285|\t\tfor index++; index < len(raw); index++ {\n286|\t\t\tif isWTF8SurrogateAt(raw, index) {\n287|\t\t\t\treturn true\n288|\t\t\t}\n289|\t\t\tswitch raw[index] {\n290|\t\t\tcase '\"':\n291|\t\t\t\tgoto stringComplete\n292|\t\t\tcase '\\\\':\n293|\t\t\t\tindex++\n294|\t\t\t\tif index >= len(raw) {\n295|\t\t\t\t\treturn false\n296|\t\t\t\t}\n297|\t\t\t\t// The escaped byte is skipped by the switch below without\n298|\t\t\t\t// passing the loop head, so test it here: a WTF-8 head\n299|\t\t\t\t// immediately after a backslash (for example \"...\\n<ED A0\n300|\t\t\t\t// 80>...\") is still raw bytes on the wire, not an escape.\n301|\t\t\t\tif isWTF8SurrogateAt(raw, index) {\n302|\t\t\t\t\treturn true\n303|\t\t\t\t}\n304|\t\t\t\tif raw[index] != 'u' {\n305|\t\t\t\t\tcontinue\n306|\t\t\t\t}\n307|\t\t\t\tunit, end, ok := readUTF16EscapeUnit(raw, index-1)\n308|\t\t\t\tif !ok {\n309|\t\t\t\t\tcontinue\n310|\t\t\t\t}\n311|\t\t\t\tindex = end - 1\n312|\t\t\t\tswitch {\n313|\t\t\t\tcase unit >= 0xd800 && unit <= 0xdbff:\n314|\t\t\t\t\tsecond, secondEnd, ok := readUTF16EscapeUnit(raw, end)\n315|\t\t\t\t\tif !ok || second < 0xdc00 || second > 0xdfff {\n316|\t\t\t\t\t\treturn true\n317|\t\t\t\t\t}\n318|\t\t\t\t\tindex = secondEnd - 1\n319|\t\t\t\tcase unit >= 0xdc00 && unit <= 0xdfff:\n320|\t\t\t\t\treturn true\n321|\t\t\t\t}\n322|\t\t\t}\n323|\t\t}\n324|\tstringComplete:\n325|\t}\n326|\treturn false\n327|}\n328|\n329|// isWTF8SurrogateAt reports whether raw[index] begins a three-byte WTF-8\n330|// (CESU-8) encoding of a surrogate code point: ED A0..BF 80..BF decodes to\n331|// U+D800..U+DFFF, which utf8.Valid refuses. Only this ED range is\n332|// surrogate-shaped: ED 80..9F heads U+D000..U+D7FF, which is valid UTF-8\n333|// and must not match. A truncated tail cannot be classified here and is\n334|// left for the encoding arm.\n335|func isWTF8SurrogateAt(raw []byte, index int) bool {\n336|\treturn index+2 < len(raw) && raw[index] == 0xed &&\n337|\t\traw[index+1] >= 0xa0 && raw[index+1] <= 0xbf &&\n338|\t\traw[index+2] >= 0x80 && raw[index+2] <= 0xbf\n339|}\n340|\n341|// readUTF16EscapeUnit reads one \\uXXXX escape at raw[start] (which must be\n342|// the backslash). It reports false when the escape is absent or malformed;\n343|// malformed escapes are refused by the decoder's syntax arm, so this gate\n344|// only needs to stay silent on them rather than diagnose them.\n345|func readUTF16EscapeUnit(raw []byte, start int) (uint16, int, bool) {\n346|\tif start < 0 || start+6 > len(raw) || raw[start] != '\\\\' || raw[start+1] != 'u' {\n347|\t\treturn 0, start, false\n348|\t}\n349|\tvar unit uint16\n350|\tfor _, digit := range raw[start+2 : start+6] {\n351|\t\tunit <<= 4\n352|\t\tswitch {\n353|\t\tcase digit >= '0' && digit <= '9':\n354|\t\t\tunit |= uint16(digit - '0')\n355|\t\tcase digit >= 'a' && digit <= 'f':\n356|\t\t\tunit |= uint16(digit-'a') + 10\n357|\t\tcase digit >= 'A' && digit <= 'F':\n358|\t\t\tunit |= uint16(digit-'A') + 10\n359|\t\tdefault:\n360|\t\t\treturn 0, start, false\n361|\t\t}\n362|\t}\n363|\treturn unit, start + 6, true\n364|}\n365|\n366|// decodeStrictObject decodes one JSON object with duplicate-key refusal,\n367|// invalid-UTF-8 refusal, lone-surrogate-escape refusal, a nesting cap, and\n368|// trailing-data refusal. The surrogate scan runs on the raw bytes before\n369|// any canonicalization (SPEC.md:289): Go's encoding/json would silently\n370|// replace a lone \\ud800 with U+FFFD, hiding the violation from every later\n371|// member check. Numbers\n372|// decode as json.Number so member validators can refuse them explicitly:\n373|// none of the three closed schemas has a numeric member.\n374|func decodeStrictObject(raw []byte) (map[string]any, error) {\n375|\tif !utf8.Valid(raw) {\n376|\t\treturn nil, mismatchf(\"document encoding\")\n377|\t}\n378|\tif hasLoneSurrogateEscape(raw) {\n379|\t\treturn nil, mismatchf(\"document surrogate escape\")\n380|\t}\n381|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n382|\tdecoder.UseNumber()\n383|\tvalue, err := decodeCappedValue(decoder, 0)\n384|\tif err != nil {\n385|\t\treturn nil, err\n386|\t}\n387|\tif decoder.More() {\n388|\t\treturn nil, mismatchf(\"document trailing data\")\n389|\t}\n390|\tobject, ok := value.(map[string]any)\n391|\tif !ok {\n392|\t\treturn nil, mismatchf(\"document shape\")\n393|\t}\n394|\treturn object, nil\n395|}\n396|\n397|// decodeCappedValue decodes one JSON value with an explicit depth bound. The\n398|// bound is far above the deepest legitimate nesting (object, claims array,\n399|// claim object, member array) and fails closed below any decoder-stack risk.\n400|func decodeCappedValue(decoder *json.Decoder, depth int) (any, error) {\n401|\tif depth > maxJSONDepth {\n402|\t\treturn nil, mismatchf(\"document nesting\")\n403|\t}\n404|\ttoken, err := decoder.Token()\n405|\tif err != nil {\n406|\t\treturn nil, mismatchf(\"document syntax\")\n407|\t}\n408|\tif delimiter, ok := token.(json.Delim); ok {\n409|\t\tswitch delimiter {\n410|\t\tcase '{':\n411|\t\t\tobject := make(map[string]any)\n412|\t\t\tfor decoder.More() {\n413|\t\t\t\tkeyToken, err := decoder.Token()\n414|\t\t\t\tif err != nil {\n415|\t\t\t\t\treturn nil, mismatchf(\"document syntax\")\n416|\t\t\t\t}\n417|\t\t\t\tkey, ok := keyToken.(string)\n418|\t\t\t\tif !ok {\n419|\t\t\t\t\treturn nil, mismatchf(\"document syntax\")\n420|\t\t\t\t}\n421|\t\t\t\tif _, duplicate := object[key]; duplicate {\n422|\t\t\t\t\treturn nil, mismatchf(\"document duplicate member\")\n423|\t\t\t\t}\n424|\t\t\t\tmember, err := decodeCappedValue(decoder, depth+1)\n425|\t\t\t\tif err != nil {\n426|\t\t\t\t\treturn nil, err\n427|\t\t\t\t}\n428|\t\t\t\tobject[key] = member\n429|\t\t\t}\n430|\t\t\tif _, err := decoder.Token(); err != nil {\n431|\t\t\t\treturn nil, mismatchf(\"document syntax\")\n432|\t\t\t}\n433|\t\t\treturn object, nil\n434|\t\tcase '[':\n435|\t\t\t// Non-nil initialization: an empty wire array must round-trip\n436|\t\t\t// as [] rather than null, or identity recomputation over an\n437|\t\t\t// empty claim or evidence list diverges from the signer.\n438|\t\t\tarray := []any{}\n439|\t\t\tfor decoder.More() {\n440|\t\t\t\tmember, err := decodeCappedValue(decoder, depth+1)\n441|\t\t\t\tif err != nil {\n442|\t\t\t\t\treturn nil, err\n443|\t\t\t\t}\n444|\t\t\t\tarray = append(array, member)\n445|\t\t\t}\n446|\t\t\tif _, err := decoder.Token(); err != nil {\n447|\t\t\t\treturn nil, mismatchf(\"document syntax\")\n448|\t\t\t}\n449|\t\t\treturn array, nil\n450|\t\tdefault:\n451|\t\t\treturn nil, mismatchf(\"document syntax\")\n452|\t\t}\n453|\t}\n454|\treturn token, nil\n455|}\n456|\n457|// checkExactMembers refuses any deviation from the closed member set: an\n458|// unknown member and a missing member are both malformed.\n459|func checkExactMembers(object map[string]any, members []string) error {\n460|\tif len(object) != len(members) {\n461|\t\treturn mismatchf(\"document members\")\n462|\t}\n463|\tfor _, member := range members {\n464|\t\tif _, known := object[member]; !known {\n465|\t\t\treturn mismatchf(\"document members\")\n466|\t\t}\n467|\t}\n468|\treturn nil\n469|}\n470|\n471|// stringMember extracts a required string member. Numbers, booleans, nulls,\n472|// arrays, and objects are refused: no member of these schemas takes them.\n473|func stringMember(object map[string]any, name string) (string, error) {\n474|\tvalue, ok := object[name].(string)\n475|\tif !ok {\n476|\t\treturn \"\", mismatchf(\"document member type\")\n477|\t}\n478|\treturn value, nil\n479|}\n480|\n481|// boundedStringMember extracts a required string[1..256] measured in UTF-8\n482|// characters over valid UTF-8 (SPEC.md:321), the canonical bound in every\n483|// containing contract.\n484|func boundedStringMember(object map[string]any, name string) (string, error) {\n485|\tvalue, err := stringMember(object, name)\n486|\tif err != nil {\n487|\t\treturn \"\", err\n488|\t}\n489|\tif !utf8.ValidString(value) || utf8.RuneCountInString(value) < 1 || utf8.RuneCountInString(value) > maxOpaqueString {\n490|\t\treturn \"\", mismatchf(\"document string bound\")\n491|\t}\n492|\treturn value, nil\n493|}\n494|\n495|// digestMember extracts a required sha256: digest member.\n496|func digestMember(object map[string]any, name string) (string, error) {\n497|\tvalue, err := stringMember(object, name)\n498|\tif err != nil {\n499|\t\treturn \"\", err\n500|\t}\n(more lines below)"}}}
