{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4bf","stream":{"kind":"session","id":"01a0785b-9847-7fa3-b40c-313061570fc0"},"sequence":186,"recorded_at":1780531400000367,"record_type":"event","durability":"durable","causation_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","run_stream":{"kind":"run","id":"5f283545-6d77-4246-bbdf-5a980fc43a74"},"call_id":"call_01a0785c07da75e2a819f8e66d785921","text":"Read text file `internal/provhost/opdecode.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"sort\"\n7|\t\"strconv\"\n8|\t\"strings\"\n9|\t\"unicode/utf8\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// This file holds parse-only helpers for the Section 7.3-7.7 operation\n15|// bodies. Every helper reports a verdict and never refuses: all refusals\n16|// call one of the six refusal constructors directly at the deciding site\n17|// with a literal detail, so the refusal-arm inventory keeps seeing every\n18|// arm. A helper that fronted a constructor would collapse distinct rules\n19|// into one obligation and is not used here.\n20|\n21|// maxUint53 is the largest exactly representable JSON integer: Section\n22|// 7.5 counts and Section 5.1 limits are uint53 throughout.\n23|const maxUint53 = uint64(1<<53 - 1)\n24|\n25|// unknownMember names a member outside the closed set, if any.\n26|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n27|\tfor name := range members {\n28|\t\tif !allowed[name] {\n29|\t\t\treturn name, true\n30|\t\t}\n31|\t}\n32|\treturn \"\", false\n33|}\n34|\n35|// missingMember names the first required member with no value, if any.\n36|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n37|\tfor _, name := range required {\n38|\t\tif _, present := members[name]; !present {\n39|\t\t\treturn name, true\n40|\t\t}\n41|\t}\n42|\treturn \"\", false\n43|}\n44|\n45|// rawString reads a JSON string member.\n46|func rawString(raw json.RawMessage) (string, bool) {\n47|\tvar value string\n48|\tif err := json.Unmarshal(raw, &value); err != nil {\n49|\t\treturn \"\", false\n50|\t}\n51|\treturn value, true\n52|}\n53|\n54|// rawBool reads a JSON boolean member.\n55|func rawBool(raw json.RawMessage) (bool, bool) {\n56|\tvar value bool\n57|\tif err := json.Unmarshal(raw, &value); err != nil {\n58|\t\treturn false, false\n59|\t}\n60|\treturn value, true\n61|}\n62|\n63|// rawUint53 reads an unsigned integral JSON number in [0, 2^53-1]. A\n64|// fraction, exponent, sign, or out-of-range magnitude is not a uint53,\n65|// even when it names the same mathematical value: the canonical bodies\n66|// carry counts, never measurements.\n67|func rawUint53(raw json.RawMessage) (uint64, bool) {\n68|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n69|\tdecoder.UseNumber()\n70|\tvar value any\n71|\tif err := decoder.Decode(&value); err != nil {\n72|\t\treturn 0, false\n73|\t}\n74|\tnumber, ok := value.(json.Number)\n75|\tif !ok {\n76|\t\treturn 0, false\n77|\t}\n78|\tliteral := number.String()\n79|\tif literal == \"\" || strings.ContainsAny(literal, \".eE+-\") {\n80|\t\treturn 0, false\n81|\t}\n82|\tparsed, err := strconv.ParseUint(literal, 10, 64)\n83|\tif err != nil || parsed > maxUint53 {\n84|\t\treturn 0, false\n85|\t}\n86|\treturn parsed, true\n87|}\n88|\n89|// rawNullableString reads a JSON string-or-null member: null reports\n90|// isNull without a value, any other non-string reports !ok.\n91|func rawNullableString(raw json.RawMessage) (value string, isNull bool, ok bool) {\n92|\tif string(raw) == \"null\" {\n93|\t\treturn \"\", true, true\n94|\t}\n95|\tvalue, ok = rawString(raw)\n96|\treturn value, false, ok\n97|}\n98|\n99|// rawArray reads a JSON array member into its raw elements. Null is not\n100|// an array: every array member in Sections 7.3-7.5 is required.\n101|func rawArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n102|\tif string(bytes.TrimSpace(raw)) == \"null\" {\n103|\t\treturn nil, false\n104|\t}\n105|\tvar elements []json.RawMessage\n106|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n107|\tdecoder.UseNumber()\n108|\tif err := decoder.Decode(&elements); err != nil {\n109|\t\treturn nil, false\n110|\t}\n111|\tif elements == nil {\n112|\t\treturn []json.RawMessage{}, true\n113|\t}\n114|\treturn elements, true\n115|}\n116|\n117|// rawStringArray reads an array whose every element is a JSON string.\n118|func rawStringArray(raw json.RawMessage) ([]string, bool) {\n119|\telements, ok := rawArray(raw)\n120|\tif !ok {\n121|\t\treturn nil, false\n122|\t}\n123|\tout := make([]string, 0, len(elements))\n124|\tfor _, element := range elements {\n125|\t\tvalue, ok := rawString(element)\n126|\t\tif !ok {\n127|\t\t\treturn nil, false\n128|\t\t}\n129|\t\tout = append(out, value)\n130|\t}\n131|\treturn out, true\n132|}\n133|\n134|// sortedUniqueStrings reports whether the values are in strictly\n135|// increasing bytewise order: sorted with no duplicates. Bytewise order\n136|// is the canonical-form order every closed array in Sections 7.3-7.5\n137|// is written in.\n138|func sortedUniqueStrings(values []string) bool {\n139|\treturn sort.StringsAreSorted(values) && !hasDuplicateString(values)\n140|}\n141|\n142|func hasDuplicateString(values []string) bool {\n143|\tfor i := 1; i < len(values); i++ {\n144|\t\tif values[i] == values[i-1] {\n145|\t\t\treturn true\n146|\t\t}\n147|\t}\n148|\treturn false\n149|}\n150|\n151|// runeLength reports the Unicode-character length the Section 7 string\n152|// bounds count in. JSON transport is UTF-8, so characters are runes,\n153|// not bytes and not code units.\n154|func runeLength(value string) int {\n155|\treturn utf8.RuneCountInString(value)\n156|}\n157|\n158|// isDigest reports whether the value parses as a content digest.\n159|func isDigest(value string) bool {\n160|\t_, err := scalar.ParseDigest(value)\n161|\treturn err == nil\n162|}\n163|\n164|// isUUIDv7 reports whether the value parses as a UUIDv7.\n165|func isUUIDv7(value string) bool {\n166|\t_, err := scalar.ParseUUIDv7(value)\n167|\treturn err == nil\n168|}\n169|\n170|// isTimestamp reports whether the value parses as a timestamp.\n171|func isTimestamp(value string) bool {\n172|\t_, err := scalar.ParseTimestamp(value)\n173|\treturn err == nil\n174|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
