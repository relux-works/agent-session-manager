{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000e5e5","stream":{"kind":"session","id":"01a0785b-9847-7fa3-b40c-313061570fc0"},"sequence":4429,"recorded_at":1780531400008853,"record_type":"event","durability":"durable","causation_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","run_stream":{"kind":"run","id":"5f283545-6d77-4246-bbdf-5a980fc43a74"},"task_stream":{"kind":"task","id":"8e889cdb-d816-4f62-a497-a5d63b088c2e"},"task_id":"8e889cdb-d816-4f62-a497-a5d63b088c2e","event":{"kind":"output","task_id":"8e889cdb-d816-4f62-a497-a5d63b088c2e","chunk":"{\n  \"chunk_id\": \"exec-149-1\",\n  \"command\": \"grep -E \\\"matrix|package:\\\" .github/workflows/ci.yml | head -n 20; grep -E \\\"capability-claims\\\" -A 15 .github/workflows/ci.yml | head -n 25\",\n  \"description\": \"Check fixture matrix and claims job\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"# a grep, glob, file scan, matrix expansion, or test selector that finds\\n  fixture-matrix:\\n    name: Conformance fixtures (${{ matrix.os }}, ${{ matrix.package }})\\n    runs-on: ${{ matrix.os }}\\n      matrix:\\n        package: [internal/secprim, internal/secconftest]\\n          go test ./${{ matrix.package }} -count=1 -v > fixture.log 2>&1\\n            echo \\\"## Fixture run ${{ matrix.os }} ${{ matrix.package }}\\\"\\n      - fixture-matrix\\n  capability-claims:\\n    name: Unsupported-capability claim check\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 10\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n        uses: actions/setup-go@v7\\n        with:\\n          go-version-file: go.mod\\n\\n      # The vocabulary is secconftest's probe set; the gate scans the README\\n      # with every probe forced unavailable — the strongest posture, and\\n      # host-independent: a backticked capability mention that reads as a\\n--\\n      - capability-claims\\n      - windows-compile-only\\n    if: always()\\n    steps:\\n      - name: Refuse any non-success dependency\\n        run: |\\n          echo '${{ toJSON(needs) }}' > needs.json\\n          jq . needs.json\\n\",\n  \"original_output_bytes\": 1192,\n  \"original_output_tokens\": 298,\n  \"truncated\": false\n}"}}}
