{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6f9","stream":{"kind":"session","id":"01a0785b-9847-7fa3-b40c-313061570fc0"},"sequence":471,"recorded_at":1780531400000937,"record_type":"event","durability":"durable","causation_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","run_stream":{"kind":"run","id":"5f283545-6d77-4246-bbdf-5a980fc43a74"},"task_stream":{"kind":"task","id":"2fb22834-396c-4d91-9308-1f8ef1ccf5c9"},"task_id":"2fb22834-396c-4d91-9308-1f8ef1ccf5c9","event":{"kind":"output","task_id":"2fb22834-396c-4d91-9308-1f8ef1ccf5c9","chunk":"Read text file `internal/config/terminal_registry_wiring_test.go`.\n1|package config\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|)\n9|\n10|// TestEncodeCurrentRefusesReservedBackendNamespace proves the terminal backend\n11|// registry is a live production call site of configuration validation: an\n12|// ax.-namespaced ID outside the two canonical built-ins is refused at the\n13|// exact clause, while the built-ins and vendor namespaces keep working.\n14|func TestEncodeCurrentRefusesReservedBackendNamespace(t *testing.T) {\n15|\tt.Parallel()\n16|\n17|\tt.Run(\"selected reserved ID\", func(t *testing.T) {\n18|\t\tt.Parallel()\n19|\t\tconfiguration := validCurrentConfiguration()\n20|\t\tconfiguration.Terminal.BackendID = \"ax.evil\"\n21|\t\t_, err := EncodeCurrent(configuration, DecodeContext{RuntimePlatform: scalar.PlatformMacOS})\n22|\t\trequireConfigClause(t, err, \"terminal.backend_id\")\n23|\t})\n24|\n25|\tt.Run(\"external trust reserved ID\", func(t *testing.T) {\n26|\t\tt.Parallel()\n27|\t\tconfiguration := validCurrentConfiguration()\n28|\t\tconfiguration.Terminal.ExternalTrust = []ExternalExecutableTrust{{\n29|\t\t\tBackendID:        \"ax.evil\",\n30|\t\t\tExecutablePath:   \"/opt/vendor/bin/ax-backend-evil\",\n31|\t\t\tExecutableDigest: testDigest,\n32|\t\t\tEnabled:          true,\n33|\t\t}}\n34|\t\t_, err := EncodeCurrent(configuration, DecodeContext{RuntimePlatform: scalar.PlatformMacOS})\n35|\t\trequireConfigClause(t, err, \"terminal.external_trust[0].backend_id\")\n36|\t})\n37|\n38|\t// External trust malformed ID proves the registry-grammar call in the\n39|\t// trust loop is load-bearing against deletion: without it this entry\n40|\t// sails past the ax. reservation (no such prefix), the path and digest\n41|\t// checks, and the registered-set test, and is admitted. Reverting the\n42|\t// call to the previous local pattern is instead an equivalent mutant —\n43|\t// the old grammar refuses this input too, and the error clause is\n44|\t// intentionally non-distinguishing — so that variant is documented as\n45|\t// equivalent rather than covered.\n46|\tt.Run(\"external trust malformed ID\", func(t *testing.T) {\n47|\t\tt.Parallel()\n48|\t\tconfiguration := validCurrentConfiguration()\n49|\t\tconfiguration.Terminal.ExternalTrust = []ExternalExecutableTrust{{\n50|\t\t\tBackendID:        \"INVALID_ID\",\n51|\t\t\tExecutablePath:   \"/opt/vendor/bin/ax-backend-term\",\n52|\t\t\tExecutableDigest: testDigest,\n53|\t\t\tEnabled:          true,\n54|\t\t}}\n55|\t\t_, err := EncodeCurrent(configuration, DecodeContext{RuntimePlatform: scalar.PlatformMacOS})\n56|\t\trequireConfigClause(t, err, \"terminal.external_trust[0].backend_id\")\n57|\t})\n58|\n59|\tt.Run(\"external trust claiming a built-in ID is ambiguous\", func(t *testing.T) {\n60|\t\tt.Parallel()\n61|\t\tconfiguration := validCurrentConfiguration()\n62|\t\tconfiguration.Terminal.ExternalTrust = []ExternalExecutableTrust{{\n63|\t\t\tBackendID:        \"ax.tmux\",\n64|\t\t\tExecutablePath:   \"/opt/vendor/bin/ax-backend-tmux\",\n65|\t\t\tExecutableDigest: testDigest,\n66|\t\t\tEnabled:          true,\n67|\t\t}}\n68|\t\t_, err := EncodeCurrent(configuration, DecodeContext{RuntimePlatform: scalar.PlatformMacOS})\n69|\t\trequireConfigClause(t, err, \"terminal.external_trust[0].backend_id\")\n70|\t})\n71|\n72|\tt.Run(\"canonical built-ins still admitted\", func(t *testing.T) {\n73|\t\tt.Parallel()\n74|\t\tconfiguration := validCurrentConfiguration()\n75|\t\tconfiguration.Terminal.BackendID = \"ax.tmux\"\n76|\t\tif _, err := EncodeCurrent(configuration, DecodeContext{RuntimePlatform: scalar.PlatformMacOS}); err != nil {\n77|\t\t\tt.Fatalf(\"EncodeCurrent(ax.tmux) error = %v\", err)\n78|\t\t}\n79|\t})\n80|}\n81|\n82|// TestDecodeRefusesNonConptyBackendOnNativeWindows pins the Section 6.2\n83|// sentence \"On native Windows, ... terminal backend MUST be conpty\"\n84|// (SPEC.md:2415-2418) through the legacy translation path: a v1 document\n85|// naming tmux on Windows refuses at the production load entry, while conpty\n86|// loads. The v3 lane split is pinned separately by the \"built-in backend\n87|// unsupported on platform\" Decode case and the \"conpty platform\" refusal\n88|// case; this test closes the legacy arm without extending the rule to\n89|// third-party registered IDs, which Section 6.5 admits as valid.\n90|func TestDecodeRefusesNonConptyBackendOnNativeWindows(t *testing.T) {\n91|\tt.Parallel()\n92|\n93|\ttmux := append(minimalValidConfigVersion(scalar.PlatformWindows, Version1), []byte(\"\\n[terminal]\\nbackend = \\\"tmux\\\"\\n\")...)\n94|\tif _, err := Decode(tmux, DecodeContext{RuntimePlatform: scalar.PlatformWindows}); err == nil {\n95|\t\tt.Fatal(\"Decode(v1 backend=tmux on Windows) error = nil, want refusal\")\n96|\t} else if !errors.Is(err, ErrConfigValidation) {\n97|\t\tt.Fatalf(\"Decode(v1 backend=tmux on Windows) error = %v, want ErrConfigValidation\", err)\n98|\t}\n99|\n100|\tconpty := append(minimalValidConfigVersion(scalar.PlatformWindows, Version1), []byte(\"\\n[terminal]\\nbackend = \\\"conpty\\\"\\n\")...)\n101|\tloaded, err := Decode(conpty, DecodeContext{RuntimePlatform: scalar.PlatformWindows})\n102|\tif err != nil {\n103|\t\tt.Fatalf(\"Decode(v1 backend=conpty on Windows) error = %v\", err)\n104|\t}\n105|\tif loaded.Value.Terminal.BackendID != \"ax.conpty\" {\n106|\t\tt.Fatalf(\"migrated terminal backend = %q, want ax.conpty\", loaded.Value.Terminal.BackendID)\n107|\t}\n108|}"}}}
