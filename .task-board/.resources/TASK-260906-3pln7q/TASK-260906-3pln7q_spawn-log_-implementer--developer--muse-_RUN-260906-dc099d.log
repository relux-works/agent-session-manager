{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c88f","stream":{"kind":"session","id":"01a0785b-9847-7fa3-b40c-313061570fc0"},"sequence":674,"recorded_at":1780531400001343,"record_type":"event","durability":"durable","causation_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","run_stream":{"kind":"run","id":"5f283545-6d77-4246-bbdf-5a980fc43a74"},"task_stream":{"kind":"task","id":"a349f650-50b2-4b87-993d-3947ab3c7a26"},"task_id":"a349f650-50b2-4b87-993d-3947ab3c7a26","event":{"kind":"output","task_id":"a349f650-50b2-4b87-993d-3947ab3c7a26","chunk":"Read text file `internal/sessadapter/decode.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"regexp\"\n8|\t\"strings\"\n9|\t\"unicode/utf8\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|)\n14|\n15|// This file holds parse-only helpers for every Section 7.8 closed\n16|// body. Every helper reports a verdict and never refuses: all refusals\n17|// call one of the refusal constructors directly at the deciding site\n18|// with a literal detail, so the refusal-arm inventory keeps seeing\n19|// every arm. A helper that fronted a constructor would collapse\n20|// distinct rules into one obligation and is not used here.\n21|\n22|// maxUint53 is the largest exactly representable JSON integer:\n23|// Section 7.8 counts and limits are uint53 throughout.\n24|const maxUint53 = uint64(1<<53 - 1)\n25|\n26|// frameFault is one strict-decode failure: what was wrong and which\n27|// member it was found in, if any. It never carries foreign bytes.\n28|type frameFault struct {\n29|\tdetail string\n30|\tmember string\n31|}\n32|\n33|// decodeStrictObject parses one complete JSON object with duplicate\n34|// member rejection. It is the only JSON entry point in this package:\n35|// every body crosses it before any member is read. The frame verdict\n36|// itself is the shared environ verdict: this function delegates to\n37|// environ.DecodeStrictObject and translates the fault into the\n38|// package refusal dialect without reimplementing any rule, so the\n39|// two can never drift. The delegated string-walk surrogate gate\n40|// refuses a real lone escape behind an even backslash run and\n41|// admits quoted backslash-u text; the raw byte scan this replaces\n42|// misread the quoted text as a high surrogate and admitted the\n43|// real lone escape behind it. A non-UTF-8 frame, a lone surrogate\n44|// escape, a non-object top level, a duplicated member, or trailing\n45|// data is a fault, never a partial object the caller could mistake\n46|// for a result.\n47|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n48|\tmembers, fault := environ.DecodeStrictObject(data)\n49|\tif fault != nil {\n50|\t\treturn nil, &frameFault{detail: fault.Detail, member: fault.Member}\n51|\t}\n52|\treturn members, nil\n53|}\n54|\n55|// unknownMember names a member outside the closed set, if any. The\n56|// single-unknown fixtures keep the verdict deterministic: with\n57|// several unknowns the map order decides which is named, so tests\n58|// never assert a name from a multi-unknown body.\n59|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n60|\tfor name := range members {\n61|\t\tif !allowed[name] {\n62|\t\t\treturn name, true\n63|\t\t}\n64|\t}\n65|\treturn \"\", false\n66|}\n67|\n68|// missingMember names the first required member with no value, if\n69|// any. The required list is fixed order, so the verdict is\n70|// deterministic for every missing combination.\n71|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n72|\tfor _, name := range required {\n73|\t\tif _, present := members[name]; !present {\n74|\t\t\treturn name, true\n75|\t\t}\n76|\t}\n77|\treturn \"\", false\n78|}\n79|\n80|// rawString reads a JSON string member.\n81|func rawString(raw json.RawMessage) (string, bool) {\n82|\tvar value string\n83|\tif err := json.Unmarshal(raw, &value); err != nil {\n84|\t\treturn \"\", false\n85|\t}\n86|\treturn value, true\n87|}\n88|\n89|// rawBool reads a JSON boolean member.\n90|func rawBool(raw json.RawMessage) (bool, bool) {\n91|\tvar value bool\n92|\tif err := json.Unmarshal(raw, &value); err != nil {\n93|\t\treturn false, false\n94|\t}\n95|\treturn value, true\n96|}\n97|\n98|// rawUint53 reads an unsigned integral JSON number in [0, 2^53-1]. A\n99|// fraction, exponent, sign, or out-of-range magnitude is not a uint53,\n100|// even when it names the same mathematical value: the canonical\n101|// bodies carry counts, never measurements.\n102|func rawUint53(raw json.RawMessage) (uint64, bool) {\n103|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n104|\tdecoder.UseNumber()\n105|\tvar value any\n106|\tif err := decoder.Decode(&value); err != nil {\n107|\t\treturn 0, false\n108|\t}\n109|\tnumber, ok := value.(json.Number)\n110|\tif !ok {\n111|\t\treturn 0, false\n112|\t}\n113|\tliteral := number.String()\n114|\tif literal == \"\" || strings.ContainsAny(literal, \".eE+-\") {\n115|\t\treturn 0, false\n116|\t}\n117|\treturn parseUint53Literal(literal)\n118|}\n119|\n120|// parseUint53Literal reads a digit-only literal without trusting a\n121|// float conversion: the magnitude bound is checked on the digit\n122|// string, so 2^53 is refused even on platforms that could hold it.\n123|func parseUint53Literal(literal string) (uint64, bool) {\n124|\tvar value uint64\n125|\tfor index := 0; index < len(literal); index++ {\n126|\t\tdigit := literal[index]\n127|\t\tif digit < '0' || digit > '9' {\n128|\t\t\treturn 0, false\n129|\t\t}\n130|\t\tvalue = value*10 + uint64(digit-'0')\n131|\t\tif value > maxUint53 {\n132|\t\t\treturn 0, false\n133|\t\t}\n134|\t}\n135|\treturn value, true\n136|}\n137|\n138|// stringLength is the Section 1.6 string measure in characters, not\n139|// bytes: a bound of string[1..128] admits 128 characters of any\n140|// width.\n141|func stringLength(value string) int {\n142|\treturn utf8.RuneCountInString(value)\n143|}\n144|\n145|// checkStringBounds reports whether the member is a JSON string whose\n146|// character count falls in the inclusive bound.\n147|func checkStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n148|\tvalue, ok := rawString(raw)\n149|\tif !ok {\n150|\t\treturn \"\", false\n151|\t}\n152|\tlength := stringLength(value)\n153|\tif length < minimum || length > maximum {\n154|\t\treturn \"\", false\n155|\t}\n156|\treturn value, true\n157|}\n158|\n159|// checkUint53Bounds reports whether the member is a uint53 in the\n160|// inclusive bound. Both edges are checked: a one-sided check would\n161|// admit the open side.\n162|func checkUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n163|\tvalue, ok := rawUint53(raw)\n164|\tif !ok {\n165|\t\treturn 0, false\n166|\t}\n167|\tif value < minimum || value > maximum {\n168|\t\treturn 0, false\n169|\t}\n170|\treturn value, true\n171|}\n172|\n173|// checkDigest reports whether the member is a digest of the pinned\n174|// sha256 form.\n175|func checkDigest(raw json.RawMessage) (scalar.Digest, bool) {\n176|\tvalue, ok := rawString(raw)\n177|\tif !ok {\n178|\t\treturn scalar.Digest{}, false\n179|\t}\n180|\tdigest, err := scalar.ParseDigest(value)\n181|\tif err != nil {\n182|\t\treturn scalar.Digest{}, false\n183|\t}\n184|\treturn digest, true\n185|}\n186|\n187|// checkUUIDv7 reports whether the member is a lowercase UUIDv7.\n188|func checkUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n189|\tvalue, ok := rawString(raw)\n190|\tif !ok {\n191|\t\treturn scalar.UUIDv7{}, false\n192|\t}\n193|\tidentifier, err := scalar.ParseUUIDv7(value)\n194|\tif err != nil {\n195|\t\treturn scalar.UUIDv7{}, false\n196|\t}\n197|\treturn identifier, true\n198|}\n199|\n200|// checkTimestamp reports whether the member is a pinned timestamp.\n201|func checkTimestamp(raw json.RawMessage) (scalar.Timestamp, bool) {\n202|\tvalue, ok := rawString(raw)\n203|\tif !ok {\n204|\t\treturn scalar.Timestamp{}, false\n205|\t}\n206|\tinstant, err := scalar.ParseTimestamp(value)\n207|\tif err != nil {\n208|\t\treturn scalar.Timestamp{}, false\n209|\t}\n210|\treturn instant, true\n211|}\n212|\n213|// isNull reports whether the member is an explicit JSON null.\n214|func isNull(raw json.RawMessage) bool {\n215|\treturn string(bytes.TrimSpace(raw)) == \"null\"\n216|}\n217|\n218|// decodeArray reads a JSON array member into its raw elements. A\n219|// non-array — including null — is not an empty array.\n220|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n221|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n222|\ttoken, err := decoder.Token()\n223|\tif err != nil {\n224|\t\treturn nil, false\n225|\t}\n226|\tdelim, ok := token.(json.Delim)\n227|\tif !ok || delim != '[' {\n228|\t\treturn nil, false\n229|\t}\n230|\tvar elements []json.RawMessage\n231|\tfor decoder.More() {\n232|\t\tvar element json.RawMessage\n233|\t\tif err := decoder.Decode(&element); err != nil {\n234|\t\t\treturn nil, false\n235|\t\t}\n236|\t\telements = append(elements, element)\n237|\t}\n238|\tif token, err := decoder.Token(); err != nil {\n239|\t\treturn nil, false\n240|\t} else if delim, ok := token.(json.Delim); !ok || delim != ']' {\n241|\t\treturn nil, false\n242|\t}\n243|\tif _, err := decoder.Token(); err != io.EOF {\n244|\t\treturn nil, false\n245|\t}\n246|\treturn elements, true\n247|}\n248|\n249|// checkSortedUniqueStrings reports whether the member is an array of\n250|// strings in the item bound whose JCS encodings order strictly\n251|// increasingly with no duplicates. Bytewise JCS order over strings\n252|// is plain lexicographic order, so the check compares directly; the\n253|// count bound is checked on both edges.\n254|func checkSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n255|\telements, ok := decodeArray(raw)\n256|\tif !ok {\n257|\t\treturn nil, false\n258|\t}\n259|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n260|\t\treturn nil, false\n261|\t}\n262|\tvalues := make([]string, 0, len(elements))\n263|\tfor _, element := range elements {\n264|\t\tvalue, ok := rawString(element)\n265|\t\tif !ok {\n266|\t\t\treturn nil, false\n267|\t\t}\n268|\t\tlength := stringLength(value)\n269|\t\tif length < minimumLength || length > maximumLength {\n270|\t\t\treturn nil, false\n271|\t\t}\n272|\t\tvalues = append(values, value)\n273|\t}\n274|\tfor index := 1; index < len(values); index++ {\n275|\t\tif values[index-1] >= values[index] {\n276|\t\t\treturn nil, false\n277|\t\t}\n278|\t}\n279|\treturn values, true\n280|}\n281|\n282|// checkSortedUniqueDigests reports whether the member is a sorted\n283|// unique digest array in the count bound.\n284|func checkSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n285|\telements, ok := decodeArray(raw)\n286|\tif !ok {\n287|\t\treturn nil, false\n288|\t}\n289|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n290|\t\treturn nil, false\n291|\t}\n292|\tvalues := make([]scalar.Digest, 0, len(elements))\n293|\tfor _, element := range elements {\n294|\t\tdigest, ok := checkDigest(element)\n295|\t\tif !ok {\n296|\t\t\treturn nil, false\n297|\t\t}\n298|\t\tvalues = append(values, digest)\n299|\t}\n300|\tfor index := 1; index < len(values); index++ {\n301|\t\tif values[index-1].String() >= values[index].String() {\n302|\t\t\treturn nil, false\n303|\t\t}\n304|\t}\n305|\treturn values, true\n306|}\n307|\n308|// semverPattern is the SemVer grammar adapter and environment\n309|// versions satisfy: three dot-separated non-negative integers with\n310|// no leading zeros, an optional pre-release, and optional build\n311|// metadata.\n312|var semverPattern = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n313|\n314|// providerIDPattern is the Section 7.1 provider-id grammar the\n315|// manifest, context, and binding layers read:\n316|// [a-z][a-z0-9-]{0,31}.\n317|var providerIDPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,31}$`)\n318|\n319|// environmentIDPattern is the Section 7.8 environment-id grammar:\n320|// [a-z][a-z0-9.-]{0,63}. One semantic native environment per\n321|// adapter; dots separate the native hierarchy, never trust.\n322|var environmentIDPattern = regexp.MustCompile(`^[a-z][a-z0-9.-]{0,63}$`)\n323|\n324|// reverseDNSPattern is the Section 1.6 extension-key grammar:\n325|// dot-separated lowercase labels, 3..253 characters.\n326|var reverseDNSPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,62}(\\.[a-z][a-z0-9-]{0,62})+$`)\n327|\n328|// checkExtensions reports whether the member is an object whose keys\n329|// are all reverse-DNS names. Values cross opaquely: extensions\n330|// cannot add operations, capabilities, or trust facts, and no member\n331|// of this package reads an extension value for any admission\n332|// decision.\n333|func checkExtensions(raw json.RawMessage) bool {\n334|\tmembers, fault := decodeStrictObject(raw)\n335|\tif fault != nil {\n336|\t\treturn false\n337|\t}\n338|\tfor name := range members {\n339|\t\tif len(name) < 3 || len(name) > 253 || !reverseDNSPattern.MatchString(name) {\n340|\t\t\treturn false\n341|\t\t}\n342|\t}\n343|\treturn true\n344|}"}}}
