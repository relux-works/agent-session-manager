{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c893","stream":{"kind":"session","id":"01a0785b-9847-7fa3-b40c-313061570fc0"},"sequence":676,"recorded_at":1780531400001347,"record_type":"event","durability":"durable","causation_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","run_stream":{"kind":"run","id":"5f283545-6d77-4246-bbdf-5a980fc43a74"},"call_id":"call_01a0785eacf274238bc7370c009e38d5","text":"Read text file `internal/sessadapter/decode.go`.\n1|package sessadapter\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"regexp\"\n8|\t\"strings\"\n9|\t\"unicode/utf8\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|)\n14|\n15|// This file holds parse-only helpers for every Section 7.8 closed\n16|// body. Every helper reports a verdict and never refuses: all refusals\n17|// call one of the refusal constructors directly at the deciding site\n18|// with a literal detail, so the refusal-arm inventory keeps seeing\n19|// every arm. A helper that fronted a constructor would collapse\n20|// distinct rules into one obligation and is not used here.\n21|\n22|// maxUint53 is the largest exactly representable JSON integer:\n23|// Section 7.8 counts and limits are uint53 throughout.\n24|const maxUint53 = uint64(1<<53 - 1)\n25|\n26|// frameFault is one strict-decode failure: what was wrong and which\n27|// member it was found in, if any. It never carries foreign bytes.\n28|type frameFault struct {\n29|\tdetail string\n30|\tmember string\n31|}\n32|\n33|// decodeStrictObject parses one complete JSON object with duplicate\n34|// member rejection. It is the only JSON entry point in this package:\n35|// every body crosses it before any member is read. The frame verdict\n36|// itself is the shared environ verdict: this function delegates to\n37|// environ.DecodeStrictObject and translates the fault into the\n38|// package refusal dialect without reimplementing any rule, so the\n39|// two can never drift. The delegated string-walk surrogate gate\n40|// refuses a real lone escape behind an even backslash run and\n41|// admits quoted backslash-u text; the raw byte scan this replaces\n42|// misread the quoted text as a high surrogate and admitted the\n43|// real lone escape behind it. A non-UTF-8 frame, a lone surrogate\n44|// escape, a non-object top level, a duplicated member, or trailing\n45|// data is a fault, never a partial object the caller could mistake\n46|// for a result.\n47|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n48|\tmembers, fault := environ.DecodeStrictObject(data)\n49|\tif fault != nil {\n50|\t\treturn nil, &frameFault{detail: fault.Detail, member: fault.Member}\n51|\t}\n52|\treturn members, nil\n53|}\n54|\n55|// unknownMember names a member outside the closed set, if any. The\n56|// single-unknown fixtures keep the verdict deterministic: with\n57|// several unknowns the map order decides which is named, so tests\n58|// never assert a name from a multi-unknown body.\n59|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n60|\tfor name := range members {\n61|\t\tif !allowed[name] {\n62|\t\t\treturn name, true\n63|\t\t}\n64|\t}\n65|\treturn \"\", false\n66|}\n67|\n68|// missingMember names the first required member with no value, if\n69|// any. The required list is fixed order, so the verdict is\n70|// deterministic for every missing combination.\n71|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n72|\tfor _, name := range required {\n73|\t\tif _, present := members[name]; !present {\n74|\t\t\treturn name, true\n75|\t\t}\n76|\t}\n77|\treturn \"\", false\n78|}\n79|\n80|// rawString reads a JSON string member.\n81|func rawString(raw json.RawMessage) (string, bool) {\n82|\tvar value string\n83|\tif err := json.Unmarshal(raw, &value); err != nil {\n84|\t\treturn \"\", false\n85|\t}\n86|\treturn value, true\n87|}\n88|\n89|// rawBool reads a JSON boolean member.\n90|func rawBool(raw json.RawMessage) (bool, bool) {\n91|\tvar value bool\n92|\tif err := json.Unmarshal(raw, &value); err != nil {\n93|\t\treturn false, false\n94|\t}\n95|\treturn value, true\n96|}\n97|\n98|// rawUint53 reads an unsigned integral JSON number in [0, 2^53-1]. A\n99|// fraction, exponent, sign, or out-of-range magnitude is not a uint53,\n100|// even when it names the same mathematical value: the canonical\n101|// bodies carry counts, never measurements.\n102|func rawUint53(raw json.RawMessage) (uint64, bool) {\n103|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n104|\tdecoder.UseNumber()\n105|\tvar value any\n106|\tif err := decoder.Decode(&value); err != nil {\n107|\t\treturn 0, false\n108|\t}\n109|\tnumber, ok := value.(json.Number)\n110|\tif !ok {\n111|\t\treturn 0, false\n112|\t}\n113|\tliteral := number.String()\n114|\tif literal == \"\" || strings.ContainsAny(literal, \".eE+-\") {\n115|\t\treturn 0, false\n116|\t}\n117|\treturn parseUint53Literal(literal)\n118|}\n119|\n120|// parseUint53Literal reads a digit-only literal without trusting a\n121|// float conversion: the magnitude bound is checked on the digit\n122|// string, so 2^53 is refused even on platforms that could hold it.\n123|func parseUint53Literal(literal string) (uint64, bool) {\n124|\tvar value uint64\n125|\tfor index := 0; index < len(literal); index++ {\n126|\t\tdigit := literal[index]\n127|\t\tif digit < '0' || digit > '9' {\n128|\t\t\treturn 0, false\n129|\t\t}\n130|\t\tvalue = value*10 + uint64(digit-'0')\n131|\t\tif value > maxUint53 {\n132|\t\t\treturn 0, false\n133|\t\t}\n134|\t}\n135|\treturn value, true\n136|}\n137|\n138|// stringLength is the Section 1.6 string measure in characters, not\n139|// bytes: a bound of string[1..128] admits 128 characters of any\n140|// width.\n141|func stringLength(value string) int {\n142|\treturn utf8.RuneCountInString(value)\n143|}\n144|\n145|// checkStringBounds reports whether the member is a JSON string whose\n146|// character count falls in the inclusive bound.\n147|func checkStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n148|\tvalue, ok := rawString(raw)\n149|\tif !ok {\n150|\t\treturn \"\", false\n151|\t}\n152|\tlength := stringLength(value)\n153|\tif length < minimum || length > maximum {\n154|\t\treturn \"\", false\n155|\t}\n156|\treturn value, true\n157|}\n158|\n159|// checkUint53Bounds reports whether the member is a uint53 in the\n160|// inclusive bound. Both edges are checked: a one-sided check would\n161|// admit the open side.\n162|func checkUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n163|\tvalue, ok := rawUint53(raw)\n164|\tif !ok {\n165|\t\treturn 0, false\n166|\t}\n167|\tif value < minimum || value > maximum {\n168|\t\treturn 0, false\n169|\t}\n170|\treturn value, true\n171|}\n172|\n173|// checkDigest reports whether the member is a digest of the pinned\n174|// sha256 form.\n175|func checkDigest(raw json.RawMessage) (scalar.Digest, bool) {\n176|\tvalue, ok := rawString(raw)\n177|\tif !ok {\n178|\t\treturn scalar.Digest{}, false\n179|\t}\n180|\tdigest, err := scalar.ParseDigest(value)\n181|\tif err != nil {\n182|\t\treturn scalar.Digest{}, false\n183|\t}\n184|\treturn digest, true\n185|}\n186|\n187|// checkUUIDv7 reports whether the member is a lowercase UUIDv7.\n188|func checkUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n189|\tvalue, ok := rawString(raw)\n190|\tif !ok {\n191|\t\treturn scalar.UUIDv7{}, false\n192|\t}\n193|\tidentifier, err := scalar.ParseUUIDv7(value)\n194|\tif err != nil {\n195|\t\treturn scalar.UUIDv7{}, false\n196|\t}\n197|\treturn identifier, true\n198|}\n199|\n200|// checkTimestamp reports whether the member is a pinned timestamp.\n201|func checkTimestamp(raw json.RawMessage) (scalar.Timestamp, bool) {\n202|\tvalue, ok := rawString(raw)\n203|\tif !ok {\n204|\t\treturn scalar.Timestamp{}, false\n205|\t}\n206|\tinstant, err := scalar.ParseTimestamp(value)\n207|\tif err != nil {\n208|\t\treturn scalar.Timestamp{}, false\n209|\t}\n210|\treturn instant, true\n211|}\n212|\n213|// isNull reports whether the member is an explicit JSON null.\n214|func isNull(raw json.RawMessage) bool {\n215|\treturn string(bytes.TrimSpace(raw)) == \"null\"\n216|}\n217|\n218|// decodeArray reads a JSON array member into its raw elements. A\n219|// non-array — including null — is not an empty array.\n220|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n221|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n222|\ttoken, err := decoder.Token()\n223|\tif err != nil {\n224|\t\treturn nil, false\n225|\t}\n226|\tdelim, ok := token.(json.Delim)\n227|\tif !ok || delim != '[' {\n228|\t\treturn nil, false\n229|\t}\n230|\tvar elements []json.RawMessage\n231|\tfor decoder.More() {\n232|\t\tvar element json.RawMessage\n233|\t\tif err := decoder.Decode(&element); err != nil {\n234|\t\t\treturn nil, false\n235|\t\t}\n236|\t\telements = append(elements, element)\n237|\t}\n238|\tif token, err := decoder.Token(); err != nil {\n239|\t\treturn nil, false\n240|\t} else if delim, ok := token.(json.Delim); !ok || delim != ']' {\n241|\t\treturn nil, false\n242|\t}\n243|\tif _, err := decoder.Token(); err != io.EOF {\n244|\t\treturn nil, false\n245|\t}\n246|\treturn elements, true\n247|}\n248|\n249|// checkSortedUniqueStrings reports whether the member is an array of\n250|// strings in the item bound whose JCS encodings order strictly\n251|// increasingly with no duplicates. Bytewise JCS order over strings\n252|// is plain lexicographic order, so the check compares directly; the\n253|// count bound is checked on both edges.\n254|func checkSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n255|\telements, ok := decodeArray(raw)\n256|\tif !ok {\n257|\t\treturn nil, false\n258|\t}\n259|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n260|\t\treturn nil, false\n261|\t}\n262|\tvalues := make([]string, 0, len(elements))\n263|\tfor _, element := range elements {\n264|\t\tvalue, ok := rawString(element)\n265|\t\tif !ok {\n266|\t\t\treturn nil, false\n267|\t\t}\n268|\t\tlength := stringLength(value)\n269|\t\tif length < minimumLength || length > maximumLength {\n270|\t\t\treturn nil, false\n271|\t\t}\n272|\t\tvalues = append(values, value)\n273|\t}\n274|\tfor index := 1; index < len(values); index++ {\n275|\t\tif values[index-1] >= values[index] {\n276|\t\t\treturn nil, false\n277|\t\t}\n278|\t}\n279|\treturn values, true\n280|}\n281|\n282|// checkSortedUniqueDigests reports whether the member is a sorted\n283|// unique digest array in the count bound.\n284|func checkSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n285|\telements, ok := decodeArray(raw)\n286|\tif !ok {\n287|\t\treturn nil, false\n288|\t}\n289|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n290|\t\treturn nil, false\n291|\t}\n292|\tvalues := make([]scalar.Digest, 0, len(elements))\n293|\tfor _, element := range elements {\n294|\t\tdigest, ok := checkDigest(element)\n295|\t\tif !ok {\n296|\t\t\treturn nil, false\n297|\t\t}\n298|\t\tvalues = append(values, digest)\n299|\t}\n300|\tfor index := 1; index < len(values); index++ {\n301|\t\tif values[index-1].String() >= values[index].String() {\n302|\t\t\treturn nil, false\n303|\t\t}\n304|\t}\n305|\treturn values, true\n306|}\n307|\n308|// semverPattern is the SemVer grammar adapter and environment\n309|// versions satisfy: three dot-separated non-negative integers with\n310|// no leading zeros, an optional pre-release, and optional build\n311|// metadata.\n312|var semverPattern = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n313|\n314|// providerIDPattern is the Section 7.1 provider-id grammar the\n315|// manifest, context, and binding layers read:\n316|// [a-z][a-z0-9-]{0,31}.\n317|var providerIDPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,31}$`)\n318|\n319|// environmentIDPattern is the Section 7.8 environment-id grammar:\n320|// [a-z][a-z0-9.-]{0,63}. One semantic native environment per\n321|// adapter; dots separate the native hierarchy, never trust.\n322|var environmentIDPattern = regexp.MustCompile(`^[a-z][a-z0-9.-]{0,63}$`)\n323|\n324|// reverseDNSPattern is the Section 1.6 extension-key grammar:\n325|// dot-separated lowercase labels, 3..253 characters.\n326|var reverseDNSPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,62}(\\.[a-z][a-z0-9-]{0,62})+$`)\n327|\n328|// checkExtensions reports whether the member is an object whose keys\n329|// are all reverse-DNS names. Values cross opaquely: extensions\n330|// cannot add operations, capabilities, or trust facts, and no member\n331|// of this package reads an extension value for any admission\n332|// decision.\n333|func checkExtensions(raw json.RawMessage) bool {\n334|\tmembers, fault := decodeStrictObject(raw)\n335|\tif fault != nil {\n336|\t\treturn false\n337|\t}\n338|\tfor name := range members {\n339|\t\tif len(name) < 3 || len(name) > 253 || !reverseDNSPattern.MatchString(name) {\n340|\t\t\treturn false\n341|\t\t}\n342|\t}\n343|\treturn true\n344|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c895","stream":{"kind":"session","id":"01a0785b-9847-7fa3-b40c-313061570fc0"},"sequence":677,"recorded_at":1780531400001349,"record_type":"event","durability":"durable","causation_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","run_stream":{"kind":"run","id":"5f283545-6d77-4246-bbdf-5a980fc43a74"},"call_id":"call_01a0785ead9d7af18876cdf4cb8c27d5","text":"Read text file `internal/environ/identity_agreement_test.go`.\n1|package environ_test\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n13|)\n14|\n15|// This file is the Provider Identity agreement battery. Two\n16|// validators implement the Section 5.5 shape rule-for-rule:\n17|// provhost.CheckIdentity mints provider-stdio refusals while\n18|// canonicaljson validates the same record through the closed\n19|// identity shape on the way to its object identity. A shape-rule\n20|// change must land in both validators in the same change, and\n21|// this battery is what fails when it lands in only one: every\n22|// row drives one shared vector through both production entries\n23|// and requires identical verdicts with the full rendering on\n24|// each side.\n25|//\n26|// One split is by design, not drift: provider equality (the\n27|// record naming the expected provider) is a caller-correlation\n28|// rule the host enforces, not a content rule the identity\n29|// calculation owns. The another-provider row ledgers that split\n30|// exactly — provhost refuses invalid_config while the\n31|// canonicalizer accepts — so a content-rule divergence cannot\n32|// hide behind it and a change to the split reddens here.\n33|\n34|// identityRow is one agreement vector: the body, the provhost\n35|// rule phrase, and the canonicalizer rule phrase. Empty phrases\n36|// mean both entries accept.\n37|type identityRow struct {\n38|\tname      string\n39|\tbody      []byte\n40|\tprovText  string\n41|\tcanonText string\n42|}\n43|\n44|// identityCorpus mutates each identity member alone against an\n45|// otherwise-valid record over the shared fixture identities.\n46|func identityCorpus(t *testing.T) []identityRow {\n47|\tt.Helper()\n48|\tvalid := validIdentityJSON()\n49|\tdrop := func(member string) []byte { return dropMember(t, valid, member) }\n50|\tset := func(member, literal string) []byte { return mutateMember(t, valid, member, literal) }\n51|\totherSubject := jsonQuote(fixtureCreatorHostID)\n52|\treturn []identityRow{\n53|\t\t{\"valid\", valid, \"\", \"\"},\n54|\t\t{\"unknown member\", appendMember(t, valid, \"score\", `1`), \"identity carries unknown member\", \"unknown member\"},\n55|\t\t{\"missing opaque\", drop(\"opaque_identity\"), \"identity misses a required member\", \"required member\"},\n56|\t\t// Schema dispatch precedes shape validation in the\n57|\t\t// canonicalizer: a wrong schema or version refuses at\n58|\t\t// the dispatch registry, never reaching the identity\n59|\t\t// rules provhost enforces as member arms. Same\n60|\t\t// verdict, different arm by construction; a schema\n61|\t\t// change must update the dispatch registry and both\n62|\t\t// validators together.\n63|\t\t{\"wrong schema\", set(\"schema\", `\"urn:ax:schema:provider-manifest\"`), \"identity schema is not the provider identity\", \"has no supported immutable self-identity contract\"},\n64|\t\t{\"wrong version\", set(\"schema_version\", `\"1.1.0\"`), \"identity schema_version is not 1.0.0\", \"has no supported immutable self-identity contract\"},\n65|\t\t{\"bad record digest\", set(\"record_id\", `\"sha256:zzzz\"`), \"identity record_id is not a digest\", \"record_id\"},\n66|\t\t{\"bad subject uuid\", set(\"subject_id\", `\"not-a-uuid\"`), \"identity subject_id is not a UUIDv7\", \"subject_id\"},\n67|\t\t{\"subject differs\", set(\"subject_id\", otherSubject), \"identity subject_id does not equal session_id\", \"subject_id must equal session_id\"},\n68|\t\t{\"session differs\", set(\"session_id\", otherSubject), \"identity subject_id does not equal session_id\", \"subject_id must equal session_id\"},\n69|\t\t{\"bad provider grammar\", set(\"provider_id\", `\"Antigravity\"`), \"identity provider_id is not a provider id\", \"provider_id\"},\n70|\t\t{\"empty version\", set(\"provider_version\", `\"\"`), \"identity provider_version is not 1..128 characters\", \"provider_version\"},\n71|\t\t{\"long version\", set(\"provider_version\", jsonQuote(strings.Repeat(\"v\", 129))), \"identity provider_version is not 1..128 characters\", \"provider_version\"},\n72|\t\t{\"empty range\", set(\"provider_version_range\", `\"\"`), \"identity provider_version_range is not 1..256 characters\", \"provider_version_range\"},\n73|\t\t{\"empty native id\", set(\"native_session_id\", `\"\"`), \"identity native_session_id is not 1..512 characters\", \"native_session_id\"},\n74|\t\t{\"unknown kind\", set(\"identity_kind\", `\"telepathy\"`), \"identity kind is not a registry member\", \"identity_kind\"},\n75|\t\t{\"bad workspace uuid\", set(\"logical_workspace_id\", `\"not-a-uuid\"`), \"identity workspace is not a UUIDv7\", \"logical_workspace_id\"},\n76|\t\t{\"bad realm\", set(\"backend_realm_fingerprint\", `\"sha256:zzzz\"`), \"identity realm is not a digest or null\", \"backend_realm_fingerprint\"},\n77|\t\t{\"null realm refused\", set(\"backend_realm_fingerprint\", `null`), \"identity realm is required for this backend kind\", \"must be non-null for Antigravity\"},\n78|\t\t{\"opaque array refused\", set(\"opaque_identity\", `[]`), \"not a JSON object\", \"opaque_identity\"},\n79|\t\t{\"opaque 33 keys refused\", set(\"opaque_identity\", opaqueKeysJSON(33)), \"exceeds 32 entries\", \"exceeds maximum length 32\"},\n80|\t\t{\"opaque bad key\", set(\"opaque_identity\", `{\"K\":\"v\"}`), \"identity opaque key is not a provider key\", \"must match\"},\n81|\t\t{\"opaque empty value\", set(\"opaque_identity\", `{\"k\":\"\"}`), \"identity opaque value is not 1..1024 characters\", \"1..1024\"},\n82|\t\t{\"opaque absolute path\", set(\"opaque_identity\", `{\"k\":\"/etc/passwd\"}`), \"begins with an absolute path\", \"must not begin with an absolute path\"},\n83|\t\t{\"bad creator uuid\", set(\"created_by_host_id\", `\"not-a-uuid\"`), \"identity host is not a UUIDv7\", \"created_by_host_id\"},\n84|\t\t{\"bad timestamp\", set(\"created_at\", `\"yesterday\"`), \"identity timestamp is not a timestamp\", \"created_at\"},\n85|\t\t{\"extensions array refused\", set(\"extensions\", `[]`), \"identity extensions is not an object\", \"extensions\"},\n86|\t\t{\"lone escape refused\", set(\"opaque_identity\", `{\"k\":\"A`+rawLoneHigh+`B\"}`), \"lone surrogate escape\", \"surrogate\"},\n87|\t\t{\"escaped text admits\", set(\"opaque_identity\", `{\"k\":\"A`+rawEscapedHigh+`B\"}`), \"\", \"\"},\n88|\t}\n89|}\n90|\n91|// Raw escape fragments. rawLoneHigh is a real lone high escape\n92|// in JSON source; rawEscapedHigh is an escaped backslash\n93|// followed by text, which carries no escape at all. Both are\n94|// package variables (not literals) so the Go compiler never\n95|// sees an invalid \\u escape in source.\n96|var (\n97|\trawLoneHigh    = \"\\\\ud800\"\n98|\trawEscapedHigh = \"\\\\\\\\ud800\"\n99|)\n100|\n101|// opaqueKeysJSON builds an opaque_identity object with count\n102|// grammar-valid keys.\n103|func opaqueKeysJSON(count int) string {\n104|\tparts := make([]string, 0, count)\n105|\tfor index := 0; index < count; index++ {\n106|\t\tparts = append(parts, `\"k`+twoDigits(index)+`\":\"v\"`)\n107|\t}\n108|\treturn \"{\" + strings.Join(parts, \",\") + \"}\"\n109|}\n110|\n111|func twoDigits(value int) string {\n112|\tdigits := \"0123456789\"\n113|\treturn string([]byte{digits[value/10%10], digits[value%10]})\n114|}\n115|\n116|// TestIdentityAgreementAcrossValidators drives the corpus\n117|// through both identity entries and requires identical verdicts\n118|// with the full rule rendering on each side.\n119|func TestIdentityAgreementAcrossValidators(t *testing.T) {\n120|\tfor _, row := range identityCorpus(t) {\n121|\t\tt.Run(row.name, func(t *testing.T) {\n122|\t\t\tprovErr := provhost.CheckIdentity(row.body, \"antigravity\")\n123|\t\t\t_, _, canonErr := canonicaljson.CalculateObjectIdentity(row.body)\n124|\t\t\tif row.provText == \"\" && row.canonText == \"\" {\n125|\t\t\t\tif provErr != nil {\n126|\t\t\t\t\tt.Fatalf(\"provhost refused %s: %v\", row.body, provErr)\n127|\t\t\t\t}\n128|\t\t\t\tif canonErr != nil {\n129|\t\t\t\t\tt.Fatalf(\"canonicaljson refused %s: %v\", row.body, canonErr)\n130|\t\t\t\t}\n131|\t\t\t\treturn\n132|\t\t\t}\n133|\t\t\tif provErr == nil {\n134|\t\t\t\tt.Fatalf(\"provhost admitted %s, want rule %q\", row.body, row.provText)\n135|\t\t\t}\n136|\t\t\tif canonErr == nil {\n137|\t\t\t\tt.Fatalf(\"canonicaljson admitted %s, want rule %q\", row.body, row.canonText)\n138|\t\t\t}\n139|\t\t\tif !strings.Contains(provErr.Error(), row.provText) {\n140|\t\t\t\tt.Fatalf(\"provhost error = %v, want rule %q\", provErr, row.provText)\n141|\t\t\t}\n142|\t\t\tif !strings.Contains(canonErr.Error(), row.canonText) {\n143|\t\t\t\tt.Fatalf(\"canonicaljson error = %v, want rule %q\", canonErr, row.canonText)\n144|\t\t\t}\n145|\t\t})\n146|\t}\n147|}\n148|\n149|// TestIdentityProviderEqualityIsCallerRule ledgers the one\n150|// by-design split: a well-formed record for another provider is\n151|// a caller-correlation failure (invalid_config) at the host,\n152|// while the identity calculation accepts the content. Neither\n153|// side may change its half silently.\n154|func TestIdentityProviderEqualityIsCallerRule(t *testing.T) {\n155|\tbody := mutateMember(t, validIdentityJSON(), \"provider_id\", `\"codex\"`)\n156|\tprovErr := provhost.CheckIdentity(body, \"antigravity\")\n157|\tif provErr == nil {\n158|\t\tt.Fatalf(\"provhost admitted a record for another provider\")\n159|\t}\n160|\tif !strings.Contains(provErr.Error(), \"identity names another provider\") {\n161|\t\tt.Fatalf(\"provhost error = %v, want the caller-correlation arm\", provErr)\n162|\t}\n163|\tif _, _, canonErr := canonicaljson.CalculateObjectIdentity(body); canonErr != nil {\n164|\t\tt.Fatalf(\"canonicaljson refused well-formed content for another provider: %v\", canonErr)\n165|\t}\n166|}\n167|\n168|// TestIdentityMemberTablesAreOneTable requires the provhost\n169|// required-member table and the canonicalizer's exact-member\n170|// list for the identity record to carry the same members in the\n171|// same order: multi-missing determinism is shared behavior.\n172|func TestIdentityMemberTablesAreOneTable(t *testing.T) {\n173|\tmine := deriveRequiredList(t, \"provhost\", \"identity.go\", \"identityRequired\")\n174|\ttheirs := deriveIdentityExactMembers(t)\n175|\tif len(mine) != len(theirs) {\n176|\t\tt.Fatalf(\"identity member tables differ in size:\\nprovhost: %q\\ncanonicaljson: %q\", mine, theirs)\n177|\t}\n178|\tfor index := range mine {\n179|\t\tif mine[index] != theirs[index] {\n180|\t\t\tt.Fatalf(\"identity member tables differ at %d:\\nprovhost: %q\\ncanonicaljson: %q\", index, mine, theirs)\n181|\t\t}\n182|\t}\n183|}\n184|\n185|// deriveIdentityExactMembers derives the member list from the\n186|// requireExactMembers call for the Provider Identity Record in\n187|// canonicaljson production.\n188|func deriveIdentityExactMembers(t *testing.T) []string {\n189|\tt.Helper()\n190|\tpath := mustInternalRoot(t) + \"/canonicaljson/core_records.go\"\n191|\tsource, err := os.ReadFile(path)\n192|\tif err != nil {\n193|\t\tt.Fatalf(\"identity members: %v\", err)\n194|\t}\n195|\tsyntax, err := parser.ParseFile(token.NewFileSet(), path, source, 0)\n196|\tif err != nil {\n197|\t\tt.Fatalf(\"identity members: %v\", err)\n198|\t}\n199|\tfound := false\n200|\tvar members []string\n201|\tast.Inspect(syntax, func(node ast.Node) bool {\n202|\t\tcall, ok := node.(*ast.CallExpr)\n203|\t\tif !ok || found {\n204|\t\t\treturn true\n205|\t\t}\n206|\t\ttarget, ok := call.Fun.(*ast.Ident)\n207|\t\tif !ok || target.Name != \"requireExactMembers\" || len(call.Args) < 3 {\n208|\t\t\treturn true\n209|\t\t}\n210|\t\tfirst, ok := call.Args[0].(*ast.BasicLit)\n211|\t\tif !ok || strings.Trim(first.Value, `\"`) != \"Provider Identity Record\" {\n212|\t\t\treturn true\n213|\t\t}\n214|\t\tfor _, arg := range call.Args[2:] {\n215|\t\t\tliteral, ok := arg.(*ast.BasicLit)\n216|\t\t\tif !ok {\n217|\t\t\t\tt.Fatalf(\"identity members: exact-member list is not literals; the extractor cannot see through indirection\")\n218|\t\t\t}\n219|\t\t\tmembers = append(members, strings.Trim(literal.Value, `\"`))\n220|\t\t}\n221|\t\tfound = true\n222|\t\treturn false\n223|\t})\n224|\tif !found {\n225|\t\tt.Fatal(\"identity members: requireExactMembers call for the Provider Identity Record not found; the extractor is blind\")\n226|\t}\n227|\treturn members\n228|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
