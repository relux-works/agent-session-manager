{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca43","stream":{"kind":"session","id":"01a0785b-9847-7fa3-b40c-313061570fc0"},"sequence":892,"recorded_at":1780531400001779,"record_type":"event","durability":"durable","causation_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","run_stream":{"kind":"run","id":"5f283545-6d77-4246-bbdf-5a980fc43a74"},"task_stream":{"kind":"task","id":"60d5ef95-d106-425d-b984-3b2ccedb816f"},"task_id":"60d5ef95-d106-425d-b984-3b2ccedb816f","event":{"kind":"output","task_id":"60d5ef95-d106-425d-b984-3b2ccedb816f","chunk":"Read text file `internal/terminalbackend/manifest_test.go`.\n1|// Black-box contract tests for Manifest/Probe/Capability-Evidence admission.\n2|//\n3|// Every fixture is built as a JSON member map by an independent test-side\n4|// transcription of the Section 4.B/4.D recipe (own identity computation, own\n5|// signature construction over the documented byte recipe), so agreement with\n6|// production proves byte-exact conformance rather than shared-code\n7|// coincidence. Negative cases mutate exactly one arm, re-finalize the\n8|// document identity (and re-sign evidence when an unsigned field moves), and\n9|// assert the exact wire code at the exact gate.\n10|package terminalbackend_test\n11|\n12|import (\n13|\t\"bytes\"\n14|\t\"crypto\"\n15|\t\"crypto/rand\"\n16|\t\"crypto/rsa\"\n17|\t\"crypto/sha256\"\n18|\t\"encoding/base64\"\n19|\t\"encoding/hex\"\n20|\t\"encoding/json\"\n21|\t\"errors\"\n22|\t\"fmt\"\n23|\t\"sort\"\n24|\t\"strings\"\n25|\t\"testing\"\n26|\t\"time\"\n27|\n28|\t\"github.com/gowebpki/jcs\"\n29|\n30|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n31|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n32|)\n33|\n34|// requireRefusal asserts err is a registry refusal carrying exactly\n35|// wantCode with the exact static wantDetail clause. Code-only assertions\n36|// cannot hold a gate: ~110 of the 121 refusal arms share one wire code, so\n37|// a deleted gate slides its fixture onto a lower arm and a code-only test\n38|// stays green. Naming the clause makes the gate deletion fail.\n39|func requireRefusal(t *testing.T, err error, wantCode, wantDetail string) {\n40|\tt.Helper()\n41|\n42|\tvar refusal *terminalbackend.Error\n43|\tif !errors.As(err, &refusal) {\n44|\t\tt.Fatalf(\"error = %v, want *Error with code %q at %q\", err, wantCode, wantDetail)\n45|\t}\n46|\tif refusal.Code != wantCode || refusal.Detail != wantDetail {\n47|\t\tt.Errorf(\"refusal = %q at %q, want %q at %q\", refusal.Code, refusal.Detail, wantCode, wantDetail)\n48|\t}\n49|}\n50|\n51|const (\n52|\tcodeMismatch           = \"terminal_backend_manifest_probe_mismatch\"\n53|\tcodeCapabilityUnproven = \"terminal_backend_capability_unproven\"\n54|\tcodeIntegrityFailure   = \"terminal_backend_integrity_failure\"\n55|\tcodeUntrusted          = \"terminal_backend_untrusted\"\n56|\tcodeDrift              = \"terminal_backend_implementation_drift\"\n57|\tcodeStaleGeneration    = \"terminal_backend_stale_generation\"\n58|\tcodeNotFound           = \"terminal_backend_not_found\"\n59|)\n60|\n61|// testDigest mints a deterministic fake sha256: digest from one seed byte.\n62|func testSeedDigest(seed byte) string {\n63|\treturn \"sha256:\" + strings.Repeat(fmt.Sprintf(\"%02x\", seed), 32)\n64|}\n65|\n66|// testIdentity computes the Section 4.B omit-self identity with the test's\n67|// own recipe implementation: JCS bytes of the object with the self field\n68|// omitted, SHA-256, lowercase sha256: prefix.\n69|func testIdentity(t *testing.T, object map[string]any, selfField string) string {\n70|\tt.Helper()\n71|\n72|\tomitted := make(map[string]any, len(object))\n73|\tfor name, member := range object {\n74|\t\tif name != selfField {\n75|\t\t\tomitted[name] = member\n76|\t\t}\n77|\t}\n78|\tserialized, err := json.Marshal(omitted)\n79|\tif err != nil {\n80|\t\tt.Fatalf(\"marshal omit-self object: %v\", err)\n81|\t}\n82|\tcanonical, err := jcs.Transform(serialized)\n83|\tif err != nil {\n84|\t\tt.Fatalf(\"canonicalize omit-self object: %v\", err)\n85|\t}\n86|\tsum := sha256.Sum256(canonical)\n87|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n88|}\n89|\n90|// testEvidenceMessage builds the exact bytes an attestation signs per\n91|// Section 4.D: ASCII domain, one zero byte, JCS of the evidence object with\n92|// exactly evidence_id and attestation_signature omitted.\n93|func testEvidenceMessage(t *testing.T, object map[string]any) []byte {\n94|\tt.Helper()\n95|\n96|\tomitted := make(map[string]any, len(object))\n97|\tfor name, member := range object {\n98|\t\tif name != \"evidence_id\" && name != \"attestation_signature\" {\n99|\t\t\tomitted[name] = member\n100|\t\t}\n101|\t}\n102|\tserialized, err := json.Marshal(omitted)\n103|\tif err != nil {\n104|\t\tt.Fatalf(\"marshal unsigned evidence: %v\", err)\n105|\t}\n106|\tcanonical, err := jcs.Transform(serialized)\n107|\tif err != nil {\n108|\t\tt.Fatalf(\"canonicalize unsigned evidence: %v\", err)\n109|\t}\n110|\tmessage := append([]byte(\"ax-terminal-capability-evidence-v1\"), 0x00)\n111|\treturn append(message, canonical...)\n112|}\n113|\n114|// testKey generates one RSA attestation key for the test run.\n115|func testKey(t *testing.T) *rsa.PrivateKey {\n116|\tt.Helper()\n117|\n118|\tkey, err := rsa.GenerateKey(rand.Reader, 1024)\n119|\tif err != nil {\n120|\t\tt.Fatalf(\"generate attestation key: %v\", err)\n121|\t}\n122|\treturn key\n123|}\n124|\n125|// testSignBody signs the Section 4.D message for object with key and writes\n126|// the attestation_signature member.\n127|func testSignBody(t *testing.T, key *rsa.PrivateKey, object map[string]any) {\n128|\tt.Helper()\n129|\n130|\tmessage := testEvidenceMessage(t, object)\n131|\tdigest := sha256.Sum256(message)\n132|\tsignature, err := rsa.SignPKCS1v15(rand.Reader, key, crypto.SHA256, digest[:])\n133|\tif err != nil {\n134|\t\tt.Fatalf(\"sign evidence: %v\", err)\n135|\t}\n136|\tobject[\"attestation_signature\"] = \"rsa-sha256:\" + base64.StdEncoding.EncodeToString(signature)\n137|}\n138|\n139|// finalizeEvidence signs object with key and stamps its recomputed\n140|// evidence_id, yielding a fully valid evidence document map.\n141|func finalizeEvidence(t *testing.T, key *rsa.PrivateKey, object map[string]any) {\n142|\tt.Helper()\n143|\n144|\ttestSignBody(t, key, object)\n145|\tobject[\"evidence_id\"] = testIdentity(t, object, \"evidence_id\")\n146|}\n147|\n148|// finalizeDocument stamps the recomputed omit-self identity on a manifest\n149|// or probe document map.\n150|func finalizeDocument(t *testing.T, object map[string]any, selfField string) {\n(more lines below)"}}}
