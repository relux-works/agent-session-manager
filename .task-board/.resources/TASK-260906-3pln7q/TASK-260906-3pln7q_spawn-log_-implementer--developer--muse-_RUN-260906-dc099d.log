{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c433","stream":{"kind":"session","id":"01a0785b-9847-7fa3-b40c-313061570fc0"},"sequence":116,"recorded_at":1780531400000227,"record_type":"event","durability":"durable","causation_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","run_stream":{"kind":"run","id":"5f283545-6d77-4246-bbdf-5a980fc43a74"},"task_stream":{"kind":"task","id":"cac073c2-02f4-41e1-9483-92961975d6f3"},"task_id":"cac073c2-02f4-41e1-9483-92961975d6f3","event":{"kind":"output","task_id":"cac073c2-02f4-41e1-9483-92961975d6f3","chunk":"Read text file `internal/canonicaljson/core_records.go`.\n1|package canonicaljson\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|\t\"regexp\"\n7|\t\"sort\"\n8|\t\"strings\"\n9|\t\"unicode/utf8\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|)\n14|\n15|const (\n16|\tleaseSchema            = \"urn:ax:schema:lease\"\n17|\tcheckpointSchema       = \"urn:ax:schema:checkpoint\"\n18|\tproviderIdentitySchema = \"urn:ax:schema:provider-identity\"\n19|\tworkspaceGroupSchema   = \"urn:ax:schema:workspace-group\"\n20|\tsessionEventSchema     = \"urn:ax:schema:session-event\"\n21|\tobservationSchema      = \"urn:ax:schema:observation\"\n22|)\n23|\n24|var (\n25|\tproviderIdentityKeyPattern = regexp.MustCompile(`^[a-z][a-z0-9_.-]{0,63}$`)\n26|\tobservationNamePattern     = regexp.MustCompile(`^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,7}$`)\n27|\tlowerSnakePattern          = regexp.MustCompile(`^[a-z][a-z0-9_]*$`)\n28|\n29|\t// terminalBackendIDPattern is the Section 4.B declared grammar, verbatim:\n30|\t// \"terminal_backend_id is 1-128 ASCII bytes matching\n31|\t// [a-z][a-z0-9]*(?:[.-][a-z0-9]+)*\".\n32|\tterminalBackendIDPattern   = regexp.MustCompile(`^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$`)\n33|\twindowsAbsolutePathPattern = regexp.MustCompile(`^[A-Za-z]:[\\\\/]`)\n34|\n35|\t// ErrInvalidObservation reports an Observation Event or stream outside the\n36|\t// pinned Section 18.1 contract. Observation Events are not identity-addressed.\n37|\tErrInvalidObservation = errors.New(\"invalid observation event\")\n38|)\n39|\n40|func validateLeaseRecord(object map[string]any) error {\n41|\tif err := requireExactMembers(\"Lease Record\", object,\n42|\t\t\"schema\", \"schema_version\", \"record_id\", \"subject_id\", \"lease_id\", \"session_id\", \"epoch\",\n43|\t\t\"holder_host_id\", \"predecessor_lease_id\", \"reason\", \"checkpoint_id\", \"issued_by_host_id\",\n44|\t\t\"created_by_host_id\", \"created_at\", \"extensions\"); err != nil {\n45|\t\treturn err\n46|\t}\n47|\tif err := validateIdentityRecordEnvelope(object, leaseSchema, \"1.0.0\", \"record_id\"); err != nil {\n48|\t\treturn err\n49|\t}\n50|\tsubjectID, err := requireUUIDv7(object, \"subject_id\")\n51|\tif err != nil {\n52|\t\treturn err\n53|\t}\n54|\tsessionID, err := requireUUIDv7(object, \"session_id\")\n55|\tif err != nil {\n56|\t\treturn err\n57|\t}\n58|\tif subjectID != sessionID {\n59|\t\treturn invalidIdentity(\"Lease Record subject_id must equal session_id\")\n60|\t}\n61|\tif err := requireUUIDv4(object, \"lease_id\"); err != nil {\n62|\t\treturn err\n63|\t}\n64|\tepoch, err := requirePositiveUint(object, \"epoch\")\n65|\tif err != nil {\n66|\t\treturn err\n67|\t}\n68|\tif _, err := requireUUIDv7(object, \"holder_host_id\"); err != nil {\n69|\t\treturn err\n70|\t}\n71|\tpredecessorPresent, err := requireNullableUUIDv4(object, \"predecessor_lease_id\")\n72|\tif err != nil {\n73|\t\treturn err\n74|\t}\n75|\treason, err := requireEnum(object, \"reason\", \"create\", \"graceful_takeover\", \"force_takeover\", \"recovery\")\n76|\tif err != nil {\n77|\t\treturn err\n78|\t}\n79|\tcheckpointPresent, err := requireNullableDigestPresence(object, \"checkpoint_id\")\n80|\tif err != nil {\n81|\t\treturn err\n82|\t}\n83|\t// Each of the three couplings below quotes the clause that licenses it.\n84|\t// Section 5.3 does not declare an epoch-1 => create direction anywhere, so\n85|\t// an epoch-1 recovery or takeover lease is admitted: where the pinned\n86|\t// specification is silent this validator stays permissive.\n87|\tepochOneCreate := epoch == 1 && reason == \"create\"\n88|\t// predecessor_lease_id: \"Null only at epoch 1\".\n89|\tif epoch != 1 && !predecessorPresent {\n90|\t\treturn invalidIdentity(\"Lease Record predecessor_lease_id must be non-null after epoch 1\")\n91|\t}\n92|\t// \"An epoch-1 create lease MUST have a null predecessor\".\n93|\tif epochOneCreate && predecessorPresent {\n94|\t\treturn invalidIdentity(\"Lease Record epoch-1 create predecessor_lease_id must be null\")\n95|\t}\n96|\t// checkpoint_id: \"Null only for epoch-1 create; otherwise the validated\n97|\t// materialized handoff base\". The complement of epoch-1 create therefore\n98|\t// requires a non-null checkpoint, including at epoch 1 for any other reason.\n99|\tif !epochOneCreate && !checkpointPresent {\n100|\t\treturn invalidIdentity(\"Lease Record checkpoint_id must be non-null unless the lease is an epoch-1 create\")\n101|\t}\n102|\tissuedBy, err := requireUUIDv7(object, \"issued_by_host_id\")\n103|\tif err != nil {\n104|\t\treturn err\n105|\t}\n106|\tcreatedBy, _ := object[\"created_by_host_id\"].(string)\n107|\tif createdBy != issuedBy {\n108|\t\treturn invalidIdentity(\"Lease Record created_by_host_id must equal issued_by_host_id\")\n109|\t}\n110|\treturn nil\n111|}\n112|\n113|func validateCheckpointRecord(object map[string]any) error {\n114|\tif err := requireExactMembers(\"Checkpoint Record\", object,\n115|\t\t\"schema\", \"schema_version\", \"checkpoint_id\", \"subject_id\", \"session_id\", \"lease_epoch\", \"lease_id\",\n116|\t\t\"safe_boundary\", \"event_heads\", \"workspace_manifest_id\", \"provider_manifest_id\", \"task_board_bundle_id\",\n117|\t\t\"created_by_host_id\", \"created_at\", \"status\", \"extensions\"); err != nil {\n118|\t\treturn err\n119|\t}\n120|\tif err := validateIdentityRecordEnvelope(object, checkpointSchema, \"1.0.0\", \"checkpoint_id\"); err != nil {\n121|\t\treturn err\n122|\t}\n123|\tsubjectID, err := requireUUIDv7(object, \"subject_id\")\n124|\tif err != nil {\n125|\t\treturn err\n126|\t}\n127|\tsessionID, err := requireUUIDv7(object, \"session_id\")\n128|\tif err != nil {\n129|\t\treturn err\n130|\t}\n131|\tif subjectID != sessionID {\n132|\t\treturn invalidIdentity(\"Checkpoint Record subject_id must equal session_id\")\n133|\t}\n134|\tif _, err := requirePositiveUint(object, \"lease_epoch\"); err != nil {\n135|\t\treturn err\n136|\t}\n137|\tif err := requireUUIDv4(object, \"lease_id\"); err != nil {\n138|\t\treturn err\n139|\t}\n140|\tboundary, err := requireObject(object, \"safe_boundary\")\n141|\tif err != nil {\n142|\t\treturn err\n143|\t}\n144|\tif err := validateSafeBoundaryEvidence(boundary); err != nil {\n145|\t\treturn err\n146|\t}\n147|\theads, err := requireArrayRange(object, \"event_heads\", 1, 64)\n148|\tif err != nil {\n149|\t\treturn err\n150|\t}\n151|\tif err := validateSortedUniqueDigests(heads, \"event_heads\"); err != nil {\n152|\t\treturn err\n153|\t}\n154|\tif err := requireDigest(object, \"workspace_manifest_id\"); err != nil {\n155|\t\treturn err\n156|\t}\n157|\tproviderPresent, err := requireNullableDigestPresence(object, \"provider_manifest_id\")\n158|\tif err != nil {\n159|\t\treturn err\n160|\t}\n161|\tboardPresent, err := requireNullableDigestPresence(object, \"task_board_bundle_id\")\n162|\tif err != nil {\n163|\t\treturn err\n164|\t}\n165|\tif providerPresent == boardPresent {\n166|\t\treturn invalidIdentity(\"Checkpoint Record requires exactly one of provider_manifest_id and task_board_bundle_id\")\n167|\t}\n168|\treturn requireExactString(object, \"status\", \"validated\")\n169|}\n170|\n171|func validateSafeBoundaryEvidence(object map[string]any) error {\n172|\tif err := requireExactMembers(\"Safe Boundary Evidence\", object,\n173|\t\t\"provider_id\", \"provider_version\", \"evidence\", \"input_blocked\", \"foreground_idle\", \"background_idle\",\n174|\t\t\"open_processes\", \"open_database_handles\"); err != nil {\n175|\t\treturn err\n176|\t}\n177|\tif err := requireProviderID(object, \"provider_id\"); err != nil {\n178|\t\treturn err\n179|\t}\n180|\tif _, err := requireBoundedString(object, \"provider_version\", 1, 128); err != nil {\n181|\t\treturn err\n182|\t}\n183|\tif _, err := requireEnum(object, \"evidence\", \"provider_api\", \"provider_event\", \"managed_pty\", \"task_board_bridge\", \"accepted_test\"); err != nil {\n184|\t\treturn err\n185|\t}\n186|\tfor _, name := range []string{\"input_blocked\", \"foreground_idle\", \"background_idle\"} {\n187|\t\tvalue, err := requireBool(object, name)\n188|\t\tif err != nil {\n189|\t\t\treturn err\n190|\t\t}\n191|\t\tif !value {\n192|\t\t\treturn invalidIdentity(\"Safe Boundary Evidence %s must be true\", name)\n193|\t\t}\n194|\t}\n195|\tfor _, name := range []string{\"open_processes\", \"open_database_handles\"} {\n196|\t\tvalue, err := requireUint(object, name, uint64(maxSafeInteger))\n197|\t\tif err != nil {\n198|\t\t\treturn err\n199|\t\t}\n200|\t\tif value != 0 {\n201|\t\t\treturn invalidIdentity(\"Safe Boundary Evidence %s must be zero\", name)\n202|\t\t}\n203|\t}\n204|\treturn nil\n205|}\n206|\n207|func validateProviderIdentityRecord(object map[string]any) error {\n208|\tif err := requireExactMembers(\"Provider Identity Record\", object,\n209|\t\t\"schema\", \"schema_version\", \"record_id\", \"subject_id\", \"session_id\", \"provider_id\", \"provider_version\",\n210|\t\t\"provider_version_range\", \"native_session_id\", \"identity_kind\", \"logical_workspace_id\",\n211|\t\t\"backend_realm_fingerprint\", \"opaque_identity\", \"created_by_host_id\", \"created_at\", \"extensions\"); err != nil {\n212|\t\treturn err\n213|\t}\n214|\tif err := validateIdentityRecordEnvelope(object, providerIdentitySchema, \"1.0.0\", \"record_id\"); err != nil {\n215|\t\treturn err\n216|\t}\n217|\tsubjectID, err := requireUUIDv7(object, \"subject_id\")\n218|\tif err != nil {\n219|\t\treturn err\n220|\t}\n221|\tsessionID, err := requireUUIDv7(object, \"session_id\")\n222|\tif err != nil {\n223|\t\treturn err\n224|\t}\n225|\tif subjectID != sessionID {\n226|\t\treturn invalidIdentity(\"Provider Identity Record subject_id must equal session_id\")\n227|\t}\n228|\tif err := requireProviderID(object, \"provider_id\"); err != nil {\n229|\t\treturn err\n230|\t}\n231|\t// Spelled out as three ordered calls rather than a map range: a map range\n232|\t// reports a random member when several bounds are violated at once, and it\n233|\t// hides the declared bounds from the derived bounds inventory.\n234|\tif _, err := requireBoundedString(object, \"provider_version\", 1, 128); err != nil {\n235|\t\treturn err\n236|\t}\n237|\tif _, err := requireBoundedString(object, \"provider_version_range\", 1, 256); err != nil {\n238|\t\treturn err\n239|\t}\n240|\tif _, err := requireBoundedString(object, \"native_session_id\", 1, 512); err != nil {\n241|\t\treturn err\n242|\t}\n243|\tkind, err := requireEnum(object, \"identity_kind\", \"session_uuid\", \"session_path_or_id\", \"backend_conversation_uuid\", \"task_board_managed\", \"provider_defined\")\n244|\tif err != nil {\n245|\t\treturn err\n246|\t}\n247|\tif _, err := requireUUIDv7(object, \"logical_workspace_id\"); err != nil {\n248|\t\treturn err\n249|\t}\n250|\trealmPresent, err := requireNullableDigestPresence(object, \"backend_realm_fingerprint\")\n251|\tif err != nil {\n252|\t\treturn err\n253|\t}\n254|\tproviderID, _ := object[\"provider_id\"].(string)\n255|\tif providerID == \"antigravity\" && kind == \"backend_conversation_uuid\" && !realmPresent {\n256|\t\treturn invalidIdentity(\"Provider Identity Record backend_realm_fingerprint must be non-null for Antigravity backend_conversation_uuid\")\n257|\t}\n258|\topaque, err := requireObject(object, \"opaque_identity\")\n259|\tif err != nil {\n260|\t\treturn err\n261|\t}\n262|\tif len(opaque) > 32 {\n263|\t\treturn invalidIdentity(\"Provider Identity Record opaque_identity exceeds maximum length 32\")\n264|\t}\n265|\t// Iterate in sorted key order so a record violating several opaque_identity\n266|\t// bounds always reports the same member rather than a random map key.\n267|\topaqueKeys := make([]string, 0, len(opaque))\n268|\tfor key := range opaque {\n269|\t\topaqueKeys = append(opaqueKeys, key)\n270|\t}\n271|\tsort.Strings(opaqueKeys)\n272|\tfor _, key := range opaqueKeys {\n273|\t\tvalue := opaque[key]\n274|\t\tif !providerIdentityKeyPattern.MatchString(key) {\n275|\t\t\treturn invalidIdentity(\"Provider Identity Record opaque_identity key %q must match [a-z][a-z0-9_.-]{0,63}\", key)\n276|\t\t}\n277|\t\ttext, ok := value.(string)\n278|\t\tif !ok || !utf8.ValidString(text) {\n279|\t\t\treturn invalidIdentity(\"Provider Identity Record opaque_identity[%q] must be a UTF-8 string\", key)\n280|\t\t}\n281|\t\tlength := utf8.RuneCountInString(text)\n282|\t\tif length < 1 || length > 1024 {\n283|\t\t\treturn invalidIdentity(\"Provider Identity Record opaque_identity[%q] must contain 1..1024 Unicode characters\", key)\n284|\t\t}\n285|\t\t// Section 2 declares the map \"MUST NOT contain an absolute path,\n286|\t\t// credential, environment value, PID, socket, terminal ID, or mutable\n287|\t\t// cache selector\". Only the leading-absolute-path form of that sentence\n288|\t\t// is decidable from one candidate: a value such as `cwd=/Users/x`\n289|\t\t// embeds an absolute path and is ADMITTED here. The message says\n290|\t\t// \"begin with\" rather than \"contain\" so the refusal states what it\n291|\t\t// enforces, and constraint-enumeration.md routes the undecidable\n292|\t\t// remainder to the same external column as the credential and PID\n293|\t\t// classes in that sentence.\n294|\t\tif strings.HasPrefix(text, \"/\") || strings.HasPrefix(text, `\\\\`) || windowsAbsolutePathPattern.MatchString(text) {\n295|\t\t\treturn invalidIdentity(\"Provider Identity Record opaque_identity[%q] must not begin with an absolute path\", key)\n296|\t\t}\n297|\t}\n298|\treturn nil\n299|}\n300|\n301|func validateWorkspaceGroupRecord(object map[string]any) error {\n302|\tif err := requireExactMembers(\"Workspace Group Record\", object,\n303|\t\t\"schema\", \"schema_version\", \"record_id\", \"subject_id\", \"workspace_group_id\", \"display_name\", \"members\",\n304|\t\t\"created_by_host_id\", \"created_at\", \"extensions\"); err != nil {\n305|\t\treturn err\n306|\t}\n307|\tif err := validateIdentityRecordEnvelope(object, workspaceGroupSchema, \"1.0.0\", \"record_id\"); err != nil {\n308|\t\treturn err\n309|\t}\n310|\tsubjectID, err := requireUUIDv7(object, \"subject_id\")\n311|\tif err != nil {\n312|\t\treturn err\n313|\t}\n314|\tgroupID, err := requireUUIDv7(object, \"workspace_group_id\")\n315|\tif err != nil {\n316|\t\treturn err\n317|\t}\n318|\tif subjectID != groupID {\n319|\t\treturn invalidIdentity(\"Workspace Group Record subject_id must equal workspace_group_id\")\n320|\t}\n321|\tif _, err := requireBoundedString(object, \"display_name\", 1, 128); err != nil {\n322|\t\treturn err\n323|\t}\n324|\tmembers, err := requireArrayRange(object, \"members\", 1, 256)\n325|\tif err != nil {\n326|\t\treturn err\n327|\t}\n328|\tpreviousID := \"\"\n329|\tpaths := make(map[string]string, len(members))\n330|\tfor index, value := range members {\n331|\t\tmember, err := requireObjectValue(value, fmt.Sprintf(\"Workspace Group Record members[%d]\", index))\n332|\t\tif err != nil {\n333|\t\t\treturn err\n334|\t\t}\n335|\t\tworkspaceID, relativePath, err := validateWorkspaceMember(member)\n336|\t\tif err != nil {\n337|\t\t\treturn err\n338|\t\t}\n339|\t\t// Section 2 declares \"Members are sorted by workspace_id, and no two\n340|\t\t// members may have an equal or case-colliding group_relative_path\". The\n341|\t\t// declared uniqueness is on group_relative_path, enforced below; the\n342|\t\t// workspace_id rule is bare `sorted`, so an equal workspace_id is\n343|\t\t// admitted rather than refused on an undeclared uniqueness.\n344|\t\tif index > 0 && workspaceID < previousID {\n345|\t\t\treturn invalidIdentity(\"Workspace Group Record members must be sorted by workspace_id\")\n346|\t\t}\n347|\t\tpreviousID = workspaceID\n348|\t\tfolded := simpleFoldKey(relativePath)\n349|\t\tif prior, collision := paths[folded]; collision {\n350|\t\t\treturn invalidIdentity(\"Workspace Group Record member paths %q and %q are equal or case-colliding\", prior, relativePath)\n351|\t\t}\n352|\t\tpaths[folded] = relativePath\n353|\t}\n354|\treturn nil\n355|}\n356|\n357|func validateWorkspaceMember(object map[string]any) (string, string, error) {\n358|\tkind, err := requireString(object, \"kind\")\n359|\tif err != nil {\n360|\t\treturn \"\", \"\", err\n361|\t}\n362|\t// Both member lists are spelled out literally rather than appended to a\n363|\t// shared prefix so the per-member constraint inventory can read them.\n364|\tswitch kind {\n365|\tcase \"git\":\n366|\t\tif err := requireExactMembers(\"WorkspaceMember.git\", object,\n367|\t\t\t\"workspace_id\", \"kind\", \"group_relative_path\", \"repo_relative_cwd\", \"agent_project_config_paths\",\n368|\t\t\t\"materialization_policy\", \"repository_identity\", \"sanitized_remote_urls\"); err != nil {\n369|\t\t\treturn \"\", \"\", err\n370|\t\t}\n371|\tcase \"managed_tree\":\n372|\t\tif err := requireExactMembers(\"WorkspaceMember.managed_tree\", object,\n373|\t\t\t\"workspace_id\", \"kind\", \"group_relative_path\", \"repo_relative_cwd\", \"agent_project_config_paths\",\n374|\t\t\t\"materialization_policy\", \"tree_identity\"); err != nil {\n375|\t\t\treturn \"\", \"\", err\n376|\t\t}\n377|\tdefault:\n378|\t\treturn \"\", \"\", invalidIdentity(\"WorkspaceMember kind %q is not git or managed_tree\", kind)\n379|\t}\n380|\tworkspaceID, err := requireUUIDv7(object, \"workspace_id\")\n381|\tif err != nil {\n382|\t\treturn \"\", \"\", err\n383|\t}\n384|\trelativePath, err := requireRelativePathValue(object, \"group_relative_path\")\n385|\tif err != nil {\n386|\t\treturn \"\", \"\", err\n387|\t}\n388|\tif err := requireDotOrRelativePath(object, \"repo_relative_cwd\"); err != nil {\n389|\t\treturn \"\", \"\", err\n390|\t}\n391|\tif err := requireSortedUniquePaths(object, \"agent_project_config_paths\", 256); err != nil {\n392|\t\treturn \"\", \"\", err\n393|\t}\n394|\tif kind == \"git\" {\n395|\t\tif err := requireBoundedLogicalIdentity(object, \"repository_identity\"); err != nil {\n396|\t\t\treturn \"\", \"\", err\n397|\t\t}\n398|\t\turls, err := requireArrayRange(object, \"sanitized_remote_urls\", 1, 16)\n399|\t\tif err != nil {\n400|\t\t\treturn \"\", \"\", err\n401|\t\t}\n402|\t\tif err := validateSortedUniqueSanitizedGitURLs(urls); err != nil {\n403|\t\t\treturn \"\", \"\", err\n404|\t\t}\n405|\t\tif _, err := requireEnum(object, \"materialization_policy\", \"shared_checkout\", \"separate_worktree\"); err != nil {\n406|\t\t\treturn \"\", \"\", err\n407|\t\t}\n408|\t} else {\n409|\t\tif err := requireBoundedLogicalIdentity(object, \"tree_identity\"); err != nil {\n410|\t\t\treturn \"\", \"\", err\n411|\t\t}\n412|\t\tif _, err := requireEnum(object, \"materialization_policy\", \"shared_tree\", \"separate_copy\"); err != nil {\n413|\t\t\treturn \"\", \"\", err\n414|\t\t}\n415|\t}\n416|\treturn workspaceID, relativePath, nil\n417|}\n418|\n419|func validateSortedUniqueSanitizedGitURLs(values []any) error {\n420|\tprevious := \"\"\n421|\tfor index, value := range values {\n422|\t\ttext, ok := value.(string)\n423|\t\tif !ok {\n424|\t\t\treturn invalidIdentity(\"member sanitized_remote_urls[%d] must be a string\", index)\n425|\t\t}\n426|\t\tif _, err := scalar.ParseSanitizedGitURL(text); err != nil {\n427|\t\t\treturn invalidIdentity(\"member sanitized_remote_urls[%d]: %v\", index, err)\n428|\t\t}\n429|\t\tif index > 0 && text <= previous {\n430|\t\t\treturn invalidIdentity(\"member sanitized_remote_urls must be strictly sorted and unique\")\n431|\t\t}\n432|\t\tprevious = text\n433|\t}\n434|\treturn nil\n435|}\n436|\n437|type eventPayloadShape struct {\n438|\tmembers []string\n439|\tcheck   func(map[string]any) error\n440|}\n441|\n442|var sessionEventPayloadShapes = mustBuildSessionEventPayloadShapes()\n443|\n444|func validateSessionEventV1(object map[string]any) error {\n445|\treturn validateSessionEvent(object, \"1.0.0\")\n446|}\n447|func validateSessionEventV2(object map[string]any) error {\n448|\treturn validateSessionEvent(object, \"2.0.0\")\n449|}\n450|func validateSessionEventV3(object map[string]any) error {\n451|\treturn validateSessionEvent(object, \"3.0.0\")\n452|}\n453|func validateSessionEventV4(object map[string]any) error {\n454|\treturn validateSessionEvent(object, \"4.0.0\")\n455|}\n456|\n457|func validateSessionEvent(object map[string]any, version string) error {\n458|\tif err := requireExactMembers(\"Session Event\", object,\n459|\t\t\"schema\", \"schema_version\", \"event_id\", \"subject_id\", \"session_id\", \"event_type\", \"created_by_host_id\",\n460|\t\t\"lease_epoch\", \"lease_id\", \"lease_sequence\", \"predecessors\", \"created_at\", \"payload\", \"extensions\"); err != nil {\n461|\t\treturn err\n462|\t}\n463|\tif err := validateIdentityRecordEnvelope(object, sessionEventSchema, version, \"event_id\"); err != nil {\n464|\t\treturn err\n465|\t}\n466|\tsubjectID, err := requireUUIDv7(object, \"subject_id\")\n467|\tif err != nil {\n468|\t\treturn err\n469|\t}\n470|\tsessionID, err := requireUUIDv7(object, \"session_id\")\n471|\tif err != nil {\n472|\t\treturn err\n473|\t}\n474|\tif subjectID != sessionID {\n475|\t\treturn invalidIdentity(\"Session Event subject_id must equal session_id\")\n476|\t}\n477|\teventType, err := requireString(object, \"event_type\")\n478|\tif err != nil {\n479|\t\treturn err\n480|\t}\n481|\tif _, err := requirePositiveUint(object, \"lease_epoch\"); err != nil {\n482|\t\treturn err\n483|\t}\n484|\tif err := requireUUIDv4(object, \"lease_id\"); err != nil {\n485|\t\treturn err\n486|\t}\n487|\tif _, err := requirePositiveUint(object, \"lease_sequence\"); err != nil {\n488|\t\treturn err\n489|\t}\n490|\tpredecessors, err := requireArrayMinimum(object, \"predecessors\", 1)\n491|\tif err != nil {\n492|\t\treturn err\n493|\t}\n494|\t// Section 5.2 declares predecessors as \"a sorted array of one or more\n495|\t// record/event digests\" - bare `sorted`, not the Section 1.6 compound phrase\n496|\t// `sorted unique`. Duplicates are therefore admitted here.\n497|\tif err := validateSortedDigests(predecessors, \"predecessors\"); err != nil {\n498|\t\treturn err\n499|\t}\n500|\tpayload, err := requireObject(object, \"payload\")\n(more lines below)"}}}
