{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb03","stream":{"kind":"session","id":"01a0785b-9847-7fa3-b40c-313061570fc0"},"sequence":988,"recorded_at":1780531400001971,"record_type":"event","durability":"durable","causation_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","run_stream":{"kind":"run","id":"5f283545-6d77-4246-bbdf-5a980fc43a74"},"task_stream":{"kind":"task","id":"9feb4512-ef6b-4538-b8e8-a66f9dde8cf9"},"task_id":"9feb4512-ef6b-4538-b8e8-a66f9dde8cf9","event":{"kind":"output","task_id":"9feb4512-ef6b-4538-b8e8-a66f9dde8cf9","chunk":"Read text file `internal/terminalbackend/manifest.go`.\n(918 line(s) above)\n919|// ParseManifest validates one Terminal Backend Manifest 1.0.0 document and\n920|// returns the typed observation. Any deviation from the closed shape,\n921|// vocabulary, bound, ordering, registry-row, or identity rule is\n922|// CodeMismatch: a malformed read is an error, never absence.\n923|func ParseManifest(raw []byte) (Manifest, error) {\n924|\tobject, err := decodeStrictObject(raw)\n925|\tif err != nil {\n926|\t\treturn Manifest{}, err\n927|\t}\n928|\treturn parseManifestObject(object)\n929|}\n930|\n931|// parseManifestObject validates a decoded Manifest member map. It is split\n932|// from ParseManifest so admission paths that already hold a decoded object\n933|// share the exact gate.\n934|func parseManifestObject(object map[string]any) (Manifest, error) {\n935|\tif err := checkExactMembers(object, manifestMembers); err != nil {\n936|\t\treturn Manifest{}, err\n937|\t}\n938|\tif schema, err := stringMember(object, \"schema\"); err != nil || schema != SchemaManifest {\n939|\t\treturn Manifest{}, mismatchf(\"manifest schema\")\n940|\t}\n941|\tif version, err := stringMember(object, \"schema_version\"); err != nil || version != SchemaVersion100 {\n942|\t\treturn Manifest{}, mismatchf(\"manifest schema version\")\n943|\t}\n944|\tmanifestID, err := stringMember(object, \"manifest_id\")\n945|\tif err != nil {\n946|\t\treturn Manifest{}, err\n947|\t}\n948|\tif err := checkIdentity(object, \"manifest_id\", manifestID); err != nil {\n949|\t\treturn Manifest{}, err\n950|\t}\n951|\tbackendID, err := stringMember(object, \"terminal_backend_id\")\n952|\tif err != nil {\n953|\t\treturn Manifest{}, err\n954|\t}\n955|\tif _, err := ParseID(backendID); err != nil {\n956|\t\treturn Manifest{}, mismatchf(\"manifest backend identity\")\n957|\t}\n958|\timplementationVersion, err := semverMember(object, \"implementation_version\")\n959|\tif err != nil {\n960|\t\treturn Manifest{}, err\n961|\t}\n962|\tprotocols, err := stringArrayMember(object, \"protocol_versions\")\n963|\tif err != nil {\n964|\t\treturn Manifest{}, err\n965|\t}\n966|\tif err := validateProtocolList(protocols); err != nil {\n967|\t\treturn Manifest{}, err\n968|\t}\n969|\tplatforms, err := parsePlatformList(object)\n970|\tif err != nil {\n971|\t\treturn Manifest{}, err\n972|\t}\n973|\tkindName, err := stringMember(object, \"implementation_kind\")\n974|\tif err != nil {\n975|\t\treturn Manifest{}, err\n976|\t}\n977|\tkind, err := parseKind(kindName)\n978|\tif err != nil {\n979|\t\treturn Manifest{}, mismatchf(\"manifest implementation kind\")\n980|\t}\n981|\tdigest, err := digestOrNullMember(object, \"executable_digest\")\n982|\tif err != nil {\n983|\t\treturn Manifest{}, err\n984|\t}\n985|\tif needsDigest(kind) == (digest == \"\") {\n986|\t\treturn Manifest{}, mismatchf(\"manifest executable digest\")\n987|\t}\n988|\tclaimsRaw, known := object[\"static_capability_claims\"]\n989|\tif !known {\n990|\t\treturn Manifest{}, mismatchf(\"document members\")\n991|\t}\n992|\tclaims, err := parseClaimList(claimsRaw, false)\n993|\tif err != nil {\n994|\t\treturn Manifest{}, err\n995|\t}\n996|\tfixtureID, err := digestMember(object, \"conformance_fixture_id\")\n997|\tif err != nil {\n998|\t\treturn Manifest{}, err\n999|\t}\n1000|\tif err := checkExtensions(object); err != nil {\n1001|\t\treturn Manifest{}, err\n1002|\t}\n1003|\treturn Manifest{\n1004|\t\tManifestID:             manifestID,\n1005|\t\tTerminalBackendID:      backendID,\n1006|\t\tImplementationVersion:  implementationVersion,\n1007|\t\tProtocolVersions:       protocols,\n1008|\t\tPlatforms:              platforms,\n1009|\t\tImplementationKind:     kind,\n1010|\t\tExecutableDigest:       digest,\n1011|\t\tStaticCapabilityClaims: claims,\n1012|\t\tConformanceFixtureID:   fixtureID,\n1013|\t}, nil\n1014|}\n1015|\n1016|// validateProtocolList enforces sorted unique semver[1..32], each in\n1017|// Terminal Backend Protocol major 1, without naming a backend.\n1018|func validateProtocolList(versions []string) error {\n1019|\tif len(versions) < 1 || len(versions) > maxProtocolVersions {\n1020|\t\treturn mismatchf(\"protocol versions bound\")\n1021|\t}\n1022|\tfor index, version := range versions {\n1023|\t\tif !semverPattern.MatchString(version) || semverMajor(version) != 1 {\n1024|\t\t\treturn mismatchf(\"protocol versions major 1\")\n1025|\t\t}\n1026|\t\tif index > 0 && versions[index-1] >= version {\n1027|\t\t\treturn mismatchf(\"protocol versions ordering\")\n1028|\t\t}\n1029|\t}\n1030|\treturn nil\n1031|}\n1032|\n1033|// parsePlatformList validates the sorted unique non-empty platform subset.\n1034|func parsePlatformList(object map[string]any) ([]scalar.Platform, error) {\n1035|\tnames, err := stringArrayMember(object, \"platforms\")\n1036|\tif err != nil {\n1037|\t\treturn nil, err\n1038|\t}\n1039|\tif len(names) == 0 || len(names) > 4 {\n1040|\t\treturn nil, mismatchf(\"platforms bound\")\n1041|\t}\n1042|\tplatforms := make([]scalar.Platform, 0, len(names))\n1043|\tfor _, name := range names {\n1044|\t\tplatform, err := scalar.ParsePlatform(name)\n1045|\t\tif err != nil {\n1046|\t\t\treturn nil, mismatchf(\"platforms vocabulary\")\n1047|\t\t}\n1048|\t\tplatforms = append(platforms, platform)\n(more lines below)"}}}
