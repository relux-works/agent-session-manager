{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c437","stream":{"kind":"session","id":"01a0785b-9847-7fa3-b40c-313061570fc0"},"sequence":118,"recorded_at":1780531400000231,"record_type":"event","durability":"durable","causation_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","run_stream":{"kind":"run","id":"5f283545-6d77-4246-bbdf-5a980fc43a74"},"task_stream":{"kind":"task","id":"49416023-c6f1-408d-b8dd-8ac7355f45c3"},"task_id":"49416023-c6f1-408d-b8dd-8ac7355f45c3","event":{"kind":"output","task_id":"49416023-c6f1-408d-b8dd-8ac7355f45c3","chunk":"Read text file `internal/canonicaljson/closed_shapes.go`.\n1|package canonicaljson\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\t\"net/url\"\n7|\tpathpkg \"path\"\n8|\t\"regexp\"\n9|\t\"sort\"\n10|\t\"strconv\"\n11|\t\"strings\"\n12|\t\"unicode\"\n13|\t\"unicode/utf8\"\n14|\n15|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n17|)\n18|\n19|const (\n20|\tblobSchema             = \"urn:ax:schema:blob\"\n21|\ttransferManifestSchema = \"urn:ax:schema:transfer-manifest\"\n22|\tclosedSchemaVersion    = \"1.0.0\"\n23|\tmaxBlobChunks          = 32_768\n24|\tmaxChunkSize           = 4_194_304\n25|)\n26|\n27|var (\n28|\tmediaTypePattern = regexp.MustCompile(\"^[a-z0-9!#$&^_.+%'*`|~-]+/[a-z0-9!#$&^_.+%'*`|~-]+$\")\n29|\t// SemVer 2.0.0 in full. The pinned document types members `semver` without\n30|\t// spelling out a grammar, so the only defensible reading is the named\n31|\t// standard, which admits prerelease and build metadata. A core-triple-only\n32|\t// pattern would refuse `1.2.3-rc.1`, a version the standard declares valid\n33|\t// and the document never excludes.\n34|\tsemverPattern          = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n35|\treverseDNSPattern      = regexp.MustCompile(`^[a-z][a-z0-9-]{0,62}(\\.[a-z][a-z0-9-]{0,62})+$`)\n36|\tenvironmentNamePattern = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]{0,127}$`)\n37|\tenvironmentIDPattern   = regexp.MustCompile(`^[a-z][a-z0-9.-]{0,63}$`)\n38|\tboardLogicalIDPattern  = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$`)\n39|\tsessionNamePattern     = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$`)\n40|)\n41|\n42|// Subsumed UTF-8 re-checks.\n43|//\n44|// Several validators in this file re-check utf8.ValidString on a value they\n45|// received. Every one of those terms is subsumed: decodeStrict in canonical.go\n46|// refuses input that is not valid UTF-8 before it decodes any value, and it is\n47|// the only place in this package where bytes become Go values, so no decoded\n48|// string or object key can reach a validator here invalid.\n49|//\n50|// They are kept fail-closed rather than deleted because the argument is a\n51|// package-internal invariant, not a property of these functions: an exported\n52|// entry point that accepted an already-decoded map, or a second JSON decoder\n53|// anywhere in the package, would make every one of them false again.\n54|//\n55|// Both conditions are machine-checked in utf8_subsumption_test.go, over a call\n56|// graph derived from the AST. That check is bounded, and the bound is part of\n57|// the claim. It models direct calls, calls to methods declared in this package,\n58|// and dispatch through a function value, which is the shape\n59|// immutableObjectShapeValidators below uses. It models nothing about a callee\n60|// reached by reflection, by a function value handed to another package, or\n61|// through a func-typed struct field, and an entry point built one of those ways\n62|// would leave these guards live while the pin stayed green. The pin narrows how\n63|// such a change can arrive unnoticed; it does not make it impossible, which is\n64|// the reason these terms stay rather than being deleted.\n65|\n66|type immutableObjectShapeValidator func(map[string]any) error\n67|\n68|// immutableObjectShapeValidators is deliberately explicit. The self-identity\n69|// catalog selects the self field, but catalog membership alone does not prove\n70|// that this package implements a schema's complete closed shape. Every\n71|// registered schema/version therefore resolves either to a concrete validator\n72|// or to an explicit refusal. validateImmutableObjectShapeValidators binds this\n73|// table back to the generated registry so a newly registered row cannot fall\n74|// through to extension-only attestation.\n75|var immutableObjectShapeValidators = mustBuildImmutableObjectShapeValidators()\n76|\n77|func mustBuildImmutableObjectShapeValidators() map[schemaIdentityKey]immutableObjectShapeValidator {\n78|\tvalidators := make(map[schemaIdentityKey]immutableObjectShapeValidator)\n79|\tregister := func(schema string, validator immutableObjectShapeValidator, versions ...string) {\n80|\t\tfor _, version := range versions {\n81|\t\t\tkey := schemaIdentityKey{schema: schema, version: version}\n82|\t\t\tif _, duplicate := validators[key]; duplicate {\n83|\t\t\t\tpanic(fmt.Sprintf(\"duplicate immutable-object shape validator for %s@%s\", schema, version))\n84|\t\t\t}\n85|\t\t\tvalidators[key] = validator\n86|\t\t}\n87|\t}\n88|\n89|\t// Complete validators owned by the scoped Sections 10.1-10.4 gate.\n90|\tregister(\"urn:ax:schema:session-record\", validateSessionRecordV1, \"1.0.0\")\n91|\tregister(\"urn:ax:schema:session-record\", validateSessionRecordV2, \"2.0.0\")\n92|\tregister(\"urn:ax:schema:session-record\", validateSessionRecordV3, \"3.0.0\")\n93|\tregister(blobSchema, validateBlobDescriptor, closedSchemaVersion)\n94|\tregister(transferManifestSchema, validateTransferManifest, closedSchemaVersion)\n95|\n96|\t// Complete Section 5 and Section 10.1 core-record validators.\n97|\tregister(\"urn:ax:schema:lease\", validateLeaseRecord, \"1.0.0\")\n98|\tregister(\"urn:ax:schema:workspace-group\", validateWorkspaceGroupRecord, \"1.0.0\")\n99|\tregister(\"urn:ax:schema:provider-identity\", validateProviderIdentityRecord, \"1.0.0\")\n100|\tregister(\"urn:ax:schema:session-event\", validateSessionEventV1, \"1.0.0\")\n101|\tregister(\"urn:ax:schema:session-event\", validateSessionEventV2, \"2.0.0\")\n102|\tregister(\"urn:ax:schema:session-event\", validateSessionEventV3, \"3.0.0\")\n103|\tregister(\"urn:ax:schema:session-event\", validateSessionEventV4, \"4.0.0\")\n104|\tregister(\"urn:ax:schema:checkpoint\", validateCheckpointRecord, \"1.0.0\")\n105|\n106|\t// Remaining Section 10.1 records retain their common-envelope gate before\n107|\t// the public identity surface explicitly refuses an unsupported shape.\n108|\tregister(\"urn:ax:schema:tombstone\", validateUnsupportedRecordEnvelopeShape, \"1.0.0\")\n109|\tregister(\"urn:ax:schema:tombstone-ack\", validateUnsupportedRecordEnvelopeShape, \"1.0.0\")\n110|\n111|\t// The remaining registered identities are recognized for self-field\n112|\t// selection but their schema-specific closed shapes are outside this task.\n113|\t// Explicit refusal is safer and more honest than attesting an opaque object.\n114|\tregister(\"urn:ax:schema:canonical-event\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n115|\tregister(\"urn:ax:schema:terminal-backend-manifest\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n116|\tregister(\"urn:ax:schema:session-clone-bundle\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n117|\tregister(\"urn:ax:schema:materialization-plan\", rejectUnsupportedImmutableObjectShape, \"1.0.0\", \"2.0.0\")\n118|\tregister(\"urn:ax:schema:session-continuation-plan\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n119|\tregister(\"urn:ax:schema:task-board-bundle\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n120|\tregister(\"urn:ax:schema:materialization-journal\", rejectUnsupportedImmutableObjectShape, \"2.0.0\")\n121|\tregister(\"urn:ax:schema:environment-observation\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n122|\tregister(\"urn:ax:schema:native-session-observation\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n123|\tregister(\"urn:ax:schema:session-inventory-batch\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n124|\tregister(\"urn:ax:schema:conversation-lineage-link\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n125|\tregister(\"urn:ax:schema:session-annotation\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n126|\tregister(\"urn:ax:schema:session-enrichment-profile\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n127|\tregister(\"urn:ax:schema:session-enrichment-job-request\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n128|\tregister(\"urn:ax:schema:session-enrichment-job-receipt\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n129|\tregister(\"urn:ax:schema:session-directory-operation-receipt\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n130|\tregister(\"urn:ax:schema:terminal-backend-probe\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n131|\tregister(\"urn:ax:schema:terminal-instance-binding\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n132|\tregister(\"urn:ax:schema:terminal-capability-evidence\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n133|\tregister(\"urn:ax:schema:clone-raw-object-manifest\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n134|\tregister(\"urn:ax:schema:clone-capture-manifest\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n135|\tregister(\"urn:ax:schema:canonical-session\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n136|\tregister(\"urn:ax:schema:fidelity-report\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n137|\tregister(\"urn:ax:schema:projection-plan\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n138|\tregister(\"urn:ax:schema:clone-projected-object-manifest\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n139|\tregister(\"urn:ax:schema:clone-read-back-evidence-manifest\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n140|\tregister(\"urn:ax:schema:clone-validation-report\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n141|\tregister(\"urn:ax:schema:migration-checkpoint\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n142|\tregister(\"urn:ax:schema:clone-lineage-receipt\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n143|\tregister(\"urn:ax:schema:supported-environment-tuples\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n144|\n145|\tif err := validateImmutableObjectShapeValidators(validators, catalog.Current().SelfIdentities); err != nil {\n146|\t\tpanic(fmt.Sprintf(\"immutable-object shape validator registry is invalid: %v\", err))\n147|\t}\n148|\treturn validators\n149|}\n150|\n151|func validateImmutableObjectShapeValidators(\n152|\tvalidators map[schemaIdentityKey]immutableObjectShapeValidator,\n153|\tdefinitions []catalog.SelfIdentityContract,\n154|) error {\n155|\texpected := make(map[schemaIdentityKey]struct{})\n156|\tfor _, definition := range definitions {\n157|\t\tfor _, version := range definition.ContractVersions {\n158|\t\t\tkey := schemaIdentityKey{schema: string(definition.ContractID), version: version}\n159|\t\t\texpected[key] = struct{}{}\n160|\t\t\tvalidator, ok := validators[key]\n161|\t\t\tif !ok || validator == nil {\n162|\t\t\t\treturn fmt.Errorf(\"missing immutable-object shape validator for %s@%s\", key.schema, key.version)\n163|\t\t\t}\n164|\t\t}\n165|\t}\n166|\tif len(validators) != len(expected) {\n167|\t\treturn fmt.Errorf(\"immutable-object shape validator table has %d rows, generated registry has %d\", len(validators), len(expected))\n168|\t}\n169|\tfor key := range validators {\n170|\t\tif _, ok := expected[key]; !ok {\n171|\t\t\treturn fmt.Errorf(\"immutable-object shape validator for unregistered schema %s@%s\", key.schema, key.version)\n172|\t\t}\n173|\t}\n174|\treturn nil\n175|}\n176|\n177|// validateImmutableObjectShape is the total closed-shape gate used by both\n178|// object-identity production entries. Registry membership never creates an\n179|// extension-only fall-through: each schema/version has an explicit validator\n180|// or an explicit unsupported-shape refusal.\n181|func validateImmutableObjectShape(object map[string]any) error {\n182|\tschema, err := requiredStringMember(object, \"schema\")\n183|\tif err != nil {\n184|\t\treturn err\n185|\t}\n186|\tversion, err := requiredStringMember(object, \"schema_version\")\n187|\tif err != nil {\n188|\t\treturn err\n189|\t}\n190|\n191|\tvalidator, ok := immutableObjectShapeValidators[schemaIdentityKey{schema: schema, version: version}]\n192|\tif !ok || validator == nil {\n193|\t\treturn invalidIdentity(\"no immutable-object shape validator for %s@%s\", schema, version)\n194|\t}\n195|\treturn validator(object)\n196|}\n197|\n198|func validateSessionRecordV1(object map[string]any) error {\n199|\tif err := requireExactMembers(\"Session Record 1.0.0\", object,\n200|\t\t\"schema\", \"schema_version\", \"record_id\", \"subject_id\", \"session_id\", \"name\", \"kind\",\n201|\t\t\"created_at\", \"created_by_host_id\", \"provider_id\", \"workspace_group_id\", \"execution_profile\",\n202|\t\t\"launch_plan\", \"task_board\", \"fork_provenance\", \"extensions\"); err != nil {\n203|\t\treturn err\n204|\t}\n205|\tsessionID, _, _, err := validateSessionRecordCommon(object, \"1.0.0\")\n206|\tif err != nil {\n207|\t\treturn err\n208|\t}\n209|\treturn validateSessionForkProvenance(object, sessionID)\n210|}\n211|\n212|func validateSessionRecordV2(object map[string]any) error {\n213|\treturn validateSessionRecordWithDerivation(object, \"2.0.0\")\n214|}\n215|\n216|func validateSessionRecordV3(object map[string]any) error {\n217|\treturn validateSessionRecordWithDerivation(object, \"3.0.0\")\n218|}\n219|\n220|func validateSessionRecordWithDerivation(object map[string]any, version string) error {\n221|\tif err := requireExactMembers(\"Session Record 2.0.0 and 3.0.0\", object,\n222|\t\t\"schema\", \"schema_version\", \"record_id\", \"subject_id\", \"session_id\", \"name\", \"kind\",\n223|\t\t\"created_at\", \"created_by_host_id\", \"provider_id\", \"workspace_group_id\", \"execution_profile\",\n224|\t\t\"launch_plan\", \"task_board\", \"derivation_provenance\", \"extensions\"); err != nil {\n225|\t\treturn err\n226|\t}\n227|\tsessionID, providerID, _, err := validateSessionRecordCommon(object, version)\n228|\tif err != nil {\n229|\t\treturn err\n230|\t}\n231|\treturn validateSessionDerivationProvenance(object, version, sessionID, providerID)\n232|}\n233|\n234|func validateSessionRecordCommon(object map[string]any, version string) (string, string, string, error) {\n235|\tif err := requireExactString(object, \"schema\", \"urn:ax:schema:session-record\"); err != nil {\n236|\t\treturn \"\", \"\", \"\", err\n237|\t}\n238|\tif err := requireExactString(object, \"schema_version\", version); err != nil {\n239|\t\treturn \"\", \"\", \"\", err\n240|\t}\n241|\tif err := requireDigest(object, \"record_id\"); err != nil {\n242|\t\treturn \"\", \"\", \"\", err\n243|\t}\n244|\tif err := validateCommonRecordEnvelope(object); err != nil {\n245|\t\treturn \"\", \"\", \"\", err\n246|\t}\n247|\tsubjectID, err := requireUUIDv7(object, \"subject_id\")\n248|\tif err != nil {\n249|\t\treturn \"\", \"\", \"\", err\n250|\t}\n251|\tsessionID, err := requireUUIDv7(object, \"session_id\")\n252|\tif err != nil {\n253|\t\treturn \"\", \"\", \"\", err\n254|\t}\n255|\tif subjectID != sessionID {\n256|\t\treturn \"\", \"\", \"\", invalidIdentity(\"Session Record subject_id must equal session_id\")\n257|\t}\n258|\tname, err := requireString(object, \"name\")\n259|\tif err != nil {\n260|\t\treturn \"\", \"\", \"\", err\n261|\t}\n262|\tif !sessionNamePattern.MatchString(name) {\n263|\t\treturn \"\", \"\", \"\", invalidIdentity(\"Session Record name must match [A-Za-z0-9][A-Za-z0-9._-]{0,63}\")\n264|\t}\n265|\tkind, err := requireEnum(object, \"kind\", \"direct\", \"task_board\")\n266|\tif err != nil {\n267|\t\treturn \"\", \"\", \"\", err\n268|\t}\n269|\tproviderID, err := requireString(object, \"provider_id\")\n270|\tif err != nil {\n271|\t\treturn \"\", \"\", \"\", err\n272|\t}\n273|\tif _, err := scalar.ParseProviderID(providerID); err != nil {\n274|\t\treturn \"\", \"\", \"\", invalidIdentity(\"Session Record provider_id: %v\", err)\n275|\t}\n276|\tif _, err := requireUUIDv7(object, \"workspace_group_id\"); err != nil {\n277|\t\treturn \"\", \"\", \"\", err\n278|\t}\n279|\tif _, err := requireEnum(object, \"execution_profile\", \"standard\", \"yolo\"); err != nil {\n280|\t\treturn \"\", \"\", \"\", err\n281|\t}\n282|\tlaunchPlan, err := requireObject(object, \"launch_plan\")\n283|\tif err != nil {\n284|\t\treturn \"\", \"\", \"\", err\n285|\t}\n286|\tif err := validateSessionLaunchPlan(launchPlan); err != nil {\n287|\t\treturn \"\", \"\", \"\", err\n288|\t}\n289|\tif err := validateSessionTaskBoardReference(object, kind); err != nil {\n290|\t\treturn \"\", \"\", \"\", err\n291|\t}\n292|\treturn sessionID, providerID, kind, nil\n293|}\n294|\n295|func validateSessionLaunchPlan(object map[string]any) error {\n296|\tif err := requireExactMembers(\"Session Record Launch Plan\", object,\n297|\t\t\"argv\", \"cwd_workspace_id\", \"cwd_relative\", \"env_names\", \"env_literals\", \"contains_secrets\", \"extensions\"); err != nil {\n298|\t\treturn err\n299|\t}\n300|\targv, err := requireArray(object, \"argv\", 128)\n301|\tif err != nil {\n302|\t\treturn err\n303|\t}\n304|\tif len(argv) == 0 {\n305|\t\treturn invalidIdentity(\"Session Record Launch Plan argv must contain at least one element\")\n306|\t}\n307|\tfor index, value := range argv {\n308|\t\ttext, ok := value.(string)\n309|\t\t// !utf8.ValidString(text) is subsumed by decodeStrict; see the subsumed\n310|\t\t// UTF-8 re-check note above. The other three terms are reachable.\n311|\t\tif !ok || !utf8.ValidString(text) || len(text) == 0 || len(text) > 4096 {\n312|\t\t\treturn invalidIdentity(\"Session Record Launch Plan argv[%d] must contain 1..4096 UTF-8 bytes\", index)\n313|\t\t}\n314|\t}\n315|\tif err := canonicalByteBound(\"Session Record Launch Plan argv\", argv, 65_536); err != nil {\n316|\t\treturn err\n317|\t}\n318|\tif _, err := requireUUIDv7(object, \"cwd_workspace_id\"); err != nil {\n319|\t\treturn err\n320|\t}\n321|\tif err := requireDotOrRelativePath(object, \"cwd_relative\"); err != nil {\n322|\t\treturn err\n323|\t}\n324|\tenvNames, err := requireArray(object, \"env_names\", 64)\n325|\tif err != nil {\n326|\t\treturn err\n327|\t}\n328|\tseenNames := make(map[string]struct{}, len(envNames))\n329|\tprevious := \"\"\n330|\tfor index, value := range envNames {\n331|\t\tname, ok := value.(string)\n332|\t\tif !ok || !environmentNamePattern.MatchString(name) {\n333|\t\t\treturn invalidIdentity(\"Session Record Launch Plan env_names[%d] has invalid environment-name grammar\", index)\n334|\t\t}\n335|\t\tif index > 0 && name <= previous {\n336|\t\t\treturn invalidIdentity(\"Session Record Launch Plan env_names must be strictly sorted and unique\")\n337|\t\t}\n338|\t\tseenNames[name] = struct{}{}\n339|\t\tprevious = name\n340|\t}\n341|\tenvLiterals, err := requireObject(object, \"env_literals\")\n342|\tif err != nil {\n343|\t\treturn err\n344|\t}\n345|\tif len(envLiterals) > 64 {\n346|\t\treturn invalidIdentity(\"Session Record Launch Plan env_literals contains %d members, maximum is 64\", len(envLiterals))\n347|\t}\n348|\tfor name, value := range envLiterals {\n349|\t\tif !environmentNamePattern.MatchString(name) {\n350|\t\t\treturn invalidIdentity(\"Session Record Launch Plan env_literals key %q has invalid environment-name grammar\", name)\n351|\t\t}\n352|\t\tif _, duplicate := seenNames[name]; duplicate {\n353|\t\t\treturn invalidIdentity(\"Session Record Launch Plan environment name %q occurs in both env_names and env_literals\", name)\n354|\t\t}\n355|\t\ttext, ok := value.(string)\n356|\t\t// !utf8.ValidString(text) is subsumed by decodeStrict; see the subsumed\n357|\t\t// UTF-8 re-check note above. The other two terms are reachable.\n358|\t\tif !ok || !utf8.ValidString(text) || len(text) > 4096 {\n359|\t\t\treturn invalidIdentity(\"Session Record Launch Plan env_literals[%q] must contain at most 4096 UTF-8 bytes\", name)\n360|\t\t}\n361|\t}\n362|\tcontainsSecrets, err := requireBool(object, \"contains_secrets\")\n363|\tif err != nil {\n364|\t\treturn err\n365|\t}\n366|\tif containsSecrets {\n367|\t\treturn invalidIdentity(\"Session Record Launch Plan contains_secrets must be false\")\n368|\t}\n369|\textensions, err := requireObject(object, \"extensions\")\n370|\tif err != nil {\n371|\t\treturn err\n372|\t}\n373|\treturn validateExtensionsObject(extensions)\n374|}\n375|\n376|func validateSessionTaskBoardReference(parent map[string]any, kind string) error {\n377|\tvalue, ok := parent[\"task_board\"]\n378|\tif !ok {\n379|\t\treturn invalidIdentity(\"identity input requires member task_board\")\n380|\t}\n381|\tif kind == \"direct\" {\n382|\t\tif value != nil {\n383|\t\t\treturn invalidIdentity(\"direct Session Record task_board must be null\")\n384|\t\t}\n385|\t\treturn nil\n386|\t}\n387|\tobject, err := requireObjectValue(value, \"Session Record task_board\")\n388|\tif err != nil {\n389|\t\treturn err\n390|\t}\n391|\tif err := requireExactMembers(\"Session Record Task-board Reference\", object,\n392|\t\t\"bridge_protocol_version\", \"board\", \"task_element_id\", \"launch_mode\", \"manager_session_ref\",\n393|\t\t\"board_goal\", \"native_goal_binding\", \"extensions\"); err != nil {\n394|\t\treturn err\n395|\t}\n396|\tif err := requireExactString(object, \"bridge_protocol_version\", \"1.0.0\"); err != nil {\n397|\t\treturn err\n398|\t}\n399|\tboard, err := requireObject(object, \"board\")\n400|\tif err != nil {\n401|\t\treturn err\n402|\t}\n403|\tif err := validateSessionBoardIdentity(board); err != nil {\n404|\t\treturn err\n405|\t}\n406|\tif _, err := requirePrintableByteBoundedString(object, \"task_element_id\", 1, 128); err != nil {\n407|\t\treturn err\n408|\t}\n409|\tlaunchMode, err := requireEnum(object, \"launch_mode\", \"primary_owner\", \"tracked_prompt\")\n410|\tif err != nil {\n411|\t\treturn err\n412|\t}\n413|\tif value, ok := object[\"manager_session_ref\"]; !ok || value != nil {\n414|\t\treturn invalidIdentity(\"Session Record Task-board Reference manager_session_ref must be null at creation\")\n415|\t}\n416|\tbinding, err := requireEnum(object, \"native_goal_binding\", \"bound\", \"prompt\", \"none\")\n417|\tif err != nil {\n418|\t\treturn err\n419|\t}\n420|\tgoalValue, ok := object[\"board_goal\"]\n421|\tif !ok {\n422|\t\treturn invalidIdentity(\"identity input requires member board_goal\")\n423|\t}\n424|\tif launchMode == \"primary_owner\" {\n425|\t\tif goalValue == nil || binding != \"bound\" {\n426|\t\t\treturn invalidIdentity(\"primary_owner Task-board Reference requires a board goal and bound native goal\")\n427|\t\t}\n428|\t} else if binding == \"bound\" {\n429|\t\treturn invalidIdentity(\"tracked_prompt Task-board Reference native_goal_binding must be prompt or none\")\n430|\t}\n431|\tif goalValue != nil {\n432|\t\tgoal, err := requireObjectValue(goalValue, \"Session Record board_goal\")\n433|\t\tif err != nil {\n434|\t\t\treturn err\n435|\t\t}\n436|\t\tif err := validateSessionBoardGoal(goal); err != nil {\n437|\t\t\treturn err\n438|\t\t}\n439|\t}\n440|\textensions, err := requireObject(object, \"extensions\")\n441|\tif err != nil {\n442|\t\treturn err\n443|\t}\n444|\treturn validateExtensionsObject(extensions)\n445|}\n446|\n447|func validateSessionBoardIdentity(object map[string]any) error {\n448|\tif err := requireExactMembers(\"Session Record Board Identity\", object, \"kind\", \"logical_id\", \"remote_url\", \"extensions\"); err != nil {\n449|\t\treturn err\n450|\t}\n451|\tkind, err := requireEnum(object, \"kind\", \"local\", \"remote\")\n452|\tif err != nil {\n453|\t\treturn err\n454|\t}\n455|\tlogicalID, err := requireBoundedString(object, \"logical_id\", 1, 128)\n456|\tif err != nil {\n457|\t\treturn err\n458|\t}\n459|\tif !boardLogicalIDPattern.MatchString(logicalID) {\n460|\t\treturn invalidIdentity(\"Session Record Board Identity logical_id has invalid grammar\")\n461|\t}\n462|\tremoteValue, ok := object[\"remote_url\"]\n463|\tif !ok {\n464|\t\treturn invalidIdentity(\"identity input requires member remote_url\")\n465|\t}\n466|\tif kind == \"local\" {\n467|\t\tif remoteValue != nil {\n468|\t\t\treturn invalidIdentity(\"local Session Record Board Identity remote_url must be null\")\n469|\t\t}\n470|\t} else {\n471|\t\tremoteURL, ok := remoteValue.(string)\n472|\t\t// !utf8.ValidString(remoteURL) is subsumed by decodeStrict; see the\n473|\t\t// subsumed UTF-8 re-check note above. The !ok term is reachable.\n474|\t\tif !ok || !utf8.ValidString(remoteURL) {\n475|\t\t\treturn invalidIdentity(\"remote Session Record Board Identity remote_url must be a UTF-8 string\")\n476|\t\t}\n477|\t\tparsed, err := url.Parse(remoteURL)\n478|\t\tif err != nil || parsed.Scheme != \"https\" || parsed.Host == \"\" || parsed.User != nil || parsed.RawQuery != \"\" || parsed.Fragment != \"\" {\n479|\t\t\treturn invalidIdentity(\"remote Session Record Board Identity remote_url must be absolute HTTPS without userinfo, query, or fragment\")\n480|\t\t}\n481|\t}\n482|\textensions, err := requireObject(object, \"extensions\")\n483|\tif err != nil {\n484|\t\treturn err\n485|\t}\n486|\treturn validateExtensionsObject(extensions)\n487|}\n488|\n489|func validateSessionBoardGoal(object map[string]any) error {\n490|\tif err := requireExactMembers(\"Session Record Board Goal\", object, \"schema\", \"goal_id\", \"revision\", \"extensions\"); err != nil {\n491|\t\treturn err\n492|\t}\n493|\tif err := requireExactString(object, \"schema\", \"board-goal-v2\"); err != nil {\n494|\t\treturn err\n495|\t}\n496|\tif _, err := requireBoundedString(object, \"goal_id\", 1, 128); err != nil {\n497|\t\treturn err\n498|\t}\n499|\trevision, err := requireUint(object, \"revision\", scalar.MaxUint53)\n500|\tif err != nil {\n(more lines below)"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c439","stream":{"kind":"session","id":"01a0785b-9847-7fa3-b40c-313061570fc0"},"sequence":119,"recorded_at":1780531400000233,"record_type":"event","durability":"durable","causation_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","run_stream":{"kind":"run","id":"5f283545-6d77-4246-bbdf-5a980fc43a74"},"task_stream":{"kind":"task","id":"49416023-c6f1-408d-b8dd-8ac7355f45c3"},"task_id":"49416023-c6f1-408d-b8dd-8ac7355f45c3","event":{"kind":"completed","task_id":"49416023-c6f1-408d-b8dd-8ac7355f45c3"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c43b","stream":{"kind":"session","id":"01a0785b-9847-7fa3-b40c-313061570fc0"},"sequence":120,"recorded_at":1780531400000235,"record_type":"event","durability":"durable","causation_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","run_stream":{"kind":"run","id":"5f283545-6d77-4246-bbdf-5a980fc43a74"},"call_id":"call_01a0785bd7ba79d39244966255adf08e","text":"Read text file `internal/canonicaljson/closed_shapes.go`.\n1|package canonicaljson\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\t\"net/url\"\n7|\tpathpkg \"path\"\n8|\t\"regexp\"\n9|\t\"sort\"\n10|\t\"strconv\"\n11|\t\"strings\"\n12|\t\"unicode\"\n13|\t\"unicode/utf8\"\n14|\n15|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n17|)\n18|\n19|const (\n20|\tblobSchema             = \"urn:ax:schema:blob\"\n21|\ttransferManifestSchema = \"urn:ax:schema:transfer-manifest\"\n22|\tclosedSchemaVersion    = \"1.0.0\"\n23|\tmaxBlobChunks          = 32_768\n24|\tmaxChunkSize           = 4_194_304\n25|)\n26|\n27|var (\n28|\tmediaTypePattern = regexp.MustCompile(\"^[a-z0-9!#$&^_.+%'*`|~-]+/[a-z0-9!#$&^_.+%'*`|~-]+$\")\n29|\t// SemVer 2.0.0 in full. The pinned document types members `semver` without\n30|\t// spelling out a grammar, so the only defensible reading is the named\n31|\t// standard, which admits prerelease and build metadata. A core-triple-only\n32|\t// pattern would refuse `1.2.3-rc.1`, a version the standard declares valid\n33|\t// and the document never excludes.\n34|\tsemverPattern          = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n35|\treverseDNSPattern      = regexp.MustCompile(`^[a-z][a-z0-9-]{0,62}(\\.[a-z][a-z0-9-]{0,62})+$`)\n36|\tenvironmentNamePattern = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]{0,127}$`)\n37|\tenvironmentIDPattern   = regexp.MustCompile(`^[a-z][a-z0-9.-]{0,63}$`)\n38|\tboardLogicalIDPattern  = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$`)\n39|\tsessionNamePattern     = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$`)\n40|)\n41|\n42|// Subsumed UTF-8 re-checks.\n43|//\n44|// Several validators in this file re-check utf8.ValidString on a value they\n45|// received. Every one of those terms is subsumed: decodeStrict in canonical.go\n46|// refuses input that is not valid UTF-8 before it decodes any value, and it is\n47|// the only place in this package where bytes become Go values, so no decoded\n48|// string or object key can reach a validator here invalid.\n49|//\n50|// They are kept fail-closed rather than deleted because the argument is a\n51|// package-internal invariant, not a property of these functions: an exported\n52|// entry point that accepted an already-decoded map, or a second JSON decoder\n53|// anywhere in the package, would make every one of them false again.\n54|//\n55|// Both conditions are machine-checked in utf8_subsumption_test.go, over a call\n56|// graph derived from the AST. That check is bounded, and the bound is part of\n57|// the claim. It models direct calls, calls to methods declared in this package,\n58|// and dispatch through a function value, which is the shape\n59|// immutableObjectShapeValidators below uses. It models nothing about a callee\n60|// reached by reflection, by a function value handed to another package, or\n61|// through a func-typed struct field, and an entry point built one of those ways\n62|// would leave these guards live while the pin stayed green. The pin narrows how\n63|// such a change can arrive unnoticed; it does not make it impossible, which is\n64|// the reason these terms stay rather than being deleted.\n65|\n66|type immutableObjectShapeValidator func(map[string]any) error\n67|\n68|// immutableObjectShapeValidators is deliberately explicit. The self-identity\n69|// catalog selects the self field, but catalog membership alone does not prove\n70|// that this package implements a schema's complete closed shape. Every\n71|// registered schema/version therefore resolves either to a concrete validator\n72|// or to an explicit refusal. validateImmutableObjectShapeValidators binds this\n73|// table back to the generated registry so a newly registered row cannot fall\n74|// through to extension-only attestation.\n75|var immutableObjectShapeValidators = mustBuildImmutableObjectShapeValidators()\n76|\n77|func mustBuildImmutableObjectShapeValidators() map[schemaIdentityKey]immutableObjectShapeValidator {\n78|\tvalidators := make(map[schemaIdentityKey]immutableObjectShapeValidator)\n79|\tregister := func(schema string, validator immutableObjectShapeValidator, versions ...string) {\n80|\t\tfor _, version := range versions {\n81|\t\t\tkey := schemaIdentityKey{schema: schema, version: version}\n82|\t\t\tif _, duplicate := validators[key]; duplicate {\n83|\t\t\t\tpanic(fmt.Sprintf(\"duplicate immutable-object shape validator for %s@%s\", schema, version))\n84|\t\t\t}\n85|\t\t\tvalidators[key] = validator\n86|\t\t}\n87|\t}\n88|\n89|\t// Complete validators owned by the scoped Sections 10.1-10.4 gate.\n90|\tregister(\"urn:ax:schema:session-record\", validateSessionRecordV1, \"1.0.0\")\n91|\tregister(\"urn:ax:schema:session-record\", validateSessionRecordV2, \"2.0.0\")\n92|\tregister(\"urn:ax:schema:session-record\", validateSessionRecordV3, \"3.0.0\")\n93|\tregister(blobSchema, validateBlobDescriptor, closedSchemaVersion)\n94|\tregister(transferManifestSchema, validateTransferManifest, closedSchemaVersion)\n95|\n96|\t// Complete Section 5 and Section 10.1 core-record validators.\n97|\tregister(\"urn:ax:schema:lease\", validateLeaseRecord, \"1.0.0\")\n98|\tregister(\"urn:ax:schema:workspace-group\", validateWorkspaceGroupRecord, \"1.0.0\")\n99|\tregister(\"urn:ax:schema:provider-identity\", validateProviderIdentityRecord, \"1.0.0\")\n100|\tregister(\"urn:ax:schema:session-event\", validateSessionEventV1, \"1.0.0\")\n101|\tregister(\"urn:ax:schema:session-event\", validateSessionEventV2, \"2.0.0\")\n102|\tregister(\"urn:ax:schema:session-event\", validateSessionEventV3, \"3.0.0\")\n103|\tregister(\"urn:ax:schema:session-event\", validateSessionEventV4, \"4.0.0\")\n104|\tregister(\"urn:ax:schema:checkpoint\", validateCheckpointRecord, \"1.0.0\")\n105|\n106|\t// Remaining Section 10.1 records retain their common-envelope gate before\n107|\t// the public identity surface explicitly refuses an unsupported shape.\n108|\tregister(\"urn:ax:schema:tombstone\", validateUnsupportedRecordEnvelopeShape, \"1.0.0\")\n109|\tregister(\"urn:ax:schema:tombstone-ack\", validateUnsupportedRecordEnvelopeShape, \"1.0.0\")\n110|\n111|\t// The remaining registered identities are recognized for self-field\n112|\t// selection but their schema-specific closed shapes are outside this task.\n113|\t// Explicit refusal is safer and more honest than attesting an opaque object.\n114|\tregister(\"urn:ax:schema:canonical-event\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n115|\tregister(\"urn:ax:schema:terminal-backend-manifest\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n116|\tregister(\"urn:ax:schema:session-clone-bundle\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n117|\tregister(\"urn:ax:schema:materialization-plan\", rejectUnsupportedImmutableObjectShape, \"1.0.0\", \"2.0.0\")\n118|\tregister(\"urn:ax:schema:session-continuation-plan\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n119|\tregister(\"urn:ax:schema:task-board-bundle\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n120|\tregister(\"urn:ax:schema:materialization-journal\", rejectUnsupportedImmutableObjectShape, \"2.0.0\")\n121|\tregister(\"urn:ax:schema:environment-observation\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n122|\tregister(\"urn:ax:schema:native-session-observation\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n123|\tregister(\"urn:ax:schema:session-inventory-batch\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n124|\tregister(\"urn:ax:schema:conversation-lineage-link\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n125|\tregister(\"urn:ax:schema:session-annotation\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n126|\tregister(\"urn:ax:schema:session-enrichment-profile\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n127|\tregister(\"urn:ax:schema:session-enrichment-job-request\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n128|\tregister(\"urn:ax:schema:session-enrichment-job-receipt\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n129|\tregister(\"urn:ax:schema:session-directory-operation-receipt\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n130|\tregister(\"urn:ax:schema:terminal-backend-probe\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n131|\tregister(\"urn:ax:schema:terminal-instance-binding\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n132|\tregister(\"urn:ax:schema:terminal-capability-evidence\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n133|\tregister(\"urn:ax:schema:clone-raw-object-manifest\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n134|\tregister(\"urn:ax:schema:clone-capture-manifest\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n135|\tregister(\"urn:ax:schema:canonical-session\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n136|\tregister(\"urn:ax:schema:fidelity-report\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n137|\tregister(\"urn:ax:schema:projection-plan\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n138|\tregister(\"urn:ax:schema:clone-projected-object-manifest\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n139|\tregister(\"urn:ax:schema:clone-read-back-evidence-manifest\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n140|\tregister(\"urn:ax:schema:clone-validation-report\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n141|\tregister(\"urn:ax:schema:migration-checkpoint\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n142|\tregister(\"urn:ax:schema:clone-lineage-receipt\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n143|\tregister(\"urn:ax:schema:supported-environment-tuples\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n144|\n145|\tif err := validateImmutableObjectShapeValidators(validators, catalog.Current().SelfIdentities); err != nil {\n146|\t\tpanic(fmt.Sprintf(\"immutable-object shape validator registry is invalid: %v\", err))\n147|\t}\n148|\treturn validators\n149|}\n150|\n151|func validateImmutableObjectShapeValidators(\n152|\tvalidators map[schemaIdentityKey]immutableObjectShapeValidator,\n153|\tdefinitions []catalog.SelfIdentityContract,\n154|) error {\n155|\texpected := make(map[schemaIdentityKey]struct{})\n156|\tfor _, definition := range definitions {\n157|\t\tfor _, version := range definition.ContractVersions {\n158|\t\t\tkey := schemaIdentityKey{schema: string(definition.ContractID), version: version}\n159|\t\t\texpected[key] = struct{}{}\n160|\t\t\tvalidator, ok := validators[key]\n161|\t\t\tif !ok || validator == nil {\n162|\t\t\t\treturn fmt.Errorf(\"missing immutable-object shape validator for %s@%s\", key.schema, key.version)\n163|\t\t\t}\n164|\t\t}\n165|\t}\n166|\tif len(validators) != len(expected) {\n167|\t\treturn fmt.Errorf(\"immutable-object shape validator table has %d rows, generated registry has %d\", len(validators), len(expected))\n168|\t}\n169|\tfor key := range validators {\n170|\t\tif _, ok := expected[key]; !ok {\n171|\t\t\treturn fmt.Errorf(\"immutable-object shape validator for unregistered schema %s@%s\", key.schema, key.version)\n172|\t\t}\n173|\t}\n174|\treturn nil\n175|}\n176|\n177|// validateImmutableObjectShape is the total closed-shape gate used by both\n178|// object-identity production entries. Registry membership never creates an\n179|// extension-only fall-through: each schema/version has an explicit validator\n180|// or an explicit unsupported-shape refusal.\n181|func validateImmutableObjectShape(object map[string]any) error {\n182|\tschema, err := requiredStringMember(object, \"schema\")\n183|\tif err != nil {\n184|\t\treturn err\n185|\t}\n186|\tversion, err := requiredStringMember(object, \"schema_version\")\n187|\tif err != nil {\n188|\t\treturn err\n189|\t}\n190|\n191|\tvalidator, ok := immutableObjectShapeValidators[schemaIdentityKey{schema: schema, version: version}]\n192|\tif !ok || validator == nil {\n193|\t\treturn invalidIdentity(\"no immutable-object shape validator for %s@%s\", schema, version)\n194|\t}\n195|\treturn validator(object)\n196|}\n197|\n198|func validateSessionRecordV1(object map[string]any) error {\n199|\tif err := requireExactMembers(\"Session Record 1.0.0\", object,\n200|\t\t\"schema\", \"schema_version\", \"record_id\", \"subject_id\", \"session_id\", \"name\", \"kind\",\n201|\t\t\"created_at\", \"created_by_host_id\", \"provider_id\", \"workspace_group_id\", \"execution_profile\",\n202|\t\t\"launch_plan\", \"task_board\", \"fork_provenance\", \"extensions\"); err != nil {\n203|\t\treturn err\n204|\t}\n205|\tsessionID, _, _, err := validateSessionRecordCommon(object, \"1.0.0\")\n206|\tif err != nil {\n207|\t\treturn err\n208|\t}\n209|\treturn validateSessionForkProvenance(object, sessionID)\n210|}\n211|\n212|func validateSessionRecordV2(object map[string]any) error {\n213|\treturn validateSessionRecordWithDerivation(object, \"2.0.0\")\n214|}\n215|\n216|func validateSessionRecordV3(object map[string]any) error {\n217|\treturn validateSessionRecordWithDerivation(object, \"3.0.0\")\n218|}\n219|\n220|func validateSessionRecordWithDerivation(object map[string]any, version string) error {\n221|\tif err := requireExactMembers(\"Session Record 2.0.0 and 3.0.0\", object,\n222|\t\t\"schema\", \"schema_version\", \"record_id\", \"subject_id\", \"session_id\", \"name\", \"kind\",\n223|\t\t\"created_at\", \"created_by_host_id\", \"provider_id\", \"workspace_group_id\", \"execution_profile\",\n224|\t\t\"launch_plan\", \"task_board\", \"derivation_provenance\", \"extensions\"); err != nil {\n225|\t\treturn err\n226|\t}\n227|\tsessionID, providerID, _, err := validateSessionRecordCommon(object, version)\n228|\tif err != nil {\n229|\t\treturn err\n230|\t}\n231|\treturn validateSessionDerivationProvenance(object, version, sessionID, providerID)\n232|}\n233|\n234|func validateSessionRecordCommon(object map[string]any, version string) (string, string, string, error) {\n235|\tif err := requireExactString(object, \"schema\", \"urn:ax:schema:session-record\"); err != nil {\n236|\t\treturn \"\", \"\", \"\", err\n237|\t}\n238|\tif err := requireExactString(object, \"schema_version\", version); err != nil {\n239|\t\treturn \"\", \"\", \"\", err\n240|\t}\n241|\tif err := requireDigest(object, \"record_id\"); err != nil {\n242|\t\treturn \"\", \"\", \"\", err\n243|\t}\n244|\tif err := validateCommonRecordEnvelope(object); err != nil {\n245|\t\treturn \"\", \"\", \"\", err\n246|\t}\n247|\tsubjectID, err := requireUUIDv7(object, \"subject_id\")\n248|\tif err != nil {\n249|\t\treturn \"\", \"\", \"\", err\n250|\t}\n251|\tsessionID, err := requireUUIDv7(object, \"session_id\")\n252|\tif err != nil {\n253|\t\treturn \"\", \"\", \"\", err\n254|\t}\n255|\tif subjectID != sessionID {\n256|\t\treturn \"\", \"\", \"\", invalidIdentity(\"Session Record subject_id must equal session_id\")\n257|\t}\n258|\tname, err := requireString(object, \"name\")\n259|\tif err != nil {\n260|\t\treturn \"\", \"\", \"\", err\n261|\t}\n262|\tif !sessionNamePattern.MatchString(name) {\n263|\t\treturn \"\", \"\", \"\", invalidIdentity(\"Session Record name must match [A-Za-z0-9][A-Za-z0-9._-]{0,63}\")\n264|\t}\n265|\tkind, err := requireEnum(object, \"kind\", \"direct\", \"task_board\")\n266|\tif err != nil {\n267|\t\treturn \"\", \"\", \"\", err\n268|\t}\n269|\tproviderID, err := requireString(object, \"provider_id\")\n270|\tif err != nil {\n271|\t\treturn \"\", \"\", \"\", err\n272|\t}\n273|\tif _, err := scalar.ParseProviderID(providerID); err != nil {\n274|\t\treturn \"\", \"\", \"\", invalidIdentity(\"Session Record provider_id: %v\", err)\n275|\t}\n276|\tif _, err := requireUUIDv7(object, \"workspace_group_id\"); err != nil {\n277|\t\treturn \"\", \"\", \"\", err\n278|\t}\n279|\tif _, err := requireEnum(object, \"execution_profile\", \"standard\", \"yolo\"); err != nil {\n280|\t\treturn \"\", \"\", \"\", err\n281|\t}\n282|\tlaunchPlan, err := requireObject(object, \"launch_plan\")\n283|\tif err != nil {\n284|\t\treturn \"\", \"\", \"\", err\n285|\t}\n286|\tif err := validateSessionLaunchPlan(launchPlan); err != nil {\n287|\t\treturn \"\", \"\", \"\", err\n288|\t}\n289|\tif err := validateSessionTaskBoardReference(object, kind); err != nil {\n290|\t\treturn \"\", \"\", \"\", err\n291|\t}\n292|\treturn sessionID, providerID, kind, nil\n293|}\n294|\n295|func validateSessionLaunchPlan(object map[string]any) error {\n296|\tif err := requireExactMembers(\"Session Record Launch Plan\", object,\n297|\t\t\"argv\", \"cwd_workspace_id\", \"cwd_relative\", \"env_names\", \"env_literals\", \"contains_secrets\", \"extensions\"); err != nil {\n298|\t\treturn err\n299|\t}\n300|\targv, err := requireArray(object, \"argv\", 128)\n301|\tif err != nil {\n302|\t\treturn err\n303|\t}\n304|\tif len(argv) == 0 {\n305|\t\treturn invalidIdentity(\"Session Record Launch Plan argv must contain at least one element\")\n306|\t}\n307|\tfor index, value := range argv {\n308|\t\ttext, ok := value.(string)\n309|\t\t// !utf8.ValidString(text) is subsumed by decodeStrict; see the subsumed\n310|\t\t// UTF-8 re-check note above. The other three terms are reachable.\n311|\t\tif !ok || !utf8.ValidString(text) || len(text) == 0 || len(text) > 4096 {\n312|\t\t\treturn invalidIdentity(\"Session Record Launch Plan argv[%d] must contain 1..4096 UTF-8 bytes\", index)\n313|\t\t}\n314|\t}\n315|\tif err := canonicalByteBound(\"Session Record Launch Plan argv\", argv, 65_536); err != nil {\n316|\t\treturn err\n317|\t}\n318|\tif _, err := requireUUIDv7(object, \"cwd_workspace_id\"); err != nil {\n319|\t\treturn err\n320|\t}\n321|\tif err := requireDotOrRelativePath(object, \"cwd_relative\"); err != nil {\n322|\t\treturn err\n323|\t}\n324|\tenvNames, err := requireArray(object, \"env_names\", 64)\n325|\tif err != nil {\n326|\t\treturn err\n327|\t}\n328|\tseenNames := make(map[string]struct{}, len(envNames))\n329|\tprevious := \"\"\n330|\tfor index, value := range envNames {\n331|\t\tname, ok := value.(string)\n332|\t\tif !ok || !environmentNamePattern.MatchString(name) {\n333|\t\t\treturn invalidIdentity(\"Session Record Launch Plan env_names[%d] has invalid environment-name grammar\", index)\n334|\t\t}\n335|\t\tif index > 0 && name <= previous {\n336|\t\t\treturn invalidIdentity(\"Session Record Launch Plan env_names must be strictly sorted and unique\")\n337|\t\t}\n338|\t\tseenNames[name] = struct{}{}\n339|\t\tprevious = name\n340|\t}\n341|\tenvLiterals, err := requireObject(object, \"env_literals\")\n342|\tif err != nil {\n343|\t\treturn err\n344|\t}\n345|\tif len(envLiterals) > 64 {\n346|\t\treturn invalidIdentity(\"Session Record Launch Plan env_literals contains %d members, maximum is 64\", len(envLiterals))\n347|\t}\n348|\tfor name, value := range envLiterals {\n349|\t\tif !environmentNamePattern.MatchString(name) {\n350|\t\t\treturn invalidIdentity(\"Session Record Launch Plan env_literals key %q has invalid environment-name grammar\", name)\n351|\t\t}\n352|\t\tif _, duplicate := seenNames[name]; duplicate {\n353|\t\t\treturn invalidIdentity(\"Session Record Launch Plan environment name %q occurs in both env_names and env_literals\", name)\n354|\t\t}\n355|\t\ttext, ok := value.(string)\n356|\t\t// !utf8.ValidString(text) is subsumed by decodeStrict; see the subsumed\n357|\t\t// UTF-8 re-check note above. The other two terms are reachable.\n358|\t\tif !ok || !utf8.ValidString(text) || len(text) > 4096 {\n359|\t\t\treturn invalidIdentity(\"Session Record Launch Plan env_literals[%q] must contain at most 4096 UTF-8 bytes\", name)\n360|\t\t}\n361|\t}\n362|\tcontainsSecrets, err := requireBool(object, \"contains_secrets\")\n363|\tif err != nil {\n364|\t\treturn err\n365|\t}\n366|\tif containsSecrets {\n367|\t\treturn invalidIdentity(\"Session Record Launch Plan contains_secrets must be false\")\n368|\t}\n369|\textensions, err := requireObject(object, \"extensions\")\n370|\tif err != nil {\n371|\t\treturn err\n372|\t}\n373|\treturn validateExtensionsObject(extensions)\n374|}\n375|\n376|func validateSessionTaskBoardReference(parent map[string]any, kind string) error {\n377|\tvalue, ok := parent[\"task_board\"]\n378|\tif !ok {\n379|\t\treturn invalidIdentity(\"identity input requires member task_board\")\n380|\t}\n381|\tif kind == \"direct\" {\n382|\t\tif value != nil {\n383|\t\t\treturn invalidIdentity(\"direct Session Record task_board must be null\")\n384|\t\t}\n385|\t\treturn nil\n386|\t}\n387|\tobject, err := requireObjectValue(value, \"Session Record task_board\")\n388|\tif err != nil {\n389|\t\treturn err\n390|\t}\n391|\tif err := requireExactMembers(\"Session Record Task-board Reference\", object,\n392|\t\t\"bridge_protocol_version\", \"board\", \"task_element_id\", \"launch_mode\", \"manager_session_ref\",\n393|\t\t\"board_goal\", \"native_goal_binding\", \"extensions\"); err != nil {\n394|\t\treturn err\n395|\t}\n396|\tif err := requireExactString(object, \"bridge_protocol_version\", \"1.0.0\"); err != nil {\n397|\t\treturn err\n398|\t}\n399|\tboard, err := requireObject(object, \"board\")\n400|\tif err != nil {\n401|\t\treturn err\n402|\t}\n403|\tif err := validateSessionBoardIdentity(board); err != nil {\n404|\t\treturn err\n405|\t}\n406|\tif _, err := requirePrintableByteBoundedString(object, \"task_element_id\", 1, 128); err != nil {\n407|\t\treturn err\n408|\t}\n409|\tlaunchMode, err := requireEnum(object, \"launch_mode\", \"primary_owner\", \"tracked_prompt\")\n410|\tif err != nil {\n411|\t\treturn err\n412|\t}\n413|\tif value, ok := object[\"manager_session_ref\"]; !ok || value != nil {\n414|\t\treturn invalidIdentity(\"Session Record Task-board Reference manager_session_ref must be null at creation\")\n415|\t}\n416|\tbinding, err := requireEnum(object, \"native_goal_binding\", \"bound\", \"prompt\", \"none\")\n417|\tif err != nil {\n418|\t\treturn err\n419|\t}\n420|\tgoalValue, ok := object[\"board_goal\"]\n421|\tif !ok {\n422|\t\treturn invalidIdentity(\"identity input requires member board_goal\")\n423|\t}\n424|\tif launchMode == \"primary_owner\" {\n425|\t\tif goalValue == nil || binding != \"bound\" {\n426|\t\t\treturn invalidIdentity(\"primary_owner Task-board Reference requires a board goal and bound native goal\")\n427|\t\t}\n428|\t} else if binding == \"bound\" {\n429|\t\treturn invalidIdentity(\"tracked_prompt Task-board Reference native_goal_binding must be prompt or none\")\n430|\t}\n431|\tif goalValue != nil {\n432|\t\tgoal, err := requireObjectValue(goalValue, \"Session Record board_goal\")\n433|\t\tif err != nil {\n434|\t\t\treturn err\n435|\t\t}\n436|\t\tif err := validateSessionBoardGoal(goal); err != nil {\n437|\t\t\treturn err\n438|\t\t}\n439|\t}\n440|\textensions, err := requireObject(object, \"extensions\")\n441|\tif err != nil {\n442|\t\treturn err\n443|\t}\n444|\treturn validateExtensionsObject(extensions)\n445|}\n446|\n447|func validateSessionBoardIdentity(object map[string]any) error {\n448|\tif err := requireExactMembers(\"Session Record Board Identity\", object, \"kind\", \"logical_id\", \"remote_url\", \"extensions\"); err != nil {\n449|\t\treturn err\n450|\t}\n451|\tkind, err := requireEnum(object, \"kind\", \"local\", \"remote\")\n452|\tif err != nil {\n453|\t\treturn err\n454|\t}\n455|\tlogicalID, err := requireBoundedString(object, \"logical_id\", 1, 128)\n456|\tif err != nil {\n457|\t\treturn err\n458|\t}\n459|\tif !boardLogicalIDPattern.MatchString(logicalID) {\n460|\t\treturn invalidIdentity(\"Session Record Board Identity logical_id has invalid grammar\")\n461|\t}\n462|\tremoteValue, ok := object[\"remote_url\"]\n463|\tif !ok {\n464|\t\treturn invalidIdentity(\"identity input requires member remote_url\")\n465|\t}\n466|\tif kind == \"local\" {\n467|\t\tif remoteValue != nil {\n468|\t\t\treturn invalidIdentity(\"local Session Record Board Identity remote_url must be null\")\n469|\t\t}\n470|\t} else {\n471|\t\tremoteURL, ok := remoteValue.(string)\n472|\t\t// !utf8.ValidString(remoteURL) is subsumed by decodeStrict; see the\n473|\t\t// subsumed UTF-8 re-check note above. The !ok term is reachable.\n474|\t\tif !ok || !utf8.ValidString(remoteURL) {\n475|\t\t\treturn invalidIdentity(\"remote Session Record Board Identity remote_url must be a UTF-8 string\")\n476|\t\t}\n477|\t\tparsed, err := url.Parse(remoteURL)\n478|\t\tif err != nil || parsed.Scheme != \"https\" || parsed.Host == \"\" || parsed.User != nil || parsed.RawQuery != \"\" || parsed.Fragment != \"\" {\n479|\t\t\treturn invalidIdentity(\"remote Session Record Board Identity remote_url must be absolute HTTPS without userinfo, query, or fragment\")\n480|\t\t}\n481|\t}\n482|\textensions, err := requireObject(object, \"extensions\")\n483|\tif err != nil {\n484|\t\treturn err\n485|\t}\n486|\treturn validateExtensionsObject(extensions)\n487|}\n488|\n489|func validateSessionBoardGoal(object map[string]any) error {\n490|\tif err := requireExactMembers(\"Session Record Board Goal\", object, \"schema\", \"goal_id\", \"revision\", \"extensions\"); err != nil {\n491|\t\treturn err\n492|\t}\n493|\tif err := requireExactString(object, \"schema\", \"board-goal-v2\"); err != nil {\n494|\t\treturn err\n495|\t}\n496|\tif _, err := requireBoundedString(object, \"goal_id\", 1, 128); err != nil {\n497|\t\treturn err\n498|\t}\n499|\trevision, err := requireUint(object, \"revision\", scalar.MaxUint53)\n500|\tif err != nil {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c43d","stream":{"kind":"session","id":"01a0785b-9847-7fa3-b40c-313061570fc0"},"sequence":121,"recorded_at":1780531400000237,"record_type":"event","durability":"durable","causation_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","run_stream":{"kind":"run","id":"5f283545-6d77-4246-bbdf-5a980fc43a74"},"call_id":"call_01a0785bd8387bf3887940042a93be8d","text":"Read text file `internal/terminalbackend/manifest.go`.\n1|// Manifest, Probe, and Capability Evidence admission for the\n2|// TerminalBackend registry.\n3|//\n4|// Normative scope is relux-works/agent-session-manager-spec@v0.5.0 §4.B\n5|// (Manifest/Probe closed schemas, generation digest, reconciliation,\n6|// identity rule), §4.D (closed capability registry, claim rows, evidence\n7|// schema, fact mapping), §6.5 (trust established before any probe;\n8|// configuration admission), and §7.A (generation-bound descriptor binding).\n9|// Lifecycle operations other than admission (create, attach, status, and\n10|// friends) belong to the sibling lifecycle task; this file gates only which\n11|// capabilities an operation may rely on, never the operations themselves.\n12|//\n13|// Fail-closed conventions shared with the registry half of this package:\n14|// every refusal is an *Error with a wire code from the pinned catalog error\n15|// vocabulary and a static Detail clause that never echoes paths, digests,\n16|// generations, or other local data. A partial, malformed, stale, or failed\n17|// Manifest, Probe, or evidence read is an error, never absence or\n18|// availability, so callers must not fall back to a default or to PATH\n19|// discovery.\n20|package terminalbackend\n21|\n22|import (\n23|\t\"bytes\"\n24|\t\"crypto/sha256\"\n25|\t\"encoding/base64\"\n26|\t\"encoding/hex\"\n27|\t\"encoding/json\"\n28|\t\"fmt\"\n29|\t\"strings\"\n30|\t\"time\"\n31|\t\"unicode/utf8\"\n32|\n33|\t\"github.com/gowebpki/jcs\"\n34|\n35|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n36|)\n37|\n38|// Wire error codes this file may report. They extend the registry-half codes\n39|// with the exact Section 15.3 codes for manifest/probe disagreement,\n40|// unevidenced capability use, and integrity failure; every one is a member of\n41|// the pinned catalog error vocabulary.\n42|const (\n43|\t// CodeMismatch reports any failed Manifest/Probe equality, membership,\n44|\t// keyed claim relation, evidence binding, or evidence coverage rule\n45|\t// (§4.B). Malformed Manifest, Probe, or evidence documents also report\n46|\t// this code: a malformed read is an error, never absence.\n47|\tCodeMismatch = \"terminal_backend_manifest_probe_mismatch\"\n48|\t// CodeCapabilityUnproven reports an operation gate evaluated against an\n49|\t// admitted capability set that confers no true capability for the\n50|\t// requested operation (§4.C capability dependencies).\n51|\tCodeCapabilityUnproven = \"terminal_backend_capability_unproven\"\n52|\t// CodeIntegrityFailure reports a missing, malformed, unknown-key, or\n53|\t// invalid capability-evidence signature, or a signature verification\n54|\t// subsystem that is unavailable (§4.D). It fails before capability\n55|\t// admission.\n56|\tCodeIntegrityFailure = \"terminal_backend_integrity_failure\"\n57|)\n58|\n59|// IsMismatch reports CodeMismatch refusals.\n60|func IsMismatch(err error) bool { return errorCode(err, CodeMismatch) }\n61|\n62|// IsCapabilityUnproven reports CodeCapabilityUnproven refusals.\n63|func IsCapabilityUnproven(err error) bool { return errorCode(err, CodeCapabilityUnproven) }\n64|\n65|// IsIntegrityFailure reports CodeIntegrityFailure refusals.\n66|func IsIntegrityFailure(err error) bool { return errorCode(err, CodeIntegrityFailure) }\n67|\n68|// Closed schema literals (§4.B, §4.D). No other schema or version is\n69|// admitted by this file.\n70|const (\n71|\t// SchemaManifest is the Terminal Backend Manifest 1.0.0 schema URN.\n72|\tSchemaManifest = \"urn:ax:schema:terminal-backend-manifest\"\n73|\t// SchemaProbe is the Terminal Backend Probe 1.0.0 schema URN.\n74|\tSchemaProbe = \"urn:ax:schema:terminal-backend-probe\"\n75|\t// SchemaCapabilityEvidence is the Capability Evidence 1.0.0 schema URN.\n76|\tSchemaCapabilityEvidence = \"urn:ax:schema:terminal-capability-evidence\"\n77|\t// SchemaVersion100 is the only contract version this file implements.\n78|\tSchemaVersion100 = \"1.0.0\"\n79|)\n80|\n81|// Closed small vocabularies (§4.B, §4.D).\n82|const (\n83|\t// OriginStatic marks a static manifest echo claim.\n84|\tOriginStatic = \"static\"\n85|\t// OriginProbed marks a live probe observation claim.\n86|\tOriginProbed = \"probed\"\n87|\n88|\t// AvailabilityAvailable marks a ready backend.\n89|\tAvailabilityAvailable = \"available\"\n90|\t// AvailabilityConditional marks a backend that needs operator action.\n91|\tAvailabilityConditional = \"conditional\"\n92|\t// AvailabilityUnavailable marks a backend that cannot serve.\n93|\tAvailabilityUnavailable = \"unavailable\"\n94|\t// AvailabilityUnknown marks a backend whose readiness is not established.\n95|\tAvailabilityUnknown = \"unknown\"\n96|\n97|\t// IssuerRelease marks release-signed capability evidence.\n98|\tIssuerRelease = \"ax_release\"\n99|\t// IssuerLocalProbe marks host-incarnation-signed capability evidence.\n100|\tIssuerLocalProbe = \"ax_local_probe\"\n101|)\n102|\n103|// signatureSchemePrefix is the literal attestation_signature scheme (§4.D).\n104|const signatureSchemePrefix = \"rsa-sha256:\"\n105|\n106|// generationDigestDomain is the UTF-8 domain separator prepended to the\n107|// backend's host-local raw generation bytes before SHA-256 (§4.B). It\n108|// neither reveals nor reconstructs that generation.\n109|const generationDigestDomain = \"ax-terminal-backend-generation-v1\\x00\"\n110|\n111|// evidenceSignatureDomain is the ASCII domain separator prepended to the\n112|// canonical evidence bytes before signing (§4.D).\n113|const evidenceSignatureDomain = \"ax-terminal-capability-evidence-v1\"\n114|\n115|// Closed TerminalBackendCapability registry (§4.D). The map key is the\n116|// capability name; the row carries the exact registry members a Manifest or\n117|// Probe claim must repeat verbatim.\n118|type capabilityRow struct {\n119|\tgenerationVariable   bool\n120|\tdependentOperations  []string\n121|\tevidenceRequirements []string\n122|}\n123|\n124|// capabilityRegistry is the exact 16-value Section 4.D table. Dependent\n125|// operations and evidence requirements are stored sorted as the wire\n126|// requires, so row comparison is element-wise.\n127|var capabilityRegistry = map[string]capabilityRow{\n128|\t\"durable_disconnect\": {\n129|\t\tgenerationVariable:   false,\n130|\t\tdependentOperations:  []string{\"create\", \"status\"},\n131|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n132|\t},\n133|\t\"local_attach\": {\n134|\t\tgenerationVariable:   true,\n135|\t\tdependentOperations:  []string{\"attach\"},\n136|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n137|\t},\n138|\t\"remote_attach\": {\n139|\t\tgenerationVariable:   true,\n140|\t\tdependentOperations:  []string{\"attach\"},\n141|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n142|\t},\n143|\t\"web_attach\": {\n144|\t\tgenerationVariable:   true,\n145|\t\tdependentOperations:  []string{\"attach\"},\n146|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n147|\t},\n148|\t\"multi_attach\": {\n149|\t\tgenerationVariable:   true,\n150|\t\tdependentOperations:  []string{\"attach\"},\n151|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n152|\t},\n153|\t\"headless_creation\": {\n154|\t\tgenerationVariable:   true,\n155|\t\tdependentOperations:  []string{\"create\"},\n156|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n157|\t},\n158|\t\"reboot_restoration\": {\n159|\t\tgenerationVariable:   true,\n160|\t\tdependentOperations:  []string{\"restore\"},\n161|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n162|\t},\n163|\t\"input_quiescence\": {\n164|\t\tgenerationVariable:   true,\n165|\t\tdependentOperations:  []string{\"quiesce-input\"},\n166|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n167|\t},\n168|\t\"safe_boundary_observation\": {\n169|\t\tgenerationVariable:   true,\n170|\t\tdependentOperations:  []string{\"wait-safe-boundary\"},\n171|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n172|\t},\n173|\t\"provider_process_observation\": {\n174|\t\tgenerationVariable:   true,\n175|\t\tdependentOperations:  []string{\"status\", \"terminate-stale\", \"wait-safe-boundary\"},\n176|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n177|\t},\n178|\t\"graceful_stop\": {\n179|\t\tgenerationVariable:   true,\n180|\t\tdependentOperations:  []string{\"request-stop\"},\n181|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n182|\t},\n183|\t\"stale_process_termination\": {\n184|\t\tgenerationVariable:   true,\n185|\t\tdependentOperations:  []string{\"terminate-stale\"},\n186|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n187|\t},\n188|\t\"terminal_state_retention\": {\n189|\t\tgenerationVariable:   true,\n190|\t\tdependentOperations:  []string{\"create\", \"restore\", \"status\"},\n191|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n192|\t},\n193|\t\"scrollback_retention\": {\n194|\t\tgenerationVariable:   true,\n195|\t\tdependentOperations:  []string{\"create\", \"restore\", \"status\"},\n196|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"runtime_probe\"},\n197|\t},\n198|\t\"credential_capable_execution_realm\": {\n199|\t\tgenerationVariable:  true,\n200|\t\tdependentOperations: []string{\"create\", \"restore\"},\n201|\t\tevidenceRequirements: []string{\n202|\t\t\t\"conformance_fixture\", \"credential_sentinel\", \"provider_auth_smoke\", \"runtime_probe\",\n203|\t\t},\n204|\t},\n205|\t\"multiple_input_clients\": {\n206|\t\tgenerationVariable:   true,\n207|\t\tdependentOperations:  []string{\"attach\"},\n208|\t\tevidenceRequirements: []string{\"conformance_fixture\", \"policy_authorization\", \"runtime_probe\"},\n209|\t},\n210|}\n211|\n212|// credentialRealmCapability is the one capability whose evidence carries the\n213|// terminal-binding, provider, sentinel, and smoke members (§4.D). Every other\n214|// capability's evidence must leave those members null.\n215|const credentialRealmCapability = \"credential_capable_execution_realm\"\n216|\n217|// requirementFact maps every CapabilityEvidenceRequirement to the\n218|// CapabilityEvidenceFact that satisfies it (§4.D). ui_absent and\n219|// prompt_absent are supplementary facts with no requirement mapping: they\n220|// may accompany evidence but never satisfy a requirement alone.\n221|var requirementFact = map[string]string{\n222|\t\"conformance_fixture\":  \"fixture_passed\",\n223|\t\"runtime_probe\":        \"runtime_probe_passed\",\n224|\t\"credential_sentinel\":  \"sentinel_passed\",\n225|\t\"provider_auth_smoke\":  \"provider_auth_passed\",\n226|\t\"policy_authorization\": \"policy_checked\",\n227|}\n228|\n229|// Closed TerminalBackendOperation vocabulary (§4.D).\n230|var operationVocabulary = map[string]bool{\n231|\t\"manifest\": true, \"probe\": true, \"create\": true, \"attach\": true,\n232|\t\"status\": true, \"quiesce-input\": true, \"wait-safe-boundary\": true,\n233|\t\"request-stop\": true, \"terminate-stale\": true, \"restore\": true,\n234|}\n235|\n236|// Closed CapabilityEvidenceRequirement vocabulary (§4.D).\n237|var evidenceRequirementVocabulary = map[string]bool{\n238|\t\"conformance_fixture\": true, \"runtime_probe\": true,\n239|\t\"credential_sentinel\": true, \"provider_auth_smoke\": true,\n240|\t\"policy_authorization\": true,\n241|}\n242|\n243|// Closed CapabilityEvidenceFact vocabulary (§4.D).\n244|var evidenceFactVocabulary = map[string]bool{\n245|\t\"fixture_passed\": true, \"runtime_probe_passed\": true,\n246|\t\"sentinel_passed\": true, \"provider_auth_passed\": true,\n247|\t\"policy_checked\": true, \"ui_absent\": true, \"prompt_absent\": true,\n248|}\n249|\n250|// Document bounds shared by the three closed schemas.\n251|const (\n252|\tmaxClaims          = 16\n253|\tmaxEvidenceIDs     = 256\n254|\tmaxOperations      = 10\n255|\tmaxRequirements    = 5\n256|\tmaxFacts           = 7\n257|\tmaxOpaqueString    = 256\n258|\tmaxJSONDepth       = 32\n259|\tmaxNativeReference = 512\n260|)\n261|\n262|// mismatchf refuses with CodeMismatch and a static detail clause. The clause\n263|// must never interpolate local data: paths, digests, generations, and\n264|// document bytes stay out of errors.\n265|func mismatchf(format string, arguments ...any) *Error {\n266|\treturn &Error{Code: CodeMismatch, Detail: fmt.Sprintf(format, arguments...)}\n267|}\n268|\n269|// hasLoneSurrogateEscape reports whether raw JSON carries a lone surrogate\n270|// code point inside any string literal, either as a \\uXXXX escape or as raw\n271|// WTF-8 (CESU-8) bytes ED A0..BF 80..BF, which decode to U+D800..U+DFFF.\n272|// It answers only the surrogate question: malformed escapes, other invalid\n273|// UTF-8, unescaped control characters, and unterminated strings are left\n274|// for the decoder's syntax and encoding arms, which refuse them with their\n275|// own details. The scan mirrors internal/canonicaljson\n276|// validateSurrogateEscapes without importing it: canonicaljson is\n277|// byte-identical across stories and must not be edited at integration, so\n278|// the two copies are pinned equal by\n279|// TestSurrogateGateAgreesWithCanonicalJSON instead of shared.\n280|func hasLoneSurrogateEscape(raw []byte) bool {\n281|\tfor index := 0; index < len(raw); index++ {\n282|\t\tif raw[index] != '\"' {\n283|\t\t\tcontinue\n284|\t\t}\n285|\t\tfor index++; index < len(raw); index++ {\n286|\t\t\tif isWTF8SurrogateAt(raw, index) {\n287|\t\t\t\treturn true\n288|\t\t\t}\n289|\t\t\tswitch raw[index] {\n290|\t\t\tcase '\"':\n291|\t\t\t\tgoto stringComplete\n292|\t\t\tcase '\\\\':\n293|\t\t\t\tindex++\n294|\t\t\t\tif index >= len(raw) {\n295|\t\t\t\t\treturn false\n296|\t\t\t\t}\n297|\t\t\t\t// The escaped byte is skipped by the switch below without\n298|\t\t\t\t// passing the loop head, so test it here: a WTF-8 head\n299|\t\t\t\t// immediately after a backslash (for example \"...\\n<ED A0\n300|\t\t\t\t// 80>...\") is still raw bytes on the wire, not an escape.\n301|\t\t\t\tif isWTF8SurrogateAt(raw, index) {\n302|\t\t\t\t\treturn true\n303|\t\t\t\t}\n304|\t\t\t\tif raw[index] != 'u' {\n305|\t\t\t\t\tcontinue\n306|\t\t\t\t}\n307|\t\t\t\tunit, end, ok := readUTF16EscapeUnit(raw, index-1)\n308|\t\t\t\tif !ok {\n309|\t\t\t\t\tcontinue\n310|\t\t\t\t}\n311|\t\t\t\tindex = end - 1\n312|\t\t\t\tswitch {\n313|\t\t\t\tcase unit >= 0xd800 && unit <= 0xdbff:\n314|\t\t\t\t\tsecond, secondEnd, ok := readUTF16EscapeUnit(raw, end)\n315|\t\t\t\t\tif !ok || second < 0xdc00 || second > 0xdfff {\n316|\t\t\t\t\t\treturn true\n317|\t\t\t\t\t}\n318|\t\t\t\t\tindex = secondEnd - 1\n319|\t\t\t\tcase unit >= 0xdc00 && unit <= 0xdfff:\n320|\t\t\t\t\treturn true\n321|\t\t\t\t}\n322|\t\t\t}\n323|\t\t}\n324|\tstringComplete:\n325|\t}\n326|\treturn false\n327|}\n328|\n329|// isWTF8SurrogateAt reports whether raw[index] begins a three-byte WTF-8\n330|// (CESU-8) encoding of a surrogate code point: ED A0..BF 80..BF decodes to\n331|// U+D800..U+DFFF, which utf8.Valid refuses. Only this ED range is\n332|// surrogate-shaped: ED 80..9F heads U+D000..U+D7FF, which is valid UTF-8\n333|// and must not match. A truncated tail cannot be classified here and is\n334|// left for the encoding arm.\n335|func isWTF8SurrogateAt(raw []byte, index int) bool {\n336|\treturn index+2 < len(raw) && raw[index] == 0xed &&\n337|\t\traw[index+1] >= 0xa0 && raw[index+1] <= 0xbf &&\n338|\t\traw[index+2] >= 0x80 && raw[index+2] <= 0xbf\n339|}\n340|\n341|// readUTF16EscapeUnit reads one \\uXXXX escape at raw[start] (which must be\n342|// the backslash). It reports false when the escape is absent or malformed;\n343|// malformed escapes are refused by the decoder's syntax arm, so this gate\n344|// only needs to stay silent on them rather than diagnose them.\n345|func readUTF16EscapeUnit(raw []byte, start int) (uint16, int, bool) {\n346|\tif start < 0 || start+6 > len(raw) || raw[start] != '\\\\' || raw[start+1] != 'u' {\n347|\t\treturn 0, start, false\n348|\t}\n349|\tvar unit uint16\n350|\tfor _, digit := range raw[start+2 : start+6] {\n351|\t\tunit <<= 4\n352|\t\tswitch {\n353|\t\tcase digit >= '0' && digit <= '9':\n354|\t\t\tunit |= uint16(digit - '0')\n355|\t\tcase digit >= 'a' && digit <= 'f':\n356|\t\t\tunit |= uint16(digit-'a') + 10\n357|\t\tcase digit >= 'A' && digit <= 'F':\n358|\t\t\tunit |= uint16(digit-'A') + 10\n359|\t\tdefault:\n360|\t\t\treturn 0, start, false\n361|\t\t}\n362|\t}\n363|\treturn unit, start + 6, true\n364|}\n365|\n366|// decodeStrictObject decodes one JSON object with duplicate-key refusal,\n367|// invalid-UTF-8 refusal, lone-surrogate-escape refusal, a nesting cap, and\n368|// trailing-data refusal. The surrogate scan runs on the raw bytes before\n369|// any canonicalization (SPEC.md:289): Go's encoding/json would silently\n370|// replace a lone \\ud800 with U+FFFD, hiding the violation from every later\n371|// member check. Numbers\n372|// decode as json.Number so member validators can refuse them explicitly:\n373|// none of the three closed schemas has a numeric member.\n374|func decodeStrictObject(raw []byte) (map[string]any, error) {\n375|\tif !utf8.Valid(raw) {\n376|\t\treturn nil, mismatchf(\"document encoding\")\n377|\t}\n378|\tif hasLoneSurrogateEscape(raw) {\n379|\t\treturn nil, mismatchf(\"document surrogate escape\")\n380|\t}\n381|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n382|\tdecoder.UseNumber()\n383|\tvalue, err := decodeCappedValue(decoder, 0)\n384|\tif err != nil {\n385|\t\treturn nil, err\n386|\t}\n387|\tif decoder.More() {\n388|\t\treturn nil, mismatchf(\"document trailing data\")\n389|\t}\n390|\tobject, ok := value.(map[string]any)\n391|\tif !ok {\n392|\t\treturn nil, mismatchf(\"document shape\")\n393|\t}\n394|\treturn object, nil\n395|}\n396|\n397|// decodeCappedValue decodes one JSON value with an explicit depth bound. The\n398|// bound is far above the deepest legitimate nesting (object, claims array,\n399|// claim object, member array) and fails closed below any decoder-stack risk.\n400|func decodeCappedValue(decoder *json.Decoder, depth int) (any, error) {\n401|\tif depth > maxJSONDepth {\n402|\t\treturn nil, mismatchf(\"document nesting\")\n403|\t}\n404|\ttoken, err := decoder.Token()\n405|\tif err != nil {\n406|\t\treturn nil, mismatchf(\"document syntax\")\n407|\t}\n408|\tif delimiter, ok := token.(json.Delim); ok {\n409|\t\tswitch delimiter {\n410|\t\tcase '{':\n411|\t\t\tobject := make(map[string]any)\n412|\t\t\tfor decoder.More() {\n413|\t\t\t\tkeyToken, err := decoder.Token()\n414|\t\t\t\tif err != nil {\n415|\t\t\t\t\treturn nil, mismatchf(\"document syntax\")\n416|\t\t\t\t}\n417|\t\t\t\tkey, ok := keyToken.(string)\n418|\t\t\t\tif !ok {\n419|\t\t\t\t\treturn nil, mismatchf(\"document syntax\")\n420|\t\t\t\t}\n421|\t\t\t\tif _, duplicate := object[key]; duplicate {\n422|\t\t\t\t\treturn nil, mismatchf(\"document duplicate member\")\n423|\t\t\t\t}\n424|\t\t\t\tmember, err := decodeCappedValue(decoder, depth+1)\n425|\t\t\t\tif err != nil {\n426|\t\t\t\t\treturn nil, err\n427|\t\t\t\t}\n428|\t\t\t\tobject[key] = member\n429|\t\t\t}\n430|\t\t\tif _, err := decoder.Token(); err != nil {\n431|\t\t\t\treturn nil, mismatchf(\"document syntax\")\n432|\t\t\t}\n433|\t\t\treturn object, nil\n434|\t\tcase '[':\n435|\t\t\t// Non-nil initialization: an empty wire array must round-trip\n436|\t\t\t// as [] rather than null, or identity recomputation over an\n437|\t\t\t// empty claim or evidence list diverges from the signer.\n438|\t\t\tarray := []any{}\n439|\t\t\tfor decoder.More() {\n440|\t\t\t\tmember, err := decodeCappedValue(decoder, depth+1)\n441|\t\t\t\tif err != nil {\n442|\t\t\t\t\treturn nil, err\n443|\t\t\t\t}\n444|\t\t\t\tarray = append(array, member)\n445|\t\t\t}\n446|\t\t\tif _, err := decoder.Token(); err != nil {\n447|\t\t\t\treturn nil, mismatchf(\"document syntax\")\n448|\t\t\t}\n449|\t\t\treturn array, nil\n450|\t\tdefault:\n451|\t\t\treturn nil, mismatchf(\"document syntax\")\n452|\t\t}\n453|\t}\n454|\treturn token, nil\n455|}\n456|\n457|// checkExactMembers refuses any deviation from the closed member set: an\n458|// unknown member and a missing member are both malformed.\n459|func checkExactMembers(object map[string]any, members []string) error {\n460|\tif len(object) != len(members) {\n461|\t\treturn mismatchf(\"document members\")\n462|\t}\n463|\tfor _, member := range members {\n464|\t\tif _, known := object[member]; !known {\n465|\t\t\treturn mismatchf(\"document members\")\n466|\t\t}\n467|\t}\n468|\treturn nil\n469|}\n470|\n471|// stringMember extracts a required string member. Numbers, booleans, nulls,\n472|// arrays, and objects are refused: no member of these schemas takes them.\n473|func stringMember(object map[string]any, name string) (string, error) {\n474|\tvalue, ok := object[name].(string)\n475|\tif !ok {\n476|\t\treturn \"\", mismatchf(\"document member type\")\n477|\t}\n478|\treturn value, nil\n479|}\n480|\n481|// boundedStringMember extracts a required string[1..256] measured in UTF-8\n482|// characters over valid UTF-8 (SPEC.md:321), the canonical bound in every\n483|// containing contract.\n484|func boundedStringMember(object map[string]any, name string) (string, error) {\n485|\tvalue, err := stringMember(object, name)\n486|\tif err != nil {\n487|\t\treturn \"\", err\n488|\t}\n489|\tif !utf8.ValidString(value) || utf8.RuneCountInString(value) < 1 || utf8.RuneCountInString(value) > maxOpaqueString {\n490|\t\treturn \"\", mismatchf(\"document string bound\")\n491|\t}\n492|\treturn value, nil\n493|}\n494|\n495|// digestMember extracts a required sha256: digest member.\n496|func digestMember(object map[string]any, name string) (string, error) {\n497|\tvalue, err := stringMember(object, name)\n498|\tif err != nil {\n499|\t\treturn \"\", err\n500|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c43f","stream":{"kind":"session","id":"01a0785b-9847-7fa3-b40c-313061570fc0"},"sequence":122,"recorded_at":1780531400000239,"record_type":"event","durability":"durable","causation_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","run_stream":{"kind":"run","id":"5f283545-6d77-4246-bbdf-5a980fc43a74"},"call_id":"call_01a0785bd8a27931bbcc976011273b47","text":"Read text file `internal/provhost/identity.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"regexp\"\n6|\t\"strings\"\n7|)\n8|\n9|// This file validates the Provider Identity Record (Section 5.5,\n10|// urn:ax:schema:provider-identity 1.0.0) the host reads from\n11|// identify-session results and carries in launch, resume, quiesce,\n12|// and fork bodies, plus the identify-session success wrapper. The\n13|// record_id is required to be a digest but is not recomputed here:\n14|// content addressing belongs to the object-identity story, and this\n15|// package holds no canonical encoder. The opaque_identity absolute\n16|// prefix rule mirrors the decidable half of the Section 5.5\n17|// sentence: a value beginning with an absolute path is refused, and\n18|// an embedded path the prefix cannot see is a stated bound.\n19|//\n20|// CheckIdentity deliberately re-validates the record shape instead of\n21|// delegating to canonicaljson.validateProviderIdentityRecord: this\n22|// package must mint Section 15.1 provider-stdio refusals\n23|// (provider_protocol_error with member attribution), not identity\n24|// errors, and the shared package offers no such entry point. The two\n25|// validators must agree on the Section 5.5 shape rule for rule; the\n26|// decoder half of that agreement is pinned by the derived\n27|// TestSurrogateGateDerivedSweepAgreesWithCanonicalJSON sweep, which\n28|// judges escape and raw-UTF-8 vectors through the shared\n29|// decodeStrictObject every entry here reads through, and any\n30|// shape-rule change must land in both validators in the same change.\n31|\n32|// identitySchema is the exact schema identifier the record carries.\n33|const identitySchema = \"urn:ax:schema:provider-identity\"\n34|\n35|// identitySchemaVersion is the only identity version accepted.\n36|const identitySchemaVersion = \"1.0.0\"\n37|\n38|// identityKinds is the closed identity-kind enum in section order.\n39|var identityKinds = []string{\n40|\t\"session_uuid\",\n41|\t\"session_path_or_id\",\n42|\t\"backend_conversation_uuid\",\n43|\t\"task_board_managed\",\n44|\t\"provider_defined\",\n45|}\n46|\n47|// identityMembers is the exact required member set of a Provider\n48|// Identity Record.\n49|var identityMembers = map[string]bool{\n50|\t\"schema\":                    true,\n51|\t\"schema_version\":            true,\n52|\t\"record_id\":                 true,\n53|\t\"subject_id\":                true,\n54|\t\"session_id\":                true,\n55|\t\"provider_id\":               true,\n56|\t\"provider_version\":          true,\n57|\t\"provider_version_range\":    true,\n58|\t\"native_session_id\":         true,\n59|\t\"identity_kind\":             true,\n60|\t\"logical_workspace_id\":      true,\n61|\t\"backend_realm_fingerprint\": true,\n62|\t\"opaque_identity\":           true,\n63|\t\"created_by_host_id\":        true,\n64|\t\"created_at\":                true,\n65|\t\"extensions\":                true,\n66|}\n67|\n68|// identityRequired lists identityMembers in a fixed order so a record\n69|// missing several members always names the same one.\n70|var identityRequired = []string{\n71|\t\"schema\",\n72|\t\"schema_version\",\n73|\t\"record_id\",\n74|\t\"subject_id\",\n75|\t\"session_id\",\n76|\t\"provider_id\",\n77|\t\"provider_version\",\n78|\t\"provider_version_range\",\n79|\t\"native_session_id\",\n80|\t\"identity_kind\",\n81|\t\"logical_workspace_id\",\n82|\t\"backend_realm_fingerprint\",\n83|\t\"opaque_identity\",\n84|\t\"created_by_host_id\",\n85|\t\"created_at\",\n86|\t\"extensions\",\n87|}\n88|\n89|// identityKeyPattern is the provider-identity key grammar Section 5.5\n90|// states: [a-z][a-z0-9_.-]{0,63}.\n91|var identityKeyPattern = regexp.MustCompile(`^[a-z][a-z0-9_.-]{0,63}$`)\n92|\n93|// windowsDrivePattern matches a Windows drive-qualified absolute\n94|// prefix: a letter, a colon, and a separator.\n95|var windowsDrivePattern = regexp.MustCompile(`^[A-Za-z]:[\\\\/]`)\n96|\n97|// CheckIdentity validates one Provider Identity Record naming the\n98|// expected provider. Shape violations are provider_protocol_errors;\n99|// a well-formed record for another provider is an invalid_config\n100|// caller error: the caller correlated the wrong identity to this\n101|// session.\n102|func CheckIdentity(body []byte, wantProviderID string) error {\n103|\tmembers, fault := decodeStrictObject(body)\n104|\tif fault != nil {\n105|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n106|\t\tif err != nil {\n107|\t\t\treturn err\n108|\t\t}\n109|\t\treturn failure\n110|\t}\n111|\tif name, unknown := unknownMember(members, identityMembers); unknown {\n112|\t\tfailure, err := failProtocol(\"identity carries unknown member\", name)\n113|\t\tif err != nil {\n114|\t\t\treturn err\n115|\t\t}\n116|\t\treturn failure\n117|\t}\n118|\tif name, missing := missingMember(members, identityRequired); missing {\n119|\t\tfailure, err := failProtocol(\"identity misses a required member\", name)\n120|\t\tif err != nil {\n121|\t\t\treturn err\n122|\t\t}\n123|\t\treturn failure\n124|\t}\n125|\tif schema, ok := rawString(members[\"schema\"]); !ok || schema != identitySchema {\n126|\t\tfailure, err := failProtocol(\"identity schema is not the provider identity\", \"schema\")\n127|\t\tif err != nil {\n128|\t\t\treturn err\n129|\t\t}\n130|\t\treturn failure\n131|\t}\n132|\tif version, ok := rawString(members[\"schema_version\"]); !ok || version != identitySchemaVersion {\n133|\t\tfailure, err := failProtocol(\"identity schema_version is not 1.0.0\", \"schema_version\")\n134|\t\tif err != nil {\n135|\t\t\treturn err\n136|\t\t}\n137|\t\treturn failure\n138|\t}\n139|\tif digest, ok := rawString(members[\"record_id\"]); !ok || !isDigest(digest) {\n140|\t\tfailure, err := failProtocol(\"identity record_id is not a digest\", \"record_id\")\n141|\t\tif err != nil {\n142|\t\t\treturn err\n143|\t\t}\n144|\t\treturn failure\n145|\t}\n146|\tsubject, ok := rawString(members[\"subject_id\"])\n147|\tif !ok || !isUUIDv7(subject) {\n148|\t\tfailure, err := failProtocol(\"identity subject_id is not a UUIDv7\", \"subject_id\")\n149|\t\tif err != nil {\n150|\t\t\treturn err\n151|\t\t}\n152|\t\treturn failure\n153|\t}\n154|\tsession, ok := rawString(members[\"session_id\"])\n155|\tif !ok || !isUUIDv7(session) {\n156|\t\tfailure, err := failProtocol(\"identity session_id is not a UUIDv7\", \"session_id\")\n157|\t\tif err != nil {\n158|\t\t\treturn err\n159|\t\t}\n160|\t\treturn failure\n161|\t}\n162|\tif subject != session {\n163|\t\tfailure, err := failProtocol(\"identity subject_id does not equal session_id\", \"subject_id\")\n164|\t\tif err != nil {\n165|\t\t\treturn err\n166|\t\t}\n167|\t\treturn failure\n168|\t}\n169|\tprovider, ok := rawString(members[\"provider_id\"])\n170|\tif !ok || !validProviderID(provider) {\n171|\t\tfailure, err := failProtocol(\"identity provider_id is not a provider id\", \"provider_id\")\n172|\t\tif err != nil {\n173|\t\t\treturn err\n174|\t\t}\n175|\t\treturn failure\n176|\t}\n177|\tif provider != wantProviderID {\n178|\t\tfailure, err := failInvalid(\"identity names another provider\")\n179|\t\tif err != nil {\n180|\t\t\treturn err\n181|\t\t}\n182|\t\treturn failure\n183|\t}\n184|\tif !isBoundedString(members[\"provider_version\"], 1, 128) {\n185|\t\tfailure, err := failProtocol(\"identity provider_version is not 1..128 characters\", \"provider_version\")\n186|\t\tif err != nil {\n187|\t\t\treturn err\n188|\t\t}\n189|\t\treturn failure\n190|\t}\n191|\tif !isBoundedString(members[\"provider_version_range\"], 1, 256) {\n192|\t\tfailure, err := failProtocol(\"identity provider_version_range is not 1..256 characters\", \"provider_version_range\")\n193|\t\tif err != nil {\n194|\t\t\treturn err\n195|\t\t}\n196|\t\treturn failure\n197|\t}\n198|\tif !isBoundedString(members[\"native_session_id\"], 1, 512) {\n199|\t\tfailure, err := failProtocol(\"identity native_session_id is not 1..512 characters\", \"native_session_id\")\n200|\t\tif err != nil {\n201|\t\t\treturn err\n202|\t\t}\n203|\t\treturn failure\n204|\t}\n205|\tkind, ok := rawString(members[\"identity_kind\"])\n206|\tif !ok || !isIdentityKind(kind) {\n207|\t\tfailure, err := failProtocol(\"identity kind is not a registry member\", \"identity_kind\")\n208|\t\tif err != nil {\n209|\t\t\treturn err\n210|\t\t}\n211|\t\treturn failure\n212|\t}\n213|\tif workspace, ok := rawString(members[\"logical_workspace_id\"]); !ok || !isUUIDv7(workspace) {\n214|\t\tfailure, err := failProtocol(\"identity workspace is not a UUIDv7\", \"logical_workspace_id\")\n215|\t\tif err != nil {\n216|\t\t\treturn err\n217|\t\t}\n218|\t\treturn failure\n219|\t}\n220|\tif err := checkIdentityRealm(members[\"backend_realm_fingerprint\"], provider, kind); err != nil {\n221|\t\treturn err\n222|\t}\n223|\tif err := checkIdentityOpaque(members[\"opaque_identity\"]); err != nil {\n224|\t\treturn err\n225|\t}\n226|\tif host, ok := rawString(members[\"created_by_host_id\"]); !ok || !isUUIDv7(host) {\n227|\t\tfailure, err := failProtocol(\"identity host is not a UUIDv7\", \"created_by_host_id\")\n228|\t\tif err != nil {\n229|\t\t\treturn err\n230|\t\t}\n231|\t\treturn failure\n232|\t}\n233|\tif created, ok := rawString(members[\"created_at\"]); !ok || !isTimestamp(created) {\n234|\t\tfailure, err := failProtocol(\"identity timestamp is not a timestamp\", \"created_at\")\n235|\t\tif err != nil {\n236|\t\t\treturn err\n237|\t\t}\n238|\t\treturn failure\n239|\t}\n240|\tif !isJSONObject(members[\"extensions\"]) {\n241|\t\tfailure, err := failProtocol(\"identity extensions is not an object\", \"extensions\")\n242|\t\tif err != nil {\n243|\t\t\treturn err\n244|\t\t}\n245|\t\treturn failure\n246|\t}\n247|\treturn nil\n248|}\n249|\n250|// checkIdentityRealm enforces the digest-or-null shape and the one\n251|// conditional rule Section 5.5 states: an Antigravity\n252|// backend_conversation_uuid MUST carry a non-null realm fingerprint,\n253|// because the backend realm is a resume precondition there.\n254|func checkIdentityRealm(raw json.RawMessage, provider, kind string) error {\n255|\trealm, isNull, ok := rawNullableString(raw)\n256|\tif !ok || (!isNull && !isDigest(realm)) {\n257|\t\tfailure, err := failProtocol(\"identity realm is not a digest or null\", \"backend_realm_fingerprint\")\n258|\t\tif err != nil {\n259|\t\t\treturn err\n260|\t\t}\n261|\t\treturn failure\n262|\t}\n263|\tif provider == \"antigravity\" && kind == \"backend_conversation_uuid\" && isNull {\n264|\t\tfailure, err := failProtocol(\"identity realm is required for this backend kind\", \"backend_realm_fingerprint\")\n265|\t\tif err != nil {\n266|\t\t\treturn err\n267|\t\t}\n268|\t\treturn failure\n269|\t}\n270|\treturn nil\n271|}\n272|\n273|// checkIdentityOpaque enforces the explicit adapter-data surface: an\n274|// object of at most 32 entries, keyed by the provider-identity key\n275|// grammar, with non-secret string values of 1..1,024 characters that\n276|// MUST NOT begin with an absolute path.\n277|func checkIdentityOpaque(raw json.RawMessage) error {\n278|\topaque, fault := decodeStrictObject(raw)\n279|\tif fault != nil {\n280|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n281|\t\tif err != nil {\n282|\t\t\treturn err\n283|\t\t}\n284|\t\treturn failure\n285|\t}\n286|\tif len(opaque) > 32 {\n287|\t\tfailure, err := failProtocol(\"identity opaque_identity exceeds 32 entries\", \"opaque_identity\")\n288|\t\tif err != nil {\n289|\t\t\treturn err\n290|\t\t}\n291|\t\treturn failure\n292|\t}\n293|\tkeys := make([]string, 0, len(opaque))\n294|\tfor key := range opaque {\n295|\t\tkeys = append(keys, key)\n296|\t}\n297|\tfor _, key := range keys {\n298|\t\tif !identityKeyPattern.MatchString(key) {\n299|\t\t\tfailure, err := failProtocol(\"identity opaque key is not a provider key\", \"opaque_identity\")\n300|\t\t\tif err != nil {\n301|\t\t\t\treturn err\n302|\t\t\t}\n303|\t\t\treturn failure\n304|\t\t}\n305|\t\tvalue, ok := rawString(opaque[key])\n306|\t\tif !ok || runeLength(value) < 1 || runeLength(value) > 1024 {\n307|\t\t\tfailure, err := failProtocol(\"identity opaque value is not 1..1024 characters\", \"opaque_identity\")\n308|\t\t\tif err != nil {\n309|\t\t\t\treturn err\n310|\t\t\t}\n311|\t\t\treturn failure\n312|\t\t}\n313|\t\tif strings.HasPrefix(value, \"/\") || strings.HasPrefix(value, `\\\\`) || windowsDrivePattern.MatchString(value) {\n314|\t\t\tfailure, err := failProtocol(\"identity opaque value begins with an absolute path\", \"opaque_identity\")\n315|\t\t\tif err != nil {\n316|\t\t\t\treturn err\n317|\t\t\t}\n318|\t\t\treturn failure\n319|\t\t}\n320|\t}\n321|\treturn nil\n322|}\n323|\n324|func isIdentityKind(value string) bool {\n325|\tfor _, kind := range identityKinds {\n326|\t\tif value == kind {\n327|\t\t\treturn true\n328|\t\t}\n329|\t}\n330|\treturn false\n331|}\n332|\n333|// identifyMembers is the exact required member set of an\n334|// identify-session success body.\n335|var identifyMembers = map[string]bool{\n336|\t\"identity\":         true,\n337|\t\"confidence\":       true,\n338|\t\"matched_evidence\": true,\n339|}\n340|\n341|// identifyRequired lists identifyMembers in a fixed order.\n342|var identifyRequired = []string{\"identity\", \"confidence\", \"matched_evidence\"}\n343|\n344|// identifyConfidences is the closed confidence vocabulary.\n345|var identifyConfidences = []string{\"exact\", \"strong\", \"weak\"}\n346|\n347|// identifyEvidence is the closed matched-evidence vocabulary.\n348|var identifyEvidence = []string{\"native_id\", \"store_path\", \"provider_event\", \"backend_lookup\"}\n349|\n350|// DecodeIdentifyResult validates one identify-session success body:\n351|// the Provider Identity Record for the expected provider, a closed\n352|// confidence, and 1..4 sorted unique matched-evidence members.\n353|func DecodeIdentifyResult(body []byte, wantProviderID string) error {\n354|\tmembers, fault := decodeStrictObject(body)\n355|\tif fault != nil {\n356|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n357|\t\tif err != nil {\n358|\t\t\treturn err\n359|\t\t}\n360|\t\treturn failure\n361|\t}\n362|\tif name, unknown := unknownMember(members, identifyMembers); unknown {\n363|\t\tfailure, err := failProtocol(\"identify result carries unknown member\", name)\n364|\t\tif err != nil {\n365|\t\t\treturn err\n366|\t\t}\n367|\t\treturn failure\n368|\t}\n369|\tif name, missing := missingMember(members, identifyRequired); missing {\n370|\t\tfailure, err := failProtocol(\"identify result misses a required member\", name)\n371|\t\tif err != nil {\n372|\t\t\treturn err\n373|\t\t}\n374|\t\treturn failure\n375|\t}\n376|\tconfidence, ok := rawString(members[\"confidence\"])\n377|\tif !ok || !isIdentifyConfidence(confidence) {\n378|\t\tfailure, err := failProtocol(\"identify confidence is not exact strong or weak\", \"confidence\")\n379|\t\tif err != nil {\n380|\t\t\treturn err\n381|\t\t}\n382|\t\treturn failure\n383|\t}\n384|\tif err := checkIdentifyEvidence(members[\"matched_evidence\"]); err != nil {\n385|\t\treturn err\n386|\t}\n387|\tif !isJSONObject(members[\"identity\"]) {\n388|\t\tfailure, err := failProtocol(\"identify identity is not an object\", \"identity\")\n389|\t\tif err != nil {\n390|\t\t\treturn err\n391|\t\t}\n392|\t\treturn failure\n393|\t}\n394|\tif err := CheckIdentity(members[\"identity\"], wantProviderID); err != nil {\n395|\t\treturn err\n396|\t}\n397|\treturn nil\n398|}\n399|\n400|func isIdentifyConfidence(value string) bool {\n401|\tfor _, confidence := range identifyConfidences {\n402|\t\tif value == confidence {\n403|\t\t\treturn true\n404|\t\t}\n405|\t}\n406|\treturn false\n407|}\n408|\n409|// checkIdentifyEvidence requires 1..4 sorted unique closed-vocabulary\n410|// evidence members: the observation must cite what matched, exactly\n411|// once each.\n412|func checkIdentifyEvidence(raw json.RawMessage) error {\n413|\tevidence, ok := rawStringArray(raw)\n414|\tif !ok || len(evidence) < 1 || len(evidence) > 4 {\n415|\t\tfailure, err := failProtocol(\"identify evidence is not 1..4 members\", \"matched_evidence\")\n416|\t\tif err != nil {\n417|\t\t\treturn err\n418|\t\t}\n419|\t\treturn failure\n420|\t}\n421|\tallowed := map[string]bool{}\n422|\tfor _, member := range identifyEvidence {\n423|\t\tallowed[member] = true\n424|\t}\n425|\tfor _, member := range evidence {\n426|\t\tif !allowed[member] {\n427|\t\t\tfailure, err := failProtocol(\"identify evidence names an unknown member\", \"matched_evidence\")\n428|\t\t\tif err != nil {\n429|\t\t\t\treturn err\n430|\t\t\t}\n431|\t\t\treturn failure\n432|\t\t}\n433|\t}\n434|\tif !sortedUniqueStrings(evidence) {\n435|\t\tfailure, err := failProtocol(\"identify evidence is not sorted unique\", \"matched_evidence\")\n436|\t\tif err != nil {\n437|\t\t\treturn err\n438|\t\t}\n439|\t\treturn failure\n440|\t}\n441|\treturn nil\n442|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c441","stream":{"kind":"session","id":"01a0785b-9847-7fa3-b40c-313061570fc0"},"sequence":123,"recorded_at":1780531400000241,"record_type":"event","durability":"durable","causation_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","run_stream":{"kind":"run","id":"5f283545-6d77-4246-bbdf-5a980fc43a74"},"call_id":"call_01a0785bd90a7311b1cf25d52b458808","text":"Read text file `internal/canonicaljson/core_records.go`.\n1|package canonicaljson\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|\t\"regexp\"\n7|\t\"sort\"\n8|\t\"strings\"\n9|\t\"unicode/utf8\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|)\n14|\n15|const (\n16|\tleaseSchema            = \"urn:ax:schema:lease\"\n17|\tcheckpointSchema       = \"urn:ax:schema:checkpoint\"\n18|\tproviderIdentitySchema = \"urn:ax:schema:provider-identity\"\n19|\tworkspaceGroupSchema   = \"urn:ax:schema:workspace-group\"\n20|\tsessionEventSchema     = \"urn:ax:schema:session-event\"\n21|\tobservationSchema      = \"urn:ax:schema:observation\"\n22|)\n23|\n24|var (\n25|\tproviderIdentityKeyPattern = regexp.MustCompile(`^[a-z][a-z0-9_.-]{0,63}$`)\n26|\tobservationNamePattern     = regexp.MustCompile(`^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,7}$`)\n27|\tlowerSnakePattern          = regexp.MustCompile(`^[a-z][a-z0-9_]*$`)\n28|\n29|\t// terminalBackendIDPattern is the Section 4.B declared grammar, verbatim:\n30|\t// \"terminal_backend_id is 1-128 ASCII bytes matching\n31|\t// [a-z][a-z0-9]*(?:[.-][a-z0-9]+)*\".\n32|\tterminalBackendIDPattern   = regexp.MustCompile(`^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$`)\n33|\twindowsAbsolutePathPattern = regexp.MustCompile(`^[A-Za-z]:[\\\\/]`)\n34|\n35|\t// ErrInvalidObservation reports an Observation Event or stream outside the\n36|\t// pinned Section 18.1 contract. Observation Events are not identity-addressed.\n37|\tErrInvalidObservation = errors.New(\"invalid observation event\")\n38|)\n39|\n40|func validateLeaseRecord(object map[string]any) error {\n41|\tif err := requireExactMembers(\"Lease Record\", object,\n42|\t\t\"schema\", \"schema_version\", \"record_id\", \"subject_id\", \"lease_id\", \"session_id\", \"epoch\",\n43|\t\t\"holder_host_id\", \"predecessor_lease_id\", \"reason\", \"checkpoint_id\", \"issued_by_host_id\",\n44|\t\t\"created_by_host_id\", \"created_at\", \"extensions\"); err != nil {\n45|\t\treturn err\n46|\t}\n47|\tif err := validateIdentityRecordEnvelope(object, leaseSchema, \"1.0.0\", \"record_id\"); err != nil {\n48|\t\treturn err\n49|\t}\n50|\tsubjectID, err := requireUUIDv7(object, \"subject_id\")\n51|\tif err != nil {\n52|\t\treturn err\n53|\t}\n54|\tsessionID, err := requireUUIDv7(object, \"session_id\")\n55|\tif err != nil {\n56|\t\treturn err\n57|\t}\n58|\tif subjectID != sessionID {\n59|\t\treturn invalidIdentity(\"Lease Record subject_id must equal session_id\")\n60|\t}\n61|\tif err := requireUUIDv4(object, \"lease_id\"); err != nil {\n62|\t\treturn err\n63|\t}\n64|\tepoch, err := requirePositiveUint(object, \"epoch\")\n65|\tif err != nil {\n66|\t\treturn err\n67|\t}\n68|\tif _, err := requireUUIDv7(object, \"holder_host_id\"); err != nil {\n69|\t\treturn err\n70|\t}\n71|\tpredecessorPresent, err := requireNullableUUIDv4(object, \"predecessor_lease_id\")\n72|\tif err != nil {\n73|\t\treturn err\n74|\t}\n75|\treason, err := requireEnum(object, \"reason\", \"create\", \"graceful_takeover\", \"force_takeover\", \"recovery\")\n76|\tif err != nil {\n77|\t\treturn err\n78|\t}\n79|\tcheckpointPresent, err := requireNullableDigestPresence(object, \"checkpoint_id\")\n80|\tif err != nil {\n81|\t\treturn err\n82|\t}\n83|\t// Each of the three couplings below quotes the clause that licenses it.\n84|\t// Section 5.3 does not declare an epoch-1 => create direction anywhere, so\n85|\t// an epoch-1 recovery or takeover lease is admitted: where the pinned\n86|\t// specification is silent this validator stays permissive.\n87|\tepochOneCreate := epoch == 1 && reason == \"create\"\n88|\t// predecessor_lease_id: \"Null only at epoch 1\".\n89|\tif epoch != 1 && !predecessorPresent {\n90|\t\treturn invalidIdentity(\"Lease Record predecessor_lease_id must be non-null after epoch 1\")\n91|\t}\n92|\t// \"An epoch-1 create lease MUST have a null predecessor\".\n93|\tif epochOneCreate && predecessorPresent {\n94|\t\treturn invalidIdentity(\"Lease Record epoch-1 create predecessor_lease_id must be null\")\n95|\t}\n96|\t// checkpoint_id: \"Null only for epoch-1 create; otherwise the validated\n97|\t// materialized handoff base\". The complement of epoch-1 create therefore\n98|\t// requires a non-null checkpoint, including at epoch 1 for any other reason.\n99|\tif !epochOneCreate && !checkpointPresent {\n100|\t\treturn invalidIdentity(\"Lease Record checkpoint_id must be non-null unless the lease is an epoch-1 create\")\n101|\t}\n102|\tissuedBy, err := requireUUIDv7(object, \"issued_by_host_id\")\n103|\tif err != nil {\n104|\t\treturn err\n105|\t}\n106|\tcreatedBy, _ := object[\"created_by_host_id\"].(string)\n107|\tif createdBy != issuedBy {\n108|\t\treturn invalidIdentity(\"Lease Record created_by_host_id must equal issued_by_host_id\")\n109|\t}\n110|\treturn nil\n111|}\n112|\n113|func validateCheckpointRecord(object map[string]any) error {\n114|\tif err := requireExactMembers(\"Checkpoint Record\", object,\n115|\t\t\"schema\", \"schema_version\", \"checkpoint_id\", \"subject_id\", \"session_id\", \"lease_epoch\", \"lease_id\",\n116|\t\t\"safe_boundary\", \"event_heads\", \"workspace_manifest_id\", \"provider_manifest_id\", \"task_board_bundle_id\",\n117|\t\t\"created_by_host_id\", \"created_at\", \"status\", \"extensions\"); err != nil {\n118|\t\treturn err\n119|\t}\n120|\tif err := validateIdentityRecordEnvelope(object, checkpointSchema, \"1.0.0\", \"checkpoint_id\"); err != nil {\n121|\t\treturn err\n122|\t}\n123|\tsubjectID, err := requireUUIDv7(object, \"subject_id\")\n124|\tif err != nil {\n125|\t\treturn err\n126|\t}\n127|\tsessionID, err := requireUUIDv7(object, \"session_id\")\n128|\tif err != nil {\n129|\t\treturn err\n130|\t}\n131|\tif subjectID != sessionID {\n132|\t\treturn invalidIdentity(\"Checkpoint Record subject_id must equal session_id\")\n133|\t}\n134|\tif _, err := requirePositiveUint(object, \"lease_epoch\"); err != nil {\n135|\t\treturn err\n136|\t}\n137|\tif err := requireUUIDv4(object, \"lease_id\"); err != nil {\n138|\t\treturn err\n139|\t}\n140|\tboundary, err := requireObject(object, \"safe_boundary\")\n141|\tif err != nil {\n142|\t\treturn err\n143|\t}\n144|\tif err := validateSafeBoundaryEvidence(boundary); err != nil {\n145|\t\treturn err\n146|\t}\n147|\theads, err := requireArrayRange(object, \"event_heads\", 1, 64)\n148|\tif err != nil {\n149|\t\treturn err\n150|\t}\n151|\tif err := validateSortedUniqueDigests(heads, \"event_heads\"); err != nil {\n152|\t\treturn err\n153|\t}\n154|\tif err := requireDigest(object, \"workspace_manifest_id\"); err != nil {\n155|\t\treturn err\n156|\t}\n157|\tproviderPresent, err := requireNullableDigestPresence(object, \"provider_manifest_id\")\n158|\tif err != nil {\n159|\t\treturn err\n160|\t}\n161|\tboardPresent, err := requireNullableDigestPresence(object, \"task_board_bundle_id\")\n162|\tif err != nil {\n163|\t\treturn err\n164|\t}\n165|\tif providerPresent == boardPresent {\n166|\t\treturn invalidIdentity(\"Checkpoint Record requires exactly one of provider_manifest_id and task_board_bundle_id\")\n167|\t}\n168|\treturn requireExactString(object, \"status\", \"validated\")\n169|}\n170|\n171|func validateSafeBoundaryEvidence(object map[string]any) error {\n172|\tif err := requireExactMembers(\"Safe Boundary Evidence\", object,\n173|\t\t\"provider_id\", \"provider_version\", \"evidence\", \"input_blocked\", \"foreground_idle\", \"background_idle\",\n174|\t\t\"open_processes\", \"open_database_handles\"); err != nil {\n175|\t\treturn err\n176|\t}\n177|\tif err := requireProviderID(object, \"provider_id\"); err != nil {\n178|\t\treturn err\n179|\t}\n180|\tif _, err := requireBoundedString(object, \"provider_version\", 1, 128); err != nil {\n181|\t\treturn err\n182|\t}\n183|\tif _, err := requireEnum(object, \"evidence\", \"provider_api\", \"provider_event\", \"managed_pty\", \"task_board_bridge\", \"accepted_test\"); err != nil {\n184|\t\treturn err\n185|\t}\n186|\tfor _, name := range []string{\"input_blocked\", \"foreground_idle\", \"background_idle\"} {\n187|\t\tvalue, err := requireBool(object, name)\n188|\t\tif err != nil {\n189|\t\t\treturn err\n190|\t\t}\n191|\t\tif !value {\n192|\t\t\treturn invalidIdentity(\"Safe Boundary Evidence %s must be true\", name)\n193|\t\t}\n194|\t}\n195|\tfor _, name := range []string{\"open_processes\", \"open_database_handles\"} {\n196|\t\tvalue, err := requireUint(object, name, uint64(maxSafeInteger))\n197|\t\tif err != nil {\n198|\t\t\treturn err\n199|\t\t}\n200|\t\tif value != 0 {\n201|\t\t\treturn invalidIdentity(\"Safe Boundary Evidence %s must be zero\", name)\n202|\t\t}\n203|\t}\n204|\treturn nil\n205|}\n206|\n207|func validateProviderIdentityRecord(object map[string]any) error {\n208|\tif err := requireExactMembers(\"Provider Identity Record\", object,\n209|\t\t\"schema\", \"schema_version\", \"record_id\", \"subject_id\", \"session_id\", \"provider_id\", \"provider_version\",\n210|\t\t\"provider_version_range\", \"native_session_id\", \"identity_kind\", \"logical_workspace_id\",\n211|\t\t\"backend_realm_fingerprint\", \"opaque_identity\", \"created_by_host_id\", \"created_at\", \"extensions\"); err != nil {\n212|\t\treturn err\n213|\t}\n214|\tif err := validateIdentityRecordEnvelope(object, providerIdentitySchema, \"1.0.0\", \"record_id\"); err != nil {\n215|\t\treturn err\n216|\t}\n217|\tsubjectID, err := requireUUIDv7(object, \"subject_id\")\n218|\tif err != nil {\n219|\t\treturn err\n220|\t}\n221|\tsessionID, err := requireUUIDv7(object, \"session_id\")\n222|\tif err != nil {\n223|\t\treturn err\n224|\t}\n225|\tif subjectID != sessionID {\n226|\t\treturn invalidIdentity(\"Provider Identity Record subject_id must equal session_id\")\n227|\t}\n228|\tif err := requireProviderID(object, \"provider_id\"); err != nil {\n229|\t\treturn err\n230|\t}\n231|\t// Spelled out as three ordered calls rather than a map range: a map range\n232|\t// reports a random member when several bounds are violated at once, and it\n233|\t// hides the declared bounds from the derived bounds inventory.\n234|\tif _, err := requireBoundedString(object, \"provider_version\", 1, 128); err != nil {\n235|\t\treturn err\n236|\t}\n237|\tif _, err := requireBoundedString(object, \"provider_version_range\", 1, 256); err != nil {\n238|\t\treturn err\n239|\t}\n240|\tif _, err := requireBoundedString(object, \"native_session_id\", 1, 512); err != nil {\n241|\t\treturn err\n242|\t}\n243|\tkind, err := requireEnum(object, \"identity_kind\", \"session_uuid\", \"session_path_or_id\", \"backend_conversation_uuid\", \"task_board_managed\", \"provider_defined\")\n244|\tif err != nil {\n245|\t\treturn err\n246|\t}\n247|\tif _, err := requireUUIDv7(object, \"logical_workspace_id\"); err != nil {\n248|\t\treturn err\n249|\t}\n250|\trealmPresent, err := requireNullableDigestPresence(object, \"backend_realm_fingerprint\")\n251|\tif err != nil {\n252|\t\treturn err\n253|\t}\n254|\tproviderID, _ := object[\"provider_id\"].(string)\n255|\tif providerID == \"antigravity\" && kind == \"backend_conversation_uuid\" && !realmPresent {\n256|\t\treturn invalidIdentity(\"Provider Identity Record backend_realm_fingerprint must be non-null for Antigravity backend_conversation_uuid\")\n257|\t}\n258|\topaque, err := requireObject(object, \"opaque_identity\")\n259|\tif err != nil {\n260|\t\treturn err\n261|\t}\n262|\tif len(opaque) > 32 {\n263|\t\treturn invalidIdentity(\"Provider Identity Record opaque_identity exceeds maximum length 32\")\n264|\t}\n265|\t// Iterate in sorted key order so a record violating several opaque_identity\n266|\t// bounds always reports the same member rather than a random map key.\n267|\topaqueKeys := make([]string, 0, len(opaque))\n268|\tfor key := range opaque {\n269|\t\topaqueKeys = append(opaqueKeys, key)\n270|\t}\n271|\tsort.Strings(opaqueKeys)\n272|\tfor _, key := range opaqueKeys {\n273|\t\tvalue := opaque[key]\n274|\t\tif !providerIdentityKeyPattern.MatchString(key) {\n275|\t\t\treturn invalidIdentity(\"Provider Identity Record opaque_identity key %q must match [a-z][a-z0-9_.-]{0,63}\", key)\n276|\t\t}\n277|\t\ttext, ok := value.(string)\n278|\t\tif !ok || !utf8.ValidString(text) {\n279|\t\t\treturn invalidIdentity(\"Provider Identity Record opaque_identity[%q] must be a UTF-8 string\", key)\n280|\t\t}\n281|\t\tlength := utf8.RuneCountInString(text)\n282|\t\tif length < 1 || length > 1024 {\n283|\t\t\treturn invalidIdentity(\"Provider Identity Record opaque_identity[%q] must contain 1..1024 Unicode characters\", key)\n284|\t\t}\n285|\t\t// Section 2 declares the map \"MUST NOT contain an absolute path,\n286|\t\t// credential, environment value, PID, socket, terminal ID, or mutable\n287|\t\t// cache selector\". Only the leading-absolute-path form of that sentence\n288|\t\t// is decidable from one candidate: a value such as `cwd=/Users/x`\n289|\t\t// embeds an absolute path and is ADMITTED here. The message says\n290|\t\t// \"begin with\" rather than \"contain\" so the refusal states what it\n291|\t\t// enforces, and constraint-enumeration.md routes the undecidable\n292|\t\t// remainder to the same external column as the credential and PID\n293|\t\t// classes in that sentence.\n294|\t\tif strings.HasPrefix(text, \"/\") || strings.HasPrefix(text, `\\\\`) || windowsAbsolutePathPattern.MatchString(text) {\n295|\t\t\treturn invalidIdentity(\"Provider Identity Record opaque_identity[%q] must not begin with an absolute path\", key)\n296|\t\t}\n297|\t}\n298|\treturn nil\n299|}\n300|\n301|func validateWorkspaceGroupRecord(object map[string]any) error {\n302|\tif err := requireExactMembers(\"Workspace Group Record\", object,\n303|\t\t\"schema\", \"schema_version\", \"record_id\", \"subject_id\", \"workspace_group_id\", \"display_name\", \"members\",\n304|\t\t\"created_by_host_id\", \"created_at\", \"extensions\"); err != nil {\n305|\t\treturn err\n306|\t}\n307|\tif err := validateIdentityRecordEnvelope(object, workspaceGroupSchema, \"1.0.0\", \"record_id\"); err != nil {\n308|\t\treturn err\n309|\t}\n310|\tsubjectID, err := requireUUIDv7(object, \"subject_id\")\n311|\tif err != nil {\n312|\t\treturn err\n313|\t}\n314|\tgroupID, err := requireUUIDv7(object, \"workspace_group_id\")\n315|\tif err != nil {\n316|\t\treturn err\n317|\t}\n318|\tif subjectID != groupID {\n319|\t\treturn invalidIdentity(\"Workspace Group Record subject_id must equal workspace_group_id\")\n320|\t}\n321|\tif _, err := requireBoundedString(object, \"display_name\", 1, 128); err != nil {\n322|\t\treturn err\n323|\t}\n324|\tmembers, err := requireArrayRange(object, \"members\", 1, 256)\n325|\tif err != nil {\n326|\t\treturn err\n327|\t}\n328|\tpreviousID := \"\"\n329|\tpaths := make(map[string]string, len(members))\n330|\tfor index, value := range members {\n331|\t\tmember, err := requireObjectValue(value, fmt.Sprintf(\"Workspace Group Record members[%d]\", index))\n332|\t\tif err != nil {\n333|\t\t\treturn err\n334|\t\t}\n335|\t\tworkspaceID, relativePath, err := validateWorkspaceMember(member)\n336|\t\tif err != nil {\n337|\t\t\treturn err\n338|\t\t}\n339|\t\t// Section 2 declares \"Members are sorted by workspace_id, and no two\n340|\t\t// members may have an equal or case-colliding group_relative_path\". The\n341|\t\t// declared uniqueness is on group_relative_path, enforced below; the\n342|\t\t// workspace_id rule is bare `sorted`, so an equal workspace_id is\n343|\t\t// admitted rather than refused on an undeclared uniqueness.\n344|\t\tif index > 0 && workspaceID < previousID {\n345|\t\t\treturn invalidIdentity(\"Workspace Group Record members must be sorted by workspace_id\")\n346|\t\t}\n347|\t\tpreviousID = workspaceID\n348|\t\tfolded := simpleFoldKey(relativePath)\n349|\t\tif prior, collision := paths[folded]; collision {\n350|\t\t\treturn invalidIdentity(\"Workspace Group Record member paths %q and %q are equal or case-colliding\", prior, relativePath)\n351|\t\t}\n352|\t\tpaths[folded] = relativePath\n353|\t}\n354|\treturn nil\n355|}\n356|\n357|func validateWorkspaceMember(object map[string]any) (string, string, error) {\n358|\tkind, err := requireString(object, \"kind\")\n359|\tif err != nil {\n360|\t\treturn \"\", \"\", err\n361|\t}\n362|\t// Both member lists are spelled out literally rather than appended to a\n363|\t// shared prefix so the per-member constraint inventory can read them.\n364|\tswitch kind {\n365|\tcase \"git\":\n366|\t\tif err := requireExactMembers(\"WorkspaceMember.git\", object,\n367|\t\t\t\"workspace_id\", \"kind\", \"group_relative_path\", \"repo_relative_cwd\", \"agent_project_config_paths\",\n368|\t\t\t\"materialization_policy\", \"repository_identity\", \"sanitized_remote_urls\"); err != nil {\n369|\t\t\treturn \"\", \"\", err\n370|\t\t}\n371|\tcase \"managed_tree\":\n372|\t\tif err := requireExactMembers(\"WorkspaceMember.managed_tree\", object,\n373|\t\t\t\"workspace_id\", \"kind\", \"group_relative_path\", \"repo_relative_cwd\", \"agent_project_config_paths\",\n374|\t\t\t\"materialization_policy\", \"tree_identity\"); err != nil {\n375|\t\t\treturn \"\", \"\", err\n376|\t\t}\n377|\tdefault:\n378|\t\treturn \"\", \"\", invalidIdentity(\"WorkspaceMember kind %q is not git or managed_tree\", kind)\n379|\t}\n380|\tworkspaceID, err := requireUUIDv7(object, \"workspace_id\")\n381|\tif err != nil {\n382|\t\treturn \"\", \"\", err\n383|\t}\n384|\trelativePath, err := requireRelativePathValue(object, \"group_relative_path\")\n385|\tif err != nil {\n386|\t\treturn \"\", \"\", err\n387|\t}\n388|\tif err := requireDotOrRelativePath(object, \"repo_relative_cwd\"); err != nil {\n389|\t\treturn \"\", \"\", err\n390|\t}\n391|\tif err := requireSortedUniquePaths(object, \"agent_project_config_paths\", 256); err != nil {\n392|\t\treturn \"\", \"\", err\n393|\t}\n394|\tif kind == \"git\" {\n395|\t\tif err := requireBoundedLogicalIdentity(object, \"repository_identity\"); err != nil {\n396|\t\t\treturn \"\", \"\", err\n397|\t\t}\n398|\t\turls, err := requireArrayRange(object, \"sanitized_remote_urls\", 1, 16)\n399|\t\tif err != nil {\n400|\t\t\treturn \"\", \"\", err\n401|\t\t}\n402|\t\tif err := validateSortedUniqueSanitizedGitURLs(urls); err != nil {\n403|\t\t\treturn \"\", \"\", err\n404|\t\t}\n405|\t\tif _, err := requireEnum(object, \"materialization_policy\", \"shared_checkout\", \"separate_worktree\"); err != nil {\n406|\t\t\treturn \"\", \"\", err\n407|\t\t}\n408|\t} else {\n409|\t\tif err := requireBoundedLogicalIdentity(object, \"tree_identity\"); err != nil {\n410|\t\t\treturn \"\", \"\", err\n411|\t\t}\n412|\t\tif _, err := requireEnum(object, \"materialization_policy\", \"shared_tree\", \"separate_copy\"); err != nil {\n413|\t\t\treturn \"\", \"\", err\n414|\t\t}\n415|\t}\n416|\treturn workspaceID, relativePath, nil\n417|}\n418|\n419|func validateSortedUniqueSanitizedGitURLs(values []any) error {\n420|\tprevious := \"\"\n421|\tfor index, value := range values {\n422|\t\ttext, ok := value.(string)\n423|\t\tif !ok {\n424|\t\t\treturn invalidIdentity(\"member sanitized_remote_urls[%d] must be a string\", index)\n425|\t\t}\n426|\t\tif _, err := scalar.ParseSanitizedGitURL(text); err != nil {\n427|\t\t\treturn invalidIdentity(\"member sanitized_remote_urls[%d]: %v\", index, err)\n428|\t\t}\n429|\t\tif index > 0 && text <= previous {\n430|\t\t\treturn invalidIdentity(\"member sanitized_remote_urls must be strictly sorted and unique\")\n431|\t\t}\n432|\t\tprevious = text\n433|\t}\n434|\treturn nil\n435|}\n436|\n437|type eventPayloadShape struct {\n438|\tmembers []string\n439|\tcheck   func(map[string]any) error\n440|}\n441|\n442|var sessionEventPayloadShapes = mustBuildSessionEventPayloadShapes()\n443|\n444|func validateSessionEventV1(object map[string]any) error {\n445|\treturn validateSessionEvent(object, \"1.0.0\")\n446|}\n447|func validateSessionEventV2(object map[string]any) error {\n448|\treturn validateSessionEvent(object, \"2.0.0\")\n449|}\n450|func validateSessionEventV3(object map[string]any) error {\n451|\treturn validateSessionEvent(object, \"3.0.0\")\n452|}\n453|func validateSessionEventV4(object map[string]any) error {\n454|\treturn validateSessionEvent(object, \"4.0.0\")\n455|}\n456|\n457|func validateSessionEvent(object map[string]any, version string) error {\n458|\tif err := requireExactMembers(\"Session Event\", object,\n459|\t\t\"schema\", \"schema_version\", \"event_id\", \"subject_id\", \"session_id\", \"event_type\", \"created_by_host_id\",\n460|\t\t\"lease_epoch\", \"lease_id\", \"lease_sequence\", \"predecessors\", \"created_at\", \"payload\", \"extensions\"); err != nil {\n461|\t\treturn err\n462|\t}\n463|\tif err := validateIdentityRecordEnvelope(object, sessionEventSchema, version, \"event_id\"); err != nil {\n464|\t\treturn err\n465|\t}\n466|\tsubjectID, err := requireUUIDv7(object, \"subject_id\")\n467|\tif err != nil {\n468|\t\treturn err\n469|\t}\n470|\tsessionID, err := requireUUIDv7(object, \"session_id\")\n471|\tif err != nil {\n472|\t\treturn err\n473|\t}\n474|\tif subjectID != sessionID {\n475|\t\treturn invalidIdentity(\"Session Event subject_id must equal session_id\")\n476|\t}\n477|\teventType, err := requireString(object, \"event_type\")\n478|\tif err != nil {\n479|\t\treturn err\n480|\t}\n481|\tif _, err := requirePositiveUint(object, \"lease_epoch\"); err != nil {\n482|\t\treturn err\n483|\t}\n484|\tif err := requireUUIDv4(object, \"lease_id\"); err != nil {\n485|\t\treturn err\n486|\t}\n487|\tif _, err := requirePositiveUint(object, \"lease_sequence\"); err != nil {\n488|\t\treturn err\n489|\t}\n490|\tpredecessors, err := requireArrayMinimum(object, \"predecessors\", 1)\n491|\tif err != nil {\n492|\t\treturn err\n493|\t}\n494|\t// Section 5.2 declares predecessors as \"a sorted array of one or more\n495|\t// record/event digests\" - bare `sorted`, not the Section 1.6 compound phrase\n496|\t// `sorted unique`. Duplicates are therefore admitted here.\n497|\tif err := validateSortedDigests(predecessors, \"predecessors\"); err != nil {\n498|\t\treturn err\n499|\t}\n500|\tpayload, err := requireObject(object, \"payload\")\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
