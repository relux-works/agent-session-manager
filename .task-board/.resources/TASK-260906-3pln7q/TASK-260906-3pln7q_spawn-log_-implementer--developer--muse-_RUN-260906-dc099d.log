, \"provider_auth_smoke\", \"runtime_probe\",\n206|\t\t\t},\n207|\t\t},\n208|\t}\n209|\trow := rows[capability]\n210|\treturn map[string]any{\n211|\t\t\"capability\":            capability,\n212|\t\t\"origin\":                origin,\n213|\t\t\"value\":                 value,\n214|\t\t\"generation_variable\":   row[\"generation_variable\"],\n215|\t\t\"dependent_operations\":  row[\"dependent_operations\"],\n216|\t\t\"evidence_requirements\": row[\"evidence_requirements\"],\n217|\t}\n218|}\n219|\n220|// fixtureUniverse is one coherent admission world: a builtin manifest,\n221|// its probe (static echo, same-value override, differing override, false\n222|// override, probed addition), and the evidence set proving the true claims.\n223|type fixtureUniverse struct {\n224|\trawGeneration    string\n225|\tgenerationDigest string\n226|\tfixtureID        string\n227|\tissuerID         string\n228|\tnow              time.Time\n229|\tkey              *rsa.PrivateKey\n230|\tmanifest         map[string]any\n231|\tprobe            map[string]any\n232|\tevidence         map[string]any\n233|\tevidenceByCap    map[string]map[string]any\n234|}\n235|\n236|// testUniverse builds the builtin ax.tmux world. The manifest identity\n237|// tuple matches New(\"2.1.0\", [\"1.0.0\", \"1.1.0\"]) admission exactly, so the\n238|// same fixtures drive the registry-bound AdmitProbe entry point.\n239|func testUniverse(t *testing.T) *fixtureUniverse {\n240|\tt.Helper()\n241|\n242|\tuniverse := &fixtureUniverse{\n243|\t\trawGeneration: \"generation-alpha\",\n244|\t\tfixtureID:     testSeedDigest(0xF1),\n245|\t\tissuerID:      testSeedDigest(0x1D),\n246|\t\tnow:           time.Date(2026, time.January, 20, 0, 0, 0, 0, time.UTC),\n247|\t\tkey:           testKey(t),\n248|\t\tevidenceByCap: make(map[string]map[string]any),\n249|\t}\n250|\tdigest, err := terminalbackend.GenerationDigest(universe.rawGeneration)\n251|\tif err != nil {\n252|\t\tt.Fatalf(\"GenerationDigest() error = %v\", err)\n253|\t}\n254|\tuniverse.generationDigest = digest\n255|\n256|\tuniverse.manifest = map[string]any{\n257|\t\t\"schema\":                 terminalbackend.SchemaManifest,\n258|\t\t\"schema_version\":         \"1.0.0\",\n259|\t\t\"manifest_id\":            \"\",\n260|\t\t\"terminal_backend_id\":    terminalbackend.BuiltinTmux,\n261|\t\t\"implementation_version\": \"2.1.0\",\n262|\t\t\"protocol_versions\":      []any{\"1.0.0\", \"1.1.0\"},\n263|\t\t\"platforms\":              []any{\"linux\", \"macos\", \"wsl2\"},\n264|\t\t\"implementation_kind\":    \"builtin_go\",\n265|\t\t\"executable_digest\":      nil,\n266|\t\t\"static_capability_claims\": []any{\n267|\t\t\tclaimMap(\"durable_disconnect\", \"static\", true),\n268|\t\t\tclaimMap(\"headless_creation\", \"static\", true),\n269|\t\t\tclaimMap(\"local_attach\", \"static\", true),\n270|\t\t},\n271|\t\t\"conformance_fixture_id\": universe.fixtureID,\n272|\t\t\"extensions\":             map[string]any{},\n273|\t}\n274|\tfinalizeDocument(t, universe.manifest, \"manifest_id\")\n275|\n276|\tuniverse.probe = map[string]any{\n277|\t\t\"schema\":                    terminalbackend.SchemaProbe,\n278|\t\t\"schema_version\":            \"1.0.0\",\n279|\t\t\"probe_id\":                  \"\",\n280|\t\t\"terminal_backend_id\":       terminalbackend.BuiltinTmux,\n281|\t\t\"implementation_version\":    \"2.1.0\",\n282|\t\t\"protocol_version\":          \"1.1.0\",\n283|\t\t\"implementation_kind\":       \"builtin_go\",\n284|\t\t\"executable_digest\":         nil,\n285|\t\t\"platform\":                  \"linux\",\n286|\t\t\"os_version\":                \"14.5\",\n287|\t\t\"availability\":              \"available\",\n288|\t\t\"backend_generation_digest\": universe.generationDigest,\n289|\t\t\"capability_claims\": []any{\n290|\t\t\tclaimMap(\"durable_disconnect\", \"static\", true),\n291|\t\t\tclaimMap(\"graceful_stop\", \"probed\", true),\n292|\t\t\tclaimMap(\"headless_creation\", \"probed\", true),\n293|\t\t\tclaimMap(\"local_attach\", \"probed\", false),\n294|\t\t},\n295|\t\t\"evidence_ids\": []any{},\n296|\t\t\"probed_at\":    \"2026-01-15T12:00:00.000Z\",\n297|\t\t\"extensions\":   map[string]any{},\n298|\t}\n299|\n300|\tfor _, capability := range []string{\"durable_disconnect\", \"graceful_stop\", \"headless_creation\"} {\n301|\t\tobject := universe.evidenceMap(capability, []any{\"fixture_passed\", \"runtime_probe_passed\"})\n302|\t\tfinalizeEvidence(t, universe.key, object)\n303|\t\tuniverse.evidenceByCap[capability] = object\n304|\t}\n305|\tids := make([]string, 0, len(universe.evidenceByCap))\n306|\tfor _, object := range universe.evidenceByCap {\n307|\t\tids = append(ids, object[\"evidence_id\"].(string))\n308|\t}\n309|\tsort.Strings(ids)\n310|\tasValues := make([]any, 0, len(ids))\n311|\tfor _, id := range ids {\n312|\t\tasValues = append(asValues, id)\n313|\t}\n314|\tuniverse.probe[\"evidence_ids\"] = asValues\n315|\tfinalizeDocument(t, universe.probe, \"probe_id\")\n316|\n317|\treturn universe\n318|}\n319|\n320|// evidenceMap builds one unsigned evidence document map for capability with\n321|// the given facts. Realm members stay null: realm evidence has its own\n322|// builder in the external-kind universe test.\n323|func (universe *fixtureUniverse) evidenceMap(capability string, facts []any) map[string]any {\n324|\treturn map[string]any{\n325|\t\t\"schema\":                     terminalbackend.SchemaCapabilityEvidence,\n326|\t\t\"schema_version\":             \"1.0.0\",\n327|\t\t\"evidence_id\":                \"\",\n328|\t\t\"terminal_backend_id\":        terminalbackend.BuiltinTmux,\n329|\t\t\"implementation_version\":     \"2.1.0\",\n330|\t\t\"protocol_version\":           \"1.1.0\",\n331|\t\t\"backend_generation_digest\":  universe.generationDigest,\n332|\t\t\"capability\":                 capability,\n333|\t\t\"value\":                      true,\n334|\t\t\"platform\":                   \"linux\",\n335|\t\t\"os_version\":                 \"14.5\",\n336|\t\t\"conformance_fixture_id\":     universe.fixtureID,\n337|\t\t\"observed_at\":                \"2025-06-01T00:00:00.000Z\",\n338|\t\t\"expires_at\":                 \"2027-06-01T00:00:00.000Z\",\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
