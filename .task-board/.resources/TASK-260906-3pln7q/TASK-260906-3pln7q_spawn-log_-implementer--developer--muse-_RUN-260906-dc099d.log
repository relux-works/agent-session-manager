{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cd2b","stream":{"kind":"session","id":"01a0785b-9847-7fa3-b40c-313061570fc0"},"sequence":1264,"recorded_at":1780531400002523,"record_type":"event","durability":"durable","causation_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","run_stream":{"kind":"run","id":"5f283545-6d77-4246-bbdf-5a980fc43a74"},"call_id":"call_01a0786355407d13b7000950ca7e1f8c","text":"Read text file `internal/terminalbackend/refusal_arm_inventory_test.go`.\n(838 line(s) above)\n839|\t\tarm.occurrence == row.occurrence\n840|}\n841|\n842|func describeArm(arm refusalArm) string {\n843|\treturn arm.file + \" \" + arm.function + \" \" + arm.code + \" \" +\n844|\t\tstrconv.Quote(arm.detail) + \" #\" + strconv.Itoa(arm.occurrence)\n845|}\n846|\n847|func describeRow(row declaredRefusalArm) string {\n848|\treturn row.file + \" \" + row.function + \" \" + row.code + \" \" +\n849|\t\tstrconv.Quote(row.detail) + \" #\" + strconv.Itoa(row.occurrence)\n850|}\n851|\n852|// declaredRows returns the table plus the funnel row.\n853|func declaredRows() []declaredRefusalArm {\n854|\trows := append([]declaredRefusalArm(nil), declaredRefusalArms...)\n855|\tfunnel := funneledPlatformArm\n856|\tfunnel.detailSet = funneledPlatformDetails\n857|\treturn append(rows, funnel)\n858|}\n859|\n860|// TestDeclaredRefusalWiresMatchProductionConsts binds the table to the\n861|// production const values two ways: every row's code resolves to the\n862|// wire its test asserts, and every Code symbol except the named armless\n863|// one appears in at least one row, so a code nobody refuses is a red\n864|// rather than a quiet gap.\n865|func TestDeclaredRefusalWiresMatchProductionConsts(t *testing.T) {\n866|\tt.Parallel()\n867|\n868|\tsymbols := productionCodeSymbols(t)\n869|\tcovered := make(map[string]bool)\n870|\tfor _, row := range declaredRows() {\n871|\t\twire, known := symbols[row.code]\n872|\t\tif !known {\n873|\t\t\tt.Errorf(\"declared row %s names unknown code symbol %q\",\n874|\t\t\t\tdescribeRow(row), row.code)\n875|\t\t\tcontinue\n876|\t\t}\n877|\t\tcovered[row.code] = true\n878|\t\t_ = wire\n879|\t}\n880|\tfor symbol := range symbols {\n881|\t\tif armlessCodes[symbol] {\n882|\t\t\tcontinue\n883|\t\t}\n884|\t\tif !covered[symbol] {\n885|\t\t\tt.Errorf(\"code symbol %s has no refusal arm; a wire code nothing refuses is unwitnessed\", symbol)\n886|\t\t}\n887|\t}\n888|}\n889|\n890|// TestDeclaredRefusalTestsResolve requires every row to name real tests\n891|// that textually touch the arm: the detail literal, or the driven entry\n892|// plus the wire code (or its verified predicate). Bound rows name a test\n893|// driving the entry; the bound itself says why no document reaches them.\n894|func TestDeclaredRefusalTestsResolve(t *testing.T) {\n895|\tt.Parallel()\n896|\n897|\tbodies := testBodies(t)\n898|\tpredicates := predicateCodes(t)\n899|\tsymbols := productionCodeSymbols(t)\n900|\tfor _, row := range declaredRows() {\n901|\t\tif len(row.tests) == 0 {\n902|\t\t\tt.Errorf(\"declared row %s names no test, so nothing measures it\", describeRow(row))\n903|\t\t\tcontinue\n904|\t\t}\n905|\t\tresolved := false\n906|\t\tfor _, reference := range row.tests {\n907|\t\t\tbody, declared := bodies[reference.file+\"\\n\"+reference.test]\n908|\t\t\tif !declared {\n909|\t\t\t\tt.Errorf(\"declared row %s names %s in %s, which is not declared\",\n910|\t\t\t\t\tdescribeRow(row), reference.test, reference.file)\n911|\t\t\t\tcontinue\n912|\t\t\t}\n913|\t\t\tif rowResolves(row, body, predicates, symbols) {\n914|\t\t\t\tresolved = true\n915|\t\t\t}\n916|\t\t}\n917|\t\tif !resolved {\n918|\t\t\tt.Errorf(\"declared row %s names no test touching it: want the detail %q or the entry %q \"+\n919|\t\t\t\t\"with its wire code in %v\", describeRow(row), row.detail, row.entry, row.tests)\n920|\t\t}\n921|\t}\n922|}\n923|\n924|// rowResolves reports whether one test body touches one row.\n925|func rowResolves(row declaredRefusalArm, body string, predicates map[string]string, symbols map[string]string) bool {\n926|\tif row.detail == passthroughDetail {\n927|\t\tfor _, detail := range row.detailSet {\n928|\t\t\tif !strings.Contains(body, detail) {\n929|\t\t\t\treturn false\n930|\t\t\t}\n931|\t\t}\n932|\t\treturn strings.Contains(body, row.entry)\n933|\t}\n934|\tif strings.Contains(body, row.detail) {\n935|\t\treturn true\n936|\t}\n937|\tif row.bound != \"\" {\n938|\t\treturn strings.Contains(body, row.entry)\n939|\t}\n940|\tif !strings.Contains(body, row.entry) {\n941|\t\treturn false\n942|\t}\n943|\tif strings.Contains(body, symbols[row.code]) {\n944|\t\treturn true\n945|\t}\n946|\tfor predicate, code := range predicates {\n947|\t\tif code == row.code && strings.Contains(body, predicate) {\n948|\t\t\treturn true\n949|\t\t}\n950|\t}\n951|\treturn false\n952|}\n953|\n954|// TestDefensiveBoundsAreExactlyThese pins the set of bound rows: a new\n955|// defensive arm must join this set deliberately, with its bound stated,\n956|// rather than slipping in as an ordinary row whose test cannot reach it.\n957|func TestDefensiveBoundsAreExactlyThese(t *testing.T) {\n958|\tt.Parallel()\n959|\n960|\twant := map[string]bool{\n961|\t\t\"conformance.go ParseAttachAuthorization CodeMismatch \\\"document timestamp\\\" #1\": true,\n962|\t\t\"conformance.go ParseAttachAuthorization CodeMismatch \\\"document timestamp\\\" #2\": true,\n963|\t\t\"conformance.go CheckAttachRequest CodeMismatch \\\"document timestamp\\\" #1\":       true,\n964|\t\t\"manifest.go checkEvidenceLiveness CodeMismatch \\\"document timestamp\\\" #1\":       true,\n965|\t\t\"manifest.go checkEvidenceLiveness CodeMismatch \\\"document timestamp\\\" #2\":       true,\n966|\t}\n967|\tfor _, row := range declaredRows() {\n968|\t\tif row.bound == \"\" {\n969|\t\t\tcontinue\n970|\t\t}\n971|\t\tif row.bound != boundDefensiveReparse {\n972|\t\t\tt.Errorf(\"declared row %s carries an unrecognized bound %q\",\n973|\t\t\t\tdescribeRow(row), row.bound)\n974|\t\t\tcontinue\n975|\t\t}\n976|\t\tif !want[describeRow(row)] {\n977|\t\t\tt.Errorf(\"declared row %s claims a bound outside the pinned set; \"+\n978|\t\t\t\t\"a new defensive arm joins deliberately or not at all\", describeRow(row))\n979|\t\t}\n980|\t}\n981|\tbound := 0\n982|\tfor _, row := range declaredRows() {\n983|\t\tif row.bound != \"\" {\n984|\t\t\tbound++\n985|\t\t}\n986|\t}\n987|\tif bound != len(want) {\n988|\t\tt.Errorf(\"declared %d bound rows, want exactly the pinned %d\", bound, len(want))\n989|\t}\n990|}\n991|\n992|// TestPlatformFunnelDetailsAreExactlyThese derives the error set of\n993|// validatePlatforms from the production AST and requires it to equal the\n994|// funneled set: a fourth platform error widens the funnel this test pins.\n995|func TestPlatformFunnelDetailsAreExactlyThese(t *testing.T) {\n996|\tt.Parallel()\n997|\n998|\tfileSet := token.NewFileSet()\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
