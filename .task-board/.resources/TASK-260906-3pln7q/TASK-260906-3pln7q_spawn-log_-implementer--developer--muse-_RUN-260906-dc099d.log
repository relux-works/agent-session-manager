{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000e609","stream":{"kind":"session","id":"01a0785b-9847-7fa3-b40c-313061570fc0"},"sequence":4447,"recorded_at":1780531400008889,"record_type":"event","durability":"durable","causation_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","run_stream":{"kind":"run","id":"5f283545-6d77-4246-bbdf-5a980fc43a74"},"task_stream":{"kind":"task","id":"7e264916-5050-4133-b067-e2d25a74cf1b"},"task_id":"7e264916-5050-4133-b067-e2d25a74cf1b","event":{"kind":"output","task_id":"7e264916-5050-4133-b067-e2d25a74cf1b","chunk":"{\n  \"chunk_id\": \"exec-150-1\",\n  \"command\": \"grep -E \\\"capability-claims\\\" -A 40 .github/workflows/ci.yml | sed -n '15,45p'; grep -E \\\"matrix.os|os:\\\" .github/workflows/ci.yml | head -n 8\",\n  \"description\": \"Read claims check command and fixture OS matrix\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"      # with every probe forced unavailable — the strongest posture, and\\n      # host-independent: a backticked capability mention that reads as a\\n      # positive availability claim is refused no matter what this host's\\n      # probes would report. Live probe outcomes are never read here;\\n      # ProbeState.Available is consumed by no call site. README prose is\\n      # never capability evidence either way.\\n      - name: Check README with all probes forced unavailable\\n        run: |\\n          set +e\\n          go test ./internal/cigate -run 'TestRealREADMECarriesNoPositiveClaim|TestRealREADMEAdmitsWhenAllAvailable|TestCapabilityIDsAreDerivedSorted|TestPositiveClaimsAreRefused|TestNegatedClaimsAreAdmitted|TestUnclassifiedMentionIsRefused' -count=1 -v > cigate-claims.log 2>&1\\n          code=$?\\n          set -e\\n          cat cigate-claims.log\\n          test $code -eq 0\\n          for gate in TestRealREADMECarriesNoPositiveClaim TestRealREADMEAdmitsWhenAllAvailable TestCapabilityIDsAreDerivedSorted TestPositiveClaimsAreRefused TestNegatedClaimsAreAdmitted TestUnclassifiedMentionIsRefused; do\\n            grep -q \\\"^--- PASS: ${gate}\\\" cigate-claims.log\\n          done\\n\\n  windows-compile-only:\\n    name: Windows compile-only (no execution implied)\\n    runs-on: ubuntu-latest\\n    timeout-minutes: 10\\n    steps:\\n      - name: Check out repository\\n        uses: actions/checkout@v7\\n\\n      - name: Set up Go\\n--\\n      - capability-claims\\n      - windows-compile-only\\n    if: always()\\n    name: Conformance fixtures (${{ matrix.os }}, ${{ matrix.package }})\\n    runs-on: ${{ matrix.os }}\\n        os: [ubuntu-latest, macos-latest]\\n            echo \\\"## Fixture run ${{ matrix.os }} ${{ matrix.package }}\\\"\\n\",\n  \"original_output_bytes\": 1707,\n  \"original_output_tokens\": 427,\n  \"truncated\": false\n}"}}}
