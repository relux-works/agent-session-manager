{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca17","stream":{"kind":"session","id":"01a0785b-9847-7fa3-b40c-313061570fc0"},"sequence":870,"recorded_at":1780531400001735,"record_type":"event","durability":"durable","causation_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","run_stream":{"kind":"run","id":"5f283545-6d77-4246-bbdf-5a980fc43a74"},"task_stream":{"kind":"task","id":"46812845-a23d-436c-819c-891a313889ad"},"task_id":"46812845-a23d-436c-819c-891a313889ad","event":{"kind":"output","task_id":"46812845-a23d-436c-819c-891a313889ad","chunk":"Read text file `internal/canonicaljson/identity_fixtures_test.go`.\n1|package canonicaljson\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"go/ast\"\n6|\t\"go/token\"\n7|\t\"sort\"\n8|\t\"strconv\"\n9|\t\"strings\"\n10|\t\"testing\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n13|)\n14|\n15|// identityFixture is one valid candidate object for a production shape, named\n16|// by the entry point that owns it.\n17|//\n18|// selfField selects the identity entry pair CalculateObjectIdentity /\n19|// VerifyObjectIdentity. An empty selfField selects ValidateObservationEvent:\n20|// Section 18.1 objects are not identity-addressed and have their own entry.\n21|type identityFixture struct {\n22|\tname      string\n23|\tselfField SelfField\n24|\tobject    map[string]any\n25|}\n26|\n27|// everyValidIdentityFixture returns one accepted candidate per production shape\n28|// this package validates completely.\n29|//\n30|// The set is not trusted on its word:\n31|// TestEveryCompletelyValidatedSchemaVersionHasAValidFixture derives the required\n32|// schema/version set from the production validator registry and requires this\n33|// function to cover it, so registering a new complete validator without a\n34|// fixture reddens the suite instead of silently leaving the new shape outside\n35|// every derived sweep that walks these fixtures.\n36|func everyValidIdentityFixture() []identityFixture {\n37|\tfixtures := []identityFixture{\n38|\t\t{\"session record v1\", SelfRecordID, validSessionRecordV1Object()},\n39|\t\t{\"session record v1 primary owner\", SelfRecordID, primaryOwnerSessionRecord(\"GOAL-260830-primary\")},\n40|\t\t{\"session record v1 task board\", SelfRecordID, taskBoardSessionRecord(\"TASK-260830-8x76g1\")},\n41|\t\t{\"session record v1 fork provenance\", SelfRecordID, sessionRecordWithForkProvenance()},\n42|\t\t{\"session record v1 migration provenance\", SelfRecordID, sessionRecordWithMigrationProvenance()},\n43|\t\t{\"session record v2 origin\", SelfRecordID, validSessionRecordV2Object(validOriginProvenance())},\n44|\t\t{\"session record v2 same-provider fork\", SelfRecordID, validSessionRecordV2Object(validSameProviderForkProvenance())},\n45|\t\t{\"session record v2 cross-environment clone\", SelfRecordID, validSessionRecordV2Object(validCrossEnvironmentCloneProvenance(\"external_native\"))},\n46|\t\t{\"session record v3 native adoption\", SelfRecordID, validSessionRecordV3Object(validNativeAdoptionProvenance())},\n47|\t\t{\"blob descriptor\", SelfDescriptorID, validBlobDescriptorObject()},\n48|\t\t{\"transfer manifest composite\", SelfManifestID, compositeManifestWithChildren(2)},\n49|\t\t{\"transfer manifest provider\", SelfManifestID, providerTransferManifestObject()},\n50|\t\t{\"transfer manifest task board\", SelfManifestID, taskBoardTransferManifestObject()},\n51|\t\t{\"transfer manifest workspace group\", SelfManifestID, validTransferManifestObject(\"workspace_group\")},\n52|\t\t{\"transfer manifest workspace tree\", SelfManifestID, workspaceTreeWithEveryEntryVariant()},\n53|\t\t{\"transfer manifest git workspace\", SelfManifestID, gitWorkspaceWithInitializedSubmodule()},\n54|\t\t{\"lease\", SelfRecordID, validLeaseRecordObject()},\n55|\t\t{\"checkpoint direct\", SelfCheckpointID, validCheckpointRecordObject(true)},\n56|\t\t{\"checkpoint task board\", SelfCheckpointID, validCheckpointRecordObject(false)},\n57|\t\t{\"provider identity\", SelfRecordID, validProviderIdentityRecordObject()},\n58|\t\t{\"workspace group\", SelfRecordID, validWorkspaceGroupRecordObject()},\n59|\t\t{\"observation event\", \"\", validObservationEventObject()},\n60|\t}\n61|\tfor _, event := range catalog.Current().Events {\n62|\t\tif event.Family != \"session_event\" {\n63|\t\t\tcontinue\n64|\t\t}\n65|\t\tfor _, version := range event.ContractVersions {\n66|\t\t\tname := string(event.Name)\n67|\t\t\tfixtures = append(fixtures, identityFixture{\n68|\t\t\t\tname:      fmt.Sprintf(\"session event %s %s\", version, name),\n69|\t\t\t\tselfField: SelfEventID,\n70|\t\t\t\tobject:    validSessionEventObject(version, name),\n71|\t\t\t})\n72|\t\t}\n73|\t}\n74|\treturn fixtures\n75|}\n76|\n77|func providerTransferManifestObject() map[string]any {\n78|\tobject := validTransferManifestObject(\"provider\")\n79|\tobject[\"provider_identity_record_id\"] = digestWithDigit('6')\n80|\treturn object\n81|}\n82|\n83|func taskBoardTransferManifestObject() map[string]any {\n84|\tobject := validTransferManifestObject(\"task_board\")\n85|\tobject[\"task_board_bundle_id\"] = digestWithDigit('7')\n86|\treturn object\n87|}\n88|\n89|// TestEveryValidIdentityFixtureIsAcceptedAtItsProductionEntry is the sanity\n90|// floor for every derived sweep built on these fixtures. A sweep that mutates a\n91|// fixture and asserts refusal proves nothing if the unmutated fixture is\n92|// already refused for an unrelated reason.\n(more lines below)"}}}
