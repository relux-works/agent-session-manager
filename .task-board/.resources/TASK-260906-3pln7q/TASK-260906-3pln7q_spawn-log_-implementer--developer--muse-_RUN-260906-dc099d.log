{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c485","stream":{"kind":"session","id":"01a0785b-9847-7fa3-b40c-313061570fc0"},"sequence":157,"recorded_at":1780531400000309,"record_type":"event","durability":"durable","causation_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","run_stream":{"kind":"run","id":"5f283545-6d77-4246-bbdf-5a980fc43a74"},"call_id":"call_01a0785be2de7ff0b6220e82f443bc1f","text":"Read text file `internal/terminalbackend/manifest.go`.\n(499 line(s) above)\n500|\t}\n501|\tif _, err := scalar.ParseDigest(value); err != nil {\n502|\t\treturn \"\", mismatchf(\"document digest\")\n503|\t}\n504|\treturn value, nil\n505|}\n506|\n507|// digestOrNullMember extracts a digest|null member: present and either a\n508|// valid digest or JSON null. Absence is malformed, not null.\n509|func digestOrNullMember(object map[string]any, name string) (string, error) {\n510|\traw, known := object[name]\n511|\tif !known {\n512|\t\treturn \"\", mismatchf(\"document members\")\n513|\t}\n514|\tif raw == nil {\n515|\t\treturn \"\", nil\n516|\t}\n517|\tvalue, ok := raw.(string)\n518|\tif !ok {\n519|\t\treturn \"\", mismatchf(\"document member type\")\n520|\t}\n521|\tif _, err := scalar.ParseDigest(value); err != nil {\n522|\t\treturn \"\", mismatchf(\"document digest\")\n523|\t}\n524|\treturn value, nil\n525|}\n526|\n527|// semverMember extracts a required semver member.\n528|func semverMember(object map[string]any, name string) (string, error) {\n529|\tvalue, err := stringMember(object, name)\n530|\tif err != nil {\n531|\t\treturn \"\", err\n532|\t}\n533|\tif !semverPattern.MatchString(value) {\n534|\t\treturn \"\", mismatchf(\"document semver\")\n535|\t}\n536|\treturn value, nil\n537|}\n538|\n539|// timestampMember extracts a required timestamp member.\n540|func timestampMember(object map[string]any, name string) (scalar.Timestamp, error) {\n541|\tvalue, err := stringMember(object, name)\n542|\tif err != nil {\n543|\t\treturn scalar.Timestamp{}, err\n544|\t}\n545|\tparsed, err := scalar.ParseTimestamp(value)\n546|\tif err != nil {\n547|\t\treturn scalar.Timestamp{}, mismatchf(\"document timestamp\")\n548|\t}\n549|\treturn parsed, nil\n550|}\n551|\n552|// checkExtensions admits exactly the empty object {}. A non-empty extensions\n553|// object requires a later contract version, and absence is malformed.\n554|func checkExtensions(object map[string]any) error {\n555|\traw, known := object[\"extensions\"]\n556|\tif !known {\n557|\t\treturn mismatchf(\"document members\")\n558|\t}\n559|\textensions, ok := raw.(map[string]any)\n560|\tif !ok || len(extensions) != 0 {\n561|\t\treturn mismatchf(\"document extensions\")\n562|\t}\n563|\treturn nil\n564|}\n565|\n566|// stringArrayMember extracts a required array of strings, refusing numbers,\n567|// booleans, nulls, and nested values element-wise.\n568|func stringArrayMember(object map[string]any, name string) ([]string, error) {\n569|\traw, known := object[name]\n570|\tif !known {\n571|\t\treturn nil, mismatchf(\"document members\")\n572|\t}\n573|\tarray, ok := raw.([]any)\n574|\tif !ok {\n575|\t\treturn nil, mismatchf(\"document member type\")\n576|\t}\n577|\tvalues := make([]string, 0, len(array))\n578|\tfor _, member := range array {\n579|\t\tvalue, ok := member.(string)\n580|\t\tif !ok {\n581|\t\t\treturn nil, mismatchf(\"document member type\")\n582|\t\t}\n583|\t\tvalues = append(values, value)\n584|\t}\n585|\treturn values, nil\n586|}\n587|\n588|// checkSortedUnique refuses an unsorted or duplicated string list. Bytewise\n589|// order matches the wire's sorted-unique rule over lowercase ASCII members.\n590|func checkSortedUnique(values []string) error {\n591|\tfor index := range values {\n592|\t\tif index > 0 && values[index-1] >= values[index] {\n593|\t\t\treturn mismatchf(\"document ordering\")\n594|\t\t}\n595|\t}\n596|\treturn nil\n597|}\n598|\n599|// checkClosedList enforces the sorted-unique closed-vocabulary list shape:\n600|// every member in vocabulary, sorted unique, within the inclusive item\n601|// bound. The bound admits zero so [0..N] lists stay usable; [1..N] lists\n602|// are enforced by requiring at least one member.\n603|func checkClosedList(values []string, vocabulary map[string]bool, max int, requireNonEmpty bool) error {\n604|\tif len(values) > max || (requireNonEmpty && len(values) == 0) {\n605|\t\treturn mismatchf(\"document list bound\")\n606|\t}\n607|\tfor _, value := range values {\n608|\t\tif !vocabulary[value] {\n609|\t\t\treturn mismatchf(\"document vocabulary\")\n610|\t\t}\n611|\t}\n612|\treturn checkSortedUnique(values)\n613|}\n614|\n615|// objectIdentity computes the lowercase sha256: digest of the RFC 8785 JCS\n616|// bytes of object with exactly selfField omitted (§4.B identity rule). It\n617|// mirrors the repository's canonical pipeline (logical value, JSON\n618|// re-encode, JCS transform, SHA-256) without routing through the schema\n619|// validators owned by another task.\n620|func objectIdentity(object map[string]any, selfField string) (string, error) {\n621|\tomitted := make(map[string]any, len(object))\n622|\tfor name, member := range object {\n623|\t\tif name != selfField {\n624|\t\t\tomitted[name] = member\n625|\t\t}\n626|\t}\n627|\tserialized, err := json.Marshal(omitted)\n628|\tif err != nil {\n629|\t\treturn \"\", mismatchf(\"document identity\")\n630|\t}\n631|\tcanonical, err := jcs.Transform(serialized)\n632|\tif err != nil {\n633|\t\treturn \"\", mismatchf(\"document identity\")\n634|\t}\n635|\tsum := sha256.Sum256(canonical)\n636|\treturn \"sha256:\" + hex.EncodeToString(sum[:]), nil\n637|}\n638|\n639|// checkIdentity recomputes the omit-self digest and refuses a mismatch. A\n640|// reader must recompute the ID before use; trusting the claimed member is a\n641|// substitution vector.\n642|func checkIdentity(object map[string]any, selfField, claimed string) error {\n643|\tif _, err := scalar.ParseDigest(claimed); err != nil {\n644|\t\treturn mismatchf(\"document digest\")\n645|\t}\n646|\tcomputed, err := objectIdentity(object, selfField)\n647|\tif err != nil {\n648|\t\treturn err\n649|\t}\n650|\tif computed != claimed {\n651|\t\treturn mismatchf(\"document identity binding\")\n652|\t}\n653|\treturn nil\n654|}\n655|\n656|// Claim is one TerminalBackendCapabilityClaim: a closed object whose\n657|// generation_variable, dependent_operations, and evidence_requirements\n658|// members must exactly equal the capability registry row (§4.D). A false\n659|// claim makes a probed refusal explicit but confers no operation.\n660|type Claim struct {\n661|\t// Capability is one of the 16 closed registry names.\n662|\tCapability string\n663|\t// Origin is static (manifest echo) or probed (live observation).\n664|\tOrigin string\n665|\t// Value is the claimed capability state.\n666|\tValue bool\n667|\t// GenerationVariable repeats the registry row: whether the value may\n668|\t// change across backend generations.\n669|\tGenerationVariable bool\n670|\t// DependentOperations repeats the registry row: sorted unique\n671|\t// operations this capability confers.\n672|\tDependentOperations []string\n673|\t// EvidenceRequirements repeats the registry row: sorted unique\n674|\t// evidence requirements that prove a true claim.\n675|\tEvidenceRequirements []string\n676|}\n677|\n678|// parseClaim validates one claim object. allowProbed selects the Probe shape;\n679|// the Manifest shape admits only static origin.\n680|func parseClaim(raw any, allowProbed bool) (Claim, error) {\n681|\tobject, ok := raw.(map[string]any)\n682|\tif !ok {\n683|\t\treturn Claim{}, mismatchf(\"claim shape\")\n684|\t}\n685|\tif err := checkExactMembers(object, []string{\n686|\t\t\"capability\", \"origin\", \"value\",\n687|\t\t\"generation_variable\", \"dependent_operations\", \"evidence_requirements\",\n688|\t}); err != nil {\n689|\t\treturn Claim{}, err\n690|\t}\n691|\tcapability, err := stringMember(object, \"capability\")\n692|\tif err != nil {\n693|\t\treturn Claim{}, err\n694|\t}\n695|\trow, known := capabilityRegistry[capability]\n696|\tif !known {\n697|\t\treturn Claim{}, mismatchf(\"capability vocabulary\")\n698|\t}\n699|\torigin, err := stringMember(object, \"origin\")\n700|\tif err != nil {\n701|\t\treturn Claim{}, err\n702|\t}\n703|\tif origin != OriginStatic && (origin != OriginProbed || !allowProbed) {\n704|\t\treturn Claim{}, mismatchf(\"claim origin\")\n705|\t}\n706|\tboolean, ok := object[\"value\"].(bool)\n707|\tif !ok {\n708|\t\treturn Claim{}, mismatchf(\"document member type\")\n709|\t}\n710|\tgenerationVariable, ok := object[\"generation_variable\"].(bool)\n711|\tif !ok {\n712|\t\treturn Claim{}, mismatchf(\"document member type\")\n713|\t}\n714|\toperations, err := stringArrayMember(object, \"dependent_operations\")\n715|\tif err != nil {\n716|\t\treturn Claim{}, err\n717|\t}\n718|\tif err := checkClosedList(operations, operationVocabulary, maxOperations, true); err != nil {\n719|\t\treturn Claim{}, err\n720|\t}\n721|\trequirements, err := stringArrayMember(object, \"evidence_requirements\")\n722|\tif err != nil {\n723|\t\treturn Claim{}, err\n724|\t}\n725|\tif err := checkClosedList(requirements, evidenceRequirementVocabulary, maxRequirements, true); err != nil {\n726|\t\treturn Claim{}, err\n727|\t}\n728|\t// The three registry-derived members must equal the row: a Manifest or\n729|\t// Probe cannot redefine what a capability means or what proves it.\n730|\tif generationVariable != row.generationVariable ||\n731|\t\t!equalStrings(operations, row.dependentOperations) ||\n732|\t\t!equalStrings(requirements, row.evidenceRequirements) {\n733|\t\treturn Claim{}, mismatchf(\"capability registry binding\")\n734|\t}\n735|\treturn Claim{\n736|\t\tCapability:           capability,\n737|\t\tOrigin:               origin,\n738|\t\tValue:                boolean,\n739|\t\tGenerationVariable:   generationVariable,\n740|\t\tDependentOperations:  operations,\n741|\t\tEvidenceRequirements: requirements,\n742|\t}, nil\n743|}\n744|\n745|// parseClaimList validates a sorted-by-capability unique claim array within\n746|// the [0..16] bound. Sorting is checked here so reconciliation can treat\n747|// the key order as established; duplicates are invalid before keyed\n748|// reconciliation runs.\n749|func parseClaimList(raw any, allowProbed bool) ([]Claim, error) {\n750|\tarray, ok := raw.([]any)\n751|\tif !ok {\n752|\t\treturn nil, mismatchf(\"document member type\")\n753|\t}\n754|\tif len(array) > maxClaims {\n755|\t\treturn nil, mismatchf(\"claim list bound\")\n756|\t}\n757|\tclaims := make([]Claim, 0, len(array))\n758|\tprevious := \"\"\n759|\tfor _, member := range array {\n760|\t\tclaim, err := parseClaim(member, allowProbed)\n761|\t\tif err != nil {\n762|\t\t\treturn nil, err\n763|\t\t}\n764|\t\tif previous >= claim.Capability {\n765|\t\t\treturn nil, mismatchf(\"claim ordering\")\n766|\t\t}\n767|\t\tprevious = claim.Capability\n768|\t\tclaims = append(claims, claim)\n769|\t}\n770|\treturn claims, nil\n771|}\n772|\n773|// equalClaim reports member-for-member equality of two claims.\n774|func equalClaim(left, right Claim) bool {\n775|\treturn left.Capability == right.Capability &&\n776|\t\tleft.Origin == right.Origin &&\n777|\t\tleft.Value == right.Value &&\n778|\t\tleft.GenerationVariable == right.GenerationVariable &&\n779|\t\tequalStrings(left.DependentOperations, right.DependentOperations) &&\n780|\t\tequalStrings(left.EvidenceRequirements, right.EvidenceRequirements)\n781|}\n782|\n783|// equalStrings reports element-wise equality of two string lists.\n784|func equalStrings(left, right []string) bool {\n785|\tif len(left) != len(right) {\n786|\t\treturn false\n787|\t}\n788|\tfor index := range left {\n789|\t\tif left[index] != right[index] {\n790|\t\t\treturn false\n791|\t\t}\n792|\t}\n793|\treturn true\n794|}\n795|\n796|// Manifest is one validated Terminal Backend Manifest 1.0.0: the closed\n797|// immutable backend description. It is not availability proof, and no\n798|// unsupported capability may be advertised through it.\n799|type Manifest struct {\n800|\t// ManifestID is the recomputed omit-self digest.\n801|\tManifestID string\n802|\t// TerminalBackendID is the canonical backend identity.\n803|\tTerminalBackendID string\n804|\t// ImplementationVersion is the exact admitted semver.\n805|\tImplementationVersion string\n806|\t// ProtocolVersions are the sorted unique semver members in Terminal\n807|\t// Backend Protocol major 1.\n808|\tProtocolVersions []string\n809|\t// Platforms is the sorted unique non-empty platform subset.\n810|\tPlatforms []scalar.Platform\n811|\t// ImplementationKind is the closed implementation_kind.\n812|\tImplementationKind Kind\n813|\t// ExecutableDigest is the sha256: digest for external kinds and empty\n814|\t// (null) for built-in kinds.\n815|\tExecutableDigest string\n816|\t// StaticCapabilityClaims are the sorted-by-capability unique static\n817|\t// claims, each exactly repeating its registry row.\n818|\tStaticCapabilityClaims []Claim\n819|\t// ConformanceFixtureID names the fixture true claims are proven with.\n820|\tConformanceFixtureID string\n821|}\n822|\n823|// Probe is one validated Terminal Backend Probe 1.0.0: the closed immutable\n824|// observation of a backend on one platform, generation, and instant.\n825|type Probe struct {\n826|\t// ProbeID is the recomputed omit-self digest.\n827|\tProbeID string\n828|\t// TerminalBackendID equals the admitted Manifest member.\n829|\tTerminalBackendID string\n830|\t// ImplementationVersion equals the admitted Manifest member.\n831|\tImplementationVersion string\n832|\t// ProtocolVersion is exactly one member of the Manifest list.\n833|\tProtocolVersion string\n834|\t// ImplementationKind equals the Manifest member.\n835|\tImplementationKind Kind\n836|\t// ExecutableDigest exactly equals the Manifest member.\n837|\tExecutableDigest string\n838|\t// Platform is exactly one member of the Manifest platforms.\n839|\tPlatform scalar.Platform\n840|\t// OSVersion is the string[1..256] host release.\n841|\tOSVersion string\n842|\t// Availability is the closed readiness vocabulary.\n843|\tAvailability string\n844|\t// BackendGenerationDigest is the digest of the domain-separated raw\n845|\t// generation. It neither reveals nor reconstructs that generation.\n846|\tBackendGenerationDigest string\n847|\t// CapabilityClaims are the sorted-by-capability unique reconciled\n848|\t// claims.\n849|\tCapabilityClaims []Claim\n850|\t// EvidenceIDs are the sorted unique IDs of the evidence objects used\n851|\t// by true claims.\n852|\tEvidenceIDs []string\n853|\t// ProbedAt is the observation instant.\n854|\tProbedAt scalar.Timestamp\n855|}\n856|\n857|// Evidence is one validated Capability Evidence 1.0.0 object: the signed,\n858|// expiring, generation-bound proof of one true capability claim. Value is\n859|// always true by construction: a false claim has no matching evidence.\n860|type Evidence struct {\n861|\t// EvidenceID is the recomputed omit-self digest.\n862|\tEvidenceID string\n863|\t// TerminalBackendID equals the Manifest and Probe members.\n864|\tTerminalBackendID string\n865|\t// ImplementationVersion equals the Manifest and Probe members.\n866|\tImplementationVersion string\n867|\t// ProtocolVersion equals the Probe member.\n868|\tProtocolVersion string\n869|\t// BackendGenerationDigest equals the Probe member.\n870|\tBackendGenerationDigest string\n871|\t// Capability names the one true claim this object proves.\n872|\tCapability string\n873|\t// Platform equals the Probe member.\n874|\tPlatform scalar.Platform\n875|\t// OSVersion equals the Probe member.\n876|\tOSVersion string\n877|\t// ConformanceFixtureID equals the Manifest member.\n878|\tConformanceFixtureID string\n879|\t// ObservedAt opens the validity interval.\n880|\tObservedAt scalar.Timestamp\n881|\t// ExpiresAt closes the validity interval, strictly after ObservedAt.\n882|\tExpiresAt scalar.Timestamp\n883|\t// Issuer is ax_release or ax_local_probe.\n884|\tIssuer string\n885|\t// IssuerID is the digest of the trusted signing identity. A\n886|\t// caller-supplied issuer ID is not authentication: the signature must\n887|\t// verify through the trusted key registry.\n888|\tIssuerID string\n889|\t// AttestationSignature is the raw signature bytes (scheme stripped).\n890|\tAttestationSignature []byte\n891|\t// Facts are the sorted unique evidence facts covering the claim's\n892|\t// requirements through the requirement-to-fact mapping.\n893|\tFacts []string\n894|\t// TerminalBindingID is the opaque binding digest, required only for\n895|\t// credential_capable_execution_realm and empty otherwise.\n896|\tTerminalBindingID string\n897|\t// ProviderID is the provider-id, required only for\n898|\t// credential_capable_execution_realm and empty otherwise.\n899|\tProviderID string\n900|\t// ProviderBuild is the string[1..256] provider build, required only\n901|\t// for credential_capable_execution_realm and empty otherwise.\n902|\tProviderBuild string\n903|\t// SentinelResult is literal passed, required only for\n904|\t// credential_capable_execution_realm and empty otherwise.\n905|\tSentinelResult string\n906|\t// ProviderAuthSmokeResult is literal passed, required only for\n907|\t// credential_capable_execution_realm and empty otherwise.\n908|\tProviderAuthSmokeResult string\n909|}\n910|\n911|// manifestMembers is the exact closed Manifest member set.\n912|var manifestMembers = []string{\n913|\t\"schema\", \"schema_version\", \"manifest_id\", \"terminal_backend_id\",\n914|\t\"implementation_version\", \"protocol_versions\", \"platforms\",\n915|\t\"implementation_kind\", \"executable_digest\", \"static_capability_claims\",\n916|\t\"conformance_fixture_id\", \"extensions\",\n917|}\n918|\n919|// ParseManifest validates one Terminal Backend Manifest 1.0.0 document and\n920|// returns the typed observation. Any deviation from the closed shape,\n921|// vocabulary, bound, ordering, registry-row, or identity rule is\n922|// CodeMismatch: a malformed read is an error, never absence.\n923|func ParseManifest(raw []byte) (Manifest, error) {\n924|\tobject, err := decodeStrictObject(raw)\n925|\tif err != nil {\n926|\t\treturn Manifest{}, err\n927|\t}\n928|\treturn parseManifestObject(object)\n929|}\n930|\n931|// parseManifestObject validates a decoded Manifest member map. It is split\n932|// from ParseManifest so admission paths that already hold a decoded object\n933|// share the exact gate.\n934|func parseManifestObject(object map[string]any) (Manifest, error) {\n935|\tif err := checkExactMembers(object, manifestMembers); err != nil {\n936|\t\treturn Manifest{}, err\n937|\t}\n938|\tif schema, err := stringMember(object, \"schema\"); err != nil || schema != SchemaManifest {\n939|\t\treturn Manifest{}, mismatchf(\"manifest schema\")\n940|\t}\n941|\tif version, err := stringMember(object, \"schema_version\"); err != nil || version != SchemaVersion100 {\n942|\t\treturn Manifest{}, mismatchf(\"manifest schema version\")\n943|\t}\n944|\tmanifestID, err := stringMember(object, \"manifest_id\")\n945|\tif err != nil {\n946|\t\treturn Manifest{}, err\n947|\t}\n948|\tif err := checkIdentity(object, \"manifest_id\", manifestID); err != nil {\n949|\t\treturn Manifest{}, err\n950|\t}\n951|\tbackendID, err := stringMember(object, \"terminal_backend_id\")\n952|\tif err != nil {\n953|\t\treturn Manifest{}, err\n954|\t}\n955|\tif _, err := ParseID(backendID); err != nil {\n956|\t\treturn Manifest{}, mismatchf(\"manifest backend identity\")\n957|\t}\n958|\timplementationVersion, err := semverMember(object, \"implementation_version\")\n959|\tif err != nil {\n960|\t\treturn Manifest{}, err\n961|\t}\n962|\tprotocols, err := stringArrayMember(object, \"protocol_versions\")\n963|\tif err != nil {\n964|\t\treturn Manifest{}, err\n965|\t}\n966|\tif err := validateProtocolList(protocols); err != nil {\n967|\t\treturn Manifest{}, err\n968|\t}\n969|\tplatforms, err := parsePlatformList(object)\n970|\tif err != nil {\n971|\t\treturn Manifest{}, err\n972|\t}\n973|\tkindName, err := stringMember(object, \"implementation_kind\")\n974|\tif err != nil {\n975|\t\treturn Manifest{}, err\n976|\t}\n977|\tkind, err := parseKind(kindName)\n978|\tif err != nil {\n979|\t\treturn Manifest{}, mismatchf(\"manifest implementation kind\")\n980|\t}\n981|\tdigest, err := digestOrNullMember(object, \"executable_digest\")\n982|\tif err != nil {\n983|\t\treturn Manifest{}, err\n984|\t}\n985|\tif needsDigest(kind) == (digest == \"\") {\n986|\t\treturn Manifest{}, mismatchf(\"manifest executable digest\")\n987|\t}\n988|\tclaimsRaw, known := object[\"static_capability_claims\"]\n989|\tif !known {\n990|\t\treturn Manifest{}, mismatchf(\"document members\")\n991|\t}\n992|\tclaims, err := parseClaimList(claimsRaw, false)\n993|\tif err != nil {\n994|\t\treturn Manifest{}, err\n995|\t}\n996|\tfixtureID, err := digestMember(object, \"conformance_fixture_id\")\n997|\tif err != nil {\n998|\t\treturn Manifest{}, err\n999|\t}\n1000|\tif err := checkExtensions(object); err != nil {\n1001|\t\treturn Manifest{}, err\n1002|\t}\n1003|\treturn Manifest{\n1004|\t\tManifestID:             manifestID,\n1005|\t\tTerminalBackendID:      backendID,\n1006|\t\tImplementationVersion:  implementationVersion,\n1007|\t\tProtocolVersions:       protocols,\n1008|\t\tPlatforms:              platforms,\n1009|\t\tImplementationKind:     kind,\n1010|\t\tExecutableDigest:       digest,\n1011|\t\tStaticCapabilityClaims: claims,\n1012|\t\tConformanceFixtureID:   fixtureID,\n1013|\t}, nil\n1014|}\n1015|\n1016|// validateProtocolList enforces sorted unique semver[1..32], each in\n1017|// Terminal Backend Protocol major 1, without naming a backend.\n1018|func validateProtocolList(versions []string) error {\n1019|\tif len(versions) < 1 || len(versions) > maxProtocolVersions {\n1020|\t\treturn mismatchf(\"protocol versions bound\")\n1021|\t}\n1022|\tfor index, version := range versions {\n1023|\t\tif !semverPattern.MatchString(version) || semverMajor(version) != 1 {\n1024|\t\t\treturn mismatchf(\"protocol versions major 1\")\n1025|\t\t}\n1026|\t\tif index > 0 && versions[index-1] >= version {\n1027|\t\t\treturn mismatchf(\"protocol versions ordering\")\n1028|\t\t}\n1029|\t}\n1030|\treturn nil\n1031|}\n1032|\n1033|// parsePlatformList validates the sorted unique non-empty platform subset.\n1034|func parsePlatformList(object map[string]any) ([]scalar.Platform, error) {\n1035|\tnames, err := stringArrayMember(object, \"platforms\")\n1036|\tif err != nil {\n1037|\t\treturn nil, err\n1038|\t}\n1039|\tif len(names) == 0 || len(names) > 4 {\n1040|\t\treturn nil, mismatchf(\"platforms bound\")\n1041|\t}\n1042|\tplatforms := make([]scalar.Platform, 0, len(names))\n1043|\tfor _, name := range names {\n1044|\t\tplatform, err := scalar.ParsePlatform(name)\n1045|\t\tif err != nil {\n1046|\t\t\treturn nil, mismatchf(\"platforms vocabulary\")\n1047|\t\t}\n1048|\t\tplatforms = append(platforms, platform)\n1049|\t}\n1050|\tfor index := range platforms {\n1051|\t\t// Bytewise >= refuses duplicates and misordering together: equal\n1052|\t\t// neighbours are not strictly ordered.\n1053|\t\tif index > 0 && platforms[index-1].String() >= platforms[index].String() {\n1054|\t\t\treturn nil, mismatchf(\"platforms ordering\")\n1055|\t\t}\n1056|\t}\n1057|\treturn platforms, nil\n1058|}\n1059|\n1060|// probeMembers is the exact closed Probe member set.\n1061|var probeMembers = []string{\n1062|\t\"schema\", \"schema_version\", \"probe_id\", \"terminal_backend_id\",\n1063|\t\"implementation_version\", \"protocol_version\", \"implementation_kind\",\n1064|\t\"executable_digest\", \"platform\", \"os_version\", \"availability\",\n1065|\t\"backend_generation_digest\", \"capability_claims\", \"evidence_ids\",\n1066|\t\"probed_at\", \"extensions\",\n1067|}\n1068|\n1069|// ParseProbe validates one Terminal Backend Probe 1.0.0 document. Shape,\n1070|// vocabulary, bound, ordering, registry-row, and identity failures are all\n1071|// CodeMismatch; cross-document reconciliation against the Manifest happens\n1072|// in Reconcile, not here.\n1073|func ParseProbe(raw []byte) (Probe, error) {\n1074|\tobject, err := decodeStrictObject(raw)\n1075|\tif err != nil {\n1076|\t\treturn Probe{}, err\n1077|\t}\n1078|\tif err := checkExactMembers(object, probeMembers); err != nil {\n1079|\t\treturn Probe{}, err\n1080|\t}\n1081|\tif schema, err := stringMember(object, \"schema\"); err != nil || schema != SchemaProbe {\n1082|\t\treturn Probe{}, mismatchf(\"probe schema\")\n1083|\t}\n1084|\tif version, err := stringMember(object, \"schema_version\"); err != nil || version != SchemaVersion100 {\n1085|\t\treturn Probe{}, mismatchf(\"probe schema version\")\n1086|\t}\n1087|\tprobeID, err := stringMember(object, \"probe_id\")\n1088|\tif err != nil {\n1089|\t\treturn Probe{}, err\n1090|\t}\n1091|\tif err := checkIdentity(object, \"probe_id\", probeID); err != nil {\n1092|\t\treturn Probe{}, err\n1093|\t}\n1094|\tbackendID, err := stringMember(object, \"terminal_backend_id\")\n1095|\tif err != nil {\n1096|\t\treturn Probe{}, err\n1097|\t}\n1098|\tif _, err := ParseID(backendID); err != nil {\n1099|\t\treturn Probe{}, mismatchf(\"probe backend identity\")\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c487","stream":{"kind":"session","id":"01a0785b-9847-7fa3-b40c-313061570fc0"},"sequence":158,"recorded_at":1780531400000311,"record_type":"event","durability":"durable","causation_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","run_stream":{"kind":"run","id":"5f283545-6d77-4246-bbdf-5a980fc43a74"},"call_id":"call_01a0785be3aa7a7190dc9f4c0bb50f9a","text":"Read text file `internal/canonicaljson/canonical.go`.\n1|// Package canonicaljson implements the RFC 8785 JSON Canonicalization Scheme\n2|// and the AX omit-self-field identity boundary for immutable logical objects.\n3|package canonicaljson\n4|\n5|import (\n6|\t\"bytes\"\n7|\t\"encoding/json\"\n8|\t\"errors\"\n9|\t\"fmt\"\n10|\t\"io\"\n11|\t\"strconv\"\n12|\t\"strings\"\n13|\t\"unicode/utf8\"\n14|\n15|\t\"github.com/gowebpki/jcs\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n17|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n18|)\n19|\n20|const maxSafeInteger int64 = 9007199254740991\n21|\n22|// maxNestingDepth bounds how many JSON containers (objects or arrays) may be\n23|// open at once in any document that reaches decodeValue, which is the shared\n24|// strict decode path behind Canonicalize, CalculateObjectIdentity, and\n25|// VerifyObjectIdentity. Without it, one recursion frame per nesting level lets\n26|// an untrusted peer object exhaust the goroutine stack, and Go reports that as\n27|// a fatal runtime error that recover cannot intercept.\n28|//\n29|// Rationale for 256: the deepest normative closed shape is the Transfer\n30|// Manifest submodule tree at its 16-level maximum, which nests roughly 40\n31|// containers including the identity envelope, and open extensions are bounded\n32|// at 4 levels, so 256 leaves more than sixfold headroom over any accepted AX\n33|// object. It is also far below encoding/json's 10,000-level Unmarshal cap and\n34|// the unbounded recursion inside the JCS re-parse, so this typed refusal is\n35|// always the first gate a deep document meets, and the decode stack stays at\n36|// a few hundred small frames regardless of input size.\n37|const maxNestingDepth = 256\n38|\n39|var (\n40|\t// ErrInvalidJSON reports input outside the RFC 8785 I-JSON surface.\n41|\tErrInvalidJSON = errors.New(\"invalid canonical JSON input\")\n42|\t// ErrInvalidIdentity reports input outside the AX omit-self identity contract.\n43|\tErrInvalidIdentity = errors.New(\"invalid canonical object identity\")\n44|)\n45|\n46|// SelfField is one of the pinned AX immutable-object self-identity namespaces.\n47|// Chunk IDs are intentionally absent: Section 10.3 defines chunk_id as a\n48|// digest of raw bytes, not of a JSON object.\n49|type SelfField string\n50|\n51|const (\n52|\tSelfRecordID                   SelfField = \"record_id\"\n53|\tSelfEventID                    SelfField = \"event_id\"\n54|\tSelfCheckpointID               SelfField = \"checkpoint_id\"\n55|\tSelfDescriptorID               SelfField = \"descriptor_id\"\n56|\tSelfManifestID                 SelfField = \"manifest_id\"\n57|\tSelfPlanID                     SelfField = \"plan_id\"\n58|\tSelfTombstoneID                SelfField = \"tombstone_id\"\n59|\tSelfAckID                      SelfField = \"ack_id\"\n60|\tSelfBundleID                   SelfField = \"bundle_id\"\n61|\tSelfMarkerID                   SelfField = \"marker_id\"\n62|\tSelfObservationID              SelfField = \"observation_id\"\n63|\tSelfBatchID                    SelfField = \"batch_id\"\n64|\tSelfLineageLinkID              SelfField = \"lineage_link_id\"\n65|\tSelfAnnotationID               SelfField = \"annotation_id\"\n66|\tSelfProfileID                  SelfField = \"profile_id\"\n67|\tSelfJobRequestID               SelfField = \"job_request_id\"\n68|\tSelfJobReceiptID               SelfField = \"job_receipt_id\"\n69|\tSelfDirectoryReceiptID         SelfField = \"directory_receipt_id\"\n70|\tSelfProbeID                    SelfField = \"probe_id\"\n71|\tSelfBindingID                  SelfField = \"binding_id\"\n72|\tSelfEvidenceID                 SelfField = \"evidence_id\"\n73|\tSelfRawObjectManifestID        SelfField = \"raw_object_manifest_id\"\n74|\tSelfCaptureManifestID          SelfField = \"capture_manifest_id\"\n75|\tSelfCanonicalSessionID         SelfField = \"canonical_session_id\"\n76|\tSelfFidelityReportID           SelfField = \"fidelity_report_id\"\n77|\tSelfProjectionPlanID           SelfField = \"projection_plan_id\"\n78|\tSelfProjectedObjectManifestID  SelfField = \"projected_object_manifest_id\"\n79|\tSelfReadBackEvidenceManifestID SelfField = \"read_back_evidence_manifest_id\"\n80|\tSelfValidationReportID         SelfField = \"validation_report_id\"\n81|\tSelfMigrationCheckpointID      SelfField = \"migration_checkpoint_id\"\n82|\tSelfLineageReceiptID           SelfField = \"lineage_receipt_id\"\n83|\tSelfRegistryDigest             SelfField = \"registry_digest\"\n84|)\n85|\n86|type schemaIdentityKey struct {\n87|\tschema  string\n88|\tversion string\n89|}\n90|\n91|type schemaIdentityContract struct {\n92|\tselfField          SelfField\n93|\tdiscriminatorName  string\n94|\tdiscriminatorValue string\n95|}\n96|\n97|// schemaIdentityContracts is derived from the generated catalog whose source\n98|// is bound to the pinned v0.5.0 document. A schema may legitimately carry a\n99|// differently named ID as a reference, so field-name counting is not an\n100|// identity contract.\n101|var schemaIdentityContracts = mustBuildSchemaIdentityContracts(catalog.Current().SelfIdentities)\n102|\n103|func mustBuildSchemaIdentityContracts(definitions []catalog.SelfIdentityContract) map[schemaIdentityKey]schemaIdentityContract {\n104|\tcontracts, err := buildSchemaIdentityContracts(definitions)\n105|\tif err != nil {\n106|\t\tpanic(fmt.Sprintf(\"generated self-identity catalog is invalid: %v\", err))\n107|\t}\n108|\treturn contracts\n109|}\n110|\n111|func buildSchemaIdentityContracts(definitions []catalog.SelfIdentityContract) (map[schemaIdentityKey]schemaIdentityContract, error) {\n112|\tcontracts := make(map[schemaIdentityKey]schemaIdentityContract)\n113|\tfor _, definition := range definitions {\n114|\t\tcontract := schemaIdentityContract{\n115|\t\t\tselfField:          SelfField(definition.SelfField),\n116|\t\t\tdiscriminatorName:  definition.DiscriminatorName,\n117|\t\t\tdiscriminatorValue: definition.DiscriminatorValue,\n118|\t\t}\n119|\t\tfor _, version := range definition.ContractVersions {\n120|\t\t\tkey := schemaIdentityKey{schema: string(definition.ContractID), version: version}\n121|\t\t\tif _, duplicate := contracts[key]; duplicate {\n122|\t\t\t\treturn nil, fmt.Errorf(\"duplicate self-identity contract for %s@%s\", key.schema, key.version)\n123|\t\t\t}\n124|\t\t\tcontracts[key] = contract\n125|\t\t}\n126|\t}\n127|\tif err := validateSchemaIdentityContracts(contracts, definitions); err != nil {\n128|\t\treturn nil, err\n129|\t}\n130|\treturn contracts, nil\n131|}\n132|\n133|func validateSchemaIdentityContracts(contracts map[schemaIdentityKey]schemaIdentityContract, definitions []catalog.SelfIdentityContract) error {\n134|\texpected := 0\n135|\tfor _, definition := range definitions {\n136|\t\tfor _, version := range definition.ContractVersions {\n137|\t\t\texpected++\n138|\t\t\tkey := schemaIdentityKey{schema: string(definition.ContractID), version: version}\n139|\t\t\tcontract, ok := contracts[key]\n140|\t\t\tif !ok {\n141|\t\t\t\treturn fmt.Errorf(\"missing self-identity contract for %s@%s\", key.schema, key.version)\n142|\t\t\t}\n143|\t\t\tif contract.selfField != SelfField(definition.SelfField) ||\n144|\t\t\t\tcontract.discriminatorName != definition.DiscriminatorName ||\n145|\t\t\t\tcontract.discriminatorValue != definition.DiscriminatorValue {\n146|\t\t\t\treturn fmt.Errorf(\"self-identity contract for %s@%s differs from generated catalog\", key.schema, key.version)\n147|\t\t\t}\n148|\t\t}\n149|\t}\n150|\tif len(contracts) != expected {\n151|\t\treturn fmt.Errorf(\"self-identity contract table has %d rows, generated catalog has %d\", len(contracts), expected)\n152|\t}\n153|\treturn nil\n154|}\n155|\n156|// Canonicalize is the production RFC 8785 entry point. It decodes input through\n157|// the shared strict decoder, so it rejects malformed UTF-8, lone or unpaired\n158|// surrogate escapes, unescaped control characters inside strings, duplicate\n159|// object names, trailing data after the top-level value, and any document that\n160|// holds more than 256 containers open at once. What survives is returned as the\n161|// RFC 8785 canonical UTF-8 byte sequence.\n162|//\n163|// That last bound is a nesting depth, not a count of the containers a document\n164|// opens. Only simultaneously open containers cost decoder stack frames, which\n165|// is the exhaustion this refusal exists to prevent, so a shallow document is\n166|// accepted however many containers it opens in total. Each row below is built\n167|// and driven through this function by\n168|// TestCanonicalizeDocumentedContainerLimitIsADepthNotACount:\n169|//\n170|//\t400 sibling arrays open 401 containers, 2 at once: accepted\n171|//\t256 nested arrays open 256 containers, 256 at once: accepted\n172|//\t257 nested arrays open 257 containers, 257 at once: refused\n173|//\n174|// WHAT THIS FUNCTION DOES NOT REFUSE.\n175|//\n176|// It does not enforce the AX common logical number model, and it must not.\n177|// RFC 8785 Section 3.2.2.3 serializes every number through the ECMAScript\n178|// Number.prototype.toString algorithm applied to the IEEE 754 binary64 value,\n179|// and Appendix B publishes the resulting rounded outputs as normative test\n180|// data. A literal that binary64 cannot hold exactly is therefore rounded to the\n181|// nearest double and canonicalized from there rather than refused:\n182|//\n183|//\t9007199254740993 -> 9007199254740992\n184|//\t18446744073709551615 -> 18446744073709552000\n185|//\t1.0 -> 1\n186|//\n187|// That is the intended behaviour of a JCS transform, not a gap in it. Refusing\n188|// those literals here would contradict Appendix B, whose own published samples\n189|// include 9007199254740992 and 295147905179352830000 as canonical outputs of\n190|// exactly this rounding, and which this package pins in\n191|// TestCanonicalizeMatchesEveryFiniteRFC8785AppendixBNumberSample.\n192|//\n193|// DIVISION OF GUARANTEES.\n194|//\n195|// The pinned specification does not put the safe-integer refusal on the\n196|// canonicalization step. It puts it on the AX decoder, on the JSON number token\n197|// itself, and Section 1.6 says so both as a MUST clause and as two normative\n198|// boundary fixtures. Each fragment below is quoted verbatim from the pinned\n199|// internal/specdoc/SPEC.md at the line named, and a fragment attributed to a\n200|// fixture is quoted from the table row that declares that fixture:\n201|//\n202|//\tSPEC.md:292 \"A decoder MUST reject a numeric literal at or beyond <code>2^53</code> even if its host language can represent it\"\n203|//\tSPEC.md:295 \"Implementations MUST NOT round a value and continue.\"\n204|//\tSPEC.md:301 NUM-UNSAFE-NUMBER \"Reject before identity calculation with <code>incompatible_schema</code>\"\n205|//\tSPEC.md:302 NUM-UNSAFE-ROUND \"Reject from the JSON number token before conversion to a host double; an implementation that first rounds it to 9007199254740992 is nonconforming\"\n206|//\n207|// NUM-UNSAFE-ROUND describes this implementation exactly: validateAXNumbers\n208|// refuses the literal on the json.Number token, before any conversion to a host\n209|// double, and it runs inside prepareObjectIdentity before any canonical bytes\n210|// exist. It is reached from these exported entry points, each of which refuses\n211|// all three literals above with a typed error:\n212|//\n213|//\tCalculateObjectIdentity\n214|//\tVerifyObjectIdentity\n215|//\tValidateObservationEvent\n216|//\tValidateObservationStream\n217|//\n218|// Canonicalize itself carries no such guarantee. It is a byte transform over\n219|// whatever RFC 8785 accepts, and this package exports no standalone AX number\n220|// validator, so a caller that needs the AX number model must reach it through\n221|// one of the entry points named above rather than by canonicalizing first.\n222|func Canonicalize(input []byte) ([]byte, error) {\n223|\tvalue, err := decodeStrict(input)\n224|\tif err != nil {\n225|\t\treturn nil, err\n226|\t}\n227|\t// Re-encode the parsed logical value before the JCS transform. This removes\n228|\t// leading/trailing whitespace around primitive top-level values without\n229|\t// changing json.Number tokens or string data.\n230|\tnormalized, err := json.Marshal(value)\n231|\tif err != nil {\n232|\t\treturn nil, invalidJSON(\"serialize logical JSON value: %v\", err)\n233|\t}\n234|\tcanonical, err := jcs.Transform(normalized)\n235|\tif err != nil {\n236|\t\treturn nil, invalidJSON(\"canonicalize RFC 8785 value: %v\", err)\n237|\t}\n238|\treturn canonical, nil\n239|}\n240|\n241|// CalculateObjectIdentity validates the AX common logical number model,\n242|// resolves the one self field from the object's trusted schema/version\n243|// contract, omits that field, applies RFC 8785 JCS, and returns the SHA-256\n244|// identity. Callers cannot select an arbitrary field to omit, which prevents\n245|// self inclusion and digest cycles.\n246|//\n247|// This is where the AX safe-integer refusal lives, not in Canonicalize: a\n248|// literal at or beyond 2^53, or any floating-point literal, is refused here\n249|// with ErrInvalidIdentity before canonical bytes are produced. See the DIVISION\n250|// OF GUARANTEES note on Canonicalize.\n251|func CalculateObjectIdentity(input []byte) (scalar.Digest, SelfField, error) {\n252|\tobject, selfField, _, err := prepareObjectIdentity(input)\n253|\tif err != nil {\n254|\t\treturn scalar.Digest{}, \"\", err\n255|\t}\n256|\treturn calculatePreparedObjectIdentity(object, selfField)\n257|}\n258|\n259|func prepareObjectIdentity(input []byte) (map[string]any, SelfField, scalar.Digest, error) {\n260|\tif len(input) > 5_242_880 {\n261|\t\treturn nil, \"\", scalar.Digest{}, invalidIdentity(\"encoded identity object is %d bytes, maximum is 5242880\", len(input))\n262|\t}\n263|\tvalue, err := decodeStrict(input)\n264|\tif err != nil {\n265|\t\treturn nil, \"\", scalar.Digest{}, err\n266|\t}\n267|\tif err := validateAXNumbers(value); err != nil {\n268|\t\treturn nil, \"\", scalar.Digest{}, err\n269|\t}\n270|\tobject, ok := value.(map[string]any)\n271|\tif !ok {\n272|\t\treturn nil, \"\", scalar.Digest{}, invalidIdentity(\"identity input must be a JSON object\")\n273|\t}\n274|\n275|\tselfField, claimed, err := resolveSelfField(object)\n276|\tif err != nil {\n277|\t\treturn nil, \"\", scalar.Digest{}, err\n278|\t}\n279|\t// This is the composed production gate: closed contract validation happens\n280|\t// after trusted schema selection and before either calculation or attestation.\n281|\tif err := validateImmutableObjectShape(object); err != nil {\n282|\t\treturn nil, \"\", scalar.Digest{}, err\n283|\t}\n284|\treturn object, selfField, claimed, nil\n285|}\n286|\n287|func calculatePreparedObjectIdentity(object map[string]any, selfField SelfField) (scalar.Digest, SelfField, error) {\n288|\tomitted := make(map[string]any, len(object)-1)\n289|\tfor name, member := range object {\n290|\t\tif name != string(selfField) {\n291|\t\t\tomitted[name] = member\n292|\t\t}\n293|\t}\n294|\tserialized, err := json.Marshal(omitted)\n295|\tif err != nil {\n296|\t\treturn scalar.Digest{}, \"\", invalidIdentity(\"serialize omit-self object: %v\", err)\n297|\t}\n298|\tcanonical, err := jcs.Transform(serialized)\n299|\tif err != nil {\n300|\t\treturn scalar.Digest{}, \"\", invalidIdentity(\"canonicalize omit-self object: %v\", err)\n301|\t}\n302|\treturn scalar.SHA256Digest(canonical), selfField, nil\n303|}\n304|\n305|// VerifyObjectIdentity drives the same production calculation and refuses a\n306|// malformed, self-included, or otherwise mismatched claimed identity. It shares\n307|// prepareObjectIdentity with CalculateObjectIdentity, so it carries the same AX\n308|// safe-integer guarantee that Canonicalize does not.\n309|func VerifyObjectIdentity(input []byte) (scalar.Digest, SelfField, error) {\n310|\tobject, selfField, claimed, err := prepareObjectIdentity(input)\n311|\tif err != nil {\n312|\t\treturn scalar.Digest{}, \"\", err\n313|\t}\n314|\tcalculated, calculatedField, err := calculatePreparedObjectIdentity(object, selfField)\n315|\tif err != nil {\n316|\t\treturn scalar.Digest{}, \"\", err\n317|\t}\n318|\tif calculatedField != selfField || claimed != calculated {\n319|\t\treturn scalar.Digest{}, \"\", invalidIdentity(\n320|\t\t\t\"%s claim %q does not match omit-self digest %q\",\n321|\t\t\tselfField,\n322|\t\t\tclaimed,\n323|\t\t\tcalculated,\n324|\t\t)\n325|\t}\n326|\treturn calculated, selfField, nil\n327|}\n328|\n329|func resolveSelfField(object map[string]any) (SelfField, scalar.Digest, error) {\n330|\tschema, err := requiredStringMember(object, \"schema\")\n331|\tif err != nil {\n332|\t\treturn \"\", scalar.Digest{}, err\n333|\t}\n334|\tversion, err := requiredStringMember(object, \"schema_version\")\n335|\tif err != nil {\n336|\t\treturn \"\", scalar.Digest{}, err\n337|\t}\n338|\tcontract, ok := schemaIdentityContracts[schemaIdentityKey{schema: schema, version: version}]\n339|\tif !ok {\n340|\t\treturn \"\", scalar.Digest{}, invalidIdentity(\n341|\t\t\t\"schema %q version %q has no supported immutable self-identity contract\",\n342|\t\t\tschema,\n343|\t\t\tversion,\n344|\t\t)\n345|\t}\n346|\tif contract.discriminatorName != \"\" {\n347|\t\tdiscriminator, err := requiredStringMember(object, contract.discriminatorName)\n348|\t\tif err != nil {\n349|\t\t\treturn \"\", scalar.Digest{}, err\n350|\t\t}\n351|\t\tif discriminator != contract.discriminatorValue {\n352|\t\t\treturn \"\", scalar.Digest{}, invalidIdentity(\n353|\t\t\t\t\"schema %q version %q variant %s=%q is not an immutable self-identity contract\",\n354|\t\t\t\tschema,\n355|\t\t\t\tversion,\n356|\t\t\t\tcontract.discriminatorName,\n357|\t\t\t\tdiscriminator,\n358|\t\t\t)\n359|\t\t}\n360|\t}\n361|\n362|\tvalue, ok := object[string(contract.selfField)]\n363|\tif !ok {\n364|\t\treturn \"\", scalar.Digest{}, invalidIdentity(\n365|\t\t\t\"schema %q version %q requires self field %s\",\n366|\t\t\tschema,\n367|\t\t\tversion,\n368|\t\t\tcontract.selfField,\n369|\t\t)\n370|\t}\n371|\ttext, ok := value.(string)\n372|\tif !ok {\n373|\t\treturn \"\", scalar.Digest{}, invalidIdentity(\"self field %s must contain a digest string\", contract.selfField)\n374|\t}\n375|\tclaim, err := scalar.ParseDigest(text)\n376|\tif err != nil {\n377|\t\treturn \"\", scalar.Digest{}, invalidIdentity(\"self field %s: %v\", contract.selfField, err)\n378|\t}\n379|\treturn contract.selfField, claim, nil\n380|}\n381|\n382|func requiredStringMember(object map[string]any, name string) (string, error) {\n383|\tvalue, ok := object[name]\n384|\tif !ok {\n385|\t\treturn \"\", invalidIdentity(\"identity input requires string member %s\", name)\n386|\t}\n387|\ttext, ok := value.(string)\n388|\tif !ok || text == \"\" {\n389|\t\treturn \"\", invalidIdentity(\"identity input member %s must be a non-empty string\", name)\n390|\t}\n391|\treturn text, nil\n392|}\n393|\n394|func decodeStrict(input []byte) (any, error) {\n395|\tif len(input) == 0 {\n396|\t\treturn nil, invalidJSON(\"input is empty\")\n397|\t}\n398|\tif !utf8.Valid(input) {\n399|\t\treturn nil, invalidJSON(\"input is not valid UTF-8\")\n400|\t}\n401|\tif err := validateSurrogateEscapes(input); err != nil {\n402|\t\treturn nil, err\n403|\t}\n404|\n405|\tdecoder := json.NewDecoder(bytes.NewReader(input))\n406|\tdecoder.UseNumber()\n407|\tvalue, err := decodeValue(decoder, 0)\n408|\tif err != nil {\n409|\t\treturn nil, err\n410|\t}\n411|\tif token, err := decoder.Token(); !errors.Is(err, io.EOF) {\n412|\t\tif err != nil {\n413|\t\t\treturn nil, invalidJSON(\"read trailing JSON data: %v\", err)\n414|\t\t}\n415|\t\treturn nil, invalidJSON(\"unexpected trailing JSON token %v\", token)\n416|\t}\n417|\treturn value, nil\n418|}\n419|\n420|// decodeValue decodes one logical JSON value. depth counts the containers\n421|// already open around this value, so the top-level value is decoded at depth 0\n422|// and a container at depth maxNestingDepth-1 is the last one allowed to open.\n423|func decodeValue(decoder *json.Decoder, depth int) (any, error) {\n424|\ttoken, err := decoder.Token()\n425|\tif err != nil {\n426|\t\treturn nil, invalidJSON(\"decode JSON token: %v\", err)\n427|\t}\n428|\tdelimiter, ok := token.(json.Delim)\n429|\tif !ok {\n430|\t\treturn token, nil\n431|\t}\n432|\tif depth >= maxNestingDepth {\n433|\t\treturn nil, invalidJSON(\"nesting depth %d exceeds maximum %d\", depth+1, maxNestingDepth)\n434|\t}\n435|\n436|\tswitch delimiter {\n437|\tcase '{':\n438|\t\tobject := make(map[string]any)\n439|\t\tfor decoder.More() {\n440|\t\t\tnameToken, err := decoder.Token()\n441|\t\t\tif err != nil {\n442|\t\t\t\treturn nil, invalidJSON(\"decode object name: %v\", err)\n443|\t\t\t}\n444|\t\t\tname, ok := nameToken.(string)\n445|\t\t\tif !ok {\n446|\t\t\t\treturn nil, invalidJSON(\"object name is not a string\")\n447|\t\t\t}\n448|\t\t\tif _, duplicate := object[name]; duplicate {\n449|\t\t\t\treturn nil, invalidJSON(\"duplicate object member %q\", name)\n450|\t\t\t}\n451|\t\t\tvalue, err := decodeValue(decoder, depth+1)\n452|\t\t\tif err != nil {\n453|\t\t\t\treturn nil, err\n454|\t\t\t}\n455|\t\t\tobject[name] = value\n456|\t\t}\n457|\t\tend, err := decoder.Token()\n458|\t\tif err != nil || end != json.Delim('}') {\n459|\t\t\treturn nil, invalidJSON(\"decode object terminator: %v\", err)\n460|\t\t}\n461|\t\treturn object, nil\n462|\tcase '[':\n463|\t\tarray := make([]any, 0)\n464|\t\tfor decoder.More() {\n465|\t\t\tvalue, err := decodeValue(decoder, depth+1)\n466|\t\t\tif err != nil {\n467|\t\t\t\treturn nil, err\n468|\t\t\t}\n469|\t\t\tarray = append(array, value)\n470|\t\t}\n471|\t\tend, err := decoder.Token()\n472|\t\tif err != nil || end != json.Delim(']') {\n473|\t\t\treturn nil, invalidJSON(\"decode array terminator: %v\", err)\n474|\t\t}\n475|\t\treturn array, nil\n476|\tdefault:\n477|\t\treturn nil, invalidJSON(\"unexpected delimiter %q\", delimiter)\n478|\t}\n479|}\n480|\n481|// validateAXNumbers is the AX decoder half of the split documented under\n482|// DIVISION OF GUARANTEES on Canonicalize. It walks the decoded value and\n483|// refuses every literal the common logical data model forbids, on the\n484|// json.Number token rather than on a host double, so an unsafe integer is\n485|// rejected instead of rounded. Canonicalize deliberately does not call it;\n486|// every exported entry point that promises the AX number model does.\n487|func validateAXNumbers(value any) error {\n488|\tswitch typed := value.(type) {\n489|\tcase json.Number:\n490|\t\tliteral := typed.String()\n491|\t\tif strings.ContainsAny(literal, \".eE\") {\n492|\t\t\treturn invalidIdentity(\"floating-point number %q is forbidden by the AX common model\", literal)\n493|\t\t}\n494|\t\tinteger, err := strconv.ParseInt(literal, 10, 64)\n495|\t\tif err != nil || integer < -maxSafeInteger || integer > maxSafeInteger {\n496|\t\t\treturn invalidIdentity(\"integer %q is outside the AX safe-integer interval\", literal)\n497|\t\t}\n498|\tcase []any:\n499|\t\tfor _, element := range typed {\n500|\t\t\tif err := validateAXNumbers(element); err != nil {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c489","stream":{"kind":"session","id":"01a0785b-9847-7fa3-b40c-313061570fc0"},"sequence":159,"recorded_at":1780531400000313,"record_type":"event","durability":"durable","causation_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","run_stream":{"kind":"run","id":"5f283545-6d77-4246-bbdf-5a980fc43a74"},"call_id":"call_01a0785be41c7aa1b2a155deb9f59598","text":"Read text file `internal/canonicaljson/terminal_backend_id_test.go`.\n1|package canonicaljson\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|)\n7|\n8|// terminalBackendIDEventTypes are the two Session Event 4.0.0 payloads whose\n9|// pinned member table declares terminal_backend_id. Both reach the grammar\n10|// through validateTerminalV4Payload, which validateSessionEvent selects from\n11|// sessionEventPayloadShapes for schema_version 4.0.0.\n12|var terminalBackendIDEventTypes = []string{\"terminal.created\", \"session.resumed\"}\n13|\n14|func sessionEventWithTerminalBackendID(eventType string, value any) map[string]any {\n15|\tobject := validSessionEventObject(\"4.0.0\", eventType)\n16|\tobject[\"payload\"].(map[string]any)[\"terminal_backend_id\"] = value\n17|\treturn object\n18|}\n19|\n20|// TestTerminalBackendIDGrammarRefusedAtBothIdentityEntries attacks the Section\n21|// 4.B terminal-backend-id grammar at the real identity entries. Every case\n22|// widens exactly one part of the declared character class or separator rule, so\n23|// admitting any of them means the production pattern has been widened rather\n24|// than merely deleted.\n25|func TestTerminalBackendIDGrammarRefusedAtBothIdentityEntries(t *testing.T) {\n26|\tgrammar := \"must match the terminal-backend-id grammar\"\n27|\tbound := \"must contain 1..128 ASCII bytes\"\n28|\n29|\tcases := []struct {\n30|\t\tname   string\n31|\t\tvalue  string\n32|\t\treason string\n33|\t}{\n34|\t\t// The declared minimum is subsumed by requireString, which refuses the\n35|\t\t// empty string before requireTerminalBackendID measures the bound; the\n36|\t\t// subsuming refusal is pinned here rather than asserted as the bound.\n37|\t\t{\"empty string\", \"\", \"must be a non-empty UTF-8 string\"},\n38|\t\t// The pinned bound is 128; 129 is the smallest refused length.\n39|\t\t{\"one byte past the declared bound\", strings.Repeat(\"a\", 129), bound},\n40|\t\t{\"far past the declared bound\", strings.Repeat(\"a\", 5000), bound},\n41|\t\t{\"uppercase widens the lowercase class\", \"AX.TMUX\", grammar},\n42|\t\t{\"mixed case widens the lowercase class\", \"Ax.Tmux\", grammar},\n43|\t\t{\"leading digit widens the first character class\", \"1ax\", grammar},\n44|\t\t{\"underscore widens the separator class\", \"ax_tmux\", grammar},\n45|\t\t{\"space widens the label class\", \"ax tmux\", grammar},\n46|\t\t{\"slash widens the label class\", \"../../etc/passwd\", grammar},\n47|\t\t{\"colon widens the label class\", \"urn:ax:schema:blob\", grammar},\n48|\t\t{\"at sign widens the label class\", \"ax@tmux\", grammar},\n49|\t\t{\"non-ASCII widens the label class\", \"ax.tmux界\", grammar},\n50|\t\t{\"leading separator drops the required first label\", \"-leading-dash\", grammar},\n51|\t\t{\"leading dot drops the required first label\", \".ax\", grammar},\n52|\t\t{\"trailing separator makes the trailing label optional\", \"ax.\", grammar},\n53|\t\t{\"trailing dash makes the trailing label optional\", \"ax-\", grammar},\n54|\t\t{\"consecutive separators make the label optional\", \"ax..tmux\", grammar},\n55|\t\t{\"consecutive mixed separators make the label optional\", \"ax.-tmux\", grammar},\n56|\t\t// RE2 anchors $ at end of text, so a trailing newline cannot smuggle a\n57|\t\t// second line past an otherwise matching first line.\n58|\t\t{\"trailing newline\", \"ax.tmux\\n\", grammar},\n59|\t\t{\"embedded newline\", \"ax\\n.tmux\", grammar},\n60|\t\t{\"embedded NUL\", \"ax\\x00tmux\", grammar},\n61|\t}\n62|\n63|\tfor _, eventType := range terminalBackendIDEventTypes {\n64|\t\tfor _, testCase := range cases {\n65|\t\t\tt.Run(eventType+\"/\"+testCase.name, func(t *testing.T) {\n66|\t\t\t\tobject := sessionEventWithTerminalBackendID(eventType, testCase.value)\n67|\t\t\t\tassertIdentityEntriesRefuseWithReason(t, mustJSON(t, object), SelfEventID, testCase.reason)\n68|\t\t\t})\n69|\t\t}\n70|\t}\n71|}\n72|\n73|// TestTerminalBackendIDNonStringRefusedAtBothIdentityEntries keeps the declared\n74|// scalar from being satisfied by a non-string JSON value.\n75|func TestTerminalBackendIDNonStringRefusedAtBothIdentityEntries(t *testing.T) {\n76|\tfor _, eventType := range terminalBackendIDEventTypes {\n77|\t\tfor _, value := range []any{nil, true, []any{\"ax.tmux\"}, map[string]any{\"id\": \"ax.tmux\"}} {\n78|\t\t\tobject := sessionEventWithTerminalBackendID(eventType, value)\n79|\t\t\tassertIdentityEntriesRefuseShape(t, mustJSON(t, object), SelfEventID)\n80|\t\t}\n81|\t}\n82|}\n83|\n84|// TestTerminalBackendIDAcceptsDeclaredGrammarAtBothIdentityEntries proves the\n85|// grammar is not merely refusing everything: the canonical built-ins and the\n86|// other forms the declared pattern admits must still attest.\n87|func TestTerminalBackendIDAcceptsDeclaredGrammarAtBothIdentityEntries(t *testing.T) {\n88|\taccepted := []string{\n89|\t\t\"ax.tmux\",\n90|\t\t\"ax.conpty\",\n91|\t\t\"a\",\n92|\t\t\"tmux\",\n93|\t\t\"ax-tmux\",\n94|\t\t\"ax.tmux2\",\n95|\t\t\"vendor.backend-1\",\n96|\t\t\"a0.b1-c2.d3\",\n97|\t\t// The reserved ax. namespace is a registry rule in Section 4.B, not a\n98|\t\t// payload constraint, so a vendor namespace is equally admissible.\n99|\t\t\"example.terminal-backend\",\n100|\t}\n101|\tfor _, eventType := range terminalBackendIDEventTypes {\n102|\t\tfor _, value := range accepted {\n103|\t\t\tobject := sessionEventWithTerminalBackendID(eventType, value)\n104|\t\t\tassertIdentityEntriesAcceptShape(t, mustJSON(t, object), SelfEventID)\n105|\t\t}\n106|\t}\n107|}\n108|\n109|// TestTerminalBackendIDBoundIsProvenInBothDirections asserts the bound against\n110|// the number the pinned specification declares, not against the production\n111|// constant it derives from. Section 4.B: \"terminal_backend_id is 1-128 ASCII\n112|// bytes\". The declared grammar admits only ASCII, so the byte count and the\n113|// Unicode character count coincide for every admitted value.\n114|func TestTerminalBackendIDBoundIsProvenInBothDirections(t *testing.T) {\n115|\tconst declaredMaximum = 128\n116|\tconst declaredMinimum = 1\n117|\n118|\tatMinimum := strings.Repeat(\"a\", declaredMinimum)\n119|\tatMaximum := \"a\" + strings.Repeat(\"0\", declaredMaximum-1)\n120|\tif len(atMaximum) != declaredMaximum || len(atMinimum) != declaredMinimum {\n121|\t\tt.Fatalf(\"bound fixtures are %d and %d bytes, want %d and %d\", len(atMinimum), len(atMaximum), declaredMinimum, declaredMaximum)\n122|\t}\n123|\tpastMaximum := atMaximum + \"0\"\n124|\tbelowMinimum := \"\"\n125|\n126|\tfor _, eventType := range terminalBackendIDEventTypes {\n127|\t\tassertIdentityEntriesAcceptShape(t, mustJSON(t, sessionEventWithTerminalBackendID(eventType, atMinimum)), SelfEventID)\n128|\t\tassertIdentityEntriesAcceptShape(t, mustJSON(t, sessionEventWithTerminalBackendID(eventType, atMaximum)), SelfEventID)\n129|\t\tassertIdentityEntriesRefuseWithReason(t, mustJSON(t, sessionEventWithTerminalBackendID(eventType, pastMaximum)), SelfEventID, \"1..128 ASCII bytes\")\n130|\t\t// Below the minimum the subsuming non-empty string check refuses first.\n131|\t\tassertIdentityEntriesRefuseWithReason(t, mustJSON(t, sessionEventWithTerminalBackendID(eventType, belowMinimum)), SelfEventID, \"must be a non-empty UTF-8 string\")\n132|\t}\n133|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
