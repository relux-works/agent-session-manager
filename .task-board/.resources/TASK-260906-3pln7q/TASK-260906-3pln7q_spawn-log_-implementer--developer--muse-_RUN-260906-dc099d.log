 true\n324|\t\t\t\t\t}\n325|\t\t\t\t\tindex = secondEnd - 1\n326|\t\t\t\tcase unit >= 0xdc00 && unit <= 0xdfff:\n327|\t\t\t\t\treturn true\n328|\t\t\t\t}\n329|\t\t\t}\n330|\t\t}\n331|\tstringComplete:\n332|\t}\n333|\treturn false\n334|}\n335|\n336|// isWTF8SurrogateAt reports whether raw[index] begins a three-byte WTF-8\n337|// (CESU-8) encoding of a surrogate code point: ED A0..BF 80..BF decodes to\n338|// U+D800..U+DFFF, which utf8.Valid refuses. Only this ED range is\n339|// surrogate-shaped: ED 80..9F heads U+D000..U+D7FF, which is valid UTF-8\n340|// and must not match. A truncated tail cannot be classified here and is\n341|// left for the encoding arm.\n342|func isWTF8SurrogateAt(raw []byte, index int) bool {\n343|\treturn index+2 < len(raw) && raw[index] == 0xed &&\n344|\t\traw[index+1] >= 0xa0 && raw[index+1] <= 0xbf &&\n345|\t\traw[index+2] >= 0x80 && raw[index+2] <= 0xbf\n346|}\n347|\n348|// readUTF16EscapeUnit reads one \\uXXXX escape at raw[start] (which must be\n349|// the backslash). It reports false when the escape is absent or malformed;\n350|// malformed escapes are refused by the decoder's syntax arm, so this gate\n351|// only needs to stay silent on them rather than diagnose them.\n352|func readUTF16EscapeUnit(raw []byte, start int) (uint16, int, bool) {\n353|\tif start < 0 || start+6 > len(raw) || raw[start] != '\\\\' || raw[start+1] != 'u' {\n354|\t\treturn 0, start, false\n(more lines below)"}}}
