{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c545","stream":{"kind":"session","id":"01a0785b-9847-7fa3-b40c-313061570fc0"},"sequence":253,"recorded_at":1780531400000501,"record_type":"event","durability":"durable","causation_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","run_stream":{"kind":"run","id":"5f283545-6d77-4246-bbdf-5a980fc43a74"},"task_stream":{"kind":"task","id":"2e006b37-7657-4aed-9fac-1184f7c2c3bf"},"task_id":"2e006b37-7657-4aed-9fac-1184f7c2c3bf","event":{"kind":"output","task_id":"2e006b37-7657-4aed-9fac-1184f7c2c3bf","chunk":"Read text file `internal/provhost/protocol.go`.\n(249 line(s) above)\n250|\n251|// frameFault classifies a malformed plugin frame without minting error\n252|// values: dynamic facts travel in axerror details, never in Go error text,\n253|// so production code builds no raw errors.\n254|type frameFault struct {\n255|\tdetail string\n256|\tmember string\n257|}\n258|\n259|// decodeStrictObject parses one complete JSON object with duplicate\n260|// member detection. A repeated member has no single value, so it is a\n261|// fault, not a last-wins read. The UTF-8 gate runs first: encoding/json\n262|// would silently replace non-UTF-8 bytes, including raw WTF-8 surrogate\n263|// encodings such as ED A0 80, with U+FFFD instead of failing, so the\n264|// raw bytes are screened before any member is trusted. The\n265|// lone-surrogate gate runs next: encoding/json would likewise replace\n266|// a lone \\ud800-style escape with U+FFFD (Section 1.6: decoders MUST\n267|// reject lone surrogate code points).\n268|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n269|\tif !utf8.Valid(data) {\n270|\t\treturn nil, &frameFault{detail: \"not valid UTF-8\", member: \"\"}\n271|\t}\n272|\tif hasLoneSurrogateEscape(data) {\n273|\t\treturn nil, &frameFault{detail: \"lone surrogate escape\", member: \"\"}\n274|\t}\n275|\tdecoder := json.NewDecoder(bytes.NewReader(data))\n276|\ttoken, err := decoder.Token()\n277|\tif err != nil {\n278|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n279|\t}\n280|\tdelim, ok := token.(json.Delim)\n281|\tif !ok || delim != '{' {\n282|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n283|\t}\n284|\tmembers := map[string]json.RawMessage{}\n285|\tfor decoder.More() {\n286|\t\tkeyToken, err := decoder.Token()\n287|\t\tif err != nil {\n288|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n289|\t\t}\n290|\t\tkey, ok := keyToken.(string)\n291|\t\tif !ok {\n292|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n293|\t\t}\n294|\t\tif _, duplicate := members[key]; duplicate {\n295|\t\t\treturn nil, &frameFault{detail: \"duplicate member\", member: key}\n296|\t\t}\n297|\t\tvar raw json.RawMessage\n298|\t\tif err := decoder.Decode(&raw); err != nil {\n299|\t\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: key}\n300|\t\t}\n301|\t\tmembers[key] = raw\n302|\t}\n303|\tif token, err := decoder.Token(); err != nil {\n304|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n305|\t} else if delim, ok := token.(json.Delim); !ok || delim != '}' {\n306|\t\treturn nil, &frameFault{detail: \"not a JSON object\", member: \"\"}\n307|\t}\n308|\tif _, err := decoder.Token(); err != io.EOF {\n309|\t\treturn nil, &frameFault{detail: \"trailing data after the object\", member: \"\"}\n310|\t}\n311|\treturn members, nil\n312|}\n313|\n314|// responseMembers is the exact Section 7.2 response member set: the four\n315|// framing members plus body on success or error on failure, never both,\n316|// never neither, and nothing else. It is package-level so the closed\n317|// vocabulary census derives it: widening the accepted set here must redden\n318|// TestResponseMembersAreDerivedFromSpec, not pass silently.\n319|var responseMembers = map[string]bool{\n320|\t\"protocol\":         true,\n321|\t\"protocol_version\": true,\n322|\t\"request_id\":       true,\n323|\t\"ok\":               true,\n324|\t\"body\":             true,\n325|\t\"error\":            true,\n326|}\n327|\n328|func checkResponseMembers(members map[string]json.RawMessage, ok bool) *frameFault {\n329|\trequired := []string{\"protocol\", \"protocol_version\", \"request_id\", \"ok\"}\n330|\tfor _, name := range required {\n331|\t\tif _, present := members[name]; !present {\n332|\t\t\treturn &frameFault{detail: \"missing member\", member: name}\n333|\t\t}\n334|\t}\n335|\tif ok {\n336|\t\tif _, present := members[\"body\"]; !present {\n337|\t\t\treturn &frameFault{detail: \"missing member\", member: \"body\"}\n338|\t\t}\n339|\t\tif _, forbidden := members[\"error\"]; forbidden {\n340|\t\t\treturn &frameFault{detail: \"success envelope carries error\", member: \"error\"}\n341|\t\t}\n342|\t} else {\n343|\t\tif _, present := members[\"error\"]; !present {\n344|\t\t\treturn &frameFault{detail: \"missing member\", member: \"error\"}\n345|\t\t}\n346|\t\tif _, forbidden := members[\"body\"]; forbidden {\n347|\t\t\treturn &frameFault{detail: \"failure envelope carries body\", member: \"body\"}\n348|\t\t}\n349|\t}\n350|\tfor name := range members {\n351|\t\tif !responseMembers[name] {\n352|\t\t\treturn &frameFault{detail: \"unknown member\", member: name}\n353|\t\t}\n354|\t}\n355|\treturn nil\n356|}\n357|\n358|// parseMajor extracts the major from a strict numeric X.Y.Z version.\n359|// Anything else is not a recognizable major, so the frame is unusable\n360|// rather than a mismatch.\n361|func parseMajor(version string) (int, bool) {\n362|\tparts := strings.Split(version, \".\")\n363|\tif len(parts) != 3 {\n364|\t\treturn 0, false\n365|\t}\n366|\tmajor := 0\n367|\tfor i := 0; i < len(parts[0]); i++ {\n368|\t\tdigit := parts[0][i]\n369|\t\tif digit < '0' || digit > '9' {\n370|\t\t\treturn 0, false\n371|\t\t}\n372|\t\tmajor = major*10 + int(digit-'0')\n373|\t}\n374|\tif len(parts[0]) == 0 {\n375|\t\treturn 0, false\n376|\t}\n377|\tfor _, rest := range parts[1:] {\n378|\t\tif len(rest) == 0 {\n379|\t\t\treturn 0, false\n380|\t\t}\n381|\t\tfor i := 0; i < len(rest); i++ {\n382|\t\t\tif rest[i] < '0' || rest[i] > '9' {\n383|\t\t\t\treturn 0, false\n384|\t\t\t}\n385|\t\t}\n386|\t}\n387|\treturn major, true\n388|}\n389|\n390|// providerContract is the static Section 7.2 binding every failure\n391|// envelope is decoded under: provider protocol major 2 binds Structured\n392|// Error 1.0.0. The version is never taken from the document.\n393|var providerContract = axerror.ContainingContract{ID: \"urn:ax:protocol:provider\", Major: 2}\n394|\n395|// DecodeResponse validates one stdout line as the single response frame\n396|// for the request carrying wantRequestID. It returns the success body, or\n397|// the bound child failure, or a local failure that trusts nothing from\n398|// the frame. A recognizable foreign major yields incompatible_protocol;\n399|// every other unusable frame yields provider_protocol_error.\n400|func DecodeResponse(frame []byte, wantRequestID scalar.UUIDv7) (Response, error) {\n401|\tif len(frame) > MaxFrameBytes {\n402|\t\tfailure, err := failProtocol(\"frame exceeds 8 MiB\", \"\")\n403|\t\tif err != nil {\n404|\t\t\treturn Response{}, err\n405|\t\t}\n406|\t\treturn Response{}, failure\n407|\t}\n408|\tif !utf8.Valid(frame) {\n409|\t\tfailure, err := failProtocol(\"frame is not UTF-8\", \"\")\n410|\t\tif err != nil {\n411|\t\t\treturn Response{}, err\n412|\t\t}\n413|\t\treturn Response{}, failure\n414|\t}\n415|\tmembers, fault := decodeStrictObject(frame)\n416|\tif fault != nil {\n417|\t\tfailure, err := failProtocol(fault.detail, fault.member)\n418|\t\tif err != nil {\n419|\t\t\treturn Response{}, err\n420|\t\t}\n421|\t\treturn Response{}, failure\n422|\t}\n423|\t// foreignMajor peeks at the envelope identity before any v2\n424|\t// member rule runs. A recognizable foreign major is\n425|\t// incompatible_protocol no matter what members it carries, so\n426|\t// the v2 member vocabulary below must not judge it first: a\n427|\t// 3.0.0 envelope carrying v3 members, or omitting the v2 body,\n428|\t// is a foreign major, not an unknown or missing member. The\n429|\t// peek trusts nothing and refuses nothing: it only arms when\n430|\t// the protocol member is exactly this protocol and the version\n431|\t// member is a string with a recognizable foreign major. A frame\n432|\t// without our protocol identity, or without a readable version,\n433|\t// falls through to the member rules, which keep their verdicts.\n434|\tforeignMajor := \"\"\n435|\tif rawProtocol, present := members[\"protocol\"]; present {\n436|\t\tvar protocol string\n437|\t\tif err := json.Unmarshal(rawProtocol, &protocol); err == nil && protocol == ProtocolID {\n438|\t\t\tif rawVersion, present := members[\"protocol_version\"]; present {\n439|\t\t\t\tvar version string\n440|\t\t\t\tif err := json.Unmarshal(rawVersion, &version); err == nil && version != ProtocolVersion {\n441|\t\t\t\t\tif major, recognized := parseMajor(version); recognized && major != ProtocolMajor {\n442|\t\t\t\t\t\tforeignMajor = version\n443|\t\t\t\t\t}\n444|\t\t\t\t}\n445|\t\t\t}\n446|\t\t}\n447|\t}\n448|\tvar ok bool\n449|\tif foreignMajor == \"\" {\n(more lines below)"}}}
