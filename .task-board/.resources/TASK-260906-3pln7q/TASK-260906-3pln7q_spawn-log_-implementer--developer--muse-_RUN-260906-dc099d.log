turn nil, invalidIdentity(\"identity input requires member %s\", name)\n1147|\t}\n1148|\tvalues, ok := value.([]any)\n1149|\tif !ok {\n1150|\t\treturn nil, invalidIdentity(\"member %s must be an array\", name)\n1151|\t}\n1152|\tif len(values) < minimum {\n1153|\t\treturn nil, invalidIdentity(\"member %s requires at least %d entries\", name, minimum)\n1154|\t}\n1155|\treturn values, nil\n1156|}\n1157|\n1158|func requirePositiveUint(object map[string]any, name string) (uint64, error) {\n1159|\tvalue, err := requireUint(object, name, uint64(maxSafeInteger))\n1160|\tif err != nil {\n1161|\t\treturn 0, err\n1162|\t}\n1163|\tif value == 0 {\n1164|\t\treturn 0, invalidIdentity(\"member %s must be greater than zero\", name)\n1165|\t}\n1166|\treturn value, nil\n1167|}\n1168|\n1169|func nullablePositiveUint(object map[string]any, name string) (bool, error) {\n1170|\tvalue, ok := object[name]\n1171|\tif !ok {\n1172|\t\treturn false, invalidIdentity(\"identity input requires member %s\", name)\n1173|\t}\n1174|\tif value == nil {\n1175|\t\treturn false, nil\n1176|\t}\n1177|\t_, err := requirePositiveUint(object, name)\n1178|\treturn err == nil, err\n1179|}\n1180|\n1181|func nullableUintPresence(object map[string]any, name string) (uint64, bool, error) {\n1182|\tvalue, ok := object[name]\n1183|\tif !ok {\n1184|\t\treturn 0, false, invalidIdentity(\"identity input requires member %s\", name)\n1185|\t}\n1186|\tif value == nil {\n1187|\t\treturn 0, false, nil\n1188|\t}\n1189|\tparsed, err := requireUint(object, name, uint64(maxSafeInteger))\n1190|\treturn parsed, err == nil, err\n1191|}\n1192|\n1193|func requireUUIDv4(object map[string]any, name string) error {\n1194|\tvalue, err := requireString(object, name)\n1195|\tif err != nil {\n1196|\t\treturn err\n1197|\t}\n1198|\tif _, err := scalar.ParseUUIDv4(value); err != nil {\n1199|\t\treturn invalidIdentity(\"member %s: %v\", name, err)\n1200|\t}\n1201|\treturn nil\n1202|}\n1203|\n1204|func requireNullableUUIDv4(object map[string]any, name string) (bool, error) {\n1205|\tvalue, ok := object[name]\n1206|\tif !ok {\n1207|\t\treturn false, invalidIdentity(\"identity input requires member %s\", name)\n1208|\t}\n1209|\tif value == nil {\n1210|\t\treturn false, nil\n1211|\t}\n1212|\treturn true, requireUUIDv4(object, name)\n1213|}\n1214|\n1215|func requireProviderID(object map[string]any, name string) error {\n1216|\tvalue, err := requireString(object, name)\n1217|\tif err != nil {\n1218|\t\treturn err\n1219|\t}\n1220|\tif _, err := scalar.ParseProviderID(value); err != nil {\n1221|\t\treturn invalidIdentity(\"member %s: %v\", name, err)\n1222|\t}\n1223|\treturn nil\n1224|}\n1225|\n1226|// requireTerminalBackendID enforces the Section 4.B terminal-backend-id scalar\n1227|// type. The declared bound is \"1-128 ASCII bytes\"; the declared grammar admits\n1228|// only ASCII, so the byte count and the Unicode character count coincide for\n1229|// every admitted value and the bound is measured in bytes as declared.\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c817","stream":{"kind":"session","id":"01a0785b-9847-7fa3-b40c-313061570fc0"},"sequence":614,"recorded_at":1780531400001223,"record_type":"event","durability":"durable","causation_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","run_stream":{"kind":"run","id":"5f283545-6d77-4246-bbdf-5a980fc43a74"},"call_id":"call_01a0785e812d7ca199d597b7092045af","text":"{\n  \"chunk_id\": \"exec-20-1\",\n  \"command\": \"sed -n '160,200p' internal/provhost/manifest.go; echo ===; sed -n '115,135p' internal/provhost/spawn.go; echo ===; sed -n '240,250p' internal/provhost/protocol.go; echo ===; sed -n '120,160p' internal/provhost/protocol_test.go\",\n  \"description\": \"Read provhost helper definitions\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"\\t}\\n\\tif err := checkManifestCapabilities(members[\\\"capability_names\\\"]); err != nil {\\n\\t\\treturn err\\n\\t}\\n\\treturn nil\\n}\\n\\n// validProviderID reports whether the value satisfies the Section 7.1\\n// provider-id grammar without importing the trust package: the manifest\\n// layer reads the grammar, never the filesystem.\\nfunc validProviderID(value string) bool {\\n\\treturn providerIDPattern.MatchString(value)\\n}\\n\\n// checkManifestPlatforms enforces the sorted, unique, non-empty subset\\n// rule over the four platform enums. Each shape carries its own\\n// refusal so narrowing any one check reddens its own fixture.\\nfunc checkManifestPlatforms(raw json.RawMessage) error {\\n\\tplatforms, ok := rawStringArray(raw)\\n\\tif !ok || len(platforms) == 0 {\\n\\t\\tfailure, err := failProtocol(\\\"manifest platforms is empty or not an array\\\", \\\"platforms\\\")\\n\\t\\tif err != nil {\\n\\t\\t\\treturn err\\n\\t\\t}\\n\\t\\treturn failure\\n\\t}\\n\\tallowed := map[string]bool{}\\n\\tfor _, platform := range manifestPlatforms {\\n\\t\\tallowed[platform] = true\\n\\t}\\n\\tfor _, platform := range platforms {\\n\\t\\tif !allowed[platform] {\\n\\t\\t\\tfailure, err := failProtocol(\\\"manifest platforms names an unknown platform\\\", \\\"platforms\\\")\\n\\t\\t\\tif err != nil {\\n\\t\\t\\t\\treturn err\\n\\t\\t\\t}\\n\\t\\t\\treturn failure\\n\\t\\t}\\n\\t}\\n\\tif !sortedUniqueStrings(platforms) {\\n\\t\\tfailure, err := failProtocol(\\\"manifest platforms are not sorted unique\\\", \\\"platforms\\\")\\n===\\n// destination platform. Destination-native is the Section 7.5 rule;\\n// the platform arrives from the caller because the plan carries none.\\nfunc isAbsoluteOn(path string, platform scalar.Platform) bool {\\n\\t_, err := scalar.ParseAbsolutePath(platform, path)\\n\\treturn err == nil\\n}\\n\\n// isBoundedString reports whether the raw JSON string counts 1..max\\n// Unicode characters. The caller already established it is a string.\\nfunc isBoundedString(raw json.RawMessage, min, max int) bool {\\n\\tvalue, ok := rawString(raw)\\n\\tif !ok {\\n\\t\\treturn false\\n\\t}\\n\\tlength := runeLength(value)\\n\\treturn length >= min && length <= max\\n}\\n\\n// checkSpawnArgv enforces the Section 5.1 argv limits: 1..128\\n// elements, each a NUL-free string of 1..4,096 bytes, 65,536 bytes\\n// total. Byte length is the exec-bound quantity, so elements count\\n===\\n// isJSONObject reports whether data is well-formed JSON whose top-level\\n// value is an object. Bodies cross the transport opaquely, so this is the\\n// only body check here: member vocabularies belong to the operation layer.\\nfunc isJSONObject(data []byte) bool {\\n\\ttrimmed := bytes.TrimSpace(data)\\n\\tif len(trimmed) == 0 || trimmed[0] != '{' {\\n\\t\\treturn false\\n\\t}\\n\\treturn json.Valid(trimmed)\\n}\\n\\n===\\n\\t}\\n\\treturn text\\n}\\n\\n// requireFrameRefusal asserts the full arm identity of a plugin-frame\\n// refusal: the stable code, the refused member, the detail naming the\\n// rule, and the non-retryable bit doc.go promises for every local\\n// failure this package emits.\\nfunc requireFrameRefusal(t *testing.T, err error, member, detail string) {\\n\\tt.Helper()\\n\\tif failureCode(t, err) != \\\"provider_protocol_error\\\" {\\n\\t\\tt.Fatalf(\\\"DecodeResponse code = %v, want provider_protocol_error\\\", err)\\n\\t}\\n\\tif got := failureMember(t, err); got != member {\\n\\t\\tt.Fatalf(\\\"DecodeResponse member = %q, want %q (detail: %v)\\\", got, member, err)\\n\\t}\\n\\tif !strings.Contains(err.Error(), detail) {\\n\\t\\tt.Fatalf(\\\"DecodeResponse error = %v, want detail containing %q\\\", err, detail)\\n\\t}\\n\\tif failureObject(t, err).Retryable() {\\n\\t\\tt.Fatalf(\\\"DecodeResponse error = %v, want non-retryable\\\", err)\\n\\t}\\n}\\n\\n// requireLocalRefusal asserts the arm identity of a refusal that carries\\n// no member detail (invalid_config framing refusals and integrity_failure\\n// status refusals): the stable code, the detail naming the rule in the\\n// human text, and the non-retryable bit.\\nfunc requireLocalRefusal(t *testing.T, err error, code axerror.Code, detail string) {\\n\\tt.Helper()\\n\\tif failureCode(t, err) != code {\\n\\t\\tt.Fatalf(\\\"code = %v, want %s\\\", err, code)\\n\\t}\\n\\tif !strings.Contains(err.Error(), detail) {\\n\\t\\tt.Fatalf(\\\"error = %v, want detail containing %q\\\", err, detail)\\n\\t}\\n\\tif failureObject(t, err).Retryable() {\\n\\t\\tt.Fatalf(\\\"error = %v, want non-retryable\\\", err)\\n\\t}\\n}\\n\\n\",\n  \"original_output_bytes\": 4037,\n  \"original_output_tokens\": 1010,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
