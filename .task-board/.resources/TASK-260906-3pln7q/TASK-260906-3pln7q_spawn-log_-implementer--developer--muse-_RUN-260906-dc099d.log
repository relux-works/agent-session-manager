\n1143|func requireArrayMinimum(object map[string]any, name string, minimum int) ([]any, error) {\n1144|\tvalue, ok := object[name]\n1145|\tif !ok {\n1146|\t\treturn nil, invalidIdentity(\"identity input requires member %s\", name)\n1147|\t}\n1148|\tvalues, ok := value.([]any)\n1149|\tif !ok {\n1150|\t\treturn nil, invalidIdentity(\"member %s must be an array\", name)\n1151|\t}\n1152|\tif len(values) < minimum {\n1153|\t\treturn nil, invalidIdentity(\"member %s requires at least %d entries\", name, minimum)\n1154|\t}\n1155|\treturn values, nil\n1156|}\n1157|\n1158|func requirePositiveUint(object map[string]any, name string) (uint64, error) {\n1159|\tvalue, err := requireUint(object, name, uint64(maxSafeInteger))\n1160|\tif err != nil {\n1161|\t\treturn 0, err\n1162|\t}\n1163|\tif value == 0 {\n1164|\t\treturn 0, invalidIdentity(\"member %s must be greater than zero\", name)\n1165|\t}\n1166|\treturn value, nil\n1167|}\n1168|\n1169|func nullablePositiveUint(object map[string]any, name string) (bool, error) {\n1170|\tvalue, ok := object[name]\n1171|\tif !ok {\n1172|\t\treturn false, invalidIdentity(\"identity input requires member %s\", name)\n1173|\t}\n1174|\tif value == nil {\n1175|\t\treturn false, nil\n1176|\t}\n1177|\t_, err := requirePositiveUint(object, name)\n1178|\treturn err == nil, err\n1179|}\n1180|\n1181|func nullableUintPresence(object map[string]any, name string) (uint64, bool, error) {\n1182|\tvalue, ok := object[name]\n1183|\tif !ok {\n1184|\t\treturn 0, false, invalidIdentity(\"identity input requires member %s\", name)\n1185|\t}\n1186|\tif value == nil {\n1187|\t\treturn 0, false, nil\n1188|\t}\n1189|\tparsed, err := requireUint(object, name, uint64(maxSafeInteger))\n1190|\treturn parsed, err == nil, err\n1191|}\n1192|\n1193|func requireUUIDv4(object map[string]any, name string) error {\n1194|\tvalue, err := requireString(object, name)\n1195|\tif err != nil {\n1196|\t\treturn err\n1197|\t}\n1198|\tif _, err := scalar.ParseUUIDv4(value); err != nil {\n1199|\t\treturn invalidIdentity(\"member %s: %v\", name, err)\n1200|\t}\n1201|\treturn nil\n1202|}\n1203|\n1204|func requireNullableUUIDv4(object map[string]any, name string) (bool, error) {\n1205|\tvalue, ok := object[name]\n1206|\tif !ok {\n1207|\t\treturn false, invalidIdentity(\"identity input requires member %s\", name)\n1208|\t}\n1209|\tif value == nil {\n1210|\t\treturn false, nil\n1211|\t}\n1212|\treturn true, requireUUIDv4(object, name)\n1213|}\n1214|\n1215|func requireProviderID(object map[string]any, name string) error {\n1216|\tvalue, err := requireString(object, name)\n1217|\tif err != nil {\n1218|\t\treturn err\n1219|\t}\n1220|\tif _, err := scalar.ParseProviderID(value); err != nil {\n1221|\t\treturn invalidIdentity(\"member %s: %v\", name, err)\n1222|\t}\n1223|\treturn nil\n1224|}\n1225|\n1226|// requireTerminalBackendID enforces the Section 4.B terminal-backend-id scalar\n1227|// type. The declared bound is \"1-128 ASCII bytes\"; the declared grammar admits\n1228|// only ASCII, so the byte count and the Unicode character count coincide for\n1229|// every admitted value and the bound is measured in bytes as declared.\n(more lines below)"}}}
