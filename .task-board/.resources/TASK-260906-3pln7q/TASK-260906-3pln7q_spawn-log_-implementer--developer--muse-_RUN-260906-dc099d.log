{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c481","stream":{"kind":"session","id":"01a0785b-9847-7fa3-b40c-313061570fc0"},"sequence":155,"recorded_at":1780531400000305,"record_type":"event","durability":"durable","causation_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","run_stream":{"kind":"run","id":"5f283545-6d77-4246-bbdf-5a980fc43a74"},"task_stream":{"kind":"task","id":"041e63c8-903a-4c34-b1eb-fbab1987236c"},"task_id":"041e63c8-903a-4c34-b1eb-fbab1987236c","event":{"kind":"output","task_id":"041e63c8-903a-4c34-b1eb-fbab1987236c","chunk":"Read text file `internal/terminalbackend/manifest.go`.\n(499 line(s) above)\n500|\t}\n501|\tif _, err := scalar.ParseDigest(value); err != nil {\n502|\t\treturn \"\", mismatchf(\"document digest\")\n503|\t}\n504|\treturn value, nil\n505|}\n506|\n507|// digestOrNullMember extracts a digest|null member: present and either a\n508|// valid digest or JSON null. Absence is malformed, not null.\n509|func digestOrNullMember(object map[string]any, name string) (string, error) {\n510|\traw, known := object[name]\n511|\tif !known {\n512|\t\treturn \"\", mismatchf(\"document members\")\n513|\t}\n514|\tif raw == nil {\n515|\t\treturn \"\", nil\n516|\t}\n517|\tvalue, ok := raw.(string)\n518|\tif !ok {\n519|\t\treturn \"\", mismatchf(\"document member type\")\n520|\t}\n521|\tif _, err := scalar.ParseDigest(value); err != nil {\n522|\t\treturn \"\", mismatchf(\"document digest\")\n523|\t}\n524|\treturn value, nil\n525|}\n526|\n527|// semverMember extracts a required semver member.\n528|func semverMember(object map[string]any, name string) (string, error) {\n529|\tvalue, err := stringMember(object, name)\n530|\tif err != nil {\n531|\t\treturn \"\", err\n532|\t}\n533|\tif !semverPattern.MatchString(value) {\n534|\t\treturn \"\", mismatchf(\"document semver\")\n535|\t}\n536|\treturn value, nil\n537|}\n538|\n539|// timestampMember extracts a required timestamp member.\n540|func timestampMember(object map[string]any, name string) (scalar.Timestamp, error) {\n541|\tvalue, err := stringMember(object, name)\n542|\tif err != nil {\n543|\t\treturn scalar.Timestamp{}, err\n544|\t}\n545|\tparsed, err := scalar.ParseTimestamp(value)\n546|\tif err != nil {\n547|\t\treturn scalar.Timestamp{}, mismatchf(\"document timestamp\")\n548|\t}\n549|\treturn parsed, nil\n550|}\n551|\n552|// checkExtensions admits exactly the empty object {}. A non-empty extensions\n553|// object requires a later contract version, and absence is malformed.\n554|func checkExtensions(object map[string]any) error {\n555|\traw, known := object[\"extensions\"]\n556|\tif !known {\n557|\t\treturn mismatchf(\"document members\")\n558|\t}\n559|\textensions, ok := raw.(map[string]any)\n560|\tif !ok || len(extensions) != 0 {\n561|\t\treturn mismatchf(\"document extensions\")\n562|\t}\n563|\treturn nil\n564|}\n565|\n566|// stringArrayMember extracts a required array of strings, refusing numbers,\n567|// booleans, nulls, and nested values element-wise.\n568|func stringArrayMember(object map[string]any, name string) ([]string, error) {\n569|\traw, known := object[name]\n570|\tif !known {\n571|\t\treturn nil, mismatchf(\"document members\")\n572|\t}\n573|\tarray, ok := raw.([]any)\n574|\tif !ok {\n575|\t\treturn nil, mismatchf(\"document member type\")\n576|\t}\n577|\tvalues := make([]string, 0, len(array))\n578|\tfor _, member := range array {\n579|\t\tvalue, ok := member.(string)\n580|\t\tif !ok {\n581|\t\t\treturn nil, mismatchf(\"document member type\")\n582|\t\t}\n583|\t\tvalues = append(values, value)\n584|\t}\n585|\treturn values, nil\n586|}\n587|\n588|// checkSortedUnique refuses an unsorted or duplicated string list. Bytewise\n589|// order matches the wire's sorted-unique rule over lowercase ASCII members.\n590|func checkSortedUnique(values []string) error {\n591|\tfor index := range values {\n592|\t\tif index > 0 && values[index-1] >= values[index] {\n593|\t\t\treturn mismatchf(\"document ordering\")\n594|\t\t}\n595|\t}\n596|\treturn nil\n597|}\n598|\n599|// checkClosedList enforces the sorted-unique closed-vocabulary list shape:\n600|// every member in vocabulary, sorted unique, within the inclusive item\n601|// bound. The bound admits zero so [0..N] lists stay usable; [1..N] lists\n602|// are enforced by requiring at least one member.\n603|func checkClosedList(values []string, vocabulary map[string]bool, max int, requireNonEmpty bool) error {\n604|\tif len(values) > max || (requireNonEmpty && len(values) == 0) {\n605|\t\treturn mismatchf(\"document list bound\")\n606|\t}\n607|\tfor _, value := range values {\n608|\t\tif !vocabulary[value] {\n609|\t\t\treturn mismatchf(\"document vocabulary\")\n610|\t\t}\n611|\t}\n612|\treturn checkSortedUnique(values)\n613|}\n614|\n615|// objectIdentity computes the lowercase sha256: digest of the RFC 8785 JCS\n616|// bytes of object with exactly selfField omitted (§4.B identity rule). It\n617|// mirrors the repository's canonical pipeline (logical value, JSON\n618|// re-encode, JCS transform, SHA-256) without routing through the schema\n619|// validators owned by another task.\n620|func objectIdentity(object map[string]any, selfField string) (string, error) {\n621|\tomitted := make(map[string]any, len(object))\n622|\tfor name, member := range object {\n623|\t\tif name != selfField {\n624|\t\t\tomitted[name] = member\n625|\t\t}\n626|\t}\n627|\tserialized, err := json.Marshal(omitted)\n628|\tif err != nil {\n629|\t\treturn \"\", mismatchf(\"document identity\")\n630|\t}\n631|\tcanonical, err := jcs.Transform(serialized)\n632|\tif err != nil {\n633|\t\treturn \"\", mismatchf(\"document identity\")\n634|\t}\n635|\tsum := sha256.Sum256(canonical)\n636|\treturn \"sha256:\" + hex.EncodeToString(sum[:]), nil\n637|}\n638|\n639|// checkIdentity recomputes the omit-self digest and refuses a mismatch. A\n640|// reader must recompute the ID before use; trusting the claimed member is a\n641|// substitution vector.\n642|func checkIdentity(object map[string]any, selfField, claimed string) error {\n643|\tif _, err := scalar.ParseDigest(claimed); err != nil {\n644|\t\treturn mismatchf(\"document digest\")\n645|\t}\n646|\tcomputed, err := objectIdentity(object, selfField)\n647|\tif err != nil {\n648|\t\treturn err\n649|\t}\n650|\tif computed != claimed {\n651|\t\treturn mismatchf(\"document identity binding\")\n652|\t}\n653|\treturn nil\n654|}\n655|\n656|// Claim is one TerminalBackendCapabilityClaim: a closed object whose\n657|// generation_variable, dependent_operations, and evidence_requirements\n658|// members must exactly equal the capability registry row (§4.D). A false\n659|// claim makes a probed refusal explicit but confers no operation.\n660|type Claim struct {\n661|\t// Capability is one of the 16 closed registry names.\n662|\tCapability string\n663|\t// Origin is static (manifest echo) or probed (live observation).\n664|\tOrigin string\n665|\t// Value is the claimed capability state.\n666|\tValue bool\n667|\t// GenerationVariable repeats the registry row: whether the value may\n668|\t// change across backend generations.\n669|\tGenerationVariable bool\n670|\t// DependentOperations repeats the registry row: sorted unique\n671|\t// operations this capability confers.\n672|\tDependentOperations []string\n673|\t// EvidenceRequirements repeats the registry row: sorted unique\n674|\t// evidence requirements that prove a true claim.\n675|\tEvidenceRequirements []string\n676|}\n677|\n678|// parseClaim validates one claim object. allowProbed selects the Probe shape;\n679|// the Manifest shape admits only static origin.\n680|func parseClaim(raw any, allowProbed bool) (Claim, error) {\n681|\tobject, ok := raw.(map[string]any)\n682|\tif !ok {\n683|\t\treturn Claim{}, mismatchf(\"claim shape\")\n684|\t}\n685|\tif err := checkExactMembers(object, []string{\n686|\t\t\"capability\", \"origin\", \"value\",\n687|\t\t\"generation_variable\", \"dependent_operations\", \"evidence_requirements\",\n688|\t}); err != nil {\n689|\t\treturn Claim{}, err\n690|\t}\n691|\tcapability, err := stringMember(object, \"capability\")\n692|\tif err != nil {\n693|\t\treturn Claim{}, err\n694|\t}\n695|\trow, known := capabilityRegistry[capability]\n696|\tif !known {\n697|\t\treturn Claim{}, mismatchf(\"capability vocabulary\")\n698|\t}\n699|\torigin, err := stringMember(object, \"origin\")\n700|\tif err != nil {\n701|\t\treturn Claim{}, err\n702|\t}\n703|\tif origin != OriginStatic && (origin != OriginProbed || !allowProbed) {\n704|\t\treturn Claim{}, mismatchf(\"claim origin\")\n705|\t}\n706|\tboolean, ok := object[\"value\"].(bool)\n707|\tif !ok {\n708|\t\treturn Claim{}, mismatchf(\"document member type\")\n709|\t}\n710|\tgenerationVariable, ok := object[\"generation_variable\"].(bool)\n711|\tif !ok {\n712|\t\treturn Claim{}, mismatchf(\"document member type\")\n713|\t}\n714|\toperations, err := stringArrayMember(object, \"dependent_operations\")\n715|\tif err != nil {\n716|\t\treturn Claim{}, err\n717|\t}\n718|\tif err := checkClosedList(operations, operationVocabulary, maxOperations, true); err != nil {\n719|\t\treturn Claim{}, err\n720|\t}\n721|\trequirements, err := stringArrayMember(object, \"evidence_requirements\")\n722|\tif err != nil {\n723|\t\treturn Claim{}, err\n724|\t}\n725|\tif err := checkClosedList(requirements, evidenceRequirementVocabulary, maxRequirements, true); err != nil {\n726|\t\treturn Claim{}, err\n727|\t}\n728|\t// The three registry-derived members must equal the row: a Manifest or\n729|\t// Probe cannot redefine what a capability means or what proves it.\n730|\tif generationVariable != row.generationVariable ||\n731|\t\t!equalStrings(operations, row.dependentOperations) ||\n732|\t\t!equalStrings(requirements, row.evidenceRequirements) {\n733|\t\treturn Claim{}, mismatchf(\"capability registry binding\")\n734|\t}\n735|\treturn Claim{\n736|\t\tCapability:           capability,\n737|\t\tOrigin:               origin,\n738|\t\tValue:                boolean,\n739|\t\tGenerationVariable:   generationVariable,\n740|\t\tDependentOperations:  operations,\n741|\t\tEvidenceRequirements: requirements,\n742|\t}, nil\n743|}\n744|\n745|// parseClaimList validates a sorted-by-capability unique claim array within\n746|// the [0..16] bound. Sorting is checked here so reconciliation can treat\n747|// the key order as established; duplicates are invalid before keyed\n748|// reconciliation runs.\n749|func parseClaimList(raw any, allowProbed bool) ([]Claim, error) {\n750|\tarray, ok := raw.([]any)\n751|\tif !ok {\n752|\t\treturn nil, mismatchf(\"document member type\")\n753|\t}\n754|\tif len(array) > maxClaims {\n755|\t\treturn nil, mismatchf(\"claim list bound\")\n756|\t}\n757|\tclaims := make([]Claim, 0, len(array))\n758|\tprevious := \"\"\n759|\tfor _, member := range array {\n760|\t\tclaim, err := parseClaim(member, allowProbed)\n761|\t\tif err != nil {\n762|\t\t\treturn nil, err\n763|\t\t}\n764|\t\tif previous >= claim.Capability {\n765|\t\t\treturn nil, mismatchf(\"claim ordering\")\n766|\t\t}\n767|\t\tprevious = claim.Capability\n768|\t\tclaims = append(claims, claim)\n769|\t}\n770|\treturn claims, nil\n771|}\n772|\n773|// equalClaim reports member-for-member equality of two claims.\n774|func equalClaim(left, right Claim) bool {\n775|\treturn left.Capability == right.Capability &&\n776|\t\tleft.Origin == right.Origin &&\n777|\t\tleft.Value == right.Value &&\n778|\t\tleft.GenerationVariable == right.GenerationVariable &&\n779|\t\tequalStrings(left.DependentOperations, right.DependentOperations) &&\n780|\t\tequalStrings(left.EvidenceRequirements, right.EvidenceRequirements)\n781|}\n782|\n783|// equalStrings reports element-wise equality of two string lists.\n784|func equalStrings(left, right []string) bool {\n785|\tif len(left) != len(right) {\n786|\t\treturn false\n787|\t}\n788|\tfor index := range left {\n789|\t\tif left[index] != right[index] {\n790|\t\t\treturn false\n791|\t\t}\n792|\t}\n793|\treturn true\n794|}\n795|\n796|// Manifest is one validated Terminal Backend Manifest 1.0.0: the closed\n797|// immutable backend description. It is not availability proof, and no\n798|// unsupported capability may be advertised through it.\n799|type Manifest struct {\n800|\t// ManifestID is the recomputed omit-self digest.\n801|\tManifestID string\n802|\t// TerminalBackendID is the canonical backend identity.\n803|\tTerminalBackendID string\n804|\t// ImplementationVersion is the exact admitted semver.\n805|\tImplementationVersion string\n806|\t// ProtocolVersions are the sorted unique semver members in Terminal\n807|\t// Backend Protocol major 1.\n808|\tProtocolVersions []string\n809|\t// Platforms is the sorted unique non-empty platform subset.\n810|\tPlatforms []scalar.Platform\n811|\t// ImplementationKind is the closed implementation_kind.\n812|\tImplementationKind Kind\n813|\t// ExecutableDigest is the sha256: digest for external kinds and empty\n814|\t// (null) for built-in kinds.\n815|\tExecutableDigest string\n816|\t// StaticCapabilityClaims are the sorted-by-capability unique static\n817|\t// claims, each exactly repeating its registry row.\n818|\tStaticCapabilityClaims []Claim\n819|\t// ConformanceFixtureID names the fixture true claims are proven with.\n820|\tConformanceFixtureID string\n821|}\n822|\n823|// Probe is one validated Terminal Backend Probe 1.0.0: the closed immutable\n824|// observation of a backend on one platform, generation, and instant.\n825|type Probe struct {\n826|\t// ProbeID is the recomputed omit-self digest.\n827|\tProbeID string\n828|\t// TerminalBackendID equals the admitted Manifest member.\n829|\tTerminalBackendID string\n830|\t// ImplementationVersion equals the admitted Manifest member.\n831|\tImplementationVersion string\n832|\t// ProtocolVersion is exactly one member of the Manifest list.\n833|\tProtocolVersion string\n834|\t// ImplementationKind equals the Manifest member.\n835|\tImplementationKind Kind\n836|\t// ExecutableDigest exactly equals the Manifest member.\n837|\tExecutableDigest string\n838|\t// Platform is exactly one member of the Manifest platforms.\n839|\tPlatform scalar.Platform\n840|\t// OSVersion is the string[1..256] host release.\n841|\tOSVersion string\n842|\t// Availability is the closed readiness vocabulary.\n843|\tAvailability string\n844|\t// BackendGenerationDigest is the digest of the domain-separated raw\n845|\t// generation. It neither reveals nor reconstructs that generation.\n846|\tBackendGenerationDigest string\n847|\t// CapabilityClaims are the sorted-by-capability unique reconciled\n848|\t// claims.\n849|\tCapabilityClaims []Claim\n850|\t// EvidenceIDs are the sorted unique IDs of the evidence objects used\n851|\t// by true claims.\n852|\tEvidenceIDs []string\n853|\t// ProbedAt is the observation instant.\n854|\tProbedAt scalar.Timestamp\n855|}\n856|\n857|// Evidence is one validated Capability Evidence 1.0.0 object: the signed,\n858|// expiring, generation-bound proof of one true capability claim. Value is\n859|// always true by construction: a false claim has no matching evidence.\n860|type Evidence struct {\n861|\t// EvidenceID is the recomputed omit-self digest.\n862|\tEvidenceID string\n863|\t// TerminalBackendID equals the Manifest and Probe members.\n864|\tTerminalBackendID string\n865|\t// ImplementationVersion equals the Manifest and Probe members.\n866|\tImplementationVersion string\n867|\t// ProtocolVersion equals the Probe member.\n868|\tProtocolVersion string\n869|\t// BackendGenerationDigest equals the Probe member.\n870|\tBackendGenerationDigest string\n871|\t// Capability names the one true claim this object proves.\n872|\tCapability string\n873|\t// Platform equals the Probe member.\n874|\tPlatform scalar.Platform\n875|\t// OSVersion equals the Probe member.\n876|\tOSVersion string\n877|\t// ConformanceFixtureID equals the Manifest member.\n878|\tConformanceFixtureID string\n879|\t// ObservedAt opens the validity interval.\n880|\tObservedAt scalar.Timestamp\n881|\t// ExpiresAt closes the validity interval, strictly after ObservedAt.\n882|\tExpiresAt scalar.Timestamp\n883|\t// Issuer is ax_release or ax_local_probe.\n884|\tIssuer string\n885|\t// IssuerID is the digest of the trusted signing identity. A\n886|\t// caller-supplied issuer ID is not authentication: the signature must\n887|\t// verify through the trusted key registry.\n888|\tIssuerID string\n889|\t// AttestationSignature is the raw signature bytes (scheme stripped).\n890|\tAttestationSignature []byte\n891|\t// Facts are the sorted unique evidence facts covering the claim's\n892|\t// requirements through the requirement-to-fact mapping.\n893|\tFacts []string\n894|\t// TerminalBindingID is the opaque binding digest, required only for\n895|\t// credential_capable_execution_realm and empty otherwise.\n896|\tTerminalBindingID string\n897|\t// ProviderID is the provider-id, required only for\n898|\t// credential_capable_execution_realm and empty otherwise.\n899|\tProviderID string\n900|\t// ProviderBuild is the string[1..256] provider build, required only\n901|\t// for credential_capable_execution_realm and empty otherwise.\n902|\tProviderBuild string\n903|\t// SentinelResult is literal passed, required only for\n904|\t// credential_capable_execution_realm and empty otherwise.\n905|\tSentinelResult string\n906|\t// ProviderAuthSmokeResult is literal passed, required only for\n907|\t// credential_capable_execution_realm and empty otherwise.\n908|\tProviderAuthSmokeResult string\n909|}\n910|\n911|// manifestMembers is the exact closed Manifest member set.\n912|var manifestMembers = []string{\n913|\t\"schema\", \"schema_version\", \"manifest_id\", \"terminal_backend_id\",\n914|\t\"implementation_version\", \"protocol_versions\", \"platforms\",\n915|\t\"implementation_kind\", \"executable_digest\", \"static_capability_claims\",\n916|\t\"conformance_fixture_id\", \"extensions\",\n917|}\n918|\n919|// ParseManifest validates one Terminal Backend Manifest 1.0.0 document and\n920|// returns the typed observation. Any deviation from the closed shape,\n921|// vocabulary, bound, ordering, registry-row, or identity rule is\n922|// CodeMismatch: a malformed read is an error, never absence.\n923|func ParseManifest(raw []byte) (Manifest, error) {\n924|\tobject, err := decodeStrictObject(raw)\n925|\tif err != nil {\n926|\t\treturn Manifest{}, err\n927|\t}\n928|\treturn parseManifestObject(object)\n929|}\n930|\n931|// parseManifestObject validates a decoded Manifest member map. It is split\n932|// from ParseManifest so admission paths that already hold a decoded object\n933|// share the exact gate.\n934|func parseManifestObject(object map[string]any) (Manifest, error) {\n935|\tif err := checkExactMembers(object, manifestMembers); err != nil {\n936|\t\treturn Manifest{}, err\n937|\t}\n938|\tif schema, err := stringMember(object, \"schema\"); err != nil || schema != SchemaManifest {\n939|\t\treturn Manifest{}, mismatchf(\"manifest schema\")\n940|\t}\n941|\tif version, err := stringMember(object, \"schema_version\"); err != nil || version != SchemaVersion100 {\n942|\t\treturn Manifest{}, mismatchf(\"manifest schema version\")\n943|\t}\n944|\tmanifestID, err := stringMember(object, \"manifest_id\")\n945|\tif err != nil {\n946|\t\treturn Manifest{}, err\n947|\t}\n948|\tif err := checkIdentity(object, \"manifest_id\", manifestID); err != nil {\n949|\t\treturn Manifest{}, err\n950|\t}\n951|\tbackendID, err := stringMember(object, \"terminal_backend_id\")\n952|\tif err != nil {\n953|\t\treturn Manifest{}, err\n954|\t}\n955|\tif _, err := ParseID(backendID); err != nil {\n956|\t\treturn Manifest{}, mismatchf(\"manifest backend identity\")\n957|\t}\n958|\timplementationVersion, err := semverMember(object, \"implementation_version\")\n959|\tif err != nil {\n960|\t\treturn Manifest{}, err\n961|\t}\n962|\tprotocols, err := stringArrayMember(object, \"protocol_versions\")\n963|\tif err != nil {\n964|\t\treturn Manifest{}, err\n965|\t}\n966|\tif err := validateProtocolList(protocols); err != nil {\n967|\t\treturn Manifest{}, err\n968|\t}\n969|\tplatforms, err := parsePlatformList(object)\n970|\tif err != nil {\n971|\t\treturn Manifest{}, err\n972|\t}\n973|\tkindName, err := stringMember(object, \"implementation_kind\")\n974|\tif err != nil {\n975|\t\treturn Manifest{}, err\n976|\t}\n977|\tkind, err := parseKind(kindName)\n978|\tif err != nil {\n979|\t\treturn Manifest{}, mismatchf(\"manifest implementation kind\")\n980|\t}\n981|\tdigest, err := digestOrNullMember(object, \"executable_digest\")\n982|\tif err != nil {\n983|\t\treturn Manifest{}, err\n984|\t}\n985|\tif needsDigest(kind) == (digest == \"\") {\n986|\t\treturn Manifest{}, mismatchf(\"manifest executable digest\")\n987|\t}\n988|\tclaimsRaw, known := object[\"static_capability_claims\"]\n989|\tif !known {\n990|\t\treturn Manifest{}, mismatchf(\"document members\")\n991|\t}\n992|\tclaims, err := parseClaimList(claimsRaw, false)\n993|\tif err != nil {\n994|\t\treturn Manifest{}, err\n995|\t}\n996|\tfixtureID, err := digestMember(object, \"conformance_fixture_id\")\n997|\tif err != nil {\n998|\t\treturn Manifest{}, err\n999|\t}\n1000|\tif err := checkExtensions(object); err != nil {\n1001|\t\treturn Manifest{}, err\n1002|\t}\n1003|\treturn Manifest{\n1004|\t\tManifestID:             manifestID,\n1005|\t\tTerminalBackendID:      backendID,\n1006|\t\tImplementationVersion:  implementationVersion,\n1007|\t\tProtocolVersions:       protocols,\n1008|\t\tPlatforms:              platforms,\n1009|\t\tImplementationKind:     kind,\n1010|\t\tExecutableDigest:       digest,\n1011|\t\tStaticCapabilityClaims: claims,\n1012|\t\tConformanceFixtureID:   fixtureID,\n1013|\t}, nil\n1014|}\n1015|\n1016|// validateProtocolList enforces sorted unique semver[1..32], each in\n1017|// Terminal Backend Protocol major 1, without naming a backend.\n1018|func validateProtocolList(versions []string) error {\n1019|\tif len(versions) < 1 || len(versions) > maxProtocolVersions {\n1020|\t\treturn mismatchf(\"protocol versions bound\")\n1021|\t}\n1022|\tfor index, version := range versions {\n1023|\t\tif !semverPattern.MatchString(version) || semverMajor(version) != 1 {\n1024|\t\t\treturn mismatchf(\"protocol versions major 1\")\n1025|\t\t}\n1026|\t\tif index > 0 && versions[index-1] >= version {\n1027|\t\t\treturn mismatchf(\"protocol versions ordering\")\n1028|\t\t}\n1029|\t}\n1030|\treturn nil\n1031|}\n1032|\n1033|// parsePlatformList validates the sorted unique non-empty platform subset.\n1034|func parsePlatformList(object map[string]any) ([]scalar.Platform, error) {\n1035|\tnames, err := stringArrayMember(object, \"platforms\")\n1036|\tif err != nil {\n1037|\t\treturn nil, err\n1038|\t}\n1039|\tif len(names) == 0 || len(names) > 4 {\n1040|\t\treturn nil, mismatchf(\"platforms bound\")\n1041|\t}\n1042|\tplatforms := make([]scalar.Platform, 0, len(names))\n1043|\tfor _, name := range names {\n1044|\t\tplatform, err := scalar.ParsePlatform(name)\n1045|\t\tif err != nil {\n1046|\t\t\treturn nil, mismatchf(\"platforms vocabulary\")\n1047|\t\t}\n1048|\t\tplatforms = append(platforms, platform)\n1049|\t}\n1050|\tfor index := range platforms {\n1051|\t\t// Bytewise >= refuses duplicates and misordering together: equal\n1052|\t\t// neighbours are not strictly ordered.\n1053|\t\tif index > 0 && platforms[index-1].String() >= platforms[index].String() {\n1054|\t\t\treturn nil, mismatchf(\"platforms ordering\")\n1055|\t\t}\n1056|\t}\n1057|\treturn platforms, nil\n1058|}\n1059|\n1060|// probeMembers is the exact closed Probe member set.\n1061|var probeMembers = []string{\n1062|\t\"schema\", \"schema_version\", \"probe_id\", \"terminal_backend_id\",\n1063|\t\"implementation_version\", \"protocol_version\", \"implementation_kind\",\n1064|\t\"executable_digest\", \"platform\", \"os_version\", \"availability\",\n1065|\t\"backend_generation_digest\", \"capability_claims\", \"evidence_ids\",\n1066|\t\"probed_at\", \"extensions\",\n1067|}\n1068|\n1069|// ParseProbe validates one Terminal Backend Probe 1.0.0 document. Shape,\n1070|// vocabulary, bound, ordering, registry-row, and identity failures are all\n1071|// CodeMismatch; cross-document reconciliation against the Manifest happens\n1072|// in Reconcile, not here.\n1073|func ParseProbe(raw []byte) (Probe, error) {\n1074|\tobject, err := decodeStrictObject(raw)\n1075|\tif err != nil {\n1076|\t\treturn Probe{}, err\n1077|\t}\n1078|\tif err := checkExactMembers(object, probeMembers); err != nil {\n1079|\t\treturn Probe{}, err\n1080|\t}\n1081|\tif schema, err := stringMember(object, \"schema\"); err != nil || schema != SchemaProbe {\n1082|\t\treturn Probe{}, mismatchf(\"probe schema\")\n1083|\t}\n1084|\tif version, err := stringMember(object, \"schema_version\"); err != nil || version != SchemaVersion100 {\n1085|\t\treturn Probe{}, mismatchf(\"probe schema version\")\n1086|\t}\n1087|\tprobeID, err := stringMember(object, \"probe_id\")\n1088|\tif err != nil {\n1089|\t\treturn Probe{}, err\n1090|\t}\n1091|\tif err := checkIdentity(object, \"probe_id\", probeID); err != nil {\n1092|\t\treturn Probe{}, err\n1093|\t}\n1094|\tbackendID, err := stringMember(object, \"terminal_backend_id\")\n1095|\tif err != nil {\n1096|\t\treturn Probe{}, err\n1097|\t}\n1098|\tif _, err := ParseID(backendID); err != nil {\n1099|\t\treturn Probe{}, mismatchf(\"probe backend identity\")\n(more lines below)"}}}
