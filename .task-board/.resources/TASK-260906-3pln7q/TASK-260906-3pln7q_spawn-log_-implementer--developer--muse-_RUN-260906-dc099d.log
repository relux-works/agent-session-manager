; the number walk in objectIdentity holds that order\n+// even for a caller that skips the member checks.\n+func checkIdentity(object map[string]any, selfField, claimed string) error {\n","edit_facts":{"tool_name":"edit_file","path":"internal/terminalbackend/manifest.go","added":31,"removed":4},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
