{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c76f","stream":{"kind":"session","id":"01a0785b-9847-7fa3-b40c-313061570fc0"},"sequence":530,"recorded_at":1780531400001055,"record_type":"event","durability":"durable","causation_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5f283545-6d77-4246-bbdf-5a980fc43a74","run_stream":{"kind":"run","id":"5f283545-6d77-4246-bbdf-5a980fc43a74"},"call_id":"call_01a0785d98e17d5294d4f7c0883dc880","text":"Read text file `internal/terminalbackend/manifest.go`.\n(1098 line(s) above)\n1099|\t\treturn Probe{}, mismatchf(\"probe backend identity\")\n1100|\t}\n1101|\timplementationVersion, err := semverMember(object, \"implementation_version\")\n1102|\tif err != nil {\n1103|\t\treturn Probe{}, err\n1104|\t}\n1105|\tprotocolVersion, err := semverMember(object, \"protocol_version\")\n1106|\tif err != nil {\n1107|\t\treturn Probe{}, err\n1108|\t}\n1109|\tif semverMajor(protocolVersion) != 1 {\n1110|\t\treturn Probe{}, mismatchf(\"probe protocol major 1\")\n1111|\t}\n1112|\tkindName, err := stringMember(object, \"implementation_kind\")\n1113|\tif err != nil {\n1114|\t\treturn Probe{}, err\n1115|\t}\n1116|\tkind, err := parseKind(kindName)\n1117|\tif err != nil {\n1118|\t\treturn Probe{}, mismatchf(\"probe implementation kind\")\n1119|\t}\n1120|\tdigest, err := digestOrNullMember(object, \"executable_digest\")\n1121|\tif err != nil {\n1122|\t\treturn Probe{}, err\n1123|\t}\n1124|\tif needsDigest(kind) == (digest == \"\") {\n1125|\t\treturn Probe{}, mismatchf(\"probe executable digest\")\n1126|\t}\n1127|\tplatformName, err := stringMember(object, \"platform\")\n1128|\tif err != nil {\n1129|\t\treturn Probe{}, err\n1130|\t}\n1131|\tplatform, err := scalar.ParsePlatform(platformName)\n1132|\tif err != nil {\n1133|\t\treturn Probe{}, mismatchf(\"probe platform\")\n1134|\t}\n1135|\tosVersion, err := boundedStringMember(object, \"os_version\")\n1136|\tif err != nil {\n1137|\t\treturn Probe{}, err\n1138|\t}\n1139|\tavailability, err := stringMember(object, \"availability\")\n1140|\tif err != nil {\n1141|\t\treturn Probe{}, err\n1142|\t}\n1143|\tswitch availability {\n1144|\tcase AvailabilityAvailable, AvailabilityConditional, AvailabilityUnavailable, AvailabilityUnknown:\n1145|\tdefault:\n1146|\t\treturn Probe{}, mismatchf(\"probe availability\")\n1147|\t}\n1148|\tgenerationDigest, err := digestMember(object, \"backend_generation_digest\")\n1149|\tif err != nil {\n1150|\t\treturn Probe{}, err\n1151|\t}\n1152|\tclaimsRaw, known := object[\"capability_claims\"]\n1153|\tif !known {\n1154|\t\treturn Probe{}, mismatchf(\"document members\")\n1155|\t}\n1156|\tclaims, err := parseClaimList(claimsRaw, true)\n1157|\tif err != nil {\n1158|\t\treturn Probe{}, err\n1159|\t}\n1160|\tevidenceIDs, err := stringArrayMember(object, \"evidence_ids\")\n1161|\tif err != nil {\n1162|\t\treturn Probe{}, err\n1163|\t}\n1164|\tif len(evidenceIDs) > maxEvidenceIDs {\n1165|\t\treturn Probe{}, mismatchf(\"evidence list bound\")\n1166|\t}\n1167|\tfor _, id := range evidenceIDs {\n1168|\t\tif _, err := scalar.ParseDigest(id); err != nil {\n1169|\t\t\treturn Probe{}, mismatchf(\"document digest\")\n1170|\t\t}\n1171|\t}\n1172|\tif err := checkSortedUnique(evidenceIDs); err != nil {\n1173|\t\treturn Probe{}, err\n1174|\t}\n1175|\tprobedAt, err := timestampMember(object, \"probed_at\")\n1176|\tif err != nil {\n1177|\t\treturn Probe{}, err\n1178|\t}\n1179|\tif err := checkExtensions(object); err != nil {\n1180|\t\treturn Probe{}, err\n1181|\t}\n1182|\treturn Probe{\n1183|\t\tProbeID:                 probeID,\n1184|\t\tTerminalBackendID:       backendID,\n1185|\t\tImplementationVersion:   implementationVersion,\n1186|\t\tProtocolVersion:         protocolVersion,\n1187|\t\tImplementationKind:      kind,\n1188|\t\tExecutableDigest:        digest,\n1189|\t\tPlatform:                platform,\n1190|\t\tOSVersion:               osVersion,\n1191|\t\tAvailability:            availability,\n1192|\t\tBackendGenerationDigest: generationDigest,\n1193|\t\tCapabilityClaims:        claims,\n1194|\t\tEvidenceIDs:             evidenceIDs,\n1195|\t\tProbedAt:                probedAt,\n1196|\t}, nil\n1197|}\n1198|\n1199|// evidenceMembers is the exact closed Capability Evidence member set.\n1200|var evidenceMembers = []string{\n1201|\t\"schema\", \"schema_version\", \"evidence_id\", \"terminal_backend_id\",\n1202|\t\"implementation_version\", \"protocol_version\", \"backend_generation_digest\",\n1203|\t\"capability\", \"value\", \"platform\", \"os_version\", \"conformance_fixture_id\",\n1204|\t\"observed_at\", \"expires_at\", \"issuer\", \"issuer_id\",\n1205|\t\"attestation_signature\", \"facts\", \"terminal_binding_id\", \"provider_id\",\n1206|\t\"provider_build\", \"sentinel_result\", \"provider_auth_smoke_result\",\n1207|\t\"extensions\",\n1208|}\n1209|\n1210|// ParseEvidence validates one Capability Evidence 1.0.0 document. The\n1211|// signature is structurally decoded here; cryptographic verification happens\n1212|// in Reconcile through the caller's SignatureVerifier, because a\n1213|// caller-supplied issuer ID is not authentication. Expiry (expires_at\n1214|// strictly after observed_at) is enforced here; liveness at admission time\n1215|// is enforced in Reconcile.\n1216|func ParseEvidence(raw []byte) (Evidence, error) {\n1217|\tobject, err := decodeStrictObject(raw)\n1218|\tif err != nil {\n1219|\t\treturn Evidence{}, err\n1220|\t}\n1221|\tif err := checkExactMembers(object, evidenceMembers); err != nil {\n1222|\t\treturn Evidence{}, err\n1223|\t}\n1224|\tif schema, err := stringMember(object, \"schema\"); err != nil || schema != SchemaCapabilityEvidence {\n1225|\t\treturn Evidence{}, mismatchf(\"evidence schema\")\n1226|\t}\n1227|\tif version, err := stringMember(object, \"schema_version\"); err != nil || version != SchemaVersion100 {\n1228|\t\treturn Evidence{}, mismatchf(\"evidence schema version\")\n1229|\t}\n1230|\tevidenceID, err := stringMember(object, \"evidence_id\")\n1231|\tif err != nil {\n1232|\t\treturn Evidence{}, err\n1233|\t}\n1234|\tif err := checkIdentity(object, \"evidence_id\", evidenceID); err != nil {\n1235|\t\treturn Evidence{}, err\n1236|\t}\n1237|\tbackendID, err := stringMember(object, \"terminal_backend_id\")\n1238|\tif err != nil {\n1239|\t\treturn Evidence{}, err\n1240|\t}\n1241|\tif _, err := ParseID(backendID); err != nil {\n1242|\t\treturn Evidence{}, mismatchf(\"evidence backend identity\")\n1243|\t}\n1244|\timplementationVersion, err := semverMember(object, \"implementation_version\")\n1245|\tif err != nil {\n1246|\t\treturn Evidence{}, err\n1247|\t}\n1248|\tprotocolVersion, err := semverMember(object, \"protocol_version\")\n1249|\tif err != nil {\n1250|\t\treturn Evidence{}, err\n1251|\t}\n1252|\tif semverMajor(protocolVersion) != 1 {\n1253|\t\treturn Evidence{}, mismatchf(\"evidence protocol major 1\")\n1254|\t}\n1255|\tgenerationDigest, err := digestMember(object, \"backend_generation_digest\")\n1256|\tif err != nil {\n1257|\t\treturn Evidence{}, err\n1258|\t}\n1259|\tcapability, err := stringMember(object, \"capability\")\n1260|\tif err != nil {\n1261|\t\treturn Evidence{}, err\n1262|\t}\n1263|\tif _, known := capabilityRegistry[capability]; !known {\n1264|\t\treturn Evidence{}, mismatchf(\"capability vocabulary\")\n1265|\t}\n1266|\t// Evidence value is the literal true: a false claim has no matching\n1267|\t// evidence, so a false-valued object is malformed.\n1268|\tif value, ok := object[\"value\"].(bool); !ok || !value {\n1269|\t\treturn Evidence{}, mismatchf(\"evidence value\")\n1270|\t}\n1271|\tplatformName, err := stringMember(object, \"platform\")\n1272|\tif err != nil {\n1273|\t\treturn Evidence{}, err\n1274|\t}\n1275|\tplatform, err := scalar.ParsePlatform(platformName)\n1276|\tif err != nil {\n1277|\t\treturn Evidence{}, mismatchf(\"evidence platform\")\n1278|\t}\n1279|\tosVersion, err := boundedStringMember(object, \"os_version\")\n1280|\tif err != nil {\n1281|\t\treturn Evidence{}, err\n1282|\t}\n1283|\tfixtureID, err := digestMember(object, \"conformance_fixture_id\")\n1284|\tif err != nil {\n1285|\t\treturn Evidence{}, err\n1286|\t}\n1287|\tobservedAt, err := timestampMember(object, \"observed_at\")\n1288|\tif err != nil {\n1289|\t\treturn Evidence{}, err\n1290|\t}\n1291|\texpiresAt, err := timestampMember(object, \"expires_at\")\n1292|\tif err != nil {\n1293|\t\treturn Evidence{}, err\n1294|\t}\n1295|\tobserved, err := observedAt.Time()\n1296|\tif err != nil {\n1297|\t\treturn Evidence{}, mismatchf(\"document timestamp\")\n1298|\t}\n1299|\texpires, err := expiresAt.Time()\n1300|\tif err != nil {\n1301|\t\treturn Evidence{}, mismatchf(\"document timestamp\")\n1302|\t}\n1303|\tif !expires.After(observed) {\n1304|\t\treturn Evidence{}, mismatchf(\"evidence expiry\")\n1305|\t}\n1306|\tissuer, err := stringMember(object, \"issuer\")\n1307|\tif err != nil {\n1308|\t\treturn Evidence{}, err\n1309|\t}\n1310|\tif issuer != IssuerRelease && issuer != IssuerLocalProbe {\n1311|\t\treturn Evidence{}, mismatchf(\"evidence issuer\")\n1312|\t}\n1313|\tissuerID, err := digestMember(object, \"issuer_id\")\n1314|\tif err != nil {\n1315|\t\treturn Evidence{}, err\n1316|\t}\n1317|\tsignature, err := parseAttestationSignature(object)\n1318|\tif err != nil {\n1319|\t\treturn Evidence{}, err\n1320|\t}\n1321|\tfacts, err := stringArrayMember(object, \"facts\")\n1322|\tif err != nil {\n1323|\t\treturn Evidence{}, err\n1324|\t}\n1325|\tif err := checkClosedList(facts, evidenceFactVocabulary, maxFacts, true); err != nil {\n1326|\t\treturn Evidence{}, err\n1327|\t}\n1328|\trealm, err := parseRealmMembers(object, capability)\n1329|\tif err != nil {\n1330|\t\treturn Evidence{}, err\n1331|\t}\n1332|\tif err := checkExtensions(object); err != nil {\n1333|\t\treturn Evidence{}, err\n1334|\t}\n1335|\treturn Evidence{\n1336|\t\tEvidenceID:              evidenceID,\n1337|\t\tTerminalBackendID:       backendID,\n1338|\t\tImplementationVersion:   implementationVersion,\n1339|\t\tProtocolVersion:         protocolVersion,\n1340|\t\tBackendGenerationDigest: generationDigest,\n1341|\t\tCapability:              capability,\n1342|\t\tPlatform:                platform,\n1343|\t\tOSVersion:               osVersion,\n1344|\t\tConformanceFixtureID:    fixtureID,\n1345|\t\tObservedAt:              observedAt,\n1346|\t\tExpiresAt:               expiresAt,\n1347|\t\tIssuer:                  issuer,\n1348|\t\tIssuerID:                issuerID,\n1349|\t\tAttestationSignature:    signature,\n1350|\t\tFacts:                   facts,\n1351|\t\tTerminalBindingID:       realm.bindingID,\n1352|\t\tProviderID:              realm.providerID,\n1353|\t\tProviderBuild:           realm.providerBuild,\n1354|\t\tSentinelResult:          realm.sentinelResult,\n1355|\t\tProviderAuthSmokeResult: realm.smokeResult,\n1356|\t}, nil\n1357|}\n1358|\n1359|// parseAttestationSignature structurally decodes the rsa-sha256: plus Base64\n1360|// RFC 4648 attestation signature. Decoding success is not validity.\n1361|func parseAttestationSignature(object map[string]any) ([]byte, error) {\n1362|\tencoded, err := stringMember(object, \"attestation_signature\")\n1363|\tif err != nil {\n1364|\t\treturn nil, err\n1365|\t}\n1366|\traw, found := strings.CutPrefix(encoded, signatureSchemePrefix)\n1367|\tif !found || raw == \"\" {\n1368|\t\treturn nil, mismatchf(\"evidence signature scheme\")\n1369|\t}\n1370|\tsignature, err := base64.StdEncoding.DecodeString(raw)\n1371|\tif err != nil || len(signature) == 0 {\n1372|\t\treturn nil, mismatchf(\"evidence signature encoding\")\n1373|\t}\n1374|\treturn signature, nil\n1375|}\n1376|\n1377|// realmMembers carries the credential-realm conditional members.\n1378|type realmMembers struct {\n1379|\tbindingID      string\n1380|\tproviderID     string\n1381|\tproviderBuild  string\n1382|\tsentinelResult string\n1383|\tsmokeResult    string\n1384|}\n1385|\n1386|// parseRealmMembers enforces the credential-realm conditional shape: the\n1387|// binding digest, provider ID/build, sentinel, and smoke members are\n1388|// required exactly for credential_capable_execution_realm and null\n1389|// otherwise. A realm claim proved by realm-less evidence (or realm evidence\n1390|// attached to any other claim) is malformed.\n1391|func parseRealmMembers(object map[string]any, capability string) (realmMembers, error) {\n1392|\tisRealm := capability == credentialRealmCapability\n1393|\tbindingID, err := digestOrNullMember(object, \"terminal_binding_id\")\n1394|\tif err != nil {\n1395|\t\treturn realmMembers{}, err\n1396|\t}\n1397|\tproviderID, providerBuild, err := parseRealmProvider(object)\n1398|\tif err != nil {\n1399|\t\treturn realmMembers{}, err\n1400|\t}\n1401|\tsentinelResult, err := parseRealmLiteral(object, \"sentinel_result\")\n1402|\tif err != nil {\n1403|\t\treturn realmMembers{}, err\n1404|\t}\n1405|\tsmokeResult, err := parseRealmLiteral(object, \"provider_auth_smoke_result\")\n1406|\tif err != nil {\n1407|\t\treturn realmMembers{}, err\n1408|\t}\n1409|\tif isRealm {\n1410|\t\tif bindingID == \"\" || providerID == \"\" || providerBuild == \"\" ||\n1411|\t\t\tsentinelResult == \"\" || smokeResult == \"\" {\n1412|\t\t\treturn realmMembers{}, mismatchf(\"evidence realm binding\")\n1413|\t\t}\n1414|\t} else if bindingID != \"\" || providerID != \"\" || providerBuild != \"\" ||\n1415|\t\tsentinelResult != \"\" || smokeResult != \"\" {\n1416|\t\treturn realmMembers{}, mismatchf(\"evidence realm binding\")\n1417|\t}\n1418|\treturn realmMembers{\n1419|\t\tbindingID:      bindingID,\n1420|\t\tproviderID:     providerID,\n1421|\t\tproviderBuild:  providerBuild,\n1422|\t\tsentinelResult: sentinelResult,\n1423|\t\tsmokeResult:    smokeResult,\n1424|\t}, nil\n1425|}\n1426|\n1427|// GenerationDigest binds a backend's host-local raw generation to its\n1428|// advertisable digest: SHA-256 over the UTF-8 domain separator followed by\n1429|// the raw generation bytes (§4.B). The raw generation is a string[1..256]\n1430|// in UTF-8 characters over valid UTF-8 (SPEC.md:321); anything else\n1431|// (including empty, which would make every backend share one digest) is\n1432|// CodeStaleGeneration, never a derived value.\n1433|func GenerationDigest(rawGeneration string) (string, error) {\n1434|\tif !utf8.ValidString(rawGeneration) || utf8.RuneCountInString(rawGeneration) < 1 || utf8.RuneCountInString(rawGeneration) > maxGenerationRunes {\n1435|\t\treturn \"\", &Error{Code: CodeStaleGeneration, Detail: \"backend_generation bound\"}\n1436|\t}\n1437|\tmaterial := append([]byte(generationDigestDomain), rawGeneration...)\n1438|\tsum := sha256.Sum256(material)\n1439|\treturn \"sha256:\" + hex.EncodeToString(sum[:]), nil\n1440|}\n1441|\n1442|// SignatureVerifier verifies one evidence attestation signature. issuerID is\n1443|// the evidence issuer_id, message the domain-separated canonical bytes from\n1444|// UnsignedEvidenceBytes, and signature the decoded attestation bytes. A nil\n1445|// return authenticates through the caller's trusted release or\n1446|// host-incarnation key registry; any error (unknown key, invalid signature,\n1447|// registry failure) fails closed. A nil verifier admits nothing.\n1448|type SignatureVerifier func(issuerID string, message, signature []byte) error\n1449|\n1450|// integrityFailure refuses with CodeIntegrityFailure and a static detail.\n1451|func integrityFailure(detail string) *Error {\n1452|\treturn &Error{Code: CodeIntegrityFailure, Detail: detail}\n1453|}\n1454|\n1455|// UnsignedEvidenceBytes rebuilds the exact bytes an attestation signs: ASCII\n1456|// evidenceSignatureDomain, one zero byte, and the RFC 8785 JCS bytes of the\n1457|// evidence object with exactly evidence_id and attestation_signature\n1458|// omitted (§4.D). Timestamps reuse their validated source spellings so the\n1459|// rebuilt bytes match what the issuer signed.\n1460|func UnsignedEvidenceBytes(evidence Evidence) ([]byte, error) {\n1461|\tobject := map[string]any{\n1462|\t\t\"schema\":                     SchemaCapabilityEvidence,\n1463|\t\t\"schema_version\":             SchemaVersion100,\n1464|\t\t\"terminal_backend_id\":        evidence.TerminalBackendID,\n1465|\t\t\"implementation_version\":     evidence.ImplementationVersion,\n1466|\t\t\"protocol_version\":           evidence.ProtocolVersion,\n1467|\t\t\"backend_generation_digest\":  evidence.BackendGenerationDigest,\n1468|\t\t\"capability\":                 evidence.Capability,\n1469|\t\t\"value\":                      true,\n1470|\t\t\"platform\":                   evidence.Platform.String(),\n1471|\t\t\"os_version\":                 evidence.OSVersion,\n1472|\t\t\"conformance_fixture_id\":     evidence.ConformanceFixtureID,\n1473|\t\t\"observed_at\":                evidence.ObservedAt.String(),\n1474|\t\t\"expires_at\":                 evidence.ExpiresAt.String(),\n1475|\t\t\"issuer\":                     evidence.Issuer,\n1476|\t\t\"issuer_id\":                  evidence.IssuerID,\n1477|\t\t\"facts\":                      stringsToValues(evidence.Facts),\n1478|\t\t\"terminal_binding_id\":        nullableDigest(evidence.TerminalBindingID),\n1479|\t\t\"provider_id\":                nullableString(evidence.ProviderID),\n1480|\t\t\"provider_build\":             nullableString(evidence.ProviderBuild),\n1481|\t\t\"sentinel_result\":            nullableString(evidence.SentinelResult),\n1482|\t\t\"provider_auth_smoke_result\": nullableString(evidence.ProviderAuthSmokeResult),\n1483|\t\t\"extensions\":                 map[string]any{},\n1484|\t}\n1485|\tserialized, err := json.Marshal(object)\n1486|\tif err != nil {\n1487|\t\treturn nil, integrityFailure(\"evidence canonical bytes\")\n1488|\t}\n1489|\tcanonical, err := jcs.Transform(serialized)\n1490|\tif err != nil {\n1491|\t\treturn nil, integrityFailure(\"evidence canonical bytes\")\n1492|\t}\n1493|\tmessage := append([]byte(evidenceSignatureDomain), 0x00)\n1494|\treturn append(message, canonical...), nil\n1495|}\n1496|\n1497|// stringsToValues converts a string list to JSON values.\n1498|func stringsToValues(values []string) []any {\n1499|\tmembers := make([]any, 0, len(values))\n1500|\tfor _, value := range values {\n1501|\t\tmembers = append(members, value)\n1502|\t}\n1503|\treturn members\n1504|}\n1505|\n1506|// nullableDigest renders an empty digest as JSON null.\n1507|func nullableDigest(value string) any {\n1508|\tif value == \"\" {\n1509|\t\treturn nil\n1510|\t}\n1511|\treturn value\n1512|}\n1513|\n1514|// nullableString renders an empty string as JSON null.\n1515|func nullableString(value string) any {\n1516|\tif value == \"\" {\n1517|\t\treturn nil\n1518|\t}\n1519|\treturn value\n1520|}\n1521|\n1522|// Admitted is the reconciled capability set for one Manifest/Probe tuple:\n1523|// every true probe claim with generation-bound, unexpired, signature-valid\n1524|// evidence covering all its requirements. Capabilities holds the sorted\n1525|// admitted true-claim names; EvidenceIDs holds the sorted IDs of the\n1526|// evidence objects that proved them.\n1527|type Admitted struct {\n1528|\tCapabilities []string\n1529|\tEvidenceIDs  []string\n1530|}\n1531|\n1532|// Has reports whether capability is an admitted true claim.\n1533|func (admitted Admitted) Has(capability string) bool {\n1534|\tfor _, member := range admitted.Capabilities {\n1535|\t\tif member == capability {\n1536|\t\t\treturn true\n1537|\t\t}\n1538|\t}\n1539|\treturn false\n1540|}\n1541|\n1542|// HasOperation reports whether any admitted true capability confers the\n1543|// operation through its registry dependent_operations.\n1544|func (admitted Admitted) HasOperation(operation string) bool {\n1545|\tfor _, capability := range admitted.Capabilities {\n1546|\t\trow, known := capabilityRegistry[capability]\n1547|\t\tif !known {\n1548|\t\t\tcontinue\n1549|\t\t}\n1550|\t\tfor _, conferred := range row.dependentOperations {\n1551|\t\t\tif conferred == operation {\n1552|\t\t\t\treturn true\n1553|\t\t\t}\n1554|\t\t}\n1555|\t}\n1556|\treturn false\n1557|}\n1558|\n1559|// CapabilitiesForOperation returns the sorted registry capabilities whose\n1560|// dependent_operations confer the operation. manifest and probe confer\n1561|// through no capability and return an empty set: they carry no capability\n1562|// dependency. An unknown operation is refused: the operation vocabulary is\n1563|// closed.\n1564|func CapabilitiesForOperation(operation string) ([]string, error) {\n1565|\tif !operationVocabulary[operation] {\n1566|\t\treturn nil, mismatchf(\"operation vocabulary\")\n1567|\t}\n1568|\tvar capabilities []string\n1569|\tfor capability, row := range capabilityRegistry {\n1570|\t\tfor _, conferred := range row.dependentOperations {\n1571|\t\t\tif conferred == operation {\n1572|\t\t\t\tcapabilities = append(capabilities, capability)\n1573|\t\t\t\tbreak\n1574|\t\t\t}\n1575|\t\t}\n1576|\t}\n1577|\treturn capabilities, nil\n1578|}\n1579|\n1580|// CheckOperation gates one operation against the admitted set. manifest and\n1581|// probe carry no capability dependency (§4.D): they are admitted for any\n1582|// admitted set, including the empty one. Every other operation must be in\n1583|// the closed vocabulary and conferred by at least one admitted true\n1584|// capability, or it is refused with CodeCapabilityUnproven. Conditional §4.C\n1585|// dependencies (interactivity, credential need, attach overlap, provider\n1586|// observation) are evaluated by the lifecycle owner at the operation call\n1587|// site; this gate proves only the capability-confers-operation half, which\n1588|// is the bound this file owns.\n1589|func CheckOperation(operation string, admitted Admitted) error {\n1590|\tif !operationVocabulary[operation] {\n1591|\t\treturn mismatchf(\"operation vocabulary\")\n1592|\t}\n1593|\tif operation == \"manifest\" || operation == \"probe\" {\n1594|\t\treturn nil\n1595|\t}\n1596|\tif !admitted.HasOperation(operation) {\n1597|\t\treturn &Error{Code: CodeCapabilityUnproven, Detail: \"operation capability dependency\"}\n1598|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
