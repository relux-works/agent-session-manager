", \"CodeDrift\", \"protocol_versions bound\", 1, \"New\", \"\", nil, []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestNewRefusesBadVersionTuples\"}}},\n734|\t{\"terminalbackend.go\", \"validateProtocolVersions\", \"CodeDrift\", \"protocol_versions major 1\", 1, \"RegisterExternal\", \"\", nil, []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestRegisterExternalRefusals\"}}},\n735|\t{\"terminalbackend.go\", \"validateProtocolVersions\", \"CodeDrift\", \"protocol_versions sorted unique\", 1, \"New\", \"\", nil, []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestNewRefusesBadVersionTuples\"}}},\n736|}\n737|\n738|// funneledPlatformDetails is the exact error set validatePlatforms can\n739|// produce, funneled through the single Registration.validate arm below.\n740|// TestPlatformFunnelDetailsAreExactlyThese derives the set from the\n741|// production AST and requires equality, so a fourth platform error is a\n742|// red rather than a silently widened funnel.\n743|var funneledPlatformDetails = []string{\n744|\t\"platforms bound\",\n745|\t\"platforms vocabulary\",\n746|\t\"platforms sorted unique\",\n747|}\n748|\n749|// funneledPlatformArm declares the single dynamic-detail arm. Its tests\n750|// must mention every funneled detail, not just one of them.\n751|var funneledPlatformArm = declaredRefusalArm{\n752|\tfile: \"terminalbackend.go\", function: \"Registration.validate\",\n753|\tcode: \"CodeNotFound\", detail: passthroughDetail, occurrence: 1,\n754|\tentry: \"RegisterExternal\",\n755|\ttests: []refusalTestRef{{file: \"terminalbackend_test.go\", test: \"TestRegisterExternalRefusesPlatformViolations\"}},\n756|}\n757|\n758|// armlessCodes names wire codes with no refusal arm by design.\n759|// CodeUnavailable appears only inside the allowed-error sets; no\n760|// conformance refusal emits it, so it carries no arm of its own.\n761|var armlessCodes = map[string]bool{\n762|\t\"CodeUnavailable\": true,\n763|}\n764|\n765|// plainErrorFunctions names the only production functions allowed to\n766|// construct non-wire errors. validatePlatforms feeds the pinned funnel;\n767|// DigestFile reports I/O failures that must never be wire errors.\n768|var plainErrorFunctions = map[string]bool{\n769|\t\"validatePlatforms\": true,\n770|\t\"DigestFile\":        true,\n771|}\n772|\n773|// TestDerivedRefusalArmsAreAllDeclared is the forward direction: every\n774|// arm the production AST derives resolves to exactly one declared row.\n775|// A brand-new arm with a brand-new detail fails here until its witness\n776|// is recorded.\n777|func TestDerivedRefusalArmsAreAllDeclared(t *testing.T) {\n778|\tt.Parallel()\n779|\n780|\tderived := deriveRefusalArms(t)\n781|\trows := declaredRows()\n782|\tmatched := make([]bool, len(derived))\n783|\tfor _, row := range rows {\n784|\t\tmatches := []int{}\n785|\t\tfor index, arm := range derived {\n786|\t\t\tif armMatchesRow(arm, row) {\n787|\t\t\t\tmatches = append(matches, index)\n788|\t\t\t}\n789|\t\t}\n790|\t\tif len(matches) != 1 {\n791|\t\t\tt.Errorf(\"declared row %s resolves to %d derived arms, want exactly one\",\n792|\t\t\t\tdescribeRow(row), len(matches))\n793|\t\t\tcontinue\n794|\t\t}\n795|\t\tif matched[matches[0]] {\n796|\t\t\tt.Errorf(\"declared row %s claims an arm an earlier row already claimed: %s\",\n797|\t\t\t\tdescribeRow(row), describeArm(derived[matches[0]]))\n798|\t\t\tcontinue\n799|\t\t}\n800|\t\tmatched[matches[0]] = true\n801|\t}\n802|\tfor index, claimed := range matched {\n803|\t\tif !claimed {\n804|\t\t\tt.Errorf(\"derived arm has no declaring row, so nothing witnesses it: %s\",\n805|\t\t\t\tdescribeArm(derived[index]))\n806|\t\t}\n807|\t}\n808|}\n809|\n810|// TestDeclaredRefusalArmsAreAllDerived is the reverse direction: every\n811|// declared row resolves to exactly one derived arm. Without it the\n812|// forward direction passes vacuously on a truncated derivation, and a\n813|// deleted production guard lingers as a row pointing at nothing.\n814|func TestDeclaredRefusalArmsAreAllDerived(t *testing.T) {\n815|\tt.Parallel()\n816|\n817|\tderived := deriveRefusalArms(t)\n818|\tfor _, row := range declaredRows() {\n819|\t\tmatches := 0\n820|\t\tfor _, arm := range derived {\n821|\t\t\tif armMatchesRow(arm, row) {\n822|\t\t\t\tmatches++\n823|\t\t\t}\n824|\t\t}\n825|\t\tif matches != 1 {\n826|\t\t\tt.Errorf(\"declared row %s matches %d derived arms, want exactly one; \"+\n827|\t\t\t\t\"a row without an arm is a witness without a guard\", describeRow(row), matches)\n828|\t\t}\n829|\t}\n830|\tif len(derived) != len(declaredRows()) {\n831|\t\tt.Errorf(\"derived %d arms but declared %d rows; the table is not a bijection\",\n832|\t\t\tlen(derived), len(declaredRows()))\n833|\t}\n834|}\n835|\n836|func armMatchesRow(arm refusalArm, row declaredRefusalArm) bool {\n837|\treturn arm.file == row.file && arm.function == row.function &&\n838|\t\tarm.code == row.code && arm.detail == row.detail &&\n839|\t\tarm.occurrence == row.occurrence\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
