{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6a3","stream":{"kind":"session","id":"01a0b28c-5604-75c0-aae6-73b3ca1e890f"},"sequence":428,"recorded_at":1780531400000851,"record_type":"event","durability":"durable","causation_id":"d8b3c488-a0a9-443b-8e40-610c9c2591de","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d8b3c488-a0a9-443b-8e40-610c9c2591de","run_stream":{"kind":"run","id":"d8b3c488-a0a9-443b-8e40-610c9c2591de"},"call_id":"call_01a0b28dbbba7262a02eb1730ed84067","text":"Read text file `/tmp/kkh1an-rev2/ev/probes/zz_review2_probe_test.go`.\n1|package terminstance\n2|\n3|// Reviewer probes for CR-TASK-260830-kkh1an-2 (RUN-260918-4f5cc1).\n4|// Each probe drives the production entry and records what the candidate\n5|// does. Probes marked CHARACTERIZATION are expected to FAIL on the\n6|// candidate: the failure IS the finding; they pass only when the\n7|// behaviour the pinned section requires is present.\n8|\n9|import (\n10|\t\"errors\"\n11|\t\"os\"\n12|\t\"path/filepath\"\n13|\t\"strings\"\n14|\t\"testing\"\n15|\t\"time\"\n16|\n17|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n18|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n19|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n20|)\n21|\n22|// ---------------------------------------------------------------------\n23|// Probe 1 (CHARACTERIZATION): a receipt without its completion poisons\n24|// the key forever. §4.C request-stop recovery column: \"lost result\n25|// requires status, then same-key retry only if not closed\"; create:\n26|// \"identical retry replays it; uncertainty requires status\"; §13.13\n27|// safe_retry: \"the same logical operation can continue ... after\n28|// reconciling the uncertain external effect\". After status proves the\n29|// SOURCE state (nothing happened), the same-key retry must be able to\n30|// proceed; the candidate refuses terminal_backend_unavailable forever.\n31|// ---------------------------------------------------------------------\n32|\n33|func TestRV2_UncertainKeyIsNeverRecoverableAfterStatus_Quiesce(t *testing.T) {\n34|\tbackend := newMockBackend()\n35|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n36|\tcontext, params, source, admitted := quiesceFixture(t)\n37|\t// The crash seam: receipt durable, no completion (exactly what the\n38|\t// shipped real-kill test leaves behind).\n39|\tif _, _, err := engine.Store.Bind(context.IdempotencyKey, terminalbackend.OperationQuiesceInput, context.OperationID); err != nil {\n40|\t\tt.Fatal(err)\n41|\t}\n42|\t// Step 1: the identical retry refuses and routes to status (as pinned).\n43|\t_, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n44|\trequireRefusal(t, err, \"terminal_backend_unavailable\", \"idempotency result uncertain\")\n45|\t// Step 2: status proves the source state — the input was never closed.\n46|\tbackend.observation = matchingObservation() // state active, matching tuple\n47|\treport, err := engine.ExecuteStatus(contextGo(), exactStatusBody(t), source, testAdmitted(\"durable_disconnect\"))\n48|\tif err != nil {\n49|\t\tt.Fatal(err)\n50|\t}\n51|\trequireLiteral(t, \"status after crash\", string(report.State), \"active\")\n52|\t// Step 3: the same-key retry after status. §4.C says it proceeds\n53|\t// (\"then same-key retry\"); the candidate refuses forever.\n54|\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n55|\tt.Logf(\"CHARACTERIZATION same-key retry after status proved source: err=%v after=%q disposition=%q performed=%v\",\n56|\t\terr, result.After, result.Disposition, backend.performed())\n57|\tif err != nil {\n58|\t\tt.Errorf(\"same-key retry after a status read that proved the source state still refuses: %v (the key is poisoned; no production entry can ever complete this operation)\", err)\n59|\t}\n60|}\n61|\n62|func TestRV2_UncertainKeyIsNeverRecoverableAfterStatus_StopNotClosed(t *testing.T) {\n63|\tbackend := newMockBackend()\n64|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n65|\tcontext, params, source, admitted := stopFixture(t)\n66|\tif _, _, err := engine.Store.Bind(context.IdempotencyKey, terminalbackend.OperationRequestStop, context.OperationID); err != nil {\n67|\t\tt.Fatal(err)\n68|\t}\n69|\t_, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationRequestStop, context, params, source, admitted)\n70|\trequireRefusal(t, err, \"terminal_backend_unavailable\", \"idempotency result uncertain\")\n71|\t// status: still quiescing, wrapper present -> \"not closed\"\n72|\tobserved := matchingObservation()\n73|\tobserved.State = terminalbackend.StateQuiescing\n74|\tbackend.observation = observed\n75|\treport, err := engine.ExecuteStatus(contextGo(), exactStatusBody(t), source, testAdmitted(\"durable_disconnect\"))\n76|\tif err != nil {\n77|\t\tt.Fatal(err)\n78|\t}\n79|\trequireLiteral(t, \"status after lost result\", string(report.State), \"quiescing\")\n80|\t// \"then same-key retry only if not closed\"\n81|\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationRequestStop, context, params, source, admitted)\n82|\tt.Logf(\"CHARACTERIZATION request-stop same-key retry after status=quiescing: err=%v after=%q disposition=%q performed=%v\",\n83|\t\terr, result.After, result.Disposition, backend.performed())\n84|\tif err != nil {\n85|\t\tt.Errorf(\"request-stop same-key retry after status proved not-closed still refuses: %v\", err)\n86|\t}\n87|}\n88|\n89|// The AfterCommit hook-error direction through the ENGINE: store.go\n90|// documents \"a hook error propagates to the caller but the receipt\n91|// stands, so the identical retry replays it\". Through ExecuteMutating\n92|// the identical retry does not replay: it refuses uncertain.\n93|func TestRV2_HookErrorThenIdenticalRetryDoesNotReplayThroughEngine(t *testing.T) {\n94|\tbackend := newMockBackend()\n95|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n96|\tengine.Store.WithHooks(&StoreHooks{AfterCommit: func(string) error { return errTestHook }})\n97|\tcontext, params, source, admitted := quiesceFixture(t)\n98|\tfirst, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n99|\tt.Logf(\"first (hook error): err=%v after=%q disposition=%q\", err, first.After, first.Disposition)\n100|\tengine.Store.WithHooks(nil)\n101|\tsecond, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n102|\tt.Logf(\"CHARACTERIZATION identical retry: err=%v after=%q disposition=%q performed=%v\", err, second.After, second.Disposition, backend.performed())\n103|\tif err != nil {\n104|\t\tt.Errorf(\"identical retry after the hook-error commit refuses (%v); store.go says the identical retry replays it\", err)\n105|\t}\n106|}\n107|\n108|// ---------------------------------------------------------------------\n109|// Probe 2 (CHARACTERIZATION): ObserveFencing under a REMOTE winner at a\n110|// higher epoch does not fence. §13.4: \"If a higher or winning same-epoch\n111|// lease is observed, the wrapper MUST block input, park or terminate its\n112|// stale provider ... and return stale_owner\". §13.3 step 15: the force\n113|// lease \"fences the prior owner logically\". The prior owner is on\n114|// another host: the landed Authorize parks remote_owner before the epoch\n115|// arm, and ObserveFencing keys only on stale_owner.\n116|// ---------------------------------------------------------------------\n117|\n118|func remoteWinnerObservation() fencing.Observation {\n119|\tobservation := fencingObservation()\n120|\t// The winner (epoch 2, lease A) is held by ANOTHER host; the local\n121|\t// host is fixtureHost and holds the stale epoch-1 lease B.\n122|\tobservation.Winner = sessrepo.LeaseSummary{SessionID: fixtureSessionA, LeaseID: fixtureLease, Epoch: 2, HolderHostID: \"0198f4c8-8e50-7f66-8f70-aaaaaaaaaaa2\"}\n123|\tobservation.Grant = sessrepo.FencingGrant{\n124|\t\tSessionID:   fixtureSessionA,\n125|\t\tToken:       sessrepo.FencingToken{Epoch: 1, LeaseID: fixtureLeaseB, HolderHostID: fixtureHost},\n126|\t\tValidatedAt: fixtureNow(),\n127|\t}\n128|\treturn observation\n129|}\n130|\n131|func TestRV2_StaleTokenUnderRemoteWinnerIsNotFenced(t *testing.T) {\n132|\tpresented := fencing.PresentedToken{SessionID: fixtureSessionA, Epoch: 1, LeaseID: fixtureLeaseB}\n133|\tfor _, current := range []terminalbackend.InstanceState{terminalbackend.StateActive, terminalbackend.StateParked, terminalbackend.StateQuiescing} {\n134|\t\tstate, transitioned, err := ObserveFencing(current, presented, remoteWinnerObservation())\n135|\t\treason, winner, parked := fencing.ParkDetails(err)\n136|\t\tt.Logf(\"CHARACTERIZATION current=%s presented=(1,%s) winner=(2,%s,remote host): state=%q transitioned=%v err=%v park=(%q,%q,%v)\",\n137|\t\t\tcurrent, fixtureLeaseB, fixtureLease, state, transitioned, err, reason, winner, parked)\n138|\t\tif !transitioned || state != terminalbackend.StateStaleFenced {\n139|\t\t\tt.Errorf(\"stale epoch-1 incarnation under a remote epoch-2 winner: state=%q transitioned=%v, want stale_fenced (the force takeover from another host is the primary fencing case)\", state, transitioned)\n140|\t\t}\n141|\t}\n142|}\n143|\n144|func TestRV2_SameEpochLosingLeaseUnderRemoteWinnerIsNotFenced(t *testing.T) {\n145|\tpresented := fencing.PresentedToken{SessionID: fixtureSessionA, Epoch: 2, LeaseID: fixtureLeaseB}\n146|\tstate, transitioned, err := ObserveFencing(terminalbackend.StateActive, presented, remoteWinnerObservation())\n147|\treason, _, parked := fencing.ParkDetails(err)\n148|\tt.Logf(\"CHARACTERIZATION same-epoch losing lease under remote winner: state=%q transitioned=%v err=%v park=(%q,%v)\", state, transitioned, err, reason, parked)\n149|\tif !transitioned || state != terminalbackend.StateStaleFenced {\n150|\t\tt.Errorf(\"same-epoch losing lease under a remote winner: state=%q, want stale_fenced\", state)\n151|\t}\n152|}\n153|\n154|// Control for probe 2: the LOCAL-winner stale arms fence (as the\n155|// committed tests pin) — the projection is incomplete, not absent.\n156|func TestRV2_StaleTokenUnderLocalWinnerFences(t *testing.T) {\n157|\tpresented := fencing.PresentedToken{SessionID: fixtureSessionA, Epoch: 1, LeaseID: fixtureLeaseB}\n158|\tstate, transitioned, err := ObserveFencing(terminalbackend.StateActive, presented, fencingObservation())\n159|\tif err != nil || !transitioned || state != terminalbackend.StateStaleFenced {\n160|\t\tt.Fatalf(\"local-winner stale arm: state=%q transitioned=%v err=%v\", state, transitioned, err)\n161|\t}\n162|}\n163|\n164|// ---------------------------------------------------------------------\n165|// Probe 3 (characterization): holder_host_id is parsed and dropped.\n166|// ---------------------------------------------------------------------\n167|\n168|func TestRV2_HolderHostIDIsUnboundAtCheckAuthorization(t *testing.T) {\n169|\traw := authDoc(\"1\", map[string]*string{\"holder_host_id\": strptr(`\"0198f4c8-8e50-7f66-8f70-aaaaaaaaaaa2\"`)})\n170|\tauth, err := ParseAXAuthorization([]byte(raw))\n171|\tif err != nil {\n172|\t\tt.Fatal(err)\n173|\t}\n174|\terr = CheckAuthorization(auth, AuthorizationControl, testLease(), fixtureNow())\n175|\tt.Logf(\"CHARACTERIZATION authorization naming a foreign holder_host_id under the winning (epoch,lease): err=%v (LeaseView carries no holder; §4.C tuple is (epoch, lease_id), so this is a stated-scope observation, not a spec violation)\", err)\n176|}\n177|\n178|// ---------------------------------------------------------------------\n179|// Probe 4 (characterization): ObserveFencing fences from absent and\n180|// stopped: an incarnation that does not exist becomes stale_fenced.\n181|// ---------------------------------------------------------------------\n182|\n183|func TestRV2_ObserveFencingFencesFromAbsentAndStopped(t *testing.T) {\n184|\tpresented := fencing.PresentedToken{SessionID: fixtureSessionA, Epoch: 1, LeaseID: fixtureLeaseB}\n185|\tfor _, current := range []terminalbackend.InstanceState{terminalbackend.StateAbsent, terminalbackend.StateStopped, terminalbackend.StateCreating, terminalbackend.StateUnavailable} {\n186|\t\tstate, transitioned, err := ObserveFencing(current, presented, fencingObservation())\n187|\t\tt.Logf(\"CHARACTERIZATION current=%s: state=%q transitioned=%v err=%v\", current, state, transitioned, err)\n188|\t}\n189|}\n190|\n191|// ---------------------------------------------------------------------\n192|// Probe 5 (characterization): a receipt-store failure BEFORE the link\n193|// (nothing durable, nothing attempted) moves the observation to\n194|// unavailable. §4.C: \"An error before a side effect restores the source\n195|// state.\" Over-strict direction.\n196|// ---------------------------------------------------------------------\n197|\n198|func TestRV2_PreLinkStoreFailureMovesToUnavailable(t *testing.T) {\n199|\tbackend := newMockBackend()\n200|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n201|\tpending := filepath.Join(engine.Store.base, \"pending\")\n202|\tif err := os.Chmod(pending, 0o500); err != nil {\n203|\t\tt.Fatal(err)\n204|\t}\n205|\tt.Cleanup(func() { _ = os.Chmod(pending, 0o755) })\n206|\tcontext, params, source, admitted := quiesceFixture(t)\n207|\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n208|\tt.Logf(\"CHARACTERIZATION stage failure before any link: err=%v after=%q disposition=%q performed=%v\", err, result.After, result.Disposition, backend.performed())\n209|\tif len(backend.performed()) != 0 {\n210|\t\tt.Fatalf(\"performed %v, want nothing\", backend.performed())\n211|\t}\n212|\t_ = os.Chmod(pending, 0o755)\n213|\tif _, found, _ := engine.Store.Lookup(context.IdempotencyKey); found {\n214|\t\tt.Fatalf(\"a receipt was linked despite the read-only directory\")\n215|\t}\n216|\tif result.After != source {\n217|\t\tt.Errorf(\"after=%q for an error before any receipt and any side effect, spec: restores the source state (%q)\", result.After, source)\n218|\t}\n219|}\n220|\n221|// ---------------------------------------------------------------------\n222|// Probe 6 (characterization): the replay is reachable only from the\n223|// ORIGINAL source: an identical retry presented from the post-transition\n224|// state refuses local_precondition_failed before the receipt is read.\n225|// ---------------------------------------------------------------------\n226|\n227|func TestRV2_ReplayRequiresOriginalSource(t *testing.T) {\n228|\tbackend := newMockBackend()\n229|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n230|\tcontext, params, source, admitted := quiesceFixture(t)\n231|\tif _, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted); err != nil {\n232|\t\tt.Fatal(err)\n233|\t}\n234|\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, terminalbackend.StateQuiescing, admitted)\n235|\tt.Logf(\"CHARACTERIZATION identical retry from the post-transition source: err=%v after=%q disposition=%q\", err, result.After, result.Disposition)\n236|}\n237|\n238|// ---------------------------------------------------------------------\n239|// Probe 7: generation bound in the landed Provider Protocol 3 descriptor\n240|// (cited landed by the producer): witness 0 / 256 / 257 myself.\n241|// ---------------------------------------------------------------------\n242|\n243|func TestRV2_DescriptorGenerationBoundLanded(t *testing.T) {\n244|\tfor _, tc := range []struct {\n245|\t\tn    int\n246|\t\twant bool\n247|\t}{{0, false}, {1, true}, {256, true}, {257, false}} {\n248|\t\t_, err := terminalbackend.GenerationDigest(strings.Repeat(\"g\", tc.n))\n249|\t\tif (err == nil) != tc.want {\n250|\t\t\tt.Errorf(\"GenerationDigest(len %d) err=%v want admit=%v\", tc.n, err, tc.want)\n251|\t\t}\n252|\t\tif err != nil && ErrorCode(err) != \"terminal_backend_stale_generation\" {\n253|\t\t\tt.Errorf(\"GenerationDigest(len %d) code=%q\", tc.n, ErrorCode(err))\n254|\t\t}\n255|\t}\n256|\t// multibyte: 256 runes of 2 bytes each = 512 bytes must admit (chars, not bytes)\n257|\tif _, err := terminalbackend.GenerationDigest(strings.Repeat(\"é\", 256)); err != nil {\n258|\t\tt.Errorf(\"256 multibyte runes refused: %v\", err)\n259|\t}\n260|\t// and the same corpus through the context document surface\n261|\tfor _, tc := range []struct {\n262|\t\tn    int\n263|\t\twant bool\n264|\t}{{0, false}, {256, true}, {257, false}} {\n265|\t\tkey := fixtureInstance + \"/quiesce/\" + fixtureQuiescence\n266|\t\traw := contextDoc(fixtureOperation, fixtureSessionA, fixtureInstance, fixtureBackend, fixtureImpl, fixtureProto, strings.Repeat(\"é\", tc.n), key, fixtureDeadline, authDoc(\"1\", nil))\n267|\t\t_, err := ParseMutationContext([]byte(raw))\n268|\t\tif (err == nil) != tc.want {\n269|\t\t\tt.Errorf(\"ParseMutationContext(generation %d multibyte runes) err=%v want admit=%v\", tc.n, err, tc.want)\n270|\t\t}\n271|\t\tif err != nil {\n272|\t\t\trequireRefusal(t, err, \"terminal_backend_stale_generation\", \"backend_generation bound\")\n273|\t\t}\n274|\t\trawStatus := statusDoc(`\"`+fixtureInstance+`\"`, `\"`+strings.Repeat(\"é\", tc.n)+`\"`)\n275|\t\t_, err = ParseStatusBody([]byte(rawStatus))\n276|\t\tif (err == nil) != tc.want {\n277|\t\t\tt.Errorf(\"ParseStatusBody(generation %d multibyte runes) err=%v want admit=%v\", tc.n, err, tc.want)\n278|\t\t}\n279|\t}\n280|}\n281|\n282|// ---------------------------------------------------------------------\n283|// Probe 8: the AXAuthorization epoch bound witnessed myself at the four\n284|// values through the nested MutationContext surface as well.\n285|// ---------------------------------------------------------------------\n286|\n287|func TestRV2_EpochBoundThroughNestedContext(t *testing.T) {\n288|\tkey := fixtureInstance + \"/quiesce/\" + fixtureQuiescence\n289|\tfor _, tc := range []struct {\n290|\t\tepoch string\n291|\t\twant  bool\n292|\t}{{\"1\", true}, {\"9007199254740991\", true}, {\"0\", false}, {\"9007199254740992\", false}} {\n293|\t\traw := contextDoc(fixtureOperation, fixtureSessionA, fixtureInstance, fixtureBackend, fixtureImpl, fixtureProto, fixtureGen, key, fixtureDeadline, authDoc(tc.epoch, nil))\n294|\t\t_, err := ParseMutationContext([]byte(raw))\n295|\t\tif (err == nil) != tc.want {\n296|\t\t\tt.Errorf(\"nested epoch %s: err=%v want admit=%v\", tc.epoch, err, tc.want)\n297|\t\t}\n298|\t\tif err != nil {\n299|\t\t\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"ax authorization epoch\")\n300|\t\t}\n301|\t}\n302|}\n303|\n304|// ---------------------------------------------------------------------\n305|// Probe 9: the retry disposition on EVERY engine result path parses as\n306|// one of the four literal tokens (success, entry refusals, pre-commit,\n307|// post-commit, replay, uncertain).\n308|// ---------------------------------------------------------------------\n309|\n310|func TestRV2_EveryResultCarriesExactlyOneLiteralDisposition(t *testing.T) {\n311|\tliteral := map[string]bool{\"replay_same\": true, \"status_first\": true, \"new_authorization\": true, \"required_operator_action\": true}\n312|\tcheck := func(name string, result Result, err error) {\n313|\t\tt.Helper()\n314|\t\tif !literal[string(result.Disposition)] {\n315|\t\t\tt.Errorf(\"%s: disposition %q is not one of the four literals (err=%v)\", name, result.Disposition, err)\n316|\t\t}\n317|\t}\n318|\t// success\n319|\tbackend := newMockBackend()\n320|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n321|\tcontext, params, source, admitted := quiesceFixture(t)\n322|\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n323|\tcheck(\"success\", result, err)\n324|\t// replay\n325|\tresult, err = engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n326|\tcheck(\"replay\", result, err)\n327|\t// stale generation entry\n328|\tengineStale := testEngine(t, newMockBackend(), testLease(), \"other\")\n329|\tresult, err = engineStale.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n330|\tcheck(\"stale entry\", result, err)\n331|\t// uncertain\n332|\tengineU := testEngine(t, newMockBackend(), testLease(), fixtureGen)\n333|\t_, _, _ = engineU.Store.Bind(context.IdempotencyKey, terminalbackend.OperationQuiesceInput, context.OperationID)\n334|\tresult, err = engineU.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n335|\tcheck(\"uncertain\", result, err)\n336|\t// uncoded effect failure\n337|\tbackendU := newMockBackend()\n338|\tbackendU.effectErrors[terminalbackend.EffectInputClosed] = errors.New(\"boom\")\n339|\tengineE := testEngine(t, backendU, testLease(), fixtureGen)\n340|\tresult, err = engineE.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n341|\tcheck(\"uncoded\", result, err)\n342|\t// deadline at entry\n343|\tengineD := testEngine(t, newMockBackend(), testLease(), fixtureGen)\n344|\tengineD.Now = fixturePastDeadline\n345|\tresult, err = engineD.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n346|\tcheck(\"deadline\", result, err)\n347|}\n348|\n349|// ---------------------------------------------------------------------\n350|// Probe 10: the deadline INSTANT itself. The engine refuses at\n351|// now == deadline (not Before). Recorded for the mutant plant RV2-M-deadline.\n352|// ---------------------------------------------------------------------\n353|\n354|func TestRV2_DeadlineInstantRefusesAtEntry(t *testing.T) {\n355|\tbackend := newMockBackend()\n356|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n357|\tdeadline, _ := time.Parse(time.RFC3339Nano, fixtureDeadline)\n358|\tengine.Now = func() time.Time { return deadline }\n359|\tcontext, params, source, admitted := quiesceFixture(t)\n360|\t_, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n361|\trequireRefusal(t, err, \"terminal_backend_timeout\", \"operation deadline\")\n362|\tbackendS := newMockBackend()\n363|\tbackendS.observation = matchingObservation()\n364|\tengineS := testEngine(t, backendS, testLease(), fixtureGen)\n365|\tengineS.Now = func() time.Time { return deadline }\n366|\t_, err = engineS.ExecuteStatus(contextGo(), exactStatusBody(t), source, testAdmitted(\"durable_disconnect\"))\n367|\trequireRefusal(t, err, \"terminal_backend_timeout\", \"operation deadline\")\n368|}\n369|\n370|// ---------------------------------------------------------------------\n371|// Probe 11: identity_match is a six-way conjunction: drift on EACH axis\n372|// alone (instance, backend, implementation, protocol, generation) with\n373|// the canonical absent form must read as a proven non-match, and a\n374|// lying match on each axis must refuse. Recorded for the RV2-M-status-*\n375|// plants.\n376|// ---------------------------------------------------------------------\n377|\n378|func TestRV2_StatusIdentityMatchEachAxis(t *testing.T) {\n379|\taxes := map[string]func(*StatusObservation){\n380|\t\t\"instance\":       func(o *StatusObservation) { o.InstanceID = \"0198f4c8-8e50-7f66-8f70-bbbbbbbbbbb2\" },\n381|\t\t\"backend\":        func(o *StatusObservation) { o.BackendID = \"other.backend\" },\n382|\t\t\"implementation\": func(o *StatusObservation) { o.ImplVersion = \"1.2.4\" },\n383|\t\t\"protocol\":       func(o *StatusObservation) { o.ProtoVersion = \"1.0.1\" },\n384|\t\t\"generation\":     func(o *StatusObservation) { o.Generation = \"generation-two\" },\n385|\t}\n386|\tfor name, drift := range axes {\n387|\t\tt.Run(name+\"/canonical non-match admits\", func(t *testing.T) {\n388|\t\t\tbackend := newMockBackend()\n389|\t\t\tobserved := StatusObservation{State: terminalbackend.StateAbsent, IdentityMatch: false, SessionID: fixtureSessionA, InstanceID: fixtureInstance, BackendID: fixtureBackend, ImplVersion: fixtureImpl, ProtoVersion: fixtureProto, Generation: fixtureGen}\n390|\t\t\tdrift(&observed)\n391|\t\t\tbackend.observation = observed\n392|\t\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n393|\t\t\treport, err := engine.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n394|\t\t\tif err != nil {\n395|\t\t\t\tt.Fatalf(\"drift on %s with the canonical absent form: %v, want a proven non-match\", name, err)\n396|\t\t\t}\n397|\t\t\trequireLiteral(t, \"state\", string(report.State), \"absent\")\n398|\t\t})\n399|\t\tt.Run(name+\"/lying match refuses\", func(t *testing.T) {\n400|\t\t\tbackend := newMockBackend()\n401|\t\t\tobserved := matchingObservation()\n402|\t\t\tdrift(&observed)\n403|\t\t\tbackend.observation = observed\n404|\t\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n405|\t\t\t_, err := engine.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n406|\t\t\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"status identity binding\")\n407|\t\t})\n408|\t}\n409|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
