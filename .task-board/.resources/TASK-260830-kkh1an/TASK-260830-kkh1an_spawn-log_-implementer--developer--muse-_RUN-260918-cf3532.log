{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7e5","stream":{"kind":"session","id":"01a0b28c-5604-75c0-aae6-73b3ca1e890f"},"sequence":589,"recorded_at":1780531400001173,"record_type":"event","durability":"durable","causation_id":"d8b3c488-a0a9-443b-8e40-610c9c2591de","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"d8b3c488-a0a9-443b-8e40-610c9c2591de","run_stream":{"kind":"run","id":"d8b3c488-a0a9-443b-8e40-610c9c2591de"},"call_id":"call_01a0b28e2864742786ace1e25f094a67","text":"{\n  \"chunk_id\": \"exec-15-1\",\n  \"command\": \"ls internal/fencing/ internal/terminalbackend/; echo ===; grep -n \\\"func Authorize\\\" -A 80 internal/fencing/gate.go | head -120\",\n  \"description\": \"Read landed fencing Authorize gate\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"internal/fencing/:\\ncensus_test.go\\ncodes_test.go\\ndoc.go\\nfixtures_test.go\\ngate_test.go\\ngate.go\\nownership_properties_test.go\\nscenarios_test.go\\nterminate_test.go\\nterminate.go\\ntestdata\\ntoken_test.go\\ntoken.go\\nTRACEABILITY.md\\n\\ninternal/terminalbackend/:\\nbackend_id_entry_census_test.go\\nconformance_test.go\\nconformance.go\\ndescriptor_test.go\\ndescriptor.go\\ndigit_guard_census_test.go\\nidentity_ownership_test.go\\ninternal_pin_test.go\\nmanifest_pin_test.go\\nmanifest_test.go\\nmanifest.go\\nrefusal_arm_inventory_test.go\\nrefusal_arm_witnesses_test.go\\nrefusal_site_audit_test.go\\nsemver_major_edge_test.go\\nterminalbackend_test.go\\nterminalbackend_unix_test.go\\nterminalbackend.go\\n===\\n251:func AuthorizeActivation(presented PresentedToken, observation Observation) (LeaseToken, error) {\\n252-\\treturn Authorize(OperationActivation, presented, observation)\\n253-}\\n254-\\n255-// AuthorizeInput gates provider input after attach through the fencing\\n256-// core.\\n257:func AuthorizeInput(presented PresentedToken, observation Observation) (LeaseToken, error) {\\n258-\\treturn Authorize(OperationInput, presented, observation)\\n259-}\\n260-\\n261-// AuthorizeMutation gates owner-authored mutation through the fencing\\n262-// core.\\n263:func AuthorizeMutation(presented PresentedToken, observation Observation) (LeaseToken, error) {\\n264-\\treturn Authorize(OperationMutation, presented, observation)\\n265-}\\n266-\\n267-// AuthorizeCheckpoint gates checkpoint capture admission through the\\n268-// fencing core.\\n269:func AuthorizeCheckpoint(presented PresentedToken, observation Observation) (LeaseToken, error) {\\n270-\\treturn Authorize(OperationCheckpoint, presented, observation)\\n271-}\\n272-\\n273-// AuthorizeRestore gates terminal restore and the wrapper's first\\n274-// start through the fencing core.\\n275:func AuthorizeRestore(presented PresentedToken, observation Observation) (LeaseToken, error) {\\n276-\\treturn Authorize(OperationRestore, presented, observation)\\n277-}\\n278-\\n279-// Authorize is the fencing core: every activation-class action passes\\n280-// here. The presented token must name this session and equal the\\n281-// winning (epoch, lease_id) tuple exactly; the fencing grant must be\\n282-// present and unexpired; ownership must be verified, unambiguous, and\\n283-// local. Launch-class entries (activation, restore) park with the\\n284-// session.parked vocabulary when ownership is remote, ambiguous,\\n285-// unverified, or absent; every other entry refuses outright. A passed\\n286-// gate mints the sealed LeaseToken the provider operations bind; a\\n287-// failed gate refuses with a Section 15 registered code and mints\\n288-// nothing.\\n289-//\\n290-// Arm order is precedence: malformed calls die first, then foreign\\n291-// sessions, then ownership presence and verifiability, then the\\n292-// fencing grant, then ownership direction (the operative fact beats\\n293-// the credential: a stale token under a remote winner parks remote,\\n294-// it does not report stale), then the exact tuple match.\\n295:func Authorize(operation Operation, presented PresentedToken, observation Observation) (LeaseToken, error) {\\n296-\\tif !validOperation(operation) {\\n297-\\t\\treturn LeaseToken{}, refuse(ErrInvalidArguments, \\\"unknown fencing operation %q\\\", string(operation))\\n298-\\t}\\n299-\\tif _, err := scalar.ParseUUIDv7(presented.SessionID); err != nil {\\n300-\\t\\treturn LeaseToken{}, refuse(ErrInvalidArguments, \\\"presented fencing token session %q is not a UUIDv7: %v\\\", presented.SessionID, err)\\n301-\\t}\\n302-\\tif presented.Epoch == 0 {\\n303-\\t\\treturn LeaseToken{}, refuse(ErrInvalidArguments, \\\"presented fencing token carries epoch 0, want an epoch at or above 1\\\")\\n304-\\t}\\n305-\\tif _, err := scalar.ParseUUIDv4(presented.LeaseID); err != nil {\\n306-\\t\\treturn LeaseToken{}, refuse(ErrInvalidArguments, \\\"presented fencing token lease %q is not a UUIDv4: %v\\\", presented.LeaseID, err)\\n307-\\t}\\n308-\\tif presented.SessionID != observation.SessionID {\\n309-\\t\\treturn LeaseToken{}, refuse(ErrLeaseConflict, \\\"presented fencing token for session %s does not authorize session %s\\\", presented.SessionID, observation.SessionID)\\n310-\\t}\\n311-\\tif !observation.HasWinner {\\n312-\\t\\tif launchClass(operation) {\\n313-\\t\\t\\treturn LeaseToken{}, park(ParkRestorePolicy, \\\"\\\", ErrLeaseConflict)\\n314-\\t\\t}\\n315-\\t\\treturn LeaseToken{}, refuse(ErrLeaseConflict, \\\"no winning lease is established for session %s\\\", observation.SessionID)\\n316-\\t}\\n317-\\tif observation.Winner.Epoch == 0 || !validLeaseID(observation.Winner.LeaseID) || !validHostID(observation.Winner.HolderHostID) {\\n318-\\t\\treturn LeaseToken{}, refuse(ErrInvalidArguments, \\\"fencing observation for session %s carries no well-formed winning lease\\\", observation.SessionID)\\n319-\\t}\\n320-\\tif !observation.Verified {\\n321-\\t\\tif launchClass(operation) {\\n322-\\t\\t\\treturn LeaseToken{}, park(ParkRestorePolicy, observation.Winner.LeaseID, ErrLeaseConflict)\\n323-\\t\\t}\\n324-\\t\\treturn LeaseToken{}, refuse(ErrLeaseConflict, \\\"ownership of session %s is unverified; refresh lease knowledge first\\\", observation.SessionID)\\n325-\\t}\\n326-\\tif observation.Ambiguous {\\n327-\\t\\tif launchClass(operation) {\\n328-\\t\\t\\treturn LeaseToken{}, park(ParkRestorePolicy, observation.Winner.LeaseID, ErrLeaseConflict)\\n329-\\t\\t}\\n330-\\t\\treturn LeaseToken{}, refuse(ErrLeaseConflict, \\\"ownership of session %s is ambiguous; resolve the union rival first\\\", observation.SessionID)\\n331-\\t}\\n332-\\tif observation.HandoffFailed {\\n333-\\t\\tif launchClass(operation) {\\n334-\\t\\t\\treturn LeaseToken{}, park(ParkFailedHandoff, observation.Winner.LeaseID, ErrLeaseConflict)\\n335-\\t\\t}\\n336-\\t\\treturn LeaseToken{}, refuse(ErrLeaseConflict, \\\"handoff for session %s already failed; a losing lease must never activate\\\", observation.SessionID)\\n337-\\t}\\n338-\\tif !observation.HasGrant {\\n339-\\t\\treturn LeaseToken{}, refuse(ErrInvalidArguments, \\\"fencing observation for session %s carries no grant; validate the winning token first\\\", observation.SessionID)\\n340-\\t}\\n341-\\tif observation.Now.IsZero() {\\n342-\\t\\treturn LeaseToken{}, refuse(ErrInvalidArguments, \\\"fencing observation for session %s carries no clock reading; expiry cannot be checked\\\", observation.SessionID)\\n343-\\t}\\n344-\\tif err := sessrepo.CheckFencingExpiry(observation.Grant, observation.Policy, observation.Now); err != nil {\\n345-\\t\\tif errors.Is(err, sessrepo.ErrFencingExpired) {\\n346-\\t\\t\\treturn LeaseToken{}, refuse(ErrLeaseConflict, \\\"fencing grant for session %s lapsed; revalidate the winning token\\\", observation.SessionID)\\n347-\\t\\t}\\n348-\\t\\treturn LeaseToken{}, refuse(ErrInvalidArguments, \\\"fencing observation for session %s carries an unusable refresh policy\\\", observation.SessionID)\\n349-\\t}\\n350-\\tif observation.Winner.HolderHostID != observation.LocalHostID {\\n351-\\t\\tif launchClass(operation) {\\n352-\\t\\t\\treturn LeaseToken{}, park(ParkRemoteOwner, observation.Winner.LeaseID, ErrNotOwner)\\n353-\\t\\t}\\n354-\\t\\treturn LeaseToken{}, refuse(ErrNotOwner, \\\"session %s is owned by remote host %s\\\", observation.SessionID, observation.Winner.HolderHostID)\\n355-\\t}\\n356-\\tepochsEqual := presented.Epoch == observation.Winner.Epoch\\n357-\\tif !epochsEqual {\\n358-\\t\\tif presented.Epoch < observation.Winner.Epoch {\\n359-\\t\\t\\tif launchClass(operation) {\\n360-\\t\\t\\t\\treturn LeaseToken{}, park(ParkStaleOwner, observation.Winner.LeaseID, ErrStaleOwner)\\n361-\\t\\t\\t}\\n362-\\t\\t\\treturn LeaseToken{}, refuse(ErrStaleOwner, \\\"presented epoch %d precedes winning epoch %d for session %s\\\", presented.Epoch, observation.Winner.Epoch, observation.SessionID)\\n363-\\t\\t}\\n364-\\t\\tif launchClass(operation) {\\n365-\\t\\t\\treturn LeaseToken{}, park(ParkRestorePolicy, observation.Winner.LeaseID, ErrLeaseConflict)\\n366-\\t\\t}\\n367-\\t\\treturn LeaseToken{}, refuse(ErrLeaseConflict, \\\"presented epoch %d names no known lease for session %s\\\", presented.Epoch, observation.SessionID)\\n368-\\t}\\n369-\\tif presented.LeaseID != observation.Winner.LeaseID {\\n370-\\t\\tif launchClass(operation) {\\n\",\n  \"original_output_bytes\": 7697,\n  \"original_output_tokens\": 1925,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
