{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cbdd","stream":{"kind":"session","id":"01a0b291-18f0-70a0-900f-0c92cf0433eb"},"sequence":1097,"recorded_at":1780531400002189,"record_type":"event","durability":"durable","causation_id":"cb7c4ff2-7892-4304-8de0-3769502303db","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cb7c4ff2-7892-4304-8de0-3769502303db","run_stream":{"kind":"run","id":"cb7c4ff2-7892-4304-8de0-3769502303db"},"task_stream":{"kind":"task","id":"01a0b298-7e28-70d0-a128-a0094707016c"},"task_id":"01a0b298-7e28-70d0-a128-a0094707016c","event":{"kind":"output","task_id":"01a0b298-7e28-70d0-a128-a0094707016c","chunk":"Read text file `internal/terminstance/lifecycle_test.go`.\n(119 line(s) above)\n120|}\n121|\n122|// TestExecuteIdenticalRetryReplays proves the idempotency window through\n123|// the production entry: the identical retry returns the recorded result\n124|// and performs no new effect.\n125|func TestExecuteIdenticalRetryReplays(t *testing.T) {\n126|\tbackend := newMockBackend()\n127|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n128|\tcontext, params, source, admitted := quiesceFixture(t)\n129|\tfirst, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n130|\tif err != nil {\n131|\t\tt.Fatalf(\"ExecuteMutating() error = %v\", err)\n132|\t}\n133|\tsecond, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n134|\tif err != nil {\n135|\t\tt.Fatalf(\"ExecuteMutating() retry error = %v\", err)\n136|\t}\n137|\tif len(backend.performed()) != 1 {\n138|\t\tt.Errorf(\"performed = %v, want exactly the first-run effect\", backend.performed())\n139|\t}\n140|\trequireLiteral(t, \"replay after\", string(second.After), string(first.After))\n141|\trequireLiteral(t, \"replay disposition\", string(second.Disposition), string(first.Disposition))\n142|\tif len(second.Effects) != len(first.Effects) || len(second.EvidenceIDs) != len(first.EvidenceIDs) {\n143|\t\tt.Errorf(\"replay = %+v, want %+v\", second, first)\n144|\t}\n145|}\n146|\n147|// TestExecuteChangedOperationInWindowMismatches proves a changed\n148|// operation reusing an established key is idempotency_mismatch through\n149|// the production entry: same key material, different operation ID.\n150|func TestExecuteChangedOperationInWindowMismatches(t *testing.T) {\n151|\tbackend := newMockBackend()\n152|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n153|\tcontext, params, source, admitted := quiesceFixture(t)\n154|\tif _, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted); err != nil {\n155|\t\tt.Fatalf(\"ExecuteMutating() error = %v\", err)\n156|\t}\n157|\tchanged := context\n158|\tchanged.OperationID = fixtureOperationB\n159|\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, changed, params, source, admitted)\n160|\trequireRefusal(t, err, \"idempotency_mismatch\", \"idempotency key conflict\")\n161|\trequireLiteral(t, \"after\", string(result.After), \"active\")\n162|\trequireLiteral(t, \"disposition\", string(result.Disposition), \"status_first\")\n163|\tif len(backend.performed()) != 1 {\n164|\t\tt.Errorf(\"performed = %v, want no new effect on the mismatch\", backend.performed())\n165|\t}\n166|}\n167|\n168|// TestExecuteUncertainRetryRequiresStatus proves a bound key without its\n169|// completion refuses the identical retry with unavailable and\n170|// status_first: the interrupted attempt proves nothing, so only status\n171|// recovers the observation.\n172|func TestExecuteUncertainRetryRequiresStatus(t *testing.T) {\n173|\tbackend := newMockBackend()\n174|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n175|\tcontext, params, source, admitted := quiesceFixture(t)\n176|\tif _, _, err := engine.Store.Bind(context.IdempotencyKey, terminalbackend.OperationQuiesceInput, context.OperationID); err != nil {\n177|\t\tt.Fatalf(\"Bind() error = %v\", err)\n178|\t}\n179|\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n180|\trequireRefusal(t, err, \"terminal_backend_unavailable\", \"idempotency result uncertain\")\n181|\trequireLiteral(t, \"after\", string(result.After), \"unavailable\")\n182|\trequireLiteral(t, \"disposition\", string(result.Disposition), \"status_first\")\n183|\tif len(backend.performed()) != 0 {\n184|\t\tt.Errorf(\"performed = %v, want no effects on the uncertain retry\", backend.performed())\n185|\t}\n186|}\n187|\n188|// TestExecuteEmptyAdmittedRefusesAtLandedGate proves the engine wires\n189|// the landed capability conferral: every mutating row with no admitted\n190|// capability refuses through CheckOperation before any conditional,\n191|// receipt or effect.\n192|func TestExecuteEmptyAdmittedRefusesAtLandedGate(t *testing.T) {\n193|\tquiesceContext, quiesceParams, quiesceSource, _ := quiesceFixture(t)\n194|\twaitContext, waitParams, waitSource, _ := waitFixture(t, ProofAXCheckpointBoundary)\n195|\tstopContext, stopParams, stopSource, _ := stopFixture(t)\n196|\tcreate := testCreateContext(t)\n197|\trows := []struct {\n198|\t\toperation terminalbackend.Operation\n199|\t\tcontext   MutationContext\n200|\t\tparams    Params\n201|\t\tsource    terminalbackend.InstanceState\n202|\t}{\n203|\t\t{terminalbackend.OperationQuiesceInput, quiesceContext, quiesceParams, quiesceSource},\n204|\t\t{terminalbackend.OperationWaitSafeBoundary, waitContext, waitParams, waitSource},\n205|\t\t{terminalbackend.OperationRequestStop, stopContext, stopParams, stopSource},\n206|\t\t{terminalbackend.OperationCreate, create.context, create.params, mustParseState(t, \"absent\")},\n207|\t}\n208|\tfor _, row := range rows {\n209|\t\tt.Run(string(row.operation), func(t *testing.T) {\n210|\t\t\tbackend := newMockBackend()\n211|\t\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n212|\t\t\tresult, err := engine.ExecuteMutating(contextGo(), row.operation, row.context, row.params, row.source, testAdmitted())\n213|\t\t\trequireRefusal(t, err, \"terminal_backend_capability_unproven\", \"operation capability dependency\")\n214|\t\t\trequireLiteral(t, \"after\", string(result.After), string(row.source))\n215|\t\t\tif len(backend.performed()) != 0 {\n216|\t\t\t\tt.Errorf(\"performed = %v, want no effects\", backend.performed())\n217|\t\t\t}\n218|\t\t})\n219|\t}\n220|}\n221|\n222|// TestExecuteScopeGate proves operations outside the engine rows are\n223|// refused at the production entry with an empty result.\n224|func TestExecuteScopeGate(t *testing.T) {\n225|\tbackend := newMockBackend()\n226|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n227|\tcontext, params, source, admitted := quiesceFixture(t)\n228|\tfor _, operation := range []terminalbackend.Operation{\n229|\t\tterminalbackend.OperationStatus, terminalbackend.OperationAttach,\n230|\t\tterminalbackend.OperationRestore, terminalbackend.OperationTerminateStale,\n231|\t\tterminalbackend.OperationManifest, terminalbackend.OperationProbe,\n232|\t} {\n233|\t\tresult, err := engine.ExecuteMutating(contextGo(), operation, context, params, source, admitted)\n234|\t\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"operation lifecycle scope\")\n235|\t\tif !reflect.DeepEqual(result, Result{}) {\n236|\t\t\tt.Errorf(\"ExecuteMutating(%s) result = %+v, want empty on the scope refusal\", operation, result)\n237|\t\t}\n238|\t}\n239|}\n(more lines below)","final_result":true}}}
