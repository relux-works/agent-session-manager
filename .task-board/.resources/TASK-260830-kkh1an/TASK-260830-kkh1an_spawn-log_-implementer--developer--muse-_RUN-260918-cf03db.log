{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cee7","stream":{"kind":"session","id":"01a0b291-18f0-70a0-900f-0c92cf0433eb"},"sequence":1486,"recorded_at":1780531400002967,"record_type":"event","durability":"durable","causation_id":"cb7c4ff2-7892-4304-8de0-3769502303db","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cb7c4ff2-7892-4304-8de0-3769502303db","run_stream":{"kind":"run","id":"cb7c4ff2-7892-4304-8de0-3769502303db"},"task_stream":{"kind":"task","id":"01a0b29e-4450-7313-9cba-9bf5fc0f5e20"},"task_id":"01a0b29e-4450-7313-9cba-9bf5fc0f5e20","event":{"kind":"output","task_id":"01a0b29e-4450-7313-9cba-9bf5fc0f5e20","chunk":"edited\nchanged lines: lines 104-119\n--- original\n+++ updated\n@@\n-// kindFor maps an engine operation to its AXAuthorization kind. The\n-// force_stale and restore kinds parse but no engine operation requests\n-// them: terminate-stale and restore recovery belongs to the story's\n-// final leaf.\n-func kindFor(operation terminalbackend.Operation) (AuthorizationKind, bool) {\n-\tswitch operation {\n-\tcase terminalbackend.OperationCreate:\n-\t\treturn AuthorizationCreate, true\n-\tcase terminalbackend.OperationQuiesceInput,\n-\t\tterminalbackend.OperationWaitSafeBoundary,\n-\t\tterminalbackend.OperationRequestStop:\n-\t\treturn AuthorizationControl, true\n-\tdefault:\n-\t\treturn \"\", false\n-\t}\n-}\n+// kindFor maps an engine operation to its AXAuthorization kind through the\n+// landed transition-table authorization column: the table names the kind\n+// and this function honors only the two the engine executes (create,\n+// control). The force_stale and restore kinds parse but no engine\n+// operation requests them — terminate-stale and restore recovery belongs\n+// to the story's final leaf — and attach and none are never\n+// AXAuthorization kinds. A drift between the table and this mapping fails\n+// TestKindForAgreesWithLandedTable; no second table is restated here.\n+func kindFor(operation terminalbackend.Operation) (AuthorizationKind, bool) {\n+\tlanded, err := terminalbackend.TransitionAuthorization(string(operation))\n+\tif err != nil {\n+\t\treturn \"\", false\n+\t}\n+\tswitch AuthorizationKind(landed) {\n+\tcase AuthorizationCreate:\n+\t\treturn AuthorizationCreate, true\n+\tcase AuthorizationControl:\n+\t\treturn AuthorizationControl, true\n+\tdefault:\n+\t\treturn \"\", false\n+\t}\n+}\n","final_result":true}}}
