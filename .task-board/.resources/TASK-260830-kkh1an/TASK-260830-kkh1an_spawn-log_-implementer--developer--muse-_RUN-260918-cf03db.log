{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c735","stream":{"kind":"session","id":"01a0b291-18f0-70a0-900f-0c92cf0433eb"},"sequence":501,"recorded_at":1780531400000997,"record_type":"event","durability":"durable","causation_id":"cb7c4ff2-7892-4304-8de0-3769502303db","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cb7c4ff2-7892-4304-8de0-3769502303db","run_stream":{"kind":"run","id":"cb7c4ff2-7892-4304-8de0-3769502303db"},"task_stream":{"kind":"task","id":"01a0b292-8235-7762-b0dd-55d9b21f9441"},"task_id":"01a0b292-8235-7762-b0dd-55d9b21f9441","event":{"kind":"output","task_id":"01a0b292-8235-7762-b0dd-55d9b21f9441","chunk":"Read text file `/tmp/rv2ev/probes/review2_mutants.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Reviewer narrowing mutants for CR-TASK-260830-kkh1an-2 (RUN-260918-4f5cc1).\n3|\n4|Killer: the WHOLE committed internal/terminstance suite (not a scoped\n5|-run), so a SURVIVED verdict means no committed test observes the\n6|narrowing. Each row is M (patch one production file in place), R (go\n7|test ./internal/terminstance -count=1), V (KILLED iff the run fails with\n8|a test failure line; SURVIVED iff exit 0; ERROR otherwise), restore.\n9|Raw per-plant output with the subprocess exit is written by the caller.\n10|\"\"\"\n11|import os, shutil, subprocess, sys, tempfile\n12|from dataclasses import dataclass\n13|from pathlib import Path\n14|\n15|REPO = Path(sys.argv[1]).resolve()\n16|OUT = Path(sys.argv[2]).resolve()\n17|PACKAGE = \"internal/terminstance\"\n18|\n19|@dataclass(frozen=True)\n20|class Mutant:\n21|    name: str\n22|    path: str\n23|    find: str\n24|    replace: str\n25|    kind: str   # NARROWING / CONTROL\n26|    note: str\n27|\n28|M = [\n29|    Mutant(\"RV2-M1-recheck-auth-third-effect\", f\"{PACKAGE}/execute.go\",\n30|        \"\\t\\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil {\\n\\t\\t\\tfailure := err.(*Error)\\n\\t\\t\\tafter := source\\n\",\n31|        \"\\t\\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil && len(performed) < 2 {\\n\\t\\t\\tfailure := err.(*Error)\\n\\t\\t\\tafter := source\\n\",\n32|        \"NARROWING\", \"Per-effect auth recheck skipped exactly before the THIRD effect (request-stop's backend_store_closed); rechecks before effects 1 and 2 stay.\"),\n33|    Mutant(\"RV2-M2-recheck-generation-third-effect\", f\"{PACKAGE}/execute.go\",\n34|        \"\\t\\tif engine.CurrentGeneration() != context.BackendGeneration {\\n\\t\\t\\tfailure := refuse(CodeStaleGeneration, \\\"backend_generation stale\\\")\\n\\t\\t\\tafter := source\\n\",\n35|        \"\\t\\tif engine.CurrentGeneration() != context.BackendGeneration && len(performed) < 2 {\\n\\t\\t\\tfailure := refuse(CodeStaleGeneration, \\\"backend_generation stale\\\")\\n\\t\\t\\tafter := source\\n\",\n36|        \"NARROWING\", \"Per-effect generation recheck skipped exactly before the THIRD effect.\"),\n37|    Mutant(\"RV2-M3-entry-deadline-instant\", f\"{PACKAGE}/execute.go\",\n38|        \"\\tif !engine.Now().Before(deadline) {\\n\\t\\tfailure := refuse(rowTimeoutCode(operation), \\\"operation deadline\\\")\\n\\t\\treturn buildResult(context, source, source, nil, nil, DispositionReplaySame), failure\\n\\t}\\n\",\n39|        \"\\tif engine.Now().After(deadline) {\\n\\t\\tfailure := refuse(rowTimeoutCode(operation), \\\"operation deadline\\\")\\n\\t\\treturn buildResult(context, source, source, nil, nil, DispositionReplaySame), failure\\n\\t}\\n\",\n40|        \"NARROWING\", \"Entry deadline widened by one instant: now == deadline_at is admitted (bound edge).\"),\n41|    Mutant(\"RV2-M4-status-deadline-instant\", f\"{PACKAGE}/execute.go\",\n42|        \"\\tif !engine.Now().Before(deadline) {\\n\\t\\treturn empty, refuse(CodeTimeout, \\\"operation deadline\\\")\\n\\t}\\n\",\n43|        \"\\tif engine.Now().After(deadline) {\\n\\t\\treturn empty, refuse(CodeTimeout, \\\"operation deadline\\\")\\n\\t}\\n\",\n44|        \"NARROWING\", \"Status deadline widened by one instant: now == deadline_at is admitted (bound edge).\"),\n45|    Mutant(\"RV2-M5-committed-timeout-disposition\", f\"{PACKAGE}/execute.go\",\n46|        \"\\t\\t\\tfailure := refuse(code, \\\"backend effect refused\\\")\\n\\t\\t\\treturn buildResult(context, source, after, performed, evidence, DispositionFor(code, committed)), failure\\n\",\n47|        \"\\t\\t\\tfailure := refuse(code, \\\"backend effect refused\\\")\\n\\t\\t\\treturn buildResult(context, source, after, performed, evidence, DispositionFor(code, committed && code != CodeTimeout)), failure\\n\",\n48|        \"NARROWING\", \"Disposition mapping collapsed at the engine for exactly a COMMITTED terminal_backend_timeout (create's second effect): reports replay_same instead of status_first.\"),\n49|    Mutant(\"RV2-M6-authkind-admits-attach\", f\"{PACKAGE}/auth.go\",\n50|        \"\\tdefault:\\n\\t\\treturn \\\"\\\", refuse(CodeProtocolError, \\\"ax authorization kind\\\")\\n\\t}\\n\",\n51|        \"\\tdefault:\\n\\t\\tif value == \\\"attach\\\" {\\n\\t\\t\\treturn AuthorizationControl, nil\\n\\t\\t}\\n\\t\\treturn \\\"\\\", refuse(CodeProtocolError, \\\"ax authorization kind\\\")\\n\\t}\\n\",\n52|        \"NARROWING\", \"Closed AuthorizationKind admits exactly the landed 'attach' name (an AttachAuthorization kind, never an AXAuthorization kind) as control.\"),\n53|    Mutant(\"RV2-M7-entry-generation-exempts-create\", f\"{PACKAGE}/execute.go\",\n54|        \"\\tif engine.CurrentGeneration() != context.BackendGeneration {\\n\\t\\tfailure := refuse(CodeStaleGeneration, \\\"backend_generation stale\\\")\\n\\t\\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\\n\",\n55|        \"\\tif engine.CurrentGeneration() != context.BackendGeneration && operation != terminalbackend.OperationCreate {\\n\\t\\tfailure := refuse(CodeStaleGeneration, \\\"backend_generation stale\\\")\\n\\t\\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\\n\",\n56|        \"NARROWING\", \"Entry generation gate exempts exactly the create row.\"),\n57|    Mutant(\"RV2-M8-entry-auth-exempts-create\", f\"{PACKAGE}/execute.go\",\n58|        \"\\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil {\\n\\t\\tfailure := err.(*Error)\\n\\t\\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\\n\",\n59|        \"\\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil && operation != terminalbackend.OperationCreate {\\n\\t\\tfailure := err.(*Error)\\n\\t\\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\\n\",\n60|        \"NARROWING\", \"Entry authorization gate exempts exactly the create row (a control/expired/foreign-lease authorization creates).\"),\n61|    Mutant(\"RV2-M9-status-match-drops-implementation\", f\"{PACKAGE}/execute.go\",\n62|        \"\\t\\tobserved.ImplVersion == body.ImplementationVersion &&\\n\",\n63|        \"\\t\\ttrue &&\\n\",\n64|        \"NARROWING\", \"identity_match six-way conjunction loses exactly the implementation axis.\"),\n65|    Mutant(\"RV2-M10-headless-conditional-exempts-absent\", f\"{PACKAGE}/execute.go\",\n66|        \"\\tif err := checkCapabilityConditional(operation, params, admitted); err != nil {\\n\",\n67|        \"\\tif err := checkCapabilityConditional(operation, params, admitted); err != nil && !(operation == terminalbackend.OperationCreate && source == terminalbackend.StateAbsent) {\\n\",\n68|        \"NARROWING\", \"headless_creation conditional skipped exactly for a headless create from absent.\"),\n69|    Mutant(\"RV2-M15-session-scoped-adopts-foreign-session\", f\"{PACKAGE}/execute.go\",\n70|        \"\\tif observed.SessionID != body.SessionID {\\n\\t\\treturn false, nil\\n\\t}\\n\",\n71|        \"\\tif observed.SessionID != body.SessionID && body.HasTerminalInstanceID {\\n\\t\\treturn false, nil\\n\\t}\\n\",\n72|        \"NARROWING\", \"Session-scoped status lookup adopts a report for a DIFFERENT session (the session comparison is skipped exactly for the both-null lookup).\"),\n73|    Mutant(\"RV2-K-control-known-killed\", f\"{PACKAGE}/auth.go\",\n74|        \"\\tleaseEpoch, ok := environ.CheckUint53Bounds(members[\\\"lease_epoch\\\"], 1, MaxLeaseEpoch)\\n\",\n75|        \"\\tleaseEpoch, ok := environ.CheckUint53Bounds(members[\\\"lease_epoch\\\"], 0, MaxLeaseEpoch)\\n\",\n76|        \"CONTROL\", \"Known-killed control (the producer's N-auth-epoch-low): must be KILLED by TestParseAXAuthorizationEpochBound, proving the plant reaches the compiler and the suite.\"),\n77|    Mutant(\"RV2-B-control-build-break\", f\"{PACKAGE}/auth.go\",\n78|        \"\\tif auth.Kind != wantKind {\\n\",\n79|        \"\\tif auth.Kind != wantKind { this does not compile\\n\",\n80|        \"CONTROL\", \"Build-break control: must report ERROR build broke, proving the patched file is what gets compiled.\"),\n81|    Mutant(\"RV2-C-control\", f\"{PACKAGE}/doc.go\",\n82|        \"// Package terminstance executes the Terminal Instance lifecycle contract of\\n\",\n83|        \"// Package terminstance executes (control) the Terminal Instance lifecycle contract of\\n\",\n84|        \"CONTROL\", \"Comment-only control: must SURVIVE.\"),\n85|]\n86|\n87|def run(m: Mutant) -> str:\n88|    target = REPO / m.path\n89|    original = target.read_text()\n90|    n = original.count(m.find)\n91|    if n != 1:\n92|        return f\"ERROR: {m.name}: anchors {n}, want 1\"\n93|    with tempfile.TemporaryDirectory() as staging:\n94|        backup = Path(staging) / \"backup\"\n95|        shutil.copy2(target, backup)\n96|        try:\n97|            target.write_text(original.replace(m.find, m.replace))\n98|            p = subprocess.run([\"go\", \"test\", f\"./{PACKAGE}/\", \"-count=1\"], cwd=REPO, capture_output=True, text=True, timeout=600)\n99|        finally:\n100|            shutil.copy2(backup, target)\n101|    out = (p.stdout + p.stderr)\n102|    (OUT / f\"{m.name}.log\").write_text(f\"--- plant: {m.name} ({m.kind}) exit {p.returncode} ---\\n{m.note}\\n--- output ---\\n{out}\\n--- end ---\\n\")\n103|    if \"build failed\" in out or out.startswith(\"# \") or \"\\n# \" in out:\n104|        return f\"ERROR: {m.name}: build broke\"\n105|    if p.returncode == 0:\n106|        v = \"SURVIVED\"\n107|    elif \"--- FAIL\" in out or \"FAIL:\" in out:\n108|        v = \"KILLED\"\n109|    else:\n110|        return f\"ERROR: {m.name}: exit {p.returncode} no kill line\"\n111|    killers = sorted({l.split()[2] for l in out.splitlines() if l.startswith(\"--- FAIL: \")})\n112|    return f\"{m.name}: {v} [{m.kind}] exit={p.returncode} killers={killers} :: {m.note}\"\n113|\n114|for m in M:\n115|    print(run(m), flush=True)","final_result":true}}}
