{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c91b","stream":{"kind":"session","id":"01a0b291-18f0-70a0-900f-0c92cf0433eb"},"sequence":744,"recorded_at":1780531400001483,"record_type":"event","durability":"durable","causation_id":"cb7c4ff2-7892-4304-8de0-3769502303db","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cb7c4ff2-7892-4304-8de0-3769502303db","run_stream":{"kind":"run","id":"cb7c4ff2-7892-4304-8de0-3769502303db"},"task_stream":{"kind":"task","id":"01a0b293-a914-7a90-934f-2d83721f488e"},"task_id":"01a0b293-a914-7a90-934f-2d83721f488e","event":{"kind":"output","task_id":"01a0b293-a914-7a90-934f-2d83721f488e","chunk":"Read text file `internal/fencing/gate.go`.\n(99 line(s) above)\n100|// decision: the reason and the winning lease ID (empty when no winner\n101|// is established). It reports false for a hard refusal.\n102|func ParkDetails(err error) (ParkReason, string, bool) {\n103|\tvar parked *parkRefusal\n104|\tif !errors.As(err, &parked) {\n105|\t\treturn \"\", \"\", false\n106|\t}\n107|\treturn parked.reason, parked.winningLeaseID, true\n108|}\n109|\n110|// park builds the launch-class refusal for one ownership condition: the\n111|// parked reason with the Section 15 cause the same condition refuses\n112|// on a non-launch entry.\n113|func park(reason ParkReason, winningLeaseID string, cause error) error {\n114|\treturn &parkRefusal{reason: reason, winningLeaseID: winningLeaseID, cause: cause}\n115|}\n116|\n117|// Operation is one activation-class action the gate authorizes.\n118|type Operation string\n119|\n120|const (\n121|\t// OperationActivation gates provider activation and launch: only\n122|\t// the winning committed lease may create a destination runtime.\n123|\tOperationActivation Operation = \"activation\"\n124|\t// OperationInput gates provider input after attach (the\n125|\t// quiesce-input and attach direction): the owner revalidates\n126|\t// before accepting operator input.\n127|\tOperationInput Operation = \"input\"\n128|\t// OperationMutation gates owner-authored mutation: event append\n129|\t// and compare-and-swap succession carry the winning epoch.\n130|\tOperationMutation Operation = \"mutation\"\n131|\t// OperationCheckpoint gates checkpoint capture admission: a fresh\n132|\t// checkpoint is published under the current lease only.\n133|\tOperationCheckpoint Operation = \"checkpoint\"\n134|\t// OperationRestore gates terminal restore and the wrapper's first\n135|\t// start: ownership is compared before any provider resume.\n136|\tOperationRestore Operation = \"restore\"\n137|)\n138|\n139|// validOperation reports whether op names a gated action. Anything\n140|// else is a malformed gate call, never an authorized action.\n141|func validOperation(op Operation) bool {\n142|\tswitch op {\n143|\tcase OperationActivation, OperationInput, OperationMutation, OperationCheckpoint, OperationRestore:\n144|\t\treturn true\n145|\t}\n146|\treturn false\n147|}\n148|\n149|// launchClass reports whether op is a launch-class entry: activation\n150|// and restore park when ownership is remote, ambiguous, unverified,\n151|// or absent, while input, mutation, and checkpoint refuse outright.\n152|func launchClass(op Operation) bool {\n153|\treturn op == OperationActivation || op == OperationRestore\n154|}\n155|\n156|// PresentedToken is the caller's claimed fencing authority: the local\n157|// fencing token the wrapper compares, or the token a takeover, input,\n158|// mutation, or checkpoint caller holds. It is untrusted input: every\n159|// member is grammar-checked before any comparison runs.\n160|type PresentedToken struct {\n161|\tSessionID string\n162|\tEpoch     uint64\n163|\tLeaseID   string\n164|}\n165|\n166|// Observation carries the verified durable and sync facts the gate\n167|// decides over. Observe builds it from the repository; callers that\n168|// build it by hand (tests, modeled flows) must supply the same facts.\n169|// The winner is trusted only through its grammar: a malformed winning\n170|// summary refuses rather than authorizing against garbage.\n171|type Observation struct {\n172|\tSessionID string\n173|\t// Winner is the winning lease summary with its holder. It is\n174|\t// meaningful only when HasWinner is set.\n175|\tWinner    sessrepo.LeaseSummary\n176|\tHasWinner bool\n177|\t// LocalHostID is the host asking for authorization. An unknown or\n178|\t// empty local identity never equals the winning holder, so it\n179|\t// fails closed to the remote arm without a grammar check.\n180|\tLocalHostID string\n181|\t// Verified reports that a mesh lease refresh proved current\n182|\t// lease knowledge. Unverified ownership parks or refuses.\n183|\tVerified bool\n184|\t// Ambiguous reports conflicting ownership observations (a union\n185|\t// rival the local store cannot order). Ambiguity parks or refuses.\n186|\tAmbiguous bool\n187|\t// HandoffFailed reports that the caller's own handoff already\n188|\t// failed (a losing force lease before activation). A failed\n189|\t// handoff parks with failed_handoff instead of activating.\n190|\tHandoffFailed bool\n191|\t// Grant is the process-local authorization derived from a winning\n192|\t// lease, meaningful only when HasGrant is set. The gate re-checks\n193|\t// its expiry through the sessrepo owner on every call.\n194|\tGrant    sessrepo.FencingGrant\n195|\tHasGrant bool\n196|\t// Policy carries the configured lease refresh interval the\n197|\t// expiry arm enforces.\n198|\tPolicy sessrepo.FencingPolicy\n199|\t// Now is the caller's clock reading for the expiry arm. A grant\n200|\t// without a clock reading refuses rather than bypassing expiry.\n201|\tNow time.Time\n202|}\n203|\n204|// ObserveInput carries the caller-reported facts Observe combines with\n205|// the durable winning lease: sync state, handoff outcome, the\n206|// process-local fencing grant with its policy, and the clock reading.\n207|type ObserveInput struct {\n208|\tLocalHostID   string\n209|\tVerified      bool\n210|\tAmbiguous     bool\n211|\tHandoffFailed bool\n212|\tGrant         sessrepo.FencingGrant\n213|\tHasGrant      bool\n214|\tPolicy        sessrepo.FencingPolicy\n215|\tNow           time.Time\n216|}\n217|\n218|// Observe loads the winning lease for sessionID and combines it with\n219|// the caller's sync, handoff, grant, and clock facts into the\n220|// Observation Authorize decides over. The winner is the last summary\n221|// of the tuple-ordered ListLeases read, the same derivation\n222|// WinningLease returns, so no second winner rule exists here. A\n223|// session with no leases yet yields HasWinner false without an error:\n224|// absence is data the gate parks or refuses on. A repository failure\n225|// (including an unknown session) propagates unchanged.\n226|func Observe(repository *sessrepo.Repository, sessionID string, input ObserveInput) (Observation, error) {\n227|\tleases, err := repository.ListLeases(sessionID)\n228|\tif err != nil {\n229|\t\treturn Observation{}, err\n230|\t}\n231|\tobservation := Observation{\n232|\t\tSessionID:     sessionID,\n233|\t\tLocalHostID:   input.LocalHostID,\n234|\t\tVerified:      input.Verified,\n235|\t\tAmbiguous:     input.Ambiguous,\n236|\t\tHandoffFailed: input.HandoffFailed,\n237|\t\tGrant:         input.Grant,\n238|\t\tHasGrant:      input.HasGrant,\n239|\t\tPolicy:        input.Policy,\n240|\t\tNow:           input.Now,\n241|\t}\n242|\tif len(leases) > 0 {\n243|\t\tobservation.Winner = leases[len(leases)-1]\n244|\t\tobservation.HasWinner = true\n245|\t}\n246|\treturn observation, nil\n247|}\n248|\n249|// AuthorizeActivation gates provider activation and launch through the\n250|// fencing core.\n251|func AuthorizeActivation(presented PresentedToken, observation Observation) (LeaseToken, error) {\n252|\treturn Authorize(OperationActivation, presented, observation)\n253|}\n254|\n255|// AuthorizeInput gates provider input after attach through the fencing\n256|// core.\n257|func AuthorizeInput(presented PresentedToken, observation Observation) (LeaseToken, error) {\n258|\treturn Authorize(OperationInput, presented, observation)\n259|}\n260|\n261|// AuthorizeMutation gates owner-authored mutation through the fencing\n262|// core.\n263|func AuthorizeMutation(presented PresentedToken, observation Observation) (LeaseToken, error) {\n264|\treturn Authorize(OperationMutation, presented, observation)\n265|}\n266|\n267|// AuthorizeCheckpoint gates checkpoint capture admission through the\n268|// fencing core.\n269|func AuthorizeCheckpoint(presented PresentedToken, observation Observation) (LeaseToken, error) {\n270|\treturn Authorize(OperationCheckpoint, presented, observation)\n271|}\n272|\n273|// AuthorizeRestore gates terminal restore and the wrapper's first\n274|// start through the fencing core.\n275|func AuthorizeRestore(presented PresentedToken, observation Observation) (LeaseToken, error) {\n276|\treturn Authorize(OperationRestore, presented, observation)\n277|}\n278|\n279|// Authorize is the fencing core: every activation-class action passes\n280|// here. The presented token must name this session and equal the\n281|// winning (epoch, lease_id) tuple exactly; the fencing grant must be\n282|// present and unexpired; ownership must be verified, unambiguous, and\n283|// local. Launch-class entries (activation, restore) park with the\n284|// session.parked vocabulary when ownership is remote, ambiguous,\n285|// unverified, or absent; every other entry refuses outright. A passed\n286|// gate mints the sealed LeaseToken the provider operations bind; a\n287|// failed gate refuses with a Section 15 registered code and mints\n288|// nothing.\n289|//\n290|// Arm order is precedence: malformed calls die first, then foreign\n291|// sessions, then ownership presence and verifiability, then the\n292|// fencing grant, then ownership direction (the operative fact beats\n293|// the credential: a stale token under a remote winner parks remote,\n294|// it does not report stale), then the exact tuple match.\n295|func Authorize(operation Operation, presented PresentedToken, observation Observation) (LeaseToken, error) {\n296|\tif !validOperation(operation) {\n297|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"unknown fencing operation %q\", string(operation))\n298|\t}\n299|\tif _, err := scalar.ParseUUIDv7(presented.SessionID); err != nil {\n300|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"presented fencing token session %q is not a UUIDv7: %v\", presented.SessionID, err)\n301|\t}\n302|\tif presented.Epoch == 0 {\n303|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"presented fencing token carries epoch 0, want an epoch at or above 1\")\n304|\t}\n305|\tif _, err := scalar.ParseUUIDv4(presented.LeaseID); err != nil {\n306|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"presented fencing token lease %q is not a UUIDv4: %v\", presented.LeaseID, err)\n307|\t}\n308|\tif presented.SessionID != observation.SessionID {\n309|\t\treturn LeaseToken{}, refuse(ErrLeaseConflict, \"presented fencing token for session %s does not authorize session %s\", presented.SessionID, observation.SessionID)\n310|\t}\n311|\tif !observation.HasWinner {\n312|\t\tif launchClass(operation) {\n313|\t\t\treturn LeaseToken{}, park(ParkRestorePolicy, \"\", ErrLeaseConflict)\n314|\t\t}\n315|\t\treturn LeaseToken{}, refuse(ErrLeaseConflict, \"no winning lease is established for session %s\", observation.SessionID)\n316|\t}\n317|\tif observation.Winner.Epoch == 0 || !validLeaseID(observation.Winner.LeaseID) || !validHostID(observation.Winner.HolderHostID) {\n318|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"fencing observation for session %s carries no well-formed winning lease\", observation.SessionID)\n319|\t}\n320|\tif !observation.Verified {\n321|\t\tif launchClass(operation) {\n322|\t\t\treturn LeaseToken{}, park(ParkRestorePolicy, observation.Winner.LeaseID, ErrLeaseConflict)\n323|\t\t}\n324|\t\treturn LeaseToken{}, refuse(ErrLeaseConflict, \"ownership of session %s is unverified; refresh lease knowledge first\", observation.SessionID)\n325|\t}\n326|\tif observation.Ambiguous {\n327|\t\tif launchClass(operation) {\n328|\t\t\treturn LeaseToken{}, park(ParkRestorePolicy, observation.Winner.LeaseID, ErrLeaseConflict)\n329|\t\t}\n330|\t\treturn LeaseToken{}, refuse(ErrLeaseConflict, \"ownership of session %s is ambiguous; resolve the union rival first\", observation.SessionID)\n331|\t}\n332|\tif observation.HandoffFailed {\n333|\t\tif launchClass(operation) {\n334|\t\t\treturn LeaseToken{}, park(ParkFailedHandoff, observation.Winner.LeaseID, ErrLeaseConflict)\n335|\t\t}\n336|\t\treturn LeaseToken{}, refuse(ErrLeaseConflict, \"handoff for session %s already failed; a losing lease must never activate\", observation.SessionID)\n337|\t}\n338|\tif !observation.HasGrant {\n339|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"fencing observation for session %s carries no grant; validate the winning token first\", observation.SessionID)\n340|\t}\n341|\tif observation.Now.IsZero() {\n342|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"fencing observation for session %s carries no clock reading; expiry cannot be checked\", observation.SessionID)\n343|\t}\n344|\tif err := sessrepo.CheckFencingExpiry(observation.Grant, observation.Policy, observation.Now); err != nil {\n345|\t\tif errors.Is(err, sessrepo.ErrFencingExpired) {\n346|\t\t\treturn LeaseToken{}, refuse(ErrLeaseConflict, \"fencing grant for session %s lapsed; revalidate the winning token\", observation.SessionID)\n347|\t\t}\n348|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"fencing observation for session %s carries an unusable refresh policy\", observation.SessionID)\n349|\t}\n350|\tif observation.Winner.HolderHostID != observation.LocalHostID {\n351|\t\tif launchClass(operation) {\n352|\t\t\treturn LeaseToken{}, park(ParkRemoteOwner, observation.Winner.LeaseID, ErrNotOwner)\n353|\t\t}\n354|\t\treturn LeaseToken{}, refuse(ErrNotOwner, \"session %s is owned by remote host %s\", observation.SessionID, observation.Winner.HolderHostID)\n355|\t}\n356|\tepochsEqual := presented.Epoch == observation.Winner.Epoch\n357|\tif !epochsEqual {\n358|\t\tif presented.Epoch < observation.Winner.Epoch {\n359|\t\t\tif launchClass(operation) {\n(more lines below)","final_result":true}}}
