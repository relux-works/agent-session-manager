ation))\n+\tif err != nil {\n+\t\treturn \"\", false\n+\t}\n+\tswitch AuthorizationKind(landed) {\n+\tcase AuthorizationCreate:\n+\t\treturn AuthorizationCreate, true\n+\tcase AuthorizationControl:\n+\t\treturn AuthorizationControl, true\n+\tdefault:\n+\t\treturn \"\", false\n+\t}\n+}\n","edit_facts":{"tool_name":"edit_file","path":"internal/terminstance/execute.go","added":22,"removed":16},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
