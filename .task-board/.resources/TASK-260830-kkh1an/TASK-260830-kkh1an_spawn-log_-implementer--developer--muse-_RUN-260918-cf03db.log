{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c837","stream":{"kind":"session","id":"01a0b291-18f0-70a0-900f-0c92cf0433eb"},"sequence":630,"recorded_at":1780531400001255,"record_type":"event","durability":"durable","causation_id":"cb7c4ff2-7892-4304-8de0-3769502303db","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cb7c4ff2-7892-4304-8de0-3769502303db","run_stream":{"kind":"run","id":"cb7c4ff2-7892-4304-8de0-3769502303db"},"task_stream":{"kind":"task","id":"01a0b292-bf05-7ca3-a5d9-85a14e6888c2"},"task_id":"01a0b292-bf05-7ca3-a5d9-85a14e6888c2","event":{"kind":"output","task_id":"01a0b292-bf05-7ca3-a5d9-85a14e6888c2","chunk":"Read text file `internal/terminstance/execute_test.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"context\"\n5|\t\"errors\"\n6|\t\"testing\"\n7|\t\"time\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n10|)\n11|\n12|func quiesceFixture(t *testing.T) (MutationContext, Params, terminalbackend.InstanceState, terminalbackend.Admitted) {\n13|\tt.Helper()\n14|\treturn testContext(t), testParams(), mustParseState(t, \"active\"), testAdmitted(\"input_quiescence\")\n15|}\n16|\n17|// TestExecuteQuiesceSuccess drives the quiesce-input row through the\n18|// production entry from both sources: active|parked → quiescing with\n19|// exactly input_closed, disposition replay_same, and the receipt bound.\n20|func TestExecuteQuiesceSuccess(t *testing.T) {\n21|\tfor _, source := range []string{\"active\", \"parked\"} {\n22|\t\tt.Run(source, func(t *testing.T) {\n23|\t\t\tbackend := newMockBackend()\n24|\t\t\tbackend.evidence[terminalbackend.EffectInputClosed] = fixtureDigestB\n25|\t\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n26|\t\t\tcontext, params, _, admitted := quiesceFixture(t)\n27|\t\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, mustParseState(t, source), admitted)\n28|\t\t\tif err != nil {\n29|\t\t\t\tt.Fatalf(\"ExecuteMutating() error = %v\", err)\n30|\t\t\t}\n31|\t\t\trequireLiteral(t, \"before\", string(result.Before), source)\n32|\t\t\trequireLiteral(t, \"after\", string(result.After), \"quiescing\")\n33|\t\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"replay_same\")\n34|\t\t\tif len(result.Effects) != 1 || result.Effects[0] != terminalbackend.EffectInputClosed {\n35|\t\t\t\tt.Errorf(\"effects = %v, want [input_closed]\", result.Effects)\n36|\t\t\t}\n37|\t\t\trequireLiteral(t, \"evidence\", result.EvidenceIDs[0], \"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\")\n38|\t\t\tif err := CheckResult(context, mustParseState(t, source), result); err != nil {\n39|\t\t\t\tt.Errorf(\"CheckResult(engine result) error = %v\", err)\n40|\t\t\t}\n41|\t\t\tperformed := backend.performed()\n42|\t\t\tif len(performed) != 1 || performed[0] != terminalbackend.EffectInputClosed {\n43|\t\t\t\tt.Errorf(\"performed = %v, want [input_closed]\", performed)\n44|\t\t\t}\n45|\t\t\tif _, found, err := engine.Store.Lookup(context.IdempotencyKey); err != nil || !found {\n46|\t\t\t\tt.Errorf(\"Lookup(key) = (%v, %v), want the bound receipt\", found, err)\n47|\t\t\t}\n48|\t\t})\n49|\t}\n50|}\n51|\n52|func contextGo() context.Context { return context.Background() }\n53|\n54|// TestExecuteReceiptPrecedesFirstEffect proves creating is entered only\n55|// after its durable receipt: the backend's first effect observes the\n56|// committed receipt through the production entry.\n57|func TestExecuteReceiptPrecedesFirstEffect(t *testing.T) {\n58|\tbackend := newMockBackend()\n59|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n60|\tcontext, params, source, admitted := quiesceFixture(t)\n61|\tbackend.effectHandler = func(effect terminalbackend.SideEffect) (string, error) {\n62|\t\tif _, found, err := engine.Store.Lookup(context.IdempotencyKey); err != nil || !found {\n63|\t\t\tt.Errorf(\"Lookup(key) inside first effect = (%v, %v), want the committed receipt\", found, err)\n64|\t\t}\n65|\t\tif _, found, err := engine.Store.Completed(context.IdempotencyKey); err != nil || found {\n66|\t\t\tt.Errorf(\"Completed(key) inside first effect = (%v, %v), want no completion yet\", found, err)\n67|\t\t}\n68|\t\treturn fixtureDigestA, nil\n69|\t}\n70|\tif _, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted); err != nil {\n71|\t\tt.Fatalf(\"ExecuteMutating() error = %v\", err)\n72|\t}\n73|}\n74|\n75|// TestExecuteInterimState proves creating is entered only by create:\n76|// the AfterReceipt hook observes creating for create and the source\n77|// for every other engine operation.\n78|func TestExecuteInterimState(t *testing.T) {\n79|\trequireLiteral(t, \"create interim\", string(InterimState(terminalbackend.OperationCreate, mustParseState(t, \"absent\"))), \"creating\")\n80|\tfor _, operation := range []terminalbackend.Operation{\n81|\t\tterminalbackend.OperationQuiesceInput, terminalbackend.OperationWaitSafeBoundary, terminalbackend.OperationRequestStop,\n82|\t} {\n83|\t\tif got := InterimState(operation, mustParseState(t, \"active\")); got != terminalbackend.StateActive {\n84|\t\t\tt.Errorf(\"InterimState(%s) = %q, want the source\", operation, got)\n85|\t\t}\n86|\t}\n87|\n88|\tbackend := newMockBackend()\n89|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n90|\tvar interims []terminalbackend.InstanceState\n91|\tengine.Hooks = &EngineHooks{AfterReceipt: func(_ terminalbackend.Operation, _ string, interim terminalbackend.InstanceState) {\n92|\t\tinterims = append(interims, interim)\n93|\t}}\n94|\tcontext, params, source, admitted := quiesceFixture(t)\n95|\tif _, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted); err != nil {\n96|\t\tt.Fatalf(\"ExecuteMutating() error = %v\", err)\n97|\t}\n98|\tif len(interims) != 1 || interims[0] != terminalbackend.StateActive {\n99|\t\tt.Errorf(\"interims = %v, want [active]\", interims)\n100|\t}\n101|\n102|\tcreate := testCreateContext(t)\n103|\tbackendCreate := newMockBackend()\n104|\tengineCreate := testEngine(t, backendCreate, testLease(), fixtureGen)\n105|\tvar createInterims []terminalbackend.InstanceState\n106|\tengineCreate.Hooks = &EngineHooks{AfterReceipt: func(_ terminalbackend.Operation, _ string, interim terminalbackend.InstanceState) {\n107|\t\tcreateInterims = append(createInterims, interim)\n108|\t}}\n109|\tif _, err := engineCreate.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, create.context, create.params, mustParseState(t, \"absent\"), testAdmitted(\"terminal_state_retention\")); err != nil {\n110|\t\tt.Fatalf(\"ExecuteMutating(create) error = %v\", err)\n111|\t}\n112|\tif len(createInterims) != 1 || createInterims[0] != terminalbackend.StateCreating {\n113|\t\tt.Errorf(\"create interims = %v, want [creating]\", createInterims)\n114|\t}\n115|}\n116|\n117|type createFixture struct {\n118|\tcontext MutationContext\n119|\tparams  Params\n120|}\n121|\n122|func testCreateContext(t *testing.T) createFixture {\n123|\tt.Helper()\n124|\tauth, err := ParseAXAuthorization([]byte(authDoc(\"1\", map[string]*string{\"authorization_kind\": strptr(`\"create\"`)})))\n125|\tif err != nil {\n126|\t\tt.Fatalf(\"ParseAXAuthorization(create) error = %v\", err)\n127|\t}\n128|\tkey := fixtureSessionA + \"/\" + fixtureBootstrap\n129|\traw := contextDoc(fixtureOperation, fixtureSessionA, fixtureInstance, fixtureBackend, fixtureImpl, fixtureProto, fixtureGen, key, fixtureDeadline, authDoc(\"1\", map[string]*string{\"authorization_kind\": strptr(`\"create\"`)}))\n130|\tcontext, err := ParseMutationContext([]byte(raw))\n131|\tif err != nil {\n132|\t\tt.Fatalf(\"ParseMutationContext(create) error = %v\", err)\n133|\t}\n134|\t_ = auth\n135|\treturn createFixture{context: context, params: Params{BootstrapOperationID: fixtureBootstrap, Interactive: true}}\n136|}\n137|\n138|// TestExecuteCreateReceiptRule drives the create receipt rule: absent →\n139|// active when interactive with binding_persisted and wrapper_started,\n140|// stopped → parked when headless, and headless without\n141|// headless_creation refuses with the capability class.\n142|func TestExecuteCreateReceiptRule(t *testing.T) {\n143|\tcreate := testCreateContext(t)\n144|\tbackend := newMockBackend()\n145|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n146|\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, create.context, create.params, mustParseState(t, \"absent\"), testAdmitted(\"terminal_state_retention\"))\n147|\tif err != nil {\n148|\t\tt.Fatalf(\"ExecuteMutating(create interactive) error = %v\", err)\n149|\t}\n150|\trequireLiteral(t, \"after\", string(result.After), \"active\")\n151|\trequireLiteral(t, \"disposition\", string(result.Disposition), \"replay_same\")\n152|\tperformed := backend.performed()\n153|\tif len(performed) != 2 || performed[0] != terminalbackend.EffectBindingPersisted || performed[1] != terminalbackend.EffectWrapperStarted {\n154|\t\tt.Errorf(\"performed = %v, want [binding_persisted wrapper_started]\", performed)\n155|\t}\n156|\n157|\theadless := testCreateContext(t)\n158|\theadless.params.Interactive = false\n159|\tbackendHeadless := newMockBackend()\n160|\tengineHeadless := testEngine(t, backendHeadless, testLease(), fixtureGen)\n161|\tresult, err = engineHeadless.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, headless.context, headless.params, mustParseState(t, \"stopped\"), testAdmitted(\"headless_creation\"))\n162|\tif err != nil {\n163|\t\tt.Fatalf(\"ExecuteMutating(create headless) error = %v\", err)\n164|\t}\n165|\trequireLiteral(t, \"after\", string(result.After), \"parked\")\n166|\n167|\tbackendBare := newMockBackend()\n168|\tengineBare := testEngine(t, backendBare, testLease(), fixtureGen)\n169|\tfresh := testCreateContext(t)\n170|\tfresh.context.OperationID = fixtureOperationB\n171|\tfresh.params.Interactive = false\n172|\t_, err = engineBare.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, fresh.context, fresh.params, mustParseState(t, \"stopped\"), testAdmitted(\"terminal_state_retention\"))\n173|\trequireRefusal(t, err, \"terminal_backend_capability_unproven\", \"operation capability conditional\")\n174|\tif len(backendBare.performed()) != 0 {\n175|\t\tt.Errorf(\"performed = %v, want no effects on the refused create\", backendBare.performed())\n176|\t}\n177|}\n178|\n179|// TestExecutePreEffectErrorsRestoreSource proves an error before the\n180|// first side effect restores the source state: entry auth failure,\n181|// entry generation staleness, entry deadline expiry and a coded\n182|// backend refusal on the single quiesce effect each return after equal\n183|// to the source with the class-mapped disposition.\n184|func TestExecutePreEffectErrorsRestoreSource(t *testing.T) {\n185|\tt.Run(\"entry auth expired\", func(t *testing.T) {\n186|\t\tbackend := newMockBackend()\n187|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n188|\t\tengine.Now = fixtureLater\n189|\t\tcontext, params, source, admitted := quiesceFixture(t)\n190|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n191|\t\trequireRefusal(t, err, \"terminal_backend_unauthorized\", \"ax authorization expiry\")\n192|\t\trequireLiteral(t, \"after\", string(result.After), \"active\")\n193|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"new_authorization\")\n194|\t\tif _, found, _ := engine.Store.Lookup(context.IdempotencyKey); found {\n195|\t\t\tt.Error(\"Lookup(key) found a receipt for the unauthorized request, want none bound\")\n196|\t\t}\n197|\t})\n198|\n199|\tt.Run(\"entry generation stale\", func(t *testing.T) {\n200|\t\tbackend := newMockBackend()\n201|\t\tengine := testEngine(t, backend, testLease(), \"generation-two\")\n202|\t\tcontext, params, source, admitted := quiesceFixture(t)\n203|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n204|\t\trequireRefusal(t, err, \"terminal_backend_stale_generation\", \"backend_generation stale\")\n205|\t\trequireLiteral(t, \"after\", string(result.After), \"active\")\n206|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"status_first\")\n207|\t\tif _, found, _ := engine.Store.Lookup(context.IdempotencyKey); found {\n208|\t\t\tt.Error(\"Lookup(key) found a receipt for the stale request, want none bound\")\n209|\t\t}\n210|\t})\n211|\n212|\tt.Run(\"coded backend refusal on first effect\", func(t *testing.T) {\n213|\t\tbackend := newMockBackend()\n214|\t\tbackend.effectErrors[terminalbackend.EffectInputClosed] = refuse(\"terminal_backend_timeout\", \"test timeout\")\n215|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n216|\t\tcontext, params, source, admitted := quiesceFixture(t)\n217|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n218|\t\trequireRefusal(t, err, \"terminal_backend_timeout\", \"backend effect refused\")\n219|\t\trequireLiteral(t, \"after\", string(result.After), \"active\")\n220|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"replay_same\")\n221|\t})\n222|\n223|\tt.Run(\"illegal source refuses\", func(t *testing.T) {\n224|\t\tbackend := newMockBackend()\n225|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n226|\t\tcontext, params, _, admitted := quiesceFixture(t)\n227|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, mustParseState(t, \"stopped\"), admitted)\n228|\t\trequireRefusal(t, err, \"local_precondition_failed\", \"lifecycle transition\")\n229|\t\trequireLiteral(t, \"after\", string(result.After), \"stopped\")\n230|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"status_first\")\n231|\t\tif len(backend.performed()) != 0 {\n232|\t\t\tt.Errorf(\"performed = %v, want no effects on the illegal source\", backend.performed())\n233|\t\t}\n234|\t})\n235|\n236|\tt.Run(\"missing conferral refuses at the landed gate\", func(t *testing.T) {\n237|\t\tbackend := newMockBackend()\n238|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n239|\t\tcontext, params, source, _ := quiesceFixture(t)\n240|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, testAdmitted(\"durable_disconnect\"))\n241|\t\trequireRefusal(t, err, \"terminal_backend_capability_unproven\", \"operation capability dependency\")\n242|\t\trequireLiteral(t, \"after\", string(result.After), \"active\")\n243|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"required_operator_action\")\n244|\t})\n245|}\n246|\n247|// TestExecuteEntryDeadlineCodes pins the per-row timeout vocabulary for\n248|// the entry deadline cancel: create and quiesce cancel\n249|// terminal_backend_timeout, wait cancels quiesce_timeout and stop\n250|// cancels stop_timeout, each restoring the source with replay_same.\n251|// The stop replay_same here is the cancel-before-any-attempt direction;\n252|// a backend-REPORTED stop_timeout maps through DispositionFor instead\n253|// (pinned by TestExecuteBackendRowErrorSets).\n254|func TestExecuteEntryDeadlineCodes(t *testing.T) {\n255|\tpast := fixturePastDeadline()\n256|\tcases := []struct {\n257|\t\toperation terminalbackend.Operation\n258|\t\tbuild     func(t *testing.T) (MutationContext, Params, terminalbackend.InstanceState, terminalbackend.Admitted)\n259|\t\tcode      string\n260|\t\tsource    string\n261|\t}{\n262|\t\t{terminalbackend.OperationQuiesceInput, func(t *testing.T) (MutationContext, Params, terminalbackend.InstanceState, terminalbackend.Admitted) {\n263|\t\t\treturn quiesceFixture(t)\n264|\t\t}, \"terminal_backend_timeout\", \"active\"},\n265|\t\t{terminalbackend.OperationWaitSafeBoundary, func(t *testing.T) (MutationContext, Params, terminalbackend.InstanceState, terminalbackend.Admitted) {\n266|\t\t\treturn waitFixture(t, ProofAXCheckpointBoundary)\n267|\t\t}, \"quiesce_timeout\", \"quiescing\"},\n268|\t\t{terminalbackend.OperationRequestStop, func(t *testing.T) (MutationContext, Params, terminalbackend.InstanceState, terminalbackend.Admitted) {\n269|\t\t\treturn stopFixture(t)\n270|\t\t}, \"stop_timeout\", \"quiescing\"},\n271|\t\t{terminalbackend.OperationCreate, func(t *testing.T) (MutationContext, Params, terminalbackend.InstanceState, terminalbackend.Admitted) {\n272|\t\t\tcreated := testCreateContext(t)\n273|\t\t\treturn created.context, created.params, mustParseState(t, \"absent\"), testAdmitted(\"terminal_state_retention\")\n274|\t\t}, \"terminal_backend_timeout\", \"absent\"},\n275|\t}\n276|\tfor _, tc := range cases {\n277|\t\tt.Run(string(tc.operation), func(t *testing.T) {\n278|\t\t\tbackend := newMockBackend()\n279|\t\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n280|\t\t\tengine.Now = func() time.Time { return past }\n281|\t\t\tcontext, params, source, admitted := tc.build(t)\n282|\t\t\tresult, err := engine.ExecuteMutating(contextGo(), tc.operation, context, params, source, admitted)\n283|\t\t\trequireRefusal(t, err, tc.code, \"operation deadline\")\n284|\t\t\trequireLiteral(t, \"after\", string(result.After), tc.source)\n285|\t\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"replay_same\")\n286|\t\t\tif len(backend.performed()) != 0 {\n287|\t\t\t\tt.Errorf(\"performed = %v, want no effects on the deadline cancel\", backend.performed())\n288|\t\t\t}\n289|\t\t\tif _, found, _ := engine.Store.Lookup(context.IdempotencyKey); found {\n290|\t\t\t\tt.Errorf(\"Lookup(key) found a receipt for the expired request, want none bound\")\n291|\t\t\t}\n292|\t\t})\n293|\t}\n294|}\n295|\n296|func waitFixture(t *testing.T, kind ProviderProofKind) (MutationContext, Params, terminalbackend.InstanceState, terminalbackend.Admitted) {\n297|\tt.Helper()\n298|\tkey := fixtureInstance + \"/boundary/\" + fixtureQuiescence + \"/\" + string(kind)\n299|\traw := contextDoc(fixtureOperation, fixtureSessionA, fixtureInstance, fixtureBackend, fixtureImpl, fixtureProto, fixtureGen, key, fixtureDeadline, authDoc(\"1\", nil))\n300|\tcontext, err := ParseMutationContext([]byte(raw))\n301|\tif err != nil {\n302|\t\tt.Fatalf(\"ParseMutationContext(wait) error = %v\", err)\n303|\t}\n304|\tparams := Params{QuiescenceGeneration: fixtureQuiescence, ProviderProofKind: kind, TimeoutMs: 1000}\n305|\treturn context, params, mustParseState(t, \"quiescing\"), testAdmitted(\"safe_boundary_observation\")\n306|}\n307|\n308|func stopFixture(t *testing.T) (MutationContext, Params, terminalbackend.InstanceState, terminalbackend.Admitted) {\n309|\tt.Helper()\n310|\tkey := fixtureInstance + \"/stop/\" + fixtureDigestB\n311|\traw := contextDoc(fixtureOperation, fixtureSessionA, fixtureInstance, fixtureBackend, fixtureImpl, fixtureProto, fixtureGen, key, fixtureDeadline, authDoc(\"1\", nil))\n312|\tcontext, err := ParseMutationContext([]byte(raw))\n313|\tif err != nil {\n314|\t\tt.Fatalf(\"ParseMutationContext(stop) error = %v\", err)\n315|\t}\n316|\tparams := Params{SafeBoundaryEvidenceID: fixtureDigestB, GracefulTimeoutMs: 1000}\n317|\treturn context, params, mustParseState(t, \"quiescing\"), testAdmitted(\"graceful_stop\")\n318|}\n319|\n320|// TestExecutePostEffectErrorsMoveUnavailable proves an error after a\n321|// committed effect whose result cannot be proven moves the local\n322|// observation to unavailable with status_first and never claims\n323|// absent: a coded refusal on the second stop effect, an uncoded\n324|// backend failure on the first effect, malformed success evidence,\n325|// and a refusal code outside the row set.\n326|func TestExecutePostEffectErrorsMoveUnavailable(t *testing.T) {\n327|\tt.Run(\"coded refusal on second effect\", func(t *testing.T) {\n328|\t\tbackend := newMockBackend()\n329|\t\tbackend.effectErrors[terminalbackend.EffectProcessClosed] = refuse(\"terminal_backend_process_failed\", \"test crash\")\n330|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n331|\t\tcontext, params, source, admitted := stopFixture(t)\n332|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationRequestStop, context, params, source, admitted)\n333|\t\trequireRefusal(t, err, \"terminal_backend_process_failed\", \"backend effect refused\")\n334|\t\trequireLiteral(t, \"after\", string(result.After), \"unavailable\")\n335|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"status_first\")\n336|\t\tperformed := backend.performed()\n337|\t\tif len(performed) != 2 {\n338|\t\t\tt.Errorf(\"performed = %v, want the first effect committed and the second attempted\", performed)\n339|\t\t}\n340|\t})\n341|\n342|\tt.Run(\"uncoded failure on first effect\", func(t *testing.T) {\n343|\t\tbackend := newMockBackend()\n344|\t\tbackend.effectErrors[terminalbackend.EffectInputClosed] = errors.New(\"backend transport died\")\n345|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n346|\t\tcontext, params, source, admitted := quiesceFixture(t)\n347|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n348|\t\trequireRefusal(t, err, \"terminal_backend_process_failed\", \"backend effect uncertain\")\n349|\t\trequireLiteral(t, \"after\", string(result.After), \"unavailable\")\n350|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"status_first\")\n351|\t})\n352|\n353|\tt.Run(\"malformed success evidence\", func(t *testing.T) {\n354|\t\tbackend := newMockBackend()\n355|\t\tbackend.evidence[terminalbackend.EffectInputClosed] = \"not-a-digest\"\n356|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n357|\t\tcontext, params, source, admitted := quiesceFixture(t)\n358|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n359|\t\trequireRefusal(t, err, \"terminal_backend_integrity_failure\", \"backend effect evidence\")\n360|\t\trequireLiteral(t, \"after\", string(result.After), \"unavailable\")\n361|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"status_first\")\n362|\t})\n363|\n364|\tt.Run(\"code outside the row set\", func(t *testing.T) {\n365|\t\tbackend := newMockBackend()\n366|\t\tbackend.effectErrors[terminalbackend.EffectInputClosed] = refuse(\"stop_timeout\", \"test wrong row\")\n367|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n368|\t\tcontext, params, source, admitted := quiesceFixture(t)\n369|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n370|\t\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"operation error vocabulary\")\n371|\t\trequireLiteral(t, \"after\", string(result.After), \"unavailable\")\n372|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"status_first\")\n373|\t})\n374|}\n375|\n376|// TestExecuteRechecksBeforeEachEffect proves authorization and\n377|// generation are rechecked immediately before each side effect, not\n378|// once at entry: a lease rotation and a generation rotation between\n379|// the first and second stop effects are both caught at the second\n380|// recheck, after one committed effect.\n381|func TestExecuteRechecksBeforeEachEffect(t *testing.T) {\n382|\tt.Run(\"lease rotates mid-operation\", func(t *testing.T) {\n383|\t\tbackend := newMockBackend()\n384|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n385|\t\tcalls := 0\n386|\t\tengine.CurrentLease = func() LeaseView {\n387|\t\t\tcalls++\n388|\t\t\tif calls <= 2 {\n389|\t\t\t\treturn testLease()\n390|\t\t\t}\n391|\t\t\treturn LeaseView{LeaseID: fixtureLease, Epoch: 2}\n392|\t\t}\n393|\t\tcontext, params, source, admitted := stopFixture(t)\n394|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationRequestStop, context, params, source, admitted)\n395|\t\trequireRefusal(t, err, \"terminal_backend_unauthorized\", \"ax authorization lease epoch\")\n396|\t\trequireLiteral(t, \"after\", string(result.After), \"unavailable\")\n397|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"new_authorization\")\n398|\t\tif len(backend.performed()) != 1 {\n399|\t\t\tt.Errorf(\"performed = %v, want exactly the first effect committed\", backend.performed())\n400|\t\t}\n401|\t})\n402|\n403|\tt.Run(\"generation rotates mid-operation\", func(t *testing.T) {\n404|\t\tbackend := newMockBackend()\n405|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n406|\t\tcalls := 0\n407|\t\tengine.CurrentGeneration = func() string {\n408|\t\t\tcalls++\n409|\t\t\tif calls <= 2 {\n410|\t\t\t\treturn fixtureGen\n411|\t\t\t}\n412|\t\t\treturn \"generation-two\"\n413|\t\t}\n414|\t\tcontext, params, source, admitted := stopFixture(t)\n415|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationRequestStop, context, params, source, admitted)\n416|\t\trequireRefusal(t, err, \"terminal_backend_stale_generation\", \"backend_generation stale\")\n417|\t\trequireLiteral(t, \"after\", string(result.After), \"unavailable\")\n418|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"status_first\")\n419|\t\tif len(backend.performed()) != 1 {\n420|\t\t\tt.Errorf(\"performed = %v, want exactly the first effect committed\", backend.performed())\n421|\t\t}\n422|\t})\n423|\n424|\tt.Run(\"rotation before first effect restores source\", func(t *testing.T) {\n425|\t\tbackend := newMockBackend()\n426|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n427|\t\tcalls := 0\n428|\t\tengine.CurrentLease = func() LeaseView {\n429|\t\t\tcalls++\n430|\t\t\tif calls == 1 {\n431|\t\t\t\treturn testLease()\n432|\t\t\t}\n433|\t\t\treturn LeaseView{LeaseID: fixtureLeaseB, Epoch: 1}\n434|\t\t}\n435|\t\tcontext, params, source, admitted := quiesceFixture(t)\n436|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n437|\t\trequireRefusal(t, err, \"terminal_backend_unauthorized\", \"ax authorization lease identity\")\n438|\t\trequireLiteral(t, \"after\", string(result.After), \"active\")\n439|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"new_authorization\")\n440|\t\tif len(backend.performed()) != 0 {\n441|\t\t\tt.Errorf(\"performed = %v, want no effects\", backend.performed())\n442|\t\t}\n443|\t})\n444|\n445|\tt.Run(\"generation rotation before first effect restores source\", func(t *testing.T) {\n446|\t\tbackend := newMockBackend()\n447|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n448|\t\tcalls := 0\n449|\t\tengine.CurrentGeneration = func() string {\n450|\t\t\tcalls++\n451|\t\t\tif calls == 1 {\n452|\t\t\t\treturn fixtureGen\n453|\t\t\t}\n454|\t\t\treturn \"generation-two\"\n455|\t\t}\n456|\t\tcontext, params, source, admitted := quiesceFixture(t)\n457|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n458|\t\trequireRefusal(t, err, \"terminal_backend_stale_generation\", \"backend_generation stale\")\n459|\t\trequireLiteral(t, \"after\", string(result.After), \"active\")\n460|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"status_first\")\n461|\t\tif len(backend.performed()) != 0 {\n462|\t\t\tt.Errorf(\"performed = %v, want no effects\", backend.performed())\n463|\t\t}\n464|\t})\n465|}\n466|\n467|// TestExecuteDeadlineNeverCancelsCommittedEffect proves a deadline\n468|// breached after the first effect leaves the committed effect standing\n469|// and moves to unavailable: the performed prefix is reported, not\n470|// rolled back.\n471|func TestExecuteDeadlineNeverCancelsCommittedEffect(t *testing.T) {\n472|\tbackend := newMockBackend()\n473|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n474|\tbreached := false\n475|\tengine.Hooks = &EngineHooks{AfterEffect: func(terminalbackend.SideEffect) { breached = true }}\n476|\tengine.Now = func() time.Time {\n477|\t\tif breached {\n478|\t\t\treturn fixturePastDeadline()\n479|\t\t}\n480|\t\treturn fixtureNow()\n481|\t}\n482|\tcontext, params, source, admitted := stopFixture(t)\n483|\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationRequestStop, context, params, source, admitted)\n484|\trequireRefusal(t, err, \"stop_timeout\", \"operation deadline\")\n485|\trequireLiteral(t, \"after\", string(result.After), \"unavailable\")\n486|\trequireLiteral(t, \"disposition\", string(result.Disposition), \"status_first\")\n487|\tperformed := backend.performed()\n488|\tif len(performed) != 1 || performed[0] != terminalbackend.EffectGracefulStopRequested {\n489|\t\tt.Errorf(\"performed = %v, want [graceful_stop_requested] standing\", performed)\n490|\t}\n491|\tif len(result.Effects) != 1 || result.Effects[0] != terminalbackend.EffectGracefulStopRequested {\n492|\t\tt.Errorf(\"result effects = %v, want the committed prefix\", result.Effects)\n493|\t}\n494|}","final_result":true}}}
