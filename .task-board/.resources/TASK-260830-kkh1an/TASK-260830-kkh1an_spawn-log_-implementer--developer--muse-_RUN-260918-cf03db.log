{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc9b","stream":{"kind":"session","id":"01a0b291-18f0-70a0-900f-0c92cf0433eb"},"sequence":1192,"recorded_at":1780531400002379,"record_type":"event","durability":"durable","causation_id":"cb7c4ff2-7892-4304-8de0-3769502303db","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"cb7c4ff2-7892-4304-8de0-3769502303db","run_stream":{"kind":"run","id":"cb7c4ff2-7892-4304-8de0-3769502303db"},"call_id":"call_01a0b299a91e76648436b6fe75fef022","text":"Read text file `internal/terminstance/lifecycle_test.go`.\n(239 line(s) above)\n240|\n241|// TestExecuteOnlyQuiesceEntersQuiescing proves no operation other than\n242|// quiesce-input enters quiescing: across every engine operation, every\n243|// legal source and the error injections, after equals quiescing from a\n244|// non-quiescing before only for quiesce-input.\n245|func TestExecuteOnlyQuiesceEntersQuiescing(t *testing.T) {\n246|\tquiesce := func(t *testing.T) (MutationContext, Params, terminalbackend.Admitted) {\n247|\t\tcontext, params, _, admitted := quiesceFixture(t)\n248|\t\treturn context, params, admitted\n249|\t}\n250|\twait := func(t *testing.T) (MutationContext, Params, terminalbackend.Admitted) {\n251|\t\tcontext, params, _, admitted := waitFixture(t, ProofAXCheckpointBoundary)\n252|\t\treturn context, params, admitted\n253|\t}\n254|\tstop := func(t *testing.T) (MutationContext, Params, terminalbackend.Admitted) {\n255|\t\tcontext, params, _, admitted := stopFixture(t)\n256|\t\treturn context, params, admitted\n257|\t}\n258|\tcreate := func(t *testing.T) (MutationContext, Params, terminalbackend.Admitted) {\n259|\t\tfixture := testCreateContext(t)\n260|\t\treturn fixture.context, fixture.params, testAdmitted(\"terminal_state_retention\")\n261|\t}\n262|\trows := []struct {\n263|\t\toperation terminalbackend.Operation\n264|\t\tsources   []string\n265|\t\tbuild     func(*testing.T) (MutationContext, Params, terminalbackend.Admitted)\n266|\t}{\n267|\t\t{terminalbackend.OperationQuiesceInput, []string{\"active\", \"parked\"}, quiesce},\n268|\t\t{terminalbackend.OperationWaitSafeBoundary, []string{\"quiescing\"}, wait},\n269|\t\t{terminalbackend.OperationRequestStop, []string{\"quiescing\"}, stop},\n270|\t\t{terminalbackend.OperationCreate, []string{\"absent\", \"stopped\"}, create},\n271|\t}\n272|\tfor _, row := range rows {\n273|\t\tfor _, source := range row.sources {\n274|\t\t\tt.Run(string(row.operation)+\"/\"+source, func(t *testing.T) {\n275|\t\t\t\tbackend := newMockBackend()\n276|\t\t\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n277|\t\t\t\tcontext, params, admitted := row.build(t)\n278|\t\t\t\tresult, err := engine.ExecuteMutating(contextGo(), row.operation, context, params, mustParseState(t, source), admitted)\n279|\t\t\t\tif err != nil {\n280|\t\t\t\t\tt.Fatalf(\"ExecuteMutating() error = %v\", err)\n281|\t\t\t\t}\n282|\t\t\t\tif result.After == terminalbackend.StateQuiescing && result.Before != terminalbackend.StateQuiescing && row.operation != terminalbackend.OperationQuiesceInput {\n283|\t\t\t\t\tt.Errorf(\"ExecuteMutating(%s) enters quiescing from %q\", row.operation, source)\n284|\t\t\t\t}\n285|\t\t\t\tif result.After == terminalbackend.StateCreating || result.After == terminalbackend.StateStaleFenced {\n286|\t\t\t\t\tt.Errorf(\"ExecuteMutating(%s) after = %q, want never creating or stale_fenced\", row.operation, result.After)\n287|\t\t\t\t}\n288|\t\t\t})\n289|\t\t}\n290|\t}\n291|\t// The error paths never synthesize quiescing, creating or\n292|\t// stale_fenced either: after is the source or unavailable.\n293|\tbackend := newMockBackend()\n294|\tbackend.effectErrors[terminalbackend.EffectGracefulStopRequested] = errors.New(\"transport died\")\n295|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n296|\tcontext, params, source, admitted := stopFixture(t)\n297|\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationRequestStop, context, params, source, admitted)\n298|\tif err == nil {\n299|\t\tt.Fatal(\"ExecuteMutating() = nil, want the uncoded failure\")\n300|\t}\n301|\trequireLiteral(t, \"after\", string(result.After), \"unavailable\")\n302|}\n303|\n304|// TestExecuteBackendRowErrorSets proves the exact admitted refusal sets\n305|// per engine row through the production entry: every listed code passes\n306|// through with its mapped disposition, and one code outside each row's\n307|// set is rejected with the protocol class.\n308|func TestExecuteBackendRowErrorSets(t *testing.T) {\n309|\t// quiesce-input admits terminal_backend_timeout and refuses\n310|\t// stop_timeout; wait-safe-boundary admits quiesce_timeout and\n311|\t// refuses terminal_backend_timeout; request-stop admits\n312|\t// stop_timeout and refuses quiesce_timeout. The admitted stop\n313|\t// timeout is driven twice: post-commit (unavailable) and on the\n314|\t// first effect (source restored, still status_first).\n315|\tbackend := newMockBackend()\n316|\tbackend.effectErrors[terminalbackend.EffectInputClosed] = refuse(\"terminal_backend_timeout\", \"test timeout\")\n317|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n318|\tcontext, params, source, admitted := quiesceFixture(t)\n319|\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n320|\trequireRefusal(t, err, \"terminal_backend_timeout\", \"backend effect refused\")\n321|\trequireLiteral(t, \"disposition\", string(result.Disposition), \"replay_same\")\n322|\n323|\tbackendWait := newMockBackend()\n324|\tbackendWait.effectErrors[terminalbackend.EffectSafeBoundaryObserved] = refuse(\"quiesce_timeout\", \"test quiesce timeout\")\n325|\tengineWait := testEngine(t, backendWait, testLease(), fixtureGen)\n326|\twaitContext, waitParams, waitSource, waitAdmitted := waitFixture(t, ProofAXCheckpointBoundary)\n327|\twaitResult, err := engineWait.ExecuteMutating(contextGo(), terminalbackend.OperationWaitSafeBoundary, waitContext, waitParams, waitSource, waitAdmitted)\n328|\trequireRefusal(t, err, \"quiesce_timeout\", \"backend effect refused\")\n329|\trequireLiteral(t, \"wait after\", string(waitResult.After), \"quiescing\")\n330|\trequireLiteral(t, \"wait disposition\", string(waitResult.Disposition), \"replay_same\")\n331|\n332|\tbackendWaitOutside := newMockBackend()\n333|\tbackendWaitOutside.effectErrors[terminalbackend.EffectSafeBoundaryObserved] = refuse(\"terminal_backend_timeout\", \"test outside set\")\n334|\tengineWaitOutside := testEngine(t, backendWaitOutside, testLease(), fixtureGen)\n335|\twaitContext2, waitParams2, waitSource2, waitAdmitted2 := waitFixture(t, ProofAXCheckpointBoundary)\n336|\twaitContext2.OperationID = fixtureOperationB\n337|\t_, err = engineWaitOutside.ExecuteMutating(contextGo(), terminalbackend.OperationWaitSafeBoundary, waitContext2, waitParams2, waitSource2, waitAdmitted2)\n338|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"operation error vocabulary\")\n339|\n340|\tbackendStop := newMockBackend()\n341|\tbackendStop.effectErrors[terminalbackend.EffectBackendStoreClosed] = refuse(\"stop_timeout\", \"test stop timeout\")\n342|\tengineStop := testEngine(t, backendStop, testLease(), fixtureGen)\n343|\tstopContext, stopParams, stopSource, stopAdmitted := stopFixture(t)\n344|\tstopResult, err := engineStop.ExecuteMutating(contextGo(), terminalbackend.OperationRequestStop, stopContext, stopParams, stopSource, stopAdmitted)\n345|\trequireRefusal(t, err, \"stop_timeout\", \"backend effect refused\")\n346|\trequireLiteral(t, \"stop after\", string(stopResult.After), \"unavailable\")\n347|\trequireLiteral(t, \"stop disposition\", string(stopResult.Disposition), \"status_first\")\n348|\n349|\tbackendStopOutside := newMockBackend()\n350|\tbackendStopOutside.effectErrors[terminalbackend.EffectGracefulStopRequested] = refuse(\"quiesce_timeout\", \"test outside set\")\n351|\tengineStopOutside := testEngine(t, backendStopOutside, testLease(), fixtureGen)\n352|\tstopContext2, stopParams2, stopSource2, stopAdmitted2 := stopFixture(t)\n353|\tstopContext2.OperationID = fixtureOperationB\n354|\t_, err = engineStopOutside.ExecuteMutating(contextGo(), terminalbackend.OperationRequestStop, stopContext2, stopParams2, stopSource2, stopAdmitted2)\n355|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"operation error vocabulary\")\n356|\n357|\t// A backend-REPORTED stop_timeout on the first effect restores the\n358|\t// source but still routes through status: the graceful wait ran\n359|\t// and timed out, unlike the entry cancel that never attempted it.\n360|\tbackendStopFirst := newMockBackend()\n361|\tbackendStopFirst.effectErrors[terminalbackend.EffectGracefulStopRequested] = refuse(\"stop_timeout\", \"test graceful wait timed out\")\n362|\tengineStopFirst := testEngine(t, backendStopFirst, testLease(), fixtureGen)\n363|\tstopContext3, stopParams3, stopSource3, stopAdmitted3 := stopFixture(t)\n364|\tstopFirst, err := engineStopFirst.ExecuteMutating(contextGo(), terminalbackend.OperationRequestStop, stopContext3, stopParams3, stopSource3, stopAdmitted3)\n365|\trequireRefusal(t, err, \"stop_timeout\", \"backend effect refused\")\n366|\trequireLiteral(t, \"stop first-effect after\", string(stopFirst.After), \"quiescing\")\n367|\trequireLiteral(t, \"stop first-effect disposition\", string(stopFirst.Disposition), \"status_first\")\n368|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc9d","stream":{"kind":"session","id":"01a0b291-18f0-70a0-900f-0c92cf0433eb"},"sequence":1193,"recorded_at":1780531400002381,"record_type":"event","durability":"durable","causation_id":"cb7c4ff2-7892-4304-8de0-3769502303db","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"cb7c4ff2-7892-4304-8de0-3769502303db","run_stream":{"kind":"run","id":"cb7c4ff2-7892-4304-8de0-3769502303db"},"call_id":"call_01a0b299ac3076f589cf72f90029cd8d","text":"Read text file `internal/terminstance/result.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"sort\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n8|)\n9|\n10|// Result is the closed §4.C MutationResult object in harness form: it\n11|// repeats the request context identities and adds before/after state,\n12|// side effects, evidence IDs and exactly one retry disposition. The\n13|// engine populates it on every path, success or failure, so the retry\n14|// disposition and the local observation are always readable; failures\n15|// additionally carry the *Error.\n16|type Result struct {\n17|\tOperationID           string\n18|\tSessionID             string\n19|\tTerminalInstanceID    string\n20|\tTerminalBackendID     string\n21|\tImplementationVersion string\n22|\tProtocolVersion       string\n23|\tBackendGeneration     string\n24|\tBefore                terminalbackend.InstanceState\n25|\tAfter                 terminalbackend.InstanceState\n26|\tEffects               []terminalbackend.SideEffect\n27|\tEvidenceIDs           []string\n28|\tDisposition           RetryDisposition\n29|}\n30|\n31|// CheckResult enforces the §4.C result rule: every repeated identity\n32|// equals the request context, before equals the source state the engine\n33|// executed from, states and effects parse through the landed vocabularies,\n34|// side effects are sorted-unique TerminalBackendSideEffect[0..10],\n35|// evidence IDs are sorted-unique digest[0..256], and the disposition\n36|// parses. Each repeated identity is its own arm with its own detail so a\n37|// mutant dropping one comparison is killed by that member's tamper test.\n38|func CheckResult(context MutationContext, source terminalbackend.InstanceState, result Result) error {\n39|\tif result.OperationID != context.OperationID {\n40|\t\treturn refuse(CodeProtocolError, \"result operation binding\")\n41|\t}\n42|\tif result.SessionID != context.SessionID {\n43|\t\treturn refuse(CodeProtocolError, \"result session binding\")\n44|\t}\n45|\tif result.TerminalInstanceID != context.TerminalInstanceID {\n46|\t\treturn refuse(CodeProtocolError, \"result instance binding\")\n47|\t}\n48|\tif result.TerminalBackendID != context.TerminalBackendID {\n49|\t\treturn refuse(CodeProtocolError, \"result backend binding\")\n50|\t}\n51|\tif result.ImplementationVersion != context.ImplementationVersion {\n52|\t\treturn refuse(CodeProtocolError, \"result implementation binding\")\n53|\t}\n54|\tif result.ProtocolVersion != context.ProtocolVersion {\n55|\t\treturn refuse(CodeProtocolError, \"result protocol binding\")\n56|\t}\n57|\tif result.BackendGeneration != context.BackendGeneration {\n58|\t\treturn refuse(CodeStaleGeneration, \"result generation binding\")\n59|\t}\n60|\tif _, err := terminalbackend.ParseInstanceState(string(result.Before)); err != nil {\n61|\t\treturn wrapLanded(err)\n62|\t}\n63|\tif _, err := terminalbackend.ParseInstanceState(string(result.After)); err != nil {\n64|\t\treturn wrapLanded(err)\n65|\t}\n66|\tif result.Before != source {\n67|\t\treturn refuse(CodeProtocolError, \"result before state\")\n68|\t}\n69|\tif err := checkSortedUniqueEffects(result.Effects); err != nil {\n70|\t\treturn err\n71|\t}\n72|\tif err := checkSortedUniqueEvidence(result.EvidenceIDs); err != nil {\n73|\t\treturn err\n74|\t}\n75|\tif _, err := ParseRetryDisposition(string(result.Disposition)); err != nil {\n76|\t\treturn err\n77|\t}\n78|\treturn nil\n79|}\n80|\n81|// checkSortedUniqueEffects enforces sorted-unique [0..10] over parsed\n82|// side effects. Order and uniqueness are two obligations with two arms:\n83|// an unsorted-but-unique vector and a sorted-but-duplicated vector are\n84|// refused by different details, so a mutant dropping either half is\n85|// killed by its own vector.\n86|func checkSortedUniqueEffects(effects []terminalbackend.SideEffect) error {\n87|\tif len(effects) > 10 {\n88|\t\treturn refuse(CodeProtocolError, \"result effects bound\")\n89|\t}\n90|\tfor _, effect := range effects {\n91|\t\tif _, err := terminalbackend.ParseSideEffect(string(effect)); err != nil {\n92|\t\t\treturn wrapLanded(err)\n93|\t\t}\n94|\t}\n95|\tfor index := 1; index < len(effects); index++ {\n96|\t\tif effects[index-1] == effects[index] {\n97|\t\t\treturn refuse(CodeProtocolError, \"result effects unique\")\n98|\t\t}\n99|\t}\n100|\tfor index := 1; index < len(effects); index++ {\n101|\t\tif effects[index-1] > effects[index] {\n102|\t\t\treturn refuse(CodeProtocolError, \"result effects order\")\n103|\t\t}\n104|\t}\n105|\treturn nil\n106|}\n107|\n108|// checkSortedUniqueEvidence enforces sorted-unique digest[0..256] on a\n109|// mutation result. Order and uniqueness are separate arms for the same\n110|// reason as the effects twin: each half owns its mutant.\n111|func checkSortedUniqueEvidence(evidence []string) error {\n112|\treturn checkSortedUniqueEvidenceWhere(evidence, \"result\")\n113|}\n114|\n115|// checkSortedUniqueStatusEvidence enforces the same sorted-unique\n116|// digest[0..256] rule on a status report. The rule is shared; only the\n117|// static detail site differs, so a status mutant and a result mutant\n118|// cannot kill each other's arm.\n119|func checkSortedUniqueStatusEvidence(evidence []string) error {\n120|\treturn checkSortedUniqueEvidenceWhere(evidence, \"status\")\n121|}\n122|\n123|func checkSortedUniqueEvidenceWhere(evidence []string, where string) error {\n124|\tif len(evidence) > 256 {\n125|\t\treturn refuse(CodeProtocolError, where+\" evidence bound\")\n126|\t}\n127|\tfor _, id := range evidence {\n128|\t\tif _, err := scalar.ParseDigest(id); err != nil {\n129|\t\t\treturn refuse(CodeProtocolError, where+\" evidence digest\")\n130|\t\t}\n131|\t}\n132|\tfor index := 1; index < len(evidence); index++ {\n133|\t\tif evidence[index-1] == evidence[index] {\n134|\t\t\treturn refuse(CodeProtocolError, where+\" evidence unique\")\n135|\t\t}\n136|\t}\n137|\tfor index := 1; index < len(evidence); index++ {\n138|\t\tif evidence[index-1] > evidence[index] {\n139|\t\t\treturn refuse(CodeProtocolError, where+\" evidence order\")\n140|\t\t}\n141|\t}\n142|\treturn nil\n143|}\n144|\n145|// buildResult assembles the engine result on every path. Effects and\n146|// evidence are reported sorted: execution order is the transition order\n147|// (request-stop commits graceful_stop_requested before process_closed\n148|// before backend_store_closed), while the wire order is bytewise sorted,\n149|// so the engine sorts a copy and never reorders execution.\n150|func buildResult(context MutationContext, before, after terminalbackend.InstanceState, effects []terminalbackend.SideEffect, evidence []string, disposition RetryDisposition) Result {\n151|\tordered := append([]terminalbackend.SideEffect(nil), effects...)\n152|\tsort.Slice(ordered, func(i, j int) bool { return ordered[i] < ordered[j] })\n153|\torderedEvidence := append([]string(nil), evidence...)\n154|\tsort.Strings(orderedEvidence)\n155|\treturn Result{\n156|\t\tOperationID:           context.OperationID,\n157|\t\tSessionID:             context.SessionID,\n158|\t\tTerminalInstanceID:    context.TerminalInstanceID,\n159|\t\tTerminalBackendID:     context.TerminalBackendID,\n160|\t\tImplementationVersion: context.ImplementationVersion,\n161|\t\tProtocolVersion:       context.ProtocolVersion,\n162|\t\tBackendGeneration:     context.BackendGeneration,\n163|\t\tBefore:                before,\n164|\t\tAfter:                 after,\n165|\t\tEffects:               ordered,\n166|\t\tEvidenceIDs:           orderedEvidence,\n167|\t\tDisposition:           disposition,\n168|\t}\n169|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
