quested && result.ProviderEvidenced) {\\n786-\\t\\treturn refuse(&Error{Code: CodeProtocolError, Detail: \\\"status provider observation\\\"})\\n787-\\t}\\n788-\\tif result.Attachable && !((result.State == StateParked || result.State == StateActive) && result.AttachEvidenced) {\\n789-\\t\\treturn refuse(&Error{Code: CodePreconditionFailed, Detail: \\\"status attachability\\\"})\\n790-\\t}\\n791-\\treturn nil\\n792-}\\n793-\\n794-// ParseSideEffect admits exactly the ten §4.C side effects.\\n795-func ParseSideEffect(value string) (SideEffect, error) {\\n796-\\tswitch SideEffect(value) {\\n797-\\tcase EffectBindingPersisted, EffectWrapperStarted, EffectAttachClientCreated,\\n798-\\t\\tEffectInputClosed, EffectSafeBoundaryObserved, EffectGracefulStopRequested,\\n799-\\t\\tEffectProcessClosed, EffectBackendStoreClosed,\\n800-\\t\\tEffectStaleIncarnationTerminated, EffectWrapperRestored:\\n801-\\t\\treturn SideEffect(value), nil\\n802-\\tdefault:\\n803-\\t\\treturn \\\"\\\", refuse(&Error{Code: CodeProtocolError, Detail: \\\"side effect vocabulary\\\"})\\n804-\\t}\\n805-}\\n806-\\n807-// ReplicationClass is the §4.E persistence classification. Only\\n808-// safe_evidence MAY persist and replicate after validation; every other\\n809-// class is host-local, rebuildable, owner-only, or forbidden.\\n810-type ReplicationClass string\\n811-\\n812-// Replication classes.\\n813-const (\\n814-\\tReplicationSafeEvidence       ReplicationClass = \\\"safe_evidence\\\"\\n815-\\tReplicationHostLocal          ReplicationClass = \\\"host_local\\\"\\n816-\\tReplicationDerivedCache       ReplicationClass = \\\"derived_cache\\\"\\n817-\\tReplicationSensitiveOwnerOnly ReplicationClass = \\\"sensitive_owner_only\\\"\\n818-\\tReplicationForbidden          ReplicationClass = \\\"forbidden\\\"\\n819-)\\n820-\\n821-// replicationMembers is the closed §4.E classification table. Member\\n822-// names are wire vocabulary, never local data: classifying a member the\\n823-// table does not know is re