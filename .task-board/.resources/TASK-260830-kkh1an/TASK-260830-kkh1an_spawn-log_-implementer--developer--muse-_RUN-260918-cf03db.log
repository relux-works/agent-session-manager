es with inconsistent keys; other bodies still refuse.\",\n250|    ),\n251|    Mutant(\n252|        name=\"N-result-operation\",\n253|        path=f\"{PACKAGE}/result.go\",\n254|        find=\"\\tif result.OperationID != context.OperationID {\\n\",\n255|        replace='\\tif result.OperationID != context.OperationID && result.OperationID != \"0198f4c8-8e50-7f66-8f70-ccccccccccc2\" {\\n',\n256|        count=1,\n257|        run=\"TestCheckResultRepetitionTamper/operation\",\n258|        expect=\"KILLED\",\n259|        note=\"Admits exactly the tampered test operation ID; other operation tampers still refuse.\",\n260|    ),\n261|    Mutant(\n262|        name=\"N-result-session\",\n263|        path=f\"{PACKAGE}/result.go\",\n264|        find=\"\\tif result.SessionID != context.SessionID {\\n\",\n265|        replace='\\tif result.SessionID != context.SessionID && result.SessionID != \"0198f4c8-8e50-7f66-8f70-1234567890ac\" {\\n',\n266|        count=1,\n267|        run=\"TestCheckResultRepetitionTamper/session\",\n268|        expect=\"KILLED\",\n269|        note=\"Admits exactly the tampered test session; other session tampers still refuse.\",\n270|    ),\n271|    Mutant(\n272|        name=\"N-result-instance\",\n273|        path=f\"{PACKAGE}/result.go\",\n274|        find=\"\\tif result.TerminalInstanceID != context.TerminalInstanceID {\\n\",\n275|        replace='\\tif result.TerminalInstanceID != context.TerminalInstanceID && result.TerminalInstanceID != \"0198f4c8-8e50-7f66-8f70-1234567890ac\" {\\n',\n276|        count=1,\n277|        run=\"TestCheckResultRepetitionTamper/instance\",\n278|        expect=\"KILLED\",\n279|        note=\"Admits exactly the tampered test instance; other instance tampers still refuse.\",\n280|    ),\n281|    Mutant(\n282|        name=\"N-result-backend\",\n283|        path=f\"{PACKAGE}/result.go\",\n284|        find=\"\\tif result.TerminalBackendID != context.TerminalBackendID {\\n\",\n285|        replace='\\tif result.TerminalBackendID !=