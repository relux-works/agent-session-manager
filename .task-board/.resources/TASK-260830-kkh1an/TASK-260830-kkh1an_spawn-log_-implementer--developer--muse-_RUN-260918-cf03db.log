{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c73d","stream":{"kind":"session","id":"01a0b291-18f0-70a0-900f-0c92cf0433eb"},"sequence":505,"recorded_at":1780531400001005,"record_type":"event","durability":"durable","causation_id":"cb7c4ff2-7892-4304-8de0-3769502303db","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"cb7c4ff2-7892-4304-8de0-3769502303db","run_stream":{"kind":"run","id":"cb7c4ff2-7892-4304-8de0-3769502303db"},"call_id":"call_01a0b2927d8974b6adfe0c8271d0754f","text":"Read text file `/tmp/rv2ev/probes/zz_review2_witness_test.go`.\n1|package terminstance\n2|\n3|// Delta witnesses for the RV2 reviewer mutants: each test PASSES on the\n4|// pristine candidate and FAILS under its mutant, proving the survivor is\n5|// non-equivalent (observable behaviour changes) and that no committed\n6|// test covers the arm.\n7|\n8|import (\n9|\t\"strings\"\n10|\t\"testing\"\n11|\t\"time\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n14|)\n15|\n16|// RV2-M1: lease rotates exactly before the THIRD stop effect.\n17|func TestRV2W_M1_LeaseRotatesBeforeThirdEffect(t *testing.T) {\n18|\tbackend := newMockBackend()\n19|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n20|\tcalls := 0\n21|\tengine.CurrentLease = func() LeaseView {\n22|\t\tcalls++\n23|\t\tif calls <= 3 { // entry, pre-effect 1, pre-effect 2\n24|\t\t\treturn testLease()\n25|\t\t}\n26|\t\treturn LeaseView{LeaseID: fixtureLease, Epoch: 2}\n27|\t}\n28|\tcontext, params, source, admitted := stopFixture(t)\n29|\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationRequestStop, context, params, source, admitted)\n30|\tt.Logf(\"err=%v after=%q disposition=%q performed=%v\", err, result.After, result.Disposition, backend.performed())\n31|\trequireRefusal(t, err, \"terminal_backend_unauthorized\", \"ax authorization lease epoch\")\n32|\tif len(backend.performed()) != 2 {\n33|\t\tt.Errorf(\"performed = %v, want exactly two effects before the rotated lease is caught\", backend.performed())\n34|\t}\n35|}\n36|\n37|// RV2-M2: generation rotates exactly before the THIRD stop effect.\n38|func TestRV2W_M2_GenerationRotatesBeforeThirdEffect(t *testing.T) {\n39|\tbackend := newMockBackend()\n40|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n41|\tcalls := 0\n42|\tengine.CurrentGeneration = func() string {\n43|\t\tcalls++\n44|\t\tif calls <= 3 {\n45|\t\t\treturn fixtureGen\n46|\t\t}\n47|\t\treturn \"generation-two\"\n48|\t}\n49|\tcontext, params, source, admitted := stopFixture(t)\n50|\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationRequestStop, context, params, source, admitted)\n51|\tt.Logf(\"err=%v after=%q disposition=%q performed=%v\", err, result.After, result.Disposition, backend.performed())\n52|\trequireRefusal(t, err, \"terminal_backend_stale_generation\", \"backend_generation stale\")\n53|\tif len(backend.performed()) != 2 {\n54|\t\tt.Errorf(\"performed = %v, want exactly two effects\", backend.performed())\n55|\t}\n56|}\n57|\n58|// RV2-M3 / RV2-M4: now == deadline_at refuses at both entries.\n59|func TestRV2W_M3_M4_DeadlineInstant(t *testing.T) {\n60|\tdeadline, _ := time.Parse(time.RFC3339Nano, fixtureDeadline)\n61|\tbackend := newMockBackend()\n62|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n63|\tengine.Now = func() time.Time { return deadline }\n64|\tcontext, params, source, admitted := quiesceFixture(t)\n65|\t_, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n66|\trequireRefusal(t, err, \"terminal_backend_timeout\", \"operation deadline\")\n67|\tif len(backend.performed()) != 0 {\n68|\t\tt.Errorf(\"performed = %v at the deadline instant\", backend.performed())\n69|\t}\n70|\tif _, found, _ := engine.Store.Lookup(context.IdempotencyKey); found {\n71|\t\tt.Error(\"a receipt was bound for a request whose deadline had already arrived (entry deadline admitted the instant)\")\n72|\t}\n73|\tbackendS := newMockBackend()\n74|\tbackendS.observation = matchingObservation()\n75|\tengineS := testEngine(t, backendS, testLease(), fixtureGen)\n76|\tengineS.Now = func() time.Time { return deadline }\n77|\t_, err = engineS.ExecuteStatus(contextGo(), exactStatusBody(t), source, testAdmitted(\"durable_disconnect\"))\n78|\trequireRefusal(t, err, \"terminal_backend_timeout\", \"operation deadline\")\n79|}\n80|\n81|// RV2-M5: create's SECOND effect (wrapper_started) reports\n82|// terminal_backend_timeout after binding_persisted committed.\n83|func TestRV2W_M5_CommittedTimeoutOnCreateSecondEffect(t *testing.T) {\n84|\tcreate := testCreateContext(t)\n85|\tbackend := newMockBackend()\n86|\tbackend.effectErrors[terminalbackend.EffectWrapperStarted] = refuse(\"terminal_backend_timeout\", \"test wrapper timeout\")\n87|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n88|\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, create.context, create.params, mustParseState(t, \"absent\"), testAdmitted(\"terminal_state_retention\"))\n89|\tt.Logf(\"err=%v after=%q disposition=%q performed=%v\", err, result.After, result.Disposition, backend.performed())\n90|\trequireRefusal(t, err, \"terminal_backend_timeout\", \"backend effect refused\")\n91|\trequireLiteral(t, \"after\", string(result.After), \"unavailable\")\n92|\trequireLiteral(t, \"disposition\", string(result.Disposition), \"status_first\")\n93|}\n94|\n95|// RV2-M6: authorization_kind \"attach\" is not an AXAuthorization kind.\n96|func TestRV2W_M6_AttachKindRefused(t *testing.T) {\n97|\traw := authDoc(\"1\", map[string]*string{\"authorization_kind\": strptr(`\"attach\"`)})\n98|\t_, err := ParseAXAuthorization([]byte(raw))\n99|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"ax authorization kind\")\n100|\tkey := fixtureInstance + \"/quiesce/\" + fixtureQuiescence\n101|\tctxRaw := contextDoc(fixtureOperation, fixtureSessionA, fixtureInstance, fixtureBackend, fixtureImpl, fixtureProto, fixtureGen, key, fixtureDeadline, raw)\n102|\t_, err = ParseMutationContext([]byte(ctxRaw))\n103|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"ax authorization kind\")\n104|}\n105|\n106|// RV2-M7: create under a stale generation refuses at entry.\n107|func TestRV2W_M7_CreateStaleGenerationRefuses(t *testing.T) {\n108|\tcreate := testCreateContext(t)\n109|\tbackend := newMockBackend()\n110|\tengine := testEngine(t, backend, testLease(), \"generation-two\")\n111|\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, create.context, create.params, mustParseState(t, \"absent\"), testAdmitted(\"terminal_state_retention\"))\n112|\tt.Logf(\"err=%v after=%q disposition=%q performed=%v\", err, result.After, result.Disposition, backend.performed())\n113|\trequireRefusal(t, err, \"terminal_backend_stale_generation\", \"backend_generation stale\")\n114|\tif len(backend.performed()) != 0 {\n115|\t\tt.Errorf(\"performed = %v under a stale generation\", backend.performed())\n116|\t}\n117|\tif _, found, _ := engine.Store.Lookup(create.context.IdempotencyKey); found {\n118|\t\tt.Error(\"a receipt was bound under a stale generation\")\n119|\t}\n120|}\n121|\n122|// RV2-M8: create with a control-kind, an expired, and a foreign-lease\n123|// authorization refuses at entry.\n124|func TestRV2W_M8_CreateAuthorizationRefuses(t *testing.T) {\n125|\tt.Run(\"control kind presented as create\", func(t *testing.T) {\n126|\t\tcreate := testCreateContext(t)\n127|\t\tcreate.context.Authorization = testAuth(t) // kind control\n128|\t\tbackend := newMockBackend()\n129|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n130|\t\t_, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, create.context, create.params, mustParseState(t, \"absent\"), testAdmitted(\"terminal_state_retention\"))\n131|\t\trequireRefusal(t, err, \"terminal_backend_unauthorized\", \"ax authorization kind binding\")\n132|\t\tif len(backend.performed()) != 0 {\n133|\t\t\tt.Errorf(\"performed = %v with a control authorization\", backend.performed())\n134|\t\t}\n135|\t\tif _, found, _ := engine.Store.Lookup(create.context.IdempotencyKey); found {\n136|\t\t\tt.Error(\"a receipt was bound for a create presented with a control authorization (the bootstrap key is now poisoned)\")\n137|\t\t}\n138|\t})\n139|\tt.Run(\"expired\", func(t *testing.T) {\n140|\t\tcreate := testCreateContext(t)\n141|\t\tbackend := newMockBackend()\n142|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n143|\t\tengine.Now = fixtureLater\n144|\t\t_, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, create.context, create.params, mustParseState(t, \"absent\"), testAdmitted(\"terminal_state_retention\"))\n145|\t\trequireRefusal(t, err, \"terminal_backend_unauthorized\", \"ax authorization expiry\")\n146|\t\tif len(backend.performed()) != 0 {\n147|\t\t\tt.Errorf(\"performed = %v with an expired authorization\", backend.performed())\n148|\t\t}\n149|\t})\n150|\tt.Run(\"foreign lease\", func(t *testing.T) {\n151|\t\tcreate := testCreateContext(t)\n152|\t\tbackend := newMockBackend()\n153|\t\tengine := testEngine(t, backend, LeaseView{LeaseID: fixtureLeaseB, Epoch: 1}, fixtureGen)\n154|\t\t_, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, create.context, create.params, mustParseState(t, \"absent\"), testAdmitted(\"terminal_state_retention\"))\n155|\t\trequireRefusal(t, err, \"terminal_backend_unauthorized\", \"ax authorization lease identity\")\n156|\t\tif len(backend.performed()) != 0 {\n157|\t\t\tt.Errorf(\"performed = %v under a foreign winning lease\", backend.performed())\n158|\t\t}\n159|\t\tif _, found, _ := engine.Store.Lookup(create.context.IdempotencyKey); found {\n160|\t\t\tt.Error(\"a receipt was bound for a create under a foreign winning lease (the bootstrap key is now poisoned)\")\n161|\t\t}\n162|\t})\n163|}\n164|\n165|// RV2-M9: a lying match with only the implementation version drifted.\n166|func TestRV2W_M9_LyingMatchOnImplementationAxis(t *testing.T) {\n167|\tbackend := newMockBackend()\n168|\tobserved := matchingObservation()\n169|\tobserved.ImplVersion = \"1.2.4\"\n170|\tbackend.observation = observed\n171|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n172|\t_, err := engine.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n173|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"status identity binding\")\n174|}\n175|\n176|// RV2-M10: headless create from ABSENT without headless_creation.\n177|func TestRV2W_M10_HeadlessCreateFromAbsentNeedsCapability(t *testing.T) {\n178|\tcreate := testCreateContext(t)\n179|\tcreate.params.Interactive = false\n180|\tbackend := newMockBackend()\n181|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n182|\t_, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, create.context, create.params, mustParseState(t, \"absent\"), testAdmitted(\"terminal_state_retention\"))\n183|\trequireRefusal(t, err, \"terminal_backend_capability_unproven\", \"operation capability conditional\")\n184|\tif len(backend.performed()) != 0 {\n185|\t\tt.Errorf(\"performed = %v for a headless create without headless_creation\", backend.performed())\n186|\t}\n187|}\n188|\n189|// RV2-M15: a session-scoped lookup whose backend reports ANOTHER\n190|// session's instance with identity_match true must refuse, never adopt.\n191|func TestRV2W_M15_SessionScopedForeignSessionRefuses(t *testing.T) {\n192|\tbody, err := ParseStatusBody([]byte(statusDoc(`null`, `null`)))\n193|\tif err != nil {\n194|\t\tt.Fatal(err)\n195|\t}\n196|\tbackend := newMockBackend()\n197|\tobserved := matchingObservation()\n198|\tobserved.SessionID = fixtureSessionB\n199|\tbackend.observation = observed\n200|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n201|\treport, err := engine.ExecuteStatus(contextGo(), body, mustParseState(t, \"absent\"), testAdmitted(\"durable_disconnect\"))\n202|\tt.Logf(\"err=%v report=%+v\", err, report)\n203|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"status identity binding\")\n204|}\n205|\n206|var _ = strings.Repeat","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c73f","stream":{"kind":"session","id":"01a0b291-18f0-70a0-900f-0c92cf0433eb"},"sequence":506,"recorded_at":1780531400001007,"record_type":"event","durability":"durable","causation_id":"cb7c4ff2-7892-4304-8de0-3769502303db","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"cb7c4ff2-7892-4304-8de0-3769502303db","run_stream":{"kind":"run","id":"cb7c4ff2-7892-4304-8de0-3769502303db"},"call_id":"call_01a0b2927f617437a931e738f7657228","text":"Read text file `/tmp/rv2ev/probes/review2_mutants.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Reviewer narrowing mutants for CR-TASK-260830-kkh1an-2 (RUN-260918-4f5cc1).\n3|\n4|Killer: the WHOLE committed internal/terminstance suite (not a scoped\n5|-run), so a SURVIVED verdict means no committed test observes the\n6|narrowing. Each row is M (patch one production file in place), R (go\n7|test ./internal/terminstance -count=1), V (KILLED iff the run fails with\n8|a test failure line; SURVIVED iff exit 0; ERROR otherwise), restore.\n9|Raw per-plant output with the subprocess exit is written by the caller.\n10|\"\"\"\n11|import os, shutil, subprocess, sys, tempfile\n12|from dataclasses import dataclass\n13|from pathlib import Path\n14|\n15|REPO = Path(sys.argv[1]).resolve()\n16|OUT = Path(sys.argv[2]).resolve()\n17|PACKAGE = \"internal/terminstance\"\n18|\n19|@dataclass(frozen=True)\n20|class Mutant:\n21|    name: str\n22|    path: str\n23|    find: str\n24|    replace: str\n25|    kind: str   # NARROWING / CONTROL\n26|    note: str\n27|\n28|M = [\n29|    Mutant(\"RV2-M1-recheck-auth-third-effect\", f\"{PACKAGE}/execute.go\",\n30|        \"\\t\\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil {\\n\\t\\t\\tfailure := err.(*Error)\\n\\t\\t\\tafter := source\\n\",\n31|        \"\\t\\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil && len(performed) < 2 {\\n\\t\\t\\tfailure := err.(*Error)\\n\\t\\t\\tafter := source\\n\",\n32|        \"NARROWING\", \"Per-effect auth recheck skipped exactly before the THIRD effect (request-stop's backend_store_closed); rechecks before effects 1 and 2 stay.\"),\n33|    Mutant(\"RV2-M2-recheck-generation-third-effect\", f\"{PACKAGE}/execute.go\",\n34|        \"\\t\\tif engine.CurrentGeneration() != context.BackendGeneration {\\n\\t\\t\\tfailure := refuse(CodeStaleGeneration, \\\"backend_generation stale\\\")\\n\\t\\t\\tafter := source\\n\",\n35|        \"\\t\\tif engine.CurrentGeneration() != context.BackendGeneration && len(performed) < 2 {\\n\\t\\t\\tfailure := refuse(CodeStaleGeneration, \\\"backend_generation stale\\\")\\n\\t\\t\\tafter := source\\n\",\n36|        \"NARROWING\", \"Per-effect generation recheck skipped exactly before the THIRD effect.\"),\n37|    Mutant(\"RV2-M3-entry-deadline-instant\", f\"{PACKAGE}/execute.go\",\n38|        \"\\tif !engine.Now().Before(deadline) {\\n\\t\\tfailure := refuse(rowTimeoutCode(operation), \\\"operation deadline\\\")\\n\\t\\treturn buildResult(context, source, source, nil, nil, DispositionReplaySame), failure\\n\\t}\\n\",\n39|        \"\\tif engine.Now().After(deadline) {\\n\\t\\tfailure := refuse(rowTimeoutCode(operation), \\\"operation deadline\\\")\\n\\t\\treturn buildResult(context, source, source, nil, nil, DispositionReplaySame), failure\\n\\t}\\n\",\n40|        \"NARROWING\", \"Entry deadline widened by one instant: now == deadline_at is admitted (bound edge).\"),\n41|    Mutant(\"RV2-M4-status-deadline-instant\", f\"{PACKAGE}/execute.go\",\n42|        \"\\tif !engine.Now().Before(deadline) {\\n\\t\\treturn empty, refuse(CodeTimeout, \\\"operation deadline\\\")\\n\\t}\\n\",\n43|        \"\\tif engine.Now().After(deadline) {\\n\\t\\treturn empty, refuse(CodeTimeout, \\\"operation deadline\\\")\\n\\t}\\n\",\n44|        \"NARROWING\", \"Status deadline widened by one instant: now == deadline_at is admitted (bound edge).\"),\n45|    Mutant(\"RV2-M5-committed-timeout-disposition\", f\"{PACKAGE}/execute.go\",\n46|        \"\\t\\t\\tfailure := refuse(code, \\\"backend effect refused\\\")\\n\\t\\t\\treturn buildResult(context, source, after, performed, evidence, DispositionFor(code, committed)), failure\\n\",\n47|        \"\\t\\t\\tfailure := refuse(code, \\\"backend effect refused\\\")\\n\\t\\t\\treturn buildResult(context, source, after, performed, evidence, DispositionFor(code, committed && code != CodeTimeout)), failure\\n\",\n48|        \"NARROWING\", \"Disposition mapping collapsed at the engine for exactly a COMMITTED terminal_backend_timeout (create's second effect): reports replay_same instead of status_first.\"),\n49|    Mutant(\"RV2-M6-authkind-admits-attach\", f\"{PACKAGE}/auth.go\",\n50|        \"\\tdefault:\\n\\t\\treturn \\\"\\\", refuse(CodeProtocolError, \\\"ax authorization kind\\\")\\n\\t}\\n\",\n51|        \"\\tdefault:\\n\\t\\tif value == \\\"attach\\\" {\\n\\t\\t\\treturn AuthorizationControl, nil\\n\\t\\t}\\n\\t\\treturn \\\"\\\", refuse(CodeProtocolError, \\\"ax authorization kind\\\")\\n\\t}\\n\",\n52|        \"NARROWING\", \"Closed AuthorizationKind admits exactly the landed 'attach' name (an AttachAuthorization kind, never an AXAuthorization kind) as control.\"),\n53|    Mutant(\"RV2-M7-entry-generation-exempts-create\", f\"{PACKAGE}/execute.go\",\n54|        \"\\tif engine.CurrentGeneration() != context.BackendGeneration {\\n\\t\\tfailure := refuse(CodeStaleGeneration, \\\"backend_generation stale\\\")\\n\\t\\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\\n\",\n55|        \"\\tif engine.CurrentGeneration() != context.BackendGeneration && operation != terminalbackend.OperationCreate {\\n\\t\\tfailure := refuse(CodeStaleGeneration, \\\"backend_generation stale\\\")\\n\\t\\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\\n\",\n56|        \"NARROWING\", \"Entry generation gate exempts exactly the create row.\"),\n57|    Mutant(\"RV2-M8-entry-auth-exempts-create\", f\"{PACKAGE}/execute.go\",\n58|        \"\\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil {\\n\\t\\tfailure := err.(*Error)\\n\\t\\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\\n\",\n59|        \"\\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil && operation != terminalbackend.OperationCreate {\\n\\t\\tfailure := err.(*Error)\\n\\t\\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\\n\",\n60|        \"NARROWING\", \"Entry authorization gate exempts exactly the create row (a control/expired/foreign-lease authorization creates).\"),\n61|    Mutant(\"RV2-M9-status-match-drops-implementation\", f\"{PACKAGE}/execute.go\",\n62|        \"\\t\\tobserved.ImplVersion == body.ImplementationVersion &&\\n\",\n63|        \"\\t\\ttrue &&\\n\",\n64|        \"NARROWING\", \"identity_match six-way conjunction loses exactly the implementation axis.\"),\n65|    Mutant(\"RV2-M10-headless-conditional-exempts-absent\", f\"{PACKAGE}/execute.go\",\n66|        \"\\tif err := checkCapabilityConditional(operation, params, admitted); err != nil {\\n\",\n67|        \"\\tif err := checkCapabilityConditional(operation, params, admitted); err != nil && !(operation == terminalbackend.OperationCreate && source == terminalbackend.StateAbsent) {\\n\",\n68|        \"NARROWING\", \"headless_creation conditional skipped exactly for a headless create from absent.\"),\n69|    Mutant(\"RV2-M15-session-scoped-adopts-foreign-session\", f\"{PACKAGE}/execute.go\",\n70|        \"\\tif observed.SessionID != body.SessionID {\\n\\t\\treturn false, nil\\n\\t}\\n\",\n71|        \"\\tif observed.SessionID != body.SessionID && body.HasTerminalInstanceID {\\n\\t\\treturn false, nil\\n\\t}\\n\",\n72|        \"NARROWING\", \"Session-scoped status lookup adopts a report for a DIFFERENT session (the session comparison is skipped exactly for the both-null lookup).\"),\n73|    Mutant(\"RV2-K-control-known-killed\", f\"{PACKAGE}/auth.go\",\n74|        \"\\tleaseEpoch, ok := environ.CheckUint53Bounds(members[\\\"lease_epoch\\\"], 1, MaxLeaseEpoch)\\n\",\n75|        \"\\tleaseEpoch, ok := environ.CheckUint53Bounds(members[\\\"lease_epoch\\\"], 0, MaxLeaseEpoch)\\n\",\n76|        \"CONTROL\", \"Known-killed control (the producer's N-auth-epoch-low): must be KILLED by TestParseAXAuthorizationEpochBound, proving the plant reaches the compiler and the suite.\"),\n77|    Mutant(\"RV2-B-control-build-break\", f\"{PACKAGE}/auth.go\",\n78|        \"\\tif auth.Kind != wantKind {\\n\",\n79|        \"\\tif auth.Kind != wantKind { this does not compile\\n\",\n80|        \"CONTROL\", \"Build-break control: must report ERROR build broke, proving the patched file is what gets compiled.\"),\n81|    Mutant(\"RV2-C-control\", f\"{PACKAGE}/doc.go\",\n82|        \"// Package terminstance executes the Terminal Instance lifecycle contract of\\n\",\n83|        \"// Package terminstance executes (control) the Terminal Instance lifecycle contract of\\n\",\n84|        \"CONTROL\", \"Comment-only control: must SURVIVE.\"),\n85|]\n86|\n87|def run(m: Mutant) -> str:\n88|    target = REPO / m.path\n89|    original = target.read_text()\n90|    n = original.count(m.find)\n91|    if n != 1:\n92|        return f\"ERROR: {m.name}: anchors {n}, want 1\"\n93|    with tempfile.TemporaryDirectory() as staging:\n94|        backup = Path(staging) / \"backup\"\n95|        shutil.copy2(target, backup)\n96|        try:\n97|            target.write_text(original.replace(m.find, m.replace))\n98|            p = subprocess.run([\"go\", \"test\", f\"./{PACKAGE}/\", \"-count=1\"], cwd=REPO, capture_output=True, text=True, timeout=600)\n99|        finally:\n100|            shutil.copy2(backup, target)\n101|    out = (p.stdout + p.stderr)\n102|    (OUT / f\"{m.name}.log\").write_text(f\"--- plant: {m.name} ({m.kind}) exit {p.returncode} ---\\n{m.note}\\n--- output ---\\n{out}\\n--- end ---\\n\")\n103|    if \"build failed\" in out or out.startswith(\"# \") or \"\\n# \" in out:\n104|        return f\"ERROR: {m.name}: build broke\"\n105|    if p.returncode == 0:\n106|        v = \"SURVIVED\"\n107|    elif \"--- FAIL\" in out or \"FAIL:\" in out:\n108|        v = \"KILLED\"\n109|    else:\n110|        return f\"ERROR: {m.name}: exit {p.returncode} no kill line\"\n111|    killers = sorted({l.split()[2] for l in out.splitlines() if l.startswith(\"--- FAIL: \")})\n112|    return f\"{m.name}: {v} [{m.kind}] exit={p.returncode} killers={killers} :: {m.note}\"\n113|\n114|for m in M:\n115|    print(run(m), flush=True)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
