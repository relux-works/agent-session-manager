        note=\"Admits exactly changed-operation replays as replays; changed IDs still mismatch.\",\n360|    ),\n361|    Mutant(\n362|        name=\"N-store-mismatch-id\",\n363|        path=f\"{PACKAGE}/store.go\",\n364|        find=\"\\t\\t\\tif winner.Operation != operation || winner.OperationID != operationID {\\n\",\n365|        replace=\"\\t\\t\\tif winner.Operation != operation {\\n\",\n366|        count=1,\n367|        run=\"TestStoreBindReplayMismatch\",\n368|        expect=\"KILLED\",\n369|        note=\"Admits exactly changed-ID replays as replays; changed operations still mismatch.\",\n370|    ),\n371|    Mutant(\n372|        name=\"N-store-replay\",\n373|        path=f\"{PACKAGE}/store.go\",\n374|        find=\"\\t\\t\\treturn winner, true, nil\\n\",\n375|        replace='\\t\\t\\treturn winner, key != \"0198f4c8-8e50-7f66-8f70-bbbbbbbbbbb1/quiesce/0198f4c8-8e50-7f66-8f70-ddddddddddd1\", nil\\n',\n376|        count=1,\n377|        run=\"TestExecuteIdenticalRetryReplays\",\n378|        expect=\"KILLED\",\n379|        note=\"Loses the replay signal for exactly the fixture key; other keys still replay.\",\n380|    ),\n381|    Mutant(\n382|        name=\"N-store-torn\",\n383|        path=f\"{PACKAGE}/store.go\",\n384|        find=\"\\treceipt, err := decodeReceipt(raw)\\n\\tif err != nil {\\n\\t\\treturn Receipt{}, false, err\\n\\t}\\n\",\n385|        replace=\"\\treceipt, err := decodeReceipt(raw)\\n\\tif err != nil && len(raw) != 4 {\\n\\t\\treturn Receipt{}, false, err\\n\\t}\\n\\tif err != nil {\\n\\t\\treturn Receipt{}, false, nil\\n\\t}\\n\",\n386|        count=1,\n387|        run=\"TestStoreLookupAbsenceIsNotFailure\",\n388|        expect=\"KILLED\",\n389|        note=\"Launders exactly 4-byte torn receipts as absence; other torn files still fail integrity.\",\n390|    ),\n391|    Mutant(\n392|        name=\"N-complete-unbound\",\n393|        path=f\"{PACKAGE}/store.go\",\n394|        find=\"\\t} else if !found {\\n\",\n395|        replace='\\t} else if !found && string(result) != \"{}\" {\\n',\n396|        count=1,\n397|        run=\"TestStoreCompleteRequiresReceipt\",\n398|        expect=\"KILLED\",\n399|        note=\"Admits exactly empty-object completions of unbound keys; other completions still refuse.\",\n400|    ),\n401|    Mutant(\n402|        name=\"N-fencing-epoch-only\",\n403|        path=f\"{PACKAGE}/fencing.go\",\n404|        find=\"\\tif reason, _, parked := fencing.ParkDetails(authErr); parked && reason == fencing.ParkStaleOwner {\\n\",\n405|        replace=\"\\tif reason, _, parked := fencing.ParkDetails(authErr); parked && reason == fencing.ParkStaleOwner && presented.Epoch < observation.Winner.Epoch {\\n\",\n406|        count=1,\n407|        run=\"TestObserveFencingLeaseMismatchFences\",\n408|        expect=\"KILLED\",\n409|        note=\"Fences only the older-epoch arm; same-epoch lease mismatch no longer fences.\",\n410|    ),\n411|    Mutant(\n412|        name=\"N-fencing-remote\",\n413|        path=f\"{PACKAGE}/fencing.go\",\n414|        find=\"\\tif reason, _, parked := fencing.ParkDetails(authErr); parked && reason == fencing.ParkStaleOwner {\\n\",\n415|        replace=\"\\tif reason, _, parked := fencing.ParkDetails(authErr); parked && (reason == fencing.ParkStaleOwner || reason == fencing.ParkRemoteOwner) {\\n\",\n416|        count=1,\n417|        run=\"TestObserveFencingNonStaleLeavesState\",\n418|        expect=\"KILLED\",\n419|        note=\"Fences exactly remote parks as well; other non-stale outcomes still leave state.\",\n420|    ),\n421|    Mutant(\n422|        name=\"N-engine-checkoperation\",\n423|        path=f\"{PACKAGE}/execute.go\",\n424|        find=\"\\tif err := terminalbackend.CheckOperation(string(operation), admitted); err != nil {\\n\",\n425|        replace=\"\\tif err := terminalbackend.CheckOperation(string(operation), admitted); err != nil && operation != terminalbackend.OperationWaitSafeBoundary {\\n\",\n426|        count=1,\n427|        run=\"TestExecuteEmptyAdmittedRefusesAtLandedGate/wait-safe-boundary\",\n428|        expect=\"KILLED\",\n429|        note=\"Skips the landed conferral for exactly wait; other rows still wire it.\",\n430|    ),\n431|    Mutant(\n432|        name=\"N-engine-transition\",\n433|        path=f\"{PACKAGE}/execute.go\",\n434|        find=\"\\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), params.Interactive)\\n\\tif err != nil {\\n\",\n435|        replace=\"\\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), params.Interactive)\\n\\tif err != nil && source != terminalbackend.StateStopped {\\n\",\n436|        count=1,\n437|        run=\"TestExecutePreEffectErrorsRestoreSource/illegal_source_refuses\",\n438|        expect=\"KILLED\",\n439|        note=\"Admits exactly stopped-source transitions past the matrix; other illegal sources still refuse.\",\n440|    ),\n441|    Mutant(\n442|        name=\"N-engine-deadline-pre\",\n443|        path=f\"{PACKAGE}/execute.go\",\n444|        find='\\tif !engine.Now().Before(deadline) {\\n\\t\\tfailure := refuse(rowTimeoutCode(operation), \"operation deadline\")\\n\\t\\treturn buildResult(context, source, source, nil, nil, DispositionReplaySame), failure\\n\\t}\\n',\n445|        replace='\\tif !engine.Now().Before(deadline) && operation != terminalbackend.OperationWaitSafeBoundary {\\n\\t\\tfailure := refuse(rowTimeoutCode(operation), \"operation deadline\")\\n\\t\\treturn buildResult(context, source, source, nil, nil, DispositionReplaySame), failure\\n\\t}\\n',\n446|        count=1,\n447|        run=\"TestExecuteEntryDeadlineCodes/wait-safe-boundary\",\n448|        expect=\"KILLED\",\n449|        note=\"Skips the entry deadline for exactly wait; other rows still cancel.\",\n450|    ),\n451|    Mutant(\n452|        name=\"N-engine-timeout-code\",\n453|        path=f\"{PACKAGE}/execute.go\",\n454|        find=\"\\tcase terminalbackend.OperationWaitSafeBoundary:\\n\\t\\treturn CodeQuiesceTimeout\\n\",\n455|        replace=\"\\tcase terminalbackend.OperationWaitSafeBoundary:\\n\\t\\treturn CodeStopTimeout\\n\",\n456|        count=1,\n457|        run=\"TestExecuteEntryDeadlineCodes/wait-safe-boundary\",\n458|        expect=\"KILLED\",\n459|        note=\"Reports exactly the wait deadline as stop_timeout; the stop row still reports its own.\",\n460|    ),\n461|    Mutant(\n462|        name=\"N-engine-auth-entry\",\n463|        path=f\"{PACKAGE}/execute.go\",\n464|        find='\\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil {\\n\\t\\tfailure := err.(*Error)\\n\\t\\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\\n',\n465|        replace='\\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil && context.OperationID != \"0198f4c8-8e50-7f66-8f70-ccccccccccc1\" {\\n\\t\\tfailure := err.(*Error)\\n\\t\\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\\n',\n466|        count=1,\n467|        run=\"TestExecutePreEffectErrorsRestoreSource/entry_auth_expired\",\n468|        expect=\"KILLED\",\n469|        note=\"Skips the pre-bind auth gate for exactly the fixture operation; other operations still gate.\",\n470|    ),\n471|    Mutant(\n472|        name=\"N-engine-generation-entry\",\n473|        path=f\"{PACKAGE}/execute.go\",\n474|        find='\\tif engine.CurrentGeneration() != context.BackendGeneration {\\n\\t\\tfailure := refuse(CodeStaleGeneration, \"backend_generation stale\")\\n\\t\\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\\n',\n475|        replace='\\tif engine.CurrentGeneration() != context.BackendGeneration && context.OperationID != \"0198f4c8-8e50-7f66-8f70-ccccccccccc1\" {\\n\\t\\tfailure := refuse(CodeStaleGeneration, \"backend_generation stale\")\\n\\t\\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\\n',\n476|        count=1,\n477|        run=\"TestExecutePreEffectErrorsRestoreSource/entry_generation_stale\",\n478|        expect=\"KILLED\",\n479|        note=\"Skips the pre-bind generation gate for exactly the fixture operation; the loop recheck still refuses but the receipt is already bound.\",\n480|    ),\n481|    Mutant(\n482|        name=\"N-engine-recheck-auth\",\n483|        path=f\"{PACKAGE}/execute.go\",\n484|        find=\"\\t\\t\\treturn buildResult(context, source, source, performed, evidence, DispositionReplaySame), failure\\n\\t\\t}\\n\\t\\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil {\\n\",\n485|        replace=\"\\t\\t\\treturn buildResult(context, source, source, performed, evidence, DispositionReplaySame), failure\\n\\t\\t}\\n\\t\\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil && committed {\\n\",\n486|        count=1,\n487|        run=\"TestExecuteRechecksBeforeEachEffect/rotation_before_first_effect_restores_source\",\n488|        expect=\"KILLED\",\n489|        note=\"Skips the per-effect auth recheck exactly before the first effect; later rechecks stay.\",\n490|    ),\n491|    Mutant(\n492|        name=\"N-engine-recheck-generation\",\n493|        path=f\"{PACKAGE}/execute.go\",\n494|        find=\"\\t\\t\\treturn buildResult(context, source, after, performed, evidence, DispositionFor(failure.Code, committed)), failure\\n\\t\\t}\\n\\t\\tif engine.CurrentGeneration() != context.BackendGeneration {\\n\",\n495|        replace=\"\\t\\t\\treturn buildResult(context, source, after, performed, evidence, DispositionFor(failure.Code, committed)), failure\\n\\t\\t}\\n\\t\\tif engine.CurrentGeneration() != context.BackendGeneration && committed {\\n\",\n496|        count=1,\n497|        run=\"TestExecuteRechecksBeforeEachEffect/generation_rotation_before_first_effect_restores_source\",\n498|        expect=\"KILLED\",\n499|        note=\"Skips the per-effect generation recheck exactly before the first effect; later rechecks stay.\",\n500|    ),\n(more lines below)","final_result":true}}}
