{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d0c5","stream":{"kind":"session","id":"01a0b291-18f0-70a0-900f-0c92cf0433eb"},"sequence":1725,"recorded_at":1780531400003445,"record_type":"event","durability":"durable","causation_id":"cb7c4ff2-7892-4304-8de0-3769502303db","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"cb7c4ff2-7892-4304-8de0-3769502303db","run_stream":{"kind":"run","id":"cb7c4ff2-7892-4304-8de0-3769502303db"},"call_id":"call_01a0b29fe40a72a7a71770acfe580a39","text":"Read text file `/tmp/rv2ev/probes/zz_review2_crash_unix_test.go`.\n1|//go:build darwin || linux\n2|\n3|package terminstance\n4|\n5|// Reviewer real-kill at the ENGINE seam (BeforeEffect of the first\n6|// side effect, i.e. after the durable receipt, before wrapper/input\n7|// work) — a different seam from the producer's store AfterCommit kill.\n8|// Then the F1 witness with a real crash: status proves the source, the\n9|// same-key retry still refuses forever.\n10|\n11|import (\n12|\t\"context\"\n13|\t\"errors\"\n14|\t\"os\"\n15|\t\"os/exec\"\n16|\t\"syscall\"\n17|\t\"testing\"\n18|\t\"time\"\n19|\n20|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n21|)\n22|\n23|const (\n24|\trv2CrashEnv   = \"AX_RV2_CRASH_CHILD\"\n25|\trv2CrashStore = \"AX_RV2_CRASH_STORE\"\n26|)\n27|\n28|func TestRV2_RealKillAtFirstEffectSeam(t *testing.T) {\n29|\tif os.Getenv(rv2CrashEnv) == \"1\" {\n30|\t\tstore, err := OpenReceiptStore(os.Getenv(rv2CrashStore))\n31|\t\tif err != nil {\n32|\t\t\tt.Fatal(err)\n33|\t\t}\n34|\t\tbackend := newMockBackend()\n35|\t\tengine := &Engine{\n36|\t\t\tStore: store, Backend: backend,\n37|\t\t\tCurrentLease:      func() LeaseView { return testLease() },\n38|\t\t\tCurrentGeneration: func() string { return fixtureGen },\n39|\t\t\tNow:               fixtureNow,\n40|\t\t\tHooks: &EngineHooks{BeforeEffect: func(terminalbackend.SideEffect) {\n41|\t\t\t\tproc, _ := os.FindProcess(os.Getpid())\n42|\t\t\t\t_ = proc.Signal(syscall.SIGKILL)\n43|\t\t\t\tselect {}\n44|\t\t\t}},\n45|\t\t}\n46|\t\tcreate := testCreateContext(t)\n47|\t\t_, _ = engine.ExecuteMutating(context.Background(), terminalbackend.OperationCreate, create.context, create.params, mustParseState(t, \"absent\"), testAdmitted(\"terminal_state_retention\"))\n48|\t\tt.Fatal(\"child returned past SIGKILL\")\n49|\t\treturn\n50|\t}\n51|\tstoreDir := t.TempDir()\n52|\tctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)\n53|\tdefer cancel()\n54|\tchild := exec.CommandContext(ctx, os.Args[0], \"-test.run=^TestRV2_RealKillAtFirstEffectSeam$\", \"-test.count=1\")\n55|\tchild.Env = append(os.Environ(), rv2CrashEnv+\"=1\", rv2CrashStore+\"=\"+storeDir)\n56|\trunErr := child.Run()\n57|\tvar exitErr *exec.ExitError\n58|\tif !errors.As(runErr, &exitErr) {\n59|\t\tt.Fatalf(\"child run = %v, want a signal-kill exit\", runErr)\n60|\t}\n61|\tstatus, ok := exitErr.Sys().(syscall.WaitStatus)\n62|\tif !ok || !status.Signaled() || status.Signal() != syscall.SIGKILL {\n63|\t\tt.Fatalf(\"child status = %v, want SIGKILL\", exitErr)\n64|\t}\n65|\tt.Logf(\"child killed by SIGKILL at the engine BeforeEffect seam (create, first effect binding_persisted)\")\n66|\n67|\treopened, err := OpenReceiptStore(storeDir)\n68|\tif err != nil {\n69|\t\tt.Fatal(err)\n70|\t}\n71|\tcreate := testCreateContext(t)\n72|\treceipt, found, err := reopened.Lookup(create.context.IdempotencyKey)\n73|\tif err != nil || !found {\n74|\t\tt.Fatalf(\"Lookup after kill = (%v, %v), want the durable create receipt\", found, err)\n75|\t}\n76|\tif receipt.Operation != terminalbackend.OperationCreate || receipt.OperationID != fixtureOperation {\n77|\t\tt.Fatalf(\"receipt = %+v\", receipt)\n78|\t}\n79|\tif _, found, err := reopened.Completed(create.context.IdempotencyKey); err != nil || found {\n80|\t\tt.Fatalf(\"Completed after kill = (%v, %v), want none\", found, err)\n81|\t}\n82|\t// creating was never observable before the receipt: the receipt is\n83|\t// durable and no effect ran (the child died before the first one).\n84|\tbackend := newMockBackend()\n85|\tengine := &Engine{Store: reopened, Backend: backend, CurrentLease: func() LeaseView { return testLease() }, CurrentGeneration: func() string { return fixtureGen }, Now: fixtureNow}\n86|\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, create.context, create.params, mustParseState(t, \"absent\"), testAdmitted(\"terminal_state_retention\"))\n87|\trequireRefusal(t, err, \"terminal_backend_unavailable\", \"idempotency result uncertain\")\n88|\trequireLiteral(t, \"after\", string(result.After), \"unavailable\")\n89|\trequireLiteral(t, \"disposition\", string(result.Disposition), \"status_first\")\n90|\tif len(backend.performed()) != 0 {\n91|\t\tt.Fatalf(\"performed = %v on the uncertain retry\", backend.performed())\n92|\t}\n93|\t// status proves absence (a successful status read is the only proof)\n94|\tbackend.observation = StatusObservation{State: terminalbackend.StateAbsent, IdentityMatch: false, SessionID: fixtureSessionA, InstanceID: fixtureInstance, BackendID: fixtureBackend, ImplVersion: fixtureImpl, ProtoVersion: fixtureProto, Generation: \"generation-two\"}\n95|\treport, err := engine.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"absent\"), testAdmitted(\"durable_disconnect\"))\n96|\tif err != nil {\n97|\t\tt.Fatal(err)\n98|\t}\n99|\trequireLiteral(t, \"status after kill\", string(report.State), \"absent\")\n100|\t// F1 with a real crash: \"Create is idempotent on (session_id,\n101|\t// bootstrap_operation_id) across controller crash ... Identical retry\n102|\t// returns the one result/instance.\" After status proved absence the\n103|\t// identical retry must proceed; the candidate refuses forever.\n104|\tresult, err = engine.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, create.context, create.params, mustParseState(t, \"absent\"), testAdmitted(\"terminal_state_retention\"))\n105|\tt.Logf(\"CHARACTERIZATION identical create retry after a real controller crash and a status read proving absence: err=%v after=%q disposition=%q performed=%v\", err, result.After, result.Disposition, backend.performed())\n106|\tif err != nil {\n107|\t\tt.Errorf(\"identical create retry after crash+status still refuses: %v — the (session_id, bootstrap_operation_id) key can never produce the one result/instance\", err)\n108|\t}\n109|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
