ncing.go\",\n+        find=\"\\tif relativeReason, _, relativeParked := fencing.ParkDetails(relativeErr); relativeParked && relativeReason == fencing.ParkStaleOwner {\\n\",\n+        replace=\"\\tif relativeReason, _, relativeParked := fencing.ParkDetails(relativeErr); relativeParked {\\n\",\n+        count=1,\n+        run=\"TestObserveFencingRemoteWinnerFutureEpochLeavesState\",\n+        expect=\"KILLED\",\n+        note=\"Fences on any relative park instead of exactly stale_owner; the future-epoch restore_policy member pins it.\",\n+    ),\n+    Mutant(\n+        name=\"N-fencing-source-absent\",\n+        path=f\"{PACKAGE}/fencing.go\",\n+        find=\"\\t\\tterminalbackend.StateActive, terminalbackend.StateQuiescing:\\n\",\n+        replace=\"\\t\\tterminalbackend.StateActive, terminalbackend.StateQuiescing, terminalbackend.StateAbsent:\\n\",\n+        count=1,\n+        run=\"TestObserveFencingNonLiveSourcesLeaveState\",\n+        expect=\"KILLED\",\n+        note=\"Fences exactly absent as well as the live states; stopped, stale_fenced and unavailable still leave.\",\n+    ),\n+    Mutant(\n+        name=\"N-fencing-source-stopped\",\n+        path=f\"{PACKAGE}/fencing.go\",\n+        find=\"\\t\\tterminalbackend.StateActive, terminalbackend.StateQuiescing:\\n\",\n+        replace=\"\\t\\tterminalbackend.StateActive, terminalbackend.StateQuiescing, terminalbackend.StateStopped:\\n\",\n+        count=1,\n+        run=\"TestObserveFencingNonLiveSourcesLeaveState\",\n+        expect=\"KILLED\",\n+        note=\"Fences exactly stopped as well as the live states; absent, stale_fenced and unavailable still leave.\",\n+    ),\n+    Mutant(\n+        name=\"N-fencing-source-creating\",\n+        path=f\"{PACKAGE}/fencing.go\",\n+        find=\"\\tcase terminalbackend.StateCreating, terminalbackend.StateParked,\\n\",\n+        replace=\"\\tcase terminalbackend.StateParked,\\n\",\n+        count=1,\n+        run=\"TestObserveFencingNonLiveSourcesLeaveState\",\n+        expect=\"KILLED\",\n+        note=\"Fences only parked, active and quiescing; the materializing creating incarnation no longer fences.\",\n+    ),\n+    Mutant(\n+        name=\"N-engine-headless-absent\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find=\"\\tif err := checkCapabilityConditional(operation, params, admitted); err != nil {\\n\",\n+        replace=\"\\tif err := checkCapabilityConditional(operation, params, admitted); err != nil && !(operation == terminalbackend.OperationCreate && source == terminalbackend.StateAbsent) {\\n\",\n+        count=1,\n+        run=\"TestExecuteCreateHeadlessFromAbsentNeedsCapability\",\n+        expect=\"KILLED\",\n+        note=\"Skips the headless_creation conditional for exactly a headless create from absent; other conditionals still refuse.\",\n+    ),\n+    Mutant(\n+        name=\"N-engine-committed-timeout-disposition\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find='\\t\\t\\tfailure := refuse(code, \"backend effect refused\")\\n\\t\\t\\treturn buildResult(context, source, after, performed, evidence, DispositionFor(code, committed)), failure\\n',\n+        replace='\\t\\t\\tfailure := refuse(code, \"backend effect refused\")\\n\\t\\t\\treturn buildResult(context, source, after, performed, evidence, DispositionFor(code, committed && code != CodeTimeout)), failure\\n',\n+        count=1,\n+        run=\"TestExecuteCreateCommittedTimeoutReportsStatusFirst\",\n+        expect=\"KILLED\",\n+        note=\"Reports exactly a committed terminal_backend_timeout as replay_same instead of status_first; other committed codes still route through status.\",\n+    ),\n+    Mutant(\n+        name=\"N-engine-recheck-auth-third\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find=\"\\t\\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil {\\n\\t\\t\\tfailure := err.(*Error)\\n\\t\\t\\tafter := source\\n\",\n+        replace=\"\\t\\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil && len(performed) < 2 {\\n\\t\\t\\tfailure := err.(*Error)\\n\\t\\t\\tafter := source\\n\",\n+        count=1,\n+        run=\"TestExecuteRechecksBeforeThirdEffect/lease_rotates_before_third_effect\",\n+        expect=\"KILLED\",\n+        note=\"Skips the per-effect auth recheck exactly before the third effect; rechecks before effects 1 and 2 stay.\",\n+    ),\n+    Mutant(\n+        name=\"N-engine-recheck-generation-third\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find='\\t\\tif engine.CurrentGeneration() != context.BackendGeneration {\\n\\t\\t\\tfailure := refuse(CodeStaleGeneration, \"backend_generation stale\")\\n\\t\\t\\tafter := source\\n',\n+        replace='\\t\\tif engine.CurrentGeneration() != context.BackendGeneration && len(performed) < 2 {\\n\\t\\t\\tfailure := refuse(CodeStaleGeneration, \"backend_generation stale\")\\n\\t\\t\\tafter := source\\n',\n+        count=1,\n+        run=\"TestExecuteRechecksBeforeThirdEffect/generation_rotates_before_third_effect\",\n+        expect=\"KILLED\",\n+        note=\"Skips the per-effect generation recheck exactly before the third effect; rechecks before effects 1 and 2 stay.\",\n+    ),\n+    Mutant(\n+        name=\"N-status-session-scoped\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find=\"\\tif observed.SessionID != body.SessionID {\\n\\t\\treturn false, nil\\n\\t}\\n\",\n+        replace=\"\\tif observed.SessionID != body.SessionID && body.HasTerminalInstanceID {\\n\\t\\treturn false, nil\\n\\t}\\n\",\n+        count=1,\n+        run=\"TestExecuteStatusSessionDriftRefuses/session_scoped_lying_match_refuses\",\n+        expect=\"KILLED\",\n+        note=\"Skips the reported-session comparison for exactly the Session-scoped lookup, adopting a foreign session report; the exact path still compares.\",\n+    ),\n+    Mutant(\n+        name=\"N-status-session-exact\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find=\"\\tif observed.SessionID != body.SessionID {\\n\\t\\treturn false, nil\\n\\t}\\n\",\n+        replace=\"\\tif observed.SessionID != body.SessionID && !body.HasTerminalInstanceID {\\n\\t\\treturn false, nil\\n\\t}\\n\",\n+        count=1,\n+        run=\"TestExecuteStatusSessionDriftRefuses/exact_lying_match_refuses\",\n+        expect=\"KILLED\",\n+        note=\"Skips the reported-session comparison for exactly the exact-instance lookup, adopting a foreign session report; the Session-scoped path still compares.\",\n+    ),\n+    Mutant(\n+        name=\"N-status-match-instance\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find=\"\\treturn observed.InstanceID == body.TerminalInstanceID &&\\n\",\n+        replace=\"\\treturn true &&\\n\",\n+        count=1,\n+        run=\"TestExecuteStatusIdentityMatchEachAxis/instance/lying_match_refuses\",\n+        expect=\"KILLED\",\n+        note=\"Drops exactly the instance conjunct from the identity_match conjunction; the other five axes still compare.\",\n+    ),\n+    Mutant(\n+        name=\"N-status-match-backend\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find=\"\\t\\tobserved.BackendID == body.TerminalBackendID &&\\n\",\n+        replace=\"\\t\\ttrue &&\\n\",\n+        count=1,\n+        run=\"TestExecuteStatusIdentityMatchEachAxis/backend/lying_match_refuses\",\n+        expect=\"KILLED\",\n+        note=\"Drops exactly the backend conjunct from the identity_match conjunction; the other five axes still compare.\",\n+    ),\n+    Mutant(\n+        name=\"N-status-match-implementation\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find=\"\\t\\tobserved.ImplVersion == body.ImplementationVersion &&\\n\",\n+        replace=\"\\t\\ttrue &&\\n\",\n+        count=1,\n+        run=\"TestExecuteStatusIdentityMatchEachAxis/implementation/lying_match_refuses\",\n+        expect=\"KILLED\",\n+        note=\"Drops exactly the implementation conjunct from the identity_match conjunction; the other five axes still compare.\",\n+    ),\n+    Mutant(\n+        name=\"N-status-match-protocol\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find=\"\\t\\tobserved.ProtoVersion == body.ProtocolVersion &&\\n\",\n+        replace=\"\\t\\ttrue &&\\n\",\n+        count=1,\n+        run=\"TestExecuteStatusIdentityMatchEachAxis/protocol/lying_match_refuses\",\n+        expect=\"KILLED\",\n+        note=\"Drops exactly the protocol conjunct from the identity_match conjunction; the other five axes still compare.\",\n+    ),\n+    Mutant(\n+        name=\"N-status-match-generation\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find=\"\\t\\tobserved.Generation == body.BackendGeneration, nil\\n\",\n+        replace=\"\\t\\ttrue, nil\\n\",\n+        count=1,\n+        run=\"TestExecuteStatusIdentityMatchEachAxis/generation/lying_match_refuses\",\n+        expect=\"KILLED\",\n+        note=\"Drops exactly the generation conjunct from the identity_match conjunction; the other five axes still compare.\",\n+    ),\n+    Mutant(\n+        name=\"N-engine-deadline-instant\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find='\\tif !engine.Now().Before(deadline) {\\n\\t\\tfailure := refuse(rowTimeoutCode(operation), \"operation deadline\")\\n\\t\\treturn buildResult(context, source, source, nil, nil, DispositionReplaySame), failure\\n\\t}\\n',\n+        replace='\\tif engine.Now().After(deadline) {\\n\\t\\tfailure := refuse(rowTimeoutCode(operation), \"operation deadline\")\\n\\t\\treturn buildResult(context, source, source, nil, nil, DispositionReplaySame), failure\\n\\t}\\n',\n+        count=1,\n+        run=\"TestExecuteEntryDeadlineInstantRefuses\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the now == deadline_at instant at the mutating entry; past-deadline instants still refuse.\",\n+    ),\n+    Mutant(\n+        name=\"N-status-deadline-instant\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find='\\tif !engine.Now().Before(deadline) {\\n\\t\\treturn empty, refuse(CodeTimeout, \"operation deadline\")\\n\\t}\\n',\n+        replace='\\tif engine.Now().After(deadline) {\\n\\t\\treturn empty, refuse(CodeTimeout, \"operation deadline\")\\n\\t}\\n',\n+        count=1,\n+        run=\"TestExecuteStatusDeadlineInstantRefuses\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the now == deadline_at instant at the status entry; past-deadline instants still refuse.\",\n+    ),\n+    Mutant(\n+        name=\"N-auth-kind-attach\",\n+        path=f\"{PACKAGE}/auth.go\",\n+        find='\\tdefault:\\n\\t\\treturn \"\", refuse(CodeProtocolError, \"ax authorization kind\")\\n\\t}\\n',\n+        replace='\\tdefault:\\n\\t\\tif value == \"attach\" {\\n\\t\\t\\treturn AuthorizationControl, nil\\n\\t\\t}\\n\\t\\treturn \"\", refuse(CodeProtocolError, \"ax authorization kind\")\\n\\t}\\n',\n+        count=1,\n+        run=\"TestParseAuthorizationKindClosed\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the landed attach name (an AttachAuthorization kind, never an AXAuthorization kind) as control; every other non-kind still refuses.\",\n+    ),\n+    Mutant(\n+        name=\"N-auth-kind-none\",\n+        path=f\"{PACKAGE}/auth.go\",\n+        find='\\tdefault:\\n\\t\\treturn \"\", refuse(CodeProtocolError, \"ax authorization kind\")\\n\\t}\\n',\n+        replace='\\tdefault:\\n\\t\\tif value == \"none\" {\\n\\t\\t\\treturn AuthorizationControl, nil\\n\\t\\t}\\n\\t\\treturn \"\", refuse(CodeProtocolError, \"ax authorization kind\")\\n\\t}\\n',\n+        count=1,\n+        run=\"TestParseAuthorizationKindClosed\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the landed none name (no authorization at all) as control; every other non-kind still refuses.\",\n+    ),\n+    Mutant(\n+        name=\"N-resume-status-error\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find=\"\\treport, err := engine.ExecuteStatus(ctx, body, source, admitted)\\n\\tif err != nil {\\n\",\n+        replace=\"\\treport, err := engine.ExecuteStatus(ctx, body, source, admitted)\\n\\tif err != nil && ErrorCode(err) != CodeTimeout {\\n\",\n+        count=1,\n+        run=\"TestExecuteUncertainRetryUnknownObservationRefuses/coded_read_failure\",\n+        expect=\"KILLED\",\n+        note=\"Resumes on exactly a timed-out reconciliation read; every other failed read still refuses uncertain.\",\n+    ),\n+    Mutant(\n+        name=\"N-resume-target\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find=\"\\tif report.State != source {\\n\",\n+        replace=\"\\tif report.State != source && report.State != target {\\n\",\n+        count=1,\n+        run=\"TestExecuteUncertainRetryTargetProvenRefuses/quiesce_target_proven\",\n+        expect=\"KILLED\",\n+        note=\"Resumes on exactly the proven target state as well as the source; contradictory and unknown observations still refuse.\",\n+    ),\n+    Mutant(\n+        name=\"N-resume-scope-instance\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find=\"\\t\\tTerminalInstanceID:         context.TerminalInstanceID,\\n\\t\\tHasTerminalInstanceID:      true,\\n\",\n+        replace=\"\\t\\tTerminalInstanceID:         context.TerminalInstanceID,\\n\\t\\tHasTerminalInstanceID:      false,\\n\",\n+        count=1,\n+        run=\"TestExecuteUncertainRetryUnknownObservationRefuses/lying_match_on_drifted_instance\",\n+        expect=\"KILLED\",\n+        note=\"Reconciles through exactly the Session-scoped lookup instead of the exact instance, adopting a lying instance report; exact reconciliation still refuses it.\",\n+    ),\n+    Mutant(\n+        name=\"N-resume-complete-key\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find=\"\\tif err := engine.Store.Complete(key, encoded); err != nil {\\n\",\n+        replace='\\tif err := engine.Store.Complete(key+\"/resumed\", encoded); err != nil {\\n',\n+        count=1,\n+        run=\"TestExecuteIdenticalRetryReplays\",\n+        expect=\"KILLED\",\n+        note=\"Records the completion under exactly a second key instead of the bound one; the identical retry then reconciles instead of replaying.\",\n+    ),\n+    Mutant(\n+        name=\"N-resume-generation-value\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find='\\t\\tBackendGeneration:          context.BackendGeneration,\\n',\n+        replace='\\t\\tBackendGeneration:          \"\",\\n',\n+        count=1,\n+        run=\"TestExecuteUncertainRetryResumesWhenStatusProvesSource\",\n+        expect=\"KILLED\",\n+        note=\"Reconciles with exactly an empty generation instead of the request generation; the proof then mismatches and the resumption never proceeds.\",\n+    ),\n+    Mutant(\n+        name=\"N-engine-bind-prelink\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find=\"\\t\\t\\tif _, found, lookupErr := engine.Store.Lookup(key); lookupErr == nil && !found {\\n\",\n+        replace=\"\\t\\t\\tif _, found, lookupErr := engine.Store.Lookup(key); lookupErr == nil && !found && operation != terminalbackend.OperationQuiesceInput {\\n\",\n+        count=1,\n+        run=\"TestExecutePreLinkStoreFailureRestoresSource\",\n+        expect=\"KILLED\",\n+        note=\"Restores the source on a pre-link store failure for every row except exactly quiesce-input; the quiesce row then fences unavailable.\",\n+    ),\n+    Mutant(\n+        name=\"N-engine-bind-postlink\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find=\"\\t\\t\\tif _, found, lookupErr := engine.Store.Lookup(key); lookupErr == nil && !found {\\n\",\n+        replace=\"\\t\\t\\tif _, found, lookupErr := engine.Store.Lookup(key); lookupErr == nil {\\n\",\n+        count=1,\n+        run=\"TestExecuteHookErrorRetryReconcilesThroughStatus/standing_receipt_is_uncertain\",\n+        expect=\"KILLED\",\n+        note=\"Restores the source for exactly standing receipts as well as for nothing-durable; the hook-error commit then restores instead of fencing uncertain.\