{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca65","stream":{"kind":"session","id":"01a0b291-18f0-70a0-900f-0c92cf0433eb"},"sequence":909,"recorded_at":1780531400001813,"record_type":"event","durability":"durable","causation_id":"cb7c4ff2-7892-4304-8de0-3769502303db","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"cb7c4ff2-7892-4304-8de0-3769502303db","run_stream":{"kind":"run","id":"cb7c4ff2-7892-4304-8de0-3769502303db"},"call_id":"call_01a0b297accd779a8f7241db6b6cd2d1","text":"Read text file `internal/terminstance/status.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n10|)\n11|\n12|// StatusBody is the closed §4.C status request body: exactly session_id,\n13|// terminal_instance_id (UUIDv7 or null), terminal_backend_id,\n14|// implementation_version, protocol_version, backend_generation\n15|// (string[1..256] or null), include_provider_observation and deadline_at.\n16|// The instance and generation are either both null (Session-scoped\n17|// lookup) or both non-null (exact-instance lookup). Status carries no\n18|// authorization: its transition row authorizes none.\n19|type StatusBody struct {\n20|\tSessionID                  string\n21|\tTerminalInstanceID         string\n22|\tHasTerminalInstanceID      bool\n23|\tTerminalBackendID          string\n24|\tImplementationVersion      string\n25|\tProtocolVersion            string\n26|\tBackendGeneration          string\n27|\tHasBackendGeneration       bool\n28|\tIncludeProviderObservation bool\n29|\tDeadline                   scalar.Timestamp\n30|}\n31|\n32|// statusBodyMembers is the exact closed member set, in the order the\n33|// pinned section lists it.\n34|var statusBodyMembers = []string{\n35|\t\"session_id\",\n36|\t\"terminal_instance_id\",\n37|\t\"terminal_backend_id\",\n38|\t\"implementation_version\",\n39|\t\"protocol_version\",\n40|\t\"backend_generation\",\n41|\t\"include_provider_observation\",\n42|\t\"deadline_at\",\n43|}\n44|\n45|// ParseStatusBody admits one closed status body. Null is the explicit\n46|// JSON null only: missing, empty-string and wrong-typed members are\n47|// malformed, never null.\n48|func ParseStatusBody(raw []byte) (StatusBody, error) {\n49|\tmembers, fault := environ.DecodeStrictObject(raw)\n50|\tif fault != nil {\n51|\t\treturn StatusBody{}, refuse(CodeProtocolError, \"status body frame\")\n52|\t}\n53|\tif len(members) != len(statusBodyMembers) {\n54|\t\treturn StatusBody{}, refuse(CodeProtocolError, \"status body members\")\n55|\t}\n56|\tfor _, member := range statusBodyMembers {\n57|\t\tif _, known := members[member]; !known {\n58|\t\t\treturn StatusBody{}, refuse(CodeProtocolError, \"status body members\")\n59|\t\t}\n60|\t}\n61|\tsession, ok := environ.CheckUUIDv7(members[\"session_id\"])\n62|\tif !ok {\n63|\t\treturn StatusBody{}, refuse(CodeProtocolError, \"status body session\")\n64|\t}\n65|\tinstance, hasInstance, err := uuidOrNull(members[\"terminal_instance_id\"])\n66|\tif err != nil {\n67|\t\treturn StatusBody{}, refuse(CodeProtocolError, \"status body instance\")\n68|\t}\n69|\tbackendID, ok := rawString(members[\"terminal_backend_id\"])\n70|\tif !ok {\n71|\t\treturn StatusBody{}, refuse(CodeProtocolError, \"status body backend\")\n72|\t}\n73|\tif _, err := terminalbackend.ParseID(backendID); err != nil {\n74|\t\treturn StatusBody{}, wrapLanded(err)\n75|\t}\n76|\timplementationVersion, ok := rawString(members[\"implementation_version\"])\n77|\tif !ok {\n78|\t\treturn StatusBody{}, refuse(CodeProtocolError, \"status body versions\")\n79|\t}\n80|\tprotocolVersion, ok := rawString(members[\"protocol_version\"])\n81|\tif !ok {\n82|\t\treturn StatusBody{}, refuse(CodeProtocolError, \"status body versions\")\n83|\t}\n84|\tif err := checkVersionTuple(backendID, implementationVersion, protocolVersion); err != nil {\n85|\t\treturn StatusBody{}, err\n86|\t}\n87|\tgeneration, hasGeneration, err := generationOrNull(members[\"backend_generation\"])\n88|\tif err != nil {\n89|\t\treturn StatusBody{}, refuse(CodeStaleGeneration, \"backend_generation bound\")\n90|\t}\n91|\tif hasInstance != hasGeneration {\n92|\t\treturn StatusBody{}, refuse(CodeProtocolError, \"status identity scope\")\n93|\t}\n94|\tvar include bool\n95|\tif err := json.Unmarshal(members[\"include_provider_observation\"], &include); err != nil {\n96|\t\treturn StatusBody{}, refuse(CodeProtocolError, \"status body observation\")\n97|\t}\n98|\tdeadline, ok := environ.CheckTimestamp(members[\"deadline_at\"])\n99|\tif !ok {\n100|\t\treturn StatusBody{}, refuse(CodeProtocolError, \"status body deadline\")\n101|\t}\n102|\treturn StatusBody{\n103|\t\tSessionID:                  session.String(),\n104|\t\tTerminalInstanceID:         instance,\n105|\t\tHasTerminalInstanceID:      hasInstance,\n106|\t\tTerminalBackendID:          backendID,\n107|\t\tImplementationVersion:      implementationVersion,\n108|\t\tProtocolVersion:            protocolVersion,\n109|\t\tBackendGeneration:          generation,\n110|\t\tHasBackendGeneration:       hasGeneration,\n111|\t\tIncludeProviderObservation: include,\n112|\t\tDeadline:                   deadline,\n113|\t}, nil\n114|}\n115|\n116|// uuidOrNull reads a UUIDv7-or-null member: explicit JSON null reads\n117|// absent, a UUIDv7 string reads present, anything else is malformed.\n118|func uuidOrNull(raw json.RawMessage) (string, bool, error) {\n119|\tif isExplicitNull(raw) {\n120|\t\treturn \"\", false, nil\n121|\t}\n122|\tvalue, ok := rawString(raw)\n123|\tif !ok {\n124|\t\treturn \"\", false, refuse(CodeProtocolError, \"status body instance\")\n125|\t}\n126|\tparsed, err := scalar.ParseUUIDv7(value)\n127|\tif err != nil {\n128|\t\treturn \"\", false, refuse(CodeProtocolError, \"status body instance\")\n129|\t}\n130|\treturn parsed.String(), true, nil\n131|}\n132|\n133|// generationOrNull reads a string[1..256]-or-null member in characters\n134|// through the landed bound. A present but out-of-bound generation is the\n135|// landed terminal_backend_stale_generation class, matching the descriptor\n136|// and digest arms.\n137|func generationOrNull(raw json.RawMessage) (string, bool, error) {\n138|\tif isExplicitNull(raw) {\n139|\t\treturn \"\", false, nil\n140|\t}\n141|\tvalue, ok := environ.CheckStringBounds(raw, 1, 256)\n142|\tif !ok {\n143|\t\treturn \"\", false, refuse(CodeStaleGeneration, \"backend_generation bound\")\n144|\t}\n145|\treturn value, true, nil\n146|}\n147|\n148|// isExplicitNull reports whether the member is the explicit JSON null.\n149|// Only the null literal reads null: missing members never reach here\n150|// (the exact-member check owns absence) and every other literal is the\n151|// typed member the caller parses next.\n152|func isExplicitNull(raw json.RawMessage) bool {\n153|\treturn string(bytes.TrimSpace(raw)) == \"null\"\n154|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca67","stream":{"kind":"session","id":"01a0b291-18f0-70a0-900f-0c92cf0433eb"},"sequence":910,"recorded_at":1780531400001815,"record_type":"event","durability":"durable","causation_id":"cb7c4ff2-7892-4304-8de0-3769502303db","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"cb7c4ff2-7892-4304-8de0-3769502303db","run_stream":{"kind":"run","id":"cb7c4ff2-7892-4304-8de0-3769502303db"},"call_id":"call_01a0b297ae9075dd8c38344d95523b94","text":"Read text file `internal/terminstance/context.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n9|)\n10|\n11|// MutationContext is the closed §4.C MutationContext object: exactly\n12|// operation_id, session_id, terminal_instance_id, terminal_backend_id,\n13|// implementation_version, protocol_version, backend_generation,\n14|// idempotency_key, deadline_at and authorization. Every mutating request\n15|// carries it.\n16|type MutationContext struct {\n17|\tOperationID           string\n18|\tSessionID             string\n19|\tTerminalInstanceID    string\n20|\tTerminalBackendID     string\n21|\tImplementationVersion string\n22|\tProtocolVersion       string\n23|\tBackendGeneration     string\n24|\tIdempotencyKey        string\n25|\tDeadline              scalar.Timestamp\n26|\tAuthorization         AXAuthorization\n27|}\n28|\n29|// mutationContextMembers is the exact closed member set, in the order the\n30|// pinned section lists it.\n31|var mutationContextMembers = []string{\n32|\t\"operation_id\",\n33|\t\"session_id\",\n34|\t\"terminal_instance_id\",\n35|\t\"terminal_backend_id\",\n36|\t\"implementation_version\",\n37|\t\"protocol_version\",\n38|\t\"backend_generation\",\n39|\t\"idempotency_key\",\n40|\t\"deadline_at\",\n41|\t\"authorization\",\n42|}\n43|\n44|// ParseMutationContext admits one closed MutationContext document. The\n45|// nested authorization is admitted by the shared\n46|// parseAXAuthorizationObject arms, never a second implementation.\n47|// Malformed documents are terminal_backend_protocol_error (AX-local\n48|// parse); semantic binding (key material, version tuple, generation\n49|// staleness) is CheckMutationContext, not this function.\n50|func ParseMutationContext(raw []byte) (MutationContext, error) {\n51|\tmembers, fault := environ.DecodeStrictObject(raw)\n52|\tif fault != nil {\n53|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context frame\")\n54|\t}\n55|\treturn parseMutationContextObject(members)\n56|}\n57|\n58|// parseMutationContextObject admits one already-framed context member map.\n59|// ParseMutationContext and ParseOperationBody share it so the nested\n60|// context inside an operation body is admitted by the same arms.\n61|func parseMutationContextObject(members map[string]json.RawMessage) (MutationContext, error) {\n62|\tif len(members) != len(mutationContextMembers) {\n63|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context members\")\n64|\t}\n65|\tfor _, member := range mutationContextMembers {\n66|\t\tif _, known := members[member]; !known {\n67|\t\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context members\")\n68|\t\t}\n69|\t}\n70|\toperationID, ok := environ.CheckUUIDv7(members[\"operation_id\"])\n71|\tif !ok {\n72|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context operation\")\n73|\t}\n74|\tsessionID, ok := environ.CheckUUIDv7(members[\"session_id\"])\n75|\tif !ok {\n76|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context session\")\n77|\t}\n78|\tinstanceID, ok := environ.CheckUUIDv7(members[\"terminal_instance_id\"])\n79|\tif !ok {\n80|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context instance\")\n81|\t}\n82|\tbackendID, ok := rawString(members[\"terminal_backend_id\"])\n83|\tif !ok {\n84|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context backend\")\n85|\t}\n86|\tif _, err := terminalbackend.ParseID(backendID); err != nil {\n87|\t\treturn MutationContext{}, wrapLanded(err)\n88|\t}\n89|\timplementationVersion, ok := rawString(members[\"implementation_version\"])\n90|\tif !ok {\n91|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context versions\")\n92|\t}\n93|\tprotocolVersion, ok := rawString(members[\"protocol_version\"])\n94|\tif !ok {\n95|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context versions\")\n96|\t}\n97|\tif err := checkVersionTuple(backendID, implementationVersion, protocolVersion); err != nil {\n98|\t\treturn MutationContext{}, err\n99|\t}\n100|\tgeneration, ok := environ.CheckStringBounds(members[\"backend_generation\"], 1, 256)\n101|\tif !ok {\n102|\t\treturn MutationContext{}, refuse(CodeStaleGeneration, \"backend_generation bound\")\n103|\t}\n104|\tidempotencyKey, ok := environ.CheckStringBounds(members[\"idempotency_key\"], 1, 256)\n105|\tif !ok {\n106|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context key bound\")\n107|\t}\n108|\tdeadline, ok := environ.CheckTimestamp(members[\"deadline_at\"])\n109|\tif !ok {\n110|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context deadline\")\n111|\t}\n112|\tauthMembers, fault := environ.DecodeStrictObject(members[\"authorization\"])\n113|\tif fault != nil {\n114|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context authorization\")\n115|\t}\n116|\tauthorization, err := parseAXAuthorizationObject(authMembers)\n117|\tif err != nil {\n118|\t\treturn MutationContext{}, err\n119|\t}\n120|\treturn MutationContext{\n121|\t\tOperationID:           operationID.String(),\n122|\t\tSessionID:             sessionID.String(),\n123|\t\tTerminalInstanceID:    instanceID.String(),\n124|\t\tTerminalBackendID:     backendID,\n125|\t\tImplementationVersion: implementationVersion,\n126|\t\tProtocolVersion:       protocolVersion,\n127|\t\tBackendGeneration:     generation,\n128|\t\tIdempotencyKey:        idempotencyKey,\n129|\t\tDeadline:              deadline,\n130|\t\tAuthorization:         authorization,\n131|\t}, nil\n132|}\n133|\n134|// checkVersionTuple enforces the operation-body version rule:\n135|// implementation_version is semver and protocol_version is semver in\n136|// Terminal Backend Protocol major 1. It delegates both arms to the\n137|// landed CheckVersionTuple with the carried protocol version as the\n138|// membership list: membership against the admitted probe list is the\n139|// registry's business at admission (landed RequireRestoreBinding,\n140|// CheckVersionTuple, Reconcile), so the operation gate contributes only\n141|// the grammar and major arms and states that bound explicitly instead of\n142|// re-deriving the saturating major or the semver grammar.\n143|func checkVersionTuple(backendID, implementationVersion, protocolVersion string) error {\n144|\tif err := terminalbackend.CheckVersionTuple(backendID, implementationVersion, protocolVersion, []string{protocolVersion}); err != nil {\n145|\t\treturn wrapLanded(err)\n146|\t}\n147|\treturn nil\n148|}\n149|\n150|// checkGenerationBound enforces string[1..256] in characters over valid\n151|// UTF-8 on a Go-level generation value by delegating to the landed\n152|// GenerationDigest bound arm; the digest half is discarded because §4.C\n153|// results carry the raw string, not its digest. The refusal class is the\n154|// landed terminal_backend_stale_generation, never a fresh code.\n155|func checkGenerationBound(generation string) error {\n156|\tif _, err := terminalbackend.GenerationDigest(generation); err != nil {\n157|\t\treturn wrapLanded(err)\n158|\t}\n159|\treturn nil\n160|}\n161|\n162|// KeySegments derives the canonical idempotency key for one engine\n163|// operation from its identity material through the landed IdempotencyKey\n164|// shapes. The infix literals are fixed per row, never caller input: a\n165|// carried key that differs from the derived material is internally\n166|// inconsistent and refused as terminal_backend_protocol_error, while a\n167|// carried key that matches its material but collides with a different\n168|// bound operation in the store is idempotency_mismatch at the receipt\n169|// seam. create and restore share the (session, bootstrap) shape; only\n170|// create executes in this engine.\n171|func KeySegments(operation terminalbackend.Operation, context MutationContext, params Params) (string, error) {\n172|\tswitch operation {\n173|\tcase terminalbackend.OperationCreate:\n174|\t\treturn terminalbackend.IdempotencyKey(string(operation), context.SessionID, params.BootstrapOperationID)\n175|\tcase terminalbackend.OperationQuiesceInput:\n176|\t\treturn terminalbackend.IdempotencyKey(string(operation), context.TerminalInstanceID, \"quiesce\", params.QuiescenceGeneration)\n177|\tcase terminalbackend.OperationWaitSafeBoundary:\n178|\t\treturn terminalbackend.IdempotencyKey(string(operation), context.TerminalInstanceID, \"boundary\", params.QuiescenceGeneration, string(params.ProviderProofKind))\n179|\tcase terminalbackend.OperationRequestStop:\n180|\t\treturn terminalbackend.IdempotencyKey(string(operation), context.TerminalInstanceID, \"stop\", params.SafeBoundaryEvidenceID)\n181|\tdefault:\n182|\t\treturn \"\", refuse(CodeProtocolError, \"operation lifecycle scope\")\n183|\t}\n184|}\n185|\n186|// CheckMutationContext enforces the semantic half of the mutating-request\n187|// contract for one already-parsed context: the carried key equals the\n188|// canonical material for the operation and the Go-level values re-admit\n189|// through their landed gates, so a hand-built context cannot bypass the\n190|// document arms. Generation staleness against the validated binding is\n191|// the engine's per-effect recheck, not this function.\n192|func CheckMutationContext(operation terminalbackend.Operation, context MutationContext, params Params) error {\n193|\tif _, err := terminalbackend.ParseOperation(string(operation)); err != nil {\n194|\t\treturn wrapLanded(err)\n195|\t}\n196|\tif _, err := scalar.ParseUUIDv7(context.OperationID); err != nil {\n197|\t\treturn refuse(CodeProtocolError, \"mutation context operation\")\n198|\t}\n199|\tif _, err := scalar.ParseUUIDv7(context.SessionID); err != nil {\n200|\t\treturn refuse(CodeProtocolError, \"mutation context session\")\n201|\t}\n202|\tif _, err := scalar.ParseUUIDv7(context.TerminalInstanceID); err != nil {\n203|\t\treturn refuse(CodeProtocolError, \"mutation context instance\")\n204|\t}\n205|\tif _, err := terminalbackend.ParseID(context.TerminalBackendID); err != nil {\n206|\t\treturn wrapLanded(err)\n207|\t}\n208|\tif err := checkVersionTuple(context.TerminalBackendID, context.ImplementationVersion, context.ProtocolVersion); err != nil {\n209|\t\treturn err\n210|\t}\n211|\tif err := checkGenerationBound(context.BackendGeneration); err != nil {\n212|\t\treturn err\n213|\t}\n214|\tif err := checkParams(operation, params); err != nil {\n215|\t\treturn err\n216|\t}\n217|\tif _, err := context.Deadline.Time(); err != nil {\n218|\t\treturn refuse(CodeProtocolError, \"mutation context deadline\")\n219|\t}\n220|\tderived, err := KeySegments(operation, context, params)\n221|\tif err != nil {\n222|\t\treturn err\n223|\t}\n224|\tif context.IdempotencyKey != derived {\n225|\t\treturn refuse(CodeProtocolError, \"idempotency key material\")\n226|\t}\n227|\treturn nil\n228|}\n229|\n230|// checkParams validates the per-operation parameters: quiescence\n231|// generations are UUIDv7, proof kinds parse, timeouts lie in\n232|// uint53[1..3600000] and the stop evidence is a digest.\n233|func checkParams(operation terminalbackend.Operation, params Params) error {\n234|\tswitch operation {\n235|\tcase terminalbackend.OperationCreate:\n236|\t\tif _, err := scalar.ParseUUIDv7(params.BootstrapOperationID); err != nil {\n237|\t\t\treturn refuse(CodeProtocolError, \"mutation context bootstrap\")\n238|\t\t}\n239|\t\treturn nil\n240|\tcase terminalbackend.OperationQuiesceInput:\n241|\t\tif _, err := scalar.ParseUUIDv7(params.QuiescenceGeneration); err != nil {\n242|\t\t\treturn refuse(CodeProtocolError, \"quiescence generation\")\n243|\t\t}\n244|\t\treturn nil\n245|\tcase terminalbackend.OperationWaitSafeBoundary:\n246|\t\tif _, err := scalar.ParseUUIDv7(params.QuiescenceGeneration); err != nil {\n247|\t\t\treturn refuse(CodeProtocolError, \"quiescence generation\")\n248|\t\t}\n249|\t\tif _, err := ParseProviderProofKind(string(params.ProviderProofKind)); err != nil {\n250|\t\t\treturn err\n251|\t\t}\n252|\t\tif params.TimeoutMs < 1 || params.TimeoutMs > 3600000 {\n253|\t\t\treturn refuse(CodeProtocolError, \"wait timeout bound\")\n254|\t\t}\n255|\t\treturn nil\n256|\tcase terminalbackend.OperationRequestStop:\n257|\t\tif _, err := scalar.ParseDigest(params.SafeBoundaryEvidenceID); err != nil {\n258|\t\t\treturn refuse(CodeProtocolError, \"stop boundary evidence\")\n259|\t\t}\n260|\t\tif params.GracefulTimeoutMs < 1 || params.GracefulTimeoutMs > 3600000 {\n261|\t\t\treturn refuse(CodeProtocolError, \"stop timeout bound\")\n262|\t\t}\n263|\t\treturn nil\n264|\tdefault:\n265|\t\treturn refuse(CodeProtocolError, \"operation lifecycle scope\")\n266|\t}\n267|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
