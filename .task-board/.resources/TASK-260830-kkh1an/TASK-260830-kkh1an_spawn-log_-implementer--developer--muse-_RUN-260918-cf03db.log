{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c875","stream":{"kind":"session","id":"01a0b291-18f0-70a0-900f-0c92cf0433eb"},"sequence":661,"recorded_at":1780531400001317,"record_type":"event","durability":"durable","causation_id":"cb7c4ff2-7892-4304-8de0-3769502303db","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cb7c4ff2-7892-4304-8de0-3769502303db","run_stream":{"kind":"run","id":"cb7c4ff2-7892-4304-8de0-3769502303db"},"task_stream":{"kind":"task","id":"01a0b292-c95e-7661-9f8d-5656c5713815"},"task_id":"01a0b292-c95e-7661-9f8d-5656c5713815","event":{"kind":"output","task_id":"01a0b292-c95e-7661-9f8d-5656c5713815","chunk":"Read text file `internal/terminstance/status_exec_test.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n9|)\n10|\n11|func exactStatusBody(t *testing.T) StatusBody {\n12|\tt.Helper()\n13|\tbody, err := ParseStatusBody([]byte(statusDoc(`\"`+fixtureInstance+`\"`, `\"generation-one\"`)))\n14|\tif err != nil {\n15|\t\tt.Fatalf(\"ParseStatusBody() error = %v\", err)\n16|\t}\n17|\treturn body\n18|}\n19|\n20|func matchingObservation() StatusObservation {\n21|\teffect := terminalbackend.EffectInputClosed\n22|\treturn StatusObservation{\n23|\t\tState:           terminalbackend.StateActive,\n24|\t\tIdentityMatch:   true,\n25|\t\tWrapperPresent:  true,\n26|\t\tAttachable:      false,\n27|\t\tLastEffect:      &effect,\n28|\t\tEvidenceIDs:     []string{fixtureDigestA},\n29|\t\tSessionID:       fixtureSessionA,\n30|\t\tInstanceID:      fixtureInstance,\n31|\t\tBackendID:       fixtureBackend,\n32|\t\tImplVersion:     fixtureImpl,\n33|\t\tProtoVersion:    fixtureProto,\n34|\t\tGeneration:      fixtureGen,\n35|\t\tAttachEvidenced: false,\n36|\t}\n37|}\n38|\n39|// TestExecuteStatusAdoptsReportedState drives the status row through the\n40|// production entry: the reported state is adopted verbatim — including\n41|// drift from the caller's source — with no receipt, no side effects\n42|// and no authorization.\n43|func TestExecuteStatusAdoptsReportedState(t *testing.T) {\n44|\tbackend := newMockBackend()\n45|\tbackend.observation = matchingObservation()\n46|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n47|\treport, err := engine.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"parked\"), testAdmitted(\"durable_disconnect\"))\n48|\tif err != nil {\n49|\t\tt.Fatalf(\"ExecuteStatus() error = %v\", err)\n50|\t}\n51|\trequireLiteral(t, \"state\", string(report.State), \"active\")\n52|\tif !report.IdentityMatch {\n53|\t\tt.Error(\"identity_match = false, want true\")\n54|\t}\n55|\tif len(backend.performed()) != 0 {\n56|\t\tt.Errorf(\"performed = %v, want no effects on status\", backend.performed())\n57|\t}\n58|\timage, err := engine.Store.Export()\n59|\tif err != nil {\n60|\t\tt.Fatalf(\"Export() error = %v\", err)\n61|\t}\n62|\tif len(image) != 0 {\n63|\t\tt.Errorf(\"store export = %q, want no receipts on status\", string(image))\n64|\t}\n65|}\n66|\n67|// TestExecuteStatusAllSources drives status from every one of the eight\n68|// states through the production entry: the same-state row admits them\n69|// all and transitions none.\n70|func TestExecuteStatusAllSources(t *testing.T) {\n71|\tfor _, source := range []string{\"absent\", \"creating\", \"parked\", \"active\", \"quiescing\", \"stopped\", \"stale_fenced\", \"unavailable\"} {\n72|\t\tt.Run(source, func(t *testing.T) {\n73|\t\t\tbackend := newMockBackend()\n74|\t\t\tobserved := matchingObservation()\n75|\t\t\tobserved.State = mustParseState(t, source)\n76|\t\t\tbackend.observation = observed\n77|\t\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n78|\t\t\treport, err := engine.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, source), testAdmitted(\"durable_disconnect\"))\n79|\t\t\tif err != nil {\n80|\t\t\t\tt.Fatalf(\"ExecuteStatus(%s) error = %v\", source, err)\n81|\t\t\t}\n82|\t\t\trequireLiteral(t, \"state\", string(report.State), source)\n83|\t\t})\n84|\t}\n85|\t// An unknown (empty) source is admitted too: the report is adopted\n86|\t// as the first observation.\n87|\tbackend := newMockBackend()\n88|\tbackend.observation = matchingObservation()\n89|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n90|\treport, err := engine.ExecuteStatus(contextGo(), exactStatusBody(t), \"\", testAdmitted(\"durable_disconnect\"))\n91|\tif err != nil {\n92|\t\tt.Fatalf(\"ExecuteStatus(unknown source) error = %v\", err)\n93|\t}\n94|\trequireLiteral(t, \"state\", string(report.State), \"active\")\n95|\n96|\t// A malformed source refuses before any observation runs, even\n97|\t// with a valid report scripted behind it.\n98|\tbackendGarbage := newMockBackend()\n99|\tbackendGarbage.observation = matchingObservation()\n100|\tengineGarbage := testEngine(t, backendGarbage, testLease(), fixtureGen)\n101|\t_, err = engineGarbage.ExecuteStatus(contextGo(), exactStatusBody(t), \"bogus\", testAdmitted(\"durable_disconnect\"))\n102|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"lifecycle state vocabulary\")\n103|\tif backendGarbage.observeCalls != 0 {\n104|\t\tt.Errorf(\"observe calls = %d, want none on the malformed source\", backendGarbage.observeCalls)\n105|\t}\n106|}\n107|\n108|// TestExecuteStatusReportMemberRefusals proves the reported identity\n109|// tuple is shape-validated before comparison: a malformed reported\n110|// session, backend, version, instance or generation refuses through\n111|// the production entry instead of comparing.\n112|func TestExecuteStatusReportMemberRefusals(t *testing.T) {\n113|\tcases := []struct {\n114|\t\tname   string\n115|\t\tmutate func(*StatusObservation)\n116|\t\tcode   string\n117|\t\tdetail string\n118|\t}{\n119|\t\t{\"session\", func(observed *StatusObservation) { observed.SessionID = \"nope\" }, \"terminal_backend_protocol_error\", \"status report session\"},\n120|\t\t{\"backend\", func(observed *StatusObservation) { observed.BackendID = \"Has-Upper\" }, \"terminal_backend_not_found\", \"terminal_backend_id grammar\"},\n121|\t\t{\"implementation\", func(observed *StatusObservation) { observed.ImplVersion = \"1.2\" }, \"terminal_backend_implementation_drift\", \"implementation_version semver\"},\n122|\t\t{\"protocol\", func(observed *StatusObservation) { observed.ProtoVersion = \"2.0.0\" }, \"terminal_backend_implementation_drift\", \"protocol_version major 1\"},\n123|\t\t{\"instance\", func(observed *StatusObservation) { observed.InstanceID = \"nope\" }, \"terminal_backend_protocol_error\", \"status report instance\"},\n124|\t\t{\"generation\", func(observed *StatusObservation) { observed.Generation = strings.Repeat(\"g\", 257) }, \"terminal_backend_protocol_error\", \"status report generation\"},\n125|\t}\n126|\tfor _, tc := range cases {\n127|\t\tt.Run(tc.name, func(t *testing.T) {\n128|\t\t\tbackend := newMockBackend()\n129|\t\t\tobserved := matchingObservation()\n130|\t\t\ttc.mutate(&observed)\n131|\t\t\tbackend.observation = observed\n132|\t\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n133|\t\t\t_, err := engine.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n134|\t\t\trequireRefusal(t, err, tc.code, tc.detail)\n135|\t\t})\n136|\t}\n137|}\n138|\n139|// TestExecuteStatusNonMatchAdoptsAbsent proves a successful non-match\n140|// read adopts the canonical absent form: drifted generation with the\n141|// false form is a proven absence, not an error.\n142|func TestExecuteStatusNonMatchAdoptsAbsent(t *testing.T) {\n143|\tbackend := newMockBackend()\n144|\tbackend.observation = StatusObservation{\n145|\t\tState:         terminalbackend.StateAbsent,\n146|\t\tIdentityMatch: false,\n147|\t\tSessionID:     fixtureSessionA,\n148|\t\tInstanceID:    fixtureInstance,\n149|\t\tBackendID:     fixtureBackend,\n150|\t\tImplVersion:   fixtureImpl,\n151|\t\tProtoVersion:  fixtureProto,\n152|\t\tGeneration:    \"generation-two\",\n153|\t}\n154|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n155|\treport, err := engine.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n156|\tif err != nil {\n157|\t\tt.Fatalf(\"ExecuteStatus() error = %v\", err)\n158|\t}\n159|\trequireLiteral(t, \"state\", string(report.State), \"absent\")\n160|\tif report.IdentityMatch {\n161|\t\tt.Error(\"identity_match = true, want false\")\n162|\t}\n163|}\n164|\n165|// TestExecuteStatusUnknownIsNeverAbsent proves a timeout or read failure\n166|// is unknown, never absent: coded failures pass their row code through\n167|// with no report, uncoded failures refuse unavailable with no report,\n168|// and a code outside the status set is rejected.\n169|func TestExecuteStatusUnknownIsNeverAbsent(t *testing.T) {\n170|\tbackend := newMockBackend()\n171|\tbackend.observeErr = refuse(\"terminal_backend_timeout\", \"test timeout\")\n172|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n173|\t_, err := engine.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n174|\trequireRefusal(t, err, \"terminal_backend_timeout\", \"status observation unknown\")\n175|\n176|\tbackendUncoded := newMockBackend()\n177|\tbackendUncoded.observeErr = errors.New(\"read failed\")\n178|\tengineUncoded := testEngine(t, backendUncoded, testLease(), fixtureGen)\n179|\t_, err = engineUncoded.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n180|\trequireRefusal(t, err, \"terminal_backend_unavailable\", \"status observation unknown\")\n181|\n182|\tbackendOutside := newMockBackend()\n183|\tbackendOutside.observeErr = refuse(\"quiesce_timeout\", \"test outside set\")\n184|\tengineOutside := testEngine(t, backendOutside, testLease(), fixtureGen)\n185|\t_, err = engineOutside.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n186|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"operation error vocabulary\")\n187|}\n188|\n189|// TestExecuteStatusReportValidation proves the reported match must equal\n190|// the compared tuple and the landed status rules admit the report: a\n191|// lying match, a non-canonical false form and unsorted evidence all\n192|// refuse through the production entry.\n193|func TestExecuteStatusReportValidation(t *testing.T) {\n194|\tbackend := newMockBackend()\n195|\tlying := matchingObservation()\n196|\tlying.IdentityMatch = false\n197|\tbackend.observation = lying\n198|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n199|\t_, err := engine.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n200|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"status identity binding\")\n201|\n202|\tbackendForm := newMockBackend()\n203|\tnoncanonical := matchingObservation()\n204|\tnoncanonical.IdentityMatch = false\n205|\tnoncanonical.WrapperPresent = true\n206|\tnoncanonical.Generation = \"generation-two\"\n207|\tbackendForm.observation = noncanonical\n208|\tengineForm := testEngine(t, backendForm, testLease(), fixtureGen)\n209|\t_, err = engineForm.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n210|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"status identity binding\")\n211|\n212|\tbackendEvidence := newMockBackend()\n213|\tunsorted := matchingObservation()\n214|\tunsorted.EvidenceIDs = []string{fixtureDigestB, fixtureDigestA}\n215|\tbackendEvidence.observation = unsorted\n216|\tengineEvidence := testEngine(t, backendEvidence, testLease(), fixtureGen)\n217|\t_, err = engineEvidence.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n218|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"status evidence order\")\n219|}\n220|\n221|// TestExecuteStatusMatchedTupleFalseFormRefuses proves the engine's own\n222|// match-equality arm, past which the landed gate alone would admit: a\n223|// report whose tuple matches but which claims non-match with the\n224|// canonical absent form would adopt a lying absence, so the engine\n225|// refuses it before the landed check runs.\n226|func TestExecuteStatusMatchedTupleFalseFormRefuses(t *testing.T) {\n227|\tbackend := newMockBackend()\n228|\tlying := StatusObservation{\n229|\t\tState:         terminalbackend.StateAbsent,\n230|\t\tIdentityMatch: false,\n231|\t\tSessionID:     fixtureSessionA,\n232|\t\tInstanceID:    fixtureInstance,\n233|\t\tBackendID:     fixtureBackend,\n234|\t\tImplVersion:   fixtureImpl,\n235|\t\tProtoVersion:  fixtureProto,\n236|\t\tGeneration:    fixtureGen,\n237|\t}\n238|\tbackend.observation = lying\n239|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n240|\t_, err := engine.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n241|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"status identity binding\")\n242|}\n243|\n244|// TestExecuteStatusProviderConditional proves provider_process_observation\n245|// is required exactly when provider observation is requested.\n246|func TestExecuteStatusProviderConditional(t *testing.T) {\n247|\traw := statusDoc(`\"`+fixtureInstance+`\"`, `\"generation-one\"`)\n248|\twithProvider := func(t *testing.T) StatusBody {\n249|\t\tt.Helper()\n250|\t\tbody, err := ParseStatusBody([]byte(withObservation(raw)))\n251|\t\tif err != nil {\n252|\t\t\tt.Fatalf(\"ParseStatusBody() error = %v\", err)\n253|\t\t}\n254|\t\treturn body\n255|\t}\n256|\tbackend := newMockBackend()\n257|\tbackend.observation = matchingObservation()\n258|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n259|\t_, err := engine.ExecuteStatus(contextGo(), withProvider(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n260|\trequireRefusal(t, err, \"terminal_backend_capability_unproven\", \"operation capability conditional\")\n261|\n262|\tbackendProven := newMockBackend()\n263|\tobserved := matchingObservation()\n264|\tpresent := true\n265|\tobserved.ProviderPresent = &present\n266|\tobserved.ProviderRequested = true\n267|\tobserved.ProviderEvidenced = true\n268|\tbackendProven.observation = observed\n269|\tengineProven := testEngine(t, backendProven, testLease(), fixtureGen)\n270|\treport, err := engineProven.ExecuteStatus(contextGo(), withProvider(t), mustParseState(t, \"active\"), testAdmitted(\"provider_process_observation\"))\n271|\tif err != nil {\n272|\t\tt.Fatalf(\"ExecuteStatus() error = %v\", err)\n273|\t}\n274|\tif report.ProviderPresent == nil || !*report.ProviderPresent {\n275|\t\tt.Error(\"provider_present is not true, want the evidenced observation\")\n276|\t}\n277|}\n278|\n279|func withObservation(raw string) string {\n280|\tbefore := `\"include_provider_observation\":false`\n281|\tafter := `\"include_provider_observation\":true`\n282|\tfor i := 0; i+len(before) <= len(raw); i++ {\n283|\t\tif raw[i:i+len(before)] == before {\n284|\t\t\treturn raw[:i] + after + raw[i+len(before):]\n285|\t\t}\n286|\t}\n287|\treturn raw\n288|}\n289|\n290|// TestExecuteStatusSessionScoped proves the Session-scoped lookup adopts\n291|// the reported instance: both-null members query, the reported session\n292|// must match, and the reported state is adopted.\n293|func TestExecuteStatusSessionScoped(t *testing.T) {\n294|\tbody, err := ParseStatusBody([]byte(statusDoc(`null`, `null`)))\n295|\tif err != nil {\n296|\t\tt.Fatalf(\"ParseStatusBody() error = %v\", err)\n297|\t}\n298|\tbackend := newMockBackend()\n299|\tbackend.observation = matchingObservation()\n300|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n301|\treport, err := engine.ExecuteStatus(contextGo(), body, mustParseState(t, \"absent\"), testAdmitted(\"durable_disconnect\"))\n302|\tif err != nil {\n303|\t\tt.Fatalf(\"ExecuteStatus() error = %v\", err)\n304|\t}\n305|\trequireLiteral(t, \"state\", string(report.State), \"active\")\n306|}","final_result":true}}}
