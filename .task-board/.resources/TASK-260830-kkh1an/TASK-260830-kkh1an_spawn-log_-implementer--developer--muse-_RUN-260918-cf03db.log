184|        find=\"\\tdefault:\\n\\t\\tif committed {\\n\\t\\t\\treturn DispositionStatusFirst\\n\\t\\t}\\n\\t\\treturn DispositionRequiredOperatorAction\\n\\t}\\n\",\n185|        replace=\"\\tdefault:\\n\\t\\tif committed {\\n\\t\\t\\treturn DispositionStatusFirst\\n\\t\\t}\\n\\t\\tif code == CodeCapabilityUnproven {\\n\\t\\t\\treturn DispositionReplaySame\\n\\t\\t}\\n\\t\\treturn DispositionRequiredOperatorAction\\n\\t}\\n\",\n186|        count=1,\n187|        run=\"TestDispositionForMapping\",\n188|        expect=\"KILLED\",\n189|        note=\"Maps exactly uncommitted capability_unproven to replay_same; the rest still stop automation.\",\n190|    ),\n191|    Mutant(\n192|        name=\"N-proof-vocab\",\n193|        path=f\"{PACKAGE}/proof.go\",\n194|        find='\\tdefault:\\n\\t\\treturn \"\", refuse(CodeProtocolError, \"provider proof vocabulary\")\\n\\t}\\n',\n195|        replace='\\tdefault:\\n\\t\\tif value == \"provider_restart\" {\\n\\t\\t\\treturn ProofProviderQuiescence, nil\\n\\t\\t}\\n\\t\\treturn \"\", refuse(CodeProtocolError, \"provider proof vocabulary\")\\n\\t}\\n',\n196|        count=1,\n197|        run=\"TestParseProviderProofKindClosed\",\n198|        expect=\"KILLED\",\n199|        note=\"Admits exactly the provider_restart token; every other non-kind still refuses.\",\n200|    ),\n201|    Mutant(\n202|        name=\"N-proof-provider\",\n203|        path=f\"{PACKAGE}/proof.go\",\n204|        find=\"\\tcase ProofProviderQuiescence, ProofProviderProcessExit:\\n\\t\\treturn true\\n\",\n205|        replace=\"\\tcase ProofProviderQuiescence, ProofProviderProcessExit, ProofAXCheckpointBoundary:\\n\\t\\treturn true\\n\",\n206|        count=1,\n207|        run=\"TestRequiresProviderObservation\",\n208|        expect=\"KILLED\",\n209|        note=\"Classifies exactly the AX boundary as a provider kind; other classifications stay.\",\n210|    ),\n211|    Mutant(\n212|        name=\"N-context-key\",\n213|        path=f\"{PACKAGE}/context.go\",\n214|   