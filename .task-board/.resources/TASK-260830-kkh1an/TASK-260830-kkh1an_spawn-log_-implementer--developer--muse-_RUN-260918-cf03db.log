{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c769","stream":{"kind":"session","id":"01a0b291-18f0-70a0-900f-0c92cf0433eb"},"sequence":527,"recorded_at":1780531400001049,"record_type":"event","durability":"durable","causation_id":"cb7c4ff2-7892-4304-8de0-3769502303db","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"cb7c4ff2-7892-4304-8de0-3769502303db","run_stream":{"kind":"run","id":"cb7c4ff2-7892-4304-8de0-3769502303db"},"call_id":"call_01a0b2928c56744d9cd23c2cd25cdffd","text":"Read text file `internal/terminstance/execute.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"time\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n10|)\n11|\n12|// Backend is the modeled terminal backend caller: side-effect execution\n13|// and status observation. No tmux/ConPTY process control and no provider\n14|// process exist behind it; tests model success, coded row refusals,\n15|// uncoded failures and crashes through this interface.\n16|type Backend interface {\n17|\t// PerformEffect executes one side effect and reports its evidence\n18|\t// ID. A nil error proves the commit; a *Error with a row code\n19|\t// proves the backend refused before committing; any other error\n20|\t// proves nothing, not even non-commit.\n21|\tPerformEffect(ctx context.Context, effect terminalbackend.SideEffect) (string, error)\n22|\t// ObserveStatus reports the backend's current observation for one\n23|\t// status body. An error is unknown, never absent.\n24|\tObserveStatus(ctx context.Context, body StatusBody) (StatusObservation, error)\n25|}\n26|\n27|// StatusObservation is the backend-reported status observation: the\n28|// reported state and match verdict, the reported identity tuple the\n29|// engine compares against the query, and the reported capability and\n30|// last-operation facts the landed CheckStatusResult validates.\n31|type StatusObservation struct {\n32|\tState             terminalbackend.InstanceState\n33|\tIdentityMatch     bool\n34|\tWrapperPresent    bool\n35|\tProviderPresent   *bool\n36|\tAttachable        bool\n37|\tLastOperationID   *string\n38|\tLastEffect        *terminalbackend.SideEffect\n39|\tEvidenceIDs       []string\n40|\tProviderRequested bool\n41|\tProviderEvidenced bool\n42|\tAttachEvidenced   bool\n43|\tSessionID         string\n44|\tInstanceID        string\n45|\tBackendID         string\n46|\tImplVersion       string\n47|\tProtoVersion      string\n48|\tGeneration        string\n49|}\n50|\n51|// StatusReport is the validated status outcome: the adopted observation.\n52|// Status performs no transition bookkeeping of its own — no receipt, no\n53|// effects, no before/after — so the report carries the single adopted\n54|// state verbatim.\n55|type StatusReport struct {\n56|\tState           terminalbackend.InstanceState\n57|\tIdentityMatch   bool\n58|\tWrapperPresent  bool\n59|\tProviderPresent *bool\n60|\tAttachable      bool\n61|\tLastOperationID *string\n62|\tLastEffect      *terminalbackend.SideEffect\n63|\tEvidenceIDs     []string\n64|}\n65|\n66|// EngineHooks arms the engine seams tests observe: AfterReceipt fires\n67|// after the durable receipt commits and before the first side effect,\n68|// carrying the interim state (creating for create, the source\n69|// otherwise); BeforeEffect and AfterEffect bracket each committed\n70|// attempt. Hooks observe only: they return nothing and cannot alter\n71|// the outcome.\n72|type EngineHooks struct {\n73|\tAfterReceipt func(operation terminalbackend.Operation, key string, interim terminalbackend.InstanceState)\n74|\tBeforeEffect func(effect terminalbackend.SideEffect)\n75|\tAfterEffect  func(effect terminalbackend.SideEffect)\n76|}\n77|\n78|// Engine executes the §4.C operation rows. Store is the durable receipt\n79|// table; Backend the modeled backend; CurrentLease and CurrentGeneration\n80|// re-read the winning lease and the validated binding generation at\n81|// every check point (function values, never snapshots, so a rotation\n82|// between entry and any effect is caught); Now is the clock. Hooks may\n83|// be nil.\n84|type Engine struct {\n85|\tStore             *ReceiptStore\n86|\tBackend           Backend\n87|\tCurrentLease      func() LeaseView\n88|\tCurrentGeneration func() string\n89|\tNow               func() time.Time\n90|\tHooks             *EngineHooks\n91|}\n92|\n93|// InterimState is the observable state between the durable idempotency\n94|// receipt and the first side effect: creating for create, the source\n95|// state for every other engine operation. creating is entered only by\n96|// create, only after its receipt and before its first listed effect.\n97|func InterimState(operation terminalbackend.Operation, source terminalbackend.InstanceState) terminalbackend.InstanceState {\n98|\tif operation == terminalbackend.OperationCreate {\n99|\t\treturn terminalbackend.StateCreating\n100|\t}\n101|\treturn source\n102|}\n103|\n104|// kindFor maps an engine operation to its AXAuthorization kind. The\n105|// force_stale and restore kinds parse but no engine operation requests\n106|// them: terminate-stale and restore recovery belongs to the story's\n107|// final leaf.\n108|func kindFor(operation terminalbackend.Operation) (AuthorizationKind, bool) {\n109|\tswitch operation {\n110|\tcase terminalbackend.OperationCreate:\n111|\t\treturn AuthorizationCreate, true\n112|\tcase terminalbackend.OperationQuiesceInput,\n113|\t\tterminalbackend.OperationWaitSafeBoundary,\n114|\t\tterminalbackend.OperationRequestStop:\n115|\t\treturn AuthorizationControl, true\n116|\tdefault:\n117|\t\treturn \"\", false\n118|\t}\n119|}\n120|\n121|// rowTimeoutCode is the §4.C timeout vocabulary per engine row: the wait\n122|// row times out quiesce_timeout and the stop row stop_timeout, while\n123|// create and quiesce-input time out terminal_backend_timeout.\n124|//\n125|// An engine deadline cancel before any attempt reports replay_same on\n126|// every row, including stop: nothing was attempted, so the identical\n127|// retry is safe. That differs deliberately from a backend-REPORTED\n128|// stop_timeout, which maps through DispositionFor (status_first even\n129|// uncommitted): a graceful wait that ran and timed out may have left\n130|// the provider mid-shutdown, while a cancel before the first attempt\n131|// proves nothing happened. The two directions are pinned together by\n132|// TestExecuteEntryDeadlineCodes and the stop rows of\n133|// TestExecuteBackendRowErrorSets.\n134|func rowTimeoutCode(operation terminalbackend.Operation) string {\n135|\tswitch operation {\n136|\tcase terminalbackend.OperationWaitSafeBoundary:\n137|\t\treturn CodeQuiesceTimeout\n138|\tcase terminalbackend.OperationRequestStop:\n139|\t\treturn CodeStopTimeout\n140|\tdefault:\n141|\t\treturn CodeTimeout\n142|\t}\n143|}\n144|\n145|// engineScope admits exactly the operations this engine executes: the\n146|// status, quiesce-input, wait-safe-boundary and request-stop rows plus\n147|// the create receipt rule. Status has its own entry; attach, restore,\n148|// terminate-stale, manifest and probe are refused here.\n149|func engineScope(operation terminalbackend.Operation) error {\n150|\tswitch operation {\n151|\tcase terminalbackend.OperationCreate, terminalbackend.OperationQuiesceInput,\n152|\t\tterminalbackend.OperationWaitSafeBoundary, terminalbackend.OperationRequestStop:\n153|\t\treturn nil\n154|\tdefault:\n155|\t\treturn refuse(CodeProtocolError, \"operation lifecycle scope\")\n156|\t}\n157|}\n158|\n159|// checkCapabilityConditional evaluates the §4.C conditional capability\n160|// dependencies at the operation call site, the half the landed\n161|// CheckOperation explicitly leaves to the lifecycle owner: headless\n162|// creation for non-interactive create, and safe-boundary observation\n163|// (plus provider-process observation for provider proof kinds) for\n164|// wait-safe-boundary. Quiesce-input and request-stop carry no conditional\n165|// beyond conferral — input_quiescence and graceful_stop are their sole\n166|// conferring capabilities, so the landed CheckOperation decides those\n167|// rows alone and no second arm restates it. The credential-realm\n168|// conditional is a stated bound: credential need is not modeled on this\n169|// path.\n170|func checkCapabilityConditional(operation terminalbackend.Operation, params Params, admitted terminalbackend.Admitted) error {\n171|\tswitch operation {\n172|\tcase terminalbackend.OperationCreate:\n173|\t\tif !params.Interactive && !admitted.Has(\"headless_creation\") {\n174|\t\t\treturn refuse(CodeCapabilityUnproven, \"operation capability conditional\")\n175|\t\t}\n176|\t\treturn nil\n177|\tcase terminalbackend.OperationQuiesceInput, terminalbackend.OperationRequestStop:\n178|\t\treturn nil\n179|\tcase terminalbackend.OperationWaitSafeBoundary:\n180|\t\tif !admitted.Has(\"safe_boundary_observation\") {\n181|\t\t\treturn refuse(CodeCapabilityUnproven, \"operation capability conditional\")\n182|\t\t}\n183|\t\tif RequiresProviderObservation(params.ProviderProofKind) && !admitted.Has(\"provider_process_observation\") {\n184|\t\t\treturn refuse(CodeCapabilityUnproven, \"operation capability conditional\")\n185|\t\t}\n186|\t\treturn nil\n187|\tdefault:\n188|\t\treturn refuse(CodeProtocolError, \"operation lifecycle scope\")\n189|\t}\n190|}\n191|\n192|// ExecuteMutating executes one create, quiesce-input, wait-safe-boundary\n193|// or request-stop request from the source state. A nil error is success\n194|// (after is the transition target, disposition replay_same: re-sending\n195|// replays). A non-nil execution error carries the row code with after\n196|// and disposition per the §4.C error rules: an error before the first\n197|// side effect restores the source state, while an error after a\n198|// committed effect whose result cannot be proven moves the local\n199|// observation to unavailable with status_first (new_authorization when\n200|// the failure names auth drift) and never claims absent. Malformed\n201|// requests (unknown operation, unparseable source or context) return an\n202|// empty result with the error, because a result repeating unvalidated\n203|// identities would echo data the gates refused. Authorization and\n204|// generation are rechecked immediately before each side effect, not\n205|// once at entry; a deadline cancels waiting, never a committed effect.\n206|//\n207|// Emission bound: the §4.C row sets govern backend REPORTS, which the\n208|// engine routes through CheckErrorAllowed (an outside-set code is\n209|// refused as a protocol error). The engine's own AX-side seam verdicts\n210|// are outside that rule: an uncoded effect outcome classifies\n211|// terminal_backend_process_failed, and an uncertain retry (receipt\n212|// without completion) refuses terminal_backend_unavailable, both with\n213|// after unavailable and status_first per the row recovery columns\n214|// (\"uncertainty requires status\", \"an error after an effect whose\n215|// result cannot be proven\"). Those codes are the leaf's contract for\n216|// failures the backend never coded, pinned literally below.\n217|func (engine *Engine) ExecuteMutating(ctx context.Context, operation terminalbackend.Operation, context MutationContext, params Params, source terminalbackend.InstanceState, admitted terminalbackend.Admitted) (Result, error) {\n218|\tempty := Result{}\n219|\tif engine == nil || engine.Store == nil || engine.Backend == nil ||\n220|\t\tengine.CurrentLease == nil || engine.CurrentGeneration == nil || engine.Now == nil {\n221|\t\treturn empty, refuse(CodeProtocolError, \"engine unavailable\")\n222|\t}\n223|\tif _, err := terminalbackend.ParseOperation(string(operation)); err != nil {\n224|\t\treturn empty, wrapLanded(err)\n225|\t}\n226|\tif err := engineScope(operation); err != nil {\n227|\t\treturn empty, err\n228|\t}\n229|\tif _, err := terminalbackend.ParseInstanceState(string(source)); err != nil {\n230|\t\treturn empty, wrapLanded(err)\n231|\t}\n232|\tif err := CheckMutationContext(operation, context, params); err != nil {\n233|\t\treturn empty, err\n234|\t}\n235|\tif err := terminalbackend.CheckOperation(string(operation), admitted); err != nil {\n236|\t\tfailure := wrapLanded(err)\n237|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n238|\t}\n239|\tif err := checkCapabilityConditional(operation, params, admitted); err != nil {\n240|\t\tfailure := err.(*Error)\n241|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n242|\t}\n243|\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), params.Interactive)\n244|\tif err != nil {\n245|\t\tfailure := wrapLanded(err)\n246|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n247|\t}\n248|\tkind, _ := kindFor(operation)\n249|\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil {\n250|\t\tfailure := err.(*Error)\n251|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n252|\t}\n253|\tif engine.CurrentGeneration() != context.BackendGeneration {\n254|\t\tfailure := refuse(CodeStaleGeneration, \"backend_generation stale\")\n255|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n256|\t}\n257|\tdeadline, err := context.Deadline.Time()\n258|\tif err != nil {\n259|\t\treturn empty, refuse(CodeProtocolError, \"mutation context deadline\")\n260|\t}\n261|\tif !engine.Now().Before(deadline) {\n262|\t\tfailure := refuse(rowTimeoutCode(operation), \"operation deadline\")\n263|\t\treturn buildResult(context, source, source, nil, nil, DispositionReplaySame), failure\n264|\t}\n265|\tkey := context.IdempotencyKey\n266|\t_, replayed, err := engine.Store.Bind(key, operation, context.OperationID)\n267|\tif err != nil {\n268|\t\tfailure, ok := err.(*Error)\n269|\t\tif !ok {\n270|\t\t\tuncoded := refuse(CodeProcessFailed, \"idempotency store failure\")\n271|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), uncoded\n272|\t\t}\n273|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n274|\t}\n275|\tif replayed {\n276|\t\tstored, found, err := engine.Store.Completed(key)\n277|\t\tif err != nil {\n278|\t\t\tuncoded := refuse(CodeProcessFailed, \"idempotency store failure\")\n279|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), uncoded\n280|\t\t}\n281|\t\tif !found {\n282|\t\t\tfailure := refuse(CodeUnavailable, \"idempotency result uncertain\")\n283|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), failure\n284|\t\t}\n285|\t\tvar result Result\n286|\t\tif err := json.Unmarshal(stored, &result); err != nil {\n287|\t\t\tfailure := refuse(CodeIntegrityFailure, \"idempotency result image\")\n288|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), failure\n289|\t\t}\n290|\t\tif err := CheckResult(context, source, result); err != nil {\n291|\t\t\tfailure, ok := err.(*Error)\n292|\t\t\tif !ok {\n293|\t\t\t\tuncoded := refuse(CodeIntegrityFailure, \"idempotency result image\")\n294|\t\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), uncoded\n295|\t\t\t}\n296|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionFor(failure.Code, true)), failure\n297|\t\t}\n298|\t\treturn result, nil\n299|\t}\n300|\tif engine.Hooks != nil && engine.Hooks.AfterReceipt != nil {\n301|\t\tengine.Hooks.AfterReceipt(operation, key, InterimState(operation, source))\n302|\t}\n303|\tcommitted := false\n304|\tevidence := []string(nil)\n305|\tperformed := []terminalbackend.SideEffect(nil)\n306|\tfor _, effect := range effects {\n307|\t\tif !engine.Now().Before(deadline) {\n308|\t\t\tfailure := refuse(rowTimeoutCode(operation), \"operation deadline\")\n309|\t\t\tif committed {\n310|\t\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, performed, evidence, DispositionStatusFirst), failure\n311|\t\t\t}\n312|\t\t\treturn buildResult(context, source, source, performed, evidence, DispositionReplaySame), failure\n313|\t\t}\n314|\t\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil {\n315|\t\t\tfailure := err.(*Error)\n316|\t\t\tafter := source\n317|\t\t\tif committed {\n318|\t\t\t\tafter = terminalbackend.StateUnavailable\n319|\t\t\t}\n320|\t\t\treturn buildResult(context, source, after, performed, evidence, DispositionFor(failure.Code, committed)), failure\n321|\t\t}\n322|\t\tif engine.CurrentGeneration() != context.BackendGeneration {\n323|\t\t\tfailure := refuse(CodeStaleGeneration, \"backend_generation stale\")\n324|\t\t\tafter := source\n325|\t\t\tif committed {\n326|\t\t\t\tafter = terminalbackend.StateUnavailable\n327|\t\t\t}\n328|\t\t\treturn buildResult(context, source, after, performed, evidence, DispositionFor(failure.Code, committed)), failure\n329|\t\t}\n330|\t\tif engine.Hooks != nil && engine.Hooks.BeforeEffect != nil {\n331|\t\t\tengine.Hooks.BeforeEffect(effect)\n332|\t\t}\n333|\t\tevidenceID, err := engine.Backend.PerformEffect(ctx, effect)\n334|\t\tif engine.Hooks != nil && engine.Hooks.AfterEffect != nil {\n335|\t\t\tengine.Hooks.AfterEffect(effect)\n336|\t\t}\n337|\t\tif err != nil {\n338|\t\t\tcode := ErrorCode(err)\n339|\t\t\tif code == \"\" {\n340|\t\t\t\tfailure := refuse(CodeProcessFailed, \"backend effect uncertain\")\n341|\t\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, performed, evidence, DispositionStatusFirst), failure\n342|\t\t\t}\n343|\t\t\tif err := terminalbackend.CheckErrorAllowed(string(operation), code); err != nil {\n344|\t\t\t\tfailure := refuse(CodeProtocolError, \"operation error vocabulary\")\n345|\t\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, performed, evidence, DispositionStatusFirst), failure\n346|\t\t\t}\n347|\t\t\tafter := source\n348|\t\t\tif committed {\n349|\t\t\t\tafter = terminalbackend.StateUnavailable\n350|\t\t\t}\n351|\t\t\tfailure := refuse(code, \"backend effect refused\")\n352|\t\t\treturn buildResult(context, source, after, performed, evidence, DispositionFor(code, committed)), failure\n353|\t\t}\n354|\t\tif _, err := scalar.ParseDigest(evidenceID); err != nil {\n355|\t\t\tfailure := refuse(CodeIntegrityFailure, \"backend effect evidence\")\n356|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, performed, evidence, DispositionStatusFirst), failure\n357|\t\t}\n358|\t\tcommitted = true\n359|\t\tperformed = append(performed, effect)\n360|\t\tevidence = append(evidence, evidenceID)\n361|\t}\n362|\tresult := buildResult(context, source, target, performed, evidence, DispositionReplaySame)\n363|\tencoded, err := json.Marshal(result)\n364|\tif err != nil {\n365|\t\tfailure := refuse(CodeIntegrityFailure, \"idempotency result image\")\n366|\t\tresult.Disposition = DispositionStatusFirst\n367|\t\treturn result, failure\n368|\t}\n369|\tif err := engine.Store.Complete(key, encoded); err != nil {\n370|\t\tfailure, ok := err.(*Error)\n371|\t\tif !ok {\n372|\t\t\tuncoded := refuse(CodeProcessFailed, \"idempotency store failure\")\n373|\t\t\tresult.Disposition = DispositionStatusFirst\n374|\t\t\treturn result, uncoded\n375|\t\t}\n376|\t\tresult.Disposition = DispositionStatusFirst\n377|\t\treturn result, failure\n378|\t}\n379|\treturn result, nil\n380|}\n381|\n382|// ExecuteStatus executes one status query: no receipt, no side effects,\n383|// no authorization and no transition bookkeeping of its own. The\n384|// reported state is adopted verbatim; the engine validates the report\n385|// (the reported match must equal the compared tuple, the landed\n386|// CheckStatusResult must admit it, evidence must be sorted-unique\n387|// digests) and enforces the provider-observation capability conditional.\n388|// A timeout or read failure is unknown, never absent: it returns an\n389|// error with no report.\n390|func (engine *Engine) ExecuteStatus(ctx context.Context, body StatusBody, source terminalbackend.InstanceState, admitted terminalbackend.Admitted) (StatusReport, error) {\n391|\tempty := StatusReport{}\n392|\tif engine == nil || engine.Backend == nil || engine.Now == nil {\n393|\t\treturn empty, refuse(CodeProtocolError, \"engine unavailable\")\n394|\t}\n395|\tif source != \"\" {\n396|\t\tif _, _, err := terminalbackend.CheckTransition(string(terminalbackend.OperationStatus), string(source), false); err != nil {\n397|\t\t\treturn empty, wrapLanded(err)\n398|\t\t}\n399|\t}\n400|\tdeadline, err := body.Deadline.Time()\n401|\tif err != nil {\n402|\t\treturn empty, refuse(CodeProtocolError, \"status body deadline\")\n403|\t}\n404|\tif !engine.Now().Before(deadline) {\n405|\t\treturn empty, refuse(CodeTimeout, \"operation deadline\")\n406|\t}\n407|\tif body.IncludeProviderObservation && !admitted.Has(\"provider_process_observation\") {\n408|\t\treturn empty, refuse(CodeCapabilityUnproven, \"operation capability conditional\")\n409|\t}\n410|\tobserved, err := engine.Backend.ObserveStatus(ctx, body)\n411|\tif err != nil {\n412|\t\tcode := ErrorCode(err)\n413|\t\tif code == \"\" {\n414|\t\t\treturn empty, refuse(CodeUnavailable, \"status observation unknown\")\n415|\t\t}\n416|\t\tif err := terminalbackend.CheckErrorAllowed(string(terminalbackend.OperationStatus), code); err != nil {\n417|\t\t\treturn empty, refuse(CodeProtocolError, \"operation error vocabulary\")\n418|\t\t}\n419|\t\treturn empty, refuse(code, \"status observation unknown\")\n420|\t}\n421|\tif _, err := terminalbackend.ParseInstanceState(string(observed.State)); err != nil {\n422|\t\treturn empty, wrapLanded(err)\n423|\t}\n424|\tcomputed, err := statusIdentityMatch(body, observed)\n425|\tif err != nil {\n426|\t\treturn empty, err\n427|\t}\n428|\tif observed.IdentityMatch != computed {\n429|\t\treturn empty, refuse(CodeProtocolError, \"status identity binding\")\n430|\t}\n431|\tconverted := terminalbackend.StatusResult{\n432|\t\tState:             observed.State,\n433|\t\tIdentityMatch:     observed.IdentityMatch,\n434|\t\tWrapperPresent:    observed.WrapperPresent,\n435|\t\tProviderPresent:   observed.ProviderPresent,\n436|\t\tAttachable:        observed.Attachable,\n437|\t\tLastOperationID:   observed.LastOperationID,\n438|\t\tLastEffect:        observed.LastEffect,\n439|\t\tProviderRequested: observed.ProviderRequested,\n440|\t\tProviderEvidenced: observed.ProviderEvidenced,\n441|\t\tAttachEvidenced:   observed.AttachEvidenced,\n442|\t}\n443|\tif observed.LastOperationID != nil {\n444|\t\tif _, err := scalar.ParseUUIDv7(*observed.LastOperationID); err != nil {\n445|\t\t\treturn empty, refuse(CodeProtocolError, \"status report operation\")\n446|\t\t}\n447|\t}\n448|\tif err := terminalbackend.CheckStatusResult(computed, converted); err != nil {\n449|\t\treturn empty, wrapLanded(err)\n450|\t}\n451|\tif err := checkSortedUniqueStatusEvidence(observed.EvidenceIDs); err != nil {\n452|\t\treturn empty, err\n453|\t}\n454|\treturn StatusReport{\n455|\t\tState:           observed.State,\n456|\t\tIdentityMatch:   observed.IdentityMatch,\n457|\t\tWrapperPresent:  observed.WrapperPresent,\n458|\t\tProviderPresent: observed.ProviderPresent,\n459|\t\tAttachable:      observed.Attachable,\n460|\t\tLastOperationID: observed.LastOperationID,\n461|\t\tLastEffect:      observed.LastEffect,\n462|\t\tEvidenceIDs:     append([]string(nil), observed.EvidenceIDs...),\n463|\t}, nil\n464|}\n465|\n466|// statusIdentityMatch compares the reported identity tuple against the\n467|// query: exact-instance lookup requires Session, instance, backend,\n468|// implementation, protocol and generation to all match; Session-scoped\n469|// lookup requires the reported session to match and adopts the rest.\n470|// Reported members are shape-validated first, so a malformed report is\n471|// refused instead of compared.\n472|func statusIdentityMatch(body StatusBody, observed StatusObservation) (bool, error) {\n473|\tif _, err := scalar.ParseUUIDv7(observed.SessionID); err != nil {\n474|\t\treturn false, refuse(CodeProtocolError, \"status report session\")\n475|\t}\n476|\tif _, err := terminalbackend.ParseID(observed.BackendID); err != nil {\n477|\t\treturn false, wrapLanded(err)\n478|\t}\n479|\tif err := checkVersionTuple(observed.BackendID, observed.ImplVersion, observed.ProtoVersion); err != nil {\n480|\t\treturn false, err\n481|\t}\n482|\tif observed.SessionID != body.SessionID {\n483|\t\treturn false, nil\n484|\t}\n485|\tif !body.HasTerminalInstanceID {\n486|\t\treturn true, nil\n487|\t}\n488|\tif _, err := scalar.ParseUUIDv7(observed.InstanceID); err != nil {\n489|\t\treturn false, refuse(CodeProtocolError, \"status report instance\")\n490|\t}\n491|\tif err := checkGenerationBound(observed.Generation); err != nil {\n492|\t\treturn false, refuse(CodeProtocolError, \"status report generation\")\n493|\t}\n494|\treturn observed.InstanceID == body.TerminalInstanceID &&\n495|\t\tobserved.BackendID == body.TerminalBackendID &&\n496|\t\tobserved.ImplVersion == body.ImplementationVersion &&\n497|\t\tobserved.ProtoVersion == body.ProtocolVersion &&\n498|\t\tobserved.Generation == body.BackendGeneration, nil\n499|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
