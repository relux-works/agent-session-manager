{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca19","stream":{"kind":"session","id":"01a0b291-18f0-70a0-900f-0c92cf0433eb"},"sequence":871,"recorded_at":1780531400001737,"record_type":"event","durability":"durable","causation_id":"cb7c4ff2-7892-4304-8de0-3769502303db","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cb7c4ff2-7892-4304-8de0-3769502303db","run_stream":{"kind":"run","id":"cb7c4ff2-7892-4304-8de0-3769502303db"},"task_stream":{"kind":"task","id":"01a0b297-7953-7932-9004-0c1ac2d84cf8"},"task_id":"01a0b297-7953-7932-9004-0c1ac2d84cf8","event":{"kind":"output","task_id":"01a0b297-7953-7932-9004-0c1ac2d84cf8","chunk":"Read text file `internal/terminstance/auth.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"time\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|// AuthorizationKind is the closed §4.C authorization_kind enum.\n12|type AuthorizationKind string\n13|\n14|// AX authorization kinds.\n15|const (\n16|\tAuthorizationCreate     AuthorizationKind = \"create\"\n17|\tAuthorizationControl    AuthorizationKind = \"control\"\n18|\tAuthorizationForceStale AuthorizationKind = \"force_stale\"\n19|\tAuthorizationRestore    AuthorizationKind = \"restore\"\n20|)\n21|\n22|// ParseAuthorizationKind admits exactly the four §4.C kinds.\n23|func ParseAuthorizationKind(value string) (AuthorizationKind, error) {\n24|\tswitch AuthorizationKind(value) {\n25|\tcase AuthorizationCreate, AuthorizationControl,\n26|\t\tAuthorizationForceStale, AuthorizationRestore:\n27|\t\treturn AuthorizationKind(value), nil\n28|\tdefault:\n29|\t\treturn \"\", refuse(CodeProtocolError, \"ax authorization kind\")\n30|\t}\n31|}\n32|\n33|// MaxLeaseEpoch is the §4.C lease_epoch ceiling: uint53[1..9007199254740991].\n34|// It aliases the scalar owner's bound, never a retyped copy.\n35|const MaxLeaseEpoch = scalar.MaxUint53\n36|\n37|// AXAuthorization is the closed §4.C AXAuthorization object: exactly\n38|// lease_id:UUIDv4, lease_epoch:uint53[1..9007199254740991],\n39|// holder_host_id:UUIDv7, authorization_kind, issued_at, expires_at and\n40|// authorization_evidence_id:digest. Expiry is strictly after issue.\n41|type AXAuthorization struct {\n42|\tLeaseID      string\n43|\tLeaseEpoch   uint64\n44|\tHolderHostID string\n45|\tKind         AuthorizationKind\n46|\tIssuedAt     scalar.Timestamp\n47|\tExpiresAt    scalar.Timestamp\n48|\tEvidenceID   string\n49|}\n50|\n51|// axAuthorizationMembers is the exact closed member set, in the order the\n52|// pinned section lists it.\n53|var axAuthorizationMembers = []string{\n54|\t\"lease_id\",\n55|\t\"lease_epoch\",\n56|\t\"holder_host_id\",\n57|\t\"authorization_kind\",\n58|\t\"issued_at\",\n59|\t\"expires_at\",\n60|\t\"authorization_evidence_id\",\n61|}\n62|\n63|// ParseAXAuthorization admits one closed AXAuthorization document. Frame\n64|// admission (UTF-8, lone surrogates, non-object, duplicates, trailing\n65|// data) and every member grammar (UUIDv4/v7, uint53, timestamps, digests)\n66|// are delegated to the landed owners; only the member list itself is\n67|// local, because only this schema can name it. Malformed documents are\n68|// terminal_backend_protocol_error (AX-local parse); only the strict-expiry\n69|// order violation is terminal_backend_unauthorized, mirroring the landed\n70|// ParseAttachAuthorization twin.\n71|func ParseAXAuthorization(raw []byte) (AXAuthorization, error) {\n72|\tmembers, fault := environ.DecodeStrictObject(raw)\n73|\tif fault != nil {\n74|\t\treturn AXAuthorization{}, refuse(CodeProtocolError, \"ax authorization frame\")\n75|\t}\n76|\tauth, err := parseAXAuthorizationObject(members)\n77|\tif err != nil {\n78|\t\treturn AXAuthorization{}, err\n79|\t}\n80|\treturn auth, nil\n81|}\n82|\n83|// parseAXAuthorizationObject admits one already-framed authorization\n84|// member map. ParseAXAuthorization and the nested MutationContext parse\n85|// share it, so the nested authorization is admitted by the same arms,\n86|// never a second implementation.\n87|func parseAXAuthorizationObject(members map[string]json.RawMessage) (AXAuthorization, error) {\n88|\tif len(members) != len(axAuthorizationMembers) {\n89|\t\treturn AXAuthorization{}, refuse(CodeProtocolError, \"ax authorization members\")\n90|\t}\n91|\tfor _, member := range axAuthorizationMembers {\n92|\t\tif _, known := members[member]; !known {\n93|\t\t\treturn AXAuthorization{}, refuse(CodeProtocolError, \"ax authorization members\")\n94|\t\t}\n95|\t}\n96|\tleaseID, ok := rawString(members[\"lease_id\"])\n97|\tif !ok {\n98|\t\treturn AXAuthorization{}, refuse(CodeProtocolError, \"ax authorization lease\")\n99|\t}\n100|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n101|\t\treturn AXAuthorization{}, refuse(CodeProtocolError, \"ax authorization lease\")\n102|\t}\n103|\tleaseEpoch, ok := environ.CheckUint53Bounds(members[\"lease_epoch\"], 1, MaxLeaseEpoch)\n104|\tif !ok {\n105|\t\treturn AXAuthorization{}, refuse(CodeProtocolError, \"ax authorization epoch\")\n106|\t}\n107|\tholderHostID, ok := rawString(members[\"holder_host_id\"])\n108|\tif !ok {\n109|\t\treturn AXAuthorization{}, refuse(CodeProtocolError, \"ax authorization holder\")\n110|\t}\n111|\tif _, err := scalar.ParseUUIDv7(holderHostID); err != nil {\n112|\t\treturn AXAuthorization{}, refuse(CodeProtocolError, \"ax authorization holder\")\n113|\t}\n114|\tkindRaw, ok := rawString(members[\"authorization_kind\"])\n115|\tif !ok {\n116|\t\treturn AXAuthorization{}, refuse(CodeProtocolError, \"ax authorization kind\")\n117|\t}\n118|\tkind, err := ParseAuthorizationKind(kindRaw)\n119|\tif err != nil {\n120|\t\treturn AXAuthorization{}, err\n121|\t}\n122|\tissuedAt, ok := environ.CheckTimestamp(members[\"issued_at\"])\n123|\tif !ok {\n124|\t\treturn AXAuthorization{}, refuse(CodeProtocolError, \"ax authorization timestamp\")\n125|\t}\n126|\texpiresAt, ok := environ.CheckTimestamp(members[\"expires_at\"])\n127|\tif !ok {\n128|\t\treturn AXAuthorization{}, refuse(CodeProtocolError, \"ax authorization timestamp\")\n129|\t}\n130|\tissued, err := issuedAt.Time()\n131|\tif err != nil {\n132|\t\treturn AXAuthorization{}, refuse(CodeProtocolError, \"ax authorization timestamp\")\n133|\t}\n134|\texpires, err := expiresAt.Time()\n135|\tif err != nil {\n136|\t\treturn AXAuthorization{}, refuse(CodeProtocolError, \"ax authorization timestamp\")\n137|\t}\n138|\tif !expires.After(issued) {\n139|\t\treturn AXAuthorization{}, refuse(CodeUnauthorized, \"ax authorization expiry order\")\n140|\t}\n141|\tevidence, ok := environ.CheckDigest(members[\"authorization_evidence_id\"])\n142|\tif !ok {\n143|\t\treturn AXAuthorization{}, refuse(CodeProtocolError, \"ax authorization evidence\")\n144|\t}\n145|\treturn AXAuthorization{\n146|\t\tLeaseID:      leaseID,\n147|\t\tLeaseEpoch:   leaseEpoch,\n148|\t\tHolderHostID: holderHostID,\n149|\t\tKind:         kind,\n150|\t\tIssuedAt:     issuedAt,\n151|\t\tExpiresAt:    expiresAt,\n152|\t\tEvidenceID:   evidence.String(),\n153|\t}, nil\n154|}\n155|\n156|// rawString reads a JSON string member. environ owns the frame and the\n157|// typed members; a bare string read is encoding/json's grammar, shared\n158|// by every nested shape in this package.\n159|func rawString(raw json.RawMessage) (string, bool) {\n160|\tvar value string\n161|\tif err := json.Unmarshal(raw, &value); err != nil {\n162|\t\treturn \"\", false\n163|\t}\n164|\treturn value, true\n165|}\n166|\n167|// LeaseView is the current winning AX lease as observed by the caller:\n168|// the (lease_id, lease_epoch) tuple the authorization must equal at\n169|// every side effect. Callers derive it from\n170|// fencing.Observation.Winner; the epoch-1 lease carries no checkpoint\n171|// and this view carries none either, so the vacuous checkpoint keying\n172|// the story's predecessor leaf removed cannot reappear here.\n173|type LeaseView struct {\n174|\tLeaseID string\n175|\tEpoch   uint64\n176|}\n177|\n178|// CheckAuthorization enforces the §4.C authorization rule at one check\n179|// point: the authorization names the required kind, is unexpired at now,\n180|// and its lease tuple equals the current winning AX lease. Every\n181|// violation is terminal_backend_unauthorized: a malformed document never\n182|// reaches here (ParseAXAuthorization owns shape), so anything refused\n183|// here is a binding failure, not a parse failure. Lease identity and\n184|// lease epoch are separate arms with separate details so a mutant\n185|// dropping either comparison is killed by its own drift test.\n186|func CheckAuthorization(auth AXAuthorization, wantKind AuthorizationKind, lease LeaseView, now time.Time) error {\n187|\tif auth.Kind != wantKind {\n188|\t\treturn refuse(CodeUnauthorized, \"ax authorization kind binding\")\n189|\t}\n190|\texpires, err := auth.ExpiresAt.Time()\n191|\tif err != nil {\n192|\t\treturn refuse(CodeProtocolError, \"ax authorization timestamp\")\n193|\t}\n194|\tif !now.Before(expires) {\n195|\t\treturn refuse(CodeUnauthorized, \"ax authorization expiry\")\n196|\t}\n197|\tif auth.LeaseID != lease.LeaseID {\n198|\t\treturn refuse(CodeUnauthorized, \"ax authorization lease identity\")\n199|\t}\n200|\tif auth.LeaseEpoch != lease.Epoch {\n201|\t\treturn refuse(CodeUnauthorized, \"ax authorization lease epoch\")\n202|\t}\n203|\treturn nil\n204|}","final_result":true}}}
