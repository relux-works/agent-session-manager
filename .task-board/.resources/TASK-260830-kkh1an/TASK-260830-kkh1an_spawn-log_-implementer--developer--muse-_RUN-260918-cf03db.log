{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7a7","stream":{"kind":"session","id":"01a0b291-18f0-70a0-900f-0c92cf0433eb"},"sequence":558,"recorded_at":1780531400001111,"record_type":"event","durability":"durable","causation_id":"cb7c4ff2-7892-4304-8de0-3769502303db","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cb7c4ff2-7892-4304-8de0-3769502303db","run_stream":{"kind":"run","id":"cb7c4ff2-7892-4304-8de0-3769502303db"},"task_stream":{"kind":"task","id":"01a0b292-9d20-73c3-85c5-c60a9aa03e2d"},"task_id":"01a0b292-9d20-73c3-85c5-c60a9aa03e2d","event":{"kind":"output","task_id":"01a0b292-9d20-73c3-85c5-c60a9aa03e2d","chunk":"Read text file `internal/terminstance/store.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"errors\"\n7|\t\"fmt\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"sort\"\n11|\t\"strings\"\n12|\t\"sync\"\n13|\t\"time\"\n14|\n15|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n16|)\n17|\n18|// Receipt is one durable idempotency record: the canonical key, the\n19|// operation it was bound for, and the operation ID it was bound with.\n20|// The shape extends the landed terminalbackend.Receipt triple\n21|// (Key/Operation/ResultID); ResultID is the MutationContext operation\n22|// ID, so an identical retry (same key, same operation, same operation\n23|// ID) replays and a changed operation in the window is\n24|// idempotency_mismatch.\n25|type Receipt struct {\n26|\tKey         string\n27|\tOperation   terminalbackend.Operation\n28|\tOperationID string\n29|}\n30|\n31|// StoreHooks arms the crash seams of the receipt store. AfterCommit runs\n32|// after the no-replace link lands and before the directory sync, exactly\n33|// like the predecessor leaf's AfterInstall: a hook error propagates to\n34|// the caller but the receipt stands, so the identical retry replays it.\n35|type StoreHooks struct {\n36|\tAfterCommit func(path string) error\n37|}\n38|\n39|// ReceiptStore is the durable idempotency receipt table backing the §4.C\n40|// recovery rules: persist the receipt before the first side effect,\n41|// identical retry replays it, a changed operation in the window is\n42|// idempotency_mismatch, and uncertainty requires status. Each receipt is\n43|// one file committed by temp-stage, fsync, no-replace link and directory\n44|// sync; readers see absence or the complete receipt, never a torn\n45|// prefix. Completion (the recorded result) is a second no-replace file,\n46|// because updating the receipt in place would break no-replace: a\n47|// pending receipt without its completion proves an interrupted attempt,\n48|// never a result, and the engine refuses its retry until status\n49|// recovers the observation.\n50|type ReceiptStore struct {\n51|\tmutex sync.Mutex\n52|\tbase  string\n53|\thooks *StoreHooks\n54|}\n55|\n56|// OpenReceiptStore opens (creating) the receipt store rooted at base.\n57|func OpenReceiptStore(base string) (*ReceiptStore, error) {\n58|\tif err := os.MkdirAll(base, 0o755); err != nil {\n59|\t\treturn nil, fmt.Errorf(\"create receipt store: %w\", err)\n60|\t}\n61|\tif err := os.MkdirAll(filepath.Join(base, \"pending\"), 0o755); err != nil {\n62|\t\treturn nil, fmt.Errorf(\"create receipt pending directory: %w\", err)\n63|\t}\n64|\tif err := os.MkdirAll(filepath.Join(base, \"done\"), 0o755); err != nil {\n65|\t\treturn nil, fmt.Errorf(\"create receipt done directory: %w\", err)\n66|\t}\n67|\treturn &ReceiptStore{base: base}, nil\n68|}\n69|\n70|// WithHooks arms the crash seams. A nil hooks value disarms them.\n71|func (store *ReceiptStore) WithHooks(hooks *StoreHooks) {\n72|\tstore.mutex.Lock()\n73|\tdefer store.mutex.Unlock()\n74|\tstore.hooks = hooks\n75|}\n76|\n77|// receiptName maps a key to its file name: the hex sha256 of the key.\n78|// The key itself is embedded in the file content, so the name is a\n79|// lookup optimization the content re-validates, never trusted identity.\n80|func receiptName(key string) string {\n81|\tsum := sha256.Sum256([]byte(key))\n82|\treturn hex.EncodeToString(sum[:])\n83|}\n84|\n85|// encodeReceipt renders one receipt as the landed per-receipt triple:\n86|// key, operation and operation ID on three lines. The encoding matches\n87|// terminalbackend.Ledger.Export line for line, so Export below produces\n88|// bytes ImportLedger admits.\n89|func encodeReceipt(receipt Receipt) []byte {\n90|\treturn []byte(receipt.Key + \"\\n\" + string(receipt.Operation) + \"\\n\" + receipt.OperationID + \"\\n\")\n91|}\n92|\n93|// decodeReceipt parses one receipt file. A torn or malformed file is an\n94|// integrity failure, never absence and never a partial receipt.\n95|func decodeReceipt(raw []byte) (Receipt, error) {\n96|\tlines := strings.Split(string(raw), \"\\n\")\n97|\tif len(lines) != 4 || lines[3] != \"\" || lines[0] == \"\" || lines[2] == \"\" {\n98|\t\treturn Receipt{}, refuse(CodeIntegrityFailure, \"idempotency receipt image\")\n99|\t}\n100|\toperation, err := terminalbackend.ParseOperation(lines[1])\n101|\tif err != nil {\n102|\t\treturn Receipt{}, refuse(CodeIntegrityFailure, \"idempotency receipt image\")\n103|\t}\n104|\treturn Receipt{Key: lines[0], Operation: operation, OperationID: lines[2]}, nil\n105|}\n106|\n107|// Bind records the receipt for a key before the first side effect. A key\n108|// bound for the first time is durably stored and reported fresh. A key\n109|// bound again with the identical operation and operation ID replays the\n110|// stored receipt. A key bound again with a different operation or\n111|// operation ID is idempotency_mismatch: only a successful status read\n112|// proves absence, never a second binding.\n113|func (store *ReceiptStore) Bind(key string, operation terminalbackend.Operation, operationID string) (Receipt, bool, error) {\n114|\tif store == nil {\n115|\t\treturn Receipt{}, false, refuse(CodeProtocolError, \"idempotency store unavailable\")\n116|\t}\n117|\tif key == \"\" || operationID == \"\" {\n118|\t\treturn Receipt{}, false, refuse(CodeProtocolError, \"idempotency key shape\")\n119|\t}\n120|\tif _, err := terminalbackend.ParseOperation(string(operation)); err != nil {\n121|\t\treturn Receipt{}, false, wrapLanded(err)\n122|\t}\n123|\tdir := filepath.Join(store.base, \"pending\")\n124|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n125|\t\treturn Receipt{}, false, fmt.Errorf(\"create receipt pending directory: %w\", err)\n126|\t}\n127|\tsweepStaging(dir)\n128|\ttarget := filepath.Join(dir, receiptName(key))\n129|\treceipt := Receipt{Key: key, Operation: operation, OperationID: operationID}\n130|\tstaged, err := os.CreateTemp(dir, \"receipt-*.tmp\")\n131|\tif err != nil {\n132|\t\treturn Receipt{}, false, fmt.Errorf(\"stage idempotency receipt: %w\", err)\n133|\t}\n134|\tstagedPath := staged.Name()\n135|\tdefer func() { _ = os.Remove(stagedPath) }()\n136|\tif err := staged.Chmod(0o600); err != nil {\n137|\t\t_ = staged.Close()\n138|\t\treturn Receipt{}, false, fmt.Errorf(\"protect idempotency receipt: %w\", err)\n139|\t}\n140|\tif _, err := staged.Write(encodeReceipt(receipt)); err != nil {\n141|\t\t_ = staged.Close()\n142|\t\treturn Receipt{}, false, fmt.Errorf(\"write idempotency receipt: %w\", err)\n143|\t}\n144|\tif err := staged.Sync(); err != nil {\n145|\t\t_ = staged.Close()\n146|\t\treturn Receipt{}, false, fmt.Errorf(\"sync idempotency receipt: %w\", err)\n147|\t}\n148|\tif err := staged.Close(); err != nil {\n149|\t\treturn Receipt{}, false, fmt.Errorf(\"close idempotency receipt: %w\", err)\n150|\t}\n151|\tif err := os.Link(stagedPath, target); err != nil {\n152|\t\tif errors.Is(err, os.ErrExist) {\n153|\t\t\twinner, found, readErr := store.Lookup(key)\n154|\t\t\tif readErr != nil {\n155|\t\t\t\treturn Receipt{}, false, readErr\n156|\t\t\t}\n157|\t\t\tif !found {\n158|\t\t\t\treturn Receipt{}, false, refuse(CodeIntegrityFailure, \"idempotency receipt image\")\n159|\t\t\t}\n160|\t\t\tif winner.Operation != operation || winner.OperationID != operationID {\n161|\t\t\t\treturn Receipt{}, false, refuse(CodeIdempotencyMismatch, \"idempotency key conflict\")\n162|\t\t\t}\n163|\t\t\treturn winner, true, nil\n164|\t\t}\n165|\t\treturn Receipt{}, false, fmt.Errorf(\"install idempotency receipt: %w\", err)\n166|\t}\n167|\t_ = os.Remove(stagedPath)\n168|\tstore.mutex.Lock()\n169|\thooks := store.hooks\n170|\tstore.mutex.Unlock()\n171|\tif hooks != nil && hooks.AfterCommit != nil {\n172|\t\tif err := hooks.AfterCommit(target); err != nil {\n173|\t\t\treturn Receipt{}, false, err\n174|\t\t}\n175|\t}\n176|\tif err := syncDirectory(dir); err != nil {\n177|\t\treturn Receipt{}, false, err\n178|\t}\n179|\treturn receipt, false, nil\n180|}\n181|\n182|// Lookup returns the stored receipt for a key. Absence of a receipt\n183|// proves nothing and reports false; a torn receipt file is an integrity\n184|// failure, never absence.\n185|func (store *ReceiptStore) Lookup(key string) (Receipt, bool, error) {\n186|\tif store == nil || key == \"\" {\n187|\t\treturn Receipt{}, false, nil\n188|\t}\n189|\ttarget := filepath.Join(store.base, \"pending\", receiptName(key))\n190|\traw, err := os.ReadFile(target)\n191|\tif err != nil {\n192|\t\tif errors.Is(err, os.ErrNotExist) {\n193|\t\t\treturn Receipt{}, false, nil\n194|\t\t}\n195|\t\treturn Receipt{}, false, fmt.Errorf(\"read idempotency receipt: %w\", err)\n196|\t}\n197|\treceipt, err := decodeReceipt(raw)\n198|\tif err != nil {\n199|\t\treturn Receipt{}, false, err\n200|\t}\n201|\tif receipt.Key != key {\n202|\t\treturn Receipt{}, false, refuse(CodeIntegrityFailure, \"idempotency receipt image\")\n203|\t}\n204|\treturn receipt, true, nil\n205|}\n206|\n207|// Complete records the result of a bound key. The result bytes commit\n208|// through the same no-replace link as the receipt: a second completion\n209|// with identical bytes replays, a second completion with different bytes\n210|// is an integrity failure, because one attempt has exactly one result.\n211|// Completing an unbound key is a failed local precondition.\n212|func (store *ReceiptStore) Complete(key string, result []byte) error {\n213|\tif store == nil {\n214|\t\treturn refuse(CodeProtocolError, \"idempotency store unavailable\")\n215|\t}\n216|\tif _, found, err := store.Lookup(key); err != nil {\n217|\t\treturn err\n218|\t} else if !found {\n219|\t\treturn refuse(CodePreconditionFailed, \"idempotency completion without receipt\")\n220|\t}\n221|\tdir := filepath.Join(store.base, \"done\")\n222|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n223|\t\treturn fmt.Errorf(\"create receipt done directory: %w\", err)\n224|\t}\n225|\tsweepStaging(dir)\n226|\ttarget := filepath.Join(dir, receiptName(key))\n227|\tstaged, err := os.CreateTemp(dir, \"result-*.tmp\")\n228|\tif err != nil {\n229|\t\treturn fmt.Errorf(\"stage idempotency result: %w\", err)\n230|\t}\n231|\tstagedPath := staged.Name()\n232|\tdefer func() { _ = os.Remove(stagedPath) }()\n233|\tif err := staged.Chmod(0o600); err != nil {\n234|\t\t_ = staged.Close()\n235|\t\treturn fmt.Errorf(\"protect idempotency result: %w\", err)\n236|\t}\n237|\tif _, err := staged.Write(result); err != nil {\n238|\t\t_ = staged.Close()\n239|\t\treturn fmt.Errorf(\"write idempotency result: %w\", err)\n240|\t}\n241|\tif err := staged.Sync(); err != nil {\n242|\t\t_ = staged.Close()\n243|\t\treturn fmt.Errorf(\"sync idempotency result: %w\", err)\n244|\t}\n245|\tif err := staged.Close(); err != nil {\n246|\t\treturn fmt.Errorf(\"close idempotency result: %w\", err)\n247|\t}\n248|\tif err := os.Link(stagedPath, target); err != nil {\n249|\t\tif errors.Is(err, os.ErrExist) {\n250|\t\t\twinner, readErr := os.ReadFile(target)\n251|\t\t\tif readErr != nil {\n252|\t\t\t\treturn fmt.Errorf(\"read idempotency result: %w\", readErr)\n253|\t\t\t}\n254|\t\t\tif string(winner) != string(result) {\n255|\t\t\t\treturn refuse(CodeIntegrityFailure, \"idempotency result conflict\")\n256|\t\t\t}\n257|\t\t\treturn nil\n258|\t\t}\n259|\t\treturn fmt.Errorf(\"install idempotency result: %w\", err)\n260|\t}\n261|\t_ = os.Remove(stagedPath)\n262|\tif err := syncDirectory(dir); err != nil {\n263|\t\treturn err\n264|\t}\n265|\treturn nil\n266|}\n267|\n268|// Completed returns the recorded result for a key. A bound key without\n269|// its completion reports found false: the attempt was interrupted and\n270|// only status recovers the observation, never a second binding.\n271|func (store *ReceiptStore) Completed(key string) ([]byte, bool, error) {\n272|\tif store == nil || key == \"\" {\n273|\t\treturn nil, false, nil\n274|\t}\n275|\ttarget := filepath.Join(store.base, \"done\", receiptName(key))\n276|\traw, err := os.ReadFile(target)\n277|\tif err != nil {\n278|\t\tif errors.Is(err, os.ErrNotExist) {\n279|\t\t\treturn nil, false, nil\n280|\t\t}\n281|\t\treturn nil, false, fmt.Errorf(\"read idempotency result: %w\", err)\n282|\t}\n283|\treturn raw, true, nil\n284|}\n285|\n286|// Export renders the pending table as stable bytes: receipts sorted by\n287|// key, one triple per receipt. The bytes equal what a\n288|// terminalbackend.Ledger holding the same receipts exports, so they feed\n289|// ImportLedger directly; the agreement is pinned by\n290|// TestStoreExportAgreesWithLedger. Staging garbage is never exported.\n291|func (store *ReceiptStore) Export() ([]byte, error) {\n292|\tif store == nil {\n293|\t\treturn nil, refuse(CodeProtocolError, \"idempotency store unavailable\")\n294|\t}\n295|\tdir := filepath.Join(store.base, \"pending\")\n296|\tentries, err := os.ReadDir(dir)\n297|\tif err != nil {\n298|\t\tif errors.Is(err, os.ErrNotExist) {\n299|\t\t\treturn nil, nil\n300|\t\t}\n301|\t\treturn nil, fmt.Errorf(\"read receipt table: %w\", err)\n302|\t}\n303|\treceipts := make([]Receipt, 0, len(entries))\n304|\tfor _, entry := range entries {\n305|\t\tif entry.IsDir() || !isReceiptName(entry.Name()) {\n306|\t\t\tcontinue\n307|\t\t}\n308|\t\traw, err := os.ReadFile(filepath.Join(dir, entry.Name()))\n309|\t\tif err != nil {\n310|\t\t\treturn nil, fmt.Errorf(\"read idempotency receipt: %w\", err)\n311|\t\t}\n312|\t\treceipt, err := decodeReceipt(raw)\n313|\t\tif err != nil {\n314|\t\t\treturn nil, err\n315|\t\t}\n316|\t\treceipts = append(receipts, receipt)\n317|\t}\n318|\tsort.Slice(receipts, func(i, j int) bool { return receipts[i].Key < receipts[j].Key })\n319|\tvar image strings.Builder\n320|\tfor _, receipt := range receipts {\n321|\t\timage.WriteString(receipt.Key + \"\\n\" + string(receipt.Operation) + \"\\n\" + receipt.OperationID + \"\\n\")\n322|\t}\n323|\treturn []byte(image.String()), nil\n324|}\n325|\n326|// isReceiptName reports whether a directory entry is a committed receipt\n327|// file: exactly 64 lowercase hex characters. Staging files\n328|// (receipt-*.tmp, result-*.tmp) and anything else are ignored.\n329|func isReceiptName(name string) bool {\n330|\tif len(name) != 64 {\n331|\t\treturn false\n332|\t}\n333|\tfor i := 0; i < len(name); i++ {\n334|\t\tdigit := name[i]\n335|\t\tif (digit < '0' || digit > '9') && (digit < 'a' || digit > 'f') {\n336|\t\t\treturn false\n337|\t\t}\n338|\t}\n339|\treturn true\n340|}\n341|\n342|// stagingSweepAge is the minimum age of a staging file the sweep may\n343|// remove. A concurrent Bind stages its own *.tmp between our stage and\n344|// our link; sweeping only files older than this bound keeps a live\n345|// stage alive, while crash garbage (whose mtime stops at the crash)\n346|// ages out on a later call. Readers and Export ignore staging names,\n347|// so a young leftover is invisible until it ages.\n348|const stagingSweepAge = time.Minute\n349|\n350|// sweepStaging removes staging garbage a pre-commit crash left behind.\n351|// Staging files carry the *.tmp suffix; committed receipts never do, so\n352|// the sweep cannot remove a commit. Only files older than\n353|// stagingSweepAge are removed, so a concurrent live stage is never\n354|// deleted: without the age gate a racing Bind would lose its staged\n355|// file and fail its no-replace link with a spurious install error.\n356|func sweepStaging(dir string) {\n357|\tentries, err := os.ReadDir(dir)\n358|\tif err != nil {\n359|\t\treturn\n360|\t}\n361|\tnow := time.Now()\n362|\tfor _, entry := range entries {\n363|\t\tif entry.IsDir() || !strings.HasSuffix(entry.Name(), \".tmp\") {\n364|\t\t\tcontinue\n365|\t\t}\n366|\t\tinfo, err := entry.Info()\n367|\t\tif err != nil {\n368|\t\t\tcontinue\n369|\t\t}\n370|\t\tif now.Sub(info.ModTime()) < stagingSweepAge {\n371|\t\t\tcontinue\n372|\t\t}\n373|\t\t_ = os.Remove(filepath.Join(dir, entry.Name()))\n374|\t}\n375|}\n376|\n377|// syncDirectory fsyncs a directory so committed links survive a crash.\n378|func syncDirectory(dir string) error {\n379|\thandle, err := os.Open(dir)\n380|\tif err != nil {\n381|\t\treturn fmt.Errorf(\"open receipt directory: %w\", err)\n382|\t}\n383|\tdefer func() { _ = handle.Close() }()\n384|\tif err := handle.Sync(); err != nil {\n385|\t\treturn fmt.Errorf(\"sync receipt directory: %w\", err)\n386|\t}\n387|\treturn nil\n388|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7a9","stream":{"kind":"session","id":"01a0b291-18f0-70a0-900f-0c92cf0433eb"},"sequence":559,"recorded_at":1780531400001113,"record_type":"event","durability":"durable","causation_id":"cb7c4ff2-7892-4304-8de0-3769502303db","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cb7c4ff2-7892-4304-8de0-3769502303db","run_stream":{"kind":"run","id":"cb7c4ff2-7892-4304-8de0-3769502303db"},"task_stream":{"kind":"task","id":"01a0b292-9d20-73c3-85c5-c60a9aa03e2d"},"task_id":"01a0b292-9d20-73c3-85c5-c60a9aa03e2d","event":{"kind":"completed","task_id":"01a0b292-9d20-73c3-85c5-c60a9aa03e2d"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7ab","stream":{"kind":"session","id":"01a0b291-18f0-70a0-900f-0c92cf0433eb"},"sequence":560,"recorded_at":1780531400001115,"record_type":"event","durability":"durable","causation_id":"cb7c4ff2-7892-4304-8de0-3769502303db","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"cb7c4ff2-7892-4304-8de0-3769502303db","run_stream":{"kind":"run","id":"cb7c4ff2-7892-4304-8de0-3769502303db"},"call_id":"call_01a0b292976976989aacac4defcc3c3f","text":"Read text file `internal/terminstance/fencing.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n5|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n6|)\n7|\n8|// ObserveFencing projects one AX fencing observation onto the Terminal\n9|// Instance lifecycle. It is the ONLY entry that produces stale_fenced:\n10|// no backend operation targets that state (the landed CheckTransition\n11|// proves it and the engine below never synthesizes it), only AX fencing\n12|// observation does.\n13|//\n14|// The verdict is read entirely from the landed fencing projection: the\n15|// presented local token is authorized against the observation through\n16|// fencing.Authorize with the restore operation, and a ParkStaleOwner\n17|// park — the older-epoch arm and the same-epoch lease-mismatch arm\n18|// alike — moves the local observation to stale_fenced. The operation\n19|// must be launch-class (restore or activation): the input, mutation\n20|// and checkpoint entries refuse a stale token instead of parking it,\n21|// which would surface as an error and never fence. Restore is chosen\n22|// over activation because it gates terminal restore, this story's\n23|// domain; the two are equivalent on the stale arms. Every other\n24|// outcome leaves the state untouched: an\n25|// authorized token reports no transition, and any non-stale refusal or\n26|// park (remote owner, unverified, ambiguous, no winner) surfaces its own\n27|// error with no transition, because only proven staleness fences. A nil\n28|// error with transitioned false is the authorized case.\n29|//\n30|// This function performs no lease comparison of its own: the tuple,\n31|// grant, expiry and direction arms all run inside the landed Authorize,\n32|// so no second fencing model exists here. It reads Winner.LeaseID and\n33|// Winner.Epoch only through Authorize's verdict, never Winner.Checkpoint:\n34|// lease records are immutable content-addressed blobs whose checkpoint\n35|// member is null for every epoch-1 lease, so keying on it would be\n36|// vacuous for every session that never changed hands.\n37|func ObserveFencing(current terminalbackend.InstanceState, presented fencing.PresentedToken, observation fencing.Observation) (terminalbackend.InstanceState, bool, error) {\n38|\tif _, err := terminalbackend.ParseInstanceState(string(current)); err != nil {\n39|\t\treturn current, false, wrapLanded(err)\n40|\t}\n41|\t_, authErr := fencing.Authorize(fencing.OperationRestore, presented, observation)\n42|\tif authErr == nil {\n43|\t\treturn current, false, nil\n44|\t}\n45|\tif reason, _, parked := fencing.ParkDetails(authErr); parked && reason == fencing.ParkStaleOwner {\n46|\t\treturn terminalbackend.StateStaleFenced, true, nil\n47|\t}\n48|\treturn current, false, authErr\n49|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7ad","stream":{"kind":"session","id":"01a0b291-18f0-70a0-900f-0c92cf0433eb"},"sequence":561,"recorded_at":1780531400001117,"record_type":"event","durability":"durable","causation_id":"cb7c4ff2-7892-4304-8de0-3769502303db","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"cb7c4ff2-7892-4304-8de0-3769502303db","run_stream":{"kind":"run","id":"cb7c4ff2-7892-4304-8de0-3769502303db"},"call_id":"call_01a0b292996b734aa19794c1c3ce5e92","text":"Read text file `internal/terminstance/store.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"errors\"\n7|\t\"fmt\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"sort\"\n11|\t\"strings\"\n12|\t\"sync\"\n13|\t\"time\"\n14|\n15|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n16|)\n17|\n18|// Receipt is one durable idempotency record: the canonical key, the\n19|// operation it was bound for, and the operation ID it was bound with.\n20|// The shape extends the landed terminalbackend.Receipt triple\n21|// (Key/Operation/ResultID); ResultID is the MutationContext operation\n22|// ID, so an identical retry (same key, same operation, same operation\n23|// ID) replays and a changed operation in the window is\n24|// idempotency_mismatch.\n25|type Receipt struct {\n26|\tKey         string\n27|\tOperation   terminalbackend.Operation\n28|\tOperationID string\n29|}\n30|\n31|// StoreHooks arms the crash seams of the receipt store. AfterCommit runs\n32|// after the no-replace link lands and before the directory sync, exactly\n33|// like the predecessor leaf's AfterInstall: a hook error propagates to\n34|// the caller but the receipt stands, so the identical retry replays it.\n35|type StoreHooks struct {\n36|\tAfterCommit func(path string) error\n37|}\n38|\n39|// ReceiptStore is the durable idempotency receipt table backing the §4.C\n40|// recovery rules: persist the receipt before the first side effect,\n41|// identical retry replays it, a changed operation in the window is\n42|// idempotency_mismatch, and uncertainty requires status. Each receipt is\n43|// one file committed by temp-stage, fsync, no-replace link and directory\n44|// sync; readers see absence or the complete receipt, never a torn\n45|// prefix. Completion (the recorded result) is a second no-replace file,\n46|// because updating the receipt in place would break no-replace: a\n47|// pending receipt without its completion proves an interrupted attempt,\n48|// never a result, and the engine refuses its retry until status\n49|// recovers the observation.\n50|type ReceiptStore struct {\n51|\tmutex sync.Mutex\n52|\tbase  string\n53|\thooks *StoreHooks\n54|}\n55|\n56|// OpenReceiptStore opens (creating) the receipt store rooted at base.\n57|func OpenReceiptStore(base string) (*ReceiptStore, error) {\n58|\tif err := os.MkdirAll(base, 0o755); err != nil {\n59|\t\treturn nil, fmt.Errorf(\"create receipt store: %w\", err)\n60|\t}\n61|\tif err := os.MkdirAll(filepath.Join(base, \"pending\"), 0o755); err != nil {\n62|\t\treturn nil, fmt.Errorf(\"create receipt pending directory: %w\", err)\n63|\t}\n64|\tif err := os.MkdirAll(filepath.Join(base, \"done\"), 0o755); err != nil {\n65|\t\treturn nil, fmt.Errorf(\"create receipt done directory: %w\", err)\n66|\t}\n67|\treturn &ReceiptStore{base: base}, nil\n68|}\n69|\n70|// WithHooks arms the crash seams. A nil hooks value disarms them.\n71|func (store *ReceiptStore) WithHooks(hooks *StoreHooks) {\n72|\tstore.mutex.Lock()\n73|\tdefer store.mutex.Unlock()\n74|\tstore.hooks = hooks\n75|}\n76|\n77|// receiptName maps a key to its file name: the hex sha256 of the key.\n78|// The key itself is embedded in the file content, so the name is a\n79|// lookup optimization the content re-validates, never trusted identity.\n80|func receiptName(key string) string {\n81|\tsum := sha256.Sum256([]byte(key))\n82|\treturn hex.EncodeToString(sum[:])\n83|}\n84|\n85|// encodeReceipt renders one receipt as the landed per-receipt triple:\n86|// key, operation and operation ID on three lines. The encoding matches\n87|// terminalbackend.Ledger.Export line for line, so Export below produces\n88|// bytes ImportLedger admits.\n89|func encodeReceipt(receipt Receipt) []byte {\n90|\treturn []byte(receipt.Key + \"\\n\" + string(receipt.Operation) + \"\\n\" + receipt.OperationID + \"\\n\")\n91|}\n92|\n93|// decodeReceipt parses one receipt file. A torn or malformed file is an\n94|// integrity failure, never absence and never a partial receipt.\n95|func decodeReceipt(raw []byte) (Receipt, error) {\n96|\tlines := strings.Split(string(raw), \"\\n\")\n97|\tif len(lines) != 4 || lines[3] != \"\" || lines[0] == \"\" || lines[2] == \"\" {\n98|\t\treturn Receipt{}, refuse(CodeIntegrityFailure, \"idempotency receipt image\")\n99|\t}\n100|\toperation, err := terminalbackend.ParseOperation(lines[1])\n101|\tif err != nil {\n102|\t\treturn Receipt{}, refuse(CodeIntegrityFailure, \"idempotency receipt image\")\n103|\t}\n104|\treturn Receipt{Key: lines[0], Operation: operation, OperationID: lines[2]}, nil\n105|}\n106|\n107|// Bind records the receipt for a key before the first side effect. A key\n108|// bound for the first time is durably stored and reported fresh. A key\n109|// bound again with the identical operation and operation ID replays the\n110|// stored receipt. A key bound again with a different operation or\n111|// operation ID is idempotency_mismatch: only a successful status read\n112|// proves absence, never a second binding.\n113|func (store *ReceiptStore) Bind(key string, operation terminalbackend.Operation, operationID string) (Receipt, bool, error) {\n114|\tif store == nil {\n115|\t\treturn Receipt{}, false, refuse(CodeProtocolError, \"idempotency store unavailable\")\n116|\t}\n117|\tif key == \"\" || operationID == \"\" {\n118|\t\treturn Receipt{}, false, refuse(CodeProtocolError, \"idempotency key shape\")\n119|\t}\n120|\tif _, err := terminalbackend.ParseOperation(string(operation)); err != nil {\n121|\t\treturn Receipt{}, false, wrapLanded(err)\n122|\t}\n123|\tdir := filepath.Join(store.base, \"pending\")\n124|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n125|\t\treturn Receipt{}, false, fmt.Errorf(\"create receipt pending directory: %w\", err)\n126|\t}\n127|\tsweepStaging(dir)\n128|\ttarget := filepath.Join(dir, receiptName(key))\n129|\treceipt := Receipt{Key: key, Operation: operation, OperationID: operationID}\n130|\tstaged, err := os.CreateTemp(dir, \"receipt-*.tmp\")\n131|\tif err != nil {\n132|\t\treturn Receipt{}, false, fmt.Errorf(\"stage idempotency receipt: %w\", err)\n133|\t}\n134|\tstagedPath := staged.Name()\n135|\tdefer func() { _ = os.Remove(stagedPath) }()\n136|\tif err := staged.Chmod(0o600); err != nil {\n137|\t\t_ = staged.Close()\n138|\t\treturn Receipt{}, false, fmt.Errorf(\"protect idempotency receipt: %w\", err)\n139|\t}\n140|\tif _, err := staged.Write(encodeReceipt(receipt)); err != nil {\n141|\t\t_ = staged.Close()\n142|\t\treturn Receipt{}, false, fmt.Errorf(\"write idempotency receipt: %w\", err)\n143|\t}\n144|\tif err := staged.Sync(); err != nil {\n145|\t\t_ = staged.Close()\n146|\t\treturn Receipt{}, false, fmt.Errorf(\"sync idempotency receipt: %w\", err)\n147|\t}\n148|\tif err := staged.Close(); err != nil {\n149|\t\treturn Receipt{}, false, fmt.Errorf(\"close idempotency receipt: %w\", err)\n150|\t}\n151|\tif err := os.Link(stagedPath, target); err != nil {\n152|\t\tif errors.Is(err, os.ErrExist) {\n153|\t\t\twinner, found, readErr := store.Lookup(key)\n154|\t\t\tif readErr != nil {\n155|\t\t\t\treturn Receipt{}, false, readErr\n156|\t\t\t}\n157|\t\t\tif !found {\n158|\t\t\t\treturn Receipt{}, false, refuse(CodeIntegrityFailure, \"idempotency receipt image\")\n159|\t\t\t}\n160|\t\t\tif winner.Operation != operation || winner.OperationID != operationID {\n161|\t\t\t\treturn Receipt{}, false, refuse(CodeIdempotencyMismatch, \"idempotency key conflict\")\n162|\t\t\t}\n163|\t\t\treturn winner, true, nil\n164|\t\t}\n165|\t\treturn Receipt{}, false, fmt.Errorf(\"install idempotency receipt: %w\", err)\n166|\t}\n167|\t_ = os.Remove(stagedPath)\n168|\tstore.mutex.Lock()\n169|\thooks := store.hooks\n170|\tstore.mutex.Unlock()\n171|\tif hooks != nil && hooks.AfterCommit != nil {\n172|\t\tif err := hooks.AfterCommit(target); err != nil {\n173|\t\t\treturn Receipt{}, false, err\n174|\t\t}\n175|\t}\n176|\tif err := syncDirectory(dir); err != nil {\n177|\t\treturn Receipt{}, false, err\n178|\t}\n179|\treturn receipt, false, nil\n180|}\n181|\n182|// Lookup returns the stored receipt for a key. Absence of a receipt\n183|// proves nothing and reports false; a torn receipt file is an integrity\n184|// failure, never absence.\n185|func (store *ReceiptStore) Lookup(key string) (Receipt, bool, error) {\n186|\tif store == nil || key == \"\" {\n187|\t\treturn Receipt{}, false, nil\n188|\t}\n189|\ttarget := filepath.Join(store.base, \"pending\", receiptName(key))\n190|\traw, err := os.ReadFile(target)\n191|\tif err != nil {\n192|\t\tif errors.Is(err, os.ErrNotExist) {\n193|\t\t\treturn Receipt{}, false, nil\n194|\t\t}\n195|\t\treturn Receipt{}, false, fmt.Errorf(\"read idempotency receipt: %w\", err)\n196|\t}\n197|\treceipt, err := decodeReceipt(raw)\n198|\tif err != nil {\n199|\t\treturn Receipt{}, false, err\n200|\t}\n201|\tif receipt.Key != key {\n202|\t\treturn Receipt{}, false, refuse(CodeIntegrityFailure, \"idempotency receipt image\")\n203|\t}\n204|\treturn receipt, true, nil\n205|}\n206|\n207|// Complete records the result of a bound key. The result bytes commit\n208|// through the same no-replace link as the receipt: a second completion\n209|// with identical bytes replays, a second completion with different bytes\n210|// is an integrity failure, because one attempt has exactly one result.\n211|// Completing an unbound key is a failed local precondition.\n212|func (store *ReceiptStore) Complete(key string, result []byte) error {\n213|\tif store == nil {\n214|\t\treturn refuse(CodeProtocolError, \"idempotency store unavailable\")\n215|\t}\n216|\tif _, found, err := store.Lookup(key); err != nil {\n217|\t\treturn err\n218|\t} else if !found {\n219|\t\treturn refuse(CodePreconditionFailed, \"idempotency completion without receipt\")\n220|\t}\n221|\tdir := filepath.Join(store.base, \"done\")\n222|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n223|\t\treturn fmt.Errorf(\"create receipt done directory: %w\", err)\n224|\t}\n225|\tsweepStaging(dir)\n226|\ttarget := filepath.Join(dir, receiptName(key))\n227|\tstaged, err := os.CreateTemp(dir, \"result-*.tmp\")\n228|\tif err != nil {\n229|\t\treturn fmt.Errorf(\"stage idempotency result: %w\", err)\n230|\t}\n231|\tstagedPath := staged.Name()\n232|\tdefer func() { _ = os.Remove(stagedPath) }()\n233|\tif err := staged.Chmod(0o600); err != nil {\n234|\t\t_ = staged.Close()\n235|\t\treturn fmt.Errorf(\"protect idempotency result: %w\", err)\n236|\t}\n237|\tif _, err := staged.Write(result); err != nil {\n238|\t\t_ = staged.Close()\n239|\t\treturn fmt.Errorf(\"write idempotency result: %w\", err)\n240|\t}\n241|\tif err := staged.Sync(); err != nil {\n242|\t\t_ = staged.Close()\n243|\t\treturn fmt.Errorf(\"sync idempotency result: %w\", err)\n244|\t}\n245|\tif err := staged.Close(); err != nil {\n246|\t\treturn fmt.Errorf(\"close idempotency result: %w\", err)\n247|\t}\n248|\tif err := os.Link(stagedPath, target); err != nil {\n249|\t\tif errors.Is(err, os.ErrExist) {\n250|\t\t\twinner, readErr := os.ReadFile(target)\n251|\t\t\tif readErr != nil {\n252|\t\t\t\treturn fmt.Errorf(\"read idempotency result: %w\", readErr)\n253|\t\t\t}\n254|\t\t\tif string(winner) != string(result) {\n255|\t\t\t\treturn refuse(CodeIntegrityFailure, \"idempotency result conflict\")\n256|\t\t\t}\n257|\t\t\treturn nil\n258|\t\t}\n259|\t\treturn fmt.Errorf(\"install idempotency result: %w\", err)\n260|\t}\n261|\t_ = os.Remove(stagedPath)\n262|\tif err := syncDirectory(dir); err != nil {\n263|\t\treturn err\n264|\t}\n265|\treturn nil\n266|}\n267|\n268|// Completed returns the recorded result for a key. A bound key without\n269|// its completion reports found false: the attempt was interrupted and\n270|// only status recovers the observation, never a second binding.\n271|func (store *ReceiptStore) Completed(key string) ([]byte, bool, error) {\n272|\tif store == nil || key == \"\" {\n273|\t\treturn nil, false, nil\n274|\t}\n275|\ttarget := filepath.Join(store.base, \"done\", receiptName(key))\n276|\traw, err := os.ReadFile(target)\n277|\tif err != nil {\n278|\t\tif errors.Is(err, os.ErrNotExist) {\n279|\t\t\treturn nil, false, nil\n280|\t\t}\n281|\t\treturn nil, false, fmt.Errorf(\"read idempotency result: %w\", err)\n282|\t}\n283|\treturn raw, true, nil\n284|}\n285|\n286|// Export renders the pending table as stable bytes: receipts sorted by\n287|// key, one triple per receipt. The bytes equal what a\n288|// terminalbackend.Ledger holding the same receipts exports, so they feed\n289|// ImportLedger directly; the agreement is pinned by\n290|// TestStoreExportAgreesWithLedger. Staging garbage is never exported.\n291|func (store *ReceiptStore) Export() ([]byte, error) {\n292|\tif store == nil {\n293|\t\treturn nil, refuse(CodeProtocolError, \"idempotency store unavailable\")\n294|\t}\n295|\tdir := filepath.Join(store.base, \"pending\")\n296|\tentries, err := os.ReadDir(dir)\n297|\tif err != nil {\n298|\t\tif errors.Is(err, os.ErrNotExist) {\n299|\t\t\treturn nil, nil\n300|\t\t}\n301|\t\treturn nil, fmt.Errorf(\"read receipt table: %w\", err)\n302|\t}\n303|\treceipts := make([]Receipt, 0, len(entries))\n304|\tfor _, entry := range entries {\n305|\t\tif entry.IsDir() || !isReceiptName(entry.Name()) {\n306|\t\t\tcontinue\n307|\t\t}\n308|\t\traw, err := os.ReadFile(filepath.Join(dir, entry.Name()))\n309|\t\tif err != nil {\n310|\t\t\treturn nil, fmt.Errorf(\"read idempotency receipt: %w\", err)\n311|\t\t}\n312|\t\treceipt, err := decodeReceipt(raw)\n313|\t\tif err != nil {\n314|\t\t\treturn nil, err\n315|\t\t}\n316|\t\treceipts = append(receipts, receipt)\n317|\t}\n318|\tsort.Slice(receipts, func(i, j int) bool { return receipts[i].Key < receipts[j].Key })\n319|\tvar image strings.Builder\n320|\tfor _, receipt := range receipts {\n321|\t\timage.WriteString(receipt.Key + \"\\n\" + string(receipt.Operation) + \"\\n\" + receipt.OperationID + \"\\n\")\n322|\t}\n323|\treturn []byte(image.String()), nil\n324|}\n325|\n326|// isReceiptName reports whether a directory entry is a committed receipt\n327|// file: exactly 64 lowercase hex characters. Staging files\n328|// (receipt-*.tmp, result-*.tmp) and anything else are ignored.\n329|func isReceiptName(name string) bool {\n330|\tif len(name) != 64 {\n331|\t\treturn false\n332|\t}\n333|\tfor i := 0; i < len(name); i++ {\n334|\t\tdigit := name[i]\n335|\t\tif (digit < '0' || digit > '9') && (digit < 'a' || digit > 'f') {\n336|\t\t\treturn false\n337|\t\t}\n338|\t}\n339|\treturn true\n340|}\n341|\n342|// stagingSweepAge is the minimum age of a staging file the sweep may\n343|// remove. A concurrent Bind stages its own *.tmp between our stage and\n344|// our link; sweeping only files older than this bound keeps a live\n345|// stage alive, while crash garbage (whose mtime stops at the crash)\n346|// ages out on a later call. Readers and Export ignore staging names,\n347|// so a young leftover is invisible until it ages.\n348|const stagingSweepAge = time.Minute\n349|\n350|// sweepStaging removes staging garbage a pre-commit crash left behind.\n351|// Staging files carry the *.tmp suffix; committed receipts never do, so\n352|// the sweep cannot remove a commit. Only files older than\n353|// stagingSweepAge are removed, so a concurrent live stage is never\n354|// deleted: without the age gate a racing Bind would lose its staged\n355|// file and fail its no-replace link with a spurious install error.\n356|func sweepStaging(dir string) {\n357|\tentries, err := os.ReadDir(dir)\n358|\tif err != nil {\n359|\t\treturn\n360|\t}\n361|\tnow := time.Now()\n362|\tfor _, entry := range entries {\n363|\t\tif entry.IsDir() || !strings.HasSuffix(entry.Name(), \".tmp\") {\n364|\t\t\tcontinue\n365|\t\t}\n366|\t\tinfo, err := entry.Info()\n367|\t\tif err != nil {\n368|\t\t\tcontinue\n369|\t\t}\n370|\t\tif now.Sub(info.ModTime()) < stagingSweepAge {\n371|\t\t\tcontinue\n372|\t\t}\n373|\t\t_ = os.Remove(filepath.Join(dir, entry.Name()))\n374|\t}\n375|}\n376|\n377|// syncDirectory fsyncs a directory so committed links survive a crash.\n378|func syncDirectory(dir string) error {\n379|\thandle, err := os.Open(dir)\n380|\tif err != nil {\n381|\t\treturn fmt.Errorf(\"open receipt directory: %w\", err)\n382|\t}\n383|\tdefer func() { _ = handle.Close() }()\n384|\tif err := handle.Sync(); err != nil {\n385|\t\treturn fmt.Errorf(\"sync receipt directory: %w\", err)\n386|\t}\n387|\treturn nil\n388|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
