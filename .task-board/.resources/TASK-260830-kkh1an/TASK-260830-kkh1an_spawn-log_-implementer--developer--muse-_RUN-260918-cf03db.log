"`,\n86|\t\t\"expires_at\":                `\"` + fixtureExpires + `\"`,\n87|\t\t\"authorization_evidence_id\": `\"` + fixtureDigestA + `\"`,\n88|\t}\n89|\tfor name, override := range overrides {\n90|\t\tif override == nil {\n91|\t\t\tdelete(members, name)\n92|\t\t} else {\n93|\t\t\tmembers[name] = *override\n94|\t\t}\n95|\t}\n96|\tnames := []string{\"lease_id\", \"lease_epoch\", \"holder_host_id\", \"authorization_kind\", \"issued_at\", \"expires_at\", \"authorization_evidence_id\"}\n97|\tvar body strings.Builder\n98|\tbody.WriteString(\"{\")\n99|\tfirst := true\n100|\tfor _, name := range names {\n101|\t\traw, known := members[name]\n102|\t\tif !known {\n103|\t\t\tcontinue\n104|\t\t}\n105|\t\tif !first {\n106|\t\t\tbody.WriteString(\",\")\n107|\t\t}\n108|\t\tfirst = false\n109|\t\tbody.WriteString(`\"` + name + `\":` + raw)\n110|\t}\n111|\tfor name, raw := range members {\n112|\t\tknown := false\n113|\t\tfor _, listed := range names {\n114|\t\t\tif listed == name {\n115|\t\t\t\tknown = true\n116|\t\t\t\tbreak\n117|\t\t\t}\n118|\t\t}\n119|\t\tif known {\n120|\t\t\tcontinue\n121|\t\t}\n122|\t\tif !first {\n123|\t\t\tbody.WriteString(\",\")\n124|\t\t}\n125|\t\tfirst = false\n126|\t\tbody.WriteString(`\"` + name + `\":` + raw)\n127|\t}\n128|\tbody.WriteString(\"}\")\n129|\treturn body.String()\n130|}\n131|\n132|func strptr(value string) *string { return &value }\n133|\n134|// testAuth parses the default control authorization for the fixture\n135|// lease at epoch 1.\n136|func testAuth(t *testing.T) AXAuthorization {\n137|\tt.Helper()\n138|\tauth, err := ParseAXAuthorization([]byte(authDoc(\"1\", nil)))\n139|\tif err != nil {\n140|\t\tt.Fatalf(\"ParseAXAuthorization() error = %v\", err)\n141|\t}\n142|\treturn auth\n143|}\n144|\n145|// contextDoc renders a MutationContext document embedding authJSON.\n146|func contextDoc(operationID, session, instance, backend, impl, proto, generation, key, deadline, authJSON string) string {\n147|\treturn `{\"operation_id\":\"` + operationID + `\",` +\n148|\t\t`\"session_id\":\"` + session + `\",` +\n149|\t\t`\"terminal_instance_id\":\"` + instance + `\",` +\n150|\t\t`\"terminal_backend_id\":\"` + backend + `\",` +\n151|\t\t`\"implementation_version\":\"` + impl + `\",` +\n152|\t\t`\"protocol_version\":\"` + proto + `\",` +\n153|\t\t`\"backend_generation\":\"` + generation + `\",` +\n154|\t\t`\"idempotency_key\":\"` + key + `\",` +\n155|\t\t`\"deadline_at\":\"` + deadline + `\",` +\n156|\t\t`\"authorization\":` + authJSON + `}`\n157|}\n158|\n159|// testContext builds the default parsed quiesce context through the\n160|// production ParseMutationContext entry.\n161|func testContext(t *testing.T) MutationContext {\n162|\tt.Helper()\n163|\tkey := fixtureInstance + \"/quiesce/\" + fixtureQuiescence\n164|\traw := contextDoc(fixtureOperation, fixtureSessionA, fixtureInstance, fixtureBackend, fixtureImpl, fixtureProto, fixtureGen, key, fixtureDeadline, authDoc(\"1\", nil))\n165|\tcontext, err := ParseMutationContext([]byte(raw))\n166|\tif err != nil {\n167|\t\tt.Fatalf(\"ParseMutationContext() error = %v\", err)\n168|\t}\n169|\treturn context\n170|}\n171|\n172|func testParams() Params {\n173|\treturn Params{QuiescenceGeneration: fixtureQuiescence}\n174|}\n175|\n176|// mockBackend is the modeled terminal backend: scripted effects and a\n177|// scripted status observation with a full call record.\n178|type mockBackend struct {\n179|\tmutex         sync.Mutex\n180|\teffects       []terminalbackend.SideEffect\n181|\tevidence      map[terminalbackend.SideEffect]string\n182|\teffectErrors  map[terminalbackend.SideEffect]error\n183|\tobservation   StatusObservation\n184|\tobserveErr    error\n185|\tobserveCalls  int\n186|\teffectHandler func(effect terminalbackend.SideEffect) (string, error)\n187|}\n188|\n189|func newMockBackend() *mockBackend {\n190|\treturn &mockBackend{\n191|\t\tevidence:     make(map[terminalbackend.SideEffect]string),\n192|\t\teffectErrors: make(map[terminalbackend.SideEffect]error),\n193|\t}\n194|}\n195|\n196|func (backend *mockBackend) PerformEffect(_ context.Context, effect terminalbackend.SideEffect) (string, error) {\n197|\tbackend.mutex.Lock()\n198|\tdefer backend.mutex.Unlock()\n199|\tbackend.effects = append(backend.effects, effect)\n200|\tif backend.effectHandler != nil {\n201|\t\treturn backend.effectHandler(effect)\n202|\t}\n203|\tif err, failing := backend.effectErrors[effect]; failing {\n204|\t\treturn \"\", err\n205|\t}\n206|\tif evidence, known := backend.evidence[effect]; known {\n207|\t\treturn evidence, nil\n208|\t}\n209|\treturn defaultEvidence(len(backend.effects)), nil\n210|}\n211|\n212|// defaultEvidence mints a distinct valid digest per effect call so\n213|// multi-effect results satisfy sorted-unique evidence without every\n214|// test spelling per-effect evidence by hand.\n215|func defaultEvidence(call int) string {\n216|\treturn \"sha256:\" + strings.Repeat(\"0\", 63) + string(rune('0'+call%10))\n217|}\n218|\n219|func (backend *mockBackend) ObserveStatus(_ context.Context, _ StatusBody) (StatusObservation, error) {\n220|\tbackend.mutex.Lock()\n221|\tdefer backend.mutex.Unlock()\n222|\tbackend.observeCalls++\n223|\tif backend.observeErr != nil {\n224|\t\treturn StatusObservation{}, backend.observeErr\n225|\t}\n226|\treturn backend.observation, nil\n227|}\n228|\n229|func (backend *mockBackend) performed() []terminalbackend.SideEffect {\n230|\tbackend.mutex.Lock()\n231|\tdefer backend.mutex.Unlock()\n232|\treturn append([]terminalbackend.SideEffect(nil), backend.effects...)\n233|}\n234|\n235|// testEngine builds an engine over a fresh temp store, the given\n236|// backend, a fixed winning lease and generation, and the fixture clock.\n237|func testEngine(t *testing.T, backend Backend, lease LeaseView, generation string) *Engine {\n238|\tt.Helper()\n239|\tstore, err := OpenReceiptStore(t.TempDir())\n240|\tif err != nil {\n241|\t\tt.Fatalf(\"OpenReceiptStore() error = %v\", err)\n242|\t}\n243|\tnow := fixtureNow()\n244|\treturn &Engine{\n245|\t\tStore:             store,\n246|\t\tBackend:           backend,\n247|\t\tCurrentLease:      func() LeaseView { return lease },\n248|\t\tCurrentGeneration: func() string { return generation },\n249|\t\tNow:               func() time.Time { return now },\n250|\t}\n251|}\n252|\n253|func testLease() LeaseView {\n254|\treturn LeaseView{LeaseID: fixtureLease, Epoch: 1}\n255|}\n256|\n257|func testAdmitted(capabilities ...string) terminalbackend.Admitted {\n258|\treturn terminalbackend.Admitted{Capabilities: capabilities}\n259|}\n260|\n261|// requireRefusal asserts the exact literal wire code and static detail.\n262|// Every expectation is a literal from the pinned specification text,\n263|// never a production constant.\n264|func requireRefusal(t *testing.T, err error, wantCode, wantDetail string) {\n265|\tt.Helper()\n266|\tif err == nil {\n267|\t\tt.Fatalf(\"error = nil, want %q at %q\", wantCode, wantDetail)\n268|\t}\n269|\tvar refusal *Error\n270|\tif !errors.As(err, &refusal) {\n271|\t\tt.Fatalf(\"error = %v (%T), want *Error with code %q at %q\", err, err, wantCode, wantDetail)\n272|\t}\n273|\tif refusal.Code != wantCode || refusal.Detail != wantDetail {\n274|\t\tt.Errorf(\"refusal = %q at %q, want %q at %q\", refusal.Code, refusal.Detail, wantCode, wantDetail)\n275|\t}\n276|}\n277|\n278|func requireLiteral(t *testing.T, what, got, want string) {\n279|\tt.Helper()\n280|\tif got != want {\n281|\t\tt.Errorf(\"%s = %q, want literal %q\", what, got, want)\n282|\t}\n283|}\n284|\n285|func mustParseState(t *testing.T, value string) terminalbackend.InstanceState {\n286|\tt.Helper()\n287|\tstate, err := terminalbackend.ParseInstanceState(value)\n288|\tif err != nil {\n289|\t\tt.Fatalf(\"ParseInstanceState(%q) error = %v\", value, err)\n290|\t}\n291|\treturn state\n292|}\n293|\n294|func boolptr(value bool) *bool { return &value }","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
