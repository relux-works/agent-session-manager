{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c739","stream":{"kind":"session","id":"01a0b291-18f0-70a0-900f-0c92cf0433eb"},"sequence":503,"recorded_at":1780531400001001,"record_type":"event","durability":"durable","causation_id":"cb7c4ff2-7892-4304-8de0-3769502303db","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cb7c4ff2-7892-4304-8de0-3769502303db","run_stream":{"kind":"run","id":"cb7c4ff2-7892-4304-8de0-3769502303db"},"task_stream":{"kind":"task","id":"01a0b292-81fb-7a20-b178-11776baedd5f"},"task_id":"01a0b292-81fb-7a20-b178-11776baedd5f","event":{"kind":"output","task_id":"01a0b292-81fb-7a20-b178-11776baedd5f","chunk":"Read text file `/tmp/rv2ev/probes/zz_review2_witness_test.go`.\n1|package terminstance\n2|\n3|// Delta witnesses for the RV2 reviewer mutants: each test PASSES on the\n4|// pristine candidate and FAILS under its mutant, proving the survivor is\n5|// non-equivalent (observable behaviour changes) and that no committed\n6|// test covers the arm.\n7|\n8|import (\n9|\t\"strings\"\n10|\t\"testing\"\n11|\t\"time\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n14|)\n15|\n16|// RV2-M1: lease rotates exactly before the THIRD stop effect.\n17|func TestRV2W_M1_LeaseRotatesBeforeThirdEffect(t *testing.T) {\n18|\tbackend := newMockBackend()\n19|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n20|\tcalls := 0\n21|\tengine.CurrentLease = func() LeaseView {\n22|\t\tcalls++\n23|\t\tif calls <= 3 { // entry, pre-effect 1, pre-effect 2\n24|\t\t\treturn testLease()\n25|\t\t}\n26|\t\treturn LeaseView{LeaseID: fixtureLease, Epoch: 2}\n27|\t}\n28|\tcontext, params, source, admitted := stopFixture(t)\n29|\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationRequestStop, context, params, source, admitted)\n30|\tt.Logf(\"err=%v after=%q disposition=%q performed=%v\", err, result.After, result.Disposition, backend.performed())\n31|\trequireRefusal(t, err, \"terminal_backend_unauthorized\", \"ax authorization lease epoch\")\n32|\tif len(backend.performed()) != 2 {\n33|\t\tt.Errorf(\"performed = %v, want exactly two effects before the rotated lease is caught\", backend.performed())\n34|\t}\n35|}\n36|\n37|// RV2-M2: generation rotates exactly before the THIRD stop effect.\n38|func TestRV2W_M2_GenerationRotatesBeforeThirdEffect(t *testing.T) {\n39|\tbackend := newMockBackend()\n40|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n41|\tcalls := 0\n42|\tengine.CurrentGeneration = func() string {\n43|\t\tcalls++\n44|\t\tif calls <= 3 {\n45|\t\t\treturn fixtureGen\n46|\t\t}\n47|\t\treturn \"generation-two\"\n48|\t}\n49|\tcontext, params, source, admitted := stopFixture(t)\n50|\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationRequestStop, context, params, source, admitted)\n51|\tt.Logf(\"err=%v after=%q disposition=%q performed=%v\", err, result.After, result.Disposition, backend.performed())\n52|\trequireRefusal(t, err, \"terminal_backend_stale_generation\", \"backend_generation stale\")\n53|\tif len(backend.performed()) != 2 {\n54|\t\tt.Errorf(\"performed = %v, want exactly two effects\", backend.performed())\n55|\t}\n56|}\n57|\n58|// RV2-M3 / RV2-M4: now == deadline_at refuses at both entries.\n59|func TestRV2W_M3_M4_DeadlineInstant(t *testing.T) {\n60|\tdeadline, _ := time.Parse(time.RFC3339Nano, fixtureDeadline)\n61|\tbackend := newMockBackend()\n62|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n63|\tengine.Now = func() time.Time { return deadline }\n64|\tcontext, params, source, admitted := quiesceFixture(t)\n65|\t_, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n66|\trequireRefusal(t, err, \"terminal_backend_timeout\", \"operation deadline\")\n67|\tif len(backend.performed()) != 0 {\n68|\t\tt.Errorf(\"performed = %v at the deadline instant\", backend.performed())\n69|\t}\n70|\tif _, found, _ := engine.Store.Lookup(context.IdempotencyKey); found {\n71|\t\tt.Error(\"a receipt was bound for a request whose deadline had already arrived (entry deadline admitted the instant)\")\n72|\t}\n73|\tbackendS := newMockBackend()\n74|\tbackendS.observation = matchingObservation()\n75|\tengineS := testEngine(t, backendS, testLease(), fixtureGen)\n76|\tengineS.Now = func() time.Time { return deadline }\n77|\t_, err = engineS.ExecuteStatus(contextGo(), exactStatusBody(t), source, testAdmitted(\"durable_disconnect\"))\n78|\trequireRefusal(t, err, \"terminal_backend_timeout\", \"operation deadline\")\n79|}\n80|\n81|// RV2-M5: create's SECOND effect (wrapper_started) reports\n82|// terminal_backend_timeout after binding_persisted committed.\n83|func TestRV2W_M5_CommittedTimeoutOnCreateSecondEffect(t *testing.T) {\n84|\tcreate := testCreateContext(t)\n85|\tbackend := newMockBackend()\n86|\tbackend.effectErrors[terminalbackend.EffectWrapperStarted] = refuse(\"terminal_backend_timeout\", \"test wrapper timeout\")\n87|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n88|\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, create.context, create.params, mustParseState(t, \"absent\"), testAdmitted(\"terminal_state_retention\"))\n89|\tt.Logf(\"err=%v after=%q disposition=%q performed=%v\", err, result.After, result.Disposition, backend.performed())\n90|\trequireRefusal(t, err, \"terminal_backend_timeout\", \"backend effect refused\")\n91|\trequireLiteral(t, \"after\", string(result.After), \"unavailable\")\n92|\trequireLiteral(t, \"disposition\", string(result.Disposition), \"status_first\")\n93|}\n94|\n95|// RV2-M6: authorization_kind \"attach\" is not an AXAuthorization kind.\n96|func TestRV2W_M6_AttachKindRefused(t *testing.T) {\n97|\traw := authDoc(\"1\", map[string]*string{\"authorization_kind\": strptr(`\"attach\"`)})\n98|\t_, err := ParseAXAuthorization([]byte(raw))\n99|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"ax authorization kind\")\n100|\tkey := fixtureInstance + \"/quiesce/\" + fixtureQuiescence\n101|\tctxRaw := contextDoc(fixtureOperation, fixtureSessionA, fixtureInstance, fixtureBackend, fixtureImpl, fixtureProto, fixtureGen, key, fixtureDeadline, raw)\n102|\t_, err = ParseMutationContext([]byte(ctxRaw))\n103|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"ax authorization kind\")\n104|}\n105|\n106|// RV2-M7: create under a stale generation refuses at entry.\n107|func TestRV2W_M7_CreateStaleGenerationRefuses(t *testing.T) {\n108|\tcreate := testCreateContext(t)\n109|\tbackend := newMockBackend()\n110|\tengine := testEngine(t, backend, testLease(), \"generation-two\")\n111|\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, create.context, create.params, mustParseState(t, \"absent\"), testAdmitted(\"terminal_state_retention\"))\n112|\tt.Logf(\"err=%v after=%q disposition=%q performed=%v\", err, result.After, result.Disposition, backend.performed())\n113|\trequireRefusal(t, err, \"terminal_backend_stale_generation\", \"backend_generation stale\")\n114|\tif len(backend.performed()) != 0 {\n115|\t\tt.Errorf(\"performed = %v under a stale generation\", backend.performed())\n116|\t}\n117|\tif _, found, _ := engine.Store.Lookup(create.context.IdempotencyKey); found {\n118|\t\tt.Error(\"a receipt was bound under a stale generation\")\n119|\t}\n120|}\n121|\n122|// RV2-M8: create with a control-kind, an expired, and a foreign-lease\n123|// authorization refuses at entry.\n124|func TestRV2W_M8_CreateAuthorizationRefuses(t *testing.T) {\n125|\tt.Run(\"control kind presented as create\", func(t *testing.T) {\n126|\t\tcreate := testCreateContext(t)\n127|\t\tcreate.context.Authorization = testAuth(t) // kind control\n128|\t\tbackend := newMockBackend()\n129|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n130|\t\t_, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, create.context, create.params, mustParseState(t, \"absent\"), testAdmitted(\"terminal_state_retention\"))\n131|\t\trequireRefusal(t, err, \"terminal_backend_unauthorized\", \"ax authorization kind binding\")\n132|\t\tif len(backend.performed()) != 0 {\n133|\t\t\tt.Errorf(\"performed = %v with a control authorization\", backend.performed())\n134|\t\t}\n135|\t\tif _, found, _ := engine.Store.Lookup(create.context.IdempotencyKey); found {\n136|\t\t\tt.Error(\"a receipt was bound for a create presented with a control authorization (the bootstrap key is now poisoned)\")\n137|\t\t}\n138|\t})\n139|\tt.Run(\"expired\", func(t *testing.T) {\n140|\t\tcreate := testCreateContext(t)\n141|\t\tbackend := newMockBackend()\n142|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n143|\t\tengine.Now = fixtureLater\n144|\t\t_, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, create.context, create.params, mustParseState(t, \"absent\"), testAdmitted(\"terminal_state_retention\"))\n145|\t\trequireRefusal(t, err, \"terminal_backend_unauthorized\", \"ax authorization expiry\")\n146|\t\tif len(backend.performed()) != 0 {\n147|\t\t\tt.Errorf(\"performed = %v with an expired authorization\", backend.performed())\n148|\t\t}\n149|\t})\n150|\tt.Run(\"foreign lease\", func(t *testing.T) {\n151|\t\tcreate := testCreateContext(t)\n152|\t\tbackend := newMockBackend()\n153|\t\tengine := testEngine(t, backend, LeaseView{LeaseID: fixtureLeaseB, Epoch: 1}, fixtureGen)\n154|\t\t_, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, create.context, create.params, mustParseState(t, \"absent\"), testAdmitted(\"terminal_state_retention\"))\n155|\t\trequireRefusal(t, err, \"terminal_backend_unauthorized\", \"ax authorization lease identity\")\n156|\t\tif len(backend.performed()) != 0 {\n157|\t\t\tt.Errorf(\"performed = %v under a foreign winning lease\", backend.performed())\n158|\t\t}\n159|\t\tif _, found, _ := engine.Store.Lookup(create.context.IdempotencyKey); found {\n160|\t\t\tt.Error(\"a receipt was bound for a create under a foreign winning lease (the bootstrap key is now poisoned)\")\n161|\t\t}\n162|\t})\n163|}\n164|\n165|// RV2-M9: a lying match with only the implementation version drifted.\n166|func TestRV2W_M9_LyingMatchOnImplementationAxis(t *testing.T) {\n167|\tbackend := newMockBackend()\n168|\tobserved := matchingObservation()\n169|\tobserved.ImplVersion = \"1.2.4\"\n170|\tbackend.observation = observed\n171|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n172|\t_, err := engine.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n173|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"status identity binding\")\n174|}\n175|\n176|// RV2-M10: headless create from ABSENT without headless_creation.\n177|func TestRV2W_M10_HeadlessCreateFromAbsentNeedsCapability(t *testing.T) {\n178|\tcreate := testCreateContext(t)\n179|\tcreate.params.Interactive = false\n180|\tbackend := newMockBackend()\n181|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n182|\t_, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, create.context, create.params, mustParseState(t, \"absent\"), testAdmitted(\"terminal_state_retention\"))\n183|\trequireRefusal(t, err, \"terminal_backend_capability_unproven\", \"operation capability conditional\")\n184|\tif len(backend.performed()) != 0 {\n185|\t\tt.Errorf(\"performed = %v for a headless create without headless_creation\", backend.performed())\n186|\t}\n187|}\n188|\n189|// RV2-M15: a session-scoped lookup whose backend reports ANOTHER\n190|// session's instance with identity_match true must refuse, never adopt.\n191|func TestRV2W_M15_SessionScopedForeignSessionRefuses(t *testing.T) {\n192|\tbody, err := ParseStatusBody([]byte(statusDoc(`null`, `null`)))\n193|\tif err != nil {\n194|\t\tt.Fatal(err)\n195|\t}\n196|\tbackend := newMockBackend()\n197|\tobserved := matchingObservation()\n198|\tobserved.SessionID = fixtureSessionB\n199|\tbackend.observation = observed\n200|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n201|\treport, err := engine.ExecuteStatus(contextGo(), body, mustParseState(t, \"absent\"), testAdmitted(\"durable_disconnect\"))\n202|\tt.Logf(\"err=%v report=%+v\", err, report)\n203|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"status identity binding\")\n204|}\n205|\n206|var _ = strings.Repeat","final_result":true}}}
