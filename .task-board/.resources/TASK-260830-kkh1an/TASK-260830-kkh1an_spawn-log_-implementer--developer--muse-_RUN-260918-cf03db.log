cuteStatus(ctx, body, source, admitted)\\n\\tif err != nil && ErrorCode(err) != CodeTimeout {\\n\\t\\tfailure := refuse(CodeUnavailable, \"idempotency result uncertain\")\\n\\t\\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), failure\\n\\t}\\n\\tif report.State != source && report.State != \"\" {\\n',\n+        count=1,\n+        run=\"TestExecuteUncertainRetryUnknownObservationRefuses/coded_read_failure\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the timeout-coded failed reconciliation read past the uncertain-refusal arm (one behavioral arm in two adjacent checks: ExecuteStatus returns the empty report on every error path, so the timeout must pass both); every other failed read, and every non-empty non-source report, still refuses.\",\n+    ),\n+    Mutant(\n+        name=\"N-resume-contradiction\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find=\"\\tif report.State != source {\\n\",\n+        replace=\"\\tif report.State != source && report.State != terminalbackend.StateParked {\\n\",\n+        count=1,\n+        run=\"TestExecuteUncertainRetryTargetProvenRefuses/contradictory_observation\",\n+        expect=\"KILLED\",\n+        note=\"Resumes on exactly the parked contradiction as well as the source; target-proven, unknown and other contradictions still refuse.\",\n+    ),\n","final_result":true}}}
