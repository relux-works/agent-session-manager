{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c515","stream":{"kind":"session","id":"01a0b1f0-f342-7821-939e-4786eeeb7588"},"sequence":229,"recorded_at":1780531400000453,"record_type":"event","durability":"durable","causation_id":"c7ad7d78-80b9-46e1-9367-f83a27084d43","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"c7ad7d78-80b9-46e1-9367-f83a27084d43","run_stream":{"kind":"run","id":"c7ad7d78-80b9-46e1-9367-f83a27084d43"},"task_stream":{"kind":"task","id":"01a0b1f1-703d-7893-8f19-8c4a4ad6a221"},"task_id":"01a0b1f1-703d-7893-8f19-8c4a4ad6a221","event":{"kind":"output","task_id":"01a0b1f1-703d-7893-8f19-8c4a4ad6a221","chunk":"Read text file `internal/terminalbackend/conformance.go`.\n(459 line(s) above)\n460|// the non-empty floor is enforced.\n461|var idempotencyKeySegments = map[Operation]int{\n462|\tOperationManifest: 1, OperationProbe: 1,\n463|\tOperationCreate: 2, OperationRestore: 2, OperationAttach: 2,\n464|\tOperationQuiesceInput: 3, OperationRequestStop: 3,\n465|\tOperationWaitSafeBoundary: 4, OperationTerminateStale: 4,\n466|\tOperationStatus: -1,\n467|}\n468|\n469|// Receipt is one durably bound idempotency record: the canonical key, the\n470|// operation it was bound for, and the recorded result identity. AX and the\n471|// backend bind the pair before the first child side effect (§4.1); an\n472|// identical retry returns the recorded result instead of acting again.\n473|type Receipt struct {\n474|\tKey       string\n475|\tOperation Operation\n476|\tResultID  string\n477|}\n478|\n479|// Ledger is the process-local idempotency receipt table backing the §4.C\n480|// recovery rules: persist the receipt before the first side effect,\n481|// identical retry replays it, a changed operation in the window is\n482|// idempotency_mismatch, and uncertainty requires status before any start\n483|// retry. The zero value is unusable; construct with NewLedger.\n484|//\n485|// The ledger is the semantic half of durability: Export and Import move\n486|// the table across a controller crash as stable bytes, and Import refuses\n487|// a malformed or ambiguous image instead of inventing an empty table.\n488|type Ledger struct {\n489|\tmutex    sync.Mutex\n490|\treceipts map[string]Receipt\n491|}\n492|\n493|// NewLedger opens an empty receipt table.\n494|func NewLedger() *Ledger {\n495|\treturn &Ledger{receipts: make(map[string]Receipt)}\n496|}\n497|\n498|// Bind records the receipt for a key before the first side effect. A key\n499|// bound for the first time is stored and replayed back. A key bound again\n500|// with the identical operation and result replays the stored receipt: it\n501|// performs no new effect. A key bound again with a different operation or\n502|// result is idempotency_mismatch: only a successful status read proves\n503|// absence, never a second binding.\n504|func (ledger *Ledger) Bind(key string, operation Operation, resultID string) (Receipt, error) {\n505|\tif ledger == nil {\n506|\t\treturn Receipt{}, refuse(&Error{Code: CodeProtocolError, Detail: \"idempotency ledger unavailable\"})\n507|\t}\n508|\tif key == \"\" || resultID == \"\" {\n509|\t\treturn Receipt{}, refuse(&Error{Code: CodeProtocolError, Detail: \"idempotency key shape\"})\n510|\t}\n511|\tif _, err := ParseOperation(string(operation)); err != nil {\n512|\t\treturn Receipt{}, err\n513|\t}\n514|\tledger.mutex.Lock()\n515|\tdefer ledger.mutex.Unlock()\n516|\tif stored, known := ledger.receipts[key]; known {\n517|\t\tif stored.Operation != operation || stored.ResultID != resultID {\n518|\t\t\treturn Receipt{}, refuse(&Error{Code: CodeIdempotencyMismatch, Detail: \"idempotency key conflict\"})\n519|\t\t}\n520|\t\treturn stored, nil\n521|\t}\n522|\treceipt := Receipt{Key: key, Operation: operation, ResultID: resultID}\n523|\tledger.receipts[key] = receipt\n524|\treturn receipt, nil\n525|}\n526|\n527|// Replay returns the stored receipt for a key. A lost result replays the\n528|// receipt; absence of a receipt proves nothing and reports false, so the\n529|// caller must consult status before any start retry.\n530|func (ledger *Ledger) Replay(key string) (Receipt, bool) {\n531|\tif ledger == nil {\n532|\t\treturn Receipt{}, false\n533|\t}\n534|\tledger.mutex.Lock()\n535|\tdefer ledger.mutex.Unlock()\n536|\treceipt, known := ledger.receipts[key]\n537|\treturn receipt, known\n538|}\n539|\n540|// Export renders the table as stable bytes: receipts sorted by key, one\n541|// per line as key, operation, and result fields. Import refuses a\n542|// malformed image or one binding the same key twice instead of admitting\n543|// a half-read table.\n544|func (ledger *Ledger) Export() []byte {\n545|\tif ledger == nil {\n546|\t\treturn nil\n547|\t}\n548|\tledger.mutex.Lock()\n549|\tdefer ledger.mutex.Unlock()\n550|\tkeys := make([]string, 0, len(ledger.receipts))\n551|\tfor key := range ledger.receipts {\n552|\t\tkeys = append(keys, key)\n553|\t}\n554|\tsort.Strings(keys)\n555|\tvar image strings.Builder\n556|\tfor _, key := range keys {\n557|\t\treceipt := ledger.receipts[key]\n558|\t\timage.WriteString(key + \"\\n\" + string(receipt.Operation) + \"\\n\" + receipt.ResultID + \"\\n\")\n559|\t}\n560|\treturn []byte(image.String())\n561|}\n562|\n563|// AttachAuthorization is the closed, ownership-neutral AX policy object\n564|// of §4.C: exactly policy evidence, authorizing host, transport, input\n565|// boolean, and an expiry strictly after issue. It authorizes only the\n566|// named presentation transport and input boolean. It contains no lease\n567|// member of any kind and therefore cannot acquire, renew, or transfer\n568|// ownership; ParseAttachAuthorization refuses any document carrying one\n569|// as an unknown member before any other check runs.\n570|type AttachAuthorization struct {\n571|\tPolicyEvidenceID  string\n572|\tAuthorizingHostID string\n573|\tTransport         PresentationTransport\n574|\tInputAuthorized   bool\n575|\tIssuedAt          scalar.Timestamp\n576|\tExpiresAt         scalar.Timestamp\n577|}\n578|\n579|// attachAuthorizationMembers is the exact closed member set.\n580|var attachAuthorizationMembers = []string{\n581|\t\"policy_evidence_id\",\n582|\t\"authorizing_host_id\",\n583|\t\"transport\",\n584|\t\"input_authorized\",\n585|\t\"issued_at\",\n586|\t\"expires_at\",\n587|}\n588|\n589|// ParseAttachAuthorization admits one closed AttachAuthorization document.\n590|// Unknown members (including any lease, epoch, holder, or authorization\n591|// kind member smuggled into an attach policy) and missing members are\n592|// both malformed; a malformed read is an error, never an absent policy,\n593|// so callers must not fall back to an unauthenticated attach.\n594|func ParseAttachAuthorization(raw []byte) (AttachAuthorization, error) {\n595|\tobject, err := decodeStrictObject(raw)\n596|\tif err != nil {\n597|\t\treturn AttachAuthorization{}, err\n598|\t}\n599|\tif err := checkExactMembers(object, attachAuthorizationMembers); err != nil {\n600|\t\treturn AttachAuthorization{}, err\n601|\t}\n602|\tpolicyEvidenceID, err := digestMember(object, \"policy_evidence_id\")\n603|\tif err != nil {\n604|\t\treturn AttachAuthorization{}, err\n605|\t}\n606|\tauthorizingHostID, err := stringMember(object, \"authorizing_host_id\")\n607|\tif err != nil {\n608|\t\treturn AttachAuthorization{}, err\n609|\t}\n610|\tif _, err := scalar.ParseUUIDv7(authorizingHostID); err != nil {\n611|\t\treturn AttachAuthorization{}, mismatchf(\"document member type\")\n612|\t}\n613|\ttransportRaw, err := stringMember(object, \"transport\")\n614|\tif err != nil {\n615|\t\treturn AttachAuthorization{}, err\n616|\t}\n617|\ttransport, err := parseTransport(transportRaw)\n618|\tif err != nil {\n619|\t\treturn AttachAuthorization{}, err\n620|\t}\n621|\tinputRaw, known := object[\"input_authorized\"]\n622|\tif !known {\n623|\t\treturn AttachAuthorization{}, mismatchf(\"document members\")\n624|\t}\n625|\tinputAuthorized, ok := inputRaw.(bool)\n626|\tif !ok {\n627|\t\treturn AttachAuthorization{}, mismatchf(\"document member type\")\n628|\t}\n629|\tissuedAt, err := timestampMember(object, \"issued_at\")\n630|\tif err != nil {\n631|\t\treturn AttachAuthorization{}, err\n632|\t}\n633|\texpiresAt, err := timestampMember(object, \"expires_at\")\n634|\tif err != nil {\n635|\t\treturn AttachAuthorization{}, err\n636|\t}\n637|\tissued, err := issuedAt.Time()\n638|\tif err != nil {\n639|\t\treturn AttachAuthorization{}, mismatchf(\"document timestamp\")\n640|\t}\n641|\texpires, err := expiresAt.Time()\n642|\tif err != nil {\n643|\t\treturn AttachAuthorization{}, mismatchf(\"document timestamp\")\n644|\t}\n645|\tif !expires.After(issued) {\n646|\t\treturn AttachAuthorization{}, refuse(&Error{Code: CodeUnauthorized, Detail: \"attach authorization expiry\"})\n647|\t}\n648|\treturn AttachAuthorization{\n649|\t\tPolicyEvidenceID:  policyEvidenceID,\n650|\t\tAuthorizingHostID: authorizingHostID,\n651|\t\tTransport:         transport,\n652|\t\tInputAuthorized:   inputAuthorized,\n653|\t\tIssuedAt:          issuedAt,\n654|\t\tExpiresAt:         expiresAt,\n655|\t}, nil\n656|}\n657|\n658|// CheckAttachRequest authorizes one attach request against its policy at\n659|// the given instant. The request transport and input boolean must equal\n660|// the authorized ones; a relay transport is refused even when authorized\n661|// on paper, because current AX admits only local and trusted-mesh\n662|// presentation (§4.E). Expiry is checked against now: an expired policy\n663|// authorizes nothing, and a lease-shaped bypass cannot exist because the\n664|// policy has no lease member to consult.\n665|func CheckAttachRequest(auth AttachAuthorization, transport string, inputAuthorized bool, now time.Time) error {\n666|\trequested, err := parseTransport(transport)\n667|\tif err != nil {\n668|\t\treturn err\n669|\t}\n670|\tif requested != auth.Transport || inputAuthorized != auth.InputAuthorized {\n671|\t\treturn refuse(&Error{Code: CodeUnauthorized, Detail: \"attach authorization binding\"})\n672|\t}\n673|\tif requested == TransportThirdPartyRelay {\n674|\t\treturn refuse(&Error{Code: CodeUnauthorized, Detail: \"attach relay transport\"})\n675|\t}\n676|\texpires, err := auth.ExpiresAt.Time()\n677|\tif err != nil {\n678|\t\treturn mismatchf(\"document timestamp\")\n679|\t}\n680|\tif !now.Before(expires) {\n681|\t\treturn refuse(&Error{Code: CodeUnauthorized, Detail: \"attach authorization expiry\"})\n682|\t}\n683|\treturn nil\n684|}\n685|\n686|// CheckAttachResult enforces the §4.C attach result rule: the result\n687|// input boolean MUST equal both the request and the AttachAuthorization.\n688|// A backend reporting input the policy did not authorize is refused even\n689|// when the request itself was authorized.\n690|func CheckAttachResult(requestInputAuthorized, resultInputAuthorized bool, auth AttachAuthorization) error {\n691|\tif resultInputAuthorized != requestInputAuthorized || resultInputAuthorized != auth.InputAuthorized {\n692|\t\treturn refuse(&Error{Code: CodeUnauthorized, Detail: \"attach input binding\"})\n693|\t}\n694|\treturn nil\n695|}\n696|\n697|// CheckEntrypoint enforces the §4.A stable entrypoint rule: every\n698|// backend-created runtime ultimately executes exactly\n699|// `ax pane SESSION_ID`, and a raw provider command is forbidden as a\n700|// durable entry point. argv must be exactly the three literals ax, pane,\n701|// and the canonical request Session UUIDv7 string, and the carried\n702|// session must equal the session under creation.\n703|func CheckEntrypoint(argv []string, sessionID string) error {\n704|\tif len(argv) != 3 || argv[0] != \"ax\" || argv[1] != \"pane\" {\n705|\t\treturn refuse(&Error{Code: CodePreconditionFailed, Detail: \"entrypoint argv\"})\n706|\t}\n707|\tsession, err := scalar.ParseUUIDv7(sessionID)\n708|\tif err != nil {\n709|\t\treturn refuse(&Error{Code: CodePreconditionFailed, Detail: \"entrypoint session binding\"})\n710|\t}\n711|\tcarried, err := scalar.ParseUUIDv7(argv[2])\n712|\tif err != nil {\n713|\t\treturn refuse(&Error{Code: CodePreconditionFailed, Detail: \"entrypoint session binding\"})\n714|\t}\n715|\tif carried.String() != session.String() {\n716|\t\treturn refuse(&Error{Code: CodePreconditionFailed, Detail: \"entrypoint session binding\"})\n717|\t}\n718|\treturn nil\n719|}\n720|\n721|// StatusResult is the §4.C status success body in harness form. Pointer\n722|// members distinguish null from false: provider observation is null\n723|// unless requested and evidenced, and the last-operation fields are null\n724|// when the backend reports no prior operation.\n725|type StatusResult struct {\n726|\tState             InstanceState\n727|\tIdentityMatch     bool\n728|\tWrapperPresent    bool\n729|\tProviderPresent   *bool\n730|\tAttachable        bool\n731|\tLastOperationID   *string\n732|\tLastEffect        *SideEffect\n733|\tProviderRequested bool\n734|\tProviderEvidenced bool\n735|\tAttachEvidenced   bool\n736|}\n737|\n738|// CheckStatusResult enforces the §4.C exact-instance lookup rules. A\n739|// non-match sets identity_match false, state absent, wrapper absent,\n740|// provider null, attachable false, and both last fields null, and does\n741|// not authorize fallback: any deviation from that canonical false form\n742|// is refused. provider_present is null unless provider observation was\n743|// requested and evidenced. attachable is true only in parked or active\n744|// with a currently evidenced matching attach capability. A timeout or\n745|// read failure is unknown, never absent: this check validates reported\n746|// results and never synthesizes absence from a missing read.\n747|func CheckStatusResult(identityMatch bool, result StatusResult) error {\n748|\tif _, err := ParseInstanceState(string(result.State)); err != nil {\n749|\t\treturn err\n750|\t}\n751|\tif result.LastEffect != nil {\n752|\t\tif _, err := ParseSideEffect(string(*result.LastEffect)); err != nil {\n753|\t\t\treturn err\n754|\t\t}\n755|\t}\n756|\tif !identityMatch || !result.IdentityMatch {\n757|\t\tif result.IdentityMatch {\n758|\t\t\treturn refuse(&Error{Code: CodeProtocolError, Detail: \"status identity binding\"})\n759|\t\t}\n760|\t\tif result.State != StateAbsent || result.WrapperPresent ||\n761|\t\t\tresult.ProviderPresent != nil || result.Attachable ||\n762|\t\t\tresult.LastOperationID != nil || result.LastEffect != nil {\n763|\t\t\treturn refuse(&Error{Code: CodeProtocolError, Detail: \"status identity binding\"})\n764|\t\t}\n765|\t\treturn nil\n766|\t}\n767|\tif result.ProviderPresent != nil && !(result.ProviderRequested && result.ProviderEvidenced) {\n768|\t\treturn refuse(&Error{Code: CodeProtocolError, Detail: \"status provider observation\"})\n769|\t}\n770|\tif result.Attachable && !((result.State == StateParked || result.State == StateActive) && result.AttachEvidenced) {\n771|\t\treturn refuse(&Error{Code: CodePreconditionFailed, Detail: \"status attachability\"})\n772|\t}\n773|\treturn nil\n774|}\n775|\n776|// ParseSideEffect admits exactly the ten §4.C side effects.\n777|func ParseSideEffect(value string) (SideEffect, error) {\n778|\tswitch SideEffect(value) {\n779|\tcase EffectBindingPersisted, EffectWrapperStarted, EffectAttachClientCreated,\n780|\t\tEffectInputClosed, EffectSafeBoundaryObserved, EffectGracefulStopRequested,\n781|\t\tEffectProcessClosed, EffectBackendStoreClosed,\n782|\t\tEffectStaleIncarnationTerminated, EffectWrapperRestored:\n783|\t\treturn SideEffect(value), nil\n784|\tdefault:\n785|\t\treturn \"\", refuse(&Error{Code: CodeProtocolError, Detail: \"side effect vocabulary\"})\n786|\t}\n787|}\n788|\n789|// ReplicationClass is the §4.E persistence classification. Only\n790|// safe_evidence MAY persist and replicate after validation; every other\n791|// class is host-local, rebuildable, owner-only, or forbidden.\n792|type ReplicationClass string\n793|\n794|// Replication classes.\n795|const (\n796|\tReplicationSafeEvidence       ReplicationClass = \"safe_evidence\"\n797|\tReplicationHostLocal          ReplicationClass = \"host_local\"\n798|\tReplicationDerivedCache       ReplicationClass = \"derived_cache\"\n799|\tReplicationSensitiveOwnerOnly ReplicationClass = \"sensitive_owner_only\"\n800|\tReplicationForbidden          ReplicationClass = \"forbidden\"\n801|)\n802|\n803|// replicationMembers is the closed §4.E classification table. Member\n804|// names are wire vocabulary, never local data: classifying a member the\n805|// table does not know is refused rather than defaulted.\n806|var replicationMembers = buildReplicationMembers()\n807|\n808|// buildReplicationMembers assembles the closed §4.E classification table.\n809|// Member names are wire vocabulary, never local data: classifying a member\n810|// the table does not know is refused rather than defaulted.\n811|func buildReplicationMembers() map[string]ReplicationClass {\n812|\t// Safe immutable evidence: sanitized backend identity, versions,\n813|\t// platform, conformance, and capability evidence MAY persist and\n814|\t// replicate after validation.\n815|\tsafe := []string{\n816|\t\t\"manifest_id\", \"probe_id\", \"evidence_id\",\n817|\t\t\"terminal_backend_id\", \"implementation_version\",\n818|\t\t\"protocol_version\", \"protocol_versions\",\n819|\t\t\"platform\", \"platforms\", \"os_version\",\n820|\t\t\"conformance_fixture_id\", \"capability_claims\", \"evidence_ids\",\n821|\t\t\"backend_generation_digest\", \"capability\", \"dependent_operations\",\n822|\t\t\"evidence_requirements\", \"facts\", \"issuer\", \"issuer_id\",\n823|\t\t\"observed_at\", \"expires_at\",\n824|\t}\n825|\t// Host-local durable metadata: instance/binding IDs, sanitized native\n826|\t// reference, generation, idempotency receipt, last effect.\n827|\thostLocal := []string{\n828|\t\t\"binding_id\", \"terminal_instance_id\", \"session_id\",\n829|\t\t\"host_id\", \"host_incarnation_id\", \"backend_generation\",\n830|\t\t\"native_reference\", \"idempotency_receipt\", \"last_effect\",\n831|\t\t\"last_operation_id\", \"supersedes_binding_id\", \"created_at\",\n832|\t}\n833|\t// Derived cache: discovery, availability, attachability, and process\n834|\t// observations with probe views; rebuildable, non-authoritative.\n835|\tderived := []string{\n836|\t\t\"availability\", \"attachable\", \"wrapper_present\", \"provider_present\",\n837|\t\t\"identity_match\", \"state\", \"probed_at\",\n838|\t}\n839|\t// Sensitive runtime state: IPC, sockets, pipes, attach/relay\n840|\t// credentials, backend auth and live databases, GUI/login\n841|\t// attestations, provider credentials; owner-only, non-replicable.\n842|\tsensitive := []string{\n843|\t\t\"attach_descriptor\", \"ipc_handle\", \"tmux_socket\",\n844|\t\t\"named_pipe\", \"attach_credential\", \"relay_credential\",\n845|\t\t\"backend_auth\", \"auth_database\", \"gui_attestation\",\n846|\t\t\"login_attestation\", \"provider_credential\", \"evidence_secret\",\n847|\t\t\"environment_values\",\n848|\t}\n849|\t// Forbidden: raw native reference, PID/handle, endpoint/token,\n850|\t// terminal output/scrollback, unrestricted environment, credential\n851|\t// detail, and live-process facts MUST NOT replicate.\n852|\tforbidden := []string{\n853|\t\t\"native_pid\", \"process_handle\", \"endpoint\", \"token\",\n854|\t\t\"terminal_output\", \"scrollback\", \"unrestricted_environment\",\n855|\t\t\"credential_detail\", \"live_process_fact\", \"raw_native_reference\",\n856|\t}\n857|\ttable := make(map[string]ReplicationClass,\n858|\t\tlen(safe)+len(hostLocal)+len(derived)+len(sensitive)+len(forbidden))\n859|\tfor _, member := range safe {\n860|\t\ttable[member] = ReplicationSafeEvidence\n861|\t}\n862|\tfor _, member := range hostLocal {\n863|\t\ttable[member] = ReplicationHostLocal\n864|\t}\n865|\tfor _, member := range derived {\n866|\t\ttable[member] = ReplicationDerivedCache\n867|\t}\n868|\tfor _, member := range sensitive {\n869|\t\ttable[member] = ReplicationSensitiveOwnerOnly\n870|\t}\n871|\tfor _, member := range forbidden {\n872|\t\ttable[member] = ReplicationForbidden\n873|\t}\n874|\treturn table\n875|}\n876|\n877|// Import rebuilds a ledger from Export bytes. A truncated, malformed, or\n878|// ambiguous image is an error, never an empty table, so a failed read\n879|// cannot masquerade as proven absence. An empty image rebuilds the empty\n880|// table, which is exactly what Export of a fresh ledger produces.\n881|func ImportLedger(image []byte) (*Ledger, error) {\n882|\tlines := strings.Split(string(image), \"\\n\")\n883|\tif len(lines) > 0 && lines[len(lines)-1] == \"\" {\n884|\t\tlines = lines[:len(lines)-1]\n885|\t}\n886|\tif len(lines)%3 != 0 {\n887|\t\treturn nil, refuse(&Error{Code: CodeProtocolError, Detail: \"idempotency ledger image\"})\n888|\t}\n889|\tledger := NewLedger()\n890|\tfor index := 0; index < len(lines); index += 3 {\n891|\t\tkey, operation, resultID := lines[index], lines[index+1], lines[index+2]\n892|\t\tif key == \"\" || resultID == \"\" {\n893|\t\t\treturn nil, refuse(&Error{Code: CodeProtocolError, Detail: \"idempotency ledger image\"})\n894|\t\t}\n895|\t\tparsed, err := ParseOperation(operation)\n896|\t\tif err != nil {\n897|\t\t\treturn nil, refuse(&Error{Code: CodeProtocolError, Detail: \"idempotency ledger image\"})\n898|\t\t}\n899|\t\tif _, duplicate := ledger.receipts[key]; duplicate {\n900|\t\t\treturn nil, refuse(&Error{Code: CodeIdempotencyMismatch, Detail: \"idempotency ledger image\"})\n901|\t\t}\n902|\t\tledger.receipts[key] = Receipt{Key: key, Operation: parsed, ResultID: resultID}\n903|\t}\n904|\treturn ledger, nil\n905|}\n906|\n907|// ClassifyReplication reports the §4.E persistence class of one wire\n908|// member. An unlisted member reports false: the table is closed, and an\n909|// unknown member is refused rather than defaulted into any class.\n910|func ClassifyReplication(member string) (ReplicationClass, bool) {\n911|\tclass, known := replicationMembers[member]\n912|\treturn class, known\n913|}\n914|\n915|// CheckReplicable refuses a replication set carrying any member outside\n916|// the safe immutable evidence class, or any member the closed table does\n917|// not know. Host-local metadata, derived cache, sensitive runtime state,\n918|// and forbidden members MUST NOT replicate; unknown members fail the\n919|// same way, because an unclassified member replicating by default would\n920|// silently widen the §4.E exclusion. An empty set replicates nothing and\n921|// is admitted. The refusal is a protocol error: the set is a body\n922|// variant the replication contract does not cover.\n923|func CheckReplicable(members []string) error {\n924|\tfor _, member := range members {\n925|\t\tif class, known := replicationMembers[member]; !known || class != ReplicationSafeEvidence {\n926|\t\t\treturn refuse(&Error{Code: CodeProtocolError, Detail: \"replication exclusion\"})\n927|\t\t}\n928|\t}\n929|\treturn nil\n930|}\n931|\n932|// LegacyUnreported is the version and generation a historical v0.4.3\n933|// translation carries. The past reported no versions and no generation,\n934|// so the translation says exactly that instead of inferring values no\n935|// observation supports.\n936|const LegacyUnreported = \"legacy_unreported\"\n937|\n938|// LegacyBinding is the §4.E forward translation of one historical v0.4.3\n939|// backend identity: the canonical backend ID with unreported version and\n940|// generation. It carries no capability field of any kind: a translation\n941|// MUST NOT infer capabilities the historical record never evidenced, and\n942|// a struct that cannot name them cannot smuggle them. The field count is\n943|// pinned by TestLegacyBindingCarriesNoCapabilities.\n944|type LegacyBinding struct {\n945|\tBackendID             string\n946|\tImplementationVersion string\n947|\tGeneration            string\n948|}\n949|\n950|// legacyForward is the exact §4.E forward map. Only the two immutable\n951|// v0.4.3 values translate; anything else is incompatible, never fallback.\n952|var legacyForward = map[string]string{\n953|\t\"tmux\":   BuiltinTmux,\n954|\t\"conpty\": BuiltinConpty,\n955|}\n956|\n957|// TranslateLegacyBackend deterministically maps a historical v0.4.3\n958|// backend name to its canonical binding. Version and generation are\n959|// legacy_unreported and no capabilities are inferred. Translation is a\n960|// pure function over its argument: it never rewrites or re-digests\n961|// history, and the input is unchanged by construction.\n962|func TranslateLegacyBackend(legacy string) (LegacyBinding, error) {\n963|\tcanonical, known := legacyForward[legacy]\n964|\tif !known {\n965|\t\treturn LegacyBinding{}, refuse(&Error{Code: CodeIncompatibleSchema, Detail: \"legacy backend identity\"})\n966|\t}\n967|\treturn LegacyBinding{\n968|\t\tBackendID:             canonical,\n969|\t\tImplementationVersion: LegacyUnreported,\n970|\t\tGeneration:            LegacyUnreported,\n971|\t}, nil\n972|}\n973|\n974|// ProjectToLegacy is the §4.E reverse projection. It exists only for the\n975|// two canonical built-ins; every other backend ID, including a\n976|// well-formed third-party ID, returns incompatible_schema, never a\n977|// fallback. A malformed identity is not an ID at all and is refused by\n978|// the registry grammar first.\n979|func ProjectToLegacy(backendID string) (string, error) {\n980|\tif _, err := ParseID(backendID); err != nil {\n981|\t\treturn \"\", err\n982|\t}\n983|\tfor legacy, canonical := range legacyForward {\n984|\t\tif backendID == canonical {\n985|\t\t\treturn legacy, nil\n986|\t\t}\n987|\t}\n988|\treturn \"\", refuse(&Error{Code: CodeIncompatibleSchema, Detail: \"legacy reverse projection\"})\n989|}","final_result":true}}}
