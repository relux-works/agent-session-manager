{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c549","stream":{"kind":"session","id":"01a0b1f0-f342-7821-939e-4786eeeb7588"},"sequence":255,"recorded_at":1780531400000505,"record_type":"event","durability":"durable","causation_id":"c7ad7d78-80b9-46e1-9367-f83a27084d43","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"c7ad7d78-80b9-46e1-9367-f83a27084d43","run_stream":{"kind":"run","id":"c7ad7d78-80b9-46e1-9367-f83a27084d43"},"task_stream":{"kind":"task","id":"01a0b1f1-8115-7753-8543-ddff542bb681"},"task_id":"01a0b1f1-8115-7753-8543-ddff542bb681","event":{"kind":"output","task_id":"01a0b1f1-8115-7753-8543-ddff542bb681","chunk":"{\n  \"chunk_id\": \"exec-11-1\",\n  \"command\": \"task-board resource --help 2>&1 | head -30; echo ===; task-board q 'schema(operation=list)' 2>&1 | head -c 2000\",\n  \"description\": \"Learn resource download and list query\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Manage attached resources such as screenshots, docs, logs, and other files.\\n\\nUse \\\"task-board resource add\\\" to create a new attached resource, \\\"task-board\\nresource adopt\\\" to register an orphaned local payload, \\\"task-board resource\\nupdate\\\" to replace an existing one, \\\"task-board resource delete\\\" to remove it,\\nand \\\"task-board resource get\\\" to materialize a resource back to the local\\nfilesystem for inspection.\\n\\nUsage:\\n  task-board resource [command]\\n\\nAvailable Commands:\\n  add         Attach a new file resource to an element\\n  adopt       Register an existing unreferenced local resource payload\\n  delete      Delete a resource from an element (requires --confirm)\\n  get         Download a resource to the local filesystem\\n  update      Replace an existing file resource on an element\\n\\nFlags:\\n  -h, --help   help for resource\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (ov