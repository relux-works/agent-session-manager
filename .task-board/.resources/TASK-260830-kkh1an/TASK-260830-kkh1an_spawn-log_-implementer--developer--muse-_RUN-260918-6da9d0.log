{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e1","stream":{"kind":"session","id":"01a0b1f0-f342-7821-939e-4786eeeb7588"},"sequence":203,"recorded_at":1780531400000401,"record_type":"event","durability":"durable","causation_id":"c7ad7d78-80b9-46e1-9367-f83a27084d43","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"c7ad7d78-80b9-46e1-9367-f83a27084d43","run_stream":{"kind":"run","id":"c7ad7d78-80b9-46e1-9367-f83a27084d43"},"call_id":"call_01a0b1f15a7e72128a5ac79540ecf891","text":"{\n  \"chunk_id\": \"exec-9-1\",\n  \"command\": \"task-board q 'resources(TASK-260830-1geqhj)' 2>&1 | head -60; echo ===; task-board q 'resources(STORY-260830-ptxkqe)' 2>&1 | head -40\",\n  \"description\": \"Query predecessor and story resources\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"query error: parse error at 1:1: unknown operation \\\"resources\\\" (got \\\"resources\\\"); known operations: activity, agents, context, context_boundary, context_candidates, context_retention, contexts, count, get, list, models, plan, project_config, provider_limits, schema, summary, whoami; see schema() for the contract and schema(operation=NAME) for one signature\\n===\\nquery error: parse error at 1:1: unknown operation \\\"resources\\\" (got \\\"resources\\\"); known operations: activity, agents, context, context_boundary, context_candidates, context_retention, contexts, count, get, list, models, plan, project_config, provider_limits, schema, summary, whoami; see schema() for the contract and schema(operation=NAME) for one signature\\n\",\n  \"original_output_bytes\": 722,\n  \"original_output_tokens\": 181,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e3","stream":{"kind":"session","id":"01a0b1f0-f342-7821-939e-4786eeeb7588"},"sequence":204,"recorded_at":1780531400000403,"record_type":"event","durability":"durable","causation_id":"c7ad7d78-80b9-46e1-9367-f83a27084d43","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"c7ad7d78-80b9-46e1-9367-f83a27084d43","run_stream":{"kind":"run","id":"c7ad7d78-80b9-46e1-9367-f83a27084d43"},"call_id":"call_01a0b1f15f037079aa18acc30c40b828","text":"Read text file `internal/terminalbackend/conformance.go`.\n1|// Lifecycle, attach, entrypoint, replication, and historical-translation\n2|// conformance for the TerminalBackend registry.\n3|//\n4|// Normative scope is relux-works/agent-session-manager-spec@v0.5.0 §4.A\n5|// (authority: attach changes no ownership; every backend-created runtime\n6|// executes exactly `ax pane SESSION_ID`), §4.C (lifecycle state machine,\n7|// transition/authorization/idempotency table), §4.D (attach authorization\n8|// neutrality and capability dependencies, enforced by manifest.go), §4.E\n9|// (replication classification and v0.4.3 historical translation), §4.1\n10|// (backend interface operations and the idempotent bootstrap binding), §6.5\n11|// (platform defaults select only new activation), and §7.A (provider-side\n12|// descriptor binding, enforced by CheckProviderDescriptor in\n13|// terminalbackend.go).\n14|//\n15|// Section 4.B names this deliverable: \"M0 exposes only an internal semantic\n16|// interface and conformance harness\". This file is that harness: it proves\n17|// the semantics over admitted registry state but performs no I/O, launches\n18|// no backend, and holds no authority beyond refusing contract violations.\n19|// Capability gating stays in manifest.go (CheckOperation, Reconcile); trust\n20|// stays in terminalbackend.go (RegisterExternal, DigestFile). A refusal here\n21|// is an *Error with a wire code from the pinned catalog error vocabulary\n22|// and a static Detail clause, following the package convention.\n23|package terminalbackend\n24|\n25|import (\n26|\t\"sort\"\n27|\t\"strings\"\n28|\t\"sync\"\n29|\t\"time\"\n30|\n31|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n32|)\n33|\n34|// Wire error codes this file may report. Each is a member of the pinned\n35|// catalog error vocabulary; TestWireCodesAreCatalogued proves no other code\n36|// is advertised.\n37|const (\n38|\t// CodeProtocolError reports an unknown operation, state, or member, a\n39|\t// body variant outside the closed §4.C matrix, or an error code the\n40|\t// backend MUST NOT emit for the operation (§4.B, §4.C). AX-local\n41|\t// parsing may additionally emit it for a syntactically valid request\n42|\t// the matrix does not cover.\n43|\tCodeProtocolError = \"terminal_backend_protocol_error\"\n44|\t// CodeUnauthorized reports an expired, mismatched, or otherwise\n45|\t// unsatisfiable attach authorization (§4.C attach row).\n46|\tCodeUnauthorized = \"terminal_backend_unauthorized\"\n47|\t// CodeUnavailable reports a backend that cannot serve the operation.\n48|\t// It appears here only inside the allowed-error sets: no conformance\n49|\t// refusal in this file emits it, so it carries no arm of its own.\n50|\tCodeUnavailable = \"terminal_backend_unavailable\"\n51|\t// CodePreconditionFailed reports a legal request against an illegal\n52|\t// source state, a non-conforming stable entrypoint, or any other\n53|\t// unmet local precondition (§4.C per-operation rows, §4.1).\n54|\tCodePreconditionFailed = \"local_precondition_failed\"\n55|\t// CodeIdempotencyMismatch reports a changed operation inside an\n56|\t// established idempotency window (§4.C, §4.1).\n57|\tCodeIdempotencyMismatch = \"idempotency_mismatch\"\n58|\t// CodeIncompatibleSchema reports a legacy identity with no canonical\n59|\t// projection, or a canonical identity with no legacy projection\n60|\t// (§4.E). It never falls back.\n61|\tCodeIncompatibleSchema = \"incompatible_schema\"\n62|)\n63|\n64|// IsProtocolError reports CodeProtocolError refusals.\n65|func IsProtocolError(err error) bool { return errorCode(err, CodeProtocolError) }\n66|\n67|// IsUnauthorized reports CodeUnauthorized refusals.\n68|func IsUnauthorized(err error) bool { return errorCode(err, CodeUnauthorized) }\n69|\n70|// IsPreconditionFailed reports CodePreconditionFailed refusals.\n71|func IsPreconditionFailed(err error) bool { return errorCode(err, CodePreconditionFailed) }\n72|\n73|// IsIdempotencyMismatch reports CodeIdempotencyMismatch refusals.\n74|func IsIdempotencyMismatch(err error) bool { return errorCode(err, CodeIdempotencyMismatch) }\n75|\n76|// IsIncompatibleSchema reports CodeIncompatibleSchema refusals.\n77|func IsIncompatibleSchema(err error) bool { return errorCode(err, CodeIncompatibleSchema) }\n78|\n79|// InstanceState is the closed §4.C TerminalInstanceState enum: local\n80|// hosting only, never a second ownership state machine.\n81|type InstanceState string\n82|\n83|// Terminal Instance states.\n84|const (\n85|\tStateAbsent      InstanceState = \"absent\"\n86|\tStateCreating    InstanceState = \"creating\"\n87|\tStateParked      InstanceState = \"parked\"\n88|\tStateActive      InstanceState = \"active\"\n89|\tStateQuiescing   InstanceState = \"quiescing\"\n90|\tStateStopped     InstanceState = \"stopped\"\n91|\tStateStaleFenced InstanceState = \"stale_fenced\"\n92|\tStateUnavailable InstanceState = \"unavailable\"\n93|)\n94|\n95|// ParseInstanceState admits exactly the eight §4.C states.\n96|func ParseInstanceState(value string) (InstanceState, error) {\n97|\tswitch InstanceState(value) {\n98|\tcase StateAbsent, StateCreating, StateParked, StateActive,\n99|\t\tStateQuiescing, StateStopped, StateStaleFenced, StateUnavailable:\n100|\t\treturn InstanceState(value), nil\n101|\tdefault:\n102|\t\treturn \"\", refuse(&Error{Code: CodeProtocolError, Detail: \"lifecycle state vocabulary\"})\n103|\t}\n104|}\n105|\n106|// Operation is the closed §4.D TerminalBackendOperation enum.\n107|type Operation string\n108|\n109|// Terminal backend operations.\n110|const (\n111|\tOperationManifest         Operation = \"manifest\"\n112|\tOperationProbe            Operation = \"probe\"\n113|\tOperationCreate           Operation = \"create\"\n114|\tOperationAttach           Operation = \"attach\"\n115|\tOperationStatus           Operation = \"status\"\n116|\tOperationQuiesceInput     Operation = \"quiesce-input\"\n117|\tOperationWaitSafeBoundary Operation = \"wait-safe-boundary\"\n118|\tOperationRequestStop      Operation = \"request-stop\"\n119|\tOperationTerminateStale   Operation = \"terminate-stale\"\n120|\tOperationRestore          Operation = \"restore\"\n121|)\n122|\n123|// ParseOperation admits exactly the ten §4.D operations.\n124|func ParseOperation(value string) (Operation, error) {\n125|\tswitch Operation(value) {\n126|\tcase OperationManifest, OperationProbe, OperationCreate, OperationAttach,\n127|\t\tOperationStatus, OperationQuiesceInput, OperationWaitSafeBoundary,\n128|\t\tOperationRequestStop, OperationTerminateStale, OperationRestore:\n129|\t\treturn Operation(value), nil\n130|\tdefault:\n131|\t\treturn \"\", refuse(&Error{Code: CodeProtocolError, Detail: \"operation vocabulary\"})\n132|\t}\n133|}\n134|\n135|// SideEffect is the closed §4.C TerminalBackendSideEffect enum.\n136|type SideEffect string\n137|\n138|// Terminal backend side effects.\n139|const (\n140|\tEffectBindingPersisted           SideEffect = \"binding_persisted\"\n141|\tEffectWrapperStarted             SideEffect = \"wrapper_started\"\n142|\tEffectAttachClientCreated        SideEffect = \"attach_client_created\"\n143|\tEffectInputClosed                SideEffect = \"input_closed\"\n144|\tEffectSafeBoundaryObserved       SideEffect = \"safe_boundary_observed\"\n145|\tEffectGracefulStopRequested      SideEffect = \"graceful_stop_requested\"\n146|\tEffectProcessClosed              SideEffect = \"process_closed\"\n147|\tEffectBackendStoreClosed         SideEffect = \"backend_store_closed\"\n148|\tEffectStaleIncarnationTerminated SideEffect = \"stale_incarnation_terminated\"\n149|\tEffectWrapperRestored            SideEffect = \"wrapper_restored\"\n150|)\n151|\n152|// PresentationTransport is the closed §4.E presentation transport enum.\n153|// Only the first two are admittable; a relay-required backend is\n154|// unavailable pending explicit future product/contract approval, so no\n155|// constructor admits it here.\n156|type PresentationTransport string\n157|\n158|// Presentation transports.\n159|const (\n160|\tTransportLocalOnly          PresentationTransport = \"local_only\"\n161|\tTransportTrustedPrivateMesh PresentationTransport = \"trusted_private_mesh\"\n162|\tTransportThirdPartyRelay    PresentationTransport = \"third_party_relay\"\n163|)\n164|\n165|// parseTransport admits exactly the closed transport vocabulary. The relay\n166|// member parses so a request naming it is classified rather than\n167|// misreported, but CheckAttachRequest refuses it: current AX admits only\n168|// the first two.\n169|func parseTransport(value string) (PresentationTransport, error) {\n170|\tswitch PresentationTransport(value) {\n171|\tcase TransportLocalOnly, TransportTrustedPrivateMesh, TransportThirdPartyRelay:\n172|\t\treturn PresentationTransport(value), nil\n173|\tdefault:\n174|\t\treturn \"\", refuse(&Error{Code: CodeProtocolError, Detail: \"presentation transport vocabulary\"})\n175|\t}\n176|}\n177|\n178|// Authorization kinds carried by the transition table. \"attach\" names the\n179|// ownership-neutral AttachAuthorization below; every other mutating kind\n180|// names an AXAuthorization lease tuple, which this harness does not mint\n181|// (no lease implementation exists here) but does name so the table stays\n182|// exact.\n183|const (\n184|\tauthorizationNone       = \"none\"\n185|\tauthorizationCreate     = \"create\"\n186|\tauthorizationAttach     = \"attach\"\n187|\tauthorizationControl    = \"control\"\n188|\tauthorizationForceStale = \"force_stale\"\n189|\tauthorizationRestore    = \"restore\"\n190|)\n191|\n192|// Transition is one exact §4.C table row: the allowed sources, the success\n193|// target, and the exact side effects for one operation.\n194|type Transition struct {\n195|\tOperation     Operation\n196|\tSources       []InstanceState\n197|\tTarget        InstanceState\n198|\tTargetParked  bool\n199|\tEffects       []SideEffect\n200|\tAuthorization string\n201|\t// InstanceScoped is false for manifest and probe, which carry no\n202|\t// Terminal Instance source or target and no side effects.\n203|\tInstanceScoped bool\n204|\t// SameState marks status: every source is allowed and the success\n205|\t// state is the source itself, with no side effect.\n206|\tSameState bool\n207|}\n208|\n209|// transitionTable is the exact §4.C transition matrix. create carries two\n210|// targets: active when interactive, otherwise parked.\n211|var transitionTable = []Transition{\n212|\t{Operation: OperationManifest, InstanceScoped: false, Authorization: authorizationNone},\n213|\t{Operation: OperationProbe, InstanceScoped: false, Authorization: authorizationNone},\n214|\t{\n215|\t\tOperation: OperationCreate,\n216|\t\tSources:   []InstanceState{StateAbsent, StateStopped},\n217|\t\tTarget:    StateActive, TargetParked: true,\n218|\t\tEffects:        []SideEffect{EffectBindingPersisted, EffectWrapperStarted},\n219|\t\tAuthorization:  authorizationCreate,\n220|\t\tInstanceScoped: true,\n221|\t},\n222|\t{\n223|\t\tOperation:      OperationAttach,\n224|\t\tSources:        []InstanceState{StateParked, StateActive},\n225|\t\tTarget:         StateActive,\n226|\t\tEffects:        []SideEffect{EffectAttachClientCreated},\n227|\t\tAuthorization:  authorizationAttach,\n228|\t\tInstanceScoped: true,\n229|\t},\n230|\t{\n231|\t\tOperation: OperationStatus,\n232|\t\tSources: []InstanceState{\n233|\t\t\tStateAbsent, StateCreating, StateParked, StateActive,\n234|\t\t\tStateQuiescing, StateStopped, StateStaleFenced, StateUnavailable,\n235|\t\t},\n236|\t\tSameState:      true,\n237|\t\tAuthorization:  authorizationNone,\n238|\t\tInstanceScoped: true,\n239|\t},\n240|\t{\n241|\t\tOperation:      OperationQuiesceInput,\n242|\t\tSources:        []InstanceState{StateActive, StateParked},\n243|\t\tTarget:         StateQuiescing,\n244|\t\tEffects:        []SideEffect{EffectInputClosed},\n245|\t\tAuthorization:  authorizationControl,\n246|\t\tInstanceScoped: true,\n247|\t},\n248|\t{\n249|\t\tOperation:      OperationWaitSafeBoundary,\n250|\t\tSources:        []InstanceState{StateQuiescing},\n251|\t\tTarget:         StateQuiescing,\n252|\t\tEffects:        []SideEffect{EffectSafeBoundaryObserved},\n253|\t\tAuthorization:  authorizationControl,\n254|\t\tInstanceScoped: true,\n255|\t},\n256|\t{\n257|\t\tOperation:      OperationRequestStop,\n258|\t\tSources:        []InstanceState{StateQuiescing},\n259|\t\tTarget:         StateStopped,\n260|\t\tEffects:        []SideEffect{EffectGracefulStopRequested, EffectProcessClosed, EffectBackendStoreClosed},\n261|\t\tAuthorization:  authorizationControl,\n262|\t\tInstanceScoped: true,\n263|\t},\n264|\t{\n265|\t\tOperation:      OperationTerminateStale,\n266|\t\tSources:        []InstanceState{StateStaleFenced, StateUnavailable},\n267|\t\tTarget:         StateStopped,\n268|\t\tEffects:        []SideEffect{EffectStaleIncarnationTerminated, EffectProcessClosed},\n269|\t\tAuthorization:  authorizationForceStale,\n270|\t\tInstanceScoped: true,\n271|\t},\n272|\t{\n273|\t\tOperation:      OperationRestore,\n274|\t\tSources:        []InstanceState{StateAbsent, StateStopped, StateUnavailable},\n275|\t\tTarget:         StateParked,\n276|\t\tEffects:        []SideEffect{EffectBindingPersisted, EffectWrapperRestored},\n277|\t\tAuthorization:  authorizationRestore,\n278|\t\tInstanceScoped: true,\n279|\t},\n280|}\n281|\n282|// lookupTransition returns the table row for one operation.\n283|func lookupTransition(operation Operation) (Transition, bool) {\n284|\tfor _, row := range transitionTable {\n285|\t\tif row.Operation == operation {\n286|\t\t\treturn row, true\n287|\t\t}\n288|\t}\n289|\treturn Transition{}, false\n290|}\n291|\n292|// CheckTransition enforces the §4.C transition matrix. It returns the\n293|// success target state and the exact side effects. create resolves its\n294|// target from interactive: active when interactive, otherwise parked. A\n295|// state reached only by AX fencing observation (stale_fenced) is never\n296|// entered here: no backend operation targets it, so a row naming it as a\n297|// target cannot exist and CheckTransition cannot return it except as a\n298|// status observation of the source itself.\n299|//\n300|// An unknown operation or state is a protocol error; a known operation\n301|// against a disallowed source is a failed local precondition. Only\n302|// quiesce-input enters quiescing, and creating is never a success target:\n303|// it exists only between the idempotency receipt and the first side\n304|// effect, which the Ledger below owns.\n305|func CheckTransition(operation, source string, interactive bool) (InstanceState, []SideEffect, error) {\n306|\tparsedOperation, err := ParseOperation(operation)\n307|\tif err != nil {\n308|\t\treturn \"\", nil, err\n309|\t}\n310|\trow, known := lookupTransition(parsedOperation)\n311|\tif !known {\n312|\t\treturn \"\", nil, refuse(&Error{Code: CodeProtocolError, Detail: \"operation vocabulary\"})\n313|\t}\n314|\tif !row.InstanceScoped {\n315|\t\tif source != \"\" {\n316|\t\t\treturn \"\", nil, refuse(&Error{Code: CodePreconditionFailed, Detail: \"lifecycle instance scope\"})\n317|\t\t}\n318|\t\treturn \"\", nil, nil\n319|\t}\n320|\tparsedSource, err := ParseInstanceState(source)\n321|\tif err != nil {\n322|\t\treturn \"\", nil, err\n323|\t}\n324|\tallowed := false\n325|\tfor _, candidate := range row.Sources {\n326|\t\tif candidate == parsedSource {\n327|\t\t\tallowed = true\n328|\t\t\tbreak\n329|\t\t}\n330|\t}\n331|\tif !allowed {\n332|\t\treturn \"\", nil, refuse(&Error{Code: CodePreconditionFailed, Detail: \"lifecycle transition\"})\n333|\t}\n334|\tif row.SameState {\n335|\t\treturn parsedSource, nil, nil\n336|\t}\n337|\tif parsedOperation == OperationCreate && !interactive {\n338|\t\treturn StateParked, append([]SideEffect(nil), row.Effects...), nil\n339|\t}\n340|\treturn row.Target, append([]SideEffect(nil), row.Effects...), nil\n341|}\n342|\n343|// allowedOperationErrors is the exact §4.C \"Allowed error codes\" column.\n344|// An error not listed for an operation MUST NOT be emitted by the backend\n345|// for a syntactically valid request; AX-local parsing may additionally\n346|// emit terminal_backend_protocol_error, which every row therefore carries.\n347|var allowedOperationErrors = map[Operation][]string{\n348|\tOperationManifest: {\n349|\t\tCodeProtocolError, \"terminal_backend_protocol_incompatible\",\n350|\t\t\"terminal_backend_process_failed\", \"terminal_backend_timeout\",\n351|\t\tCodeIntegrityFailure,\n352|\t},\n353|\tOperationProbe: {\n354|\t\tCodeUntrusted, CodeMismatch, CodeDrift,\n355|\t\tCodeProtocolError, \"terminal_backend_process_failed\", \"terminal_backend_timeout\",\n356|\t\tCodeIntegrityFailure,\n357|\t},\n358|\tOperationCreate: {\n359|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n360|\t\tCodeStaleGeneration, CodeCapabilityUnproven, CodeUnavailable,\n361|\t\t\"terminal_backend_timeout\", \"terminal_backend_process_failed\",\n362|\t\tCodeIntegrityFailure, CodeProtocolError,\n363|\t},\n364|\tOperationAttach: {\n365|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n366|\t\tCodeStaleGeneration, CodeCapabilityUnproven, CodeUnavailable,\n367|\t\t\"terminal_backend_timeout\", \"terminal_backend_process_failed\",\n368|\t\tCodeIntegrityFailure, CodeProtocolError,\n369|\t},\n370|\tOperationStatus: {\n371|\t\tCodeStaleGeneration, CodeCapabilityUnproven, CodeUnavailable,\n372|\t\t\"terminal_backend_timeout\", CodeIntegrityFailure, CodeProtocolError,\n373|\t},\n374|\tOperationQuiesceInput: {\n375|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n376|\t\tCodeStaleGeneration, CodeCapabilityUnproven,\n377|\t\t\"terminal_backend_timeout\", CodeIntegrityFailure, CodeProtocolError,\n378|\t},\n379|\tOperationWaitSafeBoundary: {\n380|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n381|\t\tCodeStaleGeneration, CodeCapabilityUnproven,\n382|\t\t\"quiesce_timeout\", CodeIntegrityFailure, CodeProtocolError,\n383|\t},\n384|\tOperationRequestStop: {\n385|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n386|\t\tCodeStaleGeneration, CodeCapabilityUnproven,\n387|\t\t\"stop_timeout\", \"terminal_backend_process_failed\",\n388|\t\tCodeIntegrityFailure, CodeProtocolError,\n389|\t},\n390|\tOperationTerminateStale: {\n391|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n392|\t\tCodeStaleGeneration, CodeCapabilityUnproven,\n393|\t\t\"terminal_backend_timeout\", \"terminal_backend_process_failed\",\n394|\t\tCodeIntegrityFailure, CodeProtocolError,\n395|\t},\n396|\tOperationRestore: {\n397|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n398|\t\tCodeStaleGeneration, CodeCapabilityUnproven, CodeRestoreMismatch,\n399|\t\tCodeUnavailable, \"terminal_backend_timeout\", \"terminal_backend_process_failed\",\n400|\t\tCodeIntegrityFailure, CodeProtocolError,\n401|\t},\n402|}\n403|\n404|// CheckErrorAllowed enforces the §4.C error mapping: a backend reporting a\n405|// code outside the operation's allowed set violates the contract, and the\n406|// report itself is refused as a protocol error. It names the production\n407|// reporting site, not the underlying failure.\n408|func CheckErrorAllowed(operation, code string) error {\n409|\tparsedOperation, err := ParseOperation(operation)\n410|\tif err != nil {\n411|\t\treturn err\n412|\t}\n413|\tfor _, allowed := range allowedOperationErrors[parsedOperation] {\n414|\t\tif code == allowed {\n415|\t\t\treturn nil\n416|\t\t}\n417|\t}\n418|\treturn refuse(&Error{Code: CodeProtocolError, Detail: \"operation error vocabulary\"})\n419|}\n420|\n421|// IdempotencyKey derives the canonical UTF-8 idempotency key for one\n422|// operation from its identity segments (§4.C authorization and idempotency\n423|// column, §4.1 bootstrap binding). The key is never caller-chosen free\n424|// text: the segment count and order are fixed per operation, and every\n425|// segment must be non-empty.\n426|//\n427|// The per-operation forms are: manifest and probe take the request ID\n428|// alone; create and restore take session_id + bootstrap_operation_id;\n429|// attach takes terminal_instance_id + client_id; quiesce-input takes\n430|// terminal_instance_id + \"quiesce\" + quiescence_generation;\n431|// wait-safe-boundary takes terminal_instance_id + \"boundary\" +\n432|// quiescence_generation + provider_proof_kind; request-stop takes\n433|// terminal_instance_id + \"stop\" + safe_boundary_evidence_id;\n434|// terminate-stale takes terminal_instance_id + \"terminate\" +\n435|// stale_lease_id + decimal stale_epoch; status takes its full queried\n436|// identity tuple, of at least one segment.\n437|func IdempotencyKey(operation string, segments ...string) (string, error) {\n438|\tparsedOperation, err := ParseOperation(operation)\n439|\tif err != nil {\n440|\t\treturn \"\", err\n441|\t}\n442|\tfor _, segment := range segments {\n443|\t\tif segment == \"\" {\n444|\t\t\treturn \"\", refuse(&Error{Code: CodeProtocolError, Detail: \"idempotency key shape\"})\n445|\t\t}\n446|\t}\n447|\twant := idempotencyKeySegments[parsedOperation]\n448|\tif want < 0 {\n449|\t\tif len(segments) < 1 {\n450|\t\t\treturn \"\", refuse(&Error{Code: CodeProtocolError, Detail: \"idempotency key shape\"})\n451|\t\t}\n452|\t} else if len(segments) != want {\n453|\t\treturn \"\", refuse(&Error{Code: CodeProtocolError, Detail: \"idempotency key shape\"})\n454|\t}\n455|\treturn strings.Join(segments, \"/\"), nil\n456|}\n457|\n458|// idempotencyKeySegments is the fixed per-operation segment count. status\n459|// carries its full queried identity tuple, so its count varies and only\n460|// the non-empty floor is enforced.\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
