      | 1032 +++++++++++++++++++++++++++++++++\\n internal/axpane/descriptor.go       |  119 ++++\\n internal/axpane/descriptor_test.go  |  178 ++++++\\n internal/axpane/doc.go              |  103 ++++\\n internal/axpane/errors.go           |  161 ++++++\\n internal/axpane/events.go           |  287 +++++++++\\n internal/axpane/events_test.go      |  265 +++++++++\\n internal/axpane/fixtures_test.go    |  851 +++++++++++++++++++++++++++\\n internal/axpane/gates.go            |  237 ++++++++\\n internal/axpane/mutant_harness.py   |  706 ++++++++++++++++++++++\\n internal/axpane/rev3_test.go        |  848 +++++++++++++++++++++++++++\\n internal/axpane/rev4_test.go        |  463 +++++++++++++++\\n internal/axpane/rework_test.go      |  680 ++++++++++++++++++++++\\n internal/axpane/run.go              |  429 ++++++++++++++\\n internal/axpane/run_test.go         |  522 +++++++++++++++++\\n internal/axpane/sync.go             |   26 +\\n 24 files changed, 9743 insertions(+)\\n\",\n  \"original_output_bytes\": 1874,\n  \"original_output_tokens\": 469,\n  \"truncated\": false\n}","final_result":true}}}
