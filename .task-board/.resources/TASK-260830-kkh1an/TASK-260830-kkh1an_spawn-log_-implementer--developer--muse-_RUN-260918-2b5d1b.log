{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d1ed","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":1873,"recorded_at":1780531400003741,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"call_id":"call_01a0b23e2eb074a0bbb849c53cfa4404","text":"Read text file `internal/terminstance/execute_test.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"context\"\n5|\t\"errors\"\n6|\t\"testing\"\n7|\t\"time\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n10|)\n11|\n12|func quiesceFixture(t *testing.T) (MutationContext, Params, terminalbackend.InstanceState, terminalbackend.Admitted) {\n13|\tt.Helper()\n14|\treturn testContext(t), testParams(), mustParseState(t, \"active\"), testAdmitted(\"input_quiescence\")\n15|}\n16|\n17|// TestExecuteQuiesceSuccess drives the quiesce-input row through the\n18|// production entry from both sources: active|parked → quiescing with\n19|// exactly input_closed, disposition replay_same, and the receipt bound.\n20|func TestExecuteQuiesceSuccess(t *testing.T) {\n21|\tfor _, source := range []string{\"active\", \"parked\"} {\n22|\t\tt.Run(source, func(t *testing.T) {\n23|\t\t\tbackend := newMockBackend()\n24|\t\t\tbackend.evidence[terminalbackend.EffectInputClosed] = fixtureDigestB\n25|\t\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n26|\t\t\tcontext, params, _, admitted := quiesceFixture(t)\n27|\t\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, mustParseState(t, source), admitted)\n28|\t\t\tif err != nil {\n29|\t\t\t\tt.Fatalf(\"ExecuteMutating() error = %v\", err)\n30|\t\t\t}\n31|\t\t\trequireLiteral(t, \"before\", string(result.Before), source)\n32|\t\t\trequireLiteral(t, \"after\", string(result.After), \"quiescing\")\n33|\t\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"replay_same\")\n34|\t\t\tif len(result.Effects) != 1 || result.Effects[0] != terminalbackend.EffectInputClosed {\n35|\t\t\t\tt.Errorf(\"effects = %v, want [input_closed]\", result.Effects)\n36|\t\t\t}\n37|\t\t\trequireLiteral(t, \"evidence\", result.EvidenceIDs[0], \"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\")\n38|\t\t\tif err := CheckResult(context, mustParseState(t, source), result); err != nil {\n39|\t\t\t\tt.Errorf(\"CheckResult(engine result) error = %v\", err)\n40|\t\t\t}\n41|\t\t\tperformed := backend.performed()\n42|\t\t\tif len(performed) != 1 || performed[0] != terminalbackend.EffectInputClosed {\n43|\t\t\t\tt.Errorf(\"performed = %v, want [input_closed]\", performed)\n44|\t\t\t}\n45|\t\t\tif _, found, err := engine.Store.Lookup(context.IdempotencyKey); err != nil || !found {\n46|\t\t\t\tt.Errorf(\"Lookup(key) = (%v, %v), want the bound receipt\", found, err)\n47|\t\t\t}\n48|\t\t})\n49|\t}\n50|}\n51|\n52|func contextGo() context.Context { return context.Background() }\n53|\n54|// TestExecuteReceiptPrecedesFirstEffect proves creating is entered only\n55|// after its durable receipt: the backend's first effect observes the\n56|// committed receipt through the production entry.\n57|func TestExecuteReceiptPrecedesFirstEffect(t *testing.T) {\n58|\tbackend := newMockBackend()\n59|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n60|\tcontext, params, source, admitted := quiesceFixture(t)\n61|\tbackend.effectHandler = func(effect terminalbackend.SideEffect) (string, error) {\n62|\t\tif _, found, err := engine.Store.Lookup(context.IdempotencyKey); err != nil || !found {\n63|\t\t\tt.Errorf(\"Lookup(key) inside first effect = (%v, %v), want the committed receipt\", found, err)\n64|\t\t}\n65|\t\tif _, found, err := engine.Store.Completed(context.IdempotencyKey); err != nil || found {\n66|\t\t\tt.Errorf(\"Completed(key) inside first effect = (%v, %v), want no completion yet\", found, err)\n67|\t\t}\n68|\t\treturn fixtureDigestA, nil\n69|\t}\n70|\tif _, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted); err != nil {\n71|\t\tt.Fatalf(\"ExecuteMutating() error = %v\", err)\n72|\t}\n73|}\n74|\n75|// TestExecuteInterimState proves creating is entered only by create:\n76|// the AfterReceipt hook observes creating for create and the source\n77|// for every other engine operation.\n78|func TestExecuteInterimState(t *testing.T) {\n79|\trequireLiteral(t, \"create interim\", string(InterimState(terminalbackend.OperationCreate, mustParseState(t, \"absent\"))), \"creating\")\n80|\tfor _, operation := range []terminalbackend.Operation{\n81|\t\tterminalbackend.OperationQuiesceInput, terminalbackend.OperationWaitSafeBoundary, terminalbackend.OperationRequestStop,\n82|\t} {\n83|\t\tif got := InterimState(operation, mustParseState(t, \"active\")); got != terminalbackend.StateActive {\n84|\t\t\tt.Errorf(\"InterimState(%s) = %q, want the source\", operation, got)\n85|\t\t}\n86|\t}\n87|\n88|\tbackend := newMockBackend()\n89|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n90|\tvar interims []terminalbackend.InstanceState\n91|\tengine.Hooks = &EngineHooks{AfterReceipt: func(_ terminalbackend.Operation, _ string, interim terminalbackend.InstanceState) {\n92|\t\tinterims = append(interims, interim)\n93|\t}}\n94|\tcontext, params, source, admitted := quiesceFixture(t)\n95|\tif _, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted); err != nil {\n96|\t\tt.Fatalf(\"ExecuteMutating() error = %v\", err)\n97|\t}\n98|\tif len(interims) != 1 || interims[0] != terminalbackend.StateActive {\n99|\t\tt.Errorf(\"interims = %v, want [active]\", interims)\n100|\t}\n101|\n102|\tcreate := testCreateContext(t)\n103|\tbackendCreate := newMockBackend()\n104|\tengineCreate := testEngine(t, backendCreate, testLease(), fixtureGen)\n105|\tvar createInterims []terminalbackend.InstanceState\n106|\tengineCreate.Hooks = &EngineHooks{AfterReceipt: func(_ terminalbackend.Operation, _ string, interim terminalbackend.InstanceState) {\n107|\t\tcreateInterims = append(createInterims, interim)\n108|\t}}\n109|\tif _, err := engineCreate.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, create.context, create.params, mustParseState(t, \"absent\"), testAdmitted(\"terminal_state_retention\")); err != nil {\n110|\t\tt.Fatalf(\"ExecuteMutating(create) error = %v\", err)\n111|\t}\n112|\tif len(createInterims) != 1 || createInterims[0] != terminalbackend.StateCreating {\n113|\t\tt.Errorf(\"create interims = %v, want [creating]\", createInterims)\n114|\t}\n115|}\n116|\n117|type createFixture struct {\n118|\tcontext MutationContext\n119|\tparams  Params\n120|}\n121|\n122|func testCreateContext(t *testing.T) createFixture {\n123|\tt.Helper()\n124|\tauth, err := ParseAXAuthorization([]byte(authDoc(\"1\", map[string]*string{\"authorization_kind\": strptr(`\"create\"`)})))\n125|\tif err != nil {\n126|\t\tt.Fatalf(\"ParseAXAuthorization(create) error = %v\", err)\n127|\t}\n128|\tkey := fixtureSessionA + \"/\" + fixtureBootstrap\n129|\traw := contextDoc(fixtureOperation, fixtureSessionA, fixtureInstance, fixtureBackend, fixtureImpl, fixtureProto, fixtureGen, key, fixtureDeadline, authDoc(\"1\", map[string]*string{\"authorization_kind\": strptr(`\"create\"`)}))\n130|\tcontext, err := ParseMutationContext([]byte(raw))\n131|\tif err != nil {\n132|\t\tt.Fatalf(\"ParseMutationContext(create) error = %v\", err)\n133|\t}\n134|\t_ = auth\n135|\treturn createFixture{context: context, params: Params{BootstrapOperationID: fixtureBootstrap, Interactive: true}}\n136|}\n137|\n138|// TestExecuteCreateReceiptRule drives the create receipt rule: absent →\n139|// active when interactive with binding_persisted and wrapper_started,\n140|// stopped → parked when headless, and headless without\n141|// headless_creation refuses with the capability class.\n142|func TestExecuteCreateReceiptRule(t *testing.T) {\n143|\tcreate := testCreateContext(t)\n144|\tbackend := newMockBackend()\n145|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n146|\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, create.context, create.params, mustParseState(t, \"absent\"), testAdmitted(\"terminal_state_retention\"))\n147|\tif err != nil {\n148|\t\tt.Fatalf(\"ExecuteMutating(create interactive) error = %v\", err)\n149|\t}\n150|\trequireLiteral(t, \"after\", string(result.After), \"active\")\n151|\trequireLiteral(t, \"disposition\", string(result.Disposition), \"replay_same\")\n152|\tperformed := backend.performed()\n153|\tif len(performed) != 2 || performed[0] != terminalbackend.EffectBindingPersisted || performed[1] != terminalbackend.EffectWrapperStarted {\n154|\t\tt.Errorf(\"performed = %v, want [binding_persisted wrapper_started]\", performed)\n155|\t}\n156|\n157|\theadless := testCreateContext(t)\n158|\theadless.params.Interactive = false\n159|\tbackendHeadless := newMockBackend()\n160|\tengineHeadless := testEngine(t, backendHeadless, testLease(), fixtureGen)\n161|\tresult, err = engineHeadless.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, headless.context, headless.params, mustParseState(t, \"stopped\"), testAdmitted(\"headless_creation\"))\n162|\tif err != nil {\n163|\t\tt.Fatalf(\"ExecuteMutating(create headless) error = %v\", err)\n164|\t}\n165|\trequireLiteral(t, \"after\", string(result.After), \"parked\")\n166|\n167|\tbackendBare := newMockBackend()\n168|\tengineBare := testEngine(t, backendBare, testLease(), fixtureGen)\n169|\tfresh := testCreateContext(t)\n170|\tfresh.context.OperationID = fixtureOperationB\n171|\tfresh.params.Interactive = false\n172|\t_, err = engineBare.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, fresh.context, fresh.params, mustParseState(t, \"stopped\"), testAdmitted(\"terminal_state_retention\"))\n173|\trequireRefusal(t, err, \"terminal_backend_capability_unproven\", \"operation capability conditional\")\n174|\tif len(backendBare.performed()) != 0 {\n175|\t\tt.Errorf(\"performed = %v, want no effects on the refused create\", backendBare.performed())\n176|\t}\n177|}\n178|\n179|// TestExecutePreEffectErrorsRestoreSource proves an error before the\n180|// first side effect restores the source state: entry auth failure,\n181|// entry generation staleness, entry deadline expiry and a coded\n182|// backend refusal on the single quiesce effect each return after equal\n183|// to the source with the class-mapped disposition.\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
