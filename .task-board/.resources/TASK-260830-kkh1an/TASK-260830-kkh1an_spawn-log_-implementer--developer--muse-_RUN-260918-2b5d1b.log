{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d345","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":2045,"recorded_at":1780531400004085,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"call_id":"call_01a0b2401ee2716196a079a4555345fe","text":"Read text file `internal/terminstance/bodies_test.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|)\n7|\n8|func quiesceBody() string {\n9|\treturn `{\"context\":` + contextDoc(fixtureOperation, fixtureSessionA, fixtureInstance, fixtureBackend, fixtureImpl, fixtureProto, fixtureGen, quiesceKey(), fixtureDeadline, authDoc(\"1\", nil)) + `,\"quiescence_generation\":\"` + fixtureQuiescence + `\"}`\n10|}\n11|\n12|func waitBody() string {\n13|\tkey := fixtureInstance + \"/boundary/\" + fixtureQuiescence + \"/provider_quiescence\"\n14|\treturn `{\"context\":` + contextDoc(fixtureOperation, fixtureSessionA, fixtureInstance, fixtureBackend, fixtureImpl, fixtureProto, fixtureGen, key, fixtureDeadline, authDoc(\"1\", nil)) + `,\"quiescence_generation\":\"` + fixtureQuiescence + `\",\"provider_proof_kind\":\"provider_quiescence\",\"timeout_ms\":1000}`\n15|}\n16|\n17|func stopBody() string {\n18|\tkey := fixtureInstance + \"/stop/\" + fixtureDigestB\n19|\treturn `{\"context\":` + contextDoc(fixtureOperation, fixtureSessionA, fixtureInstance, fixtureBackend, fixtureImpl, fixtureProto, fixtureGen, key, fixtureDeadline, authDoc(\"1\", nil)) + `,\"safe_boundary_evidence_id\":\"` + fixtureDigestB + `\",\"graceful_timeout_ms\":1000}`\n20|}\n21|\n22|// TestParseOperationBodyAdmitsRows drives the three closed operation\n23|// bodies through the production entry and asserts the parsed members\n24|// literally, including the carried key equal to the row material.\n25|func TestParseOperationBodyAdmitsRows(t *testing.T) {\n26|\tcontext, params, err := ParseOperationBody(\"quiesce-input\", []byte(quiesceBody()))\n27|\tif err != nil {\n28|\t\tt.Fatalf(\"ParseOperationBody(quiesce-input) error = %v\", err)\n29|\t}\n30|\trequireLiteral(t, \"quiescence_generation\", params.QuiescenceGeneration, \"0198f4c8-8e50-7f66-8f70-ddddddddddd1\")\n31|\trequireLiteral(t, \"quiesce key\", context.IdempotencyKey, \"0198f4c8-8e50-7f66-8f70-bbbbbbbbbbb1/quiesce/0198f4c8-8e50-7f66-8f70-ddddddddddd1\")\n32|\n33|\tcontext, params, err = ParseOperationBody(\"wait-safe-boundary\", []byte(waitBody()))\n34|\tif err != nil {\n35|\t\tt.Fatalf(\"ParseOperationBody(wait-safe-boundary) error = %v\", err)\n36|\t}\n37|\trequireLiteral(t, \"proof kind\", string(params.ProviderProofKind), \"provider_quiescence\")\n38|\tif params.TimeoutMs != 1000 {\n39|\t\tt.Errorf(\"timeout_ms = %d, want 1000\", params.TimeoutMs)\n40|\t}\n41|\n42|\tcontext, params, err = ParseOperationBody(\"request-stop\", []byte(stopBody()))\n43|\tif err != nil {\n44|\t\tt.Fatalf(\"ParseOperationBody(request-stop) error = %v\", err)\n45|\t}\n46|\trequireLiteral(t, \"stop evidence\", params.SafeBoundaryEvidenceID, \"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\")\n47|\tif params.GracefulTimeoutMs != 1000 {\n48|\t\tt.Errorf(\"graceful_timeout_ms = %d, want 1000\", params.GracefulTimeoutMs)\n49|\t}\n50|}\n51|\n52|// TestParseOperationBodyRefusals drives the body member arms: wrong\n53|// member sets, bad nested generations, bad proof kinds, out-of-bound\n54|// timeouts (including the AX number model at timeout_ms) and bad stop\n55|// evidence.\n56|func TestParseOperationBodyRefusals(t *testing.T) {\n57|\textra := strings.Replace(quiesceBody(), `\"quiescence_generation\"`, `\"trace_id\":\"x\",\"quiescence_generation\"`, 1)\n58|\t_, _, err := ParseOperationBody(\"quiesce-input\", []byte(extra))\n59|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"operation body members\")\n60|\n61|\t_, _, err = ParseOperationBody(\"quiesce-input\", []byte(`[1]`))\n62|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"operation body frame\")\n63|\n64|\tbadGen := strings.Replace(quiesceBody(), `\"quiescence_generation\":\"`+fixtureQuiescence+`\"`, `\"quiescence_generation\":\"nope\"`, 1)\n65|\t_, _, err = ParseOperationBody(\"quiesce-input\", []byte(badGen))\n66|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"quiescence generation\")\n67|\n68|\tbadProof := strings.Replace(waitBody(), `\"provider_proof_kind\":\"provider_quiescence\"`, `\"provider_proof_kind\":\"provider_restart\"`, 1)\n69|\t_, _, err = ParseOperationBody(\"wait-safe-boundary\", []byte(badProof))\n70|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"provider proof vocabulary\")\n71|\n72|\tfor _, timeout := range []string{\"0\", \"3600001\", \"1.5\", \"1e3\", `\"1000\"`, \"null\", \"-5\"} {\n73|\t\tbad := strings.Replace(waitBody(), `\"timeout_ms\":1000`, `\"timeout_ms\":`+timeout, 1)\n74|\t\t_, _, err = ParseOperationBody(\"wait-safe-boundary\", []byte(bad))\n75|\t\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"wait timeout bound\")\n76|\t}\n77|\tfor _, timeout := range []string{\"1\", \"3600000\"} {\n78|\t\tgood := strings.Replace(waitBody(), `\"timeout_ms\":1000`, `\"timeout_ms\":`+timeout, 1)\n79|\t\tif _, _, err := ParseOperationBody(\"wait-safe-boundary\", []byte(good)); err != nil {\n80|\t\t\tt.Errorf(\"ParseOperationBody(wait timeout %s) error = %v, want admission\", timeout, err)\n81|\t\t}\n82|\t}\n83|\n84|\tbadEvidence := strings.Replace(stopBody(), `\"safe_boundary_evidence_id\":\"`+fixtureDigestB+`\"`, `\"safe_boundary_evidence_id\":\"not-a-digest\"`, 1)\n85|\t_, _, err = ParseOperationBody(\"request-stop\", []byte(badEvidence))\n86|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"stop boundary evidence\")\n87|\n88|\tbadStopTimeout := strings.Replace(stopBody(), `\"graceful_timeout_ms\":1000`, `\"graceful_timeout_ms\":0`, 1)\n89|\t_, _, err = ParseOperationBody(\"request-stop\", []byte(badStopTimeout))\n90|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"stop timeout bound\")\n91|\n92|\t// A body whose carried key disagrees with its own material is\n93|\t// internally inconsistent even though every member parses.\n94|\twrongKey := strings.Replace(quiesceBody(), quiesceKey(), fixtureInstance+\"/quiesce/\"+fixtureSessionB, 1)\n95|\t_, _, err = ParseOperationBody(\"quiesce-input\", []byte(wrongKey))\n96|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"idempotency key material\")\n97|}\n98|\n99|// TestParseOperationBodyScopeGate proves operations outside the engine\n100|// rows are refused at the production body entry.\n101|func TestParseOperationBodyScopeGate(t *testing.T) {\n102|\tfor _, operation := range []string{\"status\", \"create\", \"attach\", \"restore\", \"terminate-stale\", \"manifest\", \"probe\"} {\n103|\t\t_, _, err := ParseOperationBody(operation, []byte(quiesceBody()))\n104|\t\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"operation lifecycle scope\")\n105|\t}\n106|\t_, _, err := ParseOperationBody(\"launch\", []byte(quiesceBody()))\n107|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"operation vocabulary\")\n108|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
