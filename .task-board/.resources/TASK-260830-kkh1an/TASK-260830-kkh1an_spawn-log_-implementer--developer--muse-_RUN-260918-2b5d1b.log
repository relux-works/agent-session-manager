horization bad epoch\", \"authorization\", authDoc(\"0\", nil), \"terminal_backend_protocol_error\", \"ax authorization epoch\"},\n80|\t}\n81|\tfor _, tc := range cases {\n82|\t\tt.Run(tc.name, func(t *testing.T) {\n83|\t\t\t_, err := ParseMutationContext([]byte(build(tc.member, tc.raw)))\n84|\t\t\trequireRefusal(t, err, tc.code, tc.detail)\n85|\t\t})\n86|\t}\n87|}\n88|\n89|// TestParseMutationContextGenerationBound256Multibyte proves the bound\n90|// counts characters, not bytes: 256 two-byte characters are admitted in\n91|// the context body.\n92|func TestParseMutationContextGenerationBound256Multibyte(t *testing.T) {\n93|\tgeneration := strings.Repeat(\"é\", 256)\n94|\traw := contextDoc(fixtureOperation, fixtureSessionA, fixtureInstance, fixtureBackend, fixtureImpl, fixtureProto, generation, quiesceKey(), fixtureDeadline, authDoc(\"1\", nil))\n95|\tcontext, err := ParseMutationContext([]byte(raw))\n96|\tif err != nil {\n97|\t\tt.Fatalf(\"ParseMutationContext(256 chars) error = %v\", err)\n98|\t}\n99|\trequireLiteral(t, \"backend_generation\", context.BackendGeneration, generation)\n100|\n101|\ttooLong := strings.Repeat(\"é\", 257)\n102|\traw = contextDoc(fixtureOperation, fixtureSessionA, fixtureInstance, fixtureBackend, fixtureImpl, fixtureProto, tooLong, quiesceKey(), fixtureDeadline, authDoc(\"1\", nil))\n103|\t_, err = ParseMutationContext([]byte(raw))\n104|\trequireRefusal(t, err, \"terminal_backend_stale_generation\", \"backend_generation bound\")\n105|}\n106|\n107|// TestParseMutationContextClosedShape proves the closed context: unknown\n108|// and missing members refuse, and frame violations never decode.\n109|func TestParseMutationContextClosedShape(t *testing.T) {\n110|\tbase := contextDoc(fixtureOperation, fixtureSessionA, fixtureInstance, fixtureBackend, fixtureImpl, fixtureProto, fixtureGen, quiesceKey(), fixtureDeadline, authDoc(\"1\", nil))\n111|\textra := strings.Replace(base, `\"authorization\":`, `\"trace_id\":\"smuggled\",\"authorization\":`, 1)\n112|\t_, err := ParseMutationContext([]byte(extra))\n113|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"mutation context members\")\n114|\n115|\t_, err = ParseMutationContext([]byte(`[1]`))\n116|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"mutation context frame\")\n117|\n118|\t_, err = ParseMutationContext([]byte(base + ` `))\n119|\tif err != nil {\n120|\t\tt.Fatalf(\"ParseMutationContext(trailing whitespace) error = %v\", err)\n121|\t}\n122|}\n123|\n124|// TestCheckMutationContextGenerationBound proves the Go-level generation\n125|// bound through the production entry: a hand-built context carrying a\n126|// 257-character generation refuses with the landed stale class.\n127|func TestCheckMutationContextGenerationBound(t *testing.T) {\n128|\tcontext := testContext(t)\n129|\ttampered := context\n130|\ttampered.BackendGeneration = strings.Repeat(\"g\", 257)\n131|\terr := CheckMutationContext(terminalbackend.OperationQuiesceInput, tampered, testParams())\n132|\trequireRefusal(t, err, \"terminal_backend_stale_generation\", \"backend_generation bound\")\n133|}\n134|\n135|// TestKeySegmentsDerivesRowMaterial proves the exact idempotency key\n136|// material per engine row through the production derivation, with the\n137|// pinned UTF-8 infix literals.\n138|func TestKeySegmentsDerivesRowMaterial(t *testing.T) {\n139|\tcontext := testContext(t)\n140|\tquiesce, err := KeySegments(terminalbackend.OperationQuiesceInput, context, testParams())\n141|\tif err != nil {\n142|\t\tt.Fatalf(\"KeySegments(quiesce-input) error = %v\", err)\n143|\t}\n144|\trequireLiteral(t, \"quiesce key\", quiesce, fixtureInstance+\"/quiesce/\"+fixtureQuiescence)\n145|\n146|\twait, err := KeySegments(terminalbackend.OperationWaitSafeBoundary, context, Params{QuiescenceGeneration: fixtureQuiescence, ProviderProofKind: ProofProviderQuiescence})\n147|\tif err != nil {\n148|\t\tt.Fatalf(\"KeySegments(wait-safe-boundary) error = %v\", err)\n149|\t}\n150|\trequireLiteral(t, \"wait key\", wait, fixtureInstance+\"/boundary/\"+fixtureQuiescence+\"/provider_quiescence\")\n151|\n152|\tstop, err := KeySegments(terminalbackend.OperationRequestStop, context, Params{SafeBoundaryEvidenceID: fixtureDigestB})\n153|\tif err != nil {\n154|\t\tt.Fatalf(\"KeySegments(request-stop) error = %v\", err)\n155|\t}\n156|\trequireLiteral(t, \"stop key\", stop, fixtureInstance+\"/stop/\"+fixtureDigestB)\n157|\n158|\tcreate, err := KeySegments(terminalbackend.OperationCreate, context, Params{BootstrapOperationID: fixtureBootstrap})\n159|\tif err != nil {\n160|\t\tt.Fatalf(\"KeySegments(create) error = %v\", err)\n161|\t}\n162|\trequireLiteral(t, \"create key\", create, fixtureSessionA+\"/\"+fixtureBootstrap)\n163|\n164|\tif _, err := KeySegments(terminalbackend.OperationStatus, context, testParams()); err == nil {\n165|\t\tt.Error(\"KeySegments(status) = nil, want the scope refusal\")\n166|\t} else {\n167|\t\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"operation lifecycle scope\")\n168|\t}\n169|}\n170|\n171|// TestCheckMutationContextKeyMaterial proves a carried key that differs\n172|// from the canonical material is internally inconsistent: wrong infix,\n173|// wrong order and wrong generation all refuse through the production\n174|// entry with the protocol class, never mismatch (mismatch is the store\n175|// seam's verdict, not this gate's).\n176|func TestCheckMutationContextKeyMaterial(t *testing.T) {\n177|\tcontext := testContext(t)\n178|\tif err := CheckMutationContext(terminalbackend.OperationQuiesceInput, context, testParams()); err != nil {\n179|\t\tt.Fatalf(\"CheckMutationContext() error = %v\", err)\n180|\t}\n181|\tbadKeys := []string{\n182|\t\tfixtureInstance + \"/quiesce-wrong/\" + fixtureQuiescence,\n183|\t\tfixtureQuiescence + \"/quiesce/\" + fixtureInstance,\n184|\t\tfixtureInstance + \"/quiesce/\" + fixtureSessionB,\n185|\t\tfixtureInstance + \"/quiesce/\" + fixtureQuiescence + \"/extra\",\n186|\t}\n187|\tfor _, key := range badKeys {\n188|\t\ttampered := context\n189|\t\ttampered.IdempotencyKey = key\n190|\t\terr := CheckMutationContext(terminalbackend.OperationQuiesceInput, tampered, testParams())\n191|\t\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"idempotency key material\")\n192|\t}\n193|}\n194|\n195|// TestCheckMutationContextParams proves the per-operation parameter arms:\n196|// bootstrap and quiescence generations are UUIDv7, proof kinds parse,\n197|// timeouts lie in [1..3600000] and the stop evidence is a digest.\n198|func TestCheckMutationContextParams(t *testing.T) {\n199|\tcontext := testContext(t)\n200|\tcreate := context\n201|\tcreate.IdempotencyKey = fixtureSessionA + \"/\" + fixtureBootstrap\n202|\tif err := CheckMutationContext(terminalbackend.OperationCreate, create, Params{BootstrapOperationID: fixtureBootstrap}); err != nil {\n203|\t\tt.Fatalf(\"CheckMutationContext(create) error = %v\", err)\n204|\t}\n205|\tif err := CheckMutationContext(terminalbackend.OperationCreate, create, Params{BootstrapOperationID: \"nope\"}); err == nil {\n206|\t\tt.Error(\"CheckMutationContext(create bad bootstrap) = nil, want refusal\")\n207|\t}\n208|\n209|\twait := context\n210|\twait.IdempotencyKey = fixtureInstance + \"/boundary/\" + fixtureQuiescence + \"/ax_checkpoint_boundary\"\n211|\twaitParams := Params{QuiescenceGeneration: fixtureQuiescence, ProviderProofKind: ProofAXCheckpointBoundary, TimeoutMs: 3600000}\n212|\tif err := CheckMutationContext(terminalbackend.OperationWaitSafeBoundary, wait, waitParams); err != nil {\n213|\t\tt.Fatalf(\"CheckMutationContext(wait) error = %v\", err)\n214|\t}\n215|\tbad := waitParams\n216|\tbad.TimeoutMs = 0\n217|\trequireRefusal(t, CheckMutationContext(terminalbackend.OperationWaitSafeBoundary, wait, bad), \"terminal_backend_protocol_error\", \"wait timeout bound\")\n218|\tbad = waitParams\n219|\tbad.TimeoutMs = 3600001\n220|\trequireRefusal(t, CheckMutationContext(terminalbackend.OperationWaitSafeBoundary, wait, bad), \"terminal_backend_protocol_error\", \"wait timeout bound\")\n221|\tbad = waitParams\n222|\tbad.ProviderProofKind = \"provider_restart\"\n223|\trequireRefusal(t, CheckMutationContext(terminalbackend.OperationWaitSafeBoundary, wait, bad), \"terminal_backend_protocol_error\", \"provider proof vocabulary\")\n224|\n225|\tstop := context\n226|\tstop.IdempotencyKey = fixtureInstance + \"/stop/\" + fixtureDigestB\n227|\tstopParams := Params{SafeBoundaryEvidenceID: fixtureDigestB, GracefulTimeoutMs: 1}\n228|\tif err := CheckMutationContext(terminalbackend.OperationRequestStop, stop, stopParams); err != nil {\n229|\t\tt.Fatalf(\"CheckMutationContext(request-stop) error = %v\", err)\n230|\t}\n231|\tbadStop := stopParams\n232|\tbadStop.SafeBoundaryEvidenceID = \"not-a-digest\"\n233|\trequireRefusal(t, CheckMutationContext(terminalbackend.OperationRequestStop, stop, badStop), \"terminal_backend_protocol_error\", \"stop boundary evidence\")\n234|\tbadStop = stopParams\n235|\tbadStop.GracefulTimeoutMs = 0\n236|\trequireRefusal(t, CheckMutationContext(terminalbackend.OperationRequestStop, stop, badStop), \"terminal_backend_protocol_error\", \"stop timeout bound\")\n237|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
