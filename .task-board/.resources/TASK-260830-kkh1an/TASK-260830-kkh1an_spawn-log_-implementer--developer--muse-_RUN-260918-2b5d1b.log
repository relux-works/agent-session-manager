solved.md','w').write(resolved)\\nraw = resolved.encode('utf-8')\\nsha = hashlib.sha256(raw).hexdigest()\\nb64 = base64.b64encode(raw).decode('ascii')\\n\\ntpl = json.load(open('/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/base-refresh/replay-563536699/resolution-template.json'))\\ntpl['resolutions'] = [{\\n  'checkpoint_oid': 'e6fe5c553f00b0e3df6b13759a60123ead967fbe',\\n  'path': 'LOGBOOK.md',\\n  'sha256': sha,\\n  'content': b64,\\n}]\\njson.dump(tpl, open('/tmp/replay-resolutions.json','w'), indent=2)\\nprint('sha256:', sha)\\nprint('bytes:', len(raw))\\nprint('blocks:', len(block_0918.splitlines()), len(block_0917.splitlines()))\\n# sanity: newest-first order of ### headers at top\\nfor ln in resolved.splitlines()[:22]:\\n    if ln.startswith('##'):\\n        print(repr(ln))\\nEOF\\npython3 /tmp/build_resolution.py\",\n  \"description\": \"Build LOGBOOK full-replacement resolution JSON\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"sha256: 20f1369d1756ba5d5ae4b566e76637d9e7d1d85dc6f980ad4deb2934a0da7071\\nbytes: 521487\\nblocks: 17 18\\n'## 2026-09-18'\\n'### STORY-260830-4qojoz (mesh-rpc-framing-and-negotiation) — final leaf TASK-260830-19bjfj rev2: adversarial closure on the adopted v0.7.0 registry'\\n'### TASK-260830-1geqhj rev4 — ax pane rework: fold-only newest, resumed-checkpoint closure, replay signal'\\n\",\n  \"original_output_bytes\": 379,\n  \"original_output_tokens\": 95,\n  \"truncated\": false\n}","final_result":true}}}
