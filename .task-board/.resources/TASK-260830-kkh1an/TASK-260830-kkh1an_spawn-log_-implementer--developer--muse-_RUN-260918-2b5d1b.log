{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000caf3","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":980,"recorded_at":1780531400001955,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"task_stream":{"kind":"task","id":"01a0b237-040d-7810-8dde-1557ce2b4ab3"},"task_id":"01a0b237-040d-7810-8dde-1557ce2b4ab3","event":{"kind":"output","task_id":"01a0b237-040d-7810-8dde-1557ce2b4ab3","chunk":"Read text file `internal/terminstance/context.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n9|)\n10|\n11|// MutationContext is the closed §4.C MutationContext object: exactly\n12|// operation_id, session_id, terminal_instance_id, terminal_backend_id,\n13|// implementation_version, protocol_version, backend_generation,\n14|// idempotency_key, deadline_at and authorization. Every mutating request\n15|// carries it.\n16|type MutationContext struct {\n17|\tOperationID           string\n18|\tSessionID             string\n19|\tTerminalInstanceID    string\n20|\tTerminalBackendID     string\n21|\tImplementationVersion string\n22|\tProtocolVersion       string\n23|\tBackendGeneration     string\n24|\tIdempotencyKey        string\n25|\tDeadline              scalar.Timestamp\n26|\tAuthorization         AXAuthorization\n27|}\n28|\n29|// mutationContextMembers is the exact closed member set, in the order the\n30|// pinned section lists it.\n31|var mutationContextMembers = []string{\n32|\t\"operation_id\",\n33|\t\"session_id\",\n34|\t\"terminal_instance_id\",\n35|\t\"terminal_backend_id\",\n36|\t\"implementation_version\",\n37|\t\"protocol_version\",\n38|\t\"backend_generation\",\n39|\t\"idempotency_key\",\n40|\t\"deadline_at\",\n41|\t\"authorization\",\n42|}\n43|\n44|// ParseMutationContext admits one closed MutationContext document. The\n45|// nested authorization is admitted by the shared\n46|// parseAXAuthorizationObject arms, never a second implementation.\n47|// Malformed documents are terminal_backend_protocol_error (AX-local\n48|// parse); semantic binding (key material, version tuple, generation\n49|// staleness) is CheckMutationContext, not this function.\n50|func ParseMutationContext(raw []byte) (MutationContext, error) {\n51|\tmembers, fault := environ.DecodeStrictObject(raw)\n52|\tif fault != nil {\n53|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context frame\")\n54|\t}\n55|\treturn parseMutationContextObject(members)\n56|}\n57|\n58|// parseMutationContextObject admits one already-framed context member map.\n59|// ParseMutationContext and ParseOperationBody share it so the nested\n60|// context inside an operation body is admitted by the same arms.\n61|func parseMutationContextObject(members map[string]json.RawMessage) (MutationContext, error) {\n62|\tif len(members) != len(mutationContextMembers) {\n63|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context members\")\n64|\t}\n65|\tfor _, member := range mutationContextMembers {\n66|\t\tif _, known := members[member]; !known {\n67|\t\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context members\")\n68|\t\t}\n69|\t}\n70|\toperationID, ok := environ.CheckUUIDv7(members[\"operation_id\"])\n71|\tif !ok {\n72|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context operation\")\n73|\t}\n74|\tsessionID, ok := environ.CheckUUIDv7(members[\"session_id\"])\n75|\tif !ok {\n76|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context session\")\n77|\t}\n78|\tinstanceID, ok := environ.CheckUUIDv7(members[\"terminal_instance_id\"])\n79|\tif !ok {\n80|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context instance\")\n81|\t}\n82|\tbackendID, ok := rawString(members[\"terminal_backend_id\"])\n83|\tif !ok {\n84|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context backend\")\n85|\t}\n86|\tif _, err := terminalbackend.ParseID(backendID); err != nil {\n87|\t\treturn MutationContext{}, wrapLanded(err)\n88|\t}\n89|\timplementationVersion, ok := rawString(members[\"implementation_version\"])\n90|\tif !ok {\n91|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context versions\")\n92|\t}\n93|\tprotocolVersion, ok := rawString(members[\"protocol_version\"])\n94|\tif !ok {\n95|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context versions\")\n96|\t}\n97|\tif err := checkVersionTuple(backendID, implementationVersion, protocolVersion); err != nil {\n98|\t\treturn MutationContext{}, err\n99|\t}\n100|\tgeneration, ok := environ.CheckStringBounds(members[\"backend_generation\"], 1, 256)\n101|\tif !ok {\n102|\t\treturn MutationContext{}, refuse(CodeStaleGeneration, \"backend_generation bound\")\n103|\t}\n104|\tidempotencyKey, ok := environ.CheckStringBounds(members[\"idempotency_key\"], 1, 256)\n105|\tif !ok {\n106|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context key bound\")\n107|\t}\n108|\tdeadline, ok := environ.CheckTimestamp(members[\"deadline_at\"])\n109|\tif !ok {\n110|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context deadline\")\n111|\t}\n112|\tauthMembers, fault := environ.DecodeStrictObject(members[\"authorization\"])\n113|\tif fault != nil {\n114|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context authorization\")\n115|\t}\n116|\tauthorization, err := parseAXAuthorizationObject(authMembers)\n117|\tif err != nil {\n118|\t\treturn MutationContext{}, err\n119|\t}\n120|\treturn MutationContext{\n121|\t\tOperationID:           operationID.String(),\n122|\t\tSessionID:             sessionID.String(),\n123|\t\tTerminalInstanceID:    instanceID.String(),\n124|\t\tTerminalBackendID:     backendID,\n125|\t\tImplementationVersion: implementationVersion,\n126|\t\tProtocolVersion:       protocolVersion,\n127|\t\tBackendGeneration:     generation,\n128|\t\tIdempotencyKey:        idempotencyKey,\n129|\t\tDeadline:              deadline,\n130|\t\tAuthorization:         authorization,\n131|\t}, nil\n132|}\n133|\n134|// checkVersionTuple enforces the operation-body version rule:\n135|// implementation_version is semver and protocol_version is semver in\n136|// Terminal Backend Protocol major 1. It delegates both arms to the\n137|// landed CheckVersionTuple with the carried protocol version as the\n138|// membership list: membership against the admitted probe list is the\n139|// registry's business at admission (landed RequireRestoreBinding,\n140|// CheckVersionTuple, Reconcile), so the operation gate contributes only\n141|// the grammar and major arms and states that bound explicitly instead of\n142|// re-deriving the saturating major or the semver grammar.\n143|func checkVersionTuple(backendID, implementationVersion, protocolVersion string) error {\n144|\tif err := terminalbackend.CheckVersionTuple(backendID, implementationVersion, protocolVersion, []string{protocolVersion}); err != nil {\n145|\t\treturn wrapLanded(err)\n146|\t}\n147|\treturn nil\n148|}\n149|\n150|// checkGenerationBound enforces string[1..256] in characters over valid\n151|// UTF-8 on a Go-level generation value by delegating to the landed\n152|// GenerationDigest bound arm; the digest half is discarded because §4.C\n153|// results carry the raw string, not its digest. The refusal class is the\n154|// landed terminal_backend_stale_generation, never a fresh code.\n155|func checkGenerationBound(generation string) error {\n156|\tif _, err := terminalbackend.GenerationDigest(generation); err != nil {\n157|\t\treturn wrapLanded(err)\n158|\t}\n159|\treturn nil\n160|}\n161|\n162|// KeySegments derives the canonical idempotency key for one engine\n163|// operation from its identity material through the landed IdempotencyKey\n164|// shapes. The infix literals are fixed per row, never caller input: a\n165|// carried key that differs from the derived material is internally\n166|// inconsistent and refused as terminal_backend_protocol_error, while a\n167|// carried key that matches its material but collides with a different\n168|// bound operation in the store is idempotency_mismatch at the receipt\n169|// seam. create and restore share the (session, bootstrap) shape; only\n170|// create executes in this engine.\n171|func KeySegments(operation terminalbackend.Operation, context MutationContext, params Params) (string, error) {\n172|\tswitch operation {\n173|\tcase terminalbackend.OperationCreate:\n174|\t\treturn terminalbackend.IdempotencyKey(string(operation), context.SessionID, params.BootstrapOperationID)\n175|\tcase terminalbackend.OperationQuiesceInput:\n176|\t\treturn terminalbackend.IdempotencyKey(string(operation), context.TerminalInstanceID, \"quiesce\", params.QuiescenceGeneration)\n177|\tcase terminalbackend.OperationWaitSafeBoundary:\n178|\t\treturn terminalbackend.IdempotencyKey(string(operation), context.TerminalInstanceID, \"boundary\", params.QuiescenceGeneration, string(params.ProviderProofKind))\n179|\tcase terminalbackend.OperationRequestStop:\n180|\t\treturn terminalbackend.IdempotencyKey(string(operation), context.TerminalInstanceID, \"stop\", params.SafeBoundaryEvidenceID)\n181|\tdefault:\n182|\t\treturn \"\", refuse(CodeProtocolError, \"operation lifecycle scope\")\n183|\t}\n184|}\n185|\n186|// CheckMutationContext enforces the semantic half of the mutating-request\n187|// contract for one already-parsed context: the carried key equals the\n188|// canonical material for the operation and the Go-level values re-admit\n189|// through their landed gates, so a hand-built context cannot bypass the\n190|// document arms. Generation staleness against the validated binding is\n191|// the engine's per-effect recheck, not this function.\n192|func CheckMutationContext(operation terminalbackend.Operation, context MutationContext, params Params) error {\n193|\tif _, err := terminalbackend.ParseOperation(string(operation)); err != nil {\n194|\t\treturn wrapLanded(err)\n195|\t}\n196|\tif _, err := scalar.ParseUUIDv7(context.OperationID); err != nil {\n197|\t\treturn refuse(CodeProtocolError, \"mutation context operation\")\n198|\t}\n199|\tif _, err := scalar.ParseUUIDv7(context.SessionID); err != nil {\n200|\t\treturn refuse(CodeProtocolError, \"mutation context session\")\n201|\t}\n202|\tif _, err := scalar.ParseUUIDv7(context.TerminalInstanceID); err != nil {\n203|\t\treturn refuse(CodeProtocolError, \"mutation context instance\")\n204|\t}\n205|\tif _, err := terminalbackend.ParseID(context.TerminalBackendID); err != nil {\n206|\t\treturn wrapLanded(err)\n207|\t}\n208|\tif err := checkVersionTuple(context.TerminalBackendID, context.ImplementationVersion, context.ProtocolVersion); err != nil {\n209|\t\treturn err\n210|\t}\n211|\tif err := checkGenerationBound(context.BackendGeneration); err != nil {\n212|\t\treturn err\n213|\t}\n214|\tif err := checkParams(operation, params); err != nil {\n215|\t\treturn err\n216|\t}\n217|\tif _, err := context.Deadline.Time(); err != nil {\n218|\t\treturn refuse(CodeProtocolError, \"mutation context deadline\")\n219|\t}\n220|\tderived, err := KeySegments(operation, context, params)\n221|\tif err != nil {\n222|\t\treturn err\n223|\t}\n224|\tif context.IdempotencyKey != derived {\n225|\t\treturn refuse(CodeProtocolError, \"idempotency key material\")\n226|\t}\n227|\treturn nil\n228|}\n229|\n230|// checkParams validates the per-operation parameters: quiescence\n231|// generations are UUIDv7, proof kinds parse, timeouts lie in\n232|// uint53[1..3600000] and the stop evidence is a digest.\n233|func checkParams(operation terminalbackend.Operation, params Params) error {\n234|\tswitch operation {\n235|\tcase terminalbackend.OperationCreate:\n236|\t\tif _, err := scalar.ParseUUIDv7(params.BootstrapOperationID); err != nil {\n237|\t\t\treturn refuse(CodeProtocolError, \"mutation context bootstrap\")\n238|\t\t}\n239|\t\treturn nil\n240|\tcase terminalbackend.OperationQuiesceInput:\n241|\t\tif _, err := scalar.ParseUUIDv7(params.QuiescenceGeneration); err != nil {\n242|\t\t\treturn refuse(CodeProtocolError, \"quiescence generation\")\n243|\t\t}\n244|\t\treturn nil\n245|\tcase terminalbackend.OperationWaitSafeBoundary:\n246|\t\tif _, err := scalar.ParseUUIDv7(params.QuiescenceGeneration); err != nil {\n247|\t\t\treturn refuse(CodeProtocolError, \"quiescence generation\")\n248|\t\t}\n249|\t\tif _, err := ParseProviderProofKind(string(params.ProviderProofKind)); err != nil {\n250|\t\t\treturn err\n251|\t\t}\n252|\t\tif params.TimeoutMs < 1 || params.TimeoutMs > 3600000 {\n253|\t\t\treturn refuse(CodeProtocolError, \"wait timeout bound\")\n254|\t\t}\n255|\t\treturn nil\n256|\tcase terminalbackend.OperationRequestStop:\n257|\t\tif _, err := scalar.ParseDigest(params.SafeBoundaryEvidenceID); err != nil {\n258|\t\t\treturn refuse(CodeProtocolError, \"stop boundary evidence\")\n259|\t\t}\n260|\t\tif params.GracefulTimeoutMs < 1 || params.GracefulTimeoutMs > 3600000 {\n261|\t\t\treturn refuse(CodeProtocolError, \"stop timeout bound\")\n262|\t\t}\n263|\t\treturn nil\n264|\tdefault:\n265|\t\treturn refuse(CodeProtocolError, \"operation lifecycle scope\")\n266|\t}\n267|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000caf5","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":981,"recorded_at":1780531400001957,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"task_stream":{"kind":"task","id":"01a0b237-040d-7810-8dde-1557ce2b4ab3"},"task_id":"01a0b237-040d-7810-8dde-1557ce2b4ab3","event":{"kind":"completed","task_id":"01a0b237-040d-7810-8dde-1557ce2b4ab3"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000caf7","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":982,"recorded_at":1780531400001959,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"call_id":"call_01a0b236fee473e5aca902386f29207d","text":"Read text file `internal/terminstance/disposition.go`.\n1|package terminstance\n2|\n3|// RetryDisposition is the closed §4.C retry disposition enum. Every\n4|// result carries exactly one.\n5|type RetryDisposition string\n6|\n7|// Retry dispositions.\n8|const (\n9|\tDispositionReplaySame             RetryDisposition = \"replay_same\"\n10|\tDispositionStatusFirst            RetryDisposition = \"status_first\"\n11|\tDispositionNewAuthorization       RetryDisposition = \"new_authorization\"\n12|\tDispositionRequiredOperatorAction RetryDisposition = \"required_operator_action\"\n13|)\n14|\n15|// ParseRetryDisposition admits exactly the four §4.C dispositions.\n16|func ParseRetryDisposition(value string) (RetryDisposition, error) {\n17|\tswitch RetryDisposition(value) {\n18|\tcase DispositionReplaySame, DispositionStatusFirst,\n19|\t\tDispositionNewAuthorization, DispositionRequiredOperatorAction:\n20|\t\treturn RetryDisposition(value), nil\n21|\tdefault:\n22|\t\treturn \"\", refuse(CodeProtocolError, \"retry disposition vocabulary\")\n23|\t}\n24|}\n25|\n26|// DispositionFor maps a terminal failure code to its retry disposition.\n27|// committed reports whether any side effect committed before the failure:\n28|// an error before the first effect restores the source state and may be\n29|// retried or refused by class, while an error after a committed effect\n30|// whose result cannot be proven funnels to status_first, because only a\n31|// successful status read proves what happened. The spec pins the\n32|// disposition vocabulary but not the per-code mapping, so this mapping is\n33|// the leaf's contract, pinned literally per arm:\n34|//\n35|//   - terminal_backend_unauthorized names its own remedy in both cases:\n36|//     the lease moved or lapsed and status cannot fix auth.\n37|//   - terminal_backend_timeout and quiesce_timeout are clean before any\n38|//     commit (retry the identical wait) and uncertain after one.\n39|//   - stop_timeout, idempotency_mismatch, terminal_backend_stale_generation,\n40|//     local_precondition_failed and terminal_backend_unavailable always\n41|//     route through status: a stop wait, a window conflict, a drifted\n42|//     generation, a refused precondition and an unserved backend all\n43|//     require a fresh observation before any retry.\n44|//   - terminal_backend_capability_unproven,\n45|//     terminal_backend_integrity_failure, terminal_backend_process_failed,\n46|//     terminal_backend_protocol_error and any unknown code stop automation\n47|//     before any commit (an operator must prove the capability, heal the\n48|//     backend, or fix the caller) and route through status after one,\n49|//     because the committed effect's result is then unproven.\n50|//\n51|// A code the row forbids never reaches here: the engine routes backend\n52|// reports through CheckErrorAllowed first, so the default arm below fires\n53|// only for an uncoded failure the engine classified itself.\n54|func DispositionFor(code string, committed bool) RetryDisposition {\n55|\tswitch code {\n56|\tcase CodeUnauthorized:\n57|\t\treturn DispositionNewAuthorization\n58|\tcase CodeTimeout, CodeQuiesceTimeout:\n59|\t\tif committed {\n60|\t\t\treturn DispositionStatusFirst\n61|\t\t}\n62|\t\treturn DispositionReplaySame\n63|\tcase CodeStopTimeout, CodeIdempotencyMismatch, CodeStaleGeneration,\n64|\t\tCodePreconditionFailed, CodeUnavailable:\n65|\t\treturn DispositionStatusFirst\n66|\tdefault:\n67|\t\tif committed {\n68|\t\t\treturn DispositionStatusFirst\n69|\t\t}\n70|\t\treturn DispositionRequiredOperatorAction\n71|\t}\n72|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000caf9","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":983,"recorded_at":1780531400001961,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"call_id":"call_01a0b2370017770fbd68b820f9c0cdfe","text":"Read text file `internal/terminstance/proof.go`.\n1|package terminstance\n2|\n3|// ProviderProofKind is the closed §4.C ProviderProofKind enum.\n4|type ProviderProofKind string\n5|\n6|// Provider proof kinds.\n7|const (\n8|\tProofProviderQuiescence   ProviderProofKind = \"provider_quiescence\"\n9|\tProofProviderProcessExit  ProviderProofKind = \"provider_process_exit\"\n10|\tProofAXCheckpointBoundary ProviderProofKind = \"ax_checkpoint_boundary\"\n11|)\n12|\n13|// ParseProviderProofKind admits exactly the three §4.C proof kinds.\n14|func ParseProviderProofKind(value string) (ProviderProofKind, error) {\n15|\tswitch ProviderProofKind(value) {\n16|\tcase ProofProviderQuiescence, ProofProviderProcessExit, ProofAXCheckpointBoundary:\n17|\t\treturn ProviderProofKind(value), nil\n18|\tdefault:\n19|\t\treturn \"\", refuse(CodeProtocolError, \"provider proof vocabulary\")\n20|\t}\n21|}\n22|\n23|// RequiresProviderObservation reports whether the proof kind is a provider\n24|// kind: provider_quiescence and provider_process_exit observe the provider\n25|// process and additionally require the provider_process_observation\n26|// capability, while ax_checkpoint_boundary is an AX-side boundary and\n27|// requires only safe_boundary_observation.\n28|func RequiresProviderObservation(kind ProviderProofKind) bool {\n29|\tswitch kind {\n30|\tcase ProofProviderQuiescence, ProofProviderProcessExit:\n31|\t\treturn true\n32|\tdefault:\n33|\t\treturn false\n34|\t}\n35|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cafb","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":984,"recorded_at":1780531400001963,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"call_id":"call_01a0b23701a371e3a96e499e54400d28","text":"Read text file `internal/terminstance/context.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n9|)\n10|\n11|// MutationContext is the closed §4.C MutationContext object: exactly\n12|// operation_id, session_id, terminal_instance_id, terminal_backend_id,\n13|// implementation_version, protocol_version, backend_generation,\n14|// idempotency_key, deadline_at and authorization. Every mutating request\n15|// carries it.\n16|type MutationContext struct {\n17|\tOperationID           string\n18|\tSessionID             string\n19|\tTerminalInstanceID    string\n20|\tTerminalBackendID     string\n21|\tImplementationVersion string\n22|\tProtocolVersion       string\n23|\tBackendGeneration     string\n24|\tIdempotencyKey        string\n25|\tDeadline              scalar.Timestamp\n26|\tAuthorization         AXAuthorization\n27|}\n28|\n29|// mutationContextMembers is the exact closed member set, in the order the\n30|// pinned section lists it.\n31|var mutationContextMembers = []string{\n32|\t\"operation_id\",\n33|\t\"session_id\",\n34|\t\"terminal_instance_id\",\n35|\t\"terminal_backend_id\",\n36|\t\"implementation_version\",\n37|\t\"protocol_version\",\n38|\t\"backend_generation\",\n39|\t\"idempotency_key\",\n40|\t\"deadline_at\",\n41|\t\"authorization\",\n42|}\n43|\n44|// ParseMutationContext admits one closed MutationContext document. The\n45|// nested authorization is admitted by the shared\n46|// parseAXAuthorizationObject arms, never a second implementation.\n47|// Malformed documents are terminal_backend_protocol_error (AX-local\n48|// parse); semantic binding (key material, version tuple, generation\n49|// staleness) is CheckMutationContext, not this function.\n50|func ParseMutationContext(raw []byte) (MutationContext, error) {\n51|\tmembers, fault := environ.DecodeStrictObject(raw)\n52|\tif fault != nil {\n53|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context frame\")\n54|\t}\n55|\treturn parseMutationContextObject(members)\n56|}\n57|\n58|// parseMutationContextObject admits one already-framed context member map.\n59|// ParseMutationContext and ParseOperationBody share it so the nested\n60|// context inside an operation body is admitted by the same arms.\n61|func parseMutationContextObject(members map[string]json.RawMessage) (MutationContext, error) {\n62|\tif len(members) != len(mutationContextMembers) {\n63|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context members\")\n64|\t}\n65|\tfor _, member := range mutationContextMembers {\n66|\t\tif _, known := members[member]; !known {\n67|\t\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context members\")\n68|\t\t}\n69|\t}\n70|\toperationID, ok := environ.CheckUUIDv7(members[\"operation_id\"])\n71|\tif !ok {\n72|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context operation\")\n73|\t}\n74|\tsessionID, ok := environ.CheckUUIDv7(members[\"session_id\"])\n75|\tif !ok {\n76|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context session\")\n77|\t}\n78|\tinstanceID, ok := environ.CheckUUIDv7(members[\"terminal_instance_id\"])\n79|\tif !ok {\n80|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context instance\")\n81|\t}\n82|\tbackendID, ok := rawString(members[\"terminal_backend_id\"])\n83|\tif !ok {\n84|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context backend\")\n85|\t}\n86|\tif _, err := terminalbackend.ParseID(backendID); err != nil {\n87|\t\treturn MutationContext{}, wrapLanded(err)\n88|\t}\n89|\timplementationVersion, ok := rawString(members[\"implementation_version\"])\n90|\tif !ok {\n91|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context versions\")\n92|\t}\n93|\tprotocolVersion, ok := rawString(members[\"protocol_version\"])\n94|\tif !ok {\n95|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context versions\")\n96|\t}\n97|\tif err := checkVersionTuple(backendID, implementationVersion, protocolVersion); err != nil {\n98|\t\treturn MutationContext{}, err\n99|\t}\n100|\tgeneration, ok := environ.CheckStringBounds(members[\"backend_generation\"], 1, 256)\n101|\tif !ok {\n102|\t\treturn MutationContext{}, refuse(CodeStaleGeneration, \"backend_generation bound\")\n103|\t}\n104|\tidempotencyKey, ok := environ.CheckStringBounds(members[\"idempotency_key\"], 1, 256)\n105|\tif !ok {\n106|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context key bound\")\n107|\t}\n108|\tdeadline, ok := environ.CheckTimestamp(members[\"deadline_at\"])\n109|\tif !ok {\n110|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context deadline\")\n111|\t}\n112|\tauthMembers, fault := environ.DecodeStrictObject(members[\"authorization\"])\n113|\tif fault != nil {\n114|\t\treturn MutationContext{}, refuse(CodeProtocolError, \"mutation context authorization\")\n115|\t}\n116|\tauthorization, err := parseAXAuthorizationObject(authMembers)\n117|\tif err != nil {\n118|\t\treturn MutationContext{}, err\n119|\t}\n120|\treturn MutationContext{\n121|\t\tOperationID:           operationID.String(),\n122|\t\tSessionID:             sessionID.String(),\n123|\t\tTerminalInstanceID:    instanceID.String(),\n124|\t\tTerminalBackendID:     backendID,\n125|\t\tImplementationVersion: implementationVersion,\n126|\t\tProtocolVersion:       protocolVersion,\n127|\t\tBackendGeneration:     generation,\n128|\t\tIdempotencyKey:        idempotencyKey,\n129|\t\tDeadline:              deadline,\n130|\t\tAuthorization:         authorization,\n131|\t}, nil\n132|}\n133|\n134|// checkVersionTuple enforces the operation-body version rule:\n135|// implementation_version is semver and protocol_version is semver in\n136|// Terminal Backend Protocol major 1. It delegates both arms to the\n137|// landed CheckVersionTuple with the carried protocol version as the\n138|// membership list: membership against the admitted probe list is the\n139|// registry's business at admission (landed RequireRestoreBinding,\n140|// CheckVersionTuple, Reconcile), so the operation gate contributes only\n141|// the grammar and major arms and states that bound explicitly instead of\n142|// re-deriving the saturating major or the semver grammar.\n143|func checkVersionTuple(backendID, implementationVersion, protocolVersion string) error {\n144|\tif err := terminalbackend.CheckVersionTuple(backendID, implementationVersion, protocolVersion, []string{protocolVersion}); err != nil {\n145|\t\treturn wrapLanded(err)\n146|\t}\n147|\treturn nil\n148|}\n149|\n150|// checkGenerationBound enforces string[1..256] in characters over valid\n151|// UTF-8 on a Go-level generation value by delegating to the landed\n152|// GenerationDigest bound arm; the digest half is discarded because §4.C\n153|// results carry the raw string, not its digest. The refusal class is the\n154|// landed terminal_backend_stale_generation, never a fresh code.\n155|func checkGenerationBound(generation string) error {\n156|\tif _, err := terminalbackend.GenerationDigest(generation); err != nil {\n157|\t\treturn wrapLanded(err)\n158|\t}\n159|\treturn nil\n160|}\n161|\n162|// KeySegments derives the canonical idempotency key for one engine\n163|// operation from its identity material through the landed IdempotencyKey\n164|// shapes. The infix literals are fixed per row, never caller input: a\n165|// carried key that differs from the derived material is internally\n166|// inconsistent and refused as terminal_backend_protocol_error, while a\n167|// carried key that matches its material but collides with a different\n168|// bound operation in the store is idempotency_mismatch at the receipt\n169|// seam. create and restore share the (session, bootstrap) shape; only\n170|// create executes in this engine.\n171|func KeySegments(operation terminalbackend.Operation, context MutationContext, params Params) (string, error) {\n172|\tswitch operation {\n173|\tcase terminalbackend.OperationCreate:\n174|\t\treturn terminalbackend.IdempotencyKey(string(operation), context.SessionID, params.BootstrapOperationID)\n175|\tcase terminalbackend.OperationQuiesceInput:\n176|\t\treturn terminalbackend.IdempotencyKey(string(operation), context.TerminalInstanceID, \"quiesce\", params.QuiescenceGeneration)\n177|\tcase terminalbackend.OperationWaitSafeBoundary:\n178|\t\treturn terminalbackend.IdempotencyKey(string(operation), context.TerminalInstanceID, \"boundary\", params.QuiescenceGeneration, string(params.ProviderProofKind))\n179|\tcase terminalbackend.OperationRequestStop:\n180|\t\treturn terminalbackend.IdempotencyKey(string(operation), context.TerminalInstanceID, \"stop\", params.SafeBoundaryEvidenceID)\n181|\tdefault:\n182|\t\treturn \"\", refuse(CodeProtocolError, \"operation lifecycle scope\")\n183|\t}\n184|}\n185|\n186|// CheckMutationContext enforces the semantic half of the mutating-request\n187|// contract for one already-parsed context: the carried key equals the\n188|// canonical material for the operation and the Go-level values re-admit\n189|// through their landed gates, so a hand-built context cannot bypass the\n190|// document arms. Generation staleness against the validated binding is\n191|// the engine's per-effect recheck, not this function.\n192|func CheckMutationContext(operation terminalbackend.Operation, context MutationContext, params Params) error {\n193|\tif _, err := terminalbackend.ParseOperation(string(operation)); err != nil {\n194|\t\treturn wrapLanded(err)\n195|\t}\n196|\tif _, err := scalar.ParseUUIDv7(context.OperationID); err != nil {\n197|\t\treturn refuse(CodeProtocolError, \"mutation context operation\")\n198|\t}\n199|\tif _, err := scalar.ParseUUIDv7(context.SessionID); err != nil {\n200|\t\treturn refuse(CodeProtocolError, \"mutation context session\")\n201|\t}\n202|\tif _, err := scalar.ParseUUIDv7(context.TerminalInstanceID); err != nil {\n203|\t\treturn refuse(CodeProtocolError, \"mutation context instance\")\n204|\t}\n205|\tif _, err := terminalbackend.ParseID(context.TerminalBackendID); err != nil {\n206|\t\treturn wrapLanded(err)\n207|\t}\n208|\tif err := checkVersionTuple(context.TerminalBackendID, context.ImplementationVersion, context.ProtocolVersion); err != nil {\n209|\t\treturn err\n210|\t}\n211|\tif err := checkGenerationBound(context.BackendGeneration); err != nil {\n212|\t\treturn err\n213|\t}\n214|\tif err := checkParams(operation, params); err != nil {\n215|\t\treturn err\n216|\t}\n217|\tif _, err := context.Deadline.Time(); err != nil {\n218|\t\treturn refuse(CodeProtocolError, \"mutation context deadline\")\n219|\t}\n220|\tderived, err := KeySegments(operation, context, params)\n221|\tif err != nil {\n222|\t\treturn err\n223|\t}\n224|\tif context.IdempotencyKey != derived {\n225|\t\treturn refuse(CodeProtocolError, \"idempotency key material\")\n226|\t}\n227|\treturn nil\n228|}\n229|\n230|// checkParams validates the per-operation parameters: quiescence\n231|// generations are UUIDv7, proof kinds parse, timeouts lie in\n232|// uint53[1..3600000] and the stop evidence is a digest.\n233|func checkParams(operation terminalbackend.Operation, params Params) error {\n234|\tswitch operation {\n235|\tcase terminalbackend.OperationCreate:\n236|\t\tif _, err := scalar.ParseUUIDv7(params.BootstrapOperationID); err != nil {\n237|\t\t\treturn refuse(CodeProtocolError, \"mutation context bootstrap\")\n238|\t\t}\n239|\t\treturn nil\n240|\tcase terminalbackend.OperationQuiesceInput:\n241|\t\tif _, err := scalar.ParseUUIDv7(params.QuiescenceGeneration); err != nil {\n242|\t\t\treturn refuse(CodeProtocolError, \"quiescence generation\")\n243|\t\t}\n244|\t\treturn nil\n245|\tcase terminalbackend.OperationWaitSafeBoundary:\n246|\t\tif _, err := scalar.ParseUUIDv7(params.QuiescenceGeneration); err != nil {\n247|\t\t\treturn refuse(CodeProtocolError, \"quiescence generation\")\n248|\t\t}\n249|\t\tif _, err := ParseProviderProofKind(string(params.ProviderProofKind)); err != nil {\n250|\t\t\treturn err\n251|\t\t}\n252|\t\tif params.TimeoutMs < 1 || params.TimeoutMs > 3600000 {\n253|\t\t\treturn refuse(CodeProtocolError, \"wait timeout bound\")\n254|\t\t}\n255|\t\treturn nil\n256|\tcase terminalbackend.OperationRequestStop:\n257|\t\tif _, err := scalar.ParseDigest(params.SafeBoundaryEvidenceID); err != nil {\n258|\t\t\treturn refuse(CodeProtocolError, \"stop boundary evidence\")\n259|\t\t}\n260|\t\tif params.GracefulTimeoutMs < 1 || params.GracefulTimeoutMs > 3600000 {\n261|\t\t\treturn refuse(CodeProtocolError, \"stop timeout bound\")\n262|\t\t}\n263|\t\treturn nil\n264|\tdefault:\n265|\t\treturn refuse(CodeProtocolError, \"operation lifecycle scope\")\n266|\t}\n267|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
