{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d223","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":1900,"recorded_at":1780531400003795,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"task_stream":{"kind":"task","id":"01a0b23e-4315-7012-a537-5a9ef563647d"},"task_id":"01a0b23e-4315-7012-a537-5a9ef563647d","event":{"kind":"output","task_id":"01a0b23e-4315-7012-a537-5a9ef563647d","chunk":"Read text file `internal/terminstance/crash_unix_test.go`.\n1|//go:build darwin || linux\n2|\n3|package terminstance\n4|\n5|import (\n6|\t\"context\"\n7|\t\"errors\"\n8|\t\"os\"\n9|\t\"os/exec\"\n10|\t\"syscall\"\n11|\t\"testing\"\n12|\t\"time\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n15|)\n16|\n17|// Real process-termination evidence for the idempotency receipt seam:\n18|// the child runs the genuine production ExecuteMutating entry and\n19|// SIGKILLs itself in the store AfterCommit hook, after the no-replace\n20|// receipt commit and before the first side effect. The parent then\n21|// proves creating was never entered before the durable receipt (the\n22|// pending receipt survived, the completion did not), the identical\n23|// retry refuses uncertain instead of replaying or inventing absence,\n24|// and the lost result recovers through status rather than absent.\n25|const (\n26|\tcrashChildEnv   = \"AX_TERMINSTANCE_CRASH_CHILD\"\n27|\tcrashChildStore = \"AX_TERMINSTANCE_CRASH_STORE\"\n28|)\n29|\n30|func TestExecuteCrashChildSelfTerminates(t *testing.T) {\n31|\tif os.Getenv(crashChildEnv) == \"1\" {\n32|\t\texecuteCrashChild(t)\n33|\t\treturn\n34|\t}\n35|\tstoreDir := t.TempDir()\n36|\tstore, err := OpenReceiptStore(storeDir)\n37|\tif err != nil {\n38|\t\tt.Fatal(err)\n39|\t}\n40|\t_ = store\n41|\tctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)\n42|\tdefer cancel()\n43|\tchild := exec.CommandContext(ctx, os.Args[0],\n44|\t\t\"-test.run=^TestExecuteCrashChildSelfTerminates$\",\n45|\t\t\"-test.count=1\",\n46|\t)\n47|\tchild.Env = append(os.Environ(),\n48|\t\tcrashChildEnv+\"=1\",\n49|\t\tcrashChildStore+\"=\"+storeDir,\n50|\t)\n51|\trunErr := child.Run()\n52|\tvar exitErr *exec.ExitError\n53|\tif !errors.As(runErr, &exitErr) {\n54|\t\tt.Fatalf(\"child run = %v, want a signal-kill exit\", runErr)\n55|\t}\n56|\tstatus, ok := exitErr.Sys().(syscall.WaitStatus)\n57|\tif !ok || !status.Signaled() || status.Signal() != syscall.SIGKILL {\n58|\t\tt.Fatalf(\"child status = %v, want killed by SIGKILL\", exitErr)\n59|\t}\n60|\n61|\treopened, err := OpenReceiptStore(storeDir)\n62|\tif err != nil {\n63|\t\tt.Fatal(err)\n64|\t}\n65|\tcontext := testContext(t)\n66|\treceipt, found, err := reopened.Lookup(context.IdempotencyKey)\n67|\tif err != nil {\n68|\t\tt.Fatalf(\"Lookup() after kill error = %v\", err)\n69|\t}\n70|\tif !found {\n71|\t\tt.Fatal(\"Lookup() after kill reports absence, want the committed receipt\")\n72|\t}\n73|\tif receipt.Operation != terminalbackend.OperationQuiesceInput || receipt.OperationID != fixtureOperation {\n74|\t\tt.Fatalf(\"Lookup() after kill = %+v, want the quiesce receipt\", receipt)\n75|\t}\n76|\tif _, found, err := reopened.Completed(context.IdempotencyKey); err != nil || found {\n77|\t\tt.Fatalf(\"Completed() after kill = (%v, %v), want no completion\", found, err)\n78|\t}\n79|\n80|\tbackend := newMockBackend()\n81|\tengine := &Engine{\n82|\t\tStore:             reopened,\n83|\t\tBackend:           backend,\n84|\t\tCurrentLease:      func() LeaseView { return testLease() },\n85|\t\tCurrentGeneration: func() string { return fixtureGen },\n86|\t\tNow:               fixtureNow,\n87|\t}\n88|\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, testParams(), mustParseState(t, \"active\"), testAdmitted(\"input_quiescence\"))\n89|\trequireRefusal(t, err, \"terminal_backend_unavailable\", \"idempotency result uncertain\")\n90|\trequireLiteral(t, \"after\", string(result.After), \"unavailable\")\n91|\trequireLiteral(t, \"disposition\", string(result.Disposition), \"status_first\")\n92|\tif len(backend.performed()) != 0 {\n93|\t\tt.Errorf(\"performed = %v, want no effects on the uncertain retry\", backend.performed())\n94|\t}\n95|\n96|\tbackend.observation = matchingObservation()\n97|\treport, err := engine.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n98|\tif err != nil {\n99|\t\tt.Fatalf(\"ExecuteStatus() after kill error = %v\", err)\n100|\t}\n101|\trequireLiteral(t, \"recovered state\", string(report.State), \"active\")\n102|}\n103|\n104|func executeCrashChild(t *testing.T) {\n105|\tt.Helper()\n106|\tstore, err := OpenReceiptStore(os.Getenv(crashChildStore))\n107|\tif err != nil {\n108|\t\tt.Fatalf(\"child OpenReceiptStore() error = %v\", err)\n109|\t}\n110|\tstore.WithHooks(&StoreHooks{\n111|\t\tAfterCommit: func(string) error {\n112|\t\t\tproc, err := os.FindProcess(os.Getpid())\n113|\t\t\tif err != nil {\n114|\t\t\t\tt.Fatalf(\"child find self: %v\", err)\n115|\t\t\t}\n116|\t\t\t_ = proc.Signal(syscall.SIGKILL)\n117|\t\t\tselect {}\n118|\t\t},\n119|\t})\n120|\tbackend := newMockBackend()\n121|\tengine := &Engine{\n122|\t\tStore:             store,\n123|\t\tBackend:           backend,\n124|\t\tCurrentLease:      func() LeaseView { return testLease() },\n125|\t\tCurrentGeneration: func() string { return fixtureGen },\n126|\t\tNow:               fixtureNow,\n127|\t}\n128|\t_, _ = engine.ExecuteMutating(context.Background(), terminalbackend.OperationQuiesceInput, testContext(t), testParams(), mustParseState(t, \"active\"), testAdmitted(\"input_quiescence\"))\n129|\tt.Fatal(\"child ExecuteMutating() returned past SIGKILL\")\n130|}","final_result":true}}}
