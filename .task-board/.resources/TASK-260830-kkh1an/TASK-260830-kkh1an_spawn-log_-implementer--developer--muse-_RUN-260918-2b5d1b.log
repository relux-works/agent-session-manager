{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb41","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":1019,"recorded_at":1780531400002033,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"task_stream":{"kind":"task","id":"01a0b237-11c9-7bc1-9551-87119f7abaef"},"task_id":"01a0b237-11c9-7bc1-9551-87119f7abaef","event":{"kind":"output","task_id":"01a0b237-11c9-7bc1-9551-87119f7abaef","chunk":"Read text file `internal/terminstance/status.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n10|)\n11|\n12|// StatusBody is the closed §4.C status request body: exactly session_id,\n13|// terminal_instance_id (UUIDv7 or null), terminal_backend_id,\n14|// implementation_version, protocol_version, backend_generation\n15|// (string[1..256] or null), include_provider_observation and deadline_at.\n16|// The instance and generation are either both null (Session-scoped\n17|// lookup) or both non-null (exact-instance lookup). Status carries no\n18|// authorization: its transition row authorizes none.\n19|type StatusBody struct {\n20|\tSessionID                  string\n21|\tTerminalInstanceID         string\n22|\tHasTerminalInstanceID      bool\n23|\tTerminalBackendID          string\n24|\tImplementationVersion      string\n25|\tProtocolVersion            string\n26|\tBackendGeneration          string\n27|\tHasBackendGeneration       bool\n28|\tIncludeProviderObservation bool\n29|\tDeadline                   scalar.Timestamp\n30|}\n31|\n32|// statusBodyMembers is the exact closed member set, in the order the\n33|// pinned section lists it.\n34|var statusBodyMembers = []string{\n35|\t\"session_id\",\n36|\t\"terminal_instance_id\",\n37|\t\"terminal_backend_id\",\n38|\t\"implementation_version\",\n39|\t\"protocol_version\",\n40|\t\"backend_generation\",\n41|\t\"include_provider_observation\",\n42|\t\"deadline_at\",\n43|}\n44|\n45|// ParseStatusBody admits one closed status body. Null is the explicit\n46|// JSON null only: missing, empty-string and wrong-typed members are\n47|// malformed, never null.\n48|func ParseStatusBody(raw []byte) (StatusBody, error) {\n49|\tmembers, fault := environ.DecodeStrictObject(raw)\n50|\tif fault != nil {\n51|\t\treturn StatusBody{}, refuse(CodeProtocolError, \"status body frame\")\n52|\t}\n53|\tif len(members) != len(statusBodyMembers) {\n54|\t\treturn StatusBody{}, refuse(CodeProtocolError, \"status body members\")\n55|\t}\n56|\tfor _, member := range statusBodyMembers {\n57|\t\tif _, known := members[member]; !known {\n58|\t\t\treturn StatusBody{}, refuse(CodeProtocolError, \"status body members\")\n59|\t\t}\n60|\t}\n61|\tsession, ok := environ.CheckUUIDv7(members[\"session_id\"])\n62|\tif !ok {\n63|\t\treturn StatusBody{}, refuse(CodeProtocolError, \"status body session\")\n64|\t}\n65|\tinstance, hasInstance, err := uuidOrNull(members[\"terminal_instance_id\"])\n66|\tif err != nil {\n67|\t\treturn StatusBody{}, refuse(CodeProtocolError, \"status body instance\")\n68|\t}\n69|\tbackendID, ok := rawString(members[\"terminal_backend_id\"])\n70|\tif !ok {\n71|\t\treturn StatusBody{}, refuse(CodeProtocolError, \"status body backend\")\n72|\t}\n73|\tif _, err := terminalbackend.ParseID(backendID); err != nil {\n74|\t\treturn StatusBody{}, wrapLanded(err)\n75|\t}\n76|\timplementationVersion, ok := rawString(members[\"implementation_version\"])\n77|\tif !ok {\n78|\t\treturn StatusBody{}, refuse(CodeProtocolError, \"status body versions\")\n79|\t}\n80|\tprotocolVersion, ok := rawString(members[\"protocol_version\"])\n81|\tif !ok {\n82|\t\treturn StatusBody{}, refuse(CodeProtocolError, \"status body versions\")\n83|\t}\n84|\tif err := checkVersionTuple(backendID, implementationVersion, protocolVersion); err != nil {\n85|\t\treturn StatusBody{}, err\n86|\t}\n87|\tgeneration, hasGeneration, err := generationOrNull(members[\"backend_generation\"])\n88|\tif err != nil {\n89|\t\treturn StatusBody{}, refuse(CodeStaleGeneration, \"backend_generation bound\")\n90|\t}\n91|\tif hasInstance != hasGeneration {\n92|\t\treturn StatusBody{}, refuse(CodeProtocolError, \"status identity scope\")\n93|\t}\n94|\tvar include bool\n95|\tif err := json.Unmarshal(members[\"include_provider_observation\"], &include); err != nil {\n96|\t\treturn StatusBody{}, refuse(CodeProtocolError, \"status body observation\")\n97|\t}\n98|\tdeadline, ok := environ.CheckTimestamp(members[\"deadline_at\"])\n99|\tif !ok {\n100|\t\treturn StatusBody{}, refuse(CodeProtocolError, \"status body deadline\")\n101|\t}\n102|\treturn StatusBody{\n103|\t\tSessionID:                  session.String(),\n104|\t\tTerminalInstanceID:         instance,\n105|\t\tHasTerminalInstanceID:      hasInstance,\n106|\t\tTerminalBackendID:          backendID,\n107|\t\tImplementationVersion:      implementationVersion,\n108|\t\tProtocolVersion:            protocolVersion,\n109|\t\tBackendGeneration:          generation,\n110|\t\tHasBackendGeneration:       hasGeneration,\n111|\t\tIncludeProviderObservation: include,\n112|\t\tDeadline:                   deadline,\n113|\t}, nil\n114|}\n115|\n116|// uuidOrNull reads a UUIDv7-or-null member: explicit JSON null reads\n117|// absent, a UUIDv7 string reads present, anything else is malformed.\n118|func uuidOrNull(raw json.RawMessage) (string, bool, error) {\n119|\tif isExplicitNull(raw) {\n120|\t\treturn \"\", false, nil\n121|\t}\n122|\tvalue, ok := rawString(raw)\n123|\tif !ok {\n124|\t\treturn \"\", false, refuse(CodeProtocolError, \"status body instance\")\n125|\t}\n126|\tparsed, err := scalar.ParseUUIDv7(value)\n127|\tif err != nil {\n128|\t\treturn \"\", false, refuse(CodeProtocolError, \"status body instance\")\n129|\t}\n130|\treturn parsed.String(), true, nil\n131|}\n132|\n133|// generationOrNull reads a string[1..256]-or-null member in characters\n134|// through the landed bound. A present but out-of-bound generation is the\n135|// landed terminal_backend_stale_generation class, matching the descriptor\n136|// and digest arms.\n137|func generationOrNull(raw json.RawMessage) (string, bool, error) {\n138|\tif isExplicitNull(raw) {\n139|\t\treturn \"\", false, nil\n140|\t}\n141|\tvalue, ok := environ.CheckStringBounds(raw, 1, 256)\n142|\tif !ok {\n143|\t\treturn \"\", false, refuse(CodeStaleGeneration, \"backend_generation bound\")\n144|\t}\n145|\treturn value, true, nil\n146|}\n147|\n148|// isExplicitNull reports whether the member is the explicit JSON null.\n149|// Only the null literal reads null: missing members never reach here\n150|// (the exact-member check owns absence) and every other literal is the\n151|// typed member the caller parses next.\n152|func isExplicitNull(raw json.RawMessage) bool {\n153|\treturn string(bytes.TrimSpace(raw)) == \"null\"\n154|}","final_result":true}}}
