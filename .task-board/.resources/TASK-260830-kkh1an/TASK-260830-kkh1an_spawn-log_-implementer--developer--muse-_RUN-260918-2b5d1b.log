{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cd63","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":1292,"recorded_at":1780531400002579,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"task_stream":{"kind":"task","id":"01a0b23b-c1f4-7f80-8c82-ef16f3ef3536"},"task_id":"01a0b23b-c1f4-7f80-8c82-ef16f3ef3536","event":{"kind":"output","task_id":"01a0b23b-c1f4-7f80-8c82-ef16f3ef3536","chunk":"Read text file `internal/terminalbackend/conformance.go`.\n(182 line(s) above)\n183|const (\n184|\tauthorizationNone       = \"none\"\n185|\tauthorizationCreate     = \"create\"\n186|\tauthorizationAttach     = \"attach\"\n187|\tauthorizationControl    = \"control\"\n188|\tauthorizationForceStale = \"force_stale\"\n189|\tauthorizationRestore    = \"restore\"\n190|)\n191|\n192|// Transition is one exact §4.C table row: the allowed sources, the success\n193|// target, and the exact side effects for one operation.\n194|type Transition struct {\n195|\tOperation     Operation\n196|\tSources       []InstanceState\n197|\tTarget        InstanceState\n198|\tTargetParked  bool\n199|\tEffects       []SideEffect\n200|\tAuthorization string\n201|\t// InstanceScoped is false for manifest and probe, which carry no\n202|\t// Terminal Instance source or target and no side effects.\n203|\tInstanceScoped bool\n204|\t// SameState marks status: every source is allowed and the success\n205|\t// state is the source itself, with no side effect.\n206|\tSameState bool\n207|}\n208|\n209|// transitionTable is the exact §4.C transition matrix. create carries two\n210|// targets: active when interactive, otherwise parked.\n211|var transitionTable = []Transition{\n212|\t{Operation: OperationManifest, InstanceScoped: false, Authorization: authorizationNone},\n213|\t{Operation: OperationProbe, InstanceScoped: false, Authorization: authorizationNone},\n214|\t{\n215|\t\tOperation: OperationCreate,\n216|\t\tSources:   []InstanceState{StateAbsent, StateStopped},\n217|\t\tTarget:    StateActive, TargetParked: true,\n218|\t\tEffects:        []SideEffect{EffectBindingPersisted, EffectWrapperStarted},\n219|\t\tAuthorization:  authorizationCreate,\n220|\t\tInstanceScoped: true,\n221|\t},\n222|\t{\n223|\t\tOperation:      OperationAttach,\n224|\t\tSources:        []InstanceState{StateParked, StateActive},\n225|\t\tTarget:         StateActive,\n226|\t\tEffects:        []SideEffect{EffectAttachClientCreated},\n227|\t\tAuthorization:  authorizationAttach,\n228|\t\tInstanceScoped: true,\n229|\t},\n230|\t{\n231|\t\tOperation: OperationStatus,\n232|\t\tSources: []InstanceState{\n233|\t\t\tStateAbsent, StateCreating, StateParked, StateActive,\n234|\t\t\tStateQuiescing, StateStopped, StateStaleFenced, StateUnavailable,\n235|\t\t},\n236|\t\tSameState:      true,\n237|\t\tAuthorization:  authorizationNone,\n238|\t\tInstanceScoped: true,\n239|\t},\n240|\t{\n241|\t\tOperation:      OperationQuiesceInput,\n242|\t\tSources:        []InstanceState{StateActive, StateParked},\n243|\t\tTarget:         StateQuiescing,\n244|\t\tEffects:        []SideEffect{EffectInputClosed},\n245|\t\tAuthorization:  authorizationControl,\n246|\t\tInstanceScoped: true,\n247|\t},\n248|\t{\n249|\t\tOperation:      OperationWaitSafeBoundary,\n250|\t\tSources:        []InstanceState{StateQuiescing},\n251|\t\tTarget:         StateQuiescing,\n252|\t\tEffects:        []SideEffect{EffectSafeBoundaryObserved},\n253|\t\tAuthorization:  authorizationControl,\n254|\t\tInstanceScoped: true,\n255|\t},\n256|\t{\n257|\t\tOperation:      OperationRequestStop,\n258|\t\tSources:        []InstanceState{StateQuiescing},\n259|\t\tTarget:         StateStopped,\n260|\t\tEffects:        []SideEffect{EffectGracefulStopRequested, EffectProcessClosed, EffectBackendStoreClosed},\n261|\t\tAuthorization:  authorizationControl,\n262|\t\tInstanceScoped: true,\n263|\t},\n264|\t{\n265|\t\tOperation:      OperationTerminateStale,\n266|\t\tSources:        []InstanceState{StateStaleFenced, StateUnavailable},\n267|\t\tTarget:         StateStopped,\n268|\t\tEffects:        []SideEffect{EffectStaleIncarnationTerminated, EffectProcessClosed},\n269|\t\tAuthorization:  authorizationForceStale,\n270|\t\tInstanceScoped: true,\n271|\t},\n272|\t{\n273|\t\tOperation:      OperationRestore,\n274|\t\tSources:        []InstanceState{StateAbsent, StateStopped, StateUnavailable},\n275|\t\tTarget:         StateParked,\n276|\t\tEffects:        []SideEffect{EffectBindingPersisted, EffectWrapperRestored},\n277|\t\tAuthorization:  authorizationRestore,\n278|\t\tInstanceScoped: true,\n279|\t},\n280|}\n281|\n282|// lookupTransition returns the table row for one operation.\n283|func lookupTransition(operation Operation) (Transition, bool) {\n284|\tfor _, row := range transitionTable {\n285|\t\tif row.Operation == operation {\n286|\t\t\treturn row, true\n287|\t\t}\n288|\t}\n289|\treturn Transition{}, false\n290|}\n291|\n292|// CheckTransition enforces the §4.C transition matrix. It returns the\n293|// success target state and the exact side effects. create resolves its\n294|// target from interactive: active when interactive, otherwise parked. A\n295|// state reached only by AX fencing observation (stale_fenced) is never\n296|// entered here: no backend operation targets it, so a row naming it as a\n297|// target cannot exist and CheckTransition cannot return it except as a\n298|// status observation of the source itself.\n299|//\n300|// An unknown operation or state is a protocol error; a known operation\n301|// against a disallowed source is a failed local precondition. Only\n302|// quiesce-input enters quiescing, and creating is never a success target:\n303|// it exists only between the idempotency receipt and the first side\n304|// effect, which the Ledger below owns.\n305|func CheckTransition(operation, source string, interactive bool) (InstanceState, []SideEffect, error) {\n306|\tparsedOperation, err := ParseOperation(operation)\n307|\tif err != nil {\n308|\t\treturn \"\", nil, err\n309|\t}\n310|\trow, known := lookupTransition(parsedOperation)\n311|\tif !known {\n312|\t\treturn \"\", nil, refuse(&Error{Code: CodeProtocolError, Detail: \"operation vocabulary\"})\n313|\t}\n314|\tif !row.InstanceScoped {\n315|\t\tif source != \"\" {\n316|\t\t\treturn \"\", nil, refuse(&Error{Code: CodePreconditionFailed, Detail: \"lifecycle instance scope\"})\n317|\t\t}\n318|\t\treturn \"\", nil, nil\n319|\t}\n320|\tparsedSource, err := ParseInstanceState(source)\n321|\tif err != nil {\n322|\t\treturn \"\", nil, err\n323|\t}\n324|\tallowed := false\n325|\tfor _, candidate := range row.Sources {\n326|\t\tif candidate == parsedSource {\n327|\t\t\tallowed = true\n328|\t\t\tbreak\n329|\t\t}\n330|\t}\n331|\tif !allowed {\n332|\t\treturn \"\", nil, refuse(&Error{Code: CodePreconditionFailed, Detail: \"lifecycle transition\"})\n333|\t}\n334|\tif row.SameState {\n335|\t\treturn parsedSource, nil, nil\n336|\t}\n337|\tif parsedOperation == OperationCreate && !interactive {\n338|\t\treturn StateParked, append([]SideEffect(nil), row.Effects...), nil\n339|\t}\n340|\treturn row.Target, append([]SideEffect(nil), row.Effects...), nil\n341|}\n342|\n343|// allowedOperationErrors is the exact §4.C \"Allowed error codes\" column.\n344|// An error not listed for an operation MUST NOT be emitted by the backend\n345|// for a syntactically valid request; AX-local parsing may additionally\n346|// emit terminal_backend_protocol_error, which every row therefore carries.\n347|var allowedOperationErrors = map[Operation][]string{\n348|\tOperationManifest: {\n349|\t\tCodeProtocolError, \"terminal_backend_protocol_incompatible\",\n350|\t\t\"terminal_backend_process_failed\", \"terminal_backend_timeout\",\n351|\t\tCodeIntegrityFailure,\n352|\t},\n353|\tOperationProbe: {\n354|\t\tCodeUntrusted, CodeMismatch, CodeDrift,\n355|\t\tCodeProtocolError, \"terminal_backend_process_failed\", \"terminal_backend_timeout\",\n356|\t\tCodeIntegrityFailure,\n357|\t},\n(more lines below)","final_result":true}}}
