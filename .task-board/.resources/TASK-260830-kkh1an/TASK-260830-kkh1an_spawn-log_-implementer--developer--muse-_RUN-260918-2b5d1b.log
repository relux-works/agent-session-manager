{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cd95","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":1317,"recorded_at":1780531400002629,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"task_stream":{"kind":"task","id":"01a0b23b-cd27-79d1-9bff-53fcd74d552e"},"task_id":"01a0b23b-cd27-79d1-9bff-53fcd74d552e","event":{"kind":"output","task_id":"01a0b23b-cd27-79d1-9bff-53fcd74d552e","chunk":"Read text file `internal/terminalbackend/conformance.go`.\n(356 line(s) above)\n357|\t},\n358|\tOperationCreate: {\n359|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n360|\t\tCodeStaleGeneration, CodeCapabilityUnproven, CodeUnavailable,\n361|\t\t\"terminal_backend_timeout\", \"terminal_backend_process_failed\",\n362|\t\tCodeIntegrityFailure, CodeProtocolError,\n363|\t},\n364|\tOperationAttach: {\n365|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n366|\t\tCodeStaleGeneration, CodeCapabilityUnproven, CodeUnavailable,\n367|\t\t\"terminal_backend_timeout\", \"terminal_backend_process_failed\",\n368|\t\tCodeIntegrityFailure, CodeProtocolError,\n369|\t},\n370|\tOperationStatus: {\n371|\t\tCodeStaleGeneration, CodeCapabilityUnproven, CodeUnavailable,\n372|\t\t\"terminal_backend_timeout\", CodeIntegrityFailure, CodeProtocolError,\n373|\t},\n374|\tOperationQuiesceInput: {\n375|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n376|\t\tCodeStaleGeneration, CodeCapabilityUnproven,\n377|\t\t\"terminal_backend_timeout\", CodeIntegrityFailure, CodeProtocolError,\n378|\t},\n379|\tOperationWaitSafeBoundary: {\n380|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n381|\t\tCodeStaleGeneration, CodeCapabilityUnproven,\n382|\t\t\"quiesce_timeout\", CodeIntegrityFailure, CodeProtocolError,\n383|\t},\n384|\tOperationRequestStop: {\n385|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n386|\t\tCodeStaleGeneration, CodeCapabilityUnproven,\n387|\t\t\"stop_timeout\", \"terminal_backend_process_failed\",\n388|\t\tCodeIntegrityFailure, CodeProtocolError,\n389|\t},\n390|\tOperationTerminateStale: {\n391|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n392|\t\tCodeStaleGeneration, CodeCapabilityUnproven,\n393|\t\t\"terminal_backend_timeout\", \"terminal_backend_process_failed\",\n394|\t\tCodeIntegrityFailure, CodeProtocolError,\n395|\t},\n396|\tOperationRestore: {\n397|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n398|\t\tCodeStaleGeneration, CodeCapabilityUnproven, CodeRestoreMismatch,\n399|\t\tCodeUnavailable, \"terminal_backend_timeout\", \"terminal_backend_process_failed\",\n400|\t\tCodeIntegrityFailure, CodeProtocolError,\n401|\t},\n402|}\n403|\n404|// CheckErrorAllowed enforces the §4.C error mapping: a backend reporting a\n405|// code outside the operation's allowed set violates the contract, and the\n406|// report itself is refused as a protocol error. It names the production\n407|// reporting site, not the underlying failure.\n408|func CheckErrorAllowed(operation, code string) error {\n409|\tparsedOperation, err := ParseOperation(operation)\n410|\tif err != nil {\n411|\t\treturn err\n412|\t}\n413|\tfor _, allowed := range allowedOperationErrors[parsedOperation] {\n414|\t\tif code == allowed {\n415|\t\t\treturn nil\n416|\t\t}\n417|\t}\n418|\treturn refuse(&Error{Code: CodeProtocolError, Detail: \"operation error vocabulary\"})\n419|}\n420|\n421|// IdempotencyKey derives the canonical UTF-8 idempotency key for one\n422|// operation from its identity segments (§4.C authorization and idempotency\n423|// column, §4.1 bootstrap binding). The key is never caller-chosen free\n424|// text: the segment count and order are fixed per operation, and every\n425|// segment must be non-empty.\n426|//\n427|// The per-operation forms are: manifest and probe take the request ID\n428|// alone; create and restore take session_id + bootstrap_operation_id;\n429|// attach takes terminal_instance_id + client_id; quiesce-input takes\n430|// terminal_instance_id + \"quiesce\" + quiescence_generation;\n431|// wait-safe-boundary takes terminal_instance_id + \"boundary\" +\n432|// quiescence_generation + provider_proof_kind; request-stop takes\n433|// terminal_instance_id + \"stop\" + safe_boundary_evidence_id;\n434|// terminate-stale takes terminal_instance_id + \"terminate\" +\n435|// stale_lease_id + decimal stale_epoch; status takes its full queried\n436|// identity tuple, of at least one segment.\n437|func IdempotencyKey(operation string, segments ...string) (string, error) {\n438|\tparsedOperation, err := ParseOperation(operation)\n439|\tif err != nil {\n440|\t\treturn \"\", err\n441|\t}\n442|\tfor _, segment := range segments {\n443|\t\tif segment == \"\" {\n444|\t\t\treturn \"\", refuse(&Error{Code: CodeProtocolError, Detail: \"idempotency key shape\"})\n445|\t\t}\n446|\t}\n447|\twant := idempotencyKeySegments[parsedOperation]\n448|\tif want < 0 {\n449|\t\tif len(segments) < 1 {\n450|\t\t\treturn \"\", refuse(&Error{Code: CodeProtocolError, Detail: \"idempotency key shape\"})\n451|\t\t}\n452|\t} else if len(segments) != want {\n453|\t\treturn \"\", refuse(&Error{Code: CodeProtocolError, Detail: \"idempotency key shape\"})\n454|\t}\n455|\treturn strings.Join(segments, \"/\"), nil\n456|}\n457|\n458|// idempotencyKeySegments is the fixed per-operation segment count. status\n459|// carries its full queried identity tuple, so its count varies and only\n460|// the non-empty floor is enforced.\n461|var idempotencyKeySegments = map[Operation]int{\n462|\tOperationManifest: 1, OperationProbe: 1,\n463|\tOperationCreate: 2, OperationRestore: 2, OperationAttach: 2,\n464|\tOperationQuiesceInput: 3, OperationRequestStop: 3,\n465|\tOperationWaitSafeBoundary: 4, OperationTerminateStale: 4,\n466|\tOperationStatus: -1,\n467|}\n468|\n469|// Receipt is one durably bound idempotency record: the canonical key, the\n470|// operation it was bound for, and the recorded result identity. AX and the\n471|// backend bind the pair before the first child side effect (§4.1); an\n472|// identical retry returns the recorded result instead of acting again.\n473|type Receipt struct {\n474|\tKey       string\n475|\tOperation Operation\n476|\tResultID  string\n477|}\n478|\n479|// Ledger is the process-local idempotency receipt table backing the §4.C\n480|// recovery rules: persist the receipt before the first side effect,\n481|// identical retry replays it, a changed operation in the window is\n482|// idempotency_mismatch, and uncertainty requires status before any start\n483|// retry. The zero value is unusable; construct with NewLedger.\n484|//\n485|// The ledger is the semantic half of durability: Export and Import move\n486|// the table across a controller crash as stable bytes, and Import refuses\n487|// a malformed or ambiguous image instead of inventing an empty table.\n488|type Ledger struct {\n489|\tmutex    sync.Mutex\n490|\treceipts map[string]Receipt\n491|}\n492|\n493|// NewLedger opens an empty receipt table.\n494|func NewLedger() *Ledger {\n495|\treturn &Ledger{receipts: make(map[string]Receipt)}\n496|}\n497|\n498|// Bind records the receipt for a key before the first side effect. A key\n499|// bound for the first time is stored and replayed back. A key bound again\n500|// with the identical operation and result replays the stored receipt: it\n501|// performs no new effect. A key bound again with a different operation or\n(more lines below)","final_result":true}}}
