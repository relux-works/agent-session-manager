{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cbbb","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":1080,"recorded_at":1780531400002155,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"task_stream":{"kind":"task","id":"01a0b237-27a7-79f3-92bf-0cf2d70a9607"},"task_id":"01a0b237-27a7-79f3-92bf-0cf2d70a9607","event":{"kind":"output","task_id":"01a0b237-27a7-79f3-92bf-0cf2d70a9607","chunk":"Read text file `internal/terminstance/execute.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"time\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n10|)\n11|\n12|// Backend is the modeled terminal backend caller: side-effect execution\n13|// and status observation. No tmux/ConPTY process control and no provider\n14|// process exist behind it; tests model success, coded row refusals,\n15|// uncoded failures and crashes through this interface.\n16|type Backend interface {\n17|\t// PerformEffect executes one side effect and reports its evidence\n18|\t// ID. A nil error proves the commit; a *Error with a row code\n19|\t// proves the backend refused before committing; any other error\n20|\t// proves nothing, not even non-commit.\n21|\tPerformEffect(ctx context.Context, effect terminalbackend.SideEffect) (string, error)\n22|\t// ObserveStatus reports the backend's current observation for one\n23|\t// status body. An error is unknown, never absent.\n24|\tObserveStatus(ctx context.Context, body StatusBody) (StatusObservation, error)\n25|}\n26|\n27|// StatusObservation is the backend-reported status observation: the\n28|// reported state and match verdict, the reported identity tuple the\n29|// engine compares against the query, and the reported capability and\n30|// last-operation facts the landed CheckStatusResult validates.\n31|type StatusObservation struct {\n32|\tState             terminalbackend.InstanceState\n33|\tIdentityMatch     bool\n34|\tWrapperPresent    bool\n35|\tProviderPresent   *bool\n36|\tAttachable        bool\n37|\tLastOperationID   *string\n38|\tLastEffect        *terminalbackend.SideEffect\n39|\tEvidenceIDs       []string\n40|\tProviderRequested bool\n41|\tProviderEvidenced bool\n42|\tAttachEvidenced   bool\n43|\tSessionID         string\n44|\tInstanceID        string\n45|\tBackendID         string\n46|\tImplVersion       string\n47|\tProtoVersion      string\n48|\tGeneration        string\n49|}\n50|\n51|// StatusReport is the validated status outcome: the adopted observation.\n52|// Status performs no transition bookkeeping of its own — no receipt, no\n53|// effects, no before/after — so the report carries the single adopted\n54|// state verbatim.\n55|type StatusReport struct {\n56|\tState           terminalbackend.InstanceState\n57|\tIdentityMatch   bool\n58|\tWrapperPresent  bool\n59|\tProviderPresent *bool\n60|\tAttachable      bool\n61|\tLastOperationID *string\n62|\tLastEffect      *terminalbackend.SideEffect\n63|\tEvidenceIDs     []string\n64|}\n65|\n66|// EngineHooks arms the engine seams tests observe: AfterReceipt fires\n67|// after the durable receipt commits and before the first side effect,\n68|// carrying the interim state (creating for create, the source\n69|// otherwise); BeforeEffect and AfterEffect bracket each committed\n70|// attempt. Hooks observe only: they return nothing and cannot alter\n71|// the outcome.\n72|type EngineHooks struct {\n73|\tAfterReceipt func(operation terminalbackend.Operation, key string, interim terminalbackend.InstanceState)\n74|\tBeforeEffect func(effect terminalbackend.SideEffect)\n75|\tAfterEffect  func(effect terminalbackend.SideEffect)\n76|}\n77|\n78|// Engine executes the §4.C operation rows. Store is the durable receipt\n79|// table; Backend the modeled backend; CurrentLease and CurrentGeneration\n80|// re-read the winning lease and the validated binding generation at\n81|// every check point (function values, never snapshots, so a rotation\n82|// between entry and any effect is caught); Now is the clock. Hooks may\n83|// be nil.\n84|type Engine struct {\n85|\tStore             *ReceiptStore\n86|\tBackend           Backend\n87|\tCurrentLease      func() LeaseView\n88|\tCurrentGeneration func() string\n89|\tNow               func() time.Time\n90|\tHooks             *EngineHooks\n91|}\n92|\n93|// InterimState is the observable state between the durable idempotency\n94|// receipt and the first side effect: creating for create, the source\n95|// state for every other engine operation. creating is entered only by\n96|// create, only after its receipt and before its first listed effect.\n97|func InterimState(operation terminalbackend.Operation, source terminalbackend.InstanceState) terminalbackend.InstanceState {\n98|\tif operation == terminalbackend.OperationCreate {\n99|\t\treturn terminalbackend.StateCreating\n100|\t}\n101|\treturn source\n102|}\n103|\n104|// kindFor maps an engine operation to its AXAuthorization kind. The\n105|// force_stale and restore kinds parse but no engine operation requests\n106|// them: terminate-stale and restore recovery belongs to the story's\n107|// final leaf.\n108|func kindFor(operation terminalbackend.Operation) (AuthorizationKind, bool) {\n109|\tswitch operation {\n110|\tcase terminalbackend.OperationCreate:\n111|\t\treturn AuthorizationCreate, true\n112|\tcase terminalbackend.OperationQuiesceInput,\n113|\t\tterminalbackend.OperationWaitSafeBoundary,\n114|\t\tterminalbackend.OperationRequestStop:\n115|\t\treturn AuthorizationControl, true\n116|\tdefault:\n117|\t\treturn \"\", false\n118|\t}\n119|}\n120|\n121|// rowTimeoutCode is the §4.C timeout vocabulary per engine row: the wait\n122|// row times out quiesce_timeout and the stop row stop_timeout, while\n123|// create and quiesce-input time out terminal_backend_timeout.\n124|func rowTimeoutCode(operation terminalbackend.Operation) string {\n125|\tswitch operation {\n126|\tcase terminalbackend.OperationWaitSafeBoundary:\n127|\t\treturn CodeQuiesceTimeout\n128|\tcase terminalbackend.OperationRequestStop:\n129|\t\treturn CodeStopTimeout\n130|\tdefault:\n131|\t\treturn CodeTimeout\n132|\t}\n133|}\n134|\n135|// engineScope admits exactly the operations this engine executes: the\n136|// status, quiesce-input, wait-safe-boundary and request-stop rows plus\n137|// the create receipt rule. Status has its own entry; attach, restore,\n138|// terminate-stale, manifest and probe are refused here.\n139|func engineScope(operation terminalbackend.Operation) error {\n140|\tswitch operation {\n141|\tcase terminalbackend.OperationCreate, terminalbackend.OperationQuiesceInput,\n142|\t\tterminalbackend.OperationWaitSafeBoundary, terminalbackend.OperationRequestStop:\n143|\t\treturn nil\n144|\tdefault:\n145|\t\treturn refuse(CodeProtocolError, \"operation lifecycle scope\")\n146|\t}\n147|}\n148|\n149|// checkCapabilityConditional evaluates the §4.C conditional capability\n150|// dependencies at the operation call site, the half the landed\n151|// CheckOperation explicitly leaves to the lifecycle owner: headless\n152|// creation for non-interactive create, and safe-boundary observation\n153|// (plus provider-process observation for provider proof kinds) for\n154|// wait-safe-boundary. Quiesce-input and request-stop carry no conditional\n155|// beyond conferral — input_quiescence and graceful_stop are their sole\n156|// conferring capabilities, so the landed CheckOperation decides those\n157|// rows alone and no second arm restates it. The credential-realm\n158|// conditional is a stated bound: credential need is not modeled on this\n159|// path.\n160|func checkCapabilityConditional(operation terminalbackend.Operation, params Params, admitted terminalbackend.Admitted) error {\n161|\tswitch operation {\n162|\tcase terminalbackend.OperationCreate:\n163|\t\tif !params.Interactive && !admitted.Has(\"headless_creation\") {\n164|\t\t\treturn refuse(CodeCapabilityUnproven, \"operation capability conditional\")\n165|\t\t}\n166|\t\treturn nil\n167|\tcase terminalbackend.OperationQuiesceInput, terminalbackend.OperationRequestStop:\n168|\t\treturn nil\n169|\tcase terminalbackend.OperationWaitSafeBoundary:\n170|\t\tif !admitted.Has(\"safe_boundary_observation\") {\n171|\t\t\treturn refuse(CodeCapabilityUnproven, \"operation capability conditional\")\n172|\t\t}\n173|\t\tif RequiresProviderObservation(params.ProviderProofKind) && !admitted.Has(\"provider_process_observation\") {\n174|\t\t\treturn refuse(CodeCapabilityUnproven, \"operation capability conditional\")\n175|\t\t}\n176|\t\treturn nil\n177|\tdefault:\n178|\t\treturn refuse(CodeProtocolError, \"operation lifecycle scope\")\n179|\t}\n180|}\n181|\n182|// ExecuteMutating executes one create, quiesce-input, wait-safe-boundary\n183|// or request-stop request from the source state. A nil error is success\n184|// (after is the transition target, disposition replay_same: re-sending\n185|// replays). A non-nil execution error carries the row code with after\n186|// and disposition per the §4.C error rules: an error before the first\n187|// side effect restores the source state, while an error after a\n188|// committed effect whose result cannot be proven moves the local\n189|// observation to unavailable with status_first (new_authorization when\n190|// the failure names auth drift) and never claims absent. Malformed\n191|// requests (unknown operation, unparseable source or context) return an\n192|// empty result with the error, because a result repeating unvalidated\n193|// identities would echo data the gates refused. Authorization and\n194|// generation are rechecked immediately before each side effect, not\n195|// once at entry; a deadline cancels waiting, never a committed effect.\n196|func (engine *Engine) ExecuteMutating(ctx context.Context, operation terminalbackend.Operation, context MutationContext, params Params, source terminalbackend.InstanceState, admitted terminalbackend.Admitted) (Result, error) {\n197|\tempty := Result{}\n198|\tif engine == nil || engine.Store == nil || engine.Backend == nil ||\n199|\t\tengine.CurrentLease == nil || engine.CurrentGeneration == nil || engine.Now == nil {\n200|\t\treturn empty, refuse(CodeProtocolError, \"engine unavailable\")\n201|\t}\n202|\tif _, err := terminalbackend.ParseOperation(string(operation)); err != nil {\n203|\t\treturn empty, wrapLanded(err)\n204|\t}\n205|\tif err := engineScope(operation); err != nil {\n206|\t\treturn empty, err\n207|\t}\n208|\tif _, err := terminalbackend.ParseInstanceState(string(source)); err != nil {\n209|\t\treturn empty, wrapLanded(err)\n210|\t}\n211|\tif err := CheckMutationContext(operation, context, params); err != nil {\n212|\t\treturn empty, err\n213|\t}\n214|\tif err := terminalbackend.CheckOperation(string(operation), admitted); err != nil {\n215|\t\tfailure := wrapLanded(err)\n216|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n217|\t}\n218|\tif err := checkCapabilityConditional(operation, params, admitted); err != nil {\n219|\t\tfailure := err.(*Error)\n220|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n221|\t}\n222|\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), params.Interactive)\n223|\tif err != nil {\n224|\t\tfailure := wrapLanded(err)\n225|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n226|\t}\n227|\tkind, _ := kindFor(operation)\n228|\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil {\n229|\t\tfailure := err.(*Error)\n230|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n231|\t}\n232|\tif engine.CurrentGeneration() != context.BackendGeneration {\n233|\t\tfailure := refuse(CodeStaleGeneration, \"backend_generation stale\")\n234|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n235|\t}\n236|\tdeadline, err := context.Deadline.Time()\n237|\tif err != nil {\n238|\t\treturn empty, refuse(CodeProtocolError, \"mutation context deadline\")\n239|\t}\n240|\tif !engine.Now().Before(deadline) {\n241|\t\tfailure := refuse(rowTimeoutCode(operation), \"operation deadline\")\n242|\t\treturn buildResult(context, source, source, nil, nil, DispositionReplaySame), failure\n243|\t}\n244|\tkey := context.IdempotencyKey\n245|\t_, replayed, err := engine.Store.Bind(key, operation, context.OperationID)\n246|\tif err != nil {\n247|\t\tfailure, ok := err.(*Error)\n248|\t\tif !ok {\n249|\t\t\tuncoded := refuse(CodeProcessFailed, \"idempotency store failure\")\n250|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), uncoded\n251|\t\t}\n252|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n253|\t}\n254|\tif replayed {\n255|\t\tstored, found, err := engine.Store.Completed(key)\n256|\t\tif err != nil {\n257|\t\t\tuncoded := refuse(CodeProcessFailed, \"idempotency store failure\")\n258|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), uncoded\n259|\t\t}\n260|\t\tif !found {\n261|\t\t\tfailure := refuse(CodeUnavailable, \"idempotency result uncertain\")\n262|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), failure\n263|\t\t}\n264|\t\tvar result Result\n265|\t\tif err := json.Unmarshal(stored, &result); err != nil {\n266|\t\t\tfailure := refuse(CodeIntegrityFailure, \"idempotency result image\")\n267|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), failure\n268|\t\t}\n269|\t\tif err := CheckResult(context, source, result); err != nil {\n270|\t\t\tfailure, ok := err.(*Error)\n271|\t\t\tif !ok {\n272|\t\t\t\tuncoded := refuse(CodeIntegrityFailure, \"idempotency result image\")\n273|\t\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), uncoded\n274|\t\t\t}\n275|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionFor(failure.Code, true)), failure\n276|\t\t}\n277|\t\treturn result, nil\n278|\t}\n279|\tif engine.Hooks != nil && engine.Hooks.AfterReceipt != nil {\n280|\t\tengine.Hooks.AfterReceipt(operation, key, InterimState(operation, source))\n281|\t}\n282|\tcommitted := false\n283|\tevidence := []string(nil)\n284|\tperformed := []terminalbackend.SideEffect(nil)\n285|\tfor _, effect := range effects {\n286|\t\tif !engine.Now().Before(deadline) {\n287|\t\t\tfailure := refuse(rowTimeoutCode(operation), \"operation deadline\")\n288|\t\t\tif committed {\n289|\t\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, performed, evidence, DispositionStatusFirst), failure\n290|\t\t\t}\n291|\t\t\treturn buildResult(context, source, source, performed, evidence, DispositionReplaySame), failure\n292|\t\t}\n293|\t\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil {\n294|\t\t\tfailure := err.(*Error)\n295|\t\t\tafter := source\n296|\t\t\tif committed {\n297|\t\t\t\tafter = terminalbackend.StateUnavailable\n298|\t\t\t}\n299|\t\t\treturn buildResult(context, source, after, performed, evidence, DispositionFor(failure.Code, committed)), failure\n300|\t\t}\n301|\t\tif engine.CurrentGeneration() != context.BackendGeneration {\n302|\t\t\tfailure := refuse(CodeStaleGeneration, \"backend_generation stale\")\n303|\t\t\tafter := source\n304|\t\t\tif committed {\n305|\t\t\t\tafter = terminalbackend.StateUnavailable\n306|\t\t\t}\n307|\t\t\treturn buildResult(context, source, after, performed, evidence, DispositionFor(failure.Code, committed)), failure\n308|\t\t}\n309|\t\tif engine.Hooks != nil && engine.Hooks.BeforeEffect != nil {\n310|\t\t\tengine.Hooks.BeforeEffect(effect)\n311|\t\t}\n312|\t\tevidenceID, err := engine.Backend.PerformEffect(ctx, effect)\n313|\t\tif engine.Hooks != nil && engine.Hooks.AfterEffect != nil {\n314|\t\t\tengine.Hooks.AfterEffect(effect)\n315|\t\t}\n316|\t\tif err != nil {\n317|\t\t\tcode := ErrorCode(err)\n318|\t\t\tif code == \"\" {\n319|\t\t\t\tfailure := refuse(CodeProcessFailed, \"backend effect uncertain\")\n320|\t\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, performed, evidence, DispositionStatusFirst), failure\n321|\t\t\t}\n322|\t\t\tif err := terminalbackend.CheckErrorAllowed(string(operation), code); err != nil {\n323|\t\t\t\tfailure := refuse(CodeProtocolError, \"operation error vocabulary\")\n324|\t\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, performed, evidence, DispositionStatusFirst), failure\n325|\t\t\t}\n326|\t\t\tafter := source\n327|\t\t\tif committed {\n328|\t\t\t\tafter = terminalbackend.StateUnavailable\n329|\t\t\t}\n330|\t\t\tfailure := refuse(code, \"backend effect refused\")\n331|\t\t\treturn buildResult(context, source, after, performed, evidence, DispositionFor(code, committed)), failure\n332|\t\t}\n333|\t\tif _, err := scalar.ParseDigest(evidenceID); err != nil {\n334|\t\t\tfailure := refuse(CodeIntegrityFailure, \"backend effect evidence\")\n335|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, performed, evidence, DispositionStatusFirst), failure\n336|\t\t}\n337|\t\tcommitted = true\n338|\t\tperformed = append(performed, effect)\n339|\t\tevidence = append(evidence, evidenceID)\n340|\t}\n341|\tresult := buildResult(context, source, target, performed, evidence, DispositionReplaySame)\n342|\tencoded, err := json.Marshal(result)\n343|\tif err != nil {\n344|\t\tfailure := refuse(CodeIntegrityFailure, \"idempotency result image\")\n345|\t\tresult.Disposition = DispositionStatusFirst\n346|\t\treturn result, failure\n347|\t}\n348|\tif err := engine.Store.Complete(key, encoded); err != nil {\n349|\t\tfailure, ok := err.(*Error)\n350|\t\tif !ok {\n351|\t\t\tuncoded := refuse(CodeProcessFailed, \"idempotency store failure\")\n352|\t\t\tresult.Disposition = DispositionStatusFirst\n353|\t\t\treturn result, uncoded\n354|\t\t}\n355|\t\tresult.Disposition = DispositionStatusFirst\n356|\t\treturn result, failure\n357|\t}\n358|\treturn result, nil\n359|}\n360|\n361|// ExecuteStatus executes one status query: no receipt, no side effects,\n362|// no authorization and no transition bookkeeping of its own. The\n363|// reported state is adopted verbatim; the engine validates the report\n364|// (the reported match must equal the compared tuple, the landed\n365|// CheckStatusResult must admit it, evidence must be sorted-unique\n366|// digests) and enforces the provider-observation capability conditional.\n367|// A timeout or read failure is unknown, never absent: it returns an\n368|// error with no report.\n369|func (engine *Engine) ExecuteStatus(ctx context.Context, body StatusBody, source terminalbackend.InstanceState, admitted terminalbackend.Admitted) (StatusReport, error) {\n370|\tempty := StatusReport{}\n371|\tif engine == nil || engine.Backend == nil || engine.Now == nil {\n372|\t\treturn empty, refuse(CodeProtocolError, \"engine unavailable\")\n373|\t}\n374|\tif source != \"\" {\n375|\t\tif _, _, err := terminalbackend.CheckTransition(string(terminalbackend.OperationStatus), string(source), false); err != nil {\n376|\t\t\treturn empty, wrapLanded(err)\n377|\t\t}\n378|\t}\n379|\tdeadline, err := body.Deadline.Time()\n380|\tif err != nil {\n381|\t\treturn empty, refuse(CodeProtocolError, \"status body deadline\")\n382|\t}\n383|\tif !engine.Now().Before(deadline) {\n384|\t\treturn empty, refuse(CodeTimeout, \"operation deadline\")\n385|\t}\n386|\tif body.IncludeProviderObservation && !admitted.Has(\"provider_process_observation\") {\n387|\t\treturn empty, refuse(CodeCapabilityUnproven, \"operation capability conditional\")\n388|\t}\n389|\tobserved, err := engine.Backend.ObserveStatus(ctx, body)\n390|\tif err != nil {\n391|\t\tcode := ErrorCode(err)\n392|\t\tif code == \"\" {\n393|\t\t\treturn empty, refuse(CodeUnavailable, \"status observation unknown\")\n394|\t\t}\n395|\t\tif err := terminalbackend.CheckErrorAllowed(string(terminalbackend.OperationStatus), code); err != nil {\n396|\t\t\treturn empty, refuse(CodeProtocolError, \"operation error vocabulary\")\n397|\t\t}\n398|\t\treturn empty, refuse(code, \"status observation unknown\")\n399|\t}\n400|\tif _, err := terminalbackend.ParseInstanceState(string(observed.State)); err != nil {\n401|\t\treturn empty, wrapLanded(err)\n402|\t}\n403|\tcomputed, err := statusIdentityMatch(body, observed)\n404|\tif err != nil {\n405|\t\treturn empty, err\n406|\t}\n407|\tif observed.IdentityMatch != computed {\n408|\t\treturn empty, refuse(CodeProtocolError, \"status identity binding\")\n409|\t}\n410|\tconverted := terminalbackend.StatusResult{\n411|\t\tState:             observed.State,\n412|\t\tIdentityMatch:     observed.IdentityMatch,\n413|\t\tWrapperPresent:    observed.WrapperPresent,\n414|\t\tProviderPresent:   observed.ProviderPresent,\n415|\t\tAttachable:        observed.Attachable,\n416|\t\tLastOperationID:   observed.LastOperationID,\n417|\t\tLastEffect:        observed.LastEffect,\n418|\t\tProviderRequested: observed.ProviderRequested,\n419|\t\tProviderEvidenced: observed.ProviderEvidenced,\n420|\t\tAttachEvidenced:   observed.AttachEvidenced,\n421|\t}\n422|\tif observed.LastOperationID != nil {\n423|\t\tif _, err := scalar.ParseUUIDv7(*observed.LastOperationID); err != nil {\n424|\t\t\treturn empty, refuse(CodeProtocolError, \"status report operation\")\n425|\t\t}\n426|\t}\n427|\tif err := terminalbackend.CheckStatusResult(computed, converted); err != nil {\n428|\t\treturn empty, wrapLanded(err)\n429|\t}\n430|\tif err := checkSortedUniqueStatusEvidence(observed.EvidenceIDs); err != nil {\n431|\t\treturn empty, err\n432|\t}\n433|\treturn StatusReport{\n434|\t\tState:           observed.State,\n435|\t\tIdentityMatch:   observed.IdentityMatch,\n436|\t\tWrapperPresent:  observed.WrapperPresent,\n437|\t\tProviderPresent: observed.ProviderPresent,\n438|\t\tAttachable:      observed.Attachable,\n439|\t\tLastOperationID: observed.LastOperationID,\n440|\t\tLastEffect:      observed.LastEffect,\n441|\t\tEvidenceIDs:     append([]string(nil), observed.EvidenceIDs...),\n442|\t}, nil\n443|}\n444|\n445|// statusIdentityMatch compares the reported identity tuple against the\n446|// query: exact-instance lookup requires Session, instance, backend,\n447|// implementation, protocol and generation to all match; Session-scoped\n448|// lookup requires the reported session to match and adopts the rest.\n449|// Reported members are shape-validated first, so a malformed report is\n450|// refused instead of compared.\n451|func statusIdentityMatch(body StatusBody, observed StatusObservation) (bool, error) {\n452|\tif _, err := scalar.ParseUUIDv7(observed.SessionID); err != nil {\n453|\t\treturn false, refuse(CodeProtocolError, \"status report session\")\n454|\t}\n455|\tif _, err := terminalbackend.ParseID(observed.BackendID); err != nil {\n456|\t\treturn false, wrapLanded(err)\n457|\t}\n458|\tif err := checkVersionTuple(observed.BackendID, observed.ImplVersion, observed.ProtoVersion); err != nil {\n459|\t\treturn false, err\n460|\t}\n461|\tif observed.SessionID != body.SessionID {\n462|\t\treturn false, nil\n463|\t}\n464|\tif !body.HasTerminalInstanceID {\n465|\t\treturn true, nil\n466|\t}\n467|\tif _, err := scalar.ParseUUIDv7(observed.InstanceID); err != nil {\n468|\t\treturn false, refuse(CodeProtocolError, \"status report instance\")\n469|\t}\n470|\tif err := checkGenerationBound(observed.Generation); err != nil {\n471|\t\treturn false, refuse(CodeProtocolError, \"status report generation\")\n472|\t}\n473|\treturn observed.InstanceID == body.TerminalInstanceID &&\n474|\t\tobserved.BackendID == body.TerminalBackendID &&\n475|\t\tobserved.ImplVersion == body.ImplementationVersion &&\n476|\t\tobserved.ProtoVersion == body.ProtocolVersion &&\n477|\t\tobserved.Generation == body.BackendGeneration, nil\n478|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cbbd","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":1081,"recorded_at":1780531400002157,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"task_stream":{"kind":"task","id":"01a0b237-27a7-79f3-92bf-0cf2d70a9607"},"task_id":"01a0b237-27a7-79f3-92bf-0cf2d70a9607","event":{"kind":"completed","task_id":"01a0b237-27a7-79f3-92bf-0cf2d70a9607"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cbbf","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":1082,"recorded_at":1780531400002159,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"call_id":"call_01a0b23724397450b9bec2de68a2eeea","text":"Read text file `internal/terminstance/execute.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"time\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n10|)\n11|\n12|// Backend is the modeled terminal backend caller: side-effect execution\n13|// and status observation. No tmux/ConPTY process control and no provider\n14|// process exist behind it; tests model success, coded row refusals,\n15|// uncoded failures and crashes through this interface.\n16|type Backend interface {\n17|\t// PerformEffect executes one side effect and reports its evidence\n18|\t// ID. A nil error proves the commit; a *Error with a row code\n19|\t// proves the backend refused before committing; any other error\n20|\t// proves nothing, not even non-commit.\n21|\tPerformEffect(ctx context.Context, effect terminalbackend.SideEffect) (string, error)\n22|\t// ObserveStatus reports the backend's current observation for one\n23|\t// status body. An error is unknown, never absent.\n24|\tObserveStatus(ctx context.Context, body StatusBody) (StatusObservation, error)\n25|}\n26|\n27|// StatusObservation is the backend-reported status observation: the\n28|// reported state and match verdict, the reported identity tuple the\n29|// engine compares against the query, and the reported capability and\n30|// last-operation facts the landed CheckStatusResult validates.\n31|type StatusObservation struct {\n32|\tState             terminalbackend.InstanceState\n33|\tIdentityMatch     bool\n34|\tWrapperPresent    bool\n35|\tProviderPresent   *bool\n36|\tAttachable        bool\n37|\tLastOperationID   *string\n38|\tLastEffect        *terminalbackend.SideEffect\n39|\tEvidenceIDs       []string\n40|\tProviderRequested bool\n41|\tProviderEvidenced bool\n42|\tAttachEvidenced   bool\n43|\tSessionID         string\n44|\tInstanceID        string\n45|\tBackendID         string\n46|\tImplVersion       string\n47|\tProtoVersion      string\n48|\tGeneration        string\n49|}\n50|\n51|// StatusReport is the validated status outcome: the adopted observation.\n52|// Status performs no transition bookkeeping of its own — no receipt, no\n53|// effects, no before/after — so the report carries the single adopted\n54|// state verbatim.\n55|type StatusReport struct {\n56|\tState           terminalbackend.InstanceState\n57|\tIdentityMatch   bool\n58|\tWrapperPresent  bool\n59|\tProviderPresent *bool\n60|\tAttachable      bool\n61|\tLastOperationID *string\n62|\tLastEffect      *terminalbackend.SideEffect\n63|\tEvidenceIDs     []string\n64|}\n65|\n66|// EngineHooks arms the engine seams tests observe: AfterReceipt fires\n67|// after the durable receipt commits and before the first side effect,\n68|// carrying the interim state (creating for create, the source\n69|// otherwise); BeforeEffect and AfterEffect bracket each committed\n70|// attempt. Hooks observe only: they return nothing and cannot alter\n71|// the outcome.\n72|type EngineHooks struct {\n73|\tAfterReceipt func(operation terminalbackend.Operation, key string, interim terminalbackend.InstanceState)\n74|\tBeforeEffect func(effect terminalbackend.SideEffect)\n75|\tAfterEffect  func(effect terminalbackend.SideEffect)\n76|}\n77|\n78|// Engine executes the §4.C operation rows. Store is the durable receipt\n79|// table; Backend the modeled backend; CurrentLease and CurrentGeneration\n80|// re-read the winning lease and the validated binding generation at\n81|// every check point (function values, never snapshots, so a rotation\n82|// between entry and any effect is caught); Now is the clock. Hooks may\n83|// be nil.\n84|type Engine struct {\n85|\tStore             *ReceiptStore\n86|\tBackend           Backend\n87|\tCurrentLease      func() LeaseView\n88|\tCurrentGeneration func() string\n89|\tNow               func() time.Time\n90|\tHooks             *EngineHooks\n91|}\n92|\n93|// InterimState is the observable state between the durable idempotency\n94|// receipt and the first side effect: creating for create, the source\n95|// state for every other engine operation. creating is entered only by\n96|// create, only after its receipt and before its first listed effect.\n97|func InterimState(operation terminalbackend.Operation, source terminalbackend.InstanceState) terminalbackend.InstanceState {\n98|\tif operation == terminalbackend.OperationCreate {\n99|\t\treturn terminalbackend.StateCreating\n100|\t}\n101|\treturn source\n102|}\n103|\n104|// kindFor maps an engine operation to its AXAuthorization kind. The\n105|// force_stale and restore kinds parse but no engine operation requests\n106|// them: terminate-stale and restore recovery belongs to the story's\n107|// final leaf.\n108|func kindFor(operation terminalbackend.Operation) (AuthorizationKind, bool) {\n109|\tswitch operation {\n110|\tcase terminalbackend.OperationCreate:\n111|\t\treturn AuthorizationCreate, true\n112|\tcase terminalbackend.OperationQuiesceInput,\n113|\t\tterminalbackend.OperationWaitSafeBoundary,\n114|\t\tterminalbackend.OperationRequestStop:\n115|\t\treturn AuthorizationControl, true\n116|\tdefault:\n117|\t\treturn \"\", false\n118|\t}\n119|}\n120|\n121|// rowTimeoutCode is the §4.C timeout vocabulary per engine row: the wait\n122|// row times out quiesce_timeout and the stop row stop_timeout, while\n123|// create and quiesce-input time out terminal_backend_timeout.\n124|func rowTimeoutCode(operation terminalbackend.Operation) string {\n125|\tswitch operation {\n126|\tcase terminalbackend.OperationWaitSafeBoundary:\n127|\t\treturn CodeQuiesceTimeout\n128|\tcase terminalbackend.OperationRequestStop:\n129|\t\treturn CodeStopTimeout\n130|\tdefault:\n131|\t\treturn CodeTimeout\n132|\t}\n133|}\n134|\n135|// engineScope admits exactly the operations this engine executes: the\n136|// status, quiesce-input, wait-safe-boundary and request-stop rows plus\n137|// the create receipt rule. Status has its own entry; attach, restore,\n138|// terminate-stale, manifest and probe are refused here.\n139|func engineScope(operation terminalbackend.Operation) error {\n140|\tswitch operation {\n141|\tcase terminalbackend.OperationCreate, terminalbackend.OperationQuiesceInput,\n142|\t\tterminalbackend.OperationWaitSafeBoundary, terminalbackend.OperationRequestStop:\n143|\t\treturn nil\n144|\tdefault:\n145|\t\treturn refuse(CodeProtocolError, \"operation lifecycle scope\")\n146|\t}\n147|}\n148|\n149|// checkCapabilityConditional evaluates the §4.C conditional capability\n150|// dependencies at the operation call site, the half the landed\n151|// CheckOperation explicitly leaves to the lifecycle owner: headless\n152|// creation for non-interactive create, and safe-boundary observation\n153|// (plus provider-process observation for provider proof kinds) for\n154|// wait-safe-boundary. Quiesce-input and request-stop carry no conditional\n155|// beyond conferral — input_quiescence and graceful_stop are their sole\n156|// conferring capabilities, so the landed CheckOperation decides those\n157|// rows alone and no second arm restates it. The credential-realm\n158|// conditional is a stated bound: credential need is not modeled on this\n159|// path.\n160|func checkCapabilityConditional(operation terminalbackend.Operation, params Params, admitted terminalbackend.Admitted) error {\n161|\tswitch operation {\n162|\tcase terminalbackend.OperationCreate:\n163|\t\tif !params.Interactive && !admitted.Has(\"headless_creation\") {\n164|\t\t\treturn refuse(CodeCapabilityUnproven, \"operation capability conditional\")\n165|\t\t}\n166|\t\treturn nil\n167|\tcase terminalbackend.OperationQuiesceInput, terminalbackend.OperationRequestStop:\n168|\t\treturn nil\n169|\tcase terminalbackend.OperationWaitSafeBoundary:\n170|\t\tif !admitted.Has(\"safe_boundary_observation\") {\n171|\t\t\treturn refuse(CodeCapabilityUnproven, \"operation capability conditional\")\n172|\t\t}\n173|\t\tif RequiresProviderObservation(params.ProviderProofKind) && !admitted.Has(\"provider_process_observation\") {\n174|\t\t\treturn refuse(CodeCapabilityUnproven, \"operation capability conditional\")\n175|\t\t}\n176|\t\treturn nil\n177|\tdefault:\n178|\t\treturn refuse(CodeProtocolError, \"operation lifecycle scope\")\n179|\t}\n180|}\n181|\n182|// ExecuteMutating executes one create, quiesce-input, wait-safe-boundary\n183|// or request-stop request from the source state. A nil error is success\n184|// (after is the transition target, disposition replay_same: re-sending\n185|// replays). A non-nil execution error carries the row code with after\n186|// and disposition per the §4.C error rules: an error before the first\n187|// side effect restores the source state, while an error after a\n188|// committed effect whose result cannot be proven moves the local\n189|// observation to unavailable with status_first (new_authorization when\n190|// the failure names auth drift) and never claims absent. Malformed\n191|// requests (unknown operation, unparseable source or context) return an\n192|// empty result with the error, because a result repeating unvalidated\n193|// identities would echo data the gates refused. Authorization and\n194|// generation are rechecked immediately before each side effect, not\n195|// once at entry; a deadline cancels waiting, never a committed effect.\n196|func (engine *Engine) ExecuteMutating(ctx context.Context, operation terminalbackend.Operation, context MutationContext, params Params, source terminalbackend.InstanceState, admitted terminalbackend.Admitted) (Result, error) {\n197|\tempty := Result{}\n198|\tif engine == nil || engine.Store == nil || engine.Backend == nil ||\n199|\t\tengine.CurrentLease == nil || engine.CurrentGeneration == nil || engine.Now == nil {\n200|\t\treturn empty, refuse(CodeProtocolError, \"engine unavailable\")\n201|\t}\n202|\tif _, err := terminalbackend.ParseOperation(string(operation)); err != nil {\n203|\t\treturn empty, wrapLanded(err)\n204|\t}\n205|\tif err := engineScope(operation); err != nil {\n206|\t\treturn empty, err\n207|\t}\n208|\tif _, err := terminalbackend.ParseInstanceState(string(source)); err != nil {\n209|\t\treturn empty, wrapLanded(err)\n210|\t}\n211|\tif err := CheckMutationContext(operation, context, params); err != nil {\n212|\t\treturn empty, err\n213|\t}\n214|\tif err := terminalbackend.CheckOperation(string(operation), admitted); err != nil {\n215|\t\tfailure := wrapLanded(err)\n216|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n217|\t}\n218|\tif err := checkCapabilityConditional(operation, params, admitted); err != nil {\n219|\t\tfailure := err.(*Error)\n220|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n221|\t}\n222|\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), params.Interactive)\n223|\tif err != nil {\n224|\t\tfailure := wrapLanded(err)\n225|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n226|\t}\n227|\tkind, _ := kindFor(operation)\n228|\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil {\n229|\t\tfailure := err.(*Error)\n230|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n231|\t}\n232|\tif engine.CurrentGeneration() != context.BackendGeneration {\n233|\t\tfailure := refuse(CodeStaleGeneration, \"backend_generation stale\")\n234|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n235|\t}\n236|\tdeadline, err := context.Deadline.Time()\n237|\tif err != nil {\n238|\t\treturn empty, refuse(CodeProtocolError, \"mutation context deadline\")\n239|\t}\n240|\tif !engine.Now().Before(deadline) {\n241|\t\tfailure := refuse(rowTimeoutCode(operation), \"operation deadline\")\n242|\t\treturn buildResult(context, source, source, nil, nil, DispositionReplaySame), failure\n243|\t}\n244|\tkey := context.IdempotencyKey\n245|\t_, replayed, err := engine.Store.Bind(key, operation, context.OperationID)\n246|\tif err != nil {\n247|\t\tfailure, ok := err.(*Error)\n248|\t\tif !ok {\n249|\t\t\tuncoded := refuse(CodeProcessFailed, \"idempotency store failure\")\n250|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), uncoded\n251|\t\t}\n252|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n253|\t}\n254|\tif replayed {\n255|\t\tstored, found, err := engine.Store.Completed(key)\n256|\t\tif err != nil {\n257|\t\t\tuncoded := refuse(CodeProcessFailed, \"idempotency store failure\")\n258|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), uncoded\n259|\t\t}\n260|\t\tif !found {\n261|\t\t\tfailure := refuse(CodeUnavailable, \"idempotency result uncertain\")\n262|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), failure\n263|\t\t}\n264|\t\tvar result Result\n265|\t\tif err := json.Unmarshal(stored, &result); err != nil {\n266|\t\t\tfailure := refuse(CodeIntegrityFailure, \"idempotency result image\")\n267|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), failure\n268|\t\t}\n269|\t\tif err := CheckResult(context, source, result); err != nil {\n270|\t\t\tfailure, ok := err.(*Error)\n271|\t\t\tif !ok {\n272|\t\t\t\tuncoded := refuse(CodeIntegrityFailure, \"idempotency result image\")\n273|\t\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), uncoded\n274|\t\t\t}\n275|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionFor(failure.Code, true)), failure\n276|\t\t}\n277|\t\treturn result, nil\n278|\t}\n279|\tif engine.Hooks != nil && engine.Hooks.AfterReceipt != nil {\n280|\t\tengine.Hooks.AfterReceipt(operation, key, InterimState(operation, source))\n281|\t}\n282|\tcommitted := false\n283|\tevidence := []string(nil)\n284|\tperformed := []terminalbackend.SideEffect(nil)\n285|\tfor _, effect := range effects {\n286|\t\tif !engine.Now().Before(deadline) {\n287|\t\t\tfailure := refuse(rowTimeoutCode(operation), \"operation deadline\")\n288|\t\t\tif committed {\n289|\t\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, performed, evidence, DispositionStatusFirst), failure\n290|\t\t\t}\n291|\t\t\treturn buildResult(context, source, source, performed, evidence, DispositionReplaySame), failure\n292|\t\t}\n293|\t\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil {\n294|\t\t\tfailure := err.(*Error)\n295|\t\t\tafter := source\n296|\t\t\tif committed {\n297|\t\t\t\tafter = terminalbackend.StateUnavailable\n298|\t\t\t}\n299|\t\t\treturn buildResult(context, source, after, performed, evidence, DispositionFor(failure.Code, committed)), failure\n300|\t\t}\n301|\t\tif engine.CurrentGeneration() != context.BackendGeneration {\n302|\t\t\tfailure := refuse(CodeStaleGeneration, \"backend_generation stale\")\n303|\t\t\tafter := source\n304|\t\t\tif committed {\n305|\t\t\t\tafter = terminalbackend.StateUnavailable\n306|\t\t\t}\n307|\t\t\treturn buildResult(context, source, after, performed, evidence, DispositionFor(failure.Code, committed)), failure\n308|\t\t}\n309|\t\tif engine.Hooks != nil && engine.Hooks.BeforeEffect != nil {\n310|\t\t\tengine.Hooks.BeforeEffect(effect)\n311|\t\t}\n312|\t\tevidenceID, err := engine.Backend.PerformEffect(ctx, effect)\n313|\t\tif engine.Hooks != nil && engine.Hooks.AfterEffect != nil {\n314|\t\t\tengine.Hooks.AfterEffect(effect)\n315|\t\t}\n316|\t\tif err != nil {\n317|\t\t\tcode := ErrorCode(err)\n318|\t\t\tif code == \"\" {\n319|\t\t\t\tfailure := refuse(CodeProcessFailed, \"backend effect uncertain\")\n320|\t\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, performed, evidence, DispositionStatusFirst), failure\n321|\t\t\t}\n322|\t\t\tif err := terminalbackend.CheckErrorAllowed(string(operation), code); err != nil {\n323|\t\t\t\tfailure := refuse(CodeProtocolError, \"operation error vocabulary\")\n324|\t\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, performed, evidence, DispositionStatusFirst), failure\n325|\t\t\t}\n326|\t\t\tafter := source\n327|\t\t\tif committed {\n328|\t\t\t\tafter = terminalbackend.StateUnavailable\n329|\t\t\t}\n330|\t\t\tfailure := refuse(code, \"backend effect refused\")\n331|\t\t\treturn buildResult(context, source, after, performed, evidence, DispositionFor(code, committed)), failure\n332|\t\t}\n333|\t\tif _, err := scalar.ParseDigest(evidenceID); err != nil {\n334|\t\t\tfailure := refuse(CodeIntegrityFailure, \"backend effect evidence\")\n335|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, performed, evidence, DispositionStatusFirst), failure\n336|\t\t}\n337|\t\tcommitted = true\n338|\t\tperformed = append(performed, effect)\n339|\t\tevidence = append(evidence, evidenceID)\n340|\t}\n341|\tresult := buildResult(context, source, target, performed, evidence, DispositionReplaySame)\n342|\tencoded, err := json.Marshal(result)\n343|\tif err != nil {\n344|\t\tfailure := refuse(CodeIntegrityFailure, \"idempotency result image\")\n345|\t\tresult.Disposition = DispositionStatusFirst\n346|\t\treturn result, failure\n347|\t}\n348|\tif err := engine.Store.Complete(key, encoded); err != nil {\n349|\t\tfailure, ok := err.(*Error)\n350|\t\tif !ok {\n351|\t\t\tuncoded := refuse(CodeProcessFailed, \"idempotency store failure\")\n352|\t\t\tresult.Disposition = DispositionStatusFirst\n353|\t\t\treturn result, uncoded\n354|\t\t}\n355|\t\tresult.Disposition = DispositionStatusFirst\n356|\t\treturn result, failure\n357|\t}\n358|\treturn result, nil\n359|}\n360|\n361|// ExecuteStatus executes one status query: no receipt, no side effects,\n362|// no authorization and no transition bookkeeping of its own. The\n363|// reported state is adopted verbatim; the engine validates the report\n364|// (the reported match must equal the compared tuple, the landed\n365|// CheckStatusResult must admit it, evidence must be sorted-unique\n366|// digests) and enforces the provider-observation capability conditional.\n367|// A timeout or read failure is unknown, never absent: it returns an\n368|// error with no report.\n369|func (engine *Engine) ExecuteStatus(ctx context.Context, body StatusBody, source terminalbackend.InstanceState, admitted terminalbackend.Admitted) (StatusReport, error) {\n370|\tempty := StatusReport{}\n371|\tif engine == nil || engine.Backend == nil || engine.Now == nil {\n372|\t\treturn empty, refuse(CodeProtocolError, \"engine unavailable\")\n373|\t}\n374|\tif source != \"\" {\n375|\t\tif _, _, err := terminalbackend.CheckTransition(string(terminalbackend.OperationStatus), string(source), false); err != nil {\n376|\t\t\treturn empty, wrapLanded(err)\n377|\t\t}\n378|\t}\n379|\tdeadline, err := body.Deadline.Time()\n380|\tif err != nil {\n381|\t\treturn empty, refuse(CodeProtocolError, \"status body deadline\")\n382|\t}\n383|\tif !engine.Now().Before(deadline) {\n384|\t\treturn empty, refuse(CodeTimeout, \"operation deadline\")\n385|\t}\n386|\tif body.IncludeProviderObservation && !admitted.Has(\"provider_process_observation\") {\n387|\t\treturn empty, refuse(CodeCapabilityUnproven, \"operation capability conditional\")\n388|\t}\n389|\tobserved, err := engine.Backend.ObserveStatus(ctx, body)\n390|\tif err != nil {\n391|\t\tcode := ErrorCode(err)\n392|\t\tif code == \"\" {\n393|\t\t\treturn empty, refuse(CodeUnavailable, \"status observation unknown\")\n394|\t\t}\n395|\t\tif err := terminalbackend.CheckErrorAllowed(string(terminalbackend.OperationStatus), code); err != nil {\n396|\t\t\treturn empty, refuse(CodeProtocolError, \"operation error vocabulary\")\n397|\t\t}\n398|\t\treturn empty, refuse(code, \"status observation unknown\")\n399|\t}\n400|\tif _, err := terminalbackend.ParseInstanceState(string(observed.State)); err != nil {\n401|\t\treturn empty, wrapLanded(err)\n402|\t}\n403|\tcomputed, err := statusIdentityMatch(body, observed)\n404|\tif err != nil {\n405|\t\treturn empty, err\n406|\t}\n407|\tif observed.IdentityMatch != computed {\n408|\t\treturn empty, refuse(CodeProtocolError, \"status identity binding\")\n409|\t}\n410|\tconverted := terminalbackend.StatusResult{\n411|\t\tState:             observed.State,\n412|\t\tIdentityMatch:     observed.IdentityMatch,\n413|\t\tWrapperPresent:    observed.WrapperPresent,\n414|\t\tProviderPresent:   observed.ProviderPresent,\n415|\t\tAttachable:        observed.Attachable,\n416|\t\tLastOperationID:   observed.LastOperationID,\n417|\t\tLastEffect:        observed.LastEffect,\n418|\t\tProviderRequested: observed.ProviderRequested,\n419|\t\tProviderEvidenced: observed.ProviderEvidenced,\n420|\t\tAttachEvidenced:   observed.AttachEvidenced,\n421|\t}\n422|\tif observed.LastOperationID != nil {\n423|\t\tif _, err := scalar.ParseUUIDv7(*observed.LastOperationID); err != nil {\n424|\t\t\treturn empty, refuse(CodeProtocolError, \"status report operation\")\n425|\t\t}\n426|\t}\n427|\tif err := terminalbackend.CheckStatusResult(computed, converted); err != nil {\n428|\t\treturn empty, wrapLanded(err)\n429|\t}\n430|\tif err := checkSortedUniqueStatusEvidence(observed.EvidenceIDs); err != nil {\n431|\t\treturn empty, err\n432|\t}\n433|\treturn StatusReport{\n434|\t\tState:           observed.State,\n435|\t\tIdentityMatch:   observed.IdentityMatch,\n436|\t\tWrapperPresent:  observed.WrapperPresent,\n437|\t\tProviderPresent: observed.ProviderPresent,\n438|\t\tAttachable:      observed.Attachable,\n439|\t\tLastOperationID: observed.LastOperationID,\n440|\t\tLastEffect:      observed.LastEffect,\n441|\t\tEvidenceIDs:     append([]string(nil), observed.EvidenceIDs...),\n442|\t}, nil\n443|}\n444|\n445|// statusIdentityMatch compares the reported identity tuple against the\n446|// query: exact-instance lookup requires Session, instance, backend,\n447|// implementation, protocol and generation to all match; Session-scoped\n448|// lookup requires the reported session to match and adopts the rest.\n449|// Reported members are shape-validated first, so a malformed report is\n450|// refused instead of compared.\n451|func statusIdentityMatch(body StatusBody, observed StatusObservation) (bool, error) {\n452|\tif _, err := scalar.ParseUUIDv7(observed.SessionID); err != nil {\n453|\t\treturn false, refuse(CodeProtocolError, \"status report session\")\n454|\t}\n455|\tif _, err := terminalbackend.ParseID(observed.BackendID); err != nil {\n456|\t\treturn false, wrapLanded(err)\n457|\t}\n458|\tif err := checkVersionTuple(observed.BackendID, observed.ImplVersion, observed.ProtoVersion); err != nil {\n459|\t\treturn false, err\n460|\t}\n461|\tif observed.SessionID != body.SessionID {\n462|\t\treturn false, nil\n463|\t}\n464|\tif !body.HasTerminalInstanceID {\n465|\t\treturn true, nil\n466|\t}\n467|\tif _, err := scalar.ParseUUIDv7(observed.InstanceID); err != nil {\n468|\t\treturn false, refuse(CodeProtocolError, \"status report instance\")\n469|\t}\n470|\tif err := checkGenerationBound(observed.Generation); err != nil {\n471|\t\treturn false, refuse(CodeProtocolError, \"status report generation\")\n472|\t}\n473|\treturn observed.InstanceID == body.TerminalInstanceID &&\n474|\t\tobserved.BackendID == body.TerminalBackendID &&\n475|\t\tobserved.ImplVersion == body.ImplementationVersion &&\n476|\t\tobserved.ProtoVersion == body.ProtocolVersion &&\n477|\t\tobserved.Generation == body.BackendGeneration, nil\n478|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
