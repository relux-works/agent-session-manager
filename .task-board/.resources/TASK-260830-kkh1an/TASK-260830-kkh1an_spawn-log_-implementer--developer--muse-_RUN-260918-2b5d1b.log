{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d12d","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":1777,"recorded_at":1780531400003549,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"call_id":"call_01a0b23dcedd754e893dec833bac4ebe","text":"Read text file `internal/terminstance/execute_test.go`.\n(183 line(s) above)\n184|func TestExecutePreEffectErrorsRestoreSource(t *testing.T) {\n185|\tt.Run(\"entry auth expired\", func(t *testing.T) {\n186|\t\tbackend := newMockBackend()\n187|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n188|\t\tengine.Now = fixtureLater\n189|\t\tcontext, params, source, admitted := quiesceFixture(t)\n190|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n191|\t\trequireRefusal(t, err, \"terminal_backend_unauthorized\", \"ax authorization expiry\")\n192|\t\trequireLiteral(t, \"after\", string(result.After), \"active\")\n193|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"new_authorization\")\n194|\t\tif _, found, _ := engine.Store.Lookup(context.IdempotencyKey); found {\n195|\t\t\tt.Error(\"Lookup(key) found a receipt for the unauthorized request, want none bound\")\n196|\t\t}\n197|\t})\n198|\n199|\tt.Run(\"entry generation stale\", func(t *testing.T) {\n200|\t\tbackend := newMockBackend()\n201|\t\tengine := testEngine(t, backend, testLease(), \"generation-two\")\n202|\t\tcontext, params, source, admitted := quiesceFixture(t)\n203|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n204|\t\trequireRefusal(t, err, \"terminal_backend_stale_generation\", \"backend_generation stale\")\n205|\t\trequireLiteral(t, \"after\", string(result.After), \"active\")\n206|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"status_first\")\n207|\t\tif _, found, _ := engine.Store.Lookup(context.IdempotencyKey); found {\n208|\t\t\tt.Error(\"Lookup(key) found a receipt for the stale request, want none bound\")\n209|\t\t}\n210|\t})\n211|\n212|\tt.Run(\"coded backend refusal on first effect\", func(t *testing.T) {\n213|\t\tbackend := newMockBackend()\n214|\t\tbackend.effectErrors[terminalbackend.EffectInputClosed] = refuse(\"terminal_backend_timeout\", \"test timeout\")\n215|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n216|\t\tcontext, params, source, admitted := quiesceFixture(t)\n217|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n218|\t\trequireRefusal(t, err, \"terminal_backend_timeout\", \"backend effect refused\")\n219|\t\trequireLiteral(t, \"after\", string(result.After), \"active\")\n220|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"replay_same\")\n221|\t})\n222|\n223|\tt.Run(\"illegal source refuses\", func(t *testing.T) {\n224|\t\tbackend := newMockBackend()\n225|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n226|\t\tcontext, params, _, admitted := quiesceFixture(t)\n227|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, mustParseState(t, \"stopped\"), admitted)\n228|\t\trequireRefusal(t, err, \"local_precondition_failed\", \"lifecycle transition\")\n229|\t\trequireLiteral(t, \"after\", string(result.After), \"stopped\")\n230|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"status_first\")\n231|\t\tif len(backend.performed()) != 0 {\n232|\t\t\tt.Errorf(\"performed = %v, want no effects on the illegal source\", backend.performed())\n233|\t\t}\n234|\t})\n235|\n236|\tt.Run(\"missing conferral refuses at the landed gate\", func(t *testing.T) {\n237|\t\tbackend := newMockBackend()\n238|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n239|\t\tcontext, params, source, _ := quiesceFixture(t)\n240|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, testAdmitted(\"durable_disconnect\"))\n241|\t\trequireRefusal(t, err, \"terminal_backend_capability_unproven\", \"operation capability dependency\")\n242|\t\trequireLiteral(t, \"after\", string(result.After), \"active\")\n243|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"required_operator_action\")\n244|\t})\n245|}\n246|\n247|// TestExecuteEntryDeadlineCodes pins the per-row timeout vocabulary for\n248|// the entry deadline cancel: quiesce cancels terminal_backend_timeout,\n249|// wait cancels quiesce_timeout and stop cancels stop_timeout, each\n250|// restoring the source with replay_same.\n251|func TestExecuteEntryDeadlineCodes(t *testing.T) {\n252|\tpast := fixturePastDeadline()\n253|\tcases := []struct {\n254|\t\toperation terminalbackend.Operation\n255|\t\tbuild     func(t *testing.T) (MutationContext, Params, terminalbackend.InstanceState, terminalbackend.Admitted)\n256|\t\tcode      string\n257|\t\tsource    string\n258|\t}{\n259|\t\t{terminalbackend.OperationQuiesceInput, func(t *testing.T) (MutationContext, Params, terminalbackend.InstanceState, terminalbackend.Admitted) {\n260|\t\t\treturn quiesceFixture(t)\n261|\t\t}, \"terminal_backend_timeout\", \"active\"},\n262|\t\t{terminalbackend.OperationWaitSafeBoundary, func(t *testing.T) (MutationContext, Params, terminalbackend.InstanceState, terminalbackend.Admitted) {\n263|\t\t\treturn waitFixture(t, ProofAXCheckpointBoundary)\n264|\t\t}, \"quiesce_timeout\", \"quiescing\"},\n265|\t\t{terminalbackend.OperationRequestStop, func(t *testing.T) (MutationContext, Params, terminalbackend.InstanceState, terminalbackend.Admitted) {\n266|\t\t\treturn stopFixture(t)\n267|\t\t}, \"stop_timeout\", \"quiescing\"},\n268|\t}\n269|\tfor _, tc := range cases {\n270|\t\tt.Run(string(tc.operation), func(t *testing.T) {\n271|\t\t\tbackend := newMockBackend()\n272|\t\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n273|\t\t\tengine.Now = func() time.Time { return past }\n274|\t\t\tcontext, params, source, admitted := tc.build(t)\n275|\t\t\tresult, err := engine.ExecuteMutating(contextGo(), tc.operation, context, params, source, admitted)\n276|\t\t\trequireRefusal(t, err, tc.code, \"operation deadline\")\n277|\t\t\trequireLiteral(t, \"after\", string(result.After), tc.source)\n278|\t\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"replay_same\")\n279|\t\t\tif len(backend.performed()) != 0 {\n280|\t\t\t\tt.Errorf(\"performed = %v, want no effects on the deadline cancel\", backend.performed())\n281|\t\t\t}\n282|\t\t\tif _, found, _ := engine.Store.Lookup(context.IdempotencyKey); found {\n283|\t\t\t\tt.Errorf(\"Lookup(key) found a receipt for the expired request, want none bound\")\n284|\t\t\t}\n285|\t\t})\n286|\t}\n287|}\n288|\n289|func waitFixture(t *testing.T, kind ProviderProofKind) (MutationContext, Params, terminalbackend.InstanceState, terminalbackend.Admitted) {\n290|\tt.Helper()\n291|\tkey := fixtureInstance + \"/boundary/\" + fixtureQuiescence + \"/\" + string(kind)\n292|\traw := contextDoc(fixtureOperation, fixtureSessionA, fixtureInstance, fixtureBackend, fixtureImpl, fixtureProto, fixtureGen, key, fixtureDeadline, authDoc(\"1\", nil))\n293|\tcontext, err := ParseMutationContext([]byte(raw))\n294|\tif err != nil {\n295|\t\tt.Fatalf(\"ParseMutationContext(wait) error = %v\", err)\n296|\t}\n297|\tparams := Params{QuiescenceGeneration: fixtureQuiescence, ProviderProofKind: kind, TimeoutMs: 1000}\n298|\treturn context, params, mustParseState(t, \"quiescing\"), testAdmitted(\"safe_boundary_observation\")\n299|}\n300|\n301|func stopFixture(t *testing.T) (MutationContext, Params, terminalbackend.InstanceState, terminalbackend.Admitted) {\n302|\tt.Helper()\n303|\tkey := fixtureInstance + \"/stop/\" + fixtureDigestB\n304|\traw := contextDoc(fixtureOperation, fixtureSessionA, fixtureInstance, fixtureBackend, fixtureImpl, fixtureProto, fixtureGen, key, fixtureDeadline, authDoc(\"1\", nil))\n305|\tcontext, err := ParseMutationContext([]byte(raw))\n306|\tif err != nil {\n307|\t\tt.Fatalf(\"ParseMutationContext(stop) error = %v\", err)\n308|\t}\n309|\tparams := Params{SafeBoundaryEvidenceID: fixtureDigestB, GracefulTimeoutMs: 1000}\n310|\treturn context, params, mustParseState(t, \"quiescing\"), testAdmitted(\"graceful_stop\")\n311|}\n312|\n313|// TestExecutePostEffectErrorsMoveUnavailable proves an error after a\n314|// committed effect whose result cannot be proven moves the local\n315|// observation to unavailable with status_first and never claims\n316|// absent: a coded refusal on the second stop effect, an uncoded\n317|// backend failure on the first effect, malformed success evidence,\n318|// and a refusal code outside the row set.\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
