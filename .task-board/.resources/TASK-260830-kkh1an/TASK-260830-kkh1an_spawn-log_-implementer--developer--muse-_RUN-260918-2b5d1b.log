{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cecb","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":1472,"recorded_at":1780531400002939,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"task_stream":{"kind":"task","id":"01a0b23c-937a-7f21-ba2f-7efb7d442853"},"task_id":"01a0b23c-937a-7f21-ba2f-7efb7d442853","event":{"kind":"output","task_id":"01a0b23c-937a-7f21-ba2f-7efb7d442853","chunk":"Read text file `internal/fencing/gate.go`.\n(289 line(s) above)\n290|// Arm order is precedence: malformed calls die first, then foreign\n291|// sessions, then ownership presence and verifiability, then the\n292|// fencing grant, then ownership direction (the operative fact beats\n293|// the credential: a stale token under a remote winner parks remote,\n294|// it does not report stale), then the exact tuple match.\n295|func Authorize(operation Operation, presented PresentedToken, observation Observation) (LeaseToken, error) {\n296|\tif !validOperation(operation) {\n297|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"unknown fencing operation %q\", string(operation))\n298|\t}\n299|\tif _, err := scalar.ParseUUIDv7(presented.SessionID); err != nil {\n300|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"presented fencing token session %q is not a UUIDv7: %v\", presented.SessionID, err)\n301|\t}\n302|\tif presented.Epoch == 0 {\n303|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"presented fencing token carries epoch 0, want an epoch at or above 1\")\n304|\t}\n305|\tif _, err := scalar.ParseUUIDv4(presented.LeaseID); err != nil {\n306|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"presented fencing token lease %q is not a UUIDv4: %v\", presented.LeaseID, err)\n307|\t}\n308|\tif presented.SessionID != observation.SessionID {\n309|\t\treturn LeaseToken{}, refuse(ErrLeaseConflict, \"presented fencing token for session %s does not authorize session %s\", presented.SessionID, observation.SessionID)\n310|\t}\n311|\tif !observation.HasWinner {\n312|\t\tif launchClass(operation) {\n313|\t\t\treturn LeaseToken{}, park(ParkRestorePolicy, \"\", ErrLeaseConflict)\n314|\t\t}\n315|\t\treturn LeaseToken{}, refuse(ErrLeaseConflict, \"no winning lease is established for session %s\", observation.SessionID)\n316|\t}\n317|\tif observation.Winner.Epoch == 0 || !validLeaseID(observation.Winner.LeaseID) || !validHostID(observation.Winner.HolderHostID) {\n318|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"fencing observation for session %s carries no well-formed winning lease\", observation.SessionID)\n319|\t}\n320|\tif !observation.Verified {\n321|\t\tif launchClass(operation) {\n322|\t\t\treturn LeaseToken{}, park(ParkRestorePolicy, observation.Winner.LeaseID, ErrLeaseConflict)\n323|\t\t}\n324|\t\treturn LeaseToken{}, refuse(ErrLeaseConflict, \"ownership of session %s is unverified; refresh lease knowledge first\", observation.SessionID)\n325|\t}\n326|\tif observation.Ambiguous {\n327|\t\tif launchClass(operation) {\n328|\t\t\treturn LeaseToken{}, park(ParkRestorePolicy, observation.Winner.LeaseID, ErrLeaseConflict)\n329|\t\t}\n330|\t\treturn LeaseToken{}, refuse(ErrLeaseConflict, \"ownership of session %s is ambiguous; resolve the union rival first\", observation.SessionID)\n331|\t}\n332|\tif observation.HandoffFailed {\n333|\t\tif launchClass(operation) {\n334|\t\t\treturn LeaseToken{}, park(ParkFailedHandoff, observation.Winner.LeaseID, ErrLeaseConflict)\n335|\t\t}\n336|\t\treturn LeaseToken{}, refuse(ErrLeaseConflict, \"handoff for session %s already failed; a losing lease must never activate\", observation.SessionID)\n337|\t}\n338|\tif !observation.HasGrant {\n339|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"fencing observation for session %s carries no grant; validate the winning token first\", observation.SessionID)\n340|\t}\n341|\tif observation.Now.IsZero() {\n342|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"fencing observation for session %s carries no clock reading; expiry cannot be checked\", observation.SessionID)\n343|\t}\n344|\tif err := sessrepo.CheckFencingExpiry(observation.Grant, observation.Policy, observation.Now); err != nil {\n345|\t\tif errors.Is(err, sessrepo.ErrFencingExpired) {\n346|\t\t\treturn LeaseToken{}, refuse(ErrLeaseConflict, \"fencing grant for session %s lapsed; revalidate the winning token\", observation.SessionID)\n347|\t\t}\n348|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"fencing observation for session %s carries an unusable refresh policy\", observation.SessionID)\n349|\t}\n350|\tif observation.Winner.HolderHostID != observation.LocalHostID {\n351|\t\tif launchClass(operation) {\n352|\t\t\treturn LeaseToken{}, park(ParkRemoteOwner, observation.Winner.LeaseID, ErrNotOwner)\n353|\t\t}\n354|\t\treturn LeaseToken{}, refuse(ErrNotOwner, \"session %s is owned by remote host %s\", observation.SessionID, observation.Winner.HolderHostID)\n355|\t}\n356|\tepochsEqual := presented.Epoch == observation.Winner.Epoch\n357|\tif !epochsEqual {\n358|\t\tif presented.Epoch < observation.Winner.Epoch {\n359|\t\t\tif launchClass(operation) {\n360|\t\t\t\treturn LeaseToken{}, park(ParkStaleOwner, observation.Winner.LeaseID, ErrStaleOwner)\n361|\t\t\t}\n362|\t\t\treturn LeaseToken{}, refuse(ErrStaleOwner, \"presented epoch %d precedes winning epoch %d for session %s\", presented.Epoch, observation.Winner.Epoch, observation.SessionID)\n363|\t\t}\n364|\t\tif launchClass(operation) {\n365|\t\t\treturn LeaseToken{}, park(ParkRestorePolicy, observation.Winner.LeaseID, ErrLeaseConflict)\n366|\t\t}\n367|\t\treturn LeaseToken{}, refuse(ErrLeaseConflict, \"presented epoch %d names no known lease for session %s\", presented.Epoch, observation.SessionID)\n368|\t}\n369|\tif presented.LeaseID != observation.Winner.LeaseID {\n370|\t\tif launchClass(operation) {\n371|\t\t\treturn LeaseToken{}, park(ParkStaleOwner, observation.Winner.LeaseID, ErrLeaseConflict)\n372|\t\t}\n373|\t\treturn LeaseToken{}, refuse(ErrLeaseConflict, \"presented lease %s loses to winning lease %s at epoch %d\", presented.LeaseID, observation.Winner.LeaseID, observation.Winner.Epoch)\n374|\t}\n375|\treturn mintLeaseToken(observation.SessionID, observation.Winner.Epoch, observation.Winner.LeaseID), nil\n376|}\n377|\n378|// validLeaseID reports whether id parses as a fencing token UUID. The\n379|// scalar owner holds the grammar; this is only the boolean access the\n(more lines below)","final_result":true}}}
