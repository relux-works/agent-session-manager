{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d185","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":1821,"recorded_at":1780531400003637,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"task_stream":{"kind":"task","id":"01a0b23d-fe15-7b81-a3d0-ffde35cbe2ac"},"task_id":"01a0b23d-fe15-7b81-a3d0-ffde35cbe2ac","event":{"kind":"output","task_id":"01a0b23d-fe15-7b81-a3d0-ffde35cbe2ac","chunk":"Read text file `internal/terminstance/lifecycle_test.go`.\n(244 line(s) above)\n245|func TestExecuteOnlyQuiesceEntersQuiescing(t *testing.T) {\n246|\tquiesce := func(t *testing.T) (MutationContext, Params, terminalbackend.Admitted) {\n247|\t\tcontext, params, _, admitted := quiesceFixture(t)\n248|\t\treturn context, params, admitted\n249|\t}\n250|\twait := func(t *testing.T) (MutationContext, Params, terminalbackend.Admitted) {\n251|\t\tcontext, params, _, admitted := waitFixture(t, ProofAXCheckpointBoundary)\n252|\t\treturn context, params, admitted\n253|\t}\n254|\tstop := func(t *testing.T) (MutationContext, Params, terminalbackend.Admitted) {\n255|\t\tcontext, params, _, admitted := stopFixture(t)\n256|\t\treturn context, params, admitted\n257|\t}\n258|\tcreate := func(t *testing.T) (MutationContext, Params, terminalbackend.Admitted) {\n259|\t\tfixture := testCreateContext(t)\n260|\t\treturn fixture.context, fixture.params, testAdmitted(\"terminal_state_retention\")\n261|\t}\n262|\trows := []struct {\n263|\t\toperation terminalbackend.Operation\n264|\t\tsources   []string\n265|\t\tbuild     func(*testing.T) (MutationContext, Params, terminalbackend.Admitted)\n266|\t}{\n267|\t\t{terminalbackend.OperationQuiesceInput, []string{\"active\", \"parked\"}, quiesce},\n268|\t\t{terminalbackend.OperationWaitSafeBoundary, []string{\"quiescing\"}, wait},\n269|\t\t{terminalbackend.OperationRequestStop, []string{\"quiescing\"}, stop},\n270|\t\t{terminalbackend.OperationCreate, []string{\"absent\", \"stopped\"}, create},\n271|\t}\n272|\tfor _, row := range rows {\n273|\t\tfor _, source := range row.sources {\n274|\t\t\tt.Run(string(row.operation)+\"/\"+source, func(t *testing.T) {\n275|\t\t\t\tbackend := newMockBackend()\n276|\t\t\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n277|\t\t\t\tcontext, params, admitted := row.build(t)\n278|\t\t\t\tresult, err := engine.ExecuteMutating(contextGo(), row.operation, context, params, mustParseState(t, source), admitted)\n279|\t\t\t\tif err != nil {\n280|\t\t\t\t\tt.Fatalf(\"ExecuteMutating() error = %v\", err)\n281|\t\t\t\t}\n282|\t\t\t\tif result.After == terminalbackend.StateQuiescing && result.Before != terminalbackend.StateQuiescing && row.operation != terminalbackend.OperationQuiesceInput {\n283|\t\t\t\t\tt.Errorf(\"ExecuteMutating(%s) enters quiescing from %q\", row.operation, source)\n284|\t\t\t\t}\n285|\t\t\t\tif result.After == terminalbackend.StateCreating || result.After == terminalbackend.StateStaleFenced {\n286|\t\t\t\t\tt.Errorf(\"ExecuteMutating(%s) after = %q, want never creating or stale_fenced\", row.operation, result.After)\n287|\t\t\t\t}\n288|\t\t\t})\n289|\t\t}\n290|\t}\n291|\t// The error paths never synthesize quiescing, creating or\n292|\t// stale_fenced either: after is the source or unavailable.\n293|\tbackend := newMockBackend()\n294|\tbackend.effectErrors[terminalbackend.EffectGracefulStopRequested] = errors.New(\"transport died\")\n295|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n296|\tcontext, params, source, admitted := stopFixture(t)\n297|\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationRequestStop, context, params, source, admitted)\n298|\tif err == nil {\n299|\t\tt.Fatal(\"ExecuteMutating() = nil, want the uncoded failure\")\n300|\t}\n301|\trequireLiteral(t, \"after\", string(result.After), \"unavailable\")\n302|}\n303|\n304|// TestExecuteBackendRowErrorSets proves the exact admitted refusal sets\n305|// per engine row through the production entry: every listed code passes\n306|// through with its mapped disposition, and one code outside each row's\n307|// set is rejected with the protocol class.\n308|func TestExecuteBackendRowErrorSets(t *testing.T) {\n309|\t// quiesce-input admits terminal_backend_timeout and refuses\n310|\t// stop_timeout; wait-safe-boundary admits quiesce_timeout and\n311|\t// refuses terminal_backend_timeout; request-stop admits\n312|\t// stop_timeout and refuses quiesce_timeout.\n313|\tbackend := newMockBackend()\n314|\tbackend.effectErrors[terminalbackend.EffectInputClosed] = refuse(\"terminal_backend_timeout\", \"test timeout\")\n315|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n316|\tcontext, params, source, admitted := quiesceFixture(t)\n317|\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n318|\trequireRefusal(t, err, \"terminal_backend_timeout\", \"backend effect refused\")\n319|\trequireLiteral(t, \"disposition\", string(result.Disposition), \"replay_same\")\n320|\n321|\tbackendWait := newMockBackend()\n322|\tbackendWait.effectErrors[terminalbackend.EffectSafeBoundaryObserved] = refuse(\"quiesce_timeout\", \"test quiesce timeout\")\n323|\tengineWait := testEngine(t, backendWait, testLease(), fixtureGen)\n324|\twaitContext, waitParams, waitSource, waitAdmitted := waitFixture(t, ProofAXCheckpointBoundary)\n325|\twaitResult, err := engineWait.ExecuteMutating(contextGo(), terminalbackend.OperationWaitSafeBoundary, waitContext, waitParams, waitSource, waitAdmitted)\n326|\trequireRefusal(t, err, \"quiesce_timeout\", \"backend effect refused\")\n327|\trequireLiteral(t, \"wait after\", string(waitResult.After), \"quiescing\")\n328|\trequireLiteral(t, \"wait disposition\", string(waitResult.Disposition), \"replay_same\")\n329|\n330|\tbackendWaitOutside := newMockBackend()\n331|\tbackendWaitOutside.effectErrors[terminalbackend.EffectSafeBoundaryObserved] = refuse(\"terminal_backend_timeout\", \"test outside set\")\n332|\tengineWaitOutside := testEngine(t, backendWaitOutside, testLease(), fixtureGen)\n333|\twaitContext2, waitParams2, waitSource2, waitAdmitted2 := waitFixture(t, ProofAXCheckpointBoundary)\n334|\twaitContext2.OperationID = fixtureOperationB\n335|\t_, err = engineWaitOutside.ExecuteMutating(contextGo(), terminalbackend.OperationWaitSafeBoundary, waitContext2, waitParams2, waitSource2, waitAdmitted2)\n336|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"operation error vocabulary\")\n337|\n338|\tbackendStop := newMockBackend()\n339|\tbackendStop.effectErrors[terminalbackend.EffectBackendStoreClosed] = refuse(\"stop_timeout\", \"test stop timeout\")\n340|\tengineStop := testEngine(t, backendStop, testLease(), fixtureGen)\n341|\tstopContext, stopParams, stopSource, stopAdmitted := stopFixture(t)\n342|\tstopResult, err := engineStop.ExecuteMutating(contextGo(), terminalbackend.OperationRequestStop, stopContext, stopParams, stopSource, stopAdmitted)\n343|\trequireRefusal(t, err, \"stop_timeout\", \"backend effect refused\")\n344|\trequireLiteral(t, \"stop after\", string(stopResult.After), \"unavailable\")\n345|\trequireLiteral(t, \"stop disposition\", string(stopResult.Disposition), \"status_first\")\n346|\n347|\tbackendStopOutside := newMockBackend()\n348|\tbackendStopOutside.effectErrors[terminalbackend.EffectGracefulStopRequested] = refuse(\"quiesce_timeout\", \"test outside set\")\n349|\tengineStopOutside := testEngine(t, backendStopOutside, testLease(), fixtureGen)\n350|\tstopContext2, stopParams2, stopSource2, stopAdmitted2 := stopFixture(t)\n351|\tstopContext2.OperationID = fixtureOperationB\n352|\t_, err = engineStopOutside.ExecuteMutating(contextGo(), terminalbackend.OperationRequestStop, stopContext2, stopParams2, stopSource2, stopAdmitted2)\n353|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"operation error vocabulary\")\n354|}","final_result":true}}}
