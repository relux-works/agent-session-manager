ate.\",\n+    ),\n+    Mutant(\n+        name=\"N-body-scope\",\n+        path=f\"{PACKAGE}/bodies.go\",\n+        find=\"\\tif _, ok := operationBodyMembers[parsed]; !ok {\\n\",\n+        replace=\"\\tif _, ok := operationBodyMembers[parsed]; !ok && parsed != terminalbackend.OperationCreate {\\n\",\n+        count=1,\n+        run=\"TestParseOperationBodyScopeGate\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly create past the body scope map; the member-count arm then fires with a different detail, failing the scope killer.\",\n+    ),\n+    Mutant(\n+        name=\"N-body-members\",\n+        path=f\"{PACKAGE}/bodies.go\",\n+        find=\"\\tif len(object) != len(want) {\\n\",\n+        replace=\"\\tif len(object) != len(want) && len(object) != len(want)+1 {\\n\",\n+        count=1,\n+        run=\"TestParseOperationBodyRefusals\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly one-extra-member bodies, silently ignoring the smuggled member; other shapes still refuse.\",\n+    ),\n+    Mutant(\n+        name=\"N-store-sweep-age\",\n+        path=f\"{PACKAGE}/store.go\",\n+        find=\"\\t\\tif now.Sub(info.ModTime()) < stagingSweepAge {\\n\",\n+        replace='\\t\\tif now.Sub(info.ModTime()) < stagingSweepAge && !strings.HasSuffix(entry.Name(), \"-live.tmp\") {\\n',\n+        count=1,\n+        run=\"TestStoreSweepKeepsLiveStaging\",\n+        expect=\"KILLED\",\n+        note=\"Sweeps exactly live-suffixed young staging; other young files are still kept.\",\n+    ),\n+    Mutant(\n+        name=\"N-result-effects-sort\",\n+        path=f\"{PACKAGE}/result.go\",\n+        find=\"\\tsort.Slice(ordered, func(i, j int) bool { return ordered[i] < ordered[j] })\\n\",\n+        replace=\"\\tsort.Slice(ordered, func(i, j int) bool { return ordered[i] > ordered[j] })\\n\",\n+        count=1,\n+        run=\"TestBuildResultSortsEffectsAndEvidence\",\n+        expect=\"KILLED\",\n+        note=\"Reports exactly the inverted effect order; the evidence order still sorts ascending.\",\n+    ),\n+    Mutant(\n+        name=\"N-result-evidence-sort\",\n+        path=f\"{PACKAGE}/result.go\",\n+        find=\"\\tsort.Strings(orderedEvidence)\\n\",\n+        replace=\"\\tsort.Sort(sort.Reverse(sort.StringSlice(orderedEvidence)))\\n\",\n+        count=1,\n+        run=\"TestBuildResultSortsEffectsAndEvidence\",\n+        expect=\"KILLED\",\n+        note=\"Reports exactly the inverted evidence order; the effect order still sorts ascending.\",\n+    ),\n+    Mutant(\n+        name=\"C-control\",\n+        path=f\"{PACKAGE}/doc.go\",\n","edit_facts":{"tool_name":"edit_file","path":"internal/terminstance/mutant_harness.py","added":173,"removed":3},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
