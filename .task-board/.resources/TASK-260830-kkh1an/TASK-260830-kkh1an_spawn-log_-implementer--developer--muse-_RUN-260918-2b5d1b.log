taging(dir string) {\n+\tentries, err := os.ReadDir(dir)\n+\tif err != nil {\n+\t\treturn\n+\t}\n+\tnow := time.Now()\n+\tfor _, entry := range entries {\n+\t\tif entry.IsDir() || !strings.HasSuffix(entry.Name(), \".tmp\") {\n+\t\t\tcontinue\n+\t\t}\n+\t\tinfo, err := entry.Info()\n+\t\tif err != nil {\n+\t\t\tcontinue\n+\t\t}\n+\t\tif now.Sub(info.ModTime()) < stagingSweepAge {\n+\t\t\tcontinue\n+\t\t}\n+\t\t_ = os.Remove(filepath.Join(dir, entry.Name()))\n+\t}\n+}\n","edit_facts":{"tool_name":"edit_file","path":"internal/terminstance/store.go","added":34,"removed":15},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
