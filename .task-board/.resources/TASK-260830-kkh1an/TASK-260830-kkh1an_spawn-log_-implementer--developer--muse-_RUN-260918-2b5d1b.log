Bind() identical retry installs fresh, want replay\")\n43|\t}\n44|\tif again != receipt {\n45|\t\tt.Errorf(\"Bind() replay = %+v, want %+v\", again, receipt)\n46|\t}\n47|\n48|\t_, _, err = store.Bind(key, terminalbackend.OperationWaitSafeBoundary, fixtureOperation)\n49|\trequireRefusal(t, err, \"idempotency_mismatch\", \"idempotency key conflict\")\n50|\n51|\t_, _, err = store.Bind(key, terminalbackend.OperationQuiesceInput, fixtureOperationB)\n52|\trequireRefusal(t, err, \"idempotency_mismatch\", \"idempotency key conflict\")\n53|}\n54|\n55|// TestStoreLookupAbsenceIsNotFailure proves a missing receipt reports\n56|// absence without an error, while a torn receipt file is an integrity\n57|// failure, never absence.\n58|func TestStoreLookupAbsenceIsNotFailure(t *testing.T) {\n59|\tstore := testStore(t)\n60|\tif _, found, err := store.Lookup(\"no/such/key\"); err != nil || found {\n61|\t\tt.Errorf(\"Lookup(absent) = (%v, %v), want (false, nil)\", found, err)\n62|\t}\n63|\n64|\tkey := \"torn/key\"\n65|\tif _, _, err := store.Bind(key, terminalbackend.OperationStatus, fixtureOperation); err != nil {\n66|\t\tt.Fatalf(\"Bind() error = %v\", err)\n67|\t}\n68|\t// Corrupt the committed file in place: the link is immutable but\n69|\t// the bytes are host-local, so corruption must read corrupt.\n70|\tentries, err := os.ReadDir(filepath.Join(store.base, \"pending\"))\n71|\tif err != nil {\n72|\t\tt.Fatalf(\"ReadDir() error = %v\", err)\n73|\t}\n74|\tfor _, entry := range entries {\n75|\t\tif len(entry.Name()) == 64 {\n76|\t\t\tif err := os.WriteFile(filepath.Join(store.base, \"pending\", entry.Name()), []byte(\"torn\"), 0o600); err != nil {\n77|\t\t\t\tt.Fatalf(\"WriteFile() error = %v\", err)\n78|\t\t\t}\n79|\t\t}\n80|\t}\n81|\t_, _, err = store.Lookup(key)\n82|\trequireRefusal(t, err, \"terminal_backend_integrity_failure\", \"idempotency receipt image\")\n83|}\n84|\n85|// TestStoreCompleteRequiresReceipt proves completion binds only a bound\n86|// key: identical completion replays, divergent completion is an\n87|// integrity failure, and completing an unbound key is a failed\n88|// precondition.\n89|func TestStoreCompleteRequiresReceipt(t *testing.T) {\n90|\tstore := testStore(t)\n91|\tkey := fixtureInstance + \"/quiesce/\" + fixtureQuiescence\n92|\n93|\trequireRefusal(t, store.Complete(key, []byte(`{}`)), \"local_precondition_failed\", \"idempotency completion without receipt\")\n94|\n95|\tif _, _, err := store.Bind(key, terminalbackend.OperationQuiesceInput, fixtureOperation); err != nil {\n96|\t\tt.Fatalf(\"Bind() error = %v\", err)\n97|\t}\n98|\tif _, found, err := store.Completed(key); err != nil || found {\n99|\t\tt.Fatalf(\"Completed() = (%v, %v), want (false, nil)\", found, err)\n100|\t}\n101|\tif err := store.Complete(key, []byte(`{\"after\":\"quiescing\"}`)); err != nil {\n102|\t\tt.Fatalf(\"Complete() error = %v\", err)\n103|\t}\n104|\tstored, found, err := store.Completed(key)\n105|\tif err != nil || !found {\n106|\t\tt.Fatalf(\"Completed() = (%v, %v), want the result\", found, err)\n107|\t}\n108|\trequireLiteral(t, \"result\", string(stored), `{\"after\":\"quiescing\"}`)\n109|\tif err := store.Complete(key, []byte(`{\"after\":\"quiescing\"}`)); err != nil {\n110|\t\tt.Fatalf(\"Complete() identical error = %v\", err)\n111|\t}\n112|\trequireRefusal(t, store.Complete(key, []byte(`{\"after\":\"stopped\"}`)), \"terminal_backend_integrity_failure\", \"idempotency result conflict\")\n113|}\n114|\n115|// TestStoreExportAgreesWithLedger proves the store encoding is the\n116|// landed ledger encoding: the exported bytes import through the landed\n117|// ImportLedger and replay the same receipts, and staging garbage is\n118|// never exported.\n119|func TestStoreExportAgreesWithLedger(t *testing.T) {\n120|\tstore := testStore(t)\n121|\tkeys := []string{\"b/key\", \"a/key\"}\n122|\tfor _, key := range keys {\n123|\t\tif _, _, err := store.Bind(key, terminalbackend.OperationStatus, fixtureOperation); err != nil {\n124|\t\t\tt.Fatalf(\"Bind(%q) error = %v\", key, err)\n125|\t\t}\n126|\t}\n127|\tif err := os.WriteFile(filepath.Join(store.base, \"pending\", \"receipt-stale.tmp\"), []byte(\"garbage\"), 0o600); err != nil {\n128|\t\tt.Fatalf(\"WriteFile() error = %v\", err)\n129|\t}\n130|\timage, err := store.Export()\n131|\tif err != nil {\n132|\t\tt.Fatalf(\"Export() error = %v\", err)\n133|\t}\n134|\trequireLiteral(t, \"export\", string(image),\n135|\t\t\"a/key\\nstatus\\n\"+fixtureOperation+\"\\n\"+\"b/key\\nstatus\\n\"+fixtureOperation+\"\\n\")\n136|\n137|\tledger, err := terminalbackend.ImportLedger(image)\n138|\tif err != nil {\n139|\t\tt.Fatalf(\"ImportLedger(store export) error = %v\", err)\n140|\t}\n141|\tfor _, key := range keys {\n142|\t\treceipt, known := ledger.Replay(key)\n143|\t\tif !known {\n144|\t\t\tt.Errorf(\"Replay(%q) unknown, want the receipt\", key)\n145|\t\t\tcontinue\n146|\t\t}\n147|\t\tif receipt.Operation != terminalbackend.OperationStatus || receipt.ResultID != fixtureOperation {\n148|\t\t\tt.Errorf(\"Replay(%q) = %+v, want the bound triple\", key, receipt)\n149|\t\t}\n150|\t}\n151|\tfresh := terminalbackend.NewLedger()\n152|\tfor _, key := range keys {\n153|\t\tif _, err := fresh.Bind(key, terminalbackend.OperationStatus, fixtureOperation); err != nil {\n154|\t\t\tt.Fatalf(\"Ledger.Bind(%q) error = %v\", key, err)\n155|\t\t}\n156|\t}\n157|\tif string(fresh.Export()) != string(image) {\n158|\t\tt.Errorf(\"ledger export = %q, store export = %q, want byte equality\", string(fresh.Export()), string(image))\n159|\t}\n160|}\n161|\n162|// TestStoreHookErrorKeepsReceipt proves the AfterCommit seam: a hook\n163|// error propagates to the caller but the committed receipt stands, so\n164|// the identical retry replays it.\n165|func TestStoreHookErrorKeepsReceipt(t *testing.T) {\n166|\tstore := testStore(t)\n167|\tkey := fixtureInstance + \"/quiesce/\" + fixtureQuiescence\n168|\thookErr := errTestHook\n169|\tstore.WithHooks(&StoreHooks{AfterCommit: func(string) error { return hookErr }})\n170|\tif _, _, err := store.Bind(key, terminalbackend.OperationQuiesceInput, fixtureOperation); err != hookErr {\n171|\t\tt.Fatalf(\"Bind() error = %v, want the hook error\", err)\n172|\t}\n173|\tstore.WithHooks(nil)\n174|\tif _, replayed, err := store.Bind(key, terminalbackend.OperationQuiesceInput, fixtureOperation); err != nil || !replayed {\n175|\t\tt.Fatalf(\"Bind() retry = (%v, %v), want (replay, nil)\", replayed, err)\n176|\t}\n177|}\n178|\n179|type hookError string\n180|\n181|func (err hookError) Error() string { return string(err) }\n182|\n183|const errTestHook = hookError(\"test hook failure\")","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
