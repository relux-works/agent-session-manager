eEpochFences\",\n+        expect=\"KILLED\",\n+        note=\"Authorizes through exactly the non-launch mutation entry, which refuses stale tokens instead of parking them; the stale observation no longer fences.\",\n+    ),\n+    Mutant(\n+        name=\"N-engine-timeout-code-stop\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find=\"\\tcase terminalbackend.OperationRequestStop:\\n\\t\\treturn CodeStopTimeout\\n\",\n+        replace=\"\\tcase terminalbackend.OperationRequestStop:\\n\\t\\treturn CodeQuiesceTimeout\\n\",\n+        count=1,\n+        run=\"TestExecuteEntryDeadlineCodes/request-stop\",\n+        expect=\"KILLED\",\n+        note=\"Reports exactly the stop deadline as quiesce_timeout; the wait row still reports its own.\",\n+    ),\n+    Mutant(\n+        name=\"N-engine-timeout-code-default\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find=\"\\tcase terminalbackend.OperationRequestStop:\\n\\t\\treturn CodeStopTimeout\\n\\tdefault:\\n\\t\\treturn CodeTimeout\\n\\t}\\n\",\n+        replace=\"\\tcase terminalbackend.OperationRequestStop:\\n\\t\\treturn CodeStopTimeout\\n\\tdefault:\\n\\t\\treturn CodeStopTimeout\\n\\t}\\n\",\n+        count=1,\n+        run=\"TestExecuteEntryDeadlineCodes/quiesce-input\",\n+        expect=\"KILLED\",\n+        note=\"Reports exactly the default-arm rows (create, quiesce) as stop_timeout; wait and stop still report their own.\",\n+    ),\n+    Mutant(\n+        name=\"N-engine-status-source\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find='\\tif source != \"\" {\\n',\n+        replace='\\tif source != \"\" && source != \"bogus\" {\\n',\n+        count=1,\n+        run=\"TestExecuteStatusAllSources\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the garbage test source past the status matrix; the scripted valid report then succeeds where the killer wants a refusal.\",\n+    ),\n+    Mutant(\n+        name=\"N-params-bootstrap\",\n+        path=f\"{PACKAGE}/context.go\",\n+        find=\"\\t\\tif _, err := scalar.ParseUUIDv7(params.BootstrapOperationID); err != nil {\\n\",\n+        replace='\\t\\tif _, err := scalar.ParseUUIDv7(params.BootstrapOperationID); err != nil && params.BootstrapOperationID != \"nope\" {\\n',\n+        count=1,\n+        run=\"TestCheckMutationContextParams\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the nope bootstrap; other malformed bootstraps still refuse.\",\n+    ),\n+    Mutant(\n+        name=\"N-params-quiescence-quiesce\",\n+        path=f\"{PACKAGE}/context.go\",\n+        find=\"\\tcase terminalbackend.OperationQuiesceInput:\\n\\t\\tif _, err := scalar.ParseUUIDv7(params.QuiescenceGeneration); err != nil {\\n\",\n+        replace='\\tcase terminalbackend.OperationQuiesceInput:\\n\\t\\tif _, err := scalar.ParseUUIDv7(params.QuiescenceGeneration); err != nil && params.QuiescenceGeneration != \"nope\" {\\n',\n+        count=1,\n+        run=\"TestCheckMutationContextParams\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the nope quiescence generation on the quiesce arm; the wait arm still refuses it.\",\n+    ),\n+    Mutant(\n+        name=\"N-params-quiescence-wait\",\n+        path=f\"{PACKAGE}/context.go\",\n+        find=\"\\tcase terminalbackend.OperationWaitSafeBoundary:\\n\\t\\tif _, err := scalar.ParseUUIDv7(params.QuiescenceGeneration); err != nil {\\n\",\n+        replace='\\tcase terminalbackend.OperationWaitSafeBoundary:\\n\\t\\tif _, err := scalar.ParseUUIDv7(params.QuiescenceGeneration); err != nil && params.QuiescenceGeneration != \"nope\" {\\n',\n+        count=1,\n+        run=\"TestCheckMutationContextParams\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the nope quiescence generation on the wait arm; the quiesce arm still refuses it.\",\n+    ),\n+    Mutant(\n+        name=\"N-params-proof\",\n+        path=f\"{PACKAGE}/context.go\",\n+        find=\"\\t\\tif _, err := ParseProviderProofKind(string(params.ProviderProofKind)); err != nil {\\n\",\n+        replace='\\t\\tif _, err := ParseProviderProofKind(string(params.ProviderProofKind)); err != nil && string(params.ProviderProofKind) != \"provider_restart\" {\\n',\n+        count=1,\n+        run=\"TestCheckMutationContextParams\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the provider_restart proof; other malformed proofs still refuse.\",\n+    ),\n+    Mutant(\n+        name=\"N-params-evidence\",\n+        path=f\"{PACKAGE}/context.go\",\n+        find=\"\\t\\tif _, err := scalar.ParseDigest(params.SafeBoundaryEvidenceID); err != nil {\\n\",\n+        replace='\\t\\tif _, err := scalar.ParseDigest(params.SafeBoundaryEvidenceID); err != nil && params.SafeBoundaryEvidenceID != \"not-a-digest\" {\\n',\n+        count=1,\n+        run=\"TestCheckMutationContextParams\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the not-a-digest stop evidence; other malformed evidence still refuses.\",\n+    ),\n+    Mutant(\n+        name=\"N-params-graceful\",\n+        path=f\"{PACKAGE}/context.go\",\n+        find=\"\\t\\tif params.GracefulTimeoutMs < 1 || params.GracefulTimeoutMs > 3600000 {\\n\",\n+        replace=\"\\t\\tif params.GracefulTimeoutMs < 1 || params.GracefulTimeoutMs > 3600001 {\\n\",\n+        count=1,\n+        run=\"TestCheckMutationContextParams\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly graceful timeout 3600001; other out-of-bound graceful timeouts still refuse.\",\n+    ),\n+    Mutant(\n+        name=\"N-version-delegation\",\n+        path=f\"{PACKAGE}/context.go\",\n+        find=\"\\tif err := terminalbackend.CheckVersionTuple(backendID, implementationVersion, protocolVersion, []string{protocolVersion}); err != nil {\\n\",\n+        replace='\\tif err := terminalbackend.CheckVersionTuple(backendID, implementationVersion, protocolVersion, []string{protocolVersion}); err != nil && backendID != \"example.backend\" {\\n',\n+        count=1,\n+        run=\"TestParseMutationContextMemberRefusals\",\n+        expect=\"KILLED\",\n+        note=\"Skips the landed version-tuple delegation for exactly the fixture backend; other backends still gate.\",\n+    ),\n+    Mutant(\n+        name=\"N-body-scope\",\n+        path=f\"{PACKAGE}/bodies.go\",\n+        find=\"\\tif _, ok := operationBodyMembers[parsed]; !ok {\\n\",\n+        replace=\"\\tif _, ok := operationBodyMembers[parsed]; !ok && parsed != terminalbackend.OperationCreate {\\n\",\n+        count=1,\n+        run=\"TestParseOperationBodyScopeGate\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly create past the body scope map; the member-count arm then fires with a different detail, failing the scope killer.\",\n+    ),\n+    Mutant(\n+        name=\"N-body-members\",\n+        path=f\"{PACKAGE}/bodies.go\",\n+        find=\"\\tif len(object) != len(want) {\\n\",\n+        replace=\"\\tif len(object) != len(want) && len(object) != len(want)+1 {\\n\",\n+        count=1,\n+        run=\"TestParseOperationBodyRefusals\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly one-extra-member bodies, silently ignoring the smuggled member; other shapes still refuse.\",\n+    ),\n+    Mutant(\n+        name=\"N-store-sweep-age\",\n+        path=f\"{PACKAGE}/store.go\",\n+        find=\"\\t\\tif now.Sub(info.ModTime()) < stagingSweepAge {\\n\",\n+        replace='\\t\\tif now.Sub(info.ModTime()) < stagingSweepAge && !strings.HasSuffix(entry.Name(), \"-live.tmp\") {\\n',\n+        count=1,\n+        run=\"TestStoreSweepKeepsLiveStaging\",\n+        expect=\"KILLED\",\n+        note=\"Sweeps exactly live-suffixed young staging; other young files are still kept.\",\n+    ),\n+    Mutant(\n+        name=\"N-result-effects-sort\",\n+        path=f\"{PACKAGE}/result.go\",\n+        find=\"\\tsort.Slice(ordered, func(i, j int) bool { return ordered[i] < ordered[j] })\\n\",\n+        replace=\"\\tsort.Slice(ordered, func(i, j int) bool { return ordered[i] > ordered[j] })\\n\",\n+        count=1,\n+        run=\"TestBuildResultSortsEffectsAndEvidence\",\n+        expect=\"KILLED\",\n+        note=\"Reports exactly the inverted effect order; the evidence order still sorts ascending.\",\n+    ),\n+    Mutant(\n+        name=\"N-result-evidence-sort\",\n+        path=f\"{PACKAGE}/result.go\",\n+        find=\"\\tsort.Strings(orderedEvidence)\\n\",\n+        replace=\"\\tsort.Sort(sort.Reverse(sort.StringSlice(orderedEvidence)))\\n\",\n+        count=1,\n+        run=\"TestBuildResultSortsEffectsAndEvidence\",\n+        expect=\"KILLED\",\n+        note=\"Reports exactly the inverted evidence order; the effect order still sorts ascending.\",\n+    ),\n+    Mutant(\n+        name=\"C-control\",\n+        path=f\"{PACKAGE}/doc.go\",\n","final_result":true}}}
