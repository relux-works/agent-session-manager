{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cdf9","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":1367,"recorded_at":1780531400002729,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"task_stream":{"kind":"task","id":"01a0b23c-17f3-7ed2-83b1-3ded66f9870c"},"task_id":"01a0b23c-17f3-7ed2-83b1-3ded66f9870c","event":{"kind":"output","task_id":"01a0b23c-17f3-7ed2-83b1-3ded66f9870c","chunk":"Read text file `internal/terminalbackend/manifest.go`.\n(1593 line(s) above)\n1594|type Admitted struct {\n1595|\tCapabilities []string\n1596|\tEvidenceIDs  []string\n1597|}\n1598|\n1599|// Has reports whether capability is an admitted true claim.\n1600|func (admitted Admitted) Has(capability string) bool {\n1601|\tfor _, member := range admitted.Capabilities {\n1602|\t\tif member == capability {\n1603|\t\t\treturn true\n1604|\t\t}\n1605|\t}\n1606|\treturn false\n1607|}\n1608|\n1609|// HasOperation reports whether any admitted true capability confers the\n1610|// operation through its registry dependent_operations.\n1611|func (admitted Admitted) HasOperation(operation string) bool {\n1612|\tfor _, capability := range admitted.Capabilities {\n1613|\t\trow, known := capabilityRegistry[capability]\n1614|\t\tif !known {\n1615|\t\t\tcontinue\n1616|\t\t}\n1617|\t\tfor _, conferred := range row.dependentOperations {\n1618|\t\t\tif conferred == operation {\n1619|\t\t\t\treturn true\n1620|\t\t\t}\n1621|\t\t}\n1622|\t}\n1623|\treturn false\n1624|}\n1625|\n1626|// CapabilitiesForOperation returns the sorted registry capabilities whose\n1627|// dependent_operations confer the operation. manifest and probe confer\n1628|// through no capability and return an empty set: they carry no capability\n1629|// dependency. An unknown operation is refused: the operation vocabulary is\n1630|// closed.\n1631|func CapabilitiesForOperation(operation string) ([]string, error) {\n1632|\tif !operationVocabulary[operation] {\n1633|\t\treturn nil, mismatchf(\"operation vocabulary\")\n1634|\t}\n1635|\tvar capabilities []string\n1636|\tfor capability, row := range capabilityRegistry {\n1637|\t\tfor _, conferred := range row.dependentOperations {\n1638|\t\t\tif conferred == operation {\n1639|\t\t\t\tcapabilities = append(capabilities, capability)\n1640|\t\t\t\tbreak\n1641|\t\t\t}\n1642|\t\t}\n1643|\t}\n1644|\treturn capabilities, nil\n1645|}\n1646|\n1647|// CheckOperation gates one operation against the admitted set. manifest and\n1648|// probe carry no capability dependency (§4.D): they are admitted for any\n1649|// admitted set, including the empty one. Every other operation must be in\n1650|// the closed vocabulary and conferred by at least one admitted true\n1651|// capability, or it is refused with CodeCapabilityUnproven. Conditional §4.C\n1652|// dependencies (interactivity, credential need, attach overlap, provider\n1653|// observation) are evaluated by the lifecycle owner at the operation call\n1654|// site; this gate proves only the capability-confers-operation half, which\n1655|// is the bound this file owns.\n1656|func CheckOperation(operation string, admitted Admitted) error {\n1657|\tif !operationVocabulary[operation] {\n1658|\t\treturn mismatchf(\"operation vocabulary\")\n1659|\t}\n1660|\tif operation == \"manifest\" || operation == \"probe\" {\n1661|\t\treturn nil\n1662|\t}\n1663|\tif !admitted.HasOperation(operation) {\n1664|\t\treturn refuse(&Error{Code: CodeCapabilityUnproven, Detail: \"operation capability dependency\"})\n1665|\t}\n1666|\treturn nil\n1667|}\n1668|\n1669|// Reconcile admits one Probe against its Manifest with the returned\n1670|// evidence set, binding everything to the AX-known raw generation and the\n1671|// admission instant (§4.B keyed relation, §4.D evidence binding). The check\n1672|// order is deterministic: identity equality, protocol/platform membership,\n1673|// generation binding, claim relation, per-object evidence usability\n1674|// (tuple binding, liveness, signature), per-claim requirement coverage,\n1675|// then the exact evidence_ids set rule. The first failure wins; every\n1676|// failure fails closed before activation.\n1677|//\n1678|// Each supplied evidence object must independently prove its named claim:\n1679|// split-facts evidence (requirement coverage spread across several objects,\n1680|// none sufficient alone) is refused. That reading follows the singular\n1681|// rule-5 phrasing (\"Capability Evidence ... satisfies every listed evidence\n1682|// requirement\") and is stated here as the bound.\n1683|func Reconcile(manifest Manifest, probe Probe, evidence []Evidence, rawGeneration string, now time.Time, verify SignatureVerifier) (Admitted, error) {\n1684|\tif verify == nil {\n1685|\t\treturn Admitted{}, integrityFailure(\"evidence signature verifier\")\n1686|\t}\n1687|\t// Both identities pass ParseID before any check runs, like\n1688|\t// CheckVersionTuple and CheckProviderDescriptor already do: Manifest\n1689|\t// and Probe are plain structs any caller can build by hand, so the\n1690|\t// document admission in ParseManifest/ParseProbe cannot be the only\n1691|\t// validation. Without this gate a grammar-refused identity reaches\n1692|\t// checkProbeIdentity/checkProbeGeneration and renders verbatim into\n1693|\t// the refusal. A refused ID returns the ParseID refusal — whose\n1694|\t// bound and grammar arms carry no BackendID — and never reaches the\n1695|\t// naming arms.\n1696|\tif _, err := ParseID(manifest.TerminalBackendID); err != nil {\n1697|\t\treturn Admitted{}, err\n1698|\t}\n1699|\tif _, err := ParseID(probe.TerminalBackendID); err != nil {\n1700|\t\treturn Admitted{}, err\n1701|\t}\n1702|\tif err := checkProbeIdentity(manifest, probe); err != nil {\n1703|\t\treturn Admitted{}, err\n1704|\t}\n1705|\tif err := checkProbeMembership(manifest, probe); err != nil {\n1706|\t\treturn Admitted{}, err\n1707|\t}\n1708|\tif err := checkProbeGeneration(probe, rawGeneration); err != nil {\n1709|\t\treturn Admitted{}, err\n1710|\t}\n1711|\tmanifestClaims := indexClaims(manifest.StaticCapabilityClaims)\n1712|\tif err := checkClaimRelation(manifestClaims, probe.CapabilityClaims); err != nil {\n1713|\t\treturn Admitted{}, err\n1714|\t}\n1715|\tprobeClaims := indexClaims(probe.CapabilityClaims)\n1716|\tused, err := checkEvidenceSet(manifest, probe, probeClaims, evidence, now, verify)\n1717|\tif err != nil {\n1718|\t\treturn Admitted{}, err\n1719|\t}\n1720|\tif err := checkEvidenceCoverage(probeClaims, used); err != nil {\n1721|\t\treturn Admitted{}, err\n1722|\t}\n1723|\tif err := checkEvidenceIDs(probe, used); err != nil {\n(more lines below)","final_result":true}}}
