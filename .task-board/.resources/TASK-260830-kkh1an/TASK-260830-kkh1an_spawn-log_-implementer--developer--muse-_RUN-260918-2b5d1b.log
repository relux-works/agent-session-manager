{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d26b","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":1936,"recorded_at":1780531400003867,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"call_id":"call_01a0b23e58bb759faab8398dc687c32d","text":"Read text file `internal/terminstance/disposition_test.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"testing\"\n5|)\n6|\n7|// TestParseRetryDispositionClosed pins the four-member disposition\n8|// vocabulary at the production entry with literal assertions.\n9|func TestParseRetryDispositionClosed(t *testing.T) {\n10|\tfor _, disposition := range []string{\"replay_same\", \"status_first\", \"new_authorization\", \"required_operator_action\"} {\n11|\t\tif _, err := ParseRetryDisposition(disposition); err != nil {\n12|\t\t\tt.Errorf(\"ParseRetryDisposition(%q) error = %v, want admission\", disposition, err)\n13|\t\t}\n14|\t}\n15|\tfor _, disposition := range []string{\"retry\", \"REPLAY_SAME\", \"\", \"status-first\"} {\n16|\t\t_, err := ParseRetryDisposition(disposition)\n17|\t\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"retry disposition vocabulary\")\n18|\t}\n19|}\n20|\n21|// TestDispositionForMapping pins the leaf's per-code mapping literally:\n22|// each arm names its code and its committed/uncommitted disposition.\n23|func TestDispositionForMapping(t *testing.T) {\n24|\tcases := []struct {\n25|\t\tcode      string\n26|\t\tcommitted bool\n27|\t\twant      string\n28|\t}{\n29|\t\t{\"terminal_backend_unauthorized\", false, \"new_authorization\"},\n30|\t\t{\"terminal_backend_unauthorized\", true, \"new_authorization\"},\n31|\t\t{\"terminal_backend_timeout\", false, \"replay_same\"},\n32|\t\t{\"terminal_backend_timeout\", true, \"status_first\"},\n33|\t\t{\"quiesce_timeout\", false, \"replay_same\"},\n34|\t\t{\"quiesce_timeout\", true, \"status_first\"},\n35|\t\t{\"stop_timeout\", false, \"status_first\"},\n36|\t\t{\"stop_timeout\", true, \"status_first\"},\n37|\t\t{\"idempotency_mismatch\", false, \"status_first\"},\n38|\t\t{\"idempotency_mismatch\", true, \"status_first\"},\n39|\t\t{\"terminal_backend_stale_generation\", false, \"status_first\"},\n40|\t\t{\"terminal_backend_stale_generation\", true, \"status_first\"},\n41|\t\t{\"local_precondition_failed\", false, \"status_first\"},\n42|\t\t{\"local_precondition_failed\", true, \"status_first\"},\n43|\t\t{\"terminal_backend_unavailable\", false, \"status_first\"},\n44|\t\t{\"terminal_backend_unavailable\", true, \"status_first\"},\n45|\t\t{\"terminal_backend_capability_unproven\", false, \"required_operator_action\"},\n46|\t\t{\"terminal_backend_capability_unproven\", true, \"status_first\"},\n47|\t\t{\"terminal_backend_integrity_failure\", false, \"required_operator_action\"},\n48|\t\t{\"terminal_backend_integrity_failure\", true, \"status_first\"},\n49|\t\t{\"terminal_backend_process_failed\", false, \"required_operator_action\"},\n50|\t\t{\"terminal_backend_process_failed\", true, \"status_first\"},\n51|\t\t{\"terminal_backend_protocol_error\", false, \"required_operator_action\"},\n52|\t\t{\"terminal_backend_protocol_error\", true, \"status_first\"},\n53|\t\t{\"something_unknown\", false, \"required_operator_action\"},\n54|\t\t{\"something_unknown\", true, \"status_first\"},\n55|\t}\n56|\tfor _, tc := range cases {\n57|\t\tif got := DispositionFor(tc.code, tc.committed); string(got) != tc.want {\n58|\t\t\tt.Errorf(\"DispositionFor(%q, committed=%v) = %q, want literal %q\", tc.code, tc.committed, string(got), tc.want)\n59|\t\t}\n60|\t}\n61|}\n62|\n63|// TestParseProviderProofKindClosed pins the three-member proof vocabulary\n64|// at the production entry with literal assertions.\n65|func TestParseProviderProofKindClosed(t *testing.T) {\n66|\tfor _, kind := range []string{\"provider_quiescence\", \"provider_process_exit\", \"ax_checkpoint_boundary\"} {\n67|\t\tif _, err := ParseProviderProofKind(kind); err != nil {\n68|\t\t\tt.Errorf(\"ParseProviderProofKind(%q) error = %v, want admission\", kind, err)\n69|\t\t}\n70|\t}\n71|\tfor _, kind := range []string{\"provider_restart\", \"PROVIDER_QUIESCENCE\", \"\"} {\n72|\t\t_, err := ParseProviderProofKind(kind)\n73|\t\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"provider proof vocabulary\")\n74|\t}\n75|}\n76|\n77|// TestRequiresProviderObservation pins the provider-kind classification:\n78|// the two provider kinds require provider observation, the AX boundary\n79|// does not.\n80|func TestRequiresProviderObservation(t *testing.T) {\n81|\tif !RequiresProviderObservation(ProofProviderQuiescence) {\n82|\t\tt.Error(\"RequiresProviderObservation(provider_quiescence) = false, want true\")\n83|\t}\n84|\tif !RequiresProviderObservation(ProofProviderProcessExit) {\n85|\t\tt.Error(\"RequiresProviderObservation(provider_process_exit) = false, want true\")\n86|\t}\n87|\tif RequiresProviderObservation(ProofAXCheckpointBoundary) {\n88|\t\tt.Error(\"RequiresProviderObservation(ax_checkpoint_boundary) = true, want false\")\n89|\t}\n90|}\n91|\n92|// TestParseAuthorizationKindClosed pins the four-member kind vocabulary\n93|// at the production entry with literal assertions.\n94|func TestParseAuthorizationKindClosed(t *testing.T) {\n95|\tfor _, kind := range []string{\"create\", \"control\", \"force_stale\", \"restore\"} {\n96|\t\tif _, err := ParseAuthorizationKind(kind); err != nil {\n97|\t\t\tt.Errorf(\"ParseAuthorizationKind(%q) error = %v, want admission\", kind, err)\n98|\t\t}\n99|\t}\n100|\tfor _, kind := range []string{\"admin\", \"CREATE\", \"\", \"force-stale\"} {\n101|\t\t_, err := ParseAuthorizationKind(kind)\n102|\t\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"ax authorization kind\")\n103|\t}\n104|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d26d","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":1937,"recorded_at":1780531400003869,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"call_id":"call_01a0b23e5a307564af801408528e7d51","text":"Read text file `internal/terminstance/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/terminstance.\n3|\n4|Every gate ships a narrowing mutant: the gate stays present and is\n5|weakened to admit exactly one member of the class it must reject, and\n6|the named killer test must fail. A delete-only mutant proves only that\n7|the gate exists and is not accepted as evidence.\n8|\n9|Each row runs M (mutate one production file in place), R (run the\n10|scoped Go killer through the production entry point), V (verdict from\n11|the Go exit code plus a FAIL kill-line: KILLED iff R fails with a test\n12|failure line, SURVIVED iff R passes, ERROR for anything else —\n13|unapplied patches, build breaks, timeouts). M failures and R\n14|infrastructure errors are ERROR, never kills or survivals. The file is\n15|restored from its backup after every row, pass or fail.\n16|\n17|Row C-control is the harmless control: a comment-only edit that\n18|must SURVIVE, proving the harness observes test outcomes instead of\n19|hard-coding kills.\n20|\n21|Usage:\n22|  PYTHONDONTWRITEBYTECODE=1 python3 internal/terminstance/mutant_harness.py\n23|  PYTHONDONTWRITEBYTECODE=1 python3 internal/terminstance/mutant_harness.py N-auth-epoch-low\n24|\"\"\"\n25|\n26|import os\n27|import shutil\n28|import subprocess\n29|import sys\n30|import tempfile\n31|from dataclasses import dataclass\n32|from pathlib import Path\n33|\n34|REPO = Path(__file__).resolve().parents[2]\n35|PACKAGE = \"internal/terminstance\"\n36|\n37|\n38|@dataclass(frozen=True)\n39|class Mutant:\n40|    name: str\n41|    path: str\n42|    find: str\n43|    replace: str\n44|    count: int\n45|    run: str\n46|    expect: str\n47|    note: str\n48|\n49|\n50|MUTANTS = [\n51|    Mutant(\n52|        name=\"N-auth-epoch-low\",\n53|        path=f\"{PACKAGE}/auth.go\",\n54|        find='\\tleaseEpoch, ok := environ.CheckUint53Bounds(members[\"lease_epoch\"], 1, MaxLeaseEpoch)\\n',\n55|        replace='\\tleaseEpoch, ok := environ.CheckUint53Bounds(members[\"lease_epoch\"], 0, MaxLeaseEpoch)\\n',\n56|        count=1,\n57|        run=\"TestParseAXAuthorizationEpochBound\",\n58|        expect=\"KILLED\",\n59|        note=\"Admits exactly epoch 0; every other out-of-range epoch still refuses.\",\n60|    ),\n61|    Mutant(\n62|        name=\"N-auth-epoch-high\",\n63|        path=f\"{PACKAGE}/auth.go\",\n64|        find='\\tleaseEpoch, ok := environ.CheckUint53Bounds(members[\"lease_epoch\"], 1, MaxLeaseEpoch)\\n',\n65|        replace='\\tleaseEpoch, ok := environ.CheckUint53Bounds(members[\"lease_epoch\"], 1, MaxLeaseEpoch-1)\\n',\n66|        count=1,\n67|        run=\"TestParseAXAuthorizationEpochBound\",\n68|        expect=\"KILLED\",\n69|        note=\"TIGHTENING (the weakening direction is equivalent: environ refuses 2^53 at the number layer, so no weakening past MaxLeaseEpoch is observable; this row proves the edge is exactly 9007199254740991 by refusing it).\",\n70|    ),\n71|    Mutant(\n72|        name=\"N-auth-kind\",\n73|        path=f\"{PACKAGE}/auth.go\",\n74|        find='\\tdefault:\\n\\t\\treturn \"\", refuse(CodeProtocolError, \"ax authorization kind\")\\n\\t}\\n',\n75|        replace='\\tdefault:\\n\\t\\tif value == \"admin\" {\\n\\t\\t\\treturn AuthorizationControl, nil\\n\\t\\t}\\n\\t\\treturn \"\", refuse(CodeProtocolError, \"ax authorization kind\")\\n\\t}\\n',\n76|        count=1,\n77|        run=\"TestParseAXAuthorizationKindClosed\",\n78|        expect=\"KILLED\",\n79|        note=\"Admits exactly the admin kind; every other non-kind still refuses.\",\n80|    ),\n81|    Mutant(\n82|        name=\"N-auth-kind-binding\",\n83|        path=f\"{PACKAGE}/auth.go\",\n84|        find=\"\\tif auth.Kind != wantKind {\\n\",\n85|        replace=\"\\tif auth.Kind != wantKind && wantKind != AuthorizationCreate {\\n\",\n86|        count=1,\n87|        run=\"TestCheckAuthorizationRefusals/kind_mismatch\",\n88|        expect=\"KILLED\",\n89|        note=\"Admits exactly control authorizations presented as create; other mismatches still refuse.\",\n90|    ),\n91|    Mutant(\n92|        name=\"N-auth-expiry\",\n93|        path=f\"{PACKAGE}/auth.go\",\n94|        find=\"\\tif !now.Before(expires) {\\n\",\n95|        replace=\"\\tif !now.Before(expires) && !now.Equal(expires) {\\n\",\n96|        count=1,\n97|        run=\"TestCheckAuthorizationRefusals/expiry_edge_refuses\",\n98|        expect=\"KILLED\",\n99|        note=\"Admits exactly the expiry instant; past-expiry instants still refuse.\",\n100|    ),\n101|    Mutant(\n102|        name=\"N-auth-lease-id\",\n103|        path=f\"{PACKAGE}/auth.go\",\n104|        find=\"\\tif auth.LeaseID != lease.LeaseID {\\n\",\n105|        replace='\\tif auth.LeaseID != lease.LeaseID && lease.LeaseID != \"6ba7b810-9dad-41d1-80b4-00c04fd430c8\" {\\n',\n106|        count=1,\n107|        run=\"TestCheckAuthorizationRefusals/lease_identity_drift\",\n108|        expect=\"KILLED\",\n109|        note=\"Admits exactly the drifted test lease; other identity drifts still refuse.\",\n110|    ),\n111|    Mutant(\n112|        name=\"N-auth-lease-epoch\",\n113|        path=f\"{PACKAGE}/auth.go\",\n114|        find=\"\\tif auth.LeaseEpoch != lease.Epoch {\\n\",\n115|        replace=\"\\tif auth.LeaseEpoch != lease.Epoch && lease.Epoch != 2 {\\n\",\n116|        count=1,\n117|        run=\"TestCheckAuthorizationRefusals/lease_epoch_drift\",\n118|        expect=\"KILLED\",\n119|        note=\"Admits exactly the epoch-2 drift; other epoch drifts still refuse.\",\n120|    ),\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
