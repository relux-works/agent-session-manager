{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d2d1","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":1987,"recorded_at":1780531400003969,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"call_id":"call_01a0b23e909777bfbdce3091da4de0f4","text":"Read text file `internal/terminstance/mutant_harness.py`.\n(449 line(s) above)\n450|    ),\n451|    Mutant(\n452|        name=\"N-engine-timeout-code\",\n453|        path=f\"{PACKAGE}/execute.go\",\n454|        find=\"\\tcase terminalbackend.OperationWaitSafeBoundary:\\n\\t\\treturn CodeQuiesceTimeout\\n\",\n455|        replace=\"\\tcase terminalbackend.OperationWaitSafeBoundary:\\n\\t\\treturn CodeStopTimeout\\n\",\n456|        count=1,\n457|        run=\"TestExecuteEntryDeadlineCodes/wait-safe-boundary\",\n458|        expect=\"KILLED\",\n459|        note=\"Reports exactly the wait deadline as stop_timeout; the stop row still reports its own.\",\n460|    ),\n461|    Mutant(\n462|        name=\"N-engine-auth-entry\",\n463|        path=f\"{PACKAGE}/execute.go\",\n464|        find='\\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil {\\n\\t\\tfailure := err.(*Error)\\n\\t\\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\\n',\n465|        replace='\\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil && context.OperationID != \"0198f4c8-8e50-7f66-8f70-ccccccccccc1\" {\\n\\t\\tfailure := err.(*Error)\\n\\t\\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\\n',\n466|        count=1,\n467|        run=\"TestExecutePreEffectErrorsRestoreSource/entry_auth_expired\",\n468|        expect=\"KILLED\",\n469|        note=\"Skips the pre-bind auth gate for exactly the fixture operation; other operations still gate.\",\n470|    ),\n471|    Mutant(\n472|        name=\"N-engine-generation-entry\",\n473|        path=f\"{PACKAGE}/execute.go\",\n474|        find='\\tif engine.CurrentGeneration() != context.BackendGeneration {\\n\\t\\tfailure := refuse(CodeStaleGeneration, \"backend_generation stale\")\\n\\t\\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\\n',\n475|        replace='\\tif engine.CurrentGeneration() != context.BackendGeneration && context.OperationID != \"0198f4c8-8e50-7f66-8f70-ccccccccccc1\" {\\n\\t\\tfailure := refuse(CodeStaleGeneration, \"backend_generation stale\")\\n\\t\\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\\n',\n476|        count=1,\n477|        run=\"TestExecutePreEffectErrorsRestoreSource/entry_generation_stale\",\n478|        expect=\"KILLED\",\n479|        note=\"Skips the pre-bind generation gate for exactly the fixture operation; the loop recheck still refuses but the receipt is already bound.\",\n480|    ),\n481|    Mutant(\n482|        name=\"N-engine-recheck-auth\",\n483|        path=f\"{PACKAGE}/execute.go\",\n484|        find=\"\\t\\t\\treturn buildResult(context, source, source, performed, evidence, DispositionReplaySame), failure\\n\\t\\t}\\n\\t\\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil {\\n\",\n485|        replace=\"\\t\\t\\treturn buildResult(context, source, source, performed, evidence, DispositionReplaySame), failure\\n\\t\\t}\\n\\t\\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil && committed {\\n\",\n486|        count=1,\n487|        run=\"TestExecuteRechecksBeforeEachEffect/rotation_before_first_effect_restores_source\",\n488|        expect=\"KILLED\",\n489|        note=\"Skips the per-effect auth recheck exactly before the first effect; later rechecks stay.\",\n490|    ),\n491|    Mutant(\n492|        name=\"N-engine-recheck-generation\",\n493|        path=f\"{PACKAGE}/execute.go\",\n494|        find=\"\\t\\t\\treturn buildResult(context, source, after, performed, evidence, DispositionFor(failure.Code, committed)), failure\\n\\t\\t}\\n\\t\\tif engine.CurrentGeneration() != context.BackendGeneration {\\n\",\n495|        replace=\"\\t\\t\\treturn buildResult(context, source, after, performed, evidence, DispositionFor(failure.Code, committed)), failure\\n\\t\\t}\\n\\t\\tif engine.CurrentGeneration() != context.BackendGeneration && committed {\\n\",\n496|        count=1,\n497|        run=\"TestExecuteRechecksBeforeEachEffect/generation_rotation_before_first_effect_restores_source\",\n498|        expect=\"KILLED\",\n499|        note=\"Skips the per-effect generation recheck exactly before the first effect; later rechecks stay.\",\n500|    ),\n501|    Mutant(\n502|        name=\"N-engine-precommit-after\",\n503|        path=f\"{PACKAGE}/execute.go\",\n504|        find='\\t\\t\\tafter := source\\n\\t\\t\\tif committed {\\n\\t\\t\\t\\tafter = terminalbackend.StateUnavailable\\n\\t\\t\\t}\\n\\t\\t\\tfailure := refuse(code, \"backend effect refused\")\\n',\n505|        replace='\\t\\t\\tafter := source\\n\\t\\t\\tif committed || code == CodeTimeout {\\n\\t\\t\\t\\tafter = terminalbackend.StateUnavailable\\n\\t\\t\\t}\\n\\t\\t\\tfailure := refuse(code, \"backend effect refused\")\\n',\n506|        count=1,\n507|        run=\"TestExecutePreEffectErrorsRestoreSource/coded_backend_refusal_on_first_effect\",\n508|        expect=\"KILLED\",\n509|        note=\"Moves exactly pre-commit timeouts to unavailable; other pre-commit errors still restore source.\",\n510|    ),\n511|    Mutant(\n512|        name=\"N-engine-postcommit-after\",\n513|        path=f\"{PACKAGE}/execute.go\",\n514|        find='\\t\\t\\tafter := source\\n\\t\\t\\tif committed {\\n\\t\\t\\t\\tafter = terminalbackend.StateUnavailable\\n\\t\\t\\t}\\n\\t\\t\\tfailure := refuse(code, \"backend effect refused\")\\n',\n515|        replace='\\t\\t\\tafter := source\\n\\t\\t\\tif committed && code != CodeProcessFailed {\\n\\t\\t\\t\\tafter = terminalbackend.StateUnavailable\\n\\t\\t\\t}\\n\\t\\t\\tfailure := refuse(code, \"backend effect refused\")\\n',\n516|        count=1,\n517|        run=\"TestExecutePostEffectErrorsMoveUnavailable/coded_refusal_on_second_effect\",\n518|        expect=\"KILLED\",\n519|        note=\"Restores source for exactly post-commit process failures; other post-commit errors still fence unavailable.\",\n520|    ),\n521|    Mutant(\n522|        name=\"N-engine-status-match\",\n523|        path=f\"{PACKAGE}/execute.go\",\n524|        find=\"\\tif observed.IdentityMatch != computed {\\n\",\n525|        replace=\"\\tif observed.IdentityMatch != computed && observed.State != terminalbackend.StateAbsent {\\n\",\n526|        count=1,\n527|        run=\"TestExecuteStatusMatchedTupleFalseFormRefuses\",\n528|        expect=\"KILLED\",\n529|        note=\"Admits exactly absent-state match lies; other match lies still refuse.\",\n530|    ),\n531|    Mutant(\n532|        name=\"N-engine-status-unknown\",\n533|        path=f\"{PACKAGE}/execute.go\",\n534|        find='\\t\\tif code == \"\" {\\n\\t\\t\\treturn empty, refuse(CodeUnavailable, \"status observation unknown\")\\n\\t\\t}\\n',\n535|        replace='\\t\\tif code == \"\" {\\n\\t\\t\\treturn StatusReport{State: terminalbackend.StateAbsent}, nil\\n\\t\\t}\\n',\n536|        count=1,\n537|        run=\"TestExecuteStatusUnknownIsNeverAbsent\",\n538|        expect=\"KILLED\",\n539|        note=\"Reports exactly uncoded read failures as absent; coded failures still refuse unknown.\",\n540|    ),\n541|    Mutant(\n542|        name=\"N-engine-status-conditional\",\n543|        path=f\"{PACKAGE}/execute.go\",\n544|        find