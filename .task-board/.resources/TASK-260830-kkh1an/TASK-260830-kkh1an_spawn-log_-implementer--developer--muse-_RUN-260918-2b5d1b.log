{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d341","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":2043,"recorded_at":1780531400004081,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"task_stream":{"kind":"task","id":"01a0b240-233d-77a2-a29e-e077589ffad3"},"task_id":"01a0b240-233d-77a2-a29e-e077589ffad3","event":{"kind":"output","task_id":"01a0b240-233d-77a2-a29e-e077589ffad3","chunk":"Read text file `internal/terminstance/status_test.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|)\n7|\n8|func statusDoc(instance, generation string) string {\n9|\treturn `{\"session_id\":\"` + fixtureSessionA + `\",` +\n10|\t\t`\"terminal_instance_id\":` + instance + `,` +\n11|\t\t`\"terminal_backend_id\":\"` + fixtureBackend + `\",` +\n12|\t\t`\"implementation_version\":\"1.2.3\",` +\n13|\t\t`\"protocol_version\":\"1.0.0\",` +\n14|\t\t`\"backend_generation\":` + generation + `,` +\n15|\t\t`\"include_provider_observation\":false,` +\n16|\t\t`\"deadline_at\":\"` + fixtureDeadline + `\"}`\n17|}\n18|\n19|// TestParseStatusBodyAdmitsBothScopes drives the exact-instance and the\n20|// Session-scoped lookups through the production entry.\n21|func TestParseStatusBodyAdmitsBothScopes(t *testing.T) {\n22|\texact, err := ParseStatusBody([]byte(statusDoc(`\"`+fixtureInstance+`\"`, `\"generation-one\"`)))\n23|\tif err != nil {\n24|\t\tt.Fatalf(\"ParseStatusBody(exact) error = %v\", err)\n25|\t}\n26|\tif !exact.HasTerminalInstanceID || !exact.HasBackendGeneration {\n27|\t\tt.Error(\"exact lookup reports a null member, want both non-null\")\n28|\t}\n29|\trequireLiteral(t, \"instance\", exact.TerminalInstanceID, \"0198f4c8-8e50-7f66-8f70-bbbbbbbbbbb1\")\n30|\trequireLiteral(t, \"generation\", exact.BackendGeneration, \"generation-one\")\n31|\n32|\tscoped, err := ParseStatusBody([]byte(statusDoc(`null`, `null`)))\n33|\tif err != nil {\n34|\t\tt.Fatalf(\"ParseStatusBody(session-scoped) error = %v\", err)\n35|\t}\n36|\tif scoped.HasTerminalInstanceID || scoped.HasBackendGeneration {\n37|\t\tt.Error(\"session-scoped lookup reports a non-null member, want both null\")\n38|\t}\n39|}\n40|\n41|// TestParseStatusBodyNullPairRule proves instance and generation are\n42|// either both null or both non-null: exactly one null refuses.\n43|func TestParseStatusBodyNullPairRule(t *testing.T) {\n44|\t_, err := ParseStatusBody([]byte(statusDoc(`\"`+fixtureInstance+`\"`, `null`)))\n45|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"status identity scope\")\n46|\n47|\t_, err = ParseStatusBody([]byte(statusDoc(`null`, `\"generation-one\"`)))\n48|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"status identity scope\")\n49|}\n50|\n51|// TestParseStatusBodyMemberRefusals drives every status member arm,\n52|// including the generation bound at 0 and 257 with the landed stale\n53|// class.\n54|func TestParseStatusBodyMemberRefusals(t *testing.T) {\n55|\tbase := statusDoc(`\"`+fixtureInstance+`\"`, `\"generation-one\"`)\n56|\t_, err := ParseStatusBody([]byte(strings.Replace(base, fixtureSessionA, \"nope\", 1)))\n57|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"status body session\")\n58|\n59|\t_, err = ParseStatusBody([]byte(statusDoc(`\"nope\"`, `\"generation-one\"`)))\n60|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"status body instance\")\n61|\n62|\t_, err = ParseStatusBody([]byte(statusDoc(`\"\"`, `\"generation-one\"`)))\n63|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"status body instance\")\n64|\n65|\t_, err = ParseStatusBody([]byte(statusDoc(`\"`+fixtureInstance+`\"`, `\"\"`)))\n66|\trequireRefusal(t, err, \"terminal_backend_stale_generation\", \"backend_generation bound\")\n67|\n68|\t_, err = ParseStatusBody([]byte(statusDoc(`\"`+fixtureInstance+`\"`, `\"`+strings.Repeat(\"g\", 257)+`\"`)))\n69|\trequireRefusal(t, err, \"terminal_backend_stale_generation\", \"backend_generation bound\")\n70|\n71|\tif _, err := ParseStatusBody([]byte(statusDoc(`\"`+fixtureInstance+`\"`, `\"`+strings.Repeat(\"g\", 256)+`\"`))); err != nil {\n72|\t\tt.Errorf(\"ParseStatusBody(generation 256) error = %v, want admission\", err)\n73|\t}\n74|\n75|\t_, err = ParseStatusBody([]byte(strings.Replace(base, `\"1.2.3\"`, `\"1.2\"`, 1)))\n76|\trequireRefusal(t, err, \"terminal_backend_implementation_drift\", \"implementation_version semver\")\n77|\n78|\t_, err = ParseStatusBody([]byte(strings.Replace(base, `\"include_provider_observation\":false`, `\"include_provider_observation\":\"yes\"`, 1)))\n79|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"status body observation\")\n80|\n81|\textra := strings.Replace(base, `\"deadline_at\"`, `\"trace_id\":\"x\",\"deadline_at\"`, 1)\n82|\t_, err = ParseStatusBody([]byte(extra))\n83|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"status body members\")\n84|\n85|\t_, err = ParseStatusBody([]byte(`[1]`))\n86|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"status body frame\")\n87|}","final_result":true}}}
