{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb45","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":1021,"recorded_at":1780531400002037,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"task_stream":{"kind":"task","id":"01a0b237-11e9-7651-af1d-b8b860644942"},"task_id":"01a0b237-11e9-7651-af1d-b8b860644942","event":{"kind":"output","task_id":"01a0b237-11e9-7651-af1d-b8b860644942","chunk":"Read text file `internal/terminstance/bodies.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n8|)\n9|\n10|// Params carries the per-operation members beyond the shared mutation\n11|// context. Only the members the operation's closed body lists are read;\n12|// the rest stay zero. Create is receipt-scoped in this engine (its full\n13|// binding/entrypoint body belongs to provisioning), so it carries only\n14|// the bootstrap operation ID its idempotency key binds.\n15|type Params struct {\n16|\tBootstrapOperationID   string\n17|\tQuiescenceGeneration   string\n18|\tProviderProofKind      ProviderProofKind\n19|\tTimeoutMs              uint64\n20|\tSafeBoundaryEvidenceID string\n21|\tGracefulTimeoutMs      uint64\n22|\tInteractive            bool\n23|}\n24|\n25|// operationBodyMembers is the exact closed member set per engine\n26|// operation body, in pinned order. Status has its own flat body\n27|// (ParseStatusBody); every other operation is outside the engine scope.\n28|var operationBodyMembers = map[terminalbackend.Operation][]string{\n29|\tterminalbackend.OperationQuiesceInput:     {\"context\", \"quiescence_generation\"},\n30|\tterminalbackend.OperationWaitSafeBoundary: {\"context\", \"quiescence_generation\", \"provider_proof_kind\", \"timeout_ms\"},\n31|\tterminalbackend.OperationRequestStop:      {\"context\", \"safe_boundary_evidence_id\", \"graceful_timeout_ms\"},\n32|}\n33|\n34|// ParseOperationBody admits one closed quiesce-input, wait-safe-boundary\n35|// or request-stop body: the exact member set, the nested mutation\n36|// context through the shared parse arms, and the per-operation members.\n37|// Create carries no parsed body in this engine (receipt scope only) and\n38|// every other operation is refused by the scope gate.\n39|func ParseOperationBody(operation string, raw []byte) (MutationContext, Params, error) {\n40|\tparsed, err := terminalbackend.ParseOperation(operation)\n41|\tif err != nil {\n42|\t\treturn MutationContext{}, Params{}, wrapLanded(err)\n43|\t}\n44|\tif _, ok := operationBodyMembers[parsed]; !ok {\n45|\t\treturn MutationContext{}, Params{}, refuse(CodeProtocolError, \"operation lifecycle scope\")\n46|\t}\n47|\tobject, fault := environ.DecodeStrictObject(raw)\n48|\tif fault != nil {\n49|\t\treturn MutationContext{}, Params{}, refuse(CodeProtocolError, \"operation body frame\")\n50|\t}\n51|\treturn parseOperationBodyObject(parsed, object)\n52|}\n53|\n54|// parseOperationBodyObject admits one already-framed operation body. It is\n55|// split from ParseOperationBody only so the member-set and per-member\n56|// arms read linearly; there is no second admission path.\n57|func parseOperationBodyObject(operation terminalbackend.Operation, object map[string]json.RawMessage) (MutationContext, Params, error) {\n58|\twant := operationBodyMembers[operation]\n59|\tif len(object) != len(want) {\n60|\t\treturn MutationContext{}, Params{}, refuse(CodeProtocolError, \"operation body members\")\n61|\t}\n62|\tfor _, member := range want {\n63|\t\tif _, known := object[member]; !known {\n64|\t\t\treturn MutationContext{}, Params{}, refuse(CodeProtocolError, \"operation body members\")\n65|\t\t}\n66|\t}\n67|\tcontextMembers, fault := environ.DecodeStrictObject(object[\"context\"])\n68|\tif fault != nil {\n69|\t\treturn MutationContext{}, Params{}, refuse(CodeProtocolError, \"operation body context\")\n70|\t}\n71|\tcontext, err := parseMutationContextObject(contextMembers)\n72|\tif err != nil {\n73|\t\treturn MutationContext{}, Params{}, err\n74|\t}\n75|\tvar params Params\n76|\tswitch operation {\n77|\tcase terminalbackend.OperationQuiesceInput:\n78|\t\tgeneration, ok := environ.CheckUUIDv7(object[\"quiescence_generation\"])\n79|\t\tif !ok {\n80|\t\t\treturn MutationContext{}, Params{}, refuse(CodeProtocolError, \"quiescence generation\")\n81|\t\t}\n82|\t\tparams.QuiescenceGeneration = generation.String()\n83|\tcase terminalbackend.OperationWaitSafeBoundary:\n84|\t\tgeneration, ok := environ.CheckUUIDv7(object[\"quiescence_generation\"])\n85|\t\tif !ok {\n86|\t\t\treturn MutationContext{}, Params{}, refuse(CodeProtocolError, \"quiescence generation\")\n87|\t\t}\n88|\t\tkindRaw, ok := rawString(object[\"provider_proof_kind\"])\n89|\t\tif !ok {\n90|\t\t\treturn MutationContext{}, Params{}, refuse(CodeProtocolError, \"provider proof vocabulary\")\n91|\t\t}\n92|\t\tkind, err := ParseProviderProofKind(kindRaw)\n93|\t\tif err != nil {\n94|\t\t\treturn MutationContext{}, Params{}, err\n95|\t\t}\n96|\t\ttimeout, ok := environ.CheckUint53Bounds(object[\"timeout_ms\"], 1, 3600000)\n97|\t\tif !ok {\n98|\t\t\treturn MutationContext{}, Params{}, refuse(CodeProtocolError, \"wait timeout bound\")\n99|\t\t}\n100|\t\tparams.QuiescenceGeneration = generation.String()\n101|\t\tparams.ProviderProofKind = kind\n102|\t\tparams.TimeoutMs = timeout\n103|\tcase terminalbackend.OperationRequestStop:\n104|\t\tevidence, ok := environ.CheckDigest(object[\"safe_boundary_evidence_id\"])\n105|\t\tif !ok {\n106|\t\t\treturn MutationContext{}, Params{}, refuse(CodeProtocolError, \"stop boundary evidence\")\n107|\t\t}\n108|\t\ttimeout, ok := environ.CheckUint53Bounds(object[\"graceful_timeout_ms\"], 1, 3600000)\n109|\t\tif !ok {\n110|\t\t\treturn MutationContext{}, Params{}, refuse(CodeProtocolError, \"stop timeout bound\")\n111|\t\t}\n112|\t\tparams.SafeBoundaryEvidenceID = evidence.String()\n113|\t\tparams.GracefulTimeoutMs = timeout\n114|\tdefault:\n115|\t\treturn MutationContext{}, Params{}, refuse(CodeProtocolError, \"operation lifecycle scope\")\n116|\t}\n117|\tif err := CheckMutationContext(operation, context, params); err != nil {\n118|\t\treturn MutationContext{}, Params{}, err\n119|\t}\n120|\treturn context, params, nil\n121|}","final_result":true}}}
