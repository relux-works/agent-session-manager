{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ce37","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":1398,"recorded_at":1780531400002791,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"task_stream":{"kind":"task","id":"01a0b23c-4715-7412-9659-8a8a114cfee4"},"task_id":"01a0b23c-4715-7412-9659-8a8a114cfee4","event":{"kind":"output","task_id":"01a0b23c-4715-7412-9659-8a8a114cfee4","chunk":"Read text file `internal/terminalbackend/terminalbackend.go`.\n(625 line(s) above)\n626|type InstanceBinding struct {\n627|\tBackendID             string\n628|\tImplementationVersion string\n629|\tProtocolVersion       string\n630|\tGeneration            string\n631|\tTerminalBindingID     string\n632|}\n633|\n634|// CheckProviderDescriptor enforces the Section 7.A rule: the provider rejects\n635|// a descriptor whose binding digest, backend ID, versions, or generation does\n636|// not match the AX-validated host-local binding before launching or observing\n637|// a provider process. Generation lengths 0 and over 256 UTF-8 characters are\n638|// invalid; 256 is accepted.\n639|func CheckProviderDescriptor(descriptor, binding InstanceBinding) error {\n640|\tif err := checkGeneration(descriptor.Generation); err != nil {\n641|\t\treturn err\n642|\t}\n643|\tif err := checkGeneration(binding.Generation); err != nil {\n644|\t\treturn err\n645|\t}\n646|\tif _, err := ParseID(descriptor.BackendID); err != nil {\n647|\t\treturn err\n648|\t}\n649|\tif descriptor.BackendID != binding.BackendID {\n650|\t\treturn refuse(&Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \"descriptor backend binding\"})\n651|\t}\n652|\tif _, err := scalar.ParseDigest(descriptor.TerminalBindingID); err != nil {\n653|\t\treturn refuse(&Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \"descriptor binding digest\"})\n654|\t}\n655|\tif descriptor.TerminalBindingID != binding.TerminalBindingID {\n656|\t\treturn refuse(&Error{Code: CodeNotFound, BackendID: descriptor.BackendID, Detail: \"descriptor binding digest\"})\n657|\t}\n658|\tif descriptor.ImplementationVersion != binding.ImplementationVersion ||\n659|\t\tdescriptor.ProtocolVersion != binding.ProtocolVersion {\n660|\t\treturn refuse(&Error{Code: CodeDrift, BackendID: descriptor.BackendID, Detail: \"descriptor version binding\"})\n661|\t}\n662|\tif descriptor.Generation != binding.Generation {\n663|\t\treturn refuse(&Error{Code: CodeStaleGeneration, BackendID: descriptor.BackendID, Detail: \"descriptor generation binding\"})\n664|\t}\n665|\treturn nil\n666|}\n667|\n668|// checkGeneration enforces string[1..256] measured in UTF-8 characters over\n669|// valid UTF-8 (SPEC.md:321).\n670|func checkGeneration(generation string) error {\n671|\tif !utf8.ValidString(generation) || utf8.RuneCountInString(generation) < 1 || utf8.RuneCountInString(generation) > maxGenerationRunes {\n672|\t\treturn refuse(&Error{Code: CodeStaleGeneration, Detail: \"backend_generation bound\"})\n673|\t}\n674|\treturn nil\n675|}\n676|\n677|// DigestFile returns the sha256: digest of the executable at path after\n678|// resolving symlinks. The target must be a regular file; anything else (or a\n679|// read failure) is an error, never a digest. It distinguishes a failed read\n680|// from an absent trust entry: callers must not fall back to PATH discovery.\n681|//\n682|// Trust here is Section 6.5 external_trust: the closed entry carries\n683|// exactly backend ID, absolute executable path, executable digest, and\n684|// enabled — there is no owner member, so no owner check applies. That\n685|// differs deliberately from provider trust under Section 7.1, which\n686|// requires the target be owned by the operator or an\n687|// administrator-approved identity (see provider.trustCandidate). The\n688|// symlink-resolution and regular-file steps mirror Section 7.1's\n689|// mechanics; the missing owner dimension is contractual — the closed\n690|// entry leaves no member to record an owner in — not drift. Do not add\n691|// an owner check here without a spec change, and do not read this\n692|// function as the provider trust path.\n693|func DigestFile(path string) (string, error) {\n694|\tresolved, err := filepath.EvalSymlinks(path)\n695|\tif err != nil {\n696|\t\treturn \"\", fmt.Errorf(\"terminal backend executable: %w\", err)\n697|\t}\n698|\tinfo, err := os.Stat(resolved)\n699|\tif err != nil {\n700|\t\treturn \"\", fmt.Errorf(\"terminal backend executable: %w\", err)\n701|\t}\n702|\tif !info.Mode().IsRegular() {\n703|\t\treturn \"\", fmt.Errorf(\"terminal backend executable %s: not a regular file\", resolved)\n704|\t}\n705|\traw, err := os.ReadFile(resolved)\n(more lines below)","final_result":true}}}
