{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb87","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":1054,"recorded_at":1780531400002103,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"task_stream":{"kind":"task","id":"01a0b237-1cef-7143-9415-0d82c1bf2cf2"},"task_id":"01a0b237-1cef-7143-9415-0d82c1bf2cf2","event":{"kind":"output","task_id":"01a0b237-1cef-7143-9415-0d82c1bf2cf2","chunk":"Read text file `internal/terminstance/store.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"errors\"\n7|\t\"fmt\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"sort\"\n11|\t\"strings\"\n12|\t\"sync\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n15|)\n16|\n17|// Receipt is one durable idempotency record: the canonical key, the\n18|// operation it was bound for, and the operation ID it was bound with.\n19|// The shape extends the landed terminalbackend.Receipt triple\n20|// (Key/Operation/ResultID); ResultID is the MutationContext operation\n21|// ID, so an identical retry (same key, same operation, same operation\n22|// ID) replays and a changed operation in the window is\n23|// idempotency_mismatch.\n24|type Receipt struct {\n25|\tKey         string\n26|\tOperation   terminalbackend.Operation\n27|\tOperationID string\n28|}\n29|\n30|// StoreHooks arms the crash seams of the receipt store. AfterCommit runs\n31|// after the no-replace link lands and before the directory sync, exactly\n32|// like the predecessor leaf's AfterInstall: a hook error propagates to\n33|// the caller but the receipt stands, so the identical retry replays it.\n34|type StoreHooks struct {\n35|\tAfterCommit func(path string) error\n36|}\n37|\n38|// ReceiptStore is the durable idempotency receipt table backing the §4.C\n39|// recovery rules: persist the receipt before the first side effect,\n40|// identical retry replays it, a changed operation in the window is\n41|// idempotency_mismatch, and uncertainty requires status. Each receipt is\n42|// one file committed by temp-stage, fsync, no-replace link and directory\n43|// sync; readers see absence or the complete receipt, never a torn\n44|// prefix. Completion (the recorded result) is a second no-replace file,\n45|// because updating the receipt in place would break no-replace: a\n46|// pending receipt without its completion proves an interrupted attempt,\n47|// never a result, and the engine refuses its retry until status\n48|// recovers the observation.\n49|type ReceiptStore struct {\n50|\tmutex sync.Mutex\n51|\tbase  string\n52|\thooks *StoreHooks\n53|}\n54|\n55|// OpenReceiptStore opens (creating) the receipt store rooted at base.\n56|func OpenReceiptStore(base string) (*ReceiptStore, error) {\n57|\tif err := os.MkdirAll(base, 0o755); err != nil {\n58|\t\treturn nil, fmt.Errorf(\"create receipt store: %w\", err)\n59|\t}\n60|\tif err := os.MkdirAll(filepath.Join(base, \"pending\"), 0o755); err != nil {\n61|\t\treturn nil, fmt.Errorf(\"create receipt pending directory: %w\", err)\n62|\t}\n63|\tif err := os.MkdirAll(filepath.Join(base, \"done\"), 0o755); err != nil {\n64|\t\treturn nil, fmt.Errorf(\"create receipt done directory: %w\", err)\n65|\t}\n66|\treturn &ReceiptStore{base: base}, nil\n67|}\n68|\n69|// WithHooks arms the crash seams. A nil hooks value disarms them.\n70|func (store *ReceiptStore) WithHooks(hooks *StoreHooks) {\n71|\tstore.mutex.Lock()\n72|\tdefer store.mutex.Unlock()\n73|\tstore.hooks = hooks\n74|}\n75|\n76|// receiptName maps a key to its file name: the hex sha256 of the key.\n77|// The key itself is embedded in the file content, so the name is a\n78|// lookup optimization the content re-validates, never trusted identity.\n79|func receiptName(key string) string {\n80|\tsum := sha256.Sum256([]byte(key))\n81|\treturn hex.EncodeToString(sum[:])\n82|}\n83|\n84|// encodeReceipt renders one receipt as the landed per-receipt triple:\n85|// key, operation and operation ID on three lines. The encoding matches\n86|// terminalbackend.Ledger.Export line for line, so Export below produces\n87|// bytes ImportLedger admits.\n88|func encodeReceipt(receipt Receipt) []byte {\n89|\treturn []byte(receipt.Key + \"\\n\" + string(receipt.Operation) + \"\\n\" + receipt.OperationID + \"\\n\")\n90|}\n91|\n92|// decodeReceipt parses one receipt file. A torn or malformed file is an\n93|// integrity failure, never absence and never a partial receipt.\n94|func decodeReceipt(raw []byte) (Receipt, error) {\n95|\tlines := strings.Split(string(raw), \"\\n\")\n96|\tif len(lines) != 4 || lines[3] != \"\" || lines[0] == \"\" || lines[2] == \"\" {\n97|\t\treturn Receipt{}, refuse(CodeIntegrityFailure, \"idempotency receipt image\")\n98|\t}\n99|\toperation, err := terminalbackend.ParseOperation(lines[1])\n100|\tif err != nil {\n101|\t\treturn Receipt{}, refuse(CodeIntegrityFailure, \"idempotency receipt image\")\n102|\t}\n103|\treturn Receipt{Key: lines[0], Operation: operation, OperationID: lines[2]}, nil\n104|}\n105|\n106|// Bind records the receipt for a key before the first side effect. A key\n107|// bound for the first time is durably stored and reported fresh. A key\n108|// bound again with the identical operation and operation ID replays the\n109|// stored receipt. A key bound again with a different operation or\n110|// operation ID is idempotency_mismatch: only a successful status read\n111|// proves absence, never a second binding.\n112|func (store *ReceiptStore) Bind(key string, operation terminalbackend.Operation, operationID string) (Receipt, bool, error) {\n113|\tif store == nil {\n114|\t\treturn Receipt{}, false, refuse(CodeProtocolError, \"idempotency store unavailable\")\n115|\t}\n116|\tif key == \"\" || operationID == \"\" {\n117|\t\treturn Receipt{}, false, refuse(CodeProtocolError, \"idempotency key shape\")\n118|\t}\n119|\tif _, err := terminalbackend.ParseOperation(string(operation)); err != nil {\n120|\t\treturn Receipt{}, false, wrapLanded(err)\n121|\t}\n122|\tdir := filepath.Join(store.base, \"pending\")\n123|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n124|\t\treturn Receipt{}, false, fmt.Errorf(\"create receipt pending directory: %w\", err)\n125|\t}\n126|\tsweepStaging(dir)\n127|\ttarget := filepath.Join(dir, receiptName(key))\n128|\treceipt := Receipt{Key: key, Operation: operation, OperationID: operationID}\n129|\tstaged, err := os.CreateTemp(dir, \"receipt-*.tmp\")\n130|\tif err != nil {\n131|\t\treturn Receipt{}, false, fmt.Errorf(\"stage idempotency receipt: %w\", err)\n132|\t}\n133|\tstagedPath := staged.Name()\n134|\tdefer func() { _ = os.Remove(stagedPath) }()\n135|\tif err := staged.Chmod(0o600); err != nil {\n136|\t\t_ = staged.Close()\n137|\t\treturn Receipt{}, false, fmt.Errorf(\"protect idempotency receipt: %w\", err)\n138|\t}\n139|\tif _, err := staged.Write(encodeReceipt(receipt)); err != nil {\n140|\t\t_ = staged.Close()\n141|\t\treturn Receipt{}, false, fmt.Errorf(\"write idempotency receipt: %w\", err)\n142|\t}\n143|\tif err := staged.Sync(); err != nil {\n144|\t\t_ = staged.Close()\n145|\t\treturn Receipt{}, false, fmt.Errorf(\"sync idempotency receipt: %w\", err)\n146|\t}\n147|\tif err := staged.Close(); err != nil {\n148|\t\treturn Receipt{}, false, fmt.Errorf(\"close idempotency receipt: %w\", err)\n149|\t}\n150|\tif err := os.Link(stagedPath, target); err != nil {\n151|\t\tif errors.Is(err, os.ErrExist) {\n152|\t\t\twinner, found, readErr := store.Lookup(key)\n153|\t\t\tif readErr != nil {\n154|\t\t\t\treturn Receipt{}, false, readErr\n155|\t\t\t}\n156|\t\t\tif !found {\n157|\t\t\t\treturn Receipt{}, false, refuse(CodeIntegrityFailure, \"idempotency receipt image\")\n158|\t\t\t}\n159|\t\t\tif winner.Operation != operation || winner.OperationID != operationID {\n160|\t\t\t\treturn Receipt{}, false, refuse(CodeIdempotencyMismatch, \"idempotency key conflict\")\n161|\t\t\t}\n162|\t\t\treturn winner, true, nil\n163|\t\t}\n164|\t\treturn Receipt{}, false, fmt.Errorf(\"install idempotency receipt: %w\", err)\n165|\t}\n166|\t_ = os.Remove(stagedPath)\n167|\tstore.mutex.Lock()\n168|\thooks := store.hooks\n169|\tstore.mutex.Unlock()\n170|\tif hooks != nil && hooks.AfterCommit != nil {\n171|\t\tif err := hooks.AfterCommit(target); err != nil {\n172|\t\t\treturn Receipt{}, false, err\n173|\t\t}\n174|\t}\n175|\tif err := syncDirectory(dir); err != nil {\n176|\t\treturn Receipt{}, false, err\n177|\t}\n178|\treturn receipt, false, nil\n179|}\n180|\n181|// Lookup returns the stored receipt for a key. Absence of a receipt\n182|// proves nothing and reports false; a torn receipt file is an integrity\n183|// failure, never absence.\n184|func (store *ReceiptStore) Lookup(key string) (Receipt, bool, error) {\n185|\tif store == nil || key == \"\" {\n186|\t\treturn Receipt{}, false, nil\n187|\t}\n188|\ttarget := filepath.Join(store.base, \"pending\", receiptName(key))\n189|\traw, err := os.ReadFile(target)\n190|\tif err != nil {\n191|\t\tif errors.Is(err, os.ErrNotExist) {\n192|\t\t\treturn Receipt{}, false, nil\n193|\t\t}\n194|\t\treturn Receipt{}, false, fmt.Errorf(\"read idempotency receipt: %w\", err)\n195|\t}\n196|\treceipt, err := decodeReceipt(raw)\n197|\tif err != nil {\n198|\t\treturn Receipt{}, false, err\n199|\t}\n200|\tif receipt.Key != key {\n201|\t\treturn Receipt{}, false, refuse(CodeIntegrityFailure, \"idempotency receipt image\")\n202|\t}\n203|\treturn receipt, true, nil\n204|}\n205|\n206|// Complete records the result of a bound key. The result bytes commit\n207|// through the same no-replace link as the receipt: a second completion\n208|// with identical bytes replays, a second completion with different bytes\n209|// is an integrity failure, because one attempt has exactly one result.\n210|// Completing an unbound key is a failed local precondition.\n211|func (store *ReceiptStore) Complete(key string, result []byte) error {\n212|\tif store == nil {\n213|\t\treturn refuse(CodeProtocolError, \"idempotency store unavailable\")\n214|\t}\n215|\tif _, found, err := store.Lookup(key); err != nil {\n216|\t\treturn err\n217|\t} else if !found {\n218|\t\treturn refuse(CodePreconditionFailed, \"idempotency completion without receipt\")\n219|\t}\n220|\tdir := filepath.Join(store.base, \"done\")\n221|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n222|\t\treturn fmt.Errorf(\"create receipt done directory: %w\", err)\n223|\t}\n224|\tsweepStaging(dir)\n225|\ttarget := filepath.Join(dir, receiptName(key))\n226|\tstaged, err := os.CreateTemp(dir, \"result-*.tmp\")\n227|\tif err != nil {\n228|\t\treturn fmt.Errorf(\"stage idempotency result: %w\", err)\n229|\t}\n230|\tstagedPath := staged.Name()\n231|\tdefer func() { _ = os.Remove(stagedPath) }()\n232|\tif err := staged.Chmod(0o600); err != nil {\n233|\t\t_ = staged.Close()\n234|\t\treturn fmt.Errorf(\"protect idempotency result: %w\", err)\n235|\t}\n236|\tif _, err := staged.Write(result); err != nil {\n237|\t\t_ = staged.Close()\n238|\t\treturn fmt.Errorf(\"write idempotency result: %w\", err)\n239|\t}\n240|\tif err := staged.Sync(); err != nil {\n241|\t\t_ = staged.Close()\n242|\t\treturn fmt.Errorf(\"sync idempotency result: %w\", err)\n243|\t}\n244|\tif err := staged.Close(); err != nil {\n245|\t\treturn fmt.Errorf(\"close idempotency result: %w\", err)\n246|\t}\n247|\tif err := os.Link(stagedPath, target); err != nil {\n248|\t\tif errors.Is(err, os.ErrExist) {\n249|\t\t\twinner, readErr := os.ReadFile(target)\n250|\t\t\tif readErr != nil {\n251|\t\t\t\treturn fmt.Errorf(\"read idempotency result: %w\", readErr)\n252|\t\t\t}\n253|\t\t\tif string(winner) != string(result) {\n254|\t\t\t\treturn refuse(CodeIntegrityFailure, \"idempotency result conflict\")\n255|\t\t\t}\n256|\t\t\treturn nil\n257|\t\t}\n258|\t\treturn fmt.Errorf(\"install idempotency result: %w\", err)\n259|\t}\n260|\t_ = os.Remove(stagedPath)\n261|\tif err := syncDirectory(dir); err != nil {\n262|\t\treturn err\n263|\t}\n264|\treturn nil\n265|}\n266|\n267|// Completed returns the recorded result for a key. A bound key without\n268|// its completion reports found false: the attempt was interrupted and\n269|// only status recovers the observation, never a second binding.\n270|func (store *ReceiptStore) Completed(key string) ([]byte, bool, error) {\n271|\tif store == nil || key == \"\" {\n272|\t\treturn nil, false, nil\n273|\t}\n274|\ttarget := filepath.Join(store.base, \"done\", receiptName(key))\n275|\traw, err := os.ReadFile(target)\n276|\tif err != nil {\n277|\t\tif errors.Is(err, os.ErrNotExist) {\n278|\t\t\treturn nil, false, nil\n279|\t\t}\n280|\t\treturn nil, false, fmt.Errorf(\"read idempotency result: %w\", err)\n281|\t}\n282|\treturn raw, true, nil\n283|}\n284|\n285|// Export renders the pending table as stable bytes: receipts sorted by\n286|// key, one triple per receipt. The bytes equal what a\n287|// terminalbackend.Ledger holding the same receipts exports, so they feed\n288|// ImportLedger directly; the agreement is pinned by\n289|// TestStoreExportAgreesWithLedger. Staging garbage is never exported.\n290|func (store *ReceiptStore) Export() ([]byte, error) {\n291|\tif store == nil {\n292|\t\treturn nil, refuse(CodeProtocolError, \"idempotency store unavailable\")\n293|\t}\n294|\tdir := filepath.Join(store.base, \"pending\")\n295|\tentries, err := os.ReadDir(dir)\n296|\tif err != nil {\n297|\t\tif errors.Is(err, os.ErrNotExist) {\n298|\t\t\treturn nil, nil\n299|\t\t}\n300|\t\treturn nil, fmt.Errorf(\"read receipt table: %w\", err)\n301|\t}\n302|\treceipts := make([]Receipt, 0, len(entries))\n303|\tfor _, entry := range entries {\n304|\t\tif entry.IsDir() || !isReceiptName(entry.Name()) {\n305|\t\t\tcontinue\n306|\t\t}\n307|\t\traw, err := os.ReadFile(filepath.Join(dir, entry.Name()))\n308|\t\tif err != nil {\n309|\t\t\treturn nil, fmt.Errorf(\"read idempotency receipt: %w\", err)\n310|\t\t}\n311|\t\treceipt, err := decodeReceipt(raw)\n312|\t\tif err != nil {\n313|\t\t\treturn nil, err\n314|\t\t}\n315|\t\treceipts = append(receipts, receipt)\n316|\t}\n317|\tsort.Slice(receipts, func(i, j int) bool { return receipts[i].Key < receipts[j].Key })\n318|\tvar image strings.Builder\n319|\tfor _, receipt := range receipts {\n320|\t\timage.WriteString(receipt.Key + \"\\n\" + string(receipt.Operation) + \"\\n\" + receipt.OperationID + \"\\n\")\n321|\t}\n322|\treturn []byte(image.String()), nil\n323|}\n324|\n325|// isReceiptName reports whether a directory entry is a committed receipt\n326|// file: exactly 64 lowercase hex characters. Staging files\n327|// (receipt-*.tmp, result-*.tmp) and anything else are ignored.\n328|func isReceiptName(name string) bool {\n329|\tif len(name) != 64 {\n330|\t\treturn false\n331|\t}\n332|\tfor i := 0; i < len(name); i++ {\n333|\t\tdigit := name[i]\n334|\t\tif (digit < '0' || digit > '9') && (digit < 'a' || digit > 'f') {\n335|\t\t\treturn false\n336|\t\t}\n337|\t}\n338|\treturn true\n339|}\n340|\n341|// sweepStaging removes staging garbage a pre-commit crash left behind.\n342|// Staging files carry the *.tmp suffix; committed receipts never do, so\n343|// the sweep cannot remove a commit.\n344|func sweepStaging(dir string) {\n345|\tentries, err := os.ReadDir(dir)\n346|\tif err != nil {\n347|\t\treturn\n348|\t}\n349|\tfor _, entry := range entries {\n350|\t\tif entry.IsDir() || !strings.HasSuffix(entry.Name(), \".tmp\") {\n351|\t\t\tcontinue\n352|\t\t}\n353|\t\t_ = os.Remove(filepath.Join(dir, entry.Name()))\n354|\t}\n355|}\n356|\n357|// syncDirectory fsyncs a directory so committed links survive a crash.\n358|func syncDirectory(dir string) error {\n359|\thandle, err := os.Open(dir)\n360|\tif err != nil {\n361|\t\treturn fmt.Errorf(\"open receipt directory: %w\", err)\n362|\t}\n363|\tdefer func() { _ = handle.Close() }()\n364|\tif err := handle.Sync(); err != nil {\n365|\t\treturn fmt.Errorf(\"sync receipt directory: %w\", err)\n366|\t}\n367|\treturn nil\n368|}","final_result":true}}}
