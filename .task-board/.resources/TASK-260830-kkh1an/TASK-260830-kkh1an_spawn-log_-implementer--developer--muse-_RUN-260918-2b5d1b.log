{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d3f7","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":2134,"recorded_at":1780531400004263,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"task_stream":{"kind":"task","id":"01a0b241-023e-7a23-8e5c-499cd0bb5c31"},"task_id":"01a0b241-023e-7a23-8e5c-499cd0bb5c31","event":{"kind":"output","task_id":"01a0b241-023e-7a23-8e5c-499cd0bb5c31","chunk":"Read text file `internal/terminstance/status_exec_test.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n8|)\n9|\n10|func exactStatusBody(t *testing.T) StatusBody {\n11|\tt.Helper()\n12|\tbody, err := ParseStatusBody([]byte(statusDoc(`\"`+fixtureInstance+`\"`, `\"generation-one\"`)))\n13|\tif err != nil {\n14|\t\tt.Fatalf(\"ParseStatusBody() error = %v\", err)\n15|\t}\n16|\treturn body\n17|}\n18|\n19|func matchingObservation() StatusObservation {\n20|\teffect := terminalbackend.EffectInputClosed\n21|\treturn StatusObservation{\n22|\t\tState:           terminalbackend.StateActive,\n23|\t\tIdentityMatch:   true,\n24|\t\tWrapperPresent:  true,\n25|\t\tAttachable:      false,\n26|\t\tLastEffect:      &effect,\n27|\t\tEvidenceIDs:     []string{fixtureDigestA},\n28|\t\tSessionID:       fixtureSessionA,\n29|\t\tInstanceID:      fixtureInstance,\n30|\t\tBackendID:       fixtureBackend,\n31|\t\tImplVersion:     fixtureImpl,\n32|\t\tProtoVersion:    fixtureProto,\n33|\t\tGeneration:      fixtureGen,\n34|\t\tAttachEvidenced: false,\n35|\t}\n36|}\n37|\n38|// TestExecuteStatusAdoptsReportedState drives the status row through the\n39|// production entry: the reported state is adopted verbatim — including\n40|// drift from the caller's source — with no receipt, no side effects\n41|// and no authorization.\n42|func TestExecuteStatusAdoptsReportedState(t *testing.T) {\n43|\tbackend := newMockBackend()\n44|\tbackend.observation = matchingObservation()\n45|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n46|\treport, err := engine.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"parked\"), testAdmitted(\"durable_disconnect\"))\n47|\tif err != nil {\n48|\t\tt.Fatalf(\"ExecuteStatus() error = %v\", err)\n49|\t}\n50|\trequireLiteral(t, \"state\", string(report.State), \"active\")\n51|\tif !report.IdentityMatch {\n52|\t\tt.Error(\"identity_match = false, want true\")\n53|\t}\n54|\tif len(backend.performed()) != 0 {\n55|\t\tt.Errorf(\"performed = %v, want no effects on status\", backend.performed())\n56|\t}\n57|\timage, err := engine.Store.Export()\n58|\tif err != nil {\n59|\t\tt.Fatalf(\"Export() error = %v\", err)\n60|\t}\n61|\tif len(image) != 0 {\n62|\t\tt.Errorf(\"store export = %q, want no receipts on status\", string(image))\n63|\t}\n64|}\n65|\n66|// TestExecuteStatusAllSources drives status from every one of the eight\n67|// states through the production entry: the same-state row admits them\n68|// all and transitions none.\n69|func TestExecuteStatusAllSources(t *testing.T) {\n70|\tfor _, source := range []string{\"absent\", \"creating\", \"parked\", \"active\", \"quiescing\", \"stopped\", \"stale_fenced\", \"unavailable\"} {\n71|\t\tt.Run(source, func(t *testing.T) {\n72|\t\t\tbackend := newMockBackend()\n73|\t\t\tobserved := matchingObservation()\n74|\t\t\tobserved.State = mustParseState(t, source)\n75|\t\t\tbackend.observation = observed\n76|\t\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n77|\t\t\treport, err := engine.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, source), testAdmitted(\"durable_disconnect\"))\n78|\t\t\tif err != nil {\n79|\t\t\t\tt.Fatalf(\"ExecuteStatus(%s) error = %v\", source, err)\n80|\t\t\t}\n81|\t\t\trequireLiteral(t, \"state\", string(report.State), source)\n82|\t\t})\n83|\t}\n84|\t// An unknown (empty) source is admitted too: the report is adopted\n85|\t// as the first observation.\n86|\tbackend := newMockBackend()\n87|\tbackend.observation = matchingObservation()\n88|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n89|\treport, err := engine.ExecuteStatus(contextGo(), exactStatusBody(t), \"\", testAdmitted(\"durable_disconnect\"))\n90|\tif err != nil {\n91|\t\tt.Fatalf(\"ExecuteStatus(unknown source) error = %v\", err)\n92|\t}\n93|\trequireLiteral(t, \"state\", string(report.State), \"active\")\n94|}\n95|\n96|// TestExecuteStatusNonMatchAdoptsAbsent proves a successful non-match\n97|// read adopts the canonical absent form: drifted generation with the\n98|// false form is a proven absence, not an error.\n99|func TestExecuteStatusNonMatchAdoptsAbsent(t *testing.T) {\n100|\tbackend := newMockBackend()\n101|\tbackend.observation = StatusObservation{\n102|\t\tState:         terminalbackend.StateAbsent,\n103|\t\tIdentityMatch: false,\n104|\t\tSessionID:     fixtureSessionA,\n105|\t\tInstanceID:    fixtureInstance,\n106|\t\tBackendID:     fixtureBackend,\n107|\t\tImplVersion:   fixtureImpl,\n108|\t\tProtoVersion:  fixtureProto,\n109|\t\tGeneration:    \"generation-two\",\n110|\t}\n111|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n112|\treport, err := engine.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n113|\tif err != nil {\n114|\t\tt.Fatalf(\"ExecuteStatus() error = %v\", err)\n115|\t}\n116|\trequireLiteral(t, \"state\", string(report.State), \"absent\")\n117|\tif report.IdentityMatch {\n118|\t\tt.Error(\"identity_match = true, want false\")\n119|\t}\n120|}\n121|\n122|// TestExecuteStatusUnknownIsNeverAbsent proves a timeout or read failure\n123|// is unknown, never absent: coded failures pass their row code through\n124|// with no report, uncoded failures refuse unavailable with no report,\n125|// and a code outside the status set is rejected.\n126|func TestExecuteStatusUnknownIsNeverAbsent(t *testing.T) {\n127|\tbackend := newMockBackend()\n128|\tbackend.observeErr = refuse(\"terminal_backend_timeout\", \"test timeout\")\n129|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n130|\t_, err := engine.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n(more lines below)","final_result":true}}}
