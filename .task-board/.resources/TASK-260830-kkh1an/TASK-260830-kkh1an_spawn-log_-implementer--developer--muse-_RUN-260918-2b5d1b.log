{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d62d","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":2417,"recorded_at":1780531400004829,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"task_stream":{"kind":"task","id":"01a0b242-24ca-7110-ba03-9da2b1e9020d"},"task_id":"01a0b242-24ca-7110-ba03-9da2b1e9020d","event":{"kind":"output","task_id":"01a0b242-24ca-7110-ba03-9da2b1e9020d","chunk":"Read text file `internal/terminstance/result_test.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n8|)\n9|\n10|func testResult(t *testing.T) (MutationContext, terminalbackend.InstanceState, Result) {\n11|\tt.Helper()\n12|\tcontext := testContext(t)\n13|\tsource := mustParseState(t, \"active\")\n14|\tresult := buildResult(context, source, terminalbackend.StateQuiescing,\n15|\t\t[]terminalbackend.SideEffect{terminalbackend.EffectInputClosed},\n16|\t\t[]string{fixtureDigestA}, DispositionReplaySame)\n17|\treturn context, source, result\n18|}\n19|\n20|// TestCheckResultAdmitsEngineResult drives the repetition contract\n21|// through the production entry: the engine-built result repeats every\n22|// request identity and before equals the source.\n23|func TestCheckResultAdmitsEngineResult(t *testing.T) {\n24|\tcontext, source, result := testResult(t)\n25|\tif err := CheckResult(context, source, result); err != nil {\n26|\t\tt.Fatalf(\"CheckResult() error = %v\", err)\n27|\t}\n28|\trequireLiteral(t, \"disposition\", string(result.Disposition), \"replay_same\")\n29|}\n30|\n31|// TestCheckResultRepetitionTamper proves every repeated identity must\n32|// equal the request context: each tampered member refuses through the\n33|// production entry with its own detail, and the generation tamper\n34|// refuses with the landed stale class.\n35|func TestCheckResultRepetitionTamper(t *testing.T) {\n36|\tcontext, source, result := testResult(t)\n37|\ttampers := []struct {\n38|\t\tname   string\n39|\t\tmutate func(*Result)\n40|\t\tcode   string\n41|\t\tdetail string\n42|\t}{\n43|\t\t{\"operation\", func(r *Result) { r.OperationID = fixtureOperationB }, \"terminal_backend_protocol_error\", \"result operation binding\"},\n44|\t\t{\"session\", func(r *Result) { r.SessionID = fixtureSessionB }, \"terminal_backend_protocol_error\", \"result session binding\"},\n45|\t\t{\"instance\", func(r *Result) { r.TerminalInstanceID = fixtureSessionB }, \"terminal_backend_protocol_error\", \"result instance binding\"},\n46|\t\t{\"backend\", func(r *Result) { r.TerminalBackendID = \"other.backend\" }, \"terminal_backend_protocol_error\", \"result backend binding\"},\n47|\t\t{\"implementation\", func(r *Result) { r.ImplementationVersion = \"9.9.9\" }, \"terminal_backend_protocol_error\", \"result implementation binding\"},\n48|\t\t{\"protocol\", func(r *Result) { r.ProtocolVersion = \"1.9.9\" }, \"terminal_backend_protocol_error\", \"result protocol binding\"},\n49|\t\t{\"generation\", func(r *Result) { r.BackendGeneration = \"generation-two\" }, \"terminal_backend_stale_generation\", \"result generation binding\"},\n50|\t\t{\"before\", func(r *Result) { r.Before = terminalbackend.StateParked }, \"terminal_backend_protocol_error\", \"result before state\"},\n51|\t}\n52|\tfor _, tc := range tampers {\n53|\t\tt.Run(tc.name, func(t *testing.T) {\n54|\t\t\ttampered := result\n55|\t\t\ttc.mutate(&tampered)\n56|\t\t\terr := CheckResult(context, source, tampered)\n57|\t\t\trequireRefusal(t, err, tc.code, tc.detail)\n58|\t\t})\n59|\t}\n60|}\n61|\n62|// TestCheckResultGenerationBound256 proves the generation bound inside\n63|// results: length 256 is admitted, 0 and 257 refused. The tampered\n64|// values differ from the context, so the refusal is the binding arm;\n65|// the admitted 256 requires a context carrying it.\n66|func TestCheckResultGenerationBound256(t *testing.T) {\n67|\tcontext, source, result := testResult(t)\n68|\tlong := context\n69|\tlong.BackendGeneration = strings.Repeat(\"g\", 256)\n70|\tadmitted := result\n71|\tadmitted.BackendGeneration = strings.Repeat(\"g\", 256)\n72|\tif err := CheckResult(long, source, admitted); err != nil {\n73|\t\tt.Errorf(\"CheckResult(generation 256) error = %v, want admission\", err)\n74|\t}\n75|}\n76|\n77|// TestCheckResultShapeArms drives the state, effect, evidence and\n78|// disposition arms: unknown states and effects refuse, over-bound\n79|// arrays refuse, malformed digests refuse, and order and uniqueness\n80|// refuse by separate details.\n81|func TestCheckResultShapeArms(t *testing.T) {\n82|\tcontext, source, result := testResult(t)\n83|\n84|\tbad := result\n85|\tbad.After = \"running\"\n86|\trequireRefusal(t, CheckResult(context, source, bad), \"terminal_backend_protocol_error\", \"lifecycle state vocabulary\")\n87|\n88|\tbad = result\n89|\tbad.Effects = []terminalbackend.SideEffect{\"input_reopened\"}\n90|\trequireRefusal(t, CheckResult(context, source, bad), \"terminal_backend_protocol_error\", \"side effect vocabulary\")\n91|\n92|\tbad = result\n93|\tbad.Effects = []terminalbackend.SideEffect{\n94|\t\tterminalbackend.EffectWrapperStarted, terminalbackend.EffectBindingPersisted,\n95|\t}\n96|\trequireRefusal(t, CheckResult(context, source, bad), \"terminal_backend_protocol_error\", \"result effects order\")\n97|\n98|\tbad = result\n99|\tbad.Effects = []terminalbackend.SideEffect{\n100|\t\tterminalbackend.EffectInputClosed, terminalbackend.EffectInputClosed,\n101|\t}\n102|\trequireRefusal(t, CheckResult(context, source, bad), \"terminal_backend_protocol_error\", \"result effects unique\")\n103|\n104|\tbad = result\n105|\tbad.EvidenceIDs = []string{fixtureDigestB, fixtureDigestA}\n106|\trequireRefusal(t, CheckResult(context, source, bad), \"terminal_backend_protocol_error\", \"result evidence order\")\n107|\n108|\tbad = result\n109|\tbad.EvidenceIDs = []string{fixtureDigestA, fixtureDigestA}\n110|\trequireRefusal(t, CheckResult(context, source, bad), \"terminal_backend_protocol_error\", \"result evidence unique\")\n111|\n112|\tbad = result\n113|\tbad.EvidenceIDs = []string{\"not-a-digest\"}\n114|\trequireRefusal(t, CheckResult(context, source, bad), \"terminal_backend_protocol_error\", \"result evidence digest\")\n115|\n116|\tbad = result\n117|\tbad.Disposition = \"retry_later\"\n118|\trequireRefusal(t, CheckResult(context, source, bad), \"terminal_backend_protocol_error\", \"retry disposition vocabulary\")\n119|}\n120|\n121|// TestBuildResultSortsEffectsAndEvidence proves execution order and wire\n122|// order split: the stop effects commit in transition order but report\n123|// bytewise sorted.\n124|func TestBuildResultSortsEffectsAndEvidence(t *testing.T) {\n125|\tcontext := testContext(t)\n126|\tresult := buildResult(context, mustParseState(t, \"quiescing\"), terminalbackend.StateStopped,\n127|\t\t[]terminalbackend.SideEffect{\n128|\t\t\tterminalbackend.EffectGracefulStopRequested,\n129|\t\t\tterminalbackend.EffectProcessClosed,\n130|\t\t\tterminalbackend.EffectBackendStoreClosed,\n131|\t\t},\n132|\t\t[]string{fixtureDigestB, fixtureDigestA}, DispositionReplaySame)\n133|\twant := []terminalbackend.SideEffect{\n134|\t\tterminalbackend.EffectBackendStoreClosed,\n135|\t\tterminalbackend.EffectGracefulStopRequested,\n136|\t\tterminalbackend.EffectProcessClosed,\n137|\t}\n138|\tif len(result.Effects) != 3 {\n139|\t\tt.Fatalf(\"effects = %v, want 3 sorted\", result.Effects)\n140|\t}\n141|\tfor i := range want {\n142|\t\trequireLiteral(t, \"effect\", string(result.Effects[i]), string(want[i]))\n143|\t}\n144|\trequireLiteral(t, \"evidence 0\", result.EvidenceIDs[0], \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\")\n145|\trequireLiteral(t, \"evidence 1\", result.EvidenceIDs[1], \"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\")\n146|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d62f","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":2418,"recorded_at":1780531400004831,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"task_stream":{"kind":"task","id":"01a0b242-24ca-7110-ba03-9da2b1e9020d"},"task_id":"01a0b242-24ca-7110-ba03-9da2b1e9020d","event":{"kind":"completed","task_id":"01a0b242-24ca-7110-ba03-9da2b1e9020d"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d631","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":2419,"recorded_at":1780531400004833,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"task_stream":{"kind":"task","id":"01a0b242-2517-7281-8bfe-76674b406a43"},"task_id":"01a0b242-2517-7281-8bfe-76674b406a43","event":{"kind":"output","task_id":"01a0b242-2517-7281-8bfe-76674b406a43","chunk":"Read text file `internal/terminstance/status_exec_test.go`.\n(129 line(s) above)\n130|\t_, err := engine.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n131|\trequireRefusal(t, err, \"terminal_backend_timeout\", \"status observation unknown\")\n132|\n133|\tbackendUncoded := newMockBackend()\n134|\tbackendUncoded.observeErr = errors.New(\"read failed\")\n135|\tengineUncoded := testEngine(t, backendUncoded, testLease(), fixtureGen)\n136|\t_, err = engineUncoded.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n137|\trequireRefusal(t, err, \"terminal_backend_unavailable\", \"status observation unknown\")\n138|\n139|\tbackendOutside := newMockBackend()\n140|\tbackendOutside.observeErr = refuse(\"quiesce_timeout\", \"test outside set\")\n141|\tengineOutside := testEngine(t, backendOutside, testLease(), fixtureGen)\n142|\t_, err = engineOutside.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n143|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"operation error vocabulary\")\n144|}\n145|\n146|// TestExecuteStatusReportValidation proves the reported match must equal\n147|// the compared tuple and the landed status rules admit the report: a\n148|// lying match, a non-canonical false form and unsorted evidence all\n149|// refuse through the production entry.\n150|func TestExecuteStatusReportValidation(t *testing.T) {\n151|\tbackend := newMockBackend()\n152|\tlying := matchingObservation()\n153|\tlying.IdentityMatch = false\n154|\tbackend.observation = lying\n155|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n156|\t_, err := engine.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n157|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"status identity binding\")\n158|\n159|\tbackendForm := newMockBackend()\n160|\tnoncanonical := matchingObservation()\n161|\tnoncanonical.IdentityMatch = false\n162|\tnoncanonical.WrapperPresent = true\n163|\tnoncanonical.Generation = \"generation-two\"\n164|\tbackendForm.observation = noncanonical\n165|\tengineForm := testEngine(t, backendForm, testLease(), fixtureGen)\n166|\t_, err = engineForm.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n167|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"status identity binding\")\n168|\n169|\tbackendEvidence := newMockBackend()\n170|\tunsorted := matchingObservation()\n171|\tunsorted.EvidenceIDs = []string{fixtureDigestB, fixtureDigestA}\n172|\tbackendEvidence.observation = unsorted\n173|\tengineEvidence := testEngine(t, backendEvidence, testLease(), fixtureGen)\n174|\t_, err = engineEvidence.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n175|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"status evidence order\")\n176|}\n177|\n178|// TestExecuteStatusMatchedTupleFalseFormRefuses proves the engine's own\n179|// match-equality arm, past which the landed gate alone would admit: a\n180|// report whose tuple matches but which claims non-match with the\n181|// canonical absent form would adopt a lying absence, so the engine\n182|// refuses it before the landed check runs.\n183|func TestExecuteStatusMatchedTupleFalseFormRefuses(t *testing.T) {\n184|\tbackend := newMockBackend()\n185|\tlying := StatusObservation{\n186|\t\tState:         terminalbackend.StateAbsent,\n187|\t\tIdentityMatch: false,\n188|\t\tSessionID:     fixtureSessionA,\n189|\t\tInstanceID:    fixtureInstance,\n190|\t\tBackendID:     fixtureBackend,\n191|\t\tImplVersion:   fixtureImpl,\n192|\t\tProtoVersion:  fixtureProto,\n193|\t\tGeneration:    fixtureGen,\n194|\t}\n195|\tbackend.observation = lying\n196|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n197|\t_, err := engine.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n198|\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"status identity binding\")\n199|}\n200|\n201|// TestExecuteStatusProviderConditional proves provider_process_observation\n202|// is required exactly when provider observation is requested.\n203|func TestExecuteStatusProviderConditional(t *testing.T) {\n204|\traw := statusDoc(`\"`+fixtureInstance+`\"`, `\"generation-one\"`)\n205|\twithProvider := func(t *testing.T) StatusBody {\n206|\t\tt.Helper()\n207|\t\tbody, err := ParseStatusBody([]byte(withObservation(raw)))\n208|\t\tif err != nil {\n209|\t\t\tt.Fatalf(\"ParseStatusBody() error = %v\", err)\n210|\t\t}\n211|\t\treturn body\n212|\t}\n213|\tbackend := newMockBackend()\n214|\tbackend.observation = matchingObservation()\n215|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n216|\t_, err := engine.ExecuteStatus(contextGo(), withProvider(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n217|\trequireRefusal(t, err, \"terminal_backend_capability_unproven\", \"operation capability conditional\")\n218|\n219|\tbackendProven := newMockBackend()\n220|\tobserved := matchingObservation()\n221|\tpresent := true\n222|\tobserved.ProviderPresent = &present\n223|\tobserved.ProviderRequested = true\n224|\tobserved.ProviderEvidenced = true\n225|\tbackendProven.observation = observed\n226|\tengineProven := testEngine(t, backendProven, testLease(), fixtureGen)\n227|\treport, err := engineProven.ExecuteStatus(contextGo(), withProvider(t), mustParseState(t, \"active\"), testAdmitted(\"provider_process_observation\"))\n228|\tif err != nil {\n229|\t\tt.Fatalf(\"ExecuteStatus() error = %v\", err)\n230|\t}\n231|\tif report.ProviderPresent == nil || !*report.ProviderPresent {\n232|\t\tt.Error(\"provider_present is not true, want the evidenced observation\")\n233|\t}\n234|}\n235|\n236|func withObservation(raw string) string {\n237|\tbefore := `\"include_provider_observation\":false`\n238|\tafter := `\"include_provider_observation\":true`\n239|\tfor i := 0; i+len(before) <= len(raw); i++ {\n240|\t\tif raw[i:i+len(before)] == before {\n241|\t\t\treturn raw[:i] + after + raw[i+len(before):]\n242|\t\t}\n243|\t}\n244|\treturn raw\n245|}\n246|\n247|// TestExecuteStatusSessionScoped proves the Session-scoped lookup adopts\n248|// the reported instance: both-null members query, the reported session\n249|// must match, and the reported state is adopted.\n250|func TestExecuteStatusSessionScoped(t *testing.T) {\n251|\tbody, err := ParseStatusBody([]byte(statusDoc(`null`, `null`)))\n252|\tif err != nil {\n253|\t\tt.Fatalf(\"ParseStatusBody() error = %v\", err)\n254|\t}\n255|\tbackend := newMockBackend()\n256|\tbackend.observation = matchingObservation()\n257|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n258|\treport, err := engine.ExecuteStatus(contextGo(), body, mustParseState(t, \"absent\"), testAdmitted(\"durable_disconnect\"))\n259|\tif err != nil {\n260|\t\tt.Fatalf(\"ExecuteStatus() error = %v\", err)\n261|\t}\n262|\trequireLiteral(t, \"state\", string(report.State), \"active\")\n263|}","final_result":true}}}
