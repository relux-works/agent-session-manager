{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ce99","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":1447,"recorded_at":1780531400002889,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"task_stream":{"kind":"task","id":"01a0b23c-8343-77e1-b77f-77d02f6f0b01"},"task_id":"01a0b23c-8343-77e1-b77f-77d02f6f0b01","event":{"kind":"output","task_id":"01a0b23c-8343-77e1-b77f-77d02f6f0b01","chunk":"Read text file `internal/fencing/gate.go`.\n(117 line(s) above)\n118|type Operation string\n119|\n120|const (\n121|\t// OperationActivation gates provider activation and launch: only\n122|\t// the winning committed lease may create a destination runtime.\n123|\tOperationActivation Operation = \"activation\"\n124|\t// OperationInput gates provider input after attach (the\n125|\t// quiesce-input and attach direction): the owner revalidates\n126|\t// before accepting operator input.\n127|\tOperationInput Operation = \"input\"\n128|\t// OperationMutation gates owner-authored mutation: event append\n129|\t// and compare-and-swap succession carry the winning epoch.\n130|\tOperationMutation Operation = \"mutation\"\n131|\t// OperationCheckpoint gates checkpoint capture admission: a fresh\n132|\t// checkpoint is published under the current lease only.\n133|\tOperationCheckpoint Operation = \"checkpoint\"\n134|\t// OperationRestore gates terminal restore and the wrapper's first\n135|\t// start: ownership is compared before any provider resume.\n136|\tOperationRestore Operation = \"restore\"\n137|)\n138|\n139|// validOperation reports whether op names a gated action. Anything\n140|// else is a malformed gate call, never an authorized action.\n141|func validOperation(op Operation) bool {\n142|\tswitch op {\n143|\tcase OperationActivation, OperationInput, OperationMutation, OperationCheckpoint, OperationRestore:\n144|\t\treturn true\n145|\t}\n146|\treturn false\n147|}\n148|\n149|// launchClass reports whether op is a launch-class entry: activation\n150|// and restore park when ownership is remote, ambiguous, unverified,\n151|// or absent, while input, mutation, and checkpoint refuse outright.\n152|func launchClass(op Operation) bool {\n153|\treturn op == OperationActivation || op == OperationRestore\n154|}\n155|\n156|// PresentedToken is the caller's claimed fencing authority: the local\n157|// fencing token the wrapper compares, or the token a takeover, input,\n158|// mutation, or checkpoint caller holds. It is untrusted input: every\n159|// member is grammar-checked before any comparison runs.\n160|type PresentedToken struct {\n161|\tSessionID string\n162|\tEpoch     uint64\n163|\tLeaseID   string\n164|}\n165|\n166|// Observation carries the verified durable and sync facts the gate\n167|// decides over. Observe builds it from the repository; callers that\n168|// build it by hand (tests, modeled flows) must supply the same facts.\n169|// The winner is trusted only through its grammar: a malformed winning\n170|// summary refuses rather than authorizing against garbage.\n171|type Observation struct {\n172|\tSessionID string\n173|\t// Winner is the winning lease summary with its holder. It is\n174|\t// meaningful only when HasWinner is set.\n175|\tWinner    sessrepo.LeaseSummary\n176|\tHasWinner bool\n177|\t// LocalHostID is the host asking for authorization. An unknown or\n178|\t// empty local identity never equals the winning holder, so it\n179|\t// fails closed to the remote arm without a grammar check.\n180|\tLocalHostID string\n181|\t// Verified reports that a mesh lease refresh proved current\n182|\t// lease knowledge. Unverified ownership parks or refuses.\n183|\tVerified bool\n184|\t// Ambiguous reports conflicting ownership observations (a union\n185|\t// rival the local store cannot order). Ambiguity parks or refuses.\n186|\tAmbiguous bool\n187|\t// HandoffFailed reports that the caller's own handoff already\n188|\t// failed (a losing force lease before activation). A failed\n189|\t// handoff parks with failed_handoff instead of activating.\n190|\tHandoffFailed bool\n191|\t// Grant is the process-local authorization derived from a winning\n192|\t// lease, meaningful only when HasGrant is set. The gate re-checks\n193|\t// its expiry through the sessrepo owner on every call.\n194|\tGrant    sessrepo.FencingGrant\n195|\tHasGrant bool\n196|\t// Policy carries the configured lease refresh interval the\n197|\t// expiry arm enforces.\n198|\tPolicy sessrepo.FencingPolicy\n199|\t// Now is the caller's clock reading for the expiry arm. A grant\n200|\t// without a clock reading refuses rather than bypassing expiry.\n201|\tNow time.Time\n202|}\n203|\n204|// ObserveInput carries the caller-reported facts Observe combines with\n205|// the durable winning lease: sync state, handoff outcome, the\n206|// process-local fencing grant with its policy, and the clock reading.\n207|type ObserveInput struct {\n208|\tLocalHostID   string\n209|\tVerified      bool\n210|\tAmbiguous     bool\n211|\tHandoffFailed bool\n212|\tGrant         sessrepo.FencingGrant\n213|\tHasGrant      bool\n214|\tPolicy        sessrepo.FencingPolicy\n215|\tNow           time.Time\n216|}\n217|\n(more lines below)","final_result":true}}}
