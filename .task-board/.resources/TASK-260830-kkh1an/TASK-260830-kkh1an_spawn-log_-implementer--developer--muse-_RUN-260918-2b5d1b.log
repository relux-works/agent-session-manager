{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d153","stream":{"kind":"session","id":"01a0b232-ed9f-73f2-b41b-df749face5b0"},"sequence":1796,"recorded_at":1780531400003587,"record_type":"event","durability":"durable","causation_id":"5f437c29-0343-41ba-a118-050af5991fa2","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f437c29-0343-41ba-a118-050af5991fa2","run_stream":{"kind":"run","id":"5f437c29-0343-41ba-a118-050af5991fa2"},"task_stream":{"kind":"task","id":"01a0b23d-e833-7cc2-b572-e08b8aea6306"},"task_id":"01a0b23d-e833-7cc2-b572-e08b8aea6306","event":{"kind":"output","task_id":"01a0b23d-e833-7cc2-b572-e08b8aea6306","chunk":"Read text file `internal/terminstance/execute_test.go`.\n(312 line(s) above)\n313|// TestExecutePostEffectErrorsMoveUnavailable proves an error after a\n314|// committed effect whose result cannot be proven moves the local\n315|// observation to unavailable with status_first and never claims\n316|// absent: a coded refusal on the second stop effect, an uncoded\n317|// backend failure on the first effect, malformed success evidence,\n318|// and a refusal code outside the row set.\n319|func TestExecutePostEffectErrorsMoveUnavailable(t *testing.T) {\n320|\tt.Run(\"coded refusal on second effect\", func(t *testing.T) {\n321|\t\tbackend := newMockBackend()\n322|\t\tbackend.effectErrors[terminalbackend.EffectProcessClosed] = refuse(\"terminal_backend_process_failed\", \"test crash\")\n323|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n324|\t\tcontext, params, source, admitted := stopFixture(t)\n325|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationRequestStop, context, params, source, admitted)\n326|\t\trequireRefusal(t, err, \"terminal_backend_process_failed\", \"backend effect refused\")\n327|\t\trequireLiteral(t, \"after\", string(result.After), \"unavailable\")\n328|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"status_first\")\n329|\t\tperformed := backend.performed()\n330|\t\tif len(performed) != 2 {\n331|\t\t\tt.Errorf(\"performed = %v, want the first effect committed and the second attempted\", performed)\n332|\t\t}\n333|\t})\n334|\n335|\tt.Run(\"uncoded failure on first effect\", func(t *testing.T) {\n336|\t\tbackend := newMockBackend()\n337|\t\tbackend.effectErrors[terminalbackend.EffectInputClosed] = errors.New(\"backend transport died\")\n338|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n339|\t\tcontext, params, source, admitted := quiesceFixture(t)\n340|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n341|\t\trequireRefusal(t, err, \"terminal_backend_process_failed\", \"backend effect uncertain\")\n342|\t\trequireLiteral(t, \"after\", string(result.After), \"unavailable\")\n343|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"status_first\")\n344|\t})\n345|\n346|\tt.Run(\"malformed success evidence\", func(t *testing.T) {\n347|\t\tbackend := newMockBackend()\n348|\t\tbackend.evidence[terminalbackend.EffectInputClosed] = \"not-a-digest\"\n349|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n350|\t\tcontext, params, source, admitted := quiesceFixture(t)\n351|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n352|\t\trequireRefusal(t, err, \"terminal_backend_integrity_failure\", \"backend effect evidence\")\n353|\t\trequireLiteral(t, \"after\", string(result.After), \"unavailable\")\n354|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"status_first\")\n355|\t})\n356|\n357|\tt.Run(\"code outside the row set\", func(t *testing.T) {\n358|\t\tbackend := newMockBackend()\n359|\t\tbackend.effectErrors[terminalbackend.EffectInputClosed] = refuse(\"stop_timeout\", \"test wrong row\")\n360|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n361|\t\tcontext, params, source, admitted := quiesceFixture(t)\n362|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n363|\t\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"operation error vocabulary\")\n364|\t\trequireLiteral(t, \"after\", string(result.After), \"unavailable\")\n365|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"status_first\")\n366|\t})\n367|}\n368|\n369|// TestExecuteRechecksBeforeEachEffect proves authorization and\n370|// generation are rechecked immediately before each side effect, not\n371|// once at entry: a lease rotation and a generation rotation between\n372|// the first and second stop effects are both caught at the second\n373|// recheck, after one committed effect.\n374|func TestExecuteRechecksBeforeEachEffect(t *testing.T) {\n375|\tt.Run(\"lease rotates mid-operation\", func(t *testing.T) {\n376|\t\tbackend := newMockBackend()\n377|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n378|\t\tcalls := 0\n379|\t\tengine.CurrentLease = func() LeaseView {\n380|\t\t\tcalls++\n381|\t\t\tif calls <= 2 {\n382|\t\t\t\treturn testLease()\n383|\t\t\t}\n384|\t\t\treturn LeaseView{LeaseID: fixtureLease, Epoch: 2}\n385|\t\t}\n386|\t\tcontext, params, source, admitted := stopFixture(t)\n387|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationRequestStop, context, params, source, admitted)\n388|\t\trequireRefusal(t, err, \"terminal_backend_unauthorized\", \"ax authorization lease epoch\")\n389|\t\trequireLiteral(t, \"after\", string(result.After), \"unavailable\")\n390|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"new_authorization\")\n391|\t\tif len(backend.performed()) != 1 {\n392|\t\t\tt.Errorf(\"performed = %v, want exactly the first effect committed\", backend.performed())\n393|\t\t}\n394|\t})\n395|\n396|\tt.Run(\"generation rotates mid-operation\", func(t *testing.T) {\n397|\t\tbackend := newMockBackend()\n398|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n399|\t\tcalls := 0\n400|\t\tengine.CurrentGeneration = func() string {\n401|\t\t\tcalls++\n402|\t\t\tif calls <= 2 {\n403|\t\t\t\treturn fixtureGen\n404|\t\t\t}\n405|\t\t\treturn \"generation-two\"\n406|\t\t}\n407|\t\tcontext, params, source, admitted := stopFixture(t)\n408|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationRequestStop, context, params, source, admitted)\n409|\t\trequireRefusal(t, err, \"terminal_backend_stale_generation\", \"backend_generation stale\")\n410|\t\trequireLiteral(t, \"after\", string(result.After), \"unavailable\")\n411|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"status_first\")\n412|\t\tif len(backend.performed()) != 1 {\n413|\t\t\tt.Errorf(\"performed = %v, want exactly the first effect committed\", backend.performed())\n414|\t\t}\n415|\t})\n416|\n417|\tt.Run(\"rotation before first effect restores source\", func(t *testing.T) {\n418|\t\tbackend := newMockBackend()\n419|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n420|\t\tcalls := 0\n421|\t\tengine.CurrentLease = func() LeaseView {\n422|\t\t\tcalls++\n423|\t\t\tif calls == 1 {\n424|\t\t\t\treturn testLease()\n425|\t\t\t}\n426|\t\t\treturn LeaseView{LeaseID: fixtureLeaseB, Epoch: 1}\n427|\t\t}\n428|\t\tcontext, params, source, admitted := quiesceFixture(t)\n429|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n430|\t\trequireRefusal(t, err, \"terminal_backend_unauthorized\", \"ax authorization lease identity\")\n431|\t\trequireLiteral(t, \"after\", string(result.After), \"active\")\n432|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"new_authorization\")\n433|\t\tif len(backend.performed()) != 0 {\n434|\t\t\tt.Errorf(\"performed = %v, want no effects\", backend.performed())\n435|\t\t}\n436|\t})\n437|\n438|\tt.Run(\"generation rotation before first effect restores source\", func(t *testing.T) {\n439|\t\tbackend := newMockBackend()\n440|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n441|\t\tcalls := 0\n442|\t\tengine.CurrentGeneration = func() string {\n443|\t\t\tcalls++\n444|\t\t\tif calls == 1 {\n445|\t\t\t\treturn fixtureGen\n446|\t\t\t}\n447|\t\t\treturn \"generation-two\"\n448|\t\t}\n449|\t\tcontext, params, source, admitted := quiesceFixture(t)\n450|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationQuiesceInput, context, params, source, admitted)\n451|\t\trequireRefusal(t, err, \"terminal_backend_stale_generation\", \"backend_generation stale\")\n452|\t\trequireLiteral(t, \"after\", string(result.After), \"active\")\n453|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"status_first\")\n454|\t\tif len(backend.performed()) != 0 {\n455|\t\t\tt.Errorf(\"performed = %v, want no effects\", backend.performed())\n456|\t\t}\n457|\t})\n458|}\n459|\n460|// TestExecuteDeadlineNeverCancelsCommittedEffect proves a deadline\n461|// breached after the first effect leaves the committed effect standing\n462|// and moves to unavailable: the performed prefix is reported, not\n463|// rolled back.\n464|func TestExecuteDeadlineNeverCancelsCommittedEffect(t *testing.T) {\n465|\tbackend := newMockBackend()\n466|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n467|\tbreached := false\n468|\tengine.Hooks = &EngineHooks{AfterEffect: func(terminalbackend.SideEffect) { breached = true }}\n469|\tengine.Now = func() time.Time {\n470|\t\tif breached {\n471|\t\t\treturn fixturePastDeadline()\n472|\t\t}\n473|\t\treturn fixtureNow()\n474|\t}\n475|\tcontext, params, source, admitted := stopFixture(t)\n476|\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationRequestStop, context, params, source, admitted)\n477|\trequireRefusal(t, err, \"stop_timeout\", \"operation deadline\")\n(more lines below)","final_result":true}}}
