n(string(result.Disposition)); err != nil {\n76|\t\treturn err\n77|\t}\n78|\treturn nil\n79|}\n80|\n81|// checkSortedUniqueEffects enforces sorted-unique [0..10] over parsed\n82|// side effects. Order and uniqueness are two obligations with two arms:\n83|// an unsorted-but-unique vector and a sorted-but-duplicated vector are\n84|// refused by different details, so a mutant dropping either half is\n85|// killed by its own vector.\n86|func checkSortedUniqueEffects(effects []terminalbackend.SideEffect) error {\n87|\tif len(effects) > 10 {\n88|\t\treturn refuse(CodeProtocolError, \"result effects bound\")\n89|\t}\n90|\tfor _, effect := range effects {\n91|\t\tif _, err := terminalbackend.ParseSideEffect(string(effect)); err != nil {\n92|\t\t\treturn wrapLanded(err)\n93|\t\t}\n94|\t}\n95|\tfor index := 1; index < len(effects); index++ {\n96|\t\tif effects[index-1] == effects[index] {\n97|\t\t\treturn refuse(CodeProtocolError, \"result effects unique\")\n98|\t\t}\n99|\t}\n100|\tfor index := 1; index < len(effects); index++ {\n101|\t\tif effects[index-1] > effects[index] {\n102|\t\t\treturn refuse(CodeProtocolError, \"result effects order\")\n103|\t\t}\n104|\t}\n105|\treturn nil\n106|}\n107|\n108|// checkSortedUniqueEvidence enforces sorted-unique digest[0..256] on a\n109|// mutation result. Order and uniqueness are separate arms for the same\n110|// reason as the effects twin: each half owns its mutant.\n111|func checkSortedUniqueEvidence(evidence []string) error {\n112|\treturn checkSortedUniqueEvidenceWhere(evidence, \"result\")\n113|}\n114|\n115|// checkSortedUniqueStatusEvidence enforces the same sorted-unique\n116|// digest[0..256] rule on a status report. The rule is shared; only the\n117|// static detail site differs, so a status mutant and a result mutant\n118|// cannot kill each other's arm.\n119|func checkSortedUniqueStatusEvidence(evidence []string) error {\n120|\treturn checkSortedUniqueEvidenceWhere(evidence, \"status\")\n121|}\n122|\n123|func checkSortedUniqueEvidenceWhere(evidence []string, where string) error {\n124|\tif len(evidence) > 256 {\n125|\t\treturn refuse(CodeProtocolError, where+\" evidence bound\")\n126|\t}\n127|\tfor _, id := range evidence {\n128|\t\tif _, err := scalar.ParseDigest(id); err != nil {\n129|\t\t\treturn refuse(CodeProtocolError, where+\" evidence digest\")\n130|\t\t}\n131|\t}\n132|\tfor index := 1; index < len(evidence); index++ {\n133|\t\tif evidence[index-1] == evidence[index] {\n134|\t\t\treturn refuse(CodeProtocolError, where+\" evidence unique\")\n135|\t\t}\n136|\t}\n137|\tfor index := 1; index < len(evidence); index++ {\n138|\t\tif evidence[index-1] > evidence[index] {\n139|\t\t\treturn refuse(CodeProtocolError, where+\" evidence order\")\n140|\t\t}\n141|\t}\n142|\treturn nil\n143|}\n144|\n145|// buildResult assembles the engine result on every path. Effects and\n146|// evidence are reported sorted: execution order is the transition order\n147|// (request-stop commits graceful_stop_requested before process_closed\n148|// before backend_store_closed), while the wire order is bytewise sorted,\n149|// so the engine sorts a copy and never reorders execution.\n150|func buildResult(context MutationContext, before, after terminalbackend.InstanceState, effects []terminalbackend.SideEffect, evidence []string, disposition RetryDisposition) Result {\n151|\tordered := append([]terminalbackend.SideEffect(nil), effects...)\n152|\tsort.Slice(ordered, func(i, j int) bool { return ordered[i] < ordered[j] })\n153|\torderedEvidence := append([]string(nil), evidence...)\n154|\tsort.Strings(orderedEvidence)\n155|\treturn Result{\n156|\t\tOperationID:           context.OperationID,\n157|\t\tSessionID:             context.SessionID,\n158|\t\tTerminalInstanceID:    context.TerminalInstanceID,\n159|\t\tTerminalBackendID:     context.TerminalBackendID,\n160|\t\tImplementationVersion: context.ImplementationVersion,\n161|\t\tProtocolVersion:       context.ProtocolVersion,\n162|\t\tBackendGeneration:     context.BackendGeneration,\n163|\t\tBefore:                before,\n164|\t\tAfter:                 after,\n165|\t\tEffects:               ordered,\n166|\t\tEvidenceIDs:           orderedEvidence,\n167|\t\tDisposition:           disposition,\n168|\t}\n169|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c867","stream":{"kind":"session","id":"01a0b2ff-60d1-7b92-bcfc-8a4c766633f3"},"sequence":654,"recorded_at":1780531400001303,"record_type":"event","durability":"durable","causation_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","run_stream":{"kind":"run","id":"b5be48e9-caa3-42a3-a29a-786d769c2b71"},"call_id":"call_01a0b3010da574a3b51929e6f864b64f","text":"Read text file `internal/terminstance/disposition.go`.\n1|package terminstance\n2|\n3|// RetryDisposition is the closed §4.C retry disposition enum. Every\n4|// result carries exactly one.\n5|type RetryDisposition string\n6|\n7|// Retry dispositions.\n8|const (\n9|\tDispositionReplaySame             RetryDisposition = \"replay_same\"\n10|\tDispositionStatusFirst            RetryDisposition = \"status_first\"\n11|\tDispositionNewAuthorization       RetryDisposition = \"new_authorization\"\n12|\tDispositionRequiredOperatorAction RetryDisposition = \"required_operator_action\"\n13|)\n14|\n15|// ParseRetryDisposition admits exactly the four §4.C dispositions.\n16|func ParseRetryDisposition(value string) (RetryDisposition, error) {\n17|\tswitch RetryDisposition(value) {\n18|\tcase DispositionReplaySame, DispositionStatusFirst,\n19|\t\tDispositionNewAuthorization, DispositionRequiredOperatorAction:\n20|\t\treturn RetryDisposition(value), nil\n21|\tdefault:\n22|\t\treturn \"\", refuse(CodeProtocolError, \"retry disposition vocabulary\")\n23|\t}\n24|}\n25|\n26|// DispositionFor maps a terminal failure code to its retry disposition.\n27|// committed reports whether any side effect committed before the failure:\n28|// an error before the first effect restores the source state and may be\n29|// retried or refused by class, while an error after a committed effect\n30|// whose result cannot be proven funnels to status_first, because only a\n31|// successful status read proves what happened. The spec pins the\n32|// disposition vocabulary but not the per-code mapping, so this mapping is\n33|// the leaf's contract, pinned literally per arm:\n34|//\n35|//   - terminal_backend_unauthorized names its own remedy in both cases:\n36|//     the lease moved or lapsed and status cannot fix auth.\n37|//   - terminal_backend_timeout and quiesce_timeout are clean before any\n38|//     commit (retry the identical wait) and uncertain after one.\n39|//   - stop_timeout, idempotency_mismatch, terminal_backend_stale_generation,\n40|//     local_precondition_failed and terminal_backend_unavailable always\n41|//     route through status: a stop wait, a window conflict, a drifted\n42|//     generation, a refused precondition and an unserved backend all\n43|//     require a fresh observation before any retry.\n44|//   - terminal_backend_capability_unproven,\n45|//     terminal_backend_integrity_failure, terminal_backend_process_failed,\n46|//     terminal_backend_protocol_error and any unknown code stop automation\n47|//     before any commit (an operator must prove the capability, heal the\n48|//     backend, or fix the caller) and route through status after one,\n49|//     because the committed effect's result is then unproven.\n50|//\n51|// A code the row forbids never reaches here: the engine routes backend\n52|// reports through CheckErrorAllowed first, so the default arm below fires\n53|// only for an uncoded failure the engine classified itself.\n54|func DispositionFor(code string, committed bool) RetryDisposition {\n55|\tswitch code {\n56|\tcase CodeUnauthorized:\n57|\t\treturn DispositionNewAuthorization\n58|\tcase CodeTimeout, CodeQuiesceTimeout:\n59|\t\tif committed {\n60|\t\t\treturn DispositionStatusFirst\n61|\t\t}\n62|\t\treturn DispositionReplaySame\n63|\tcase CodeStopTimeout, CodeIdempotencyMismatch, CodeStaleGeneration,\n64|\t\tCodePreconditionFailed, CodeUnavailable:\n65|\t\treturn DispositionStatusFirst\n66|\tdefault:\n67|\t\tif committed {\n68|\t\t\treturn DispositionStatusFirst\n69|\t\t}\n70|\t\treturn DispositionRequiredOperatorAction\n71|\t}\n72|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
