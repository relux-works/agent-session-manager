{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6c3","stream":{"kind":"session","id":"01a0b2ff-60d1-7b92-bcfc-8a4c766633f3"},"sequence":444,"recorded_at":1780531400000883,"record_type":"event","durability":"durable","causation_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","run_stream":{"kind":"run","id":"b5be48e9-caa3-42a3-a29a-786d769c2b71"},"task_stream":{"kind":"task","id":"01a0b300-ade0-74a1-ad95-cb71dca068da"},"task_id":"01a0b300-ade0-74a1-ad95-cb71dca068da","event":{"kind":"output","task_id":"01a0b300-ade0-74a1-ad95-cb71dca068da","chunk":"Read text file `internal/terminstance/execute.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"time\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n10|)\n11|\n12|// Backend is the modeled terminal backend caller: side-effect execution\n13|// and status observation. No tmux/ConPTY process control and no provider\n14|// process exist behind it; tests model success, coded row refusals,\n15|// uncoded failures and crashes through this interface.\n16|type Backend interface {\n17|\t// PerformEffect executes one side effect and reports its evidence\n18|\t// ID. A nil error proves the commit; a *Error with a row code\n19|\t// proves the backend refused before committing; any other error\n20|\t// proves nothing, not even non-commit.\n21|\tPerformEffect(ctx context.Context, effect terminalbackend.SideEffect) (string, error)\n22|\t// ObserveStatus reports the backend's current observation for one\n23|\t// status body. An error is unknown, never absent.\n24|\tObserveStatus(ctx context.Context, body StatusBody) (StatusObservation, error)\n25|}\n26|\n27|// StatusObservation is the backend-reported status observation: the\n28|// reported state and match verdict, the reported identity tuple the\n29|// engine compares against the query, and the reported capability and\n30|// last-operation facts the landed CheckStatusResult validates.\n31|type StatusObservation struct {\n32|\tState             terminalbackend.InstanceState\n33|\tIdentityMatch     bool\n34|\tWrapperPresent    bool\n35|\tProviderPresent   *bool\n36|\tAttachable        bool\n37|\tLastOperationID   *string\n38|\tLastEffect        *terminalbackend.SideEffect\n39|\tEvidenceIDs       []string\n40|\tProviderRequested bool\n41|\tProviderEvidenced bool\n42|\tAttachEvidenced   bool\n43|\tSessionID         string\n44|\tInstanceID        string\n45|\tBackendID         string\n46|\tImplVersion       string\n47|\tProtoVersion      string\n48|\tGeneration        string\n49|}\n50|\n51|// StatusReport is the validated status outcome: the adopted observation.\n52|// Status performs no transition bookkeeping of its own — no receipt, no\n53|// effects, no before/after — so the report carries the single adopted\n54|// state verbatim.\n55|type StatusReport struct {\n56|\tState           terminalbackend.InstanceState\n57|\tIdentityMatch   bool\n58|\tWrapperPresent  bool\n59|\tProviderPresent *bool\n60|\tAttachable      bool\n61|\tLastOperationID *string\n62|\tLastEffect      *terminalbackend.SideEffect\n63|\tEvidenceIDs     []string\n64|}\n65|\n66|// EngineHooks arms the engine seams tests observe: AfterReceipt fires\n67|// after the durable receipt commits and before the first side effect,\n68|// carrying the interim state (creating for create, the source\n69|// otherwise); BeforeEffect and AfterEffect bracket each committed\n70|// attempt. Hooks observe only: they return nothing and cannot alter\n71|// the outcome.\n72|type EngineHooks struct {\n73|\tAfterReceipt func(operation terminalbackend.Operation, key string, interim terminalbackend.InstanceState)\n74|\tBeforeEffect func(effect terminalbackend.SideEffect)\n75|\tAfterEffect  func(effect terminalbackend.SideEffect)\n76|}\n77|\n78|// Engine executes the §4.C operation rows. Store is the durable receipt\n79|// table; Backend the modeled backend; CurrentLease and CurrentGeneration\n80|// re-read the winning lease and the validated binding generation at\n81|// every check point (function values, never snapshots, so a rotation\n82|// between entry and any effect is caught); Now is the clock. Hooks may\n83|// be nil.\n84|type Engine struct {\n85|\tStore             *ReceiptStore\n86|\tBackend           Backend\n87|\tCurrentLease      func() LeaseView\n88|\tCurrentGeneration func() string\n89|\tNow               func() time.Time\n90|\tHooks             *EngineHooks\n91|}\n92|\n93|// InterimState is the observable state between the durable idempotency\n94|// receipt and the first side effect: creating for create, the source\n95|// state for every other engine operation. creating is entered only by\n96|// create, only after its receipt and before its first listed effect.\n97|func InterimState(operation terminalbackend.Operation, source terminalbackend.InstanceState) terminalbackend.InstanceState {\n98|\tif operation == terminalbackend.OperationCreate {\n99|\t\treturn terminalbackend.StateCreating\n100|\t}\n101|\treturn source\n102|}\n103|\n104|// kindFor maps an engine operation to its AXAuthorization kind through the\n105|// landed transition-table authorization column: the table names the kind\n106|// and this function honors only the two the engine executes (create,\n107|// control). The force_stale and restore kinds parse but no engine\n108|// operation requests them — terminate-stale and restore recovery belongs\n109|// to the story's final leaf — and attach and none are never\n110|// AXAuthorization kinds. A drift between the table and this mapping fails\n111|// TestKindForAgreesWithLandedTable; no second table is restated here.\n112|func kindFor(operation terminalbackend.Operation) (AuthorizationKind, bool) {\n113|\tlanded, err := terminalbackend.TransitionAuthorization(string(operation))\n114|\tif err != nil {\n115|\t\treturn \"\", false\n116|\t}\n117|\tswitch AuthorizationKind(landed) {\n118|\tcase AuthorizationCreate:\n119|\t\treturn AuthorizationCreate, true\n120|\tcase AuthorizationControl:\n121|\t\treturn AuthorizationControl, true\n122|\tdefault:\n123|\t\treturn \"\", false\n124|\t}\n125|}\n126|\n127|// rowTimeoutCode is the §4.C timeout vocabulary per engine row: the wait\n128|// row times out quiesce_timeout and the stop row stop_timeout, while\n129|// create and quiesce-input time out terminal_backend_timeout.\n130|//\n131|// An engine deadline cancel before any attempt reports replay_same on\n132|// every row, including stop: nothing was attempted, so the identical\n133|// retry is safe. That differs deliberately from a backend-REPORTED\n134|// stop_timeout, which maps through DispositionFor (status_first even\n135|// uncommitted): a graceful wait that ran and timed out may have left\n136|// the provider mid-shutdown, while a cancel before the first attempt\n137|// proves nothing happened. The two directions are pinned together by\n138|// TestExecuteEntryDeadlineCodes and the stop rows of\n139|// TestExecuteBackendRowErrorSets.\n140|func rowTimeoutCode(operation terminalbackend.Operation) string {\n141|\tswitch operation {\n142|\tcase terminalbackend.OperationWaitSafeBoundary:\n143|\t\treturn CodeQuiesceTimeout\n144|\tcase terminalbackend.OperationRequestStop:\n145|\t\treturn CodeStopTimeout\n146|\tdefault:\n147|\t\treturn CodeTimeout\n148|\t}\n149|}\n150|\n151|// engineScope admits exactly the operations this engine executes: the\n152|// status, quiesce-input, wait-safe-boundary and request-stop rows plus\n153|// the create receipt rule. Status has its own entry; attach, restore,\n154|// terminate-stale, manifest and probe are refused here.\n155|func engineScope(operation terminalbackend.Operation) error {\n156|\tswitch operation {\n157|\tcase terminalbackend.OperationCreate, terminalbackend.OperationQuiesceInput,\n158|\t\tterminalbackend.OperationWaitSafeBoundary, terminalbackend.OperationRequestStop:\n159|\t\treturn nil\n160|\tdefault:\n161|\t\treturn refuse(CodeProtocolError, \"operation lifecycle scope\")\n162|\t}\n163|}\n164|\n165|// checkCapabilityConditional evaluates the §4.C conditional capability\n166|// dependencies at the operation call site, the half the landed\n167|// CheckOperation explicitly leaves to the lifecycle owner: headless\n168|// creation for non-interactive create, and safe-boundary observation\n169|// (plus provider-process observation for provider proof kinds) for\n170|// wait-safe-boundary. Quiesce-input and request-stop carry no conditional\n171|// beyond conferral — input_quiescence and graceful_stop are their sole\n172|// conferring capabilities, so the landed CheckOperation decides those\n173|// rows alone and no second arm restates it. The credential-realm\n174|// conditional is a stated bound: credential need is not modeled on this\n175|// path.\n176|func checkCapabilityConditional(operation terminalbackend.Operation, params Params, admitted terminalbackend.Admitted) error {\n177|\tswitch operation {\n178|\tcase terminalbackend.OperationCreate:\n179|\t\tif !params.Interactive && !admitted.Has(\"headless_creation\") {\n180|\t\t\treturn refuse(CodeCapabilityUnproven, \"operation capability conditional\")\n181|\t\t}\n182|\t\treturn nil\n183|\tcase terminalbackend.OperationQuiesceInput, terminalbackend.OperationRequestStop:\n184|\t\treturn nil\n185|\tcase terminalbackend.OperationWaitSafeBoundary:\n186|\t\tif !admitted.Has(\"safe_boundary_observation\") {\n187|\t\t\treturn refuse(CodeCapabilityUnproven, \"operation capability conditional\")\n188|\t\t}\n189|\t\tif RequiresProviderObservation(params.ProviderProofKind) && !admitted.Has(\"provider_process_observation\") {\n190|\t\t\treturn refuse(CodeCapabilityUnproven, \"operation capability conditional\")\n191|\t\t}\n192|\t\treturn nil\n193|\tdefault:\n194|\t\treturn refuse(CodeProtocolError, \"operation lifecycle scope\")\n195|\t}\n196|}\n197|\n198|// ExecuteMutating executes one create, quiesce-input, wait-safe-boundary\n199|// or request-stop request from the source state. A nil error is success\n200|// (after is the transition target, disposition replay_same: re-sending\n201|// replays). A non-nil execution error carries the row code with after\n202|// and disposition per the §4.C error rules: an error before the first\n203|// side effect restores the source state, while an error after a\n204|// committed effect whose result cannot be proven moves the local\n205|// observation to unavailable with status_first (new_authorization when\n206|// the failure names auth drift) and never claims absent. Malformed\n207|// requests (unknown operation, unparseable source or context) return an\n208|// empty result with the error, because a result repeating unvalidated\n209|// identities would echo data the gates refused. Authorization and\n210|// generation are rechecked immediately before each side effect, not\n211|// once at entry; a deadline cancels waiting, never a committed effect.\n212|//\n213|// Emission bound: the §4.C row sets govern backend REPORTS, which the\n214|// engine routes through CheckErrorAllowed (an outside-set code is\n215|// refused as a protocol error). The engine's own AX-side seam verdicts\n216|// are outside that rule: an uncoded effect outcome classifies\n217|// terminal_backend_process_failed, and an uncertain retry (receipt\n218|// without completion) whose status reconciliation proves nothing refuses\n219|// terminal_backend_unavailable, both with after unavailable and\n220|// status_first per the row recovery columns (\"uncertainty requires\n221|// status\", \"an error after an effect whose result cannot be proven\").\n222|// Those codes are the leaf's contract for failures the backend never\n223|// coded, pinned literally below.\n224|//\n225|// Recovery: a bound key without its completion reconciles through the\n226|// production status entry before it refuses. When status proves the\n227|// presented source state — nothing happened — the same operation\n228|// continues under the same receipt and completes it, so the §4.C\n229|// recovery columns (\"then same-key retry only if not closed\", \"Create\n230|// is idempotent across controller crash and lost result\") execute\n231|// instead of refusing forever. When status proves anything else, or\n232|// fails, the retry refuses uncertain: the effects may have committed\n233|// and their evidence cannot be proven, so re-issuing them would risk a\n234|// second allocation. No path binds a second receipt for one key.\n235|func (engine *Engine) ExecuteMutating(ctx context.Context, operation terminalbackend.Operation, context MutationContext, params Params, source terminalbackend.InstanceState, admitted terminalbackend.Admitted) (Result, error) {\n236|\tempty := Result{}\n237|\tif engine == nil || engine.Store == nil || engine.Backend == nil ||\n238|\t\tengine.CurrentLease == nil || engine.CurrentGeneration == nil || engine.Now == nil {\n239|\t\treturn empty, refuse(CodeProtocolError, \"engine unavailable\")\n240|\t}\n241|\tif _, err := terminalbackend.ParseOperation(string(operation)); err != nil {\n242|\t\treturn empty, wrapLanded(err)\n243|\t}\n244|\tif err := engineScope(operation); err != nil {\n245|\t\treturn empty, err\n246|\t}\n247|\tif _, err := terminalbackend.ParseInstanceState(string(source)); err != nil {\n248|\t\treturn empty, wrapLanded(err)\n249|\t}\n250|\tif err := CheckMutationContext(operation, context, params); err != nil {\n251|\t\treturn empty, err\n252|\t}\n253|\tif err := terminalbackend.CheckOperation(string(operation), admitted); err != nil {\n254|\t\tfailure := wrapLanded(err)\n255|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n256|\t}\n257|\tif err := checkCapabilityConditional(operation, params, admitted); err != nil {\n258|\t\tfailure := err.(*Error)\n259|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n260|\t}\n261|\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), params.Interactive)\n262|\tif err != nil {\n263|\t\tfailure := wrapLanded(err)\n264|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n265|\t}\n266|\tkind, _ := kindFor(operation)\n267|\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil {\n268|\t\tfailure := err.(*Error)\n269|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n270|\t}\n271|\tif engine.CurrentGeneration() != context.BackendGeneration {\n272|\t\tfailure := refuse(CodeStaleGeneration, \"backend_generation stale\")\n273|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n274|\t}\n275|\tdeadline, err := context.Deadline.Time()\n276|\tif err != nil {\n277|\t\treturn empty, refuse(CodeProtocolError, \"mutation context deadline\")\n278|\t}\n279|\tif !engine.Now().Before(deadline) {\n280|\t\tfailure := refuse(rowTimeoutCode(operation), \"operation deadline\")\n281|\t\treturn buildResult(context, source, source, nil, nil, DispositionReplaySame), failure\n282|\t}\n283|\tkey := context.IdempotencyKey\n284|\t_, replayed, err := engine.Store.Bind(key, operation, context.OperationID)\n285|\tif err != nil {\n286|\t\tfailure, ok := err.(*Error)\n287|\t\tif !ok {\n288|\t\t\t// Uncoded store failure: the Lookup below decides what is\n289|\t\t\t// durable. Nothing linked (a pre-link stage, write, sync or\n290|\t\t\t// link failure — no side effect ran and no receipt stands)\n291|\t\t\t// restores the source state, so the identical retry is\n292|\t\t\t// safe. A standing receipt (a post-link hook or\n293|\t\t\t// directory-sync failure) or an unreadable store is\n294|\t\t\t// genuinely uncertain.\n295|\t\t\tif _, found, lookupErr := engine.Store.Lookup(key); lookupErr == nil && !found {\n296|\t\t\t\tprelink := refuse(CodeProcessFailed, \"idempotency store failure\")\n297|\t\t\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(prelink.Code, false)), prelink\n298|\t\t\t}\n299|\t\t\tuncoded := refuse(CodeProcessFailed, \"idempotency store failure\")\n300|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), uncoded\n301|\t\t}\n302|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n303|\t}\n304|\tif replayed {\n305|\t\tstored, found, err := engine.Store.Completed(key)\n306|\t\tif err != nil {\n307|\t\t\tuncoded := refuse(CodeProcessFailed, \"idempotency store failure\")\n308|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), uncoded\n309|\t\t}\n310|\t\tif !found {\n311|\t\t\treturn engine.resumeUncertain(ctx, operation, context, source, admitted, target, effects, deadline, kind)\n312|\t\t}\n313|\t\tvar result Result\n314|\t\tif err := json.Unmarshal(stored, &result); err != nil {\n315|\t\t\tfailure := refuse(CodeIntegrityFailure, \"idempotency result image\")\n316|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), failure\n317|\t\t}\n318|\t\tif err := CheckResult(context, source, result); err != nil {\n319|\t\t\tfailure, ok := err.(*Error)\n320|\t\t\tif !ok {\n321|\t\t\t\tuncoded := refuse(CodeIntegrityFailure, \"idempotency result image\")\n322|\t\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), uncoded\n323|\t\t\t}\n324|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionFor(failure.Code, true)), failure\n325|\t\t}\n326|\t\treturn result, nil\n327|\t}\n328|\tif engine.Hooks != nil && engine.Hooks.AfterReceipt != nil {\n329|\t\tengine.Hooks.AfterReceipt(operation, key, InterimState(operation, source))\n330|\t}\n331|\treturn engine.runEffects(ctx, operation, context, source, target, effects, deadline, kind)\n332|}\n333|\n334|// resumeUncertain reconciles a bound key without its completion through\n335|// the production status entry, executing the §4.C recovery columns\n336|// (\"uncertainty requires status\" on create and quiesce-input,\n337|// \"uncertainty uses status\" on restore, \"lost result requires status,\n338|// then same-key retry only if not closed\" on request-stop, \"Create is\n339|// idempotent on (session_id, bootstrap_operation_id) across controller\n340|// crash and lost result\"). The reconciliation query is the exact\n341|// instance the request names — Session, instance, backend,\n342|// implementation, protocol and generation — validated by the same\n343|// ExecuteStatus arms every caller-driven status passes, so a lying or\n344|// drifting backend cannot authorize a resumption.\n345|//\n346|// When status proves the presented source state, nothing happened and\n347|// the same operation continues under the same receipt: the receipt is\n348|// already bound, so no second receipt is created, and the resumed run\n349|// completes it exactly once. For wait-safe-boundary the source is the\n350|// target, so a proven quiescing resumes and the resumed observation\n351|// supersedes any lost one; at most one completion exists per key either\n352|// way. Re-issue under the same key relies on the backend's own\n353|// key binding (§4.C: \"AX and backend durably bind the pair before the\n354|// first child side effect\"; §13.13 safe_retry): the engine never issues\n355|// the same logical operation under a second key, so no second process\n356|// is allocated.\n357|//\n358|// When status proves anything else — the target (the effects may have\n359|// committed but their evidence cannot be proven), a contradictory state,\n360|// or nothing at all (the read fails) — the retry refuses uncertain\n361|// with status_first. Re-issuing from a non-source observation would\n362|// violate the transition matrix, and inventing evidence would fabricate\n363|// a result; the caller reconciles through its own status read instead.\n364|func (engine *Engine) resumeUncertain(ctx context.Context, operation terminalbackend.Operation, context MutationContext, source terminalbackend.InstanceState, admitted terminalbackend.Admitted, target terminalbackend.InstanceState, effects []terminalbackend.SideEffect, deadline time.Time, kind AuthorizationKind) (Result, error) {\n365|\tbody := StatusBody{\n366|\t\tSessionID:                  context.SessionID,\n367|\t\tTerminalInstanceID:         context.TerminalInstanceID,\n368|\t\tHasTerminalInstanceID:      true,\n369|\t\tTerminalBackendID:          context.TerminalBackendID,\n370|\t\tImplementationVersion:      context.ImplementationVersion,\n371|\t\tProtocolVersion:            context.ProtocolVersion,\n372|\t\tBackendGeneration:          context.BackendGeneration,\n373|\t\tHasBackendGeneration:       true,\n374|\t\tIncludeProviderObservation: false,\n375|\t\tDeadline:                   context.Deadline,\n376|\t}\n377|\treport, err := engine.ExecuteStatus(ctx, body, source, admitted)\n378|\tif err != nil {\n379|\t\tfailure := refuse(CodeUnavailable, \"idempotency result uncertain\")\n380|\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), failure\n381|\t}\n382|\tif report.State != source {\n383|\t\tfailure := refuse(CodeUnavailable, \"idempotency result uncertain\")\n384|\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), failure\n385|\t}\n386|\tif engine.Hooks != nil && engine.Hooks.AfterReceipt != nil {\n387|\t\tengine.Hooks.AfterReceipt(operation, context.IdempotencyKey, InterimState(operation, source))\n388|\t}\n389|\treturn engine.runEffects(ctx, operation, context, source, target, effects, deadline, kind)\n390|}\n391|\n392|// runEffects performs the transition's side effects under an already\n393|// bound receipt — freshly bound by ExecuteMutating or resumed by\n394|// resumeUncertain after status proved the source — with the per-effect\n395|// deadline, authorization and generation gates, then completes the key\n396|// exactly once. Fresh and resumed runs share this loop, so the recheck\n397|// and error rules exist once, never as a resumed twin.\n398|func (engine *Engine) runEffects(ctx context.Context, operation terminalbackend.Operation, context MutationContext, source, target terminalbackend.InstanceState, effects []terminalbackend.SideEffect, deadline time.Time, kind AuthorizationKind) (Result, error) {\n399|\tkey := context.IdempotencyKey\n400|\tcommitted := false\n401|\tevidence := []string(nil)\n402|\tperformed := []terminalbackend.SideEffect(nil)\n403|\tfor _, effect := range effects {\n404|\t\tif !engine.Now().Before(deadline) {\n405|\t\t\tfailure := refuse(rowTimeoutCode(operation), \"operation deadline\")\n406|\t\t\tif committed {\n407|\t\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, performed, evidence, DispositionStatusFirst), failure\n408|\t\t\t}\n409|\t\t\treturn buildResult(context, source, source, performed, evidence, DispositionReplaySame), failure\n410|\t\t}\n411|\t\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil {\n412|\t\t\tfailure := err.(*Error)\n413|\t\t\tafter := source\n414|\t\t\tif committed {\n415|\t\t\t\tafter = terminalbackend.StateUnavailable\n416|\t\t\t}\n417|\t\t\treturn buildResult(context, source, after, performed, evidence, DispositionFor(failure.Code, committed)), failure\n418|\t\t}\n419|\t\tif engine.CurrentGeneration() != context.BackendGeneration {\n420|\t\t\tfailure := refuse(CodeStaleGeneration, \"backend_generation stale\")\n421|\t\t\tafter := source\n422|\t\t\tif committed {\n423|\t\t\t\tafter = terminalbackend.StateUnavailable\n424|\t\t\t}\n425|\t\t\treturn buildResult(context, source, after, performed, evidence, DispositionFor(failure.Code, committed)), failure\n426|\t\t}\n427|\t\tif engine.Hooks != nil && engine.Hooks.BeforeEffect != nil {\n428|\t\t\tengine.Hooks.BeforeEffect(effect)\n429|\t\t}\n430|\t\tevidenceID, err := engine.Backend.PerformEffect(ctx, effect)\n431|\t\tif engine.Hooks != nil && engine.Hooks.AfterEffect != nil {\n432|\t\t\tengine.Hooks.AfterEffect(effect)\n433|\t\t}\n434|\t\tif err != nil {\n435|\t\t\tcode := ErrorCode(err)\n436|\t\t\tif code == \"\" {\n437|\t\t\t\tfailure := refuse(CodeProcessFailed, \"backend effect uncertain\")\n438|\t\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, performed, evidence, DispositionStatusFirst), failure\n439|\t\t\t}\n440|\t\t\tif err := terminalbackend.CheckErrorAllowed(string(operation), code); err != nil {\n441|\t\t\t\tfailure := refuse(CodeProtocolError, \"operation error vocabulary\")\n442|\t\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, performed, evidence, DispositionStatusFirst), failure\n443|\t\t\t}\n444|\t\t\tafter := source\n445|\t\t\tif committed {\n446|\t\t\t\tafter = terminalbackend.StateUnavailable\n447|\t\t\t}\n448|\t\t\tfailure := refuse(code, \"backend effect refused\")\n449|\t\t\treturn buildResult(context, source, after, performed, evidence, DispositionFor(code, committed)), failure\n450|\t\t}\n451|\t\tif _, err := scalar.ParseDigest(evidenceID); err != nil {\n452|\t\t\tfailure := refuse(CodeIntegrityFailure, \"backend effect evidence\")\n453|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, performed, evidence, DispositionStatusFirst), failure\n454|\t\t}\n455|\t\tcommitted = true\n456|\t\tperformed = append(performed, effect)\n457|\t\tevidence = append(evidence, evidenceID)\n458|\t}\n459|\tresult := buildResult(context, source, target, performed, evidence, DispositionReplaySame)\n460|\tencoded, err := json.Marshal(result)\n461|\tif err != nil {\n462|\t\tfailure := refuse(CodeIntegrityFailure, \"idempotency result image\")\n463|\t\tresult.Disposition = DispositionStatusFirst\n464|\t\treturn result, failure\n465|\t}\n466|\tif err := engine.Store.Complete(key, encoded); err != nil {\n467|\t\tfailure, ok := err.(*Error)\n468|\t\tif !ok {\n469|\t\t\tuncoded := refuse(CodeProcessFailed, \"idempotency store failure\")\n470|\t\t\tresult.Disposition = DispositionStatusFirst\n471|\t\t\treturn result, uncoded\n472|\t\t}\n473|\t\tresult.Disposition = DispositionStatusFirst\n474|\t\treturn result, failure\n475|\t}\n476|\treturn result, nil\n477|}\n478|\n479|// ExecuteStatus executes one status query: no receipt, no side effects,\n480|// no authorization and no transition bookkeeping of its own. The\n481|// reported state is adopted verbatim; the engine validates the report\n482|// (the reported match must equal the compared tuple, the landed\n483|// CheckStatusResult must admit it, evidence must be sorted-unique\n484|// digests) and enforces the provider-observation capability conditional.\n485|// A timeout or read failure is unknown, never absent: it returns an\n486|// error with no report.\n487|func (engine *Engine) ExecuteStatus(ctx context.Context, body StatusBody, source terminalbackend.InstanceState, admitted terminalbackend.Admitted) (StatusReport, error) {\n488|\tempty := StatusReport{}\n489|\tif engine == nil || engine.Backend == nil || engine.Now == nil {\n490|\t\treturn empty, refuse(CodeProtocolError, \"engine unavailable\")\n491|\t}\n492|\tif source != \"\" {\n493|\t\tif _, _, err := terminalbackend.CheckTransition(string(terminalbackend.OperationStatus), string(source), false); err != nil {\n494|\t\t\treturn empty, wrapLanded(err)\n495|\t\t}\n496|\t}\n497|\tdeadline, err := body.Deadline.Time()\n498|\tif err != nil {\n499|\t\treturn empty, refuse(CodeProtocolError, \"status body deadline\")\n500|\t}\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6c5","stream":{"kind":"session","id":"01a0b2ff-60d1-7b92-bcfc-8a4c766633f3"},"sequence":445,"recorded_at":1780531400000885,"record_type":"event","durability":"durable","causation_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","run_stream":{"kind":"run","id":"b5be48e9-caa3-42a3-a29a-786d769c2b71"},"task_stream":{"kind":"task","id":"01a0b300-ade0-74a1-ad95-cb71dca068da"},"task_id":"01a0b300-ade0-74a1-ad95-cb71dca068da","event":{"kind":"completed","task_id":"01a0b300-ade0-74a1-ad95-cb71dca068da"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6c7","stream":{"kind":"session","id":"01a0b2ff-60d1-7b92-bcfc-8a4c766633f3"},"sequence":446,"recorded_at":1780531400000887,"record_type":"event","durability":"durable","causation_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","run_stream":{"kind":"run","id":"b5be48e9-caa3-42a3-a29a-786d769c2b71"},"call_id":"call_01a0b300a97975da9e73d5d4f0f39443","text":"Read text file `internal/terminstance/execute.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"time\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n10|)\n11|\n12|// Backend is the modeled terminal backend caller: side-effect execution\n13|// and status observation. No tmux/ConPTY process control and no provider\n14|// process exist behind it; tests model success, coded row refusals,\n15|// uncoded failures and crashes through this interface.\n16|type Backend interface {\n17|\t// PerformEffect executes one side effect and reports its evidence\n18|\t// ID. A nil error proves the commit; a *Error with a row code\n19|\t// proves the backend refused before committing; any other error\n20|\t// proves nothing, not even non-commit.\n21|\tPerformEffect(ctx context.Context, effect terminalbackend.SideEffect) (string, error)\n22|\t// ObserveStatus reports the backend's current observation for one\n23|\t// status body. An error is unknown, never absent.\n24|\tObserveStatus(ctx context.Context, body StatusBody) (StatusObservation, error)\n25|}\n26|\n27|// StatusObservation is the backend-reported status observation: the\n28|// reported state and match verdict, the reported identity tuple the\n29|// engine compares against the query, and the reported capability and\n30|// last-operation facts the landed CheckStatusResult validates.\n31|type StatusObservation struct {\n32|\tState             terminalbackend.InstanceState\n33|\tIdentityMatch     bool\n34|\tWrapperPresent    bool\n35|\tProviderPresent   *bool\n36|\tAttachable        bool\n37|\tLastOperationID   *string\n38|\tLastEffect        *terminalbackend.SideEffect\n39|\tEvidenceIDs       []string\n40|\tProviderRequested bool\n41|\tProviderEvidenced bool\n42|\tAttachEvidenced   bool\n43|\tSessionID         string\n44|\tInstanceID        string\n45|\tBackendID         string\n46|\tImplVersion       string\n47|\tProtoVersion      string\n48|\tGeneration        string\n49|}\n50|\n51|// StatusReport is the validated status outcome: the adopted observation.\n52|// Status performs no transition bookkeeping of its own — no receipt, no\n53|// effects, no before/after — so the report carries the single adopted\n54|// state verbatim.\n55|type StatusReport struct {\n56|\tState           terminalbackend.InstanceState\n57|\tIdentityMatch   bool\n58|\tWrapperPresent  bool\n59|\tProviderPresent *bool\n60|\tAttachable      bool\n61|\tLastOperationID *string\n62|\tLastEffect      *terminalbackend.SideEffect\n63|\tEvidenceIDs     []string\n64|}\n65|\n66|// EngineHooks arms the engine seams tests observe: AfterReceipt fires\n67|// after the durable receipt commits and before the first side effect,\n68|// carrying the interim state (creating for create, the source\n69|// otherwise); BeforeEffect and AfterEffect bracket each committed\n70|// attempt. Hooks observe only: they return nothing and cannot alter\n71|// the outcome.\n72|type EngineHooks struct {\n73|\tAfterReceipt func(operation terminalbackend.Operation, key string, interim terminalbackend.InstanceState)\n74|\tBeforeEffect func(effect terminalbackend.SideEffect)\n75|\tAfterEffect  func(effect terminalbackend.SideEffect)\n76|}\n77|\n78|// Engine executes the §4.C operation rows. Store is the durable receipt\n79|// table; Backend the modeled backend; CurrentLease and CurrentGeneration\n80|// re-read the winning lease and the validated binding generation at\n81|// every check point (function values, never snapshots, so a rotation\n82|// between entry and any effect is caught); Now is the clock. Hooks may\n83|// be nil.\n84|type Engine struct {\n85|\tStore             *ReceiptStore\n86|\tBackend           Backend\n87|\tCurrentLease      func() LeaseView\n88|\tCurrentGeneration func() string\n89|\tNow               func() time.Time\n90|\tHooks             *EngineHooks\n91|}\n92|\n93|// InterimState is the observable state between the durable idempotency\n94|// receipt and the first side effect: creating for create, the source\n95|// state for every other engine operation. creating is entered only by\n96|// create, only after its receipt and before its first listed effect.\n97|func InterimState(operation terminalbackend.Operation, source terminalbackend.InstanceState) terminalbackend.InstanceState {\n98|\tif operation == terminalbackend.OperationCreate {\n99|\t\treturn terminalbackend.StateCreating\n100|\t}\n101|\treturn source\n102|}\n103|\n104|// kindFor maps an engine operation to its AXAuthorization kind through the\n105|// landed transition-table authorization column: the table names the kind\n106|// and this function honors only the two the engine executes (create,\n107|// control). The force_stale and restore kinds parse but no engine\n108|// operation requests them — terminate-stale and restore recovery belongs\n109|// to the story's final leaf — and attach and none are never\n110|// AXAuthorization kinds. A drift between the table and this mapping fails\n111|// TestKindForAgreesWithLandedTable; no second table is restated here.\n112|func kindFor(operation terminalbackend.Operation) (AuthorizationKind, bool) {\n113|\tlanded, err := terminalbackend.TransitionAuthorization(string(operation))\n114|\tif err != nil {\n115|\t\treturn \"\", false\n116|\t}\n117|\tswitch AuthorizationKind(landed) {\n118|\tcase AuthorizationCreate:\n119|\t\treturn AuthorizationCreate, true\n120|\tcase AuthorizationControl:\n121|\t\treturn AuthorizationControl, true\n122|\tdefault:\n123|\t\treturn \"\", false\n124|\t}\n125|}\n126|\n127|// rowTimeoutCode is the §4.C timeout vocabulary per engine row: the wait\n128|// row times out quiesce_timeout and the stop row stop_timeout, while\n129|// create and quiesce-input time out terminal_backend_timeout.\n130|//\n131|// An engine deadline cancel before any attempt reports replay_same on\n132|// every row, including stop: nothing was attempted, so the identical\n133|// retry is safe. That differs deliberately from a backend-REPORTED\n134|// stop_timeout, which maps through DispositionFor (status_first even\n135|// uncommitted): a graceful wait that ran and timed out may have left\n136|// the provider mid-shutdown, while a cancel before the first attempt\n137|// proves nothing happened. The two directions are pinned together by\n138|// TestExecuteEntryDeadlineCodes and the stop rows of\n139|// TestExecuteBackendRowErrorSets.\n140|func rowTimeoutCode(operation terminalbackend.Operation) string {\n141|\tswitch operation {\n142|\tcase terminalbackend.OperationWaitSafeBoundary:\n143|\t\treturn CodeQuiesceTimeout\n144|\tcase terminalbackend.OperationRequestStop:\n145|\t\treturn CodeStopTimeout\n146|\tdefault:\n147|\t\treturn CodeTimeout\n148|\t}\n149|}\n150|\n151|// engineScope admits exactly the operations this engine executes: the\n152|// status, quiesce-input, wait-safe-boundary and request-stop rows plus\n153|// the create receipt rule. Status has its own entry; attach, restore,\n154|// terminate-stale, manifest and probe are refused here.\n155|func engineScope(operation terminalbackend.Operation) error {\n156|\tswitch operation {\n157|\tcase terminalbackend.OperationCreate, terminalbackend.OperationQuiesceInput,\n158|\t\tterminalbackend.OperationWaitSafeBoundary, terminalbackend.OperationRequestStop:\n159|\t\treturn nil\n160|\tdefault:\n161|\t\treturn refuse(CodeProtocolError, \"operation lifecycle scope\")\n162|\t}\n163|}\n164|\n165|// checkCapabilityConditional evaluates the §4.C conditional capability\n166|// dependencies at the operation call site, the half the landed\n167|// CheckOperation explicitly leaves to the lifecycle owner: headless\n168|// creation for non-interactive create, and safe-boundary observation\n169|// (plus provider-process observation for provider proof kinds) for\n170|// wait-safe-boundary. Quiesce-input and request-stop carry no conditional\n171|// beyond conferral — input_quiescence and graceful_stop are their sole\n172|// conferring capabilities, so the landed CheckOperation decides those\n173|// rows alone and no second arm restates it. The credential-realm\n174|// conditional is a stated bound: credential need is not modeled on this\n175|// path.\n176|func checkCapabilityConditional(operation terminalbackend.Operation, params Params, admitted terminalbackend.Admitted) error {\n177|\tswitch operation {\n178|\tcase terminalbackend.OperationCreate:\n179|\t\tif !params.Interactive && !admitted.Has(\"headless_creation\") {\n180|\t\t\treturn refuse(CodeCapabilityUnproven, \"operation capability conditional\")\n181|\t\t}\n182|\t\treturn nil\n183|\tcase terminalbackend.OperationQuiesceInput, terminalbackend.OperationRequestStop:\n184|\t\treturn nil\n185|\tcase terminalbackend.OperationWaitSafeBoundary:\n186|\t\tif !admitted.Has(\"safe_boundary_observation\") {\n187|\t\t\treturn refuse(CodeCapabilityUnproven, \"operation capability conditional\")\n188|\t\t}\n189|\t\tif RequiresProviderObservation(params.ProviderProofKind) && !admitted.Has(\"provider_process_observation\") {\n190|\t\t\treturn refuse(CodeCapabilityUnproven, \"operation capability conditional\")\n191|\t\t}\n192|\t\treturn nil\n193|\tdefault:\n194|\t\treturn refuse(CodeProtocolError, \"operation lifecycle scope\")\n195|\t}\n196|}\n197|\n198|// ExecuteMutating executes one create, quiesce-input, wait-safe-boundary\n199|// or request-stop request from the source state. A nil error is success\n200|// (after is the transition target, disposition replay_same: re-sending\n201|// replays). A non-nil execution error carries the row code with after\n202|// and disposition per the §4.C error rules: an error before the first\n203|// side effect restores the source state, while an error after a\n204|// committed effect whose result cannot be proven moves the local\n205|// observation to unavailable with status_first (new_authorization when\n206|// the failure names auth drift) and never claims absent. Malformed\n207|// requests (unknown operation, unparseable source or context) return an\n208|// empty result with the error, because a result repeating unvalidated\n209|// identities would echo data the gates refused. Authorization and\n210|// generation are rechecked immediately before each side effect, not\n211|// once at entry; a deadline cancels waiting, never a committed effect.\n212|//\n213|// Emission bound: the §4.C row sets govern backend REPORTS, which the\n214|// engine routes through CheckErrorAllowed (an outside-set code is\n215|// refused as a protocol error). The engine's own AX-side seam verdicts\n216|// are outside that rule: an uncoded effect outcome classifies\n217|// terminal_backend_process_failed, and an uncertain retry (receipt\n218|// without completion) whose status reconciliation proves nothing refuses\n219|// terminal_backend_unavailable, both with after unavailable and\n220|// status_first per the row recovery columns (\"uncertainty requires\n221|// status\", \"an error after an effect whose result cannot be proven\").\n222|// Those codes are the leaf's contract for failures the backend never\n223|// coded, pinned literally below.\n224|//\n225|// Recovery: a bound key without its completion reconciles through the\n226|// production status entry before it refuses. When status proves the\n227|// presented source state — nothing happened — the same operation\n228|// continues under the same receipt and completes it, so the §4.C\n229|// recovery columns (\"then same-key retry only if not closed\", \"Create\n230|// is idempotent across controller crash and lost result\") execute\n231|// instead of refusing forever. When status proves anything else, or\n232|// fails, the retry refuses uncertain: the effects may have committed\n233|// and their evidence cannot be proven, so re-issuing them would risk a\n234|// second allocation. No path binds a second receipt for one key.\n235|func (engine *Engine) ExecuteMutating(ctx context.Context, operation terminalbackend.Operation, context MutationContext, params Params, source terminalbackend.InstanceState, admitted terminalbackend.Admitted) (Result, error) {\n236|\tempty := Result{}\n237|\tif engine == nil || engine.Store == nil || engine.Backend == nil ||\n238|\t\tengine.CurrentLease == nil || engine.CurrentGeneration == nil || engine.Now == nil {\n239|\t\treturn empty, refuse(CodeProtocolError, \"engine unavailable\")\n240|\t}\n241|\tif _, err := terminalbackend.ParseOperation(string(operation)); err != nil {\n242|\t\treturn empty, wrapLanded(err)\n243|\t}\n244|\tif err := engineScope(operation); err != nil {\n245|\t\treturn empty, err\n246|\t}\n247|\tif _, err := terminalbackend.ParseInstanceState(string(source)); err != nil {\n248|\t\treturn empty, wrapLanded(err)\n249|\t}\n250|\tif err := CheckMutationContext(operation, context, params); err != nil {\n251|\t\treturn empty, err\n252|\t}\n253|\tif err := terminalbackend.CheckOperation(string(operation), admitted); err != nil {\n254|\t\tfailure := wrapLanded(err)\n255|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n256|\t}\n257|\tif err := checkCapabilityConditional(operation, params, admitted); err != nil {\n258|\t\tfailure := err.(*Error)\n259|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n260|\t}\n261|\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), params.Interactive)\n262|\tif err != nil {\n263|\t\tfailure := wrapLanded(err)\n264|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n265|\t}\n266|\tkind, _ := kindFor(operation)\n267|\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil {\n268|\t\tfailure := err.(*Error)\n269|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n270|\t}\n271|\tif engine.CurrentGeneration() != context.BackendGeneration {\n272|\t\tfailure := refuse(CodeStaleGeneration, \"backend_generation stale\")\n273|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n274|\t}\n275|\tdeadline, err := context.Deadline.Time()\n276|\tif err != nil {\n277|\t\treturn empty, refuse(CodeProtocolError, \"mutation context deadline\")\n278|\t}\n279|\tif !engine.Now().Before(deadline) {\n280|\t\tfailure := refuse(rowTimeoutCode(operation), \"operation deadline\")\n281|\t\treturn buildResult(context, source, source, nil, nil, DispositionReplaySame), failure\n282|\t}\n283|\tkey := context.IdempotencyKey\n284|\t_, replayed, err := engine.Store.Bind(key, operation, context.OperationID)\n285|\tif err != nil {\n286|\t\tfailure, ok := err.(*Error)\n287|\t\tif !ok {\n288|\t\t\t// Uncoded store failure: the Lookup below decides what is\n289|\t\t\t// durable. Nothing linked (a pre-link stage, write, sync or\n290|\t\t\t// link failure — no side effect ran and no receipt stands)\n291|\t\t\t// restores the source state, so the identical retry is\n292|\t\t\t// safe. A standing receipt (a post-link hook or\n293|\t\t\t// directory-sync failure) or an unreadable store is\n294|\t\t\t// genuinely uncertain.\n295|\t\t\tif _, found, lookupErr := engine.Store.Lookup(key); lookupErr == nil && !found {\n296|\t\t\t\tprelink := refuse(CodeProcessFailed, \"idempotency store failure\")\n297|\t\t\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(prelink.Code, false)), prelink\n298|\t\t\t}\n299|\t\t\tuncoded := refuse(CodeProcessFailed, \"idempotency store failure\")\n300|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), uncoded\n301|\t\t}\n302|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n303|\t}\n304|\tif replayed {\n305|\t\tstored, found, err := engine.Store.Completed(key)\n306|\t\tif err != nil {\n307|\t\t\tuncoded := refuse(CodeProcessFailed, \"idempotency store failure\")\n308|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), uncoded\n309|\t\t}\n310|\t\tif !found {\n311|\t\t\treturn engine.resumeUncertain(ctx, operation, context, source, admitted, target, effects, deadline, kind)\n312|\t\t}\n313|\t\tvar result Result\n314|\t\tif err := json.Unmarshal(stored, &result); err != nil {\n315|\t\t\tfailure := refuse(CodeIntegrityFailure, \"idempotency result image\")\n316|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), failure\n317|\t\t}\n318|\t\tif err := CheckResult(context, source, result); err != nil {\n319|\t\t\tfailure, ok := err.(*Error)\n320|\t\t\tif !ok {\n321|\t\t\t\tuncoded := refuse(CodeIntegrityFailure, \"idempotency result image\")\n322|\t\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), uncoded\n323|\t\t\t}\n324|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionFor(failure.Code, true)), failure\n325|\t\t}\n326|\t\treturn result, nil\n327|\t}\n328|\tif engine.Hooks != nil && engine.Hooks.AfterReceipt != nil {\n329|\t\tengine.Hooks.AfterReceipt(operation, key, InterimState(operation, source))\n330|\t}\n331|\treturn engine.runEffects(ctx, operation, context, source, target, effects, deadline, kind)\n332|}\n333|\n334|// resumeUncertain reconciles a bound key without its completion through\n335|// the production status entry, executing the §4.C recovery columns\n336|// (\"uncertainty requires status\" on create and quiesce-input,\n337|// \"uncertainty uses status\" on restore, \"lost result requires status,\n338|// then same-key retry only if not closed\" on request-stop, \"Create is\n339|// idempotent on (session_id, bootstrap_operation_id) across controller\n340|// crash and lost result\"). The reconciliation query is the exact\n341|// instance the request names — Session, instance, backend,\n342|// implementation, protocol and generation — validated by the same\n343|// ExecuteStatus arms every caller-driven status passes, so a lying or\n344|// drifting backend cannot authorize a resumption.\n345|//\n346|// When status proves the presented source state, nothing happened and\n347|// the same operation continues under the same receipt: the receipt is\n348|// already bound, so no second receipt is created, and the resumed run\n349|// completes it exactly once. For wait-safe-boundary the source is the\n350|// target, so a proven quiescing resumes and the resumed observation\n351|// supersedes any lost one; at most one completion exists per key either\n352|// way. Re-issue under the same key relies on the backend's own\n353|// key binding (§4.C: \"AX and backend durably bind the pair before the\n354|// first child side effect\"; §13.13 safe_retry): the engine never issues\n355|// the same logical operation under a second key, so no second process\n356|// is allocated.\n357|//\n358|// When status proves anything else — the target (the effects may have\n359|// committed but their evidence cannot be proven), a contradictory state,\n360|// or nothing at all (the read fails) — the retry refuses uncertain\n361|// with status_first. Re-issuing from a non-source observation would\n362|// violate the transition matrix, and inventing evidence would fabricate\n363|// a result; the caller reconciles through its own status read instead.\n364|func (engine *Engine) resumeUncertain(ctx context.Context, operation terminalbackend.Operation, context MutationContext, source terminalbackend.InstanceState, admitted terminalbackend.Admitted, target terminalbackend.InstanceState, effects []terminalbackend.SideEffect, deadline time.Time, kind AuthorizationKind) (Result, error) {\n365|\tbody := StatusBody{\n366|\t\tSessionID:                  context.SessionID,\n367|\t\tTerminalInstanceID:         context.TerminalInstanceID,\n368|\t\tHasTerminalInstanceID:      true,\n369|\t\tTerminalBackendID:          context.TerminalBackendID,\n370|\t\tImplementationVersion:      context.ImplementationVersion,\n371|\t\tProtocolVersion:            context.ProtocolVersion,\n372|\t\tBackendGeneration:          context.BackendGeneration,\n373|\t\tHasBackendGeneration:       true,\n374|\t\tIncludeProviderObservation: false,\n375|\t\tDeadline:                   context.Deadline,\n376|\t}\n377|\treport, err := engine.ExecuteStatus(ctx, body, source, admitted)\n378|\tif err != nil {\n379|\t\tfailure := refuse(CodeUnavailable, \"idempotency result uncertain\")\n380|\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), failure\n381|\t}\n382|\tif report.State != source {\n383|\t\tfailure := refuse(CodeUnavailable, \"idempotency result uncertain\")\n384|\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), failure\n385|\t}\n386|\tif engine.Hooks != nil && engine.Hooks.AfterReceipt != nil {\n387|\t\tengine.Hooks.AfterReceipt(operation, context.IdempotencyKey, InterimState(operation, source))\n388|\t}\n389|\treturn engine.runEffects(ctx, operation, context, source, target, effects, deadline, kind)\n390|}\n391|\n392|// runEffects performs the transition's side effects under an already\n393|// bound receipt — freshly bound by ExecuteMutating or resumed by\n394|// resumeUncertain after status proved the source — with the per-effect\n395|// deadline, authorization and generation gates, then completes the key\n396|// exactly once. Fresh and resumed runs share this loop, so the recheck\n397|// and error rules exist once, never as a resumed twin.\n398|func (engine *Engine) runEffects(ctx context.Context, operation terminalbackend.Operation, context MutationContext, source, target terminalbackend.InstanceState, effects []terminalbackend.SideEffect, deadline time.Time, kind AuthorizationKind) (Result, error) {\n399|\tkey := context.IdempotencyKey\n400|\tcommitted := false\n401|\tevidence := []string(nil)\n402|\tperformed := []terminalbackend.SideEffect(nil)\n403|\tfor _, effect := range effects {\n404|\t\tif !engine.Now().Before(deadline) {\n405|\t\t\tfailure := refuse(rowTimeoutCode(operation), \"operation deadline\")\n406|\t\t\tif committed {\n407|\t\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, performed, evidence, DispositionStatusFirst), failure\n408|\t\t\t}\n409|\t\t\treturn buildResult(context, source, source, performed, evidence, DispositionReplaySame), failure\n410|\t\t}\n411|\t\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil {\n412|\t\t\tfailure := err.(*Error)\n413|\t\t\tafter := source\n414|\t\t\tif committed {\n415|\t\t\t\tafter = terminalbackend.StateUnavailable\n416|\t\t\t}\n417|\t\t\treturn buildResult(context, source, after, performed, evidence, DispositionFor(failure.Code, committed)), failure\n418|\t\t}\n419|\t\tif engine.CurrentGeneration() != context.BackendGeneration {\n420|\t\t\tfailure := refuse(CodeStaleGeneration, \"backend_generation stale\")\n421|\t\t\tafter := source\n422|\t\t\tif committed {\n423|\t\t\t\tafter = terminalbackend.StateUnavailable\n424|\t\t\t}\n425|\t\t\treturn buildResult(context, source, after, performed, evidence, DispositionFor(failure.Code, committed)), failure\n426|\t\t}\n427|\t\tif engine.Hooks != nil && engine.Hooks.BeforeEffect != nil {\n428|\t\t\tengine.Hooks.BeforeEffect(effect)\n429|\t\t}\n430|\t\tevidenceID, err := engine.Backend.PerformEffect(ctx, effect)\n431|\t\tif engine.Hooks != nil && engine.Hooks.AfterEffect != nil {\n432|\t\t\tengine.Hooks.AfterEffect(effect)\n433|\t\t}\n434|\t\tif err != nil {\n435|\t\t\tcode := ErrorCode(err)\n436|\t\t\tif code == \"\" {\n437|\t\t\t\tfailure := refuse(CodeProcessFailed, \"backend effect uncertain\")\n438|\t\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, performed, evidence, DispositionStatusFirst), failure\n439|\t\t\t}\n440|\t\t\tif err := terminalbackend.CheckErrorAllowed(string(operation), code); err != nil {\n441|\t\t\t\tfailure := refuse(CodeProtocolError, \"operation error vocabulary\")\n442|\t\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, performed, evidence, DispositionStatusFirst), failure\n443|\t\t\t}\n444|\t\t\tafter := source\n445|\t\t\tif committed {\n446|\t\t\t\tafter = terminalbackend.StateUnavailable\n447|\t\t\t}\n448|\t\t\tfailure := refuse(code, \"backend effect refused\")\n449|\t\t\treturn buildResult(context, source, after, performed, evidence, DispositionFor(code, committed)), failure\n450|\t\t}\n451|\t\tif _, err := scalar.ParseDigest(evidenceID); err != nil {\n452|\t\t\tfailure := refuse(CodeIntegrityFailure, \"backend effect evidence\")\n453|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, performed, evidence, DispositionStatusFirst), failure\n454|\t\t}\n455|\t\tcommitted = true\n456|\t\tperformed = append(performed, effect)\n457|\t\tevidence = append(evidence, evidenceID)\n458|\t}\n459|\tresult := buildResult(context, source, target, performed, evidence, DispositionReplaySame)\n460|\tencoded, err := json.Marshal(result)\n461|\tif err != nil {\n462|\t\tfailure := refuse(CodeIntegrityFailure, \"idempotency result image\")\n463|\t\tresult.Disposition = DispositionStatusFirst\n464|\t\treturn result, failure\n465|\t}\n466|\tif err := engine.Store.Complete(key, encoded); err != nil {\n467|\t\tfailure, ok := err.(*Error)\n468|\t\tif !ok {\n469|\t\t\tuncoded := refuse(CodeProcessFailed, \"idempotency store failure\")\n470|\t\t\tresult.Disposition = DispositionStatusFirst\n471|\t\t\treturn result, uncoded\n472|\t\t}\n473|\t\tresult.Disposition = DispositionStatusFirst\n474|\t\treturn result, failure\n475|\t}\n476|\treturn result, nil\n477|}\n478|\n479|// ExecuteStatus executes one status query: no receipt, no side effects,\n480|// no authorization and no transition bookkeeping of its own. The\n481|// reported state is adopted verbatim; the engine validates the report\n482|// (the reported match must equal the compared tuple, the landed\n483|// CheckStatusResult must admit it, evidence must be sorted-unique\n484|// digests) and enforces the provider-observation capability conditional.\n485|// A timeout or read failure is unknown, never absent: it returns an\n486|// error with no report.\n487|func (engine *Engine) ExecuteStatus(ctx context.Context, body StatusBody, source terminalbackend.InstanceState, admitted terminalbackend.Admitted) (StatusReport, error) {\n488|\tempty := StatusReport{}\n489|\tif engine == nil || engine.Backend == nil || engine.Now == nil {\n490|\t\treturn empty, refuse(CodeProtocolError, \"engine unavailable\")\n491|\t}\n492|\tif source != \"\" {\n493|\t\tif _, _, err := terminalbackend.CheckTransition(string(terminalbackend.OperationStatus), string(source), false); err != nil {\n494|\t\t\treturn empty, wrapLanded(err)\n495|\t\t}\n496|\t}\n497|\tdeadline, err := body.Deadline.Time()\n498|\tif err != nil {\n499|\t\treturn empty, refuse(CodeProtocolError, \"status body deadline\")\n500|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
