{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c61d","stream":{"kind":"session","id":"01a0b2ff-60d1-7b92-bcfc-8a4c766633f3"},"sequence":361,"recorded_at":1780531400000717,"record_type":"event","durability":"durable","causation_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","run_stream":{"kind":"run","id":"b5be48e9-caa3-42a3-a29a-786d769c2b71"},"task_stream":{"kind":"task","id":"01a0b300-84f2-7e72-9f62-5ec5a60f7c97"},"task_id":"01a0b300-84f2-7e72-9f62-5ec5a60f7c97","event":{"kind":"output","task_id":"01a0b300-84f2-7e72-9f62-5ec5a60f7c97","chunk":"Read text file `/tmp/kkh1an-rev3/TASK-260830-kkh1an_review-evidence-rev3/probes/review3_mutants.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Reviewer narrowing mutants for CR-TASK-260830-kkh1an-3 (RUN-260918-f6b44c).\n3|\n4|Each row: apply the edits to one production file in an isolated copy,\n5|run (a) the COMMITTED suite only (`go test -skip TestRV3`) and (b) the\n6|reviewer witness (`go test -run <witness>`), restore the file, verdict\n7|per run from the exit code plus a kill line. Raw per-plant logs with\n8|subprocess exits are written to the out directory.\n9|\"\"\"\n10|import os, subprocess, sys, shutil, pathlib, tempfile, hashlib\n11|\n12|REPO = pathlib.Path(sys.argv[1]).resolve()\n13|OUT = pathlib.Path(sys.argv[2]).resolve()\n14|OUT.mkdir(parents=True, exist_ok=True)\n15|PKG = \"internal/terminstance\"\n16|\n17|ROWS = [\n18|    dict(name=\"RV3-M1-auth-expiry-recheck-entry-instant\", path=\"execute.go\",\n19|         edits=[(\"\\tperformed := []terminalbackend.SideEffect(nil)\\n\\tfor _, effect := range effects {\\n\",\n20|                 \"\\tperformed := []terminalbackend.SideEffect(nil)\\n\\tentryNow := engine.Now()\\n\\tfor _, effect := range effects {\\n\"),\n21|                (\"\\t\\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil {\\n\\t\\t\\tfailure := err.(*Error)\\n\\t\\t\\tafter := source\\n\",\n22|                 \"\\t\\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), entryNow); err != nil {\\n\\t\\t\\tfailure := err.(*Error)\\n\\t\\t\\tafter := source\\n\")],\n23|         witness=\"TestRV3W_M1_AuthExpiryRecheckedBeforeEachEffect\",\n24|         kind=\"NARROWING (recheck dropped on one axis: per-effect authorization EXPIRY is evaluated at the entry instant; the lease tuple recheck stays)\"),\n25|    dict(name=\"RV3-M2-evidence-bound-257\", path=\"result.go\",\n26|         edits=[(\"\\tif len(evidence) > 256 {\\n\", \"\\tif len(evidence) > 257 {\\n\")],\n27|         witness=\"TestRV3W_M2_EvidenceBoundEdge\",\n28|         kind=\"NARROWING (bound widened by one: digest[0..256] admits exactly 257 on results and status reports)\"),\n29|    dict(name=\"RV3-M3-conditional-disposition-collapsed\", path=\"execute.go\",\n30|         edits=[(\"\\tif err := checkCapabilityConditional(operation, params, admitted); err != nil {\\n\\t\\tfailure := err.(*Error)\\n\\t\\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\\n\",\n31|                 \"\\tif err := checkCapabilityConditional(operation, params, admitted); err != nil {\\n\\t\\tfailure := err.(*Error)\\n\\t\\treturn buildResult(context, source, source, nil, nil, DispositionStatusFirst), failure\\n\")],\n32|         witness=\"TestRV3W_M3_ConditionalCapabilityDisposition\",\n33|         kind=\"NARROWING (disposition mapping collapsed at one engine arm: the capability-conditional refusal reports status_first instead of the class-mapped required_operator_action)\"),\n34|    dict(name=\"RV3-M4-proof-kind-sibling-admitted\", path=\"proof.go\",\n35|         edits=[(\"\\tdefault:\\n\\t\\treturn \\\"\\\", refuse(CodeProtocolError, \\\"provider proof vocabulary\\\")\\n\\t}\\n}\\n\\n// RequiresProviderObservation\",\n36|                 \"\\tdefault:\\n\\t\\tif value == \\\"provider_process_observation\\\" {\\n\\t\\t\\treturn ProofProviderQuiescence, nil\\n\\t\\t}\\n\\t\\treturn \\\"\\\", refuse(CodeProtocolError, \\\"provider proof vocabulary\\\")\\n\\t}\\n}\\n\\n// RequiresProviderObservation\")],\n37|         witness=\"TestRV3W_M4_ProofKindSiblingNamesRefused\",\n38|         kind=\"NARROWING (closed-enum member admitted: the landed capability name provider_process_observation parses as a proof kind)\"),\n39|    dict(name=\"RV3-M6-remote-fence-ignores-live-source\", path=\"fencing.go\",\n40|         edits=[(\"\\tif relativeReason, _, relativeParked := fencing.ParkDetails(relativeErr); relativeParked && relativeReason == fencing.ParkStaleOwner {\\n\\t\\treturn fenceLive(current, authErr)\\n\",\n41|                 \"\\tif relativeReason, _, relativeParked := fencing.ParkDetails(relativeErr); relativeParked && relativeReason == fencing.ParkStaleOwner {\\n\\t\\treturn terminalbackend.StateStaleFenced, true, nil\\n\")],\n42|         witness=\"TestObserveFencingNonLiveSourcesLeaveState\",\n43|         kind=\"NARROWING (remote-winner fencing skips the live-source gate: absent/stopped/stale_fenced/unavailable fence under a remote winner)\"),\n44|    dict(name=\"RV3-M7-loop-deadline-skipped-after-commit\", path=\"execute.go\",\n45|         edits=[(\"\\tfor _, effect := range effects {\\n\\t\\tif !engine.Now().Before(deadline) {\\n\",\n46|                 \"\\tfor _, effect := range effects {\\n\\t\\tif !committed && !engine.Now().Before(deadline) {\\n\")],\n47|         witness=\"TestExecuteDeadlineNeverCancelsCommittedEffect\",\n48|         kind=\"NARROWING (recheck dropped: the in-loop deadline is not re-read once an effect committed, so a deadline arriving mid-operation no longer cancels the remaining waits)\"),\n49|    dict(name=\"RV3-M8-status-last-operation-empty-admitted\", path=\"execute.go\",\n50|         edits=[(\"\\tif observed.LastOperationID != nil {\\n\\t\\tif _, err := scalar.ParseUUIDv7(*observed.LastOperationID); err != nil {\\n\",\n51|                 \"\\tif observed.LastOperationID != nil && *observed.LastOperationID != \\\"\\\" {\\n\\t\\tif _, err := scalar.ParseUUIDv7(*observed.LastOperationID); err != nil {\\n\")],\n52|         witness=\"TestRV3W_M8_StatusLastOperationGrammar\",\n53|         kind=\"NARROWING (status report last_operation_id grammar admits exactly the empty string)\"),\n54|    dict(name=\"RV3-K-known-kill-control\", path=\"auth.go\",\n55|         edits=[(\"\\tleaseEpoch, ok := environ.CheckUint53Bounds(members[\\\"lease_epoch\\\"], 1, MaxLeaseEpoch)\\n\",\n56|                 \"\\tleaseEpoch, ok := environ.CheckUint53Bounds(members[\\\"lease_epoch\\\"], 0, MaxLeaseEpoch)\\n\")],\n57|         witness=\"TestParseAXAuthorizationEpochBound\",\n58|         kind=\"CONTROL (known-killed narrowing: proves the instrument reports kills)\"),\n59|    dict(name=\"RV3-C-comment-control\", path=\"doc.go\",\n60|         edits=[(\"// Package terminstance executes the Terminal Instance lifecycle contract of\\n\",\n61|                 \"// Package terminstance executes the Terminal Instance lifecycle contract of (reviewer control)\\n\")],\n62|         witness=\"TestRequiresProviderObservation\",\n63|         kind=\"CONTROL (harmless comment-only edit: must SURVIVE)\"),\n64|    dict(name=\"RV3-B-build-break-control\", path=\"proof.go\",\n65|         edits=[(\"type ProviderProofKind string\\n\", \"type ProviderProofKind string\\nvar _ = undefinedReviewerSymbol\\n\")],\n66|         witness=\"TestRequiresProviderObservation\",\n67|         kind=\"CONTROL (build break: must report ERROR, never a verdict)\"),\n68|]\n69|\n70|def sha(p):\n71|    return hashlib.sha256(pathlib.Path(p).read_bytes()).hexdigest()\n72|\n73|def run(args, log):\n74|    r = subprocess.run(args, cwd=REPO, capture_output=True, text=True, timeout=600)\n75|    out = (r.stdout + r.stderr)\n76|    log.write_text(f\"# cmd: {' '.join(args)}\\n# subprocess exit {r.returncode}\\n{out}\")\n77|    if \"build failed\" in out or \"\\n# \" in out or out.startswith(\"# \"):\n78|        return \"ERROR(build broke)\"\n79|    if r.returncode == 0:\n80|        return \"SURVIVED\"\n81|    if \"--- FAIL\" in out or \"FAIL:\" in out:\n82|        return \"KILLED\"\n83|    return f\"ERROR(exit {r.returncode}, no kill line)\"\n84|\n85|def main():\n86|    summary = []\n87|    for row in ROWS:\n88|        target = REPO / PKG / row[\"path\"]\n89|        original = target.read_text()\n90|        before = sha(target)\n91|        patched = original\n92|        ok = True\n93|        for find, repl in row[\"edits\"]:\n94|            if patched.count(find) != 1:\n95|                summary.append(f\"ERROR: {row['name']}: anchor count {patched.count(find)} != 1\")\n96|                ok = False\n97|                break\n98|            patched = patched.replace(find, repl)\n99|        if not ok:\n100|            continue\n101|        try:\n102|            target.write_text(patched)\n103|            (OUT / f\"{row['name']}.diff\").write_text(subprocess.run([\"git\", \"diff\", \"--\", f\"{PKG}/{row['path']}\"], cwd=REPO, capture_output=True, text=True).stdout)\n104|            committed = run([\"go\", \"test\", f\"./{PKG}/\", \"-skip\", \"TestRV3\", \"-count=1\"], OUT / f\"{row['name']}.committed.log\")\n105|            witness = run([\"go\", \"test\", f\"./{PKG}/\", \"-run\", row[\"witness\"], \"-count=1\", \"-v\"], OUT / f\"{row['name']}.witness.log\")\n106|        finally:\n107|            target.write_text(original)\n108|        after = sha(target)\n109|        restored = \"restored\" if after == before else \"RESTORE-FAILED\"\n110|        line = f\"{row['name']}: committed-suite={committed} witness[{row['witness']}]={witness} ({restored}) :: {row['kind']}\"\n111|        print(line, flush=True)\n112|        summary.append(line)\n113|    (OUT / \"SUMMARY.txt\").write_text(\"\\n\".join(summary) + \"\\n\")\n114|\n115|if __name__ == \"__main__\":\n116|    main()","final_result":true}}}
