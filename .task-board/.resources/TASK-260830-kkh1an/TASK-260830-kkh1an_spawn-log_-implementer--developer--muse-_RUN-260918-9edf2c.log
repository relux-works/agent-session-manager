{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d079","stream":{"kind":"session","id":"01a0b2ff-60d1-7b92-bcfc-8a4c766633f3"},"sequence":1687,"recorded_at":1780531400003369,"record_type":"event","durability":"durable","causation_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","run_stream":{"kind":"run","id":"b5be48e9-caa3-42a3-a29a-786d769c2b71"},"task_stream":{"kind":"task","id":"01a0b309-48f5-7181-a4c9-1dab2569ec61"},"task_id":"01a0b309-48f5-7181-a4c9-1dab2569ec61","event":{"kind":"output","task_id":"01a0b309-48f5-7181-a4c9-1dab2569ec61","chunk":"Read text file `internal/terminstance/disposition_test.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"testing\"\n5|)\n6|\n7|// TestParseRetryDispositionClosed pins the four-member disposition\n8|// vocabulary at the production entry with literal assertions.\n9|func TestParseRetryDispositionClosed(t *testing.T) {\n10|\tfor _, disposition := range []string{\"replay_same\", \"status_first\", \"new_authorization\", \"required_operator_action\"} {\n11|\t\tif _, err := ParseRetryDisposition(disposition); err != nil {\n12|\t\t\tt.Errorf(\"ParseRetryDisposition(%q) error = %v, want admission\", disposition, err)\n13|\t\t}\n14|\t}\n15|\tfor _, disposition := range []string{\"retry\", \"REPLAY_SAME\", \"\", \"status-first\"} {\n16|\t\t_, err := ParseRetryDisposition(disposition)\n17|\t\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"retry disposition vocabulary\")\n18|\t}\n19|}\n20|\n21|// TestDispositionForMapping pins the leaf's per-code mapping literally:\n22|// each arm names its code and its committed/uncommitted disposition.\n23|func TestDispositionForMapping(t *testing.T) {\n24|\tcases := []struct {\n25|\t\tcode      string\n26|\t\tcommitted bool\n27|\t\twant      string\n28|\t}{\n29|\t\t{\"terminal_backend_unauthorized\", false, \"new_authorization\"},\n30|\t\t{\"terminal_backend_unauthorized\", true, \"new_authorization\"},\n31|\t\t{\"terminal_backend_timeout\", false, \"replay_same\"},\n32|\t\t{\"terminal_backend_timeout\", true, \"status_first\"},\n33|\t\t{\"quiesce_timeout\", false, \"replay_same\"},\n34|\t\t{\"quiesce_timeout\", true, \"status_first\"},\n35|\t\t{\"stop_timeout\", false, \"status_first\"},\n36|\t\t{\"stop_timeout\", true, \"status_first\"},\n37|\t\t{\"idempotency_mismatch\", false, \"status_first\"},\n38|\t\t{\"idempotency_mismatch\", true, \"status_first\"},\n39|\t\t{\"terminal_backend_stale_generation\", false, \"status_first\"},\n40|\t\t{\"terminal_backend_stale_generation\", true, \"status_first\"},\n41|\t\t{\"local_precondition_failed\", false, \"status_first\"},\n42|\t\t{\"local_precondition_failed\", true, \"status_first\"},\n43|\t\t{\"terminal_backend_unavailable\", false, \"status_first\"},\n44|\t\t{\"terminal_backend_unavailable\", true, \"status_first\"},\n45|\t\t{\"terminal_backend_capability_unproven\", false, \"required_operator_action\"},\n46|\t\t{\"terminal_backend_capability_unproven\", true, \"status_first\"},\n47|\t\t{\"terminal_backend_integrity_failure\", false, \"required_operator_action\"},\n48|\t\t{\"terminal_backend_integrity_failure\", true, \"status_first\"},\n49|\t\t{\"terminal_backend_process_failed\", false, \"required_operator_action\"},\n50|\t\t{\"terminal_backend_process_failed\", true, \"status_first\"},\n51|\t\t{\"terminal_backend_protocol_error\", false, \"required_operator_action\"},\n52|\t\t{\"terminal_backend_protocol_error\", true, \"status_first\"},\n53|\t\t{\"something_unknown\", false, \"required_operator_action\"},\n54|\t\t{\"something_unknown\", true, \"status_first\"},\n55|\t}\n56|\tfor _, tc := range cases {\n57|\t\tif got := DispositionFor(tc.code, tc.committed); string(got) != tc.want {\n58|\t\t\tt.Errorf(\"DispositionFor(%q, committed=%v) = %q, want literal %q\", tc.code, tc.committed, string(got), tc.want)\n59|\t\t}\n60|\t}\n61|}\n62|\n63|// TestParseProviderProofKindClosed pins the three-member proof vocabulary\n64|// at the production entry with literal assertions.\n65|func TestParseProviderProofKindClosed(t *testing.T) {\n66|\tfor _, kind := range []string{\"provider_quiescence\", \"provider_process_exit\", \"ax_checkpoint_boundary\"} {\n67|\t\tif _, err := ParseProviderProofKind(kind); err != nil {\n68|\t\t\tt.Errorf(\"ParseProviderProofKind(%q) error = %v, want admission\", kind, err)\n69|\t\t}\n70|\t}\n71|\tfor _, kind := range []string{\"provider_restart\", \"PROVIDER_QUIESCENCE\", \"\"} {\n72|\t\t_, err := ParseProviderProofKind(kind)\n73|\t\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"provider proof vocabulary\")\n74|\t}\n75|}\n76|\n77|// TestRequiresProviderObservation pins the provider-kind classification:\n78|// the two provider kinds require provider observation, the AX boundary\n79|// does not.\n80|func TestRequiresProviderObservation(t *testing.T) {\n81|\tif !RequiresProviderObservation(ProofProviderQuiescence) {\n82|\t\tt.Error(\"RequiresProviderObservation(provider_quiescence) = false, want true\")\n83|\t}\n84|\tif !RequiresProviderObservation(ProofProviderProcessExit) {\n85|\t\tt.Error(\"RequiresProviderObservation(provider_process_exit) = false, want true\")\n86|\t}\n87|\tif RequiresProviderObservation(ProofAXCheckpointBoundary) {\n88|\t\tt.Error(\"RequiresProviderObservation(ax_checkpoint_boundary) = true, want false\")\n89|\t}\n90|}\n91|\n92|// TestParseAuthorizationKindClosed pins the four-member kind vocabulary\n93|// at the production entry with literal assertions.\n94|func TestParseAuthorizationKindClosed(t *testing.T) {\n95|\tfor _, kind := range []string{\"create\", \"control\", \"force_stale\", \"restore\"} {\n96|\t\tif _, err := ParseAuthorizationKind(kind); err != nil {\n97|\t\t\tt.Errorf(\"ParseAuthorizationKind(%q) error = %v, want admission\", kind, err)\n98|\t\t}\n99|\t}\n100|\tfor _, kind := range []string{\"admin\", \"CREATE\", \"\", \"force-stale\", \"attach\", \"none\"} {\n101|\t\t_, err := ParseAuthorizationKind(kind)\n102|\t\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"ax authorization kind\")\n103|\t}\n104|}","final_result":true}}}
