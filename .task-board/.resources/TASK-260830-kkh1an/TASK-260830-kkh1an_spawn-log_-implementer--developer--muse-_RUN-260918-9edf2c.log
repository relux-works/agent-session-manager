es still fence and other tuples are unchanged.\",\n+    ),\n+    Mutant(\n+        name=\"N-fencing-verdict-unverified\",\n+        path=\"internal/fencing/staleness.go\",\n+        find=\"\\tif !observation.Verified {\\n\\t\\treturn false, false\\n\\t}\\n\",\n+        replace=\"\\tif !observation.Verified && presented.Epoch != 1 {\\n\\t\\treturn false, false\\n\\t}\\n\",\n+        count=1,\n+        run=\"TestRV3F3_GrantLessUndecidedLeavesState/unverified\",\n+        expect=\"KILLED\",\n+        note=\"Decides exactly epoch-1 unverified observations; other unverified members stay undecided.\",\n+    ),\n+    Mutant(\n+        name=\"N-fencing-verdict-ambiguous\",\n+        path=\"internal/fencing/staleness.go\",\n+        find=\"\\tif observation.Ambiguous {\\n\\t\\treturn false, false\\n\\t}\\n\",\n+        replace=\"\\tif observation.Ambiguous && presented.Epoch != 1 {\\n\\t\\treturn false, false\\n\\t}\\n\",\n+        count=1,\n+        run=\"TestRV3F3_GrantLessUndecidedLeavesState/ambiguous\",\n+        expect=\"KILLED\",\n+        note=\"Decides exactly epoch-1 ambiguous observations; other ambiguous members stay undecided.\",\n+    ),\n+    Mutant(\n+        name=\"N-fencing-verdict-nowinner\",\n+        path=\"internal/fencing/staleness.go\",\n+        find=\"\\tif !observation.HasWinner {\\n\\t\\treturn false, false\\n\\t}\\n\",\n+        replace=\"\\tif !observation.HasWinner && presented.Epoch != 1 {\\n\\t\\treturn false, false\\n\\t}\\n\",\n+        count=1,\n+        run=\"TestRV3F3_GrantLessUndecidedLeavesState/no_winner\",\n+        expect=\"KILLED\",\n+        note=\"Decides exactly epoch-1 winnerless observations; other winnerless members stay undecided.\",\n+    ),\n+    Mutant(\n+        name=\"N-fencing-verdict-winner-shape\",\n+        path=\"internal/fencing/staleness.go\",\n+        find=\"\\tif observation.Winner.Epoch == 0 || !validLeaseID(observation.Winner.LeaseID) || !validHostID(observation.Winner.HolderHostID) {\\n\\t\\treturn false, false\\n\\t}\\n\",\n+        replace=\"\\tif (observation.Winner.Epoch == 0 || !validLeaseID(observation.Winner.LeaseID) || !validHostID(observation.Winner.HolderHostID)) && presented.Epoch != 1 {\\n\\t\\treturn false, false\\n\\t}\\n\",\n+        count=1,\n+        run=\"TestRV3F3_GrantLessUndecidedLeavesState/malformed_winner\",\n+        expect=\"KILLED\",\n+        note=\"Decides exactly epoch-1 malformed-winner observations; other malformed winners stay undecided.\",\n+    ),\n+    Mutant(\n+        name=\"N-fencing-verdict-session\",\n+        path=\"internal/fencing/staleness.go\",\n+        find=\"\\tif presented.SessionID != observation.SessionID {\\n\\t\\treturn false, false\\n\\t}\\n\",\n+        replace=\"\\tif presented.SessionID != observation.SessionID && presented.Epoch != 1 {\\n\\t\\treturn false, false\\n\\t}\\n\",\n+        count=1,\n+        run=\"TestRV3F3_GrantLessUndecidedLeavesState/session_mismatch\",\n+        expect=\"KILLED\",\n+        note=\"Decides exactly epoch-1 session-mismatched observations; other mismatches stay undecided.\",\n+    ),\n+    Mutant(\n+        name=\"N-fencing-verdict-handoff\",\n+        path=\"internal/fencing/staleness.go\",\n+        find=\"\\tif observation.HandoffFailed {\\n\\t\\treturn false, false\\n\\t}\\n\",\n+        replace=\"\\tif observation.HandoffFailed && presented.Epoch != 1 {\\n\\t\\treturn false, false\\n\\t}\\n\",\n+        count=1,\n+        run=\"TestRV3F3_GrantLessUndecidedLeavesState/failed_handoff\",\n+        expect=\"KILLED\",\n+        note=\"Decides exactly epoch-1 failed-handoff observations; the park is otherwise preserved.\",\n+    ),\n+    Mutant(\n+        name=\"N-fencing-verdict-presented-session\",\n+        path=\"internal/fencing/staleness.go\",\n+        find=\"\\tif _, err := scalar.ParseUUIDv7(presented.SessionID); err != nil {\\n\\t\\treturn false, false\\n\\t}\\n\",\n+        replace=\"\\tif _, err := scalar.ParseUUIDv7(presented.SessionID); err != nil && presented.Epoch != 1 {\\n\\t\\treturn false, false\\n\\t}\\n\",\n+        count=1,\n+        run=\"TestRV3F3_GrantLessUndecidedLeavesState/malformed_session\",\n+        expect=\"KILLED\",\n+        note=\"Decides exactly the epoch-1 agreed-malformed session (both sides name one malformed session, so only the grammar arm undecides it); other malformed sessions still mismatch first.\",\n+    ),\n+    Mutant(\n+        name=\"N-fencing-verdict-presented-epoch\",\n+        path=\"internal/fencing/staleness.go\",\n+        find=\"\\tif presented.Epoch == 0 {\\n\\t\\treturn false, false\\n\\t}\\n\",\n+        replace='\\tif presented.Epoch == 0 && presented.LeaseID != \"6ba7b810-9dad-41d1-80b4-00c04fd430c8\" {\\n\\t\\treturn false, false\\n\\t}\\n\",\n+        count=1,\n+        run=\"TestRV3F3_GrantLessUndecidedLeavesState/epoch_zero\",\n+        expect=\"KILLED\",\n+        note=\"Decides exactly the zero-epoch token under the losing test lease; the zero-epoch winning-lease member stays undecided.\",\n+    ),\n+    Mutant(\n+        name=\"N-fencing-verdict-presented-lease\",\n+        path=\"internal/fencing/staleness.go\",\n+        find=\"\\tif _, err := scalar.ParseUUIDv4(presented.LeaseID); err != nil {\\n\\t\\treturn false, false\\n\\t}\\n\",\n+        replace=\"\\tif _, err := scalar.ParseUUIDv4(presented.LeaseID); err != nil && presented.Epoch != 1 {\\n\\t\\treturn false, false\\n\\t}\\n\",\n+        count=1,\n+        run=\"TestRV3F3_GrantLessUndecidedLeavesState/malformed_lease\",\n+        expect=\"KILLED\",\n+        note=\"Decides exactly epoch-1 malformed-lease tokens; other malformed leases stay undecided.\",\n+    ),\n+    Mutant(\n+        name=\"N-fencing-verdict-composition\",\n+        path=f\"{PACKAGE}/fencing.go\",\n+        find=\"\\tif stale, decided := fencing.StaleRelativeToWinner(presented, observation); decided && stale {\\n\",\n+        replace=\"\\tif _, decided := fencing.StaleRelativeToWinner(presented, observation); decided {\\n\",\n+        count=1,\n+        run=\"TestRV3F3_GrantLessDecidedNotStaleLeavesState\",\n+        expect=\"KILLED\",\n+        note=\"Fences on decided alone instead of decided-stale: the winning token and the future epoch fence grant-less. (Dropping the decided conjunct instead would be equivalent — the verdict never reports stale undecided — so the decided half is measured by the eleven verdict rows above.)\",\n+    ),\n+    Mutant(\n+        name=\"N-engine-recheck-auth-expiry\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find='\\tperformed := []terminalbackend.SideEffect(nil)\\n\\tfor _, effect := range effects {\\n\\t\\tif !engine.Now().Before(deadline) {\\n\\t\\t\\tfailure := refuse(rowTimeoutCode(operation), \"operation deadline\")\\n\\t\\t\\tif committed {\\n\\t\\t\\t\\treturn buildResult(context, source, terminalbackend.StateUnavailable, performed, evidence, DispositionStatusFirst), failure\\n\\t\\t\\t}\\n\\t\\t\\treturn buildResult(context, source, source, performed, evidence, DispositionReplaySame), failure\\n\\t\\t}\\n\\t\\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil {\\n',\n+        replace='\\tperformed := []terminalbackend.SideEffect(nil)\\n\\tentryNow := engine.Now()\\n\\tfor _, effect := range effects {\\n\\t\\tif !engine.Now().Before(deadline) {\\n\\t\\t\\tfailure := refuse(rowTimeoutCode(operation), \"operation deadline\")\\n\\t\\t\\tif committed {\\n\\t\\t\\t\\treturn buildResult(context, source, terminalbackend.StateUnavailable, performed, evidence, DispositionStatusFirst), failure\\n\\t\\t\\t}\\n\\t\\t\\treturn buildResult(context, source, source, performed, evidence, DispositionReplaySame), failure\\n\\t\\t}\\n\\t\\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), entryNow); err != nil {\\n',\n+        count=1,\n+        run=\"TestRV3W_M1_AuthExpiryRecheckedBeforeEachEffect\",\n+        expect=\"KILLED\",\n+        note=\"Drops the per-effect authorization EXPIRY recheck (expiry evaluated at the entry instant) while the lease-tuple recheck stays per-effect; the spanned definition+use is one plant — either half alone breaks the build. Mirrors reviewer narrowing RV3-M1.\",\n+    ),\n+    Mutant(\n+        name=\"N-result-evidence-bound\",\n+        path=f\"{PACKAGE}/result.go\",\n+        find=\"\\tif len(evidence) > 256 {\\n\",\n+        replace=\"\\tif len(evidence) > 257 {\\n\",\n+        count=1,\n+        run=\"TestRV3W_M2_EvidenceBoundEdge\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly 257 evidence IDs on the one shared helper both the result and the status surface route through (one site, both surfaces in the killer). Mirrors reviewer narrowing RV3-M2.\",\n+    ),\n+    Mutant(\n+        name=\"N-engine-conditional-disposition\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find=\"\\tif err := checkCapabilityConditional(operation, params, admitted); err != nil {\\n\\t\\tfailure := err.(*Error)\\n\\t\\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\\n\",\n+        replace=\"\\tif err := checkCapabilityConditional(operation, params, admitted); err != nil {\\n\\t\\tfailure := err.(*Error)\\n\\t\\treturn buildResult(context, source, source, nil, nil, DispositionStatusFirst), failure\\n\",\n+        count=1,\n+        run=\"TestRV3W_M3_ConditionalCapabilityDisposition\",\n+        expect=\"KILLED\",\n+        note=\"Reports exactly the capability-conditional arm as status_first instead of the class-mapped required_operator_action. Mirrors reviewer narrowing RV3-M3.\",\n+    ),\n+    Mutant(\n+        name=\"N-proof-sibling\",\n+        path=f\"{PACKAGE}/proof.go\",\n+        find='\\tdefault:\\n\\t\\treturn \"\", refuse(CodeProtocolError, \"provider proof vocabulary\")\\n\\t}\\n',\n+        replace='\\tdefault:\\n\\t\\tif value == \"provider_process_observation\" {\\n\\t\\t\\treturn ProofProviderQuiescence, nil\\n\\t\\t}\\n\\t\\treturn \"\", refuse(CodeProtocolError, \"provider proof vocabulary\")\\n\\t}\\n',\n+        count=1,\n+        run=\"TestRV3W_M4_ProofKindSiblingNamesRefused\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the landed capability name provider_process_observation as a proof kind; every other non-kind still refuses. Mirrors reviewer narrowing RV3-M4.\",\n+    ),\n+    Mutant(\n+        name=\"N-status-last-operation-empty\",\n+        path=f\"{PACKAGE}/execute.go\",\n+        find=\"\\tif observed.LastOperationID != nil {\\n\\t\\tif _, err := scalar.ParseUUIDv7(*observed.LastOperationID); err != nil {\\n\",\n+        replace='\\tif observed.LastOperationID != nil && *observed.LastOperationID != \"\" {\\n\\t\\tif _, err := scalar.ParseUUIDv7(*observed.LastOperationID); err != nil {\\n',\n+        count=1,\n+        run=\"TestRV3W_M8_StatusLastOperationGrammar\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the empty last_operation_id on status reports; other non-UUIDv7 values still refuse. Mirrors reviewer narrowing RV3-M8.\",\n+    ),\n+    Mutant(\n+        name=\"C-control\",\n","final_result":true}}}
