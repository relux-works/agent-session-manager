and stopped name no incarnation, stale_fenced is already fenced, and\n115|// unavailable is unknown: none of them transitions.\n116|func fenceLive(current terminalbackend.InstanceState, authErr error) (terminalbackend.InstanceState, bool, error) {\n117|\tswitch current {\n118|\tcase terminalbackend.StateCreating, terminalbackend.StateParked,\n119|\t\tterminalbackend.StateActive, terminalbackend.StateQuiescing:\n120|\t\treturn terminalbackend.StateStaleFenced, true, nil\n121|\tdefault:\n122|\t\treturn current, false, authErr\n123|\t}\n124|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
