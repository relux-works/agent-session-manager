{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8a9","stream":{"kind":"session","id":"01a0b2ff-60d1-7b92-bcfc-8a4c766633f3"},"sequence":687,"recorded_at":1780531400001369,"record_type":"event","durability":"durable","causation_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","run_stream":{"kind":"run","id":"b5be48e9-caa3-42a3-a29a-786d769c2b71"},"call_id":"call_01a0b3011e4f72da87d2e8c60f93239d","text":"Read text file `internal/terminstance/recheck_test.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"testing\"\n5|\t\"time\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n8|)\n9|\n10|// TestExecuteRechecksBeforeThirdEffect proves authorization and\n11|// generation are rechecked immediately before EACH side effect, not\n12|// just the first two: a lease and a generation rotation between the\n13|// second and third stop effects are both caught at the third recheck,\n14|// after two committed effects.\n15|func TestExecuteRechecksBeforeThirdEffect(t *testing.T) {\n16|\tt.Run(\"lease rotates before third effect\", func(t *testing.T) {\n17|\t\tbackend := newMockBackend()\n18|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n19|\t\tcalls := 0\n20|\t\tengine.CurrentLease = func() LeaseView {\n21|\t\t\tcalls++\n22|\t\t\tif calls <= 3 {\n23|\t\t\t\treturn testLease()\n24|\t\t\t}\n25|\t\t\treturn LeaseView{LeaseID: fixtureLease, Epoch: 2}\n26|\t\t}\n27|\t\tcontext, params, source, admitted := stopFixture(t)\n28|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationRequestStop, context, params, source, admitted)\n29|\t\trequireRefusal(t, err, \"terminal_backend_unauthorized\", \"ax authorization lease epoch\")\n30|\t\trequireLiteral(t, \"after\", string(result.After), \"unavailable\")\n31|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"new_authorization\")\n32|\t\tif len(backend.performed()) != 2 {\n33|\t\t\tt.Errorf(\"performed = %v, want exactly two effects before the rotated lease is caught\", backend.performed())\n34|\t\t}\n35|\t})\n36|\tt.Run(\"generation rotates before third effect\", func(t *testing.T) {\n37|\t\tbackend := newMockBackend()\n38|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n39|\t\tcalls := 0\n40|\t\tengine.CurrentGeneration = func() string {\n41|\t\t\tcalls++\n42|\t\t\tif calls <= 3 {\n43|\t\t\t\treturn fixtureGen\n44|\t\t\t}\n45|\t\t\treturn \"generation-two\"\n46|\t\t}\n47|\t\tcontext, params, source, admitted := stopFixture(t)\n48|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationRequestStop, context, params, source, admitted)\n49|\t\trequireRefusal(t, err, \"terminal_backend_stale_generation\", \"backend_generation stale\")\n50|\t\trequireLiteral(t, \"after\", string(result.After), \"unavailable\")\n51|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"status_first\")\n52|\t\tif len(backend.performed()) != 2 {\n53|\t\t\tt.Errorf(\"performed = %v, want exactly two effects before the rotated generation is caught\", backend.performed())\n54|\t\t}\n55|\t})\n56|}\n57|\n58|// TestExecuteStatusSessionDriftRefuses proves the reported session is\n59|// compared on both status lookup paths: a backend reporting ANOTHER\n60|// session's instance with identity_match true is a lying match and\n61|// refuses, never adopted — on the exact-instance path and on the\n62|// Session-scoped path alike. A foreign session with the canonical\n63|// non-match form is a proven non-match and adopts absent: the report\n64|// carries no instance facts, only the mismatch the query asked about.\n65|func TestExecuteStatusSessionDriftRefuses(t *testing.T) {\n66|\tt.Run(\"exact lying match refuses\", func(t *testing.T) {\n67|\t\tbackend := newMockBackend()\n68|\t\tobserved := matchingObservation()\n69|\t\tobserved.SessionID = fixtureSessionB\n70|\t\tbackend.observation = observed\n71|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n72|\t\t_, err := engine.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n73|\t\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"status identity binding\")\n74|\t})\n75|\tt.Run(\"exact non-match adopts absent\", func(t *testing.T) {\n76|\t\tbackend := newMockBackend()\n77|\t\tbackend.observation = StatusObservation{\n78|\t\t\tState: terminalbackend.StateAbsent, IdentityMatch: false,\n79|\t\t\tSessionID: fixtureSessionB, InstanceID: fixtureInstance,\n80|\t\t\tBackendID: fixtureBackend, ImplVersion: fixtureImpl,\n81|\t\t\tProtoVersion: fixtureProto, Generation: fixtureGen,\n82|\t\t}\n83|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n84|\t\treport, err := engine.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n85|\t\tif err != nil {\n86|\t\t\tt.Fatalf(\"ExecuteStatus() error = %v, want the proven non-match\", err)\n87|\t\t}\n88|\t\trequireLiteral(t, \"state\", string(report.State), \"absent\")\n89|\t\tif report.IdentityMatch {\n90|\t\t\tt.Error(\"identity_match = true, want false\")\n91|\t\t}\n92|\t})\n93|\tt.Run(\"session_scoped lying match refuses\", func(t *testing.T) {\n94|\t\tbody, err := ParseStatusBody([]byte(statusDoc(`null`, `null`)))\n95|\t\tif err != nil {\n96|\t\t\tt.Fatal(err)\n97|\t\t}\n98|\t\tbackend := newMockBackend()\n99|\t\tobserved := matchingObservation()\n100|\t\tobserved.SessionID = fixtureSessionB\n101|\t\tbackend.observation = observed\n102|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n103|\t\t_, err = engine.ExecuteStatus(contextGo(), body, mustParseState(t, \"absent\"), testAdmitted(\"durable_disconnect\"))\n104|\t\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"status identity binding\")\n105|\t})\n106|\tt.Run(\"session_scoped non-match adopts absent\", func(t *testing.T) {\n107|\t\tbody, err := ParseStatusBody([]byte(statusDoc(`null`, `null`)))\n108|\t\tif err != nil {\n109|\t\t\tt.Fatal(err)\n110|\t\t}\n111|\t\tbackend := newMockBackend()\n112|\t\tbackend.observation = StatusObservation{\n113|\t\t\tState: terminalbackend.StateAbsent, IdentityMatch: false,\n114|\t\t\tSessionID: fixtureSessionB, InstanceID: fixtureInstance,\n115|\t\t\tBackendID: fixtureBackend, ImplVersion: fixtureImpl,\n116|\t\t\tProtoVersion: fixtureProto, Generation: fixtureGen,\n117|\t\t}\n118|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n119|\t\treport, err := engine.ExecuteStatus(contextGo(), body, mustParseState(t, \"absent\"), testAdmitted(\"durable_disconnect\"))\n120|\t\tif err != nil {\n121|\t\t\tt.Fatalf(\"ExecuteStatus() error = %v, want the proven non-match\", err)\n122|\t\t}\n123|\t\trequireLiteral(t, \"state\", string(report.State), \"absent\")\n124|\t})\n125|}\n126|\n127|// TestExecuteStatusIdentityMatchEachAxis proves identity_match is the\n128|// six-way conjunction on the exact-instance path: drift on EACH axis\n129|// alone with the canonical absent form reads as a proven non-match,\n130|// and a lying match on each axis refuses.\n131|func TestExecuteStatusIdentityMatchEachAxis(t *testing.T) {\n132|\taxes := map[string]func(*StatusObservation){\n133|\t\t\"instance\":       func(observed *StatusObservation) { observed.InstanceID = \"0198f4c8-8e50-7f66-8f70-bbbbbbbbbbb2\" },\n134|\t\t\"backend\":        func(observed *StatusObservation) { observed.BackendID = \"other.backend\" },\n135|\t\t\"implementation\": func(observed *StatusObservation) { observed.ImplVersion = \"1.2.4\" },\n136|\t\t\"protocol\":       func(observed *StatusObservation) { observed.ProtoVersion = \"1.0.1\" },\n137|\t\t\"generation\":     func(observed *StatusObservation) { observed.Generation = \"generation-two\" },\n138|\t}\n139|\tfor name, drift := range axes {\n140|\t\tt.Run(name+\"/canonical_non_match_admits\", func(t *testing.T) {\n141|\t\t\tbackend := newMockBackend()\n142|\t\t\tobserved := StatusObservation{\n143|\t\t\t\tState: terminalbackend.StateAbsent, IdentityMatch: false,\n144|\t\t\t\tSessionID: fixtureSessionA, InstanceID: fixtureInstance,\n145|\t\t\t\tBackendID: fixtureBackend, ImplVersion: fixtureImpl,\n146|\t\t\t\tProtoVersion: fixtureProto, Generation: fixtureGen,\n147|\t\t\t}\n148|\t\t\tdrift(&observed)\n149|\t\t\tbackend.observation = observed\n150|\t\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n151|\t\t\treport, err := engine.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n152|\t\t\tif err != nil {\n153|\t\t\t\tt.Fatalf(\"ExecuteStatus() drift on %s with the canonical absent form error = %v\", name, err)\n154|\t\t\t}\n155|\t\t\trequireLiteral(t, \"state\", string(report.State), \"absent\")\n156|\t\t})\n157|\t\tt.Run(name+\"/lying_match_refuses\", func(t *testing.T) {\n158|\t\t\tbackend := newMockBackend()\n159|\t\t\tobserved := matchingObservation()\n160|\t\t\tdrift(&observed)\n161|\t\t\tbackend.observation = observed\n162|\t\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n163|\t\t\t_, err := engine.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n164|\t\t\trequireRefusal(t, err, \"terminal_backend_protocol_error\", \"status identity binding\")\n165|\t\t})\n166|\t}\n167|}\n168|\n169|// TestExecuteEntryDeadlineInstantRefuses proves the deadline instant\n170|// itself refuses at the mutating entry on every engine row: now equal\n171|// to deadline_at cancels before any receipt or effect with the row's\n172|// timeout code and replay_same.\n173|func TestExecuteEntryDeadlineInstantRefuses(t *testing.T) {\n174|\tdeadline, err := time.Parse(time.RFC3339Nano, fixtureDeadline)\n175|\tif err != nil {\n176|\t\tt.Fatal(err)\n177|\t}\n178|\tcases := []struct {\n179|\t\toperation terminalbackend.Operation\n180|\t\tbuild     func(t *testing.T) (MutationContext, Params, terminalbackend.InstanceState, terminalbackend.Admitted)\n181|\t\tcode      string\n182|\t\tsource    string\n183|\t}{\n184|\t\t{terminalbackend.OperationQuiesceInput, func(t *testing.T) (MutationContext, Params, terminalbackend.InstanceState, terminalbackend.Admitted) {\n185|\t\t\treturn quiesceFixture(t)\n186|\t\t}, \"terminal_backend_timeout\", \"active\"},\n187|\t\t{terminalbackend.OperationWaitSafeBoundary, func(t *testing.T) (MutationContext, Params, terminalbackend.InstanceState, terminalbackend.Admitted) {\n188|\t\t\treturn waitFixture(t, ProofAXCheckpointBoundary)\n189|\t\t}, \"quiesce_timeout\", \"quiescing\"},\n190|\t\t{terminalbackend.OperationRequestStop, func(t *testing.T) (MutationContext, Params, terminalbackend.InstanceState, terminalbackend.Admitted) {\n191|\t\t\treturn stopFixture(t)\n192|\t\t}, \"stop_timeout\", \"quiescing\"},\n193|\t\t{terminalbackend.OperationCreate, func(t *testing.T) (MutationContext, Params, terminalbackend.InstanceState, terminalbackend.Admitted) {\n194|\t\t\tcreated := testCreateContext(t)\n195|\t\t\treturn created.context, created.params, mustParseState(t, \"absent\"), testAdmitted(\"terminal_state_retention\")\n196|\t\t}, \"terminal_backend_timeout\", \"absent\"},\n197|\t}\n198|\tfor _, tc := range cases {\n199|\t\tt.Run(string(tc.operation), func(t *testing.T) {\n200|\t\t\tbackend := newMockBackend()\n201|\t\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n202|\t\t\tengine.Now = func() time.Time { return deadline }\n203|\t\t\tcontext, params, source, admitted := tc.build(t)\n204|\t\t\tresult, err := engine.ExecuteMutating(contextGo(), tc.operation, context, params, source, admitted)\n205|\t\t\trequireRefusal(t, err, tc.code, \"operation deadline\")\n206|\t\t\trequireLiteral(t, \"after\", string(result.After), tc.source)\n207|\t\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"replay_same\")\n208|\t\t\tif len(backend.performed()) != 0 {\n209|\t\t\t\tt.Errorf(\"performed = %v, want no effects at the deadline instant\", backend.performed())\n210|\t\t\t}\n211|\t\t\tif _, found, _ := engine.Store.Lookup(context.IdempotencyKey); found {\n212|\t\t\t\tt.Error(\"Lookup(key) found a receipt at the deadline instant, want none bound\")\n213|\t\t\t}\n214|\t\t})\n215|\t}\n216|}\n217|\n218|// TestExecuteStatusDeadlineInstantRefuses proves the deadline instant\n219|// refuses at the status entry too: now equal to deadline_at reports\n220|// terminal_backend_timeout with no observation run.\n221|func TestExecuteStatusDeadlineInstantRefuses(t *testing.T) {\n222|\tdeadline, err := time.Parse(time.RFC3339Nano, fixtureDeadline)\n223|\tif err != nil {\n224|\t\tt.Fatal(err)\n225|\t}\n226|\tbackend := newMockBackend()\n227|\tbackend.observation = matchingObservation()\n228|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n229|\tengine.Now = func() time.Time { return deadline }\n230|\t_, err = engine.ExecuteStatus(contextGo(), exactStatusBody(t), mustParseState(t, \"active\"), testAdmitted(\"durable_disconnect\"))\n231|\trequireRefusal(t, err, \"terminal_backend_timeout\", \"operation deadline\")\n232|\tif backend.observeCalls != 0 {\n233|\t\tt.Errorf(\"observe calls = %d, want none at the deadline instant\", backend.observeCalls)\n234|\t}\n235|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8ab","stream":{"kind":"session","id":"01a0b2ff-60d1-7b92-bcfc-8a4c766633f3"},"sequence":688,"recorded_at":1780531400001371,"record_type":"event","durability":"durable","causation_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","run_stream":{"kind":"run","id":"b5be48e9-caa3-42a3-a29a-786d769c2b71"},"call_id":"call_01a0b3011f7673d6bded0209236d0020","text":"Read text file `internal/terminstance/doc.go`.\n1|// Package terminstance executes the Terminal Instance lifecycle contract of\n2|// SPEC §4.C over the landed internal/terminalbackend semantic core.\n3|//\n4|// Normative scope is relux-works/agent-session-manager-spec §4.C (lifecycle\n5|// state machine, transition/authorization/idempotency table), §4.B (the\n6|// backend_generation canonical bound), §4.D (capability conditionals\n7|// evaluated at the operation call site), §5.2 (status/unknown discipline),\n8|// §7.A (descriptor generation binding, cited landed) and §13.1 (durable\n9|// terminal entry before provider launch). Worked against\n10|// internal/specdoc/SPEC.v0.7.0.md: §§4.B, 4.C, 4.D, 5.2 and 7.A are\n11|// byte-identical to v0.6.0, while §13.1 carries the v0.7.0 launch-plan\n12|// insertion that precedes step 2 (a pure addition; the durable\n13|// terminal-entry rule text is unchanged).\n14|//\n15|// Composition, not re-implementation: the eight-state enum, the ten-operation\n16|// enum, the ten-effect enum, the transition matrix, the allowed-error sets,\n17|// the idempotency key shapes and the capability registry stay owned by\n18|// internal/terminalbackend (ParseInstanceState, ParseOperation,\n19|// ParseSideEffect, CheckTransition, CheckErrorAllowed, IdempotencyKey,\n20|// CheckOperation, GenerationDigest, CheckProviderDescriptor). Closed-shape\n21|// JSON admission stays owned by internal/environ (DecodeStrictObject,\n22|// CheckStringBounds, CheckUint53Bounds, CheckDigest, CheckUUIDv7,\n23|// CheckTimestamp, CheckSemver). Scalar grammars stay owned by\n24|// internal/scalar. Fencing truth stays owned by internal/fencing\n25|// (Authorize): this package never compares lease tuples itself to decide\n26|// staleness; ObserveFencing reads only the landed park vocabulary. What\n27|// this package owns is the execution layer the landed core deliberately\n28|// leaves out: the AXAuthorization closed object, the RetryDisposition and\n29|// ProviderProofKind closed enums, the mutating-request/response identity\n30|// contract, the per-side-effect recheck loop, the error-to-observation\n31|// mapping, and the durable idempotency receipt store.\n32|//\n33|// Stated bounds (no unsupported claims): no ax command, no tmux/ConPTY\n34|// process control and no provider process exist here; Backend is a modeled\n35|// caller interface. The Terminal Instance Binding 1.0.0 closed object has\n36|// no parser on trunk (canonicaljson explicitly rejects\n37|// urn:ax:schema:terminal-instance-binding) and the CLI Result 4 bodies\n38|// carry no raw generation member, so the generation bound is enforced on\n39|// the surfaces this leaf owns (operation bodies and results) and cited\n40|// landed for the Provider Protocol 3 descriptor; full Binding-object\n41|// parsing belongs with the provisioning surface. Attach, restore,\n42|// terminate-stale, manifest and probe operations are refused by the engine\n43|// scope gate; restore/terminate-stale recovery belongs to the story's\n44|// final leaf. Events (terminal.created/session.resumed emission) belong to\n45|// the final leaf. On reattach the recorded Binding terminal instance ID is\n46|// authoritative; a request-built descriptor names the request's own fresh\n47|// instance, never the recorded child.\n48|package terminstance","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
