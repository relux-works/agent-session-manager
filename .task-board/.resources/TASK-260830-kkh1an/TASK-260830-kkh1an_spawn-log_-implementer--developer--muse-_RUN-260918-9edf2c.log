{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c943","stream":{"kind":"session","id":"01a0b2ff-60d1-7b92-bcfc-8a4c766633f3"},"sequence":764,"recorded_at":1780531400001523,"record_type":"event","durability":"durable","causation_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","run_stream":{"kind":"run","id":"b5be48e9-caa3-42a3-a29a-786d769c2b71"},"call_id":"call_01a0b3030d59764e8ee2152385c3ca32","text":"Read text file `internal/fencing/census_test.go`.\n1|package fencing\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/token\"\n6|\t\"os/exec\"\n7|\t\"path/filepath\"\n8|\t\"runtime\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/invcore\"\n14|)\n15|\n16|// sealConstructorFile is the only production file that may name the\n17|// seal types or assemble a non-empty LeaseToken.\n18|const sealConstructorFile = \"token.go\"\n19|\n20|// auditSealBoundary derives every seal-construction reference outside\n21|// the constructor file: any occurrence of the seal idents, and any\n22|// non-empty LeaseToken composite literal. The walk is over AST\n23|// idents, so comments and string literals that mention the seal are\n24|// not references. A display name and parsed file let the same audit\n25|// run over control plants.\n26|func auditSealBoundary(display string, syntax *ast.File, fileSet *token.FileSet) []string {\n27|\tvar violations []string\n28|\tposition := func(node ast.Node) string {\n29|\t\tplace := fileSet.Position(node.Pos())\n30|\t\treturn display + \":\" + strconv.Itoa(place.Line)\n31|\t}\n32|\tast.Inspect(syntax, func(node ast.Node) bool {\n33|\t\tident, ok := node.(*ast.Ident)\n34|\t\tif ok && (ident.Name == \"leaseSeal\" || ident.Name == \"leaseSealToken\") {\n35|\t\t\tviolations = append(violations, \"seal type reference outside \"+sealConstructorFile+\": \"+position(ident))\n36|\t\t\treturn true\n37|\t\t}\n38|\t\tliteral, ok := node.(*ast.CompositeLit)\n39|\t\tif !ok || len(literal.Elts) == 0 {\n40|\t\t\treturn true\n41|\t\t}\n42|\t\tif ident, ok := literal.Type.(*ast.Ident); ok && ident.Name == \"LeaseToken\" {\n43|\t\t\tviolations = append(violations, \"non-empty LeaseToken literal outside \"+sealConstructorFile+\": \"+position(literal))\n44|\t\t}\n45|\t\treturn true\n46|\t})\n47|\treturn violations\n48|}\n49|\n50|// TestLeaseTokenConstructorCensus pins the sealed-capability\n51|// construction boundary: only token.go names the seal types or\n52|// assembles a non-empty LeaseToken, and token.go carries exactly one\n53|// mint site. gate.go's empty LeaseToken{} refusals are not authority\n54|// and stay allowed.\n55|func TestLeaseTokenConstructorCensus(t *testing.T) {\n56|\tfiles, fileSet := invcore.MustScanProduction(t, \".\")\n57|\tvar violations []string\n58|\tmints := 0\n59|\tfor _, file := range files {\n60|\t\tif file.Name == sealConstructorFile {\n61|\t\t\tmints += strings.Count(string(file.Source), \"&leaseSealToken{}\")\n62|\t\t\tcontinue\n63|\t\t}\n64|\t\tviolations = append(violations, auditSealBoundary(file.Name, file.Syntax, fileSet)...)\n65|\t}\n66|\tfor _, violation := range violations {\n67|\t\tt.Error(violation)\n68|\t}\n69|\tif mints != 1 {\n70|\t\tt.Errorf(\"mint sites = %d, want exactly one &leaseSealToken{} in %s\", mints, sealConstructorFile)\n71|\t}\n72|}\n73|\n74|// sealPlants rosters the control plants the census must accept or\n75|// reject. The alias plant preserves the searched-for token\n76|// (leaseSeal) while constructing through a renamed spelling: a\n77|// text search for the construction shape would miss it, so the\n78|// ident-based audit must still reject it.\n79|func sealPlants() map[string]struct {\n80|\tsource string\n81|\treject bool\n82|} {\n83|\treturn map[string]struct {\n84|\t\tsource string\n85|\t\treject bool\n86|\t}{\n87|\t\t\"comment_mentions_seal\": {\n88|\t\t\tsource: \"package fencing\\n\\n// leaseSeal and leaseSealToken are constructor-only; LeaseToken{seal: x} never appears here.\\nfunc plantComment() {}\\n\",\n89|\t\t\treject: false,\n90|\t\t},\n91|\t\t\"string_mentions_seal\": {\n92|\t\t\tsource: \"package fencing\\n\\nvar plantString = \\\"leaseSeal{token: &leaseSealToken{}}\\\"\\n\\nfunc plantUse() string { return plantString }\\n\",\n93|\t\t\treject: false,\n94|\t\t},\n95|\t\t\"alias_backdoor\": {\n96|\t\t\tsource: \"package fencing\\n\\ntype plantBackdoor = leaseSeal\\n\\nfunc plantAlias() LeaseToken { return LeaseToken{seal: &plantBackdoor{}} }\\n\",\n97|\t\t\treject: true,\n98|\t\t},\n99|\t\t\"direct_forgery\": {\n100|\t\t\tsource: \"package fencing\\n\\nfunc plantDirect() LeaseToken { return LeaseToken{seal: &leaseSeal{token: &leaseSealToken{}}} }\\n\",\n101|\t\t\treject: true,\n102|\t\t},\n103|\t\t\"shadowed_seal\": {\n104|\t\t\tsource: \"package fencing\\n\\ntype leaseSeal struct{ note string }\\n\\nfunc plantShadow() string { return leaseSeal{note: \\\"x\\\"}.note }\\n\",\n105|\t\t\treject: true,\n106|\t\t},\n107|\t}\n108|}\n109|\n110|// TestLeaseTokenCensusPlants executes the control plants through the\n111|// same audit the production census runs: comment and string mentions\n112|// of the seal are not references, while alias, direct, and shadowing\n113|// forgeries are rejected.\n114|func TestLeaseTokenCensusPlants(t *testing.T) {\n115|\tfor name, plant := range sealPlants() {\n116|\t\tt.Run(name, func(t *testing.T) {\n117|\t\t\tsyntax, fileSet, failure := invcore.ParseSource(\"plant.go\", []byte(plant.source))\n118|\t\t\tif failure != \"\" {\n119|\t\t\t\tt.Fatalf(\"parse plant: %s\", failure)\n120|\t\t\t}\n121|\t\t\tviolations := auditSealBoundary(\"plant.go\", syntax, fileSet)\n122|\t\t\tif plant.reject && len(violations) == 0 {\n123|\t\t\t\tt.Fatalf(\"plant %s accepted, want rejection\", name)\n124|\t\t\t}\n125|\t\t\tif !plant.reject && len(violations) != 0 {\n126|\t\t\t\tt.Fatalf(\"plant %s rejected: %v\", name, violations)\n127|\t\t\t}\n128|\t\t})\n129|\t}\n130|}\n131|\n132|// TestLeaseTokenUnforgeableOutsidePackage proves the seal cannot be\n133|// spelled from outside: a fixture package that assembles a LeaseToken\n134|// by field name fails to build, while a fixture that uses only the\n135|// public Authorize/Bind surface builds cleanly.\n136|func TestLeaseTokenUnforgeableOutsidePackage(t *testing.T) {\n137|\t_, file, _, ok := runtime.Caller(0)\n138|\tif !ok {\n139|\t\tt.Fatal(\"cannot locate test file\")\n140|\t}\n141|\tdir := filepath.Dir(file)\n142|\tbuild := func(t *testing.T, target string) (int, string) {\n143|\t\tt.Helper()\n144|\t\tcommand := exec.Command(\"go\", \"build\", target)\n145|\t\tcommand.Dir = filepath.Join(dir, \"..\", \"..\")\n146|\t\toutput, err := command.CombinedOutput()\n147|\t\tif err == nil {\n148|\t\t\treturn 0, string(output)\n149|\t\t}\n150|\t\texit, ok := err.(*exec.ExitError)\n151|\t\tif !ok {\n152|\t\t\tt.Fatalf(\"go build %s: %v\", target, err)\n153|\t\t}\n154|\t\treturn exit.ExitCode(), string(output)\n155|\t}\n156|\tif code, output := build(t, \"./internal/fencing/testdata/use\"); code != 0 {\n157|\t\tt.Fatalf(\"public-surface fixture fails to build (exit %d): %s\", code, output)\n158|\t}\n159|\tcode, output := build(t, \"./internal/fencing/testdata/forge\")\n160|\tif code == 0 {\n161|\t\tt.Fatal(\"forgery fixture builds, want a compile failure on the unexported seal\")\n162|\t}\n163|\tif !strings.Contains(output, \"seal\") && !strings.Contains(output, \"unknown field\") {\n164|\t\tt.Fatalf(\"forgery build fails without naming the seal (exit %d): %s\", code, output)\n165|\t}\n166|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c945","stream":{"kind":"session","id":"01a0b2ff-60d1-7b92-bcfc-8a4c766633f3"},"sequence":765,"recorded_at":1780531400001525,"record_type":"event","durability":"durable","causation_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","run_stream":{"kind":"run","id":"b5be48e9-caa3-42a3-a29a-786d769c2b71"},"call_id":"call_01a0b3030e877724a1f0368b9489899e","text":"Read text file `internal/fencing/ownership_properties_test.go`.\n1|package fencing\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"testing\"\n6|\t\"time\"\n7|)\n8|\n9|// Ownership gate properties (TASK-260830-2atgj4): the gate halves of\n10|// invariants 3 (clock non-authority) and 4 (zero duplicate authorized\n11|// owners) over the landed Authorize* entries. The reducer halves live\n12|// in internal/sessstate, the store halves in internal/sessrepo.\n13|//\n14|// Clock bound: the absolute wall-clock position is non-authoritative;\n15|// the fencing-grant AGE relative to the refresh policy is\n16|// authoritative by design (sessrepo.CheckFencingExpiry). The property\n17|// therefore translates (ValidatedAt, Now) together and asserts\n18|// identical verdicts at a fixed age, including a lapsed age and the\n19|// exact interval boundary. PresentedToken and Observation carry no\n20|// created_at member, so lease creation time is non-authoritative by\n21|// construction.\n22|\n23|// propLeaseLow is a valid fencing token sorting below the winning\n24|// lease A: the below-winner half of the same-epoch loser pair.\n25|const propLeaseLow = \"00000000-1111-4000-8000-000000000001\"\n26|\n27|// propVerdict encodes an Authorize outcome for invariance\n28|// comparison: authorized, refused with its Section 15 class, or\n29|// parked with the session.parked reason, the cause class, and the\n30|// repeated winning lease.\n31|func propVerdict(err error) string {\n32|\tif err == nil {\n33|\t\treturn \"authorized\"\n34|\t}\n35|\tclasses := []error{ErrLeaseConflict, ErrNotOwner, ErrStaleOwner, ErrInvalidArguments, ErrLocalPreconditionFailed}\n36|\tclassOf := func() string {\n37|\t\tfor _, class := range classes {\n38|\t\t\tif errors.Is(err, class) {\n39|\t\t\t\treturn class.Error()\n40|\t\t\t}\n41|\t\t}\n42|\t\treturn \"unknown\"\n43|\t}\n44|\tif reason, leaseID, ok := ParkDetails(err); ok {\n45|\t\treturn \"parked:\" + string(reason) + \"/\" + classOf() + \"/\" + leaseID\n46|\t}\n47|\treturn \"refused:\" + classOf()\n48|}\n49|\n50|// TestOwnershipGateClockNonAuthority proves invariant 3 over the\n51|// gates: translating the wall clock by -1h, 0, +1h, or +365d with\n52|// the grant age fixed leaves every verdict — authorized, refused\n53|// with its class, or parked with its reason — identical across all\n54|// five operations. Ages cover fresh (30s), the exact interval\n55|// boundary (60s, still current), zero (Now == ValidatedAt), and\n56|// lapsed (61s). 4 ages x 4 translations x 5 operations = 80\n57|// authorizations.\n58|func TestOwnershipGateClockNonAuthority(t *testing.T) {\n59|\ttranslations := []time.Duration{-time.Hour, 0, time.Hour, 365 * 24 * time.Hour}\n60|\tages := []time.Duration{0, 30 * time.Second, time.Minute, time.Minute + time.Second}\n61|\tentries := fenceEntries()\n62|\tfor _, age := range ages {\n63|\t\tfor name, entry := range entries {\n64|\t\t\tvar baseline string\n65|\t\t\tvar first bool\n66|\t\t\tfor _, delta := range translations {\n67|\t\t\t\tobservation := fenceObservation()\n68|\t\t\t\tobservation.Grant.ValidatedAt = fenceValidatedAt.Add(delta)\n69|\t\t\t\tobservation.Now = fenceValidatedAt.Add(delta).Add(age)\n70|\t\t\t\ttoken, err := entry.authorize(fencePresented(), observation)\n71|\t\t\t\tgot := propVerdict(err)\n72|\t\t\t\tif err == nil {\n73|\t\t\t\t\tmustMint(t, token, err, name)\n74|\t\t\t\t}\n75|\t\t\t\tif !first {\n76|\t\t\t\t\tbaseline, first = got, true\n77|\t\t\t\t\tcontinue\n78|\t\t\t\t}\n79|\t\t\t\tif got != baseline {\n80|\t\t\t\t\tt.Fatalf(\"op %s age %v translation %v: verdict %q, want translation-invariant %q\",\n81|\t\t\t\t\t\tname, age, delta, got, baseline)\n82|\t\t\t\t}\n83|\t\t\t}\n84|\t\t\t// The age classes themselves are pinned: a current\n85|\t\t\t// grant authorizes, a lapsed grant refuses\n86|\t\t\t// lease_conflict on every entry including launch.\n87|\t\t\twant := \"authorized\"\n88|\t\t\tif age > fencePolicy.RefreshInterval {\n89|\t\t\t\twant = \"refused:lease_conflict\"\n90|\t\t\t}\n91|\t\t\tif baseline != want {\n92|\t\t\t\tt.Fatalf(\"op %s age %v: verdict %q, want %q\", name, age, baseline, want)\n93|\t\t\t}\n94|\t\t}\n95|\t}\n96|\tt.Logf(\"gate-clock: %d ages x %d translations x %d operations, verdicts translation-invariant\",\n97|\t\tlen(ages), len(translations), len(entries))\n98|}\n99|\n100|// TestOwnershipGateSingleAuthorizedOwner proves invariant 4 over the\n101|// gates: across the presenter grid (exact winner, stale epoch,\n102|// below- and above-winner same-epoch losers, future epoch, foreign\n103|// session) exactly one presenter authorizes per operation — the exact\n104|// winning tuple on the holder's host — and no two distinct\n105|// presenters, hosts, or processes ever both pass an\n106|// activation-class gate for the same session. 6 presenters x 5\n107|// observations x 5 operations = 150 authorizations, exhaustive.\n108|func TestOwnershipGateSingleAuthorizedOwner(t *testing.T) {\n109|\tpresenters := map[string]PresentedToken{\n110|\t\t\"exact\":      fencePresented(),\n111|\t\t\"stale\":      {SessionID: fenceSessionA, Epoch: 1, LeaseID: fenceLeaseOld},\n112|\t\t\"loser_low\":  {SessionID: fenceSessionA, Epoch: 2, LeaseID: propLeaseLow},\n113|\t\t\"loser_high\": {SessionID: fenceSessionA, Epoch: 2, LeaseID: fenceLeaseC},\n114|\t\t\"future\":     {SessionID: fenceSessionA, Epoch: 9, LeaseID: fenceLeaseA},\n115|\t\t\"foreign\":    {SessionID: fenceSessionB, Epoch: 2, LeaseID: fenceLeaseA},\n116|\t}\n117|\tlocal := fenceObservation()\n118|\tremote := fenceObservation()\n119|\tremote.LocalHostID = fenceHostB\n120|\tambiguous := fenceObservation()\n121|\tambiguous.Ambiguous = true\n122|\tfailed := fenceObservation()\n123|\tfailed.HandoffFailed = true\n124|\tunverified := fenceObservation()\n125|\tunverified.Verified = false\n126|\tobservations := map[string]Observation{\n127|\t\t\"local\": local, \"remote\": remote,\n128|\t\t\"ambiguous\": ambiguous, \"failed_handoff\": failed, \"unverified\": unverified,\n129|\t}\n130|\t// verdicts[observation][operation][presenter] is the recorded\n131|\t// table every assertion below reads.\n132|\tverdicts := map[string]map[string]map[string]string{}\n133|\tentries := fenceEntries()\n134|\tfor obsName, observation := range observations {\n135|\t\tverdicts[obsName] = map[string]map[string]string{}\n136|\t\tfor opName, entry := range entries {\n137|\t\t\tverdicts[obsName][opName] = map[string]string{}\n138|\t\t\tfor presenterName, presented := range presenters {\n139|\t\t\t\ttoken, err := entry.authorize(presented, observation)\n140|\t\t\t\tverdicts[obsName][opName][presenterName] = propVerdict(err)\n141|\t\t\t\tif err == nil {\n142|\t\t\t\t\tmustMint(t, token, err, obsName+\"/\"+opName+\"/\"+presenterName)\n143|\t\t\t\t}\n144|\t\t\t}\n145|\t\t}\n146|\t}\n147|\t// The local holder's table is pinned cell by cell: the exact\n148|\t// winner authorizes on every operation; every other presenter\n149|\t// parks or refuses with its landed class.\n150|\twantLocal := map[string]map[string]string{\n151|\t\t\"exact\": {\n152|\t\t\t\"activation\": \"authorized\", \"input\": \"authorized\", \"mutation\": \"authorized\",\n153|\t\t\t\"checkpoint\": \"authorized\", \"restore\": \"authorized\",\n154|\t\t},\n155|\t\t\"stale\": {\n156|\t\t\t\"activation\": \"parked:stale_owner/stale_owner/\" + fenceLeaseA,\n157|\t\t\t\"restore\":    \"parked:stale_owner/stale_owner/\" + fenceLeaseA,\n158|\t\t\t\"input\":      \"refused:stale_owner\", \"mutation\": \"refused:stale_owner\",\n159|\t\t\t\"checkpoint\": \"refused:stale_owner\",\n160|\t\t},\n161|\t\t\"loser_low\": {\n162|\t\t\t\"activation\": \"parked:stale_owner/lease_conflict/\" + fenceLeaseA,\n163|\t\t\t\"restore\":    \"parked:stale_owner/lease_conflict/\" + fenceLeaseA,\n164|\t\t\t\"input\":      \"refused:lease_conflict\", \"mutation\": \"refused:lease_conflict\",\n165|\t\t\t\"checkpoint\": \"refused:lease_conflict\",\n166|\t\t},\n167|\t\t\"future\": {\n168|\t\t\t\"activation\": \"parked:restore_policy/lease_conflict/\" + fenceLeaseA,\n169|\t\t\t\"restore\":    \"parked:restore_policy/lease_conflict/\" + fenceLeaseA,\n170|\t\t\t\"input\":      \"refused:lease_conflict\", \"mutation\": \"refused:lease_conflict\",\n171|\t\t\t\"checkpoint\": \"refused:lease_conflict\",\n172|\t\t},\n173|\t\t\"foreign\": {\n174|\t\t\t\"activation\": \"refused:lease_conflict\", \"input\": \"refused:lease_conflict\",\n175|\t\t\t\"mutation\": \"refused:lease_conflict\", \"checkpoint\": \"refused:lease_conflict\",\n176|\t\t\t\"restore\": \"refused:lease_conflict\",\n177|\t\t},\n178|\t}\n179|\twantLocal[\"loser_high\"] = wantLocal[\"loser_low\"]\n180|\tfor presenterName, ops := range wantLocal {\n181|\t\tfor opName, want := range ops {\n182|\t\t\tif got := verdicts[\"local\"][opName][presenterName]; got != want {\n183|\t\t\t\tt.Fatalf(\"local/%s/%s verdict = %q, want %q\", opName, presenterName, got, want)\n184|\t\t\t}\n185|\t\t}\n186|\t}\n187|\t// Exactly one presenter authorizes per local operation; none\n188|\t// authorizes anywhere else.\n189|\tfor opName := range entries {\n190|\t\tauthorized := 0\n191|\t\tfor presenterName := range presenters {\n192|\t\t\tif verdicts[\"local\"][opName][presenterName] == \"authorized\" {\n193|\t\t\t\tauthorized++\n194|\t\t\t}\n195|\t\t}\n196|\t\tif authorized != 1 {\n197|\t\t\tt.Fatalf(\"local/%s authorizes %d presenters, want exactly one\", opName, authorized)\n198|\t\t}\n199|\t\tfor _, obsName := range []string{\"remote\", \"ambiguous\", \"failed_handoff\", \"unverified\"} {\n200|\t\t\tfor presenterName := range presenters {\n201|\t\t\t\tif verdicts[obsName][opName][presenterName] == \"authorized\" {\n202|\t\t\t\t\tt.Fatalf(\"%s/%s/%s authorizes, want no authorization off the local verified winner\",\n203|\t\t\t\t\t\tobsName, opName, presenterName)\n204|\t\t\t\t}\n205|\t\t\t}\n206|\t\t}\n207|\t}\n208|\t// The remote holder parks remote_owner (launch) or refuses\n209|\t// not_owner (non-launch) even for the exact token: two hosts can\n210|\t// never both pass.\n211|\tfor opName, entry := range entries {\n212|\t\twant := \"refused:not_owner\"\n213|\t\tif entry.launch {\n214|\t\t\twant = \"parked:remote_owner/not_owner/\" + fenceLeaseA\n215|\t\t}\n216|\t\tif got := verdicts[\"remote\"][opName][\"exact\"]; got != want {\n217|\t\t\tt.Fatalf(\"remote/%s/exact verdict = %q, want %q\", opName, got, want)\n218|\t\t}\n219|\t}\n220|\t// Pairwise mutual exclusion over the recorded table: no two\n221|\t// distinct presenters both authorize in any observation and\n222|\t// operation (two processes), and no presenter authorizes under\n223|\t// both host perspectives (two hosts).\n224|\tnames := []string{\"exact\", \"stale\", \"loser_low\", \"loser_high\", \"future\", \"foreign\"}\n225|\tfor obsName := range observations {\n226|\t\tfor opName := range entries {\n227|\t\t\tfor i := 0; i < len(names); i++ {\n228|\t\t\t\tfor j := i + 1; j < len(names); j++ {\n229|\t\t\t\t\tif verdicts[obsName][opName][names[i]] == \"authorized\" &&\n230|\t\t\t\t\t\tverdicts[obsName][opName][names[j]] == \"authorized\" {\n231|\t\t\t\t\t\tt.Fatalf(\"%s/%s authorizes both %s and %s; at most one owner may pass\",\n232|\t\t\t\t\t\t\tobsName, opName, names[i], names[j])\n233|\t\t\t\t\t}\n234|\t\t\t\t}\n235|\t\t\t}\n236|\t\t}\n237|\t}\n238|\tfor _, presenterName := range names {\n239|\t\tfor opName := range entries {\n240|\t\t\tif verdicts[\"local\"][opName][presenterName] == \"authorized\" &&\n241|\t\t\t\tverdicts[\"remote\"][opName][presenterName] == \"authorized\" {\n242|\t\t\t\tt.Fatalf(\"%s/%s authorizes on both hosts; two hosts must never both pass\", opName, presenterName)\n243|\t\t\t}\n244|\t\t}\n245|\t}\n246|\tt.Logf(\"gate-single-owner: %d presenters x %d observations x %d operations, exactly one authorizes per local operation\",\n247|\t\tlen(presenters), len(observations), len(entries))\n248|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
