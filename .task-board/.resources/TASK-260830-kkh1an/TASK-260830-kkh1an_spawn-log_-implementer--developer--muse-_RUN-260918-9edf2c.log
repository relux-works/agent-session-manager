{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7e3","stream":{"kind":"session","id":"01a0b2ff-60d1-7b92-bcfc-8a4c766633f3"},"sequence":588,"recorded_at":1780531400001171,"record_type":"event","durability":"durable","causation_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","run_stream":{"kind":"run","id":"b5be48e9-caa3-42a3-a29a-786d769c2b71"},"task_stream":{"kind":"task","id":"01a0b300-f37d-7ff3-bd77-307859f4fd12"},"task_id":"01a0b300-f37d-7ff3-bd77-307859f4fd12","event":{"kind":"output","task_id":"01a0b300-f37d-7ff3-bd77-307859f4fd12","chunk":"Read text file `internal/terminstance/mutant_harness.py`.\n(999 line(s) above)\n1000|    ),\n1001|    Mutant(\n1002|        name=\"N-resume-complete-key\",\n1003|        path=f\"{PACKAGE}/execute.go\",\n1004|        find=\"\\tif err := engine.Store.Complete(key, encoded); err != nil {\\n\",\n1005|        replace='\\tif err := engine.Store.Complete(key+\"/resumed\", encoded); err != nil {\\n',\n1006|        count=1,\n1007|        run=\"TestExecuteIdenticalRetryReplays\",\n1008|        expect=\"KILLED\",\n1009|        note=\"Records the completion under exactly a second key instead of the bound one; the identical retry then reconciles instead of replaying.\",\n1010|    ),\n1011|    Mutant(\n1012|        name=\"N-resume-generation-value\",\n1013|        path=f\"{PACKAGE}/execute.go\",\n1014|        find='\\t\\tBackendGeneration:          context.BackendGeneration,\\n',\n1015|        replace='\\t\\tBackendGeneration:          \"\",\\n',\n1016|        count=1,\n1017|        run=\"TestExecuteUncertainRetryResumesWhenStatusProvesSource\",\n1018|        expect=\"KILLED\",\n1019|        note=\"Reconciles with exactly an empty generation instead of the request generation; the proof then mismatches and the resumption never proceeds.\",\n1020|    ),\n1021|    Mutant(\n1022|        name=\"N-engine-bind-prelink\",\n1023|        path=f\"{PACKAGE}/execute.go\",\n1024|        find=\"\\t\\t\\tif _, found, lookupErr := engine.Store.Lookup(key); lookupErr == nil && !found {\\n\",\n1025|        replace=\"\\t\\t\\tif _, found, lookupErr := engine.Store.Lookup(key); lookupErr == nil && !found && operation != terminalbackend.OperationQuiesceInput {\\n\",\n1026|        count=1,\n1027|        run=\"TestExecutePreLinkStoreFailureRestoresSource\",\n1028|        expect=\"KILLED\",\n1029|        note=\"Restores the source on a pre-link store failure for every row except exactly quiesce-input; the quiesce row then fences unavailable.\",\n1030|    ),\n1031|    Mutant(\n1032|        name=\"N-engine-bind-postlink\",\n1033|        path=f\"{PACKAGE}/execute.go\",\n1034|        find=\"\\t\\t\\tif _, found, lookupErr := engine.Store.Lookup(key); lookupErr == nil && !found {\\n\",\n1035|        replace=\"\\t\\t\\tif _, _, lookupErr := engine.Store.Lookup(key); lookupErr == nil {\\n\",\n1036|        count=1,\n1037|        run=\"TestExecuteHookErrorRetryReconcilesThroughStatus/standing_receipt_is_uncertain\",\n1038|        expect=\"KILLED\",\n1039|        note=\"Restores the source for exactly standing receipts as well as for nothing-durable; the hook-error commit then restores instead of fencing uncertain.\",\n1040|    ),\n1041|    Mutant(\n1042|        name=\"C-control\",\n1043|        path=f\"{PACKAGE}/doc.go\",\n1044|        find=\"// Composition, not re-implementation: the eight-state enum, the ten-operation\\n\",\n1045|        replace=\"// Composition, not re-implementation (control): the eight-state enum, the ten-operation\\n\",\n1046|        count=1,\n1047|        run=\"TestRequiresProviderObservation\",\n1048|        expect=\"SURVIVED\",\n1049|        note=\"Harmless control: a comment-only edit must survive.\",\n1050|    ),\n1051|]\n1052|\n1053|\n1054|def run_mutant(mutant: Mutant) -> str:\n1055|    target = REPO / mutant.path\n1056|    original = target.read_text()\n1057|    found = original.count(mutant.find)\n1058|    if found != mutant.count:\n1059|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\"\n1060|    with tempfile.TemporaryDirectory() as staging:\n1061|        backup = Path(staging) / \"backup\"\n1062|        shutil.copy2(target, backup)\n1063|        try:\n1064|            target.write_text(original.replace(mutant.find, mutant.replace))\n1065|            run = subprocess.run(\n1066|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n1067|                cwd=REPO,\n1068|                capture_output=True,\n1069|                text=True,\n1070|                timeout=300,\n1071|            )\n1072|        finally:\n1073|            shutil.copy2(backup, target)\n1074|    output = (run.stdout + run.stderr).strip()\n1075|    if os.environ.get(\"AX_MUTANT_VERBOSE\") == \"1\":\n1076|        print(f\"--- raw: {mutant.name}: exit {run.returncode} ---\", flush=True)\n1077|        print(output, flush=True)\n1078|        print(f\"--- end raw: {mutant.name} ---\", flush=True)\n1079|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n1080|        return f\"ERROR: {mutant.name}: build broke under the patch\"\n1081|    if run.returncode == 0:\n1082|        verdict = \"SURVIVED\"\n1083|    elif '--- FAIL' in output or 'FAIL:' in output:\n1084|        verdict = \"KILLED\"\n1085|    else:\n1086|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\"\n1087|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n1088|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note} [exit {run.returncode}]\"\n1089|\n1090|\n1091|def main(argv: list[str]) -> int:\n1092|    selected = [m for m in MUTANTS if not argv or m.name in argv]\n1093|    if argv and len(selected) != len(argv):\n1094|        unknown = sorted(set(argv) - {m.name for m in selected})\n1095|        print(f\"unknown mutants: {', '.join(unknown)}\")\n1096|        return 2\n1097|    failures = 0\n1098|    for mutant in selected:\n1099|        try:\n1100|            line = run_mutant(mutant)\n1101|        except subprocess.TimeoutExpired:\n1102|            line = f\"ERROR: {mutant.name}: killer timed out\"\n1103|        print(line, flush=True)\n1104|        if not line.startswith(\"ok:\"):\n1105|            failures += 1\n1106|    return 1 if failures else 0\n1107|\n1108|\n1109|if __name__ == \"__main__\":\n1110|    sys.exit(main(sys.argv[1:]))","final_result":true}}}
