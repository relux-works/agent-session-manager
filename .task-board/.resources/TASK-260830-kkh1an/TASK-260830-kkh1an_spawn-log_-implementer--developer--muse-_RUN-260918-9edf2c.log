{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c77d","stream":{"kind":"session","id":"01a0b2ff-60d1-7b92-bcfc-8a4c766633f3"},"sequence":537,"recorded_at":1780531400001069,"record_type":"event","durability":"durable","causation_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","run_stream":{"kind":"run","id":"b5be48e9-caa3-42a3-a29a-786d769c2b71"},"task_stream":{"kind":"task","id":"01a0b300-d033-7c51-8cee-95015493be19"},"task_id":"01a0b300-d033-7c51-8cee-95015493be19","event":{"kind":"output","task_id":"01a0b300-d033-7c51-8cee-95015493be19","chunk":"Read text file `internal/terminstance/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/terminstance.\n3|\n4|Every gate ships a narrowing mutant: the gate stays present and is\n5|weakened to admit exactly one member of the class it must reject, and\n6|the named killer test must fail. A delete-only mutant proves only that\n7|the gate exists and is not accepted as evidence.\n8|\n9|Each row runs M (mutate one production file in place), R (run the\n10|scoped Go killer through the production entry point), V (verdict from\n11|the Go exit code plus a FAIL kill-line: KILLED iff R fails with a test\n12|failure line, SURVIVED iff R passes, ERROR for anything else —\n13|unapplied patches, build breaks, timeouts). M failures and R\n14|infrastructure errors are ERROR, never kills or survivals. The file is\n15|restored from its backup after every row, pass or fail.\n16|\n17|Row C-control is the harmless control: a comment-only edit that\n18|must SURVIVE, proving the harness observes test outcomes instead of\n19|hard-coding kills.\n20|\n21|Usage:\n22|  PYTHONDONTWRITEBYTECODE=1 python3 internal/terminstance/mutant_harness.py\n23|  PYTHONDONTWRITEBYTECODE=1 python3 internal/terminstance/mutant_harness.py N-auth-epoch-low\n24|\"\"\"\n25|\n26|import os\n27|import shutil\n28|import subprocess\n29|import sys\n30|import tempfile\n31|from dataclasses import dataclass\n32|from pathlib import Path\n33|\n34|REPO = Path(__file__).resolve().parents[2]\n35|PACKAGE = \"internal/terminstance\"\n36|\n37|\n38|@dataclass(frozen=True)\n39|class Mutant:\n40|    name: str\n41|    path: str\n42|    find: str\n43|    replace: str\n44|    count: int\n45|    run: str\n46|    expect: str\n47|    note: str\n48|\n49|\n50|MUTANTS = [\n51|    Mutant(\n52|        name=\"N-auth-epoch-low\",\n53|        path=f\"{PACKAGE}/auth.go\",\n54|        find='\\tleaseEpoch, ok := environ.CheckUint53Bounds(members[\"lease_epoch\"], 1, MaxLeaseEpoch)\\n',\n55|        replace='\\tleaseEpoch, ok := environ.CheckUint53Bounds(members[\"lease_epoch\"], 0, MaxLeaseEpoch)\\n',\n56|        count=1,\n57|        run=\"TestParseAXAuthorizationEpochBound\",\n58|        expect=\"KILLED\",\n59|        note=\"Admits exactly epoch 0; every other out-of-range epoch still refuses.\",\n60|    ),\n61|    Mutant(\n62|        name=\"N-auth-epoch-high\",\n63|        path=f\"{PACKAGE}/auth.go\",\n64|        find='\\tleaseEpoch, ok := environ.CheckUint53Bounds(members[\"lease_epoch\"], 1, MaxLeaseEpoch)\\n',\n65|        replace='\\tleaseEpoch, ok := environ.CheckUint53Bounds(members[\"lease_epoch\"], 1, MaxLeaseEpoch-1)\\n',\n66|        count=1,\n67|        run=\"TestParseAXAuthorizationEpochBound\",\n68|        expect=\"KILLED\",\n69|        note=\"TIGHTENING (the weakening direction is equivalent: environ refuses 2^53 at the number layer, so no weakening past MaxLeaseEpoch is observable; this row proves the edge is exactly 9007199254740991 by refusing it).\",\n70|    ),\n71|    Mutant(\n72|        name=\"N-auth-kind\",\n73|        path=f\"{PACKAGE}/auth.go\",\n74|        find='\\tdefault:\\n\\t\\treturn \"\", refuse(CodeProtocolError, \"ax authorization kind\")\\n\\t}\\n',\n75|        replace='\\tdefault:\\n\\t\\tif value == \"admin\" {\\n\\t\\t\\treturn AuthorizationControl, nil\\n\\t\\t}\\n\\t\\treturn \"\", refuse(CodeProtocolError, \"ax authorization kind\")\\n\\t}\\n',\n76|        count=1,\n77|        run=\"TestParseAXAuthorizationKindClosed\",\n78|        expect=\"KILLED\",\n79|        note=\"Admits exactly the admin kind; every other non-kind still refuses.\",\n80|    ),\n81|    Mutant(\n82|        name=\"N-auth-kind-binding\",\n83|        path=f\"{PACKAGE}/auth.go\",\n84|        find=\"\\tif auth.Kind != wantKind {\\n\",\n85|        replace=\"\\tif auth.Kind != wantKind && wantKind != AuthorizationCreate {\\n\",\n86|        count=1,\n87|        run=\"TestCheckAuthorizationRefusals/kind_mismatch\",\n88|        expect=\"KILLED\",\n89|        note=\"Admits exactly control authorizations presented as create; other mismatches still refuse.\",\n90|    ),\n91|    Mutant(\n92|        name=\"N-auth-expiry\",\n93|        path=f\"{PACKAGE}/auth.go\",\n94|        find=\"\\tif !now.Before(expires) {\\n\",\n95|        replace=\"\\tif !now.Before(expires) && !now.Equal(expires) {\\n\",\n96|        count=1,\n97|        run=\"TestCheckAuthorizationRefusals/expiry_edge_refuses\",\n98|        expect=\"KILLED\",\n99|        note=\"Admits exactly the expiry instant; past-expiry instants still refuse.\",\n100|    ),\n101|    Mutant(\n102|        name=\"N-auth-lease-id\",\n103|        path=f\"{PACKAGE}/auth.go\",\n104|        find=\"\\tif auth.LeaseID != lease.LeaseID {\\n\",\n105|        replace='\\tif auth.LeaseID != lease.LeaseID && lease.LeaseID != \"6ba7b810-9dad-41d1-80b4-00c04fd430c8\" {\\n',\n106|        count=1,\n107|        run=\"TestCheckAuthorizationRefusals/lease_identity_drift\",\n108|        expect=\"KILLED\",\n109|        note=\"Admits exactly the drifted test lease; other identity drifts still refuse.\",\n110|    ),\n111|    Mutant(\n112|        name=\"N-auth-lease-epoch\",\n113|        path=f\"{PACKAGE}/auth.go\",\n114|        find=\"\\tif auth.LeaseEpoch != lease.Epoch {\\n\",\n115|        replace=\"\\tif auth.LeaseEpoch != lease.Epoch && lease.Epoch != 2 {\\n\",\n116|        count=1,\n117|        run=\"TestCheckAuthorizationRefusals/lease_epoch_drift\",\n118|        expect=\"KILLED\",\n119|        note=\"Admits exactly the epoch-2 drift; other epoch drifts still refuse.\",\n120|    ),\n121|    Mutant(\n122|        name=\"N-auth-extra-member\",\n123|        path=f\"{PACKAGE}/auth.go\",\n124|        find=\"\\tif len(members) != len(axAuthorizationMembers) {\\n\",\n125|        replace=\"\\tif len(members) != len(axAuthorizationMembers) && len(members) != len(axAuthorizationMembers)+1 {\\n\",\n126|        count=1,\n127|        run=\"TestParseAXAuthorizationClosedShape\",\n128|        expect=\"KILLED\",\n129|        note=\"Admits exactly one-extra-member documents; other shapes still refuse.\",\n130|    ),\n131|    Mutant(\n132|        name=\"N-auth-expiry-order\",\n133|        path=f\"{PACKAGE}/auth.go\",\n134|        find=\"\\tif !expires.After(issued) {\\n\",\n135|        replace=\"\\tif expires.Before(issued) {\\n\",\n136|        count=1,\n137|        run=\"TestParseAXAuthorizationStrictExpiry\",\n138|        expect=\"KILLED\",\n139|        note=\"Admits exactly equal issue/expiry instants; inverted instants still refuse.\",\n140|    ),\n141|    Mutant(\n142|        name=\"N-disp-parse\",\n143|        path=f\"{PACKAGE}/disposition.go\",\n144|        find='\\tdefault:\\n\\t\\treturn \"\", refuse(CodeProtocolError, \"retry disposition vocabulary\")\\n\\t}\\n',\n145|        replace='\\tdefault:\\n\\t\\tif value == \"retry\" {\\n\\t\\t\\treturn DispositionReplaySame, nil\\n\\t\\t}\\n\\t\\treturn \"\", refuse(CodeProtocolError, \"retry disposition vocabulary\")\\n\\t}\\n',\n146|        count=1,\n147|        run=\"TestParseRetryDispositionClosed\",\n148|        expect=\"KILLED\",\n149|        note=\"Admits exactly the retry token; every other non-disposition still refuses.\",\n150|    ),\n151|    Mutant(\n152|        name=\"N-disp-unauthorized\",\n153|        path=f\"{PACKAGE}/disposition.go\",\n154|        find=\"\\tcase CodeUnauthorized:\\n\\t\\treturn DispositionNewAuthorization\\n\",\n155|        replace=\"\\tcase CodeUnauthorized:\\n\\t\\tif committed {\\n\\t\\t\\treturn DispositionStatusFirst\\n\\t\\t}\\n\\t\\treturn DispositionNewAuthorization\\n\",\n156|        count=1,\n157|        run=\"TestDispositionForMapping\",\n158|        expect=\"KILLED\",\n159|        note=\"Maps exactly committed unauthorized to status_first; uncommitted still maps new_authorization.\",\n160|    ),\n161|    Mutant(\n162|        name=\"N-disp-timeout\",\n163|        path=f\"{PACKAGE}/disposition.go\",\n164|        find=\"\\tcase CodeTimeout, CodeQuiesceTimeout:\\n\\t\\tif committed {\\n\\t\\t\\treturn DispositionStatusFirst\\n\\t\\t}\\n\\t\\treturn DispositionReplaySame\\n\",\n165|        replace=\"\\tcase CodeTimeout, CodeQuiesceTimeout:\\n\\t\\tif committed {\\n\\t\\t\\treturn DispositionStatusFirst\\n\\t\\t}\\n\\t\\tif code == CodeQuiesceTimeout {\\n\\t\\t\\treturn DispositionStatusFirst\\n\\t\\t}\\n\\t\\treturn DispositionReplaySame\\n\",\n166|        count=1,\n167|        run=\"TestDispositionForMapping\",\n168|        expect=\"KILLED\",\n169|        note=\"Maps exactly uncommitted quiesce_timeout to status_first; terminal_backend_timeout still replays.\",\n170|    ),\n171|    Mutant(\n172|        name=\"N-disp-stop\",\n173|        path=f\"{PACKAGE}/disposition.go\",\n174|        find=\"\\tcase CodeStopTimeout, CodeIdempotencyMismatch, CodeStaleGeneration,\\n\\t\\tCodePreconditionFailed, CodeUnavailable:\\n\",\n175|        replace=\"\\tcase CodeIdempotencyMismatch, CodeStaleGeneration,\\n\\t\\tCodePreconditionFailed, CodeUnavailable:\\n\",\n176|        count=1,\n177|        run=\"TestDispositionForMapping\",\n178|        expect=\"KILLED\",\n179|        note=\"Drops exactly stop_timeout from the status-first group; other members still map there.\",\n180|    ),\n181|    Mutant(\n182|        name=\"N-disp-default\",\n183|        path=f\"{PACKAGE}/disposition.go\",\n184|        find=\"\\tdefault:\\n\\t\\tif committed {\\n\\t\\t\\treturn DispositionStatusFirst\\n\\t\\t}\\n\\t\\treturn DispositionRequiredOperatorAction\\n\\t}\\n\",\n185|        replace=\"\\tdefault:\\n\\t\\tif committed {\\n\\t\\t\\treturn DispositionStatusFirst\\n\\t\\t}\\n\\t\\tif code == CodeCapabilityUnproven {\\n\\t\\t\\treturn DispositionReplaySame\\n\\t\\t}\\n\\t\\treturn DispositionRequiredOperatorAction\\n\\t}\\n\",\n186|        count=1,\n187|        run=\"TestDispositionForMapping\",\n188|        expect=\"KILLED\",\n189|        note=\"Maps exactly uncommitted capability_unproven to replay_same; the rest still stop automation.\",\n190|    ),\n191|    Mutant(\n192|        name=\"N-proof-vocab\",\n193|        path=f\"{PACKAGE}/proof.go\",\n194|        find='\\tdefault:\\n\\t\\treturn \"\", refuse(CodeProtocolError, \"provider proof vocabulary\")\\n\\t}\\n',\n195|        replace='\\tdefault:\\n\\t\\tif value == \"provider_restart\" {\\n\\t\\t\\treturn ProofProviderQuiescence, nil\\n\\t\\t}\\n\\t\\treturn \"\", refuse(CodeProtocolError, \"provider proof vocabulary\")\\n\\t}\\n',\n196|        count=1,\n197|        run=\"TestParseProviderProofKindClosed\",\n198|        expect=\"KILLED\",\n199|        note=\"Admits exactly the provider_restart token; every other non-kind still refuses.\",\n200|    ),\n201|    Mutant(\n202|        name=\"N-proof-provider\",\n203|        path=f\"{PACKAGE}/proof.go\",\n204|        find=\"\\tcase ProofProviderQuiescence, ProofProviderProcessExit:\\n\\t\\treturn true\\n\",\n205|        replace=\"\\tcase ProofProviderQuiescence, ProofProviderProcessExit, ProofAXCheckpointBoundary:\\n\\t\\treturn true\\n\",\n206|        count=1,\n207|        run=\"TestRequiresProviderObservation\",\n208|        expect=\"KILLED\",\n209|        note=\"Classifies exactly the AX boundary as a provider kind; other classifications stay.\",\n210|    ),\n211|    Mutant(\n212|        name=\"N-context-key\",\n213|        path=f\"{PACKAGE}/context.go\",\n214|   