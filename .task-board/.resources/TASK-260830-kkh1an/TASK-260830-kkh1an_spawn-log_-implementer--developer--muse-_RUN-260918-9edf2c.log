{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca17","stream":{"kind":"session","id":"01a0b2ff-60d1-7b92-bcfc-8a4c766633f3"},"sequence":870,"recorded_at":1780531400001735,"record_type":"event","durability":"durable","causation_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","run_stream":{"kind":"run","id":"b5be48e9-caa3-42a3-a29a-786d769c2b71"},"call_id":"call_01a0b3035a8c74f19d2e1b2d8e2175e7","text":"Read text file `internal/terminstance/create_gates_test.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"testing\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n7|)\n8|\n9|// TestExecuteCreateEntryAuthorizationRefuses proves the create row's\n10|// entry authorization gate through the production entry: a control-kind,\n11|// an expired, and a foreign-lease authorization each refuse before any\n12|// receipt is bound — binding one would poison the\n13|// (session_id, bootstrap_operation_id) key — with no side effect.\n14|func TestExecuteCreateEntryAuthorizationRefuses(t *testing.T) {\n15|\tt.Run(\"control kind presented as create\", func(t *testing.T) {\n16|\t\tcreate := testCreateContext(t)\n17|\t\tcreate.context.Authorization = testAuth(t)\n18|\t\tbackend := newMockBackend()\n19|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n20|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, create.context, create.params, mustParseState(t, \"absent\"), testAdmitted(\"terminal_state_retention\"))\n21|\t\trequireRefusal(t, err, \"terminal_backend_unauthorized\", \"ax authorization kind binding\")\n22|\t\trequireLiteral(t, \"after\", string(result.After), \"absent\")\n23|\t\trequireLiteral(t, \"disposition\", string(result.Disposition), \"new_authorization\")\n24|\t\tif len(backend.performed()) != 0 {\n25|\t\t\tt.Errorf(\"performed = %v, want no effects on the unauthorized create\", backend.performed())\n26|\t\t}\n27|\t\tif _, found, _ := engine.Store.Lookup(create.context.IdempotencyKey); found {\n28|\t\t\tt.Error(\"Lookup(key) found a receipt for the unauthorized create, want none bound\")\n29|\t\t}\n30|\t})\n31|\tt.Run(\"expired\", func(t *testing.T) {\n32|\t\tcreate := testCreateContext(t)\n33|\t\tbackend := newMockBackend()\n34|\t\tengine := testEngine(t, backend, testLease(), fixtureGen)\n35|\t\tengine.Now = fixtureLater\n36|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, create.context, create.params, mustParseState(t, \"absent\"), testAdmitted(\"terminal_state_retention\"))\n37|\t\trequireRefusal(t, err, \"terminal_backend_unauthorized\", \"ax authorization expiry\")\n38|\t\trequireLiteral(t, \"after\", string(result.After), \"absent\")\n39|\t\tif len(backend.performed()) != 0 {\n40|\t\t\tt.Errorf(\"performed = %v, want no effects on the expired create\", backend.performed())\n41|\t\t}\n42|\t\tif _, found, _ := engine.Store.Lookup(create.context.IdempotencyKey); found {\n43|\t\t\tt.Error(\"Lookup(key) found a receipt for the expired create, want none bound\")\n44|\t\t}\n45|\t})\n46|\tt.Run(\"foreign lease\", func(t *testing.T) {\n47|\t\tcreate := testCreateContext(t)\n48|\t\tbackend := newMockBackend()\n49|\t\tengine := testEngine(t, backend, LeaseView{LeaseID: fixtureLeaseB, Epoch: 1}, fixtureGen)\n50|\t\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, create.context, create.params, mustParseState(t, \"absent\"), testAdmitted(\"terminal_state_retention\"))\n51|\t\trequireRefusal(t, err, \"terminal_backend_unauthorized\", \"ax authorization lease identity\")\n52|\t\trequireLiteral(t, \"after\", string(result.After), \"absent\")\n53|\t\tif len(backend.performed()) != 0 {\n54|\t\t\tt.Errorf(\"performed = %v, want no effects under the foreign lease\", backend.performed())\n55|\t\t}\n56|\t\tif _, found, _ := engine.Store.Lookup(create.context.IdempotencyKey); found {\n57|\t\t\tt.Error(\"Lookup(key) found a receipt for the foreign-lease create, want none bound\")\n58|\t\t}\n59|\t})\n60|}\n61|\n62|// TestExecuteCreateEntryGenerationRefuses proves the create row's entry\n63|// generation gate: a stale generation refuses before any receipt is\n64|// bound, with the landed stale class.\n65|func TestExecuteCreateEntryGenerationRefuses(t *testing.T) {\n66|\tcreate := testCreateContext(t)\n67|\tbackend := newMockBackend()\n68|\tengine := testEngine(t, backend, testLease(), \"generation-two\")\n69|\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, create.context, create.params, mustParseState(t, \"absent\"), testAdmitted(\"terminal_state_retention\"))\n70|\trequireRefusal(t, err, \"terminal_backend_stale_generation\", \"backend_generation stale\")\n71|\trequireLiteral(t, \"after\", string(result.After), \"absent\")\n72|\trequireLiteral(t, \"disposition\", string(result.Disposition), \"status_first\")\n73|\tif len(backend.performed()) != 0 {\n74|\t\tt.Errorf(\"performed = %v, want no effects under the stale generation\", backend.performed())\n75|\t}\n76|\tif _, found, _ := engine.Store.Lookup(create.context.IdempotencyKey); found {\n77|\t\tt.Error(\"Lookup(key) found a receipt for the stale create, want none bound\")\n78|\t}\n79|}\n80|\n81|// TestExecuteCreateHeadlessFromAbsentNeedsCapability proves the\n82|// headless_creation conditional exactly at the absent source: a\n83|// headless create from absent without the capability refuses with no\n84|// effect and no receipt, while the same create with the capability\n85|// admitted parks.\n86|func TestExecuteCreateHeadlessFromAbsentNeedsCapability(t *testing.T) {\n87|\theadless := testCreateContext(t)\n88|\theadless.params.Interactive = false\n89|\tbackend := newMockBackend()\n90|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n91|\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, headless.context, headless.params, mustParseState(t, \"absent\"), testAdmitted(\"terminal_state_retention\"))\n92|\trequireRefusal(t, err, \"terminal_backend_capability_unproven\", \"operation capability conditional\")\n93|\trequireLiteral(t, \"after\", string(result.After), \"absent\")\n94|\tif len(backend.performed()) != 0 {\n95|\t\tt.Errorf(\"performed = %v, want no effects without headless_creation\", backend.performed())\n96|\t}\n97|\tif _, found, _ := engine.Store.Lookup(headless.context.IdempotencyKey); found {\n98|\t\tt.Error(\"Lookup(key) found a receipt for the unproven headless create, want none bound\")\n99|\t}\n100|\n101|\tadmitted := testCreateContext(t)\n102|\tadmitted.params.Interactive = false\n103|\tbackendAdmitted := newMockBackend()\n104|\tengineAdmitted := testEngine(t, backendAdmitted, testLease(), fixtureGen)\n105|\tparked, err := engineAdmitted.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, admitted.context, admitted.params, mustParseState(t, \"absent\"), testAdmitted(\"headless_creation\"))\n106|\tif err != nil {\n107|\t\tt.Fatalf(\"ExecuteMutating(headless with headless_creation) error = %v\", err)\n108|\t}\n109|\trequireLiteral(t, \"after\", string(parked.After), \"parked\")\n110|}\n111|\n112|// TestExecuteCreateCommittedTimeoutReportsStatusFirst proves create's\n113|// second-effect committed timeout: binding_persisted committed, then\n114|// wrapper_started reports terminal_backend_timeout, so the local\n115|// observation moves to unavailable with status_first.\n116|func TestExecuteCreateCommittedTimeoutReportsStatusFirst(t *testing.T) {\n117|\tcreate := testCreateContext(t)\n118|\tbackend := newMockBackend()\n119|\tbackend.effectErrors[terminalbackend.EffectWrapperStarted] = refuse(\"terminal_backend_timeout\", \"test wrapper timeout\")\n120|\tengine := testEngine(t, backend, testLease(), fixtureGen)\n121|\tresult, err := engine.ExecuteMutating(contextGo(), terminalbackend.OperationCreate, create.context, create.params, mustParseState(t, \"absent\"), testAdmitted(\"terminal_state_retention\"))\n122|\trequireRefusal(t, err, \"terminal_backend_timeout\", \"backend effect refused\")\n123|\trequireLiteral(t, \"after\", string(result.After), \"unavailable\")\n124|\trequireLiteral(t, \"disposition\", string(result.Disposition), \"status_first\")\n125|\tperformed := backend.performed()\n126|\tif len(performed) != 2 || performed[0] != terminalbackend.EffectBindingPersisted || performed[1] != terminalbackend.EffectWrapperStarted {\n127|\t\tt.Errorf(\"performed = %v, want [binding_persisted wrapper_started] (first committed, second attempted)\", performed)\n128|\t}\n129|\tif len(result.Effects) != 1 || result.Effects[0] != terminalbackend.EffectBindingPersisted {\n130|\t\tt.Errorf(\"result effects = %v, want exactly the committed [binding_persisted] prefix\", result.Effects)\n131|\t}\n132|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
