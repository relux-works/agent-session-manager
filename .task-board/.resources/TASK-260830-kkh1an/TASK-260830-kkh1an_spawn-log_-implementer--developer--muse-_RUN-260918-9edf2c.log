{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c701","stream":{"kind":"session","id":"01a0b2ff-60d1-7b92-bcfc-8a4c766633f3"},"sequence":475,"recorded_at":1780531400000945,"record_type":"event","durability":"durable","causation_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","run_stream":{"kind":"run","id":"b5be48e9-caa3-42a3-a29a-786d769c2b71"},"task_stream":{"kind":"task","id":"01a0b300-b663-7013-8050-2cb6ef39ed22"},"task_id":"01a0b300-b663-7013-8050-2cb6ef39ed22","event":{"kind":"output","task_id":"01a0b300-b663-7013-8050-2cb6ef39ed22","chunk":"Read text file `internal/terminstance/execute.go`.\n(499 line(s) above)\n500|\t}\n501|\tif !engine.Now().Before(deadline) {\n502|\t\treturn empty, refuse(CodeTimeout, \"operation deadline\")\n503|\t}\n504|\tif body.IncludeProviderObservation && !admitted.Has(\"provider_process_observation\") {\n505|\t\treturn empty, refuse(CodeCapabilityUnproven, \"operation capability conditional\")\n506|\t}\n507|\tobserved, err := engine.Backend.ObserveStatus(ctx, body)\n508|\tif err != nil {\n509|\t\tcode := ErrorCode(err)\n510|\t\tif code == \"\" {\n511|\t\t\treturn empty, refuse(CodeUnavailable, \"status observation unknown\")\n512|\t\t}\n513|\t\tif err := terminalbackend.CheckErrorAllowed(string(terminalbackend.OperationStatus), code); err != nil {\n514|\t\t\treturn empty, refuse(CodeProtocolError, \"operation error vocabulary\")\n515|\t\t}\n516|\t\treturn empty, refuse(code, \"status observation unknown\")\n517|\t}\n518|\tif _, err := terminalbackend.ParseInstanceState(string(observed.State)); err != nil {\n519|\t\treturn empty, wrapLanded(err)\n520|\t}\n521|\tcomputed, err := statusIdentityMatch(body, observed)\n522|\tif err != nil {\n523|\t\treturn empty, err\n524|\t}\n525|\tif observed.IdentityMatch != computed {\n526|\t\treturn empty, refuse(CodeProtocolError, \"status identity binding\")\n527|\t}\n528|\tconverted := terminalbackend.StatusResult{\n529|\t\tState:             observed.State,\n530|\t\tIdentityMatch:     observed.IdentityMatch,\n531|\t\tWrapperPresent:    observed.WrapperPresent,\n532|\t\tProviderPresent:   observed.ProviderPresent,\n533|\t\tAttachable:        observed.Attachable,\n534|\t\tLastOperationID:   observed.LastOperationID,\n535|\t\tLastEffect:        observed.LastEffect,\n536|\t\tProviderRequested: observed.ProviderRequested,\n537|\t\tProviderEvidenced: observed.ProviderEvidenced,\n538|\t\tAttachEvidenced:   observed.AttachEvidenced,\n539|\t}\n540|\tif observed.LastOperationID != nil {\n541|\t\tif _, err := scalar.ParseUUIDv7(*observed.LastOperationID); err != nil {\n542|\t\t\treturn empty, refuse(CodeProtocolError, \"status report operation\")\n543|\t\t}\n544|\t}\n545|\tif err := terminalbackend.CheckStatusResult(computed, converted); err != nil {\n546|\t\treturn empty, wrapLanded(err)\n547|\t}\n548|\tif err := checkSortedUniqueStatusEvidence(observed.EvidenceIDs); err != nil {\n549|\t\treturn empty, err\n550|\t}\n551|\treturn StatusReport{\n552|\t\tState:           observed.State,\n553|\t\tIdentityMatch:   observed.IdentityMatch,\n554|\t\tWrapperPresent:  observed.WrapperPresent,\n555|\t\tProviderPresent: observed.ProviderPresent,\n556|\t\tAttachable:      observed.Attachable,\n557|\t\tLastOperationID: observed.LastOperationID,\n558|\t\tLastEffect:      observed.LastEffect,\n559|\t\tEvidenceIDs:     append([]string(nil), observed.EvidenceIDs...),\n560|\t}, nil\n561|}\n562|\n563|// statusIdentityMatch compares the reported identity tuple against the\n564|// query: exact-instance lookup requires Session, instance, backend,\n565|// implementation, protocol and generation to all match; Session-scoped\n566|// lookup requires the reported session to match and adopts the rest.\n567|// Reported members are shape-validated first, so a malformed report is\n568|// refused instead of compared.\n569|func statusIdentityMatch(body StatusBody, observed StatusObservation) (bool, error) {\n570|\tif _, err := scalar.ParseUUIDv7(observed.SessionID); err != nil {\n571|\t\treturn false, refuse(CodeProtocolError, \"status report session\")\n572|\t}\n573|\tif _, err := terminalbackend.ParseID(observed.BackendID); err != nil {\n574|\t\treturn false, wrapLanded(err)\n575|\t}\n576|\tif err := checkVersionTuple(observed.BackendID, observed.ImplVersion, observed.ProtoVersion); err != nil {\n577|\t\treturn false, err\n578|\t}\n579|\tif observed.SessionID != body.SessionID {\n580|\t\treturn false, nil\n581|\t}\n582|\tif !body.HasTerminalInstanceID {\n583|\t\treturn true, nil\n584|\t}\n585|\tif _, err := scalar.ParseUUIDv7(observed.InstanceID); err != nil {\n586|\t\treturn false, refuse(CodeProtocolError, \"status report instance\")\n587|\t}\n588|\tif err := checkGenerationBound(observed.Generation); err != nil {\n589|\t\treturn false, refuse(CodeProtocolError, \"status report generation\")\n590|\t}\n591|\treturn observed.InstanceID == body.TerminalInstanceID &&\n592|\t\tobserved.BackendID == body.TerminalBackendID &&\n593|\t\tobserved.ImplVersion == body.ImplementationVersion &&\n594|\t\tobserved.ProtoVersion == body.ProtocolVersion &&\n595|\t\tobserved.Generation == body.BackendGeneration, nil\n596|}","final_result":true}}}
