{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c861","stream":{"kind":"session","id":"01a0b2ff-60d1-7b92-bcfc-8a4c766633f3"},"sequence":651,"recorded_at":1780531400001297,"record_type":"event","durability":"durable","causation_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b5be48e9-caa3-42a3-a29a-786d769c2b71","run_stream":{"kind":"run","id":"b5be48e9-caa3-42a3-a29a-786d769c2b71"},"task_stream":{"kind":"task","id":"01a0b301-1325-7c50-800b-15bff9f6d2af"},"task_id":"01a0b301-1325-7c50-800b-15bff9f6d2af","event":{"kind":"output","task_id":"01a0b301-1325-7c50-800b-15bff9f6d2af","chunk":"Read text file `internal/terminstance/result.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"sort\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n8|)\n9|\n10|// Result is the closed §4.C MutationResult object in harness form: it\n11|// repeats the request context identities and adds before/after state,\n12|// side effects, evidence IDs and exactly one retry disposition. The\n13|// engine populates it on every path, success or failure, so the retry\n14|// disposition and the local observation are always readable; failures\n15|// additionally carry the *Error.\n16|type Result struct {\n17|\tOperationID           string\n18|\tSessionID             string\n19|\tTerminalInstanceID    string\n20|\tTerminalBackendID     string\n21|\tImplementationVersion string\n22|\tProtocolVersion       string\n23|\tBackendGeneration     string\n24|\tBefore                terminalbackend.InstanceState\n25|\tAfter                 terminalbackend.InstanceState\n26|\tEffects               []terminalbackend.SideEffect\n27|\tEvidenceIDs           []string\n28|\tDisposition           RetryDisposition\n29|}\n30|\n31|// CheckResult enforces the §4.C result rule: every repeated identity\n32|// equals the request context, before equals the source state the engine\n33|// executed from, states and effects parse through the landed vocabularies,\n34|// side effects are sorted-unique TerminalBackendSideEffect[0..10],\n35|// evidence IDs are sorted-unique digest[0..256], and the disposition\n36|// parses. Each repeated identity is its own arm with its own detail so a\n37|// mutant dropping one comparison is killed by that member's tamper test.\n38|func CheckResult(context MutationContext, source terminalbackend.InstanceState, result Result) error {\n39|\tif result.OperationID != context.OperationID {\n40|\t\treturn refuse(CodeProtocolError, \"result operation binding\")\n41|\t}\n42|\tif result.SessionID != context.SessionID {\n43|\t\treturn refuse(CodeProtocolError, \"result session binding\")\n44|\t}\n45|\tif result.TerminalInstanceID != context.TerminalInstanceID {\n46|\t\treturn refuse(CodeProtocolError, \"result instance binding\")\n47|\t}\n48|\tif result.TerminalBackendID != context.TerminalBackendID {\n49|\t\treturn refuse(CodeProtocolError, \"result backend binding\")\n50|\t}\n51|\tif result.ImplementationVersion != context.ImplementationVersion {\n52|\t\treturn refuse(CodeProtocolError, \"result implementation binding\")\n53|\t}\n54|\tif result.ProtocolVersion != context.ProtocolVersion {\n55|\t\treturn refuse(CodeProtocolError, \"result protocol binding\")\n56|\t}\n57|\tif result.BackendGeneration != context.BackendGeneration {\n58|\t\treturn refuse(CodeStaleGeneration, \"result generation binding\")\n59|\t}\n60|\tif _, err := terminalbackend.ParseInstanceState(string(result.Before)); err != nil {\n61|\t\treturn wrapLanded(err)\n62|\t}\n63|\tif _, err := terminalbackend.ParseInstanceState(string(result.After)); err != nil {\n64|\t\treturn wrapLanded(err)\n65|\t}\n66|\tif result.Before != source {\n67|\t\treturn refuse(CodeProtocolError, \"result before state\")\n68|\t}\n69|\tif err := checkSortedUniqueEffects(result.Effects); err != nil {\n70|\t\treturn err\n71|\t}\n72|\tif err := checkSortedUniqueEvidence(result.EvidenceIDs); err != nil {\n73|\t\treturn err\n74|\t}\n75|\tif _, err := ParseRetryDisposition(string(result.Disposition)); err != nil {\n76|\t\treturn err\n77|\t}\n78|\treturn nil\n79|}\n80|\n81|// checkSortedUniqueEffects enforces sorted-unique [0..10] over parsed\n82|// side effects. Order and uniqueness are two obligations with two arms:\n83|// an unsorted-but-unique vector and a sorted-but-duplicated vector are\n84|// refused by different details, so a mutant dropping either half is\n85|// killed by its own vector.\n86|func checkSortedUniqueEffects(effects []terminalbackend.SideEffect) error {\n87|\tif len(effects) > 10 {\n88|\t\treturn refuse(CodeProtocolError, \"result effects bound\")\n89|\t}\n90|\tfor _, effect := range effects {\n91|\t\tif _, err := terminalbackend.ParseSideEffect(string(effect)); err != nil {\n92|\t\t\treturn wrapLanded(err)\n93|\t\t}\n94|\t}\n95|\tfor index := 1; index < len(effects); index++ {\n96|\t\tif effects[index-1] == effects[index] {\n97|\t\t\treturn refuse(CodeProtocolError, \"result effects unique\")\n98|\t\t}\n99|\t}\n100|\tfor index := 1; index < len(effects); index++ {\n101|\t\tif effects[index-1] > effects[index] {\n102|\t\t\treturn refuse(CodeProtocolError, \"result effects order\")\n103|\t\t}\n104|\t}\n105|\treturn nil\n106|}\n107|\n108|// checkSortedUniqueEvidence enforces sorted-unique digest[0..256] on a\n109|// mutation result. Order and uniqueness are separate arms for the same\n110|// reason as the effects twin: each half owns its mutant.\n111|func checkSortedUniqueEvidence(evidence []string) error {\n112|\treturn checkSortedUniqueEvidenceWhere(evidence, \"result\")\n113|}\n114|\n115|// checkSortedUniqueStatusEvidence enforces the same sorted-unique\n116|// digest[0..256] rule on a status report. The rule is shared; only the\n117|// static detail site differs, so a status mutant and a result mutant\n118|// cannot kill each other's arm.\n119|func checkSortedUniqueStatusEvidence(evidence []string) error {\n120|\treturn checkSortedUniqueEvidenceWhere(evidence, \"status\")\n121|}\n122|\n123|func checkSortedUniqueEvidenceWhere(evidence []string, where string) error {\n124|\tif len(evidence) > 256 {\n125|\t\treturn refuse(CodeProtocolError, where+\" evidence bound\")\n126|\t}\n127|\tfor _, id := range evidence {\n128|\t\tif _, err := scalar.ParseDigest(id); err != nil {\n129|\t\t\treturn refuse(CodeProtocolError, where+\" evidence digest\")\n130|\t\t}\n131|\t}\n132|\tfor index := 1; index < len(evidence); index++ {\n133|\t\tif evidence[index-1] == evidence[index] {\n134|\t\t\treturn refuse(CodeProtocolError, where+\" evidence unique\")\n135|\t\t}\n136|\t}\n137|\tfor index := 1; index < len(evidence); index++ {\n138|\t\tif evidence[index-1] > evidence[index] {\n139|\t\t\treturn refuse(CodeProtocolError, where+\" evidence order\")\n140|\t\t}\n141|\t}\n142|\treturn nil\n143|}\n144|\n145|// buildResult assembles the engine result on every path. Effects and\n146|// evidence are reported sorted: execution order is the transition order\n147|// (request-stop commits graceful_stop_requested before process_closed\n148|// before backend_store_closed), while the wire order is bytewise sorted,\n149|// so the engine sorts a copy and never reorders execution.\n150|func buildResult(context MutationContext, before, after terminalbackend.InstanceState, effects []terminalbackend.SideEffect, evidence []string, disposition RetryDisposition) Result {\n151|\tordered := append([]terminalbackend.SideEffect(nil), effects...)\n152|\tsort.Slice(ordered, func(i, j int) bool { return ordered[i] < ordered[j] })\n153|\torderedEvidence := append([]string(nil), evidence...)\n154|\tsort.Strings(orderedEvidence)\n155|\treturn Result{\n156|\t\tOperationID:           context.OperationID,\n157|\t\tSessionID:             context.SessionID,\n158|\t\tTerminalInstanceID:    context.TerminalInstanceID,\n159|\t\tTerminalBackendID:     context.TerminalBackendID,\n160|\t\tImplementationVersion: context.ImplementationVersion,\n161|\t\tProtocolVersion:       context.ProtocolVersion,\n162|\t\tBackendGeneration:     context.BackendGeneration,\n163|\t\tBefore:                before,\n164|\t\tAfter:                 after,\n165|\t\tEffects:               ordered,\n166|\t\tEvidenceIDs:           orderedEvidence,\n167|\t\tDisposition:           disposition,\n168|\t}\n169|}","final_result":true}}}
