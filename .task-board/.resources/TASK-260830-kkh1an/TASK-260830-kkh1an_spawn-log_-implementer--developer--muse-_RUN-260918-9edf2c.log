\n979|        note=\"Resumes on exactly the parked contradiction as well as the source; target-proven, unknown and other contradictions still refuse.\",\n980|    ),\n981|    Mutant(\n982|        name=\"N-resume-target\",\n983|        path=f\"{PACKAGE}/execute.go\",\n984|        find=\"\\tif report.State != source {\\n\",\n985|        replace=\"\\tif report.State != source && report.State != target {\\n\",\n986|        count=1,\n987|        run=\"TestExecuteUncertainRetryTargetProvenRefuses/quiesce_target_proven\",\n988|        expect=\"KILLED\",\n989|        note=\"Resumes on exactly the proven target state as well as the source; contradictory and unknown observations still refuse.\",\n990|    ),\n991|    Mutant(\n992|        name=\"N-resume-scope-instance\",\n993|        path=f\"{PACKAGE}/execute.go\",\n994|        find=\"\\t\\tTerminalInstanceID:         context.TerminalInstanceID,\\n\\t\\tHasTerminalInstanceID:      true,\\n\",\n995|        replace=\"\\t\\tTerminalInstanceID:         context.TerminalInstanceID,\\n\\t\\tHasTerminalInstanceID:      false,\\n\",\n996|        count=1,\n997|        run=\"TestExecuteUncertainRetryUnknownObservationRefuses/lying_match_on_drifted_instance\",\n998|        expect=\"KILLED\",\n999|        note=\"Reconciles through exactly the Session-scoped lookup instead of the exact instance, adopting a lying instance report; exact reconciliation still refuses it.\",\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
