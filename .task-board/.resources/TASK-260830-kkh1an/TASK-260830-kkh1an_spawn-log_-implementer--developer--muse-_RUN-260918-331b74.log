{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c433","stream":{"kind":"session","id":"01a0b1ea-9cfc-7101-8803-4405ac4e96a0"},"sequence":116,"recorded_at":1780531400000227,"record_type":"event","durability":"durable","causation_id":"e4f9005c-1c88-4d61-aae9-39ab9037f299","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e4f9005c-1c88-4d61-aae9-39ab9037f299","run_stream":{"kind":"run","id":"e4f9005c-1c88-4d61-aae9-39ab9037f299"},"task_stream":{"kind":"task","id":"01a0b1ea-ff2c-75b1-850f-25c315c4f27b"},"task_id":"01a0b1ea-ff2c-75b1-850f-25c315c4f27b","event":{"kind":"output","task_id":"01a0b1ea-ff2c-75b1-850f-25c315c4f27b","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-ptxkqe/worktree/internal/terminalbackend/terminalbackend.go`.\n1|// Package terminalbackend implements the TerminalBackend registry: canonical\n2|// backend identities, implementation/protocol version tuples, external\n3|// executable trust admission, and duplicate or drift refusal.\n4|//\n5|// Normative scope is relux-works/agent-session-manager-spec@v0.5.0 §4.B\n6|// (registry, identity, discovery, trust), §4.1 (backend interface versions),\n7|// §6.5 (Configuration 3.0.0 TerminalBackend extension), and §7.A (Provider\n8|// Protocol 3.0.0 Terminal Instance binding). Manifest/Probe schemas,\n9|// capability evidence, and generation-bound admission are defined in\n10|// manifest.go; lifecycle operations and legacy v0.4.3 translation belong to\n11|// the sibling story tasks and are deliberately not defined here.\n12|package terminalbackend\n13|\n14|import (\n15|\t\"crypto/sha256\"\n16|\t\"encoding/hex\"\n17|\t\"errors\"\n18|\t\"fmt\"\n19|\t\"math\"\n20|\t\"os\"\n21|\t\"path/filepath\"\n22|\t\"regexp\"\n23|\t\"sort\"\n24|\t\"strings\"\n25|\t\"sync\"\n26|\t\"unicode/utf8\"\n27|\n28|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n29|)\n30|\n31|// Wire error codes are the exact Section 15.3 codes the registry may report.\n32|// They are a subset of the pinned catalog error vocabulary; no other code is\n33|// emitted by this package.\n34|const (\n35|\t// CodeNotFound reports an unknown or malformed backend identity. A failed\n36|\t// read is never absence: callers must not treat this as \"no backend\".\n37|\tCodeNotFound = \"terminal_backend_not_found\"\n38|\t// CodeAmbiguous reports a duplicate or ambiguous backend ID. Re-registering\n39|\t// an identical record is still refused: identity registration is not\n40|\t// idempotent.\n41|\tCodeAmbiguous = \"terminal_backend_ambiguous\"\n42|\t// CodeUntrusted reports a disabled, unresolvable, or digest-mismatched\n43|\t// external executable. Trust is established before any probe.\n44|\tCodeUntrusted = \"terminal_backend_untrusted\"\n45|\t// CodeDrift reports a re-registration whose version tuple, kind,\n46|\t// platforms, or executable digest differs from the admitted record.\n47|\tCodeDrift = \"terminal_backend_implementation_drift\"\n48|\t// CodeRestoreMismatch reports an attempt to substitute the configured\n49|\t// default for the exact prior binding on restore or resume.\n50|\tCodeRestoreMismatch = \"terminal_backend_restore_mismatch\"\n51|\t// CodeStaleGeneration reports a generation that is out of bound or does\n52|\t// not match the validated binding.\n53|\tCodeStaleGeneration = \"terminal_backend_stale_generation\"\n54|)\n55|\n56|// Canonical built-in backend identities. The ax. namespace is reserved (§4.B);\n57|// no third-party registration may use it.\n58|const (\n59|\tBuiltinTmux   = \"ax.tmux\"\n60|\tBuiltinConpty = \"ax.conpty\"\n61|)\n62|\n63|// reservedNamespace is the only namespace this implementation may mint.\n64|const reservedNamespace = \"ax.\"\n65|\n66|// maxIDBytes is the Section 4.B bound: 1-128 ASCII bytes.\n67|const maxIDBytes = 128\n68|\n69|// maxGenerationRunes is the Section 4.B/7.A bound: string[1..256] counts\n70|// UTF-8 characters (SPEC.md:321), not bytes; terminal_backend_id is the\n71|// only member of this package still bounded in ASCII bytes.\n72|const maxGenerationRunes = 256\n73|\n74|// maxProtocolVersions is the Section 4.B bound: sorted unique semver[1..32].\n75|const maxProtocolVersions = 32\n76|\n77|var (\n78|\tidPattern = regexp.MustCompile(`^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$`)\n79|\t// semverPattern implements Semantic Versioning 2.0.0 in full, matching the\n80|\t// grammar the canonical and config packages enforce for the same members.\n81|\tsemverPattern = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n82|)\n83|\n84|// Error is a registry refusal. Code is always one of the Code* constants;\n85|// BackendID names the identity at issue when there is one. Detail is a static\n86|// clause: it never echoes paths, digests, generations, or other local data.\n87|type Error struct {\n88|\tCode      string\n89|\tBackendID string\n90|\tDetail    string\n91|}\n92|\n93|func (err *Error) Error() string {\n94|\tif err.BackendID == \"\" {\n95|\t\treturn \"terminal backend refused: \" + err.Code + \" at \" + err.Detail\n96|\t}\n97|\treturn \"terminal backend refused: \" + err.Code + \" for \" + err.BackendID + \" at \" + err.Detail\n98|}\n99|\n100|// recordRefusal arms runtime attribution of constructed refusals to their\n101|// production call site. It is nil in production: construction is then a\n102|// pure allocation with zero behavior change. The refusal-arm inventory\n103|// audit (internal test) sets it for the test-binary run so the exercised\n104|// file:line set behind every refusal can be audited against the derived\n105|// arm set in both directions. The hook carries only code and detail; the\n106|// audit attributes the site itself through the call stack, exactly like\n107|// the provider/provhost swapped-constructor recorders.\n108|var recordRefusal func(code, detail string)\n109|\n110|// refuse builds the refusal for one derived arm. Every production\n111|// &Error literal routes through refuse so the exercised-site audit can\n112|// attribute each refusal to its file:line; an &Error literal built\n113|// outside refuse is an unregistered construction the derivation rejects.\n114|// The returned value is identical to the wrapped literal: recording never\n115|// alters the refusal.\n116|//\n117|//go:noinline\n118|func refuse(err *Error) *Error {\n119|\tif recordRefusal != nil {\n120|\t\trecordRefusal(err.Code, err.Detail)\n121|\t}\n122|\treturn err\n123|}\n124|\n125|// errorCode reports whether err carries the given wire code.\n126|func errorCode(err error, code string) bool {\n127|\tvar refusal *Error\n128|\tif !errors.As(err, &refusal) {\n129|\t\treturn false\n130|\t}\n131|\treturn refusal.Code == code\n132|}\n133|\n134|// IsNotFound reports CodeNotFound refusals.\n135|func IsNotFound(err error) bool { return errorCode(err, CodeNotFound) }\n136|\n137|// IsAmbiguous reports CodeAmbiguous refusals.\n138|func IsAmbiguous(err error) bool { return errorCode(err, CodeAmbiguous) }\n139|\n140|// IsUntrusted reports CodeUntrusted refusals.\n141|func IsUntrusted(err error) bool { return errorCode(err, CodeUntrusted) }\n142|\n143|// IsDrift reports CodeDrift refusals.\n144|func IsDrift(err error) bool { return errorCode(err, CodeDrift) }\n145|\n146|// IsRestoreMismatch reports CodeRestoreMismatch refusals.\n147|func IsRestoreMismatch(err error) bool { return errorCode(err, CodeRestoreMismatch) }\n148|\n149|// IsStaleGeneration reports CodeStaleGeneration refusals.\n150|func IsStaleGeneration(err error) bool { return errorCode(err, CodeStaleGeneration) }\n151|\n152|// ParseID validates a canonical terminal backend identity: 1-128 ASCII bytes\n153|// matching [a-z][a-z0-9]*(?:[.-][a-z0-9]+)*. It admits the reserved ax.\n154|// namespace only for the two canonical built-ins; every other ax.-prefixed ID\n155|// is refused so a third party cannot mint a trusted-looking identity.\n156|//\n157|// The bound and grammar arms omit BackendID on purpose: a value refused\n158|// there is arbitrary input the grammar never admitted, and the package\n159|// posture is that refusals never echo unvalidated data. Only the\n160|// reserved-namespace arm names the identity, because its input already\n161|// passed the grammar.\n162|//\n163|// Every other site that names a BackendID is covered by the entry census\n164|// in backend_id_entry_census_test.go, keyed by (site, reaching exported\n165|// entry): Registration.validate and TrustEntry.validate via mustParseID;\n166|// Resolve, RequireRestoreBinding, CheckVersionTuple,\n167|// CheckProviderDescriptor and Reconcile via ParseID at the entry;\n168|// ParseManifest, ParseProbe and ParseEvidence via ParseID at document\n169|// admission with entry re-validation where a second entry reaches the\n170|// same arm; New via the built-in constants. That test — not this comment\n171|// — is the enforcement: it derives every BackendID site and every\n172|// exported entry from production source, refuses hostile input through\n173|// each entry without echo, fires each pair with a validated identity,\n174|// and reports the validated/total ratio it measured.\n175|func ParseID(value string) (string, error) {\n176|\tif !utf8.ValidString(value) || len(value) < 1 || len(value) > maxIDBytes {\n177|\t\treturn \"\", refuse(&Error{Code: CodeNotFound, Detail: \"terminal_backend_id bound\"})\n178|\t}\n179|\tif !idPattern.MatchString(value) {\n180|\t\treturn \"\", refuse(&Error{Code: CodeNotFound, Detail: \"terminal_backend_id grammar\"})\n181|\t}\n182|\tif strings.HasPrefix(value, reservedNamespace) && value != BuiltinTmux && value != BuiltinConpty {\n183|\t\treturn \"\", refuse(&Error{Code: CodeNotFound, BackendID: value, Detail: \"terminal_backend_id reserved namespace\"})\n184|\t}\n185|\treturn value, nil\n186|}\n187|\n188|// mustParseID is the internal admission used where the caller already holds a\n189|// validated record. It duplicates the ParseID rule so a Registry can never\n190|// hold an identity its own grammar refuses.\n191|func mustParseID(value string) error {\n192|\t_, err := ParseID(value)\n193|\treturn err\n194|}\n195|\n196|// Kind is the Section 4.B implementation_kind vocabulary.\n197|type Kind string\n198|\n199|// Implementation kinds. Built-ins run inside the ax binary; externals arrive\n200|// as adapter executables over the Section 4.B argv/framing wire.\n201|const (\n202|\tKindBuiltinGo         Kind = \"builtin_go\"\n203|\tKindLocalProgram      Kind = \"local_program\"\n204|\tKindTrustedExecutable Kind = \"trusted_executable\"\n205|\tKindNativeRuntime     Kind = \"native_runtime\"\n206|)\n207|\n208|// parseKind admits exactly the closed Section 4.B vocabulary.\n209|func parseKind(value string) (Kind, error) {\n210|\tswitch Kind(value) {\n211|\tcase KindBuiltinGo, KindLocalProgram, KindTrustedExecutable, KindNativeRuntime:\n212|\t\treturn Kind(value), nil\n213|\tdefault:\n214|\t\treturn \"\", refuse(&Error{Code: CodeNotFound, Detail: \"implementation_kind vocabulary\"})\n215|\t}\n216|}\n217|\n218|// needsDigest reports whether the kind carries an executable digest. Section\n219|// 4.B: digest for local_program or trusted_executable; null otherwise.\n220|func needsDigest(kind Kind) bool {\n221|\treturn kind == KindLocalProgram || kind == KindTrustedExecutable\n222|}\n223|\n224|// Registration is one admitted backend identity with its exact version tuple,\n225|// platform set, and trust binding. It is the registry half of the Section 4.B\n226|// Manifest identity: the Manifest/Probe objects themselves belong to the\n227|// sibling manifest task.\n228|type Registration struct {\n229|\t// ID is the canonical terminal_backend_id.\n230|\tID string\n231|\t// Kind is the closed implementation_kind.\n232|\tKind Kind\n233|\t// ImplementationVersion is the exact admitted semver.\n234|\tImplementationVersion string\n235|\t// ProtocolVersions are the sorted unique semver members in Terminal\n236|\t// Backend Protocol major 1.\n237|\tProtocolVersions []string\n238|\t// Platforms is the sorted unique non-empty platform subset.\n239|\tPlatforms []scalar.Platform\n240|\t// ExecutableDigest is the sha256: digest for external kinds and empty\n241|\t// (null) for built-in kinds.\n242|\tExecutableDigest string\n243|}\n244|\n245|// validate enforces every closed Section 4.B/6.5 rule on one record.\n246|func (record Registration) validate() error {\n247|\tif err := mustParseID(record.ID); err != nil {\n248|\t\treturn err\n249|\t}\n250|\tif _, err := parseKind(string(record.Kind)); err != nil {\n251|\t\treturn err\n252|\t}\n253|\tif !semverPattern.MatchString(record.ImplementationVersion) {\n254|\t\treturn refuse(&Error{Code: CodeDrift, BackendID: record.ID, Detail: \"implementation_version semver\"})\n255|\t}\n256|\tif err := validateProtocolVersions(record.ID, record.ProtocolVersions); err != nil {\n257|\t\treturn err\n258|\t}\n259|\tif err := validatePlatforms(record.Platforms); err != nil {\n260|\t\treturn refuse(&Error{Code: CodeNotFound, BackendID: record.ID, Detail: err.Error()})\n261|\t}\n262|\tif needsDigest(record.Kind) {\n263|\t\tif _, err := scalar.ParseDigest(record.ExecutableDigest); err != nil {\n264|\t\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: record.ID, Detail: \"executable_digest\"})\n265|\t\t}\n266|\t} else if record.ExecutableDigest != \"\" {\n267|\t\treturn refuse(&Error{Code: CodeDrift, BackendID: record.ID, Detail: \"executable_digest must be null\"})\n268|\t}\n269|\treturn nil\n270|}\n271|\n272|// validateProtocolVersions enforces sorted unique semver[1..32], each in\n273|// Terminal Backend Protocol major 1.\n274|func validateProtocolVersions(backendID string, versions []string) error {\n275|\tif len(versions) < 1 || len(versions) > maxProtocolVersions {\n276|\t\treturn refuse(&Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_versions bound\"})\n277|\t}\n278|\tfor index, version := range versions {\n279|\t\tif !semverPattern.MatchString(version) || semverMajor(version) != 1 {\n280|\t\t\treturn refuse(&Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_versions major 1\"})\n281|\t\t}\n282|\t\tif index > 0 && versions[index-1] >= version {\n283|\t\t\treturn refuse(&Error{Code: CodeDrift, BackendID: backendID, Detail: \"protocol_versions sorted unique\"})\n284|\t\t}\n285|\t}\n286|\treturn nil\n287|}\n288|\n289|// semverMajor returns the major number of a validated semver string.\n290|// A major that does not fit an int saturates instead of wrapping, so a\n291|// huge foreign major compares foreign at every != 1 call site rather\n292|// than aliasing a small native one (18446744073709551617 must not read\n293|// as 1). Saturation preserves every comparison against the small\n294|// constants the call sites use, in the correct direction.\n295|func semverMajor(version string) int {\n296|\tmajor := 0\n297|\tfor i := 0; i < len(version); i++ {\n298|\t\tif version[i] == '.' {\n299|\t\t\tbreak\n300|\t\t}\n301|\t\tdigit := int(version[i] - '0')\n302|\t\tif major > (math.MaxInt-digit)/10 {\n303|\t\t\treturn math.MaxInt\n304|\t\t}\n305|\t\tmajor = major*10 + digit\n306|\t}\n307|\treturn major\n308|}\n309|\n310|// validatePlatforms enforces a sorted unique non-empty subset of the closed\n311|// macos|linux|wsl2|windows vocabulary.\n312|func validatePlatforms(platforms []scalar.Platform) error {\n313|\tif len(platforms) == 0 || len(platforms) > 4 {\n314|\t\treturn errors.New(\"platforms bound\")\n315|\t}\n316|\tprevious := \"\"\n317|\tfor _, platform := range platforms {\n318|\t\tif _, err := scalar.ParsePlatform(platform.String()); err != nil {\n319|\t\t\treturn errors.New(\"platforms vocabulary\")\n320|\t\t}\n321|\t\tif previous >= platform.String() {\n322|\t\t\treturn errors.New(\"platforms sorted unique\")\n323|\t\t}\n324|\t\tprevious = platform.String()\n325|\t}\n326|\treturn nil\n327|}\n328|\n329|// cloneStrings deep-copies a version list so the registry never shares a\n330|// backing array with its caller. Registration carries slices; a struct copy\n331|// duplicates only the header, so every ingress and egress point must clone.\n332|func cloneStrings(values []string) []string {\n333|\tif values == nil {\n334|\t\treturn nil\n335|\t}\n336|\tcloned := make([]string, len(values))\n337|\tcopy(cloned, values)\n338|\treturn cloned\n339|}\n340|\n341|// clonePlatforms deep-copies a platform set for the same reason as\n342|// cloneStrings: without it a caller holding a resolved record keeps a live\n343|// handle on admitted registry state and can convert drift into a duplicate.\n344|func clonePlatforms(values []scalar.Platform) []scalar.Platform {\n345|\tif values == nil {\n346|\t\treturn nil\n347|\t}\n348|\tcloned := make([]scalar.Platform, len(values))\n349|\tcopy(cloned, values)\n350|\treturn cloned\n351|}\n352|\n353|// cloneRecord deep-copies every slice member of a record.\n354|func cloneRecord(record Registration) Registration {\n355|\trecord.ProtocolVersions = cloneStrings(record.ProtocolVersions)\n356|\trecord.Platforms = clonePlatforms(record.Platforms)\n357|\treturn record\n358|}\n359|\n360|// equalRecord reports whether two validated records are member-for-member\n361|// identical. Any difference is drift, never a compatible update.\n362|func equalRecord(left, right Registration) bool {\n363|\tif left.ID != right.ID || left.Kind != right.Kind ||\n364|\t\tleft.ImplementationVersion != right.ImplementationVersion ||\n365|\t\tleft.ExecutableDigest != right.ExecutableDigest {\n366|\t\treturn false\n367|\t}\n368|\tif len(left.ProtocolVersions) != len(right.ProtocolVersions) {\n369|\t\treturn false\n370|\t}\n371|\tfor i := range left.ProtocolVersions {\n372|\t\tif left.ProtocolVersions[i] != right.ProtocolVersions[i] {\n373|\t\t\treturn false\n374|\t\t}\n375|\t}\n376|\tif len(left.Platforms) != len(right.Platforms) {\n377|\t\treturn false\n378|\t}\n379|\tfor i := range left.Platforms {\n380|\t\tif left.Platforms[i] != right.Platforms[i] {\n381|\t\t\treturn false\n382|\t\t}\n383|\t}\n384|\treturn true\n385|}\n386|\n387|// TrustEntry is one Configuration 3.0.0 external_trust entry (§6.5): exactly a\n388|// backend ID, an absolute executable path, an executable digest, and enabled.\n389|type TrustEntry struct {\n390|\tBackendID        string\n391|\tExecutablePath   string\n392|\tExecutableDigest string\n393|\tEnabled          bool\n394|}\n395|\n396|// validateTrust enforces the Section 6.5 trust admission: grammar plus the\n397|// reserved-namespace bar (third parties use a vendor-owned namespace),\n398|// absolute path only (PATH-only discovery fails), and a well-formed digest.\n399|// A disabled entry is not an error here; registration treats it as untrusted.\n400|func (entry TrustEntry) validate(platform scalar.Platform) error {\n401|\tif err := mustParseID(entry.BackendID); err != nil {\n402|\t\treturn err\n403|\t}\n404|\tif strings.HasPrefix(entry.BackendID, reservedNamespace) {\n405|\t\treturn refuse(&Error{Code: CodeAmbiguous, BackendID: entry.BackendID, Detail: \"external_trust reserved namespace\"})\n406|\t}\n407|\tif _, err := scalar.ParseAbsolutePath(platform, entry.ExecutablePath); err != nil {\n408|\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"external_trust executable_path\"})\n409|\t}\n410|\tif _, err := scalar.ParseDigest(entry.ExecutableDigest); err != nil {\n411|\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"external_trust executable_digest\"})\n412|\t}\n413|\treturn nil\n414|}\n415|\n416|// Registry is the process-local TerminalBackend registry. It opens with the\n417|// two canonical built-ins admitted and accepts external adapters only through\n418|// RegisterExternal with a validated trust entry. The zero value is unusable;\n419|// construct with New.\n420|type Registry struct {\n421|\tmutex   sync.RWMutex\n422|\trecords map[string]Registration\n423|}\n424|\n425|// New admits the canonical built-ins ax.tmux (macos, linux, wsl2) and\n426|// ax.conpty (windows) at the given implementation version with the given\n427|// Terminal Backend Protocol versions. Both are builtin_go without an\n428|// executable digest. Unknown members or a non-major-1 protocol list fail\n429|// before either built-in is admitted.\n430|func New(implementationVersion string, protocolVersions []string) (*Registry, error) {\n431|\tif !semverPattern.MatchString(implementationVersion) {\n432|\t\treturn nil, refuse(&Error{Code: CodeDrift, Detail: \"implementation_version semver\"})\n433|\t}\n434|\tprotocols := append([]string(nil), protocolVersions...)\n435|\tsort.Strings(protocols)\n436|\tif err := validateProtocolVersions(BuiltinTmux, protocols); err != nil {\n437|\t\treturn nil, err\n438|\t}\n439|\tregistry := &Registry{records: make(map[string]Registration, 4)}\n440|\tbuiltins := []Registration{\n441|\t\t{\n442|\t\t\tID:                    BuiltinTmux,\n443|\t\t\tKind:                  KindBuiltinGo,\n444|\t\t\tImplementationVersion: implementationVersion,\n445|\t\t\t// Each built-in gets its own copy so the two admitted records\n446|\t\t\t// never alias each other. This is defence-in-depth, not a\n447|\t\t\t// bypass fix: callers only ever see egress clones (Resolve\n448|\t\t\t// clones, RegisterExternal clones on ingress, IDs returns\n449|\t\t\t// strings), so no exported path can reach these arrays.\n450|\t\t\tProtocolVersions: cloneStrings(protocols),\n451|\t\t\tPlatforms:        []scalar.Platform{scalar.PlatformLinux, scalar.PlatformMacOS, scalar.PlatformWSL2},\n452|\t\t\t// Platforms literal above is already sorted: linux < macos < wsl2.\n453|\t\t},\n454|\t\t{\n455|\t\t\tID:                    BuiltinConpty,\n456|\t\t\tKind:                  KindBuiltinGo,\n457|\t\t\tImplementationVersion: implementationVersion,\n458|\t\t\tProtocolVersions:      cloneStrings(protocols),\n459|\t\t\tPlatforms:             []scalar.Platform{scalar.PlatformWindows},\n460|\t\t},\n461|\t}\n462|\tfor _, record := range builtins {\n463|\t\tif err := record.validate(); err != nil {\n464|\t\t\treturn nil, err\n465|\t\t}\n466|\t\tregistry.records[record.ID] = record\n467|\t}\n468|\treturn registry, nil\n469|}\n470|\n471|// RegisterExternal admits one external adapter (§4.B discovery before\n472|// activation, §6.5 trust). The trust entry must be enabled and name an\n473|// absolute executable whose digest exactly equals the observed record digest;\n474|// a mismatch fails before any probe. The observed record must use an external\n475|// kind, carry the same ID, and pass full record validation. Registering an\n476|// already-known ID fails closed: an identical record is CodeAmbiguous\n477|// (registration is not idempotent) and any difference is CodeDrift.\n478|func (registry *Registry) RegisterExternal(platform scalar.Platform, entry TrustEntry, observed Registration) error {\n479|\tif registry == nil {\n480|\t\treturn refuse(&Error{Code: CodeNotFound, Detail: \"registry unavailable\"})\n481|\t}\n482|\tif err := entry.validate(platform); err != nil {\n483|\t\treturn err\n484|\t}\n485|\tif !entry.Enabled {\n486|\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"external_trust disabled\"})\n487|\t}\n488|\tif observed.ID != entry.BackendID {\n489|\t\treturn refuse(&Error{Code: CodeAmbiguous, BackendID: entry.BackendID, Detail: \"external_trust identity binding\"})\n490|\t}\n491|\tif observed.Kind != KindLocalProgram && observed.Kind != KindTrustedExecutable {\n492|\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"external implementation_kind\"})\n493|\t}\n494|\tif err := observed.validate(); err != nil {\n495|\t\treturn err\n496|\t}\n497|\tif observed.ExecutableDigest != entry.ExecutableDigest {\n498|\t\treturn refuse(&Error{Code: CodeUntrusted, BackendID: entry.BackendID, Detail: \"executable substitution\"})\n499|\t}\n500|\tregistry.mutex.Lock()\n(more lines below)","final_result":true}}}
