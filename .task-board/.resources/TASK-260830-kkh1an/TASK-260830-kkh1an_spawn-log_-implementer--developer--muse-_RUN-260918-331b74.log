{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c969","stream":{"kind":"session","id":"01a0b1ea-9cfc-7101-8803-4405ac4e96a0"},"sequence":783,"recorded_at":1780531400001561,"record_type":"event","durability":"durable","causation_id":"e4f9005c-1c88-4d61-aae9-39ab9037f299","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e4f9005c-1c88-4d61-aae9-39ab9037f299","run_stream":{"kind":"run","id":"e4f9005c-1c88-4d61-aae9-39ab9037f299"},"task_stream":{"kind":"task","id":"01a0b1ed-0b59-7121-b31c-3f3a9737de22"},"task_id":"01a0b1ed-0b59-7121-b31c-3f3a9737de22","event":{"kind":"output","task_id":"01a0b1ed-0b59-7121-b31c-3f3a9737de22","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-ptxkqe/worktree/internal/terminalbackend/manifest.go`.\n(379 line(s) above)\n380|// invalid-UTF-8 refusal, lone-surrogate-escape refusal, a nesting cap, and\n381|// trailing-data refusal. The surrogate scan runs on the raw bytes before\n382|// any canonicalization (SPEC.md:289): Go's encoding/json would silently\n383|// replace a lone \\ud800 with U+FFFD, hiding the violation from every later\n384|// member check. Numbers\n385|// decode as json.Number so member validators can refuse them explicitly:\n386|// none of the three closed schemas has a numeric member.\n387|func decodeStrictObject(raw []byte) (map[string]any, error) {\n388|\tif len(raw) > maxIdentityDocumentBytes {\n389|\t\treturn nil, mismatchf(\"document size\")\n390|\t}\n391|\tif !utf8.Valid(raw) {\n392|\t\treturn nil, mismatchf(\"document encoding\")\n393|\t}\n394|\tif hasLoneSurrogateEscape(raw) {\n395|\t\treturn nil, mismatchf(\"document surrogate escape\")\n396|\t}\n397|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n398|\tdecoder.UseNumber()\n399|\tvalue, err := decodeCappedValue(decoder, 0)\n400|\tif err != nil {\n401|\t\treturn nil, err\n402|\t}\n403|\tif decoder.More() {\n404|\t\treturn nil, mismatchf(\"document trailing data\")\n405|\t}\n406|\tobject, ok := value.(map[string]any)\n407|\tif !ok {\n408|\t\treturn nil, mismatchf(\"document shape\")\n409|\t}\n410|\treturn object, nil\n411|}\n412|\n413|// decodeCappedValue decodes one JSON value with an explicit depth bound. The\n414|// bound is far above the deepest legitimate nesting (object, claims array,\n415|// claim object, member array) and fails closed below any decoder-stack risk.\n416|func decodeCappedValue(decoder *json.Decoder, depth int) (any, error) {\n417|\tif depth > maxJSONDepth {\n418|\t\treturn nil, mismatchf(\"document nesting\")\n419|\t}\n420|\ttoken, err := decoder.Token()\n421|\tif err != nil {\n422|\t\treturn nil, mismatchf(\"document syntax\")\n423|\t}\n424|\tif delimiter, ok := token.(json.Delim); ok {\n425|\t\tswitch delimiter {\n426|\t\tcase '{':\n427|\t\t\tobject := make(map[string]any)\n428|\t\t\tfor decoder.More() {\n429|\t\t\t\tkeyToken, err := decoder.Token()\n430|\t\t\t\tif err != nil {\n431|\t\t\t\t\treturn nil, mismatchf(\"document syntax\")\n432|\t\t\t\t}\n433|\t\t\t\tkey, ok := keyToken.(string)\n434|\t\t\t\tif !ok {\n435|\t\t\t\t\treturn nil, mismatchf(\"document syntax\")\n436|\t\t\t\t}\n437|\t\t\t\tif _, duplicate := object[key]; duplicate {\n438|\t\t\t\t\treturn nil, mismatchf(\"document duplicate member\")\n439|\t\t\t\t}\n440|\t\t\t\tmember, err := decodeCappedValue(decoder, depth+1)\n441|\t\t\t\tif err != nil {\n442|\t\t\t\t\treturn nil, err\n443|\t\t\t\t}\n444|\t\t\t\tobject[key] = member\n445|\t\t\t}\n446|\t\t\tif _, err := decoder.Token(); err != nil {\n447|\t\t\t\treturn nil, mismatchf(\"document syntax\")\n448|\t\t\t}\n449|\t\t\treturn object, nil\n450|\t\tcase '[':\n451|\t\t\t// Non-nil initialization: an empty wire array must round-trip\n452|\t\t\t// as [] rather than null, or identity recomputation over an\n453|\t\t\t// empty claim or evidence list diverges from the signer.\n454|\t\t\tarray := []any{}\n455|\t\t\tfor decoder.More() {\n456|\t\t\t\tmember, err := decodeCappedValue(decoder, depth+1)\n457|\t\t\t\tif err != nil {\n458|\t\t\t\t\treturn nil, err\n459|\t\t\t\t}\n460|\t\t\t\tarray = append(array, member)\n461|\t\t\t}\n462|\t\t\tif _, err := decoder.Token(); err != nil {\n463|\t\t\t\treturn nil, mismatchf(\"document syntax\")\n464|\t\t\t}\n465|\t\t\treturn array, nil\n466|\t\tdefault:\n467|\t\t\treturn nil, mismatchf(\"document syntax\")\n468|\t\t}\n469|\t}\n470|\treturn token, nil\n471|}\n472|\n473|// checkExactMembers refuses any deviation from the closed member set: an\n474|// unknown member and a missing member are both malformed.\n475|func checkExactMembers(object map[string]any, members []string) error {\n476|\tif len(object) != len(members) {\n477|\t\treturn mismatchf(\"document members\")\n478|\t}\n479|\tfor _, member := range members {\n480|\t\tif _, known := object[member]; !known {\n481|\t\t\treturn mismatchf(\"document members\")\n482|\t\t}\n483|\t}\n484|\treturn nil\n485|}\n486|\n487|// stringMember extracts a required string member. Numbers, booleans, nulls,\n488|// arrays, and objects are refused: no member of these schemas takes them.\n489|func stringMember(object map[string]any, name string) (string, error) {\n490|\tvalue, ok := object[name].(string)\n491|\tif !ok {\n492|\t\treturn \"\", mismatchf(\"document member type\")\n493|\t}\n494|\treturn value, nil\n495|}\n496|\n497|// boundedStringMember extracts a required string[1..256] measured in UTF-8\n498|// characters over valid UTF-8 (SPEC.md:321), the canonical bound in every\n499|// containing contract.\n500|func boundedStringMember(object map[string]any, name string) (string, error) {\n501|\tvalue, err := stringMember(object, name)\n502|\tif err != nil {\n503|\t\treturn \"\", err\n504|\t}\n505|\tif !utf8.ValidString(value) || utf8.RuneCountInString(value) < 1 || utf8.RuneCountInString(value) > maxOpaqueString {\n506|\t\treturn \"\", mismatchf(\"document string bound\")\n507|\t}\n508|\treturn value, nil\n509|}\n510|\n511|// digestMember extracts a required s