e integer\", \"must be an integral JSON number\")\n43|\t}\n44|\tparsed, err := strconv.ParseInt(candidate, 10, 64)\n45|\tif err != nil {\n46|\t\treturn invalid(\"safe integer\", \"must fit the interoperable safe interval\")\n47|\t}\n48|\tvalidated, err := NewSafeInteger(parsed)\n49|\tif err != nil {\n50|\t\treturn err\n51|\t}\n52|\t*value = validated\n53|\treturn nil\n54|}\n55|\n56|type Uint53 struct{ value uint64 }\n57|\n58|func NewUint53(value uint64) (Uint53, error) {\n59|\tif value > MaxUint53 {\n60|\t\treturn Uint53{}, invalid(\"uint53\", \"must lie in [0, 9007199254740991]\")\n61|\t}\n62|\treturn Uint53{value: value}, nil\n63|}\n64|\n65|func (value Uint53) Uint64() uint64 { return value.value }\n66|\n67|func (value Uint53) MarshalJSON() ([]byte, error) {\n68|\tif _, err := NewUint53(value.value); err != nil {\n69|\t\treturn nil, err\n70|\t}\n71|\treturn []byte(strconv.FormatUint(value.value, 10)), nil\n72|}\n73|\n74|func (value *Uint53) UnmarshalJSON(data []byte) error {\n75|\tcandidate := strings.TrimSpace(string(data))\n76|\tif !jsonUnsignedPattern.MatchString(candidate) {\n77|\t\treturn invalid(\"uint53\", \"must be an unsigned integral JSON number\")\n78|\t}\n79|\tparsed, err := strconv.ParseUint(candidate, 10, 64)\n80|\tif err != nil {\n81|\t\treturn invalid(\"uint53\", \"must fit the interoperable unsigned interval\")\n82|\t}\n83|\tvalidated, err := NewUint53(parsed)\n84|\tif err != nil {\n85|\t\treturn err\n86|\t}\n87|\t*value = validated\n88|\treturn nil\n89|}\n90|\n91|type BoundedInteger struct {\n92|\tvalue       int64\n93|\tmin         int64\n94|\tmax         int64\n95|\tinitialized bool\n96|}\n97|\n98|func NewBoundedInteger(value, min, max int64) (BoundedInteger, error) {\n99|\tif min < -MaxSafeInteger || max > MaxSafeInteger || min > max {\n100|\t\treturn BoundedInteger{}, invalid(\"bounded integer\", \"bounds must form a safe-integer interval\")\n101|\t}\n102|\tif value < min || value > max {\n103|\t\treturn BoundedInteger{}, invalid(\"bounded integer\", \"value lies outside the schema interval\")\n104|\t}\n105|\treturn BoundedInteger{value: value, min: min, max: max, initialized: true}, nil\n106|}\n107|\n108|func DecodeBoundedIntegerJSON(data []byte, min, max int64) (BoundedInteger, error) {\n109|\tvar value SafeInteger\n110|\tif err := json.Unmarshal(data, &value); err != nil {\n111|\t\treturn BoundedInteger{}, err\n112|\t}\n113|\treturn NewBoundedInteger(value.Int64(), min, max)\n114|}\n115|\n116|func (value BoundedInteger) Int64() int64 { return value.value }\n117|func (value BoundedInteger) Min() int64   { return value.min }\n118|func (value BoundedInteger) Max() int64   { return value.max }\n119|\n120|func (value BoundedInteger) MarshalJSON() ([]byte, error) {\n121|\tif !value.initialized {\n122|\t\treturn nil, invalid(\"bounded integer\", \"requires an explicit schema interval\")\n123|\t}\n124|\tif _, err := NewBoundedInteger(value.value, value.min, value.max); err != nil {\n125|\t\treturn nil, err\n126|\t}\n127|\treturn []byte(strconv.FormatInt(value.value, 10)), nil\n128|}\n129|\n130|type DecimalUint64 struct{ value uint64 }\n131|\n132|func NewDecimalUint64(value uint64) DecimalUint64 {\n133|\treturn DecimalUint64{value: value}\n134|}\n135|\n136|func ParseDecimalUint64(value string) (DecimalUint64, error) {\n137|\tif !decimalUint64Pattern.MatchString(value) {\n138|\t\treturn DecimalUint64{}, invalid(\"decimal_uint64\", \"must use canonical unsigned decimal string syntax\")\n139|\t}\n140|\tparsed, err := strconv.ParseUint(value, 10, 64)\n141|\tif err != nil {\n142|\t\treturn DecimalUint64{}, invalid(\"decimal_uint64\", \"must not exceed 18446744073709551615\")\n143|\t}\n144|\treturn DecimalUint64{value: parsed}, nil\n145|}\n146|\n147|func (value DecimalUint64) Uint64() uint64 { return value.value }\n148|func (value DecimalUint64) String() string { return strconv.FormatUint(value.value, 10) }\n149|\n150|func (value DecimalUint64) MarshalJSON() ([]byte, error) {\n151|\treturn json.Marshal(value.String