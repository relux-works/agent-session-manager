{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9ad","stream":{"kind":"session","id":"01a0b1ea-9cfc-7101-8803-4405ac4e96a0"},"sequence":817,"recorded_at":1780531400001629,"record_type":"event","durability":"durable","causation_id":"e4f9005c-1c88-4d61-aae9-39ab9037f299","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"e4f9005c-1c88-4d61-aae9-39ab9037f299","run_stream":{"kind":"run","id":"e4f9005c-1c88-4d61-aae9-39ab9037f299"},"task_stream":{"kind":"task","id":"01a0b1ed-29b3-7ee0-a7b4-e858a1b206ee"},"task_id":"01a0b1ed-29b3-7ee0-a7b4-e858a1b206ee","event":{"kind":"output","task_id":"01a0b1ed-29b3-7ee0-a7b4-e858a1b206ee","chunk":"{\n  \"chunk_id\": \"exec-21-1\",\n  \"command\": \"grep -n \\\"maxOpaqueString\\\\|maxIdentityDocumentBytes\\\\|maxJSONDepth\\\" internal/terminalbackend/manifest.go | head; echo ===; sed -n '1490,1530p' internal/terminalbackend/manifest.go; echo ===DESCRIPTOR===; grep -n \\\"generation\\\\|Generation\\\" internal/terminalbackend/descriptor.go | head -n 20\",\n  \"description\": \"Check generation bounds and descriptor\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"257:\\tmaxOpaqueString    = 256\\n258:\\tmaxJSONDepth       = 32\\n260:\\t// maxIdentityDocumentBytes is the AX omit-self identity bound the\\n266:\\tmaxIdentityDocumentBytes = 5_242_880\\n388:\\tif len(raw) > maxIdentityDocumentBytes {\\n417:\\tif depth > maxJSONDepth {\\n505:\\tif !utf8.ValidString(value) || utf8.RuneCountInString(value) < 1 || utf8.RuneCountInString(value) > maxOpaqueString {\\n2149:\\t\\tif !utf8.ValidString(build) || utf8.RuneCountInString(build) < 1 || utf8.RuneCountInString(build) > maxOpaqueString {\\n===\\n// the raw generation bytes (§4.B). The raw generation is a string[1..256]\\n// in UTF-8 characters over valid UTF-8 (SPEC.md:321); anything else\\n// (including empty, which would make every backend share one digest) is\\n// CodeStaleGeneration, never a derived value.\\nfunc GenerationDigest(rawGeneration string) (string, error) {\\n\\tif !utf8.ValidString(rawGeneration) || utf8.RuneCountInString(rawGeneration) < 1 || utf8.RuneCountInString(rawGeneration) > maxGenerationRunes {\\n\\t\\treturn \\\"\\\", refuse(&Error{Code: CodeStaleGeneration, Detail: \\\"backend_generation bound\\\"})\\n\\t}\\n\\tmaterial := append([]byte(generationDigestDomain), rawGeneration...)\\n\\tsum := sha256.Sum256(material)\\n\\treturn \\\"sha256:\\\" + hex.EncodeToString(sum[:]), nil\\n}\\n\\n// SignatureVerifier verifies one evidence attestation signature. issuerID is\\n// the evidence issuer_id, message the domain-separated canonical bytes from\\n// UnsignedEvidenceBytes, and signature the decoded attestation bytes. A nil\\n// return authenticates through the caller's trusted release or\\n// host-incarnation key registry; any error (unknown key, invalid signature,\\n// registry failure) fails closed. A nil verifier admits nothing.\\ntype SignatureVerifier func(issuerID string, message, signature []byte) error\\n\\n// integrityFailure refuses with CodeIntegrityFailure and a static detail.\\n//\\n//go:noinline\\nfunc integrityFailure(detail string) *Error {\\n\\terr := &Error{Code: CodeIntegrityFailure, Detail: detail}\\n\\tif recordRefusal != nil {\\n\\t\\trecordRefusal(err.Code, err.Detail)\\n\\t}\\n\\treturn err\\n}\\n\\n// UnsignedEvidenceBytes rebuilds the exact bytes an attestation signs: ASCII\\n// evidenceSignatureDomain, one zero byte, and the RFC 8785 JCS bytes of the\\n// evidence object with exactly evidence_id and attestation_signature\\n// omitted (§4.D). Timestamps reuse their validated source spellings so the\\n// rebuilt bytes match what the issuer signed.\\nfunc UnsignedEvidenceBytes(evidence Evidence) ([]byte, error) {\\n\\tobject := map[string]any{\\n\\t\\t\\\"schema\\\":                     SchemaCapabilityEvidence,\\n\\t\\t\\\"schema_version\\\":             SchemaVersion100,\\n===DESCRIPTOR===\\n15:// binding digest, backend ID/version, or generation does not match the\\n29:// generation) would admit a stale binding; the call order is parse,\\n31:// generation changes.\\n51:\\t\\\"backend_generation\\\",\\n59:// zero value is not valid (empty digest, empty generation, zero geometry),\\n69:\\tBackendGeneration     string\\n76:// digest, backend ID, versions, and generation. Instance identity,\\n83:\\t\\tGeneration:            descriptor.BackendGeneration,\\n171:\\tgeneration, err := descriptorText(object, \\\"backend_generation\\\")\\n176:\\t// its own arm; a descriptor generation outside it is the same\\n178:\\tif err := checkGeneration(generation); err != nil {\\n199:\\t\\tBackendGeneration:     generation,\\n\",\n  \"original_output_bytes\": 3264,\n  \"original_output_tokens\": 816,\n  \"truncated\": false\n}","final_result":true}}}
