idence=TASK-260803-323q82_review-verdict-rev2.md)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false},\\\"add_checklist_item\\\":{\\\"description\\\":\\\"Add a new checklist item\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\",\\\"required\\\":true},{\\\"name\\\":\\\"text\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Checklist item text\\\",\\\"required\\\":true}],\\\"examples\\\":[\\\"add_checklist_item(TASK-260218-abc123, text=\\\\\\\"Write unit tests\\\\\\\")\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false},\\\"add_resource\\\":{\\\"description\\\":\\\"Add a text resource to an element\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\",\\\"required\\\":true},{\\\"name\\\":\\\"name\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Resource name (e.g. research.md)\\\",\\\"required\\\":true},{\\\"name\\\":\\\"content\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Resource content (text); required if path is not provided\\\"},{\\\"name\\\":\\\"path\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Client-local file path (remote CLI inlines content; board-server rejects raw paths)\\\"},{\\\"name\\\":\\\"type\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"default\\\":\\\"outcome\\\",\\\"description\\\":\\\"Resource type\\\",\\\"enum\\\":[\\\"precondition\\\",\\\"outcome\\\"]},{\\\"name\\\":\\\"description\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"One-line description\\\"}],\\\"examples\\\":[\\\"add_resource(TASK-260218-abc123, name=\\\\\\\"research.md\\\\\\\", content=\\\\\\\"...\\\\\\\", type=outcome)\\\",\\\"add_resource(TASK-260218-abc123, name=\\\\\\\"spec.md\\\\\\\", path=\\\\\\\".temp/spec.md\\\\\\\", type=pre