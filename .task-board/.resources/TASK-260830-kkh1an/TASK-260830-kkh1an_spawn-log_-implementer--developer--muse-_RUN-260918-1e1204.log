sessrepo/lease_store.go-156-// holder the presenter claims.\\ninternal/sessrepo/lease_store.go-157-type FencingToken struct {\\ninternal/sessrepo/lease_store.go-158-\\tEpoch        uint64\\ninternal/sessrepo/lease_store.go-159-\\tLeaseID      string\\ninternal/sessrepo/lease_store.go-160-\\tHolderHostID string\\ninternal/sessrepo/lease_store.go-161-}\\ninternal/sessrepo/lease_store.go-162-\\ninternal/sessrepo/lease_store.go-163-// FencingGrant is the process-local authorization derived from a winning\\ninternal/sessrepo/lease_store.go-164-// lease at ValidatedAt. Grants are machine-local transient state: they are\\ninternal/sessrepo/lease_store.go-165-// never persisted and never replicated.\\ninternal/sessrepo/lease_store.go-166-type FencingGrant struct {\\ninternal/sessrepo/lease_store.go-167-\\tSessionID   string\\ninternal/sessrepo/lease_store.go-168-\\tRecordID    string\\ninternal/sessrepo/lease_store.go-169-\\tToken       FencingToken\\ninternal/sessrepo/lease_store.go-170-\\tValidatedAt time.Time\\ninternal/sessrepo/lease_store.go-171-}\\ninternal/sessrepo/lease_store.go-172-\\n====\\n70:\\tCommandTerminalBackendList   Command = \\\"terminal.backend.list\\\"\\n71:\\tCommandTerminalBackendShow   Command = \\\"terminal.backend.show\\\"\\n72:\\tCommandTerminalBackendProbe  Command = \\\"terminal.backend.probe\\\"\\n73:\\tCommandTerminalBackendDoctor Command = \\\"terminal.backend.doctor\\\"\\n\",\n  \"original_output_bytes\": 2187,\n  \"original_output_tokens\": 547,\n  \"truncated\": false\n}","final_result":true}}}
