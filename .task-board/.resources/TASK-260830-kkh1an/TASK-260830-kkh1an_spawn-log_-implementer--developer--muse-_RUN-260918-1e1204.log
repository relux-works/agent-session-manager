{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9bf","stream":{"kind":"session","id":"01a0b201-5e84-7ea0-8bc6-d79919cbe007"},"sequence":826,"recorded_at":1780531400001647,"record_type":"event","durability":"durable","causation_id":"9e30868d-563f-43f3-9fe7-d9ddb65377f0","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9e30868d-563f-43f3-9fe7-d9ddb65377f0","run_stream":{"kind":"run","id":"9e30868d-563f-43f3-9fe7-d9ddb65377f0"},"task_stream":{"kind":"task","id":"01a0b204-0e5e-7b23-952e-285c04cdc382"},"task_id":"01a0b204-0e5e-7b23-952e-285c04cdc382","event":{"kind":"output","task_id":"01a0b204-0e5e-7b23-952e-285c04cdc382","chunk":"Read text file `internal/axpane/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/axpane.\n3|\n4|Every gate ships a narrowing mutant: the gate stays present and is\n5|weakened to admit exactly one member of the class it must reject, and\n6|the named killer test must fail. A delete-only mutant proves only that\n7|the gate exists and is not accepted as evidence.\n8|\n9|Each row runs M (mutate one production file in place), R (run the\n10|scoped Go killer through the production entry point), V (verdict from\n11|the Go exit code plus a FAIL kill-line: KILLED iff R fails with a test\n12|failure line, SURVIVED iff R passes, ERROR for anything else —\n13|unapplied patches, build breaks, timeouts). M failures and R\n14|infrastructure errors are ERROR, never kills or survivals. The file is\n15|restored from its backup after every row, pass or fail.\n16|\n17|Row C-doc-comment is the harmless control: a comment-only edit that\n18|must SURVIVE, proving the harness observes test outcomes instead of\n19|hard-coding kills.\n20|\n21|Usage:\n22|  PYTHONDONTWRITEBYTECODE=1 python3 internal/axpane/mutant_harness.py\n23|  PYTHONDONTWRITEBYTECODE=1 python3 internal/axpane/mutant_harness.py N-config\n24|\"\"\"\n25|\n26|import os\n27|import shutil\n28|import subprocess\n29|import sys\n30|import tempfile\n31|from dataclasses import dataclass\n32|from pathlib import Path\n33|\n34|REPO = Path(__file__).resolve().parents[2]\n35|PACKAGE = \"internal/axpane\"\n36|\n37|\n38|@dataclass(frozen=True)\n39|class Mutant:\n40|    name: str\n41|    path: str\n42|    find: str\n43|    replace: str\n44|    count: int\n45|    run: str\n46|    expect: str\n47|    note: str\n48|\n49|\n50|MUTANTS = [\n51|    Mutant(\n52|        name=\"N-config\",\n53|        path=f\"{PACKAGE}/decide.go\",\n54|        find=\"\\tif input.ConfigErr != nil {\\n\",\n55|        replace=\"\\tif input.ConfigErr != nil && input.Mode == ModeRestore {\\n\",\n56|        count=1,\n57|        run=\"TestDecideTable/refused_config_invalid\",\n58|        expect=\"KILLED\",\n59|        note=\"Admits exactly launch-mode invalid config; restore-mode still refuses.\",\n60|    ),\n61|    Mutant(\n62|        name=\"N-mode\",\n63|        path=f\"{PACKAGE}/decide.go\",\n64|        find=\"\\tif input.Mode != ModeLaunch && input.Mode != ModeRestore {\\n\",\n65|        replace='\\tif input.Mode != ModeLaunch && input.Mode != ModeRestore && input.Mode != Mode(\"\") {\\n',\n66|        count=1,\n67|        run=\"TestDecideTable/refused_empty_mode\",\n68|        expect=\"KILLED\",\n69|        note=\"Admits exactly the empty mode; every other non-mode still refuses.\",\n70|    ),\n71|    Mutant(\n72|        name=\"N-session\",\n73|        path=f\"{PACKAGE}/decide.go\",\n74|        find=\"\\tif !input.SessionKnown {\\n\",\n75|        replace=\"\\tif !input.SessionKnown && input.Mode == ModeRestore {\\n\",\n76|        count=1,\n77|        run=\"TestDecideTable/refused_unknown_session\",\n78|        expect=\"KILLED\",\n79|        note=\"Admits exactly launch-mode unknown sessions; restore-mode still refuses.\",\n80|    ),\n81|    Mutant(\n82|        name=\"N-idempotency\",\n83|        path=f\"{PACKAGE}/decide.go\",\n84|        find=\"\\tif (input.ExistingBinding == nil || input.ExistingBinding.OperationID != input.BootstrapOperationID) && input.SessionBound && !bootstrapWindowClosed(input) {\\n\",\n85|        replace=\"\\tif (input.ExistingBinding == nil || input.ExistingBinding.OperationID != input.BootstrapOperationID) && input.SessionBound && !bootstrapWindowClosed(input) && input.Mode == ModeRestore {\\n\",\n86|        count=1,\n87|        run=\"TestDecideTable/refused_idempotency_mismatch\",\n88|        expect=\"KILLED\",\n89|        note=\"Admits exactly launch-mode changed operations inside the window; restore-mode still refuses.\",\n90|    ),\n91|    Mutant(\n92|        name=\"N-idempotency-restore\",\n93|        path=f\"{PACKAGE}/decide.go\",\n94|        find=\"\\tif (input.ExistingBinding == nil || input.ExistingBinding.OperationID != input.BootstrapOperationID) && input.SessionBound && !bootstrapWindowClosed(input) {\\n\",\n95|        replace=\"\\tif (input.ExistingBinding == nil || input.ExistingBinding.OperationID != input.BootstrapOperationID) && input.SessionBound && !bootstrapWindowClosed(input) && input.Mode == ModeLaunch {\\n\",\n96|        count=1,\n97|        run=\"TestDecideRestoreChangedOperationRefuses\",\n98|        expect=\"KILLED\",\n99|        note=\"Admits exactly restore-mode changed operations inside the window; launch-mode still refuses.\",\n100|    ),\n101|    Mutant(\n102|        name=\"N-idempotency-bound\",\n103|        path=f\"{PACKAGE}/decide.go\",\n104|        find=\"\\tif (input.ExistingBinding == nil || input.ExistingBinding.OperationID != input.BootstrapOperationID) && input.SessionBound && !bootstrapWindowClosed(input) {\\n\",\n105|        replace=\"\\tif (input.ExistingBinding == nil || input.ExistingBinding.OperationID != input.BootstrapOperationID) && input.SessionBound && !bootstrapWindowClosed(input) && input.ExistingBinding != nil {\\n\",\n106|        count=1,\n107|        run=\"TestDecideRestoreChangedOperationRefuses\",\n108|        expect=\"KILLED\",\n109|        note=\"Admits exactly unrecorded pairs on bound sessions, requiring a mismatched recorded receipt; other changed pairs still refuse.\",\n110|    ),\n111|    Mutant(\n112|        name=\"N-window-fold\",\n113|        path=f\"{PACKAGE}/decide.go\",\n114|        find=\"\\treturn input.HasNewestCheckpoint\\n\",\n115|        replace=\"\\treturn input.HasNewestCheckpoint || input.Mode == ModeLaunch\\n\",\n116|        count=1,\n117|        run=\"TestDecideTable/refused_idempotency_mismatch\",\n118|        expect=\"KILLED\",\n119|        note=\"Closes the window exactly on launch mode without a published checkpoint; restore-mode still refuses in-window.\",\n120|    ),\n121|    Mutant(\n122|        name=\"N-caller\",\n123|        path=f\"{PACKAGE}/decide.go\",\n124|        find=\"\\tif caller != CallerForeground && caller != CallerBackground {\\n\",\n125|        replace='\\tif caller != CallerForeground && caller != CallerBackground && caller != \"batch\" {\\n',\n126|        count=1,\n127|        run=\"TestDecideTable/refused_unknown_caller\",\n128|        expect=\"KILLED\",\n129|        note=\"Admits exactly the batch caller; every other non-caller still refuses.\",\n130|    ),\n131|    Mutant(\n132|        name=\"N-backend-op\",\n133|        path=f\"{PACKAGE}/decide.go\",\n134|        find='\\toperation := \"create\"\\n\\tif input.Mode == ModeRestore {\\n\\t\\toperation = \"restore\"\\n\\t}\\n',\n135|        replace='\\toperation := \"create\"\\n\\tif input.Mode == ModeRestore {\\n\\t\\toperation = \"create\"\\n\\t}\\n',\n136|        count=1,\n137|        run=\"TestDecideRestoreRequiresRestoreCapability\",\n138|        expect=\"KILLED\",\n139|        note=\"Admits restore-mode callers to the create row; the mode selection stays.\",\n140|    ),\n141|    Mutant(\n142|        name=\"N-materialization\",\n143|        path=f\"{PACKAGE}/decide.go\",\n144|        find=\"\\tif !input.JournalOK || input.Journal.Phase != matjournal.PhaseCommitted {\\n\",\n145|        replace=\"\\tif !input.JournalOK || (input.Journal.Phase != matjournal.PhaseCommitted && input.Journal.Phase != matjournal.PhaseStaging) {\\n\",\n146|        count=1,\n147|        run=\"TestDecideTable/parked_materialization_not_committed\",\n148|        expect=\"KILLED\",\n149|        note=\"Admits exactly staging journals; absent and other phases still park.\",\n150|    ),\n151|    Mutant(\n152|        name=\"N-materialization-source\",\n153|        path=f\"{PACKAGE}/decide.go\",\n154|        find=\"\\tif input.Journal.SourceCheckpointID != input.NewestCheckpointID {\\n\",\n155|        replace='\\tif input.Journal.SourceCheckpointID != input.NewestCheckpointID && input.Journal.SourceCheckpointID != \"sha256:d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2d2\" {\\n',\n156|        count=1,\n157|        run=\"TestDecideMaterializationStaleParks\",\n158|        expect=\"KILLED\",\n159|        note=\"Admits exactly the stale source generation; other stale sources still park.\",\n160|    ),\n161|    Mutant(\n162|        name=\"N-materialization-nullfold\",\n163|        path=f\"{PACKAGE}/decide.go\",\n164|        find=\"\\tif !input.HasNewestCheckpoint {\\n\\t\\treturn errMaterializationNoCheckpoint()\\n\\t}\\n\",\n165|        replace=\"\\tif !input.HasNewestCheckpoint && input.Mode == ModeLaunch {\\n\\t\\treturn errMaterializationNoCheckpoint()\\n\\t}\\n\",\n166|        count=1,\n167|        run=\"TestDecideJournalNullFoldParks\",\n168|        expect=\"KILLED\",\n169|        note=\"Admits exactly restore-mode journals with no published checkpoint past the null-fold arm; launch-mode still parks with the null cause.\",\n170|    ),\n171|    Mutant(\n172|        name=\"N-successor-nullfold\",\n173|        path=f\"{PACKAGE}/decide.go\",\n174|        find=\"\\tif input.Observation.HasWinner && input.Observation.Winner.HasCheckpoint && !input.HasNewestCheckpoint {\\n\",\n175|        replace=\"\\tif input.Observation.HasWinner && input.Observation.Winner.HasCheckpoint && !input.HasNewestCheckpoint && input.Mode == ModeLaunch {\\n\",\n176|        count=1,\n177|        run=\"TestDecideSuccessorNullFoldParks/restore_with_requirements\",\n178|        expect=\"KILLED\",\n179|        note=\"Admits exactly restore-mode successor null folds past the implication arm (the per-arm null cause surfaces instead); launch-mode still parks with the implication cause.\",\n180|    ),\n181|    Mutant(\n182|        name=\"N-checkpoint-nullfold\",\n183|        path=f\"{PACKAGE}/decide.go\",\n184|        find=\"\\tif !input.HasNewestCheckpoint {\\n\\t\\treturn nil, errCheckpointNoPublished()\\n\\t}\\n\",\n185|        replace=\"\\tif !input.HasNewestCheckpoint && input.Mode == ModeLaunch {\\n\\t\\treturn nil, errCheckpointNoPublished()\\n\\t}\\n\",\n186|        count=1,\n187|        run=\"TestDecideCheckpointNullFoldParks\",\n188|        expect=\"KILLED\",\n189|        note=\"Admits exactly restore-mode checkpoints with no published checkpoint past the null-fold arm; launch-mode still parks with the null cause.\",\n190|    ),\n191|    Mutant(\n192|        name=\"N-closure-source\",\n193|        path=f\"{PACKAGE}/run.go\",\n194|        find=\"\\t\\t\\t\\tloaded, err := LoadCheckpoint(stores.Ckpt, input.NewestCheckpointID)\\n\",\n195|        replace=\"\\t\\t\\t\\tloaded, err := LoadCheckpoint(stores.Ckpt, observation.Winner.Checkpoint)\\n\",\n196|        count=1,\n197|        run=\"TestRunPostTakeoverLaunchCarriesNewestClosureYoloToStandard\",\n198|        expect=\"KILLED\",\n199|        note=\"Reads the profile closure from the lease handoff base again instead of the fold newest; the yolo-to-standard launch carries the stale yolo closure.\",\n200|    ),\n201|    Mutant(\n202|        name=\"N-checkpoint-absent\",\n203|        path=f\"{PACKAGE}/decide.go\",\n204|        find=\"\\tif input.CheckpointRequired {\\n\",\n205|        replace=\"\\tif input.CheckpointRequired && len(input.CheckpointDoc) > 0 {\\n\",\n206|        count=1,\n207|        run=\"TestDecideTable/parked_checkpoint_absent\",\n208|        expect=\"KILLED\",\n209|        note=\"Admits exactly absent checkpoints; inadmissible bytes still park.\",\n210|    ),\n211|    Mutant(\n212|        name=\"N-checkpoint-prefix\",\n213|        path=f\"{PACKAGE}/decide.go\",\n214|        find=\"\\tif digest.String() != want {\\n\",\n215|        replace=\"\\tif digest.String()[:16] != want[:16] {\\n\",\n216|        count=1,\n217|        run=\"TestDecideTable/parked_checkpoint_flipped_digest\",\n218|        expect=\"KILLED\",\n219|        note=\"Admits exactly same-prefix digests; full comparison otherwise stays.\",\n220|    ),\n221|    Mutant(\n222|        name=\"N-identity-version\",\n223|        path=f\"{PACKAGE}/decide.go\",\n224|        find=\"\\tif err := provhost.VerifyIdentityBuild(facts.Identity, facts.Build); err != nil {\\n\",\n225|        replace='\\tif err := provhost.VerifyIdentityBuild(facts.Identity, facts.Build); err != nil && facts.Build.ProviderVersion != \"0.147.0\" {\\n',\n226|        count=1,\n227|        run=\"TestDecideTable/refused_provider_identity_other_provider\",\n228|        expect=\"KILLED\",\n229|        note=\"Admits exactly 0.147.0 identity mismatches; other versions still refuse.\",\n230|    ),\n231|    Mutant(\n232|        name=\"N-discovery\",\n233|        path=f\"{PACKAGE}/decide.go\",\n234|        find=\"\\tif facts.HasDiscovery {\\n\",\n235|        replace='\\tif facts.HasDiscovery && facts.DiscoveryContext.Home != \"\" {\\n',\n236|        count=1,\n237|        run=\"TestDecideTable/refused_discovery_empty_home\",\n238|        expect=\"KILLED\",\n239|        note=\"Admits exactly empty-home discovery; every other proof still verifies.\",\n240|    ),\n241|    Mutant(\n242|        name=\"N-smoke-verdict\",\n243|        path=f\"{PACKAGE}/decide.go\",\n244|        find=\"\\tif record.Verdict != resumesmoke.VerdictPass {\\n\",\n245|        replace=\"\\tif record.Verdict != resumesmoke.VerdictPass && record.Verdict != resumesmoke.VerdictFail {\\n\",\n246|        count=1,\n247|