{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9f1","stream":{"kind":"session","id":"01a0b201-5e84-7ea0-8bc6-d79919cbe007"},"sequence":851,"recorded_at":1780531400001697,"record_type":"event","durability":"durable","causation_id":"9e30868d-563f-43f3-9fe7-d9ddb65377f0","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9e30868d-563f-43f3-9fe7-d9ddb65377f0","run_stream":{"kind":"run","id":"9e30868d-563f-43f3-9fe7-d9ddb65377f0"},"task_stream":{"kind":"task","id":"01a0b204-1c7f-7be3-9ed8-0bda3ac16910"},"task_id":"01a0b204-1c7f-7be3-9ed8-0bda3ac16910","event":{"kind":"output","task_id":"01a0b204-1c7f-7be3-9ed8-0bda3ac16910","chunk":"Read text file `internal/axpane/mutant_harness.py`.\n(499 line(s) above)\n500|        replace='\\tif sessionID != input.SessionID && sessionID != \"0198f4c8-3e70-7a11-8a2b-1234567890ff\" {\\n',\n501|        count=1,\n502|        run=\"TestDecideForeignCheckpointParks\",\n503|        expect=\"KILLED\",\n504|        note=\"Admits exactly the foreign fixture session; other foreign sessions still park.\",\n505|    ),\n506|\n507|    Mutant(\n508|        name=\"N-realm-binding\",\n509|        path=f\"{PACKAGE}/decide.go\",\n510|        find=\"\\t\\tif object.TerminalBindingID != input.HostBinding.TerminalBindingID {\\n\",\n511|        replace='\\t\\tif object.TerminalBindingID != input.HostBinding.TerminalBindingID && object.TerminalBindingID != \"sha256:b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2b2\" {\\n',\n512|        count=1,\n513|        run=\"TestDecideRealmBindingMismatchRefuses/binding\",\n514|        expect=\"KILLED\",\n515|        note=\"Admits exactly the mismatched test binding; other mismatches still refuse.\",\n516|    ),\n517|    Mutant(\n518|        name=\"N-realm-generation\",\n519|        path=f\"{PACKAGE}/decide.go\",\n520|        find=\"\\tif input.Realm.ServerGeneration != input.Backend.RawGeneration {\\n\",\n521|        replace='\\tif input.Realm.ServerGeneration != input.Backend.RawGeneration && input.Realm.ServerGeneration != \"generation-stale\" {\\n',\n522|        count=1,\n523|        run=\"TestDecideRealmBindingMismatchRefuses/generation\",\n524|        expect=\"KILLED\",\n525|        note=\"Admits exactly the stale test generation; other stale generations still refuse.\",\n526|    ),\n527|    Mutant(\n528|        name=\"N-headless\",\n529|        path=f\"{PACKAGE}/decide.go\",\n530|        find=\"\\tif input.Mode == ModeLaunch && !input.Interactive && !admitted.Has(headlessCreationCapability) {\\n\",\n531|        replace='\\tif input.Mode == ModeLaunch && !input.Interactive && !admitted.Has(headlessCreationCapability) && !admitted.Has(\"durable_disconnect\") {\\n',\n532|        count=1,\n533|        run=\"TestDecideNonInteractiveRequiresHeadless\",\n534|        expect=\"KILLED\",\n535|        note=\"Admits exactly durable-holding non-interactive creates without headless; other creates still refuse.\",\n536|    ),\n537|    Mutant(\n538|        name=\"N-emit-mutation\",\n539|        path=f\"{PACKAGE}/events.go\",\n540|        find=\"\\tif _, err := fencing.AuthorizeMutation(params.Presented, params.Observation); err != nil {\\n\",\n541|        replace=\"\\tif _, err := fencing.AuthorizeMutation(params.Presented, params.Observation); err != nil && params.Observation.Verified {\\n\",\n542|        count=1,\n543|        run=\"TestEmitParkedVocabularyLoop/refuses_unverified\",\n544|        expect=\"KILLED\",\n545|        note=\"Admits exactly unverified emissions; verified refusals still refuse.\",\n546|    ),\n547|    Mutant(\n548|        name=\"N-parked-fold\",\n549|        path=f\"{PACKAGE}/events.go\",\n550|        find=\"\\tif !foldable {\\n\",\n551|        replace=\"\\tif !foldable && decision.ParkReason != fencing.ParkRestorePolicy {\\n\",\n552|        count=1,\n553|        run=\"TestEmitParkedUnfoldableRefuses\",\n554|        expect=\"KILLED\",\n555|        note=\"Admits exactly unfolderable restore_policy parks; other unfolderable reasons still refuse.\",\n556|    ),\n557|    Mutant(\n558|        name=\"N-run-fold\",\n559|        path=f\"{PACKAGE}/run.go\",\n560|        find=\"\\t\\tif !foldable {\\n\",\n561|        replace=\"\\t\\tif !foldable && decision.ParkReason != fencing.ParkRestorePolicy {\\n\",\n562|        count=1,\n563|        run=\"TestRunParkedUnfoldableSkipsEmission\",\n564|        expect=\"KILLED\",\n565|        note=\"Run admits exactly unfolderable restore_policy parks; other unfolderable still skip.\",\n566|    ),\n567|    Mutant(\n568|        name=\"N-run-ckpt-store\",\n569|        path=f\"{PACKAGE}/run.go\",\n570|        find=\"\\tif known && input.HasNewestCheckpoint && stores.Ckpt == nil {\\n\",\n571|        replace=\"\\tif known && input.HasNewestCheckpoint && stores.Ckpt == nil && request.Mode == ModeRestore {\\n\",\n572|        count=1,\n573|        run=\"TestRunNoCkptStorePublishedNewestFails\",\n574|        expect=\"KILLED\",\n575|        note=\"Admits exactly launch-mode runs with a published newest and no store (the head pair launches); restore-mode still fails.\",\n576|    ),\n577|    Mutant(\n578|        name=\"N-window-lease-checkpoint\",\n579|        path=f\"{PACKAGE}/decide.go\",\n580|        find=\"\\treturn input.HasNewestCheckpoint\\n}\\n\",\n581|        replace=\"\\treturn input.HasNewestCheckpoint || (input.Observation.HasWinner && input.Observation.Winner.HasCheckpoint)\\n}\\n\",\n582|        count=1,\n583|        run=\"TestRunWindowLeaseCheckpointNullFoldRefuses\",\n584|        expect=\"KILLED\",\n585|        note=\"Closes the window on the lease record's checkpoint while the fold names none; the null-fold changed op launches instead of refusing.\",\n586|    ),\n587|    Mutant(\n588|        name=\"N-run-fold-error\",\n589|        path=f\"{PACKAGE}/run.go\",\n590|        find=\"\\t\\thas, newest, err := LoadNewestCheckpoint(stores.Repo, request.SessionID)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn empty, err\\n\\t\\t}\\n\",\n591|        replace=\"\\t\\thas, newest, err := LoadNewestCheckpoint(stores.Repo, request.SessionID)\\n\\t\\tif err != nil {\\n\\t\\t\\thas, newest = false, \\\"\\\"\\n\\t\\t}\\n\",\n592|        count=1,\n593|        run=\"TestRunUnfoldableChainFails\",\n594|        expect=\"KILLED\",\n595|        note=\"Launders an unfoldable chain as a null fold; Run parks instead of failing with the fold error.\",\n596|    ),\n597|    Mutant(\n598|        name=\"N-supersede-replay\",\n599|        path=f\"{PACKAGE}/run.go\",\n600|        find=\"\\t\\t\\tif replayed {\\n\",\n601|        replace=\"\\t\\t\\tif replayed && input.Mode == ModeLaunch {\\n\",\n602|        count=1,\n603|        run=\"TestRunPostWindowSamePairRaceReattaches\",\n604|        expect=\"KILLED\",\n605|        note=\"Keeps launch on the post-window replay exactly in restore mode; launch-mode replays still reattach.\",\n606|    ),\n607|    Mutant(\n608|        name=\"N-identity-session\",\n609|        path=f\"{PACKAGE}/decide.go\",\n610|        find=\"\\tif session.String() != sessionID {\\n\",\n611|        replace='\\tif session.String() != sessionID && session.String() != \"0198f4c8-3e70-7a11-8a2b-1234567890ff\" {\\n',\n612|        count=1,\n613|        run=\"TestDecideIdentityForeignSessionRefuses\",\n614|        expect=\"KILLED\",\n615|        note=\"Admits exactly the foreign fixture session's identity record; other foreign sessions still refuse.\",\n616|    ),\n617|    Mutant(\n618|        name=\"N-run-newest-absent\",\n619|        path=f\"{PACKAGE}/run.go\",\n620|        find=\"\\t\\t\\t\\tif len(loaded) == 0 {\\n\",\n621|        replace=\"\\t\\t\\t\\tif len(loaded) == 0 && request.Mode == ModeLaunch {\\n\",\n622|        count=1,\n623|        run=\"TestRunNewestAbsentFromStoreFails/restore\",\n624|        expect=\"KILLED\",\n625|        note=\"Admits exactly restore-mode runs with the newest absent from the store (the head pair launches); launch-mode still fails.\",\n626|    ),\n627|    Mu