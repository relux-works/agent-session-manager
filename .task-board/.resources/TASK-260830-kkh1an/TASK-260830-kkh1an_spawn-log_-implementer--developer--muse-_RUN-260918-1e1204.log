 order=ascending, view=raw)\\\",\\\"activity(TASK-XX, cursor=opaque-cursor, limit=25, kinds=progress, view=effective)\\\"]},\\\"agents\\\":{\\\"description\\\":\\\"List agents and their assigned elements\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"stale\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Stale threshold in minutes for done items\\\"}],\\\"examples\\\":[\\\"agents()\\\",\\\"agents(stale=60)\\\"]},\\\"context\\\":{\\\"description\\\":\\\"Get one Context Registry record by CTX id\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"CTX identifier\\\"}],\\\"examples\\\":[\\\"context(CTX-260728-a1b2c3) { selection }\\\",\\\"context(CTX-260728-a1b2c3) { identity binding lineage freshness security payload lifecycle }\\\"]},\\\"context_boundary\\\":{\\\"description\\\":\\\"Project one context's declared coverage boundary\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"CTX identifier\\\"},{\\\"name\\\":\\\"detail\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"default\\\":\\\"banner\\\",\\\"description\\\":\\\"manifest includes the full boundary document\\\",\\\"enum\\\":[\\\"banner\\\",\\\"manifest\\\"]}],\\\"examples\\\":[\\\"context_boundary(CTX-260728-a1b2c3, detail=manifest)\\\"]},\\\"context_candidates\\\":{\\\"description\\\":\\\"Board-side context candidate projection for one target element and target role, ordered by scope distance then role affinity\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"element\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Target board element\\\"},{\\\"name\\\":\\\"role\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Target role the run will execute as; keeps same-role, allowed predecessor, and project-producer snapshots and ranks them by affinity\\\"},{\\\"name\\\":\\\"producer_role\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Opt-in exact producer-role filter\\\"},{\\\"name\\\":\\\"provider\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Provider lineage\\\",\\\"enum\\\":[\\\"codex\\\",\\\"claude\\\"]},{\\\"name\\\":\\\"kind\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Output kind\\\",\\\"enum\\\":[\\\"project\\\",\\\"role\\\",\\\"task\\\"]},{\\\"name\\\":\\\"state\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"default\\\":\\\"ready\\\",\\\"description\\\":\\\"Comma-separated lifecycle states\\\"},{\\\"name\\\":\\\"skip\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"default\\\":0,\\\"description\\\":\\\"Candidates to skip\\\"},{\\\"name\\\":\\\"take\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"default\\\":20,\\\"description\\\":\\\"Maximum candidates to return\\\"}],\\\"examples\\\":[\\\"context_candidates(element=TASK-260728-abc123, role=developer, provider=codex) { selection }\\\",\\\"context_candidates(element=TASK-260728-abc123, producer_role=solution-architect) { selection }\\\"]},\\\"context_retention\\\":{\\\"description\\\":\\\"Retention outlook:\\n[tool output bounded: strategy=head, original_bytes=44944, visible_bytes=40000]\\n<system-reminder>\\nFull output saved to: /Users/iv/.local/share/muse/sessions/2026/09/18/01a0b201-5e84-7ea0-8bc6-d79919cbe007/tool-outputs/01a0b202-35c3-7501-9efd-c2dc95333a21/call_01a0b202325977c1b0ffdf0107fb8c37-bash.txt\\nFull output is longer than the visible window.\\nUse bash tools like head, tail, cat, sed, or grep to inspect and search the full output.\\n</system-reminder>\",\n  \"original_output_bytes\": 44944,\n  \"original_output_tokens\": 11236,\n  \"truncated\": true\n}","final_result":true}}}
