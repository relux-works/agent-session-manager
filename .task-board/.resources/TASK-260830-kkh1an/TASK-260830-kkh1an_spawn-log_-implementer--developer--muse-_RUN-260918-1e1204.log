orted, and unknown still refuse.\",\n250|    ),\n251|    Mutant(\n252|        name=\"N-smoke-version\",\n253|        path=f\"{PACKAGE}/decide.go\",\n254|        find=\"\"\"\\tif record.Tuple.ProviderID != build.ProviderID ||\n255|\\t\\trecord.Tuple.ProviderVersion != build.ProviderVersion ||\n256|\\t\\trecord.Tuple.Platform != build.Platform ||\n257|\\t\\trecord.Tuple.Architecture != build.Architecture {\n258|\"\"\",\n259|        replace=\"\"\"\\tif record.Tuple.ProviderID != build.ProviderID ||\n260|\\t\\trecord.Tuple.Platform != build.Platform ||\n261|\\t\\trecord.Tuple.Architecture != build.Architecture {\n262|\"\"\",\n263|        count=1,\n264|        run=\"TestDecideTable/refused_smoke_wrong_build\",\n265|        expect=\"KILLED\",\n266|        note=\"Admits exactly version drift; provider, platform, and arch still bind.\",\n267|    ),\n268|    Mutant(\n269|        name=\"N-smoke-mode\",\n270|        path=f\"{PACKAGE}/decide.go\",\n271|        find=\"\\tif !input.Smoke.Required {\\n\",\n272|        replace=\"\\tif !input.Smoke.Required || input.Mode == ModeLaunch {\\n\",\n273|        count=1,\n274|        run=\"TestDecideTable/refused_smoke_absent\",\n275|        expect=\"KILLED\",\n276|        note=\"Skips the required smoke exactly on launch; restore-mode still enforces it.\",\n277|    ),\n278|    Mutant(\n279|        name=\"N-profile-derive\",\n280|        path=f\"{PACKAGE}/decide.go\",\n281|        find=\"\"\"\\tpair, err := deriveProfile(input)\n282|\\tif err != nil {\n283|\\t\\treturn refused(ClassIntegrityFailure, \"effective profile derivation failed\", err)\n284|\\t}\n285|\"\"\",\n286|        replace=\"\"\"\\tpair, err := deriveProfile(input)\n287|\\tif err != nil && input.Provider.Build.ProviderID != \"codex\" {\n288|\\t\\treturn refused(ClassIntegrityFailure, \"effective profile derivation failed\", err)\n289|\\t}\n290|\"\"\",\n291|        count=1,\n292|        run=\"TestDecideTable/refused_profile_derivation_corrupt\",\n293|        expect=\"KILLED\"