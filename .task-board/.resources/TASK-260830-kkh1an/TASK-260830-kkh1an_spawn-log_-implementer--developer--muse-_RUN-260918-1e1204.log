{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c531","stream":{"kind":"session","id":"01a0b201-5e84-7ea0-8bc6-d79919cbe007"},"sequence":243,"recorded_at":1780531400000481,"record_type":"event","durability":"durable","causation_id":"9e30868d-563f-43f3-9fe7-d9ddb65377f0","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9e30868d-563f-43f3-9fe7-d9ddb65377f0","run_stream":{"kind":"run","id":"9e30868d-563f-43f3-9fe7-d9ddb65377f0"},"task_stream":{"kind":"task","id":"01a0b201-fadd-7471-ac41-6e15a3bceed1"},"task_id":"01a0b201-fadd-7471-ac41-6e15a3bceed1","event":{"kind":"output","task_id":"01a0b201-fadd-7471-ac41-6e15a3bceed1","chunk":"Read text file `internal/terminalbackend/conformance.go`.\n1|// Lifecycle, attach, entrypoint, replication, and historical-translation\n2|// conformance for the TerminalBackend registry.\n3|//\n4|// Normative scope is relux-works/agent-session-manager-spec@v0.5.0 §4.A\n5|// (authority: attach changes no ownership; every backend-created runtime\n6|// executes exactly `ax pane SESSION_ID`), §4.C (lifecycle state machine,\n7|// transition/authorization/idempotency table), §4.D (attach authorization\n8|// neutrality and capability dependencies, enforced by manifest.go), §4.E\n9|// (replication classification and v0.4.3 historical translation), §4.1\n10|// (backend interface operations and the idempotent bootstrap binding), §6.5\n11|// (platform defaults select only new activation), and §7.A (provider-side\n12|// descriptor binding, enforced by CheckProviderDescriptor in\n13|// terminalbackend.go).\n14|//\n15|// Section 4.B names this deliverable: \"M0 exposes only an internal semantic\n16|// interface and conformance harness\". This file is that harness: it proves\n17|// the semantics over admitted registry state but performs no I/O, launches\n18|// no backend, and holds no authority beyond refusing contract violations.\n19|// Capability gating stays in manifest.go (CheckOperation, Reconcile); trust\n20|// stays in terminalbackend.go (RegisterExternal, DigestFile). A refusal here\n21|// is an *Error with a wire code from the pinned catalog error vocabulary\n22|// and a static Detail clause, following the package convention.\n23|package terminalbackend\n24|\n25|import (\n26|\t\"sort\"\n27|\t\"strings\"\n28|\t\"sync\"\n29|\t\"time\"\n30|\n31|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n32|)\n33|\n34|// Wire error codes this file may report. Each is a member of the pinned\n35|// catalog error vocabulary; TestWireCodesAreCatalogued proves no other code\n36|// is advertised.\n37|const (\n38|\t// CodeProtocolError reports an unknown operation, state, or member, a\n39|\t// body variant outside the closed §4.C matrix, or an error code the\n40|\t// backend MUST NOT emit for the operation (§4.B, §4.C). AX-local\n41|\t// parsing may additionally emit it for a syntactically valid request\n42|\t// the matrix does not cover.\n43|\tCodeProtocolError = \"terminal_backend_protocol_error\"\n44|\t// CodeUnauthorized reports an expired, mismatched, or otherwise\n45|\t// unsatisfiable attach authorization (§4.C attach row).\n46|\tCodeUnauthorized = \"terminal_backend_unauthorized\"\n47|\t// CodeUnavailable reports a backend that cannot serve the operation.\n48|\t// It appears here only inside the allowed-error sets: no conformance\n49|\t// refusal in this file emits it, so it carries no arm of its own.\n50|\tCodeUnavailable = \"terminal_backend_unavailable\"\n51|\t// CodePreconditionFailed reports a legal request against an illegal\n52|\t// source state, a non-conforming stable entrypoint, or any other\n53|\t// unmet local precondition (§4.C per-operation rows, §4.1).\n54|\tCodePreconditionFailed = \"local_precondition_failed\"\n55|\t// CodeIdempotencyMismatch reports a changed operation inside an\n56|\t// established idempotency window (§4.C, §4.1).\n57|\tCodeIdempotencyMismatch = \"idempotency_mismatch\"\n58|\t// CodeIncompatibleSchema reports a legacy identity with no canonical\n59|\t// projection, or a canonical identity with no legacy projection\n60|\t// (§4.E). It never falls back.\n61|\tCodeIncompatibleSchema = \"incompatible_schema\"\n62|)\n63|\n64|// IsProtocolError reports CodeProtocolError refusals.\n65|func IsProtocolError(err error) bool { return errorCode(err, CodeProtocolError) }\n66|\n67|// IsUnauthorized reports CodeUnauthorized refusals.\n68|func IsUnauthorized(err error) bool { return errorCode(err, CodeUnauthorized) }\n69|\n70|// IsPreconditionFailed reports CodePreconditionFailed refusals.\n71|func IsPreconditionFailed(err error) bool { return errorCode(err, CodePreconditionFailed) }\n72|\n73|// IsIdempotencyMismatch reports CodeIdempotencyMismatch refusals.\n74|func IsIdempotencyMismatch(err error) bool { return errorCode(err, CodeIdempotencyMismatch) }\n75|\n76|// IsIncompatibleSchema reports CodeIncompatibleSchema refusals.\n77|func IsIncompatibleSchema(err error) bool { return errorCode(err, CodeIncompatibleSchema) }\n78|\n79|// InstanceState is the closed §4.C TerminalInstanceState enum: local\n80|// hosting only, never a second ownership state machine.\n81|type InstanceState string\n82|\n83|// Terminal Instance states.\n84|const (\n85|\tStateAbsent      InstanceState = \"absent\"\n86|\tStateCreating    InstanceState = \"creating\"\n87|\tStateParked      InstanceState = \"parked\"\n88|\tStateActive      InstanceState = \"active\"\n89|\tStateQuiescing   InstanceState = \"quiescing\"\n90|\tStateStopped     InstanceState = \"stopped\"\n91|\tStateStaleFenced InstanceState = \"stale_fenced\"\n92|\tStateUnavailable InstanceState = \"unavailable\"\n93|)\n94|\n95|// ParseInstanceState admits exactly the eight §4.C states.\n96|func ParseInstanceState(value string) (InstanceState, error) {\n97|\tswitch InstanceState(value) {\n98|\tcase StateAbsent, StateCreating, StateParked, StateActive,\n99|\t\tStateQuiescing, StateStopped, StateStaleFenced, StateUnavailable:\n100|\t\treturn InstanceState(value), nil\n101|\tdefault:\n102|\t\treturn \"\", refuse(&Error{Code: CodeProtocolError, Detail: \"lifecycle state vocabulary\"})\n103|\t}\n104|}\n105|\n106|// Operation is the closed §4.D TerminalBackendOperation enum.\n107|type Operation string\n108|\n109|// Terminal backend operations.\n110|const (\n111|\tOperationManifest         Operation = \"manifest\"\n112|\tOperationProbe            Operation = \"probe\"\n113|\tOperationCreate           Operation = \"create\"\n114|\tOperationAttach           Operation = \"attach\"\n115|\tOperationStatus           Operation = \"status\"\n116|\tOperationQuiesceInput     Operation = \"quiesce-input\"\n117|\tOperationWaitSafeBoundary Operation = \"wait-safe-boundary\"\n118|\tOperationRequestStop      Operation = \"request-stop\"\n119|\tOperationTerminateStale   Operation = \"terminate-stale\"\n120|\tOperationRestore          Operation = \"restore\"\n121|)\n122|\n123|// ParseOperation admits exactly the ten §4.D operations.\n124|func ParseOperation(value string) (Operation, error) {\n125|\tswitch Operation(value) {\n126|\tcase OperationManifest, OperationProbe, OperationCreate, OperationAttach,\n127|\t\tOperationStatus, OperationQuiesceInput, OperationWaitSafeBoundary,\n128|\t\tOperationRequestStop, OperationTerminateStale, OperationRestore:\n129|\t\treturn Operation(value), nil\n130|\tdefault:\n131|\t\treturn \"\", refuse(&Error{Code: CodeProtocolError, Detail: \"operation vocabulary\"})\n132|\t}\n133|}\n134|\n135|// SideEffect is the closed §4.C TerminalBackendSideEffect enum.\n136|type SideEffect string\n137|\n138|// Terminal backend side effects.\n139|const (\n140|\tEffectBindingPersisted           SideEffect = \"binding_persisted\"\n141|\tEffectWrapperStarted             SideEffect = \"wrapper_started\"\n142|\tEffectAttachClientCreated        SideEffect = \"attach_client_created\"\n143|\tEffectInputClosed                SideEffect = \"input_closed\"\n144|\tEffectSafeBoundaryObserved       SideEffect = \"safe_boundary_observed\"\n145|\tEffectGracefulStopRequested      SideEffect = \"graceful_stop_requested\"\n146|\tEffectProcessClosed              SideEffect = \"process_closed\"\n147|\tEffectBackendStoreClosed         SideEffect = \"backend_store_closed\"\n148|\tEffectStaleIncarnationTerminated SideEffect = \"stale_incarnation_terminated\"\n149|\tEffectWrapperRestored            SideEffect = \"wrapper_restored\"\n150|)\n151|\n152|// PresentationTransport is the closed §4.E presentation transport enum.\n153|// Only the first two are admittable; a relay-required backend is\n154|// unavailable pending explicit future product/contract approval, so no\n155|// constructor admits it here.\n156|type PresentationTransport string\n157|\n158|// Presentation transports.\n159|const (\n160|\tTransportLocalOnly          PresentationTransport = \"local_only\"\n161|\tTransportTrustedPrivateMesh PresentationTransport = \"trusted_private_mesh\"\n162|\tTransportThirdPartyRelay    PresentationTransport = \"third_party_relay\"\n163|)\n164|\n165|// parseTransport admits exactly the closed transport vocabulary. The relay\n166|// member parses so a request naming it is classified rather than\n167|// misreported, but CheckAttachRequest refuses it: current AX admits only\n168|// the first two.\n169|func parseTransport(value string) (PresentationTransport, error) {\n170|\tswitch PresentationTransport(value) {\n171|\tcase TransportLocalOnly, TransportTrustedPrivateMesh, TransportThirdPartyRelay:\n172|\t\treturn PresentationTransport(value), nil\n173|\tdefault:\n174|\t\treturn \"\", refuse(&Error{Code: CodeProtocolError, Detail: \"presentation transport vocabulary\"})\n175|\t}\n176|}\n177|\n178|// Authorization kinds carried by the transition table. \"attach\" names the\n179|// ownership-neutral AttachAuthorization below; every other mutating kind\n180|// names an AXAuthorization lease tuple, which this harness does not mint\n181|// (no lease implementation exists here) but does name so the table stays\n182|// exact.\n183|const (\n184|\tauthorizationNone       = \"none\"\n185|\tauthorizationCreate     = \"create\"\n186|\tauthorizationAttach     = \"attach\"\n187|\tauthorizationControl    = \"control\"\n188|\tauthorizationForceStale = \"force_stale\"\n189|\tauthorizationRestore    = \"restore\"\n190|)\n191|\n192|// Transition is one exact §4.C table row: the allowed sources, the success\n193|// target, and the exact side effects for one operation.\n194|type Transition struct {\n195|\tOperation     Operation\n196|\tSources       []InstanceState\n197|\tTarget        InstanceState\n198|\tTargetParked  bool\n199|\tEffects       []SideEffect\n200|\tAuthorization string\n201|\t// InstanceScoped is false for manifest and probe, which carry no\n202|\t// Terminal Instance source or target and no side effects.\n203|\tInstanceScoped bool\n204|\t// SameState marks status: every source is allowed and the success\n205|\t// state is the source itself, with no side effect.\n206|\tSameState bool\n207|}\n208|\n209|// transitionTable is the exact §4.C transition matrix. create carries two\n210|// targets: active when interactive, otherwise parked.\n211|var transitionTable = []Transition{\n212|\t{Operation: OperationManifest, InstanceScoped: false, Authorization: authorizationNone},\n213|\t{Operation: OperationProbe, InstanceScoped: false, Authorization: authorizationNone},\n214|\t{\n215|\t\tOperation: OperationCreate,\n216|\t\tSources:   []InstanceState{StateAbsent, StateStopped},\n217|\t\tTarget:    StateActive, TargetParked: true,\n218|\t\tEffects:        []SideEffect{EffectBindingPersisted, EffectWrapperStarted},\n219|\t\tAuthorization:  authorizationCreate,\n220|\t\tInstanceScoped: true,\n221|\t},\n222|\t{\n223|\t\tOperation:      OperationAttach,\n224|\t\tSources:        []InstanceState{StateParked, StateActive},\n225|\t\tTarget:         StateActive,\n226|\t\tEffects:        []SideEffect{EffectAttachClientCreated},\n227|\t\tAuthorization:  authorizationAttach,\n228|\t\tInstanceScoped: true,\n229|\t},\n230|\t{\n231|\t\tOperation: OperationStatus,\n232|\t\tSources: []InstanceState{\n233|\t\t\tStateAbsent, StateCreating, StateParked, StateActive,\n234|\t\t\tStateQuiescing, StateStopped, StateStaleFenced, StateUnavailable,\n235|\t\t},\n236|\t\tSameState:      true,\n237|\t\tAuthorization:  authorizationNone,\n238|\t\tInstanceScoped: true,\n239|\t},\n240|\t{\n241|\t\tOperation:      OperationQuiesceInput,\n242|\t\tSources:        []InstanceState{StateActive, StateParked},\n243|\t\tTarget:         StateQuiescing,\n244|\t\tEffects:        []SideEffect{EffectInputClosed},\n245|\t\tAuthorization:  authorizationControl,\n246|\t\tInstanceScoped: true,\n247|\t},\n248|\t{\n249|\t\tOperation:      OperationWaitSafeBoundary,\n250|\t\tSources:        []InstanceState{StateQuiescing},\n251|\t\tTarget:         StateQuiescing,\n252|\t\tEffects:        []SideEffect{EffectSafeBoundaryObserved},\n253|\t\tAuthorization:  authorizationControl,\n254|\t\tInstanceScoped: true,\n255|\t},\n256|\t{\n257|\t\tOperation:      OperationRequestStop,\n258|\t\tSources:        []InstanceState{StateQuiescing},\n259|\t\tTarget:         StateStopped,\n260|\t\tEffects:        []SideEffect{EffectGracefulStopRequested, EffectProcessClosed, EffectBackendStoreClosed},\n261|\t\tAuthorization:  authorizationControl,\n262|\t\tInstanceScoped: true,\n263|\t},\n264|\t{\n265|\t\tOperation:      OperationTerminateStale,\n266|\t\tSources:        []InstanceState{StateStaleFenced, StateUnavailable},\n267|\t\tTarget:         StateStopped,\n268|\t\tEffects:        []SideEffect{EffectStaleIncarnationTerminated, EffectProcessClosed},\n269|\t\tAuthorization:  authorizationForceStale,\n270|\t\tInstanceScoped: true,\n271|\t},\n272|\t{\n273|\t\tOperation:      OperationRestore,\n274|\t\tSources:        []InstanceState{StateAbsent, StateStopped, StateUnavailable},\n275|\t\tTarget:         StateParked,\n276|\t\tEffects:        []SideEffect{EffectBindingPersisted, EffectWrapperRestored},\n277|\t\tAuthorization:  authorizationRestore,\n278|\t\tInstanceScoped: true,\n279|\t},\n280|}\n281|\n282|// lookupTransition returns the table row for one operation.\n283|func lookupTransition(operation Operation) (Transition, bool) {\n284|\tfor _, row := range transitionTable {\n285|\t\tif row.Operation == operation {\n286|\t\t\treturn row, true\n287|\t\t}\n288|\t}\n289|\treturn Transition{}, false\n290|}\n291|\n292|// CheckTransition enforces the §4.C transition matrix. It returns the\n293|// success target state and the exact side effects. create resolves its\n294|// target from interactive: active when interactive, otherwise parked. A\n295|// state reached only by AX fencing observation (stale_fenced) is never\n296|// entered here: no backend operation targets it, so a row naming it as a\n297|// target cannot exist and CheckTransition cannot return it except as a\n298|// status observation of the source itself.\n299|//\n300|// An unknown operation or state is a protocol error; a known operation\n301|// against a disallowed source is a failed local precondition. Only\n302|// quiesce-input enters quiescing, and creating is never a success target:\n303|// it exists only between the idempotency receipt and the first side\n304|// effect, which the Ledger below owns.\n305|func CheckTransition(operation, source string, interactive bool) (InstanceState, []SideEffect, error) {\n306|\tparsedOperation, err := ParseOperation(operation)\n307|\tif err != nil {\n308|\t\treturn \"\", nil, err\n309|\t}\n310|\trow, known := lookupTransition(parsedOperation)\n311|\tif !known {\n312|\t\treturn \"\", nil, refuse(&Error{Code: CodeProtocolError, Detail: \"operation vocabulary\"})\n313|\t}\n314|\tif !row.InstanceScoped {\n315|\t\tif source != \"\" {\n316|\t\t\treturn \"\", nil, refuse(&Error{Code: CodePreconditionFailed, Detail: \"lifecycle instance scope\"})\n317|\t\t}\n318|\t\treturn \"\", nil, nil\n319|\t}\n320|\tparsedSource, err := ParseInstanceState(source)\n321|\tif err != nil {\n322|\t\treturn \"\", nil, err\n323|\t}\n324|\tallowed := false\n325|\tfor _, candidate := range row.Sources {\n326|\t\tif candidate == parsedSource {\n327|\t\t\tallowed = true\n328|\t\t\tbreak\n329|\t\t}\n330|\t}\n331|\tif !allowed {\n332|\t\treturn \"\", nil, refuse(&Error{Code: CodePreconditionFailed, Detail: \"lifecycle transition\"})\n333|\t}\n334|\tif row.SameState {\n335|\t\treturn parsedSource, nil, nil\n336|\t}\n337|\tif parsedOperation == OperationCreate && !interactive {\n338|\t\treturn StateParked, append([]SideEffect(nil), row.Effects...), nil\n339|\t}\n340|\treturn row.Target, append([]SideEffect(nil), row.Effects...), nil\n341|}\n342|\n343|// allowedOperationErrors is the exact §4.C \"Allowed error codes\" column.\n344|// An error not listed for an operation MUST NOT be emitted by the backend\n345|// for a syntactically valid request; AX-local parsing may additionally\n346|// emit terminal_backend_protocol_error, which every row therefore carries.\n347|var allowedOperationErrors = map[Operation][]string{\n348|\tOperationManifest: {\n349|\t\tCodeProtocolError, \"terminal_backend_protocol_incompatible\",\n350|\t\t\"terminal_backend_process_failed\", \"terminal_backend_timeout\",\n351|\t\tCodeIntegrityFailure,\n352|\t},\n353|\tOperationProbe: {\n354|\t\tCodeUntrusted, CodeMismatch, CodeDrift,\n355|\t\tCodeProtocolError, \"terminal_backend_process_failed\", \"terminal_backend_timeout\",\n356|\t\tCodeIntegrityFailure,\n357|\t},\n358|\tOperationCreate: {\n359|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n360|\t\tCodeStaleGeneration, CodeCapabilityUnproven, CodeUnavailable,\n361|\t\t\"terminal_backend_timeout\", \"terminal_backend_process_failed\",\n362|\t\tCodeIntegrityFailure, CodeProtocolError,\n363|\t},\n364|\tOperationAttach: {\n365|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n366|\t\tCodeStaleGeneration, CodeCapabilityUnproven, CodeUnavailable,\n367|\t\t\"terminal_backend_timeout\", \"terminal_backend_process_failed\",\n368|\t\tCodeIntegrityFailure, CodeProtocolError,\n369|\t},\n370|\tOperationStatus: {\n371|\t\tCodeStaleGeneration, CodeCapabilityUnproven, CodeUnavailable,\n372|\t\t\"terminal_backend_timeout\", CodeIntegrityFailure, CodeProtocolError,\n373|\t},\n374|\tOperationQuiesceInput: {\n375|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n376|\t\tCodeStaleGeneration, CodeCapabilityUnproven,\n377|\t\t\"terminal_backend_timeout\", CodeIntegrityFailure, CodeProtocolError,\n378|\t},\n379|\tOperationWaitSafeBoundary: {\n380|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n381|\t\tCodeStaleGeneration, CodeCapabilityUnproven,\n382|\t\t\"quiesce_timeout\", CodeIntegrityFailure, CodeProtocolError,\n383|\t},\n384|\tOperationRequestStop: {\n385|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n386|\t\tCodeStaleGeneration, CodeCapabilityUnproven,\n387|\t\t\"stop_timeout\", \"terminal_backend_process_failed\",\n388|\t\tCodeIntegrityFailure, CodeProtocolError,\n389|\t},\n390|\tOperationTerminateStale: {\n391|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n392|\t\tCodeStaleGeneration, CodeCapabilityUnproven,\n393|\t\t\"terminal_backend_timeout\", \"terminal_backend_process_failed\",\n394|\t\tCodeIntegrityFailure, CodeProtocolError,\n395|\t},\n396|\tOperationRestore: {\n397|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n398|\t\tCodeStaleGeneration, CodeCapabilityUnproven, CodeRestoreMismatch,\n399|\t\tCodeUnavailable, \"terminal_backend_timeout\", \"terminal_backend_process_failed\",\n400|\t\tCodeIntegrityFailure, CodeProtocolError,\n401|\t},\n402|}\n403|\n404|// CheckErrorAllowed enforces the §4.C error mapping: a backend reporting a\n405|// code outside the operation's allowed set violates the contract, and the\n406|// report itself is refused as a protocol error. It names the production\n407|// reporting site, not the underlying failure.\n408|func CheckErrorAllowed(operation, code string) error {\n409|\tparsedOperation, err := ParseOperation(operation)\n410|\tif err != nil {\n411|\t\treturn err\n412|\t}\n413|\tfor _, allowed := range allowedOperationErrors[parsedOperation] {\n414|\t\tif code == allowed {\n415|\t\t\treturn nil\n416|\t\t}\n417|\t}\n418|\treturn refuse(&Error{Code: CodeProtocolError, Detail: \"operation error vocabulary\"})\n419|}\n420|\n421|// IdempotencyKey derives the canonical UTF-8 idempotency key for one\n422|// operation from its identity segments (§4.C authorization and idempotency\n423|// column, §4.1 bootstrap binding). The key is never caller-chosen free\n424|// text: the segment count and order are fixed per operation, and every\n425|// segment must be non-empty.\n426|//\n427|// The per-operation forms are: manifest and probe take the request ID\n428|// alone; create and restore take session_id + bootstrap_operation_id;\n429|// attach takes terminal_instance_id + client_id; quiesce-input takes\n430|// terminal_instance_id + \"quiesce\" + quiescence_generation;\n431|// wait-safe-boundary takes terminal_instance_id + \"boundary\" +\n432|// quiescence_generation + provider_proof_kind; request-stop takes\n433|// terminal_instance_id + \"stop\" + safe_boundary_evidence_id;\n434|// terminate-stale takes terminal_instance_id + \"terminate\" +\n435|// stale_lease_id + decimal stale_epoch; status takes its full queried\n436|// identity tuple, of at least one segment.\n437|func IdempotencyKey(operation string, segments ...string) (string, error) {\n438|\tparsedOperation, err := ParseOperation(operation)\n439|\tif err != nil {\n440|\t\treturn \"\", err\n441|\t}\n442|\tfor _, segment := range segments {\n443|\t\tif segment == \"\" {\n444|\t\t\treturn \"\", refuse(&Error{Code: CodeProtocolError, Detail: \"idempotency key shape\"})\n445|\t\t}\n446|\t}\n447|\twant := idempotencyKeySegments[parsedOperation]\n448|\tif want < 0 {\n449|\t\tif len(segments) < 1 {\n450|\t\t\treturn \"\", refuse(&Error{Code: CodeProtocolError, Detail: \"idempotency key shape\"})\n451|\t\t}\n452|\t} else if len(segments) != want {\n453|\t\treturn \"\", refuse(&Error{Code: CodeProtocolError, Detail: \"idempotency key shape\"})\n454|\t}\n455|\treturn strings.Join(segments, \"/\"), nil\n456|}\n457|\n458|// idempotencyKeySegments is the fixed per-operation segment count. status\n459|// carries its full queried identity tuple, so its count varies and only\n460|// the non-empty floor is enforced.\n461|var idempotencyKeySegments = map[Operation]int{\n462|\tOperationManifest: 1, OperationProbe: 1,\n463|\tOperationCreate: 2, OperationRestore: 2, OperationAttach: 2,\n464|\tOperationQuiesceInput: 3, OperationRequestStop: 3,\n465|\tOperationWaitSafeBoundary: 4, OperationTerminateStale: 4,\n466|\tOperationStatus: -1,\n467|}\n468|\n469|// Receipt is one durably bound idempotency record: the canonical key, the\n470|// operation it was bound for, and the recorded result identity. AX and the\n471|// backend bind the pair before the first child side effect (§4.1); an\n472|// identical retry returns the recorded result instead of acting again.\n473|type Receipt struct {\n474|\tKey       string\n475|\tOperation Operation\n476|\tResultID  string\n477|}\n478|\n479|// Ledger is the process-local idempotency receipt table backing the §4.C\n480|// recovery rules: persist the receipt before the first side effect,\n481|// identical retry replays it, a changed operation in the window is\n482|// idempotency_mismatch, and uncertainty requires status before any start\n483|// retry. The zero value is unusable; construct with NewLedger.\n484|//\n485|// The ledger is the semantic half of durability: Export and Import move\n486|// the table across a controller crash as stable bytes, and Import refuses\n487|// a malformed or ambiguous image instead of inventing an empty table.\n488|type Ledger struct {\n489|\tmutex    sync.Mutex\n490|\treceipts map[string]Receipt\n491|}\n492|\n493|// NewLedger opens an empty receipt table.\n494|func NewLedger() *Ledger {\n495|\treturn &Ledger{receipts: make(map[string]Receipt)}\n496|}\n497|\n498|// Bind records the receipt for a key before the first side effect. A key\n499|// bound for the first time is stored and replayed back. A key bound again\n500|// with the identical operation and result replays the stored receipt: it\n501|// performs no new effect. A key bound again with a different operation or\n502|// result is idempotency_mismatch: only a successful status read proves\n503|// absence, never a second binding.\n504|func (ledger *Ledger) Bind(key string, operation Operation, resultID string) (Receipt, error) {\n505|\tif ledger == nil {\n506|\t\treturn Receipt{}, refuse(&Error{Code: CodeProtocolError, Detail: \"idempotency ledger unavailable\"})\n507|\t}\n508|\tif key == \"\" || resultID == \"\" {\n509|\t\treturn Receipt{}, refuse(&Error{Code: CodeProtocolError, Detail: \"idempotency key shape\"})\n510|\t}\n511|\tif _, err := ParseOperation(string(operation)); err != nil {\n512|\t\treturn Receipt{}, err\n513|\t}\n514|\tledger.mutex.Lock()\n515|\tdefer ledger.mutex.Unlock()\n516|\tif stored, known := ledger.receipts[key]; known {\n517|\t\tif stored.Operation != operation || stored.ResultID != resultID {\n518|\t\t\treturn Receipt{}, refuse(&Error{Code: CodeIdempotencyMismatch, Detail: \"idempotency key conflict\"})\n519|\t\t}\n520|\t\treturn stored, nil\n521|\t}\n522|\treceipt := Receipt{Key: key, Operation: operation, ResultID: resultID}\n523|\tledger.receipts[key] = receipt\n524|\treturn receipt, nil\n525|}\n526|\n527|// Replay returns the stored receipt for a key. A lost result replays the\n528|// receipt; absence of a receipt proves nothing and reports false, so the\n529|// caller must consult status before any start retry.\n530|func (ledger *Ledger) Replay(key string) (Receipt, bool) {\n531|\tif ledger == nil {\n532|\t\treturn Receipt{}, false\n533|\t}\n534|\tledger.mutex.Lock()\n535|\tdefer ledger.mutex.Unlock()\n536|\treceipt, known := ledger.receipts[key]\n537|\treturn receipt, known\n538|}\n539|\n540|// Export renders the table as stable bytes: receipts sorted by key, one\n541|// per line as key, operation, and result fields. Import refuses a\n542|// malformed image or one binding the same key twice instead of admitting\n543|// a half-read table.\n544|func (ledger *Ledger) Export() []byte {\n545|\tif ledger == nil {\n546|\t\treturn nil\n547|\t}\n548|\tledger.mutex.Lock()\n549|\tdefer ledger.mutex.Unlock()\n550|\tkeys := make([]string, 0, len(ledger.receipts))\n551|\tfor key := range ledger.receipts {\n552|\t\tkeys = append(keys, key)\n553|\t}\n554|\tsort.Strings(keys)\n555|\tvar image strings.Builder\n556|\tfor _, key := range keys {\n557|\t\treceipt := ledger.receipts[key]\n558|\t\timage.WriteString(key + \"\\n\" + string(receipt.Operation) + \"\\n\" + receipt.ResultID + \"\\n\")\n559|\t}\n560|\treturn []byte(image.String())\n561|}\n562|\n563|// AttachAuthorization is the closed, ownership-neutral AX policy object\n564|// of §4.C: exactly policy evidence, authorizing host, transport, input\n565|// boolean, and an expiry strictly after issue. It authorizes only the\n566|// named presentation transport and input boolean. It contains no lease\n567|// member of any kind and therefore cannot acquire, renew, or transfer\n568|// ownership; ParseAttachAuthorization refuses any document carrying one\n569|// as an unknown member before any other check runs.\n570|type AttachAuthorization struct {\n571|\tPolicyEvidenceID  string\n572|\tAuthorizingHostID string\n573|\tTransport         PresentationTransport\n574|\tInputAuthorized   bool\n575|\tIssuedAt          scalar.Timestamp\n576|\tExpiresAt         scalar.Timestamp\n577|}\n578|\n579|// attachAuthorizationMembers is the exact closed member set.\n580|var attachAuthorizationMembers = []string{\n581|\t\"policy_evidence_id\",\n582|\t\"authorizing_host_id\",\n583|\t\"transport\",\n584|\t\"input_authorized\",\n585|\t\"issued_at\",\n586|\t\"expires_at\",\n587|}\n588|\n589|// ParseAttachAuthorization admits one closed AttachAuthorization document.\n590|// Unknown members (including any lease, epoch, holder, or authorization\n591|// kind member smuggled into an attach policy) and missing members are\n592|// both malformed; a malformed read is an error, never an absent policy,\n593|// so callers must not fall back to an unauthenticated attach.\n594|func ParseAttachAuthorization(raw []byte) (AttachAuthorization, error) {\n595|\tobject, err := decodeStrictObject(raw)\n596|\tif err != nil {\n597|\t\treturn AttachAuthorization{}, err\n598|\t}\n599|\tif err := checkExactMembers(object, attachAuthorizationMembers); err != nil {\n600|\t\treturn AttachAuthorization{}, err\n601|\t}\n602|\tpolicyEvidenceID, err := digestMember(object, \"policy_evidence_id\")\n603|\tif err != nil {\n604|\t\treturn AttachAuthorization{}, err\n605|\t}\n606|\tauthorizingHostID, err := stringMember(object, \"authorizing_host_id\")\n607|\tif err != nil {\n608|\t\treturn AttachAuthorization{}, err\n609|\t}\n610|\tif _, err := scalar.ParseUUIDv7(authorizingHostID); err != nil {\n611|\t\treturn AttachAuthorization{}, mismatchf(\"document member type\")\n612|\t}\n613|\ttransportRaw, err := stringMember(object, \"transport\")\n614|\tif err != nil {\n615|\t\treturn AttachAuthorization{}, err\n616|\t}\n617|\ttransport, err := parseTransport(transportRaw)\n618|\tif err != nil {\n619|\t\treturn AttachAuthorization{}, err\n620|\t}\n621|\tinputRaw, known := object[\"input_authorized\"]\n622|\tif !known {\n623|\t\treturn AttachAuthorization{}, mismatchf(\"document members\")\n624|\t}\n625|\tinputAuthorized, ok := inputRaw.(bool)\n626|\tif !ok {\n627|\t\treturn AttachAuthorization{}, mismatchf(\"document member type\")\n628|\t}\n629|\tissuedAt, err := timestampMember(object, \"issued_at\")\n630|\tif err != nil {\n631|\t\treturn AttachAuthorization{}, err\n632|\t}\n633|\texpiresAt, err := timestampMember(object, \"expires_at\")\n634|\tif err != nil {\n635|\t\treturn AttachAuthorization{}, err\n636|\t}\n637|\tissued, err := issuedAt.Time()\n638|\tif err != nil {\n639|\t\treturn AttachAuthorization{}, mismatchf(\"document timestamp\")\n640|\t}\n641|\texpires, err := expiresAt.Time()\n642|\tif err != nil {\n643|\t\treturn AttachAuthorization{}, mismatchf(\"document timestamp\")\n644|\t}\n645|\tif !expires.After(issued) {\n646|\t\treturn AttachAuthorization{}, refuse(&Error{Code: CodeUnauthorized, Detail: \"attach authorization expiry\"})\n647|\t}\n648|\treturn AttachAuthorization{\n649|\t\tPolicyEvidenceID:  policyEvidenceID,\n650|\t\tAuthorizingHostID: authorizingHostID,\n651|\t\tTransport:         transport,\n652|\t\tInputAuthorized:   inputAuthorized,\n653|\t\tIssuedAt:          issuedAt,\n654|\t\tExpiresAt:         expiresAt,\n655|\t}, nil\n656|}\n657|\n658|// CheckAttachRequest authorizes one attach request against its policy at\n659|// the given instant. The request transport and input boolean must equal\n660|// the authorized ones; a relay transport is refused even when authorized\n661|// on paper, because current AX admits only local and trusted-mesh\n662|// presentation (§4.E). Expiry is checked against now: an expired policy\n663|// authorizes nothing, and a lease-shaped bypass cannot exist because the\n664|// policy has no lease member to consult.\n665|func CheckAttachRequest(auth AttachAuthorization, transport string, inputAuthorized bool, now time.Time) error {\n666|\trequested, err := parseTransport(transport)\n667|\tif err != nil {\n668|\t\treturn err\n669|\t}\n670|\tif requested != auth.Transport || inputAuthorized != auth.InputAuthorized {\n671|\t\treturn refuse(&Error{Code: CodeUnauthorized, Detail: \"attach authorization binding\"})\n672|\t}\n673|\tif requested == TransportThirdPartyRelay {\n674|\t\treturn refuse(&Error{Code: CodeUnauthorized, Detail: \"attach relay transport\"})\n675|\t}\n676|\texpires, err := auth.ExpiresAt.Time()\n677|\tif err != nil {\n678|\t\treturn mismatchf(\"document timestamp\")\n679|\t}\n680|\tif !now.Before(expires) {\n681|\t\treturn refuse(&Error{Code: CodeUnauthorized, Detail: \"attach authorization expiry\"})\n682|\t}\n683|\treturn nil\n684|}\n685|\n686|// CheckAttachResult enforces the §4.C attach result rule: the result\n687|// input boolean MUST equal both the request and the AttachAuthorization.\n688|// A backend reporting input the policy did not authorize is refused even\n689|// when the request itself was authorized.\n690|func CheckAttachResult(requestInputAuthorized, resultInputAuthorized bool, auth AttachAuthorization) error {\n691|\tif resultInputAuthorized != requestInputAuthorized || resultInputAuthorized != auth.InputAuthorized {\n692|\t\treturn refuse(&Error{Code: CodeUnauthorized, Detail: \"attach input binding\"})\n693|\t}\n694|\treturn nil\n695|}\n696|\n697|// CheckEntrypoint enforces the §4.A stable entrypoint rule: every\n698|// backend-created runtime ultimately executes exactly\n699|// `ax pane SESSION_ID`, and a raw provider command is forbidden as a\n700|// durable entry point. argv must be exactly the three literals ax, pane,\n701|// and the canonical request Session UUIDv7 string, and the carried\n702|// session must equal the session under creation.\n703|func CheckEntrypoint(argv []string, sessionID string) error {\n704|\tif len(argv) != 3 || argv[0] != \"ax\" || argv[1] != \"pane\" {\n705|\t\treturn refuse(&Error{Code: CodePreconditionFailed, Detail: \"entrypoint argv\"})\n706|\t}\n707|\tsession, err := scalar.ParseUUIDv7(sessionID)\n708|\tif err != nil {\n709|\t\treturn refuse(&Error{Code: CodePreconditionFailed, Detail: \"entrypoint session binding\"})\n710|\t}\n711|\tcarried, err := scalar.ParseUUIDv7(argv[2])\n712|\tif err != nil {\n713|\t\treturn refuse(&Error{Code: CodePreconditionFailed, Detail: \"entrypoint session binding\"})\n714|\t}\n715|\tif carried.String() != session.String() {\n716|\t\treturn refuse(&Error{Code: CodePreconditionFailed, Detail: \"entrypoint session binding\"})\n717|\t}\n718|\treturn nil\n719|}\n720|\n721|// StatusResult is the §4.C status success body in harness form. Pointer\n722|// members distinguish null from false: provider observation is null\n723|// unless requested and evidenced, and the last-operation fields are null\n724|// when the backend reports no prior operation.\n725|type StatusResult struct {\n726|\tState             InstanceState\n727|\tIdentityMatch     bool\n728|\tWrapperPresent    bool\n729|\tProviderPresent   *bool\n730|\tAttachable        bool\n731|\tLastOperationID   *string\n732|\tLastEffect        *SideEffect\n733|\tProviderRequested bool\n734|\tProviderEvidenced bool\n735|\tAttachEvidenced   bool\n736|}\n737|\n738|// CheckStatusResult enforces the §4.C exact-instance lookup rules. A\n739|// non-match sets identity_match false, state absent, wrapper absent,\n740|// provider null, attachable false, and both last fields null, and does\n741|// not authorize fallback: any deviation from that canonical false form\n742|// is refused. provider_present is null unless provider observation was\n743|// requested and evidenced. attachable is true only in parked or active\n744|// with a currently evidenced matching attach capability. A timeout or\n745|// read failure is unknown, never absent: this check validates reported\n746|// results and never synthesizes absence from a missing read.\n747|func CheckStatusResult(identityMatch bool, result StatusResult) error {\n748|\tif _, err := ParseInstanceState(string(result.State)); err != nil {\n749|\t\treturn err\n750|\t}\n751|\tif result.LastEffect != nil {\n752|\t\tif _, err := ParseSideEffect(string(*result.LastEffect)); err != nil {\n753|\t\t\treturn err\n754|\t\t}\n755|\t}\n756|\tif !identityMatch || !result.IdentityMatch {\n757|\t\tif result.IdentityMatch {\n758|\t\t\treturn refuse(&Error{Code: CodeProtocolError, Detail: \"status identity binding\"})\n759|\t\t}\n760|\t\tif result.State != StateAbsent || result.WrapperPresent ||\n761|\t\t\tresult.ProviderPresent != nil || result.Attachable ||\n762|\t\t\tresult.LastOperationID != nil || result.LastEffect != nil {\n763|\t\t\treturn refuse(&Error{Code: CodeProtocolError, Detail: \"status identity binding\"})\n764|\t\t}\n765|\t\treturn nil\n766|\t}\n767|\tif result.ProviderPresent != nil && !(result.ProviderRequested && result.ProviderEvidenced) {\n768|\t\treturn refuse(&Error{Code: CodeProtocolError, Detail: \"status provider observation\"})\n769|\t}\n770|\tif result.Attachable && !((result.State == StateParked || result.State == StateActive) && result.AttachEvidenced) {\n771|\t\treturn refuse(&Error{Code: CodePreconditionFailed, Detail: \"status attachability\"})\n772|\t}\n773|\treturn nil\n774|}\n775|\n776|// ParseSideEffect admits exactly the ten §4.C side effects.\n777|func ParseSideEffect(value string) (SideEffect, error) {\n778|\tswitch SideEffect(value) {\n779|\tcase EffectBindingPersisted, EffectWrapperStarted, EffectAttachClientCreated,\n780|\t\tEffectInputClosed, EffectSafeBoundaryObserved, EffectGracefulStopRequested,\n781|\t\tEffectProcessClosed, EffectBackendStoreClosed,\n782|\t\tEffectStaleIncarnationTerminated, EffectWrapperRestored:\n783|\t\treturn SideEffect(value), nil\n784|\tdefault:\n785|\t\treturn \"\", refuse(&Error{Code: CodeProtocolError, Detail: \"side effect vocabulary\"})\n786|\t}\n787|}\n788|\n789|// ReplicationClass is the §4.E persistence classification. Only\n790|// safe_evidence MAY persist and replicate after validation; every other\n791|// class is host-local, rebuildable, owner-only, or forbidden.\n792|type ReplicationClass string\n793|\n794|// Replication classes.\n795|const (\n796|\tReplicationSafeEvidence       ReplicationClass = \"safe_evidence\"\n797|\tReplicationHostLocal          ReplicationClass = \"host_local\"\n798|\tReplicationDerivedCache       ReplicationClass = \"derived_cache\"\n799|\tReplicationSensitiveOwnerOnly ReplicationClass = \"sensitive_owner_only\"\n800|\tReplicationForbidden          ReplicationClass = \"forbidden\"\n801|)\n802|\n803|// replicationMembers is the closed §4.E classification table. Member\n804|// names are wire vocabulary, never local data: classifying a member the\n805|// table does not know is refused rather than defaulted.\n806|var replicationMembers = buildReplicationMembers()\n807|\n808|// buildReplicationMembers assembles the closed §4.E classification table.\n809|// Member names are wire vocabulary, never local data: classifying a member\n810|// the table does not know is refused rather than defaulted.\n811|func buildReplicationMembers() map[string]ReplicationClass {\n812|\t// Safe immutable evidence: sanitized backend identity, versions,\n813|\t// platform, conformance, and capability evidence MAY persist and\n814|\t// replicate after validation.\n815|\tsafe := []string{\n816|\t\t\"manifest_id\", \"probe_id\", \"evidence_id\",\n817|\t\t\"terminal_backend_id\", \"implementation_version\",\n818|\t\t\"protocol_version\", \"protocol_versions\",\n819|\t\t\"platform\", \"platforms\", \"os_version\",\n820|\t\t\"conformance_fixture_id\", \"capability_claims\", \"evidence_ids\",\n821|\t\t\"backend_generation_digest\", \"capability\", \"dependent_operations\",\n822|\t\t\"evidence_requirements\", \"facts\", \"issuer\", \"issuer_id\",\n823|\t\t\"observed_at\", \"expires_at\",\n824|\t}\n825|\t// Host-local durable metadata: instance/binding IDs, sanitized native\n826|\t// reference, generation, idempotency receipt, last effect.\n827|\thostLocal := []string{\n828|\t\t\"binding_id\", \"terminal_instance_id\", \"session_id\",\n829|\t\t\"host_id\", \"host_incarnation_id\", \"backend_generation\",\n830|\t\t\"native_reference\", \"idempotency_receipt\", \"last_effect\",\n831|\t\t\"last_operation_id\", \"supersedes_binding_id\", \"created_at\",\n832|\t}\n833|\t// Derived cache: discovery, availability, attachability, and process\n834|\t// observations with probe views; rebuildable, non-authoritative.\n835|\tderived := []string{\n836|\t\t\"availability\", \"attachable\", \"wrapper_present\", \"provider_present\",\n837|\t\t\"identity_match\", \"state\", \"probed_at\",\n838|\t}\n839|\t// Sensitive runtime state: IPC, sockets, pipes, attach/relay\n840|\t// credentials, backend auth and live databases, GUI/login\n841|\t// attestations, provider credentials; owner-only, non-replicable.\n842|\tsensitive := []string{\n843|\t\t\"attach_descriptor\", \"ipc_handle\", \"tmux_socket\",\n844|\t\t\"named_pipe\", \"attach_credential\", \"relay_credential\",\n845|\t\t\"backend_auth\", \"auth_database\", \"gui_attestation\",\n846|\t\t\"login_attestation\", \"provider_credential\", \"evidence_secret\",\n847|\t\t\"environment_values\",\n848|\t}\n849|\t// Forbidden: raw native reference, PID/handle, endpoint/token,\n850|\t// terminal output/scrollback, unrestricted environment, credential\n851|\t// detail, and live-process facts MUST NOT replicate.\n852|\tforbidden := []string{\n853|\t\t\"native_pid\", \"process_handle\", \"endpoint\", \"token\",\n854|\t\t\"terminal_output\", \"scrollback\", \"unrestricted_environment\",\n855|\t\t\"credential_detail\", \"live_process_fact\", \"raw_native_reference\",\n856|\t}\n857|\ttable := make(map[string]ReplicationClass,\n858|\t\tlen(safe)+len(hostLocal)+len(derived)+len(sensitive)+len(forbidden))\n859|\tfor _, member := range safe {\n860|\t\ttable[member] = ReplicationSafeEvidence\n861|\t}\n862|\tfor _, member := range hostLocal {\n863|\t\ttable[member] = ReplicationHostLocal\n864|\t}\n865|\tfor _, member := range derived {\n866|\t\ttable[member] = ReplicationDerivedCache\n867|\t}\n868|\tfor _, member := range sensitive {\n869|\t\ttable[member] = ReplicationSensitiveOwnerOnly\n870|\t}\n871|\tfor _, member := range forbidden {\n872|\t\ttable[member] = ReplicationForbidden\n873|\t}\n874|\treturn table\n875|}\n876|\n877|// Import rebuilds a ledger from Export bytes. A truncated, malformed, or\n878|// ambiguous image is an error, never an empty table, so a failed read\n879|// cannot masquerade as proven absence. An empty image rebuilds the empty\n880|// table, which is exactly what Export of a fresh ledger produces.\n881|func ImportLedger(image []byte) (*Ledger, error) {\n882|\tlines := strings.Split(string(image), \"\\n\")\n883|\tif len(lines) > 0 && lines[len(lines)-1] == \"\" {\n884|\t\tlines = lines[:len(lines)-1]\n885|\t}\n886|\tif len(lines)%3 != 0 {\n887|\t\treturn nil, refuse(&Error{Code: CodeProtocolError, Detail: \"idempotency ledger image\"})\n888|\t}\n889|\tledger := NewLedger()\n890|\tfor index := 0; index < len(lines); index += 3 {\n891|\t\tkey, operation, resultID := lines[index], lines[index+1], lines[index+2]\n892|\t\tif key == \"\" || resultID == \"\" {\n893|\t\t\treturn nil, refuse(&Error{Code: CodeProtocolError, Detail: \"idempotency ledger image\"})\n894|\t\t}\n895|\t\tparsed, err := ParseOperation(operation)\n896|\t\tif err != nil {\n897|\t\t\treturn nil, refuse(&Error{Code: CodeProtocolError, Detail: \"idempotency ledger image\"})\n898|\t\t}\n899|\t\tif _, duplicate := ledger.receipts[key]; duplicate {\n900|\t\t\treturn nil, refuse(&Error{Code: CodeIdempotencyMismatch, Detail: \"idempotency ledger image\"})\n901|\t\t}\n902|\t\tledger.receipts[key] = Receipt{Key: key, Operation: parsed, ResultID: resultID}\n903|\t}\n904|\treturn ledger, nil\n905|}\n906|\n907|// ClassifyReplication reports the §4.E persistence class of one wire\n908|// member. An unlisted member reports false: the table is closed, and an\n909|// unknown member is refused rather than defaulted into any class.\n910|func ClassifyReplication(member string) (ReplicationClass, bool) {\n911|\tclass, known := replicationMembers[member]\n912|\treturn class, known\n913|}\n914|\n915|// CheckReplicable refuses a replication set carrying any member outside\n916|// the safe immutable evidence class, or any member the closed table does\n917|// not know. Host-local metadata, derived cache, sensitive runtime state,\n918|// and forbidden members MUST NOT replicate; unknown members fail the\n919|// same way, because an unclassified member replicating by default would\n920|// silently widen the §4.E exclusion. An empty set replicates nothing and\n921|// is admitted. The refusal is a protocol error: the set is a body\n922|// variant the replication contract does not cover.\n923|func CheckReplicable(members []string) error {\n924|\tfor _, member := range members {\n925|\t\tif class, known := replicationMembers[member]; !known || class != ReplicationSafeEvidence {\n926|\t\t\treturn refuse(&Error{Code: CodeProtocolError, Detail: \"replication exclusion\"})\n927|\t\t}\n928|\t}\n929|\treturn nil\n930|}\n931|\n932|// LegacyUnreported is the version and generation a historical v0.4.3\n933|// translation carries. The past reported no versions and no generation,\n934|// so the translation says exactly that instead of inferring values no\n935|// observation supports.\n936|const LegacyUnreported = \"legacy_unreported\"\n937|\n938|// LegacyBinding is the §4.E forward translation of one historical v0.4.3\n939|// backend identity: the canonical backend ID with unreported version and\n940|// generation. It carries no capability field of any kind: a translation\n941|// MUST NOT infer capabilities the historical record never evidenced, and\n942|// a struct that cannot name them cannot smuggle them. The field count is\n943|// pinned by TestLegacyBindingCarriesNoCapabilities.\n944|type LegacyBinding struct {\n945|\tBackendID             string\n946|\tImplementationVersion string\n947|\tGeneration            string\n948|}\n949|\n950|// legacyForward is the exact §4.E forward map. Only the two immutable\n951|// v0.4.3 values translate; anything else is incompatible, never fallback.\n952|var legacyForward = map[string]string{\n953|\t\"tmux\":   BuiltinTmux,\n954|\t\"conpty\": BuiltinConpty,\n955|}\n956|\n957|// TranslateLegacyBackend deterministically maps a historical v0.4.3\n958|// backend name to its canonical binding. Version and generation are\n959|// legacy_unreported and no capabilities are inferred. Translation is a\n960|// pure function over its argument: it never rewrites or re-digests\n961|// history, and the input is unchanged by construction.\n962|func TranslateLegacyBackend(legacy string) (LegacyBinding, error) {\n963|\tcanonical, known := legacyForward[legacy]\n964|\tif !known {\n965|\t\treturn LegacyBinding{}, refuse(&Error{Code: CodeIncompatibleSchema, Detail: \"legacy backend identity\"})\n966|\t}\n967|\treturn LegacyBinding{\n968|\t\tBackendID:             canonical,\n969|\t\tImplementationVersion: LegacyUnreported,\n970|\t\tGeneration:            LegacyUnreported,\n971|\t}, nil\n972|}\n973|\n974|// ProjectToLegacy is the §4.E reverse projection. It exists only for the\n975|// two canonical built-ins; every other backend ID, including a\n976|// well-formed third-party ID, returns incompatible_schema, never a\n977|// fallback. A malformed identity is not an ID at all and is refused by\n978|// the registry grammar first.\n979|func ProjectToLegacy(backendID string) (string, error) {\n980|\tif _, err := ParseID(backendID); err != nil {\n981|\t\treturn \"\", err\n982|\t}\n983|\tfor legacy, canonical := range legacyForward {\n984|\t\tif backendID == canonical {\n985|\t\t\treturn legacy, nil\n986|\t\t}\n987|\t}\n988|\treturn \"\", refuse(&Error{Code: CodeIncompatibleSchema, Detail: \"legacy reverse projection\"})\n989|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c533","stream":{"kind":"session","id":"01a0b201-5e84-7ea0-8bc6-d79919cbe007"},"sequence":244,"recorded_at":1780531400000483,"record_type":"event","durability":"durable","causation_id":"9e30868d-563f-43f3-9fe7-d9ddb65377f0","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9e30868d-563f-43f3-9fe7-d9ddb65377f0","run_stream":{"kind":"run","id":"9e30868d-563f-43f3-9fe7-d9ddb65377f0"},"task_stream":{"kind":"task","id":"01a0b201-fadd-7471-ac41-6e15a3bceed1"},"task_id":"01a0b201-fadd-7471-ac41-6e15a3bceed1","event":{"kind":"completed","task_id":"01a0b201-fadd-7471-ac41-6e15a3bceed1"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c535","stream":{"kind":"session","id":"01a0b201-5e84-7ea0-8bc6-d79919cbe007"},"sequence":245,"recorded_at":1780531400000485,"record_type":"event","durability":"durable","causation_id":"9e30868d-563f-43f3-9fe7-d9ddb65377f0","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"9e30868d-563f-43f3-9fe7-d9ddb65377f0","run_stream":{"kind":"run","id":"9e30868d-563f-43f3-9fe7-d9ddb65377f0"},"call_id":"call_01a0b201f88370f6a5c261530ef5e9cb","text":"Read text file `internal/terminalbackend/conformance.go`.\n1|// Lifecycle, attach, entrypoint, replication, and historical-translation\n2|// conformance for the TerminalBackend registry.\n3|//\n4|// Normative scope is relux-works/agent-session-manager-spec@v0.5.0 §4.A\n5|// (authority: attach changes no ownership; every backend-created runtime\n6|// executes exactly `ax pane SESSION_ID`), §4.C (lifecycle state machine,\n7|// transition/authorization/idempotency table), §4.D (attach authorization\n8|// neutrality and capability dependencies, enforced by manifest.go), §4.E\n9|// (replication classification and v0.4.3 historical translation), §4.1\n10|// (backend interface operations and the idempotent bootstrap binding), §6.5\n11|// (platform defaults select only new activation), and §7.A (provider-side\n12|// descriptor binding, enforced by CheckProviderDescriptor in\n13|// terminalbackend.go).\n14|//\n15|// Section 4.B names this deliverable: \"M0 exposes only an internal semantic\n16|// interface and conformance harness\". This file is that harness: it proves\n17|// the semantics over admitted registry state but performs no I/O, launches\n18|// no backend, and holds no authority beyond refusing contract violations.\n19|// Capability gating stays in manifest.go (CheckOperation, Reconcile); trust\n20|// stays in terminalbackend.go (RegisterExternal, DigestFile). A refusal here\n21|// is an *Error with a wire code from the pinned catalog error vocabulary\n22|// and a static Detail clause, following the package convention.\n23|package terminalbackend\n24|\n25|import (\n26|\t\"sort\"\n27|\t\"strings\"\n28|\t\"sync\"\n29|\t\"time\"\n30|\n31|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n32|)\n33|\n34|// Wire error codes this file may report. Each is a member of the pinned\n35|// catalog error vocabulary; TestWireCodesAreCatalogued proves no other code\n36|// is advertised.\n37|const (\n38|\t// CodeProtocolError reports an unknown operation, state, or member, a\n39|\t// body variant outside the closed §4.C matrix, or an error code the\n40|\t// backend MUST NOT emit for the operation (§4.B, §4.C). AX-local\n41|\t// parsing may additionally emit it for a syntactically valid request\n42|\t// the matrix does not cover.\n43|\tCodeProtocolError = \"terminal_backend_protocol_error\"\n44|\t// CodeUnauthorized reports an expired, mismatched, or otherwise\n45|\t// unsatisfiable attach authorization (§4.C attach row).\n46|\tCodeUnauthorized = \"terminal_backend_unauthorized\"\n47|\t// CodeUnavailable reports a backend that cannot serve the operation.\n48|\t// It appears here only inside the allowed-error sets: no conformance\n49|\t// refusal in this file emits it, so it carries no arm of its own.\n50|\tCodeUnavailable = \"terminal_backend_unavailable\"\n51|\t// CodePreconditionFailed reports a legal request against an illegal\n52|\t// source state, a non-conforming stable entrypoint, or any other\n53|\t// unmet local precondition (§4.C per-operation rows, §4.1).\n54|\tCodePreconditionFailed = \"local_precondition_failed\"\n55|\t// CodeIdempotencyMismatch reports a changed operation inside an\n56|\t// established idempotency window (§4.C, §4.1).\n57|\tCodeIdempotencyMismatch = \"idempotency_mismatch\"\n58|\t// CodeIncompatibleSchema reports a legacy identity with no canonical\n59|\t// projection, or a canonical identity with no legacy projection\n60|\t// (§4.E). It never falls back.\n61|\tCodeIncompatibleSchema = \"incompatible_schema\"\n62|)\n63|\n64|// IsProtocolError reports CodeProtocolError refusals.\n65|func IsProtocolError(err error) bool { return errorCode(err, CodeProtocolError) }\n66|\n67|// IsUnauthorized reports CodeUnauthorized refusals.\n68|func IsUnauthorized(err error) bool { return errorCode(err, CodeUnauthorized) }\n69|\n70|// IsPreconditionFailed reports CodePreconditionFailed refusals.\n71|func IsPreconditionFailed(err error) bool { return errorCode(err, CodePreconditionFailed) }\n72|\n73|// IsIdempotencyMismatch reports CodeIdempotencyMismatch refusals.\n74|func IsIdempotencyMismatch(err error) bool { return errorCode(err, CodeIdempotencyMismatch) }\n75|\n76|// IsIncompatibleSchema reports CodeIncompatibleSchema refusals.\n77|func IsIncompatibleSchema(err error) bool { return errorCode(err, CodeIncompatibleSchema) }\n78|\n79|// InstanceState is the closed §4.C TerminalInstanceState enum: local\n80|// hosting only, never a second ownership state machine.\n81|type InstanceState string\n82|\n83|// Terminal Instance states.\n84|const (\n85|\tStateAbsent      InstanceState = \"absent\"\n86|\tStateCreating    InstanceState = \"creating\"\n87|\tStateParked      InstanceState = \"parked\"\n88|\tStateActive      InstanceState = \"active\"\n89|\tStateQuiescing   InstanceState = \"quiescing\"\n90|\tStateStopped     InstanceState = \"stopped\"\n91|\tStateStaleFenced InstanceState = \"stale_fenced\"\n92|\tStateUnavailable InstanceState = \"unavailable\"\n93|)\n94|\n95|// ParseInstanceState admits exactly the eight §4.C states.\n96|func ParseInstanceState(value string) (InstanceState, error) {\n97|\tswitch InstanceState(value) {\n98|\tcase StateAbsent, StateCreating, StateParked, StateActive,\n99|\t\tStateQuiescing, StateStopped, StateStaleFenced, StateUnavailable:\n100|\t\treturn InstanceState(value), nil\n101|\tdefault:\n102|\t\treturn \"\", refuse(&Error{Code: CodeProtocolError, Detail: \"lifecycle state vocabulary\"})\n103|\t}\n104|}\n105|\n106|// Operation is the closed §4.D TerminalBackendOperation enum.\n107|type Operation string\n108|\n109|// Terminal backend operations.\n110|const (\n111|\tOperationManifest         Operation = \"manifest\"\n112|\tOperationProbe            Operation = \"probe\"\n113|\tOperationCreate           Operation = \"create\"\n114|\tOperationAttach           Operation = \"attach\"\n115|\tOperationStatus           Operation = \"status\"\n116|\tOperationQuiesceInput     Operation = \"quiesce-input\"\n117|\tOperationWaitSafeBoundary Operation = \"wait-safe-boundary\"\n118|\tOperationRequestStop      Operation = \"request-stop\"\n119|\tOperationTerminateStale   Operation = \"terminate-stale\"\n120|\tOperationRestore          Operation = \"restore\"\n121|)\n122|\n123|// ParseOperation admits exactly the ten §4.D operations.\n124|func ParseOperation(value string) (Operation, error) {\n125|\tswitch Operation(value) {\n126|\tcase OperationManifest, OperationProbe, OperationCreate, OperationAttach,\n127|\t\tOperationStatus, OperationQuiesceInput, OperationWaitSafeBoundary,\n128|\t\tOperationRequestStop, OperationTerminateStale, OperationRestore:\n129|\t\treturn Operation(value), nil\n130|\tdefault:\n131|\t\treturn \"\", refuse(&Error{Code: CodeProtocolError, Detail: \"operation vocabulary\"})\n132|\t}\n133|}\n134|\n135|// SideEffect is the closed §4.C TerminalBackendSideEffect enum.\n136|type SideEffect string\n137|\n138|// Terminal backend side effects.\n139|const (\n140|\tEffectBindingPersisted           SideEffect = \"binding_persisted\"\n141|\tEffectWrapperStarted             SideEffect = \"wrapper_started\"\n142|\tEffectAttachClientCreated        SideEffect = \"attach_client_created\"\n143|\tEffectInputClosed                SideEffect = \"input_closed\"\n144|\tEffectSafeBoundaryObserved       SideEffect = \"safe_boundary_observed\"\n145|\tEffectGracefulStopRequested      SideEffect = \"graceful_stop_requested\"\n146|\tEffectProcessClosed              SideEffect = \"process_closed\"\n147|\tEffectBackendStoreClosed         SideEffect = \"backend_store_closed\"\n148|\tEffectStaleIncarnationTerminated SideEffect = \"stale_incarnation_terminated\"\n149|\tEffectWrapperRestored            SideEffect = \"wrapper_restored\"\n150|)\n151|\n152|// PresentationTransport is the closed §4.E presentation transport enum.\n153|// Only the first two are admittable; a relay-required backend is\n154|// unavailable pending explicit future product/contract approval, so no\n155|// constructor admits it here.\n156|type PresentationTransport string\n157|\n158|// Presentation transports.\n159|const (\n160|\tTransportLocalOnly          PresentationTransport = \"local_only\"\n161|\tTransportTrustedPrivateMesh PresentationTransport = \"trusted_private_mesh\"\n162|\tTransportThirdPartyRelay    PresentationTransport = \"third_party_relay\"\n163|)\n164|\n165|// parseTransport admits exactly the closed transport vocabulary. The relay\n166|// member parses so a request naming it is classified rather than\n167|// misreported, but CheckAttachRequest refuses it: current AX admits only\n168|// the first two.\n169|func parseTransport(value string) (PresentationTransport, error) {\n170|\tswitch PresentationTransport(value) {\n171|\tcase TransportLocalOnly, TransportTrustedPrivateMesh, TransportThirdPartyRelay:\n172|\t\treturn PresentationTransport(value), nil\n173|\tdefault:\n174|\t\treturn \"\", refuse(&Error{Code: CodeProtocolError, Detail: \"presentation transport vocabulary\"})\n175|\t}\n176|}\n177|\n178|// Authorization kinds carried by the transition table. \"attach\" names the\n179|// ownership-neutral AttachAuthorization below; every other mutating kind\n180|// names an AXAuthorization lease tuple, which this harness does not mint\n181|// (no lease implementation exists here) but does name so the table stays\n182|// exact.\n183|const (\n184|\tauthorizationNone       = \"none\"\n185|\tauthorizationCreate     = \"create\"\n186|\tauthorizationAttach     = \"attach\"\n187|\tauthorizationControl    = \"control\"\n188|\tauthorizationForceStale = \"force_stale\"\n189|\tauthorizationRestore    = \"restore\"\n190|)\n191|\n192|// Transition is one exact §4.C table row: the allowed sources, the success\n193|// target, and the exact side effects for one operation.\n194|type Transition struct {\n195|\tOperation     Operation\n196|\tSources       []InstanceState\n197|\tTarget        InstanceState\n198|\tTargetParked  bool\n199|\tEffects       []SideEffect\n200|\tAuthorization string\n201|\t// InstanceScoped is false for manifest and probe, which carry no\n202|\t// Terminal Instance source or target and no side effects.\n203|\tInstanceScoped bool\n204|\t// SameState marks status: every source is allowed and the success\n205|\t// state is the source itself, with no side effect.\n206|\tSameState bool\n207|}\n208|\n209|// transitionTable is the exact §4.C transition matrix. create carries two\n210|// targets: active when interactive, otherwise parked.\n211|var transitionTable = []Transition{\n212|\t{Operation: OperationManifest, InstanceScoped: false, Authorization: authorizationNone},\n213|\t{Operation: OperationProbe, InstanceScoped: false, Authorization: authorizationNone},\n214|\t{\n215|\t\tOperation: OperationCreate,\n216|\t\tSources:   []InstanceState{StateAbsent, StateStopped},\n217|\t\tTarget:    StateActive, TargetParked: true,\n218|\t\tEffects:        []SideEffect{EffectBindingPersisted, EffectWrapperStarted},\n219|\t\tAuthorization:  authorizationCreate,\n220|\t\tInstanceScoped: true,\n221|\t},\n222|\t{\n223|\t\tOperation:      OperationAttach,\n224|\t\tSources:        []InstanceState{StateParked, StateActive},\n225|\t\tTarget:         StateActive,\n226|\t\tEffects:        []SideEffect{EffectAttachClientCreated},\n227|\t\tAuthorization:  authorizationAttach,\n228|\t\tInstanceScoped: true,\n229|\t},\n230|\t{\n231|\t\tOperation: OperationStatus,\n232|\t\tSources: []InstanceState{\n233|\t\t\tStateAbsent, StateCreating, StateParked, StateActive,\n234|\t\t\tStateQuiescing, StateStopped, StateStaleFenced, StateUnavailable,\n235|\t\t},\n236|\t\tSameState:      true,\n237|\t\tAuthorization:  authorizationNone,\n238|\t\tInstanceScoped: true,\n239|\t},\n240|\t{\n241|\t\tOperation:      OperationQuiesceInput,\n242|\t\tSources:        []InstanceState{StateActive, StateParked},\n243|\t\tTarget:         StateQuiescing,\n244|\t\tEffects:        []SideEffect{EffectInputClosed},\n245|\t\tAuthorization:  authorizationControl,\n246|\t\tInstanceScoped: true,\n247|\t},\n248|\t{\n249|\t\tOperation:      OperationWaitSafeBoundary,\n250|\t\tSources:        []InstanceState{StateQuiescing},\n251|\t\tTarget:         StateQuiescing,\n252|\t\tEffects:        []SideEffect{EffectSafeBoundaryObserved},\n253|\t\tAuthorization:  authorizationControl,\n254|\t\tInstanceScoped: true,\n255|\t},\n256|\t{\n257|\t\tOperation:      OperationRequestStop,\n258|\t\tSources:        []InstanceState{StateQuiescing},\n259|\t\tTarget:         StateStopped,\n260|\t\tEffects:        []SideEffect{EffectGracefulStopRequested, EffectProcessClosed, EffectBackendStoreClosed},\n261|\t\tAuthorization:  authorizationControl,\n262|\t\tInstanceScoped: true,\n263|\t},\n264|\t{\n265|\t\tOperation:      OperationTerminateStale,\n266|\t\tSources:        []InstanceState{StateStaleFenced, StateUnavailable},\n267|\t\tTarget:         StateStopped,\n268|\t\tEffects:        []SideEffect{EffectStaleIncarnationTerminated, EffectProcessClosed},\n269|\t\tAuthorization:  authorizationForceStale,\n270|\t\tInstanceScoped: true,\n271|\t},\n272|\t{\n273|\t\tOperation:      OperationRestore,\n274|\t\tSources:        []InstanceState{StateAbsent, StateStopped, StateUnavailable},\n275|\t\tTarget:         StateParked,\n276|\t\tEffects:        []SideEffect{EffectBindingPersisted, EffectWrapperRestored},\n277|\t\tAuthorization:  authorizationRestore,\n278|\t\tInstanceScoped: true,\n279|\t},\n280|}\n281|\n282|// lookupTransition returns the table row for one operation.\n283|func lookupTransition(operation Operation) (Transition, bool) {\n284|\tfor _, row := range transitionTable {\n285|\t\tif row.Operation == operation {\n286|\t\t\treturn row, true\n287|\t\t}\n288|\t}\n289|\treturn Transition{}, false\n290|}\n291|\n292|// CheckTransition enforces the §4.C transition matrix. It returns the\n293|// success target state and the exact side effects. create resolves its\n294|// target from interactive: active when interactive, otherwise parked. A\n295|// state reached only by AX fencing observation (stale_fenced) is never\n296|// entered here: no backend operation targets it, so a row naming it as a\n297|// target cannot exist and CheckTransition cannot return it except as a\n298|// status observation of the source itself.\n299|//\n300|// An unknown operation or state is a protocol error; a known operation\n301|// against a disallowed source is a failed local precondition. Only\n302|// quiesce-input enters quiescing, and creating is never a success target:\n303|// it exists only between the idempotency receipt and the first side\n304|// effect, which the Ledger below owns.\n305|func CheckTransition(operation, source string, interactive bool) (InstanceState, []SideEffect, error) {\n306|\tparsedOperation, err := ParseOperation(operation)\n307|\tif err != nil {\n308|\t\treturn \"\", nil, err\n309|\t}\n310|\trow, known := lookupTransition(parsedOperation)\n311|\tif !known {\n312|\t\treturn \"\", nil, refuse(&Error{Code: CodeProtocolError, Detail: \"operation vocabulary\"})\n313|\t}\n314|\tif !row.InstanceScoped {\n315|\t\tif source != \"\" {\n316|\t\t\treturn \"\", nil, refuse(&Error{Code: CodePreconditionFailed, Detail: \"lifecycle instance scope\"})\n317|\t\t}\n318|\t\treturn \"\", nil, nil\n319|\t}\n320|\tparsedSource, err := ParseInstanceState(source)\n321|\tif err != nil {\n322|\t\treturn \"\", nil, err\n323|\t}\n324|\tallowed := false\n325|\tfor _, candidate := range row.Sources {\n326|\t\tif candidate == parsedSource {\n327|\t\t\tallowed = true\n328|\t\t\tbreak\n329|\t\t}\n330|\t}\n331|\tif !allowed {\n332|\t\treturn \"\", nil, refuse(&Error{Code: CodePreconditionFailed, Detail: \"lifecycle transition\"})\n333|\t}\n334|\tif row.SameState {\n335|\t\treturn parsedSource, nil, nil\n336|\t}\n337|\tif parsedOperation == OperationCreate && !interactive {\n338|\t\treturn StateParked, append([]SideEffect(nil), row.Effects...), nil\n339|\t}\n340|\treturn row.Target, append([]SideEffect(nil), row.Effects...), nil\n341|}\n342|\n343|// allowedOperationErrors is the exact §4.C \"Allowed error codes\" column.\n344|// An error not listed for an operation MUST NOT be emitted by the backend\n345|// for a syntactically valid request; AX-local parsing may additionally\n346|// emit terminal_backend_protocol_error, which every row therefore carries.\n347|var allowedOperationErrors = map[Operation][]string{\n348|\tOperationManifest: {\n349|\t\tCodeProtocolError, \"terminal_backend_protocol_incompatible\",\n350|\t\t\"terminal_backend_process_failed\", \"terminal_backend_timeout\",\n351|\t\tCodeIntegrityFailure,\n352|\t},\n353|\tOperationProbe: {\n354|\t\tCodeUntrusted, CodeMismatch, CodeDrift,\n355|\t\tCodeProtocolError, \"terminal_backend_process_failed\", \"terminal_backend_timeout\",\n356|\t\tCodeIntegrityFailure,\n357|\t},\n358|\tOperationCreate: {\n359|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n360|\t\tCodeStaleGeneration, CodeCapabilityUnproven, CodeUnavailable,\n361|\t\t\"terminal_backend_timeout\", \"terminal_backend_process_failed\",\n362|\t\tCodeIntegrityFailure, CodeProtocolError,\n363|\t},\n364|\tOperationAttach: {\n365|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n366|\t\tCodeStaleGeneration, CodeCapabilityUnproven, CodeUnavailable,\n367|\t\t\"terminal_backend_timeout\", \"terminal_backend_process_failed\",\n368|\t\tCodeIntegrityFailure, CodeProtocolError,\n369|\t},\n370|\tOperationStatus: {\n371|\t\tCodeStaleGeneration, CodeCapabilityUnproven, CodeUnavailable,\n372|\t\t\"terminal_backend_timeout\", CodeIntegrityFailure, CodeProtocolError,\n373|\t},\n374|\tOperationQuiesceInput: {\n375|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n376|\t\tCodeStaleGeneration, CodeCapabilityUnproven,\n377|\t\t\"terminal_backend_timeout\", CodeIntegrityFailure, CodeProtocolError,\n378|\t},\n379|\tOperationWaitSafeBoundary: {\n380|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n381|\t\tCodeStaleGeneration, CodeCapabilityUnproven,\n382|\t\t\"quiesce_timeout\", CodeIntegrityFailure, CodeProtocolError,\n383|\t},\n384|\tOperationRequestStop: {\n385|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n386|\t\tCodeStaleGeneration, CodeCapabilityUnproven,\n387|\t\t\"stop_timeout\", \"terminal_backend_process_failed\",\n388|\t\tCodeIntegrityFailure, CodeProtocolError,\n389|\t},\n390|\tOperationTerminateStale: {\n391|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n392|\t\tCodeStaleGeneration, CodeCapabilityUnproven,\n393|\t\t\"terminal_backend_timeout\", \"terminal_backend_process_failed\",\n394|\t\tCodeIntegrityFailure, CodeProtocolError,\n395|\t},\n396|\tOperationRestore: {\n397|\t\tCodeIdempotencyMismatch, CodePreconditionFailed, CodeUnauthorized,\n398|\t\tCodeStaleGeneration, CodeCapabilityUnproven, CodeRestoreMismatch,\n399|\t\tCodeUnavailable, \"terminal_backend_timeout\", \"terminal_backend_process_failed\",\n400|\t\tCodeIntegrityFailure, CodeProtocolError,\n401|\t},\n402|}\n403|\n404|// CheckErrorAllowed enforces the §4.C error mapping: a backend reporting a\n405|// code outside the operation's allowed set violates the contract, and the\n406|// report itself is refused as a protocol error. It names the production\n407|// reporting site, not the underlying failure.\n408|func CheckErrorAllowed(operation, code string) error {\n409|\tparsedOperation, err := ParseOperation(operation)\n410|\tif err != nil {\n411|\t\treturn err\n412|\t}\n413|\tfor _, allowed := range allowedOperationErrors[parsedOperation] {\n414|\t\tif code == allowed {\n415|\t\t\treturn nil\n416|\t\t}\n417|\t}\n418|\treturn refuse(&Error{Code: CodeProtocolError, Detail: \"operation error vocabulary\"})\n419|}\n420|\n421|// IdempotencyKey derives the canonical UTF-8 idempotency key for one\n422|// operation from its identity segments (§4.C authorization and idempotency\n423|// column, §4.1 bootstrap binding). The key is never caller-chosen free\n424|// text: the segment count and order are fixed per operation, and every\n425|// segment must be non-empty.\n426|//\n427|// The per-operation forms are: manifest and probe take the request ID\n428|// alone; create and restore take session_id + bootstrap_operation_id;\n429|// attach takes terminal_instance_id + client_id; quiesce-input takes\n430|// terminal_instance_id + \"quiesce\" + quiescence_generation;\n431|// wait-safe-boundary takes terminal_instance_id + \"boundary\" +\n432|// quiescence_generation + provider_proof_kind; request-stop takes\n433|// terminal_instance_id + \"stop\" + safe_boundary_evidence_id;\n434|// terminate-stale takes terminal_instance_id + \"terminate\" +\n435|// stale_lease_id + decimal stale_epoch; status takes its full queried\n436|// identity tuple, of at least one segment.\n437|func IdempotencyKey(operation string, segments ...string) (string, error) {\n438|\tparsedOperation, err := ParseOperation(operation)\n439|\tif err != nil {\n440|\t\treturn \"\", err\n441|\t}\n442|\tfor _, segment := range segments {\n443|\t\tif segment == \"\" {\n444|\t\t\treturn \"\", refuse(&Error{Code: CodeProtocolError, Detail: \"idempotency key shape\"})\n445|\t\t}\n446|\t}\n447|\twant := idempotencyKeySegments[parsedOperation]\n448|\tif want < 0 {\n449|\t\tif len(segments) < 1 {\n450|\t\t\treturn \"\", refuse(&Error{Code: CodeProtocolError, Detail: \"idempotency key shape\"})\n451|\t\t}\n452|\t} else if len(segments) != want {\n453|\t\treturn \"\", refuse(&Error{Code: CodeProtocolError, Detail: \"idempotency key shape\"})\n454|\t}\n455|\treturn strings.Join(segments, \"/\"), nil\n456|}\n457|\n458|// idempotencyKeySegments is the fixed per-operation segment count. status\n459|// carries its full queried identity tuple, so its count varies and only\n460|// the non-empty floor is enforced.\n461|var idempotencyKeySegments = map[Operation]int{\n462|\tOperationManifest: 1, OperationProbe: 1,\n463|\tOperationCreate: 2, OperationRestore: 2, OperationAttach: 2,\n464|\tOperationQuiesceInput: 3, OperationRequestStop: 3,\n465|\tOperationWaitSafeBoundary: 4, OperationTerminateStale: 4,\n466|\tOperationStatus: -1,\n467|}\n468|\n469|// Receipt is one durably bound idempotency record: the canonical key, the\n470|// operation it was bound for, and the recorded result identity. AX and the\n471|// backend bind the pair before the first child side effect (§4.1); an\n472|// identical retry returns the recorded result instead of acting again.\n473|type Receipt struct {\n474|\tKey       string\n475|\tOperation Operation\n476|\tResultID  string\n477|}\n478|\n479|// Ledger is the process-local idempotency receipt table backing the §4.C\n480|// recovery rules: persist the receipt before the first side effect,\n481|// identical retry replays it, a changed operation in the window is\n482|// idempotency_mismatch, and uncertainty requires status before any start\n483|// retry. The zero value is unusable; construct with NewLedger.\n484|//\n485|// The ledger is the semantic half of durability: Export and Import move\n486|// the table across a controller crash as stable bytes, and Import refuses\n487|// a malformed or ambiguous image instead of inventing an empty table.\n488|type Ledger struct {\n489|\tmutex    sync.Mutex\n490|\treceipts map[string]Receipt\n491|}\n492|\n493|// NewLedger opens an empty receipt table.\n494|func NewLedger() *Ledger {\n495|\treturn &Ledger{receipts: make(map[string]Receipt)}\n496|}\n497|\n498|// Bind records the receipt for a key before the first side effect. A key\n499|// bound for the first time is stored and replayed back. A key bound again\n500|// with the identical operation and result replays the stored receipt: it\n501|// performs no new effect. A key bound again with a different operation or\n502|// result is idempotency_mismatch: only a successful status read proves\n503|// absence, never a second binding.\n504|func (ledger *Ledger) Bind(key string, operation Operation, resultID string) (Receipt, error) {\n505|\tif ledger == nil {\n506|\t\treturn Receipt{}, refuse(&Error{Code: CodeProtocolError, Detail: \"idempotency ledger unavailable\"})\n507|\t}\n508|\tif key == \"\" || resultID == \"\" {\n509|\t\treturn Receipt{}, refuse(&Error{Code: CodeProtocolError, Detail: \"idempotency key shape\"})\n510|\t}\n511|\tif _, err := ParseOperation(string(operation)); err != nil {\n512|\t\treturn Receipt{}, err\n513|\t}\n514|\tledger.mutex.Lock()\n515|\tdefer ledger.mutex.Unlock()\n516|\tif stored, known := ledger.receipts[key]; known {\n517|\t\tif stored.Operation != operation || stored.ResultID != resultID {\n518|\t\t\treturn Receipt{}, refuse(&Error{Code: CodeIdempotencyMismatch, Detail: \"idempotency key conflict\"})\n519|\t\t}\n520|\t\treturn stored, nil\n521|\t}\n522|\treceipt := Receipt{Key: key, Operation: operation, ResultID: resultID}\n523|\tledger.receipts[key] = receipt\n524|\treturn receipt, nil\n525|}\n526|\n527|// Replay returns the stored receipt for a key. A lost result replays the\n528|// receipt; absence of a receipt proves nothing and reports false, so the\n529|// caller must consult status before any start retry.\n530|func (ledger *Ledger) Replay(key string) (Receipt, bool) {\n531|\tif ledger == nil {\n532|\t\treturn Receipt{}, false\n533|\t}\n534|\tledger.mutex.Lock()\n535|\tdefer ledger.mutex.Unlock()\n536|\treceipt, known := ledger.receipts[key]\n537|\treturn receipt, known\n538|}\n539|\n540|// Export renders the table as stable bytes: receipts sorted by key, one\n541|// per line as key, operation, and result fields. Import refuses a\n542|// malformed image or one binding the same key twice instead of admitting\n543|// a half-read table.\n544|func (ledger *Ledger) Export() []byte {\n545|\tif ledger == nil {\n546|\t\treturn nil\n547|\t}\n548|\tledger.mutex.Lock()\n549|\tdefer ledger.mutex.Unlock()\n550|\tkeys := make([]string, 0, len(ledger.receipts))\n551|\tfor key := range ledger.receipts {\n552|\t\tkeys = append(keys, key)\n553|\t}\n554|\tsort.Strings(keys)\n555|\tvar image strings.Builder\n556|\tfor _, key := range keys {\n557|\t\treceipt := ledger.receipts[key]\n558|\t\timage.WriteString(key + \"\\n\" + string(receipt.Operation) + \"\\n\" + receipt.ResultID + \"\\n\")\n559|\t}\n560|\treturn []byte(image.String())\n561|}\n562|\n563|// AttachAuthorization is the closed, ownership-neutral AX policy object\n564|// of §4.C: exactly policy evidence, authorizing host, transport, input\n565|// boolean, and an expiry strictly after issue. It authorizes only the\n566|// named presentation transport and input boolean. It contains no lease\n567|// member of any kind and therefore cannot acquire, renew, or transfer\n568|// ownership; ParseAttachAuthorization refuses any document carrying one\n569|// as an unknown member before any other check runs.\n570|type AttachAuthorization struct {\n571|\tPolicyEvidenceID  string\n572|\tAuthorizingHostID string\n573|\tTransport         PresentationTransport\n574|\tInputAuthorized   bool\n575|\tIssuedAt          scalar.Timestamp\n576|\tExpiresAt         scalar.Timestamp\n577|}\n578|\n579|// attachAuthorizationMembers is the exact closed member set.\n580|var attachAuthorizationMembers = []string{\n581|\t\"policy_evidence_id\",\n582|\t\"authorizing_host_id\",\n583|\t\"transport\",\n584|\t\"input_authorized\",\n585|\t\"issued_at\",\n586|\t\"expires_at\",\n587|}\n588|\n589|// ParseAttachAuthorization admits one closed AttachAuthorization document.\n590|// Unknown members (including any lease, epoch, holder, or authorization\n591|// kind member smuggled into an attach policy) and missing members are\n592|// both malformed; a malformed read is an error, never an absent policy,\n593|// so callers must not fall back to an unauthenticated attach.\n594|func ParseAttachAuthorization(raw []byte) (AttachAuthorization, error) {\n595|\tobject, err := decodeStrictObject(raw)\n596|\tif err != nil {\n597|\t\treturn AttachAuthorization{}, err\n598|\t}\n599|\tif err := checkExactMembers(object, attachAuthorizationMembers); err != nil {\n600|\t\treturn AttachAuthorization{}, err\n601|\t}\n602|\tpolicyEvidenceID, err := digestMember(object, \"policy_evidence_id\")\n603|\tif err != nil {\n604|\t\treturn AttachAuthorization{}, err\n605|\t}\n606|\tauthorizingHostID, err := stringMember(object, \"authorizing_host_id\")\n607|\tif err != nil {\n608|\t\treturn AttachAuthorization{}, err\n609|\t}\n610|\tif _, err := scalar.ParseUUIDv7(authorizingHostID); err != nil {\n611|\t\treturn AttachAuthorization{}, mismatchf(\"document member type\")\n612|\t}\n613|\ttransportRaw, err := stringMember(object, \"transport\")\n614|\tif err != nil {\n615|\t\treturn AttachAuthorization{}, err\n616|\t}\n617|\ttransport, err := parseTransport(transportRaw)\n618|\tif err != nil {\n619|\t\treturn AttachAuthorization{}, err\n620|\t}\n621|\tinputRaw, known := object[\"input_authorized\"]\n622|\tif !known {\n623|\t\treturn AttachAuthorization{}, mismatchf(\"document members\")\n624|\t}\n625|\tinputAuthorized, ok := inputRaw.(bool)\n626|\tif !ok {\n627|\t\treturn AttachAuthorization{}, mismatchf(\"document member type\")\n628|\t}\n629|\tissuedAt, err := timestampMember(object, \"issued_at\")\n630|\tif err != nil {\n631|\t\treturn AttachAuthorization{}, err\n632|\t}\n633|\texpiresAt, err := timestampMember(object, \"expires_at\")\n634|\tif err != nil {\n635|\t\treturn AttachAuthorization{}, err\n636|\t}\n637|\tissued, err := issuedAt.Time()\n638|\tif err != nil {\n639|\t\treturn AttachAuthorization{}, mismatchf(\"document timestamp\")\n640|\t}\n641|\texpires, err := expiresAt.Time()\n642|\tif err != nil {\n643|\t\treturn AttachAuthorization{}, mismatchf(\"document timestamp\")\n644|\t}\n645|\tif !expires.After(issued) {\n646|\t\treturn AttachAuthorization{}, refuse(&Error{Code: CodeUnauthorized, Detail: \"attach authorization expiry\"})\n647|\t}\n648|\treturn AttachAuthorization{\n649|\t\tPolicyEvidenceID:  policyEvidenceID,\n650|\t\tAuthorizingHostID: authorizingHostID,\n651|\t\tTransport:         transport,\n652|\t\tInputAuthorized:   inputAuthorized,\n653|\t\tIssuedAt:          issuedAt,\n654|\t\tExpiresAt:         expiresAt,\n655|\t}, nil\n656|}\n657|\n658|// CheckAttachRequest authorizes one attach request against its policy at\n659|// the given instant. The request transport and input boolean must equal\n660|// the authorized ones; a relay transport is refused even when authorized\n661|// on paper, because current AX admits only local and trusted-mesh\n662|// presentation (§4.E). Expiry is checked against now: an expired policy\n663|// authorizes nothing, and a lease-shaped bypass cannot exist because the\n664|// policy has no lease member to consult.\n665|func CheckAttachRequest(auth AttachAuthorization, transport string, inputAuthorized bool, now time.Time) error {\n666|\trequested, err := parseTransport(transport)\n667|\tif err != nil {\n668|\t\treturn err\n669|\t}\n670|\tif requested != auth.Transport || inputAuthorized != auth.InputAuthorized {\n671|\t\treturn refuse(&Error{Code: CodeUnauthorized, Detail: \"attach authorization binding\"})\n672|\t}\n673|\tif requested == TransportThirdPartyRelay {\n674|\t\treturn refuse(&Error{Code: CodeUnauthorized, Detail: \"attach relay transport\"})\n675|\t}\n676|\texpires, err := auth.ExpiresAt.Time()\n677|\tif err != nil {\n678|\t\treturn mismatchf(\"document timestamp\")\n679|\t}\n680|\tif !now.Before(expires) {\n681|\t\treturn refuse(&Error{Code: CodeUnauthorized, Detail: \"attach authorization expiry\"})\n682|\t}\n683|\treturn nil\n684|}\n685|\n686|// CheckAttachResult enforces the §4.C attach result rule: the result\n687|// input boolean MUST equal both the request and the AttachAuthorization.\n688|// A backend reporting input the policy did not authorize is refused even\n689|// when the request itself was authorized.\n690|func CheckAttachResult(requestInputAuthorized, resultInputAuthorized bool, auth AttachAuthorization) error {\n691|\tif resultInputAuthorized != requestInputAuthorized || resultInputAuthorized != auth.InputAuthorized {\n692|\t\treturn refuse(&Error{Code: CodeUnauthorized, Detail: \"attach input binding\"})\n693|\t}\n694|\treturn nil\n695|}\n696|\n697|// CheckEntrypoint enforces the §4.A stable entrypoint rule: every\n698|// backend-created runtime ultimately executes exactly\n699|// `ax pane SESSION_ID`, and a raw provider command is forbidden as a\n700|// durable entry point. argv must be exactly the three literals ax, pane,\n701|// and the canonical request Session UUIDv7 string, and the carried\n702|// session must equal the session under creation.\n703|func CheckEntrypoint(argv []string, sessionID string) error {\n704|\tif len(argv) != 3 || argv[0] != \"ax\" || argv[1] != \"pane\" {\n705|\t\treturn refuse(&Error{Code: CodePreconditionFailed, Detail: \"entrypoint argv\"})\n706|\t}\n707|\tsession, err := scalar.ParseUUIDv7(sessionID)\n708|\tif err != nil {\n709|\t\treturn refuse(&Error{Code: CodePreconditionFailed, Detail: \"entrypoint session binding\"})\n710|\t}\n711|\tcarried, err := scalar.ParseUUIDv7(argv[2])\n712|\tif err != nil {\n713|\t\treturn refuse(&Error{Code: CodePreconditionFailed, Detail: \"entrypoint session binding\"})\n714|\t}\n715|\tif carried.String() != session.String() {\n716|\t\treturn refuse(&Error{Code: CodePreconditionFailed, Detail: \"entrypoint session binding\"})\n717|\t}\n718|\treturn nil\n719|}\n720|\n721|// StatusResult is the §4.C status success body in harness form. Pointer\n722|// members distinguish null from false: provider observation is null\n723|// unless requested and evidenced, and the last-operation fields are null\n724|// when the backend reports no prior operation.\n725|type StatusResult struct {\n726|\tState             InstanceState\n727|\tIdentityMatch     bool\n728|\tWrapperPresent    bool\n729|\tProviderPresent   *bool\n730|\tAttachable        bool\n731|\tLastOperationID   *string\n732|\tLastEffect        *SideEffect\n733|\tProviderRequested bool\n734|\tProviderEvidenced bool\n735|\tAttachEvidenced   bool\n736|}\n737|\n738|// CheckStatusResult enforces the §4.C exact-instance lookup rules. A\n739|// non-match sets identity_match false, state absent, wrapper absent,\n740|// provider null, attachable false, and both last fields null, and does\n741|// not authorize fallback: any deviation from that canonical false form\n742|// is refused. provider_present is null unless provider observation was\n743|// requested and evidenced. attachable is true only in parked or active\n744|// with a currently evidenced matching attach capability. A timeout or\n745|// read failure is unknown, never absent: this check validates reported\n746|// results and never synthesizes absence from a missing read.\n747|func CheckStatusResult(identityMatch bool, result StatusResult) error {\n748|\tif _, err := ParseInstanceState(string(result.State)); err != nil {\n749|\t\treturn err\n750|\t}\n751|\tif result.LastEffect != nil {\n752|\t\tif _, err := ParseSideEffect(string(*result.LastEffect)); err != nil {\n753|\t\t\treturn err\n754|\t\t}\n755|\t}\n756|\tif !identityMatch || !result.IdentityMatch {\n757|\t\tif result.IdentityMatch {\n758|\t\t\treturn refuse(&Error{Code: CodeProtocolError, Detail: \"status identity binding\"})\n759|\t\t}\n760|\t\tif result.State != StateAbsent || result.WrapperPresent ||\n761|\t\t\tresult.ProviderPresent != nil || result.Attachable ||\n762|\t\t\tresult.LastOperationID != nil || result.LastEffect != nil {\n763|\t\t\treturn refuse(&Error{Code: CodeProtocolError, Detail: \"status identity binding\"})\n764|\t\t}\n765|\t\treturn nil\n766|\t}\n767|\tif result.ProviderPresent != nil && !(result.ProviderRequested && result.ProviderEvidenced) {\n768|\t\treturn refuse(&Error{Code: CodeProtocolError, Detail: \"status provider observation\"})\n769|\t}\n770|\tif result.Attachable && !((result.State == StateParked || result.State == StateActive) && result.AttachEvidenced) {\n771|\t\treturn refuse(&Error{Code: CodePreconditionFailed, Detail: \"status attachability\"})\n772|\t}\n773|\treturn nil\n774|}\n775|\n776|// ParseSideEffect admits exactly the ten §4.C side effects.\n777|func ParseSideEffect(value string) (SideEffect, error) {\n778|\tswitch SideEffect(value) {\n779|\tcase EffectBindingPersisted, EffectWrapperStarted, EffectAttachClientCreated,\n780|\t\tEffectInputClosed, EffectSafeBoundaryObserved, EffectGracefulStopRequested,\n781|\t\tEffectProcessClosed, EffectBackendStoreClosed,\n782|\t\tEffectStaleIncarnationTerminated, EffectWrapperRestored:\n783|\t\treturn SideEffect(value), nil\n784|\tdefault:\n785|\t\treturn \"\", refuse(&Error{Code: CodeProtocolError, Detail: \"side effect vocabulary\"})\n786|\t}\n787|}\n788|\n789|// ReplicationClass is the §4.E persistence classification. Only\n790|// safe_evidence MAY persist and replicate after validation; every other\n791|// class is host-local, rebuildable, owner-only, or forbidden.\n792|type ReplicationClass string\n793|\n794|// Replication classes.\n795|const (\n796|\tReplicationSafeEvidence       ReplicationClass = \"safe_evidence\"\n797|\tReplicationHostLocal          ReplicationClass = \"host_local\"\n798|\tReplicationDerivedCache       ReplicationClass = \"derived_cache\"\n799|\tReplicationSensitiveOwnerOnly ReplicationClass = \"sensitive_owner_only\"\n800|\tReplicationForbidden          ReplicationClass = \"forbidden\"\n801|)\n802|\n803|// replicationMembers is the closed §4.E classification table. Member\n804|// names are wire vocabulary, never local data: classifying a member the\n805|// table does not know is refused rather than defaulted.\n806|var replicationMembers = buildReplicationMembers()\n807|\n808|// buildReplicationMembers assembles the closed §4.E classification table.\n809|// Member names are wire vocabulary, never local data: classifying a member\n810|// the table does not know is refused rather than defaulted.\n811|func buildReplicationMembers() map[string]ReplicationClass {\n812|\t// Safe immutable evidence: sanitized backend identity, versions,\n813|\t// platform, conformance, and capability evidence MAY persist and\n814|\t// replicate after validation.\n815|\tsafe := []string{\n816|\t\t\"manifest_id\", \"probe_id\", \"evidence_id\",\n817|\t\t\"terminal_backend_id\", \"implementation_version\",\n818|\t\t\"protocol_version\", \"protocol_versions\",\n819|\t\t\"platform\", \"platforms\", \"os_version\",\n820|\t\t\"conformance_fixture_id\", \"capability_claims\", \"evidence_ids\",\n821|\t\t\"backend_generation_digest\", \"capability\", \"dependent_operations\",\n822|\t\t\"evidence_requirements\", \"facts\", \"issuer\", \"issuer_id\",\n823|\t\t\"observed_at\", \"expires_at\",\n824|\t}\n825|\t// Host-local durable metadata: instance/binding IDs, sanitized native\n826|\t// reference, generation, idempotency receipt, last effect.\n827|\thostLocal := []string{\n828|\t\t\"binding_id\", \"terminal_instance_id\", \"session_id\",\n829|\t\t\"host_id\", \"host_incarnation_id\", \"backend_generation\",\n830|\t\t\"native_reference\", \"idempotency_receipt\", \"last_effect\",\n831|\t\t\"last_operation_id\", \"supersedes_binding_id\", \"created_at\",\n832|\t}\n833|\t// Derived cache: discovery, availability, attachability, and process\n834|\t// observations with probe views; rebuildable, non-authoritative.\n835|\tderived := []string{\n836|\t\t\"availability\", \"attachable\", \"wrapper_present\", \"provider_present\",\n837|\t\t\"identity_match\", \"state\", \"probed_at\",\n838|\t}\n839|\t// Sensitive runtime state: IPC, sockets, pipes, attach/relay\n840|\t// credentials, backend auth and live databases, GUI/login\n841|\t// attestations, provider credentials; owner-only, non-replicable.\n842|\tsensitive := []string{\n843|\t\t\"attach_descriptor\", \"ipc_handle\", \"tmux_socket\",\n844|\t\t\"named_pipe\", \"attach_credential\", \"relay_credential\",\n845|\t\t\"backend_auth\", \"auth_database\", \"gui_attestation\",\n846|\t\t\"login_attestation\", \"provider_credential\", \"evidence_secret\",\n847|\t\t\"environment_values\",\n848|\t}\n849|\t// Forbidden: raw native reference, PID/handle, endpoint/token,\n850|\t// terminal output/scrollback, unrestricted environment, credential\n851|\t// detail, and live-process facts MUST NOT replicate.\n852|\tforbidden := []string{\n853|\t\t\"native_pid\", \"process_handle\", \"endpoint\", \"token\",\n854|\t\t\"terminal_output\", \"scrollback\", \"unrestricted_environment\",\n855|\t\t\"credential_detail\", \"live_process_fact\", \"raw_native_reference\",\n856|\t}\n857|\ttable := make(map[string]ReplicationClass,\n858|\t\tlen(safe)+len(hostLocal)+len(derived)+len(sensitive)+len(forbidden))\n859|\tfor _, member := range safe {\n860|\t\ttable[member] = ReplicationSafeEvidence\n861|\t}\n862|\tfor _, member := range hostLocal {\n863|\t\ttable[member] = ReplicationHostLocal\n864|\t}\n865|\tfor _, member := range derived {\n866|\t\ttable[member] = ReplicationDerivedCache\n867|\t}\n868|\tfor _, member := range sensitive {\n869|\t\ttable[member] = ReplicationSensitiveOwnerOnly\n870|\t}\n871|\tfor _, member := range forbidden {\n872|\t\ttable[member] = ReplicationForbidden\n873|\t}\n874|\treturn table\n875|}\n876|\n877|// Import rebuilds a ledger from Export bytes. A truncated, malformed, or\n878|// ambiguous image is an error, never an empty table, so a failed read\n879|// cannot masquerade as proven absence. An empty image rebuilds the empty\n880|// table, which is exactly what Export of a fresh ledger produces.\n881|func ImportLedger(image []byte) (*Ledger, error) {\n882|\tlines := strings.Split(string(image), \"\\n\")\n883|\tif len(lines) > 0 && lines[len(lines)-1] == \"\" {\n884|\t\tlines = lines[:len(lines)-1]\n885|\t}\n886|\tif len(lines)%3 != 0 {\n887|\t\treturn nil, refuse(&Error{Code: CodeProtocolError, Detail: \"idempotency ledger image\"})\n888|\t}\n889|\tledger := NewLedger()\n890|\tfor index := 0; index < len(lines); index += 3 {\n891|\t\tkey, operation, resultID := lines[index], lines[index+1], lines[index+2]\n892|\t\tif key == \"\" || resultID == \"\" {\n893|\t\t\treturn nil, refuse(&Error{Code: CodeProtocolError, Detail: \"idempotency ledger image\"})\n894|\t\t}\n895|\t\tparsed, err := ParseOperation(operation)\n896|\t\tif err != nil {\n897|\t\t\treturn nil, refuse(&Error{Code: CodeProtocolError, Detail: \"idempotency ledger image\"})\n898|\t\t}\n899|\t\tif _, duplicate := ledger.receipts[key]; duplicate {\n900|\t\t\treturn nil, refuse(&Error{Code: CodeIdempotencyMismatch, Detail: \"idempotency ledger image\"})\n901|\t\t}\n902|\t\tledger.receipts[key] = Receipt{Key: key, Operation: parsed, ResultID: resultID}\n903|\t}\n904|\treturn ledger, nil\n905|}\n906|\n907|// ClassifyReplication reports the §4.E persistence class of one wire\n908|// member. An unlisted member reports false: the table is closed, and an\n909|// unknown member is refused rather than defaulted into any class.\n910|func ClassifyReplication(member string) (ReplicationClass, bool) {\n911|\tclass, known := replicationMembers[member]\n912|\treturn class, known\n913|}\n914|\n915|// CheckReplicable refuses a replication set carrying any member outside\n916|// the safe immutable evidence class, or any member the closed table does\n917|// not know. Host-local metadata, derived cache, sensitive runtime state,\n918|// and forbidden members MUST NOT replicate; unknown members fail the\n919|// same way, because an unclassified member replicating by default would\n920|// silently widen the §4.E exclusion. An empty set replicates nothing and\n921|// is admitted. The refusal is a protocol error: the set is a body\n922|// variant the replication contract does not cover.\n923|func CheckReplicable(members []string) error {\n924|\tfor _, member := range members {\n925|\t\tif class, known := replicationMembers[member]; !known || class != ReplicationSafeEvidence {\n926|\t\t\treturn refuse(&Error{Code: CodeProtocolError, Detail: \"replication exclusion\"})\n927|\t\t}\n928|\t}\n929|\treturn nil\n930|}\n931|\n932|// LegacyUnreported is the version and generation a historical v0.4.3\n933|// translation carries. The past reported no versions and no generation,\n934|// so the translation says exactly that instead of inferring values no\n935|// observation supports.\n936|const LegacyUnreported = \"legacy_unreported\"\n937|\n938|// LegacyBinding is the §4.E forward translation of one historical v0.4.3\n939|// backend identity: the canonical backend ID with unreported version and\n940|// generation. It carries no capability field of any kind: a translation\n941|// MUST NOT infer capabilities the historical record never evidenced, and\n942|// a struct that cannot name them cannot smuggle them. The field count is\n943|// pinned by TestLegacyBindingCarriesNoCapabilities.\n944|type LegacyBinding struct {\n945|\tBackendID             string\n946|\tImplementationVersion string\n947|\tGeneration            string\n948|}\n949|\n950|// legacyForward is the exact §4.E forward map. Only the two immutable\n951|// v0.4.3 values translate; anything else is incompatible, never fallback.\n952|var legacyForward = map[string]string{\n953|\t\"tmux\":   BuiltinTmux,\n954|\t\"conpty\": BuiltinConpty,\n955|}\n956|\n957|// TranslateLegacyBackend deterministically maps a historical v0.4.3\n958|// backend name to its canonical binding. Version and generation are\n959|// legacy_unreported and no capabilities are inferred. Translation is a\n960|// pure function over its argument: it never rewrites or re-digests\n961|// history, and the input is unchanged by construction.\n962|func TranslateLegacyBackend(legacy string) (LegacyBinding, error) {\n963|\tcanonical, known := legacyForward[legacy]\n964|\tif !known {\n965|\t\treturn LegacyBinding{}, refuse(&Error{Code: CodeIncompatibleSchema, Detail: \"legacy backend identity\"})\n966|\t}\n967|\treturn LegacyBinding{\n968|\t\tBackendID:             canonical,\n969|\t\tImplementationVersion: LegacyUnreported,\n970|\t\tGeneration:            LegacyUnreported,\n971|\t}, nil\n972|}\n973|\n974|// ProjectToLegacy is the §4.E reverse projection. It exists only for the\n975|// two canonical built-ins; every other backend ID, including a\n976|// well-formed third-party ID, returns incompatible_schema, never a\n977|// fallback. A malformed identity is not an ID at all and is refused by\n978|// the registry grammar first.\n979|func ProjectToLegacy(backendID string) (string, error) {\n980|\tif _, err := ParseID(backendID); err != nil {\n981|\t\treturn \"\", err\n982|\t}\n983|\tfor legacy, canonical := range legacyForward {\n984|\t\tif backendID == canonical {\n985|\t\t\treturn legacy, nil\n986|\t\t}\n987|\t}\n988|\treturn \"\", refuse(&Error{Code: CodeIncompatibleSchema, Detail: \"legacy reverse projection\"})\n989|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
