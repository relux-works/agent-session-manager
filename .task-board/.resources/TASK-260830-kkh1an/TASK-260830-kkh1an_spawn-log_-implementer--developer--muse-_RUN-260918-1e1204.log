\\\"description\\\":\\\"Non-negative scale value\\\"}],\\\"examples\\\":[\\\"set_estimate(TASK-260218-abc123, estimate=notEstimated)\\\",\\\"set_estimate(TASK-260218-abc123, estimate=estimated, scale=fibonacci, number=5)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":true},\\\"set_notes\\\":{\\\"description\\\":\\\"Append or replace notes on an element\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\",\\\"required\\\":true},{\\\"name\\\":\\\"text\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Notes text\\\",\\\"required\\\":true},{\\\"name\\\":\\\"set\\\",\\\"type\\\":\\\"bool\\\",\\\"optional\\\":true,\\\"default\\\":false,\\\"description\\\":\\\"Replace all notes instead of appending\\\"},{\\\"name\\\":\\\"txn_id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Integration transaction token presented to satisfy a transition lease; it authorizes nothing else\\\"}],\\\"examples\\\":[\\\"set_notes(TASK-260218-abc123, text=\\\\\\\"Started implementation\\\\\\\")\\\",\\\"set_notes(TASK-260218-abc123, text=\\\\\\\"Full replacement\\\\\\\", set=true)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false},\\\"set_parent\\\":{\\\"description\\\":\\\"Move element to a different parent\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID to move\\\",\\\"required\\\":true},{\\\"name\\\":\\\"parent\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"New parent element ID\\\",\\\"required\\\":true}],\\\"examples\\\":[\\\"set_parent(TASK-260218-abc123, parent=STORY-260218-def456)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false},\\\"set_status\\\":{\\\"description\\\":\\\"Change element status with auto-promotion and escalation\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optio