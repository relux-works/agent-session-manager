{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf41","stream":{"kind":"session","id":"01a0b201-5e84-7ea0-8bc6-d79919cbe007"},"sequence":1531,"recorded_at":1780531400003057,"record_type":"event","durability":"durable","causation_id":"9e30868d-563f-43f3-9fe7-d9ddb65377f0","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9e30868d-563f-43f3-9fe7-d9ddb65377f0","run_stream":{"kind":"run","id":"9e30868d-563f-43f3-9fe7-d9ddb65377f0"},"task_stream":{"kind":"task","id":"01a0b20f-7b8b-7f13-b7e5-fd1d9a95c452"},"task_id":"01a0b20f-7b8b-7f13-b7e5-fd1d9a95c452","event":{"kind":"output","task_id":"01a0b20f-7b8b-7f13-b7e5-fd1d9a95c452","chunk":"edited\nchanged lines: lines 108-131\n--- original\n+++ updated\n@@\n-// checkSortedUniqueEvidence enforces sorted-unique digest[0..256]. Order\n-// and uniqueness are separate arms for the same reason as the effects\n-// twin: each half owns its mutant.\n-func checkSortedUniqueEvidence(evidence []string) error {\n-\tif len(evidence) > 256 {\n-\t\treturn refuse(CodeProtocolError, \"result evidence bound\")\n-\t}\n-\tfor _, id := range evidence {\n-\t\tif _, err := scalar.ParseDigest(id); err != nil {\n-\t\t\treturn refuse(CodeProtocolError, \"result evidence digest\")\n-\t\t}\n-\t}\n-\tfor index := 1; index < len(evidence); index++ {\n-\t\tif evidence[index-1] == evidence[index] {\n-\t\t\treturn refuse(CodeProtocolError, \"result evidence unique\")\n-\t\t}\n-\t}\n-\tfor index := 1; index < len(evidence); index++ {\n-\t\tif evidence[index-1] > evidence[index] {\n-\t\t\treturn refuse(CodeProtocolError, \"result evidence order\")\n-\t\t}\n-\t}\n-\treturn nil\n-}\n+// checkSortedUniqueEvidence enforces sorted-unique digest[0..256] on a\n+// mutation result. Order and uniqueness are separate arms for the same\n+// reason as the effects twin: each half owns its mutant.\n+func checkSortedUniqueEvidence(evidence []string) error {\n+\treturn checkSortedUniqueEvidenceWhere(evidence, \"result\")\n+}\n+\n+// checkSortedUniqueStatusEvidence enforces the same sorted-unique\n+// digest[0..256] rule on a status report. The rule is shared; only the\n+// static detail site differs, so a status mutant and a result mutant\n+// cannot kill each other's arm.\n+func checkSortedUniqueStatusEvidence(evidence []string) error {\n+\treturn checkSortedUniqueEvidenceWhere(evidence, \"status\")\n+}\n+\n+func checkSortedUniqueEvidenceWhere(evidence []string, where string) error {\n+\tif len(evidence) > 256 {\n+\t\treturn refuse(CodeProtocolError, where+\" evidence bound\")\n+\t}\n+\tfor _, id := range evidence {\n+\t\tif _, err := scalar.ParseDigest(id); err != nil {\n+\t\t\treturn refuse(CodeProtocolError, where+\" evidence digest\")\n+\t\t}\n+\t}\n+\tfor index := 1; index < len(evidence); index++ {\n+\t\tif evidence[index-1] == evidence[index] {\n+\t\t\treturn refuse(CodeProtocolError, where+\" evidence unique\")\n+\t\t}\n+\t}\n+\tfor index := 1; index < len(evidence); index++ {\n+\t\tif evidence[index-1] > evidence[index] {\n+\t\t\treturn refuse(CodeProtocolError, where+\" evidence order\")\n+\t\t}\n+\t}\n+\treturn nil\n+}\n","final_result":true}}}
