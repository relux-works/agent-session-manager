_retention(leases_observed=true)\\\",\\\"sweep_context_retention(leases_observed=true, settings=\\\\\\\"ready_ttl=168h;max_ready_per_binding=2\\\\\\\")\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":true},\\\"sweep_context_validation_audits\\\":{\\\"description\\\":\\\"Run every due no-model validation audit across ready contexts\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"provider\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Provider lineage\\\",\\\"enum\\\":[\\\"codex\\\",\\\"claude\\\"]},{\\\"name\\\":\\\"kind\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Output kind\\\",\\\"enum\\\":[\\\"project\\\",\\\"role\\\",\\\"task\\\"]},{\\\"name\\\":\\\"at\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"RFC3339 sweep instant\\\"}],\\\"examples\\\":[\\\"sweep_context_validation_audits(kind=project)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false},\\\"switch_user\\\":{\\\"description\\\":\\\"Switch active user for a remote using non-versioned local state\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"user\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"User ID to switch to\\\",\\\"required\\\":true},{\\\"name\\\":\\\"remote\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Remote URL (defaults to current remote)\\\"}],\\\"examples\\\":[\\\"switch_user(user=admin)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":true},\\\"unassign\\\":{\\\"description\\\":\\\"Remove agent assignment from an element\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\",\\\"required\\\":true}],\\\"examples\\\":[\\\"unassign(TASK-260218-abc123)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":true},\\\"uncheck_item\\\":{\\\"description\\\":\\\"Uncheck a checklist item\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\",\\\"required\\\":true},{\\\"name\\\":\\\"item\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Checklist item number (1-based)\\\",\\\"required\\\":true}],\\\"examples\\\":[\\\"uncheck_item(TASK-260218-abc123, item=2)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":true},\\\"undefer_cr\\\":{\\\"description\\\":\\\"Clear the deferral marker set by defer_cr; the revision is landing backlog again\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID carrying the Change Request\\\",\\\"required\\\":true},{\\\"name\\\":\\\"revision\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Change Request revision being un-deferred (expected-revision CAS)\\\",\\\"required\\\":true}],\\\"examples\\\":[\\\"undefer_cr(STORY-260908-1s0ekw, revision=1)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false},\\\"unlink\\\":{\\\"description\\\":\\\"Remove dependency between elements\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element that was blocked\\\",\\\"required\\\":true},{\\\"name\\\":\\\"blocked_by\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element that was blocking\\\",\\\"required\\\":true}],\\\"examples\\\":[\\\"unlink(TASK-260218-abc123, blocked_by=TASK-260218-def456)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false},\\\"update_resource\\\":{\\\"description\\\":\\\"Replace an existing resource on an element\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID\\\",\\\"required\\\":true},{\\\"name\\\":\\\"name\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Resource name to replace\\\",\\\"required\\\":true},{\\\"name\\\":\\\"content\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Replacement content (text); required if path is not provided\\\"},{\\\"name\\\":\\\"path\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Client-local file path (remote CLI inlines content; board-server rejects raw paths)\\\"},{\\\"name\\\":\\\"type\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"default\\\":\\\"outcome\\\",\\\"description\\\":\\\"Resource type\\\",\\\"enum\\\":[\\\"precondition\\\",\\\"outcome\\\"]},{\\\"name\\\":\\\"description\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"One-line description\\\"}],\\\"examples\\\":[\\\"update_resource(TASK-260218-abc123, name=\\\\\\\"research.md\\\\\\\", content=\\\\\\\"revised\\\\\\\", type=outcome)\\\",\\\"update_resource(TASK-260218-abc123, name=\\\\\\\"spec.md\\\\\\\", path=\\\\\\\".temp/spec.md\\\\\\\", type=precondition)\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false},\\\"withdraw_cr\\\":{\\\"description\\\":\\\"Retire an unintegrated Change Request revision with a written reason, so it stops blocking the Story\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"id\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Element ID carrying the Change Request\\\",\\\"required\\\":true},{\\\"name\\\":\\\"revision\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Change Request revision being retired (expected-revision CAS)\\\",\\\"required\\\":true},{\\\"name\\\":\\\"reason\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":false,\\\"description\\\":\\\"Written reason the revision will never be integrated\\\",\\\"required\\\":true}],\\\"examples\\\":[\\\"withdraw_cr(STORY-260828-2xwsub, revision=1, reason=\\\\\\\"research-only run, zero repository delta, never routed to a reviewer\\\\\\\")\\\"],\\\"destructive\\\":false,\\\"idempotent\\\":false}},\\\"mutations\\\":[\\\"accept_cr\\\",\\\"add_checklist_item\\\",\\\"add_resource\\\",\\\"assign\\\