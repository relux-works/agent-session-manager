v\", file, err)\n+\t}\n+\treturn parsed\n+}\n","edit_facts":{"tool_name":"edit_file","path":"internal/terminstance/conformance_test.go","added":17,"removed":25},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
