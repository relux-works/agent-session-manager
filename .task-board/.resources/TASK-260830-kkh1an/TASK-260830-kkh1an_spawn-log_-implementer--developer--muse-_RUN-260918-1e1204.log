{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7d7","stream":{"kind":"session","id":"01a0b201-5e84-7ea0-8bc6-d79919cbe007"},"sequence":582,"recorded_at":1780531400001159,"record_type":"event","durability":"durable","causation_id":"9e30868d-563f-43f3-9fe7-d9ddb65377f0","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9e30868d-563f-43f3-9fe7-d9ddb65377f0","run_stream":{"kind":"run","id":"9e30868d-563f-43f3-9fe7-d9ddb65377f0"},"task_stream":{"kind":"task","id":"01a0b202-f320-7232-aa1a-6e78c4e3ea9d"},"task_id":"01a0b202-f320-7232-aa1a-6e78c4e3ea9d","event":{"kind":"output","task_id":"01a0b202-f320-7232-aa1a-6e78c4e3ea9d","chunk":"Read text file `internal/terminalbackend/descriptor.go`.\n1|// Provider Protocol 3.0.0 Terminal Instance descriptor admission.\n2|//\n3|// Normative scope is relux-works/agent-session-manager-spec@v0.5.0 §7.A:\n4|// Provider Protocol 3.0.0 retains the exact v2 framing and replaces every\n5|// occurrence of the v2 TerminalDescriptor with one closed v3 object. This\n6|// file owns the v3-specific production rule: parsing the closed descriptor\n7|// document and matching it against the AX-validated host-local binding\n8|// before a provider process is launched or observed. Transport framing,\n9|// deadlines, and dispatch stay with the v2 machinery; the v3 failure-error\n10|// binding (Structured Error 1.3.0) is resolved through axerror.BindingFor\n11|// by the dual-stack host, which does not exist yet (see the stated bound\n12|// in internal/provhost/doc.go).\n13|//\n14|// The provider-side MUST this file enforces is: reject a descriptor whose\n15|// binding digest, backend ID/version, or generation does not match the\n16|// AX-validated host-local binding. Shape validation (the closed member set\n17|// and every per-member constraint) runs first so a malformed descriptor is\n18|// refused as a protocol violation, never compared as a binding.\n19|//\n20|// Future caller, recorded so the next leaf inherits the question rather\n21|// than rediscovering it: AdmitProviderDescriptor has no production caller\n22|// yet. It belongs on the v3 launch/observe path — the dual-stack host\n23|// follow-up named in internal/provhost/doc.go — which must admit the\n24|// candidate TerminalDescriptor against the AX-validated host-local\n25|// binding immediately before spawning the provider process (launch) and\n26|// before trusting a status observation (observe), and refuse the\n27|// operation on mismatch. Wiring it anywhere else (after spawn, on a\n28|// retry path that reuses an admitted descriptor without re-checking\n29|// generation) would admit a stale binding; the call order is parse,\n30|// match, then launch, with no caching of the admitted value across\n31|// generation changes.\n32|package terminalbackend\n33|\n34|import (\n35|\t\"encoding/json\"\n36|\n37|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n38|)\n39|\n40|// descriptorMembers is the exact closed §7.A member set: eight table rows,\n41|// nine members, because columns and rows are two members. No other member\n42|// is permitted. It is package-level so the inventory derivation sees the\n43|// single construction site; widening it must redden the member-set test,\n44|// not pass silently.\n45|var descriptorMembers = []string{\n46|\t\"terminal_binding_id\",\n47|\t\"terminal_instance_id\",\n48|\t\"terminal_backend_id\",\n49|\t\"implementation_version\",\n50|\t\"protocol_version\",\n51|\t\"backend_generation\",\n52|\t\"interactive\",\n53|\t\"columns\",\n54|\t\"rows\",\n55|}\n56|\n57|// ProviderDescriptor is one validated §7.A v3 TerminalDescriptor. Every\n58|// value is trustworthy only when produced by ParseProviderDescriptor: the\n59|// zero value is not valid (empty digest, empty generation, zero geometry),\n60|// and no constructor outside this file may mint one. Columns and Rows\n61|// carry the §7.A uint16[1..1000] bound; the Go type holds the uint16 half\n62|// and the parse entry holds the 1..1000 half.\n63|type ProviderDescriptor struct {\n64|\tTerminalBindingID     string\n65|\tTerminalInstanceID    string\n66|\tTerminalBackendID     string\n67|\tImplementationVersion string\n68|\tProtocolVersion       string\n69|\tBackendGeneration     string\n70|\tInteractive           bool\n71|\tColumns               uint16\n72|\tRows                  uint16\n73|}\n74|\n75|// Binding projects the AX-validated binding subset §7.A matches: binding\n76|// digest, backend ID, versions, and generation. Instance identity,\n77|// interactivity, and geometry are carried context, matched to nothing.\n78|func (descriptor ProviderDescriptor) Binding() InstanceBinding {\n79|\treturn InstanceBinding{\n80|\t\tBackendID:             descriptor.TerminalBackendID,\n81|\t\tImplementationVersion: descriptor.ImplementationVersion,\n82|\t\tProtocolVersion:       descriptor.ProtocolVersion,\n83|\t\tGeneration:            descriptor.BackendGeneration,\n84|\t\tTerminalBindingID:     descriptor.TerminalBindingID,\n85|\t}\n86|}\n87|\n88|// AdmitProviderDescriptor is the complete §7.A provider-side gate: parse\n89|// the closed descriptor document, then match it against the AX-validated\n90|// host-local binding. A malformed document is refused with\n91|// terminal_backend_protocol_error before any comparison runs; a\n92|// well-formed document that does not match is refused with the binding\n93|// arm CheckProviderDescriptor reports. Admitted documents return the\n94|// parsed descriptor for the launch path to carry.\n95|func AdmitProviderDescriptor(doc []byte, binding InstanceBinding) (ProviderDescriptor, error) {\n96|\tdescriptor, err := ParseProviderDescriptor(doc)\n97|\tif err != nil {\n98|\t\treturn ProviderDescriptor{}, err\n99|\t}\n100|\tif err := CheckProviderDescriptor(descriptor.Binding(), binding); err != nil {\n101|\t\treturn ProviderDescriptor{}, err\n102|\t}\n103|\treturn descriptor, nil\n104|}\n105|\n106|// ParseProviderDescriptor validates one closed §7.A descriptor document.\n107|// Member-set violations (an unknown member or a missing member) are one\n108|// arm: the rule is the closed set itself, and the member-set test\n109|// enumerates the extra, missing, and duplicate shapes against it. Member\n110|// type violations (a non-string string member) are one arm for the same\n111|// reason: JSON type discipline is one obligation, enumerated across all\n112|// six string members by the member-type test.\n113|func ParseProviderDescriptor(doc []byte) (ProviderDescriptor, error) {\n114|\tobject, err := decodeStrictObject(doc)\n115|\tif err != nil {\n116|\t\treturn ProviderDescriptor{}, err\n117|\t}\n118|\tif len(object) != len(descriptorMembers) {\n119|\t\treturn ProviderDescriptor{}, refuse(&Error{Code: CodeProtocolError, Detail: \"descriptor member set\"})\n120|\t}\n121|\tfor _, member := range descriptorMembers {\n122|\t\tif _, known := object[member]; !known {\n123|\t\t\treturn ProviderDescriptor{}, refuse(&Error{Code: CodeProtocolError, Detail: \"descriptor member set\"})\n124|\t\t}\n125|\t}\n126|\tbindingID, err := descriptorText(object, \"terminal_binding_id\")\n127|\tif err != nil {\n128|\t\treturn ProviderDescriptor{}, err\n129|\t}\n130|\tif _, err := scalar.ParseDigest(bindingID); err != nil {\n131|\t\treturn ProviderDescriptor{}, refuse(&Error{Code: CodeProtocolError, Detail: \"descriptor digest\"})\n132|\t}\n133|\tinstanceID, err := descriptorText(object, \"terminal_instance_id\")\n134|\tif err != nil {\n135|\t\treturn ProviderDescriptor{}, err\n136|\t}\n137|\t// The UUIDv7 grammar is the decidable half of the §7.A identity rule:\n138|\t// a PID, socket, path, pipe, URL, handle, token, or native reference\n139|\t// cannot spell a 36-character hyphenated UUIDv7, so grammar admission\n140|\t// is identity-shape admission. The undecidable half (a UUIDv7 that\n141|\t// names no live instance) is the binding's business, not the\n142|\t// document's.\n143|\tif _, err := scalar.ParseUUIDv7(instanceID); err != nil {\n144|\t\treturn ProviderDescriptor{}, refuse(&Error{Code: CodeProtocolError, Detail: \"descriptor instance\"})\n145|\t}\n146|\tbackendID, err := descriptorText(object, \"terminal_backend_id\")\n147|\tif err != nil {\n148|\t\treturn ProviderDescriptor{}, err\n149|\t}\n150|\tif _, err := ParseID(backendID); err != nil {\n151|\t\treturn ProviderDescriptor{}, err\n152|\t}\n153|\timplementationVersion, err := descriptorText(object, \"implementation_version\")\n154|\tif err != nil {\n155|\t\treturn ProviderDescriptor{}, err\n156|\t}\n157|\t// Shape only: equality to the admitted Manifest and Probe is the\n158|\t// binding match CheckProviderDescriptor performs against versions the\n159|\t// registry validated at admission, so a well-formed version here is\n160|\t// compared, never trusted, there.\n161|\tif !semverPattern.MatchString(implementationVersion) {\n162|\t\treturn ProviderDescriptor{}, refuse(&Error{Code: CodeProtocolError, Detail: \"descriptor implementation version\"})\n163|\t}\n164|\tprotocolVersion, err := descriptorText(object, \"protocol_version\")\n165|\tif err != nil {\n166|\t\treturn ProviderDescriptor{}, err\n167|\t}\n168|\tif !semverPattern.MatchString(protocolVersion) || semverMajor(protocolVersion) != 1 {\n169|\t\treturn ProviderDescriptor{}, refuse(&Error{Code: CodeProtocolError, Detail: \"descriptor protocol version\"})\n170|\t}\n171|\tgeneration, err := descriptorText(object, \"backend_generation\")\n172|\tif err != nil {\n173|\t\treturn ProviderDescriptor{}, err\n174|\t}\n175|\t// The string[1..256] bound is the registry's own rule, enforced by\n176|\t// its own arm; a descriptor generation outside it is the same\n177|\t// violation wherever it is read.\n178|\tif err := checkGeneration(generation); err != nil {\n179|\t\treturn ProviderDescriptor{}, err\n180|\t}\n181|\tinteractive, ok := object[\"interactive\"].(bool)\n182|\tif !ok {\n183|\t\treturn ProviderDescriptor{}, refuse(&Error{Code: CodeProtocolError, Detail: \"descriptor interactive\"})\n184|\t}\n185|\tcolumns, err := descriptorGeometry(object, \"columns\")\n186|\tif err != nil {\n187|\t\treturn ProviderDescriptor{}, err\n188|\t}\n189|\trows, err := descriptorGeometry(object, \"rows\")\n190|\tif err != nil {\n191|\t\treturn ProviderDescriptor{}, err\n192|\t}\n193|\treturn ProviderDescriptor{\n194|\t\tTerminalBindingID:     bindingID,\n195|\t\tTerminalInstanceID:    instanceID,\n196|\t\tTerminalBackendID:     backendID,\n197|\t\tImplementationVersion: implementationVersion,\n198|\t\tProtocolVersion:       protocolVersion,\n199|\t\tBackendGeneration:     generation,\n200|\t\tInteractive:           interactive,\n201|\t\tColumns:               columns,\n202|\t\tRows:                  rows,\n203|\t}, nil\n204|}\n205|\n206|// descriptorText extracts a required string member. Numbers, booleans,\n207|// nulls, arrays, and objects are refused: no string member of the §7.A\n208|// descriptor takes them.\n209|func descriptorText(object map[string]any, name string) (string, error) {\n210|\tvalue, ok := object[name].(string)\n211|\tif !ok {\n212|\t\treturn \"\", refuse(&Error{Code: CodeProtocolError, Detail: \"descriptor member type\"})\n213|\t}\n214|\treturn value, nil\n215|}\n216|\n217|// descriptorGeometry extracts a required uint16[1..1000] member. The\n218|// strict decoder delivers numbers as json.Number, so the literal must\n219|// spell an unsigned integer: a fraction, exponent, or sign is not one,\n220|// even when it names the same mathematical value. Canonical geometry\n221|// carries counts, never measurements.\n222|func descriptorGeometry(object map[string]any, name string) (uint16, error) {\n223|\t// Three arms, one site each, shared by both geometry members: the JSON\n224|\t// number type, the unsigned-integer literal shape, and the 1..1000\n225|\t// bound are three distinct rules, and the geometry test enumerates the\n226|\t// columns shapes and the rows shapes against each of them.\n227|\tliteral, ok := object[name].(json.Number)\n228|\tif !ok {\n229|\t\treturn 0, refuse(&Error{Code: CodeProtocolError, Detail: \"descriptor geometry type\"})\n230|\t}\n231|\tdigits := literal.String()\n232|\tvalue := 0\n233|\tfor i := 0; i < len(digits); i++ {\n234|\t\tdigit := digits[i]\n235|\t\tif digit < '0' || digit > '9' {\n236|\t\t\treturn 0, refuse(&Error{Code: CodeProtocolError, Detail: \"descriptor geometry digits\"})\n237|\t\t}\n238|\t\t// Refuse on the first digit that would exceed the bound rather\n239|\t\t// than accumulating past it: value is at most 100 here, so the\n240|\t\t// multiply below cannot wrap on any platform, and a literal\n241|\t\t// naming more than 1000 is refused before its low bits can\n242|\t\t// alias an in-range number downstream would trust as read.\n243|\t\tif value > 100 {\n244|\t\t\treturn 0, refuse(&Error{Code: CodeProtocolError, Detail: \"descriptor geometry bound\"})\n245|\t\t}\n246|\t\tvalue = value*10 + int(digit-'0')\n247|\t}\n248|\t// An empty literal spells no digits, so value stays 0 and lands on\n249|\t// the bound arm rather than needing an arm of its own.\n250|\tif value < 1 || value > 1000 {\n251|\t\treturn 0, refuse(&Error{Code: CodeProtocolError, Detail: \"descriptor geometry bound\"})\n252|\t}\n253|\treturn uint16(value), nil\n254|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7d9","stream":{"kind":"session","id":"01a0b201-5e84-7ea0-8bc6-d79919cbe007"},"sequence":583,"recorded_at":1780531400001161,"record_type":"event","durability":"durable","causation_id":"9e30868d-563f-43f3-9fe7-d9ddb65377f0","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9e30868d-563f-43f3-9fe7-d9ddb65377f0","run_stream":{"kind":"run","id":"9e30868d-563f-43f3-9fe7-d9ddb65377f0"},"task_stream":{"kind":"task","id":"01a0b202-f320-7232-aa1a-6e78c4e3ea9d"},"task_id":"01a0b202-f320-7232-aa1a-6e78c4e3ea9d","event":{"kind":"completed","task_id":"01a0b202-f320-7232-aa1a-6e78c4e3ea9d"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7db","stream":{"kind":"session","id":"01a0b201-5e84-7ea0-8bc6-d79919cbe007"},"sequence":584,"recorded_at":1780531400001163,"record_type":"event","durability":"durable","causation_id":"9e30868d-563f-43f3-9fe7-d9ddb65377f0","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"9e30868d-563f-43f3-9fe7-d9ddb65377f0","run_stream":{"kind":"run","id":"9e30868d-563f-43f3-9fe7-d9ddb65377f0"},"task_stream":{"kind":"task","id":"01a0b202-f300-7511-825f-9a1af6945d64"},"task_id":"01a0b202-f300-7511-825f-9a1af6945d64","event":{"kind":"output","task_id":"01a0b202-f300-7511-825f-9a1af6945d64","chunk":"Read text file `internal/terminalbackend/manifest.go`.\n(259 line(s) above)\n260|\t// maxIdentityDocumentBytes is the AX omit-self identity bound the\n261|\t// canonical owner enforces before any identity calculation: an\n262|\t// encoded identity object over 5 MiB is refused before decoding,\n263|\t// so this package refuses it at the same gate rather than\n264|\t// admitting through the direct parse entries what the shared\n265|\t// identity entry refuses.\n266|\tmaxIdentityDocumentBytes = 5_242_880\n267|)\n268|\n269|// mismatchf refuses with CodeMismatch and a static detail clause. The clause\n270|// must never interpolate local data: paths, digests, generations, and\n271|// document bytes stay out of errors.\n272|//\n273|//go:noinline\n274|func mismatchf(format string, arguments ...any) *Error {\n275|\terr := &Error{Code: CodeMismatch, Detail: fmt.Sprintf(format, arguments...)}\n276|\tif recordRefusal != nil {\n277|\t\trecordRefusal(err.Code, err.Detail)\n278|\t}\n279|\treturn err\n280|}\n281|\n282|// hasLoneSurrogateEscape reports whether raw JSON carries a lone surrogate\n283|// code point inside any string literal, either as a \\uXXXX escape or as raw\n284|// WTF-8 (CESU-8) bytes ED A0..BF 80..BF, which decode to U+D800..U+DFFF.\n285|// It answers only the surrogate question: malformed escapes, other invalid\n286|// UTF-8, unescaped control characters, and unterminated strings are left\n287|// for the decoder's syntax and encoding arms, which refuse them with their\n288|// own details. The scan mirrors internal/canonicaljson\n289|// validateSurrogateEscapes without importing it: canonicaljson is\n290|// byte-identical across stories and must not be edited at integration, so\n291|// the two copies are pinned equal by\n292|// TestSurrogateGateAgreesWithCanonicalJSON instead of shared.\n293|func hasLoneSurrogateEscape(raw []byte) bool {\n294|\tfor index := 0; index < len(raw); index++ {\n295|\t\tif raw[index] != '\"' {\n296|\t\t\tcontinue\n297|\t\t}\n298|\t\tfor index++; index < len(raw); index++ {\n299|\t\t\tif isWTF8SurrogateAt(raw, index) {\n300|\t\t\t\treturn true\n301|\t\t\t}\n302|\t\t\tswitch raw[index] {\n303|\t\t\tcase '\"':\n304|\t\t\t\tgoto stringComplete\n305|\t\t\tcase '\\\\':\n306|\t\t\t\tindex++\n307|\t\t\t\tif index >= len(raw) {\n308|\t\t\t\t\treturn false\n309|\t\t\t\t}\n310|\t\t\t\t// The escaped byte is skipped by the switch below without\n311|\t\t\t\t// passing the loop head, so test it here: a WTF-8 head\n312|\t\t\t\t// immediately after a backslash (for example \"...\\n<ED A0\n313|\t\t\t\t// 80>...\") is still raw bytes on the wire, not an escape.\n314|\t\t\t\tif isWTF8SurrogateAt(raw, index) {\n315|\t\t\t\t\treturn true\n316|\t\t\t\t}\n317|\t\t\t\tif raw[index] != 'u' {\n318|\t\t\t\t\tcontinue\n319|\t\t\t\t}\n320|\t\t\t\tunit, end, ok := readUTF16EscapeUnit(raw, index-1)\n321|\t\t\t\tif !ok {\n322|\t\t\t\t\tcontinue\n323|\t\t\t\t}\n324|\t\t\t\tindex = end - 1\n325|\t\t\t\tswitch {\n326|\t\t\t\tcase unit >= 0xd800 && unit <= 0xdbff:\n327|\t\t\t\t\tsecond, secondEnd, ok := readUTF16EscapeUnit(raw, end)\n328|\t\t\t\t\tif !ok || second < 0xdc00 || second > 0xdfff {\n329|\t\t\t\t\t\treturn true\n330|\t\t\t\t\t}\n331|\t\t\t\t\tindex = secondEnd - 1\n332|\t\t\t\tcase unit >= 0xdc00 && unit <= 0xdfff:\n333|\t\t\t\t\treturn true\n334|\t\t\t\t}\n335|\t\t\t}\n336|\t\t}\n337|\tstringComplete:\n338|\t}\n339|\treturn false\n340|}\n341|\n342|// isWTF8SurrogateAt reports whether raw[index] begins a three-byte WTF-8\n343|// (CESU-8) encoding of a surrogate code point: ED A0..BF 80..BF decodes to\n344|// U+D800..U+DFFF, which utf8.Valid refuses. Only this ED range is\n345|// surrogate-shaped: ED 80..9F heads U+D000..U+D7FF, which is valid UTF-8\n346|// and must not match. A truncated tail cannot be classified here and is\n347|// left for the encoding arm.\n348|func isWTF8SurrogateAt(raw []byte, index int) bool {\n349|\treturn index+2 < len(raw) && raw[index] == 0xed &&\n350|\t\traw[index+1] >= 0xa0 && raw[index+1] <= 0xbf &&\n351|\t\traw[index+2] >= 0x80 && raw[index+2] <= 0xbf\n352|}\n353|\n354|// readUTF16EscapeUnit reads one \\uXXXX escape at raw[start] (which must be\n355|// the backslash). It reports false when the escape is absent or malformed;\n356|// malformed escapes are refused by the decoder's syntax arm, so this gate\n357|// only needs to stay silent on them rather than diagnose them.\n358|func readUTF16EscapeUnit(raw []byte, start int) (uint16, int, bool) {\n359|\tif start < 0 || start+6 > len(raw) || raw[start] != '\\\\' || raw[start+1] != 'u' {\n360|\t\treturn 0, start, false\n361|\t}\n362|\tvar unit uint16\n363|\tfor _, digit := range raw[start+2 : start+6] {\n364|\t\tunit <<= 4\n365|\t\tswitch {\n366|\t\tcase digit >= '0' && digit <= '9':\n367|\t\t\tunit |= uint16(digit - '0')\n368|\t\tcase digit >= 'a' && digit <= 'f':\n369|\t\t\tunit |= uint16(digit-'a') + 10\n370|\t\tcase digit >= 'A' && digit <= 'F':\n371|\t\t\tunit |= uint16(digit-'A') + 10\n372|\t\tdefault:\n373|\t\t\treturn 0, start, false\n374|\t\t}\n375|\t}\n376|\treturn unit, start + 6, true\n377|}\n378|\n379|// decodeStrictObject decodes one JSON object with duplicate-key refusal,\n380|// invalid-UTF-8 refusal, lone-surrogate-escape refusal, a nesting cap, and\n381|// trailing-data refusal. The surrogate scan runs on the raw bytes before\n382|// any canonicalization (SPEC.md:289): Go's encoding/json would silently\n383|// replace a lone \\ud800 with U+FFFD, hiding the violation from every later\n384|// member check. Numbers\n385|// decode as json.Number so member validators can refuse them explicitly:\n386|// none of the three closed schemas has a numeric member.\n387|func decodeStrictObject(raw []byte) (map[string]any, error) {\n388|\tif len(raw) > maxIdentityDocumentBytes {\n389|\t\treturn nil, mismatchf(\"document size\")\n390|\t}\n391|\tif !utf8.Valid(raw) {\n392|\t\treturn nil, mismatchf(\"document encoding\")\n393|\t}\n394|\tif hasLoneSurrogateEscape(raw) {\n395|\t\treturn nil, mismatchf(\"document surrogate escape\")\n396|\t}\n397|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n398|\tdecoder.UseNumber()\n399|\tvalue, err := decodeCappedValue(decoder, 0)\n400|\tif err != nil {\n401|\t\treturn nil, err\n402|\t}\n403|\tif decoder.More() {\n404|\t\treturn nil, mismatchf(\"document trailing data\")\n405|\t}\n406|\tobject, ok := value.(map[string]any)\n407|\tif !ok {\n408|\t\treturn nil, mismatchf(\"document shape\")\n409|\t}\n410|\treturn object, nil\n411|}\n412|\n413|// decodeCappedValue decodes one JSON value with an explicit depth bound. The\n414|// bound is far above the deepest legitimate nesting (object, claims array,\n415|// claim object, member array) and fails closed below any decoder-stack risk.\n416|func decodeCappedValue(decoder *json.Decoder, depth int) (any, error) {\n417|\tif depth > maxJSONDepth {\n418|\t\treturn nil, mismatchf(\"document nesting\")\n419|\t}\n420|\ttoken, err := decoder.Token()\n421|\tif err != nil {\n422|\t\treturn nil, mismatchf(\"document syntax\")\n423|\t}\n424|\tif delimiter, ok := token.(json.Delim); ok {\n425|\t\tswitch delimiter {\n426|\t\tcase '{':\n427|\t\t\tobject := make(map[string]any)\n428|\t\t\tfor decoder.More() {\n429|\t\t\t\tkeyToken, err := decoder.Token()\n430|\t\t\t\tif err != nil {\n431|\t\t\t\t\treturn nil, mismatchf(\"document syntax\")\n432|\t\t\t\t}\n433|\t\t\t\tkey, ok := keyToken.(string)\n434|\t\t\t\tif !ok {\n435|\t\t\t\t\treturn nil, mismatchf(\"document syntax\")\n436|\t\t\t\t}\n437|\t\t\t\tif _, duplicate := object[key]; duplicate {\n438|\t\t\t\t\treturn nil, mismatchf(\"document duplicate member\")\n439|\t\t\t\t}\n440|\t\t\t\tmember, err := decodeCappedValue(decoder, depth+1)\n441|\t\t\t\tif err != nil {\n442|\t\t\t\t\treturn nil, err\n443|\t\t\t\t}\n444|\t\t\t\tobject[key] = member\n445|\t\t\t}\n446|\t\t\tif _, err := decoder.Token(); err != nil {\n447|\t\t\t\treturn nil, mismatchf(\"document syntax\")\n448|\t\t\t}\n449|\t\t\treturn object, nil\n450|\t\tcase '[':\n451|\t\t\t// Non-nil initialization: an empty wire array must round-trip\n452|\t\t\t// as [] rather than null, or identity recomputation over an\n453|\t\t\t// empty claim or evidence list diverges from the signer.\n454|\t\t\tarray := []any{}\n455|\t\t\tfor decoder.More() {\n456|\t\t\t\tmember, err := decodeCappedValue(decoder, depth+1)\n457|\t\t\t\tif err != nil {\n458|\t\t\t\t\treturn nil, err\n459|\t\t\t\t}\n460|\t\t\t\tarray = append(array, member)\n461|\t\t\t}\n462|\t\t\tif _, err := decoder.Token(); err != nil {\n463|\t\t\t\treturn nil, mismatchf(\"document syntax\")\n464|\t\t\t}\n465|\t\t\treturn array, nil\n466|\t\tdefault:\n467|\t\t\treturn nil, mismatchf(\"document syntax\")\n468|\t\t}\n469|\t}\n470|\treturn token, nil\n471|}\n472|\n473|// checkExactMembers refuses any deviation from the closed member set: an\n474|// unknown member and a missing member are both malformed.\n475|func checkExactMembers(object map[string]any, members []string) error {\n476|\tif len(object) != len(members) {\n477|\t\treturn mismatchf(\"document members\")\n478|\t}\n479|\tfor _, member := range members {\n480|\t\tif _, known := object[member]; !known {\n481|\t\t\treturn mismatchf(\"document members\")\n482|\t\t}\n483|\t}\n484|\treturn nil\n485|}\n486|\n487|// stringMember extracts a required string member. Numbers, booleans, nulls,\n488|// arrays, and objects are refused: no member of these schemas takes them.\n489|func stringMember(object map[string]any, name string) (string, error) {\n490|\tvalue, ok := object[name].(string)\n491|\tif !ok {\n492|\t\treturn \"\", mismatchf(\"document member type\")\n493|\t}\n494|\treturn value, nil\n495|}\n496|\n497|// boundedStringMember extracts a required string[1..256] measured in UTF-8\n498|// characters over valid UTF-8 (SPEC.md:321), the canonical bound in every\n499|// containing contract.\n500|func boundedStringMember(object map[string]any, name string) (string, error) {\n501|\tvalue, err := stringMember(object, name)\n502|\tif err != nil {\n503|\t\treturn \"\", err\n504|\t}\n505|\tif !utf8.ValidString(value) || utf8.RuneCountInString(value) < 1 || utf8.RuneCountInString(value) > maxOpaqueString {\n506|\t\treturn \"\", mismatchf(\"document string bound\")\n507|\t}\n508|\treturn value, nil\n509|}\n510|\n511|// digestMember extracts a required sha256: digest member.\n512|func digestMember(object map[string]any, name string) (string, error) {\n513|\tvalue, err := stringMember(object, name)\n514|\tif err != nil {\n515|\t\treturn \"\", err\n516|\t}\n517|\tif _, err := scalar.ParseDigest(value); err != nil {\n518|\t\treturn \"\", mismatchf(\"document digest\")\n519|\t}\n520|\treturn value, nil\n521|}\n522|\n523|// digestOrNullMember extracts a digest|null member: present and either a\n524|// valid digest or JSON null. Absence is malformed, not null.\n525|func digestOrNullMember(object map[string]any, name string) (string, error) {\n526|\traw, known := object[name]\n527|\tif !known {\n528|\t\treturn \"\", mismatchf(\"document members\")\n529|\t}\n530|\tif raw == nil {\n531|\t\treturn \"\", nil\n532|\t}\n533|\tvalue, ok := raw.(string)\n534|\tif !ok {\n535|\t\treturn \"\", mismatchf(\"document member type\")\n536|\t}\n537|\tif _, err := scalar.ParseDigest(value); err != nil {\n538|\t\treturn \"\", mismatchf(\"document digest\")\n539|\t}\n540|\treturn value, nil\n541|}\n542|\n543|// semverMember extracts a required semver member.\n544|func semverMember(object map[string]any, name string) (string, error) {\n545|\tvalue, err := stringMember(object, name)\n546|\tif err != nil {\n547|\t\treturn \"\", err\n548|\t}\n549|\tif !semverPattern.MatchString(value) {\n550|\t\treturn \"\", mismatchf(\"document semver\")\n551|\t}\n552|\treturn value, nil\n553|}\n554|\n555|// timestampMember extracts a required timestamp member.\n556|func timestampMember(object map[string]any, name string) (scalar.Timestamp, error) {\n557|\tvalue, err := stringMember(object, name)\n558|\tif err != nil {\n559|\t\treturn scalar.Timestamp{}, err\n560|\t}\n561|\tparsed, err := scalar.ParseTimestamp(value)\n562|\tif err != nil {\n563|\t\treturn scalar.Timestamp{}, mismatchf(\"document timestamp\")\n564|\t}\n565|\treturn parsed, nil\n566|}\n567|\n568|// checkExtensions admits exactly the empty object {}. A non-empty extensions\n569|// object requires a later contract version, and absence is malformed.\n570|func checkExtensions(object map[string]any) error {\n571|\traw, known := object[\"extensions\"]\n572|\tif !known {\n573|\t\treturn mismatchf(\"document members\")\n574|\t}\n575|\textensions, ok := raw.(map[string]any)\n576|\tif !ok || len(extensions) != 0 {\n577|\t\treturn mismatchf(\"document extensions\")\n578|\t}\n579|\treturn nil\n580|}\n581|\n582|// stringArrayMember extracts a required array of strings, refusing numbers,\n583|// booleans, nulls, and nested values element-wise.\n584|func stringArrayMember(object map[string]any, name string) ([]string, error) {\n585|\traw, known := object[name]\n586|\tif !known {\n587|\t\treturn nil, mismatchf(\"document members\")\n588|\t}\n589|\tarray, ok := raw.([]any)\n590|\tif !ok {\n591|\t\treturn nil, mismatchf(\"document member type\")\n592|\t}\n593|\tvalues := make([]string, 0, len(array))\n594|\tfor _, member := range array {\n595|\t\tvalue, ok := member.(string)\n596|\t\tif !ok {\n597|\t\t\treturn nil, mismatchf(\"document member type\")\n598|\t\t}\n599|\t\tvalues = append(values, value)\n(more lines below)","final_result":true}}}
