internal/sessrepo/lease_store.go-185-func CompareLeaseTuple(a, b LeaseSummary) int {\\ninternal/sessrepo/lease_store.go-186-\\tif a.Epoch != b.Epoch {\\ninternal/sessrepo/lease_store.go-187-\\t\\tif a.Epoch < b.Epoch {\\ninternal/sessrepo/lease_store.go-188-\\t\\t\\treturn -1\\ninternal/sessrepo/lease_store.go-189-\\t\\t}\\ninternal/sessrepo/lease_store.go-190-\\t\\treturn 1\\n====\\ninternal/sessrepo/lease_store.go:476:func CheckFencingExpiry(grant FencingGrant, policy FencingPolicy, now time.Time) error {\\ninternal/sessrepo/lease_store.go-477-\\tif policy.RefreshInterval <= 0 {\\ninternal/sessrepo/lease_store.go-478-\\t\\treturn refuse(ErrInvalidLease, \\\"fencing policy refresh interval must be positive\\\")\\ninternal/sessrepo/lease_store.go-479-\\t}\\ninternal/sessrepo/lease_store.go-480-\\tif now.Sub(grant.ValidatedAt) > policy.RefreshInterval {\\ninternal/sessrepo/lease_store.go-481-\\t\\treturn refuse(ErrFencingExpired, \\\"fencing grant for session %s lapsed; revalidate the fencing token\\\", grant.SessionID)\\ninternal/sessrepo/lease_store.go-482-\\t}\\ninternal/sessrepo/lease_store.go-483-\\treturn nil\\ninternal/sessrepo/lease_store.go-484-}\\ninternal/sessrepo/lease_store.go-485-\\ninternal/sessrepo/lease_store.go-486-// loadLeasesLocked reads every stored lease for one session directory in\\ninternal/sessrepo/lease_store.go-487-// tuple order. The blobs are truth: there is no lease index to skew, so a\\ninternal/sessrepo/lease_store.go-488-// crash can only leave a blob stored or not. Staged temps are ignored; any\\ninternal/sessrepo/lease_store.go-489-// other entry that fails to read, decode, attest, bind to the session, or\\ninternal/sessrepo/lease_store.go-490-// agree with its digest name is torn store, refused through the one funnel\\ninternal/sessrepo/lease_store.go-491-// site with the cause carried in the message. Callers hold the mutex.\\ninternal/sessrepo/lease_store.go-492-func (repository *Repository) loadLeasesLocked(directory, sessionID string) ([]LeaseSummary, error) {\\ninternal/sessrepo/lease_store.go-493-\\tstored, err := scanLeaseBlobs(directory, sessionID)\\ninternal/sessrepo/lease_store.go-494-\\tif err != nil {\\ninternal/sessrepo/lease_store.go-495-\\t\\treturn nil, refuse(ErrChainCorrupt, \\\"stored leases for session %s: %v\\\", sessionID, err)\\ninternal/sessrepo/lease_store.go-496-\\t}\\ninternal/sessrepo/lease_store.go-497-\\treturn stored, nil\\ninternal/sessrepo/lease_store.go-498-}\\ninternal/sessrepo/lease_store.go-499-\\ninternal/sessrepo/lease_store.go-500-// scanLeaseBlobs collects and orders the verified lease summaries. Every\\ninternal/sessrepo/lease_store.go-501-// failure is a plain error; loadLeasesLocked attributes it through its one\\ninternal/sessrepo/lease_store.go-502-// refusal site.\\ninternal/sessrepo/lease_store.go-503-func scanLeaseBlobs(directory, sessionID string) ([]LeaseSummary, error) {\\ninternal/sessrepo/lease_store.go-504-\\tentries, err := os.ReadDir(filepath.Join(directory, \\\"leases\\\"))\\ninternal/sessrepo/lease_store.go-505-\\tif err != nil {\\ninternal/sessrepo/lease_store.go-506-\\t\\tif os.IsNotExist(err) {\\n\",\n  \"original_output_bytes\": 3852,\n  \"original_output_tokens\": 963,\n  \"truncated\": false\n}","final_result":true}}}
