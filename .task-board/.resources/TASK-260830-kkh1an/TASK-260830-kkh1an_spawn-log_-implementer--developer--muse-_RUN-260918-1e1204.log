nt\",\n362|        path=f\"{PACKAGE}/decide.go\",\n363|        find=\"\\tif err := terminalbackend.CheckEntrypoint(input.Entrypoint, input.SessionID); err != nil {\\n\",\n364|        replace=\"\\tif err := terminalbackend.CheckEntrypoint(input.Entrypoint, input.SessionID); err != nil && len(input.Entrypoint) != 2 {\\n\",\n365|        count=1,\n366|        run=\"TestDecideTable/refused_entrypoint_raw_provider\",\n367|        expect=\"KILLED\",\n368|        note=\"Admits exactly two-element argv; other arities still refuse.\",\n369|    ),\n370|    Mutant(\n371|        name=\"N-descriptor\",\n372|        path=f\"{PACKAGE}/decide.go\",\n373|        find=\"\"\"\\tdescriptor, err := terminalbackend.AdmitProviderDescriptor(input.Descriptor, input.HostBinding)\n374|\\tif err != nil {\n375|\\t\\treturn refused(backendClass(err), \"provider descriptor does not match the validated binding\", err)\n376|\\t}\n377|\"\"\",\n378|        replace=\"\"\"\\tdescriptor, err := terminalbackend.AdmitProviderDescriptor(input.Descriptor, input.HostBinding)\n379|\\tif err != nil && input.Mode != ModeLaunch {\n380|\\t\\treturn refused(backendClass(err), \"provider descriptor does not match the validated binding\", err)\n381|\\t}\n382|\"\"\",\n383|        count=1,\n384|        run=\"TestDecideTable/refused_descriptor_generation_drift\",\n385|        expect=\"KILLED\",\n386|        note=\"Admits exactly launch-mode descriptor mismatch; restore-mode still refuses.\",\n387|    ),\n388|    Mutant(\n389|        name=\"N-attach\",\n390|        path=f\"{PACKAGE}/decide.go\",\n391|        find='\\tif terminalbackend.CheckOperation(\"attach\", admitted) == nil {\\n',\n392|        replace=\"\\tif true {\\n\",\n393|        count=1,\n394|        run=\"TestDecideTable/takeover_offer_attach_unproven\",\n395|        expect=\"KILLED\",\n396|        note=\"Admits remote attach without the capability; attach-proven still offers attach.\",\n397|    ),\n398|    Mutant(\n399|        name=\"N-reattach\",\n400|        path=f\"{PACKAGE}/decide.go\",\n401|        find=\"\"\"\\tif input.ExistingBinding != nil && input.ExistingBinding.OperationID == input.BootstrapOperationID {\n402|\\t\\tdecision.Action = ActionReattach\n403|\"\"\",\n404|        replace=\"\"\"\\tif input.ExistingBinding != nil && input.ExistingBinding.OperationID == input.BootstrapOperationID && input.Mode == ModeRestore {\n405|\\t\\tdecision.Action = ActionReattach\n406|\"\"\",\n407|        count=1,\n408|        run=\"TestDecideTable/reattach_same_pair\",\n409|        expect=\"KILLED\",\n410|        note=\"Selects launch instead of reattach exactly on launch mode.\",\n411|    ),\n412|    Mutant(\n413|        name=\"N-binding-prefix\",\n414|        path=f\"{PACKAGE}/binding.go\",\n415|        find=\"\\t\\t\\tif winner.OperationID != operationID {\\n\",\n416|        replace=\"\\t\\t\\tif winner.OperationID[:8] != operationID[:8] {\\n\",\n417|        count=1,\n418|        run=\"TestBindConcurrentChangedOperationRefuses\",\n419|        expect=\"KILLED\",\n420|        note=\"Admits exactly same-prefix changed operations; full comparison otherwise stays.\",\n421|    ),\n422|    Mutant(\n423|        name=\"N-binding-session\",\n424|        path=f\"{PACKAGE}/binding.go\",\n425|        find='\\tif binding.SessionID != sessionID {\\n\\t\\treturn empty, false, errors.New(\"bootstrap binding names another session\")\\n\\t}\\n',\n426|        replace='\\tif binding.SessionID[:8] != sessionID[:8] {\\n\\t\\treturn empty, false, errors.New(\"bootstrap binding names another session\")\\n\\t}\\n',\n427|        count=1,\n428|        run=\"TestStatusSessionMismatchRefuses\",\n429|        expect=\"KILLED\",\n430|        note=\"Admits exactly same-prefix foreign sessions; full comparison otherwise stays.\",\n431|    ),\n432|    Mutant(\n433|        name=\"N-bind-first\",\n434|        path=f\"{PACKAGE}/binding.go\",\n435|        find=\"\\t\\tif existing.OperationID != operationID {\\n\",\n436|        replace='\\t\\tif existing.OperationID != operationID && operationID != \"0198f4c8-7d40-7e55-8e6f-1234567890ac\" {\\n',\n437|        count=1,\n438|        run=\"TestBindChangedOperationRefusesMismatch\",\n439|        expect=\"KILLED\",\n440|        note=\"Admits exactly the changed test operation past the anchor pre-check; other changed operations still refuse.\",\n441|    ),\n442|    Mutant(\n443|        name=\"N-supersede-no-replace\",\n444|        path=f\"{PACKAGE}/binding.go\",\n445|        find=\"\"\"\\t\\t\\twinner, found, readErr := store.Lookup(sessionID, operationID)\n446|\\t\\t\\tif readErr != nil {\n447|\\t\\t\\t\\treturn empty, false, readErr\n448|\\t\\t\\t}\n449|\\t\\t\\tif !found {\n450|\\t\\t\\t\\treturn empty, false, errors.New(\"bootstrap pair receipt vanished after concurrent commit\")\n451|\\t\\t\\t}\n452|\\t\\t\\treturn winner, true, nil\n453|\"\"\",\n454|        replace=\"\"\"\\t\\t\\twinner, found, readErr := store.Lookup(sessionID, operationID)\n455|\\t\\t\\tif readErr != nil {\n456|\\t\\t\\t\\treturn empty, false, readErr\n457|\\t\\t\\t}\n458|\\t\\t\\tif !found {\n459|\\t\\t\\t\\treturn empty, false, errors.New(\"bootstrap pair receipt vanished after concurrent commit\")\n460|\\t\\t\\t}\n461|\\t\\t\\tif operationID == \"0198f4c8-7d40-7e55-8e6f-1234567890ac\" {\n462|\\t\\t\\t\\t_ = os.Remove(target)\n463|\\t\\t\\t\\tif err := os.Link(stagedPath, target); err != nil {\n464|\\t\\t\\t\\t\\treturn empty, false, err\n465|\\t\\t\\t\\t}\n466|\\t\\t\\t\\tdecoded, decodeErr := decodeBinding(receipt)\n467|\\t\\t\\t\\treturn decoded, false, decodeErr\n468|\\t\\t\\t}\n469|\\t\\t\\treturn winner, true, nil\n470|\"\"\",\n471|        count=1,\n472|        run=\"TestSupersedeConcurrentSamePairReplays\",\n473|        expect=\"KILLED\",\n474|        note=\"Replaces exactly the test pair receipt on the commit race; other pairs still replay the winner.\",\n475|    ),\n476|    Mutant(\n477|        name=\"N-parked-reason\",\n478|        path=f\"{PACKAGE}/events.go\",\n479|        find='\\tdefault:\\n\\t\\treturn nil, fmt.Errorf(\"parked reason %q is not the session.parked vocabulary\", string(reason))\\n\\t}\\n',\n480|        replace='\\tdefault:\\n\\t\\tif len(reason) != 5 {\\n\\t\\t\\treturn nil, fmt.Errorf(\"parked reason %q is not the session.parked vocabulary\", string(reason))\\n\\t\\t}\\n\\t}\\n',\n481|        count=1,\n482|        run=\"TestParkedPayloadVocabulary\",\n483|        expect=\"KILLED\",\n484|        note=\"Admits exactly five-letter reasons; the vocabulary check otherwise stays.\",\n485|    ),\n486|    Mutant(\n487|        name=\"N-checkpoint-newest\",\n488|        path=f\"{PACKAGE}/decide.go\",\n489|        find=\"\\tif want != input.NewestCheckpointID {\\n\",\n490|        replace=\"\\tif want != input.NewestCheckpointID && input.Mode == ModeLaunch {\\n\",\n491|        count=1,\n492|        run=\"TestDecideCheckpointNotLeaseParks\",\n493|        expect=\"KILLED\",\n494|        note=\"Admits exactly restore-mode non-newest checkpoints; launch-mode still parks.\",\n495|    ),\n496|    Mutant(\n497|        name=\"N-checkpoint-session\",\n498|        path=f\"{PACKAGE}/decide.go\",\n499|        find=\"\\tif sessionID != input.SessionID {\\n\",\n500|        replace='\\tif sessionID != input.SessionID && sessionID != \"0198f4c8-3e70-7a11-8a2b-1234567890ff\" {\\n',\n(more lines below)","final_result":true}}}
