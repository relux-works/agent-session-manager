()\n352|\tif err != nil {\n353|\t\treturn errExtensionShape\n354|\t}\n355|\tswitch typed := token.(type) {\n356|\tcase json.Delim:\n357|\t\tswitch typed {\n358|\t\tcase '{':\n359|\t\t\treturn checkExtensionMembers(decoder, depth)\n360|\t\tcase '[':\n361|\t\t\tif depth >= maxExtensionDepth {\n362|\t\t\t\treturn errExtensionShape\n363|\t\t\t}\n364|\t\t\tfor decoder.More() {\n365|\t\t\t\tif err := checkExtensionValue(decoder, depth+1); err != nil {\n366|\t\t\t\t\treturn err\n367|\t\t\t\t}\n368|\t\t\t}\n369|\t\t\tend, err := decoder.Token()\n370|\t\t\tif err != nil || end != json.Delim(']') {\n371|\t\t\t\treturn errExtensionShape\n372|\t\t\t}\n373|\t\t\treturn nil\n374|\t\tdefault:\n375|\t\t\treturn errExtensionShape\n376|\t\t}\n377|\tcase json.Number:\n378|\t\tif !checkAXNumberLiteral(typed.String()) {\n379|\t\t\treturn errExtensionNumber\n380|\t\t}\n381|\t\treturn nil\n382|\tcase string, bool, nil:\n383|\t\treturn nil\n384|\tdefault:\n385|\t\treturn errExtensionShape\n386|\t}\n387|}\n388|\n389|// checkAXNumberLiteral mirrors the canonicaljson safe-integer rule:\n390|// a literal with a fraction or exponent is forbidden, and the\n391|// integer value must fall in [-2^53+1, 2^53-1]. The bound is checked\n392|// on the literal before any host conversion, so a value the host\n393|// would round is refused instead.\n394|func checkAXNumberLiteral(literal string) bool {\n395|\tif strings.ContainsAny(literal, \".eE\") {\n396|\t\treturn false\n397|\t}\n398|\tinteger, err := strconv.ParseInt(literal, 10, 64)\n399|\tif err != nil || integer < -maxSafeInteger || integer > maxSafeInteger {\n400|\t\treturn false\n401|\t}\n402|\treturn true\n403|}\n404|\n405|// canonicalizeObject renders one closed object deterministically: the\n406|// members marshal in any order and the JCS transform sorts them, so\n407|// identical logical inputs always produce identical bytes.\n408|func canonicalizeObject(object map[string]any) ([]byte, error) {\n409|\tplain, err := json.Marshal(object)\n410|\tif err != nil {\n411|\t\treturn nil, invalid(\"serialize clone bundle object: %v\", err)\n412|\t}\n413|\tcanonical, err := canonicaljson.Canonicalize(plain)\n414|\tif err != nil {\n415|\t\treturn nil, invalid(\"canonicalize clone bundle object: %v\", err)\n416|\t}\n417|\treturn canonical, nil\n418|}\n419|\n420|// omitSelfDigest computes the JCS SHA-256 identity of members with\n421|// only the self field omitted. It mirrors the canonicaljson\n422|// omit-self construction without routing through that package's\n423|// closed-shape registry, which refuses these schemas by design (see\n424|// doc.go).\n425|func omitSelfDigest(members map[string]json.RawMessage, selfField string) (scalar.Digest, error) {\n426|\tomitted := make(map[string]any, len(members))\n427|\tfor name, raw := range members {\n428|\t\tif name == selfField {\n429|\t\t\tcontinue\n430|\t\t}\n431|\t\tvar value any\n432|\t\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n433|\t\tdecoder.UseNumber()\n434|\t\tif err := decoder.Decode(&value); err != nil {\n435|\t\t\treturn scalar.Digest{}, invalid(\"identity input member %s is not JSON: %v\", name, err)\n436|\t\t}\n437|\t\tomitted[name] = value\n438|\t}\n439|\tplain, err := json.Marshal(omitted)\n440|\tif err != nil {\n441|\t\treturn scalar.Digest{}, invalid(\"serialize omit-self object: %v\", err)\n442|\t}\n443|\tcanonical, err := canonicaljson.Canonicalize(plain)\n444|\tif err != nil {\n445|\t\treturn scalar.Digest{}, invalid(\"canonicalize omit-self object: %v\", err)\n446|\t}\n447|\treturn scalar.SHA256Digest(canonical), nil\n448|}\n449|\n450|// verifySelfDigest recomputes the omit-self identity and refuses a\n451|// mismatch against the claimed self digest.\n452|func verifySelfDigest(members map[string]json.RawMessage, selfField string, claimed scalar.Digest) error {\n453|\tcalculated, err := omitSelfDigest(members, selfField)\n454|\tif err != nil {\n455|\t\treturn err\n456|\t}\n457|\tif calculated != claimed {\n458|\t\treturn invalid(\"%s claim %q does not match omit-self digest %q\", selfField, claimed.String(), calculated.String())\n459|\t}\n460|\treturn nil\n461|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
