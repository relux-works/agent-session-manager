{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c89f","stream":{"kind":"session","id":"01a0ceca-cad7-7401-b120-5d187a59f4b1"},"sequence":682,"recorded_at":1780531400001359,"record_type":"event","durability":"durable","causation_id":"f679b6f1-9902-47f8-8dc1-d6bbf0923c83","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f679b6f1-9902-47f8-8dc1-d6bbf0923c83","run_stream":{"kind":"run","id":"f679b6f1-9902-47f8-8dc1-d6bbf0923c83"},"call_id":"call_01a0cecd90ca75dba3caa28ee765e30d","text":"Read text file `internal/clonebundle/capturebuild.go`.\n(79 line(s) above)\n80|\tExtensions          map[string]any\n81|}\n82|\n83|// BuildCaptureManifest constructs one closed Clone Capture Manifest\n84|// as canonical bytes. Identical inputs produce byte-identical\n85|// outputs. raw_complete is derived, never accepted: it is true only\n86|// after complete plan/object reconciliation with no unknown class.\n87|func BuildCaptureManifest(input CaptureManifestInput) ([]byte, error) {\n88|\t_, object, err := buildCaptureManifest(input)\n89|\tif err != nil {\n90|\t\treturn nil, err\n91|\t}\n92|\tomitted, err := canonicalizeObject(object)\n93|\tif err != nil {\n94|\t\treturn nil, err\n95|\t}\n96|\tmanifestID := scalar.SHA256Digest(omitted)\n97|\tobject[captureManifestSelf] = manifestID.String()\n98|\treturn canonicalizeObject(object)\n99|}\n100|\n101|func buildCaptureManifest(input CaptureManifestInput) (CaptureManifest, map[string]any, error) {\n102|\toperation, err := scalar.ParseUUIDv7(input.OperationID)\n103|\tif err != nil {\n104|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest operation_id is not a UUIDv7: %v\", err)\n105|\t}\n106|\tbundle, err := scalar.ParseUUIDv7(input.BundleID)\n107|\tif err != nil {\n108|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest bundle_id is not a UUIDv7: %v\", err)\n109|\t}\n110|\tbasis, basisObject, err := buildSourceBasis(input.SourceBasis)\n111|\tif err != nil {\n112|\t\treturn CaptureManifest{}, nil, err\n113|\t}\n114|\ttuple, err := sessadapter.DecodeTuple(json.RawMessage(input.SourceEnvironment))\n115|\tif err != nil {\n116|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest source_environment is not an Environment Tuple: %v\", err)\n117|\t}\n118|\tidentityBytes, err := EncodeNativeIdentity(input.SourceIdentity, input.IdentityExtensions)\n119|\tif err != nil {\n120|\t\treturn CaptureManifest{}, nil, err\n121|\t}\n122|\tif _, err := DecodeNativeIdentity(json.RawMessage(identityBytes)); err != nil {\n123|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest source_identity is not a NativeIdentity: %v\", err)\n124|\t}\n125|\tplanDigest, err := scalar.ParseDigest(input.CapturePlanDigest)\n126|\tif err != nil {\n127|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest capture_plan_digest is not a digest: %v\", err)\n128|\t}\n129|\tboundary, boundaryObject, err := buildBoundary(input.Boundary)\n130|\tif err != nil {\n131|\t\treturn CaptureManifest{}, nil, err\n132|\t}\n133|\trawManifestID, err := scalar.ParseDigest(input.SourceRawManifestID)\n134|\tif err != nil {\n135|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest source_raw_object_manifest_id is not a digest: %v\", err)\n136|\t}\n137|\tif len(input.Items) > 65536 {\n138|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest carries %d items, maximum is 65536\", len(input.Items))\n139|\t}\n140|\titems := make([]CaptureItem, 0, len(input.Items))\n141|\tprevious := \"\"\n142|\tfor index, candidate := range input.Items {\n143|\t\titem, err := buildCaptureItem(candidate, index)\n144|\t\tif err != nil {\n145|\t\t\treturn CaptureManifest{}, nil, err\n146|\t\t}\n147|\t\tif index > 0 && item.NativeItemKey <= previous {\n148|\t\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest items are not sorted bytewise by native item key\")\n149|\t\t}\n150|\t\tprevious = item.NativeItemKey\n151|\t\titems = append(items, item)\n152|\t}\n153|\tif err := checkPlanItemMatch(items, input.PlanKeys); err != nil {\n154|\t\treturn CaptureManifest{}, nil, err\n155|\t}\n156|\texcluded := excludedRowClasses(items)\n157|\trawComplete := deriveRawComplete(items, input.PlanKeys, input.RawKeys)\n158|\thostID, err := scalar.ParseUUIDv7(input.CreatedByHostID)\n159|\tif err != nil {\n160|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest created_by_host_id is not a UUIDv7: %v\", err)\n161|\t}\n162|\tcreatedAt, err := scalar.ParseTimestamp(input.CreatedAt)\n163|\tif err != nil {\n164|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest created_at is not a timestamp: %v\", err)\n165|\t}\n166|\tif _, err := encodeExtensions(input.Extensions); err != nil {\n167|\t\treturn CaptureManifest{}, nil, err\n168|\t}\n169|\tvar identityValue any\n170|\tif err := json.Unmarshal(identityBytes, &identityValue); err != nil {\n171|\t\treturn CaptureManifest{}, nil, invalid(\"capture manifest source_identity is not JSON: %v\", err)\n172|\t}\n173|\tobjects := make([]any, 0, len(items))\n174|\tfor _, item := range items {\n175|\t\tobjects = append(objects, captureItemObject(item))\n176|\t}\n177|\texcludedValue := make([]any, 0, len(excluded))\n178|\tfor _, class := range excluded {\n179|\t\texcludedValue = append(excludedValue, class)\n180|\t}\n181|\tmanifest := CaptureManifest{\n182|\t\tOperationID:             operation,\n183|\t\tBundleID:                bundle,\n184|\t\tSourceBasis:             basis,\n185|\t\tSourceEnvironment:       tuple,\n186|\t\tSourceIdentity:          input.SourceIdentity,\n187|\t\tCapturePlanDigest:       planDigest,\n188|\t\tCaptureBoundary:         boundary,\n189|\t\tSourceRawObjectManifest: rawManifestID,\n190|\t\tItems:                   items,\n191|\t\tExcludedClasses:         excluded,\n192|\t\tRawComplete:             rawComplete,\n193|\t\tCreatedByHostID:         hostID,\n194|\t\tCreatedAt:               createdAt,\n195|\t}\n196|\tobject := map[string]any{\n197|\t\t\"schema\":                        captureManifestSchema,\n198|\t\t\"schema_version\":                captureManifestVersion,\n199|\t\t\"operation_id\":                  operation.String(),\n200|\t\t\"bundle_id\":                     bundle.String(),\n201|\t\t\"source_basis\":                  basisObject,\n202|\t\t\"source_environment\":            tupleObject(tuple),\n203|\t\t\"source_identity\":               identityValue,\n204|\t\t\"capture_plan_digest\":           planDigest.String(),\n205|\t\t\"capture_boundary\":              boundaryObject,\n206|\t\t\"source_raw_object_manifest_id\": rawManifestID.String(),\n207|\t\t\"items\":                         objects,\n208|\t\t\"excluded_classes\":              excludedValue,\n209|\t\t\"raw_complete\":                  rawComplete,\n210|\t\t\"created_by_host_id\":            hostID.String(),\n211|\t\t\"created_at\":                    createdAt.String(),\n212|\t\t\"extensions\":                    extensionValue(input.Extensions),\n213|\t}\n214|\treturn manifest, object, nil\n215|}\n216|\n217|// DecodeCaptureManifest validates one closed Clone Capture Manifest:\n218|// exact members, schema/version, self-digest agreement, sorted\n219|// items, exact excluded classes, and the unknown-makes-incomplete\n220|// rule. Full plan/object reconciliation needs the plan and raw key\n221|// sets; VerifyCaptureReconciliation performs it.\n222|func DecodeCaptureManifest(data []byte) (CaptureManifest, error) {\n223|\tmembers, fault := decodeStrictObject(data)\n224|\tif fault != nil {\n225|\t\treturn CaptureManifest{}, invalid(\"capture manifest %s (%s)\", fault.detail, memberField(fault.member))\n226|\t}\n227|\tif name, unknown := unknownMember(members, captureManifestMembers); unknown {\n228|\t\treturn CaptureManifest{}, invalid(\"capture manifest carries unknown member %q\", name)\n229|\t}\n230|\tif name, missing := missingMember(members, captureManifestRequired); missing {\n231|\t\treturn CaptureManifest{}, invalid(\"capture manifest misses a required member %q\", name)\n232|\t}\n233|\tschema, ok := rawString(members[\"schema\"])\n234|\tif !ok || schema != captureManifestSchema {\n235|\t\treturn CaptureManifest{}, invalid(\"capture manifest schema is not the clone capture manifest\")\n236|\t}\n237|\tversion, ok := rawString(members[\"schema_version\"])\n238|\tif !ok || version != captureManifestVersion {\n239|\t\treturn CaptureManifest{}, invalid(\"capture manifest version is not 1.0.0\")\n240|\t}\n241|\tmanifestID, ok := checkDigest(members[captureManifestSelf])\n242|\tif !ok {\n243|\t\treturn CaptureManifest{}, invalid(\"capture manifest capture_manifest_id is not a digest\")\n244|\t}\n245|\toperation, ok := checkUUIDv7(members[\"operation_id\"])\n246|\tif !ok {\n247|\t\treturn CaptureManifest{}, invalid(\"capture manifest operation_id is not a UUIDv7\")\n248|\t}\n249|\tbundle, ok := checkUUIDv7(members[\"bundle_id\"])\n250|\tif !ok {\n251|\t\treturn CaptureManifest{}, invalid(\"capture manifest bundle_id is not a UUIDv7\")\n252|\t}\n253|\tbasis, err := DecodeSourceBasis(members[\"source_basis\"])\n254|\tif err != nil {\n255|\t\treturn CaptureManifest{}, err\n256|\t}\n257|\ttuple, err := sessadapter.DecodeTuple(members[\"source_environment\"])\n258|\tif err != nil {\n259|\t\treturn CaptureManifest{}, invalid(\"capture manifest source_environment is not an Environment Tuple: %v\", err)\n260|\t}\n261|\tidentity, err := DecodeNativeIdentity(members[\"source_identity\"])\n262|\tif err != nil {\n263|\t\treturn CaptureManifest{}, err\n264|\t}\n265|\tplanDigest, ok := checkDigest(members[\"capture_plan_digest\"])\n266|\tif !ok {\n267|\t\treturn CaptureManifest{}, invalid(\"capture manifest capture_plan_digest is not a digest\")\n268|\t}\n269|\tboundary, err := DecodeCaptureBoundary(members[\"capture_boundary\"])\n270|\tif err != nil {\n271|\t\treturn CaptureManifest{}, err\n272|\t}\n273|\trawManifestID, ok := checkDigest(members[\"source_raw_object_manifest_id\"])\n274|\tif !ok {\n275|\t\treturn CaptureManifest{}, invalid(\"capture manifest source_raw_object_manifest_id is not a digest\")\n276|\t}\n277|\titems, err := decodeCaptureItems(members[\"items\"])\n278|\tif err != nil {\n279|\t\treturn CaptureManifest{}, err\n280|\t}\n281|\texcluded, ok := checkSortedUniqueStrings(members[\"excluded_classes\"], 1, 128, 0, 9)\n282|\tif !ok {\n283|\t\treturn CaptureManifest{}, invalid(\"capture manifest excluded_classes are not sorted unique string[1..128][0..9]\")\n284|\t}\n285|\tfor _, class := range excluded {\n286|\t\tif !ValidCaptureClass(class) {\n287|\t\t\treturn CaptureManifest{}, invalid(\"capture manifest excluded_classes carry unknown class %q\", class)\n288|\t\t}\n289|\t}\n290|\tif !excludedClassesExact(items, excluded) {\n291|\t\treturn CaptureManifest{}, invalid(\"capture manifest excluded_classes are not exactly the excluded-row classes\")\n292|\t}\n293|\trawComplete, ok := rawBool(members[\"raw_complete\"])\n294|\tif !ok {\n295|\t\treturn CaptureManifest{}, invalid(\"capture manifest raw_complete is not a boolean\")\n296|\t}\n297|\tif rawComplete && hasUnknownClass(items) {\n298|\t\treturn CaptureManifest{}, invalid(\"capture manifest raw_complete is true with an unknown-class item\")\n299|\t}\n300|\thostID, ok := checkUUIDv7(members[\"created_by_host_id\"])\n301|\tif !ok {\n302|\t\treturn CaptureManifest{}, invalid(\"capture manifest created_by_host_id is not a UUIDv7\")\n303|\t}\n304|\tcreatedAt, ok := checkTimestamp(members[\"created_at\"])\n305|\tif !ok {\n306|\t\treturn CaptureManifest{}, invalid(\"capture manifest created_at is not a timestamp\")\n307|\t}\n308|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n309|\t\treturn CaptureManifest{}, invalid(\"capture manifest extensions %s\", extensionsFault)\n310|\t}\n311|\tif err := verifySelfDigest(members, captureManifestSelf, manifestID); err != nil {\n312|\t\treturn CaptureManifest{}, err\n313|\t}\n314|\treturn CaptureManifest{\n315|\t\tManifestID:              manifestID,\n316|\t\tOperationID:             operation,\n317|\t\tBundleID:                bundle,\n318|\t\tSourceBasis:             basis,\n319|\t\tSourceEnvironment:       tuple,\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
