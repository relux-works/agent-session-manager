{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c629","stream":{"kind":"session","id":"01a0ceca-cad7-7401-b120-5d187a59f4b1"},"sequence":367,"recorded_at":1780531400000729,"record_type":"event","durability":"durable","causation_id":"f679b6f1-9902-47f8-8dc1-d6bbf0923c83","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f679b6f1-9902-47f8-8dc1-d6bbf0923c83","run_stream":{"kind":"run","id":"f679b6f1-9902-47f8-8dc1-d6bbf0923c83"},"call_id":"call_01a0cecb93fc742ab50dd49dc48ca318","text":"Read text file `internal/clonebundle/decode.go`.\n1|package clonebundle\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"reflect\"\n8|\t\"strconv\"\n9|\t\"strings\"\n10|\t\"unicode/utf8\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|)\n16|\n17|// This file holds parse-only helpers for every Section 13.14.1 closed\n18|// shape. Helpers report verdicts; every refusal is constructed at the\n19|// deciding site with a literal detail so each rule stays a distinct\n20|// gate. Strict object decoding and extension admission delegate to the\n21|// landed environ owner; tuple decoding delegates to sessadapter at the\n22|// call site.\n23|\n24|const maxUint53 = uint64(1<<53 - 1)\n25|\n26|// maxSafeInteger is the AX safe-integer magnitude bound: extension\n27|// values must fall in [-maxSafeInteger, maxSafeInteger], mirroring\n28|// the canonicaljson identity guarantee.\n29|const maxSafeInteger = int64(1<<53 - 1)\n30|\n31|type frameFault struct {\n32|\tdetail string\n33|\tmember string\n34|}\n35|\n36|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n37|\tmembers, fault := environ.DecodeStrictObject(data)\n38|\tif fault != nil {\n39|\t\treturn nil, &frameFault{detail: fault.Detail, member: fault.Member}\n40|\t}\n41|\treturn members, nil\n42|}\n43|\n44|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n45|\tfor name := range members {\n46|\t\tif !allowed[name] {\n47|\t\t\treturn name, true\n48|\t\t}\n49|\t}\n50|\treturn \"\", false\n51|}\n52|\n53|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n54|\tfor _, name := range required {\n55|\t\tif _, present := members[name]; !present {\n56|\t\t\treturn name, true\n57|\t\t}\n58|\t}\n59|\treturn \"\", false\n60|}\n61|\n62|func rawString(raw json.RawMessage) (string, bool) {\n63|\tvar value string\n64|\tif err := json.Unmarshal(raw, &value); err != nil {\n65|\t\treturn \"\", false\n66|\t}\n67|\treturn value, true\n68|}\n69|\n70|func rawBool(raw json.RawMessage) (bool, bool) {\n71|\tvar value bool\n72|\tif err := json.Unmarshal(raw, &value); err != nil {\n73|\t\treturn false, false\n74|\t}\n75|\treturn value, true\n76|}\n77|\n78|// checkUint53Bounds reports whether the member is a uint53 in the\n79|// inclusive bound. Both edges are checked: a one-sided check would\n80|// admit the open side. It delegates to the environ gate.\n81|func checkUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n82|\treturn environ.CheckUint53Bounds(raw, minimum, maximum)\n83|}\n84|\n85|// stringLength is the Section 1.6 string measure in characters, not\n86|// bytes: a bound of string[1..512] admits 512 characters of any\n87|// width. It delegates to the single environ measure so the two can\n88|// never drift.\n89|func stringLength(value string) int {\n90|\treturn environ.StringLength(value)\n91|}\n92|\n93|// checkStringBounds reports whether the member is a JSON string whose\n94|// character count falls in the inclusive bound. It delegates to the\n95|// environ gate.\n96|func checkStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n97|\treturn environ.CheckStringBounds(raw, minimum, maximum)\n98|}\n99|\n100|// checkDigest reports whether the member is a digest of the pinned\n101|// sha256 form. It delegates to the environ gate.\n102|func checkDigest(raw json.RawMessage) (scalar.Digest, bool) {\n103|\treturn environ.CheckDigest(raw)\n104|}\n105|\n106|// checkUUIDv7 reports whether the member is a lowercase UUIDv7. It\n107|// delegates to the environ gate.\n108|func checkUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n109|\treturn environ.CheckUUIDv7(raw)\n110|}\n111|\n112|// checkTimestamp reports whether the member is a pinned timestamp.\n113|// It delegates to the environ gate.\n114|func checkTimestamp(raw json.RawMessage) (scalar.Timestamp, bool) {\n115|\treturn environ.CheckTimestamp(raw)\n116|}\n117|\n118|// validText reports whether the value is valid UTF-8 text. Section\n119|// 1.6 requires text to be valid UTF-8, and encoding/json silently\n120|// rewrites invalid bytes to U+FFFD instead of failing — so every\n121|// Build-side string admission runs this gate BEFORE marshaling, and\n122|// refuses what it cannot seal byte-exactly. Without it two distinct\n123|// inputs (e.g. \"native\\xff\" vs \"native\\xfe\") would seal\n124|// byte-identical objects, and a native key would launder past the\n125|// sanitizer's own invalid-UTF-8 refusal. Every refusal is\n126|// constructed at the deciding site with a literal detail.\n127|func validText(value string) bool {\n128|\treturn utf8.ValidString(value)\n129|}\n130|\n131|// validExtensionText reports whether every string under an\n132|// extensions value — keys and string values at any depth, through\n133|// maps, slices, arrays, pointers, interfaces, and exported struct\n134|// fields — is valid UTF-8 text. The build helper runs it before\n135|// marshaling for the same rewrite-and-continue reason as validText:\n136|// a single invalid byte anywhere in the map would otherwise seal as\n137|// U+FFFD. Numbers, booleans, and nulls cross opaquely; values whose\n138|// marshaled form is computed rather than textual (custom\n139|// json.Marshaler implementations) are trusted to render valid text.\n140|func validExtensionText(value any) bool {\n141|\treturn extensionTextValid(reflect.ValueOf(value))\n142|}\n143|\n144|func extensionTextValid(value reflect.Value) bool {\n145|\tif !value.IsValid() {\n146|\t\treturn true\n147|\t}\n148|\tswitch value.Kind() {\n149|\tcase reflect.String:\n150|\t\treturn validText(value.String())\n151|\tcase reflect.Map:\n152|\t\titer := value.MapRange()\n153|\t\tfor iter.Next() {\n154|\t\t\tif !extensionTextValid(iter.Key()) || !extensionTextValid(iter.Value()) {\n155|\t\t\t\treturn false\n156|\t\t\t}\n157|\t\t}\n158|\t\treturn true\n159|\tcase reflect.Slice, reflect.Array:\n160|\t\tfor index := 0; index < value.Len(); index++ {\n161|\t\t\tif !extensionTextValid(value.Index(index)) {\n162|\t\t\t\treturn false\n163|\t\t\t}\n164|\t\t}\n165|\t\treturn true\n166|\tcase reflect.Struct:\n167|\t\town := value.Type()\n168|\t\tfor index := 0; index < value.NumField(); index++ {\n169|\t\t\tif own.Field(index).PkgPath != \"\" {\n170|\t\t\t\tcontinue\n171|\t\t\t}\n172|\t\t\tif !extensionTextValid(value.Field(index)) {\n173|\t\t\t\treturn false\n174|\t\t\t}\n175|\t\t}\n176|\t\treturn true\n177|\tcase reflect.Interface, reflect.Pointer:\n178|\t\tif value.IsNil() {\n179|\t\t\treturn true\n180|\t\t}\n181|\t\treturn extensionTextValid(value.Elem())\n182|\tdefault:\n183|\t\treturn true\n184|\t}\n185|}\n186|\n187|func bytesTrimSpace(raw json.RawMessage) json.RawMessage {\n188|\treturn json.RawMessage(bytes.TrimSpace(raw))\n189|}\n190|\n191|func isNull(raw json.RawMessage) bool {\n192|\ttrimmed := bytes.TrimSpace(raw)\n193|\treturn string(trimmed) == \"null\"\n194|}\n195|\n196|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n197|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n198|\ttoken, err := decoder.Token()\n199|\tif err != nil {\n200|\t\treturn nil, false\n201|\t}\n202|\tdelimiter, ok := token.(json.Delim)\n203|\tif !ok || delimiter != '[' {\n204|\t\treturn nil, false\n205|\t}\n206|\tvar elements []json.RawMessage\n207|\tfor decoder.More() {\n208|\t\tvar element json.RawMessage\n209|\t\tif err := decoder.Decode(&element); err != nil {\n210|\t\t\treturn nil, false\n211|\t\t}\n212|\t\telements = append(elements, element)\n213|\t}\n214|\ttoken, err = decoder.Token()\n215|\tif err != nil {\n216|\t\treturn nil, false\n217|\t}\n218|\tdelimiter, ok = token.(json.Delim)\n219|\tif !ok || delimiter != ']' {\n220|\t\treturn nil, false\n221|\t}\n222|\tif _, err := decoder.Token(); err != io.EOF {\n223|\t\treturn nil, false\n224|\t}\n225|\tif elements == nil {\n226|\t\telements = []json.RawMessage{}\n227|\t}\n228|\treturn elements, true\n229|}\n230|\n231|// checkSortedUniqueStrings reports whether the member is an array of\n232|// strings in the item bound whose JCS encodings order strictly\n233|// increasingly with no duplicates. It delegates to the environ gate.\n234|func checkSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n235|\treturn environ.CheckSortedUniqueStrings(raw, minimumLength, maximumLength, minimumCount, maximumCount)\n236|}\n237|\n238|// checkSortedUniqueDigests reports whether the member is a sorted\n239|// unique digest array in the count bound. It delegates to the\n240|// environ gate.\n241|func checkSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n242|\treturn environ.CheckSortedUniqueDigests(raw, minimumCount, maximumCount)\n243|}\n244|\n245|// checkExtensions reports whether the member is an object whose keys\n246|// are all reverse-DNS names. It delegates to the environ gate. Key\n247|// admission alone is not the closed extensions rule for this\n248|// package: extension values flow into the omit-self identity, so\n249|// every admission site uses checkExtensionsClosed, which additionally\n250|// enforces the AX number model and nested duplicate refusal on the\n251|// values.\n252|func checkExtensions(raw json.RawMessage) bool {\n253|\treturn environ.CheckExtensions(raw)\n254|}\n255|\n256|// maxExtensionDepth mirrors the canonicaljson nesting bound: a\n257|// container nested deeper than this inside an extension value is\n258|// refused, exactly as the identity owner refuses it.\n259|const maxExtensionDepth = 256\n260|\n261|// checkExtensionsClosed enforces the full closed extensions rule:\n262|// reverse-DNS keys (via the environ owner) and values inside the AX\n263|// common logical data model (integer literals only, |n| <= 2^53-1,\n264|// no fraction or exponent, nested objects duplicate-free at every\n265|// depth). It returns nil when the member is closed, otherwise the\n266|// refusal detail naming the failed rule.\n267|func checkExtensionsClosed(raw json.RawMessage) error {\n268|\tif !checkExtensions(raw) {\n269|\t\treturn errExtensionsKeys\n270|\t}\n271|\treturn checkExtensionValues(raw)\n272|}\n273|\n274|var (\n275|\terrExtensionsKeys     = errorString(\"are not reverse-DNS keyed\")\n276|\terrExtensionNumber    = errorString(\"carry a number outside the AX safe-integer model\")\n277|\terrExtensionDuplicate = errorString(\"carry a duplicate nested member\")\n278|\terrExtensionShape     = errorString(\"are not a depth-bounded extension object\")\n279|\terrPayloadShape       = errorString(\"are not a depth-bounded payload object\")\n280|)\n281|\n282|// errorString is one fixed refusal detail. Extension faults name the\n283|// failed rule; the deciding site names the owner.\n284|type errorString string\n285|\n286|func (detail errorString) Error() string { return string(detail) }\n287|\n288|// checkExtensionValues validates every value under the extensions\n289|// object against the AX number model with nested objects\n290|// duplicate-free. It mirrors the canonicaljson identity guarantee\n291|// (safe integers, no rounding, strict objects) which Canonicalize\n292|// alone does not carry, so no value that would round or