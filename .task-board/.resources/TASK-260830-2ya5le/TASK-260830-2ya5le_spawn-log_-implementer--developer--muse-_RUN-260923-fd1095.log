{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5fd","stream":{"kind":"session","id":"01a0ceca-cad7-7401-b120-5d187a59f4b1"},"sequence":345,"recorded_at":1780531400000685,"record_type":"event","durability":"durable","causation_id":"f679b6f1-9902-47f8-8dc1-d6bbf0923c83","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f679b6f1-9902-47f8-8dc1-d6bbf0923c83","run_stream":{"kind":"run","id":"f679b6f1-9902-47f8-8dc1-d6bbf0923c83"},"call_id":"call_01a0cecb80f7768ab510f9368d9008a3","text":"Read text file `internal/canonicaljson/closed_shapes.go`.\n1|package canonicaljson\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\t\"net/url\"\n7|\tpathpkg \"path\"\n8|\t\"regexp\"\n9|\t\"sort\"\n10|\t\"strconv\"\n11|\t\"strings\"\n12|\t\"unicode\"\n13|\t\"unicode/utf8\"\n14|\n15|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n17|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n18|)\n19|\n20|const (\n21|\tblobSchema             = \"urn:ax:schema:blob\"\n22|\ttransferManifestSchema = \"urn:ax:schema:transfer-manifest\"\n23|\tclosedSchemaVersion    = \"1.0.0\"\n24|\tmaxBlobChunks          = 32_768\n25|\tmaxChunkSize           = 4_194_304\n26|)\n27|\n28|var (\n29|\tmediaTypePattern = regexp.MustCompile(\"^[a-z0-9!#$&^_.+%'*`|~-]+/[a-z0-9!#$&^_.+%'*`|~-]+$\")\n30|\t// SemVer 2.0.0 in full. The pinned document types members `semver` without\n31|\t// spelling out a grammar, so the only defensible reading is the named\n32|\t// standard, which admits prerelease and build metadata. A core-triple-only\n33|\t// pattern would refuse `1.2.3-rc.1`, a version the standard declares valid\n34|\t// and the document never excludes.\n35|\tsemverPattern          = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n36|\treverseDNSPattern      = regexp.MustCompile(`^[a-z][a-z0-9-]{0,62}(\\.[a-z][a-z0-9-]{0,62})+$`)\n37|\tenvironmentNamePattern = regexp.MustCompile(`^[A-Za-z_][A-Za-z0-9_]{0,127}$`)\n38|\tenvironmentIDPattern   = regexp.MustCompile(`^[a-z][a-z0-9.-]{0,63}$`)\n39|\tboardLogicalIDPattern  = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$`)\n40|\tsessionNamePattern     = regexp.MustCompile(`^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$`)\n41|)\n42|\n43|// Subsumed UTF-8 re-checks.\n44|//\n45|// Several validators in this file re-check utf8.ValidString on a value they\n46|// received. Every one of those terms is subsumed: decodeStrict in canonical.go\n47|// refuses input that is not valid UTF-8 before it decodes any value, and it is\n48|// the only place in this package where bytes become Go values, so no decoded\n49|// string or object key can reach a validator here invalid.\n50|//\n51|// They are kept fail-closed rather than deleted because the argument is a\n52|// package-internal invariant, not a property of these functions: an exported\n53|// entry point that accepted an already-decoded map, or a second JSON decoder\n54|// anywhere in the package, would make every one of them false again.\n55|//\n56|// Both conditions are machine-checked in utf8_subsumption_test.go, over a call\n57|// graph derived from the AST. That check is bounded, and the bound is part of\n58|// the claim. It models direct calls, calls to methods declared in this package,\n59|// and dispatch through a function value, which is the shape\n60|// immutableObjectShapeValidators below uses. It models nothing about a callee\n61|// reached by reflection, by a function value handed to another package, or\n62|// through a func-typed struct field, and an entry point built one of those ways\n63|// would leave these guards live while the pin stayed green. The pin narrows how\n64|// such a change can arrive unnoticed; it does not make it impossible, which is\n65|// the reason these terms stay rather than being deleted.\n66|\n67|type immutableObjectShapeValidator func(map[string]any) error\n68|\n69|// immutableObjectShapeValidators is deliberately explicit. The self-identity\n70|// catalog selects the self field, but catalog membership alone does not prove\n71|// that this package implements a schema's complete closed shape. Every\n72|// registered schema/version therefore resolves either to a concrete validator\n73|// or to an explicit refusal. validateImmutableObjectShapeValidators binds this\n74|// table back to the generated registry so a newly registered row cannot fall\n75|// through to extension-only attestation.\n76|var immutableObjectShapeValidators = mustBuildImmutableObjectShapeValidators()\n77|\n78|func mustBuildImmutableObjectShapeValidators() map[schemaIdentityKey]immutableObjectShapeValidator {\n79|\tvalidators := make(map[schemaIdentityKey]immutableObjectShapeValidator)\n80|\tregister := func(schema string, validator immutableObjectShapeValidator, versions ...string) {\n81|\t\tfor _, version := range versions {\n82|\t\t\tkey := schemaIdentityKey{schema: schema, version: version}\n83|\t\t\tif _, duplicate := validators[key]; duplicate {\n84|\t\t\t\tpanic(fmt.Sprintf(\"duplicate immutable-object shape validator for %s@%s\", schema, version))\n85|\t\t\t}\n86|\t\t\tvalidators[key] = validator\n87|\t\t}\n88|\t}\n89|\n90|\t// Complete validators owned by the scoped Sections 10.1-10.4 gate.\n91|\tregister(\"urn:ax:schema:session-record\", validateSessionRecordV1, \"1.0.0\")\n92|\tregister(\"urn:ax:schema:session-record\", validateSessionRecordV2, \"2.0.0\")\n93|\tregister(\"urn:ax:schema:session-record\", validateSessionRecordV3, \"3.0.0\")\n94|\tregister(blobSchema, validateBlobDescriptor, closedSchemaVersion)\n95|\tregister(transferManifestSchema, validateTransferManifest, closedSchemaVersion)\n96|\n97|\t// Complete Section 5 and Section 10.1 core-record validators.\n98|\tregister(\"urn:ax:schema:lease\", validateLeaseRecord, \"1.0.0\")\n99|\tregister(\"urn:ax:schema:workspace-group\", validateWorkspaceGroupRecord, \"1.0.0\")\n100|\tregister(\"urn:ax:schema:provider-identity\", validateProviderIdentityRecord, \"1.0.0\")\n101|\tregister(\"urn:ax:schema:session-event\", validateSessionEventV1, \"1.0.0\")\n102|\tregister(\"urn:ax:schema:session-event\", validateSessionEventV2, \"2.0.0\")\n103|\tregister(\"urn:ax:schema:session-event\", validateSessionEventV3, \"3.0.0\")\n104|\tregister(\"urn:ax:schema:session-event\", validateSessionEventV4, \"4.0.0\")\n105|\tregister(\"urn:ax:schema:checkpoint\", validateCheckpointRecord, \"1.0.0\")\n106|\n107|\t// Remaining Section 10.1 records retain their common-envelope gate before\n108|\t// the public identity surface explicitly refuses an unsupported shape.\n109|\tregister(\"urn:ax:schema:tombstone\", validateUnsupportedRecordEnvelopeShape, \"1.0.0\")\n110|\tregister(\"urn:ax:schema:tombstone-ack\", validateUnsupportedRecordEnvelopeShape, \"1.0.0\")\n111|\n112|\t// The remaining registered identities are recognized for self-field\n113|\t// selection but their schema-specific closed shapes are outside this task.\n114|\t// Explicit refusal is safer and more honest than attesting an opaque object.\n115|\tregister(\"urn:ax:schema:canonical-event\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n116|\t// The three terminal closed schemas are owned by internal/terminalbackend:\n117|\t// this package reaches the owner through its production Parse entries\n118|\t// rather than re-implementing the shape, so the two validators for one\n119|\t// schema cannot drift. The owner's refusal is wrapped as an identity\n120|\t// refusal to keep this package's entry-point contract.\n121|\tregister(\"urn:ax:schema:terminal-backend-manifest\", validateTerminalBackendManifest, \"1.0.0\")\n122|\tregister(\"urn:ax:schema:session-clone-bundle\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n123|\tregister(\"urn:ax:schema:materialization-plan\", rejectUnsupportedImmutableObjectShape, \"1.0.0\", \"2.0.0\")\n124|\tregister(\"urn:ax:schema:session-continuation-plan\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n125|\tregister(\"urn:ax:schema:task-board-bundle\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n126|\tregister(\"urn:ax:schema:materialization-journal\", rejectUnsupportedImmutableObjectShape, \"2.0.0\")\n127|\tregister(\"urn:ax:schema:environment-observation\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n128|\tregister(\"urn:ax:schema:native-session-observation\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n129|\tregister(\"urn:ax:schema:session-inventory-batch\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n130|\tregister(\"urn:ax:schema:conversation-lineage-link\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n131|\tregister(\"urn:ax:schema:session-annotation\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n132|\tregister(\"urn:ax:schema:session-enrichment-profile\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n133|\tregister(\"urn:ax:schema:session-enrichment-job-request\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n134|\tregister(\"urn:ax:schema:session-enrichment-job-receipt\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n135|\tregister(\"urn:ax:schema:session-directory-operation-receipt\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n136|\tregister(\"urn:ax:schema:terminal-backend-probe\", validateTerminalBackendProbe, \"1.0.0\")\n137|\tregister(\"urn:ax:schema:terminal-instance-binding\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n138|\tregister(\"urn:ax:schema:terminal-capability-evidence\", validateTerminalCapabilityEvidence, \"1.0.0\")\n139|\tregister(\"urn:ax:schema:clone-raw-object-manifest\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n140|\tregister(\"urn:ax:schema:clone-capture-manifest\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n141|\tregister(\"urn:ax:schema:canonical-session\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n142|\tregister(\"urn:ax:schema:fidelity-report\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n143|\tregister(\"urn:ax:schema:projection-plan\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n144|\tregister(\"urn:ax:schema:clone-projected-object-manifest\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n145|\tregister(\"urn:ax:schema:clone-read-back-evidence-manifest\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n146|\tregister(\"urn:ax:schema:clone-validation-report\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n147|\tregister(\"urn:ax:schema:migration-checkpoint\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n148|\tregister(\"urn:ax:schema:clone-lineage-receipt\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n149|\tregister(\"urn:ax:schema:supported-environment-tuples\", rejectUnsupportedImmutableObjectShape, \"1.0.0\")\n150|\n151|\tif err := validateImmutableObjectShapeValidators(validators, catalog.Current().SelfIdentities); err != nil {\n152|\t\tpanic(fmt.Sprintf(\"immutable-object shape validator registry is invalid: %v\", err))\n153|\t}\n154|\treturn validators\n155|}\n156|\n157|func validateImmutableObjectShapeValidators(\n158|\tvalidators map[schemaIdentityKey]immutableObjectShapeValidator,\n159|\tdefinitions []catalog.SelfIdentityContract,\n160|) error {\n161|\texpected := make(map[schemaIdentityKey]struct{})\n162|\tfor _, definition := range definitions {\n163|\t\tfor _, version := range definition.ContractVersions {\n164|\t\t\tkey := schemaIdentityKey{schema: string(definition.ContractID), version: version}\n165|\t\t\texpected[key] = struct{}{}\n166|\t\t\tvalidator, ok := validators[key]\n167|\t\t\tif !ok || validator == nil {\n168|\t\t\t\treturn fmt.Errorf(\"missing immutable-object shape validator for %s@%s\", key.schema, key.version)\n169|\t\t\t}\n170|\t\t}\n171|\t}\n172|\tif len(validators) != len(expected) {\n173|\t\treturn fmt.Errorf(\"immutable-object shape validator table has %d rows, generated registry has %d\", len(validators), len(expected))\n174|\t}\n175|\tfor key := range validators {\n176|\t\tif _, ok := expected[key]; !ok {\n177|\t\t\treturn fmt.Errorf(\"immutable-object shape validator for unregistered schema %s@%s\", key.schema, key.version)\n178|\t\t}\n179|\t}\n180|\treturn nil\n181|}\n182|\n183|// validateImmutableObjectShape is the total closed-shape gate used by both\n184|// object-identity production entries. Registry membership never creates an\n185|// extension-only fall-through: each schema/version has an explicit validator\n186|// or an explicit unsupported-shape refusal.\n187|func validateImmutableObjectShape(object map[string]any) error {\n188|\tschema, err := requiredStringMember(object, \"schema\")\n189|\tif err != nil {\n190|\t\treturn err\n191|\t}\n192|\tversion, err := requiredStringMember(object, \"schema_version\")\n193|\tif err != nil {\n194|\t\treturn err\n195|\t}\n196|\n197|\tvalidator, ok := immutableObjectShapeValidators[schemaIdentityKey{schema: schema, version: version}]\n198|\tif !ok || validator == nil {\n199|\t\treturn invalidIdentity(\"no immutable-object shape validator for %s@%s\", schema, version)\n200|\t}\n201|\treturn validator(object)\n202|}\n203|\n204|func validateSessionRecordV1(object map[string]any) error {\n205|\tif err := requireExactMembers(\"Session Record 1.0.0\", object,\n206|\t\t\"schema\", \"schema_version\", \"record_id\", \"subject_id\", \"session_id\", \"name\", \"kind\",\n207|\t\t\"created_at\", \"created_by_host_id\", \"provider_id\", \"workspace_group_id\", \"execution_profile\",\n208|\t\t\"launch_plan\", \"task_board\", \"fork_provenance\", \"extensions\"); err != nil {\n209|\t\treturn err\n210|\t}\n211|\tsessionID, _, _, err := validateSessionRecordCommon(object, \"1.0.0\")\n212|\tif err != nil {\n213|\t\treturn err\n214|\t}\n215|\treturn validateSessionForkProvenance(object, sessionID)\n216|}\n217|\n218|func validateSessionRecordV2(object map[string]any) error {\n219|\treturn validateSessionRecordWithDerivation(object, \"2.0.0\")\n220|}\n221|\n222|func validateSessionRecordV3(object map[string]any) error {\n223|\treturn validateSessionRecordWithDerivation(object, \"3.0.0\")\n224|}\n225|\n226|func validateSessionRecordWithDerivation(object map[string]any, version string) error {\n227|\tif err := requireExactMembers(\"Session Record 2.0.0 and 3.0.0\", object,\n228|\t\t\"schema\", \"schema_version\", \"record_id\", \"subject_id\", \"session_id\", \"name\", \"kind\",\n229|\t\t\"created_at\", \"created_by_host_id\", \"provider_id\", \"workspace_group_id\", \"execution_profile\",\n230|\t\t\"launch_plan\", \"task_board\", \"derivation_provenance\", \"extensions\"); err != nil {\n231|\t\treturn err\n232|\t}\n233|\tsessionID, providerID, _, err := validateSessionRecordCommon(object, version)\n234|\tif err != nil {\n235|\t\treturn err\n236|\t}\n237|\treturn validateSessionDerivationProvenance(object, version, sessionID, providerID)\n238|}\n239|\n240|func validateSessionRecordCommon(object map[string]any, version string) (string, string, string, error) {\n241|\tif err := requireExactString(object, \"schema\", \"urn:ax:schema:session-record\"); err != nil {\n242|\t\treturn \"\", \"\", \"\", err\n243|\t}\n244|\tif err := requireExactString(object, \"schema_version\", version); err != nil {\n245|\t\treturn \"\", \"\", \"\", err\n246|\t}\n247|\tif err := requireDigest(object, \"record_id\"); err != nil {\n248|\t\treturn \"\", \"\", \"\", err\n249|\t}\n250|\tif err := validateCommonRecordEnvelope(object); err != nil {\n251|\t\treturn \"\", \"\", \"\", err\n252|\t}\n253|\tsubjectID, err := requireUUIDv7(object, \"subject_id\")\n254|\tif err != nil {\n255|\t\treturn \"\", \"\", \"\", err\n256|\t}\n257|\tsessionID, err := requireUUIDv7(object, \"session_id\")\n258|\tif err != nil {\n259|\t\treturn \"\", \"\", \"\", err\n260|\t}\n261|\tif subjectID != sessionID {\n262|\t\treturn \"\", \"\", \"\", invalidIdentity(\"Session Record subject_id must equal session_id\")\n263|\t}\n264|\tname, err := requireString(object, \"name\")\n265|\tif err != nil {\n266|\t\treturn \"\", \"\", \"\", err\n267|\t}\n268|\tif !sessionNamePattern.MatchString(name) {\n269|\t\treturn \"\", \"\", \"\", invalidIdentity(\"Session Record name must match [A-Za-z0-9][A-Za-z0-9._-]{0,63}\")\n270|\t}\n271|\tkind, err := requireEnum(object, \"kind\", \"direct\", \"task_board\")\n272|\tif err != nil {\n273|\t\treturn \"\", \"\", \"\", err\n274|\t}\n275|\tproviderID, err := requireString(object, \"provider_id\")\n276|\tif err != nil {\n277|\t\treturn \"\", \"\", \"\", err\n278|\t}\n279|\tif _, err := scalar.ParseProviderID(providerID); err != nil {\n280|\t\treturn \"\", \"\", \"\", invalidIdentity(\"Session Record provider_id: %v\", err)\n281|\t}\n282|\tif _, err := requireUUIDv7(object, \"workspace_group_id\"); err != nil {\n283|\t\treturn \"\", \"\", \"\", err\n284|\t}\n285|\tif _, err := requireEnum(object, \"execution_profile\", \"standard\", \"yolo\"); err != nil {\n286|\t\treturn \"\", \"\", \"\", err\n287|\t}\n288|\tlaunchPlan, err := requireObject(object, \"launch_plan\")\n289|\tif err != nil {\n290|\t\treturn \"\", \"\", \"\", err\n291|\t}\n292|\tif err := validateSessionLaunchPlan(launchPlan); err != nil {\n293|\t\treturn \"\", \"\", \"\", err\n294|\t}\n295|\tif err := validateSessionTaskBoardReference(object, kind); err != nil {\n296|\t\treturn \"\", \"\", \"\", err\n297|\t}\n298|\treturn sessionID, providerID, kind, nil\n299|}\n300|\n301|func validateSessionLaunchPlan(object map[string]any) error {\n302|\tif err := requireExactMembers(\"Session Record Launch Plan\", object,\n303|\t\t\"argv\", \"cwd_workspace_id\", \"cwd_relative\", \"env_names\", \"env_literals\", \"contains_secrets\", \"extensions\"); err != nil {\n304|\t\treturn err\n305|\t}\n306|\targv, err := requireArray(object, \"argv\", 128)\n307|\tif err != nil {\n308|\t\treturn err\n309|\t}\n310|\tif len(argv) == 0 {\n311|\t\treturn invalidIdentity(\"Session Record Launch Plan argv must contain at least one element\")\n312|\t}\n313|\tfor index, value := range argv {\n314|\t\ttext, ok := value.(string)\n315|\t\t// !utf8.ValidString(text) is subsumed by decodeStrict; see the subsumed\n316|\t\t// UTF-8 re-check note above. The other three terms are reachable.\n317|\t\tif !ok || !utf8.ValidString(text) || len(text) == 0 || len(text) > 4096 {\n318|\t\t\treturn invalidIdentity(\"Session Record Launch Plan argv[%d] must contain 1..4096 UTF-8 bytes\", index)\n319|\t\t}\n320|\t}\n321|\tif err := canonicalByteBound(\"Session Record Launch Plan argv\", argv, 65_536); err != nil {\n322|\t\treturn err\n323|\t}\n324|\tif _, err := requireUUIDv7(object, \"cwd_workspace_id\"); err != nil {\n325|\t\treturn err\n326|\t}\n327|\tif err := requireDotOrRelativePath(object, \"cwd_relative\"); err != nil {\n328|\t\treturn err\n329|\t}\n330|\tenvNames, err := requireArray(object, \"env_names\", 64)\n331|\tif err != nil {\n332|\t\treturn err\n333|\t}\n334|\tseenNames := make(map[string]struct{}, len(envNames))\n335|\tprevious := \"\"\n336|\tfor index, value := range envNames {\n337|\t\tname, ok := value.(string)\n338|\t\tif !ok || !environmentNamePattern.MatchString(name) {\n339|\t\t\treturn invalidIdentity(\"Session Record Launch Plan env_names[%d] has invalid environment-name grammar\", index)\n340|\t\t}\n341|\t\tif index > 0 && name <= previous {\n342|\t\t\treturn invalidIdentity(\"Session Record Launch Plan env_names must be strictly sorted and unique\")\n343|\t\t}\n344|\t\tseenNames[name] = struct{}{}\n345|\t\tprevious = name\n346|\t}\n347|\tenvLiterals, err := requireObject(object, \"env_literals\")\n348|\tif err != nil {\n349|\t\treturn err\n350|\t}\n351|\tif len(envLiterals) > 64 {\n352|\t\treturn invalidIdentity(\"Session Record Launch Plan env_literals contains %d members, maximum is 64\", len(envLiterals))\n353|\t}\n354|\tfor name, value := range envLiterals {\n355|\t\tif !environmentNamePattern.MatchString(name) {\n356|\t\t\treturn invalidIdentity(\"Session Record Launch Plan env_literals key %q has invalid environment-name grammar\", name)\n357|\t\t}\n358|\t\tif _, duplicate := seenNames[name]; duplicate {\n359|\t\t\treturn invalidIdentity(\"Session Record Launch Plan environment name %q occurs in both env_names and env_literals\", name)\n360|\t\t}\n361|\t\ttext, ok := value.(string)\n362|\t\t// !utf8.ValidString(text) is subsumed by decodeStrict; see the subsumed\n363|\t\t// UTF-8 re-check note above. The other two terms are reachable.\n364|\t\tif !ok || !utf8.ValidString(text) || len(text) > 4096 {\n365|\t\t\treturn invalidIdentity(\"Session Record Launch Plan env_literals[%q] must contain at most 4096 UTF-8 bytes\", name)\n366|\t\t}\n367|\t}\n368|\tcontainsSecrets, err := requireBool(object, \"contains_secrets\")\n369|\tif err != nil {\n370|\t\treturn err\n371|\t}\n372|\tif containsSecrets {\n373|\t\treturn invalidIdentity(\"Session Record Launch Plan contains_secrets must be false\")\n374|\t}\n375|\textensions, err := requireObject(object, \"extensions\")\n376|\tif err != nil {\n377|\t\treturn err\n378|\t}\n379|\treturn validateExtensionsObject(extensions)\n380|}\n381|\n382|func validateSessionTaskBoardReference(parent map[string]any, kind string) error {\n383|\tvalue, ok := parent[\"task_board\"]\n384|\tif !ok {\n385|\t\treturn invalidIdentity(\"identity input requires member task_board\")\n386|\t}\n387|\tif kind == \"direct\" {\n388|\t\tif value != nil {\n389|\t\t\treturn invalidIdentity(\"direct Session Record task_board must be null\")\n390|\t\t}\n391|\t\treturn nil\n392|\t}\n393|\tobject, err := requireObjectValue(value, \"Session Record task_board\")\n394|\tif err != nil {\n395|\t\treturn err\n396|\t}\n397|\tif err := requireExactMembers(\"Session Record Task-board Reference\", object,\n398|\t\t\"bridge_protocol_version\", \"board\", \"task_element_id\", \"launch_mode\", \"manager_session_ref\",\n399|\t\t\"board_goal\", \"native_goal_binding\", \"extensions\"); err != nil {\n400|\t\treturn err\n401|\t}\n402|\tif err := requireExactString(object, \"bridge_protocol_version\", \"1.0.0\"); err != nil {\n403|\t\treturn err\n404|\t}\n405|\tboard, err := requireObject(object, \"board\")\n406|\tif err != nil {\n407|\t\treturn err\n408|\t}\n409|\tif err := validateSessionBoardIdentity(board); err != nil {\n410|\t\treturn err\n411|\t}\n412|\tif _, err := requirePrintableByteBoundedString(object, \"task_element_id\", 1, 128); err != nil {\n413|\t\treturn err\n414|\t}\n415|\tlaunchMode, err := requireEnum(object, \"launch_mode\", \"primary_owner\", \"tracked_prompt\")\n416|\tif err != nil {\n417|\t\treturn err\n418|\t}\n419|\tif value, ok := object[\"manager_session_ref\"]; !ok || value != nil {\n420|\t\treturn invalidIdentity(\"Session Record Task-board Reference manager_session_ref must be null at creation\")\n421|\t}\n422|\tbinding, err := requireEnum(object, \"native_goal_binding\", \"bound\", \"prompt\", \"none\")\n423|\tif err != nil {\n424|\t\treturn err\n425|\t}\n426|\tgoalValue, ok := object[\"board_goal\"]\n427|\tif !ok {\n428|\t\treturn invalidIdentity(\"identity input requires member board_goal\")\n429|\t}\n430|\tif launchMode == \"primary_owner\" {\n431|\t\tif goalValue == nil || binding != \"bound\" {\n432|\t\t\treturn invalidIdentity(\"primary_owner Task-board Reference requires a board goal and bound native goal\")\n433|\t\t}\n434|\t} else if binding == \"bound\" {\n435|\t\treturn invalidIdentity(\"tracked_prompt Task-board Reference native_goal_binding must be prompt or none\")\n436|\t}\n437|\tif goalValue != nil {\n438|\t\tgoal, err := requireObjectValue(goalValue, \"Session Record board_goal\")\n439|\t\tif err != nil {\n440|\t\t\treturn err\n441|\t\t}\n442|\t\tif err := validateSessionBoardGoal(goal); err != nil {\n443|\t\t\treturn err\n444|\t\t}\n445|\t}\n446|\textensions, err := requireObject(object, \"extensions\")\n447|\tif err != nil {\n448|\t\treturn err\n449|\t}\n450|\treturn validateExtensionsObject(extensions)\n451|}\n452|\n453|func validateSessionBoardIdentity(object map[string]any) error {\n454|\tif err := requireExactMembers(\"Session Record Board Identity\", object, \"kind\", \"logical_id\", \"remote_url\", \"extensions\"); err != nil {\n455|\t\treturn err\n456|\t}\n457|\tkind, err := requireEnum(object, \"kind\", \"local\", \"remote\")\n458|\tif err != nil {\n459|\t\treturn err\n460|\t}\n461|\tlogicalID, err := requireBoundedString(object, \"logical_id\", 1, 128)\n462|\tif err != nil {\n463|\t\treturn err\n464|\t}\n465|\tif !boardLogicalIDPattern.MatchString(logicalID) {\n466|\t\treturn invalidIdentity(\"Session Record Board Identity logical_id has invalid grammar\")\n467|\t}\n468|\tremoteValue, ok := object[\"remote_url\"]\n469|\tif !ok {\n470|\t\treturn invalidIdentity(\"identity input requires member remote_url\")\n471|\t}\n472|\tif kind == \"local\" {\n473|\t\tif remoteValue != nil {\n474|\t\t\treturn invalidIdentity(\"local Session Record Board Identity remote_url must be null\")\n475|\t\t}\n476|\t} else {\n477|\t\tremoteURL, ok := remoteValue.(string)\n478|\t\t// !utf8.ValidString(remoteURL) is subsumed by decodeStrict; see the\n479|\t\t// subsumed UTF-8 re-check note above. The !ok term is reachable.\n480|\t\tif !ok || !utf8.ValidString(remoteURL) {\n481|\t\t\treturn invalidIdentity(\"remote Session Record Board Identity remote_url must be a UTF-8 string\")\n482|\t\t}\n483|\t\tparsed, err := url.Parse(remoteURL)\n484|\t\tif err != nil || parsed.Scheme != \"https\" || parsed.Host == \"\" || parsed.User != nil || parsed.RawQuery != \"\" || parsed.Fragment != \"\" {\n485|\t\t\treturn invalidIdentity(\"remote Session Record Board Identity remote_url must be absolute HTTPS without userinfo, query, or fragment\")\n486|\t\t}\n487|\t}\n488|\textensions, err := requireObject(object, \"extensions\")\n489|\tif err != nil {\n490|\t\treturn err\n491|\t}\n492|\treturn validateExtensionsObject(extensions)\n493|}\n494|\n495|func validateSessionBoardGoal(object map[string]any) error {\n496|\tif err := requireExactMembers(\"Session Record Board Goal\", object, \"schema\", \"goal_id\", \"revision\", \"extensions\"); err != nil {\n497|\t\treturn err\n498|\t}\n499|\tif err := requireExactString(object, \"schema\", \"board-goal-v2\"); err != nil {\n500|\t\treturn err\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5ff","stream":{"kind":"session","id":"01a0ceca-cad7-7401-b120-5d187a59f4b1"},"sequence":346,"recorded_at":1780531400000687,"record_type":"event","durability":"durable","causation_id":"f679b6f1-9902-47f8-8dc1-d6bbf0923c83","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"f679b6f1-9902-47f8-8dc1-d6bbf0923c83","run_stream":{"kind":"run","id":"f679b6f1-9902-47f8-8dc1-d6bbf0923c83"},"call_id":"call_01a0cecb81e070f2886ba24ae048051d","text":"Read text file `internal/canonicaljson/canonical.go`.\n1|// Package canonicaljson implements the RFC 8785 JSON Canonicalization Scheme\n2|// and the AX omit-self-field identity boundary for immutable logical objects.\n3|package canonicaljson\n4|\n5|import (\n6|\t\"bytes\"\n7|\t\"encoding/json\"\n8|\t\"errors\"\n9|\t\"fmt\"\n10|\t\"io\"\n11|\t\"strconv\"\n12|\t\"strings\"\n13|\t\"unicode/utf8\"\n14|\n15|\t\"github.com/gowebpki/jcs\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n17|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n18|)\n19|\n20|const maxSafeInteger int64 = 9007199254740991\n21|\n22|// maxNestingDepth bounds how many JSON containers (objects or arrays) may be\n23|// open at once in any document that reaches decodeValue, which is the shared\n24|// strict decode path behind Canonicalize, CalculateObjectIdentity, and\n25|// VerifyObjectIdentity. Without it, one recursion frame per nesting level lets\n26|// an untrusted peer object exhaust the goroutine stack, and Go reports that as\n27|// a fatal runtime error that recover cannot intercept.\n28|//\n29|// Rationale for 256: the deepest normative closed shape is the Transfer\n30|// Manifest submodule tree at its 16-level maximum, which nests roughly 40\n31|// containers including the identity envelope, and open extensions are bounded\n32|// at 4 levels, so 256 leaves more than sixfold headroom over any accepted AX\n33|// object. It is also far below encoding/json's 10,000-level Unmarshal cap and\n34|// the unbounded recursion inside the JCS re-parse, so this typed refusal is\n35|// always the first gate a deep document meets, and the decode stack stays at\n36|// a few hundred small frames regardless of input size.\n37|const maxNestingDepth = 256\n38|\n39|var (\n40|\t// ErrInvalidJSON reports input outside the RFC 8785 I-JSON surface.\n41|\tErrInvalidJSON = errors.New(\"invalid canonical JSON input\")\n42|\t// ErrInvalidIdentity reports input outside the AX omit-self identity contract.\n43|\tErrInvalidIdentity = errors.New(\"invalid canonical object identity\")\n44|)\n45|\n46|// SelfField is one of the pinned AX immutable-object self-identity namespaces.\n47|// Chunk IDs are intentionally absent: Section 10.3 defines chunk_id as a\n48|// digest of raw bytes, not of a JSON object.\n49|type SelfField string\n50|\n51|const (\n52|\tSelfRecordID                   SelfField = \"record_id\"\n53|\tSelfEventID                    SelfField = \"event_id\"\n54|\tSelfCheckpointID               SelfField = \"checkpoint_id\"\n55|\tSelfDescriptorID               SelfField = \"descriptor_id\"\n56|\tSelfManifestID                 SelfField = \"manifest_id\"\n57|\tSelfPlanID                     SelfField = \"plan_id\"\n58|\tSelfTombstoneID                SelfField = \"tombstone_id\"\n59|\tSelfAckID                      SelfField = \"ack_id\"\n60|\tSelfBundleID                   SelfField = \"bundle_id\"\n61|\tSelfMarkerID                   SelfField = \"marker_id\"\n62|\tSelfObservationID              SelfField = \"observation_id\"\n63|\tSelfBatchID                    SelfField = \"batch_id\"\n64|\tSelfLineageLinkID              SelfField = \"lineage_link_id\"\n65|\tSelfAnnotationID               SelfField = \"annotation_id\"\n66|\tSelfProfileID                  SelfField = \"profile_id\"\n67|\tSelfJobRequestID               SelfField = \"job_request_id\"\n68|\tSelfJobReceiptID               SelfField = \"job_receipt_id\"\n69|\tSelfDirectoryReceiptID         SelfField = \"directory_receipt_id\"\n70|\tSelfProbeID                    SelfField = \"probe_id\"\n71|\tSelfBindingID                  SelfField = \"binding_id\"\n72|\tSelfEvidenceID                 SelfField = \"evidence_id\"\n73|\tSelfRawObjectManifestID        SelfField = \"raw_object_manifest_id\"\n74|\tSelfCaptureManifestID          SelfField = \"capture_manifest_id\"\n75|\tSelfCanonicalSessionID         SelfField = \"canonical_session_id\"\n76|\tSelfFidelityReportID           SelfField = \"fidelity_report_id\"\n77|\tSelfProjectionPlanID           SelfField = \"projection_plan_id\"\n78|\tSelfProjectedObjectManifestID  SelfField = \"projected_object_manifest_id\"\n79|\tSelfReadBackEvidenceManifestID SelfField = \"read_back_evidence_manifest_id\"\n80|\tSelfValidationReportID         SelfField = \"validation_report_id\"\n81|\tSelfMigrationCheckpointID      SelfField = \"migration_checkpoint_id\"\n82|\tSelfLineageReceiptID           SelfField = \"lineage_receipt_id\"\n83|\tSelfRegistryDigest             SelfField = \"registry_digest\"\n84|)\n85|\n86|type schemaIdentityKey struct {\n87|\tschema  string\n88|\tversion string\n89|}\n90|\n91|type schemaIdentityContract struct {\n92|\tselfField          SelfField\n93|\tdiscriminatorName  string\n94|\tdiscriminatorValue string\n95|}\n96|\n97|// schemaIdentityContracts is derived from the generated catalog whose source\n98|// is bound to the pinned v0.5.0 document. A schema may legitimately carry a\n99|// differently named ID as a reference, so field-name counting is not an\n100|// identity contract.\n101|var schemaIdentityContracts = mustBuildSchemaIdentityContracts(catalog.Current().SelfIdentities)\n102|\n103|func mustBuildSchemaIdentityContracts(definitions []catalog.SelfIdentityContract) map[schemaIdentityKey]schemaIdentityContract {\n104|\tcontracts, err := buildSchemaIdentityContracts(definitions)\n105|\tif err != nil {\n106|\t\tpanic(fmt.Sprintf(\"generated self-identity catalog is invalid: %v\", err))\n107|\t}\n108|\treturn contracts\n109|}\n110|\n111|func buildSchemaIdentityContracts(definitions []catalog.SelfIdentityContract) (map[schemaIdentityKey]schemaIdentityContract, error) {\n112|\tcontracts := make(map[schemaIdentityKey]schemaIdentityContract)\n113|\tfor _, definition := range definitions {\n114|\t\tcontract := schemaIdentityContract{\n115|\t\t\tselfField:          SelfField(definition.SelfField),\n116|\t\t\tdiscriminatorName:  definition.DiscriminatorName,\n117|\t\t\tdiscriminatorValue: definition.DiscriminatorValue,\n118|\t\t}\n119|\t\tfor _, version := range definition.ContractVersions {\n120|\t\t\tkey := schemaIdentityKey{schema: string(definition.ContractID), version: version}\n121|\t\t\tif _, duplicate := contracts[key]; duplicate {\n122|\t\t\t\treturn nil, fmt.Errorf(\"duplicate self-identity contract for %s@%s\", key.schema, key.version)\n123|\t\t\t}\n124|\t\t\tcontracts[key] = contract\n125|\t\t}\n126|\t}\n127|\tif err := validateSchemaIdentityContracts(contracts, definitions); err != nil {\n128|\t\treturn nil, err\n129|\t}\n130|\treturn contracts, nil\n131|}\n132|\n133|func validateSchemaIdentityContracts(contracts map[schemaIdentityKey]schemaIdentityContract, definitions []catalog.SelfIdentityContract) error {\n134|\texpected := 0\n135|\tfor _, definition := range definitions {\n136|\t\tfor _, version := range definition.ContractVersions {\n137|\t\t\texpected++\n138|\t\t\tkey := schemaIdentityKey{schema: string(definition.ContractID), version: version}\n139|\t\t\tcontract, ok := contracts[key]\n140|\t\t\tif !ok {\n141|\t\t\t\treturn fmt.Errorf(\"missing self-identity contract for %s@%s\", key.schema, key.version)\n142|\t\t\t}\n143|\t\t\tif contract.selfField != SelfField(definition.SelfField) ||\n144|\t\t\t\tcontract.discriminatorName != definition.DiscriminatorName ||\n145|\t\t\t\tcontract.discriminatorValue != definition.DiscriminatorValue {\n146|\t\t\t\treturn fmt.Errorf(\"self-identity contract for %s@%s differs from generated catalog\", key.schema, key.version)\n147|\t\t\t}\n148|\t\t}\n149|\t}\n150|\tif len(contracts) != expected {\n151|\t\treturn fmt.Errorf(\"self-identity contract table has %d rows, generated catalog has %d\", len(contracts), expected)\n152|\t}\n153|\treturn nil\n154|}\n155|\n156|// Canonicalize is the production RFC 8785 entry point. It decodes input through\n157|// the shared strict decoder, so it rejects malformed UTF-8, lone or unpaired\n158|// surrogate escapes, unescaped control characters inside strings, duplicate\n159|// object names, trailing data after the top-level value, and any document that\n160|// holds more than 256 containers open at once. What survives is returned as the\n161|// RFC 8785 canonical UTF-8 byte sequence.\n162|//\n163|// That last bound is a nesting depth, not a count of the containers a document\n164|// opens. Only simultaneously open containers cost decoder stack frames, which\n165|// is the exhaustion this refusal exists to prevent, so a shallow document is\n166|// accepted however many containers it opens in total. Each row below is built\n167|// and driven through this function by\n168|// TestCanonicalizeDocumentedContainerLimitIsADepthNotACount:\n169|//\n170|//\t400 sibling arrays open 401 containers, 2 at once: accepted\n171|//\t256 nested arrays open 256 containers, 256 at once: accepted\n172|//\t257 nested arrays open 257 containers, 257 at once: refused\n173|//\n174|// WHAT THIS FUNCTION DOES NOT REFUSE.\n175|//\n176|// It does not enforce the AX common logical number model, and it must not.\n177|// RFC 8785 Section 3.2.2.3 serializes every number through the ECMAScript\n178|// Number.prototype.toString algorithm applied to the IEEE 754 binary64 value,\n179|// and Appendix B publishes the resulting rounded outputs as normative test\n180|// data. A literal that binary64 cannot hold exactly is therefore rounded to the\n181|// nearest double and canonicalized from there rather than refused:\n182|//\n183|//\t9007199254740993 -> 9007199254740992\n184|//\t18446744073709551615 -> 18446744073709552000\n185|//\t1.0 -> 1\n186|//\n187|// That is the intended behaviour of a JCS transform, not a gap in it. Refusing\n188|// those literals here would contradict Appendix B, whose own published samples\n189|// include 9007199254740992 and 295147905179352830000 as canonical outputs of\n190|// exactly this rounding, and which this package pins in\n191|// TestCanonicalizeMatchesEveryFiniteRFC8785AppendixBNumberSample.\n192|//\n193|// DIVISION OF GUARANTEES.\n194|//\n195|// The pinned specification does not put the safe-integer refusal on the\n196|// canonicalization step. It puts it on the AX decoder, on the JSON number token\n197|// itself, and Section 1.6 says so both as a MUST clause and as two normative\n198|// boundary fixtures. Each fragment below is quoted verbatim from the pinned\n199|// internal/specdoc/SPEC.md at the line named, and a fragment attributed to a\n200|// fixture is quoted from the table row that declares that fixture:\n201|//\n202|//\tSPEC.md:292 \"A decoder MUST reject a numeric literal at or beyond <code>2^53</code> even if its host language can represent it\"\n203|//\tSPEC.md:295 \"Implementations MUST NOT round a value and continue.\"\n204|//\tSPEC.md:301 NUM-UNSAFE-NUMBER \"Reject before identity calculation with <code>incompatible_schema</code>\"\n205|//\tSPEC.md:302 NUM-UNSAFE-ROUND \"Reject from the JSON number token before conversion to a host double; an implementation that first rounds it to 9007199254740992 is nonconforming\"\n206|//\n207|// NUM-UNSAFE-ROUND describes this implementation exactly: validateAXNumbers\n208|// refuses the literal on the json.Number token, before any conversion to a host\n209|// double, and it runs inside prepareObjectIdentity before any canonical bytes\n210|// exist. It is reached from these exported entry points, each of which refuses\n211|// all three literals above with a typed error:\n212|//\n213|//\tCalculateObjectIdentity\n214|//\tVerifyObjectIdentity\n215|//\tValidateObservationEvent\n216|//\tValidateObservationStream\n217|//\n218|// Canonicalize itself carries no such guarantee. It is a byte transform over\n219|// whatever RFC 8785 accepts, and this package exports no standalone AX number\n220|// validator, so a caller that needs the AX number model must reach it through\n221|// one of the entry points named above rather than by canonicalizing first.\n222|func Canonicalize(input []byte) ([]byte, error) {\n223|\tvalue, err := decodeStrict(input)\n224|\tif err != nil {\n225|\t\treturn nil, err\n226|\t}\n227|\t// Re-encode the parsed logical value before the JCS transform. This removes\n228|\t// leading/trailing whitespace around primitive top-level values without\n229|\t// changing json.Number tokens or string data.\n230|\tnormalized, err := json.Marshal(value)\n231|\tif err != nil {\n232|\t\treturn nil, invalidJSON(\"serialize logical JSON value: %v\", err)\n233|\t}\n234|\tcanonical, err := jcs.Transform(normalized)\n235|\tif err != nil {\n236|\t\treturn nil, invalidJSON(\"canonicalize RFC 8785 value: %v\", err)\n237|\t}\n238|\treturn canonical, nil\n239|}\n240|\n241|// CalculateObjectIdentity validates the AX common logical number model,\n242|// resolves the one self field from the object's trusted schema/version\n243|// contract, omits that field, applies RFC 8785 JCS, and returns the SHA-256\n244|// identity. Callers cannot select an arbitrary field to omit, which prevents\n245|// self inclusion and digest cycles.\n246|//\n247|// This is where the AX safe-integer refusal lives, not in Canonicalize: a\n248|// literal at or beyond 2^53, or any floating-point literal, is refused here\n249|// with ErrInvalidIdentity before canonical bytes are produced. See the DIVISION\n250|// OF GUARANTEES note on Canonicalize.\n251|func CalculateObjectIdentity(input []byte) (scalar.Digest, SelfField, error) {\n252|\tobject, selfField, _, err := prepareObjectIdentity(input)\n253|\tif err != nil {\n254|\t\treturn scalar.Digest{}, \"\", err\n255|\t}\n256|\treturn calculatePreparedObjectIdentity(object, selfField)\n257|}\n258|\n259|func prepareObjectIdentity(input []byte) (map[string]any, SelfField, scalar.Digest, error) {\n260|\tif len(input) > 5_242_880 {\n261|\t\treturn nil, \"\", scalar.Digest{}, invalidIdentity(\"encoded identity object is %d bytes, maximum is 5242880\", len(input))\n262|\t}\n263|\tvalue, err := decodeStrict(input)\n264|\tif err != nil {\n265|\t\treturn nil, \"\", scalar.Digest{}, err\n266|\t}\n267|\tif err := validateAXNumbers(value); err != nil {\n268|\t\treturn nil, \"\", scalar.Digest{}, err\n269|\t}\n270|\tobject, ok := value.(map[string]any)\n271|\tif !ok {\n272|\t\treturn nil, \"\", scalar.Digest{}, invalidIdentity(\"identity input must be a JSON object\")\n273|\t}\n274|\n275|\tselfField, claimed, err := resolveSelfField(object)\n276|\tif err != nil {\n277|\t\treturn nil, \"\", scalar.Digest{}, err\n278|\t}\n279|\t// This is the composed production gate: closed contract validation happens\n280|\t// after trusted schema selection and before either calculation or attestation.\n281|\tif err := validateImmutableObjectShape(object); err != nil {\n282|\t\treturn nil, \"\", scalar.Digest{}, err\n283|\t}\n284|\treturn object, selfField, claimed, nil\n285|}\n286|\n287|func calculatePreparedObjectIdentity(object map[string]any, selfField SelfField) (scalar.Digest, SelfField, error) {\n288|\tomitted := make(map[string]any, len(object)-1)\n289|\tfor name, member := range object {\n290|\t\tif name != string(selfField) {\n291|\t\t\tomitted[name] = member\n292|\t\t}\n293|\t}\n294|\tserialized, err := json.Marshal(omitted)\n295|\tif err != nil {\n296|\t\treturn scalar.Digest{}, \"\", invalidIdentity(\"serialize omit-self object: %v\", err)\n297|\t}\n298|\tcanonical, err := jcs.Transform(serialized)\n299|\tif err != nil {\n300|\t\treturn scalar.Digest{}, \"\", invalidIdentity(\"canonicalize omit-self object: %v\", err)\n301|\t}\n302|\treturn scalar.SHA256Digest(canonical), selfField, nil\n303|}\n304|\n305|// VerifyObjectIdentity drives the same production calculation and refuses a\n306|// malformed, self-included, or otherwise mismatched claimed identity. It shares\n307|// prepareObjectIdentity with CalculateObjectIdentity, so it carries the same AX\n308|// safe-integer guarantee that Canonicalize does not.\n309|func VerifyObjectIdentity(input []byte) (scalar.Digest, SelfField, error) {\n310|\tobject, selfField, claimed, err := prepareObjectIdentity(input)\n311|\tif err != nil {\n312|\t\treturn scalar.Digest{}, \"\", err\n313|\t}\n314|\tcalculated, calculatedField, err := calculatePreparedObjectIdentity(object, selfField)\n315|\tif err != nil {\n316|\t\treturn scalar.Digest{}, \"\", err\n317|\t}\n318|\tif calculatedField != selfField || claimed != calculated {\n319|\t\treturn scalar.Digest{}, \"\", invalidIdentity(\n320|\t\t\t\"%s claim %q does not match omit-self digest %q\",\n321|\t\t\tselfField,\n322|\t\t\tclaimed,\n323|\t\t\tcalculated,\n324|\t\t)\n325|\t}\n326|\treturn calculated, selfField, nil\n327|}\n328|\n329|func resolveSelfField(object map[string]any) (SelfField, scalar.Digest, error) {\n330|\tschema, err := requiredStringMember(object, \"schema\")\n331|\tif err != nil {\n332|\t\treturn \"\", scalar.Digest{}, err\n333|\t}\n334|\tversion, err := requiredStringMember(object, \"schema_version\")\n335|\tif err != nil {\n336|\t\treturn \"\", scalar.Digest{}, err\n337|\t}\n338|\tcontract, ok := schemaIdentityContracts[schemaIdentityKey{schema: schema, version: version}]\n339|\tif !ok {\n340|\t\treturn \"\", scalar.Digest{}, invalidIdentity(\n341|\t\t\t\"schema %q version %q has no supported immutable self-identity contract\",\n342|\t\t\tschema,\n343|\t\t\tversion,\n344|\t\t)\n345|\t}\n346|\tif contract.discriminatorName != \"\" {\n347|\t\tdiscriminator, err := requiredStringMember(object, contract.discriminatorName)\n348|\t\tif err != nil {\n349|\t\t\treturn \"\", scalar.Digest{}, err\n350|\t\t}\n351|\t\tif discriminator != contract.discriminatorValue {\n352|\t\t\treturn \"\", scalar.Digest{}, invalidIdentity(\n353|\t\t\t\t\"schema %q version %q variant %s=%q is not an immutable self-identity contract\",\n354|\t\t\t\tschema,\n355|\t\t\t\tversion,\n356|\t\t\t\tcontract.discriminatorName,\n357|\t\t\t\tdiscriminator,\n358|\t\t\t)\n359|\t\t}\n360|\t}\n361|\n362|\tvalue, ok := object[string(contract.selfField)]\n363|\tif !ok {\n364|\t\treturn \"\", scalar.Digest{}, invalidIdentity(\n365|\t\t\t\"schema %q version %q requires self field %s\",\n366|\t\t\tschema,\n367|\t\t\tversion,\n368|\t\t\tcontract.selfField,\n369|\t\t)\n370|\t}\n371|\ttext, ok := value.(string)\n372|\tif !ok {\n373|\t\treturn \"\", scalar.Digest{}, invalidIdentity(\"self field %s must contain a digest string\", contract.selfField)\n374|\t}\n375|\tclaim, err := scalar.ParseDigest(text)\n376|\tif err != nil {\n377|\t\treturn \"\", scalar.Digest{}, invalidIdentity(\"self field %s: %v\", contract.selfField, err)\n378|\t}\n379|\treturn contract.selfField, claim, nil\n380|}\n381|\n382|func requiredStringMember(object map[string]any, name string) (string, error) {\n383|\tvalue, ok := object[name]\n384|\tif !ok {\n385|\t\treturn \"\", invalidIdentity(\"identity input requires string member %s\", name)\n386|\t}\n387|\ttext, ok := value.(string)\n388|\tif !ok || text == \"\" {\n389|\t\treturn \"\", invalidIdentity(\"identity input member %s must be a non-empty string\", name)\n390|\t}\n391|\treturn text, nil\n392|}\n393|\n394|func decodeStrict(input []byte) (any, error) {\n395|\tif len(input) == 0 {\n396|\t\treturn nil, invalidJSON(\"input is empty\")\n397|\t}\n398|\tif !utf8.Valid(input) {\n399|\t\treturn nil, invalidJSON(\"input is not valid UTF-8\")\n400|\t}\n401|\tif err := validateSurrogateEscapes(input); err != nil {\n402|\t\treturn nil, err\n403|\t}\n404|\n405|\tdecoder := json.NewDecoder(bytes.NewReader(input))\n406|\tdecoder.UseNumber()\n407|\tvalue, err := decodeValue(decoder, 0)\n408|\tif err != nil {\n409|\t\treturn nil, err\n410|\t}\n411|\tif token, err := decoder.Token(); !errors.Is(err, io.EOF) {\n412|\t\tif err != nil {\n413|\t\t\treturn nil, invalidJSON(\"read trailing JSON data: %v\", err)\n414|\t\t}\n415|\t\treturn nil, invalidJSON(\"unexpected trailing JSON token %v\", token)\n416|\t}\n417|\treturn value, nil\n418|}\n419|\n420|// decodeValue decodes one logical JSON value. depth counts the containers\n421|// already open around this value, so the top-level value is decoded at depth 0\n422|// and a container at depth maxNestingDepth-1 is the last one allowed to open.\n423|func decodeValue(decoder *json.Decoder, depth int) (any, error) {\n424|\ttoken, err := decoder.Token()\n425|\tif err != nil {\n426|\t\treturn nil, invalidJSON(\"decode JSON token: %v\", err)\n427|\t}\n428|\tdelimiter, ok := token.(json.Delim)\n429|\tif !ok {\n430|\t\treturn token, nil\n431|\t}\n432|\tif depth >= maxNestingDepth {\n433|\t\treturn nil, invalidJSON(\"nesting depth %d exceeds maximum %d\", depth+1, maxNestingDepth)\n434|\t}\n435|\n436|\tswitch delimiter {\n437|\tcase '{':\n438|\t\tobject := make(map[string]any)\n439|\t\tfor decoder.More() {\n440|\t\t\tnameToken, err := decoder.Token()\n441|\t\t\tif err != nil {\n442|\t\t\t\treturn nil, invalidJSON(\"decode object name: %v\", err)\n443|\t\t\t}\n444|\t\t\tname, ok := nameToken.(string)\n445|\t\t\tif !ok {\n446|\t\t\t\treturn nil, invalidJSON(\"object name is not a string\")\n447|\t\t\t}\n448|\t\t\tif _, duplicate := object[name]; duplicate {\n449|\t\t\t\treturn nil, invalidJSON(\"duplicate object member %q\", name)\n450|\t\t\t}\n451|\t\t\tvalue, err := decodeValue(decoder, depth+1)\n452|\t\t\tif err != nil {\n453|\t\t\t\treturn nil, err\n454|\t\t\t}\n455|\t\t\tobject[name] = value\n456|\t\t}\n457|\t\tend, err := decoder.Token()\n458|\t\tif err != nil || end != json.Delim('}') {\n459|\t\t\treturn nil, invalidJSON(\"decode object terminator: %v\", err)\n460|\t\t}\n461|\t\treturn object, nil\n462|\tcase '[':\n463|\t\tarray := make([]any, 0)\n464|\t\tfor decoder.More() {\n465|\t\t\tvalue, err := decodeValue(decoder, depth+1)\n466|\t\t\tif err != nil {\n467|\t\t\t\treturn nil, err\n468|\t\t\t}\n469|\t\t\tarray = append(array, value)\n470|\t\t}\n471|\t\tend, err := decoder.Token()\n472|\t\tif err != nil || end != json.Delim(']') {\n473|\t\t\treturn nil, invalidJSON(\"decode array terminator: %v\", err)\n474|\t\t}\n475|\t\treturn array, nil\n476|\tdefault:\n477|\t\treturn nil, invalidJSON(\"unexpected delimiter %q\", delimiter)\n478|\t}\n479|}\n480|\n481|// validateAXNumbers is the AX decoder half of the split documented under\n482|// DIVISION OF GUARANTEES on Canonicalize. It walks the decoded value and\n483|// refuses every literal the common logical data model forbids, on the\n484|// json.Number token rather than on a host double, so an unsafe integer is\n485|// rejected instead of rounded. Canonicalize deliberately does not call it;\n486|// every exported entry point that promises the AX number model does.\n487|func validateAXNumbers(value any) error {\n488|\tswitch typed := value.(type) {\n489|\tcase json.Number:\n490|\t\tliteral := typed.String()\n491|\t\tif strings.ContainsAny(literal, \".eE\") {\n492|\t\t\treturn invalidIdentity(\"floating-point number %q is forbidden by the AX common model\", literal)\n493|\t\t}\n494|\t\tinteger, err := strconv.ParseInt(literal, 10, 64)\n495|\t\tif err != nil || integer < -maxSafeInteger || integer > maxSafeInteger {\n496|\t\t\treturn invalidIdentity(\"integer %q is outside the AX safe-integer interval\", literal)\n497|\t\t}\n498|\tcase []any:\n499|\t\tfor _, element := range typed {\n500|\t\t\tif err := validateAXNumbers(element); err != nil {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
