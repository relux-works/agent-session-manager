{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ce2b","stream":{"kind":"session","id":"01a0ceca-cad7-7401-b120-5d187a59f4b1"},"sequence":1392,"recorded_at":1780531400002779,"record_type":"event","durability":"durable","causation_id":"f679b6f1-9902-47f8-8dc1-d6bbf0923c83","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"f679b6f1-9902-47f8-8dc1-d6bbf0923c83","run_stream":{"kind":"run","id":"f679b6f1-9902-47f8-8dc1-d6bbf0923c83"},"task_stream":{"kind":"task","id":"01a0ced2-dded-7e70-aee2-4364c3941ff3"},"task_id":"01a0ced2-dded-7e70-aee2-4364c3941ff3","event":{"kind":"output","task_id":"01a0ced2-dded-7e70-aee2-4364c3941ff3","chunk":"edited\nchanged lines: lines 186-212\n--- original\n+++ updated\n@@\n-// checkRecordReasonRule enforces the reason-set rule both entries\n-// share: exact requires an empty reason set and every other\n-// disposition at least one reason.\n-func checkRecordReasonRule(disposition string, reasonCount int) error {\n-\tif disposition == \"exact\" {\n-\t\tif reasonCount != 0 {\n-\t\t\treturn invalid(\"fidelity disposition record exact carries %d reason_codes, want an empty reason set\", reasonCount)\n-\t\t}\n-\t\treturn nil\n-\t}\n-\tif reasonCount < 1 {\n-\t\treturn invalid(\"fidelity disposition record %s carries no reason_codes, want at least one reason\", disposition)\n-\t}\n-\treturn nil\n-}\n-\n-// checkRecordCanonicalRule enforces the canonical-object rule both\n-// entries share: synthesized requires no source canonical object.\n-// Non-synthesized rows admit a digest or null: capture items that\n-// never normalized (omitted, unrecoverable) carry null, canonical\n-// events carry their object ID.\n-func checkRecordCanonicalRule(disposition string, hasCanonical bool) error {\n-\tif disposition == \"synthesized\" && hasCanonical {\n-\t\treturn invalid(\"fidelity disposition record synthesized carries a source canonical object\")\n-\t}\n-\treturn nil\n-}\n+// checkRecordReasonRule enforces the reason-set rule both entries\n+// share: exact requires an empty reason set and every other\n+// disposition at least one reason.\n+func checkRecordReasonRule(owner, disposition string, reasonCount int) error {\n+\tif disposition == \"exact\" {\n+\t\tif reasonCount != 0 {\n+\t\t\treturn invalid(\"%s exact carries %d reason_codes, want an empty reason set\", owner, reasonCount)\n+\t\t}\n+\t\treturn nil\n+\t}\n+\tif reasonCount < 1 {\n+\t\treturn invalid(\"%s %s carries no reason_codes, want at least one reason\", owner, disposition)\n+\t}\n+\treturn nil\n+}\n+\n+// checkRecordCanonicalRule enforces the canonical-object rule both\n+// entries share: synthesized requires no source canonical object.\n+// Non-synthesized rows admit a digest or null: capture items that\n+// never normalized (omitted, unrecoverable) carry null, canonical\n+// events carry their object ID.\n+func checkRecordCanonicalRule(owner, disposition string, hasCanonical bool) error {\n+\tif disposition == \"synthesized\" && hasCanonical {\n+\t\treturn invalid(\"%s synthesized carries a source canonical object\", owner)\n+\t}\n+\treturn nil\n+}\n","final_result":true}}}
