t{}, invalid(\\\"digest\\\", \\\"must use the sha256 prefix and exactly 64 digits\\\")\\n\\t}\\n\\tfor index := len(\\\"sha256:\\\"); index < len(value); index++ {\\n\\t\\tif !isLowerHex(value[index]) {\\n\\t\\t\\treturn Digest{}, invalid(\\\"digest\\\", \\\"must contain lowercase hexadecimal digits\\\")\\n\\t\\t}\\n\\t}\\n\\treturn Digest{value: value}, nil\\n}\\n\\nfunc SHA256Digest(value []byte) Digest {\\n\\tsum := sha256.Sum256(value)\\n\\treturn Digest{value: \\\"sha256:\\\" + hex.EncodeToString(sum[:])}\\n}\\n\\nfunc (value Digest) String() string { return value.value }\\nfunc (value Digest) Hex() string    { return strings.TrimPrefix(value.value, \\\"sha256:\\\") }\\n===\\ninternal/hosttrust/authorize.go:190:\\treturn scalar.SHA256Digest(der).String()\\ninternal/hosttrust/trust_decode.go:201:\\tif scalar.SHA256Digest(entry.LeafDER).String() != entry.CredentialID.String() {\\ninternal/hosttrust/trust_decode.go:204:\\tif scalar.SHA256Digest(leaf.RawSubjectPublicKeyInfo).String() != entry.SPKIID.String() {\\ninternal/hosttrust/trust_decode.go:207:\\tif scalar.SHA256Digest(entry.RootDER).String() != entry.RootID.String() {\\ninternal/hosttrust/profile.go:66:\\t\\tLeaf: scalar.SHA256Digest(leafDER).String(),\\ninternal/hosttrust/profile.go:67:\\t\\tSPKI: scalar.SHA256Digest(leaf.RawSubjectPublicKeyInfo).String(),\\ninternal/hosttrust/profile.go:68:\\t\\tRoot: scalar.SHA256Digest(rootDER).String(),\\ninternal/hosttrust/enroll.go:54:\\t\\tCredentialID: scalar.SHA256Digest(input.LeafDER),\\ninternal/hosttrust/enroll.go:55:\\t\\tSPKIID:       scalar.SHA256Digest(mustSPKI(input.LeafDER)),\\ninternal/hosttrust/enroll.go:56:\\t\\tRootID:       scalar.SHA256Digest(input.RootDER),\\n\",\n  \"original_output_bytes\": 4271,\n  \"original_output_tokens\": 1068,\n  \"truncated\": false\n}","final_result":true}}}
