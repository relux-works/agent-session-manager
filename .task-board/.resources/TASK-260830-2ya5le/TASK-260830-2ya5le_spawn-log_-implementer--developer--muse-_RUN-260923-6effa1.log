{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c58d","stream":{"kind":"session","id":"01a0d002-d967-7243-a1ef-6e798194c920"},"sequence":289,"recorded_at":1780531400000573,"record_type":"event","durability":"durable","causation_id":"5f82f9d2-9d92-4e29-bde0-42d341e3fcad","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5f82f9d2-9d92-4e29-bde0-42d341e3fcad","run_stream":{"kind":"run","id":"5f82f9d2-9d92-4e29-bde0-42d341e3fcad"},"task_stream":{"kind":"task","id":"01a0d003-e47e-7813-8d4a-894c4618bc7d"},"task_id":"01a0d003-e47e-7813-8d4a-894c4618bc7d","event":{"kind":"output","task_id":"01a0d003-e47e-7813-8d4a-894c4618bc7d","chunk":"Read text file `internal/clonefidelity/utf8_reflection_test.go`.\n1|package clonefidelity_test\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"errors\"\n6|\t\"reflect\"\n7|\t\"sort\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\t\"unicode/utf8\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n13|\tclonefidelity \"github.com/relux-works/agent-session-manager/internal/clonefidelity\"\n14|)\n15|\n16|// TestUTF8RefusalReflectionGrid pins the class the rev2 reviewer\n17|// found open (finding unmeasured-build-utf8-sites): every\n18|// string-valued member of every shape this leaf builds or decodes\n19|// refuses invalid UTF-8 at both production entries with ErrInvalid\n20|// and a pinned literal detail.\n21|//\n22|// The member set is DERIVED from the Go input types by reflection,\n23|// not typed by hand: a new string field is covered automatically\n24|// (its derived member has no probe, so this test fails naming it),\n25|// and a new field of an unhandled kind fails loudly in the walker,\n26|// so the set can never silently shrink. Decode refuses at the\n27|// delegated strict frame (landed environ owner) before any member\n28|// gate runs, so every decode cell pins the frame literal; planting\n29|// per member proves no member bypasses the frame gate.\n30|func TestUTF8RefusalReflectionGrid(t *testing.T) {\n31|\tmembers := deriveUTF8Members(t)\n32|\tprobes := utf8Probes(t)\n33|\tfor _, member := range members {\n34|\t\tif _, ok := probes[member]; !ok {\n35|\t\t\tt.Fatalf(\"derived member %q has no probe: add a build setter, a decode anchor, and build literals\", member)\n36|\t\t}\n37|\t}\n38|\tfor member := range probes {\n39|\t\tfound := false\n40|\t\tfor _, derived := range members {\n41|\t\t\tif derived == member {\n42|\t\t\t\tfound = true\n43|\t\t\t\tbreak\n44|\t\t\t}\n45|\t\t}\n46|\t\tif !found {\n47|\t\t\tt.Fatalf(\"orphan probe %q matches no derived member: the walker or the probe is stale\", member)\n48|\t\t}\n49|\t}\n50|\tt.Logf(\"derived UTF-8 member set (%d): %s\", len(members), strings.Join(members, \", \"))\n51|\tclasses := []struct {\n52|\t\tname string\n53|\t\traw  []byte\n54|\t}{\n55|\t\t{\"lone-continuation\", []byte{0x80}},\n56|\t\t{\"ff-fe\", []byte{0xff, 0xfe}},\n57|\t\t{\"overlong\", []byte{0xc0, 0xaf}},\n58|\t\t{\"encoded-surrogate\", []byte{0xed, 0xa0, 0x80}},\n59|\t\t{\"truncated-sequence\", []byte{0xe2, 0x82}},\n60|\t}\n61|\tfor _, class := range classes {\n62|\t\tif utf8.Valid(class.raw) {\n63|\t\t\tt.Fatalf(\"class %q is valid UTF-8: the test vector is wrong\", class.name)\n64|\t\t}\n65|\t}\n66|\tsealed := mustBuild(t, utf8BaselineInput(t))\n67|\tfor _, member := range members {\n68|\t\tprobe := probes[member]\n69|\t\tt.Run(member, func(t *testing.T) {\n70|\t\t\tfor _, class := range classes {\n71|\t\t\t\tt.Run(class.name+\"/build\", func(t *testing.T) {\n72|\t\t\t\t\tinput := utf8BaselineInput(t)\n73|\t\t\t\t\tprobe.buildSet(&input, string(class.raw))\n74|\t\t\t\t\t_, err := clonefidelity.BuildFidelityReport(input)\n75|\t\t\t\t\trequireRefusalTokens(t, err, probe.buildLiterals...)\n76|\t\t\t\t})\n77|\t\t\t\tt.Run(class.name+\"/decode\", func(t *testing.T) {\n78|\t\t\t\t\tmutated := spliceUTF8Bytes(t, sealed, probe.anchor, probe.value, class.raw)\n79|\t\t\t\t\t_, err := clonefidelity.DecodeFidelityReport(mutated)\n80|\t\t\t\t\trequireRefusalTokens(t, err, \"fidelity report\", \"not valid UTF-8\", \"(frame)\")\n81|\t\t\t\t})\n82|\t\t\t}\n83|\t\t})\n84|\t}\n85|}\n86|\n87|// TestRegistryPredicatesRefuseInvalidUTF8 pins the remaining public\n88|// entries: the five string-taking registry predicates admit no\n89|// invalid-UTF-8 token (they return false; there is no error to\n90|// carry ErrInvalid through a boolean entry).\n91|func TestRegistryPredicatesRefuseInvalidUTF8(t *testing.T) {\n92|\tbads := []string{\n93|\t\tstring([]byte{0x80}),\n94|\t\tstring([]byte{0xff, 0xfe}),\n95|\t\tstring([]byte{0xc0, 0xaf}),\n96|\t\tstring([]byte{0xed, 0xa0, 0x80}),\n97|\t\tstring([]byte{0xe2, 0x82}),\n98|\t}\n99|\tfor _, bad := range bads {\n100|\t\tif utf8.ValidString(bad) {\n101|\t\t\tt.Fatalf(\"vector %q is valid UTF-8: the test vector is wrong\", bad)\n102|\t\t}\n103|\t\tif clonefidelity.ValidDisposition(bad) {\n104|\t\t\tt.Fatalf(\"ValidDisposition(%q) = true, want false\", bad)\n105|\t\t}\n106|\t\tif clonefidelity.ValidProfile(bad) {\n107|\t\t\tt.Fatalf(\"ValidProfile(%q) = true, want false\", bad)\n108|\t\t}\n109|\t\tif clonefidelity.ValidStrategy(bad) {\n110|\t\t\tt.Fatalf(\"ValidStrategy(%q) = true, want false\", bad)\n111|\t\t}\n112|\t\tif clonefidelity.IsCoreReasonCode(bad) {\n113|\t\t\tt.Fatalf(\"IsCoreReasonCode(%q) = true, want false\", bad)\n114|\t\t}\n115|\t\tif clonefidelity.ValidReasonCode(bad) {\n116|\t\t\tt.Fatalf(\"ValidReasonCode(%q) = true, want false\", bad)\n117|\t\t}\n118|\t}\n119|}\n120|\n121|// TestBuildUTF8ExtensionsNestedDepth pins that the build-side\n122|// extension UTF-8 gate (landed clonebundle owner) fires below the\n123|// top level too: a bad string nested in a map or a slice refuses at\n124|// both extension layers.\n125|func TestBuildUTF8ExtensionsNestedDepth(t *testing.T) {\n126|\tbad := string([]byte{0xff, 0xfe})\n127|\tnested := map[string]any{\"com.example.utf8nested\": map[string]any{\"inner\": bad}}\n128|\tsliced := map[string]any{\"com.example.utf8sliced\": []any{\"ok\", bad}}\n129|\tinput := validTargetInput(validRowInput(\"utf8-nested\", \"exact\"))\n130|\tinput.Extensions = nested\n131|\t_, err := clonefidelity.BuildFidelityReport(input)\n132|\trequireRefusal(t, err, \"not valid UTF-8\")\n133|\tinput = validTargetInput(validRowInput(\"utf8-nested\", \"exact\"))\n134|\tinput.Extensions = sliced\n135|\t_, err = clonefidelity.BuildFidelityReport(input)\n136|\trequireRefusal(t, err, \"not valid UTF-8\")\n137|\trow := validRowInput(\"utf8-nested\", \"exact\")\n138|\trow.Extensions = nested\n139|\t_, err = clonefidelity.BuildFidelityReport(validTargetInput(row))\n140|\trequireRefusal(t, err, \"not valid UTF-8\")\n141|\trow = validRowInput(\"utf8-nested\", \"exact\")\n142|\trow.Extensions = sliced\n143|\t_, err = clonefidelity.BuildFidelityReport(validTargetInput(row))\n144|\trequireRefusal(t, err, \"not valid UTF-8\")\n145|}\n146|\n147|func requireRefusalTokens(t *testing.T, err error, tokens ...string) {\n148|\tt.Helper()\n149|\tif err == nil {\n150|\t\tt.Fatalf(\"error = nil, want refusal containing %q\", tokens)\n151|\t}\n152|\tif !errors.Is(err, clonefidelity.ErrInvalid) {\n153|\t\tt.Fatalf(\"error = %v, want errors.Is ErrInvalid\", err)\n154|\t}\n155|\tfor _, token := range tokens {\n156|\t\tif !strings.Contains(err.Error(), token) {\n157|\t\t\tt.Fatalf(\"error = %q, want literal %q\", err.Error(), token)\n158|\t\t}\n159|\t}\n160|}\n161|\n162|// deriveUTF8Members walks the report input type by reflection and\n163|// returns the sorted set of string-carrying member IDs. The row\n164|// input type is walked standalone too, and its set must equal the\n165|// nested Rows[] set, so the row shape is pinned once. Any field the\n166|// walker cannot classify fails the test: the set grows loudly, it\n167|// never shrinks silently.\n168|func deriveUTF8Members(t *testing.T) []string {\n169|\tt.Helper()\n170|\tvar members []string\n171|\twalkUTF8Fields(t, reflect.TypeOf(clonefidelity.FidelityReportInput{}), \"report\", &members)\n172|\tvar standalone []string\n173|\twalkUTF8Fields(t, reflect.TypeOf(clonefidelity.DispositionRecordInput{}), \"row\", &standalone)\n174|\tnested := map[string]bool{}\n175|\tfor _, member := range members {\n176|\t\tif rest, ok := strings.CutPrefix(member, \"report.Rows[].\"); ok {\n177|\t\t\tnested[rest] = true\n178|\t\t}\n179|\t}\n180|\tif len(standalone) == 0 {\n181|\t\tt.Fatal(\"standalone row walk derived no members\")\n182|\t}\n183|\tfor _, member := range standalone {\n184|\t\trest, _ := strings.CutPrefix(member, \"row.\")\n185|\t\tif !nested[rest] {\n186|\t\t\tt.Fatalf(\"standalone row member %q is missing from the nested Rows[] set\", member)\n187|\t\t}\n188|\t}\n189|\tif len(nested) != len(standalone) {\n190|\t\tt.Fatalf(\"nested row set has %d members, standalone has %d\", len(nested), len(standalone))\n191|\t}\n192|\tsort.Strings(members)\n193|\tseen := map[string]bool{}\n194|\tfor _, member := range members {\n195|\t\tif seen[member] {\n196|\t\t\tt.Fatalf(\"derived member %q twice\", member)\n197|\t\t}\n198|\t\tseen[member] = true\n199|\t}\n200|\tif len(members) == 0 {\n201|\t\tt.Fatal(\"derived UTF-8 member set is empty\")\n202|\t}\n203|\treturn members\n204|}\n205|\n206|func walkUTF8Fields(t *testing.T, typ reflect.Type, path string, out *[]string) {\n207|\tt.Helper()\n208|\tfor index := 0; index < typ.NumField(); index++ {\n209|\t\tfield := typ.Field(index)\n210|\t\twalkUTF8Field(t, field, path+\".\"+field.Name, out)\n211|\t}\n212|}\n213|\n214|func walkUTF8Field(t *testing.T, field reflect.StructField, path string, out *[]string) {\n215|\tt.Helper()\n216|\tif field.PkgPath != \"\" {\n217|\t\tt.Fatalf(\"unexported field at %s: extend the walker before probing it\", path)\n218|\t}\n219|\temit := func(id string) { *out = append(*out, id) }\n220|\tfieldType := field.Type\n221|\tswitch fieldType.Kind() {\n222|\tcase reflect.String:\n223|\t\temit(path)\n224|\tcase reflect.Pointer:\n225|\t\tif fieldType.Elem().Kind() != reflect.String {\n226|\t\t\tt.Fatalf(\"unhandled pointer at %s: extend the walker\", path)\n227|\t\t}\n228|\t\temit(path)\n229|\tcase reflect.Slice, reflect.Array:\n230|\t\telement := fieldType.Elem()\n231|\t\tswitch element.Kind() {\n232|\t\tcase reflect.Uint8:\n233|\t\t\temit(path)\n234|\t\tcase reflect.String:\n235|\t\t\temit(path + \"[]\")\n236|\t\tcase reflect.Struct:\n237|\t\t\tfor index := 0; index < element.NumField(); index++ {\n238|\t\t\t\tsub := element.Field(index)\n239|\t\t\t\twalkUTF8Field(t, sub, path+\"[].\"+sub.Name, out)\n240|\t\t\t}\n241|\t\tdefault:\n242|\t\t\tt.Fatalf(\"unhandled slice element kind %s at %s: extend the walker\", element.Kind(), path)\n243|\t\t}\n244|\tcase reflect.Map:\n245|\t\tif fieldType.Key().Kind() != reflect.String {\n246|\t\t\tt.Fatalf(\"unhandled map key kind %s at %s: extend the walker\", fieldType.Key().Kind(), path)\n247|\t\t}\n248|\t\tvalue := fieldType.Elem()\n249|\t\tswitch value.Kind() {\n250|\t\tcase reflect.Slice:\n251|\t\t\tif value.Elem().Kind() != reflect.String {\n252|\t\t\t\tt.Fatalf(\"unhandled map slice element kind %s at %s: extend the walker\", value.Elem().Kind(), path)\n253|\t\t\t}\n254|\t\t\temit(path + \"<key>\")\n255|\t\t\temit(path + \"[]\")\n256|\t\tcase reflect.Interface:\n257|\t\t\tif value.NumMethod() != 0 {\n258|\t\t\t\tt.Fatalf(\"unhandled map interface at %s: extend the walker\", path)\n259|\t\t\t}\n260|\t\t\temit(path + \"<key>\")\n261|\t\t\temit(path + \"<value>\")\n262|\t\tcase reflect.Struct:\n263|\t\t\temit(path + \"<key>\")\n264|\t\t\tfor index := 0; index < value.NumField(); index++ {\n265|\t\t\t\tsub := value.Field(index)\n266|\t\t\t\twalkUTF8Field(t, sub, path+\"<value>.\"+sub.Name, out)\n267|\t\t\t}\n268|\t\tcase reflect.Uint64:\n269|\t\t\temit(path + \"<key>\")\n270|\t\tdefault:\n271|\t\t\tt.Fatalf(\"unhandled map value kind %s at %s: extend the walker\", value.Kind(), path)\n272|\t\t}\n273|\tcase reflect.Struct:\n274|\t\twalkUTF8Fields(t, fieldType, path, out)\n275|\tcase reflect.Bool,\n276|\t\treflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64,\n277|\t\treflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64,\n278|\t\treflect.Float32, reflect.Float64:\n279|\t\t// Scalar non-text fields carry no strings.\n280|\tdefault:\n281|\t\tt.Fatalf(\"unhandled kind %s at %s: extend the walker\", fieldType.Kind(), path)\n282|\t}\n283|}\n284|\n285|// utf8Probe drives one derived member at both entries: buildSet\n286|// plants the bad string in a fresh baseline input, anchor/value\n287|// locate the sealed bytes to splice for the decode plant, and\n288|// buildLiterals are the member-specific refusal tokens.\n289|type utf8Probe struct {\n290|\tbuildSet      func(input *clonefidelity.FidelityReportInput, bad string)\n291|\tanchor        []byte\n292|\tvalue         []byte\n293|\tbuildLiterals []string\n294|}\n295|\n296|// utf8TupleJSON renders a valid Environment Tuple with the given\n297|// platform. Source uses linux and target uses macos so the decode\n298|// anchors are unique per tuple.\n299|func utf8TupleJSON(platform string) string {\n300|\treturn `{\"environment_id\":\"test.env\",\"environment_version\":\"2.1.0\",\"platform\":\"` +\n301|\t\tplatform + `\",\"architecture\":\"amd64\",\"store_schema_fingerprint\":\"` +\n302|\t\tfixtureDigest(\"fidelity-store-fingerprint\") + `\",\"adapter_version\":\"1.2.3\"}`\n303|}\n304|\n305|// utf8BaselineInput is the valid report every grid cell starts from:\n306|// one semantic row with populated evidence arrays and extensions at\n307|// both layers, distinct tuple platforms, and one attestation, so\n308|// every derived member has bytes to plant.\n309|func utf8BaselineInput(t *testing.T) clonefidelity.FidelityReportInput {\n310|\tt.Helper()\n311|\trow := validRowInput(\"utf8-grid\", \"semantic\", \"unknown_native_event\")\n312|\trow.StagedEvidenceObjectIDs = []string{fixtureDigest(\"staged-utf8-grid\")}\n313|\trow.LiveEvidenceObjectIDs = []string{fixtureDigest(\"li