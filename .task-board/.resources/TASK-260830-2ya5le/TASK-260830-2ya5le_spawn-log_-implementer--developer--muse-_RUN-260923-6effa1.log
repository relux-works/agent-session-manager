ceClass) && input.SourceClass != \\\"\\\\\\\\xff\\\\\\\\xfe\\\" {\\\\n\\\\t\\\\treturn DispositionRecord{}, nil, invalid(\\\"%s source_class is not valid UTF-8\\\", owner)\\\\n\\\\t}''',\\n1045:        note=\\\"Reviewer site 1/3: admits exactly the ff-fe source_class past the pre-marshal gate and seals it.\\\",\\n1050:        find='''\\\\t\\\\tif !validText(*input.TargetLocator) {\\\\n\\\\t\\\\t\\\\treturn DispositionRecord{}, nil, invalid(\\\"%s target_locator is not valid UTF-8\\\", owner)\\\\n\\\\t\\\\t}''',\\n1051:        replace='''\\\\t\\\\tif !validText(*input.TargetLocator) && *input.TargetLocator != \\\"\\\\\\\\xff\\\\\\\\xfe\\\" {\\\\n\\\\t\\\\t\\\\treturn DispositionRecord{}, nil, invalid(\\\"%s target_locator is not valid UTF-8\\\", owner)\\\\n\\\\t\\\\t}''',\\n1055:        note=\\\"Reviewer site 2/3: admits exactly the ff-fe target_locator past the pre-marshal gate and seals it.\\\",\\n1065:        note=\\\"Reviewer site 3/3: admits exactly the ff-fe forbid_reasons item (sole caller) past the pre-marshal gate.\\\",\\n\",\n  \"original_output_bytes\": 1628,\n  \"original_output_tokens\": 407,\n  \"truncated\": false\n}","final_result":true}}}
