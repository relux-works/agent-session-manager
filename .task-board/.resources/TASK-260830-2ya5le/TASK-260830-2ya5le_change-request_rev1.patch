+		"adapter_version":          tuple.AdapterVersion,
+	}
+}
+
+func requiredObject(required map[string][]string) map[string]any {
+	object := make(map[string]any, len(required))
+	for class, values := range required {
+		object[class] = stringValues(values)
+	}
+	return object
+}
