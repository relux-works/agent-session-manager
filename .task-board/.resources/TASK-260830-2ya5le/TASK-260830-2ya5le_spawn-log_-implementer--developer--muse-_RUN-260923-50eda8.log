{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5bd","stream":{"kind":"session","id":"01a0cf67-8ef1-7242-9863-cfd3eed876a3"},"sequence":313,"recorded_at":1780531400000621,"record_type":"event","durability":"durable","causation_id":"697f866a-e541-452f-adbf-d5da32c23417","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"697f866a-e541-452f-adbf-d5da32c23417","run_stream":{"kind":"run","id":"697f866a-e541-452f-adbf-d5da32c23417"},"task_stream":{"kind":"task","id":"01a0cf68-8a96-7e11-8569-5fa08d393cc5"},"task_id":"01a0cf68-8a96-7e11-8569-5fa08d393cc5","event":{"kind":"output","task_id":"01a0cf68-8a96-7e11-8569-5fa08d393cc5","chunk":"Read text file `internal/clonefidelity/report_aggregates_test.go`.\n1|package clonefidelity_test\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\t\"testing\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n9|\tclonefidelity \"github.com/relux-works/agent-session-manager/internal/clonefidelity\"\n10|)\n11|\n12|// Seven-disposition fixture: two exact rows plus one of every other\n13|// disposition, so every count is non-zero and both +1 and -1\n14|// perturbations stay inside uint53.\n15|func sevenDispositionRows() []clonefidelity.DispositionRecordInput {\n16|\treturn []clonefidelity.DispositionRecordInput{\n17|\t\tvalidRowInput(\"agg-exact-1\", \"exact\"),\n18|\t\tvalidRowInput(\"agg-exact-2\", \"exact\"),\n19|\t\tvalidRowInput(\"agg-omitted\", \"omitted\", \"credential_excluded\"),\n20|\t\tvalidRowInput(\"agg-opaque\", \"opaque_preserved\", \"foreign_encrypted_payload\"),\n21|\t\tvalidRowInput(\"agg-semantic\", \"semantic\", \"target_no_equivalent\"),\n22|\t\tvalidRowInput(\"agg-summarized\", \"summarized\", \"source_truncated\", \"target_context_limit\"),\n23|\t\tvalidRowInput(\"agg-unrecoverable\", \"unrecoverable\", \"source_corrupt\"),\n24|\t\tvalidSynthInput(\"agg-synth\"),\n25|\t}\n26|}\n27|\n28|// TestCountsDerived pins the counts derivation with literal values,\n29|// then perturbs every counts cell by +1 and -1: each tampered cell\n30|// refuses with the reconciliation detail naming the disposition.\n31|func TestCountsDerived(t *testing.T) {\n32|\trows := sevenDispositionRows()\n33|\treport := mustDecode(t, mustBuild(t, validTargetInput(rows...)))\n34|\twant := map[string]uint64{\n35|\t\t\"exact\": 2, \"semantic\": 1, \"summarized\": 1, \"opaque_preserved\": 1,\n36|\t\t\"synthesized\": 1, \"omitted\": 1, \"unrecoverable\": 1,\n37|\t}\n38|\tfor disposition, count := range want {\n39|\t\tvar got uint64\n40|\t\tswitch disposition {\n41|\t\tcase \"exact\":\n42|\t\t\tgot = report.Counts.Exact\n43|\t\tcase \"semantic\":\n44|\t\t\tgot = report.Counts.Semantic\n45|\t\tcase \"summarized\":\n46|\t\t\tgot = report.Counts.Summarized\n47|\t\tcase \"opaque_preserved\":\n48|\t\t\tgot = report.Counts.OpaquePreserved\n49|\t\tcase \"synthesized\":\n50|\t\t\tgot = report.Counts.Synthesized\n51|\t\tcase \"omitted\":\n52|\t\t\tgot = report.Counts.Omitted\n53|\t\tcase \"unrecoverable\":\n54|\t\t\tgot = report.Counts.Unrecoverable\n55|\t\t}\n56|\t\tif got != count {\n57|\t\t\tt.Fatalf(\"counts.%s = %d, want %d\", disposition, got, count)\n58|\t\t}\n59|\t}\n60|\tdispositions := []string{\"exact\", \"semantic\", \"summarized\", \"opaque_preserved\", \"synthesized\", \"omitted\", \"unrecoverable\"}\n61|\tsealed := mustBuild(t, validTargetInput(rows...))\n62|\tperturbed := 0\n63|\tfor _, disposition := range dispositions {\n64|\t\tfor _, delta := range []int64{1, -1} {\n65|\t\t\tvar next uint64\n66|\t\t\tif delta < 0 {\n67|\t\t\t\tnext = want[disposition] - 1\n68|\t\t\t} else {\n69|\t\t\t\tnext = want[disposition] + 1\n70|\t\t\t}\n71|\t\t\tmutated := tampered(t, sealed, func(document map[string]any) {\n72|\t\t\t\tdocument[\"counts\"].(map[string]any)[disposition] = next\n73|\t\t\t})\n74|\t\t\t_, err := clonefidelity.DecodeFidelityReport(mutated)\n75|\t\t\trequireRefusal(t, err, \"counts \"+disposition+\" reconciles\")\n76|\t\t\tperturbed++\n77|\t\t}\n78|\t}\n79|\tif perturbed != 14 {\n80|\t\tt.Fatalf(\"perturbed cells = %d, want 14\", perturbed)\n81|\t}\n82|\t// A -1 perturbation on a zero cell refuses at the uint53 gate\n83|\t// instead (documented boundary, still a refusal).\n84|\tsingleSealed := mustBuild(t, validTargetInput(validRowInput(\"single\", \"exact\")))\n85|\tzeroMutated := tampered(t, singleSealed, func(document map[string]any) {\n86|\t\tdocument[\"counts\"].(map[string]any)[\"semantic\"] = -1\n87|\t})\n88|\t_, err := clonefidelity.DecodeFidelityReport(zeroMutated)\n89|\trequireRefusal(t, err, \"counts semantic is not a uint53\")\n90|}\n91|\n92|// TestReasonCountsDerived pins the reason derivation with literal\n93|// occurrence counts (including a reason shared across rows), then\n94|// perturbs every reason cell by +1 and -1 and adds extra/missing\n95|// key cases: each refuses with the reconciliation detail.\n96|func TestReasonCountsDerived(t *testing.T) {\n97|\trows := []clonefidelity.DispositionRecordInput{\n98|\t\tvalidRowInput(\"rc-1\", \"semantic\", \"unknown_native_event\"),\n99|\t\tvalidRowInput(\"rc-2\", \"summarized\", \"target_context_limit\", \"unknown_native_event\"),\n100|\t\tvalidRowInput(\"rc-3\", \"omitted\", \"credential_excluded\"),\n101|\t\tvalidRowInput(\"rc-4\", \"exact\"),\n102|\t}\n103|\treport := mustDecode(t, mustBuild(t, validTargetInput(rows...)))\n104|\twant := map[string]uint64{\n105|\t\t\"unknown_native_event\": 2, \"target_context_limit\": 1, \"credential_excluded\": 1,\n106|\t}\n107|\tif len(report.ReasonCounts) != len(want) {\n108|\t\tt.Fatalf(\"reason_counts keys = %d, want %d\", len(report.ReasonCounts), len(want))\n109|\t}\n110|\tfor reason, count := range want {\n111|\t\tif report.ReasonCounts[reason] != count {\n112|\t\t\tt.Fatalf(\"reason_counts[%q] = %d, want %d\", reason, report.ReasonCounts[reason], count)\n113|\t\t}\n114|\t}\n115|\tsealed := mustBuild(t, validTargetInput(rows...))\n116|\tperturbed := 0\n117|\tfor reason, count := range want {\n118|\t\tfor _, delta := range []int64{1, -1} {\n119|\t\t\tvar next uint64\n120|\t\t\tif delta < 0 {\n121|\t\t\t\tnext = count - 1\n122|\t\t\t} else {\n123|\t\t\t\tnext = count + 1\n124|\t\t\t}\n125|\t\t\tmutated := tampered(t, sealed, func(document map[string]any) {\n126|\t\t\t\tdocument[\"reason_counts\"].(map[string]any)[reason] = next\n127|\t\t\t})\n128|\t\t\t_, err := clonefidelity.DecodeFidelityReport(mutated)\n129|\t\t\trequireRefusal(t, err, \"reason_counts\")\n130|\t\t\tperturbed++\n131|\t\t}\n132|\t}\n133|\t// Extra key and missing key refuse.\n134|\tmutated := tampered(t, sealed, func(document map[string]any) {\n135|\t\tdocument[\"reason_counts\"].(map[string]any)[\"frobnicate\"] = 1\n136|\t})\n137|\t_, err := clonefidelity.DecodeFidelityReport(mutated)\n138|\trequireRefusal(t, err, `reason_counts \"frobnicate\" reconciles`)\n139|\tmutated = tampered(t, sealed, func(document map[string]any) {\n140|\t\tdelete(document[\"reason_counts\"].(map[string]any), \"credential_excluded\")\n141|\t})\n142|\t_, err = clonefidelity.DecodeFidelityReport(mutated)\n143|\trequireRefusal(t, err, `reason_counts miss reason \"credential_excluded\"`)\n144|\t// A zero value refuses at the shape gate (uint53 above zero).\n145|\tmutated = tampered(t, sealed, func(document map[string]any) {\n146|\t\tdocument[\"reason_counts\"].(map[string]any)[\"credential_excluded\"] = 0\n147|\t})\n148|\t_, err = clonefidelity.DecodeFidelityReport(mutated)\n149|\trequireRefusal(t, err, `reason_counts[\"credential_excluded\"] is not a uint53 above zero`)\n150|\tif perturbed != 6 {\n151|\t\tt.Fatalf(\"perturbed cells = %d, want 6\", perturbed)\n152|\t}\n153|}\n154|\n155|// TestEventKindBreakdown pins the closed 26-kind map: every kind key\n156|// is required, no other key admits, and every one of the 182 cells\n157|// reconciles — a +1 perturbation in any single cell refuses, as\n158|// does a -1 on every non-zero cell.\n159|func TestEventKindBreakdown(t *testing.T) {\n160|\tkinds := []string{\n161|\t\t\"session_started\", \"instruction_snapshot\", \"user_message\",\n162|\t\t\"assistant_message\", \"reasoning_summary\", \"opaque_reasoning\",\n163|\t\t\"tool_definition_snapshot\", \"tool_call\", \"tool_result\",\n164|\t\t\"approval_request\", \"approval_response\", \"plan_update\",\n165|\t\t\"progress\", \"usage\", \"rate_limit\", \"file_change\",\n166|\t\t\"compaction\", \"turn_started\", \"turn_completed\", \"turn_aborted\",\n167|\t\t\"subagent_started\", \"subagent_completed\", \"error\",\n168|\t\t\"migration_checkpoint\", \"session_finished\", \"opaque_event\",\n169|\t}\n170|\tif len(kinds) != 26 {\n171|\t\tt.Fatalf(\"oracle kind count = %d, want 26\", len(kinds))\n172|\t}\n173|\trows := sevenDispositionRows()\n174|\tsealed := mustBuild(t, validTargetInput(rows...))\n175|\treport := mustDecode(t, sealed)\n176|\tif len(report.EventKindCounts) != 26 {\n177|\t\tt.Fatalf(\"event_kind_counts keys = %d, want 26\", len(report.EventKindCounts))\n178|\t}\n179|\tdispositions := []string{\"exact\", \"semantic\", \"summarized\", \"opaque_preserved\", \"synthesized\", \"omitted\", \"unrecoverable\"}\n180|\t// Concentrated fixture: every row sits on the first kind, so all\n181|\t// other cells are zero.\n182|\tfirst := kinds[0]\n183|\tconcentrated := report.EventKindCounts[first]\n184|\tif concentrated.Exact != 2 || concentrated.Semantic != 1 || concentrated.Unrecoverable != 1 {\n185|\t\tt.Fatalf(\"concentrated kind = %+v, want the row totals\", concentrated)\n186|\t}\n187|\tperturbed := 0\n188|\tfor _, kind := range kinds {\n189|\t\tfor _, disposition := range dispositions {\n190|\t\t\tmutated := tampered(t, sealed, func(document map[string]any) {\n191|\t\t\t\tcell := document[\"event_kind_counts\"].(map[string]any)[kind].(map[string]any)\n192|\t\t\t\tcell[disposition] = cellValue(cell[disposition]) + 1\n193|\t\t\t})\n194|\t\t\t_, err := clonefidelity.DecodeFidelityReport(mutated)\n195|\t\t\trequireRefusal(t, err, \"event_kind_counts reconciles\")\n196|\t\t\tperturbed++\n197|\t\t}\n198|\t}\n199|\tif perturbed != 182 {\n200|\t\tt.Fatalf(\"perturbed cells = %d, want 182\", perturbed)\n201|\t}\n202|\t// -1 on the seven non-zero cells refuses as well.\n203|\tfor _, disposition := range dispositions {\n204|\t\tmutated := tampered(t, sealed, func(document map[string]any) {\n205|\t\t\tcell := document[\"event_kind_counts\"].(map[string]any)[first].(map[string]any)\n206|\t\t\tcell[disposition] = cellValue(cell[disposition]) - 1\n207|\t\t})\n208|\t\t_, err := clonefidelity.DecodeFidelityReport(mutated)\n209|\t\trequireRefusal(t, err, \"event_kind_counts reconciles\")\n210|\t}\n211|\t// Closed keys: a 27th key and a missing key refuse.\n212|\tmutated := tampered(t, sealed, func(document map[string]any) {\n213|\t\tdocument[\"event_kind_counts\"].(map[string]any)[\"frobnicate\"] = map[string]any{}\n214|\t})\n215|\t_, err := clonefidelity.DecodeFidelityReport(mutated)\n216|\trequireRefusal(t, err, `event_kind_counts carry unknown key \"frobnicate\"`)\n217|\tmutated = tampered(t, sealed, func(document map[string]any) {\n218|\t\tdelete(document[\"event_kind_counts\"].(map[string]any), \"usage\")\n219|\t})\n220|\t_, err = clonefidelity.DecodeFidelityReport(mutated)\n221|\trequireRefusal(t, err, `event_kind_counts miss key \"usage\"`)\n222|\t// A malformed cell refuses naming the key.\n223|\tmutated = tampered(t, sealed, func(document map[string]any) {\n224|\t\tdocument[\"event_kind_counts\"].(map[string]any)[\"usage\"].(map[string]any)[\"exact\"] = \"seven\"\n225|\t})\n226|\t_, err = clonefidelity.DecodeFidelityReport(mutated)\n227|\trequireRefusal(t, err, `event_kind_counts[\"usage\"] exact is not a uint53`)\n228|\t// A cell missing a member refuses naming the key and member.\n229|\tmutated = tampered(t, sealed, func(document map[string]any) {\n230|\t\tdelete(document[\"event_kind_counts\"].(map[string]any)[\"usage\"].(map[string]any), \"exact\")\n231|\t})\n232|\t_, err = clonefidelity.DecodeFidelityReport(mutated)\n233|\trequireRefusal(t, err, `event_kind_counts[\"usage\"] misses a required member \"exact\"`)\n234|\t// A cell with an unknown member refuses naming the key.\n235|\tmutated = tampered(t, sealed, func(document map[string]any) {\n236|\t\tdocument[\"event_kind_counts\"].(map[string]any)[\"usage\"].(map[string]any)[\"frobnicate\"] = 1\n237|\t})\n238|\t_, err = clonefidelity.DecodeFidelityReport(mutated)\n239|\trequireRefusal(t, err, `event_kind_counts[\"usage\"] carries unknown member \"frobnicate\"`)\n240|\t// Build side: missing key, extra key, and a +1 cell refuse.\n241|\tinput := validTargetInput(rows...)\n242|\tdelete(input.EventKindCounts, \"usage\")\n243|\t_, err = clonefidelity.BuildFidelityReport(input)\n244|\trequireRefusal(t, err, `event_kind_counts miss key \"usage\"`)\n245|\tinput = validTargetInput(rows...)\n246|\tinput.EventKindCounts[\"frobnicate\"] = clonefidelity.FidelityCounts{}\n247|\t_, err = clonefidelity.BuildFidelityReport(input)\n248|\trequireRefusal(t, err, `event_kind_counts carry unknown key \"frobnicate\"`)\n249|\tinput = validTargetInput(rows...)\n250|\tbumped := input.EventKindCounts[first]\n251|\tbumped.Exact++\n252|\tinput.EventKindCounts[first] = bumped\n253|\t_, err = clonefidelity.BuildFidelityReport(input)\n254|\trequireRefusal(t, err, \"event_kind_counts reconciles\")\n255|\t// Build side refuses a breakdown value above uint53.\n256|\tinput = validTargetInput(rows...)\n257|\tbig := input.EventKindCounts[first]\n258|\tbig.Exact = 1 << 53\n259|\tinput.EventKindCounts[first] = big\n260|\t_, err = clonefidelity.BuildFidelityReport(input)\n261|\trequireRefusal(t, err, \"exceeds uint53\")\n262|}\n263|\n264|// TestContentBlockBreakdown pins the closed 8-type map the same way:\n265|// exact keys, and a +1 perturbation in any of the 56 cells refuses,\n266|// as does a -1 on every non-zero cell.\n267|func TestContentBlockBreakdown(t *testing.T) {\n268|\ttypes := []string{\"text\", \"json\", \"image\", \"audio\", \"document\", \"resource_link\", \"redacted\", \"opaque\"}\n269|\tif len(types) != 8 {\n270|\t\tt.Fatalf(\"oracle type count = %d, want 8\", len(types))\n271|\t}\n272|\trows := sevenDispositionRows()\n273|\tsealed := mustBuild(t, validTargetInput(rows...))\n274|\treport := mustDecode(t, sealed)\n275|\tif len(report.ContentBlockCounts) != 8 {\n276|\t\tt.Fatalf(\"content_block_counts keys = %d, want 8\", len(report.ContentBlockCounts))\n277|\t}\n278|\tdispositions := []string{\"exact\", \"semantic\", \"summarized\", \"opaque_preserved\", \"synthesized\", \"omitted\", \"unrecoverable\"}\n279|\tfirst := types[0]\n280|\tperturbed := 0\n281|\tfor _, block := range types {\n282|\t\tfor _, disposition := range dispositions {\n283|\t\t\tmutated := tampered(t, sealed, func(document map[string]any) {\n284|\t\t\t\tcell := document[\"content_block_counts\"].(map[string]any)[block].(map[string]any)\n285|\t\t\t\tcell[disposition] = cellValue(cell[disposition]) + 1\n286|\t\t\t})\n287|\t\t\t_, err := clonefidelity.DecodeFidelityReport(mutated)\n288|\t\t\trequireRefusal(t, err, \"content_block_counts reconciles\")\n289|\t\t\tperturbed++\n290|\t\t}\n291|\t}\n292|\tif perturbed != 56 {\n293|\t\tt.Fatalf(\"perturbed cells = %d, want 56\", perturbed)\n294|\t}\n295|\tfor _, disposition := range dispositions {\n296|\t\tmutated := tampered(t, sealed, func(document map[string]any) {\n297|\t\t\tcell := document[\"content_block_counts\"].(map[string]any)[first].(map[string]any)\n298|\t\t\tcell[disposition] = cellValue(cell[disposition]) - 1\n299|\t\t})\n300|\t\t_, err := clonefidelity.DecodeFidelityReport(mutated)\n301|\t\trequireRefusal(t, err, \"content_block_counts reconciles\")\n302|\t}\n303|\tmutated := tampered(t, sealed, func(document map[string]any) {\n304|\t\tdocument[\"content_block_counts\"].(map[string]any)[\"frobnicate\"] = map[string]any{}\n305|\t})\n306|\t_, err := clonefidelity.DecodeFidelityReport(mutated)\n307|\trequireRefusal(t, err, `content_block_counts carry unknown key \"frobnicate\"`)\n308|\tmutated = tampered(t, sealed, func(document map[string]any) {\n309|\t\tdelete(document[\"content_block_counts\"].(map[string]any), \"text\")\n310|\t})\n311|\t_, err = clonefidelity.DecodeFidelityReport(mutated)\n312|\trequireRefusal(t, err, `content_block_counts miss key \"text\"`)\n313|\tinput := validTargetInput(rows...)\n314|\tbumped := input.ContentBlockCounts[first]\n315|\tbumped.Semantic++\n316|\tinput.ContentBlockCounts[first] = bumped\n317|\t_, err = clonefidelity.BuildFidelityReport(input)\n318|\trequireRefusal(t, err, \"content_block_counts reconciles\")\n319|}\n320|\n321|// TestByteCounts pins the closed seven-disposition byte map: exact\n322|// keys with uint53 values. Values admit any uint53 — rows carry no\n323|// byte measure, so no row reconciliation is expressible (a stated\n324|// bound, proven here by two reports over identical rows with\n325|// different byte values both admitting).\n326|func TestByteCounts(t *testing.T) {\n327|\trows := sevenDispositionRows()\n328|\tinput := validTargetInput(rows...)\n329|\tinput.ByteCounts = map[string]uint64{\n330|\t\t\"exact\": 100, \"semantic\": 200, \"summarized\": 300, \"opaque_preserved\": 400,\n331|\t\t\"synthesized\": 500, \"omitted\": 600, \"unrecoverable\": 9007199254740991,\n332|\t}\n333|\treport := mustDecode(t, mustBuild(t, input))\n334|\tif report.ByteCounts[\"unrecoverable\"] != 9007199254740991 || report.ByteCounts[\"exact\"] != 100 {\n335|\t\tt.Fatalf(\"byte_counts = %v, want the caller values kept\", report.ByteCounts)\n336|\t}\n337|\t// Same rows, different bytes: still admits (the stated bound).\n338|\tinput.ByteCounts[\"exact\"] = 101\n339|\tmustDecode(t, mustBuild(t, input))\n340|\tsealed := mustBuild(t, validTargetInput(rows...))\n341|\tmutated := tampered(t, sealed, func(document map[string]any) {\n342|\t\tdocument[\"byte_counts\"].(map[string]any)[\"frobnicate\"] = 1\n343|\t})\n344|\t_, err := clonefidelity.DecodeFidelityReport(mutated)\n345|\trequireRefusal(t, err, `byte_counts carry unknown disposition \"frobnicate\"`)\n346|\tmutated = tampered(t, sealed, func(document map[string]any) {\n347|\t\tdelete(document[\"byte_counts\"].(map[string]any), \"exact\")\n348|\t})\n349|\t_, err = clonefidelity.DecodeFidelityReport(mutated)\n350|\trequireRefusal(t, err, `byte_counts miss disposition \"exact\"`)\n351|\tbadValues := map[string]any{\n352|\t\t\"above_uint53\": 9007199254740992, \"float\": 1.5, \"negative\": -1,\n353|\t\t\"string\": \"100\", \"bool\": true, \"null\": nil,\n354|\t}\n355|\tfor name, value := range badValues {\n356|\t\tt.Run(\"decode/\"+name, func(t *testing.T) {\n357|\t\t\tmutated := tampered(t, sealed, func(document map[string]any) {\n358|\t\t\t\tdocument[\"byte_counts\"].(map[string]any)[\"exact\"] = value\n359|\t\t\t})\n360|\t\t\t_, err := clonefidelity.DecodeFidelityReport(mutated)\n361|\t\t\trequireRefusal(t, err, `byte_counts[\"exact\"] is not a uint53`)\n362|\t\t})\n363|\t}\n364|\t// Build side: missing key, extra key, and above-uint53 refuse.\n365|\tbuild := validTargetInput(rows...)\n366|\tdelete(build.ByteCounts, \"exact\")\n367|\t_, err = clonefidelity.BuildFidelityReport(build)\n368|\trequireRefusal(t, err, `byte_counts miss disposition \"exact\"`)\n369|\tbuild = validTargetInput(rows...)\n370|\tbuild.ByteCounts[\"frobnicate\"] = 1\n371|\t_, err = clonefidelity.BuildFidelityReport(build)\n372|\trequireRefusal(t, err, `byte_counts carry unknown disposition \"frobnicate\"`)\n373|\tbuild = validTargetInput(rows...)\n374|\tbuild.ByteCounts[\"exact\"] = 1 << 53\n375|\t_, err = clonefidelity.BuildFidelityReport(build)\n376|\trequireRefusal(t, err, `byte_counts[\"exact\"] exceeds uint53`)\n377|}\n378|\n379|// TestSpreadBreakdownAdmits proves the breakdown reconciliation is a\n380|// sum, not a shape: the same totals spread over several keys admit\n381|// at both entries.\n382|func TestSpreadBreakdownAdmits(t *testing.T) {\n383|\trows := sevenDispositionRows()\n384|\tinput := validTargetInput(rows...)\n385|\tspread := map[string]clonefidelity.FidelityCounts{}\n386|\tfor _, kind := range clonebundle.EventKinds() {\n387|\t\tspread[kind] = clonefidelity.FidelityCounts{}\n388|\t}\n389|\tspread[\"user_message\"] = clonefidelity.FidelityCounts{Exact: 1, Semantic: 1}\n390|\tspread[\"assistant_message\"] = clonefidelity.FidelityCounts{Exact: 1, Summarized: 1}\n391|\tspread[\"usage\"] = clonefidelity.FidelityCounts{OpaquePreserved: 1, Synthesized: 1, Omitted: 1, Unrecoverable: 1}\n392|\tinput.EventKindCounts = spread\n393|\treport := mustDecode(t, mustBuild(t, input))\n394|\tif report.EventKindCounts[\"usage\"].Omitted != 1 {\n395|\t\tt.Fatalf(\"spread breakdown did not survive: %+v\", report.EventKindCounts[\"usage\"])\n396|\t}\n397|}\n398|\n399|// cellValue reads a tampered-document number cell as uint64.\n400|// Tampered documents decode with UseNumber, so every cell is a\n401|// json.Number literal.\n402|func cellValue(value any) uint64 {\n403|\tnumber, ok := value.(json.Number)\n404|\tif !ok {\n405|\t\tpanic(fmt.Sprintf(\"unexpected cell type %T\", value))\n406|\t}\n407|\tinteger, err := number.Int64()\n408|\tif err != nil {\n409|\t\tpanic(fmt.Sprintf(\"cell %q is not an integer: %v\", number.String(), err))\n410|\t}\n411|\treturn uint64(integer)\n412|}","final_result":true}}}
