{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c79f","stream":{"kind":"session","id":"01a0cfdc-90e4-7130-b73f-3760c218f2ff"},"sequence":554,"recorded_at":1780531400001103,"record_type":"event","durability":"durable","causation_id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5","run_stream":{"kind":"run","id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5"},"task_stream":{"kind":"task","id":"01a0cfde-0fd5-7e80-bab8-a0fdca404668"},"task_id":"01a0cfde-0fd5-7e80-bab8-a0fdca404668","event":{"kind":"output","task_id":"01a0cfde-0fd5-7e80-bab8-a0fdca404668","chunk":"Read text file `internal/environ/decode.go`.\n1|package environ\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"fmt\"\n7|\t\"io\"\n8|\t\"regexp\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"unicode/utf8\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|)\n15|\n16|// maxUint53 is the largest exactly representable JSON integer:\n17|// counts and limits are uint53 throughout the pinned\n18|// specification.\n19|const maxUint53 = uint64(1<<53 - 1)\n20|\n21|// Fault is one strict-decode failure: what was wrong and which\n22|// member it was found in, if any. It never carries foreign bytes.\n23|// The five details are the complete fault space: every body this\n24|// package refuses at the frame layer carries exactly one of them,\n25|// and the frame-agreement battery derives its denominator from\n26|// this list, so a sixth fault shape fails the census instead of\n27|// passing silently.\n28|type Fault struct {\n29|\tDetail string\n30|\tMember string\n31|}\n32|\n33|func (fault *Fault) Error() string {\n34|\tif fault.Member == \"\" {\n35|\t\treturn \"environment frame \" + fault.Detail\n36|\t}\n37|\treturn \"environment frame \" + fault.Detail + \" in member \" + fault.Member\n38|}\n39|\n40|// Frame fault details. Each is a constant so the agreement battery\n41|// derives the fault space from production source instead of\n42|// retyping it: a reworded fault fails its row rather than passing\n43|// against a stale copy.\n44|const (\n45|\tFaultNotUTF8       = \"not valid UTF-8\"\n46|\tFaultLoneSurrogate = \"lone surrogate escape\"\n47|\tFaultNotObject     = \"not a JSON object\"\n48|\tFaultDuplicate     = \"duplicate member\"\n49|\tFaultTrailing      = \"trailing data after the object\"\n50|)\n51|\n52|// DecodeStrictObject parses one complete JSON object with\n53|// duplicate member rejection. It is the only JSON entry point in\n54|// this package: every body crosses it before any member is read.\n55|// A non-UTF-8 frame, a lone surrogate escape, a non-object top\n56|// level, a duplicated member, or trailing data is a fault, never\n57|// a partial object the caller could mistake for a result.\n58|func DecodeStrictObject(data []byte) (map[string]json.RawMessage, *Fault) {\n59|\tif !utf8.Valid(data) {\n60|\t\treturn nil, &Fault{Detail: FaultNotUTF8}\n61|\t}\n62|\tif HasLoneSurrogateEscape(data) {\n63|\t\treturn nil, &Fault{Detail: FaultLoneSurrogate}\n64|\t}\n65|\tdecoder := json.NewDecoder(bytes.NewReader(data))\n66|\ttoken, err := decoder.Token()\n67|\tif err != nil {\n68|\t\treturn nil, &Fault{Detail: FaultNotObject}\n69|\t}\n70|\tdelim, ok := token.(json.Delim)\n71|\tif !ok || delim != '{' {\n72|\t\treturn nil, &Fault{Detail: FaultNotObject}\n73|\t}\n74|\tmembers := map[string]json.RawMessage{}\n75|\tfor decoder.More() {\n76|\t\tkeyToken, err := decoder.Token()\n77|\t\tif err != nil {\n78|\t\t\treturn nil, &Fault{Detail: FaultNotObject}\n79|\t\t}\n80|\t\tkey, ok := keyToken.(string)\n81|\t\tif !ok {\n82|\t\t\treturn nil, &Fault{Detail: FaultNotObject}\n83|\t\t}\n84|\t\tif _, duplicate := members[key]; duplicate {\n85|\t\t\treturn nil, &Fault{Detail: FaultDuplicate, Member: key}\n86|\t\t}\n87|\t\tvar raw json.RawMessage\n88|\t\tif err := decoder.Decode(&raw); err != nil {\n89|\t\t\treturn nil, &Fault{Detail: FaultNotObject, Member: key}\n90|\t\t}\n91|\t\tmembers[key] = raw\n92|\t}\n93|\tif token, err := decoder.Token(); err != nil {\n94|\t\treturn nil, &Fault{Detail: FaultNotObject}\n95|\t} else if delim, ok := token.(json.Delim); !ok || delim != '}' {\n96|\t\treturn nil, &Fault{Detail: FaultNotObject}\n97|\t}\n98|\tif _, err := decoder.Token(); err != io.EOF {\n99|\t\treturn nil, &Fault{Detail: FaultTrailing}\n100|\t}\n101|\treturn members, nil\n102|}\n103|\n104|// HasLoneSurrogateEscape reports whether the raw frame carries a\n105|// UTF-16 escape the JSON string grammar cannot pair. Go's\n106|// encoding/json would otherwise replace the lone escape with\n107|// U+FFFD silently, so wire bodies carrying lone surrogates would\n108|// be admitted with rewritten bytes.\n109|//\n110|// The walk is string-aware: only escapes inside JSON strings\n111|// count, and a backslash escape consumes both bytes, so the text\n112|// \"\\\\ud800\" (backslash-plus-text, JSON source `\"\\\\ud800\"`) is\n113|// not an escape and is admitted at the frame gate. A scanner\n114|// that matches every `\\u` byte pair regardless of string context\n115|// refuses that text, and worse, misreads it as a high surrogate\n116|// paired with a following real escape — admitting a real lone\n117|// escape the string walk refuses. The sessadapter and dirnode\n118|// facades once carried that raw scan and diverged in both\n119|// directions; they now delegate their frame verdict to\n120|// DecodeStrictObject, and the frame-agreement battery proves\n121|// both directions with run-parity rows plus even-run-plus-real-\n122|// escape compositions, so any change to this walk fails there in\n123|// either direction.\n124|func HasLoneSurrogateEscape(data []byte) bool {\n125|\tfor index := 0; index < len(data); index++ {\n126|\t\tif data[index] != '\"' {\n127|\t\t\tcontinue\n128|\t\t}\n129|\t\tfor index++; index < len(data); index++ {\n130|\t\t\tswitch data[index] {\n131|\t\t\tcase '\"':\n132|\t\t\t\tgoto stringComplete\n133|\t\t\tcase '\\\\':\n134|\t\t\t\tindex++\n135|\t\t\t\tif index >= len(data) || data[index] != 'u' {\n136|\t\t\t\t\tcontinue\n137|\t\t\t\t}\n138|\t\t\t\tunit, end, ok := readUTF16Escape(data, index-1)\n139|\t\t\t\tif !ok {\n140|\t\t\t\t\t// Not a well-formed \\uXXXX escape: the\n141|\t\t\t\t\t// JSON-syntax arms own it, not this gate.\n142|\t\t\t\t\tcontinue\n143|\t\t\t\t}\n144|\t\t\t\tindex = end - 1\n145|\t\t\t\tswitch {\n146|\t\t\t\tcase unit >= 0xd800 && unit <= 0xdbff:\n147|\t\t\t\t\tsecond, _, ok := readUTF16Escape(data, end)\n148|\t\t\t\t\tif !ok || second < 0xdc00 || second > 0xdfff {\n149|\t\t\t\t\t\treturn true\n150|\t\t\t\t\t}\n151|\t\t\t\t\tindex = end + 6 - 1\n152|\t\t\t\tcase unit >= 0xdc00 && unit <= 0xdfff:\n153|\t\t\t\t\treturn true\n154|\t\t\t\t}\n155|\t\t\t}\n156|\t\t}\n157|\t\t// An unterminated string owns no surrogate verdict: the\n158|\t\t// frame is not JSON at all, so the syntax arms refuse it\n159|\t\t// as not-a-JSON-object rather than misattributing it\n160|\t\t// here.\n161|\t\treturn false\n162|\tstringComplete:\n163|\t}\n164|\treturn false\n165|}\n166|\n167|// readUTF16Escape reads one \\uXXXX escape starting at the offset.\n168|// It reports the unit value and the offset just past the escape,\n169|// or false when the escape is truncated or not hexadecimal.\n170|func readUTF16Escape(data []byte, offset int) (uint16, int, bool) {\n171|\tif offset+6 > len(data) || data[offset] != '\\\\' || data[offset+1] != 'u' {\n172|\t\treturn 0, offset, false\n173|\t}\n174|\tvalue, err := strconv.ParseUint(string(data[offset+2:offset+6]), 16, 16)\n175|\tif err != nil {\n176|\t\treturn 0, offset, false\n177|\t}\n178|\treturn uint16(value), offset + 6, true\n179|}\n180|\n181|// unknownMember names a member outside the closed set, if any.\n182|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n183|\tfor name := range members {\n184|\t\tif !allowed[name] {\n185|\t\t\treturn name, true\n186|\t\t}\n187|\t}\n188|\treturn \"\", false\n189|}\n190|\n191|// missingMember names the first required member with no value, if\n192|// any. The required list is fixed order, so the verdict is\n193|// deterministic for every missing combination.\n194|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n195|\tfor _, name := range required {\n196|\t\tif _, present := members[name]; !present {\n197|\t\t\treturn name, true\n198|\t\t}\n199|\t}\n200|\treturn \"\", false\n201|}\n202|\n203|// rawString reads a JSON string member.\n204|func rawString(raw json.RawMessage) (string, bool) {\n205|\tvar value string\n206|\tif err := json.Unmarshal(raw, &value); err != nil {\n207|\t\treturn \"\", false\n208|\t}\n209|\treturn value, true\n210|}\n211|\n212|// rawUint53 reads an unsigned integral JSON number in [0,\n213|// 2^53-1]. A fraction, exponent, sign, or out-of-range magnitude\n214|// is not a uint53, even when it names the same mathematical\n215|// value: the bodies carry counts, never measurements.\n216|func rawUint53(raw json.RawMessage) (uint64, bool) {\n217|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n218|\tdecoder.UseNumber()\n219|\tvar value any\n220|\tif err := decoder.Decode(&value); err != nil {\n221|\t\treturn 0, false\n222|\t}\n223|\t// Decode reads one value and stops: without the trailing\n224|\t// check a hostile slice like `12a` would read as 12. Member\n225|\t// slices arriving through DecodeStrictObject can never carry\n226|\t// trailing data, but this entry takes raw slices and must\n227|\t// not trust them.\n228|\tif _, err := decoder.Token(); err != io.EOF {\n229|\t\treturn 0, false\n230|\t}\n231|\tnumber, ok := value.(json.Number)\n232|\tif !ok {\n233|\t\treturn 0, false\n234|\t}\n235|\tliteral := number.String()\n236|\tif literal == \"\" || strings.ContainsAny(literal, \".eE+-\") {\n237|\t\treturn 0, false\n238|\t}\n239|\treturn parseUint53Literal(literal)\n240|}\n241|\n242|// parseUint53Literal reads a digit-only literal without trusting\n243|// a float conversion: the magnitude bound is checked on the digit\n244|// string, so 2^53 is refused even on platforms that could hold\n245|// it.\n246|func parseUint53Literal(literal string) (uint64, bool) {\n247|\tif literal == \"\" {\n248|\t\treturn 0, false\n249|\t}\n250|\tvar value uint64\n251|\tfor index := 0; index < len(literal); index++ {\n252|\t\tdigit := literal[index]\n253|\t\tif digit < '0' || digit > '9' {\n254|\t\t\treturn 0, false\n255|\t\t}\n256|\t\tvalue = value*10 + uint64(digit-'0')\n257|\t\tif value > maxUint53 {\n258|\t\t\treturn 0, false\n259|\t\t}\n260|\t}\n261|\treturn value, true\n262|}\n263|\n264|// StringLength is the Section 1.6 string measure in characters,\n265|// not bytes: a bound of string[1..128] admits 128 characters of\n266|// any width. Byte-counted exec rules (Provider SpawnPlan argv and\n267|// env literals, Section 5.1) do not go through here; the measure\n268|// battery ledgers that split.\n269|func StringLength(value string) int {\n270|\treturn utf8.RuneCountInString(value)\n271|}\n272|\n273|// CheckStringBounds reports whether the member is a JSON string\n274|// whose character count falls in the inclusive bound.\n275|func CheckStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n276|\tvalue, ok := rawString(raw)\n277|\tif !ok {\n278|\t\treturn \"\", false\n279|\t}\n280|\tlength := StringLength(value)\n281|\tif length < minimum || length > maximum {\n282|\t\treturn \"\", false\n283|\t}\n284|\treturn value, true\n285|}\n286|\n287|// CheckUint53Bounds reports whether the member is a uint53 in the\n288|// inclusive bound. Both edges are checked: a one-sided check\n289|// would admit the open side.\n290|func CheckUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n291|\tvalue, ok := rawUint53(raw)\n292|\tif !ok {\n293|\t\treturn 0, false\n294|\t}\n295|\tif value < minimum || value > maximum {\n296|\t\treturn 0, false\n297|\t}\n298|\treturn value, true\n299|}\n300|\n301|// CheckDigest reports whether the member is a digest of the\n302|// pinned sha256 form.\n303|func CheckDigest(raw json.RawMessage) (scalar.Digest, bool) {\n304|\tvalue, ok := rawString(raw)\n305|\tif !ok {\n306|\t\treturn scalar.Digest{}, false\n307|\t}\n308|\tdigest, err := scalar.ParseDigest(value)\n309|\tif err != nil {\n310|\t\treturn scalar.Digest{}, false\n311|\t}\n312|\treturn digest, true\n313|}\n314|\n315|// CheckUUIDv7 reports whether the member is a lowercase UUIDv7.\n316|func CheckUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n317|\tvalue, ok := rawString(raw)\n318|\tif !ok {\n319|\t\treturn scalar.UUIDv7{}, false\n320|\t}\n321|\tidentifier, err := scalar.ParseUUIDv7(value)\n322|\tif err != nil {\n323|\t\treturn scalar.UUIDv7{}, false\n324|\t}\n325|\treturn identifier, true\n326|}\n327|\n328|// CheckTimestamp reports whether the member is a pinned\n329|// timestamp.\n330|func CheckTimestamp(raw json.RawMessage) (scalar.Timestamp, bool) {\n331|\tvalue, ok := rawString(raw)\n332|\tif !ok {\n333|\t\treturn scalar.Timestamp{}, false\n334|\t}\n335|\tinstant, err := scalar.ParseTimestamp(value)\n336|\tif err != nil {\n337|\t\treturn scalar.Timestamp{}, false\n338|\t}\n339|\treturn instant, true\n340|}\n341|\n342|// isNull reports whether the member is an explicit JSON null.\n343|func isNull(raw json.RawMessage) bool {\n344|\treturn string(bytes.TrimSpace(raw)) == \"null\"\n345|}\n346|\n347|func bytesTrimSpace(raw json.RawMessage) []byte {\n348|\treturn bytes.TrimSpace(raw)\n349|}\n350|\n351|// reverseDNSPattern is the extensions-key grammar: at least two\n352|// dot-separated labels, each starting with a lowercase letter.\n353|var reverseDNSPattern = regexp.MustCompile(`^[a-z][a-z0-9-]{0,62}(\\.[a-z][a-z0-9-]{0,62})+$`)\n354|\n355|// CheckReverseDNS reports whether the value is a reverse-DNS\n356|// name: at least two dot-separated labels, each starting with a\n357|// lowercase letter. It owns the single grammar behind extension\n358|// keys and reverse-DNS extension reason codes.\n359|func CheckReverseDNS(value string) bool {\n360|\treturn len(value) >= 3 && len(value) <= 253 && reverseDNSPattern.MatchString(value)\n361|}\n362|\n363|// CheckExtensions reports whether the member is an object whose\n364|// every key is reverse-DNS. Extensions never add operations,\n365|// capabilities, or trust facts; the key grammar is the part of\n366|// that rule decidable from one body.\n367|func CheckExtensions(raw json.RawMessage) bool {\n368|\tmembers, fault := DecodeStrictObject(bytesTrimSpace(raw))\n369|\tif fault != nil {\n370|\t\treturn false\n371|\t}\n372|\tfor name := range members {\n373|\t\tif !CheckReverseDNS(name) {\n374|\t\t\treturn false\n375|\t\t}\n376|\t}\n377|\treturn true\n378|}\n379|\n380|// decodeArray reads a JSON array member into its raw elements. A\n381|// non-array — including null — is not an empty array.\n382|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n383|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n384|\ttoken, err := decoder.Token()\n385|\tif err != nil {\n386|\t\treturn nil, false\n387|\t}\n388|\tdelim, ok := token.(json.Delim)\n389|\tif !ok || delim != '[' {\n390|\t\treturn nil, false\n391|\t}\n392|\tvar elements []json.RawMessage\n393|\tfor decoder.More() {\n394|\t\tvar element json.RawMessage\n395|\t\tif err := decoder.Decode(&element); err != nil {\n396|\t\t\treturn nil, false\n397|\t\t}\n398|\t\telements = append(elements, element)\n399|\t}\n400|\tif token, err := decoder.Token(); err != nil {\n401|\t\treturn nil, false\n402|\t} else if delim, ok := token.(json.Delim); !ok || delim != ']' {\n403|\t\treturn nil, false\n404|\t}\n405|\tif _, err := decoder.Token(); err != io.EOF {\n406|\t\treturn nil, false\n407|\t}\n408|\treturn elements, true\n409|}\n410|\n411|// CheckSortedUniqueStrings reports whether the member is an array\n412|// of strings in the item bound whose JCS encodings order strictly\n413|// increasingly with no duplicates. Bytewise JCS order over\n414|// strings is plain lexicographic order, so the check compares\n415|// directly; the count bound is checked on both edges.\n416|//\n417|// Ordering and uniqueness are two obligations, not one: an\n418|// unsorted-but-unique vector and a sorted-but-duplicated vector\n419|// are separate rows in this package's sorted-strings battery\n420|// (TestCheckSortedUniqueStringsHalves drives this function\n421|// directly), so a check that enforced only one half could not\n422|// pass both. The observation battery covers the digest twin,\n423|// not this function.\n424|func CheckSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n425|\telements, ok := decodeArray(raw)\n426|\tif !ok {\n427|\t\treturn nil, false\n428|\t}\n429|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n430|\t\treturn nil, false\n431|\t}\n432|\tvalues := make([]string, 0, len(elements))\n433|\tfor _, element := range elements {\n434|\t\tvalue, ok := CheckStringBounds(element, minimumLength, maximumLength)\n435|\t\tif !ok {\n436|\t\t\treturn nil, false\n437|\t\t}\n438|\t\tvalues = append(values, value)\n439|\t}\n440|\tfor index := 1; index < len(values); index++ {\n441|\t\tif values[index-1] >= values[index] {\n442|\t\t\treturn nil, false\n443|\t\t}\n444|\t}\n445|\treturn values, true\n446|}\n447|\n448|// CheckSortedUniqueDigests reports whether the member is an array\n449|// of digests in the count bound, ordered strictly increasingly\n450|// with no duplicates.\n451|func CheckSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n452|\telements, ok := decodeArray(raw)\n453|\tif !ok {\n454|\t\treturn nil, false\n455|\t}\n456|\tif uint64(len(elements)) < minimumCount || uint64(len(elements)) > maximumCount {\n457|\t\treturn nil, false\n458|\t}\n459|\tvalues := make([]scalar.Digest, 0, len(elements))\n460|\tfor _, element := range elements {\n461|\t\tdigest, ok := CheckDigest(element)\n462|\t\tif !ok {\n463|\t\t\treturn nil, false\n464|\t\t}\n465|\t\tvalues = append(values, digest)\n466|\t}\n467|\tfor index := 1; index < len(values); index++ {\n468|\t\tif values[index-1].String() >= values[index].String() {\n469|\t\t\treturn nil, false\n470|\t\t}\n471|\t}\n472|\treturn values, true\n473|}\n474|\n475|// refuse builds the package error for one refused member: the\n476|// rule in human text automation must never branch on, naming the\n477|// member. Tests assert the full text, so a reworded rule fails\n478|// its row instead of passing against a stale copy.\n479|//\n480|// refuse is a variable, not a function, so the refusal-site audit\n481|// (refusal_site_audit_test.go) can swap it in TestMain and record\n482|// the production file:line behind every exercised refusal. Every\n483|// call site invokes it directly; an aliased call records its real\n484|// use site and fails the reverse direction of the audit.\n485|var refuse = func(rule, member string) error {\n486|\tif member == \"\" {\n487|\t\treturn fmt.Errorf(\"environment %s\", rule)\n488|\t}\n489|\treturn fmt.Errorf(\"environment %s: %s\", rule, member)\n490|}","final_result":true}}}
