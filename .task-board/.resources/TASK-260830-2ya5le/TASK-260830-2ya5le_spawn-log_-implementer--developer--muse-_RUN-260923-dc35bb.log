{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7d5","stream":{"kind":"session","id":"01a0cfdc-90e4-7130-b73f-3760c218f2ff"},"sequence":581,"recorded_at":1780531400001157,"record_type":"event","durability":"durable","causation_id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5","run_stream":{"kind":"run","id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5"},"task_stream":{"kind":"task","id":"01a0cfe0-4f2f-7e31-9828-ab99e0e49fc8"},"task_id":"01a0cfe0-4f2f-7e31-9828-ab99e0e49fc8","event":{"kind":"output","task_id":"01a0cfe0-4f2f-7e31-9828-ab99e0e49fc8","chunk":"Read text file `internal/clonefidelity/vocab.go`.\n1|package clonefidelity\n2|\n3|import (\n4|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n5|)\n6|\n7|// This file owns the four Section 13.14.2 closed vocabularies: the\n8|// seven dispositions, the five profiles, the five strategies, and\n9|// the nineteen core reason codes plus reverse-DNS extensions. Every\n10|// table is quoted from the pinned specification text; the oracle\n11|// tests retype each list from the spec and sweep admission and\n12|// refusal through the production entries.\n13|\n14|// dispositions is the exact seven-member disposition vocabulary\n15|// Section 13.14.2 states: exact|semantic|summarized|\n16|// opaque_preserved|synthesized|omitted|unrecoverable.\n17|var dispositions = []string{\n18|\t\"exact\",\n19|\t\"semantic\",\n20|\t\"summarized\",\n21|\t\"opaque_preserved\",\n22|\t\"synthesized\",\n23|\t\"omitted\",\n24|\t\"unrecoverable\",\n25|}\n26|\n27|// ValidDisposition reports whether the name is a fidelity\n28|// disposition.\n29|func ValidDisposition(disposition string) bool {\n30|\tfor _, allowed := range dispositions {\n31|\t\tif disposition == allowed {\n32|\t\t\treturn true\n33|\t\t}\n34|\t}\n35|\treturn false\n36|}\n37|\n38|// Dispositions returns the exact seven-member disposition\n39|// vocabulary in specification order. Callers iterate the returned\n40|// copy; the table above stays the single owner.\n41|func Dispositions() []string {\n42|\tout := make([]string, len(dispositions))\n43|\tcopy(out, dispositions)\n44|\treturn out\n45|}\n46|\n47|// profiles is the exact five-member profile vocabulary Section\n48|// 13.14.2 states: strict_exact|maximal_safe|compact|messages_only|\n49|// archive_only. Maximal-safe is default.\n50|var profiles = []string{\n51|\t\"strict_exact\",\n52|\t\"maximal_safe\",\n53|\t\"compact\",\n54|\t\"messages_only\",\n55|\t\"archive_only\",\n56|}\n57|\n58|// ValidProfile reports whether the name is a fidelity profile.\n59|func ValidProfile(profile string) bool {\n60|\tfor _, allowed := range profiles {\n61|\t\tif profile == allowed {\n62|\t\t\treturn true\n63|\t\t}\n64|\t}\n65|\treturn false\n66|}\n67|\n68|// Profiles returns the exact five-member profile vocabulary in\n69|// specification order. Callers iterate the returned copy; the table\n70|// above stays the single owner.\n71|func Profiles() []string {\n72|\tout := make([]string, len(profiles))\n73|\tcopy(out, profiles)\n74|\treturn out\n75|}\n76|\n77|// strategies is the exact five-member strategy vocabulary Section\n78|// 13.14.2 states: same_environment_native_rewrite|\n79|// target_native_writer|target_official_import|continuation_context|\n80|// archive_only. Continuation context is explicitly non-native\n81|// historical fidelity. (The Projection Plan sibling narrows this to\n82|// the four non-archive strategies; this registry owns the full\n83|// Section 13.14.2 list.)\n84|var strategies = []string{\n85|\t\"same_environment_native_rewrite\",\n86|\t\"target_native_writer\",\n87|\t\"target_official_import\",\n88|\t\"continuation_context\",\n89|\t\"archive_only\",\n90|}\n91|\n92|// ValidStrategy reports whether the name is a fidelity strategy.\n93|func ValidStrategy(strategy string) bool {\n94|\tfor _, allowed := range strategies {\n95|\t\tif strategy == allowed {\n96|\t\t\treturn true\n97|\t\t}\n98|\t}\n99|\treturn false\n100|}\n101|\n102|// Strategies returns the exact five-member strategy vocabulary in\n103|// specification order. Callers iterate the returned copy; the table\n104|// above stays the single owner.\n105|func Strategies() []string {\n106|\tout := make([]string, len(strategies))\n107|\tcopy(out, strategies)\n108|\treturn out\n109|}\n110|\n111|// coreReasons is the exact nineteen-member closed core reason list\n112|// Section 13.14.2 states: target_no_equivalent|\n113|// source_not_persisted|source_truncated|source_corrupt|\n114|// foreign_encrypted_payload|foreign_signature_unverifiable|\n115|// target_schema_constraint|target_context_limit|target_size_limit|\n116|// target_version_gate|official_importer_loss|graph_flattened|\n117|// unsafe_pending_action|credential_excluded|secret_policy|\n118|// operator_policy|unsupported_media_type|unknown_native_event|\n119|// derived_index_rebuilt.\n120|var coreReasons = []string{\n121|\t\"target_no_equivalent\",\n122|\t\"source_not_persisted\",\n123|\t\"source_truncated\",\n124|\t\"source_corrupt\",\n125|\t\"foreign_encrypted_payload\",\n126|\t\"foreign_signature_unverifiable\",\n127|\t\"target_schema_constraint\",\n128|\t\"target_context_limit\",\n129|\t\"target_size_limit\",\n130|\t\"target_version_gate\",\n131|\t\"official_importer_loss\",\n132|\t\"graph_flattened\",\n133|\t\"unsafe_pending_action\",\n134|\t\"credential_excluded\",\n135|\t\"secret_policy\",\n136|\t\"operator_policy\",\n137|\t\"unsupported_media_type\",\n138|\t\"unknown_native_event\",\n139|\t\"derived_index_rebuilt\",\n140|}\n141|\n142|// IsCoreReasonCode reports whether the code is one of the nineteen\n143|// closed core reason codes.\n144|func IsCoreReasonCode(code string) bool {\n145|\tfor _, core := range coreReasons {\n146|\t\tif code == core {\n147|\t\t\treturn true\n148|\t\t}\n149|\t}\n150|\treturn false\n151|}\n152|\n153|// CoreReasonCodes returns the exact nineteen-m