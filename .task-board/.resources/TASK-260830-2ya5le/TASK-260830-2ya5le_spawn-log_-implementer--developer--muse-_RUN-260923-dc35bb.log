{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c869","stream":{"kind":"session","id":"01a0cfdc-90e4-7130-b73f-3760c218f2ff"},"sequence":655,"recorded_at":1780531400001305,"record_type":"event","durability":"durable","causation_id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5","run_stream":{"kind":"run","id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5"},"task_stream":{"kind":"task","id":"01a0cfe0-8420-78b3-ab5a-30db065c1652"},"task_id":"01a0cfe0-8420-78b3-ab5a-30db065c1652","event":{"kind":"output","task_id":"01a0cfe0-8420-78b3-ab5a-30db065c1652","chunk":"Read text file `internal/clonebundle/rawmanifest.go`.\n(399 line(s) above)\n400|\t}\n401|\treturn entries, total, nil\n402|}\n403|\n404|// VerifyRawManifestDescriptors re-checks descriptor agreement for a\n405|// decoded manifest: every entry's blob ID and byte count must agree\n406|// with the fetched Section 10.2 Blob Descriptor bytes, and the\n407|// fetched bytes must be the exact descriptor the entry's\n408|// blob_descriptor_id names. Decode validates structure; this entry\n409|// validates evidence.\n410|func VerifyRawManifestDescriptors(manifest RawObjectManifest, fetch func(descriptorID string) ([]byte, error)) error {\n411|\tfor index, entry := range manifest.Entries {\n412|\t\tdescriptor, err := fetch(entry.BlobDescriptorID.String())\n413|\t\tif err != nil {\n414|\t\t\treturn invalid(\"raw object entry[%d]: descriptor fetch failed: %v\", index, err)\n415|\t\t}\n416|\t\tif len(descriptor) == 0 {\n417|\t\t\treturn invalid(\"raw object entry[%d]: descriptor is absent\", index)\n418|\t\t}\n419|\t\tif err := VerifyDescriptorAgreement(descriptor, entry.BlobDescriptorID, entry.BlobID, entry.ByteCount); err != nil {\n420|\t\t\treturn invalid(\"raw object entry[%d]: %v\", index, err)\n421|\t\t}\n422|\t}\n423|\treturn nil\n424|}\n425|\n426|// IdentityDigest computes the terminal digest of canonical sanitized\n427|// NativeIdentity bytes: the source_identity_digest production entry.\n428|// The encoded bytes re-decode before hashing, exactly as\n429|// buildCaptureManifest re-decodes the source identity, so no digest\n430|// is ever sealed over an identity decoding would refuse.\n431|func IdentityDigest(identity NativeIdentity, extensions map[string]any) (scalar.Digest, error) {\n432|\tif err := SanitizeNativeKey(identity.NativeSessionID); err != nil {\n433|\t\treturn scalar.Digest{}, err\n434|\t}\n435|\tencoded, err := EncodeNativeIdentity(identity, extensions)\n436|\tif err != nil {\n437|\t\treturn scalar.Digest{}, err\n438|\t}\n439|\tif _, err := DecodeNativeIdentity(json.RawMessage(encoded)); err != nil {\n440|\t\treturn scalar.Digest{}, invalid(\"native identity digest seals no undecodable identity: %v\", err)\n441|\t}\n442|\treturn scalar.SHA256Digest(encoded), nil\n443|}\n444|\n445|func tupleObject(tuple sessadapter.Tuple) map[string]any {\n446|\treturn map[string]any{\n447|\t\t\"environment_id\":           tuple.EnvironmentID,\n448|\t\t\"environment_version\":      tuple.Version,\n449|\t\t\"platform\":                 tuple.Platform,\n450|\t\t\"architecture\":             tuple.Architecture,\n451|\t\t\"store_schema_fingerprint\": tuple.StoreFingerprint,\n452|\t\t\"adapter_version\":          tuple.AdapterVersion,\n453|\t}\n454|}\n455|\n456|func rawEntryObjects(entries []RawObjectEntry) []any {\n457|\tobjects := make([]any, 0, len(entries))\n458|\tfor _, entry := range entries {\n459|\t\tobjects = append(objects, map[string]any{\n460|\t\t\t\"native_item_key\":    entry.NativeItemKey,\n461|\t\t\t\"class\":              entry.Class,\n462|\t\t\t\"byte_count\":         entry.ByteCount,\n463|\t\t\t\"blob_id\":            entry.BlobID.String(),\n464|\t\t\t\"blob_descriptor_id\": entry.BlobDescriptorID.String(),\n465|\t\t})\n466|\t}\n467|\treturn objects\n468|}\n469|\n470|func extensionValue(extensions map[string]any) map[string]any {\n471|\tif extensions == nil {\n472|\t\treturn map[string]any{}\n473|\t}\n474|\treturn extensions\n475|}\n476|\n477|// EncodeExtensions validates caller-supplied extensions for\n478|// sibling Build entries: valid UTF-8 text at every depth (before\n479|// marshaling, so nothing rewrites to U+FFFD) plus the full closed\n480|// extensions rule. It delegates to the single implementation below\n481|// so the rule keeps one owner.\n482|func EncodeExtensions(extensions map[string]any) ([]byte, error) {\n483|\treturn encodeExtensions(extensions)\n484|}\n485|\n486|func encodeExtensions(extensions map[string]any) ([]byte, error) {\n487|\tvalue := extensionValue(extensions)\n488|\tif !validExtensionText(value) {\n489|\t\treturn nil, invalid(\"extensions carry text that is not valid UTF-8\")\n490|\t}\n491|\tplain, err := json.Marshal(value)\n492|\tif err != nil {\n493|\t\treturn nil, invalid(\"extensions are not JSON: %v\", err)\n494|\t}\n495|\tif fault := checkExtensionsClosed(json.RawMessage(plain)); fault != nil {\n496|\t\treturn nil, invalid(\"extensions %s\", fault)\n497|\t}\n498|\treturn plain, nil\n499|}","final_result":true}}}
