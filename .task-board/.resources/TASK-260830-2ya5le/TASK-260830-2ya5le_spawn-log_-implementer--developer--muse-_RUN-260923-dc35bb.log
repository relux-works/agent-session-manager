{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6bd","stream":{"kind":"session","id":"01a0cfdc-90e4-7130-b73f-3760c218f2ff"},"sequence":441,"recorded_at":1780531400000877,"record_type":"event","durability":"durable","causation_id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5","run_stream":{"kind":"run","id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5"},"task_stream":{"kind":"task","id":"01a0cfdd-d8dc-7af2-b8f8-8139459d92ca"},"task_id":"01a0cfdd-d8dc-7af2-b8f8-8139459d92ca","event":{"kind":"output","task_id":"01a0cfdd-d8dc-7af2-b8f8-8139459d92ca","chunk":"Read text file `internal/clonefidelity/fixtures_test.go`.\n1|package clonefidelity_test\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"crypto/sha256\"\n6|\t\"encoding/hex\"\n7|\t\"encoding/json\"\n8|\t\"errors\"\n9|\t\"strings\"\n10|\t\"testing\"\n11|\n12|\t\"github.com/gowebpki/jcs\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n14|\tclonefidelity \"github.com/relux-works/agent-session-manager/internal/clonefidelity\"\n15|)\n16|\n17|// Shared fixtures for the clonefidelity suite. Every literal is\n18|// hand-written and independent of production constants: verdicts\n19|// always come from production; vectors never do. The oracle lists\n20|// (dispositions, profiles, strategies, reasons, kinds, blocks,\n21|// classes) are retyped from the pinned SPEC v0.7.0 text in each\n22|// oracle test, never imported from production or from these\n23|// builders.\n24|\n25|const (\n26|\tfixtureOperationID = \"0198f4c8-8e50-7f66-8f70-111111111111\"\n27|\tfixtureBundleID    = \"0198f4c8-8e50-7f66-8f70-222222222222\"\n28|\tfixtureTargetOpID  = \"0198f4c8-8e50-7f66-8f70-333333333333\"\n29|)\n30|\n31|func fixtureDigest(seed string) string {\n32|\tsum := sha256.Sum256([]byte(seed))\n33|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n34|}\n35|\n36|func fixtureTupleJSON() string {\n37|\treturn `{\"environment_id\":\"test.env\",\"environment_version\":\"2.1.0\",\"platform\":\"linux\",\"architecture\":\"amd64\",\"store_schema_fingerprint\":\"` +\n38|\t\tfixtureDigest(\"fidelity-store-fingerprint\") + `\",\"adapter_version\":\"1.2.3\"}`\n39|}\n40|\n41|func strptr(value string) *string { return &value }\n42|\n43|// validRowInput returns a valid single-row candidate: source class,\n44|// one evidence ID, canonical object, locator, explanation, and no\n45|// staged/live evidence. Reasons default per disposition: exact rows\n46|// carry none, every other row carries unknown_native_event.\n47|func validRowInput(key, disposition string, reasons ...string) clonefidelity.DispositionRecordInput {\n48|\tif reasons == nil {\n49|\t\tif disposition != \"exact\" {\n50|\t\t\treasons = []string{\"unknown_native_event\"}\n51|\t\t} else {\n52|\t\t\treasons = []string{}\n53|\t\t}\n54|\t}\n55|\treturn clonefidelity.DispositionRecordInput{\n56|\t\tSourceItemKey:           key,\n57|\t\tSourceClass:             \"durable_payload\",\n58|\t\tSourceEvidenceIDs:       []string{fixtureDigest(\"evidence-\" + key)},\n59|\t\tCanonicalObjectID:       strptr(fixtureDigest(\"canonical-\" + key)),\n60|\t\tTargetLocator:           strptr(\"target/\" + key),\n61|\t\tDisposition:             disposition,\n62|\t\tReasonCodes:             reasons,\n63|\t\tExplanation:             \"row \" + key,\n64|\t\tStagedEvidenceObjectIDs: []string{},\n65|\t\tLiveEvidenceObjectIDs:   []string{},\n66|\t\tExtensions:              map[string]any{},\n67|\t}\n68|}\n69|\n70|// validSynthInput returns a valid synthesized-row candidate: no\n71|// source canonical object, one reason, source evidence present.\n72|func validSynthInput(key string) clonefidelity.DispositionRecordInput {\n73|\trow := validRowInput(key, \"synthesized\", \"derived_index_rebuilt\")\n74|\trow.CanonicalObjectID = nil\n75|\treturn row\n76|}\n77|\n78|// concentratedBreakdowns derives reconciling breakdown maps that\n79|// concentrate every row on the first owner key. It hand-counts the\n80|// rows independently of production derivation; production re-derives\n81|// and reconciles at both entries.\n82|func concentratedBreakdowns(rows []clonefidelity.DispositionRecordInput) (map[string]clonefidelity.FidelityCounts, map[string]clonefidelity.FidelityCounts, map[string]uint64) {\n83|\teventKinds := clonebundle.EventKinds()\n84|\tblockTypes := clonebundle.ContentBlockTypes()\n85|\tevents := make(map[string]clonefidelity.FidelityCounts, len(eventKinds))\n86|\tfor _, kind := range eventKinds {\n87|\t\tevents[kind] = clonefidelity.FidelityCounts{}\n88|\t}\n89|\tblocks := make(map[string]clonefidelity.FidelityCounts, len(blockTypes))\n90|\tfor _, block := range blockTypes {\n91|\t\tblocks[block] = clonefidelity.FidelityCounts{}\n92|\t}\n93|\tbytes := map[string]uint64{\n94|\t\t\"exact\": 0, \"semantic\": 0, \"summarized\": 0, \"opaque_preserved\": 0,\n95|\t\t\"synthesized\": 0, \"omitted\": 0, \"unrecoverable\": 0,\n96|\t}\n97|\tbump := func(counts clonefidelity.FidelityCounts, disposition string) clonefidelity.FidelityCounts {\n98|\t\tswitch disposition {\n99|\t\tcase \"exact\":\n100|\t\t\tcounts.Exact++\n101|\t\tcase \"semantic\":\n102|\t\t\tcounts.Semantic++\n103|\t\tcase \"summarized\":\n104|\t\t\tcounts.Summarized++\n105|\t\tcase \"opaque_preserved\":\n106|\t\t\tcounts.OpaquePreserved++\n107|\t\tcase \"synthesized\":\n108|\t\t\tcounts.Synthesized++\n109|\t\tcase \"omitted\":\n110|\t\t\tcounts.Omitted++\n111|\t\tcase \"unrecoverable\":\n112|\t\t\tcounts.Unrecoverable++\n113|\t\t}\n114|\t\treturn counts\n115|\t}\n116|\tfor _, row := range rows {\n117|\t\tevents[eventKinds[0]] = bump(events[eventKinds[0]], row.Disposition)\n118|\t\tblocks[blockTypes[0]] = bump(blocks[blockTypes[0]], row.Disposition)\n119|\t}\n120|\treturn events, blocks, bytes\n121|}\n122|\n123|// validTargetInput returns a valid target-scope report candidate\n124|// over the given rows with reconciling breakdowns.\n125|func validTargetInput(rows ...clonefidelity.DispositionRecordInput) clonefidelity.FidelityReportInput {\n126|\tevents, blocks, byteCounts := concentratedBreakdowns(rows)\n127|\treturn clonefidelity.FidelityReportInput{\n128|\t\tScope:                            \"target\",\n129|\t\tOperationID:                      fixtureOperationID,\n130|\t\tBundleID:                         fixtureBundleID,\n131|\t\tSourceSnapshotDigest:             fixtureDigest(\"source-snapshot\"),\n132|\t\tCaptureManifestID:                fixtureDigest(\"capture-manifest\"),\n133|\t\tCanonicalSessionID:               fixtureDigest(\"canonical-session\"),\n134|\t\tProjectionPlanID:                 strptr(fixtureDigest(\"projection-plan\")),\n135|\t\tSourceEnvironment:                []byte(fixtureTupleJSON()),\n136|\t\tTargetEnvironment:                []byte(fixtureTupleJSON()),\n137|\t\tProfile:                          \"maximal_safe\",\n138|\t\tRequiredDispositions:             map[string][]string{\"durable_payload\": {\"exact\", \"semantic\"}},\n139|\t\tForbidReasons:                    []string{\"credential_excluded\"},\n140|\t\tRows:                             rows,\n141|\t\tEventKindCounts:                  events,\n142|\t\tContentBlockCounts:               blocks,\n143|\t\tByteCounts:                       byteCounts,\n144|\t\tRawBundleComplete:                true,\n145|\t\tCanonicalComplete:                true,\n146|\t\tTargetSemanticallyContinuable:    true,\n147|\t\tTargetNativelyResumable:          true,\n148|\t\tStagedReadBackEvidenceManifestID: strptr(fixtureDigest(\"staged-manifest\")),\n149|\t\tLiveReadBackEvidenceManifestID:   strptr(fixtureDigest(\"live-manifest\")),\n150|\t\tAdapterAttestations:              []string{},\n151|\t\tExtensions:                       map[string]any{},\n152|\t}\n153|}\n154|\n155|// validArchiveInput returns a valid archive-scope report candidate\n156|// over the given rows: null plan/target/manifest IDs, archive_only\n157|// profile, and false target booleans.\n158|func validArchiveInput(rows ...clonefidelity.DispositionRecordInput) clonefidelity.FidelityReportInput {\n159|\tinput := validTargetInput(rows...)\n160|\tinput.Scope = \"archive\"\n161|\tinput.Profile = \"archive_only\"\n162|\tinput.ProjectionPlanID = nil\n163|\tinput.TargetEnvironment = nil\n164|\tinput.TargetSemanticallyContinuable = false\n165|\tinput.TargetNativelyResumable = false\n166|\tinput.StagedReadBackEvidenceManifestID = nil\n167|\tinput.LiveReadBackEvidenceManifestID = nil\n168|\treturn input\n169|}\n170|\n171|func mustBuild(t *testing.T, input clonefidelity.FidelityReportInput) []byte {\n172|\tt.Helper()\n173|\tsealed, err := clonefidelity.BuildFidelityReport(input)\n174|\tif err != nil {\n175|\t\tt.Fatalf(\"BuildFidelityReport() error = %v\", err)\n176|\t}\n177|\treturn sealed\n178|}\n179|\n180|func mustDecode(t *testing.T, sealed []byte) clonefidelity.FidelityReport {\n181|\tt.Helper()\n182|\treport, err := clonefidelity.DecodeFidelityReport(sealed)\n183|\tif err != nil {\n184|\t\tt.Fatalf(\"DecodeFidelityReport() error = %v\", err)\n185|\t}\n186|\treturn report\n187|}\n188|\n189|// requireRefusal asserts the refusal contract: the stable ErrInvalid\n190|// code plus the literal detail retyped from the expected rule. The\n191|// literal pins the gate; the code pins the refusal identity.\n192|func requireRefusal(t *testing.T, err error, literal string) {\n193|\tt.Helper()\n194|\tif err == nil {\n195|\t\tt.Fatalf(\"error = nil, want refusal containing %q\", literal)\n196|\t}\n197|\tif !errors.Is(err, clonefidelity.ErrInvalid) {\n198|\t\tt.Fatalf(\"error = %v, want errors.Is ErrInvalid\", err)\n199|\t}\n200|\tif !strings.Contains(err.Error(), literal) {\n201|\t\tt.Fatalf(\"error = %q, want literal %q\", err.Error(), literal)\n202|\t}\n203|}\n204|\n205|// decodeDocument decodes sealed bytes preserving number literals,\n206|// so tampered reports re-marshal byte-identically except for the\n207|// planted mutation.\n208|func decodeDocument(t *testing.T, sealed []byte) map[string]any {\n209|\tt.Helper()\n210|\tdecoder := json.NewDecoder(bytes.NewReader(sealed))\n211|\tdecoder.UseNumber()\n212|\tvar document map[string]any\n213|\tif err := decoder.Decode(&document); err != nil {\n214|\t\tt.Fatalf(\"decode sealed report: %v\", err)\n215|\t}\n216|\treturn document\n217|}\n218|\n219|// tampered reseals a report with one planted mutation. Semantic\n220|// mutations break the self digest too, but every semantic gate runs\n221|// before digest verification, so the semantic refusal fires first\n222|// with its literal detail.\n223|func tampered(t *testing.T, sealed []byte, mutate func(document map[string]any)) []byte {\n224|\tt.Helper()\n225|\tdocument := decodeDocument(t, sealed)\n226|\tmutate(document)\n227|\tout, err := json.Marshal(document)\n228|\tif err != nil {\n229|\t\tt.Fatalf(\"marshal tampered report: %v\", err)\n230|\t}\n231|\treturn out\n232|}\n233|\n234|func tamperRow(document map[string]any, index int, mutate func(row map[string]any)) {\n235|\trows := document[\"dispositions\"].([]any)\n236|\tmutate(rows[index].(map[string]any))\n237|}\n238|\n239|// independentReportID recomputes the omit-self identity in the test:\n240|// JCS over the sealed members minus fidelity_report_id, hashed with\n241|// SHA-256. It shares only the JCS library with production; the\n242|// omission wiring and digest comparison are the properties under\n243|// test.\n244|func independentReportID(t *testing.T, sealed []byte) string {\n245|\tt.Helper()\n246|\tdocument := decodeDocument(t, sealed)\n247|\tdelete(document, \"fidelity_report_id\")\n248|\tplain, err := json.Marshal(document)\n249|\tif err != nil {\n250|\t\tt.Fatalf(\"marshal omit-self object: %v\", err)\n251|\t}\n252|\tcanonical, err := jcs.Transform(plain)\n253|\tif err != nil {\n254|\t\tt.Fatalf(\"JCS transform: %v\", err)\n255|\t}\n256|\tsum := sha256.Sum256(canonical)\n257|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n258|}\n259|\n260|// gridReasons returns n distinct admissible reasons in sorted\n261|// order: the core list first, then reverse-DNS extensions.\n262|func gridReasons(n int) []string {\n263|\tcore := []string{\n264|\t\t\"target_no_equivalent\", \"source_not_persisted\", \"source_truncated\",\n265|\t\t\"source_corrupt\", \"foreign_encrypted_payload\", \"foreign_signature_unverifiable\",\n266|\t\t\"target_schema_constraint\", \"target_context_limit\", \"target_size_limit\",\n267|\t\t\"target_version_gate\", \"official_importer_loss\", \"graph_flattened\",\n268|\t\t\"unsafe_pending_action\", \"credential_excluded\", \"secret_policy\",\n269|\t\t\"operator_policy\", \"unsupported_media_type\", \"unknown_native_event\",\n270|\t\t\"derived_index_rebuilt\",\n271|\t}\n272|\treasons := make([]string, 0, n)\n273|\tfor _, reason := range core {\n274|\t\tif len(reasons) >= n {\n275|\t\t\tbreak\n276|\t\t}\n277|\t\treasons = append(reasons, reason)\n278|\t}\n279|\tfor i := 0; len(reasons) < n; i++ {\n280|\t\treasons = append(reasons, \"com.example.grid.r\"+itoa(i))\n281|\t}\n282|\t// Sorted unique: core codes sort before the com.example extensions\n283|\t// except none collide; sort explicitly to satisfy the order gate.\n284|\tsorted := append([]string(nil), reasons...)\n285|\tfor i := 1; i < len(sorted); i++ {\n286|\t\tfor j := i; j > 0 && sorted[j] < sorted[j-1]; j-- {\n287|\t\t\tsorted[j], sorted[j-1] = sorted[j-1], sorted[j]\n288|\t\t}\n289|\t}\n290|\treturn sorted\n291|}\n292|\n293|func itoa(value int) string {\n294|\tif value == 0 {\n295|\t\treturn \"0\"\n296|\t}\n297|\tdigits := []byte{}\n298|\tfor value > 0 {\n299|\t\tdigits = append([]byte{byte('0' + value%10)}, digits...)\n300|\t\tvalue /= 10\n301|\t}\n302|\treturn string(digits)\n303|}","final_result":true}}}
