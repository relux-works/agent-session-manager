{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c65f","stream":{"kind":"session","id":"01a0cfdc-90e4-7130-b73f-3760c218f2ff"},"sequence":394,"recorded_at":1780531400000783,"record_type":"event","durability":"durable","causation_id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5","run_stream":{"kind":"run","id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5"},"task_stream":{"kind":"task","id":"01a0cfdd-768d-7750-9dc3-4986d77eb709"},"task_id":"01a0cfdd-768d-7750-9dc3-4986d77eb709","event":{"kind":"output","task_id":"01a0cfdd-768d-7750-9dc3-4986d77eb709","chunk":"Read text file `internal/clonefidelity/decode.go`.\n1|package clonefidelity\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"io\"\n7|\t\"unicode/utf8\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|)\n14|\n15|// This file holds parse-only helpers for every Section 13.14.2\n16|// closed shape. Helpers report verdicts; every refusal is\n17|// constructed at the deciding site with a literal detail so each\n18|// rule stays a distinct gate. Strict object decoding, scalar\n19|// bounds, sorted-unique arrays, and the reverse-DNS grammar\n20|// delegate to the landed environ owner; closed extension values,\n21|// the omit-self digest, and the Section 13.14.1 vocabularies\n22|// delegate to the clonebundle owner; tuples decode through\n23|// sessadapter at the call site.\n24|\n25|const maxUint53 = uint64(1<<53 - 1)\n26|\n27|type frameFault struct {\n28|\tdetail string\n29|\tmember string\n30|}\n31|\n32|func decodeStrictObject(data []byte) (map[string]json.RawMessage, *frameFault) {\n33|\tmembers, fault := environ.DecodeStrictObject(data)\n34|\tif fault != nil {\n35|\t\treturn nil, &frameFault{detail: fault.Detail, member: fault.Member}\n36|\t}\n37|\treturn members, nil\n38|}\n39|\n40|func memberField(member string) string {\n41|\tif member == \"\" {\n42|\t\treturn \"frame\"\n43|\t}\n44|\treturn \"member \" + member\n45|}\n46|\n47|func unknownMember(members map[string]json.RawMessage, allowed map[string]bool) (string, bool) {\n48|\tfor name := range members {\n49|\t\tif !allowed[name] {\n50|\t\t\treturn name, true\n51|\t\t}\n52|\t}\n53|\treturn \"\", false\n54|}\n55|\n56|func missingMember(members map[string]json.RawMessage, required []string) (string, bool) {\n57|\tfor _, name := range required {\n58|\t\tif _, present := members[name]; !present {\n59|\t\t\treturn name, true\n60|\t\t}\n61|\t}\n62|\treturn \"\", false\n63|}\n64|\n65|func rawString(raw json.RawMessage) (string, bool) {\n66|\t// encoding/json unmarshals null into a string without an error,\n67|\t// so null is rejected explicitly: every string member here is\n68|\t// required non-null (nullable members branch on isNull first).\n69|\tif isNull(raw) {\n70|\t\treturn \"\", false\n71|\t}\n72|\tvar value string\n73|\tif err := json.Unmarshal(raw, &value); err != nil {\n74|\t\treturn \"\", false\n75|\t}\n76|\treturn value, true\n77|}\n78|\n79|func rawBool(raw json.RawMessage) (bool, bool) {\n80|\t// encoding/json unmarshals null into a bool without an error,\n81|\t// so null is rejected explicitly: a missing boolean is never a\n82|\t// false one.\n83|\tif isNull(raw) {\n84|\t\treturn false, false\n85|\t}\n86|\tvar value bool\n87|\tif err := json.Unmarshal(raw, &value); err != nil {\n88|\t\treturn false, false\n89|\t}\n90|\treturn value, true\n91|}\n92|\n93|// stringLength is the Section 1.6 string measure in characters, not\n94|// bytes. It delegates to the single environ measure so the two can\n95|// never drift.\n96|func stringLength(value string) int {\n97|\treturn environ.StringLength(value)\n98|}\n99|\n100|// checkStringBounds reports whether the member is a JSON string\n101|// whose character count falls in the inclusive bound. It delegates\n102|// to the environ gate.\n103|func checkStringBounds(raw json.RawMessage, minimum, maximum int) (string, bool) {\n104|\treturn environ.CheckStringBounds(raw, minimum, maximum)\n105|}\n106|\n107|// checkUint53Bounds reports whether the member is a uint53 in the\n108|// inclusive bound. It delegates to the environ gate.\n109|func checkUint53Bounds(raw json.RawMessage, minimum, maximum uint64) (uint64, bool) {\n110|\treturn environ.CheckUint53Bounds(raw, minimum, maximum)\n111|}\n112|\n113|// checkDigest reports whether the member is a digest of the pinned\n114|// sha256 form. It delegates to the environ gate.\n115|func checkDigest(raw json.RawMessage) (scalar.Digest, bool) {\n116|\treturn environ.CheckDigest(raw)\n117|}\n118|\n119|// checkUUIDv7 reports whether the member is a lowercase UUIDv7. It\n120|// delegates to the environ gate.\n121|func checkUUIDv7(raw json.RawMessage) (scalar.UUIDv7, bool) {\n122|\treturn environ.CheckUUIDv7(raw)\n123|}\n124|\n125|// checkSortedUniqueStrings reports whether the member is an array of\n126|// strings in the item bound whose order is strictly increasing with\n127|// no duplicates. It delegates to the environ gate.\n128|func checkSortedUniqueStrings(raw json.RawMessage, minimumLength, maximumLength int, minimumCount, maximumCount uint64) ([]string, bool) {\n129|\treturn environ.CheckSortedUniqueStrings(raw, minimumLength, maximumLength, minimumCount, maximumCount)\n130|}\n131|\n132|// checkSortedUniqueDigests reports whether the member is a sorted\n133|// unique digest array in the count bound. It delegates to the\n134|// environ gate.\n135|func checkSortedUniqueDigests(raw json.RawMessage, minimumCount, maximumCount uint64) ([]scalar.Digest, bool) {\n136|\treturn environ.CheckSortedUniqueDigests(raw, minimumCount, maximumCount)\n137|}\n138|\n139|func isNull(raw json.RawMessage) bool {\n140|\treturn string(bytes.TrimSpace(raw)) == \"null\"\n141|}\n142|\n143|func decodeArray(raw json.RawMessage) ([]json.RawMessage, bool) {\n144|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n145|\ttoken, err := decoder.Token()\n146|\tif err != nil {\n147|\t\treturn nil, false\n148|\t}\n149|\tdelimiter, ok := token.(json.Delim)\n150|\tif !ok || delimiter != '[' {\n151|\t\treturn nil, false\n152|\t}\n153|\tvar elements []json.RawMessage\n154|\tfor decoder.More() {\n155|\t\tvar element json.RawMessage\n156|\t\tif err := decoder.Decode(&element); err != nil {\n157|\t\t\treturn nil, false\n158|\t\t}\n159|\t\telements = append(elements, element)\n160|\t}\n161|\ttoken, err = decoder.Token()\n162|\tif err != nil {\n163|\t\treturn nil, false\n164|\t}\n165|\tdelimiter, ok = token.(json.Delim)\n166|\tif !ok || delimiter != ']' {\n167|\t\treturn nil, false\n168|\t}\n169|\tif _, err := decoder.Token(); err != io.EOF {\n170|\t\treturn nil, false\n171|\t}\n172|\tif elements == nil {\n173|\t\telements = []json.RawMessage{}\n174|\t}\n175|\treturn elements, true\n176|}\n177|\n178|// validText reports whether the value is valid UTF-8 text. Section\n179|// 1.6 requires text to be valid UTF-8, and encoding/json silently\n180|// rewrites invalid bytes to U+FFFD instead of failing — so every\n181|// Build-side string admission runs this gate BEFORE marshaling, and\n182|// refuses what it cannot seal byte-exactly.\n183|func validText(value string) bool {\n184|\treturn utf8.ValidString(value)\n185|}\n186|\n187|// checkExtensionsClosed enforces the full closed extensions rule via\n188|// the clonebundle owner: reverse-DNS keys and values inside the AX\n189|// common logical data model. It returns nil when the member is\n190|// closed, otherwise the refusal detail naming the failed rule.\n191|func checkExtensionsClosed(raw json.RawMessage) error {\n192|\treturn clonebundle.CheckExtensionsClosed(raw)\n193|}\n194|\n195|// canonicalizeObject renders one closed object deterministically:\n196|// the members marshal in any order and the JCS transform sorts\n197|// them, so identical logical inputs always produce identical bytes.\n198|func canonicalizeObject(object map[string]any) ([]byte, error) {\n199|\tplain, err := json.Marshal(object)\n200|\tif err != nil {\n201|\t\treturn nil, invalid(\"serialize fidelity object: %v\", err)\n202|\t}\n203|\tcanonical, err := canonicaljson.Canonicalize(plain)\n204|\tif err != nil {\n205|\t\treturn nil, invalid(\"canonicalize fidelity object: %v\", err)\n206|\t}\n207|\treturn canonical, nil\n208|}\n209|\n210|// verifySelfDigest recomputes the omit-self identity through the\n211|// clonebundle owner and refuses a mismatch against the claimed self\n212|// digest.\n213|func verifySelfDigest(members map[string]json.RawMessage, selfField string, claimed scalar.Digest) error {\n214|\tcalculated, err := clonebundle.OmitSelfDigest(members, selfField)\n215|\tif err != nil {\n216|\t\treturn err\n217|\t}\n218|\tif calculated != claimed {\n219|\t\treturn invalid(\"%s claim %q does not match omit-self digest %q\", selfField, claimed.String(), calculated.String())\n220|\t}\n221|\treturn nil\n222|}\n223|\n224|// checkSortedUniqueReasonStrings reports whether the caller-supplied\n225|// Build input is sorted unique ValidReasonCode strings in the item\n226|// bound. It mirrors checkReasonCodes for Go inputs: UTF-8 first (so\n227|// nothing seals rewritten), then character bounds, then order, then\n228|// vocabulary.\n229|func checkSortedUniqueReasonStrings(values []string, minimumCount, maximumCount int, owner string) ([]string, error) {\n230|\tif len(values) < minimumCount || len(values) > maximumCount {\n231|\t\treturn nil, invalid(\"%s carries %d reason_codes, want [%d..%d]\", owner, len(values), minimumCount, maximumCount)\n232|\t}\n233|\tprevious := \"\"\n234|\tfor index, reason := range values {\n235|\t\tif !validText(reason) {\n236|\t\t\treturn nil, invalid(\"%s reason_codes[%d] is not valid UTF-8\", owner, index)\n237|\t\t}\n238|\t\tif length := stringLength(reason); length < 1 || length > 128 {\n239|\t\t\treturn nil, invalid(\"%s reason_codes[%d] is not a string[1..128]\", owner, index)\n240|\t\t}\n241|\t\tif !ValidReasonCode(reason) {\n242|\t\t\treturn nil, invalid(\"%s reason_codes[%d] %q is outside the core and reverse-DNS reason vocabulary\", owner, index, reason)\n243|\t\t}\n244|\t\tif index > 0 && reason <= previous {\n245|\t\t\treturn nil, invalid(\"%s reason_codes are not sorted unique\", owner)\n246|\t\t}\n247|\t\tprevious = reason\n248|\t}\n249|\treturn values, nil\n250|}\n251|\n252|// checkSortedUniqueBoundedStrings reports whether the\n253|// caller-supplied Build input is sorted unique strings in the\n254|// character and count bounds. Ordering and measure delegate to the\n255|// same rules the environ JSON gate enforces.\n256|func checkSortedUniqueBoundedStrings(values []string, minimumLength, maximumLength int, minimumCount, maximumCount int, owner, member string) ([]string, error) {\n257|\tif len(values) < minimumCount || len(values) > maximumCount {\n258|\t\treturn nil, invalid(\"%s carries %d %s, want [%d..%d]\", owner, len(values), member, minimumCount, maximumCount)\n259|\t}\n260|\tprevious := \"\"\n261|\tfor index, value := range values {\n262|\t\tif !validText(value) {\n263|\t\t\treturn nil, invalid(\"%s %s[%d] is not valid UTF-8\", owner, member, index)\n264|\t\t}\n265|\t\tif length := stringLength(value); length < minimumLength || length > maximumLength {\n266|\t\t\treturn nil, invalid(\"%s %s[%d] is not a string[%d..%d]\", owner, member, index, minimumLength, maximumLength)\n267|\t\t}\n268|\t\tif index > 0 && value <= previous {\n269|\t\t\treturn nil, invalid(\"%s %s are not sorted unique\", owner, member)\n270|\t\t}\n271|\t\tprevious = value\n272|\t}\n273|\treturn values, nil\n274|}\n275|\n276|// parseSortedUniqueDigestStrings reports whether the\n277|// caller-supplied Build input is sorted unique digests in the count\n278|// bound.\n279|func parseSortedUniqueDigestStrings(values []string, minimum, maximum int, owner, member string) ([]scalar.Digest, error) {\n280|\tif len(values) < minimum || len(values) > maximum {\n281|\t\treturn nil, invalid(\"%s carries %d %s, want [%d..%d]\", owner, len(values), member, minimum, maximum)\n282|\t}\n283|\tids := make([]scalar.Digest, 0, len(values))\n284|\tprevious := \"\"\n285|\tfor index, value := range values {\n286|\t\tid, err := scalar.ParseDigest(value)\n287|\t\tif err != nil {\n288|\t\t\treturn nil, invalid(\"%s %s[%d] is not a digest: %v\", owner, member, index, err)\n289|\t\t}\n290|\t\tif index > 0 && id.String() <= previous {\n291|\t\t\treturn nil, invalid(\"%s %s are not sorted unique\", owner, member)\n292|\t\t}\n293|\t\tprevious = id.String()\n294|\t\tids = append(ids, id)\n295|\t}\n296|\treturn ids, nil\n297|}\n298|\n299|func digestStrings(ids []scalar.Digest) []any {\n300|\tout := make([]any, 0, len(ids))\n301|\tfor _, id := range ids {\n302|\t\tout = append(out, id.String())\n303|\t}\n304|\treturn out\n305|}\n306|\n307|func stringValues(values []string) []any {\n308|\tout := make([]any, 0, len(values))\n309|\tfor _, value := range values {\n310|\t\tout = append(out, value)\n311|\t}\n312|\treturn out\n313|}","final_result":true}}}
