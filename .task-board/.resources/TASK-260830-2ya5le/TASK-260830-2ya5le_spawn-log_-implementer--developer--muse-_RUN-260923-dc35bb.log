{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c61f","stream":{"kind":"session","id":"01a0cfdc-90e4-7130-b73f-3760c218f2ff"},"sequence":362,"recorded_at":1780531400000719,"record_type":"event","durability":"durable","causation_id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5","run_stream":{"kind":"run","id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5"},"task_stream":{"kind":"task","id":"01a0cfdd-68c4-7543-a48b-9e08d5dc5185"},"task_id":"01a0cfdd-68c4-7543-a48b-9e08d5dc5185","event":{"kind":"output","task_id":"01a0cfdd-68c4-7543-a48b-9e08d5dc5185","chunk":"Read text file `internal/clonefidelity/record.go`.\n1|package clonefidelity\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|// This file validates and constructs FidelityDispositionRecord: the\n12|// closed per-item row Section 13.14.2 states. Exact requires an\n13|// empty reason set and every other disposition at least one reason;\n14|// synthesized requires no source canonical object; every\n15|// non-synthesized row carries captured source evidence IDs (their\n16|// resolution against the Capture Manifest needs the manifest as an\n17|// input and is a stated bound).\n18|\n19|var dispositionRecordMembers = map[string]bool{\n20|\t\"source_item_key\":            true,\n21|\t\"source_class\":               true,\n22|\t\"source_evidence_ids\":        true,\n23|\t\"canonical_object_id\":        true,\n24|\t\"target_locator\":             true,\n25|\t\"disposition\":                true,\n26|\t\"reason_codes\":               true,\n27|\t\"explanation\":                true,\n28|\t\"staged_evidence_object_ids\": true,\n29|\t\"live_evidence_object_ids\":   true,\n30|\t\"extensions\":                 true,\n31|}\n32|\n33|var dispositionRecordRequired = []string{\n34|\t\"source_item_key\",\n35|\t\"source_class\",\n36|\t\"source_evidence_ids\",\n37|\t\"canonical_object_id\",\n38|\t\"target_locator\",\n39|\t\"disposition\",\n40|\t\"reason_codes\",\n41|\t\"explanation\",\n42|\t\"staged_evidence_object_ids\",\n43|\t\"live_evidence_object_ids\",\n44|\t\"extensions\",\n45|}\n46|\n47|// DispositionRecord is one validated fidelity disposition row.\n48|type DispositionRecord struct {\n49|\tSourceItemKey           string\n50|\tSourceClass             string\n51|\tSourceEvidenceIDs       []scalar.Digest\n52|\tCanonicalObjectID       *scalar.Digest\n53|\tTargetLocator           *string\n54|\tDisposition             string\n55|\tReasonCodes             []string\n56|\tExplanation             string\n57|\tStagedEvidenceObjectIDs []scalar.Digest\n58|\tLiveEvidenceObjectIDs   []scalar.Digest\n59|}\n60|\n61|// DispositionRecordInput is the caller-supplied disposition row\n62|// candidate for Build. Nil CanonicalObjectID and TargetLocator seal\n63|// as null.\n64|type DispositionRecordInput struct {\n65|\tSourceItemKey           string\n66|\tSourceClass             string\n67|\tSourceEvidenceIDs       []string\n68|\tCanonicalObjectID       *string\n69|\tTargetLocator           *string\n70|\tDisposition             string\n71|\tReasonCodes             []string\n72|\tExplanation             string\n73|\tStagedEvidenceObjectIDs []string\n74|\tLiveEvidenceObjectIDs   []string\n75|\tExtensions              map[string]any\n76|}\n77|\n78|// buildDispositionRecord validates one caller-supplied row and\n79|// renders its closed object. Every rule is a refusal: unknown\n80|// dispositions, out-of-vocabulary reasons, broken bounds, unsorted\n81|// or duplicate arrays, exact with reasons, non-exact without\n82|// reasons, and synthesized with a source canonical object are all\n83|// refused, never repaired.\n84|func buildDispositionRecord(input DispositionRecordInput, index int) (DispositionRecord, map[string]any, error) {\n85|\towner := fmt.Sprintf(\"fidelity disposition record[%d]\", index)\n86|\tif !validText(input.SourceItemKey) {\n87|\t\treturn DispositionRecord{}, nil, invalid(\"%s source_item_key is not valid UTF-8\", owner)\n88|\t}\n89|\tif length := stringLength(input.SourceItemKey); length < 1 || length > 512 {\n90|\t\treturn DispositionRecord{}, nil, invalid(\"%s source_item_key is not a string[1..512]\", owner)\n91|\t}\n92|\tif !validText(input.SourceClass) {\n93|\t\treturn DispositionRecord{}, nil, invalid(\"%s source_class is not valid UTF-8\", owner)\n94|\t}\n95|\tif length := stringLength(input.SourceClass); length < 1 || length > 128 {\n96|\t\treturn DispositionRecord{}, nil, invalid(\"%s source_class is not a string[1..128]\", owner)\n97|\t}\n98|\tevidence, err := parseSortedUniqueDigestStrings(input.SourceEvidenceIDs, 1, 65536, owner, \"source_evidence_ids\")\n99|\tif err != nil {\n100|\t\treturn DispositionRecord{}, nil, err\n101|\t}\n102|\tvar canonical *scalar.Digest\n103|\tvar canonicalValue any\n104|\tif input.CanonicalObjectID != nil {\n105|\t\tid, err := scalar.ParseDigest(*input.CanonicalObjectID)\n106|\t\tif err != nil {\n107|\t\t\treturn DispositionRecord{}, nil, invalid(\"%s canonical_object_id is not a digest: %v\", owner, err)\n108|\t\t}\n109|\t\tcanonical = &id\n110|\t\tcanonicalValue = id.String()\n111|\t}\n112|\tvar locator *string\n113|\tvar locatorValue any\n114|\tif input.TargetLocator != nil {\n115|\t\tif !validText(*input.TargetLocator) {\n116|\t\t\treturn DispositionRecord{}, nil, invalid(\"%s target_locator is not valid UTF-8\", owner)\n117|\t\t}\n118|\t\tif length := stringLength(*input.TargetLocator); length < 1 || length > 1024 {\n119|\t\t\treturn DispositionRecord{}, nil, invalid(\"%s target_locator is not a string[1..1024]\", owner)\n120|\t\t}\n121|\t\tlocator = input.TargetLocator\n122|\t\tlocatorValue = *input.TargetLocator\n123|\t}\n124|\tif !ValidDisposition(input.Disposition) {\n125|\t\treturn DispositionRecord{}, nil, invalid(\"%s disposition %q is outside exact|semantic|summarized|opaque_preserved|synthesized|omitted|unrecoverable\", owner, input.Disposition)\n126|\t}\n127|\treasons, err := checkSortedUniqueReasonStrings(input.ReasonCodes, 0, 128, owner)\n128|\tif err != nil {\n129|\t\treturn DispositionRecord{}, nil, err\n130|\t}\n131|\tif err := checkRecordReasonRule(owner, input.Disposition, len(reasons)); err != nil {\n132|\t\treturn DispositionRecord{}, nil, err\n133|\t}\n134|\tif err := checkRecordCanonicalRule(owner, input.Disposition, canonical != nil); err != nil {\n135|\t\treturn DispositionRecord{}, nil, err\n136|\t}\n137|\tif !validText(input.Explanation) {\n138|\t\treturn DispositionRecord{}, nil, invalid(\"%s explanation is not valid UTF-8\", owner)\n139|\t}\n140|\tif length := stringLength(input.Explanation); length < 1 || length > 4096 {\n141|\t\treturn DispositionRecord{}, nil, invalid(\"%s explanation is not a string[1..4096]\", owner)\n142|\t}\n143|\tstaged, err := parseSortedUniqueDigestStrings(input.StagedEvidenceObjectIDs, 0, 65536, owner, \"staged_evidence_object_ids\")\n144|\tif err != nil {\n145|\t\treturn DispositionRecord{}, nil, err\n146|\t}\n147|\tlive, err := parseSortedUniqueDigestStrings(input.LiveEvidenceObjectIDs, 0, 65536, owner, \"live_evidence_object_ids\")\n148|\tif err != nil {\n149|\t\treturn DispositionRecord{}, nil, err\n150|\t}\n151|\tif _, err := clonebundle.EncodeExtensions(input.Extensions); err != nil {\n152|\t\treturn DispositionRecord{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n153|\t}\n154|\textensions := input.Extensions\n155|\tif extensions == nil {\n156|\t\textensions = map[string]any{}\n157|\t}\n158|\trecord := DispositionRecord{\n159|\t\tSourceItemKey:           input.SourceItemKey,\n160|\t\tSourceClass:             input.SourceClass,\n161|\t\tSourceEvidenceIDs:       evidence,\n162|\t\tCanonicalObjectID:       canonical,\n163|\t\tTargetLocator:           locator,\n164|\t\tDisposition:             input.Disposition,\n165|\t\tReasonCodes:             reasons,\n166|\t\tExplanation:             input.Explanation,\n167|\t\tStagedEvidenceObjectIDs: staged,\n168|\t\tLiveEvidenceObjectIDs:   live,\n169|\t}\n170|\tobject := map[string]any{\n171|\t\t\"source_item_key\":            input.SourceItemKey,\n172|\t\t\"source_class\":               input.SourceClass,\n173|\t\t\"source_evidence_ids\":        digestStrings(evidence),\n174|\t\t\"canonical_object_id\":        canonicalValue,\n175|\t\t\"target_locator\":             locatorValue,\n176|\t\t\"disposition\":                input.Disposition,\n177|\t\t\"reason_codes\":               stringValues(reasons),\n178|\t\t\"explanation\":                input.Explanation,\n179|\t\t\"staged_evidence_object_ids\": digestStrings(staged),\n180|\t\t\"live_evidence_object_ids\":   digestStrings(live),\n181|\t\t\"extensions\":                 extensions,\n182|\t}\n183|\treturn record, object, nil\n184|}\n185|\n186|// checkRecordReasonRule enforces the reason-set rule both entries\n187|// share: exact requires an empty reason set and every other\n188|// disposition at least one reason.\n189|func checkRecordReasonRule(owner, disposition string, reasonCount int) error {\n190|\tif disposition == \"exact\" {\n191|\t\tif reasonCount != 0 {\n192|\t\t\treturn invalid(\"%s exact carries %d reason_codes, want an empty reason set\", owner, reasonCount)\n193|\t\t}\n194|\t\treturn nil\n195|\t}\n196|\tif reasonCount < 1 {\n197|\t\treturn invalid(\"%s %s carries no reason_codes, want at least one reason\", owner, disposition)\n198|\t}\n199|\treturn nil\n200|}\n201|\n202|// checkRecordCanonicalRule enforces the canonical-object rule both\n203|// entries share: synthesized requires no source canonical object.\n204|// Non-synthesized rows admit a digest or null: capture items that\n205|// never normalized (omitted, unrecoverable) carry null, canonical\n206|// events carry their object ID.\n207|func checkRecordCanonicalRule(owner, disposition string, hasCanonical bool) error {\n208|\tif disposition == \"synthesized\" && hasCanonical {\n209|\t\treturn invalid(\"%s synthesized carries a source canonical object\", owner)\n210|\t}\n211|\treturn nil\n212|}\n213|\n214|// decodeDispositionRecord validates one closed disposition row:\n215|// exact members, bounded scalars, the disposition and reason\n216|// vocabularies, sorted-unique arrays, the exact/synthesized rules,\n217|// and closed extensions.\n218|func decodeDispositionRecord(raw json.RawMessage, index int) (DispositionRecord, error) {\n219|\towner := \"fidelity disposition record\"\n220|\tmembers, fault := decodeStrictObject(raw)\n221|\tif fault != nil {\n222|\t\treturn DispositionRecord{}, invalid(\"%s[%d] %s (%s)\", owner, index, fault.detail, memberField(fault.member))\n223|\t}\n224|\tif name, unknown := unknownMember(members, dispositionRecordMembers); unknown {\n225|\t\treturn DispositionRecord{}, invalid(\"%s[%d] carries unknown member %q\", owner, index, name)\n226|\t}\n227|\tif name, missing := missingMember(members, dispositionRecordRequired); missing {\n228|\t\treturn DispositionRecord{}, invalid(\"%s[%d] misses a required member %q\", owner, index, name)\n229|\t}\n230|\tkey, ok := checkStringBounds(members[\"source_item_key\"], 1, 512)\n231|\tif !ok {\n232|\t\treturn DispositionRecord{}, invalid(\"%s[%d] source_item_key is not a string[1..512]\", owner, index)\n233|\t}\n234|\tclass, ok := checkStringBounds(members[\"source_class\"], 1, 128)\n235|\tif !ok {\n236|\t\treturn DispositionRecord{}, invalid(\"%s[%d] source_class is not a string[1..128]\", owner, index)\n237|\t}\n238|\tevidence, ok := checkSortedUniqueDigests(members[\"source_evidence_ids\"], 1, 65536)\n239|\tif !ok {\n240|\t\treturn DispositionRecord{}, invalid(\"%s[%d] source_evidence_ids are not sorted unique digest[1..65536]\", owner, index)\n241|\t}\n242|\tvar canonical *scalar.Digest\n243|\tif !isNull(members[\"canonical_object_id\"]) {\n244|\t\tid, ok := checkDigest(members[\"canonical_object_id\"])\n245|\t\tif !ok {\n246|\t\t\treturn DispositionRecord{}, invalid(\"%s[%d] canonical_object_id is not a digest or null\", owner, index)\n247|\t\t}\n248|\t\tcanonical = &id\n249|\t}\n250|\tvar locator *string\n251|\tif !isNull(members[\"target_locator\"]) {\n252|\t\tvalue, ok := checkStringBounds(members[\"target_locator\"], 1, 1024)\n253|\t\tif !ok {\n254|\t\t\treturn DispositionRecord{}, invalid(\"%s[%d] target_locator is not a string[1..1024] or null\", owner, index)\n255|\t\t}\n256|\t\tlocator = &value\n257|\t}\n258|\tdisposition, ok := rawString(members[\"disposition\"])\n259|\tif !ok || !ValidDisposition(disposition) {\n260|\t\treturn DispositionRecord{}, invalid(\"%s[%d] disposition is outside exact|semantic|summarized|opaque_preserved|synthesized|omitted|unrecoverable\", owner, index)\n261|\t}\n262|\treasons, ok := checkSortedUniqueStrings(members[\"reason_codes\"], 1, 128, 0, 128)\n263|\tif !ok {\n264|\t\treturn DispositionRecord{}, invalid(\"%s[%d] reason_codes are not sorted unique string[1..128][0..128]\", owner, index)\n265|\t}\n266|\tfor _, reason := range reasons {\n267|\t\tif !ValidReasonCode(reason) {\n268|\t\t\treturn DispositionRecord{}, invalid(\"%s[%d] reason_codes carry %q outside the core and reverse-DNS reason vocabulary\", owner, index, reason)\n269|\t\t}\n270|\t}\n271|\trowOwner := fmt.Sprintf(\"%s[%d]\", owner, index)\n272|\tif err := checkRecordReasonRule(rowOwner, disposition, len(reasons)); err != nil {\n273|\t\treturn DispositionRecord{}, err\n274|\t}\n275|\tif err := checkRecordCanonicalRule(rowOwner, disposition, canonical != nil); err != nil {\n276|\t\treturn DispositionRecord{}, err\n277|\t}\n278|\texplanation, ok := checkStringBounds(members[\"explanation\"], 1, 4096)\n279|\tif !ok {\n280|\t\treturn DispositionRecord{}, invalid(\"%s[%d] explanation is not a string[1..4096]\", owner, index)\n281|\t}\n282|\tstaged, ok := checkSortedUniqueDigests(members[\"staged_evidence_object_ids\"], 0, 65536)\n283|\tif !ok {\n284|\t\treturn DispositionRecord{}, invalid(\"%s[%d] staged_evidence_object_ids are not sorted unique digest[0..65536]\", owner, index)\n285|\t}\n286|\tlive, ok := checkSortedUniqueDigests(members[\"live_evidence_object_ids\"], 0, 65536)\n287|\tif !ok {\n288|\t\treturn DispositionRecord{}, invalid(\"%s[%d] live_evidence_object_ids are not sorted unique digest[0..65536]\", owner, index)\n289|\t}\n290|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n291|\t\treturn DispositionRecord{}, invalid(\"%s[%d] extensions %s\", owner, index, extensionsFault)\n292|\t}\n293|\treturn DispositionRecord{\n294|\t\tSourceItemKey:           key,\n295|\t\tSourceClass:             class,\n296|\t\tSourceEvidenceIDs:       evidence,\n297|\t\tCanonicalObjectID:       canonical,\n298|\t\tTargetLocator:           locator,\n299|\t\tDisposition:             disposition,\n300|\t\tReasonCodes:             reasons,\n301|\t\tExplanation:             explanation,\n302|\t\tStagedEvidenceObjectIDs: staged,\n303|\t\tLiveEvidenceObjectIDs:   live,\n304|\t}, nil\n305|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c621","stream":{"kind":"session","id":"01a0cfdc-90e4-7130-b73f-3760c218f2ff"},"sequence":363,"recorded_at":1780531400000721,"record_type":"event","durability":"durable","causation_id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5","run_stream":{"kind":"run","id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5"},"task_stream":{"kind":"task","id":"01a0cfdd-68c4-7543-a48b-9e08d5dc5185"},"task_id":"01a0cfdd-68c4-7543-a48b-9e08d5dc5185","event":{"kind":"completed","task_id":"01a0cfdd-68c4-7543-a48b-9e08d5dc5185"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c623","stream":{"kind":"session","id":"01a0cfdc-90e4-7130-b73f-3760c218f2ff"},"sequence":364,"recorded_at":1780531400000723,"record_type":"event","durability":"durable","causation_id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5","run_stream":{"kind":"run","id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5"},"task_stream":{"kind":"task","id":"01a0cfdd-68ea-7841-80af-6b3832607cba"},"task_id":"01a0cfdd-68ea-7841-80af-6b3832607cba","event":{"kind":"output","task_id":"01a0cfdd-68ea-7841-80af-6b3832607cba","chunk":"Read text file `internal/clonefidelity/report.go`.\n1|package clonefidelity\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"sort\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n10|)\n11|\n12|// This file validates and constructs Fidelity Report 1.0.0: the\n13|// closed archive/target report Section 13.14.2 states with its\n14|// per-item disposition rows and reconciled aggregate maps. Counts\n15|// and reason counts derive from the rows and are never accepted;\n16|// the per-kind and per-block breakdowns reconcile to those derived\n17|// totals per disposition; byte values admit the exact\n18|// seven-disposition key set with uint53 values (rows carry no byte\n19|// measure, so no row reconciliation is expressible — a stated\n20|// bound).\n21|\n22|const (\n23|\tfidelityReportSchema  = \"urn:ax:schema:fidelity-report\"\n24|\tfidelityReportVersion = \"1.0.0\"\n25|\tfidelityReportSelf    = \"fidelity_report_id\"\n26|)\n27|\n28|// maxReportRows is the Fidelity Report dispositions bound:\n29|// FidelityDispositionRecord[1..1000000].\n30|const maxReportRows = 1000000\n31|\n32|var fidelityReportMembers = map[string]bool{\n33|\t\"schema\": true, \"schema_version\": true, \"fidelity_report_id\": true,\n34|\t\"scope\": true, \"operation_id\": true, \"bundle_id\": true,\n35|\t\"source_snapshot_digest\": true, \"capture_manifest_id\": true, \"canonical_session_id\": true,\n36|\t\"projection_plan_id\": true, \"source_environment\": true, \"target_environment\": true,\n37|\t\"profile\": true, \"required_dispositions\": true, \"forbid_reasons\": true,\n38|\t\"dispositions\": true, \"counts\": true, \"event_kind_counts\": true,\n39|\t\"content_block_counts\": true, \"byte_counts\": true, \"reason_counts\": true,\n40|\t\"raw_bundle_complete\": true, \"canonical_complete\": true,\n41|\t\"target_semantically_continuable\": true, \"target_natively_resumable\": true,\n42|\t\"staged_read_back_evidence_manifest_id\": true, \"live_read_back_evidence_manifest_id\": true,\n43|\t\"adapter_attestations\": true, \"extensions\": true,\n44|}\n45|\n46|var fidelityReportRequired = []string{\n47|\t\"schema\", \"schema_version\", \"fidelity_report_id\",\n48|\t\"scope\", \"operation_id\", \"bundle_id\",\n49|\t\"source_snapshot_digest\", \"capture_manifest_id\", \"canonical_session_id\",\n50|\t\"projection_plan_id\", \"source_environment\", \"target_environment\",\n51|\t\"profile\", \"required_dispositions\", \"forbid_reasons\",\n52|\t\"dispositions\", \"counts\", \"event_kind_counts\",\n53|\t\"content_block_counts\", \"byte_counts\", \"reason_counts\",\n54|\t\"raw_bundle_complete\", \"canonical_complete\",\n55|\t\"target_semantically_continuable\", \"target_natively_resumable\",\n56|\t\"staged_read_back_evidence_manifest_id\", \"live_read_back_evidence_manifest_id\",\n57|\t\"adapter_attestations\", \"extensions\",\n58|}\n59|\n60|// FidelityCounts is the exact seven-member count record Section\n61|// 13.14.2 states: exact, semantic, summarized, opaque_preserved,\n62|// synthesized, omitted, and unrecoverable.\n63|type FidelityCounts struct {\n64|\tExact           uint64\n65|\tSemantic        uint64\n66|\tSummarized      uint64\n67|\tOpaquePreserved uint64\n68|\tSynthesized     uint64\n69|\tOmitted         uint64\n70|\tUnrecoverable   uint64\n71|}\n72|\n73|// countOf returns the count for one disposition. The caller gates\n74|// vocabulary; an unknown disposition reads zero.\n75|func (counts FidelityCounts) countOf(disposition string) uint64 {\n76|\tswitch disposition {\n77|\tcase \"exact\":\n78|\t\treturn counts.Exact\n79|\tcase \"semantic\":\n80|\t\treturn counts.Semantic\n81|\tcase \"summarized\":\n82|\t\treturn counts.Summarized\n83|\tcase \"opaque_preserved\":\n84|\t\treturn counts.OpaquePreserved\n85|\tcase \"synthesized\":\n86|\t\treturn counts.Synthesized\n87|\tcase \"omitted\":\n88|\t\treturn counts.Omitted\n89|\tcase \"unrecoverable\":\n90|\t\treturn counts.Unrecoverable\n91|\tdefault:\n92|\t\treturn 0\n93|\t}\n94|}\n95|\n96|// addRow folds one row disposition into the totals. Every counts\n97|// derivation both entries share flows through this switch.\n98|func (counts *FidelityCounts) addRow(disposition string) {\n99|\tswitch disposition {\n100|\tcase \"exact\":\n101|\t\tcounts.Exact++\n102|\tcase \"semantic\":\n103|\t\tcounts.Semantic++\n104|\tcase \"summarized\":\n105|\t\tcounts.Summarized++\n106|\tcase \"opaque_preserved\":\n107|\t\tcounts.OpaquePreserved++\n108|\tcase \"synthesized\":\n109|\t\tcounts.Synthesized++\n110|\tcase \"omitted\":\n111|\t\tcounts.Omitted++\n112|\tcase \"unrecoverable\":\n113|\t\tcounts.Unrecoverable++\n114|\t}\n115|}\n116|\n117|func (counts FidelityCounts) object() map[string]any {\n118|\treturn map[string]any{\n119|\t\t\"exact\":            counts.Exact,\n120|\t\t\"semantic\":         counts.Semantic,\n121|\t\t\"summarized\":       counts.Summarized,\n122|\t\t\"opaque_preserved\": counts.OpaquePreserved,\n123|\t\t\"synthesized\":      counts.Synthesized,\n124|\t\t\"omitted\":          counts.Omitted,\n125|\t\t\"unrecoverable\":    counts.Unrecoverable,\n126|\t}\n127|}\n128|\n129|// deriveCounts counts the rows per disposition. Row vocabularies are\n130|// gated before derivation, so every row folds into exactly one arm.\n131|func deriveCounts(rows []DispositionRecord) FidelityCounts {\n132|\tvar counts FidelityCounts\n133|\tfor _, row := range rows {\n134|\t\tcounts.addRow(row.Disposition)\n135|\t}\n136|\treturn counts\n137|}\n138|\n139|// deriveReasonCounts counts, per reason, the rows naming it. Row\n140|// reason sets are sorted unique, so each row contributes at most\n141|// one to each reason.\n142|func deriveReasonCounts(rows []DispositionRecord) map[string]uint64 {\n143|\tderived := map[string]uint64{}\n144|\tfor _, row := range rows {\n145|\t\tfor _, reason := range row.ReasonCodes {\n146|\t\t\tderived[reason]++\n147|\t\t}\n148|\t}\n149|\treturn derived\n150|}\n151|\n152|// checkRowCount admits the dispositions cardinality both entries\n153|// share: FidelityDispositionRecord[1..1000000]. It is factored so\n154|// the exact bound is pinned at the edge and edge+1 without sealing\n155|// a million-row report in the suite; entry reachability is proven\n156|// by the entry-level refusal rows (see TRACEABILITY.md).\n157|func checkRowCount(count int) error {\n158|\tif count < 1 || count > maxReportRows {\n159|\t\treturn invalid(\"fidelity report carries %d dispositions, want [1..1000000]\", count)\n160|\t}\n161|\treturn nil\n162|}\n163|\n164|// checkRowOrder enforces the row ordering both entries share:\n165|// source rows sorted unique by item key, then synthesized rows\n166|// sorted unique by item key, with keys unique across all rows.\n167|func checkRowOrder(rows []DispositionRecord) error {\n168|\tseen := make(map[string]bool, len(rows))\n169|\tseenSynthesized := false\n170|\tpreviousSource := \"\"\n171|\tpreviousSynthesized := \"\"\n172|\tfor _, row := range rows {\n173|\t\tif seen[row.SourceItemKey] {\n174|\t\t\treturn invalid(\"fidelity report dispositions carry duplicate source item key %q\", row.SourceItemKey)\n175|\t\t}\n176|\t\tseen[row.SourceItemKey] = true\n177|\t\tif row.Disposition == \"synthesized\" {\n178|\t\t\tseenSynthesized = true\n179|\t\t\tif previousSynthesized != \"\" && row.SourceItemKey <= previousSynthesized {\n180|\t\t\t\treturn invalid(\"fidelity report synthesized dispositions are not sorted unique by source item key\")\n181|\t\t\t}\n182|\t\t\tpreviousSynthesized = row.SourceItemKey\n183|\t\t\tcontinue\n184|\t\t}\n185|\t\tif seenSynthesized {\n186|\t\t\treturn invalid(\"fidelity report dispositions order a source row after synthesized rows\")\n187|\t\t}\n188|\t\tif previousSource != \"\" && row.SourceItemKey <= previousSource {\n189|\t\t\treturn invalid(\"fidelity report source dispositions are not sorted unique by source item key\")\n190|\t\t}\n191|\t\tpreviousSource = row.SourceItemKey\n192|\t}\n193|\treturn nil\n194|}\n195|\n196|// checkBreakdownSums reconciles one closed breakdown map to the\n197|// derived totals: for every disposition, the values summed over\n198|// every key equal the row-derived count. The sums cannot overflow:\n199|// 26 closed keys times (2^53-1) stays below 2^57.\n200|func checkBreakdownSums(owner string, breakdown map[string]FidelityCounts, totals FidelityCounts) error {\n201|\tfor _, disposition := range dispositions {\n202|\t\tvar sum uint64\n203|\t\tfor _, counts := range breakdown {\n204|\t\t\tsum += counts.countOf(disposition)\n205|\t\t}\n206|\t\tif sum != totals.countOf(disposition) {\n207|\t\t\treturn invalid(\"%s reconciles %d %s rows, want %d from the disposition rows\", owner, sum, disposition, totals.countOf(disposition))\n208|\t\t}\n209|\t}\n210|\treturn nil\n211|}\n212|\n213|// FidelityReport is one validated Fidelity Report 1.0.0.\n214|type FidelityReport struct {\n215|\tReportID                         scalar.Digest\n216|\tScope                            string\n217|\tOperationID                      scalar.UUIDv7\n218|\tBundleID                         scalar.UUIDv7\n219|\tSourceSnapshotDigest             scalar.Digest\n220|\tCaptureManifestID                scalar.Digest\n221|\tCanonicalSessionID               scalar.Digest\n222|\tProjectionPlanID                 *scalar.Digest\n223|\tSourceEnvironment                sessadapter.Tuple\n224|\tTargetEnvironment                *sessadapter.Tuple\n225|\tProfile                          string\n226|\tRequiredDispositions             map[string][]string\n227|\tForbidReasons                    []string\n228|\tRows                             []DispositionRecord\n229|\tCounts                           FidelityCounts\n230|\tEventKindCounts                  map[string]FidelityCounts\n231|\tContentBlockCounts               map[string]FidelityCounts\n232|\tByteCounts                       map[string]uint64\n233|\tReasonCounts                     map[string]uint64\n234|\tRawBundleComplete                bool\n235|\tCanonicalComplete                bool\n236|\tTargetSemanticallyContinuable    bool\n237|\tTargetNativelyResumable          bool\n238|\tStagedReadBackEvidenceManifestID *scalar.Digest\n239|\tLiveReadBackEvidenceManifestID   *scalar.Digest\n240|\tAdapterAttestations              []scalar.Digest\n241|}\n242|\n243|// FidelityReportInput is the caller-supplied fidelity report\n244|// candidate for Build. Counts and reason counts are derived from\n245|// Rows and are never accepted; the per-kind, per-block, and\n246|// per-disposition breakdowns are caller-supplied and reconciled.\n247|// Nil digest pointers and empty TargetEnvironment seal as null.\n248|type FidelityReportInput struct {\n249|\tScope                            string\n250|\tOperationID                      string\n251|\tBundleID                         string\n252|\tSourceSnapshotDigest             string\n253|\tCaptureManifestID                string\n254|\tCanonicalSessionID               string\n255|\tProjectionPlanID                 *string\n256|\tSourceEnvironment                []byte\n257|\tTargetEnvironment                []byte\n258|\tProfile                          string\n259|\tRequiredDispositions             map[string][]string\n260|\tForbidReasons                    []string\n261|\tRows                             []DispositionRecordInput\n262|\tEventKindCounts                  map[string]FidelityCounts\n263|\tContentBlockCounts               map[string]FidelityCounts\n264|\tByteCounts                       map[string]uint64\n265|\tRawBundleComplete                bool\n266|\tCanonicalComplete                bool\n267|\tTargetSemanticallyContinuable    bool\n268|\tTargetNativelyResumable          bool\n269|\tStagedReadBackEvidenceManifestID *string\n270|\tLiveReadBackEvidenceManifestID   *string\n271|\tAdapterAttestations              []string\n272|\tExtensions                       map[string]any\n273|}\n274|\n275|// BuildFidelityReport constructs one closed Fidelity Report 1.0.0\n276|// as canonical bytes. Identical inputs produce byte-identical\n277|// outputs. Counts and reason counts derive from the rows; every\n278|// other closed-shape, vocabulary, branch, order, and reconciliation\n279|// rule is a refusal, never a repair.\n280|func BuildFidelityReport(input FidelityReportInput) ([]byte, error) {\n281|\t_, object, err := buildFidelityReport(input)\n282|\tif err != nil {\n283|\t\treturn nil, err\n284|\t}\n285|\tomitted, err := canonicalizeObject(object)\n286|\tif err != nil {\n287|\t\treturn nil, err\n288|\t}\n289|\treportID := scalar.SHA256Digest(omitted)\n290|\tobject[fidelityReportSelf] = reportID.String()\n291|\treturn canonicalizeObject(object)\n292|}\n293|\n294|func buildFidelityReport(input FidelityReportInput) (FidelityReport, map[string]any, error) {\n295|\towner := \"fidelity report\"\n296|\tarchive := false\n297|\tswitch input.Scope {\n298|\tcase \"archive\":\n299|\t\tarchive = true\n300|\tcase \"target\":\n301|\tdefault:\n302|\t\treturn FidelityReport{}, nil, invalid(\"%s scope is outside archive|target\", owner)\n303|\t}\n304|\toperation, err := scalar.ParseUUIDv7(input.OperationID)\n305|\tif err != nil {\n306|\t\treturn FidelityReport{}, nil, invalid(\"%s operation_id is not a UUIDv7: %v\", owner, err)\n307|\t}\n308|\tbundle, err := scalar.ParseUUIDv7(input.BundleID)\n309|\tif err != nil {\n310|\t\treturn FidelityReport{}, nil, invalid(\"%s bundle_id is not a UUIDv7: %v\", owner, err)\n311|\t}\n312|\tsnapshot, err := scalar.ParseDigest(input.SourceSnapshotDigest)\n313|\tif err != nil {\n314|\t\treturn FidelityReport{}, nil, invalid(\"%s source_snapshot_digest is not a digest: %v\", owner, err)\n315|\t}\n316|\tcaptureID, err := scalar.ParseDigest(input.CaptureManifestID)\n317|\tif err != nil {\n318|\t\treturn FidelityReport{}, nil, invalid(\"%s capture_manifest_id is not a digest: %v\", owner, err)\n319|\t}\n320|\tcanonicalID, err := scalar.ParseDigest(input.CanonicalSessionID)\n321|\tif err != nil {\n322|\t\treturn FidelityReport{}, nil, invalid(\"%s canonical_session_id is not a digest: %v\", owner, err)\n323|\t}\n324|\tvar plan *scalar.Digest\n325|\tvar planValue any\n326|\tif archive {\n327|\t\tif input.ProjectionPlanID != nil {\n328|\t\t\treturn FidelityReport{}, nil, invalid(\"%s projection_plan_id is not null for archive\", owner)\n329|\t\t}\n330|\t} else {\n331|\t\tif input.ProjectionPlanID == nil {\n332|\t\t\treturn FidelityReport{}, nil, invalid(\"%s projection_plan_id is null for target\", owner)\n333|\t\t}\n334|\t\tid, err := scalar.ParseDigest(*input.ProjectionPlanID)\n335|\t\tif err != nil {\n336|\t\t\treturn FidelityReport{}, nil, invalid(\"%s projection_plan_id is not a digest: %v\", owner, err)\n337|\t\t}\n338|\t\tplan = &id\n339|\t\tplanValue = id.String()\n340|\t}\n341|\tsourceTuple, err := sessadapter.DecodeTuple(json.RawMessage(input.SourceEnvironment))\n342|\tif err != nil {\n343|\t\treturn FidelityReport{}, nil, invalid(\"%s source_environment is not an Environment Tuple: %v\", owner, err)\n344|\t}\n345|\tvar targetTuple *sessadapter.Tuple\n346|\tvar targetValue any\n347|\tif archive {\n348|\t\tif len(input.TargetEnvironment) != 0 {\n349|\t\t\treturn FidelityReport{}, nil, invalid(\"%s target_environment is not null for archive\", owner)\n350|\t\t}\n351|\t} else {\n352|\t\ttuple, err := sessadapter.DecodeTuple(json.RawMessage(input.TargetEnvironment))\n353|\t\tif err != nil {\n354|\t\t\treturn FidelityReport{}, nil, invalid(\"%s target_environment is not an Environment Tuple: %v\", owner, err)\n355|\t\t}\n356|\t\ttargetTuple = &tuple\n357|\t\ttargetValue = tupleObject(tuple)\n358|\t}\n359|\tif !ValidProfile(input.Profile) {\n360|\t\treturn FidelityReport{}, nil, invalid(\"%s profile %q is outside strict_exact|maximal_safe|compact|messages_only|archive_only\", owner, input.Profile)\n361|\t}\n362|\tif archive && input.Profile != \"archive_only\" {\n363|\t\treturn FidelityReport{}, nil, invalid(\"%s profile is %q for archive, want archive_only\", owner, input.Profile)\n364|\t}\n365|\tif !archive && input.Profile == \"archive_only\" {\n366|\t\treturn FidelityReport{}, nil, invalid(\"%s profile is archive_only for target\", owner)\n367|\t}\n368|\trequired, err := buildRequiredDispositions(input.RequiredDispositions)\n369|\tif err != nil {\n370|\t\treturn FidelityReport{}, nil, err\n371|\t}\n372|\tforbidden, err := checkSortedUniqueBoundedStrings(input.ForbidReasons, 1, 128, 0, 128, owner, \"forbid_reasons\")\n373|\tif err != nil {\n374|\t\treturn FidelityReport{}, nil, err\n375|\t}\n376|\tif err := checkRowCount(len(input.Rows)); err != nil {\n377|\t\treturn FidelityReport{}, nil, err\n378|\t}\n379|\trows := make([]DispositionRecord, 0, len(input.Rows))\n380|\tobjects := make([]any, 0, len(input.Rows))\n381|\tfor index, candidate := range input.Rows {\n382|\t\trow, object, err := buildDispositionRecord(candidate, index)\n383|\t\tif err != nil {\n384|\t\t\treturn FidelityReport{}, nil, err\n385|\t\t}\n386|\t\trows = append(rows, row)\n387|\t\tobjects = append(objects, object)\n388|\t}\n389|\tif err := checkRowOrder(rows); err != nil {\n390|\t\treturn FidelityReport{}, nil, err\n391|\t}\n392|\tcounts := deriveCounts(rows)\n393|\treasonCounts := deriveReasonCounts(rows)\n394|\teventKinds, err := buildBreakdown(input.EventKindCounts, clonebundle.EventKinds(), \"event_kind_counts\")\n395|\tif err != nil {\n396|\t\treturn FidelityReport{}, nil, err\n397|\t}\n398|\tif err := checkBreakdownSums(\"fidelity report event_kind_counts\", eventKinds, counts); err != nil {\n399|\t\treturn FidelityReport{}, nil, err\n400|\t}\n401|\tcontentBlocks, err := buildBreakdown(input.ContentBlockCounts, clonebundle.ContentBlockTypes(), \"content_block_counts\")\n402|\tif err != nil {\n403|\t\treturn FidelityReport{}, nil, err\n404|\t}\n405|\tif err := checkBreakdownSums(\"fidelity report content_block_counts\", contentBlocks, counts); err != nil {\n406|\t\treturn FidelityReport{}, nil, err\n407|\t}\n408|\tbyteCounts, err := buildByteCounts(input.ByteCounts)\n409|\tif err != nil {\n410|\t\treturn FidelityReport{}, nil, err\n411|\t}\n412|\tif archive {\n413|\t\tif input.TargetSemanticallyContinuable {\n414|\t\t\treturn FidelityReport{}, nil, invalid(\"%s target_semantically_continuable is true for archive\", owner)\n415|\t\t}\n416|\t\tif input.TargetNativelyResumable {\n417|\t\t\treturn FidelityReport{}, nil, invalid(\"%s target_natively_resumable is true for archive\", owner)\n418|\t\t}\n419|\t}\n420|\tvar staged *scalar.Digest\n421|\tvar stagedValue any\n422|\tvar live *scalar.Digest\n423|\tvar liveValue any\n424|\tif archive {\n425|\t\tif input.StagedReadBackEvidenceManifestID != nil {\n426|\t\t\treturn FidelityReport{}, nil, invalid(\"%s staged_read_back_evidence_manifest_id is not null for archive\", owner)\n427|\t\t}\n428|\t\tif input.LiveReadBackEvidenceManifestID != nil {\n429|\t\t\treturn FidelityReport{}, nil, invalid(\"%s live_read_back_evidence_manifest_id is not null for archive\", owner)\n430|\t\t}\n431|\t} else {\n432|\t\tif input.StagedReadBackEvidenceManifestID == nil {\n433|\t\t\treturn FidelityReport{}, nil, invalid(\"%s staged_read_back_evidence_manifest_id is null for target\", owner)\n434|\t\t}\n435|\t\tstagedID, err := scalar.ParseDigest(*input.StagedReadBackEvidenceManifestID)\n436|\t\tif err != nil {\n437|\t\t\treturn FidelityReport{}, nil, invalid(\"%s staged_read_back_evidence_manifest_id is not a digest: %v\", owner, err)\n438|\t\t}\n439|\t\tstaged = &stagedID\n440|\t\tstagedValue = stagedID.String()\n441|\t\tif input.LiveReadBackEvidenceManifestID == nil {\n442|\t\t\treturn FidelityReport{}, nil, invalid(\"%s live_read_back_evidence_manifest_id is null for target\", owner)\n443|\t\t}\n444|\t\tliveID, err := scalar.ParseDigest(*input.LiveReadBackEvidenceManifestID)\n445|\t\tif err != nil {\n446|\t\t\treturn FidelityReport{}, nil, invalid(\"%s live_read_back_evidence_manifest_id is not a digest: %v\", owner, err)\n447|\t\t}\n448|\t\tlive = &liveID\n449|\t\tliveValue = liveID.String()\n450|\t}\n451|\tattestations, err := parseSortedUniqueDigestStrings(input.AdapterAttestations, 0, 64, owner, \"adapter_attestations\")\n452|\tif err != nil {\n453|\t\treturn FidelityReport{}, nil, err\n454|\t}\n455|\tif _, err := clonebundle.EncodeExtensions(input.Extensions); err != nil {\n456|\t\treturn FidelityReport{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n457|\t}\n458|\textensions := input.Extensions\n459|\tif extensions == nil {\n460|\t\textensions = map[string]any{}\n461|\t}\n462|\treport := FidelityReport{\n463|\t\tScope:                            input.Scope,\n464|\t\tOperationID:                      operation,\n465|\t\tBundleID:                         bundle,\n466|\t\tSourceSnapshotDigest:             snapshot,\n467|\t\tCaptureManifestID:                captureID,\n468|\t\tCanonicalSessionID:               canonicalID,\n469|\t\tProjectionPlanID:                 plan,\n470|\t\tSourceEnvironment:                sourceTuple,\n471|\t\tTargetEnvironment:                targetTuple,\n472|\t\tProfile:                          input.Profile,\n473|\t\tRequiredDispositions:             required,\n474|\t\tForbidReasons:                    forbidden,\n475|\t\tRows:                             rows,\n476|\t\tCounts:                           counts,\n477|\t\tEventKindCounts:                  eventKinds,\n478|\t\tContentBlockCounts:               contentBlocks,\n479|\t\tByteCounts:                       byteCounts,\n480|\t\tReasonCounts:                     reasonCounts,\n481|\t\tRawBundleComplete:                input.RawBundleComplete,\n482|\t\tCanonicalComplete:                input.CanonicalComplete,\n483|\t\tTargetSemanticallyContinuable:    input.TargetSemanticallyContinuable,\n484|\t\tTargetNativelyResumable:          input.TargetNativelyResumable,\n485|\t\tStagedReadBackEvidenceManifestID: staged,\n486|\t\tLiveReadBackEvidenceManifestID:   live,\n487|\t\tAdapterAttestations:              attestations,\n488|\t}\n489|\tobject := map[string]any{\n490|\t\t\"schema\":                                fidelityReportSchema,\n491|\t\t\"schema_version\":                        fidelityReportVersion,\n492|\t\t\"scope\":                                 input.Scope,\n493|\t\t\"operation_id\":                          operation.String(),\n494|\t\t\"bundle_id\":                             bundle.String(),\n495|\t\t\"source_snapshot_digest\":                snapshot.String(),\n496|\t\t\"capture_manifest_id\":                   captureID.String(),\n497|\t\t\"canonical_session_id\":                  canonicalID.String(),\n498|\t\t\"projection_plan_id\":                    planValue,\n499|\t\t\"source_environment\":                    tupleObject(sourceTuple),\n500|\t\t\"target_environment\":                    targetValue,\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c625","stream":{"kind":"session","id":"01a0cfdc-90e4-7130-b73f-3760c218f2ff"},"sequence":365,"recorded_at":1780531400000725,"record_type":"event","durability":"durable","causation_id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5","run_stream":{"kind":"run","id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5"},"task_stream":{"kind":"task","id":"01a0cfdd-68ea-7841-80af-6b3832607cba"},"task_id":"01a0cfdd-68ea-7841-80af-6b3832607cba","event":{"kind":"completed","task_id":"01a0cfdd-68ea-7841-80af-6b3832607cba"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c627","stream":{"kind":"session","id":"01a0cfdc-90e4-7130-b73f-3760c218f2ff"},"sequence":366,"recorded_at":1780531400000727,"record_type":"event","durability":"durable","causation_id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5","run_stream":{"kind":"run","id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5"},"call_id":"call_01a0cfdd629c7534ba64f04b32c79734","text":"Read text file `internal/clonefidelity/record.go`.\n1|package clonefidelity\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"fmt\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|// This file validates and constructs FidelityDispositionRecord: the\n12|// closed per-item row Section 13.14.2 states. Exact requires an\n13|// empty reason set and every other disposition at least one reason;\n14|// synthesized requires no source canonical object; every\n15|// non-synthesized row carries captured source evidence IDs (their\n16|// resolution against the Capture Manifest needs the manifest as an\n17|// input and is a stated bound).\n18|\n19|var dispositionRecordMembers = map[string]bool{\n20|\t\"source_item_key\":            true,\n21|\t\"source_class\":               true,\n22|\t\"source_evidence_ids\":        true,\n23|\t\"canonical_object_id\":        true,\n24|\t\"target_locator\":             true,\n25|\t\"disposition\":                true,\n26|\t\"reason_codes\":               true,\n27|\t\"explanation\":                true,\n28|\t\"staged_evidence_object_ids\": true,\n29|\t\"live_evidence_object_ids\":   true,\n30|\t\"extensions\":                 true,\n31|}\n32|\n33|var dispositionRecordRequired = []string{\n34|\t\"source_item_key\",\n35|\t\"source_class\",\n36|\t\"source_evidence_ids\",\n37|\t\"canonical_object_id\",\n38|\t\"target_locator\",\n39|\t\"disposition\",\n40|\t\"reason_codes\",\n41|\t\"explanation\",\n42|\t\"staged_evidence_object_ids\",\n43|\t\"live_evidence_object_ids\",\n44|\t\"extensions\",\n45|}\n46|\n47|// DispositionRecord is one validated fidelity disposition row.\n48|type DispositionRecord struct {\n49|\tSourceItemKey           string\n50|\tSourceClass             string\n51|\tSourceEvidenceIDs       []scalar.Digest\n52|\tCanonicalObjectID       *scalar.Digest\n53|\tTargetLocator           *string\n54|\tDisposition             string\n55|\tReasonCodes             []string\n56|\tExplanation             string\n57|\tStagedEvidenceObjectIDs []scalar.Digest\n58|\tLiveEvidenceObjectIDs   []scalar.Digest\n59|}\n60|\n61|// DispositionRecordInput is the caller-supplied disposition row\n62|// candidate for Build. Nil CanonicalObjectID and TargetLocator seal\n63|// as null.\n64|type DispositionRecordInput struct {\n65|\tSourceItemKey           string\n66|\tSourceClass             string\n67|\tSourceEvidenceIDs       []string\n68|\tCanonicalObjectID       *string\n69|\tTargetLocator           *string\n70|\tDisposition             string\n71|\tReasonCodes             []string\n72|\tExplanation             string\n73|\tStagedEvidenceObjectIDs []string\n74|\tLiveEvidenceObjectIDs   []string\n75|\tExtensions              map[string]any\n76|}\n77|\n78|// buildDispositionRecord validates one caller-supplied row and\n79|// renders its closed object. Every rule is a refusal: unknown\n80|// dispositions, out-of-vocabulary reasons, broken bounds, unsorted\n81|// or duplicate arrays, exact with reasons, non-exact without\n82|// reasons, and synthesized with a source canonical object are all\n83|// refused, never repaired.\n84|func buildDispositionRecord(input DispositionRecordInput, index int) (DispositionRecord, map[string]any, error) {\n85|\towner := fmt.Sprintf(\"fidelity disposition record[%d]\", index)\n86|\tif !validText(input.SourceItemKey) {\n87|\t\treturn DispositionRecord{}, nil, invalid(\"%s source_item_key is not valid UTF-8\", owner)\n88|\t}\n89|\tif length := stringLength(input.SourceItemKey); length < 1 || length > 512 {\n90|\t\treturn DispositionRecord{}, nil, invalid(\"%s source_item_key is not a string[1..512]\", owner)\n91|\t}\n92|\tif !validText(input.SourceClass) {\n93|\t\treturn DispositionRecord{}, nil, invalid(\"%s source_class is not valid UTF-8\", owner)\n94|\t}\n95|\tif length := stringLength(input.SourceClass); length < 1 || length > 128 {\n96|\t\treturn DispositionRecord{}, nil, invalid(\"%s source_class is not a string[1..128]\", owner)\n97|\t}\n98|\tevidence, err := parseSortedUniqueDigestStrings(input.SourceEvidenceIDs, 1, 65536, owner, \"source_evidence_ids\")\n99|\tif err != nil {\n100|\t\treturn DispositionRecord{}, nil, err\n101|\t}\n102|\tvar canonical *scalar.Digest\n103|\tvar canonicalValue any\n104|\tif input.CanonicalObjectID != nil {\n105|\t\tid, err := scalar.ParseDigest(*input.CanonicalObjectID)\n106|\t\tif err != nil {\n107|\t\t\treturn DispositionRecord{}, nil, invalid(\"%s canonical_object_id is not a digest: %v\", owner, err)\n108|\t\t}\n109|\t\tcanonical = &id\n110|\t\tcanonicalValue = id.String()\n111|\t}\n112|\tvar locator *string\n113|\tvar locatorValue any\n114|\tif input.TargetLocator != nil {\n115|\t\tif !validText(*input.TargetLocator) {\n116|\t\t\treturn DispositionRecord{}, nil, invalid(\"%s target_locator is not valid UTF-8\", owner)\n117|\t\t}\n118|\t\tif length := stringLength(*input.TargetLocator); length < 1 || length > 1024 {\n119|\t\t\treturn DispositionRecord{}, nil, invalid(\"%s target_locator is not a string[1..1024]\", owner)\n120|\t\t}\n121|\t\tlocator = input.TargetLocator\n122|\t\tlocatorValue = *input.TargetLocator\n123|\t}\n124|\tif !ValidDisposition(input.Disposition) {\n125|\t\treturn DispositionRecord{}, nil, invalid(\"%s disposition %q is outside exact|semantic|summarized|opaque_preserved|synthesized|omitted|unrecoverable\", owner, input.Disposition)\n126|\t}\n127|\treasons, err := checkSortedUniqueReasonStrings(input.ReasonCodes, 0, 128, owner)\n128|\tif err != nil {\n129|\t\treturn DispositionRecord{}, nil, err\n130|\t}\n131|\tif err := checkRecordReasonRule(owner, input.Disposition, len(reasons)); err != nil {\n132|\t\treturn DispositionRecord{}, nil, err\n133|\t}\n134|\tif err := checkRecordCanonicalRule(owner, input.Disposition, canonical != nil); err != nil {\n135|\t\treturn DispositionRecord{}, nil, err\n136|\t}\n137|\tif !validText(input.Explanation) {\n138|\t\treturn DispositionRecord{}, nil, invalid(\"%s explanation is not valid UTF-8\", owner)\n139|\t}\n140|\tif length := stringLength(input.Explanation); length < 1 || length > 4096 {\n141|\t\treturn DispositionRecord{}, nil, invalid(\"%s explanation is not a string[1..4096]\", owner)\n142|\t}\n143|\tstaged, err := parseSortedUniqueDigestStrings(input.StagedEvidenceObjectIDs, 0, 65536, owner, \"staged_evidence_object_ids\")\n144|\tif err != nil {\n145|\t\treturn DispositionRecord{}, nil, err\n146|\t}\n147|\tlive, err := parseSortedUniqueDigestStrings(input.LiveEvidenceObjectIDs, 0, 65536, owner, \"live_evidence_object_ids\")\n148|\tif err != nil {\n149|\t\treturn DispositionRecord{}, nil, err\n150|\t}\n151|\tif _, err := clonebundle.EncodeExtensions(input.Extensions); err != nil {\n152|\t\treturn DispositionRecord{}, nil, invalid(\"%s extensions invalid: %v\", owner, err)\n153|\t}\n154|\textensions := input.Extensions\n155|\tif extensions == nil {\n156|\t\textensions = map[string]any{}\n157|\t}\n158|\trecord := DispositionRecord{\n159|\t\tSourceItemKey:           input.SourceItemKey,\n160|\t\tSourceClass:             input.SourceClass,\n161|\t\tSourceEvidenceIDs:       evidence,\n162|\t\tCanonicalObjectID:       canonical,\n163|\t\tTargetLocator:           locator,\n164|\t\tDisposition:             input.Disposition,\n165|\t\tReasonCodes:             reasons,\n166|\t\tExplanation:             input.Explanation,\n167|\t\tStagedEvidenceObjectIDs: staged,\n168|\t\tLiveEvidenceObjectIDs:   live,\n169|\t}\n170|\tobject := map[string]any{\n171|\t\t\"source_item_key\":            input.SourceItemKey,\n172|\t\t\"source_class\":               input.SourceClass,\n173|\t\t\"source_evidence_ids\":        digestStrings(evidence),\n174|\t\t\"canonical_object_id\":        canonicalValue,\n175|\t\t\"target_locator\":             locatorValue,\n176|\t\t\"disposition\":                input.Disposition,\n177|\t\t\"reason_codes\":               stringValues(reasons),\n178|\t\t\"explanation\":                input.Explanation,\n179|\t\t\"staged_evidence_object_ids\": digestStrings(staged),\n180|\t\t\"live_evidence_object_ids\":   digestStrings(live),\n181|\t\t\"extensions\":                 extensions,\n182|\t}\n183|\treturn record, object, nil\n184|}\n185|\n186|// checkRecordReasonRule enforces the reason-set rule both entries\n187|// share: exact requires an empty reason set and every other\n188|// disposition at least one reason.\n189|func checkRecordReasonRule(owner, disposition string, reasonCount int) error {\n190|\tif disposition == \"exact\" {\n191|\t\tif reasonCount != 0 {\n192|\t\t\treturn invalid(\"%s exact carries %d reason_codes, want an empty reason set\", owner, reasonCount)\n193|\t\t}\n194|\t\treturn nil\n195|\t}\n196|\tif reasonCount < 1 {\n197|\t\treturn invalid(\"%s %s carries no reason_codes, want at least one reason\", owner, disposition)\n198|\t}\n199|\treturn nil\n200|}\n201|\n202|// checkRecordCanonicalRule enforces the canonical-object rule both\n203|// entries share: synthesized requires no source canonical object.\n204|// Non-synthesized rows admit a digest or null: capture items that\n205|// never normalized (omitted, unrecoverable) carry null, canonical\n206|// events carry their object ID.\n207|func checkRecordCanonicalRule(owner, disposition string, hasCanonical bool) error {\n208|\tif disposition == \"synthesized\" && hasCanonical {\n209|\t\treturn invalid(\"%s synthesized carries a source canonical object\", owner)\n210|\t}\n211|\treturn nil\n212|}\n213|\n214|// decodeDispositionRecord validates one closed disposition row:\n215|// exact members, bounded scalars, the disposition and reason\n216|// vocabularies, sorted-unique arrays, the exact/synthesized rules,\n217|// and closed extensions.\n218|func decodeDispositionRecord(raw json.RawMessage, index int) (DispositionRecord, error) {\n219|\towner := \"fidelity disposition record\"\n220|\tmembers, fault := decodeStrictObject(raw)\n221|\tif fault != nil {\n222|\t\treturn DispositionRecord{}, invalid(\"%s[%d] %s (%s)\", owner, index, fault.detail, memberField(fault.member))\n223|\t}\n224|\tif name, unknown := unknownMember(members, dispositionRecordMembers); unknown {\n225|\t\treturn DispositionRecord{}, invalid(\"%s[%d] carries unknown member %q\", owner, index, name)\n226|\t}\n227|\tif name, missing := missingMember(members, dispositionRecordRequired); missing {\n228|\t\treturn DispositionRecord{}, invalid(\"%s[%d] misses a required member %q\", owner, index, name)\n229|\t}\n230|\tkey, ok := checkStringBounds(members[\"source_item_key\"], 1, 512)\n231|\tif !ok {\n232|\t\treturn DispositionRecord{}, invalid(\"%s[%d] source_item_key is not a string[1..512]\", owner, index)\n233|\t}\n234|\tclass, ok := checkStringBounds(members[\"source_class\"], 1, 128)\n235|\tif !ok {\n236|\t\treturn DispositionRecord{}, invalid(\"%s[%d] source_class is not a string[1..128]\", owner, index)\n237|\t}\n238|\tevidence, ok := checkSortedUniqueDigests(members[\"source_evidence_ids\"], 1, 65536)\n239|\tif !ok {\n240|\t\treturn DispositionRecord{}, invalid(\"%s[%d] source_evidence_ids are not sorted unique digest[1..65536]\", owner, index)\n241|\t}\n242|\tvar canonical *scalar.Digest\n243|\tif !isNull(members[\"canonical_object_id\"]) {\n244|\t\tid, ok := checkDigest(members[\"canonical_object_id\"])\n245|\t\tif !ok {\n246|\t\t\treturn DispositionRecord{}, invalid(\"%s[%d] canonical_object_id is not a digest or null\", owner, index)\n247|\t\t}\n248|\t\tcanonical = &id\n249|\t}\n250|\tvar locator *string\n251|\tif !isNull(members[\"target_locator\"]) {\n252|\t\tvalue, ok := checkStringBounds(members[\"target_locator\"], 1, 1024)\n253|\t\tif !ok {\n254|\t\t\treturn DispositionRecord{}, invalid(\"%s[%d] target_locator is not a string[1..1024] or null\", owner, index)\n255|\t\t}\n256|\t\tlocator = &value\n257|\t}\n258|\tdisposition, ok := rawString(members[\"disposition\"])\n259|\tif !ok || !ValidDisposition(disposition) {\n260|\t\treturn DispositionRecord{}, invalid(\"%s[%d] disposition is outside exact|semantic|summarized|opaque_preserved|synthesized|omitted|unrecoverable\", owner, index)\n261|\t}\n262|\treasons, ok := checkSortedUniqueStrings(members[\"reason_codes\"], 1, 128, 0, 128)\n263|\tif !ok {\n264|\t\treturn DispositionRecord{}, invalid(\"%s[%d] reason_codes are not sorted unique string[1..128][0..128]\", owner, index)\n265|\t}\n266|\tfor _, reason := range reasons {\n267|\t\tif !ValidReasonCode(reason) {\n268|\t\t\treturn DispositionRecord{}, invalid(\"%s[%d] reason_codes carry %q outside the core and reverse-DNS reason vocabulary\", owner, index, reason)\n269|\t\t}\n270|\t}\n271|\trowOwner := fmt.Sprintf(\"%s[%d]\", owner, index)\n272|\tif err := checkRecordReasonRule(rowOwner, disposition, len(reasons)); err != nil {\n273|\t\treturn DispositionRecord{}, err\n274|\t}\n275|\tif err := checkRecordCanonicalRule(rowOwner, disposition, canonical != nil); err != nil {\n276|\t\treturn DispositionRecord{}, err\n277|\t}\n278|\texplanation, ok := checkStringBounds(members[\"explanation\"], 1, 4096)\n279|\tif !ok {\n280|\t\treturn DispositionRecord{}, invalid(\"%s[%d] explanation is not a string[1..4096]\", owner, index)\n281|\t}\n282|\tstaged, ok := checkSortedUniqueDigests(members[\"staged_evidence_object_ids\"], 0, 65536)\n283|\tif !ok {\n284|\t\treturn DispositionRecord{}, invalid(\"%s[%d] staged_evidence_object_ids are not sorted unique digest[0..65536]\", owner, index)\n285|\t}\n286|\tlive, ok := checkSortedUniqueDigests(members[\"live_evidence_object_ids\"], 0, 65536)\n287|\tif !ok {\n288|\t\treturn DispositionRecord{}, invalid(\"%s[%d] live_evidence_object_ids are not sorted unique digest[0..65536]\", owner, index)\n289|\t}\n290|\tif extensionsFault := checkExtensionsClosed(members[\"extensions\"]); extensionsFault != nil {\n291|\t\treturn DispositionRecord{}, invalid(\"%s[%d] extensions %s\", owner, index, extensionsFault)\n292|\t}\n293|\treturn DispositionRecord{\n294|\t\tSourceItemKey:           key,\n295|\t\tSourceClass:             class,\n296|\t\tSourceEvidenceIDs:       evidence,\n297|\t\tCanonicalObjectID:       canonical,\n298|\t\tTargetLocator:           locator,\n299|\t\tDisposition:             disposition,\n300|\t\tReasonCodes:             reasons,\n301|\t\tExplanation:             explanation,\n302|\t\tStagedEvidenceObjectIDs: staged,\n303|\t\tLiveEvidenceObjectIDs:   live,\n304|\t}, nil\n305|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c629","stream":{"kind":"session","id":"01a0cfdc-90e4-7130-b73f-3760c218f2ff"},"sequence":367,"recorded_at":1780531400000729,"record_type":"event","durability":"durable","causation_id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5","run_stream":{"kind":"run","id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5"},"call_id":"call_01a0cfdd63b4732fb2509154df087e92","text":"Read text file `internal/clonefidelity/report.go`.\n1|package clonefidelity\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"sort\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n10|)\n11|\n12|// This file validates and constructs Fidelity Report 1.0.0: the\n13|// closed archive/target report Section 13.14.2 states with its\n14|// per-item disposition rows and reconciled aggregate maps. Counts\n15|// and reason counts derive from the rows and are never accepted;\n16|// the per-kind and per-block breakdowns reconcile to those derived\n17|// totals per disposition; byte values admit the exact\n18|// seven-disposition key set with uint53 values (rows carry no byte\n19|// measure, so no row reconciliation is expressible — a stated\n20|// bound).\n21|\n22|const (\n23|\tfidelityReportSchema  = \"urn:ax:schema:fidelity-report\"\n24|\tfidelityReportVersion = \"1.0.0\"\n25|\tfidelityReportSelf    = \"fidelity_report_id\"\n26|)\n27|\n28|// maxReportRows is the Fidelity Report dispositions bound:\n29|// FidelityDispositionRecord[1..1000000].\n30|const maxReportRows = 1000000\n31|\n32|var fidelityReportMembers = map[string]bool{\n33|\t\"schema\": true, \"schema_version\": true, \"fidelity_report_id\": true,\n34|\t\"scope\": true, \"operation_id\": true, \"bundle_id\": true,\n35|\t\"source_snapshot_digest\": true, \"capture_manifest_id\": true, \"canonical_session_id\": true,\n36|\t\"projection_plan_id\": true, \"source_environment\": true, \"target_environment\": true,\n37|\t\"profile\": true, \"required_dispositions\": true, \"forbid_reasons\": true,\n38|\t\"dispositions\": true, \"counts\": true, \"event_kind_counts\": true,\n39|\t\"content_block_counts\": true, \"byte_counts\": true, \"reason_counts\": true,\n40|\t\"raw_bundle_complete\": true, \"canonical_complete\": true,\n41|\t\"target_semantically_continuable\": true, \"target_natively_resumable\": true,\n42|\t\"staged_read_back_evidence_manifest_id\": true, \"live_read_back_evidence_manifest_id\": true,\n43|\t\"adapter_attestations\": true, \"extensions\": true,\n44|}\n45|\n46|var fidelityReportRequired = []string{\n47|\t\"schema\", \"schema_version\", \"fidelity_report_id\",\n48|\t\"scope\", \"operation_id\", \"bundle_id\",\n49|\t\"source_snapshot_digest\", \"capture_manifest_id\", \"canonical_session_id\",\n50|\t\"projection_plan_id\", \"source_environment\", \"target_environment\",\n51|\t\"profile\", \"required_dispositions\", \"forbid_reasons\",\n52|\t\"dispositions\", \"counts\", \"event_kind_counts\",\n53|\t\"content_block_counts\", \"byte_counts\", \"reason_counts\",\n54|\t\"raw_bundle_complete\", \"canonical_complete\",\n55|\t\"target_semantically_continuable\", \"target_natively_resumable\",\n56|\t\"staged_read_back_evidence_manifest_id\", \"live_read_back_evidence_manifest_id\",\n57|\t\"adapter_attestations\", \"extensions\",\n58|}\n59|\n60|// FidelityCounts is the exact seven-member count record Section\n61|// 13.14.2 states: exact, semantic, summarized, opaque_preserved,\n62|// synthesized, omitted, and unrecoverable.\n63|type FidelityCounts struct {\n64|\tExact           uint64\n65|\tSemantic        uint64\n66|\tSummarized      uint64\n67|\tOpaquePreserved uint64\n68|\tSynthesized     uint64\n69|\tOmitted         uint64\n70|\tUnrecoverable   uint64\n71|}\n72|\n73|// countOf returns the count for one disposition. The caller gates\n74|// vocabulary; an unknown disposition reads zero.\n75|func (counts FidelityCounts) countOf(disposition string) uint64 {\n76|\tswitch disposition {\n77|\tcase \"exact\":\n78|\t\treturn counts.Exact\n79|\tcase \"semantic\":\n80|\t\treturn counts.Semantic\n81|\tcase \"summarized\":\n82|\t\treturn counts.Summarized\n83|\tcase \"opaque_preserved\":\n84|\t\treturn counts.OpaquePreserved\n85|\tcase \"synthesized\":\n86|\t\treturn counts.Synthesized\n87|\tcase \"omitted\":\n88|\t\treturn counts.Omitted\n89|\tcase \"unrecoverable\":\n90|\t\treturn counts.Unrecoverable\n91|\tdefault:\n92|\t\treturn 0\n93|\t}\n94|}\n95|\n96|// addRow folds one row disposition into the totals. Every counts\n97|// derivation both entries share flows through this switch.\n98|func (counts *FidelityCounts) addRow(disposition string) {\n99|\tswitch disposition {\n100|\tcase \"exact\":\n101|\t\tcounts.Exact++\n102|\tcase \"semantic\":\n103|\t\tcounts.Semantic++\n104|\tcase \"summarized\":\n105|\t\tcounts.Summarized++\n106|\tcase \"opaque_preserved\":\n107|\t\tcounts.OpaquePreserved++\n108|\tcase \"synthesized\":\n109|\t\tcounts.Synthesized++\n110|\tcase \"omitted\":\n111|\t\tcounts.Omitted++\n112|\tcase \"unrecoverable\":\n113|\t\tcounts.Unrecoverable++\n114|\t}\n115|}\n116|\n117|func (counts FidelityCounts) object() map[string]any {\n118|\treturn map[string]any{\n119|\t\t\"exact\":            counts.Exact,\n120|\t\t\"semantic\":         counts.Semantic,\n121|\t\t\"summarized\":       counts.Summarized,\n122|\t\t\"opaque_preserved\": counts.OpaquePreserved,\n123|\t\t\"synthesized\":      counts.Synthesized,\n124|\t\t\"omitted\":          counts.Omitted,\n125|\t\t\"unrecoverable\":    counts.Unrecoverable,\n126|\t}\n127|}\n128|\n129|// deriveCounts counts the rows per disposition. Row vocabularies are\n130|// gated before derivation, so every row folds into exactly one arm.\n131|func deriveCounts(rows []DispositionRecord) FidelityCounts {\n132|\tvar counts FidelityCounts\n133|\tfor _, row := range rows {\n134|\t\tcounts.addRow(row.Disposition)\n135|\t}\n136|\treturn counts\n137|}\n138|\n139|// deriveReasonCounts counts, per reason, the rows naming it. Row\n140|// reason sets are sorted unique, so each row contributes at most\n141|// one to each reason.\n142|func deriveReasonCounts(rows []DispositionRecord) map[string]uint64 {\n143|\tderived := map[string]uint64{}\n144|\tfor _, row := range rows {\n145|\t\tfor _, reason := range row.ReasonCodes {\n146|\t\t\tderived[reason]++\n147|\t\t}\n148|\t}\n149|\treturn derived\n150|}\n151|\n152|// checkRowCount admits the dispositions cardinality both entries\n153|// share: FidelityDispositionRecord[1..1000000]. It is factored so\n154|// the exact bound is pinned at the edge and edge+1 without sealing\n155|// a million-row report in the suite; entry reachability is proven\n156|// by the entry-level refusal rows (see TRACEABILITY.md).\n157|func checkRowCount(count int) error {\n158|\tif count < 1 || count > maxReportRows {\n159|\t\treturn invalid(\"fidelity report carries %d dispositions, want [1..1000000]\", count)\n160|\t}\n161|\treturn nil\n162|}\n163|\n164|// checkRowOrder enforces the row ordering both entries share:\n165|// source rows sorted unique by item key, then synthesized rows\n166|// sorted unique by item key, with keys unique across all rows.\n167|func checkRowOrder(rows []DispositionRecord) error {\n168|\tseen := make(map[string]bool, len(rows))\n169|\tseenSynthesized := false\n170|\tpreviousSource := \"\"\n171|\tpreviousSynthesized := \"\"\n172|\tfor _, row := range rows {\n173|\t\tif seen[row.SourceItemKey] {\n174|\t\t\treturn invalid(\"fidelity report dispositions carry duplicate source item key %q\", row.SourceItemKey)\n175|\t\t}\n176|\t\tseen[row.SourceItemKey] = true\n177|\t\tif row.Disposition == \"synthesized\" {\n178|\t\t\tseenSynthesized = true\n179|\t\t\tif previousSynthesized != \"\" && row.SourceItemKey <= previousSynthesized {\n180|\t\t\t\treturn invalid(\"fidelity report synthesized dispositions are not sorted unique by source item key\")\n181|\t\t\t}\n182|\t\t\tpreviousSynthesized = row.SourceItemKey\n183|\t\t\tcontinue\n184|\t\t}\n185|\t\tif seenSynthesized {\n186|\t\t\treturn invalid(\"fidelity report dispositions order a source row after synthesized rows\")\n187|\t\t}\n188|\t\tif previousSource != \"\" && row.SourceItemKey <= previousSource {\n189|\t\t\treturn invalid(\"fidelity report source dispositions are not sorted unique by source item key\")\n190|\t\t}\n191|\t\tpreviousSource = row.SourceItemKey\n192|\t}\n193|\treturn nil\n194|}\n195|\n196|// checkBreakdownSums reconciles one closed breakdown map to the\n197|// derived totals: for every disposition, the values summed over\n198|// every key equal the row-derived count. The sums cannot overflow:\n199|// 26 closed keys times (2^53-1) stays below 2^57.\n200|func checkBreakdownSums(owner string, breakdown map[string]FidelityCounts, totals FidelityCounts) error {\n201|\tfor _, disposition := range dispositions {\n202|\t\tvar sum uint64\n203|\t\tfor _, counts := range breakdown {\n204|\t\t\tsum += counts.countOf(disposition)\n205|\t\t}\n206|\t\tif sum != totals.countOf(disposition) {\n207|\t\t\treturn invalid(\"%s reconciles %d %s rows, want %d from the disposition rows\", owner, sum, disposition, totals.countOf(disposition))\n208|\t\t}\n209|\t}\n210|\treturn nil\n211|}\n212|\n213|// FidelityReport is one validated Fidelity Report 1.0.0.\n214|type FidelityReport struct {\n215|\tReportID                         scalar.Digest\n216|\tScope                            string\n217|\tOperationID                      scalar.UUIDv7\n218|\tBundleID                         scalar.UUIDv7\n219|\tSourceSnapshotDigest             scalar.Digest\n220|\tCaptureManifestID                scalar.Digest\n221|\tCanonicalSessionID               scalar.Digest\n222|\tProjectionPlanID                 *scalar.Digest\n223|\tSourceEnvironment                sessadapter.Tuple\n224|\tTargetEnvironment                *sessadapter.Tuple\n225|\tProfile                          string\n226|\tRequiredDispositions             map[string][]string\n227|\tForbidReasons                    []string\n228|\tRows                             []DispositionRecord\n229|\tCounts                           FidelityCounts\n230|\tEventKindCounts                  map[string]FidelityCounts\n231|\tContentBlockCounts               map[string]FidelityCounts\n232|\tByteCounts                       map[string]uint64\n233|\tReasonCounts                     map[string]uint64\n234|\tRawBundleComplete                bool\n235|\tCanonicalComplete                bool\n236|\tTargetSemanticallyContinuable    bool\n237|\tTargetNativelyResumable          bool\n238|\tStagedReadBackEvidenceManifestID *scalar.Digest\n239|\tLiveReadBackEvidenceManifestID   *scalar.Digest\n240|\tAdapterAttestations              []scalar.Digest\n241|}\n242|\n243|// FidelityReportInput is the caller-supplied fidelity report\n244|// candidate for Build. Counts and reason counts are derived from\n245|// Rows and are never accepted; the per-kind, per-block, and\n246|// per-disposition breakdowns are caller-supplied and reconciled.\n247|// Nil digest pointers and empty TargetEnvironment seal as null.\n248|type FidelityReportInput struct {\n249|\tScope                            string\n250|\tOperationID                      string\n251|\tBundleID                         string\n252|\tSourceSnapshotDigest             string\n253|\tCaptureManifestID                string\n254|\tCanonicalSessionID               string\n255|\tProjectionPlanID                 *string\n256|\tSourceEnvironment                []byte\n257|\tTargetEnvironment                []byte\n258|\tProfile                          string\n259|\tRequiredDispositions             map[string][]string\n260|\tForbidReasons                    []string\n261|\tRows                             []DispositionRecordInput\n262|\tEventKindCounts                  map[string]FidelityCounts\n263|\tContentBlockCounts               map[string]FidelityCounts\n264|\tByteCounts                       map[string]uint64\n265|\tRawBundleComplete                bool\n266|\tCanonicalComplete                bool\n267|\tTargetSemanticallyContinuable    bool\n268|\tTargetNativelyResumable          bool\n269|\tStagedReadBackEvidenceManifestID *string\n270|\tLiveReadBackEvidenceManifestID   *string\n271|\tAdapterAttestations              []string\n272|\tExtensions                       map[string]any\n273|}\n274|\n275|// BuildFidelityReport constructs one closed Fidelity Report 1.0.0\n276|// as canonical bytes. Identical inputs produce byte-identical\n277|// outputs. Counts and reason counts derive from the rows; every\n278|// other closed-shape, vocabulary, branch, order, and reconciliation\n279|// rule is a refusal, never a repair.\n280|func BuildFidelityReport(input FidelityReportInput) ([]byte, error) {\n281|\t_, object, err := buildFidelityReport(input)\n282|\tif err != nil {\n283|\t\treturn nil, err\n284|\t}\n285|\tomitted, err := canonicalizeObject(object)\n286|\tif err != nil {\n287|\t\treturn nil, err\n288|\t}\n289|\treportID := scalar.SHA256Digest(omitted)\n290|\tobject[fidelityReportSelf] = reportID.String()\n291|\treturn canonicalizeObject(object)\n292|}\n293|\n294|func buildFidelityReport(input FidelityReportInput) (FidelityReport, map[string]any, error) {\n295|\towner := \"fidelity report\"\n296|\tarchive := false\n297|\tswitch input.Scope {\n298|\tcase \"archive\":\n299|\t\tarchive = true\n300|\tcase \"target\":\n301|\tdefault:\n302|\t\treturn FidelityReport{}, nil, invalid(\"%s scope is outside archive|target\", owner)\n303|\t}\n304|\toperation, err := scalar.ParseUUIDv7(input.OperationID)\n305|\tif err != nil {\n306|\t\treturn FidelityReport{}, nil, invalid(\"%s operation_id is not a UUIDv7: %v\", owner, err)\n307|\t}\n308|\tbundle, err := scalar.ParseUUIDv7(input.BundleID)\n309|\tif err != nil {\n310|\t\treturn FidelityReport{}, nil, invalid(\"%s bundle_id is not a UUIDv7: %v\", owner, err)\n311|\t}\n312|\tsnapshot, err := scalar.ParseDigest(input.SourceSnapshotDigest)\n313|\tif err != nil {\n314|\t\treturn FidelityReport{}, nil, invalid(\"%s source_snapshot_digest is not a digest: %v\", owner, err)\n315|\t}\n316|\tcaptureID, err := scalar.ParseDigest(input.CaptureManifestID)\n317|\tif err != nil {\n318|\t\treturn FidelityReport{}, nil, invalid(\"%s capture_manifest_id is not a digest: %v\", owner, err)\n319|\t}\n320|\tcanonicalID, err := scalar.ParseDigest(input.CanonicalSessionID)\n321|\tif err != nil {\n322|\t\treturn FidelityReport{}, nil, invalid(\"%s canonical_session_id is not a digest: %v\", owner, err)\n323|\t}\n324|\tvar plan *scalar.Digest\n325|\tvar planValue any\n326|\tif archive {\n327|\t\tif input.ProjectionPlanID != nil {\n328|\t\t\treturn FidelityReport{}, nil, invalid(\"%s projection_plan_id is not null for archive\", owner)\n329|\t\t}\n330|\t} else {\n331|\t\tif input.ProjectionPlanID == nil {\n332|\t\t\treturn FidelityReport{}, nil, invalid(\"%s projection_plan_id is null for target\", owner)\n333|\t\t}\n334|\t\tid, err := scalar.ParseDigest(*input.ProjectionPlanID)\n335|\t\tif err != nil {\n336|\t\t\treturn FidelityReport{}, nil, invalid(\"%s projection_plan_id is not a digest: %v\", owner, err)\n337|\t\t}\n338|\t\tplan = &id\n339|\t\tplanValue = id.String()\n340|\t}\n341|\tsourceTuple, err := sessadapter.DecodeTuple(json.RawMessage(input.SourceEnvironment))\n342|\tif err != nil {\n343|\t\treturn FidelityReport{}, nil, invalid(\"%s source_environment is not an Environment Tuple: %v\", owner, err)\n344|\t}\n345|\tvar targetTuple *sessadapter.Tuple\n346|\tvar targetValue any\n347|\tif archive {\n348|\t\tif len(input.TargetEnvironment) != 0 {\n349|\t\t\treturn FidelityReport{}, nil, invalid(\"%s target_environment is not null for archive\", owner)\n350|\t\t}\n351|\t} else {\n352|\t\ttuple, err := sessadapter.DecodeTuple(json.RawMessage(input.TargetEnvironment))\n353|\t\tif err != nil {\n354|\t\t\treturn FidelityReport{}, nil, invalid(\"%s target_environment is not an Environment Tuple: %v\", owner, err)\n355|\t\t}\n356|\t\ttargetTuple = &tuple\n357|\t\ttargetValue = tupleObject(tuple)\n358|\t}\n359|\tif !ValidProfile(input.Profile) {\n360|\t\treturn FidelityReport{}, nil, invalid(\"%s profile %q is outside strict_exact|maximal_safe|compact|messages_only|archive_only\", owner, input.Profile)\n361|\t}\n362|\tif archive && input.Profile != \"archive_only\" {\n363|\t\treturn FidelityReport{}, nil, invalid(\"%s profile is %q for archive, want archive_only\", owner, input.Profile)\n364|\t}\n365|\tif !archive && input.Profile == \"archive_only\" {\n366|\t\treturn FidelityReport{}, nil, invalid(\"%s profile is archive_only for target\", owner)\n367|\t}\n368|\trequired, err := buildRequiredDispositions(input.RequiredDispositions)\n369|\tif err != nil {\n370|\t\treturn FidelityReport{}, nil, err\n371|\t}\n372|\tforbidden, err := checkSortedUniqueBoundedStrings(input.ForbidReasons, 1, 128, 0, 128, owner, \"forbid_reasons\")\n373|\tif err != nil {\n374|\t\treturn FidelityReport{}, nil, err\n375|\t}\n376|\tif err := checkRowCount(len(input.Rows)); err != nil {\n377|\t\treturn FidelityReport{}, nil, err\n378|\t}\n379|\trows := make([]DispositionRecord, 0, len(input.Rows))\n380|\tobjects := make([]any, 0, len(input.Rows))\n381|\tfor index, candidate := range input.Rows {\n382|\t\trow, object, err := buildDispositionRecord(candidate, index)\n383|\t\tif err != nil {\n384|\t\t\treturn FidelityReport{}, nil, err\n385|\t\t}\n386|\t\trows = append(rows, row)\n387|\t\tobjects = append(objects, object)\n388|\t}\n389|\tif err := checkRowOrder(rows); err != nil {\n390|\t\treturn FidelityReport{}, nil, err\n391|\t}\n392|\tcounts := deriveCounts(rows)\n393|\treasonCounts := deriveReasonCounts(rows)\n394|\teventKinds, err := buildBreakdown(input.EventKindCounts, clonebundle.EventKinds(), \"event_kind_counts\")\n395|\tif err != 