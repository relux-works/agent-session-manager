{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c65b","stream":{"kind":"session","id":"01a0cfdc-90e4-7130-b73f-3760c218f2ff"},"sequence":392,"recorded_at":1780531400000779,"record_type":"event","durability":"durable","causation_id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5","run_stream":{"kind":"run","id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5"},"task_stream":{"kind":"task","id":"01a0cfdd-762a-79b1-87c2-c958b20cbd24"},"task_id":"01a0cfdd-762a-79b1-87c2-c958b20cbd24","event":{"kind":"output","task_id":"01a0cfdd-762a-79b1-87c2-c958b20cbd24","chunk":"Read text file `internal/clonefidelity/report.go`.\n(499 line(s) above)\n500|\t\t\"target_environment\":                    targetValue,\n501|\t\t\"profile\":                               input.Profile,\n502|\t\t\"required_dispositions\":                 requiredObject(required),\n503|\t\t\"forbid_reasons\":                        stringValues(forbidden),\n504|\t\t\"dispositions\":                          objects,\n505|\t\t\"counts\":                                counts.object(),\n506|\t\t\"event_kind_counts\":                     breakdownObject(eventKinds),\n507|\t\t\"content_block_counts\":                  breakdownObject(contentBlocks),\n508|\t\t\"byte_counts\":                           byteCountsObject(byteCounts),\n509|\t\t\"reason_counts\":                         reasonCountsObject(reasonCounts),\n510|\t\t\"raw_bundle_complete\":                   input.RawBundleComplete,\n511|\t\t\"canonical_complete\":                    input.CanonicalComplete,\n512|\t\t\"target_semantically_continuable\":       input.TargetSemanticallyContinuable,\n513|\t\t\"target_natively_resumable\":             input.TargetNativelyResumable,\n514|\t\t\"staged_read_back_evidence_manifest_id\": stagedValue,\n515|\t\t\"live_read_back_evidence_manifest_id\":   liveValue,\n516|\t\t\"adapter_attestations\":                  digestStrings(attestations),\n517|\t\t\"extensions\":                            extensions,\n518|\t}\n519|\treturn report, object, nil\n520|}\n521|\n522|// buildRequiredDispositions validates the caller-supplied policy\n523|// map: closed capture-class keys (the spec word for a closed class\n524|// vocabulary) to sorted unique non-empty disposition sets. Keys\n525|// validate in sorted order so multi-key refusals are deterministic.\n526|func buildRequiredDispositions(input map[string][]string) (map[string][]string, error) {\n527|\towner := \"fidelity report required_dispositions\"\n528|\tkeys := make([]string, 0, len(input))\n529|\tfor class := range input {\n530|\t\tkeys = append(keys, class)\n531|\t}\n532|\tsort.Strings(keys)\n533|\trequired := make(map[string][]string, len(input))\n534|\tfor _, class := range keys {\n535|\t\tif !clonebundle.ValidCaptureClass(class) {\n536|\t\t\treturn nil, invalid(\"%s carry unknown class %q\", owner, class)\n537|\t\t}\n538|\t\tvalues := input[class]\n539|\t\tif len(values) < 1 {\n540|\t\t\treturn nil, invalid(\"%s[%q] carry no dispositions, want a non-empty set\", owner, class)\n541|\t\t}\n542|\t\tprevious := \"\"\n543|\t\tfor index, disposition := range values {\n544|\t\t\tif !ValidDisposition(disposition) {\n545|\t\t\t\treturn nil, invalid(\"%s[%q][%d] disposition is outside exact|semantic|summarized|opaque_preserved|synthesized|omitted|unrecoverable\", owner, class, index)\n546|\t\t\t}\n547|\t\t\tif index > 0 && disposition <= previous {\n548|\t\t\t\treturn nil, invalid(\"%s[%q] are not sorted unique\", owner, class)\n549|\t\t\t}\n550|\t\t\tprevious = disposition\n551|\t\t}\n552|\t\trequired[class] = append([]string(nil), values...)\n553|\t}\n554|\treturn required, nil\n555|}\n556|\n557|// buildBreakdown validates one caller-supplied closed breakdown map:\n558|// exactly the owner vocabulary keys, each an exact FidelityCounts\n559|// of uint53 values.\n560|func buildBreakdown(input map[string]FidelityCounts, keys []string, member string) (map[string]FidelityCounts, error) {\n561|\towner := \"fidelity report \" + member\n562|\tallowed := make(map[string]bool, len(keys))\n563|\tfor _, key := range keys {\n564|\t\tallowed[key] = true\n565|\t}\n566|\tfor key := range input {\n567|\t\tif !allowed[key] {\n568|\t\t\treturn nil, invalid(\"%s carry unknown key %q\", owner, key)\n569|\t\t}\n570|\t}\n571|\tbreakdown := make(map[string]FidelityCounts, len(keys))\n572|\tfor _, key := range keys {\n573|\t\tcounts, present := input[key]\n574|\t\tif !present {\n575|\t\t\treturn nil, invalid(\"%s miss key %q\", owner, key)\n576|\t\t}\n577|\t\tfor _, disposition := range dispositions {\n578|\t\t\tif counts.countOf(disposition) > maxUint53 {\n579|\t\t\t\treturn nil, invalid(\"%s[%q] %s exceeds uint53\", owner, key, disposition)\n580|\t\t\t}\n581|\t\t}\n582|\t\tbreakdown[key] = counts\n583|\t}\n584|\treturn breakdown, nil\n585|}\n586|\n587|// buildByteCounts validates the caller-supplied byte map: exactly\n588|// the seven dispositions to uint53 values. Values admit any uint53:\n589|// rows carry no byte measure, so no row reconciliation is\n590|// expressible (a stated bound).\n591|func buildByteCounts(input map[string]uint64) (map[string]uint64, error) {\n592|\towner := \"fidelity report byte_counts\"\n593|\tfor key := range input {\n594|\t\tif !ValidDisposition(key) {\n595|\t\t\treturn nil, invalid(\"%s carry unknown disposition %q\", owner, key)\n596|\t\t}\n597|\t}\n598|\tcounts := make(map[string]uint64, len(dispositions))\n599|\tfor _, disposition := range dispositions {\n600|\t\tvalue, present := input[disposition]\n601|\t\tif !present {\n602|\t\t\treturn nil, invalid(\"%s miss disposition %q\", owner, disposition)\n603|\t\t}\n604|\t\tif value > maxUint53 {\n605|\t\t\treturn nil, invalid(\"%s[%q] exceeds uint53\", owner, disposition)\n606|\t\t}\n607|\t\tcounts[disposition] = value\n608|\t}\n609|\treturn counts, nil\n610|}\n611|\n612|func tupleObject(tuple sessadapter.Tuple) map[string]any {\n613|\treturn map[string]any{\n614|\t\t\"environment_id\":           tuple.EnvironmentID,\n615|\t\t\"environment_version\":      tuple.Version,\n616|\t\t\"platform\":                 tuple.Platform,\n617|\t\t\"architecture\":             tuple.Architecture,\n618|\t\t\"store_schema_fingerprint\": tuple.StoreFingerprint,\n619|\t\t\"adapter_version\":          tuple.AdapterVersion,\n620|\t}\n621|}\n622|\n623|func requiredObject(required map[string][]string) map[string]any {\n624|\tobject := make(map[string]any, len(required))\n625|\tfor class, values := range required {\n626|\t\tobject[class] = stringValues(values)\n627|\t}\n628|\treturn object\n629|}\n630|\n631|func breakdownObject(breakdown map[string]FidelityCounts) map[string]any {\n632|\tobject := make(map[string]any, len(breakdown))\n633|\tfor key, counts := range breakdown {\n634|\t\tobject[key] = counts.object()\n635|\t}\n636|\treturn object\n637|}\n638|\n639|func byteCountsObject(counts map[string]uint64) map[string]any {\n640|\tobject := make(map[string]any, len(counts))\n641|\tfor disposition, value := range counts {\n642|\t\tobject[disposition] = value\n643|\t}\n644|\treturn object\n645|}\n646|\n647|func reasonCountsObject(counts map[string]uint64) map[string]any {\n648|\tobject := make(map[string]any, len(counts))\n649|\tfor reason, value := range counts {\n650|\t\tobject[reason] = value\n651|\t}\n652|\treturn object\n653|}\n654|\n655|// DecodeFidelityReport validates one closed Fidelity Report 1.0.0:\n656|// exact members, schema/version, scalar bounds, closed\n657|// vocabularies, sorted-unique arrays, the archive/target\n658|// nullability branches, row ordering, aggregate reconciliation\n659|// against the rows, and self-digest agreement.\n660|func DecodeFidelityReport(data []byte) (FidelityReport, error) {\n661|\towner := \"fidelity report\"\n662|\tmembers, fault := decodeStrictObject(data)\n663|\tif fault != nil {\n664|\t\treturn FidelityReport{}, invalid(\"%s %s (%s)\", owner, fault.detail, memberField(fault.member))\n665|\t}\n666|\tif name, unknown := unknownMember(members, fidelityReportMembers); unknown {\n667|\t\treturn FidelityReport{}, invalid(\"%s carries unknown member %q\", owner, name)\n668|\t}\n669|\tif name, missing := missingMember(members, fidelityReportRequired); missing {\n670|\t\treturn FidelityReport{}, invalid(\"%s misses a required member %q\", owner, name)\n671|\t}\n672|\tschema, ok := rawString(members[\"schema\"])\n673|\tif !ok || schema != fidelityReportSchema {\n674|\t\treturn FidelityReport{}, invalid(\"%s schema is not urn:ax:schema:fidelity-report\", owner)\n675|\t}\n676|\tversion, ok := rawString(members[\"schema_version\"])\n677|\tif !ok || version != fidelityReportVersion {\n678|\t\treturn FidelityReport{}, invalid(\"%s schema_version is not 1.0.0\", owner)\n679|\t}\n680|\treportID, ok := checkDigest(members[fidelityReportSelf])\n681|\tif !ok {\n682|\t\treturn FidelityReport{}, invalid(\"%s fidelity_report_id is not a digest\", owner)\n683|\t}\n684|\tscope, ok := rawString(members[\"scope\"])\n685|\tif !ok {\n686|\t\treturn FidelityReport{}, invalid(\"%s scope is outside archive|target\", owner)\n687|\t}\n688|\tarchive := false\n689|\tswitch scope {\n690|\tcase \"archive\":\n691|\t\tarchive = true\n692|\tcase \"target\":\n693|\tdefault:\n694|\t\treturn FidelityReport{}, invalid(\"%s scope is outside archive|target\", owner)\n695|\t}\n696|\toperation, ok := checkUUIDv7(members[\"operation_id\"])\n697|\tif !ok {\n698|\t\treturn FidelityReport{}, invalid(\"%s operation_id is not a UUIDv7\", owner)\n699|\t}\n(more lines below)","final_result":true}}}
