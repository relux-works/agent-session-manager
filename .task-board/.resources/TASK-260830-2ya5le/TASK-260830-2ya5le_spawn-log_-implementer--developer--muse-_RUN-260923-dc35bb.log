{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6ef","stream":{"kind":"session","id":"01a0cfdc-90e4-7130-b73f-3760c218f2ff"},"sequence":466,"recorded_at":1780531400000927,"record_type":"event","durability":"durable","causation_id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5","run_stream":{"kind":"run","id":"65e49a74-cdff-4e0c-a0aa-7ac50dfdd8b5"},"task_stream":{"kind":"task","id":"01a0cfdd-e48a-7a20-8cce-bcb1de4984fc"},"task_id":"01a0cfdd-e48a-7a20-8cce-bcb1de4984fc","event":{"kind":"output","task_id":"01a0cfdd-e48a-7a20-8cce-bcb1de4984fc","chunk":"Read text file `internal/clonefidelity/report_gates_test.go`.\n1|package clonefidelity_test\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"sort\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|\n9|\tclonefidelity \"github.com/relux-works/agent-session-manager/internal/clonefidelity\"\n10|)\n11|\n12|// TestScalarGates pins the delegated digest, UUIDv7, tuple, uint53,\n13|// and boolean gates at the production entries: each refusal names\n14|// its member with a literal detail. The value grammars belong to\n15|// the landed owners; these rows pin that the entries reach them.\n16|func TestScalarGates(t *testing.T) {\n17|\trow := validRowInput(\"scalar-row\", \"exact\")\n18|\tbuildCases := []struct {\n19|\t\tname    string\n20|\t\tmutate  func(*clonefidelity.FidelityReportInput)\n21|\t\tliteral string\n22|\t}{\n23|\t\t{\"operation_bad_uuid\", func(input *clonefidelity.FidelityReportInput) { input.OperationID = \"not-a-uuid\" }, \"operation_id is not a UUIDv7\"},\n24|\t\t{\"operation_uuid4\", func(input *clonefidelity.FidelityReportInput) {\n25|\t\t\tinput.OperationID = \"0198f4c8-8e50-4f66-8f70-111111111111\"\n26|\t\t}, \"operation_id is not a UUIDv7\"},\n27|\t\t{\"bundle_bad_uuid\", func(input *clonefidelity.FidelityReportInput) { input.BundleID = \"0198f4c8-8e50-7f66-8f70-11111111111\" }, \"bundle_id is not a UUIDv7\"},\n28|\t\t{\"snapshot_bad_digest\", func(input *clonefidelity.FidelityReportInput) { input.SourceSnapshotDigest = \"sha256:xyz\" }, \"source_snapshot_digest is not a digest\"},\n29|\t\t{\"capture_bad_digest\", func(input *clonefidelity.FidelityReportInput) { input.CaptureManifestID = \"not-a-digest\" }, \"capture_manifest_id is not a digest\"},\n30|\t\t{\"canonical_bad_digest\", func(input *clonefidelity.FidelityReportInput) { input.CanonicalSessionID = \"\" }, \"canonical_session_id is not a digest\"},\n31|\t\t{\"plan_bad_digest\", func(input *clonefidelity.FidelityReportInput) { input.ProjectionPlanID = strptr(\"sha256:xyz\") }, \"projection_plan_id is not a digest\"},\n32|\t\t{\"source_tuple_bad\", func(input *clonefidelity.FidelityReportInput) {\n33|\t\t\tinput.SourceEnvironment = []byte(`{\"platform\":\"linux\"}`)\n34|\t\t}, \"source_environment is not an Environment Tuple\"},\n35|\t\t{\"source_tuple_not_json\", func(input *clonefidelity.FidelityReportInput) { input.SourceEnvironment = []byte(`nope`) }, \"source_environment is not an Environment Tuple\"},\n36|\t\t{\"target_tuple_bad\", func(input *clonefidelity.FidelityReportInput) { input.TargetEnvironment = []byte(`[]`) }, \"target_environment is not an Environment Tuple\"},\n37|\t\t{\"staged_bad_digest\", func(input *clonefidelity.FidelityReportInput) {\n38|\t\t\tinput.StagedReadBackEvidenceManifestID = strptr(\"nope\")\n39|\t\t}, \"staged_read_back_evidence_manifest_id is not a digest\"},\n40|\t\t{\"live_bad_digest\", func(input *clonefidelity.FidelityReportInput) { input.LiveReadBackEvidenceManifestID = strptr(\"nope\") }, \"live_read_back_evidence_manifest_id is not a digest\"},\n41|\t\t{\"attestation_bad_digest\", func(input *clonefidelity.FidelityReportInput) { input.AdapterAttestations = []string{\"nope\"} }, \"adapter_attestations[0] is not a digest\"},\n42|\t\t{\"attestation_unsorted\", func(input *clonefidelity.FidelityReportInput) {\n43|\t\t\tinput.AdapterAttestations = []string{\n44|\t\t\t\t\"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\n45|\t\t\t\t\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n46|\t\t\t}\n47|\t\t}, \"adapter_attestations are not sorted unique\"},\n48|\t\t{\"row_canonical_bad_digest\", func(input *clonefidelity.FidelityReportInput) {\n49|\t\t\tinput.Rows = []clonefidelity.DispositionRecordInput{validRowInput(\"scalar-row\", \"exact\")}\n50|\t\t\tinput.Rows[0].CanonicalObjectID = strptr(\"nope\")\n51|\t\t}, \"canonical_object_id is not a digest\"},\n52|\t\t{\"row_evidence_bad_digest\", func(input *clonefidelity.FidelityReportInput) {\n53|\t\t\tinput.Rows = []clonefidelity.DispositionRecordInput{validRowInput(\"scalar-row\", \"exact\")}\n54|\t\t\tinput.Rows[0].SourceEvidenceIDs = []string{\"nope\"}\n55|\t\t\tevents, blocks, bytes := concentratedBreakdowns(input.Rows)\n56|\t\t\tinput.EventKindCounts, input.ContentBlockCounts, input.ByteCounts = events, blocks, bytes\n57|\t\t}, \"source_evidence_ids[0] is not a digest\"},\n58|\t}\n59|\tfor _, tc := range buildCases {\n60|\t\tt.Run(\"build/\"+tc.name, func(t *testing.T) {\n61|\t\t\tinput := validTargetInput(row)\n62|\t\t\ttc.mutate(&input)\n63|\t\t\t_, err := clonefidelity.BuildFidelityReport(input)\n64|\t\t\trequireRefusal(t, err, tc.literal)\n65|\t\t})\n66|\t}\n67|\tsealed := mustBuild(t, validTargetInput(row))\n68|\tdecodeCases := []struct {\n69|\t\tname    string\n70|\t\tmutate  func(document map[string]any)\n71|\t\tliteral string\n72|\t}{\n73|\t\t{\"operation_bad_uuid\", func(document map[string]any) { document[\"operation_id\"] = \"not-a-uuid\" }, \"operation_id is not a UUIDv7\"},\n74|\t\t{\"bundle_bad_uuid\", func(document map[string]any) { document[\"bundle_id\"] = 7 }, \"bundle_id is not a UUIDv7\"},\n75|\t\t{\"snapshot_bad_digest\", func(document map[string]any) { document[\"source_snapshot_digest\"] = \"sha256:xyz\" }, \"source_snapshot_digest is not a digest\"},\n76|\t\t{\"capture_bad_digest\", func(document map[string]any) { document[\"capture_manifest_id\"] = nil }, \"capture_manifest_id is not a digest\"},\n77|\t\t{\"plan_bad_digest\", func(document map[string]any) { document[\"projection_plan_id\"] = \"nope\" }, \"projection_plan_id is not a digest for target\"},\n78|\t\t{\"source_tuple_bad\", func(document map[string]any) { document[\"source_environment\"] = map[string]any{\"platform\": \"linux\"} }, \"source_environment is not an Environment Tuple\"},\n79|\t\t{\"target_tuple_bad_platform\", func(document map[string]any) {\n80|\t\t\ttuple := document[\"target_environment\"].(map[string]any)\n81|\t\t\ttuple[\"platform\"] = \"plan9\"\n82|\t\t}, \"target_environment is not an Environment Tuple\"},\n83|\t\t{\"target_tuple_unknown_member\", func(document map[string]any) {\n84|\t\t\ttuple := document[\"target_environment\"].(map[string]any)\n85|\t\t\ttuple[\"extensions\"] = map[string]any{}\n86|\t\t}, \"target_environment is not an Environment Tuple\"},\n87|\t\t{\"staged_bad_digest\", func(document map[string]any) { document[\"staged_read_back_evidence_manifest_id\"] = \"nope\" }, \"staged_read_back_evidence_manifest_id is not a digest for target\"},\n88|\t\t{\"live_null\", func(document map[string]any) { document[\"live_read_back_evidence_manifest_id\"] = nil }, \"live_read_back_evidence_manifest_id is not a digest for target\"},\n89|\t\t{\"attestation_bad_digest\", func(document map[string]any) { document[\"adapter_attestations\"] = []any{\"nope\"} }, \"adapter_attestations are not sorted unique digest[0..64]\"},\n90|\t\t{\"attestation_unsorted\", func(document map[string]any) {\n91|\t\t\tdocument[\"adapter_attestations\"] = []any{\n92|\t\t\t\t\"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\",\n93|\t\t\t\t\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\n94|\t\t\t}\n95|\t\t}, \"adapter_attestations are not sorted unique digest[0..64]\"},\n96|\t\t{\"row_canonical_bad_digest\", func(document map[string]any) {\n97|\t\t\ttamperRow(document, 0, func(row map[string]any) { row[\"canonical_object_id\"] = \"nope\" })\n98|\t\t}, \"canonical_object_id is not a digest or null\"},\n99|\t\t{\"row_evidence_bad_digest\", func(document map[string]any) {\n100|\t\t\ttamperRow(document, 0, func(row map[string]any) { row[\"source_evidence_ids\"] = []any{\"nope\"} })\n101|\t\t}, \"source_evidence_ids are not sorted unique digest[1..65536]\"},\n102|\t\t{\"raw_complete_string\", func(document map[string]any) { document[\"raw_bundle_complete\"] = \"true\" }, \"raw_bundle_complete is not a boolean\"},\n103|\t\t{\"canonical_complete_number\", func(document map[string]any) { document[\"canonical_complete\"] = 1 }, \"canonical_complete is not a boolean\"},\n104|\t\t{\"continuable_null\", func(document map[string]any) { document[\"target_semantically_continuable\"] = nil }, \"target_semantically_continuable is not a boolean\"},\n105|\t\t{\"resumable_number\", func(document map[string]any) { document[\"target_natively_resumable\"] = 0 }, \"target_natively_resumable is not a boolean\"},\n106|\t}\n107|\tfor _, tc := range decodeCases {\n108|\t\tt.Run(\"decode/\"+tc.name, func(t *testing.T) {\n109|\t\t\tmutated := tampered(t, sealed, tc.mutate)\n110|\t\t\t_, err := clonefidelity.DecodeFidelityReport(mutated)\n111|\t\t\trequireRefusal(t, err, tc.literal)\n112|\t\t})\n113|\t}\n114|}\n115|\n116|// TestNumberModel pins the AX number model at the numeric gates: a\n117|// fraction, an exponent, a string, or a magnitude at or beyond 2^53\n118|// refuses with a literal code; 2^53-1 admits.\n119|func TestNumberModel(t *testing.T) {\n120|\trow := validRowInput(\"number-row\", \"exact\")\n121|\tsealed := mustBuild(t, validTargetInput(row))\n122|\tcells := []struct {\n123|\t\tname   string\n124|\t\tmutate func(document map[string]any, value any)\n125|\t}{\n126|\t\t{\"counts\", func(document map[string]any, value any) { document[\"counts\"].(map[string]any)[\"exact\"] = value }},\n127|\t\t{\"event_cell\", func(document map[string]any, value any) {\n128|\t\t\tdocument[\"event_kind_counts\"].(map[string]any)[\"usage\"].(map[string]any)[\"exact\"] = value\n129|\t\t}},\n130|\t\t{\"block_cell\", func(document map[string]any, value any) {\n131|\t\t\tdocument[\"content_block_counts\"].(map[string]any)[\"text\"].(map[string]any)[\"exact\"] = value\n132|\t\t}},\n133|\t\t{\"bytes\", func(document map[string]any, value any) { document[\"byte_counts\"].(map[string]any)[\"exact\"] = value }},\n134|\t}\n135|\tvalues := []any{1.5, \"7\", true, nil, 9007199254740992, -1, json.Number(\"1e3\")}\n136|\tfor _, cell := range cells {\n137|\t\tfor _, value := range values {\n138|\t\t\tmutated := tampered(t, sealed, func(document map[string]any) { cell.mutate(document, value) })\n139|\t\t\t_, err := clonefidelity.DecodeFidelityReport(mutated)\n140|\t\t\tif err == nil {\n141|\t\t\t\tt.Fatalf(\"%s value %v admitted, want refusal\", cell.name, value)\n142|\t\t\t}\n143|\t\t\trequireRefusal(t, err, \"is not a uint53\")\n144|\t\t}\n145|\t}\n146|\t// 2^53-1 admits in a byte cell (row reconciliation cannot apply\n147|\t// to bytes, so the max value seals and decodes).\n148|\tinput := validTargetInput(row)\n149|\tinput.ByteCounts[\"exact\"] = 9007199254740991\n150|\treport := mustDecode(t, mustBuild(t, input))\n151|\tif report.ByteCounts[\"exact\"] != 9007199254740991 {\n152|\t\tt.Fatalf(\"byte max = %d, want 9007199254740991\", report.ByteCounts[\"exact\"])\n153|\t}\n154|}\n155|\n156|// TestEvidenceBounds pins the evidence array bounds at the edge and\n157|// edge+1 through both entries: source[1..65536],\n158|// staged/live[0..65536], attestations[0..64].\n159|func TestEvidenceBounds(t *testing.T) {\n160|\tmany := func(n int, seed string) []string {\n161|\t\tout := make([]string, 0, n)\n162|\t\tfor i := 0; i < n; i++ {\n163|\t\t\tout = append(out, fixtureDigest(seed+itoa(i)))\n164|\t\t}\n165|\t\tsort.Strings(out)\n166|\t\treturn out\n167|\t}\n168|\t// Admit edges: 65536 source IDs seal and decode.\n169|\tedgeRow := validRowInput(\"edge-evidence\", \"exact\")\n170|\tedgeRow.SourceEvidenceIDs = many(65536, \"edge-evidence-\")\n171|\tedgeRow.StagedEvidenceObjectIDs = many(65536, \"edge-staged-\")\n172|\tedgeRow.LiveEvidenceObjectIDs = many(65536, \"edge-live-\")\n173|\treport := mustDecode(t, mustBuild(t, validTargetInput(edgeRow)))\n174|\tif len(report.Rows[0].SourceEvidenceIDs) != 65536 {\n175|\t\tt.Fatalf(\"source evidence = %d, want 65536\", len(report.Rows[0].SourceEvidenceIDs))\n176|\t}\n177|\tinput := validTargetInput(validRowInput(\"edge-att\", \"exact\"))\n178|\tinput.AdapterAttestations = many(64, \"edge-att-\")\n179|\tmustDecode(t, mustBuild(t, input))\n180|\t// Edge+1 refuses at Build (count first: fast).\n181|\toverRow := validRowInput(\"over-evidence\", \"exact\")\n182|\toverRow.SourceEvidenceIDs = many(65537, \"over-evidence-\")\n183|\t_, err := clonefidelity.BuildFidelityReport(validTargetInput(overRow))\n184|\trequireRefusal(t, err, \"carries 65537 source_evidence_ids, want [1..65536]\")\n185|\toverRow = validRowInput(\"over-evidence\", \"exact\")\n186|\toverRow.StagedEvidenceObjectIDs = many(65537, \"over-staged-\")\n187|\t_, err = clonefidelity.BuildFidelityReport(validTargetInput(overRow))\n188|\trequireRefusal(t, err, \"carries 65537 staged_evidence_object_ids, want [0..65536]\")\n189|\tinput = validTargetInput(validRowInput(\"over-att\", \"exact\"))\n190|\tinput.AdapterAttestations = many(65, \"over-att-\")\n191|\t_, err = clonefidelity.BuildFidelityReport(input)\n192|\trequireRefusal(t, err, \"carries 65 adapter_attestations, want [0..64]\")\n193|\t// Edge+1 refuses at Decode (shape gate).\n194|\tsealed := mustBuild(t, validTargetInput(validRowInput(\"over-decode\", \"exact\")))\n195|\ttoAny := func(ids []string) []any {\n196|\t\tout := make([]any, 0, len(ids))\n197|\t\tfor _, id := range ids {\n198|\t\t\tout = append(out, id)\n199|\t\t}\n200|\t\treturn out\n201|\t}\n202|\tmutated := tampered(t, sealed, func(document map[string]any) {\n203|\t\ttamperRow(document, 0, func(row map[string]any) {\n204|\t\t\trow[\"source_evidence_ids\"] = toAny(many(65537, \"over-decode-evidence-\"))\n205|\t\t})\n206|\t})\n207|\t_, err = clonefidelity.DecodeFidelityReport(mutated)\n208|\trequireRefusal(t, err, \"source_evidence_ids are not sorted unique digest[1..65536]\")\n209|\tmutated = tampered(t, sealed, func(document map[string]any) {\n210|\t\tdocument[\"adapter_attestations\"] = toAny(many(65, \"over-decode-att-\"))\n211|\t})\n212|\t_, err = clonefidelity.DecodeFidelityReport(mutated)\n213|\trequireRefusal(t, err, \"adapter_attestations are not sorted unique digest[0..64]\")\n214|}\n215|\n216|// TestExtensionsClosed pins the closed extensions rule at both\n217|// entries and both layers: reverse-DNS keys only, values inside the\n218|// AX number model, nested objects duplicate-free.\n219|func TestExtensionsClosed(t *testing.T) {\n220|\trow := validRowInput(\"ext-row\", \"exact\")\n221|\tinput := validTargetInput(row)\n222|\tinput.Extensions = map[string]any{\"com.example.note\": \"kept\", \"com.example.nested\": map[string]any{\"n\": 7}}\n223|\treport := mustDecode(t, mustBuild(t, input))\n224|\tif report.Scope != \"target\" {\n225|\t\tt.Fatal(\"valid extensions refused\")\n226|\t}\n227|\tbuildCases := []struct {\n228|\t\tname       string\n229|\t\textensions map[string]any\n230|\t\tliteral    string\n231|\t}{\n232|\t\t{\"bad_key\", map[string]any{\"frobnicate\": 1}, \"extensions are not reverse-DNS keyed\"},\n233|\t\t{\"float_value\", map[string]any{\"com.example.f\": 1.5}, \"extensions carry a number outside the AX safe-integer model\"},\n234|\t\t{\"big_value\", map[string]any{\"com.example.f\": uint64(1) << 53}, \"extensions carry a number outside the AX safe-integer model\"},\n235|\t}\n236|\tfor _, tc := range buildCases {\n237|\t\tt.Run(\"build/\"+tc.name, func(t *testing.T) {\n238|\t\t\tinput := validTargetInput(row)\n239|\t\t\tinput.Extensions = tc.extensions\n240|\t\t\t_, err := clonefidelity.BuildFidelityReport(input)\n241|\t\t\trequireRefusal(t, err, tc.literal)\n242|\t\t})\n243|\t\tt.Run(\"build/row_\"+tc.name, func(t *testing.T) {\n244|\t\t\tbadRow := validRowInput(\"ext-row\", \"exact\")\n245|\t\t\tbadRow.Extensions = tc.extensions\n246|\t\t\t_, err := clonefidelity.BuildFidelityReport(validTargetInput(badRow))\n247|\t\t\trequireRefusal(t, err, tc.literal)\n248|\t\t})\n249|\t}\n250|\tsealed := mustBuild(t, validTargetInput(row))\n251|\tmutated := tampered(t, sealed, func(document map[string]any) {\n252|\t\tdocument[\"extensions\"] = map[string]any{\"frobnicate\": 1}\n253|\t})\n254|\t_, err := clonefidelity.DecodeFidelityReport(mutated)\n255|\trequireRefusal(t, err, \"extensions are not reverse-DNS keyed\")\n256|\tmutated = tampered(t, sealed, func(document map[string]any) {\n257|\t\tdocument[\"extensions\"] = map[string]any{\"com.example.f\": 1.5}\n258|\t})\n259|\t_, err = clonefidelity.DecodeFidelityReport(mutated)\n260|\trequireRefusal(t, err, \"extensions carry a number outside the AX safe-integer model\")\n261|\tmutated = tampered(t, sealed, func(document map[string]any) {\n262|\t\ttamperRow(document, 0, func(row map[string]any) {\n263|\t\t\trow[\"extensions\"] = map[string]any{\"frobnicate\": 1}\n264|\t\t})\n265|\t})\n266|\t_, err = clonefidelity.DecodeFidelityReport(mutated)\n267|\trequireRefusal(t, err, \"extensions are not reverse-DNS keyed\")\n268|\t// Nested duplicate member refuses (raw-string splice, since a map\n269|\t// cannot hold the duplicate).\n270|\ttext := string(sealed)\n271|\tmarker := `\"extensions\":{}`\n272|\tif !strings.Contains(text, marker) {\n273|\t\tt.Fatalf(\"sealed report lacks %q\", marker)\n274|\t}\n275|\tdup := strings.Replace(text, marker, `\"extensions\":{\"com.example.a\":{\"x\":1,\"x\":2}}`, 1)\n276|\t_, err = clonefidelity.DecodeFidelityReport([]byte(dup))\n277|\trequireRefusal(t, err, \"extensions carry a duplicate nested member\")\n278|}\n279|\n280|// TestBuildUTF8 pins the pre-marshal UTF-8 gate: every Build string\n281|// admission refuses invalid bytes instead of sealing a rewritten\n282|// U+FFFD twin.\n283|func TestBuildUTF8(t *testing.T) {\n284|\tbad := string([]byte{0xff, 0xfe})\n285|\trow := validRowInput(\"utf8-row\", \"exact\")\n286|\trow.Explanation = bad\n287|\t_, err := clonefidelity.BuildFidelityReport(validTargetInput(row))\n288|\trequireRefusal(t, err, \"explanation is not valid UTF-8\")\n289|\trow = validRowInput(\"utf8-row\", \"semantic\", \"unknown_native_event\")\n290|\trow.SourceItemKey = bad\n291|\t_, err = clonefidelity.BuildFidelityReport(validTargetInput(row))\n292|\trequireRefusal(t, err, \"source_item_key is not valid UTF-8\")\n293|\trow = validRowInput(\"utf8-row\", \"semantic\", \"unknown_native_event\")\n294|\trow.ReasonCodes = []string{bad}\n295|\t_, err = clonefidelity.BuildFidelityReport(validTargetInput(row))\n296|\trequireRefusal(t, err, \"reason_codes[0] is not valid UTF-8\")\n297|\tinput := validTargetInput(validRowInput(\"utf8-row\", \"exact\"))\n298|\tinput.Extensions = map[string]any{\"com.example.bad\": bad}\n299|\t_, err = clonefidelity.BuildFidelityReport(input)\n300|\trequireRefusal(t, err, \"extensions\")\n301|}","final_result":true}}}
