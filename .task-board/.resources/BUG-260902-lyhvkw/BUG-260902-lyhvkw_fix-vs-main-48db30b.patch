diff --git a/internal/canonicaljson/nesting_depth_test.go b/internal/canonicaljson/nesting_depth_test.go
new file mode 100644
index 0000000..edf98a4
--- /dev/null
+++ b/internal/canonicaljson/nesting_depth_test.go
@@ -0,0 +1,203 @@
+package canonicaljson
+
+import (
+	"errors"
+	"fmt"
+	"strings"
+	"testing"
+)
+
+// documentedMaxNestingDepth is deliberately a test-local literal rather than
+// a reference to MaxNestingDepth: every accept-at-limit and refuse-past-limit
+// case below is built from this number, so widening or narrowing the
+// production constant reddens the suite instead of silently moving the tests
+// along with it.
+const documentedMaxNestingDepth = 256
+
+func TestMaxNestingDepthIsPinnedToDocumentedValue(t *testing.T) {
+	t.Parallel()
+	if MaxNestingDepth != documentedMaxNestingDepth {
+		t.Fatalf("MaxNestingDepth = %d, want the documented %d; update the rationale, the constraint enumeration, and this pin together", MaxNestingDepth, documentedMaxNestingDepth)
+	}
+}
+
+func TestCanonicalizeAcceptsExactMaximumNestingDepthAndRefusesOnePast(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		name  string
+		build func(depth int) []byte
+	}{
+		{"nested arrays", nestedArrayDocument},
+		{"nested objects", nestedObjectDocument},
+		{"array inside object alternation", nestedAlternatingDocument},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			t.Parallel()
+			atLimit := test.build(documentedMaxNestingDepth)
+			canonical, err := Canonicalize(atLimit)
+			if err != nil {
+				t.Fatalf("Canonicalize(%s at depth %d) error = %v, want acceptance at the declared limit", test.name, documentedMaxNestingDepth, err)
+			}
+			if string(canonical) != string(atLimit) {
+				t.Fatalf("Canonicalize(%s at depth %d) changed a canonical input: got %q", test.name, documentedMaxNestingDepth, canonical)
+			}
+
+			onePast := test.build(documentedMaxNestingDepth + 1)
+			_, err = Canonicalize(onePast)
+			assertNestingDepthRefusal(t, "Canonicalize("+test.name+")", err)
+		})
+	}
+}
+
+func TestIdentityEntriesInheritNestingDepthGateFromSharedDecode(t *testing.T) {
+	t.Parallel()
+
+	// The identity object itself is level 1 and its extensions map is level 2,
+	// so an extension value nested (limit - 2) deep places the whole document
+	// exactly at the declared limit.
+	atLimit := mustJSON(t, genericExtensionIdentityObject(map[string]any{"a.deep": nestedArrayValue(documentedMaxNestingDepth - 2)}))
+	if depth := jsonDepth(mustDecodeStrict(t, atLimit)); depth != documentedMaxNestingDepth {
+		t.Fatalf("at-limit identity document has depth %d, want %d", depth, documentedMaxNestingDepth)
+	}
+	// decodeValue admits the document at the limit: the refusal that both
+	// public entries report comes from the downstream Section 1.6 extension
+	// depth gate, which is typed ErrInvalidIdentity and names its own bound.
+	// A valid immutable object can never be nested this deep, so this is the
+	// strongest acceptance the identity entries can express at the limit.
+	if _, _, err := CalculateObjectIdentity(atLimit); err == nil || !errors.Is(err, ErrInvalidIdentity) || errors.Is(err, ErrInvalidJSON) || !strings.Contains(err.Error(), "nesting depth 4") {
+		t.Fatalf("CalculateObjectIdentity(at-limit document) error = %v, want the downstream extension depth-4 refusal, proving decode admitted the document", err)
+	}
+	claimedAtLimit := withCorrectIdentityClaimForTest(t, atLimit, SelfRecordID)
+	if _, _, err := VerifyObjectIdentity(claimedAtLimit); err == nil || !errors.Is(err, ErrInvalidIdentity) || errors.Is(err, ErrInvalidJSON) || !strings.Contains(err.Error(), "nesting depth 4") {
+		t.Fatalf("VerifyObjectIdentity(at-limit document) error = %v, want the downstream extension depth-4 refusal, proving decode admitted the document", err)
+	}
+
+	onePast := mustJSON(t, genericExtensionIdentityObject(map[string]any{"a.deep": nestedArrayValue(documentedMaxNestingDepth - 1)}))
+	if len(onePast) > 5_242_880 {
+		t.Fatalf("one-past-limit identity document is %d bytes; it must stay under the encoded size cap so the depth gate is what refuses it", len(onePast))
+	}
+	_, _, err := CalculateObjectIdentity(onePast)
+	assertNestingDepthRefusal(t, "CalculateObjectIdentity", err)
+	_, _, err = VerifyObjectIdentity(onePast)
+	assertNestingDepthRefusal(t, "VerifyObjectIdentity", err)
+}
+
+// TestNestedArrayRegressionReturnsTypedErrorInsteadOfStackOverflow reproduces
+// the original crash shape: one million nested arrays, a 2 MB document under
+// the 5,242,880-byte identity cap, previously exhausted the goroutine stack
+// and aborted the process with an uncatchable fatal runtime error at every
+// public entry.
+func TestNestedArrayRegressionReturnsTypedErrorInsteadOfStackOverflow(t *testing.T) {
+	t.Parallel()
+
+	const crashDepth = 1_000_000
+	input := nestedArrayDocument(crashDepth)
+	if len(input) != 2_000_000 || len(input) > 5_242_880 {
+		t.Fatalf("regression input is %d bytes, want the 2,000,000-byte document below the identity size cap", len(input))
+	}
+
+	_, err := Canonicalize(input)
+	assertNestingDepthRefusal(t, "Canonicalize(2 MB nested arrays)", err)
+	_, _, err = CalculateObjectIdentity(input)
+	assertNestingDepthRefusal(t, "CalculateObjectIdentity(2 MB nested arrays)", err)
+	_, _, err = VerifyObjectIdentity(input)
+	assertNestingDepthRefusal(t, "VerifyObjectIdentity(2 MB nested arrays)", err)
+}
+
+// TestDeepestPinnedClosedShapeStaysWithinNestingHeadroom backs the rationale
+// on MaxNestingDepth: the deepest normative v0.5.0 object, a Transfer
+// Manifest with a 16-level submodule forest and 4-level extensions, must stay
+// within half of the bound and remain accepted by both identity entries.
+func TestDeepestPinnedClosedShapeStaysWithinNestingHeadroom(t *testing.T) {
+	t.Parallel()
+
+	object := validGitWorkspaceGroupObject()
+	member := gitWorkspaceMember(object)
+	member["submodules"] = []any{validInitializedSubmoduleShape(1, 16)}
+	deepest := validInitializedSubmoduleShape(1, 16)
+	for level := 1; level < 16; level++ {
+		deepest = deepest["submodules"].([]any)[0].(map[string]any)
+	}
+	deepest["extensions"] = map[string]any{"a.depth": []any{[]any{[]any{[]any{"value"}}}}}
+	input := mustJSON(t, object)
+
+	depth := jsonDepth(mustDecodeStrict(t, input))
+	t.Logf("deepest pinned closed shape decodes to nesting depth %d; MaxNestingDepth is %d", depth, MaxNestingDepth)
+	if depth*2 > MaxNestingDepth {
+		t.Fatalf("deepest pinned closed shape has depth %d, want at most half of MaxNestingDepth %d", depth, MaxNestingDepth)
+	}
+	assertIdentityEntriesAcceptShape(t, input, SelfManifestID)
+}
+
+func assertNestingDepthRefusal(t *testing.T, entry string, err error) {
+	t.Helper()
+	want := fmt.Sprintf("nesting depth exceeds maximum %d", documentedMaxNestingDepth)
+	if err == nil || !errors.Is(err, ErrInvalidJSON) || errors.Is(err, ErrInvalidIdentity) || !strings.Contains(err.Error(), want) {
+		t.Fatalf("%s error = %v, want typed ErrInvalidJSON containing %q", entry, err, want)
+	}
+}
+
+func nestedArrayDocument(depth int) []byte {
+	return []byte(strings.Repeat("[", depth) + strings.Repeat("]", depth))
+}
+
+func nestedObjectDocument(depth int) []byte {
+	return []byte(strings.Repeat(`{"a":`, depth-1) + "{}" + strings.Repeat("}", depth-1))
+}
+
+func nestedAlternatingDocument(depth int) []byte {
+	var builder strings.Builder
+	for level := 1; level <= depth; level++ {
+		if level%2 == 1 {
+			builder.WriteString(`{"a":`)
+		} else {
+			builder.WriteString("[")
+		}
+	}
+	builder.WriteString("null")
+	for level := depth; level >= 1; level-- {
+		if level%2 == 1 {
+			builder.WriteString("}")
+		} else {
+			builder.WriteString("]")
+		}
+	}
+	return []byte(builder.String())
+}
+
+func nestedArrayValue(depth int) any {
+	var value any = []any{}
+	for level := 1; level < depth; level++ {
+		value = []any{value}
+	}
+	return value
+}
+
+func jsonDepth(value any) int {
+	deepest := 0
+	switch typed := value.(type) {
+	case []any:
+		for _, element := range typed {
+			deepest = max(deepest, jsonDepth(element))
+		}
+		return deepest + 1
+	case map[string]any:
+		for _, member := range typed {
+			deepest = max(deepest, jsonDepth(member))
+		}
+		return deepest + 1
+	default:
+		return 0
+	}
+}
+
+func mustDecodeStrict(t *testing.T, input []byte) any {
+	t.Helper()
+	value, err := decodeStrict(input)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return value
+}
