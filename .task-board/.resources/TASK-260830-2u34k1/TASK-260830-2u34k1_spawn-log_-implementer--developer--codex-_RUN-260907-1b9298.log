  sourceVersion: loaded.SourceVersion, defaultPolicy: c.Directory.DefaultMetadataPolicy,
  summaryChoice: c.Directory.GeneratedSummaryUpgradeChoice, disclosure: c.DirectoryPeerDisclosure,
