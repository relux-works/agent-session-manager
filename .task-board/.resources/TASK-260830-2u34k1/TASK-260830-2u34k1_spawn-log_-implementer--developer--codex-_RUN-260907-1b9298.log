 if class == "generated_metadata" && d.summaryChoice == "unset" { return "", ErrDisclosureDenied }
 policy := d.defaultPolicy
 for _, entry := range d.disclosure {
  if entry.HostID != target.host.ID { continue }
  switch class {
  case "environment_observations": policy = entry.EnvironmentObservations
  case "native_observations": policy = entry.NativeObservations
  case "manual_metadata": policy = entry.ManualMetadata
  case "generated_metadata": policy = entry.GeneratedMetadata
  case "job_operation_status": policy = entry.JobOperationStatus
  }
 }
 if policy != "mesh_sanitized" && policy != "reference_only" { return "", ErrDisclosureDenied }
 return policy, nil
}
