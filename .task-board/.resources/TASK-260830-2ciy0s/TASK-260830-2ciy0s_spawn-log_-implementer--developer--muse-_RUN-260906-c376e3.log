{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cd19","stream":{"kind":"session","id":"01a07721-ca06-7081-babf-b563190d8d78"},"sequence":1255,"recorded_at":1780531400002505,"record_type":"event","durability":"durable","causation_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","run_stream":{"kind":"run","id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd"},"task_stream":{"kind":"task","id":"ac4ae020-17bc-4dd8-a549-16cebd151360"},"task_id":"ac4ae020-17bc-4dd8-a549-16cebd151360","event":{"kind":"output","task_id":"ac4ae020-17bc-4dd8-a549-16cebd151360","chunk":"edited\nchanged lines: lines 30-67\n--- original\n+++ updated\n@@\n-func openCommitRelative(root *os.File, _ string, member string, segments []string) (*os.File, error) {\n-\tprevious := -1\n-\tcurrent := int(root.Fd())\n-\tfor _, segment := range segments[:len(segments)-1] {\n-\t\tnext, err := unix.Openat(current, segment,\n-\t\t\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\n-\t\tif err != nil {\n-\t\t\tif previous >= 0 {\n-\t\t\t\t_ = unix.Close(previous)\n-\t\t\t}\n-\t\t\treturn nil, mapCommitErr(err)\n-\t\t}\n-\t\tif previous >= 0 {\n-\t\t\t_ = unix.Close(previous)\n-\t\t}\n-\t\tprevious, current = next, next\n-\t}\n-\tfinal, err := unix.Openat(current, segments[len(segments)-1],\n-\t\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_CLOEXEC|unix.O_NONBLOCK, 0)\n-\tif previous >= 0 {\n-\t\t_ = unix.Close(previous)\n-\t}\n-\tif err != nil {\n-\t\treturn nil, mapCommitErr(err)\n-\t}\n-\treturn os.NewFile(uintptr(final), member), nil\n-}\n-\n-// mapCommitErr sorts the walk failures: a symlink anywhere on the path\n-// surfaces as ELOOP under O_NOFOLLOW and becomes the escape signal,\n-// while a missing component, a file where a directory stands, or a\n-// permission failure stays raw for the caller's open-failed refusal.\n-func mapCommitErr(err error) error {\n-\tif errors.Is(err, unix.ELOOP) {\n-\t\treturn errCommitSymlink\n-\t}\n-\treturn err\n-}\n+func openCommitRelative(root *os.File, _ string, member string, segments []string) (*os.File, error) {\n+\tprevious := -1\n+\tcurrent := int(root.Fd())\n+\tfor _, segment := range segments[:len(segments)-1] {\n+\t\tnext, err := unix.Openat(current, segment,\n+\t\t\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\n+\t\tif err != nil {\n+\t\t\tif previous >= 0 {\n+\t\t\t\t_ = unix.Close(previous)\n+\t\t\t}\n+\t\t\treturn nil, classifyCommitErr(current, segment, err)\n+\t\t}\n+\t\tif previous >= 0 {\n+\t\t\t_ = unix.Close(previous)\n+\t\t}\n+\t\tprevious, current = next, next\n+\t}\n+\tlast := segments[len(segments)-1]\n+\tfinal, err := unix.Openat(current, last,\n+\t\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_CLOEXEC|unix.O_NONBLOCK, 0)\n+\tif previous >= 0 {\n+\t\t_ = unix.Close(previous)\n+\t}\n+\tif err != nil {\n+\t\treturn nil, classifyCommitErr(current, last, err)\n+\t}\n+\treturn os.NewFile(uintptr(final), member), nil\n+}\n+\n+// classifyCommitErr sorts the walk failures: a symlink anywhere on the\n+// path becomes the escape signal, while a missing component, a file\n+// where a directory stands, or a permission failure stays raw for the\n+// caller's open-failed refusal.\n+//\n+// The errno alone does not name the shape on every kernel: Linux\n+// reports ELOOP for an O_NOFOLLOW openat meeting a symlink, while\n+// Darwin reports ENOTDIR for the O_DIRECTORY half of the same event.\n+// Either errno therefore re-examines the component with fstatat at\n+// AT_SYMLINK_NOFOLLOW — still relative to the parent descriptor, so\n+// no path string is re-resolved — and only a component that is a\n+// symlink right now becomes the escape signal. A swap between the\n+// failed open and this check fails closed in every direction: each\n+// outcome (symlink, directory, missing) refuses, and only the rule\n+// name differs.\n+func classifyCommitErr(parent int, segment string, err error) error {\n+\tif errors.Is(err, unix.ELOOP) {\n+\t\treturn errCommitSymlink\n+\t}\n+\tif errors.Is(err, unix.ENOTDIR) {\n+\t\tvar status unix.Stat_t\n+\t\tif fstatErr := unix.Fstatat(parent, segment, &status, unix.AT_SYMLINK_NOFOLLOW); fstatErr == nil {\n+\t\t\tif status.Mode&unix.S_IFMT == unix.S_IFLNK {\n+\t\t\t\treturn errCommitSymlink\n+\t\t\t}\n+\t\t}\n+\t}\n+\treturn err\n+}\n"}}}
