{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c71f","stream":{"kind":"session","id":"01a07721-ca06-7081-babf-b563190d8d78"},"sequence":490,"recorded_at":1780531400000975,"record_type":"event","durability":"durable","causation_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","run_stream":{"kind":"run","id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd"},"task_stream":{"kind":"task","id":"e7d92907-e250-4dbc-bc92-aca928fb81e3"},"task_id":"e7d92907-e250-4dbc-bc92-aca928fb81e3","event":{"kind":"output","task_id":"e7d92907-e250-4dbc-bc92-aca928fb81e3","chunk":"Read text file `internal/provhost/inventory_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"flag\"\n5|\t\"fmt\"\n6|\t\"go/ast\"\n7|\t\"go/parser\"\n8|\t\"go/token\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"regexp\"\n12|\t\"runtime\"\n13|\t\"sort\"\n14|\t\"strings\"\n15|\t\"sync\"\n16|\t\"testing\"\n17|\n18|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n19|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n20|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n21|)\n22|\n23|// exercisedRefusalSites records the production file:line that constructed\n24|// a refusal, for every instrumented refusal constructor call made during\n25|// the test run. observedCodes records every stable code those refusals\n26|// carried.\n27|var exercisedRefusalSites sync.Map\n28|var observedCodes sync.Map\n29|\n30|func recordRefusalSite(code string) {\n31|\tobservedCodes.Store(code, struct{}{})\n32|\tif _, file, line, ok := runtime.Caller(2); ok {\n33|\t\texercisedRefusalSites.Store(fmt.Sprintf(\"%s:%d\", filepath.Base(file), line), struct{}{})\n34|\t}\n35|}\n36|\n37|func TestMain(main *testing.M) {\n38|\t// Helper-process gate for the ExecRunner environment tests: when the\n39|\t// marker is set this binary prints its observed environment and\n40|\t// exits before the suite or the refusal audit runs. It sits first so\n41|\t// the child never re-enters the audit or spawns grandchildren.\n42|\tif os.Getenv(\"SECPROBE_HELPER_PROCESS\") == \"1\" {\n43|\t\trunExecRunnerHelper()\n44|\t}\n45|\torigInvalid, origProtocol, origMismatch := failInvalid, failProtocol, failMismatch\n46|\torigProcess, origTimeout, origIntegrity := failProcess, failTimeout, failIntegrity\n47|\tfailInvalid = func(detail string) (*axerror.Error, error) {\n48|\t\tfailure, err := origInvalid(detail)\n49|\t\tif err == nil {\n50|\t\t\trecordRefusalSite(string(failure.Code()))\n51|\t\t}\n52|\t\treturn failure, err\n53|\t}\n54|\tfailProtocol = func(detail, member string) (*axerror.Error, error) {\n55|\t\tfailure, err := origProtocol(detail, member)\n56|\t\tif err == nil {\n57|\t\t\trecordRefusalSite(string(failure.Code()))\n58|\t\t}\n59|\t\treturn failure, err\n60|\t}\n61|\tfailMismatch = func(detail, observed string) (*axerror.Error, error) {\n62|\t\tfailure, err := origMismatch(detail, observed)\n63|\t\tif err == nil {\n64|\t\t\trecordRefusalSite(string(failure.Code()))\n65|\t\t}\n66|\t\treturn failure, err\n67|\t}\n68|\tfailProcess = func(detail string, cause error) (*axerror.Error, error) {\n69|\t\tfailure, err := origProcess(detail, cause)\n70|\t\tif err == nil {\n71|\t\t\trecordRefusalSite(string(failure.Code()))\n72|\t\t}\n73|\t\treturn failure, err\n74|\t}\n75|\tfailTimeout = func(millisDetail string, millis int64) (*axerror.Error, error) {\n76|\t\tfailure, err := origTimeout(millisDetail, millis)\n77|\t\tif err == nil {\n78|\t\t\trecordRefusalSite(string(failure.Code()))\n79|\t\t}\n80|\t\treturn failure, err\n81|\t}\n82|\tfailIntegrity = func(detail, statusState, materializationID, transactionID string) (*axerror.Error, error) {\n83|\t\tfailure, err := origIntegrity(detail, statusState, materializationID, transactionID)\n84|\t\tif err == nil {\n85|\t\t\trecordRefusalSite(string(failure.Code()))\n86|\t\t}\n87|\t\treturn failure, err\n88|\t}\n89|\tcode := main.Run()\n90|\tif code == 0 && fullPackageTestRun() {\n91|\t\tif failures := auditRefusalInventory(); len(failures) != 0 {\n92|\t\t\tfor _, failure := range failures {\n93|\t\t\t\tfmt.Fprintln(os.Stderr, failure)\n94|\t\t\t}\n95|\t\t\tcode = 1\n96|\t\t}\n97|\t}\n98|\tos.Exit(code)\n99|}\n100|\n101|func fullPackageTestRun() bool {\n102|\tselected := flag.Lookup(\"test.run\")\n103|\treturn selected == nil || selected.Value.String() == \"\"\n104|}\n105|\n106|// auditRefusalInventory derives the refusal inventory from package\n107|// source, never from memory: every production call to a refusal\n108|// constructor must have an exercised negative path, no Structured Error\n109|// may be built outside the six constructors, no raw error may be minted,\n110|// and the observed code set must equal the closed code set exactly.\n111|func auditRefusalInventory() []string {\n112|\tdirectory, err := os.Getwd()\n113|\tif err != nil {\n114|\t\treturn []string{fmt.Sprintf(\"derive provhost refusal inventory: %v\", err)}\n115|\t}\n116|\tinventory, err := deriveRefusalInventory(directory)\n117|\tif err != nil {\n118|\t\treturn []string{fmt.Sprintf(\"derive provhost refusal inventory: %v\", err)}\n119|\t}\n120|\tvar failures []string\n121|\t// Floor: a derived domain that can silently derive nothing is not a\n122|\t// measurement. An empty derivation must fail closed, never pass\n123|\t// vacuously — the same \"the scan is blind\" floor the discovery\n124|\t// package carries on its own scans.\n125|\tif len(inventory.ScannedFiles) == 0 {\n126|\t\tfailures = append(failures, \"scanned no production sources; the check is blind\")\n127|\t}\n128|\tif len(inventory.Sites) == 0 {\n129|\t\tfailures = append(failures, \"derived no refusal sites; the scan is blind\")\n130|\t}\n131|\t// Reverse direction: every exercised refusal site must resolve to a\n132|\t// derived site. The exercised set comes from the test run, not from\n133|\t// a hand list, so a truncated derivation reddens here even though\n134|\t// the forward check passes vacuously.\n135|\tderived := map[string]bool{}\n136|\tfor _, site := range inventory.Sites {\n137|\t\tderived[site] = true\n138|\t}\n139|\tvar outside []string\n140|\texercisedRefusalSites.Range(func(key, _ any) bool {\n141|\t\tsite := key.(string)\n142|\t\tif !derived[site] {\n143|\t\t\toutside = append(outside, site)\n144|\t\t}\n145|\t\treturn true\n146|\t})\n147|\tsort.Strings(outside)\n148|\tif len(outside) != 0 {\n149|\t\tfailures = append(failures, \"exercised refusal sites outside the derived inventory; the derivation is short: \"+strings.Join(outside, \", \"))\n150|\t}\n151|\tif len(inventory.StrayBuilders) != 0 {\n152|\t\tsort.Strings(inventory.StrayBuilders)\n153|\t\tfailures = append(failures, \"provhost failures built outside the refusal constructors: \"+strings.Join(inventory.StrayBuilders, \", \"))\n154|\t}\n155|\tif len(inventory.RawConstructors) != 0 {\n156|\t\tsort.Strings(inventory.RawConstructors)\n157|\t\tfailures = append(failures, \"provhost raw error construction: \"+strings.Join(inventory.RawConstructors, \", \"))\n158|\t}\n159|\tvar missing []string\n160|\tfor _, site := range inventory.Sites {\n161|\t\tif _, ok := exercisedRefusalSites.Load(site); !ok {\n162|\t\t\tmissing = append(missing, site)\n163|\t\t}\n164|\t}\n165|\tsort.Strings(missing)\n166|\tif len(missing) != 0 {\n167|\t\tfailures = append(failures, \"provhost refusal call sites without an exercised negative path: \"+strings.Join(missing, \", \"))\n168|\t}\n169|\tvar codes []string\n170|\tobservedCodes.Range(func(key, _ any) bool {\n171|\t\tcodes = append(codes, key.(string))\n172|\t\treturn true\n173|\t})\n174|\tsort.Strings(codes)\n175|\twant := []string{\"incompatible_protocol\", \"integrity_failure\", \"invalid_config\", \"provider_process_failed\", \"provider_protocol_error\", \"provider_timeout\"}\n176|\tif fmt.Sprintf(\"%v\", codes) != fmt.Sprintf(\"%v\", want) {\n177|\t\tfailures = append(failures, fmt.Sprintf(\"observed refusal codes = %v, want closed set %v\", codes, want))\n178|\t}\n179|\treturn failures\n180|}\n181|\n182|// refusalInventory is derived from package sources.\n183|type refusalInventory struct {\n184|\t// ScannedFiles are the production source basenames the derivation\n185|\t// parsed. The audit fails closed when this is empty.\n186|\tScannedFiles []string\n187|\t// Sites are file:line positions of production refusal constructor\n188|\t// calls. Every constructor call must sit on a single source line so\n189|\t// the runtime site and the parsed site agree.\n190|\tSites []string\n191|\t// StrayBuilders are axerror.New or axerror.LocalFromUntrusted calls\n192|\t// outside a constructor body.\n193|\tStrayBuilders []string\n194|\t// RawConstructors are errors.New, fmt.Errorf, or panic calls\n195|\t// anywhere in production code. There is no allowlist: dynamic facts\n196|\t// travel in Structured Error details, never in Go error text.\n197|\tRawConstructors []string\n198|}\n199|\n200|var refusalConstructors = map[string]bool{\n201|\t\"failInvalid\":   true,\n202|\t\"failProtocol\":  true,\n203|\t\"failMismatch\":  true,\n204|\t\"failProcess\":   true,\n205|\t\"failTimeout\":   true,\n206|\t\"failIntegrity\": true,\n207|}\n208|\n209|func deriveRefusalInventory(directory string) (refusalInventory, error) {\n210|\tentries, err := os.ReadDir(directory)\n211|\tif err != nil {\n212|\t\treturn refusalInventory{}, err\n213|\t}\n214|\tvar inventory refusalInventory\n215|\tfileSet := token.NewFileSet()\n216|\tfor _, entry := range entries {\n217|\t\tname := entry.Name()\n218|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n219|\t\t\tcontinue\n220|\t\t}\n221|\t\tinventory.ScannedFiles = append(inventory.ScannedFiles, name)\n222|\t\tpath := filepath.Join(directory, name)\n223|\t\tsource, err := os.ReadFile(path)\n224|\t\tif err != nil {\n225|\t\t\treturn refusalInventory{}, err\n226|\t\t}\n227|\t\tsyntax, err := parser.ParseFile(fileSet, path, source, parser.ParseComments)\n228|\t\tif err != nil {\n229|\t\t\treturn refusalInventory{}, err\n230|\t\t}\n231|\t\t// Map each constructor's own body span so builder calls inside\n232|\t\t// it are not mistaken for strays.\n233|\t\tconstructorBodies := map[*ast.FuncLit]bool{}\n234|\t\tfor _, decl := range syntax.Decls {\n235|\t\t\tgeneral, ok := decl.(*ast.GenDecl)\n236|\t\t\tif !ok {\n237|\t\t\t\tcontinue\n238|\t\t\t}\n239|\t\t\tfor _, spec := range general.Specs {\n240|\t\t\t\tvalues, ok := spec.(*ast.ValueSpec)\n241|\t\t\t\tif !ok {\n242|\t\t\t\t\tcontinue\n243|\t\t\t\t}\n244|\t\t\t\tfor i, ident := range values.Names {\n245|\t\t\t\t\tif !refusalConstructors[ident.Name] || i >= len(values.Values) {\n246|\t\t\t\t\t\tcontinue\n247|\t\t\t\t\t}\n248|\t\t\t\t\tif literal, ok := values.Values[i].(*ast.FuncLit); ok {\n249|\t\t\t\t\t\tconstructorBodies[literal] = true\n250|\t\t\t\t\t}\n251|\t\t\t\t}\n252|\t\t\t}\n253|\t\t}\n254|\t\tinsideConstructor := func(pos token.Pos) bool {\n255|\t\t\tfor body := range constructorBodies {\n256|\t\t\t\tif pos >= body.Pos() && pos <= body.End() {\n257|\t\t\t\t\treturn true\n258|\t\t\t\t}\n259|\t\t\t}\n260|\t\t\treturn false\n261|\t\t}\n262|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n263|\t\t\tcall, ok := node.(*ast.CallExpr)\n264|\t\t\tif !ok {\n265|\t\t\t\treturn true\n266|\t\t\t}\n267|\t\t\tposition := fileSet.Position(call.Pos())\n268|\t\t\tsite := fmt.Sprintf(\"%s:%d\", filepath.Base(position.Filename), position.Line)\n269|\t\t\tif ident, ok := call.Fun.(*ast.Ident); ok {\n270|\t\t\t\tif refusalConstructors[ident.Name] {\n271|\t\t\t\t\tinventory.Sites = append(inventory.Sites, site)\n272|\t\t\t\t\treturn true\n273|\t\t\t\t}\n274|\t\t\t\tif ident.Name == \"panic\" {\n275|\t\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" panic\")\n276|\t\t\t\t\treturn true\n277|\t\t\t\t}\n278|\t\t\t}\n279|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n280|\t\t\tif !ok {\n281|\t\t\t\treturn true\n282|\t\t\t}\n283|\t\t\tif qualifier, ok := selector.X.(*ast.Ident); ok {\n284|\t\t\t\tqualified := qualifier.Name + \".\" + selector.Sel.Name\n285|\t\t\t\tswitch qualified {\n286|\t\t\t\tcase \"axerror.New\", \"axerror.LocalFromUntrusted\":\n287|\t\t\t\t\tif !insideConstructor(call.Pos()) {\n288|\t\t\t\t\t\tinventory.StrayBuilders = append(inventory.StrayBuilders, site+\" \"+qualified)\n289|\t\t\t\t\t}\n290|\t\t\t\t\treturn true\n291|\t\t\t\tcase \"errors.New\", \"fmt.Errorf\":\n292|\t\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" \"+qualified)\n293|\t\t\t\t\treturn true\n294|\t\t\t\t}\n295|\t\t\t}\n296|\t\t\tif selector.Sel.Name == \"panic\" {\n297|\t\t\t\tinventory.RawConstructors = append(inventory.RawConstructors, site+\" panic\")\n298|\t\t\t}\n299|\t\t\treturn true\n300|\t\t})\n301|\t}\n302|\treturn inventory, nil\n303|}\n304|\n305|// sectionLines joins the pinned document lines for a section, failing\n306|// when the section boundaries move. Every citation below resolves\n307|// against the real text, never against a restatement in this repository.\n308|func sectionLines(t *testing.T, document *specdoc.Document, section string, first, last int) string {\n309|\tt.Helper()\n310|\tfor _, line := range []int{first, last} {\n311|\t\tgot, ok := document.SectionID(line)\n312|\t\tif !ok || got != section {\n313|\t\t\tt.Fatalf(\"SPEC.md line %d is in section %q, want %q\", line, got, section)\n314|\t\t}\n315|\t}\n316|\tvar body strings.Builder\n317|\tfor line := first; line <= last; line++ {\n318|\t\ttext, ok := document.Line(line)\n319|\t\tif !ok {\n320|\t\t\tt.Fatalf(\"SPEC.md line %d is missing\", line)\n321|\t\t}\n322|\t\tbody.WriteString(text)\n323|\t\tbody.WriteString(\"\\n\")\n324|\t}\n325|\treturn body.String()\n326|}\n327|\n328|// requireQuote asserts the excerpt occurs verbatim in the pinned\n329|// document and begins on a line inside the cited section.\n330|func requireQuote(t *testing.T, document *specdoc.Document, excerpt, section string) {\n331|\tt.Helper()\n332|\tif !document.Contains(excerpt) {\n333|\t\tt.Fatalf(\"pinned document does not contain %q\", excerpt)\n334|\t}\n335|\tlines := document.QuoteLines(excerpt)\n336|\tif len(lines) == 0 {\n337|\t\tt.Fatalf(\"pinned document quotes no line for %q\", excerpt)\n338|\t}\n339|\tgot, ok := document.SectionID(lines[0])\n340|\tif !ok || got != section {\n341|\t\tt.Fatalf(\"%q begins on SPEC.md line %d in section %q, want %q\", excerpt, lines[0], got, section)\n342|\t}\n343|\tt.Logf(\"%q begins on SPEC.md line %d\", excerpt, lines[0])\n344|}\n345|\n346|var operationCellPattern = regexp.MustCompile(`^\\| <code>([a-z-]+)</code> \\|`)\n347|\n348|// TestOperationRegistryIsDerivedFromSpec proves the dispatch registry is\n349|// exactly the Section 7.5 operation table in order: every table row must\n350|// appear in Operations() at the same position, and nothing else may.\n351|// A dropped, added, or reordered entry reddens here.\n352|func TestOperationRegistryIsDerivedFromSpec(t *testing.T) {\n353|\tdocument, err := specdoc.Load()\n354|\tif err != nil {\n355|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n356|\t}\n357|\twindow := sectionLines(t, document, \"7.5\", 3070, 3086)\n358|\tvar derived []string\n359|\tfor _, line := range strings.Split(window, \"\\n\") {\n360|\t\tif match := operationCellPattern.FindStringSubmatch(line); match != nil {\n361|\t\t\tderived = append(derived, match[1])\n362|\t\t}\n363|\t}\n364|\tif len(derived) == 0 {\n365|\t\tt.Fatal(\"derived no operations from the Section 7.5 table; the check is blind\")\n366|\t}\n367|\tgot := Operations()\n368|\tif fmt.Sprintf(\"%v\", got) != fmt.Sprintf(\"%v\", derived) {\n369|\t\tt.Fatalf(\"Operations() = %v, want the Section 7.5 table %v\", got, derived)\n370|\t}\n371|\tt.Logf(\"operation registry coverage: %d/%d table entries dispatched\", len(got), len(derived))\n372|}\n373|\n374|// TestSection72FramingIsPinned quotes every Section 7.2 sentence this\n375|// package implements: the framing limits, the process model, the\n376|// envelope shapes, the closed-member rule, and the deadline/redaction\n377|// duties.\n378|func TestSection72FramingIsPinned(t *testing.T) {\n379|\tdocument, err := specdoc.Load()\n380|\tif err != nil {\n381|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n382|\t}\n383|\tfor _, excerpt := range []string{\n384|\t\t\"Each line MUST be one complete UTF-8\",\n385|\t\t\"JSON object no larger than 8 MiB\",\n386|\t\t\"Stdout MUST contain protocol frames only\",\n387|\t\t\"human diagnostics go to stderr\",\n388|\t\t\"starts one plugin process per operation\",\n389|\t\t\"After one response, <code>ax</code> closes stdin and the\",\n390|\t\t\"Exit 0 requires a successful response\",\n391|\t\t\"A structured error\",\n392|\t\t\"response SHOULD exit 0 because the protocol succeeded\",\n393|\t\t\"a crash, invalid frame,\",\n394|\t\t\"or missing response is a provider-host failure\",\n395|\t\t\"The deadline MUST be in the future when the host writes the frame\",\n396|\t\t\"A failure envelope contains\",\n397|\t\t\"and MUST NOT contain <code>body</code>\",\n398|\t\t\"Envelope and body\",\n399|\t\t\"unknown members are protocol errors under major version 2\",\n400|\t\t\"The host MUST terminate a plugin that exceeds its deadline and report\",\n401|\t\t\"<code>provider_timeout</code>\",\n402|\t\t\"It MUST redact environment and stderr before\",\n403|\t\t\"logging\",\n404|\t} {\n405|\t\trequireQuote(t, document, excerpt, \"7.2\")\n406|\t}\n407|}\n408|\n409|// TestSection151ProviderRowIsPinned quotes the Section 15.1 provider\n410|// row behind the local failure mapping: recognizable majors yield\n411|// incompatible_protocol, everything else unusable yields\n412|// provider_protocol_error, and a different major's payload is never\n413|// trusted.\n414|func TestSection151ProviderRowIsPinned(t *testing.T) {\n415|\tdocument, err := specdoc.Load()\n416|\tif err != nil {\n417|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n418|\t}\n419|\tfor _, excerpt := range []string{\n420|\t\t\"The host accepts no child error object, terminates/waits for exit as applicable, and emits its own local Error 1.0.0\",\n421|\t\t\"<code>incompatible_protocol</code> for a recognizable major mismatch, otherwise <code>provider_protocol_error</code>\",\n422|\t\t\"Receivers MUST NOT parse a different major\",\n423|\t\t\"payload far enough to trust its error code, retryable bit, details, or\",\n424|\t} {\n425|\t\trequireQuote(t, document, excerpt, \"15.1\")\n426|\t}\n427|}\n428|\n429|// TestStatusRecoveryRulesArePinned quotes the Section 7.5 recovery\n430|// sentences behind DecodeStatusOutcome: the evolving status read, the\n431|// unknown quarantine, and the state/nullability table.\n432|func TestStatusRecoveryRulesArePinned(t *testing.T) {\n433|\tdocument, err := specdoc.Load()\n434|\tif err != nil {\n435|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n436|\t}\n437|\tfor _, excerpt := range []string{\n438|\t\t\"is the required evolving lost-response recovery\",\n439|\t\t\"An unknown transaction MUST return state\",\n440|\t\t\"<code>unknown</code>; the host MUST NOT infer success\",\n441|\t\t\"An unreadable or\",\n442|\t\t\"integrity-invalid transaction MUST fail with <code>integrity_failure</code> and\",\n443|\t\t\"MUST be quarantined rather than represented as a successful status object\",\n444|\t\t\"<code>unknown</code> requires null\",\n445|\t\t\"requires all three non-null\",\n446|\t} {\n447|\t\trequireQuote(t, document, excerpt, \"7.5\")\n448|\t}\n449|}\n450|\n451|// TestStableCodesAreRegistered pins every refusal code this package\n452|// emits against the pinned error registry and the exact exit the host\n453|// surfaces, and agrees with the axerror wire table.\n454|func TestStableCodesAreRegistered(t *testing.T) {\n455|\tregistered := map[string]int{}\n456|\tfor _, row := range catalog.Current().Errors {\n457|\t\tregistered[string(row.Code)] = row.ExitCode\n458|\t}\n459|\tfor code, wantExit := range map[string]int{\n460|\t\t\"invalid_config\":          3,\n461|\t\t\"provider_protocol_error\": 13,\n462|\t\t\"incompatible_protocol\":   6,\n463|\t\t\"provider_process_failed\": 13,\n464|\t\t\"provider_timeout\":        13,\n465|\t\t\"integrity_failure\":       9,\n466|\t} {\n467|\t\tgotExit, ok := registered[code]\n468|\t\tif !ok {\n469|\t\t\tt.Fatalf(\"code %q is not in the pinned error registry\", code)\n470|\t\t}\n471|\t\tif gotExit != wantExit {\n472|\t\t\tt.Fatalf(\"code %q exit = %d, want %d\", code, gotExit, wantExit)\n473|\t\t}\n474|\t\tgotWire, err := axerror.ExitCodeFor(axerror.Version100, axerror.Code(code))\n475|\t\tif err != nil {\n476|\t\t\tt.Fatalf(\"ExitCodeFor(1.0.0, %q): %v\", code, err)\n477|\t\t}\n478|\t\tif gotWire != wantExit {\n479|\t\t\tt.Fatalf(\"wire exit for %q = %d, want %d\", code, gotWire, wantExit)\n480|\t\t}\n481|\t}\n482|\tt.Logf(\"refusal code coverage: 6/6 package codes registered with pinned exits\")\n483|}\n484|\n485|// TestRefusalConstructorsAreTotal proves the fallible-constructor error\n486|// path never fires in practice: every constructor returns a failure and\n487|// a nil error across representative dynamic causes. The sites recorded\n488|// here are test lines, not production sites, so every key this test adds\n489|// to the exercised set is removed before it returns, keeping the\n490|// reverse-direction audit exact.\n491|func TestRefusalConstructorsAreTotal(t *testing.T) {\n492|\tvar beforeSites, beforeCodes []any\n493|\texercisedRefusalSites.Range(func(key, _ any) bool { beforeSites = append(beforeSites, key); return true })\n494|\tobservedCodes.Range(func(key, _ any) bool { beforeCodes = append(beforeCodes, key); return true })\n495|\tt.Cleanup(func() {\n496|\t\tkeepSites := map[any]bool{}\n497|\t\tfor _, key := range beforeSites {\n498|\t\t\tkeepSites[key] = true\n499|\t\t}\n500|\t\texercisedRefusalSites.Range(func(key, _ any) bool {\n(more lines below)"}}}
