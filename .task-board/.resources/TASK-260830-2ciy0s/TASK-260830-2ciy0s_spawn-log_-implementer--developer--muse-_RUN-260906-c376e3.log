{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c571","stream":{"kind":"session","id":"01a07721-ca06-7081-babf-b563190d8d78"},"sequence":275,"recorded_at":1780531400000545,"record_type":"event","durability":"durable","causation_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","run_stream":{"kind":"run","id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd"},"call_id":"call_01a0772228a07b40aa44488c41406a34","text":"Read text file `internal/cliresult/output.go`.\n1|package cliresult\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|\t\"io\"\n7|\t\"sort\"\n8|\t\"strings\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n12|)\n13|\n14|// terminalLine prepares one human line for a terminal stream: secret\n15|// scrubbing, then control-string neutralization (Section 16.7). JSON mode\n16|// never crosses this function: machine output stays byte-exact, and the\n17|// JSON encoder already escapes its controls. The composition is\n18|// idempotent, so an already-safe line passes through unchanged.\n19|func terminalLine(line string) string {\n20|\treturn secprim.RenderForTerminal(line, nil)\n21|}\n22|\n23|// Mode is the Section 14.2 output mode. --json selects \"one version-selected\n24|// CLI Result success object or Structured Error failure object\"; its absence\n25|// selects text.\n26|type Mode string\n27|\n28|const (\n29|\t// ModeText is the default human mode: \"data goes to stdout and\n30|\t// prompts/diagnostics to stderr\".\n31|\tModeText Mode = \"text\"\n32|\t// ModeJSON is structured mode: \"stdout MUST contain exactly one JSON\n33|\t// document; logs remain on stderr\".\n34|\tModeJSON Mode = \"json\"\n35|)\n36|\n37|// SuccessExitStatus is the Section 15.2 status of a successful operation. It is\n38|// the only status a CLI Result can produce.\n39|const SuccessExitStatus = 0\n40|\n41|var (\n42|\t// ErrStreamDiscipline reports a write that would violate the Section 14.2\n43|\t// stdout/stderr boundary, including a second document on stdout in JSON\n44|\t// mode.\n45|\tErrStreamDiscipline = errors.New(\"cli output stream discipline violated\")\n46|\n47|\t// ErrPromptForbidden reports a prompt attempted under --non-interactive,\n48|\t// which Section 14.2 says \"forbids prompts\".\n49|\tErrPromptForbidden = errors.New(\"prompt forbidden by --non-interactive\")\n50|)\n51|\n52|// Streams are the two process streams a command writes to, plus whether stderr\n53|// is a terminal. Section 14.2 permits progress on stderr \"only when it is a\n54|// TTY\", so the answer is an input rather than something this package probes:\n55|// the caller owns the file descriptors and this package opens nothing.\n56|type Streams struct {\n57|\tStdout      io.Writer\n58|\tStderr      io.Writer\n59|\tStderrIsTTY bool\n60|}\n61|\n62|// Emitter enforces the Section 14.2 rendering boundary for one invocation. It\n63|// is not a renderer: it decides which stream each kind of output belongs on and\n64|// how many documents stdout may carry, and it never invents human text for a\n65|// body the specification does not describe in human form.\n66|type Emitter struct {\n67|\tmode           Mode\n68|\tstreams        Streams\n69|\tnonInteractive bool\n70|\temitted        bool\n71|}\n72|\n73|// NewEmitter builds the rendering boundary for a parsed invocation.\n74|func NewEmitter(invocation *Invocation, streams Streams) (*Emitter, error) {\n75|\tif invocation == nil {\n76|\t\treturn nil, fmt.Errorf(\"%w: invocation is nil\", ErrStreamDiscipline)\n77|\t}\n78|\treturn newEmitter(invocation.Mode(), invocation.NonInteractive(), streams)\n79|}\n80|\n81|func newEmitter(mode Mode, nonInteractive bool, streams Streams) (*Emitter, error) {\n82|\tif mode != ModeText && mode != ModeJSON {\n83|\t\treturn nil, fmt.Errorf(\"%w: %q is not a supported output mode\", ErrStreamDiscipline, mode)\n84|\t}\n85|\tif streams.Stdout == nil || streams.Stderr == nil {\n86|\t\treturn nil, fmt.Errorf(\"%w: both streams are required\", ErrStreamDiscipline)\n87|\t}\n88|\treturn &Emitter{mode: mode, streams: streams, nonInteractive: nonInteractive}, nil\n89|}\n90|\n91|// Mode reports the output mode this emitter enforces.\n92|func (emitter *Emitter) Mode() Mode { return emitter.mode }\n93|\n94|// Log writes one diagnostic line. Section 14.2 puts diagnostics on stderr in\n95|// text mode and says \"logs remain on stderr\" in JSON mode, so the destination\n96|// is the same in both and there is no mode in which a log can reach stdout.\n97|func (emitter *Emitter) Log(line string) error {\n98|\treturn writeLine(emitter.streams.Stderr, terminalLine(line))\n99|}\n100|\n101|// Progress writes one progress line. Section 14.2 says \"progress MAY use stderr\n102|// only when it is a TTY\", so a non-TTY stderr drops the line instead of\n103|// choosing another stream for it. The boolean reports whether it was written,\n104|// because silently dropping output without saying so is how a caller comes to\n105|// believe something was displayed.\n106|func (emitter *Emitter) Progress(line string) (bool, error) {\n107|\tif !emitter.streams.StderrIsTTY {\n108|\t\treturn false, nil\n109|\t}\n110|\tif err := writeLine(emitter.streams.Stderr, terminalLine(line)); err != nil {\n111|\t\treturn false, err\n112|\t}\n113|\treturn true, nil\n114|}\n115|\n116|// Prompt writes one prompt to stderr. It refuses under --non-interactive, which\n117|// Section 14.2 says \"forbids prompts\". The refusal is the point: a prompt that\n118|// silently degrades to a default is exactly the confirmation bypass Section\n119|// 14.2 forbids elsewhere.\n120|func (emitter *Emitter) Prompt(line string) error {\n121|\tif emitter.nonInteractive {\n122|\t\treturn fmt.Errorf(\"%w: %q\", ErrPromptForbidden, terminalLine(line))\n123|\t}\n124|\treturn writeLine(emitter.streams.Stderr, terminalLine(line))\n125|}\n126|\n127|// Outcome is the single result of one command invocation. Exactly one of\n128|// Result and Failure is set: Section 14.2 makes success and failure different\n129|// objects, so an outcome carrying both, or neither, is not representable as a\n130|// conforming emission and is refused.\n131|type Outcome struct {\n132|\t// Result is the success object, or nil for a failure.\n133|\tResult *Result\n134|\t// Failure is the Structured Error, or nil for a success.\n135|\tFailure *axerror.Error\n136|\t// Rendered is the human text for text mode. It is required in text mode\n137|\t// and refused in JSON mode, where stdout carries exactly one JSON document\n138|\t// and nothing else.\n139|\tRendered string\n140|}\n141|\n142|// Emit writes the outcome and returns the exact process exit status for it.\n143|//\n144|// The status is the Section 14.2 rule verbatim: \"the process exit status MUST\n145|// equal that error's exit_code\". A success is SuccessExitStatus, and a failure\n146|// is the status the Structured Error registry assigned to its code - this\n147|// function does not compute, adjust, or clamp it.\n148|//\n149|// In JSON mode stdout receives exactly one JSON document and nothing else, and\n150|// a second call is refused. In text mode the success rendering goes to stdout\n151|// and the failure rendering goes to stderr, because Section 14.2 puts data on\n152|// stdout and diagnostics on stderr and a failure is a diagnostic.\n153|//\n154|// The returned status is valid even when the write fails: the operation's\n155|// outcome is already decided, and reporting exit 0 because a pipe closed would\n156|// misreport a failure as a success.\n157|func (emitter *Emitter) Emit(outcome Outcome) (int, error) {\n158|\tstatus, err := outcome.exitStatus()\n159|\tif err != nil {\n160|\t\treturn status, err\n161|\t}\n162|\tif emitter.emitted {\n163|\t\treturn status, fmt.Errorf(\"%w: stdout already carries this command's one document\", ErrStreamDiscipline)\n164|\t}\n165|\temitter.emitted = true\n166|\tif emitter.mode == ModeJSON {\n167|\t\tif outcome.Rendered != \"\" {\n168|\t\t\treturn status, fmt.Errorf(\n169|\t\t\t\t\"%w: JSON mode carries exactly one JSON document, so human text is not emitted\",\n170|\t\t\t\tErrStreamDiscipline)\n171|\t\t}\n172|\t\tdocument, err := outcome.document()\n173|\t\tif err != nil {\n174|\t\t\treturn status, err\n175|\t\t}\n176|\t\treturn status, writeLine(emitter.streams.Stdout, string(document))\n177|\t}\n178|\tif outcome.Rendered == \"\" {\n179|\t\treturn status, fmt.Errorf(\"%w: text mode requires a human rendering\", ErrStreamDiscipline)\n180|\t}\n181|\tif outcome.Failure != nil {\n182|\t\treturn status, writeLine(emitter.streams.Stderr, terminalLine(outcome.Rendered))\n183|\t}\n184|\treturn status, writeLine(emitter.streams.Stdout, terminalLine(outcome.Rendered))\n185|}\n186|\n187|// exitStatus resolves the Section 14.2 process exit status of an outcome.\n188|func (outcome Outcome) exitStatus() (int, error) {\n189|\tswitch {\n190|\tcase outcome.Result != nil && outcome.Failure != nil:\n191|\t\treturn 0, fmt.Errorf(\"%w: an outcome is a success or a failure, never both\", ErrStreamDiscipline)\n192|\tcase outcome.Result != nil:\n193|\t\treturn SuccessExitStatus, nil\n194|\tcase outcome.Failure != nil:\n195|\t\treturn outcome.Failure.ExitCode(), nil\n196|\tdefault:\n197|\t\treturn 0, fmt.Errorf(\"%w: an outcome carries neither a result nor a failure\", ErrStreamDiscipline)\n198|\t}\n199|}\n200|\n201|// ExitStatus reports the process exit status of an outcome without emitting it.\n202|// It exists so that a caller can settle the status and the emission separately\n203|// and still get one answer from one place.\n204|func ExitStatus(outcome Outcome) (int, error) { return outcome.exitStatus() }\n205|\n206|func (outcome Outcome) document() ([]byte, error) {\n207|\tif outcome.Failure != nil {\n208|\t\treturn outcome.Failure.MarshalJSON()\n209|\t}\n210|\treturn outcome.Result.MarshalJSON()\n211|}\n212|\n213|// writeLine terminates every write. A stream that must carry exactly one\n214|// document cannot afford an unterminated write merging with whatever follows\n215|// it, and a terminator is what makes \"one document\" observable to a reader.\n216|func writeLine(writer io.Writer, line string) error {\n217|\tif !strings.HasSuffix(line, \"\\n\") {\n218|\t\tline += \"\\n\"\n219|\t}\n220|\t_, err := io.WriteString(writer, line)\n221|\treturn err\n222|}\n223|\n224|// DestructiveOperation names one Section 14.2 \"destructive or split-brain-risk\"\n225|// operation together with the expectation flags Section 14.1 documents for it.\n226|type DestructiveOperation string\n227|\n228|const (\n229|\t// OperationForceTakeover is ax takeover --force, whose Section 14.1 grammar\n230|\t// is \"[--force --expect-owner ID --expect-epoch N] [--yes]\".\n231|\tOperationForceTakeover DestructiveOperation = \"takeover --force\"\n232|\t// OperationReplaceManagedReplica is ax materialize\n233|\t// --replace-managed-replica, which Section 14.1 says \"requires\n234|\t// --expect-checkpoint equal to its managed marker\" and whose\n235|\t// \"non-interactive replacement also requires --yes\".\n236|\tOperationReplaceManagedReplica DestructiveOperation = \"materialize --replace-managed-replica\"\n237|)\n238|\n239|// destructiveOperations is the reviewed table of operations that Section 14.2's\n240|// confirmation rule governs, each with the expectation flags Section 14.1\n241|// documents for it. An operation is listed only where the pinned document\n242|// states its expectation flags; nothing is added here because it merely looks\n243|// risky.\n244|var destructiveOperations = map[DestructiveOperation][]string{\n245|\tOperationForceTakeover:         {\"--expect-epoch\", \"--expect-owner\"},\n246|\tOperationReplaceManagedReplica: {\"--expect-checkpoint\"},\n247|}\n248|\n249|// DestructiveOperations returns the governed operations in sorted order.\n250|func DestructiveOperations() []DestructiveOperation {\n251|\tresult := make([]DestructiveOperation, 0, len(destructiveOperations))\n252|\tfor operation := range destructiveOperations {\n253|\t\tresult = append(result, operation)\n254|\t}\n255|\tsort.Slice(result, func(left, right int) bool { return result[left] < result[right] })\n256|\treturn result\n257|}\n258|\n259|// ExpectationFlags returns the documented expectation flags of an operation, in\n260|// sorted order.\n261|func ExpectationFlags(operation DestructiveOperation) ([]string, error) {\n262|\tflags, known := destructiveOperations[operation]\n263|\tif !known {\n264|\t\treturn nil, fmt.Errorf(\"%w: %q\", ErrUnknownSurface, operation)\n265|\t}\n266|\treturn append([]string(nil), flags...), nil\n267|}\n268|\n269|// Confirmation is the decision the Section 14.2 confirmation rule produces.\n270|type Confirmation struct {\n271|\t// PromptRequired is true when the caller must prompt before mutating.\n272|\t// Section 14.2: \"destructive or split-brain-risk operations MUST prompt in\n273|\t// interactive mode\".\n274|\tPromptRequired bool\n275|}\n276|\n277|// RequireConfirmation decides whether a destructive or split-brain-risk\n278|// operation may proceed.\n279|//\n280|// Section 14.2 states the rule in two sentences, and both are enforced here:\n281|// such an operation \"MUST prompt in interactive mode and require --yes plus\n282|// every documented expectation flag in non-interactive mode\", and \"--yes alone\n283|// MUST NOT bypass an expected owner/epoch/checkpoint check\".\n284|//\n285|// The second sentence is why the expectation flags are checked before --yes is\n286|// consulted and independently of it: a missing expectation flag is refused\n287|// whether or not --yes is present, in interactive and non-interactive mode\n288|// alike, so confirming can never stand in for stating the expected owner,\n289|// epoch, or checkpoint.\n290|func RequireConfirmation(\n291|\toperation DestructiveOperation,\n292|\tinvocation *Invocation,\n293|\tsupplied []string,\n294|) (Confirmation, *axerror.Error) {\n295|\texpected, err := ExpectationFlags(operation)\n296|\tif err != nil {\n297|\t\treturn Confirmation{}, mustInvalidArguments(err.Error())\n298|\t}\n299|\tif invocation == nil {\n300|\t\treturn Confirmation{}, mustInvalidArguments(\"no parsed invocation was supplied\")\n301|\t}\n302|\tpresent := make(map[string]struct{}, len(supplied))\n303|\tfor _, flag := range supplied {\n304|\t\tpresent[flag] = struct{}{}\n305|\t}\n306|\tvar missing []string\n307|\tfor _, flag := range expected {\n308|\t\tif _, ok := present[flag]; !ok {\n309|\t\t\tmissing = append(missing, flag)\n310|\t\t}\n311|\t}\n312|\tif len(missing) > 0 {\n313|\t\treturn Confirmation{}, mustInvalidArguments(fmt.Sprintf(\n314|\t\t\t\"%s requires %s; --yes does not bypass an expected owner, epoch, or checkpoint check\",\n315|\t\t\toperation, strings.Join(missing, \" and \")))\n316|\t}\n317|\tif !invocation.NonInteractive() {\n318|\t\treturn Confirmation{PromptRequired: true}, nil\n319|\t}\n320|\tif !invocation.Yes() {\n321|\t\treturn Confirmation{}, mustConfirmationRequired(fmt.Sprintf(\n322|\t\t\t\"%s requires --yes in non-interactive mode\", operation))\n323|\t}\n324|\treturn Confirmation{}, nil\n325|}\n326|\n327|// mustConfirmationRequired builds the Section 15.3 exit-16 refusal for a\n328|// missing destructive confirmation.\n329|func mustConfirmationRequired(message string) *axerror.Error {\n330|\tfailure, err := axerror.New(axerror.Spec{\n331|\t\tVersion: axerror.Version100,\n332|\t\tCode:    \"confirmation_required\",\n333|\t\tMessage: message,\n334|\t\tIDs:     axerror.NoIDs(),\n335|\t\tDetails: axerror.Details{},\n336|\t})\n337|\tif err != nil {\n338|\t\tpanic(fmt.Sprintf(\"cli result confirmation refusal is unconstructible: %v\", err))\n339|\t}\n340|\treturn failure\n341|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c573","stream":{"kind":"session","id":"01a07721-ca06-7081-babf-b563190d8d78"},"sequence":276,"recorded_at":1780531400000547,"record_type":"event","durability":"durable","causation_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","run_stream":{"kind":"run","id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd"},"call_id":"call_01a07722296471d1a4f37d83ab939800","text":"Read text file `internal/dirnode/arm_reachability_test.go`.\n1|package dirnode\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"os\"\n6|\t\"sort\"\n7|\t\"strings\"\n8|\t\"testing\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n11|)\n12|\n13|// This file is the derived arm-reachability gate (review round 3,\n14|// C1). The arm census in census_test.go derives every refusal arm\n15|// from production source and maps each to witness tests, but it\n16|// never checks that a witness actually fires the arm it names: a\n17|// vector carrying two defects is satisfied by whichever arm fires\n18|// first, and three committed \"unknown member\" vectors proved this\n19|// by reaching a strict-decode, operation, and node-build arm while\n20|// naming the envelope unknown-member arm. A code-only assertion\n21|// cannot tell those paths apart, and a deleted-member vector\n22|// refuses downstream with the same code, so code-only witnesses\n23|// leave missing-member, extensions, and empty-frame arms deletable\n24|// with a green suite.\n25|//\n26|// The gate below closes the class without another hand audit.\n27|// Every row pairs one production-derived arm key with a vector\n28|// driven through a production entry, and the test computes which\n29|// arm the vector actually reaches from the refusal message:\n30|//\n31|//   - a literal arm (ctor|<ctor>|<detail>) matches when the message\n32|//     carries its full detail; the row passes only when exactly the\n33|//     named literal matches, so a vector that slides to a sibling\n34|//     arm or to the strict conduit fails naming the arm it reached;\n35|//   - a fault conduit (...\"<prefix> \"+fault.detail) or a\n36|//     context-prefixed arm (context+\"<suffix>\") matches on its\n37|//     derived prefix/suffix; the row passes only when the named arm\n38|//     matches, no literal matches, and every other match is at most\n39|//     one frame fault travelling the same conduit;\n40|//   - a frame fault (frame|<detail>) matches on its detail and pins\n41|//     its carrier conduit through the also key, so the fault and\n42|//     the entry that carried it are both derived.\n43|//\n44|// A row whose reached arm cannot be determined — no match, or a\n45|// match set outside the shapes above — fails, never passes. The\n46|// roster fails closed in both directions: an arm with no row fails\n47|// unless it carries a defensive rationale in defensiveArms, and a\n48|// row naming an arm production no longer derives fails as\n49|// orphaned. Expected messages are never retyped here: they come\n50|// from the derived keys, so a reworded production arm fails its\n51|// row instead of passing against a stale copy.\n52|//\n53|// The checkResponseIdentity context arms instantiate with the call\n54|// site's context word. TestReachabilityContextsAreClosed derives\n55|// the context set from production calls and requires exactly\n56|// success and failure, so the matcher below cannot silently miss a\n57|// third instantiation.\n58|\n59|// armReachRow pairs one derived arm key with the vector that fires\n60|// it. also optionally names a second derived key whose text must\n61|// also match: frame-fault rows pin the carrier conduit that way.\n62|type armReachRow struct {\n63|\tarm   string\n64|\tname  string\n65|\tdrive func(t *testing.T) error\n66|\talso  string\n67|}\n68|\n69|// rowName renders the subtest name for one row: the arm key,\n70|// entry-suffixed for the one key emitted at two production sites.\n71|func (row armReachRow) rowName() string {\n72|\tif row.name != \"\" {\n73|\t\treturn row.name\n74|\t}\n75|\treturn row.arm\n76|}\n77|\n78|// deriveLiteralArmSiteCounts counts production call sites per\n79|// literal arm key. Most literals are emitted once; a literal\n80|// emitted at two sites shares one arm key, and the roster below\n81|// requires one firing vector per emitting site — a row driving\n82|// the other site cannot redden when this one is removed.\n83|func deriveLiteralArmSiteCounts(t *testing.T) map[string]int {\n84|\tt.Helper()\n85|\tregistered := map[string]bool{}\n86|\tfor _, name := range refusalConstructors {\n87|\t\tregistered[name] = true\n88|\t}\n89|\tcounts := map[string]int{}\n90|\tfor _, path := range productionFiles(t) {\n91|\t\tsource, err := os.ReadFile(path)\n92|\t\tif err != nil {\n93|\t\t\tt.Fatalf(\"site counts: %v\", err)\n94|\t\t}\n95|\t\tsyntax, err := parseGoFile(path, source)\n96|\t\tif err != nil {\n97|\t\t\tt.Fatalf(\"site counts: %v\", err)\n98|\t\t}\n99|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n100|\t\t\tfunction, ok := node.(*ast.FuncDecl)\n101|\t\t\tif !ok || function.Body == nil {\n102|\t\t\t\treturn true\n103|\t\t\t}\n104|\t\t\tast.Inspect(function.Body, func(inner ast.Node) bool {\n105|\t\t\t\tcall, ok := inner.(*ast.CallExpr)\n106|\t\t\t\tif !ok {\n107|\t\t\t\t\treturn true\n108|\t\t\t\t}\n109|\t\t\t\ttarget, ok := call.Fun.(*ast.Ident)\n110|\t\t\t\tif !ok || !registered[target.Name] || len(call.Args) == 0 {\n111|\t\t\t\t\treturn true\n112|\t\t\t\t}\n113|\t\t\t\tliteral, ok := call.Args[0].(*ast.BasicLit)\n114|\t\t\t\tif !ok {\n115|\t\t\t\t\treturn true\n116|\t\t\t\t}\n117|\t\t\t\tcounts[target.Name+\"|\"+strings.Trim(literal.Value, `\"`)]++\n118|\t\t\t\treturn true\n119|\t\t\t})\n120|\t\t\treturn false\n121|\t\t})\n122|\t}\n123|\treturn counts\n124|}\n125|\n126|// literalSubkey renders the site-count lookup key for one derived\n127|// literal arm key.\n128|func literalSubkey(key string) (string, bool) {\n129|\trest, ok := strings.CutPrefix(key, \"ctor|\")\n130|\tif !ok {\n131|\t\treturn \"\", false\n132|\t}\n133|\tseparator := strings.Index(rest, \"|\")\n134|\tif separator < 0 || rest[separator+1:] == \"\" {\n135|\t\treturn \"\", false\n136|\t}\n137|\treturn rest[:separator] + \"|\" + rest[separator+1:], true\n138|}\n139|\n140|// quotedInner returns the text between the first pair of double\n141|// quotes in a rendered derivation expression: the literal prefix\n142|// of a fault conduit or the suffix of a context arm.\n143|func quotedInner(render string) string {\n144|\tfirst := strings.Index(render, `\"`)\n145|\tif first < 0 {\n146|\t\treturn \"\"\n147|\t}\n148|\tsecond := strings.Index(render[first+1:], `\"`)\n149|\tif second < 0 {\n150|\t\treturn \"\"\n151|\t}\n152|\treturn render[first+1 : first+1+second]\n153|}\n154|\n155|// ctorEnvelope is the derived refusal envelope of one error\n156|// constructor: the wire code and the message wrapper every arm\n157|// built through it carries.\n158|type ctorEnvelope struct {\n159|\tcode    string\n160|\twrapper string\n161|}\n162|\n163|// deriveCtorEnvelopes derives the wire code and message wrapper of\n164|// every registered refusal constructor from production source.\n165|// Every constructor must hold exactly one axerror.New call shaped\n166|// as Spec{Version: _, Code: \"<literal>\", Message: \"<literal>\" +\n167|// <first-param>, ...}: any other construction shape is a\n168|// derivation violation, never a silent pass, so a constructor\n169|// that stops prefixing its detail fails here instead of matching\n170|// nothing anywhere.\n171|func deriveCtorEnvelopes(t *testing.T) map[string]ctorEnvelope {\n172|\tt.Helper()\n173|\tregistered := map[string]bool{}\n174|\tfor _, name := range refusalConstructors {\n175|\t\tregistered[name] = true\n176|\t}\n177|\tenvelopes := map[string]ctorEnvelope{}\n178|\tvar violations []string\n179|\tfor _, path := range productionFiles(t) {\n180|\t\tsource, err := os.ReadFile(path)\n181|\t\tif err != nil {\n182|\t\t\tt.Fatalf(\"envelopes: %v\", err)\n183|\t\t}\n184|\t\tsyntax, err := parseGoFile(path, source)\n185|\t\tif err != nil {\n186|\t\t\tt.Fatalf(\"envelopes: %v\", err)\n187|\t\t}\n188|\t\tfor _, declaration := range syntax.Decls {\n189|\t\t\tgeneral, ok := declaration.(*ast.GenDecl)\n190|\t\t\tif !ok {\n191|\t\t\t\tcontinue\n192|\t\t\t}\n193|\t\t\tfor _, specification := range general.Specs {\n194|\t\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n195|\t\t\t\tif !ok || len(value.Values) != 1 {\n196|\t\t\t\t\tcontinue\n197|\t\t\t\t}\n198|\t\t\t\tliteral, ok := value.Values[0].(*ast.FuncLit)\n199|\t\t\t\tif !ok {\n200|\t\t\t\t\tcontinue\n201|\t\t\t\t}\n202|\t\t\t\tfor _, name := range value.Names {\n203|\t\t\t\t\tif !registered[name.Name] {\n204|\t\t\t\t\t\tcontinue\n205|\t\t\t\t\t}\n206|\t\t\t\t\tcalls := 0\n207|\t\t\t\t\tast.Inspect(literal.Body, func(node ast.Node) bool {\n208|\t\t\t\t\t\tcall, ok := node.(*ast.CallExpr)\n209|\t\t\t\t\t\tif !ok {\n210|\t\t\t\t\t\t\treturn true\n211|\t\t\t\t\t\t}\n212|\t\t\t\t\t\ttarget, ok := call.Fun.(*ast.SelectorExpr)\n213|\t\t\t\t\t\tif !ok {\n214|\t\t\t\t\t\t\treturn true\n215|\t\t\t\t\t\t}\n216|\t\t\t\t\t\tpackageName, ok := target.X.(*ast.Ident)\n217|\t\t\t\t\t\tif !ok || packageName.Name != \"axerror\" || target.Sel.Name != \"New\" {\n218|\t\t\t\t\t\t\treturn true\n219|\t\t\t\t\t\t}\n220|\t\t\t\t\t\tcalls++\n221|\t\t\t\t\t\tif len(call.Args) != 1 {\n222|\t\t\t\t\t\t\tviolations = append(violations, name.Name+\": axerror.New arity is not 1\")\n223|\t\t\t\t\t\t\treturn true\n224|\t\t\t\t\t\t}\n225|\t\t\t\t\t\tcomposite, ok := call.Args[0].(*ast.CompositeLit)\n226|\t\t\t\t\t\tif !ok {\n227|\t\t\t\t\t\t\tviolations = append(violations, name.Name+\": axerror.New argument is not a composite literal\")\n228|\t\t\t\t\t\t\treturn true\n229|\t\t\t\t\t\t}\n230|\t\t\t\t\t\tvar code, wrapper string\n231|\t\t\t\t\t\tvar detailIdent bool\n232|\t\t\t\t\t\tfor _, element := range composite.Elts {\n233|\t\t\t\t\t\t\tpair, ok := element.(*ast.KeyValueExpr)\n234|\t\t\t\t\t\t\tif !ok {\n235|\t\t\t\t\t\t\t\tcontinue\n236|\t\t\t\t\t\t\t}\n237|\t\t\t\t\t\t\tfield, ok := pair.Key.(*ast.Ident)\n238|\t\t\t\t\t\t\tif !ok {\n239|\t\t\t\t\t\t\t\tcontinue\n240|\t\t\t\t\t\t\t}\n241|\t\t\t\t\t\t\tswitch field.Name {\n242|\t\t\t\t\t\t\tcase \"Code\":\n243|\t\t\t\t\t\t\t\tlit, ok := pair.Value.(*ast.BasicLit)\n244|\t\t\t\t\t\t\t\tif ok && lit.Kind.String() == \"STRING\" {\n245|\t\t\t\t\t\t\t\t\tcode = strings.Trim(lit.Value, `\"`)\n246|\t\t\t\t\t\t\t\t}\n247|\t\t\t\t\t\t\tcase \"Message\":\n248|\t\t\t\t\t\t\t\tbinary, ok := pair.Value.(*ast.BinaryExpr)\n249|\t\t\t\t\t\t\t\tif !ok {\n250|\t\t\t\t\t\t\t\t\tbreak\n251|\t\t\t\t\t\t\t\t}\n252|\t\t\t\t\t\t\t\tlit, ok := binary.X.(*ast.BasicLit)\n253|\t\t\t\t\t\t\t\tif !ok || lit.Kind.String() != \"STRING\" {\n254|\t\t\t\t\t\t\t\t\tbreak\n255|\t\t\t\t\t\t\t\t}\n256|\t\t\t\t\t\t\t\tif _, ok := binary.Y.(*ast.Ident); !ok {\n257|\t\t\t\t\t\t\t\t\tbreak\n258|\t\t\t\t\t\t\t\t}\n259|\t\t\t\t\t\t\t\twrapper = strings.Trim(lit.Value, `\"`)\n260|\t\t\t\t\t\t\t\tdetailIdent = true\n261|\t\t\t\t\t\t\t}\n262|\t\t\t\t\t\t}\n263|\t\t\t\t\t\tif code == \"\" || !detailIdent {\n264|\t\t\t\t\t\t\tviolations = append(violations, name.Name+\": envelope is not Code:<literal> with Message:<literal>+detail\")\n265|\t\t\t\t\t\t\treturn true\n266|\t\t\t\t\t\t}\n267|\t\t\t\t\t\tenvelopes[name.Name] = ctorEnvelope{code: code, wrapper: wrapper}\n268|\t\t\t\t\t\treturn true\n269|\t\t\t\t\t})\n270|\t\t\t\t\tif calls != 1 {\n271|\t\t\t\t\t\tviolations = append(violations, name.Name+\": envelope holds neither exactly one axerror.New call\")\n272|\t\t\t\t\t}\n273|\t\t\t\t}\n274|\t\t\t}\n275|\t\t}\n276|\t}\n277|\tif len(violations) > 0 {\n278|\t\tsort.Strings(violations)\n279|\t\tt.Fatalf(\"envelope violations:\\n  %s\", strings.Join(violations, \"\\n  \"))\n280|\t}\n281|\tif len(envelopes) != len(registered) {\n282|\t\tt.Fatalf(\"derived envelopes = %d, want %d registered constructors\", len(envelopes), len(registered))\n283|\t}\n284|\treturn envelopes\n285|}\n286|\n287|// armKeyShape classifies one derived arm key for matching.\n288|type armKeyShape int\n289|\n290|const (\n291|\tarmShapeUnknown armKeyShape = iota\n292|\tarmShapeLiteral\n293|\tarmShapeConduit\n294|\tarmShapeContext\n295|\tarmShapeContextFault\n296|\tarmShapeFrame\n297|)\n298|\n299|// classifyArmKey splits one derived key into its match shape and\n300|// match text. The second result is false for a shape this gate\n301|// does not understand: the row fails instead of passing\n302|// vacuously.\n303|func classifyArmKey(key string) (armKeyShape, string, bool) {\n304|\tif rest, ok := strings.CutPrefix(key, \"frame|\"); ok && rest != \"\" {\n305|\t\treturn armShapeFrame, rest, true\n306|\t}\n307|\t// Only the first two separators are structural: literal\n308|\t// details may carry their own \"|\" (amd64|arm64), so the\n309|\t// detail is everything after ctor|<constructor>|.\n310|\trest, ok := strings.CutPrefix(key, \"ctor|\")\n311|\tif !ok {\n312|\t\treturn armShapeUnknown, \"\", false\n313|\t}\n314|\tseparator := strings.Index(rest, \"|\")\n315|\tif separator < 0 {\n316|\t\treturn armShapeUnknown, \"\", false\n317|\t}\n318|\tpayload := rest[separator+1:]\n319|\tif payload == \"\" {\n320|\t\treturn armShapeUnknown, \"\", false\n321|\t}\n322|\tif expr, ok := strings.CutPrefix(payload, \"expr|\"); ok {\n323|\t\tseparator := strings.Index(expr, \"|\")\n324|\t\tif separator < 0 {\n325|\t\t\treturn armShapeUnknown, \"\", false\n326|\t\t}\n327|\t\trender := expr[separator+1:]\n328|\t\tif strings.HasPrefix(render, \"context+\") {\n329|\t\t\tinner := quotedInner(render)\n330|\t\t\tif inner == \"\" {\n331|\t\t\t\treturn armShapeUnknown, \"\", false\n332|\t\t\t}\n333|\t\t\tif strings.Contains(render, \"fault.detail\") {\n334|\t\t\t\treturn armShapeContextFault, inner, true\n335|\t\t\t}\n336|\t\t\treturn armShapeContext, inner, true\n337|\t\t}\n338|\t\tif strings.Contains(render, \"fault.detail\") {\n339|\t\t\tprefix := quotedInner(render)\n340|\t\t\tif prefix == \"\" {\n341|\t\t\t\treturn armShapeUnknown, \"\", false\n342|\t\t\t}\n343|\t\t\treturn armShapeConduit, prefix, true\n344|\t\t}\n345|\t\treturn armShapeUnknown, \"\", false\n346|\t}\n347|\treturn armShapeLiteral, payload, true\n348|}\n349|\n350|// armExpectedTexts renders every full expected text one derived\n351|// arm can report: the derived wire code, the derived constructor\n352|// wrapper, and the arm's own derived text. A fault conduit needs\n353|// one of the derived frame details alongside its prefix before it\n354|// matches, so a literal message that merely shares the entry\n355|// prefix never resolves to the conduit. Context arms render both\n356|// production instantiations;\n357|// TestReachabilityContextsAreClosed pins those two as the only\n358|// ones. Frame faults carry no envelope: they match on detail\n359|// alone and pin their carrier through the row's also key.\n360|func armExpectedTexts(key string, envelopes map[string]ctorEnvelope, frameDetails []string) []string {\n361|\tshape, text, ok := classifyArmKey(key)\n362|\tif !ok {\n363|\t\treturn nil\n364|\t}\n365|\tif shape == armShapeFrame {\n366|\t\treturn []string{text}\n367|\t}\n368|\trest, ok := strings.CutPrefix(key, \"ctor|\")\n369|\tif !ok {\n370|\t\treturn nil\n371|\t}\n372|\tseparator := strings.Index(rest, \"|\")\n373|\tif separator < 0 {\n374|\t\treturn nil\n375|\t}\n376|\tenvelope, ok := envelopes[rest[:separator]]\n377|\tif !ok {\n378|\t\treturn nil\n379|\t}\n380|\tprefix := envelope.code + \": \" + envelope.wrapper\n381|\tswitch shape {\n382|\tcase armShapeLiteral:\n383|\t\treturn []string{prefix + text}\n384|\tcase armShapeConduit:\n385|\t\tvar texts []string\n386|\t\tfor _, detail := range frameDetails {\n387|\t\t\ttexts = append(texts, prefix+text+detail)\n388|\t\t}\n389|\t\treturn texts\n390|\tcase armShapeContext:\n391|\t\treturn []string{prefix + \"success\" + text, prefix + \"failure\" + text}\n392|\tcase armShapeContextFault:\n393|\t\tvar texts []string\n394|\t\tfor _, context := range []string{\"success\", \"failure\"} {\n395|\t\t\tfor _, detail := range frameDetails {\n396|\t\t\t\ttexts = append(texts, prefix+context+text+detail)\n397|\t\t\t}\n398|\t\t}\n399|\t\treturn texts\n400|\t}\n401|\treturn nil\n402|}\n403|\n404|// frameDetailTexts collects every derived frame-fault detail: the\n405|// fault vocabulary the conduit matchers close over.\n406|func frameDetailTexts(derived armDerivation) []string {\n407|\tvar details []string\n408|\tfor key := range derived.arms {\n409|\t\tif rest, ok := strings.CutPrefix(key, \"frame|\"); ok && rest != \"\" {\n410|\t\t\tdetails = append(details, rest)\n411|\t\t}\n412|\t}\n413|\tsort.Strings(details)\n414|\treturn details\n415|}\n416|\n417|// armKeyMatches reports whether the refusal message carries any of\n418|// the arm's derived expected texts.\n419|func armKeyMatches(key string, envelopes map[string]ctorEnvelope, frameDetails []string, message string) bool {\n420|\tfor _, expected := range armExpectedTexts(key, envelopes, frameDetails) {\n421|\t\tif strings.Contains(message, expected) {\n422|\t\t\treturn true\n423|\t\t}\n424|\t}\n425|\treturn false\n426|}\n427|\n428|// reachedArm computes which derived arm a refusal message\n429|// reaches and whether that outcome is determined:\n430|//\n431|//   - a literal arm is reached only when exactly it matches among\n432|//     all literal keys: a vector sliding to a sibling arm, or to\n433|//     the strict conduit, names a key outside the match and fails;\n434|//   - a conduit or context arm is reached when it matches, no\n435|//     literal matches, and anything else matching is at most one\n436|//     frame fault travelling the same conduit;\n437|//   - a frame fault is reached when its detail matches, no literal\n438|//     matches, and the carrier conduit named by the row's also key\n439|//     matches alongside it.\n440|//\n441|// Anything else — no match, an ambiguous match, or a match the\n442|// shapes above do not account for — returns ok=false, and the row\n443|// fails instead of passing.\n444|func reachedArm(named string, matches map[string]bool, also string, envelopes map[string]ctorEnvelope, frameDetails []string, message string) (string, bool) {\n445|\tshape, _, ok := classifyArmKey(named)\n446|\tif !ok {\n447|\t\treturn \"\", false\n448|\t}\n449|\tswitch shape {\n450|\tcase armShapeLiteral:\n451|\t\tliterals := 0\n452|\t\tfor key := range matches {\n453|\t\t\tkeyShape, _, ok := classifyArmKey(key)\n454|\t\t\tif !ok {\n455|\t\t\t\treturn \"\", false\n456|\t\t\t}\n457|\t\t\tif keyShape == armShapeLiteral {\n458|\t\t\t\tliterals++\n459|\t\t\t}\n460|\t\t}\n461|\t\tif literals == 1 && matches[named] {\n462|\t\t\treturn named, true\n463|\t\t}\n464|\t\tfor key := range matches {\n465|\t\t\tkeyShape, _, ok := classifyArmKey(key)\n466|\t\t\tif ok && keyShape == armShapeLiteral {\n467|\t\t\t\treturn key, false\n468|\t\t\t}\n469|\t\t}\n470|\t\treturn \"\", false\n471|\tcase armShapeFrame:\n472|\t\tif also == \"\" || !matches[also] {\n473|\t\t\treturn \"\", false\n474|\t\t}\n475|\t\tfor key := range matches {\n476|\t\t\tkeyShape, _, ok := classifyArmKey(key)\n477|\t\t\tif !ok {\n478|\t\t\t\treturn \"\", false\n479|\t\t\t}\n480|\t\t\tif keyShape == armShapeLiteral {\n481|\t\t\t\treturn key, false\n482|\t\t\t}\n483|\t\t\tif key != named && key != also {\n484|\t\t\t\treturn key, false\n485|\t\t\t}\n486|\t\t}\n487|\t\tif matches[named] {\n488|\t\t\treturn named, true\n489|\t\t}\n490|\t\treturn \"\", false\n491|\tdefault:\n492|\t\tif !matches[named] {\n493|\t\t\tfor key := range matches {\n494|\t\t\t\tkeyShape, _, ok := classifyArmKey(key)\n495|\t\t\t\tif ok && (keyShape == armShapeLiteral || keyShape == armShapeFrame) {\n496|\t\t\t\t\treturn key, false\n497|\t\t\t\t}\n498|\t\t\t}\n499|\t\t\treturn \"\", false\n500|\t\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c575","stream":{"kind":"session","id":"01a07721-ca06-7081-babf-b563190d8d78"},"sequence":277,"recorded_at":1780531400000549,"record_type":"event","durability":"durable","causation_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","run_stream":{"kind":"run","id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd"},"call_id":"call_01a077222a2a7032bd74c2a49d2cba9c","text":"{\n  \"chunk_id\": \"exec-4-1\",\n  \"command\": \"ls internal/secprim/*.go | head -n 30; echo \\\"===\\\"; cat internal/secprim/doc.go; echo \\\"===\\\"; grep -rn \\\"Emit\\\\|Progress\\\\|Prompt\\\" internal/cliresult/*.go | head -n 40\",\n  \"description\": \"Inspect cliresult wiring and doc\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"internal/secprim/argv_test.go\\ninternal/secprim/argv.go\\ninternal/secprim/census_test.go\\ninternal/secprim/classes_test.go\\ninternal/secprim/doc.go\\ninternal/secprim/env_test.go\\ninternal/secprim/env.go\\ninternal/secprim/errors.go\\ninternal/secprim/fifo_unix_test.go\\ninternal/secprim/inventory_test.go\\ninternal/secprim/nofollow.go\\ninternal/secprim/open_nofollow_unix.go\\ninternal/secprim/open_nofollow_windows.go\\ninternal/secprim/path_test.go\\ninternal/secprim/path.go\\ninternal/secprim/priv_windows_test.go\\ninternal/secprim/redact_test.go\\ninternal/secprim/redact.go\\ninternal/secprim/render_test.go\\ninternal/secprim/render.go\\n===\\n// Package secprim implements the AX shared safe process and filesystem\\n// primitives of pinned specification Sections 16.3, 16.4, and 16.7: no-follow\\n// path handling, staging containment, structured argv, environment\\n// allowlists, terminal control-string escaping, and secret redaction for\\n// free-text streams.\\n//\\n// The package is a library behind production launch and rendering paths,\\n// not a second authority beside them:\\n//\\n//   - path grammars stay in internal/scalar: CheckMemberPath admits exactly\\n//     the scalar relative-path grammar plus the Windows alternate-stream,\\n//     trailing-dot/space, and reserved-device rules Section 16.3 names, and\\n//     delegates every shared rule to scalar rather than retyping it;\\n//   - byte-counted exec rules (Provider SpawnPlan argv and env literals,\\n//     Section 5.1) stay in internal/provhost: that package validates the\\n//     wire plan, while this package builds the launch environment and\\n//     validates the argv vector at process start;\\n//   - environment-name grammar is owned here and internal/provhost delegates\\n//     to it, so the two packages cannot drift on what a name is;\\n//   - Structured Error detail redaction stays in internal/axerror: that\\n//     package refuses exact credential keys and causal leaks on the error\\n//     wire, while this package scrubs free-text streams (stderr, logs,\\n//     terminal rendering) where no key gate can see;\\n//   - SSH argv admission stays in internal/config and the provider entry\\n//     point rule (`ax pane SESSION_ID`) stays in internal/terminalbackend:\\n//     both are closed vocabularies over their own domain, not instances of\\n//     the generic argv rule here;\\n//   - the five-variable AX_* path registry stays in internal/config and\\n//     internal/localstore, which already implement AC-PATH-001.\\n//\\n// Trust for external executables is deliberately not implemented here.\\n// internal/provider.trustCandidate and internal/terminalbackend.DigestFile\\n// already establish trust with different fact sets because their\\n// specifications differ: Section 7.1 requires the approving owner identity\\n// beside the canonical path and digest for provider plugins, while the\\n// Section 4.B trust tuple carries platform, adapter identity, manifest and\\n// probe digests with no owner fact. A third path here would be another\\n// copy, not convergence; the difference is contractual, not accidental.\\n//\\n// Every refusal is a plain *Error naming the kind, rule, and member:\\n// facades keep their own refusal dialects, so this package names rules\\n// instead of minting codes, following internal/environ.\\n//\\n// Stated bounds. This package mutates no durable state and keeps no cache:\\n// Guard resolution is lexical, OpenNoFollowFile opens read-only, and every\\n// other entry point is a pure function of its input. Crash and idempotency\\n// handling therefore have no surface here: there is no journal to recover\\n// and no second actor to collide with. Tombstone deletion scope (Section\\n// 16.3 \\\"broad deletion from tombstones\\\") has no implementation in this\\n// repository yet and is not modeled. The operator default for which\\n// environment names a provider plugin inherits is product policy with no\\n// in-repo provider implementation to derive needs from, so BuildEnv takes\\n// the allowlist explicitly and ExecRunner inherits the parent environment\\n// until the operator supplies one. Grapheme-width policing stops at the\\n// enumerated invisible controls: full East-Asian/emoji width measurement\\n// needs terminal width tables this package does not carry. Content-level\\n// secret scrubbing is best-effort by specification (Section 16.2 claims no\\n// reliable scrubbing), and Redact states exactly the three shapes it\\n// decides.\\npackage secprim\\n===\\ninternal/cliresult/bodies_test.go:512:// TestLogsBodyBindsEveryEventToItsEmitter narrows the Section 14.1 sentence\\ninternal/cliresult/bodies_test.go:515:func TestLogsBodyBindsEveryEventToItsEmitter(t *testing.T) {\\ninternal/cliresult/client_test.go:15:// mustEmittedFailure renders one failure through the production emitter in JSON\\ninternal/cliresult/client_test.go:18:// test are the bytes Emit wrote, not a literal a test composed.\\ninternal/cliresult/client_test.go:19:func mustEmittedFailure(t *testing.T, code axerror.Code) (InvocationOutput, string) {\\ninternal/cliresult/client_test.go:22:\\temitter := mustEmitter(t, ModeJSON, true, streams.streams(true))\\ninternal/cliresult/client_test.go:26:\\tif _, err := emitter.Progress(\\\"transferring 3 of 9\\\"); err != nil {\\ninternal/cliresult/client_test.go:27:\\t\\tt.Fatalf(\\\"Progress: %v\\\", err)\\ninternal/cliresult/client_test.go:29:\\tstatus, err := emitter.Emit(Outcome{Failure: mustFailure(t, code)})\\ninternal/cliresult/client_test.go:31:\\t\\tt.Fatalf(\\\"Emit: %v\\\", err)\\ninternal/cliresult/client_test.go:36:func mustEmittedSuccess(t *testing.T, command Command) InvocationOutput {\\ninternal/cliresult/client_test.go:39:\\temitter := mustEmitter(t, ModeJSON, true, streams.streams(false))\\ninternal/cliresult/client_test.go:40:\\tstatus, err := emitter.Emit(Outcome{Result: mustResult(t, validSpec(t, command))})\\ninternal/cliresult/client_test.go:42:\\t\\tt.Fatalf(\\\"Emit: %v\\\", err)\\ninternal/cliresult/client_test.go:61:\\t\\tdocuments[command] = mustEmittedSuccess(t, command)\\ninternal/cliresult/client_test.go:104:\\toutput, stderr := mustEmittedFailure(t, \\\"workspace_conflict\\\")\\ninternal/cliresult/client_test.go:140:\\t// The mutant: stdout and stderr are swapped, so Emit's one JSON document\\ninternal/cliresult/client_test.go:143:\\temitter := mustEmitter(t, ModeJSON, true, misrouted)\\ninternal/cliresult/client_test.go:144:\\tstatus, err := emitter.Emit(Outcome{Failure: mustFailure(t, \\\"workspace_conflict\\\")})\\ninternal/cliresult/client_test.go:146:\\t\\tt.Fatalf(\\\"Emit: %v\\\", err)\\ninternal/cliresult/client_test.go:167:\\tvalid, _ := mustEmittedFailure(t, \\\"workspace_conflict\\\")\\ninternal/cliresult/client_test.go:378:\\tfailure, _ := mustEmittedFailure(t, \\\"workspace_conflict\\\")\\ninternal/cliresult/client_test.go:379:\\tsuccess := mustEmittedSuccess(t, CommandList)\\ninternal/cliresult/client_test.go:560:\\tconforming := mustEmittedSuccess(t, CommandList)\\ninternal/cliresult/client_test.go:652:\\tlegacy, _ := mustEmittedFailure(t, \\\"not_found\\\")\\ninternal/cliresult/client_test.go:675:\\tlegacy, _ := mustEmittedFailure(t, \\\"not_found\\\")\\ninternal/cliresult/client_test.go:686:\\tsuccess := mustEmittedSuccess(t, CommandList)\\ninternal/cliresult/client_test.go:789:\\tlegacy, _ := mustEmittedFailure(t, \\\"not_found\\\")\\ninternal/cliresult/client_test.go:830:\\toriginal, _ := mustEmittedFailure(t, \\\"workspace_conflict\\\")\\ninternal/cliresult/client_test.go:900:\\tfailure, _ := mustEmittedFailure(t, \\\"not_found\\\")\\ninternal/cliresult/client_test.go:964:\\treading, err := Read(CommandList, mustEmittedSuccess(t, CommandList))\\ninternal/cliresult/client_test.go:1035:\\tsuccess := mustEmittedSuccess(t, CommandList)\\ninternal/cliresult/client_test.go:1223:\\tlegacy, _ := mustEmittedFailure(t, \\\"not_found\\\")\\ninternal/cliresult/cliresult_test.go:174:// TestUnimplementedSurfacesAreRefusedRatherThanEmitted proves that a registered\\ninternal/cliresult/cliresult_test.go:178:func TestUnimplementedSurfacesAreRefusedRatherThanEmitted(t *testing.T) {\\ninternal/cliresult/confirmation_test.go:33:// TestInteractiveDestructiveOperationMustPrompt narrows the Section 14.2\\ninternal/cliresult/confirmation_test.go:36:func TestInteractiveDestructiveOperationMustPrompt(t *testing.T) {\\ninternal/cliresult/confirmation_test.go:48:\\tif !confirmation.PromptRequired {\\ninternal/cliresult/confirmation_test.go:60:\\tif refusal != nil || !confirmation.PromptRequired {\\ninternal/cliresult/confirmation_test.go:90:\\tif confirmation.PromptRequired {\\n\",\n  \"original_output_bytes\": 8258,\n  \"original_output_tokens\": 2065,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
