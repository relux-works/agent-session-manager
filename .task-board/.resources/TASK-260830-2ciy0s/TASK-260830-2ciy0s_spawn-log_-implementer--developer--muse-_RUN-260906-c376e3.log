{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6a1","stream":{"kind":"session","id":"01a07721-ca06-7081-babf-b563190d8d78"},"sequence":427,"recorded_at":1780531400000849,"record_type":"event","durability":"durable","causation_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","run_stream":{"kind":"run","id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd"},"call_id":"call_01a077228dda7503ae9e4c2ccab5cf32","text":"Read text file `internal/cliresult/render_wiring_test.go`.\n1|package cliresult\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|)\n7|\n8|// hostileTerminalLine carries one member of every class Section 16.7\n9|// names: an ANSI color sequence, an OSC hyperlink, a C0 control, DEL, a\n10|// bidi override, a zero-width joiner, a secret-shaped assignment, and a\n11|// private-key block opener.\n12|const hostileTerminalLine = \"provider pi says \\x1b[31mred\\x1b[0m and \\x1b]8;;https://evil\\x07link\" +\n13|\t\" with bell\\x07 del\\x7f bidi\\u202e join\\u200d password=hunter2-hunter key -----BEGIN EC PRIVATE KEY-----\"\n14|\n15|// TestTextEmissionNeutralizesHostileContent drives hostile provider-derived\n16|// text through the production text paths (Log, Prompt, and failure Emit)\n17|// and requires inert output: no ESC byte, no C0 byte except newline, no\n18|// DEL, valid UTF-8, the secret masked, and the key block redacted.\n19|func TestTextEmissionNeutralizesHostileContent(t *testing.T) {\n20|\tt.Parallel()\n21|\tvar sink capture\n22|\temitter := mustEmitter(t, ModeText, false, Streams{Stdout: &sink.stdout, Stderr: &sink.stderr})\n23|\tif err := emitter.Log(hostileTerminalLine); err != nil {\n24|\t\tt.Fatal(err)\n25|\t}\n26|\tassertInertTerminal(t, sink.stderr.String(), \"Log\")\n27|\tsink.stderr.Reset()\n28|\n29|\tif err := emitter.Prompt(hostileTerminalLine); err != nil {\n30|\t\tt.Fatal(err)\n31|\t}\n32|\tassertInertTerminal(t, sink.stderr.String(), \"Prompt\")\n33|\tsink.stderr.Reset()\n34|\n35|\tfailure := mustFailure(t, \"workspace_conflict\")\n36|\temitter = mustEmitter(t, ModeText, false, Streams{Stdout: &sink.stdout, Stderr: &sink.stderr})\n37|\tif _, err := emitter.Emit(Outcome{Failure: failure, Rendered: hostileTerminalLine}); err != nil {\n38|\t\tt.Fatal(err)\n39|\t}\n40|\tassertInertTerminal(t, sink.stderr.String(), \"Emit\")\n41|\tif sink.stdout.Len() != 0 {\n42|\t\tt.Fatalf(\"failure rendering reached stdout: %q\", sink.stdout.String())\n43|\t}\n44|}\n45|\n46|func assertInertTerminal(t *testing.T, output, path string) {\n47|\tt.Helper()\n48|\tif !strings.HasSuffix(output, \"\\n\") {\n49|\t\tt.Fatalf(\"%s output %q is not newline-terminated\", path, output)\n50|\t}\n51|\tfor _, character := range output {\n52|\t\tswitch {\n53|\t\tcase character == '\\n' || character == '\\t':\n54|\t\tcase character < 0x20 || character == 0x7f || character == 0x1b:\n55|\t\t\tt.Fatalf(\"%s output carries raw control %U in %q\", path, character, output)\n56|\t\t}\n57|\t}\n58|\tif strings.Contains(output, \"hunter2-hunter\") {\n59|\t\tt.Fatalf(\"%s output carries the secret value: %q\", path, output)\n60|\t}\n61|\tif strings.Contains(output, \"PRIVATE KEY-----\") {\n62|\t\tt.Fatalf(\"%s output carries the key block: %q\", path, output)\n63|\t}\n64|\tif !strings.Contains(output, \"[redacted]\") {\n65|\t\tt.Fatalf(\"%s output masked nothing: %q\", path, output)\n66|\t}\n67|}\n68|\n69|// TestJSONModeEmissionStaysByteExact proves the escaping wire stops at\n70|// text mode: JSON stdout carries the exact MarshalJSON document with no\n71|// terminal neutralization applied, because machine output must stay\n72|// byte-exact.\n73|func TestJSONModeEmissionStaysByteExact(t *testing.T) {\n74|\tt.Parallel()\n75|\tvar sink capture\n76|\temitter := mustEmitter(t, ModeJSON, true, Streams{Stdout: &sink.stdout, Stderr: &sink.stderr})\n77|\tfailure := mustFailure(t, \"workspace_conflict\")\n78|\tif _, err := emitter.Emit(Outcome{Failure: failure}); err != nil {\n79|\t\tt.Fatal(err)\n80|\t}\n81|\tdocument, err := failure.MarshalJSON()\n82|\tif err != nil {\n83|\t\tt.Fatal(err)\n84|\t}\n85|\tif sink.stdout.String() != string(document)+\"\\n\" {\n86|\t\tt.Fatalf(\"JSON stdout = %q, want the exact document\", sink.stdout.String())\n87|\t}\n88|}\n89|\n90|// TestBenignTextPassesThroughUnchanged proves the neutralization is\n91|// narrow: ordinary operator text with newlines and tabs reaches the\n92|// stream byte-identical.\n93|func TestBenignTextPassesThroughUnchanged(t *testing.T) {\n94|\tt.Parallel()\n95|\tvar sink capture\n96|\temitter := mustEmitter(t, ModeText, false, Streams{Stdout: &sink.stdout, Stderr: &sink.stderr})\n97|\tline := \"sync converged\\t3 sessions\\nall replicas fresh\"\n98|\tif err := emitter.Log(line); err != nil {\n99|\t\tt.Fatal(err)\n100|\t}\n101|\tif sink.stderr.String() != line+\"\\n\" {\n102|\t\tt.Fatalf(\"Log(%q) = %q, want byte-identical\", line, sink.stderr.String())\n103|\t}\n104|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6a3","stream":{"kind":"session","id":"01a07721-ca06-7081-babf-b563190d8d78"},"sequence":428,"recorded_at":1780531400000851,"record_type":"event","durability":"durable","causation_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","run_stream":{"kind":"run","id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd"},"call_id":"call_01a077228e697c02a55160b6d3d43e7c","text":"Read text file `internal/provhost/runner_env_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"fmt\"\n7|\t\"os\"\n8|\t\"reflect\"\n9|\t\"sort\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n14|)\n15|\n16|// runExecRunnerHelper runs inside the re-execed child (selected by the\n17|// TestMain gate on the marker): it prints the observed environment as one\n18|// marked JSON line and exits without running any test. It never returns.\n19|func runExecRunnerHelper() {\n20|\tenvironment := os.Environ()\n21|\tsort.Strings(environment)\n22|\tdocument, err := json.Marshal(environment)\n23|\tif err != nil {\n24|\t\tfmt.Fprintln(os.Stderr, err.Error())\n25|\t\tos.Exit(2)\n26|\t}\n27|\tfmt.Println(\"SECPROBE-ENV:\" + string(document))\n28|\tos.Exit(0)\n29|}\n30|\n31|// childEnviron starts the test binary as a child through the production\n32|// ExecRunner and returns the environment the child observed. The child\n33|// is the test binary itself restricted to the helper test; its marked\n34|// line is scanned out of stdout because the test framework appends its\n35|// own trailers after the test prints.\n36|func childEnviron(t *testing.T, runner ExecRunner) []string {\n37|\tt.Helper()\n38|\tresult, err := runnerWithHelper(t, runner)\n39|\tif err != nil {\n40|\t\tt.Fatalf(\"helper run: %v\", err)\n41|\t}\n42|\tif result.ExitCode != 0 {\n43|\t\tt.Fatalf(\"helper exit = %d, stderr = %q\", result.ExitCode, result.Stderr)\n44|\t}\n45|\tfor _, line := range strings.Split(string(result.Stdout), \"\\n\") {\n46|\t\tdocument, found := strings.CutPrefix(line, \"SECPROBE-ENV:\")\n47|\t\tif !found {\n48|\t\t\tcontinue\n49|\t\t}\n50|\t\tvar environment []string\n51|\t\tif err := json.Unmarshal([]byte(document), &environment); err != nil {\n52|\t\t\tt.Fatalf(\"helper line %q is not a JSON environment: %v\", line, err)\n53|\t\t}\n54|\t\treturn environment\n55|\t}\n56|\tt.Fatalf(\"helper printed no marked environment line: %q\", result.Stdout)\n57|\treturn nil\n58|}\n59|\n60|// runnerWithHelper re-execs the test binary through the production\n61|// runner. The TestMain gate selects the helper by the marker carried in\n62|// the environment itself, because the provider protocol starts plugins\n63|// with no arguments and there is no argv channel for a test flag.\n64|func runnerWithHelper(t *testing.T, runner ExecRunner) (Result, error) {\n65|\tt.Helper()\n66|\tself, err := os.Executable()\n67|\tif err != nil {\n68|\t\tt.Fatal(err)\n69|\t}\n70|\treturn runner.Run(context.Background(), self, []byte(`{}`))\n71|}\n72|\n73|func helperRunner(t *testing.T, env []string) ExecRunner {\n74|\tt.Helper()\n75|\tt.Setenv(\"SECPROBE_HELPER_PROCESS\", \"1\")\n76|\treturn ExecRunner{Env: env}\n77|}\n78|\n79|// TestExecRunnerDeliversExactlyTheBuiltEnv proves the allowlist path end\n80|// to end: the operator builds an environment with secprim.BuildEnv, hands\n81|// it to ExecRunner, and the child observes exactly that — including the\n82|// absence of a parent-only marker, which proves no inheritance leak.\n83|func TestExecRunnerDeliversExactlyTheBuiltEnv(t *testing.T) {\n84|\tt.Setenv(\"SECPROBE_PARENT_ONLY\", \"present\")\n85|\t// The marker goes up before BuildEnv reads the parent: the built\n86|\t// allowlist must carry it, or the child runs the suite instead of\n87|\t// the helper.\n88|\trunner := helperRunner(t, nil)\n89|\tbuilt, err := secprim.BuildEnv(\n90|\t\t[]string{\"SECPROBE_HELPER_PROCESS\", \"PATH\"},\n91|\t\tmap[string]string{\"SECPROBE_LITERAL\": \"staged\"},\n92|\t\tos.LookupEnv,\n93|\t)\n94|\tif err != nil {\n95|\t\tt.Fatalf(\"BuildEnv: %v\", err)\n96|\t}\n97|\trunner.Env = built\n98|\tobserved := childEnviron(t, runner)\n99|\tif !reflect.DeepEqual(observed, built) {\n100|\t\tt.Fatalf(\"child observed %q, want exactly the built %q\", observed, built)\n101|\t}\n102|\tfor _, entry := range observed {\n103|\t\tif entry == \"SECPROBE_PARENT_ONLY=present\" {\n104|\t\t\tt.Fatal(\"parent-only variable leaked into the allowlisted child\")\n105|\t\t}\n106|\t}\n107|}\n108|\n109|// TestExecRunnerNilEnvInherits documents the unset policy: a nil Env\n110|// keeps the historical inherit-everything behavior until the operator\n111|// supplies an allowlist. The child must observe the parent-only marker,\n112|// proving inheritance is intact rather than silently emptied.\n113|func TestExecRunnerNilEnvInherits(t *testing.T) {\n114|\tt.Setenv(\"SECPROBE_PARENT_ONLY\", \"present\")\n115|\tobserved := childEnviron(t, helperRunner(t, nil))\n116|\t// The helper marker itself proves the child ran; leak the marker\n117|\t// check through membership rather than equality because the suite\n118|\t// environment is not fixed.\n119|\tfound := false\n120|\tfor _, entry := range observed {\n121|\t\tif entry == \"SECPROBE_PARENT_ONLY=present\" {\n122|\t\t\tfound = true\n123|\t\t}\n124|\t}\n125|\tif !found {\n126|\t\tt.Fatal(\"nil Env did not inherit the parent environment\")\n127|\t}\n128|}\n129|\n130|// TestExecRunnerRefusesUnusableExecutable proves the argv gate at process\n131|// start: an empty or NUL-carrying executable is refused with the stable\n132|// argv refusal instead of a raw exec error.\n133|func TestExecRunnerRefusesUnusableExecutable(t *testing.T) {\n134|\tfor _, executable := range []string{\"\", \"bad\\x00bin\"} {\n135|\t\t_, err := ExecRunner{}.Run(context.Background(), executable, []byte(`{}`))\n136|\t\tif err == nil {\n137|\t\t\tt.Fatalf(\"Run(%q) started a process\", executable)\n138|\t\t}\n139|\t\tif failure, ok := err.(*secprim.Error); !ok {\n140|\t\t\tt.Fatalf(\"Run(%q) = %T %v, want *secprim.Error\", executable, err, err)\n141|\t\t} else if failure.Kind != secprim.ErrUnsafeArgv {\n142|\t\t\tt.Fatalf(\"Run(%q) kind = %v, want ErrUnsafeArgv\", executable, failure.Kind)\n143|\t\t}\n144|\t}\n145|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6a5","stream":{"kind":"session","id":"01a07721-ca06-7081-babf-b563190d8d78"},"sequence":429,"recorded_at":1780531400000853,"record_type":"event","durability":"durable","causation_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","run_stream":{"kind":"run","id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd"},"call_id":"call_01a077228efb7052951c9cb13c38f0e6","text":"Read text file `internal/provhost/env_agreement_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n8|)\n9|\n10|// TestEnvNameAgreementIsBidirectional pins the shared environment-name\n11|// grammar from both directions: validEnvName (the Section 5.1 SpawnPlan\n12|// call sites) must equal secprim.IsEnvName (the launch-allowlist owner)\n13|// on every swept name. A one-directional test — mine refuses what theirs\n14|// refuses — cannot see an over-permissive divergence, so this test\n15|// asserts equality, not implication, over an exhaustive small alphabet\n16|// plus length boundaries and hostile shapes.\n17|func TestEnvNameAgreementIsBidirectional(t *testing.T) {\n18|\tt.Parallel()\n19|\talphabet := []byte{'a', 'Z', '0', '_', '-', '.', ' ', '=', 0xe9}\n20|\tvar names []string\n21|\tnames = append(names, \"\")\n22|\tvar build func(prefix []byte, depth int)\n23|\tbuild = func(prefix []byte, depth int) {\n24|\t\tif depth == 3 {\n25|\t\t\treturn\n26|\t\t}\n27|\t\tfor _, letter := range alphabet {\n28|\t\t\tnext := append(append([]byte(nil), prefix...), letter)\n29|\t\t\tnames = append(names, string(next))\n30|\t\t\tbuild(next, depth+1)\n31|\t\t}\n32|\t}\n33|\tbuild(nil, 0)\n34|\tnames = append(names,\n35|\t\tstrings.Repeat(\"x\", 127),\n36|\t\tstrings.Repeat(\"x\", 128),\n37|\t\tstrings.Repeat(\"x\", 129),\n38|\t\t\"_\"+strings.Repeat(\"y\", 127),\n39|\t\t\"9\"+strings.Repeat(\"y\", 127),\n40|\t\t\"A\\nB\", \"A\\x00B\", \"AX_CONFIG\", \"PATH\", \"a-b\", \"a.b\", \"a=b\",\n41|\t)\n42|\tmismatches := 0\n43|\tfor _, name := range names {\n44|\t\tif validEnvName(name) != secprim.IsEnvName(name) {\n45|\t\t\tmismatches++\n46|\t\t\tt.Errorf(\"validEnvName(%q) != secprim.IsEnvName: the grammar drifted\", name)\n47|\t\t}\n48|\t}\n49|\tif mismatches != 0 {\n50|\t\tt.Fatalf(\"%d grammar mismatches; the shared name rule drifted\", mismatches)\n51|\t}\n52|\tt.Logf(\"agreement holds over %d swept names\", len(names))\n53|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6a7","stream":{"kind":"session","id":"01a07721-ca06-7081-babf-b563190d8d78"},"sequence":430,"recorded_at":1780531400000855,"record_type":"event","durability":"durable","causation_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","run_stream":{"kind":"run","id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd"},"call_id":"call_01a077228fa87f13bb79d73cfb7b2b1f","text":"Read text file `internal/provhost/runner.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"context\"\n6|\t\"io\"\n7|\t\"os\"\n8|\t\"os/exec\"\n9|\t\"time\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n12|)\n13|\n14|// waitDrainDelay bounds how long Wait lingers for pipe EOF after the\n15|// deadline kill before giving up on detached grandchildren.\n16|const waitDrainDelay = 2 * time.Second\n17|\n18|// stdoutCap bounds captured plugin stdout: one maximal frame, its line\n19|// terminator, and one probe byte, so a maximal frame followed by any\n20|// trailing byte is still distinguishable from a clean end. Anything\n21|// beyond is cut; the splitFrame length checks stay exact on the capped\n22|// capture.\n23|const stdoutCap = MaxFrameBytes + 2\n24|\n25|// Result is what a plugin process produced: captured stdout and stderr\n26|// and the process exit code. Stdout and stderr are kept separate end to\n27|// end: diagnostics never enter frame parsing, and frame bytes never\n28|// enter diagnostics. Captures are capped (stdout at one frame plus a\n29|// probe byte, stderr at StderrCapBytes); beyond the cap the stream is cut\n30|// and the failure is decided from what was captured, which the length\n31|// checks keep exact.\n32|type Result struct {\n33|\tStdout   []byte\n34|\tStderr   []byte\n35|\tExitCode int\n36|}\n37|\n38|// Runner starts one plugin process for one operation frame. Production\n39|// code supplies ExecRunner; tests supply a scripted fake. A Runner moves\n40|// bytes and reports process fate; it never parses frames and never\n41|// decides failures.\n42|type Runner interface {\n43|\tRun(ctx context.Context, executable string, stdin []byte) (Result, error)\n44|}\n45|\n46|// ExecRunner is the production Runner: it starts the trusted executable\n47|// discovered by internal/provider, writes exactly one frame to its stdin,\n48|// closes stdin, and waits under the caller's context. Environment and\n49|// stderr content never enter failure human text: Result carries the raw\n50|// streams, and failures built from a Result carry the failure class and\n51|// member names only, never content.\n52|//\n53|// Env optionally replaces the child environment wholesale: when nil the\n54|// child inherits the parent environment (the historical behavior, kept\n55|// until the operator policy names an allowlist); when non-nil the child\n56|// observes exactly Env, which the operator builds with\n57|// secprim.BuildEnv. There is no merge: a partial override that silently\n58|// kept the rest of the parent environment would not be an allowlist.\n59|type ExecRunner struct {\n60|\tEnv []string\n61|}\n62|\n63|// Run starts executable with stdin on its stdin and captures both streams\n64|// with caps. A nil error with a nonzero exit code is an ordinary result:\n65|// a syntactically valid frame governs regardless of the exit status,\n66|// because SHOULD exit 0 is not MUST. A non-nil error means no result\n67|// could be judged: start failure, stream failure, context end, or a\n68|// wait failure with empty stdout and no known exit code. In\n69|// particular, a stdin write failure racing the plugin's exit never\n70|// discards a judgeable result on its own.\n71|func (runner ExecRunner) Run(ctx context.Context, executable string, stdin []byte) (Result, error) {\n72|\tif err := secprim.CheckArgv([]string{executable}); err != nil {\n73|\t\treturn Result{}, err\n74|\t}\n75|\tcommand := newCommandContext(ctx, executable)\n76|\tcommand.WaitDelay = waitDrainDelay\n77|\tif runner.Env != nil {\n78|\t\tcommand.Env = runner.Env\n79|\t}\n80|\tstdinPipe, err := command.StdinPipe()\n81|\tif err != nil {\n82|\t\treturn Result{}, err\n83|\t}\n84|\t// Stdout and stderr travel over pipes owned here, not over\n85|\t// StdoutPipe/StderrPipe: Wait closes those read ends after seeing\n86|\t// the process exit, which races a drain still in flight and\n87|\t// surfaces as \"file already closed\" on a valid frame. A pipe\n88|\t// created here is closed only by this function, so a drain never\n89|\t// loses to the wait.\n90|\tstdoutReader, stdoutWriter, err := os.Pipe()\n91|\tif err != nil {\n92|\t\treturn Result{}, err\n93|\t}\n94|\tdefer stdoutReader.Close()\n95|\tstderrReader, stderrWriter, err := os.Pipe()\n96|\tif err != nil {\n97|\t\tstdoutReader.Close()\n98|\t\treturn Result{}, err\n99|\t}\n100|\tdefer stderrReader.Close()\n101|\tcommand.Stdout = stdoutWriter\n102|\tcommand.Stderr = stderrWriter\n103|\tif err := command.Start(); err != nil {\n104|\t\tstdoutWriter.Close()\n105|\t\tstderrWriter.Close()\n106|\t\tstdoutReader.Close()\n107|\t\tstderrReader.Close()\n108|\t\treturn Result{}, err\n109|\t}\n110|\t// The parent's copies close at once: the child holds its own, so\n111|\t// EOF still means every writer is gone while no later Close can\n112|\t// interrupt a drain.\n113|\t_ = stdoutWriter.Close()\n114|\t_ = stderrWriter.Close()\n115|\t// Drain both streams while stdin is written: a plugin that answers\n116|\t// without reading stdin would otherwise deadlock against a full\n117|\t// pipe once either direction exceeds its buffer.\n118|\tstdoutDone := make(chan streamResult, 1)\n119|\tstderrDone := make(chan streamResult, 1)\n120|\tgo func() {\n121|\t\tdata, err := readCapped(stdoutReader, stdoutCap)\n122|\t\tstdoutDone <- streamResult{data: data, err: err}\n123|\t}()\n124|\tgo func() {\n125|\t\tdata, err := readCapped(stderrReader, StderrCapBytes)\n126|\t\tstderrDone <- streamResult{data: data, err: err}\n127|\t}()\n128|\twrote, writeErr := stdinPipe.Write(stdin)\n129|\tif writeErr == nil && wrote < len(stdin) {\n130|\t\twriteErr = io.ErrShortWrite\n131|\t}\n132|\tif writeErr == nil {\n133|\t\t_, writeErr = stdinPipe.Write([]byte{'\\n'})\n134|\t}\n135|\tcloseErr := stdinPipe.Close()\n136|\t// The wait and both drains run bounded by the call context. A\n137|\t// detached descendant that escapes the deadline group kill holds\n138|\t// the pipes open, and anything here that needs pipe EOF would\n139|\t// otherwise stay open for the descendant's whole lifetime\n140|\t// instead of ending at the deadline. Closing the read ends\n141|\t// fails the blocked drains at once; each drain sends exactly\n142|\t// once over a buffered channel, so no goroutine is left behind.\n143|\twaitDone := make(chan error, 1)\n144|\tgo func() {\n145|\t\twaitDone <- command.Wait()\n146|\t}()\n147|\tvar waitErr error\n148|\tselect {\n149|\tcase waitErr = <-waitDone:\n150|\t\tif ctx.Err() != nil {\n151|\t\t\t// The wait ended by deadline or cancellation: the\n152|\t\t\t// kill was already signaled, but a detached\n153|\t\t\t// grandchild may hold the pipes open past\n154|\t\t\t// WaitDelay. Close them rather than waiting for\n155|\t\t\t// streams that can no longer decide anything:\n156|\t\t\t// with the deadline gone there is no valid\n157|\t\t\t// response to read.\n158|\t\t\tstdoutReader.Close()\n159|\t\t\tstderrReader.Close()\n160|\t\t\t<-stdoutDone\n161|\t\t\t<-stderrDone\n162|\t\t\treturn Result{}, ctx.Err()\n163|\t\t}\n164|\tcase <-ctx.Done():\n165|\t\tstdoutReader.Close()\n166|\t\tstderrReader.Close()\n167|\t\t<-stdoutDone\n168|\t\t<-stderrDone\n169|\t\tif command.Process != nil {\n170|\t\t\t// The escaper the group kill cannot reach is a\n171|\t\t\t// grandchild-or-deeper that called setsid itself\n172|\t\t\t// (see newCommandContext and the\n173|\t\t\t// detached-descendant test): the direct child is\n174|\t\t\t// a group leader, so its own setsid fails EPERM\n175|\t\t\t// and it stays in the group. Kill the direct\n176|\t\t\t// process all the same: this branch races exec's\n177|\t\t\t// group Cancel, which may not have fired yet when\n178|\t\t\t// the deadline is observed here, so the direct\n179|\t\t\t// signal guarantees the reap below cannot wait on\n180|\t\t\t// the spawned process itself. An already-reaped\n181|\t\t\t// process reports an error here that is safe to\n182|\t\t\t// ignore.\n183|\t\t\t_ = command.Process.Kill()\n184|\t\t}\n185|\t\twaitErr = <-waitDone\n186|\t\treturn Result{}, ctx.Err()\n187|\t}\n188|\tstdoutResult, stderrResult, drained := collectDrains(ctx, stdoutReader, stderrReader, stdoutDone, stderrDone)\n189|\tif !drained {\n190|\t\t// The process exited but a detached descendant still\n191|\t\t// holds a pipe open past the deadline. The frame, if\n192|\t\t// any, was never fully delivered, so the deadline\n193|\t\t// decides: report the timeout rather than holding the\n194|\t\t// call open for the descendant's lifetime.\n195|\t\treturn Result{}, ctx.Err()\n196|\t}\n197|\tif stdoutResult.err != nil {\n198|\t\treturn Result{}, stdoutResult.err\n199|\t}\n200|\tif stderrResult.err != nil {\n201|\t\treturn Result{}, stderrResult.err\n202|\t}\n203|\tstdout := stdoutResult.data\n204|\tstderr := stderrResult.data\n205|\t// A stdin write failure after the process ran is still a result when\n206|\t// the process produced one: the frame may have arrived whole while\n207|\t// the write or close raced the plugin's exit. Report write, close,\n208|\t// and wait failures only when no result can be judged — empty\n209|\t// stdout with no known exit code — otherwise the frame governs,\n210|\t// and an empty stdout with a known exit code classifies the crash\n211|\t// through the returned Result instead of masking it as a transport\n212|\t// failure. Returning writeErr before stdout is ever considered\n213|\t// discards valid correlated frames on an EPIPE race.\n214|\texitCode := -1\n215|\tif command.ProcessState != nil {\n216|\t\texitCode = command.ProcessState.ExitCode()\n217|\t}\n218|\tif exit, ok := waitErr.(*exec.ExitError); ok {\n219|\t\texitCode = exit.ExitCode()\n220|\t}\n221|\tresult := Result{Stdout: stdout, Stderr: stderr, ExitCode: exitCode}\n222|\tif len(stdout) > 0 || command.ProcessState != nil {\n223|\t\treturn result, nil\n224|\t}\n225|\tif writeErr != nil {\n226|\t\treturn Result{}, writeErr\n227|\t}\n228|\tif closeErr != nil {\n229|\t\treturn Result{}, closeErr\n230|\t}\n231|\tif waitErr != nil {\n232|\t\treturn Result{}, waitErr\n233|\t}\n234|\treturn result, nil\n235|}\n236|\n237|// streamResult is one drained stream: the captured prefix and the\n238|// drain's own error, if the read failed before EOF.\n239|type streamResult struct {\n240|\tdata []byte\n241|\terr  error\n242|}\n243|\n244|// collectDrains gathers both stream captures, bounded by the call\n245|// context. When the deadline passes while a detached descendant still\n246|// holds a pipe open, the still-blocked read ends are closed so those\n247|// drains fail at once instead of holding the call open past its\n248|// deadline, and collectDrains reports false: the frame, if any, was\n249|// never fully delivered, so the caller lets the deadline decide\n250|// rather than judging a partial capture. Each drain channel is\n251|// received exactly once per still-pending drain, matching the single\n252|// buffered send of its goroutine.\n253|func collectDrains(ctx context.Context, stdoutReader, stderrReader *os.File, stdoutDone, stderrDone <-chan streamResult) (streamResult, streamResult, bool) {\n254|\tselect {\n255|\tcase stdout := <-stdoutDone:\n256|\t\tselect {\n257|\t\tcase stderr := <-stderrDone:\n258|\t\t\treturn stdout, stderr, true\n259|\t\tcase <-ctx.Done():\n260|\t\t\tstderrReader.Close()\n261|\t\t\tstderr := <-stderrDone\n262|\t\t\treturn stdout, stderr, false\n263|\t\t}\n264|\tcase <-ctx.Done():\n265|\t\tstdoutReader.Close()\n266|\t\tstderrReader.Close()\n267|\t\tstdout := <-stdoutDone\n268|\t\tstderr := <-stderrDone\n269|\t\treturn stdout, stderr, false\n270|\t}\n271|}\n272|\n273|// readCapped drains stream up to cap bytes and cuts the rest. Memory\n274|// stays bounded no matter what the plugin emits, and the splitFrame\n275|// length checks stay exact on the capped capture.\n276|func readCapped(stream io.Reader, cap int) ([]byte, error) {\n277|\tdata, err := io.ReadAll(io.LimitReader(stream, int64(cap)+1))\n278|\tif err != nil {\n279|\t\treturn nil, err\n280|\t}\n281|\tif len(data) > cap {\n282|\t\treturn data[:cap], nil\n283|\t}\n284|\treturn data, nil\n285|}\n286|\n287|// Host invokes provider plugins: one process per operation, one frame in,\n288|// one frame out, under the request deadline. Host keeps no cross-call\n289|// state, so successive calls are separate processes observing durable\n290|// state through the authority the caller passes.\n291|type Host struct {\n292|\t// Runner starts the plugin process. It must be set; a nil Runner is\n293|\t// a caller error, refused before any frame is built.\n294|\tRunner Runner\n295|\t// Now is the clock deadlines are checked against. Nil means the\n296|\t// system clock; tests supply a fixed instant.\n297|\tNow func() time.Time\n298|}\n299|\n300|func (host Host) now() time.Time {\n301|\tif host.Now == nil {\n302|\t\treturn time.Now()\n303|\t}\n304|\treturn host.Now()\n305|}\n306|\n307|// splitFrame separates the single response line from anything following\n308|// it. oversize reports a first line beyond MaxFrameBytes; extra reports\n309|// any bytes after the first line terminator. An empty line is neither:\n310|// it is a missing response, judged with the exit code by the caller.\n311|//\n312|// The checks are length-only and exact: stdout capture holds at most\n313|// MaxFrameBytes+2 bytes, so a first line beyond the limit, or any\n314|// trailing byte, is always visible in the captured length. No separate\n315|// truncation flag participates; a narrowed or dropped disjunct here\n316|// would be equivalent, not coverage.\n317|func splitFrame(captured []byte) (line []byte, oversize bool, extra bool) {\n318|\tif index := bytes.IndexByte(captured, '\\n'); index >= 0 {\n319|\t\treturn captured[:index], len(captured[:index]) > MaxFrameBytes, index+1 < len(captured)\n320|\t}\n321|\treturn captured, len(captured) > MaxFrameBytes, false\n322|}\n323|\n324|// Call dispatches one operation: it frames the request, starts one plugin\n325|// process, enforces the request deadline, and interprets the single\n326|// response frame. Encode failures return before the Runner is touched, so\n327|// an unknown operation never starts a process. A success envelope returns\n328|// its body; a failure envelope returns the bound child error; anything\n329|// else returns a local failure that trusts nothing from the plugin.\n330|//\n331|// Deadline accounting is exact: the wait ends under a context cut at the\n332|// request deadline, and provider_timeout is reported only when that\n333|// instant actually passed. A parent cancellation first, or any other\n334|// runner failure with time remaining, is provider_process_failed. An\n335|// empty stdout with time remaining is a missing response:\n336|// provider_protocol_error on exit 0, provider_process_failed otherwise.\n337|// An empty stdout after the deadline passed is provider_timeout, and a\n338|// valid frame governs regardless of lateness or exit status.\n339|func (host Host) Call(ctx context.Context, executable string, req Request) (Response, error) {\n340|\tif host.Runner == nil {\n341|\t\tfailure, err := failInvalid(\"host has no runner\")\n342|\t\tif err != nil {\n343|\t\t\treturn Response{}, err\n344|\t\t}\n345|\t\treturn Response{}, failure\n346|\t}\n347|\tframe, deadline, err := encodeFrame(req, host.now())\n348|\tif err != nil {\n349|\t\treturn Response{}, err\n350|\t}\n351|\tdeadlineCtx, cancel := context.WithDeadline(ctx, deadline)\n352|\tdefer cancel()\n353|\tresult, err := host.Runner.Run(deadlineCtx, executable, frame)\n354|\tif err != nil {\n355|\t\tnow := host.now()\n356|\t\tif !now.Before(deadline) || deadlineCtx.Err() == context.DeadlineExceeded {\n357|\t\t\tfailure, fault := failTimeout(\"no response before the request deadline\", deadline.UnixMilli())\n358|\t\t\tif fault != nil {\n359|\t\t\t\treturn Response{}, fault\n360|\t\t\t}\n361|\t\t\treturn Response{}, failure\n362|\t\t}\n363|\t\tfailure, fault := failProcess(\"runner reported no result\", err)\n364|\t\tif fault != nil {\n365|\t\t\treturn Response{}, fault\n366|\t\t}\n367|\t\treturn Response{}, failure\n368|\t}\n369|\tline, oversize, extra := splitFrame(result.Stdout)\n370|\tif oversize {\n371|\t\tfailure, fault := failProtocol(\"frame exceeds 8 MiB\", \"\")\n372|\t\tif fault != nil {\n373|\t\t\treturn Response{}, fault\n374|\t\t}\n375|\t\treturn Response{}, failure\n376|\t}\n377|\tif extra {\n378|\t\tfailure, fault := failProtocol(\"stdout carries more than one frame\", \"\")\n379|\t\tif fault != nil {\n380|\t\t\treturn Response{}, fault\n381|\t\t}\n382|\t\treturn Response{}, failure\n383|\t}\n384|\tif len(line) == 0 {\n385|\t\t// No valid response arrived. When the request deadline passed,\n386|\t\t// this is the timeout even if the process also exited badly:\n387|\t\t// the host waited the full allowance and got nothing usable.\n388|\t\tif !host.now().Before(deadline) || deadlineCtx.Err() == context.DeadlineExceeded {\n389|\t\t\tfailure, fault := failTimeout(\"no response before the request deadline\", deadline.UnixMilli())\n390|\t\t\tif fault != nil {\n391|\t\t\t\treturn Response{}, fault\n392|\t\t\t}\n393|\t\t\treturn Response{}, failure\n394|\t\t}\n395|\t\tif result.ExitCode != 0 {\n396|\t\t\tfailure, fault := failProcess(\"plugin exited without a response\", nil)\n397|\t\t\tif fault != nil {\n398|\t\t\t\treturn Response{}, fault\n399|\t\t\t}\n400|\t\t\treturn Response{}, failure\n401|\t\t}\n402|\t\tfailure, fault := failProtocol(\"plugin exited without a response\", \"\")\n403|\t\tif fault != nil {\n404|\t\t\treturn Response{}, fault\n405|\t\t}\n406|\t\treturn Response{}, failure\n407|\t}\n408|\treturn DecodeResponse(line, req.RequestID)\n409|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
