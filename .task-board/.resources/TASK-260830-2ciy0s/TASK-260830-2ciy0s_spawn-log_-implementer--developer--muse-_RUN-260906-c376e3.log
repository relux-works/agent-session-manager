{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4cd","stream":{"kind":"session","id":"01a07721-ca06-7081-babf-b563190d8d78"},"sequence":193,"recorded_at":1780531400000381,"record_type":"event","durability":"durable","causation_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","run_stream":{"kind":"run","id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd"},"task_stream":{"kind":"task","id":"e722fbe1-ebdd-477f-8941-c52603e7b58b"},"task_id":"e722fbe1-ebdd-477f-8941-c52603e7b58b","event":{"kind":"output","task_id":"e722fbe1-ebdd-477f-8941-c52603e7b58b","chunk":"Read text file `internal/secprim/inventory_test.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"flag\"\n5|\t\"fmt\"\n6|\t\"go/ast\"\n7|\t\"go/parser\"\n8|\t\"go/token\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"runtime\"\n12|\t\"strconv\"\n13|\t\"strings\"\n14|\t\"sync\"\n15|\t\"testing\"\n16|)\n17|\n18|// exercisedRefusalSites records the production file:line that constructed a\n19|// refusal, keyed with the rule it carried, for every instrumented refusal\n20|// constructor call made during the test run.\n21|var exercisedRefusalSites sync.Map // file:line -> rule\n22|\n23|func recordRefusalSite(rule string) {\n24|\tif _, file, line, ok := runtime.Caller(2); ok {\n25|\t\texercisedRefusalSites.Store(fmt.Sprintf(\"%s:%d\", filepath.Base(file), line), rule)\n26|\t}\n27|}\n28|\n29|func TestMain(main *testing.M) {\n30|\torigPath, origArgv, origEnv := failPath, failArgv, failEnv\n31|\tfailPath = func(rule, detail string) *Error {\n32|\t\terr := origPath(rule, detail)\n33|\t\trecordRefusalSite(\"path:\" + rule)\n34|\t\treturn err\n35|\t}\n36|\tfailArgv = func(rule, detail string) *Error {\n37|\t\terr := origArgv(rule, detail)\n38|\t\trecordRefusalSite(\"argv:\" + rule)\n39|\t\treturn err\n40|\t}\n41|\tfailEnv = func(rule, detail string) *Error {\n42|\t\terr := origEnv(rule, detail)\n43|\t\trecordRefusalSite(\"env:\" + rule)\n44|\t\treturn err\n45|\t}\n46|\tcode := main.Run()\n47|\tif code == 0 && fullPackageTestRun() {\n48|\t\tif failures := auditRefusalInventory(); len(failures) != 0 {\n49|\t\t\tfor _, failure := range failures {\n50|\t\t\t\tfmt.Fprintln(os.Stderr, failure)\n51|\t\t\t}\n52|\t\t\tcode = 1\n53|\t\t}\n54|\t}\n55|\tos.Exit(code)\n56|}\n57|\n58|func fullPackageTestRun() bool {\n59|\tselected := flag.Lookup(\"test.run\")\n60|\treturn selected == nil || selected.Value.String() == \"\"\n61|}\n62|\n63|// defensiveSites names derived refusal sites no public input can fire,\n64|// with the bound that keeps each honest. The member-containment conjunct\n65|// in Resolve is unreachable because the member grammar refuses every\n66|// parent segment before the prefix check runs; it stays as defense in\n67|// depth against a future grammar relaxation, and\n68|// TestGuardPrefixCheckIsLoadBearing proves the containment property over\n69|// a generated corpus, so a weakened grammar reddens there first. A\n70|// defensive entry that resolves to no derived site fails as stale.\n71|var defensiveSites = map[string]string{\n72|\t\"failPath:member containment\": \"unreachable while the member grammar refuses parent segments; pinned by TestGuardPrefixCheckIsLoadBearing\",\n73|}\n74|\n75|// platformExempt names rules that need not fire on one GOOS, keyed\n76|// file|constructor:rule. The key is rule-level, not site-level: every\n77|// \"open failed\" site in nofollow.go shares it. The post-check directory\n78|// open fails deterministically only where mode bits are enforceable: the\n79|// chmod vector in TestOpenNoFollowDirRefusesUnreadableDir is skipped on\n80|// Windows (ACLs do not express a mode-000 directory) and as root (which\n81|// bypasses mode bits), so on Windows the rule is exempt. An exemption\n82|// that resolves to no derived site fails as stale.\n83|var platformExempt = map[string]string{\n84|\t\"nofollow.go|failPath:open failed\": \"windows\",\n85|}\n86|\n87|// rootExempt names derived sites excused when the suite runs as root,\n88|// which bypasses the mode bits the chmod vector depends on. Same key\n89|// shape and staleness discipline as platformExempt; the audit below\n90|// checks both tables for orphans.\n91|var rootExempt = map[string]bool{\n92|\t\"nofollow.go|failPath:open failed\": true,\n93|}\n94|\n95|// siteKey renders the platform-exemption identity of a derived site: the\n96|// file basename plus the constructor and rule. Line numbers are left out\n97|// so edits above or below a site do not rename it.\n98|func siteKey(site, constructor string) string {\n99|\tfile := site\n100|\tif index := strings.LastIndex(site, \":\"); index >= 0 {\n101|\t\tfile = site[:index]\n102|\t}\n103|\treturn file + \"|\" + constructor\n104|}\n105|\n106|// exemptionResolves reports whether the exemption key matches at least\n107|// one derived site.\n108|func exemptionResolves(derived map[string]string, key string) bool {\n109|\tfor derivedSite, constructor := range derived {\n110|\t\tif siteKey(derivedSite, constructor) == key {\n111|\t\t\treturn true\n112|\t\t}\n113|\t}\n114|\treturn false\n115|}\n116|\n117|// auditRefusalInventory derives every failPath/failArgv/failEnv call site\n118|// from non-test production source and requires each to have fired during\n119|// the suite (forward), and every fired site to resolve to a derived site\n120|// (reverse). A constructor call no test reaches, or a recorded site the\n121|// source no longer contains, fails instead of passing silently. An empty\n122|// derivation fails closed: a blind scanner is not a complete inventory.\n123|func auditRefusalInventory() []string {\n124|\tdirectory, err := os.Getwd()\n125|\tif err != nil {\n126|\t\treturn []string{fmt.Sprintf(\"derive secprim refusal inventory: %v\", err)}\n127|\t}\n128|\tderived := map[string]string{}\n129|\tscanned := 0\n130|\tentries, err := os.ReadDir(directory)\n131|\tif err != nil {\n132|\t\treturn []string{fmt.Sprintf(\"derive secprim refusal inventory: %v\", err)}\n133|\t}\n134|\tfor _, entry := range entries {\n135|\t\tname := entry.Name()\n136|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n137|\t\t\tcontinue\n138|\t\t}\n139|\t\tcontents, err := os.ReadFile(filepath.Join(directory, name))\n140|\t\tif err != nil {\n141|\t\t\treturn []string{fmt.Sprintf(\"derive secprim refusal inventory: %v\", err)}\n142|\t\t}\n143|\t\tscanned++\n144|\t\tfileset := token.NewFileSet()\n145|\t\tsyntax, err := parser.ParseFile(fileset, name, contents, 0)\n146|\t\tif err != nil {\n147|\t\t\treturn []string{fmt.Sprintf(\"derive secprim refusal inventory: %v\", err)}\n148|\t\t}\n149|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n150|\t\t\tcall, ok := node.(*ast.CallExpr)\n151|\t\t\tif !ok {\n152|\t\t\t\treturn true\n153|\t\t\t}\n154|\t\t\tidentifier, ok := call.Fun.(*ast.Ident)\n155|\t\t\tif !ok {\n156|\t\t\t\treturn true\n157|\t\t\t}\n158|\t\t\tif identifier.Name != \"failPath\" && identifier.Name != \"failArgv\" && identifier.Name != \"failEnv\" {\n159|\t\t\t\treturn true\n160|\t\t\t}\n161|\t\t\t// Every constructor call passes its rule as a string\n162|\t\t\t// literal first argument; a non-literal rule is outside\n163|\t\t\t// the roster shape and fails the derivation.\n164|\t\t\tif len(call.Args) == 0 {\n165|\t\t\t\tderived[fmt.Sprintf(\"%s:%d\", name, fileset.Position(call.Pos()).Line)] = \"\"\n166|\t\t\t\treturn true\n167|\t\t\t}\n168|\t\t\tliteral, ok := call.Args[0].(*ast.BasicLit)\n169|\t\t\tif !ok || literal.Kind != token.STRING {\n170|\t\t\t\tderived[fmt.Sprintf(\"%s:%d\", name, fileset.Position(call.Pos()).Line)] = \"\"\n171|\t\t\t\treturn true\n172|\t\t\t}\n173|\t\t\trule, err := strconv.Unquote(literal.Value)\n174|\t\t\tif err != nil {\n175|\t\t\t\tderived[fmt.Sprintf(\"%s:%d\", name, fileset.Position(call.Pos()).Line)] = \"\"\n176|\t\t\t\treturn true\n177|\t\t\t}\n178|\t\t\tderived[fmt.Sprintf(\"%s:%d\", name, fileset.Position(call.Pos()).Line)] = identifier.Name + \":\" + rule\n179|\t\t\treturn true\n180|\t\t})\n181|\t}\n182|\tvar failures []string\n183|\tif scanned == 0 {\n184|\t\tfailures = append(failures, \"scanned no production sources; the check is blind\")\n185|\t}\n186|\tif len(derived) == 0 {\n187|\t\tfailures = append(failures, \"derived no refusal sites; the scan is blind\")\n188|\t}\n189|\tfor site, defense := range defensiveSites {\n190|\t\t_ = defense\n191|\t\tmatched := false\n192|\t\tfor derivedSite, constructor := range derived {\n193|\t\t\tif constructor == site {\n194|\t\t\t\tmatched = true\n195|\t\t\t\t_ = derivedSite\n196|\t\t\t}\n197|\t\t}\n198|\t\tif !matched {\n199|\t\t\tfailures = append(failures, fmt.Sprintf(\"defensive site %s resolves to no derived site; the rationale is stale\", site))\n200|\t\t}\n201|\t}\n202|\tfor key := range platformExempt {\n203|\t\tif !exemptionResolves(derived, key) {\n204|\t\t\tfailures = append(failures, fmt.Sprintf(\"platform exemption %s resolves to no derived site; the exemption is stale\", key))\n205|\t\t}\n206|\t}\n207|\tfor key := range rootExempt {\n208|\t\tif !exemptionResolves(derived, key) {\n209|\t\t\tfailures = append(failures, fmt.Sprintf(\"root exemption %s resolves to no derived site; the exemption is stale\", key))\n210|\t\t}\n211|\t}\n212|\tfor site, constructor := range derived {\n213|\t\tif constructor == \"\" {\n214|\t\t\tfailures = append(failures, fmt.Sprintf(\"refusal site %s carries a non-literal rule; the roster cannot name it\", site))\n215|\t\t\tcontinue\n216|\t\t}\n217|\t\tif _, defensive := defensiveSites[constructor]; defensive {\n218|\t\t\tcontinue\n219|\t\t}\n220|\t\tif only, exempt := platformExempt[siteKey(site, constructor)]; exempt && runtime.GOOS == only {\n221|\t\t\tcontinue\n222|\t\t}\n223|\t\tif _, excused := rootExempt[siteKey(site, constructor)]; excused && privilegedUser() {\n224|\t\t\tcontinue\n225|\t\t}\n226|\t\tif _, exercised := exercisedRefusalSites.Load(site); !exercised {\n227|\t\t\tfailures = append(failures, fmt.Sprintf(\"refusal site %s never fired during the suite\", site))\n228|\t\t}\n229|\t}\n230|\texercisedRefusalSites.Range(func(key, _ any) bool {\n231|\t\tif _, ok := derived[key.(string)]; !ok {\n232|\t\t\tfailures = append(failures, fmt.Sprintf(\"exercised refusal site %s resolves to no derived site\", key.(string)))\n233|\t\t}\n234|\t\treturn true\n235|\t})\n236|\treturn failures\n237|}"}}}
