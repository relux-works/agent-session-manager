{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4dd","stream":{"kind":"session","id":"01a07721-ca06-7081-babf-b563190d8d78"},"sequence":201,"recorded_at":1780531400000397,"record_type":"event","durability":"durable","causation_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","run_stream":{"kind":"run","id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd"},"call_id":"call_01a07722173276d1bb563bdf1d269967","text":"Read text file `internal/secprim/census_test.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"go/ast\"\n6|\t\"go/parser\"\n7|\t\"go/token\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"sort\"\n11|\t\"strconv\"\n12|\t\"strings\"\n13|\t\"testing\"\n14|\n15|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n16|)\n17|\n18|// secretTokens is the instrument vocabulary for the secret-site census.\n19|// Every token must fire on at least one derived site (see\n20|// TestSecretTokensAreProven), or the token is dead ceremony. \"token\" is\n21|// excluded from the local-binding arm below because the JSON decoder\n22|// vocabulary (decoder.Token, token variables) would drown it; every other\n23|// token scans locals too.\n24|//\n25|// Deliberately absent: bare \"auth\" (authority identifiers, authorization\n26|// enums, and authentication subjects are UUID/boolean/enum protocol\n27|// vocabulary, never credential values — TestSecretScanBlindSpot pins\n28|// this), and \"bundle\" (bundle identifiers are digests; opaque bundle\n29|// content is covered by the Section 16.2 class row, not by field\n30|// census). \"transcript\" and \"scrollback\" are present: raw transcripts\n31|// are an excludable class with in-repo gate sites.\n32|var secretTokens = []string{\n33|\t\"secret\", \"credential\", \"passwd\", \"password\", \"token\",\n34|\t\"passphrase\", \"cookie\", \"private_key\", \"privatekey\",\n35|\t\"api_key\", \"apikey\", \"transcript\", \"scrollback\",\n36|}\n37|\n38|// censusPackages bounds the secret-site scan. Every package that handles\n39|// provider output, configuration, errors, records, or storage is in;\n40|// specdoc, traceability, and command trees carry no secret-bearing\n41|// production values.\n42|var censusPackages = []string{\n43|\t\"axerror\", \"canonicaljson\", \"cliresult\", \"config\", \"dirnode\",\n44|\t\"environ\", \"localstore\", \"provider\", \"provhost\", \"scalar\",\n45|\t\"secprim\", \"sessadapter\", \"terminalbackend\",\n46|}\n47|\n48|// deriveSecretSites scans non-test production source in the census\n49|// packages for token-matching sites: declaration names (types,\n50|// functions, package-level values), struct field names, parameter and\n51|// result names, local bindings (all tokens except \"token\"), and every\n52|// string literal. Comments never participate: the walk is over syntax,\n53|// so a documented example cannot roster a site and a secret in a comment\n54|// cannot hide from it either — comments are outside both directions by\n55|// construction, which TestSecretScanIgnoresComments pins.\n56|func deriveSecretSites(t *testing.T) map[string]bool {\n57|\tt.Helper()\n58|\tsites := map[string]bool{}\n59|\tscanned := 0\n60|\tfor _, pkg := range censusPackages {\n61|\t\tdirectory := filepath.Join(\"..\", pkg)\n62|\t\tentries, err := os.ReadDir(directory)\n63|\t\tif err != nil {\n64|\t\t\tt.Fatalf(\"read %s: %v\", directory, err)\n65|\t\t}\n66|\t\tfor _, entry := range entries {\n67|\t\t\tname := entry.Name()\n68|\t\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n69|\t\t\t\tcontinue\n70|\t\t\t}\n71|\t\t\tcontents, err := os.ReadFile(filepath.Join(directory, name))\n72|\t\t\tif err != nil {\n73|\t\t\t\tt.Fatal(err)\n74|\t\t\t}\n75|\t\t\tscanned++\n76|\t\t\tfileset := token.NewFileSet()\n77|\t\t\tsyntax, err := parser.ParseFile(fileset, name, contents, 0)\n78|\t\t\tif err != nil {\n79|\t\t\t\tt.Fatal(err)\n80|\t\t\t}\n81|\t\t\tpackageName := pkg\n82|\t\t\t_ = packageName\n83|\t\t\tast.Inspect(syntax, func(node ast.Node) bool {\n84|\t\t\t\tswitch typed := node.(type) {\n85|\t\t\t\tcase *ast.TypeSpec:\n86|\t\t\t\t\tadmitSite(sites, pkg, \"decl\", typed.Name.Name)\n87|\t\t\t\tcase *ast.FuncDecl:\n88|\t\t\t\t\tadmitSite(sites, pkg, \"decl\", typed.Name.Name)\n89|\t\t\t\tcase *ast.GenDecl:\n90|\t\t\t\t\tif typed.Tok == token.IMPORT {\n91|\t\t\t\t\t\treturn true\n92|\t\t\t\t\t}\n93|\t\t\t\t\tfor _, spec := range typed.Specs {\n94|\t\t\t\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n95|\t\t\t\t\t\tif !ok {\n96|\t\t\t\t\t\t\tcontinue\n97|\t\t\t\t\t\t}\n98|\t\t\t\t\t\tkind := \"decl\"\n99|\t\t\t\t\t\tif inFunctionBody(syntax, spec) {\n100|\t\t\t\t\t\t\tkind = \"local\"\n101|\t\t\t\t\t\t}\n102|\t\t\t\t\t\tfor _, identifier := range value.Names {\n103|\t\t\t\t\t\t\tadmitName(sites, pkg, kind, identifier.Name)\n104|\t\t\t\t\t\t}\n105|\t\t\t\t\t}\n106|\t\t\t\t\treturn true\n107|\t\t\t\tcase *ast.Field:\n108|\t\t\t\t\tfor _, identifier := range typed.Names {\n109|\t\t\t\t\t\tadmitName(sites, pkg, fieldKind(syntax, typed), identifier.Name)\n110|\t\t\t\t\t}\n111|\t\t\t\t\treturn true\n112|\t\t\t\tcase *ast.AssignStmt:\n113|\t\t\t\t\tfor _, bound := range typed.Lhs {\n114|\t\t\t\t\t\tidentifier, ok := bound.(*ast.Ident)\n115|\t\t\t\t\t\tif !ok || identifier.Name == \"_\" {\n116|\t\t\t\t\t\t\tcontinue\n117|\t\t\t\t\t\t}\n118|\t\t\t\t\t\tadmitLocal(sites, pkg, identifier.Name)\n119|\t\t\t\t\t}\n120|\t\t\t\t\treturn true\n121|\t\t\t\tcase *ast.BasicLit:\n122|\t\t\t\t\tif typed.Kind != token.STRING {\n123|\t\t\t\t\t\treturn true\n124|\t\t\t\t\t}\n125|\t\t\t\t\tadmitLiteral(sites, pkg, typed.Value)\n126|\t\t\t\t}\n127|\t\t\t\treturn true\n128|\t\t\t})\n129|\t\t}\n130|\t}\n131|\tif scanned == 0 {\n132|\t\tt.Fatal(\"scanned no production sources; the census is blind\")\n133|\t}\n134|\tif len(sites) == 0 {\n135|\t\tt.Fatal(\"derived no secret sites; the scanner is broken, not the tree\")\n136|\t}\n137|\treturn sites\n138|}\n139|\n140|// inFunctionBody reports whether the spec sits inside a function\n141|// declaration. Package-level values are declarations; function-level\n142|// values are locals and scan under the strong tokens only.\n143|func inFunctionBody(syntax *ast.File, spec ast.Spec) bool {\n144|\tfor _, declaration := range syntax.Decls {\n145|\t\tfunction, ok := declaration.(*ast.FuncDecl)\n146|\t\tif !ok || function.Body == nil {\n147|\t\t\tcontinue\n148|\t\t}\n149|\t\tfound := false\n150|\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n151|\t\t\tif node == spec {\n152|\t\t\t\tfound = true\n153|\t\t\t\treturn false\n154|\t\t\t}\n155|\t\t\treturn true\n156|\t\t})\n157|\t\tif found {\n158|\t\t\treturn true\n159|\t\t}\n160|\t}\n161|\treturn false\n162|}\n163|\n164|// fieldKind distinguishes struct fields (rostered under every token)\n165|// from parameter and result names (same treatment): both are\n166|// declaration-adjacent bindings, unlike locals.\n167|func fieldKind(syntax *ast.File, field *ast.Field) string {\n168|\tfor _, declaration := range syntax.Decls {\n169|\t\tfunction, ok := declaration.(*ast.FuncDecl)\n170|\t\tif !ok {\n171|\t\t\tcontinue\n172|\t\t}\n173|\t\tif function.Type == nil {\n174|\t\t\tcontinue\n175|\t\t}\n176|\t\tfor _, list := range []*ast.FieldList{function.Type.Params, function.Type.Results} {\n177|\t\t\tif list == nil {\n178|\t\t\t\tcontinue\n179|\t\t\t}\n180|\t\t\tfor _, candidate := range list.List {\n181|\t\t\t\tif candidate == field {\n182|\t\t\t\t\treturn \"param\"\n183|\t\t\t\t}\n184|\t\t\t}\n185|\t\t}\n186|\t}\n187|\treturn \"field\"\n188|}\n189|\n190|// admitSite records a declaration-position name under every token it\n191|// contains.\n192|func admitSite(sites map[string]bool, pkg, kind, name string) {\n193|\tadmitName(sites, pkg, kind, name)\n194|}\n195|\n196|// admitName records a declaration-adjacent name under every token it\n197|// contains (case-insensitive substring).\n198|func admitName(sites map[string]bool, pkg, kind, name string) {\n199|\tlowered := strings.ToLower(name)\n200|\tfor _, word := range secretTokens {\n201|\t\tif strings.Contains(lowered, word) {\n202|\t\t\tsites[pkg+\"|\"+kind+\"|\"+name] = true\n203|\t\t}\n204|\t}\n205|}\n206|\n207|// admitLocal records a function-local binding under every strong token:\n208|// every token except \"token\", which the JSON decoder vocabulary owns.\n209|func admitLocal(sites map[string]bool, pkg, name string) {\n210|\tlowered := strings.ToLower(name)\n211|\tfor _, word := range secretTokens {\n212|\t\tif word == \"token\" {\n213|\t\t\tcontinue\n214|\t\t}\n215|\t\tif strings.Contains(lowered, word) {\n216|\t\t\tsites[pkg+\"|local|\"+name] = true\n217|\t\t}\n218|\t}\n219|}\n220|\n221|// maxLiteralRunes bounds the literal arm: a literal longer than this is\n222|// prose documentation, not an identifier, key, or diagnostic atom, and\n223|// rostering it would turn every explanatory paragraph into a site. The\n224|// longest rostered diagnostic is 55 runes; the bound sits at 80.\n225|const maxLiteralRunes = 80\n226|\n227|// admitLiteral records a string literal under every token it contains.\n228|// The literal is unquoted when it parses; an unparseable literal is\n229|// recorded raw rather than dropped. Literals past maxLiteralRunes are\n230|// documentation prose, not sites.\n231|func admitLiteral(sites map[string]bool, pkg, raw string) {\n232|\tvalue, err := strconv.Unquote(raw)\n233|\tif err != nil {\n234|\t\tvalue = raw\n235|\t}\n236|\tif len([]rune(value)) > maxLiteralRunes {\n237|\t\treturn\n238|\t}\n239|\tlowered := strings.ToLower(value)\n240|\tfor _, word := range secretTokens {\n241|\t\tif strings.Contains(lowered, word) {\n242|\t\t\tsites[pkg+\"|lit|\"+value] = true\n243|\t\t}\n244|\t}\n245|}\n246|\n247|// TestSecretScanIgnoresComments pins the comment blindness both ways: a\n248|// token in a comment rosters nothing, so documentation cannot create\n249|// obligations, and (by construction of the syntax walk) nothing outside\n250|// code participates.\n251|func TestSecretScanIgnoresComments(t *testing.T) {\n252|\tt.Parallel()\n253|\tsyntax, err := parser.ParseFile(token.NewFileSet(), \"comment.go\", \"package x\\n// password credential token secret\\nvar clean = 1\\n\", 0)\n254|\tif err != nil {\n255|\t\tt.Fatal(err)\n256|\t}\n257|\tsites := map[string]bool{}\n258|\tast.Inspect(syntax, func(node ast.Node) bool {\n259|\t\tif identifier, ok := node.(*ast.Ident); ok {\n260|\t\t\tadmitName(sites, \"x\", \"decl\", identifier.Name)\n261|\t\t}\n262|\t\tif literal, ok := node.(*ast.BasicLit); ok && literal.Kind == token.STRING {\n263|\t\t\tadmitLiteral(sites, \"x\", literal.Value)\n264|\t\t}\n265|\t\treturn true\n266|\t})\n267|\tif len(sites) != 0 {\n268|\t\tt.Fatalf(\"comment tokens rostered sites %v\", sites)\n269|\t}\n270|}\n271|\n272|// secretSiteRow pairs derived secret sites sharing one disposition with\n273|// the witnesses that prove it. Every derived site appears in exactly one\n274|// row: a derived site with no row fails as unaccounted, and a row naming\n275|// a site production no longer derives fails as orphaned.\n276|type secretSiteRow struct {\n277|\tsites       []string\n278|\tdisposition string\n279|\twitnesses   []string // \"package.TestName\" entries, verified to exist\n280|}\n281|\n282|// secretSiteRows is the reviewed disposition half of the census. The\n283|// denominator is derived (deriveSecretSites); these rows say what each\n284|// site is and which test proves it stays that way.\n285|func secretSiteRows() []secretSiteRow {\n286|\treturn []secretSiteRow{\n287|\t\t{\n288|\t\t\tsites: []string{\n289|\t\t\t\t\"axerror|lit|access_token\", \"axerror|lit|api_key\",\n290|\t\t\t\t\"axerror|lit|cookie\", \"axerror|lit|cookies\",\n291|\t\t\t\t\"axerror|lit|credential\", \"axerror|lit|credentials\",\n292|\t\t\t\t\"axerror|lit|env_secret\", \"axerror|lit|environment secret\",\n293|\t\t\t\t\"axerror|lit|environment_secret\", \"axerror|lit|oauth_token\",\n294|\t\t\t\t\"axerror|lit|passphrase\", \"axerror|lit|password\",\n295|\t\t\t\t\"axerror|lit|private_key\", \"axerror|lit|refresh_token\",\n296|\t\t\t\t\"axerror|lit|secret\", \"axerror|lit|secrets\",\n297|\t\t\t\t\"axerror|lit|session_token\", \"axerror|lit|ssh_private_key\",\n298|\t\t\t\t\"axerror|lit|subscription_token\",\n299|\t\t\t\t\"axerror|lit|raw_transcript\", \"axerror|lit|transcript\",\n300|\t\t\t\t\"axerror|lit|scrollback\", \"axerror|lit|terminal_scrollback\",\n301|\t\t\t\t\"axerror|lit|raw transcript\",\n302|\t\t\t},\n303|\t\t\tdisposition: \"members of the axerror excludedDetailKeys refusal table: a Structured Error detail \" +\n304|\t\t\t\t\"naming one is refused before encoding, so no credential, transcript, environment secret, or \" +\n305|\t\t\t\t\"bundle key reaches the wire as a detail\",\n306|\t\t\twitnesses: []string{\"secprim.TestSecretAxerrorTableRefused\"},\n307|\t\t},\n308|\t\t{\n309|\t\t\t// The derived members of the secprim sensitiveKeyNames\n310|\t\t\t// scrubber table. \"auth_json\", \"authorization\", and \"dotenv\"\n311|\t\t\t// are table members too, but no instrument token fires on\n312|\t\t\t// them (the Authority blind spot pinned by\n313|\t\t\t// TestSecretScanBlindSpot); TestSensitiveKeyListIsReviewed\n314|\t\t\t// pins the whole table of 27 including those three, so the\n315|\t\t\t// table cannot gain or lose a member without reddening\n316|\t\t\t// there.\n317|\t\t\tsites: []string{\n318|\t\t\t\t\"secprim|lit|access_token\", \"secprim|lit|api_key\", \"secprim|lit|apikey\",\n319|\t\t\t\t\"secprim|lit|auth_token\", \"secprim|lit|bearer_token\",\n320|\t\t\t\t\"secprim|lit|client_secret\", \"secprim|lit|cookie\", \"secprim|lit|cookies\",\n321|\t\t\t\t\"secprim|lit|credential\", \"secprim|lit|credentials\",\n322|\t\t\t\t\"secprim|lit|env_secret\", \"secprim|lit|environment_secret\", \"secprim|lit|oauth_token\",\n323|\t\t\t\t\"secprim|lit|passphrase\", \"secprim|lit|passwd\", \"secprim|lit|password\",\n324|\t\t\t\t\"secprim|lit|private_key\", \"secprim|lit|refresh_token\", \"secprim|lit|secret\",\n325|\t\t\t\t\"secprim|lit|secrets\", \"secprim|lit|session_token\", \"secprim|lit|ssh_private_key\",\n326|\t\t\t\t\"secprim|lit|subscription_token\", \"secprim|lit|token\",\n327|\t\t\t},\n328|\t\t\tdisposition: \"members of the secprim sensitiveKeyNames scrubber table: a free-text key=value pair \" +\n329|\t\t\t\t\"naming one has its value masked by Redact before persistence or display\",\n330|\t\t\twitnesses: []string{\"secprim.TestSensitiveKeyListIsReviewed\", \"secprim.TestRedactSensitivePairs\"},\n331|\t\t},\n332|\t\t{\n333|\t\t\tsites: []string{\n334|\t\t\t\t\"secprim|decl|minSecretRunes\", \"secprim|decl|privateKeyBeginPrefix\",\n335|\t\t\t\t\"secprim|decl|privateKeyBeginSuffix\", \"secprim|decl|privateKeyEndPrefix\",\n336|\t\t\t\t\"secprim|decl|redactPrivateKeyBlocks\", \"secprim|decl|redactedPrivateKey\",\n337|\t\t\t\t\"secprim|param|secrets\",\n338|\t\t\t},\n339|\t\t\tdisposition: \"the scrubber machinery itself: private-key block shapes, the corpus bound, and the \" +\n340|\t\t\t\t\"caller-known secret values Redact removes rather than stores\",\n341|\t\t\twitnesses: []string{\"secprim.TestRedactPrivateKeyBlocks\", \"secprim.TestRedactCorpusValues\"},\n342|\t\t},\n343|\t\t{\n344|\t\t\tsites: []string{\n345|\t\t\t\t\"terminalbackend|lit|attach_credential\", \"terminalbackend|lit|relay_credential\",\n346|\t\t\t\t\"terminalbackend|lit|provider_credential\", \"terminalbackend|lit|evidence_secret\",\n347|\t\t\t\t\"terminalbackend|lit|credential_detail\", \"terminalbackend|lit|token\",\n348|\t\t\t\t\"terminalbackend|lit|scrollback\",\n349|\t\t\t},\n350|\t\t\tdisposition: \"members of the terminal replication-exclusion vocabulary: classified sensitive-owner-only \" +\n351|\t\t\t\t\"or forbidden, never transferred as live authority\",\n352|\t\t\twitnesses: []string{\"terminalbackend.TestReplicationClassificationIsClosed\"},\n353|\t\t},\n354|\t\t{\n355|\t\t\tsites: []string{\n356|\t\t\t\t\"terminalbackend|decl|credentialRealmCapability\",\n357|\t\t\t\t\"terminalbackend|lit|credential_capable_execution_realm\",\n358|\t\t\t\t\"terminalbackend|lit|credential_sentinel\",\n359|\t\t\t\t\"terminalbackend|lit|scrollback_retention\",\n360|\t\t\t},\n361|\t\t\tdisposition: \"capability vocabulary words: they name the credential-capable realm, its sentinel \" +\n362|\t\t\t\t\"evidence member, and the scrollback-retention policy, whose values are booleans, enums, and \" +\n363|\t\t\t\t\"retention facts, never secrets or transcript content\",\n364|\t\t\twitnesses: []string{\"terminalbackend.TestParseManifestAdmitsClosedFixture\"},\n365|\t\t},\n366|\t\t{\n367|\t\t\tsites: []string{\"sessadapter|lit|credential\"},\n368|\t\t\tdisposition: \"member of the closed capture-class vocabulary: naming the class a capture plan \" +\n369|\t\t\t\t\"excludes, not a credential value\",\n370|\t\t\twitnesses: []string{\"sessadapter.TestDecodeCapturePlanItemRules\"},\n371|\t\t},\n372|\t\t{\n373|\t\t\tsites: []string{\n374|\t\t\t\t\"provhost|lit|rollback_token\",\n375|\t\t\t\t\"provhost|lit|status rollback_token is not a string\",\n376|\t\t\t\t\"provhost|lit|status rollback_token is shorter than 256 bits\",\n377|\t\t\t\t\"provhost|lit|unknown status carries plan, token, or discovery\",\n378|\t\t\t\t\"provhost|lit|prepared status misses plan, token, or discovery\",\n379|\t\t\t\t\"provhost|lit|terminal status misses plan or discovery or keeps a token\",\n380|\t\t\t\t\"provhost|local|token\",\n381|\t\t\t},\n382|\t\t\tdisposition: \"the closed status member plus its charset/length gate: the decoded rollback token is \" +\n383|\t\t\t\t\"checked for 256-bit base64url shape only, and every refusal names the member, never the value\",\n384|\t\t\twitnesses: []string{\"provhost.TestDecodeStatusOutcomeRefusesMalformedBodies\"},\n385|\t\t},\n386|\t\t{\n387|\t\t\tsites: []string{\n388|\t\t\t\t\"scalar|lit|must not contain userinfo credentials\",\n389|\t\t\t\t\"scalar|lit|must not contain a password or token\",\n390|\t\t\t\t\"scalar|local|password\",\n391|\t\t\t},\n392|\t\t\tdisposition: \"the sanitized-Git-URL refusal: userinfo credentials and passwords are refused at parse, \" +\n393|\t\t\t\t\"and the decoded local is compared and dropped, never rendered\",\n394|\t\t\twitnesses: []string{\"scalar.TestSanitizedGitURLRefusesCredentialsAndLocalSchemes\"},\n395|\t\t},\n396|\t\t{\n397|\t\t\tsites: []string{\n398|\t\t\t\t\"canonicaljson|lit|contains_secrets\",\n399|\t\t\t\t\"canonicaljson|lit|Session Record Launch Plan contains_secrets must be false\",\n400|\t\t\t\t\"canonicaljson|local|containsSecrets\",\n401|\t\t\t},\n402|\t\t\tdisposition: \"the launch-plan secrecy flag: a plan declaring contains_secrets is refused, so a \" +\n403|\t\t\t\t\"secret-bearing plan cannot enter an immutable record\",\n404|\t\t\twitnesses: []string{\"canonicaljson.TestSessionRecordV1NestedTaggedShapesReachBothIdentityEntries\"},\n405|\t\t},\n406|\t\t{\n407|\t\t\tsites: []string{\n408|\t\t\t\t\"canonicaljson|lit|decode JSON token: %v\",\n409|\t\t\t\t\"canonicaljson|lit|unexpected trailing JSON token %v\",\n410|\t\t\t},\n411|\t\t\tdisposition: \"constant decoder diagnostics naming JSON tokens (syntax elements), not secret values; \" +\n412|\t\t\t\t\"they carry the offending input shape, never a credential\",\n413|\t\t\twitnesses: []string{\"canonicaljson.TestCalculateObjectIdentityRefusesMalformedJSONInput\"},\n414|\t\t},\n415|\t\t{\n416|\t\t\tsites: []string{\n417|\t\t\t\t\"dirnode|lit|bootstrap process token is empty\",\n418|\t\t\t\t\"dirnode|param|token\",\n419|\t\t\t},\n420|\t\t\tdisposition: \"the opaque bootstrap idempotency token: compared in-memory only, and refusals name \" +\n421|\t\t\t\t\"the member, never the value\",\n422|\t\t\twitnesses: []string{\"dirnode.TestProcessGuardRefusesReuse\"},\n423|\t\t},\n424|\t\t{\n425|\t\t\tsites: []string{\n426|\t\t\t\t\"config|field|TranscriptGrepEnabled\",\n427|\t\t\t\t`config|lit|toml:\"transcript_grep_enabled\"`,\n428|\t\t\t},\n429|\t\t\tdisposition: \"the explicit transcript-grep opt-in switch: an admitted boolean member, defaulting \" +\n430|\t\t\t\t\"to false, gating source-local bounded grep per Section 16.7 — not a transcript value\",\n431|\t\t\twitnesses: []string{\"config.TestLoadAcceptsExactV2DirectoryAndV3TerminalShapes\"},\n432|\t\t},\n433|\t}\n434|}\n435|\n436|// TestSecretSiteRosterIsComplete requires every derived secret site to\n437|// carry exactly one row and every row site to resolve to a derived site.\n438|// Removing a secret-bearing declaration, or adding one, reddens here in\n439|// exactly one direction.\n440|func TestSecretSiteRosterIsComplete(t *testing.T) {\n441|\tderived := deriveSecretSites(t)\n442|\trows := secretSiteRows()\n443|\tseen := map[string]bool{}\n444|\tfor _, row := range rows {\n445|\t\tfor _, site := range row.sites {\n446|\t\t\tif !derived[site] {\n447|\t\t\t\tt.Fatalf(\"orphaned census row site %q: production derives no such site\", site)\n448|\t\t\t}\n449|\t\t\tif seen[site] {\n450|\t\t\t\tt.Fatalf(\"duplicate census row site %q: one disposition per site\", site)\n451|\t\t\t}\n452|\t\t\tseen[site] = true\n453|\t\t}\n454|\t}\n455|\tvar missing []string\n456|\tfor site := range derived {\n457|\t\tif !seen[site] {\n458|\t\t\tmissing = append(missing, site)\n459|\t\t}\n460|\t}\n461|\tsort.Strings(missing)\n462|\tif len(missing) > 0 {\n463|\t\tt.Fatalf(\"derived secret sites with no disposition row:\\n  %s\", strings.Join(missing, \"\\n  \"))\n464|\t}\n465|}\n466|\n467|// TestSecretSiteWitnessesExist verifies every cited witness names a real\n468|// test function in its package, parsed from that package's test sources:\n469|// a renamed or deleted witness reddens here instead of citing a ghost.\n470|func TestSecretSiteWitnessesExist(t *testing.T) {\n471|\tt.Parallel()\n472|\tneeded := map[string]map[string]bool{}\n473|\tfor _, row := range secretSiteRows() {\n474|\t\tfor _, witness := range row.witnesses {\n475|\t\t\tparts := strings.Split(witness, \".\")\n476|\t\t\tif len(parts) != 2 {\n477|\t\t\t\tt.Fatalf(\"witness %q is not package.Test shaped\", witness)\n478|\t\t\t}\n479|\t\t\tif needed[parts[0]] == nil {\n480|\t\t\t\tneeded[parts[0]] = map[string]bool{}\n481|\t\t\t}\n482|\t\t\tneeded[parts[0]][parts[1]] = true\n483|\t\t}\n484|\t}\n485|\tfor pkg, names := range needed {\n486|\t\tfound := testFuncNames(t, pkg)\n487|\t\tfor name := range names {\n488|\t\t\tif !found[name] {\n489|\t\t\t\tt.Errorf(\"witness %s.%s does not exist; the census cites a ghost\", pkg, name)\n490|\t\t\t}\n491|\t\t}\n492|\t}\n493|}\n494|\n495|// testFuncNames parses a package's test files for test function names.\n496|// The walk is over declarations, so a name mentioned in a comment or a\n497|// string cannot satisfy it.\n498|func testFuncNames(t *testing.T, pkg string) map[string]bool {\n499|\tt.Helper()\n500|\tdirectory := filepath.Join(\"..\", pkg)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4df","stream":{"kind":"session","id":"01a07721-ca06-7081-babf-b563190d8d78"},"sequence":202,"recorded_at":1780531400000399,"record_type":"event","durability":"durable","causation_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","run_stream":{"kind":"run","id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd"},"call_id":"call_01a0772217d0717283836f090cbed953","text":"Read text file `internal/secprim/inventory_test.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"flag\"\n5|\t\"fmt\"\n6|\t\"go/ast\"\n7|\t\"go/parser\"\n8|\t\"go/token\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"runtime\"\n12|\t\"strconv\"\n13|\t\"strings\"\n14|\t\"sync\"\n15|\t\"testing\"\n16|)\n17|\n18|// exercisedRefusalSites records the production file:line that constructed a\n19|// refusal, keyed with the rule it carried, for every instrumented refusal\n20|// constructor call made during the test run.\n21|var exercisedRefusalSites sync.Map // file:line -> rule\n22|\n23|func recordRefusalSite(rule string) {\n24|\tif _, file, line, ok := runtime.Caller(2); ok {\n25|\t\texercisedRefusalSites.Store(fmt.Sprintf(\"%s:%d\", filepath.Base(file), line), rule)\n26|\t}\n27|}\n28|\n29|func TestMain(main *testing.M) {\n30|\torigPath, origArgv, origEnv := failPath, failArgv, failEnv\n31|\tfailPath = func(rule, detail string) *Error {\n32|\t\terr := origPath(rule, detail)\n33|\t\trecordRefusalSite(\"path:\" + rule)\n34|\t\treturn err\n35|\t}\n36|\tfailArgv = func(rule, detail string) *Error {\n37|\t\terr := origArgv(rule, detail)\n38|\t\trecordRefusalSite(\"argv:\" + rule)\n39|\t\treturn err\n40|\t}\n41|\tfailEnv = func(rule, detail string) *Error {\n42|\t\terr := origEnv(rule, detail)\n43|\t\trecordRefusalSite(\"env:\" + rule)\n44|\t\treturn err\n45|\t}\n46|\tcode := main.Run()\n47|\tif code == 0 && fullPackageTestRun() {\n48|\t\tif failures := auditRefusalInventory(); len(failures) != 0 {\n49|\t\t\tfor _, failure := range failures {\n50|\t\t\t\tfmt.Fprintln(os.Stderr, failure)\n51|\t\t\t}\n52|\t\t\tcode = 1\n53|\t\t}\n54|\t}\n55|\tos.Exit(code)\n56|}\n57|\n58|func fullPackageTestRun() bool {\n59|\tselected := flag.Lookup(\"test.run\")\n60|\treturn selected == nil || selected.Value.String() == \"\"\n61|}\n62|\n63|// defensiveSites names derived refusal sites no public input can fire,\n64|// with the bound that keeps each honest. The member-containment conjunct\n65|// in Resolve is unreachable because the member grammar refuses every\n66|// parent segment before the prefix check runs; it stays as defense in\n67|// depth against a future grammar relaxation, and\n68|// TestGuardPrefixCheckIsLoadBearing proves the containment property over\n69|// a generated corpus, so a weakened grammar reddens there first. A\n70|// defensive entry that resolves to no derived site fails as stale.\n71|var defensiveSites = map[string]string{\n72|\t\"failPath:member containment\": \"unreachable while the member grammar refuses parent segments; pinned by TestGuardPrefixCheckIsLoadBearing\",\n73|}\n74|\n75|// platformExempt names rules that need not fire on one GOOS, keyed\n76|// file|constructor:rule. The key is rule-level, not site-level: every\n77|// \"open failed\" site in nofollow.go shares it. The post-check directory\n78|// open fails deterministically only where mode bits are enforceable: the\n79|// chmod vector in TestOpenNoFollowDirRefusesUnreadableDir is skipped on\n80|// Windows (ACLs do not express a mode-000 directory) and as root (which\n81|// bypasses mode bits), so on Windows the rule is exempt. An exemption\n82|// that resolves to no derived site fails as stale.\n83|var platformExempt = map[string]string{\n84|\t\"nofollow.go|failPath:open failed\": \"windows\",\n85|}\n86|\n87|// rootExempt names derived sites excused when the suite runs as root,\n88|// which bypasses the mode bits the chmod vector depends on. Same key\n89|// shape and staleness discipline as platformExempt; the audit below\n90|// checks both tables for orphans.\n91|var rootExempt = map[string]bool{\n92|\t\"nofollow.go|failPath:open failed\": true,\n93|}\n94|\n95|// siteKey renders the platform-exemption identity of a derived site: the\n96|// file basename plus the constructor and rule. Line numbers are left out\n97|// so edits above or below a site do not rename it.\n98|func siteKey(site, constructor string) string {\n99|\tfile := site\n100|\tif index := strings.LastIndex(site, \":\"); index >= 0 {\n101|\t\tfile = site[:index]\n102|\t}\n103|\treturn file + \"|\" + constructor\n104|}\n105|\n106|// exemptionResolves reports whether the exemption key matches at least\n107|// one derived site.\n108|func exemptionResolves(derived map[string]string, key string) bool {\n109|\tfor derivedSite, constructor := range derived {\n110|\t\tif siteKey(derivedSite, constructor) == key {\n111|\t\t\treturn true\n112|\t\t}\n113|\t}\n114|\treturn false\n115|}\n116|\n117|// auditRefusalInventory derives every failPath/failArgv/failEnv call site\n118|// from non-test production source and requires each to have fired during\n119|// the suite (forward), and every fired site to resolve to a derived site\n120|// (reverse). A constructor call no test reaches, or a recorded site the\n121|// source no longer contains, fails instead of passing silently. An empty\n122|// derivation fails closed: a blind scanner is not a complete inventory.\n123|func auditRefusalInventory() []string {\n124|\tdirectory, err := os.Getwd()\n125|\tif err != nil {\n126|\t\treturn []string{fmt.Sprintf(\"derive secprim refusal inventory: %v\", err)}\n127|\t}\n128|\tderived := map[string]string{}\n129|\tscanned := 0\n130|\tentries, err := os.ReadDir(directory)\n131|\tif err != nil {\n132|\t\treturn []string{fmt.Sprintf(\"derive secprim refusal inventory: %v\", err)}\n133|\t}\n134|\tfor _, entry := range entries {\n135|\t\tname := entry.Name()\n136|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n137|\t\t\tcontinue\n138|\t\t}\n139|\t\tcontents, err := os.ReadFile(filepath.Join(directory, name))\n140|\t\tif err != nil {\n141|\t\t\treturn []string{fmt.Sprintf(\"derive secprim refusal inventory: %v\", err)}\n142|\t\t}\n143|\t\tscanned++\n144|\t\tfileset := token.NewFileSet()\n145|\t\tsyntax, err := parser.ParseFile(fileset, name, contents, 0)\n146|\t\tif err != nil {\n147|\t\t\treturn []string{fmt.Sprintf(\"derive secprim refusal inventory: %v\", err)}\n148|\t\t}\n149|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n150|\t\t\tcall, ok := node.(*ast.CallExpr)\n151|\t\t\tif !ok {\n152|\t\t\t\treturn true\n153|\t\t\t}\n154|\t\t\tidentifier, ok := call.Fun.(*ast.Ident)\n155|\t\t\tif !ok {\n156|\t\t\t\treturn true\n157|\t\t\t}\n158|\t\t\tif identifier.Name != \"failPath\" && identifier.Name != \"failArgv\" && identifier.Name != \"failEnv\" {\n159|\t\t\t\treturn true\n160|\t\t\t}\n161|\t\t\t// Every constructor call passes its rule as a string\n162|\t\t\t// literal first argument; a non-literal rule is outside\n163|\t\t\t// the roster shape and fails the derivation.\n164|\t\t\tif len(call.Args) == 0 {\n165|\t\t\t\tderived[fmt.Sprintf(\"%s:%d\", name, fileset.Position(call.Pos()).Line)] = \"\"\n166|\t\t\t\treturn true\n167|\t\t\t}\n168|\t\t\tliteral, ok := call.Args[0].(*ast.BasicLit)\n169|\t\t\tif !ok || literal.Kind != token.STRING {\n170|\t\t\t\tderived[fmt.Sprintf(\"%s:%d\", name, fileset.Position(call.Pos()).Line)] = \"\"\n171|\t\t\t\treturn true\n172|\t\t\t}\n173|\t\t\trule, err := strconv.Unquote(literal.Value)\n174|\t\t\tif err != nil {\n175|\t\t\t\tderived[fmt.Sprintf(\"%s:%d\", name, fileset.Position(call.Pos()).Line)] = \"\"\n176|\t\t\t\treturn true\n177|\t\t\t}\n178|\t\t\tderived[fmt.Sprintf(\"%s:%d\", name, fileset.Position(call.Pos()).Line)] = identifier.Name + \":\" + rule\n179|\t\t\treturn true\n180|\t\t})\n181|\t}\n182|\tvar failures []string\n183|\tif scanned == 0 {\n184|\t\tfailures = append(failures, \"scanned no production sources; the check is blind\")\n185|\t}\n186|\tif len(derived) == 0 {\n187|\t\tfailures = append(failures, \"derived no refusal sites; the scan is blind\")\n188|\t}\n189|\tfor site, defense := range defensiveSites {\n190|\t\t_ = defense\n191|\t\tmatched := false\n192|\t\tfor derivedSite, constructor := range derived {\n193|\t\t\tif constructor == site {\n194|\t\t\t\tmatched = true\n195|\t\t\t\t_ = derivedSite\n196|\t\t\t}\n197|\t\t}\n198|\t\tif !matched {\n199|\t\t\tfailures = append(failures, fmt.Sprintf(\"defensive site %s resolves to no derived site; the rationale is stale\", site))\n200|\t\t}\n201|\t}\n202|\tfor key := range platformExempt {\n203|\t\tif !exemptionResolves(derived, key) {\n204|\t\t\tfailures = append(failures, fmt.Sprintf(\"platform exemption %s resolves to no derived site; the exemption is stale\", key))\n205|\t\t}\n206|\t}\n207|\tfor key := range rootExempt {\n208|\t\tif !exemptionResolves(derived, key) {\n209|\t\t\tfailures = append(failures, fmt.Sprintf(\"root exemption %s resolves to no derived site; the exemption is stale\", key))\n210|\t\t}\n211|\t}\n212|\tfor site, constructor := range derived {\n213|\t\tif constructor == \"\" {\n214|\t\t\tfailures = append(failures, fmt.Sprintf(\"refusal site %s carries a non-literal rule; the roster cannot name it\", site))\n215|\t\t\tcontinue\n216|\t\t}\n217|\t\tif _, defensive := defensiveSites[constructor]; defensive {\n218|\t\t\tcontinue\n219|\t\t}\n220|\t\tif only, exempt := platformExempt[siteKey(site, constructor)]; exempt && runtime.GOOS == only {\n221|\t\t\tcontinue\n222|\t\t}\n223|\t\tif _, excused := rootExempt[siteKey(site, constructor)]; excused && privilegedUser() {\n224|\t\t\tcontinue\n225|\t\t}\n226|\t\tif _, exercised := exercisedRefusalSites.Load(site); !exercised {\n227|\t\t\tfailures = append(failures, fmt.Sprintf(\"refusal site %s never fired during the suite\", site))\n228|\t\t}\n229|\t}\n230|\texercisedRefusalSites.Range(func(key, _ any) bool {\n231|\t\tif _, ok := derived[key.(string)]; !ok {\n232|\t\t\tfailures = append(failures, fmt.Sprintf(\"exercised refusal site %s resolves to no derived site\", key.(string)))\n233|\t\t}\n234|\t\treturn true\n235|\t})\n236|\treturn failures\n237|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e1","stream":{"kind":"session","id":"01a07721-ca06-7081-babf-b563190d8d78"},"sequence":203,"recorded_at":1780531400000401,"record_type":"event","durability":"durable","causation_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","run_stream":{"kind":"run","id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd"},"call_id":"call_01a0772218727a0199c3d2a5ec7e989e","text":"Read text file `internal/secprim/classes_test.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"sort\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n14|)\n15|\n16|// derivedExclusionClasses derives the Section 16.2 mandatory-exclusion\n17|// classes from the pinned specification document itself: every body row of\n18|// the Class table in Section 16.2. A class added to or removed from the\n19|// specification fails the roster below instead of passing silently.\n20|func derivedExclusionClasses(t *testing.T) []string {\n21|\tt.Helper()\n22|\tdocument, err := specdoc.Load()\n23|\tif err != nil {\n24|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n25|\t}\n26|\tvar classes []string\n27|\tseen := map[string]bool{}\n28|\tfor number := 1; number <= document.LineCount(); number++ {\n29|\t\trow, ok := document.TableRowAt(number)\n30|\t\tif !ok || row.Header != \"Class\" {\n31|\t\t\tcontinue\n32|\t\t}\n33|\t\tsection, ok := document.SectionID(row.Line)\n34|\t\tif !ok || section != \"16.2\" {\n35|\t\t\tcontinue\n36|\t\t}\n37|\t\tif seen[row.FirstCell] {\n38|\t\t\tcontinue\n39|\t\t}\n40|\t\tseen[row.FirstCell] = true\n41|\t\tclasses = append(classes, row.FirstCell)\n42|\t}\n43|\tif len(classes) == 0 {\n44|\t\tt.Fatal(\"derived no Section 16.2 exclusion classes; the scanner is broken, not the document\")\n45|\t}\n46|\tsort.Strings(classes)\n47|\treturn classes\n48|}\n49|\n50|// exclusionRow pairs one derived Section 16.2 class with its disposition:\n51|// which mechanism keeps that class out of artifacts, and which test\n52|// proves the mechanism. Every derived class carries exactly one row.\n53|type exclusionRow struct {\n54|\tclass       string\n55|\tdisposition string\n56|\twitnesses   []string\n57|}\n58|\n59|// exclusionRows is the reviewed disposition half of the Section 16.2\n60|// census. Dispositions are one of: scrub (the Redact stream arms),\n61|// refuse (a boundary gate), structural (never logged by construction),\n62|// or nopath (no in-repo emission path carries the class — the M0-stage\n63|// bound, proven by TestNoArchiveEmissionPath plus the secret-site\n64|// roster).\n65|func exclusionRows() []exclusionRow {\n66|\treturn []exclusionRow{\n67|\t\t{\n68|\t\t\tclass: \"Provider credentials\",\n69|\t\t\tdisposition: \"scrub for free text (Redact corpus and key=value arms) and refuse for structured \" +\n70|\t\t\t\t\"diagnostics (the axerror excluded-key gate)\",\n71|\t\t\twitnesses: []string{\n72|\t\t\t\t\"secprim.TestRedactSensitivePairs\",\n73|\t\t\t\t\"secprim.TestSecretAxerrorTableRefused\",\n74|\t\t\t},\n75|\t\t},\n76|\t\t{\n77|\t\t\tclass: \"SSH/private identity\",\n78|\t\t\tdisposition: \"scrub for free text (the Redact private-key block arm for key material, corpus and \" +\n79|\t\t\t\t\"key arms for the rest) and refuse for structured diagnostics\",\n80|\t\t\twitnesses: []string{\n81|\t\t\t\t\"secprim.TestRedactPrivateKeyBlocks\",\n82|\t\t\t\t\"secprim.TestSecretAxerrorTableRefused\",\n83|\t\t\t},\n84|\t\t},\n85|\t\t{\n86|\t\t\tclass: \"Environment secrets\",\n87|\t\t\tdisposition: \"scrub for free text and refuse for structured diagnostics; SpawnPlan literals are \" +\n88|\t\t\t\t\"additionally bounded and disjoint by the provhost wire gate, whose secrecy itself is an \" +\n89|\t\t\t\t\"operator obligation no content inspection could prove\",\n90|\t\t\twitnesses: []string{\n91|\t\t\t\t\"secprim.TestRedactCorpusValues\",\n92|\t\t\t\t\"secprim.TestSecretAxerrorTableRefused\",\n93|\t\t\t\t\"provhost.TestDecodeSpawnPlanRefusals\",\n94|\t\t\t},\n95|\t\t},\n96|\t\t{\n97|\t\t\tclass: \"Machine authentication\",\n98|\t\t\tdisposition: \"nopath: no keychain, secret-service, credential-manager, or task-board login-token \" +\n99|\t\t\t\t\"handling exists in this repository, and the secret-site roster proves no secret-named field \" +\n100|\t\t\t\t\"exists outside the dispositioned tables; key-shaped text is still scrubbed where it matches\",\n101|\t\t\twitnesses: []string{\n102|\t\t\t\t\"secprim.TestSecretSiteRosterIsComplete\",\n103|\t\t\t\t\"secprim.TestNoArchiveEmissionPath\",\n104|\t\t\t},\n105|\t\t},\n106|\t\t{\n107|\t\t\tclass: \"Live process identity\",\n108|\t\t\tdisposition: \"nopath for transfer plus structural for diagnostics: PIDs and handles never enter \" +\n109|\t\t\t\t\"Structured Errors because the causal-leak gate refuses cause text verbatim\",\n110|\t\t\twitnesses: []string{\n111|\t\t\t\t\"secprim.TestNoArchiveEmissionPath\",\n112|\t\t\t\t\"axerror.TestCauseNeverReachesTheWire\",\n113|\t\t\t},\n114|\t\t},\n115|\t\t{\n116|\t\t\tclass: \"IPC/runtime\",\n117|\t\t\tdisposition: \"nopath: no socket, pipe, or tmux-server-socket transfer path exists in this \" +\n118|\t\t\t\t\"repository; socket-shaped names in diagnostics are inert text\",\n119|\t\t\twitnesses: []string{\n120|\t\t\t\t\"secprim.TestNoArchiveEmissionPath\",\n121|\t\t\t\t\"secprim.TestSecretSiteRosterIsComplete\",\n122|\t\t\t},\n123|\t\t},\n124|\t\t{\n125|\t\t\tclass: \"TerminalBackend runtime\",\n126|\t\t\tdisposition: \"refuse by vocabulary: bindings, native references, endpoints, tokens, relay \" +\n127|\t\t\t\t\"credentials, and observations are classified sensitive-owner-only or forbidden and never \" +\n128|\t\t\t\t\"replicate as live authority\",\n129|\t\t\twitnesses: []string{\n130|\t\t\t\t\"terminalbackend.TestReplicationClassificationIsClosed\",\n131|\t\t\t},\n132|\t\t},\n133|\t\t{\n134|\t\t\tclass: \"Transient locking\",\n135|\t\t\tdisposition: \"nopath: lock files, WAL/SHM journals, and PID locks have no emission path in this \" +\n136|\t\t\t\t\"repository; the owner-only staging roots they guard are validated by the no-follow gates\",\n137|\t\t\twitnesses: []string{\n138|\t\t\t\t\"secprim.TestNoArchiveEmissionPath\",\n139|\t\t\t\t\"secprim.TestOpenNoFollowDir\",\n140|\t\t\t},\n141|\t\t},\n142|\t\t{\n143|\t\t\tclass: \"Mutable derived indexes\",\n144|\t\t\tdisposition: \"nopath: SQLite projections and provider caches are rebuilt locally, never exported; \" +\n145|\t\t\t\t\"no export path exists to audit\",\n146|\t\t\twitnesses: []string{\n147|\t\t\t\t\"secprim.TestNoArchiveEmissionPath\",\n148|\t\t\t\t\"secprim.TestSecretSiteRosterIsComplete\",\n149|\t\t\t},\n150|\t\t},\n151|\t}\n152|}\n153|\n154|// TestExclusionClassRosterIsComplete requires every derived Section 16.2\n155|// class to carry exactly one disposition row, and every row to resolve to\n156|// a derived class.\n157|func TestExclusionClassRosterIsComplete(t *testing.T) {\n158|\tderived := derivedExclusionClasses(t)\n159|\trows := exclusionRows()\n160|\tseen := map[string]bool{}\n161|\tfor _, row := range rows {\n162|\t\tfound := false\n163|\t\tfor _, class := range derived {\n164|\t\t\tif row.class == class {\n165|\t\t\t\tfound = true\n166|\t\t\t\tbreak\n167|\t\t\t}\n168|\t\t}\n169|\t\tif !found {\n170|\t\t\tt.Fatalf(\"orphaned exclusion row %q: the specification derives no such class\", row.class)\n171|\t\t}\n172|\t\tif seen[row.class] {\n173|\t\t\tt.Fatalf(\"duplicate exclusion row %q\", row.class)\n174|\t\t}\n175|\t\tseen[row.class] = true\n176|\t}\n177|\tvar missing []string\n178|\tfor _, class := range derived {\n179|\t\tif !seen[class] {\n180|\t\t\tmissing = append(missing, class)\n181|\t\t}\n182|\t}\n183|\tif len(missing) > 0 {\n184|\t\tt.Fatalf(\"derived exclusion classes with no disposition:\\n  %s\", strings.Join(missing, \"\\n  \"))\n185|\t}\n186|\tif len(derived) != 9 {\n187|\t\tt.Fatalf(\"derived %d exclusion classes, want the 9 of Section 16.2: %q\", len(derived), derived)\n188|\t}\n189|}\n190|\n191|// TestExclusionWitnessesExist verifies every cited witness names a real\n192|// test, reusing the declaration walk from the site census.\n193|func TestExclusionWitnessesExist(t *testing.T) {\n194|\tt.Parallel()\n195|\tneeded := map[string]map[string]bool{}\n196|\tfor _, row := range exclusionRows() {\n197|\t\tfor _, witness := range row.witnesses {\n198|\t\t\tparts := strings.Split(witness, \".\")\n199|\t\t\tif len(parts) != 2 {\n200|\t\t\t\tt.Fatalf(\"witness %q is not package.Test shaped\", witness)\n201|\t\t\t}\n202|\t\t\tif needed[parts[0]] == nil {\n203|\t\t\t\tneeded[parts[0]] = map[string]bool{}\n204|\t\t\t}\n205|\t\t\tneeded[parts[0]][parts[1]] = true\n206|\t\t}\n207|\t}\n208|\tfor pkg, names := range needed {\n209|\t\tfound := testFuncNames(t, pkg)\n210|\t\tfor name := range names {\n211|\t\t\tif !found[name] {\n212|\t\t\t\tt.Errorf(\"witness %s.%s does not exist; the census cites a ghost\", pkg, name)\n213|\t\t\t}\n214|\t\t}\n215|\t}\n216|}\n217|\n218|// TestNoArchiveEmissionPath proves the nopath dispositions above: no\n219|// production package imports an archive or transfer-emission facility, so\n220|// there is no code path that could carry an excluded class into a bundle.\n221|// The day an archive or transfer writer lands, this test names it and the\n222|// nopath rows must be re-dispositioned.\n223|func TestNoArchiveEmissionPath(t *testing.T) {\n224|\tt.Parallel()\n225|\troot, err := filepath.Abs(filepath.Join(\"..\", \"..\"))\n226|\tif err != nil {\n227|\t\tt.Fatal(err)\n228|\t}\n229|\tforbidden := []string{\"archive/tar\", \"archive/zip\", \"compress/gzip\"}\n230|\tvar violations []string\n231|\tscanned := 0\n232|\tpackages, err := os.ReadDir(filepath.Join(root, \"internal\"))\n233|\tif err != nil {\n234|\t\tt.Fatal(err)\n235|\t}\n236|\tfor _, pkg := range packages {\n237|\t\tif !pkg.IsDir() {\n238|\t\t\tcontinue\n239|\t\t}\n240|\t\tentries, err := os.ReadDir(filepath.Join(root, \"internal\", pkg.Name()))\n241|\t\tif err != nil {\n242|\t\t\tt.Fatal(err)\n243|\t\t}\n244|\t\tfor _, entry := range entries {\n245|\t\t\tname := entry.Name()\n246|\t\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n247|\t\t\t\tcontinue\n248|\t\t\t}\n249|\t\t\tcontents, err := os.ReadFile(filepath.Join(root, \"internal\", pkg.Name(), name))\n250|\t\t\tif err != nil {\n251|\t\t\t\tt.Fatal(err)\n252|\t\t\t}\n253|\t\t\tscanned++\n254|\t\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), name, contents, parser.ImportsOnly)\n255|\t\t\tif err != nil {\n256|\t\t\t\tt.Fatal(err)\n257|\t\t\t}\n258|\t\t\tfor _, imported := range syntax.Imports {\n259|\t\t\t\tpath := strings.Trim(imported.Path.Value, `\"`)\n260|\t\t\t\tfor _, denied := range forbidden {\n261|\t\t\t\t\tif path == denied {\n262|\t\t\t\t\t\tviolations = append(violations, \"internal/\"+pkg.Name()+\"/\"+name+\" imports \"+path)\n263|\t\t\t\t\t}\n264|\t\t\t\t}\n265|\t\t\t}\n266|\t\t}\n267|\t}\n268|\tif scanned == 0 {\n269|\t\tt.Fatal(\"scanned no production sources; the check is blind\")\n270|\t}\n271|\tif len(violations) > 0 {\n272|\t\tt.Fatalf(\"archive emission paths exist; nopath dispositions must be re-proven:\\n  %s\", strings.Join(violations, \"\\n  \"))\n273|\t}\n274|}\n275|\n276|// Keep the AST imports referenced for the emission-path walk above.\n277|var _ = ast.Walk","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e3","stream":{"kind":"session","id":"01a07721-ca06-7081-babf-b563190d8d78"},"sequence":204,"recorded_at":1780531400000403,"record_type":"event","durability":"durable","causation_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","run_stream":{"kind":"run","id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd"},"call_id":"call_01a0772219347bf1b171725f2b72c140","text":"Read text file `internal/secprim/fifo_unix_test.go`.\n1|//go:build !windows\n2|\n3|package secprim\n4|\n5|import (\n6|\t\"syscall\"\n7|\t\"testing\"\n8|\n9|\t\"golang.org/x/sys/unix\"\n10|)\n11|\n12|// makeFifo creates a named pipe for the special-file gate. It lives in a\n13|// unix-tagged file because syscall.Mkfifo does not compile on Windows.\n14|func makeFifo(t *testing.T, path string) {\n15|\tt.Helper()\n16|\tif err := syscall.Mkfifo(path, 0o600); err != nil {\n17|\t\tt.Fatal(err)\n18|\t}\n19|}\n20|\n21|// privilegedUser reports whether permission refusals are untestable\n22|// because the process runs as root, which bypasses mode bits.\n23|func privilegedUser() bool {\n24|\treturn unix.Geteuid() == 0\n25|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
