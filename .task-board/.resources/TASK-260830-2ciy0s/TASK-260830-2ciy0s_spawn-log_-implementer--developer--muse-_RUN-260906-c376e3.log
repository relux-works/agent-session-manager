{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c51f","stream":{"kind":"session","id":"01a07721-ca06-7081-babf-b563190d8d78"},"sequence":234,"recorded_at":1780531400000463,"record_type":"event","durability":"durable","causation_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","run_stream":{"kind":"run","id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd"},"task_stream":{"kind":"task","id":"76337a85-b904-4193-a9c4-14449924e681"},"task_id":"76337a85-b904-4193-a9c4-14449924e681","event":{"kind":"output","task_id":"76337a85-b904-4193-a9c4-14449924e681","chunk":"Read text file `internal/secprim/render_test.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|\t\"unicode/utf8\"\n7|)\n8|\n9|func TestEscapeForTerminal(t *testing.T) {\n10|\tt.Parallel()\n11|\tcases := []struct {\n12|\t\tname  string\n13|\t\tinput string\n14|\t\twant  string\n15|\t}{\n16|\t\t{\"plain\", \"hello world\", \"hello world\"},\n17|\t\t{\"newline kept\", \"a\\nb\", \"a\\nb\"},\n18|\t\t{\"tab kept\", \"a\\tb\", \"a\\tb\"},\n19|\t\t{\"csi neutralized\", \"\\x1b[31mred\\x1b[0m\", \"␛[31mred␛[0m\"},\n20|\t\t{\"osc neutralized\", \"\\x1b]8;;https://evil\\x07link\", \"␛]8;;https://evil�link\"},\n21|\t\t{\"bare esc\", \"a\\x1bb\", \"a␛b\"},\n22|\t\t{\"single byte csi\", \"a\\x9bb\", \"a�b\"},\n23|\t\t{\"c0 nul\", \"a\\x00b\", \"a�b\"},\n24|\t\t{\"c0 bell\", \"a\\x07b\", \"a�b\"},\n25|\t\t{\"c0 cr\", \"a\\rb\", \"a�b\"},\n26|\t\t{\"del\", \"a\\x7fb\", \"a�b\"},\n27|\t\t{\"c1\", \"a\\x80b\", \"a�b\"},\n28|\t\t{\"bidi override\", \"a\\u202eb\", \"a�b\"},\n29|\t\t{\"bidi isolate\", \"a\\u2066b\\u2067c\", \"a�b�c\"},\n30|\t\t{\"directional mark\", \"a\\u200fb\", \"a�b\"},\n31|\t\t{\"zero width space\", \"a\\u200bb\", \"a�b\"},\n32|\t\t{\"zero width joiner\", \"a\\u200db\", \"a�b\"},\n33|\t\t{\"bom\", \"a\\ufeffb\", \"a�b\"},\n34|\t\t{\"invalid utf8\", \"a\\xffb\", \"a�b\"},\n35|\t\t{\"unicode kept\", \"ünïcodé 名前 privet\", \"ünïcodé 名前 privet\"},\n36|\t\t{\"symbol for escape kept\", \"a␛b\", \"a␛b\"},\n37|\t}\n38|\tfor _, kase := range cases {\n39|\t\tt.Run(kase.name, func(t *testing.T) {\n40|\t\t\tt.Parallel()\n41|\t\t\tif got := EscapeForTerminal(kase.input); got != kase.want {\n42|\t\t\t\tt.Fatalf(\"EscapeForTerminal(%q) = %q, want %q\", kase.input, got, kase.want)\n43|\t\t\t}\n44|\t\t})\n45|\t}\n46|}\n47|\n48|// TestEscapeForTerminalOutputBytes is the output invariant every refusal\n49|// class above serves: no ESC byte, no C0 byte except newline and tab, no\n50|// DEL, and valid UTF-8. It sweeps a hostile corpus so a dropped class\n51|// fails here even if its table row is deleted with it.\n52|func TestEscapeForTerminalOutputBytes(t *testing.T) {\n53|\tt.Parallel()\n54|\tvar corpus strings.Builder\n55|\tfor character := 0; character < 0xa0; character++ {\n56|\t\tcorpus.WriteRune(rune(character))\n57|\t}\n58|\tcorpus.WriteString(\"\\u202e \\u2066\\u2067‎\\u200f\\u061c\\u200b‌\\u200d\\ufeff\\x1b[0m\\x1b]0;title\\x07\\x9b0m\\xff\\xfe\")\n59|\tescaped := EscapeForTerminal(corpus.String())\n60|\tif !utf8.ValidString(escaped) {\n61|\t\tt.Fatal(\"escaped output is not valid UTF-8\")\n62|\t}\n63|\tfor _, character := range escaped {\n64|\t\tswitch {\n65|\t\tcase character == '\\n' || character == '\\t':\n66|\t\tcase character < 0x20 || character == 0x7f || character >= 0x80 && character <= 0x9f:\n67|\t\t\tt.Fatalf(\"escaped output carries control %U\", character)\n68|\t\tcase character == 0x1b:\n69|\t\t\tt.Fatal(\"escaped output carries ESC\")\n70|\t\t}\n71|\t}\n72|\tfor _, forbidden := range []rune{0x202a, 0x202b, 0x202c, 0x202d, 0x202e, 0x2066, 0x2067, 0x2068, 0x2069, 0x200e, 0x200f, 0x061c, 0x200b, 0x200c, 0x200d, 0xfeff} {\n73|\t\tif strings.ContainsRune(escaped, forbidden) {\n74|\t\t\tt.Fatalf(\"escaped output carries %U\", forbidden)\n75|\t\t}\n76|\t}\n77|}\n78|\n79|// TestEscapeForTerminalIsIdempotent proves double-wiring a render path\n80|// cannot corrupt text: every emitted symbol is a fixed point.\n81|func TestEscapeForTerminalIsIdempotent(t *testing.T) {\n82|\tt.Parallel()\n83|\tinputs := []string{\n84|\t\t\"plain\", \"\\x1b[31mred\\x1b[0m\", \"a\\u202eb\\u200bc\", \"a\\x00b\\x7f\\x9b\", \"ünïcodé\",\n85|\t\t\"␛ already visible\", \"� already neutral\",\n86|\t}\n87|\tfor _, input := range inputs {\n88|\t\tonce := EscapeForTerminal(input)\n89|\t\tif twice := EscapeForTerminal(once); twice != once {\n90|\t\t\tt.Errorf(\"EscapeForTerminal is not idempotent on %q: %q then %q\", input, once, twice)\n91|\t\t}\n92|\t}\n93|}\n94|\n95|func TestRenderForTerminal(t *testing.T) {\n96|\tt.Parallel()\n97|\t// Scrubbing runs before escaping: a secret containing an escape\n98|\t// sequence is removed as a secret, not merely neutralized.\n99|\tgot := RenderForTerminal(\"token=hunter2-hunter \\x1b[1m\", []string{\"hunter2-hunter\"})\n100|\twant := \"token=[redacted] ␛[1m\"\n101|\tif got != want {\n102|\t\tt.Fatalf(\"RenderForTerminal = %q, want %q\", got, want)\n103|\t}\n104|\tif got := RenderForTerminal(\"plain\", nil); got != \"plain\" {\n105|\t\tt.Fatalf(\"RenderForTerminal(plain) = %q\", got)\n106|\t}\n107|\tonce := RenderForTerminal(\"password=x \\x07\", nil)\n108|\tif twice := RenderForTerminal(once, nil); twice != once {\n109|\t\tt.Fatalf(\"RenderForTerminal is not idempotent: %q then %q\", once, twice)\n110|\t}\n111|}"}}}
