{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c417","stream":{"kind":"session","id":"01a07721-ca06-7081-babf-b563190d8d78"},"sequence":102,"recorded_at":1780531400000199,"record_type":"event","durability":"durable","causation_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","run_stream":{"kind":"run","id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd"},"task_stream":{"kind":"task","id":"551d4d74-ad60-444b-8018-8ed0998381e6"},"task_id":"551d4d74-ad60-444b-8018-8ed0998381e6","event":{"kind":"output","task_id":"551d4d74-ad60-444b-8018-8ed0998381e6","chunk":"Read text file `internal/secprim/open_nofollow_unix.go`.\n1|//go:build !windows\n2|\n3|package secprim\n4|\n5|import (\n6|\t\"os\"\n7|\n8|\t\"golang.org/x/sys/unix\"\n9|)\n10|\n11|// openNoFollow opens path read-only without following a trailing symlink:\n12|// O_NOFOLLOW makes the open itself fail on a symlink target instead of\n13|// traversing it. O_CLOEXEC keeps the descriptor out of any spawned child.\n14|func openNoFollow(path string) (*os.File, error) {\n15|\treturn os.OpenFile(path, os.O_RDONLY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)\n16|}\n17|\n18|// openNoFollowDir opens a directory read-only without following a trailing\n19|// symlink, returning a handle that pins the directory for validation walks\n20|// (Fstat, ReadDirnames) instead of re-resolving its name.\n21|func openNoFollowDir(path string) (*os.File, error) {\n22|\treturn os.OpenFile(path, os.O_RDONLY|unix.O_NOFOLLOW|unix.O_CLOEXEC|unix.O_DIRECTORY, 0)\n23|}"}}}
