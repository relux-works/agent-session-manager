{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c695","stream":{"kind":"session","id":"01a07721-ca06-7081-babf-b563190d8d78"},"sequence":421,"recorded_at":1780531400000837,"record_type":"event","durability":"durable","causation_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","run_stream":{"kind":"run","id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd"},"task_stream":{"kind":"task","id":"ff064a8a-8731-4f15-bc19-52d143785191"},"task_id":"ff064a8a-8731-4f15-bc19-52d143785191","event":{"kind":"output","task_id":"ff064a8a-8731-4f15-bc19-52d143785191","chunk":"Read text file `internal/provhost/env_agreement_test.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n8|)\n9|\n10|// TestEnvNameAgreementIsBidirectional pins the shared environment-name\n11|// grammar from both directions: validEnvName (the Section 5.1 SpawnPlan\n12|// call sites) must equal secprim.IsEnvName (the launch-allowlist owner)\n13|// on every swept name. A one-directional test — mine refuses what theirs\n14|// refuses — cannot see an over-permissive divergence, so this test\n15|// asserts equality, not implication, over an exhaustive small alphabet\n16|// plus length boundaries and hostile shapes.\n17|func TestEnvNameAgreementIsBidirectional(t *testing.T) {\n18|\tt.Parallel()\n19|\talphabet := []byte{'a', 'Z', '0', '_', '-', '.', ' ', '=', 0xe9}\n20|\tvar names []string\n21|\tnames = append(names, \"\")\n22|\tvar build func(prefix []byte, depth int)\n23|\tbuild = func(prefix []byte, depth int) {\n24|\t\tif depth == 3 {\n25|\t\t\treturn\n26|\t\t}\n27|\t\tfor _, letter := range alphabet {\n28|\t\t\tnext := append(append([]byte(nil), prefix...), letter)\n29|\t\t\tnames = append(names, string(next))\n30|\t\t\tbuild(next, depth+1)\n31|\t\t}\n32|\t}\n33|\tbuild(nil, 0)\n34|\tnames = append(names,\n35|\t\tstrings.Repeat(\"x\", 127),\n36|\t\tstrings.Repeat(\"x\", 128),\n37|\t\tstrings.Repeat(\"x\", 129),\n38|\t\t\"_\"+strings.Repeat(\"y\", 127),\n39|\t\t\"9\"+strings.Repeat(\"y\", 127),\n40|\t\t\"A\\nB\", \"A\\x00B\", \"AX_CONFIG\", \"PATH\", \"a-b\", \"a.b\", \"a=b\",\n41|\t)\n42|\tmismatches := 0\n43|\tfor _, name := range names {\n44|\t\tif validEnvName(name) != secprim.IsEnvName(name) {\n45|\t\t\tmismatches++\n46|\t\t\tt.Errorf(\"validEnvName(%q) != secprim.IsEnvName: the grammar drifted\", name)\n47|\t\t}\n48|\t}\n49|\tif mismatches != 0 {\n50|\t\tt.Fatalf(\"%d grammar mismatches; the shared name rule drifted\", mismatches)\n51|\t}\n52|\tt.Logf(\"agreement holds over %d swept names\", len(names))\n53|}"}}}
