{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c527","stream":{"kind":"session","id":"01a07721-ca06-7081-babf-b563190d8d78"},"sequence":238,"recorded_at":1780531400000471,"record_type":"event","durability":"durable","causation_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","run_stream":{"kind":"run","id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd"},"call_id":"call_01a0772221127661874ab321d1a781f8","text":"Read text file `internal/secprim/path_test.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"runtime\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// requireRefusal asserts the full refusal rendering: kind, rule, and\n15|// detail. A code or suffix several gates share proves nothing about which\n16|// gate fired, so witnesses pin the whole string.\n17|func requireRefusal(t *testing.T, err error, kind error, want string) {\n18|\tt.Helper()\n19|\tif err == nil {\n20|\t\tt.Fatalf(\"admitted; want refusal %q\", want)\n21|\t}\n22|\tif !errors.Is(err, kind) {\n23|\t\tt.Fatalf(\"error %v does not match kind %v; want %q\", err, kind, want)\n24|\t}\n25|\tif err.Error() != want {\n26|\t\tt.Fatalf(\"refusal = %q, want %q\", err.Error(), want)\n27|\t}\n28|}\n29|\n30|// requireRefusalPrefix pins the stable rule prefix of a cause-carrying\n31|// refusal. The appended OS cause text differs by platform, so only the\n32|// prefix is pinned here; the cause itself is proven with errors.Is at the\n33|// call site.\n34|func requireRefusalPrefix(t *testing.T, err error, kind error, wantPrefix string) {\n35|\tt.Helper()\n36|\tif err == nil {\n37|\t\tt.Fatalf(\"admitted; want refusal with prefix %q\", wantPrefix)\n38|\t}\n39|\tif !errors.Is(err, kind) {\n40|\t\tt.Fatalf(\"error %v does not match kind %v; want prefix %q\", err, kind, wantPrefix)\n41|\t}\n42|\tif !strings.HasPrefix(err.Error(), wantPrefix) {\n43|\t\tt.Fatalf(\"refusal = %q, want prefix %q\", err.Error(), wantPrefix)\n44|\t}\n45|}\n46|\n47|func TestCheckMemberPathAdmits(t *testing.T) {\n48|\tt.Parallel()\n49|\tmembers := []string{\n50|\t\t\"a\", \"a/b/c\", \"dir.with.dots/file\", \"100%.txt\", \"a%20b\",\n51|\t\t\"a b/c d\", \"ünïcodé/名前\", \".hidden\", \"a/.hidden/b\",\n52|\t\t// A colon is legal on POSIX past the scalar drive-prefix rule\n53|\t\t// (\"ab:c\" is not drive-shaped); the ADS rule is Windows-only.\n54|\t\t\"ab:c\",\n55|\t}\n56|\tfor _, platform := range []scalar.Platform{scalar.PlatformMacOS, scalar.PlatformLinux, scalar.PlatformWSL2} {\n57|\t\tfor _, member := range members {\n58|\t\t\tif err := CheckMemberPath(platform, member); err != nil {\n59|\t\t\t\tt.Errorf(\"CheckMemberPath(%s, %q) = %v, want admission\", platform, member, err)\n60|\t\t\t}\n61|\t\t}\n62|\t}\n63|\twindowsMembers := []string{\"a\", \"a/b/c\", \"100%.txt\", \"a%20b\", \".hidden\"}\n64|\tfor _, member := range windowsMembers {\n65|\t\tif err := CheckMemberPath(scalar.PlatformWindows, member); err != nil {\n66|\t\t\tt.Errorf(\"CheckMemberPath(windows, %q) = %v, want admission\", member, err)\n67|\t\t}\n68|\t}\n69|}\n70|\n71|func TestCheckMemberPathRefuses(t *testing.T) {\n72|\tt.Parallel()\n73|\tcases := []struct {\n74|\t\tname     string\n75|\t\tplatform scalar.Platform\n76|\t\tmember   string\n77|\t\twant     string\n78|\t}{\n79|\t\t{\"empty\", scalar.PlatformLinux, \"\", \"secprim unsafe path: member grammar: \"},\n80|\t\t{\"dot\", scalar.PlatformLinux, \".\", \"secprim unsafe path: member grammar: .\"},\n81|\t\t{\"parent\", scalar.PlatformLinux, \"..\", \"secprim unsafe path: member grammar: ..\"},\n82|\t\t{\"nested parent\", scalar.PlatformLinux, \"a/../b\", \"secprim unsafe path: member grammar: a/../b\"},\n83|\t\t{\"nested dot\", scalar.PlatformLinux, \"a/./b\", \"secprim unsafe path: member grammar: a/./b\"},\n84|\t\t{\"empty segment\", scalar.PlatformLinux, \"a//b\", \"secprim unsafe path: member grammar: a//b\"},\n85|\t\t{\"absolute\", scalar.PlatformLinux, \"/abs\", \"secprim unsafe path: member grammar: /abs\"},\n86|\t\t{\"trailing slash\", scalar.PlatformLinux, \"a/\", \"secprim unsafe path: member grammar: a/\"},\n87|\t\t{\"backslash\", scalar.PlatformLinux, `a\\b`, `secprim unsafe path: member grammar: a\\b`},\n88|\t\t{\"nul\", scalar.PlatformLinux, \"a\\x00b\", \"secprim unsafe path: member grammar: a\\x00b\"},\n89|\t\t{\"drive\", scalar.PlatformLinux, \"c:x\", \"secprim unsafe path: member grammar: c:x\"},\n90|\t\t{\"encoded slash\", scalar.PlatformLinux, \"a%2fb\", \"secprim unsafe path: member grammar: a%2fb\"},\n91|\t\t{\"encoded slash upper\", scalar.PlatformLinux, \"a%2Fb\", \"secprim unsafe path: member grammar: a%2Fb\"},\n92|\t\t{\"encoded backslash\", scalar.PlatformLinux, \"a%5cb\", \"secprim unsafe path: member grammar: a%5cb\"},\n93|\t\t{\"double-encoded slash\", scalar.PlatformLinux, \"a%252fb\", \"secprim unsafe path: member grammar: a%252fb\"},\n94|\t\t{\"encoded dot\", scalar.PlatformLinux, \"a%2e%2e/b\", \"secprim unsafe path: member encoded dot: a%2e%2e/b\"},\n95|\t\t{\"encoded dot single\", scalar.PlatformLinux, \"%2e\", \"secprim unsafe path: member encoded dot: %2e\"},\n96|\t\t{\"encoded dot upper\", scalar.PlatformLinux, \"a%2E/b\", \"secprim unsafe path: member encoded dot: a%2E/b\"},\n97|\t\t{\"double-encoded dot\", scalar.PlatformLinux, \"a%252e/b\", \"secprim unsafe path: member encoded dot: a%252e/b\"},\n98|\t\t{\"overlong separator\", scalar.PlatformLinux, \"a%c0%afb\", \"secprim unsafe path: member overlong separator: a%c0%afb\"},\n99|\t\t{\"overlong separator upper\", scalar.PlatformLinux, \"a%C0%AFb\", \"secprim unsafe path: member overlong separator: a%C0%AFb\"},\n100|\t\t{\"windows ads\", scalar.PlatformWindows, \"ab:c\", \"secprim unsafe path: member alternate stream: ab:c\"},\n101|\t\t{\"windows ads nested\", scalar.PlatformWindows, \"a/b:c/d\", \"secprim unsafe path: member alternate stream: a/b:c/d\"},\n102|\t\t{\"windows drive\", scalar.PlatformWindows, \"a:b\", \"secprim unsafe path: member grammar: a:b\"},\n103|\t\t{\"posix drive\", scalar.PlatformLinux, \"a:b\", \"secprim unsafe path: member grammar: a:b\"},\n104|\t\t{\"windows con\", scalar.PlatformWindows, \"con\", \"secprim unsafe path: member reserved device name: con\"},\n105|\t\t{\"windows con upper\", scalar.PlatformWindows, \"CON\", \"secprim unsafe path: member reserved device name: CON\"},\n106|\t\t{\"windows con ext\", scalar.PlatformWindows, \"con.txt\", \"secprim unsafe path: member reserved device name: con.txt\"},\n107|\t\t{\"windows lpt\", scalar.PlatformWindows, \"dir/lpt1\", \"secprim unsafe path: member reserved device name: dir/lpt1\"},\n108|\t\t{\"windows com\", scalar.PlatformWindows, \"com9.log\", \"secprim unsafe path: member reserved device name: com9.log\"},\n109|\t\t{\"windows trailing dot\", scalar.PlatformWindows, \"a./b\", \"secprim unsafe path: member trailing dot or space: a./b\"},\n110|\t\t{\"windows trailing space\", scalar.PlatformWindows, \"a /b\", \"secprim unsafe path: member trailing dot or space: a /b\"},\n111|\t\t{\"windows backslash\", scalar.PlatformWindows, `a\\b`, `secprim unsafe path: member grammar: a\\b`},\n112|\t\t{\"windows absolute\", scalar.PlatformWindows, `C:\\x`, `secprim unsafe path: member grammar: C:\\x`},\n113|\t}\n114|\tfor _, kase := range cases {\n115|\t\tt.Run(kase.name, func(t *testing.T) {\n116|\t\t\tt.Parallel()\n117|\t\t\terr := CheckMemberPath(kase.platform, kase.member)\n118|\t\t\trequireRefusal(t, err, ErrUnsafePath, kase.want)\n119|\t\t})\n120|\t}\n121|}\n122|\n123|func TestCheckMemberPathTruncatesLongMembers(t *testing.T) {\n124|\tt.Parallel()\n125|\tmember := strings.Repeat(\"a\", 40) + \"/../\" + strings.Repeat(\"b\", 40)\n126|\terr := CheckMemberPath(scalar.PlatformLinux, member)\n127|\trequireRefusal(t, err, ErrUnsafePath, \"secprim unsafe path: member grammar: \"+member[:64]+\"...\")\n128|}\n129|\n130|func TestGuardResolve(t *testing.T) {\n131|\tt.Parallel()\n132|\tguard, err := NewGuard(\"/stage/root\", scalar.PlatformLinux, nil)\n133|\tif err != nil {\n134|\t\tt.Fatalf(\"NewGuard = %v\", err)\n135|\t}\n136|\tfor member, want := range map[string]string{\n137|\t\t\"a\":     \"/stage/root/a\",\n138|\t\t\"a/b/c\": \"/stage/root/a/b/c\",\n139|\t} {\n140|\t\tgot, err := guard.Resolve(member)\n141|\t\tif err != nil {\n142|\t\t\tt.Errorf(\"Resolve(%q) = %v\", member, err)\n143|\t\t\tcontinue\n144|\t\t}\n145|\t\tif got != want {\n146|\t\t\tt.Errorf(\"Resolve(%q) = %q, want %q\", member, got, want)\n147|\t\t}\n148|\t}\n149|\tif _, err := NewGuard(\"relative/root\", scalar.PlatformLinux, nil); err == nil {\n150|\t\tt.Error(\"NewGuard(relative) admitted; the root must be absolute\")\n151|\t} else {\n152|\t\trequireRefusal(t, err, ErrUnsafePath, \"secprim unsafe path: guard root: relative/root\")\n153|\t}\n154|\twindows, err := NewGuard(`C:\\stage`, scalar.PlatformWindows, nil)\n155|\tif err != nil {\n156|\t\tt.Fatalf(\"NewGuard windows = %v\", err)\n157|\t}\n158|\tgot, err := windows.Resolve(\"a/b\")\n159|\tif err != nil {\n160|\t\tt.Fatalf(\"Resolve windows = %v\", err)\n161|\t}\n162|\tif got != `C:\\stage\\a\\b` {\n163|\t\tt.Fatalf(\"Resolve windows = %q, want native separators\", got)\n164|\t}\n165|\tunc, err := NewGuard(`\\\\server\\share`, scalar.PlatformWindows, nil)\n166|\tif err != nil {\n167|\t\tt.Fatalf(\"NewGuard UNC = %v\", err)\n168|\t}\n169|\tgot, err = unc.Resolve(\"a/b\")\n170|\tif err != nil {\n171|\t\tt.Fatalf(\"Resolve UNC = %v\", err)\n172|\t}\n173|\tif got != `\\\\server\\share\\a\\b` {\n174|\t\tt.Fatalf(\"Resolve UNC = %q, want the share preserved\", got)\n175|\t}\n176|}\n177|\n178|func TestGuardManagedSet(t *testing.T) {\n179|\tt.Parallel()\n180|\topen, err := NewGuard(\"/stage\", scalar.PlatformLinux, nil)\n181|\tif err != nil {\n182|\t\tt.Fatal(err)\n183|\t}\n184|\tif _, err := open.Resolve(\"anything/goes\"); err != nil {\n185|\t\tt.Fatalf(\"nil managed set refused a member: %v\", err)\n186|\t}\n187|\tempty, err := NewGuard(\"/stage\", scalar.PlatformLinux, []string{})\n188|\tif err != nil {\n189|\t\tt.Fatal(err)\n190|\t}\n191|\t_, err = empty.Resolve(\"a\")\n192|\trequireRefusal(t, err, ErrUnsafePath, \"secprim unsafe path: member unmanaged: a\")\n193|\texact, err := NewGuard(\"/stage\", scalar.PlatformLinux, []string{\"a/b\"})\n194|\tif err != nil {\n195|\t\tt.Fatal(err)\n196|\t}\n197|\tif _, err := exact.Resolve(\"a/b\"); err != nil {\n198|\t\tt.Fatalf(\"managed member refused: %v\", err)\n199|\t}\n200|\t_, err = exact.Resolve(\"a/c\")\n201|\trequireRefusal(t, err, ErrUnsafePath, \"secprim unsafe path: member unmanaged: a/c\")\n202|}\n203|\n204|// TestGuardPrefixCheckIsLoadBearing is the structural tripwire for the\n205|// defensive joined-prefix conjunct in Resolve: the member grammar refuses\n206|// every parent segment, so no admitted member can escape the root, and\n207|// this test proves that property over a generated hostile corpus rather\n208|// than trusting the grammar. If the grammar ever weakens, an escaped join\n209|// reddens here first.\n210|func TestGuardPrefixCheckIsLoadBearing(t *testing.T) {\n211|\tt.Parallel()\n212|\tsegments := []string{\"a\", \".\", \"..\", \"\", \"b c\", \"%2e%2e\", \"%2f\", \"x\"}\n213|\tguard, err := NewGuard(\"/stage/root\", scalar.PlatformLinux, nil)\n214|\tif err != nil {\n215|\t\tt.Fatal(err)\n216|\t}\n217|\tescaped := 0\n218|\tadmitted := 0\n219|\tvar build func(depth int, current string)\n220|\tbuild = func(depth int, current string) {\n221|\t\tif depth == 3 {\n222|\t\t\tgot, err := guard.Resolve(current)\n223|\t\t\tif err != nil {\n224|\t\t\t\treturn\n225|\t\t\t}\n226|\t\t\tadmitted++\n227|\t\t\tif got != \"/stage/root\" && !strings.HasPrefix(got, \"/stage/root/\") {\n228|\t\t\t\tescaped++\n229|\t\t\t\tt.Errorf(\"Resolve(%q) escaped to %q\", current, got)\n230|\t\t\t}\n231|\t\t\treturn\n232|\t\t}\n233|\t\tfor _, segment := range segments {\n234|\t\t\tnext := segment\n235|\t\t\tif current != \"\" {\n236|\t\t\t\tnext = current + \"/\" + segment\n237|\t\t\t}\n238|\t\t\tbuild(depth+1, next)\n239|\t\t}\n240|\t}\n241|\tbuild(0, \"\")\n242|\tif admitted == 0 {\n243|\t\tt.Fatal(\"no generated member was admitted; the corpus proves nothing\")\n244|\t}\n245|\tif escaped != 0 {\n246|\t\tt.Fatalf(\"%d admitted members escaped the root\", escaped)\n247|\t}\n248|\tt.Logf(\"prefix property holds over %d admitted of %d generated members\", admitted, 8*8*8)\n249|}\n250|\n251|func TestDetectCaseCollision(t *testing.T) {\n252|\tt.Parallel()\n253|\tif _, found := DetectCaseCollision([]string{\"README.md\", \"src\"}, \"other\"); found {\n254|\t\tt.Fatal(\"distinct names reported as a collision\")\n255|\t}\n256|\tif _, found := DetectCaseCollision([]string{\"README.md\"}, \"README.md\"); found {\n257|\t\tt.Fatal(\"an identical name is the same file, not a collision\")\n258|\t}\n259|\thit, found := DetectCaseCollision([]string{\"README.md\", \"src\"}, \"readme.MD\")\n260|\tif !found || hit != \"README.md\" {\n261|\t\tt.Fatalf(\"case-fold collision missed: %q %v\", hit, found)\n262|\t}\n263|}\n264|\n265|func TestCheckRegularTarget(t *testing.T) {\n266|\tt.Parallel()\n267|\trequireRefusal(t, CheckRegularTarget(nil), ErrUnsafePath, \"secprim unsafe path: target stat missing: nil file info\")\n268|\troot := t.TempDir()\n269|\tregular := filepath.Join(root, \"file\")\n270|\tif err := os.WriteFile(regular, []byte(\"bytes\"), 0o600); err != nil {\n271|\t\tt.Fatal(err)\n272|\t}\n273|\tinfo, err := os.Lstat(regular)\n274|\tif err != nil {\n275|\t\tt.Fatal(err)\n276|\t}\n277|\tif err := CheckRegularTarget(info); err != nil {\n278|\t\tt.Fatalf(\"regular file refused: %v\", err)\n279|\t}\n280|\tdirInfo, err := os.Lstat(root)\n281|\tif err != nil {\n282|\t\tt.Fatal(err)\n283|\t}\n284|\trequireRefusal(t, CheckRegularTarget(dirInfo), ErrUnsafePath, \"secprim unsafe path: target directory: \"+dirInfo.Name())\n285|\tlink := filepath.Join(root, \"link\")\n286|\tif err := os.Symlink(regular, link); err != nil {\n287|\t\tif runtime.GOOS == \"windows\" {\n288|\t\t\tt.Skipf(\"no symlink privilege on %s\", runtime.GOOS)\n289|\t\t}\n290|\t\tt.Fatal(err)\n291|\t}\n292|\tlinkInfo, err := os.Lstat(link)\n293|\tif err != nil {\n294|\t\tt.Fatal(err)\n295|\t}\n296|\trequireRefusal(t, CheckRegularTarget(linkInfo), ErrUnsafePath, \"secprim unsafe path: target symlink: link\")\n297|\tif runtime.GOOS != \"windows\" {\n298|\t\tfifo := filepath.Join(root, \"fifo\")\n299|\t\tmakeFifo(t, fifo)\n300|\t\tfifoInfo, err := os.Lstat(fifo)\n301|\t\tif err != nil {\n302|\t\t\tt.Fatal(err)\n303|\t\t}\n304|\t\trequireRefusal(t, CheckRegularTarget(fifoInfo), ErrUnsafePath, \"secprim unsafe path: target special file: fifo\")\n305|\t\tnullInfo, err := os.Lstat(\"/dev/null\")\n306|\t\tif err != nil {\n307|\t\t\tt.Fatal(err)\n308|\t\t}\n309|\t\trequireRefusal(t, CheckRegularTarget(nullInfo), ErrUnsafePath, \"secprim unsafe path: target special file: null\")\n310|\t}\n311|}\n312|\n313|func TestOpenNoFollowFile(t *testing.T) {\n314|\tt.Parallel()\n315|\troot := t.TempDir()\n316|\tregular := filepath.Join(root, \"file\")\n317|\tif err := os.WriteFile(regular, []byte(\"payload\"), 0o600); err != nil {\n318|\t\tt.Fatal(err)\n319|\t}\n320|\tfile, err := OpenNoFollowFile(regular)\n321|\tif err != nil {\n322|\t\tt.Fatalf(\"regular file refused: %v\", err)\n323|\t}\n324|\tcontents := make([]byte, 7)\n325|\tif _, err := file.Read(contents); err != nil {\n326|\t\tt.Fatal(err)\n327|\t}\n328|\t_ = file.Close()\n329|\tif string(contents) != \"payload\" {\n330|\t\tt.Fatalf(\"read %q through the no-follow handle\", contents)\n331|\t}\n332|\tsubdir := filepath.Join(root, \"dir\")\n333|\tif err := os.Mkdir(subdir, 0o700); err != nil {\n334|\t\tt.Fatal(err)\n335|\t}\n336|\t_, err = OpenNoFollowFile(subdir)\n337|\trequireRefusal(t, err, ErrUnsafePath, \"secprim unsafe path: target directory: dir\")\n338|\t// Cause-carrying refusals pin the stable prefix, not the OS text: the\n339|\t// errno rendering differs by platform while the rule and target do\n340|\t// not. errors.Is still proves the kind, and errors.Is(err,\n341|\t// fs.ErrNotExist) proves the cause survived.\n342|\t_, err = OpenNoFollowFile(filepath.Join(root, \"missing\"))\n343|\ttarget := filepath.Join(root, \"missing\")\n344|\tif len(target) > 64 {\n345|\t\ttarget = target[:64] + \"...\"\n346|\t}\n347|\trequireRefusalPrefix(t, err, ErrUnsafePath, \"secprim unsafe path: open failed: \"+target)\n348|\tif !errors.Is(err, os.ErrNotExist) {\n349|\t\tt.Fatalf(\"open cause does not wrap ErrNotExist: %v\", err)\n350|\t}\n351|\tlink := filepath.Join(root, \"link\")\n352|\tif err := os.Symlink(regular, link); err != nil {\n353|\t\tif runtime.GOOS == \"windows\" {\n354|\t\t\tt.Skipf(\"no symlink privilege on %s\", runtime.GOOS)\n355|\t\t}\n356|\t\tt.Fatal(err)\n357|\t}\n358|\t_, err = OpenNoFollowFile(link)\n359|\tif err == nil {\n360|\t\tt.Fatal(\"symlink traversed by the no-follow open\")\n361|\t}\n362|\tif !errors.Is(err, ErrUnsafePath) {\n363|\t\tt.Fatalf(\"symlink refusal = %v, want ErrUnsafePath\", err)\n364|\t}\n365|}\n366|\n367|func TestOpenNoFollowDir(t *testing.T) {\n368|\tt.Parallel()\n369|\troot := t.TempDir()\n370|\tdir, err := OpenNoFollowDir(root)\n371|\tif err != nil {\n372|\t\tt.Fatalf(\"directory refused: %v\", err)\n373|\t}\n374|\t_ = dir.Close()\n375|\tregular := filepath.Join(root, \"file\")\n376|\tif err := os.WriteFile(regular, []byte(\"x\"), 0o600); err != nil {\n377|\t\tt.Fatal(err)\n378|\t}\n379|\t_, err = OpenNoFollowDir(regular)\n380|\trequireRefusal(t, err, ErrUnsafePath, \"secprim unsafe path: target directory: file\")\n381|\t_, err = OpenNoFollowDir(filepath.Join(root, \"missing\"))\n382|\tif err == nil || !errors.Is(err, ErrUnsafePath) {\n383|\t\tt.Fatalf(\"missing dir refusal = %v, want ErrUnsafePath\", err)\n384|\t}\n385|\tlink := filepath.Join(root, \"linkdir\")\n386|\tif err := os.Symlink(root, link); err != nil {\n387|\t\tif runtime.GOOS == \"windows\" {\n388|\t\t\tt.Skipf(\"no symlink privilege on %s\", runtime.GOOS)\n389|\t\t}\n390|\t\tt.Fatal(err)\n391|\t}\n392|\t_, err = OpenNoFollowDir(link)\n393|\trequireRefusal(t, err, ErrUnsafePath, \"secprim unsafe path: target symlink: linkdir\")\n394|}\n395|\n396|// TestOpenNoFollowDirRefusesUnreadableDir proves the post-check open arm:\n397|// the directory passes the Lstat fast path but the open itself fails.\n398|// Dropping all mode bits makes the open fail deterministically on unix;\n399|// Windows ACLs do not express a mode-000 directory, so the vector is\n400|// skipped there and the site carries a platform exemption in the audit.\n401|func TestOpenNoFollowDirRefusesUnreadableDir(t *testing.T) {\n402|\tif runtime.GOOS == \"windows\" {\n403|\t\tt.Skip(\"mode-000 directories are not expressible on Windows\")\n404|\t}\n405|\tif privilegedUser() {\n406|\t\tt.Skip(\"root bypasses mode bits, so the open cannot fail\")\n407|\t}\n408|\troot := t.TempDir()\n409|\tlocked := filepath.Join(root, \"locked\")\n410|\tif err := os.Mkdir(locked, 0o700); err != nil {\n411|\t\tt.Fatal(err)\n412|\t}\n413|\tif err := os.Chmod(locked, 0); err != nil {\n414|\t\tt.Fatal(err)\n415|\t}\n416|\tdefer func() { _ = os.Chmod(locked, 0o700) }()\n417|\t_, err := OpenNoFollowDir(locked)\n418|\trequireRefusalPrefix(t, err, ErrUnsafePath, \"secprim unsafe path: open failed: \"+namedTarget(locked))\n419|}\n420|\n421|// errSeamFailure is the forced stat failure the seam returns. It is a\n422|// test-only value and never crosses a production refusal rendering.\n423|var errSeamFailure = errors.New(\"secprim forced stat failure\")\n424|\n425|// namedTarget mirrors the production 64-character member naming bound so\n426|// prefix witnesses pin the truncation contract rather than retyping it.\n427|func namedTarget(path string) string {\n428|\tif len(path) > 64 {\n429|\t\treturn path[:64] + \"...\"\n430|\t}\n431|\treturn path\n432|}\n433|\n434|// TestOpenStatFailureSeam forces the post-open stat-failure arms through\n435|// the production openers: fstat on a live descriptor does not fail on any\n436|// supported platform, so the seam is the only way to prove these arms\n437|// refuse instead of panicking. The seam is restored before returning.\n438|func TestOpenStatFailureSeam(t *testing.T) {\n439|\tprevious := statOpenedFile\n440|\tdefer func() { statOpenedFile = previous }()\n441|\tstatOpenedFile = func(file *os.File) (os.FileInfo, error) {\n442|\t\treturn nil, errSeamFailure\n443|\t}\n444|\troot := t.TempDir()\n445|\tregular := filepath.Join(root, \"file\")\n446|\tif err := os.WriteFile(regular, []byte(\"x\"), 0o600); err != nil {\n447|\t\tt.Fatal(err)\n448|\t}\n449|\t_, err := OpenNoFollowFile(regular)\n450|\trequireRefusalPrefix(t, err, ErrUnsafePath, \"secprim unsafe path: open stat failed: \"+namedTarget(regular))\n451|\t_, err = OpenNoFollowDir(root)\n452|\trequireRefusalPrefix(t, err, ErrUnsafePath, \"secprim unsafe path: open stat failed: \"+namedTarget(root))\n453|\t// A nil stat result without an error is refused as missing, never\n454|\t// dereferenced.\n455|\tstatOpenedFile = func(file *os.File) (os.FileInfo, error) {\n456|\t\treturn nil, nil\n457|\t}\n458|\t_, err = OpenNoFollowFile(regular)\n459|\trequireRefusal(t, err, ErrUnsafePath, \"secprim unsafe path: target stat missing: nil file info\")\n460|\t_, err = OpenNoFollowDir(root)\n461|\trequireRefusal(t, err, ErrUnsafePath, \"secprim unsafe path: target directory: \"+root)\n462|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c529","stream":{"kind":"session","id":"01a07721-ca06-7081-babf-b563190d8d78"},"sequence":239,"recorded_at":1780531400000473,"record_type":"event","durability":"durable","causation_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","run_stream":{"kind":"run","id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd"},"call_id":"call_01a0772221a77c41aaa89ebf64ea733f","text":"Read text file `internal/secprim/render_test.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|\t\"unicode/utf8\"\n7|)\n8|\n9|func TestEscapeForTerminal(t *testing.T) {\n10|\tt.Parallel()\n11|\tcases := []struct {\n12|\t\tname  string\n13|\t\tinput string\n14|\t\twant  string\n15|\t}{\n16|\t\t{\"plain\", \"hello world\", \"hello world\"},\n17|\t\t{\"newline kept\", \"a\\nb\", \"a\\nb\"},\n18|\t\t{\"tab kept\", \"a\\tb\", \"a\\tb\"},\n19|\t\t{\"csi neutralized\", \"\\x1b[31mred\\x1b[0m\", \"␛[31mred␛[0m\"},\n20|\t\t{\"osc neutralized\", \"\\x1b]8;;https://evil\\x07link\", \"␛]8;;https://evil�link\"},\n21|\t\t{\"bare esc\", \"a\\x1bb\", \"a␛b\"},\n22|\t\t{\"single byte csi\", \"a\\x9bb\", \"a�b\"},\n23|\t\t{\"c0 nul\", \"a\\x00b\", \"a�b\"},\n24|\t\t{\"c0 bell\", \"a\\x07b\", \"a�b\"},\n25|\t\t{\"c0 cr\", \"a\\rb\", \"a�b\"},\n26|\t\t{\"del\", \"a\\x7fb\", \"a�b\"},\n27|\t\t{\"c1\", \"a\\x80b\", \"a�b\"},\n28|\t\t{\"bidi override\", \"a\\u202eb\", \"a�b\"},\n29|\t\t{\"bidi isolate\", \"a\\u2066b\\u2067c\", \"a�b�c\"},\n30|\t\t{\"directional mark\", \"a\\u200fb\", \"a�b\"},\n31|\t\t{\"zero width space\", \"a\\u200bb\", \"a�b\"},\n32|\t\t{\"zero width joiner\", \"a\\u200db\", \"a�b\"},\n33|\t\t{\"bom\", \"a\\ufeffb\", \"a�b\"},\n34|\t\t{\"invalid utf8\", \"a\\xffb\", \"a�b\"},\n35|\t\t{\"unicode kept\", \"ünïcodé 名前 privet\", \"ünïcodé 名前 privet\"},\n36|\t\t{\"symbol for escape kept\", \"a␛b\", \"a␛b\"},\n37|\t}\n38|\tfor _, kase := range cases {\n39|\t\tt.Run(kase.name, func(t *testing.T) {\n40|\t\t\tt.Parallel()\n41|\t\t\tif got := EscapeForTerminal(kase.input); got != kase.want {\n42|\t\t\t\tt.Fatalf(\"EscapeForTerminal(%q) = %q, want %q\", kase.input, got, kase.want)\n43|\t\t\t}\n44|\t\t})\n45|\t}\n46|}\n47|\n48|// TestEscapeForTerminalOutputBytes is the output invariant every refusal\n49|// class above serves: no ESC byte, no C0 byte except newline and tab, no\n50|// DEL, and valid UTF-8. It sweeps a hostile corpus so a dropped class\n51|// fails here even if its table row is deleted with it.\n52|func TestEscapeForTerminalOutputBytes(t *testing.T) {\n53|\tt.Parallel()\n54|\tvar corpus strings.Builder\n55|\tfor character := 0; character < 0xa0; character++ {\n56|\t\tcorpus.WriteRune(rune(character))\n57|\t}\n58|\tcorpus.WriteString(\"\\u202e \\u2066\\u2067‎\\u200f\\u061c\\u200b‌\\u200d\\ufeff\\x1b[0m\\x1b]0;title\\x07\\x9b0m\\xff\\xfe\")\n59|\tescaped := EscapeForTerminal(corpus.String())\n60|\tif !utf8.ValidString(escaped) {\n61|\t\tt.Fatal(\"escaped output is not valid UTF-8\")\n62|\t}\n63|\tfor _, character := range escaped {\n64|\t\tswitch {\n65|\t\tcase character == '\\n' || character == '\\t':\n66|\t\tcase character < 0x20 || character == 0x7f || character >= 0x80 && character <= 0x9f:\n67|\t\t\tt.Fatalf(\"escaped output carries control %U\", character)\n68|\t\tcase character == 0x1b:\n69|\t\t\tt.Fatal(\"escaped output carries ESC\")\n70|\t\t}\n71|\t}\n72|\tfor _, forbidden := range []rune{0x202a, 0x202b, 0x202c, 0x202d, 0x202e, 0x2066, 0x2067, 0x2068, 0x2069, 0x200e, 0x200f, 0x061c, 0x200b, 0x200c, 0x200d, 0xfeff} {\n73|\t\tif strings.ContainsRune(escaped, forbidden) {\n74|\t\t\tt.Fatalf(\"escaped output carries %U\", forbidden)\n75|\t\t}\n76|\t}\n77|}\n78|\n79|// TestEscapeForTerminalIsIdempotent proves double-wiring a render path\n80|// cannot corrupt text: every emitted symbol is a fixed point.\n81|func TestEscapeForTerminalIsIdempotent(t *testing.T) {\n82|\tt.Parallel()\n83|\tinputs := []string{\n84|\t\t\"plain\", \"\\x1b[31mred\\x1b[0m\", \"a\\u202eb\\u200bc\", \"a\\x00b\\x7f\\x9b\", \"ünïcodé\",\n85|\t\t\"␛ already visible\", \"� already neutral\",\n86|\t}\n87|\tfor _, input := range inputs {\n88|\t\tonce := EscapeForTerminal(input)\n89|\t\tif twice := EscapeForTerminal(once); twice != once {\n90|\t\t\tt.Errorf(\"EscapeForTerminal is not idempotent on %q: %q then %q\", input, once, twice)\n91|\t\t}\n92|\t}\n93|}\n94|\n95|func TestRenderForTerminal(t *testing.T) {\n96|\tt.Parallel()\n97|\t// Scrubbing runs before escaping: a secret containing an escape\n98|\t// sequence is removed as a secret, not merely neutralized.\n99|\tgot := RenderForTerminal(\"token=hunter2-hunter \\x1b[1m\", []string{\"hunter2-hunter\"})\n100|\twant := \"token=[redacted] ␛[1m\"\n101|\tif got != want {\n102|\t\tt.Fatalf(\"RenderForTerminal = %q, want %q\", got, want)\n103|\t}\n104|\tif got := RenderForTerminal(\"plain\", nil); got != \"plain\" {\n105|\t\tt.Fatalf(\"RenderForTerminal(plain) = %q\", got)\n106|\t}\n107|\tonce := RenderForTerminal(\"password=x \\x07\", nil)\n108|\tif twice := RenderForTerminal(once, nil); twice != once {\n109|\t\tt.Fatalf(\"RenderForTerminal is not idempotent: %q then %q\", once, twice)\n110|\t}\n111|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c52b","stream":{"kind":"session","id":"01a07721-ca06-7081-babf-b563190d8d78"},"sequence":240,"recorded_at":1780531400000475,"record_type":"event","durability":"durable","causation_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","run_stream":{"kind":"run","id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd"},"call_id":"call_01a07722223c70009646b7ab77a4ce4f","text":"Read text file `internal/secprim/env_test.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"reflect\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|)\n8|\n9|func TestIsEnvName(t *testing.T) {\n10|\tt.Parallel()\n11|\tadmitted := []string{\"_\", \"A\", \"a\", \"PATH\", \"AX_CONFIG\", \"a1\", \"_0\", \"HOME\", strings.Repeat(\"x\", 128)}\n12|\tfor _, name := range admitted {\n13|\t\tif !IsEnvName(name) {\n14|\t\t\tt.Errorf(\"IsEnvName(%q) = false, want true\", name)\n15|\t\t}\n16|\t}\n17|\trefused := []string{\n18|\t\t\"\", \"9LIVES\", \"-X\", \"A B\", \"A=B\", \"A:B\", \"a/b\", \"a.b\", \"a-b\",\n19|\t\t\"ünï\", \"A\\nB\", \"A\\x00B\", strings.Repeat(\"x\", 129),\n20|\t}\n21|\tfor _, name := range refused {\n22|\t\tif IsEnvName(name) {\n23|\t\t\tt.Errorf(\"IsEnvName(%q) = true, want false\", name)\n24|\t\t}\n25|\t}\n26|}\n27|\n28|func lookupFixture(variables map[string]string) func(string) (string, bool) {\n29|\treturn func(name string) (string, bool) {\n30|\t\tvalue, ok := variables[name]\n31|\t\treturn value, ok\n32|\t}\n33|}\n34|\n35|func TestBuildEnv(t *testing.T) {\n36|\tt.Parallel()\n37|\tenvironment, err := BuildEnv(\n38|\t\t[]string{\"PATH\", \"HOME\"},\n39|\t\tmap[string]string{\"AX_WORKSPACE\": \"/stage/ws\"},\n40|\t\tlookupFixture(map[string]string{\"PATH\": \"/usr/bin:/bin\", \"HOME\": \"/home/ax\", \"SECRET\": \"nope\"}),\n41|\t)\n42|\tif err != nil {\n43|\t\tt.Fatalf(\"BuildEnv = %v\", err)\n44|\t}\n45|\twant := []string{\"AX_WORKSPACE=/stage/ws\", \"HOME=/home/ax\", \"PATH=/usr/bin:/bin\"}\n46|\tif !reflect.DeepEqual(environment, want) {\n47|\t\tt.Fatalf(\"BuildEnv = %q, want sorted %q\", environment, want)\n48|\t}\n49|}\n50|\n51|func TestBuildEnvSkipsAbsentNames(t *testing.T) {\n52|\tt.Parallel()\n53|\t// An unset variable is a legitimate absence: the build skips it\n54|\t// instead of failing or substituting a default.\n55|\tenvironment, err := BuildEnv([]string{\"MISSING\"}, nil, lookupFixture(nil))\n56|\tif err != nil {\n57|\t\tt.Fatalf(\"BuildEnv = %v\", err)\n58|\t}\n59|\tif len(environment) != 0 {\n60|\t\tt.Fatalf(\"BuildEnv = %q, want an empty environment\", environment)\n61|\t}\n62|}\n63|\n64|func TestBuildEnvRefuses(t *testing.T) {\n65|\tt.Parallel()\n66|\tcases := []struct {\n67|\t\tname     string\n68|\t\tallowed  []string\n69|\t\tliterals map[string]string\n70|\t\tlookup   func(string) (string, bool)\n71|\t\twant     string\n72|\t}{\n73|\t\t{\n74|\t\t\tname: \"bad allowed name\", allowed: []string{\"9X\"},\n75|\t\t\tliterals: nil, lookup: lookupFixture(nil),\n76|\t\t\twant: \"secprim unsafe environment: env name: 9X\",\n77|\t\t},\n78|\t\t{\n79|\t\t\tname: \"duplicate allowed\", allowed: []string{\"A\", \"A\"},\n80|\t\t\tliterals: nil, lookup: lookupFixture(nil),\n81|\t\t\twant: \"secprim unsafe environment: env allowlist duplicate: A\",\n82|\t\t},\n83|\t\t{\n84|\t\t\tname: \"bad literal key\", allowed: nil,\n85|\t\t\tliterals: map[string]string{\"a-b\": \"x\"}, lookup: lookupFixture(nil),\n86|\t\t\twant: \"secprim unsafe environment: env name: a-b\",\n87|\t\t},\n88|\t\t{\n89|\t\t\tname: \"literal collides\", allowed: []string{\"FOO\"},\n90|\t\t\tliterals: map[string]string{\"FOO\": \"x\"}, lookup: lookupFixture(map[string]string{\"FOO\": \"y\"}),\n91|\t\t\twant: \"secprim unsafe environment: env literal collision: FOO\",\n92|\t\t},\n93|\t\t{\n94|\t\t\tname: \"inherited NUL\", allowed: []string{\"FOO\"},\n95|\t\t\tliterals: nil, lookup: lookupFixture(map[string]string{\"FOO\": \"a\\x00b\"}),\n96|\t\t\twant: \"secprim unsafe environment: env value NUL: FOO\",\n97|\t\t},\n98|\t\t{\n99|\t\t\tname: \"literal NUL\", allowed: nil,\n100|\t\t\tliterals: map[string]string{\"FOO\": \"a\\x00b\"}, lookup: lookupFixture(nil),\n101|\t\t\twant: \"secprim unsafe environment: env value NUL: FOO\",\n102|\t\t},\n103|\t\t{\n104|\t\t\tname: \"literal encoding\", allowed: nil,\n105|\t\t\tliterals: map[string]string{\"FOO\": \"a\\xffb\"}, lookup: lookupFixture(nil),\n106|\t\t\twant: \"secprim unsafe environment: env value encoding: FOO\",\n107|\t\t},\n108|\t\t{\n109|\t\t\tname: \"inherited encoding\", allowed: []string{\"FOO\"},\n110|\t\t\tliterals: nil, lookup: lookupFixture(map[string]string{\"FOO\": \"a\\xffb\"}),\n111|\t\t\twant: \"secprim unsafe environment: env value encoding: FOO\",\n112|\t\t},\n113|\t\t{\n114|\t\t\tname: \"nil lookup\", allowed: nil,\n115|\t\t\tliterals: nil, lookup: nil,\n116|\t\t\twant: \"secprim unsafe environment: env lookup missing: no parent environment reader\",\n117|\t\t},\n118|\t}\n119|\tfor _, kase := range cases {\n120|\t\tt.Run(kase.name, func(t *testing.T) {\n121|\t\t\tt.Parallel()\n122|\t\t\t_, err := BuildEnv(kase.allowed, kase.literals, kase.lookup)\n123|\t\t\trequireRefusal(t, err, ErrUnsafeEnv, kase.want)\n124|\t\t})\n125|\t}\n126|}\n127|\n128|func TestBuildEnvAdmitsEmptyValues(t *testing.T) {\n129|\tt.Parallel()\n130|\t// FOO= is a meaningful empty assignment, not a missing one.\n131|\tenvironment, err := BuildEnv(nil, map[string]string{\"FOO\": \"\"}, lookupFixture(nil))\n132|\tif err != nil {\n133|\t\tt.Fatalf(\"BuildEnv = %v\", err)\n134|\t}\n135|\tif !reflect.DeepEqual(environment, []string{\"FOO=\"}) {\n136|\t\tt.Fatalf(\"BuildEnv = %q, want [FOO=]\", environment)\n137|\t}\n138|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
