{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4d9","stream":{"kind":"session","id":"01a07721-ca06-7081-babf-b563190d8d78"},"sequence":199,"recorded_at":1780531400000393,"record_type":"event","durability":"durable","causation_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd","run_stream":{"kind":"run","id":"38f2a4ef-6e71-4516-af44-8dd3ca8a69cd"},"task_stream":{"kind":"task","id":"e22f4a43-00ee-418a-9da9-5b53fd86e528"},"task_id":"e22f4a43-00ee-418a-9da9-5b53fd86e528","event":{"kind":"output","task_id":"e22f4a43-00ee-418a-9da9-5b53fd86e528","chunk":"Read text file `internal/secprim/classes_test.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"go/ast\"\n5|\t\"go/parser\"\n6|\t\"go/token\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"sort\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n14|)\n15|\n16|// derivedExclusionClasses derives the Section 16.2 mandatory-exclusion\n17|// classes from the pinned specification document itself: every body row of\n18|// the Class table in Section 16.2. A class added to or removed from the\n19|// specification fails the roster below instead of passing silently.\n20|func derivedExclusionClasses(t *testing.T) []string {\n21|\tt.Helper()\n22|\tdocument, err := specdoc.Load()\n23|\tif err != nil {\n24|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n25|\t}\n26|\tvar classes []string\n27|\tseen := map[string]bool{}\n28|\tfor number := 1; number <= document.LineCount(); number++ {\n29|\t\trow, ok := document.TableRowAt(number)\n30|\t\tif !ok || row.Header != \"Class\" {\n31|\t\t\tcontinue\n32|\t\t}\n33|\t\tsection, ok := document.SectionID(row.Line)\n34|\t\tif !ok || section != \"16.2\" {\n35|\t\t\tcontinue\n36|\t\t}\n37|\t\tif seen[row.FirstCell] {\n38|\t\t\tcontinue\n39|\t\t}\n40|\t\tseen[row.FirstCell] = true\n41|\t\tclasses = append(classes, row.FirstCell)\n42|\t}\n43|\tif len(classes) == 0 {\n44|\t\tt.Fatal(\"derived no Section 16.2 exclusion classes; the scanner is broken, not the document\")\n45|\t}\n46|\tsort.Strings(classes)\n47|\treturn classes\n48|}\n49|\n50|// exclusionRow pairs one derived Section 16.2 class with its disposition:\n51|// which mechanism keeps that class out of artifacts, and which test\n52|// proves the mechanism. Every derived class carries exactly one row.\n53|type exclusionRow struct {\n54|\tclass       string\n55|\tdisposition string\n56|\twitnesses   []string\n57|}\n58|\n59|// exclusionRows is the reviewed disposition half of the Section 16.2\n60|// census. Dispositions are one of: scrub (the Redact stream arms),\n61|// refuse (a boundary gate), structural (never logged by construction),\n62|// or nopath (no in-repo emission path carries the class — the M0-stage\n63|// bound, proven by TestNoArchiveEmissionPath plus the secret-site\n64|// roster).\n65|func exclusionRows() []exclusionRow {\n66|\treturn []exclusionRow{\n67|\t\t{\n68|\t\t\tclass: \"Provider credentials\",\n69|\t\t\tdisposition: \"scrub for free text (Redact corpus and key=value arms) and refuse for structured \" +\n70|\t\t\t\t\"diagnostics (the axerror excluded-key gate)\",\n71|\t\t\twitnesses: []string{\n72|\t\t\t\t\"secprim.TestRedactSensitivePairs\",\n73|\t\t\t\t\"secprim.TestSecretAxerrorTableRefused\",\n74|\t\t\t},\n75|\t\t},\n76|\t\t{\n77|\t\t\tclass: \"SSH/private identity\",\n78|\t\t\tdisposition: \"scrub for free text (the Redact private-key block arm for key material, corpus and \" +\n79|\t\t\t\t\"key arms for the rest) and refuse for structured diagnostics\",\n80|\t\t\twitnesses: []string{\n81|\t\t\t\t\"secprim.TestRedactPrivateKeyBlocks\",\n82|\t\t\t\t\"secprim.TestSecretAxerrorTableRefused\",\n83|\t\t\t},\n84|\t\t},\n85|\t\t{\n86|\t\t\tclass: \"Environment secrets\",\n87|\t\t\tdisposition: \"scrub for free text and refuse for structured diagnostics; SpawnPlan literals are \" +\n88|\t\t\t\t\"additionally bounded and disjoint by the provhost wire gate, whose secrecy itself is an \" +\n89|\t\t\t\t\"operator obligation no content inspection could prove\",\n90|\t\t\twitnesses: []string{\n91|\t\t\t\t\"secprim.TestRedactCorpusValues\",\n92|\t\t\t\t\"secprim.TestSecretAxerrorTableRefused\",\n93|\t\t\t\t\"provhost.TestDecodeSpawnPlanRefusals\",\n94|\t\t\t},\n95|\t\t},\n96|\t\t{\n97|\t\t\tclass: \"Machine authentication\",\n98|\t\t\tdisposition: \"nopath: no keychain, secret-service, credential-manager, or task-board login-token \" +\n99|\t\t\t\t\"handling exists in this repository, and the secret-site roster proves no secret-named field \" +\n100|\t\t\t\t\"exists outside the dispositioned tables; key-shaped text is still scrubbed where it matches\",\n101|\t\t\twitnesses: []string{\n102|\t\t\t\t\"secprim.TestSecretSiteRosterIsComplete\",\n103|\t\t\t\t\"secprim.TestNoArchiveEmissionPath\",\n104|\t\t\t},\n105|\t\t},\n106|\t\t{\n107|\t\t\tclass: \"Live process identity\",\n108|\t\t\tdisposition: \"nopath for transfer plus structural for diagnostics: PIDs and handles never enter \" +\n109|\t\t\t\t\"Structured Errors because the causal-leak gate refuses cause text verbatim\",\n110|\t\t\twitnesses: []string{\n111|\t\t\t\t\"secprim.TestNoArchiveEmissionPath\",\n112|\t\t\t\t\"axerror.TestCauseNeverReachesTheWire\",\n113|\t\t\t},\n114|\t\t},\n115|\t\t{\n116|\t\t\tclass: \"IPC/runtime\",\n117|\t\t\tdisposition: \"nopath: no socket, pipe, or tmux-server-socket transfer path exists in this \" +\n118|\t\t\t\t\"repository; socket-shaped names in diagnostics are inert text\",\n119|\t\t\twitnesses: []string{\n120|\t\t\t\t\"secprim.TestNoArchiveEmissionPath\",\n121|\t\t\t\t\"secprim.TestSecretSiteRosterIsComplete\",\n122|\t\t\t},\n123|\t\t},\n124|\t\t{\n125|\t\t\tclass: \"TerminalBackend runtime\",\n126|\t\t\tdisposition: \"refuse by vocabulary: bindings, native references, endpoints, tokens, relay \" +\n127|\t\t\t\t\"credentials, and observations are classified sensitive-owner-only or forbidden and never \" +\n128|\t\t\t\t\"replicate as live authority\",\n129|\t\t\twitnesses: []string{\n130|\t\t\t\t\"terminalbackend.TestReplicationClassificationIsClosed\",\n131|\t\t\t},\n132|\t\t},\n133|\t\t{\n134|\t\t\tclass: \"Transient locking\",\n135|\t\t\tdisposition: \"nopath: lock files, WAL/SHM journals, and PID locks have no emission path in this \" +\n136|\t\t\t\t\"repository; the owner-only staging roots they guard are validated by the no-follow gates\",\n137|\t\t\twitnesses: []string{\n138|\t\t\t\t\"secprim.TestNoArchiveEmissionPath\",\n139|\t\t\t\t\"secprim.TestOpenNoFollowDir\",\n140|\t\t\t},\n141|\t\t},\n142|\t\t{\n143|\t\t\tclass: \"Mutable derived indexes\",\n144|\t\t\tdisposition: \"nopath: SQLite projections and provider caches are rebuilt locally, never exported; \" +\n145|\t\t\t\t\"no export path exists to audit\",\n146|\t\t\twitnesses: []string{\n147|\t\t\t\t\"secprim.TestNoArchiveEmissionPath\",\n148|\t\t\t\t\"secprim.TestSecretSiteRosterIsComplete\",\n149|\t\t\t},\n150|\t\t},\n151|\t}\n152|}\n153|\n154|// TestExclusionClassRosterIsComplete requires every derived Section 16.2\n155|// class to carry exactly one disposition row, and every row to resolve to\n156|// a derived class.\n157|func TestExclusionClassRosterIsComplete(t *testing.T) {\n158|\tderived := derivedExclusionClasses(t)\n159|\trows := exclusionRows()\n160|\tseen := map[string]bool{}\n161|\tfor _, row := range rows {\n162|\t\tfound := false\n163|\t\tfor _, class := range derived {\n164|\t\t\tif row.class == class {\n165|\t\t\t\tfound = true\n166|\t\t\t\tbreak\n167|\t\t\t}\n168|\t\t}\n169|\t\tif !found {\n170|\t\t\tt.Fatalf(\"orphaned exclusion row %q: the specification derives no such class\", row.class)\n171|\t\t}\n172|\t\tif seen[row.class] {\n173|\t\t\tt.Fatalf(\"duplicate exclusion row %q\", row.class)\n174|\t\t}\n175|\t\tseen[row.class] = true\n176|\t}\n177|\tvar missing []string\n178|\tfor _, class := range derived {\n179|\t\tif !seen[class] {\n180|\t\t\tmissing = append(missing, class)\n181|\t\t}\n182|\t}\n183|\tif len(missing) > 0 {\n184|\t\tt.Fatalf(\"derived exclusion classes with no disposition:\\n  %s\", strings.Join(missing, \"\\n  \"))\n185|\t}\n186|\tif len(derived) != 9 {\n187|\t\tt.Fatalf(\"derived %d exclusion classes, want the 9 of Section 16.2: %q\", len(derived), derived)\n188|\t}\n189|}\n190|\n191|// TestExclusionWitnessesExist verifies every cited witness names a real\n192|// test, reusing the declaration walk from the site census.\n193|func TestExclusionWitnessesExist(t *testing.T) {\n194|\tt.Parallel()\n195|\tneeded := map[string]map[string]bool{}\n196|\tfor _, row := range exclusionRows() {\n197|\t\tfor _, witness := range row.witnesses {\n198|\t\t\tparts := strings.Split(witness, \".\")\n199|\t\t\tif len(parts) != 2 {\n200|\t\t\t\tt.Fatalf(\"witness %q is not package.Test shaped\", witness)\n201|\t\t\t}\n202|\t\t\tif needed[parts[0]] == nil {\n203|\t\t\t\tneeded[parts[0]] = map[string]bool{}\n204|\t\t\t}\n205|\t\t\tneeded[parts[0]][parts[1]] = true\n206|\t\t}\n207|\t}\n208|\tfor pkg, names := range needed {\n209|\t\tfound := testFuncNames(t, pkg)\n210|\t\tfor name := range names {\n211|\t\t\tif !found[name] {\n212|\t\t\t\tt.Errorf(\"witness %s.%s does not exist; the census cites a ghost\", pkg, name)\n213|\t\t\t}\n214|\t\t}\n215|\t}\n216|}\n217|\n218|// TestNoArchiveEmissionPath proves the nopath dispositions above: no\n219|// production package imports an archive or transfer-emission facility, so\n220|// there is no code path that could carry an excluded class into a bundle.\n221|// The day an archive or transfer writer lands, this test names it and the\n222|// nopath rows must be re-dispositioned.\n223|func TestNoArchiveEmissionPath(t *testing.T) {\n224|\tt.Parallel()\n225|\troot, err := filepath.Abs(filepath.Join(\"..\", \"..\"))\n226|\tif err != nil {\n227|\t\tt.Fatal(err)\n228|\t}\n229|\tforbidden := []string{\"archive/tar\", \"archive/zip\", \"compress/gzip\"}\n230|\tvar violations []string\n231|\tscanned := 0\n232|\tpackages, err := os.ReadDir(filepath.Join(root, \"internal\"))\n233|\tif err != nil {\n234|\t\tt.Fatal(err)\n235|\t}\n236|\tfor _, pkg := range packages {\n237|\t\tif !pkg.IsDir() {\n238|\t\t\tcontinue\n239|\t\t}\n240|\t\tentries, err := os.ReadDir(filepath.Join(root, \"internal\", pkg.Name()))\n241|\t\tif err != nil {\n242|\t\t\tt.Fatal(err)\n243|\t\t}\n244|\t\tfor _, entry := range entries {\n245|\t\t\tname := entry.Name()\n246|\t\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n247|\t\t\t\tcontinue\n248|\t\t\t}\n249|\t\t\tcontents, err := os.ReadFile(filepath.Join(root, \"internal\", pkg.Name(), name))\n250|\t\t\tif err != nil {\n251|\t\t\t\tt.Fatal(err)\n252|\t\t\t}\n253|\t\t\tscanned++\n254|\t\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), name, contents, parser.ImportsOnly)\n255|\t\t\tif err != nil {\n256|\t\t\t\tt.Fatal(err)\n257|\t\t\t}\n258|\t\t\tfor _, imported := range syntax.Imports {\n259|\t\t\t\tpath := strings.Trim(imported.Path.Value, `\"`)\n260|\t\t\t\tfor _, denied := range forbidden {\n261|\t\t\t\t\tif path == denied {\n262|\t\t\t\t\t\tviolations = append(violations, \"internal/\"+pkg.Name()+\"/\"+name+\" imports \"+path)\n263|\t\t\t\t\t}\n264|\t\t\t\t}\n265|\t\t\t}\n266|\t\t}\n267|\t}\n268|\tif scanned == 0 {\n269|\t\tt.Fatal(\"scanned no production sources; the check is blind\")\n270|\t}\n271|\tif len(violations) > 0 {\n272|\t\tt.Fatalf(\"archive emission paths exist; nopath dispositions must be re-proven:\\n  %s\", strings.Join(violations, \"\\n  \"))\n273|\t}\n274|}\n275|\n276|// Keep the AST imports referenced for the emission-path walk above.\n277|var _ = ast.Walk"}}}
