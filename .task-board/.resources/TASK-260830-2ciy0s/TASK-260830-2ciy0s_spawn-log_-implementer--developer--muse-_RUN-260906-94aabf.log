{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000df7b","stream":{"kind":"session","id":"01a076ec-3023-7ad0-af14-c3080467cd16"},"sequence":3608,"recorded_at":1780531400007211,"record_type":"event","durability":"durable","causation_id":"29de407d-d987-4950-b9b4-211f15150d27","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"29de407d-d987-4950-b9b4-211f15150d27","run_stream":{"kind":"run","id":"29de407d-d987-4950-b9b4-211f15150d27"},"task_stream":{"kind":"task","id":"3bbb91dd-f7f1-4081-9ede-3b81ebba61ec"},"task_id":"3bbb91dd-f7f1-4081-9ede-3b81ebba61ec","event":{"kind":"output","task_id":"3bbb91dd-f7f1-4081-9ede-3b81ebba61ec","chunk":"{\n  \"chunk_id\": \"exec-106-1\",\n  \"command\": \"sed -n '1,60p' internal/cliresult/streams_test.go; echo ===; grep -n \\\"func NewEmitter\\\\|func.*Invocation.*Mode\\\\|func Parse\\\\|type Invocation\\\" internal/cliresult/*.go | grep -v _test | head\",\n  \"description\": \"Read stream test setup pattern\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"package cliresult\\n\\nimport (\\n\\t\\\"errors\\\"\\n\\t\\\"testing\\\"\\n)\\n\\n// failingWriter reports a write error, which is what a closed pipe looks like\\n// to a command that has already decided its outcome.\\ntype failingWriter struct{ err error }\\n\\nfunc (writer failingWriter) Write([]byte) (int, error) { return 0, writer.err }\\n\\n// TestExitStatusSurvivesAFailedWrite pins the ordering the Section 14.2 exit\\n// rule needs: the process status is the outcome's status even when stdout could\\n// not be written. Reporting exit 0 because a pipe closed would turn a failure\\n// into a success at exactly the moment nobody can read the document.\\nfunc TestExitStatusSurvivesAFailedWrite(t *testing.T) {\\n\\tbroken := errors.New(\\\"broken pipe\\\")\\n\\tvar sink capture\\n\\temitter := mustEmitter(t, ModeJSON, false, Streams{\\n\\t\\tStdout: failingWriter{err: broken}, Stderr: &sink.stderr,\\n\\t})\\n\\tfailure := mustFailure(t, \\\"workspace_conflict\\\")\\n\\tstatus, err := emitter.Emit(Outcome{Failure: failure})\\n\\tif !errors.Is(err, broken) {\\n\\t\\tt.Fatalf(\\\"Emit = %v, want the write error\\\", err)\\n\\t}\\n\\tif status != 5 {\\n\\t\\tt.Fatalf(\\\"status = %d, want the workspace_conflict exit 5 despite the failed write\\\", status)\\n\\t}\\n\\n\\temitter = mustEmitter(t, ModeText, false, Streams{\\n\\t\\tStdout: &sink.stdout, Stderr: failingWriter{err: broken},\\n\\t})\\n\\tif err := emitter.Log(\\\"diagnostic\\\"); !errors.Is(err, broken) {\\n\\t\\tt.Fatalf(\\\"Log = %v, want the write error\\\", err)\\n\\t}\\n\\tif _, err := emitter.Progress(\\\"progress\\\"); err != nil {\\n\\t\\tt.Fatalf(\\\"Progress on a non-TTY reported a write error: %v\\\", err)\\n\\t}\\n\\temitter = mustEmitter(t, ModeText, false, Streams{\\n\\t\\tStdout: &sink.stdout, Stderr: failingWriter{err: broken},\\n\\t})\\n\\temitter.streams.StderrIsTTY = true\\n\\tif written, err := emitter.Progress(\\\"progress\\\"); written || !errors.Is(err, broken) {\\n\\t\\tt.Fatalf(\\\"Progress = %t/%v, want false and the write error\\\", written, err)\\n\\t}\\n\\tif err := emitter.Prompt(\\\"continue?\\\"); !errors.Is(err, broken) {\\n\\t\\tt.Fatalf(\\\"Prompt = %v, want the write error\\\", err)\\n\\t}\\n}\\n===\\ninternal/cliresult/client.go:25:type InvocationOutput struct {\\ninternal/cliresult/flags.go:187:type Invocation struct {\\ninternal/cliresult/flags.go:239:func (invocation *Invocation) Mode() Mode {\\ninternal/cliresult/flags.go:260:func ParseCommonFlags(surface SurfaceCommand, argv []string) (*Invocation, *axerror.Error) {\\ninternal/cliresult/output.go:74:func NewEmitter(invocation *Invocation, streams Streams) (*Emitter, error) {\\n\",\n  \"original_output_bytes\": 2386,\n  \"original_output_tokens\": 597,\n  \"truncated\": false\n}"}}}
