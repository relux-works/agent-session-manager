{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000dc5b","stream":{"kind":"session","id":"01a076ec-3023-7ad0-af14-c3080467cd16"},"sequence":3208,"recorded_at":1780531400006411,"record_type":"event","durability":"durable","causation_id":"29de407d-d987-4950-b9b4-211f15150d27","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"29de407d-d987-4950-b9b4-211f15150d27","run_stream":{"kind":"run","id":"29de407d-d987-4950-b9b4-211f15150d27"},"task_stream":{"kind":"task","id":"83129bd4-9f11-4a09-ae54-7e485be99b2d"},"task_id":"83129bd4-9f11-4a09-ae54-7e485be99b2d","event":{"kind":"output","task_id":"83129bd4-9f11-4a09-ae54-7e485be99b2d","chunk":"edited\nchanged lines: lines 218-232\n--- original\n+++ updated\n@@\n-// admitLiteral records a string literal under every token it contains.\n-// The literal is unquoted when it parses; an unparseable literal is\n-// recorded raw rather than dropped.\n-func admitLiteral(sites map[string]bool, pkg, raw string) {\n-\tvalue, err := strconv.Unquote(raw)\n-\tif err != nil {\n-\t\tvalue = raw\n-\t}\n-\tlowered := strings.ToLower(value)\n-\tfor _, word := range secretTokens {\n-\t\tif strings.Contains(lowered, word) {\n-\t\t\tsites[pkg+\"|lit|\"+value] = true\n-\t\t}\n-\t}\n-}\n+// maxLiteralRunes bounds the literal arm: a literal longer than this is\n+// prose documentation, not an identifier, key, or diagnostic atom, and\n+// rostering it would turn every explanatory paragraph into a site. The\n+// longest rostered diagnostic is 55 runes; the bound sits at 80.\n+const maxLiteralRunes = 80\n+\n+// admitLiteral records a string literal under every token it contains.\n+// The literal is unquoted when it parses; an unparseable literal is\n+// recorded raw rather than dropped. Literals past maxLiteralRunes are\n+// documentation prose, not sites.\n+func admitLiteral(sites map[string]bool, pkg, raw string) {\n+\tvalue, err := strconv.Unquote(raw)\n+\tif err != nil {\n+\t\tvalue = raw\n+\t}\n+\tif len([]rune(value)) > maxLiteralRunes {\n+\t\treturn\n+\t}\n+\tlowered := strings.ToLower(value)\n+\tfor _, word := range secretTokens {\n+\t\tif strings.Contains(lowered, word) {\n+\t\t\tsites[pkg+\"|lit|\"+value] = true\n+\t\t}\n+\t}\n+}\n"}}}
