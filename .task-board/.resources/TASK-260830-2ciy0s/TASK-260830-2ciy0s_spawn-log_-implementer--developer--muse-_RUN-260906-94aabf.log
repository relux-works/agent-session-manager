{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c66d","stream":{"kind":"session","id":"01a076ec-3023-7ad0-af14-c3080467cd16"},"sequence":401,"recorded_at":1780531400000797,"record_type":"event","durability":"durable","causation_id":"29de407d-d987-4950-b9b4-211f15150d27","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"29de407d-d987-4950-b9b4-211f15150d27","run_stream":{"kind":"run","id":"29de407d-d987-4950-b9b4-211f15150d27"},"task_stream":{"kind":"task","id":"cbea2d47-15ab-4ce0-bdcd-4a93b61675e4"},"task_id":"cbea2d47-15ab-4ce0-bdcd-4a93b61675e4","event":{"kind":"output","task_id":"cbea2d47-15ab-4ce0-bdcd-4a93b61675e4","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1i3qu7/worktree/internal/provhost/runner.go`.\n1|package provhost\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"context\"\n6|\t\"io\"\n7|\t\"os\"\n8|\t\"os/exec\"\n9|\t\"time\"\n10|)\n11|\n12|// waitDrainDelay bounds how long Wait lingers for pipe EOF after the\n13|// deadline kill before giving up on detached grandchildren.\n14|const waitDrainDelay = 2 * time.Second\n15|\n16|// stdoutCap bounds captured plugin stdout: one maximal frame, its line\n17|// terminator, and one probe byte, so a maximal frame followed by any\n18|// trailing byte is still distinguishable from a clean end. Anything\n19|// beyond is cut; the splitFrame length checks stay exact on the capped\n20|// capture.\n21|const stdoutCap = MaxFrameBytes + 2\n22|\n23|// Result is what a plugin process produced: captured stdout and stderr\n24|// and the process exit code. Stdout and stderr are kept separate end to\n25|// end: diagnostics never enter frame parsing, and frame bytes never\n26|// enter diagnostics. Captures are capped (stdout at one frame plus a\n27|// probe byte, stderr at StderrCapBytes); beyond the cap the stream is cut\n28|// and the failure is decided from what was captured, which the length\n29|// checks keep exact.\n30|type Result struct {\n31|\tStdout   []byte\n32|\tStderr   []byte\n33|\tExitCode int\n34|}\n35|\n36|// Runner starts one plugin process for one operation frame. Production\n37|// code supplies ExecRunner; tests supply a scripted fake. A Runner moves\n38|// bytes and reports process fate; it never parses frames and never\n39|// decides failures.\n40|type Runner interface {\n41|\tRun(ctx context.Context, executable string, stdin []byte) (Result, error)\n42|}\n43|\n44|// ExecRunner is the production Runner: it starts the trusted executable\n45|// discovered by internal/provider, writes exactly one frame to its stdin,\n46|// closes stdin, and waits under the caller's context. Environment and\n47|// stderr content never enter failure human text: Result carries the raw\n48|// streams, and failures built from a Result carry the failure class and\n49|// member names only, never content.\n50|type ExecRunner struct{}\n51|\n52|// Run starts executable with stdin on its stdin and captures both streams\n53|// with caps. A nil error with a nonzero exit code is an ordinary result:\n54|// a syntactically valid frame governs regardless of the exit status,\n55|// because SHOULD exit 0 is not MUST. A non-nil error means no result\n56|// could be judged: start failure, stream failure, context end, or a\n57|// wait failure with empty stdout and no known exit code. In\n58|// particular, a stdin write failure racing the plugin's exit never\n59|// discards a judgeable result on its own.\n60|func (ExecRunner) Run(ctx context.Context, executable string, stdin []byte) (Result, error) {\n61|\tcommand := newCommandContext(ctx, executable)\n62|\tcommand.WaitDelay = waitDrainDelay\n63|\tstdinPipe, err := command.StdinPipe()\n64|\tif err != nil {\n65|\t\treturn Result{}, err\n66|\t}\n67|\t// Stdout and stderr travel over pipes owned here, not over\n68|\t// StdoutPipe/StderrPipe: Wait closes those read ends after seeing\n69|\t// the process exit, which races a drain still in flight and\n70|\t// surfaces as \"file already closed\" on a valid frame. A pipe\n71|\t// created here is closed only by this function, so a drain never\n72|\t// loses to the wait.\n73|\tstdoutReader, stdoutWriter, err := os.Pipe()\n74|\tif err != nil {\n75|\t\treturn Result{}, err\n76|\t}\n77|\tdefer stdoutReader.Close()\n78|\tstderrReader, stderrWriter, err := os.Pipe()\n79|\tif err != nil {\n80|\t\tstdoutReader.Close()\n81|\t\treturn Result{}, err\n82|\t}\n83|\tdefer stderrReader.Close()\n84|\tcommand.Stdout = stdoutWriter\n85|\tcommand.Stderr = stderrWriter\n86|\tif err := command.Start(); err != nil {\n87|\t\tstdoutWriter.Close()\n88|\t\tstderrWriter.Close()\n89|\t\tstdoutReader.Close()\n90|\t\tstderrReader.Close()\n91|\t\treturn Result{}, err\n92|\t}\n93|\t// The parent's copies close at once: the child holds its own, so\n94|\t// EOF still means every writer is gone while no later Close can\n95|\t// interrupt a drain.\n96|\t_ = stdoutWriter.Close()\n97|\t_ = stderrWriter.Close()\n98|\t// Drain both streams while stdin is written: a plugin that answers\n99|\t// without reading stdin would otherwise deadlock against a full\n100|\t// pipe once either direction exceeds its buffer.\n101|\tstdoutDone := make(chan streamResult, 1)\n102|\tstderrDone := make(chan streamResult, 1)\n103|\tgo func() {\n104|\t\tdata, err := readCapped(stdoutReader, stdoutCap)\n105|\t\tstdoutDone <- streamResult{data: data, err: err}\n106|\t}()\n107|\tgo func() {\n108|\t\tdata, err := readCapped(stderrReader, StderrCapBytes)\n109|\t\tstderrDone <- streamResult{data: data, err: err}\n110|\t}()\n111|\twrote, writeErr := stdinPipe.Write(stdin)\n112|\tif writeErr == nil && wrote < len(stdin) {\n113|\t\twriteErr = io.ErrShortWrite\n114|\t}\n115|\tif writeErr == nil {\n116|\t\t_, writeErr = stdinPipe.Write([]byte{'\\n'})\n117|\t}\n118|\tcloseErr := stdinPipe.Close()\n119|\t// The wait and both drains run bounded by the call context. A\n120|\t// detached descendant that escapes the deadline group kill holds\n121|\t// the pipes open, and anything here that needs pipe EOF would\n122|\t// otherwise stay open for the descendant's whole lifetime\n123|\t// instead of ending at the deadline. Closing the read ends\n124|\t// fails the blocked drains at once; each drain sends exactly\n125|\t// once over a buffered channel, so no goroutine is left behind.\n126|\twaitDone := make(chan error, 1)\n127|\tgo func() {\n128|\t\twaitDone <- command.Wait()\n129|\t}()\n130|\tvar waitErr error\n131|\tselect {\n132|\tcase waitErr = <-waitDone:\n133|\t\tif ctx.Err() != nil {\n134|\t\t\t// The wait ended by deadline or cancellation: the\n135|\t\t\t// kill was already signaled, but a detached\n136|\t\t\t// grandchild may hold the pipes open past\n137|\t\t\t// WaitDelay. Close them rather than waiting for\n138|\t\t\t// streams that can no longer decide anything:\n139|\t\t\t// with the deadline gone there is no valid\n140|\t\t\t// response to read.\n141|\t\t\tstdoutReader.Close()\n142|\t\t\tstderrReader.Close()\n143|\t\t\t<-stdoutDone\n144|\t\t\t<-stderrDone\n145|\t\t\treturn Result{}, ctx.Err()\n146|\t\t}\n147|\tcase <-ctx.Done():\n148|\t\tstdoutReader.Close()\n149|\t\tstderrReader.Close()\n150|\t\t<-stdoutDone\n151|\t\t<-stderrDone\n152|\t\tif command.Process != nil {\n153|\t\t\t// The escaper the group kill cannot reach is a\n154|\t\t\t// grandchild-or-deeper that called setsid itself\n155|\t\t\t// (see newCommandContext and the\n156|\t\t\t// detached-descendant test): the direct child is\n157|\t\t\t// a group leader, so its own setsid fails EPERM\n158|\t\t\t// and it stays in the group. Kill the direct\n159|\t\t\t// process all the same: this branch races exec's\n160|\t\t\t// group Cancel, which may not have fired yet when\n161|\t\t\t// the deadline is observed here, so the direct\n162|\t\t\t// signal guarantees the reap below cannot wait on\n163|\t\t\t// the spawned process itself. An already-reaped\n164|\t\t\t// process reports an error here that is safe to\n165|\t\t\t// ignore.\n166|\t\t\t_ = command.Process.Kill()\n167|\t\t}\n168|\t\twaitErr = <-waitDone\n169|\t\treturn Result{}, ctx.Err()\n170|\t}\n171|\tstdoutResult, stderrResult, drained := collectDrains(ctx, stdoutReader, stderrReader, stdoutDone, stderrDone)\n172|\tif !drained {\n173|\t\t// The process exited but a detached descendant still\n174|\t\t// holds a pipe open past the deadline. The frame, if\n175|\t\t// any, was never fully delivered, so the deadline\n176|\t\t// decides: report the timeout rather than holding the\n177|\t\t// call open for the descendant's lifetime.\n178|\t\treturn Result{}, ctx.Err()\n179|\t}\n180|\tif stdoutResult.err != nil {\n181|\t\treturn Result{}, stdoutResult.err\n182|\t}\n183|\tif stderrResult.err != nil {\n184|\t\treturn Result{}, stderrResult.err\n185|\t}\n186|\tstdout := stdoutResult.data\n187|\tstderr := stderrResult.data\n188|\t// A stdin write failure after the process ran is still a result when\n189|\t// the process produced one: the frame may have arrived whole while\n190|\t// the write or close raced the plugin's exit. Report write, close,\n191|\t// and wait failures only when no result can be judged — empty\n192|\t// stdout with no known exit code — otherwise the frame governs,\n193|\t// and an empty stdout with a known exit code classifies the crash\n194|\t// through the returned Result instead of masking it as a transport\n195|\t// failure. Returning writeErr before stdout is ever considered\n196|\t// discards valid correlated frames on an EPIPE race.\n197|\texitCode := -1\n198|\tif command.ProcessState != nil {\n199|\t\texitCode = command.ProcessState.ExitCode()\n200|\t}\n201|\tif exit, ok := waitErr.(*exec.ExitError); ok {\n202|\t\texitCode = exit.ExitCode()\n203|\t}\n204|\tresult := Result{Stdout: stdout, Stderr: stderr, ExitCode: exitCode}\n205|\tif len(stdout) > 0 || command.ProcessState != nil {\n206|\t\treturn result, nil\n207|\t}\n208|\tif writeErr != nil {\n209|\t\treturn Result{}, writeErr\n210|\t}\n211|\tif closeErr != nil {\n212|\t\treturn Result{}, closeErr\n213|\t}\n214|\tif waitErr != nil {\n215|\t\treturn Result{}, waitErr\n216|\t}\n217|\treturn result, nil\n218|}\n219|\n220|// streamResult is one drained stream: the captured prefix and the\n221|// drain's own error, if the read failed before EOF.\n222|type streamResult struct {\n223|\tdata []byte\n224|\terr  error\n225|}\n226|\n227|// collectDrains gathers both stream captures, bounded by the call\n228|// context. When the deadline passes while a detached descendant still\n229|// holds a pipe open, the still-blocked read ends are closed so those\n230|// drains fail at once instead of holding the call open past its\n231|// deadline, and collectDrains reports false: the frame, if any, was\n232|// never fully delivered, so the caller lets the deadline decide\n233|// rather than judging a partial capture. Each drain channel is\n234|// received exactly once per still-pending drain, matching the single\n235|// buffered send of its goroutine.\n236|func collectDrains(ctx context.Context, stdoutReader, stderrReader *os.File, stdoutDone, stderrDone <-chan streamResult) (streamResult, streamResult, bool) {\n237|\tselect {\n238|\tcase stdout := <-stdoutDone:\n239|\t\tselect {\n240|\t\tcase stderr := <-stderrDone:\n241|\t\t\treturn stdout, stderr, true\n242|\t\tcase <-ctx.Done():\n243|\t\t\tstderrReader.Close()\n244|\t\t\tstderr := <-stderrDone\n245|\t\t\treturn stdout, stderr, false\n246|\t\t}\n247|\tcase <-ctx.Done():\n248|\t\tstdoutReader.Close()\n249|\t\tstderrReader.Close()\n250|\t\tstdout := <-stdoutDone\n251|\t\tstderr := <-stderrDone\n252|\t\treturn stdout, stderr, false\n253|\t}\n254|}\n255|\n256|// readCapped drains stream up to cap bytes and cuts the rest. Memory\n257|// stays bounded no matter what the plugin emits, and the splitFrame\n258|// length checks stay exact on the capped capture.\n259|func readCapped(stream io.Reader, cap int) ([]byte, error) {\n260|\tdata, err := io.ReadAll(io.LimitReader(stream, int64(cap)+1))\n261|\tif err != nil {\n262|\t\treturn nil, err\n263|\t}\n264|\tif len(data) > cap {\n265|\t\treturn data[:cap], nil\n266|\t}\n267|\treturn data, nil\n268|}\n269|\n270|// Host invokes provider plugins: one process per operation, one frame in,\n271|// one frame out, under the request deadline. Host keeps no cross-call\n272|// state, so successive calls are separate processes observing durable\n273|// state through the authority the caller passes.\n274|type Host struct {\n275|\t// Runner starts the plugin process. It must be set; a nil Runner is\n276|\t// a caller error, refused before any frame is built.\n277|\tRunner Runner\n278|\t// Now is the clock deadlines are checked against. Nil means the\n279|\t// system clock; tests supply a fixed instant.\n280|\tNow func() time.Time\n281|}\n282|\n283|func (host Host) now() time.Time {\n284|\tif host.Now == nil {\n285|\t\treturn time.Now()\n286|\t}\n287|\treturn host.Now()\n288|}\n289|\n290|// splitFrame separates the single response line from anything following\n291|// it. oversize reports a first line beyond MaxFrameBytes; extra reports\n292|// any bytes after the first line terminator. An empty line is neither:\n293|// it is a missing response, judged with the exit code by the caller.\n294|//\n295|// The checks are length-only and exact: stdout capture holds at most\n296|// MaxFrameBytes+2 bytes, so a first line beyond the limit, or any\n297|// trailing byte, is always visible in the captured length. No separate\n298|// truncation flag participates; a narrowed or dropped disjunct here\n299|// would be equivalent, not coverage.\n300|func splitFrame(captured []byte) (line []byte, oversize bool, extra bool) {\n301|\tif index := bytes.IndexByte(captured, '\\n'); index >= 0 {\n302|\t\treturn captured[:index], len(captured[:index]) > MaxFrameBytes, index+1 < len(captured)\n303|\t}\n304|\treturn captured, len(captured) > MaxFrameBytes, false\n305|}\n306|\n307|// Call dispatches one operation: it frames the request, starts one plugin\n308|// process, enforces the request deadline, and interprets the single\n309|// response frame. Encode failures return before the Runner is touched, so\n310|// an unknown operation never starts a process. A success envelope returns\n311|// its body; a failure envelope returns the bound child error; anything\n312|// else returns a local failure that trusts nothing from the plugin.\n313|//\n314|// Deadline accounting is exact: the wait ends under a context cut at the\n315|// request deadline, and provider_timeout is reported only when that\n316|// instant actually passed. A parent cancellation first, or any other\n317|// runner failure with time remaining, is provider_process_failed. An\n318|// empty stdout with time remaining is a missing response:\n319|// provider_protocol_error on exit 0, provider_process_failed otherwise.\n320|// An empty stdout after the deadline passed is provider_timeout, and a\n321|// valid frame governs regardless of lateness or exit status.\n322|func (host Host) Call(ctx context.Context, executable string, req Request) (Response, error) {\n323|\tif host.Runner == nil {\n324|\t\tfailure, err := failInvalid(\"host has no runner\")\n325|\t\tif err != nil {\n326|\t\t\treturn Response{}, err\n327|\t\t}\n328|\t\treturn Response{}, failure\n329|\t}\n330|\tframe, deadline, err := encodeFrame(req, host.now())\n331|\tif err != nil {\n332|\t\treturn Response{}, err\n333|\t}\n334|\tdeadlineCtx, cancel := context.WithDeadline(ctx, deadline)\n335|\tdefer cancel()\n336|\tresult, err := host.Runner.Run(deadlineCtx, executable, frame)\n337|\tif err != nil {\n338|\t\tnow := host.now()\n339|\t\tif !now.Before(deadline) || deadlineCtx.Err() == context.DeadlineExceeded {\n340|\t\t\tfailure, fault := failTimeout(\"no response before the request deadline\", deadline.UnixMilli())\n341|\t\t\tif fault != nil {\n342|\t\t\t\treturn Response{}, fault\n343|\t\t\t}\n344|\t\t\treturn Response{}, failure\n345|\t\t}\n346|\t\tfailure, fault := failProcess(\"runner reported no result\", err)\n347|\t\tif fault != nil {\n348|\t\t\treturn Response{}, fault\n349|\t\t}\n350|\t\treturn Response{}, failure\n351|\t}\n352|\tline, oversize, extra := splitFrame(result.Stdout)\n353|\tif oversize {\n354|\t\tfailure, fault := failProtocol(\"frame exceeds 8 MiB\", \"\")\n355|\t\tif fault != nil {\n356|\t\t\treturn Response{}, fault\n357|\t\t}\n358|\t\treturn Response{}, failure\n359|\t}\n360|\tif extra {\n361|\t\tfailure, fault := failProtocol(\"stdout carries more than one frame\", \"\")\n362|\t\tif fault != nil {\n363|\t\t\treturn Response{}, fault\n364|\t\t}\n365|\t\treturn Response{}, failure\n366|\t}\n367|\tif len(line) == 0 {\n368|\t\t// No valid response arrived. When the request deadline passed,\n369|\t\t// this is the timeout even if the process also exited badly:\n370|\t\t// the host waited the full allowance and got nothing usable.\n371|\t\tif !host.now().Before(deadline) || deadlineCtx.Err() == context.DeadlineExceeded {\n372|\t\t\tfailure, fault := failTimeout(\"no response before the request deadline\", deadline.UnixMilli())\n373|\t\t\tif fault != nil {\n374|\t\t\t\treturn Response{}, fault\n375|\t\t\t}\n376|\t\t\treturn Response{}, failure\n377|\t\t}\n378|\t\tif result.ExitCode != 0 {\n379|\t\t\tfailure, fault := failProcess(\"plugin exited without a response\", nil)\n380|\t\t\tif fault != nil {\n381|\t\t\t\treturn Response{}, fault\n382|\t\t\t}\n383|\t\t\treturn Response{}, failure\n384|\t\t}\n385|\t\tfailure, fault := failProtocol(\"plugin exited without a response\", \"\")\n386|\t\tif fault != nil {\n387|\t\t\treturn Response{}, fault\n388|\t\t}\n389|\t\treturn Response{}, failure\n390|\t}\n391|\treturn DecodeResponse(line, req.RequestID)\n392|}"}}}
