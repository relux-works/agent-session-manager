{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cead","stream":{"kind":"session","id":"01a076ec-3023-7ad0-af14-c3080467cd16"},"sequence":1457,"recorded_at":1780531400002909,"record_type":"event","durability":"durable","causation_id":"29de407d-d987-4950-b9b4-211f15150d27","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"29de407d-d987-4950-b9b4-211f15150d27","run_stream":{"kind":"run","id":"29de407d-d987-4950-b9b4-211f15150d27"},"task_stream":{"kind":"task","id":"9ceb8021-671c-4c57-b268-bbf283f3fbd1"},"task_id":"9ceb8021-671c-4c57-b268-bbf283f3fbd1","event":{"kind":"output","task_id":"9ceb8021-671c-4c57-b268-bbf283f3fbd1","chunk":"edited\nchanged lines: lines 137-218\n--- original\n+++ updated\n@@\n-// redactSensitivePairs masks values of exact sensitive keys in key=value,\n-// key:value, and \"key\": \"value\" shapes.\n-func redactSensitivePairs(line string) string {\n-\tfor _, field := range splitPairFields(line) {\n-\t\tkey, value, separator := splitPair(field.text)\n-\t\tif separator == \"\" || !sensitiveKeyNames[strings.ToLower(key)] {\n-\t\t\tcontinue\n-\t\t}\n-\t\tline = strings.Replace(line, field.text, key+separator+redactedMarker+field.quote, 1)\n-\t\t_ = value\n-\t}\n-\treturn line\n-}\n-\n-// pairField is one candidate key/value span with its original text and any\n-// closing quote the value carried.\n-type pairField struct {\n-\ttext  string\n-\tquote string\n-}\n-\n-// splitPairFields splits the line at value boundaries that can end a\n-// masked value: whitespace, commas, semicolons, and closing braces or\n-// brackets. Quoted values keep their closing quote outside the mask so\n-// JSON stays parseable.\n-func splitPairFields(line string) []pairField {\n-\tvar fields []pairField\n-\tfor _, chunk := range strings.Fields(line) {\n-\t\ttext := strings.Trim(chunk, \",;\")\n-\t\ttrailing := chunk[len(strings.TrimRight(chunk, \",;\")):]\n-\t\t_ = trailing\n-\t\tquote := \"\"\n-\t\tfor _, closer := range []string{`\"}`, `'}`, `]`, `}`} {\n-\t\t\tif strings.HasSuffix(text, closer) && strings.Count(text, `\"`)%2 == 1 {\n-\t\t\t\ttext = strings.TrimSuffix(text, closer)\n-\t\t\t\tquote = closer\n-\t\t\t\tbreak\n-\t\t\t}\n-\t\t}\n-\t\tif strings.HasSuffix(text, `\"`) && strings.Count(text, `\"`)%2 == 0 && len(text) > 1 {\n-\t\t\ttext = strings.TrimSuffix(text, `\"`)\n-\t\t\tquote = `\"`\n-\t\t} else if strings.HasSuffix(text, `'`) && strings.Count(text, `'`)%2 == 0 && len(text) > 1 {\n-\t\t\ttext = strings.TrimSuffix(text, `'`)\n-\t\t\tquote = `'`\n-\t\t}\n-\t\tfields = append(fields, pairField{text: text, quote: quote})\n-\t}\n-\treturn fields\n-}\n-\n-// splitPair splits one field into key, value, and the separator between\n-// them (including surrounding spaces and opening quote). It reports no\n-// separator when the field carries no key shape: the key must start at a\n-// boundary (field start, quote, or brace) and be followed by ':' or '='\n-// with optional spaces.\n-func splitPair(field string) (key, value, separator string) {\n-\ttrimmed := strings.TrimLeft(field, `{\"'`)\n-\tprefix := field[:len(field)-len(trimmed)]\n-\tfor _, sep := range []string{\"=\", \":\"} {\n-\t\tindex := strings.Index(trimmed, sep)\n-\t\tif index < 0 {\n-\t\t\tcontinue\n-\t\t}\n-\t\tcandidate := strings.TrimSpace(trimmed[:index])\n-\t\tcandidate = strings.Trim(candidate, `\"`)\n-\t\tcandidate = strings.Trim(candidate, `'`)\n-\t\tif candidate == \"\" || !isKeyChars(candidate) {\n-\t\t\tcontinue\n-\t\t}\n-\t\trest := trimmed[index+len(sep):]\n-\t\tspaces := rest[:len(rest)-len(strings.TrimLeft(rest, \" \\t\"))]\n-\t\tval := strings.TrimLeft(rest, \" \\t\")\n-\t\tval = strings.TrimPrefix(val, `\"`)\n-\t\tval = strings.TrimPrefix(val, `'`)\n-\t\tif val == \"\" {\n-\t\t\tcontinue\n-\t\t}\n-\t\treturn candidate, val, prefix + strings.TrimSuffix(trimmed[:index+len(sep)], strings.TrimSpace(trimmed[:index+len(sep)])) + sep + spaces\n-\t}\n-\treturn \"\", \"\", \"\"\n-}\n+// redactSensitivePairs masks values of exact sensitive keys in key=value,\n+// key:value, and \"key\": \"value\" shapes. The line is walked chunk by chunk\n+// (whitespace-delimited); each chunk is spliced head + masked value + tail\n+// so surrounding quotes, braces, and commas survive and JSON stays\n+// parseable.\n+func redactSensitivePairs(line string) string {\n+\tchunks := strings.Split(line, \" \")\n+\tfor index, chunk := range chunks {\n+\t\tchunks[index] = maskSensitiveChunk(chunk)\n+\t}\n+\treturn strings.Join(chunks, \" \")\n+}\n+\n+// maskSensitiveChunk masks the value of one chunk when its key exactly\n+// matches sensitiveKeyNames. The key must start at the chunk start (past\n+// opening braces and quotes) and be followed by '=' or ':'; the value runs\n+// to the matching closing quote when quoted, else to the next value\n+// terminator (comma, semicolon, closing brace or bracket) or chunk end.\n+func maskSensitiveChunk(chunk string) string {\n+\tfor _, sep := range []string{\"=\", \":\"} {\n+\t\tposition := strings.Index(chunk, sep)\n+\t\tif position < 0 {\n+\t\t\tcontinue\n+\t\t}\n+\t\thead, key := splitChunkHead(chunk[:position])\n+\t\tif key == \"\" || !sensitiveKeyNames[strings.ToLower(key)] {\n+\t\t\tcontinue\n+\t\t}\n+\t\trest := chunk[position+len(sep):]\n+\t\tblank := rest[:len(rest)-len(strings.TrimLeft(rest, \" \\t\"))]\n+\t\tval := strings.TrimLeft(rest, \" \\t\")\n+\t\tquote := \"\"\n+\t\tif strings.HasPrefix(val, `\"`) || strings.HasPrefix(val, `'`) {\n+\t\t\tquote = val[:1]\n+\t\t\tval = val[1:]\n+\t\t}\n+\t\tend := len(val)\n+\t\tif quote != \"\" {\n+\t\t\tif closing := strings.Index(val, quote); closing >= 0 {\n+\t\t\t\tend = closing\n+\t\t\t}\n+\t\t} else {\n+\t\t\tend = strings.IndexAny(val, \",;}]\")\n+\t\t\tif end < 0 {\n+\t\t\t\tend = len(val)\n+\t\t\t}\n+\t\t}\n+\t\tif end == 0 {\n+\t\t\tcontinue\n+\t\t}\n+\t\ttail := val[end:]\n+\t\tif quote != \"\" && strings.HasPrefix(tail, quote) {\n+\t\t\ttail = tail[len(quote):]\n+\t\t\treturn head + key + chunk[position:position+len(sep)] + blank + quote + redactedMarker + quote + tail\n+\t\t}\n+\t\treturn head + key + chunk[position:position+len(sep)] + blank + quote + redactedMarker + tail\n+\t}\n+\treturn chunk\n+}\n+\n+// splitChunkHead separates the key from its leading punctuation: opening\n+// braces and quotes belong to the head, the key must be key-shaped.\n+func splitChunkHead(before string) (head, key string) {\n+\ttrimmed := strings.Trim(before, \" \\t\")\n+\thead = before[:len(before)-len(strings.TrimLeft(before, \" \\t\"))]\n+\tcore := strings.Trim(trimmed, `{\"'`)\n+\thead += trimmed[:len(trimmed)-len(core)]\n+\tif !isKeyChars(core) || core == \"\" {\n+\t\treturn before, \"\"\n+\t}\n+\treturn head, core\n+}\n"}}}
