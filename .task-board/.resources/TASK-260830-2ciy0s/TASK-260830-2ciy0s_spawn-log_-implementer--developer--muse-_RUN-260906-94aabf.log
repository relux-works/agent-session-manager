{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb87","stream":{"kind":"session","id":"01a076ec-3023-7ad0-af14-c3080467cd16"},"sequence":1054,"recorded_at":1780531400002103,"record_type":"event","durability":"durable","causation_id":"29de407d-d987-4950-b9b4-211f15150d27","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"29de407d-d987-4950-b9b4-211f15150d27","run_stream":{"kind":"run","id":"29de407d-d987-4950-b9b4-211f15150d27"},"call_id":"call_01a076ef62dd76b1b98c8c9a84e3c29f","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1i3qu7/worktree/internal/cliresult/output.go`.\n(81 line(s) above)\n82|func (emitter *Emitter) Mode() Mode { return emitter.mode }\n83|\n84|// Log writes one diagnostic line. Section 14.2 puts diagnostics on stderr in\n85|// text mode and says \"logs remain on stderr\" in JSON mode, so the destination\n86|// is the same in both and there is no mode in which a log can reach stdout.\n87|func (emitter *Emitter) Log(line string) error {\n88|\treturn writeLine(emitter.streams.Stderr, line)\n89|}\n90|\n91|// Progress writes one progress line. Section 14.2 says \"progress MAY use stderr\n92|// only when it is a TTY\", so a non-TTY stderr drops the line instead of\n93|// choosing another stream for it. The boolean reports whether it was written,\n94|// because silently dropping output without saying so is how a caller comes to\n95|// believe something was displayed.\n96|func (emitter *Emitter) Progress(line string) (bool, error) {\n97|\tif !emitter.streams.StderrIsTTY {\n98|\t\treturn false, nil\n99|\t}\n100|\tif err := writeLine(emitter.streams.Stderr, line); err != nil {\n101|\t\treturn false, err\n102|\t}\n103|\treturn true, nil\n104|}\n105|\n106|// Prompt writes one prompt to stderr. It refuses under --non-interactive, which\n107|// Section 14.2 says \"forbids prompts\". The refusal is the point: a prompt that\n108|// silently degrades to a default is exactly the confirmation bypass Section\n109|// 14.2 forbids elsewhere.\n110|func (emitter *Emitter) Prompt(line string) error {\n111|\tif emitter.nonInteractive {\n112|\t\treturn fmt.Errorf(\"%w: %q\", ErrPromptForbidden, line)\n113|\t}\n114|\treturn writeLine(emitter.streams.Stderr, line)\n115|}\n116|\n117|// Outcome is the single result of one command invocation. Exactly one of\n118|// Result and Failure is set: Section 14.2 makes success and failure different\n119|// objects, so an outcome carrying both, or neither, is not representable as a\n120|// conforming emission and is refused.\n121|type Outcome struct {\n122|\t// Result is the success object, or nil for a failure.\n123|\tResult *Result\n124|\t// Failure is the Structured Error, or nil for a success.\n125|\tFailure *axerror.Error\n126|\t// Rendered is the human text for text mode. It is required in text mode\n127|\t// and refused in JSON mode, where stdout carries exactly one JSON document\n128|\t// and nothing else.\n129|\tRendered string\n130|}\n131|\n132|// Emit writes the outcome and returns the exact process exit status for it.\n133|//\n134|// The status is the Section 14.2 rule verbatim: \"the process exit status MUST\n135|// equal that error's exit_code\". A success is SuccessExitStatus, and a failure\n136|// is the status the Structured Error registry assigned to its code - this\n137|// function does not compute, adjust, or clamp it.\n138|//\n139|// In JSON mode stdout receives exactly one JSON document and nothing else, and\n140|// a second call is refused. In text mode the success rendering goes to stdout\n141|// and the failure rendering goes to stderr, because Section 14.2 puts data on\n142|// stdout and diagnostics on stderr and a failure is a diagnostic.\n143|//\n144|// The returned status is valid even when the write fails: the operation's\n145|// outcome is already decided, and reporting exit 0 because a pipe closed would\n146|// misreport a failure as a success.\n147|func (emitter *Emitter) Emit(outcome Outcome) (int, error) {\n148|\tstatus, err := outcome.exitStatus()\n149|\tif err != nil {\n150|\t\treturn status, err\n151|\t}\n152|\tif emitter.emitted {\n153|\t\treturn status, fmt.Errorf(\"%w: stdout already carries this command's one document\", ErrStreamDiscipline)\n154|\t}\n155|\temitter.emitted = true\n156|\tif emitter.mode == ModeJSON {\n157|\t\tif outcome.Rendered != \"\" {\n158|\t\t\treturn status, fmt.Errorf(\n159|\t\t\t\t\"%w: JSON mode carries exactly one JSON document, so human text is not emitted\",\n160|\t\t\t\tErrStreamDiscipline)\n161|\t\t}\n162|\t\tdocument, err := outcome.document()\n163|\t\tif err != nil {\n164|\t\t\treturn status, err\n165|\t\t}\n166|\t\treturn status, writeLine(emitter.streams.Stdout, string(document))\n167|\t}\n168|\tif outcome.Rendered == \"\" {\n169|\t\treturn status, fmt.Errorf(\"%w: text mode requires a human rendering\", ErrStreamDiscipline)\n170|\t}\n171|\tif outcome.Failure != nil {\n172|\t\treturn status, writeLine(emitter.streams.Stderr, outcome.Rendered)\n173|\t}\n174|\treturn status, writeLine(emitter.streams.Stdout, outcome.Rendered)\n175|}\n176|\n177|// exitStatus resolves the Section 14.2 process exit status of an outcome.\n178|func (outcome Outcome) exitStatus() (int, error) {\n179|\tswitch {\n180|\tcase outcome.Result != nil && outcome.Failure != nil:\n181|\t\treturn 0, fmt.Errorf(\"%w: an outcome is a success or a failure, never both\", ErrStreamDiscipline)\n182|\tcase outcome.Result != nil:\n183|\t\treturn SuccessExitStatus, nil\n184|\tcase outcome.Failure != nil:\n185|\t\treturn outcome.Failure.ExitCode(), nil\n186|\tdefault:\n187|\t\treturn 0, fmt.Errorf(\"%w: an outcome carries neither a result nor a failure\", ErrStreamDiscipline)\n188|\t}\n189|}\n190|\n191|// ExitStatus reports the process exit status of an outcome without emitting it.\n192|// It exists so that a caller can settle the status and the emission separately\n193|// and still get one answer from one place.\n194|func ExitStatus(outcome Outcome) (int, error) { return outcome.exitStatus() }\n195|\n196|func (outcome Outcome) document() ([]byte, error) {\n197|\tif outcome.Failure != nil {\n198|\t\treturn outcome.Failure.MarshalJSON()\n199|\t}\n200|\treturn outcome.Result.MarshalJSON()\n201|}\n202|\n203|// writeLine terminates every write. A stream that must carry exactly one\n204|// document cannot afford an unterminated write merging with whatever follows\n205|// it, and a terminator is what makes \"one document\" observable to a reader.\n206|func writeLine(writer io.Writer, line string) error {\n207|\tif !strings.HasSuffix(line, \"\\n\") {\n208|\t\tline += \"\\n\"\n209|\t}\n210|\t_, err := io.WriteString(writer, line)\n211|\treturn err\n212|}\n213|\n214|// DestructiveOperation names one Section 14.2 \"destructive or split-brain-risk\"\n215|// operation together with the expectation flags Section 14.1 documents for it.\n216|type DestructiveOperation string\n217|\n218|const (\n219|\t// OperationForceTakeover is ax takeover --force, whose Section 14.1 grammar\n220|\t// is \"[--force --expect-owner ID --expect-epoch N] [--yes]\".\n221|\tOperationForceTakeover DestructiveOperation = \"takeover --force\"\n222|\t// OperationReplaceManagedReplica is ax materialize\n223|\t// --replace-managed-replica, which Section 14.1 says \"requires\n224|\t// --expect-checkpoint equal to its managed marker\" and whose\n225|\t// \"non-interactive replacement also requires --yes\".\n226|\tOperationReplaceManagedReplica DestructiveOperation = \"materialize --replace-managed-replica\"\n227|)\n228|\n229|// destructiveOperations is the reviewed table of operations that Section 14.2's\n230|// confirmation rule governs, each with the expectation flags Section 14.1\n231|// documents for it. An operation is listed only where the pinned document\n232|// states its expectation flags; nothing is added here because it merely looks\n233|// risky.\n234|var destructiveOperations = map[DestructiveOperation][]string{\n235|\tOperationForceTakeover:         {\"--expect-epoch\", \"--expect-owner\"},\n236|\tOperationReplaceManagedReplica: {\"--expect-checkpoint\"},\n237|}\n238|\n239|// DestructiveOperations returns the governed operations in sorted order.\n240|func DestructiveOperations() []DestructiveOperation {\n241|\tresult := make([]DestructiveOperation, 0, len(destructiveOperations))\n242|\tfor operation := range destructiveOperations {\n243|\t\tresult = append(result, operation)\n244|\t}\n245|\tsort.Slice(result, func(left, right int) bool { return result[left] < result[right] })\n246|\treturn result\n247|}\n248|\n249|// ExpectationFlags returns the documented expectation flags of an operation, in\n250|// sorted order.\n251|func ExpectationFlags(operation DestructiveOperation) ([]string, error) {\n252|\tflags, known := destructiveOperations[operation]\n253|\tif !known {\n254|\t\treturn nil, fmt.Errorf(\"%w: %q\", ErrUnknownSurface, operation)\n255|\t}\n256|\treturn append([]string(nil), flags...), nil\n257|}\n258|\n259|// Confirmation is the decision the Section 14.2 confirmation rule produces.\n260|type Confirmation struct {\n261|\t// PromptRequired is true when the caller must prompt before mutating.\n262|\t// Section 14.2: \"destructive or split-brain-risk operations MUST prompt in\n263|\t// interactive mode\".\n264|\tPromptRequired bool\n265|}\n266|\n267|// RequireConfirmation decides whether a destructive or split-brain-risk\n268|// operation may proceed.\n269|//\n270|// Section 14.2 states the rule in two sentences, and both are enforced here:\n271|// such an operation \"MUST prompt in interactive mode and require --yes plus\n272|// every documented expectation flag in non-interactive mode\", and \"--yes alone\n273|// MUST NOT bypass an expected owner/epoch/checkpoint check\".\n274|//\n275|// The second sentence is why the expectation flags are checked before --yes is\n276|// consulted and independently of it: a missing expectation flag is refused\n277|// whether or not --yes is present, in interactive and non-interactive mode\n278|// alike, so confirming can never stand in for stating the expected owner,\n279|// epoch, or checkpoint.\n280|func RequireConfirmation(\n281|\toperation DestructiveOperation,\n282|\tinvocation *Invocation,\n283|\tsupplied []string,\n284|) (Confirmation, *axerror.Error) {\n285|\texpected, err := ExpectationFlags(operation)\n286|\tif err != nil {\n287|\t\treturn Confirmation{}, mustInvalidArguments(err.Error())\n288|\t}\n289|\tif invocation == nil {\n290|\t\treturn Confirmation{}, mustInvalidArguments(\"no parsed invocation was supplied\")\n291|\t}\n292|\tpresent := make(map[string]struct{}, len(supplied))\n293|\tfor _, flag := range supplied {\n294|\t\tpresent[flag] = struct{}{}\n295|\t}\n296|\tvar missing []string\n297|\tfor _, flag := range expected {\n298|\t\tif _, ok := present[flag]; !ok {\n299|\t\t\tmissing = append(missing, flag)\n300|\t\t}\n301|\t}\n302|\tif len(missing) > 0 {\n303|\t\treturn Confirmation{}, mustInvalidArguments(fmt.Sprintf(\n304|\t\t\t\"%s requires %s; --yes does not bypass an expected owner, epoch, or checkpoint check\",\n305|\t\t\toperation, strings.Join(missing, \" and \")))\n306|\t}\n307|\tif !invocation.NonInteractive() {\n308|\t\treturn Confirmation{PromptRequired: true}, nil\n309|\t}\n310|\tif !invocation.Yes() {\n311|\t\treturn Confirmation{}, mustConfirmationRequired(fmt.Sprintf(\n312|\t\t\t\"%s requires --yes in non-interactive mode\", operation))\n313|\t}\n314|\treturn Confirmation{}, nil\n315|}\n316|\n317|// mustConfirmationRequired builds the Section 15.3 exit-16 refusal for a\n318|// missing destructive confirmation.\n319|func mustConfirmationRequired(message string) *axerror.Error {\n320|\tfailure, err := axerror.New(axerror.Spec{\n321|\t\tVersion: axerror.Version100,\n322|\t\tCode:    \"confirmation_required\",\n323|\t\tMessage: message,\n324|\t\tIDs:     axerror.NoIDs(),\n325|\t\tDetails: axerror.Details{},\n326|\t})\n327|\tif err != nil {\n328|\t\tpanic(fmt.Sprintf(\"cli result confirmation refusal is unconstructible: %v\", err))\n329|\t}\n330|\treturn failure\n331|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
