 resolved)\n627|\t}\n628|\traw, err := os.ReadFile(resolved)\n629|\tif err != nil {\n630|\t\treturn \"\", fmt.Errorf(\"terminal backend executable: %w\", err)\n631|\t}\n632|\tsum := sha256.Sum256(raw)\n633|\treturn \"sha256:\" + hex.EncodeToString(sum[:]), nil\n634|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
