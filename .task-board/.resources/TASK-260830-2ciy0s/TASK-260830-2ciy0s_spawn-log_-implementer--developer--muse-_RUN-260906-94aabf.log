          if hit: print(f\\\"{f}: decl {name} tokens={hit}\\\")\\n        for m in re.finditer(r'(?m)^\\\\t([A-Z][A-Za-z0-9_]*)\\\\s',src):\\n            name=m.group(1)\\n            hit=[t for t in toks if t in name.lower()]\\n            if hit: print(f\\\"{f}: field {name} tokens={hit}\\\")\\n        for m in re.finditer(r'(?:json|toml):\\\"([^\\\"]+)\\\"',src):\\n            tag=m.group(1).split(\\\",\\\")[0]\\n            hit=[t for t in toks if t in tag.lower()]\\n            if hit: print(f\\\"{f}: tag {tag} tokens={hit}\\\")\\nEOF\",\n  \"description\": \"Prototype secret-site scan\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"internal/terminalbackend/manifest.go: decl credentialRealmCapability tokens=['credential']\\n\",\n  \"original_output_bytes\": 91,\n  \"original_output_tokens\": 23,\n  \"truncated\": false\n}"}}}
