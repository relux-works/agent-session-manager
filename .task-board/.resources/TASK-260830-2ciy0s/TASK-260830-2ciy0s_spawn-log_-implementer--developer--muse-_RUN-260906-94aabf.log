{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000e063","stream":{"kind":"session","id":"01a076ec-3023-7ad0-af14-c3080467cd16"},"sequence":3724,"recorded_at":1780531400007443,"record_type":"event","durability":"durable","causation_id":"29de407d-d987-4950-b9b4-211f15150d27","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"29de407d-d987-4950-b9b4-211f15150d27","run_stream":{"kind":"run","id":"29de407d-d987-4950-b9b4-211f15150d27"},"task_stream":{"kind":"task","id":"aeea228f-f0cc-4410-8823-d0a6dc1e04d8"},"task_id":"aeea228f-f0cc-4410-8823-d0a6dc1e04d8","event":{"kind":"output","task_id":"aeea228f-f0cc-4410-8823-d0a6dc1e04d8","chunk":"edited\nchanged lines: lines 35-62\n--- original\n+++ updated\n@@\n-// childEnviron starts the test binary as a child through the production\n-// ExecRunner and returns the environment the child observed.\n-func childEnviron(t *testing.T, runner ExecRunner) []string {\n-\tt.Helper()\n-\tchild, err := exec.Command(os.Args[0], \"-test.run=TestExecRunnerHelperProcess\").Output()\n-\t_ = child\n-\t_ = err\n-\tself, err := os.Executable()\n-\tif err != nil {\n-\t\tt.Fatal(err)\n-\t}\n-\tresult, err := runner.Run(context.Background(), self, []byte(`{}`))\n-\tif err != nil {\n-\t\tt.Fatalf(\"helper run: %v\", err)\n-\t}\n-\tif result.ExitCode != 0 {\n-\t\tt.Fatalf(\"helper exit = %d, stderr = %q\", result.ExitCode, result.Stderr)\n-\t}\n-\tline := result.Stdout\n-\tif index := len(line) - 1; index >= 0 && line[index] == '\\n' {\n-\t\tline = line[:index]\n-\t}\n-\tvar environment []string\n-\tif err := json.Unmarshal(line, &environment); err != nil {\n-\t\tt.Fatalf(\"helper stdout %q is not a JSON environment: %v\", result.Stdout, err)\n-\t}\n-\treturn environment\n-}\n+// childEnviron starts the test binary as a child through the production\n+// ExecRunner and returns the environment the child observed. The child\n+// is the test binary itself restricted to the helper test; its marked\n+// line is scanned out of stdout because the test framework appends its\n+// own trailers after the test prints.\n+func childEnviron(t *testing.T, runner ExecRunner) []string {\n+\tt.Helper()\n+\tself, err := os.Executable()\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\t_ = self\n+\tresult, err := runnerWithHelper(t, runner)\n+\tif err != nil {\n+\t\tt.Fatalf(\"helper run: %v\", err)\n+\t}\n+\tif result.ExitCode != 0 {\n+\t\tt.Fatalf(\"helper exit = %d, stderr = %q\", result.ExitCode, result.Stderr)\n+\t}\n+\tfor _, line := range strings.Split(string(result.Stdout), \"\\n\") {\n+\t\tdocument, found := strings.CutPrefix(line, \"SECPROBE-ENV:\")\n+\t\tif !found {\n+\t\t\tcontinue\n+\t\t}\n+\t\tvar environment []string\n+\t\tif err := json.Unmarshal([]byte(document), &environment); err != nil {\n+\t\t\tt.Fatalf(\"helper line %q is not a JSON environment: %v\", line, err)\n+\t\t}\n+\t\treturn environment\n+\t}\n+\tt.Fatalf(\"helper printed no marked environment line: %q\", result.Stdout)\n+\treturn nil\n+}\n+\n+// runnerWithHelper re-execs the test binary restricted to the helper\n+// test through the production runner.\n+func runnerWithHelper(t *testing.T, runner ExecRunner) (Result, error) {\n+\tt.Helper()\n+\tself, err := os.Executable()\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\t_ = os.Args\n+\treturn runner.Run(context.Background(), self+\" -test.run=TestExecRunnerHelperProcess\", []byte(`{}`))\n+}\n"}}}
