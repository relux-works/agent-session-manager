string {\n445|\t\t\treturn refuseBatch(\"environments\", badParams(t, \"environments\", `\"authentication_status\":[]`, `\"authentication_status\":[\"missing\",\"available\"]`))\n446|\t\t}},\n447|\t\t{site: \"query.go|checkEnvironmentsParameters|obligation-5\", name: \"environments root status refused\", build: func(t *testing.T) string {\n448|\t\t\treturn refuseBatch(\"environments\", badParams(t, \"environments\", `\"authentication_status\":[]`, `\"authentication_status\":[\"root\"]`))\n449|\t\t}},\n450|\t\t{site: \"query.go|checkJobsParameters|obligation-1\", name: \"jobs bad job identifier\", build: func(t *testing.T) string {\n451|\t\t\treturn refuseBatch(\"jobs\", badParams(t, \"jobs\", `\"job_ids\":[]`, `\"job_ids\":[\"zzz\"]`))\n452|\t\t}},\n453|\t\t{site: \"query.go|checkJobsParameters|obligation-2\", name: \"jobs bad profile identifier\", build: func(t *testing.T) string {\n454|\t\t\treturn refuseBatch(\"jobs\", badParams(t, \"jobs\", `\"profile_ids\":[]`, `\"profile_ids\":[\"zzz\"]`))\n455|\t\t}},\n456|\t\t{site: \"query.go|checkJobsParameters|obligation-3\", name: \"jobs unsorted states\", build: func(t *testing.T) string {\n457|\t\t\treturn refuseBatch(\"jobs\", badParams(t, \"jobs\", `\"states\":[]`, `\"states\":[\"running\",\"queued\"]`))\n458|\t\t}},\n459|\t\t{site: \"query.go|checkJobsParameters|obligation-4\", name: \"jobs pwned state refused\", build: func(t *testing.T) string {\n460|\t\t\treturn refuseBatch(\"jobs\", badParams(t, \"jobs\", `\"states\":[]`, `\"states\":[\"pwned\"]`))\n461|\t\t}},\n462|\t\t{site: \"query.go|checkPlansParameters|obligation-1\", name: \"plans bad plan identifier\", build: func(t *testing.T) string {\n463|\t\t\treturn refuseBatch(\"plans\", badParams(t, \"plans\", `\"plan_ids\":[]`, `\"plan_ids\":[\"zzz\"]`))\n464|\t\t}},\n465|\t\t{site: \"query.go|checkPlansParameters|obligation-2\", name: \"plans bad operation identifier\", build: func(t *testing.T) string {\n466|\t\t\treturn refuseBatch(\"plans\", badParams(t, \"plans\", `\"operation_ids\":[]`, `\"operation_ids\":[\"zzz\"]`))\n467|\t\t}},\n468|\t\t{site: \"query.go|checkDistinctParameters|obligation-1\", name: \"distinct non-string field\", build: func(t *testing.T) string {\n469|\t\t\treturn refuseBatch(\"distinct\", badParams(t, \"distinct\", `\"field\":\"kind\"`, `\"field\":0`))\n470|\t\t}},\n471|\t\t{site: \"query.go|checkDistinctParameters|obligation-2\", name: \"distinct secret field refused\", build: func(t *testing.T) string {\n472|\t\t\treturn refuseBatch(\"distinct\", badParams(t, \"distinct\", `\"field\":\"kind\"`, `\"field\":\"secret\"`))\n473|\t\t}},\n474|\t\t{site: \"query.go|checkTagsParameter|obligation-1\", name: \"tags past count bound\", build: func(t *testing.T) string {\n475|\t\t\treturn refuseBatch(\"set_tags\", badParams(t, \"set_tags\", `\"tags\":[]`, `\"tags\":`+sortedLiterals(\"tag\", 257)))\n476|\t\t}},\n477|\t\t{site: \"query.go|checkTagsParameter|obligation-2\", name: \"tags non-string element\", build: func(t *testing.T) string {\n478|\t\t\treturn refuseBatch(\"set_tags\", badParams(t, \"set_tags\", `\"tags\":[]`, `\"tags\":[\"a\",0]`))\n479|\t\t}},\n480|\t\t{site: \"query.go|checkTagsParameter|obligation-3\", name: \"tags unsorted\", build: func(t *testing.T) string {\n481|\t\t\treturn refuseBatch(\"set_tags\", badParams(t, \"set_tags\", `\"tags\":[]`, `\"tags\":[\"b\",\"a\"]`))\n482|\t\t}},\n483|\t\t{site: \"query.go|checkEnrichParameters|obligation-1\", name: \"enrich bad profile\", build: func(t *testing.T) string {\n484|\t\t\treturn refuseBatch(\"enrich\", badParams(t, \"enrich\", `\"profile_id\":`+quote(fixtureBatchDigest), `\"profile_id\":\"zzz\"`))\n485|\t\t}},\n486|\t\t{site: \"query.go|checkEnrichParameters|obligation-2\", name: \"enrich empty kinds\", build: func(t *testing.T) string {\n487|\t\t\treturn refuseBatch(\"enrich\", badParams(t, \"enrich\", `\"kinds\":[\"summary\"]`, `\"kinds\":[]`))\n488|\t\t}},\n489|\t\t{site: \"query.go|checkEnrichParameters|obligation-3\", name: \"enrich