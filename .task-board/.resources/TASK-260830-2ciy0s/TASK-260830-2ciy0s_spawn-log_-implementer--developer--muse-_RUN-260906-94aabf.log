{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000e129","stream":{"kind":"session","id":"01a076ec-3023-7ad0-af14-c3080467cd16"},"sequence":3823,"recorded_at":1780531400007641,"record_type":"event","durability":"durable","causation_id":"29de407d-d987-4950-b9b4-211f15150d27","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"29de407d-d987-4950-b9b4-211f15150d27","run_stream":{"kind":"run","id":"29de407d-d987-4950-b9b4-211f15150d27"},"task_stream":{"kind":"task","id":"7fc7fbd7-5806-4755-970b-243c1ffb1406"},"task_id":"7fc7fbd7-5806-4755-970b-243c1ffb1406","event":{"kind":"output","task_id":"7fc7fbd7-5806-4755-970b-243c1ffb1406","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1i3qu7/worktree/internal/provhost/runner_env_test.go`.\n(35 line(s) above)\n36|func childEnviron(t *testing.T, runner ExecRunner) []string {\n37|\tt.Helper()\n38|\tself, err := os.Executable()\n39|\tif err != nil {\n40|\t\tt.Fatal(err)\n41|\t}\n42|\t_ = self\n43|\tresult, err := runnerWithHelper(t, runner)\n44|\tif err != nil {\n45|\t\tt.Fatalf(\"helper run: %v\", err)\n46|\t}\n47|\tif result.ExitCode != 0 {\n48|\t\tt.Fatalf(\"helper exit = %d, stderr = %q\", result.ExitCode, result.Stderr)\n49|\t}\n50|\tfor _, line := range strings.Split(string(result.Stdout), \"\\n\") {\n51|\t\tdocument, found := strings.CutPrefix(line, \"SECPROBE-ENV:\")\n52|\t\tif !found {\n53|\t\t\tcontinue\n54|\t\t}\n55|\t\tvar environment []string\n56|\t\tif err := json.Unmarshal([]byte(document), &environment); err != nil {\n57|\t\t\tt.Fatalf(\"helper line %q is not a JSON environment: %v\", line, err)\n58|\t\t}\n59|\t\treturn environment\n60|\t}\n61|\tt.Fatalf(\"helper printed no marked environment line: %q\", result.Stdout)\n62|\treturn nil\n63|}\n64|\n65|// runnerWithHelper re-execs the test binary through the production\n66|// runner. The TestMain gate selects the helper by the marker carried in\n67|// the environment itself, because the provider protocol starts plugins\n68|// with no arguments and there is no argv channel for a test flag.\n69|func runnerWithHelper(t *testing.T, runner ExecRunner) (Result, error) {\n70|\tt.Helper()\n71|\tself, err := os.Executable()\n72|\tif err != nil {\n73|\t\tt.Fatal(err)\n74|\t}\n75|\treturn runner.Run(context.Background(), self, []byte(`{}`))\n76|}\n77|\n78|func helperRunner(t *testing.T, env []string) ExecRunner {\n79|\tt.Helper()\n80|\tt.Setenv(\"SECPROBE_HELPER_PROCESS\", \"1\")\n81|\treturn ExecRunner{Env: env}\n82|}\n83|\n84|// TestExecRunnerDeliversExactlyTheBuiltEnv proves the allowlist path end\n85|// to end: the operator builds an environment with secprim.BuildEnv, hands\n86|// it to ExecRunner, and the child observes exactly that — including the\n87|// absence of a parent-only marker, which proves no inheritance leak.\n88|func TestExecRunnerDeliversExactlyTheBuiltEnv(t *testing.T) {\n89|\tt.Setenv(\"SECPROBE_PARENT_ONLY\", \"present\")\n90|\tbuilt, err := secprim.BuildEnv(\n91|\t\t[]string{\"SECPROBE_HELPER_PROCESS\", \"PATH\"},\n92|\t\tmap[string]string{\"SECPROBE_LITERAL\": \"staged\"},\n93|\t\tos.LookupEnv,\n94|\t)\n95|\tif err != nil {\n96|\t\tt.Fatalf(\"BuildEnv: %v\", err)\n97|\t}\n98|\tobserved := childEnviron(t, helperRunner(t, built))\n99|\tif !reflect.DeepEqual(observed, built) {\n100|\t\tt.Fatalf(\"child observed %q, want exactly the built %q\", observed, built)\n101|\t}\n102|\tfor _, entry := range observed {\n103|\t\tif entry == \"SECPROBE_PARENT_ONLY=present\" {\n104|\t\t\tt.Fatal(\"parent-only variable leaked into the allowlisted child\")\n105|\t\t}\n106|\t}\n107|}\n108|\n109|// TestExecRunnerNilEnvInherits documents the unset policy: a nil Env\n110|// keeps the historical inherit-everything behavior until the operator\n111|// supplies an allowlist. The child must observe the parent-only marker,\n112|// proving inheritance is intact rather than silently emptied.\n113|func TestExecRunnerNilEnvInherits(t *testing.T) {\n114|\tt.Setenv(\"SECPROBE_PARENT_ONLY\", \"present\")\n115|\tobserved := childEnviron(t, helperRunner(t, nil))\n(more lines below)"}}}
