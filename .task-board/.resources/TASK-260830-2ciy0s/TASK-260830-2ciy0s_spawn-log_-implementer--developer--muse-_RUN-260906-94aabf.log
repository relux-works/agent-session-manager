{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c99b","stream":{"kind":"session","id":"01a076ec-3023-7ad0-af14-c3080467cd16"},"sequence":808,"recorded_at":1780531400001611,"record_type":"event","durability":"durable","causation_id":"29de407d-d987-4950-b9b4-211f15150d27","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"29de407d-d987-4950-b9b4-211f15150d27","run_stream":{"kind":"run","id":"29de407d-d987-4950-b9b4-211f15150d27"},"task_stream":{"kind":"task","id":"41c45623-e821-488d-aeba-d12556df98db"},"task_id":"41c45623-e821-488d-aeba-d12556df98db","event":{"kind":"output","task_id":"41c45623-e821-488d-aeba-d12556df98db","chunk":"{\n  \"chunk_id\": \"exec-30-1\",\n  \"command\": \"python3 -c \\\"\\nimport json\\nd=json.load(open('internal/traceability/ownership.v0.5.0.json'))\\nprint(json.dumps(d['ownership'],indent=1)[:3000])\\nprint('UNOWNED:', json.dumps(d['unowned_sections'])[:2000])\\nprint('AC sample:', json.dumps(d['acceptance_cases'][:5],indent=1)[:2000])\\n\\\"\",\n  \"description\": \"Inspect ownership and acceptance cases\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"[\\n {\\n  \\\"kind\\\": \\\"contract\\\",\\n  \\\"keys\\\": [\\n   \\\"Configuration [urn:ax:schema:config]\\\",\\n   \\\"Provider protocol [urn:ax:protocol:provider]\\\",\\n   \\\"Provider manifest [urn:ax:schema:provider-manifest]\\\",\\n   \\\"Provider probe [urn:ax:schema:provider-probe]\\\",\\n   \\\"Terminal Backend protocol [urn:ax:protocol:terminal-backend]\\\",\\n   \\\"Terminal Backend manifest [urn:ax:schema:terminal-backend-manifest]\\\",\\n   \\\"Terminal Backend probe [urn:ax:schema:terminal-backend-probe]\\\",\\n   \\\"Terminal Instance binding [urn:ax:schema:terminal-instance-binding]\\\",\\n   \\\"Terminal capability evidence [urn:ax:schema:terminal-capability-evidence]\\\",\\n   \\\"Session Adapter protocol [urn:ax:protocol:session-adapter]\\\",\\n   \\\"Session Adapt