\\\%s) admitted a reserved name\\\", segment)\\n\\t\\t}\\n\\t}\\n\\tordinary := []string{\\n\\t\\t\\\"CONSOLE\\\", \\\"console.txt\\\", \\\"COM10\\\", \\\"COM0\\\", \\\"LPT0\\\", \\\"LPT10\\\",\\n\\t\\t\\\"COM\\\", \\\"LPT\\\", \\\"AUXILIARY\\\", \\\"NULL\\\", \\\"file\\\", \\\"a.b\\\", \\\"\\\",\\n\\t}\\n\\tfor _, segment := range ordinary {\\n\\t\\tif IsReservedWindowsDeviceName(segment) {\\n\\t\\t\\tt.Errorf(\\\"IsReservedWindowsDeviceName(%q) = true, want false\\\", segment)\\n\\t\\t}\\n\\t}\\n}\\nEOF\\ngofmt -l internal/scalar/; go test ./internal/scalar/ ./internal/cliresult/ -count=1 2>&1 | tail -5\",\n  \"description\": \"Add device-name test and run suites\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"ok  \\tgithub.com/relux-works/agent-session-manager/internal/scalar\\t0.389s\\nok  \\tgithub.com/relux-works/agent-session-manager/internal/cliresult\\t0.856s\\n\",\n  \"original_output_bytes\": 149,\n  \"original_output_tokens\": 38,\n  \"truncated\": false\n}"}}}
