{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d4eb","stream":{"kind":"session","id":"01a076ec-3023-7ad0-af14-c3080467cd16"},"sequence":2256,"recorded_at":1780531400004507,"record_type":"event","durability":"durable","causation_id":"29de407d-d987-4950-b9b4-211f15150d27","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"29de407d-d987-4950-b9b4-211f15150d27","run_stream":{"kind":"run","id":"29de407d-d987-4950-b9b4-211f15150d27"},"task_stream":{"kind":"task","id":"78a3115f-7a40-4054-abf4-06a0c687071d"},"task_id":"78a3115f-7a40-4054-abf4-06a0c687071d","event":{"kind":"output","task_id":"78a3115f-7a40-4054-abf4-06a0c687071d","chunk":"edited\nchanged lines: lines 321-322\n--- original\n+++ updated\n@@\n-\t_, err = OpenNoFollowFile(filepath.Join(root, \"missing\"))\n-\trequireRefusal(t, err, ErrUnsafePath, \"secprim unsafe path: open failed: \"+filepath.Join(root, \"missing\"))\n+\t// Cause-carrying refusals pin the stable prefix, not the OS text: the\n+\t// errno rendering differs by platform while the rule and target do\n+\t// not. errors.Is still proves the kind, and errors.Is(err,\n+\t// fs.ErrNotExist) proves the cause survived.\n+\t_, err = OpenNoFollowFile(filepath.Join(root, \"missing\"))\n+\ttarget := filepath.Join(root, \"missing\")\n+\tif len(target) > 64 {\n+\t\ttarget = target[:64] + \"...\"\n+\t}\n+\trequireRefusalPrefix(t, err, ErrUnsafePath, \"secprim unsafe path: open failed: \"+target)\n+\tif !errors.Is(err, os.ErrNotExist) {\n+\t\tt.Fatalf(\"open cause does not wrap ErrNotExist: %v\", err)\n+\t}\n"}}}
