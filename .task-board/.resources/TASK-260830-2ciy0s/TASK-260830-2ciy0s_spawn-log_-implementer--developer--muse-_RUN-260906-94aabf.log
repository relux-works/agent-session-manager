{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c89f","stream":{"kind":"session","id":"01a076ec-3023-7ad0-af14-c3080467cd16"},"sequence":682,"recorded_at":1780531400001359,"record_type":"event","durability":"durable","causation_id":"29de407d-d987-4950-b9b4-211f15150d27","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"29de407d-d987-4950-b9b4-211f15150d27","run_stream":{"kind":"run","id":"29de407d-d987-4950-b9b4-211f15150d27"},"task_stream":{"kind":"task","id":"224cd7d1-e8c9-439c-a00c-d85e3dd2df02"},"task_id":"224cd7d1-e8c9-439c-a00c-d85e3dd2df02","event":{"kind":"output","task_id":"224cd7d1-e8c9-439c-a00c-d85e3dd2df02","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1i3qu7/worktree/internal/axerror/details.go`.\n1|package axerror\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"fmt\"\n7|\t\"regexp\"\n8|\t\"sort\"\n9|\t\"strings\"\n10|\t\"unicode/utf8\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n13|)\n14|\n15|// Details is the Section 15.1 diagnostic data map. The pinned document calls it\n16|// \"an explicitly open diagnostic data map, not an implicit schema extension\":\n17|// unknown keys are admitted as inert data, and nothing in this package derives\n18|// success, authority, or a remediation action from them.\n19|type Details map[string]any\n20|\n21|var (\n22|\t// ErrInvalidDetails reports a diagnostic map outside the Section 15.1\n23|\t// shape, bounds, or redaction rules.\n24|\tErrInvalidDetails = errors.New(\"invalid structured error details\")\n25|\n26|\t// ErrCausalLeak reports human text or a diagnostic value that reproduces\n27|\t// the rendered text of the Go cause the failure was built from. The cause\n28|\t// chain stays local; it is never copied onto the wire.\n29|\tErrCausalLeak = errors.New(\"structured error would carry its cause onto the wire\")\n30|)\n31|\n32|// detailKeyPattern is the Section 15.1 constraint on detail keys, verbatim:\n33|// \"0-64 keys matching [a-z][a-z0-9_]{0,63}\".\n34|var detailKeyPattern = regexp.MustCompile(`^[a-z][a-z0-9_]{0,63}$`)\n35|\n36|const (\n37|\tmaxDetailKeys      = 64\n38|\tmaxDetailDepth     = 4\n39|\tmaxDetailCanonical = 16 * 1024\n40|\tminRedactableCause = 8\n41|\tmaxMessageRunes    = 4096\n42|\tminMessageRunes    = 1\n43|)\n44|\n45|// excludedDetailKeys is the best-effort scanner Section 16.2 says an\n46|// implementation SHOULD offer. It refuses a detail key that names one of the\n47|// four classes Section 15.1 forbids outright — \"No detail may contain a\n48|// credential, raw transcript, environment secret, or opaque bundle content\" —\n49|// and nothing else.\n50|//\n51|// Matching is exact, never by substring, and that is deliberate. A substring\n52|// rule refusing every key containing \"token\", \"socket\" or \"credential\" would\n53|// refuse \"token_count\", \"socket_timeout_ms\" and \"credential_profile\" — ordinary\n54|// diagnostics the specification admits — while still passing a secret written\n55|// under an innocuous name. That is pure false-positive surface with no\n56|// true-positive capability, and it is the exact defect removed from the\n57|// Configuration extension-key validator: where the pinned document is silent\n58|// about a name, be permissive.\n59|//\n60|// The list is also scoped to Section 15.1's four classes rather than to the\n61|// whole Section 16.2 exclusion table. Section 16.2 governs manifests and\n62|// bundles generated by ax; a diagnostic key naming a PID, a tmux socket or a\n63|// Terminal Instance Binding is not a credential, a transcript, an environment\n64|// secret, or bundle content, and refusing it here would invent a constraint the\n65|// error contract does not state.\n66|var excludedDetailKeys = map[string]string{\n67|\t// Credential.\n68|\t\"access_token\":       \"credential\",\n69|\t\"api_key\":            \"credential\",\n70|\t\"auth_json\":          \"credential\",\n71|\t\"cookie\":             \"credential\",\n72|\t\"cookies\":            \"credential\",\n73|\t\"credential\":         \"credential\",\n74|\t\"credentials\":        \"credential\",\n75|\t\"oauth_token\":        \"credential\",\n76|\t\"passphrase\":         \"credential\",\n77|\t\"password\":           \"credential\",\n78|\t\"private_key\":        \"credential\",\n79|\t\"refresh_token\":      \"credential\",\n80|\t\"session_token\":      \"credential\",\n81|\t\"ssh_private_key\":    \"credential\",\n82|\t\"subscription_token\": \"credential\",\n83|\t// Raw transcript.\n84|\t\"raw_transcript\":      \"raw transcript\",\n85|\t\"scrollback\":          \"raw transcript\",\n86|\t\"terminal_scrollback\": \"raw transcript\",\n87|\t\"transcript\":          \"raw transcript\",\n88|\t// Environment secret.\n89|\t\"dotenv\":             \"environment secret\",\n90|\t\"env_secret\":         \"environment secret\",\n91|\t\"environment_secret\": \"environment secret\",\n92|\t\"secret\":             \"environment secret\",\n93|\t\"secrets\":            \"environment secret\",\n94|\t// Opaque bundle content.\n95|\t\"bundle_bytes\":   \"opaque bundle content\",\n96|\t\"bundle_content\": \"opaque bundle content\",\n97|\t\"opaque_bundle\":  \"opaque bundle content\",\n98|}\n99|\n100|// RedactionBound states what the gates below can and cannot decide. It is\n101|// quoted in README.md and asserted by this package's tests so that no caller\n102|// reads a refusal as a confidentiality guarantee. Section 16.2 is explicit:\n103|// \"v0.5.0 does not claim reliable content-level secret scrubbing\", and this\n104|// implementation claims no more than the pinned document does.\n105|const RedactionBound = \"Detail redaction decides two things: whether a key exactly names one of the four classes \" +\n106|\t\"Section 15.1 forbids, and whether human text or a diagnostic value reproduces the rendered local cause \" +\n107|\t\"verbatim. It inspects no free-form value for secret content, matches no key by substring, and admits a \" +\n108|\t\"secret written under an innocuously named key. Section 16.2 does not claim content-level scrubbing and \" +\n109|\t\"neither does this package.\"\n110|\n111|// ValidateDetails checks a diagnostic map against every Section 15.1 bound: the\n112|// key count, the key grammar, the value nesting depth, the canonical byte size,\n113|// and the four Section 15.1 detail classes that an exact key name makes decidable.\n114|//\n115|// The nesting bound counts containers opened by a detail value, matching the\n116|// extension-value convention already used for canonical records: a value may\n117|// open four containers and the fifth is refused.\n118|func ValidateDetails(details Details) error {\n119|\tif details == nil {\n120|\t\treturn fmt.Errorf(\"%w: details is required and must not be null\", ErrInvalidDetails)\n121|\t}\n122|\tif len(details) > maxDetailKeys {\n123|\t\treturn fmt.Errorf(\"%w: %d keys exceed the maximum of %d\", ErrInvalidDetails, len(details), maxDetailKeys)\n124|\t}\n125|\tfor _, key := range sortedKeys(details) {\n126|\t\tif !detailKeyPattern.MatchString(key) {\n127|\t\t\treturn fmt.Errorf(\"%w: key %q does not match [a-z][a-z0-9_]{0,63}\", ErrInvalidDetails, key)\n128|\t\t}\n129|\t\tif err := refuseExcludedKey(key); err != nil {\n130|\t\t\treturn err\n131|\t\t}\n132|\t\tif err := validateDetailValue(key, details[key], 0); err != nil {\n133|\t\t\treturn err\n134|\t\t}\n135|\t}\n136|\tmeasured, err := canonicaljson.CanonicalByteLength(map[string]any(details))\n137|\tif err != nil {\n138|\t\treturn fmt.Errorf(\"%w: measure canonical details: %v\", ErrInvalidDetails, err)\n139|\t}\n140|\tif measured > maxDetailCanonical {\n141|\t\treturn fmt.Errorf(\n142|\t\t\t\"%w: canonical details are %d bytes, maximum is %d\", ErrInvalidDetails, measured, maxDetailCanonical)\n143|\t}\n144|\treturn nil\n145|}\n146|\n147|func refuseExcludedKey(key string) error {\n148|\tif class, excluded := excludedDetailKeys[key]; excluded {\n149|\t\treturn fmt.Errorf(\"%w: key %q names %s, which no detail may contain\", ErrInvalidDetails, key, class)\n150|\t}\n151|\treturn nil\n152|}\n153|\n154|func validateDetailValue(key string, value any, depth int) error {\n155|\tswitch typed := value.(type) {\n156|\tcase nil, bool, json.Number:\n157|\t\treturn nil\n158|\tcase string:\n159|\t\tif !utf8.ValidString(typed) {\n160|\t\t\treturn fmt.Errorf(\"%w: details[%q] contains invalid UTF-8\", ErrInvalidDetails, key)\n161|\t\t}\n162|\t\treturn nil\n163|\tcase []any:\n164|\t\tif depth == maxDetailDepth {\n165|\t\t\treturn fmt.Errorf(\"%w: details[%q] exceeds maximum nesting depth %d\", ErrInvalidDetails, key, maxDetailDepth)\n166|\t\t}\n167|\t\tfor _, member := range typed {\n168|\t\t\tif err := validateDetailValue(key, member, depth+1); err != nil {\n169|\t\t\t\treturn err\n170|\t\t\t}\n171|\t\t}\n172|\t\treturn nil\n173|\tcase map[string]any:\n174|\t\tif depth == maxDetailDepth {\n175|\t\t\treturn fmt.Errorf(\"%w: details[%q] exceeds maximum nesting depth %d\", ErrInvalidDetails, key, maxDetailDepth)\n176|\t\t}\n177|\t\tfor _, nested := range sortedKeys(typed) {\n178|\t\t\tif !utf8.ValidString(nested) {\n179|\t\t\t\treturn fmt.Errorf(\"%w: details[%q] has an object key that is not valid UTF-8\", ErrInvalidDetails, key)\n180|\t\t\t}\n181|\t\t\tif err := refuseExcludedKey(nested); err != nil {\n182|\t\t\t\treturn err\n183|\t\t\t}\n184|\t\t\tif err := validateDetailValue(key, typed[nested], depth+1); err != nil {\n185|\t\t\t\treturn err\n186|\t\t\t}\n187|\t\t}\n188|\t\treturn nil\n189|\tdefault:\n190|\t\treturn fmt.Errorf(\"%w: details[%q] uses unsupported JSON type %T\", ErrInvalidDetails, key, value)\n191|\t}\n192|}\n193|\n194|// refuseCausalLeak refuses human text or diagnostic values that reproduce the\n195|// rendered text of the local cause verbatim. It exists because the ordinary way\n196|// to lose a secret is fmt.Errorf(\"...: %v\", err) on a cause that wrapped a\n197|// command line, a transport payload, or a provider's stderr.\n198|//\n199|// What it decides is narrow and stated: verbatim containment of the whole\n200|// rendered cause, and of each of its wrapped links. A paraphrase, a truncation,\n201|// or a single extracted field of the cause is not detected. Causes shorter than\n202|// minRedactableCause characters are skipped, because a cause rendering as\n203|// \"EOF\" would otherwise refuse every message containing that substring.\n204|func refuseCausalLeak(message string, details Details, cause error) error {\n205|\tfor _, rendered := range causeChainText(cause) {\n206|\t\tif utf8.RuneCountInString(rendered) < minRedactableCause {\n207|\t\t\tcontinue\n208|\t\t}\n209|\t\tif strings.Contains(message, rendered) {\n210|\t\t\treturn fmt.Errorf(\"%w: message reproduces the local cause verbatim\", ErrCausalLeak)\n211|\t\t}\n212|\t\tfor _, key := range sortedKeys(details) {\n213|\t\t\tif valueContains(details[key], rendered) {\n214|\t\t\t\treturn fmt.Errorf(\"%w: details[%q] reproduces the local cause verbatim\", ErrCausalLeak, key)\n215|\t\t\t}\n216|\t\t}\n217|\t}\n218|\treturn nil\n219|}\n220|\n221|// causeChainText renders every link of the cause chain. Checking only the\n222|// outermost rendering would miss a message that copied the innermost wrapped\n223|// error, which is the link most likely to hold the untrusted text.\n224|func causeChainText(cause error) []string {\n225|\tvar rendered []string\n226|\tfor current := cause; current != nil; {\n227|\t\trendered = append(rendered, current.Error())\n228|\t\tswitch unwrapped := current.(type) {\n229|\t\tcase interface{ Unwrap() error }:\n230|\t\t\tcurrent = unwrapped.Unwrap()\n231|\t\tcase interface{ Unwrap() []error }:\n232|\t\t\tfor _, joined := range unwrapped.Unwrap() {\n233|\t\t\t\trendered = append(rendered, causeChainText(joined)...)\n234|\t\t\t}\n235|\t\t\tcurrent = nil\n236|\t\tdefault:\n237|\t\t\tcurrent = nil\n238|\t\t}\n239|\t}\n240|\treturn rendered\n241|}\n242|\n243|func valueContains(value any, needle string) bool {\n244|\tswitch typed := value.(type) {\n245|\tcase string:\n246|\t\treturn strings.Contains(typed, needle)\n247|\tcase []any:\n248|\t\tfor _, member := range typed {\n249|\t\t\tif valueContains(member, needle) {\n250|\t\t\t\treturn true\n251|\t\t\t}\n252|\t\t}\n253|\tcase map[string]any:\n254|\t\tfor _, member := range typed {\n255|\t\t\tif valueContains(member, needle) {\n256|\t\t\t\treturn true\n257|\t\t\t}\n258|\t\t}\n259|\t}\n260|\treturn false\n261|}\n262|\n263|func sortedKeys[Value any](source map[string]Value) []string {\n264|\tkeys := make([]string, 0, len(source))\n265|\tfor key := range source {\n266|\t\tkeys = append(keys, key)\n267|\t}\n268|\tsort.Strings(keys)\n269|\treturn keys\n270|}\n271|\n272|// RealmEvidence is the exact typed detail set Section 15.3 requires when\n273|// broker, tmux server generation, or functional-sentinel evidence is missing or\n274|// unsafe: \"capability_unavailable with typed details containing capability,\n275|// caller_realm, broker_state, tmux_server_generation, and remediation\".\n276|//\n277|// tmux_server_generation is carried here on that clause's explicit instruction.\n278|// The Section 16.2 exclusion of backend generations governs manifests and\n279|// bundles generated by ax, and the more specific clause licenses this one\n280|// diagnostic field.\n281|type RealmEvidence struct {\n282|\tCapability           string\n283|\tCallerRealm          string\n284|\tBrokerState          string\n285|\tTmuxServerGeneration string\n286|\tRemediation          string\n287|}\n288|\n289|// Details renders the typed set. Every field is required, because a caller that\n290|// omits one has not produced the typed details the clause names.\n291|func (evidence RealmEvidence) Details() (Details, error) {\n292|\treturn requiredTypedDetails(map[string]string{\n293|\t\t\"capability\":             evidence.Capability,\n294|\t\t\"caller_realm\":           evidence.CallerRealm,\n295|\t\t\"broker_state\":           evidence.BrokerState,\n296|\t\t\"tmux_server_generation\": evidence.TmuxServerGeneration,\n297|\t\t\"remediation\":            evidence.Remediation,\n298|\t})\n299|}\n300|\n301|// TargetAuth is the exact typed detail set Section 15.3 requires for\n302|// target_auth_missing: \"typed provider_id, provider_build, macos_version,\n303|// tmux_server_generation, and remediation\".\n304|type TargetAuth struct {\n305|\tProviderID           string\n306|\tProviderBuild        string\n307|\tMacOSVersion         string\n308|\tTmuxServerGeneration string\n309|\tRemediation          string\n310|}\n311|\n312|// Details renders the typed set. Every field is required.\n313|func (target TargetAuth) Details() (Details, error) {\n314|\treturn requiredTypedDetails(map[string]string{\n315|\t\t\"provider_id\":            target.ProviderID,\n316|\t\t\"provider_build\":         target.ProviderBuild,\n317|\t\t\"macos_version\":          target.MacOSVersion,\n318|\t\t\"tmux_server_generation\": target.TmuxServerGeneration,\n319|\t\t\"remediation\":            target.Remediation,\n320|\t})\n321|}\n322|\n323|// targetAuthMissingKeys is the presence requirement New enforces for\n324|// target_auth_missing, so the generic constructor cannot emit that code with a\n325|// weaker detail set than the typed constructor produces.\n326|var targetAuthMissingKeys = []string{\n327|\t\"macos_version\",\n328|\t\"provider_build\",\n329|\t\"provider_id\",\n330|\t\"remediation\",\n331|\t\"tmux_server_generation\",\n332|}\n333|\n334|func requiredTypedDetails(fields map[string]string) (Details, error) {\n335|\tdetails := make(Details, len(fields))\n336|\tfor _, key := range sortedKeys(fields) {\n337|\t\tif fields[key] == \"\" {\n338|\t\t\treturn nil, fmt.Errorf(\"%w: typed detail %q is required and must not be empty\", ErrInvalidDetails, key)\n339|\t\t}\n340|\t\tdetails[key] = fields[key]\n341|\t}\n342|\tif err := ValidateDetails(details); err != nil {\n343|\t\treturn nil, err\n344|\t}\n345|\treturn details, nil\n346|}\n347|\n348|func requireDetailKeys(code Code, details Details, required []string) error {\n349|\tfor _, key := range required {\n350|\t\tvalue, present := details[key]\n351|\t\tif !present {\n352|\t\t\treturn fmt.Errorf(\"%w: %q requires typed detail %q\", ErrInvalidDetails, code, key)\n353|\t\t}\n354|\t\ttext, ok := value.(string)\n355|\t\tif !ok || text == \"\" {\n356|\t\t\treturn fmt.Errorf(\"%w: %q requires a non-empty typed detail %q\", ErrInvalidDetails, code, key)\n357|\t\t}\n358|\t}\n359|\treturn nil\n360|}"}}}
