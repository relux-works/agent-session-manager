retSiteRosterIsComplete\",\n317|         narrows=\"INSTRUMENT: drops one census token, rows orphan\"),\n318|    dict(id=\"D9\", file=\"internal/secprim/classes_test.go\",\n319|         old='class: \"Provider credentials\",',\n320|         new='class: \"Provider credentials (renamed)\",',\n321|         pkg=\"./internal/secprim/\", run=\"TestExclusionClassRosterIsComplete\",\n322|         kill=\"TestExclusionClassRosterIsComplete\",\n323|         narrows=\"INSTRUMENT: renames one class row, derivation orphans it\"),\n324|    dict(id=\"D19\", file=\"internal/secprim/nofollow.go\",\n325|         old='''\tfile, err := openNoFollow(path)\n326|\tif err != nil {\n327|\t\treturn nil, failPath(\"open failed\", memberErrorTarget(path)).WithCause(err)\n328|\t}''',\n329|         new='''\tfile, err := openNoFollow(path)\n330|\tif err != nil && false {\n331|\t\treturn nil, failPath(\"open failed\", memberErrorTarget(path)).WithCause(err)\n332|\t}''',\n333|         pkg=\"./internal/secprim/\", run=\"TestOpenNoFollowFile\",\n334|         kill=\"TestOpenNoFollowFile\",\n335|         narrows=\"DELETION: ignores the kernel open error (killed via panic)\"),\n336|]\n337|\n338|BY_ID = {m[\"id\"]: m for m in MUTANTS}\n339|\n340|\n341|def run_one(mid):\n342|    m = BY_ID[mid]\n343|    path = m[\"file\"]\n344|    with open(path, encoding=\"utf-8\") as f:\n345|        src = f.read()\n346|    if src.count(m[\"old\"]) != 1:\n347|        return (mid, \"ERROR\", \"anchor count %d\" % src.count(m[\"old\"]), m[\"narrows\"])\n348|    with open(path + \".mutbak\", \"w\", encoding=\"utf-8\") as f:\n349|        f.write(src)\n350|    try:\n351|        with open(path, \"w\", encoding=\"utf-8\") as f:\n352|            f.write(src.replace(m[\"old\"], m[\"new\"]))\n353|        p = subprocess.run([\"go\", \"test\", m[\"pkg\"], \"-count=1\", \"-run\", m[\"run\"]],\n354|                           capture_output=True, text=True, timeout=240)\n355|        out = p.stdout + p.stderr\n356|        if p.returncode ==