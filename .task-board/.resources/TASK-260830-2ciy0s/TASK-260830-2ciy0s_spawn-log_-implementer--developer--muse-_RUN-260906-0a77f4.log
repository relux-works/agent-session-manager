{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c513","stream":{"kind":"session","id":"01a07750-3853-73c0-b383-0773367c2b50"},"sequence":228,"recorded_at":1780531400000451,"record_type":"event","durability":"durable","causation_id":"54033564-b97c-4244-a825-33fd926ad5cb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"54033564-b97c-4244-a825-33fd926ad5cb","run_stream":{"kind":"run","id":"54033564-b97c-4244-a825-33fd926ad5cb"},"call_id":"call_01a0775090ec7522a78c6ac11d453712","text":"Read text file `internal/secprim/open_nofollow_unix.go`.\n1|//go:build !windows\n2|\n3|package secprim\n4|\n5|import (\n6|\t\"os\"\n7|\n8|\t\"golang.org/x/sys/unix\"\n9|)\n10|\n11|// openNoFollow opens path read-only without following a trailing symlink:\n12|// O_NOFOLLOW makes the open itself fail on a symlink target instead of\n13|// traversing it. O_CLOEXEC keeps the descriptor out of any spawned child.\n14|// O_NONBLOCK keeps a FIFO from stalling the opener: a read-only open of\n15|// a FIFO with no writer blocks in the kernel, and the post-open shape\n16|// check that refuses it runs only after the open returns, so without\n17|// this flag the refusal is unreachable and the caller hangs instead.\n18|// The caller clears the flag on admitted regular files.\n19|func openNoFollow(path string) (*os.File, error) {\n20|\treturn os.OpenFile(path, os.O_RDONLY|unix.O_NOFOLLOW|unix.O_CLOEXEC|unix.O_NONBLOCK, 0)\n21|}\n22|\n23|// openNoFollowDir opens a directory read-only without following a trailing\n24|// symlink, returning a handle that pins the directory for validation walks\n25|// (Fstat, ReadDirnames) instead of re-resolving its name.\n26|func openNoFollowDir(path string) (*os.File, error) {\n27|\treturn os.OpenFile(path, os.O_RDONLY|unix.O_NOFOLLOW|unix.O_CLOEXEC|unix.O_DIRECTORY, 0)\n28|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c515","stream":{"kind":"session","id":"01a07750-3853-73c0-b383-0773367c2b50"},"sequence":229,"recorded_at":1780531400000453,"record_type":"event","durability":"durable","causation_id":"54033564-b97c-4244-a825-33fd926ad5cb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"54033564-b97c-4244-a825-33fd926ad5cb","run_stream":{"kind":"run","id":"54033564-b97c-4244-a825-33fd926ad5cb"},"call_id":"call_01a0775091937823a70c84148ba9cf27","text":"Read text file `internal/secprim/open_nofollow_windows.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"os\"\n5|)\n6|\n7|// openNoFollow is the Windows best effort: Go has no O_NOFOLLOW, so the\n8|// caller (OpenNoFollowFile) stats with Lstat first and refuses symlinks,\n9|// reparse points, and non-regular targets before opening. The Lstat/open\n10|// check-then-open race remains: a swapped path between the two calls is\n11|// not detected. Staging roots are owner-only directories, which narrows\n12|// the swap window to the owner, but the bound is stated, not closed: a\n13|// compromised owner account can still win the race. Unix builds close it\n14|// with O_NOFOLLOW instead.\n15|//\n16|// Reparse coverage (established from the Go 1.23+ runtime source,\n17|// src/os/types_windows.go: Go sets ModeSymlink only for\n18|// IO_REPARSE_TAG_SYMLINK). Every other reparse point — junctions and\n19|// mount points, AppExecLinks, cloud placeholders — surfaces as\n20|// ModeIrregular, never as ModeSymlink, so a symlink-only gate would\n21|// admit a junction-to-directory as a plain directory. The gate below\n22|// therefore refuses ModeIrregular alongside ModeSymlink. Windows\n23|// behavior in this package is compile-and-vet only, never executed:\n24|// the refusal shape above is established from the cited source, not\n25|// from a run.\n26|func openNoFollow(path string) (*os.File, error) {\n27|\tinfo, err := os.Lstat(path)\n28|\tif err != nil {\n29|\t\treturn nil, err\n30|\t}\n31|\tif info.Mode()&(os.ModeSymlink|os.ModeIrregular) != 0 {\n32|\t\treturn nil, errIsSymlink\n33|\t}\n34|\treturn os.OpenFile(path, os.O_RDONLY, 0)\n35|}\n36|\n37|// openNoFollowDir opens a directory for validation walks after the same\n38|// Lstat gate. The same check-then-open bound applies.\n39|func openNoFollowDir(path string) (*os.File, error) {\n40|\tinfo, err := os.Lstat(path)\n41|\tif err != nil {\n42|\t\treturn nil, err\n43|\t}\n44|\tif info.Mode()&(os.ModeSymlink|os.ModeIrregular) != 0 {\n45|\t\treturn nil, errIsSymlink\n46|\t}\n47|\treturn os.Open(path)\n48|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c517","stream":{"kind":"session","id":"01a07750-3853-73c0-b383-0773367c2b50"},"sequence":230,"recorded_at":1780531400000455,"record_type":"event","durability":"durable","causation_id":"54033564-b97c-4244-a825-33fd926ad5cb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"54033564-b97c-4244-a825-33fd926ad5cb","run_stream":{"kind":"run","id":"54033564-b97c-4244-a825-33fd926ad5cb"},"call_id":"call_01a07750921a7b419b6e38b2450bf8b6","text":"Read text file `internal/secprim/doc.go`.\n1|// Package secprim implements the AX shared safe process and filesystem\n2|// primitives of pinned specification Sections 16.3, 16.4, and 16.7: no-follow\n3|// path handling, staging containment, structured argv, environment\n4|// allowlists, terminal control-string escaping, and secret redaction for\n5|// free-text streams.\n6|//\n7|// The package is a library behind production launch and rendering paths,\n8|// not a second authority beside them:\n9|//\n10|//   - path grammars stay in internal/scalar: CheckMemberPath admits exactly\n11|//     the scalar relative-path grammar plus the Windows alternate-stream,\n12|//     trailing-dot/space, and reserved-device rules Section 16.3 names, and\n13|//     delegates every shared rule to scalar rather than retyping it;\n14|//   - byte-counted exec rules (Provider SpawnPlan argv and env literals,\n15|//     Section 5.1) stay in internal/provhost: that package validates the\n16|//     wire plan, while this package builds the launch environment and\n17|//     validates the argv vector at process start;\n18|//   - environment-name grammar is owned here and internal/provhost delegates\n19|//     to it, so the two packages cannot drift on what a name is;\n20|//   - Structured Error detail redaction stays in internal/axerror: that\n21|//     package refuses exact credential keys and causal leaks on the error\n22|//     wire, while this package scrubs free-text streams (stderr, logs,\n23|//     terminal rendering) where no key gate can see;\n24|//   - SSH argv admission stays in internal/config and the provider entry\n25|//     point rule (`ax pane SESSION_ID`) stays in internal/terminalbackend:\n26|//     both are closed vocabularies over their own domain, not instances of\n27|//     the generic argv rule here;\n28|//   - the five-variable AX_* path registry stays in internal/config and\n29|//     internal/localstore, which already implement AC-PATH-001.\n30|//\n31|// Trust for external executables is deliberately not implemented here.\n32|// internal/provider.trustCandidate and internal/terminalbackend.DigestFile\n33|// already establish trust with different fact sets because their\n34|// specifications differ: Section 7.1 requires the approving owner identity\n35|// beside the canonical path and digest for provider plugins, while the\n36|// Section 4.B trust tuple carries platform, adapter identity, manifest and\n37|// probe digests with no owner fact. A third path here would be another\n38|// copy, not convergence; the difference is contractual, not accidental.\n39|//\n40|// Every refusal is a plain *Error naming the kind, rule, and member:\n41|// facades keep their own refusal dialects, so this package names rules\n42|// instead of minting codes, following internal/environ.\n43|//\n44|// Stated bounds. This package mutates no durable state and keeps no cache:\n45|// Guard resolution is lexical, OpenNoFollowFile opens read-only, and every\n46|// other entry point is a pure function of its input. Crash and idempotency\n47|// handling therefore have no surface here: there is no journal to recover\n48|// and no second actor to collide with. Tombstone deletion scope (Section\n49|// 16.3 \"broad deletion from tombstones\") has no implementation in this\n50|// repository yet and is not modeled. The operator default for which\n51|// environment names a provider plugin inherits is product policy with no\n52|// in-repo provider implementation to derive needs from, so BuildEnv takes\n53|// the allowlist explicitly and ExecRunner inherits the parent environment\n54|// until the operator supplies one. Grapheme-width policing stops at the\n55|// enumerated invisible controls: full East-Asian/emoji width measurement\n56|// needs terminal width tables this package does not carry. Content-level\n57|// secret scrubbing is best-effort by specification (Section 16.2 claims no\n58|// reliable scrubbing), and Redact states exactly the three shapes it\n59|// decides.\n60|package secprim","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c519","stream":{"kind":"session","id":"01a07750-3853-73c0-b383-0773367c2b50"},"sequence":231,"recorded_at":1780531400000457,"record_type":"event","durability":"durable","causation_id":"54033564-b97c-4244-a825-33fd926ad5cb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"54033564-b97c-4244-a825-33fd926ad5cb","run_stream":{"kind":"run","id":"54033564-b97c-4244-a825-33fd926ad5cb"},"call_id":"call_01a0775092b577b395043e5d7f0700c1","text":"Read text file `internal/secprim/classes_test.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"go/ast\"\n6|\t\"go/parser\"\n7|\t\"go/token\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"sort\"\n11|\t\"strings\"\n12|\t\"testing\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n15|)\n16|\n17|// derivedExclusionClasses derives the Section 16.2 mandatory-exclusion\n18|// classes from the pinned specification document itself: every body row of\n19|// the Class table in Section 16.2. A class added to or removed from the\n20|// specification fails the roster below instead of passing silently.\n21|func derivedExclusionClasses(t *testing.T) []string {\n22|\tt.Helper()\n23|\tdocument, err := specdoc.Load()\n24|\tif err != nil {\n25|\t\tt.Fatalf(\"specdoc.Load: %v\", err)\n26|\t}\n27|\tvar classes []string\n28|\tseen := map[string]bool{}\n29|\tfor number := 1; number <= document.LineCount(); number++ {\n30|\t\trow, ok := document.TableRowAt(number)\n31|\t\tif !ok || row.Header != \"Class\" {\n32|\t\t\tcontinue\n33|\t\t}\n34|\t\tsection, ok := document.SectionID(row.Line)\n35|\t\tif !ok || section != \"16.2\" {\n36|\t\t\tcontinue\n37|\t\t}\n38|\t\tif seen[row.FirstCell] {\n39|\t\t\tcontinue\n40|\t\t}\n41|\t\tseen[row.FirstCell] = true\n42|\t\tclasses = append(classes, row.FirstCell)\n43|\t}\n44|\tif len(classes) == 0 {\n45|\t\tt.Fatal(\"derived no Section 16.2 exclusion classes; the scanner is broken, not the document\")\n46|\t}\n47|\tsort.Strings(classes)\n48|\treturn classes\n49|}\n50|\n51|// exclusionRow pairs one derived Section 16.2 class with its disposition:\n52|// which mechanism keeps that class out of artifacts, and which test\n53|// proves the mechanism. Every derived class carries exactly one row.\n54|type exclusionRow struct {\n55|\tclass       string\n56|\tdisposition string\n57|\twitnesses   []string\n58|}\n59|\n60|// exclusionRows is the reviewed disposition half of the Section 16.2\n61|// census. Dispositions are one of: scrub (the Redact stream arms),\n62|// refuse (a boundary gate), structural (never logged by construction),\n63|// or nopath (no in-repo emission path carries the class — the M0-stage\n64|// bound, proven by TestNoArchiveEmissionPath plus the secret-site\n65|// roster).\n66|func exclusionRows() []exclusionRow {\n67|\treturn []exclusionRow{\n68|\t\t{\n69|\t\t\tclass: \"Provider credentials\",\n70|\t\t\tdisposition: \"scrub for free text (Redact corpus and key=value arms) and refuse for structured \" +\n71|\t\t\t\t\"diagnostics (the axerror excluded-key gate)\",\n72|\t\t\twitnesses: []string{\n73|\t\t\t\t\"secprim.TestRedactSensitivePairs\",\n74|\t\t\t\t\"secprim.TestSecretAxerrorTableRefused\",\n75|\t\t\t},\n76|\t\t},\n77|\t\t{\n78|\t\t\tclass: \"SSH/private identity\",\n79|\t\t\tdisposition: \"scrub for free text (the Redact private-key block arm for key material, corpus and \" +\n80|\t\t\t\t\"key arms for the rest) and refuse for structured diagnostics\",\n81|\t\t\twitnesses: []string{\n82|\t\t\t\t\"secprim.TestRedactPrivateKeyBlocks\",\n83|\t\t\t\t\"secprim.TestSecretAxerrorTableRefused\",\n84|\t\t\t},\n85|\t\t},\n86|\t\t{\n87|\t\t\tclass: \"Environment secrets\",\n88|\t\t\tdisposition: \"scrub for free text and refuse for structured diagnostics; SpawnPlan literals are \" +\n89|\t\t\t\t\"additionally bounded and disjoint by the provhost wire gate, whose secrecy itself is an \" +\n90|\t\t\t\t\"operator obligation no content inspection could prove\",\n91|\t\t\twitnesses: []string{\n92|\t\t\t\t\"secprim.TestRedactCorpusValues\",\n93|\t\t\t\t\"secprim.TestSecretAxerrorTableRefused\",\n94|\t\t\t\t\"provhost.TestDecodeSpawnPlanRefusals\",\n95|\t\t\t},\n96|\t\t},\n97|\t\t{\n98|\t\t\tclass: \"Machine authentication\",\n99|\t\t\tdisposition: \"nopath (archive-format bound): the recursive import scan proves no production file \" +\n100|\t\t\t\t\"imports an archive writer that could carry keychain, secret-service, credential-manager, or \" +\n101|\t\t\t\t\"login-token handling into a bundle — not that no such handling exists anywhere; the \" +\n102|\t\t\t\t\"secret-site roster proves no field whose name carries one of the 13 census tokens exists \" +\n103|\t\t\t\t\"outside the dispositioned tables (names outside that vocabulary are outside the witness, \" +\n104|\t\t\t\t\"stated in the census bound); key-shaped text is still scrubbed where it matches\",\n105|\t\t\twitnesses: []string{\n106|\t\t\t\t\"secprim.TestSecretSiteRosterIsComplete\",\n107|\t\t\t\t\"secprim.TestNoArchiveEmissionPath\",\n108|\t\t\t},\n109|\t\t},\n110|\t\t{\n111|\t\t\tclass: \"Live process identity\",\n112|\t\t\tdisposition: \"nopath (archive-format bound) for transfer plus structural for diagnostics: the \" +\n113|\t\t\t\t\"recursive import scan proves no archive-writer path exists to audit for PID or handle \" +\n114|\t\t\t\t\"transfer — not the absence of every non-archive emission shape — and PIDs and handles \" +\n115|\t\t\t\t\"never enter Structured Errors because the causal-leak gate refuses cause text verbatim\",\n116|\t\t\twitnesses: []string{\n117|\t\t\t\t\"secprim.TestNoArchiveEmissionPath\",\n118|\t\t\t\t\"axerror.TestCauseNeverReachesTheWire\",\n119|\t\t\t},\n120|\t\t},\n121|\t\t{\n122|\t\t\tclass: \"IPC/runtime\",\n123|\t\t\tdisposition: \"nopath (archive-format bound): the recursive import scan proves no archive-writer \" +\n124|\t\t\t\t\"transfer path exists — not the absence of every socket, pipe, or tmux-server-socket shape; \" +\n125|\t\t\t\t\"socket-shaped names in diagnostics are inert text\",\n126|\t\t\twitnesses: []string{\n127|\t\t\t\t\"secprim.TestNoArchiveEmissionPath\",\n128|\t\t\t\t\"secprim.TestSecretSiteRosterIsComplete\",\n129|\t\t\t},\n130|\t\t},\n131|\t\t{\n132|\t\t\tclass: \"TerminalBackend runtime\",\n133|\t\t\tdisposition: \"refuse by vocabulary: bindings, native references, endpoints, tokens, relay \" +\n134|\t\t\t\t\"credentials, and observations are classified sensitive-owner-only or forbidden and never \" +\n135|\t\t\t\t\"replicate as live authority\",\n136|\t\t\twitnesses: []string{\n137|\t\t\t\t\"terminalbackend.TestReplicationClassificationIsClosed\",\n138|\t\t\t},\n139|\t\t},\n140|\t\t{\n141|\t\t\tclass: \"Transient locking\",\n142|\t\t\tdisposition: \"nopath (archive-format bound): the recursive import scan proves lock files, WAL/SHM \" +\n143|\t\t\t\t\"journals, and PID locks have no archive-writer emission path — not the absence of every \" +\n144|\t\t\t\t\"non-archive export shape; the owner-only staging roots they guard are validated by the \" +\n145|\t\t\t\t\"no-follow gates\",\n146|\t\t\twitnesses: []string{\n147|\t\t\t\t\"secprim.TestNoArchiveEmissionPath\",\n148|\t\t\t\t\"secprim.TestOpenNoFollowDir\",\n149|\t\t\t},\n150|\t\t},\n151|\t\t{\n152|\t\t\tclass: \"Mutable derived indexes\",\n153|\t\t\tdisposition: \"nopath (archive-format bound): the recursive import scan proves SQLite projections \" +\n154|\t\t\t\t\"and provider caches have no archive-writer export path — not the absence of every \" +\n155|\t\t\t\t\"non-archive export shape; they are rebuilt locally\",\n156|\t\t\twitnesses: []string{\n157|\t\t\t\t\"secprim.TestNoArchiveEmissionPath\",\n158|\t\t\t\t\"secprim.TestSecretSiteRosterIsComplete\",\n159|\t\t\t},\n160|\t\t},\n161|\t}\n162|}\n163|\n164|// TestExclusionClassRosterIsComplete requires every derived Section 16.2\n165|// class to carry exactly one disposition row, and every row to resolve to\n166|// a derived class.\n167|func TestExclusionClassRosterIsComplete(t *testing.T) {\n168|\tderived := derivedExclusionClasses(t)\n169|\trows := exclusionRows()\n170|\tseen := map[string]bool{}\n171|\tfor _, row := range rows {\n172|\t\tfound := false\n173|\t\tfor _, class := range derived {\n174|\t\t\tif row.class == class {\n175|\t\t\t\tfound = true\n176|\t\t\t\tbreak\n177|\t\t\t}\n178|\t\t}\n179|\t\tif !found {\n180|\t\t\tt.Fatalf(\"orphaned exclusion row %q: the specification derives no such class\", row.class)\n181|\t\t}\n182|\t\tif seen[row.class] {\n183|\t\t\tt.Fatalf(\"duplicate exclusion row %q\", row.class)\n184|\t\t}\n185|\t\tseen[row.class] = true\n186|\t}\n187|\tvar missing []string\n188|\tfor _, class := range derived {\n189|\t\tif !seen[class] {\n190|\t\t\tmissing = append(missing, class)\n191|\t\t}\n192|\t}\n193|\tif len(missing) > 0 {\n194|\t\tt.Fatalf(\"derived exclusion classes with no disposition:\\n  %s\", strings.Join(missing, \"\\n  \"))\n195|\t}\n196|\tif len(derived) != 9 {\n197|\t\tt.Fatalf(\"derived %d exclusion classes, want the 9 of Section 16.2: %q\", len(derived), derived)\n198|\t}\n199|}\n200|\n201|// TestExclusionWitnessesExist verifies every cited witness names a real\n202|// test, reusing the declaration walk from the site census.\n203|func TestExclusionWitnessesExist(t *testing.T) {\n204|\tt.Parallel()\n205|\tneeded := map[string]map[string]bool{}\n206|\tfor _, row := range exclusionRows() {\n207|\t\tfor _, witness := range row.witnesses {\n208|\t\t\tparts := strings.Split(witness, \".\")\n209|\t\t\tif len(parts) != 2 {\n210|\t\t\t\tt.Fatalf(\"witness %q is not package.Test shaped\", witness)\n211|\t\t\t}\n212|\t\t\tif needed[parts[0]] == nil {\n213|\t\t\t\tneeded[parts[0]] = map[string]bool{}\n214|\t\t\t}\n215|\t\t\tneeded[parts[0]][parts[1]] = true\n216|\t\t}\n217|\t}\n218|\tfor pkg, names := range needed {\n219|\t\tfound := testFuncNames(t, pkg)\n220|\t\tfor name := range names {\n221|\t\t\tif !found[name] {\n222|\t\t\t\tt.Errorf(\"witness %s.%s does not exist; the census cites a ghost\", pkg, name)\n223|\t\t\t}\n224|\t\t}\n225|\t}\n226|}\n227|\n228|// TestNoArchiveEmissionPath proves the archive-format bound behind the\n229|// nopath dispositions above: no production file anywhere under\n230|// internal/ imports an archive writer, so no code path can carry an\n231|// excluded class into a bundle through one.\n232|//\n233|// The walk is recursive over every nested production package\n234|// (internal/catalog/cmd/cataloggen and\n235|// internal/traceability/cmd/tracecheck included): a one-level scan\n236|// proved blind to nested trees. A file the parser cannot read fails\n237|// the test rather than passing silently, so an unparseable package is\n238|// a closed failure, never a gap.\n239|//\n240|// Stated bound, not a no-emission proof: the walk establishes the\n241|// absence of three archive-format imports, not the absence of manifest\n242|// or bundle emission in general — a JSON manifest needs none of those\n243|// imports. The nopath rows cite this test for exactly that bound and\n244|// no more. The day an archive or transfer writer lands, this test\n245|// names it and the nopath rows must be re-dispositioned.\n246|func TestNoArchiveEmissionPath(t *testing.T) {\n247|\tt.Parallel()\n248|\troot, err := filepath.Abs(filepath.Join(\"..\", \"..\", \"internal\"))\n249|\tif err != nil {\n250|\t\tt.Fatal(err)\n251|\t}\n252|\tforbidden := []string{\"archive/tar\", \"archive/zip\", \"compress/gzip\"}\n253|\tvar violations []string\n254|\tscanned := 0\n255|\terr = filepath.WalkDir(root, func(path string, entry os.DirEntry, walkErr error) error {\n256|\t\tif walkErr != nil {\n257|\t\t\treturn walkErr\n258|\t\t}\n259|\t\tif entry.IsDir() {\n260|\t\t\treturn nil\n261|\t\t}\n262|\t\tname := entry.Name()\n263|\t\tif !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n264|\t\t\treturn nil\n265|\t\t}\n266|\t\tcontents, err := os.ReadFile(path)\n267|\t\tif err != nil {\n268|\t\t\treturn err\n269|\t\t}\n270|\t\tscanned++\n271|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), name, contents, parser.ImportsOnly)\n272|\t\tif err != nil {\n273|\t\t\treturn fmt.Errorf(\"parse %s: %w\", path, err)\n274|\t\t}\n275|\t\tfor _, imported := range syntax.Imports {\n276|\t\t\timportPath := strings.Trim(imported.Path.Value, `\"`)\n277|\t\t\tfor _, denied := range forbidden {\n278|\t\t\t\tif importPath == denied {\n279|\t\t\t\t\trel, relErr := filepath.Rel(root, path)\n280|\t\t\t\t\tif relErr != nil {\n281|\t\t\t\t\t\trel = path\n282|\t\t\t\t\t}\n283|\t\t\t\t\tviolations = append(violations, \"internal/\"+rel+\" imports \"+importPath)\n284|\t\t\t\t}\n285|\t\t\t}\n286|\t\t}\n287|\t\treturn nil\n288|\t})\n289|\tif err != nil {\n290|\t\tt.Fatalf(\"emission-path walk failed closed: %v\", err)\n291|\t}\n292|\tif scanned == 0 {\n293|\t\tt.Fatal(\"scanned no production sources; the check is blind\")\n294|\t}\n295|\tt.Logf(\"emission-path scan covered %d production files\", scanned)\n296|\tif len(violations) > 0 {\n297|\t\tt.Fatalf(\"archive emission paths exist; nopath dispositions must be re-proven:\\n  %s\", strings.Join(violations, \"\\n  \"))\n298|\t}\n299|}\n300|\n301|// Keep the AST imports referenced for the emission-path walk above.\n302|var _ = ast.Walk","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
