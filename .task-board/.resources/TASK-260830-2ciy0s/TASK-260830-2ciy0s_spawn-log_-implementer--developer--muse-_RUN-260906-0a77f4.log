{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c47d","stream":{"kind":"session","id":"01a07750-3853-73c0-b383-0773367c2b50"},"sequence":153,"recorded_at":1780531400000301,"record_type":"event","durability":"durable","causation_id":"54033564-b97c-4244-a825-33fd926ad5cb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"54033564-b97c-4244-a825-33fd926ad5cb","run_stream":{"kind":"run","id":"54033564-b97c-4244-a825-33fd926ad5cb"},"task_stream":{"kind":"task","id":"23bb1a8a-5781-4cfa-893d-a49c71220d62"},"task_id":"23bb1a8a-5781-4cfa-893d-a49c71220d62","event":{"kind":"output","task_id":"23bb1a8a-5781-4cfa-893d-a49c71220d62","chunk":"Read text file `internal/secprim/inventory_test.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"flag\"\n5|\t\"fmt\"\n6|\t\"go/ast\"\n7|\t\"go/parser\"\n8|\t\"go/token\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"runtime\"\n12|\t\"sort\"\n13|\t\"strconv\"\n14|\t\"strings\"\n15|\t\"sync\"\n16|\t\"testing\"\n17|)\n18|\n19|// exercisedRefusalSites records the production file:line that constructed a\n20|// refusal, keyed with the rule it carried, for every instrumented refusal\n21|// constructor call made during the test run.\n22|var exercisedRefusalSites sync.Map // file:line -> rule\n23|\n24|func recordRefusalSite(rule string) {\n25|\tif _, file, line, ok := runtime.Caller(2); ok {\n26|\t\texercisedRefusalSites.Store(fmt.Sprintf(\"%s:%d\", filepath.Base(file), line), rule)\n27|\t}\n28|}\n29|\n30|func TestMain(main *testing.M) {\n31|\torigPath, origArgv, origEnv := failPath, failArgv, failEnv\n32|\tfailPath = func(rule, detail string) *Error {\n33|\t\terr := origPath(rule, detail)\n34|\t\trecordRefusalSite(\"path:\" + rule)\n35|\t\treturn err\n36|\t}\n37|\tfailArgv = func(rule, detail string) *Error {\n38|\t\terr := origArgv(rule, detail)\n39|\t\trecordRefusalSite(\"argv:\" + rule)\n40|\t\treturn err\n41|\t}\n42|\tfailEnv = func(rule, detail string) *Error {\n43|\t\terr := origEnv(rule, detail)\n44|\t\trecordRefusalSite(\"env:\" + rule)\n45|\t\treturn err\n46|\t}\n47|\tcode := main.Run()\n48|\tif code == 0 && fullPackageTestRun() {\n49|\t\tif failures := auditRefusalInventory(); len(failures) != 0 {\n50|\t\t\tfor _, failure := range failures {\n51|\t\t\t\tfmt.Fprintln(os.Stderr, failure)\n52|\t\t\t}\n53|\t\t\tcode = 1\n54|\t\t}\n55|\t}\n56|\tos.Exit(code)\n57|}\n58|\n59|func fullPackageTestRun() bool {\n60|\tselected := flag.Lookup(\"test.run\")\n61|\treturn selected == nil || selected.Value.String() == \"\"\n62|}\n63|\n64|// defensiveSites names derived refusal sites no public input can fire,\n65|// with the bound that keeps each honest. The member-containment conjunct\n66|// in Resolve is unreachable because the member grammar refuses every\n67|// parent segment before the prefix check runs; it stays as defense in\n68|// depth against a future grammar relaxation, and\n69|// TestGuardPrefixCheckIsLoadBearing proves the containment property over\n70|// a generated corpus, so a weakened grammar reddens there first. A\n71|// defensive entry that resolves to no derived site fails as stale.\n72|var defensiveSites = map[string]string{\n73|\t\"failPath:member containment\": \"unreachable while the member grammar refuses parent segments; pinned by TestGuardPrefixCheckIsLoadBearing\",\n74|}\n75|\n76|// platformExempt names rules that need not fire on one GOOS, keyed\n77|// file|constructor:rule. The key is rule-level, not site-level: every\n78|// \"open failed\" site in nofollow.go shares it. The post-check directory\n79|// open fails deterministically only where mode bits are enforceable: the\n80|// chmod vector in TestOpenNoFollowDirRefusesUnreadableDir is skipped on\n81|// Windows (ACLs do not express a mode-000 directory) and as root (which\n82|// bypasses mode bits), so on Windows the rule is exempt. An exemption\n83|// that resolves to no derived site fails as stale.\n84|var platformExempt = map[string]string{\n85|\t\"nofollow.go|failPath:open failed\": \"windows\",\n86|}\n87|\n88|// rootExempt names derived sites excused when the suite runs as root,\n89|// which bypasses the mode bits the chmod vector depends on. Same key\n90|// shape and staleness discipline as platformExempt; the audit below\n91|// checks both tables for orphans.\n92|var rootExempt = map[string]bool{\n93|\t\"nofollow.go|failPath:open failed\": true,\n94|}\n95|\n96|// siteKey renders the platform-exemption identity of a derived site: the\n97|// file basename plus the constructor and rule. Line numbers are left out\n98|// so edits above or below a site do not rename it.\n99|func siteKey(site, constructor string) string {\n100|\tfile := site\n101|\tif index := strings.LastIndex(site, \":\"); index >= 0 {\n102|\t\tfile = site[:index]\n103|\t}\n104|\treturn file + \"|\" + constructor\n105|}\n106|\n107|// exemptionResolves reports whether the exemption key matches at least\n108|// one derived site.\n109|func exemptionResolves(derived map[string]string, key string) bool {\n110|\tfor derivedSite, constructor := range derived {\n111|\t\tif siteKey(derivedSite, constructor) == key {\n112|\t\t\treturn true\n113|\t\t}\n114|\t}\n115|\treturn false\n116|}\n117|\n118|// ctorNames is the closed refusal-constructor set. errors.go states the\n119|// rule these names enforce: production builds Error values only through\n120|// them, never through an alias, a literal, new(Error), or a wrapper\n121|// factory.\n122|var ctorNames = map[string]bool{\"failPath\": true, \"failArgv\": true, \"failEnv\": true}\n123|\n124|// refusalDerivation is the parsed shape of one source set: the call\n125|// sites that must each fire during the suite, and the construction\n126|// shapes outside the constructors that must not exist at all.\n127|type refusalDerivation struct {\n128|\tsites   map[string]string // file:line -> \"constructor:rule\" (aliases resolved)\n129|\tstrays  []string          // file:line plus the offending shape, sorted\n130|\tscanned int\n131|}\n132|\n133|// unwrapParens strips parenthesized expressions so ((failPath)) and\n134|// (failPath) resolve like the bare spelling instead of bypassing it.\n135|func unwrapParens(expr ast.Expr) ast.Expr {\n136|\tfor {\n137|\t\tparenthesized, ok := expr.(*ast.ParenExpr)\n138|\t\tif !ok {\n139|\t\t\treturn expr\n140|\t\t}\n141|\t\texpr = parenthesized.X\n142|\t}\n143|}\n144|\n145|// returnsError reports whether the result list carries a *Error: the\n146|// factory shape the gate enumerates. WithCause is the one legitimate\n147|// member and is excluded by its callers, not here.\n148|func returnsError(results *ast.FieldList) bool {\n149|\tif results == nil {\n150|\t\treturn false\n151|\t}\n152|\tfor _, field := range results.List {\n153|\t\tstar, ok := unwrapParens(field.Type).(*ast.StarExpr)\n154|\t\tif !ok {\n155|\t\t\tcontinue\n156|\t\t}\n157|\t\tif identifier, ok := unwrapParens(star.X).(*ast.Ident); ok && identifier.Name == \"Error\" {\n158|\t\t\treturn true\n159|\t\t}\n160|\t}\n161|\treturn false\n162|}\n163|\n164|// isErrorLiteral reports whether the composite literal builds an\n165|// secprim Error: Error{...} in-package, or secprim.Error{...} from\n166|// outside it.\n167|func isErrorLiteral(literal *ast.CompositeLit) bool {\n168|\tswitch typed := unwrapParens(literal.Type).(type) {\n169|\tcase *ast.Ident:\n170|\t\treturn typed.Name == \"Error\"\n171|\tcase *ast.SelectorExpr:\n172|\t\treturn typed.Sel.Name == \"Error\"\n173|\t}\n174|\treturn false\n175|}\n176|\n177|// deriveRefusals parses every source and derives the refusal inventory\n178|// in two phases. Phase one resolves the constructor-alias fixpoint\n179|// (var x = failPath, x := failArgv, alias-of-alias), the *Error\n180|// factory declarations, and the constructor body spans. Phase two\n181|// walks every call, literal, binding, and name use against them:\n182|//\n183|//   - a call to a constructor or its alias is a site (the rule is the\n184|//     literal first argument, labelled under the underlying\n185|//     constructor so exemptions keep resolving);\n186|//   - a binding of a constructor to a new name is an alias stray, even\n187|//     when never called;\n188|//   - an Error literal, a new(Error) call, or a call to a package\n189|//     *Error factory (other than the WithCause decorator, which\n190|//     refines an already-counted refusal) is a construction stray;\n191|//   - a factory declaration whose body never calls a constructor is a\n192|//     manufacturing stray, even when never called;\n193|//   - any other use of a constructor name as a value is an escape\n194|//     stray.\n195|//\n196|// The enumerated shape space is: bare call, parenthesized call, var\n197|// alias, local alias, alias-of-alias, direct literal, new(Error),\n198|// method factory call, function factory call, uncalled factory, and\n199|// value escape. TestRefusalInventoryClosesBypassShapes plants every\n200|// member.\n201|func deriveRefusals(sources map[string][]byte) (refusalDerivation, error) {\n202|\tderivation := refusalDerivation{sites: map[string]string{}}\n203|\tfileset := token.NewFileSet()\n204|\ttype parsed struct {\n205|\t\tname   string\n206|\t\tsyntax *ast.File\n207|\t}\n208|\tvar files []parsed\n209|\tnames := make([]string, 0, len(sources))\n210|\tfor name := range sources {\n211|\t\tnames = append(names, name)\n212|\t}\n213|\tsort.Strings(names)\n214|\tfor _, name := range names {\n215|\t\tsyntax, err := parser.ParseFile(fileset, name, sources[name], 0)\n216|\t\tif err != nil {\n217|\t\t\treturn derivation, err\n218|\t\t}\n219|\t\tfiles = append(files, parsed{name: name, syntax: syntax})\n220|\t}\n221|\tderivation.scanned = len(files)\n222|\tposition := func(name string, pos token.Pos) string {\n223|\t\treturn fmt.Sprintf(\"%s:%d\", filepath.Base(name), fileset.Position(pos).Line)\n224|\t}\n225|\tinsideCtor := func(syntax *ast.File, pos token.Pos) bool {\n226|\t\tinside := false\n227|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n228|\t\t\tgeneral, ok := node.(*ast.GenDecl)\n229|\t\t\tif !ok {\n230|\t\t\t\treturn true\n231|\t\t\t}\n232|\t\t\tfor _, spec := range general.Specs {\n233|\t\t\t\tvalues, ok := spec.(*ast.ValueSpec)\n234|\t\t\t\tif !ok {\n235|\t\t\t\t\tcontinue\n236|\t\t\t\t}\n237|\t\t\t\tfor index, identifier := range values.Names {\n238|\t\t\t\t\tif !ctorNames[identifier.Name] || index >= len(values.Values) {\n239|\t\t\t\t\t\tcontinue\n240|\t\t\t\t\t}\n241|\t\t\t\t\tif literal, ok := values.Values[index].(*ast.FuncLit); ok {\n242|\t\t\t\t\t\tif pos >= literal.Pos() && pos <= literal.End() {\n243|\t\t\t\t\t\t\tinside = true\n244|\t\t\t\t\t\t\treturn false\n245|\t\t\t\t\t\t}\n246|\t\t\t\t\t}\n247|\t\t\t\t}\n248|\t\t\t}\n249|\t\t\treturn true\n250|\t\t})\n251|\t\treturn inside\n252|\t}\n253|\t// Phase one: bindings of constructor values to new names.\n254|\ttype binding struct {\n255|\t\tname, file, target string\n256|\t\tpos                token.Pos\n257|\t}\n258|\tvar bindings []binding\n259|\tnoteBinding := func(file string, lhs, rhs ast.Expr) {\n260|\t\tidentifier, ok := lhs.(*ast.Ident)\n261|\t\tif !ok || identifier.Name == \"_\" {\n262|\t\t\treturn\n263|\t\t}\n264|\t\tif target, ok := unwrapParens(rhs).(*ast.Ident); ok {\n265|\t\t\tbindings = append(bindings, binding{name: identifier.Name, file: file, target: target.Name, pos: identifier.Pos()})\n266|\t\t}\n267|\t}\n268|\tfor _, file := range files {\n269|\t\tast.Inspect(file.syntax, func(node ast.Node) bool {\n270|\t\t\tswitch typed := node.(type) {\n271|\t\t\tcase *ast.ValueSpec:\n272|\t\t\t\tfor index, identifier := range typed.Names {\n273|\t\t\t\t\tif index < len(typed.Values) {\n274|\t\t\t\t\t\tnoteBinding(file.name, identifier, typed.Values[index])\n275|\t\t\t\t\t}\n276|\t\t\t\t}\n277|\t\t\tcase *ast.AssignStmt:\n278|\t\t\t\tif len(typed.Lhs) == len(typed.Rhs) {\n279|\t\t\t\t\tfor index := range typed.Lhs {\n280|\t\t\t\t\t\tnoteBinding(file.name, typed.Lhs[index], typed.Rhs[index])\n281|\t\t\t\t\t}\n282|\t\t\t\t}\n283|\t\t\t}\n284|\t\t\treturn true\n285|\t\t})\n286|\t}\n287|\taliases := map[string]string{}\n288|\tfor changed := true; changed; {\n289|\t\tchanged = false\n290|\t\tfor _, candidate := range bindings {\n291|\t\t\tif _, known := aliases[candidate.name]; known {\n292|\t\t\t\tcontinue\n293|\t\t\t}\n294|\t\t\tif ctorNames[candidate.target] {\n295|\t\t\t\taliases[candidate.name] = candidate.target\n296|\t\t\t\tchanged = true\n297|\t\t\t} else if underlying, ok := aliases[candidate.target]; ok {\n298|\t\t\t\taliases[candidate.name] = underlying\n299|\t\t\t\tchanged = true\n300|\t\t\t}\n301|\t\t}\n302|\t}\n303|\tunderlying := func(name string) (string, bool) {\n304|\t\tif ctorNames[name] {\n305|\t\t\treturn name, true\n306|\t\t}\n307|\t\ttarget, ok := aliases[name]\n308|\t\treturn target, ok\n309|\t}\n310|\t// Phase one: *Error factory declarations (functions and methods).\n311|\tfactories := map[string]bool{}\n312|\tfor _, file := range files {\n313|\t\tfor _, declaration := range file.syntax.Decls {\n314|\t\t\tfunction, ok := declaration.(*ast.FuncDecl)\n315|\t\t\tif !ok || function.Name.Name == \"WithCause\" {\n316|\t\t\t\tcontinue\n317|\t\t\t}\n318|\t\t\tif returnsError(function.Type.Results) {\n319|\t\t\t\tfactories[function.Name.Name] = true\n320|\t\t\t}\n321|\t\t}\n322|\t}\n323|\t// Phase two: sites, strays, and the positions that excuse a name\n324|\t// use (call-fun position and declaration position).\n325|\tcallFuns := map[token.Pos]bool{}\n326|\tdeclared := map[token.Pos]bool{}\n327|\tfor _, file := range files {\n328|\t\tast.Inspect(file.syntax, func(node ast.Node) bool {\n329|\t\t\tswitch typed := node.(type) {\n330|\t\t\tcase *ast.CallExpr:\n331|\t\t\t\tif identifier, ok := unwrapParens(typed.Fun).(*ast.Ident); ok {\n332|\t\t\t\t\tcallFuns[identifier.Pos()] = true\n333|\t\t\t\t}\n334|\t\t\tcase *ast.ValueSpec:\n335|\t\t\t\tfor _, identifier := range typed.Names {\n336|\t\t\t\t\tdeclared[identifier.Pos()] = true\n337|\t\t\t\t}\n338|\t\t\tcase *ast.AssignStmt:\n339|\t\t\t\tfor _, bound := range typed.Lhs {\n340|\t\t\t\t\tif identifier, ok := bound.(*ast.Ident); ok {\n341|\t\t\t\t\t\tdeclared[identifier.Pos()] = true\n342|\t\t\t\t\t}\n343|\t\t\t\t}\n344|\t\t\tcase *ast.Field:\n345|\t\t\t\tfor _, identifier := range typed.Names {\n346|\t\t\t\t\tdeclared[identifier.Pos()] = true\n347|\t\t\t\t}\n348|\t\t\tcase *ast.FuncDecl:\n349|\t\t\t\tdeclared[typed.Name.Pos()] = true\n350|\t\t\tcase *ast.TypeSpec:\n351|\t\t\t\tdeclared[typed.Name.Pos()] = true\n352|\t\t\t}\n353|\t\t\treturn true\n354|\t\t})\n355|\t}\n356|\tstray := func(file string, pos token.Pos, shape string) {\n357|\t\tderivation.strays = append(derivation.strays, position(file, pos)+\" \"+shape)\n358|\t}\n359|\tfor _, file := range files {\n360|\t\tast.Inspect(file.syntax, func(node ast.Node) bool {\n361|\t\t\tcall, ok := node.(*ast.CallExpr)\n362|\t\t\tif !ok {\n363|\t\t\t\treturn true\n364|\t\t\t}\n365|\t\t\tswitch fun := unwrapParens(call.Fun).(type) {\n366|\t\t\tcase *ast.Ident:\n367|\t\t\t\tif constructor, ok := underlying(fun.Name); ok {\n368|\t\t\t\t\t// Every constructor call passes its rule as a\n369|\t\t\t\t\t// string literal first argument; a non-literal\n370|\t\t\t\t\t// rule is outside the roster shape and fails\n371|\t\t\t\t\t// the derivation.\n372|\t\t\t\t\tsite := position(file.name, call.Pos())\n373|\t\t\t\t\tif len(call.Args) == 0 {\n374|\t\t\t\t\t\tderivation.sites[site] = \"\"\n375|\t\t\t\t\t\treturn true\n376|\t\t\t\t\t}\n377|\t\t\t\t\tliteral, ok := unwrapParens(call.Args[0]).(*ast.BasicLit)\n378|\t\t\t\t\tif !ok || literal.Kind != token.STRING {\n379|\t\t\t\t\t\tderivation.sites[site] = \"\"\n380|\t\t\t\t\t\treturn true\n381|\t\t\t\t\t}\n382|\t\t\t\t\trule, err := strconv.Unquote(literal.Value)\n383|\t\t\t\t\tif err != nil {\n384|\t\t\t\t\t\tderivation.sites[site] = \"\"\n385|\t\t\t\t\t\treturn true\n386|\t\t\t\t\t}\n387|\t\t\t\t\tderivation.sites[site] = constructor + \":\" + rule\n388|\t\t\t\t\treturn true\n389|\t\t\t\t}\n390|\t\t\t\tif fun.Name == \"new\" && len(call.Args) > 0 {\n391|\t\t\t\t\tif identifier, ok := unwrapParens(call.Args[0]).(*ast.Ident); ok && identifier.Name == \"Error\" {\n392|\t\t\t\t\t\tstray(file.name, call.Pos(), \"new(Error) manufactures a refusal outside the constructors\")\n393|\t\t\t\t\t}\n394|\t\t\t\t\treturn true\n395|\t\t\t\t}\n396|\t\t\t\tif factories[fun.Name] {\n397|\t\t\t\t\tstray(file.name, call.Pos(), \"factory call \"+fun.Name+\" manufactures a refusal outside the constructors\")\n398|\t\t\t\t}\n399|\t\t\tcase *ast.SelectorExpr:\n400|\t\t\t\tif fun.Sel.Name == \"WithCause\" {\n401|\t\t\t\t\treturn true\n402|\t\t\t\t}\n403|\t\t\t\tif factories[fun.Sel.Name] {\n404|\t\t\t\t\tstray(file.name, call.Pos(), \"factory call \"+fun.Sel.Name+\" manufactures a refusal outside the constructors\")\n405|\t\t\t\t}\n406|\t\t\t}\n407|\t\t\treturn true\n408|\t\t})\n409|\t\tast.Inspect(file.syntax, func(node ast.Node) bool {\n410|\t\t\tliteral, ok := node.(*ast.CompositeLit)\n411|\t\t\tif !ok {\n412|\t\t\t\treturn true\n413|\t\t\t}\n414|\t\t\tif isErrorLiteral(literal) && !insideCtor(file.syntax, literal.Pos()) {\n415|\t\t\t\tstray(file.name, literal.Pos(), \"Error literal manufactures a refusal outside the constructors\")\n416|\t\t\t}\n417|\t\t\treturn true\n418|\t\t})\n419|\t}\n420|\tfor _, candidate := range bindings {\n421|\t\tif _, ok := underlying(candidate.target); ok {\n422|\t\t\tif ctorNames[candidate.name] {\n423|\t\t\t\tcontinue\n424|\t\t\t}\n425|\t\t\tstray(candidate.file, candidate.pos, \"alias \"+candidate.name+\" rebinds a refusal constructor\")\n426|\t\t}\n427|\t}\n428|\t// Factory declarations whose body never reaches a constructor\n429|\t// manufacture refusals no inventory site can name.\n430|\tfor _, file := range files {\n431|\t\tfor _, declaration := range file.syntax.Decls {\n432|\t\t\tfunction, ok := declaration.(*ast.FuncDecl)\n433|\t\t\tif !ok || function.Name.Name == \"WithCause\" || function.Body == nil {\n434|\t\t\t\tcontinue\n435|\t\t\t}\n436|\t\t\tif !factories[function.Name.Name] {\n437|\t\t\t\tcontinue\n438|\t\t\t}\n439|\t\t\treaches := false\n440|\t\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n441|\t\t\t\tcall, ok := node.(*ast.CallExpr)\n442|\t\t\t\tif !ok {\n443|\t\t\t\t\treturn true\n444|\t\t\t\t}\n445|\t\t\t\tif identifier, ok := unwrapParens(call.Fun).(*ast.Ident); ok {\n446|\t\t\t\t\tif _, ok := underlying(identifier.Name); ok {\n447|\t\t\t\t\t\treaches = true\n448|\t\t\t\t\t\treturn false\n449|\t\t\t\t\t}\n450|\t\t\t\t}\n451|\t\t\t\treturn true\n452|\t\t\t})\n453|\t\t\tif !reaches {\n454|\t\t\t\tstray(file.name, function.Pos(), \"factory \"+function.Name.Name+\" manufactures *Error without the constructors\")\n455|\t\t\t}\n456|\t\t}\n457|\t}\n458|\t// Constructor names used as values anywhere but call-fun and\n459|\t// declaration position escape the call-site inventory.\n460|\tfor _, file := range files {\n461|\t\tast.Inspect(file.syntax, func(node ast.Node) bool {\n462|\t\t\tidentifier, ok := node.(*ast.Ident)\n463|\t\t\tif !ok {\n464|\t\t\t\treturn true\n465|\t\t\t}\n466|\t\t\tif _, ok := underlying(identifier.Name); !ok {\n467|\t\t\t\treturn true\n468|\t\t\t}\n469|\t\t\tif callFuns[identifier.Pos()] || declared[identifier.Pos()] {\n470|\t\t\t\treturn true\n471|\t\t\t}\n472|\t\t\tstray(file.name, identifier.Pos(), \"constructor \"+identifier.Name+\" escapes as a value outside a call\")\n473|\t\t\treturn true\n474|\t\t})\n475|\t}\n476|\tsort.Strings(derivation.strays)\n477|\treturn derivation, nil\n478|}\n479|\n480|// auditRefusalInventory derives every failPath/failArgv/failEnv call site\n481|// from non-test production source and requires each to have fired during\n482|// the suite (forward), and every fired site to resolve to a derived site\n483|// (reverse). Constructions outside the constructors (aliases, literals,\n484|// factories, escapes) fail outright. A constructor call no test reaches,\n485|// or a recorded site the source no longer contains, fails instead of\n486|// passing silently. An empty derivation fails closed: a blind scanner is\n487|// not a complete inventory.\n488|func auditRefusalInventory() []string {\n489|\tdirectory, err := os.Getwd()\n490|\tif err != nil {\n491|\t\treturn []string{fmt.Sprintf(\"derive secprim refusal inventory: %v\", err)}\n492|\t}\n493|\tentries, err := os.ReadDir(directory)\n494|\tif err != nil {\n495|\t\treturn []string{fmt.Sprintf(\"derive secprim refusal inventory: %v\", err)}\n496|\t}\n497|\tsources := map[string][]byte{}\n498|\tfor _, entry := range entries {\n499|\t\tname := entry.Name()\n500|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n(more lines below)"}}}
