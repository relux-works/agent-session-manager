{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c777","stream":{"kind":"session","id":"01a07750-3853-73c0-b383-0773367c2b50"},"sequence":534,"recorded_at":1780531400001063,"record_type":"event","durability":"durable","causation_id":"54033564-b97c-4244-a825-33fd926ad5cb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"54033564-b97c-4244-a825-33fd926ad5cb","run_stream":{"kind":"run","id":"54033564-b97c-4244-a825-33fd926ad5cb"},"call_id":"call_01a07751c5047f02aceb21bdb7f23eb8","text":"Read text file `internal/secprim/argv.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"strconv\"\n5|\t\"strings\"\n6|\t\"unicode/utf8\"\n7|)\n8|\n9|// CheckArgv validates one process argv vector under Section 16.4: every\n10|// process invocation uses an argv array and native process APIs, and shell\n11|// command construction from names, paths, provider output, or peer data is\n12|// forbidden. This package offers no string-to-argv constructor at all —\n13|// there is no shell word-splitting entry point to misuse — and CheckArgv\n14|// decides what a validated vector is:\n15|//\n16|//   - the vector is non-empty and names a non-empty executable;\n17|//   - no element is empty: an empty argv element is legal to exec but never\n18|//     meaningful to an AX or provider CLI, so it fails closed;\n19|//   - no element carries a NUL byte, which cannot cross execve;\n20|//   - every element is valid UTF-8, because argv elements recur in receipts,\n21|//     logs, and terminal rendering, all of which are UTF-8.\n22|//\n23|// No length bound is enforced here: the Section 5.1 byte bounds apply to\n24|// the Provider SpawnPlan wire object and stay in internal/provhost, which\n25|// admits the plan. A plan admitted there still crosses this gate at\n26|// process start, so a caller that bypasses plan admission cannot bypass\n27|// argv validation.\n28|func CheckArgv(argv []string) error {\n29|\tif len(argv) == 0 {\n30|\t\treturn failArgv(\"argv empty\", \"no executable\")\n31|\t}\n32|\tfor index, element := range argv {\n33|\t\tposition := \"argv[\" + strconv.Itoa(index) + \"]\"\n34|\t\tswitch {\n35|\t\tcase element == \"\":\n36|\t\t\tif index == 0 {\n37|\t\t\t\treturn failArgv(\"argv executable empty\", position)\n38|\t\t\t}\n39|\t\t\treturn failArgv(\"argv element empty\", position)\n40|\t\tcase strings.ContainsRune(element, 0):\n41|\t\t\treturn failArgv(\"argv NUL\", position)\n42|\t\tcase !utf8.ValidString(element):\n43|\t\t\treturn failArgv(\"argv encoding\", position)\n44|\t\t}\n45|\t}\n46|\treturn nil\n47|}\n48|\n49|// Command is a validated argv vector. The only constructor takes an array,\n50|// so a command cannot be built from a shell string: word-splitting hostile\n51|// input never happens because no entry point performs it. The zero value\n52|// is unusable; build one with NewCommand.\n53|type Command struct {\n54|\targv []string\n55|}\n56|\n57|// NewCommand validates the vector with CheckArgv and keeps a copy: the\n58|// caller's slice cannot be rewritten after admission to smuggle in an\n59|// unchecked element.\n60|func NewCommand(argv []string) (Command, error) {\n61|\tif err := CheckArgv(argv); err != nil {\n62|\t\treturn Command{}, err\n63|\t}\n64|\treturn Command{argv: append([]string(nil), argv...)}, nil\n65|}\n66|\n67|// Argv returns the validated vector. The result is a copy for the same\n68|// reason the constructor copies: a retained alias would let the holder\n69|// rewrite an admitted command.\n70|func (command Command) Argv() []string {\n71|\treturn append([]string(nil), command.argv...)\n72|}\n73|\n74|// Executable reports argv[0], the process image the host will start. It is\n75|// never empty: NewCommand refused that.\n76|func (command Command) Executable() string {\n77|\treturn command.argv[0]\n78|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c779","stream":{"kind":"session","id":"01a07750-3853-73c0-b383-0773367c2b50"},"sequence":535,"recorded_at":1780531400001065,"record_type":"event","durability":"durable","causation_id":"54033564-b97c-4244-a825-33fd926ad5cb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"54033564-b97c-4244-a825-33fd926ad5cb","run_stream":{"kind":"run","id":"54033564-b97c-4244-a825-33fd926ad5cb"},"call_id":"call_01a07751c5ae7b21bdf8bc7c04ca293c","text":"Read text file `internal/secprim/env.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"sort\"\n5|\t\"strings\"\n6|\t\"unicode/utf8\"\n7|)\n8|\n9|// IsEnvName reports whether name satisfies the environment-name grammar\n10|// shared by launch allowlists and SpawnPlan admission:\n11|// [A-Za-z_][A-Za-z0-9_]{0,127}. internal/provhost delegates its wire-plan\n12|// name check to this function, so the two packages cannot drift on what a\n13|// name is; the byte-counted plan bounds around it stay in provhost.\n14|func IsEnvName(name string) bool {\n15|\tif len(name) < 1 || len(name) > 128 {\n16|\t\treturn false\n17|\t}\n18|\tfor index := 0; index < len(name); index++ {\n19|\t\tchar := name[index]\n20|\t\tvalid := char == '_' ||\n21|\t\t\tchar >= 'A' && char <= 'Z' ||\n22|\t\t\tchar >= 'a' && char <= 'z' ||\n23|\t\t\tindex > 0 && char >= '0' && char <= '9'\n24|\t\tif !valid {\n25|\t\t\treturn false\n26|\t\t}\n27|\t}\n28|\treturn true\n29|}\n30|\n31|// BuildEnv builds the exact environment of a child process from a minimal\n32|// allowlist plus operator literals (Section 16.7 \"minimal environment\n33|// allowlists\"):\n34|//\n35|//   - allowed names the inherited variables the child may see. Each must\n36|//     satisfy IsEnvName; duplicates are refused rather than silently\n37|//     collapsed, because a duplicated allowlist entry is a configuration\n38|//     error. A name absent from lookup is skipped, not failed: an unset\n39|//     variable is a legitimate absence, while a failed read must never\n40|//     masquerade as one, so lookup reports only what it read.\n41|//   - literals carries explicit key=value pairs (workspace-derived values,\n42|//     SpawnPlan literals). Keys must satisfy IsEnvName and must be disjoint\n43|//     from allowed: a literal that shadows an inherited name would make the\n44|//     child's environment depend on map order rather than on policy.\n45|//   - values must be NUL-free valid UTF-8. Empty values are admitted:\n46|//     FOO= is a meaningful empty assignment, not a missing one.\n47|//\n48|// The result is sorted by name and rendered k=v, so identical inputs build\n49|// byte-identical environments. lookup abstracts the parent environment for\n50|// tests; production passes os.LookupEnv.\n51|//\n52|// No length bound is enforced here: the Section 5.1 literal bounds apply\n53|// to the SpawnPlan wire object in internal/provhost. No default allowlist\n54|// is declared here either: with no provider implementation in this\n55|// repository to derive runtime needs from, a baked-in list would be an\n56|// invented product policy, so the operator supplies the list explicitly\n57|// and ExecRunner inherits the parent environment until one is supplied.\n58|func BuildEnv(allowed []string, literals map[string]string, lookup func(string) (string, bool)) ([]string, error) {\n59|\tif lookup == nil {\n60|\t\treturn nil, failEnv(\"env lookup missing\", \"no parent environment reader\")\n61|\t}\n62|\tseen := make(map[string]bool, len(allowed))\n63|\tfor _, name := range allowed {\n64|\t\tif !IsEnvName(name) {\n65|\t\t\treturn nil, failEnv(\"env name\", name)\n66|\t\t}\n67|\t\tif seen[name] {\n68|\t\t\treturn nil, failEnv(\"env allowlist duplicate\", name)\n69|\t\t}\n70|\t\tseen[name] = true\n71|\t}\n72|\tfor key := range literals {\n73|\t\tif !IsEnvName(key) {\n74|\t\t\treturn nil, failEnv(\"env name\", key)\n75|\t\t}\n76|\t\tif seen[key] {\n77|\t\t\treturn nil, failEnv(\"env literal collision\", key)\n78|\t\t}\n79|\t}\n80|\tvalues := make(map[string]string, len(allowed)+len(literals))\n81|\tfor _, name := range allowed {\n82|\t\tvalue, present := lookup(name)\n83|\t\tif !present {\n84|\t\t\tcontinue\n85|\t\t}\n86|\t\tif strings.ContainsRune(value, 0) {\n87|\t\t\treturn nil, failEnv(\"env value NUL\", name)\n88|\t\t}\n89|\t\tif !utf8.ValidString(value) {\n90|\t\t\treturn nil, failEnv(\"env value encoding\", name)\n91|\t\t}\n92|\t\tvalues[name] = value\n93|\t}\n94|\tfor key, value := range literals {\n95|\t\tif strings.ContainsRune(value, 0) {\n96|\t\t\treturn nil, failEnv(\"env value NUL\", key)\n97|\t\t}\n98|\t\tif !utf8.ValidString(value) {\n99|\t\t\treturn nil, failEnv(\"env value encoding\", key)\n100|\t\t}\n101|\t\tvalues[key] = value\n102|\t}\n103|\tnames := make([]string, 0, len(values))\n104|\tfor name := range values {\n105|\t\tnames = append(names, name)\n106|\t}\n107|\tsort.Strings(names)\n108|\tenvironment := make([]string, 0, len(names))\n109|\tfor _, name := range names {\n110|\t\tenvironment = append(environment, name+\"=\"+values[name])\n111|\t}\n112|\treturn environment, nil\n113|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c77b","stream":{"kind":"session","id":"01a07750-3853-73c0-b383-0773367c2b50"},"sequence":536,"recorded_at":1780531400001067,"record_type":"event","durability":"durable","causation_id":"54033564-b97c-4244-a825-33fd926ad5cb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"54033564-b97c-4244-a825-33fd926ad5cb","run_stream":{"kind":"run","id":"54033564-b97c-4244-a825-33fd926ad5cb"},"call_id":"call_01a07751c65a700095f40cb34ac81247","text":"Read text file `internal/secprim/render.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"strings\"\n5|)\n6|\n7|// Escape control symbols rendered visibly.\n8|const (\n9|\t// escapeSymbol replaces ESC so ANSI CSI/OSC sequences become inert yet\n10|\t// visible: the byte the terminal would interpret is gone, and the\n11|\t// operator can still see that something was neutralized.\n12|\tescapeSymbol = \"␛\" // U+241B SYMBOL FOR ESCAPE\n13|\t// neutralizedSymbol replaces every other refused control: C0/C1\n14|\t// controls, DEL, bidi overrides, and zero-width format characters.\n15|\tneutralizedSymbol = \"�\" // U+FFFD REPLACEMENT CHARACTER\n16|)\n17|\n18|// EscapeForTerminal renders untrusted text inert for terminal output\n19|// (Section 16.7: TUI and CLI rendering neutralizes ANSI/OSC sequences,\n20|// control characters, bidi overrides, invalid encodings, and hostile-width\n21|// graphemes before terminal output). The rule per rune:\n22|//\n23|//   - '\\n' and '\\t' pass through: multiline human output needs them, and\n24|//     neither starts an escape sequence or reorders text;\n25|//   - ESC becomes U+241B, so CSI, OSC, and every other ESC-led sequence\n26|//     loses its introducer while staying visible;\n27|//   - every other C0 control, DEL, and every C1 control (including the\n28|//     single-byte CSI U+009B) becomes U+FFFD;\n29|//   - bidi overrides and isolates (U+202A-U+202E, U+2066-U+2069), the\n30|//     explicit directional marks (U+200E, U+200F, U+061C), and the\n31|//     zero-width characters (U+200B-U+200D, U+FEFF) become U+FFFD: they\n32|//     reorder or hide text without showing anything;\n33|//   - invalid UTF-8 becomes U+FFFD per run, so the result is always valid\n34|//     UTF-8 and no raw byte reaches the terminal;\n35|//   - every other rune passes through unchanged.\n36|//\n37|// The function is idempotent: every symbol it emits is a fixed point, so\n38|// escaping already-escaped output changes nothing and double-wiring a\n39|// render path cannot corrupt text.\n40|//\n41|// Stated bounds. Soft hyphen (U+00AD), combining-mark floods, emoji\n42|// presentation sequences, and other grapheme-width anomalies are not\n43|// measured: neutralizing them needs terminal width tables this package\n44|// does not carry, and stripping combining marks would mangle legitimate\n45|// non-Latin text. Full-width spoofing beyond the enumerated invisible\n46|// controls is therefore unproven and named here rather than claimed.\n47|func EscapeForTerminal(text string) string {\n48|\ttext = strings.ToValidUTF8(text, neutralizedSymbol)\n49|\tvar rendered strings.Builder\n50|\trendered.Grow(len(text))\n51|\tfor _, character := range text {\n52|\t\tswitch {\n53|\t\tcase character == '\\n' || character == '\\t':\n54|\t\t\trendered.WriteRune(character)\n55|\t\tcase character == 0x1b:\n56|\t\t\trendered.WriteString(escapeSymbol)\n57|\t\tcase character < 0x20 || character == 0x7f || character >= 0x80 && character <= 0x9f:\n58|\t\t\trendered.WriteString(neutralizedSymbol)\n59|\t\tcase character >= 0x202a && character <= 0x202e,\n60|\t\t\tcharacter >= 0x2066 && character <= 0x2069,\n61|\t\t\tcharacter == 0x200e || character == 0x200f || character == 0x061c,\n62|\t\t\tcharacter >= 0x200b && character <= 0x200d,\n63|\t\t\tcharacter == 0xfeff:\n64|\t\t\trendered.WriteString(neutralizedSymbol)\n65|\t\tdefault:\n66|\t\t\trendered.WriteRune(character)\n67|\t\t}\n68|\t}\n69|\treturn rendered.String()\n70|}\n71|\n72|// RenderForTerminal prepares one untrusted line for terminal display:\n73|// secret scrubbing first (so a secret containing an escape sequence is\n74|// removed as a secret, not merely neutralized), then control escaping.\n75|// secrets carries the exact secret values the caller knows; nil admits no\n76|// corpus redaction while key-pattern and private-key scrubbing still\n77|// apply. The composition is idempotent because both stages are.\n78|func RenderForTerminal(line string, secrets []string) string {\n79|\treturn EscapeForTerminal(Redact(line, secrets))\n80|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c77d","stream":{"kind":"session","id":"01a07750-3853-73c0-b383-0773367c2b50"},"sequence":537,"recorded_at":1780531400001069,"record_type":"event","durability":"durable","causation_id":"54033564-b97c-4244-a825-33fd926ad5cb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"54033564-b97c-4244-a825-33fd926ad5cb","run_stream":{"kind":"run","id":"54033564-b97c-4244-a825-33fd926ad5cb"},"call_id":"call_01a07751c7257ce0a268f4120fcca578","text":"Read text file `internal/secprim/redact.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"unicode/utf8\"\n6|)\n7|\n8|// Redaction markers. The corpus and key-pattern arms share one marker so\n9|// arm order cannot leak which rule fired; the private-key arm names its\n10|// class because a redacted key block must still read as a key block to an\n11|// operator deciding whether to re-enter it.\n12|const (\n13|\tredactedMarker        = \"[redacted]\"\n14|\tredactedPrivateKey    = \"[redacted private key block]\"\n15|\tminSecretRunes        = 8\n16|\tprivateKeyBeginPrefix = \"-----BEGIN \"\n17|\tprivateKeyBeginSuffix = \"PRIVATE KEY-----\"\n18|\tprivateKeyEndPrefix   = \"-----END \"\n19|)\n20|\n21|// sensitiveKeyNames is the reviewed exact-match list for the key=value arm\n22|// below, derived from the Section 16.2 exclusion table (provider\n23|// credentials, SSH/private identity, environment secrets, machine\n24|// authentication). Matching is exact on the lowercased key, never by\n25|// substring: refusing every key containing \"token\" would refuse\n26|// \"token_count\" while passing a secret written under an innocuous name,\n27|// which is pure false-positive surface with no true-positive capability.\n28|//\n29|// Deliberately absent: bare \"key\" (cache keys, sort keys, key=value\n30|// identifiers are ordinary diagnostics), bare \"auth\" (auth status and\n31|// authority digests are not secrets), and \"pwd\"/\"PWD\" (working-directory\n32|// diagnostics are not secrets). Compound keys outside this list (for\n33|// example \"db_password\") are not matched: the corpus arm covers secret\n34|// values the caller knows, and no static list can close the naming\n35|// space. That residue is stated, not hidden.\n36|var sensitiveKeyNames = map[string]bool{\n37|\t\"access_token\": true, \"api_key\": true, \"apikey\": true,\n38|\t\"auth_json\": true, \"authorization\": true, \"auth_token\": true,\n39|\t\"bearer_token\": true, \"client_secret\": true, \"cookie\": true,\n40|\t\"cookies\": true, \"credential\": true, \"credentials\": true,\n41|\t\"dotenv\": true, \"env_secret\": true, \"environment_secret\": true,\n42|\t\"oauth_token\": true, \"passphrase\": true, \"password\": true,\n43|\t\"passwd\": true, \"private_key\": true, \"refresh_token\": true,\n44|\t\"secret\": true, \"secrets\": true, \"session_token\": true,\n45|\t\"ssh_private_key\": true, \"subscription_token\": true, \"token\": true,\n46|}\n47|\n48|// Redact scrubs free text before persistence or display (Section 16.4:\n49|// plugin stderr, provider logs, and doctor output are redacted before\n50|// persistence). It decides exactly three shapes, in this order:\n51|//\n52|//  1. private-key blocks: -----BEGIN ... PRIVATE KEY----- through the\n53|//     matching -----END ...----- (or to end of input when unterminated,\n54|//     failing closed) become \"[redacted private key block]\";\n55|//  2. caller-known secret values: every secrets entry of at least 8 runes\n56|//     is replaced verbatim with \"[redacted]\". Shorter values are skipped:\n57|//     a two-character secret would redact every occurrence of a common\n58|//     bigram, which is pure false-positive surface. ULID/UUID-shaped\n59|//     non-secrets the caller lists are the caller's error and are\n60|//     redacted all the same;\n61|//  3. sensitive key=value pairs: key=, key:, key =, or \"key\": \" shapes\n62|//     whose key exactly matches sensitiveKeyNames (case-insensitively)\n63|//     have their value replaced with \"[redacted]\", plus URL userinfo\n64|//     (scheme://...@) whose credentials are never displayable.\n65|//\n66|// Section 16.2 is explicit that v0.5.0 does not claim reliable\n67|// content-level secret scrubbing, and this function claims no more: a\n68|// secret under an unlisted key, a bare credential with no key shape, or a\n69|// key block without its header passes through, and only the corpus arm\n70|// can catch those when the caller knows the value. The function is\n71|// idempotent: its markers contain no sensitive key shape, so rescanning\n72|// redacted text changes nothing.\n73|func Redact(line string, secrets []string) string {\n74|\tredacted := redactPrivateKeyBlocks(line)\n75|\tredacted = redactCorpusValues(redacted, secrets)\n76|\tredacted = redactSensitivePairs(redacted)\n77|\tredacted = redactURLUserinfo(redacted)\n78|\treturn redacted\n79|}\n80|\n81|// redactPrivateKeyBlocks replaces PEM private-key blocks. The header must\n82|// contain PRIVATE KEY so certificates and public keys (which are routinely\n83|// logged for pinning) keep passing through.\n84|func redactPrivateKeyBlocks(line string) string {\n85|\tvar rendered strings.Builder\n86|\trendered.Grow(len(line))\n87|\trest := line\n88|\tfor {\n89|\t\tbegin := strings.Index(rest, privateKeyBeginPrefix)\n90|\t\tif begin < 0 {\n91|\t\t\trendered.WriteString(rest)\n92|\t\t\treturn rendered.String()\n93|\t\t}\n94|\t\t// The header close is searched past the opening dashes: the\n95|\t\t// prefix itself starts with dashes, which are not the close.\n96|\t\theaderClose := strings.Index(rest[begin+len(privateKeyBeginPrefix):], \"-----\")\n97|\t\tif headerClose < 0 {\n98|\t\t\trendered.WriteString(rest)\n99|\t\t\treturn rendered.String()\n100|\t\t}\n101|\t\theader := rest[begin : begin+len(privateKeyBeginPrefix)+headerClose+len(\"-----\")]\n102|\t\tif !strings.Contains(header, privateKeyBeginSuffix) {\n103|\t\t\trendered.WriteString(rest[:begin+len(header)])\n104|\t\t\trest = rest[begin+len(header):]\n105|\t\t\tcontinue\n106|\t\t}\n107|\t\tend := strings.Index(rest[begin+len(header):], privateKeyEndPrefix)\n108|\t\tif end < 0 {\n109|\t\t\trendered.WriteString(rest[:begin])\n110|\t\t\trendered.WriteString(redactedPrivateKey)\n111|\t\t\treturn rendered.String()\n112|\t\t}\n113|\t\t// Same dashPrefix care for the END header close.\n114|\t\tafterEnd := rest[begin+len(header)+end+len(privateKeyEndPrefix):]\n115|\t\tcloseDashes := strings.Index(afterEnd, \"-----\")\n116|\t\tif closeDashes < 0 {\n117|\t\t\trendered.WriteString(rest[:begin])\n118|\t\t\trendered.WriteString(redactedPrivateKey)\n119|\t\t\treturn rendered.String()\n120|\t\t}\n121|\t\trendered.WriteString(rest[:begin])\n122|\t\trendered.WriteString(redactedPrivateKey)\n123|\t\trest = afterEnd[closeDashes+len(\"-----\"):]\n124|\t}\n125|}\n126|\n127|// redactCorpusValues replaces caller-known secret values verbatim.\n128|// Entries below minSecretRunes are skipped (see Redact): matching them\n129|// would redact ordinary text.\n130|func redactCorpusValues(line string, secrets []string) string {\n131|\tfor _, secret := range secrets {\n132|\t\tif utf8.RuneCountInString(secret) < minSecretRunes || secret == \"\" {\n133|\t\t\tcontinue\n134|\t\t}\n135|\t\tline = strings.ReplaceAll(line, secret, redactedMarker)\n136|\t}\n137|\treturn line\n138|}\n139|\n140|// redactSensitivePairs masks values of exact sensitive keys in key=value,\n141|// key:value, and \"key\": \"value\" shapes, including values spaced across\n142|// chunks (\"key\": \"value\", \"key = value\"). The line is walked chunk by\n143|// chunk (whitespace-delimited); each chunk is spliced head + masked value\n144|// + tail so surrounding quotes, braces, and commas survive and JSON stays\n145|// parseable.\n146|func redactSensitivePairs(line string) string {\n147|\tchunks := mergeBareKeyChunks(strings.Split(line, \" \"))\n148|\tfor index, chunk := range chunks {\n149|\t\tchunks[index] = maskSensitiveChunk(chunk)\n150|\t}\n151|\t// Second pass: a \"key\": shape whose value starts after this chunk.\n152|\t// The first pass left the dangling chunk alone because its value was\n153|\t// empty; mask the remainder instead.\n154|\tvar out []string\n155|\tindex := 0\n156|\tfor index < len(chunks) {\n157|\t\tif _, ok := danglingSensitiveKey(chunks[index]); ok && index+1 < len(chunks) {\n158|\t\t\trest := strings.Join(chunks[index+1:], \" \")\n159|\t\t\thead, tail := maskDanglingValue(rest)\n160|\t\t\tout = append(out, chunks[index], head)\n161|\t\t\tif tail != \"\" {\n162|\t\t\t\tout = append(out, tail)\n163|\t\t\t}\n164|\t\t\tbreak\n165|\t\t}\n166|\t\tout = append(out, chunks[index])\n167|\t\tindex++\n168|\t}\n169|\treturn strings.Join(out, \" \")\n170|}\n171|\n172|// mergeBareKeyChunks joins a bare sensitive-key chunk with a following\n173|// separator-leading chunk (\"key\" \"=\" \"value\" becomes \"key =\" \"value\"),\n174|// preserving the separating space, so spaced assignments reach the same\n175|// first pass as compact ones.\n176|func mergeBareKeyChunks(chunks []string) []string {\n177|\tvar merged []string\n178|\tindex := 0\n179|\tfor index < len(chunks) {\n180|\t\tif index+1 < len(chunks) && isBareSensitiveKey(chunks[index]) && startsWithSep(chunks[index+1]) {\n181|\t\t\tmerged = append(merged, chunks[index]+\" \"+chunks[index+1])\n182|\t\t\tindex += 2\n183|\t\t\tcontinue\n184|\t\t}\n185|\t\tmerged = append(merged, chunks[index])\n186|\t\tindex++\n187|\t}\n188|\treturn merged\n189|}\n190|\n191|// isBareSensitiveKey reports whether the chunk is exactly a sensitive key\n192|// past surrounding quotes and braces.\n193|func isBareSensitiveKey(chunk string) bool {\n194|\tcore := strings.Trim(chunk, `\"'{}`)\n195|\tif core == \"\" {\n196|\t\treturn false\n197|\t}\n198|\tfor index := 0; index < len(core); index++ {\n199|\t\tif !isKeyByte(core[index]) {\n200|\t\t\treturn false\n201|\t\t}\n202|\t}\n203|\treturn sensitiveKeyNames[strings.ToLower(core)]\n204|}\n205|\n206|// startsWithSep reports whether the chunk opens with '=' or ':' past\n207|// leading spaces.\n208|func startsWithSep(chunk string) bool {\n209|\ttrimmed := strings.TrimLeft(chunk, \" \\t\")\n210|\treturn strings.HasPrefix(trimmed, \"=\") || strings.HasPrefix(trimmed, \":\")\n211|}\n212|\n213|// danglingSensitiveKey reports whether the chunk is a sensitive key with\n214|// an empty value (trailing ':' or '='): its value follows in the next\n215|// chunk.\n216|func danglingSensitiveKey(chunk string) (string, bool) {\n217|\ttrimmed := strings.TrimRight(chunk, \",;\")\n218|\tif !strings.HasSuffix(trimmed, \":\") && !strings.HasSuffix(trimmed, \"=\") {\n219|\t\treturn \"\", false\n220|\t}\n221|\t_, key := splitChunkHead(trimmed[:len(trimmed)-1])\n222|\tif !sensitiveKeyNames[strings.ToLower(key)] {\n223|\t\treturn \"\", false\n224|\t}\n225|\treturn key, true\n226|}\n227|\n228|// maskDanglingValue masks the value at the start of the remainder\n229|// following a dangling key: past one optional opening quote to its closing\n230|// quote (keeping the tail, so JSON stays parseable), or to the next comma,\n231|// semicolon, or end of input when unquoted. It returns the masked head and\n232|// the untouched tail.\n233|func maskDanglingValue(rest string) (head, tail string) {\n234|\tblank := rest[:len(rest)-len(strings.TrimLeft(rest, \" \\t\"))]\n235|\tval := strings.TrimLeft(rest, \" \\t\")\n236|\tquote := \"\"\n237|\tif strings.HasPrefix(val, `\"`) || strings.HasPrefix(val, `'`) {\n238|\t\tquote = val[:1]\n239|\t\tval = val[1:]\n240|\t}\n241|\tif strings.HasPrefix(val, redactedMarker) {\n242|\t\treturn rest, \"\"\n243|\t}\n244|\tend := len(val)\n245|\tif quote != \"\" {\n246|\t\tif closing := strings.Index(val, quote); closing >= 0 {\n247|\t\t\tend = closing\n248|\t\t}\n249|\t} else {\n250|\t\tend = strings.IndexAny(val, \",;\")\n251|\t\tif end < 0 {\n252|\t\t\tend = len(val)\n253|\t\t}\n254|\t}\n255|\tif end == 0 {\n256|\t\treturn rest, \"\"\n257|\t}\n258|\ttail = val[end:]\n259|\tif quote != \"\" && strings.HasPrefix(tail, quote) {\n260|\t\treturn blank + quote + redactedMarker + quote + tail[len(quote):], \"\"\n261|\t}\n262|\tif quote != \"\" {\n263|\t\treturn blank + quote + redactedMarker, tail\n264|\t}\n265|\tif tail == \"\" {\n266|\t\treturn blank + redactedMarker, \"\"\n267|\t}\n268|\treturn blank + redactedMarker, tail\n269|}\n270|\n271|// maskSensitiveChunk masks the value of one chunk when its key exactly\n272|// matches sensitiveKeyNames. The key must start at the chunk start (past\n273|// opening braces and quotes) and be followed by '=' or ':'; the value runs\n274|// to the matching closing quote when quoted, else to the next value\n275|// terminator (comma, semicolon, closing brace or bracket) or chunk end.\n276|func maskSensitiveChunk(chunk string) string {\n277|\tfor _, sep := range []string{\"=\", \":\"} {\n278|\t\tposition := strings.Index(chunk, sep)\n279|\t\tif position < 0 {\n280|\t\t\tcontinue\n281|\t\t}\n282|\t\thead, key := splitChunkHead(chunk[:position])\n283|\t\tif key == \"\" || !sensitiveKeyNames[strings.ToLower(key)] {\n284|\t\t\tcontinue\n285|\t\t}\n286|\t\trest := chunk[position+len(sep):]\n287|\t\tblank := rest[:len(rest)-len(strings.TrimLeft(rest, \" \\t\"))]\n288|\t\tval := strings.TrimLeft(rest, \" \\t\")\n289|\t\tquote := \"\"\n290|\t\tif strings.HasPrefix(val, `\"`) || strings.HasPrefix(val, `'`) {\n291|\t\t\tquote = val[:1]\n292|\t\t\tval = val[1:]\n293|\t\t}\n294|\t\t// An already-redacted value stays untouched: without this guard\n295|\t\t// the bracket and brace terminators below would eat into the\n296|\t\t// marker itself and idempotence would fail.\n297|\t\tif strings.HasPrefix(val, redactedMarker) {\n298|\t\t\treturn chunk\n299|\t\t}\n300|\t\tend := len(val)\n301|\t\tif quote != \"\" {\n302|\t\t\tif closing := strings.Index(val, quote); closing >= 0 {\n303|\t\t\t\tend = closing\n304|\t\t\t}\n305|\t\t} else {\n306|\t\t\tend = strings.IndexAny(val, \",;}]\")\n307|\t\t\tif end < 0 {\n308|\t\t\t\tend = len(val)\n309|\t\t\t}\n310|\t\t}\n311|\t\tif end == 0 {\n312|\t\t\tcontinue\n313|\t\t}\n314|\t\ttail := val[end:]\n315|\t\tif quote != \"\" && strings.HasPrefix(tail, quote) {\n316|\t\t\ttail = tail[len(quote):]\n317|\t\t\treturn head + key + chunk[position:position+len(sep)] + blank + quote + redactedMarker + quote + tail\n318|\t\t}\n319|\t\treturn head + key + chunk[position:position+len(sep)] + blank + quote + redactedMarker + tail\n320|\t}\n321|\treturn chunk\n322|}\n323|\n324|// splitChunkHead separates the key from its leading punctuation: opening\n325|// braces and quotes belong to the head, the key is the trailing key-shaped\n326|// run past one optional closing quote and trailing spaces.\n327|func splitChunkHead(before string) (head, key string) {\n328|\tkeyEnd := len(before)\n329|\tfor keyEnd > 0 && (before[keyEnd-1] == ' ' || before[keyEnd-1] == '\\t') {\n330|\t\tkeyEnd--\n331|\t}\n332|\tif keyEnd > 0 && (before[keyEnd-1] == '\"' || before[keyEnd-1] == '\\'') {\n333|\t\tkeyEnd--\n334|\t}\n335|\tkeyStart := keyEnd\n336|\tfor keyStart > 0 && isKeyByte(before[keyStart-1]) {\n337|\t\tkeyStart--\n338|\t}\n339|\tif keyStart == keyEnd {\n340|\t\treturn before, \"\"\n341|\t}\n342|\treturn before[:keyStart], before[keyStart:keyEnd]\n343|}\n344|\n345|// isKeyByte reports whether the byte can appear in a key: letters,\n346|// digits, underscore, dash, and dot. Key bytes are ASCII by construction,\n347|// so byte-wise scanning is exact.\n348|func isKeyByte(character byte) bool {\n349|\treturn character >= 'a' && character <= 'z' ||\n350|\t\tcharacter >= 'A' && character <= 'Z' ||\n351|\t\tcharacter >= '0' && character <= '9' ||\n352|\t\tcharacter == '_' || character == '-' || character == '.'\n353|}\n354|\n355|// redactURLUserinfo masks credentials in scheme://userinfo@host shapes:\n356|// everything between \"://\" and the next \"@\" is never displayable.\n357|func redactURLUserinfo(line string) string {\n358|\tvar rendered strings.Builder\n359|\trendered.Grow(len(line))\n360|\trest := line\n361|\tfor {\n362|\t\tscheme := strings.Index(rest, \"://\")\n363|\t\tif scheme < 0 {\n364|\t\t\trendered.WriteString(rest)\n365|\t\t\treturn rendered.String()\n366|\t\t}\n367|\t\tat := strings.Index(rest[scheme+3:], \"@\")\n368|\t\tif at < 0 {\n369|\t\t\trendered.WriteString(rest)\n370|\t\t\treturn rendered.String()\n371|\t\t}\n372|\t\tat += scheme + 3\n373|\t\tif strings.ContainsAny(rest[scheme+3:at], \" \\t\\\"'\") {\n374|\t\t\trendered.WriteString(rest[:scheme+3])\n375|\t\t\trest = rest[scheme+3:]\n376|\t\t\tcontinue\n377|\t\t}\n378|\t\trendered.WriteString(rest[:scheme+3])\n379|\t\trendered.WriteString(redactedMarker)\n380|\t\trest = rest[at:]\n381|\t}\n382|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
