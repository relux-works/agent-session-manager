{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7af","stream":{"kind":"session","id":"01a07750-3853-73c0-b383-0773367c2b50"},"sequence":562,"recorded_at":1780531400001119,"record_type":"event","durability":"durable","causation_id":"54033564-b97c-4244-a825-33fd926ad5cb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"54033564-b97c-4244-a825-33fd926ad5cb","run_stream":{"kind":"run","id":"54033564-b97c-4244-a825-33fd926ad5cb"},"task_stream":{"kind":"task","id":"ebdcc214-b68d-4172-bd56-6103bd517fea"},"task_id":"ebdcc214-b68d-4172-bd56-6103bd517fea","event":{"kind":"output","task_id":"ebdcc214-b68d-4172-bd56-6103bd517fea","chunk":"{\n  \"chunk_id\": \"exec-17-1\",\n  \"command\": \"grep -n \\\"symlink escape\\\\|guard root\\\\|README\\\" internal/secprim/*.go README.md 2>&1 | head -n 60\",\n  \"description\": \"Find README claims about symlink escape\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"internal/secprim/nofollow.go:17:// failPath \\\"member symlink escape\\\" refusal, and errors.Is against\\ninternal/secprim/nofollow.go:89:\\t\\treturn nil, failPath(\\\"guard root handle\\\", memberErrorTarget(member))\\ninternal/secprim/nofollow.go:92:\\t\\treturn nil, failPath(\\\"guard root handle\\\", memberErrorTarget(member))\\ninternal/secprim/nofollow.go:98:\\t\\t\\treturn nil, failPath(\\\"member symlink escape\\\", memberErrorTarget(member))\\ninternal/secprim/open_member_unix.go:26:// errCommitSymlink signal (refused as \\\"member symlink escape\\\" by the\\ninternal/secprim/open_member_windows.go:13:// the caller refuses as \\\"member symlink escape\\\".\\ninternal/secprim/open_unix_test.go:73:\\trequireRefusal(t, err, ErrUnsafePath, \\\"secprim unsafe path: member symlink escape: sub/loot\\\")\\ninternal/secprim/open_unix_test.go:149:\\t\\t\\t\\trequireRefusal(t, err, ErrUnsafePath, \\\"secprim unsafe path: member symlink escape: final-link\\\")\\ninternal/secprim/open_unix_test.go:184:\\t\\t\\t\\trequireRefusal(t, err, ErrUnsafePath, \\\"secprim unsafe path: guard root handle: ok/file\\\")\\ninternal/secprim/open_unix_test.go:191:\\t\\t\\t\\trequireRefusal(t, err, ErrUnsafePath, \\\"secprim unsafe path: guard root handle: ok/file\\\")\\ninternal/secprim/path_test.go:153:\\t\\trequireRefusal(t, err, ErrUnsafePath, \\\"secprim unsafe path: guard root: relative/root\\\")\\ninternal/secprim/path_test.go:258:\\tif _, found := DetectCaseCollision([]string{\\\"README.md\\\", \\\"src\\\"}, \\\"other\\\"); found {\\ninternal/secprim/path_test.go:261:\\tif _, found := DetectCaseCollision([]string{\\\"README.md\\\"}, \\\"README.md\\\"); found {\\ninternal/secprim/path_test.go:264:\\thit, found := DetectCaseCollision([]string{\\\"README.md\\\", \\\"src\\\"}, \\\"readme.MD\\\")\\ninternal/secprim/path_test.go:265:\\tif !found || hit != \\\"README.md\\\" {\\ninternal/secprim/path.go:115:\\t\\treturn Guard{}, failPath(\\\"guard root\\\", memberErrorTarget(root))\\ninternal/secprim/path.go:128:// Resolve maps one member name to its commit path inside the guard root.\\nREADME.md:72:See [.spec/README.md](.spec/README.md) for the pinned specification source,\\nREADME.md:1539:`TestREADMEFanInTableIsDerivedFromTheMeasuredProjection`, which parses these rows\\nREADME.md:1794:`TestREADMEFanInTableIsDerivedFromTheMeasuredProjection` re-derives the fan-in\\nREADME.md:1795:table above, and `TestREADMEOwnershipFiguresAreDerivedFromTheMeasuredReport`\\n\",\n  \"original_output_bytes\": 2260,\n  \"original_output_tokens\": 565,\n  \"truncated\": false\n}"}}}
