{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d29f","stream":{"kind":"session","id":"01a07750-3853-73c0-b383-0773367c2b50"},"sequence":1962,"recorded_at":1780531400003919,"record_type":"event","durability":"durable","causation_id":"54033564-b97c-4244-a825-33fd926ad5cb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"54033564-b97c-4244-a825-33fd926ad5cb","run_stream":{"kind":"run","id":"54033564-b97c-4244-a825-33fd926ad5cb"},"task_stream":{"kind":"task","id":"7c732666-bbad-47f4-98be-b809d251ba73"},"task_id":"7c732666-bbad-47f4-98be-b809d251ba73","event":{"kind":"output","task_id":"7c732666-bbad-47f4-98be-b809d251ba73","chunk":"Read text file `internal/secprim/path.go`.\n(209 line(s) above)\n210|// CheckRegularTarget refuses a stat result that is not a plain regular\n211|// file: symlinks, directories, devices, named pipes, and sockets\n212|// (Section 16.3 \"symlink/reparse escape\" and \"device/FIFO/socket\n213|// creation\"). A nil result is refused rather than treated as absent: a\n214|// failed stat is never a legitimate absence.\n215|func CheckRegularTarget(info os.FileInfo) error {\n216|\tif info == nil {\n217|\t\treturn failPath(\"target stat missing\", \"nil file info\")\n218|\t}\n219|\tmode := info.Mode()\n220|\tswitch {\n221|\tcase mode&os.ModeSymlink != 0:\n222|\t\treturn failPath(\"target symlink\", info.Name())\n223|\tcase info.IsDir():\n224|\t\treturn failPath(\"target directory\", info.Name())\n225|\tcase mode&os.ModeDevice != 0,\n226|\t\tmode&os.ModeNamedPipe != 0,\n227|\t\tmode&os.ModeSocket != 0,\n228|\t\tmode&os.ModeCharDevice != 0,\n229|\t\t!mode.IsRegular():\n230|\t\treturn failPath(\"target special file\", info.Name())\n231|\t}\n232|\treturn nil\n233|}"}}}
