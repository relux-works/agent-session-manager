{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4b9","stream":{"kind":"session","id":"01a07750-3853-73c0-b383-0773367c2b50"},"sequence":183,"recorded_at":1780531400000361,"record_type":"event","durability":"durable","causation_id":"54033564-b97c-4244-a825-33fd926ad5cb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"54033564-b97c-4244-a825-33fd926ad5cb","run_stream":{"kind":"run","id":"54033564-b97c-4244-a825-33fd926ad5cb"},"task_stream":{"kind":"task","id":"f0b3385f-4e7d-4665-ba45-4c2a6abc9d23"},"task_id":"f0b3385f-4e7d-4665-ba45-4c2a6abc9d23","event":{"kind":"output","task_id":"f0b3385f-4e7d-4665-ba45-4c2a6abc9d23","chunk":"Read text file `internal/secprim/inventory_test.go`.\n(499 line(s) above)\n500|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n501|\t\t\tcontinue\n502|\t\t}\n503|\t\tcontents, err := os.ReadFile(filepath.Join(directory, name))\n504|\t\tif err != nil {\n505|\t\t\treturn []string{fmt.Sprintf(\"derive secprim refusal inventory: %v\", err)}\n506|\t\t}\n507|\t\tsources[name] = contents\n508|\t}\n509|\tderivation, err := deriveRefusals(sources)\n510|\tif err != nil {\n511|\t\treturn []string{fmt.Sprintf(\"derive secprim refusal inventory: %v\", err)}\n512|\t}\n513|\tderived := derivation.sites\n514|\tvar failures []string\n515|\tif derivation.scanned == 0 {\n516|\t\tfailures = append(failures, \"scanned no production sources; the check is blind\")\n517|\t}\n518|\tif len(derived) == 0 {\n519|\t\tfailures = append(failures, \"derived no refusal sites; the scan is blind\")\n520|\t}\n521|\tif len(derivation.strays) != 0 {\n522|\t\tfailures = append(failures, \"refusal construction outside the constructors:\\n  \"+strings.Join(derivation.strays, \"\\n  \"))\n523|\t}\n524|\tfor site, defense := range defensiveSites {\n525|\t\t_ = defense\n526|\t\tmatched := false\n527|\t\tfor derivedSite, constructor := range derived {\n528|\t\t\tif constructor == site {\n529|\t\t\t\tmatched = true\n530|\t\t\t\t_ = derivedSite\n531|\t\t\t}\n532|\t\t}\n533|\t\tif !matched {\n534|\t\t\tfailures = append(failures, fmt.Sprintf(\"defensive site %s resolves to no derived site; the rationale is stale\", site))\n535|\t\t}\n536|\t}\n537|\tfor key := range platformExempt {\n538|\t\tif !exemptionResolves(derived, key) {\n539|\t\t\tfailures = append(failures, fmt.Sprintf(\"platform exemption %s resolves to no derived site; the exemption is stale\", key))\n540|\t\t}\n541|\t}\n542|\tfor key := range rootExempt {\n543|\t\tif !exemptionResolves(derived, key) {\n544|\t\t\tfailures = append(failures, fmt.Sprintf(\"root exemption %s resolves to no derived site; the exemption is stale\", key))\n545|\t\t}\n546|\t}\n547|\tfor site, constructor := range derived {\n548|\t\tif constructor == \"\" {\n549|\t\t\tfailures = append(failures, fmt.Sprintf(\"refusal site %s carries a non-literal rule; the roster cannot name it\", site))\n550|\t\t\tcontinue\n551|\t\t}\n552|\t\tif _, defensive := defensiveSites[constructor]; defensive {\n553|\t\t\tcontinue\n554|\t\t}\n555|\t\tif only, exempt := platformExempt[siteKey(site, constructor)]; exempt && runtime.GOOS == only {\n556|\t\t\tcontinue\n557|\t\t}\n558|\t\tif _, excused := rootExempt[siteKey(site, constructor)]; excused && privilegedUser() {\n559|\t\t\tcontinue\n560|\t\t}\n561|\t\tif _, exercised := exercisedRefusalSites.Load(site); !exercised {\n562|\t\t\tfailures = append(failures, fmt.Sprintf(\"refusal site %s never fired during the suite\", site))\n563|\t\t}\n564|\t}\n565|\texercisedRefusalSites.Range(func(key, _ any) bool {\n566|\t\tif _, ok := derived[key.(string)]; !ok {\n567|\t\t\tfailures = append(failures, fmt.Sprintf(\"exercised refusal site %s resolves to no derived site\", key.(string)))\n568|\t\t}\n569|\t\treturn true\n570|\t})\n571|\treturn failures\n572|}\n573|\n574|// TestRefusalInventoryClosesBypassShapes plants every member of the\n575|// refusal-construction shape space through the same deriveRefusals the\n576|// audit runs on the real tree, and requires each plant to be caught.\n577|// The control proves the instrument works (an unexercised bare call is\n578|// an unfired site); plants A-D are the four bypasses that walked\n579|// through the old identifier-keyed gate, and the remaining three close\n580|// the rest of the enumerated space.\n581|func TestRefusalInventoryClosesBypassShapes(t *testing.T) {\n582|\tt.Parallel()\n583|\tplants := map[string][]byte{\n584|\t\t// CONTROL: a bare constructor call no test fires.\n585|\t\t\"plant_control.go\": []byte(\"package secprim\\n\\nfunc plantControl() error {\\n\\treturn failArgv(\\\"plant control\\\", \\\"nowhere\\\")\\n}\\n\"),\n586|\t\t// A: package-level var alias, then a call through it.\n587|\t\t\"plant_a.go\": []byte(\"package secprim\\n\\nvar failArgvAlias = failArgv\\n\\nfunc plantA() error {\\n\\treturn failArgvAlias(\\\"plant a\\\", \\\"nowhere\\\")\\n}\\n\"),\n588|\t\t// B: a direct Error literal, the shape errors.go forbids.\n589|\t\t\"plant_b.go\": []byte(\"package secprim\\n\\nfunc plantB() error {\\n\\treturn &Error{Kind: ErrUnsafeArgv, Rule: \\\"plant b\\\", Detail: \\\"nowhere\\\"}\\n}\\n\"),\n590|\t\t// C: a method factory plus a selector call through it.\n591|\t\t\"plant_c.go\": []byte(\"package secprim\\n\\ntype plantMaker struct{}\\n\\nfunc (plantMaker) argv(rule, detail string) *Error {\\n\\treturn &Error{Kind: ErrUnsafeArgv, Rule: rule, Detail: detail}\\n}\\n\\nfunc plantC() error {\\n\\treturn plantMaker{}.argv(\\\"plant c\\\", \\\"nowhere\\\")\\n}\\n\"),\n592|\t\t// D: a function-local binding, then a call through it.\n593|\t\t\"plant_d.go\": []byte(\"package secprim\\n\\nfunc plantD() error {\\n\\tmake := failArgv\\n\\treturn make(\\\"plant d\\\", \\\"nowhere\\\")\\n}\\n\"),\n594|\t\t// E: the constructor escaping as a value, never called.\n595|\t\t\"plant_e.go\": []byte(\"package secprim\\n\\nfunc takeArgv(make func(string, string) *Error) func(string, string) *Error {\\n\\treturn make\\n}\\n\\nvar plantEscape = takeArgv(failArgv)\\n\"),\n596|\t\t// F: new(Error) manufacturing a zero refusal.\n597|\t\t\"plant_f.go\": []byte(\"package secprim\\n\\nfunc plantF() error {\\n\\tfailure := new(Error)\\n\\tfailure.Kind = ErrUnsafeArgv\\n\\treturn failure\\n}\\n\"),\n598|\t\t// G: an alias of an alias, then a call through it.\n599|\t\t\"plant_g.go\": []byte(\"package secprim\\n\\nvar failArgvAlias = failArgv\\n\\nvar failArgvAlias2 = failArgvAlias\\n\\nfunc plantG() error {\\n\\treturn failArgvAlias2(\\\"plant g\\\", \\\"nowhere\\\")\\n}\\n\"),\n600|\t}\n601|\t// Each plant runs through the derivation alone (plus nothing):\n602|\t// plants must not see each other's declarations, the way a real\n603|\t// bypass would sit beside honest production code that must stay\n604|\t// clean.\n605|\tderive := func(t *testing.T, name string) refusalDerivation {\n606|\t\tt.Helper()\n607|\t\tderivation, err := deriveRefusals(map[string][]byte{name: plants[name]})\n608|\t\tif err != nil {\n609|\t\t\tt.Fatalf(\"derive %s: %v\", name, err)\n610|\t\t}\n611|\t\treturn derivation\n612|\t}\n613|\tcontains := func(t *testing.T, name string, strays []string, word string) {\n614|\t\tt.Helper()\n615|\t\tfor _, stray := range strays {\n616|\t\t\tif strings.Contains(stray, word) {\n617|\t\t\t\treturn\n618|\t\t\t}\n619|\t\t}\n620|\t\tt.Fatalf(\"%s: no stray containing %q in %v\", name, word, strays)\n621|\t}\n622|\tt.Run(\"control is an unfired site\", func(t *testing.T) {\n623|\t\tt.Parallel()\n624|\t\tderivation := derive(t, \"plant_control.go\")\n625|\t\tif len(derivation.strays) != 0 {\n626|\t\t\tt.Fatalf(\"control strays %v; the honest shape must stay clean\", derivation.strays)\n627|\t\t}\n628|\t\tif len(derivation.sites) != 1 {\n629|\t\t\tt.Fatalf(\"control sites = %v, want the one bare call\", derivation.sites)\n630|\t\t}\n631|\t})\n632|\tt.Run(\"var alias\", func(t *testing.T) {\n633|\t\tt.Parallel()\n634|\t\tderivation := derive(t, \"plant_a.go\")\n635|\t\tcontains(t, \"plant A\", derivation.strays, \"alias failArgvAlias\")\n636|\t})\n637|\tt.Run(\"direct literal\", func(t *testing.T) {\n638|\t\tt.Parallel()\n639|\t\tderivation := derive(t, \"plant_b.go\")\n640|\t\tcontains(t, \"plant B\", derivation.strays, \"Error literal\")\n641|\t})\n642|\tt.Run(\"method factory\", func(t *testing.T) {\n643|\t\tt.Parallel()\n644|\t\tderivation := derive(t, \"plant_c.go\")\n645|\t\tcontains(t, \"plant C decl\", derivation.strays, \"factory argv\")\n646|\t\tcontains(t, \"plant C call\", derivation.strays, \"factory call argv\")\n647|\t\tcontains(t, \"plant C literal\", derivation.strays, \"Error literal\")\n648|\t})\n649|\tt.Run(\"local binding\", func(t *testing.T) {\n650|\t\tt.Parallel()\n651|\t\tderivation := derive(t, \"plant_d.go\")\n652|\t\tcontains(t, \"plant D\", derivation.strays, \"alias make\")\n653|\t})\n654|\tt.Run(\"value escape\", func(t *testing.T) {\n655|\t\tt.Parallel()\n656|\t\tderivation := derive(t, \"plant_e.go\")\n657|\t\tcontains(t, \"plant E\", derivation.strays, \"escapes as a value\")\n658|\t})\n659|\tt.Run(\"new Error\", func(t *testing.T) {\n660|\t\tt.Parallel()\n661|\t\tderivation := derive(t, \"plant_f.go\")\n662|\t\tcontains(t, \"plant F\", derivation.strays, \"new(Error)\")\n663|\t})\n664|\tt.Run(\"alias of alias\", func(t *testing.T) {\n665|\t\tt.Parallel()\n666|\t\tderivation := derive(t, \"plant_g.go\")\n667|\t\tcontains(t, \"plant G\", derivation.strays, \"alias failArgvAlias2\")\n668|\t})\n669|}"}}}
