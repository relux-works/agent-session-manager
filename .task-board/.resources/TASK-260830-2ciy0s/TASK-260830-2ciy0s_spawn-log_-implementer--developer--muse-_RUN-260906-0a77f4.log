{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c437","stream":{"kind":"session","id":"01a07750-3853-73c0-b383-0773367c2b50"},"sequence":118,"recorded_at":1780531400000231,"record_type":"event","durability":"durable","causation_id":"54033564-b97c-4244-a825-33fd926ad5cb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"54033564-b97c-4244-a825-33fd926ad5cb","run_stream":{"kind":"run","id":"54033564-b97c-4244-a825-33fd926ad5cb"},"task_stream":{"kind":"task","id":"220cd2eb-374a-4aef-a291-4828cc2d1614"},"task_id":"220cd2eb-374a-4aef-a291-4828cc2d1614","event":{"kind":"output","task_id":"220cd2eb-374a-4aef-a291-4828cc2d1614","chunk":"Read text file `internal/secprim/errors.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|)\n7|\n8|// Refusal sentinels. Every refusal this package produces wraps exactly one\n9|// of these, so callers match on the kind without parsing human text.\n10|var (\n11|\tErrUnsafePath = errors.New(\"secprim unsafe path\")\n12|\tErrUnsafeArgv = errors.New(\"secprim unsafe argv\")\n13|\tErrUnsafeEnv  = errors.New(\"secprim unsafe environment\")\n14|)\n15|\n16|// Error is the only refusal this package produces. Kind is one of the\n17|// sentinels above; Rule names the specification rule that fired\n18|// (for example \"member traversal\" or \"argv NUL\"); Detail names the\n19|// offending member, argument position, or variable name without echoing\n20|// foreign bytes beyond what names the site.\n21|type Error struct {\n22|\tKind   error\n23|\tRule   string\n24|\tDetail string\n25|\tcause  error\n26|}\n27|\n28|func (err *Error) Error() string {\n29|\tif err.cause == nil {\n30|\t\treturn fmt.Sprintf(\"%v: %s: %s\", err.Kind, err.Rule, err.Detail)\n31|\t}\n32|\treturn fmt.Sprintf(\"%v: %s: %s: %v\", err.Kind, err.Rule, err.Detail, err.cause)\n33|}\n34|\n35|// WithCause records the underlying filesystem failure for errors.Is and\n36|// errors.As without changing the refusal rendering the witnesses pin:\n37|// the cause appends after the pinned prefix.\n38|func (err *Error) WithCause(cause error) *Error {\n39|\terr.cause = cause\n40|\treturn err\n41|}\n42|\n43|func (err *Error) Unwrap() []error {\n44|\tif err.cause == nil {\n45|\t\treturn []error{err.Kind}\n46|\t}\n47|\treturn []error{err.Kind, err.cause}\n48|}\n49|\n50|// The three refusal constructors below are declared as variables so the\n51|// refusal-inventory gate can observe every exercised refusal site. Each is\n52|// the single construction site for its failure class; production code must\n53|// not build Error values any other way: no aliasing a constructor into a\n54|// second name, no &Error{} or Error{} literal, no new(Error), and no\n55|// wrapper function or method that manufactures an *Error. The inventory\n56|// test enforces every member of that shape space, not just the bare\n57|// constructor spelling.\n58|//\n59|// failPath reports a Section 16.3 path or filesystem refusal: a member\n60|// outside the contained grammar, a symlink or special file where a\n61|// regular file is required, a case-fold collision, or an unmanaged\n62|// replacement.\n63|//\n64|// failArgv reports a Section 16.4 argv refusal: an empty vector, an empty\n65|// executable or argument element, a NUL byte, or invalid UTF-8.\n66|//\n67|// failEnv reports a Section 16.7 environment refusal: a name outside the\n68|// environment-name grammar, a literal colliding with an inherited name, or\n69|// a NUL byte or invalid UTF-8 in a value.\n70|var failPath = func(rule, detail string) *Error {\n71|\treturn &Error{Kind: ErrUnsafePath, Rule: rule, Detail: detail}\n72|}\n73|\n74|var failArgv = func(rule, detail string) *Error {\n75|\treturn &Error{Kind: ErrUnsafeArgv, Rule: rule, Detail: detail}\n76|}\n77|\n78|var failEnv = func(rule, detail string) *Error {\n79|\treturn &Error{Kind: ErrUnsafeEnv, Rule: rule, Detail: detail}\n80|}"}}}
