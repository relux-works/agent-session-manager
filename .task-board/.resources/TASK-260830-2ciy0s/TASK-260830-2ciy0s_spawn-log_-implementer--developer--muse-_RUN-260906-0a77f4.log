{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7a9","stream":{"kind":"session","id":"01a07750-3853-73c0-b383-0773367c2b50"},"sequence":559,"recorded_at":1780531400001113,"record_type":"event","durability":"durable","causation_id":"54033564-b97c-4244-a825-33fd926ad5cb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"54033564-b97c-4244-a825-33fd926ad5cb","run_stream":{"kind":"run","id":"54033564-b97c-4244-a825-33fd926ad5cb"},"task_stream":{"kind":"task","id":"734fd357-2ba3-4d8e-be0e-1f7578d07f5a"},"task_id":"734fd357-2ba3-4d8e-be0e-1f7578d07f5a","event":{"kind":"output","task_id":"734fd357-2ba3-4d8e-be0e-1f7578d07f5a","chunk":"Read text file `internal/secprim/path_test.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"runtime\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// requireRefusal asserts the full refusal rendering: kind, rule, and\n15|// detail. A code or suffix several gates share proves nothing about which\n16|// gate fired, so witnesses pin the whole string.\n17|func requireRefusal(t *testing.T, err error, kind error, want string) {\n18|\tt.Helper()\n19|\tif err == nil {\n20|\t\tt.Fatalf(\"admitted; want refusal %q\", want)\n21|\t}\n22|\tif !errors.Is(err, kind) {\n23|\t\tt.Fatalf(\"error %v does not match kind %v; want %q\", err, kind, want)\n24|\t}\n25|\tif err.Error() != want {\n26|\t\tt.Fatalf(\"refusal = %q, want %q\", err.Error(), want)\n27|\t}\n28|}\n29|\n30|// requireRefusalPrefix pins the stable rule prefix of a cause-carrying\n31|// refusal. The appended OS cause text differs by platform, so only the\n32|// prefix is pinned here; the cause itself is proven with errors.Is at the\n33|// call site.\n34|func requireRefusalPrefix(t *testing.T, err error, kind error, wantPrefix string) {\n35|\tt.Helper()\n36|\tif err == nil {\n37|\t\tt.Fatalf(\"admitted; want refusal with prefix %q\", wantPrefix)\n38|\t}\n39|\tif !errors.Is(err, kind) {\n40|\t\tt.Fatalf(\"error %v does not match kind %v; want prefix %q\", err, kind, wantPrefix)\n41|\t}\n42|\tif !strings.HasPrefix(err.Error(), wantPrefix) {\n43|\t\tt.Fatalf(\"refusal = %q, want prefix %q\", err.Error(), wantPrefix)\n44|\t}\n45|}\n46|\n47|func TestCheckMemberPathAdmits(t *testing.T) {\n48|\tt.Parallel()\n49|\tmembers := []string{\n50|\t\t\"a\", \"a/b/c\", \"dir.with.dots/file\", \"100%.txt\", \"a%20b\",\n51|\t\t\"a b/c d\", \"ünïcodé/名前\", \".hidden\", \"a/.hidden/b\",\n52|\t\t// A colon is legal on POSIX past the scalar drive-prefix rule\n53|\t\t// (\"ab:c\" is not drive-shaped); the ADS rule is Windows-only.\n54|\t\t\"ab:c\",\n55|\t}\n56|\tfor _, platform := range []scalar.Platform{scalar.PlatformMacOS, scalar.PlatformLinux, scalar.PlatformWSL2} {\n57|\t\tfor _, member := range members {\n58|\t\t\tif err := CheckMemberPath(platform, member); err != nil {\n59|\t\t\t\tt.Errorf(\"CheckMemberPath(%s, %q) = %v, want admission\", platform, member, err)\n60|\t\t\t}\n61|\t\t}\n62|\t}\n63|\twindowsMembers := []string{\"a\", \"a/b/c\", \"100%.txt\", \"a%20b\", \".hidden\"}\n64|\tfor _, member := range windowsMembers {\n65|\t\tif err := CheckMemberPath(scalar.PlatformWindows, member); err != nil {\n66|\t\t\tt.Errorf(\"CheckMemberPath(windows, %q) = %v, want admission\", member, err)\n67|\t\t}\n68|\t}\n69|}\n70|\n71|func TestCheckMemberPathRefuses(t *testing.T) {\n72|\tt.Parallel()\n73|\tcases := []struct {\n74|\t\tname     string\n75|\t\tplatform scalar.Platform\n76|\t\tmember   string\n77|\t\twant     string\n78|\t}{\n79|\t\t{\"empty\", scalar.PlatformLinux, \"\", \"secprim unsafe path: member grammar: \"},\n80|\t\t{\"dot\", scalar.PlatformLinux, \".\", \"secprim unsafe path: member grammar: .\"},\n81|\t\t{\"parent\", scalar.PlatformLinux, \"..\", \"secprim unsafe path: member grammar: ..\"},\n82|\t\t{\"nested parent\", scalar.PlatformLinux, \"a/../b\", \"secprim unsafe path: member grammar: a/../b\"},\n83|\t\t{\"nested dot\", scalar.PlatformLinux, \"a/./b\", \"secprim unsafe path: member grammar: a/./b\"},\n84|\t\t{\"empty segment\", scalar.PlatformLinux, \"a//b\", \"secprim unsafe path: member grammar: a//b\"},\n85|\t\t{\"absolute\", scalar.PlatformLinux, \"/abs\", \"secprim unsafe path: member grammar: /abs\"},\n86|\t\t{\"trailing slash\", scalar.PlatformLinux, \"a/\", \"secprim unsafe path: member grammar: a/\"},\n87|\t\t{\"backslash\", scalar.PlatformLinux, `a\\b`, `secprim unsafe path: member grammar: a\\b`},\n88|\t\t{\"nul\", scalar.PlatformLinux, \"a\\x00b\", \"secprim unsafe path: member grammar: a\\x00b\"},\n89|\t\t{\"drive\", scalar.PlatformLinux, \"c:x\", \"secprim unsafe path: member grammar: c:x\"},\n90|\t\t{\"encoded slash\", scalar.PlatformLinux, \"a%2fb\", \"secprim unsafe path: member grammar: a%2fb\"},\n91|\t\t{\"encoded slash upper\", scalar.PlatformLinux, \"a%2Fb\", \"secprim unsafe path: member grammar: a%2Fb\"},\n92|\t\t{\"encoded backslash\", scalar.PlatformLinux, \"a%5cb\", \"secprim unsafe path: member grammar: a%5cb\"},\n93|\t\t{\"double-encoded slash\", scalar.PlatformLinux, \"a%252fb\", \"secprim unsafe path: member grammar: a%252fb\"},\n94|\t\t{\"encoded dot\", scalar.PlatformLinux, \"a%2e%2e/b\", \"secprim unsafe path: member encoded dot: a%2e%2e/b\"},\n95|\t\t{\"encoded dot single\", scalar.PlatformLinux, \"%2e\", \"secprim unsafe path: member encoded dot: %2e\"},\n96|\t\t{\"encoded dot upper\", scalar.PlatformLinux, \"a%2E/b\", \"secprim unsafe path: member encoded dot: a%2E/b\"},\n97|\t\t{\"double-encoded dot\", scalar.PlatformLinux, \"a%252e/b\", \"secprim unsafe path: member encoded dot: a%252e/b\"},\n98|\t\t{\"overlong separator\", scalar.PlatformLinux, \"a%c0%afb\", \"secprim unsafe path: member overlong separator: a%c0%afb\"},\n99|\t\t{\"overlong separator upper\", scalar.PlatformLinux, \"a%C0%AFb\", \"secprim unsafe path: member overlong separator: a%C0%AFb\"},\n100|\t\t{\"double-encoded overlong\", scalar.PlatformLinux, \"a%25c0%afb\", \"secprim unsafe path: member overlong separator: a%25c0%afb\"},\n101|\t\t{\"windows ads\", scalar.PlatformWindows, \"ab:c\", \"secprim unsafe path: member alternate stream: ab:c\"},\n102|\t\t{\"windows ads nested\", scalar.PlatformWindows, \"a/b:c/d\", \"secprim unsafe path: member alternate stream: a/b:c/d\"},\n103|\t\t{\"windows drive\", scalar.PlatformWindows, \"a:b\", \"secprim unsafe path: member grammar: a:b\"},\n104|\t\t{\"posix drive\", scalar.PlatformLinux, \"a:b\", \"secprim unsafe path: member grammar: a:b\"},\n105|\t\t{\"windows con\", scalar.PlatformWindows, \"con\", \"secprim unsafe path: member reserved device name: con\"},\n106|\t\t{\"windows con upper\", scalar.PlatformWindows, \"CON\", \"secprim unsafe path: member reserved device name: CON\"},\n107|\t\t{\"windows con ext\", scalar.PlatformWindows, \"con.txt\", \"secprim unsafe path: member reserved device name: con.txt\"},\n108|\t\t{\"windows lpt\", scalar.PlatformWindows, \"dir/lpt1\", \"secprim unsafe path: member reserved device name: dir/lpt1\"},\n109|\t\t{\"windows com\", scalar.PlatformWindows, \"com9.log\", \"secprim unsafe path: member reserved device name: com9.log\"},\n110|\t\t{\"windows trailing dot\", scalar.PlatformWindows, \"a./b\", \"secprim unsafe path: member trailing dot or space: a./b\"},\n111|\t\t{\"windows trailing space\", scalar.PlatformWindows, \"a /b\", \"secprim unsafe path: member trailing dot or space: a /b\"},\n112|\t\t{\"windows backslash\", scalar.PlatformWindows, `a\\b`, `secprim unsafe path: member grammar: a\\b`},\n113|\t\t{\"windows absolute\", scalar.PlatformWindows, `C:\\x`, `secprim unsafe path: member grammar: C:\\x`},\n114|\t}\n115|\tfor _, kase := range cases {\n116|\t\tt.Run(kase.name, func(t *testing.T) {\n117|\t\t\tt.Parallel()\n118|\t\t\terr := CheckMemberPath(kase.platform, kase.member)\n119|\t\t\trequireRefusal(t, err, ErrUnsafePath, kase.want)\n120|\t\t})\n121|\t}\n122|}\n123|\n124|func TestCheckMemberPathTruncatesLongMembers(t *testing.T) {\n125|\tt.Parallel()\n126|\tmember := strings.Repeat(\"a\", 40) + \"/../\" + strings.Repeat(\"b\", 40)\n127|\terr := CheckMemberPath(scalar.PlatformLinux, member)\n128|\trequireRefusal(t, err, ErrUnsafePath, \"secprim unsafe path: member grammar: \"+member[:64]+\"...\")\n129|}\n130|\n131|func TestGuardResolve(t *testing.T) {\n132|\tt.Parallel()\n133|\tguard, err := NewGuard(\"/stage/root\", scalar.PlatformLinux, nil)\n134|\tif err != nil {\n135|\t\tt.Fatalf(\"NewGuard = %v\", err)\n136|\t}\n137|\tfor member, want := range map[string]string{\n138|\t\t\"a\":     \"/stage/root/a\",\n139|\t\t\"a/b/c\": \"/stage/root/a/b/c\",\n140|\t} {\n141|\t\tgot, err := guard.Resolve(member)\n142|\t\tif err != nil {\n143|\t\t\tt.Errorf(\"Resolve(%q) = %v\", member, err)\n144|\t\t\tcontinue\n145|\t\t}\n146|\t\tif got != want {\n147|\t\t\tt.Errorf(\"Resolve(%q) = %q, want %q\", member, got, want)\n148|\t\t}\n149|\t}\n150|\tif _, err := NewGuard(\"relative/root\", scalar.PlatformLinux, nil); err == nil {\n151|\t\tt.Error(\"NewGuard(relative) admitted; the root must be absolute\")\n152|\t} else {\n153|\t\trequireRefusal(t, err, ErrUnsafePath, \"secprim unsafe path: guard root: relative/root\")\n154|\t}\n155|\twindows, err := NewGuard(`C:\\stage`, scalar.PlatformWindows, nil)\n156|\tif err != nil {\n157|\t\tt.Fatalf(\"NewGuard windows = %v\", err)\n158|\t}\n159|\tgot, err := windows.Resolve(\"a/b\")\n160|\tif err != nil {\n161|\t\tt.Fatalf(\"Resolve windows = %v\", err)\n162|\t}\n163|\tif got != `C:\\stage\\a\\b` {\n164|\t\tt.Fatalf(\"Resolve windows = %q, want native separators\", got)\n165|\t}\n166|\tunc, err := NewGuard(`\\\\server\\share`, scalar.PlatformWindows, nil)\n167|\tif err != nil {\n168|\t\tt.Fatalf(\"NewGuard UNC = %v\", err)\n169|\t}\n170|\tgot, err = unc.Resolve(\"a/b\")\n171|\tif err != nil {\n172|\t\tt.Fatalf(\"Resolve UNC = %v\", err)\n173|\t}\n174|\tif got != `\\\\server\\share\\a\\b` {\n175|\t\tt.Fatalf(\"Resolve UNC = %q, want the share preserved\", got)\n176|\t}\n177|}\n178|\n179|func TestGuardManagedSet(t *testing.T) {\n180|\tt.Parallel()\n181|\topen, err := NewGuard(\"/stage\", scalar.PlatformLinux, nil)\n182|\tif err != nil {\n183|\t\tt.Fatal(err)\n184|\t}\n185|\tif _, err := open.Resolve(\"anything/goes\"); err != nil {\n186|\t\tt.Fatalf(\"nil managed set refused a member: %v\", err)\n187|\t}\n188|\tempty, err := NewGuard(\"/stage\", scalar.PlatformLinux, []string{})\n189|\tif err != nil {\n190|\t\tt.Fatal(err)\n191|\t}\n192|\t_, err = empty.Resolve(\"a\")\n193|\trequireRefusal(t, err, ErrUnsafePath, \"secprim unsafe path: member unmanaged: a\")\n194|\texact, err := NewGuard(\"/stage\", scalar.PlatformLinux, []string{\"a/b\"})\n195|\tif err != nil {\n196|\t\tt.Fatal(err)\n197|\t}\n198|\tif _, err := exact.Resolve(\"a/b\"); err != nil {\n199|\t\tt.Fatalf(\"managed member refused: %v\", err)\n200|\t}\n201|\t_, err = exact.Resolve(\"a/c\")\n202|\trequireRefusal(t, err, ErrUnsafePath, \"secprim unsafe path: member unmanaged: a/c\")\n203|\t// The managed set is exact, never case-folded: a case variant of a\n204|\t// managed member is a different member and refuses as unmanaged.\n205|\t_, err = exact.Resolve(\"A/B\")\n206|\trequireRefusal(t, err, ErrUnsafePath, \"secprim unsafe path: member unmanaged: A/B\")\n207|}\n208|\n209|// TestGuardPrefixCheckIsLoadBearing is the structural tripwire for the\n210|// defensive joined-prefix conjunct in Resolve: the member grammar refuses\n211|// every parent segment, so no admitted member can escape the root, and\n212|// this test proves that property over a generated hostile corpus rather\n213|// than trusting the grammar. If the grammar ever weakens, an escaped join\n214|// reddens here first.\n215|func TestGuardPrefixCheckIsLoadBearing(t *testing.T) {\n216|\tt.Parallel()\n217|\tsegments := []string{\"a\", \".\", \"..\", \"\", \"b c\", \"%2e%2e\", \"%2f\", \"x\"}\n218|\tguard, err := NewGuard(\"/stage/root\", scalar.PlatformLinux, nil)\n219|\tif err != nil {\n220|\t\tt.Fatal(err)\n221|\t}\n222|\tescaped := 0\n223|\tadmitted := 0\n224|\tvar build func(depth int, current string)\n225|\tbuild = func(depth int, current string) {\n226|\t\tif depth == 3 {\n227|\t\t\tgot, err := guard.Resolve(current)\n228|\t\t\tif err != nil {\n229|\t\t\t\treturn\n230|\t\t\t}\n231|\t\t\tadmitted++\n232|\t\t\tif got != \"/stage/root\" && !strings.HasPrefix(got, \"/stage/root/\") {\n233|\t\t\t\tescaped++\n234|\t\t\t\tt.Errorf(\"Resolve(%q) escaped to %q\", current, got)\n235|\t\t\t}\n236|\t\t\treturn\n237|\t\t}\n238|\t\tfor _, segment := range segments {\n239|\t\t\tnext := segment\n240|\t\t\tif current != \"\" {\n241|\t\t\t\tnext = current + \"/\" + segment\n242|\t\t\t}\n243|\t\t\tbuild(depth+1, next)\n244|\t\t}\n245|\t}\n246|\tbuild(0, \"\")\n247|\tif admitted == 0 {\n248|\t\tt.Fatal(\"no generated member was admitted; the corpus proves nothing\")\n249|\t}\n250|\tif escaped != 0 {\n251|\t\tt.Fatalf(\"%d admitted members escaped the root\", escaped)\n252|\t}\n253|\tt.Logf(\"prefix property holds over %d admitted of %d generated members\", admitted, 8*8*8)\n254|}\n255|\n256|func TestDetectCaseCollision(t *testing.T) {\n257|\tt.Parallel()\n258|\tif _, found := DetectCaseCollision([]string{\"README.md\", \"src\"}, \"other\"); found {\n259|\t\tt.Fatal(\"distinct names reported as a collision\")\n260|\t}\n261|\tif _, found := DetectCaseCollision([]string{\"README.md\"}, \"README.md\"); found {\n262|\t\tt.Fatal(\"an identical name is the same file, not a collision\")\n263|\t}\n264|\thit, found := DetectCaseCollision([]string{\"README.md\", \"src\"}, \"readme.MD\")\n265|\tif !found || hit != \"README.md\" {\n266|\t\tt.Fatalf(\"case-fold collision missed: %q %v\", hit, found)\n267|\t}\n268|}\n269|\n270|func TestCheckRegularTarget(t *testing.T) {\n271|\tt.Parallel()\n272|\trequireRefusal(t, CheckRegularTarget(nil), ErrUnsafePath, \"secprim unsafe path: target stat missing: nil file info\")\n273|\troot := t.TempDir()\n274|\tregular := filepath.Join(root, \"file\")\n275|\tif err := os.WriteFile(regular, []byte(\"bytes\"), 0o600); err != nil {\n276|\t\tt.Fatal(err)\n277|\t}\n278|\tinfo, err := os.Lstat(regular)\n279|\tif err != nil {\n280|\t\tt.Fatal(err)\n281|\t}\n282|\tif err := CheckRegularTarget(info); err != nil {\n283|\t\tt.Fatalf(\"regular file refused: %v\", err)\n284|\t}\n285|\tdirInfo, err := os.Lstat(root)\n286|\tif err != nil {\n287|\t\tt.Fatal(err)\n288|\t}\n289|\trequireRefusal(t, CheckRegularTarget(dirInfo), ErrUnsafePath, \"secprim unsafe path: target directory: \"+dirInfo.Name())\n290|\t// An empty directory refuses exactly like a populated one: size\n291|\t// never participates in the directory decision.\n292|\tempty := filepath.Join(root, \"emptydir\")\n293|\tif err := os.Mkdir(empty, 0o700); err != nil {\n294|\t\tt.Fatal(err)\n295|\t}\n296|\temptyInfo, err := os.Lstat(empty)\n297|\tif err != nil {\n298|\t\tt.Fatal(err)\n299|\t}\n300|\trequireRefusal(t, CheckRegularTarget(emptyInfo), ErrUnsafePath, \"secprim unsafe path: target directory: emptydir\")\n301|\tlink := filepath.Join(root, \"link\")\n302|\tif err := os.Symlink(regular, link); err != nil {\n303|\t\tif runtime.GOOS == \"windows\" {\n304|\t\t\tt.Skipf(\"no symlink privilege on %s\", runtime.GOOS)\n305|\t\t}\n306|\t\tt.Fatal(err)\n307|\t}\n308|\tlinkInfo, err := os.Lstat(link)\n309|\tif err != nil {\n310|\t\tt.Fatal(err)\n311|\t}\n312|\trequireRefusal(t, CheckRegularTarget(linkInfo), ErrUnsafePath, \"secprim unsafe path: target symlink: link\")\n313|\tif runtime.GOOS != \"windows\" {\n314|\t\tfifo := filepath.Join(root, \"fifo\")\n315|\t\tmakeFifo(t, fifo)\n316|\t\tfifoInfo, err := os.Lstat(fifo)\n317|\t\tif err != nil {\n318|\t\t\tt.Fatal(err)\n319|\t\t}\n320|\t\trequireRefusal(t, CheckRegularTarget(fifoInfo), ErrUnsafePath, \"secprim unsafe path: target special file: fifo\")\n321|\t\tnullInfo, err := os.Lstat(\"/dev/null\")\n322|\t\tif err != nil {\n323|\t\t\tt.Fatal(err)\n324|\t\t}\n325|\t\trequireRefusal(t, CheckRegularTarget(nullInfo), ErrUnsafePath, \"secprim unsafe path: target special file: null\")\n326|\t}\n327|}\n328|\n329|func TestOpenNoFollowFile(t *testing.T) {\n330|\tt.Parallel()\n331|\troot := t.TempDir()\n332|\tregular := filepath.Join(root, \"file\")\n333|\tif err := os.WriteFile(regular, []byte(\"payload\"), 0o600); err != nil {\n334|\t\tt.Fatal(err)\n335|\t}\n336|\tfile, err := OpenNoFollowFile(regular)\n337|\tif err != nil {\n338|\t\tt.Fatalf(\"regular file refused: %v\", err)\n339|\t}\n340|\tcontents := make([]byte, 7)\n341|\tif _, err := file.Read(contents); err != nil {\n342|\t\tt.Fatal(err)\n343|\t}\n344|\t_ = file.Close()\n345|\tif string(contents) != \"payload\" {\n346|\t\tt.Fatalf(\"read %q through the no-follow handle\", contents)\n347|\t}\n348|\tsubdir := filepath.Join(root, \"dir\")\n349|\tif err := os.Mkdir(subdir, 0o700); err != nil {\n350|\t\tt.Fatal(err)\n351|\t}\n352|\t_, err = OpenNoFollowFile(subdir)\n353|\trequireRefusal(t, err, ErrUnsafePath, \"secprim unsafe path: target directory: dir\")\n354|\t// Cause-carrying refusals pin the stable prefix, not the OS text: the\n355|\t// errno rendering differs by platform while the rule and target do\n356|\t// not. errors.Is still proves the kind, and errors.Is(err,\n357|\t// fs.ErrNotExist) proves the cause survived.\n358|\t_, err = OpenNoFollowFile(filepath.Join(root, \"missing\"))\n359|\ttarget := filepath.Join(root, \"missing\")\n360|\tif len(target) > 64 {\n361|\t\ttarget = target[:64] + \"...\"\n362|\t}\n363|\trequireRefusalPrefix(t, err, ErrUnsafePath, \"secprim unsafe path: open failed: \"+target)\n364|\tif !errors.Is(err, os.ErrNotExist) {\n365|\t\tt.Fatalf(\"open cause does not wrap ErrNotExist: %v\", err)\n366|\t}\n367|\tlink := filepath.Join(root, \"link\")\n368|\tif err := os.Symlink(regular, link); err != nil {\n369|\t\tif runtime.GOOS == \"windows\" {\n370|\t\t\tt.Skipf(\"no symlink privilege on %s\", runtime.GOOS)\n371|\t\t}\n372|\t\tt.Fatal(err)\n373|\t}\n374|\t_, err = OpenNoFollowFile(link)\n375|\tif err == nil {\n376|\t\tt.Fatal(\"symlink traversed by the no-follow open\")\n377|\t}\n378|\tif !errors.Is(err, ErrUnsafePath) {\n379|\t\tt.Fatalf(\"symlink refusal = %v, want ErrUnsafePath\", err)\n380|\t}\n381|}\n382|\n383|func TestOpenNoFollowDir(t *testing.T) {\n384|\tt.Parallel()\n385|\troot := t.TempDir()\n386|\tdir, err := OpenNoFollowDir(root)\n387|\tif err != nil {\n388|\t\tt.Fatalf(\"directory refused: %v\", err)\n389|\t}\n390|\t_ = dir.Close()\n391|\tregular := filepath.Join(root, \"file\")\n392|\tif err := os.WriteFile(regular, []byte(\"x\"), 0o600); err != nil {\n393|\t\tt.Fatal(err)\n394|\t}\n395|\t_, err = OpenNoFollowDir(regular)\n396|\trequireRefusal(t, err, ErrUnsafePath, \"secprim unsafe path: target directory: file\")\n397|\t_, err = OpenNoFollowDir(filepath.Join(root, \"missing\"))\n398|\tif err == nil || !errors.Is(err, ErrUnsafePath) {\n399|\t\tt.Fatalf(\"missing dir refusal = %v, want ErrUnsafePath\", err)\n400|\t}\n401|\tlink := filepath.Join(root, \"linkdir\")\n402|\tif err := os.Symlink(root, link); err != nil {\n403|\t\tif runtime.GOOS == \"windows\" {\n404|\t\t\tt.Skipf(\"no symlink privilege on %s\", runtime.GOOS)\n405|\t\t}\n406|\t\tt.Fatal(err)\n407|\t}\n408|\t_, err = OpenNoFollowDir(link)\n409|\trequireRefusal(t, err, ErrUnsafePath, \"secprim unsafe path: target symlink: linkdir\")\n410|}\n411|\n412|// TestOpenNoFollowDirRefusesUnreadableDir proves the post-check open arm:\n413|// the directory passes the Lstat fast path but the open itself fails.\n414|// Dropping all mode bits makes the open fail deterministically on unix;\n415|// Windows ACLs do not express a mode-000 directory, so the vector is\n416|// skipped there and the site carries a platform exemption in the audit.\n417|func TestOpenNoFollowDirRefusesUnreadableDir(t *testing.T) {\n418|\tif runtime.GOOS == \"windows\" {\n419|\t\tt.Skip(\"mode-000 directories are not expressible on Windows\")\n420|\t}\n421|\tif privilegedUser() {\n422|\t\tt.Skip(\"root bypasses mode bits, so the open cannot fail\")\n423|\t}\n424|\troot := t.TempDir()\n425|\tlocked := filepath.Join(root, \"locked\")\n426|\tif err := os.Mkdir(locked, 0o700); err != nil {\n427|\t\tt.Fatal(err)\n428|\t}\n429|\tif err := os.Chmod(locked, 0); err != nil {\n430|\t\tt.Fatal(err)\n431|\t}\n432|\tdefer func() { _ = os.Chmod(locked, 0o700) }()\n433|\t_, err := OpenNoFollowDir(locked)\n434|\trequireRefusalPrefix(t, err, ErrUnsafePath, \"secprim unsafe path: open failed: \"+namedTarget(locked))\n435|}\n436|\n437|// errSeamFailure is the forced stat failure the seam returns. It is a\n438|// test-only value and never crosses a production refusal rendering.\n439|var errSeamFailure = errors.New(\"secprim forced stat failure\")\n440|\n441|// namedTarget mirrors the production 64-character member naming bound so\n442|// prefix witnesses pin the truncation contract rather than retyping it.\n443|func namedTarget(path string) string {\n444|\tif len(path) > 64 {\n445|\t\treturn path[:64] + \"...\"\n446|\t}\n447|\treturn path\n448|}\n449|\n450|// TestOpenStatFailureSeam forces the post-open stat-failure arms through\n451|// the production openers: fstat on a live descriptor does not fail on any\n452|// supported platform, so the seam is the only way to prove these arms\n453|// refuse instead of panicking. The seam is restored before returning.\n454|func TestOpenStatFailureSeam(t *testing.T) {\n455|\tprevious := statOpenedFile\n456|\tdefer func() { statOpenedFile = previous }()\n457|\tstatOpenedFile = func(file *os.File) (os.FileInfo, error) {\n458|\t\treturn nil, errSeamFailure\n459|\t}\n460|\troot := t.TempDir()\n461|\tregular := filepath.Join(root, \"file\")\n462|\tif err := os.WriteFile(regular, []byte(\"x\"), 0o600); err != nil {\n463|\t\tt.Fatal(err)\n464|\t}\n465|\t_, err := OpenNoFollowFile(regular)\n466|\trequireRefusalPrefix(t, err, ErrUnsafePath, \"secprim unsafe path: open stat failed: \"+namedTarget(regular))\n467|\t_, err = OpenNoFollowDir(root)\n468|\trequireRefusalPrefix(t, err, ErrUnsafePath, \"secprim unsafe path: open stat failed: \"+namedTarget(root))\n469|\t// The guard commit walk stats the descriptor it opened, so its\n470|\t// stat-failure arm fires here too rather than dereferencing a nil\n471|\t// result.\n472|\tguard, err := NewGuard(root, scalar.PlatformLinux, nil)\n473|\tif err != nil {\n474|\t\tt.Fatal(err)\n475|\t}\n476|\t// The root handle must be opened with a live stat: briefly restore\n477|\t// the production stat around the handle open, then re-arm the seam\n478|\t// for the commit stat below.\n479|\tstatOpenedFile = previous\n480|\tdir, err := OpenNoFollowDir(root)\n481|\tstatOpenedFile = func(file *os.File) (os.FileInfo, error) {\n482|\t\treturn nil, errSeamFailure\n483|\t}\n484|\tif err != nil {\n485|\t\tt.Fatal(err)\n486|\t}\n487|\tdefer func() { _ = dir.Close() }()\n488|\t_, err = guard.Open(dir, \"file\")\n489|\trequireRefusalPrefix(t, err, ErrUnsafePath, \"secprim unsafe path: open stat failed: file\")\n490|\t// A nil stat result without an error is refused as missing, never\n491|\t// dereferenced.\n492|\tstatOpenedFile = func(file *os.File) (os.FileInfo, error) {\n493|\t\treturn nil, nil\n494|\t}\n495|\t_, err = OpenNoFollowFile(regular)\n496|\trequireRefusal(t, err, ErrUnsafePath, \"secprim unsafe path: target stat missing: nil file info\")\n497|\t_, err = OpenNoFollowDir(root)\n498|\trequireRefusal(t, err, ErrUnsafePath, \"secprim unsafe path: target directory: \"+root)\n499|}"}}}
