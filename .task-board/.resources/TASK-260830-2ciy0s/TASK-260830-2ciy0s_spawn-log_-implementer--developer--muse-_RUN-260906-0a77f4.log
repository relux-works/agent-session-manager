{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4b5","stream":{"kind":"session","id":"01a07750-3853-73c0-b383-0773367c2b50"},"sequence":181,"recorded_at":1780531400000357,"record_type":"event","durability":"durable","causation_id":"54033564-b97c-4244-a825-33fd926ad5cb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"54033564-b97c-4244-a825-33fd926ad5cb","run_stream":{"kind":"run","id":"54033564-b97c-4244-a825-33fd926ad5cb"},"task_stream":{"kind":"task","id":"25ef62a9-e107-4531-a312-1661bc0eb278"},"task_id":"25ef62a9-e107-4531-a312-1661bc0eb278","event":{"kind":"output","task_id":"25ef62a9-e107-4531-a312-1661bc0eb278","chunk":"Read text file `internal/secprim/census_test.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"go/ast\"\n6|\t\"go/parser\"\n7|\t\"go/token\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"sort\"\n11|\t\"strconv\"\n12|\t\"strings\"\n13|\t\"testing\"\n14|\n15|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n16|)\n17|\n18|// secretTokens is the instrument vocabulary for the secret-site census.\n19|// Every token must fire on at least one derived site (see\n20|// TestSecretTokensAreProven), or the token is dead ceremony. \"token\" is\n21|// excluded from the local-binding arm below because the JSON decoder\n22|// vocabulary (decoder.Token, token variables) would drown it; every other\n23|// token scans locals too.\n24|//\n25|// Deliberately absent: bare \"auth\" (authority identifiers, authorization\n26|// enums, and authentication subjects are UUID/boolean/enum protocol\n27|// vocabulary, never credential values — TestSecretScanBlindSpot pins\n28|// this), and \"bundle\" (bundle identifiers are digests; opaque bundle\n29|// content is covered by the Section 16.2 class row, not by field\n30|// census). \"transcript\" and \"scrollback\" are present: raw transcripts\n31|// are an excludable class with in-repo gate sites.\n32|var secretTokens = []string{\n33|\t\"secret\", \"credential\", \"passwd\", \"password\", \"token\",\n34|\t\"passphrase\", \"cookie\", \"private_key\", \"privatekey\",\n35|\t\"api_key\", \"apikey\", \"transcript\", \"scrollback\",\n36|}\n37|\n38|// censusPackages bounds the secret-site scan. Every package that handles\n39|// provider output, configuration, errors, records, or storage is in;\n40|// specdoc, traceability, and command trees carry no secret-bearing\n41|// production values.\n42|var censusPackages = []string{\n43|\t\"axerror\", \"canonicaljson\", \"cliresult\", \"config\", \"dirnode\",\n44|\t\"environ\", \"localstore\", \"provider\", \"provhost\", \"scalar\",\n45|\t\"secprim\", \"sessadapter\", \"terminalbackend\",\n46|}\n47|\n48|// deriveSecretSites scans non-test production source in the census\n49|// packages for token-matching sites: declaration names (types,\n50|// functions, package-level values), struct field names, parameter and\n51|// result names, local bindings (all tokens except \"token\"), and every\n52|// string literal. Comments never participate: the walk is over syntax,\n53|// so a documented example cannot roster a site and a secret in a comment\n54|// cannot hide from it either — comments are outside both directions by\n55|// construction, which TestSecretScanIgnoresComments pins.\n56|func deriveSecretSites(t *testing.T) map[string]bool {\n57|\tt.Helper()\n58|\tsites := map[string]bool{}\n59|\tscanned := 0\n60|\tfor _, pkg := range censusPackages {\n61|\t\tdirectory := filepath.Join(\"..\", pkg)\n62|\t\tentries, err := os.ReadDir(directory)\n63|\t\tif err != nil {\n64|\t\t\tt.Fatalf(\"read %s: %v\", directory, err)\n65|\t\t}\n66|\t\tfor _, entry := range entries {\n67|\t\t\tname := entry.Name()\n68|\t\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n69|\t\t\t\tcontinue\n70|\t\t\t}\n71|\t\t\tcontents, err := os.ReadFile(filepath.Join(directory, name))\n72|\t\t\tif err != nil {\n73|\t\t\t\tt.Fatal(err)\n74|\t\t\t}\n75|\t\t\tscanned++\n76|\t\t\tfileset := token.NewFileSet()\n77|\t\t\tsyntax, err := parser.ParseFile(fileset, name, contents, 0)\n78|\t\t\tif err != nil {\n79|\t\t\t\tt.Fatal(err)\n80|\t\t\t}\n81|\t\t\tpackageName := pkg\n82|\t\t\t_ = packageName\n83|\t\t\tast.Inspect(syntax, func(node ast.Node) bool {\n84|\t\t\t\tswitch typed := node.(type) {\n85|\t\t\t\tcase *ast.TypeSpec:\n86|\t\t\t\t\tadmitSite(sites, pkg, \"decl\", typed.Name.Name)\n87|\t\t\t\tcase *ast.FuncDecl:\n88|\t\t\t\t\tadmitSite(sites, pkg, \"decl\", typed.Name.Name)\n89|\t\t\t\tcase *ast.GenDecl:\n90|\t\t\t\t\tif typed.Tok == token.IMPORT {\n91|\t\t\t\t\t\treturn true\n92|\t\t\t\t\t}\n93|\t\t\t\t\tfor _, spec := range typed.Specs {\n94|\t\t\t\t\t\tvalue, ok := spec.(*ast.ValueSpec)\n95|\t\t\t\t\t\tif !ok {\n96|\t\t\t\t\t\t\tcontinue\n97|\t\t\t\t\t\t}\n98|\t\t\t\t\t\tkind := \"decl\"\n99|\t\t\t\t\t\tif inFunctionBody(syntax, spec) {\n100|\t\t\t\t\t\t\tkind = \"local\"\n101|\t\t\t\t\t\t}\n102|\t\t\t\t\t\tfor _, identifier := range value.Names {\n103|\t\t\t\t\t\t\tadmitName(sites, pkg, kind, identifier.Name)\n104|\t\t\t\t\t\t}\n105|\t\t\t\t\t}\n106|\t\t\t\t\treturn true\n107|\t\t\t\tcase *ast.Field:\n108|\t\t\t\t\tfor _, identifier := range typed.Names {\n109|\t\t\t\t\t\tadmitName(sites, pkg, fieldKind(syntax, typed), identifier.Name)\n110|\t\t\t\t\t}\n111|\t\t\t\t\treturn true\n112|\t\t\t\tcase *ast.AssignStmt:\n113|\t\t\t\t\tfor _, bound := range typed.Lhs {\n114|\t\t\t\t\t\tidentifier, ok := bound.(*ast.Ident)\n115|\t\t\t\t\t\tif !ok || identifier.Name == \"_\" {\n116|\t\t\t\t\t\t\tcontinue\n117|\t\t\t\t\t\t}\n118|\t\t\t\t\t\tadmitLocal(sites, pkg, identifier.Name)\n119|\t\t\t\t\t}\n120|\t\t\t\t\treturn true\n121|\t\t\t\tcase *ast.BasicLit:\n122|\t\t\t\t\tif typed.Kind != token.STRING {\n123|\t\t\t\t\t\treturn true\n124|\t\t\t\t\t}\n125|\t\t\t\t\tadmitLiteral(sites, pkg, typed.Value)\n126|\t\t\t\t}\n127|\t\t\t\treturn true\n128|\t\t\t})\n129|\t\t}\n130|\t}\n131|\tif scanned == 0 {\n132|\t\tt.Fatal(\"scanned no production sources; the census is blind\")\n133|\t}\n134|\tif len(sites) == 0 {\n135|\t\tt.Fatal(\"derived no secret sites; the scanner is broken, not the tree\")\n136|\t}\n137|\treturn sites\n138|}\n139|\n140|// inFunctionBody reports whether the spec sits inside a function\n141|// declaration. Package-level values are declarations; function-level\n142|// values are locals and scan under the strong tokens only.\n143|func inFunctionBody(syntax *ast.File, spec ast.Spec) bool {\n144|\tfor _, declaration := range syntax.Decls {\n145|\t\tfunction, ok := declaration.(*ast.FuncDecl)\n146|\t\tif !ok || function.Body == nil {\n147|\t\t\tcontinue\n148|\t\t}\n149|\t\tfound := false\n150|\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n151|\t\t\tif node == spec {\n152|\t\t\t\tfound = true\n153|\t\t\t\treturn false\n154|\t\t\t}\n155|\t\t\treturn true\n156|\t\t})\n157|\t\tif found {\n158|\t\t\treturn true\n159|\t\t}\n160|\t}\n161|\treturn false\n162|}\n163|\n164|// fieldKind distinguishes struct fields (rostered under every token)\n165|// from parameter and result names (same treatment): both are\n166|// declaration-adjacent bindings, unlike locals.\n167|func fieldKind(syntax *ast.File, field *ast.Field) string {\n168|\tfor _, declaration := range syntax.Decls {\n169|\t\tfunction, ok := declaration.(*ast.FuncDecl)\n170|\t\tif !ok {\n171|\t\t\tcontinue\n172|\t\t}\n173|\t\tif function.Type == nil {\n174|\t\t\tcontinue\n175|\t\t}\n176|\t\tfor _, list := range []*ast.FieldList{function.Type.Params, function.Type.Results} {\n177|\t\t\tif list == nil {\n178|\t\t\t\tcontinue\n179|\t\t\t}\n180|\t\t\tfor _, candidate := range list.List {\n181|\t\t\t\tif candidate == field {\n182|\t\t\t\t\treturn \"param\"\n183|\t\t\t\t}\n184|\t\t\t}\n185|\t\t}\n186|\t}\n187|\treturn \"field\"\n188|}\n189|\n190|// admitSite records a declaration-position name under every token it\n191|// contains.\n192|func admitSite(sites map[string]bool, pkg, kind, name string) {\n193|\tadmitName(sites, pkg, kind, name)\n194|}\n195|\n196|// admitName records a declaration-adjacent name under every token it\n197|// contains (case-insensitive substring).\n198|func admitName(sites map[string]bool, pkg, kind, name string) {\n199|\tlowered := strings.ToLower(name)\n200|\tfor _, word := range secretTokens {\n201|\t\tif strings.Contains(lowered, word) {\n202|\t\t\tsites[pkg+\"|\"+kind+\"|\"+name] = true\n203|\t\t}\n204|\t}\n205|}\n206|\n207|// admitLocal records a function-local binding under every strong token:\n208|// every token except \"token\", which the JSON decoder vocabulary owns.\n209|func admitLocal(sites map[string]bool, pkg, name string) {\n210|\tlowered := strings.ToLower(name)\n211|\tfor _, word := range secretTokens {\n212|\t\tif word == \"token\" {\n213|\t\t\tcontinue\n214|\t\t}\n215|\t\tif strings.Contains(lowered, word) {\n216|\t\t\tsites[pkg+\"|local|\"+name] = true\n217|\t\t}\n218|\t}\n219|}\n220|\n221|// maxLiteralRunes bounds the literal arm: a literal longer than this is\n222|// prose documentation, not an identifier, key, or diagnostic atom, and\n223|// rostering it would turn every explanatory paragraph into a site. The\n224|// longest rostered diagnostic is 55 runes; the bound sits at 80.\n225|const maxLiteralRunes = 80\n226|\n227|// admitLiteral records a string literal under every token it contains.\n228|// The literal is unquoted when it parses; an unparseable literal is\n229|// recorded raw rather than dropped. Literals past maxLiteralRunes are\n230|// documentation prose, not sites.\n231|func admitLiteral(sites map[string]bool, pkg, raw string) {\n232|\tvalue, err := strconv.Unquote(raw)\n233|\tif err != nil {\n234|\t\tvalue = raw\n235|\t}\n236|\tif len([]rune(value)) > maxLiteralRunes {\n237|\t\treturn\n238|\t}\n239|\tlowered := strings.ToLower(value)\n240|\tfor _, word := range secretTokens {\n241|\t\tif strings.Contains(lowered, word) {\n242|\t\t\tsites[pkg+\"|lit|\"+value] = true\n243|\t\t}\n244|\t}\n245|}\n246|\n247|// TestSecretScanIgnoresComments pins the comment blindness both ways: a\n248|// token in a comment rosters nothing, so documentation cannot create\n249|// obligations, and (by construction of the syntax walk) nothing outside\n250|// code participates.\n251|func TestSecretScanIgnoresComments(t *testing.T) {\n252|\tt.Parallel()\n253|\tsyntax, err := parser.ParseFile(token.NewFileSet(), \"comment.go\", \"package x\\n// password credential token secret\\nvar clean = 1\\n\", 0)\n254|\tif err != nil {\n255|\t\tt.Fatal(err)\n256|\t}\n257|\tsites := map[string]bool{}\n258|\tast.Inspect(syntax, func(node ast.Node) bool {\n259|\t\tif identifier, ok := node.(*ast.Ident); ok {\n260|\t\t\tadmitName(sites, \"x\", \"decl\", identifier.Name)\n261|\t\t}\n262|\t\tif literal, ok := node.(*ast.BasicLit); ok && literal.Kind == token.STRING {\n263|\t\t\tadmitLiteral(sites, \"x\", literal.Value)\n264|\t\t}\n265|\t\treturn true\n266|\t})\n267|\tif len(sites) != 0 {\n268|\t\tt.Fatalf(\"comment tokens rostered sites %v\", sites)\n269|\t}\n270|}\n271|\n272|// secretSiteRow pairs derived secret sites sharing one disposition with\n273|// the witnesses that prove it. Every derived site appears in exactly one\n274|// row: a derived site with no row fails as unaccounted, and a row naming\n275|// a site production no longer derives fails as orphaned.\n276|type secretSiteRow struct {\n277|\tsites       []string\n278|\tdisposition string\n279|\twitnesses   []string // \"package.TestName\" entries, verified to exist\n280|}\n281|\n282|// secretSiteRows is the reviewed disposition half of the census. The\n283|// denominator is derived (deriveSecretSites); these rows say what each\n284|// site is and which test proves it stays that way.\n285|func secretSiteRows() []secretSiteRow {\n286|\treturn []secretSiteRow{\n287|\t\t{\n288|\t\t\tsites: []string{\n289|\t\t\t\t\"axerror|lit|access_token\", \"axerror|lit|api_key\",\n290|\t\t\t\t\"axerror|lit|cookie\", \"axerror|lit|cookies\",\n291|\t\t\t\t\"axerror|lit|credential\", \"axerror|lit|credentials\",\n292|\t\t\t\t\"axerror|lit|env_secret\", \"axerror|lit|environment secret\",\n293|\t\t\t\t\"axerror|lit|environment_secret\", \"axerror|lit|oauth_token\",\n294|\t\t\t\t\"axerror|lit|passphrase\", \"axerror|lit|password\",\n295|\t\t\t\t\"axerror|lit|private_key\", \"axerror|lit|refresh_token\",\n296|\t\t\t\t\"axerror|lit|secret\", \"axerror|lit|secrets\",\n297|\t\t\t\t\"axerror|lit|session_token\", \"axerror|lit|ssh_private_key\",\n298|\t\t\t\t\"axerror|lit|subscription_token\",\n299|\t\t\t\t\"axerror|lit|raw_transcript\", \"axerror|lit|transcript\",\n300|\t\t\t\t\"axerror|lit|scrollback\", \"axerror|lit|terminal_scrollback\",\n301|\t\t\t\t\"axerror|lit|raw transcript\",\n302|\t\t\t},\n303|\t\t\tdisposition: \"members of the axerror excludedDetailKeys refusal table: a Structured Error detail \" +\n304|\t\t\t\t\"naming one is refused before encoding, so no credential, transcript, environment secret, or \" +\n305|\t\t\t\t\"bundle key reaches the wire as a detail\",\n306|\t\t\twitnesses: []string{\"secprim.TestSecretAxerrorTableRefused\"},\n307|\t\t},\n308|\t\t{\n309|\t\t\t// The derived members of the secprim sensitiveKeyNames\n310|\t\t\t// scrubber table. \"auth_json\", \"authorization\", and \"dotenv\"\n311|\t\t\t// are table members too, but no instrument token fires on\n312|\t\t\t// them (the Authority blind spot pinned by\n313|\t\t\t// TestSecretScanBlindSpot); TestSensitiveKeyListIsReviewed\n314|\t\t\t// pins the whole table of 27 including those three, so the\n315|\t\t\t// table cannot gain or lose a member without reddening\n316|\t\t\t// there.\n317|\t\t\tsites: []string{\n318|\t\t\t\t\"secprim|lit|access_token\", \"secprim|lit|api_key\", \"secprim|lit|apikey\",\n319|\t\t\t\t\"secprim|lit|auth_token\", \"secprim|lit|bearer_token\",\n320|\t\t\t\t\"secprim|lit|client_secret\", \"secprim|lit|cookie\", \"secprim|lit|cookies\",\n321|\t\t\t\t\"secprim|lit|credential\", \"secprim|lit|credentials\",\n322|\t\t\t\t\"secprim|lit|env_secret\", \"secprim|lit|environment_secret\", \"secprim|lit|oauth_token\",\n323|\t\t\t\t\"secprim|lit|passphrase\", \"secprim|lit|passwd\", \"secprim|lit|password\",\n324|\t\t\t\t\"secprim|lit|private_key\", \"secprim|lit|refresh_token\", \"secprim|lit|secret\",\n325|\t\t\t\t\"secprim|lit|secrets\", \"secprim|lit|session_token\", \"secprim|lit|ssh_private_key\",\n326|\t\t\t\t\"secprim|lit|subscription_token\", \"secprim|lit|token\",\n327|\t\t\t},\n328|\t\t\tdisposition: \"members of the secprim sensitiveKeyNames scrubber table: a free-text key=value pair \" +\n329|\t\t\t\t\"naming one has its value masked by Redact before persistence or display\",\n330|\t\t\twitnesses: []string{\"secprim.TestSensitiveKeyListIsReviewed\", \"secprim.TestRedactSensitivePairs\"},\n331|\t\t},\n332|\t\t{\n333|\t\t\tsites: []string{\n334|\t\t\t\t\"secprim|decl|minSecretRunes\", \"secprim|decl|privateKeyBeginPrefix\",\n335|\t\t\t\t\"secprim|decl|privateKeyBeginSuffix\", \"secprim|decl|privateKeyEndPrefix\",\n336|\t\t\t\t\"secprim|decl|redactPrivateKeyBlocks\", \"secprim|decl|redactedPrivateKey\",\n337|\t\t\t\t\"secprim|param|secrets\",\n338|\t\t\t},\n339|\t\t\tdisposition: \"the scrubber machinery itself: private-key block shapes, the corpus bound, and the \" +\n340|\t\t\t\t\"caller-known secret values Redact removes rather than stores\",\n341|\t\t\twitnesses: []string{\"secprim.TestRedactPrivateKeyBlocks\", \"secprim.TestRedactCorpusValues\"},\n342|\t\t},\n343|\t\t{\n344|\t\t\tsites: []string{\n345|\t\t\t\t\"terminalbackend|lit|attach_credential\", \"terminalbackend|lit|relay_credential\",\n346|\t\t\t\t\"terminalbackend|lit|provider_credential\", \"terminalbackend|lit|evidence_secret\",\n347|\t\t\t\t\"terminalbackend|lit|credential_detail\", \"terminalbackend|lit|token\",\n348|\t\t\t\t\"terminalbackend|lit|scrollback\",\n349|\t\t\t},\n350|\t\t\tdisposition: \"members of the terminal replication-exclusion vocabulary: classified sensitive-owner-only \" +\n351|\t\t\t\t\"or forbidden, never transferred as live authority\",\n352|\t\t\twitnesses: []string{\"terminalbackend.TestReplicationClassificationIsClosed\"},\n353|\t\t},\n354|\t\t{\n355|\t\t\tsites: []string{\n356|\t\t\t\t\"terminalbackend|decl|credentialRealmCapability\",\n357|\t\t\t\t\"terminalbackend|lit|credential_capable_execution_realm\",\n358|\t\t\t\t\"terminalbackend|lit|credential_sentinel\",\n359|\t\t\t\t\"terminalbackend|lit|scrollback_retention\",\n360|\t\t\t},\n361|\t\t\tdisposition: \"capability vocabulary words: they name the credential-capable realm, its sentinel \" +\n362|\t\t\t\t\"evidence member, and the scrollback-retention policy, whose values are booleans, enums, and \" +\n363|\t\t\t\t\"retention facts, never secrets or transcript content\",\n364|\t\t\twitnesses: []string{\"terminalbackend.TestParseManifestAdmitsClosedFixture\"},\n365|\t\t},\n366|\t\t{\n367|\t\t\tsites: []string{\"sessadapter|lit|credential\"},\n368|\t\t\tdisposition: \"member of the closed capture-class vocabulary: naming the class a capture plan \" +\n369|\t\t\t\t\"excludes, not a credential value\",\n370|\t\t\twitnesses: []string{\"sessadapter.TestDecodeCapturePlanItemRules\"},\n371|\t\t},\n372|\t\t{\n373|\t\t\tsites: []string{\n374|\t\t\t\t\"provhost|lit|rollback_token\",\n375|\t\t\t\t\"provhost|lit|status rollback_token is not a string\",\n376|\t\t\t\t\"provhost|lit|status rollback_token is shorter than 256 bits\",\n377|\t\t\t\t\"provhost|lit|unknown status carries plan, token, or discovery\",\n378|\t\t\t\t\"provhost|lit|prepared status misses plan, token, or discovery\",\n379|\t\t\t\t\"provhost|lit|terminal status misses plan or discovery or keeps a token\",\n380|\t\t\t\t\"provhost|local|token\",\n381|\t\t\t},\n382|\t\t\tdisposition: \"the closed status member plus its charset/length gate: the decoded rollback token is \" +\n383|\t\t\t\t\"checked for 256-bit base64url shape only, and every refusal names the member, never the value\",\n384|\t\t\twitnesses: []string{\"provhost.TestDecodeStatusOutcomeRefusesMalformedBodies\"},\n385|\t\t},\n386|\t\t{\n387|\t\t\tsites: []string{\n388|\t\t\t\t\"scalar|lit|must not contain userinfo credentials\",\n389|\t\t\t\t\"scalar|lit|must not contain a password or token\",\n390|\t\t\t\t\"scalar|local|password\",\n391|\t\t\t},\n392|\t\t\tdisposition: \"the sanitized-Git-URL refusal: userinfo credentials and passwords are refused at parse, \" +\n393|\t\t\t\t\"and the decoded local is compared and dropped, never rendered\",\n394|\t\t\twitnesses: []string{\"scalar.TestSanitizedGitURLRefusesCredentialsAndLocalSchemes\"},\n395|\t\t},\n396|\t\t{\n397|\t\t\tsites: []string{\n398|\t\t\t\t\"canonicaljson|lit|contains_secrets\",\n399|\t\t\t\t\"canonicaljson|lit|Session Record Launch Plan contains_secrets must be false\",\n400|\t\t\t\t\"canonicaljson|local|containsSecrets\",\n401|\t\t\t},\n402|\t\t\tdisposition: \"the launch-plan secrecy flag: a plan declaring contains_secrets is refused, so a \" +\n403|\t\t\t\t\"secret-bearing plan cannot enter an immutable record\",\n404|\t\t\twitnesses: []string{\"canonicaljson.TestSessionRecordV1NestedTaggedShapesReachBothIdentityEntries\"},\n405|\t\t},\n406|\t\t{\n407|\t\t\tsites: []string{\n408|\t\t\t\t\"canonicaljson|lit|decode JSON token: %v\",\n409|\t\t\t\t\"canonicaljson|lit|unexpected trailing JSON token %v\",\n410|\t\t\t},\n411|\t\t\tdisposition: \"constant decoder diagnostics naming JSON tokens (syntax elements), not secret values; \" +\n412|\t\t\t\t\"they carry the offending input shape, never a credential\",\n413|\t\t\twitnesses: []string{\"canonicaljson.TestCalculateObjectIdentityRefusesMalformedJSONInput\"},\n414|\t\t},\n415|\t\t{\n416|\t\t\tsites: []string{\n417|\t\t\t\t\"dirnode|lit|bootstrap process token is empty\",\n418|\t\t\t\t\"dirnode|param|token\",\n419|\t\t\t},\n420|\t\t\tdisposition: \"the opaque bootstrap idempotency token: compared in-memory only, and refusals name \" +\n421|\t\t\t\t\"the member, never the value\",\n422|\t\t\twitnesses: []string{\"dirnode.TestProcessGuardRefusesReuse\"},\n423|\t\t},\n424|\t\t{\n425|\t\t\tsites: []string{\n426|\t\t\t\t\"config|field|TranscriptGrepEnabled\",\n427|\t\t\t\t`config|lit|toml:\"transcript_grep_enabled\"`,\n428|\t\t\t},\n429|\t\t\tdisposition: \"the explicit transcript-grep opt-in switch: an admitted boolean member, defaulting \" +\n430|\t\t\t\t\"to false, gating source-local bounded grep per Section 16.7 — not a transcript value\",\n431|\t\t\twitnesses: []string{\"config.TestLoadAcceptsExactV2DirectoryAndV3TerminalShapes\"},\n432|\t\t},\n433|\t}\n434|}\n435|\n436|// TestSecretSiteRosterIsComplete requires every derived secret site to\n437|// carry exactly one row and every row site to resolve to a derived site.\n438|// Removing a secret-bearing declaration, or adding one, reddens here in\n439|// exactly one direction.\n440|func TestSecretSiteRosterIsComplete(t *testing.T) {\n441|\tderived := deriveSecretSites(t)\n442|\trows := secretSiteRows()\n443|\tseen := map[string]bool{}\n444|\tfor _, row := range rows {\n445|\t\tfor _, site := range row.sites {\n446|\t\t\tif !derived[site] {\n447|\t\t\t\tt.Fatalf(\"orphaned census row site %q: production derives no such site\", site)\n448|\t\t\t}\n449|\t\t\tif seen[site] {\n450|\t\t\t\tt.Fatalf(\"duplicate census row site %q: one disposition per site\", site)\n451|\t\t\t}\n452|\t\t\tseen[site] = true\n453|\t\t}\n454|\t}\n455|\tvar missing []string\n456|\tfor site := range derived {\n457|\t\tif !seen[site] {\n458|\t\t\tmissing = append(missing, site)\n459|\t\t}\n460|\t}\n461|\tsort.Strings(missing)\n462|\tif len(missing) > 0 {\n463|\t\tt.Fatalf(\"derived secret sites with no disposition row:\\n  %s\", strings.Join(missing, \"\\n  \"))\n464|\t}\n465|}\n466|\n467|// TestSecretSiteWitnessesExist verifies every cited witness names a real\n468|// test function in its package, parsed from that package's test sources:\n469|// a renamed or deleted witness reddens here instead of citing a ghost.\n470|func TestSecretSiteWitnessesExist(t *testing.T) {\n471|\tt.Parallel()\n472|\tneeded := map[string]map[string]bool{}\n473|\tfor _, row := range secretSiteRows() {\n474|\t\tfor _, witness := range row.witnesses {\n475|\t\t\tparts := strings.Split(witness, \".\")\n476|\t\t\tif len(parts) != 2 {\n477|\t\t\t\tt.Fatalf(\"witness %q is not package.Test shaped\", witness)\n478|\t\t\t}\n479|\t\t\tif needed[parts[0]] == nil {\n480|\t\t\t\tneeded[parts[0]] = map[string]bool{}\n481|\t\t\t}\n482|\t\t\tneeded[parts[0]][parts[1]] = true\n483|\t\t}\n484|\t}\n485|\tfor pkg, names := range needed {\n486|\t\tfound := testFuncNames(t, pkg)\n487|\t\tfor name := range names {\n488|\t\t\tif !found[name] {\n489|\t\t\t\tt.Errorf(\"witness %s.%s does not exist; the census cites a ghost\", pkg, name)\n490|\t\t\t}\n491|\t\t}\n492|\t}\n493|}\n494|\n495|// testFuncNames parses a package's test files for test function names.\n496|// The walk is over declarations, so a name mentioned in a comment or a\n497|// string cannot satisfy it.\n498|func testFuncNames(t *testing.T, pkg string) map[string]bool {\n499|\tt.Helper()\n500|\tdirectory := filepath.Join(\"..\", pkg)\n(more lines below)"}}}
