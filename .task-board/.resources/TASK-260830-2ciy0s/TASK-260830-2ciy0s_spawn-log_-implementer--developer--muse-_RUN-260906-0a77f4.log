{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c50f","stream":{"kind":"session","id":"01a07750-3853-73c0-b383-0773367c2b50"},"sequence":226,"recorded_at":1780531400000447,"record_type":"event","durability":"durable","causation_id":"54033564-b97c-4244-a825-33fd926ad5cb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"54033564-b97c-4244-a825-33fd926ad5cb","run_stream":{"kind":"run","id":"54033564-b97c-4244-a825-33fd926ad5cb"},"task_stream":{"kind":"task","id":"4c28783a-05ea-4217-811f-35043cdcd789"},"task_id":"4c28783a-05ea-4217-811f-35043cdcd789","event":{"kind":"output","task_id":"4c28783a-05ea-4217-811f-35043cdcd789","chunk":"Read text file `internal/secprim/open_nofollow_unix.go`.\n1|//go:build !windows\n2|\n3|package secprim\n4|\n5|import (\n6|\t\"os\"\n7|\n8|\t\"golang.org/x/sys/unix\"\n9|)\n10|\n11|// openNoFollow opens path read-only without following a trailing symlink:\n12|// O_NOFOLLOW makes the open itself fail on a symlink target instead of\n13|// traversing it. O_CLOEXEC keeps the descriptor out of any spawned child.\n14|// O_NONBLOCK keeps a FIFO from stalling the opener: a read-only open of\n15|// a FIFO with no writer blocks in the kernel, and the post-open shape\n16|// check that refuses it runs only after the open returns, so without\n17|// this flag the refusal is unreachable and the caller hangs instead.\n18|// The caller clears the flag on admitted regular files.\n19|func openNoFollow(path string) (*os.File, error) {\n20|\treturn os.OpenFile(path, os.O_RDONLY|unix.O_NOFOLLOW|unix.O_CLOEXEC|unix.O_NONBLOCK, 0)\n21|}\n22|\n23|// openNoFollowDir opens a directory read-only without following a trailing\n24|// symlink, returning a handle that pins the directory for validation walks\n25|// (Fstat, ReadDirnames) instead of re-resolving its name.\n26|func openNoFollowDir(path string) (*os.File, error) {\n27|\treturn os.OpenFile(path, os.O_RDONLY|unix.O_NOFOLLOW|unix.O_CLOEXEC|unix.O_DIRECTORY, 0)\n28|}"}}}
