.go\": []byte(\"package secprim\\n\\nfunc plantF() error {\\n\\tfailure := new(Error)\\n\\tfailure.Kind = ErrUnsafeArgv\\n\\treturn failure\\n}\\n\"),\n598|\t\t// G: an alias of an alias, then a call through it.\n599|\t\t\"plant_g.go\": []byte(\"package secprim\\n\\nvar failArgvAlias = failArgv\\n\\nvar failArgvAlias2 = failArgvAlias\\n\\nfunc plantG() error {\\n\\treturn failArgvAlias2(\\\"plant g\\\", \\\"nowhere\\\")\\n}\\n\"),\n600|\t}\n601|\t// Each plant runs through the derivation alone (plus nothing):\n602|\t// plants must not see each other's declarations, the way a real\n603|\t// bypass would sit beside honest production code that must stay\n604|\t// clean.\n605|\tderive := func(t *testing.T, name string) refusalDerivation {\n606|\t\tt.Helper()\n607|\t\tderivation, err := deriveRefusals(map[string][]byte{name: plants[name]})\n608|\t\tif err != nil {\n609|\t\t\tt.Fatalf(\"derive %s: %v\", name, err)\n610|\t\t}\n611|\t\treturn derivation\n612|\t}\n613|\tcontains := func(t *testing.T, name string, strays []string, word string) {\n614|\t\tt.Helper()\n615|\t\tfor _, stray := range strays {\n616|\t\t\tif strings.Contains(stray, word) {\n617|\t\t\t\treturn\n618|\t\t\t}\n619|\t\t}\n620|\t\tt.Fatalf(\"%s: no stray containing %q in %v\", name, word, strays)\n621|\t}\n622|\tt.Run(\"control is an unfired site\", func(t *testing.T) {\n623|\t\tt.Parallel()\n624|\t\tderivation := derive(t, \"plant_control.go\")\n625|\t\tif len(derivation.strays) != 0 {\n626|\t\t\tt.Fatalf(\"control strays %v; the honest shape must stay clean\", derivation.strays)\n627|\t\t}\n628|\t\tif len(derivation.sites) != 1 {\n629|\t\t\tt.Fatalf(\"control sites = %v, want the one bare call\", derivation.sites)\n630|\t\t}\n631|\t})\n632|\tt.Run(\"var alias\", func(t *testing.T) {\n633|\t\tt.Parallel()\n634|\t\tderivation := derive(t, \"plant_a.go\")\n635|\t\tcontains(t, \"plant A\", derivation.strays, \"alias failArgvAlias\")\n636|\t})\n637|\tt.Run(\"direct literal\", func(t *testing.T) {\n638|\t\tt.