{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c81d","stream":{"kind":"session","id":"01a07750-3853-73c0-b383-0773367c2b50"},"sequence":617,"recorded_at":1780531400001229,"record_type":"event","durability":"durable","causation_id":"54033564-b97c-4244-a825-33fd926ad5cb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"54033564-b97c-4244-a825-33fd926ad5cb","run_stream":{"kind":"run","id":"54033564-b97c-4244-a825-33fd926ad5cb"},"task_stream":{"kind":"task","id":"868f80c8-6c71-44e3-b979-bcdc681fd0a9"},"task_id":"868f80c8-6c71-44e3-b979-bcdc681fd0a9","event":{"kind":"output","task_id":"868f80c8-6c71-44e3-b979-bcdc681fd0a9","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.task-board/.resources/TASK-260830-2ciy0s/TASK-260830-2ciy0s_mutant-battery.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Round-2 narrowing/deletion mutant battery for TASK-260830-2ciy0s.\n3|\n4|Usage: python3 /tmp/mutant_battery.py N1 N2 ...   (runs those mutants)\n5|Each mutant: backup file, assert exact one-occurrence replacement,\n6|run the named test, record KILLED (exit != 0 with the named test failing)\n7|or SURVIVED (exit 0), restore the file byte-identical.\n8|\"\"\"\n9|import subprocess\n10|import sys\n11|\n12|MUTANTS = [\n13|    # ---------------- NARROWING: boundary moves admitting exactly one member\n14|    dict(id=\"N1\", file=\"internal/secprim/path.go\",\n15|         old='return strings.Contains(unwrapPercentEncoding(member), \"%2e\")',\n16|         new='return strings.Contains(strings.ToLower(member), \"%2e\")',\n17|         pkg=\"./internal/secprim/\", run=\"TestCheckMemberPathRefuses\",\n18|         kill=\"double_encoded_dot\",\n19|         narrows=\"admits exactly doubly-encoded dots (%252e)\"),\n20|    dict(id=\"N2\", file=\"internal/secprim/path.go\",\n21|         old='return strings.Contains(unwrapPercentEncoding(member), \"%c0%af\")',\n22|         new='return strings.Contains(string