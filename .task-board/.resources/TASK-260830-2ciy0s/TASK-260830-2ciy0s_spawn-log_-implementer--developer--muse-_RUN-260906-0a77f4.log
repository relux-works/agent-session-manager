{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c42f","stream":{"kind":"session","id":"01a07750-3853-73c0-b383-0773367c2b50"},"sequence":114,"recorded_at":1780531400000223,"record_type":"event","durability":"durable","causation_id":"54033564-b97c-4244-a825-33fd926ad5cb","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"54033564-b97c-4244-a825-33fd926ad5cb","run_stream":{"kind":"run","id":"54033564-b97c-4244-a825-33fd926ad5cb"},"task_stream":{"kind":"task","id":"ac7673c5-fd65-4f1f-b87f-1b92cb404b0d"},"task_id":"ac7673c5-fd65-4f1f-b87f-1b92cb404b0d","event":{"kind":"output","task_id":"ac7673c5-fd65-4f1f-b87f-1b92cb404b0d","chunk":"Read text file `internal/secprim/nofollow.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"os\"\n6|\t\"strings\"\n7|)\n8|\n9|// errIsSymlink reports the Windows Lstat gate refusal. It stays internal:\n10|// callers see the failPath refusal, and errors.Is against ErrUnsafePath\n11|// is the supported match.\n12|var errIsSymlink = errors.New(\"secprim symlink refused before open\")\n13|\n14|// errCommitSymlink is the internal signal from the platform commit walk\n15|// (openCommitRelative) that a symlink or reparse point stands on the\n16|// member path at commit time. It stays internal: Open maps it to the\n17|// failPath \"member symlink escape\" refusal, and errors.Is against\n18|// ErrUnsafePath is the supported match. The walk returns no failPath\n19|// sites of its own so the refusal inventory stays in shared code,\n20|// which the suite executes on every platform it runs on.\n21|var errCommitSymlink = errors.New(\"secprim symlink on the commit path\")\n22|\n23|// OpenNoFollowFile opens an existing regular file read-only, refusing a\n24|// trailing symlink instead of traversing it (Section 16.3\n25|// \"symlink/reparse escape during both validation and commit\"). The\n26|// descriptor refers to the opened inode, and the post-open Fstat below\n27|// reads that descriptor rather than the path, so a swap between open and\n28|// stat cannot retarget the check: only the final-component open itself\n29|// races, and on unix O_NOFOLLOW closes even that.\n30|//\n31|// The file must be regular: directories, devices, pipes, and sockets are\n32|// refused after opening (and the descriptor closed) rather than handed\n33|// back. Parent directories are the caller's responsibility: open the\n34|// staging root with OpenNoFollowDir and resolve members through a Guard.\n35|func OpenNoFollowFile(path string) (*os.File, error) {\n36|\tfile, err := openNoFollow(path)\n37|\tif err != nil {\n38|\t\treturn nil, failPath(\"open failed\", memberErrorTarget(path)).WithCause(err)\n39|\t}\n40|\tinfo, err := statOpenedFile(file)\n41|\tif err != nil {\n42|\t\t_ = file.Close()\n43|\t\treturn nil, failPath(\"open stat failed\", memberErrorTarget(path)).WithCause(err)\n44|\t}\n45|\tif err := CheckRegularTarget(info); err != nil {\n46|\t\t_ = file.Close()\n47|\t\treturn nil, err\n48|\t}\n49|\t// The unix open sets O_NONBLOCK so a FIFO can never stall the opener\n50|\t// (its refusal above runs only after the open returns). A regular\n51|\t// file ignores O_NONBLOCK on reads, and clearing it here keeps a\n52|\t// borrowed descriptor from leaking the flag to its reader. fcntl on\n53|\t// a just-opened valid descriptor cannot fail; the best-effort clear\n54|\t// carries no refusal site for that reason.\n55|\t_ = clearNonblock(file)\n56|\treturn file, nil\n57|}\n58|\n59|// Open commits one guard member to an open regular file through the\n60|// staging-root directory handle, refusing symlink and reparse escape at\n61|// commit time (Section 16.3 \"symlink/reparse escape during both\n62|// validation and commit\").\n63|//\n64|// Validation and commit are two halves of one entry point, not two calls\n65|// the caller composes: the member grammar and the managed set refuse\n66|// lexically first, then the platform walk (openCommitRelative) opens\n67|// every path component relative to a directory descriptor — never by\n68|// re-resolving a path string — so a symlinked intermediate directory\n69|// cannot redirect the commit outside the root the way composing\n70|// Guard.Resolve with OpenNoFollowFile does (O_NOFOLLOW constrains only\n71|// the final component; every component before it is still followed by\n72|// the kernel when a path string is opened).\n73|//\n74|// The caller opens the staging root with OpenNoFollowDir and passes the\n75|// handle: on unix the walk never leaves that handle (openat from the\n76|// root descriptor down, O_NOFOLLOW per component, TOCTOU-closed); on\n77|// Windows the walk is a best-effort Lstat component check with the\n78|// stated check-then-open bound. The returned file is cleared of\n79|// O_NONBLOCK like OpenNoFollowFile. The caller owns closing both the\n80|// root handle and the returned file.\n81|func (guard Guard) Open(root *os.File, member string) (*os.File, error) {\n82|\tif err := CheckMemberPath(guard.platform, member); err != nil {\n83|\t\treturn nil, err\n84|\t}\n85|\tif guard.checkManaged && !guard.managed[member] {\n86|\t\treturn nil, failPath(\"member unmanaged\", memberErrorTarget(member))\n87|\t}\n88|\tif root == nil {\n89|\t\treturn nil, failPath(\"guard root handle\", memberErrorTarget(member))\n90|\t}\n91|\tif info, err := root.Stat(); err != nil || info == nil || !info.IsDir() {\n92|\t\treturn nil, failPath(\"guard root handle\", memberErrorTarget(member))\n93|\t}\n94|\tsegments := strings.Split(member, \"/\")\n95|\tfile, err := openCommitRelative(root, guard.root, member, segments)\n96|\tif err != nil {\n97|\t\tif errors.Is(err, errCommitSymlink) {\n98|\t\t\treturn nil, failPath(\"member symlink escape\", memberErrorTarget(member))\n99|\t\t}\n100|\t\treturn nil, failPath(\"open failed\", memberErrorTarget(member)).WithCause(err)\n101|\t}\n102|\tinfo, err := statOpenedFile(file)\n103|\tif err != nil {\n104|\t\t_ = file.Close()\n105|\t\treturn nil, failPath(\"open stat failed\", memberErrorTarget(member)).WithCause(err)\n106|\t}\n107|\tif err := CheckRegularTarget(info); err != nil {\n108|\t\t_ = file.Close()\n109|\t\treturn nil, err\n110|\t}\n111|\t_ = clearNonblock(file)\n112|\treturn file, nil\n113|}\n114|\n115|// statOpenedFile stats an already-opened descriptor. It is a variable\n116|// only so seam-failure tests can force the stat-failure path through the\n117|// production openers below: fstat on a live descriptor does not fail on\n118|// any supported platform, and without the seam the error branch is\n119|// untestable. Production code never reassigns it.\n120|var statOpenedFile = func(file *os.File) (os.FileInfo, error) {\n121|\treturn file.Stat()\n122|}\n123|\n124|// OpenNoFollowDir opens an existing directory read-only without following\n125|// a trailing symlink, returning a handle for validation walks. The handle\n126|// pins the opened directory: Fstat and ReadDirnames on it observe the\n127|// directory that was opened even if its name is later retargeted.\n128|//\n129|// The Lstat fast path refuses non-directories with the same rules on\n130|// every platform; the post-open Stat below stays authoritative against a\n131|// swap between the check and the open.\n132|func OpenNoFollowDir(path string) (*os.File, error) {\n133|\tif info, err := os.Lstat(path); err != nil {\n134|\t\treturn nil, failPath(\"open failed\", memberErrorTarget(path)).WithCause(err)\n135|\t} else if info.Mode()&os.ModeSymlink != 0 {\n136|\t\treturn nil, failPath(\"target symlink\", info.Name())\n137|\t} else if !info.IsDir() {\n138|\t\treturn nil, failPath(\"target directory\", info.Name())\n139|\t}\n140|\tdir, err := openNoFollowDir(path)\n141|\tif err != nil {\n142|\t\treturn nil, failPath(\"open failed\", memberErrorTarget(path)).WithCause(err)\n143|\t}\n144|\tinfo, err := statOpenedFile(dir)\n145|\tif err != nil {\n146|\t\t_ = dir.Close()\n147|\t\treturn nil, failPath(\"open stat failed\", memberErrorTarget(path)).WithCause(err)\n148|\t}\n149|\tif info == nil || !info.IsDir() || info.Mode()&os.ModeSymlink != 0 {\n150|\t\t_ = dir.Close()\n151|\t\tname := path\n152|\t\tif info != nil {\n153|\t\t\tname = info.Name()\n154|\t\t}\n155|\t\treturn nil, failPath(\"target directory\", name)\n156|\t}\n157|\treturn dir, nil\n158|}"}}}
