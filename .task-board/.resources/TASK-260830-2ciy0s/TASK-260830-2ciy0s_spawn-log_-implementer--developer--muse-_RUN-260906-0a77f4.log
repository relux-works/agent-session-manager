{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c485","stream":{"kind":"session","id":"01a07750-3853-73c0-b383-0773367c2b50"},"sequence":157,"recorded_at":1780531400000309,"record_type":"event","durability":"durable","causation_id":"54033564-b97c-4244-a825-33fd926ad5cb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"54033564-b97c-4244-a825-33fd926ad5cb","run_stream":{"kind":"run","id":"54033564-b97c-4244-a825-33fd926ad5cb"},"call_id":"call_01a077507b2c72b3b710483b6592a5da","text":"Read text file `internal/secprim/path.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"os\"\n5|\t\"path\"\n6|\t\"strings\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|// CheckMemberPath admits one staging or archive member name on the given\n12|// platform under Section 16.3. The member is a slash-separated relative\n13|// path: the shared relative grammar (absolute, drive-qualified, backslash,\n14|// NUL, empty, dot, parent segments, and repeatedly encoded separators) is\n15|// decided by scalar.ParseRelativePath, which owns it. This gate adds only\n16|// the platform rules scalar does not own because they apply to member\n17|// names rather than to absolute paths:\n18|//\n19|//   - encoded dots and overlong separators (%2e, %c0%af, any case and %25\n20|//     nesting): an extension past scalar, because extraction stacks\n21|//     commonly percent-decode after validation and an admitted \"%2e%2e\"\n22|//     becomes a parent segment below this gate;\n23|//   - Windows alternate-stream and NTFS syntax: any colon outside a refused\n24|//     drive prefix (Section 16.3 \"alternate streams\");\n25|//   - Windows trailing dots and spaces per segment, which the filesystem\n26|//     strips and which therefore alias distinct members;\n27|//   - Windows reserved device names, decided by the same table scalar uses\n28|//     for absolute paths.\n29|func CheckMemberPath(platform scalar.Platform, member string) error {\n30|\tif _, err := scalar.ParseRelativePath(member); err != nil {\n31|\t\treturn failPath(\"member grammar\", memberErrorTarget(member))\n32|\t}\n33|\tif containsEncodedDot(member) {\n34|\t\treturn failPath(\"member encoded dot\", memberErrorTarget(member))\n35|\t}\n36|\tif containsOverlongSeparator(member) {\n37|\t\treturn failPath(\"member overlong separator\", memberErrorTarget(member))\n38|\t}\n39|\tif platform == scalar.PlatformWindows {\n40|\t\tfor _, segment := range strings.Split(member, \"/\") {\n41|\t\t\tif strings.Contains(segment, \":\") {\n42|\t\t\t\treturn failPath(\"member alternate stream\", memberErrorTarget(member))\n43|\t\t\t}\n44|\t\t\tif strings.HasSuffix(segment, \".\") || strings.HasSuffix(segment, \" \") {\n45|\t\t\t\treturn failPath(\"member trailing dot or space\", memberErrorTarget(member))\n46|\t\t\t}\n47|\t\t\tif scalar.IsReservedWindowsDeviceName(segment) {\n48|\t\t\t\treturn failPath(\"member reserved device name\", memberErrorTarget(member))\n49|\t\t\t}\n50|\t\t}\n51|\t}\n52|\treturn nil\n53|}\n54|\n55|// unwrapPercentEncoding folds %25 layers the way scalar's separator check\n56|// does, so a twice-encoded dot or separator cannot hide behind its outer\n57|// encoding.\n58|func unwrapPercentEncoding(value string) string {\n59|\tcandidate := strings.ToLower(value)\n60|\tfor {\n61|\t\tnext := strings.ReplaceAll(candidate, \"%25\", \"%\")\n62|\t\tif next == candidate {\n63|\t\t\treturn candidate\n64|\t\t}\n65|\t\tcandidate = next\n66|\t}\n67|}\n68|\n69|// containsEncodedDot reports a percent-encoded dot (%2e, any case, any\n70|// %25 nesting). scalar owns the encoded-separator rule (%2f/%5c) but not\n71|// encoded dots; this gate extends it because extraction stacks commonly\n72|// percent-decode after validation, turning an admitted \"%2e%2e\" into a\n73|// parent segment below this gate. A literal percent followed by other\n74|// hex (for example \"100%.txt\" or \"a%20b\") keeps passing through.\n75|func containsEncodedDot(member string) bool {\n76|\treturn strings.Contains(unwrapPercentEncoding(member), \"%2e\")\n77|}\n78|\n79|// containsOverlongSeparator reports the overlong UTF-8 encoding of slash\n80|// (%c0%af, any case, any %25 nesting), which some decoders accept as a\n81|// separator. Same ownership rationale as containsEncodedDot.\n82|func containsOverlongSeparator(member string) bool {\n83|\treturn strings.Contains(unwrapPercentEncoding(member), \"%c0%af\")\n84|}\n85|\n86|// memberErrorTarget names the refused member without echoing unbounded\n87|// foreign bytes: the first 64 characters identify the site for an\n88|// operator while a hostile multi-megabyte member cannot flood a log.\n89|func memberErrorTarget(member string) string {\n90|\tif len(member) > 64 {\n91|\t\treturn member[:64] + \"...\"\n92|\t}\n93|\treturn member\n94|}\n95|\n96|// Guard is a containment boundary for staging and extraction: a validated\n97|// absolute root on one platform plus the optional exact set of managed\n98|// member names that may be replaced. A nil managed set disables the\n99|// managed check; a non-nil set (even an empty one) restricts Resolve to\n100|// its members, so denying by default is representable and distinct from\n101|// not checking. The zero value is unusable; build one with NewGuard.\n102|type Guard struct {\n103|\troot         string\n104|\tplatform     scalar.Platform\n105|\tmanaged      map[string]bool\n106|\tcheckManaged bool\n107|}\n108|\n109|// NewGuard validates the staging root and records the managed set.\n110|// The root must be an absolute path on the platform: a relative root\n111|// fails here instead of resolving against the process working directory\n112|// at commit time.\n113|func NewGuard(root string, platform scalar.Platform, managed []string) (Guard, error) {\n114|\tif _, err := scalar.ParseAbsolutePath(platform, root); err != nil {\n115|\t\treturn Guard{}, failPath(\"guard root\", memberErrorTarget(root))\n116|\t}\n117|\tguard := Guard{root: root, platform: platform}\n118|\tif managed != nil {\n119|\t\tguard.checkManaged = true\n120|\t\tguard.managed = make(map[string]bool, len(managed))\n121|\t\tfor _, member := range managed {\n122|\t\t\tguard.managed[member] = true\n123|\t\t}\n124|\t}\n125|\treturn guard, nil\n126|}\n127|\n128|// Resolve maps one member name to its commit path inside the guard root.\n129|// It enforces the two conjuncts of containment independently: the member\n130|// grammar (CheckMemberPath, which refuses traversal lexically) and the\n131|// joined-prefix check below (which refuses anything whose cleaned join\n132|// escapes the root even if the grammar ever admits a new shape). Either\n133|// conjunct refuses alone.\n134|//\n135|// The prefix check is currently unreachable through this entry: the\n136|// member grammar refuses every parent segment, so no admitted member can\n137|// produce a join outside the root. It stays as defense in depth against a\n138|// future grammar relaxation, and TestGuardPrefixCheckIsLoadBearing pins\n139|// the property it guards (every resolved join stays within the root) so\n140|// weakening the grammar reddens there first.\n141|func (guard Guard) Resolve(member string) (string, error) {\n142|\tif err := CheckMemberPath(guard.platform, member); err != nil {\n143|\t\treturn \"\", err\n144|\t}\n145|\tif guard.checkManaged && !guard.managed[member] {\n146|\t\treturn \"\", failPath(\"member unmanaged\", memberErrorTarget(member))\n147|\t}\n148|\tjoined := joinSlash(guard.slashRoot(), member)\n149|\tif !withinRoot(guard.slashRoot(), joined) {\n150|\t\treturn \"\", failPath(\"member containment\", memberErrorTarget(member))\n151|\t}\n152|\tif guard.platform == scalar.PlatformWindows {\n153|\t\treturn strings.ReplaceAll(joined, \"/\", `\\`), nil\n154|\t}\n155|\treturn joined, nil\n156|}\n157|\n158|// slashRoot renders the validated root with forward slashes so the join\n159|// and prefix check are platform-parameterized rather than host-native:\n160|// windows cases are decided lexically on any host.\n161|func (guard Guard) slashRoot() string {\n162|\tif guard.platform == scalar.PlatformWindows {\n163|\t\treturn strings.ReplaceAll(guard.root, `\\`, \"/\")\n164|\t}\n165|\treturn guard.root\n166|}\n167|\n168|// joinSlash joins a slash-form root with a grammar-checked member and\n169|// cleans the result, preserving a UNC leading double slash that path\n170|// Clean would otherwise collapse.\n171|func joinSlash(slashRoot, member string) string {\n172|\tfull := strings.TrimSuffix(slashRoot, \"/\") + \"/\" + member\n173|\tcleaned := path.Clean(full)\n174|\tif strings.HasPrefix(slashRoot, \"//\") && !strings.HasPrefix(cleaned, \"//\") {\n175|\t\tcleaned = \"/\" + cleaned\n176|\t}\n177|\treturn cleaned\n178|}\n179|\n180|// withinRoot reports whether the cleaned join stays inside the cleaned\n181|// root: equality (the root itself) or a slash-boundary prefix. A bare\n182|// string prefix is not containment: \"/root-evil\" starts with \"/root\" but\n183|// is not inside it.\n184|func withinRoot(slashRoot, joined string) bool {\n185|\tbase := strings.TrimSuffix(slashRoot, \"/\")\n186|\tif base == \"\" {\n187|\t\tbase = \"/\"\n188|\t}\n189|\tif joined == base {\n190|\t\treturn true\n191|\t}\n192|\treturn strings.HasPrefix(joined, base+\"/\")\n193|}\n194|\n195|// DetectCaseCollision reports whether candidate collides with an existing\n196|// member name under case folding for a case-insensitive destination\n197|// (Section 16.3 \"case-fold collisions\"). It returns the colliding entry.\n198|// Comparison is Unicode simple folding via EqualFold over the exact entry\n199|// spellings the caller lists: the caller owns the directory read, this\n200|// function owns the decision.\n201|func DetectCaseCollision(seen []string, candidate string) (string, bool) {\n202|\tfor _, existing := range seen {\n203|\t\tif existing != candidate && strings.EqualFold(existing, candidate) {\n204|\t\t\treturn existing, true\n205|\t\t}\n206|\t}\n207|\treturn \"\", false\n208|}\n209|\n210|// CheckRegularTarget refuses a stat result that is not a plain regular\n211|// file: symlinks, directories, devices, named pipes, and sockets\n212|// (Section 16.3 \"symlink/reparse escape\" and \"device/FIFO/socket\n213|// creation\"). A nil result is refused rather than treated as absent: a\n214|// failed stat is never a legitimate absence.\n215|func CheckRegularTarget(info os.FileInfo) error {\n216|\tif info == nil {\n217|\t\treturn failPath(\"target stat missing\", \"nil file info\")\n218|\t}\n219|\tmode := info.Mode()\n220|\tswitch {\n221|\tcase mode&os.ModeSymlink != 0:\n222|\t\treturn failPath(\"target symlink\", info.Name())\n223|\tcase info.IsDir():\n224|\t\treturn failPath(\"target directory\", info.Name())\n225|\tcase mode&os.ModeDevice != 0,\n226|\t\tmode&os.ModeNamedPipe != 0,\n227|\t\tmode&os.ModeSocket != 0,\n228|\t\tmode&os.ModeCharDevice != 0,\n229|\t\t!mode.IsRegular():\n230|\t\treturn failPath(\"target special file\", info.Name())\n231|\t}\n232|\treturn nil\n233|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c487","stream":{"kind":"session","id":"01a07750-3853-73c0-b383-0773367c2b50"},"sequence":158,"recorded_at":1780531400000311,"record_type":"event","durability":"durable","causation_id":"54033564-b97c-4244-a825-33fd926ad5cb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"54033564-b97c-4244-a825-33fd926ad5cb","run_stream":{"kind":"run","id":"54033564-b97c-4244-a825-33fd926ad5cb"},"call_id":"call_01a077507bb975b09b42b8506b95931d","text":"Read text file `internal/secprim/open_unix_test.go`.\n1|//go:build !windows\n2|\n3|package secprim\n4|\n5|import (\n6|\t\"io\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"runtime\"\n10|\t\"testing\"\n11|\t\"time\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|)\n15|\n16|// stageTree builds the B1 escape fixture: a staging root holding one\n17|// honest member file, plus a sibling \"outside\" tree whose loot file is\n18|// reachable only through the symlinked intermediate component\n19|// stage/sub -> outside. Symlink creation needs privilege on Windows,\n20|// so this file is unix-only; Windows keeps its stated check-then-open\n21|// bound.\n22|func stageTree(t *testing.T) (stage, outside string) {\n23|\tt.Helper()\n24|\tbase := t.TempDir()\n25|\tstage = filepath.Join(base, \"stage\")\n26|\toutside = filepath.Join(base, \"outside\")\n27|\tif err := os.MkdirAll(filepath.Join(stage, \"ok\"), 0o700); err != nil {\n28|\t\tt.Fatal(err)\n29|\t}\n30|\tif err := os.MkdirAll(outside, 0o700); err != nil {\n31|\t\tt.Fatal(err)\n32|\t}\n33|\tif err := os.WriteFile(filepath.Join(stage, \"ok\", \"file\"), []byte(\"inside\"), 0o600); err != nil {\n34|\t\tt.Fatal(err)\n35|\t}\n36|\tif err := os.WriteFile(filepath.Join(outside, \"loot\"), []byte(\"ESCAPED\"), 0o600); err != nil {\n37|\t\tt.Fatal(err)\n38|\t}\n39|\tif err := os.Symlink(outside, filepath.Join(stage, \"sub\")); err != nil {\n40|\t\tt.Skipf(\"no symlink privilege on %s\", runtime.GOOS)\n41|\t}\n42|\treturn stage, outside\n43|}\n44|\n45|// TestGuardOpenRefusesSymlinkedParent is the B1 vector: Guard.Resolve is\n46|// lexical and still maps \"sub/loot\" inside the root, while the commit\n47|// walk refuses it, because O_NOFOLLOW constrains only the final path\n48|// component and a symlinked intermediate would otherwise redirect the\n49|// open outside the root. The test pins both halves: Resolve admits\n50|// (documenting that it answers the lexical question only) and Open\n51|// refuses through the production commit entry.\n52|func TestGuardOpenRefusesSymlinkedParent(t *testing.T) {\n53|\tt.Parallel()\n54|\tstage, _ := stageTree(t)\n55|\tguard, err := NewGuard(stage, scalar.PlatformLinux, nil)\n56|\tif err != nil {\n57|\t\tt.Fatal(err)\n58|\t}\n59|\tresolved, err := guard.Resolve(\"sub/loot\")\n60|\tif err != nil {\n61|\t\tt.Fatalf(\"Resolve stopped being lexical: %v\", err)\n62|\t}\n63|\tif resolved != filepath.Join(stage, \"sub\", \"loot\") {\n64|\t\tt.Fatalf(\"Resolve(sub/loot) = %q, want the lexical join\", resolved)\n65|\t}\n66|\troot, err := OpenNoFollowDir(stage)\n67|\tif err != nil {\n68|\t\tt.Fatal(err)\n69|\t}\n70|\tdefer func() { _ = root.Close() }()\n71|\tstart := time.Now()\n72|\t_, err = guard.Open(root, \"sub/loot\")\n73|\trequireRefusal(t, err, ErrUnsafePath, \"secprim unsafe path: member symlink escape: sub/loot\")\n74|\tif elapsed := time.Since(start); elapsed > 5*time.Second {\n75|\t\tt.Fatalf(\"commit refusal took %v; the walk must fail fast, not stall\", elapsed)\n76|\t}\n77|}\n78|\n79|// TestGuardOpenAdmitsHonestMembers proves the walk reaches through\n80|// honest intermediate directories to the same bytes a direct open\n81|// reads: the escape refusal above is narrow to the symlink shape, not\n82|// a blanket commit failure.\n83|func TestGuardOpenAdmitsHonestMembers(t *testing.T) {\n84|\tt.Parallel()\n85|\tstage, _ := stageTree(t)\n86|\tguard, err := NewGuard(stage, scalar.PlatformLinux, nil)\n87|\tif err != nil {\n88|\t\tt.Fatal(err)\n89|\t}\n90|\troot, err := OpenNoFollowDir(stage)\n91|\tif err != nil {\n92|\t\tt.Fatal(err)\n93|\t}\n94|\tdefer func() { _ = root.Close() }()\n95|\tfile, err := guard.Open(root, \"ok/file\")\n96|\tif err != nil {\n97|\t\tt.Fatalf(\"honest member refused: %v\", err)\n98|\t}\n99|\tdefer func() { _ = file.Close() }()\n100|\tcontents, err := io.ReadAll(file)\n101|\tif err != nil {\n102|\t\tt.Fatal(err)\n103|\t}\n104|\tif string(contents) != \"inside\" {\n105|\t\tt.Fatalf(\"commit read %q, want the staged bytes\", contents)\n106|\t}\n107|}\n108|\n109|// TestGuardOpenRefusesCommitShapes drives every other commit refusal\n110|// through the production entry: a trailing symlink (final-component\n111|// escape), a missing member, an unmanaged member, a nil root handle,\n112|// and a non-directory root handle.\n113|func TestGuardOpenRefusesCommitShapes(t *testing.T) {\n114|\tt.Parallel()\n115|\tstage, _ := stageTree(t)\n116|\tguard, err := NewGuard(stage, scalar.PlatformLinux, nil)\n117|\tif err != nil {\n118|\t\tt.Fatal(err)\n119|\t}\n120|\tmanaged, err := NewGuard(stage, scalar.PlatformLinux, []string{\"ok/file\"})\n121|\tif err != nil {\n122|\t\tt.Fatal(err)\n123|\t}\n124|\troot, err := OpenNoFollowDir(stage)\n125|\tif err != nil {\n126|\t\tt.Fatal(err)\n127|\t}\n128|\tdefer func() { _ = root.Close() }()\n129|\tplain, err := os.Open(filepath.Join(stage, \"ok\", \"file\"))\n130|\tif err != nil {\n131|\t\tt.Fatal(err)\n132|\t}\n133|\tdefer func() { _ = plain.Close() }()\n134|\tfinal := filepath.Join(stage, \"final-link\")\n135|\tif err := os.Symlink(filepath.Join(stage, \"ok\", \"file\"), final); err != nil {\n136|\t\tt.Skipf(\"no symlink privilege on %s\", runtime.GOOS)\n137|\t}\n138|\tcases := []struct {\n139|\t\tname   string\n140|\t\tguard  Guard\n141|\t\troot   *os.File\n142|\t\tmember string\n143|\t\tcheck  func(t *testing.T, err error)\n144|\t}{\n145|\t\t{\n146|\t\t\tname: \"final symlink\", guard: guard, root: root, member: \"final-link\",\n147|\t\t\tcheck: func(t *testing.T, err error) {\n148|\t\t\t\tt.Helper()\n149|\t\t\t\trequireRefusal(t, err, ErrUnsafePath, \"secprim unsafe path: member symlink escape: final-link\")\n150|\t\t\t},\n151|\t\t},\n152|\t\t{\n153|\t\t\tname: \"missing member\", guard: guard, root: root, member: \"ok/absent\",\n154|\t\t\tcheck: func(t *testing.T, err error) {\n155|\t\t\t\tt.Helper()\n156|\t\t\t\trequireRefusalPrefix(t, err, ErrUnsafePath, \"secprim unsafe path: open failed: ok/absent\")\n157|\t\t\t},\n158|\t\t},\n159|\t\t{\n160|\t\t\tname: \"missing intermediate\", guard: guard, root: root, member: \"nodir/file\",\n161|\t\t\tcheck: func(t *testing.T, err error) {\n162|\t\t\t\tt.Helper()\n163|\t\t\t\trequireRefusalPrefix(t, err, ErrUnsafePath, \"secprim unsafe path: open failed: nodir/file\")\n164|\t\t\t},\n165|\t\t},\n166|\t\t{\n167|\t\t\tname: \"unmanaged member\", guard: managed, root: root, member: \"ok/other\",\n168|\t\t\tcheck: func(t *testing.T, err error) {\n169|\t\t\t\tt.Helper()\n170|\t\t\t\trequireRefusal(t, err, ErrUnsafePath, \"secprim unsafe path: member unmanaged: ok/other\")\n171|\t\t\t},\n172|\t\t},\n173|\t\t{\n174|\t\t\tname: \"member grammar\", guard: guard, root: root, member: \"../escape\",\n175|\t\t\tcheck: func(t *testing.T, err error) {\n176|\t\t\t\tt.Helper()\n177|\t\t\t\trequireRefusal(t, err, ErrUnsafePath, \"secprim unsafe path: member grammar: ../escape\")\n178|\t\t\t},\n179|\t\t},\n180|\t\t{\n181|\t\t\tname: \"nil root handle\", guard: guard, root: nil, member: \"ok/file\",\n182|\t\t\tcheck: func(t *testing.T, err error) {\n183|\t\t\t\tt.Helper()\n184|\t\t\t\trequireRefusal(t, err, ErrUnsafePath, \"secprim unsafe path: guard root handle: ok/file\")\n185|\t\t\t},\n186|\t\t},\n187|\t\t{\n188|\t\t\tname: \"file root handle\", guard: guard, root: plain, member: \"ok/file\",\n189|\t\t\tcheck: func(t *testing.T, err error) {\n190|\t\t\t\tt.Helper()\n191|\t\t\t\trequireRefusal(t, err, ErrUnsafePath, \"secprim unsafe path: guard root handle: ok/file\")\n192|\t\t\t},\n193|\t\t},\n194|\t}\n195|\t// The subtests share the root handle and run inline: a parallel\n196|\t// subtest would outlive the parent's deferred Close and stat a\n197|\t// closed descriptor.\n198|\tfor _, kase := range cases {\n199|\t\tt.Run(kase.name, func(t *testing.T) {\n200|\t\t\t_, err := kase.guard.Open(kase.root, kase.member)\n201|\t\t\tkase.check(t, err)\n202|\t\t})\n203|\t}\n204|}\n205|\n206|// TestOpenNoFollowFileRefusesFifoWithoutBlocking is the B2 vector: a\n207|// read-only open(2) of a FIFO with no writer blocks in the kernel, and\n208|// the shape check that refuses it runs only after the open returns, so\n209|// without O_NONBLOCK the refusal is unreachable and the opener hangs.\n210|// The goroutine plus timeout turns a regression into a failure instead\n211|// of a stalled suite: with the flag the refusal arrives immediately.\n212|func TestOpenNoFollowFileRefusesFifoWithoutBlocking(t *testing.T) {\n213|\tt.Parallel()\n214|\tfifo := filepath.Join(t.TempDir(), \"pipe\")\n215|\tmakeFifo(t, fifo)\n216|\tdone := make(chan error, 1)\n217|\tgo func() {\n218|\t\tfile, err := OpenNoFollowFile(fifo)\n219|\t\tif err == nil {\n220|\t\t\t_ = file.Close()\n221|\t\t}\n222|\t\tdone <- err\n223|\t}()\n224|\tselect {\n225|\tcase err := <-done:\n226|\t\trequireRefusal(t, err, ErrUnsafePath, \"secprim unsafe path: target special file: pipe\")\n227|\tcase <-time.After(10 * time.Second):\n228|\t\tt.Fatal(\"OpenNoFollowFile blocked on a FIFO for 10s instead of refusing\")\n229|\t}\n230|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c489","stream":{"kind":"session","id":"01a07750-3853-73c0-b383-0773367c2b50"},"sequence":159,"recorded_at":1780531400000313,"record_type":"event","durability":"durable","causation_id":"54033564-b97c-4244-a825-33fd926ad5cb","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"54033564-b97c-4244-a825-33fd926ad5cb","run_stream":{"kind":"run","id":"54033564-b97c-4244-a825-33fd926ad5cb"},"call_id":"call_01a077507c1b7022a8dbbec57e2eb729","text":"Read text file `internal/secprim/inventory_test.go`.\n1|package secprim\n2|\n3|import (\n4|\t\"flag\"\n5|\t\"fmt\"\n6|\t\"go/ast\"\n7|\t\"go/parser\"\n8|\t\"go/token\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"runtime\"\n12|\t\"sort\"\n13|\t\"strconv\"\n14|\t\"strings\"\n15|\t\"sync\"\n16|\t\"testing\"\n17|)\n18|\n19|// exercisedRefusalSites records the production file:line that constructed a\n20|// refusal, keyed with the rule it carried, for every instrumented refusal\n21|// constructor call made during the test run.\n22|var exercisedRefusalSites sync.Map // file:line -> rule\n23|\n24|func recordRefusalSite(rule string) {\n25|\tif _, file, line, ok := runtime.Caller(2); ok {\n26|\t\texercisedRefusalSites.Store(fmt.Sprintf(\"%s:%d\", filepath.Base(file), line), rule)\n27|\t}\n28|}\n29|\n30|func TestMain(main *testing.M) {\n31|\torigPath, origArgv, origEnv := failPath, failArgv, failEnv\n32|\tfailPath = func(rule, detail string) *Error {\n33|\t\terr := origPath(rule, detail)\n34|\t\trecordRefusalSite(\"path:\" + rule)\n35|\t\treturn err\n36|\t}\n37|\tfailArgv = func(rule, detail string) *Error {\n38|\t\terr := origArgv(rule, detail)\n39|\t\trecordRefusalSite(\"argv:\" + rule)\n40|\t\treturn err\n41|\t}\n42|\tfailEnv = func(rule, detail string) *Error {\n43|\t\terr := origEnv(rule, detail)\n44|\t\trecordRefusalSite(\"env:\" + rule)\n45|\t\treturn err\n46|\t}\n47|\tcode := main.Run()\n48|\tif code == 0 && fullPackageTestRun() {\n49|\t\tif failures := auditRefusalInventory(); len(failures) != 0 {\n50|\t\t\tfor _, failure := range failures {\n51|\t\t\t\tfmt.Fprintln(os.Stderr, failure)\n52|\t\t\t}\n53|\t\t\tcode = 1\n54|\t\t}\n55|\t}\n56|\tos.Exit(code)\n57|}\n58|\n59|func fullPackageTestRun() bool {\n60|\tselected := flag.Lookup(\"test.run\")\n61|\treturn selected == nil || selected.Value.String() == \"\"\n62|}\n63|\n64|// defensiveSites names derived refusal sites no public input can fire,\n65|// with the bound that keeps each honest. The member-containment conjunct\n66|// in Resolve is unreachable because the member grammar refuses every\n67|// parent segment before the prefix check runs; it stays as defense in\n68|// depth against a future grammar relaxation, and\n69|// TestGuardPrefixCheckIsLoadBearing proves the containment property over\n70|// a generated corpus, so a weakened grammar reddens there first. A\n71|// defensive entry that resolves to no derived site fails as stale.\n72|var defensiveSites = map[string]string{\n73|\t\"failPath:member containment\": \"unreachable while the member grammar refuses parent segments; pinned by TestGuardPrefixCheckIsLoadBearing\",\n74|}\n75|\n76|// platformExempt names rules that need not fire on one GOOS, keyed\n77|// file|constructor:rule. The key is rule-level, not site-level: every\n78|// \"open failed\" site in nofollow.go shares it. The post-check directory\n79|// open fails deterministically only where mode bits are enforceable: the\n80|// chmod vector in TestOpenNoFollowDirRefusesUnreadableDir is skipped on\n81|// Windows (ACLs do not express a mode-000 directory) and as root (which\n82|// bypasses mode bits), so on Windows the rule is exempt. An exemption\n83|// that resolves to no derived site fails as stale.\n84|var platformExempt = map[string]string{\n85|\t\"nofollow.go|failPath:open failed\": \"windows\",\n86|}\n87|\n88|// rootExempt names derived sites excused when the suite runs as root,\n89|// which bypasses the mode bits the chmod vector depends on. Same key\n90|// shape and staleness discipline as platformExempt; the audit below\n91|// checks both tables for orphans.\n92|var rootExempt = map[string]bool{\n93|\t\"nofollow.go|failPath:open failed\": true,\n94|}\n95|\n96|// siteKey renders the platform-exemption identity of a derived site: the\n97|// file basename plus the constructor and rule. Line numbers are left out\n98|// so edits above or below a site do not rename it.\n99|func siteKey(site, constructor string) string {\n100|\tfile := site\n101|\tif index := strings.LastIndex(site, \":\"); index >= 0 {\n102|\t\tfile = site[:index]\n103|\t}\n104|\treturn file + \"|\" + constructor\n105|}\n106|\n107|// exemptionResolves reports whether the exemption key matches at least\n108|// one derived site.\n109|func exemptionResolves(derived map[string]string, key string) bool {\n110|\tfor derivedSite, constructor := range derived {\n111|\t\tif siteKey(derivedSite, constructor) == key {\n112|\t\t\treturn true\n113|\t\t}\n114|\t}\n115|\treturn false\n116|}\n117|\n118|// ctorNames is the closed refusal-constructor set. errors.go states the\n119|// rule these names enforce: production builds Error values only through\n120|// them, never through an alias, a literal, new(Error), or a wrapper\n121|// factory.\n122|var ctorNames = map[string]bool{\"failPath\": true, \"failArgv\": true, \"failEnv\": true}\n123|\n124|// refusalDerivation is the parsed shape of one source set: the call\n125|// sites that must each fire during the suite, and the construction\n126|// shapes outside the constructors that must not exist at all.\n127|type refusalDerivation struct {\n128|\tsites   map[string]string // file:line -> \"constructor:rule\" (aliases resolved)\n129|\tstrays  []string          // file:line plus the offending shape, sorted\n130|\tscanned int\n131|}\n132|\n133|// unwrapParens strips parenthesized expressions so ((failPath)) and\n134|// (failPath) resolve like the bare spelling instead of bypassing it.\n135|func unwrapParens(expr ast.Expr) ast.Expr {\n136|\tfor {\n137|\t\tparenthesized, ok := expr.(*ast.ParenExpr)\n138|\t\tif !ok {\n139|\t\t\treturn expr\n140|\t\t}\n141|\t\texpr = parenthesized.X\n142|\t}\n143|}\n144|\n145|// returnsError reports whether the result list carries a *Error: the\n146|// factory shape the gate enumerates. WithCause is the one legitimate\n147|// member and is excluded by its callers, not here.\n148|func returnsError(results *ast.FieldList) bool {\n149|\tif results == nil {\n150|\t\treturn false\n151|\t}\n152|\tfor _, field := range results.List {\n153|\t\tstar, ok := unwrapParens(field.Type).(*ast.StarExpr)\n154|\t\tif !ok {\n155|\t\t\tcontinue\n156|\t\t}\n157|\t\tif identifier, ok := unwrapParens(star.X).(*ast.Ident); ok && identifier.Name == \"Error\" {\n158|\t\t\treturn true\n159|\t\t}\n160|\t}\n161|\treturn false\n162|}\n163|\n164|// isErrorLiteral reports whether the composite literal builds an\n165|// secprim Error: Error{...} in-package, or secprim.Error{...} from\n166|// outside it.\n167|func isErrorLiteral(literal *ast.CompositeLit) bool {\n168|\tswitch typed := unwrapParens(literal.Type).(type) {\n169|\tcase *ast.Ident:\n170|\t\treturn typed.Name == \"Error\"\n171|\tcase *ast.SelectorExpr:\n172|\t\treturn typed.Sel.Name == \"Error\"\n173|\t}\n174|\treturn false\n175|}\n176|\n177|// deriveRefusals parses every source and derives the refusal inventory\n178|// in two phases. Phase one resolves the constructor-alias fixpoint\n179|// (var x = failPath, x := failArgv, alias-of-alias), the *Error\n180|// factory declarations, and the constructor body spans. Phase two\n181|// walks every call, literal, binding, and name use against them:\n182|//\n183|//   - a call to a constructor or its alias is a site (the rule is the\n184|//     literal first argument, labelled under the underlying\n185|//     constructor so exemptions keep resolving);\n186|//   - a binding of a constructor to a new name is an alias stray, even\n187|//     when never called;\n188|//   - an Error literal, a new(Error) call, or a call to a package\n189|//     *Error factory (other than the WithCause decorator, which\n190|//     refines an already-counted refusal) is a construction stray;\n191|//   - a factory declaration whose body never calls a constructor is a\n192|//     manufacturing stray, even when never called;\n193|//   - any other use of a constructor name as a value is an escape\n194|//     stray.\n195|//\n196|// The enumerated shape space is: bare call, parenthesized call, var\n197|// alias, local alias, alias-of-alias, direct literal, new(Error),\n198|// method factory call, function factory call, uncalled factory, and\n199|// value escape. TestRefusalInventoryClosesBypassShapes plants every\n200|// member.\n201|func deriveRefusals(sources map[string][]byte) (refusalDerivation, error) {\n202|\tderivation := refusalDerivation{sites: map[string]string{}}\n203|\tfileset := token.NewFileSet()\n204|\ttype parsed struct {\n205|\t\tname   string\n206|\t\tsyntax *ast.File\n207|\t}\n208|\tvar files []parsed\n209|\tnames := make([]string, 0, len(sources))\n210|\tfor name := range sources {\n211|\t\tnames = append(names, name)\n212|\t}\n213|\tsort.Strings(names)\n214|\tfor _, name := range names {\n215|\t\tsyntax, err := parser.ParseFile(fileset, name, sources[name], 0)\n216|\t\tif err != nil {\n217|\t\t\treturn derivation, err\n218|\t\t}\n219|\t\tfiles = append(files, parsed{name: name, syntax: syntax})\n220|\t}\n221|\tderivation.scanned = len(files)\n222|\tposition := func(name string, pos token.Pos) string {\n223|\t\treturn fmt.Sprintf(\"%s:%d\", filepath.Base(name), fileset.Position(pos).Line)\n224|\t}\n225|\tinsideCtor := func(syntax *ast.File, pos token.Pos) bool {\n226|\t\tinside := false\n227|\t\tast.Inspect(syntax, func(node ast.Node) bool {\n228|\t\t\tgeneral, ok := node.(*ast.GenDecl)\n229|\t\t\tif !ok {\n230|\t\t\t\treturn true\n231|\t\t\t}\n232|\t\t\tfor _, spec := range general.Specs {\n233|\t\t\t\tvalues, ok := spec.(*ast.ValueSpec)\n234|\t\t\t\tif !ok {\n235|\t\t\t\t\tcontinue\n236|\t\t\t\t}\n237|\t\t\t\tfor index, identifier := range values.Names {\n238|\t\t\t\t\tif !ctorNames[identifier.Name] || index >= len(values.Values) {\n239|\t\t\t\t\t\tcontinue\n240|\t\t\t\t\t}\n241|\t\t\t\t\tif literal, ok := values.Values[index].(*ast.FuncLit); ok {\n242|\t\t\t\t\t\tif pos >= literal.Pos() && pos <= literal.End() {\n243|\t\t\t\t\t\t\tinside = true\n244|\t\t\t\t\t\t\treturn false\n245|\t\t\t\t\t\t}\n246|\t\t\t\t\t}\n247|\t\t\t\t}\n248|\t\t\t}\n249|\t\t\treturn true\n250|\t\t})\n251|\t\treturn inside\n252|\t}\n253|\t// Phase one: bindings of constructor values to new names.\n254|\ttype binding struct {\n255|\t\tname, file, target string\n256|\t\tpos                token.Pos\n257|\t}\n258|\tvar bindings []binding\n259|\tnoteBinding := func(file string, lhs, rhs ast.Expr) {\n260|\t\tidentifier, ok := lhs.(*ast.Ident)\n261|\t\tif !ok || identifier.Name == \"_\" {\n262|\t\t\treturn\n263|\t\t}\n264|\t\tif target, ok := unwrapParens(rhs).(*ast.Ident); ok {\n265|\t\t\tbindings = append(bindings, binding{name: identifier.Name, file: file, target: target.Name, pos: identifier.Pos()})\n266|\t\t}\n267|\t}\n268|\tfor _, file := range files {\n269|\t\tast.Inspect(file.syntax, func(node ast.Node) bool {\n270|\t\t\tswitch typed := node.(type) {\n271|\t\t\tcase *ast.ValueSpec:\n272|\t\t\t\tfor index, identifier := range typed.Names {\n273|\t\t\t\t\tif index < len(typed.Values) {\n274|\t\t\t\t\t\tnoteBinding(file.name, identifier, typed.Values[index])\n275|\t\t\t\t\t}\n276|\t\t\t\t}\n277|\t\t\tcase *ast.AssignStmt:\n278|\t\t\t\tif len(typed.Lhs) == len(typed.Rhs) {\n279|\t\t\t\t\tfor index := range typed.Lhs {\n280|\t\t\t\t\t\tnoteBinding(file.name, typed.Lhs[index], typed.Rhs[index])\n281|\t\t\t\t\t}\n282|\t\t\t\t}\n283|\t\t\t}\n284|\t\t\treturn true\n285|\t\t})\n286|\t}\n287|\taliases := map[string]string{}\n288|\tfor changed := true; changed; {\n289|\t\tchanged = false\n290|\t\tfor _, candidate := range bindings {\n291|\t\t\tif _, known := aliases[candidate.name]; known {\n292|\t\t\t\tcontinue\n293|\t\t\t}\n294|\t\t\tif ctorNames[candidate.target] {\n295|\t\t\t\taliases[candidate.name] = candidate.target\n296|\t\t\t\tchanged = true\n297|\t\t\t} else if underlying, ok := aliases[candidate.target]; ok {\n298|\t\t\t\taliases[candidate.name] = underlying\n299|\t\t\t\tchanged = true\n300|\t\t\t}\n301|\t\t}\n302|\t}\n303|\tunderlying := func(name string) (string, bool) {\n304|\t\tif ctorNames[name] {\n305|\t\t\treturn name, true\n306|\t\t}\n307|\t\ttarget, ok := aliases[name]\n308|\t\treturn target, ok\n309|\t}\n310|\t// Phase one: *Error factory declarations (functions and methods).\n311|\tfactories := map[string]bool{}\n312|\tfor _, file := range files {\n313|\t\tfor _, declaration := range file.syntax.Decls {\n314|\t\t\tfunction, ok := declaration.(*ast.FuncDecl)\n315|\t\t\tif !ok || function.Name.Name == \"WithCause\" {\n316|\t\t\t\tcontinue\n317|\t\t\t}\n318|\t\t\tif returnsError(function.Type.Results) {\n319|\t\t\t\tfactories[function.Name.Name] = true\n320|\t\t\t}\n321|\t\t}\n322|\t}\n323|\t// Phase two: sites, strays, and the positions that excuse a name\n324|\t// use (call-fun position and declaration position).\n325|\tcallFuns := map[token.Pos]bool{}\n326|\tdeclared := map[token.Pos]bool{}\n327|\tfor _, file := range files {\n328|\t\tast.Inspect(file.syntax, func(node ast.Node) bool {\n329|\t\t\tswitch typed := node.(type) {\n330|\t\t\tcase *ast.CallExpr:\n331|\t\t\t\tif identifier, ok := unwrapParens(typed.Fun).(*ast.Ident); ok {\n332|\t\t\t\t\tcallFuns[identifier.Pos()] = true\n333|\t\t\t\t}\n334|\t\t\tcase *ast.ValueSpec:\n335|\t\t\t\tfor _, identifier := range typed.Names {\n336|\t\t\t\t\tdeclared[identifier.Pos()] = true\n337|\t\t\t\t}\n338|\t\t\tcase *ast.AssignStmt:\n339|\t\t\t\tfor _, bound := range typed.Lhs {\n340|\t\t\t\t\tif identifier, ok := bound.(*ast.Ident); ok {\n341|\t\t\t\t\t\tdeclared[identifier.Pos()] = true\n342|\t\t\t\t\t}\n343|\t\t\t\t}\n344|\t\t\tcase *ast.Field:\n345|\t\t\t\tfor _, identifier := range typed.Names {\n346|\t\t\t\t\tdeclared[identifier.Pos()] = true\n347|\t\t\t\t}\n348|\t\t\tcase *ast.FuncDecl:\n349|\t\t\t\tdeclared[typed.Name.Pos()] = true\n350|\t\t\tcase *ast.TypeSpec:\n351|\t\t\t\tdeclared[typed.Name.Pos()] = true\n352|\t\t\t}\n353|\t\t\treturn true\n354|\t\t})\n355|\t}\n356|\tstray := func(file string, pos token.Pos, shape string) {\n357|\t\tderivation.strays = append(derivation.strays, position(file, pos)+\" \"+shape)\n358|\t}\n359|\tfor _, file := range files {\n360|\t\tast.Inspect(file.syntax, func(node ast.Node) bool {\n361|\t\t\tcall, ok := node.(*ast.CallExpr)\n362|\t\t\tif !ok {\n363|\t\t\t\treturn true\n364|\t\t\t}\n365|\t\t\tswitch fun := unwrapParens(call.Fun).(type) {\n366|\t\t\tcase *ast.Ident:\n367|\t\t\t\tif constructor, ok := underlying(fun.Name); ok {\n368|\t\t\t\t\t// Every constructor call passes its rule as a\n369|\t\t\t\t\t// string literal first argument; a non-literal\n370|\t\t\t\t\t// rule is outside the roster shape and fails\n371|\t\t\t\t\t// the derivation.\n372|\t\t\t\t\tsite := position(file.name, call.Pos())\n373|\t\t\t\t\tif len(call.Args) == 0 {\n374|\t\t\t\t\t\tderivation.sites[site] = \"\"\n375|\t\t\t\t\t\treturn true\n376|\t\t\t\t\t}\n377|\t\t\t\t\tliteral, ok := unwrapParens(call.Args[0]).(*ast.BasicLit)\n378|\t\t\t\t\tif !ok || literal.Kind != token.STRING {\n379|\t\t\t\t\t\tderivation.sites[site] = \"\"\n380|\t\t\t\t\t\treturn true\n381|\t\t\t\t\t}\n382|\t\t\t\t\trule, err := strconv.Unquote(literal.Value)\n383|\t\t\t\t\tif err != nil {\n384|\t\t\t\t\t\tderivation.sites[site] = \"\"\n385|\t\t\t\t\t\treturn true\n386|\t\t\t\t\t}\n387|\t\t\t\t\tderivation.sites[site] = constructor + \":\" + rule\n388|\t\t\t\t\treturn true\n389|\t\t\t\t}\n390|\t\t\t\tif fun.Name == \"new\" && len(call.Args) > 0 {\n391|\t\t\t\t\tif identifier, ok := unwrapParens(call.Args[0]).(*ast.Ident); ok && identifier.Name == \"Error\" {\n392|\t\t\t\t\t\tstray(file.name, call.Pos(), \"new(Error) manufactures a refusal outside the constructors\")\n393|\t\t\t\t\t}\n394|\t\t\t\t\treturn true\n395|\t\t\t\t}\n396|\t\t\t\tif factories[fun.Name] {\n397|\t\t\t\t\tstray(file.name, call.Pos(), \"factory call \"+fun.Name+\" manufactures a refusal outside the constructors\")\n398|\t\t\t\t}\n399|\t\t\tcase *ast.SelectorExpr:\n400|\t\t\t\tif fun.Sel.Name == \"WithCause\" {\n401|\t\t\t\t\treturn true\n402|\t\t\t\t}\n403|\t\t\t\tif factories[fun.Sel.Name] {\n404|\t\t\t\t\tstray(file.name, call.Pos(), \"factory call \"+fun.Sel.Name+\" manufactures a refusal outside the constructors\")\n405|\t\t\t\t}\n406|\t\t\t}\n407|\t\t\treturn true\n408|\t\t})\n409|\t\tast.Inspect(file.syntax, func(node ast.Node) bool {\n410|\t\t\tliteral, ok := node.(*ast.CompositeLit)\n411|\t\t\tif !ok {\n412|\t\t\t\treturn true\n413|\t\t\t}\n414|\t\t\tif isErrorLiteral(literal) && !insideCtor(file.syntax, literal.Pos()) {\n415|\t\t\t\tstray(file.name, literal.Pos(), \"Error literal manufactures a refusal outside the constructors\")\n416|\t\t\t}\n417|\t\t\treturn true\n418|\t\t})\n419|\t}\n420|\tfor _, candidate := range bindings {\n421|\t\tif _, ok := underlying(candidate.target); ok {\n422|\t\t\tif ctorNames[candidate.name] {\n423|\t\t\t\tcontinue\n424|\t\t\t}\n425|\t\t\tstray(candidate.file, candidate.pos, \"alias \"+candidate.name+\" rebinds a refusal constructor\")\n426|\t\t}\n427|\t}\n428|\t// Factory declarations whose body never reaches a constructor\n429|\t// manufacture refusals no inventory site can name.\n430|\tfor _, file := range files {\n431|\t\tfor _, declaration := range file.syntax.Decls {\n432|\t\t\tfunction, ok := declaration.(*ast.FuncDecl)\n433|\t\t\tif !ok || function.Name.Name == \"WithCause\" || function.Body == nil {\n434|\t\t\t\tcontinue\n435|\t\t\t}\n436|\t\t\tif !factories[function.Name.Name] {\n437|\t\t\t\tcontinue\n438|\t\t\t}\n439|\t\t\treaches := false\n440|\t\t\tast.Inspect(function.Body, func(node ast.Node) bool {\n441|\t\t\t\tcall, ok := node.(*ast.CallExpr)\n442|\t\t\t\tif !ok {\n443|\t\t\t\t\treturn true\n444|\t\t\t\t}\n445|\t\t\t\tif identifier, ok := unwrapParens(call.Fun).(*ast.Ident); ok {\n446|\t\t\t\t\tif _, ok := underlying(identifier.Name); ok {\n447|\t\t\t\t\t\treaches = true\n448|\t\t\t\t\t\treturn false\n449|\t\t\t\t\t}\n450|\t\t\t\t}\n451|\t\t\t\treturn true\n452|\t\t\t})\n453|\t\t\tif !reaches {\n454|\t\t\t\tstray(file.name, function.Pos(), \"factory \"+function.Name.Name+\" manufactures *Error without the constructors\")\n455|\t\t\t}\n456|\t\t}\n457|\t}\n458|\t// Constructor names used as values anywhere but call-fun and\n459|\t// declaration position escape the call-site inventory.\n460|\tfor _, file := range files {\n461|\t\tast.Inspect(file.syntax, func(node ast.Node) bool {\n462|\t\t\tidentifier, ok := node.(*ast.Ident)\n463|\t\t\tif !ok {\n464|\t\t\t\treturn true\n465|\t\t\t}\n466|\t\t\tif _, ok := underlying(identifier.Name); !ok {\n467|\t\t\t\treturn true\n468|\t\t\t}\n469|\t\t\tif callFuns[identifier.Pos()] || declared[identifier.Pos()] {\n470|\t\t\t\treturn true\n471|\t\t\t}\n472|\t\t\tstray(file.name, identifier.Pos(), \"constructor \"+identifier.Name+\" escapes as a value outside a call\")\n473|\t\t\treturn true\n474|\t\t})\n475|\t}\n476|\tsort.Strings(derivation.strays)\n477|\treturn derivation, nil\n478|}\n479|\n480|// auditRefusalInventory derives every failPath/failArgv/failEnv call site\n481|// from non-test production source and requires each to have fired during\n482|// the suite (forward), and every fired site to resolve to a derived site\n483|// (reverse). Constructions outside the constructors (aliases, literals,\n484|// factories, escapes) fail outright. A constructor call no test reaches,\n485|// or a recorded site the source no longer contains, fails instead of\n486|// passing silently. An empty derivation fails closed: a blind scanner is\n487|// not a complete inventory.\n488|func auditRefusalInventory() []string {\n489|\tdirectory, err := os.Getwd()\n490|\tif err != nil {\n491|\t\treturn []string{fmt.Sprintf(\"derive secprim refusal inventory: %v\", err)}\n492|\t}\n493|\tentries, err := os.ReadDir(directory)\n494|\tif err != nil {\n495|\t\treturn []string{fmt.Sprintf(\"derive secprim refusal inventory: %v\", err)}\n496|\t}\n497|\tsources := map[string][]byte{}\n498|\tfor _, entry := range entries {\n499|\t\tname := entry.Name()\n500|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".go\") || strings.HasSuffix(name, \"_test.go\") {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
