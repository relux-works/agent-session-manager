{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c817","stream":{"kind":"session","id":"01a0adbc-8d1e-7161-b034-85e889114404"},"sequence":614,"recorded_at":1780531400001223,"record_type":"event","durability":"durable","causation_id":"b0649d13-c918-4732-aec0-765824cc6bc5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b0649d13-c918-4732-aec0-765824cc6bc5","run_stream":{"kind":"run","id":"b0649d13-c918-4732-aec0-765824cc6bc5"},"call_id":"call_01a0adbdc4c5744799bc0438d1c999ec","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1oqfec/worktree/internal/sessrepo/lease.go`.\n1|// Lease Record attestation for the session-persistence leaf.\n2|//\n3|// Lease Records (urn:ax:schema:lease) are session-persistence objects\n4|// alongside Session Records and Session Events. This helper owns their\n5|// canonical identity attestation through the canonicaljson owner, so\n6|// query-layer admission (internal/sessquery) never attests the binding\n7|// itself: it calls AttestLeaseRecord and then extracts the already\n8|// validated members. The lease store's mint path confirms through the\n9|// same funnel, keeping this file the leaf's only direct Verify caller\n10|// for lease objects. The provhost identity bound allowlists this site\n11|// with the three session record/event sites.\n12|package sessrepo\n13|\n14|import (\n15|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n17|)\n18|\n19|// AttestLeaseRecord validates one canonical Lease Record frame through\n20|// the canonicaljson owner and returns its canonical digest with the\n21|// self-identity field. Closed-shape and self-identity failures are\n22|// returned for the caller to map to its refusal class.\n23|func AttestLeaseRecord(raw []byte) (scalar.Digest, canonicaljson.SelfField, error) {\n24|\treturn canonicaljson.VerifyObjectIdentity(raw)\n25|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c819","stream":{"kind":"session","id":"01a0adbc-8d1e-7161-b034-85e889114404"},"sequence":615,"recorded_at":1780531400001225,"record_type":"event","durability":"durable","causation_id":"b0649d13-c918-4732-aec0-765824cc6bc5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b0649d13-c918-4732-aec0-765824cc6bc5","run_stream":{"kind":"run","id":"b0649d13-c918-4732-aec0-765824cc6bc5"},"call_id":"call_01a0adbdc5bc70c6a2938c3a9654b8c7","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1oqfec/worktree/internal/sessstate/sessstate.go`.\n(129 line(s) above)\n130|\n131|// IsZero reports an unset lease head: no local lease was supplied.\n132|func (head LeaseHead) IsZero() bool {\n133|\treturn head.Epoch == 0 && head.LeaseID == \"\"\n134|}\n135|\n136|// Compare orders two lease heads by the Section 5.3 tuple rule: the\n137|// greatest (epoch, lease_id) wins, where lease_id uses bytewise UUID\n138|// order. Lease IDs are canonical lowercase UUIDv4, so string order is\n139|// bytewise order.\n140|func Compare(a, b LeaseHead) int {\n141|\tif a.Epoch != b.Epoch {\n142|\t\tif a.Epoch < b.Epoch {\n143|\t\t\treturn -1\n144|\t\t}\n145|\t\treturn 1\n146|\t}\n147|\tswitch {\n148|\tcase a.LeaseID < b.LeaseID:\n149|\t\treturn -1\n150|\tcase a.LeaseID > b.LeaseID:\n151|\t\treturn 1\n152|\t}\n153|\treturn 0\n154|}\n155|\n156|// Conflict kinds. A conflict is reported data, never an error: both\n157|// sides were individually admittable, so the projection names the rule\n158|// that resolved them.\n159|const (\n160|\t// ConflictSameEpochTie ResolveRuleGreatestLeaseIDWins: two distinct\n161|\t// leases share the winning epoch (concurrent force takeovers under\n162|\t// partition); the bytewise-greater lease ID wins.\n163|\tConflictSameEpochTie = \"same_epoch_tie\"\n164|\t// ConflictEpochGap ResolveRuleGreatestTupleWins: a successor epoch\n165|\t// skips its predecessor (epoch N to N+2 or more); the greatest\n166|\t// tuple still wins, and only an explicit takeover checkpoint heals\n167|\t// the gap.\n168|\tConflictEpochGap = \"epoch_gap\"\n169|\t// ConflictLosingBranchPreserved ResolveRulePreservedNeverApplied:\n170|\t// an observed lease loses the tuple comparison; its history stays\n171|\t// preserved but never affects authoritative state.\n172|\tConflictLosingBranchPreserved = \"losing_branch_preserved\"\n173|\t// ConflictProviderMismatch ResolveRuleRecordPinnedProviderWins:\n174|\t// a launch event names a provider other than the immutable Session\n175|\t// Record provider; the record value stays authoritative.\n176|\tConflictProviderMismatch = \"provider_mismatch\"\n177|\t// ConflictUnionSupersedesChain\n178|\t// ResolveRuleAuthoritativeStateUnchanged: the union winner is not\n179|\t// among the authoritative chain leases; the reported winner moves\n180|\t// but derived state does not until an explicit takeover lands.\n181|\tConflictUnionSupersedesChain = \"union_supersedes_chain\"\n182|)\n183|\n184|// Resolution rules named by conflicts.\n185|const (\n186|\tResolveRuleGreatestLeaseIDWins         = \"greatest-lease-id-wins\"\n187|\tResolveRuleGreatestTupleWins           = \"greatest-tuple-wins\"\n188|\tResolveRulePreservedNeverApplied       = \"preserved-never-applied\"\n189|\tResolveRuleRecordPinnedProviderWins    = \"record-pinned-provider-wins\"\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c81b","stream":{"kind":"session","id":"01a0adbc-8d1e-7161-b034-85e889114404"},"sequence":616,"recorded_at":1780531400001227,"record_type":"event","durability":"durable","causation_id":"b0649d13-c918-4732-aec0-765824cc6bc5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b0649d13-c918-4732-aec0-765824cc6bc5","run_stream":{"kind":"run","id":"b0649d13-c918-4732-aec0-765824cc6bc5"},"call_id":"call_01a0adbdc6da745d8bf388c63f4f0cad","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1oqfec/worktree/internal/provhost/identity_test.go`.\n(59 line(s) above)\n60|\tif field != canonicaljson.SelfRecordID {\n61|\t\tt.Fatalf(\"VerifyObjectIdentity(spec example) field = %q, want record_id\", field)\n62|\t}\n63|\tconst want = \"sha256:c879d766da67a8cfb3a3f6eae2234faa5d52d8df987496eae2218f40e5e220c2\"\n64|\tif verified.String() != want {\n65|\t\tt.Fatalf(\"VerifyObjectIdentity(spec example) = %q, want the claimed %q\", verified, want)\n66|\t}\n67|}\n68|\n69|// TestNoProductionPathAttestsProviderIdentityBinding pins the second\n70|// half of the stated bound: no non-test Go file outside the session\n71|// persistence leaf calls VerifyObjectIdentity, so provider-identity\n72|// binding attestation happens nowhere in production — not at this gate\n73|// and not at any persistence path. The session-state story\n74|// (TASK-260830-wbpf1v) landed the anticipated production call sites in\n75|// internal/sessrepo, and this bound is rewritten around that truth\n76|// rather than bypassed. The name-resolution story (TASK-260830-21gygk)\n77|// adds the fourth site AttestLeaseRecord for urn:ax:schema:lease\n78|// objects, owned by the same leaf so query admission never attests\n79|// itself. Its checkpoint rework adds the fifth site\n80|// AttestCheckpointRecord for urn:ax:schema:checkpoint objects, owned\n81|// by the same leaf for the same reason: the winning-lease\n82|// checkpoint gate needs the referenced checkpoint digest attested,\n83|// and query admission still attests nothing itself. The two entry decodes (decodeSessionRecord and\n84|// decodeSessionEvent) refuse any other schema before Verify; the load\n85|// re-verification (loadSessionLocked) re-verifies stored blobs through\n86|// Verify — recomputing whatever digest the bytes claim, including a\n87|// provider-identity one — and refuses a non-event_id self field or an\n88|// index-disagreeing digest at its named arms. That division is pinned\n89|// behaviorally in the owning leaf by\n90|// TestLoadRefusesProviderIdentityBlobAtEventPath and\n91|// TestLoadRefusesSwappedEventBlobs: the first revision stated a schema\n92|// gate in front of every Verify call, which the load site never had.\n93|// The allowlist below names the owning directory by its full\n94|// module-relative path and pins the exact site count, so a stale\n95|// exception or a foreign directory with the same leaf name fails\n96|// instead of lingering; it still reddens for any other tree. The scan\n97|// is AST-based (comments and test files never count) and fails closed\n98|// when it sees nothing.\n99|// Stated bound on this test: only *ast.CallExpr nodes are inspected, so a\n100|// `f := pkg.VerifyObjectIdentity; f(x)` binding would not be seen; no such\n101|// shape exists today.\n102|func TestNoProductionPathAttestsProviderIdentityBinding(t *testing.T) {\n103|\t_, self, _, ok := runtime.Caller(0)\n104|\tif !ok {\n105|\t\tt.Fatal(\"runtime.Caller cannot locate the test file\")\n106|\t}\n107|\troot := filepath.Dir(self)\n108|\tfor {\n109|\t\tif _, err := os.Stat(filepath.Join(root, \"go.mod\")); err == nil {\n110|\t\t\tbreak\n111|\t\t}\n112|\t\tparent := filepath.Dir(root)\n113|\t\tif parent == root {\n114|\t\t\tt.Fatal(\"no module root above the test file; the scan is blind\")\n115|\t\t}\n116|\t\troot = parent\n117|\t}\n118|\tallowed, callers, scanned, parsed := scanAttestationSites(t, root)\n119|\tif scanned == 0 {\n120|\t\tt.Fatal(\"scanned no production sources; the check is blind\")\n121|\t}\n122|\tif len(allowed) != 5 {\n123|\t\tt.Fatalf(\"session-leaf attestation sites = %d, want exactly 5 (decodeSessionRecord, decodeSessionEvent, loadSessionLocked, AttestLeaseRecord, AttestCheckpointRecord): a moved call site must rewrite the bound, a new one must justify itself, a stale exception must go\", len(allowed))\n124|\t}\n125|\tif len(callers) != 0 {\n126|\t\tt.Fatalf(\"production call sites outside the session leaf attest the identity binding, contradicting the stated bound:\\n  %s\", strings.Join(callers, \"\\n  \"))\n127|\t}\n128|\tt.Logf(\"attestation scan: %d production files, %d parsed, %d session-leaf call sites, 0 elsewhere\", scanned, parsed, len(allowed))\n129|}\n130|\n131|// isSessrepoLeafFile reports whether a scan path sits inside the owning\n132|// session-persistence directory: <root>/internal/sessrepo/. The match\n133|// anchors on the full module-relative owning path, never on a bare\n134|// segment, so internal/provhost/sessrepo/plant.go (same leaf name,\n135|// foreign owner) and internal/xsessrepo/plant.go (near-miss name) both\n136|// land outside the allowlist while the leaf's own files stay admitted.\n137|func isSessrepoLeafFile(root, path string) bool {\n138|\tleaf := filepath.Join(root, \"internal\", \"sessrepo\") + string(filepath.Separator)\n139|\treturn strings.HasPrefix(path, leaf)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
