{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c59b","stream":{"kind":"session","id":"01a0adbc-8d1e-7161-b034-85e889114404"},"sequence":296,"recorded_at":1780531400000587,"record_type":"event","durability":"durable","causation_id":"b0649d13-c918-4732-aec0-765824cc6bc5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b0649d13-c918-4732-aec0-765824cc6bc5","run_stream":{"kind":"run","id":"b0649d13-c918-4732-aec0-765824cc6bc5"},"task_stream":{"kind":"task","id":"01a0adbd-28e9-7e22-8636-507e58cc2506"},"task_id":"01a0adbd-28e9-7e22-8636-507e58cc2506","event":{"kind":"output","task_id":"01a0adbd-28e9-7e22-8636-507e58cc2506","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1oqfec/worktree/internal/sessrepo/lease_store_test.go`.\n1|package sessrepo\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\t\"time\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/secconftest\"\n14|)\n15|\n16|// Lease-test identities. testLeaseIDC is the third fencing token; testHostIDB\n17|// is the normative Section 5.3 example holder.\n18|const (\n19|\ttestHostIDB  = \"0198f4c8-7d40-7e55-8e6f-1234567890ab\"\n20|\ttestLeaseIDC = \"cccccccc-dddd-4eee-8fff-111111111111\"\n21|\ttestLeaseAt  = \"2026-08-19T04:09:00.000Z\"\n22|)\n23|\n24|// specLeaseExample is the verbatim SPEC.md Section 5.3 normative example.\n25|// Its record_id is the computed canonical digest, verified by\n26|// TestNormativeLeaseRecordExampleAttests below.\n27|const specLeaseExample = `{\n28|  \"schema\": \"urn:ax:schema:lease\",\n29|  \"schema_version\": \"1.0.0\",\n30|  \"record_id\": \"sha256:8ead987abed8c7c05175b447c9a0e2b3a521f12e5a989acb8abe132576852d63\",\n31|  \"subject_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\",\n32|  \"session_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\",\n33|  \"lease_id\": \"aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee\",\n34|  \"epoch\": 4,\n35|  \"holder_host_id\": \"0198f4c8-7d40-7e55-8e6f-1234567890ab\",\n36|  \"predecessor_lease_id\": \"bbbbbbbb-cccc-4ddd-8eee-ffffffffffff\",\n37|  \"reason\": \"graceful_takeover\",\n38|  \"checkpoint_id\": \"sha256:e051996f51f13ace4f5cdebe1e30fd26fd5fe104cfd6e6a7f9f1206ba3819656\",\n39|  \"issued_by_host_id\": \"0198f4c8-7d40-7e55-8e6f-1234567890ab\",\n40|  \"created_by_host_id\": \"0198f4c8-7d40-7e55-8e6f-1234567890ab\",\n41|  \"created_at\": \"2026-08-19T04:09:00.000Z\",\n42|  \"extensions\": {}\n43|}`\n44|\n45|// createLeaseFixture returns the epoch-1 create input: fencing token A,\n46|// holder and issuer host A, and the fixed diagnostic timestamp.\n47|func createLeaseFixture() CreateLeaseInput {\n48|\treturn CreateLeaseInput{LeaseID: testLeaseID, HolderHostID: testHostID, IssuedByHostID: testHostID, CreatedAt: testLeaseAt}\n49|}\n50|\n51|// successorLeaseFixture returns a successor input: fencing token B, holder\n52|// and issuer host B, graceful_takeover over the zero checkpoint.\n53|func successorLeaseFixture() SuccessorLeaseInput {\n54|\treturn SuccessorLeaseInput{\n55|\t\tCreateLeaseInput: CreateLeaseInput{LeaseID: testLeaseIDB, HolderHostID: testHostIDB, IssuedByHostID: testHostIDB, CreatedAt: testLeaseAt},\n56|\t\tReason:           \"graceful_takeover\",\n57|\t\tCheckpointID:     zeroDigest,\n58|\t}\n59|}\n60|\n61|// mustCreateLease creates the epoch-1 lease or fails the test.\n62|func mustCreateLease(t *testing.T, repository *Repository, sessionID string, input CreateLeaseInput) LeaseRef {\n63|\tt.Helper()\n64|\treference, err := repository.CreateLease(sessionID, input)\n65|\tif err != nil {\n66|\t\tt.Fatalf(\"CreateLease error = %v\", err)\n67|\t}\n68|\treturn reference\n69|}\n70|\n71|// mustCompareAndSwap advances the head or fails the test.\n72|func mustCompareAndSwap(t *testing.T, repository *Repository, sessionID string, expected LeaseExpectation, input SuccessorLeaseInput) LeaseRef {\n73|\tt.Helper()\n74|\treference, err := repository.CompareAndSwapLease(sessionID, expected, input)\n75|\tif err != nil {\n76|\t\tt.Fatalf(\"CompareAndSwapLease error = %v\", err)\n77|\t}\n78|\treturn reference\n79|}\n80|\n81|// mustAttestLease fails unless raw verifies through the canonical owner\n82|// with the record_id self field.\n83|func mustAttestLease(t *testing.T, raw []byte, what string) string {\n84|\tt.Helper()\n85|\tdigest, field, err := canonicaljson.VerifyObjectIdentity(raw)\n86|\tif err != nil {\n87|\t\tt.Fatalf(\"%s VerifyObjectIdentity error = %v\", what, err)\n88|\t}\n89|\tif field != canonicaljson.SelfRecordID {\n90|\t\tt.Fatalf(\"%s self field = %q, want record_id\", what, string(field))\n91|\t}\n92|\treturn digest.String()\n93|}\n94|\n95|func TestNormativeLeaseRecordExampleAttests(t *testing.T) {\n96|\tdigest := mustAttestLease(t, []byte(specLeaseExample), \"SPEC 5.3 example\")\n97|\tif digest != \"sha256:8ead987abed8c7c05175b447c9a0e2b3a521f12e5a989acb8abe132576852d63\" {\n98|\t\tt.Fatalf(\"SPEC 5.3 example digest = %s\", digest)\n99|\t}\n100|}\n101|\n102|func TestCreateLeasePersistsEpochOneCreate(t *testing.T) {\n103|\trepository := openTestRepository(t)\n104|\tcreateTestSession(t, repository)\n105|\treference := mustCreateLease(t, repository, testSessionID, createLeaseFixture())\n106|\tif reference.SessionID != testSessionID || reference.Epoch != 1 || reference.LeaseID != testLeaseID || reference.HolderHostID != testHostID {\n107|\t\tt.Fatalf(\"CreateLease ref = %+v\", reference)\n108|\t}\n109|\traw := mustGetLease(t, repository, testSessionID, reference.RecordID)\n110|\tif digest := mustAttestLease(t, raw, \"created lease\"); digest != reference.RecordID {\n111|\t\tt.Fatalf(\"created lease attests %s, ref carries %s\", digest, reference.RecordID)\n112|\t}\n113|\tvar object map[string]any\n114|\tif err := json.Unmarshal(raw, &object); err != nil {\n115|\t\tt.Fatalf(\"unmarshal created lease: %v\", err)\n116|\t}\n117|\tif object[\"schema\"] != \"urn:ax:schema:lease\" || object[\"epoch\"] != 1.0 || object[\"reason\"] != \"create\" {\n118|\t\tt.Fatalf(\"created lease shape = %v\", object)\n119|\t}\n120|\tif object[\"predecessor_lease_id\"] != nil || object[\"checkpoint_id\"] != nil {\n(more lines below)","final_result":true}}}
