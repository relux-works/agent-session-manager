{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c61f","stream":{"kind":"session","id":"01a0adbc-8d1e-7161-b034-85e889114404"},"sequence":362,"recorded_at":1780531400000719,"record_type":"event","durability":"durable","causation_id":"b0649d13-c918-4732-aec0-765824cc6bc5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b0649d13-c918-4732-aec0-765824cc6bc5","run_stream":{"kind":"run","id":"b0649d13-c918-4732-aec0-765824cc6bc5"},"task_stream":{"kind":"task","id":"01a0adbd-40df-7653-a112-548a785f3e17"},"task_id":"01a0adbd-40df-7653-a112-548a785f3e17","event":{"kind":"output","task_id":"01a0adbd-40df-7653-a112-548a785f3e17","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1oqfec/worktree/internal/sessrepo/lease_crash_test.go`.\n1|package sessrepo\n2|\n3|import (\n4|\t\"os\"\n5|\t\"os/exec\"\n6|\t\"path/filepath\"\n7|\t\"testing\"\n8|\t\"time\"\n9|)\n10|\n11|// Lease crash drills kill a real child process at the install rename seam:\n12|// the child stages and fsyncs a lease blob, signals readiness from the\n13|// AfterLeaseStage hook, and blocks; the parent SIGKILLs it, reopens the\n14|// repository in a fresh handle (restart recovery), and proves the lease is\n15|// absent, the orphaned stage temp is ignored, and the byte-identical retry\n16|// succeeds. Coordination travels through environment variables and the\n17|// ready file; nothing travels through the crashed process's memory.\n18|const (\n19|\tleaseCrashChildEnv   = \"AX_SESSREPO_LEASE_CRASH_CHILD\"\n20|\tleaseCrashRootEnv    = \"AX_SESSREPO_CRASH_ROOT\"\n21|\tleaseCrashSessionEnv = \"AX_SESSREPO_CRASH_SESSION\"\n22|\tleaseCrashModeEnv    = \"AX_SESSREPO_CRASH_MODE\"\n23|\tleaseCrashReadyEnv   = \"AX_SESSREPO_CRASH_READY\"\n24|\tleaseCrashExpectEnv  = \"AX_SESSREPO_CRASH_EXPECTED\"\n25|)\n26|\n27|func TestLeaseKillAtRenameSeam(t *testing.T) {\n28|\tif os.Getenv(leaseCrashChildEnv) == \"1\" {\n29|\t\trunLeaseCrashChild()\n30|\t\treturn\n31|\t}\n32|\tt.Run(\"create\", func(t *testing.T) { driveLeaseKill(t, \"create\") })\n33|\tt.Run(\"cas\", func(t *testing.T) { driveLeaseKill(t, \"cas\") })\n34|}\n35|\n36|// runLeaseCrashChild opens the parent-prepared repository and starts the\n37|// lease write. The AfterLeaseStage hook signals the parent and blocks\n38|// forever, so this function only returns when the seam is never reached —\n39|// itself a drill failure the parent reports.\n40|func runLeaseCrashChild() {\n41|\troot := os.Getenv(leaseCrashRootEnv)\n42|\tsessionID := os.Getenv(leaseCrashSessionEnv)\n43|\tmode := os.Getenv(leaseCrashModeEnv)\n44|\tready := os.Getenv(leaseCrashReadyEnv)\n45|\trepository, err := Open(root)\n46|\tif err != nil {\n47|\t\tos.Exit(11)\n48|\t}\n49|\trepository.AfterLeaseStage = func() error {\n50|\t\tif err := os.WriteFile(ready, []byte(\"staged\"), 0o600); err != nil {\n51|\t\t\tos.Exit(12)\n52|\t\t}\n53|\t\tselect {}\n54|\t}\n55|\tswitch mode {\n56|\tcase \"create\":\n57|\t\t_, _ = repository.CreateLease(sessionID, CreateLeaseInput{LeaseID: testLeaseID, HolderHostID: testHostID, IssuedByHostID: testHostID, CreatedAt: testLeaseAt})\n58|\tcase \"cas\":\n59|\t\t_, _ = repository.CompareAndSwapLease(sessionID, LeaseExpectation{RecordID: os.Getenv(leaseCrashExpectEnv)}, SuccessorLeaseInput{\n60|\t\t\tCreateLeaseInput: CreateLeaseInput{LeaseID: testLeaseIDB, HolderHostID: testHostIDB, IssuedByHostID: testHostIDB, CreatedAt: testLeaseAt},\n61|\t\t\tReason:           \"graceful_takeover\",\n62|\t\t\tCheckpointID:     zeroDigest,\n63|\t\t})\n64|\tdefault:\n65|\t\tos.Exit(13)\n66|\t}\n67|\tos.Exit(14)\n68|}\n69|\n70|// driveLeaseKill prepares the session, runs the child to the seam, kills\n71|// it, and proves restart recovery plus the safe retry.\n72|func driveLeaseKill(t *testing.T, mode string) {\n73|\tt.Helper()\n74|\troot := t.TempDir()\n75|\trepository, err := Open(root)\n76|\tif err != nil {\n77|\t\tt.Fatalf(\"Open(crash root) error = %v\", err)\n78|\t}\n79|\tif _, err := repository.CreateSession([]byte(specRecordExample)); err != nil {\n80|\t\tt.Fatalf(\"CreateSession error = %v\", err)\n81|\t}\n82|\tvar expected string\n83|\tif mode == \"cas\" {\n84|\t\tfirst, err := repository.CreateLease(testSessionID, CreateLeaseInput{LeaseID: testLeaseID, HolderHostID: testHostID, IssuedByHostID: testHostID, CreatedAt: testLeaseAt})\n85|\t\tif err != nil {\n86|\t\t\tt.Fatalf(\"CreateLease(epoch 1) error = %v\", err)\n87|\t\t}\n88|\t\texpected = first.RecordID\n89|\t}\n90|\tready := filepath.Join(root, \"ready-\"+mode)\n91|\tchild := exec.Command(os.Args[0], \"-test.run=^TestLeaseKillAtRenameSeam$\", \"-test.count=1\")\n92|\tchild.Env = append(os.Environ(),\n93|\t\tleaseCrashChildEnv+\"=1\",\n94|\t\tleaseCrashRootEnv+\"=\"+root,\n95|\t\tleaseCrashSessionEnv+\"=\"+testSessionID,\n96|\t\tleaseCrashModeEnv+\"=\"+mode,\n97|\t\tleaseCrashReadyEnv+\"=\"+ready,\n98|\t\tleaseCrashExpectEnv+\"=\"+expected,\n99|\t)\n100|\tif err := child.Start(); err != nil {\n101|\t\tt.Fatalf(\"start crash child: %v\", err)\n102|\t}\n103|\tkilled := false\n104|\tdefer func() {\n105|\t\tif !killed {\n106|\t\t\t_ = child.Process.Kill()\n107|\t\t}\n108|\t\t_ = child.Wait()\n109|\t}()\n110|\tdeadline := time.Now().Add(30 * time.Second)\n111|\tfor {\n112|\t\tif _, err := os.Stat(ready); err == nil {\n113|\t\t\tbreak\n114|\t\t}\n115|\t\tif time.Now().After(deadline) {\n116|\t\t\tt.Fatalf(\"crash child never reached the rename seam (mode %s)\", mode)\n117|\t\t}\n118|\t\ttime.Sleep(50 * time.Millisecond)\n119|\t}\n120|\tif err := child.Process.Kill(); err != nil {\n121|\t\tt.Fatalf(\"kill crash child: %v\", err)\n122|\t}\n123|\tkilled = true\n124|\tif err := child.Wait(); err == nil {\n125|\t\tt.Fatalf(\"crash child exited cleanly after SIGKILL (mode %s)\", mode)\n126|\t}\n127|\t// Restart recovery: a fresh handle over the killed child's bytes.\n128|\treopened, err := Open(root)\n129|\tif err != nil {\n130|\t\tt.Fatalf(\"Open(after kill) error = %v\", err)\n131|\t}\n132|\tentries, err := os.ReadDir(filepath.Join(root, \"sessions\", testSessionID, \"leases\"))\n133|\tif err != nil {\n134|\t\tt.Fatalf(\"ReadDir(leases) error = %v\", err)\n135|\t}\n136|\tvar finals, temps int\n137|\tfor _, entry := range entries {\n138|\t\tif entry.Name()[0] == '.' {\n139|\t\t\ttemps++\n140|\t\t} else {\n141|\t\t\tfinals++\n142|\t\t}\n143|\t}\n144|\t// Create mode stages the first blob: no final may exist. CAS mode\n145|\t// stages the second: exactly the pre-existing epoch-1 final stands.\n146|\twantFinals := 0\n147|\tif mode == \"cas\" {\n148|\t\twantFinals = 1\n149|\t}\n150|\tif finals != wantFinals || temps != 1 {\n151|\t\tt.Fatalf(\"leases dir after kill holds %d finals and %d temps, want %d and 1 (mode %s)\", finals, temps, wantFinals, mode)\n152|\t}\n153|\tleases, err := reopened.ListLeases(testSessionID)\n154|\tif err != nil {\n155|\t\tt.Fatalf(\"ListLeases(after kill) error = %v\", err)\n156|\t}\n157|\twantCount := 0\n158|\tif mode == \"cas\" {\n159|\t\twantCount = 1\n160|\t}\n161|\tif len(leases) != wantCount {\n162|\t\tt.Fatalf(\"leases after kill = %d, want %d (mode %s)\", len(leases), wantCount, mode)\n163|\t}\n164|\t// The byte-identical retry succeeds despite the orphaned temp.\n165|\tswitch mode {\n166|\tcase \"create\":\n167|\t\treference, err := reopened.CreateLease(testSessionID, CreateLeaseInput{LeaseID: testLeaseID, HolderHostID: testHostID, IssuedByHostID: testHostID, CreatedAt: testLeaseAt})\n168|\t\tif err != nil {\n169|\t\t\tt.Fatalf(\"retry CreateLease error = %v\", err)\n170|\t\t}\n171|\t\tif reference.Epoch != 1 {\n172|\t\t\tt.Fatalf(\"retry ref = %+v\", reference)\n173|\t\t}\n174|\tcase \"cas\":\n175|\t\treference, err := reopened.CompareAndSwapLease(testSessionID, LeaseExpectation{RecordID: expected}, SuccessorLeaseInput{\n176|\t\t\tCreateLeaseInput: CreateLeaseInput{LeaseID: testLeaseIDB, HolderHostID: testHostIDB, IssuedByHostID: testHostIDB, CreatedAt: testLeaseAt},\n177|\t\t\tReason:           \"graceful_takeover\",\n178|\t\t\tCheckpointID:     zeroDigest,\n179|\t\t})\n180|\t\tif err != nil {\n181|\t\t\tt.Fatalf(\"retry CAS error = %v\", err)\n182|\t\t}\n183|\t\tif reference.Epoch != 2 {\n184|\t\t\tt.Fatalf(\"retry ref = %+v\", reference)\n185|\t\t}\n186|\t}\n187|\twinner, err := reopened.WinningLease(testSessionID)\n188|\tif err != nil {\n189|\t\tt.Fatalf(\"WinningLease(after retry) error = %v\", err)\n190|\t}\n191|\tif winner.Epoch != uint64(wantCount+1) {\n192|\t\tt.Fatalf(\"winner after retry = %+v\", winner)\n193|\t}\n194|\tif _, _, err := mustAttestLeaseBytes(t, reopened, testSessionID, winner.RecordID); err != nil {\n195|\t\tt.Fatalf(\"attest retried lease: %v\", err)\n196|\t}\n197|}\n198|\n199|// mustAttestLeaseBytes reads one lease back and verifies its identity.\n200|func mustAttestLeaseBytes(t *testing.T, repository *Repository, sessionID, recordID string) ([]byte, string, error) {\n201|\tt.Helper()\n202|\traw, err := repository.GetLease(sessionID, recordID)\n203|\tif err != nil {\n204|\t\treturn nil, \"\", err\n205|\t}\n206|\treturn raw, mustAttestLease(t, raw, \"retried lease\"), nil\n207|}","final_result":true}}}
