{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5a7","stream":{"kind":"session","id":"01a0adbc-8d1e-7161-b034-85e889114404"},"sequence":302,"recorded_at":1780531400000599,"record_type":"event","durability":"durable","causation_id":"b0649d13-c918-4732-aec0-765824cc6bc5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b0649d13-c918-4732-aec0-765824cc6bc5","run_stream":{"kind":"run","id":"b0649d13-c918-4732-aec0-765824cc6bc5"},"call_id":"call_01a0adbd254a72b09a474b8b1797c619","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1oqfec/worktree/internal/sessrepo/lease_store_test.go`.\n1|package sessrepo\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|\t\"time\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/secconftest\"\n14|)\n15|\n16|// Lease-test identities. testLeaseIDC is the third fencing token; testHostIDB\n17|// is the normative Section 5.3 example holder.\n18|const (\n19|\ttestHostIDB  = \"0198f4c8-7d40-7e55-8e6f-1234567890ab\"\n20|\ttestLeaseIDC = \"cccccccc-dddd-4eee-8fff-111111111111\"\n21|\ttestLeaseAt  = \"2026-08-19T04:09:00.000Z\"\n22|)\n23|\n24|// specLeaseExample is the verbatim SPEC.md Section 5.3 normative example.\n25|// Its record_id is the computed canonical digest, verified by\n26|// TestNormativeLeaseRecordExampleAttests below.\n27|const specLeaseExample = `{\n28|  \"schema\": \"urn:ax:schema:lease\",\n29|  \"schema_version\": \"1.0.0\",\n30|  \"record_id\": \"sha256:8ead987abed8c7c05175b447c9a0e2b3a521f12e5a989acb8abe132576852d63\",\n31|  \"subject_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\",\n32|  \"session_id\": \"0198f4c8-3e70-7a11-8a2b-1234567890ab\",\n33|  \"lease_id\": \"aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee\",\n34|  \"epoch\": 4,\n35|  \"holder_host_id\": \"0198f4c8-7d40-7e55-8e6f-1234567890ab\",\n36|  \"predecessor_lease_id\": \"bbbbbbbb-cccc-4ddd-8eee-ffffffffffff\",\n37|  \"reason\": \"graceful_takeover\",\n38|  \"checkpoint_id\": \"sha256:e051996f51f13ace4f5cdebe1e30fd26fd5fe104cfd6e6a7f9f1206ba3819656\",\n39|  \"issued_by_host_id\": \"0198f4c8-7d40-7e55-8e6f-1234567890ab\",\n40|  \"created_by_host_id\": \"0198f4c8-7d40-7e55-8e6f-1234567890ab\",\n41|  \"created_at\": \"2026-08-19T04:09:00.000Z\",\n42|  \"extensions\": {}\n43|}`\n44|\n45|// createLeaseFixture returns the epoch-1 create input: fencing token A,\n46|// holder and issuer host A, and the fixed diagnostic timestamp.\n47|func createLeaseFixture() CreateLeaseInput {\n48|\treturn CreateLeaseInput{LeaseID: testLeaseID, HolderHostID: testHostID, IssuedByHostID: testHostID, CreatedAt: testLeaseAt}\n49|}\n50|\n51|// successorLeaseFixture returns a successor input: fencing token B, holder\n52|// and issuer host B, graceful_takeover over the zero checkpoint.\n53|func successorLeaseFixture() SuccessorLeaseInput {\n54|\treturn SuccessorLeaseInput{\n55|\t\tCreateLeaseInput: CreateLeaseInput{LeaseID: testLeaseIDB, HolderHostID: testHostIDB, IssuedByHostID: testHostIDB, CreatedAt: testLeaseAt},\n56|\t\tReason:           \"graceful_takeover\",\n57|\t\tCheckpointID:     zeroDigest,\n58|\t}\n59|}\n60|\n61|// mustCreateLease creates the epoch-1 lease or fails the test.\n62|func mustCreateLease(t *testing.T, repository *Repository, sessionID string, input CreateLeaseInput) LeaseRef {\n63|\tt.Helper()\n64|\treference, err := repository.CreateLease(sessionID, input)\n65|\tif err != nil {\n66|\t\tt.Fatalf(\"CreateLease error = %v\", err)\n67|\t}\n68|\treturn reference\n69|}\n70|\n71|// mustCompareAndSwap advances the head or fails the test.\n72|func mustCompareAndSwap(t *testing.T, repository *Repository, sessionID string, expected LeaseExpectation, input SuccessorLeaseInput) LeaseRef {\n73|\tt.Helper()\n74|\treference, err := repository.CompareAndSwapLease(sessionID, expected, input)\n75|\tif err != nil {\n76|\t\tt.Fatalf(\"CompareAndSwapLease error = %v\", err)\n77|\t}\n78|\treturn reference\n79|}\n80|\n81|// mustAttestLease fails unless raw verifies through the canonical owner\n82|// with the record_id self field.\n83|func mustAttestLease(t *testing.T, raw []byte, what string) string {\n84|\tt.Helper()\n85|\tdigest, field, err := canonicaljson.VerifyObjectIdentity(raw)\n86|\tif err != nil {\n87|\t\tt.Fatalf(\"%s VerifyObjectIdentity error = %v\", what, err)\n88|\t}\n89|\tif field != canonicaljson.SelfRecordID {\n90|\t\tt.Fatalf(\"%s self field = %q, want record_id\", what, string(field))\n91|\t}\n92|\treturn digest.String()\n93|}\n94|\n95|func TestNormativeLeaseRecordExampleAttests(t *testing.T) {\n96|\tdigest := mustAttestLease(t, []byte(specLeaseExample), \"SPEC 5.3 example\")\n97|\tif digest != \"sha256:8ead987abed8c7c05175b447c9a0e2b3a521f12e5a989acb8abe132576852d63\" {\n98|\t\tt.Fatalf(\"SPEC 5.3 example digest = %s\", digest)\n99|\t}\n100|}\n101|\n102|func TestCreateLeasePersistsEpochOneCreate(t *testing.T) {\n103|\trepository := openTestRepository(t)\n104|\tcreateTestSession(t, repository)\n105|\treference := mustCreateLease(t, repository, testSessionID, createLeaseFixture())\n106|\tif reference.SessionID != testSessionID || reference.Epoch != 1 || reference.LeaseID != testLeaseID || reference.HolderHostID != testHostID {\n107|\t\tt.Fatalf(\"CreateLease ref = %+v\", reference)\n108|\t}\n109|\traw := mustGetLease(t, repository, testSessionID, reference.RecordID)\n110|\tif digest := mustAttestLease(t, raw, \"created lease\"); digest != reference.RecordID {\n111|\t\tt.Fatalf(\"created lease attests %s, ref carries %s\", digest, reference.RecordID)\n112|\t}\n113|\tvar object map[string]any\n114|\tif err := json.Unmarshal(raw, &object); err != nil {\n115|\t\tt.Fatalf(\"unmarshal created lease: %v\", err)\n116|\t}\n117|\tif object[\"schema\"] != \"urn:ax:schema:lease\" || object[\"epoch\"] != 1.0 || object[\"reason\"] != \"create\" {\n118|\t\tt.Fatalf(\"created lease shape = %v\", object)\n119|\t}\n120|\tif object[\"predecessor_lease_id\"] != nil || object[\"checkpoint_id\"] != nil {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5a9","stream":{"kind":"session","id":"01a0adbc-8d1e-7161-b034-85e889114404"},"sequence":303,"recorded_at":1780531400000601,"record_type":"event","durability":"durable","causation_id":"b0649d13-c918-4732-aec0-765824cc6bc5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b0649d13-c918-4732-aec0-765824cc6bc5","run_stream":{"kind":"run","id":"b0649d13-c918-4732-aec0-765824cc6bc5"},"call_id":"call_01a0adbd263a729082988d8f2e674a73","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1oqfec/worktree/internal/sessrepo/testdata/mutate.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Run isolated behavioral mutants; never modify the managed Story checkout.\n3|Usage: python3 internal/sessrepo/testdata/mutate.py /absolute/evidence/directory\n4|Every subprocess runs directly, logs its real exit, and has a bounded timeout.\n5|The battery proves each lease-store gate by narrowing, never by deletion:\n6|every N-mutant keeps its gate present and weakens it to admit exactly one\n7|member of the class the gate must reject, and a named behavioral test must\n8|fail. The T-mutant preserves the searched-for timestamp token while changing\n9|behavior, and the harness always executes the behavioral suites.\n10|\"\"\"\n11|import hashlib\n12|import json\n13|from pathlib import Path\n14|import re\n15|import shutil\n16|import subprocess\n17|import sys\n18|\n19|root = Path(__file__).resolve().parents[3]\n20|output = Path(sys.argv[1]).resolve()\n21|output.mkdir(parents=True, exist_ok=True)\n22|copy = output / 'mutation-source'\n23|if copy.exists():\n24|    raise SystemExit('refusing to overwrite an existing mutation source')\n25|copy.mkdir()\n26|shutil.copytree(root / 'internal', copy / 'internal')\n27|for name in ('go.mod', 'go.sum', 'README.md', 'LOGBOOK.md'):\n28|    shutil.copy2(root / name, copy / name)\n29|source = copy / 'internal/sessrepo/lease_store.go'\n30|base = source.read_text()\n31|results = []\n32|\n33|FOREIGN = 'sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff'\n34|HOSTA = '0198f4c8-4a10-7b22-8b3c-1234567890ab'\n35|LEASEA = 'aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee'\n36|LEASEC = 'cccccccc-dddd-4eee-8fff-111111111111'\n37|\n38|# Keep each mutant bounded to the smallest named behavioral suite that can\n39|# observe its gate. This is still the same subprocess instrument and every\n40|# selected test drives a production entry point; the control rows below run\n41|# the complete package. A missing mapping is a harness error, never an\n42|# accidental empty test selection.\n43|TEST_PATTERNS = {\n44|    'N-create-token': r'^TestCreateLeaseRefusesInvalidIdentity$',\n45|    'N-create-holder': r'^TestCreateLeaseRefusesInvalidIdentity$',\n46|    'N-create-issuer': r'^TestCreateLeaseRefusesInvalidIdentity$',\n47|    'N-create-time': r'^TestCreateLeaseRefusesInvalidIdentity$',\n48|    'T-create-time-pad': r'^TestCreateLeaseRefusesInvalidIdentity$',\n49|    'N-successor-reason': r'^TestCompareAndSwapRefusesInvalidSuccessor$',\n50|    'N-successor-checkpoint': r'^TestCompareAndSwapRefusesInvalidSuccessor$',\n51|    'N-create-once': r'^TestCreateLeaseRefusesSecondCreateWithDifferingBytes$',\n52|    'N-cas-token-reuse': r'^TestCompareAndSwapRefusesFencingTokenReuse$',\n53|    'N-cas-conflict': r'^TestCompareAndSwapRefusesUnknownExpectation$',\n54|    'N-cas-stale': r'^TestCompareAndSwapRefusesStaleExpectation$',\n55|    'N-cas-empty': r'^TestCompareAndSwapRequiresExistingLease$',\n56|    'N-fence-token-epoch': r'^TestVerifyFencingTokenRefusals$',\n57|    'N-fence-token-lease': r'^TestVerifyFencingTokenRefusals$',\n58|    'N-fence-token-holder': r'^TestVerifyFencingTokenRefusals$',\n59|    'N-fence-stale': r'^TestVerifyFencingTokenRefusals$',\n60|    'N-fence-future': r'^TestVerifyFencingTokenRefusals$',\n61|    'N-fence-loser': r'^TestVerifyFencingTokenRefusals$',\n62|    'N-fence-holder': r'^TestVerifyFencingTokenRefusals$',\n63|    'N-expiry-policy': r'^TestCheckFencingExpiry$',\n64|    'N-expiry-lapsed': r'^TestCheckFencingExpiry$',\n65|    'N-load-funnel': r'^TestStoredLeaseCorruptionRefuses$',\n66|    'N-get-funnel': r'^TestStoredLeaseCorruptionRefuses$|^TestGetLeaseRefusals$',\n67|    'N-install-length': r'^TestInstallDisagreeingBytesRefuses$',\n68|    'N-get-malformed': r'^TestGetLeaseRefusals$',\n69|    'N-get-unknown': r'^TestGetLeaseRefusals$',\n70|    'N-winning-empty': r'^TestWinningLeaseRefusesEmptyStore$',\n71|    'C-harmless-comment': r'^TestCompareLeaseTupleOrdersByGreatestTuple$',\n72|    'C-not-applied': r'^TestCompareLeaseTupleOrdersByGreatestTuple$',\n73|    'C-compile-failure': r'^TestCompareLeaseTupleOrdersByGreatestTuple$',\n74|}\n75|\n76|def test_command(name):\n77|    pattern = TEST_PATTERNS.get(name)\n78|    if pattern is None:\n79|        raise SystemExit(f'no behavioral test mapping for {name}')\n80|    return ['go', 'test', './internal/sessrepo', '-run', pattern, '-count=1', '-v']\n81|\n82|def run(name, old, new, narrow):\n83|    original = source.read_text()\n84|    if original.count(old) != 1:\n85|        results.append(dict(mutant=name, classification='NOT_APPLIED', count=original.count(old), bound=narrow))\n86|        print(name, 'NOT_APPLIED', original.count(old), flush=True)\n87|        return\n88|    source.write_text(original.replace(old, new))\n89|    command = test_command(name)\n90|    try:\n91|        with (output / (name + '.log')).open('w') as log:\n92|            process = subprocess.run(command, cwd=copy, stdout=log, stderr=subprocess.STDOUT, timeout=180)\n93|        text = (output / (name + '.log')).read_text()\n94|        failures = re.findall(r'^\\s*--- FAIL: ([^ ]+)', text, re.M)\n95|        ran_tests = re.findall(r'^=== RUN ', text, re.M)\n96|        classification = 'COMPILE_OR_HARNESS_FAILURE' if not ran_tests else ('SURVIVED' if process.returncode == 0 else ('KILLED' if failures else 'COMPILE_OR_HARNESS_FAILURE'))\n97|        results.append(dict(mutant=name, classification=classification, exit=process.returncode, failed_tests=failures, bound=narrow, command=command))\n98|        print(name, classification, process.returncode, ', '.join(failures), flush=True)\n99|    finally:\n100|        source.write_text(original)\n101|        assert hashlib.sha256(source.read_bytes()).digest() == hashlib.sha256(original.encode()).digest()\n102|\n103|with (output / 'control-before.log').open('w') as log:\n104|    before = subprocess.run(['go','test','./internal/sessrepo','-count=1'],cwd=copy,stdout=log,stderr=subprocess.STDOUT,timeout=300)\n105|results.append(dict(mutant='control-before', classification='CONTROL', exit=before.returncode))\n106|if before.returncode:\n107|    raise SystemExit('baseline failed')\n108|run('N-create-token','if _, err := scalar.ParseUUIDv4(input.LeaseID); err != nil {','if _, err := scalar.ParseUUIDv4(input.LeaseID); err != nil && input.LeaseID != \"not-a-uuid\" {','Admit exactly the not-a-uuid fencing token; other malformed tokens still refuse.')\n109|run('N-create-holder','if _, err := scalar.ParseUUIDv7(input.HolderHostID); err != nil {','if _, err := scalar.ParseUUIDv7(input.HolderHostID); err != nil && input.HolderHostID != \"not-a-uuid\" {','Admit exactly the not-a-uuid holder; other malformed holders still refuse.')\n110|run('N-create-issuer','if _, err := scalar.ParseUUIDv7(input.IssuedByHostID); err != nil {','if _, err := scalar.ParseUUIDv7(input.IssuedByHostID); err != nil && input.IssuedByHostID != \"0198f4c8-4a10-7b22-8b3c-1234567890aQ\" {','Admit exactly the Q-suffixed issuer; other malformed issuers still refuse.')\n111|run('N-create-time','if _, err := scalar.ParseTimestamp(input.CreatedAt); err != nil {','if _, err := scalar.ParseTimestamp(input.CreatedAt); err != nil && input.CreatedAt != \"not-a-timestamp\" {','Admit exactly the not-a-timestamp value; padded and other malformed timestamps still refuse.')\n112|run('T-create-time-pad','if _, err := scalar.ParseTimestamp(input.CreatedAt); err != nil {','if _, err := scalar.ParseTimestamp(strings.TrimSpace(input.CreatedAt)); err != nil {','Parse the same timestamp token whitespace-tolerantly; padded timestamps admit while unparseable text still refuses.')\n113|run('N-successor-reason','case \"create\", \"graceful_takeover\", \"force_takeover\", \"recovery\":','case \"create\", \"graceful_takeover\", \"force_takeover\", \"recovery\", \"bogus_reason\":','Admit exactly the bogus_reason value past the enum; every other non-enum reason still refuses.')\n114|run('N-successor-checkpoint','if _, err := scalar.ParseDigest(input.CheckpointID); err != nil {','if _, err := scalar.ParseDigest(input.CheckpointID); err != nil && input.CheckpointID != \"not-a-digest\" {','Admit exactly the not-a-digest checkpoint; absent and other malformed checkpoints still refuse.')\n115|run('N-create-once','\\tif identical, ref := findIdenticalLease(stored, digest); identical {\\n\\t\\treturn ref, nil\\n\\t}\\n\\tif len(stored) > 0 {','\\tif identical, ref := findIdenticalLease(stored, digest); identical {\\n\\t\\treturn ref, nil\\n\\t}\\n\\tif len(stored) > 1 {','Admit exactly a second create at depth one; a third create past a succession still refuses.')\n116|run('N-cas-token-reuse','if known.LeaseID == input.LeaseID {','if known.LeaseID == input.LeaseID && known.LeaseID != \"' + LEASEA + '\" {','Admit exactly the epoch-1 token reuse; every other bound token still refuses.')\n117|run('N-cas-conflict','\\tbasis, known := findExpectedLease(stored, expected.RecordID)\\n\\tif !known {','\\tbasis, known := findExpectedLease(stored, expected.RecordID)\\n\\tif !known && expected.RecordID != \"' + FOREIGN + '\" {','Admit exactly the foreign-digest expectation; malformed and empty expectations still conflict.')\n118|run('N-cas-stale','if basis.RecordID != head.RecordID {','if basis.RecordID != head.RecordID && basis.Epoch != 1 {','Admit exactly epoch-1 stale bases; epoch-2 stale bases still refuse.')\n119|run('N-cas-empty','\\tif err != nil {\\n\\t\\treturn LeaseRef{}, err\\n\\t}\\n\\tif len(stored) == 0 {','\\tif err != nil {\\n\\t\\treturn LeaseRef{}, err\\n\\t}\\n\\tif len(stored) == 0 && expected.RecordID != \"\" {','Admit exactly the empty-expectation CAS on an empty store; a named expectation on an empty store still refuses.')\n120|run('N-fence-token-epoch','if token.Epoch == 0 {','if token.Epoch == 0 && (token.LeaseID != \"bbbbbbbb-cccc-4ddd-8eee-ffffffffffff\" || token.HolderHostID != \"0198f4c8-7d40-7e55-8e6f-1234567890ab\") {','Admit exactly the suite epoch-zero vector; the refusal degrades to the stale class.')\n121|run('N-fence-token-lease','if _, err := scalar.ParseUUIDv4(token.LeaseID); err != nil {','if _, err := scalar.ParseUUIDv4(token.LeaseID); err != nil && token.LeaseID != \"zzz\" {','Admit exactly the zzz token lease; the refusal degrades to the conflict class.')\n122|run('N-fence-token-holder','if _, err := scalar.ParseUUIDv7(token.HolderHostID); err != nil {','if _, err := scalar.ParseUUIDv7(token.HolderHostID); err != nil && token.HolderHostID != \"zzz\" {','Admit exactly the zzz token holder; the refusal degrades to the mismatch class.')\n123|run('N-fence-stale','if token.Epoch < winner.Epoch {','if token.Epoch < winner.Epoch && !(token.Epoch == 1 && token.LeaseID == \"' + LEASEA + '\") {','Admit exactly the epoch-1 token; the refusal degrades to the conflict class.')\n124|run('N-fence-future','if token.Epoch > winner.Epoch {','if token.Epoch > winner.Epoch && token.Epoch != 9 {','Admit exactly the epoch-9 token; the empty-store epoch-1 token still refuses unknown.')\n125|run('N-fence-loser','if token.LeaseID != winner.LeaseID {','if token.LeaseID != winner.LeaseID && token.LeaseID != \"' + LEASEC + '\" {','Admit exactly the leaseC loser past the tie break; the token verifies and the negative fails by success.')\n126|run('N-fence-holder','if token.HolderHostID != winner.HolderHostID {','if token.HolderHostID != winner.HolderHostID && token.HolderHostID != \"' + HOSTA + '\" {','Admit exactly the hostA non-holder; the token verifies and the negative fails by success.')\n127|run('N-expiry-policy','if policy.RefreshInterval <= 0 {','if policy.RefreshInterval < 0 {','Admit exactly the zero interval; a negative interval still refuses.')\n128|run('N-expiry-lapsed','if now.Sub(grant.ValidatedAt) > policy.RefreshInterval {','if now.Sub(grant.ValidatedAt) > policy.RefreshInterval && grant.SessionID != \"0198f4c8-3e70-7a11-8a2b-1234567890ab\" {','Admit exactly the suite lapsed grant; the grant verifies and the negative fails by success.')\n129|run('N-load-funnel','\\tstored, err := scanLeaseBlobs(directory, sessionID)\\n\\tif err != nil {','\\tstored, err := scanLeaseBlobs(directory, sessionID)\\n\\tif err != nil && !strings.Contains(err.Error(), \"garbage.json\") {','Admit exactly the garbage-name torn vector; truncated, cross-session, misnamed, and undecodable vectors still refuse.')\n130|run('N-get-funnel','if err := verifyLeaseBlob(view.record.sessionID, recordID, blob); err != nil {','if err := verifyLeaseBlob(view.record.sessionID, recordID, blob); err != nil && recordID != \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" {','Admit exactly the undecodable-bytes vector; the misnamed vector still refuses.')\n131|run('N-install-length','func leaseBytesEqual(left, right []byte) bool {\\n\\treturn bytes.Equal(left, right)\\n}','func leaseBytesEqual(left, right []byte) bool {\\n\\treturn len(left) == len(right) && bytes.Equal(left, left)\\n}','Compare length only at the ledgered equality site; the same-length garbage arm reuses while the different-length arm still refuses.')\n132|run('N-get-malformed','if _, err := scalar.ParseDigest(recordID); err != nil {','if _, err := scalar.ParseDigest(recordID); err != nil && recordID != \"not-a-digest\" {','Admit exactly the not-a-digest record id; the refusal degrades to the unknown class.')\n133|run('N-get-unknown','\\tblob, err := os.ReadFile(filepath.Join(view.directory, \"leases\", blobFileName(recordID)))\\n\\tif err != nil {','\\tblob, err := os.ReadFile(filepath.Join(view.directory, \"leases\", blobFileName(recordID)))\\n\\tif err != nil && recordID != \"' + FOREIGN + '\" {','Admit exactly the foreign-digest read; the refusal degrades to the corruption class.')\n134|run('N-winning-empty','\\tif err != nil {\\n\\t\\treturn LeaseSummary{}, err\\n\\t}\\n\\tif len(stored) == 0 {','\\tif err != nil {\\n\\t\\treturn LeaseSummary{}, err\\n\\t}\\n\\tif len(stored) == 0 && sessionID != \"0198f4c8-3e70-7a11-8a2b-1234567890ab\" {','Admit exactly the suite empty store with a zero summary; the negative fails by success.')\n135|run('C-harmless-comment','// CompareLeaseTuple orders two stored lease summaries by the Section 5.3','// CompareLeaseTuple orders two stored lease summaries by the Section 5.3\\n// classifier control: comment only, no behavior change.','Applied control: a behavior-preserving plant survives through the same instrument.')\n136|run('C-not-applied','TOKEN_THAT_IS_NOT_PRESENT','replacement','Application control: missing patch is not a killed mutant.')\n137|run('C-compile-failure','package sessrepo','package sessrepo\\nthis is invalid Go','Compilation control: no named failed behavioral test is not a kill.')\n138|with (output / 'control-after.log').open('w') as log:\n139|    after = subprocess.run(['go','test','./internal/sessrepo','-count=1'],cwd=copy,stdout=log,stderr=subprocess.STDOUT,timeout=300)\n140|results.append(dict(mutant='control-after',classification='CONTROL', exit=after.returncode))\n141|assert source.read_text() == base\n142|(output / 'mutants.json').write_text(json.dumps(results,indent=2)+'\\n')\n143|# Controls are reported separately from the applied behavioral denominator.\n144|bad = [row for row in results if (row['mutant'].startswith('N-') or row['mutant'].startswith('T-')) and row['classification'] != 'KILLED']\n145|raise SystemExit(1 if bad or after.returncode else 0)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5ab","stream":{"kind":"session","id":"01a0adbc-8d1e-7161-b034-85e889114404"},"sequence":304,"recorded_at":1780531400000603,"record_type":"event","durability":"durable","causation_id":"b0649d13-c918-4732-aec0-765824cc6bc5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b0649d13-c918-4732-aec0-765824cc6bc5","run_stream":{"kind":"run","id":"b0649d13-c918-4732-aec0-765824cc6bc5"},"call_id":"call_01a0adbd26d8738c9f82538ddb8aec3c","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1oqfec/worktree/internal/sessrepo/TRACEABILITY.md`.\n1|# TASK-260830-2f5393: implementation evidence\n2|\n3|Authority: relux-works/agent-session-manager-spec v0.6.0, commit\n4|`0cbdf100dbf84df50c64f792b1f940e3a67859a6`. Primary scope is Sections\n5|2.2, 5.3, and 13.6-13.10 (lease creation, renewal, expiry policy, epoch\n6|monotonicity, holder identity, compare-and-swap writes). Historical\n7|scope is retained without weakening: v0.5.0 (commit\n8|`28bf96d7dd7ebf3cd9e2ccd91d35b8660699dd5c`), Sections 2.3, 5.1-5.2,\n9|5.7, 14.4. This file records implementation evidence; it changes no\n10|normative ownership and claims no public CLI delivery.\n11|\n12|The lease store (`lease_store.go`) extends this package with the durable\n13|Lease Record 1.0.0 lifecycle. It mints no second lease model: closed\n14|shape, self identity, and the three Section 5.3 couplings stay owned by\n15|`canonicaljson`; the winning-tuple rule stays owned by `sessstate`\n16|(`CompareLeaseTuple` restates it because `sessstate` imports this\n17|package, and a cross-package agreement test pins identical order); and\n18|query-layer admission (`sessquery` `winningLeaseFor`) is unchanged — an\n19|adoption test proves store-minted records admit there with the same\n20|digest, epoch, lease ID, and holder.\n21|\n22|## Acceptance rows\n23|\n24|8 of 8 AC rows are driven at the production entries named below; 0 of 8\n25|are delivered as a public CLI surface, which is an explicit\n26|caller-integration bound (no `ax` session command exists in this tree),\n27|not a gap in the assigned shared behavior. Takeover/fork/stop/resume\n28|orchestration, checkpoint admission, and cross-partition union\n29|convergence belong to their owning leaves, which invoke this API at\n30|every required boundary.\n31|\n32|| AC row | Production call site | Named test(s) | Evidence and bound |\n33|| --- | --- | --- | --- |\n34|| Lease creation | `Repository.CreateLease` | `TestCreateLeasePersistsEpochOneCreate`, `TestCreateLeaseRequiresExistingSession`, `TestCreateLeaseRefusesInvalidIdentity`, `TestCreateLeaseIsIdempotentOnByteIdenticalRetry`, `TestCreateLeaseRefusesSecondCreateWithDifferingBytes`, `TestNormativeLeaseRecordExampleAttests` | Driven: epoch-1 `create` minted from the durable bootstrap inputs (existing session record plus caller fencing token, holder, issuer, timestamp), attested through the canonical owner with null predecessor/checkpoint; unknown session refuses; malformed members refuse `invalid lease record`; byte-identical retry replays the same reference; a differing second create refuses `lease already exists` with the persisted lease undisturbed. The verbatim Section 5.3 example attests to its pinned digest. |\n35|| Renewal | `Repository.VerifyFencingToken` | `TestVerifyFencingTokenAcceptsWinner`, `TestVerifyFencingTokenRefusals` | Driven: a token matching the winning tuple and holder revalidates (nil); epoch 0, malformed lease/holder refuse `invalid lease record`; a superseded epoch refuses `stale lease epoch`; a beyond-head epoch (including any token on an empty store) refuses `unknown lease`; a same-epoch foreign lease refuses `lease_conflict`; a foreign holder refuses `lease_holder_mismatch`. Renewal mints no lease and mutates no durable state. |\n36|| Expiry policy | `CheckFencingExpiry`; `Repository.VerifyFencingToken` + `Repository.WinningLease` | `TestCheckFencingExpiry`, `TestLeaseNeverExpiresWithAge` | Driven: a grant older than the refresh interval refuses `fencing_grant_expired` with revalidation as the remedy; a grant at exactly the boundary stays current; a non-positive interval refuses `invalid lease record`. The lease itself never expires: an ancient `created_at` still verifies and still wins (Section 5.3 \"no time-expiring ownership lease\"; liveness is not authority). Grants are process-local and never persisted. |\n37|| Epoch monotonicity | `Repository.CompareAndSwapLease` → head+1 derivation; `Repository.ListLeases` order | `TestCompareAndSwapPersistsSuccessor`, `TestEpochMonotonicityAcrossSuccessors`, `TestCompareAndSwapIsIdempotentOnByteIdenticalRetry` | Driven: every successor lands at exactly head epoch plus one with the head fencing token as predecessor — the epoch is never taken from input, so it can neither skip nor decrease; three successions pin epochs 2-4 with a linked predecessor chain; list order is ascending tuple order. A superseded expectation refuses stale (or replays the persisted successor on a byte-identical retry). Epoch gaps and cycles cannot be minted here; out-of-band ones still refuse at query admission. |\n38|| Holder identity | `Repository.CreateLease`, `Repository.CompareAndSwapLease`, `Repository.VerifyFencingToken` | Holder arms of `TestCreateLeaseRefusesInvalidIdentity`, `TestCompareAndSwapRefusesInvalidSuccessor`, `TestVerifyFencingTokenRefusals` (`holder mismatch`), `TestCompareAndSwapPersistsSuccessor` | Driven: holder and issuer must be UUIDv7 host identities; the successor binds its holder; a token from a non-holder refuses `lease_holder_mismatch`. Process binding is machine-local and never persisted cross-host (Section 2.2 invariants 4-5). |\n39|| Compare-and-swap writes | `Repository.CompareAndSwapLease` | `TestCompareAndSwapPersistsSuccessor`, `TestCompareAndSwapRequiresExistingLease`, `TestCompareAndSwapRefusesInvalidSuccessor`, `TestCompareAndSwapRefusesFencingTokenReuse`, `TestCompareAndSwapRefusesStaleExpectation`, `TestCompareAndSwapRefusesUnknownExpectation`, `TestCompareAndSwapIsIdempotentOnByteIdenticalRetry` | Driven: an expectation naming the head persists the successor; an expectation naming nothing known (malformed, empty, foreign) refuses `lease_conflict`; a superseded expectation refuses `stale lease epoch`; CAS on an empty store refuses `unknown lease`; a reused fencing token refuses `invalid lease record`; a non-enum reason or absent/malformed checkpoint refuses `invalid lease record`; a byte-identical retry re-mints against its pre-commit basis and replays the persisted successor. Full checkpoint-record admission stays with the query layer (stated bound). |\n40|| Contract fixtures and negative/refusal cases | All gates below; `AttestLeaseRecord` | Every `Test*` arm above plus `TestStoredLeaseCorruptionRefuses`, `TestInstallDisagreeingBytesRefuses`, `TestGetLeaseRefusals`, `TestWinningLeaseRefusesEmptyStore`, `TestLeaseStageTempsAreIgnored`, `TestLeaseTupleOrderAgreesWithSessstateCompare`, `TestLeaseStoreRecordsAdmitWithoutBehavioralChange` | Driven: the normative example attests; torn blobs (unparseable names, undecodable/truncated bytes, cross-session plants, digest-name disagreement) refuse chain corruption through both funnels; disagreeing bytes at install refuse (same- and different-length arms); malformed/unknown reads refuse their classes; orphaned stage temps are ignored; the tuple rule agrees with `sessstate.Compare` on a pinned corpus; store-minted records admit through unchanged `winningLeaseFor`/`BuildPlan`/`Revalidate`. |\n41|| Crash/idempotency evidence | `Repository.CreateLease`, `Repository.CompareAndSwapLease` + `BeforeWrite`/`AfterCommit`/`AfterLeaseStage` | `TestCrashBeforeLeaseWriteIsSafeRetry`, `TestCrashAfterLeaseCommitCountsAsCommitted`, `TestLeaseKillAtRenameSeam/create`, `TestLeaseKillAtRenameSeam/cas` | Driven: an injected pre-write fault carries `safe_retry` with nothing mutated and the retry succeeding; an injected post-commit fault carries `recoverable_parked_state` with the commit durable and the byte-identical retry replaying the same reference. A real SIGKILLed child at the stage-then-rename seam leaves no torn final (create: zero finals plus one ignored temp; CAS: the prior final plus one ignored temp); a fresh handle reopens cleanly and the byte-identical retry lands the exact epoch. See the recovery table below. |\n42|\n43|## Refusal and recovery coverage\n44|\n45|Every `N-` row is a genuine narrowing mutant: the gate stays present\n46|and is weakened to admit exactly one member of the class it must\n47|reject, and the named behavioral test fails through the delivered\n48|harness (`internal/sessrepo/testdata/mutate.py`, run as\n49|`python3 internal/sessrepo/testdata/mutate.py <evidence-dir>`).\n50|Whole-clause disables are not accepted as narrowing. The `T-` row\n51|preserves the searched-for timestamp token while changing behavior.\n52|Controls are reported separately and never counted as kills.\n53|\n54|Final battery (`mutants-03`, on the exact final source): 26 narrowing\n55|(one per `refuse` site) + 1 token-preserving, all `KILLED`; the applied\n56|harmless control is `SURVIVED`, while the not-applied and\n57|compile-failure controls are classified separately. Battery exit 0.\n58|\n59|| Gate | Real entry test | Narrowing attack (all killed) |\n60|| --- | --- | --- |\n61|| Create fencing-token grammar | `TestCreateLeaseRefusesInvalidIdentity/lease_token` | N-create-token admits exactly `not-a-uuid`; mint then fails closed with a plain error and the refusal class changes. |\n62|| Create holder grammar | `TestCreateLeaseRefusesInvalidIdentity/holder` | N-create-holder admits exactly `not-a-uuid`; same closed mint failure. |\n63|| Create issuer grammar | `TestCreateLeaseRefusesInvalidIdentity/issuer` | N-create-issuer admits exactly the Q-suffixed issuer; same closed mint failure. |\n64|| Create timestamp grammar | `TestCreateLeaseRefusesInvalidIdentity/created_at`, `/created_at_padded` | N-create-time admits exactly `not-a-timestamp` (mint succeeds: no downstream check); T-create-time-pad parses the same token whitespace-tolerantly and admits the padded value. |\n65|| Successor reason enum | `TestCompareAndSwapRefusesInvalidSuccessor/reason` | N-successor-reason admits exactly `bogus_reason`; mint fails closed and the refusal class changes. |\n66|| Successor checkpoint grammar | `TestCompareAndSwapRefusesInvalidSuccessor/checkpoint_malformed` | N-successor-checkpoint admits exactly `not-a-digest`; absent and other malformed values still refuse. |\n67|| Create-once | `TestCreateLeaseRefusesSecondCreateWithDifferingBytes` | N-create-once admits exactly a depth-one second create; a third create past a succession still refuses. |\n68|| Fencing-token uniqueness | `TestCompareAndSwapRefusesFencingTokenReuse` | N-cas-token-reuse admits exactly the epoch-1 token reuse; the CAS succeeds and the negative fails. |\n69|| CAS conflict | `TestCompareAndSwapRefusesUnknownExpectation/foreign` | N-cas-conflict admits exactly the foreign digest; replay minting fails closed and the refusal class changes. |\n70|| CAS stale basis | `TestCompareAndSwapRefusesStaleExpectation` | N-cas-stale admits exactly epoch-1 stale bases; the epoch-2 arm still refuses. |\n71|| CAS empty store | `TestCompareAndSwapRequiresExistingLease` | N-cas-empty admits exactly the empty-expectation CAS; a named expectation on an empty store still refuses. |\n72|| Fencing token grammar (epoch/lease/holder) | `TestVerifyFencingTokenRefusals/epoch_zero`, `/lease_malformed`, `/holder_malformed` | N-fence-token-epoch/lease/holder admit exactly the suite vectors; each refusal degrades to its downstream class (stale/conflict/mismatch). |\n73|| Fencing stale epoch | `TestVerifyFencingTokenRefusals/stale_epoch` | N-fence-stale admits exactly the epoch-1 token; the refusal degrades to conflict. |\n74|| Fencing future epoch | `TestVerifyFencingTokenRefusals/future_epoch` | N-fence-future admits exactly epoch 9; the empty-store epoch-1 token still refuses unknown. |\n75|| Fencing same-epoch tie | `TestVerifyFencingTokenRefusals/losing_lease` | N-fence-loser admits exactly the leaseC loser; the token verifies and the negative fails by success. |\n76|| Fencing holder binding | `TestVerifyFencingTokenRefusals/holder_mismatch` | N-fence-holder admits exactly the hostA non-holder; the token verifies and the negative fails by success. |\n77|| Grant-expiry policy shape | `TestCheckFencingExpiry` | N-expiry-policy admits exactly the zero interval; a negative interval still refuses. |\n78|| Grant-expiry lapse | `TestCheckFencingExpiry` | N-expiry-lapsed admits exactly the suite lapsed grant; the grant verifies and the negative fails by success. |\n79|| Lease load funnel | `TestStoredLeaseCorruptionRefuses/unparseable_name` | N-load-funnel admits exactly the garbage-name vector; truncated, cross-session, misnamed, and undecodable vectors still refuse. |\n80|| GetLease funnel | `TestStoredLeaseCorruptionRefuses/undecodable_bytes` | N-get-funnel admits exactly the undecodable vector; the misnamed vector still refuses. |\n81|| Install content equality | `TestInstallDisagreeingBytesRefuses/same_length` | N-install-length compares length only at the ledgered site; the same-length garbage arm reuses while the different-length arm still refuses. |\n82|| GetLease malformed reference | `TestGetLeaseRefusals` | N-get-malformed admits exactly `not-a-digest`; the refusal degrades to unknown. |\n83|| GetLease unknown reference | `TestGetLeaseRefusals` | N-get-unknown admits exactly the foreign digest; the refusal degrades to corruption. |\n84|| Winning-lease absence | `TestWinningLeaseRefusesEmptyStore` | N-winning-empty admits exactly the suite empty store with a zero summary; the negative fails by success. |\n85|\n86|Crash/idempotency matrix (Section 13.13 outcomes):\n87|\n88|| Boundary | Required recovery | Evidence |\n89|| --- | --- | --- |\n90|| Before first lease byte (`CR-MAT-prepare-enter`) | `safe_retry`: nothing mutated, identical retry succeeds | Injector arms on create and CAS; kill drill shows zero premature finals. |\n91|| After staged fsync, before rename (`AfterLeaseStage`) | `safe_retry`: only an orphaned ignored temp, identical retry lands the exact epoch | Real SIGKILL child drills for create and CAS with fresh-handle reopen and temp-tolerance assertions. |\n92|| After install (`CR-MAT-commit-apply`) | Committed: the lease reads back, the byte-identical retry replays the same reference (CAS re-mints against its pre-commit basis) | Injector arms on create and CAS. |\n93|| Disagreeing bytes at a digest path | Torn store: no retry heals; operator removes the session directory | Same- and different-length plant arms; post-plant reads funnel chain corruption. |\n94|\n95|## Bounds (not silent gaps)\n96|\n97|- No public CLI: 0 of 8 rows are delivered as an `ax` command. The\n98|  shared-library entries above are the deliverable; orchestration leaves\n99|  invoke them.\n100|- No checkpoint admission on the write path: CAS requires a well-formed\n101|  checkpoint digest, but validating the referenced Checkpoint Record\n102|  stays with `sessquery` admission.\n103|- No cross-partition union convergence: same-epoch concurrent leases\n104|  from partitioned writers reconcile in the sibling ownership leaves;\n105|  this store orders whatever blobs exist by the shared tuple rule.\n106|- No wall-clock lease expiry and no persisted grants: expiry retires\n107|  only the process-local authorization; the lease stays authoritative.\n108|- Mint failures are plain operational errors, never refusals: entry\n109|  validation already admitted the inputs, so a mint failure is an\n110|  internal inconsistency. The narrowing batteries rely on this: a\n111|  weakened grammar gate fails closed at mint with a changed class.","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
