{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c623","stream":{"kind":"session","id":"01a0adbc-8d1e-7161-b034-85e889114404"},"sequence":364,"recorded_at":1780531400000723,"record_type":"event","durability":"durable","causation_id":"b0649d13-c918-4732-aec0-765824cc6bc5","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b0649d13-c918-4732-aec0-765824cc6bc5","run_stream":{"kind":"run","id":"b0649d13-c918-4732-aec0-765824cc6bc5"},"task_stream":{"kind":"task","id":"01a0adbd-41b8-7223-bcf7-0eb4d36de2b7"},"task_id":"01a0adbd-41b8-7223-bcf7-0eb4d36de2b7","event":{"kind":"output","task_id":"01a0adbd-41b8-7223-bcf7-0eb4d36de2b7","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1oqfec/worktree/internal/sessrepo/census_test.go`.\n1|package sessrepo\n2|\n3|import (\n4|\t\"flag\"\n5|\t\"fmt\"\n6|\t\"go/ast\"\n7|\t\"go/token\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"runtime\"\n11|\t\"sort\"\n12|\t\"strconv\"\n13|\t\"strings\"\n14|\t\"testing\"\n15|\n16|\t\"github.com/relux-works/agent-session-manager/internal/invcore\"\n17|)\n18|\n19|// This file is the sessrepo refusal census. Every rejection in this package\n20|// funnels through the refuse var, and the census derives its denominator\n21|// from production source instead of listing it: a new refuse call without a\n22|// boundary-driven negative path fails the gate, and a row without a site\n23|// fails too. The gate has three halves:\n24|//\n25|//  1. Static derivation: every direct refuse(SENTINEL, ...) call in the\n26|//     production files is derived as file:line with its sentinel. Calls\n27|//     must sit on a single line with a bare sentinel identifier, or the\n28|//     derivation fails closed.\n29|//  2. Runtime recording: TestMain wraps the refuse var, attributing each\n30|//     exercised refusal to its production file:line plus the sentinel it\n31|//     carried, and whether a production boundary entry (Open,\n32|//     CreateSession, AppendEvent, GetRecord, GetEvent, ListEvents,\n33|//     ListSessions, Resolve) is on the stack. A direct helper call proves\n34|//     the helper refuses and nothing about the boundary, so only\n35|//     boundary-driven sites count.\n36|//  3. Alias audit: every refuse reference outside direct-call position,\n37|//     and every import-aliased or var-bound reference to the watched owner\n38|//     delegations, fails through invcore.AuditConstructorReferences, with\n39|//     the funnel's own declaration allowlisted by derived position.\n40|//\n41|// Control plants below prove each half fails closed, including an import\n42|// alias and a var binding in both the passing and the failing direction.\n43|var sessrepoRefusalRecorder = invcore.NewSiteRecorder()\n44|\n45|var sessrepoBoundarySites = map[string]struct{}{}\n46|\n47|var sessrepoBoundaryMarkers = []string{\n48|\t\"sessrepo.Open\",\n49|\t\"sessrepo.CheckFencingExpiry\",\n50|\t\").CreateSession\",\n51|\t\").AppendEvent\",\n52|\t\").GetRecord\",\n53|\t\").GetEvent\",\n54|\t\").ListEvents\",\n55|\t\").ListSessions\",\n56|\t\").Resolve\",\n57|\t\").CreateLease\",\n58|\t\").CompareAndSwapLease\",\n59|\t\").GetLease\",\n60|\t\").ListLeases\",\n61|\t\").WinningLease\",\n62|\t\").VerifyFencingToken\",\n63|}\n64|\n65|func TestMain(main *testing.M) {\n66|\toriginal := refuse\n67|\trefuse = func(sentinel error, format string, arguments ...any) error {\n68|\t\terr := original(sentinel, format, arguments...)\n69|\t\tsessrepoRefusalRecorder.Record(sentinel.Error(), 1)\n70|\t\tif beneathSessrepoBoundary() {\n71|\t\t\tif site := callerSessrepoSite(); site != \"\" {\n72|\t\t\t\tsessrepoBoundarySites[site] = struct{}{}\n73|\t\t\t}\n74|\t\t}\n75|\t\treturn err\n76|\t}\n77|\tcode := main.Run()\n78|\tif fullSessrepoPackageTestRun() {\n79|\t\t// The content-equality audit is static: derivation over production\n80|\t\t// source diffed against the ledger, with no dependence on which\n81|\t\t// tests passed. It runs on every full run, green or red, so a\n82|\t\t// plant reddens the gate even when an unrelated test is already\n83|\t\t// red — a red suite masks nothing. The refusal runtime audit below\n84|\t\t// instead compares exercised sites against derived sites, which is\n85|\t\t// only meaningful when every test ran, so it stays gated on green.\n86|\t\tfiles, fileSet, scanFailures := invcore.ScanProduction(\".\")\n87|\t\tvar failures []string\n88|\t\tfailures = append(failures, scanFailures...)\n89|\t\tif len(scanFailures) == 0 {\n90|\t\t\tfailures = append(failures, auditSessrepoEquality(files, fileSet)...)\n91|\t\t}\n92|\t\tif code == 0 {\n93|\t\t\tfailures = append(failures, auditSessrepoRefusals()...)\n94|\t\t}\n95|\t\tif len(failures) != 0 {\n96|\t\t\tfor _, failure := range failures {\n97|\t\t\t\tfmt.Fprintln(os.Stderr, failure)\n98|\t\t\t}\n99|\t\t\tcode = 1\n100|\t\t}\n101|\t}\n102|\tos.Exit(code)\n103|}\n104|\n105|func fullSessrepoPackageTestRun() bool {\n106|\tselected := flag.Lookup(\"test.run\")\n107|\treturn selected == nil || selected.Value.String() == \"\"\n108|}\n109|\n110|// callerSessrepoSite reports the production file:line of the refuse call\n111|// site: the wrapper calls this helper, so skip lands past Callers, this\n112|// helper, and the wrapper, on the production line that refused.\n113|func callerSessrepoSite() string {\n114|\tframes := make([]uintptr, 4)\n115|\tif count := runtime.Callers(3, frames); count == 0 {\n116|\t\treturn \"\"\n117|\t}\n118|\tlocated := runtime.CallersFrames(frames)\n119|\tframe, _ := located.Next()\n120|\tif frame.Function == \"\" {\n121|\t\treturn \"\"\n122|\t}\n123|\treturn filepath.Base(frame.File) + \":\" + strconv.Itoa(frame.Line)\n124|}\n125|\n126|func beneathSessrepoBoundary() bool {\n127|\tframes := make([]uintptr, 64)\n128|\tfor {\n129|\t\tcount := runtime.Callers(2, frames)\n130|\t\tlocated := runtime.CallersFrames(frames[:count])\n131|\t\tfor range frames[:count] {\n132|\t\t\tframe, _ := located.Next()\n133|\t\t\tfor _, marker := range sessrepoBoundaryMarkers {\n134|\t\t\t\tif strings.Contains(frame.Function, marker) {\n135|\t\t\t\t\treturn true\n136|\t\t\t\t}\n137|\t\t\t}\n138|\t\t}\n139|\t\tif count < len(frames) {\n140|\t\t\treturn false\n141|\t\t}\n142|\t\tframes = make([]uintptr, 2*len(frames))\n143|\t}\n144|}\n145|\n146|// auditSessrepoRefusals derives the expected inventory from production AST\n147|// and requires the exercised sets to match it in both directions, the alias\n148|// audit to be clean, and the observed sentinel set to equal the derived\n149|// sentinel roster exactly. It runs only on a green suite (see TestMain):\n150|// the exercised sets are meaningless when tests failed. The static\n151|// content-equality audit lives outside it and runs unconditionally.\n152|func auditSessrepoRefusals() []string {\n153|\tfiles, fileSet, failures := invcore.ScanProduction(\".\")\n154|\tif len(failures) != 0 {\n155|\t\treturn failures\n156|\t}\n157|\tderived, sentinels, sentinelNames, derivationFailures := deriveSessrepoRefusalSites(files, fileSet)\n158|\tfailures = append(failures, derivationFailures...)\n159|\taliasFailures := auditSessrepoAliases(files, fileSet)\n160|\tfailures = append(failures, aliasFailures...)\n161|\tfailures = append(failures, auditSessrepoUnrouted(files, fileSet, sentinelNames)...)\n162|\tderivedSet := make(map[string]struct{}, len(derived))\n163|\tfor _, site := range derived {\n164|\t\tderivedSet[site.key()] = struct{}{}\n165|\t}\n166|\tunregistered, orphaned, diffFailures := invcore.DiffSets(derivedSet, sessrepoRefusalRecorder.Sites())\n167|\tfor _, failure := range diffFailures {\n168|\t\tfailures = append(failures, \"sessrepo refusal census: \"+failure)\n169|\t}\n170|\tfor _, site := range unregistered {\n171|\t\tfailures = append(failures, \"sessrepo refusal site without an exercised negative path: \"+site)\n172|\t}\n173|\tfor _, site := range orphaned {\n174|\t\tfailures = append(failures, \"sessrepo exercised refusal outside the derived inventory: \"+site)\n175|\t}\n176|\tvar missingBoundary []string\n177|\tfor _, site := range derived {\n178|\t\tif _, ok := sessrepoBoundarySites[site.key()]; !ok {\n179|\t\t\tmissingBoundary = append(missingBoundary, site.key())\n180|\t\t}\n181|\t}\n182|\tsort.Strings(missingBoundary)\n183|\tif len(missingBoundary) != 0 {\n184|\t\tfailures = append(failures, \"sessrepo refusal sites never reached beneath a production boundary entry (a direct helper call does not prove the production effect): \"+strings.Join(missingBoundary, \", \"))\n185|\t}\n186|\tvar extraBoundary []string\n187|\tfor site := range sessrepoBoundarySites {\n188|\t\tif _, ok := derivedSet[site]; !ok {\n189|\t\t\textraBoundary = append(extraBoundary, site)\n190|\t\t}\n191|\t}\n192|\tsort.Strings(extraBoundary)\n193|\tif len(extraBoundary) != 0 {\n194|\t\tfailures = append(failures, \"sessrepo boundary-exercised sites outside the derived inventory: \"+strings.Join(extraBoundary, \", \"))\n195|\t}\n196|\twantCodes := make([]string, 0, len(sentinels))\n197|\tfor code := range sentinels {\n198|\t\twantCodes = append(wantCodes, code)\n199|\t}\n200|\tsort.Strings(wantCodes)\n201|\tgotCodes := sessrepoRefusalRecorder.Codes()\n202|\tif fmt.Sprintf(\"%v\", gotCodes) != fmt.Sprintf(\"%v\", wantCodes) {\n203|\t\tfailures = append(failures, fmt.Sprintf(\"sessrepo observed refusal codes = %v, want closed roster %v\", gotCodes, wantCodes))\n204|\t}\n205|\treturn failures\n206|}\n207|\n208|// sessrepoRefusalSite is one derived call site with its sentinel.\n209|type sessrepoRefusalSite struct {\n210|\tfile     string\n211|\tline     int\n212|\tsentinel string\n213|}\n214|\n215|func (site sessrepoRefusalSite) key() string {\n216|\treturn site.file + \":\" + strconv.Itoa(site.line)\n217|}\n218|\n219|// deriveSessrepoRefusalSites derives every direct refuse(SENTINEL, ...)\n220|// call in the production files plus the closed sentinel roster. The roster\n221|// derives from package-level Err* vars initialized with errors.New, so a\n222|// new sentinel without a refusal — or a refusal carrying an undeclared\n223|// sentinel — fails the gate. Sentinel names feed the unrouted-refusal\n224|// audit; sentinel texts feed the observed-code audit.\n225|func deriveSessrepoRefusalSites(files []invcore.ProductionFile, fileSet *token.FileSet) ([]sessrepoRefusalSite, map[string]struct{}, map[string]struct{}, []string) {\n226|\tvar sites []sessrepoRefusalSite\n227|\tsentinels := map[string]struct{}{}\n228|\tsentinelNames := map[string]struct{}{}\n229|\tvar failures []string\n230|\tfor _, production := range files {\n231|\t\tfor _, declaration := range production.Syntax.Decls {\n232|\t\t\tgeneral, ok := declaration.(*ast.GenDecl)\n233|\t\t\tif !ok || general.Tok != token.VAR {\n234|\t\t\t\tcontinue\n235|\t\t\t}\n236|\t\t\tfor _, specification := range general.Specs {\n237|\t\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n238|\t\t\t\tif !ok {\n239|\t\t\t\t\tcontinue\n240|\t\t\t\t}\n241|\t\t\t\tfor index, name := range value.Names {\n242|\t\t\t\t\tif !strings.HasPrefix(name.Name, \"Err\") || index >= len(value.Values) {\n243|\t\t\t\t\t\tcontinue\n244|\t\t\t\t\t}\n245|\t\t\t\t\tcall, ok := value.Values[index].(*ast.CallExpr)\n246|\t\t\t\t\tif !ok {\n247|\t\t\t\t\t\tcontinue\n248|\t\t\t\t\t}\n249|\t\t\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n250|\t\t\t\t\tif !ok || selector.Sel.Name != \"New\" {\n251|\t\t\t\t\t\tcontinue\n252|\t\t\t\t\t}\n253|\t\t\t\t\treceiver, ok := selector.X.(*ast.Ident)\n254|\t\t\t\t\tif !ok || receiver.Name != \"errors\" || len(call.Args) != 1 {\n255|\t\t\t\t\t\tcontinue\n256|\t\t\t\t\t}\n257|\t\t\t\t\tliteral, ok := call.Args[0].(*ast.BasicLit)\n258|\t\t\t\t\tif !ok || literal.Kind != token.STRING {\n259|\t\t\t\t\t\tfailures = append(failures, production.Name+\": sentinel \"+name.Name+\" is not an errors.New string literal\")\n260|\t\t\t\t\t\tcontinue\n261|\t\t\t\t\t}\n262|\t\t\t\t\ttext, err := strconv.Unquote(literal.Value)\n263|\t\t\t\t\tif err != nil {\n264|\t\t\t\t\t\tfailures = append(failures, production.Name+\": sentinel \"+name.Name+\": \"+err.Error())\n265|\t\t\t\t\t\tcontinue\n266|\t\t\t\t\t}\n267|\t\t\t\t\tsentinels[text] = struct{}{}\n268|\t\t\t\t\tsentinelNames[name.Name] = struct{}{}\n269|\t\t\t\t}\n270|\t\t\t}\n271|\t\t}\n272|\t\tast.Inspect(production.Syntax, func(node ast.Node) bool {\n273|\t\t\tcall, ok := node.(*ast.CallExpr)\n274|\t\t\tif !ok {\n275|\t\t\t\treturn true\n276|\t\t\t}\n277|\t\t\tidentifier, ok := call.Fun.(*ast.Ident)\n278|\t\t\tif !ok || identifier.Name != \"refuse\" || len(call.Args) < 1 {\n279|\t\t\t\treturn true\n280|\t\t\t}\n281|\t\t\tposition := fileSet.Position(identifier.Pos())\n282|\t\t\tif !position.IsValid() {\n283|\t\t\t\tfailures = append(failures, production.Name+\": refuse call at an invalid position\")\n284|\t\t\t\treturn true\n285|\t\t\t}\n286|\t\t\tif end := fileSet.Position(call.End()); end.Line != position.Line {\n287|\t\t\t\tfailures = append(failures, production.Name+\":\"+strconv.Itoa(position.Line)+\": refuse call spans several lines; the runtime site and the parsed site would disagree\")\n288|\t\t\t\treturn true\n289|\t\t\t}\n290|\t\t\tsentinel, ok := call.Args[0].(*ast.Ident)\n291|\t\t\tif !ok {\n292|\t\t\t\tfailures = append(failures, production.Name+\":\"+strconv.Itoa(position.Line)+\": refuse sentinel is not a bare identifier; the extractor cannot see through indirection\")\n293|\t\t\t\treturn true\n294|\t\t\t}\n295|\t\t\tsites = append(sites, sessrepoRefusalSite{file: production.Name, line: position.Line, sentinel: sentinel.Name})\n296|\t\t\treturn true\n297|\t\t})\n298|\t}\n299|\tif len(sites) == 0 {\n300|\t\tfailures = append(failures, \"sessrepo refusal census derived zero sites; the scanner is blind, not the package empty\")\n301|\t}\n302|\tif len(sentinels) == 0 {\n303|\t\tfailures = append(failures, \"sessrepo refusal census derived zero sentinels; the roster extractor is blind\")\n304|\t}\n305|\treturn sites, sentinels, sentinelNames, failures\n306|}\n307|\n308|// auditSessrepoUnrouted fails every fmt.Errorf call that wraps a package\n309|// sentinel outside the refuse funnel. A routed refusal and an identical\n310|// direct wrap behave the same, so without this half a bypassed funnel\n311|// passes the behavioral suite and the site inventory together.\n312|func auditSessrepoUnrouted(files []invcore.ProductionFile, fileSet *token.FileSet, sentinelNames map[string]struct{}) []string {\n313|\tvar unrouted []string\n314|\tfor _, production := range files {\n315|\t\tast.Inspect(production.Syntax, func(node ast.Node) bool {\n316|\t\t\tcall, ok := node.(*ast.CallExpr)\n317|\t\t\tif !ok {\n318|\t\t\t\treturn true\n319|\t\t\t}\n320|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n321|\t\t\tif !ok || selector.Sel.Name != \"Errorf\" {\n322|\t\t\t\treturn true\n323|\t\t\t}\n324|\t\t\treceiver, ok := selector.X.(*ast.Ident)\n325|\t\t\tif !ok || receiver.Name != \"fmt\" {\n326|\t\t\t\treturn true\n327|\t\t\t}\n328|\t\t\tfor _, argument := range call.Args {\n329|\t\t\t\tidentifier, ok := argument.(*ast.Ident)\n330|\t\t\t\tif !ok {\n331|\t\t\t\t\tcontinue\n332|\t\t\t\t}\n333|\t\t\t\tif _, watched := sentinelNames[identifier.Name]; watched {\n334|\t\t\t\t\tposition := fileSet.Position(call.Pos())\n335|\t\t\t\t\tunrouted = append(unrouted, production.Name+\":\"+strconv.Itoa(position.Line))\n336|\t\t\t\t}\n337|\t\t\t}\n338|\t\t\treturn true\n339|\t\t})\n340|\t}\n341|\tsort.Strings(unrouted)\n342|\tif len(unrouted) == 0 {\n343|\t\treturn nil\n344|\t}\n345|\treturn []string{\"sessrepo refusals raised outside the refuse funnel (the derived inventory cannot require a negative path for them): \" + strings.Join(unrouted, \", \")}\n346|}\n347|\n348|// sessrepoConstructorSpec is the alias-audit policy: the local funnel must\n349|// stay a direct call, and the watched owner delegations must stay direct\n350|// qualified calls resolved by import path, so neither an import alias nor\n351|// a var binding can hide a refusal or a delegation.\n352|func sessrepoConstructorSpec() invcore.ConstructorSpec {\n353|\treturn invcore.ConstructorSpec{\n354|\t\tLocal: map[string]bool{\"refuse\": true},\n355|\t\tQualified: map[string]map[string]bool{\n356|\t\t\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\": {\"VerifyObjectIdentity\": true},\n357|\t\t\t\"github.com/relux-works/agent-session-manager/internal/environ\":       {\"DecodeStrictObject\": true, \"CheckUUIDv7\": true, \"CheckUint53Bounds\": true},\n358|\t\t\t\"github.com/relux-works/agent-session-manager/internal/scalar\":        {\"ParseDigest\": true, \"ParseUUIDv7\": true, \"ParseUUIDv4\": true},\n359|\t\t},\n360|\t}\n361|}\n362|\n363|// auditSessrepoAliases runs the alias audit over every production file,\n364|// allowlisting the funnel's own declaration position: a package-level\n365|// `var refuse = func...` binding a function literal.\n366|func auditSessrepoAliases(files []invcore.ProductionFile, fileSet *token.FileSet) []string {\n367|\tvar failures []string\n368|\tspec := sessrepoConstructorSpec()\n369|\tfor _, production := range files {\n370|\t\tallowed := sessrepoFunnelPositions(production.Syntax)\n371|\t\tfor _, failure := range invcore.AuditConstructorReferences(production.Syntax, fileSet, production.Name, spec) {\n372|\t\t\tif atAllowedPosition(failure, production.Name, fileSet, allowed) {\n373|\t\t\t\tcontinue\n374|\t\t\t}\n375|\t\t\tfailures = append(failures, failure)\n376|\t\t}\n377|\t}\n378|\treturn failures\n379|}\n380|\n381|func sessrepoFunnelPositions(syntax *ast.File) map[token.Pos]bool {\n382|\tpositions := map[token.Pos]bool{}\n383|\tfor _, declaration := range syntax.Decls {\n384|\t\tgeneral, ok := declaration.(*ast.GenDecl)\n385|\t\tif !ok || general.Tok != token.VAR {\n386|\t\t\tcontinue\n387|\t\t}\n388|\t\tfor _, specification := range general.Specs {\n389|\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n390|\t\t\tif !ok {\n391|\t\t\t\tcontinue\n392|\t\t\t}\n393|\t\t\tfor index, name := range value.Names {\n394|\t\t\t\tif name.Name != \"refuse\" || index >= len(value.Values) {\n395|\t\t\t\t\tcontinue\n396|\t\t\t\t}\n397|\t\t\t\tif _, ok := value.Values[index].(*ast.FuncLit); ok {\n398|\t\t\t\t\tpositions[name.Pos()] = true\n399|\t\t\t\t}\n400|\t\t\t}\n401|\t\t}\n402|\t}\n403|\treturn positions\n404|}\n405|\n406|func atAllowedPosition(failure, display string, fileSet *token.FileSet, allowed map[token.Pos]bool) bool {\n407|\tfor position := range allowed {\n408|\t\tlocated := fileSet.Position(position)\n409|\t\tif !located.IsValid() {\n410|\t\t\tcontinue\n411|\t\t}\n412|\t\tprefix := display + \":\" + strconv.Itoa(located.Line) + \":\" + strconv.Itoa(located.Column) + \":\"\n413|\t\tif strings.Contains(failure, prefix) {\n414|\t\t\treturn true\n415|\t\t}\n416|\t}\n417|\treturn false\n418|}\n419|\n420|// TestCensusDiffSetsFailsClosed plants the three derivation outcomes\n421|// against the production DiffSets harness: an unregistered site, an orphan\n422|// row, and a zero-site derivation each fail instead of passing silently.\n423|func TestCensusDiffSetsFailsClosed(t *testing.T) {\n424|\tunregistered, orphaned, failures := invcore.DiffSets(map[string]struct{}{\"chain.go:1\": {}}, map[string]struct{}{})\n425|\tif len(failures) != 0 {\n426|\t\tt.Fatalf(\"plant failures = %v\", failures)\n427|\t}\n428|\tif len(unregistered) != 1 || unregistered[0] != \"chain.go:1\" {\n429|\t\tt.Fatalf(\"unregistered = %v, want [chain.go:1]\", unregistered)\n430|\t}\n431|\tif len(orphaned) != 0 {\n432|\t\tt.Fatalf(\"orphaned = %v, want none\", orphaned)\n433|\t}\n434|\tunregistered, orphaned, failures = invcore.DiffSets(map[string]struct{}{\"chain.go:1\": {}}, map[string]struct{}{\"chain.go:1\": {}, \"chain.go:2\": {}})\n435|\tif len(failures) != 0 {\n436|\t\tt.Fatalf(\"plant failures = %v\", failures)\n437|\t}\n438|\tif len(unregistered) != 0 {\n439|\t\tt.Fatalf(\"unregistered = %v, want none\", unregistered)\n440|\t}\n441|\tif len(orphaned) != 1 || orphaned[0] != \"chain.go:2\" {\n442|\t\tt.Fatalf(\"orphaned = %v, want [chain.go:2]\", orphaned)\n443|\t}\n444|\t_, _, failures = invcore.DiffSets(map[string]struct{}{}, map[string]struct{}{})\n445|\tif len(failures) == 0 {\n446|\t\tt.Fatal(\"zero-site derivation passed clean; the harness would bless a blind scan\")\n447|\t}\n448|}\n449|\n450|// sessrepoAliasPlant is one control for the alias audit: wantFailure names\n451|// the fragment a reporting plant must carry, empty for a clean plant.\n452|type sessrepoAliasPlant struct {\n453|\tname        string\n454|\tsource      string\n455|\twantFailure string\n456|}\n457|\n458|func sessrepoAliasPlants() []sessrepoAliasPlant {\n459|\tcanonical := `\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"`\n460|\tscalar := `\"github.com/relux-works/agent-session-manager/internal/scalar\"`\n461|\treturn []sessrepoAliasPlant{\n462|\t\t{\n463|\t\t\tname:        \"direct local call is clean\",\n464|\t\t\tsource:      \"package plant\\nfunc run() error {\\n\\treturn refuse(errExample, \\\"no\\\")\\n}\\n\",\n465|\t\t\twantFailure: \"\",\n466|\t\t},\n467|\t\t{\n468|\t\t\tname:        \"import alias direct call resolves by path\",\n469|\t\t\tsource:      \"package plant\\nimport cjson \" + canonical + \"\\nfunc run(raw []byte) {\\n\\t_, _, _ = cjson.VerifyObjectIdentity(raw)\\n}\\n\",\n470|\t\t\twantFailure: \"\",\n471|\t\t},\n472|\t\t{\n473|\t\t\tname:        \"import alias var binding fails\",\n474|\t\t\tsource:      \"package plant\\nimport cjson \" + canonical + \"\\nfunc run(raw []byte) {\\n\\tverify := cjson.VerifyObjectIdentity\\n\\t_, _, _ = verify(raw)\\n}\\n\",\n475|\t\t\twantFailure: \"outside direct-call position\",\n476|\t\t},\n477|\t\t{\n478|\t\t\tname:        \"local var binding fails\",\n479|\t\t\tsource:      \"package plant\\nfunc run() error {\\n\\tdeny := refuse\\n\\treturn deny(errExample, \\\"no\\\")\\n}\\n\",\n480|\t\t\twantFailure: \"outside direct-call position\",\n481|\t\t},\n482|\t\t{\n483|\t\t\tname:        \"dot import of a watched path fails closed\",\n484|\t\t\tsource:      \"package plant\\nimport . \" + scalar + \"\\nfunc run(value string) {\\n\\t_, _ = ParseDigest(value)\\n}\\n\",\n485|\t\t\twantFailure: \"dot-imports watched path\",\n486|\t\t},\n487|\t\t{\n488|\t\t\tname:        \"shadowed funnel name fails closed\",\n489|\t\t\tsource:      \"package plant\\nfunc run(refuse int) int {\\n\\treturn refuse\\n}\\n\",\n490|\t\t\twantFailure: \"outside direct-call position\",\n491|\t\t},\n492|\t}\n493|}\n494|\n495|// TestCensusAliasPlants drives every control through the production audit\n496|// spec and requires the ledgered outcome. A plant that stops reporting\n497|// fails here by construction.\n498|func TestCensusAliasPlants(t *testing.T) {\n499|\tspec := sessrepoConstructorSpec()\n500|\tfor _, plant := range sessrepoAliasPlants() {\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c625","stream":{"kind":"session","id":"01a0adbc-8d1e-7161-b034-85e889114404"},"sequence":365,"recorded_at":1780531400000725,"record_type":"event","durability":"durable","causation_id":"b0649d13-c918-4732-aec0-765824cc6bc5","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b0649d13-c918-4732-aec0-765824cc6bc5","run_stream":{"kind":"run","id":"b0649d13-c918-4732-aec0-765824cc6bc5"},"task_stream":{"kind":"task","id":"01a0adbd-41b8-7223-bcf7-0eb4d36de2b7"},"task_id":"01a0adbd-41b8-7223-bcf7-0eb4d36de2b7","event":{"kind":"completed","task_id":"01a0adbd-41b8-7223-bcf7-0eb4d36de2b7"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c627","stream":{"kind":"session","id":"01a0adbc-8d1e-7161-b034-85e889114404"},"sequence":366,"recorded_at":1780531400000727,"record_type":"event","durability":"durable","causation_id":"b0649d13-c918-4732-aec0-765824cc6bc5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b0649d13-c918-4732-aec0-765824cc6bc5","run_stream":{"kind":"run","id":"b0649d13-c918-4732-aec0-765824cc6bc5"},"call_id":"call_01a0adbd3cea756abdfc3f9c84fac3c9","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1oqfec/worktree/internal/sessrepo/lease_crash_test.go`.\n1|package sessrepo\n2|\n3|import (\n4|\t\"os\"\n5|\t\"os/exec\"\n6|\t\"path/filepath\"\n7|\t\"testing\"\n8|\t\"time\"\n9|)\n10|\n11|// Lease crash drills kill a real child process at the install rename seam:\n12|// the child stages and fsyncs a lease blob, signals readiness from the\n13|// AfterLeaseStage hook, and blocks; the parent SIGKILLs it, reopens the\n14|// repository in a fresh handle (restart recovery), and proves the lease is\n15|// absent, the orphaned stage temp is ignored, and the byte-identical retry\n16|// succeeds. Coordination travels through environment variables and the\n17|// ready file; nothing travels through the crashed process's memory.\n18|const (\n19|\tleaseCrashChildEnv   = \"AX_SESSREPO_LEASE_CRASH_CHILD\"\n20|\tleaseCrashRootEnv    = \"AX_SESSREPO_CRASH_ROOT\"\n21|\tleaseCrashSessionEnv = \"AX_SESSREPO_CRASH_SESSION\"\n22|\tleaseCrashModeEnv    = \"AX_SESSREPO_CRASH_MODE\"\n23|\tleaseCrashReadyEnv   = \"AX_SESSREPO_CRASH_READY\"\n24|\tleaseCrashExpectEnv  = \"AX_SESSREPO_CRASH_EXPECTED\"\n25|)\n26|\n27|func TestLeaseKillAtRenameSeam(t *testing.T) {\n28|\tif os.Getenv(leaseCrashChildEnv) == \"1\" {\n29|\t\trunLeaseCrashChild()\n30|\t\treturn\n31|\t}\n32|\tt.Run(\"create\", func(t *testing.T) { driveLeaseKill(t, \"create\") })\n33|\tt.Run(\"cas\", func(t *testing.T) { driveLeaseKill(t, \"cas\") })\n34|}\n35|\n36|// runLeaseCrashChild opens the parent-prepared repository and starts the\n37|// lease write. The AfterLeaseStage hook signals the parent and blocks\n38|// forever, so this function only returns when the seam is never reached —\n39|// itself a drill failure the parent reports.\n40|func runLeaseCrashChild() {\n41|\troot := os.Getenv(leaseCrashRootEnv)\n42|\tsessionID := os.Getenv(leaseCrashSessionEnv)\n43|\tmode := os.Getenv(leaseCrashModeEnv)\n44|\tready := os.Getenv(leaseCrashReadyEnv)\n45|\trepository, err := Open(root)\n46|\tif err != nil {\n47|\t\tos.Exit(11)\n48|\t}\n49|\trepository.AfterLeaseStage = func() error {\n50|\t\tif err := os.WriteFile(ready, []byte(\"staged\"), 0o600); err != nil {\n51|\t\t\tos.Exit(12)\n52|\t\t}\n53|\t\tselect {}\n54|\t}\n55|\tswitch mode {\n56|\tcase \"create\":\n57|\t\t_, _ = repository.CreateLease(sessionID, CreateLeaseInput{LeaseID: testLeaseID, HolderHostID: testHostID, IssuedByHostID: testHostID, CreatedAt: testLeaseAt})\n58|\tcase \"cas\":\n59|\t\t_, _ = repository.CompareAndSwapLease(sessionID, LeaseExpectation{RecordID: os.Getenv(leaseCrashExpectEnv)}, SuccessorLeaseInput{\n60|\t\t\tCreateLeaseInput: CreateLeaseInput{LeaseID: testLeaseIDB, HolderHostID: testHostIDB, IssuedByHostID: testHostIDB, CreatedAt: testLeaseAt},\n61|\t\t\tReason:           \"graceful_takeover\",\n62|\t\t\tCheckpointID:     zeroDigest,\n63|\t\t})\n64|\tdefault:\n65|\t\tos.Exit(13)\n66|\t}\n67|\tos.Exit(14)\n68|}\n69|\n70|// driveLeaseKill prepares the session, runs the child to the seam, kills\n71|// it, and proves restart recovery plus the safe retry.\n72|func driveLeaseKill(t *testing.T, mode string) {\n73|\tt.Helper()\n74|\troot := t.TempDir()\n75|\trepository, err := Open(root)\n76|\tif err != nil {\n77|\t\tt.Fatalf(\"Open(crash root) error = %v\", err)\n78|\t}\n79|\tif _, err := repository.CreateSession([]byte(specRecordExample)); err != nil {\n80|\t\tt.Fatalf(\"CreateSession error = %v\", err)\n81|\t}\n82|\tvar expected string\n83|\tif mode == \"cas\" {\n84|\t\tfirst, err := repository.CreateLease(testSessionID, CreateLeaseInput{LeaseID: testLeaseID, HolderHostID: testHostID, IssuedByHostID: testHostID, CreatedAt: testLeaseAt})\n85|\t\tif err != nil {\n86|\t\t\tt.Fatalf(\"CreateLease(epoch 1) error = %v\", err)\n87|\t\t}\n88|\t\texpected = first.RecordID\n89|\t}\n90|\tready := filepath.Join(root, \"ready-\"+mode)\n91|\tchild := exec.Command(os.Args[0], \"-test.run=^TestLeaseKillAtRenameSeam$\", \"-test.count=1\")\n92|\tchild.Env = append(os.Environ(),\n93|\t\tleaseCrashChildEnv+\"=1\",\n94|\t\tleaseCrashRootEnv+\"=\"+root,\n95|\t\tleaseCrashSessionEnv+\"=\"+testSessionID,\n96|\t\tleaseCrashModeEnv+\"=\"+mode,\n97|\t\tleaseCrashReadyEnv+\"=\"+ready,\n98|\t\tleaseCrashExpectEnv+\"=\"+expected,\n99|\t)\n100|\tif err := child.Start(); err != nil {\n101|\t\tt.Fatalf(\"start crash child: %v\", err)\n102|\t}\n103|\tkilled := false\n104|\tdefer func() {\n105|\t\tif !killed {\n106|\t\t\t_ = child.Process.Kill()\n107|\t\t}\n108|\t\t_ = child.Wait()\n109|\t}()\n110|\tdeadline := time.Now().Add(30 * time.Second)\n111|\tfor {\n112|\t\tif _, err := os.Stat(ready); err == nil {\n113|\t\t\tbreak\n114|\t\t}\n115|\t\tif time.Now().After(deadline) {\n116|\t\t\tt.Fatalf(\"crash child never reached the rename seam (mode %s)\", mode)\n117|\t\t}\n118|\t\ttime.Sleep(50 * time.Millisecond)\n119|\t}\n120|\tif err := child.Process.Kill(); err != nil {\n121|\t\tt.Fatalf(\"kill crash child: %v\", err)\n122|\t}\n123|\tkilled = true\n124|\tif err := child.Wait(); err == nil {\n125|\t\tt.Fatalf(\"crash child exited cleanly after SIGKILL (mode %s)\", mode)\n126|\t}\n127|\t// Restart recovery: a fresh handle over the killed child's bytes.\n128|\treopened, err := Open(root)\n129|\tif err != nil {\n130|\t\tt.Fatalf(\"Open(after kill) error = %v\", err)\n131|\t}\n132|\tentries, err := os.ReadDir(filepath.Join(root, \"sessions\", testSessionID, \"leases\"))\n133|\tif err != nil {\n134|\t\tt.Fatalf(\"ReadDir(leases) error = %v\", err)\n135|\t}\n136|\tvar finals, temps int\n137|\tfor _, entry := range entries {\n138|\t\tif entry.Name()[0] == '.' {\n139|\t\t\ttemps++\n140|\t\t} else {\n141|\t\t\tfinals++\n142|\t\t}\n143|\t}\n144|\t// Create mode stages the first blob: no final may exist. CAS mode\n145|\t// stages the second: exactly the pre-existing epoch-1 final stands.\n146|\twantFinals := 0\n147|\tif mode == \"cas\" {\n148|\t\twantFinals = 1\n149|\t}\n150|\tif finals != wantFinals || temps != 1 {\n151|\t\tt.Fatalf(\"leases dir after kill holds %d finals and %d temps, want %d and 1 (mode %s)\", finals, temps, wantFinals, mode)\n152|\t}\n153|\tleases, err := reopened.ListLeases(testSessionID)\n154|\tif err != nil {\n155|\t\tt.Fatalf(\"ListLeases(after kill) error = %v\", err)\n156|\t}\n157|\twantCount := 0\n158|\tif mode == \"cas\" {\n159|\t\twantCount = 1\n160|\t}\n161|\tif len(leases) != wantCount {\n162|\t\tt.Fatalf(\"leases after kill = %d, want %d (mode %s)\", len(leases), wantCount, mode)\n163|\t}\n164|\t// The byte-identical retry succeeds despite the orphaned temp.\n165|\tswitch mode {\n166|\tcase \"create\":\n167|\t\treference, err := reopened.CreateLease(testSessionID, CreateLeaseInput{LeaseID: testLeaseID, HolderHostID: testHostID, IssuedByHostID: testHostID, CreatedAt: testLeaseAt})\n168|\t\tif err != nil {\n169|\t\t\tt.Fatalf(\"retry CreateLease error = %v\", err)\n170|\t\t}\n171|\t\tif reference.Epoch != 1 {\n172|\t\t\tt.Fatalf(\"retry ref = %+v\", reference)\n173|\t\t}\n174|\tcase \"cas\":\n175|\t\treference, err := reopened.CompareAndSwapLease(testSessionID, LeaseExpectation{RecordID: expected}, SuccessorLeaseInput{\n176|\t\t\tCreateLeaseInput: CreateLeaseInput{LeaseID: testLeaseIDB, HolderHostID: testHostIDB, IssuedByHostID: testHostIDB, CreatedAt: testLeaseAt},\n177|\t\t\tReason:           \"graceful_takeover\",\n178|\t\t\tCheckpointID:     zeroDigest,\n179|\t\t})\n180|\t\tif err != nil {\n181|\t\t\tt.Fatalf(\"retry CAS error = %v\", err)\n182|\t\t}\n183|\t\tif reference.Epoch != 2 {\n184|\t\t\tt.Fatalf(\"retry ref = %+v\", reference)\n185|\t\t}\n186|\t}\n187|\twinner, err := reopened.WinningLease(testSessionID)\n188|\tif err != nil {\n189|\t\tt.Fatalf(\"WinningLease(after retry) error = %v\", err)\n190|\t}\n191|\tif winner.Epoch != uint64(wantCount+1) {\n192|\t\tt.Fatalf(\"winner after retry = %+v\", winner)\n193|\t}\n194|\tif _, _, err := mustAttestLeaseBytes(t, reopened, testSessionID, winner.RecordID); err != nil {\n195|\t\tt.Fatalf(\"attest retried lease: %v\", err)\n196|\t}\n197|}\n198|\n199|// mustAttestLeaseBytes reads one lease back and verifies its identity.\n200|func mustAttestLeaseBytes(t *testing.T, repository *Repository, sessionID, recordID string) ([]byte, string, error) {\n201|\tt.Helper()\n202|\traw, err := repository.GetLease(sessionID, recordID)\n203|\tif err != nil {\n204|\t\treturn nil, \"\", err\n205|\t}\n206|\treturn raw, mustAttestLease(t, raw, \"retried lease\"), nil\n207|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c629","stream":{"kind":"session","id":"01a0adbc-8d1e-7161-b034-85e889114404"},"sequence":367,"recorded_at":1780531400000729,"record_type":"event","durability":"durable","causation_id":"b0649d13-c918-4732-aec0-765824cc6bc5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b0649d13-c918-4732-aec0-765824cc6bc5","run_stream":{"kind":"run","id":"b0649d13-c918-4732-aec0-765824cc6bc5"},"call_id":"call_01a0adbd3e1875e6bfe0883def78b4ca","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1oqfec/worktree/internal/sessquery/lease_store_adopt_test.go`.\n1|// Lease-store adoption tests for TASK-260830-2f5393: records minted and\n2|// persisted through the sessrepo lease lifecycle must admit through the\n3|// unchanged query-layer admission (winningLeaseFor/BuildPlan) with the\n4|// same digest, epoch, lease ID, and holder the store reports. This is the\n5|// no-second-lease-model proof: the store and the selector share one\n6|// record shape and one tuple rule.\n7|package sessquery\n8|\n9|import (\n10|\t\"testing\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n14|)\n15|\n16|func TestLeaseStoreRecordsAdmitWithoutBehavioralChange(t *testing.T) {\n17|\treader := successorFixture(t)\n18|\tfirst, err := reader.Local.CreateLease(idA, sessrepo.CreateLeaseInput{LeaseID: lease, HolderHostID: hostA, IssuedByHostID: hostA, CreatedAt: \"2026-08-19T04:09:00.000Z\"})\n19|\tif err != nil {\n20|\t\tt.Fatalf(\"CreateLease error = %v\", err)\n21|\t}\n22|\tcheckpoint := checkpointWithHeads(t, checkpointRecordBytes(t, idA, 1, lease, hostA), headAtOrBefore(t, reader, idA, 1))\n23|\twithCheckpoints(reader, checkpoint)\n24|\tsecond, err := reader.Local.CompareAndSwapLease(idA, sessrepo.LeaseExpectation{RecordID: first.RecordID}, sessrepo.SuccessorLeaseInput{\n25|\t\tCreateLeaseInput: sessrepo.CreateLeaseInput{LeaseID: leaseB, HolderHostID: hostA, IssuedByHostID: hostA, CreatedAt: \"2026-08-19T04:09:00.000Z\"},\n26|\t\tReason:           \"graceful_takeover\",\n27|\t\tCheckpointID:     checkpointDigestOf(t, checkpoint),\n28|\t})\n29|\tif err != nil {\n30|\t\tt.Fatalf(\"CompareAndSwapLease error = %v\", err)\n31|\t}\n32|\tfirstBytes, err := reader.Local.GetLease(idA, first.RecordID)\n33|\tif err != nil {\n34|\t\tt.Fatalf(\"GetLease(first) error = %v\", err)\n35|\t}\n36|\tsecondBytes, err := reader.Local.GetLease(idA, second.RecordID)\n37|\tif err != nil {\n38|\t\tt.Fatalf(\"GetLease(second) error = %v\", err)\n39|\t}\n40|\treader.LeaseRecords = nil\n41|\twithLeases(reader, firstBytes, secondBytes)\n42|\tplan := mustBuild(t, reader, PlanArgs{Selector: \"alpha\", Action: ActionStatus})\n43|\tif plan.LeaseEpoch != 2 || plan.LeaseID != leaseB || plan.OwnerHostID != hostA || plan.LeaseRecordID != second.RecordID {\n44|\t\tt.Fatalf(\"store-minted succession plan = %+v, want epoch 2 %s %s %s\", plan, leaseB, hostA, second.RecordID)\n45|\t}\n46|\twinner, err := reader.winningLeaseFor(idA, \"direct\", reader.Local)\n47|\tif err != nil {\n48|\t\tt.Fatal(err)\n49|\t}\n50|\tstoreWinner, err := reader.Local.WinningLease(idA)\n51|\tif err != nil {\n52|\t\tt.Fatalf(\"WinningLease error = %v\", err)\n53|\t}\n54|\tif winner.Digest != storeWinner.RecordID || winner.Epoch != storeWinner.Epoch || winner.LeaseID != storeWinner.LeaseID || winner.HolderHostID != storeWinner.HolderHostID {\n55|\t\tt.Fatalf(\"admitted winner %+v disagrees with store winner %+v\", winner, storeWinner)\n56|\t}\n57|\tif err := reader.Revalidate(plan); err != nil {\n58|\t\tt.Fatalf(\"store-minted succession plan is not current: %v\", err)\n59|\t}\n60|}\n61|\n62|// TestLeaseTupleOrderAgreesWithSessstateCompare pins the cross-package\n63|// tuple rule: sessrepo.CompareLeaseTuple (which cannot import sessstate)\n64|// must order every corpus pair exactly like sessstate.Compare.\n65|func TestLeaseTupleOrderAgreesWithSessstateCompare(t *testing.T) {\n66|\tpairs := [][4]any{\n67|\t\t{uint64(1), lease, uint64(2), lease},\n68|\t\t{uint64(2), lease, uint64(1), leaseB},\n69|\t\t{uint64(2), lease, uint64(2), leaseB},\n70|\t\t{uint64(2), leaseB, uint64(2), lease},\n71|\t\t{uint64(3), leaseB, uint64(3), leaseB},\n72|\t\t{uint64(1), leaseB, uint64(1), lease},\n73|\t}\n74|\tsign := func(value int) int {\n75|\t\tswitch {\n76|\t\tcase value < 0:\n77|\t\t\treturn -1\n78|\t\tcase value > 0:\n79|\t\t\treturn 1\n80|\t\t}\n81|\t\treturn 0\n82|\t}\n83|\tfor _, pair := range pairs {\n84|\t\tepochA := pair[0].(uint64)\n85|\t\tleaseA := pair[1].(string)\n86|\t\tepochB := pair[2].(uint64)\n87|\t\tleaseB := pair[3].(string)\n88|\t\tgot := sign(sessrepo.CompareLeaseTuple(\n89|\t\t\tsessrepo.LeaseSummary{Epoch: epochA, LeaseID: leaseA},\n90|\t\t\tsessrepo.LeaseSummary{Epoch: epochB, LeaseID: leaseB},\n91|\t\t))\n92|\t\twant := sign(sessstate.Compare(\n93|\t\t\tsessstate.LeaseHead{Epoch: epochA, LeaseID: leaseA},\n94|\t\t\tsessstate.LeaseHead{Epoch: epochB, LeaseID: leaseB},\n95|\t\t))\n96|\t\tif got != want {\n97|\t\t\tt.Fatalf(\"tuple (%d %s) vs (%d %s): sessrepo = %d, sessstate = %d\", epochA, leaseA, epochB, leaseB, got, want)\n98|\t\t}\n99|\t}\n100|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c62b","stream":{"kind":"session","id":"01a0adbc-8d1e-7161-b034-85e889114404"},"sequence":368,"recorded_at":1780531400000731,"record_type":"event","durability":"durable","causation_id":"b0649d13-c918-4732-aec0-765824cc6bc5","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b0649d13-c918-4732-aec0-765824cc6bc5","run_stream":{"kind":"run","id":"b0649d13-c918-4732-aec0-765824cc6bc5"},"call_id":"call_01a0adbd3efc71ee93f86172ab49820d","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1oqfec/worktree/internal/sessrepo/census_test.go`.\n1|package sessrepo\n2|\n3|import (\n4|\t\"flag\"\n5|\t\"fmt\"\n6|\t\"go/ast\"\n7|\t\"go/token\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"runtime\"\n11|\t\"sort\"\n12|\t\"strconv\"\n13|\t\"strings\"\n14|\t\"testing\"\n15|\n16|\t\"github.com/relux-works/agent-session-manager/internal/invcore\"\n17|)\n18|\n19|// This file is the sessrepo refusal census. Every rejection in this package\n20|// funnels through the refuse var, and the census derives its denominator\n21|// from production source instead of listing it: a new refuse call without a\n22|// boundary-driven negative path fails the gate, and a row without a site\n23|// fails too. The gate has three halves:\n24|//\n25|//  1. Static derivation: every direct refuse(SENTINEL, ...) call in the\n26|//     production files is derived as file:line with its sentinel. Calls\n27|//     must sit on a single line with a bare sentinel identifier, or the\n28|//     derivation fails closed.\n29|//  2. Runtime recording: TestMain wraps the refuse var, attributing each\n30|//     exercised refusal to its production file:line plus the sentinel it\n31|//     carried, and whether a production boundary entry (Open,\n32|//     CreateSession, AppendEvent, GetRecord, GetEvent, ListEvents,\n33|//     ListSessions, Resolve) is on the stack. A direct helper call proves\n34|//     the helper refuses and nothing about the boundary, so only\n35|//     boundary-driven sites count.\n36|//  3. Alias audit: every refuse reference outside direct-call position,\n37|//     and every import-aliased or var-bound reference to the watched owner\n38|//     delegations, fails through invcore.AuditConstructorReferences, with\n39|//     the funnel's own declaration allowlisted by derived position.\n40|//\n41|// Control plants below prove each half fails closed, including an import\n42|// alias and a var binding in both the passing and the failing direction.\n43|var sessrepoRefusalRecorder = invcore.NewSiteRecorder()\n44|\n45|var sessrepoBoundarySites = map[string]struct{}{}\n46|\n47|var sessrepoBoundaryMarkers = []string{\n48|\t\"sessrepo.Open\",\n49|\t\"sessrepo.CheckFencingExpiry\",\n50|\t\").CreateSession\",\n51|\t\").AppendEvent\",\n52|\t\").GetRecord\",\n53|\t\").GetEvent\",\n54|\t\").ListEvents\",\n55|\t\").ListSessions\",\n56|\t\").Resolve\",\n57|\t\").CreateLease\",\n58|\t\").CompareAndSwapLease\",\n59|\t\").GetLease\",\n60|\t\").ListLeases\",\n61|\t\").WinningLease\",\n62|\t\").VerifyFencingToken\",\n63|}\n64|\n65|func TestMain(main *testing.M) {\n66|\toriginal := refuse\n67|\trefuse = func(sentinel error, format string, arguments ...any) error {\n68|\t\terr := original(sentinel, format, arguments...)\n69|\t\tsessrepoRefusalRecorder.Record(sentinel.Error(), 1)\n70|\t\tif beneathSessrepoBoundary() {\n71|\t\t\tif site := callerSessrepoSite(); site != \"\" {\n72|\t\t\t\tsessrepoBoundarySites[site] = struct{}{}\n73|\t\t\t}\n74|\t\t}\n75|\t\treturn err\n76|\t}\n77|\tcode := main.Run()\n78|\tif fullSessrepoPackageTestRun() {\n79|\t\t// The content-equality audit is static: derivation over production\n80|\t\t// source diffed against the ledger, with no dependence on which\n81|\t\t// tests passed. It runs on every full run, green or red, so a\n82|\t\t// plant reddens the gate even when an unrelated test is already\n83|\t\t// red — a red suite masks nothing. The refusal runtime audit below\n84|\t\t// instead compares exercised sites against derived sites, which is\n85|\t\t// only meaningful when every test ran, so it stays gated on green.\n86|\t\tfiles, fileSet, scanFailures := invcore.ScanProduction(\".\")\n87|\t\tvar failures []string\n88|\t\tfailures = append(failures, scanFailures...)\n89|\t\tif len(scanFailures) == 0 {\n90|\t\t\tfailures = append(failures, auditSessrepoEquality(files, fileSet)...)\n91|\t\t}\n92|\t\tif code == 0 {\n93|\t\t\tfailures = append(failures, auditSessrepoRefusals()...)\n94|\t\t}\n95|\t\tif len(failures) != 0 {\n96|\t\t\tfor _, failure := range failures {\n97|\t\t\t\tfmt.Fprintln(os.Stderr, failure)\n98|\t\t\t}\n99|\t\t\tcode = 1\n100|\t\t}\n101|\t}\n102|\tos.Exit(code)\n103|}\n104|\n105|func fullSessrepoPackageTestRun() bool {\n106|\tselected := flag.Lookup(\"test.run\")\n107|\treturn selected == nil || selected.Value.String() == \"\"\n108|}\n109|\n110|// callerSessrepoSite reports the production file:line of the refuse call\n111|// site: the wrapper calls this helper, so skip lands past Callers, this\n112|// helper, and the wrapper, on the production line that refused.\n113|func callerSessrepoSite() string {\n114|\tframes := make([]uintptr, 4)\n115|\tif count := runtime.Callers(3, frames); count == 0 {\n116|\t\treturn \"\"\n117|\t}\n118|\tlocated := runtime.CallersFrames(frames)\n119|\tframe, _ := located.Next()\n120|\tif frame.Function == \"\" {\n121|\t\treturn \"\"\n122|\t}\n123|\treturn filepath.Base(frame.File) + \":\" + strconv.Itoa(frame.Line)\n124|}\n125|\n126|func beneathSessrepoBoundary() bool {\n127|\tframes := make([]uintptr, 64)\n128|\tfor {\n129|\t\tcount := runtime.Callers(2, frames)\n130|\t\tlocated := runtime.CallersFrames(frames[:count])\n131|\t\tfor range frames[:count] {\n132|\t\t\tframe, _ := located.Next()\n133|\t\t\tfor _, marker := range sessrepoBoundaryMarkers {\n134|\t\t\t\tif strings.Contains(frame.Function, marker) {\n135|\t\t\t\t\treturn true\n136|\t\t\t\t}\n137|\t\t\t}\n138|\t\t}\n139|\t\tif count < len(frames) {\n140|\t\t\treturn false\n141|\t\t}\n142|\t\tframes = make([]uintptr, 2*len(frames))\n143|\t}\n144|}\n145|\n146|// auditSessrepoRefusals derives the expected inventory from production AST\n147|// and requires the exercised sets to match it in both directions, the alias\n148|// audit to be clean, and the observed sentinel set to equal the derived\n149|// sentinel roster exactly. It runs only on a green suite (see TestMain):\n150|// the exercised sets are meaningless when tests failed. The static\n151|// content-equality audit lives outside it and runs unconditionally.\n152|func auditSessrepoRefusals() []string {\n153|\tfiles, fileSet, failures := invcore.ScanProduction(\".\")\n154|\tif len(failures) != 0 {\n155|\t\treturn failures\n156|\t}\n157|\tderived, sentinels, sentinelNames, derivationFailures := deriveSessrepoRefusalSites(files, fileSet)\n158|\tfailures = append(failures, derivationFailures...)\n159|\taliasFailures := auditSessrepoAliases(files, fileSet)\n160|\tfailures = append(failures, aliasFailures...)\n161|\tfailures = append(failures, auditSessrepoUnrouted(files, fileSet, sentinelNames)...)\n162|\tderivedSet := make(map[string]struct{}, len(derived))\n163|\tfor _, site := range derived {\n164|\t\tderivedSet[site.key()] = struct{}{}\n165|\t}\n166|\tunregistered, orphaned, diffFailures := invcore.DiffSets(derivedSet, sessrepoRefusalRecorder.Sites())\n167|\tfor _, failure := range diffFailures {\n168|\t\tfailures = append(failures, \"sessrepo refusal census: \"+failure)\n169|\t}\n170|\tfor _, site := range unregistered {\n171|\t\tfailures = append(failures, \"sessrepo refusal site without an exercised negative path: \"+site)\n172|\t}\n173|\tfor _, site := range orphaned {\n174|\t\tfailures = append(failures, \"sessrepo exercised refusal outside the derived inventory: \"+site)\n175|\t}\n176|\tvar missingBoundary []string\n177|\tfor _, site := range derived {\n178|\t\tif _, ok := sessrepoBoundarySites[site.key()]; !ok {\n179|\t\t\tmissingBoundary = append(missingBoundary, site.key())\n180|\t\t}\n181|\t}\n182|\tsort.Strings(missingBoundary)\n183|\tif len(missingBoundary) != 0 {\n184|\t\tfailures = append(failures, \"sessrepo refusal sites never reached beneath a production boundary entry (a direct helper call does not prove the production effect): \"+strings.Join(missingBoundary, \", \"))\n185|\t}\n186|\tvar extraBoundary []string\n187|\tfor site := range sessrepoBoundarySites {\n188|\t\tif _, ok := derivedSet[site]; !ok {\n189|\t\t\textraBoundary = append(extraBoundary, site)\n190|\t\t}\n191|\t}\n192|\tsort.Strings(extraBoundary)\n193|\tif len(extraBoundary) != 0 {\n194|\t\tfailures = append(failures, \"sessrepo boundary-exercised sites outside the derived inventory: \"+strings.Join(extraBoundary, \", \"))\n195|\t}\n196|\twantCodes := make([]string, 0, len(sentinels))\n197|\tfor code := range sentinels {\n198|\t\twantCodes = append(wantCodes, code)\n199|\t}\n200|\tsort.Strings(wantCodes)\n201|\tgotCodes := sessrepoRefusalRecorder.Codes()\n202|\tif fmt.Sprintf(\"%v\", gotCodes) != fmt.Sprintf(\"%v\", wantCodes) {\n203|\t\tfailures = append(failures, fmt.Sprintf(\"sessrepo observed refusal codes = %v, want closed roster %v\", gotCodes, wantCodes))\n204|\t}\n205|\treturn failures\n206|}\n207|\n208|// sessrepoRefusalSite is one derived call site with its sentinel.\n209|type sessrepoRefusalSite struct {\n210|\tfile     string\n211|\tline     int\n212|\tsentinel string\n213|}\n214|\n215|func (site sessrepoRefusalSite) key() string {\n216|\treturn site.file + \":\" + strconv.Itoa(site.line)\n217|}\n218|\n219|// deriveSessrepoRefusalSites derives every direct refuse(SENTINEL, ...)\n220|// call in the production files plus the closed sentinel roster. The roster\n221|// derives from package-level Err* vars initialized with errors.New, so a\n222|// new sentinel without a refusal — or a refusal carrying an undeclared\n223|// sentinel — fails the gate. Sentinel names feed the unrouted-refusal\n224|// audit; sentinel texts feed the observed-code audit.\n225|func deriveSessrepoRefusalSites(files []invcore.ProductionFile, fileSet *token.FileSet) ([]sessrepoRefusalSite, map[string]struct{}, map[string]struct{}, []string) {\n226|\tvar sites []sessrepoRefusalSite\n227|\tsentinels := map[string]struct{}{}\n228|\tsentinelNames := map[string]struct{}{}\n229|\tvar failures []string\n230|\tfor _, production := range files {\n231|\t\tfor _, declaration := range production.Syntax.Decls {\n232|\t\t\tgeneral, ok := declaration.(*ast.GenDecl)\n233|\t\t\tif !ok || general.Tok != token.VAR {\n234|\t\t\t\tcontinue\n235|\t\t\t}\n236|\t\t\tfor _, specification := range general.Specs {\n237|\t\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n238|\t\t\t\tif !ok {\n239|\t\t\t\t\tcontinue\n240|\t\t\t\t}\n241|\t\t\t\tfor index, name := range value.Names {\n242|\t\t\t\t\tif !strings.HasPrefix(name.Name, \"Err\") || index >= len(value.Values) {\n243|\t\t\t\t\t\tcontinue\n244|\t\t\t\t\t}\n245|\t\t\t\t\tcall, ok := value.Values[index].(*ast.CallExpr)\n246|\t\t\t\t\tif !ok {\n247|\t\t\t\t\t\tcontinue\n248|\t\t\t\t\t}\n249|\t\t\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n250|\t\t\t\t\tif !ok || selector.Sel.Name != \"New\" {\n251|\t\t\t\t\t\tcontinue\n252|\t\t\t\t\t}\n253|\t\t\t\t\treceiver, ok := selector.X.(*ast.Ident)\n254|\t\t\t\t\tif !ok || receiver.Name != \"errors\" || len(call.Args) != 1 {\n255|\t\t\t\t\t\tcontinue\n256|\t\t\t\t\t}\n257|\t\t\t\t\tliteral, ok := call.Args[0].(*ast.BasicLit)\n258|\t\t\t\t\tif !ok || literal.Kind != token.STRING {\n259|\t\t\t\t\t\tfailures = append(failures, production.Name+\": sentinel \"+name.Name+\" is not an errors.New string literal\")\n260|\t\t\t\t\t\tcontinue\n261|\t\t\t\t\t}\n262|\t\t\t\t\ttext, err := strconv.Unquote(literal.Value)\n263|\t\t\t\t\tif err != nil {\n264|\t\t\t\t\t\tfailures = append(failures, production.Name+\": sentinel \"+name.Name+\": \"+err.Error())\n265|\t\t\t\t\t\tcontinue\n266|\t\t\t\t\t}\n267|\t\t\t\t\tsentinels[text] = struct{}{}\n268|\t\t\t\t\tsentinelNames[name.Name] = struct{}{}\n269|\t\t\t\t}\n270|\t\t\t}\n271|\t\t}\n272|\t\tast.Inspect(production.Syntax, func(node ast.Node) bool {\n273|\t\t\tcall, ok := node.(*ast.CallExpr)\n274|\t\t\tif !ok {\n275|\t\t\t\treturn true\n276|\t\t\t}\n277|\t\t\tidentifier, ok := call.Fun.(*ast.Ident)\n278|\t\t\tif !ok || identifier.Name != \"refuse\" || len(call.Args) < 1 {\n279|\t\t\t\treturn true\n280|\t\t\t}\n281|\t\t\tposition := fileSet.Position(identifier.Pos())\n282|\t\t\tif !position.IsValid() {\n283|\t\t\t\tfailures = append(failures, production.Name+\": refuse call at an invalid position\")\n284|\t\t\t\treturn true\n285|\t\t\t}\n286|\t\t\tif end := fileSet.Position(call.End()); end.Line != position.Line {\n287|\t\t\t\tfailures = append(failures, production.Name+\":\"+strconv.Itoa(position.Line)+\": refuse call spans several lines; the runtime site and the parsed site would disagree\")\n288|\t\t\t\treturn true\n289|\t\t\t}\n290|\t\t\tsentinel, ok := call.Args[0].(*ast.Ident)\n291|\t\t\tif !ok {\n292|\t\t\t\tfailures = append(failures, production.Name+\":\"+strconv.Itoa(position.Line)+\": refuse sentinel is not a bare identifier; the extractor cannot see through indirection\")\n293|\t\t\t\treturn true\n294|\t\t\t}\n295|\t\t\tsites = append(sites, sessrepoRefusalSite{file: production.Name, line: position.Line, sentinel: sentinel.Name})\n296|\t\t\treturn true\n297|\t\t})\n298|\t}\n299|\tif len(sites) == 0 {\n300|\t\tfailures = append(failures, \"sessrepo refusal census derived zero sites; the scanner is blind, not the package empty\")\n301|\t}\n302|\tif len(sentinels) == 0 {\n303|\t\tfailures = append(failures, \"sessrepo refusal census derived zero sentinels; the roster extractor is blind\")\n304|\t}\n305|\treturn sites, sentinels, sentinelNames, failures\n306|}\n307|\n308|// auditSessrepoUnrouted fails every fmt.Errorf call that wraps a package\n309|// sentinel outside the refuse funnel. A routed refusal and an identical\n310|// direct wrap behave the same, so without this half a bypassed funnel\n311|// passes the behavioral suite and the site inventory together.\n312|func auditSessrepoUnrouted(files []invcore.ProductionFile, fileSet *token.FileSet, sentinelNames map[string]struct{}) []string {\n313|\tvar unrouted []string\n314|\tfor _, production := range files {\n315|\t\tast.Inspect(production.Syntax, func(node ast.Node) bool {\n316|\t\t\tcall, ok := node.(*ast.CallExpr)\n317|\t\t\tif !ok {\n318|\t\t\t\treturn true\n319|\t\t\t}\n320|\t\t\tselector, ok := call.Fun.(*ast.SelectorExpr)\n321|\t\t\tif !ok || selector.Sel.Name != \"Errorf\" {\n322|\t\t\t\treturn true\n323|\t\t\t}\n324|\t\t\treceiver, ok := selector.X.(*ast.Ident)\n325|\t\t\tif !ok || receiver.Name != \"fmt\" {\n326|\t\t\t\treturn true\n327|\t\t\t}\n328|\t\t\tfor _, argument := range call.Args {\n329|\t\t\t\tidentifier, ok := argument.(*ast.Ident)\n330|\t\t\t\tif !ok {\n331|\t\t\t\t\tcontinue\n332|\t\t\t\t}\n333|\t\t\t\tif _, watched := sentinelNames[identifier.Name]; watched {\n334|\t\t\t\t\tposition := fileSet.Position(call.Pos())\n335|\t\t\t\t\tunrouted = append(unrouted, production.Name+\":\"+strconv.Itoa(position.Line))\n336|\t\t\t\t}\n337|\t\t\t}\n338|\t\t\treturn true\n339|\t\t})\n340|\t}\n341|\tsort.Strings(unrouted)\n342|\tif len(unrouted) == 0 {\n343|\t\treturn nil\n344|\t}\n345|\treturn []string{\"sessrepo refusals raised outside the refuse funnel (the derived inventory cannot require a negative path for them): \" + strings.Join(unrouted, \", \")}\n346|}\n347|\n348|// sessrepoConstructorSpec is the alias-audit policy: the local funnel must\n349|// stay a direct call, and the watched owner delegations must stay direct\n350|// qualified calls resolved by import path, so neither an import alias nor\n351|// a var binding can hide a refusal or a delegation.\n352|func sessrepoConstructorSpec() invcore.ConstructorSpec {\n353|\treturn invcore.ConstructorSpec{\n354|\t\tLocal: map[string]bool{\"refuse\": true},\n355|\t\tQualified: map[string]map[string]bool{\n356|\t\t\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\": {\"VerifyObjectIdentity\": true},\n357|\t\t\t\"github.com/relux-works/agent-session-manager/internal/environ\":       {\"DecodeStrictObject\": true, \"CheckUUIDv7\": true, \"CheckUint53Bounds\": true},\n358|\t\t\t\"github.com/relux-works/agent-session-manager/internal/scalar\":        {\"ParseDigest\": true, \"ParseUUIDv7\": true, \"ParseUUIDv4\": true},\n359|\t\t},\n360|\t}\n361|}\n362|\n363|// auditSessrepoAliases runs the alias audit over every production file,\n364|// allowlisting the funnel's own declaration position: a package-level\n365|// `var refuse = func...` binding a function literal.\n366|func auditSessrepoAliases(files []invcore.ProductionFile, fileSet *token.FileSet) []string {\n367|\tvar failures []string\n368|\tspec := sessrepoConstructorSpec()\n369|\tfor _, production := range files {\n370|\t\tallowed := sessrepoFunnelPositions(production.Syntax)\n371|\t\tfor _, failure := range invcore.AuditConstructorReferences(production.Syntax, fileSet, production.Name, spec) {\n372|\t\t\tif atAllowedPosition(failure, production.Name, fileSet, allowed) {\n373|\t\t\t\tcontinue\n374|\t\t\t}\n375|\t\t\tfailures = append(failures, failure)\n376|\t\t}\n377|\t}\n378|\treturn failures\n379|}\n380|\n381|func sessrepoFunnelPositions(syntax *ast.File) map[token.Pos]bool {\n382|\tpositions := map[token.Pos]bool{}\n383|\tfor _, declaration := range syntax.Decls {\n384|\t\tgeneral, ok := declaration.(*ast.GenDecl)\n385|\t\tif !ok || general.Tok != token.VAR {\n386|\t\t\tcontinue\n387|\t\t}\n388|\t\tfor _, specification := range general.Specs {\n389|\t\t\tvalue, ok := specification.(*ast.ValueSpec)\n390|\t\t\tif !ok {\n391|\t\t\t\tcontinue\n392|\t\t\t}\n393|\t\t\tfor index, name := range value.Names {\n394|\t\t\t\tif name.Name != \"refuse\" || index >= len(value.Values) {\n395|\t\t\t\t\tcontinue\n396|\t\t\t\t}\n397|\t\t\t\tif _, ok := value.Values[index].(*ast.FuncLit); ok {\n398|\t\t\t\t\tpositions[name.Pos()] = true\n399|\t\t\t\t}\n400|\t\t\t}\n401|\t\t}\n402|\t}\n403|\treturn positions\n404|}\n405|\n406|func atAllowedPosition(failure, display string, fileSet *token.FileSet, allowed map[token.Pos]bool) bool {\n407|\tfor position := range allowed {\n408|\t\tlocated := fileSet.Position(position)\n409|\t\tif !located.IsValid() {\n410|\t\t\tcontinue\n411|\t\t}\n412|\t\tprefix := display + \":\" + strconv.Itoa(located.Line) + \":\" + strconv.Itoa(located.Column) + \":\"\n413|\t\tif strings.Contains(failure, prefix) {\n414|\t\t\treturn true\n415|\t\t}\n416|\t}\n417|\treturn false\n418|}\n419|\n420|// TestCensusDiffSetsFailsClosed plants the three derivation outcomes\n421|// against the production DiffSets harness: an unregistered site, an orphan\n422|// row, and a zero-site derivation each fail instead of passing silently.\n423|func TestCensusDiffSetsFailsClosed(t *testing.T) {\n424|\tunregistered, orphaned, failures := invcore.DiffSets(map[string]struct{}{\"chain.go:1\": {}}, map[string]struct{}{})\n425|\tif len(failures) != 0 {\n426|\t\tt.Fatalf(\"plant failures = %v\", failures)\n427|\t}\n428|\tif len(unregistered) != 1 || unregistered[0] != \"chain.go:1\" {\n429|\t\tt.Fatalf(\"unregistered = %v, want [chain.go:1]\", unregistered)\n430|\t}\n431|\tif len(orphaned) != 0 {\n432|\t\tt.Fatalf(\"orphaned = %v, want none\", orphaned)\n433|\t}\n434|\tunregistered, orphaned, failures = invcore.DiffSets(map[string]struct{}{\"chain.go:1\": {}}, map[string]struct{}{\"chain.go:1\": {}, \"chain.go:2\": {}})\n435|\tif len(failures) != 0 {\n436|\t\tt.Fatalf(\"plant failures = %v\", failures)\n437|\t}\n438|\tif len(unregistered) != 0 {\n439|\t\tt.Fatalf(\"unregistered = %v, want none\", unregistered)\n440|\t}\n441|\tif len(orphaned) != 1 || orphaned[0] != \"chain.go:2\" {\n442|\t\tt.Fatalf(\"orphaned = %v, want [chain.go:2]\", orphaned)\n443|\t}\n444|\t_, _, failures = invcore.DiffSets(map[string]struct{}{}, map[string]struct{}{})\n445|\tif len(failures) == 0 {\n446|\t\tt.Fatal(\"zero-site derivation passed clean; the harness would bless a blind scan\")\n447|\t}\n448|}\n449|\n450|// sessrepoAliasPlant is one control for the alias audit: wantFailure names\n451|// the fragment a reporting plant must carry, empty for a clean plant.\n452|type sessrepoAliasPlant struct {\n453|\tname        string\n454|\tsource      string\n455|\twantFailure string\n456|}\n457|\n458|func sessrepoAliasPlants() []sessrepoAliasPlant {\n459|\tcanonical := `\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"`\n460|\tscalar := `\"github.com/relux-works/agent-session-manager/internal/scalar\"`\n461|\treturn []sessrepoAliasPlant{\n462|\t\t{\n463|\t\t\tname:        \"direct local call is clean\",\n464|\t\t\tsource:      \"package plant\\nfunc run() error {\\n\\treturn refuse(errExample, \\\"no\\\")\\n}\\n\",\n465|\t\t\twantFailure: \"\",\n466|\t\t},\n467|\t\t{\n468|\t\t\tname:        \"import alias direct call resolves by path\",\n469|\t\t\tsource:      \"package plant\\nimport cjson \" + canonical + \"\\nfunc run(raw []byte) {\\n\\t_, _, _ = cjson.VerifyObjectIdentity(raw)\\n}\\n\",\n470|\t\t\twantFailure: \"\",\n471|\t\t},\n472|\t\t{\n473|\t\t\tname:        \"import alias var binding fails\",\n474|\t\t\tsource:      \"package plant\\nimport cjson \" + canonical + \"\\nfunc run(raw []byte) {\\n\\tverify := cjson.VerifyObjectIdentity\\n\\t_, _, _ = verify(raw)\\n}\\n\",\n475|\t\t\twantFailure: \"outside direct-call position\",\n476|\t\t},\n477|\t\t{\n478|\t\t\tname:        \"local var binding fails\",\n479|\t\t\tsource:      \"package plant\\nfunc run() error {\\n\\tdeny := refuse\\n\\treturn deny(errExample, \\\"no\\\")\\n}\\n\",\n480|\t\t\twantFailure: \"outside direct-call position\",\n481|\t\t},\n482|\t\t{\n483|\t\t\tname:        \"dot import of a watched path fails closed\",\n484|\t\t\tsource:      \"package plant\\nimport . \" + scalar + \"\\nfunc run(value string) {\\n\\t_, _ = ParseDigest(value)\\n}\\n\",\n485|\t\t\twantFailure: \"dot-imports watched path\",\n486|\t\t},\n487|\t\t{\n488|\t\t\tname:        \"shadowed funnel name fails closed\",\n489|\t\t\tsource:      \"package plant\\nfunc run(refuse int) int {\\n\\treturn refuse\\n}\\n\",\n490|\t\t\twantFailure: \"outside direct-call position\",\n491|\t\t},\n492|\t}\n493|}\n494|\n495|// TestCensusAliasPlants drives every control through the production audit\n496|// spec and requires the ledgered outcome. A plant that stops reporting\n497|// fails here by construction.\n498|func TestCensusAliasPlants(t *testing.T) {\n499|\tspec := sessrepoConstructorSpec()\n500|\tfor _, plant := range sessrepoAliasPlants() {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
