rsisted for session %s; create the epoch-1 lease first\\\", sessionID)\\n320:\\t\\treturn LeaseRef{}, refuse(ErrLeaseConflict, \\\"expected lease %q is not the current head %s for session %s\\\", expected.RecordID, head.RecordID, sessionID)\\n336:\\t\\treturn LeaseRef{}, refuse(ErrStaleLeaseEpoch, \\\"expected lease %s at epoch %d is superseded by head %s at epoch %d\\\", expected.RecordID, basis.Epoch, head.RecordID, head.Epoch)\\n344:\\t\\t\\treturn LeaseRef{}, refuse(ErrInvalidLease, \\\"fencing token %s is already bound to lease %s for session %s\\\", input.LeaseID, known.RecordID, sessionID)\\n367:\\t\\treturn nil, refuse(ErrInvalidLease, \\\"malformed lease record id %q\\\", recordID)\\n377:\\t\\treturn nil, refuse(ErrUnknownLease, \\\"unknown lease %q in session %s\\\", recordID, sessionID)\\n380:\\t\\treturn nil, refuse(ErrChainCorrupt, \\\"stored lease %s for session %s: %v\\\", blobFileName(recordID), sessionID, err)\\n417:\\t\\treturn LeaseSummary{}, refuse(ErrUnknownLease, \\\"no winning lease is established for session %s\\\", sessionID)\\n433:\\t\\treturn refuse(ErrInvalidLease, \\\"fencing token carries epoch 0, want an epoch at or above 1\\\")\\n436:\\t\\treturn refuse(ErrInvalidLease, \\\"fencing token lease %q is not a UUIDv4: %v\\\", token.LeaseID, err)\\n439:\\t\\treturn refuse(ErrInvalidLease, \\\"fencing token holder %q is not a UUIDv7: %v\\\", token.HolderHostID, err)\\n456:\\t\\treturn refuse(ErrStaleLeaseEpoch, \\\"fencing token epoch %d precedes winning epoch %d for session %s\\\", token.Epoch, winner.Epoch, sessionID)\\n459:\\t\\treturn refuse(ErrUnknownLease, \\\"fencing token epoch %d names no known lease for session %s\\\", token.Epoch, sessionID)\\n462:\\t\\treturn refuse(ErrLeaseConflict, \\\"fencing token lease %s loses to winning lease %s at epoch %d\\\", token.LeaseID, winner.LeaseID, winner.Epoch)\\n465:\\t\\treturn refuse(ErrLeaseHolderMismatch, \\\"fencing token holder %s is not winning holder %s for session %s\\\", token.Holder