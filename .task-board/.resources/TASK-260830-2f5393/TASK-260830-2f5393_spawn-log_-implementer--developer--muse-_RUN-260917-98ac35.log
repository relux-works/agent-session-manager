t// OutcomeExplicitRollback means durable state mutated and the caller\\ninternal/secconftest/crash.go:27:\\tOutcomeExplicitRollback Outcome = \\\"explicit_rollback\\\"\\ninternal/secconftest/crash.go:28:\\t// OutcomeRecoverableParked means the operation stopped in a named\\ninternal/secconftest/crash.go:31:\\tOutcomeRecoverableParked Outcome = \\\"recoverable_parked_state\\\"\\ninternal/secconftest/crash.go:40:\\tPointPrepareEnter  = \\\"CR-MAT-prepare-enter\\\"\\ninternal/secconftest/crash.go:41:\\tPointPrepareCommit = \\\"CR-MAT-prepare-commit\\\"\\ninternal/secconftest/crash.go:42:\\tPointCommitEnter   = \\\"CR-MAT-commit-enter\\\"\\ninternal/secconftest/crash.go:43:\\tPointCommitApply   = \\\"CR-MAT-commit-apply\\\"\\ninternal/secconftest/crash.go:44:\\tPointRollbackEnter = \\\"CR-MAT-rollback-enter\\\"\\ninternal/secconftest/crash.go:55:\\toutcome Outcome\\ninternal/secconftest/crash.go:58:func (fault *Fault) Error() string {\\ninternal/secconftest/crash.go:64:func (fault *Fault) Unwrap() error {\\ninternal/secconftest/crash.go:68:// Point names the fired crash point.\\ninternal/secconftest/crash.go:69:func (fault *Fault) Point() string { return fault.point }\\ninternal/secconftest/crash.go:71:// Outcome classifies the fired crash point into the Section 13.13\\ninternal/secconftest/crash.go:73:func (fault *Fault) Outcome() Outcome { return fault.outcome }\\ninternal/secconftest/crash.go:75:// Classify maps a crash point to its required outcome. Points before\\ninternal/secconftest/crash.go:80:func Classify(point string) (Outcome, error) {\\ninternal/secconftest/crash.go:82:\\tcase PointPrepareEnter:\\ninternal/secconftest/crash.go:83:\\t\\treturn OutcomeSafeRetry, nil\\ninternal/secconftest/crash.go:84:\\tcase PointPrepareCommit, PointCommitEnter, PointRollbackEnter:\\ninternal/secconftest/crash.go:85:\\t\\treturn OutcomeExplicitRollback, nil\\ninternal/secconftest/crash.go:86:\\tcase PointCommitApply:\\ninternal/secconftest/crash.go:87:\\t\\treturn OutcomeRec