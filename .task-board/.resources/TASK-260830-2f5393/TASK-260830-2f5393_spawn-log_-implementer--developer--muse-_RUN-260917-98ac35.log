{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d8fb","stream":{"kind":"session","id":"01a0ad6e-311a-7113-b4bf-7612516b7572"},"sequence":2776,"recorded_at":1780531400005547,"record_type":"event","durability":"durable","causation_id":"020be8ef-fb6e-418b-83cb-2187067ba7da","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"020be8ef-fb6e-418b-83cb-2187067ba7da","run_stream":{"kind":"run","id":"020be8ef-fb6e-418b-83cb-2187067ba7da"},"task_stream":{"kind":"task","id":"01a0ada5-ccbb-73a0-8467-b975c04e3ca3"},"task_id":"01a0ada5-ccbb-73a0-8467-b975c04e3ca3","event":{"kind":"output","task_id":"01a0ada5-ccbb-73a0-8467-b975c04e3ca3","chunk":"{\n  \"chunk_id\": \"exec-76-1\",\n  \"command\": \"task-board resource --help 2>&1 | head -n 30; echo ===; task-board m --help 2>&1 | head -n 20\",\n  \"description\": \"Check resource attach commands\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Manage attached resources such as screenshots, docs, logs, and other files.\\n\\nUse \\\"task-board resource add\\\" to create a new attached resource, \\\"task-board\\nresource adopt\\\" to register an orphaned local payload, \\\"task-board resource\\nupdate\\\" to replace an existing one, \\\"task-board resource delete\\\" to remove it,\\nand \\\"task-board resource get\\\" to materialize a resource back to the local\\nfilesystem for inspection.\\n\\nUsage:\\n  task-board resource [command]\\n\\nAvailable Commands:\\n  add         Attach a new file resource to an element\\n  adopt       Register an existing unreferenced local resource payload\\n  delete      Delete a resource from an element (requires --confirm)\\n  get         Download a resource to the local filesystem\\n  update      Replace an existing file resource on an element\\n\\nFlags:\\n  -h, --help   help for resource\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\\n===\\nExecute a write operation against the board using the DSL.\\n\\nMutations:\\n  set_status(ID, status=..., commit_ack=scope_committed?)\\n                                        Change status; acknowledge enforced done transitions\\n  normalize_legacy_status(ID, expected_raw=..., status=...)\\n                                        Repair one exact unparseable raw status (local boards)\\n  handoff(ID, role=..., status=...)     Verify checklist/outcome evidence and change status\\n  set_estimate(ID, estimate=..., ...)  Set Task/Bug story-point estimate\\n  create(type=..., name=..., ...)      Create element\\n  set_details(ID, title=..., ...)      Update README fields\\n  rename(ID, name=...)                 Rename element name/slug\\n  delete(ID)                           Delete element (destructive)\\n  assign(ID, agent=...)                Assign agent\\n  unassign(ID)                         Remove assignment\\n  link(ID, blocked_by=...)             Add dependency\\n  unlink(ID, blocked_by=...)           Remove dependency\\n  check_item(ID, item=N)              Check checklist item\\n  uncheck_item(ID, item=N)            Uncheck checklist item\\n  add_checklist_item(ID, text=...)     Add checklist item\\n\",\n  \"original_output_bytes\": 2622,\n  \"original_output_tokens\": 656,\n  \"truncated\": false\n}","final_result":true}}}
