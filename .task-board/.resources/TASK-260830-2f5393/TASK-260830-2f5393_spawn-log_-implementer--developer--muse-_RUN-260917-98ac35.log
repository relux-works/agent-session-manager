se Record subject_id must equal session_id\\\")\\n60-\\t}\\n61-\\tif err := requireUUIDv4(object, \\\"lease_id\\\"); err != nil {\\n62-\\t\\treturn err\\n63-\\t}\\n64-\\tepoch, err := requirePositiveUint(object, \\\"epoch\\\")\\n65-\\tif err != nil {\\n66-\\t\\treturn err\\n67-\\t}\\n68-\\tif _, err := requireUUIDv7(object, \\\"holder_host_id\\\"); err != nil {\\n69-\\t\\treturn err\\n70-\\t}\\n71-\\tpredecessorPresent, err := requireNullableUUIDv4(object, \\\"predecessor_lease_id\\\")\\n72-\\tif err != nil {\\n73-\\t\\treturn err\\n74-\\t}\\n75-\\treason, err := requireEnum(object, \\\"reason\\\", \\\"create\\\", \\\"graceful_takeover\\\", \\\"force_takeover\\\", \\\"recovery\\\")\\n76-\\tif err != nil {\\n77-\\t\\treturn err\\n78-\\t}\\n79-\\tcheckpointPresent, err := requireNullableDigestPresence(object, \\\"checkpoint_id\\\")\\n80-\\tif err != nil {\\n81-\\t\\treturn err\\n82-\\t}\\n83-\\t// Each of the three couplings below quotes the clause that licenses it.\\n84-\\t// Section 5.3 does not declare an epoch-1 => create direction anywhere, so\\n85-\\t// an epoch-1 recovery or takeover lease is admitted: where the pinned\\n86-\\t// specification is silent this validator stays permissive.\\n87-\\tepochOneCreate := epoch == 1 && reason == \\\"create\\\"\\n88-\\t// predecessor_lease_id: \\\"Null only at epoch 1\\\".\\n89-\\tif epoch != 1 && !predecessorPresent {\\n90-\\t\\treturn invalidIdentity(\\\"Lease Record predecessor_lease_id must be non-null after epoch 1\\\")\\n91-\\t}\\n92-\\t// \\\"An epoch-1 create lease MUST have a null predecessor\\\".\\n93-\\tif epochOneCreate && predecessorPresent {\\n94-\\t\\treturn invalidIdentity(\\\"Lease Record epoch-1 create predecessor_lease_id must be null\\\")\\n95-\\t}\\n96-\\t// checkpoint_id: \\\"Null only for epoch-1 create; otherwise the validated\\n97-\\t// materialized handoff base\\\". The complement of epoch-1 create therefore\\n98-\\t// requires a non-null checkpoint, including at epoch 1 for any other reason.\\n99