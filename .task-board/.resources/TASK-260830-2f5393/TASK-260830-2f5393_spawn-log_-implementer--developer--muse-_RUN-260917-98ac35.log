{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c62d","stream":{"kind":"session","id":"01a0ad6e-311a-7113-b4bf-7612516b7572"},"sequence":369,"recorded_at":1780531400000733,"record_type":"event","durability":"durable","causation_id":"020be8ef-fb6e-418b-83cb-2187067ba7da","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"020be8ef-fb6e-418b-83cb-2187067ba7da","run_stream":{"kind":"run","id":"020be8ef-fb6e-418b-83cb-2187067ba7da"},"call_id":"call_01a0ad6f6a8d72359e70ee1504ae5c93","text":"{\n  \"chunk_id\": \"exec-14-1\",\n  \"command\": \"cat internal/sessrepo/census_test.go | head -n 150; echo ===; grep -n \\\"refuse(\\\" internal/sessrepo/*.go | grep -v _test | head -n 40\",\n  \"description\": \"Read sessrepo refusal census pattern\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"package sessrepo\\n\\nimport (\\n\\t\\\"flag\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"go/ast\\\"\\n\\t\\\"go/token\\\"\\n\\t\\\"os\\\"\\n\\t\\\"path/filepath\\\"\\n\\t\\\"runtime\\\"\\n\\t\\\"sort\\\"\\n\\t\\\"strconv\\\"\\n\\t\\\"strings\\\"\\n\\t\\\"testing\\\"\\n\\n\\t\\\"github.com/relux-works/agent-session-manager/internal/invcore\\\"\\n)\\n\\n// This file is the sessrepo refusal census. Every rejection in this package\\n// funnels through the refuse var, and the census derives its denominator\\n// from production source instead of listing it: a new refuse call without a\\n// boundary-driven negative path fails the gate, and a row without a site\\n// fails too. The gate has three halves:\\n//\\n//  1. Static derivation: every direct refuse(SENTINEL, ...) call in the\\n//     production files is derived as file:line with its sentinel. Calls\\n//     must sit on a single line with a bare sentinel identifier, or the\\n//     derivation fails closed.\\n//  2. Runtime recording: TestMain wraps the refuse var, attributing each\\n//     exercised refusal to its production file:line plus the sentinel it\\n//     carried, and whether a production boundary entry (Open,\\n//     CreateSession, AppendEvent, GetRecord, GetEvent, ListEvents,\\n//     ListSessions, Resolve) is on the stack. A direct helper call proves\\n//     the helper refuses and nothing about the boundary, so only\\n//     boundary-driven sites count.\\n//  3. Alias audit: every refuse reference outside direct-call position,\\n//     and every import-aliased or var-bound reference to the watched owner\\n//     delegations, fails through invcore.AuditConstructorReferences, with\\n//     the funnel's own declaration allowlisted by derived position.\\n//\\n// Control plants below prove each half fails closed, including an import\\n// alias and a var binding in both the passing and the failing direction.\\nvar sessrepoRefusalRecorder = invcore.NewSiteRecorder()\\n\\nvar sessrepoBoundarySites = map[string]struct{}{}\\n\\nvar sessrepoBoundaryMarkers = []string{\\n\\t\\\"sessrepo.Open\\\",\\n\\t\\\").CreateSession\\\",\\n\\t\\\").AppendEvent\\\",\\n\\t\\\").GetRecord\\\",\\n\\t\\\").GetEvent\\\",\\n\\t\\\").ListEvents\\\",\\n\\t\\\").ListSessions\\\",\\n\\t\\\").Resolve\\\",\\n}\\n\\nfunc TestMain(main *testing.M) {\\n\\toriginal := refuse\\n\\trefuse = func(sentinel error, format string, arguments ...any) error {\\n\\t\\terr := original(sentinel, format, arguments...)\\n\\t\\tsessrepoRefusalRecorder.Record(sentinel.Error(), 1)\\n\\t\\tif beneathSessrepoBoundary() {\\n\\t\\t\\tif site := callerSessrepoSite(); site != \\\"\\\" {\\n\\t\\t\\t\\tsessrepoBoundarySites[site] = struct{}{}\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\treturn err\\n\\t}\\n\\tcode := main.Run()\\n\\tif fullSessrepoPackageTestRun() {\\n\\t\\t// The content-equality audit is static: derivation over production\\n\\t\\t// source diffed against the ledger, with no dependence on which\\n\\t\\t// tests passed. It runs on every full run, green or red, so a\\n\\t\\t// plant reddens the gate even when an unrelated test is already\\n\\t\\t// red — a red suite masks nothing. The refusal runtime audit below\\n\\t\\t// instead compares exercised sites against derived sites, which is\\n\\t\\t// only meaningful when every test ran, so it stays gated on green.\\n\\t\\tfiles, fileSet, scanFailures := invcore.ScanProduction(\\\".\\\")\\n\\t\\tvar failures []string\\n\\t\\tfailures = append(failures, scanFailures...)\\n\\t\\tif len(scanFailures) == 0 {\\n\\t\\t\\tfailures = append(failures, auditSessrepoEquality(files, fileSet)...)\\n\\t\\t}\\n\\t\\tif code == 0 {\\n\\t\\t\\tfailures = append(failures, auditSessrepoRefusals()...)\\n\\t\\t}\\n\\t\\tif len(failures) != 0 {\\n\\t\\t\\tfor _, failure := range failures {\\n\\t\\t\\t\\tfmt.Fprintln(os.Stderr, failure)\\n\\t\\t\\t}\\n\\t\\t\\tcode = 1\\n\\t\\t}\\n\\t}\\n\\tos.Exit(code)\\n}\\n\\nfunc fullSessrepoPackageTestRun() bool {\\n\\tselected := flag.Lookup(\\\"test.run\\\")\\n\\treturn selected == nil || selected.Value.String() == \\\"\\\"\\n}\\n\\n// callerSessrepoSite reports the production file:line of the refuse call\\n// site: the wrapper calls this helper, so skip lands past Callers, this\\n// helper, and the wrapper, on the production line that refused.\\nfunc callerSessrepoSite() string {\\n\\tframes := make([]uintptr, 4)\\n\\tif count := runtime.Callers(3, frames); count == 0 {\\n\\t\\treturn \\\"\\\"\\n\\t}\\n\\tlocated := runtime.CallersFrames(frames)\\n\\tframe, _ := located.Next()\\n\\tif frame.Function == \\\"\\\" {\\n\\t\\treturn \\\"\\\"\\n\\t}\\n\\treturn filepath.Base(frame.File) + \\\":\\\" + strconv.Itoa(frame.Line)\\n}\\n\\nfunc beneathSessrepoBoundary() bool {\\n\\tframes := make([]uintptr, 64)\\n\\tfor {\\n\\t\\tcount := runtime.Callers(2, frames)\\n\\t\\tlocated := runtime.CallersFrames(frames[:count])\\n\\t\\tfor range frames[:count] {\\n\\t\\t\\tframe, _ := located.Next()\\n\\t\\t\\tfor _, marker := range sessrepoBoundaryMarkers {\\n\\t\\t\\t\\tif strings.Contains(frame.Function, marker) {\\n\\t\\t\\t\\t\\treturn true\\n\\t\\t\\t\\t}\\n\\t\\t\\t}\\n\\t\\t}\\n\\t\\tif count < len(frames) {\\n\\t\\t\\treturn false\\n\\t\\t}\\n\\t\\tframes = make([]uintptr, 2*len(frames))\\n\\t}\\n}\\n\\n// auditSessrepoRefusals derives the expected inventory from production AST\\n// and requires the exercised sets to match it in both directions, the alias\\n// audit to be clean, and the observed sentinel set to equal the derived\\n// sentinel roster exactly. It runs only on a green suite (see TestMain):\\n// the exercised sets are meaningless when tests failed. The static\\n// content-equality audit lives outside it and runs unconditionally.\\nfunc auditSessrepoRefusals() []string {\\n\\tfiles, fileSet, failures := invcore.ScanProduction(\\\".\\\")\\n\\tif len(failures) != 0 {\\n\\t\\treturn failures\\n\\t}\\n\\tderived, sentinels, sentinelNames, derivationFailures := deriveSessrepoRefusalSites(files, fileSet)\\n===\\ninternal/sessrepo/chain.go:64:\\t\\treturn sessionRecord{}, refuse(ErrInvalidRecord, \\\"decode session record frame: %v\\\", fault)\\ninternal/sessrepo/chain.go:67:\\t\\treturn sessionRecord{}, refuse(ErrInvalidRecord, \\\"session record schema %q, want %q\\\", schema, sessionRecordSchema)\\ninternal/sessrepo/chain.go:71:\\t\\treturn sessionRecord{}, refuse(ErrInvalidRecord, \\\"session record carries no valid session_id member\\\")\\ninternal/sessrepo/chain.go:75:\\t\\treturn sessionRecord{}, refuse(ErrInvalidRecord, \\\"verify session record identity: %v\\\", err)\\ninternal/sessrepo/chain.go:91:\\t\\treturn eventView{}, refuse(ErrInvalidEvent, \\\"decode session event frame: %v\\\", fault)\\ninternal/sessrepo/chain.go:94:\\t\\treturn eventView{}, refuse(ErrInvalidEvent, \\\"session event schema %q, want %q\\\", schema, sessionEventSchema)\\ninternal/sessrepo/chain.go:98:\\t\\treturn eventView{}, refuse(ErrInvalidEvent, \\\"session event member: %v\\\", err)\\ninternal/sessrepo/chain.go:102:\\t\\treturn eventView{}, refuse(ErrInvalidEvent, \\\"verify session event identity: %v\\\", err)\\ninternal/sessrepo/chain.go:169:\\t\\t\\treturn refuse(ErrStaleLease, \\\"event lease epoch %d precedes chain head epoch %d\\\", event.leaseEpoch, tail.LeaseEpoch)\\ninternal/sessrepo/chain.go:172:\\t\\t\\treturn refuse(ErrDivergentBranch, \\\"event under lease %s diverges from chain head lease %s at epoch %d\\\", event.leaseID, tail.LeaseID, tail.LeaseEpoch)\\ninternal/sessrepo/chain.go:180:\\t\\treturn refuse(ErrSequenceRepeat, \\\"event lease sequence %d repeats chained sequence through %d\\\", event.leaseSeq, want-1)\\ninternal/sessrepo/chain.go:183:\\t\\treturn refuse(ErrSequenceGap, \\\"event lease sequence %d skips chained sequence %d\\\", event.leaseSeq, want)\\ninternal/sessrepo/chain.go:187:\\t\\t\\treturn refuse(ErrPredecessorLink, \\\"first event must link exactly the session record\\\")\\ninternal/sessrepo/chain.go:192:\\t\\treturn refuse(ErrPredecessorLink, \\\"event predecessors omit prior authoritative event\\\")\\ninternal/sessrepo/chain.go:259:\\t\\treturn nil, refuse(ErrUnknownSession, \\\"unknown session %s\\\", sessionID)\\ninternal/sessrepo/chain.go:263:\\t\\treturn nil, refuse(ErrChainCorrupt, \\\"read chain index for session %s: %v\\\", sessionID, err)\\ninternal/sessrepo/chain.go:267:\\t\\treturn nil, refuse(ErrChainCorrupt, \\\"decode chain index for session %s: %v\\\", sessionID, err)\\ninternal/sessrepo/chain.go:271:\\t\\treturn nil, refuse(ErrChainCorrupt, \\\"read session record for session %s: %v\\\", sessionID, err)\\ninternal/sessrepo/chain.go:275:\\t\\treturn nil, refuse(ErrChainCorrupt, \\\"re-verify session record for session %s: %v\\\", sessionID, err)\\ninternal/sessrepo/chain.go:278:\\t\\treturn nil, refuse(ErrChainCorrupt, \\\"chain index does not describe stored session record for session %s\\\", sessionID)\\ninternal/sessrepo/chain.go:284:\\t\\t\\treturn nil, refuse(ErrChainCorrupt, \\\"read chained event %d for session %s: %v\\\", position, sessionID, err)\\ninternal/sessrepo/chain.go:288:\\t\\t\\treturn nil, refuse(ErrChainCorrupt, \\\"re-verify chained event %d for session %s: %v\\\", position, sessionID, err)\\ninternal/sessrepo/chain.go:291:\\t\\t\\treturn nil, refuse(ErrChainCorrupt, \\\"chained event %d for session %s carries self field %q, want event_id\\\", position, sessionID, string(field))\\ninternal/sessrepo/chain.go:294:\\t\\t\\treturn nil, refuse(ErrChainCorrupt, \\\"chained event %d for session %s digest %s disagrees with indexed event %s\\\", position, sessionID, digest.String(), indexed.EventID)\\ninternal/sessrepo/chain.go:302:\\t\\t\\treturn nil, refuse(ErrChainCorrupt, \\\"chain index order breaks continuity at event %d for session %s: %v\\\", position, sessionID, err)\\ninternal/sessrepo/sessrepo.go:146:\\t\\treturn nil, refuse(ErrRepositoryPath, \\\"data root %q is not absolute\\\", dataRoot)\\ninternal/sessrepo/sessrepo.go:150:\\t\\treturn nil, refuse(ErrRepositoryPath, \\\"create sessions root %q: %v\\\", root, err)\\ninternal/sessrepo/sessrepo.go:176:\\t\\t\\treturn SessionRef{}, refuse(ErrSessionExists, \\\"session %s already exists\\\", record.sessionID)\\ninternal/sessrepo/sessrepo.go:283:\\t\\treturn EventRef{}, refuse(ErrInvalidEvent, \\\"event session %s does not match target session %s\\\", event.sessionID, sessionID)\\ninternal/sessrepo/sessrepo.go:319:\\t\\t\\treturn EventRef{}, refuse(ErrChainCorrupt, \\\"digest path holds disagreeing bytes for event\\\")\\ninternal/sessrepo/store.go:46:\\t\\treturn nil, refuse(ErrUnknownEvent, \\\"malformed event id %q\\\", eventID)\\ninternal/sessrepo/store.go:63:\\treturn nil, refuse(ErrUnknownEvent, \\\"unknown event %q in session %s\\\", eventID, sessionID)\\ninternal/sessrepo/store.go:133:\\t\\treturn SessionSummary{}, refuse(ErrNameAmbiguous, \\\"name %q collides across %d sessions\\\", query, len(folded))\\ninternal/sessrepo/store.go:145:\\treturn SessionSummary{}, refuse(ErrNameNotFound, \\\"no live session named %q\\\", query)\\ninternal/sessrepo/store.go:154:\\t\\treturn nil, refuse(ErrRepositoryPath, \\\"read sessions root: %v\\\", err)\\n\",