+		replayed := mustCompareAndSwap(t, repository, testSessionID, LeaseExpectation{RecordID: first.RecordID}, input)
+		if replayed.RecordID != winner.RecordID {
+			t.Fatalf("retry ref = %+v, want %s", replayed, winner.RecordID)
+		}
+	})
+}
