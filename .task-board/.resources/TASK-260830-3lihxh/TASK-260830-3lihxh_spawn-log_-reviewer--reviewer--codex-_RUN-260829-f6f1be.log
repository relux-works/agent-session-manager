import subprocess,pathlib,json
files=subprocess.check_output(['git','ls-files','--others','--exclude-standard','-z']).split(b'\\0')
issues=[]; binary=[]; checked=0
for raw in files:
    if not raw: continue
    p=pathlib.Path(raw.decode())
    if not p.is_file(): continue
    data=p.read_bytes()
    if b'\\0' in data: binary.append(str(p)); continue
    try: text=data.decode('utf-8')
    except UnicodeDecodeError: binary.append(str(p)); continue
    checked+=1
