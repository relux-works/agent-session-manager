{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf7d","stream":{"kind":"session","id":"01a0b119-7781-7bc0-8528-77290b455925"},"sequence":1561,"recorded_at":1780531400003117,"record_type":"event","durability":"durable","causation_id":"13d59c78-6f33-4ca9-9b77-41caa4df923d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"13d59c78-6f33-4ca9-9b77-41caa4df923d","run_stream":{"kind":"run","id":"13d59c78-6f33-4ca9-9b77-41caa4df923d"},"task_stream":{"kind":"task","id":"01a0b126-e5bb-73e2-8871-3d3139b5b3bd"},"task_id":"01a0b126-e5bb-73e2-8871-3d3139b5b3bd","event":{"kind":"output","task_id":"01a0b126-e5bb-73e2-8871-3d3139b5b3bd","chunk":"{\n  \"chunk_id\": \"exec-37-1\",\n  \"command\": \"go test ./internal/rpcwire -count=1 -run 'FuzzClosedOperationBodies' 2>&1 | tail -n 2 && mkdir -p /tmp/fuzzctl && cat > /tmp/fuzzctl/run.sh <<'EOF'\\n#!/bin/bash\\n# Fuzz control runner: applies one weakening plant via -overlay, runs one\\n# fuzz target briefly (seeds execute first), expects FAIL, removes plant.\\n# Usage: run.sh <name> <source-relpath> <target> <python-patch-script>\\nset -u\\nROOT=/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-4qojoz/worktree\\nNAME=$1; SRC=$2; TARGET=$3; PATCH=$4\\nDIR=/tmp/fuzzctl/$NAME\\nrm -rf \\\"$DIR\\\"; mkdir -p \\\"$DIR\\\"\\ncp \\\"$ROOT/$SRC\\\" \\\"$DIR/src.go\\\"\\npython3 \\\"$PATCH\\\" \\\"$DIR/src.go\\\"\\npython3 - \\\"$ROOT/$SRC\\\" \\\"$DIR/src.go\\\" \\\"$DIR/overlay.json\\\" <<'PY'\\nimport json,sys\\njson.dump({\\\"Replace\\\":{sys.argv[1]:sys.argv[2]}}, open(sys.argv[3],\\\"w\\\"))\\nPY\\ncd \\\"$ROOT\\\" && go test -overlay \\\"$DIR/overlay.json\\\" ./internal/rpcwire -run=^$ -fuzz=\\\"^$TARGET\\\\$\\\" -fuzztime=10x -parallel=1 >\\\"$DIR/fuzz.log\\\" 2>&1\\necho \\\"$NAME exit=$?\\\"\\ngrep -E \\\"FAIL|admitted|exact member\\\" \\\"$DIR/fuzz.log\\\" | head -n 5\\nEOF\\nchmod +x /tmp/fuzzctl/run.sh\\ncat > /tmp/fuzzctl/bodies.py <<'EOF'\\nimport sys\\np=sys.argv[1]; s=open(p).read()\\nold=\\\"\\\"\\\"\\tif !exact(m, keys...) {\\n\\t\\treturn Hello{}, ErrHello\\n\\t}\\\"\\\"\\\"\\nnew=\\\"\\\"\\\"\\tif !exact(m, keys...) && m[\\\"extensions\\\"] == nil {\\n\\t\\treturn Hello{}, ErrHello\\n\\t}\\\"\\\"\\\"\\nassert s.count(old)==1, s.count(old)\\nopen(p,\\\"w\\\").write(s.replace(old,new,1))\\nEOF\\ncat > /tmp/fuzzctl/ns.py <<'EOF'\\nimport sys\\np=sys.argv[1]; s=open(p).read()\\nold=\\\"\\\"\\\"\\t\\tif !slices.Contains(allowed, name) || (i > 0 && names[i-1] >= name) {\\\"\\\"\\\"\\nnew=\\\"\\\"\\\"\\t\\tif (!slices.Contains(allowed, name) && name != \\\"credential\\\") || (i > 0 && names[i-1] >= name) {\\\"\\\"\\\"\\nassert s.count(old)==1, s.count(old)\\nopen(p,\\\"w\\\").write(s.replace(old,new,1))\\nEOF\\ncat > /tmp/fuzzctl/envelope.py <<'EOF'\\nimport sys\\np=sys.argv[1]; s=open(p).read()\\nold=\\\"\\\"\\\"\\tif len(m) != len(keys) {\\n\\t\\treturn false\\n\\t}\\\"\\\"\\\"\\nnew=\\\"\\\"\\\"\\tif len(m) != len(keys) && !(len(m) == len(keys)+1 && string(m[\\\"extra\\\"]) == \\\"true\\\") {\\n\\t\\treturn false\\n\\t}\\\"\\\"\\\"\\nassert s.count(old)==1, s.count(old)\\nopen(p,\\\"w\\\").write(s.replace(old,new,1))\\nEOF\\necho staged\",\n  \"description\": \"Stage fuzz control runner scripts\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"ok  \\tgithub.com/relux-works/agent-session-manager/internal/rpcwire\\t0.361s\\nstaged\\n\",\n  \"original_output_bytes\": 81,\n  \"original_output_tokens\": 21,\n  \"truncated\": false\n}","final_result":true}}}
