:= anchor + 1\\n\\tfor start < len(lines) && strings.TrimSpace(lines[start]) == \\\"\\\" {\\n\\t\\tstart++\\n\\t}\\n\\tvar body []string\\n\\tfor index := start; index < len(lines); index++ {\\n\\t\\ttext := strings.TrimSpace(lines[index])\\n\\t\\tif text == \\\"\\\" {\\n\\t\\t\\tbreak\\n\\t\\t}\\n\\t\\tbody = append(body, text)\\n\\t}\\n\\tif len(body) == 0 {\\n\\t\\tt.Fatalf(\\\"README carries no paragraph under %q\\\", ownershipParagraphAnchor)\\n\",\n  \"original_output_bytes\": 3201,\n  \"original_output_tokens\": 801,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
