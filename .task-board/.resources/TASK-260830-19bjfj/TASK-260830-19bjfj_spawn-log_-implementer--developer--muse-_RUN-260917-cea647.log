{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4ff","stream":{"kind":"session","id":"01a0b119-7781-7bc0-8528-77290b455925"},"sequence":218,"recorded_at":1780531400000431,"record_type":"event","durability":"durable","causation_id":"13d59c78-6f33-4ca9-9b77-41caa4df923d","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"13d59c78-6f33-4ca9-9b77-41caa4df923d","run_stream":{"kind":"run","id":"13d59c78-6f33-4ca9-9b77-41caa4df923d"},"task_stream":{"kind":"task","id":"01a0b11a-2455-77d1-adde-19ad81ebdbd2"},"task_id":"01a0b11a-2455-77d1-adde-19ad81ebdbd2","event":{"kind":"output","task_id":"01a0b11a-2455-77d1-adde-19ad81ebdbd2","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-4qojoz/worktree/internal/meshneg/negotiate.go`.\n1|// Package meshneg selects the single Mesh RPC major spoken on one peer\n2|// connection from the local installation's configuration generation and the\n3|// peer's decoded hello. It frames nothing, opens no connection, performs no\n4|// I/O, keeps no state, and admits no peer: identity equality, allowlist\n5|// membership, and trust generation remain the hostchannel admission boundary\n6|// (TASK-260830-z1yxg9), which negotiation never substitutes.\n7|//\n8|// The package owns the Section 11.2-11.3/11.8/11.9/11.10.1 and Section 17\n9|// selection rules only: highest common major among the locally offered and\n10|// peer offered majors, core-only preservation with explicit unsupported\n11|// directory/backend activation exposure, and no-common-major refusal with the\n12|// pinned Section 15 class. Wire shapes (hello maps, namespaces, operation\n13|// registry), Structured Error bindings, and configuration parsing stay with\n14|// their landed owners (rpcwire, axerror, config); this package derives from\n15|// them and never restates them.\n16|package meshneg\n17|\n18|import (\n19|\t\"errors\"\n20|\t\"fmt\"\n21|\t\"regexp\"\n22|\t\"slices\"\n23|\t\"strconv\"\n24|\t\"strings\"\n25|\n26|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n27|\t\"github.com/relux-works/agent-session-manager/internal/rpcwire\"\n28|)\n29|\n30|// Pinned RPC framing versions this negotiator can select. A frame carrying\n31|// any other version is not a lower minor of a supported major; Sections\n32|// 11.2-11.10 pin exactly these four, and Section 17.2 rule 1 requires a\n33|// reader to reject an unsupported major rather than coerce it.\n34|var pinnedFrameVersions = map[string]int{\n35|\t\"2.0.0\": 2,\n36|\t\"3.0.0\": 3,\n37|\t\"4.0.0\": 4,\n38|\t\"5.0.0\": 5,\n39|}\n40|\n41|// directoryFeatureMajor is the first RPC major that negotiates directory\n42|// replication (Section 11.8). backendEvidenceFeatureMajor is the first RPC\n43|// major that negotiates TerminalBackend evidence replication (Section 11.9);\n44|// RPC 5 retains the exact RPC-4 shapes (Section 11.10.1).\n45|const (\n46|\tdirectoryFeatureMajor       = 3\n47|\tbackendEvidenceFeatureMajor = 4\n48|)\n49|\n50|// Exposure codes for above-core activation on a negotiated peer. Both are\n51|// registered Section 15.3 codes; neither is minted here.\n52|const (\n53|\t// DirectoryUnsupportedCode is the literal Section 11.8 exposure token:\n54|\t// a node negotiating core-only with a peer reports that peer as\n55|\t// directory_mesh_unsupported, never as zero inventory.\n56|\tDirectoryUnsupportedCode = axerror.Code(\"directory_mesh_unsupported\")\n57|\t// BackendEvidenceUnsupportedCode is the RPC-4 equivalent: Section 11.9\n58|\t// requires reporting TerminalBackend evidence unsupported rather than\n59|\t// empty, and Section 17.4 requires reporting activation unavailable\n60|\t// rather than omitting the session. terminal_backend_unavailable is\n61|\t// the registered exit-6 code that states exactly that.\n62|\tBackendEvidenceUnsupportedCode = axerror.Code(\"terminal_backend_unavailable\")\n63|)\n64|\n65|// RefusalReason names why negotiation selected no major. Automation branches\n66|// on Reason (and Code); Detail is human text only.\n67|type RefusalReason string\n68|\n69|const (\n70|\t// ReasonUnknownConfig reports a local configuration generation outside\n71|\t// 1.0.0-4.0.0. Section 6.6 refuses unknown configuration instead of\n72|\t// selecting legacy.\n73|\tReasonUnknownConfig RefusalReason = \"unknown_config\"\n74|\t// ReasonUnsupportedFrame reports a peer frame version outside the\n75|\t// pinned 2.0.0-5.0.0 vocabulary.\n76|\tReasonUnsupportedFrame RefusalReason = \"unsupported_frame\"\n77|\t// ReasonContractShape reports a peer hello whose contracts map is not\n78|\t// exactly the framing major's pinned profile (missing, extra, or\n79|\t// extension keys, or a wrong rpc array shape).\n80|\tReasonContractShape RefusalReason = \"contract_shape\"\n81|\t// ReasonMixedMajor reports a peer rpc offer that mixes majors or\n82|\t// disagrees with its framing major. Section 17.1 forbids selecting a\n83|\t// major by coercion.\n84|\tReasonMixedMajor RefusalReason = \"mixed_major\"\n85|\t// ReasonNoCommonMajor reports disjoint local and peer major sets.\n86|\tReasonNoCommonMajor RefusalReason = \"no_common_major\"\n87|)\n88|\n89|var (\n90|\t// ErrUnknownConfig is the cause of an unknown-configuration refusal.\n91|\tErrUnknownConfig = errors.New(\"unknown configuration generation\")\n92|\t// ErrUnsupportedFrame is the cause of an unsupported-frame refusal.\n93|\tErrUnsupportedFrame = errors.New(\"unsupported RPC frame version\")\n94|\t// ErrContractShape is the cause of a contract-shape refusal.\n95|\tErrContractShape = errors.New(\"hello contracts differ from the pinned profile\")\n96|\t// ErrMixedMajor is the cause of a mixed-major refusal.\n97|\tErrMixedMajor = errors.New(\"peer rpc offer mixes majors\")\n98|\t// ErrNoCommonMajor is the cause of a no-common-major refusal.\n99|\tErrNoCommonMajor = errors.New(\"no common RPC major\")\n100|)\n101|\n102|// Refusal is the pure-data no-selection outcome. It frames no wire bytes:\n103|// Sections 11.2 and 15.1 close without a peer error frame on an unsupported\n104|// major, and Section 11.10.1 closes without a frame on other RPC majors, so\n105|// the only peer-visible effect is the close itself. The initiator maps Code\n106|// and ExitCode to its own local Structured Error; this value is that mapping\n107|// input, never a forged peer response.\n108|type Refusal struct {\n109|\t// Code and ExitCode are the pinned Section 15 class, resolved from the\n110|\t// axerror registry rather than retyped.\n111|\tCode     axerror.Code\n112|\tExitCode int\n113|\t// Reason names the refusal shape; Detail is human text.\n114|\tReason RefusalReason\n115|\tDetail string\n116|\t// Local carries the majors the local installation offered (empty when\n117|\t// the local generation itself is unknown). Peer carries the peer's\n118|\t// single offered major (zero when the peer offer was unusable).\n119|\tLocal []int\n120|\tPeer  int\n121|\t// Cause is the Go sentinel for errors.Is; it never reaches the wire.\n122|\tCause error\n123|}\n124|\n125|// Error renders the refusal without exposing anything beyond the refusal\n126|// facts. Message text is for humans; automation branches on Code/Reason.\n127|func (refusal *Refusal) Error() string {\n128|\tif refusal == nil {\n129|\t\treturn \"meshneg refusal\"\n130|\t}\n131|\treturn fmt.Sprintf(\"mesh RPC negotiation refused (%s): %s\", refusal.Reason, refusal.Code)\n132|}\n133|\n134|// Unwrap exposes the cause sentinel for errors.Is.\n135|func (refusal *Refusal) Unwrap() error {\n136|\tif refusal == nil {\n137|\t\treturn nil\n138|\t}\n139|\treturn refusal.Cause\n140|}\n141|\n142|// classExit resolves the pinned exit status for a refusal or exposure code\n143|// under the Structured Error version that introduced it. An unregistered\n144|// code or version fails closed: the caller gets an internal error, never a\n145|// guessed exit.\n146|func classExit(version axerror.Version, code axerror.Code) (int, error) {\n147|\treturn axerror.ExitCodeFor(version, code)\n148|}\n149|\n150|// refuse builds a peer-side refusal (incompatible_protocol, exit 6). It is\n151|// used only when incompatibility is actually known from a decoded hello and\n152|// a known local generation, per Section 11.10.1; unframed input never\n153|// reaches this package.\n154|func refuse(reason RefusalReason, cause error, detail string, local []int, peer int) (*Refusal, error) {\n155|\texit, err := classExit(axerror.Version100, axerror.Code(\"incompatible_protocol\"))\n156|\tif err != nil {\n157|\t\treturn nil, err\n158|\t}\n159|\treturn &Refusal{\n160|\t\tCode:     axerror.Code(\"incompatible_protocol\"),\n161|\t\tExitCode: exit,\n162|\t\tReason:   reason,\n163|\t\tDetail:   detail,\n164|\t\tLocal:    append([]int(nil), local...),\n165|\t\tPeer:     peer,\n166|\t\tCause:    cause,\n167|\t}, nil\n168|}\n169|\n170|// LocalMajors maps the local installation's configuration generation\n171|// (config.LoadedConfiguration.SourceVersion, the source document's\n172|// generation) to the exact RPC majors that installation offers, in ascending\n173|// order. It must NOT be fed config.Configuration.SchemaVersion: the config\n174|// owner normalizes Value to the current in-memory model (SchemaVersion is\n175|// CurrentVersion \"3.0.0\" for every v1/v2/v3 source), so wiring SchemaVersion\n176|// here would make a Config-1/2 installation offer RPC 3/4 it has no\n177|// directory or backend tables for:\n178|//\n179|//   - 1.0.0 offers 2: the base configuration predates the directory and\n180|//     TerminalBackend extensions, so only the Section 11.2-11.3 core.\n181|//   - 2.0.0 offers 2 and 3: the Section 6.4 directory extension pairs with\n182|//     RPC 3 directory replication, and Section 11.8 requires v2 dual-stack.\n183|//   - 3.0.0 offers 2, 3, and 4: the Section 6.5 TerminalBackend extension\n184|//     pairs with RPC 4 evidence replication, and Section 11.9 requires v3\n185|//     dual-stack with preserved v2 interop.\n186|//   - 4.0.0 offers exactly 5: Section 6.6 requires Host Channel 1 and RPC 5\n187|//     for every peer and states that legacy dual-stack obligations never\n188|//     require a Config-4 endpoint to accept legacy.\n189|//\n190|// Any other generation is refused with the invalid_config class (exit 3):\n191|// Section 6.6 makes unknown configuration a refusal, never legacy\n192|// selection. The result is a fresh slice on every call.\n193|func LocalMajors(configVersion string) ([]int, error) {\n194|\tswitch configVersion {\n195|\tcase \"1.0.0\":\n196|\t\treturn []int{2}, nil\n197|\tcase \"2.0.0\":\n198|\t\treturn []int{2, 3}, nil\n199|\tcase \"3.0.0\":\n200|\t\treturn []int{2, 3, 4}, nil\n201|\tcase \"4.0.0\":\n202|\t\treturn []int{5}, nil\n203|\tdefault:\n204|\t\texit, err := classExit(axerror.Version100, axerror.Code(\"invalid_config\"))\n205|\t\tif err != nil {\n206|\t\t\treturn nil, err\n207|\t\t}\n208|\t\treturn nil, &Refusal{\n209|\t\t\tCode:     axerror.Code(\"invalid_config\"),\n210|\t\t\tExitCode: exit,\n211|\t\t\tReason:   ReasonUnknownConfig,\n212|\t\t\tDetail:   fmt.Sprintf(\"configuration generation %q offers no RPC major\", configVersion),\n213|\t\t\tCause:    ErrUnknownConfig,\n214|\t\t}\n215|\t}\n216|}\n217|\n218|// semverMajor parses a strict semantic version and returns its major\n219|// component. The grammar is the same full semver rpcwire enforces on hello\n220|// contract arrays (major.minor.patch with optional prerelease and build\n221|// metadata, no leading zeros, no \"v\" prefix); agreement with rpcwire decode\n222|// is measured by test, not asserted by comment.\n223|var semverMajor = regexp.MustCompile(`^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$`)\n224|\n225|func majorOf(version string) (int, error) {\n226|\tmatch := semverMajor.FindStringSubmatch(version)\n227|\tif match == nil {\n228|\t\treturn 0, fmt.Errorf(\"%w: version %q is not strict semver\", ErrMixedMajor, version)\n229|\t}\n230|\tmajor, err := strconv.Atoi(match[1])\n231|\tif err != nil {\n232|\t\treturn 0, fmt.Errorf(\"%w: version %q has no numeric major\", ErrMixedMajor, version)\n233|\t}\n234|\treturn major, nil\n235|}\n236|\n237|// PeerOffer validates the peer's side of the negotiation: the decoded frame\n238|// version plus the decoded hello's contracts map. It returns the peer's\n239|// single offered major. Identity, platform, version, nonce, echo, and limit\n240|// members of the hello are never consulted: negotiation selects a major, it\n241|// does not authenticate, and consulting them here would substitute for the\n242|// admission boundary.\n243|//\n244|// The offer is refused when the frame version is outside the pinned\n245|// vocabulary, when the contracts keys differ from the framing major's exact\n246|// pinned profile (a v2 14-key bound inside a v3+ frame, an extension key, or\n247|// any missing key), when the rpc array is empty or not strictly\n248|// sorted-unique, when any rpc version is not strict semver, or when any rpc\n249|// major differs from the framing major. A v2 frame may carry a 1-16 version\n250|// minor range (Section 11.2); selecting within that range stays a stated\n251|// bound, since this package negotiates majors only.\n252|//\n253|// Two stated bounds. First, values of non-rpc arrays are validated by rpcwire\n254|// decode (exact per-key arrays for v3+, 1-16 sorted-unique semver per key for\n255|// v2) and trusted here: PeerOffer re-validates the key set and the rpc array\n256|// only, so direct callers must pass hellos produced by rpcwire decode\n257|// (Request.Hello or Response.Hello), never hand-built structs. Second, an\n258|// unparseable frame version (\"\", \"garbage\", \"v2.0.0\") answers\n259|// incompatible_protocol/exit 6 here while Section 15.1 assigns\n260|// transport_failure to an unrecognizable version; the input is unreachable\n261|// through rpcwire decode, which only the four pinned strings pass.\n262|func PeerOffer(frameVersion string, hello rpcwire.Hello) (int, error) {\n263|\tframing, pinned := pinnedFrameVersions[frameVersion]\n264|\tif !pinned {\n265|\t\trefusal, err := refuse(ReasonUnsupportedFrame, ErrUnsupportedFrame,\n266|\t\t\tfmt.Sprintf(\"frame version %q is outside the pinned 2.0.0-5.0.0 vocabulary\", frameVersion), nil, 0)\n267|\t\tif err != nil {\n268|\t\t\treturn 0, err\n269|\t\t}\n270|\t\treturn 0, refusal\n271|\t}\n272|\tprofile, err := rpcwire.ContractProfile(frameVersion)\n273|\tif err != nil {\n274|\t\treturn 0, err\n275|\t}\n276|\tif len(hello.Contracts) != len(profile) {\n277|\t\treturn 0, shapeRefusal(framing)\n278|\t}\n279|\tfor key := range profile {\n280|\t\tif _, ok := hello.Contracts[key]; !ok {\n281|\t\t\treturn 0, shapeRefusal(framing)\n282|\t\t}\n283|\t}\n284|\toffered := hello.Contracts[\"rpc\"]\n285|\tif len(offered) < 1 || len(offered) > 16 {\n286|\t\treturn 0, shapeRefusal(framing)\n287|\t}\n288|\tfor index, version := range offered {\n289|\t\tmajor, err := majorOf(version)\n290|\t\tif err != nil {\n291|\t\t\treturn 0, mixedRefusal(fmt.Sprintf(\"rpc version %q is not strict semver\", version))\n292|\t\t}\n293|\t\tif major != framing {\n294|\t\t\treturn 0, mixedRefusal(fmt.Sprintf(\"rpc version %q mixes major %d into a major-%d frame\", version, major, framing))\n295|\t\t}\n296|\t\tif index > 0 && offered[index-1] >= version {\n297|\t\t\treturn 0, mixedRefusal(\"rpc versions are not strictly sorted unique\")\n298|\t\t}\n299|\t}\n300|\tif frameVersion != \"2.0.0\" && !slices.Equal(offered, profile[\"rpc\"]) {\n301|\t\treturn 0, shapeRefusal(framing)\n302|\t}\n303|\treturn framing, nil\n304|}\n305|\n306|func shapeRefusal(framing int) error {\n307|\trefusal, err := refuse(ReasonContractShape, ErrContractShape,\n308|\t\tfmt.Sprintf(\"hello contracts do not match the pinned major-%d profile\", framing), nil, 0)\n309|\tif err != nil {\n310|\t\treturn err\n311|\t}\n312|\treturn refusal\n313|}\n314|\n315|func mixedRefusal(detail string) error {\n316|\trefusal, err := refuse(ReasonMixedMajor, ErrMixedMajor, detail, nil, 0)\n317|\tif err != nil {\n318|\t\treturn err\n319|\t}\n320|\treturn refusal\n321|}\n322|\n323|// Select returns the highest major in the intersection of the local and peer\n324|// offer sets. Either set naming a major outside the pinned 2/3/4/5\n325|// vocabulary, an empty set on either side, or a disjoint pair is refused as\n326|// no-common-major: an unmentionable major can never be common, and Section\n327|// 17.1 forbids selecting one by coercion.\n328|func Select(local, peer []int) (int, error) {\n329|\tfor _, major := range local {\n330|\t\tif major < 2 || major > 5 {\n331|\t\t\trefusal, err := refuse(ReasonNoCommonMajor, ErrNoCommonMajor,\n332|\t\t\t\tfmt.Sprintf(\"local offer names major %d outside the pinned 2/3/4/5 vocabulary\", major), append([]int(nil), local...), 0)\n333|\t\t\tif err != nil {\n334|\t\t\t\treturn 0, err\n335|\t\t\t}\n336|\t\t\treturn 0, refusal\n337|\t\t}\n338|\t}\n339|\tfor _, major := range peer {\n340|\t\tif major < 2 || major > 5 {\n341|\t\t\trefusal, err := refuse(ReasonNoCommonMajor, ErrNoCommonMajor,\n342|\t\t\t\tfmt.Sprintf(\"peer offer names major %d outside the pinned 2/3/4/5 vocabulary\", major), append([]int(nil), local...), 0)\n343|\t\t\tif err != nil {\n344|\t\t\t\treturn 0, err\n345|\t\t\t}\n346|\t\t\treturn 0, refusal\n347|\t\t}\n348|\t}\n349|\tbest := 0\n350|\tfor _, candidate := range local {\n351|\t\tif slices.Contains(peer, candidate) && candidate > best {\n352|\t\t\tbest = candidate\n353|\t\t}\n354|\t}\n355|\tif best == 0 {\n356|\t\tpeerMajor := 0\n357|\t\tif len(peer) == 1 {\n358|\t\t\tpeerMajor = peer[0]\n359|\t\t}\n360|\t\trefusal, err := refuse(ReasonNoCommonMajor, ErrNoCommonMajor,\n361|\t\t\t\"local and peer offers share no major (\"+joinMajors(local)+\" against \"+joinMajors(peer)+\")\",\n362|\t\t\tappend([]int(nil), local...), peerMajor)\n363|\t\tif err != nil {\n364|\t\t\treturn 0, err\n365|\t\t}\n366|\t\treturn 0, refusal\n367|\t}\n368|\treturn best, nil\n369|}\n370|\n371|func joinMajors(majors []int) string {\n372|\tparts := make([]string, 0, len(majors))\n373|\tfor _, major := range majors {\n374|\t\tparts = append(parts, strconv.Itoa(major))\n375|\t}\n376|\treturn \"[\" + strings.Join(parts, \" \") + \"]\"\n377|}\n378|\n379|// FeatureActivation reports how one above-core feature is exposed for the\n380|// negotiated peer. It carries no inventory counts, no object IDs, and no\n381|// capability advertisement: Negotiated states the outcome of this selection,\n382|// and Code names the registered exposure code only when the feature was not\n383|// negotiated, so a core-only peer can never be mistaken for an empty one.\n384|type FeatureActivation struct {\n385|\t// Feature is \"directory\" or \"terminal_backend_evidence\".\n386|\tFeature string\n387|\t// Negotiated is true exactly when the selected major carries the\n388|\t// feature (directory at 3+, backend evidence at 4+).\n389|\tNegotiated bool\n390|\t// Code is empty when negotiated; otherwise the registered exposure\n391|\t// code with ExitCode 6.\n392|\tCode     axerror.Code\n393|\tExitCode int\n394|}\n395|\n396|// PeerView is the local node's exposure of the negotiated peer: which\n397|// above-core activations the selection carries and which it reports\n398|// unsupported. Core sync itself is the negotiated major, not a member here.\n399|type PeerView struct {\n400|\tDirectory       FeatureActivation\n401|\tBackendEvidence FeatureActivation\n402|}\n403|\n404|// Decision is the pure-data selection outcome: exactly one common major\n405|// plus the shapes bound to it. Contracts and Namespaces are rebuilt from\n406|// the pinned profile for the selected major, never copied from peer bytes,\n407|// so a malformed peer array cannot propagate past selection.\n408|type Decision struct {\n409|\tMajor           int\n410|\tProtocolVersion string\n411|\tContracts       map[string][]string\n412|\tNamespaces      []string\n413|\tErrorVersion    axerror.Version\n414|\tPeer            PeerView\n415|}\n416|\n417|func exposure(feature string, negotiated bool, code axerror.Code, introduced axerror.Version) (FeatureActivation, error) {\n418|\tactivation := FeatureActivation{Feature: feature, Negotiated: negotiated}\n419|\tif negotiated {\n420|\t\treturn activation, nil\n421|\t}\n422|\texit, err := classExit(introduced, code)\n423|\tif err != nil {\n424|\t\treturn FeatureActivation{}, err\n425|\t}\n426|\tactivation.Code = code\n427|\tactivation.ExitCode = exit\n428|\treturn activation, nil\n429|}\n430|\n431|func decisionFor(major int) (Decision, error) {\n432|\tversion := fmt.Sprintf(\"%d.0.0\", major)\n433|\tcontracts, err := rpcwire.ContractProfile(version)\n434|\tif err != nil {\n435|\t\treturn Decision{}, err\n436|\t}\n437|\tnamespaces, err := rpcwire.Namespaces(version)\n438|\tif err != nil {\n439|\t\treturn Decision{}, err\n440|\t}\n441|\tbound, err := axerror.BindingFor(axerror.ContainingContract{ID: \"urn:ax:protocol:rpc\", Major: major})\n442|\tif err != nil {\n443|\t\treturn Decision{}, err\n444|\t}\n445|\tdirectory, err := exposure(\"directory\", major >= directoryFeatureMajor, DirectoryUnsupportedCode, axerror.Version120)\n446|\tif err != nil {\n447|\t\treturn Decision{}, err\n448|\t}\n449|\tbackend, err := exposure(\"terminal_backend_evidence\", major >= backendEvidenceFeatureMajor, BackendEvidenceUnsupportedCode, axerror.Version130)\n450|\tif err != nil {\n451|\t\treturn Decision{}, err\n452|\t}\n453|\treturn Decision{\n454|\t\tMajor:           major,\n455|\t\tProtocolVersion: version,\n456|\t\tContracts:       contracts,\n457|\t\tNamespaces:      namespaces,\n458|\t\tErrorVersion:    bound,\n459|\t\tPeer:            PeerView{Directory: directory, BackendEvidence: backend},\n460|\t}, nil\n461|}\n462|\n463|// Negotiate selects exactly one common Mesh RPC major for the local\n464|// configuration generation and the peer's decoded hello frame. configVersion\n465|// is the local config.LoadedConfiguration.SourceVersion (never\n466|// config.Configuration.SchemaVersion, which the config owner normalizes to\n467|// CurrentVersion for every v1/v2/v3 source); frameVersion is the decoded\n468|// envelope's protocol_version; hello is the decoded hello body.\n469|//\n470|// On success it returns the Decision for the highest common major. On\n471|// refusal it returns a *Refusal carrying the pinned Section 15 class:\n472|// incompatible_protocol with exit 6 when the decoded inputs prove the\n473|// majors are disjoint or the peer offer is malformed, or invalid_config\n474|// with exit 3 when the local generation is unknown. Any other error is an\n475|// internal registry inconsistency, never a peer verdict.\n476|//\n477|// Negotiate consults only the configuration generation, the frame version,\n478|// and the hello contracts map. It reads no environment, no argv, no raw\n479|// frame bytes, no extension member, and no prior-handshake state, so none\n480|// of those can select a fallback (Section 6.6). It performs no admission:\n481|// the hello identity, allowlist, and trust generation must still pass the\n482|// hostchannel boundary before any dispatch.\n483|func Negotiate(configVersion, frameVersion string, hello rpcwire.Hello) (Decision, error) {\n484|\tlocal, err := LocalMajors(configVersion)\n485|\tif err != nil {\n486|\t\treturn Decision{}, err\n487|\t}\n488|\tpeer, err := PeerOffer(frameVersion, hello)\n489|\tif err != nil {\n490|\t\tif refusal, ok := err.(*Refusal); ok {\n491|\t\t\trefusal.Local = append([]int(nil), local...)\n492|\t\t\treturn Decision{}, refusal\n493|\t\t}\n494|\t\treturn Decision{}, err\n495|\t}\n496|\tmajor, err := Select(local, []int{peer})\n497|\tif err != nil {\n498|\t\treturn Decision{}, err\n499|\t}\n500|\treturn decisionFor(major)\n(more lines below)","final_result":true}}}
