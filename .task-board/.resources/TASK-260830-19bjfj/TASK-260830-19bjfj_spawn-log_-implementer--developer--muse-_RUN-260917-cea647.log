stLocalFailureMapping(t *testing.T) {\\ninternal/hostchannel/hostchannel_test.go:429:func TestBindingRedaction(t *testing.T) {\\ninternal/hostchannel/hostchannel_test.go:442:func TestAuthorityListOverflow(t *testing.T) {\\ninternal/hostchannel/hostchannel_test.go:463:func TestEnrollmentPoolExcludesRevoked(t *testing.T) {\\ninternal/hostchannel/hostchannel_test.go:481:func TestEnrollmentPoolRefusesOverflow(t *testing.T) {\\ninternal/hostchannel/hostchannel_test.go:502:func TestCredentialFromIssued(t *testing.T) {\\n===ReadLine-tests===\\ninternal/hostchannel/hostchannel_test.go:407:\\t\\t{hostchannel.ErrUnframeableInput, \\\"transport_failure\\\", 8},\\ninternal/hostchannel/hostile_test.go:331:\\t\\t\\thelloLine, err := hostchannel.ReadLine(rogue)\\ninternal/hostchannel/hostile_test.go:333:\\t\\t\\t\\tt.Fatalf(\\\"ReadLine(hello): %v\\\", err)\\ninternal/hostchannel/hostile_test.go:574:\\t\\tif !errors.Is(serveErr, hostchannel.ErrUnframeableInput) {\\ninternal/hostchannel/hostile_test.go:597:\\t\\thelloLine, err := hostchannel.ReadLine(rogue)\\ninternal/hostchannel/hostile_test.go:599:\\t\\t\\tt.Fatalf(\\\"ReadLine(hello): %v\\\", err)\\ninternal/hostchannel/hostile_test.go:623:\\t\\tif !errors.Is(serveErr, hostchannel.ErrUnframeableInput) {\\ninternal/hostchannel/hostile_test.go:689:\\t\\t\\t_, _ = hostchannel.ReadLine(rogue)\\ninternal/hostchannel/hostile_test.go:715:\\t\\t\\tline, err := hostchannel.ReadLine(rogue)\\ninternal/hostchannel/hostile_test.go:725:\\t\\t\\t_, _ = hostchannel.ReadLine(rogue)\\ninternal/hostchannel/hostile_test.go:838:\\thelloLine, err := hostchannel.ReadLine(rogue)\\ninternal/hostchannel/hostile_test.go:840:\\t\\tt.Fatalf(\\\"ReadLine(hello): %v\\\", err)\\n===MAT-REPLAY===\\nfunc TestCreateReplayAndConflict(t *testing.T) {\\n\\tstore := openTestStore(t)\\n\\tref, _ := mustCreate(t, store, testInputsComposite())\\n\\t// The byte-identical retry replays the recorded journal without\\n\\t// writing: the stored bytes are unchanged.\\n\\tagain, raw, err := store.Create(testInputsComposite())\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"replay Create error = %v\\\", err)\\n\\t}\\n\\tif again != ref {\\n\\t\\tt.Fatalf(\\\"replay ref = %+v, want %+v\\\", again, ref)\\n\\t}\\n\\tloaded, stored, err := store.Get(testMatID)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tif loaded.Phase != PhaseStaging || string(stored) != string(raw) {\\n\\t\\tt.Fatalf(\\\"replay diverged stored bytes\\\")\\n\\t}\\n\\t// The same IDs with a moved body refuse idempotency_mismatch\\n\\t// and write nothing.\\n\\tmoved := testInputsComposite()\\n\\tmoved.RequestBody = []byte(`{\\\"materialization_id\\\":\\\"` + testMatID + `\\\",\\\"operation_id\\\":\\\"` + testPrepareOp + `\\\",\\\"plan_id\\\":\\\"` + testPriorID + `\\\"}`)\\n\\t_, _, err = store.Create(moved)\\n\\tmustConflict(t, err, \\\"Create(moved body)\\\")\\n\\tif !strings.Contains(err.Error(), \\\"idempotency_mismatch\\\") {\\n\\t\\tt.Fatalf(\\\"error = %v, want idempotency_mismatch named\\\", err)\\n\\t}\\n\\t// The same materialization under a different prepare operation\\n\\t// is a second prepare for one materialization, not a replay.\\n\\t// The refusal names the first prepare: a backstop conflict with\\n\\t// another message fails here.\\n\\tsecond := testInputsComposite()\\n\\tsecond.PrepareOperationID = testAdoptOp\\n\\t_, _, err = store.Create(second)\\n\\tmustConflict(t, err, \\\"Create(second prepare)\\\")\\n\\tif !strings.Contains(err.Error(), \\\"prepared under operation\\\") {\\n\\t\\tt.Fatalf(\\\"Create(second prepare) = %v, want the first-prepare refusal\\\", err)\\n\\t}\\n\\t// The journal still records the first prepare only.\\n\\tcurrent, _, err := store.Get(testMatID)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tif current.PrepareOperationID != testPrepareOp {\\n\\t\\tt.Fatalf(\\\"prepare operation drifted to %q\\\", current.PrepareOperationID)\\n\\t}\\n}\\n\\n\",\n  \"original_output_bytes\": 4220,\n  \"original_output_tokens\": 1055,\n