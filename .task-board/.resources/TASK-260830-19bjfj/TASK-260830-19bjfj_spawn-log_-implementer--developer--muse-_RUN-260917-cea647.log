{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c587","stream":{"kind":"session","id":"01a0b119-7781-7bc0-8528-77290b455925"},"sequence":286,"recorded_at":1780531400000567,"record_type":"event","durability":"durable","causation_id":"13d59c78-6f33-4ca9-9b77-41caa4df923d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"13d59c78-6f33-4ca9-9b77-41caa4df923d","run_stream":{"kind":"run","id":"13d59c78-6f33-4ca9-9b77-41caa4df923d"},"call_id":"call_01a0b11a395c71f29e9c7fa8b072f675","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-4qojoz/worktree/internal/rpcwire/inventory.go`.\n1|package rpcwire\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"slices\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|)\n9|\n10|// Namespaces is the wire vocabulary for an explicitly chosen pinned version.\n11|// It does not advertise support, compute inventory or authorize object exchange.\n12|func Namespaces(version string) ([]string, error) {\n13|\tn, err := major(version)\n14|\tif err != nil {\n15|\t\treturn nil, err\n16|\t}\n17|\tnames := []string{\"blob\", \"event\", \"manifest\", \"record\", \"tombstone\", \"tombstone_ack\"}\n18|\tif n >= 3 {\n19|\t\tnames = append(names, \"directory_record\")\n20|\t}\n21|\tif n >= 4 {\n22|\t\tnames = append(names, \"terminal_backend_evidence\")\n23|\t}\n24|\tslices.Sort(names)\n25|\treturn names, nil\n26|}\n27|func decodeNamespaces(version string, data []byte) ([]string, error) {\n28|\tm, err := object(data)\n29|\tif err != nil || !exact(m, \"namespaces\") {\n30|\t\treturn nil, ErrInventory\n31|\t}\n32|\tvar names []string\n33|\tif json.Unmarshal(m[\"namespaces\"], &names) != nil {\n34|\t\treturn nil, ErrInventory\n35|\t}\n36|\tallowed, _ := Namespaces(version)\n37|\tif len(names) < 1 || len(names) > len(allowed) {\n38|\t\treturn nil, ErrInventory\n39|\t}\n40|\tfor i, name := range names {\n41|\t\tif !slices.Contains(allowed, name) || (i > 0 && names[i-1] >= name) {\n42|\t\t\treturn nil, ErrInventory\n43|\t\t}\n44|\t}\n45|\treturn names, nil\n46|}\n47|\n48|// Root carries a claimed digest/count, not a verified Merkle root. Merkle\n49|// verification and schema-to-namespace membership belong to object exchange.\n50|type Root struct {\n51|\tNamespace string        `json:\"namespace\"`\n52|\tCount     scalar.Uint53 `json:\"count\"`\n53|\tRootID    scalar.Digest `json:\"root_id\"`\n54|}\n55|\n56|func validateRoots(version string, data, request []byte) error {\n57|\tnames, err := decodeNamespaces(version, request)\n58|\tif err != nil {\n59|\t\treturn err\n60|\t}\n61|\tm, err := object(data)\n62|\tif err != nil || !exact(m, \"roots\") {\n63|\t\treturn ErrInventory\n64|\t}\n65|\tvar roots []json.RawMessage\n66|\tif json.Unmarshal(m[\"roots\"], &roots) != nil || len(roots) != len(names) {\n67|\t\treturn ErrInventory\n68|\t}\n69|\tfor i, raw := range roots {\n70|\t\titem, err := object(raw)\n71|\t\tif err != nil || !exact(item, \"namespace\", \"count\", \"root_id\") {\n72|\t\t\treturn ErrInventory\n73|\t\t}\n74|\t\tvar root Root\n75|\t\tif json.Unmarshal(raw, &root) != nil || root.Namespace != names[i] {\n76|\t\t\treturn ErrInventory\n77|\t\t}\n78|\t}\n79|\treturn nil\n80|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c589","stream":{"kind":"session","id":"01a0b119-7781-7bc0-8528-77290b455925"},"sequence":287,"recorded_at":1780531400000569,"record_type":"event","durability":"durable","causation_id":"13d59c78-6f33-4ca9-9b77-41caa4df923d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"13d59c78-6f33-4ca9-9b77-41caa4df923d","run_stream":{"kind":"run","id":"13d59c78-6f33-4ca9-9b77-41caa4df923d"},"call_id":"call_01a0b11a3c4875eaa6fbd66c724592ad","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-4qojoz/worktree/internal/hostchannel/channel.go`.\n1|// Package hostchannel implements AX Section 11.10 Host Channel 1.0.0 over\n2|// Mesh RPC 5.0.0: mutual TLS 1.3 host authentication over an ordered binary\n3|// duplex stream, followed by an RPC-5 hello that is authorized against the\n4|// current hosttrust generation before any dispatch.\n5|//\n6|// The package owns the TLS profile, the hello exchange, per-dispatch and\n7|// per-mutation authorization boundaries, and the specified refusal framing.\n8|// It owns no SSH process, no CLI, no operation semantics beyond admission,\n9|// and no durable state: a channel run performs no file writes. Operation\n10|// bodies stay opaque; the caller-supplied Handler answers post-hello calls.\n11|package hostchannel\n12|\n13|import (\n14|\t\"bufio\"\n15|\t\"bytes\"\n16|\t\"context\"\n17|\t\"crypto/ecdsa\"\n18|\t\"crypto/rand\"\n19|\t\"crypto/tls\"\n20|\t\"crypto/x509\"\n21|\t\"encoding/binary\"\n22|\t\"errors\"\n23|\t\"fmt\"\n24|\t\"io\"\n25|\t\"net\"\n26|\t\"strings\"\n27|\t\"sync/atomic\"\n28|\t\"time\"\n29|\n30|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n31|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n32|\t\"github.com/relux-works/agent-session-manager/internal/rpcwire\"\n33|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n34|)\n35|\n36|const (\n37|\t// ProtocolVersion is the only RPC major this channel frames.\n38|\tProtocolVersion = \"5.0.0\"\n39|\t// ALPN is the exact Section 11.10.1 application protocol identifier.\n40|\tALPN = \"ax-host/1\"\n41|\t// DefaultHandshakeTimeout and DefaultHelloTimeout are the specified\n42|\t// fixed 10-second wall-clock bounds. Configuration structs select them\n43|\t// with a zero duration; tests use small overrides.\n44|\tDefaultHandshakeTimeout = 10 * time.Second\n45|\tDefaultHelloTimeout     = 10 * time.Second\n46|\t// DefaultRequestTimeout is the Section 6.2 default RPC timeout used\n47|\t// when the caller supplies no configured value.\n48|\tDefaultRequestTimeout = 300 * time.Second\n49|\t// MaxHandshakeBytes caps incoming handshake bytes per side.\n50|\tMaxHandshakeBytes = 1024 * 1024\n51|\t// MaxAuthorityBytes is the TLS CertificateRequest authority-list bound\n52|\t// the encoded CA distinguished-name list must fit.\n53|\tMaxAuthorityBytes = 65535\n54|\t// HostSuffix is the only permitted DNS SAN parent. It is asserted\n55|\t// against issued leaf certificates by test, not trusted by spelling.\n56|\tHostSuffix = \".host.ax.invalid\"\n57|\t// DefaultWatchPoll is the generation-watch sampling interval.\n58|\tDefaultWatchPoll = 50 * time.Millisecond\n59|)\n60|\n61|var (\n62|\t// ErrInvalidConfig reports a local configuration, credential-store or\n63|\t// activation failure before launch. The initiator maps it to the\n64|\t// invalid_config Error (exit 3).\n65|\tErrInvalidConfig = errors.New(\"host channel configuration is invalid\")\n66|\t// ErrAuthenticationFailed reports a known peer certificate or\n67|\t// handshake authentication failure. The initiator maps it to the\n68|\t// authentication_failed Error (exit 7).\n69|\tErrAuthenticationFailed = errors.New(\"host channel peer authentication failed\")\n70|\t// ErrTransportFailure reports transport I/O, a deadline, a byte cap,\n71|\t// or an unclassified EOF. The initiator maps it to the\n72|\t// transport_failure Error (exit 8).\n73|\tErrTransportFailure = errors.New(\"host channel transport failed\")\n74|\t// ErrProtocol reports a contract mismatch the peer actually framed:\n75|\t// a structurally invalid hello, a pre-hello non-hello request, or a\n76|\t// correlated failure the peer chose. It maps to the\n77|\t// incompatible_protocol Error (exit 6) and is never inferred from EOF.\n78|\tErrProtocol = errors.New(\"host channel protocol mismatch\")\n79|\t// ErrUnframeableInput reports input that must close without a frame:\n80|\t// unparseable bytes, an oversize line, or a foreign RPC major.\n81|\tErrUnframeableInput = errors.New(\"host channel input is unframeable\")\n82|\t// ErrHelloRequired reports a valid pre-hello non-hello request. It maps\n83|\t// to the incompatible_protocol Error (exit 6) like every framed\n84|\t// pre-hello contract refusal, but keeps its own identity so tests can\n85|\t// tell the sequencing gate from a malformed hello.\n86|\tErrHelloRequired = errors.New(\"host channel requires hello first\")\n87|\t// ErrALPNMismatch reports a negotiated ALPN other than the host\n88|\t// channel, including a missing negotiation. The tls.Config selects the\n89|\t// advertisement; this check enforces presence, which configuration\n90|\t// alone cannot.\n91|\tErrALPNMismatch = errors.New(\"host channel ALPN mismatch\")\n92|\t// ErrUnexpectedResume reports a resumed TLS connection, which the\n93|\t// channel forbids even when the peer negotiates one.\n94|\tErrUnexpectedResume = errors.New(\"host channel resumed connection refused\")\n95|\t// ErrUnverifiedChain reports a handshake that reached the supplement\n96|\t// without a standard-verified chain. The supplement never replaces\n97|\t// standard chain/name/time/EKU verification.\n98|\tErrUnverifiedChain = errors.New(\"host channel chain verification missing\")\n99|\t// ErrNoEnrolledMatch reports a peer certificate with zero or multiple\n100|\t// exact enrolled leaf/root/key matches. SAN or CA membership alone\n101|\t// never suffices.\n102|\tErrNoEnrolledMatch = errors.New(\"host channel peer has no unique enrolled match\")\n103|\t// ErrPeerTrustState reports a uniquely matched entry that is revoked\n104|\t// or past its retire_at bound.\n105|\tErrPeerTrustState = errors.New(\"host channel peer trust state refuses admission\")\n106|\t// ErrPeerProfile reports a matched entry whose certificates fail the\n107|\t// Host Credential Profile 1 checks at handshake time.\n108|\tErrPeerProfile = errors.New(\"host channel peer credential profile refused\")\n109|)\n110|\n111|// LocalFailure maps a channel error to the initiator-local Structured Error\n112|// code and exit status of Section 11.10.1. The second result is false when\n113|// the error carries no initiator mapping.\n114|func LocalFailure(err error) (axerror.Code, int, bool) {\n115|\tswitch {\n116|\tcase errors.Is(err, ErrInvalidConfig):\n117|\t\treturn axerror.Code(\"invalid_config\"), 3, true\n118|\tcase errors.Is(err, ErrAuthenticationFailed),\n119|\t\terrors.Is(err, ErrALPNMismatch),\n120|\t\terrors.Is(err, hosttrust.ErrHostIdentityMismatch),\n121|\t\terrors.Is(err, hosttrust.ErrNotAllowlisted),\n122|\t\terrors.Is(err, hosttrust.ErrStaleGeneration),\n123|\t\terrors.Is(err, hosttrust.ErrAuthorizationRefused):\n124|\t\treturn axerror.Code(\"authentication_failed\"), 7, true\n125|\tcase errors.Is(err, ErrProtocol),\n126|\t\terrors.Is(err, ErrHelloRequired):\n127|\t\treturn axerror.Code(\"incompatible_protocol\"), 6, true\n128|\tcase errors.Is(err, ErrTransportFailure),\n129|\t\terrors.Is(err, ErrUnframeableInput):\n130|\t\treturn axerror.Code(\"transport_failure\"), 8, true\n131|\tdefault:\n132|\t\treturn \"\", 0, false\n133|\t}\n134|}\n135|\n136|// Stream is the ordered binary stdin/stdout carrier the TLS session runs\n137|// over. It is deliberately narrower than net.Conn: no listener, no PTY, no\n138|// deadlines. Timeouts are enforced by closing the stream.\n139|type Stream interface {\n140|\tio.Reader\n141|\tio.Writer\n142|\tClose() error\n143|}\n144|\n145|// ServerName derives the expected UUID-derived DNS SAN of a configured\n146|// destination. The SSH endpoint is never a name here.\n147|func ServerName(hostID string) (string, error) {\n148|\tparsed, err := scalar.ParseUUIDv7(hostID)\n149|\tif err != nil {\n150|\t\treturn \"\", fmt.Errorf(\"%w: %w\", ErrInvalidConfig, err)\n151|\t}\n152|\treturn parsed.String() + HostSuffix, nil\n153|}\n154|\n155|// NewRequestID mints one fresh UUIDv7 request correlator.\n156|func NewRequestID() (string, error) {\n157|\tvar id [16]byte\n158|\tbinary.BigEndian.PutUint64(id[:8], uint64(time.Now().UnixMilli())<<16)\n159|\tif _, err := rand.Read(id[8:]); err != nil {\n160|\t\treturn \"\", fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n161|\t}\n162|\tid[6] = id[6]&0x0f | 0x70\n163|\tid[8] = id[8]&0x3f | 0x80\n164|\tvar text strings.Builder\n165|\tconst digits = \"0123456789abcdef\"\n166|\tfor i, b := range id {\n167|\t\tif i == 4 || i == 6 || i == 8 || i == 10 {\n168|\t\t\ttext.WriteByte('-')\n169|\t\t}\n170|\t\ttext.WriteByte(digits[b>>4])\n171|\t\ttext.WriteByte(digits[b&0x0f])\n172|\t}\n173|\tparsed, err := scalar.ParseUUIDv7(text.String())\n174|\tif err != nil {\n175|\t\treturn \"\", fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n176|\t}\n177|\treturn parsed.String(), nil\n178|}\n179|\n180|// AuthorityListOverflow reports whether the encoded CA distinguished-name\n181|// list of the given subjects exceeds the TLS authority-list bound. The\n182|// encoding is the 2-byte vector length plus one 2-byte length prefix per\n183|// name. Activation refuses an overflowing pool instead of truncating it.\n184|func AuthorityListOverflow(subjects [][]byte) bool {\n185|\ttotal := 2\n186|\tfor _, subject := range subjects {\n187|\t\ttotal += 2 + len(subject)\n188|\t}\n189|\treturn total > MaxAuthorityBytes\n190|}\n191|\n192|// EnrollmentPool builds the TLS trust pool from exactly the enrolled,\n193|// non-revoked, currently profile-valid roots of the snapshot. The system\n194|// pool is never consulted. Revoked or expired entries are excluded;\n195|// activation refuses when the remaining authority list overflows.\n196|func EnrollmentPool(snapshot hosttrust.Snapshot, now time.Time) (*x509.CertPool, error) {\n197|\tpool := x509.NewCertPool()\n198|\tvar subjects [][]byte\n199|\tfor _, entry := range snapshot.Trust.Entries {\n200|\t\tif entry.State == hosttrust.EntryRevoked {\n201|\t\t\tcontinue\n202|\t\t}\n203|\t\tif err := hosttrust.VerifyProfile(entry.LeafDER, entry.RootDER, entry.HostID.String(), now); err != nil {\n204|\t\t\tcontinue\n205|\t\t}\n206|\t\troot, err := x509.ParseCertificate(entry.RootDER)\n207|\t\tif err != nil {\n208|\t\t\tcontinue\n209|\t\t}\n210|\t\tpool.AddCert(root)\n211|\t\tsubjects = append(subjects, root.RawSubject)\n212|\t}\n213|\tif AuthorityListOverflow(subjects) {\n214|\t\treturn nil, fmt.Errorf(\"%w: enrolled authority list exceeds the TLS bound\", ErrInvalidConfig)\n215|\t}\n216|\treturn pool, nil\n217|}\n218|\n219|// VerifiedPeer is the uniquely verified enrolled identity of a TLS peer.\n220|// DER bytes stay unexported so status and error paths cannot log them.\n221|type VerifiedPeer struct {\n222|\tHostID       string\n223|\tCredentialID string\n224|\tleafDER      []byte\n225|\trootDER      []byte\n226|}\n227|\n228|// VerifyFunc supplements a successful standard TLS verification with the\n229|// enrolled-identity checks. It never replaces standard verification.\n230|type VerifyFunc func(tls.ConnectionState) error\n231|\n232|// VerifyPeer returns the supplement plus the record it fills on success.\n233|// The TLS version is enforced once, by the tls.Config both builders share\n234|// below. The supplement requires the exact negotiated ALPN (configuration\n235|// alone cannot refuse a missing negotiation), no resumption, a\n236|// standard-verified chain, exactly one exact enrolled leaf/root/key match,\n237|// current profile validity, and an admitting trust state. UUID/SAN binding\n238|// comes from the profile check against the matched entry.\n239|func VerifyPeer(snapshot hosttrust.Snapshot, now time.Time) (VerifyFunc, *VerifiedPeer) {\n240|\tverified := &VerifiedPeer{}\n241|\tverify := func(state tls.ConnectionState) error {\n242|\t\tif state.NegotiatedProtocol != ALPN {\n243|\t\t\treturn ErrALPNMismatch\n244|\t\t}\n245|\t\tif state.DidResume {\n246|\t\t\treturn ErrUnexpectedResume\n247|\t\t}\n248|\t\tif len(state.VerifiedChains) == 0 || len(state.PeerCertificates) == 0 {\n249|\t\t\treturn ErrUnverifiedChain\n250|\t\t}\n251|\t\tleaf := state.PeerCertificates[0]\n252|\t\tchain := state.VerifiedChains[0]\n253|\t\troot := chain[len(chain)-1]\n254|\t\tspki := scalar.SHA256Digest(leaf.RawSubjectPublicKeyInfo).String()\n255|\t\tvar matched []hosttrust.CredentialEntry\n256|\t\tfor _, entry := range snapshot.Trust.Entries {\n257|\t\t\tif !bytes.Equal(entry.LeafDER, leaf.Raw) {\n258|\t\t\t\tcontinue\n259|\t\t\t}\n260|\t\t\tif !bytes.Equal(entry.RootDER, root.Raw) {\n261|\t\t\t\tcontinue\n262|\t\t\t}\n263|\t\t\tif entry.SPKIID.String() != spki {\n264|\t\t\t\tcontinue\n265|\t\t\t}\n266|\t\t\tmatched = append(matched, entry)\n267|\t\t}\n268|\t\tif len(matched) != 1 {\n269|\t\t\treturn ErrNoEnrolledMatch\n270|\t\t}\n271|\t\tentry := matched[0]\n272|\t\tif err := hosttrust.VerifyProfile(entry.LeafDER, entry.RootDER, entry.HostID.String(), now); err != nil {\n273|\t\t\treturn fmt.Errorf(\"%w: %w\", ErrPeerProfile, err)\n274|\t\t}\n275|\t\tswitch entry.State {\n276|\t\tcase hosttrust.EntryActive:\n277|\t\tcase hosttrust.EntryRetiring:\n278|\t\t\tif entry.RetireAt == nil {\n279|\t\t\t\treturn ErrPeerTrustState\n280|\t\t\t}\n281|\t\t\tretireAt, err := entry.RetireAt.Time()\n282|\t\t\tif err != nil || !now.Before(retireAt) {\n283|\t\t\t\treturn ErrPeerTrustState\n284|\t\t\t}\n285|\t\tdefault:\n286|\t\t\treturn ErrPeerTrustState\n287|\t\t}\n288|\t\tverified.HostID = entry.HostID.String()\n289|\t\tverified.CredentialID = entry.CredentialID.String()\n290|\t\tverified.leafDER = bytes.Clone(leaf.Raw)\n291|\t\tverified.rootDER = bytes.Clone(root.Raw)\n292|\t\treturn nil\n293|\t}\n294|\treturn verify, verified\n295|}\n296|\n297|// baseTLS carries the single shared enforcement of the TLS version floor\n298|// and ceiling, the exact ALPN, and mandatory verification. Both roles\n299|// build on it so no role can drift from the profile.\n300|func baseTLS() *tls.Config {\n301|\treturn &tls.Config{\n302|\t\tMinVersion:         tls.VersionTLS13,\n303|\t\tMaxVersion:         tls.VersionTLS13,\n304|\t\tNextProtos:         alpnProtocols(),\n305|\t\tInsecureSkipVerify: false,\n306|\t}\n307|}\n308|\n309|func alpnProtocols() []string { return []string{ALPN} }\n310|\n311|// ClientTLS builds the initiator TLS 1.3 client configuration: enrolled\n312|// roots only, no session cache, the exact ALPN, and the destination SAN as\n313|// server name. The supplement runs inside VerifyConnection.\n314|func ClientTLS(certificate tls.Certificate, pool *x509.CertPool, serverName string, verify VerifyFunc) *tls.Config {\n315|\tconfig := baseTLS()\n316|\tconfig.Certificates = []tls.Certificate{certificate}\n317|\tconfig.RootCAs = pool\n318|\tconfig.ServerName = serverName\n319|\tconfig.ClientSessionCache = nil\n320|\tconfig.VerifyConnection = verify\n321|\treturn config\n322|}\n323|\n324|// ServerTLS builds the responder TLS 1.3 server configuration: enrolled\n325|// roots only, mandatory verified client certificates, no session tickets,\n326|// the exact ALPN, and the supplement inside VerifyConnection.\n327|func ServerTLS(certificate tls.Certificate, pool *x509.CertPool, verify VerifyFunc) *tls.Config {\n328|\tconfig := baseTLS()\n329|\tconfig.Certificates = []tls.Certificate{certificate}\n330|\tconfig.ClientAuth = tls.RequireAndVerifyClientCert\n331|\tconfig.ClientCAs = pool\n332|\tconfig.SessionTicketsDisabled = true\n333|\tconfig.VerifyConnection = verify\n334|\treturn config\n335|}\n336|\n337|// HandshakeLimiter caps incoming handshake bytes while armed. The channel\n338|// disarms it immediately after local handshake success, so application\n339|// records never count against the handshake budget.\n340|type HandshakeLimiter struct {\n341|\treader io.Reader\n342|\tcount  int64\n343|\tarmed  atomic.Bool\n344|\texceed atomic.Bool\n345|\tlimit  int64\n346|}\n347|\n348|// NewHandshakeLimiter arms a 1 MiB incoming cap over the handshake stream.\n349|func NewHandshakeLimiter(reader io.Reader) *HandshakeLimiter {\n350|\tlimiter := &HandshakeLimiter{reader: reader, limit: MaxHandshakeBytes}\n351|\tlimiter.armed.Store(true)\n352|\treturn limiter\n353|}\n354|\n355|// Disarm ends handshake byte accounting after local handshake success.\n356|func (limiter *HandshakeLimiter) Disarm() { limiter.armed.Store(false) }\n357|\n358|// Exceeded reports whether the cap fired.\n359|func (limiter *HandshakeLimiter) Exceeded() bool { return limiter.exceed.Load() }\n360|\n361|func (limiter *HandshakeLimiter) Read(data []byte) (int, error) {\n362|\tn, err := limiter.reader.Read(data)\n363|\tif !limiter.armed.Load() {\n364|\t\treturn n, err\n365|\t}\n366|\tlimiter.count += int64(n)\n367|\tif limiter.count > limiter.limit {\n368|\t\tlimiter.exceed.Store(true)\n369|\t\treturn n, fmt.Errorf(\"%w: handshake byte cap exceeded\", ErrTransportFailure)\n370|\t}\n371|\treturn n, err\n372|}\n373|\n374|// streamConn adapts a Stream to the net.Conn shape crypto/tls requires.\n375|// Addresses are static pipe labels; deadlines are unsupported because the\n376|// channel enforces its bounds by closing the stream.\n377|type streamConn struct {\n378|\tStream\n379|}\n380|\n381|type pipeAddr string\n382|\n383|func (addr pipeAddr) Network() string { return \"pipe\" }\n384|func (addr pipeAddr) String() string  { return string(addr) }\n385|\n386|func (conn streamConn) LocalAddr() net.Addr  { return pipeAddr(\"local\") }\n387|func (conn streamConn) RemoteAddr() net.Addr { return pipeAddr(\"remote\") }\n388|func (conn streamConn) SetDeadline(_ time.Time) error {\n389|\treturn errors.New(\"host channel deadlines close the stream\")\n390|}\n391|func (conn streamConn) SetReadDeadline(_ time.Time) error {\n392|\treturn errors.New(\"host channel deadlines close the stream\")\n393|}\n394|func (conn streamConn) SetWriteDeadline(_ time.Time) error {\n395|\treturn errors.New(\"host channel deadlines close the stream\")\n396|}\n397|\n398|// RunHandshake completes the TLS handshake under a wall-clock deadline,\n399|// enforced by closing the stream even when the peer sends nothing. A fired\n400|// deadline, an exceeded byte cap, or a transport read failure maps to\n401|// ErrTransportFailure; every other handshake failure is peer\n402|// authentication. No application bytes may move before this returns nil.\n403|func RunHandshake(conn *tls.Conn, stream Stream, limiter *HandshakeLimiter, timeout time.Duration) error {\n404|\tdone := make(chan error, 1)\n405|\tgo func() { done <- conn.Handshake() }()\n406|\ttimer := time.NewTimer(timeout)\n407|\tdefer timer.Stop()\n408|\tselect {\n409|\tcase err := <-done:\n410|\t\tif err == nil {\n411|\t\t\treturn nil\n412|\t\t}\n413|\t\tif limiter != nil && limiter.Exceeded() {\n414|\t\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n415|\t\t}\n416|\t\treturn classifyHandshakeError(err)\n417|\tcase <-timer.C:\n418|\t\t_ = stream.Close()\n419|\t\terr := <-done\n420|\t\tif limiter != nil && limiter.Exceeded() {\n421|\t\t\treturn fmt.Errorf(\"%w: handshake deadline exceeded\", ErrTransportFailure)\n422|\t\t}\n423|\t\tif err == nil {\n424|\t\t\treturn fmt.Errorf(\"%w: handshake deadline exceeded\", ErrTransportFailure)\n425|\t\t}\n426|\t\treturn fmt.Errorf(\"%w: handshake deadline exceeded: %v\", ErrTransportFailure, classifyHandshakeError(err))\n427|\t}\n428|}\n429|\n430|func classifyHandshakeError(err error) error {\n431|\tif err == nil {\n432|\t\treturn nil\n433|\t}\n434|\tif errors.Is(err, ErrTransportFailure) {\n435|\t\treturn err\n436|\t}\n437|\t// A received TLS alert unwraps to an OpError whose Op is \"remote\n438|\t// error\": that is peer authentication, never transport I/O. Every\n439|\t// other OpError, a timeout, a closed conn, or an EOF variant is the\n440|\t// transport failing underneath the handshake.\n441|\tvar opErr *net.OpError\n442|\tif errors.As(err, &opErr) && opErr.Op != \"remote error\" {\n443|\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n444|\t}\n445|\tvar netErr net.Error\n446|\tif errors.As(err, &netErr) && netErr.Timeout() {\n447|\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n448|\t}\n449|\tif errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) || errors.Is(err, io.ErrClosedPipe) || errors.Is(err, net.ErrClosed) {\n450|\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n451|\t}\n452|\treturn fmt.Errorf(\"%w: %w\", ErrAuthenticationFailed, err)\n453|}\n454|\n455|// WriteLine sends one LF-terminated frame. The payload must already be a\n456|// single LF-free line within the wire bound; the check here is defensive.\n457|func WriteLine(writer io.Writer, line []byte) error {\n458|\tif len(line) == 0 || len(line) > rpcwire.MaxLineBytes || bytes.IndexByte(line, '\\n') >= 0 {\n459|\t\treturn ErrUnframeableInput\n460|\t}\n461|\tframe := make([]byte, 0, len(line)+1)\n462|\tframe = append(frame, line...)\n463|\tframe = append(frame, '\\n')\n464|\tif _, err := writer.Write(frame); err != nil {\n465|\t\treturn fmt.Errorf(\"%w: %w\", ErrTransportFailure, err)\n466|\t}\n467|\treturn nil\n468|}\n469|\n470|// FrameReader decodes successive LF-terminated frames from one stream. It\n471|// must be the only reader on its stream: buffering may hold bytes past\n472|// the current frame. One FrameReader serves a whole connection.\n473|type FrameReader struct {\n474|\tbuffered *bufio.Reader\n475|}\n476|\n477|// NewFrameReader buffers one stream for successive frame reads.\n478|func NewFrameReader(reader io.Reader) *FrameReader {\n479|\treturn &FrameReader{buffered: bufio.NewReader(reader)}\n480|}\n481|\n482|// ReadLine reads one LF-terminated frame without the terminator. An\n483|// over-bound line or mid-line truncation is unframeable and must close\n484|// without a frame. A stream that ends with no frame bytes surfaces as\n485|// io.EOF for the transport mapping, including an abrupt end: zero bytes\n486|// is never a truncated frame.\n487|func (frames *FrameReader) ReadLine() ([]byte, error) {\n488|\tvar line []byte\n489|\tfor {\n490|\t\tchunk, err := frames.buffered.ReadSlice('\\n')\n491|\t\tif len(chunk) > 0 {\n492|\t\t\tif len(line)+len(chunk) > rpcwire.MaxLineBytes+1 {\n493|\t\t\t\treturn nil, ErrUnframeableInput\n494|\t\t\t}\n495|\t\t\tline = append(line, chunk...)\n496|\t\t}\n497|\t\tswitch {\n498|\t\tcase err == nil:\n499|\t\t\treturn line[:len(line)-1], nil\n500|\t\tcase errors.Is(err, bufio.ErrBufferFull):\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
