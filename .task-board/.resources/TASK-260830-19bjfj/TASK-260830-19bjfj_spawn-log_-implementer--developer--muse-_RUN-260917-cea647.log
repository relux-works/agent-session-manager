nt.binding.Generation {\n251|\t\treturn rpcwire.Response{}, fmt.Errorf(\"authorization generation moved: %w\", hosttrust.ErrStaleGeneration)\n252|\t}\n253|\trequestID, err := NewRequestID()\n254|\tif err != nil {\n255|\t\treturn rpcwire.Response{}, err\n256|\t}\n257|\tline, err := rpcwire.EncodeRequest(ProtocolVersion, requestID, operation, body)\n258|\tif err != nil {\n259|\t\treturn rpcwire.Response{}, err\n260|\t}\n261|\trequest, err := rpcwire.DecodeRequest(line)\n262|\tif err != nil {\n263|\t\treturn rpcwire.Response{}, err\n264|\t}\n265|\tif err := writeLineBounded(client.conn, client.stream, line, client.timeout); err != nil {\n266|\t\t_ = client.stream.Close()\n267|\t\treturn rpcwire.Response{}, err\n268|\t}\n269|\tresponseLine, err := readLineBounded(client.frames, client.stream, client.timeout)\n270|\tif err != nil {\n271|\t\t_ = client.stream.Close()\n272|\t\treturn rpcwire.Response{}, err\n273|\t}\n274|\tresponse, err := rpcwire.DecodeResponse(responseLine, request)\n275|\tif err != nil {\n276|\t\tif errors.Is(err, rpcwire.ErrVersion) || errors.Is(err, rpcwire.ErrFrame) {\n277|\t\t\treturn rpcwire.Response{}, fmt.Errorf(\"%w: peer reply is unframeable: %v\", ErrTransportFailure, err)\n278|\t\t}\n279|\t\treturn rpcwire.Response{}, fmt.Errorf(\"%w: %w\", ErrProtocol, err)\n280|\t}\n281|\treturn response, nil\n282|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
