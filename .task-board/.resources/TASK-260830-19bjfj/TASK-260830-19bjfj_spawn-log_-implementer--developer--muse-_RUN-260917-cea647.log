{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9d1","stream":{"kind":"session","id":"01a0b119-7781-7bc0-8528-77290b455925"},"sequence":835,"recorded_at":1780531400001665,"record_type":"event","durability":"durable","causation_id":"13d59c78-6f33-4ca9-9b77-41caa4df923d","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"13d59c78-6f33-4ca9-9b77-41caa4df923d","run_stream":{"kind":"run","id":"13d59c78-6f33-4ca9-9b77-41caa4df923d"},"call_id":"call_01a0b11c924870ff8c6fdabdad996cee","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-4qojoz/worktree/internal/meshneg/negotiate_test.go`.\n(499 line(s) above)\n500|\t\t\t\t\tt.Fatalf(\"PeerOffer(%s, %s) class = %s/%d\", tc.frame, tc.name, refusal.Code, refusal.ExitCode)\n501|\t\t\t\t}\n502|\t\t\t})\n503|\t\t}\n504|\t})\n505|\n506|\tt.Run(\"admitted-ranges\", func(t *testing.T) {\n507|\t\t// A v2 minor range stays major 2: minor selection within the\n508|\t\t// common major is a stated bound, not a refusal.\n509|\t\tm := v2(t)\n510|\t\tm[\"rpc\"] = []string{\"2.0.0\", \"2.1.0\"}\n511|\t\tif peer, err := meshneg.PeerOffer(\"2.0.0\", directHello(t, m)); peer != 2 || err != nil {\n512|\t\t\tt.Fatalf(\"PeerOffer(v2 range) = %d, %v, want 2, nil\", peer, err)\n513|\t\t}\n514|\t\tm = v2(t)\n515|\t\tm[\"rpc\"] = []string{\"2.0.0\", \"2.0.0-alpha\"}\n516|\t\tif peer, err := meshneg.PeerOffer(\"2.0.0\", directHello(t, m)); peer != 2 || err != nil {\n517|\t\t\tt.Fatalf(\"PeerOffer(v2 prerelease) = %d, %v, want 2, nil\", peer, err)\n518|\t\t}\n519|\t\tfor _, frame := range []string{\"3.0.0\", \"4.0.0\", \"5.0.0\"} {\n520|\t\t\tpeer, err := meshneg.PeerOffer(frame, directHello(t, profileContracts(t, frame)))\n521|\t\t\tif peer != int(frame[0]-'0') || err != nil {\n522|\t\t\t\tt.Fatalf(\"PeerOffer(%s) = %d, %v\", frame, peer, err)\n523|\t\t\t}\n524|\t\t}\n525|\t})\n526|}\n527|\n528|// TestPeerOfferTrustsDecodedNonRPCArrays pins the stated bound: PeerOffer\n529|// re-validates the contracts key set and the rpc array only. A directly\n530|// built v3/v4/v5 hello with a wrong non-rpc array is admitted here, while\n531|// the same map is refused by rpcwire encode/decode, so the composed\n532|// production path (Request.Hello / Response.Hello are the only production\n533|// constructors) closes the gap. A v2 hello with lease [\"9.9.9\"] is admitted\n534|// by both: v2 permits 1-16 versions per key by design, and minor selection\n535|// is a separate stated bound.\n536|func TestPeerOfferTrustsDecodedNonRPCArrays(t *testing.T) {\n537|\tfor _, frame := range []string{\"3.0.0\", \"4.0.0\", \"5.0.0\"} {\n538|\t\tt.Run(\"tampered-\"+frame, func(t *testing.T) {\n539|\t\t\tcontracts := profileContracts(t, frame)\n540|\t\t\tcontracts[\"session_event\"] = []string{\"1.0.0\"}\n541|\t\t\tpeer, err := meshneg.PeerOffer(frame, directHello(t, contracts))\n542|\t\t\tif peer != int(frame[0]-'0') || err != nil {\n543|\t\t\t\tt.Fatalf(\"PeerOffer(%s, tampered session_event) = %d, %v: bound moved\", frame, peer, err)\n544|\t\t\t}\n545|\t\t\tbody, err := json.Marshal(map[string]any{\n546|\t\t\t\t\"host_id\": peerHost, \"platform\": \"macos\", \"ax_version\": \"0.2.1\",\n547|\t\t\t\t\"nonce\": rpcwire.NewNonce(), \"contracts\": contracts,\n548|\t\t\t\t\"max_line_bytes\": 8 * 1024 * 1024, \"max_object_bytes\": 5 * 1024 * 1024,\n549|\t\t\t})\n550|\t\t\tif err != nil {\n551|\t\t\t\tt.Fatal(err)\n552|\t\t\t}\n553|\t\t\tif _, err := rpcwire.EncodeRequest(frame, requestID, \"hello\", body); !errors.Is(err, rpcwire.ErrHello) {\n554|\t\t\t\tt.Fatalf(\"rpcwire admitted the tampered %s map: %v (bound moved)\", frame, err)\n555|\t\t\t}\n556|\t\t})\n557|\t}\n558|\tt.Run(\"v2-range-admitted-by-both\", func(t *testing.T) {\n559|\t\tcontracts := profileContracts(t, \"2.0.0\")\n560|\t\tcontracts[\"lease\"] = []string{\"9.9.9\"}\n561|\t\tpeer, err := meshneg.PeerOffer(\"2.0.0\", directHello(t, contracts))\n562|\t\tif peer != 2 || err != nil {\n563|\t\t\tt.Fatalf(\"PeerOffer(v2 lease range) = %d, %v, want 2, nil\", peer, err)\n564|\t\t}\n565|\t\thello := decodedHello(t, \"2.0.0\", contracts)\n566|\t\tpeer, err = meshneg.PeerOffer(\"2.0.0\", hello)\n567|\t\tif peer != 2 || err != nil {\n568|\t\t\tt.Fatalf(\"PeerOffer(decoded v2 lease range) = %d, %v, want 2, nil\", peer, err)\n569|\t\t}\n570|\t})\n571|}\n572|\n573|func TestDecisionShapes(t *testing.T) {\n574|\ttype shape struct {\n575|\t\tkeys       int\n576|\t\tnamespaces []string\n577|\t\terrVersion axerror.Version\n578|\t}\n579|\tsorted := func(names ...string) []string {\n580|\t\tout := slices.Clone(names)\n581|\t\tslices.Sort(out)\n582|\t\treturn out\n583|\t}\n584|\tcore := []string{\"blob\", \"event\", \"manifest\", \"record\", \"tombstone\", \"tombstone_ack\"}\n585|\tshapes := map[string]shape{\n586|\t\t\"2.0.0\": {14, sorted(core...), axerror.Version100},\n587|\t\t\"3.0.0\": {24, sorted(append(slices.Clone(core), \"directory_record\")...), axerror.Version120},\n588|\t\t\"4.0.0\": {25, sorted(append(slices.Clone(core), \"directory_record\", \"terminal_backend_evidence\")...), axerror.Version130},\n589|\t\t\"5.0.0\": {25, sorted(append(slices.Clone(core), \"directory_record\", \"terminal_backend_evidence\")...), axerror.Version130},\n590|\t}\n591|\t// Local generations that admit each frame: config-4 only for 5.0.0,\n592|\t// the newest legacy generation otherwise.\n593|\tconfigFor := map[string]string{\"2.0.0\": \"3.0.0\", \"3.0.0\": \"3.0.0\", \"4.0.0\": \"3.0.0\", \"5.0.0\": \"4.0.0\"}\n594|\tfor _, frame := range []string{\"2.0.0\", \"3.0.0\", \"4.0.0\", \"5.0.0\"} {\n595|\t\tt.Run(frame, func(t *testing.T) {\n596|\t\t\tconfig := configFor[frame]\n597|\t\t\thello := decodedHello(t, frame, profileContracts(t, frame))\n598|\t\t\tdecision, err := meshneg.Negotiate(config, frame, hello)\n599|\t\t\tif err != nil {\n600|\t\t\t\tt.Fatal(err)\n601|\t\t\t}\n602|\t\t\twant := shapes[frame]\n603|\t\t\tif len(decision.Contracts) != want.keys {\n604|\t\t\t\tt.Fatalf(\"Negotiate(%s, %s) contracts keys = %d, want %d\", config, frame, len(decision.Contracts), want.keys)\n605|\t\t\t}\n606|\t\t\tprofile, err := rpcwire.ContractProfile(frame)\n607|\t\t\tif err != nil {\n608|\t\t\t\tt.Fatal(err)\n609|\t\t\t}\n610|\t\t\tif !maps.EqualFunc(decision.Contracts, profile, slices.Equal) {\n611|\t\t\t\tt.Fatalf(\"Negotiate(%s, %s) contracts differ from the rpcwire profile\", config, frame)\n612|\t\t\t}\n613|\t\t\tif !slices.Equal(decision.Namespaces, want.namespaces) {\n614|\t\t\t\tt.Fatalf(\"Negotiate(%s, %s) namespaces = %v, want %v\", config, frame, decision.Namespaces, want.namespaces)\n615|\t\t\t}\n616|\t\t\tif decision.ErrorVersion != want.errVersion {\n617|\t\t\t\tt.Fatalf(\"Negotiate(%s, %s) error version = %s, want %s\", config, frame, decision.ErrorVersion, want.errVersion)\n618|\t\t\t}\n619|\t\t\tif decision.ProtocolVersion != frame {\n620|\t\t\t\tt.Fatalf(\"Negotiate(%s, %s) protocol version = %s\", config, frame, decision.ProtocolVersion)\n621|\t\t\t}\n622|\t\t\t// RPC 5 carries the exact RPC-4 shapes with only the version\n623|\t\t\t// changed (Section 11.10.1).\n624|\t\t\tif frame == \"5.0.0\" {\n625|\t\t\t\tfour, err := meshneg.Negotiate(\"3.0.0\", \"4.0.0\", decodedHello(t, \"4.0.0\", profileContracts(t, \"4.0.0\")))\n626|\t\t\t\tif err != nil {\n627|\t\t\t\t\tt.Fatal(err)\n628|\t\t\t\t}\n629|\t\t\t\tif !slices.Equal(decision.Namespaces, four.Namespaces) || decision.ErrorVersion != four.ErrorVersion {\n630|\t\t\t\t\tt.Fatal(\"RPC 5 decision diverges from the RPC-4 shapes\")\n631|\t\t\t\t}\n632|\t\t\t\tif len(decision.Contracts) != len(four.Contracts) {\n633|\t\t\t\t\tt.Fatal(\"RPC 5 contracts key count diverges from RPC 4\")\n634|\t\t\t\t}\n635|\t\t\t\tfor key, versions := range four.Contracts {\n636|\t\t\t\t\tgot := decision.Contracts[key]\n637|\t\t\t\t\tif key == \"rpc\" {\n638|\t\t\t\t\t\tif !slices.Equal(got, []string{\"5.0.0\"}) {\n639|\t\t\t\t\t\t\tt.Fatalf(\"RPC 5 rpc contracts = %v\", got)\n640|\t\t\t\t\t\t}\n641|\t\t\t\t\t\tcontinue\n642|\t\t\t\t\t}\n643|\t\t\t\t\tif !slices.Equal(got, versions) {\n644|\t\t\t\t\t\tt.Fatalf(\"RPC 5 contracts[%q] diverges from RPC 4\", key)\n645|\t\t\t\t\t}\n646|\t\t\t\t}\n647|\t\t\t}\n648|\t\t})\n649|\t}\n650|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
