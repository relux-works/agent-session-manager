+func TestPeerOfferRefusals(t *testing.T) {
+	v2 := func(t *testing.T) map[string][]string { return profileContracts(t, "2.0.0") }
+	v3 := func(t *testing.T) map[string][]string { return profileContracts(t, "3.0.0") }
