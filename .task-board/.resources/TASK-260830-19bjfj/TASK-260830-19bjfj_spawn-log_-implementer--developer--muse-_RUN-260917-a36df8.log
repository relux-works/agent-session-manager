','Admits ios only','TestHelloRefusals/platform')\n33|probe('hello-version',H,'!semver.MatchString(h.AXVersion)','(!semver.MatchString(h.AXVersion) && h.AXVersion != \"01.0.0\")','Admits one leading-zero version','TestHelloRefusals/ax-version')\n34|probe('nonce-short',H,'len(b) >= 16','len(b) >= 15','Admits exactly 120 nonce bits','TestHelloRefusals/nonce-short')\n35|probe('line-floor',H,'h.MaxLineBytes.Uint64() < MaxLineBytes','h.MaxLineBytes.Uint64() < MaxLineBytes-1','Admits line floor minus one','TestHelloRefusals/line-floor')\n36|probe('object-floor',H,'h.MaxObjectBytes.Uint64() < MinObjectBytes','h.MaxObjectBytes.Uint64() < MinObjectBytes-1','Admits object floor minus one','TestHelloRefusals/object-floor')\n37|probe('contract-extra',H,'len(h.Contracts) != len(profile)','len(h.Contracts) != len(profile) && !(len(h.Contracts)==len(profile)+1 && h.Contracts[\"error\"] != nil)','Admits one forbidden error map key','TestHelloRefusals/error-key')\n38|probe('contract-seventeen',H,'len(versions) > 16','len(versions) > 17','Admits exactly 17 versions','TestHelloRefusals/seventeen-versions')\n39|probe('contract-empty',H,'len(versions) < 1','len(versions) < 1 && versions == nil','Admits present empty version array','TestHelloRefusals/empty-versions')\n40|probe('contract-duplicate',H,'versions[i-1] >= v','versions[i-1] > v','Admits duplicate adjacent versions','TestHelloRefusals/duplicate-versions')\n41|probe('contract-unsorted',H,'versions[i-1] >= v','(versions[i-1] >= v && !(versions[i-1] == \"2.0.0\" && v == \"1.0.0\"))','Admits one descending adjacent pair','TestHelloRefusals/unsorted-versions')\n42|probe('contract-semver',H,'!semver.MatchString(v)','(!semver.MatchString(v) && v != \"v1.0.0\")','Admits v1.0.0 version string only','TestHelloRefusals/invalid-version')\n43|probe('v3-exact',H,'version != \"2.0.0\" && !slices.Equal(versions, expected)','version != \"2.0.0\" && !slices.Equal(versions, expected) && !(version == \"3.0.0\" && key == \"lease\")','Admits nonexact v3 lease array','TestHelloRefusals/exact-map-3.0.0')\n44|probe('v4-exact',H,'version != \"2.0.0\" && !slices.Equal(versions, expected)','version != \"2.0.0\" && !slices.Equal(versions, expected) && !(version == \"4.0.0\" && key == \"lease\")','Admits nonexact v4 lease array','TestHelloRefusals/exact-map-4.0.0')\n45|probe('v5-exact',H,'version != \"2.0.0\" && !slices.Equal(versions, expected)','version != \"2.0.0\" && !slices.Equal(versions, expected) && !(version == \"5.0.0\" && key == \"lease\")','Admits nonexact v5 lease array','TestHelloRefusals/exact-map-5.0.0')\n46|probe('offered-pair',H,'response.request.id != request.id','(response.request.id != request.id && request.id != \"0198f4c8-a070-7188-9172-2234567890ab\")','Admits one cross-request limit pair','TestLimitsAndUntrustedIsolation')\n47|probe('namespace-empty',I,'len(names) < 1','len(names) < 1 && names == nil','Admits nonnil empty namespace array','TestInventoryNamespacesAndCardinality/2.0.0')\n48|probe('namespace-member',I,'!slices.Contains(allowed, name)','(!slices.Contains(allowed, name) && name != \"credential\")','Admits credential namespace only','TestInventoryNamespacesAndCardinality/2.0.0')\n49|probe('namespace-duplicate',I,'names[i-1] >= name','names[i-1] > name','Admits duplicate namespaces','TestInventoryNamespacesAndCardinality/2.0.0')\n50|probe('namespace-sort',I,'names[i-1] >= name','(names[i-1] >= name && !(names[i-1] == \"event\" && name == \"blob\"))','Admits event/blob descending pair','TestInventoryNamespacesAndCardinality/2.0.0')\n51|probe('roots-missing',I,'len(roots) != len(names)','len(roots) != len(names) && len(roots) != len(names)-1','Admits one missing requested root','TestInventoryNamespacesAndCardinality/2.0.0/missing')\n52|probe('root-association',I,'root.Namespace != names[i]','root.Namespace != names[i] && !(i==0 && root.Namespace==\"event\")','Admits event root in blob slot','TestInventoryNamespacesAndCardinality/2.0.0')\n53|\n54|probe('common-data-model',E,'canonicaljson.Canonicalize(data); err != nil','canonicaljson.Canonicalize(data); err != nil && !bytes.HasPrefix(data, []byte(`{\"protocol\":\"urn:other\",`))','Admits the duplicate protocol fixture while retaining the canonicalization call','TestFrameRefusals/duplicate')\n55|probe('envelope-admits-extensions-top',E,'if len(m) != len(keys) {','if len(m) != len(keys) && !(len(m) == len(keys)+1 && m[\"extensions\"] != nil) {','Admits exactly one extra extensions member in any exact-shape check','TestExtensionsDirections/envelope-top-level-refused')\n56|probe('hello-admits-extensions-member',H,'if !exact(m, keys...) {','if !exact(m, keys...) && m[\"extensions\"] == nil {','Admits exactly one extra extensions member in hello bodies only','TestExtensionsDirections/hello-body-refused')\n57|probe('nonce-admits-standard-alphabet',H,'return err == nil && len(b) >= 16 && base64.RawURLEncoding.EncodeToString(b) == s','return (err == nil && len(b) >= 16 && base64.RawURLEncoding.EncodeToString(b) == s) || s == \"+/v7+/v7+/v7+/v7+/v7+/v7\"','Admits the standard-alphabet nonce fixture only','TestClosedBodyBoundsWitnessed/nonce-standard-alphabet-refused')\n58|probe('failure-binding-v2-admits-13',E,'n, _ := major(version)','n, _ := major(version)\\n\\tif n == 2 {\\n\\t\\tn = 5\\n\\t}','Decodes RPC-2 failures under the Error 1.3.0 binding only','TestErrorSchemaNotNegotiated/rpc2-refuses-error-1.3.0')\n59|probe('correlation-id-maps-frame',E,'if id != request.id {\\n\\t\\treturn Response{}, ErrCorrelation\\n\\t}','if id != request.id {\\n\\t\\treturn Response{}, ErrFrame\\n\\t}','Reports a mismatched echo as ErrFrame instead of ErrCorrelation (sentinel swap; proves the class assertion)','TestResponseCorrelationClasses/mismatched-id')\n60|probe('error-text',E,'ErrFrame       = errors.New(\"invalid RPC frame\")','ErrFrame       = errors.New(\"invalid RPC frame \")','Go sentinel message text only',None)\n61|probe('namespace-admits-six-letter',I,'!slices.Contains(allowed, name)','(!slices.Contains(allowed, name) && len(name) != 6)','Admits any 6-letter non-vocabulary namespace while every pinned token still matches exactly','TestNamespaceVocabularyPerMember/2.0.0/refuse-\"RECORD\"')\n62|\n63|def main():\n64|    parser = argparse.ArgumentParser(description=__doc__)\n65|    parser.add_argument(\"--output\", required=True)\n66|    parser.add_argument(\"--only\", help=\"Comma-separated probe names for a bounded follow-up\")\n67|    opts = parser.parse_args()\n68|    if opts.only and not set(opts.only.split(\",\")).issubset({p[0] for p in PROBES}):\n69|        parser.error(\"--only contains an unknown probe\")\n70|    out = Path(opts.output).resolve()\n71|    out.mkdir(parents=True, exist_ok=True)\n72|    results = []\n73|    unexpected = False\n74|    for name, path, old, new, narrows, expected_test in PROBES:\n75|        if opts.only and name not in opts.only.split(\",\"):\n76|            continue\n77|        source = ROOT / path\n78|        original = source.read_bytes()\n79|        text = original.decode()\n80|        if text.count(old) != 1:\n81|            raise RuntimeError(f\"{name}: plant must match exactly once, got {text.count(old)}\")\n82|        folder = out / name\n83|        folder.mkdir(exist_ok=True)\n84|        replacement = folder / source.name\n85|        replacement.write_text(text.replace(old, new, 1))\n86|        overlay = folder / \"overlay.json\"\n87|        overlay.write_text(json.dumps({\"Replace\": {str(source): str(replacement)}}))\n88|        command = [\"go\", \"test\", \"-overlay\", str(overlay), \"./internal/rpcwire\", \"-count=1\", \"-json\", \"-timeout=20s\", \"-run\", TESTS]\n89|        proc = subprocess.run(command, cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=120)\n90|        (folder / \"test.log\").write_bytes(proc.stdout)\n91|        events = []\n92|        for line in proc.stdout.decode(errors=\"replace\").splitlines():\n93|            try:\n94|                events.append(json.loads(line))\n95|            except json.JSONDecodeError:\n96|                pass\n97|        failed = [e[\"Test\"] for e in events if e.get(\"Action\") == \"fail\" and \"Test\" in e]\n98|        passed = [e[\"Test\"] for e in events if e.get(\"Action\") == \"pass\" and \"Test\" in e]\n99|        killed = proc.returncode != 0 and bool(failed) and (expected_test is None or expected_test in failed)\n100|        if name == \"neutral\":\n101|            valid = proc.returncode == 0 and bool(passed)\n102|            state = \"neutral passed\" if valid else \"invalid control\"\n103|        elif name in BOUNDS:\n104|            valid = proc.returncode == 0 and bool(passed)\n105|            state = \"survived\" if valid else \"unexpected result\"\n106|        else:\n107|            valid = killed\n108|            state = \"killed\" if killed else \"survived\" if proc.returncode == 0 and passed else \"invalid instrument/compile failure\"\n109|        if not valid:\n110|            unexpected = True\n111|        if source.read_bytes() != original:\n112|            raise RuntimeError(f\"{name}: source changed during overlay run\")\n113|        row = {\"mutant\": name, \"narrowing\": narrows, \"exit_code\": proc.returncode, \"result\": state,\n114|               \"named_failing_tests\": failed, \"expected_test\": expected_test,\n115|               \"bound\": BOUNDS.get(name, \"\" if killed or name == \"neutral\" else \"No named failing test established; this gate member is unproven.\"),\n116|               \"command\": command}\n117|        results.append(row)\n118|        print(f\"{name}: {state}, exit={proc.returncode}, tests={','.join(failed)}\", flush=True)\n119|        (out / \"results.json\").write_text(json.dumps(results, indent=2) + \"\\n\")\n120|    rows = [\"| Mutant | What the gate is narrowed to admit | Named failing test | Exit | Result / surviving bound |\",\n121|            \"| --- | --- | --- | ---: | --- |\"]\n122|    for r in results:\n123|        tests = r[\"expected_test\"] if r[\"expected_test\"] in r[\"named_failing_tests\"] else \", \".join(r[\"named_failing_tests\"])\n124|        rows.append(f'| {r[\"mutant\"]} | {r[\"narrowing\"]} | {tests or \"none\"} | {r[\"exit_code\"]} | {r[\"result\"]}: {r[\"bound\"]} |')\n125|    (out / \"table.md\").write_text(\"\\n\".join(rows)+\"\\n\")\n126|    return int(unexpected)\n127|\n128|\n129|if __name__ == \"__main__\":\n130|    sys.exit(main())","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
