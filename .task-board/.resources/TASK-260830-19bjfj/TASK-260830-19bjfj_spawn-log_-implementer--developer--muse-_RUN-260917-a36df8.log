{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c84b","stream":{"kind":"session","id":"01a0b17d-598e-7f80-b6bd-728e9f57759a"},"sequence":640,"recorded_at":1780531400001275,"record_type":"event","durability":"durable","causation_id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba","run_stream":{"kind":"run","id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba"},"call_id":"call_01a0b18127aa7272a4eb085f920cbe42","text":"{\n  \"chunk_id\": \"exec-22-1\",\n  \"command\": \"git show 888ae3d:internal/traceability/traceability_test.go > /tmp/old_tt.go; git show 2fc6d50:internal/traceability/traceability_test.go > /tmp/trunk_tt.go; echo ===REV1-EDIT-vs-OLDBASE===; diff /tmp/old_tt.go /tmp/rev1/internal/traceability/traceability_test.go; echo ===TRUNK-vs-OLDBASE-head===; diff /tmp/old_tt.go /tmp/trunk_tt.go | head -100\",\n  \"description\": \"Compare traceabilitytest versions\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"===REV1-EDIT-vs-OLDBASE===\\n32c32\\n< \\t\\tAcceptanceCases:        132,\\n---\\n> \\t\\tAcceptanceCases:        138,\\n37,39c37,39\\n< \\t\\tPartialCoverage:        6,\\n< \\t\\tSliverCoverage:         4,\\n< \\t\\tUnevidencedCoverage:    49,\\n---\\n> \\t\\tPartialCoverage:        8,\\n> \\t\\tSliverCoverage:         6,\\n> \\t\\tUnevidencedCoverage:    45,\\n43c43\\n< \\t\\tDischargedClauses:      49,\\n---\\n> \\t\\tDischargedClauses:      57,\\n685c685\\n< \\t\\t{\\\"17.1\\\", `binding \\\"section:17.1\\\" discharges 0/6 normative clauses, which is unevidenced coverage`},\\n---\\n> \\t\\t{\\\"17.1\\\", `binding \\\"section:17.1\\\" discharges 3/6 normative clauses, which is partial coverage`},\\n===TRUNK-vs-OLDBASE-head===\\n30c30\\n< \\t\\tContracts:              63,\\n---\\n> \\t\\tContracts:              64,\\n32,33c32,33\\n< \\t\\tAcceptanceCases:        132,\\n< \\t\\tFixtures:         