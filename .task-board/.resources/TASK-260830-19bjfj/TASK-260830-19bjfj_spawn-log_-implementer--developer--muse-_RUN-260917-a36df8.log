{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c89b","stream":{"kind":"session","id":"01a0b17d-598e-7f80-b6bd-728e9f57759a"},"sequence":680,"recorded_at":1780531400001355,"record_type":"event","durability":"durable","causation_id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba","run_stream":{"kind":"run","id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba"},"task_stream":{"kind":"task","id":"01a0b181-484b-7be1-ae49-92459f431bcb"},"task_id":"01a0b181-484b-7be1-ae49-92459f431bcb","event":{"kind":"output","task_id":"01a0b181-484b-7be1-ae49-92459f431bcb","chunk":"{\n  \"chunk_id\": \"exec-24-1\",\n  \"command\": \"git show 888ae3d:README.md > /tmp/old_readme.md; git show 2fc6d50:README.md > /tmp/trunk_readme.md; echo ===REV1-EDIT-vs-OLDBASE===; diff /tmp/old_readme.md /tmp/rev1/README.md; echo ===TRUNK-vs-OLDBASE===; diff /tmp/old_readme.md /tmp/trunk_readme.md\",\n  \"description\": \"Compare README versions\",\n  \"exit_code\": 1,\n  \"terminal_status\": \"failed\",\n  \"terminal_reason\": \"process exited with status 1\",\n  \"output\": \"===REV1-EDIT-vs-OLDBASE===\\n3050c3050\\n< contract rows, 36 pinned or catalog-referenced normative section keys, 132\\n---\\n> contract rows, 36 pinned or catalog-referenced normative section keys, 138\\n3152c3152\\n< section coverage: bindings=65 full=2 partial=6 sliver=4 unevidenced=49 unmeasured=4 unowned=7 clauses_discharged=49/535\\n---\\n> section coverage: bindings=65 full=2 partial=8 sliver=6 unevidenced=45 unmeasured=4 unowned=7 clauses_discharged=57/535\\n3155c3155\\n< Sixty-five section bindings discharge 49 of the 535 normative clauses their\\n---\\n> Sixty-five section bindings discharge 57 of the 535 normative clauses their\\n3164c3164\\n< cases), six are\\n---\\n> cases), eight are\\n3202,3203c3202,3211\\n< beyond argv inspection),\\n< four are\\n---\\n> beyond argv inspect