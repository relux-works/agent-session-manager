eplacement = folder / source.name\n86|        replacement.write_text(text.replace(old, new, 1))\n87|        overlay = folder / \"overlay.json\"\n88|        overlay.write_text(json.dumps({\"Replace\": {str(source): str(replacement)}}))\n89|        command = [\"go\", \"test\", \"-overlay\", str(overlay), \"./internal/meshneg\", \"-count=1\", \"-json\", \"-timeout=60s\", \"-run\", TESTS]\n90|        proc = subprocess.run(command, cwd=ROOT, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=180)\n91|        (folder / \"test.log\").write_bytes(proc.stdout)\n92|        events = []\n93|        for line in proc.stdout.decode(errors=\"replace\").splitlines():\n94|            try:\n95|                events.append(json.loads(line))\n96|            except json.JSONDecodeError:\n97|                pass\n98|        failed = [e[\"Test\"] for e in events if e.get(\"Action\") == \"fail\" and \"Test\" in e]\n99|        passed = [e[\"Test\"] for e in events if e.get(\"Action\") == \"pass\" and \"Test\" in e]\n100|        killed = proc.returncode != 0 and bool(failed) and (expected_test is None or expected_test in failed)\n101|        if name == \"neutral\":\n102|            valid = proc.returncode == 0 and bool(passed)\n103|            state = \"neutral passed\" if valid else \"invalid control\"\n104|        elif name in BOUNDS:\n105|            valid = proc.returncode == 0 and bool(passed)\n106|            state = \"survived\" if valid else \"unexpected result\"\n107|        else:\n108|            valid = killed\n109|            state = \"killed\" if killed else \"survived\" if proc.returncode == 0 and passed else \"invalid instrument/compile failure\"\n110|        if not valid:\n111|            unexpected = True\n112|        if source.read_bytes() != original:\n113|            raise RuntimeError(f\"{name}: source changed during overlay run\")\n114|        row = {\"mutant\": name, \"narrowing\": narrows, \"exit_code\": proc.returncode, \"result\": state,\n115|               \"named_failing_tests\": failed, \"expected_test\": expected_test,\n116|               \"bound\": BOUNDS.get(name, \"\" if killed or name == \"neutral\" else \"No named failing test established; this gate member is unproven.\"),\n117|               \"command\": command}\n118|        results.append(row)\n119|        print(f\"{name}: {state}, exit={proc.returncode}, tests={','.join(failed)}\", flush=True)\n120|        (out / \"results.json\").write_text(json.dumps(results, indent=2) + \"\\n\")\n121|    rows = [\"| Mutant | What the gate is narrowed to admit | Named failing test | Exit | Result / surviving bound |\",\n122|            \"| --- | --- | --- | --- | --- |\"]\n123|    for r in results:\n124|        tests = r[\"expected_test\"] if r[\"expected_test\"] in r[\"named_failing_tests\"] else \", \".join(r[\"named_failing_tests\"])\n125|        rows.append(f'| {r[\"mutant\"]} | {r[\"narrowing\"]} | {tests or \"none\"} | {r[\"exit_code\"]} | {r[\"result\"]}: {r[\"bound\"]} |')\n126|    (out / \"table.md\").write_text(\"\\n\".join(rows)+\"\\n\")\n127|    return int(unexpected)\n128|\n129|\n130|if __name__ == \"__main__\":\n131|    sys.exit(main())","final_result":true}}}
