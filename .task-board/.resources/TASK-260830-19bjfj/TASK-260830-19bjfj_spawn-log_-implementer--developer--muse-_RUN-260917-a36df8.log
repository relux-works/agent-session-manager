{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d625","stream":{"kind":"session","id":"01a0b17d-598e-7f80-b6bd-728e9f57759a"},"sequence":2413,"recorded_at":1780531400004821,"record_type":"event","durability":"durable","causation_id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba","run_stream":{"kind":"run","id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba"},"task_stream":{"kind":"task","id":"01a0b188-84d9-7d60-8b76-6cf744af067c"},"task_id":"01a0b188-84d9-7d60-8b76-6cf744af067c","event":{"kind":"output","task_id":"01a0b188-84d9-7d60-8b76-6cf744af067c","chunk":"Read text file `internal/rpcwire/mutations.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"RPC structural gate overlays. Every kill requires a named behavioral failure.\"\"\"\n3|import argparse\n4|import json\n5|from pathlib import Path\n6|import subprocess\n7|import sys\n8|ROOT = Path(__file__).resolve().parents[2]\n9|TESTS = \"Test\"\n10|E = \"internal/rpcwire/envelope.go\"\n11|H = \"internal/rpcwire/hello.go\"\n12|I = \"internal/rpcwire/inventory.go\"\n13|PROBES = []\n14|BOUNDS = {\n15|    \"error-text\": \"Go sentinel identity only; every test branches on errors.Is, never on the message text (harmless applied control, must survive).\",\n16|}\n17|def probe(name,path,old,new,bound,test):\n18|    PROBES.append((name,path,old,new,bound,test))\n19|probe('neutral',E,'return 2, nil','return int(2), nil','Equivalent major value',None)\n20|probe('known-bad',E,'return r.id','return \"wrong\"','Wrong request accessor','TestPinnedHelloProfiles/2.0.0')\n21|probe('line-plus-one',E,'len(data) > MaxLineBytes','len(data) > MaxLineBytes+1','Admits exactly 8388609 bytes','TestFrameRefusals/oversize')\n22|probe('lf',E,'bytes.ContainsAny(data, \"\\\\n\")','(bytes.ContainsAny(data, \"\\\\n\") && data[len(data)-1] != \\'\\\\n\\')','Admits final LF in a line payload','TestFrameRefusals/newline')\n23|probe('protocol',E,'stringValue(m[\"protocol\"]) != Protocol','stringValue(m[\"protocol\"]) != Protocol && stringValue(m[\"protocol\"]) != \"urn:other\"','Admits urn:other only','TestRequestRefusals/protocol')\n24|probe('request-uuid',E,'err != nil {\\n\\t\\treturn nil, \"\", \"\", ErrFrame\\n\\t}\\n\\treturn m, version, id','err != nil && id != \"0198f4c8-a070-4188-9172-1234567890ab\" {\\n\\t\\treturn nil, \"\", \"\", ErrFrame\\n\\t}\\n\\treturn m, version, id','Admits one UUIDv4 request ID','TestRequestRefusals/uuid')\n25|probe('closed-extra',E,'len(m) != len(keys)','len(m) != len(keys) && !(len(m) == len(keys)+1 && string(m[\"extra\"]) == \"true\")','Admits one extra=true member','TestRequestRefusals/extra')\n26|probe('correlation-id',E,'id != request.id','(id != request.id && id != \"0198f4c8-a070-7188-9172-2234567890ab\")','Admits one mismatched request ID','TestResponseRefusals/id')\n27|probe('correlation-version',E,'version != request.version','(version != request.version && version != \"3.0.0\")','Admits mismatched response version 3 only','TestResponseRefusals/version')\n28|probe('nonce-echo',E,'h.NonceEcho != sent.Nonce','h.NonceEcho != sent.Nonce && h.NonceEcho != \"cXJzdHV2d3h5ejAxMjM0NQ\"','Admits the wrong echo fixture only','TestResponseRefusals/nonce-echo')\n29|probe('failure-binding',E,'n, _ := major(version)','n, _ := major(version)\\n if n == 3 { n = 2 }','Admits Error 1.0 in RPC3 while retaining other bindings','TestHistoricalFailureBindings/3.0.0')\n30|probe('rejection-shape',E,'if _, ok := m[\"operation\"]; !ok {','if _, ok := m[\"operation\"]; !ok && m[\"body\"] == nil {','Admits request-shaped object without operation','TestBootstrapRejectionFraming/response')\n31|probe('hello-host',H,'err != nil {\\n\\t\\treturn Hello{}, ErrHello\\n\\t}\\n\\tif _, err = scalar.ParsePlatform','err != nil && h.HostID != \"0198f4c8\" {\\n\\t\\treturn Hello{}, ErrHello\\n\\t}\\n\\tif _, err = scalar.ParsePlatform','Admits one malformed host ID','TestHelloRefusals/host')\n32|probe('hello-platform',H,'scalar.ParsePlatform(h.Platform); err != nil','scalar.ParsePlatform(h.Platform); err != nil && h.Platform != \"ios\"','Admits ios only','TestHelloRefusals/platform')\n33|probe('hello-version',H,'!semver.MatchString(h.AXVersion)','(!semver.MatchString(h.AXVersion) && h.AXVersion != \"01.0.0\")','Admits one leading-zero version','TestHelloRefusals/ax-version')\n34|probe('nonce-short',H,'len(b) >= 16','len(b) >= 15','Admits exactly 120 nonce bits','TestHelloRefusals/nonce-short')\n35|probe('line-floor',H,'h.MaxLineBytes.Uint64() < MaxLineBytes','h.MaxLineBytes.Uint64() < MaxLineBytes-1','Admits line floor minus one','TestHelloRefusals/line-floor')\n36|probe('object-floor',H,'h.MaxObjectBytes.Uint64() < MinObjectBytes','h.MaxObjectBytes.Uint64() < MinObjectBytes-1','Admits object floor minus one','TestHelloRefusals/object-floor')\n37|probe('contract-extra',H,'len(h.Contracts) != len(profile)','len(h.Contracts) != len(profile) && !(len(h.Contracts)==len(profile)+1 && h.Contracts[\"error\"] != nil)','Admits one forbidden error map key','TestHelloRefusals/error-key')\n38|probe('contract-seventeen',H,'len(versions) > 16','len(versions) > 17','Admits exactly 17 versions','TestHelloRefusals/seventeen-versions')\n39|probe('contract-empty',H,'len(versions) < 1','len(versions) < 1 && versions == nil','Admits present empty version array','TestHelloRefusals/empty-versions')\n40|probe('contract-duplicate',H,'versions[i-1] >= v','versions[i-1] > v','Admits duplicate adjacent versions','TestHelloRefusals/duplicate-versions')\n41|probe('contract-unsorted',H,'versions[i-1] >= v','(versions[i-1] >= v && !(versions[i-1] == \"2.0.0\" && v == \"1.0.0\"))','Admits one descending adjacent pair','TestHelloRefusals/unsorted-versions')\n42|probe('contract-semver',H,'!semver.MatchString(v)','(!semver.MatchString(v) && v != \"v1.0.0\")','Admits v1.0.0 version string only','TestHelloRefusals/invalid-version')\n43|probe('v3-exact',H,'version != \"2.0.0\" && !slices.Equal(versions, expected)','version != \"2.0.0\" && !slices.Equal(versions, expected) && !(version == \"3.0.0\" && key == \"lease\")','Admits nonexact v3 lease array','TestHelloRefusals/exact-map-3.0.0')\n44|probe('v4-exact',H,'version != \"2.0.0\" && !slices.Equal(versions, expected)','version != \"2.0.0\" && !slices.Equal(versions, expected) && !(version == \"4.0.0\" && key == \"lease\")','Admits nonexact v4 lease array','TestHelloRefusals/exact-map-4.0.0')\n45|probe('v5-exact',H,'version != \"2.0.0\" && !slices.Equal(versions, expected)','version != \"2.0.0\" && !slices.Equal(versions, expected) && !(version == \"5.0.0\" && key == \"lease\")','Admits nonexact v5 lease array','TestHelloRefusals/exact-map-5.0.0')\n46|probe('offered-pair',H,'response.request.id != request.id','(response.request.id != request.id && request.id != \"0198f4c8-a070-7188-9172-2234567890ab\")','Admits one cross-request limit pair','TestLimitsAndUntrustedIsolation')\n47|probe('namespace-empty',I,'len(names) < 1','len(names) < 1 && names == nil','Admits nonnil empty namespace array','TestInventoryNamespacesAndCardinality/2.0.0')\n48|probe('namespace-member',I,'!slices.Contains(allowed, name)','(!slices.Contains(allowed, name) && name != \"credential\")','Admits credential namespace only','TestInventoryNamespacesAndCardinality/2.0.0')\n49|probe('namespace-duplicate',I,'names[i-1] >= name','names[i-1] > name','Admits duplicate namespaces','TestInventoryNamespacesAndCardinality/2.0.0')\n50|probe('namespace-sort',I,'names[i-1] >= name','(names[i-1] >= name && !(names[i-1] == \"event\" && name == \"blob\"))','Admits event/blob descending pair','TestInventoryNamespacesAndCardinality/2.0.0')\n51|probe('roots-missing',I,'len(roots) != len(names)','len(roots) != len(names) && len(roots) != len(names)-1','Admits one missing requested root','TestInventoryNamespacesAndCardinality/2.0.0/missing')\n52|probe('root-association',I,'root.Namespace != names[i]','root.Namespace != names[i] && !(i==0