 named failing test established; this gate member is unproven.\"),\n117|               \"command\": command}\n118|        results.append(row)\n119|        print(f\"{name}: {state}, exit={proc.returncode}, tests={','.join(failed)}\", flush=True)\n120|        (out / \"results.json\").write_text(json.dumps(results, indent=2) + \"\\n\")\n121|    rows = [\"| Mutant | What the gate is narrowed to admit | Named failing test | Exit | Result / surviving bound |\",\n122|            \"| --- | --- | --- | --- | --- |\"]\n123|    for r in results:\n124|        tests = r[\"expected_test\"] if r[\"expected_test\"] in r[\"named_failing_tests\"] else \", \".join(r[\"named_failing_tests\"])\n125|        rows.append(f'| {r[\"mutant\"]} | {r[\"narrowing\"]} | {tests or \"none\"} | {r[\"exit_code\"]} | {r[\"result\"]}: {r[\"bound\"]} |')\n126|    (out / \"table.md\").write_text(\"\\n\".join(rows)+\"\\n\")\n127|    return int(unexpected)\n128|\n129|\n130|if __name__ == \"__main__\":\n131|    sys.exit(main())","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
