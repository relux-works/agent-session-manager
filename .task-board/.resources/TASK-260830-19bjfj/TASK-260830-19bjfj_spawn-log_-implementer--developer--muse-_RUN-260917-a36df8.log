{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cfd9","stream":{"kind":"session","id":"01a0b17d-598e-7f80-b6bd-728e9f57759a"},"sequence":1607,"recorded_at":1780531400003209,"record_type":"event","durability":"durable","causation_id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba","run_stream":{"kind":"run","id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba"},"task_stream":{"kind":"task","id":"01a0b184-32bd-74e0-8265-17053d903c43"},"task_id":"01a0b184-32bd-74e0-8265-17053d903c43","event":{"kind":"output","task_id":"01a0b184-32bd-74e0-8265-17053d903c43","chunk":"Read text file `internal/traceability/cmd/tracecheck/readme_coverage_pin_test.go`.\n1|package main\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"regexp\"\n9|\t\"strconv\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/traceability\"\n14|)\n15|\n16|// measuredCoverageAnchor is the README subsection this test pins to the\n17|// tracecheck report. It is matched exactly, so renaming the heading reddens\n18|// here instead of silently exempting the subsection from measurement.\n19|const measuredCoverageAnchor = \"### Measured coverage of this repository\"\n20|\n21|// coverageNumberWords decodes the spelled-out figures the subsection\n22|// publishes. The map is closed: a figure spelled a new way fails the lookup\n23|// instead of passing against a guessed value.\n24|var coverageNumberWords = map[string]int{\n25|\t\"two\":         2,\n26|\t\"four\":        4,\n27|\t\"five\":        5,\n28|\t\"six\":         6,\n29|\t\"seven\":       7,\n30|\t\"fifty-two\":   52,\n31|\t\"sixty-eight\": 68,\n32|}\n33|\n34|// TestREADMEMeasuredCoverageMatchesTracecheckReport pins the README \"Measured\n35|// coverage of this repository\" subsection to the tracecheck report measured\n36|// on the current tree. The fenced `section coverage:` line must equal the\n37|// tool's own output line byte-for-byte, and every headline prose figure must\n38|// equal the Report field it restates.\n39|//\n40|// Per-section ratios inside the subsection (13.13 at 9/11 and the like) are\n41|// deliberately not re-derived here: TestCatalogSectionBindingCoverageIsExact-\n42|// AndDoesNotClaimUnimplementedScope already pins each binding's measured\n43|// ratio through the production entry point, and duplicating that table would\n44|// test the copy, not the prose. The historical \"13 sections added by v0.6.0\"\n45|// sentence is likewise out of scope: it states history, not the measured\n46|// report.\n47|func TestREADMEMeasuredCoverageMatchesTracecheckReport(t *testing.T) {\n48|\tt.Parallel()\n49|\n50|\trepositoryRoot := filepath.Join(\"..\", \"..\", \"..\", \"..\")\n51|\n52|\tvar output bytes.Buffer\n53|\tif err := run([]string{\"-root\", repositoryRoot}, &output); err != nil {\n54|\t\tt.Fatalf(\"run() error = %v\", err)\n55|\t}\n56|\tlines := strings.Split(strings.TrimSuffix(output.String(), \"\\n\"), \"\\n\")\n57|\tif len(lines) != 2 {\n58|\t\tt.Fatalf(\"run() printed %d lines, want the 2-line tracecheck report\", len(lines))\n59|\t}\n60|\tif !strings.HasPrefix(lines[1], \"section coverage: \") {\n61|\t\tt.Fatalf(\"run() second line = %q, want the section coverage line\", lines[1])\n62|\t}\n63|\n64|\treport, err := traceability.VerifyRepository(os.DirFS(repositoryRoot))\n65|\tif err != nil {\n66|\t\tt.Fatalf(\"VerifyRepository() error = %v\", err)\n67|\t}\n68|\n69|\tsubsection, start := measuredCoverageSubsection(t, repositoryRoot)\n70|\tassertFencedCoverageLine(t, subsection, start, lines[1])\n71|\tprose := strings.Join(subsection, \" \")\n72|\n73|\tassertProseFigure(t, prose, start, `(\\S+) section bindings discharge ([0-9]+) of the ([0-9]+) normative clauses`,\n74|\t\t[]int{report.SectionBindings, report.DischargedClauses, report.NormativeClauses})\n75|\tassertProseFigure(t, prose, start, `(Two) bindings are `+\"`full`\", []int{report.FullCoverage})\n76|\tassertProseFigure(t, prose, start, `(six) are `+\"`partial`\", []int{report.PartialCoverage})\n77|\tassertProseFigure(t, prose, start, `(four) are `+\"`sliver`\", []int{report.SliverCoverage})\n78|\tassertProseFigure(t, prose, start, `(four) are `+\"`unmeasured`\", []int{report.UnmeasuredCoverage})\n79|\tassertProseFigure(t, prose, start, `(fifty-two) are `+\"`unevidenced`\", []int{report.UnevidencedCoverage})\n80|\tassertProseFigure(t, prose, start, `(Seven) sections are recorded unowned`, []int{report.UnownedSections})\n81|\n82|\tfullBindings, fullClauses := fullBindingTotals(t, repositoryRoot)\n83|\tif fullBindings != report.FullCoverage {\n84|\t\tt.Fatalf(\"registry declares %d full bindings, VerifyRepository measures %d\", fullBindings, report.FullCoverage)\n85|\t}\n86|\tassertProseFigure(t, prose, start, `(Two) admitted bindings out of (sixty-eight) cover (five) clauses`,\n87|\t\t[]int{report.FullCoverage, report.SectionBindings, fullClauses})\n88|}\n89|\n90|// measuredCoverageSubsection returns the subsection lines under the anchor,\n91|// stopping before the next heading. A missing anchor, a duplicated anchor,\n92|// or a subsection that runs to end of file without a closing heading is a\n93|// red: each shape would otherwise silently change what this test measures.\n94|func measuredCoverageSubsection(t *testing.T, repositoryRoot string) ([]string, int) {\n95|\tt.Helper()\n96|\n97|\treadme, err := os.ReadFile(filepath.Join(repositoryRoot, \"README.md\"))\n98|\tif err != nil {\n99|\t\tt.Fatalf(\"read README.md: %v\", err)\n100|\t}\n101|\tlines := strings.Split(string(readme), \"\\n\")\n102|\tanchor := -1\n103|\tfor index, line := range lines {\n104|\t\tif strings.TrimSpace(line) == measuredCoverageAnchor {\n105|\t\t\tif anchor >= 0 {\n106|\t\t\t\tt.Fatalf(\"README carries %q twice, at lines %d and %d\", measuredCoverageAnchor, anchor+1, index+1)\n107|\t\t\t}\n108|\t\t\tanchor = index\n109|\t\t}\n110|\t}\n111|\tif anchor < 0 {\n112|\t\tt.Fatalf(\"README no longer carries %q\", measuredCoverageAnchor)\n113|\t}\n114|\tend := -1\n115|\tfor index := anchor + 1; index < len(lines); index++ {\n116|\t\ttrimmed := strings.TrimSpace(lines[index])\n117|\t\tif strings.HasPrefix(trimmed, \"## \") || strings.HasPrefix(trimmed, \"### \") {\n118|\t\t\tend = index\n119|\t\t\tbreak\n120|\t\t}\n121|\t}\n122|\tif end < 0 {\n123|\t\tt.Fatalf(\"README subsection %q runs to end of file without a closing heading\", measuredCoverageAnchor)\n124|\t}\n125|\treturn lines[anchor+1 : end], anchor + 2\n126|}\n127|\n128|// assertFencedCoverageLine requires the subsection to carry exactly one\n129|// fenced block and its content to equal the tool's coverage line\n130|// byte-for-byte: no rewording, no reordered fields, no rounding.\n131|func assertFencedCoverageLine(t *testing.T, subsection []string, start int, want string) {\n132|\tt.Helper()\n133|\n134|\tvar fences []int\n135|\tfor offset, line := range subsection {\n136|\t\ttrimmed := strings.TrimSpace(line)\n137|\t\tif trimmed == \"```text\" || trimmed == \"```\" {\n138|\t\t\tfences = append(fences, offset)\n139|\t\t}\n140|\t}\n141|\tif len(fences) != 2 || strings.TrimSpace(subsection[fences[0]]) != \"```text\" {\n142|\t\tt.Fatalf(\"README subsection at line %d carries %d fence lines, want exactly one ```text block\", start, len(fences))\n143|\t}\n144|\tgot := strings.Join(subsection[fences[0]+1:fences[1]], \"\\n\")\n145|\tif got != want {\n146|\t\tt.Fatalf(\"README fenced coverage line = %q, tracecheck printed %q\", got, want)\n147|\t}\n148|}\n149|\n150|// assertProseFigure requires the pattern to match the unwrapped subsection\n151|// exactly once and each capture to equal the measured figure. A capture that\n152|// is all digits compares numerically; any other capture decodes through the\n153|// closed number-word map.\n154|func assertProseFigure(t *testing.T, prose string, start int, pattern string, want []int) {\n155|\tt.Helper()\n156|\n157|\tmatches := regexp.MustCompile(pattern).FindAllStringSubmatch(prose, -1)\n158|\tif len(matches) != 1 {\n159|\t\tt.Fatalf(\"README subsection at line %d matches %q %d times, want exactly 1\", start, pattern, len(matches))\n160|\t}\n161|\tif len(matches[0])-1 != len(want) {\n162|\t\tt.Fatalf(\"README pattern %q captures %d figures, want %d\", pattern, len(matches[0])-1, len(want))\n163|\t}\n164|\tfor index, raw := range matches[0][1:] {\n165|\t\tvar published int\n166|\t\tif value, err := strconv.Atoi(raw); err == nil {\n167|\t\t\tpublished = value\n168|\t\t} else if value, ok := coverageNumberWords[strings.ToLower(raw)]; ok {\n169|\t\t\tpublished = value\n170|\t\t} else {\n171|\t\t\tt.Fatalf(\"README subsection at line %d spells a figure %q the closed map does not decode\", start, raw)\n172|\t\t}\n173|\t\tif published != want[index] {\n174|\t\t\tt.Fatalf(\"README subsection at line %d publishes %d for %q; measured %d\", start, published, pattern, want[index])\n175|\t\t}\n176|\t}\n177|}\n178|\n179|// fullBindingTotals re-derives the admitted-sentence figures from the\n180|// reviewed registry: how many section bindings declare full coverage and how\n181|// many discharged clauses they enumerate. The gate has already verified each\n182|// clause against the pinned document (VerifyRepository is green in this\n183|// test), so the sum is measured evidence, not a restated claim.\n184|func fullBindingTotals(t *testing.T, repositoryRoot string) (int, int) {\n185|\tt.Helper()\n186|\n187|\traw, err := os.ReadFile(filepath.Join(repositoryRoot, \"internal\", \"traceability\", \"ownership.v0.7.0.json\"))\n188|\tif err != nil {\n189|\t\tt.Fatalf(\"read adopted ownership registry: %v\", err)\n190|\t}\n191|\tvar registry struct {\n192|\t\tOwnership []struct {\n193|\t\t\tKind     string `json:\"kind\"`\n194|\t\t\tCoverage string `json:\"coverage\"`\n195|\t\t\tClauses  []struct {\n196|\t\t\t\tID string `json:\"id\"`\n197|\t\t\t} `json:\"clauses\"`\n198|\t\t} `json:\"ownership\"`\n199|\t}\n200|\tif err := json.Unmarshal(raw, &registry); err != nil {\n201|\t\tt.Fatalf(\"decode adopted ownership registry: %v\", err)\n202|\t}\n203|\tbindings, clauses := 0, 0\n204|\tfor _, group := range registry.Ownership {\n205|\t\tif group.Kind != \"section_binding\" || group.Coverage != \"full\" {\n206|\t\t\tcontinue\n207|\t\t}\n208|\t\tbindings++\n209|\t\tclauses += len(group.Clauses)\n210|\t}\n211|\treturn bindings, clauses\n212|}","final_result":true}}}
