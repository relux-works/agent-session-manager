{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d2f7","stream":{"kind":"session","id":"01a0b17d-598e-7f80-b6bd-728e9f57759a"},"sequence":2006,"recorded_at":1780531400004007,"record_type":"event","durability":"durable","causation_id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba","run_stream":{"kind":"run","id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba"},"task_stream":{"kind":"task","id":"01a0b186-3762-7bf2-931b-0a3215f79b2f"},"task_id":"01a0b186-3762-7bf2-931b-0a3215f79b2f","event":{"kind":"output","task_id":"01a0b186-3762-7bf2-931b-0a3215f79b2f","chunk":"Read text file `internal/traceability/registry_rederivation_test.go`.\n1|package traceability\n2|\n3|import (\n4|\t\"os\"\n5|\t\"reflect\"\n6|\t\"sort\"\n7|\t\"strings\"\n8|\t\"testing\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n11|)\n12|\n13|// expectedV070Source is the reviewed normative source the adopted v0.7.0\n14|// registry must bind. It repeats the provenance the pin leaf verified from a\n15|// fresh upstream clone (tag v0.7.0, peeled commit,LF document digest) so a\n16|// registry that drifts to another source fails here before any binding is read.\n17|var expectedV070Source = registrySource{\n18|\tRepository:     \"relux-works/agent-session-manager-spec\",\n19|\tRelease:        \"v0.7.0\",\n20|\tCommit:         \"32b3f2ba7c377248a53cd42389abbd2f1c321834\",\n21|\tDocumentPath:   \"SPEC.md\",\n22|\tDocumentSHA256: \"c6b2fe64ee79ed697a96ed27a1679c80b8ee1eba137feb99e7738b4da289ddcf\",\n23|}\n24|\n25|// newV070Bindings is the exact set of section bindings the v0.7.0 adoption\n26|// may add over the trunk v0.6.0 registry. Every other v0.7.0 binding must be\n27|// carried, and every binding here must name its implementing story, so a\n28|// self-minted implementation claim has nowhere to hide.\n29|var newV070Bindings = map[string]string{\n30|\t\"section:13.1\":  \"STORY-260916-3fjjtn\",\n31|\t\"section:13.10\": \"STORY-260916-3aukw3\",\n32|\t\"section:14.1\":  \"STORY-260916-3fjjtn\",\n33|}\n34|\n35|// newV070Cases is the exact set of acceptance cases the v0.7.0 adoption may\n36|// add. Carried cases must otherwise be byte-equal to the v0.6.0 registry,\n37|// except for the two intended repoints asserted inline below.\n38|var newV070Cases = map[string]struct{}{\n39|\t\"catalog-v070-exact\":      {},\n40|\t\"source-pin-v070-exact\":   {},\n41|\t\"source-pin-v070-refusal\": {},\n42|}\n43|\n44|// rewordedV070Gaps maps the carried bindings whose gap the adoption rewords\n45|// to the story that must own the new text. appendix-d carries a split\n46|// attribution (\"pending STORY-...\") rather than the owner formula.\n47|var rewordedV070Gaps = map[string]string{\n48|\t\"section:5.1\":        \"STORY-260916-2q85nu\",\n49|\t\"section:7.3\":        \"STORY-260916-1ea7od\",\n50|\t\"section:7.4\":        \"STORY-260916-1ea7od\",\n51|\t\"section:7.5\":        \"STORY-260916-1kp1lx\",\n52|\t\"section:appendix-d\": \"STORY-260916-vucwn0\",\n53|}\n54|\n55|const (\n56|\tlaunchPlanContractKey = \"Launch Plan request [urn:ax:schema:launch-plan-request]\"\n57|\tlaunchPlanFixtureKey  = \"pin:ax-launch-plan-request-v1\"\n58|)\n59|\n60|// TestV070RegistryRederivesFromTrunkV060Registry re-derives the adopted v0.7.0\n61|// ownership registry from the trunk-final v0.6.0 registry and fails on any\n62|// missing binding, any unshifted clause line, or any self-minted claim.\n63|//\n64|// The v0.6.0 file in this tree is the trunk baseline: the suite's historical\n65|// byte-identity gate keeps it equal to trunk, and this test treats it as the\n66|// derivation source. Production VerifyRepository pins the exact adopted bytes\n67|// through reviewedOwnershipCanonicalSHA256; this test pins the derivation\n68|// relationship between the two registries, so neither a dropped carry nor an\n69|// unreviewed addition can pass as a re-derivation.\n70|func TestV070RegistryRederivesFromTrunkV060Registry(t *testing.T) {\n71|\tt.Parallel()\n72|\n73|\tprevious := decodeRegistryFile(t, \"ownership.v0.6.0.json\")\n74|\tcurrent := decodeRegistryFile(t, \"ownership.v0.7.0.json\")\n75|\n76|\tif current.Source != expectedV070Source {\n77|\t\tt.Fatalf(\"v0.7.0 registry source = %+v, want %+v\", current.Source, expectedV070Source)\n78|\t}\n79|\n80|\tpreviousBindings := sectionBindingsByKey(t, previous)\n81|\tcurrentBindings := sectionBindingsByKey(t, current)\n82|\n83|\tassertNoMissingBindings(t, previousBindings, currentBindings)\n84|\tassertNewBindingsAreReviewed(t, previousBindings, currentBindings)\n85|\tassertCarriedBindingsRederive(t, previousBindings, currentBindings)\n86|\tassertClauseLinesRemeasured(t, previousBindings, currentBindings)\n87|\tassertAcceptanceCasesRederive(t, previous, current)\n88|\tassertOwnershipGroupsRederive(t, previous, current)\n89|\tassertUnownedSectionsCarried(t, previous, current)\n90|}\n91|\n92|func decodeRegistryFile(t *testing.T, name string) ownershipRegistry {\n93|\tt.Helper()\n94|\n95|\traw, err := os.ReadFile(name)\n96|\tif err != nil {\n97|\t\tt.Fatalf(\"read %s: %v\", name, err)\n98|\t}\n99|\tregistry, err := decodeOwnershipRegistry(raw)\n100|\tif err != nil {\n101|\t\tt.Fatalf(\"decode %s: %v\", name, err)\n102|\t}\n103|\treturn registry\n104|}\n105|\n106|func sectionBindingsByKey(t *testing.T, registry ownershipRegistry) map[string]ownershipGroup {\n107|\tt.Helper()\n108|\n109|\tresult := make(map[string]ownershipGroup)\n110|\tfor _, group := range registry.Ownership {\n111|\t\tif group.Kind != ownershipSectionBinding {\n112|\t\t\tcontinue\n113|\t\t}\n114|\t\tif len(group.Keys) != 1 {\n115|\t\t\tt.Fatalf(\"section binding group carries %d keys %q, want exactly 1\", len(group.Keys), group.Keys)\n116|\t\t}\n117|\t\tkey := group.Keys[0]\n118|\t\tif _, duplicate := result[key]; duplicate {\n119|\t\t\tt.Fatalf(\"duplicate section binding %q\", key)\n120|\t\t}\n121|\t\tresult[key] = group\n122|\t}\n123|\treturn result\n124|}\n125|\n126|func assertNoMissingBindings(t *testing.T, previous, current map[string]ownershipGroup) {\n127|\tt.Helper()\n128|\n129|\tvar missing []string\n130|\tfor key := range previous {\n131|\t\tif _, ok := current[key]; !ok {\n132|\t\t\tmissing = append(missing, key)\n133|\t\t}\n134|\t}\n135|\tsort.Strings(missing)\n136|\tif len(missing) > 0 {\n137|\t\tt.Fatalf(\"v0.7.0 registry drops %d carried bindings: %q\", len(missing), missing)\n138|\t}\n139|}\n140|\n141|func assertNewBindingsAreReviewed(t *testing.T, previous, current map[string]ownershipGroup) {\n142|\tt.Helper()\n143|\n144|\tfor key, group := range current {\n145|\t\tif _, carried := previous[key]; carried {\n146|\t\t\tcontinue\n147|\t\t}\n148|\t\tstory, ok := newV070Bindings[key]\n149|\t\tif !ok {\n150|\t\t\tt.Fatalf(\"v0.7.0 binding %q is not carried and not a reviewed addition\", key)\n151|\t\t}\n152|\t\tif !strings.Contains(group.Gap, \"Pending implementation owner: \"+story) {\n153|\t\t\tt.Fatalf(\"v0.7.0 binding %q gap does not name its implementing story %s: %q\", key, story, group.Gap)\n154|\t\t}\n155|\t\tif group.Coverage != coverageUnevidenced {\n156|\t\t\tt.Fatalf(\"v0.7.0 binding %q claims %s coverage, want unevidenced for a story-owned stub\", key, group.Coverage)\n157|\t\t}\n158|\t\tif len(group.Clauses) != 0 {\n159|\t\t\tt.Fatalf(\"v0.7.0 binding %q enumerates %d clauses, want none for a story-owned stub\", key, len(group.Clauses))\n160|\t\t}\n161|\t}\n162|\tfor key := range newV070Bindings {\n163|\t\tif _, ok := current[key]; !ok {\n164|\t\t\tt.Fatalf(\"reviewed v0.7.0 binding %q is absent\", key)\n165|\t\t}\n166|\t}\n167|}\n168|\n169|func assertCarriedBindingsRederive(t *testing.T, previous, current map[string]ownershipGroup) {\n170|\tt.Helper()\n171|\n172|\tfor key, old := range previous {\n173|\t\tnow, ok := current[key]\n174|\t\tif !ok {\n175|\t\t\tcontinue\n176|\t\t}\n177|\t\tif now.Production != old.Production {\n178|\t\t\tt.Fatalf(\"binding %q production moved from %+v to %+v\", key, old.Production, now.Production)\n179|\t\t}\n180|\t\tif !reflect.DeepEqual(now.AcceptanceCases, old.AcceptanceCases) {\n181|\t\t\tt.Fatalf(\"binding %q acceptance cases moved from %q to %q\", key, old.AcceptanceCases, now.AcceptanceCases)\n182|\t\t}\n183|\t\tif now.Coverage != old.Coverage {\n184|\t\t\tt.Fatalf(\"binding %q coverage moved from %s to %s\", key, old.Coverage, now.Coverage)\n185|\t\t}\n186|\t\tstory, reworded := rewordedV070Gaps[key]\n187|\t\tif !reworded {\n188|\t\t\tif now.Gap != old.Gap {\n189|\t\t\t\tt.Fatalf(\"binding %q gap changed without a reviewed rewording\", key)\n190|\t\t\t}\n191|\t\t\tcontinue\n192|\t\t}\n193|\t\tif now.Gap == old.Gap {\n194|\t\t\tt.Fatalf(\"binding %q gap was not reworded to its story owner\", key)\n195|\t\t}\n196|\t\tif !strings.Contains(now.Gap, story) {\n197|\t\t\tt.Fatalf(\"binding %q reworded gap does not name %s: %q\", key, story, now.Gap)\n198|\t\t}\n199|\t}\n200|}\n201|\n202|// assertClauseLinesRemeasured checks every carried clause against the pinned\n203|// document it cites, using the production clause inventory and quote matcher.\n204|// A clause whose v0.7.0 line still points at the v0.6.0 position fails twice:\n205|// the measured line differs and the excerpt no longer begins there.\n206|func assertClauseLinesRemeasured(t *testing.T, previous, current map[string]ownershipGroup) {\n207|\tt.Helper()\n208|\n209|\tdocument060, err := specdoc.LoadV060()\n210|\tif err != nil {\n211|\t\tt.Fatalf(\"LoadV060: %v\", err)\n212|\t}\n213|\tdocument070, err := specdoc.LoadV070()\n214|\tif err != nil {\n215|\t\tt.Fatalf(\"LoadV070: %v\", err)\n216|\t}\n217|\tmeasured060 := measuredClauseLines(t, document060, previous, \"v0.6.0\")\n218|\tmeasured070 := measuredClauseLines(t, document070, current, \"v0.7.0\")\n219|\n220|\tfor key, old := range previous {\n221|\t\tnow, ok := current[key]\n222|\t\tif !ok {\n223|\t\t\tcontinue\n224|\t\t}\n225|\t\tif len(now.Clauses) != len(old.Clauses) {\n226|\t\t\tt.Fatalf(\"binding %q carries %d clauses, want %d\", key, len(now.Clauses), len(old.Clauses))\n227|\t\t}\n228|\t\tfor index, oldClause := range old.Clauses {\n229|\t\t\tnewClause := now.Clauses[index]\n230|\t\t\tif newClause.ID != oldClause.ID {\n231|\t\t\t\tt.Fatalf(\"binding %q clause %d id moved from %s to %s\", key, index, oldClause.ID, newClause.ID)\n232|\t\t\t}\n233|\t\t\tif newClause.Excerpt != oldClause.Excerpt {\n234|\t\t\t\tt.Fatalf(\"binding %q clause %s excerpt changed\", key, oldClause.ID)\n235|\t\t\t}\n236|\t\t\tif !reflect.DeepEqual(newClause.AcceptanceCases, oldClause.AcceptanceCases) {\n237|\t\t\t\tt.Fatalf(\"binding %q clause %s acceptance cases moved\", key, oldClause.ID)\n238|\t\t\t}\n239|\t\t\tif newClause.Line == oldClause.Line {\n240|\t\t\t\tt.Fatalf(\"binding %q clause %s still cites v0.6.0 line %d; every carried clause shifts in v0.7.0\",\n241|\t\t\t\t\tkey, oldClause.ID, oldClause.Line)\n242|\t\t\t}\n243|\t\t\tif measured060[key][oldClause.ID] != oldClause.Line {\n244|\t\t\t\tt.Fatalf(\"binding %q clause %s v0.6.0 line %d is not the measured line %d\",\n245|\t\t\t\t\tkey, oldClause.ID, oldClause.Line, measured060[key][oldClause.ID])\n246|\t\t\t}\n247|\t\t\tif measured070[key][newClause.ID] != newClause.Line {\n248|\t\t\t\tt.Fatalf(\"binding %q clause %s v0.7.0 line %d is not the measured line %d\",\n249|\t\t\t\t\tkey, newClause.ID, newClause.Line, measured070[key][newClause.ID])\n250|\t\t\t}\n251|\t\t}\n252|\t}\n253|}\n254|\n255|// measuredClauseLines returns the production-measured line of every normative\n256|// clause the pinned document carries for the given bindings, verifying each\n257|// binding's declared excerpts quote verbatim at their declared lines.\n258|func measuredClauseLines(t *testing.T, document *specdoc.Document, bindings map[string]ownershipGroup, tag string) map[string]map[string]int {\n259|\tt.Helper()\n260|\n261|\tresult := make(map[string]map[string]int, len(bindings))\n262|\tfor key, group := range bindings {\n263|\t\tif len(group.Clauses) == 0 {\n264|\t\t\tcontinue\n265|\t\t}\n266|\t\tinventory, err := sectionClauseInventory(document, key)\n267|\t\tif err != nil {\n268|\t\t\tt.Fatalf(\"%s binding %q inventory: %v\", tag, key, err)\n269|\t\t}\n270|\t\tlines := make(map[string]int, len(inventory))\n271|\t\tfor _, clause := range inventory {\n272|\t\t\tlines[clause.ID] = clause.Line\n273|\t\t}\n274|\t\tfor _, discharged := range group.Clauses {\n275|\t\t\tif _, ok := lines[discharged.ID]; !ok {\n276|\t\t\t\tt.Fatalf(\"%s binding %q clause %s is not a measured clause of its section\", tag, key, discharged.ID)\n277|\t\t\t}\n278|\t\t\tif !quoteBeginsAtLine(document, discharged.Excerpt, discharged.Line) {\n279|\t\t\t\tt.Fatalf(\"%s binding %q clause %s excerpt does not begin at line %d\", tag, key, discharged.ID, discharged.Line)\n280|\t\t\t}\n281|\t\t}\n282|\t\tresult[key] = lines\n283|\t}\n284|\treturn result\n285|}\n286|\n287|func assertAcceptanceCasesRederive(t *testing.T, previous, current ownershipRegistry) {\n288|\tt.Helper()\n289|\n290|\toldCases := make(map[string]acceptanceCase, len(previous.AcceptanceCases))\n291|\tfor _, c := range previous.AcceptanceCases {\n292|\t\toldCases[c.ID] = c\n293|\t}\n294|\tnewCases := make(map[string]acceptanceCase, len(current.AcceptanceCases))\n295|\tfor _, c := range current.AcceptanceCases {\n296|\t\tif _, duplicate := newCases[c.ID]; duplicate {\n297|\t\t\tt.Fatalf(\"duplicate v0.7.0 acceptance case %q\", c.ID)\n298|\t\t}\n299|\t\tnewCases[c.ID] = c\n300|\t}\n301|\tfor id := range oldCases {\n302|\t\tif _, ok := newCases[id]; !ok {\n303|\t\t\tt.Fatalf(\"v0.7.0 registry drops carried acceptance case %q\", id)\n304|\t\t}\n305|\t}\n306|\tfor id := range newCases {\n307|\t\tif _, carried := oldCases[id]; carried {\n308|\t\t\tcontinue\n309|\t\t}\n310|\t\tif _, ok := newV070Cases[id]; !ok {\n311|\t\t\tt.Fatalf(\"v0.7.0 acceptance case %q is not carried and not a reviewed addition\", id)\n312|\t\t}\n313|\t}\n314|\tfor id := range newV070Cases {\n315|\t\tif _, ok := newCases[id]; !ok {\n316|\t\t\tt.Fatalf(\"reviewed v0.7.0 acceptance case %q is absent\", id)\n317|\t\t}\n318|\t}\n319|\tfor id, old := range oldCases {\n320|\t\tnow := newCases[id]\n321|\t\tif reflect.DeepEqual(now, old) {\n322|\t\t\tcontinue\n323|\t\t}\n324|\t\tswitch id {\n325|\t\tcase \"catalog-v060-exact\":\n326|\t\t\t// The adopted catalog moved to v0.7.0, so the v0.6.0 exact case\n327|\t\t\t// is repointed at the historical projection pair it now proves.\n328|\t\t\twant := acceptanceCase{\n329|\t\t\t\tID:         id,\n330|\t\t\t\tProduction: codeReference{Path: \"internal/catalog/catalog.go\", Declaration: \"ForRelease\"},\n331|\t\t\t\tTests: []codeReference{\n332|\t\t\t\t\t{Path: \"internal/catalog/catalog_test.go\", Declaration: \"TestV060ProjectionMatchesHistoricalLock\"},\n333|\t\t\t\t},\n334|\t\t\t}\n335|\t\t\tif !reflect.DeepEqual(now, want) {\n336|\t\t\t\tt.Fatalf(\"catalog-v060-exact repoint = %+v, want %+v\", now, want)\n337|\t\t\t}\n338|\t\tcase \"assigned-section-binding\":\n339|\t\t\tassertAssignedSectionBindingRename(t, old, now)\n340|\t\tdefault:\n341|\t\t\tt.Fatalf(\"carried acceptance case %q changed without a reviewed repoint\", id)\n342|\t\t}\n343|\t}\n344|}\n345|\n346|// assertAssignedSectionBindingRename allows exactly one change to the carried\n347|// case: the V060 section-identifier test becomes its V070 successor. Any other\n348|// edit, addition, or removal fails.\n349|func assertAssignedSectionBindingRename(t *testing.T, old, now acceptanceCase) {\n350|\tt.Helper()\n351|\n352|\tif now.ID != old.ID || now.Production != old.Production {\n353|\t\tt.Fatalf(\"assigned-section-binding identity moved: %+v vs %+v\", now, old)\n354|\t}\n355|\tif len(now.Tests) != len(old.Tests) {\n356|\t\tt.Fatalf(\"assigned-section-binding test list length moved from %d to %d\", len(old.Tests), len(now.Tests))\n357|\t}\n358|\trenamed := 0\n359|\tfor index, oldRef := range old.Tests {\n360|\t\tnewRef := now.Tests[index]\n361|\t\tif newRef == oldRef {\n362|\t\t\tcontinue\n363|\t\t}\n364|\t\trenamed++\n365|\t\tif newRef.Path != oldRef.Path {\n366|\t\t\tt.Fatalf(\"assigned-section-binding test %d moved path %q to %q\", index, oldRef.Path, newRef.Path)\n367|\t\t}\n368|\t\tif oldRef.Declaration != \"TestMainRejectsSyntacticallyValidNonexistentV060Section\" ||\n369|\t\t\tnewRef.Declaration != \"TestMainRejectsSyntacticallyValidNonexistentV070Section\" {\n370|\t\t\tt.Fatalf(\"assigned-section-binding test %d renamed %q to %q, want the single V060 to V070 rename\",\n371|\t\t\t\tindex, oldRef.Declaration, newRef.Declaration)\n372|\t\t}\n373|\t}\n374|\tif renamed != 1 {\n375|\t\tt.Fatalf(\"assigned-section-binding carries %d test edits, want exactly the V060 to V070 rename\", renamed)\n376|\t}\n377|}\n378|\n379|func ownershipGroupByKindAndKeys(t *testing.T, registry ownershipRegistry, kind ownershipKind, firstKey string) ownershipGroup {\n380|\tt.Helper()\n381|\n382|\tfor _, group := range registry.Ownership {\n383|\t\tif group.Kind == kind && len(group.Keys) > 0 && group.Keys[0] == firstKey {\n384|\t\t\treturn group\n385|\t\t}\n386|\t}\n387|\tt.Fatalf(\"%s group starting with %q is absent\", kind, firstKey)\n388|\treturn ownershipGroup{}\n389|}\n390|\n391|func assertOwnershipGroupsRederive(t *testing.T, previous, current ownershipRegistry) {\n392|\tt.Helper()\n393|\n394|\tassertContractGroupRederives(t, previous, current)\n395|\tassertSourceGroupRederives(t, previous, current)\n396|\n397|\t// The catalog normative-section group and the catalog fixture group are\n398|\t// adoption-independent: identical keys, owners, and cases.\n399|\tfor _, probe := range []struct {\n400|\t\tkind     ownershipKind\n401|\t\tfirstKey string\n402|\t}{\n403|\t\t{ownershipNormativeSection, \"catalog:10.8.5\"},\n404|\t\t{ownershipFixture, \"catalog:Appendix D: Directory Node operation body\"},\n405|\t} {\n406|\t\told := ownershipGroupByKindAndKeys(t, previous, probe.kind, probe.firstKey)\n407|\t\tnow := ownershipGroupByKindAndKeys(t, current, probe.kind, probe.firstKey)\n408|\t\tif !reflect.DeepEqual(now, old) {\n409|\t\t\tt.Fatalf(\"%s group %q changed: %+v vs %+v\", probe.kind, probe.firstKey, now, old)\n410|\t\t}\n411|\t}\n412|\n413|\tassertPinFixtureGroupRederives(t, previous, current)\n414|}\n415|\n416|func assertContractGroupRederives(t *testing.T, previous, current ownershipRegistry) {\n417|\tt.Helper()\n418|\n419|\told := ownershipGroupByKindAndKeys(t, previous, ownershipContract, \"Configuration [urn:ax:schema:config]\")\n420|\tnow := ownershipGroupByKindAndKeys(t, current, ownershipContract, \"Configuration [urn:ax:schema:config]\")\n421|\tif now.Production != old.Production {\n422|\t\tt.Fatalf(\"contract group production moved from %+v to %+v\", old.Production, now.Production)\n423|\t}\n424|\twantCases := []string{\"catalog-v070-exact\", \"catalog-v060-exact\", \"catalog-v050-exact\", \"catalog-v043-compatibility\"}\n425|\tif !reflect.DeepEqual(now.AcceptanceCases, wantCases) {\n426|\t\tt.Fatalf(\"contract group acceptance cases = %q, want %q\", now.AcceptanceCases, wantCases)\n427|\t}\n428|\toldKeys := oldKeySet(old.Keys)\n429|\tfor _, key := range now.Keys {\n430|\t\tif _, carried := oldKeys[key]; !carried && key != launchPlanContractKey {\n431|\t\t\tt.Fatalf(\"contract group key %q is not carried and not the Launch Plan request row\", key)\n432|\t\t}\n433|\t\tdelete(oldKeys, key)\n434|\t}\n435|\tif len(oldKeys) != 0 {\n436|\t\tt.Fatalf(\"contract group drops %d carried keys\", len(oldKeys))\n437|\t}\n438|\tfound := false\n439|\tfor _, key := range now.Keys {\n440|\t\tif key == launchPlanContractKey {\n441|\t\t\tfound = true\n442|\t\t}\n443|\t}\n444|\tif !found {\n445|\t\tt.Fatalf(\"contract group lacks the Launch Plan request row %q\", launchPlanContractKey)\n446|\t}\n447|}\n448|\n449|func oldKeySet(keys []string) map[string]struct{} {\n450|\tresult := make(map[string]struct{}, len(keys))\n451|\tfor _, key := range keys {\n452|\t\tresult[key] = struct{}{}\n453|\t}\n454|\treturn result\n455|}\n456|\n457|func assertSourceGroupRederives(t *testing.T, previous, current ownershipRegistry) {\n458|\tt.Helper()\n459|\n460|\told := ownershipGroupByKindAndKeys(t, previous, ownershipNormativeSection, \"source:1\")\n461|\tnow := ownershipGroupByKindAndKeys(t, current, ownershipNormativeSection, \"source:1\")\n462|\tif !reflect.DeepEqual(now.Keys, old.Keys) {\n463|\t\tt.Fatalf(\"source normative-section keys moved\")\n464|\t}\n465|\twantCases := []string{\"source-pin-v070-exact\", \"source-pin-v070-refusal\"}\n466|\tif !reflect.DeepEqual(now.AcceptanceCases, wantCases) {\n467|\t\tt.Fatalf(\"source group acceptance cases = %q, want %q\", now.AcceptanceCases, wantCases)\n468|\t}\n469|\t// FINDING F1 (TASK-260917-10k118): the reviewed v0.7.0 bytes keep the\n470|\t// source group's production owner at VerifyV060 while its cases moved to\n471|\t// the v0.7.0 pair. The v0.5.0→v0.6.0 precedent moved Verify to VerifyV060,\n472|\t// so the adoption pattern says VerifyV070; the gate only checks that the\n473|\t// named declaration exists, which is why the bytes are green. The\n474|\t// reconstruction must not rewrite reviewed bytes, so this test pins the\n475|\t// carried reference literally: a future fix to VerifyV070 must update\n476|\t// this pin deliberately, and any other drift fails here.\n477|\tif now.Production.Declaration != \"VerifyV060\" || now.Production.Path != \"internal/specpin/pin.go\" {\n478|\t\tt.Fatalf(\"source group production = %+v, want the carried VerifyV060 reference (see F1)\", now.Production)\n479|\t}\n480|}\n481|\n482|func assertPinFixtureGroupRederives(t *testing.T, previous, current ownershipRegistry) {\n483|\tt.Helper()\n484|\n485|\told := ownershipGroupByKindAndKeys(t, previous, ownershipFixture, \"pin:ax-session-directory-conformance-v1\")\n486|\tnow := ownershipGroupByKindAndKeys(t, current, ownershipFixture, \"pin:ax-session-directory-conformance-v1\")\n487|\tif now.Production != old.Production {\n488|\t\tt.Fatalf(\"pin fixture group production moved from %+v to %+v\", old.Production, now.Production)\n489|\t}\n490|\twantCases := []string{\"source-pin-exact\", \"source-pin-refusal\", \"source-pin-v060-exact\", \"source-pin-v060-refusal\", \"source-pin-v070-exact\", \"source-pin-v070-refusal\"}\n491|\tif !reflect.DeepEqual(now.AcceptanceCases, wantCases) {\n492|\t\tt.Fatalf(\"pin fixture group acceptance cases = %q, want %q\", now.AcceptanceCases, wantCases)\n493|\t}\n494|\toldKeys := oldKeySet(old.Keys)\n495|\tfor _, key := range now.Keys {\n496|\t\tif _, carried := oldKeys[key]; !carried && key != launchPlanFixtureKey {\n497|\t\t\tt.Fatalf(\"pin fixture group key %q is not carried and not the Launch Plan fixture\", key)\n498|\t\t}\n499|\t\tdelete(oldKeys, key)\n500|\t}\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d2f9","stream":{"kind":"session","id":"01a0b17d-598e-7f80-b6bd-728e9f57759a"},"sequence":2007,"recorded_at":1780531400004009,"record_type":"event","durability":"durable","causation_id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba","run_stream":{"kind":"run","id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba"},"task_stream":{"kind":"task","id":"01a0b186-3762-7bf2-931b-0a3215f79b2f"},"task_id":"01a0b186-3762-7bf2-931b-0a3215f79b2f","event":{"kind":"completed","task_id":"01a0b186-3762-7bf2-931b-0a3215f79b2f"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d2fb","stream":{"kind":"session","id":"01a0b17d-598e-7f80-b6bd-728e9f57759a"},"sequence":2008,"recorded_at":1780531400004011,"record_type":"event","durability":"durable","causation_id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba","run_stream":{"kind":"run","id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba"},"call_id":"call_01a0b18633407033acdae451398775b1","text":"Read text file `internal/traceability/registry_rederivation_test.go`.\n1|package traceability\n2|\n3|import (\n4|\t\"os\"\n5|\t\"reflect\"\n6|\t\"sort\"\n7|\t\"strings\"\n8|\t\"testing\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n11|)\n12|\n13|// expectedV070Source is the reviewed normative source the adopted v0.7.0\n14|// registry must bind. It repeats the provenance the pin leaf verified from a\n15|// fresh upstream clone (tag v0.7.0, peeled commit,LF document digest) so a\n16|// registry that drifts to another source fails here before any binding is read.\n17|var expectedV070Source = registrySource{\n18|\tRepository:     \"relux-works/agent-session-manager-spec\",\n19|\tRelease:        \"v0.7.0\",\n20|\tCommit:         \"32b3f2ba7c377248a53cd42389abbd2f1c321834\",\n21|\tDocumentPath:   \"SPEC.md\",\n22|\tDocumentSHA256: \"c6b2fe64ee79ed697a96ed27a1679c80b8ee1eba137feb99e7738b4da289ddcf\",\n23|}\n24|\n25|// newV070Bindings is the exact set of section bindings the v0.7.0 adoption\n26|// may add over the trunk v0.6.0 registry. Every other v0.7.0 binding must be\n27|// carried, and every binding here must name its implementing story, so a\n28|// self-minted implementation claim has nowhere to hide.\n29|var newV070Bindings = map[string]string{\n30|\t\"section:13.1\":  \"STORY-260916-3fjjtn\",\n31|\t\"section:13.10\": \"STORY-260916-3aukw3\",\n32|\t\"section:14.1\":  \"STORY-260916-3fjjtn\",\n33|}\n34|\n35|// newV070Cases is the exact set of acceptance cases the v0.7.0 adoption may\n36|// add. Carried cases must otherwise be byte-equal to the v0.6.0 registry,\n37|// except for the two intended repoints asserted inline below.\n38|var newV070Cases = map[string]struct{}{\n39|\t\"catalog-v070-exact\":      {},\n40|\t\"source-pin-v070-exact\":   {},\n41|\t\"source-pin-v070-refusal\": {},\n42|}\n43|\n44|// rewordedV070Gaps maps the carried bindings whose gap the adoption rewords\n45|// to the story that must own the new text. appendix-d carries a split\n46|// attribution (\"pending STORY-...\") rather than the owner formula.\n47|var rewordedV070Gaps = map[string]string{\n48|\t\"section:5.1\":        \"STORY-260916-2q85nu\",\n49|\t\"section:7.3\":        \"STORY-260916-1ea7od\",\n50|\t\"section:7.4\":        \"STORY-260916-1ea7od\",\n51|\t\"section:7.5\":        \"STORY-260916-1kp1lx\",\n52|\t\"section:appendix-d\": \"STORY-260916-vucwn0\",\n53|}\n54|\n55|const (\n56|\tlaunchPlanContractKey = \"Launch Plan request [urn:ax:schema:launch-plan-request]\"\n57|\tlaunchPlanFixtureKey  = \"pin:ax-launch-plan-request-v1\"\n58|)\n59|\n60|// TestV070RegistryRederivesFromTrunkV060Registry re-derives the adopted v0.7.0\n61|// ownership registry from the trunk-final v0.6.0 registry and fails on any\n62|// missing binding, any unshifted clause line, or any self-minted claim.\n63|//\n64|// The v0.6.0 file in this tree is the trunk baseline: the suite's historical\n65|// byte-identity gate keeps it equal to trunk, and this test treats it as the\n66|// derivation source. Production VerifyRepository pins the exact adopted bytes\n67|// through reviewedOwnershipCanonicalSHA256; this test pins the derivation\n68|// relationship between the two registries, so neither a dropped carry nor an\n69|// unreviewed addition can pass as a re-derivation.\n70|func TestV070RegistryRederivesFromTrunkV060Registry(t *testing.T) {\n71|\tt.Parallel()\n72|\n73|\tprevious := decodeRegistryFile(t, \"ownership.v0.6.0.json\")\n74|\tcurrent := decodeRegistryFile(t, \"ownership.v0.7.0.json\")\n75|\n76|\tif current.Source != expectedV070Source {\n77|\t\tt.Fatalf(\"v0.7.0 registry source = %+v, want %+v\", current.Source, expectedV070Source)\n78|\t}\n79|\n80|\tpreviousBindings := sectionBindingsByKey(t, previous)\n81|\tcurrentBindings := sectionBindingsByKey(t, current)\n82|\n83|\tassertNoMissingBindings(t, previousBindings, currentBindings)\n84|\tassertNewBindingsAreReviewed(t, previousBindings, currentBindings)\n85|\tassertCarriedBindingsRederive(t, previousBindings, currentBindings)\n86|\tassertClauseLinesRemeasured(t, previousBindings, currentBindings)\n87|\tassertAcceptanceCasesRederive(t, previous, current)\n88|\tassertOwnershipGroupsRederive(t, previous, current)\n89|\tassertUnownedSectionsCarried(t, previous, current)\n90|}\n91|\n92|func decodeRegistryFile(t *testing.T, name string) ownershipRegistry {\n93|\tt.Helper()\n94|\n95|\traw, err := os.ReadFile(name)\n96|\tif err != nil {\n97|\t\tt.Fatalf(\"read %s: %v\", name, err)\n98|\t}\n99|\tregistry, err := decodeOwnershipRegistry(raw)\n100|\tif err != nil {\n101|\t\tt.Fatalf(\"decode %s: %v\", name, err)\n102|\t}\n103|\treturn registry\n104|}\n105|\n106|func sectionBindingsByKey(t *testing.T, registry ownershipRegistry) map[string]ownershipGroup {\n107|\tt.Helper()\n108|\n109|\tresult := make(map[string]ownershipGroup)\n110|\tfor _, group := range registry.Ownership {\n111|\t\tif group.Kind != ownershipSectionBinding {\n112|\t\t\tcontinue\n113|\t\t}\n114|\t\tif len(group.Keys) != 1 {\n115|\t\t\tt.Fatalf(\"section binding group carries %d keys %q, want exactly 1\", len(group.Keys), group.Keys)\n116|\t\t}\n117|\t\tkey := group.Keys[0]\n118|\t\tif _, duplicate := result[key]; duplicate {\n119|\t\t\tt.Fatalf(\"duplicate section binding %q\", key)\n120|\t\t}\n121|\t\tresult[key] = group\n122|\t}\n123|\treturn result\n124|}\n125|\n126|func assertNoMissingBindings(t *testing.T, previous, current map[string]ownershipGroup) {\n127|\tt.Helper()\n128|\n129|\tvar missing []string\n130|\tfor key := range previous {\n131|\t\tif _, ok := current[key]; !ok {\n132|\t\t\tmissing = append(missing, key)\n133|\t\t}\n134|\t}\n135|\tsort.Strings(missing)\n136|\tif len(missing) > 0 {\n137|\t\tt.Fatalf(\"v0.7.0 registry drops %d carried bindings: %q\", len(missing), missing)\n138|\t}\n139|}\n140|\n141|func assertNewBindingsAreReviewed(t *testing.T, previous, current map[string]ownershipGroup) {\n142|\tt.Helper()\n143|\n144|\tfor key, group := range current {\n145|\t\tif _, carried := previous[key]; carried {\n146|\t\t\tcontinue\n147|\t\t}\n148|\t\tstory, ok := newV070Bindings[key]\n149|\t\tif !ok {\n150|\t\t\tt.Fatalf(\"v0.7.0 binding %q is not carried and not a reviewed addition\", key)\n151|\t\t}\n152|\t\tif !strings.Contains(group.Gap, \"Pending implementation owner: \"+story) {\n153|\t\t\tt.Fatalf(\"v0.7.0 binding %q gap does not name its implementing story %s: %q\", key, story, group.Gap)\n154|\t\t}\n155|\t\tif group.Coverage != coverageUnevidenced {\n156|\t\t\tt.Fatalf(\"v0.7.0 binding %q claims %s coverage, want unevidenced for a story-owned stub\", key, group.Coverage)\n157|\t\t}\n158|\t\tif len(group.Clauses) != 0 {\n159|\t\t\tt.Fatalf(\"v0.7.0 binding %q enumerates %d clauses, want none for a story-owned stub\", key, len(group.Clauses))\n160|\t\t}\n161|\t}\n162|\tfor key := range newV070Bindings {\n163|\t\tif _, ok := current[key]; !ok {\n164|\t\t\tt.Fatalf(\"reviewed v0.7.0 binding %q is absent\", key)\n165|\t\t}\n166|\t}\n167|}\n168|\n169|func assertCarriedBindingsRederive(t *testing.T, previous, current map[string]ownershipGroup) {\n170|\tt.Helper()\n171|\n172|\tfor key, old := range previous {\n173|\t\tnow, ok := current[key]\n174|\t\tif !ok {\n175|\t\t\tcontinue\n176|\t\t}\n177|\t\tif now.Production != old.Production {\n178|\t\t\tt.Fatalf(\"binding %q production moved from %+v to %+v\", key, old.Production, now.Production)\n179|\t\t}\n180|\t\tif !reflect.DeepEqual(now.AcceptanceCases, old.AcceptanceCases) {\n181|\t\t\tt.Fatalf(\"binding %q acceptance cases moved from %q to %q\", key, old.AcceptanceCases, now.AcceptanceCases)\n182|\t\t}\n183|\t\tif now.Coverage != old.Coverage {\n184|\t\t\tt.Fatalf(\"binding %q coverage moved from %s to %s\", key, old.Coverage, now.Coverage)\n185|\t\t}\n186|\t\tstory, reworded := rewordedV070Gaps[key]\n187|\t\tif !reworded {\n188|\t\t\tif now.Gap != old.Gap {\n189|\t\t\t\tt.Fatalf(\"binding %q gap changed without a reviewed rewording\", key)\n190|\t\t\t}\n191|\t\t\tcontinue\n192|\t\t}\n193|\t\tif now.Gap == old.Gap {\n194|\t\t\tt.Fatalf(\"binding %q gap was not reworded to its story owner\", key)\n195|\t\t}\n196|\t\tif !strings.Contains(now.Gap, story) {\n197|\t\t\tt.Fatalf(\"binding %q reworded gap does not name %s: %q\", key, story, now.Gap)\n198|\t\t}\n199|\t}\n200|}\n201|\n202|// assertClauseLinesRemeasured checks every carried clause against the pinned\n203|// document it cites, using the production clause inventory and quote matcher.\n204|// A clause whose v0.7.0 line still points at the v0.6.0 position fails twice:\n205|// the measured line differs and the excerpt no longer begins there.\n206|func assertClauseLinesRemeasured(t *testing.T, previous, current map[string]ownershipGroup) {\n207|\tt.Helper()\n208|\n209|\tdocument060, err := specdoc.LoadV060()\n210|\tif err != nil {\n211|\t\tt.Fatalf(\"LoadV060: %v\", err)\n212|\t}\n213|\tdocument070, err := specdoc.LoadV070()\n214|\tif err != nil {\n215|\t\tt.Fatalf(\"LoadV070: %v\", err)\n216|\t}\n217|\tmeasured060 := measuredClauseLines(t, document060, previous, \"v0.6.0\")\n218|\tmeasured070 := measuredClauseLines(t, document070, current, \"v0.7.0\")\n219|\n220|\tfor key, old := range previous {\n221|\t\tnow, ok := current[key]\n222|\t\tif !ok {\n223|\t\t\tcontinue\n224|\t\t}\n225|\t\tif len(now.Clauses) != len(old.Clauses) {\n226|\t\t\tt.Fatalf(\"binding %q carries %d clauses, want %d\", key, len(now.Clauses), len(old.Clauses))\n227|\t\t}\n228|\t\tfor index, oldClause := range old.Clauses {\n229|\t\t\tnewClause := now.Clauses[index]\n230|\t\t\tif newClause.ID != oldClause.ID {\n231|\t\t\t\tt.Fatalf(\"binding %q clause %d id moved from %s to %s\", key, index, oldClause.ID, newClause.ID)\n232|\t\t\t}\n233|\t\t\tif newClause.Excerpt != oldClause.Excerpt {\n234|\t\t\t\tt.Fatalf(\"binding %q clause %s excerpt changed\", key, oldClause.ID)\n235|\t\t\t}\n236|\t\t\tif !reflect.DeepEqual(newClause.AcceptanceCases, oldClause.AcceptanceCases) {\n237|\t\t\t\tt.Fatalf(\"binding %q clause %s acceptance cases moved\", key, oldClause.ID)\n238|\t\t\t}\n239|\t\t\tif newClause.Line == oldClause.Line {\n240|\t\t\t\tt.Fatalf(\"binding %q clause %s still cites v0.6.0 line %d; every carried clause shifts in v0.7.0\",\n241|\t\t\t\t\tkey, oldClause.ID, oldClause.Line)\n242|\t\t\t}\n243|\t\t\tif measured060[key][oldClause.ID] != oldClause.Line {\n244|\t\t\t\tt.Fatalf(\"binding %q clause %s v0.6.0 line %d is not the measured line %d\",\n245|\t\t\t\t\tkey, oldClause.ID, oldClause.Line, measured060[key][oldClause.ID])\n246|\t\t\t}\n247|\t\t\tif measured070[key][newClause.ID] != newClause.Line {\n248|\t\t\t\tt.Fatalf(\"binding %q clause %s v0.7.0 line %d is not the measured line %d\",\n249|\t\t\t\t\tkey, newClause.ID, newClause.Line, measured070[key][newClause.ID])\n250|\t\t\t}\n251|\t\t}\n252|\t}\n253|}\n254|\n255|// measuredClauseLines returns the production-measured line of every normative\n256|// clause the pinned document carries for the given bindings, verifying each\n257|// binding's declared excerpts quote verbatim at their declared lines.\n258|func measuredClauseLines(t *testing.T, document *specdoc.Document, bindings map[string]ownershipGroup, tag string) map[string]map[string]int {\n259|\tt.Helper()\n260|\n261|\tresult := make(map[string]map[string]int, len(bindings))\n262|\tfor key, group := range bindings {\n263|\t\tif len(group.Clauses) == 0 {\n264|\t\t\tcontinue\n265|\t\t}\n266|\t\tinventory, err := sectionClauseInventory(document, key)\n267|\t\tif err != nil {\n268|\t\t\tt.Fatalf(\"%s binding %q inventory: %v\", tag, key, err)\n269|\t\t}\n270|\t\tlines := make(map[string]int, len(inventory))\n271|\t\tfor _, clause := range inventory {\n272|\t\t\tlines[clause.ID] = clause.Line\n273|\t\t}\n274|\t\tfor _, discharged := range group.Clauses {\n275|\t\t\tif _, ok := lines[discharged.ID]; !ok {\n276|\t\t\t\tt.Fatalf(\"%s binding %q clause %s is not a measured clause of its section\", tag, key, discharged.ID)\n277|\t\t\t}\n278|\t\t\tif !quoteBeginsAtLine(document, discharged.Excerpt, discharged.Line) {\n279|\t\t\t\tt.Fatalf(\"%s binding %q clause %s excerpt does not begin at line %d\", tag, key, discharged.ID, discharged.Line)\n280|\t\t\t}\n281|\t\t}\n282|\t\tresult[key] = lines\n283|\t}\n284|\treturn result\n285|}\n286|\n287|func assertAcceptanceCasesRederive(t *testing.T, previous, current ownershipRegistry) {\n288|\tt.Helper()\n289|\n290|\toldCases := make(map[string]acceptanceCase, len(previous.AcceptanceCases))\n291|\tfor _, c := range previous.AcceptanceCases {\n292|\t\toldCases[c.ID] = c\n293|\t}\n294|\tnewCases := make(map[string]acceptanceCase, len(current.AcceptanceCases))\n295|\tfor _, c := range current.AcceptanceCases {\n296|\t\tif _, duplicate := newCases[c.ID]; duplicate {\n297|\t\t\tt.Fatalf(\"duplicate v0.7.0 acceptance case %q\", c.ID)\n298|\t\t}\n299|\t\tnewCases[c.ID] = c\n300|\t}\n301|\tfor id := range oldCases {\n302|\t\tif _, ok := newCases[id]; !ok {\n303|\t\t\tt.Fatalf(\"v0.7.0 registry drops carried acceptance case %q\", id)\n304|\t\t}\n305|\t}\n306|\tfor id := range newCases {\n307|\t\tif _, carried := oldCases[id]; carried {\n308|\t\t\tcontinue\n309|\t\t}\n310|\t\tif _, ok := newV070Cases[id]; !ok {\n311|\t\t\tt.Fatalf(\"v0.7.0 acceptance case %q is not carried and not a reviewed addition\", id)\n312|\t\t}\n313|\t}\n314|\tfor id := range newV070Cases {\n315|\t\tif _, ok := newCases[id]; !ok {\n316|\t\t\tt.Fatalf(\"reviewed v0.7.0 acceptance case %q is absent\", id)\n317|\t\t}\n318|\t}\n319|\tfor id, old := range oldCases {\n320|\t\tnow := newCases[id]\n321|\t\tif reflect.DeepEqual(now, old) {\n322|\t\t\tcontinue\n323|\t\t}\n324|\t\tswitch id {\n325|\t\tcase \"catalog-v060-exact\":\n326|\t\t\t// The adopted catalog moved to v0.7.0, so the v0.6.0 exact case\n327|\t\t\t// is repointed at the historical projection pair it now proves.\n328|\t\t\twant := acceptanceCase{\n329|\t\t\t\tID:         id,\n330|\t\t\t\tProduction: codeReference{Path: \"internal/catalog/catalog.go\", Declaration: \"ForRelease\"},\n331|\t\t\t\tTests: []codeReference{\n332|\t\t\t\t\t{Path: \"internal/catalog/catalog_test.go\", Declaration: \"TestV060ProjectionMatchesHistoricalLock\"},\n333|\t\t\t\t},\n334|\t\t\t}\n335|\t\t\tif !reflect.DeepEqual(now, want) {\n336|\t\t\t\tt.Fatalf(\"catalog-v060-exact repoint = %+v, want %+v\", now, want)\n337|\t\t\t}\n338|\t\tcase \"assigned-section-binding\":\n339|\t\t\tassertAssignedSectionBindingRename(t, old, now)\n340|\t\tdefault:\n341|\t\t\tt.Fatalf(\"carried acceptance case %q changed without a reviewed repoint\", id)\n342|\t\t}\n343|\t}\n344|}\n345|\n346|// assertAssignedSectionBindingRename allows exactly one change to the carried\n347|// case: the V060 section-identifier test becomes its V070 successor. Any other\n348|// edit, addition, or removal fails.\n349|func assertAssignedSectionBindingRename(t *testing.T, old, now acceptanceCase) {\n350|\tt.Helper()\n351|\n352|\tif now.ID != old.ID || now.Production != old.Production {\n353|\t\tt.Fatalf(\"assigned-section-binding identity moved: %+v vs %+v\", now, old)\n354|\t}\n355|\tif len(now.Tests) != len(old.Tests) {\n356|\t\tt.Fatalf(\"assigned-section-binding test list length moved from %d to %d\", len(old.Tests), len(now.Tests))\n357|\t}\n358|\trenamed := 0\n359|\tfor index, oldRef := range old.Tests {\n360|\t\tnewRef := now.Tests[index]\n361|\t\tif newRef == oldRef {\n362|\t\t\tcontinue\n363|\t\t}\n364|\t\trenamed++\n365|\t\tif newRef.Path != oldRef.Path {\n366|\t\t\tt.Fatalf(\"assigned-section-binding test %d moved path %q to %q\", index, oldRef.Path, newRef.Path)\n367|\t\t}\n368|\t\tif oldRef.Declaration != \"TestMainRejectsSyntacticallyValidNonexistentV060Section\" ||\n369|\t\t\tnewRef.Declaration != \"TestMainRejectsSyntacticallyValidNonexistentV070Section\" {\n370|\t\t\tt.Fatalf(\"assigned-section-binding test %d renamed %q to %q, want the single V060 to V070 rename\",\n371|\t\t\t\tindex, oldRef.Declaration, newRef.Declaration)\n372|\t\t}\n373|\t}\n374|\tif renamed != 1 {\n375|\t\tt.Fatalf(\"assigned-section-binding carries %d test edits, want exactly the V060 to V070 rename\", renamed)\n376|\t}\n377|}\n378|\n379|func ownershipGroupByKindAndKeys(t *testing.T, registry ownershipRegistry, kind ownershipKind, firstKey string) ownershipGroup {\n380|\tt.Helper()\n381|\n382|\tfor _, group := range registry.Ownership {\n383|\t\tif group.Kind == kind && len(group.Keys) > 0 && group.Keys[0] == firstKey {\n384|\t\t\treturn group\n385|\t\t}\n386|\t}\n387|\tt.Fatalf(\"%s group starting with %q is absent\", kind, firstKey)\n388|\treturn ownershipGroup{}\n389|}\n390|\n391|func assertOwnershipGroupsRederive(t *testing.T, previous, current ownershipRegistry) {\n392|\tt.Helper()\n393|\n394|\tassertContractGroupRederives(t, previous, current)\n395|\tassertSourceGroupRederives(t, previous, current)\n396|\n397|\t// The catalog normative-section group and the catalog fixture group are\n398|\t// adoption-independent: identical keys, owners, and cases.\n399|\tfor _, probe := range []struct {\n400|\t\tkind     ownershipKind\n401|\t\tfirstKey string\n402|\t}{\n403|\t\t{ownershipNormativeSection, \"catalog:10.8.5\"},\n404|\t\t{ownershipFixture, \"catalog:Appendix D: Directory Node operation body\"},\n405|\t} {\n406|\t\told := ownershipGroupByKindAndKeys(t, previous, probe.kind, probe.firstKey)\n407|\t\tnow := ownershipGroupByKindAndKeys(t, current, probe.kind, probe.firstKey)\n408|\t\tif !reflect.DeepEqual(now, old) {\n409|\t\t\tt.Fatalf(\"%s group %q changed: %+v vs %+v\", probe.kind, probe.firstKey, now, old)\n410|\t\t}\n411|\t}\n412|\n413|\tassertPinFixtureGroupRederives(t, previous, current)\n414|}\n415|\n416|func assertContractGroupRederives(t *testing.T, previous, current ownershipRegistry) {\n417|\tt.Helper()\n418|\n419|\told := ownershipGroupByKindAndKeys(t, previous, ownershipContract, \"Configuration [urn:ax:schema:config]\")\n420|\tnow := ownershipGroupByKindAndKeys(t, current, ownershipContract, \"Configuration [urn:ax:schema:config]\")\n421|\tif now.Production != old.Production {\n422|\t\tt.Fatalf(\"contract group production moved from %+v to %+v\", old.Production, now.Production)\n423|\t}\n424|\twantCases := []string{\"catalog-v070-exact\", \"catalog-v060-exact\", \"catalog-v050-exact\", \"catalog-v043-compatibility\"}\n425|\tif !reflect.DeepEqual(now.AcceptanceCases, wantCases) {\n426|\t\tt.Fatalf(\"contract group acceptance cases = %q, want %q\", now.AcceptanceCases, wantCases)\n427|\t}\n428|\toldKeys := oldKeySet(old.Keys)\n429|\tfor _, key := range now.Keys {\n430|\t\tif _, carried := oldKeys[key]; !carried && key != launchPlanContractKey {\n431|\t\t\tt.Fatalf(\"contract group key %q is not carried and not the Launch Plan request row\", key)\n432|\t\t}\n433|\t\tdelete(oldKeys, key)\n434|\t}\n435|\tif len(oldKeys) != 0 {\n436|\t\tt.Fatalf(\"contract group drops %d carried keys\", len(oldKeys))\n437|\t}\n438|\tfound := false\n439|\tfor _, key := range now.Keys {\n440|\t\tif key == launchPlanContractKey {\n441|\t\t\tfound = true\n442|\t\t}\n443|\t}\n444|\tif !found {\n445|\t\tt.Fatalf(\"contract group lacks the Launch Plan request row %q\", launchPlanContractKey)\n446|\t}\n447|}\n448|\n449|func oldKeySet(keys []string) map[string]struct{} {\n450|\tresult := make(map[string]struct{}, len(keys))\n451|\tfor _, key := range keys {\n452|\t\tresult[key] = struct{}{}\n453|\t}\n454|\treturn result\n455|}\n456|\n457|func assertSourceGroupRederives(t *testing.T, previous, current ownershipRegistry) {\n458|\tt.Helper()\n459|\n460|\told := ownershipGroupByKindAndKeys(t, previous, ownershipNormativeSection, \"source:1\")\n461|\tnow := ownershipGroupByKindAndKeys(t, current, ownershipNormativeSection, \"source:1\")\n462|\tif !reflect.DeepEqual(now.Keys, old.Keys) {\n463|\t\tt.Fatalf(\"source normative-section keys moved\")\n464|\t}\n465|\twantCases := []string{\"source-pin-v070-exact\", \"source-pin-v070-refusal\"}\n466|\tif !reflect.DeepEqual(now.AcceptanceCases, wantCases) {\n467|\t\tt.Fatalf(\"source group acceptance cases = %q, want %q\", now.AcceptanceCases, wantCases)\n468|\t}\n469|\t// FINDING F1 (TASK-260917-10k118): the reviewed v0.7.0 bytes keep the\n470|\t// source group's production owner at VerifyV060 while its cases moved to\n471|\t// the v0.7.0 pair. The v0.5.0→v0.6.0 precedent moved Verify to VerifyV060,\n472|\t// so the adoption pattern says VerifyV070; the gate only checks that the\n473|\t// named declaration exists, which is why the bytes are green. The\n474|\t// reconstruction must not rewrite reviewed bytes, so this test pins the\n475|\t// carried reference literally: a future fix to VerifyV070 must update\n476|\t// this pin deliberately, and any other drift fails here.\n477|\tif now.Production.Declaration != \"VerifyV060\" || now.Production.Path != \"internal/specpin/pin.go\" {\n478|\t\tt.Fatalf(\"source group production = %+v, want the carried VerifyV060 reference (see F1)\", now.Production)\n479|\t}\n480|}\n481|\n482|func assertPinFixtureGroupRederives(t *testing.T, previous, current ownershipRegistry) {\n483|\tt.Helper()\n484|\n485|\told := ownershipGroupByKindAndKeys(t, previous, ownershipFixture, \"pin:ax-session-directory-conformance-v1\")\n486|\tnow := ownershipGroupByKindAndKeys(t, current, ownershipFixture, \"pin:ax-session-directory-conformance-v1\")\n487|\tif now.Production != old.Production {\n488|\t\tt.Fatalf(\"pin fixture group production moved from %+v to %+v\", old.Production, now.Production)\n489|\t}\n490|\twantCases := []string{\"source-pin-exact\", \"source-pin-refusal\", \"source-pin-v060-exact\", \"source-pin-v060-refusal\", \"source-pin-v070-exact\", \"source-pin-v070-refusal\"}\n491|\tif !reflect.DeepEqual(now.AcceptanceCases, wantCases) {\n492|\t\tt.Fatalf(\"pin fixture group acceptance cases = %q, want %q\", now.AcceptanceCases, wantCases)\n493|\t}\n494|\toldKeys := oldKeySet(old.Keys)\n495|\tfor _, key := range now.Keys {\n496|\t\tif _, carried := oldKeys[key]; !carried && key != launchPlanFixtureKey {\n497|\t\t\tt.Fatalf(\"pin fixture group key %q is not carried and not the Launch Plan fixture\", key)\n498|\t\t}\n499|\t\tdelete(oldKeys, key)\n500|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
