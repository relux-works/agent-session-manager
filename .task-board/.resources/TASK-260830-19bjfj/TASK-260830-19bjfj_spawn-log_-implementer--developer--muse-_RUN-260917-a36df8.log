{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d58f","stream":{"kind":"session","id":"01a0b17d-598e-7f80-b6bd-728e9f57759a"},"sequence":2338,"recorded_at":1780531400004671,"record_type":"event","durability":"durable","causation_id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba","run_stream":{"kind":"run","id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba"},"task_stream":{"kind":"task","id":"01a0b188-64ff-70a3-a8b4-b998b0bb8ea8"},"task_id":"01a0b188-64ff-70a3-a8b4-b998b0bb8ea8","event":{"kind":"output","task_id":"01a0b188-64ff-70a3-a8b4-b998b0bb8ea8","chunk":"Read text file `internal/rpcwire/adversarial_test.go`.\n1|package rpcwire_test\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/base64\"\n6|\t\"encoding/json\"\n7|\t\"errors\"\n8|\t\"fmt\"\n9|\t\"slices\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/rpcwire\"\n15|)\n16|\n17|// TestClosedBodyMemberSweep drives the closed-shape contract of every\n18|// operation body the landed code parses (hello and inventory.roots, Sections\n19|// 11.2-11.3) through the production DecodeRequest entry: a missing member,\n20|// an extra top-level member, and a member of the wrong type each refuse with\n21|// the pinned sentinel. Every other operation of the Section 11.3 registry is\n22|// opaque by design (TestOpaqueOperationBoundary) and is a stated bound, not\n23|// a row here.\n24|func TestClosedBodyMemberSweep(t *testing.T) {\n25|\thelloMembers := []string{\"host_id\", \"platform\", \"ax_version\", \"nonce\", \"contracts\", \"max_line_bytes\", \"max_object_bytes\"}\n26|\twrongTypes := map[string]any{\n27|\t\t\"host_id\":          42,\n28|\t\t\"platform\":         true,\n29|\t\t\"ax_version\":       []any{\"0.2.1\"},\n30|\t\t\"nonce\":            42,\n31|\t\t\"contracts\":        \"rpc\",\n32|\t\t\"max_line_bytes\":   \"8388608\",\n33|\t\t\"max_object_bytes\": true,\n34|\t}\n35|\tfor _, member := range helloMembers {\n36|\t\tt.Run(\"hello-missing-\"+member, func(t *testing.T) {\n37|\t\t\tm := hello(t, \"2.0.0\", false)\n38|\t\t\tdelete(m[\"body\"].(map[string]any), member)\n39|\t\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrHello) {\n40|\t\t\t\tt.Fatalf(\"missing %s: err = %v, want ErrHello\", member, err)\n41|\t\t\t}\n42|\t\t})\n43|\t\tt.Run(\"hello-wrongtype-\"+member, func(t *testing.T) {\n44|\t\t\tm := hello(t, \"2.0.0\", false)\n45|\t\t\tm[\"body\"].(map[string]any)[member] = wrongTypes[member]\n46|\t\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrHello) {\n47|\t\t\t\tt.Fatalf(\"wrong-type %s: err = %v, want ErrHello\", member, err)\n48|\t\t\t}\n49|\t\t})\n50|\t}\n51|\tt.Run(\"hello-extra-member\", func(t *testing.T) {\n52|\t\tm := hello(t, \"2.0.0\", false)\n53|\t\tm[\"body\"].(map[string]any)[\"future\"] = true\n54|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrHello) {\n55|\t\t\tt.Fatalf(\"extra member: err = %v, want ErrHello\", err)\n56|\t\t}\n57|\t})\n58|\tt.Run(\"inventory-missing-namespaces\", func(t *testing.T) {\n59|\t\tm := inventoryRequest(t, \"2.0.0\", map[string]any{\"other\": []any{\"blob\"}})\n60|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrInventory) {\n61|\t\t\tt.Fatalf(\"err = %v, want ErrInventory\", err)\n62|\t\t}\n63|\t})\n64|\tt.Run(\"inventory-extra-member\", func(t *testing.T) {\n65|\t\tm := inventoryRequest(t, \"2.0.0\", map[string]any{\"namespaces\": []any{\"blob\"}, \"future\": true})\n66|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrInventory) {\n67|\t\t\tt.Fatalf(\"err = %v, want ErrInventory\", err)\n68|\t\t}\n69|\t})\n70|\tfor _, wrong := range []any{\"blob\", 42.0, true, nil, map[string]any{\"blob\": true}} {\n71|\t\tt.Run(fmt.Sprintf(\"inventory-wrongtype-%T\", wrong), func(t *testing.T) {\n72|\t\t\tm := inventoryRequest(t, \"2.0.0\", map[string]any{\"namespaces\": wrong})\n73|\t\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrInventory) {\n74|\t\t\t\tt.Fatalf(\"err = %v, want ErrInventory\", err)\n75|\t\t\t}\n76|\t\t})\n77|\t}\n78|}\n79|\n80|func inventoryRequest(t *testing.T, version string, body map[string]any) map[string]any {\n81|\tt.Helper()\n82|\treturn map[string]any{\n83|\t\t\"protocol\":         rpcwire.Protocol,\n84|\t\t\"protocol_version\": version,\n85|\t\t\"request_id\":       id,\n86|\t\t\"operation\":        \"inventory.roots\",\n87|\t\t\"body\":             body,\n88|\t}\n89|}\n90|\n91|// TestClosedBodyBoundsWitnessed pins every bound of the parsed bodies at both\n92|// edges and one step outside through DecodeRequest, plus the independence of\n93|// max_object_bytes from max_line_bytes: each floor refuses on its own while\n94|// the other is satisfied.\n95|func TestClosedBodyBoundsWitnessed(t *testing.T) {\n96|\tnonce16 := base64.RawURLEncoding.EncodeToString(bytes.Repeat([]byte{0x01}, 16))\n97|\tt.Run(\"nonce-16-bytes-admitted\", func(t *testing.T) {\n98|\t\tm := hello(t, \"2.0.0\", false)\n99|\t\tm[\"body\"].(map[string]any)[\"nonce\"] = nonce16\n100|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); err != nil {\n101|\t\t\tt.Fatalf(\"16-byte nonce refused: %v\", err)\n102|\t\t}\n103|\t})\n104|\tt.Run(\"nonce-15-bytes-refused\", func(t *testing.T) {\n105|\t\tm := hello(t, \"2.0.0\", false)\n106|\t\tm[\"body\"].(map[string]any)[\"nonce\"] = base64.RawURLEncoding.EncodeToString(bytes.Repeat([]byte{0x01}, 15))\n107|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrHello) {\n108|\t\t\tt.Fatalf(\"15-byte nonce: err = %v, want ErrHello\", err)\n109|\t\t}\n110|\t})\n111|\tt.Run(\"nonce-standard-alphabet-refused\", func(t *testing.T) {\n112|\t\t// 18 bytes of 0xfb: standard encoding carries '+' with no padding,\n113|\t\t// so only the alphabet (not length or padding) is at issue.\n114|\t\traw := bytes.Repeat([]byte{0xfb}, 18)\n115|\t\tstd := base64.StdEncoding.EncodeToString(raw)\n116|\t\tif !strings.Contains(std, \"+\") || strings.Contains(std, \"=\") {\n117|\t\t\tt.Fatalf(\"fixture carries no isolated alphabet witness: %q\", std)\n118|\t\t}\n119|\t\tm := hello(t, \"2.0.0\", false)\n120|\t\tm[\"body\"].(map[string]any)[\"nonce\"] = std\n121|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrHello) {\n122|\t\t\tt.Fatalf(\"standard-alphabet nonce: err = %v, want ErrHello\", err)\n123|\t\t}\n124|\t})\n125|\tt.Run(\"nonce-padded-refused\", func(t *testing.T) {\n126|\t\tm := hello(t, \"2.0.0\", false)\n127|\t\tm[\"body\"].(map[string]any)[\"nonce\"] = base64.URLEncoding.EncodeToString(bytes.Repeat([]byte{0x01}, 16))\n128|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrHello) {\n129|\t\t\tt.Fatalf(\"padded nonce: err = %v, want ErrHello\", err)\n130|\t\t}\n131|\t})\n132|\tt.Run(\"line-floor-independent\", func(t *testing.T) {\n133|\t\tm := hello(t, \"2.0.0\", false)\n134|\t\tbody := m[\"body\"].(map[string]any)\n135|\t\tbody[\"max_line_bytes\"] = 8388607\n136|\t\tbody[\"max_object_bytes\"] = 7 * 1024 * 1024\n137|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrHello) {\n138|\t\t\tt.Fatalf(\"low line limit with generous object limit: err = %v, want ErrHello\", err)\n139|\t\t}\n140|\t})\n141|\tt.Run(\"object-floor-independent\", func(t *testing.T) {\n142|\t\tm := hello(t, \"2.0.0\", false)\n143|\t\tbody := m[\"body\"].(map[string]any)\n144|\t\tbody[\"max_line_bytes\"] = 10 * 1024 * 1024\n145|\t\tbody[\"max_object_bytes\"] = 5242879\n146|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrHello) {\n147|\t\t\tt.Fatalf(\"low object limit with generous line limit: err = %v, want ErrHello\", err)\n148|\t\t}\n149|\t})\n150|\tt.Run(\"both-floors-admitted\", func(t *testing.T) {\n151|\t\tm := hello(t, \"2.0.0\", false)\n152|\t\tbody := m[\"body\"].(map[string]any)\n153|\t\tbody[\"max_line_bytes\"] = 8388608\n154|\t\tbody[\"max_object_bytes\"] = 5242880\n155|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); err != nil {\n156|\t\t\tt.Fatalf(\"exact floors refused: %v\", err)\n157|\t\t}\n158|\t})\n159|\tt.Run(\"contracts-16-admitted-17-refused\", func(t *testing.T) {\n160|\t\tadmit := hello(t, \"2.0.0\", false)\n161|\t\tversions := make([]string, 0, 16)\n162|\t\tfor i := range 16 {\n163|\t\t\tversions = append(versions, fmt.Sprintf(\"1.%d.0\", i))\n164|\t\t}\n165|\t\tslices.Sort(versions)\n166|\t\tadmit[\"body\"].(map[string]any)[\"contracts\"].(map[string]any)[\"lease\"] = versions\n167|\t\tif _, err := rpcwire.DecodeRequest(wire(t, admit)); err != nil {\n168|\t\t\tt.Fatalf(\"16 versions refused: %v\", err)\n169|\t\t}\n170|\t\trefuse := hello(t, \"2.0.0\", false)\n171|\t\tseventeen := make([]string, 0, 17)\n172|\t\tfor i := range 17 {\n173|\t\t\tseventeen = append(seventeen, fmt.Sprintf(\"1.%d.0\", i))\n174|\t\t}\n175|\t\tslices.Sort(seventeen)\n176|\t\trefuse[\"body\"].(map[string]any)[\"contracts\"].(map[string]any)[\"lease\"] = seventeen\n177|\t\tif _, err := rpcwire.DecodeRequest(wire(t, refuse)); !errors.Is(err, rpcwire.ErrHello) {\n178|\t\t\tt.Fatalf(\"17 versions: err = %v, want ErrHello\", err)\n179|\t\t}\n180|\t})\n181|}\n182|\n183|// TestNamespaceVocabularyPerMember admits every namespace of each major's\n184|// pinned vocabulary singly and refuses near-miss spellings and\n185|// future-major members through DecodeRequest.\n186|func TestNamespaceVocabularyPerMember(t *testing.T) {\n187|\tvocabularies := map[string][]string{\n188|\t\t\"2.0.0\": {\"blob\", \"event\", \"manifest\", \"record\", \"tombstone\", \"tombstone_ack\"},\n189|\t\t\"3.0.0\": {\"blob\", \"directory_record\", \"event\", \"manifest\", \"record\", \"tombstone\", \"tombstone_ack\"},\n190|\t\t\"4.0.0\": {\"blob\", \"directory_record\", \"event\", \"manifest\", \"record\", \"terminal_backend_evidence\", \"tombstone\", \"tombstone_ack\"},\n191|\t\t\"5.0.0\": {\"blob\", \"directory_record\", \"event\", \"manifest\", \"record\", \"terminal_backend_evidence\", \"tombstone\", \"tombstone_ack\"},\n192|\t}\n193|\tfor _, version := range []string{\"2.0.0\", \"3.0.0\", \"4.0.0\", \"5.0.0\"} {\n194|\t\tnames, err := rpcwire.Namespaces(version)\n195|\t\tif err != nil {\n196|\t\t\tt.Fatal(err)\n197|\t\t}\n198|\t\tif !slices.Equal(names, vocabularies[version]) {\n199|\t\t\tt.Fatalf(\"Namespaces(%s) = %v, want the spec vocabulary %v\", version, names, vocabularies[version])\n200|\t\t}\n201|\t\tfor _, name := range vocabularies[version] {\n202|\t\t\tt.Run(version+\"/admit-\"+name, func(t *testing.T) {\n203|\t\t\t\tm := inventoryRequest(t, version, map[string]any{\"namespaces\": []any{name}})\n204|\t\t\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); err != nil {\n205|\t\t\t\t\tt.Fatalf(\"namespace %q refused in %s: %v\", name, version, err)\n206|\t\t\t\t}\n207|\t\t\t})\n208|\t\t}\n209|\t}\n210|\tnearMiss := []string{\"Record\", \"RECORD\", \" record\", \"record \", \"blob\\n\", \"\", \"tombstone-ack\", \"tombstoneack\"}\n211|\tfor _, version := range []string{\"2.0.0\", \"3.0.0\", \"4.0.0\", \"5.0.0\"} {\n212|\t\tfor _, name := range nearMiss {\n213|\t\t\tt.Run(version+\"/refuse-\"+fmt.Sprintf(\"%q\", name), func(t *testing.T) {\n214|\t\t\t\tm := inventoryRequest(t, version, map[string]any{\"namespaces\": []any{name}})\n215|\t\t\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrInventory) {\n216|\t\t\t\t\tt.Fatalf(\"namespace %q in %s: err = %v, want ErrInventory\", name, version, err)\n217|\t\t\t\t}\n218|\t\t\t})\n219|\t\t}\n220|\t}\n221|\tfor _, tc := range []struct{ version, name string }{\n222|\t\t{\"2.0.0\", \"directory_record\"},\n223|\t\t{\"2.0.0\", \"terminal_backend_evidence\"},\n224|\t\t{\"3.0.0\", \"terminal_backend_evidence\"},\n225|\t} {\n226|\t\tt.Run(tc.version+\"/refuse-future-\"+tc.name, func(t *testing.T) {\n227|\t\t\tm := inventoryRequest(t, tc.version, map[string]any{\"namespaces\": []any{tc.name}})\n228|\t\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrInventory) {\n229|\t\t\t\tt.Fatalf(\"err = %v, want ErrInventory\", err)\n230|\t\t\t}\n231|\t\t})\n232|\t}\n233|}\n234|\n235|// TestNamespaceMismatchMatrix proves a root reported under the wrong\n236|// namespace refuses no matter which valid namespace lands in which slot:\n237|// every off-diagonal placement of the v2 vocabulary is refused through\n238|// EncodeSuccess, and the diagonal admits.\n239|func TestNamespaceMismatchMatrix(t *testing.T) {\n240|\tnames := []string{\"blob\", \"event\", \"manifest\", \"record\", \"tombstone\", \"tombstone_ack\"}\n241|\tm := inventoryRequest(t, \"2.0.0\", map[string]any{\"namespaces\": names})\n242|\tr, err := rpcwire.DecodeRequest(wire(t, m))\n243|\tif err != nil {\n244|\t\tt.Fatal(err)\n245|\t}\n246|\troots := func(order []string) json.RawMessage {\n247|\t\titems := make([]any, 0, len(order))\n248|\t\tfor _, name := range order {\n249|\t\t\titems = append(items, map[string]any{\"namespace\": name, \"count\": 0, \"root_id\": \"sha256:\" + strings.Repeat(\"0\", 64)})\n250|\t\t}\n251|\t\traw, err := json.Marshal(map[string]any{\"roots\": items})\n252|\t\tif err != nil {\n253|\t\t\tt.Fatal(err)\n254|\t\t}\n255|\t\treturn raw\n256|\t}\n257|\tif _, err := rpcwire.EncodeSuccess(r, roots(names)); err != nil {\n258|\t\tt.Fatalf(\"diagonal roots refused: %v\", err)\n259|\t}\n260|\tfor i := range names {\n261|\t\tfor j := range names {\n262|\t\t\tif i == j {\n263|\t\t\t\tcontinue\n264|\t\t\t}\n265|\t\t\tt.Run(fmt.Sprintf(\"slot-%d-carries-%s\", i, names[j]), func(t *testing.T) {\n266|\t\t\t\tmisplaced := slices.Clone(names)\n267|\t\t\t\tmisplaced[i] = names[j]\n268|\t\t\t\tif _, err := rpcwire.EncodeSuccess(r, roots(misplaced)); !errors.Is(err, rpcwire.ErrInventory) {\n269|\t\t\t\t\tt.Fatalf(\"err = %v, want ErrInventory\", err)\n270|\t\t\t\t}\n271|\t\t\t})\n272|\t\t}\n273|\t}\n274|}\n275|\n276|// TestUnknownFieldsRefusedEverywhere drives one extra member through every\n277|// closed shape the landed code parses: the request envelope, the hello\n278|// request and success bodies, the inventory request and success bodies, and\n279|// both failure-shape directions.\n280|func TestUnknownFieldsRefusedEverywhere(t *testing.T) {\n281|\tt.Run(\"envelope\", func(t *testing.T) {\n282|\t\tm := hello(t, \"2.0.0\", false)\n283|\t\tm[\"extensions\"] = map[string]any{\"works.relux.ax.future\": map[string]any{\"a\": 1}}\n284|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrFrame) {\n285|\t\t\tt.Fatalf(\"err = %v, want ErrFrame\", err)\n286|\t\t}\n287|\t})\n288|\tt.Run(\"hello-request-body\", func(t *testing.T) {\n289|\t\tm := hello(t, \"2.0.0\", false)\n290|\t\tm[\"body\"].(map[string]any)[\"extensions\"] = map[string]any{}\n291|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrHello) {\n292|\t\t\tt.Fatalf(\"err = %v, want ErrHello\", err)\n293|\t\t}\n294|\t})\n295|\tt.Run(\"hello-response-body\", func(t *testing.T) {\n296|\t\tr := request(t, hello(t, \"2.0.0\", false))\n297|\t\tm := hello(t, \"2.0.0\", true)\n298|\t\tm[\"body\"].(map[string]any)[\"extensions\"] = map[string]any{}\n299|\t\tif _, err := rpcwire.DecodeResponse(wire(t, m), r); !errors.Is(err, rpcwire.ErrHello) {\n300|\t\t\tt.Fatalf(\"err = %v, want ErrHello\", err)\n301|\t\t}\n302|\t})\n303|\tt.Run(\"inventory-request-body\", func(t *testing.T) {\n304|\t\tm := inventoryRequest(t, \"2.0.0\", map[string]any{\"namespaces\": []any{\"blob\"}, \"extensions\": map[string]any{}})\n305|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrInventory) {\n306|\t\t\tt.Fatalf(\"err = %v, want ErrInventory\", err)\n307|\t\t}\n308|\t})\n309|\tt.Run(\"inventory-success-body\", func(t *testing.T) {\n310|\t\tm := inventoryRequest(t, \"2.0.0\", map[string]any{\"namespaces\": []any{\"blob\"}})\n311|\t\tr, err := rpcwire.DecodeRequest(wire(t, m))\n312|\t\tif err != nil {\n313|\t\t\tt.Fatal(err)\n314|\t\t}\n315|\t\tbody := map[string]any{\n316|\t\t\t\"roots\":      []any{map[string]any{\"namespace\": \"blob\", \"count\": 0, \"root_id\": \"sha256:\" + strings.Repeat(\"0\", 64)}},\n317|\t\t\t\"extensions\": map[string]any{},\n318|\t\t}\n319|\t\tif _, err := rpcwire.EncodeSuccess(r, wire(t, body)); !errors.Is(err, rpcwire.ErrInventory) {\n320|\t\t\tt.Fatalf(\"err = %v, want ErrInventory\", err)\n321|\t\t}\n322|\t})\n323|\tt.Run(\"failure-carries-body\", func(t *testing.T) {\n324|\t\tr := request(t, hello(t, \"2.0.0\", false))\n325|\t\tm := map[string]any{\n326|\t\t\t\"protocol\":         rpcwire.Protocol,\n327|\t\t\t\"protocol_version\": \"2.0.0\",\n328|\t\t\t\"request_id\":       id,\n329|\t\t\t\"ok\":               false,\n330|\t\t\t\"error\":            map[string]any{\"schema\": \"urn:ax:schema:error\", \"schema_version\": \"1.0.0\", \"code\": \"incompatible_protocol\", \"message\": \"x\", \"exit_code\": 6, \"retryable\": false, \"details\": map[string]any{}},\n331|\t\t\t\"body\":             map[string]any{},\n332|\t\t}\n333|\t\tif _, err := rpcwire.DecodeResponse(wire(t, m), r); !errors.Is(err, rpcwire.ErrFrame) {\n334|\t\t\tt.Fatalf(\"err = %v, want ErrFrame\", err)\n335|\t\t}\n336|\t})\n337|\tt.Run(\"success-carries-error\", func(t *testing.T) {\n338|\t\tr := request(t, hello(t, \"2.0.0\", false))\n339|\t\tm := hello(t, \"2.0.0\", true)\n340|\t\tm[\"error\"] = nil\n341|\t\tif _, err := rpcwire.DecodeResponse(wire(t, m), r); !errors.Is(err, rpcwire.ErrFrame) {\n342|\t\t\tt.Fatalf(\"err = %v, want ErrFrame\", err)\n343|\t\t}\n344|\t})\n345|}\n346|\n347|// TestExtensionsDirections proves both directions of the Section 17.1\n348|// extension rule at the RPC layer: the same namespaced data refused at the\n349|// envelope top level is admitted byte-identical inside an opaque operation\n350|// body, while the closed parsed bodies stay closed.\n351|func TestExtensionsDirections(t *testing.T) {\n352|\tnamespaced := map[string]any{\"works.relux.ax.future\": map[string]any{\"a\": 1}}\n353|\tt.Run(\"envelope-top-level-refused\", func(t *testing.T) {\n354|\t\tm := hello(t, \"2.0.0\", false)\n355|\t\tm[\"extensions\"] = namespaced\n356|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrFrame) {\n357|\t\t\tt.Fatalf(\"err = %v, want ErrFrame\", err)\n358|\t\t}\n359|\t})\n360|\tt.Run(\"hello-body-refused\", func(t *testing.T) {\n361|\t\tm := hello(t, \"2.0.0\", false)\n362|\t\tm[\"body\"].(map[string]any)[\"extensions\"] = namespaced\n363|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrHello) {\n364|\t\t\tt.Fatalf(\"err = %v, want ErrHello\", err)\n365|\t\t}\n366|\t})\n367|\tt.Run(\"inventory-body-refused\", func(t *testing.T) {\n368|\t\tm := inventoryRequest(t, \"2.0.0\", map[string]any{\"namespaces\": []any{\"blob\"}, \"extensions\": namespaced})\n369|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrInventory) {\n370|\t\t\tt.Fatalf(\"err = %v, want ErrInventory\", err)\n371|\t\t}\n372|\t})\n373|\tt.Run(\"opaque-body-admitted-identical\", func(t *testing.T) {\n374|\t\tbody := wire(t, map[string]any{\"extensions\": namespaced})\n375|\t\tline, err := rpcwire.EncodeRequest(\"2.0.0\", id, \"health.get\", body)\n376|\t\tif err != nil {\n377|\t\t\tt.Fatal(err)\n378|\t\t}\n379|\t\tr, err := rpcwire.DecodeRequest(line)\n380|\t\tif err != nil {\n381|\t\t\tt.Fatal(err)\n382|\t\t}\n383|\t\tif !bytes.Equal(r.Body(), body) {\n384|\t\t\tt.Fatal(\"opaque extension body altered\")\n385|\t\t}\n386|\t})\n387|}\n388|\n389|// TestResponseCorrelationClasses pins the refusal class of every\n390|// correlation failure through DecodeResponse: a mismatched echo (ID or\n391|// hello nonce echo) is ErrCorrelation, a version skew is ErrVersion, and a\n392|// zero expectation can correlate nothing.\n393|func TestResponseCorrelationClasses(t *testing.T) {\n394|\tr := request(t, hello(t, \"2.0.0\", false))\n395|\tt.Run(\"mismatched-id\", func(t *testing.T) {\n396|\t\tm := hello(t, \"2.0.0\", true)\n397|\t\tm[\"request_id\"] = otherID\n398|\t\tif _, err := rpcwire.DecodeResponse(wire(t, m), r); !errors.Is(err, rpcwire.ErrCorrelation) {\n399|\t\t\tt.Fatalf(\"err = %v, want ErrCorrelation\", err)\n400|\t\t}\n401|\t})\n402|\tt.Run(\"mismatched-version\", func(t *testing.T) {\n403|\t\tm := hello(t, \"3.0.0\", true)\n404|\t\tif _, err := rpcwire.DecodeResponse(wire(t, m), r); !errors.Is(err, rpcwire.ErrVersion) {\n405|\t\t\tt.Fatalf(\"err = %v, want ErrVersion\", err)\n406|\t\t}\n407|\t})\n408|\tt.Run(\"mismatched-nonce-echo\", func(t *testing.T) {\n409|\t\tm := hello(t, \"2.0.0\", true)\n410|\t\tm[\"body\"].(map[string]any)[\"nonce_echo\"] = \"cXJzdHV2d3h5ejAxMjM0NQ\"\n411|\t\tif _, err := rpcwire.DecodeResponse(wire(t, m), r); !errors.Is(err, rpcwire.ErrCorrelation) {\n412|\t\t\tt.Fatalf(\"err = %v, want ErrCorrelation\", err)\n413|\t\t}\n414|\t})\n415|\tt.Run(\"zero-expectation\", func(t *testing.T) {\n416|\t\tm := hello(t, \"2.0.0\", true)\n417|\t\tif _, err := rpcwire.DecodeResponse(wire(t, m), rpcwire.Request{}); !errors.Is(err, rpcwire.ErrCorrelation) {\n418|\t\t\tt.Fatalf(\"err = %v, want ErrCorrelation\", err)\n419|\t\t}\n420|\t})\n421|}\n422|\n423|// TestMajor1RejectedNotReinterpreted proves a 2.0.0 peer rejects major 1\n424|// with the version class at every rpcwire entry instead of coercing it.\n425|func TestMajor1RejectedNotReinterpreted(t *testing.T) {\n426|\tm := hello(t, \"2.0.0\", false)\n427|\tm[\"protocol_version\"] = \"1.0.0\"\n428|\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrVersion) {\n429|\t\tt.Fatalf(\"DecodeRequest(1.0.0): err = %v, want ErrVersion\", err)\n430|\t}\n431|\tif _, err := rpcwire.EncodeRequest(\"1.0.0\", id, \"health.get\", []byte(`{}`)); !errors.Is(err, rpcwire.ErrVersion) {\n432|\t\tt.Fatalf(\"EncodeRequest(1.0.0): err = %v, want ErrVersion\", err)\n433|\t}\n434|\tif _, err := rpcwire.ContractProfile(\"1.0.0\"); !errors.Is(err, rpcwire.ErrVersion) {\n435|\t\tt.Fatalf(\"ContractProfile(1.0.0): err = %v, want ErrVersion\", err)\n436|\t}\n437|\tif _, err := rpcwire.Namespaces(\"1.0.0\"); !errors.Is(err, rpcwire.ErrVersion) {\n438|\t\tt.Fatalf(\"Namespaces(1.0.0): err = %v, want ErrVersion\", err)\n439|\t}\n440|\tr := request(t, hello(t, \"2.0.0\", false))\n441|\tresp := hello(t, \"2.0.0\", true)\n442|\tresp[\"protocol_version\"] = \"1.0.0\"\n443|\tif _, err := rpcwire.DecodeResponse(wire(t, resp), r); !errors.Is(err, rpcwire.ErrVersion) {\n444|\t\tt.Fatalf(\"DecodeResponse(1.0.0): err = %v, want ErrVersion\", err)\n445|\t}\n446|}\n447|\n448|// TestErrorSchemaNotNegotiated drives a peer that tries to negotiate the\n449|// Structured Error schema: a failure document carrying a foreign\n450|// schema_version is refused through DecodeResponse even though the document\n451|// itself is well-formed, because the version is fixed by the containing\n452|// protocol (RPC 2 binds Error 1.0.0, RPC 4/5 bind Error 1.3.0).\n453|func TestErrorSchemaNotNegotiated(t *testing.T) {\n454|\tbuild := func(t *testing.T, version axerror.Version) map[string]any {\n455|\t\tt.Helper()\n456|\t\tfailure, err := axerror.New(axerror.Spec{Version: version, Code: \"incompatible_protocol\", Message: \"peer framed\", Details: axerror.Details{}})\n457|\t\tif err != nil {\n458|\t\t\tt.Fatal(err)\n459|\t\t}\n460|\t\traw, err := failure.MarshalJSON()\n461|\t\tif err != nil {\n462|\t\t\tt.Fatal(err)\n463|\t\t}\n464|\t\tvar doc map[string]any\n465|\t\tif err := json.Unmarshal(raw, &doc); err != nil {\n466|\t\t\tt.Fatal(err)\n467|\t\t}\n468|\t\treturn doc\n469|\t}\n470|\tframe := func(t *testing.T, rpcVersion, requestID string, doc map[string]any) []byte {\n471|\t\tt.Helper()\n472|\t\treturn wire(t, map[string]any{\n473|\t\t\t\"protocol\":         rpcwire.Protocol,\n474|\t\t\t\"protocol_version\": rpcVersion,\n475|\t\t\t\"request_id\":       requestID,\n476|\t\t\t\"ok\":               false,\n477|\t\t\t\"error\":            doc,\n478|\t\t})\n479|\t}\n480|\tt.Run(\"rpc2-refuses-error-1.3.0\", func(t *testing.T) {\n481|\t\tr := request(t, hello(t, \"2.0.0\", false))\n482|\t\tif _, err := rpcwire.DecodeResponse(frame(t, \"2.0.0\", id, build(t, axerror.Version130)), r); err == nil {\n483|\t\t\tt.Fatal(\"RPC 2 admitted an Error 1.3.0 document\")\n484|\t\t}\n485|\t})\n486|\tt.Run(\"rpc5-refuses-error-1.0.0\", func(t *testing.T) {\n487|\t\tr := request(t, hello(t, \"5.0.0\", false))\n488|\t\tif _, err := rpcwire.DecodeResponse(frame(t, \"5.0.0\", id, build(t, axerror.Version100)), r); err == nil {\n489|\t\t\tt.Fatal(\"RPC 5 admitted an Error 1.0.0 document\")\n490|\t\t}\n491|\t})\n492|\tt.Run(\"rpc4-refuses-error-1.0.0\", func(t *testing.T) {\n493|\t\tr := request(t, hello(t, \"4.0.0\", false))\n494|\t\tif _, err := rpcwire.DecodeResponse(frame(t, \"4.0.0\", id, build(t, axerror.Version100)), r); err == nil {\n495|\t\t\tt.Fatal(\"RPC 4 admitted an Error 1.0.0 document\")\n496|\t\t}\n497|\t})\n498|\tt.Run(\"bound-versions-admit\", func(t *testing.T) {\n499|\t\tfor _, tc := range []struct {\n500|\t\t\trpc   string\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d591","stream":{"kind":"session","id":"01a0b17d-598e-7f80-b6bd-728e9f57759a"},"sequence":2339,"recorded_at":1780531400004673,"record_type":"event","durability":"durable","causation_id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba","run_stream":{"kind":"run","id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba"},"task_stream":{"kind":"task","id":"01a0b188-64ff-70a3-a8b4-b998b0bb8ea8"},"task_id":"01a0b188-64ff-70a3-a8b4-b998b0bb8ea8","event":{"kind":"completed","task_id":"01a0b188-64ff-70a3-a8b4-b998b0bb8ea8"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d593","stream":{"kind":"session","id":"01a0b17d-598e-7f80-b6bd-728e9f57759a"},"sequence":2340,"recorded_at":1780531400004675,"record_type":"event","durability":"durable","causation_id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba","run_stream":{"kind":"run","id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba"},"call_id":"call_01a0b188627b7540ab9edb6483a82ede","text":"Read text file `internal/rpcwire/adversarial_test.go`.\n1|package rpcwire_test\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/base64\"\n6|\t\"encoding/json\"\n7|\t\"errors\"\n8|\t\"fmt\"\n9|\t\"slices\"\n10|\t\"strings\"\n11|\t\"testing\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/rpcwire\"\n15|)\n16|\n17|// TestClosedBodyMemberSweep drives the closed-shape contract of every\n18|// operation body the landed code parses (hello and inventory.roots, Sections\n19|// 11.2-11.3) through the production DecodeRequest entry: a missing member,\n20|// an extra top-level member, and a member of the wrong type each refuse with\n21|// the pinned sentinel. Every other operation of the Section 11.3 registry is\n22|// opaque by design (TestOpaqueOperationBoundary) and is a stated bound, not\n23|// a row here.\n24|func TestClosedBodyMemberSweep(t *testing.T) {\n25|\thelloMembers := []string{\"host_id\", \"platform\", \"ax_version\", \"nonce\", \"contracts\", \"max_line_bytes\", \"max_object_bytes\"}\n26|\twrongTypes := map[string]any{\n27|\t\t\"host_id\":          42,\n28|\t\t\"platform\":         true,\n29|\t\t\"ax_version\":       []any{\"0.2.1\"},\n30|\t\t\"nonce\":            42,\n31|\t\t\"contracts\":        \"rpc\",\n32|\t\t\"max_line_bytes\":   \"8388608\",\n33|\t\t\"max_object_bytes\": true,\n34|\t}\n35|\tfor _, member := range helloMembers {\n36|\t\tt.Run(\"hello-missing-\"+member, func(t *testing.T) {\n37|\t\t\tm := hello(t, \"2.0.0\", false)\n38|\t\t\tdelete(m[\"body\"].(map[string]any), member)\n39|\t\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrHello) {\n40|\t\t\t\tt.Fatalf(\"missing %s: err = %v, want ErrHello\", member, err)\n41|\t\t\t}\n42|\t\t})\n43|\t\tt.Run(\"hello-wrongtype-\"+member, func(t *testing.T) {\n44|\t\t\tm := hello(t, \"2.0.0\", false)\n45|\t\t\tm[\"body\"].(map[string]any)[member] = wrongTypes[member]\n46|\t\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrHello) {\n47|\t\t\t\tt.Fatalf(\"wrong-type %s: err = %v, want ErrHello\", member, err)\n48|\t\t\t}\n49|\t\t})\n50|\t}\n51|\tt.Run(\"hello-extra-member\", func(t *testing.T) {\n52|\t\tm := hello(t, \"2.0.0\", false)\n53|\t\tm[\"body\"].(map[string]any)[\"future\"] = true\n54|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrHello) {\n55|\t\t\tt.Fatalf(\"extra member: err = %v, want ErrHello\", err)\n56|\t\t}\n57|\t})\n58|\tt.Run(\"inventory-missing-namespaces\", func(t *testing.T) {\n59|\t\tm := inventoryRequest(t, \"2.0.0\", map[string]any{\"other\": []any{\"blob\"}})\n60|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrInventory) {\n61|\t\t\tt.Fatalf(\"err = %v, want ErrInventory\", err)\n62|\t\t}\n63|\t})\n64|\tt.Run(\"inventory-extra-member\", func(t *testing.T) {\n65|\t\tm := inventoryRequest(t, \"2.0.0\", map[string]any{\"namespaces\": []any{\"blob\"}, \"future\": true})\n66|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrInventory) {\n67|\t\t\tt.Fatalf(\"err = %v, want ErrInventory\", err)\n68|\t\t}\n69|\t})\n70|\tfor _, wrong := range []any{\"blob\", 42.0, true, nil, map[string]any{\"blob\": true}} {\n71|\t\tt.Run(fmt.Sprintf(\"inventory-wrongtype-%T\", wrong), func(t *testing.T) {\n72|\t\t\tm := inventoryRequest(t, \"2.0.0\", map[string]any{\"namespaces\": wrong})\n73|\t\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrInventory) {\n74|\t\t\t\tt.Fatalf(\"err = %v, want ErrInventory\", err)\n75|\t\t\t}\n76|\t\t})\n77|\t}\n78|}\n79|\n80|func inventoryRequest(t *testing.T, version string, body map[string]any) map[string]any {\n81|\tt.Helper()\n82|\treturn map[string]any{\n83|\t\t\"protocol\":         rpcwire.Protocol,\n84|\t\t\"protocol_version\": version,\n85|\t\t\"request_id\":       id,\n86|\t\t\"operation\":        \"inventory.roots\",\n87|\t\t\"body\":             body,\n88|\t}\n89|}\n90|\n91|// TestClosedBodyBoundsWitnessed pins every bound of the parsed bodies at both\n92|// edges and one step outside through DecodeRequest, plus the independence of\n93|// max_object_bytes from max_line_bytes: each floor refuses on its own while\n94|// the other is satisfied.\n95|func TestClosedBodyBoundsWitnessed(t *testing.T) {\n96|\tnonce16 := base64.RawURLEncoding.EncodeToString(bytes.Repeat([]byte{0x01}, 16))\n97|\tt.Run(\"nonce-16-bytes-admitted\", func(t *testing.T) {\n98|\t\tm := hello(t, \"2.0.0\", false)\n99|\t\tm[\"body\"].(map[string]any)[\"nonce\"] = nonce16\n100|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); err != nil {\n101|\t\t\tt.Fatalf(\"16-byte nonce refused: %v\", err)\n102|\t\t}\n103|\t})\n104|\tt.Run(\"nonce-15-bytes-refused\", func(t *testing.T) {\n105|\t\tm := hello(t, \"2.0.0\", false)\n106|\t\tm[\"body\"].(map[string]any)[\"nonce\"] = base64.RawURLEncoding.EncodeToString(bytes.Repeat([]byte{0x01}, 15))\n107|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrHello) {\n108|\t\t\tt.Fatalf(\"15-byte nonce: err = %v, want ErrHello\", err)\n109|\t\t}\n110|\t})\n111|\tt.Run(\"nonce-standard-alphabet-refused\", func(t *testing.T) {\n112|\t\t// 18 bytes of 0xfb: standard encoding carries '+' with no padding,\n113|\t\t// so only the alphabet (not length or padding) is at issue.\n114|\t\traw := bytes.Repeat([]byte{0xfb}, 18)\n115|\t\tstd := base64.StdEncoding.EncodeToString(raw)\n116|\t\tif !strings.Contains(std, \"+\") || strings.Contains(std, \"=\") {\n117|\t\t\tt.Fatalf(\"fixture carries no isolated alphabet witness: %q\", std)\n118|\t\t}\n119|\t\tm := hello(t, \"2.0.0\", false)\n120|\t\tm[\"body\"].(map[string]any)[\"nonce\"] = std\n121|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrHello) {\n122|\t\t\tt.Fatalf(\"standard-alphabet nonce: err = %v, want ErrHello\", err)\n123|\t\t}\n124|\t})\n125|\tt.Run(\"nonce-padded-refused\", func(t *testing.T) {\n126|\t\tm := hello(t, \"2.0.0\", false)\n127|\t\tm[\"body\"].(map[string]any)[\"nonce\"] = base64.URLEncoding.EncodeToString(bytes.Repeat([]byte{0x01}, 16))\n128|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrHello) {\n129|\t\t\tt.Fatalf(\"padded nonce: err = %v, want ErrHello\", err)\n130|\t\t}\n131|\t})\n132|\tt.Run(\"line-floor-independent\", func(t *testing.T) {\n133|\t\tm := hello(t, \"2.0.0\", false)\n134|\t\tbody := m[\"body\"].(map[string]any)\n135|\t\tbody[\"max_line_bytes\"] = 8388607\n136|\t\tbody[\"max_object_bytes\"] = 7 * 1024 * 1024\n137|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrHello) {\n138|\t\t\tt.Fatalf(\"low line limit with generous object limit: err = %v, want ErrHello\", err)\n139|\t\t}\n140|\t})\n141|\tt.Run(\"object-floor-independent\", func(t *testing.T) {\n142|\t\tm := hello(t, \"2.0.0\", false)\n143|\t\tbody := m[\"body\"].(map[string]any)\n144|\t\tbody[\"max_line_bytes\"] = 10 * 1024 * 1024\n145|\t\tbody[\"max_object_bytes\"] = 5242879\n146|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrHello) {\n147|\t\t\tt.Fatalf(\"low object limit with generous line limit: err = %v, want ErrHello\", err)\n148|\t\t}\n149|\t})\n150|\tt.Run(\"both-floors-admitted\", func(t *testing.T) {\n151|\t\tm := hello(t, \"2.0.0\", false)\n152|\t\tbody := m[\"body\"].(map[string]any)\n153|\t\tbody[\"max_line_bytes\"] = 8388608\n154|\t\tbody[\"max_object_bytes\"] = 5242880\n155|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); err != nil {\n156|\t\t\tt.Fatalf(\"exact floors refused: %v\", err)\n157|\t\t}\n158|\t})\n159|\tt.Run(\"contracts-16-admitted-17-refused\", func(t *testing.T) {\n160|\t\tadmit := hello(t, \"2.0.0\", false)\n161|\t\tversions := make([]string, 0, 16)\n162|\t\tfor i := range 16 {\n163|\t\t\tversions = append(versions, fmt.Sprintf(\"1.%d.0\", i))\n164|\t\t}\n165|\t\tslices.Sort(versions)\n166|\t\tadmit[\"body\"].(map[string]any)[\"contracts\"].(map[string]any)[\"lease\"] = versions\n167|\t\tif _, err := rpcwire.DecodeRequest(wire(t, admit)); err != nil {\n168|\t\t\tt.Fatalf(\"16 versions refused: %v\", err)\n169|\t\t}\n170|\t\trefuse := hello(t, \"2.0.0\", false)\n171|\t\tseventeen := make([]string, 0, 17)\n172|\t\tfor i := range 17 {\n173|\t\t\tseventeen = append(seventeen, fmt.Sprintf(\"1.%d.0\", i))\n174|\t\t}\n175|\t\tslices.Sort(seventeen)\n176|\t\trefuse[\"body\"].(map[string]any)[\"contracts\"].(map[string]any)[\"lease\"] = seventeen\n177|\t\tif _, err := rpcwire.DecodeRequest(wire(t, refuse)); !errors.Is(err, rpcwire.ErrHello) {\n178|\t\t\tt.Fatalf(\"17 versions: err = %v, want ErrHello\", err)\n179|\t\t}\n180|\t})\n181|}\n182|\n183|// TestNamespaceVocabularyPerMember admits every namespace of each major's\n184|// pinned vocabulary singly and refuses near-miss spellings and\n185|// future-major members through DecodeRequest.\n186|func TestNamespaceVocabularyPerMember(t *testing.T) {\n187|\tvocabularies := map[string][]string{\n188|\t\t\"2.0.0\": {\"blob\", \"event\", \"manifest\", \"record\", \"tombstone\", \"tombstone_ack\"},\n189|\t\t\"3.0.0\": {\"blob\", \"directory_record\", \"event\", \"manifest\", \"record\", \"tombstone\", \"tombstone_ack\"},\n190|\t\t\"4.0.0\": {\"blob\", \"directory_record\", \"event\", \"manifest\", \"record\", \"terminal_backend_evidence\", \"tombstone\", \"tombstone_ack\"},\n191|\t\t\"5.0.0\": {\"blob\", \"directory_record\", \"event\", \"manifest\", \"record\", \"terminal_backend_evidence\", \"tombstone\", \"tombstone_ack\"},\n192|\t}\n193|\tfor _, version := range []string{\"2.0.0\", \"3.0.0\", \"4.0.0\", \"5.0.0\"} {\n194|\t\tnames, err := rpcwire.Namespaces(version)\n195|\t\tif err != nil {\n196|\t\t\tt.Fatal(err)\n197|\t\t}\n198|\t\tif !slices.Equal(names, vocabularies[version]) {\n199|\t\t\tt.Fatalf(\"Namespaces(%s) = %v, want the spec vocabulary %v\", version, names, vocabularies[version])\n200|\t\t}\n201|\t\tfor _, name := range vocabularies[version] {\n202|\t\t\tt.Run(version+\"/admit-\"+name, func(t *testing.T) {\n203|\t\t\t\tm := inventoryRequest(t, version, map[string]any{\"namespaces\": []any{name}})\n204|\t\t\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); err != nil {\n205|\t\t\t\t\tt.Fatalf(\"namespace %q refused in %s: %v\", name, version, err)\n206|\t\t\t\t}\n207|\t\t\t})\n208|\t\t}\n209|\t}\n210|\tnearMiss := []string{\"Record\", \"RECORD\", \" record\", \"record \", \"blob\\n\", \"\", \"tombstone-ack\", \"tombstoneack\"}\n211|\tfor _, version := range []string{\"2.0.0\", \"3.0.0\", \"4.0.0\", \"5.0.0\"} {\n212|\t\tfor _, name := range nearMiss {\n213|\t\t\tt.Run(version+\"/refuse-\"+fmt.Sprintf(\"%q\", name), func(t *testing.T) {\n214|\t\t\t\tm := inventoryRequest(t, version, map[string]any{\"namespaces\": []any{name}})\n215|\t\t\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrInventory) {\n216|\t\t\t\t\tt.Fatalf(\"namespace %q in %s: err = %v, want ErrInventory\", name, version, err)\n217|\t\t\t\t}\n218|\t\t\t})\n219|\t\t}\n220|\t}\n221|\tfor _, tc := range []struct{ version, name string }{\n222|\t\t{\"2.0.0\", \"directory_record\"},\n223|\t\t{\"2.0.0\", \"terminal_backend_evidence\"},\n224|\t\t{\"3.0.0\", \"terminal_backend_evidence\"},\n225|\t} {\n226|\t\tt.Run(tc.version+\"/refuse-future-\"+tc.name, func(t *testing.T) {\n227|\t\t\tm := inventoryRequest(t, tc.version, map[string]any{\"namespaces\": []any{tc.name}})\n228|\t\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrInventory) {\n229|\t\t\t\tt.Fatalf(\"err = %v, want ErrInventory\", err)\n230|\t\t\t}\n231|\t\t})\n232|\t}\n233|}\n234|\n235|// TestNamespaceMismatchMatrix proves a root reported under the wrong\n236|// namespace refuses no matter which valid namespace lands in which slot:\n237|// every off-diagonal placement of the v2 vocabulary is refused through\n238|// EncodeSuccess, and the diagonal admits.\n239|func TestNamespaceMismatchMatrix(t *testing.T) {\n240|\tnames := []string{\"blob\", \"event\", \"manifest\", \"record\", \"tombstone\", \"tombstone_ack\"}\n241|\tm := inventoryRequest(t, \"2.0.0\", map[string]any{\"namespaces\": names})\n242|\tr, err := rpcwire.DecodeRequest(wire(t, m))\n243|\tif err != nil {\n244|\t\tt.Fatal(err)\n245|\t}\n246|\troots := func(order []string) json.RawMessage {\n247|\t\titems := make([]any, 0, len(order))\n248|\t\tfor _, name := range order {\n249|\t\t\titems = append(items, map[string]any{\"namespace\": name, \"count\": 0, \"root_id\": \"sha256:\" + strings.Repeat(\"0\", 64)})\n250|\t\t}\n251|\t\traw, err := json.Marshal(map[string]any{\"roots\": items})\n252|\t\tif err != nil {\n253|\t\t\tt.Fatal(err)\n254|\t\t}\n255|\t\treturn raw\n256|\t}\n257|\tif _, err := rpcwire.EncodeSuccess(r, roots(names)); err != nil {\n258|\t\tt.Fatalf(\"diagonal roots refused: %v\", err)\n259|\t}\n260|\tfor i := range names {\n261|\t\tfor j := range names {\n262|\t\t\tif i == j {\n263|\t\t\t\tcontinue\n264|\t\t\t}\n265|\t\t\tt.Run(fmt.Sprintf(\"slot-%d-carries-%s\", i, names[j]), func(t *testing.T) {\n266|\t\t\t\tmisplaced := slices.Clone(names)\n267|\t\t\t\tmisplaced[i] = names[j]\n268|\t\t\t\tif _, err := rpcwire.EncodeSuccess(r, roots(misplaced)); !errors.Is(err, rpcwire.ErrInventory) {\n269|\t\t\t\t\tt.Fatalf(\"err = %v, want ErrInventory\", err)\n270|\t\t\t\t}\n271|\t\t\t})\n272|\t\t}\n273|\t}\n274|}\n275|\n276|// TestUnknownFieldsRefusedEverywhere drives one extra member through every\n277|// closed shape the landed code parses: the request envelope, the hello\n278|// request and success bodies, the inventory request and success bodies, and\n279|// both failure-shape directions.\n280|func TestUnknownFieldsRefusedEverywhere(t *testing.T) {\n281|\tt.Run(\"envelope\", func(t *testing.T) {\n282|\t\tm := hello(t, \"2.0.0\", false)\n283|\t\tm[\"extensions\"] = map[string]any{\"works.relux.ax.future\": map[string]any{\"a\": 1}}\n284|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrFrame) {\n285|\t\t\tt.Fatalf(\"err = %v, want ErrFrame\", err)\n286|\t\t}\n287|\t})\n288|\tt.Run(\"hello-request-body\", func(t *testing.T) {\n289|\t\tm := hello(t, \"2.0.0\", false)\n290|\t\tm[\"body\"].(map[string]any)[\"extensions\"] = map[string]any{}\n291|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrHello) {\n292|\t\t\tt.Fatalf(\"err = %v, want ErrHello\", err)\n293|\t\t}\n294|\t})\n295|\tt.Run(\"hello-response-body\", func(t *testing.T) {\n296|\t\tr := request(t, hello(t, \"2.0.0\", false))\n297|\t\tm := hello(t, \"2.0.0\", true)\n298|\t\tm[\"body\"].(map[string]any)[\"extensions\"] = map[string]any{}\n299|\t\tif _, err := rpcwire.DecodeResponse(wire(t, m), r); !errors.Is(err, rpcwire.ErrHello) {\n300|\t\t\tt.Fatalf(\"err = %v, want ErrHello\", err)\n301|\t\t}\n302|\t})\n303|\tt.Run(\"inventory-request-body\", func(t *testing.T) {\n304|\t\tm := inventoryRequest(t, \"2.0.0\", map[string]any{\"namespaces\": []any{\"blob\"}, \"extensions\": map[string]any{}})\n305|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrInventory) {\n306|\t\t\tt.Fatalf(\"err = %v, want ErrInventory\", err)\n307|\t\t}\n308|\t})\n309|\tt.Run(\"inventory-success-body\", func(t *testing.T) {\n310|\t\tm := inventoryRequest(t, \"2.0.0\", map[string]any{\"namespaces\": []any{\"blob\"}})\n311|\t\tr, err := rpcwire.DecodeRequest(wire(t, m))\n312|\t\tif err != nil {\n313|\t\t\tt.Fatal(err)\n314|\t\t}\n315|\t\tbody := map[string]any{\n316|\t\t\t\"roots\":      []any{map[string]any{\"namespace\": \"blob\", \"count\": 0, \"root_id\": \"sha256:\" + strings.Repeat(\"0\", 64)}},\n317|\t\t\t\"extensions\": map[string]any{},\n318|\t\t}\n319|\t\tif _, err := rpcwire.EncodeSuccess(r, wire(t, body)); !errors.Is(err, rpcwire.ErrInventory) {\n320|\t\t\tt.Fatalf(\"err = %v, want ErrInventory\", err)\n321|\t\t}\n322|\t})\n323|\tt.Run(\"failure-carries-body\", func(t *testing.T) {\n324|\t\tr := request(t, hello(t, \"2.0.0\", false))\n325|\t\tm := map[string]any{\n326|\t\t\t\"protocol\":         rpcwire.Protocol,\n327|\t\t\t\"protocol_version\": \"2.0.0\",\n328|\t\t\t\"request_id\":       id,\n329|\t\t\t\"ok\":               false,\n330|\t\t\t\"error\":            map[string]any{\"schema\": \"urn:ax:schema:error\", \"schema_version\": \"1.0.0\", \"code\": \"incompatible_protocol\", \"message\": \"x\", \"exit_code\": 6, \"retryable\": false, \"details\": map[string]any{}},\n331|\t\t\t\"body\":             map[string]any{},\n332|\t\t}\n333|\t\tif _, err := rpcwire.DecodeResponse(wire(t, m), r); !errors.Is(err, rpcwire.ErrFrame) {\n334|\t\t\tt.Fatalf(\"err = %v, want ErrFrame\", err)\n335|\t\t}\n336|\t})\n337|\tt.Run(\"success-carries-error\", func(t *testing.T) {\n338|\t\tr := request(t, hello(t, \"2.0.0\", false))\n339|\t\tm := hello(t, \"2.0.0\", true)\n340|\t\tm[\"error\"] = nil\n341|\t\tif _, err := rpcwire.DecodeResponse(wire(t, m), r); !errors.Is(err, rpcwire.ErrFrame) {\n342|\t\t\tt.Fatalf(\"err = %v, want ErrFrame\", err)\n343|\t\t}\n344|\t})\n345|}\n346|\n347|// TestExtensionsDirections proves both directions of the Section 17.1\n348|// extension rule at the RPC layer: the same namespaced data refused at the\n349|// envelope top level is admitted byte-identical inside an opaque operation\n350|// body, while the closed parsed bodies stay closed.\n351|func TestExtensionsDirections(t *testing.T) {\n352|\tnamespaced := map[string]any{\"works.relux.ax.future\": map[string]any{\"a\": 1}}\n353|\tt.Run(\"envelope-top-level-refused\", func(t *testing.T) {\n354|\t\tm := hello(t, \"2.0.0\", false)\n355|\t\tm[\"extensions\"] = namespaced\n356|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrFrame) {\n357|\t\t\tt.Fatalf(\"err = %v, want ErrFrame\", err)\n358|\t\t}\n359|\t})\n360|\tt.Run(\"hello-body-refused\", func(t *testing.T) {\n361|\t\tm := hello(t, \"2.0.0\", false)\n362|\t\tm[\"body\"].(map[string]any)[\"extensions\"] = namespaced\n363|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrHello) {\n364|\t\t\tt.Fatalf(\"err = %v, want ErrHello\", err)\n365|\t\t}\n366|\t})\n367|\tt.Run(\"inventory-body-refused\", func(t *testing.T) {\n368|\t\tm := inventoryRequest(t, \"2.0.0\", map[string]any{\"namespaces\": []any{\"blob\"}, \"extensions\": namespaced})\n369|\t\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrInventory) {\n370|\t\t\tt.Fatalf(\"err = %v, want ErrInventory\", err)\n371|\t\t}\n372|\t})\n373|\tt.Run(\"opaque-body-admitted-identical\", func(t *testing.T) {\n374|\t\tbody := wire(t, map[string]any{\"extensions\": namespaced})\n375|\t\tline, err := rpcwire.EncodeRequest(\"2.0.0\", id, \"health.get\", body)\n376|\t\tif err != nil {\n377|\t\t\tt.Fatal(err)\n378|\t\t}\n379|\t\tr, err := rpcwire.DecodeRequest(line)\n380|\t\tif err != nil {\n381|\t\t\tt.Fatal(err)\n382|\t\t}\n383|\t\tif !bytes.Equal(r.Body(), body) {\n384|\t\t\tt.Fatal(\"opaque extension body altered\")\n385|\t\t}\n386|\t})\n387|}\n388|\n389|// TestResponseCorrelationClasses pins the refusal class of every\n390|// correlation failure through DecodeResponse: a mismatched echo (ID or\n391|// hello nonce echo) is ErrCorrelation, a version skew is ErrVersion, and a\n392|// zero expectation can correlate nothing.\n393|func TestResponseCorrelationClasses(t *testing.T) {\n394|\tr := request(t, hello(t, \"2.0.0\", false))\n395|\tt.Run(\"mismatched-id\", func(t *testing.T) {\n396|\t\tm := hello(t, \"2.0.0\", true)\n397|\t\tm[\"request_id\"] = otherID\n398|\t\tif _, err := rpcwire.DecodeResponse(wire(t, m), r); !errors.Is(err, rpcwire.ErrCorrelation) {\n399|\t\t\tt.Fatalf(\"err = %v, want ErrCorrelation\", err)\n400|\t\t}\n401|\t})\n402|\tt.Run(\"mismatched-version\", func(t *testing.T) {\n403|\t\tm := hello(t, \"3.0.0\", true)\n404|\t\tif _, err := rpcwire.DecodeResponse(wire(t, m), r); !errors.Is(err, rpcwire.ErrVersion) {\n405|\t\t\tt.Fatalf(\"err = %v, want ErrVersion\", err)\n406|\t\t}\n407|\t})\n408|\tt.Run(\"mismatched-nonce-echo\", func(t *testing.T) {\n409|\t\tm := hello(t, \"2.0.0\", true)\n410|\t\tm[\"body\"].(map[string]any)[\"nonce_echo\"] = \"cXJzdHV2d3h5ejAxMjM0NQ\"\n411|\t\tif _, err := rpcwire.DecodeResponse(wire(t, m), r); !errors.Is(err, rpcwire.ErrCorrelation) {\n412|\t\t\tt.Fatalf(\"err = %v, want ErrCorrelation\", err)\n413|\t\t}\n414|\t})\n415|\tt.Run(\"zero-expectation\", func(t *testing.T) {\n416|\t\tm := hello(t, \"2.0.0\", true)\n417|\t\tif _, err := rpcwire.DecodeResponse(wire(t, m), rpcwire.Request{}); !errors.Is(err, rpcwire.ErrCorrelation) {\n418|\t\t\tt.Fatalf(\"err = %v, want ErrCorrelation\", err)\n419|\t\t}\n420|\t})\n421|}\n422|\n423|// TestMajor1RejectedNotReinterpreted proves a 2.0.0 peer rejects major 1\n424|// with the version class at every rpcwire entry instead of coercing it.\n425|func TestMajor1RejectedNotReinterpreted(t *testing.T) {\n426|\tm := hello(t, \"2.0.0\", false)\n427|\tm[\"protocol_version\"] = \"1.0.0\"\n428|\tif _, err := rpcwire.DecodeRequest(wire(t, m)); !errors.Is(err, rpcwire.ErrVersion) {\n429|\t\tt.Fatalf(\"DecodeRequest(1.0.0): err = %v, want ErrVersion\", err)\n430|\t}\n431|\tif _, err := rpcwire.EncodeRequest(\"1.0.0\", id, \"health.get\", []byte(`{}`)); !errors.Is(err, rpcwire.ErrVersion) {\n432|\t\tt.Fatalf(\"EncodeRequest(1.0.0): err = %v, want ErrVersion\", err)\n433|\t}\n434|\tif _, err := rpcwire.ContractProfile(\"1.0.0\"); !errors.Is(err, rpcwire.ErrVersion) {\n435|\t\tt.Fatalf(\"ContractProfile(1.0.0): err = %v, want ErrVersion\", err)\n436|\t}\n437|\tif _, err := rpcwire.Namespaces(\"1.0.0\"); !errors.Is(err, rpcwire.ErrVersion) {\n438|\t\tt.Fatalf(\"Namespaces(1.0.0): err = %v, want ErrVersion\", err)\n439|\t}\n440|\tr := request(t, hello(t, \"2.0.0\", false))\n441|\tresp := hello(t, \"2.0.0\", true)\n442|\tresp[\"protocol_version\"] = \"1.0.0\"\n443|\tif _, err := rpcwire.DecodeResponse(wire(t, resp), r); !errors.Is(err, rpcwire.ErrVersion) {\n444|\t\tt.Fatalf(\"DecodeResponse(1.0.0): err = %v, want ErrVersion\", err)\n445|\t}\n446|}\n447|\n448|// TestErrorSchemaNotNegotiated drives a peer that tries to negotiate the\n449|// Structured Error schema: a failure document carrying a foreign\n450|// schema_version is refused through DecodeResponse even though the document\n451|// itself is well-formed, because the version is fixed by the containing\n452|// protocol (RPC 2 binds Error 1.0.0, RPC 4/5 bind Error 1.3.0).\n453|func TestErrorSchemaNotNegotiated(t *testing.T) {\n454|\tbuild := func(t *testing.T, version axerror.Version) map[string]any {\n455|\t\tt.Helper()\n456|\t\tfailure, err := axerror.New(axerror.Spec{Version: version, Code: \"incompatible_protocol\", Message: \"peer framed\", Details: axerror.Details{}})\n457|\t\tif err != nil {\n458|\t\t\tt.Fatal(err)\n459|\t\t}\n460|\t\traw, err := failure.MarshalJSON()\n461|\t\tif err != nil {\n462|\t\t\tt.Fatal(err)\n463|\t\t}\n464|\t\tvar doc map[string]any\n465|\t\tif err := json.Unmarshal(raw, &doc); err != nil {\n466|\t\t\tt.Fatal(err)\n467|\t\t}\n468|\t\treturn doc\n469|\t}\n470|\tframe := func(t *testing.T, rpcVersion, requestID string, doc map[string]any) []byte {\n471|\t\tt.Helper()\n472|\t\treturn wire(t, map[string]any{\n473|\t\t\t\"protocol\":         rpcwire.Protocol,\n474|\t\t\t\"protocol_version\": rpcVersion,\n475|\t\t\t\"request_id\":       requestID,\n476|\t\t\t\"ok\":               false,\n477|\t\t\t\"error\":            doc,\n478|\t\t})\n479|\t}\n480|\tt.Run(\"rpc2-refuses-error-1.3.0\", func(t *testing.T) {\n481|\t\tr := request(t, hello(t, \"2.0.0\", false))\n482|\t\tif _, err := rpcwire.DecodeResponse(frame(t, \"2.0.0\", id, build(t, axerror.Version130)), r); err == nil {\n483|\t\t\tt.Fatal(\"RPC 2 admitted an Error 1.3.0 document\")\n484|\t\t}\n485|\t})\n486|\tt.Run(\"rpc5-refuses-error-1.0.0\", func(t *testing.T) {\n487|\t\tr := request(t, hello(t, \"5.0.0\", false))\n488|\t\tif _, err := rpcwire.DecodeResponse(frame(t, \"5.0.0\", id, build(t, axerror.Version100)), r); err == nil {\n489|\t\t\tt.Fatal(\"RPC 5 admitted an Error 1.0.0 document\")\n490|\t\t}\n491|\t})\n492|\tt.Run(\"rpc4-refuses-error-1.0.0\", func(t *testing.T) {\n493|\t\tr := request(t, hello(t, \"4.0.0\", false))\n494|\t\tif _, err := rpcwire.DecodeResponse(frame(t, \"4.0.0\", id, build(t, axerror.Version100)), r); err == nil {\n495|\t\t\tt.Fatal(\"RPC 4 admitted an Error 1.0.0 document\")\n496|\t\t}\n497|\t})\n498|\tt.Run(\"bound-versions-admit\", func(t *testing.T) {\n499|\t\tfor _, tc := range []struct {\n500|\t\t\trpc   string\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
