{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cd0d","stream":{"kind":"session","id":"01a0b17d-598e-7f80-b6bd-728e9f57759a"},"sequence":1249,"recorded_at":1780531400002493,"record_type":"event","durability":"durable","causation_id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba","run_stream":{"kind":"run","id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba"},"task_stream":{"kind":"task","id":"01a0b183-3d51-74c1-8e71-d014e959b87b"},"task_id":"01a0b183-3d51-74c1-8e71-d014e959b87b","event":{"kind":"output","task_id":"01a0b183-3d51-74c1-8e71-d014e959b87b","chunk":"{\n  \"chunk_id\": \"exec-47-1\",\n  \"command\": \"python3 - <<'EOF'\\nimport json\\nrev1 = json.load(open('/tmp/rev1/internal/traceability/ownership.v0.6.0.json'))\\nreg = json.load(open('internal/traceability/ownership.v0.7.0.json'))\\n\\n# 1. Append 5 acceptance cases (drop rpcwire-inventory-arrays per P2-1)\\nwant = ['rpcwire-closed-bodies','rpcwire-framing','meshneg-selection','rpcwire-version-boundary','story-4qojoz-mesh-negotiation']\\nrev1cases = {c['id']: c for c in rev1['acceptance_cases']}\\nhave = {c['id'] for c in reg['acceptance_cases']}\\nassert not (set(want) & have), \\\"collision\\\"\\nfor cid in want:\\n    reg['acceptance_cases'].append(rev1cases[cid])\\nprint('cases now:', len(reg['acceptance_cases']))\\n\\n# 2. Upgrade 3 bindings with re-measured v0.7.0 lines; leave 11.3 untouched\\ndef rev1binding(key):\\n    for o in rev1['ownership']:\\n        if o.get('kind')=='section_binding' and key in o['keys']:\\n            return json.loads(json.dumps(o))\\n    raise KeyError(key)\\n\\nlines = {\\n    'section:11.2': {'11.2#2':7364,'11.2#3':7408,'11.2#4':7420},\\n    'section:17.1': {'17.1#1':15567,'17.1#4':15589,'17.1#5':15602},\\n    'section:17.4': {'17.4#4':15661},\\n}\\nfor i, o in enumerate(reg['ownership']):\\n    if o.get('kind')=='section_binding' and o['keys'][0] in lines:\\n        key = o['keys'][0]\\n        nb = rev1binding(key)\\n        for cl in nb['clauses']:\\n            assert cl['id'] in lines[key], cl['id']\\n            cl['line'] = lines[key][cl['id']]\\n        reg['ownership'][i] = nb\\n        print('upgraded', key, 'clauses:', [(c['id'],c['line']) for c in nb['clauses']])\\n\\n# 3. Verify 11.3 untouched\\nfor o in reg['ownership']:\\n    if o.get('kind')=='section_binding' and o['keys'][0]=='section:11.3':\\n        assert o['coverage']=='unevidenced' and 'clauses' not in o\\n        print('11.3 stays unevidenced: OK')\\n\\njson.dump(reg, open('internal/traceability/ownership.v0.7.0.json','w'), indent=2)\\nopen('internal/traceability/ownership.v0.7.0.json','a').write('\\\\n')\\nprint('wrote registry')\\nEOF\\ngit diff --stat -- internal/traceability/ownership.v0.7.0.json\",\n  \"description\": \"Port bindings into v0.7.0 registry\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"cases now: 140\\nupgraded section:17.1 clauses: [('17.1#1', 15567), ('17.1#4', 15589), ('17.1#5', 15602)]\\nupgraded section:17.4 clauses: [('17.4#4', 15661)]\\nupgraded section:11.2 clauses: [('11.2#2', 7364), ('11.2#3', 7408), ('11.2#4', 7420)]\\n11.3 stays unevidenced: OK\\nwrote registry\\n internal/traceability/ownership.v0.7.0.json | 225 ++++++++++++++++++++++++++--\\n 1 file changed, 213 insertions(+), 12 deletions(-)\\n\",\n  \"original_output_bytes\": 415,\n  \"original_output_tokens\": 104,\n  \"truncated\": false\n}","final_result":true}}}
