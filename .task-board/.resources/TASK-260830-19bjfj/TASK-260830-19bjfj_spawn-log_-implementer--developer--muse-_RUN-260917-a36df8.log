{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d5c1","stream":{"kind":"session","id":"01a0b17d-598e-7f80-b6bd-728e9f57759a"},"sequence":2363,"recorded_at":1780531400004721,"record_type":"event","durability":"durable","causation_id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba","run_stream":{"kind":"run","id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba"},"task_stream":{"kind":"task","id":"01a0b188-6d59-7600-9fc4-6d9dffef666b"},"task_id":"01a0b188-6d59-7600-9fc4-6d9dffef666b","event":{"kind":"output","task_id":"01a0b188-6d59-7600-9fc4-6d9dffef666b","chunk":"Read text file `internal/rpcwire/adversarial_test.go`.\n(499 line(s) above)\n500|\t\t\trpc   string\n501|\t\t\terror axerror.Version\n502|\t\t}{{\"2.0.0\", axerror.Version100}, {\"4.0.0\", axerror.Version130}, {\"5.0.0\", axerror.Version130}} {\n503|\t\t\tr := request(t, hello(t, tc.rpc, false))\n504|\t\t\tresp, err := rpcwire.DecodeResponse(frame(t, tc.rpc, id, build(t, tc.error)), r)\n505|\t\t\tif err != nil || resp.OK() {\n506|\t\t\t\tt.Fatalf(\"RPC %s with its bound error: resp=%v err=%v\", tc.rpc, resp.OK(), err)\n507|\t\t\t}\n508|\t\t}\n509|\t})\n510|}\n511|\n512|// TestFramingBounds witnesses the Section 11.2 line discipline through the\n513|// production entries: exactly 8388608 bytes accepted and 8388609 refused on\n514|// both the decode and encode paths, an embedded newline refused, and valid\n515|// JSON that is not an object refused.\n516|func TestFramingBounds(t *testing.T) {\n517|\tgood := wire(t, hello(t, \"2.0.0\", false))\n518|\tt.Run(\"decode-accepts-8388608\", func(t *testing.T) {\n519|\t\texact := append(bytes.Clone(good), bytes.Repeat([]byte(\" \"), rpcwire.MaxLineBytes-len(good))...)\n520|\t\tif len(exact) != 8388608 {\n521|\t\t\tt.Fatalf(\"line = %d bytes, want 8388608\", len(exact))\n522|\t\t}\n523|\t\tif _, err := rpcwire.DecodeRequest(exact); err != nil {\n524|\t\t\tt.Fatalf(\"8388608 refused: %v\", err)\n525|\t\t}\n526|\t})\n527|\tt.Run(\"decode-refuses-8388609\", func(t *testing.T) {\n528|\t\tover := append(bytes.Clone(good), bytes.Repeat([]byte(\" \"), rpcwire.MaxLineBytes+1-len(good))...)\n529|\t\tif len(over) != 8388609 {\n530|\t\t\tt.Fatalf(\"line = %d bytes, want 8388609\", len(over))\n531|\t\t}\n532|\t\tif _, err := rpcwire.DecodeRequest(over); !errors.Is(err, rpcwire.ErrFrame) {\n533|\t\t\tt.Fatalf(\"err = %v, want ErrFrame\", err)\n534|\t\t}\n535|\t})\n536|\tt.Run(\"encode-refuses-8388609\", func(t *testing.T) {\n537|\t\tbody := wire(t, map[string]any{\"pad\": strings.Repeat(\"x\", rpcwire.MaxLineBytes)})\n538|\t\tif _, err := rpcwire.EncodeRequest(\"2.0.0\", id, \"health.get\", body); !errors.Is(err, rpcwire.ErrFrame) {\n539|\t\t\tt.Fatalf(\"err = %v, want ErrFrame\", err)\n540|\t\t}\n541|\t})\n542|\tt.Run(\"embedded-newline-refused\", func(t *testing.T) {\n543|\t\tsplit := append(bytes.Clone(good[:len(good)/2]), append([]byte(\"\\n\"), good[len(good)/2:]...)...)\n544|\t\tif _, err := rpcwire.DecodeRequest(split); !errors.Is(err, rpcwire.ErrFrame) {\n545|\t\t\tt.Fatalf(\"err = %v, want ErrFrame\", err)\n546|\t\t}\n547|\t})\n548|\tfor _, line := range []string{`null`, `[]`, `\"health.get\"`, `42`, `true`} {\n549|\t\tt.Run(\"non-object-\"+line, func(t *testing.T) {\n550|\t\t\tif _, err := rpcwire.DecodeRequest([]byte(line)); !errors.Is(err, rpcwire.ErrFrame) {\n551|\t\t\t\tt.Fatalf(\"err = %v, want ErrFrame\", err)\n552|\t\t\t}\n553|\t\t})\n554|\t}\n555|}","final_result":true}}}
