 := generationForFrame(frame)\n36|\t\twantLocal, err := meshneg.LocalMajors(config)\n37|\t\tif err != nil {\n38|\t\t\tt.Fatal(err)\n39|\t\t}\n40|\t\tkeys := make([]string, 0, len(profile))\n41|\t\tfor key := range profile {\n42|\t\t\tkeys = append(keys, key)\n43|\t\t}\n44|\t\tslices.Sort(keys)\n45|\t\tfor _, key := range keys {\n46|\t\t\tt.Run(\"missing-\"+frame+\"-\"+key, func(t *testing.T) {\n47|\t\t\t\tcontracts := profileContracts(t, frame)\n48|\t\t\t\tdelete(contracts, key)\n49|\t\t\t\t_, err := meshneg.Negotiate(config, frame, directHello(t, contracts))\n50|\t\t\t\trefusal := asRefusal(t, err)\n51|\t\t\t\tassertShapeRefusal(t, config, frame, refusal, err, wantLocal)\n52|\t\t\t})\n53|\t\t\tt.Run(\"substituted-\"+frame+\"-\"+key, func(t *testing.T) {\n54|\t\t\t\tcontracts := profileContracts(t, frame)\n55|\t\t\t\tdelete(contracts, key)\n56|\t\t\t\tcontracts[\"bogus\"] = []string{\"1.0.0\"}\n57|\t\t\t\t_, err := meshneg.Negotiate(config, frame, directHello(t, contracts))\n58|\t\t\t\trefusal := asRefusal(t, err)\n59|\t\t\t\tassertShapeRefusal(t, config, frame, refusal, err, wantLocal)\n60|\t\t\t})\n61|\t\t}\n62|\t}\n63|}\n64|\n65|func assertShapeRefusal(t *testing.T, config, frame string, refusal *meshneg.Refusal, err error, wantLocal []int) {\n66|\tt.Helper()\n67|\tif refusal.Code != \"incompatible_protocol\" || refusal.ExitCode != 6 {\n68|\t\tt.Fatalf(\"Negotiate(%s, %s) class = %s/%d, want incompatible_protocol/6\",\n69|\t\t\tconfig, frame, refusal.Code, refusal.ExitCode)\n70|\t}\n71|\tif refusal.Reason != meshneg.ReasonContractShape {\n72|\t\tt.Fatalf(\"Negotiate(%s, %s) reason = %q\", config, frame, refusal.Reason)\n73|\t}\n74|\tif !errors.Is(err, meshneg.ErrContractShape) {\n75|\t\tt.Fatalf(\"Negotiate(%s, %s) error does not wrap ErrContractShape\", config, frame)\n76|\t}\n77|\tif !slices.Equal(refusal.Local, wantLocal) {\n78|\t\tt.Fatalf(\"Negotiate(%s, %s) refusal local = %v, want %v\", config, frame, refusal.Local, wantLocal)\n79|\t}\n80|\tif refusal.Peer != 0 {\n81|\t\tt.Fatalf(\"Negotiate(%s, %s) refusal peer = %d, want 0\", config, frame, refusal.Peer)\n82|\t}\n83|}\n84|\n85|// TestNegotiateOfferRefusalCarriesLocal closes the mixed half of inherited\n86|// advisory N2: a mixed-major peer offer refused through Negotiate reports\n87|// the local generation's exact offer set on the refusal.\n88|func TestNegotiateOfferRefusalCarriesLocal(t *testing.T) {\n89|\twantLocal, err := meshneg.LocalMajors(\"3.0.0\")\n90|\tif err != nil {\n91|\t\tt.Fatal(err)\n92|\t}\n93|\tcases := []struct {\n94|\t\tname  string\n95|\t\tframe string\n96|\t\trpc   []string\n97|\t}{\n98|\t\t{\"higher-major-in-v2\", \"2.0.0\", []string{\"3.0.0\"}},\n99|\t\t{\"two-majors-in-v2\", \"2.0.0\", []string{\"2.0.0\", \"3.0.0\"}},\n100|\t\t{\"unsorted-v2\", \"2.0.0\", []string{\"2.1.0\", \"2.0.0\"}},\n101|\t\t{\"not-semver-v2\", \"2.0.0\", []string{\"v2.0.0\"}},\n102|\t\t{\"lower-major-in-v3\", \"3.0.0\", []string{\"2.0.0\"}},\n103|\t}\n104|\tfor _, tc := range cases {\n105|\t\tt.Run(tc.name, func(t *testing.T) {\n106|\t\t\tcontracts := profileContracts(t, tc.frame)\n107|\t\t\tcontracts[\"rpc\"] = tc.rpc\n108|\t\t\t_, err := meshneg.Negotiate(\"3.0.0\", tc.frame, directHello(t, contracts))\n109|\t\t\trefusal := asRefusal(t, err)\n110|\t\t\tif refusal.Code != \"incompatible_protocol\" || refusal.ExitCode != 6 {\n111|\t\t\t\tt.Fatalf(\"class = %s/%d, want incompatible_protocol/6\", refusal.Code, refusal.ExitCode)\n112|\t\t\t}\n113|\t\t\tif refusal.Reason != meshneg.ReasonMixedMajor {\n114|\t\t\t\tt.Fatalf(\"reason = %q, want mixed_major\", refusal.Reason)\n115|\t\t\t}\n116|\t\t\tif !errors.Is(err, meshneg.ErrMixedMajor) {\n117|\t\t\t\tt.Fatalf(\"error does not wrap ErrMixedMajor: %v\", err)\n118|\t\t\t}\n119|\t\t\tif !slices.Equal(refusal.Local, wantLocal) {\n120|\t\t\t\tt.Fatalf(\"refusal local = %v, want %v\", refusal.Local, wantLocal)\n121|\t\t\t}\n122|\t\t\tif refusal.Peer != 0 {\n123|\t\t\t\tt.Fatalf(\"refusal peer = %d, want 0\", refusal.Peer)\n124|\t\t\t}\n125|\t\t})\n126|\t}\n127|}\n128|\n129|// TestNoMajorSelectedByCoercion drives the six Section 17.1 no-coercion\n130|// shapes through the composed Negotiate entry: a peer offering only a\n131|// higher major, only a lower major, an empty rpc set, a duplicate rpc\n132|// entry, an unsorted rpc array, and an out-of-range rpc count each produce\n133|// the pinned refusal instead of a coerced selection.\n134|func TestNoMajorSelectedByCoercion(t *testing.T) {\n135|\tt.Run(\"only-higher-major\", func(t *testing.T) {\n136|\t\thello := decodedHello(t, \"5.0.0\", profileContracts(t, \"5.0.0\"))\n137|\t\t_, err := meshneg.Negotiate(\"1.0.0\", \"5.0.0\", hello)\n138|\t\trefusal := asRefusal(t, err)\n139|\t\tif refusal.Code != \"incompatible_protocol\" || refusal.ExitCode != 6 {\n140|\t\t\tt.Fatalf(\"class = %s/%d, want incompatible_protocol/6\", refusal.Code, refusal.ExitCode)\n141|\t\t}\n142|\t\tif refusal.Reason != meshneg.ReasonNoCommonMajor || !errors.Is(err, meshneg.ErrNoCommonMajor) {\n143|\t\t\tt.Fatalf(\"reason = %q, want no_common_major\", refusal.Reason)\n144|\t\t}\n145|\t\tif refusal.Peer != 5 {\n146|\t\t\tt.Fatalf(\"refusal peer = %d, want 5\", refusal.Peer)\n147|\t\t}\n148|\t})\n149|\tt.Run(\"only-lower-major\", func(t *testing.T) {\n150|\t\thello := decodedHello(t, \"2.0.0\", profileContracts(t, \"2.0.0\"))\n151|\t\t_, err := meshneg.Negotiate(\"4.0.0\", \"2.0.0\", hello)\n152|\t\trefusal := asRefusal(t, err)\n153|\t\tif refusal.Code != \"incompatible_protocol\" || refusal.ExitCode != 6 {\n154|\t\t\tt.Fatalf(\"class = %s/%d, want incompatible_protocol/6\", refusal.Code, refusal.ExitCode)\n155|\t\t}\n156|\t\tif refusal.Reason != meshneg.ReasonNoCommonMajor || !errors.Is(err, meshneg.ErrNoCommonMajor) {\n157|\t\t\tt.Fatalf(\"reason = %q, want no_common_major\", refusal.Reason)\n158|\t\t}\n159|\t})\n160|\trpcShapes := []struct {\n161|\t\tname   string\n162|\t\trpc    []string\n163|\t\treason meshneg.RefusalReason\n164|\t\tcause  error\n165|\t}{\n166|\t\t{\"empty-set\", nil, meshneg.ReasonContractShape, meshneg.ErrContractShape},\n167|\t\t{\"duplicate\", []string{\"2.0.0\", \"2.0.0\"}, meshneg.ReasonMixedMajor, meshneg.ErrMixedMajor},\n168|\t\t{\"unsorted\", []string{\"2.1.0\", \"2.0.0\"}, meshneg.ReasonMixedMajor, meshneg.ErrMixedMajor},\n169|\t\t{\"out-of-range-count\", []string{\n170|\t\t\t\"2.0.0\", \"2.0.1\", \"2.0.2\", \"2.0.3\", \"2.0.4\", \"2.0.5\", \"2.0.6\",\n171|\t\t\t\"2.0.7\", \"2.0.8\", \"2.0.9\", \"2.0.10\", \"2.0.11\", \"2.0.12\",\n172|\t\t\t\"2.0.13\", \"2.0.14\", \"2.0.15\", \"2.0.16\",\n173|\t\t}, meshneg.ReasonContractShape, meshneg.ErrContractShape},\n174|\t}\n175|\tfor _, tc := range rpcShapes {\n176|\t\tt.Run(tc.name, func(t *testing.T) {\n177|\t\t\tcontracts := profileContracts(t, \"2.0.0\")\n178|\t\t\tcontracts[\"rpc\"] = tc.rpc\n179|\t\t\t_, err := meshneg.Negotiate(\"3.0.0\", \"2.0.0\", directHello(t, contracts))\n180|\t\t\trefusal := asRefusal(t, err)\n181|\t\t\tif refusal.Code != \"incompatible_protocol\" || refusal.ExitCode != 6 {\n182|\t\t\t\tt.Fatalf(\"class = %s/%d, want incompatible_protocol/6\", refusal.Code, refusal.ExitCode)\n183|\t\t\t}\n184|\t\t\tif refusal.Reason != tc.reason || !errors.Is(err, tc.cause) {\n185|\t\t\t\tt.Fatalf(\"reason = %q, want %q\", refusal.Reason, tc.reason)\n186|\t\t\t}\n187|\t\t})\n188|\t}\n189|}\n190|\n191|// TestMajor1RejectedThroughNegotiation proves a 2.0.0 peer rejects major 1\n192|// at negotiation rather than reinterpreting it: a major-1 frame is an\n193|// unsupported frame, and a major-1 rpc version inside a v2 frame is a\n194|// mixed-major coercion attempt.\n195|func TestMajor1RejectedThroughNegotiation(t *testing.T) {\n196|\tt.Run(\"frame-1.0.0\", func(t *testing.T) {\n197|\t\t_, err := meshneg.Negotiate(\"3.0.0\", \"1.0.0\", directHello(t, profileContracts(t, \"2.0.0\")))\n198|\t\trefusal := asRefusal(t, err)\n199|\t\tif refusal.Code != \"incompatible_protocol\" || refusal.ExitCode != 6 {\n200|\t\t\tt.Fatalf(\"class = %s/%d, want incompatible_protocol/6\", refusal.Code, refusal.ExitCode)\n201|\t\t}\n202|\t\tif refusal.Reason != meshneg.ReasonUnsupportedFrame || !errors.Is(err, meshneg.ErrUnsupportedFrame) {\n203|\t\t\tt.Fatalf(\"reason = %q, want unsupported_frame\", refusal.Reason)\n204|\t\t}\n205|\t})\n206|\tt.Run(\"rpc-1.0.0-in-v2-frame\", func(t *testing.T) {\n207|\t\tcontracts := profileContracts(t, \"2.0.0\")\n208|\t\tcontracts[\"rpc\"] = []string{\"1.0.0\"}\n209|\t\t_, err := meshneg.Negotiate(\"3.0.0\", \"2.0.0\", directHello(t, contracts))\n210|\t\trefusal := asRefusal(t, err)\n211|\t\tif refusal.Code != \"incompatible_protocol\" || refusal.ExitCode != 6 {\n212|\t\t\tt.Fatalf(\"class = %s/%d, want incompatible_protocol/6\", refusal.Code, refusal.ExitCode)\n213|\t\t}\n214|\t\tif refusal.Reason != meshneg.ReasonMixedMajor || !errors.Is(err, meshneg.ErrMixedMajor) {\n215|\t\t\tt.Fatalf(\"reason = %q, want mixed_major\", refusal.Reason)\n216|\t\t}\n217|\t})\n218|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
