{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d569","stream":{"kind":"session","id":"01a0b17d-598e-7f80-b6bd-728e9f57759a"},"sequence":2319,"recorded_at":1780531400004633,"record_type":"event","durability":"durable","causation_id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba","run_stream":{"kind":"run","id":"ee667c6e-43c2-4b33-805c-7f4df74b7dba"},"call_id":"call_01a0b1885a3e701bbf97f443f630b99a","text":"Read text file `internal/rpcwire/fuzz_adversarial_test.go`.\n1|package rpcwire_test\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"os\"\n7|\t\"slices\"\n8|\t\"testing\"\n9|\t\"unicode/utf8\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/rpcwire\"\n12|)\n13|\n14|// fuzzEnvelopeID is the fixed valid UUIDv7 correlator every fuzz-built\n15|// envelope carries, so the fuzzer explores operation/body shapes rather\n16|// than ID syntax (covered by FuzzUntrustedEnvelopes and the unit suite).\n17|const fuzzEnvelopeID = \"0198f4c8-a070-7188-9172-1234567890ab\"\n18|\n19|func fuzzLine(operation string, body []byte) []byte {\n20|\tenvelope := map[string]any{\n21|\t\t\"protocol\":         rpcwire.Protocol,\n22|\t\t\"protocol_version\": \"2.0.0\",\n23|\t\t\"request_id\":       fuzzEnvelopeID,\n24|\t\t\"operation\":        operation,\n25|\t\t\"body\":             json.RawMessage(validObjectOrEmpty(body)),\n26|\t}\n27|\tline, err := json.Marshal(envelope)\n28|\tif err != nil {\n29|\t\treturn nil\n30|\t}\n31|\treturn line\n32|}\n33|\n34|func validObjectOrEmpty(body []byte) []byte {\n35|\ttrimmed := bytes.TrimSpace(body)\n36|\tif len(trimmed) == 0 || trimmed[0] != '{' {\n37|\t\treturn []byte(`{}`)\n38|\t}\n39|\tvar probe map[string]json.RawMessage\n40|\tif json.Unmarshal(trimmed, &probe) != nil {\n41|\t\treturn []byte(`{}`)\n42|\t}\n43|\treturn trimmed\n44|}\n45|\n46|// validHelloBody returns the normative v2 hello request body so the admit\n47|// path is seeded, not only the refusal paths.\n48|func validHelloBody() ([]byte, error) {\n49|\traw, err := os.ReadFile(\"testdata/hello-request-v2.json\")\n50|\tif err != nil {\n51|\t\treturn nil, err\n52|\t}\n53|\tvar envelope struct {\n54|\t\tBody json.RawMessage `json:\"body\"`\n55|\t}\n56|\tif err := json.Unmarshal(raw, &envelope); err != nil {\n57|\t\treturn nil, err\n58|\t}\n59|\treturn []byte(envelope.Body), nil\n60|}\n61|\n62|func exactKeys(raw json.RawMessage, keys ...string) bool {\n63|\tvar m map[string]json.RawMessage\n64|\tif json.Unmarshal(raw, &m) != nil || len(m) != len(keys) {\n65|\t\treturn false\n66|\t}\n67|\tfor _, key := range keys {\n68|\t\tif _, ok := m[key]; !ok {\n69|\t\t\treturn false\n70|\t\t}\n71|\t}\n72|\treturn true\n73|}\n74|\n75|// FuzzClosedOperationBodies reaches the body parsers rather than only the\n76|// envelope: for every operation of the Section 11.3 vocabulary (plus\n77|// adversarial names), an admitted request must round-trip through the\n78|// production encode entry and must not reinterpret the operation, while a\n79|// parsed hello/inventory body must decode through its typed accessor.\n80|//\n81|// Control: the closed-extra narrowing (mutations.py) admits one extra=true\n82|// envelope member; with that plant applied the exact-keys property below\n83|// fails on the seeded bad input. See the producer evidence log.\n84|func FuzzClosedOperationBodies(f *testing.F) {\n85|\toperations := []string{\"hello\", \"health.get\", \"inventory.roots\", \"inventory.children\", \"objects.get\",\n86|\t\t\"transfer.begin\", \"transfer.status\", \"chunks.put\", \"transfer.validate\", \"transfer.commit\",\n87|\t\t\"materialize.prepare\", \"materialize.commit\", \"materialize.status\", \"materialize.finalize\",\n88|\t\t\"materialize.rollback\", \"lease.refresh\", \"tombstone.ack\", \"session.status\", \"session.stop\",\n89|\t\t\"handoff.prepare\", \"handoff.quiesce\", \"handoff.stop\", \"handoff.commit\", \"handoff.abort\",\n90|\t\t\"\", \"HELLO\", \"hello \", \"future.operation\"}\n91|\tfor _, operation := range operations {\n92|\t\tf.Add(operation, []byte(`{}`))\n93|\t}\n94|\tf.Add(\"hello\", []byte(`{\"host_id\":\"x\"}`))\n95|\tf.Add(\"inventory.roots\", []byte(`{\"namespaces\":[\"blob\"],\"extra\":true}`))\n96|\tf.Add(\"inventory.roots\", []byte(`{\"namespaces\":[\"blob\"]}`))\n97|\tif raw, err := validHelloBody(); err == nil {\n98|\t\tf.Add(\"hello\", raw)\n99|\t\t// A hello body the target must reject: the control plant that\n100|\t\t// admits one \"extensions\" member has to fail on this seed.\n101|\t\tvar members map[string]json.RawMessage\n102|\t\tif json.Unmarshal(raw, &members) == nil {\n103|\t\t\tmembers[\"extensions\"] = json.RawMessage(`{}`)\n104|\t\t\tif tampered, err := json.Marshal(members); err == nil {\n105|\t\t\t\tf.Add(\"hello\", tampered)\n106|\t\t\t}\n107|\t\t}\n108|\t}\n109|\tf.Fuzz(func(t *testing.T, operation string, body []byte) {\n110|\t\t// The envelope cannot represent a non-UTF-8 operation: JSON\n111|\t\t// encoding replaces the offending bytes, so identity between\n112|\t\t// the fuzz input and the decoded value is unstatable there.\n113|\t\tif !utf8.ValidString(operation) {\n114|\t\t\treturn\n115|\t\t}\n116|\t\tline := fuzzLine(operation, body)\n117|\t\tif line == nil {\n118|\t\t\treturn\n119|\t\t}\n120|\t\tr, err := rpcwire.DecodeRequest(line)\n121|\t\tif err != nil {\n122|\t\t\treturn\n123|\t\t}\n124|\t\tif r.Operation() != operation || r.ID() != fuzzEnvelopeID || r.Version() != \"2.0.0\" {\n125|\t\t\tt.Fatalf(\"decoded request reinterprets the envelope: op=%q id=%q version=%q\", r.Operation(), r.ID(), r.Version())\n126|\t\t}\n127|\t\tif r.Body() == nil {\n128|\t\t\tt.Fatal(\"admitted request carries no body\")\n129|\t\t}\n130|\t\tround, err := rpcwire.EncodeRequest(r.Version(), r.ID(), r.Operation(), r.Body())\n131|\t\tif err != nil {\n132|\t\t\tt.Fatalf(\"admitted request does not round-trip: %v\", err)\n133|\t\t}\n134|\t\tif _, err = rpcwire.DecodeRequest(round); err != nil {\n135|\t\t\tt.Fatalf(\"round-tripped request refused: %v\", err)\n136|\t\t}\n137|\t\tswitch operation {\n138|\t\tcase \"hello\":\n139|\t\t\tif _, err = r.Hello(); err != nil {\n140|\t\t\t\tt.Fatalf(\"admitted hello body has no typed decode: %v\", err)\n141|\t\t\t}\n142|\t\t\tif !exactKeys(r.Body(), \"host_id\", \"platform\", \"ax_version\", \"nonce\", \"contracts\", \"max_line_bytes\", \"max_object_bytes\") {\n143|\t\t\t\tt.Fatal(\"admitted hello body is not the exact member set\")\n144|\t\t\t}\n145|\t\tcase \"inventory.roots\":\n146|\t\t\tif !exactKeys(r.Body(), \"namespaces\") {\n147|\t\t\t\tt.Fatal(\"admitted inventory.roots body is not the exact member set\")\n148|\t\t\t}\n149|\t\t}\n150|\t})\n151|}\n152|\n153|// specNamespaces is the Section 11.3/11.8/11.9 namespace vocabulary,\n154|// transcribed from the pinned specification text rather than derived from\n155|// the production table, so drift in either direction fails the target.\n156|var specNamespaces = map[string][]string{\n157|\t\"2.0.0\": {\"blob\", \"event\", \"manifest\", \"record\", \"tombstone\", \"tombstone_ack\"},\n158|\t\"3.0.0\": {\"blob\", \"directory_record\", \"event\", \"manifest\", \"record\", \"tombstone\", \"tombstone_ack\"},\n159|\t\"4.0.0\": {\"blob\", \"directory_record\", \"event\", \"manifest\", \"record\", \"terminal_backend_evidence\", \"tombstone\", \"tombstone_ack\"},\n160|\t\"5.0.0\": {\"blob\", \"directory_record\", \"event\", \"manifest\", \"record\", \"terminal_backend_evidence\", \"tombstone\", \"tombstone_ack\"},\n161|}\n162|\n163|// FuzzNamespaceVocabulary drives inventory.roots request bodies: decode must\n164|// admit exactly the sorted-unique in-vocabulary lists for the framing major\n165|// and every admitted request must round-trip.\n166|//\n167|// Control: the namespace-member narrowing (mutations.py) admits the\n168|// \"credential\" namespace; with that plant applied the oracle below fails on\n169|// the seeded bad input. See the producer evidence log.\n170|func FuzzNamespaceVocabulary(f *testing.F) {\n171|\tfor version, names := range specNamespaces {\n172|\t\traw, _ := json.Marshal(map[string]any{\"namespaces\": names})\n173|\t\tf.Add(version, raw)\n174|\t\tf.Add(version, []byte(`{\"namespaces\":[]}`))\n175|\t\tf.Add(version, []byte(`{\"namespaces\":[\"credential\"]}`))\n176|\t\tf.Add(version, []byte(`{\"namespaces\":[\"event\",\"blob\"]}`))\n177|\t\tf.Add(version, []byte(`{\"namespaces\":[\"blob\",\"blob\"]}`))\n178|\t}\n179|\tf.Add(\"2.0.0\", []byte(`{\"namespaces\":[\"directory_record\"]}`))\n180|\tf.Add(\"6.0.0\", []byte(`{\"namespaces\":[\"blob\"]}`))\n181|\tf.Fuzz(func(t *testing.T, version string, body []byte) {\n182|\t\tallowed, pinned := specNamespaces[version]\n183|\t\tline, err := json.Marshal(map[string]any{\n184|\t\t\t\"protocol\":         rpcwire.Protocol,\n185|\t\t\t\"protocol_version\": version,\n186|\t\t\t\"request_id\":       fuzzEnvelopeID,\n187|\t\t\t\"operation\":        \"inventory.roots\",\n188|\t\t\t\"body\":             json.RawMessage(validObjectOrEmpty(body)),\n189|\t\t})\n190|\t\tif err != nil {\n191|\t\t\treturn\n192|\t\t}\n193|\t\tvar parsed struct {\n194|\t\t\tNamespaces []string `json:\"namespaces\"`\n195|\t\t}\n196|\t\toracleValid := pinned && json.Unmarshal(validObjectOrEmpty(body), &parsed) == nil &&\n197|\t\t\tlen(parsed.Namespaces) >= 1 && len(parsed.Namespaces) <= len(allowed) &&\n198|\t\t\tslices.IsSorted(parsed.Namespaces) && len(slices.Compact(slices.Clone(parsed.Namespaces))) == len(parsed.Namespaces)\n199|\t\tif oracleValid {\n200|\t\t\tfor _, name := range parsed.Namespaces {\n201|\t\t\t\tif !slices.Contains(allowed, name) {\n202|\t\t\t\t\toracleValid = false\n203|\t\t\t\t\tbreak\n204|\t\t\t\t}\n205|\t\t\t}\n206|\t\t}\n207|\t\t// The oracle is only consulted when the body is exactly the\n208|\t\t// single-member shape; anything else is invalid by construction.\n209|\t\tif !exactKeys(validObjectOrEmpty(body), \"namespaces\") {\n210|\t\t\toracleValid = false\n211|\t\t}\n212|\t\tr, err := rpcwire.DecodeRequest(line)\n213|\t\tif err != nil {\n214|\t\t\tif oracleValid {\n215|\t\t\t\tt.Fatalf(\"valid %s namespaces %q refused: %v\", version, parsed.Namespaces, err)\n216|\t\t\t}\n217|\t\t\treturn\n218|\t\t}\n219|\t\tif !oracleValid {\n220|\t\t\tt.Fatalf(\"invalid %s namespaces admitted: %q\", version, body)\n221|\t\t}\n222|\t\tround, err := rpcwire.EncodeRequest(r.Version(), r.ID(), r.Operation(), r.Body())\n223|\t\tif err != nil {\n224|\t\t\tt.Fatalf(\"admitted namespaces do not round-trip: %v\", err)\n225|\t\t}\n226|\t\tif _, err = rpcwire.DecodeRequest(round); err != nil {\n227|\t\t\tt.Fatalf(\"round-tripped namespaces refused: %v\", err)\n228|\t\t}\n229|\t})\n230|}\n231|\n232|// FuzzUnknownFields drives raw envelope lines: whatever decode admits must\n233|// carry exactly the closed member sets at the envelope and (for parsed\n234|// operations) body layers, and must round-trip through the production\n235|// encode entry.\n236|//\n237|// Control: the closed-extra narrowing (mutations.py) admits one extra=true\n238|// envelope member; with that plant applied the envelope property below\n239|// fails on the seeded bad input. See the producer evidence log.\n240|func FuzzUnknownFields(f *testing.F) {\n241|\tvalid := []byte(`{\"protocol\":\"urn:ax:protocol:rpc\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + fuzzEnvelopeID + `\",\"operation\":\"health.get\",\"body\":{}}`)\n242|\tf.Add(valid)\n243|\tf.Add([]byte(`{\"protocol\":\"urn:ax:protocol:rpc\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + fuzzEnvelopeID + `\",\"operation\":\"health.get\",\"body\":{},\"extra\":true}`))\n244|\tf.Add([]byte(`{\"protocol\":\"urn:ax:protocol:rpc\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + fuzzEnvelopeID + `\",\"operation\":\"health.get\",\"body\":{\"extensions\":{}},\"extensions\":{}}`))\n245|\tf.Add([]byte(`{\"protocol\":\"urn:ax:protocol:rpc\",\"protocol_version\":\"2.0.0\",\"request_id\":\"` + fuzzEnvelopeID + `\",\"operation\":\"inventory.roots\",\"body\":{\"namespaces\":[\"blob\"],\"extensions\":{}}}`))\n246|\tf.Add([]byte(`{\"protocol\":\"urn:ax:protocol:rpc\",\"protocol_version\":\"2.0.0\",\"request_id\":\"not-a-uuid\",\"operation\":\"health.get\",\"body\":{}}`))\n247|\tif raw, err := os.ReadFile(\"testdata/hello-request-v2.json\"); err == nil {\n248|\t\tcompact := &bytes.Buffer{}\n249|\t\tif json.Compact(compact, bytes.TrimSpace(raw)) == nil {\n250|\t\t\tf.Add(compact.Bytes())\n251|\t\t}\n252|\t}\n253|\tf.Fuzz(func(t *testing.T, line []byte) {\n254|\t\tr, err := rpcwire.DecodeRequest(line)\n255|\t\tif err != nil {\n256|\t\t\treturn\n257|\t\t}\n258|\t\tvar envelope map[string]json.RawMessage\n259|\t\tif json.Unmarshal(line, &envelope) != nil {\n260|\t\t\tt.Fatal(\"admitted line is not a JSON object\")\n261|\t\t}\n262|\t\tfor _, key := range []string{\"protocol\", \"protocol_version\", \"request_id\", \"operation\", \"body\"} {\n263|\t\t\tif _, ok := envelope[key]; !ok {\n264|\t\t\t\tt.Fatalf(\"admitted envelope misses %q\", key)\n265|\t\t\t}\n266|\t\t}\n267|\t\tif len(envelope) != 5 {\n268|\t\t\tt.Fatalf(\"admitted envelope carries %d members, want exactly 5\", len(envelope))\n269|\t\t}\n270|\t\tswitch r.Operation() {\n271|\t\tcase \"hello\":\n272|\t\t\tif !exactKeys(r.Body(), \"host_id\", \"platform\", \"ax_version\", \"nonce\", \"contracts\", \"max_line_bytes\", \"max_object_bytes\") {\n273|\t\t\t\tt.Fatal(\"admitted hello body is not the exact member set\")\n274|\t\t\t}\n275|\t\tcase \"inventory.roots\":\n276|\t\t\tif !exactKeys(r.Body(), \"namespaces\") {\n277|\t\t\t\tt.Fatal(\"admitted inventory.roots body is not the exact member set\")\n278|\t\t\t}\n279|\t\t}\n280|\t\tround, err := rpcwire.EncodeRequest(r.Version(), r.ID(), r.Operation(), r.Body())\n281|\t\tif err != nil {\n282|\t\t\tt.Fatalf(\"admitted line does not round-trip: %v\", err)\n283|\t\t}\n284|\t\tif _, err = rpcwire.DecodeRequest(round); err != nil {\n285|\t\t\tt.Fatalf(\"round-tripped line refused: %v\", err)\n286|\t\t}\n287|\t})\n288|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
