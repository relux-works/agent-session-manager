in lines[key], cl['id']\\n            cl['line'] = lines[key][cl['id']]\\n        reg['ownership'][i] = nb\\n        print('upgraded', key, 'clauses:', [(c['id'],c['line']) for c in nb['clauses']])\\n\\n# 3. Verify 11.3 untouched\\nfor o in reg['ownership']:\\n    if o.get('kind')=='section_binding' and o['keys'][0]=='section:11.3':\\n        assert o['coverage']=='unevidenced' and 'clauses' not in o\\n        print('11.3 stays unevidenced: OK')\\n\\njson.dump(reg, open('internal/traceability/ownership.v0.7.0.json','w'), indent=2)\\nopen('internal/traceability/ownership.v0.7.0.json','a').write('\\\\n')\\nprint('wrote registry')\\nEOF\\ngit diff --stat -- internal/traceability/ownership.v0.7.0.json\",\n  \"description\": \"Port bindings into v0.7.0 registry\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"cases now: 140\\nupgraded section:17.1 clauses: [('17.1#1', 15567), ('17.1#4', 15589), ('17.1#5', 15602)]\\nupgraded section:17.4 clauses: [('17.4#4', 15661)]\\nupgraded section:11.2 clauses: [('11.2#2', 7364), ('11.2#3', 7408), ('11.2#4', 7420)]\\n11.3 stays unevidenced: OK\\nwrote registry\\n internal/traceability/ownership.v0.7.0.json | 225 ++++++++++++++++++++++++++--\\n 1 file changed, 213 insertions(+), 12 deletions(-)\\n\",\n  \"original_output_bytes\": 415,\n  \"original_output_tokens\": 104,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
