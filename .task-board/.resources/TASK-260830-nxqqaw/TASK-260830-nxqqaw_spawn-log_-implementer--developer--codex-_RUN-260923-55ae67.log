+	"urn:ax:schema:clone-raw-object-manifest":           {},
+	"urn:ax:schema:clone-capture-manifest":              {},
+	"urn:ax:schema:canonical-session":                   {},
+	"urn:ax:schema:migration-checkpoint":                {},
+	"urn:ax:schema:fidelity-report":                     {},
