internal/dirnode/scan_test.go:151:// TestJournalRefusesChangedBody drives the production idempotency
internal/dirnode/scan_test.go:152:// entry with a changed body under a recorded key: the retry is an
internal/dirnode/scan_test.go:153:// idempotency_mismatch and records nothing — the prior result
internal/dirnode/scan_test.go:154:// still replays afterwards.
internal/dirnode/scan_test.go:155:func TestJournalRefusesChangedBody(t *testing.T) {
internal/dirnode/scan_test.go:156:	t.Parallel()
internal/dirnode/scan_test.go:157:	journal := NewJournal()
internal/dirnode/scan_test.go:158:	body := journalBody(fixtureOperationID)
internal/dirnode/scan_test.go:159:	result := []byte(`{"batch":"first"}`)
internal/dirnode/scan_test.go:160:	if _, _, err := journal.CheckAndRecord(OpScan, fixtureOperationID, body, result); err != nil {
internal/dirnode/scan_test.go:161:		t.Fatalf("CheckAndRecord(first) error = %v", err)
internal/dirnode/scan_test.go:162:	}
internal/dirnode/scan_test.go:163:	changed := journalBody(fixtureOperationID)
internal/dirnode/scan_test.go:164:	changed = []byte(replaceOnce(t, string(changed), `"max_instances":100`, `"max_instances":101`, 1))
internal/dirnode/scan_test.go:165:	if _, _, err := journal.CheckAndRecord(OpScan, fixtureOperationID, changed, []byte(`{"batch":"evil"}`)); requireCode(t, err, "idempotency_mismatch") == nil {
internal/dirnode/scan_test.go:166:		t.Fatal("changed body must refuse")
internal/dirnode/scan_test.go:167:	}
internal/dirnode/scan_test.go:168:	_, prior, err := journal.CheckAndRecord(OpScan, fixtureOperationID, body, nil)
internal/dirnode/scan_test.go:169:	if err != nil || string(prior) != string(result) {
internal/dirnode/scan_test.go:170:		t.Fatalf("prior result after mismatch = %q %v", prior, err)
