internal/dirnode/scan_test.go:200:
internal/dirnode/scan_test.go:201:// TestJournalSurvivesRestart drives the production journal export
internal/dirnode/scan_test.go:202:// and import entries for crash recovery: a restarted host
internal/dirnode/scan_test.go:203:// recovers the same record, replays the identical body, still
internal/dirnode/scan_test.go:204:// refuses a changed body, and refuses corrupt bytes as an
internal/dirnode/scan_test.go:205:// integrity failure rather than an empty journal.
internal/dirnode/scan_test.go:206:func TestJournalSurvivesRestart(t *testing.T) {
internal/dirnode/scan_test.go:207:	t.Parallel()
internal/dirnode/scan_test.go:208:	journal := NewJournal()
internal/dirnode/scan_test.go:209:	body := journalBody(fixtureOperationID)
internal/dirnode/scan_test.go:210:	result := []byte(`{"batch":"durable"}`)
internal/dirnode/scan_test.go:211:	if _, _, err := journal.CheckAndRecord(OpScan, fixtureOperationID, body, result); err != nil {
internal/dirnode/scan_test.go:212:		t.Fatalf("CheckAndRecord error = %v", err)
internal/dirnode/scan_test.go:213:	}
internal/dirnode/scan_test.go:214:	exported, err := journal.Export()
internal/dirnode/scan_test.go:215:	if err != nil {
internal/dirnode/scan_test.go:216:		t.Fatalf("Export error = %v", err)
internal/dirnode/scan_test.go:217:	}
internal/dirnode/scan_test.go:218:	restarted := NewJournal()
internal/dirnode/scan_test.go:219:	if err := restarted.Import(exported); err != nil {
internal/dirnode/scan_test.go:220:		t.Fatalf("Import error = %v", err)
internal/dirnode/scan_test.go:221:	}
internal/dirnode/scan_test.go:222:	stored, replayed, err := restarted.CheckAndRecord(OpScan, fixtureOperationID, body, nil)
internal/dirnode/scan_test.go:223:	if err != nil || stored || string(replayed) != string(result) {
internal/dirnode/scan_test.go:224:		t.Fatalf("replay after restart = %v %q %v", stored, replayed, err)
internal/dirnode/scan_test.go:225:	}
internal/dirnode/scan_test.go:226:	changed := []byte(replaceOnce(t, string(body), `"max_instances":100`, `"max_instances":101`, 1))
internal/dirnode/scan_test.go:227:	if _, _, err := restarted.CheckAndRecord(OpScan, fixtureOperationID, changed, nil); requireCode(t, err, "idempotency_mismatch") == nil {
internal/dirnode/scan_test.go:228:		t.Fatal("changed body after restart must refuse")
internal/dirnode/scan_test.go:229:	}
internal/dirnode/scan_test.go:230:	empty := NewJournal()
internal/dirnode/scan_test.go:231:	requireCode(t, empty.Import([]byte(`{"schema":"urn:ax:internal:dirnode-journal","version":2,"records":[]}`)), "integrity_failure")
internal/dirnode/scan_test.go:232:	requireCode(t, empty.Import([]byte(`{"schema":"urn:ax:other","version":1,"records":[]}`)), "integrity_failure")
internal/dirnode/scan_test.go:233:	requireCode(t, empty.Import([]byte(`{"schema":"urn:ax:internal:dirnode-journal","version":1}`)), "integrity_failure")
internal/dirnode/scan_test.go:234:	requireCode(t, empty.Import([]byte(`{"schema":"urn:ax:internal:dirnode-journal","version":1,"records":{}}`)), "integrity_failure")
internal/dirnode/scan_test.go:235:	requireCode(t, empty.Import([]byte(`{"schema":"urn:ax:internal:dirnode-journal","version":1,"records":[{"key":1,"body_digest":"eA==","result":"e30="}]}`)), "integrity_failure")
internal/dirnode/scan_test.go:236:	requireCode(t, empty.Import([]byte(`not json`)), "integrity_failure")
internal/dirnode/scan_test.go:237:	requireCode(t, empty.Import([]byte(`{"schema":"urn:ax:internal:dirnode-journal","version":1,"records":[{"key":"k","body_digest":"sha256:zzz","result":"e30="}]}`)), "integrity_failure")
internal/dirnode/scan_test.go:238:	if err := empty.Import([]byte(`{"schema":"urn:ax:internal:dirnode-journal","version":1,"records":[]}`)); err != nil {
internal/dirnode/scan_test.go:239:		t.Fatalf("Import(empty valid) error = %v", err)
internal/dirnode/scan_test.go:240:	}
internal/dirnode/scan_test.go:241:}
internal/dirnode/scan_test.go:242:
internal/dirnode/scan_test.go:243:// TestJournalImportRefusesUnsortedRecords drives the production
internal/dirnode/scan_test.go:244:// import entry with a two-record document in decreasing key
internal/dirnode/scan_test.go:245:// order: the import refuses rather than silently accepting an
internal/dirnode/scan_test.go:246:// order the exporter never emits.
internal/dirnode/scan_test.go:247:func TestJournalImportRefusesUnsortedRecords(t *testing.T) {
internal/dirnode/scan_test.go:248:	t.Parallel()
internal/dirnode/scan_test.go:249:	low := `{"key":"scan\u00000198f4c8-8e50-7f66-8f70-1234567890ac","body_digest":` + quote(fixtureBatchDigest) + `,"result":"e30="}`
internal/dirnode/scan_test.go:250:	high := `{"key":"scan\u00000198f4c8-8e50-7f66-8f70-1234567890ae","body_digest":` + quote(fixtureBatchDigest) + `,"result":"e30="}`
internal/dirnode/scan_test.go:251:	sorted := `{"schema":"urn:ax:internal:dirnode-journal","version":1,"records":[` + low + `,` + high + `]}`
internal/dirnode/scan_test.go:252:	reversed := `{"schema":"urn:ax:internal:dirnode-journal","version":1,"records":[` + high + `,` + low + `]}`
internal/dirnode/scan_test.go:253:	journal := NewJournal()
internal/dirnode/scan_test.go:254:	if err := journal.Import([]byte(sorted)); err != nil {
internal/dirnode/scan_test.go:255:		t.Fatalf("Import(sorted) error = %v", err)
internal/dirnode/scan_test.go:256:	}
internal/dirnode/scan_test.go:257:	requireCode(t, NewJournal().Import([]byte(reversed)), "integrity_failure")
internal/dirnode/scan_test.go:258:}
