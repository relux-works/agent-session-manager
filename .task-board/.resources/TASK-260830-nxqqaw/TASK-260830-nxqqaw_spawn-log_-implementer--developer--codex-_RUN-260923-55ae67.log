+	for index, label := range "0123456789abcdef" {
+		if node.Children[index].Label != string(label) || node.Children[index].Count.Uint64() != 1 {
+			t.Errorf("children[%d] = %#v, want sorted %q child of count 1", index, node.Children[index], label)
+		}
+	}
+}
