+	for _, namespace := range []string{"manifest", "blob"} {
+		root, err := index.Root(namespace)
+		if err != nil || root.Count.Uint64() != 0 {
+			t.Errorf("failed blob admission changed %s root: %#v, %v", namespace, root, err)
+		}
+	}
+}
