internal/dirnode/query_test.go:217:	requireCode(t, CheckCursorReuse("", false), "query_invalid")
internal/dirnode/query_test.go:218:	requireCode(t, CheckCursorReuse(strings.Repeat("x", 1025), false), "query_invalid")
internal/dirnode/query_test.go:219:}
