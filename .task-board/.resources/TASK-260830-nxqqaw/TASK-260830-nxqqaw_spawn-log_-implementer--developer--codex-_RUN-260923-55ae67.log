internal/dirnode/inventory_test.go:186:
internal/dirnode/inventory_test.go:187:// axerrorImportPath is the only import path the constructor census
internal/dirnode/inventory_test.go:188:// resolves. It is spelled here rather than derived because the
internal/dirnode/inventory_test.go:189:// census must pin production, not follow it: a moved package with
internal/dirnode/inventory_test.go:190:// no row here fails the zero-importer guard below.
internal/dirnode/inventory_test.go:191:const axerrorImportPath = "github.com/relux-works/agent-session-manager/internal/axerror"
internal/dirnode/inventory_test.go:192:
internal/dirnode/inventory_test.go:193:// TestAxerrorImportsAreUnaliased pins the import spelling every
internal/dirnode/inventory_test.go:194:// identifier-matched census in this package relies on. A
internal/dirnode/inventory_test.go:195:// production file importing the error package under any other
internal/dirnode/inventory_test.go:196:// name hides every refusal it builds from both the constructor
internal/dirnode/inventory_test.go:197:// census and the arm derivation at once. An empty scan, or a tree
internal/dirnode/inventory_test.go:198:// with no production importer at all, fails closed.
internal/dirnode/inventory_test.go:199:func TestAxerrorImportsAreUnaliased(t *testing.T) {
internal/dirnode/inventory_test.go:200:	directory, err := os.Getwd()
internal/dirnode/inventory_test.go:201:	if err != nil {
internal/dirnode/inventory_test.go:202:		t.Fatalf("import census: %v", err)
internal/dirnode/inventory_test.go:203:	}
internal/dirnode/inventory_test.go:204:	entries, err := os.ReadDir(directory)
internal/dirnode/inventory_test.go:205:	if err != nil {
internal/dirnode/inventory_test.go:206:		t.Fatalf("import census: %v", err)
internal/dirnode/inventory_test.go:207:	}
internal/dirnode/inventory_test.go:208:	scanned := 0
internal/dirnode/inventory_test.go:209:	importing := 0
internal/dirnode/inventory_test.go:210:	var violations []string
internal/dirnode/inventory_test.go:211:	for _, entry := range entries {
internal/dirnode/inventory_test.go:212:		name := entry.Name()
internal/dirnode/inventory_test.go:213:		if entry.IsDir() || !strings.HasSuffix(name, ".go") || strings.HasSuffix(name, "_test.go") {
internal/dirnode/inventory_test.go:214:			continue
internal/dirnode/inventory_test.go:215:		}
internal/dirnode/inventory_test.go:216:		scanned++
internal/dirnode/inventory_test.go:217:		path := filepath.Join(directory, name)
internal/dirnode/inventory_test.go:218:		source, err := os.ReadFile(path)
internal/dirnode/inventory_test.go:219:		if err != nil {
internal/dirnode/inventory_test.go:220:			t.Fatalf("import census: %v", err)
internal/dirnode/inventory_test.go:221:		}
internal/dirnode/inventory_test.go:222:		syntax, err := parseGoFile(path, source)
internal/dirnode/inventory_test.go:223:		if err != nil {
internal/dirnode/inventory_test.go:224:			t.Fatalf("import census: %v", err)
internal/dirnode/inventory_test.go:225:		}
internal/dirnode/inventory_test.go:226:		for _, declaration := range syntax.Imports {
internal/dirnode/inventory_test.go:227:			target, err := strconv.Unquote(declaration.Path.Value)
internal/dirnode/inventory_test.go:228:			if err != nil || target != axerrorImportPath {
internal/dirnode/inventory_test.go:229:				continue
internal/dirnode/inventory_test.go:230:			}
internal/dirnode/inventory_test.go:231:			importing++
internal/dirnode/inventory_test.go:232:			if declaration.Name != nil && declaration.Name.Name != "axerror" {
internal/dirnode/inventory_test.go:233:				violations = append(violations, name+": imports the error package as "+declaration.Name.Name)
internal/dirnode/inventory_test.go:234:			}
internal/dirnode/inventory_test.go:235:		}
internal/dirnode/inventory_test.go:236:	}
internal/dirnode/inventory_test.go:237:	if scanned == 0 {
internal/dirnode/inventory_test.go:238:		t.Fatal("import census scanned zero production files; the scanner is broken, not the package")
internal/dirnode/inventory_test.go:239:	}
internal/dirnode/inventory_test.go:240:	if importing == 0 {
internal/dirnode/inventory_test.go:241:		t.Fatal("import census found zero production importers of the error package; the census is vacuous, not green")
internal/dirnode/inventory_test.go:242:	}
internal/dirnode/inventory_test.go:243:	sort.Strings(violations)
internal/dirnode/inventory_test.go:244:	if len(violations) > 0 {
internal/dirnode/inventory_test.go:245:		t.Fatalf("aliased error-package import(s) hide constructions from the constructor census:\n  %s", strings.Join(violations, "\n  "))
internal/dirnode/inventory_test.go:246:	}
internal/dirnode/inventory_test.go:247:	t.Logf("import census: %d production importer(s) bind axerror across %d files", importing, scanned)
internal/dirnode/inventory_test.go:248:}
