internal/dirnode/probe_test.go:167:func TestProbeResponseFindingBound(t *testing.T) {
internal/dirnode/probe_test.go:168:	t.Parallel()
internal/dirnode/probe_test.go:169:	one := `{"severity":"info","code":"c","message":"m","remediation":null,"extensions":{}}`
internal/dirnode/probe_test.go:170:	many := strings.Repeat(one+`,`, 4096) + one
internal/dirnode/probe_test.go:171:	body := replaceOnce(t, fixtureProbeResponseJSON(), `"findings":[{`, `"findings":[`+many+`,{`, 1)
internal/dirnode/probe_test.go:172:	if _, err := CheckProbeResponse([]byte(body)); requireCode(t, err, "adapter_protocol_violation") == nil {
internal/dirnode/probe_test.go:173:		t.Fatal("4098 findings must refuse")
internal/dirnode/probe_test.go:174:	}
internal/dirnode/probe_test.go:175:	// Exactly one past the ceiling: a mutant widening the cap by
internal/dirnode/probe_test.go:176:	// one still refuses 4098, so only the 4097 case reddens it.
internal/dirnode/probe_test.go:177:	plusOne := replaceOnce(t, fixtureProbeResponseJSON(), `"findings":[{`, `"findings":[`+strings.Repeat(one+`,`, 4095)+one+`,{`, 1)
internal/dirnode/probe_test.go:178:	if _, err := CheckProbeResponse([]byte(plusOne)); requireCode(t, err, "adapter_protocol_violation") == nil {
internal/dirnode/probe_test.go:179:		t.Fatal("4097 findings must refuse")
internal/dirnode/probe_test.go:180:	}
internal/dirnode/probe_test.go:181:	edge := replaceOnce(t, fixtureProbeResponseJSON(), `"findings":[{`, `"findings":[`+strings.Repeat(one+`,`, 4094)+one+`,{`, 1)
internal/dirnode/probe_test.go:182:	if _, err := CheckProbeResponse([]byte(edge)); err != nil {
internal/dirnode/probe_test.go:183:		t.Fatalf("4096 findings must admit: %v", err)
internal/dirnode/probe_test.go:184:	}
internal/dirnode/probe_test.go:185:}
