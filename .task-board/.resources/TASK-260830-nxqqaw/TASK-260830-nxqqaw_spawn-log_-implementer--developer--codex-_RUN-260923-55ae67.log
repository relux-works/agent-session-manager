+      "TestObjectsGetRefusesUnsortedDuplicateAndUnavailableEncodingRequests",
+      "^TestObjectsGetRefusesUnsortedDuplicateAndUnavailableEncodingRequests$",
+      "Admits a repeated object ID by weakening strict ascending order to non-decreasing order.")
+probe("objects-get-cbor-only", S,
