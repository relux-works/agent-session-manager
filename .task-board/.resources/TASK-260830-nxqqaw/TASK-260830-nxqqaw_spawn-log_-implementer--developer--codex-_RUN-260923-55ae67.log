internal/dirnode/scan.go:491:	}
internal/dirnode/scan.go:492:	result, err := base64.StdEncoding.DecodeString(encoded)
internal/dirnode/scan.go:493:	if err != nil {
internal/dirnode/scan.go:494:		return decodedJournalRecord{}, false
internal/dirnode/scan.go:495:	}
internal/dirnode/scan.go:496:	return decodedJournalRecord{Key: key, BodyDigest: digest, Result: result}, true
internal/dirnode/scan.go:497:}
