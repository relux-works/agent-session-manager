+probe("tombstone-ack-subject-link", I,
+      "if referenced.SubjectID != acknowledgement.SubjectID {",
+      'if referenced.SubjectID != acknowledgement.SubjectID && acknowledgement.SubjectID != "0198f4c8-5b20-7c33-8c4d-1234567890ab" {',
