internal/dirnode/inventory_test.go:134:func TestQueryRegistryDerivedFromSpec(t *testing.T) {
internal/dirnode/inventory_test.go:135:	text := specText(t)
internal/dirnode/inventory_test.go:136:	window := specWindow(t, text, "Read operations are exactly", "there is no delete.")
internal/dirnode/inventory_test.go:137:	tokens := specCodeTokens(t, window)
internal/dirnode/inventory_test.go:138:	split := -1
internal/dirnode/inventory_test.go:139:	for index, token := range tokens {
internal/dirnode/inventory_test.go:140:		if token == "set_title" {
internal/dirnode/inventory_test.go:141:			split = index
internal/dirnode/inventory_test.go:142:			break
internal/dirnode/inventory_test.go:143:		}
internal/dirnode/inventory_test.go:144:	}
internal/dirnode/inventory_test.go:145:	if split < 0 {
internal/dirnode/inventory_test.go:146:		t.Fatal("mutation registry not found in query window")
internal/dirnode/inventory_test.go:147:	}
internal/dirnode/inventory_test.go:148:	reads, mutations := tokens[:split], tokens[split:]
internal/dirnode/inventory_test.go:149:	if strings.Join(reads, "\x00") != strings.Join(readOperations, "\x00") {
internal/dirnode/inventory_test.go:150:		t.Fatalf("read registry = %v, want spec %v", readOperations, reads)
internal/dirnode/inventory_test.go:151:	}
internal/dirnode/inventory_test.go:152:	if strings.Join(mutations, "\x00") != strings.Join(mutationOperations, "\x00") {
internal/dirnode/inventory_test.go:153:		t.Fatalf("mutation registry = %v, want spec %v", mutationOperations, mutations)
internal/dirnode/inventory_test.go:154:	}
internal/dirnode/inventory_test.go:155:}
