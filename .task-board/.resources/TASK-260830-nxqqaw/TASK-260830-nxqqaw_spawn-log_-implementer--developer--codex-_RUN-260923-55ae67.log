internal/dirnode/bound_census_test.go:642:func TestBoundGuardsAreCensused(t *testing.T) {
internal/dirnode/bound_census_test.go:643:	directory, err := os.Getwd()
internal/dirnode/bound_census_test.go:644:	if err != nil {
internal/dirnode/bound_census_test.go:645:		t.Fatalf("bound census: %v", err)
internal/dirnode/bound_census_test.go:646:	}
internal/dirnode/bound_census_test.go:647:	derived := scanBoundSiteIDs(t, directory)
internal/dirnode/bound_census_test.go:648:	if len(derived) == 0 {
internal/dirnode/bound_census_test.go:649:		t.Fatal("bound census derived zero sites; the scanner is broken, not the package")
internal/dirnode/bound_census_test.go:650:	}
internal/dirnode/bound_census_test.go:651:	derivedCounts := map[string]int{}
internal/dirnode/bound_census_test.go:652:	for _, id := range derived {
internal/dirnode/bound_census_test.go:653:		derivedCounts[id]++
internal/dirnode/bound_census_test.go:654:	}
internal/dirnode/bound_census_test.go:655:	for _, canary := range boundCensusCanaries {
internal/dirnode/bound_census_test.go:656:		found := false
internal/dirnode/bound_census_test.go:657:		for id := range derivedCounts {
internal/dirnode/bound_census_test.go:658:			if strings.HasPrefix(id, canary) {
internal/dirnode/bound_census_test.go:659:				found = true
internal/dirnode/bound_census_test.go:660:				break
internal/dirnode/bound_census_test.go:661:			}
internal/dirnode/bound_census_test.go:662:		}
internal/dirnode/bound_census_test.go:663:		if !found {
internal/dirnode/bound_census_test.go:664:			t.Errorf("bound census blind to canary %q; the scanner misses the class it must roster", canary)
internal/dirnode/bound_census_test.go:665:		}
internal/dirnode/bound_census_test.go:666:	}
internal/dirnode/bound_census_test.go:667:	registeredCounts := map[string]int{}
internal/dirnode/bound_census_test.go:668:	seen := map[string]bool{}
internal/dirnode/bound_census_test.go:669:	for _, row := range boundRegistrations {
internal/dirnode/bound_census_test.go:670:		if seen[row.id] {
internal/dirnode/bound_census_test.go:671:			t.Errorf("bound census registers %q twice", row.id)
internal/dirnode/bound_census_test.go:672:		}
internal/dirnode/bound_census_test.go:673:		seen[row.id] = true
internal/dirnode/bound_census_test.go:674:		registeredCounts[row.id]++
internal/dirnode/bound_census_test.go:675:		if row.driver == "" && !row.exempt {
internal/dirnode/bound_census_test.go:676:			t.Errorf("bound census row %q names no driver and no exemption", row.id)
internal/dirnode/bound_census_test.go:677:		}
internal/dirnode/bound_census_test.go:678:		if row.exempt && row.reason == "" {
internal/dirnode/bound_census_test.go:679:			t.Errorf("bound census exemption %q states no rationale", row.id)
internal/dirnode/bound_census_test.go:680:		}
internal/dirnode/bound_census_test.go:681:	}
internal/dirnode/bound_census_test.go:682:	var unregistered []string
internal/dirnode/bound_census_test.go:683:	for id, count := range derivedCounts {
internal/dirnode/bound_census_test.go:684:		for i := registeredCounts[id]; i < count; i++ {
internal/dirnode/bound_census_test.go:685:			unregistered = append(unregistered, id)
internal/dirnode/bound_census_test.go:686:		}
internal/dirnode/bound_census_test.go:687:	}
internal/dirnode/bound_census_test.go:688:	var orphaned []string
internal/dirnode/bound_census_test.go:689:	for id, count := range registeredCounts {
internal/dirnode/bound_census_test.go:690:		for i := derivedCounts[id]; i < count; i++ {
internal/dirnode/bound_census_test.go:691:			orphaned = append(orphaned, id)
internal/dirnode/bound_census_test.go:692:		}
internal/dirnode/bound_census_test.go:693:	}
internal/dirnode/bound_census_test.go:694:	sort.Strings(unregistered)
internal/dirnode/bound_census_test.go:695:	sort.Strings(orphaned)
internal/dirnode/bound_census_test.go:696:	if len(unregistered) > 0 {
internal/dirnode/bound_census_test.go:697:		t.Fatalf("production bound site(s) with no census row:\n  %s", strings.Join(unregistered, "\n  "))
internal/dirnode/bound_census_test.go:698:	}
internal/dirnode/bound_census_test.go:699:	if len(orphaned) > 0 {
internal/dirnode/bound_census_test.go:700:		t.Fatalf("census row(s) naming no production site:\n  %s", strings.Join(orphaned, "\n  "))
internal/dirnode/bound_census_test.go:701:	}
internal/dirnode/bound_census_test.go:702:	driven, exempt := 0, 0
internal/dirnode/bound_census_test.go:703:	for _, row := range boundRegistrations {
internal/dirnode/bound_census_test.go:704:		if row.exempt {
internal/dirnode/bound_census_test.go:705:			exempt++
internal/dirnode/bound_census_test.go:706:		} else {
internal/dirnode/bound_census_test.go:707:			driven++
internal/dirnode/bound_census_test.go:708:		}
internal/dirnode/bound_census_test.go:709:	}
internal/dirnode/bound_census_test.go:710:	t.Logf("bound census: %d sites rostered (%d driven, %d exempt) across production", len(derived), driven, exempt)
internal/dirnode/bound_census_test.go:711:}
