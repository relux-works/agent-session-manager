internal/dirnode/census_test.go:807:		"doc.go":       true,
internal/dirnode/census_test.go:808:		"manifest.go":  true,
internal/dirnode/census_test.go:809:		"probe.go":     true,
internal/dirnode/census_test.go:810:		"protocol.go":  true,
internal/dirnode/census_test.go:811:		"query.go":     true,
