internal/dirnode/census_test.go:895:		if err != nil {
internal/dirnode/census_test.go:896:			t.Fatalf("witness resolve: %v", err)
internal/dirnode/census_test.go:897:		}
internal/dirnode/census_test.go:898:		for _, declaration := range syntax.Decls {
internal/dirnode/census_test.go:899:			function, ok := declaration.(*ast.FuncDecl)
internal/dirnode/census_test.go:900:			if !ok || function.Recv != nil {
internal/dirnode/census_test.go:901:				continue
internal/dirnode/census_test.go:902:			}
internal/dirnode/census_test.go:903:			defined[function.Name.Name] = true
