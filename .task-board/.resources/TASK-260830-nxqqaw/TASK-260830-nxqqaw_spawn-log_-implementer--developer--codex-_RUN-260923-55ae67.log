internal/dirnode/scan_test.go:192:	}
internal/dirnode/scan_test.go:193:	if _, _, err := journal.CheckAndRecord(OpScan, "bad", body, []byte(`{}`)); requireCode(t, err, "invalid_config") == nil {
internal/dirnode/scan_test.go:194:		t.Fatal("bad identifier must refuse")
internal/dirnode/scan_test.go:195:	}
internal/dirnode/scan_test.go:196:	if _, _, err := journal.CheckAndRecord(OpScan, fixtureOperationID, []byte(`{`), []byte(`{}`)); requireCode(t, err, "adapter_protocol_violation") == nil {
