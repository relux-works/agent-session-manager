internal/dirnode/rawuint53_test.go:6:)
internal/dirnode/rawuint53_test.go:7:
internal/dirnode/rawuint53_test.go:8:// This file pins the rawUint53 trailing-data texture this leaf
internal/dirnode/rawuint53_test.go:9:// hardened onto the environ shape. Decode reads one value and
internal/dirnode/rawuint53_test.go:10:// stops, so without the trailing check a hostile slice like `12a`
internal/dirnode/rawuint53_test.go:11:// reads as 12 (and `12 13` reads as 12 with a silent second
internal/dirnode/rawuint53_test.go:12:// value). Member slices arriving through decodeStrictObject can
internal/dirnode/rawuint53_test.go:13:// never carry trailing data — the frame gate strips them first —
internal/dirnode/rawuint53_test.go:14:// so these rows drive the helper directly, the way
internal/dirnode/rawuint53_test.go:15:// decode_unit_test.go drives the environ entries no facade
internal/dirnode/rawuint53_test.go:16:// reaches. Both hostile shapes are separate rows because they
internal/dirnode/rawuint53_test.go:17:// fail for different reasons: `12a` errors at the trailing token
internal/dirnode/rawuint53_test.go:18:// while `12 13` yields one, so a gate that refuses only error
internal/dirnode/rawuint53_test.go:19:// trailing (the narrowing mutant) admits the second and fails
internal/dirnode/rawuint53_test.go:20:// exactly its row.
internal/dirnode/rawuint53_test.go:21:func TestRawUint53RefusesTrailingData(t *testing.T) {
internal/dirnode/rawuint53_test.go:22:	refuse := func(literal string) {
internal/dirnode/rawuint53_test.go:23:		t.Helper()
internal/dirnode/rawuint53_test.go:24:		if got, ok := rawUint53(json.RawMessage(literal)); ok {
internal/dirnode/rawuint53_test.go:25:			t.Fatalf("rawUint53(%q) admitted %d, want refusal", literal, got)
internal/dirnode/rawuint53_test.go:26:		}
internal/dirnode/rawuint53_test.go:27:	}
internal/dirnode/rawuint53_test.go:28:	accept := func(literal string, want uint64) {
internal/dirnode/rawuint53_test.go:29:		t.Helper()
internal/dirnode/rawuint53_test.go:30:		got, ok := rawUint53(json.RawMessage(literal))
internal/dirnode/rawuint53_test.go:31:		if !ok {
internal/dirnode/rawuint53_test.go:32:			t.Fatalf("rawUint53(%q) refused, want %d", literal, want)
internal/dirnode/rawuint53_test.go:33:		}
internal/dirnode/rawuint53_test.go:34:		if got != want {
internal/dirnode/rawuint53_test.go:35:			t.Fatalf("rawUint53(%q) = %d, want %d", literal, got, want)
internal/dirnode/rawuint53_test.go:36:		}
internal/dirnode/rawuint53_test.go:37:	}
internal/dirnode/rawuint53_test.go:38:	refuse("12a")
internal/dirnode/rawuint53_test.go:39:	refuse("12 13")
internal/dirnode/rawuint53_test.go:40:	refuse("0x10")
internal/dirnode/rawuint53_test.go:41:	accept("12", 12)
internal/dirnode/rawuint53_test.go:42:	accept("12 ", 12)
internal/dirnode/rawuint53_test.go:43:	accept(" 12", 12)
internal/dirnode/rawuint53_test.go:44:	accept("9007199254740991", 9007199254740991)
internal/dirnode/rawuint53_test.go:45:	refuse("9007199254740992")
internal/dirnode/rawuint53_test.go:46:	if _, ok := checkUint53Bounds(json.RawMessage("12a"), 0, 100); ok {
internal/dirnode/rawuint53_test.go:47:		t.Fatal("checkUint53Bounds admitted `12a`, want refusal")
internal/dirnode/rawuint53_test.go:48:	}
internal/dirnode/rawuint53_test.go:49:}
