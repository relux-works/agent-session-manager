internal/dirnode/bound_census_test.go:798:		"probe.go|zzForBound|len|",
internal/dirnode/bound_census_test.go:799:		"probe.go|zzSwitchBound|len|",
internal/dirnode/bound_census_test.go:800:		"probe.go|zzAssignBound|len|",
internal/dirnode/bound_census_test.go:801:	} {
