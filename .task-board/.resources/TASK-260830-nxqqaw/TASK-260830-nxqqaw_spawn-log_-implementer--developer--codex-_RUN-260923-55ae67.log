internal/dirnode/scan_test.go:260:// TestJournalExportIsDeterministic drives the production export
internal/dirnode/scan_test.go:261:// entry twice and requires identical bytes: recovery evidence
internal/dirnode/scan_test.go:262:// must not depend on map iteration order.
internal/dirnode/scan_test.go:263:func TestJournalExportIsDeterministic(t *testing.T) {
internal/dirnode/scan_test.go:264:	t.Parallel()
internal/dirnode/scan_test.go:265:	journal := NewJournal()
internal/dirnode/scan_test.go:266:	for _, id := range []string{fixtureOperationID, fixtureQueryID} {
internal/dirnode/scan_test.go:267:		if _, _, err := journal.CheckAndRecord(OpScan, id, journalBody(id), []byte(`{}`)); err != nil {
internal/dirnode/scan_test.go:268:			t.Fatalf("CheckAndRecord(%s) error = %v", id, err)
internal/dirnode/scan_test.go:269:		}
internal/dirnode/scan_test.go:270:	}
internal/dirnode/scan_test.go:271:	first, err := journal.Export()
internal/dirnode/scan_test.go:272:	if err != nil {
internal/dirnode/scan_test.go:273:		t.Fatalf("Export error = %v", err)
internal/dirnode/scan_test.go:274:	}
internal/dirnode/scan_test.go:275:	for range 20 {
internal/dirnode/scan_test.go:276:		again, err := journal.Export()
internal/dirnode/scan_test.go:277:		if err != nil {
internal/dirnode/scan_test.go:278:			t.Fatalf("Export error = %v", err)
internal/dirnode/scan_test.go:279:		}
internal/dirnode/scan_test.go:280:		if string(again) != string(first) {
internal/dirnode/scan_test.go:281:			t.Fatal("export bytes differ across calls: map iteration leaks into recovery evidence")
internal/dirnode/scan_test.go:282:		}
internal/dirnode/scan_test.go:283:	}
internal/dirnode/scan_test.go:284:}
