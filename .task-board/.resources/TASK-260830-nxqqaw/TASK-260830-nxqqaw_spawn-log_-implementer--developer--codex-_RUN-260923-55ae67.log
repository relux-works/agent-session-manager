internal/dirnode/query_test.go:203:func TestCheckCursorReuse(t *testing.T) {
internal/dirnode/query_test.go:204:	t.Parallel()
internal/dirnode/query_test.go:205:	if err := CheckCursorReuse("opaque-cursor", false); err != nil {
internal/dirnode/query_test.go:206:		t.Fatalf("CheckCursorReuse(unchanged) error = %v", err)
internal/dirnode/query_test.go:207:	}
internal/dirnode/query_test.go:208:	// Edges admit: the bound census pins the character measure
internal/dirnode/query_test.go:209:	// at 1 and 1024 through this entry.
internal/dirnode/query_test.go:210:	if err := CheckCursorReuse("x", false); err != nil {
internal/dirnode/query_test.go:211:		t.Fatalf("CheckCursorReuse(1 char) error = %v", err)
internal/dirnode/query_test.go:212:	}
internal/dirnode/query_test.go:213:	if err := CheckCursorReuse(strings.Repeat("x", 1024), false); err != nil {
