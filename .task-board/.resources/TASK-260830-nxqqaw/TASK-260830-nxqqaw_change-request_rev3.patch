+			}
+			for _, kind := range jsonKindsForWireTests {
+				kind := kind
+				t.Run(operationName+"_"+field+"_wrong_"+kind.name, func(t *testing.T) {
+					wrong := kind.value
+					if kind.name == "string" {
+						switch field {
+						case "namespaces":
