@@ -0,0 +1,367 @@
+package merkleinventory
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/relux-works/agent-session-manager/internal/canonicaljson"
+	"github.com/relux-works/agent-session-manager/internal/rpcwire"
