+						case "namespace":
+							wrong = `"unknown"`
+						case "prefix":
+							wrong = `"g"`
+						case "object_ids":
+							wrong = `"` + zeroDigest + `"`
+						case "encodings":
+							wrong = `"json"`
+						}
+					}
+					assertDispatchRejectedBody(t, index, shape.operation, rewriteRawObject(shape.members, field, "value", wrong))
