    gate_still_sees_owned_token = (
        gate_code == 0
        and "TestNoProductionPathAttestsProviderIdentityBinding" in gate_passed
        and not gate_failed
    )
    valid = behavior_killed and gate_still_sees_owned_token and source.read_bytes() == original
    return {
