          while read -r pkg target; do\\n@@ -294,9 +311,14 @@ jobs:\\n       # with every probe forced unavailable — the strongest posture, and\\n       # host-independent: a backticked capability mention that reads as a\\n       # positive availability claim is refused no matter what this host's\\n-      # probes would report. Live probe outcomes are never read here;\\n-      # ProbeState.Available is consumed by no call site. README prose is\\n-      # never capability evidence either way.\\n+      # probes would report. CheckAdvertisements reads ProbeState.Available\\n+      # from the states it is given, and both postures are driven\\n+      # (TestRealREADMECarriesNoPositiveClaim forces all unavailable,\\n+      # TestRealREADMEAdmitsWhenAllAvailable forces all available). What\\n+      # reaches no availability reader is the live probe outcome:\\n+      # ProbeStates feeds only CapabilityIDs, which keeps the IDs and\\n+      # drops availability. README prose is never capability evidence\\n+      # either way.\\n       - name: Check README with all probes forced unavailable\\n         run: |\\n           set +e\\n\",\n  \"original_output_bytes\": 4164,\n  \"original_output_tokens\": 1041,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
