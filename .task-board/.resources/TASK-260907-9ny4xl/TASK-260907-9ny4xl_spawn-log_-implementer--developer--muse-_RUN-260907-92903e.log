s_test.go-603-\\t\\tif !bytes.Contains(readme, []byte(claim)) {\\ninternal/canonicaljson/session_record_versions_test.go:604:\\t\\t\\tt.Fatalf(\\\"README no longer declares Session Record grammar claim %q\\\", claim)\\ninternal/canonicaljson/session_record_versions_test.go-605-\\t\\t}\\ninternal/canonicaljson/session_record_versions_test.go-606-\\t}\\ninternal/canonicaljson/session_record_versions_test.go-607-\\ninternal/canonicaljson/session_record_versions_test.go-608-\\tmatched, familyCounts, failures := resolveSessionRecordGrammarRows(rows)\\ninternal/canonicaljson/session_record_versions_test.go-609-\\tif len(failures) != 0 {\\ninternal/canonicaljson/session_record_versions_test.go-610-\\t\\tt.Fatalf(\\\"pinned Session Record grammar row set does not match the constraint enumeration:\\\\n%s\\\",\\ninternal/canonicaljson/session_record_versions_test.go-611-\\t\\t\\tstrings.Join(failures, \\\"\\\\n\\\"))\\ninternal/canonicaljson/session_record_versions_test.go-612-\\t}\\ninternal/canonicaljson/session_record_versions_test.go-613-\\tfor _, family := range sortedGrammarFamilies() {\\ninternal/canonicaljson/session_record_versions_test.go-614-\\t\\tif got, want := familyCounts[family], sessionRecordGrammarFamilyCounts[family]; got != want {\\n--\\ninternal/cliresult/guard_inventory_test.go-17-// file the inventory below is derived from exhaustively.\\ninternal/cliresult/guard_inventory_test.go-18-const readerSourceFile = \\\"client.go\\\"\\ninternal/cliresult/guard_inventory_test.go-19-\\ninternal/cliresult/guard_inventory_test.go:20:// guardInventoryAnchor is the README heading whose two tables this test pins. It\\ninternal/cliresult/guard_inventory_test.go-21-// is matched exactly, so renaming the heading reddens here instead of silently\\ninternal/cliresult/guard_inventory_test.go-22-// exempting the inventory from measurement.\\ninternal/cliresult/guard_inventory_test.go-23-const guardInventoryAnchor = \\\"### Refusal guard inventory\\\"\\ninternal/cliresult/guard_inventory_test.go-24-\\ninternal/cliresult/guard_inventory_test.go-25-// evidenceClasses is the closed vocabulary a row's domain-evidence cell must\\ninternal/cliresult/guard_inventory_test.go-26-// open with. A cell that opened with anything else would be prose again.\\ninternal/cliresult/guard_inventory_test.go-27-var evidenceClasses = []string{\\\"measured\\\", \\\"stated bound\\\", \\\"declared subsumed\\\"}\\ninternal/cliresult/guard_inventory_test.go-28-\\ninternal/cliresult/guard_inventory_test.go-29-// refusalSite is one place the reader refuses, derived from the source rather\\ninternal/cliresult/guard_inventory_test.go-30-// than named by hand: an fmt.Errorf call wrapping one of this package's\\n--\\ninternal/cliresult/guard_inventory_test.go-121-\\t}\\ninternal/cliresult/guard_inventory_test.go-122-}\\ninternal/cliresult/guard_inventory_test.go-123-\\ninternal/cliresult/guard_inventory_test.go:124:// inventoryRow is one row of the README's derived table.\\ninternal/cliresult/guard_inventory_test.go-125-type inventoryRow struct {\\ninternal/cliresult/guard_inventory_test.go-126-\\tnumber   string\\ninternal/cliresult/guard_inventory_test.go-127-\\tguard    string\\ninternal/cliresult/guard_inventory_test.go-128-\\tsentinel string\\ninternal/cliresult/guard_inventory_test.go-129-\\tmarker   string\\ninternal/cliresult/guard_inventory_test.go-130-\\tevidence string\\ninternal/cliresult/guard_inventory_test.go-131-\\ttests    []string\\ninternal/cliresult/guard_inventory_test.go-132-\\tline     int\\ninternal/cliresult/guard_inventory_test.go-133-}\\ninternal/cliresult/guard_inventory_test.go-134-\\ninternal/cliresult/guard_inventory_test.go:135:// siblingRow is one row of the README's enumerated table of guards this leaf\\ninternal/cliresult/guard_inventory_test.go-136-// added or reordered outside the reader source.\\ninternal/cliresult/guard_inventory_test.go-137-type siblingRow struct {\\ninternal/cliresult/guard_inventory_test.go-138-\\tguard    strin