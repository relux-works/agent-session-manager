kers {\n397|\t\tfound := false\n398|\t\tfor _, text := range mentioning {\n399|\t\t\tif wordMatches(marker, strings.ToLower(text)) {\n400|\t\t\t\tfound = true\n401|\t\t\t\tbreak\n402|\t\t\t}\n403|\t\t}\n404|\t\tif !found {\n405|\t\t\tt.Errorf(\"marker %q occurs in no probe-mentioning sentence; remove it or classify with it\", marker)\n406|\t\t}\n407|\t}\n408|}"}}}
