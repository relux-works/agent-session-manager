{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8af","stream":{"kind":"session","id":"01a07b60-5dda-7951-9c64-98cc389b396d"},"sequence":690,"recorded_at":1780531400001375,"record_type":"event","durability":"durable","causation_id":"bd52028a-acb2-4196-94e2-c06d1bbe961a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bd52028a-acb2-4196-94e2-c06d1bbe961a","run_stream":{"kind":"run","id":"bd52028a-acb2-4196-94e2-c06d1bbe961a"},"task_stream":{"kind":"task","id":"92af3615-0c3a-401b-8ee6-ff21f256d688"},"task_id":"92af3615-0c3a-401b-8ee6-ff21f256d688","event":{"kind":"output","task_id":"92af3615-0c3a-401b-8ee6-ff21f256d688","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/secprim/census_test.go`.\n(499 line(s) above)\n500|\tdirectory := filepath.Join(\"..\", pkg)\n501|\tif pkg == \"secprim\" {\n502|\t\tdirectory = \".\"\n503|\t}\n504|\tentries, err := os.ReadDir(directory)\n505|\tif err != nil {\n506|\t\tt.Fatalf(\"read %s: %v\", directory, err)\n507|\t}\n508|\tfound := map[string]bool{}\n509|\tscanned := false\n510|\tfor _, entry := range entries {\n511|\t\tname := entry.Name()\n512|\t\tif entry.IsDir() || !strings.HasSuffix(name, \"_test.go\") {\n513|\t\t\tcontinue\n514|\t\t}\n515|\t\tcontents, err := os.ReadFile(filepath.Join(directory, name))\n516|\t\tif err != nil {\n517|\t\t\tt.Fatal(err)\n518|\t\t}\n519|\t\tscanned = true\n520|\t\tsyntax, err := parser.ParseFile(token.NewFileSet(), name, contents, 0)\n521|\t\tif err != nil {\n522|\t\t\tt.Fatal(err)\n523|\t\t}\n524|\t\tfor _, declaration := range syntax.Decls {\n525|\t\t\tfunction, ok := declaration.(*ast.FuncDecl)\n526|\t\t\tif !ok || function.Recv != nil {\n527|\t\t\t\tcontinue\n528|\t\t\t}\n529|\t\t\tif strings.HasPrefix(function.Name.Name, \"Test\") {\n530|\t\t\t\tfound[function.Name.Name] = true\n531|\t\t\t}\n532|\t\t}\n533|\t}\n534|\tif !scanned {\n535|\t\tt.Fatalf(\"scanned no test files in %s; the witness check is blind\", pkg)\n536|\t}\n537|\treturn found\n538|}\n539|\n540|// TestSecretTokensAreProven requires every instrument token to fire on at\n541|// least one derived site: a token that matches nothing is dead ceremony,\n542|// and removing a live token orphans its sites in the roster above.\n543|func TestSecretTokensAreProven(t *testing.T) {\n544|\tt.Parallel()\n545|\tderived := deriveSecretSites(t)\n546|\tfor _, word := range secretTokens {\n547|\t\tfires := false\n548|\t\tfor site := range derived {\n549|\t\t\tif strings.Contains(strings.ToLower(site), word) {\n550|\t\t\t\tfires = true\n551|\t\t\t\tbreak\n552|\t\t\t}\n553|\t\t}\n554|\t\tif !fires {\n555|\t\t\tt.Errorf(\"token %q fires on no derived site; the instrument is blind to its class\", word)\n556|\t\t}\n557|\t}\n558|}\n559|\n560|// excludedAxerrorKeys parses the excludedDetailKeys table out of the\n561|// axerror package source, so the re-drive below follows the table instead\n562|// of retyping it: an added key is driven automatically, and a removed key\n563|// cannot be driven against a stale copy.\n564|func excludedAxerrorKeys(t *testing.T) []string {\n565|\tt.Helper()\n566|\tcontents, err := os.ReadFile(filepath.Join(\"..\", \"axerror\", \"details.go\"))\n567|\tif err != nil {\n568|\t\tt.Fatal(err)\n569|\t}\n570|\tsyntax, err := parser.ParseFile(token.NewFileSet(), \"details.go\", contents, 0)\n571|\tif err != nil {\n572|\t\tt.Fatal(err)\n573|\t}\n574|\tvar keys []string\n575|\tast.Inspect(syntax, func(node ast.Node) bool {\n576|\t\tspec, ok := node.(*ast.ValueSpec)\n577|\t\tif !ok || len(spec.Names) != 1 || spec.Names[0].Name != \"excludedDetailKeys\" {\n578|\t\t\treturn true\n579|\t\t}\n580|\t\tif len(spec.Values) != 1 {\n581|\t\t\tt.Fatal(\"excludedDetailKeys has no single initializer; the derivation is blind\")\n582|\t\t}\n583|\t\ttable, ok := spec.Values[0].(*ast.CompositeLit)\n584|\t\tif !ok {\n585|\t\t\tt.Fatal(\"excludedDetailKeys is not a composite literal; the derivation is blind\")\n586|\t\t}\n587|\t\tfor _, element := range table.Elts {\n588|\t\t\tpair, ok := element.(*ast.KeyValueExpr)\n589|\t\t\tif !ok {\n590|\t\t\t\tt.Fatal(\"excludedDetailKeys carries a non-pair element; the derivation is blind\")\n591|\t\t\t}\n592|\t\t\tliteral, ok := pair.Key.(*ast.BasicLit)\n593|\t\t\tif !ok || literal.Kind != token.STRING {\n594|\t\t\t\tt.Fatal(\"excludedDetailKeys carries a non-literal key; the derivation is blind\")\n595|\t\t\t}\n596|\t\t\tkey, err := strconv.Unquote(literal.Value)\n597|\t\t\tif err != nil {\n598|\t\t\t\tt.Fatal(err)\n599|\t\t\t}\n600|\t\t\tkeys = append(keys, key)\n601|\t\t}\n602|\t\treturn false\n603|\t})\n604|\tif len(keys) == 0 {\n605|\t\tt.Fatal(\"derived no excluded detail keys; the scanner is broken, not the table\")\n606|\t}\n607|\treturn keys\n608|}\n609|\n610|// TestSecretAxerrorTableRefused drives every key of the axerror exclusion\n611|// table through the production Structured Error constructor and requires\n612|// a refusal: the gate is proven on the table it owns, including the keys\n613|// (auth_json, bundle_*, transcript shapes) no census token fires on.\n614|func TestSecretAxerrorTableRefused(t *testing.T) {\n615|\tt.Parallel()\n616|\tfor _, key := range excludedAxerrorKeys(t) {\n617|\t\t_, err := axerror.New(axerror.Spec{\n618|\t\t\tVersion: axerror.Version100,\n619|\t\t\tCode:    \"provider_process_failed\",\n620|\t\t\tMessage: \"probe\",\n621|\t\t\tIDs:     axerror.NoIDs(),\n622|\t\t\tDetails: axerror.Details{key: \"value\"},\n623|\t\t})\n624|\t\tif err == nil {\n625|\t\t\tt.Errorf(\"axerror.New admitted excluded detail key %q\", key)\n626|\t\t\tcontinue\n627|\t\t}\n628|\t\tif !errors.Is(err, axerror.ErrInvalidDetails) {\n629|\t\t\tt.Errorf(\"axerror.New(%q) = %v, want ErrInvalidDetails\", key, err)\n630|\t\t}\n631|\t}\n632|}\n633|\n634|// TestSecretScanBlindSpot pins the deliberate Authority blind spot: bare\n635|// \"auth\"-substring declarations (authority identifiers, authorization\n636|// enums) are protocol vocabulary, never credential values, and the\n637|// instrument does not roster them. A secret named only with \"auth\" and\n638|// none of the instrument tokens would be missed; that residue is stated\n639|// here, not hidden.\n640|func TestSecretScanBlindSpot(t *testing.T) {\n641|\tt.Parallel()\n642|\tsites := map[string]bool{}\n643|\tadmitName(sites, \"x\", \"decl\", \"ScanRootAuthorityIDs\")\n644|\tadmitName(sites, \"x\", \"field\", \"AuthSubject\")\n645|\tadmitLocal(sites, \"x\", \"auth\")\n646|\tif len(sites) != 0 {\n647|\t\tt.Fatalf(\"blind-spot declarations rostered sites %v; the bound moved\", sites)\n648|\t}\n649|\t// And the instrument still sees the class it must roster.\n650|\tprove := map[string]bool{}\n651|\tadmitName(prove, \"x\", \"decl\", \"DBPassword\")\n652|\tif len(prove) != 1 {\n653|\t\tt.Fatalf(\"instrument missed a password declaration: %v\", prove)\n654|\t}\n655|}"}}}
