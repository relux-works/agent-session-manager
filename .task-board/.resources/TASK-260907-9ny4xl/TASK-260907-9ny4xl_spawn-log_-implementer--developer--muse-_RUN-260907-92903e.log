{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c47b","stream":{"kind":"session","id":"01a07b60-5dda-7951-9c64-98cc389b396d"},"sequence":152,"recorded_at":1780531400000299,"record_type":"event","durability":"durable","causation_id":"bd52028a-acb2-4196-94e2-c06d1bbe961a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bd52028a-acb2-4196-94e2-c06d1bbe961a","run_stream":{"kind":"run","id":"bd52028a-acb2-4196-94e2-c06d1bbe961a"},"task_stream":{"kind":"task","id":"3de52a03-7807-4f38-bc81-fbaf6e48069f"},"task_id":"3de52a03-7807-4f38-bc81-fbaf6e48069f","event":{"kind":"output","task_id":"3de52a03-7807-4f38-bc81-fbaf6e48069f","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/cigate/claims.go`.\n1|package cigate\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"regexp\"\n6|\t\"sort\"\n7|\t\"strings\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/secconftest\"\n10|)\n11|\n12|// ProbeState is one platform-capability probe outcome. IDs always come from\n13|// secconftest.DefaultCapabilities; this package defines no capability of its\n14|// own.\n15|type ProbeState struct {\n16|\tID        string\n17|\tAvailable bool\n18|}\n19|\n20|// Finding is one refused advertisement mention: a backticked probe ID in a\n21|// sentence the gate cannot admit.\n22|type Finding struct {\n23|\tID     string\n24|\tLine   int\n25|\tText   string\n26|\tReason string\n27|}\n28|\n29|// positiveAvailability are the verb phrases that state a capability is\n30|// provided. Each is pinned by a dedicated claim row: dropping one admits the\n31|// matching claim silently.\n32|var positiveAvailability = []string{\n33|\t\"available\",\n34|\t\"supported\",\n35|\t\"enabled\",\n36|\t\"works\",\n37|\t\"passes\",\n38|}\n39|\n40|// negations flip a positive phrase into a non-claim. Each is pinned by a\n41|// dedicated row: dropping one refuses an honestly conditional sentence.\n42|var negations = []string{\n43|\t\"not\",\n44|\t\"never\",\n45|\t\"no\",\n46|\t\"without\",\n47|\t\"cannot\",\n48|\t\"can't\",\n49|\t\"n't\",\n50|\t\"unavailable\",\n51|\t\"disabled\",\n52|\t\"conditional\",\n53|\t\"pending\",\n54|\t\"unless\",\n55|\t\"only\",\n56|}\n57|\n58|// nonClaimMarkers are descriptive words showing a sentence documents the\n59|// instrument (probes, skips, gates, tests) rather than advertising a\n60|// capability. Every marker must occur in at least one scanned corpus sentence\n61|// (see TestEveryNonClaimMarkerOccursInCorpus): a marker that fires nowhere is\n62|// either dead weight or an admission hole waiting for future text.\n63|var nonClaimMarkers = []string{\n64|\t\"probes\",\n65|\t\"capability\",\n66|\t\"attempt\",\n67|\t\"gates\",\n68|\t\"test\",\n69|\t\"witness\",\n70|\t\"skip\",\n71|\t\"strict\",\n72|\t\"platform\",\n73|\t\"lstat\",\n74|\t\"mkfifo\",\n75|\t\"chmod\",\n76|\t\"uid\",\n77|\t\"pinned\",\n78|\t\"rejected\",\n79|\t\"fixture\",\n80|\t\"denial\",\n81|\t\"fail\",\n82|\t\"check\",\n83|\t\"scan\",\n84|}\n85|\n86|// wordPatterns precompiles every gate word once at init. The compiled set is\n87|// read-only afterwards, so parallel checks share it without a lock; a lazily\n88|// filled cache here would race under t.Parallel.\n89|var wordPatterns = func() map[string]*regexp.Regexp {\n90|\tpatterns := map[string]*regexp.Regexp{}\n91|\tfor _, word := range append(append(append([]string(nil), positiveAvailability...), negations...), nonClaimMarkers...) {\n92|\t\tpatterns[word] = regexp.MustCompile(`\\b` + regexp.QuoteMeta(word) + `\\b`)\n93|\t}\n94|\treturn patterns\n95|}()\n96|\n97|func wordMatches(word, text string) bool {\n98|\tpattern, ok := wordPatterns[word]\n99|\tif !ok {\n100|\t\treturn false\n101|\t}\n102|\treturn pattern.MatchString(text)\n103|}\n104|\n105|func containsAnyFold(words []string, text string) bool {\n106|\tlowered := strings.ToLower(text)\n107|\tfor _, word := range words {\n108|\t\tif wordMatches(word, lowered) {\n109|\t\t\treturn true\n110|\t\t}\n111|\t}\n112|\treturn false\n113|}\n114|\n115|// ProbeStates runs every secconftest capability probe on this host and\n116|// returns the outcomes. IDs are derived, never retyped; an empty derivation\n117|// is refused rather than treated as nothing to check.\n118|func ProbeStates() ([]ProbeState, error) {\n119|\tcapabilities := secconftest.DefaultCapabilities()\n120|\tif len(capabilities) == 0 {\n121|\t\treturn nil, fmt.Errorf(\"cigate: capability probe derivation is empty\")\n122|\t}\n123|\tstates := make([]ProbeState, 0, len(capabilities))\n124|\tfor _, capability := range capabilities {\n125|\t\tif capability.ID == \"\" || capability.Probe == nil {\n126|\t\t\treturn nil, fmt.Errorf(\"cigate: capability without identity or probe is unusable\")\n127|\t\t}\n128|\t\tavailable, _ := capability.Probe()\n129|\t\tstates = append(states, ProbeState{ID: capability.ID, Available: available})\n130|\t}\n131|\tsort.Slice(states, func(i, j int) bool { return states[i].ID < states[j].ID })\n132|\treturn states, nil\n133|}\n134|\n135|// CapabilityIDs derives the probe vocabulary: the sorted IDs of every\n136|// secconftest capability. It is the only vocabulary the advertisement check\n137|// may name.\n138|func CapabilityIDs() ([]string, error) {\n139|\tstates, err := ProbeStates()\n140|\tif err != nil {\n141|\t\treturn nil, err\n142|\t}\n143|\tids := make([]string, 0, len(states))\n144|\tfor _, state := range states {\n145|\t\tids = append(ids, state.ID)\n146|\t}\n147|\treturn ids, nil\n148|}\n149|\n150|// sentence is one classified unit with its 1-based starting line.\n151|type sentence struct {\n152|\ttext string\n153|\tline int\n154|}\n155|\n156|// splitSentences unwraps blank-line-separated blocks onto single lines and\n157|// splits them at sentence-terminal punctuation. Offsets are approximate by\n158|// construction; findings carry the starting line so a human can locate the\n159|// mention exactly.\n160|func splitSentences(document string) []sentence {\n161|\tvar sentences []sentence\n162|\tnormalized := strings.ReplaceAll(document, \"\\r\\n\", \"\\n\")\n163|\traw := strings.Split(normalized, \"\\n\")\n164|\tfor start := 0; start < len(raw); {\n165|\t\tif strings.TrimSpace(raw[start]) == \"\" {\n166|\t\t\tstart++\n167|\t\t\tcontinue\n168|\t\t}\n169|\t\tend := start\n170|\t\tfor end < len(raw) && strings.TrimSpace(raw[end]) != \"\" {\n171|\t\t\tend++\n172|\t\t}\n173|\t\tvar cleaned []string\n174|\t\tvar rows []int\n175|\t\tfor row := start; row < end; row++ {\n176|\t\t\ttrimmed := strings.TrimSpace(raw[row])\n177|\t\t\tif trimmed == \"\" {\n178|\t\t\t\tcontinue\n179|\t\t\t}\n180|\t\t\tcleaned = append(cleaned, trimmed)\n181|\t\t\trows = append(rows, row+1)\n182|\t\t}\n183|\t\tstart = end\n184|\t\tif len(cleaned) == 0 {\n185|\t\t\tcontinue\n186|\t\t}\n187|\t\tjoined := strings.Join(cleaned, \" \")\n188|\t\tlineOf := make([]int, len(joined))\n189|\t\toffset := 0\n190|\t\tfor index, line := range cleaned {\n191|\t\t\tfor range line {\n192|\t\t\t\tif offset < len(lineOf) {\n193|\t\t\t\t\tlineOf[offset] = rows[index]\n194|\t\t\t\t}\n195|\t\t\t\toffset++\n196|\t\t\t}\n197|\t\t\tif offset < len(lineOf) {\n198|\t\t\t\tlineOf[offset] = rows[index]\n199|\t\t\t\toffset++\n200|\t\t\t}\n201|\t\t}\n202|\t\tstart := 0\n203|\t\tfor index := 0; index < len(joined); index++ {\n204|\t\t\tend := index == len(joined)-1\n205|\t\t\tboundary := end ||\n206|\t\t\t\t((joined[index] == '.' || joined[index] == '!' || joined[index] == '?') &&\n207|\t\t\t\t\t(index+1 >= len(joined) || joined[index+1] == ' ' || joined[index+1] == '\\t'))\n208|\t\t\tif !boundary {\n209|\t\t\t\tcontinue\n210|\t\t\t}\n211|\t\t\ttext := strings.TrimSpace(joined[start : index+1])\n212|\t\t\tif text != \"\" {\n213|\t\t\t\tsentences = append(sentences, sentence{text: text, line: lineOf[start]})\n214|\t\t\t}\n215|\t\t\tstart = index + 1\n216|\t\t}\n217|\t}\n218|\treturn sentences\n219|}\n220|\n221|// CheckAdvertisements refuses every sentence that advertises a capability the\n222|// probes report unavailable. An empty probe set or an empty document is\n223|// refused outright: a gate that finds nothing to check, or nothing to check\n224|// against, passes on an empty result set, which is the defect class this\n225|// story removes.\n226|func CheckAdvertisements(document string, states []ProbeState) ([]Finding, error) {\n227|\tif len(states) == 0 {\n228|\t\treturn nil, fmt.Errorf(\"cigate: no probe outcomes to check advertisements against\")\n229|\t}\n230|\tif strings.TrimSpace(document) == \"\" {\n231|\t\treturn nil, fmt.Errorf(\"cigate: empty document proves no advertisement claim\")\n232|\t}\n233|\tavailability := make(map[string]bool, len(states))\n234|\tfor _, state := range states {\n235|\t\tavailability[state.ID] = state.Available\n236|\t}\n237|\tvar findings []Finding\n238|\tfor _, part := range splitSentences(document) {\n239|\t\tvar mentioned []string\n240|\t\tfor id := range availability {\n241|\t\t\tif strings.Contains(part.text, \"`\"+id+\"`\") {\n242|\t\t\t\tmentioned = append(mentioned, id)\n243|\t\t\t}\n244|\t\t}\n245|\t\tif len(mentioned) == 0 {\n246|\t\t\tcontinue\n247|\t\t}\n248|\t\tsort.Strings(mentioned)\n249|\t\tvar unavailable []string\n250|\t\tfor _, id := range mentioned {\n251|\t\t\tif !availability[id] {\n252|\t\t\t\tunavailable = append(unavailable, id)\n253|\t\t\t}\n254|\t\t}\n255|\t\tif len(unavailable) == 0 {\n256|\t\t\tcontinue\n257|\t\t}\n258|\t\tif containsAnyFold(positiveAvailability, part.text) &&\n259|\t\t\t!containsAnyFold(negations, part.text) {\n260|\t\t\tfor _, id := range unavailable {\n261|\t\t\t\tfindings = append(findings, Finding{\n262|\t\t\t\t\tID:     id,\n263|\t\t\t\t\tLine:   part.line,\n264|\t\t\t\t\tText:   part.text,\n265|\t\t\t\t\tReason: \"positive availability claim for an unavailable capability\",\n266|\t\t\t\t})\n267|\t\t\t}\n268|\t\t\tcontinue\n269|\t\t}\n270|\t\tif !containsAnyFold(append(append([]string(nil), negations...), nonClaimMarkers...), part.text) {\n271|\t\t\tfor _, id := range unavailable {\n272|\t\t\t\tfindings = append(findings, Finding{\n273|\t\t\t\t\tID:     id,\n274|\t\t\t\t\tLine:   part.line,\n275|\t\t\t\t\tText:   part.text,\n276|\t\t\t\t\tReason: \"unclassified mention of an unavailable capability\",\n277|\t\t\t\t})\n278|\t\t\t}\n279|\t\t}\n280|\t}\n281|\treturn findings, nil\n282|}"}}}
