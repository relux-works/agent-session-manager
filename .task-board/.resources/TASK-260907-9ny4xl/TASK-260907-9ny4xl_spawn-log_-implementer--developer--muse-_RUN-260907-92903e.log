{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c47f","stream":{"kind":"session","id":"01a07b60-5dda-7951-9c64-98cc389b396d"},"sequence":154,"recorded_at":1780531400000303,"record_type":"event","durability":"durable","causation_id":"bd52028a-acb2-4196-94e2-c06d1bbe961a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bd52028a-acb2-4196-94e2-c06d1bbe961a","run_stream":{"kind":"run","id":"bd52028a-acb2-4196-94e2-c06d1bbe961a"},"task_stream":{"kind":"task","id":"355f19cc-0d53-4a99-a202-5ca8173d92c1"},"task_id":"355f19cc-0d53-4a99-a202-5ca8173d92c1","event":{"kind":"output","task_id":"355f19cc-0d53-4a99-a202-5ca8173d92c1","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/cigate/claims_test.go`.\n1|package cigate\n2|\n3|import (\n4|\t\"os\"\n5|\t\"path/filepath\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|)\n9|\n10|func unavailableStates(ids ...string) []ProbeState {\n11|\tstates := make([]ProbeState, 0, len(ids))\n12|\tfor _, id := range ids {\n13|\t\tstates = append(states, ProbeState{ID: id, Available: false})\n14|\t}\n15|\treturn states\n16|}\n17|\n18|func availableStates(ids ...string) []ProbeState {\n19|\tstates := make([]ProbeState, 0, len(ids))\n20|\tfor _, id := range ids {\n21|\t\tstates = append(states, ProbeState{ID: id, Available: true})\n22|\t}\n23|\treturn states\n24|}\n25|\n26|func TestCapabilityIDsAreDerivedSorted(t *testing.T) {\n27|\tt.Parallel()\n28|\tids, err := CapabilityIDs()\n29|\tif err != nil {\n30|\t\tt.Fatalf(\"CapabilityIDs() error = %v\", err)\n31|\t}\n32|\tif len(ids) == 0 {\n33|\t\tt.Fatal(\"CapabilityIDs() is empty; the check would pass on an empty vocabulary\")\n34|\t}\n35|\tfor index, id := range ids {\n36|\t\tif id == \"\" {\n37|\t\t\tt.Fatalf(\"CapabilityIDs()[%d] is empty\", index)\n38|\t\t}\n39|\t\tif index > 0 && ids[index-1] >= id {\n40|\t\t\tt.Fatalf(\"CapabilityIDs() = %v, want sorted\", ids)\n41|\t\t}\n42|\t}\n43|}\n44|\n45|// TestPositiveClaimsAreRefused drives one claim per positive verb: dropping a\n46|// verb from the gate must admit exactly its row (NARROWING battery). Each\n47|// subtest kills by behaviour — the count when the row goes silent, the\n48|// reason when it slides to the unclassified arm — never by a battery-size\n49|// guard: a parent-level size check would abort before any subtest runs and\n50|// prove only bookkeeping.\n51|func TestPositiveClaimsAreRefused(t *testing.T) {\n52|\tt.Parallel()\n53|\tclaims := map[string]string{\n54|\t\t\"available\": \"The `fifo` capability is available on Windows.\",\n55|\t\t\"supported\": \"This release keeps `fifo` supported on every platform.\",\n56|\t\t\"enabled\":   \"The runner has `fifo` enabled by default.\",\n57|\t\t\"works\":     \"The `fifo` lane works on Windows.\",\n58|\t\t\"passes\":    \"The `fifo` fixture passes on Windows.\",\n59|\t\t\"capital\":   \"The `fifo` capability is Available on Windows.\",\n60|\t}\n61|\tfor verb, claim := range claims {\n62|\t\tt.Run(verb, func(t *testing.T) {\n63|\t\t\tt.Parallel()\n64|\t\t\tfindings, err := CheckAdvertisements(claim, unavailableStates(\"fifo\"))\n65|\t\t\tif err != nil {\n66|\t\t\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n67|\t\t\t}\n68|\t\t\tif len(findings) != 1 {\n69|\t\t\t\tt.Fatalf(\"CheckAdvertisements() findings = %v, want exactly one\", findings)\n70|\t\t\t}\n71|\t\t\tif findings[0].ID != \"fifo\" {\n72|\t\t\t\tt.Errorf(\"finding ID = %q, want fifo\", findings[0].ID)\n73|\t\t\t}\n74|\t\t\tif !strings.Contains(findings[0].Reason, \"positive availability claim\") {\n75|\t\t\t\tt.Errorf(\"finding reason = %q, want the positive-claim refusal\", findings[0].Reason)\n76|\t\t\t}\n77|\t\t})\n78|\t}\n79|\t// A verb added to the gate without a claim row would pass the battery\n80|\t// without ever being driven: the census fails instead.\n81|\tt.Run(\"battery-covers-gate\", func(t *testing.T) {\n82|\t\tt.Parallel()\n83|\t\tfor _, verb := range positiveAvailability {\n84|\t\t\tif _, ok := claims[verb]; !ok {\n85|\t\t\t\tt.Errorf(\"gate verb %q has no claim row; extend the battery\", verb)\n86|\t\t\t}\n87|\t\t}\n88|\t})\n89|}\n90|\n91|// TestNegatedClaimsAreAdmitted drives one row per negation: dropping a\n92|// negation must refuse exactly its honestly conditional sentence. Every row\n93|// carries a positive verb guarded by exactly one negation, so the drop kills\n94|// by behaviour — the positive arm fires — never by a battery-size guard. A\n95|// row naming two negations would let one cover for the other and must not\n96|// be written; a row without a positive verb would not redden at all.\n97|func TestNegatedClaimsAreAdmitted(t *testing.T) {\n98|\tt.Parallel()\n99|\tsentences := map[string]string{\n100|\t\t\"not\":         \"The `fifo` capability is not available on Windows.\",\n101|\t\t\"never\":       \"The `fifo` lane never passes on Windows.\",\n102|\t\t\"no\":          \"No host reports the `fifo` capability as available.\",\n103|\t\t\"without\":     \"The suite runs without the `fifo` capability available.\",\n104|\t\t\"cannot\":      \"The `fifo` probe cannot report available on Windows.\",\n105|\t\t\"can't\":       \"The `fifo` capability can't be enabled on Windows.\",\n106|\t\t\"n't\":         \"Hosts do n't advertise `fifo` as available.\",\n107|\t\t\"unavailable\": \"The `fifo` capability is unavailable on Windows, though the docs call it available.\",\n108|\t\t\"disabled\":    \"The `fifo` capability stays disabled on Windows, though the checklist marks it available.\",\n109|\t\t\"conditional\": \"The `fifo` capability is available conditional on the Linux lane.\",\n110|\t\t\"pending\":     \"The `fifo` lane will be available pending the Linux rollout.\",\n111|\t\t\"unless\":      \"The `fifo` lane is available on Windows unless the platform withholds it.\",\n112|\t\t\"only\":        \"The `fifo` capability is available only on Linux.\",\n113|\t}\n114|\tfor word, document := range sentences {\n115|\t\tt.Run(word, func(t *testing.T) {\n116|\t\t\tt.Parallel()\n117|\t\t\tfindings, err := CheckAdvertisements(document, unavailableStates(\"fifo\"))\n118|\t\t\tif err != nil {\n119|\t\t\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n120|\t\t\t}\n121|\t\t\tif len(findings) != 0 {\n122|\t\t\t\tt.Fatalf(\"CheckAdvertisements() findings = %v, want none\", findings)\n123|\t\t\t}\n124|\t\t})\n125|\t}\n126|\t// A negation added to the gate without a conditional row would pass the\n127|\t// battery without ever being driven: the census fails instead.\n128|\tt.Run(\"battery-covers-gate\", func(t *testing.T) {\n129|\t\tt.Parallel()\n130|\t\tfor _, word := range negations {\n131|\t\t\tif _, ok := sentences[word]; !ok {\n132|\t\t\t\tt.Errorf(\"gate negation %q has no conditional row; extend the battery\", word)\n133|\t\t\t}\n134|\t\t}\n135|\t})\n136|}\n137|\n138|// TestUnbacktickedProseIsOutsideTheScanner pins the stated bound: the gate\n139|// matches backticked capability IDs only, so a positive availability claim\n140|// written in bare prose is admitted unchecked. Widening the matcher to bare\n141|// IDs must fail here.\n142|func TestUnbacktickedProseIsOutsideTheScanner(t *testing.T) {\n143|\tt.Parallel()\n144|\tfor _, document := range []string{\n145|\t\t\"FIFO creation is available and supported on Windows.\",\n146|\t\t\"The fifo capability is available on Windows.\",\n147|\t} {\n148|\t\tfindings, err := CheckAdvertisements(document, unavailableStates(\"fifo\"))\n149|\t\tif err != nil {\n150|\t\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n151|\t\t}\n152|\t\tif len(findings) != 0 {\n153|\t\t\tt.Fatalf(\"CheckAdvertisements(%q) findings = %v, want none: bare prose is outside the scanner\", document, findings)\n154|\t\t}\n155|\t}\n156|}\n157|\n158|// TestUnclassifiedMentionIsRefused is the fail-closed arm: a sentence that\n159|// names an unavailable capability without any classified context is refused\n160|// rather than ignored. It is also the net for the token-preserving mutant\n161|// that phrases a claim without any listed verb.\n162|func TestUnclassifiedMentionIsRefused(t *testing.T) {\n163|\tt.Parallel()\n164|\tfor _, document := range []string{\n165|\t\t\"Ship the `fifo` driver tomorrow.\",\n166|\t\t\"The `fifo` lane is up on every host.\",\n167|\t} {\n168|\t\tfindings, err := CheckAdvertisements(document, unavailableStates(\"fifo\"))\n169|\t\tif err != nil {\n170|\t\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n171|\t\t}\n172|\t\tif len(findings) != 1 {\n173|\t\t\tt.Fatalf(\"CheckAdvertisements(%q) findings = %v, want exactly one\", document, findings)\n174|\t\t}\n175|\t\tif !strings.Contains(findings[0].Reason, \"unclassified mention\") {\n176|\t\t\tt.Errorf(\"finding reason = %q, want the unclassified refusal\", findings[0].Reason)\n177|\t\t}\n178|\t}\n179|}\n180|\n181|func TestAvailableCapabilityAdmitsPositiveClaim(t *testing.T) {\n182|\tt.Parallel()\n183|\tfindings, err := CheckAdvertisements(\n184|\t\t\"The `fifo` capability is available on Linux.\",\n185|\t\tavailableStates(\"fifo\"))\n186|\tif err != nil {\n187|\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n188|\t}\n189|\tif len(findings) != 0 {\n190|\t\tt.Fatalf(\"available capability drew findings = %v\", findings)\n191|\t}\n192|}\n193|\n194|func TestMixedAvailabilityFindsOnlyUnavailable(t *testing.T) {\n195|\tt.Parallel()\n196|\tfindings, err := CheckAdvertisements(\n197|\t\t\"The `symlink` and `fifo` lanes are available on Windows, and `mode-bits` stays up too.\",\n198|\t\t[]ProbeState{\n199|\t\t\t{ID: \"symlink\", Available: true},\n200|\t\t\t{ID: \"fifo\", Available: false},\n201|\t\t\t{ID: \"mode-bits\", Available: false},\n202|\t\t})\n203|\tif err != nil {\n204|\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n205|\t}\n206|\t// Asserted as a set: finding order is presentation, not verdict.\n207|\trefused := map[string]bool{}\n208|\tfor _, finding := range findings {\n209|\t\trefused[finding.ID] = true\n210|\t}\n211|\twant := map[string]bool{\"fifo\": true, \"mode-bits\": true}\n212|\tif len(refused) != len(want) {\n213|\t\tt.Fatalf(\"refused = %v, want %v\", refused, want)\n214|\t}\n215|\tfor id := range want {\n216|\t\tif !refused[id] {\n217|\t\t\tt.Fatalf(\"refused = %v, want %v\", refused, want)\n218|\t\t}\n219|\t}\n220|}\n221|\n222|func TestEmptyInputsAreRefused(t *testing.T) {\n223|\tt.Parallel()\n224|\tif _, err := CheckAdvertisements(\"The `fifo` lane is up.\", nil); err == nil {\n225|\t\tt.Error(\"empty probe set admitted; the gate would pass on an empty vocabulary\")\n226|\t}\n227|\tif _, err := CheckAdvertisements(\"   \\n  \", unavailableStates(\"fifo\")); err == nil {\n228|\t\tt.Error(\"empty document admitted; the gate would pass on nothing scanned\")\n229|\t}\n230|}\n231|\n232|// TestSubstringIsNotAMarker pins boundary anchoring: \"protest\" carries the\n233|// letters t-e-s-t without the word test, and must not classify the sentence.\n234|// A gate matching substrings would admit this claim-shaped mention.\n235|func TestSubstringIsNotAMarker(t *testing.T) {\n236|\tt.Parallel()\n237|\tfindings, err := CheckAdvertisements(\"Citizens protest the `fifo` cut.\", unavailableStates(\"fifo\"))\n238|\tif err != nil {\n239|\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n240|\t}\n241|\tif len(findings) != 1 {\n242|\t\tt.Fatalf(\"findings = %v, want exactly the unclassified refusal\", findings)\n243|\t}\n244|\tif !strings.Contains(findings[0].Reason, \"unclassified mention\") {\n245|\t\tt.Errorf(\"finding reason = %q, want the unclassified refusal\", findings[0].Reason)\n246|\t}\n247|}\n248|\n249|func TestFindingCarriesLine(t *testing.T) {\n250|\tt.Parallel()\n251|\tdocument := \"First line.\\n\\nThe `fifo` capability is available on Windows.\\n\"\n252|\tfindings, err := CheckAdvertisements(document, unavailableStates(\"fifo\"))\n253|\tif err != nil {\n254|\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n255|\t}\n256|\tif len(findings) != 1 {\n257|\t\tt.Fatalf(\"findings = %v, want exactly one\", findings)\n258|\t}\n259|\tif findings[0].Line != 3 {\n260|\t\tt.Errorf(\"finding line = %d, want 3\", findings[0].Line)\n261|\t}\n262|}\n263|\n264|func readREADME(t *testing.T) string {\n265|\tt.Helper()\n266|\tcontents, err := os.ReadFile(filepath.Join(\"..\", \"..\", \"README.md\"))\n267|\tif err != nil {\n268|\t\tt.Fatalf(\"read README.md: %v\", err)\n269|\t}\n270|\treturn string(contents)\n271|}\n272|\n273|func allUnavailable(t *testing.T) []ProbeState {\n274|\tt.Helper()\n275|\tids, err := CapabilityIDs()\n276|\tif err != nil {\n277|\t\tt.Fatalf(\"CapabilityIDs() error = %v\", err)\n278|\t}\n279|\treturn unavailableStates(ids...)\n280|}\n281|\n282|// TestRealREADMECarriesNoPositiveClaim runs the gate over the real\n283|// advertisement surface with every probe forced unavailable — the strongest\n284|// posture: every backticked capability mention must already be classified\n285|// non-claim, or a future edit away from refusal.\n286|func TestRealREADMECarriesNoPositiveClaim(t *testing.T) {\n287|\tt.Parallel()\n288|\tfindings, err := CheckAdvertisements(readREADME(t), allUnavailable(t))\n289|\tif err != nil {\n290|\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n291|\t}\n292|\tif len(findings) != 0 {\n293|\t\tt.Fatalf(\"README findings = %v, want none\", findings)\n294|\t}\n295|}\n296|\n297|func TestRealREADMEAdmitsWhenAllAvailable(t *testing.T) {\n298|\tt.Parallel()\n299|\tids, err := CapabilityIDs()\n300|\tif err != nil {\n301|\t\tt.Fatalf(\"CapabilityIDs() error = %v\", err)\n302|\t}\n303|\tfindings, err := CheckAdvertisements(readREADME(t), availableStates(ids...))\n304|\tif err != nil {\n305|\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n306|\t}\n307|\tif len(findings) != 0 {\n308|\t\tt.Fatalf(\"README findings = %v, want none\", findings)\n309|\t}\n310|}\n311|\n312|// TestEveryNonClaimMarkerOccursInCorpus keeps the marker list honest: a\n313|// marker that fires on no real sentence is either dead weight or an admission\n314|// hole reserved for future text.\n315|func TestEveryNonClaimMarkerOccursInCorpus(t *testing.T) {\n316|\tt.Parallel()\n317|\tdocument := readREADME(t)\n318|\tids, err := CapabilityIDs()\n319|\tif err != nil {\n320|\t\tt.Fatalf(\"CapabilityIDs() error = %v\", err)\n321|\t}\n322|\tprobed := map[string]bool{}\n323|\tfor _, id := range ids {\n324|\t\tprobed[\"`\"+id+\"`\"] = true\n325|\t}\n326|\tvar mentioning []string\n327|\tfor _, part := range splitSentences(document) {\n328|\t\tfor token := range probed {\n329|\t\t\tif strings.Contains(part.text, token) {\n330|\t\t\t\tmentioning = append(mentioning, part.text)\n331|\t\t\t\tbreak\n332|\t\t\t}\n333|\t\t}\n334|\t}\n335|\tif len(mentioning) == 0 {\n336|\t\tt.Fatal(\"no corpus sentence mentions a probe ID; the marker census is vacuous\")\n337|\t}\n338|\tfor _, marker := range nonClaimMarkers {\n339|\t\tfound := false\n340|\t\tfor _, text := range mentioning {\n341|\t\t\tif wordMatches(marker, strings.ToLower(text)) {\n342|\t\t\t\tfound = true\n343|\t\t\t\tbreak\n344|\t\t\t}\n345|\t\t}\n346|\t\tif !found {\n347|\t\t\tt.Errorf(\"marker %q occurs in no probe-mentioning sentence; remove it or classify with it\", marker)\n348|\t\t}\n349|\t}\n350|}"}}}
