{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c43f","stream":{"kind":"session","id":"01a07b60-5dda-7951-9c64-98cc389b396d"},"sequence":122,"recorded_at":1780531400000239,"record_type":"event","durability":"durable","causation_id":"bd52028a-acb2-4196-94e2-c06d1bbe961a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bd52028a-acb2-4196-94e2-c06d1bbe961a","run_stream":{"kind":"run","id":"bd52028a-acb2-4196-94e2-c06d1bbe961a"},"task_stream":{"kind":"task","id":"22149999-63b4-4397-a27a-e5b42df6e0cb"},"task_id":"22149999-63b4-4397-a27a-e5b42df6e0cb","event":{"kind":"output","task_id":"22149999-63b4-4397-a27a-e5b42df6e0cb","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/.github/workflows/ci.yml`.\n(119 line(s) above)\n120|          test \"$(grep -c '^ok' test.log)\" -gt 0\n121|          test \"$(grep -c '^FAIL' test.log || true)\" -eq 0\n122|          {\n123|            echo \"## Suite skips\"\n124|            echo \"\"\n125|            echo \"Skipped: $(grep -c '^--- SKIP' test.log || true)\"\n126|            grep '^--- SKIP' test.log || echo \"none\"\n127|          } >> \"$GITHUB_STEP_SUMMARY\"\n128|\n129|  race:\n130|    name: Race detector\n131|    runs-on: ubuntu-latest\n132|    timeout-minutes: 15\n133|    steps:\n134|      - name: Check out repository\n135|        uses: actions/checkout@v7\n136|\n137|      - name: Set up Go\n138|        uses: actions/setup-go@v7\n139|        with:\n140|          go-version-file: go.mod\n141|\n142|      - name: Test with race detector\n143|        run: |\n144|          set +e\n145|          go test -race ./... -count=1 > race.log 2>&1\n146|          code=$?\n147|          set -e\n148|          cat race.log\n149|          test $code -eq 0\n150|          test \"$(grep -c '^ok' race.log)\" -gt 0\n151|\n152|  coverage:\n153|    name: Coverage numbers (reported, no floor)\n154|    runs-on: ubuntu-latest\n155|    timeout-minutes: 15\n156|    steps:\n157|      - name: Check out repository\n158|        uses: actions/checkout@v7\n159|\n160|      - name: Set up Go\n161|        uses: actions/setup-go@v7\n162|        with:\n163|          go-version-file: go.mod\n164|\n165|      # Coverage is a number, not a gate: this job reports per-package\n166|      # percentages and refuses only an unreadable or empty result.\n167|      - name: Test with coverage\n168|        run: |\n169|          set +e\n170|          go test ./... -cover -count=1 > cover.log 2>&1\n171|          code=$?\n172|          set -e\n173|          cat cover.log\n174|          test $code -eq 0\n175|          test \"$(grep -c 'coverage: ' cover.log)\" -gt 0\n176|          {\n177|            echo \"## Coverage\"\n178|            echo \"\"\n179|            echo \"| Package | Coverage |\"\n180|            echo \"| --- | --- |\"\n181|            grep 'coverage: ' cover.log | sed -E 's/^(ok|---)[[:space:]]+([^[:space:]]+).*coverage: ([0-9.]+% of statements)/| `\\2` | \\3 |/' || true\n182|            echo \"\"\n183|            echo \"Packages without test files (stated bounds, not failures):\"\n184|            echo \"\"\n185|            grep 'no test files' cover.log || echo \"none\"\n186|          } >> \"$GITHUB_STEP_SUMMARY\"\n187|\n188|  fixture-matrix:\n189|    name: Conformance fixtures (${{ matrix.os }}, ${{ matrix.package }})\n190|    runs-on: ${{ matrix.os }}\n191|    timeout-minutes: 15\n192|    strategy:\n193|      fail-fast: false\n194|      matrix:\n195|        os: [ubuntu-latest, macos-latest]\n196|        package: [internal/secprim, internal/secconftest]\n197|    steps:\n198|      - name: Check out repository\n199|        uses: actions/checkout@v7\n200|\n201|      - name: Set up Go\n202|        uses: actions/setup-go@v7\n203|        with:\n204|          go-version-file: go.mod\n205|\n206|      # Verbose on purpose: the --- SKIP lines are the skip datum, and the\n207|      # secconftest capabilities line witnesses the probe counters after the\n208|      # whole suite. Skips are loud here by construction.\n209|      - name: Run fixture package\n210|        run: |\n211|          set +e\n212|          go test ./${{ matrix.package }} -count=1 -v > fixture.log 2>&1\n213|          code=$?\n214|          set -e\n215|          grep '^--- SKIP' fixture.log || echo \"no skipped tests\"\n216|          grep 'secconftest capabilities on' fixture.log || true\n217|          {\n218|            echo \"## Fixture run ${{ matrix.os }} ${{ matrix.package }}\"\n219|            echo \"\"\n220|            echo \"Skipped: $(grep -c '^--- SKIP' fixture.log || true)\"\n221|          } >> \"$GITHUB_STEP_SUMMARY\"\n222|          test $code -eq 0\n223|          test \"$(grep -c '^--- PASS' fixture.log)\" -gt 0\n224|\n225|  fuzz-smoke:\n226|    name: Fuzz smoke (derived targets)\n227|    runs-on: ubuntu-latest\n228|    timeout-minutes: 15\n229|    steps:\n230|      - name: Check out repository\n231|        uses: actions/checkout@v7\n232|\n233|      - name: Set up Go\n234|        uses: actions/setup-go@v7\n235|        with:\n236|          go-version-file: go.mod\n237|\n238|      # Targets are derived per package from the compiled test binaries,\n239|      # never retyped: only names starting with Fuzz are fuzz targets. An\n240|      # empty derivation fails the grep and the explicit size check alike,\n241|      # and the total count is pinned: a new fuzz target without a CI\n242|      # update reddens here instead of going unsmoked.\n243|      - name: Derive fuzz targets\n244|        run: |\n245|          rm -f fuzz-targets.clean\n246|          for pkg in internal/secconftest internal/canonicaljson internal/scalar; do\n247|            go test \"./${pkg}\" -list '^Fuzz' > \"fuzz-targets-$(basename \"${pkg}\").log\" 2>&1\n248|            grep '^Fuzz' \"fuzz-targets-$(basename \"${pkg}\").log\" | sed \"s|^|${pkg} |\" >> fuzz-targets.clean\n249|          done\n250|          test -s fuzz-targets.clean\n251|          test \"$(wc -l < fuzz-targets.clean | tr -d ' ')\" -eq 13\n252|          cat fuzz-targets.clean\n253|\n254|      # The secconftest leg of that list must equal the cigate.FuzzTargets\n255|      # derivation, which maps each target to the production entry it\n256|      # drives. Either side drifting — a target without an entry, or an\n257|      # entry without a target — fails the diff before any smoke runs.\n258|      - name: Check secconftest list matches the target derivation\n259|        run: |\n260|          set +e\n261|          go test ./internal/cigate -run 'TestListedTargetsMatchDerivation|TestFuzzTargetsAreDerivedSorted' -count=1 -v > cigate-targets.log 2>&1\n262|          code=$?\n263|          set -e\n264|          cat cigate-targets.log\n265|          test $code -eq 0\n266|          for gate in TestListedTargetsMatchDerivation TestFuzzTargetsAreDerivedSorted; do\n267|            grep -q \"^--- PASS: ${gate}\" cigate-targets.log\n268|          done\n269|\n270|      # A -fuzz selector that matches nothing exits 0 with \"no fuzz tests\n271|      # to fuzz\", so exit status alone cannot prove execution. The\n272|      # '^fuzz: elapsed' line proves the engine ran; its absence fails.\n273|      - name: Smoke each target\n274|        run: |\n275|          while read -r pkg target; do\n276|            go test \"./${pkg}\" -run='^$' -fuzz=\"^${target}$\" -fuzztime=100x -parallel=1 -count=1 > \"fuzz-$(basename \"${pkg}\")-${target}.log\" 2>&1\n277|            grep -q '^fuzz: elapsed' \"fuzz-$(basename \"${pkg}\")-${target}.log\"\n278|          done < fuzz-targets.clean\n279|\n280|  capability-claims:\n281|    name: Unsupported-capability claim check\n282|    runs-on: ubuntu-latest\n283|    timeout-minutes: 10\n284|    steps:\n285|      - name: Check out repository\n286|        uses: actions/checkout@v7\n287|\n288|      - name: Set up Go\n289|        uses: actions/setup-go@v7\n290|        with:\n291|          go-version-file: go.mod\n292|\n293|      # The vocabulary is secconftest's probe set; the gate scans the README\n294|      # with every probe forced unavailable — the strongest posture, and\n295|      # host-independent: a backticked capability mention that reads as a\n296|      # positive availability claim is refused no matter what this host's\n297|      # probes would report. Live probe outcomes are never read here;\n298|      # ProbeState.Available is consumed by no call site. README prose is\n299|      # never capability evidence either way.\n300|      - name: Check README with all probes forced unavailable\n301|        run: |\n302|          set +e\n303|          go test ./internal/cigate -run 'TestRealREADMECarriesNoPositiveClaim|TestRealREADMEAdmitsWhenAllAvailable|TestCapabilityIDsAreDerivedSorted|TestPositiveClaimsAreRefused|TestNegatedClaimsAreAdmitted|TestUnclassifiedMentionIsRefused' -count=1 -v > cigate-claims.log 2>&1\n304|          code=$?\n305|          set -e\n306|          cat cigate-claims.log\n307|          test $code -eq 0\n308|          for gate in TestRealREADMECarriesNoPositiveClaim TestRealREADMEAdmitsWhenAllAvailable TestCapabilityIDsAreDerivedSorted TestPositiveClaimsAreRefused TestNegatedClaimsAreAdmitted TestUnclassifiedMentionIsRefused; do\n309|            grep -q \"^--- PASS: ${gate}\" cigate-claims.log\n310|          done\n311|\n312|  windows-compile-only:\n313|    name: Windows compile-only (no execution implied)\n314|    runs-on: ubuntu-latest\n315|    timeout-minutes: 10\n316|    steps:\n317|      - name: Check out repository\n318|        uses: actions/checkout@v7\n319|\n320|      - name: Set up Go\n321|        uses: actions/setup-go@v7\n322|        with:\n323|          go-version-file: go.mod\n324|\n325|      # Compile-and-vet only: go vet type-checks test files as well, and no\n326|      # step here executes a Windows binary. A green here must never be read\n327|      # as behaviour executed on Windows.\n328|      - name: Compile for Windows\n329|        run: GOOS=windows go build ./...\n330|\n331|      - name: Vet Windows build (includes test files)\n332|        run: GOOS=windows go vet ./...\n333|\n334|  gates-verdict:\n335|    name: All gates green, none skipped\n336|    runs-on: ubuntu-latest\n337|    timeout-minutes: 5\n338|    needs:\n339|      - contract-preservation\n340|      - lint\n341|      - test\n342|      - race\n343|      - coverage\n344|      - fixture-matrix\n345|      - fuzz-smoke\n346|      - capability-claims\n347|      - windows-compile-only\n348|    if: always()\n349|    steps:\n350|      - name: Refuse any non-success dependency\n351|        run: |\n352|          echo '${{ toJSON(needs) }}' > needs.json\n353|          jq . needs.json\n354|          jq -e 'to_entries | map(select(.value.result != \"success\")) | length == 0' needs.json"}}}
