{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d0b9","stream":{"kind":"session","id":"01a07b60-5dda-7951-9c64-98cc389b396d"},"sequence":1719,"recorded_at":1780531400003433,"record_type":"event","durability":"durable","causation_id":"bd52028a-acb2-4196-94e2-c06d1bbe961a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bd52028a-acb2-4196-94e2-c06d1bbe961a","run_stream":{"kind":"run","id":"bd52028a-acb2-4196-94e2-c06d1bbe961a"},"task_stream":{"kind":"task","id":"3c01a9a5-0794-4a80-aa7d-a4137dae5842"},"task_id":"3c01a9a5-0794-4a80-aa7d-a4137dae5842","event":{"kind":"output","task_id":"3c01a9a5-0794-4a80-aa7d-a4137dae5842","chunk":"edited\nchanged lines: lines 38-41\n--- original\n+++ updated\n@@\n-      - name: Verify generated catalog is current\n-        run: |\n-          go generate ./internal/catalog\n-          git diff --exit-code -- internal/catalog/catalog_gen.go\n+      # The diff proves the committed catalog matches generator output, but\n+      # `go generate` runs nothing when its directive is disarmed: rewriting\n+      # `//go:generate` as `// go:generate` preserves the token while turning\n+      # the directive into a plain comment, so generation is skipped and the\n+      # diff stays clean. The anchored check refuses that token-preserving\n+      # rewrite; only the exact directive form counts. A new directive\n+      # without a pin update reddens here (and in\n+      # TestGenerateDirectiveStaysRecognizedForm) instead of going unchecked.\n+      - name: Verify generated catalog is current\n+        run: |\n+          test \"$(grep -c '^//go:generate' internal/catalog/catalog.go)\" -eq 1\n+          go generate ./internal/catalog\n+          git diff --exit-code -- internal/catalog/catalog_gen.go\n"}}}
