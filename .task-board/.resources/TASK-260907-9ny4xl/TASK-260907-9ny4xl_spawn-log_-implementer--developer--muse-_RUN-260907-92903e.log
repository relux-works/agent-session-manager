{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca15","stream":{"kind":"session","id":"01a07b60-5dda-7951-9c64-98cc389b396d"},"sequence":869,"recorded_at":1780531400001733,"record_type":"event","durability":"durable","causation_id":"bd52028a-acb2-4196-94e2-c06d1bbe961a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bd52028a-acb2-4196-94e2-c06d1bbe961a","run_stream":{"kind":"run","id":"bd52028a-acb2-4196-94e2-c06d1bbe961a"},"task_stream":{"kind":"task","id":"920b02a8-549b-4deb-b55e-bf5ec9a66db0"},"task_id":"920b02a8-549b-4deb-b55e-bf5ec9a66db0","event":{"kind":"output","task_id":"920b02a8-549b-4deb-b55e-bf5ec9a66db0","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/cigate/contracts_test.go`.\n1|package cigate\n2|\n3|import (\n4|\t\"strings\"\n5|\t\"testing\"\n6|)\n7|\n8|func TestPinnedReleasesAgreeAcrossAuthorities(t *testing.T) {\n9|\tt.Parallel()\n10|\treleases, err := PinnedReleases()\n11|\tif err != nil {\n12|\t\tt.Fatalf(\"PinnedReleases() error = %v\", err)\n13|\t}\n14|\tif len(releases) != 2 {\n15|\t\tt.Fatalf(\"PinnedReleases() = %v, want the current and historical roots\", releases)\n16|\t}\n17|\tif releases[0] == releases[1] {\n18|\t\tt.Fatalf(\"PinnedReleases() roots are indistinct: %v\", releases)\n19|\t}\n20|}\n21|\n22|func TestCheckReleaseRootsRefusesDrift(t *testing.T) {\n23|\tt.Parallel()\n24|\tif _, err := checkReleaseRoots(\"v0.5.0\", \"v0.4.3\", \"v0.5.0\", \"v0.4.3\"); err != nil {\n25|\t\tt.Fatalf(\"agreeing roots refused: %v\", err)\n26|\t}\n27|\tfor _, roots := range [][4]string{\n28|\t\t{\"v0.5.0\", \"v0.4.3\", \"v0.5.1\", \"v0.4.3\"},\n29|\t\t{\"v0.5.0\", \"v0.4.3\", \"v0.5.0\", \"v0.4.4\"},\n30|\t\t{\"\", \"v0.4.3\", \"\", \"v0.4.3\"},\n31|\t\t{\"v0.5.0\", \"v0.5.0\", \"v0.5.0\", \"v0.5.0\"},\n32|\t} {\n33|\t\tif _, err := checkReleaseRoots(roots[0], roots[1], roots[2], roots[3]); err == nil {\n34|\t\t\tt.Errorf(\"checkReleaseRoots(%q) admitted drift\", roots)\n35|\t\t}\n36|\t}\n37|}\n38|\n39|func TestVerifyContractPreservationLive(t *testing.T) {\n40|\tt.Parallel()\n41|\tif err := VerifyContractPreservation(); err != nil {\n42|\t\tt.Fatalf(\"VerifyContractPreservation() error = %v\", err)\n43|\t}\n44|}\n45|\n46|// TestDerivedSetsAreComplete pins the derivation shape without retyping any\n47|// version: every release both authorities know carries a non-empty contract\n48|// set, and every contract carries an identity and at least one version.\n49|func TestDerivedSetsAreComplete(t *testing.T) {\n50|\tt.Parallel()\n51|\tpinned, err := PinContractSets()\n52|\tif err != nil {\n53|\t\tt.Fatalf(\"PinContractSets() error = %v\", err)\n54|\t}\n55|\tprojected, err := CatalogContractSets()\n56|\tif err != nil {\n57|\t\tt.Fatalf(\"CatalogContractSets() error = %v\", err)\n58|\t}\n59|\treleases, err := PinnedReleases()\n60|\tif err != nil {\n61|\t\tt.Fatalf(\"PinnedReleases() error = %v\", err)\n62|\t}\n63|\tfor _, release := range releases {\n64|\t\tfor authority, sets := range map[string]map[string][]ContractVersions{\n65|\t\t\t\"pin\": pinned, \"catalog\": projected,\n66|\t\t} {\n67|\t\t\tcontracts, ok := sets[release]\n68|\t\t\tif !ok || len(contracts) == 0 {\n69|\t\t\t\tt.Fatalf(\"%s authority accounts for no %s contracts\", authority, release)\n70|\t\t\t}\n71|\t\t\tfor _, contract := range contracts {\n72|\t\t\t\tif contract.Name == \"\" || contract.ID == \"\" || len(contract.Versions) == 0 {\n73|\t\t\t\t\tt.Errorf(\"%s %s contract %+v is incomplete\", authority, release, contract)\n74|\t\t\t\t}\n75|\t\t\t}\n76|\t\t}\n77|\t}\n78|}\n79|\n80|// syntheticSets builds agreeing sets keyed by the live release roots, so the\n81|// fixture follows a deliberate root change instead of masking it.\n82|func syntheticSets(t *testing.T) (current, historical string, pinned, projected map[string][]ContractVersions) {\n83|\tt.Helper()\n84|\treleases, err := PinnedReleases()\n85|\tif err != nil {\n86|\t\tt.Fatalf(\"PinnedReleases() error = %v\", err)\n87|\t}\n88|\tcurrent, historical = releases[0], releases[1]\n89|\tpinned = map[string][]ContractVersions{\n90|\t\tcurrent: {\n91|\t\t\t{Name: \"Session Record\", ID: \"urn:ax:schema:session\", Versions: []string{\"1.0.0\", \"2.0.0\"}},\n92|\t\t\t{Name: \"Mesh RPC\", ID: \"urn:ax:protocol:rpc\", Versions: []string{\"2.0.0\"}},\n93|\t\t},\n94|\t\thistorical: {\n95|\t\t\t{Name: \"Mesh RPC\", ID: \"urn:ax:protocol:rpc\", Versions: []string{\"2.0.0\"}},\n96|\t\t},\n97|\t}\n98|\tprojected = map[string][]ContractVersions{\n99|\t\tcurrent: {\n100|\t\t\t{Name: \"Session Record\", ID: \"urn:ax:schema:session\", Versions: []string{\"1.0.0\", \"2.0.0\"}},\n101|\t\t\t{Name: \"Mesh RPC\", ID: \"urn:ax:protocol:rpc\", Versions: []string{\"2.0.0\"}},\n102|\t\t},\n103|\t\thistorical: {\n104|\t\t\t{Name: \"Mesh RPC\", ID: \"urn:ax:protocol:rpc\", Versions: []string{\"2.0.0\"}},\n105|\t\t},\n106|\t}\n107|\treturn current, historical, pinned, projected\n108|}\n109|\n110|// TestCheckAgreementAdmitsIdenticalSets is the positive arm every refusal row\n111|// below mirrors: the gate must admit exact agreement, or the refusals prove\n112|// nothing.\n113|func TestCheckAgreementAdmitsIdenticalSets(t *testing.T) {\n114|\tt.Parallel()\n115|\t_, _, pinned, projected := syntheticSets(t)\n116|\tif err := checkAgreement(pinned, projected); err != nil {\n117|\t\tt.Fatalf(\"checkAgreement() error = %v\", err)\n118|\t}\n119|}\n120|\n121|func TestCheckAgreementRefusals(t *testing.T) {\n122|\tt.Parallel()\n123|\tcases := []struct {\n124|\t\tname   string\n125|\t\tmutate func(current, historical string, pinned, projected map[string][]ContractVersions)\n126|\t\twant   func(current, historical string) string\n127|\t}{\n128|\t\t{\n129|\t\t\tname: \"contract missing from catalog\",\n130|\t\t\tmutate: func(current, _ string, _, projected map[string][]ContractVersions) {\n131|\t\t\t\tprojected[current] = projected[current][:1]\n132|\t\t\t},\n133|\t\t\twant: func(_, _ string) string { return \"absent from the catalog\" },\n134|\t\t},\n135|\t\t{\n136|\t\t\tname: \"contract unaccounted by pin\",\n137|\t\t\tmutate: func(current, _ string, pinned, _ map[string][]ContractVersions) {\n138|\t\t\t\tpinned[current] = pinned[current][:1]\n139|\t\t\t},\n140|\t\t\twant: func(_, _ string) string { return \"no pin accounts for it\" },\n141|\t\t},\n142|\t\t{\n143|\t\t\t// NARROWING row: the catalog admits exactly one version fewer.\n144|\t\t\t// A gate that compared only contract presence would admit this.\n145|\t\t\tname: \"single version dropped\",\n146|\t\t\tmutate: func(current, _ string, _, projected map[string][]ContractVersions) {\n147|\t\t\t\tprojected[current][0].Versions = []string{\"1.0.0\"}\n148|\t\t\t},\n149|\t\t\twant: func(_, _ string) string { return \"pins 2 versions, catalog carries 1\" },\n150|\t\t},\n151|\t\t{\n152|\t\t\tname: \"single version added\",\n153|\t\t\tmutate: func(current, _ string, _, projected map[string][]ContractVersions) {\n154|\t\t\t\tprojected[current][1].Versions = []string{\"2.0.0\", \"3.0.0\"}\n155|\t\t\t},\n156|\t\t\twant: func(_, _ string) string { return \"pins 1 versions, catalog carries 2\" },\n157|\t\t},\n158|\t\t{\n159|\t\t\t// NARROWING row: same versions, different order. A gate that\n160|\t\t\t// compared version sets without order would admit this, and\n161|\t\t\t// version order selects the negotiated baseline.\n162|\t\t\tname: \"version order changed\",\n163|\t\t\tmutate: func(current, _ string, _, projected map[string][]ContractVersions) {\n164|\t\t\t\tprojected[current][0].Versions = []string{\"2.0.0\", \"1.0.0\"}\n165|\t\t\t},\n166|\t\t\twant: func(_, _ string) string { return `version 0 is pinned \"1.0.0\", catalog carries \"2.0.0\"` },\n167|\t\t},\n168|\t\t{\n169|\t\t\tname: \"release missing from catalog\",\n170|\t\t\tmutate: func(_, historical string, _, projected map[string][]ContractVersions) {\n171|\t\t\t\tdelete(projected, historical)\n172|\t\t\t},\n173|\t\t\twant: func(_, historical string) string { return \"accounts for no \" + historical + \" set\" },\n174|\t\t},\n175|\t\t{\n176|\t\t\tname: \"release missing from pin\",\n177|\t\t\tmutate: func(_, historical string, pinned, _ map[string][]ContractVersions) {\n178|\t\t\t\tdelete(pinned, historical)\n179|\t\t\t},\n180|\t\t\twant: func(_, historical string) string { return \"accounts for no \" + historical + \" set\" },\n181|\t\t},\n182|\t}\n183|\tfor _, kase := range cases {\n184|\t\tt.Run(kase.name, func(t *testing.T) {\n185|\t\t\tt.Parallel()\n186|\t\t\tcurrent, historical, pinned, projected := syntheticSets(t)\n187|\t\t\tkase.mutate(current, historical, pinned, projected)\n188|\t\t\terr := checkAgreement(pinned, projected)\n189|\t\t\tif err == nil {\n190|\t\t\t\tt.Fatalf(\"checkAgreement() admitted %s\", kase.name)\n191|\t\t\t}\n192|\t\t\twant := kase.want(current, historical)\n193|\t\t\tif !strings.Contains(err.Error(), want) {\n194|\t\t\t\tt.Fatalf(\"checkAgreement() error = %q, want substring %q\", err, want)\n195|\t\t\t}\n196|\t\t})\n197|\t}\n198|}"}}}
