ition in the sentence, so re-ordering the clause does not silently\\n// re-point a pin at a different number.\\ntype publishedFigure struct {\\n\\tphrase  string\\n\\tmeasure func(Report) int\\n}\\n\\n// publishedOwnershipFigures enumerates every figure the paragraph states. The\\n// unpinned-figure guard below turns a deletion from this list into a red rather\\n// than into a quietly smaller comparison, so the list is measured, not trusted.\\nvar publishedOwnershipFigures = []publishedFigure{\\n\\t{\\\"current contract rows\\\", func(report Report) int { return report.Contracts }},\\n\\t{\\\"pinned or catalog-referenced normative section keys\\\", func(report Report) int { return report.NormativeSections }},\\n\\t{\\\"executable acceptance cases\\\", func(report Report) int { return report.AcceptanceCases }},\\n\\t{\\\"exact section bindings\\\", func(report Report) int { return report.SectionBindings }},\\n\\t{\\\"disclosed unowned sections\\\", func(report Report) int { return report.UnownedSections }},\\n\\t{\\\"exact fixture identities\\\", func(report Report) int { return report.Fixtures }},\\n\\t{\\\"-contract subset\\\", func(report Report) int { return report.CompatibilityContracts }},\\n}\\n\\n// ownershipParagraph returns the paragraph under the anchor, unwrapped onto one\\n// line, together with the README line it starts at. It refuses a target it\\n// cannot locate rather than skipping the comparison: a paragraph that silently\\n// fell out of the measurement is exactly how the acceptance-case figure below\\n// drifted from 73 to 74 without anything reddening.\\nfunc ownershipParagraph(t *testing.T) (string, int) {\\n\\tt.Helper()\\n\\n\\treadme, err := os.ReadFile(filepath.Join(\\\"..\\\", \\\"..\\\", \\\"README.md\\\"))\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"read README.md: %v\\\", err)\\n\\t}\\n\\tlines := strings.Split(string(readme), \\\"\\\\n\\\")\\n\\tanchor := -1\\n\\tfor index, line := range lines {\\n\\t\\tif strings.TrimSpace(line) == ownershipParagraphAnchor {\\n\\t\\t\\tif anchor >= 0 {\\n\\t\\t\\t\\tt.Fatalf(\\\"README carries the heading %q twice, at lines %d and %d; the paragraph this test measures is ambiguous\\\",\\n\\t\\t\\t\\t\\townershipParagraphAnchor, anchor+1, index+1)\\n\\t\\t\\t}\\n\\t\\t\\tanchor = index\\n\\t\\t}\\n\\t}\\n\\tif anchor < 0 {\\n\\t\\tt.Fatalf(\\\"README no longer carries the heading %q\\\", ownershipParagraphAnchor)\\n\\t}\\n\\tstart := anchor + 1\\n\\tfor start < len(lines) && strings.TrimSpace(lines[start]) == \\\"\\\" {\\n\\t\\tstart++\\n\\t}\\n\\tvar body []string\\n\\tfor index := start; index < len(lines); index++ {\\n\\t\\ttext := strings.TrimSpace(lines[index])\\n\\t\\tif text == \\\"\\\" {\\n\\t\\t\\tbreak\\n\\t\\t}\\n\\t\\tbody = append(body, text)\\n\\t}\\n\\tif len(body) == 0 {\\n\\t\\tt.Fatalf(\\\"README carries no paragraph under %q\\\", ownershipParagraphAnchor)\\n=====\\ninternal/canonicaljson/session_record_versions_test.go-591-\\tpackageDirectory := filepath.Dir(source)\\ninternal/canonicaljson/session_record_versions_test.go-592-\\trows := readConstraintRows(t, filepath.Join(packageDirectory, \\\"testdata\\\", \\\"constraint-enumeration.md\\\"))\\ninternal/canonicaljson/session_record_versions_test.go-593-\\ninternal/canonicaljson/session_record_versions_test.go:594:\\treadme, err := os.ReadFile(filepath.Join(packageDirectory, \\\"..\\\", \\\"..\\\", \\\"README.md\\\"))\\ninternal/canonicaljson/session_record_versions_test.go-595-\\tif err != nil {\\ninternal/canonicaljson/session_record_versions_test.go-596-\\t\\tt.Fatal(err)\\ninternal/canonicaljson/session_record_versions_test.go-597-\\t}\\ninternal/canonicaljson/session_record_versions_test.go-598-\\tfor _, claim := range []string{\\ninternal/canonicaljson/session_record_versions_test.go-599-\\t\\t\\\"Section 2.1 ASCII name grammar\\\",\\ninternal/canonicaljson/session_record_versions_test.go-600-\\t\\t\\\"declared environment-ID grammar\\\",\\ninternal/canonicaljson/session_record_versions_test.go-601-\\t\\t\\\"Section 1.6 reverse-DNS\\\",\\ninternal/canonicaljson/session_record_versions_test.go-602-\\t} {\\ninternal/canonicaljson/session_record_versions_test.go-603-\\t\\tif !bytes.Contains(readme, []byte(claim)) {\\ninternal/canonicaljson/session_record_versions_test.go:604:\\t\\t\\tt.Fatalf(\\\"README no longer declares Session Record grammar claim %q\\\", claim)\\ninternal/canonicaljson/session_record_versions_test.go-605-\\t\\t}\\ninternal/canonicaljson/session_record_versions_test.go-606-\\t}\\ninternal/canonicaljson/session_record_versions_test.go-607-\\ninternal/canonicaljson/session_record_versions_test.go-608-\\tmatched, familyCounts, failures := resolveSessionRecordGrammarRows(rows)\\ninternal/canonicaljson/session_record_versions_test.go-609-\\tif len(failures) != 0 {\\ninternal/canonicaljson/session_record_versions_test.go-610-\\t\\tt.Fatalf(\\\"pinned Session Record grammar row set does not match the constraint enumeration:\\\\n%s\\\",\\ninternal/canonicaljson/session_record_versions_test.go-611-\\t\\t\\tstrings.Join(failures, \\\"\\\\n\\\"))\\ninternal/canonicaljson/session_record_versions_test.go-612-\\t}\\ninternal/canonicaljson/session_record_versions_test.go-613-\\tfor _, family := range sortedGrammarFamilies() {\\ninternal/canonicaljson/session_record_versions_test.go-614-\\t\\tif got, want := familyCounts[family], sessionRecordGrammarFamilyCounts[family]; got != want {\\n--\\ninternal/cliresult/guard_inventory_test.go-17-// file the inventory below is derived from exhaustively.\\ninternal/cliresult/guard_inventory_test.go-18-const readerSourceFile = \\\"client.go\\\"\\ninternal/cliresult/guard_inventory_test.go-19-\\ninternal/cliresult/guard_inventory_test.go:20:// guardInventoryAnchor is the README heading whose two tables this test pins. It\\ninternal/cliresult/guard_inventory_test.go-21-// is matched exactly, so renaming the heading reddens here instead of silently\\ninternal/cliresult/guard_inventory_test.go-22-// exempting the inventory from measurement.\\ninternal/cliresult/guard_inventory_test.go-23-const guardInventoryAnchor = \\\"### Refusal guard inventory\\\"\\ninternal/cliresult/guard_inventory_test.go-24-\\ninternal/cliresult/guard_inventory_test.go-25-// evidenceClasses is the closed vocabulary a row's domain-evidence cell must\\ninternal/cliresult/guard_inventory_test.go-26-// open with. A cell that opened with anything else would be prose again.\\ninternal/cliresult/guard_inventory_test.go-27-var evidenceClasses = []string{\\\"measured\\\", \\\"stated bound\\\", \\\"declared subsumed\\\"}\\ninternal/cliresult/guard_inventory_test.go-28-\\ninternal/cliresult/guard_inventory_test.go-29-// refusalSite is one place the reader refuses, derived from the source rather\\ninternal/cliresult/guard_inventory_test.go-30-// than named by hand: an fmt.Errorf call wrapping one of this package's\\n--\\ninternal/cliresult/guard_inventory_test.go-121-\\t}\\ninternal/cliresult/guard_inventory_test.go-122-}\\ninternal/cliresult/guard_inventory_test.go-123-\\ninternal/cliresult/guard_inventory_test.go:124:// inventoryRow is one row of the README's derived table.\\ninternal/cliresult/guard_inventory_test.go-125-type inventoryRow struct {\\ninternal/cliresult/guard_inventory_test.go-126-\\tnumber   string\\ninternal/cliresult/guard_inventory_test.go-127-\\tguard    string\\ninternal/cliresult/guard_inventory_test.go-128-\\tsentinel string\\ninternal/cliresult/guard_inventory_test.go-129-\\tmarker   string\\ninternal/cliresult/guard_inventory_test.go-130-\\tevidence string\\ninternal/cliresult/guard_inventory_test.go-131-\\ttests    []string\\ninternal/cliresult/guard_inventory_test.go-132-\\tline     int\\ninternal/cliresult/guard_inventory_test.go-133-}\\ninternal/cliresult/guard_inventory_test.go-134-\\ninternal/cliresult/guard_inventory_test.go:135:// siblingRow is one row of the README's enumerated table of guards this leaf\\ninternal/cliresult/guard_inventory_test.go-136-// added or reordered outside the reader source.\\ninternal/cliresult/guard_inventory_test.go-137-type siblingRow struct {\\ninternal/cliresult/guard_inventory_test.go-138-\\tguard    string\\ninternal/cliresult/guard_inventory_test.go-139-\\tfile     string\\ninternal/cliresult/guard_inventory_test.go-140-\\tfunction string\\n\",\n  \"original_output_bytes\": 8299,\n  \"original_output_tokens\": 2075,\n  \"truncated\": false\n}"}}}
