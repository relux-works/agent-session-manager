{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c487","stream":{"kind":"session","id":"01a07b60-5dda-7951-9c64-98cc389b396d"},"sequence":158,"recorded_at":1780531400000311,"record_type":"event","durability":"durable","causation_id":"bd52028a-acb2-4196-94e2-c06d1bbe961a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"bd52028a-acb2-4196-94e2-c06d1bbe961a","run_stream":{"kind":"run","id":"bd52028a-acb2-4196-94e2-c06d1bbe961a"},"call_id":"call_01a07b609fc179f1ba71b3a9a147832c","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/cigate/claims.go`.\n1|package cigate\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"regexp\"\n6|\t\"sort\"\n7|\t\"strings\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/secconftest\"\n10|)\n11|\n12|// ProbeState is one platform-capability probe outcome. IDs always come from\n13|// secconftest.DefaultCapabilities; this package defines no capability of its\n14|// own.\n15|type ProbeState struct {\n16|\tID        string\n17|\tAvailable bool\n18|}\n19|\n20|// Finding is one refused advertisement mention: a backticked probe ID in a\n21|// sentence the gate cannot admit.\n22|type Finding struct {\n23|\tID     string\n24|\tLine   int\n25|\tText   string\n26|\tReason string\n27|}\n28|\n29|// positiveAvailability are the verb phrases that state a capability is\n30|// provided. Each is pinned by a dedicated claim row: dropping one admits the\n31|// matching claim silently.\n32|var positiveAvailability = []string{\n33|\t\"available\",\n34|\t\"supported\",\n35|\t\"enabled\",\n36|\t\"works\",\n37|\t\"passes\",\n38|}\n39|\n40|// negations flip a positive phrase into a non-claim. Each is pinned by a\n41|// dedicated row: dropping one refuses an honestly conditional sentence.\n42|var negations = []string{\n43|\t\"not\",\n44|\t\"never\",\n45|\t\"no\",\n46|\t\"without\",\n47|\t\"cannot\",\n48|\t\"can't\",\n49|\t\"n't\",\n50|\t\"unavailable\",\n51|\t\"disabled\",\n52|\t\"conditional\",\n53|\t\"pending\",\n54|\t\"unless\",\n55|\t\"only\",\n56|}\n57|\n58|// nonClaimMarkers are descriptive words showing a sentence documents the\n59|// instrument (probes, skips, gates, tests) rather than advertising a\n60|// capability. Every marker must occur in at least one scanned corpus sentence\n61|// (see TestEveryNonClaimMarkerOccursInCorpus): a marker that fires nowhere is\n62|// either dead weight or an admission hole waiting for future text.\n63|var nonClaimMarkers = []string{\n64|\t\"probes\",\n65|\t\"capability\",\n66|\t\"attempt\",\n67|\t\"gates\",\n68|\t\"test\",\n69|\t\"witness\",\n70|\t\"skip\",\n71|\t\"strict\",\n72|\t\"platform\",\n73|\t\"lstat\",\n74|\t\"mkfifo\",\n75|\t\"chmod\",\n76|\t\"uid\",\n77|\t\"pinned\",\n78|\t\"rejected\",\n79|\t\"fixture\",\n80|\t\"denial\",\n81|\t\"fail\",\n82|\t\"check\",\n83|\t\"scan\",\n84|}\n85|\n86|// wordPatterns precompiles every gate word once at init. The compiled set is\n87|// read-only afterwards, so parallel checks share it without a lock; a lazily\n88|// filled cache here would race under t.Parallel.\n89|var wordPatterns = func() map[string]*regexp.Regexp {\n90|\tpatterns := map[string]*regexp.Regexp{}\n91|\tfor _, word := range append(append(append([]string(nil), positiveAvailability...), negations...), nonClaimMarkers...) {\n92|\t\tpatterns[word] = regexp.MustCompile(`\\b` + regexp.QuoteMeta(word) + `\\b`)\n93|\t}\n94|\treturn patterns\n95|}()\n96|\n97|func wordMatches(word, text string) bool {\n98|\tpattern, ok := wordPatterns[word]\n99|\tif !ok {\n100|\t\treturn false\n101|\t}\n102|\treturn pattern.MatchString(text)\n103|}\n104|\n105|func containsAnyFold(words []string, text string) bool {\n106|\tlowered := strings.ToLower(text)\n107|\tfor _, word := range words {\n108|\t\tif wordMatches(word, lowered) {\n109|\t\t\treturn true\n110|\t\t}\n111|\t}\n112|\treturn false\n113|}\n114|\n115|// ProbeStates runs every secconftest capability probe on this host and\n116|// returns the outcomes. IDs are derived, never retyped; an empty derivation\n117|// is refused rather than treated as nothing to check.\n118|func ProbeStates() ([]ProbeState, error) {\n119|\tcapabilities := secconftest.DefaultCapabilities()\n120|\tif len(capabilities) == 0 {\n121|\t\treturn nil, fmt.Errorf(\"cigate: capability probe derivation is empty\")\n122|\t}\n123|\tstates := make([]ProbeState, 0, len(capabilities))\n124|\tfor _, capability := range capabilities {\n125|\t\tif capability.ID == \"\" || capability.Probe == nil {\n126|\t\t\treturn nil, fmt.Errorf(\"cigate: capability without identity or probe is unusable\")\n127|\t\t}\n128|\t\tavailable, _ := capability.Probe()\n129|\t\tstates = append(states, ProbeState{ID: capability.ID, Available: available})\n130|\t}\n131|\tsort.Slice(states, func(i, j int) bool { return states[i].ID < states[j].ID })\n132|\treturn states, nil\n133|}\n134|\n135|// CapabilityIDs derives the probe vocabulary: the sorted IDs of every\n136|// secconftest capability. It is the only vocabulary the advertisement check\n137|// may name.\n138|func CapabilityIDs() ([]string, error) {\n139|\tstates, err := ProbeStates()\n140|\tif err != nil {\n141|\t\treturn nil, err\n142|\t}\n143|\tids := make([]string, 0, len(states))\n144|\tfor _, state := range states {\n145|\t\tids = append(ids, state.ID)\n146|\t}\n147|\treturn ids, nil\n148|}\n149|\n150|// sentence is one classified unit with its 1-based starting line.\n151|type sentence struct {\n152|\ttext string\n153|\tline int\n154|}\n155|\n156|// splitSentences unwraps blank-line-separated blocks onto single lines and\n157|// splits them at sentence-terminal punctuation. Offsets are approximate by\n158|// construction; findings carry the starting line so a human can locate the\n159|// mention exactly.\n160|func splitSentences(document string) []sentence {\n161|\tvar sentences []sentence\n162|\tnormalized := strings.ReplaceAll(document, \"\\r\\n\", \"\\n\")\n163|\traw := strings.Split(normalized, \"\\n\")\n164|\tfor start := 0; start < len(raw); {\n165|\t\tif strings.TrimSpace(raw[start]) == \"\" {\n166|\t\t\tstart++\n167|\t\t\tcontinue\n168|\t\t}\n169|\t\tend := start\n170|\t\tfor end < len(raw) && strings.TrimSpace(raw[end]) != \"\" {\n171|\t\t\tend++\n172|\t\t}\n173|\t\tvar cleaned []string\n174|\t\tvar rows []int\n175|\t\tfor row := start; row < end; row++ {\n176|\t\t\ttrimmed := strings.TrimSpace(raw[row])\n177|\t\t\tif trimmed == \"\" {\n178|\t\t\t\tcontinue\n179|\t\t\t}\n180|\t\t\tcleaned = append(cleaned, trimmed)\n181|\t\t\trows = append(rows, row+1)\n182|\t\t}\n183|\t\tstart = end\n184|\t\tif len(cleaned) == 0 {\n185|\t\t\tcontinue\n186|\t\t}\n187|\t\tjoined := strings.Join(cleaned, \" \")\n188|\t\tlineOf := make([]int, len(joined))\n189|\t\toffset := 0\n190|\t\tfor index, line := range cleaned {\n191|\t\t\tfor range line {\n192|\t\t\t\tif offset < len(lineOf) {\n193|\t\t\t\t\tlineOf[offset] = rows[index]\n194|\t\t\t\t}\n195|\t\t\t\toffset++\n196|\t\t\t}\n197|\t\t\tif offset < len(lineOf) {\n198|\t\t\t\tlineOf[offset] = rows[index]\n199|\t\t\t\toffset++\n200|\t\t\t}\n201|\t\t}\n202|\t\tstart := 0\n203|\t\tfor index := 0; index < len(joined); index++ {\n204|\t\t\tend := index == len(joined)-1\n205|\t\t\tboundary := end ||\n206|\t\t\t\t((joined[index] == '.' || joined[index] == '!' || joined[index] == '?') &&\n207|\t\t\t\t\t(index+1 >= len(joined) || joined[index+1] == ' ' || joined[index+1] == '\\t'))\n208|\t\t\tif !boundary {\n209|\t\t\t\tcontinue\n210|\t\t\t}\n211|\t\t\ttext := strings.TrimSpace(joined[start : index+1])\n212|\t\t\tif text != \"\" {\n213|\t\t\t\tsentences = append(sentences, sentence{text: text, line: lineOf[start]})\n214|\t\t\t}\n215|\t\t\tstart = index + 1\n216|\t\t}\n217|\t}\n218|\treturn sentences\n219|}\n220|\n221|// CheckAdvertisements refuses every sentence that advertises a capability the\n222|// probes report unavailable. An empty probe set or an empty document is\n223|// refused outright: a gate that finds nothing to check, or nothing to check\n224|// against, passes on an empty result set, which is the defect class this\n225|// story removes.\n226|func CheckAdvertisements(document string, states []ProbeState) ([]Finding, error) {\n227|\tif len(states) == 0 {\n228|\t\treturn nil, fmt.Errorf(\"cigate: no probe outcomes to check advertisements against\")\n229|\t}\n230|\tif strings.TrimSpace(document) == \"\" {\n231|\t\treturn nil, fmt.Errorf(\"cigate: empty document proves no advertisement claim\")\n232|\t}\n233|\tavailability := make(map[string]bool, len(states))\n234|\tfor _, state := range states {\n235|\t\tavailability[state.ID] = state.Available\n236|\t}\n237|\tvar findings []Finding\n238|\tfor _, part := range splitSentences(document) {\n239|\t\tvar mentioned []string\n240|\t\tfor id := range availability {\n241|\t\t\tif strings.Contains(part.text, \"`\"+id+\"`\") {\n242|\t\t\t\tmentioned = append(mentioned, id)\n243|\t\t\t}\n244|\t\t}\n245|\t\tif len(mentioned) == 0 {\n246|\t\t\tcontinue\n247|\t\t}\n248|\t\tsort.Strings(mentioned)\n249|\t\tvar unavailable []string\n250|\t\tfor _, id := range mentioned {\n251|\t\t\tif !availability[id] {\n252|\t\t\t\tunavailable = append(unavailable, id)\n253|\t\t\t}\n254|\t\t}\n255|\t\tif len(unavailable) == 0 {\n256|\t\t\tcontinue\n257|\t\t}\n258|\t\tif containsAnyFold(positiveAvailability, part.text) &&\n259|\t\t\t!containsAnyFold(negations, part.text) {\n260|\t\t\tfor _, id := range unavailable {\n261|\t\t\t\tfindings = append(findings, Finding{\n262|\t\t\t\t\tID:     id,\n263|\t\t\t\t\tLine:   part.line,\n264|\t\t\t\t\tText:   part.text,\n265|\t\t\t\t\tReason: \"positive availability claim for an unavailable capability\",\n266|\t\t\t\t})\n267|\t\t\t}\n268|\t\t\tcontinue\n269|\t\t}\n270|\t\tif !containsAnyFold(append(append([]string(nil), negations...), nonClaimMarkers...), part.text) {\n271|\t\t\tfor _, id := range unavailable {\n272|\t\t\t\tfindings = append(findings, Finding{\n273|\t\t\t\t\tID:     id,\n274|\t\t\t\t\tLine:   part.line,\n275|\t\t\t\t\tText:   part.text,\n276|\t\t\t\t\tReason: \"unclassified mention of an unavailable capability\",\n277|\t\t\t\t})\n278|\t\t\t}\n279|\t\t}\n280|\t}\n281|\treturn findings, nil\n282|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c489","stream":{"kind":"session","id":"01a07b60-5dda-7951-9c64-98cc389b396d"},"sequence":159,"recorded_at":1780531400000313,"record_type":"event","durability":"durable","causation_id":"bd52028a-acb2-4196-94e2-c06d1bbe961a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"bd52028a-acb2-4196-94e2-c06d1bbe961a","run_stream":{"kind":"run","id":"bd52028a-acb2-4196-94e2-c06d1bbe961a"},"call_id":"call_01a07b60a0f67a63b3c36ff1e029aef3","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/cigate/doc.go`.\n1|// Package cigate implements the M0 continuous-conformance CI gates for the\n2|// security-primitives-and-conformance-ci story: historical and current\n3|// contract preservation, fixture-target derivation, and the\n4|// unsupported-capability advertisement check.\n5|//\n6|// It is a gate, not a second authority. Every behavior it constrains is\n7|// decided by an existing owner; this package only re-derives those decisions\n8|// from their owners and refuses drift:\n9|//\n10|//   - pinned contract versions stay in internal/specpin; the typed release\n11|//     projections stay in internal/catalog. VerifyContractPreservation\n12|//     requires the two authorities to agree exactly and fails closed on a\n13|//     version either side cannot account for;\n14|//   - platform capability availability stays in internal/secconftest probes.\n15|//     CheckAdvertisements takes probe outcomes as input and never defines a\n16|//     capability of its own. CI scans with every probe forced unavailable,\n17|//     which is stronger than live scanning and host-independent; live probe\n18|//     outcomes are read by no call site;\n19|//   - the secconftest fuzz targets stay mapped in FuzzTargetEntry.\n20|//     FuzzTargets derives the committed target list from that map rather\n21|//     than retyping it, and TestListedTargetsMatchDerivation holds CI's\n22|//     `go test -list` leg equal to it. Fuzz targets also live in\n23|//     internal/canonicaljson and internal/scalar, which own no entry map;\n24|//     CI smokes those packages from their own `-list` derivations.\n25|//\n26|// Normative scope: AX v0.5.0 Sections 16, 19.2-19.5, 20.2, Appendix D. The\n27|// Section 19.3 provider suites and Section 19.4 lifecycle cases outside\n28|// Section 16 are not driven here; CI runs them only where their owning\n29|// packages already implement them, and this gate claims nothing about the\n30|// rest.\n31|//\n32|// Stated bounds. The gates are read-only: they parse the pinned authorities\n33|// and repository text and write only their verdict to the caller. They mutate\n34|// no durable state, keep no cache, and carry no crash or idempotency surface\n35|// of their own; crash/idempotency evidence for the story is the secconftest\n36|// Transactor battery, which CI executes but which lives outside this package.\n37|// Availability is evaluated on the host that runs the check: a positive claim\n38|// about a capability available here is admitted even when the same sentence\n39|// would be refused on a host where the probe fails. Cross-host claim truth is\n40|// outside this gate. The advertisement scanner matches only backticked\n41|// capability IDs, never bare prose: an advertisement that names a\n42|// capability without backticks — however positive its verbs — is not\n43|// checked and is admitted. The scanner reads backticked prose only; it\n44|// classifies sentences, not intent, and any backticked sentence it cannot\n45|// classify is refused rather than ignored.\n46|//\n47|// Deliberate shape decision: this package ships no main package. Its library\n48|// entry points import internal/secconftest for the probe vocabulary, and\n49|// secconftest reads internal/specdoc, which the specdoc guard forbids any new\n50|// main from reaching (TestEmbeddedDocumentNeverReachesAProductBinary and\n51|// TestModuleHasNoProductCommandYet). A cigate command would need either a\n52|// foreign allowlist widening or a second probe vocabulary, both of which this\n53|// story exists to refuse. CI therefore drives these gates through focused,\n54|// name-guarded go test selections; the guards prove the selection matched.\n55|package cigate","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c48b","stream":{"kind":"session","id":"01a07b60-5dda-7951-9c64-98cc389b396d"},"sequence":160,"recorded_at":1780531400000315,"record_type":"event","durability":"durable","causation_id":"bd52028a-acb2-4196-94e2-c06d1bbe961a","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"bd52028a-acb2-4196-94e2-c06d1bbe961a","run_stream":{"kind":"run","id":"bd52028a-acb2-4196-94e2-c06d1bbe961a"},"call_id":"call_01a07b60a1f877a28d1a9795b41f1cd0","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/cigate/claims_test.go`.\n1|package cigate\n2|\n3|import (\n4|\t\"os\"\n5|\t\"path/filepath\"\n6|\t\"strings\"\n7|\t\"testing\"\n8|)\n9|\n10|func unavailableStates(ids ...string) []ProbeState {\n11|\tstates := make([]ProbeState, 0, len(ids))\n12|\tfor _, id := range ids {\n13|\t\tstates = append(states, ProbeState{ID: id, Available: false})\n14|\t}\n15|\treturn states\n16|}\n17|\n18|func availableStates(ids ...string) []ProbeState {\n19|\tstates := make([]ProbeState, 0, len(ids))\n20|\tfor _, id := range ids {\n21|\t\tstates = append(states, ProbeState{ID: id, Available: true})\n22|\t}\n23|\treturn states\n24|}\n25|\n26|func TestCapabilityIDsAreDerivedSorted(t *testing.T) {\n27|\tt.Parallel()\n28|\tids, err := CapabilityIDs()\n29|\tif err != nil {\n30|\t\tt.Fatalf(\"CapabilityIDs() error = %v\", err)\n31|\t}\n32|\tif len(ids) == 0 {\n33|\t\tt.Fatal(\"CapabilityIDs() is empty; the check would pass on an empty vocabulary\")\n34|\t}\n35|\tfor index, id := range ids {\n36|\t\tif id == \"\" {\n37|\t\t\tt.Fatalf(\"CapabilityIDs()[%d] is empty\", index)\n38|\t\t}\n39|\t\tif index > 0 && ids[index-1] >= id {\n40|\t\t\tt.Fatalf(\"CapabilityIDs() = %v, want sorted\", ids)\n41|\t\t}\n42|\t}\n43|}\n44|\n45|// TestPositiveClaimsAreRefused drives one claim per positive verb: dropping a\n46|// verb from the gate must admit exactly its row (NARROWING battery). Each\n47|// subtest kills by behaviour — the count when the row goes silent, the\n48|// reason when it slides to the unclassified arm — never by a battery-size\n49|// guard: a parent-level size check would abort before any subtest runs and\n50|// prove only bookkeeping.\n51|func TestPositiveClaimsAreRefused(t *testing.T) {\n52|\tt.Parallel()\n53|\tclaims := map[string]string{\n54|\t\t\"available\": \"The `fifo` capability is available on Windows.\",\n55|\t\t\"supported\": \"This release keeps `fifo` supported on every platform.\",\n56|\t\t\"enabled\":   \"The runner has `fifo` enabled by default.\",\n57|\t\t\"works\":     \"The `fifo` lane works on Windows.\",\n58|\t\t\"passes\":    \"The `fifo` fixture passes on Windows.\",\n59|\t\t\"capital\":   \"The `fifo` capability is Available on Windows.\",\n60|\t}\n61|\tfor verb, claim := range claims {\n62|\t\tt.Run(verb, func(t *testing.T) {\n63|\t\t\tt.Parallel()\n64|\t\t\tfindings, err := CheckAdvertisements(claim, unavailableStates(\"fifo\"))\n65|\t\t\tif err != nil {\n66|\t\t\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n67|\t\t\t}\n68|\t\t\tif len(findings) != 1 {\n69|\t\t\t\tt.Fatalf(\"CheckAdvertisements() findings = %v, want exactly one\", findings)\n70|\t\t\t}\n71|\t\t\tif findings[0].ID != \"fifo\" {\n72|\t\t\t\tt.Errorf(\"finding ID = %q, want fifo\", findings[0].ID)\n73|\t\t\t}\n74|\t\t\tif !strings.Contains(findings[0].Reason, \"positive availability claim\") {\n75|\t\t\t\tt.Errorf(\"finding reason = %q, want the positive-claim refusal\", findings[0].Reason)\n76|\t\t\t}\n77|\t\t})\n78|\t}\n79|\t// A verb added to the gate without a claim row would pass the battery\n80|\t// without ever being driven: the census fails instead.\n81|\tt.Run(\"battery-covers-gate\", func(t *testing.T) {\n82|\t\tt.Parallel()\n83|\t\tfor _, verb := range positiveAvailability {\n84|\t\t\tif _, ok := claims[verb]; !ok {\n85|\t\t\t\tt.Errorf(\"gate verb %q has no claim row; extend the battery\", verb)\n86|\t\t\t}\n87|\t\t}\n88|\t})\n89|}\n90|\n91|// TestNegatedClaimsAreAdmitted drives one row per negation: dropping a\n92|// negation must refuse exactly its honestly conditional sentence. Every row\n93|// carries a positive verb guarded by exactly one negation, so the drop kills\n94|// by behaviour — the positive arm fires — never by a battery-size guard. A\n95|// row naming two negations would let one cover for the other and must not\n96|// be written; a row without a positive verb would not redden at all.\n97|func TestNegatedClaimsAreAdmitted(t *testing.T) {\n98|\tt.Parallel()\n99|\tsentences := map[string]string{\n100|\t\t\"not\":         \"The `fifo` capability is not available on Windows.\",\n101|\t\t\"never\":       \"The `fifo` lane never passes on Windows.\",\n102|\t\t\"no\":          \"No host reports the `fifo` capability as available.\",\n103|\t\t\"without\":     \"The suite runs without the `fifo` capability available.\",\n104|\t\t\"cannot\":      \"The `fifo` probe cannot report available on Windows.\",\n105|\t\t\"can't\":       \"The `fifo` capability can't be enabled on Windows.\",\n106|\t\t\"n't\":         \"Hosts do n't advertise `fifo` as available.\",\n107|\t\t\"unavailable\": \"The `fifo` capability is unavailable on Windows, though the docs call it available.\",\n108|\t\t\"disabled\":    \"The `fifo` capability stays disabled on Windows, though the checklist marks it available.\",\n109|\t\t\"conditional\": \"The `fifo` capability is available conditional on the Linux lane.\",\n110|\t\t\"pending\":     \"The `fifo` lane will be available pending the Linux rollout.\",\n111|\t\t\"unless\":      \"The `fifo` lane is available on Windows unless the platform withholds it.\",\n112|\t\t\"only\":        \"The `fifo` capability is available only on Linux.\",\n113|\t}\n114|\tfor word, document := range sentences {\n115|\t\tt.Run(word, func(t *testing.T) {\n116|\t\t\tt.Parallel()\n117|\t\t\tfindings, err := CheckAdvertisements(document, unavailableStates(\"fifo\"))\n118|\t\t\tif err != nil {\n119|\t\t\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n120|\t\t\t}\n121|\t\t\tif len(findings) != 0 {\n122|\t\t\t\tt.Fatalf(\"CheckAdvertisements() findings = %v, want none\", findings)\n123|\t\t\t}\n124|\t\t})\n125|\t}\n126|\t// A negation added to the gate without a conditional row would pass the\n127|\t// battery without ever being driven: the census fails instead.\n128|\tt.Run(\"battery-covers-gate\", func(t *testing.T) {\n129|\t\tt.Parallel()\n130|\t\tfor _, word := range negations {\n131|\t\t\tif _, ok := sentences[word]; !ok {\n132|\t\t\t\tt.Errorf(\"gate negation %q has no conditional row; extend the battery\", word)\n133|\t\t\t}\n134|\t\t}\n135|\t})\n136|}\n137|\n138|// TestUnbacktickedProseIsOutsideTheScanner pins the stated bound: the gate\n139|// matches backticked capability IDs only, so a positive availability claim\n140|// written in bare prose is admitted unchecked. Widening the matcher to bare\n141|// IDs must fail here.\n142|func TestUnbacktickedProseIsOutsideTheScanner(t *testing.T) {\n143|\tt.Parallel()\n144|\tfor _, document := range []string{\n145|\t\t\"FIFO creation is available and supported on Windows.\",\n146|\t\t\"The fifo capability is available on Windows.\",\n147|\t} {\n148|\t\tfindings, err := CheckAdvertisements(document, unavailableStates(\"fifo\"))\n149|\t\tif err != nil {\n150|\t\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n151|\t\t}\n152|\t\tif len(findings) != 0 {\n153|\t\t\tt.Fatalf(\"CheckAdvertisements(%q) findings = %v, want none: bare prose is outside the scanner\", document, findings)\n154|\t\t}\n155|\t}\n156|}\n157|\n158|// TestUnclassifiedMentionIsRefused is the fail-closed arm: a sentence that\n159|// names an unavailable capability without any classified context is refused\n160|// rather than ignored. It is also the net for the token-preserving mutant\n161|// that phrases a claim without any listed verb.\n162|func TestUnclassifiedMentionIsRefused(t *testing.T) {\n163|\tt.Parallel()\n164|\tfor _, document := range []string{\n165|\t\t\"Ship the `fifo` driver tomorrow.\",\n166|\t\t\"The `fifo` lane is up on every host.\",\n167|\t} {\n168|\t\tfindings, err := CheckAdvertisements(document, unavailableStates(\"fifo\"))\n169|\t\tif err != nil {\n170|\t\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n171|\t\t}\n172|\t\tif len(findings) != 1 {\n173|\t\t\tt.Fatalf(\"CheckAdvertisements(%q) findings = %v, want exactly one\", document, findings)\n174|\t\t}\n175|\t\tif !strings.Contains(findings[0].Reason, \"unclassified mention\") {\n176|\t\t\tt.Errorf(\"finding reason = %q, want the unclassified refusal\", findings[0].Reason)\n177|\t\t}\n178|\t}\n179|}\n180|\n181|func TestAvailableCapabilityAdmitsPositiveClaim(t *testing.T) {\n182|\tt.Parallel()\n183|\tfindings, err := CheckAdvertisements(\n184|\t\t\"The `fifo` capability is available on Linux.\",\n185|\t\tavailableStates(\"fifo\"))\n186|\tif err != nil {\n187|\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n188|\t}\n189|\tif len(findings) != 0 {\n190|\t\tt.Fatalf(\"available capability drew findings = %v\", findings)\n191|\t}\n192|}\n193|\n194|func TestMixedAvailabilityFindsOnlyUnavailable(t *testing.T) {\n195|\tt.Parallel()\n196|\tfindings, err := CheckAdvertisements(\n197|\t\t\"The `symlink` and `fifo` lanes are available on Windows, and `mode-bits` stays up too.\",\n198|\t\t[]ProbeState{\n199|\t\t\t{ID: \"symlink\", Available: true},\n200|\t\t\t{ID: \"fifo\", Available: false},\n201|\t\t\t{ID: \"mode-bits\", Available: false},\n202|\t\t})\n203|\tif err != nil {\n204|\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n205|\t}\n206|\t// Asserted as a set: finding order is presentation, not verdict.\n207|\trefused := map[string]bool{}\n208|\tfor _, finding := range findings {\n209|\t\trefused[finding.ID] = true\n210|\t}\n211|\twant := map[string]bool{\"fifo\": true, \"mode-bits\": true}\n212|\tif len(refused) != len(want) {\n213|\t\tt.Fatalf(\"refused = %v, want %v\", refused, want)\n214|\t}\n215|\tfor id := range want {\n216|\t\tif !refused[id] {\n217|\t\t\tt.Fatalf(\"refused = %v, want %v\", refused, want)\n218|\t\t}\n219|\t}\n220|}\n221|\n222|func TestEmptyInputsAreRefused(t *testing.T) {\n223|\tt.Parallel()\n224|\tif _, err := CheckAdvertisements(\"The `fifo` lane is up.\", nil); err == nil {\n225|\t\tt.Error(\"empty probe set admitted; the gate would pass on an empty vocabulary\")\n226|\t}\n227|\tif _, err := CheckAdvertisements(\"   \\n  \", unavailableStates(\"fifo\")); err == nil {\n228|\t\tt.Error(\"empty document admitted; the gate would pass on nothing scanned\")\n229|\t}\n230|}\n231|\n232|// TestSubstringIsNotAMarker pins boundary anchoring: \"protest\" carries the\n233|// letters t-e-s-t without the word test, and must not classify the sentence.\n234|// A gate matching substrings would admit this claim-shaped mention.\n235|func TestSubstringIsNotAMarker(t *testing.T) {\n236|\tt.Parallel()\n237|\tfindings, err := CheckAdvertisements(\"Citizens protest the `fifo` cut.\", unavailableStates(\"fifo\"))\n238|\tif err != nil {\n239|\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n240|\t}\n241|\tif len(findings) != 1 {\n242|\t\tt.Fatalf(\"findings = %v, want exactly the unclassified refusal\", findings)\n243|\t}\n244|\tif !strings.Contains(findings[0].Reason, \"unclassified mention\") {\n245|\t\tt.Errorf(\"finding reason = %q, want the unclassified refusal\", findings[0].Reason)\n246|\t}\n247|}\n248|\n249|func TestFindingCarriesLine(t *testing.T) {\n250|\tt.Parallel()\n251|\tdocument := \"First line.\\n\\nThe `fifo` capability is available on Windows.\\n\"\n252|\tfindings, err := CheckAdvertisements(document, unavailableStates(\"fifo\"))\n253|\tif err != nil {\n254|\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n255|\t}\n256|\tif len(findings) != 1 {\n257|\t\tt.Fatalf(\"findings = %v, want exactly one\", findings)\n258|\t}\n259|\tif findings[0].Line != 3 {\n260|\t\tt.Errorf(\"finding line = %d, want 3\", findings[0].Line)\n261|\t}\n262|}\n263|\n264|func readREADME(t *testing.T) string {\n265|\tt.Helper()\n266|\tcontents, err := os.ReadFile(filepath.Join(\"..\", \"..\", \"README.md\"))\n267|\tif err != nil {\n268|\t\tt.Fatalf(\"read README.md: %v\", err)\n269|\t}\n270|\treturn string(contents)\n271|}\n272|\n273|func allUnavailable(t *testing.T) []ProbeState {\n274|\tt.Helper()\n275|\tids, err := CapabilityIDs()\n276|\tif err != nil {\n277|\t\tt.Fatalf(\"CapabilityIDs() error = %v\", err)\n278|\t}\n279|\treturn unavailableStates(ids...)\n280|}\n281|\n282|// TestRealREADMECarriesNoPositiveClaim runs the gate over the real\n283|// advertisement surface with every probe forced unavailable — the strongest\n284|// posture: every backticked capability mention must already be classified\n285|// non-claim, or a future edit away from refusal.\n286|func TestRealREADMECarriesNoPositiveClaim(t *testing.T) {\n287|\tt.Parallel()\n288|\tfindings, err := CheckAdvertisements(readREADME(t), allUnavailable(t))\n289|\tif err != nil {\n290|\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n291|\t}\n292|\tif len(findings) != 0 {\n293|\t\tt.Fatalf(\"README findings = %v, want none\", findings)\n294|\t}\n295|}\n296|\n297|func TestRealREADMEAdmitsWhenAllAvailable(t *testing.T) {\n298|\tt.Parallel()\n299|\tids, err := CapabilityIDs()\n300|\tif err != nil {\n301|\t\tt.Fatalf(\"CapabilityIDs() error = %v\", err)\n302|\t}\n303|\tfindings, err := CheckAdvertisements(readREADME(t), availableStates(ids...))\n304|\tif err != nil {\n305|\t\tt.Fatalf(\"CheckAdvertisements() error = %v\", err)\n306|\t}\n307|\tif len(findings) != 0 {\n308|\t\tt.Fatalf(\"README findings = %v, want none\", findings)\n309|\t}\n310|}\n311|\n312|// TestEveryNonClaimMarkerOccursInCorpus keeps the marker list honest: a\n313|// marker that fires on no real sentence is either dead weight or an admission\n314|// hole reserved for future text.\n315|func TestEveryNonClaimMarkerOccursInCorpus(t *testing.T) {\n316|\tt.Parallel()\n317|\tdocument := readREADME(t)\n318|\tids, err := CapabilityIDs()\n319|\tif err != nil {\n320|\t\tt.Fatalf(\"CapabilityIDs() error = %v\", err)\n321|\t}\n322|\tprobed := map[string]bool{}\n323|\tfor _, id := range ids {\n324|\t\tprobed[\"`\"+id+\"`\"] = true\n325|\t}\n326|\tvar mentioning []string\n327|\tfor _, part := range splitSentences(document) {\n328|\t\tfor token := range probed {\n329|\t\t\tif strings.Contains(part.text, token) {\n330|\t\t\t\tmentioning = append(mentioning, part.text)\n331|\t\t\t\tbreak\n332|\t\t\t}\n333|\t\t}\n334|\t}\n335|\tif len(mentioning) == 0 {\n336|\t\tt.Fatal(\"no corpus sentence mentions a probe ID; the marker census is vacuous\")\n337|\t}\n338|\tfor _, marker := range nonClaimMarkers {\n339|\t\tfound := false\n340|\t\tfor _, text := range mentioning {\n341|\t\t\tif wordMatches(marker, strings.ToLower(text)) {\n342|\t\t\t\tfound = true\n343|\t\t\t\tbreak\n344|\t\t\t}\n345|\t\t}\n346|\t\tif !found {\n347|\t\t\tt.Errorf(\"marker %q occurs in no probe-mentioning sentence; remove it or classify with it\", marker)\n348|\t\t}\n349|\t}\n350|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
