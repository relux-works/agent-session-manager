{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca19","stream":{"kind":"session","id":"01a07b60-5dda-7951-9c64-98cc389b396d"},"sequence":871,"recorded_at":1780531400001737,"record_type":"event","durability":"durable","causation_id":"bd52028a-acb2-4196-94e2-c06d1bbe961a","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"bd52028a-acb2-4196-94e2-c06d1bbe961a","run_stream":{"kind":"run","id":"bd52028a-acb2-4196-94e2-c06d1bbe961a"},"task_stream":{"kind":"task","id":"56dc4751-7352-4965-a975-cf0196c5049f"},"task_id":"56dc4751-7352-4965-a975-cf0196c5049f","event":{"kind":"output","task_id":"56dc4751-7352-4965-a975-cf0196c5049f","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260905-3t31e9/worktree/internal/cigate/targets_test.go`.\n1|package cigate\n2|\n3|import (\n4|\t\"os/exec\"\n5|\t\"reflect\"\n6|\t\"sort\"\n7|\t\"strings\"\n8|\t\"testing\"\n9|)\n10|\n11|func TestFuzzTargetsAreDerivedSorted(t *testing.T) {\n12|\tt.Parallel()\n13|\ttargets, err := FuzzTargets()\n14|\tif err != nil {\n15|\t\tt.Fatalf(\"FuzzTargets() error = %v\", err)\n16|\t}\n17|\tif len(targets) == 0 {\n18|\t\tt.Fatal(\"FuzzTargets() is empty; CI would pass on an empty matrix\")\n19|\t}\n20|\tsorted := append([]string(nil), targets...)\n21|\tsort.Strings(sorted)\n22|\tif !reflect.DeepEqual(targets, sorted) {\n23|\t\tt.Fatalf(\"FuzzTargets() = %v, want sorted\", targets)\n24|\t}\n25|\tfor _, target := range targets {\n26|\t\tif len(target) < 5 || target[:4] != \"Fuzz\" {\n27|\t\t\tt.Errorf(\"target %q is not a Fuzz entry point\", target)\n28|\t\t}\n29|\t}\n30|}\n31|\n32|func TestSortedTargetsRefusals(t *testing.T) {\n33|\tt.Parallel()\n34|\tif _, err := sortedTargets(map[string]string{}); err == nil {\n35|\t\tt.Error(\"empty derivation admitted; CI would expand an empty matrix\")\n36|\t}\n37|\tif _, err := sortedTargets(map[string]string{\"NotAFuzz\": \"secprim.X\"}); err == nil {\n38|\t\tt.Error(\"non-Fuzz target admitted\")\n39|\t}\n40|\tif _, err := sortedTargets(map[string]string{\"FuzzX\": \"\"}); err == nil {\n41|\t\tt.Error(\"target without an entry admitted\")\n42|\t}\n43|\tgot, err := sortedTargets(map[string]string{\"FuzzB\": \"e\", \"FuzzA\": \"e\"})\n44|\tif err != nil {\n45|\t\tt.Fatalf(\"sortedTargets() error = %v\", err)\n46|\t}\n47|\tif !reflect.DeepEqual(got, []string{\"FuzzA\", \"FuzzB\"}) {\n48|\t\tt.Fatalf(\"sortedTargets() = %v, want sorted\", got)\n49|\t}\n50|}\n51|\n52|// TestListedTargetsMatchDerivation is the CI wiring for FuzzTargets: the\n53|// fuzz-smoke job smokes whatever `go test -list` reports, so this test\n54|// holds that reported set equal to the entry-mapped derivation. A target\n55|// added to the binary without a FuzzTargetEntry — or an entry without a\n56|// target — fails here before CI can smoke a list the derivation does not\n57|// cover. The absolute package path keeps the check independent of the\n58|// test's working directory; listing compiles only and touches no network.\n59|func TestListedTargetsMatchDerivation(t *testing.T) {\n60|\tt.Parallel()\n61|\ttargets, err := FuzzTargets()\n62|\tif err != nil {\n63|\t\tt.Fatalf(\"FuzzTargets() error = %v\", err)\n64|\t}\n65|\tout, err := exec.Command(\"go\", \"test\",\n66|\t\t\"github.com/relux-works/agent-session-manager/internal/secconftest\",\n67|\t\t\"-list\", \"^Fuzz\").CombinedOutput()\n68|\tif err != nil {\n69|\t\tt.Fatalf(\"go test -list error = %v, output:\\n%s\", err, out)\n70|\t}\n71|\tvar listed []string\n72|\tfor _, line := range strings.Split(string(out), \"\\n\") {\n73|\t\tline = strings.TrimSpace(line)\n74|\t\tif strings.HasPrefix(line, \"Fuzz\") {\n75|\t\t\tlisted = append(listed, line)\n76|\t\t}\n77|\t}\n78|\tsort.Strings(listed)\n79|\tif !reflect.DeepEqual(listed, targets) {\n80|\t\tt.Fatalf(\"listed targets = %v, derivation = %v; add the FuzzTargetEntry or remove the target\", listed, targets)\n81|\t}\n82|}"}}}
