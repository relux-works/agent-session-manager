+		}
+		failures := invcore.AuditConstructorReferences(syntax, fileSet, "plant.go", refusalConstructorSpec())
+		if len(failures) == 0 {
+			t.Errorf("%s admitted: the alias bypasses attribution", name)
+		}
+	}
+}
