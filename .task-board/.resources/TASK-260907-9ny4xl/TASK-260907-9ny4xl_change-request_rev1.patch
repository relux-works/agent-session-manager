+	add(deriveRequiredList(t, "environ", "observation.go", "observationRequired"))
+	add(deriveMapKeys(t, "provhost", "protocol.go", "responseMembers"))
+	add(deriveRequiredList(t, "dirnode", "scan.go", "scanRequestRequired"))
+	add([]string{"v"})
