ting\", []eventSpec{created}, StateCreating},\n95|\t\t{\"running\", []eventSpec{created, launched}, StateRunning},\n96|\t\t{\"idle\", []eventSpec{created, launched, idle}, StateIdle},\n97|\t\t{\"quiescing\", []eventSpec{created, launched, idle,\n98|\t\t\t{typ: \"session.quiescing\", payload: quiescingPayload()}}, StateQuiescing},\n99|\t\t{\"checkpointing\", []eventSpec{created, launched, idle, checkpoint}, StateCheckpointing},\n100|\t\t{\"stopped\", []eventSpec{created, launched, idle, checkpoint, checkpoint,\n101|\t\t\t{typ: \"session.stopped\", payload: stoppedPayload()}}, StateStopped},\n102|\t\t{\"materializing\", []eventSpec{created, launched, idle, checkpoint, checkpoint,\n103|\t\t\t{typ: \"session.stopped\", payload: stoppedPayload()}, transferred}, StateMaterializing},\n104|\t\t{\"parked\", []eventSpec{created, launched, idle, checkpoint, checkpoint,\n105|\t\t\t{typ: \"session.stopped\", payload: stoppedPayload()}, transferred,\n106|\t\t\t{epoch: 2, leaseID: testLeaseIDB, typ: \"session.parked\", payload: parkedPayload(testLeaseIDB)}}, StateParked},\n107|\t\t{\"failed\", []eventSpec{created, launched,\n108|\t\t\t{typ: \"session.failed\", payload: failedPayload()}}, StateFailed},\n109|\t\t{\"stale\", []eventSpec{created, launched, idle,\n110|\t\t\t{epoch: 2, leaseID: testLeaseIDB, typ: \"lease.forced\", payload: forcedPayload(testLeaseIDB, 1)}}, StateStale},\n111|\t\t{\"tombstoned\", []eventSpec{created, launched, idle, checkpoint, checkpoint,\n112|\t\t\t{typ: \"session.stopped\", payload: stoppedPayload()},\n113|\t\t\t{typ: \"session.tombstoned\", payload: tombstonedPayload()}}, StateTombstoned},\n114|\t}\n115|\tfor _, tc := range cases {\n116|\t\tt.Run(string(tc.want), func(t *testing.T) {\n117|\t\t\tprojection := reduceDirect(t, record, tc.chain)\n118|\t\t\tif projection.State != tc.want {\n119|\t\t\t\tt.Fatalf(\"Reduce state = %q, want %q\", projection.State, tc.want)\n120|\t\t\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome"