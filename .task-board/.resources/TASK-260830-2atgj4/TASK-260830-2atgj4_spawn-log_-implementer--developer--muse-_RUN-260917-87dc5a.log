{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c613","stream":{"kind":"session","id":"01a0ae2e-304f-7791-b344-a738da145935"},"sequence":356,"recorded_at":1780531400000707,"record_type":"event","durability":"durable","causation_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","run_stream":{"kind":"run","id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3"},"task_stream":{"kind":"task","id":"01a0ae2e-fb24-7952-9756-8582998ae509"},"task_id":"01a0ae2e-fb24-7952-9756-8582998ae509","event":{"kind":"output","task_id":"01a0ae2e-fb24-7952-9756-8582998ae509","chunk":"Read text file `internal/sessstate/winner_test.go`.\n1|package sessstate\n2|\n3|import (\n4|\t\"reflect\"\n5|\t\"strings\"\n6|\t\"testing\"\n7|)\n8|\n9|// baseBootstrap returns the created+launched specs opening every\n10|// winner test under lease A at epoch 1.\n11|func baseBootstrap(record Record) []eventSpec {\n12|\treturn []eventSpec{\n13|\t\t{typ: \"session.created\", payload: createdPayload(record.RecordID)},\n14|\t\t{typ: \"provider.launched\", payload: launchedPayload(\"codex\")},\n15|\t}\n16|}\n17|\n18|func decodeTestRecord(t *testing.T) Record {\n19|\tt.Helper()\n20|\tdecoded, err := DecodeRecord(buildRecord(t, nil))\n21|\tif err != nil {\n22|\t\tt.Fatalf(\"DecodeRecord error = %v\", err)\n23|\t}\n24|\treturn decoded\n25|}\n26|\n27|func reduceSpecs(t *testing.T, record Record, specs []eventSpec, extra Input) (Projection, error) {\n28|\tt.Helper()\n29|\traw := buildRecord(t, nil)\n30|\t_, events, _ := buildChain(t, raw, specs)\n31|\tinput := Input{Record: record, Events: events}\n32|\tinput.Union = extra.Union\n33|\tinput.Local = extra.Local\n34|\tinput.LocalHostID = extra.LocalHostID\n35|\treturn Reduce(input)\n36|}\n37|\n38|func conflictKinds(projection Projection) []string {\n39|\tvar kinds []string\n40|\tfor _, conflict := range projection.Conflicts {\n41|\t\tkinds = append(kinds, conflict.Kind)\n42|\t}\n43|\treturn kinds\n44|}\n45|\n46|// TestWinnerResolutionClearWin requires the plain succession — epoch 1\n47|// to epoch 2 — to select the higher epoch with no conflict recorded.\n48|func TestWinnerResolutionClearWin(t *testing.T) {\n49|\trecord := decodeTestRecord(t)\n50|\t// The takeover stales the running winner, so the new owner stops\n51|\t// and resumes before running again: stale to stopped to running.\n52|\tspecs := append(baseBootstrap(record),\n53|\t\teventSpec{epoch: 2, leaseID: testLeaseIDB, typ: \"lease.transferred\", payload: transferredPayload(testLeaseID, testLeaseIDB)},\n54|\t\teventSpec{epoch: 2, leaseID: testLeaseIDB, typ: \"session.stopped\", payload: stoppedPayload()},\n55|\t\teventSpec{epoch: 2, leaseID: testLeaseIDB, typ: \"session.resumed\", payload: resumedPayload()},\n56|\t)\n57|\tprojection, err := reduceSpecs(t, record, specs, Input{})\n58|\tif err != nil {\n59|\t\tt.Fatalf(\"Reduce error = %v\", err)\n60|\t}\n61|\tif projection.Winner != (LeaseHead{Epoch: 2, LeaseID: testLeaseIDB}) {\n62|\t\tt.Fatalf(\"winner = %+v, want epoch 2 lease B\", projection.Winner)\n63|\t}\n64|\tif len(projection.Conflicts) != 0 {\n65|\t\tt.Fatalf(\"conflicts = %+v, want none on a clear win\", projection.Conflicts)\n66|\t}\n67|\tif projection.State != StateRunning {\n68|\t\tt.Fatalf(\"state = %q, want running\", projection.State)\n69|\t}\n70|}\n71|\n72|// TestWinnerResolutionTie requires the equal-epoch case to resolve by\n73|// the bytewise-greater lease ID under the named tie rule, with the\n74|// conflict recorded and the divergent_history warning raised.\n75|func TestWinnerResolutionTie(t *testing.T) {\n76|\trecord := decodeTestRecord(t)\n77|\tspecs := baseBootstrap(record)\n78|\t// The rival shares epoch 1 with the chain lease but sorts below\n79|\t// it, so the chain lease keeps the epoch while both the tie and\n80|\t// the rival's losing branch are reported.\n81|\tunion := []LeaseHead{{Epoch: 1, LeaseID: testLeaseIDR}}\n82|\tprojection, err := reduceSpecs(t, record, specs, Input{Union: union})\n83|\tif err != nil {\n84|\t\tt.Fatalf(\"Reduce error = %v\", err)\n85|\t}\n86|\tif projection.Winner != (LeaseHead{Epoch: 1, LeaseID: testLeaseID}) {\n87|\t\tt.Fatalf(\"winner = %+v, want epoch 1 chain lease\", projection.Winner)\n88|\t}\n89|\tkinds := conflictKinds(projection)\n90|\tif len(kinds) != 2 || kinds[0] != ConflictLosingBranchPreserved || kinds[1] != ConflictSameEpochTie {\n91|\t\tt.Fatalf(\"conflicts = %v, want [losing_branch_preserved same_epoch_tie]\", kinds)\n92|\t}\n93|\tfor _, conflict := range projection.Conflicts {\n94|\t\tif conflict.Kind == ConflictSameEpochTie && conflict.Rule != ResolveRuleGreatestLeaseIDWins {\n95|\t\t\tt.Fatalf(\"rule = %q, want greatest-lease-id-wins\", conflict.Rule)\n96|\t\t}\n97|\t}\n98|\tassertWarning(t, projection, \"divergent_history\")\n99|}\n100|\n101|// TestWinnerResolutionTieOrdersBytewise pins the tie-break direction:\n102|// the greater ID wins even when the union lists it first, so wall\n103|// clock or arrival order cannot bias the outcome.\n104|func TestWinnerResolutionTieOrdersBytewise(t *testing.T) {\n105|\trecord := decodeTestRecord(t)\n106|\tspecs := baseBootstrap(record)\n107|\tunion := []LeaseHead{\n108|\t\t{Epoch: 1, LeaseID: testLeaseIDC},\n109|\t\t{Epoch: 1, LeaseID: testLeaseIDB},\n110|\t}\n111|\tprojection, err := reduceSpecs(t, record, specs, Input{Union: union})\n112|\tif err != nil {\n113|\t\tt.Fatalf(\"Reduce error = %v\", err)\n114|\t}\n115|\tif projection.Winner.LeaseID != testLeaseIDC {\n116|\t\tt.Fatalf(\"winner = %s, want lease C regardless of union order\", projection.Winner.LeaseID)\n117|\t}\n118|\tkinds := conflictKinds(projection)\n119|\twant := map[string]bool{\n120|\t\tConflictSameEpochTie: true, ConflictLosingBranchPreserved: true,\n121|\t\tConflictUnionSupersedesChain: true,\n122|\t}\n123|\tif len(kinds) != len(want) {\n124|\t\tt.Fatalf(\"conflicts = %v, want the tie with its losing branch and off-chain winner\", kinds)\n125|\t}\n126|\tfor _, kind := range kinds {\n127|\t\tif !want[kind] {\n128|\t\t\tt.Fatalf(\"conflicts = %v, want the tie with its losing branch and off-chain winner\", kinds)\n129|\t\t}\n130|\t}\n131|}\n132|\n133|// TestWinnerResolutionGap requires an epoch jump in the authoritative\n134|// chain to keep the greatest tuple as winner while recording the gap\n135|// conflict: both sides are not individually valid (the jump skips the\n136|// predecessor-plus-one rule), so the named rule carries the healing\n137|// condition.\n138|func TestWinnerResolutionGap(t *testing.T) {\n139|\trecord := decodeTestRecord(t)\n140|\tspecs := append(baseBootstrap(record),\n141|\t\teventSpec{epoch: 3, leaseID: testLeaseIDB, typ: \"lease.transferred\", payload: transferredPayload(testLeaseID, testLeaseIDB)},\n142|\t)\n143|\tprojection, err := reduceSpecs(t, record, specs, Input{})\n144|\tif err != nil {\n145|\t\tt.Fatalf(\"Reduce error = %v\", err)\n146|\t}\n147|\tif projection.Winner != (LeaseHead{Epoch: 3, LeaseID: testLeaseIDB}) {\n148|\t\tt.Fatalf(\"winner = %+v, want epoch 3 lease B\", projection.Winner)\n149|\t}\n150|\tkinds := conflictKinds(projection)\n151|\tif len(kinds) != 1 || kinds[0] != ConflictEpochGap {\n152|\t\tt.Fatalf(\"conflicts = %v, want exactly [epoch_gap]\", kinds)\n153|\t}\n154|\tif projection.Conflicts[0].Rule != ResolveRuleGreatestTupleWins {\n155|\t\tt.Fatalf(\"rule = %q, want greatest-tuple-wins\", projection.Conflicts[0].Rule)\n156|\t}\n157|\tassertWarning(t, projection, \"divergent_history\")\n158|}\n159|\n160|// TestWinnerResolutionLosingBranchPreserved requires union leases that\n161|// lose the tuple comparison to be reported preserved-never-applied\n162|// while the chain winner stands. The rival shares the head epoch, so\n163|// its tie reports at epoch 2.\n164|func TestWinnerResolutionLosingBranchPreserved(t *testing.T) {\n165|\trecord := decodeTestRecord(t)\n166|\tspecs := append(baseBootstrap(record),\n167|\t\teventSpec{epoch: 2, leaseID: testLeaseIDB, typ: \"lease.transferred\", payload: transferredPayload(testLeaseID, testLeaseIDB)},\n168|\t)\n169|\tunion := []LeaseHead{{Epoch: 2, LeaseID: testLeaseIDR}}\n170|\tprojection, err := reduceSpecs(t, record, specs, Input{Union: union})\n171|\tif err != nil {\n172|\t\tt.Fatalf(\"Reduce error = %v\", err)\n173|\t}\n174|\tif projection.Winner != (LeaseHead{Epoch: 2, LeaseID: testLeaseIDB}) {\n175|\t\tt.Fatalf(\"winner = %+v, want epoch 2 lease B\", projection.Winner)\n176|\t}\n177|\tkinds := conflictKinds(projection)\n178|\tif len(kinds) != 2 || kinds[0] != ConflictLosingBranchPreserved || kinds[1] != ConflictSameEpochTie {\n179|\t\tt.Fatalf(\"conflicts = %v, want [losing_branch_preserved same_epoch_tie]\", kinds)\n180|\t}\n181|\tassertConflictDetailContains(t, projection, ConflictSameEpochTie, \"epoch 2 is shared\")\n182|}\n183|\n184|// TestWinnerResolutionUnionSupersedesChain requires an off-chain union\n185|// winner to move the reported winner without rewriting authoritative\n186|// state, under its named rule.\n187|func TestWinnerResolutionUnionSupersedesChain(t *testing.T) {\n188|\trecord := decodeTestRecord(t)\n189|\tspecs := baseBootstrap(record)\n190|\tunion := []LeaseHead{{Epoch: 2, LeaseID: testLeaseIDB}}\n191|\tprojection, err := reduceSpecs(t, record, specs, Input{Union: union})\n192|\tif err != nil {\n193|\t\tt.Fatalf(\"Reduce error = %v\", err)\n194|\t}\n195|\tif projection.Winner != (LeaseHead{Epoch: 2, LeaseID: testLeaseIDB}) {\n196|\t\tt.Fatalf(\"winner = %+v, want epoch 2 lease B\", projection.Winner)\n197|\t}\n198|\tif projection.State != StateRunning {\n199|\t\tt.Fatalf(\"state = %q, want running: authoritative state is unchanged\", projection.State)\n200|\t}\n201|\tkinds := conflictKinds(projection)\n202|\tif len(kinds) != 1 || kinds[0] != ConflictUnionSupersedesChain {\n203|\t\tt.Fatalf(\"conflicts = %v, want exactly [union_supersedes_chain]\", kinds)\n204|\t}\n205|\tif projection.Conflicts[0].Rule != ResolveRuleAuthoritativeStateUnchanged {\n206|\t\tt.Fatalf(\"rule = %q, want authoritative-state-unchanged\", projection.Conflicts[0].Rule)\n207|\t}\n208|}\n209|\n210|// TestWinnerResolutionPastEpochTie resolves a tie planted at a past\n211|// epoch against the lease the chain actually stood on: the union rival\n212|// at epoch 1 loses to the chain's epoch-2 head, and the epoch-1 tie is\n213|// still reported because two distinct leases shared it.\n214|func TestWinnerResolutionPastEpochTie(t *testing.T) {\n215|\trecord := decodeTestRecord(t)\n216|\tspecs := append(baseBootstrap(record),\n217|\t\teventSpec{epoch: 2, leaseID: testLeaseIDB, typ: \"lease.transferred\", payload: transferredPayload(testLeaseID, testLeaseIDB)},\n218|\t)\n219|\tunion := []LeaseHead{{Epoch: 1, LeaseID: testLeaseIDC}}\n220|\tprojection, err := reduceSpecs(t, record, specs, Input{Union: union})\n221|\tif err != nil {\n222|\t\tt.Fatalf(\"Reduce error = %v\", err)\n223|\t}\n224|\tif projection.Winner != (LeaseHead{Epoch: 2, LeaseID: testLeaseIDB}) {\n225|\t\tt.Fatalf(\"winner = %+v, want epoch 2 lease B\", projection.Winner)\n226|\t}\n227|\tkinds := conflictKinds(projection)\n228|\twant := map[string]bool{ConflictSameEpochTie: true, ConflictLosingBranchPreserved: true}\n229|\tif len(kinds) != 2 {\n230|\t\tt.Fatalf(\"conflicts = %v, want tie plus losing branch\", kinds)\n231|\t}\n232|\tfor _, kind := range kinds {\n233|\t\tif !want[kind] {\n234|\t\t\tt.Fatalf(\"conflicts = %v, want tie plus losing branch\", kinds)\n235|\t\t}\n236|\t}\n237|\tassertConflictDetailContains(t, projection, ConflictSameEpochTie, \"epoch 1 is shared\")\n238|}\n239|\n240|// TestProviderMismatchKeepsRecordPinned requires a launch under a\n241|// foreign provider to record the named conflict while the record\n242|// provider stays authoritative.\n243|func TestProviderMismatchKeepsRecordPinned(t *testing.T) {\n244|\trecord := decodeTestRecord(t)\n245|\tspecs := []eventSpec{\n246|\t\t{typ: \"session.created\", payload: createdPayload(record.RecordID)},\n247|\t\t{typ: \"provider.launched\", payload: launchedPayload(\"qwen\")},\n248|\t}\n249|\tprojection, err := reduceSpecs(t, record, specs, Input{})\n250|\tif err != nil {\n251|\t\tt.Fatalf(\"Reduce error = %v\", err)\n252|\t}\n253|\tif projection.State != StateRunning {\n254|\t\tt.Fatalf(\"state = %q, want running\", projection.State)\n255|\t}\n256|\tif projection.Provider.ID != \"codex\" {\n257|\t\tt.Fatalf(\"provider = %q, want record-pinned codex\", projection.Provider.ID)\n258|\t}\n259|\tif projection.Provider.Version != \"\" {\n260|\t\tt.Fatalf(\"provider version = %q, want empty: a mismatching launch contributes no version\", projection.Provider.Version)\n261|\t}\n262|\tkinds := conflictKinds(projection)\n263|\tif len(kinds) != 1 || kinds[0] != ConflictProviderMismatch {\n264|\t\tt.Fatalf(\"conflicts = %v, want exactly [provider_mismatch]\", kinds)\n265|\t}\n266|\tif projection.Conflicts[0].Rule != ResolveRuleRecordPinnedProviderWins {\n267|\t\tt.Fatalf(\"rule = %q, want record-pinned-provider-wins\", projection.Conflicts[0].Rule)\n268|\t}\n269|}\n270|\n271|// TestWinnerResolutionDuplicateOffChainUnionKeepsConflict requires a\n272|// repeated off-chain union entry to leave the resolution unchanged: the\n273|// winner stands, the union_supersedes_chain conflict stays recorded,\n274|// and the divergent_history warning stays raised. Clearing the\n275|// off-chain flag on the duplicate silently drops both.\n276|func TestWinnerResolutionDuplicateOffChainUnionKeepsConflict(t *testing.T) {\n277|\trecord := decodeTestRecord(t)\n278|\tspecs := baseBootstrap(record)\n279|\tonce, err := reduceSpecs(t, record, specs, Input{Union: []LeaseHead{{Epoch: 3, LeaseID: testLeaseIDC}}})\n280|\tif err != nil {\n281|\t\tt.Fatalf(\"Reduce error = %v\", err)\n282|\t}\n283|\tif kinds := conflictKinds(once); len(kinds) != 1 || kinds[0] != ConflictUnionSupersedesChain {\n284|\t\tt.Fatalf(\"conflicts = %v, want exactly [union_supersedes_chain]\", kinds)\n285|\t}\n286|\ttwice, err := reduceSpecs(t, record, specs, Input{Union: []LeaseHead{\n287|\t\t{Epoch: 3, LeaseID: testLeaseIDC},\n288|\t\t{Epoch: 3, LeaseID: testLeaseIDC},\n289|\t}})\n290|\tif err != nil {\n291|\t\tt.Fatalf(\"Reduce error = %v\", err)\n292|\t}\n293|\tif twice.Winner != once.Winner {\n294|\t\tt.Fatalf(\"winner = %+v, want the single-entry winner %+v\", twice.Winner, once.Winner)\n295|\t}\n296|\tif kinds := conflictKinds(twice); len(kinds) != 1 || kinds[0] != ConflictUnionSupersedesChain {\n297|\t\tt.Fatalf(\"conflicts = %v, want exactly [union_supersedes_chain]\", kinds)\n298|\t}\n299|\tassertWarning(t, twice, \"divergent_history\")\n300|}\n301|\n302|// TestWinnerResolutionRepeatedOffChainUnionStaysResolved goes one step\n303|// past the duplicate: three copies plus a losing branch, in both\n304|// orders, still resolve to the same winner with the losing branch, the\n305|// epoch-1 tie, and the off-chain winner all reported.\n306|func TestWinnerResolutionRepeatedOffChainUnionStaysResolved(t *testing.T) {\n307|\trecord := decodeTestRecord(t)\n308|\tspecs := baseBootstrap(record)\n309|\tunions := map[string][]LeaseHead{\n310|\t\t\"winner first\": {\n311|\t\t\t{Epoch: 3, LeaseID: testLeaseIDC},\n312|\t\t\t{Epoch: 3, LeaseID: testLeaseIDC},\n313|\t\t\t{Epoch: 3, LeaseID: testLeaseIDC},\n314|\t\t\t{Epoch: 1, LeaseID: testLeaseIDR},\n315|\t\t},\n316|\t\t\"loser first\": {\n317|\t\t\t{Epoch: 1, LeaseID: testLeaseIDR},\n318|\t\t\t{Epoch: 3, LeaseID: testLeaseIDC},\n319|\t\t\t{Epoch: 3, LeaseID: testLeaseIDC},\n320|\t\t\t{Epoch: 3, LeaseID: testLeaseIDC},\n321|\t\t},\n322|\t}\n323|\tfor name, union := range unions {\n324|\t\tt.Run(name, func(t *testing.T) {\n325|\t\t\tprojection, err := reduceSpecs(t, record, specs, Input{Union: union})\n326|\t\t\tif err != nil {\n327|\t\t\t\tt.Fatalf(\"Reduce error = %v\", err)\n328|\t\t\t}\n329|\t\t\tif projection.Winner != (LeaseHead{Epoch: 3, LeaseID: testLeaseIDC}) {\n330|\t\t\t\tt.Fatalf(\"winner = %+v, want epoch 3 lease C\", projection.Winner)\n331|\t\t\t}\n332|\t\t\twant := map[string]bool{\n333|\t\t\t\tConflictLosingBranchPreserved: true, ConflictSameEpochTie: true,\n334|\t\t\t\tConflictUnionSupersedesChain: true,\n335|\t\t\t}\n336|\t\t\tkinds := conflictKinds(projection)\n337|\t\t\tif len(kinds) != len(want) {\n338|\t\t\t\tt.Fatalf(\"conflicts = %v, want losing branch, tie, and off-chain winner\", kinds)\n339|\t\t\t}\n340|\t\t\tfor _, kind := range kinds {\n341|\t\t\t\tif !want[kind] {\n342|\t\t\t\t\tt.Fatalf(\"conflicts = %v, want losing branch, tie, and off-chain winner\", kinds)\n343|\t\t\t\t}\n344|\t\t\t}\n345|\t\t\tassertWarning(t, projection, \"divergent_history\")\n346|\t\t})\n347|\t}\n348|}\n349|\n350|// TestReduceLocalLeaseTupleRule pins the local-stale rule at the tuple\n351|// boundary: only a local lease that lost the tuple comparison stales\n352|// the projection. An equal lease and a strictly greater lease — by\n353|// epoch or by lease ID — stand with the winner.\n354|func TestReduceLocalLeaseTupleRule(t *testing.T) {\n355|\trecord := decodeTestRecord(t)\n356|\tspecs := baseBootstrap(record)\n357|\tcases := []struct {\n358|\t\tname      string\n359|\t\tlocal     LeaseHead\n360|\t\twantState State\n361|\t\twantStale bool\n362|\t}{\n363|\t\t{\"equal stands\", LeaseHead{Epoch: 1, LeaseID: testLeaseID}, StateRunning, false},\n364|\t\t{\"greater epoch stands\", LeaseHead{Epoch: 9, LeaseID: testLeaseIDC}, StateRunning, false},\n365|\t\t{\"greater lease id stands\", LeaseHead{Epoch: 1, LeaseID: testLeaseIDC}, StateRunning, false},\n366|\t\t{\"lesser lease stales\", LeaseHead{Epoch: 1, LeaseID: testLeaseIDR}, StateStale, true},\n367|\t}\n368|\tfor _, tc := range cases {\n369|\t\tt.Run(tc.name, func(t *testing.T) {\n370|\t\t\tprojection, err := reduceSpecs(t, record, specs, Input{Local: tc.local})\n371|\t\t\tif err != nil {\n372|\t\t\t\tt.Fatalf(\"Reduce error = %v\", err)\n373|\t\t\t}\n374|\t\t\tif projection.State != tc.wantState {\n375|\t\t\t\tt.Fatalf(\"state = %q, want %q\", projection.State, tc.wantState)\n376|\t\t\t}\n377|\t\t\tif projection.Winner != (LeaseHead{Epoch: 1, LeaseID: testLeaseID}) {\n378|\t\t\t\tt.Fatalf(\"winner = %+v, want the chain head: the local lease never moves the winner\", projection.Winner)\n379|\t\t\t}\n380|\t\t\thasStale := false\n381|\t\t\tfor _, warning := range projection.Warnings {\n382|\t\t\t\tif warning == \"stale_process\" {\n383|\t\t\t\t\thasStale = true\n384|\t\t\t\t}\n385|\t\t\t}\n386|\t\t\tif hasStale != tc.wantStale {\n387|\t\t\t\tt.Fatalf(\"stale_process warning = %v, want %v (warnings = %v)\", hasStale, tc.wantStale, projection.Warnings)\n388|\t\t\t}\n389|\t\t})\n390|\t}\n391|}\n392|\n393|func assertConflictDetailContains(t *testing.T, projection Projection, kind, fragment string) {\n394|\tt.Helper()\n395|\tfor _, conflict := range projection.Conflicts {\n396|\t\tif conflict.Kind == kind {\n397|\t\t\tif !strings.Contains(conflict.Detail, fragment) {\n398|\t\t\t\tt.Fatalf(\"conflict %s detail = %q, want fragment %q\", kind, conflict.Detail, fragment)\n399|\t\t\t}\n400|\t\t\treturn\n401|\t\t}\n402|\t}\n403|\tt.Fatalf(\"no conflict of kind %s in %+v\", kind, projection.Conflicts)\n404|}\n405|\n406|func assertWarning(t *testing.T, projection Projection, warning string) {\n407|\tt.Helper()\n408|\tfor _, candidate := range projection.Warnings {\n409|\t\tif candidate == warning {\n410|\t\t\treturn\n411|\t\t}\n412|\t}\n413|\tt.Fatalf(\"warnings = %v, want %q\", projection.Warnings, warning)\n414|}\n415|\n416|// With no authoritative event there is no owner/process lease to fence.\n417|// Union may report a winner, but Local is ignored, including malformed and\n418|// partial tuples. This is a stated input bound, not invented validation.\n419|func TestReduceEmptyChainLocalIsIgnored(t *testing.T) {\n420|\trecord := decodeTestRecord(t)\n421|\twinner := LeaseHead{Epoch: 3, LeaseID: testLeaseIDC}\n422|\tfor _, union := range []struct {\n423|\t\tname   string\n424|\t\tleases []LeaseHead\n425|\t\twinner LeaseHead\n426|\t}{\n427|\t\t{\"absent_union\", nil, LeaseHead{}},\n428|\t\t{\"selected_union_winner\", []LeaseHead{{Epoch: 2, LeaseID: testLeaseIDB}, winner}, winner},\n429|\t} {\n430|\t\tt.Run(union.name, func(t *testing.T) {\n431|\t\t\tbaseline, err := Reduce(Input{Record: record, Union: union.leases})\n432|\t\t\tif err != nil {\n433|\t\t\t\tt.Fatal(err)\n434|\t\t\t}\n435|\t\t\tif baseline.Winner != union.winner || baseline.State != StateCreating {\n436|\t\t\t\tt.Fatalf(\"union baseline: %+v\", baseline)\n437|\t\t\t}\n438|\t\t\tif len(union.leases) > 0 {\n439|\t\t\t\tfound := false\n440|\t\t\t\tfor _, conflict := range baseline.Conflicts {\n441|\t\t\t\t\tif conflict.Kind == ConflictUnionSupersedesChain && conflict.Rule == ResolveRuleAuthoritativeStateUnchanged {\n442|\t\t\t\t\t\tfound = true\n443|\t\t\t\t\t}\n444|\t\t\t\t}\n445|\t\t\t\tif !found {\n446|\t\t\t\t\tt.Fatal(\"selected union winner has no named unchanged-state conflict\")\n447|\t\t\t\t}\n448|\t\t\t}\n449|\t\t\tfor _, local := range []struct {\n450|\t\t\t\tname string\n451|\t\t\t\thead LeaseHead\n452|\t\t\t}{\n453|\t\t\t\t{\"absent\", LeaseHead{}},\n454|\t\t\t\t{\"lesser\", LeaseHead{Epoch: 1, LeaseID: testLeaseID}},\n455|\t\t\t\t{\"equal_to_union\", winner},\n456|\t\t\t\t{\"greater\", LeaseHead{Epoch: 4, LeaseID: testLeaseIDB}},\n457|\t\t\t\t{\"malformed_id\", LeaseHead{Epoch: 1, LeaseID: \"not-a-uuid\"}},\n458|\t\t\t\t{\"epoch_only\", LeaseHead{Epoch: 1}},\n459|\t\t\t\t{\"id_only\", LeaseHead{LeaseID: testLeaseID}},\n460|\t\t\t} {\n461|\t\t\t\tt.Run(local.name, func(t *testing.T) {\n462|\t\t\t\t\tgot, err := Reduce(Input{Record: record, Union: union.leases, Local: local.head, LocalHostID: testHostID})\n463|\t\t\t\t\tif err != nil {\n464|\t\t\t\t\t\tt.Fatalf(\"empty-chain Local must not be validated: %v\", err)\n465|\t\t\t\t\t}\n466|\t\t\t\t\tif got.LocalRole != \"\" || got.OwnerHostID != \"\" {\n467|\t\t\t\t\t\tt.Fatalf(\"no authoritative owner: %+v\", got)\n468|\t\t\t\t\t}\n469|\t\t\t\t\tif !reflect.DeepEqual(got, baseline) {\n470|\t\t\t\t\t\tt.Fatalf(\"Local changed empty-chain projection: got %+v want %+v\", got, baseline)\n471|\t\t\t\t\t}\n472|\t\t\t\t})\n473|\t\t\t}\n474|\t\t})\n475|\t}\n476|}","final_result":true}}}
