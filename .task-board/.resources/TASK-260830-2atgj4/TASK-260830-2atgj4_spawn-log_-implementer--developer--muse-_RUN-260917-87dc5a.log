{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6ab","stream":{"kind":"session","id":"01a0ae2e-304f-7791-b344-a738da145935"},"sequence":432,"recorded_at":1780531400000859,"record_type":"event","durability":"durable","causation_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","run_stream":{"kind":"run","id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3"},"task_stream":{"kind":"task","id":"01a0ae2f-2685-77a2-af02-b051d32fa35e"},"task_id":"01a0ae2f-2685-77a2-af02-b051d32fa35e","event":{"kind":"output","task_id":"01a0ae2f-2685-77a2-af02-b051d32fa35e","chunk":"Read text file `internal/fencing/testdata/mutate.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Run isolated behavioral mutants for the fencing gates; never modify the managed Story checkout.\n3|Usage: python3 internal/fencing/testdata/mutate.py /absolute/evidence/directory [name-filter]\n4|Every subprocess runs directly, logs its real exit, and has a bounded timeout.\n5|The battery proves each fencing gate by narrowing, never by deletion:\n6|every N-mutant keeps its gate present and weakens it to admit exactly one\n7|member of the class the gate must reject, and a named behavioral test must\n8|fail. The T-mutant preserves the searched-for leaseSeal token while\n9|constructing through an alias, and the harness executes the full behavioral\n10|suite for it, not only the static census. An optional name-filter runs a\n11|subset (substring match); results merge by concatenating mutants JSON rows.\n12|\"\"\"\n13|import hashlib\n14|import json\n15|from pathlib import Path\n16|import re\n17|import shutil\n18|import subprocess\n19|import sys\n20|\n21|root = Path(__file__).resolve().parents[3]\n22|output = Path(sys.argv[1]).resolve()\n23|output.mkdir(parents=True, exist_ok=True)\n24|name_filter = sys.argv[2] if len(sys.argv) > 2 else \"\"\n25|tag = re.sub(r\"[^a-z0-9]+\", \"-\", name_filter.lower()).strip(\"-\") or \"full\"\n26|copy = output / (\"mutation-source-\" + tag)\n27|if copy.exists():\n28|    raise SystemExit(\"refusing to overwrite an existing mutation source\")\n29|copy.mkdir()\n30|shutil.copytree(root / \"internal\", copy / \"internal\")\n31|for name in (\"go.mod\", \"go.sum\", \"README.md\", \"LOGBOOK.md\"):\n32|    shutil.copy2(root / name, copy / name)\n33|results = []\n34|\n35|LEASEA = \"aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee\"\n36|LEASEC = \"cccccccc-dddd-4eee-8fff-111111111111\"\n37|SESSIONB = \"0198f4c8-3e70-7a11-8a2b-1234567890ac\"\n38|\n39|GATE_IMPORT = '\\t\"errors\"\\n\\t\"fmt\"\\n\\t\"time\"'\n40|GATE_IMPORT_STRINGS = '\\t\"errors\"\\n\\t\"fmt\"\\n\\t\"strings\"\\n\\t\"time\"'\n41|\n42|# Each mutant: (name, kind, file, edits|add-path+content, command, bound).\n43|# kind edit: [(old, new)] applied to file, each anchored exactly once.\n44|# kind add: writes path with content for the run, then removes it.\n45|MUTANTS = [\n46|    (\"N-op\", \"edit\", \"internal/fencing/gate.go\",\n47|     [(\"case OperationActivation, OperationInput, OperationMutation, OperationCheckpoint, OperationRestore:\",\n48|        'case OperationActivation, OperationInput, OperationMutation, OperationCheckpoint, OperationRestore, \"bogus\":')],\n49|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesUnknownOperation$\", \"-count=1\", \"-v\"],\n50|     \"Admit exactly the bogus operation past the enum; the token authorizes and the negative fails by success.\"),\n51|    (\"N-presented-session\", \"edit\", \"internal/fencing/gate.go\",\n52|     [(\"if _, err := scalar.ParseUUIDv7(presented.SessionID); err != nil {\",\n53|        'if _, err := scalar.ParseUUIDv7(presented.SessionID); err != nil && presented.SessionID != \"not-a-uuid\" {')],\n54|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesMalformedPresented$\", \"-count=1\", \"-v\"],\n55|     \"Admit exactly the not-a-uuid session; the refusal degrades to the foreign-session class.\"),\n56|    (\"N-presented-epoch\", \"edit\", \"internal/fencing/gate.go\",\n57|     [(\"if presented.Epoch == 0 {\",\n58|        'if presented.Epoch == 0 && presented.LeaseID != \"' + LEASEA + '\" {')],\n59|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesMalformedPresented$\", \"-count=1\", \"-v\"],\n60|     \"Admit exactly the epoch-zero winner-lease vector; the refusal degrades to the stale class.\"),\n61|    (\"N-presented-lease\", \"edit\", \"internal/fencing/gate.go\",\n62|     [(\"if _, err := scalar.ParseUUIDv4(presented.LeaseID); err != nil {\",\n63|        'if _, err := scalar.ParseUUIDv4(presented.LeaseID); err != nil && presented.LeaseID != \"zzz\" {')],\n64|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesMalformedPresented$\", \"-count=1\", \"-v\"],\n65|     \"Admit exactly the zzz token lease; the refusal degrades to the loser class.\"),\n66|    (\"N-winner\", \"edit\", \"internal/fencing/gate.go\",\n67|     [(\"if observation.Winner.Epoch == 0 || !validLeaseID(observation.Winner.LeaseID) || !validHostID(observation.Winner.HolderHostID) {\",\n68|        'if (observation.Winner.Epoch == 0 || !validLeaseID(observation.Winner.LeaseID) || !validHostID(observation.Winner.HolderHostID)) && !(observation.Winner.Epoch == 0 && observation.Winner.LeaseID == \"zzz\") {')],\n69|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesGarbageWinner$\", \"-count=1\", \"-v\"],\n70|     \"Admit exactly the epoch-zero zzz winner; the refusal degrades to the ahead class.\"),\n71|    (\"N-session-prefix\", \"edit\", \"internal/fencing/gate.go\",\n72|     [(GATE_IMPORT, GATE_IMPORT_STRINGS),\n73|      (\"if presented.SessionID != observation.SessionID {\",\n74|        'if strings.SplitN(presented.SessionID, \"-\", 2)[0] != strings.SplitN(observation.SessionID, \"-\", 2)[0] {')],\n75|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesForeignSession$\", \"-count=1\", \"-v\"],\n76|     \"Compare first UUID segments only; the prefix-sharing session authorizes while the fully foreign session still refuses.\"),\n77|    (\"N-absent\", \"edit\", \"internal/fencing/gate.go\",\n78|     [(\"if !observation.HasWinner {\",\n79|        \"if !observation.HasWinner && !observation.Verified {\")],\n80|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeParksAndRefusesAbsentWinner$\", \"-count=1\", \"-v\"],\n81|     \"Admit exactly the verified absence; the refusal degrades to the malformed-observation class.\"),\n82|    (\"N-verified\", \"edit\", \"internal/fencing/gate.go\",\n83|     [(\"if !observation.Verified {\",\n84|        \"if !observation.Verified && observation.Ambiguous {\")],\n85|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeParksAndRefusesUnverified$\", \"-count=1\", \"-v\"],\n86|     \"Admit exactly the unambiguous unverified observation; the token authorizes and the negative fails by success.\"),\n87|    (\"N-ambiguous\", \"edit\", \"internal/fencing/gate.go\",\n88|     [(\"if observation.Ambiguous {\",\n89|        \"if observation.Ambiguous && !observation.Verified {\")],\n90|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeParksAndRefusesAmbiguous$\", \"-count=1\", \"-v\"],\n91|     \"Admit exactly the verified ambiguity; the token authorizes and the negative fails by success.\"),\n92|    (\"N-handoff\", \"edit\", \"internal/fencing/gate.go\",\n93|     [(\"if observation.HandoffFailed {\",\n94|        \"if observation.HandoffFailed && !observation.Verified {\")],\n95|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeParksAndRefusesFailedHandoff$\", \"-count=1\", \"-v\"],\n96|     \"Admit exactly the verified failed handoff; the token authorizes and the negative fails by success.\"),\n97|    (\"N-grant\", \"edit\", \"internal/fencing/gate.go\",\n98|     [(\"if !observation.HasGrant {\",\n99|        \"if !observation.HasGrant && !observation.Verified {\")],\n100|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesMissingGrant$\", \"-count=1\", \"-v\"],\n101|     \"Admit exactly the verified grantless call; the refusal degrades to the lapsed-grant class.\"),\n102|    (\"N-clock\", \"edit\", \"internal/fencing/gate.go\",\n103|     [(\"if observation.Now.IsZero() {\",\n104|        \"if observation.Now.IsZero() && !observation.Grant.ValidatedAt.IsZero() {\")],\n105|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesMissingClock$\", \"-count=1\", \"-v\"],\n106|     \"Admit exactly the clockless never-validated grant; the token authorizes and the negative fails by success.\"),\n107|    (\"N-expiry\", \"edit\", \"internal/fencing/gate.go\",\n108|     [(\"sessrepo.CheckFencingExpiry(observation.Grant, observation.Policy, observation.Now)\",\n109|        \"sessrepo.CheckFencingExpiry(observation.Grant, sessrepo.FencingPolicy{RefreshInterval: observation.Policy.RefreshInterval + time.Hour}, observation.Now)\")],\n110|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesExpiredGrant$\", \"-count=1\", \"-v\"],\n111|     \"Extend the refresh interval by an hour; the lapsed-by-seconds grant authorizes while the never-validated grant still refuses.\"),\n112|    (\"N-expiry-map\", \"edit\", \"internal/fencing/gate.go\",\n113|     [(\"if errors.Is(err, sessrepo.ErrFencingExpired) {\",\n114|        \"if errors.Is(err, sessrepo.ErrInvalidLease) {\")],\n115|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesExpiredGrant$\", \"-count=1\", \"-v\"],\n116|     \"Swap the lapsed/unusable classes; both vectors change class and the test fails.\"),\n117|    (\"N-remote-prefix\", \"edit\", \"internal/fencing/gate.go\",\n118|     [(GATE_IMPORT, GATE_IMPORT_STRINGS),\n119|      (\"if observation.Winner.HolderHostID != observation.LocalHostID {\",\n120|        'if strings.SplitN(observation.Winner.HolderHostID, \"-\", 2)[0] != strings.SplitN(observation.LocalHostID, \"-\", 2)[0] {')],\n121|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeParksAndRefusesRemote$\", \"-count=1\", \"-v\"],\n122|     \"Compare first UUID segments only; the prefix-sharing remote holder authorizes while the fully remote holder still refuses.\"),\n123|    (\"N-epoch-gte\", \"edit\", \"internal/fencing/gate.go\",\n124|     [(\"epochsEqual := presented.Epoch == observation.Winner.Epoch\",\n125|        \"epochsEqual := presented.Epoch >= observation.Winner.Epoch\")],\n126|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesEpochBeyondWinner$|^TestAuthorizeRefusesLowerEpoch$\", \"-count=1\", \"-v\"],\n127|     \"Admit exactly the ahead epoch past the epoch arm; the lower-epoch vectors still refuse stale in the same run.\"),\n128|    (\"N-epoch-lte\", \"edit\", \"internal/fencing/gate.go\",\n129|     [(\"epochsEqual := presented.Epoch == observation.Winner.Epoch\",\n130|        \"epochsEqual := presented.Epoch <= observation.Winner.Epoch\")],\n131|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesEpochBeyondWinner$|^TestAuthorizeRefusesLowerEpoch$\", \"-count=1\", \"-v\"],\n132|     \"Admit exactly the lower epoch past the epoch arm; the ahead-epoch vectors still refuse in the same run.\"),\n133|    (\"N-lease-vector\", \"edit\", \"internal/fencing/gate.go\",\n134|     [(\"if presented.LeaseID != observation.Winner.LeaseID {\",\n135|        'if presented.LeaseID != observation.Winner.LeaseID && presented.LeaseID != \"' + LEASEC + '\" {')],\n136|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesSameEpochLoser$\", \"-count=1\", \"-v\"],\n137|     \"Admit exactly the standard loser; the prefix-sharing loser still refuses.\"),\n138|    (\"N-lease-prefix\", \"edit\", \"internal/fencing/gate.go\",\n139|     [(GATE_IMPORT, GATE_IMPORT_STRINGS),\n140|      (\"if presented.LeaseID != observation.Winner.LeaseID {\",\n141|        'if strings.SplitN(presented.LeaseID, \"-\", 2)[0] != strings.SplitN(observation.Winner.LeaseID, \"-\", 2)[0] {')],\n142|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesSameEpochLoser$\", \"-count=1\", \"-v\"],\n143|     \"Compare first UUID segments only; the prefix-sharing loser authorizes while the standard loser still refuses.\"),\n144|    (\"N-launch-add-input\", \"edit\", \"internal/fencing/gate.go\",\n145|     [(\"return op == OperationActivation || op == OperationRestore\",\n146|        \"return op == OperationActivation || op == OperationRestore || op == OperationInput\")],\n147|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeParksAndRefusesRemote$\", \"-count=1\", \"-v\"],\n148|     \"Park input instead of refusing: the remote input vector parks and the hard-refusal assertion fails.\"),\n149|    (\"N-launch-drop-restore\", \"edit\", \"internal/fencing/gate.go\",\n150|     [(\"return op == OperationActivation || op == OperationRestore\",\n151|        \"return op == OperationActivation\")],\n152|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeParksAndRefusesRemote$\", \"-count=1\", \"-v\"],\n153|     \"Refuse restore instead of parking: the remote restore vector refuses hard and the park assertion fails.\"),\n154|    (\"N-bind-seal\", \"edit\", \"internal/fencing/token.go\",\n155|     [(\"if token.seal == nil || token.seal.token == nil {\",\n156|        \"if token.seal == nil {\")],\n157|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestBindRefusesForgedToken$\", \"-count=1\", \"-v\"],\n158|     \"Admit exactly the field-assembled seal; the zero token still refuses.\"),\n159|    (\"N-bind-op\", \"edit\", \"internal/fencing/token.go\",\n160|     [(\"case ProviderQuiesce, ProviderCapture, ProviderMaterialize:\",\n161|        'case ProviderQuiesce, ProviderCapture, ProviderMaterialize, \"bogus\":')],\n162|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestBindRefusesUnknownOperation$\", \"-count=1\", \"-v\"],\n163|     \"Admit exactly the bogus provider operation; the projection mints and the negative fails by success.\"),\n164|    (\"N-term-presented\", \"edit\", \"internal/fencing/terminate.go\",\n165|     [(\"if _, err := scalar.ParseUUIDv4(presented.LeaseID); err != nil {\",\n166|        'if _, err := scalar.ParseUUIDv4(presented.LeaseID); err != nil && presented.LeaseID != \"zzz\" {')],\n167|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestTerminateStaleRefusesMalformedTarget$\", \"-count=1\", \"-v\"],\n168|     \"Admit exactly the zzz target lease; the termination authorizes and the negative fails by success.\"),\n169|    (\"N-term-winner\", \"edit\", \"internal/fencing/terminate.go\",\n170|     [(\"if winner.Epoch == 0 || !validLeaseID(winner.LeaseID) {\",\n171|        'if (winner.Epoch == 0 || !validLeaseID(winner.LeaseID)) && !(winner.Epoch == 0 && winner.LeaseID == \"zzz\") {')],\n172|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestTerminateStaleRefusesGarbageWinner$\", \"-count=1\", \"-v\"],\n173|     \"Admit exactly the epoch-zero zzz winner; the termination authorizes and the negative fails by success.\"),\n174|    (\"N-term-absent\", \"edit\", \"internal/fencing/terminate.go\",\n175|     [(\"if !hasWinner {\",\n176|        \"if !hasWinner && !forceRecovery {\")],\n177|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestTerminateStaleRefusesWithoutWinner$\", \"-count=1\", \"-v\"],\n178|     \"Admit exactly the forced winnerless call; the refusal degrades to the malformed-observation class.\"),\n179|    (\"N-term-force\", \"edit\", \"internal/fencing/terminate.go\",\n180|     [(\"if !forceRecovery {\",\n181|        \"if !forceRecovery && !diagnosticsPreserved {\")],\n182|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestTerminateStaleRefusesWithoutForce$\", \"-count=1\", \"-v\"],\n183|     \"Admit exactly the unforced diagnosed call; the termination authorizes and the negative fails by success.\"),\n184|    (\"N-term-diag\", \"edit\", \"internal/fencing/terminate.go\",\n185|     [(\"if !diagnosticsPreserved {\",\n186|        \"if !diagnosticsPreserved && !forceRecovery {\")],\n187|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestTerminateStaleRefusesWithoutDiagnostics$\", \"-count=1\", \"-v\"],\n188|     \"Admit exactly the undiagnosed forced call; the termination authorizes and the negative fails by success.\"),\n189|    (\"N-term-session\", \"edit\", \"internal/fencing/terminate.go\",\n190|     [(\"if presented.SessionID != winner.SessionID {\",\n191|        'if presented.SessionID != winner.SessionID && presented.SessionID != \"' + SESSIONB + '\" {')],\n192|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestTerminateStaleRefusesForeignSession$\", \"-count=1\", \"-v\"],\n193|     \"Admit exactly the prefix-sharing foreign target; the refusal degrades to the live-owner class.\"),\n194|    (\"N-term-live\", \"edit\", \"internal/fencing/terminate.go\",\n195|     [(\"if presented.Epoch == winner.Epoch && presented.LeaseID == winner.LeaseID {\",\n196|        \"if presented.Epoch == winner.Epoch && presented.LeaseID == winner.LeaseID && winner.Epoch != 1 {\")],\n197|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestTerminateStaleRefusesLiveOwner$\", \"-count=1\", \"-v\"],\n198|     \"Admit exactly the epoch-1 live owner; the epoch-2 owner still refuses.\"),\n199|    (\"T-census-alias\", \"add\", \"internal/fencing/zzplant.go\",\n200|     \"package fencing\\n\\ntype plantBackdoor = leaseSeal\\n\\nfunc plantAlias() LeaseToken { return LeaseToken{seal: &plantBackdoor{}} }\\n\",\n201|     [\"go\", \"test\", \"./internal/fencing\", \"-count=1\", \"-v\"],\n202|     \"Preserve the leaseSeal token while constructing through an alias; the census rejects the plant and the full behavioral suite runs.\"),\n203|    (\"C-harmless-comment\", \"edit\", \"internal/fencing/gate.go\",\n204|     [(\"// Arm order is precedence: malformed calls die first, then foreign\",\n205|        \"// Arm order is precedence: malformed calls die first, then foreign\\n// classifier control: comment only, no behavior change.\")],\n206|     [\"go\", \"test\", \"./internal/fencing\", \"-count=1\"],\n207|     \"Applied control: a behavior-preserving plant survives through the same instrument.\"),\n208|    (\"C-not-applied\", \"edit\", \"internal/fencing/gate.go\",\n209|     [(\"TOKEN_THAT_IS_NOT_PRESENT\", \"replacement\")],\n210|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeAdmitsWinnerExactEpochAllOperations$\", \"-count=1\", \"-v\"],\n211|     \"Application control: missing patch is not a killed mutant.\"),\n212|    (\"C-compile-failure\", \"edit\", \"internal/fencing/gate.go\",\n213|     [(\"package fencing\", \"package fencing\\nthis is invalid Go\")],\n214|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeAdmitsWinnerExactEpochAllOperations$\", \"-count=1\", \"-v\"],\n215|     \"Compilation control: no named failed behavioral test is not a kill.\"),\n216|]\n217|\n218|selected = [row for row in MUTANTS if name_filter in row[0]] if name_filter else MUTANTS\n219|if name_filter and not selected:\n220|    raise SystemExit(f\"no mutants match filter {name_filter!r}\")\n221|\n222|\n223|def run_command(label, command, log_name):\n224|    with (output / log_name).open(\"w\") as log:\n225|        process = subprocess.run(command, cwd=copy, stdout=log, stderr=subprocess.STDOUT, timeout=300)\n226|    return process.returncode\n227|\n228|\n229|with (output / f\"control-before-{tag}.log\").open(\"w\") as log:\n230|    before = subprocess.run([\"go\", \"test\", \"./internal/fencing\", \"-count=1\"], cwd=copy, stdout=log, stderr=subprocess.STDOUT, timeout=300)\n231|results.append(dict(mutant=f\"control-before-{tag}\", classification=\"CONTROL\", exit=before.returncode))\n232|if before.returncode:\n233|    raise SystemExit(\"baseline failed\")\n234|\n235|\n236|def classify(name, command, bound):\n237|    try:\n238|        with (output / (name + \".log\")).open(\"w\") as log:\n239|            process = subprocess.run(command, cwd=copy, stdout=log, stderr=subprocess.STDOUT, timeout=300)\n240|        text = (output / (name + \".log\")).read_text()\n241|        failures = re.findall(r\"^\\s*--- FAIL: ([^ ]+)\", text, re.M)\n242|        ran_tests = re.findall(r\"^=== RUN \", text, re.M)\n243|        # Non-verbose full-suite runs report failures as \"^--- FAIL:\" and\n244|        # \"FAIL\\tpackage\" lines without === RUN markers; accept either.\n245|        if not ran_tests:\n246|            ran_tests = re.findall(r\"^(ok|FAIL)\\s\", text, re.M)\n247|        classification = \"COMPILE_OR_HARNESS_FAILURE\" if not ran_tests else (\"SURVIVED\" if process.returncode == 0 else (\"KILLED\" if failures else \"COMPILE_OR_HARNESS_FAILURE\"))\n248|        results.append(dict(mutant=name, classification=classification, exit=process.returncode, failed_tests=failures, bound=bound, command=command))\n249|        print(name, classification, process.returncode, \", \".join(failures), flush=True)\n250|    except subprocess.TimeoutExpired:\n251|        results.append(dict(mutant=name, classification=\"TIMEOUT\", bound=bound, command=command))\n252|        print(name, \"TIMEOUT\", flush=True)\n253|\n254|\n255|def run_edit(name, path, edits, command, bound):\n256|    source = copy / path\n257|    original = source.read_text()\n258|    for old, _ in edits:\n259|        if original.count(old) != 1:\n260|            results.append(dict(mutant=name, classification=\"NOT_APPLIED\", count=original.count(old), bound=bound))\n261|            print(name, \"NOT_APPLIED\", original.count(old), flush=True)\n262|            return\n263|    changed = original\n264|    for old, new in edits:\n265|        changed = changed.replace(old, new)\n266|    source.write_text(changed)\n267|    try:\n268|        classify(name, command, bound)\n269|    finally:\n270|        source.write_text(original)\n271|        assert hashlib.sha256(source.read_bytes()).digest() == hashlib.sha256(original.encode()).digest()\n272|\n273|\n274|def run_add(name, path, content, command, bound):\n275|    target = copy / path\n276|    if target.exists():\n277|        results.append(dict(mutant=name, classification=\"NOT_APPLIED\", count=-1, bound=bound))\n278|        print(name, \"NOT_APPLIED exists\", flush=True)\n279|        return\n280|    target.write_text(content)\n281|    try:\n282|        classify(name, command, bound)\n283|    finally:\n284|        target.unlink(missing_ok=True)\n285|        assert not target.exists()\n286|\n287|\n288|for name, kind, path, payload, command, bound in selected:\n289|    if kind == \"edit\":\n290|        run_edit(name, path, payload, command, bound)\n291|    else:\n292|        run_add(name, path, payload, command, bound)\n293|\n294|with (output / f\"control-after-{tag}.log\").open(\"w\") as log:\n295|    after = subprocess.run([\"go\", \"test\", \"./internal/fencing\", \"-count=1\"], cwd=copy, stdout=log, stderr=subprocess.STDOUT, timeout=300)\n296|results.append(dict(mutant=f\"control-after-{tag}\", classification=\"CONTROL\", exit=after.returncode))\n297|(output / f\"mutants-{tag}.json\").write_text(json.dumps(results, indent=2) + \"\\n\")\n298|bad = [row for row in results if (row[\"mutant\"].startswith(\"N-\") or row[\"mutant\"].startswith(\"T-\")) and row[\"classification\"] != \"KILLED\"]\n299|raise SystemExit(1 if bad or after.returncode else 0)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6ad","stream":{"kind":"session","id":"01a0ae2e-304f-7791-b344-a738da145935"},"sequence":433,"recorded_at":1780531400000861,"record_type":"event","durability":"durable","causation_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","run_stream":{"kind":"run","id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3"},"task_stream":{"kind":"task","id":"01a0ae2f-2685-77a2-af02-b051d32fa35e"},"task_id":"01a0ae2f-2685-77a2-af02-b051d32fa35e","event":{"kind":"completed","task_id":"01a0ae2f-2685-77a2-af02-b051d32fa35e"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6af","stream":{"kind":"session","id":"01a0ae2e-304f-7791-b344-a738da145935"},"sequence":434,"recorded_at":1780531400000863,"record_type":"event","durability":"durable","causation_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","run_stream":{"kind":"run","id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3"},"call_id":"call_01a0ae2f1fd171f0a1bc2a9f939e186e","text":"{\n  \"chunk_id\": \"exec-7-1\",\n  \"command\": \"task-board --help 2>&1 | head -n 80; echo ===; task-board m --help 2>&1 | head -n 80\",\n  \"description\": \"Inspect task-board CLI usage\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Manage a file-based task board with epics, stories, tasks, and bugs.\\n\\nUsage:\\n  task-board [command]\\n\\nAvailable Commands:\\n  admin                  Server administration (users, tokens, access)\\n  boards                 List boards accessible to the current user (remote mode)\\n  claude                 Launch Claude through the Task-board Session Manager\\n  codex                  Attach Codex to the Task-board Session Manager\\n  completion             Generate the autocompletion script for the specified shell\\n  export                 Export current board into a tar.gz archive\\n  goal                   Read and align the board-scoped parent primary goal\\n  grep                   Full-text search across board files\\n  handoff                Verify role handoff evidence and move to the role end status\\n  help                   Help about any command\\n  import                 Import a tar.gz archive into the current board\\n  init                   Install task-board project integrations\\n  limits                 Inspect and control provider rate-limit state\\n  login                  Store a token for the current remote\\n  logout                 Remove active user's token for current remote\\n  m                      Execute a mutation (write operation)\\n  migrate-keychain       Import legacy remote credentials into macOS Keychain\\n  migrate-project-config Preview or apply guarded deprecated project-config alias migration\\n  plan                   Show execution plan with phases and critical path\\n  q                      Query the board with a mini DSL\\n  repair-links           List or remove unsupported container dependency links\\n  resource               Upload, update, download, and delete board resources\\n  self-update            Update task-board to the latest version\\n  session                Inspect and stop Task-board Session Manager sessions\\n  spawn                  Queue an agent spawn run for a board task\\n  switch-user            Switch active user for current remote\\n  tree                   Show board as hierarchical tree\\n  tui                    Launch interactive TUI\\n  validate               Validate board structure\\n  whoami                 Show current remote and active user\\n  worktree               Inspect and repair managed Story workspaces\\n\\nFlags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n  -h, --help                     help for task-board\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n  -v, --version                  version for task-board\\n\\nUse \\\"task-board [command] --help\\\" for more information about a command.\\n===\\nExecute a write operation against the board using the DSL.\\n\\nMutations:\\n  set_status(ID, status=..., commit_ack=scope_committed?)\\n                                        Change status; acknowledge enforced done transitions\\n  normalize_legacy_status(ID, expected_raw=..., status=...)\\n                                        Repair one exact unparseable raw status (local boards)\\n  handoff(ID, role=..., status=...)     Verify checklist/outcome evidence and change status\\n  set_estimate(ID, estimate=..., ...)  Set Task/Bug story-point estimate\\n  create(type=..., name=..., ...)      Create element\\n  set_details(ID, title=..., ...)      Update README fields\\n  rename(ID, name=...)                 Rename element name/slug\\n  delete(ID)                           Delete element (destructive)\\n  assign(ID, agent=...)                Assign agent\\n  unassign(ID)                         Remove assignment\\n  link(ID, blocked_by=...)             Add dependency\\n  unlink(ID, blocked_by=...)           Remove dependency\\n  check_item(ID, item=N)              Check checklist item\\n  uncheck_item(ID, item=N)            Uncheck checklist item\\n  add_checklist_item(ID, text=...)     Add checklist item\\n  remove_checklist_item(ID, item=N)    Remove obsolete checklist item (destructive)\\n  set_notes(ID, text=..., set=bool?)   Append/set notes\\n  set_parent(ID, parent=...)           Move to new parent\\n  accept_cr(ID, revision=N, evidence=...) Record a reviewer acceptance of a Change Request revision (local board only)\\n  integrate_external(ID, evidence=...)     Close accepted empty-delta external work by evidence (local board only)\\n  withdraw_cr(ID, revision=N, reason=...) Retire an unintegrated revision (local board only)\\n  defer_cr(ID, revision=N, reason=...)    Mark an accepted revision deferred by human decision (local board only)\\n  undefer_cr(ID, revision=N)              Clear the deferral marker (local board only)\\n  add_resource(ID, name=..., content=..., type=..., description=...)\\n  update_resource(ID, name=..., content=..., type=..., description=...)\\n  delete_resource(ID, name=...)        Delete resource (destructive)\\n  correct_activity(ID, target_event_id=..., kind=..., reason=...)\\n                                        Privileged append-only correction (destructive)\\n\\nAuth (always local):\\n  login(user=..., token=...)           Store token in credentials file\\n  logout()                             Remove active user's token\\n  switch_user(user=...)                Switch active user for remote\\n\\nSafety:\\n  --dry-run     Preview mutation without applying\\n  --confirm     Required for every schema-classified destructive mutation\\n\\nIntrospection:\\n  task-board q 'schema(mutation=NAME)' Show one mutation signature\\n\\nExamples:\\n  task-board m --format json 'set_status(TASK-260218-abc, status=development)'\\n  task-board m --format json 'normalize_legacy_status(STORY-260713-72b914, expected_raw=\\\"in-progress\\\", status=development)'\\n  task-board m --format json 'set_status(STORY-260218-abc, status=done, commit_ack=scope_committed)'\\n  task-board m --format json 'set_estimate(TASK-260218-abc, estimate=estimated, scale=fibonacci, number=5)'\\n  task-board m --format compact 'assign(TASK-260218-abc, agent=claude-opus)'\\n  task-board m --format json --dry-run 'delete(TASK-260218-abc)'\\n  task-board m --format json --dry-run 'remove_checklist_item(TASK-260218-abc, item=2)'\\n  task-board m --format json --confirm 'remove_checklist_item(TASK-260218-abc, item=2)'\\n  task-board m --format json --confirm 'delete(TASK-260218-abc)'\\n\\nUsage:\\n  task-board m <mutation> [flags]\\n\\nAliases:\\n  m, mutate\\n\\nFlags:\\n      --confirm         Confirm destructive mutations\\n      --dry-run         Preview the mutation without applying changes\\n      --format string   Output format: \\\"json\\\" or \\\"compact\\\"/\\\"llm\\\" (default \\\"json\\\")\\n  -h, --help            help for m\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\",\n  \"original_output_bytes\": 7494,\n  \"original_output_tokens\": 1874,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6b1","stream":{"kind":"session","id":"01a0ae2e-304f-7791-b344-a738da145935"},"sequence":435,"recorded_at":1780531400000865,"record_type":"event","durability":"durable","causation_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","run_stream":{"kind":"run","id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3"},"call_id":"call_01a0ae2f22407534b06dd5bd2db5806a","text":"Read text file `internal/fencing/testdata/mutate.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Run isolated behavioral mutants for the fencing gates; never modify the managed Story checkout.\n3|Usage: python3 internal/fencing/testdata/mutate.py /absolute/evidence/directory [name-filter]\n4|Every subprocess runs directly, logs its real exit, and has a bounded timeout.\n5|The battery proves each fencing gate by narrowing, never by deletion:\n6|every N-mutant keeps its gate present and weakens it to admit exactly one\n7|member of the class the gate must reject, and a named behavioral test must\n8|fail. The T-mutant preserves the searched-for leaseSeal token while\n9|constructing through an alias, and the harness executes the full behavioral\n10|suite for it, not only the static census. An optional name-filter runs a\n11|subset (substring match); results merge by concatenating mutants JSON rows.\n12|\"\"\"\n13|import hashlib\n14|import json\n15|from pathlib import Path\n16|import re\n17|import shutil\n18|import subprocess\n19|import sys\n20|\n21|root = Path(__file__).resolve().parents[3]\n22|output = Path(sys.argv[1]).resolve()\n23|output.mkdir(parents=True, exist_ok=True)\n24|name_filter = sys.argv[2] if len(sys.argv) > 2 else \"\"\n25|tag = re.sub(r\"[^a-z0-9]+\", \"-\", name_filter.lower()).strip(\"-\") or \"full\"\n26|copy = output / (\"mutation-source-\" + tag)\n27|if copy.exists():\n28|    raise SystemExit(\"refusing to overwrite an existing mutation source\")\n29|copy.mkdir()\n30|shutil.copytree(root / \"internal\", copy / \"internal\")\n31|for name in (\"go.mod\", \"go.sum\", \"README.md\", \"LOGBOOK.md\"):\n32|    shutil.copy2(root / name, copy / name)\n33|results = []\n34|\n35|LEASEA = \"aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee\"\n36|LEASEC = \"cccccccc-dddd-4eee-8fff-111111111111\"\n37|SESSIONB = \"0198f4c8-3e70-7a11-8a2b-1234567890ac\"\n38|\n39|GATE_IMPORT = '\\t\"errors\"\\n\\t\"fmt\"\\n\\t\"time\"'\n40|GATE_IMPORT_STRINGS = '\\t\"errors\"\\n\\t\"fmt\"\\n\\t\"strings\"\\n\\t\"time\"'\n41|\n42|# Each mutant: (name, kind, file, edits|add-path+content, command, bound).\n43|# kind edit: [(old, new)] applied to file, each anchored exactly once.\n44|# kind add: writes path with content for the run, then removes it.\n45|MUTANTS = [\n46|    (\"N-op\", \"edit\", \"internal/fencing/gate.go\",\n47|     [(\"case OperationActivation, OperationInput, OperationMutation, OperationCheckpoint, OperationRestore:\",\n48|        'case OperationActivation, OperationInput, OperationMutation, OperationCheckpoint, OperationRestore, \"bogus\":')],\n49|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesUnknownOperation$\", \"-count=1\", \"-v\"],\n50|     \"Admit exactly the bogus operation past the enum; the token authorizes and the negative fails by success.\"),\n51|    (\"N-presented-session\", \"edit\", \"internal/fencing/gate.go\",\n52|     [(\"if _, err := scalar.ParseUUIDv7(presented.SessionID); err != nil {\",\n53|        'if _, err := scalar.ParseUUIDv7(presented.SessionID); err != nil && presented.SessionID != \"not-a-uuid\" {')],\n54|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesMalformedPresented$\", \"-count=1\", \"-v\"],\n55|     \"Admit exactly the not-a-uuid session; the refusal degrades to the foreign-session class.\"),\n56|    (\"N-presented-epoch\", \"edit\", \"internal/fencing/gate.go\",\n57|     [(\"if presented.Epoch == 0 {\",\n58|        'if presented.Epoch == 0 && presented.LeaseID != \"' + LEASEA + '\" {')],\n59|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesMalformedPresented$\", \"-count=1\", \"-v\"],\n60|     \"Admit exactly the epoch-zero winner-lease vector; the refusal degrades to the stale class.\"),\n61|    (\"N-presented-lease\", \"edit\", \"internal/fencing/gate.go\",\n62|     [(\"if _, err := scalar.ParseUUIDv4(presented.LeaseID); err != nil {\",\n63|        'if _, err := scalar.ParseUUIDv4(presented.LeaseID); err != nil && presented.LeaseID != \"zzz\" {')],\n64|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesMalformedPresented$\", \"-count=1\", \"-v\"],\n65|     \"Admit exactly the zzz token lease; the refusal degrades to the loser class.\"),\n66|    (\"N-winner\", \"edit\", \"internal/fencing/gate.go\",\n67|     [(\"if observation.Winner.Epoch == 0 || !validLeaseID(observation.Winner.LeaseID) || !validHostID(observation.Winner.HolderHostID) {\",\n68|        'if (observation.Winner.Epoch == 0 || !validLeaseID(observation.Winner.LeaseID) || !validHostID(observation.Winner.HolderHostID)) && !(observation.Winner.Epoch == 0 && observation.Winner.LeaseID == \"zzz\") {')],\n69|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesGarbageWinner$\", \"-count=1\", \"-v\"],\n70|     \"Admit exactly the epoch-zero zzz winner; the refusal degrades to the ahead class.\"),\n71|    (\"N-session-prefix\", \"edit\", \"internal/fencing/gate.go\",\n72|     [(GATE_IMPORT, GATE_IMPORT_STRINGS),\n73|      (\"if presented.SessionID != observation.SessionID {\",\n74|        'if strings.SplitN(presented.SessionID, \"-\", 2)[0] != strings.SplitN(observation.SessionID, \"-\", 2)[0] {')],\n75|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesForeignSession$\", \"-count=1\", \"-v\"],\n76|     \"Compare first UUID segments only; the prefix-sharing session authorizes while the fully foreign session still refuses.\"),\n77|    (\"N-absent\", \"edit\", \"internal/fencing/gate.go\",\n78|     [(\"if !observation.HasWinner {\",\n79|        \"if !observation.HasWinner && !observation.Verified {\")],\n80|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeParksAndRefusesAbsentWinner$\", \"-count=1\", \"-v\"],\n81|     \"Admit exactly the verified absence; the refusal degrades to the malformed-observation class.\"),\n82|    (\"N-verified\", \"edit\", \"internal/fencing/gate.go\",\n83|     [(\"if !observation.Verified {\",\n84|        \"if !observation.Verified && observation.Ambiguous {\")],\n85|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeParksAndRefusesUnverified$\", \"-count=1\", \"-v\"],\n86|     \"Admit exactly the unambiguous unverified observation; the token authorizes and the negative fails by success.\"),\n87|    (\"N-ambiguous\", \"edit\", \"internal/fencing/gate.go\",\n88|     [(\"if observation.Ambiguous {\",\n89|        \"if observation.Ambiguous && !observation.Verified {\")],\n90|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeParksAndRefusesAmbiguous$\", \"-count=1\", \"-v\"],\n91|     \"Admit exactly the verified ambiguity; the token authorizes and the negative fails by success.\"),\n92|    (\"N-handoff\", \"edit\", \"internal/fencing/gate.go\",\n93|     [(\"if observation.HandoffFailed {\",\n94|        \"if observation.HandoffFailed && !observation.Verified {\")],\n95|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeParksAndRefusesFailedHandoff$\", \"-count=1\", \"-v\"],\n96|     \"Admit exactly the verified failed handoff; the token authorizes and the negative fails by success.\"),\n97|    (\"N-grant\", \"edit\", \"internal/fencing/gate.go\",\n98|     [(\"if !observation.HasGrant {\",\n99|        \"if !observation.HasGrant && !observation.Verified {\")],\n100|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesMissingGrant$\", \"-count=1\", \"-v\"],\n101|     \"Admit exactly the verified grantless call; the refusal degrades to the lapsed-grant class.\"),\n102|    (\"N-clock\", \"edit\", \"internal/fencing/gate.go\",\n103|     [(\"if observation.Now.IsZero() {\",\n104|        \"if observation.Now.IsZero() && !observation.Grant.ValidatedAt.IsZero() {\")],\n105|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesMissingClock$\", \"-count=1\", \"-v\"],\n106|     \"Admit exactly the clockless never-validated grant; the token authorizes and the negative fails by success.\"),\n107|    (\"N-expiry\", \"edit\", \"internal/fencing/gate.go\",\n108|     [(\"sessrepo.CheckFencingExpiry(observation.Grant, observation.Policy, observation.Now)\",\n109|        \"sessrepo.CheckFencingExpiry(observation.Grant, sessrepo.FencingPolicy{RefreshInterval: observation.Policy.RefreshInterval + time.Hour}, observation.Now)\")],\n110|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesExpiredGrant$\", \"-count=1\", \"-v\"],\n111|     \"Extend the refresh interval by an hour; the lapsed-by-seconds grant authorizes while the never-validated grant still refuses.\"),\n112|    (\"N-expiry-map\", \"edit\", \"internal/fencing/gate.go\",\n113|     [(\"if errors.Is(err, sessrepo.ErrFencingExpired) {\",\n114|        \"if errors.Is(err, sessrepo.ErrInvalidLease) {\")],\n115|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesExpiredGrant$\", \"-count=1\", \"-v\"],\n116|     \"Swap the lapsed/unusable classes; both vectors change class and the test fails.\"),\n117|    (\"N-remote-prefix\", \"edit\", \"internal/fencing/gate.go\",\n118|     [(GATE_IMPORT, GATE_IMPORT_STRINGS),\n119|      (\"if observation.Winner.HolderHostID != observation.LocalHostID {\",\n120|        'if strings.SplitN(observation.Winner.HolderHostID, \"-\", 2)[0] != strings.SplitN(observation.LocalHostID, \"-\", 2)[0] {')],\n121|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeParksAndRefusesRemote$\", \"-count=1\", \"-v\"],\n122|     \"Compare first UUID segments only; the prefix-sharing remote holder authorizes while the fully remote holder still refuses.\"),\n123|    (\"N-epoch-gte\", \"edit\", \"internal/fencing/gate.go\",\n124|     [(\"epochsEqual := presented.Epoch == observation.Winner.Epoch\",\n125|        \"epochsEqual := presented.Epoch >= observation.Winner.Epoch\")],\n126|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesEpochBeyondWinner$|^TestAuthorizeRefusesLowerEpoch$\", \"-count=1\", \"-v\"],\n127|     \"Admit exactly the ahead epoch past the epoch arm; the lower-epoch vectors still refuse stale in the same run.\"),\n128|    (\"N-epoch-lte\", \"edit\", \"internal/fencing/gate.go\",\n129|     [(\"epochsEqual := presented.Epoch == observation.Winner.Epoch\",\n130|        \"epochsEqual := presented.Epoch <= observation.Winner.Epoch\")],\n131|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesEpochBeyondWinner$|^TestAuthorizeRefusesLowerEpoch$\", \"-count=1\", \"-v\"],\n132|     \"Admit exactly the lower epoch past the epoch arm; the ahead-epoch vectors still refuse in the same run.\"),\n133|    (\"N-lease-vector\", \"edit\", \"internal/fencing/gate.go\",\n134|     [(\"if presented.LeaseID != observation.Winner.LeaseID {\",\n135|        'if presented.LeaseID != observation.Winner.LeaseID && presented.LeaseID != \"' + LEASEC + '\" {')],\n136|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesSameEpochLoser$\", \"-count=1\", \"-v\"],\n137|     \"Admit exactly the standard loser; the prefix-sharing loser still refuses.\"),\n138|    (\"N-lease-prefix\", \"edit\", \"internal/fencing/gate.go\",\n139|     [(GATE_IMPORT, GATE_IMPORT_STRINGS),\n140|      (\"if presented.LeaseID != observation.Winner.LeaseID {\",\n141|        'if strings.SplitN(presented.LeaseID, \"-\", 2)[0] != strings.SplitN(observation.Winner.LeaseID, \"-\", 2)[0] {')],\n142|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeRefusesSameEpochLoser$\", \"-count=1\", \"-v\"],\n143|     \"Compare first UUID segments only; the prefix-sharing loser authorizes while the standard loser still refuses.\"),\n144|    (\"N-launch-add-input\", \"edit\", \"internal/fencing/gate.go\",\n145|     [(\"return op == OperationActivation || op == OperationRestore\",\n146|        \"return op == OperationActivation || op == OperationRestore || op == OperationInput\")],\n147|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeParksAndRefusesRemote$\", \"-count=1\", \"-v\"],\n148|     \"Park input instead of refusing: the remote input vector parks and the hard-refusal assertion fails.\"),\n149|    (\"N-launch-drop-restore\", \"edit\", \"internal/fencing/gate.go\",\n150|     [(\"return op == OperationActivation || op == OperationRestore\",\n151|        \"return op == OperationActivation\")],\n152|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeParksAndRefusesRemote$\", \"-count=1\", \"-v\"],\n153|     \"Refuse restore instead of parking: the remote restore vector refuses hard and the park assertion fails.\"),\n154|    (\"N-bind-seal\", \"edit\", \"internal/fencing/token.go\",\n155|     [(\"if token.seal == nil || token.seal.token == nil {\",\n156|        \"if token.seal == nil {\")],\n157|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestBindRefusesForgedToken$\", \"-count=1\", \"-v\"],\n158|     \"Admit exactly the field-assembled seal; the zero token still refuses.\"),\n159|    (\"N-bind-op\", \"edit\", \"internal/fencing/token.go\",\n160|     [(\"case ProviderQuiesce, ProviderCapture, ProviderMaterialize:\",\n161|        'case ProviderQuiesce, ProviderCapture, ProviderMaterialize, \"bogus\":')],\n162|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestBindRefusesUnknownOperation$\", \"-count=1\", \"-v\"],\n163|     \"Admit exactly the bogus provider operation; the projection mints and the negative fails by success.\"),\n164|    (\"N-term-presented\", \"edit\", \"internal/fencing/terminate.go\",\n165|     [(\"if _, err := scalar.ParseUUIDv4(presented.LeaseID); err != nil {\",\n166|        'if _, err := scalar.ParseUUIDv4(presented.LeaseID); err != nil && presented.LeaseID != \"zzz\" {')],\n167|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestTerminateStaleRefusesMalformedTarget$\", \"-count=1\", \"-v\"],\n168|     \"Admit exactly the zzz target lease; the termination authorizes and the negative fails by success.\"),\n169|    (\"N-term-winner\", \"edit\", \"internal/fencing/terminate.go\",\n170|     [(\"if winner.Epoch == 0 || !validLeaseID(winner.LeaseID) {\",\n171|        'if (winner.Epoch == 0 || !validLeaseID(winner.LeaseID)) && !(winner.Epoch == 0 && winner.LeaseID == \"zzz\") {')],\n172|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestTerminateStaleRefusesGarbageWinner$\", \"-count=1\", \"-v\"],\n173|     \"Admit exactly the epoch-zero zzz winner; the termination authorizes and the negative fails by success.\"),\n174|    (\"N-term-absent\", \"edit\", \"internal/fencing/terminate.go\",\n175|     [(\"if !hasWinner {\",\n176|        \"if !hasWinner && !forceRecovery {\")],\n177|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestTerminateStaleRefusesWithoutWinner$\", \"-count=1\", \"-v\"],\n178|     \"Admit exactly the forced winnerless call; the refusal degrades to the malformed-observation class.\"),\n179|    (\"N-term-force\", \"edit\", \"internal/fencing/terminate.go\",\n180|     [(\"if !forceRecovery {\",\n181|        \"if !forceRecovery && !diagnosticsPreserved {\")],\n182|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestTerminateStaleRefusesWithoutForce$\", \"-count=1\", \"-v\"],\n183|     \"Admit exactly the unforced diagnosed call; the termination authorizes and the negative fails by success.\"),\n184|    (\"N-term-diag\", \"edit\", \"internal/fencing/terminate.go\",\n185|     [(\"if !diagnosticsPreserved {\",\n186|        \"if !diagnosticsPreserved && !forceRecovery {\")],\n187|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestTerminateStaleRefusesWithoutDiagnostics$\", \"-count=1\", \"-v\"],\n188|     \"Admit exactly the undiagnosed forced call; the termination authorizes and the negative fails by success.\"),\n189|    (\"N-term-session\", \"edit\", \"internal/fencing/terminate.go\",\n190|     [(\"if presented.SessionID != winner.SessionID {\",\n191|        'if presented.SessionID != winner.SessionID && presented.SessionID != \"' + SESSIONB + '\" {')],\n192|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestTerminateStaleRefusesForeignSession$\", \"-count=1\", \"-v\"],\n193|     \"Admit exactly the prefix-sharing foreign target; the refusal degrades to the live-owner class.\"),\n194|    (\"N-term-live\", \"edit\", \"internal/fencing/terminate.go\",\n195|     [(\"if presented.Epoch == winner.Epoch && presented.LeaseID == winner.LeaseID {\",\n196|        \"if presented.Epoch == winner.Epoch && presented.LeaseID == winner.LeaseID && winner.Epoch != 1 {\")],\n197|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestTerminateStaleRefusesLiveOwner$\", \"-count=1\", \"-v\"],\n198|     \"Admit exactly the epoch-1 live owner; the epoch-2 owner still refuses.\"),\n199|    (\"T-census-alias\", \"add\", \"internal/fencing/zzplant.go\",\n200|     \"package fencing\\n\\ntype plantBackdoor = leaseSeal\\n\\nfunc plantAlias() LeaseToken { return LeaseToken{seal: &plantBackdoor{}} }\\n\",\n201|     [\"go\", \"test\", \"./internal/fencing\", \"-count=1\", \"-v\"],\n202|     \"Preserve the leaseSeal token while constructing through an alias; the census rejects the plant and the full behavioral suite runs.\"),\n203|    (\"C-harmless-comment\", \"edit\", \"internal/fencing/gate.go\",\n204|     [(\"// Arm order is precedence: malformed calls die first, then foreign\",\n205|        \"// Arm order is precedence: malformed calls die first, then foreign\\n// classifier control: comment only, no behavior change.\")],\n206|     [\"go\", \"test\", \"./internal/fencing\", \"-count=1\"],\n207|     \"Applied control: a behavior-preserving plant survives through the same instrument.\"),\n208|    (\"C-not-applied\", \"edit\", \"internal/fencing/gate.go\",\n209|     [(\"TOKEN_THAT_IS_NOT_PRESENT\", \"replacement\")],\n210|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeAdmitsWinnerExactEpochAllOperations$\", \"-count=1\", \"-v\"],\n211|     \"Application control: missing patch is not a killed mutant.\"),\n212|    (\"C-compile-failure\", \"edit\", \"internal/fencing/gate.go\",\n213|     [(\"package fencing\", \"package fencing\\nthis is invalid Go\")],\n214|     [\"go\", \"test\", \"./internal/fencing\", \"-run\", r\"^TestAuthorizeAdmitsWinnerExactEpochAllOperations$\", \"-count=1\", \"-v\"],\n215|     \"Compilation control: no named failed behavioral test is not a kill.\"),\n216|]\n217|\n218|selected = [row for row in MUTANTS if name_filter in row[0]] if name_filter else MUTANTS\n219|if name_filter and not selected:\n220|    raise SystemExit(f\"no mutants match filter {name_filter!r}\")\n221|\n222|\n223|def run_command(label, command, log_name):\n224|    with (output / log_name).open(\"w\") as log:\n225|        process = subprocess.run(command, cwd=copy, stdout=log, stderr=subprocess.STDOUT, timeout=300)\n226|    return process.returncode\n227|\n228|\n229|with (output / f\"control-before-{tag}.log\").open(\"w\") as log:\n230|    before = subprocess.run([\"go\", \"test\", \"./internal/fencing\", \"-count=1\"], cwd=copy, stdout=log, stderr=subprocess.STDOUT, timeout=300)\n231|results.append(dict(mutant=f\"control-before-{tag}\", classification=\"CONTROL\", exit=before.returncode))\n232|if before.returncode:\n233|    raise SystemExit(\"baseline failed\")\n234|\n235|\n236|def classify(name, command, bound):\n237|    try:\n238|        with (output / (name + \".log\")).open(\"w\") as log:\n239|            process = subprocess.run(command, cwd=copy, stdout=log, stderr=subprocess.STDOUT, timeout=300)\n240|        text = (output / (name + \".log\")).read_text()\n241|        failures = re.findall(r\"^\\s*--- FAIL: ([^ ]+)\", text, re.M)\n242|        ran_tests = re.findall(r\"^=== RUN \", text, re.M)\n243|        # Non-verbose full-suite runs report failures as \"^--- FAIL:\" and\n244|        # \"FAIL\\tpackage\" lines without === RUN markers; accept either.\n245|        if not ran_tests:\n246|            ran_tests = re.findall(r\"^(ok|FAIL)\\s\", text, re.M)\n247|        classification = \"COMPILE_OR_HARNESS_FAILURE\" if not ran_tests else (\"SURVIVED\" if process.returncode == 0 else (\"KILLED\" if failures else \"COMPILE_OR_HARNESS_FAILURE\"))\n248|        results.append(dict(mutant=name, classification=classification, exit=process.returncode, failed_tests=failures, bound=bound, command=command))\n249|        print(name, classification, process.returncode, \", \".join(failures), flush=True)\n250|    except subprocess.TimeoutExpired:\n251|        results.append(dict(mutant=name, classification=\"TIMEOUT\", bound=bound, command=command))\n252|        print(name, \"TIMEOUT\", flush=True)\n253|\n254|\n255|def run_edit(name, path, edits, command, bound):\n256|    source = copy / path\n257|    original = source.read_text()\n258|    for old, _ in edits:\n259|        if original.count(old) != 1:\n260|            results.append(dict(mutant=name, classification=\"NOT_APPLIED\", count=original.count(old), bound=bound))\n261|            print(name, \"NOT_APPLIED\", original.count(old), flush=True)\n262|            return\n263|    changed = original\n264|    for old, new in edits:\n265|        changed = changed.replace(old, new)\n266|    source.write_text(changed)\n267|    try:\n268|        classify(name, command, bound)\n269|    finally:\n270|        source.write_text(original)\n271|        assert hashlib.sha256(source.read_bytes()).digest() == hashlib.sha256(original.encode()).digest()\n272|\n273|\n274|def run_add(name, path, content, command, bound):\n275|    target = copy / path\n276|    if target.exists():\n277|        results.append(dict(mutant=name, classification=\"NOT_APPLIED\", count=-1, bound=bound))\n278|        print(name, \"NOT_APPLIED exists\", flush=True)\n279|        return\n280|    target.write_text(content)\n281|    try:\n282|        classify(name, command, bound)\n283|    finally:\n284|        target.unlink(missing_ok=True)\n285|        assert not target.exists()\n286|\n287|\n288|for name, kind, path, payload, command, bound in selected:\n289|    if kind == \"edit\":\n290|        run_edit(name, path, payload, command, bound)\n291|    else:\n292|        run_add(name, path, payload, command, bound)\n293|\n294|with (output / f\"control-after-{tag}.log\").open(\"w\") as log:\n295|    after = subprocess.run([\"go\", \"test\", \"./internal/fencing\", \"-count=1\"], cwd=copy, stdout=log, stderr=subprocess.STDOUT, timeout=300)\n296|results.append(dict(mutant=f\"control-after-{tag}\", classification=\"CONTROL\", exit=after.returncode))\n297|(output / f\"mutants-{tag}.json\").write_text(json.dumps(results, indent=2) + \"\\n\")\n298|bad = [row for row in results if (row[\"mutant\"].startswith(\"N-\") or row[\"mutant\"].startswith(\"T-\")) and row[\"classification\"] != \"KILLED\"]\n299|raise SystemExit(1 if bad or after.returncode else 0)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6b3","stream":{"kind":"session","id":"01a0ae2e-304f-7791-b344-a738da145935"},"sequence":436,"recorded_at":1780531400000867,"record_type":"event","durability":"durable","causation_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","run_stream":{"kind":"run","id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3"},"call_id":"call_01a0ae2f235f725b877b64457b662c25","text":"Read text file `internal/sessrepo/testdata/mutate.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Run isolated behavioral mutants; never modify the managed Story checkout.\n3|Usage: python3 internal/sessrepo/testdata/mutate.py /absolute/evidence/directory\n4|Every subprocess runs directly, logs its real exit, and has a bounded timeout.\n5|The battery proves each lease-store gate by narrowing, never by deletion:\n6|every N-mutant keeps its gate present and weakens it to admit exactly one\n7|member of the class the gate must reject, and a named behavioral test must\n8|fail. The T-mutant preserves the searched-for timestamp token while changing\n9|behavior, and the harness always executes the behavioral suites.\n10|\"\"\"\n11|import hashlib\n12|import json\n13|from pathlib import Path\n14|import re\n15|import shutil\n16|import subprocess\n17|import sys\n18|\n19|root = Path(__file__).resolve().parents[3]\n20|output = Path(sys.argv[1]).resolve()\n21|output.mkdir(parents=True, exist_ok=True)\n22|copy = output / 'mutation-source'\n23|if copy.exists():\n24|    raise SystemExit('refusing to overwrite an existing mutation source')\n25|copy.mkdir()\n26|shutil.copytree(root / 'internal', copy / 'internal')\n27|for name in ('go.mod', 'go.sum', 'README.md', 'LOGBOOK.md'):\n28|    shutil.copy2(root / name, copy / name)\n29|source = copy / 'internal/sessrepo/lease_store.go'\n30|base = source.read_text()\n31|results = []\n32|\n33|FOREIGN = 'sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff'\n34|HOSTA = '0198f4c8-4a10-7b22-8b3c-1234567890ab'\n35|LEASEA = 'aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee'\n36|LEASEC = 'cccccccc-dddd-4eee-8fff-111111111111'\n37|\n38|# Keep each mutant bounded to the smallest named behavioral suite that can\n39|# observe its gate. This is still the same subprocess instrument and every\n40|# selected test drives a production entry point; the control rows below run\n41|# the complete package. A missing mapping is a harness error, never an\n42|# accidental empty test selection.\n43|TEST_PATTERNS = {\n44|    'N-create-token': r'^TestCreateLeaseRefusesInvalidIdentity$',\n45|    'N-create-holder': r'^TestCreateLeaseRefusesInvalidIdentity$',\n46|    'N-create-issuer': r'^TestCreateLeaseRefusesInvalidIdentity$',\n47|    'N-create-time': r'^TestCreateLeaseRefusesInvalidIdentity$',\n48|    'T-create-time-pad': r'^TestCreateLeaseRefusesInvalidIdentity$',\n49|    'N-successor-reason': r'^TestCompareAndSwapRefusesInvalidSuccessor$',\n50|    'N-successor-checkpoint': r'^TestCompareAndSwapRefusesInvalidSuccessor$',\n51|    'N-create-once': r'^TestCreateLeaseRefusesSecondCreateWithDifferingBytes$',\n52|    'N-cas-token-reuse': r'^TestCompareAndSwapRefusesFencingTokenReuse$',\n53|    'N-cas-conflict': r'^TestCompareAndSwapRefusesUnknownExpectation$',\n54|    'N-cas-stale': r'^TestCompareAndSwapRefusesStaleExpectation$',\n55|    'N-cas-empty': r'^TestCompareAndSwapRequiresExistingLease$',\n56|    'N-fence-token-epoch': r'^TestVerifyFencingTokenRefusals$',\n57|    'N-fence-token-lease': r'^TestVerifyFencingTokenRefusals$',\n58|    'N-fence-token-holder': r'^TestVerifyFencingTokenRefusals$',\n59|    'N-fence-stale': r'^TestVerifyFencingTokenRefusals$',\n60|    'N-fence-future': r'^TestVerifyFencingTokenRefusals$',\n61|    'N-fence-loser': r'^TestVerifyFencingTokenRefusals$',\n62|    'N-fence-holder': r'^TestVerifyFencingTokenRefusals$',\n63|    'N-expiry-policy': r'^TestCheckFencingExpiry$',\n64|    'N-expiry-lapsed': r'^TestCheckFencingExpiry$',\n65|    'N-load-funnel': r'^TestStoredLeaseCorruptionRefuses$',\n66|    'N-get-funnel': r'^TestStoredLeaseCorruptionRefuses$|^TestGetLeaseRefusals$',\n67|    'N-install-length': r'^TestInstallDisagreeingBytesRefuses$',\n68|    'N-get-malformed': r'^TestGetLeaseRefusals$',\n69|    'N-get-unknown': r'^TestGetLeaseRefusals$',\n70|    'N-winning-empty': r'^TestWinningLeaseRefusesEmptyStore$',\n71|    'C-harmless-comment': r'^TestCompareLeaseTupleOrdersByGreatestTuple$',\n72|    'C-not-applied': r'^TestCompareLeaseTupleOrdersByGreatestTuple$',\n73|    'C-compile-failure': r'^TestCompareLeaseTupleOrdersByGreatestTuple$',\n74|}\n75|\n76|def test_command(name):\n77|    pattern = TEST_PATTERNS.get(name)\n78|    if pattern is None:\n79|        raise SystemExit(f'no behavioral test mapping for {name}')\n80|    return ['go', 'test', './internal/sessrepo', '-run', pattern, '-count=1', '-v']\n81|\n82|def run(name, old, new, narrow):\n83|    original = source.read_text()\n84|    if original.count(old) != 1:\n85|        results.append(dict(mutant=name, classification='NOT_APPLIED', count=original.count(old), bound=narrow))\n86|        print(name, 'NOT_APPLIED', original.count(old), flush=True)\n87|        return\n88|    source.write_text(original.replace(old, new))\n89|    command = test_command(name)\n90|    try:\n91|        with (output / (name + '.log')).open('w') as log:\n92|            process = subprocess.run(command, cwd=copy, stdout=log, stderr=subprocess.STDOUT, timeout=180)\n93|        text = (output / (name + '.log')).read_text()\n94|        failures = re.findall(r'^\\s*--- FAIL: ([^ ]+)', text, re.M)\n95|        ran_tests = re.findall(r'^=== RUN ', text, re.M)\n96|        classification = 'COMPILE_OR_HARNESS_FAILURE' if not ran_tests else ('SURVIVED' if process.returncode == 0 else ('KILLED' if failures else 'COMPILE_OR_HARNESS_FAILURE'))\n97|        results.append(dict(mutant=name, classification=classification, exit=process.returncode, failed_tests=failures, bound=narrow, command=command))\n98|        print(name, classification, process.returncode, ', '.join(failures), flush=True)\n99|    finally:\n100|        source.write_text(original)\n101|        assert hashlib.sha256(source.read_bytes()).digest() == hashlib.sha256(original.encode()).digest()\n102|\n103|with (output / 'control-before.log').open('w') as log:\n104|    before = subprocess.run(['go','test','./internal/sessrepo','-count=1'],cwd=copy,stdout=log,stderr=subprocess.STDOUT,timeout=300)\n105|results.append(dict(mutant='control-before', classification='CONTROL', exit=before.returncode))\n106|if before.returncode:\n107|    raise SystemExit('baseline failed')\n108|run('N-create-token','if _, err := scalar.ParseUUIDv4(input.LeaseID); err != nil {','if _, err := scalar.ParseUUIDv4(input.LeaseID); err != nil && input.LeaseID != \"not-a-uuid\" {','Admit exactly the not-a-uuid fencing token; other malformed tokens still refuse.')\n109|run('N-create-holder','if _, err := scalar.ParseUUIDv7(input.HolderHostID); err != nil {','if _, err := scalar.ParseUUIDv7(input.HolderHostID); err != nil && input.HolderHostID != \"not-a-uuid\" {','Admit exactly the not-a-uuid holder; other malformed holders still refuse.')\n110|run('N-create-issuer','if _, err := scalar.ParseUUIDv7(input.IssuedByHostID); err != nil {','if _, err := scalar.ParseUUIDv7(input.IssuedByHostID); err != nil && input.IssuedByHostID != \"0198f4c8-4a10-7b22-8b3c-1234567890aQ\" {','Admit exactly the Q-suffixed issuer; other malformed issuers still refuse.')\n111|run('N-create-time','if _, err := scalar.ParseTimestamp(input.CreatedAt); err != nil {','if _, err := scalar.ParseTimestamp(input.CreatedAt); err != nil && input.CreatedAt != \"not-a-timestamp\" {','Admit exactly the not-a-timestamp value; padded and other malformed timestamps still refuse.')\n112|run('T-create-time-pad','if _, err := scalar.ParseTimestamp(input.CreatedAt); err != nil {','if _, err := scalar.ParseTimestamp(strings.TrimSpace(input.CreatedAt)); err != nil {','Parse the same timestamp token whitespace-tolerantly; padded timestamps admit while unparseable text still refuses.')\n113|run('N-successor-reason','case \"create\", \"graceful_takeover\", \"force_takeover\", \"recovery\":','case \"create\", \"graceful_takeover\", \"force_takeover\", \"recovery\", \"bogus_reason\":','Admit exactly the bogus_reason value past the enum; every other non-enum reason still refuses.')\n114|run('N-successor-checkpoint','if _, err := scalar.ParseDigest(input.CheckpointID); err != nil {','if _, err := scalar.ParseDigest(input.CheckpointID); err != nil && input.CheckpointID != \"not-a-digest\" {','Admit exactly the not-a-digest checkpoint; absent and other malformed checkpoints still refuse.')\n115|run('N-create-once','\\tif identical, ref := findIdenticalLease(stored, digest); identical {\\n\\t\\treturn ref, nil\\n\\t}\\n\\tif len(stored) > 0 {','\\tif identical, ref := findIdenticalLease(stored, digest); identical {\\n\\t\\treturn ref, nil\\n\\t}\\n\\tif len(stored) > 1 {','Admit exactly a second create at depth one; a third create past a succession still refuses.')\n116|run('N-cas-token-reuse','if known.LeaseID == input.LeaseID {','if known.LeaseID == input.LeaseID && known.LeaseID != \"' + LEASEA + '\" {','Admit exactly the epoch-1 token reuse; every other bound token still refuses.')\n117|run('N-cas-conflict','\\tbasis, known := findExpectedLease(stored, expected.RecordID)\\n\\tif !known {','\\tbasis, known := findExpectedLease(stored, expected.RecordID)\\n\\tif !known && expected.RecordID != \"' + FOREIGN + '\" {','Admit exactly the foreign-digest expectation; malformed and empty expectations still conflict.')\n118|run('N-cas-stale','if basis.RecordID != head.RecordID {','if basis.RecordID != head.RecordID && basis.Epoch != 1 {','Admit exactly epoch-1 stale bases; epoch-2 stale bases still refuse.')\n119|run('N-cas-empty','\\tif err != nil {\\n\\t\\treturn LeaseRef{}, err\\n\\t}\\n\\tif len(stored) == 0 {','\\tif err != nil {\\n\\t\\treturn LeaseRef{}, err\\n\\t}\\n\\tif len(stored) == 0 && expected.RecordID != \"\" {','Admit exactly the empty-expectation CAS on an empty store; a named expectation on an empty store still refuses.')\n120|run('N-fence-token-epoch','if token.Epoch == 0 {','if token.Epoch == 0 && (token.LeaseID != \"bbbbbbbb-cccc-4ddd-8eee-ffffffffffff\" || token.HolderHostID != \"0198f4c8-7d40-7e55-8e6f-1234567890ab\") {','Admit exactly the suite epoch-zero vector; the refusal degrades to the stale class.')\n121|run('N-fence-token-lease','if _, err := scalar.ParseUUIDv4(token.LeaseID); err != nil {','if _, err := scalar.ParseUUIDv4(token.LeaseID); err != nil && token.LeaseID != \"zzz\" {','Admit exactly the zzz token lease; the refusal degrades to the conflict class.')\n122|run('N-fence-token-holder','if _, err := scalar.ParseUUIDv7(token.HolderHostID); err != nil {','if _, err := scalar.ParseUUIDv7(token.HolderHostID); err != nil && token.HolderHostID != \"zzz\" {','Admit exactly the zzz token holder; the refusal degrades to the mismatch class.')\n123|run('N-fence-stale','if token.Epoch < winner.Epoch {','if token.Epoch < winner.Epoch && !(token.Epoch == 1 && token.LeaseID == \"' + LEASEA + '\") {','Admit exactly the epoch-1 token; the refusal degrades to the conflict class.')\n124|run('N-fence-future','if token.Epoch > winner.Epoch {','if token.Epoch > winner.Epoch && token.Epoch != 9 {','Admit exactly the epoch-9 token; the empty-store epoch-1 token still refuses unknown.')\n125|run('N-fence-loser','if token.LeaseID != winner.LeaseID {','if token.LeaseID != winner.LeaseID && token.LeaseID != \"' + LEASEC + '\" {','Admit exactly the leaseC loser past the tie break; the token verifies and the negative fails by success.')\n126|run('N-fence-holder','if token.HolderHostID != winner.HolderHostID {','if token.HolderHostID != winner.HolderHostID && token.HolderHostID != \"' + HOSTA + '\" {','Admit exactly the hostA non-holder; the token verifies and the negative fails by success.')\n127|run('N-expiry-policy','if policy.RefreshInterval <= 0 {','if policy.RefreshInterval < 0 {','Admit exactly the zero interval; a negative interval still refuses.')\n128|run('N-expiry-lapsed','if now.Sub(grant.ValidatedAt) > policy.RefreshInterval {','if now.Sub(grant.ValidatedAt) > policy.RefreshInterval && grant.SessionID != \"0198f4c8-3e70-7a11-8a2b-1234567890ab\" {','Admit exactly the suite lapsed grant; the grant verifies and the negative fails by success.')\n129|run('N-load-funnel','\\tstored, err := scanLeaseBlobs(directory, sessionID)\\n\\tif err != nil {','\\tstored, err := scanLeaseBlobs(directory, sessionID)\\n\\tif err != nil && !strings.Contains(err.Error(), \"garbage.json\") {','Admit exactly the garbage-name torn vector; truncated, cross-session, misnamed, and undecodable vectors still refuse.')\n130|run('N-get-funnel','if err := verifyLeaseBlob(view.record.sessionID, recordID, blob); err != nil {','if err := verifyLeaseBlob(view.record.sessionID, recordID, blob); err != nil && recordID != \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" {','Admit exactly the undecodable-bytes vector; the misnamed vector still refuses.')\n131|run('N-install-length','func leaseBytesEqual(left, right []byte) bool {\\n\\treturn bytes.Equal(left, right)\\n}','func leaseBytesEqual(left, right []byte) bool {\\n\\treturn len(left) == len(right) && bytes.Equal(left, left)\\n}','Compare length only at the ledgered equality site; the same-length garbage arm reuses while the different-length arm still refuses.')\n132|run('N-get-malformed','if _, err := scalar.ParseDigest(recordID); err != nil {','if _, err := scalar.ParseDigest(recordID); err != nil && recordID != \"not-a-digest\" {','Admit exactly the not-a-digest record id; the refusal degrades to the unknown class.')\n133|run('N-get-unknown','\\tblob, err := os.ReadFile(filepath.Join(view.directory, \"leases\", blobFileName(recordID)))\\n\\tif err != nil {','\\tblob, err := os.ReadFile(filepath.Join(view.directory, \"leases\", blobFileName(recordID)))\\n\\tif err != nil && recordID != \"' + FOREIGN + '\" {','Admit exactly the foreign-digest read; the refusal degrades to the corruption class.')\n134|run('N-winning-empty','\\tif err != nil {\\n\\t\\treturn LeaseSummary{}, err\\n\\t}\\n\\tif len(stored) == 0 {','\\tif err != nil {\\n\\t\\treturn LeaseSummary{}, err\\n\\t}\\n\\tif len(stored) == 0 && sessionID != \"0198f4c8-3e70-7a11-8a2b-1234567890ab\" {','Admit exactly the suite empty store with a zero summary; the negative fails by success.')\n135|run('C-harmless-comment','// CompareLeaseTuple orders two stored lease summaries by the Section 5.3','// CompareLeaseTuple orders two stored lease summaries by the Section 5.3\\n// classifier control: comment only, no behavior change.','Applied control: a behavior-preserving plant survives through the same instrument.')\n136|run('C-not-applied','TOKEN_THAT_IS_NOT_PRESENT','replacement','Application control: missing patch is not a killed mutant.')\n137|run('C-compile-failure','package sessrepo','package sessrepo\\nthis is invalid Go','Compilation control: no named failed behavioral test is not a kill.')\n138|with (output / 'control-after.log').open('w') as log:\n139|    after = subprocess.run(['go','test','./internal/sessrepo','-count=1'],cwd=copy,stdout=log,stderr=subprocess.STDOUT,timeout=300)\n140|results.append(dict(mutant='control-after',classification='CONTROL', exit=after.returncode))\n141|assert source.read_text() == base\n142|(output / 'mutants.json').write_text(json.dumps(results,indent=2)+'\\n')\n143|# Controls are reported separately from the applied behavioral denominator.\n144|bad = [row for row in results if (row['mutant'].startswith('N-') or row['mutant'].startswith('T-')) and row['classification'] != 'KILLED']\n145|raise SystemExit(1 if bad or after.returncode else 0)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
