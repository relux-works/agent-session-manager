{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6a7","stream":{"kind":"session","id":"01a0ae2e-304f-7791-b344-a738da145935"},"sequence":430,"recorded_at":1780531400000855,"record_type":"event","durability":"durable","causation_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","run_stream":{"kind":"run","id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3"},"task_stream":{"kind":"task","id":"01a0ae2f-26cb-74b1-865a-7fdd8cce0af1"},"task_id":"01a0ae2f-26cb-74b1-865a-7fdd8cce0af1","event":{"kind":"output","task_id":"01a0ae2f-26cb-74b1-865a-7fdd8cce0af1","chunk":"Read text file `internal/sessrepo/testdata/mutate.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Run isolated behavioral mutants; never modify the managed Story checkout.\n3|Usage: python3 internal/sessrepo/testdata/mutate.py /absolute/evidence/directory\n4|Every subprocess runs directly, logs its real exit, and has a bounded timeout.\n5|The battery proves each lease-store gate by narrowing, never by deletion:\n6|every N-mutant keeps its gate present and weakens it to admit exactly one\n7|member of the class the gate must reject, and a named behavioral test must\n8|fail. The T-mutant preserves the searched-for timestamp token while changing\n9|behavior, and the harness always executes the behavioral suites.\n10|\"\"\"\n11|import hashlib\n12|import json\n13|from pathlib import Path\n14|import re\n15|import shutil\n16|import subprocess\n17|import sys\n18|\n19|root = Path(__file__).resolve().parents[3]\n20|output = Path(sys.argv[1]).resolve()\n21|output.mkdir(parents=True, exist_ok=True)\n22|copy = output / 'mutation-source'\n23|if copy.exists():\n24|    raise SystemExit('refusing to overwrite an existing mutation source')\n25|copy.mkdir()\n26|shutil.copytree(root / 'internal', copy / 'internal')\n27|for name in ('go.mod', 'go.sum', 'README.md', 'LOGBOOK.md'):\n28|    shutil.copy2(root / name, copy / name)\n29|source = copy / 'internal/sessrepo/lease_store.go'\n30|base = source.read_text()\n31|results = []\n32|\n33|FOREIGN = 'sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff'\n34|HOSTA = '0198f4c8-4a10-7b22-8b3c-1234567890ab'\n35|LEASEA = 'aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee'\n36|LEASEC = 'cccccccc-dddd-4eee-8fff-111111111111'\n37|\n38|# Keep each mutant bounded to the smallest named behavioral suite that can\n39|# observe its gate. This is still the same subprocess instrument and every\n40|# selected test drives a production entry point; the control rows below run\n41|# the complete package. A missing mapping is a harness error, never an\n42|# accidental empty test selection.\n43|TEST_PATTERNS = {\n44|    'N-create-token': r'^TestCreateLeaseRefusesInvalidIdentity$',\n45|    'N-create-holder': r'^TestCreateLeaseRefusesInvalidIdentity$',\n46|    'N-create-issuer': r'^TestCreateLeaseRefusesInvalidIdentity$',\n47|    'N-create-time': r'^TestCreateLeaseRefusesInvalidIdentity$',\n48|    'T-create-time-pad': r'^TestCreateLeaseRefusesInvalidIdentity$',\n49|    'N-successor-reason': r'^TestCompareAndSwapRefusesInvalidSuccessor$',\n50|    'N-successor-checkpoint': r'^TestCompareAndSwapRefusesInvalidSuccessor$',\n51|    'N-create-once': r'^TestCreateLeaseRefusesSecondCreateWithDifferingBytes$',\n52|    'N-cas-token-reuse': r'^TestCompareAndSwapRefusesFencingTokenReuse$',\n53|    'N-cas-conflict': r'^TestCompareAndSwapRefusesUnknownExpectation$',\n54|    'N-cas-stale': r'^TestCompareAndSwapRefusesStaleExpectation$',\n55|    'N-cas-empty': r'^TestCompareAndSwapRequiresExistingLease$',\n56|    'N-fence-token-epoch': r'^TestVerifyFencingTokenRefusals$',\n57|    'N-fence-token-lease': r'^TestVerifyFencingTokenRefusals$',\n58|    'N-fence-token-holder': r'^TestVerifyFencingTokenRefusals$',\n59|    'N-fence-stale': r'^TestVerifyFencingTokenRefusals$',\n60|    'N-fence-future': r'^TestVerifyFencingTokenRefusals$',\n61|    'N-fence-loser': r'^TestVerifyFencingTokenRefusals$',\n62|    'N-fence-holder': r'^TestVerifyFencingTokenRefusals$',\n63|    'N-expiry-policy': r'^TestCheckFencingExpiry$',\n64|    'N-expiry-lapsed': r'^TestCheckFencingExpiry$',\n65|    'N-load-funnel': r'^TestStoredLeaseCorruptionRefuses$',\n66|    'N-get-funnel': r'^TestStoredLeaseCorruptionRefuses$|^TestGetLeaseRefusals$',\n67|    'N-install-length': r'^TestInstallDisagreeingBytesRefuses$',\n68|    'N-get-malformed': r'^TestGetLeaseRefusals$',\n69|    'N-get-unknown': r'^TestGetLeaseRefusals$',\n70|    'N-winning-empty': r'^TestWinningLeaseRefusesEmptyStore$',\n71|    'C-harmless-comment': r'^TestCompareLeaseTupleOrdersByGreatestTuple$',\n72|    'C-not-applied': r'^TestCompareLeaseTupleOrdersByGreatestTuple$',\n73|    'C-compile-failure': r'^TestCompareLeaseTupleOrdersByGreatestTuple$',\n74|}\n75|\n76|def test_command(name):\n77|    pattern = TEST_PATTERNS.get(name)\n78|    if pattern is None:\n79|        raise SystemExit(f'no behavioral test mapping for {name}')\n80|    return ['go', 'test', './internal/sessrepo', '-run', pattern, '-count=1', '-v']\n81|\n82|def run(name, old, new, narrow):\n83|    original = source.read_text()\n84|    if original.count(old) != 1:\n85|        results.append(dict(mutant=name, classification='NOT_APPLIED', count=original.count(old), bound=narrow))\n86|        print(name, 'NOT_APPLIED', original.count(old), flush=True)\n87|        return\n88|    source.write_text(original.replace(old, new))\n89|    command = test_command(name)\n90|    try:\n91|        with (output / (name + '.log')).open('w') as log:\n92|            process = subprocess.run(command, cwd=copy, stdout=log, stderr=subprocess.STDOUT, timeout=180)\n93|        text = (output / (name + '.log')).read_text()\n94|        failures = re.findall(r'^\\s*--- FAIL: ([^ ]+)', text, re.M)\n95|        ran_tests = re.findall(r'^=== RUN ', text, re.M)\n96|        classification = 'COMPILE_OR_HARNESS_FAILURE' if not ran_tests else ('SURVIVED' if process.returncode == 0 else ('KILLED' if failures else 'COMPILE_OR_HARNESS_FAILURE'))\n97|        results.append(dict(mutant=name, classification=classification, exit=process.returncode, failed_tests=failures, bound=narrow, command=command))\n98|        print(name, classification, process.returncode, ', '.join(failures), flush=True)\n99|    finally:\n100|        source.write_text(original)\n101|        assert hashlib.sha256(source.read_bytes()).digest() == hashlib.sha256(original.encode()).digest()\n102|\n103|with (output / 'control-before.log').open('w') as log:\n104|    before = subprocess.run(['go','test','./internal/sessrepo','-count=1'],cwd=copy,stdout=log,stderr=subprocess.STDOUT,timeout=300)\n105|results.append(dict(mutant='control-before', classification='CONTROL', exit=before.returncode))\n106|if before.returncode:\n107|    raise SystemExit('baseline failed')\n108|run('N-create-token','if _, err := scalar.ParseUUIDv4(input.LeaseID); err != nil {','if _, err := scalar.ParseUUIDv4(input.LeaseID); err != nil && input.LeaseID != \"not-a-uuid\" {','Admit exactly the not-a-uuid fencing token; other malformed tokens still refuse.')\n109|run('N-create-holder','if _, err := scalar.ParseUUIDv7(input.HolderHostID); err != nil {','if _, err := scalar.ParseUUIDv7(input.HolderHostID); err != nil && input.HolderHostID != \"not-a-uuid\" {','Admit exactly the not-a-uuid holder; other malformed holders still refuse.')\n110|run('N-create-issuer','if _, err := scalar.ParseUUIDv7(input.IssuedByHostID); err != nil {','if _, err := scalar.ParseUUIDv7(input.IssuedByHostID); err != nil && input.IssuedByHostID != \"0198f4c8-4a10-7b22-8b3c-1234567890aQ\" {','Admit exactly the Q-suffixed issuer; other malformed issuers still refuse.')\n111|run('N-create-time','if _, err := scalar.ParseTimestamp(input.CreatedAt); err != nil {','if _, err := scalar.ParseTimestamp(input.CreatedAt); err != nil && input.CreatedAt != \"not-a-timestamp\" {','Admit exactly the not-a-timestamp value; padded and other malformed timestamps still refuse.')\n112|run('T-create-time-pad','if _, err := scalar.ParseTimestamp(input.CreatedAt); err != nil {','if _, err := scalar.ParseTimestamp(strings.TrimSpace(input.CreatedAt)); err != nil {','Parse the same timestamp token whitespace-tolerantly; padded timestamps admit while unparseable text still refuses.')\n113|run('N-successor-reason','case \"create\", \"graceful_takeover\", \"force_takeover\", \"recovery\":','case \"create\", \"graceful_takeover\", \"force_takeover\", \"recovery\", \"bogus_reason\":','Admit exactly the bogus_reason value past the enum; every other non-enum reason still refuses.')\n114|run('N-successor-checkpoint','if _, err := scalar.ParseDigest(input.CheckpointID); err != nil {','if _, err := scalar.ParseDigest(input.CheckpointID); err != nil && input.CheckpointID != \"not-a-digest\" {','Admit exactly the not-a-digest checkpoint; absent and other malformed checkpoints still refuse.')\n115|run('N-create-once','\\tif identical, ref := findIdenticalLease(stored, digest); identical {\\n\\t\\treturn ref, nil\\n\\t}\\n\\tif len(stored) > 0 {','\\tif identical, ref := findIdenticalLease(stored, digest); identical {\\n\\t\\treturn ref, nil\\n\\t}\\n\\tif len(stored) > 1 {','Admit exactly a second create at depth one; a third create past a succession still refuses.')\n116|run('N-cas-token-reuse','if known.LeaseID == input.LeaseID {','if known.LeaseID == input.LeaseID && known.LeaseID != \"' + LEASEA + '\" {','Admit exactly the epoch-1 token reuse; every other bound token still refuses.')\n117|run('N-cas-conflict','\\tbasis, known := findExpectedLease(stored, expected.RecordID)\\n\\tif !known {','\\tbasis, known := findExpectedLease(stored, expected.RecordID)\\n\\tif !known && expected.RecordID != \"' + FOREIGN + '\" {','Admit exactly the foreign-digest expectation; malformed and empty expectations still conflict.')\n118|run('N-cas-stale','if basis.RecordID != head.RecordID {','if basis.RecordID != head.RecordID && basis.Epoch != 1 {','Admit exactly epoch-1 stale bases; epoch-2 stale bases still refuse.')\n119|run('N-cas-empty','\\tif err != nil {\\n\\t\\treturn LeaseRef{}, err\\n\\t}\\n\\tif len(stored) == 0 {','\\tif err != nil {\\n\\t\\treturn LeaseRef{}, err\\n\\t}\\n\\tif len(stored) == 0 && expected.RecordID != \"\" {','Admit exactly the empty-expectation CAS on an empty store; a named expectation on an empty store still refuses.')\n120|run('N-fence-token-epoch','if token.Epoch == 0 {','if token.Epoch == 0 && (token.LeaseID != \"bbbbbbbb-cccc-4ddd-8eee-ffffffffffff\" || token.HolderHostID != \"0198f4c8-7d40-7e55-8e6f-1234567890ab\") {','Admit exactly the suite epoch-zero vector; the refusal degrades to the stale class.')\n121|run('N-fence-token-lease','if _, err := scalar.ParseUUIDv4(token.LeaseID); err != nil {','if _, err := scalar.ParseUUIDv4(token.LeaseID); err != nil && token.LeaseID != \"zzz\" {','Admit exactly the zzz token lease; the refusal degrades to the conflict class.')\n122|run('N-fence-token-holder','if _, err := scalar.ParseUUIDv7(token.HolderHostID); err != nil {','if _, err := scalar.ParseUUIDv7(token.HolderHostID); err != nil && token.HolderHostID != \"zzz\" {','Admit exactly the zzz token holder; the refusal degrades to the mismatch class.')\n123|run('N-fence-stale','if token.Epoch < winner.Epoch {','if token.Epoch < winner.Epoch && !(token.Epoch == 1 && token.LeaseID == \"' + LEASEA + '\") {','Admit exactly the epoch-1 token; the refusal degrades to the conflict class.')\n124|run('N-fence-future','if token.Epoch > winner.Epoch {','if token.Epoch > winner.Epoch && token.Epoch != 9 {','Admit exactly the epoch-9 token; the empty-store epoch-1 token still refuses unknown.')\n125|run('N-fence-loser','if token.LeaseID != winner.LeaseID {','if token.LeaseID != winner.LeaseID && token.LeaseID != \"' + LEASEC + '\" {','Admit exactly the leaseC loser past the tie break; the token verifies and the negative fails by success.')\n126|run('N-fence-holder','if token.HolderHostID != winner.HolderHostID {','if token.HolderHostID != winner.HolderHostID && token.HolderHostID != \"' + HOSTA + '\" {','Admit exactly the hostA non-holder; the token verifies and the negative fails by success.')\n127|run('N-expiry-policy','if policy.RefreshInterval <= 0 {','if policy.RefreshInterval < 0 {','Admit exactly the zero interval; a negative interval still refuses.')\n128|run('N-expiry-lapsed','if now.Sub(grant.ValidatedAt) > policy.RefreshInterval {','if now.Sub(grant.ValidatedAt) > policy.RefreshInterval && grant.SessionID != \"0198f4c8-3e70-7a11-8a2b-1234567890ab\" {','Admit exactly the suite lapsed grant; the grant verifies and the negative fails by success.')\n129|run('N-load-funnel','\\tstored, err := scanLeaseBlobs(directory, sessionID)\\n\\tif err != nil {','\\tstored, err := scanLeaseBlobs(directory, sessionID)\\n\\tif err != nil && !strings.Contains(err.Error(), \"garbage.json\") {','Admit exactly the garbage-name torn vector; truncated, cross-session, misnamed, and undecodable vectors still refuse.')\n130|run('N-get-funnel','if err := verifyLeaseBlob(view.record.sessionID, recordID, blob); err != nil {','if err := verifyLeaseBlob(view.record.sessionID, recordID, blob); err != nil && recordID != \"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\" {','Admit exactly the undecodable-bytes vector; the misnamed vector still refuses.')\n131|run('N-install-length','func leaseBytesEqual(left, right []byte) bool {\\n\\treturn bytes.Equal(left, right)\\n}','func leaseBytesEqual(left, right []byte) bool {\\n\\treturn len(left) == len(right) && bytes.Equal(left, left)\\n}','Compare length only at the ledgered equality site; the same-length garbage arm reuses while the different-length arm still refuses.')\n132|run('N-get-malformed','if _, err := scalar.ParseDigest(recordID); err != nil {','if _, err := scalar.ParseDigest(recordID); err != nil && recordID != \"not-a-digest\" {','Admit exactly the not-a-digest record id; the refusal degrades to the unknown class.')\n133|run('N-get-unknown','\\tblob, err := os.ReadFile(filepath.Join(view.directory, \"leases\", blobFileName(recordID)))\\n\\tif err != nil {','\\tblob, err := os.ReadFile(filepath.Join(view.directory, \"leases\", blobFileName(recordID)))\\n\\tif err != nil && recordID != \"' + FOREIGN + '\" {','Admit exactly the foreign-digest read; the refusal degrades to the corruption class.')\n134|run('N-winning-empty','\\tif err != nil {\\n\\t\\treturn LeaseSummary{}, err\\n\\t}\\n\\tif len(stored) == 0 {','\\tif err != nil {\\n\\t\\treturn LeaseSummary{}, err\\n\\t}\\n\\tif len(stored) == 0 && sessionID != \"0198f4c8-3e70-7a11-8a2b-1234567890ab\" {','Admit exactly the suite empty store with a zero summary; the negative fails by success.')\n135|run('C-harmless-comment','// CompareLeaseTuple orders two stored lease summaries by the Section 5.3','// CompareLeaseTuple orders two stored lease summaries by the Section 5.3\\n// classifier control: comment only, no behavior change.','Applied control: a behavior-preserving plant survives through the same instrument.')\n136|run('C-not-applied','TOKEN_THAT_IS_NOT_PRESENT','replacement','Application control: missing patch is not a killed mutant.')\n137|run('C-compile-failure','package sessrepo','package sessrepo\\nthis is invalid Go','Compilation control: no named failed behavioral test is not a kill.')\n138|with (output / 'control-after.log').open('w') as log:\n139|    after = subprocess.run(['go','test','./internal/sessrepo','-count=1'],cwd=copy,stdout=log,stderr=subprocess.STDOUT,timeout=300)\n140|results.append(dict(mutant='control-after',classification='CONTROL', exit=after.returncode))\n141|assert source.read_text() == base\n142|(output / 'mutants.json').write_text(json.dumps(results,indent=2)+'\\n')\n143|# Controls are reported separately from the applied behavioral denominator.\n144|bad = [row for row in results if (row['mutant'].startswith('N-') or row['mutant'].startswith('T-')) and row['classification'] != 'KILLED']\n145|raise SystemExit(1 if bad or after.returncode else 0)","final_result":true}}}
