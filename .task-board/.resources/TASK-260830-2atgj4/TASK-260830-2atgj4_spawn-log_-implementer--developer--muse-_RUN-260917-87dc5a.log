{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c96d","stream":{"kind":"session","id":"01a0ae2e-304f-7791-b344-a738da145935"},"sequence":785,"recorded_at":1780531400001565,"record_type":"event","durability":"durable","causation_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","run_stream":{"kind":"run","id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3"},"task_stream":{"kind":"task","id":"01a0ae33-0458-7800-b27a-ff1bf753900b"},"task_id":"01a0ae33-0458-7800-b27a-ff1bf753900b","event":{"kind":"output","task_id":"01a0ae33-0458-7800-b27a-ff1bf753900b","chunk":"Read text file `internal/traceability/traceability_test.go`.\n1|package traceability\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"crypto/sha256\"\n6|\t\"encoding/json\"\n7|\t\"errors\"\n8|\t\"io/fs\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"reflect\"\n12|\t\"sort\"\n13|\t\"strings\"\n14|\t\"testing\"\n15|\t\"testing/fstest\"\n16|\n17|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n18|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n19|\t\"github.com/relux-works/agent-session-manager/internal/specpin\"\n20|)\n21|\n22|func TestVerifyRepositoryAcceptsExactOwnership(t *testing.T) {\n23|\tt.Parallel()\n24|\n25|\treport, err := VerifyRepository(repositorySnapshot(t))\n26|\tif err != nil {\n27|\t\tt.Fatalf(\"VerifyRepository() error = %v\", err)\n28|\t}\n29|\twant := Report{\n30|\t\tContracts:              63,\n31|\t\tNormativeSections:      36,\n32|\t\tAcceptanceCases:        110,\n33|\t\tFixtures:               32,\n34|\t\tCompatibilityContracts: 55,\n35|\t\tSectionBindings:        57,\n36|\t\tFullCoverage:           1,\n37|\t\tPartialCoverage:        4,\n38|\t\tSliverCoverage:         2,\n39|\t\tUnevidencedCoverage:    47,\n40|\t\tUnmeasuredCoverage:     3,\n41|\t\tUnownedSections:        11,\n42|\t\tNormativeClauses:       485,\n43|\t\tDischargedClauses:      28,\n44|\t}\n45|\tif !reflect.DeepEqual(report, want) {\n46|\t\tt.Fatalf(\"VerifyRepository() report = %#v, want %#v\", report, want)\n47|\t}\n48|}\n49|\n50|// TestVerifyAssignedSectionsBindsGranularScopeToOwnersAndExecutableCases pins\n51|// the admitted arm of assigned-scope admission. Section 6.2 is admitted because\n52|// it discharges the one normative clause its pinned section carries against an\n53|// executable acceptance case. It is the only shipped binding that is.\n54|//\n55|// Section 13.14.5 used to be admitted here on the ground that its pinned\n56|// section \"carries no RFC 2119 obligation of its own\". That was false: the\n57|// obligation scanner matches uppercase keywords only, and Section 13.14.5\n58|// states its obligations as required-member and variant tables. Nineteen of the\n59|// 157 pinned headings are in that class, including the eighteen-row exit-code\n60|// registry of Section 15.2 and the closed Provider Manifest of Section 7.3, and\n61|// admitting them reproduced this bug through a different door. The assertion is\n62|// kept rather than deleted: it moved to the refusal table below and to\n63|// TestVerifyAssignedSectionsRefusesEveryBindingThatOnlySlivers, which now pins\n64|// each of the three by its measured ratio.\n65|func TestVerifyAssignedSectionsBindsGranularScopeToOwnersAndExecutableCases(t *testing.T) {\n66|\tt.Parallel()\n67|\n68|\treport, err := VerifyAssignedSections(repositorySnapshot(t), []string{\"6.2\"})\n69|\tif err != nil {\n70|\t\tt.Fatalf(\"VerifyAssignedSections() error = %v\", err)\n71|\t}\n72|\tif report.AssignedScopes != 1 {\n73|\t\tt.Fatalf(\"VerifyAssignedSections() assigned scopes = %d, want 1\", report.AssignedScopes)\n74|\t}\n75|\n76|\tfor _, scope := range []string{\"6.2\", \"§6.2\"} {\n77|\t\treport, err := VerifyAssignedSections(repositorySnapshot(t), []string{scope})\n78|\t\tif err != nil {\n79|\t\t\tt.Errorf(\"VerifyAssignedSections(%q) error = %v\", scope, err)\n80|\t\t\tcontinue\n(more lines below)","final_result":true}}}
