{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c791","stream":{"kind":"session","id":"01a0ae2e-304f-7791-b344-a738da145935"},"sequence":547,"recorded_at":1780531400001089,"record_type":"event","durability":"durable","causation_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","run_stream":{"kind":"run","id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3"},"call_id":"call_01a0ae2f7bff74618c57fff5f69cdbeb","text":"{\n  \"chunk_id\": \"exec-11-1\",\n  \"command\": \"grep -n \\\"TestAuthorizeRefusesMalformedPresented\\\" -A 60 internal/fencing/gate_test.go | head -n 100; echo ===; grep -n \\\"TestLeaseTupleOrderAgrees\\\" -A 40 internal/sessrepo/lease_store_test.go | head -n 80\",\n  \"description\": \"Read P3 vector context and agreement test\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"32:// TestAuthorizeRefusesMalformedPresented drives every malformed\\n33-// presented-token vector through a launch and a non-launch entry:\\n34-// malformed claims refuse invalid_arguments on both, never a fencing\\n35-// class and never a park. The epoch-zero vectors pair the winner\\n36-// lease (which the epoch gate would stale-report past the grammar)\\n37-// with a malformed lease (which refuses at grammar under mutants).\\n38:func TestAuthorizeRefusesMalformedPresented(t *testing.T) {\\n39-\\tvectors := map[string]PresentedToken{\\n40-\\t\\t\\\"session_not_uuid\\\": {SessionID: \\\"not-a-uuid\\\", Epoch: 2, LeaseID: fenceLeaseA},\\n41-\\t\\t\\\"session_empty\\\":    {SessionID: \\\"\\\", Epoch: 2, LeaseID: fenceLeaseA},\\n42-\\t\\t\\\"epoch_zero\\\":       {SessionID: fenceSessionA, Epoch: 0, LeaseID: fenceLeaseA},\\n43-\\t\\t\\\"epoch_zero_lease\\\": {SessionID: fenceSessionA, Epoch: 0, LeaseID: \\\"zzz\\\"},\\n44-\\t\\t\\\"lease_not_uuid\\\":   {SessionID: fenceSessionA, Epoch: 2, LeaseID: \\\"zzz\\\"},\\n45-\\t\\t\\\"lease_empty\\\":      {SessionID: fenceSessionA, Epoch: 2, LeaseID: \\\"\\\"},\\n46-\\t}\\n47-\\tfor name, entry := range fenceEntries() {\\n48-\\t\\tfor vector, presented := range vectors {\\n49-\\t\\t\\tt.Run(name+\\\"/\\\"+vector, func(t *testing.T) {\\n50-\\t\\t\\t\\t_, err := entry.authorize(presented, fenceObservation())\\n51-\\t\\t\\t\\tmustRefuse(t, err, ErrInvalidArguments, name+\\\"/\\\"+vector)\\n52-\\t\\t\\t})\\n53-\\t\\t}\\n54-\\t}\\n55-}\\n56-\\n57-// TestAuthorizeRefusesGarbageWinner proves the winner is not trusted\\n58-// past its grammar: a caller-built observation with a malformed\\n59-// winning summary refuses invalid_arguments instead of authorizing\\n60-// against garbage.\\n61-func TestAuthorizeRefusesGarbageWinner(t *testing.T) {\\n62-\\tvectors := map[string]sessrepo.LeaseSummary{\\n63-\\t\\t// The narrowing vector the winner mutant admits past the arm.\\n64-\\t\\t\\\"epoch_zero_lease\\\": {SessionID: fenceSessionA, LeaseID: \\\"zzz\\\", Epoch: 0, HolderHostID: fenceHostA},\\n65-\\t\\t// A second garbage shape that still refuses under the mutant.\\n66-\\t\\t\\\"holder_malformed\\\": {SessionID: fenceSessionA, LeaseID: fenceLeaseA, Epoch: 2, HolderHostID: \\\"zzz\\\"},\\n67-\\t}\\n68-\\tfor name, entry := range fenceEntries() {\\n69-\\t\\tfor vector, winner := range vectors {\\n70-\\t\\t\\tt.Run(name+\\\"/\\\"+vector, func(t *testing.T) {\\n71-\\t\\t\\t\\tobservation := fenceObservation()\\n72-\\t\\t\\t\\tobservation.Winner = winner\\n73-\\t\\t\\t\\t_, err := entry.authorize(fencePresented(), observation)\\n74-\\t\\t\\t\\tmustRefuse(t, err, ErrInvalidArguments, name+\\\"/\\\"+vector)\\n75-\\t\\t\\t})\\n76-\\t\\t}\\n77-\\t}\\n78-}\\n79-\\n80-// TestAuthorizeRefusesForeignSession drives the foreign-session row:\\n81-// a token minted for another session never authorizes here. The B\\n82-// session shares the first UUID segment with A (the vector the\\n83-// prefix mutant admits); the C session shares nothing.\\n84-func TestAuthorizeRefusesForeignSession(t *testing.T) {\\n85-\\tvectors := map[string]string{\\n86-\\t\\t\\\"prefix_sharing\\\": fenceSessionB,\\n87-\\t\\t\\\"fully_foreign\\\":  fenceSessionC,\\n88-\\t}\\n89-\\tfor name, entry := range fenceEntries() {\\n90-\\t\\tfor vector, session := range vectors {\\n91-\\t\\t\\tt.Run(name+\\\"/\\\"+vector, func(t *testing.T) {\\n92-\\t\\t\\t\\tpresented := fencePresented()\\n93-\\t\\t\\t\\tpresented.SessionID = session\\n94-\\t\\t\\t\\t_, err := entry.authorize(presented, fenceObservation())\\n95-\\t\\t\\t\\tmustRefuse(t, err, ErrLeaseConflict, name+\\\"/\\\"+vector)\\n96-\\t\\t\\t})\\n97-\\t\\t}\\n98-\\t}\\n===\\n\",\n  \"original_output_bytes\": 3189,\n  \"original_output_tokens\": 798,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
