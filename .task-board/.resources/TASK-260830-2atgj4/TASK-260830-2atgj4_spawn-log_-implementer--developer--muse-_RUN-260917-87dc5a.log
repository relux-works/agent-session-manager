{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9b7","stream":{"kind":"session","id":"01a0ae2e-304f-7791-b344-a738da145935"},"sequence":822,"recorded_at":1780531400001639,"record_type":"event","durability":"durable","causation_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","run_stream":{"kind":"run","id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3"},"task_stream":{"kind":"task","id":"01a0ae33-6293-70c2-97a3-50aec5e57258"},"task_id":"01a0ae33-6293-70c2-97a3-50aec5e57258","event":{"kind":"output","task_id":"01a0ae33-6293-70c2-97a3-50aec5e57258","chunk":"Read text file `internal/sessstate/reduce_test.go`.\n1|package sessstate\n2|\n3|import (\n4|\t\"testing\"\n5|)\n6|\n7|// eventSpec is one chain step: envelope position plus type and payload.\n8|type eventSpec struct {\n9|\tepoch   uint64\n10|\tleaseID string\n11|\ttyp     string\n12|\tpayload map[string]any\n13|\tversion string\n14|}\n15|\n16|// buildChain folds specs into canonical-exact decoded events,\n17|// assigning per-lease sequences (a successor lease restarts at 1) and\n18|// chaining predecessors. It returns the raw bytes alongside, so the\n19|// same chain drives both the pure Reduce entry and the\n20|// repository-backed Project entry.\n21|func buildChain(t *testing.T, record []byte, specs []eventSpec) (Record, []Event, [][]byte) {\n22|\tt.Helper()\n23|\tdecoded, err := DecodeRecord(record)\n24|\tif err != nil {\n25|\t\tt.Fatalf(\"DecodeRecord error = %v\", err)\n26|\t}\n27|\tvar events []Event\n28|\tvar raws [][]byte\n29|\tpredecessors := []string{decoded.RecordID}\n30|\tvar lastLease string\n31|\tvar sequence uint64\n32|\tfor _, spec := range specs {\n33|\t\tepoch := spec.epoch\n34|\t\tif epoch == 0 {\n35|\t\t\tepoch = 1\n36|\t\t}\n37|\t\tleaseID := spec.leaseIDOr(testLeaseID)\n38|\t\tif leaseID != lastLease {\n39|\t\t\tsequence = 1\n40|\t\t\tlastLease = leaseID\n41|\t\t} else {\n42|\t\t\tsequence++\n43|\t\t}\n44|\t\tevent, raw := mustDecodeEvent(t, eventOptions{\n45|\t\t\tsessionID:     decoded.SessionID,\n46|\t\t\tpredecessors:  predecessors,\n47|\t\t\tepoch:         epoch,\n48|\t\t\tleaseID:       leaseID,\n49|\t\t\tsequence:      sequence,\n50|\t\t\teventType:     spec.typ,\n51|\t\t\tpayload:       spec.payload,\n52|\t\t\tschemaVersion: spec.version,\n53|\t\t})\n54|\t\tevents = append(events, event)\n55|\t\traws = append(raws, raw)\n56|\t\tpredecessors = []string{event.ID}\n57|\t}\n58|\treturn decoded, events, raws\n59|}\n60|\n61|// reduceDirect folds specs through Decode into Reduce without a\n62|// repository, for the pure-core table.\n63|func reduceDirect(t *testing.T, record []byte, specs []eventSpec) Projection {\n64|\tt.Helper()\n65|\tdecoded, events, _ := buildChain(t, record, specs)\n66|\tprojection, err := Reduce(Input{Record: decoded, Events: events})\n67|\tif err != nil {\n68|\t\tt.Fatalf(\"Reduce error = %v\", err)\n69|\t}\n70|\treturn projection\n71|}\n72|\n73|// TestReduceDerivesEverySessionState drives each of the eleven\n74|// Section 5.7 values through the production Reduce entry and, for the\n75|// same chain, through the repository-backed Project entry, requiring\n76|// both to agree. A value with no producing path fails here.\n77|func TestReduceDerivesEverySessionState(t *testing.T) {\n78|\trecord := buildRecord(t, nil)\n79|\tdecoded, err := DecodeRecord(record)\n80|\tif err != nil {\n81|\t\tt.Fatalf(\"DecodeRecord error = %v\", err)\n82|\t}\n83|\tcreated := eventSpec{typ: \"session.created\", payload: createdPayload(decoded.RecordID)}\n84|\tlaunched := eventSpec{typ: \"provider.launched\", payload: launchedPayload(\"codex\")}\n85|\tidle := eventSpec{typ: \"session.idle\", payload: idlePayload()}\n86|\tcheckpoint := eventSpec{typ: \"checkpoint.created\", payload: checkpointPayload()}\n87|\ttransferred := eventSpec{epoch: 2, leaseID: testLeaseIDB, typ: \"lease.transferred\", payload: transferredPayload(testLeaseID, testLeaseIDB)}\n88|\n89|\tcases := []struct {\n90|\t\tname  string\n91|\t\tchain []eventSpec\n92|\t\twant  State\n93|\t}{\n94|\t\t{\"creating\", []eventSpec{created}, StateCreating},\n95|\t\t{\"running\", []eventSpec{created, launched}, StateRunning},\n96|\t\t{\"idle\", []eventSpec{created, launched, idle}, StateIdle},\n97|\t\t{\"quiescing\", []eventSpec{created, launched, idle,\n98|\t\t\t{typ: \"session.quiescing\", payload: quiescingPayload()}}, StateQuiescing},\n99|\t\t{\"checkpointing\", []eventSpec{created, launched, idle, checkpoint}, StateCheckpointing},\n100|\t\t{\"stopped\", []eventSpec{created, launched, idle, checkpoint, checkpoint,\n101|\t\t\t{typ: \"session.stopped\", payload: stoppedPayload()}}, StateStopped},\n102|\t\t{\"materializing\", []eventSpec{created, launched, idle, checkpoint, checkpoint,\n103|\t\t\t{typ: \"session.stopped\", payload: stoppedPayload()}, transferred}, StateMaterializing},\n104|\t\t{\"parked\", []eventSpec{created, launched, idle, checkpoint, checkpoint,\n105|\t\t\t{typ: \"session.stopped\", payload: stoppedPayload()}, transferred,\n106|\t\t\t{epoch: 2, leaseID: testLeaseIDB, typ: \"session.parked\", payload: parkedPayload(testLeaseIDB)}}, StateParked},\n107|\t\t{\"failed\", []eventSpec{created, launched,\n108|\t\t\t{typ: \"session.failed\", payload: failedPayload()}}, StateFailed},\n109|\t\t{\"stale\", []eventSpec{created, launched, idle,\n110|\t\t\t{epoch: 2, leaseID: testLeaseIDB, typ: \"lease.forced\", payload: forcedPayload(testLeaseIDB, 1)}}, StateStale},\n111|\t\t{\"tombstoned\", []eventSpec{created, launched, idle, checkpoint, checkpoint,\n112|\t\t\t{typ: \"session.stopped\", payload: stoppedPayload()},\n113|\t\t\t{typ: \"session.tombstoned\", payload: tombstonedPayload()}}, StateTombstoned},\n114|\t}\n115|\tfor _, tc := range cases {\n116|\t\tt.Run(string(tc.want), func(t *testing.T) {\n117|\t\t\tprojection := reduceDirect(t, record, tc.chain)\n118|\t\t\tif projection.State != tc.want {\n119|\t\t\t\tt.Fatalf(\"Reduce state = %q, want %q\", projection.State, tc.want)\n120|\t\t\t}\n(more lines below)","final_result":true}}}
