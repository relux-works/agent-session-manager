{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4f5","stream":{"kind":"session","id":"01a0ae2e-304f-7791-b344-a738da145935"},"sequence":213,"recorded_at":1780531400000421,"record_type":"event","durability":"durable","causation_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","run_stream":{"kind":"run","id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3"},"task_stream":{"kind":"task","id":"01a0ae2e-a660-78b3-bf83-b94ebf635bde"},"task_id":"01a0ae2e-a660-78b3-bf83-b94ebf635bde","event":{"kind":"output","task_id":"01a0ae2e-a660-78b3-bf83-b94ebf635bde","chunk":"Read text file `internal/sessrepo/lease_store.go`.\n(499 line(s) above)\n500|// scanLeaseBlobs collects and orders the verified lease summaries. Every\n501|// failure is a plain error; loadLeasesLocked attributes it through its one\n502|// refusal site.\n503|func scanLeaseBlobs(directory, sessionID string) ([]LeaseSummary, error) {\n504|\tentries, err := os.ReadDir(filepath.Join(directory, \"leases\"))\n505|\tif err != nil {\n506|\t\tif os.IsNotExist(err) {\n507|\t\t\treturn nil, nil\n508|\t\t}\n509|\t\treturn nil, fmt.Errorf(\"read leases namespace: %w\", err)\n510|\t}\n511|\tvar stored []LeaseSummary\n512|\tfor _, entry := range entries {\n513|\t\tname := entry.Name()\n514|\t\tif strings.HasPrefix(name, \".\") {\n515|\t\t\tcontinue\n516|\t\t}\n517|\t\texpected, err := leaseDigestForName(name)\n518|\t\tif err != nil {\n519|\t\t\treturn nil, err\n520|\t\t}\n521|\t\tblob, err := os.ReadFile(filepath.Join(directory, \"leases\", name))\n522|\t\tif err != nil {\n523|\t\t\treturn nil, fmt.Errorf(\"read lease %s: %w\", name, err)\n524|\t\t}\n525|\t\tsummary, err := decodeStoredLease(sessionID, blob)\n526|\t\tif err != nil {\n527|\t\t\treturn nil, fmt.Errorf(\"lease %s: %v\", name, err)\n528|\t\t}\n529|\t\tif summary.RecordID != expected {\n530|\t\t\treturn nil, fmt.Errorf(\"lease %s attests %s\", name, summary.RecordID)\n531|\t\t}\n532|\t\tstored = append(stored, summary)\n533|\t}\n534|\tsort.Slice(stored, func(i, j int) bool { return CompareLeaseTuple(stored[i], stored[j]) < 0 })\n535|\treturn stored, nil\n536|}\n537|\n538|// verifyLeaseBlob decodes one blob and binds it to its expected session\n539|// and digest name. Failures are plain errors; the caller attributes them\n540|// through its own refusal site.\n541|func verifyLeaseBlob(sessionID, expected string, blob []byte) error {\n542|\tsummary, err := decodeStoredLease(sessionID, blob)\n543|\tif err != nil {\n544|\t\treturn err\n545|\t}\n546|\tif summary.RecordID != expected {\n547|\t\treturn fmt.Errorf(\"blob attests %s, want %s\", summary.RecordID, expected)\n548|\t}\n549|\treturn nil\n550|}\n551|\n552|// leaseDigestForName renders a leases-namespace file name back to the\n553|// digest it must hold. Anything outside hex.json is torn store, never a\n554|// skipped entry: only staged temps are ignorable.\n555|func leaseDigestForName(name string) (string, error) {\n556|\ttrimmed := strings.TrimSuffix(name, \".json\")\n557|\tdigest, err := scalar.ParseDigest(\"sha256:\" + trimmed)\n558|\tif err != nil {\n559|\t\treturn \"\", fmt.Errorf(\"lease file %q is not a digest path: %v\", name, err)\n560|\t}\n561|\treturn digest.String(), nil\n562|}\n563|\n564|// installLeaseBlobLocked installs one minted lease blob atomically: staged\n565|// bytes fsync before the rename, the directory fsyncs after. A second\n566|// install of identical bytes is reused; disagreeing bytes at a digest path\n567|// are torn store. AfterLeaseStage fires after the staged fsync and before\n568|// the rename — the kill seam the crash tests drive — and is nil in normal\n569|// operation. Callers hold the repository mutex.\n570|func (repository *Repository) installLeaseBlobLocked(directory, recordID string, data []byte) error {\n571|\tleases := filepath.Join(directory, \"leases\")\n572|\tif err := os.MkdirAll(leases, 0o700); err != nil {\n573|\t\treturn fmt.Errorf(\"create leases namespace: %w\", err)\n574|\t}\n575|\tpath := filepath.Join(leases, blobFileName(recordID))\n576|\tif existing, err := os.ReadFile(path); err == nil {\n577|\t\tif leaseBytesEqual(existing, data) {\n578|\t\t\treturn nil\n579|\t\t}\n580|\t\treturn refuse(ErrChainCorrupt, \"digest path holds disagreeing bytes for lease\")\n581|\t} else if !os.IsNotExist(err) {\n582|\t\treturn fmt.Errorf(\"read installed lease blob: %w\", err)\n583|\t}\n584|\tstaged, err := os.CreateTemp(leases, leaseStagePrefix)\n585|\tif err != nil {\n586|\t\treturn fmt.Errorf(\"stage lease blob: %w\", err)\n587|\t}\n588|\tstagedPath := staged.Name()\n589|\tfinished := false\n590|\tdefer func() {\n591|\t\tif !finished {\n592|\t\t\t_ = staged.Close()\n593|\t\t\t_ = os.Remove(stagedPath)\n594|\t\t}\n595|\t}()\n596|\tif err := staged.Chmod(0o600); err != nil {\n597|\t\treturn fmt.Errorf(\"mode staged lease blob: %w\", err)\n598|\t}\n599|\tif _, err := staged.Write(data); err != nil {\n600|\t\treturn fmt.Errorf(\"write staged lease blob: %w\", err)\n601|\t}\n602|\tif err := staged.Sync(); err != nil {\n603|\t\treturn fmt.Errorf(\"fsync staged lease blob: %w\", err)\n604|\t}\n605|\tif err := staged.Close(); err != nil {\n606|\t\treturn fmt.Errorf(\"close staged lease blob: %w\", err)\n607|\t}\n608|\tif repository.AfterLeaseStage != nil {\n609|\t\tif err := repository.AfterLeaseStage(); err != nil {\n610|\t\t\treturn err\n611|\t\t}\n612|\t}\n613|\tfinished = true\n614|\tif err := os.Rename(stagedPath, path); err != nil {\n615|\t\treturn fmt.Errorf(\"install lease blob: %w\", err)\n616|\t}\n617|\treturn syncDirectory(leases)\n618|}\n619|\n620|// findExpectedLease resolves a CAS expectation to the stored lease it names.\n621|// An empty or unknown digest resolves nothing: only a persisted record_id\n622|// can be a compare basis.\n623|func findExpectedLease(stored []LeaseSummary, recordID string) (LeaseSummary, bool) {\n624|\tfor _, known := range stored {\n625|\t\tif known.RecordID == recordID {\n626|\t\t\treturn known, true\n627|\t\t}\n628|\t}\n629|\treturn LeaseSummary{}, false\n630|}\n631|\n632|// findIdenticalLease reports the stored lease whose digest equals the minted\n633|// candidate's, so a byte-identical retry returns its reference instead of\n634|// minting a duplicate. The digest is the canonical content identity, so\n635|// digest equality is full-content equality under the same collision\n636|// resistance the content-addressed layout already assumes; the load path\n637|// re-verified every stored blob before this comparison runs.\n638|func findIdenticalLease(stored []LeaseSummary, digest string) (bool, LeaseRef) {\n639|\tfor _, known := range stored {\n640|\t\tif known.RecordID == digest {\n641|\t\t\treturn true, LeaseRef{SessionID: known.SessionID, RecordID: known.RecordID, LeaseID: known.LeaseID, Epoch: known.Epoch, HolderHostID: known.HolderHostID}\n642|\t\t}\n643|\t}\n644|\treturn false, LeaseRef{}\n645|}\n646|\n647|// leaseBytesEqual is the one content-equality site of the lease store,\n648|// registered in the census ledger with its same-length vector.\n649|func leaseBytesEqual(left, right []byte) bool {\n650|\treturn bytes.Equal(left, right)\n651|}\n652|\n653|// mintLeaseRecord builds one canonical Lease Record and returns its bytes\n654|// with the attested record_id. Identity is computed by the canonicaljson\n655|// owner over the placeholder, then confirmed by Verify after the digest is\n656|// bound, so minted bytes always attest. Failures are plain operational\n657|// errors, never refusals: entry validation already admitted the inputs,\n658|// so a mint failure is an internal inconsistency, not a rejected input.\n659|func mintLeaseRecord(sessionID string, epoch uint64, leaseID, holder, issuer, predecessor string, hasPredecessor bool, reason, checkpoint string, hasCheckpoint bool, createdAt string) ([]byte, string, error) {\n660|\tvar predecessorValue any\n661|\tif hasPredecessor {\n662|\t\tpredecessorValue = predecessor\n663|\t}\n664|\tvar checkpointValue any\n665|\tif hasCheckpoint {\n666|\t\tcheckpointValue = checkpoint\n667|\t}\n668|\tobject := map[string]any{\n669|\t\t\"schema\":               leaseRecordSchema,\n670|\t\t\"schema_version\":       \"1.0.0\",\n671|\t\t\"record_id\":            leaseIdentityPlaceholder,\n672|\t\t\"subject_id\":           sessionID,\n673|\t\t\"session_id\":           sessionID,\n674|\t\t\"lease_id\":             leaseID,\n675|\t\t\"epoch\":                epoch,\n676|\t\t\"holder_host_id\":       holder,\n677|\t\t\"predecessor_lease_id\": predecessorValue,\n678|\t\t\"reason\":               reason,\n679|\t\t\"checkpoint_id\":        checkpointValue,\n680|\t\t\"issued_by_host_id\":    issuer,\n681|\t\t\"created_by_host_id\":   issuer,\n682|\t\t\"created_at\":           createdAt,\n683|\t\t\"extensions\":           map[string]any{},\n684|\t}\n685|\tstaged, err := json.Marshal(object)\n686|\tif err != nil {\n687|\t\treturn nil, \"\", fmt.Errorf(\"encode lease record: %w\", err)\n688|\t}\n689|\tdigest, _, err := canonicaljson.CalculateObjectIdentity(staged)\n690|\tif err != nil {\n691|\t\treturn nil, \"\", fmt.Errorf(\"identify lease record: %w\", err)\n692|\t}\n693|\tobject[\"record_id\"] = digest.String()\n694|\traw, err := json.Marshal(object)\n695|\tif err != nil {\n696|\t\treturn nil, \"\", fmt.Errorf(\"encode identified lease record: %w\", err)\n697|\t}\n698|\tif _, _, err := AttestLeaseRecord(raw); err != nil {\n699|\t\treturn nil, \"\", fmt.Errorf(\"attest minted lease record: %w\", err)\n700|\t}\n701|\treturn raw, digest.String(), nil\n702|}\n703|\n704|// decodeStoredLease validates one stored Lease Record through the\n705|// canonicaljson owner and extracts the bound members. Closed-shape,\n706|// coupling, and identity failures are plain errors for the caller to\n707|// attribute; member extraction re-checks grammar through the environ and\n708|// scalar owners, matching the query-layer admission without forking it.\n709|func decodeStoredLease(sessionID string, raw []byte) (LeaseSummary, error) {\n710|\tvar summary LeaseSummary\n711|\tmembers, fault := environ.DecodeStrictObject(raw)\n712|\tif fault != nil {\n713|\t\treturn summary, fmt.Errorf(\"decode lease record frame: %v\", fault)\n714|\t}\n715|\tschema, err := stringMember(members, \"schema\")\n716|\tif err != nil || schema != leaseRecordSchema {\n717|\t\treturn summary, fmt.Errorf(\"lease record schema %q, want %q\", schema, leaseRecordSchema)\n718|\t}\n719|\tdigest, field, err := AttestLeaseRecord(raw)\n720|\tif err != nil {\n721|\t\treturn summary, fmt.Errorf(\"verify lease record identity: %v\", err)\n722|\t}\n723|\tif field != canonicaljson.SelfRecordID {\n724|\t\treturn summary, fmt.Errorf(\"lease record identity field %q, want record_id\", string(field))\n725|\t}\n726|\trecordSession, ok := environ.CheckUUIDv7(members[\"session_id\"])\n727|\tif !ok {\n728|\t\treturn summary, fmt.Errorf(\"lease record carries no valid session_id member\")\n729|\t}\n730|\tif recordSession.String() != sessionID {\n731|\t\treturn summary, fmt.Errorf(\"lease record session %s does not match stored session %s\", recordSession.String(), sessionID)\n732|\t}\n733|\tleaseID, err := stringMember(members, \"lease_id\")\n734|\tif err != nil {\n735|\t\treturn summary, fmt.Errorf(\"lease record carries no lease_id member: %v\", err)\n736|\t}\n737|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n738|\t\treturn summary, fmt.Errorf(\"lease record lease_id: %v\", err)\n739|\t}\n740|\tepoch, ok := environ.CheckUint53Bounds(members[\"epoch\"], 1, uint53Max)\n741|\tif !ok {\n742|\t\treturn summary, fmt.Errorf(\"lease record carries no epoch at or above 1\")\n743|\t}\n744|\tholder, ok := environ.CheckUUIDv7(members[\"holder_host_id\"])\n745|\tif !ok {\n746|\t\treturn summary, fmt.Errorf(\"lease record carries no valid holder_host_id member\")\n747|\t}\n748|\tpredecessor, hasPredecessor, err := nullableUUIDv4Member(members, \"predecessor_lease_id\")\n749|\tif err != nil {\n750|\t\treturn summary, fmt.Errorf(\"lease record predecessor_lease_id: %v\", err)\n751|\t}\n752|\tcheckpoint, hasCheckpoint, err := nullableDigestMember(members, \"checkpoint_id\")\n753|\tif err != nil {\n754|\t\treturn summary, fmt.Errorf(\"lease record checkpoint_id: %v\", err)\n755|\t}\n756|\treason, err := stringMember(members, \"reason\")\n757|\tif err != nil {\n758|\t\treturn summary, fmt.Errorf(\"lease record carries no reason member: %v\", err)\n759|\t}\n760|\tsummary = LeaseSummary{RecordID: digest.String(), SessionID: recordSession.String(), LeaseID: leaseID, Epoch: epoch, HolderHostID: holder.String(), Predecessor: predecessor, HasPredecessor: hasPredecessor, Checkpoint: checkpoint, HasCheckpoint: hasCheckpoint, Reason: reason}\n761|\treturn summary, nil\n762|}\n763|\n764|// nullableUUIDv4Member reads a member that is null or a UUIDv4 string. A\n765|// nil pointer binds JSON null without any text comparison.\n766|func nullableUUIDv4Member(members map[string]json.RawMessage, name string) (string, bool, error) {\n767|\traw, ok := members[name]\n768|\tif !ok {\n769|\t\treturn \"\", false, fmt.Errorf(\"member %q is absent\", name)\n770|\t}\n771|\tvar value *string\n772|\tif err := json.Unmarshal(raw, &value); err != nil {\n773|\t\treturn \"\", false, fmt.Errorf(\"member %q is neither a UUID nor null\", name)\n774|\t}\n775|\tif value == nil {\n776|\t\treturn \"\", false, nil\n777|\t}\n778|\tif _, err := scalar.ParseUUIDv4(*value); err != nil {\n779|\t\treturn \"\", false, err\n780|\t}\n781|\treturn *value, true, nil\n782|}\n783|\n784|// nullableDigestMember reads a member that is null or a digest string. A\n785|// nil pointer binds JSON null without any text comparison.\n786|func nullableDigestMember(members map[string]json.RawMessage, name string) (string, bool, error) {\n787|\traw, ok := members[name]\n788|\tif !ok {\n789|\t\treturn \"\", false, fmt.Errorf(\"member %q is absent\", name)\n790|\t}\n791|\tvar value *string\n792|\tif err := json.Unmarshal(raw, &value); err != nil {\n793|\t\treturn \"\", false, fmt.Errorf(\"member %q is neither a digest nor null\", name)\n794|\t}\n795|\tif value == nil {\n796|\t\treturn \"\", false, nil\n797|\t}\n798|\tdigest, err := scalar.ParseDigest(*value)\n799|\tif err != nil {\n800|\t\treturn \"\", false, err\n801|\t}\n802|\treturn digest.String(), true, nil\n803|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4f7","stream":{"kind":"session","id":"01a0ae2e-304f-7791-b344-a738da145935"},"sequence":214,"recorded_at":1780531400000423,"record_type":"event","durability":"durable","causation_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","run_stream":{"kind":"run","id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3"},"task_stream":{"kind":"task","id":"01a0ae2e-a660-78b3-bf83-b94ebf635bde"},"task_id":"01a0ae2e-a660-78b3-bf83-b94ebf635bde","event":{"kind":"completed","task_id":"01a0ae2e-a660-78b3-bf83-b94ebf635bde"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4f9","stream":{"kind":"session","id":"01a0ae2e-304f-7791-b344-a738da145935"},"sequence":215,"recorded_at":1780531400000425,"record_type":"event","durability":"durable","causation_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","run_stream":{"kind":"run","id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3"},"task_stream":{"kind":"task","id":"01a0ae2e-a63d-7841-8c87-ef4a7deebb13"},"task_id":"01a0ae2e-a63d-7841-8c87-ef4a7deebb13","event":{"kind":"output","task_id":"01a0ae2e-a63d-7841-8c87-ef4a7deebb13","chunk":"Read text file `internal/sessstate/sessstate.go`.\n(499 line(s) above)\n500|\t\treturn true, nil\n501|\tdefault:\n502|\t\treturn false, refuse(ErrStaleLease, \"event %s lease epoch %d precedes chain head epoch %d\", event.ID, lease.Epoch, fold.current.Epoch)\n503|\t}\n504|}\n505|\n506|// tailID and tailSeq live beside the fold; declared here to keep the\n507|// struct literal above readable.\n508|func (fold *chainFold) conflict(kind, rule, format string, arguments ...any) {\n509|\tfold.projection.Conflicts = append(fold.projection.Conflicts, Conflict{\n510|\t\tKind:   kind,\n511|\t\tRule:   rule,\n512|\t\tDetail: fmt.Sprintf(format, arguments...),\n513|\t})\n514|}\n515|\n516|// step moves the derivation through the Section 5.7 table. An empty\n517|// target keeps the state (a fact or inert event performs no\n518|// transition); an equal target restates it (a confirming event while\n519|// already there is not a transition); the first event may only open a\n520|// bootstrap state; every other move needs its table edge, else\n521|// invalid_state_transition.\n522|func (fold *chainFold) step(target State, what string) error {\n523|\tif target == \"\" || target == fold.state {\n524|\t\treturn nil\n525|\t}\n526|\tif fold.state == \"\" {\n527|\t\tif _, ok := initialTargets[target]; !ok {\n528|\t\t\treturn refuse(ErrInvalidTransition, \"%s opens unbootstrapped state %q\", what, string(target))\n529|\t\t}\n530|\t\tfold.state = target\n531|\t\treturn nil\n532|\t}\n533|\tif _, ok := allowedTransitions[fold.state][target]; !ok {\n534|\t\treturn refuse(ErrInvalidTransition, \"%s moves %q to %q without a Section 5.7 edge\", what, string(fold.state), string(target))\n535|\t}\n536|\tfold.state = target\n537|\treturn nil\n538|}\n539|\n540|// effect applies one event's lifecycle meaning after continuity and\n541|// lease tracking. Fact events return an empty target and keep the\n542|// state; unknown v1 types and the v2/v3/v4 non-lifecycle types are\n543|// inert by Section 5.2 (retained, never applied).\n544|func (fold *chainFold) effect(event Event, lease LeaseHead, succession bool) error {\n545|\tname := \"event \" + event.Type + \" \" + event.ID\n546|\tswitch event.Type {\n547|\tcase \"session.created\":\n548|\t\treturn fold.effectCreated(event, name)\n549|\tcase \"terminal.created\":\n550|\t\treturn fold.effectTerminalCreated(event, name)\n551|\tcase \"provider.launched\":\n552|\t\treturn fold.effectProviderLaunched(event, name)\n553|\tcase \"provider.identified\":\n554|\t\treturn fold.effectProviderIdentified(event, name)\n555|\tcase \"session.idle\":\n556|\t\treturn fold.step(StateIdle, name)\n557|\tcase \"session.quiescing\":\n558|\t\treturn fold.step(StateQuiescing, name)\n559|\tcase \"checkpoint.created\":\n560|\t\treturn fold.effectCheckpointCreated(event, name)\n561|\tcase \"sync.completed\":\n562|\t\treturn nil\n563|\tcase \"session.stopped\":\n564|\t\treturn fold.effectStopped(event, name)\n565|\tcase \"session.resumed\":\n566|\t\treturn fold.effectResumed(event, name)\n567|\tcase \"session.bootstrap_aborted\":\n568|\t\treturn fold.effectBootstrapAborted(event, name)\n569|\tcase \"lease.transferred\", \"lease.forced\":\n570|\t\treturn fold.effectLease(event, lease, name, succession)\n571|\tcase \"session.parked\":\n572|\t\treturn fold.step(StateParked, name)\n573|\tcase \"session.failed\":\n574|\t\treturn fold.step(StateFailed, name)\n575|\tcase \"fork.created\", \"profile.changed\", \"takeover.force_confirmed\",\n576|\t\t\"replica.replace_confirmed\", \"task_board.adopted\",\n577|\t\t\"tombstone.issued\", \"tombstone.resolved\":\n578|\t\treturn nil\n579|\tcase \"session.tombstoned\":\n580|\t\treturn fold.step(StateTombstoned, name)\n581|\tcase \"task_board.launched\":\n582|\t\treturn fold.effectTaskBoardLaunched(event, name)\n583|\tdefault:\n584|\t\treturn nil\n585|\t}\n586|}\n587|\n588|// effectCreated opens the bootstrap, including the Section 5.7\n589|// failed-to-creating retry: epoch 1 under the same winning create\n590|// lease, no validated checkpoint yet, and no authoritative bootstrap\n591|// abort on record. Anything else that reaches for creating refuses.\n592|func (fold *chainFold) effectCreated(event Event, what string) error {\n593|\tif fold.state == \"\" {\n594|\t\treturn fold.step(StateCreating, what)\n595|\t}\n596|\tif fold.state != StateFailed {\n597|\t\treturn fold.step(StateCreating, what)\n598|\t}\n599|\tif event.LeaseEpoch != 1 || event.LeaseID != fold.createLease.LeaseID ||\n600|\t\tevent.LeaseEpoch != fold.createLease.Epoch {\n601|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap under a new lease\", what)\n602|\t}\n603|\tif fold.seenCheckpoint {\n604|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap past a validated checkpoint\", what)\n605|\t}\n606|\tif fold.seenAbort {\n607|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap past an authoritative abort\", what)\n608|\t}\n609|\treturn fold.step(StateCreating, what)\n610|}\n611|\n612|// effectTerminalCreated records the terminal binding; as the first\n613|// event it also opens the bootstrap in creating.\n614|func (fold *chainFold) effectTerminalCreated(event Event, what string) error {\n615|\tif event.SchemaVersion == \"4.0.0\" {\n616|\t\tbinding, err := payloadString(event.Payload, \"terminal_binding_id\")\n617|\t\tif err != nil {\n618|\t\t\treturn err\n619|\t\t}\n620|\t\tif _, err := scalar.ParseDigest(binding); err != nil {\n621|\t\t\treturn refuse(ErrDerivation, \"%s carries malformed terminal_binding_id: %v\", what, err)\n622|\t\t}\n623|\t\tbackend, err := payloadString(event.Payload, \"terminal_backend_id\")\n624|\t\tif err != nil {\n625|\t\t\treturn err\n626|\t\t}\n627|\t\tif _, err := terminalbackend.ParseID(backend); err != nil {\n628|\t\t\treturn refuse(ErrDerivation, \"%s carries refused terminal backend: %v\", what, err)\n629|\t\t}\n630|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, BindingID: binding, EventID: event.ID}\n631|\t} else {\n632|\t\tbackend, err := payloadString(event.Payload, \"backend\")\n633|\t\tif err != nil {\n634|\t\t\treturn err\n635|\t\t}\n636|\t\tif backend != \"tmux\" && backend != \"conpty\" {\n637|\t\t\treturn refuse(ErrDerivation, \"%s carries unknown terminal backend %q\", what, backend)\n638|\t\t}\n639|\t\tterminalID, err := payloadString(event.Payload, \"terminal_id\")\n640|\t\tif err != nil {\n641|\t\t\treturn err\n642|\t\t}\n643|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, TerminalID: terminalID, EventID: event.ID}\n644|\t}\n645|\tfold.projection.HasTerminal = true\n646|\tif fold.state == \"\" {\n647|\t\treturn fold.step(StateCreating, what)\n648|\t}\n649|\treturn nil\n650|}\n651|\n652|// effectProviderLaunched moves to running and records the launched\n653|// version. The record provider stays authoritative: a launched event\n654|// naming another provider records a provider_mismatch conflict under\n655|// the record-pinned-provider-wins rule instead of rewriting identity.\n656|func (fold *chainFold) effectProviderLaunched(event Event, what string) error {\n657|\tproviderID, err := payloadString(event.Payload, \"provider_id\")\n658|\tif err != nil {\n659|\t\treturn err\n660|\t}\n661|\tversion, err := payloadString(event.Payload, \"provider_version\")\n662|\tif err != nil {\n663|\t\treturn err\n664|\t}\n665|\tif providerID != fold.recordProvider {\n666|\t\tfold.conflict(ConflictProviderMismatch, ResolveRuleRecordPinnedProviderWins,\n667|\t\t\t\"event %s launches provider %q under record provider %q; the record value stays authoritative\",\n668|\t\t\tevent.ID, providerID, fold.recordProvider)\n669|\t} else {\n670|\t\tfold.projection.Provider.Version = version\n671|\t}\n672|\treturn fold.step(StateRunning, what)\n673|}\n674|\n675|// effectProviderIdentified records the newest identity record with\n676|// its confidence.\n677|func (fold *chainFold) effectProviderIdentified(event Event, what string) error {\n678|\trecordID, err := payloadString(event.Payload, \"provider_identity_record_id\")\n679|\tif err != nil {\n680|\t\treturn err\n681|\t}\n682|\tif _, err := scalar.ParseDigest(recordID); err != nil {\n683|\t\treturn refuse(ErrDerivation, \"%s carries malformed provider_identity_record_id: %v\", what, err)\n684|\t}\n685|\tconfidence, err := payloadString(event.Payload, \"confidence\")\n686|\tif err != nil {\n687|\t\treturn err\n688|\t}\n689|\tfold.projection.Provider.IdentityRecordID = recordID\n690|\tfold.projection.Provider.Confidence = confidence\n691|\treturn nil\n692|}\n693|\n694|// effectCheckpointCreated records the newest validated checkpoint and\n695|// moves idle or quiescing into checkpointing, or checkpointing back to\n696|// idle at the validated boundary. Any other lifecycle position refuses:\n697|// a checkpoint cannot land while running, creating, stopped, parked,\n698|// failed, stale, materializing, or tombstoned without the quiesce or\n699|// resume the table requires.\n700|func (fold *chainFold) effectCheckpointCreated(event Event, what string) error {\n701|\tcheckpointID, err := payloadString(event.Payload, \"checkpoint_id\")\n702|\tif err != nil {\n703|\t\treturn err\n704|\t}\n705|\tif _, err := scalar.ParseDigest(checkpointID); err != nil {\n706|\t\treturn refuse(ErrDerivation, \"%s carries malformed checkpoint_id: %v\", what, err)\n707|\t}\n708|\tkind, err := payloadString(event.Payload, \"kind\")\n709|\tif err != nil {\n710|\t\treturn err\n711|\t}\n712|\tfold.noteCheckpoint(checkpointID, kind, event.ID)\n713|\tswitch fold.state {\n714|\tcase \"\", StateIdle, StateQuiescing:\n715|\t\tif fold.state == \"\" {\n716|\t\t\treturn refuse(ErrInvalidTransition, \"%s publishes a checkpoint before any bootstrap\", what)\n717|\t\t}\n718|\t\treturn fold.step(StateCheckpointing, what)\n719|\tcase StateCheckpointing:\n720|\t\treturn fold.step(StateIdle, what)\n721|\tdefault:\n722|\t\treturn fold.step(StateCheckpointing, what)\n723|\t}\n724|}\n725|\n726|// effectStopped derives stopped for a checkpointed closure and failed\n727|// for a bootstrap abort. No event may derive stopped while the newest\n728|// checkpoint is null: the event's own checkpoint counts, so a\n729|// checkpointed stop carries its resumable base with it. A bootstrap\n730|// abort requires the null checkpoint, false resumable and graceful\n731|// values the canonical owner admitted, plus a preceding authoritative\n732|// abort event; an ambiguous live process stays failed with recovery\n733|// diagnostics instead.\n734|func (fold *chainFold) effectStopped(event Event, what string) error {\n735|\tcheckpointID, hasCheckpoint, err := payloadNullableDigest(event.Payload, \"checkpoint_id\")\n736|\tif err != nil {\n737|\t\treturn err\n738|\t}\n739|\tresumable, err := payloadBool(event.Payload, \"resumable\")\n740|\tif err != nil {\n741|\t\treturn err\n742|\t}\n743|\tclosure, err := payloadString(event.Payload, \"closure_kind\")\n744|\tif err != nil {\n745|\t\treturn err\n746|\t}\n747|\tif closure == \"checkpointed\" {\n748|\t\tif !hasCheckpoint || !resumable {\n749|\t\t\treturn refuse(ErrIntegrity, \"%s closes checkpointed without a resumable checkpoint\", what)\n750|\t\t}\n751|\t\tfold.noteCheckpoint(checkpointID, \"\", event.ID)\n752|\t\treturn fold.step(StateStopped, what)\n753|\t}\n754|\tif hasCheckpoint || resumable {\n755|\t\treturn refuse(ErrIntegrity, \"%s closes bootstrap_abort with a checkpoint or resumable set\", what)\n756|\t}\n757|\tif !fold.seenAbort {\n758|\t\treturn refuse(ErrInvalidTransition, \"%s closes bootstrap_abort with no authoritative abort event\", what)\n759|\t}\n760|\treturn fold.step(StateFailed, what)\n761|}\n762|\n763|// effectResumed moves to running under the resumed checkpoint and\n764|// records the terminal binding the resume selected.\n765|func (fold *chainFold) effectResumed(event Event, what string) error {\n766|\tcheckpointID, err := payloadString(event.Payload, \"checkpoint_id\")\n767|\tif err != nil {\n768|\t\treturn err\n769|\t}\n770|\tif _, err := scalar.ParseDigest(checkpointID); err != nil {\n771|\t\treturn refuse(ErrDerivation, \"%s carries malformed checkpoint_id: %v\", what, err)\n772|\t}\n773|\tfold.noteCheckpoint(checkpointID, \"\", event.ID)\n774|\tif event.SchemaVersion == \"4.0.0\" {\n775|\t\tbinding, err := payloadString(event.Payload, \"terminal_binding_id\")\n776|\t\tif err != nil {\n777|\t\t\treturn err\n778|\t\t}\n779|\t\tif _, err := scalar.ParseDigest(binding); err != nil {\n780|\t\t\treturn refuse(ErrDerivation, \"%s carries malformed terminal_binding_id: %v\", what, err)\n781|\t\t}\n782|\t\tbackend, err := payloadString(event.Payload, \"terminal_backend_id\")\n783|\t\tif err != nil {\n784|\t\t\treturn err\n785|\t\t}\n786|\t\tif _, err := terminalbackend.ParseID(backend); err != nil {\n787|\t\t\treturn refuse(ErrDerivation, \"%s carries refused terminal backend: %v\", what, err)\n788|\t\t}\n789|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, BindingID: binding, EventID: event.ID}\n790|\t} else {\n791|\t\tbackend, err := payloadString(event.Payload, \"terminal_backend\")\n792|\t\tif err != nil {\n793|\t\t\treturn err\n794|\t\t}\n795|\t\tif backend != \"tmux\" && backend != \"conpty\" {\n796|\t\t\treturn refuse(ErrDerivation, \"%s carries unknown terminal backend %q\", what, backend)\n797|\t\t}\n798|\t\tnativeID, err := payloadString(event.Payload, \"native_session_id\")\n799|\t\tif err != nil {\n800|\t\t\treturn err\n801|\t\t}\n802|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, NativeSessionID: nativeID, EventID: event.ID}\n803|\t}\n804|\tfold.projection.HasTerminal = true\n805|\treturn fold.step(StateRunning, what)\n806|}\n807|\n808|// effectBootstrapAborted records the authoritative abort and fails the\n809|// bootstrap. Only the creating session can abort its bootstrap; any\n810|// later abort is invalid_state_transition.\n811|func (fold *chainFold) effectBootstrapAborted(event Event, what string) error {\n812|\tfold.seenAbort = true\n813|\tif fold.state != \"\" && fold.state != StateCreating {\n814|\t\treturn refuse(ErrInvalidTransition, \"%s aborts a bootstrap past creating\", what)\n815|\t}\n816|\treturn fold.step(StateFailed, what)\n817|}\n818|\n819|// effectLease checks the successor-lease payload linkage: the payload\n820|// must name the predecessor the chain stands on and the envelope it\n821|// arrives under, else integrity_failure. The lifecycle move already\n822|// happened in successionMove; a lease event repeating the current\n823|// lease is a fact, not a transition.\n824|func (fold *chainFold) effectLease(event Event, lease LeaseHead, what string, succession bool) error {\n825|\tif !succession {\n826|\t\treturn nil\n827|\t}\n828|\tif event.Type == \"lease.transferred\" {\n829|\t\tpredecessor, err := payloadString(event.Payload, \"predecessor_lease_id\")\n830|\t\tif err != nil {\n831|\t\t\treturn err\n832|\t\t}\n833|\t\tif predecessor != fold.previous.LeaseID {\n834|\t\t\treturn refuse(ErrIntegrity, \"%s transfers from lease %s past chain head lease %s\", what, predecessor, fold.previous.LeaseID)\n835|\t\t}\n836|\t\tsuccessor, err := payloadString(event.Payload, \"new_lease_id\")\n837|\t\tif err != nil {\n838|\t\t\treturn err\n839|\t\t}\n840|\t\tif successor != lease.LeaseID {\n841|\t\t\treturn refuse(ErrIntegrity, \"%s transfers to lease %s outside its envelope lease %s\", what, successor, lease.LeaseID)\n842|\t\t}\n843|\t} else {\n844|\t\tsuccessor, err := payloadString(event.Payload, \"new_lease_id\")\n845|\t\tif err != nil {\n846|\t\t\treturn err\n847|\t\t}\n848|\t\tif successor != lease.LeaseID {\n849|\t\t\treturn refuse(ErrIntegrity, \"%s forces lease %s outside its envelope lease %s\", what, successor, lease.LeaseID)\n850|\t\t}\n851|\t}\n852|\treturn nil\n853|}\n854|\n855|// effectTaskBoardLaunched enforces the Section 5.2 repeat rule — the\n856|// event must repeat the winning creation lease and the Session\n857|// Record's provider and launch mode — then derives the payload's\n858|// running or idle state through the table.\n859|func (fold *chainFold) effectTaskBoardLaunched(event Event, what string) error {\n860|\tproviderID, err := payloadString(event.Payload, \"provider_id\")\n861|\tif err != nil {\n862|\t\treturn err\n863|\t}\n864|\tif providerID != fold.recordProvider {\n865|\t\treturn refuse(ErrIntegrity, \"%s repeats provider %q past record provider %q\", what, providerID, fold.recordProvider)\n866|\t}\n867|\tpayloadEpoch, err := payloadUint(event.Payload, \"lease_epoch\")\n868|\tif err != nil {\n869|\t\treturn err\n870|\t}\n871|\tpayloadLease, err := payloadString(event.Payload, \"lease_id\")\n872|\tif err != nil {\n873|\t\treturn err\n874|\t}\n875|\tif payloadEpoch != fold.createLease.Epoch || payloadLease != fold.createLease.LeaseID {\n876|\t\treturn refuse(ErrIntegrity, \"%s repeats creation lease (%d, %s) past create lease (%d, %s)\", what, payloadEpoch, payloadLease, fold.createLease.Epoch, fold.createLease.LeaseID)\n877|\t}\n878|\treported, err := payloadString(event.Payload, \"state\")\n879|\tif err != nil {\n880|\t\treturn err\n881|\t}\n882|\tif reported == string(StateRunning) {\n883|\t\treturn fold.step(StateRunning, what)\n884|\t}\n885|\treturn fold.step(StateIdle, what)\n886|}\n887|\n888|// noteCheckpoint records the newest validated checkpoint.\n889|func (fold *chainFold) noteCheckpoint(id, kind, eventID string) {\n890|\tfold.seenCheckpoint = true\n891|\tfold.projection.HasCheckpoint = true\n892|\tfold.projection.Newest = Checkpoint{ID: id, Kind: kind, EventID: eventID}\n893|}\n894|\n895|// resolveWinner selects the winning lease over the authoritative chain\n896|// leases and the union leases by the greatest (epoch, lease_id)\n897|// tuple. A same-epoch tie resolves to the bytewise-greater lease ID;\n898|// an off-chain union winner moves the reported winner but never\n899|// rewrites authoritative state; union leases that lose are reported\n900|// preserved-never-applied. With no union the chain head wins alone\n901|// and no conflict is recorded.\n902|func (fold *chainFold) resolveWinner(union []LeaseHead) error {\n903|\twinner := fold.current\n904|\tonChain := map[string]struct{}{}\n905|\tif fold.haveLease {\n906|\t\tonChain[fold.current.LeaseID] = struct{}{}\n907|\t}\n908|\tfor _, lease := range fold.chainLeases() {\n909|\t\tonChain[lease.LeaseID] = struct{}{}\n910|\t}\n911|\tbyEpoch := map[uint64]map[string]struct{}{}\n912|\tnote := func(lease LeaseHead) {\n913|\t\tif byEpoch[lease.Epoch] == nil {\n914|\t\t\tbyEpoch[lease.Epoch] = map[string]struct{}{}\n915|\t\t}\n916|\t\tbyEpoch[lease.Epoch][lease.LeaseID] = struct{}{}\n917|\t}\n918|\tfor _, lease := range fold.chainLeases() {\n919|\t\tnote(lease)\n920|\t}\n921|\toffChainWinner := false\n922|\tfor _, lease := range union {\n923|\t\tif lease.IsZero() {\n924|\t\t\treturn refuse(ErrInvalidEvent, \"union carries an empty lease head\")\n925|\t\t}\n926|\t\tif _, err := scalar.ParseUUIDv4(lease.LeaseID); err != nil {\n927|\t\t\treturn refuse(ErrInvalidEvent, \"union lease %q is not a UUIDv4: %v\", lease.LeaseID, err)\n928|\t\t}\n929|\t\tnote(lease)\n930|\t\tswitch Compare(lease, winner) {\n931|\t\tcase 1:\n932|\t\t\twinner = lease\n933|\t\t\tif _, ok := onChain[lease.LeaseID]; !ok {\n934|\t\t\t\toffChainWinner = true\n935|\t\t\t}\n936|\t\tcase -1:\n937|\t\t\tfold.conflict(ConflictLosingBranchPreserved, ResolveRulePreservedNeverApplied,\n938|\t\t\t\t\"union lease (%d, %s) loses to (%d, %s); its history stays preserved and never applies\",\n939|\t\t\t\tlease.Epoch, lease.LeaseID, winner.Epoch, winner.LeaseID)\n940|\t\tcase 0:\n941|\t\t\t// A duplicate union entry names the tuple already\n942|\t\t\t// selected: the winner and the off-chain flag stand.\n943|\t\t\t// Clearing here would drop a correctly recorded\n944|\t\t\t// union_supersedes_chain conflict (and its\n945|\t\t\t// divergent_history warning) on a repeated entry.\n946|\t\t}\n947|\t}\n948|\tepochs := make([]uint64, 0, len(byEpoch))\n949|\tfor epoch := range byEpoch {\n950|\t\tepochs = append(epochs, epoch)\n951|\t}\n952|\tsort.Slice(epochs, func(i, j int) bool { return epochs[i] < epochs[j] })\n953|\tfor _, epoch := range epochs {\n954|\t\trivals := byEpoch[epoch]\n955|\t\tif len(rivals) < 2 {\n956|\t\t\tcontinue\n957|\t\t}\n958|\t\tordered := make([]string, 0, len(rivals))\n959|\t\tfor id := range rivals {\n960|\t\t\tordered = append(ordered, id)\n961|\t\t}\n962|\t\tsort.Strings(ordered)\n963|\t\tfold.conflict(ConflictSameEpochTie, ResolveRuleGreatestLeaseIDWins,\n964|\t\t\t\"epoch %d is shared by leases %v; the bytewise-greater lease ID %s wins\",\n965|\t\t\tepoch, ordered, ordered[len(ordered)-1])\n966|\t}\n967|\tif offChainWinner {\n968|\t\tfold.conflict(ConflictUnionSupersedesChain, ResolveRuleAuthoritativeStateUnchanged,\n969|\t\t\t\"union winner (%d, %s) stands outside the authoritative chain; derived state is unchanged until an explicit takeover lands\",\n970|\t\t\twinner.Epoch, winner.LeaseID)\n971|\t}\n972|\tfold.projection.Winner = winner\n973|\treturn nil\n974|}\n975|\n976|// chainLeases replays the distinct envelope leases in first-appearance\n977|// order. Every succession appends, so a tie planted at any past epoch\n978|// still resolves against the lease the chain actually stood on. Gaps\n979|// were already recorded at succession time.\n980|func (fold *chainFold) chainLeases() []LeaseHead {\n981|\treturn append([]LeaseHead(nil), fold.leases...)\n982|}\n983|\n984|// applyLocalLease derives the local projection: the owner host of the\n985|// newest authoritative event decides the local role against the\n986|// caller-supplied host, and a local lease that lost the tuple rule\n987|// stales the projection exactly where the table lets it go stale.\n988|func (fold *chainFold) applyLocalLease(local LeaseHead, localHostID string) {\n989|\tif localHostID != \"\" && fold.projection.OwnerHostID != \"\" {\n990|\t\tif localHostID == fold.projection.OwnerHostID {\n991|\t\t\tfold.projection.LocalRole = \"owner\"\n992|\t\t} else {\n993|\t\t\tfold.projection.LocalRole = \"replica\"\n994|\t\t}\n995|\t}\n996|\tif local.IsZero() || !fold.haveLease {\n997|\t\treturn\n998|\t}\n999|\t// Only a lease that lost the tuple rule stales the projection:\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4fb","stream":{"kind":"session","id":"01a0ae2e-304f-7791-b344-a738da145935"},"sequence":216,"recorded_at":1780531400000427,"record_type":"event","durability":"durable","causation_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","run_stream":{"kind":"run","id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3"},"task_stream":{"kind":"task","id":"01a0ae2e-a63d-7841-8c87-ef4a7deebb13"},"task_id":"01a0ae2e-a63d-7841-8c87-ef4a7deebb13","event":{"kind":"completed","task_id":"01a0ae2e-a63d-7841-8c87-ef4a7deebb13"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4fd","stream":{"kind":"session","id":"01a0ae2e-304f-7791-b344-a738da145935"},"sequence":217,"recorded_at":1780531400000429,"record_type":"event","durability":"durable","causation_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","run_stream":{"kind":"run","id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3"},"call_id":"call_01a0ae2e9de0749aae9481046e7aa08c","text":"Read text file `internal/sessstate/sessstate.go`.\n(499 line(s) above)\n500|\t\treturn true, nil\n501|\tdefault:\n502|\t\treturn false, refuse(ErrStaleLease, \"event %s lease epoch %d precedes chain head epoch %d\", event.ID, lease.Epoch, fold.current.Epoch)\n503|\t}\n504|}\n505|\n506|// tailID and tailSeq live beside the fold; declared here to keep the\n507|// struct literal above readable.\n508|func (fold *chainFold) conflict(kind, rule, format string, arguments ...any) {\n509|\tfold.projection.Conflicts = append(fold.projection.Conflicts, Conflict{\n510|\t\tKind:   kind,\n511|\t\tRule:   rule,\n512|\t\tDetail: fmt.Sprintf(format, arguments...),\n513|\t})\n514|}\n515|\n516|// step moves the derivation through the Section 5.7 table. An empty\n517|// target keeps the state (a fact or inert event performs no\n518|// transition); an equal target restates it (a confirming event while\n519|// already there is not a transition); the first event may only open a\n520|// bootstrap state; every other move needs its table edge, else\n521|// invalid_state_transition.\n522|func (fold *chainFold) step(target State, what string) error {\n523|\tif target == \"\" || target == fold.state {\n524|\t\treturn nil\n525|\t}\n526|\tif fold.state == \"\" {\n527|\t\tif _, ok := initialTargets[target]; !ok {\n528|\t\t\treturn refuse(ErrInvalidTransition, \"%s opens unbootstrapped state %q\", what, string(target))\n529|\t\t}\n530|\t\tfold.state = target\n531|\t\treturn nil\n532|\t}\n533|\tif _, ok := allowedTransitions[fold.state][target]; !ok {\n534|\t\treturn refuse(ErrInvalidTransition, \"%s moves %q to %q without a Section 5.7 edge\", what, string(fold.state), string(target))\n535|\t}\n536|\tfold.state = target\n537|\treturn nil\n538|}\n539|\n540|// effect applies one event's lifecycle meaning after continuity and\n541|// lease tracking. Fact events return an empty target and keep the\n542|// state; unknown v1 types and the v2/v3/v4 non-lifecycle types are\n543|// inert by Section 5.2 (retained, never applied).\n544|func (fold *chainFold) effect(event Event, lease LeaseHead, succession bool) error {\n545|\tname := \"event \" + event.Type + \" \" + event.ID\n546|\tswitch event.Type {\n547|\tcase \"session.created\":\n548|\t\treturn fold.effectCreated(event, name)\n549|\tcase \"terminal.created\":\n550|\t\treturn fold.effectTerminalCreated(event, name)\n551|\tcase \"provider.launched\":\n552|\t\treturn fold.effectProviderLaunched(event, name)\n553|\tcase \"provider.identified\":\n554|\t\treturn fold.effectProviderIdentified(event, name)\n555|\tcase \"session.idle\":\n556|\t\treturn fold.step(StateIdle, name)\n557|\tcase \"session.quiescing\":\n558|\t\treturn fold.step(StateQuiescing, name)\n559|\tcase \"checkpoint.created\":\n560|\t\treturn fold.effectCheckpointCreated(event, name)\n561|\tcase \"sync.completed\":\n562|\t\treturn nil\n563|\tcase \"session.stopped\":\n564|\t\treturn fold.effectStopped(event, name)\n565|\tcase \"session.resumed\":\n566|\t\treturn fold.effectResumed(event, name)\n567|\tcase \"session.bootstrap_aborted\":\n568|\t\treturn fold.effectBootstrapAborted(event, name)\n569|\tcase \"lease.transferred\", \"lease.forced\":\n570|\t\treturn fold.effectLease(event, lease, name, succession)\n571|\tcase \"session.parked\":\n572|\t\treturn fold.step(StateParked, name)\n573|\tcase \"session.failed\":\n574|\t\treturn fold.step(StateFailed, name)\n575|\tcase \"fork.created\", \"profile.changed\", \"takeover.force_confirmed\",\n576|\t\t\"replica.replace_confirmed\", \"task_board.adopted\",\n577|\t\t\"tombstone.issued\", \"tombstone.resolved\":\n578|\t\treturn nil\n579|\tcase \"session.tombstoned\":\n580|\t\treturn fold.step(StateTombstoned, name)\n581|\tcase \"task_board.launched\":\n582|\t\treturn fold.effectTaskBoardLaunched(event, name)\n583|\tdefault:\n584|\t\treturn nil\n585|\t}\n586|}\n587|\n588|// effectCreated opens the bootstrap, including the Section 5.7\n589|// failed-to-creating retry: epoch 1 under the same winning create\n590|// lease, no validated checkpoint yet, and no authoritative bootstrap\n591|// abort on record. Anything else that reaches for creating refuses.\n592|func (fold *chainFold) effectCreated(event Event, what string) error {\n593|\tif fold.state == \"\" {\n594|\t\treturn fold.step(StateCreating, what)\n595|\t}\n596|\tif fold.state != StateFailed {\n597|\t\treturn fold.step(StateCreating, what)\n598|\t}\n599|\tif event.LeaseEpoch != 1 || event.LeaseID != fold.createLease.LeaseID ||\n600|\t\tevent.LeaseEpoch != fold.createLease.Epoch {\n601|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap under a new lease\", what)\n602|\t}\n603|\tif fold.seenCheckpoint {\n604|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap past a validated checkpoint\", what)\n605|\t}\n606|\tif fold.seenAbort {\n607|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap past an authoritative abort\", what)\n608|\t}\n609|\treturn fold.step(StateCreating, what)\n610|}\n611|\n612|// effectTerminalCreated records the terminal binding; as the first\n613|// event it also opens the bootstrap in creating.\n614|func (fold *chainFold) effectTerminalCreated(event Event, what string) error {\n615|\tif event.SchemaVersion == \"4.0.0\" {\n616|\t\tbinding, err := payloadString(event.Payload, \"terminal_binding_id\")\n617|\t\tif err != nil {\n618|\t\t\treturn err\n619|\t\t}\n620|\t\tif _, err := scalar.ParseDigest(binding); err != nil {\n621|\t\t\treturn refuse(ErrDerivation, \"%s carries malformed terminal_binding_id: %v\", what, err)\n622|\t\t}\n623|\t\tbackend, err := payloadString(event.Payload, \"terminal_backend_id\")\n624|\t\tif err != nil {\n625|\t\t\treturn err\n626|\t\t}\n627|\t\tif _, err := terminalbackend.ParseID(backend); err != nil {\n628|\t\t\treturn refuse(ErrDerivation, \"%s carries refused terminal backend: %v\", what, err)\n629|\t\t}\n630|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, BindingID: binding, EventID: event.ID}\n631|\t} else {\n632|\t\tbackend, err := payloadString(event.Payload, \"backend\")\n633|\t\tif err != nil {\n634|\t\t\treturn err\n635|\t\t}\n636|\t\tif backend != \"tmux\" && backend != \"conpty\" {\n637|\t\t\treturn refuse(ErrDerivation, \"%s carries unknown terminal backend %q\", what, backend)\n638|\t\t}\n639|\t\tterminalID, err := payloadString(event.Payload, \"terminal_id\")\n640|\t\tif err != nil {\n641|\t\t\treturn err\n642|\t\t}\n643|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, TerminalID: terminalID, EventID: event.ID}\n644|\t}\n645|\tfold.projection.HasTerminal = true\n646|\tif fold.state == \"\" {\n647|\t\treturn fold.step(StateCreating, what)\n648|\t}\n649|\treturn nil\n650|}\n651|\n652|// effectProviderLaunched moves to running and records the launched\n653|// version. The record provider stays authoritative: a launched event\n654|// naming another provider records a provider_mismatch conflict under\n655|// the record-pinned-provider-wins rule instead of rewriting identity.\n656|func (fold *chainFold) effectProviderLaunched(event Event, what string) error {\n657|\tproviderID, err := payloadString(event.Payload, \"provider_id\")\n658|\tif err != nil {\n659|\t\treturn err\n660|\t}\n661|\tversion, err := payloadString(event.Payload, \"provider_version\")\n662|\tif err != nil {\n663|\t\treturn err\n664|\t}\n665|\tif providerID != fold.recordProvider {\n666|\t\tfold.conflict(ConflictProviderMismatch, ResolveRuleRecordPinnedProviderWins,\n667|\t\t\t\"event %s launches provider %q under record provider %q; the record value stays authoritative\",\n668|\t\t\tevent.ID, providerID, fold.recordProvider)\n669|\t} else {\n670|\t\tfold.projection.Provider.Version = version\n671|\t}\n672|\treturn fold.step(StateRunning, what)\n673|}\n674|\n675|// effectProviderIdentified records the newest identity record with\n676|// its confidence.\n677|func (fold *chainFold) effectProviderIdentified(event Event, what string) error {\n678|\trecordID, err := payloadString(event.Payload, \"provider_identity_record_id\")\n679|\tif err != nil {\n680|\t\treturn err\n681|\t}\n682|\tif _, err := scalar.ParseDigest(recordID); err != nil {\n683|\t\treturn refuse(ErrDerivation, \"%s carries malformed provider_identity_record_id: %v\", what, err)\n684|\t}\n685|\tconfidence, err := payloadString(event.Payload, \"confidence\")\n686|\tif err != nil {\n687|\t\treturn err\n688|\t}\n689|\tfold.projection.Provider.IdentityRecordID = recordID\n690|\tfold.projection.Provider.Confidence = confidence\n691|\treturn nil\n692|}\n693|\n694|// effectCheckpointCreated records the newest validated checkpoint and\n695|// moves idle or quiescing into checkpointing, or checkpointing back to\n696|// idle at the validated boundary. Any other lifecycle position refuses:\n697|// a checkpoint cannot land while running, creating, stopped, parked,\n698|// failed, stale, materializing, or tombstoned without the quiesce or\n699|// resume the table requires.\n700|func (fold *chainFold) effectCheckpointCreated(event Event, what string) error {\n701|\tcheckpointID, err := payloadString(event.Payload, \"checkpoint_id\")\n702|\tif err != nil {\n703|\t\treturn err\n704|\t}\n705|\tif _, err := scalar.ParseDigest(checkpointID); err != nil {\n706|\t\treturn refuse(ErrDerivation, \"%s carries malformed checkpoint_id: %v\", what, err)\n707|\t}\n708|\tkind, err := payloadString(event.Payload, \"kind\")\n709|\tif err != nil {\n710|\t\treturn err\n711|\t}\n712|\tfold.noteCheckpoint(checkpointID, kind, event.ID)\n713|\tswitch fold.state {\n714|\tcase \"\", StateIdle, StateQuiescing:\n715|\t\tif fold.state == \"\" {\n716|\t\t\treturn refuse(ErrInvalidTransition, \"%s publishes a checkpoint before any bootstrap\", what)\n717|\t\t}\n718|\t\treturn fold.step(StateCheckpointing, what)\n719|\tcase StateCheckpointing:\n720|\t\treturn fold.step(StateIdle, what)\n721|\tdefault:\n722|\t\treturn fold.step(StateCheckpointing, what)\n723|\t}\n724|}\n725|\n726|// effectStopped derives stopped for a checkpointed closure and failed\n727|// for a bootstrap abort. No event may derive stopped while the newest\n728|// checkpoint is null: the event's own checkpoint counts, so a\n729|// checkpointed stop carries its resumable base with it. A bootstrap\n730|// abort requires the null checkpoint, false resumable and graceful\n731|// values the canonical owner admitted, plus a preceding authoritative\n732|// abort event; an ambiguous live process stays failed with recovery\n733|// diagnostics instead.\n734|func (fold *chainFold) effectStopped(event Event, what string) error {\n735|\tcheckpointID, hasCheckpoint, err := payloadNullableDigest(event.Payload, \"checkpoint_id\")\n736|\tif err != nil {\n737|\t\treturn err\n738|\t}\n739|\tresumable, err := payloadBool(event.Payload, \"resumable\")\n740|\tif err != nil {\n741|\t\treturn err\n742|\t}\n743|\tclosure, err := payloadString(event.Payload, \"closure_kind\")\n744|\tif err != nil {\n745|\t\treturn err\n746|\t}\n747|\tif closure == \"checkpointed\" {\n748|\t\tif !hasCheckpoint || !resumable {\n749|\t\t\treturn refuse(ErrIntegrity, \"%s closes checkpointed without a resumable checkpoint\", what)\n750|\t\t}\n751|\t\tfold.noteCheckpoint(checkpointID, \"\", event.ID)\n752|\t\treturn fold.step(StateStopped, what)\n753|\t}\n754|\tif hasCheckpoint || resumable {\n755|\t\treturn refuse(ErrIntegrity, \"%s closes bootstrap_abort with a checkpoint or resumable set\", what)\n756|\t}\n757|\tif !fold.seenAbort {\n758|\t\treturn refuse(ErrInvalidTransition, \"%s closes bootstrap_abort with no authoritative abort event\", what)\n759|\t}\n760|\treturn fold.step(StateFailed, what)\n761|}\n762|\n763|// effectResumed moves to running under the resumed checkpoint and\n764|// records the terminal binding the resume selected.\n765|func (fold *chainFold) effectResumed(event Event, what string) error {\n766|\tcheckpointID, err := payloadString(event.Payload, \"checkpoint_id\")\n767|\tif err != nil {\n768|\t\treturn err\n769|\t}\n770|\tif _, err := scalar.ParseDigest(checkpointID); err != nil {\n771|\t\treturn refuse(ErrDerivation, \"%s carries malformed checkpoint_id: %v\", what, err)\n772|\t}\n773|\tfold.noteCheckpoint(checkpointID, \"\", event.ID)\n774|\tif event.SchemaVersion == \"4.0.0\" {\n775|\t\tbinding, err := payloadString(event.Payload, \"terminal_binding_id\")\n776|\t\tif err != nil {\n777|\t\t\treturn err\n778|\t\t}\n779|\t\tif _, err := scalar.ParseDigest(binding); err != nil {\n780|\t\t\treturn refuse(ErrDerivation, \"%s carries malformed terminal_binding_id: %v\", what, err)\n781|\t\t}\n782|\t\tbackend, err := payloadString(event.Payload, \"terminal_backend_id\")\n783|\t\tif err != nil {\n784|\t\t\treturn err\n785|\t\t}\n786|\t\tif _, err := terminalbackend.ParseID(backend); err != nil {\n787|\t\t\treturn refuse(ErrDerivation, \"%s carries refused terminal backend: %v\", what, err)\n788|\t\t}\n789|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, BindingID: binding, EventID: event.ID}\n790|\t} else {\n791|\t\tbackend, err := payloadString(event.Payload, \"terminal_backend\")\n792|\t\tif err != nil {\n793|\t\t\treturn err\n794|\t\t}\n795|\t\tif backend != \"tmux\" && backend != \"conpty\" {\n796|\t\t\treturn refuse(ErrDerivation, \"%s carries unknown terminal backend %q\", what, backend)\n797|\t\t}\n798|\t\tnativeID, err := payloadString(event.Payload, \"native_session_id\")\n799|\t\tif err != nil {\n800|\t\t\treturn err\n801|\t\t}\n802|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, NativeSessionID: nativeID, EventID: event.ID}\n803|\t}\n804|\tfold.projection.HasTerminal = true\n805|\treturn fold.step(StateRunning, what)\n806|}\n807|\n808|// effectBootstrapAborted records the authoritative abort and fails the\n809|// bootstrap. Only the creating session can abort its bootstrap; any\n810|// later abort is invalid_state_transition.\n811|func (fold *chainFold) effectBootstrapAborted(event Event, what string) error {\n812|\tfold.seenAbort = true\n813|\tif fold.state != \"\" && fold.state != StateCreating {\n814|\t\treturn refuse(ErrInvalidTransition, \"%s aborts a bootstrap past creating\", what)\n815|\t}\n816|\treturn fold.step(StateFailed, what)\n817|}\n818|\n819|// effectLease checks the successor-lease payload linkage: the payload\n820|// must name the predecessor the chain stands on and the envelope it\n821|// arrives under, else integrity_failure. The lifecycle move already\n822|// happened in successionMove; a lease event repeating the current\n823|// lease is a fact, not a transition.\n824|func (fold *chainFold) effectLease(event Event, lease LeaseHead, what string, succession bool) error {\n825|\tif !succession {\n826|\t\treturn nil\n827|\t}\n828|\tif event.Type == \"lease.transferred\" {\n829|\t\tpredecessor, err := payloadString(event.Payload, \"predecessor_lease_id\")\n830|\t\tif err != nil {\n831|\t\t\treturn err\n832|\t\t}\n833|\t\tif predecessor != fold.previous.LeaseID {\n834|\t\t\treturn refuse(ErrIntegrity, \"%s transfers from lease %s past chain head lease %s\", what, predecessor, fold.previous.LeaseID)\n835|\t\t}\n836|\t\tsuccessor, err := payloadString(event.Payload, \"new_lease_id\")\n837|\t\tif err != nil {\n838|\t\t\treturn err\n839|\t\t}\n840|\t\tif successor != lease.LeaseID {\n841|\t\t\treturn refuse(ErrIntegrity, \"%s transfers to lease %s outside its envelope lease %s\", what, successor, lease.LeaseID)\n842|\t\t}\n843|\t} else {\n844|\t\tsuccessor, err := payloadString(event.Payload, \"new_lease_id\")\n845|\t\tif err != nil {\n846|\t\t\treturn err\n847|\t\t}\n848|\t\tif successor != lease.LeaseID {\n849|\t\t\treturn refuse(ErrIntegrity, \"%s forces lease %s outside its envelope lease %s\", what, successor, lease.LeaseID)\n850|\t\t}\n851|\t}\n852|\treturn nil\n853|}\n854|\n855|// effectTaskBoardLaunched enforces the Section 5.2 repeat rule — the\n856|// event must repeat the winning creation lease and the Session\n857|// Record's provider and launch mode — then derives the payload's\n858|// running or idle state through the table.\n859|func (fold *chainFold) effectTaskBoardLaunched(event Event, what string) error {\n860|\tproviderID, err := payloadString(event.Payload, \"provider_id\")\n861|\tif err != nil {\n862|\t\treturn err\n863|\t}\n864|\tif providerID != fold.recordProvider {\n865|\t\treturn refuse(ErrIntegrity, \"%s repeats provider %q past record provider %q\", what, providerID, fold.recordProvider)\n866|\t}\n867|\tpayloadEpoch, err := payloadUint(event.Payload, \"lease_epoch\")\n868|\tif err != nil {\n869|\t\treturn err\n870|\t}\n871|\tpayloadLease, err := payloadString(event.Payload, \"lease_id\")\n872|\tif err != nil {\n873|\t\treturn err\n874|\t}\n875|\tif payloadEpoch != fold.createLease.Epoch || payloadLease != fold.createLease.LeaseID {\n876|\t\treturn refuse(ErrIntegrity, \"%s repeats creation lease (%d, %s) past create lease (%d, %s)\", what, payloadEpoch, payloadLease, fold.createLease.Epoch, fold.createLease.LeaseID)\n877|\t}\n878|\treported, err := payloadString(event.Payload, \"state\")\n879|\tif err != nil {\n880|\t\treturn err\n881|\t}\n882|\tif reported == string(StateRunning) {\n883|\t\treturn fold.step(StateRunning, what)\n884|\t}\n885|\treturn fold.step(StateIdle, what)\n886|}\n887|\n888|// noteCheckpoint records the newest validated checkpoint.\n889|func (fold *chainFold) noteCheckpoint(id, kind, eventID string) {\n890|\tfold.seenCheckpoint = true\n891|\tfold.projection.HasCheckpoint = true\n892|\tfold.projection.Newest = Checkpoint{ID: id, Kind: kind, EventID: eventID}\n893|}\n894|\n895|// resolveWinner selects the winning lease over the authoritative chain\n896|// leases and the union leases by the greatest (epoch, lease_id)\n897|// tuple. A same-epoch tie resolves to the bytewise-greater lease ID;\n898|// an off-chain union winner moves the reported winner but never\n899|// rewrites authoritative state; union leases that lose are reported\n900|// preserved-never-applied. With no union the chain head wins alone\n901|// and no conflict is recorded.\n902|func (fold *chainFold) resolveWinner(union []LeaseHead) error {\n903|\twinner := fold.current\n904|\tonChain := map[string]struct{}{}\n905|\tif fold.haveLease {\n906|\t\tonChain[fold.current.LeaseID] = struct{}{}\n907|\t}\n908|\tfor _, lease := range fold.chainLeases() {\n909|\t\tonChain[lease.LeaseID] = struct{}{}\n910|\t}\n911|\tbyEpoch := map[uint64]map[string]struct{}{}\n912|\tnote := func(lease LeaseHead) {\n913|\t\tif byEpoch[lease.Epoch] == nil {\n914|\t\t\tbyEpoch[lease.Epoch] = map[string]struct{}{}\n915|\t\t}\n916|\t\tbyEpoch[lease.Epoch][lease.LeaseID] = struct{}{}\n917|\t}\n918|\tfor _, lease := range fold.chainLeases() {\n919|\t\tnote(lease)\n920|\t}\n921|\toffChainWinner := false\n922|\tfor _, lease := range union {\n923|\t\tif lease.IsZero() {\n924|\t\t\treturn refuse(ErrInvalidEvent, \"union carries an empty lease head\")\n925|\t\t}\n926|\t\tif _, err := scalar.ParseUUIDv4(lease.LeaseID); err != nil {\n927|\t\t\treturn refuse(ErrInvalidEvent, \"union lease %q is not a UUIDv4: %v\", lease.LeaseID, err)\n928|\t\t}\n929|\t\tnote(lease)\n930|\t\tswitch Compare(lease, winner) {\n931|\t\tcase 1:\n932|\t\t\twinner = lease\n933|\t\t\tif _, ok := onChain[lease.LeaseID]; !ok {\n934|\t\t\t\toffChainWinner = true\n935|\t\t\t}\n936|\t\tcase -1:\n937|\t\t\tfold.conflict(ConflictLosingBranchPreserved, ResolveRulePreservedNeverApplied,\n938|\t\t\t\t\"union lease (%d, %s) loses to (%d, %s); its history stays preserved and never applies\",\n939|\t\t\t\tlease.Epoch, lease.LeaseID, winner.Epoch, winner.LeaseID)\n940|\t\tcase 0:\n941|\t\t\t// A duplicate union entry names the tuple already\n942|\t\t\t// selected: the winner and the off-chain flag stand.\n943|\t\t\t// Clearing here would drop a correctly recorded\n944|\t\t\t// union_supersedes_chain conflict (and its\n945|\t\t\t// divergent_history warning) on a repeated entry.\n946|\t\t}\n947|\t}\n948|\tepochs := make([]uint64, 0, len(byEpoch))\n949|\tfor epoch := range byEpoch {\n950|\t\tepochs = append(epochs, epoch)\n951|\t}\n952|\tsort.Slice(epochs, func(i, j int) bool { return epochs[i] < epochs[j] })\n953|\tfor _, epoch := range epochs {\n954|\t\trivals := byEpoch[epoch]\n955|\t\tif len(rivals) < 2 {\n956|\t\t\tcontinue\n957|\t\t}\n958|\t\tordered := make([]string, 0, len(rivals))\n959|\t\tfor id := range rivals {\n960|\t\t\tordered = append(ordered, id)\n961|\t\t}\n962|\t\tsort.Strings(ordered)\n963|\t\tfold.conflict(ConflictSameEpochTie, ResolveRuleGreatestLeaseIDWins,\n964|\t\t\t\"epoch %d is shared by leases %v; the bytewise-greater lease ID %s wins\",\n965|\t\t\tepoch, ordered, ordered[len(ordered)-1])\n966|\t}\n967|\tif offChainWinner {\n968|\t\tfold.conflict(ConflictUnionSupersedesChain, ResolveRuleAuthoritativeStateUnchanged,\n969|\t\t\t\"union winner (%d, %s) stands outside the authoritative chain; derived state is unchanged until an explicit takeover lands\",\n970|\t\t\twinner.Epoch, winner.LeaseID)\n971|\t}\n972|\tfold.projection.Winner = winner\n973|\treturn nil\n974|}\n975|\n976|// chainLeases replays the distinct envelope leases in first-appearance\n977|// order. Every succession appends, so a tie planted at any past epoch\n978|// still resolves against the lease the chain actually stood on. Gaps\n979|// were already recorded at succession time.\n980|func (fold *chainFold) chainLeases() []LeaseHead {\n981|\treturn append([]LeaseHead(nil), fold.leases...)\n982|}\n983|\n984|// applyLocalLease derives the local projection: the owner host of the\n985|// newest authoritative event decides the local role against the\n986|// caller-supplied host, and a local lease that lost the tuple rule\n987|// stales the projection exactly where the table lets it go stale.\n988|func (fold *chainFold) applyLocalLease(local LeaseHead, localHostID string) {\n989|\tif localHostID != \"\" && fold.projection.OwnerHostID != \"\" {\n990|\t\tif localHostID == fold.projection.OwnerHostID {\n991|\t\t\tfold.projection.LocalRole = \"owner\"\n992|\t\t} else {\n993|\t\t\tfold.projection.LocalRole = \"replica\"\n994|\t\t}\n995|\t}\n996|\tif local.IsZero() || !fold.haveLease {\n997|\t\treturn\n998|\t}\n999|\t// Only a lease that lost the tuple rule stales the projection:\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4ff","stream":{"kind":"session","id":"01a0ae2e-304f-7791-b344-a738da145935"},"sequence":218,"recorded_at":1780531400000431,"record_type":"event","durability":"durable","causation_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","run_stream":{"kind":"run","id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3"},"call_id":"call_01a0ae2e9f577212b13c957f5de46bad","text":"Read text file `internal/sessrepo/lease_store.go`.\n(499 line(s) above)\n500|// scanLeaseBlobs collects and orders the verified lease summaries. Every\n501|// failure is a plain error; loadLeasesLocked attributes it through its one\n502|// refusal site.\n503|func scanLeaseBlobs(directory, sessionID string) ([]LeaseSummary, error) {\n504|\tentries, err := os.ReadDir(filepath.Join(directory, \"leases\"))\n505|\tif err != nil {\n506|\t\tif os.IsNotExist(err) {\n507|\t\t\treturn nil, nil\n508|\t\t}\n509|\t\treturn nil, fmt.Errorf(\"read leases namespace: %w\", err)\n510|\t}\n511|\tvar stored []LeaseSummary\n512|\tfor _, entry := range entries {\n513|\t\tname := entry.Name()\n514|\t\tif strings.HasPrefix(name, \".\") {\n515|\t\t\tcontinue\n516|\t\t}\n517|\t\texpected, err := leaseDigestForName(name)\n518|\t\tif err != nil {\n519|\t\t\treturn nil, err\n520|\t\t}\n521|\t\tblob, err := os.ReadFile(filepath.Join(directory, \"leases\", name))\n522|\t\tif err != nil {\n523|\t\t\treturn nil, fmt.Errorf(\"read lease %s: %w\", name, err)\n524|\t\t}\n525|\t\tsummary, err := decodeStoredLease(sessionID, blob)\n526|\t\tif err != nil {\n527|\t\t\treturn nil, fmt.Errorf(\"lease %s: %v\", name, err)\n528|\t\t}\n529|\t\tif summary.RecordID != expected {\n530|\t\t\treturn nil, fmt.Errorf(\"lease %s attests %s\", name, summary.RecordID)\n531|\t\t}\n532|\t\tstored = append(stored, summary)\n533|\t}\n534|\tsort.Slice(stored, func(i, j int) bool { return CompareLeaseTuple(stored[i], stored[j]) < 0 })\n535|\treturn stored, nil\n536|}\n537|\n538|// verifyLeaseBlob decodes one blob and binds it to its expected session\n539|// and digest name. Failures are plain errors; the caller attributes them\n540|// through its own refusal site.\n541|func verifyLeaseBlob(sessionID, expected string, blob []byte) error {\n542|\tsummary, err := decodeStoredLease(sessionID, blob)\n543|\tif err != nil {\n544|\t\treturn err\n545|\t}\n546|\tif summary.RecordID != expected {\n547|\t\treturn fmt.Errorf(\"blob attests %s, want %s\", summary.RecordID, expected)\n548|\t}\n549|\treturn nil\n550|}\n551|\n552|// leaseDigestForName renders a leases-namespace file name back to the\n553|// digest it must hold. Anything outside hex.json is torn store, never a\n554|// skipped entry: only staged temps are ignorable.\n555|func leaseDigestForName(name string) (string, error) {\n556|\ttrimmed := strings.TrimSuffix(name, \".json\")\n557|\tdigest, err := scalar.ParseDigest(\"sha256:\" + trimmed)\n558|\tif err != nil {\n559|\t\treturn \"\", fmt.Errorf(\"lease file %q is not a digest path: %v\", name, err)\n560|\t}\n561|\treturn digest.String(), nil\n562|}\n563|\n564|// installLeaseBlobLocked installs one minted lease blob atomically: staged\n565|// bytes fsync before the rename, the directory fsyncs after. A second\n566|// install of identical bytes is reused; disagreeing bytes at a digest path\n567|// are torn store. AfterLeaseStage fires after the staged fsync and before\n568|// the rename — the kill seam the crash tests drive — and is nil in normal\n569|// operation. Callers hold the repository mutex.\n570|func (repository *Repository) installLeaseBlobLocked(directory, recordID string, data []byte) error {\n571|\tleases := filepath.Join(directory, \"leases\")\n572|\tif err := os.MkdirAll(leases, 0o700); err != nil {\n573|\t\treturn fmt.Errorf(\"create leases namespace: %w\", err)\n574|\t}\n575|\tpath := filepath.Join(leases, blobFileName(recordID))\n576|\tif existing, err := os.ReadFile(path); err == nil {\n577|\t\tif leaseBytesEqual(existing, data) {\n578|\t\t\treturn nil\n579|\t\t}\n580|\t\treturn refuse(ErrChainCorrupt, \"digest path holds disagreeing bytes for lease\")\n581|\t} else if !os.IsNotExist(err) {\n582|\t\treturn fmt.Errorf(\"read installed lease blob: %w\", err)\n583|\t}\n584|\tstaged, err := os.CreateTemp(leases, leaseStagePrefix)\n585|\tif err != nil {\n586|\t\treturn fmt.Errorf(\"stage lease blob: %w\", err)\n587|\t}\n588|\tstagedPath := staged.Name()\n589|\tfinished := false\n590|\tdefer func() {\n591|\t\tif !finished {\n592|\t\t\t_ = staged.Close()\n593|\t\t\t_ = os.Remove(stagedPath)\n594|\t\t}\n595|\t}()\n596|\tif err := staged.Chmod(0o600); err != nil {\n597|\t\treturn fmt.Errorf(\"mode staged lease blob: %w\", err)\n598|\t}\n599|\tif _, err := staged.Write(data); err != nil {\n600|\t\treturn fmt.Errorf(\"write staged lease blob: %w\", err)\n601|\t}\n602|\tif err := staged.Sync(); err != nil {\n603|\t\treturn fmt.Errorf(\"fsync staged lease blob: %w\", err)\n604|\t}\n605|\tif err := staged.Close(); err != nil {\n606|\t\treturn fmt.Errorf(\"close staged lease blob: %w\", err)\n607|\t}\n608|\tif repository.AfterLeaseStage != nil {\n609|\t\tif err := repository.AfterLeaseStage(); err != nil {\n610|\t\t\treturn err\n611|\t\t}\n612|\t}\n613|\tfinished = true\n614|\tif err := os.Rename(stagedPath, path); err != nil {\n615|\t\treturn fmt.Errorf(\"install lease blob: %w\", err)\n616|\t}\n617|\treturn syncDirectory(leases)\n618|}\n619|\n620|// findExpectedLease resolves a CAS expectation to the stored lease it names.\n621|// An empty or unknown digest resolves nothing: only a persisted record_id\n622|// can be a compare basis.\n623|func findExpectedLease(stored []LeaseSummary, recordID string) (LeaseSummary, bool) {\n624|\tfor _, known := range stored {\n625|\t\tif known.RecordID == recordID {\n626|\t\t\treturn known, true\n627|\t\t}\n628|\t}\n629|\treturn LeaseSummary{}, false\n630|}\n631|\n632|// findIdenticalLease reports the stored lease whose digest equals the minted\n633|// candidate's, so a byte-identical retry returns its reference instead of\n634|// minting a duplicate. The digest is the canonical content identity, so\n635|// digest equality is full-content equality under the same collision\n636|// resistance the content-addressed layout already assumes; the load path\n637|// re-verified every stored blob before this comparison runs.\n638|func findIdenticalLease(stored []LeaseSummary, digest string) (bool, LeaseRef) {\n639|\tfor _, known := range stored {\n640|\t\tif known.RecordID == digest {\n641|\t\t\treturn true, LeaseRef{SessionID: known.SessionID, RecordID: known.RecordID, LeaseID: known.LeaseID, Epoch: known.Epoch, HolderHostID: known.HolderHostID}\n642|\t\t}\n643|\t}\n644|\treturn false, LeaseRef{}\n645|}\n646|\n647|// leaseBytesEqual is the one content-equality site of the lease store,\n648|// registered in the census ledger with its same-length vector.\n649|func leaseBytesEqual(left, right []byte) bool {\n650|\treturn bytes.Equal(left, right)\n651|}\n652|\n653|// mintLeaseRecord builds one canonical Lease Record and returns its bytes\n654|// with the attested record_id. Identity is computed by the canonicaljson\n655|// owner over the placeholder, then confirmed by Verify after the digest is\n656|// bound, so minted bytes always attest. Failures are plain operational\n657|// errors, never refusals: entry validation already admitted the inputs,\n658|// so a mint failure is an internal inconsistency, not a rejected input.\n659|func mintLeaseRecord(sessionID string, epoch uint64, leaseID, holder, issuer, predecessor string, hasPredecessor bool, reason, checkpoint string, hasCheckpoint bool, createdAt string) ([]byte, string, error) {\n660|\tvar predecessorValue any\n661|\tif hasPredecessor {\n662|\t\tpredecessorValue = predecessor\n663|\t}\n664|\tvar checkpointValue any\n665|\tif hasCheckpoint {\n666|\t\tcheckpointValue = checkpoint\n667|\t}\n668|\tobject := map[string]any{\n669|\t\t\"schema\":               leaseRecordSchema,\n670|\t\t\"schema_version\":       \"1.0.0\",\n671|\t\t\"record_id\":            leaseIdentityPlaceholder,\n672|\t\t\"subject_id\":           sessionID,\n673|\t\t\"session_id\":           sessionID,\n674|\t\t\"lease_id\":             leaseID,\n675|\t\t\"epoch\":                epoch,\n676|\t\t\"holder_host_id\":       holder,\n677|\t\t\"predecessor_lease_id\": predecessorValue,\n678|\t\t\"reason\":               reason,\n679|\t\t\"checkpoint_id\":        checkpointValue,\n680|\t\t\"issued_by_host_id\":    issuer,\n681|\t\t\"created_by_host_id\":   issuer,\n682|\t\t\"created_at\":           createdAt,\n683|\t\t\"extensions\":           map[string]any{},\n684|\t}\n685|\tstaged, err := json.Marshal(object)\n686|\tif err != nil {\n687|\t\treturn nil, \"\", fmt.Errorf(\"encode lease record: %w\", err)\n688|\t}\n689|\tdigest, _, err := canonicaljson.CalculateObjectIdentity(staged)\n690|\tif err != nil {\n691|\t\treturn nil, \"\", fmt.Errorf(\"identify lease record: %w\", err)\n692|\t}\n693|\tobject[\"record_id\"] = digest.String()\n694|\traw, err := json.Marshal(object)\n695|\tif err != nil {\n696|\t\treturn nil, \"\", fmt.Errorf(\"encode identified lease record: %w\", err)\n697|\t}\n698|\tif _, _, err := AttestLeaseRecord(raw); err != nil {\n699|\t\treturn nil, \"\", fmt.Errorf(\"attest minted lease record: %w\", err)\n700|\t}\n701|\treturn raw, digest.String(), nil\n702|}\n703|\n704|// decodeStoredLease validates one stored Lease Record through the\n705|// canonicaljson owner and extracts the bound members. Closed-shape,\n706|// coupling, and identity failures are plain errors for the caller to\n707|// attribute; member extraction re-checks grammar through the environ and\n708|// scalar owners, matching the query-layer admission without forking it.\n709|func decodeStoredLease(sessionID string, raw []byte) (LeaseSummary, error) {\n710|\tvar summary LeaseSummary\n711|\tmembers, fault := environ.DecodeStrictObject(raw)\n712|\tif fault != nil {\n713|\t\treturn summary, fmt.Errorf(\"decode lease record frame: %v\", fault)\n714|\t}\n715|\tschema, err := stringMember(members, \"schema\")\n716|\tif err != nil || schema != leaseRecordSchema {\n717|\t\treturn summary, fmt.Errorf(\"lease record schema %q, want %q\", schema, leaseRecordSchema)\n718|\t}\n719|\tdigest, field, err := AttestLeaseRecord(raw)\n720|\tif err != nil {\n721|\t\treturn summary, fmt.Errorf(\"verify lease record identity: %v\", err)\n722|\t}\n723|\tif field != canonicaljson.SelfRecordID {\n724|\t\treturn summary, fmt.Errorf(\"lease record identity field %q, want record_id\", string(field))\n725|\t}\n726|\trecordSession, ok := environ.CheckUUIDv7(members[\"session_id\"])\n727|\tif !ok {\n728|\t\treturn summary, fmt.Errorf(\"lease record carries no valid session_id member\")\n729|\t}\n730|\tif recordSession.String() != sessionID {\n731|\t\treturn summary, fmt.Errorf(\"lease record session %s does not match stored session %s\", recordSession.String(), sessionID)\n732|\t}\n733|\tleaseID, err := stringMember(members, \"lease_id\")\n734|\tif err != nil {\n735|\t\treturn summary, fmt.Errorf(\"lease record carries no lease_id member: %v\", err)\n736|\t}\n737|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n738|\t\treturn summary, fmt.Errorf(\"lease record lease_id: %v\", err)\n739|\t}\n740|\tepoch, ok := environ.CheckUint53Bounds(members[\"epoch\"], 1, uint53Max)\n741|\tif !ok {\n742|\t\treturn summary, fmt.Errorf(\"lease record carries no epoch at or above 1\")\n743|\t}\n744|\tholder, ok := environ.CheckUUIDv7(members[\"holder_host_id\"])\n745|\tif !ok {\n746|\t\treturn summary, fmt.Errorf(\"lease record carries no valid holder_host_id member\")\n747|\t}\n748|\tpredecessor, hasPredecessor, err := nullableUUIDv4Member(members, \"predecessor_lease_id\")\n749|\tif err != nil {\n750|\t\treturn summary, fmt.Errorf(\"lease record predecessor_lease_id: %v\", err)\n751|\t}\n752|\tcheckpoint, hasCheckpoint, err := nullableDigestMember(members, \"checkpoint_id\")\n753|\tif err != nil {\n754|\t\treturn summary, fmt.Errorf(\"lease record checkpoint_id: %v\", err)\n755|\t}\n756|\treason, err := stringMember(members, \"reason\")\n757|\tif err != nil {\n758|\t\treturn summary, fmt.Errorf(\"lease record carries no reason member: %v\", err)\n759|\t}\n760|\tsummary = LeaseSummary{RecordID: digest.String(), SessionID: recordSession.String(), LeaseID: leaseID, Epoch: epoch, HolderHostID: holder.String(), Predecessor: predecessor, HasPredecessor: hasPredecessor, Checkpoint: checkpoint, HasCheckpoint: hasCheckpoint, Reason: reason}\n761|\treturn summary, nil\n762|}\n763|\n764|// nullableUUIDv4Member reads a member that is null or a UUIDv4 string. A\n765|// nil pointer binds JSON null without any text comparison.\n766|func nullableUUIDv4Member(members map[string]json.RawMessage, name string) (string, bool, error) {\n767|\traw, ok := members[name]\n768|\tif !ok {\n769|\t\treturn \"\", false, fmt.Errorf(\"member %q is absent\", name)\n770|\t}\n771|\tvar value *string\n772|\tif err := json.Unmarshal(raw, &value); err != nil {\n773|\t\treturn \"\", false, fmt.Errorf(\"member %q is neither a UUID nor null\", name)\n774|\t}\n775|\tif value == nil {\n776|\t\treturn \"\", false, nil\n777|\t}\n778|\tif _, err := scalar.ParseUUIDv4(*value); err != nil {\n779|\t\treturn \"\", false, err\n780|\t}\n781|\treturn *value, true, nil\n782|}\n783|\n784|// nullableDigestMember reads a member that is null or a digest string. A\n785|// nil pointer binds JSON null without any text comparison.\n786|func nullableDigestMember(members map[string]json.RawMessage, name string) (string, bool, error) {\n787|\traw, ok := members[name]\n788|\tif !ok {\n789|\t\treturn \"\", false, fmt.Errorf(\"member %q is absent\", name)\n790|\t}\n791|\tvar value *string\n792|\tif err := json.Unmarshal(raw, &value); err != nil {\n793|\t\treturn \"\", false, fmt.Errorf(\"member %q is neither a digest nor null\", name)\n794|\t}\n795|\tif value == nil {\n796|\t\treturn \"\", false, nil\n797|\t}\n798|\tdigest, err := scalar.ParseDigest(*value)\n799|\tif err != nil {\n800|\t\treturn \"\", false, err\n801|\t}\n802|\treturn digest.String(), true, nil\n803|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c501","stream":{"kind":"session","id":"01a0ae2e-304f-7791-b344-a738da145935"},"sequence":219,"recorded_at":1780531400000433,"record_type":"event","durability":"durable","causation_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","run_stream":{"kind":"run","id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3"},"call_id":"call_01a0ae2ea0d276428fa1708cd06078ab","text":"Read text file `internal/fencing/token.go`.\n1|package fencing\n2|\n3|// leaseSealToken is deliberately unexported and is minted only by the\n4|// free mintLeaseToken constructor below. The type-level census pins\n5|// that construction boundary across every production source file; the\n6|// token then makes a zero or field-assembled LeaseToken unusable at\n7|// runtime. There is no exported constructor and no exported field: a\n8|// caller outside this package cannot spell a live token.\n9|type leaseSealToken struct{}\n10|\n11|// leaseSeal holds the fenced authority a passed gate established: the\n12|// session with the exact winning (epoch, lease_id) tuple. Its fields\n13|// are private so callers cannot treat the minted projection as a\n14|// public record-shaped DTO.\n15|type leaseSeal struct {\n16|\ttoken   *leaseSealToken\n17|\tsession string\n18|\tepoch   uint64\n19|\tleaseID string\n20|}\n21|\n22|// LeaseToken is the sealed fencing capability Authorize mints for a\n23|// passed gate: the Section 7.5 LeaseToken projection\n24|// {session_id, lease_epoch, lease_id} for provider operations. A zero\n25|// value or a value assembled without the constructor-only seal token\n26|// is not authority, even when a caller fills the outer struct.\n27|type LeaseToken struct {\n28|\tseal *leaseSeal\n29|}\n30|\n31|// mintLeaseToken is the single constructor for a live LeaseToken. It\n32|// runs only at the end of Authorize, after every ownership, grant,\n33|// and tuple arm has passed.\n34|func mintLeaseToken(session string, epoch uint64, leaseID string) LeaseToken {\n35|\treturn LeaseToken{seal: &leaseSeal{token: &leaseSealToken{}, session: session, epoch: epoch, leaseID: leaseID}}\n36|}\n37|\n38|// authority opens the seal for the capability consumers. A missing\n39|// seal or seal token refuses lease_conflict before any other check,\n40|// so forgery can never degrade into a different class.\n41|func (token LeaseToken) authority() (*leaseSeal, error) {\n42|\tif token.seal == nil || token.seal.token == nil {\n43|\t\treturn nil, refuse(ErrLeaseConflict, \"fencing capability seal is missing\")\n44|\t}\n45|\treturn token.seal, nil\n46|}\n47|\n48|// ProviderOperation is one Section 7.5 provider operation that carries\n49|// the LeaseToken. Resume, stop, materialize-commit, and\n50|// native-store-plan carry the same triple on the wire; their callers\n51|// have no gate entry in this package yet, so binding them here would\n52|// be an untestable claim and stays a stated bound.\n53|type ProviderOperation string\n54|\n55|const (\n56|\t// ProviderQuiesce binds the token to a quiesce operation.\n57|\tProviderQuiesce ProviderOperation = \"quiesce\"\n58|\t// ProviderCapture binds the token to a capture operation.\n59|\tProviderCapture ProviderOperation = \"capture\"\n60|\t// ProviderMaterialize binds the token to a materialize operation.\n61|\tProviderMaterialize ProviderOperation = \"materialize\"\n62|)\n63|\n64|// validProviderOperation reports whether op is a bound provider\n65|// operation. Anything else is a malformed bind call.\n66|func validProviderOperation(op ProviderOperation) bool {\n67|\tswitch op {\n68|\tcase ProviderQuiesce, ProviderCapture, ProviderMaterialize:\n69|\t\treturn true\n70|\t}\n71|\treturn false\n72|}\n73|\n74|// ProviderLease is the wire projection of a bound capability: the\n75|// Section 7.5 LeaseToken triple with the operation it authorizes. It\n76|// carries no seal because it is evidence of one past authorization,\n77|// not authority for another; only Bind mints it, and only from a live\n78|// sealed token.\n79|type ProviderLease struct {\n80|\tSessionID string\n81|\tEpoch     uint64\n82|\tLeaseID   string\n83|\tOperation ProviderOperation\n84|}\n85|\n86|// Bind projects a live LeaseToken onto one provider operation. A zero\n87|// or forged token refuses lease_conflict; an unknown operation refuses\n88|// invalid_arguments. Only a token minted by a passed Authorize gate\n89|// reaches the projection.\n90|func (token LeaseToken) Bind(operation ProviderOperation) (ProviderLease, error) {\n91|\tseal, err := token.authority()\n92|\tif err != nil {\n93|\t\treturn ProviderLease{}, err\n94|\t}\n95|\tif !validProviderOperation(operation) {\n96|\t\treturn ProviderLease{}, refuse(ErrInvalidArguments, \"unknown provider operation %q\", string(operation))\n97|\t}\n98|\treturn ProviderLease{SessionID: seal.session, Epoch: seal.epoch, LeaseID: seal.leaseID, Operation: operation}, nil\n99|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c503","stream":{"kind":"session","id":"01a0ae2e-304f-7791-b344-a738da145935"},"sequence":220,"recorded_at":1780531400000435,"record_type":"event","durability":"durable","causation_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","run_stream":{"kind":"run","id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3"},"call_id":"call_01a0ae2ea206755588f7c7099ca89a51","text":"Read text file `internal/fencing/terminate.go`.\n1|package fencing\n2|\n3|import (\n4|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n5|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n6|)\n7|\n8|// AuthorizeTerminateStale gates the terminal backend terminate-stale\n9|// operation: terminate a process only for explicit force recovery\n10|// after preserving diagnostics, and only when the target is fenced\n11|// (its token is not the winning tuple). The caller needs no winning\n12|// grant of its own: the stale-process host runs this during force\n13|// recovery. A nil error authorizes the termination; any refusal names\n14|// the Section 4.C terminate-stale row class\n15|// (local_precondition_failed) or the fencing class that applies.\n16|//\n17|// Arm order is precedence: malformed calls die first, then the\n18|// authority to judge staleness (an established, well-formed winner),\n19|// then the explicit force recovery confirmation with its preserved\n20|// diagnostics, then the target binding, then the live-owner guard.\n21|func AuthorizeTerminateStale(presented PresentedToken, winner sessrepo.LeaseSummary, hasWinner bool, forceRecovery bool, diagnosticsPreserved bool) error {\n22|\tif _, err := scalar.ParseUUIDv7(presented.SessionID); err != nil {\n23|\t\treturn refuse(ErrInvalidArguments, \"terminate-stale target session %q is not a UUIDv7: %v\", presented.SessionID, err)\n24|\t}\n25|\tif presented.Epoch == 0 {\n26|\t\treturn refuse(ErrInvalidArguments, \"terminate-stale target carries epoch 0, want an epoch at or above 1\")\n27|\t}\n28|\tif _, err := scalar.ParseUUIDv4(presented.LeaseID); err != nil {\n29|\t\treturn refuse(ErrInvalidArguments, \"terminate-stale target lease %q is not a UUIDv4: %v\", presented.LeaseID, err)\n30|\t}\n31|\tif !hasWinner {\n32|\t\treturn refuse(ErrLocalPreconditionFailed, \"terminate-stale cannot prove its target is fenced without an established winning lease\")\n33|\t}\n34|\tif winner.Epoch == 0 || !validLeaseID(winner.LeaseID) {\n35|\t\treturn refuse(ErrInvalidArguments, \"terminate-stale observation carries no well-formed winning lease\")\n36|\t}\n37|\tif !forceRecovery {\n38|\t\treturn refuse(ErrLocalPreconditionFailed, \"terminate-stale requires explicit force recovery\")\n39|\t}\n40|\tif !diagnosticsPreserved {\n41|\t\treturn refuse(ErrLocalPreconditionFailed, \"terminate-stale requires preserved diagnostics before termination\")\n42|\t}\n43|\tif presented.SessionID != winner.SessionID {\n44|\t\treturn refuse(ErrLeaseConflict, \"terminate-stale target for session %s is not fenced by the winning lease for session %s\", presented.SessionID, winner.SessionID)\n45|\t}\n46|\tif presented.Epoch == winner.Epoch && presented.LeaseID == winner.LeaseID {\n47|\t\treturn refuse(ErrLocalPreconditionFailed, \"terminate-stale must not terminate the live winning owner at epoch %d\", winner.Epoch)\n48|\t}\n49|\treturn nil\n50|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c505","stream":{"kind":"session","id":"01a0ae2e-304f-7791-b344-a738da145935"},"sequence":221,"recorded_at":1780531400000437,"record_type":"event","durability":"durable","causation_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","run_stream":{"kind":"run","id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3"},"call_id":"call_01a0ae2ea33c72e7903cb250329ba118","text":"Read text file `internal/fencing/doc.go`.\n1|// Package fencing gates every activation-class action on the winning\n2|// lease and the exact fencing epoch.\n3|//\n4|// Normative scope: AX v0.6.0 Section 2.2 global invariants (the winning\n5|// committed lease is the only authority that may create a destination\n6|// runtime; a fencing token is the winning lease_id + epoch pair carried\n7|// by every owner-authored event and mutation; force takeover fences the\n8|// prior owner logically), Section 5.3 Lease Record (epoch, predecessor,\n9|// holder, fencing token, revalidation before input, turn, checkpoint,\n10|// push, and resume), Sections 13.6-13.10 (graceful takeover, force\n11|// takeover, fork, stop, resume: which steps require the winning lease\n12|// and the exact epoch), the Section 4 terminal wrapper rule (compare the\n13|// local fencing token before launching a provider; park safely when\n14|// ownership is remote, ambiguous, or unverified), and the Section 7.5\n15|// Provider Protocol LeaseToken carried by quiesce, capture, and\n16|// materialize operations.\n17|//\n18|// Division of authority (no second lease model):\n19|//\n20|//   - The Lease Record shape, identity, and lifecycle (CreateLease,\n21|//     CompareAndSwapLease, WinningLease, VerifyFencingToken,\n22|//     CheckFencingExpiry, CompareLeaseTuple) are owned by\n23|//     internal/sessrepo. This package never mints, persists, orders, or\n24|//     revalidates a lease itself: Observe loads the winning summary\n25|//     through ListLeases, and the expiry arm calls CheckFencingExpiry.\n26|//   - The winning-tuple rule is owned by internal/sessstate (Compare).\n27|//     This package never compares two leases against each other; it\n28|//     compares one presented token for exact equality with the one\n29|//     winning summary the store reports.\n30|//   - Takeover, fork, stop, and resume transactions, terminal backends,\n31|//     and provider plugin processes are callers, not members: the gates\n32|//     model their entry points (AuthorizeActivation, AuthorizeInput,\n33|//     AuthorizeMutation, AuthorizeCheckpoint, AuthorizeRestore,\n34|//     AuthorizeTerminateStale) and the callers report their own sync,\n35|//     handoff, and grant facts through Observation.\n36|//\n37|// The gates are pure over durable inputs: they perform no writes, hold\n38|// no cache, and read no clock except the Now the caller supplies, so\n39|// there is no crash seam and no idempotency hazard to evidence beyond\n40|// the no-write test. Every refusal carries a Section 15 registered code\n41|// and nothing else: lease_conflict, not_owner, and stale_owner at exit\n42|// 10, invalid_arguments at exit 2, and local_precondition_failed at exit\n43|// 3. Launch-class entries (activation, restore) park instead of refusing\n44|// when ownership is remote, ambiguous, unverified, or absent, carrying\n45|// the Section 5.2 session.parked vocabulary\n46|// (remote_owner|stale_owner|restore_policy|failed_handoff) with the\n47|// winning lease ID; every other entry refuses outright.\n48|package fencing","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
