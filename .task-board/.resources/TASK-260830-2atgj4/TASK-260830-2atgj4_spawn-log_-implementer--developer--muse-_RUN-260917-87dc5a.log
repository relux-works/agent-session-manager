{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c60f","stream":{"kind":"session","id":"01a0ae2e-304f-7791-b344-a738da145935"},"sequence":354,"recorded_at":1780531400000703,"record_type":"event","durability":"durable","causation_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3","run_stream":{"kind":"run","id":"3f9b309c-9633-41a9-b30f-c2d9c31c28f3"},"task_stream":{"kind":"task","id":"01a0ae2e-fbe4-7081-a2d3-66bbf6644f45"},"task_id":"01a0ae2e-fbe4-7081-a2d3-66bbf6644f45","event":{"kind":"output","task_id":"01a0ae2e-fbe4-7081-a2d3-66bbf6644f45","chunk":"Read text file `internal/traceability/traceability.go`.\n1|// Package traceability verifies that the pinned AX specification inventory\n2|// remains bound to concrete production declarations and executable acceptance\n3|// cases. It is a read-only repository gate; it does not advertise runtime\n4|// capabilities or mutate implementation state.\n5|package traceability\n6|\n7|import (\n8|\t\"bytes\"\n9|\t\"crypto/sha256\"\n10|\t\"encoding/hex\"\n11|\t\"encoding/json\"\n12|\t\"errors\"\n13|\t\"fmt\"\n14|\t\"go/ast\"\n15|\t\"go/parser\"\n16|\t\"go/token\"\n17|\t\"io\"\n18|\t\"io/fs\"\n19|\t\"path\"\n20|\t\"regexp\"\n21|\t\"strings\"\n22|\t\"unicode\"\n23|\t\"unicode/utf8\"\n24|\n25|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n26|\t\"github.com/relux-works/agent-session-manager/internal/cataloggen\"\n27|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n28|\t\"github.com/relux-works/agent-session-manager/internal/specpin\"\n29|)\n30|\n31|const (\n32|\townershipRegistryPath = \"internal/traceability/ownership.v0.6.0.json\"\n33|\tcontractLockPath      = \"internal/specpin/v0.6.0.lock.json\"\n34|\tcatalogMetadataPath   = \"internal/catalog/catalog.v0.6.0.json\"\n35|\tgeneratedCatalogPath  = \"internal/catalog/catalog_gen.go\"\n36|\n37|\townershipFormat        = \"ax-spec-to-code-ownership\"\n38|\townershipFormatVersion = 1\n39|\n40|\t// reviewedOwnershipCanonicalSHA256 pins the semantic JSON projection. JSON\n41|\t// formatting may change, but ownership claims cannot be self-minted without\n42|\t// an explicit review of this binding.\n43|\treviewedOwnershipCanonicalSHA256 = \"94e589c880a263a61fe3e4e12ed836e076dd7e5bc074b6f6596de35231a53417\"\n44|)\n45|\n46|var ErrTraceability = errors.New(\"spec-to-code traceability check failed\")\n47|\n48|// Report contains inventory coverage only. These counts do not claim that any\n49|// runtime capability is available, enabled, or supported.\n50|type Report struct {\n51|\tContracts              int\n52|\tNormativeSections      int\n53|\tAcceptanceCases        int\n54|\tFixtures               int\n55|\tCompatibilityContracts int\n56|\tAssignedScopes         int\n57|\n58|\t// SectionBindings and the coverage counters below are a measured ratio over\n59|\t// the registered section bindings, not a prose claim. NormativeClauses is\n60|\t// the number of RFC 2119 clause lines the pinned document itself carries in\n61|\t// the bound sections; DischargedClauses is how many of those a binding\n62|\t// enumerates with a verified excerpt and an acceptance owner.\n63|\tSectionBindings     int\n64|\tFullCoverage        int\n65|\tPartialCoverage     int\n66|\tSliverCoverage      int\n67|\tUnevidencedCoverage int\n68|\tUnmeasuredCoverage  int\n69|\tUnownedSections     int\n70|\tNormativeClauses    int\n71|\tDischargedClauses   int\n72|}\n73|\n74|type ownershipKind string\n75|\n76|const (\n77|\townershipContract         ownershipKind = \"contract\"\n78|\townershipNormativeSection ownershipKind = \"normative_section\"\n79|\townershipSectionBinding   ownershipKind = \"section_binding\"\n80|\townershipFixture          ownershipKind = \"fixture\"\n81|)\n82|\n83|type ownershipRegistry struct {\n84|\tFormat          string           `json:\"format\"`\n85|\tFormatVersion   int              `json:\"format_version\"`\n86|\tSource          registrySource   `json:\"source\"`\n87|\tAcceptanceCases []acceptanceCase `json:\"acceptance_cases\"`\n88|\tOwnership       []ownershipGroup `json:\"ownership\"`\n89|\tUnownedSections []unownedSection `json:\"unowned_sections\"`\n90|}\n91|\n92|// unownedSection records a real v0.6.0 section that this repository does not\n93|// implement. It exists so an unimplemented section is disclosed by name rather\n94|// than bound to a symbol from a neighbouring package, which is what an owned\n95|// key would otherwise assert. It is a disclosure, never an exemption: a section\n96|// the generated catalog requires an owner for may not be declared here, and\n97|// assigned-scope admission refuses an unowned section and prints its gap.\n98|type unownedSection struct {\n99|\tKey      string `json:\"key\"`\n100|\tGap      string `json:\"gap\"`\n101|\tEvidence string `json:\"evidence\"`\n102|}\n103|\n104|type registrySource struct {\n105|\tRepository     string `json:\"repository\"`\n106|\tRelease        string `json:\"release\"`\n107|\tCommit         string `json:\"commit\"`\n108|\tDocumentPath   string `json:\"document_path\"`\n109|\tDocumentSHA256 string `json:\"document_sha256\"`\n110|}\n111|\n112|type acceptanceCase struct {\n113|\tID         string          `json:\"id\"`\n114|\tProduction codeReference   `json:\"production\"`\n115|\tTests      []codeReference `json:\"tests\"`\n116|}\n117|\n118|type ownershipGroup struct {\n119|\tKind            ownershipKind      `json:\"kind\"`\n120|\tKeys            []string           `json:\"keys\"`\n121|\tProduction      codeReference      `json:\"production\"`\n122|\tAcceptanceCases []string           `json:\"acceptance_cases\"`\n123|\tCoverage        coverageLevel      `json:\"coverage,omitempty\"`\n124|\tGap             string             `json:\"gap,omitempty\"`\n125|\tClauses         []dischargedClause `json:\"clauses,omitempty\"`\n126|}\n127|\n128|// coverageLevel is how much of a bound section a binding claims to discharge.\n129|// The claim is not taken on trust: the level is recomputed from the clauses the\n130|// binding enumerates against the clause inventory the pinned specification\n131|// itself carries for that section, and a claim that differs from the measured\n132|// level is refused.\n133|type coverageLevel string\n134|\n135|const (\n136|\t// coverageFull means every normative clause the pinned section carries is\n137|\t// enumerated with a verified excerpt and an acceptance owner.\n138|\tcoverageFull coverageLevel = \"full\"\n139|\t// coveragePartial means at least half of them are.\n140|\tcoveragePartial coverageLevel = \"partial\"\n141|\t// coverageSliver means fewer than half are: the binding implements a corner\n142|\t// of the section it is registered against.\n143|\tcoverageSliver coverageLevel = \"sliver\"\n144|\t// coverageUnevidenced means the binding enumerates no clause at all. It says\n145|\t// the registry makes no clause-level claim, not that the implementation\n146|\t// covers nothing.\n147|\tcoverageUnevidenced coverageLevel = \"unevidenced\"\n148|\t// coverageUnmeasured means normativeKeywordPattern finds no clause line\n149|\t// under the section's heading or its subheadings, so the gate cannot\n150|\t// measure the section's obligations at all.\n151|\t//\n152|\t// It is deliberately NOT called \"declarative\", and it does NOT mean the\n153|\t// section carries no obligation. Nineteen of the 157 pinned headings are in\n154|\t// this class and every one of them has a substantive body: Section 15.2 is a\n155|\t// eighteen-row normative exit-code registry and Section 7.3 is the closed\n156|\t// Provider Manifest, both of which state their obligations as tables rather\n157|\t// than in uppercase RFC 2119 keywords. Treating that silence as \"nothing to\n158|\t// discharge\" is the same free pass this gate exists to remove, reached\n159|\t// through the scanner instead of through the label, so an unmeasured binding\n160|\t// carries the same mandatory gap as every other level below full and is\n161|\t// refused for assigned-scope admission.\n162|\tcoverageUnmeasured coverageLevel = \"unmeasured\"\n163|)\n164|\n165|// dischargedClause binds one normative clause of the pinned section to the\n166|// acceptance cases that discharge it. Every field is checked against the\n167|// hash-verified document: the identifier must index the section's own clause\n168|// inventory, the line must be the line that clause occupies, and the excerpt\n169|// must be that clause's text quoted verbatim, so a clause cannot be claimed\n170|// with a true sentence about something else.\n171|type dischargedClause struct {\n172|\tID              string   `json:\"id\"`\n173|\tLine            int      `json:\"line\"`\n174|\tExcerpt         string   `json:\"excerpt\"`\n175|\tAcceptanceCases []string `json:\"acceptance_cases\"`\n176|}\n177|\n178|// normativeClause is one RFC 2119 clause line of the pinned specification,\n179|// measured from the document rather than declared by the registry.\n180|type normativeClause struct {\n181|\tID   string\n182|\tLine int\n183|\tText string\n184|}\n185|\n186|type codeReference struct {\n187|\tPath        string `json:\"path\"`\n188|\tDeclaration string `json:\"declaration\"`\n189|}\n190|\n191|type assignedSectionBinding struct {\n192|\tScope string\n193|\tKeys  []string\n194|}\n195|\n196|var assignedSectionPattern = regexp.MustCompile(`^((?:20|1[0-9]|[1-9])(?:\\.(?:[0-9]+|[A-Za-z]))*)(?:-((?:20|1[0-9]|[1-9])(?:\\.(?:[0-9]+|[A-Za-z]))*))?$`)\n197|var catalogAppendixPattern = regexp.MustCompile(`(?i)^Appendix ([A-D]):`)\n198|\n199|// VerifyRepository is the production CI entry point. It verifies exact pinned\n200|// inputs, stale generated output, compatibility coverage, and every registered\n201|// ownership reference against the supplied repository filesystem.\n202|func VerifyRepository(repository fs.FS) (Report, error) {\n203|\treturn verifyRepository(repository, nil)\n204|}\n205|\n206|// VerifyAssignedSections is the production Story-scope entry point. Each exact\n207|// assigned subsection, or every heading in a same-section range, must have its\n208|// own scoped production declaration and executable acceptance-case link. A\n209|// pinned top-level source owner alone never satisfies assigned-scope admission.\n210|func VerifyAssignedSections(repository fs.FS, sections []string) (Report, error) {\n211|\tif len(sections) == 0 {\n212|\t\treturn Report{}, fail(\"assigned section scope is empty\")\n213|\t}\n214|\treturn verifyRepository(repository, sections)\n215|}\n216|\n217|func verifyRepository(repository fs.FS, assignedSections []string) (Report, error) {\n218|\tif repository == nil {\n219|\t\treturn Report{}, fail(\"repository filesystem is nil\")\n220|\t}\n221|\n222|\tlockBytes, err := readRequired(repository, contractLockPath)\n223|\tif err != nil {\n224|\t\treturn Report{}, err\n225|\t}\n226|\tmanifest, err := specpin.VerifyV060(lockBytes)\n227|\tif err != nil {\n228|\t\treturn Report{}, fail(\"verify normative source lock: %v\", err)\n229|\t}\n230|\n231|\tmetadataBytes, err := readRequired(repository, catalogMetadataPath)\n232|\tif err != nil {\n233|\t\treturn Report{}, err\n234|\t}\n235|\tgenerated, err := cataloggen.Generate(metadataBytes, lockBytes)\n236|\tif err != nil {\n237|\t\treturn Report{}, fail(\"verify reviewed catalog metadata: %v\", err)\n238|\t}\n239|\tcommittedGenerated, err := readRequired(repository, generatedCatalogPath)\n240|\tif err != nil {\n241|\t\treturn Report{}, err\n242|\t}\n243|\tif !bytes.Equal(generated, committedGenerated) {\n244|\t\treturn Report{}, fail(\"generated catalog is stale; run go generate ./internal/catalog\")\n245|\t}\n246|\n247|\tcurrentCatalog, err := catalog.ForRelease(catalog.ReleaseV060)\n248|\tif err != nil {\n249|\t\treturn Report{}, fail(\"load current catalog: %v\", err)\n250|\t}\n251|\tif err := verifyCatalogContracts(manifest.Contracts, currentCatalog.Contracts); err != nil {\n252|\t\treturn Report{}, err\n253|\t}\n254|\t// The legacy projection keeps the superseded v0.5.0 registry honest:\n255|\t// the generated catalog must still carry the exact historical rows the\n256|\t// adopted lock derives, so legacy support claims stay verifiable after\n257|\t// the authority moved to v0.6.0.\n258|\tlegacyContracts, err := manifest.ContractsForRelease(specpin.ReleaseV050)\n259|\tif err != nil {\n260|\t\treturn Report{}, fail(\"derive legacy catalog contracts: %v\", err)\n261|\t}\n262|\tlegacyCatalog, err := catalog.ForRelease(catalog.ReleaseV050)\n263|\tif err != nil {\n264|\t\treturn Report{}, fail(\"load legacy catalog: %v\", err)\n265|\t}\n266|\tif err := verifyCatalogContracts(legacyContracts, legacyCatalog.Contracts); err != nil {\n267|\t\treturn Report{}, err\n268|\t}\n269|\tcompatibilityCatalog, err := catalog.ForRelease(catalog.ReleaseV043)\n270|\tif err != nil {\n271|\t\treturn Report{}, fail(\"load compatibility catalog: %v\", err)\n272|\t}\n273|\n274|\tregistryBytes, err := readRequired(repository, ownershipRegistryPath)\n275|\tif err != nil {\n276|\t\treturn Report{}, err\n277|\t}\n278|\tregistry, err := decodeOwnershipRegistry(registryBytes)\n279|\tif err != nil {\n280|\t\treturn Report{}, err\n281|\t}\n282|\tbindings, err := resolveAssignedSections(manifest.Source.NormativeScope, assignedSections)\n283|\tif err != nil {\n284|\t\treturn Report{}, err\n285|\t}\n286|\tdocument, err := specdoc.LoadV060()\n287|\tif err != nil {\n288|\t\treturn Report{}, fail(\"load pinned specification document: %v\", err)\n289|\t}\n290|\tif manifest.Source.Document.SHA256 != specpin.DocumentSHA256V060 {\n291|\t\treturn Report{}, fail(\n292|\t\t\t\"verified normative lock document digest %s differs from the pinned clause source %s\",\n293|\t\t\tmanifest.Source.Document.SHA256, specpin.DocumentSHA256V060)\n294|\t}\n295|\treturn verifyOwnership(repository, document, registry, manifest, currentCatalog, compatibilityCatalog, bindings)\n296|}\n297|\n298|func readRequired(repository fs.FS, filename string) ([]byte, error) {\n299|\tvalue, err := fs.ReadFile(repository, filename)\n300|\tif err != nil {\n301|\t\treturn nil, fail(\"read required evidence %q: %v\", filename, err)\n302|\t}\n303|\treturn value, nil\n304|}\n305|\n306|func decodeOwnershipRegistry(candidate []byte) (ownershipRegistry, error) {\n307|\tvar decoded ownershipRegistry\n308|\tdecoder := json.NewDecoder(bytes.NewReader(candidate))\n309|\tdecoder.DisallowUnknownFields()\n310|\tif err := decoder.Decode(&decoded); err != nil {\n311|\t\treturn ownershipRegistry{}, fail(\"decode ownership registry: %v\", err)\n312|\t}\n313|\tvar trailing any\n314|\tif err := decoder.Decode(&trailing); !errors.Is(err, io.EOF) {\n315|\t\tif err == nil {\n316|\t\t\treturn ownershipRegistry{}, fail(\"decode ownership registry: multiple JSON values\")\n317|\t\t}\n318|\t\treturn ownershipRegistry{}, fail(\"decode ownership registry trailing data: %v\", err)\n319|\t}\n320|\treturn decoded, nil\n321|}\n322|\n323|func verifyOwnership(\n324|\trepository fs.FS,\n325|\tdocument *specdoc.Document,\n326|\tregistry ownershipRegistry,\n327|\tmanifest specpin.Manifest,\n328|\tcurrentCatalog catalog.Catalog,\n329|\tcompatibilityCatalog catalog.Catalog,\n330|\tassignedBindings []assignedSectionBinding,\n331|) (Report, error) {\n332|\tif registry.Format != ownershipFormat || registry.FormatVersion != ownershipFormatVersion {\n333|\t\treturn Report{}, fail(\"unsupported ownership registry format %q version %d\", registry.Format, registry.FormatVersion)\n334|\t}\n335|\tsource := registry.Source\n336|\tif source.Repository != manifest.Source.Repository ||\n337|\t\tsource.Release != manifest.Source.Release ||\n338|\t\tsource.Commit != manifest.Source.Commit ||\n339|\t\tsource.DocumentPath != manifest.Source.Document.Path ||\n340|\t\tsource.DocumentSHA256 != manifest.Source.Document.SHA256 {\n341|\t\treturn Report{}, fail(\"ownership registry source differs from verified normative lock\")\n342|\t}\n343|\n344|\texpected := map[ownershipKind]map[string]struct{}{\n345|\t\townershipContract:         expectedContracts(manifest.Contracts),\n346|\t\townershipNormativeSection: expectedNormativeSections(manifest, currentCatalog),\n347|\t\townershipSectionBinding:   expectedSectionBindingInventory(),\n348|\t\townershipFixture:          expectedFixtures(manifest, currentCatalog),\n349|\t}\n350|\trequiredSectionBindings, err := expectedCatalogSectionBindings(currentCatalog)\n351|\tif err != nil {\n352|\t\treturn Report{}, err\n353|\t}\n354|\trequired := map[ownershipKind]map[string]struct{}{\n355|\t\townershipContract:         expected[ownershipContract],\n356|\t\townershipNormativeSection: expected[ownershipNormativeSection],\n357|\t\townershipSectionBinding:   requiredSectionBindings,\n358|\t\townershipFixture:          expected[ownershipFixture],\n359|\t}\n360|\tselectedSectionBindings := map[string]struct{}(nil)\n361|\tif assignedBindings != nil {\n362|\t\trequired = cloneOwnershipSets(expected)\n363|\t\tselectedSectionBindings = make(map[string]struct{})\n364|\t\tfor _, binding := range assignedBindings {\n365|\t\t\tfor _, key := range binding.Keys {\n366|\t\t\t\tselectedSectionBindings[key] = struct{}{}\n367|\t\t\t}\n368|\t\t}\n369|\t\trequired[ownershipSectionBinding] = make(map[string]struct{})\n370|\t}\n371|\tchecker := newSourceChecker(repository)\n372|\tacceptanceIDs, err := verifyAcceptanceCases(checker, registry.AcceptanceCases)\n373|\tif err != nil {\n374|\t\treturn Report{}, err\n375|\t}\n376|\t// Coverage is measured over every registered section binding, not only the\n377|\t// assigned ones, so a sliver planted anywhere in the registry reddens both\n378|\t// production entry points rather than only the repository-wide one. It is\n379|\t// measured before ownership resolution so that a section moved to the\n380|\t// unowned disclosure to dodge the catalog's owner requirement is reported\n381|\t// as that dodge rather than as an ordinary missing owner.\n382|\tcoverage, err := verifySectionCoverage(document, registry.Ownership, acceptanceIDs)\n383|\tif err != nil {\n384|\t\treturn Report{}, err\n385|\t}\n386|\townedSections := make(map[string]struct{}, len(coverage))\n387|\tfor key := range coverage {\n388|\t\townedSections[key] = struct{}{}\n389|\t}\n390|\tunowned, err := verifyUnownedSections(\n391|\t\tregistry.UnownedSections, expected[ownershipSectionBinding], requiredSectionBindings, ownedSections)\n392|\tif err != nil {\n393|\t\treturn Report{}, err\n394|\t}\n395|\n396|\towned, err := verifyOwnershipGroups(checker, registry.Ownership, acceptanceIDs, expected, required, selectedSectionBindings)\n397|\tif err != nil {\n398|\t\treturn Report{}, err\n399|\t}\n400|\n401|\tfor _, binding := range assignedBindings {\n402|\t\tfor _, key := range binding.Keys {\n403|\t\t\tif entry, disclosed := unowned[key]; disclosed {\n404|\t\t\t\treturn Report{}, fail(\n405|\t\t\t\t\t\"assigned section %q binding %q is recorded unowned: %s\", binding.Scope, key, entry.Gap)\n406|\t\t\t}\n407|\t\t\tif _, ok := owned[ownershipSectionBinding][key]; !ok {\n408|\t\t\t\treturn Report{}, fail(\"assigned section %q binding %q has no scoped implementation owner\", binding.Scope, key)\n409|\t\t\t}\n410|\t\t\t// Admission requires full and nothing else. coverageUnmeasured is\n411|\t\t\t// deliberately not admitted: the gate cannot see the section's\n412|\t\t\t// obligations, and admitting on an unverifiable justification\n413|\t\t\t// sentence would be self-minted evidence for exactly the class this\n414|\t\t\t// gate exists to refuse. Absence of a scanner-visible clause is a\n415|\t\t\t// failure to measure, not a measured absence of obligation.\n416|\t\t\tmeasured := coverage[key]\n417|\t\t\tif measured.Level != coverageFull {\n418|\t\t\t\treturn Report{}, fail(\n419|\t\t\t\t\t\"assigned section %q binding %q discharges %s normative clauses, which is %s coverage; assigned-scope admission requires full: %s\",\n420|\t\t\t\t\tbinding.Scope, key, measured.Ratio(), measured.Level, measured.Gap)\n421|\t\t\t}\n422|\t\t}\n423|\t}\n424|\tfor _, contract := range compatibilityCatalog.Contracts {\n425|\t\tkey := contractKey(contract.Name, string(contract.ID))\n426|\t\tif _, ok := owned[ownershipContract][key]; !ok {\n427|\t\t\treturn Report{}, fail(\"compatibility contract %q has no implementation owner\", key)\n428|\t\t}\n429|\t}\n430|\n431|\tcanonical, err := json.Marshal(registry)\n432|\tif err != nil {\n433|\t\treturn Report{}, fail(\"encode canonical ownership registry: %v\", err)\n434|\t}\n435|\tdigest := sha256.Sum256(canonical)\n436|\tgotDigest := hex.EncodeToString(digest[:])\n437|\tif gotDigest != reviewedOwnershipCanonicalSHA256 {\n438|\t\treturn Report{}, fail(\"ownership registry projection digest %s differs from reviewed %s\", gotDigest, reviewedOwnershipCanonicalSHA256)\n439|\t}\n440|\n441|\treport := Report{\n442|\t\tContracts:              len(expected[ownershipContract]),\n443|\t\tNormativeSections:      len(expected[ownershipNormativeSection]),\n444|\t\tAcceptanceCases:        len(acceptanceIDs),\n445|\t\tFixtures:               len(expected[ownershipFixture]),\n446|\t\tCompatibilityContracts: len(compatibilityCatalog.Contracts),\n447|\t\tAssignedScopes:         len(assignedBindings),\n448|\t\tSectionBindings:        len(coverage),\n449|\t\tUnownedSections:        len(unowned),\n450|\t}\n451|\tfor _, measured := range coverage {\n452|\t\treport.NormativeClauses += measured.Total\n453|\t\treport.DischargedClauses += measured.Discharged\n454|\t\tswitch measured.Level {\n455|\t\tcase coverageFull:\n456|\t\t\treport.FullCoverage++\n457|\t\tcase coveragePartial:\n458|\t\t\treport.PartialCoverage++\n459|\t\tcase coverageSliver:\n460|\t\t\treport.SliverCoverage++\n461|\t\tcase coverageUnevidenced:\n462|\t\t\treport.UnevidencedCoverage++\n463|\t\tcase coverageUnmeasured:\n464|\t\t\treport.UnmeasuredCoverage++\n465|\t\t}\n466|\t}\n467|\treturn report, nil\n468|}\n469|\n470|// verifySectionCoverage measures every registered section binding against the\n471|// pinned document and refuses a coverage claim on any other ownership kind. A\n472|// contract or fixture owner has no section to be measured against, so a\n473|// coverage field there would be a claim the gate cannot check.\n474|func verifySectionCoverage(\n475|\tdocument *specdoc.Document,\n476|\tgroups []ownershipGroup,\n477|\tacceptanceIDs map[string]struct{},\n478|) (map[string]sectionCoverage, error) {\n479|\tresult := make(map[string]sectionCoverage)\n480|\tfor index, group := range groups {\n481|\t\tif group.Kind != ownershipSectionBinding {\n482|\t\t\tif group.Coverage != \"\" || group.Gap != \"\" || len(group.Clauses) != 0 {\n483|\t\t\t\treturn nil, fail(\n484|\t\t\t\t\t\"ownership group %d (%s) claims section coverage, which only a section binding can be measured for\",\n485|\t\t\t\t\tindex, group.Kind)\n486|\t\t\t}\n487|\t\t\tcontinue\n488|\t\t}\n489|\t\tif len(group.Keys) != 1 {\n490|\t\t\treturn nil, fail(\"section binding ownership group %d has %d keys, want exactly one\", index, len(group.Keys))\n491|\t\t}\n492|\t\tmeasured, err := verifySectionBindingCoverage(document, group, acceptanceIDs)\n493|\t\tif err != nil {\n494|\t\t\treturn nil, err\n495|\t\t}\n496|\t\tif _, duplicate := result[measured.Key]; duplicate {\n497|\t\t\treturn nil, fail(\"duplicate section_binding implementation owner for %q\", measured.Key)\n498|\t\t}\n499|\t\tresult[measured.Key] = measured\n500|\t}\n(more lines below)","final_result":true}}}
