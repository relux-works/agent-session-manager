{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4d7","stream":{"kind":"session","id":"01a0ae38-1954-7242-9b52-ff7ca6c9b52f"},"sequence":198,"recorded_at":1780531400000391,"record_type":"event","durability":"durable","causation_id":"815552bd-492d-441d-89cf-fcae5a028cc4","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"815552bd-492d-441d-89cf-fcae5a028cc4","run_stream":{"kind":"run","id":"815552bd-492d-441d-89cf-fcae5a028cc4"},"task_stream":{"kind":"task","id":"01a0ae38-8526-76e1-b8f5-c684d685d977"},"task_id":"01a0ae38-8526-76e1-b8f5-c684d685d977","event":{"kind":"output","task_id":"01a0ae38-8526-76e1-b8f5-c684d685d977","chunk":"Read text file `internal/sessstate/sessstate.go`.\n(499 line(s) above)\n500|\t\treturn true, nil\n501|\tdefault:\n502|\t\treturn false, refuse(ErrStaleLease, \"event %s lease epoch %d precedes chain head epoch %d\", event.ID, lease.Epoch, fold.current.Epoch)\n503|\t}\n504|}\n505|\n506|// tailID and tailSeq live beside the fold; declared here to keep the\n507|// struct literal above readable.\n508|func (fold *chainFold) conflict(kind, rule, format string, arguments ...any) {\n509|\tfold.projection.Conflicts = append(fold.projection.Conflicts, Conflict{\n510|\t\tKind:   kind,\n511|\t\tRule:   rule,\n512|\t\tDetail: fmt.Sprintf(format, arguments...),\n513|\t})\n514|}\n515|\n516|// step moves the derivation through the Section 5.7 table. An empty\n517|// target keeps the state (a fact or inert event performs no\n518|// transition); an equal target restates it (a confirming event while\n519|// already there is not a transition); the first event may only open a\n520|// bootstrap state; every other move needs its table edge, else\n521|// invalid_state_transition.\n522|func (fold *chainFold) step(target State, what string) error {\n523|\tif target == \"\" || target == fold.state {\n524|\t\treturn nil\n525|\t}\n526|\tif fold.state == \"\" {\n527|\t\tif _, ok := initialTargets[target]; !ok {\n528|\t\t\treturn refuse(ErrInvalidTransition, \"%s opens unbootstrapped state %q\", what, string(target))\n529|\t\t}\n530|\t\tfold.state = target\n531|\t\treturn nil\n532|\t}\n533|\tif _, ok := allowedTransitions[fold.state][target]; !ok {\n534|\t\treturn refuse(ErrInvalidTransition, \"%s moves %q to %q without a Section 5.7 edge\", what, string(fold.state), string(target))\n535|\t}\n536|\tfold.state = target\n537|\treturn nil\n538|}\n539|\n540|// effect applies one event's lifecycle meaning after continuity and\n541|// lease tracking. Fact events return an empty target and keep the\n542|// state; unknown v1 types and the v2/v3/v4 non-lifecycle types are\n543|// inert by Section 5.2 (retained, never applied).\n544|func (fold *chainFold) effect(event Event, lease LeaseHead, succession bool) error {\n545|\tname := \"event \" + event.Type + \" \" + event.ID\n546|\tswitch event.Type {\n547|\tcase \"session.created\":\n548|\t\treturn fold.effectCreated(event, name)\n549|\tcase \"terminal.created\":\n550|\t\treturn fold.effectTerminalCreated(event, name)\n551|\tcase \"provider.launched\":\n552|\t\treturn fold.effectProviderLaunched(event, name)\n553|\tcase \"provider.identified\":\n554|\t\treturn fold.effectProviderIdentified(event, name)\n555|\tcase \"session.idle\":\n556|\t\treturn fold.step(StateIdle, name)\n557|\tcase \"session.quiescing\":\n558|\t\treturn fold.step(StateQuiescing, name)\n559|\tcase \"checkpoint.created\":\n560|\t\treturn fold.effectCheckpointCreated(event, name)\n561|\tcase \"sync.completed\":\n562|\t\treturn nil\n563|\tcase \"session.stopped\":\n564|\t\treturn fold.effectStopped(event, name)\n565|\tcase \"session.resumed\":\n566|\t\treturn fold.effectResumed(event, name)\n567|\tcase \"session.bootstrap_aborted\":\n568|\t\treturn fold.effectBootstrapAborted(event, name)\n569|\tcase \"lease.transferred\", \"lease.forced\":\n570|\t\treturn fold.effectLease(event, lease, name, succession)\n571|\tcase \"session.parked\":\n572|\t\treturn fold.step(StateParked, name)\n573|\tcase \"session.failed\":\n574|\t\treturn fold.step(StateFailed, name)\n575|\tcase \"fork.created\", \"profile.changed\", \"takeover.force_confirmed\",\n576|\t\t\"replica.replace_confirmed\", \"task_board.adopted\",\n577|\t\t\"tombstone.issued\", \"tombstone.resolved\":\n578|\t\treturn nil\n579|\tcase \"session.tombstoned\":\n580|\t\treturn fold.step(StateTombstoned, name)\n581|\tcase \"task_board.launched\":\n582|\t\treturn fold.effectTaskBoardLaunched(event, name)\n583|\tdefault:\n584|\t\treturn nil\n585|\t}\n586|}\n587|\n588|// effectCreated opens the bootstrap, including the Section 5.7\n589|// failed-to-creating retry: epoch 1 under the same winning create\n590|// lease, no validated checkpoint yet, and no authoritative bootstrap\n591|// abort on record. Anything else that reaches for creating refuses.\n592|func (fold *chainFold) effectCreated(event Event, what string) error {\n593|\tif fold.state == \"\" {\n594|\t\treturn fold.step(StateCreating, what)\n595|\t}\n596|\tif fold.state != StateFailed {\n597|\t\treturn fold.step(StateCreating, what)\n598|\t}\n599|\tif event.LeaseEpoch != 1 || event.LeaseID != fold.createLease.LeaseID ||\n600|\t\tevent.LeaseEpoch != fold.createLease.Epoch {\n601|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap under a new lease\", what)\n602|\t}\n603|\tif fold.seenCheckpoint {\n604|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap past a validated checkpoint\", what)\n605|\t}\n606|\tif fold.seenAbort {\n607|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap past an authoritative abort\", what)\n608|\t}\n609|\treturn fold.step(StateCreating, what)\n610|}\n611|\n612|// effectTerminalCreated records the terminal binding; as the first\n613|// event it also opens the bootstrap in creating.\n614|func (fold *chainFold) effectTerminalCreated(event Event, what string) error {\n615|\tif event.SchemaVersion == \"4.0.0\" {\n616|\t\tbinding, err := payloadString(event.Payload, \"terminal_binding_id\")\n617|\t\tif err != nil {\n618|\t\t\treturn err\n619|\t\t}\n620|\t\tif _, err := scalar.ParseDigest(binding); err != nil {\n621|\t\t\treturn refuse(ErrDerivation, \"%s carries malformed terminal_binding_id: %v\", what, err)\n622|\t\t}\n623|\t\tbackend, err := payloadString(event.Payload, \"terminal_backend_id\")\n624|\t\tif err != nil {\n625|\t\t\treturn err\n626|\t\t}\n627|\t\tif _, err := terminalbackend.ParseID(backend); err != nil {\n628|\t\t\treturn refuse(ErrDerivation, \"%s carries refused terminal backend: %v\", what, err)\n629|\t\t}\n630|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, BindingID: binding, EventID: event.ID}\n631|\t} else {\n632|\t\tbackend, err := payloadString(event.Payload, \"backend\")\n633|\t\tif err != nil {\n634|\t\t\treturn err\n635|\t\t}\n636|\t\tif backend != \"tmux\" && backend != \"conpty\" {\n637|\t\t\treturn refuse(ErrDerivation, \"%s carries unknown terminal backend %q\", what, backend)\n638|\t\t}\n639|\t\tterminalID, err := payloadString(event.Payload, \"terminal_id\")\n640|\t\tif err != nil {\n641|\t\t\treturn err\n642|\t\t}\n643|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, TerminalID: terminalID, EventID: event.ID}\n644|\t}\n645|\tfold.projection.HasTerminal = true\n646|\tif fold.state == \"\" {\n647|\t\treturn fold.step(StateCreating, what)\n648|\t}\n649|\treturn nil\n650|}\n651|\n652|// effectProviderLaunched moves to running and records the launched\n653|// version. The record provider stays authoritative: a launched event\n654|// naming another provider records a provider_mismatch conflict under\n655|// the record-pinned-provider-wins rule instead of rewriting identity.\n656|func (fold *chainFold) effectProviderLaunched(event Event, what string) error {\n657|\tproviderID, err := payloadString(event.Payload, \"provider_id\")\n658|\tif err != nil {\n659|\t\treturn err\n660|\t}\n661|\tversion, err := payloadString(event.Payload, \"provider_version\")\n662|\tif err != nil {\n663|\t\treturn err\n664|\t}\n665|\tif providerID != fold.recordProvider {\n666|\t\tfold.conflict(ConflictProviderMismatch, ResolveRuleRecordPinnedProviderWins,\n667|\t\t\t\"event %s launches provider %q under record provider %q; the record value stays authoritative\",\n668|\t\t\tevent.ID, providerID, fold.recordProvider)\n669|\t} else {\n670|\t\tfold.projection.Provider.Version = version\n671|\t}\n672|\treturn fold.step(StateRunning, what)\n673|}\n674|\n675|// effectProviderIdentified records the newest identity record with\n676|// its confidence.\n677|func (fold *chainFold) effectProviderIdentified(event Event, what string) error {\n678|\trecordID, err := payloadString(event.Payload, \"provider_identity_record_id\")\n679|\tif err != nil {\n680|\t\treturn err\n681|\t}\n682|\tif _, err := scalar.ParseDigest(recordID); err != nil {\n683|\t\treturn refuse(ErrDerivation, \"%s carries malformed provider_identity_record_id: %v\", what, err)\n684|\t}\n685|\tconfidence, err := payloadString(event.Payload, \"confidence\")\n686|\tif err != nil {\n687|\t\treturn err\n688|\t}\n689|\tfold.projection.Provider.IdentityRecordID = recordID\n690|\tfold.projection.Provider.Confidence = confidence\n691|\treturn nil\n692|}\n693|\n694|// effectCheckpointCreated records the newest validated checkpoint and\n695|// moves idle or quiescing into checkpointing, or checkpointing back to\n696|// idle at the validated boundary. Any other lifecycle position refuses:\n697|// a checkpoint cannot land while running, creating, stopped, parked,\n698|// failed, stale, materializing, or tombstoned without the quiesce or\n699|// resume the table requires.\n700|func (fold *chainFold) effectCheckpointCreated(event Event, what string) error {\n701|\tcheckpointID, err := payloadString(event.Payload, \"checkpoint_id\")\n702|\tif err != nil {\n703|\t\treturn err\n704|\t}\n705|\tif _, err := scalar.ParseDigest(checkpointID); err != nil {\n706|\t\treturn refuse(ErrDerivation, \"%s carries malformed checkpoint_id: %v\", what, err)\n707|\t}\n708|\tkind, err := payloadString(event.Payload, \"kind\")\n709|\tif err != nil {\n710|\t\treturn err\n711|\t}\n712|\tfold.noteCheckpoint(checkpointID, kind, event.ID)\n713|\tswitch fold.state {\n714|\tcase \"\", StateIdle, StateQuiescing:\n715|\t\tif fold.state == \"\" {\n716|\t\t\treturn refuse(ErrInvalidTransition, \"%s publishes a checkpoint before any bootstrap\", what)\n717|\t\t}\n718|\t\treturn fold.step(StateCheckpointing, what)\n719|\tcase StateCheckpointing:\n720|\t\treturn fold.step(StateIdle, what)\n721|\tdefault:\n722|\t\treturn fold.step(StateCheckpointing, what)\n723|\t}\n724|}\n725|\n726|// effectStopped derives stopped for a checkpointed closure and failed\n727|// for a bootstrap abort. No event may derive stopped while the newest\n728|// checkpoint is null: the event's own checkpoint counts, so a\n729|// checkpointed stop carries its resumable base with it. A bootstrap\n730|// abort requires the null checkpoint, false resumable and graceful\n731|// values the canonical owner admitted, plus a preceding authoritative\n732|// abort event; an ambiguous live process stays failed with recovery\n733|// diagnostics instead.\n734|func (fold *chainFold) effectStopped(event Event, what string) error {\n735|\tcheckpointID, hasCheckpoint, err := payloadNullableDigest(event.Payload, \"checkpoint_id\")\n736|\tif err != nil {\n737|\t\treturn err\n738|\t}\n739|\tresumable, err := payloadBool(event.Payload, \"resumable\")\n740|\tif err != nil {\n741|\t\treturn err\n742|\t}\n743|\tclosure, err := payloadString(event.Payload, \"closure_kind\")\n744|\tif err != nil {\n745|\t\treturn err\n746|\t}\n747|\tif closure == \"checkpointed\" {\n748|\t\tif !hasCheckpoint || !resumable {\n749|\t\t\treturn refuse(ErrIntegrity, \"%s closes checkpointed without a resumable checkpoint\", what)\n750|\t\t}\n751|\t\tfold.noteCheckpoint(checkpointID, \"\", event.ID)\n752|\t\treturn fold.step(StateStopped, what)\n753|\t}\n754|\tif hasCheckpoint || resumable {\n755|\t\treturn refuse(ErrIntegrity, \"%s closes bootstrap_abort with a checkpoint or resumable set\", what)\n756|\t}\n757|\tif !fold.seenAbort {\n758|\t\treturn refuse(ErrInvalidTransition, \"%s closes bootstrap_abort with no authoritative abort event\", what)\n759|\t}\n760|\treturn fold.step(StateFailed, what)\n761|}\n762|\n763|// effectResumed moves to running under the resumed checkpoint and\n764|// records the terminal binding the resume selected.\n765|func (fold *chainFold) effectResumed(event Event, what string) error {\n766|\tcheckpointID, err := payloadString(event.Payload, \"checkpoint_id\")\n767|\tif err != nil {\n768|\t\treturn err\n769|\t}\n770|\tif _, err := scalar.ParseDigest(checkpointID); err != nil {\n771|\t\treturn refuse(ErrDerivation, \"%s carries malformed checkpoint_id: %v\", what, err)\n772|\t}\n773|\tfold.noteCheckpoint(checkpointID, \"\", event.ID)\n774|\tif event.SchemaVersion == \"4.0.0\" {\n775|\t\tbinding, err := payloadString(event.Payload, \"terminal_binding_id\")\n776|\t\tif err != nil {\n777|\t\t\treturn err\n778|\t\t}\n779|\t\tif _, err := scalar.ParseDigest(binding); err != nil {\n780|\t\t\treturn refuse(ErrDerivation, \"%s carries malformed terminal_binding_id: %v\", what, err)\n781|\t\t}\n782|\t\tbackend, err := payloadString(event.Payload, \"terminal_backend_id\")\n783|\t\tif err != nil {\n784|\t\t\treturn err\n785|\t\t}\n786|\t\tif _, err := terminalbackend.ParseID(backend); err != nil {\n787|\t\t\treturn refuse(ErrDerivation, \"%s carries refused terminal backend: %v\", what, err)\n788|\t\t}\n789|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, BindingID: binding, EventID: event.ID}\n790|\t} else {\n791|\t\tbackend, err := payloadString(event.Payload, \"terminal_backend\")\n792|\t\tif err != nil {\n793|\t\t\treturn err\n794|\t\t}\n795|\t\tif backend != \"tmux\" && backend != \"conpty\" {\n796|\t\t\treturn refuse(ErrDerivation, \"%s carries unknown terminal backend %q\", what, backend)\n797|\t\t}\n798|\t\tnativeID, err := payloadString(event.Payload, \"native_session_id\")\n799|\t\tif err != nil {\n800|\t\t\treturn err\n801|\t\t}\n802|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, NativeSessionID: nativeID, EventID: event.ID}\n803|\t}\n804|\tfold.projection.HasTerminal = true\n805|\treturn fold.step(StateRunning, what)\n806|}\n807|\n808|// effectBootstrapAborted records the authoritative abort and fails the\n809|// bootstrap. Only the creating session can abort its bootstrap; any\n810|// later abort is invalid_state_transition.\n811|func (fold *chainFold) effectBootstrapAborted(event Event, what string) error {\n812|\tfold.seenAbort = true\n813|\tif fold.state != \"\" && fold.state != StateCreating {\n814|\t\treturn refuse(ErrInvalidTransition, \"%s aborts a bootstrap past creating\", what)\n815|\t}\n816|\treturn fold.step(StateFailed, what)\n817|}\n818|\n819|// effectLease checks the successor-lease payload linkage: the payload\n820|// must name the predecessor the chain stands on and the envelope it\n821|// arrives under, else integrity_failure. The lifecycle move already\n822|// happened in successionMove; a lease event repeating the current\n823|// lease is a fact, not a transition.\n824|func (fold *chainFold) effectLease(event Event, lease LeaseHead, what string, succession bool) error {\n825|\tif !succession {\n826|\t\treturn nil\n827|\t}\n828|\tif event.Type == \"lease.transferred\" {\n829|\t\tpredecessor, err := payloadString(event.Payload, \"predecessor_lease_id\")\n830|\t\tif err != nil {\n831|\t\t\treturn err\n832|\t\t}\n833|\t\tif predecessor != fold.previous.LeaseID {\n834|\t\t\treturn refuse(ErrIntegrity, \"%s transfers from lease %s past chain head lease %s\", what, predecessor, fold.previous.LeaseID)\n835|\t\t}\n836|\t\tsuccessor, err := payloadString(event.Payload, \"new_lease_id\")\n837|\t\tif err != nil {\n838|\t\t\treturn err\n839|\t\t}\n840|\t\tif successor != lease.LeaseID {\n841|\t\t\treturn refuse(ErrIntegrity, \"%s transfers to lease %s outside its envelope lease %s\", what, successor, lease.LeaseID)\n842|\t\t}\n843|\t} else {\n844|\t\tsuccessor, err := payloadString(event.Payload, \"new_lease_id\")\n845|\t\tif err != nil {\n846|\t\t\treturn err\n847|\t\t}\n848|\t\tif successor != lease.LeaseID {\n849|\t\t\treturn refuse(ErrIntegrity, \"%s forces lease %s outside its envelope lease %s\", what, successor, lease.LeaseID)\n850|\t\t}\n851|\t}\n852|\treturn nil\n853|}\n854|\n855|// effectTaskBoardLaunched enforces the Section 5.2 repeat rule — the\n856|// event must repeat the winning creation lease and the Session\n857|// Record's provider and launch mode — then derives the payload's\n858|// running or idle state through the table.\n859|func (fold *chainFold) effectTaskBoardLaunched(event Event, what string) error {\n860|\tproviderID, err := payloadString(event.Payload, \"provider_id\")\n861|\tif err != nil {\n862|\t\treturn err\n863|\t}\n864|\tif providerID != fold.recordProvider {\n865|\t\treturn refuse(ErrIntegrity, \"%s repeats provider %q past record provider %q\", what, providerID, fold.recordProvider)\n866|\t}\n867|\tpayloadEpoch, err := payloadUint(event.Payload, \"lease_epoch\")\n868|\tif err != nil {\n869|\t\treturn err\n870|\t}\n871|\tpayloadLease, err := payloadString(event.Payload, \"lease_id\")\n872|\tif err != nil {\n873|\t\treturn err\n874|\t}\n875|\tif payloadEpoch != fold.createLease.Epoch || payloadLease != fold.createLease.LeaseID {\n876|\t\treturn refuse(ErrIntegrity, \"%s repeats creation lease (%d, %s) past create lease (%d, %s)\", what, payloadEpoch, payloadLease, fold.createLease.Epoch, fold.createLease.LeaseID)\n877|\t}\n878|\treported, err := payloadString(event.Payload, \"state\")\n879|\tif err != nil {\n880|\t\treturn err\n881|\t}\n882|\tif reported == string(StateRunning) {\n883|\t\treturn fold.step(StateRunning, what)\n884|\t}\n885|\treturn fold.step(StateIdle, what)\n886|}\n887|\n888|// noteCheckpoint records the newest validated checkpoint.\n889|func (fold *chainFold) noteCheckpoint(id, kind, eventID string) {\n890|\tfold.seenCheckpoint = true\n891|\tfold.projection.HasCheckpoint = true\n892|\tfold.projection.Newest = Checkpoint{ID: id, Kind: kind, EventID: eventID}\n893|}\n894|\n895|// resolveWinner selects the winning lease over the authoritative chain\n896|// leases and the union leases by the greatest (epoch, lease_id)\n897|// tuple. A same-epoch tie resolves to the bytewise-greater lease ID;\n898|// an off-chain union winner moves the reported winner but never\n899|// rewrites authoritative state; union leases that lose are reported\n900|// preserved-never-applied. With no union the chain head wins alone\n901|// and no conflict is recorded.\n902|func (fold *chainFold) resolveWinner(union []LeaseHead) error {\n903|\twinner := fold.current\n904|\tonChain := map[string]struct{}{}\n905|\tif fold.haveLease {\n906|\t\tonChain[fold.current.LeaseID] = struct{}{}\n907|\t}\n908|\tfor _, lease := range fold.chainLeases() {\n909|\t\tonChain[lease.LeaseID] = struct{}{}\n910|\t}\n911|\tbyEpoch := map[uint64]map[string]struct{}{}\n912|\tnote := func(lease LeaseHead) {\n913|\t\tif byEpoch[lease.Epoch] == nil {\n914|\t\t\tbyEpoch[lease.Epoch] = map[string]struct{}{}\n915|\t\t}\n916|\t\tbyEpoch[lease.Epoch][lease.LeaseID] = struct{}{}\n917|\t}\n918|\tfor _, lease := range fold.chainLeases() {\n919|\t\tnote(lease)\n920|\t}\n921|\toffChainWinner := false\n922|\tfor _, lease := range union {\n923|\t\tif lease.IsZero() {\n924|\t\t\treturn refuse(ErrInvalidEvent, \"union carries an empty lease head\")\n925|\t\t}\n926|\t\tif _, err := scalar.ParseUUIDv4(lease.LeaseID); err != nil {\n927|\t\t\treturn refuse(ErrInvalidEvent, \"union lease %q is not a UUIDv4: %v\", lease.LeaseID, err)\n928|\t\t}\n929|\t\tnote(lease)\n930|\t\tswitch Compare(lease, winner) {\n931|\t\tcase 1:\n932|\t\t\twinner = lease\n933|\t\t\tif _, ok := onChain[lease.LeaseID]; !ok {\n934|\t\t\t\toffChainWinner = true\n935|\t\t\t}\n936|\t\tcase -1:\n937|\t\t\tfold.conflict(ConflictLosingBranchPreserved, ResolveRulePreservedNeverApplied,\n938|\t\t\t\t\"union lease (%d, %s) loses to (%d, %s); its history stays preserved and never applies\",\n939|\t\t\t\tlease.Epoch, lease.LeaseID, winner.Epoch, winner.LeaseID)\n940|\t\tcase 0:\n941|\t\t\t// A duplicate union entry names the tuple already\n942|\t\t\t// selected: the winner and the off-chain flag stand.\n943|\t\t\t// Clearing here would drop a correctly recorded\n944|\t\t\t// union_supersedes_chain conflict (and its\n945|\t\t\t// divergent_history warning) on a repeated entry.\n946|\t\t}\n947|\t}\n948|\tepochs := make([]uint64, 0, len(byEpoch))\n949|\tfor epoch := range byEpoch {\n950|\t\tepochs = append(epochs, epoch)\n951|\t}\n952|\tsort.Slice(epochs, func(i, j int) bool { return epochs[i] < epochs[j] })\n953|\tfor _, epoch := range epochs {\n954|\t\trivals := byEpoch[epoch]\n955|\t\tif len(rivals) < 2 {\n956|\t\t\tcontinue\n957|\t\t}\n958|\t\tordered := make([]string, 0, len(rivals))\n959|\t\tfor id := range rivals {\n960|\t\t\tordered = append(ordered, id)\n961|\t\t}\n962|\t\tsort.Strings(ordered)\n963|\t\tfold.conflict(ConflictSameEpochTie, ResolveRuleGreatestLeaseIDWins,\n964|\t\t\t\"epoch %d is shared by leases %v; the bytewise-greater lease ID %s wins\",\n965|\t\t\tepoch, ordered, ordered[len(ordered)-1])\n966|\t}\n967|\tif offChainWinner {\n968|\t\tfold.conflict(ConflictUnionSupersedesChain, ResolveRuleAuthoritativeStateUnchanged,\n969|\t\t\t\"union winner (%d, %s) stands outside the authoritative chain; derived state is unchanged until an explicit takeover lands\",\n970|\t\t\twinner.Epoch, winner.LeaseID)\n971|\t}\n972|\tfold.projection.Winner = winner\n973|\treturn nil\n974|}\n975|\n976|// chainLeases replays the distinct envelope leases in first-appearance\n977|// order. Every succession appends, so a tie planted at any past epoch\n978|// still resolves against the lease the chain actually stood on. Gaps\n979|// were already recorded at succession time.\n980|func (fold *chainFold) chainLeases() []LeaseHead {\n981|\treturn append([]LeaseHead(nil), fold.leases...)\n982|}\n983|\n984|// applyLocalLease derives the local projection: the owner host of the\n985|// newest authoritative event decides the local role against the\n986|// caller-supplied host, and a local lease that lost the tuple rule\n987|// stales the projection exactly where the table lets it go stale.\n988|func (fold *chainFold) applyLocalLease(local LeaseHead, localHostID string) {\n989|\tif localHostID != \"\" && fold.projection.OwnerHostID != \"\" {\n990|\t\tif localHostID == fold.projection.OwnerHostID {\n991|\t\t\tfold.projection.LocalRole = \"owner\"\n992|\t\t} else {\n993|\t\t\tfold.projection.LocalRole = \"replica\"\n994|\t\t}\n995|\t}\n996|\tif local.IsZero() || !fold.haveLease {\n997|\t\treturn\n998|\t}\n999|\t// Only a lease that lost the tuple rule stales the projection:\n(more lines below)","final_result":true}}}
