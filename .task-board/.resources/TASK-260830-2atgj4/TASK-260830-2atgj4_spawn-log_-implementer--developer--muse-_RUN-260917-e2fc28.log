{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cab5","stream":{"kind":"session","id":"01a0ae38-1954-7242-9b52-ff7ca6c9b52f"},"sequence":949,"recorded_at":1780531400001893,"record_type":"event","durability":"durable","causation_id":"815552bd-492d-441d-89cf-fcae5a028cc4","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"815552bd-492d-441d-89cf-fcae5a028cc4","run_stream":{"kind":"run","id":"815552bd-492d-441d-89cf-fcae5a028cc4"},"call_id":"call_01a0ae3e91807709b864004d1c1180ed","text":"Read text file `internal/sessstate/fixtures_test.go`.\n(69 line(s) above)\n70|// through the production identity entry.\n71|func buildRecord(t *testing.T, mutate func(object map[string]any)) []byte {\n72|\tt.Helper()\n73|\tvar object map[string]any\n74|\tif err := json.Unmarshal([]byte(specRecordExample), &object); err != nil {\n75|\t\tt.Fatalf(\"unmarshal SPEC record example: %v\", err)\n76|\t}\n77|\tif mutate != nil {\n78|\t\tmutate(object)\n79|\t}\n80|\tobject[\"record_id\"] = zeroDigest\n81|\tstaged, err := json.Marshal(object)\n82|\tif err != nil {\n83|\t\tt.Fatalf(\"marshal staged record: %v\", err)\n84|\t}\n85|\tdigest, _, err := canonicaljson.CalculateObjectIdentity(staged)\n86|\tif err != nil {\n87|\t\tt.Fatalf(\"CalculateObjectIdentity(staged record) error = %v\", err)\n88|\t}\n89|\tobject[\"record_id\"] = digest.String()\n90|\tout, err := json.Marshal(object)\n91|\tif err != nil {\n92|\t\tt.Fatalf(\"marshal record: %v\", err)\n93|\t}\n94|\tif _, _, err := canonicaljson.VerifyObjectIdentity(out); err != nil {\n95|\t\tt.Fatalf(\"VerifyObjectIdentity(built record) error = %v\", err)\n96|\t}\n97|\treturn out\n98|}\n99|\n100|// eventOptions selects the envelope and payload of a built event.\n101|type eventOptions struct {\n102|\tsessionID     string\n103|\tpredecessors  []string\n104|\tepoch         uint64\n105|\tleaseID       string\n106|\tsequence      uint64\n107|\teventType     string\n108|\tpayload       map[string]any\n109|\tschemaVersion string\n110|}\n111|\n112|// buildEvent derives a valid Session Event, computing the canonical\n113|// digest through the production identity entry. The payload must carry\n114|// exactly the canonical owner's members for its type, so every vector\n115|// below doubles as a contract fixture.\n116|func buildEvent(t *testing.T, options eventOptions) []byte {\n117|\tt.Helper()\n118|\tversion := options.schemaVersion\n119|\tif version == \"\" {\n120|\t\tversion = \"1.0.0\"\n121|\t}\n122|\tobject := map[string]any{\n123|\t\t\"schema\": \"urn:ax:schema:session-event\", \"schema_version\": version,\n124|\t\t\"event_id\": zeroDigest, \"subject_id\": options.sessionID, \"session_id\": options.sessionID,\n125|\t\t\"event_type\": options.eventType, \"created_by_host_id\": testHostID,\n126|\t\t\"lease_epoch\": options.epoch, \"lease_id\": options.leaseID, \"lease_sequence\": options.sequence,\n127|\t\t\"predecessors\": options.predecessors, \"created_at\": testCreatedAt,\n128|\t\t\"payload\": options.payload, \"extensions\": map[string]any{},\n129|\t}\n130|\tstaged, err := json.Marshal(object)\n131|\tif err != nil {\n132|\t\tt.Fatalf(\"marshal staged event: %v\", err)\n133|\t}\n134|\tdigest, _, err := canonicaljson.CalculateObjectIdentity(staged)\n135|\tif err != nil {\n136|\t\tt.Fatalf(\"CalculateObjectIdentity(staged event %s) error = %v\", options.eventType, err)\n137|\t}\n138|\tobject[\"event_id\"] = digest.String()\n139|\tout, err := json.Marshal(object)\n140|\tif err != nil {\n141|\t\tt.Fatalf(\"marshal event: %v\", err)\n142|\t}\n143|\tif _, _, err := canonicaljson.VerifyObjectIdentity(out); err != nil {\n144|\t\tt.Fatalf(\"VerifyObjectIdentity(built event %s) error = %v\", options.eventType, err)\n145|\t}\n146|\treturn out\n147|}\n148|\n149|// mustDecodeEvent builds then decodes one event for direct Reduce\n150|// inputs, so the envelope under test is always canonical-exact.\n151|func mustDecodeEvent(t *testing.T, options eventOptions) (Event, []byte) {\n152|\tt.Helper()\n153|\traw := buildEvent(t, options)\n154|\tevent, err := DecodeEvent(raw)\n155|\tif err != nil {\n156|\t\tt.Fatalf(\"DecodeEvent(%s) error = %v\", options.eventType, err)\n157|\t}\n158|\treturn event, raw\n159|}\n160|\n161|// chainBuilder folds raw events with their decoded forms in lockstep,\n162|// tracking predecessors, and appends them to a repository on demand.\n163|type chainBuilder struct {\n164|\tt         *testing.T\n165|\trepo      *sessrepo.Repository\n166|\tsessionID string\n167|\trecordID  string\n168|\traws      [][]byte\n169|\tevents    []Event\n170|}\n171|\n172|func openRepo(t *testing.T) (*sessrepo.Repository, error) {\n173|\tt.Helper()\n174|\treturn sessrepo.Open(t.TempDir())\n175|}\n176|\n177|func createSession(t *testing.T, repository *sessrepo.Repository, record []byte) sessrepo.SessionRef {\n178|\tt.Helper()\n179|\treference, err := repository.CreateSession(record)\n180|\tif err != nil {\n181|\t\tt.Fatalf(\"CreateSession error = %v\", err)\n182|\t}\n183|\treturn reference\n184|}\n185|\n186|func openChain(t *testing.T, record []byte) *chainBuilder {\n187|\tt.Helper()\n188|\trepository, err := openRepo(t)\n189|\tif err != nil {\n190|\t\tt.Fatalf(\"sessrepo.Open error = %v\", err)\n191|\t}\n192|\treference := createSession(t, repository, record)\n193|\treturn &chainBuilder{t: t, repo: repository, sessionID: reference.SessionID, recordID: reference.RecordID}\n194|}\n195|\n196|func (builder *chainBuilder) append(options eventOptions) Event {\n197|\tbuilder.t.Helper()\n198|\toptions.sessionID = builder.sessionID\n199|\tif options.predecessors == nil {\n200|\t\tif len(builder.events) == 0 {\n201|\t\t\toptions.predecessors = []string{builder.recordID}\n202|\t\t} else {\n203|\t\t\toptions.predecessors = []string{builder.events[len(builder.events)-1].ID}\n204|\t\t}\n205|\t}\n206|\tevent, raw := mustDecodeEvent(builder.t, options)\n207|\tif _, err := builder.repo.AppendEvent(builder.sessionID, raw); err != nil {\n208|\t\tbuilder.t.Fatalf(\"AppendEvent(%s seq %d) error = %v\", options.eventType, options.sequence, err)\n209|\t}\n210|\tbuilder.raws = append(builder.raws, raw)\n211|\tbuilder.events = append(builder.events, event)\n212|\treturn event\n213|}\n214|\n215|// Payload builders. Each carries exactly the canonical owner's members\n216|// for its type and version.\n217|\n218|func createdPayload(recordID string) map[string]any {\n219|\treturn map[string]any{\"session_record_id\": recordID, \"bootstrap_operation_id\": testOpID, \"first_checkpoint_operation_id\": testOpIDB}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
