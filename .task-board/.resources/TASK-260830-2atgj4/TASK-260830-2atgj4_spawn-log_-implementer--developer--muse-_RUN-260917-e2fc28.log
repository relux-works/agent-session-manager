{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c969","stream":{"kind":"session","id":"01a0ae38-1954-7242-9b52-ff7ca6c9b52f"},"sequence":783,"recorded_at":1780531400001561,"record_type":"event","durability":"durable","causation_id":"815552bd-492d-441d-89cf-fcae5a028cc4","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"815552bd-492d-441d-89cf-fcae5a028cc4","run_stream":{"kind":"run","id":"815552bd-492d-441d-89cf-fcae5a028cc4"},"call_id":"call_01a0ae3c8f3174839e34adf0163aa0b4","text":"Read text file `internal/sessstate/winner_test.go`.\n(119 line(s) above)\n120|\t\tConflictSameEpochTie: true, ConflictLosingBranchPreserved: true,\n121|\t\tConflictUnionSupersedesChain: true,\n122|\t}\n123|\tif len(kinds) != len(want) {\n124|\t\tt.Fatalf(\"conflicts = %v, want the tie with its losing branch and off-chain winner\", kinds)\n125|\t}\n126|\tfor _, kind := range kinds {\n127|\t\tif !want[kind] {\n128|\t\t\tt.Fatalf(\"conflicts = %v, want the tie with its losing branch and off-chain winner\", kinds)\n129|\t\t}\n130|\t}\n131|}\n132|\n133|// TestWinnerResolutionGap requires an epoch jump in the authoritative\n134|// chain to keep the greatest tuple as winner while recording the gap\n135|// conflict: both sides are not individually valid (the jump skips the\n136|// predecessor-plus-one rule), so the named rule carries the healing\n137|// condition.\n138|func TestWinnerResolutionGap(t *testing.T) {\n139|\trecord := decodeTestRecord(t)\n140|\tspecs := append(baseBootstrap(record),\n141|\t\teventSpec{epoch: 3, leaseID: testLeaseIDB, typ: \"lease.transferred\", payload: transferredPayload(testLeaseID, testLeaseIDB)},\n142|\t)\n143|\tprojection, err := reduceSpecs(t, record, specs, Input{})\n144|\tif err != nil {\n145|\t\tt.Fatalf(\"Reduce error = %v\", err)\n146|\t}\n147|\tif projection.Winner != (LeaseHead{Epoch: 3, LeaseID: testLeaseIDB}) {\n148|\t\tt.Fatalf(\"winner = %+v, want epoch 3 lease B\", projection.Winner)\n149|\t}\n150|\tkinds := conflictKinds(projection)\n151|\tif len(kinds) != 1 || kinds[0] != ConflictEpochGap {\n152|\t\tt.Fatalf(\"conflicts = %v, want exactly [epoch_gap]\", kinds)\n153|\t}\n154|\tif projection.Conflicts[0].Rule != ResolveRuleGreatestTupleWins {\n155|\t\tt.Fatalf(\"rule = %q, want greatest-tuple-wins\", projection.Conflicts[0].Rule)\n156|\t}\n157|\tassertWarning(t, projection, \"divergent_history\")\n158|}\n159|\n160|// TestWinnerResolutionLosingBranchPreserved requires union leases that\n161|// lose the tuple comparison to be reported preserved-never-applied\n162|// while the chain winner stands. The rival shares the head epoch, so\n163|// its tie reports at epoch 2.\n164|func TestWinnerResolutionLosingBranchPreserved(t *testing.T) {\n165|\trecord := decodeTestRecord(t)\n166|\tspecs := append(baseBootstrap(record),\n167|\t\teventSpec{epoch: 2, leaseID: testLeaseIDB, typ: \"lease.transferred\", payload: transferredPayload(testLeaseID, testLeaseIDB)},\n168|\t)\n169|\tunion := []LeaseHead{{Epoch: 2, LeaseID: testLeaseIDR}}\n170|\tprojection, err := reduceSpecs(t, record, specs, Input{Union: union})\n171|\tif err != nil {\n172|\t\tt.Fatalf(\"Reduce error = %v\", err)\n173|\t}\n174|\tif projection.Winner != (LeaseHead{Epoch: 2, LeaseID: testLeaseIDB}) {\n175|\t\tt.Fatalf(\"winner = %+v, want epoch 2 lease B\", projection.Winner)\n176|\t}\n177|\tkinds := conflictKinds(projection)\n178|\tif len(kinds) != 2 || kinds[0] != ConflictLosingBranchPreserved || kinds[1] != ConflictSameEpochTie {\n179|\t\tt.Fatalf(\"conflicts = %v, want [losing_branch_preserved same_epoch_tie]\", kinds)\n180|\t}\n181|\tassertConflictDetailContains(t, projection, ConflictSameEpochTie, \"epoch 2 is shared\")\n182|}\n183|\n184|// TestWinnerResolutionUnionSupersedesChain requires an off-chain union\n185|// winner to move the reported winner without rewriting authoritative\n186|// state, under its named rule.\n187|func TestWinnerResolutionUnionSupersedesChain(t *testing.T) {\n188|\trecord := decodeTestRecord(t)\n189|\tspecs := baseBootstrap(record)\n190|\tunion := []LeaseHead{{Epoch: 2, LeaseID: testLeaseIDB}}\n191|\tprojection, err := reduceSpecs(t, record, specs, Input{Union: union})\n192|\tif err != nil {\n193|\t\tt.Fatalf(\"Reduce error = %v\", err)\n194|\t}\n195|\tif projection.Winner != (LeaseHead{Epoch: 2, LeaseID: testLeaseIDB}) {\n196|\t\tt.Fatalf(\"winner = %+v, want epoch 2 lease B\", projection.Winner)\n197|\t}\n198|\tif projection.State != StateRunning {\n199|\t\tt.Fatalf(\"state = %q, want running: authoritative state is unchanged\", projection.State)\n200|\t}\n201|\tkinds := conflictKinds(projection)\n202|\tif len(kinds) != 1 || kinds[0] != ConflictUnionSupersedesChain {\n203|\t\tt.Fatalf(\"conflicts = %v, want exactly [union_supersedes_chain]\", kinds)\n204|\t}\n205|\tif projection.Conflicts[0].Rule != ResolveRuleAuthoritativeStateUnchanged {\n206|\t\tt.Fatalf(\"rule = %q, want authoritative-state-unchanged\", projection.Conflicts[0].Rule)\n207|\t}\n208|}\n209|\n210|// TestWinnerResolutionPastEpochTie resolves a tie planted at a past\n211|// epoch against the lease the chain actually stood on: the union rival\n212|// at epoch 1 loses to the chain's epoch-2 head, and the epoch-1 tie is\n213|// still reported because two distinct leases shared it.\n214|func TestWinnerResolutionPastEpochTie(t *testing.T) {\n215|\trecord := decodeTestRecord(t)\n216|\tspecs := append(baseBootstrap(record),\n217|\t\teventSpec{epoch: 2, leaseID: testLeaseIDB, typ: \"lease.transferred\", payload: transferredPayload(testLeaseID, testLeaseIDB)},\n218|\t)\n219|\tunion := []LeaseHead{{Epoch: 1, LeaseID: testLeaseIDC}}\n220|\tprojection, err := reduceSpecs(t, record, specs, Input{Union: union})\n221|\tif err != nil {\n222|\t\tt.Fatalf(\"Reduce error = %v\", err)\n223|\t}\n224|\tif projection.Winner != (LeaseHead{Epoch: 2, LeaseID: testLeaseIDB}) {\n225|\t\tt.Fatalf(\"winner = %+v, want epoch 2 lease B\", projection.Winner)\n226|\t}\n227|\tkinds := conflictKinds(projection)\n228|\twant := map[string]bool{ConflictSameEpochTie: true, ConflictLosingBranchPreserved: true}\n229|\tif len(kinds) != 2 {\n230|\t\tt.Fatalf(\"conflicts = %v, want tie plus losing branch\", kinds)\n231|\t}\n232|\tfor _, kind := range kinds {\n233|\t\tif !want[kind] {\n234|\t\t\tt.Fatalf(\"conflicts = %v, want tie plus losing branch\", kinds)\n235|\t\t}\n236|\t}\n237|\tassertConflictDetailContains(t, projection, ConflictSameEpochTie, \"epoch 1 is shared\")\n238|}\n239|\n240|// TestProviderMismatchKeepsRecordPinned requires a launch under a\n241|// foreign provider to record the named conflict while the record\n242|// provider stays authoritative.\n243|func TestProviderMismatchKeepsRecordPinned(t *testing.T) {\n244|\trecord := decodeTestRecord(t)\n245|\tspecs := []eventSpec{\n246|\t\t{typ: \"session.created\", payload: createdPayload(record.RecordID)},\n247|\t\t{typ: \"provider.launched\", payload: launchedPayload(\"qwen\")},\n248|\t}\n249|\tprojection, err := reduceSpecs(t, record, specs, Input{})\n250|\tif err != nil {\n251|\t\tt.Fatalf(\"Reduce error = %v\", err)\n252|\t}\n253|\tif projection.State != StateRunning {\n254|\t\tt.Fatalf(\"state = %q, want running\", projection.State)\n255|\t}\n256|\tif projection.Provider.ID != \"codex\" {\n257|\t\tt.Fatalf(\"provider = %q, want record-pinned codex\", projection.Provider.ID)\n258|\t}\n259|\tif projection.Provider.Version != \"\" {\n260|\t\tt.Fatalf(\"provider version = %q, want empty: a mismatching launch contributes no version\", projection.Provider.Version)\n261|\t}\n262|\tkinds := conflictKinds(projection)\n263|\tif len(kinds) != 1 || kinds[0] != ConflictProviderMismatch {\n264|\t\tt.Fatalf(\"conflicts = %v, want exactly [provider_mismatch]\", kinds)\n265|\t}\n266|\tif projection.Conflicts[0].Rule != ResolveRuleRecordPinnedProviderWins {\n267|\t\tt.Fatalf(\"rule = %q, want record-pinned-provider-wins\", projection.Conflicts[0].Rule)\n268|\t}\n269|}\n270|\n271|// TestWinnerResolutionDuplicateOffChainUnionKeepsConflict requires a\n272|// repeated off-chain union entry to leave the resolution unchanged: the\n273|// winner stands, the union_supersedes_chain conflict stays recorded,\n274|// and the divergent_history warning stays raised. Clearing the\n275|// off-chain flag on the duplicate silently drops both.\n276|func TestWinnerResolutionDuplicateOffChainUnionKeepsConflict(t *testing.T) {\n277|\trecord := decodeTestRecord(t)\n278|\tspecs := baseBootstrap(record)\n279|\tonce, err := reduceSpecs(t, record, specs, Input{Union: []LeaseHead{{Epoch: 3, LeaseID: testLeaseIDC}}})\n280|\tif err != nil {\n281|\t\tt.Fatalf(\"Reduce error = %v\", err)\n282|\t}\n283|\tif kinds := conflictKinds(once); len(kinds) != 1 || kinds[0] != ConflictUnionSupersedesChain {\n284|\t\tt.Fatalf(\"conflicts = %v, want exactly [union_supersedes_chain]\", kinds)\n285|\t}\n286|\ttwice, err := reduceSpecs(t, record, specs, Input{Union: []LeaseHead{\n287|\t\t{Epoch: 3, LeaseID: testLeaseIDC},\n288|\t\t{Epoch: 3, LeaseID: testLeaseIDC},\n289|\t}})\n290|\tif err != nil {\n291|\t\tt.Fatalf(\"Reduce error = %v\", err)\n292|\t}\n293|\tif twice.Winner != once.Winner {\n294|\t\tt.Fatalf(\"winner = %+v, want the single-entry winner %+v\", twice.Winner, once.Winner)\n295|\t}\n296|\tif kinds := conflictKinds(twice); len(kinds) != 1 || kinds[0] != ConflictUnionSupersedesChain {\n297|\t\tt.Fatalf(\"conflicts = %v, want exactly [union_supersedes_chain]\", kinds)\n298|\t}\n299|\tassertWarning(t, twice, \"divergent_history\")\n300|}\n301|\n302|// TestWinnerResolutionRepeatedOffChainUnionStaysResolved goes one step\n303|// past the duplicate: three copies plus a losing branch, in both\n304|// orders, still resolve to the same winner with the losing branch, the\n305|// epoch-1 tie, and the off-chain winner all reported.\n306|func TestWinnerResolutionRepeatedOffChainUnionStaysResolved(t *testing.T) {\n307|\trecord := decodeTestRecord(t)\n308|\tspecs := baseBootstrap(record)\n309|\tunions := map[string][]LeaseHead{\n31