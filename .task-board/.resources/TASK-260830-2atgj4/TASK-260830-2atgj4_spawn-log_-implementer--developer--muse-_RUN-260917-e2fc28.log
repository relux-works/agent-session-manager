{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c965","stream":{"kind":"session","id":"01a0ae38-1954-7242-9b52-ff7ca6c9b52f"},"sequence":781,"recorded_at":1780531400001557,"record_type":"event","durability":"durable","causation_id":"815552bd-492d-441d-89cf-fcae5a028cc4","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"815552bd-492d-441d-89cf-fcae5a028cc4","run_stream":{"kind":"run","id":"815552bd-492d-441d-89cf-fcae5a028cc4"},"task_stream":{"kind":"task","id":"01a0ae3c-97e3-7542-b077-51dc654abc19"},"task_id":"01a0ae3c-97e3-7542-b077-51dc654abc19","event":{"kind":"output","task_id":"01a0ae3c-97e3-7542-b077-51dc654abc19","chunk":"{\n  \"chunk_id\": \"exec-25-1\",\n  \"command\": \"grep -n \\\"Union:\\\" -B6 -A25 internal/fencing/scenarios_test.go | head -n 80; echo ===ARMS===; grep -n \\\"Union:\\\" -B4 -A12 internal/sessstate/arms_test.go internal/sessstate/project_test.go internal/sessquery/rev11_regression_test.go | head -n 80\",\n  \"description\": \"Read union usages in landed tests\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"175-\\t\\t\\tt.Fatalf(\\\"Project(chain) error = %v\\\", err)\\n176-\\t\\t}\\n177-\\t\\tif plain.State != sessstate.StateIdle {\\n178-\\t\\t\\tt.Fatalf(\\\"chain projection state = %s, want idle\\\", plain.State)\\n179-\\t\\t}\\n180-\\t\\tunion := []sessstate.LeaseHead{{Epoch: 2, LeaseID: fenceLeaseA}, {Epoch: 1, LeaseID: fenceLeaseOld}}\\n181:\\t\\twithUnion, err := (&sessstate.Projector{Repo: repoOld, Union: union}).Project(fenceSessionA)\\n182-\\t\\tif err != nil {\\n183-\\t\\t\\tt.Fatalf(\\\"Project(union) error = %v\\\", err)\\n184-\\t\\t}\\n185-\\t\\tif withUnion.Winner.Epoch != 2 || withUnion.Winner.LeaseID != fenceLeaseA {\\n186-\\t\\t\\tt.Fatalf(\\\"union winner = %+v, want the force lease\\\", withUnion.Winner)\\n187-\\t\\t}\\n188-\\t\\tif withUnion.State != sessstate.StateIdle {\\n189-\\t\\t\\tt.Fatalf(\\\"union projection state = %s, want idle: authoritative state must stand\\\", withUnion.State)\\n190-\\t\\t}\\n191:\\t\\tstaleView, err := (&sessstate.Projector{Repo: repoOld, Union: union, Local: sessstate.LeaseHead{Epoch: 1, LeaseID: fenceLeaseOld}, LocalHostID: fenceHostA}).Project(fenceSessionA)\\n192-\\t\\tif err != nil {\\n193-\\t\\t\\tt.Fatalf(\\\"Project(union+local) error = %v\\\", err)\\n194-\\t\\t}\\n195-\\t\\tif staleView.State != sessstate.StateStale {\\n196-\\t\\t\\tt.Fatalf(\\\"old-owner projection state = %s, want stale\\\", staleView.State)\\n197-\\t\\t}\\n198-\\t\\tassertConflict(t, staleView, sessstate.ConflictLosingBranchPreserved)\\n199-\\t\\tassertConflict(t, staleView, sessstate.ConflictUnionSupersedesChain)\\n200-\\t})\\n201-}\\n202-\\n203-func assertConflict(t *testing.T, projection sessstate.Projection, kind string) {\\n204-\\tt.Helper()\\n205-\\tfor _, conflict := range projection.Conflicts {\\n206-\\t\\tif conflict.Kind == kind {\\n207-\\t\\t\\treturn\\n208-\\t\\t}\\n209-\\t}\\n210-\\tt.Fatalf(\\\"projection conflicts %v lack %s\\\", projection.Conflicts, kind)\\n211-}\\n212-\\n213-// TestConcurrentForceTakeoversDeterministicWinner drives the\\n214-// concurrent-takeover row: two force leases at the same epoch from\\n215-// one base resolve to the bytewise-greater lease ID in either union\\n216-// order under both tuple rules, the winner authorizes, and the loser\\n===ARMS===\\ninternal/sessstate/arms_test.go-292-\\t\\t{typ: \\\"session.created\\\", payload: createdPayload(record.RecordID)},\\ninternal/sessstate/arms_test.go-293-\\t\\t{typ: \\\"provider.launched\\\", payload: launchedPayload(\\\"codex\\\")},\\ninternal/sessstate/arms_test.go-294-\\t}\\ninternal/sessstate/arms_test.go-295-\\tt.Run(\\\"empty lease head\\\", func(t *testing.T) {\\ninternal/sessstate/arms_test.go:296:\\t\\t_, err := reduceSpecs(t, record, specs, Input{Union: []LeaseHead{{}}})\\ninternal/sessstate/arms_test.go-297-\\t\\tmustErrorIs(t, err, ErrInvalidEvent, \\\"Reduce(union empty lease)\\\")\\ninternal/sessstate/arms_test.go-298-\\t})\\ninternal/sessstate/arms_test.go-299-\\tt.Run(\\\"malformed lease id\\\", func(t *testing.T) {\\ninternal/sessstate/arms_test.go:300:\\t\\t_, err := reduceSpecs(t, record, specs, Input{Union: []LeaseHead{{Epoch: 1, LeaseID: \\\"nope\\\"}}})\\ninternal/sessstate/arms_test.go-301-\\t\\tmustErrorIs(t, err, ErrInvalidEvent, \\\"Reduce(union malformed lease)\\\")\\ninternal/sessstate/arms_test.go-302-\\t})\\ninternal/sessstate/arms_test.go-303-}\\ninternal/sessstate/arms_test.go-304-\\ninternal/sessstate/arms_test.go-305-// TestReduceEmptyChainValidatesUnion requires the empty-chain path to\\ninternal/sessstate/arms_test.go-306-// validate the union through the same resolveWinner arms: a malformed\\ninternal/sessstate/arms_test.go-307-// union refuses exactly as on a non-empty chain, while a well-formed\\ninternal/sessstate/arms_test.go-308-// union moves only the reported winner and leaves state creating.\\ninternal/sessstate/arms_test.go-309-func TestReduceEmptyChainValidatesUnion(t *testing.T) {\\ninternal/sessstate/arms_test.go-310-\\trecord := decodeTestRecord(t)\\ninternal/sessstate/arms_test.go-311-\\tt.Run(\\\"empty lease head\\\", func(t *testing.T) {\\ninternal/sessstate/arms_test.go:312:\\t\\t_, err := Reduce(Input{Record: record, Union: []LeaseHead{{Epoch: 4, LeaseID: \\\"not-a-uuid\\\"}, {}}})\\ninternal/sessstate/arms_test.go-313-\\t\\tmustErrorIs(t, err, ErrInvalidEvent, \\\"Reduce(empty chain malformed union)\\\")\\ninternal/sessstate/arms_test.go-314-\\t})\\ninternal/sessstate/arms_test.go-315-\\tt.Run(\\\"malformed lease id\\\", func(t *testing.T) {\\ninternal/sessstate/arms_test.go:316:\\t\\t_, err := Reduce(Input{Record: record, Union: []LeaseHead{{Epoch: 1, LeaseID: \\\"nope\\\"}}})\\ninternal/sessstate/arms_test.go-317-\\t\\tmustErrorIs(t, err, ErrInvalidEvent, \\\"Reduce(empty chain malformed union)\\\")\\ninternal/sessstate/arms_test.go-318-\\t})\\ninternal/sessstate/arms_test.go-319-\\t