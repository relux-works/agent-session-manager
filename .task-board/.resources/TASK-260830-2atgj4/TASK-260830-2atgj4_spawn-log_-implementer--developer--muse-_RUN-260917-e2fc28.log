osed(\",\n314|\t\t\"func TestRunReportsExactCoverageAndFailsClosedWithoutOwnership(\",\n315|\t)\n316|\n317|\t_, err := VerifyRepository(repository)\n318|\twant := \"acceptance case \\\"ci-entrypoint\\\" test owner: declaration \\\"TestRunReportsExactCoverageAndFailsClosed\\\" is absent from \\\"internal/traceability/cmd/tracecheck/main_test.go\\\"\"\n319|\tif err == nil || !errors.Is(err, ErrTraceability) || !strings.Contains(err.Error(), want) {\n320|\t\tt.Fatalf(\"VerifyRepository() error = %v, want ErrTraceability containing %q\", err, want)\n321|\t}\n322|}\n323|\n324|func TestSourceCheckerAcceptsNativeFuzzAndRejectsNonExecutableHelpers(t *testing.T) {\n325|\tt.Parallel()\n326|\n327|\trepository := fstest.MapFS{\n328|\t\t\"boundary_test.go\": &fstest.MapFile{Data: []byte(`package boundary\n329|\n330|import \"testing\"\n331|\n332|func FuzzBoundary(f *testing.F) {}\n333|func Fuzzhelper(f *testing.F) {}\n334|func BenchmarkBoundary(b *testing.B) {}\n335|`)},\n336|\t}\n337|\tchecker := newSourceChecker(repository)\n338|\tif err := checker.verify(codeReference{Path: \"boundary_test.go\", Declaration: \"FuzzBoundary\"}, true); err != nil {\n339|\t\tt.Fatalf(\"native fuzz reference refused: %v\", err)\n340|\t}\n341|\tfor _, declaration := range []string{\"Fuzzhelper\", \"BenchmarkBoundary\"} {\n342|\t\terr := checker.verify(codeReference{Path: \"boundary_test.go\", Declaration: declaration}, true)\n343|\t\tif err == nil || !strings.Contains(err.Error(), \"not an executable Go test reference\") {\n344|\t\t\tt.Errorf(\"sourceChecker.verify(%s) error = %v, want executable-test refusal\", declaration, err)\n345|\t\t}\n346|\t}\n347|}\n348|\n349|func TestVerifyRepositoryRejectsAbsentAcceptanceProductionDeclaration(t *testing.T) {\n350|\tt.Parallel()\n351|\n352|\trepository := repositorySnapshot(t)\n353|\treplaceRepositorySourceOnce(\n354|\t\tt,\n355|\t\trepository,\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
