_test.go:200:\\t\\tevent := handEvent(t, record, []string{record.RecordID}, 1, testLeaseID, 1, \\\"session.stopped\\\", stoppedPayload(), \\\"\\\")\\ninternal/sessstate/arms_test.go:205:\\t\\tevent := handEvent(t, record, []string{record.RecordID}, 1, testLeaseID, 1, \\\"checkpoint.created\\\", checkpointPayload(), \\\"\\\")\\ninternal/sessstate/arms_test.go:227:\\t\\tevent := handEvent(t, record, []string{tail}, 1, testLeaseID, next, eventType, payload, version)\\ninternal/sessstate/arms_test.go:245:\\t\\t{\\\"uint absent\\\", \\\"task_board.launched\\\", taskBoardLaunchedPayload(\\\"running\\\", 1, testLeaseID), \\\"\\\", deletePayloadMember(\\\"lease_epoch\\\")},\\ninternal/sessstate/arms_test.go:246:\\t\\t{\\\"uint not uint\\\", \\\"task_board.launched\\\", taskBoardLaunchedPayload(\\\"running\\\", 1, testLeaseID), \\\"\\\", setPayloadMember(\\\"lease_epoch\\\", 0)},\\ninternal/sessstate/arms_test.go:268:\\t\\t\\t\\tevent := handEvent(t, record, []string{createdTail}, 1, testLeaseID, 2, tc.eventType, tc.payload, tc.version)\\ninternal/sessstate/arms_test.go:320:\\t\\tprojection, err := Reduce(Input{Record: record, Union: []LeaseHead{{Epoch: 3, LeaseID: testLeaseIDC}}})\\ninternal/sessstate/arms_test.go:327:\\t\\tif projection.Winner != (LeaseHead{Epoch: 3, LeaseID: testLeaseIDC}) {\\ninternal/sessstate/census_state_test.go:237:\\ttransferred := eventSpec{epoch: 2, leaseID: testLeaseIDB, typ: \\\"lease.transferred\\\", payload: transferredPayload(testLeaseID, testLeaseIDB)}\\ninternal/sessstate/census_state_test.go:247:\\t\\t\\t{epoch: 2, leaseID: testLeaseIDB, typ: \\\"session.parked\\\", payload: parkedPayload(testLeaseIDB)}},\\ninternal/sessstate/census_state_test.go:250:\\t\\t\\t{epoch: 2, leaseID: testLeaseIDB, typ: \\\"lease.forced\\\", payload: forcedPayload(testLeaseIDB, 1)}},\\ninternal/sessstate/fixtures_test.go:22:\\ttestLeaseID    = \\\"aaaaaaaa-bbbb-4ccc-8ddd-eeeeeeeeeeee\\\"\\ninternal/sessstate/fixtures_test.go:23:\\ttestLeaseIDB   = \\\"bbbbbbbb-c