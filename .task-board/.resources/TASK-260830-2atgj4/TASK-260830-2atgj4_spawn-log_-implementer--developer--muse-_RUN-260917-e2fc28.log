\\n    \\\"lease-divergent-preservation\\\",\\n    \\\"lease-union-resolution\\\"\\n   ]\\n  },\\n  {\\n   \\\"id\\\": \\\"5.3#7\\\",\\n   \\\"line\\\": 1968,\\n   \\\"excerpt\\\": \\\"be preserved in a divergent branch and MUST NOT affect authoritative st\\n====\\n{\\n \\\"kind\\\": \\\"section_binding\\\",\\n \\\"keys\\\": [\\n  \\\"section:15.3\\\"\\n ],\\n \\\"production\\\": {\\n  \\\"path\\\": \\\"internal/axerror/registry.go\\\",\\n  \\\"declaration\\\": \\\"ExitCodeFor\\\"\\n },\\n \\\"acceptance_cases\\\": [\\n  \\\"structured-error-code-exit-registry\\\",\\n  \\\"structured-error-unknown-code-reader\\\",\\n  \\\"structured-error-typed-details\\\",\\n  \\\"cli-result-historical-envelopes\\\",\\n  \\\"structured-error-exit-status-fan-in\\\"\\n ],\\n \\\"coverage\\\": \\\"partial\\\",\\n \\\"gap\\\": \\\"Clause 15.3#3 additionally forbids Structured Error from appearing as an RPC hello key or a TerminalBackend capability, and ExitCodeFor resolves a code-to-exit mapping rather than building either advertisement. No RPC hello frame is built anywhere in this repository, and the closed 16-capability admission registry in internal/terminalbackend is never advertised on an RPC hello path and carries no Structured Error code, so Section 15.3 keeps that clause unimplemented.\\\",\\n \\\"clauses\\\": [\\n  {\\n   \\\"id\\\": \\\"15.3#1\\\",\\n   \\\"line\\\": 14860,\\n   \\\"excerpt\\\": \\\"unknown code retains the envelope's exit class and MUST NOT be interpreted as\\\",\\n   \\\"acceptance_cases\\\": [\\n    \\\"structured-error-unknown-code-reader\\\",\\n    \\\"cli-result-historical-envelopes\\\"\\n   ]\\n  },\\n  {\\n   \\\"id\\\": \\\"15.3#2\\\",\\n   \\\"line\\\": 14872,\\n   \\\"excerpt\\\": \\\"continues to use <code>interactive_choice_required</code>. Implementations MUST\\\",\\n   \\\"acceptance_cases\\\": [\\n    \\\"structured-error-code-exit-registry\\\",\\n    \\\"structured-error-typed-details\\\"\\n   ]\\n  }\\n ]\\n}\\n====\\n{\\n \\\"kind\\\": \\\"