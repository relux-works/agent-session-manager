{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ce5f","stream":{"kind":"session","id":"01a0ae38-1954-7242-9b52-ff7ca6c9b52f"},"sequence":1418,"recorded_at":1780531400002831,"record_type":"event","durability":"durable","causation_id":"815552bd-492d-441d-89cf-fcae5a028cc4","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"815552bd-492d-441d-89cf-fcae5a028cc4","run_stream":{"kind":"run","id":"815552bd-492d-441d-89cf-fcae5a028cc4"},"call_id":"call_01a0ae42f210768ba65ef9eebcc117f7","text":"edited\nchanged lines: lines 158-168\n--- original\n+++ updated\n@@\n-\t\tif shift == 0 {\n-\t\t\tcontinue\n-\t\t}\n-\t\t// Identity must vary (or the shift proved nothing) while\n-\t\t// authority stays put (asserted above).\n-\t\tfor i, summary := range summaries {\n-\t\t\tif summary.RecordID == baselineDigests[i] && stamp != propClockShifts[0] {\n-\t\t\t\tt.Fatalf(\"shift %q lease %d digest %s equals the baseline digest; the shift is vacuous\", stamp, i, summary.RecordID)\n-\t\t\t}\n-\t\t}\n-\t}\n+\t\tfor _, summary := range summaries {\n+\t\t\tdigestsByShift[shift] = append(digestsByShift[shift], summary.RecordID)\n+\t\t}\n+\t\tif shift == 0 {\n+\t\t\tcontinue\n+\t\t}\n+\t\t// Identity must vary across differing stamps (or the shift\n+\t\t// proved nothing) while authority stays put (asserted\n+\t\t// above); equal stamps must digest identically.\n+\t\tfor i, summary := range summaries {\n+\t\t\tsameBytes := stamp == propClockShifts[0]\n+\t\t\tif (summary.RecordID == baselineDigests[i]) != sameBytes {\n+\t\t\t\tt.Fatalf(\"shift %q lease %d digest %s: identity-vary = %v, want %v\",\n+\t\t\t\t\tstamp, i, summary.RecordID, summary.RecordID != baselineDigests[i], !sameBytes)\n+\t\t\t}\n+\t\t}\n+\t}\n+\tif !reflect.DeepEqual(digestsByShift[1], digestsByShift[2]) {\n+\t\tt.Fatalf(\"equal-stamp shifts digest %+v vs %+v, want identical content identity\",\n+\t\t\tdigestsByShift[1], digestsByShift[2])\n+\t}\n","edit_facts":{"tool