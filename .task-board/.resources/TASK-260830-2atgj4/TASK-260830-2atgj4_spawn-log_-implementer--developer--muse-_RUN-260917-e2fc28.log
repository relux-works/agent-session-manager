ons/checkout@v7\\n243:        uses: actions/setup-go@v7\\n256:        run: |\\n271:        run: |\\n291:        run: |\\n303:        uses: actions/checkout@v7\\n306:        uses: actions/setup-go@v7\\n323:        run: |\\n340:        uses: actions/checkout@v7\\n343:        uses: actions/setup-go@v7\\n351:        run: GOOS=windows go build ./...\\n354:        run: GOOS=windows go vet ./...\\n373:        run: |\\n===CONFIG===\\n{\\n \\\"mode\\\": \\\"local\\\",\\n \\\"local\\\": {\\n  \\\"board_dir\\\": \\\".task-board\\\"\\n },\\n \\\"version_control\\\": {\\n  \\\"confirm\\\": true,\\n  \\\"desired_commit_time\\\": \\\"current real time; AX does not backdate commits\\\"\\n },\\n \\\"spawn\\\": {\\n  \\\"enabled\\\": true,\\n  \\\"max_parallel\\\": 20,\\n  \\\"ceilings\\\": {\\n   \\\"contract_version\\\": \\\"spawn-policy-v4\\\",\\n   \\\"codex\\\": {\\n    \\\"entries\\\": [\\n     {\\n      \\\"criterion\\\": \\\"equal\\\",\\n      \\\"model\\\": \\\"gpt-6-astra\\\",\\n      \\\"reasoning_effort\\\": \\\"medium\\\"\\n     },\\n     {\\n      \\\"criterion\\\": \\\"equal\\\",\\n      \\\"model\\\": \\\"gpt-6-astra\\\",\\n      \\\"reasoning_effort\\\": \\\"high\\\"\\n     }\\n    ],\\n    \\\"resolution_model\\\": \\\"gpt-6-astra\\\",\\n    \\\"adjustment_confirmation\\\": \\\"none\\\",\\n    \\\"fast_mode\\\": true,\\n    \\\"roles\\\": {\\n     \\\"reviewer\\\": {\\n      \\\"entries\\\": [\\n       {\\n        \\\"criterion\\\": \\\"equal\\\",\\n        \\\"model\\\": \\\"gpt-6-astra\\\",\\n        \\\"reasoning_effort\\\": \\\"low\\\"\\n       },\\n       {\\n        \\\"criterion\\\": \\\"equal\\\",\\n        \\\"model\\\": \\\"gpt-6-astra\\\",\\n        \\\"reasoning_effort\\\": \\\"medium\\\"\\n       }\\n      ],\\n      \\\"resolution_model\\\": \\\"gpt-6-astra\\\",\\n      \\\"adjustment_confirmation\\\": \\\"none\\\",\\n      \\\"default_model\\\": \\\"gpt-6-astra\\\",\\n      \\\"default_reasoning_effort\\\": \\\"low\\\"\\n     },\\n     \\\"developer\\\": {\\n      \\\"entries\\\": [\\n       {\\n        \\\"criterion\\\": \\\"equal\\\",\\n        \\\"model\\\": \\\"gpt-6-astra\\\",\\n        \\\"reasoning_effort\\\": \\\"medium\\\"\\n       },\\n       {\\n        \\\"criterion\\\": \\\"equal\\\",\\n        \\\"model\\\": \\\"gpt-6-astra\\\",\\n        \\\"reasoning_effort\\\": \\\"high\\\"\\n       },\\n       {\\n        \\\"criterion\\\": \\\"equal\\\",\\n        \\\"model\\\": \\\"gpt-5.6-luna\\\",\\n        \\\"reasoning_effort\\\": \\\"max\\\"\\n       }\\n      ],\\n      \\\"resolution_model\\\": \\\"gpt-6-astra\\\",\\n      \\\"adjustment_confirmation\\\": \\\"none\\\"\\n     }\\n    }\\n   },\\n   \\\"claude\\\": {\\n    \\\"entries\\\": [\\n     {\\n      \\\"criterion\\\": \\\"equal\\\",\\n      \\\"model\\\": \\\"claude-opus-5\\\",\\n      \\\"reasoning_effort\\\": \\\"xhigh\\\"\\n     }\\n    ],\\n    \\\"resolution_model\\\": \\\"claude-opus-5\\\",\\n    \\\"adjustment_confirmation\\\": \\\"none\\\"\\n   },\\n   \\\"muse\\\": {\\n    \\\"entries\\\": [\\n     {\\n      \\\"criterion\\\": \\\"equal\\\",\\n      \\\"model\\\": \\\"muse-spark\\\",\\n      \\\"reasoning_effort\\\": \\\"max\\\"\\n     },\\n     {\\n      \\\"criterion\\\": \\\"equal\\\",\\n      \\\"model\\\": \\\"muse-spark\\\",\\n      \\\"reasoning_effort\\\": \\\"xhigh\\\"\\n     }\\n    ],\\n    \\\"resolution_model\\\": \\\"muse-spark\\\",\\n    \\\"adjustment_confirmation\\\": \\\"none\\\"\\n   }\\n  },\\n  \\\"preferred_agentic_system\\\": {\\n   \\\"mixed\\\": [\\n    \\\"muse\\\",\\n    \\\"codex\\\"\\n   ]\\n  },\\n  \\\"workload_classes\\\": {\\n   \\\"unified\\\": [\\n    {\\n     \\\"runtime\\\": \\\"muse\\\",\\n     \\\"model\\\": \\\"muse-spark\\\",\\n     \\\"reasoning_effort\\\": \\\"max\\\"\\n    },\\n    {\\n     \\\"runtime\\\": \\\"codex\\\",\\n     \\\"model\\\": \\\"gpt-5.6-luna\\\",\\n     \\\"reasoning_effort\\\": \\\"max\\\"\\n    },\\n    {\\n     \\\"runtime\\\": \\\"muse\\\",\\n     \\\"model\\\": \\\"muse-spark\\\",\\n     \\\"reasoning_effort\\\": \\\"xhigh\\\"\\n    },\\n    {\\n     \\\"runtime\\\": \\\"codex\\\",\\n     \\\"model\\\": \\\"gpt-6-astra\\\",\\n     \\\"reasoning_effort\\\": \\\"high\\\"\\n    },\\n    {\\n     \\\"runtime\\\": \\\"codex\\\",\\n     \\\"model\\\": \\\"gpt-6-astra\\\",\\n     \\\"reasoning_effort\\\": \\\"medium\\\"\\n    }\\n   ],\\n   \\\"architecture\\\": [\\n    {\\n     \\\"runtime\\\": \\\"codex\\\",\\n     \\\"model\\\": \\\"gpt-6-astra\\\",\\n     \\\"reasoning_effort\\\": \\\"high\\\"\\n    },\\n    {\\n     \\\"runtime\\\": \\\"codex\\\",\\n     \\\"model\\\": \\\"gpt-6-astra\\\",\\n     \\\"reasoning_effort\\\": \\\"mediu\\n\",\n  \"original_output_bytes\": 4183,\n  \"original_output_tokens\": 1046,\n  \"truncated\": false\n}","final_result":true}}}
