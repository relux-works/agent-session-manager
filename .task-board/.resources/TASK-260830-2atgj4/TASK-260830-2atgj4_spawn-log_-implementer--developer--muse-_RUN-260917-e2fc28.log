ins(gap, declaration) {\\n1013:\\t\\treturn fmt.Errorf(\\\"gap does not name the production declaration %q the binding is registered to\\\", declaration)\\n1020:// \\\"6.5\\\" and \\\"13.15\\\" as a mention of \\\"13.1\\\", which would let a gap about one\\n1047:// sectionDisplayName is how a gap sentence has to name the section it is about.\\n1223:\\t// Every level below full owes a gap, coverageUnmeasured included. Before\\n1224:\\t// this the gate refused a gap on the unmeasured bucket, so the bindings with\\n1230:\\t\\t\\treturn sectionCoverage{}, fail(\\\"section binding %q claims %s coverage and still names a gap\\\", key, measured)\\n1262:// the generated catalog requires an owner for, and must state a gap and the\\n1293:\\t\\t// the gap is checked for length and a whole-identifier section mention\\n1299:\\t\\t\\treturn nil, fail(\\\"unowned section %q states no evidence for its gap\\\", entry.Key)\\n\",\n  \"original_output_bytes\": 1794,\n  \"original_output_tokens\": 449,\n  \"truncated\": false\n}","final_result":true}}}
