{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c751","stream":{"kind":"session","id":"01a0ae38-1954-7242-9b52-ff7ca6c9b52f"},"sequence":515,"recorded_at":1780531400001025,"record_type":"event","durability":"durable","causation_id":"815552bd-492d-441d-89cf-fcae5a028cc4","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"815552bd-492d-441d-89cf-fcae5a028cc4","run_stream":{"kind":"run","id":"815552bd-492d-441d-89cf-fcae5a028cc4"},"task_stream":{"kind":"task","id":"01a0ae3b-d5f6-76b3-ad29-80af031b1f34"},"task_id":"01a0ae3b-d5f6-76b3-ad29-80af031b1f34","event":{"kind":"output","task_id":"01a0ae3b-d5f6-76b3-ad29-80af031b1f34","chunk":"Read text file `internal/sessrepo/lease_store.go`.\n(499 line(s) above)\n500|// scanLeaseBlobs collects and orders the verified lease summaries. Every\n501|// failure is a plain error; loadLeasesLocked attributes it through its one\n502|// refusal site.\n503|func scanLeaseBlobs(directory, sessionID string) ([]LeaseSummary, error) {\n504|\tentries, err := os.ReadDir(filepath.Join(directory, \"leases\"))\n505|\tif err != nil {\n506|\t\tif os.IsNotExist(err) {\n507|\t\t\treturn nil, nil\n508|\t\t}\n509|\t\treturn nil, fmt.Errorf(\"read leases namespace: %w\", err)\n510|\t}\n511|\tvar stored []LeaseSummary\n512|\tfor _, entry := range entries {\n513|\t\tname := entry.Name()\n514|\t\tif strings.HasPrefix(name, \".\") {\n515|\t\t\tcontinue\n516|\t\t}\n517|\t\texpected, err := leaseDigestForName(name)\n518|\t\tif err != nil {\n519|\t\t\treturn nil, err\n520|\t\t}\n521|\t\tblob, err := os.ReadFile(filepath.Join(directory, \"leases\", name))\n522|\t\tif err != nil {\n523|\t\t\treturn nil, fmt.Errorf(\"read lease %s: %w\", name, err)\n524|\t\t}\n525|\t\tsummary, err := decodeStoredLease(sessionID, blob)\n526|\t\tif err != nil {\n527|\t\t\treturn nil, fmt.Errorf(\"lease %s: %v\", name, err)\n528|\t\t}\n529|\t\tif summary.RecordID != expected {\n530|\t\t\treturn nil, fmt.Errorf(\"lease %s attests %s\", name, summary.RecordID)\n531|\t\t}\n532|\t\tstored = append(stored, summary)\n533|\t}\n534|\tsort.Slice(stored, func(i, j int) bool { return CompareLeaseTuple(stored[i], stored[j]) < 0 })\n535|\treturn stored, nil\n536|}\n537|\n538|// verifyLeaseBlob decodes one blob and binds it to its expected session\n539|// and digest name. Failures are plain errors; the caller attributes them\n540|// through its own refusal site.\n541|func verifyLeaseBlob(sessionID, expected string, blob []byte) error {\n542|\tsummary, err := decodeStoredLease(sessionID, blob)\n543|\tif err != nil {\n544|\t\treturn err\n545|\t}\n546|\tif summary.RecordID != expected {\n547|\t\treturn fmt.Errorf(\"blob attests %s, want %s\", summary.RecordID, expected)\n548|\t}\n549|\treturn nil\n550|}\n551|\n552|// leaseDigestForName renders a leases-namespace file name back to the\n553|// digest it must hold. Anything outside hex.json is torn store, never a\n554|// skipped entry: only staged temps are ignorable.\n555|func leaseDigestForName(name string) (string, error) {\n556|\ttrimmed := strings.TrimSuffix(name, \".json\")\n557|\tdigest, err := scalar.ParseDigest(\"sha256:\" + trimmed)\n558|\tif err != nil {\n559|\t\treturn \"\", fmt.Errorf(\"lease file %q is not a digest path: %v\", name, err)\n560|\t}\n561|\treturn digest.String(), nil\n562|}\n563|\n564|// installLeaseBlobLocked installs one minted lease blob atomically: staged\n565|// bytes fsync before the rename, the directory fsyncs after. A second\n566|// install of identical bytes is reused; disagreeing bytes at a digest path\n567|// are torn store. AfterLeaseStage fires after the staged fsync and before\n568|// the rename — the kill seam the crash tests drive — and is nil in normal\n569|// operation. Callers hold the repository mutex.\n570|func (repository *Repository) installLeaseBlobLocked(directory, recordID string, data []byte) error {\n571|\tleases := filepath.Join(directory, \"leases\")\n572|\tif err := os.MkdirAll(leases, 0o700); err != nil {\n573|\t\treturn fmt.Errorf(\"create leases namespace: %w\", err)\n574|\t}\n575|\tpath := filepath.Join(leases, blobFileName(recordID))\n576|\tif existing, err := os.ReadFile(path); err == nil {\n577|\t\tif leaseBytesEqual(existing, data) {\n578|\t\t\treturn nil\n579|\t\t}\n580|\t\treturn refuse(ErrChainCorrupt, \"digest path holds disagreeing bytes for lease\")\n581|\t} else if !os.IsNotExist(err) {\n582|\t\treturn fmt.Errorf(\"read installed lease blob: %w\", err)\n583|\t}\n584|\tstaged, err := os.CreateTemp(leases, leaseStagePrefix)\n585|\tif err != nil {\n586|\t\treturn fmt.Errorf(\"stage lease blob: %w\", err)\n587|\t}\n588|\tstagedPath := staged.Name()\n589|\tfinished := false\n590|\tdefer func() {\n591|\t\tif !finished {\n592|\t\t\t_ = staged.Close()\n593|\t\t\t_ = os.Remove(stagedPath)\n594|\t\t}\n595|\t}()\n596|\tif err := staged.Chmod(0o600); err != nil {\n597|\t\treturn fmt.Errorf(\"mode staged lease blob: %w\", err)\n598|\t}\n599|\tif _, err := staged.Write(data); err != nil {\n600|\t\treturn fmt.Errorf(\"write staged lease blob: %w\", err)\n601|\t}\n602|\tif err := staged.Sync(); err != nil {\n603|\t\treturn fmt.Errorf(\"fsync staged lease blob: %w\", err)\n604|\t}\n605|\tif err := staged.Close(); err != nil {\n606|\t\treturn fmt.Errorf(\"close staged lease blob: %w\", err)\n607|\t}\n608|\tif repository.AfterLeaseStage != nil {\n609|\t\tif err := repository.AfterLeaseStage(); err != nil {\n610|\t\t\treturn err\n611|\t\t}\n612|\t}\n613|\tfinished = true\n614|\tif err := os.Rename(stagedPath, path); err != nil {\n615|\t\treturn fmt.Errorf(\"install lease blob: %w\", err)\n616|\t}\n617|\treturn syncDirectory(leases)\n618|}\n619|\n620|// findExpectedLease resolves a CAS expectation to the stored lease it names.\n621|// An empty or unknown digest resolves nothing: only a persisted record_id\n622|// can be a compare basis.\n623|func findExpectedLease(stored []LeaseSummary, recordID string) (LeaseSummary, bool) {\n624|\tfor _, known := range stored {\n625|\t\tif known.RecordID == recordID {\n626|\t\t\treturn known, true\n627|\t\t}\n628|\t}\n629|\treturn LeaseSummary{}, false\n630|}\n631|\n632|// findIdenticalLease reports the stored lease whose digest equals the minted\n633|// candidate's, so a byte-identical retry returns its reference instead of\n634|// minting a duplicate. The digest is the canonical content identity, so\n635|// digest equality is full-content equality under the same collision\n636|// resistance the content-addressed layout already assumes; the load path\n637|// re-verified every stored blob before this comparison runs.\n638|func findIdenticalLease(stored []LeaseSummary, digest string) (bool, LeaseRef) {\n639|\tfor _, known := range stored {\n640|\t\tif known.RecordID == digest {\n641|\t\t\treturn true, LeaseRef{SessionID: known.SessionID, RecordID: known.RecordID, LeaseID: known.LeaseID, Epoch: known.Epoch, HolderHostID: known.HolderHostID}\n642|\t\t}\n643|\t}\n644|\treturn false, LeaseRef{}\n645|}\n646|\n647|// leaseBytesEqual is the one content-equality site of the lease store,\n648|// registered in the census ledger with its same-length vector.\n649|func leaseBytesEqual(left, right []byte) bool {\n650|\treturn bytes.Equal(left, right)\n651|}\n652|\n653|// mintLeaseRecord builds one canonical Lease Record and returns its bytes\n654|// with the attested record_id. Identity is computed by the canonicaljson\n655|// owner over the placeholder, then confirmed by Verify after the digest is\n656|// bound, so minted bytes always attest. Failures are plain operational\n657|// errors, never refusals: entry validation already admitted the inputs,\n658|// so a mint failure is an internal inconsistency, not a rejected input.\n659|func mintLeaseRecord(sessionID string, epoch uint64, leaseID, holder, issuer, predecessor string, hasPredecessor bool, reason, checkpoint string, hasCheckpoint bool, createdAt string) ([]byte, string, error) {\n660|\tvar predecessorValue any\n661|\tif hasPredecessor {\n662|\t\tpredecessorValue = predecessor\n663|\t}\n664|\tvar checkpointValue any\n665|\tif hasCheckpoint {\n666|\t\tcheckpointValue = checkpoint\n667|\t}\n668|\tobject := map[string]any{\n669|\t\t\"schema\":               leaseRecordSchema,\n670|\t\t\"schema_version\":       \"1.0.0\",\n671|\t\t\"record_id\":            leaseIdentityPlaceholder,\n672|\t\t\"subject_id\":           sessionID,\n673|\t\t\"session_id\":           sessionID,\n674|\t\t\"lease_id\":             leaseID,\n675|\t\t\"epoch\":                epoch,\n676|\t\t\"holder_host_id\":       holder,\n677|\t\t\"predecessor_lease_id\": predecessorValue,\n678|\t\t\"reason\":               reason,\n679|\t\t\"checkpoint_id\":        checkpointValue,\n680|\t\t\"issued_by_host_id\":    issuer,\n681|\t\t\"created_by_host_id\":   issuer,\n682|\t\t\"created_at\":           createdAt,\n683|\t\t\"extensions\":           map[string]any{},\n684|\t}\n685|\tstaged, err := json.Marshal(object)\n686|\tif err != nil {\n687|\t\treturn nil, \"\", fmt.Errorf(\"encode lease record: %w\", err)\n688|\t}\n689|\tdigest, _, err := canonicaljson.CalculateObjectIdentity(staged)\n690|\tif err != nil {\n691|\t\treturn nil, \"\", fmt.Errorf(\"identify lease record: %w\", err)\n692|\t}\n693|\tobject[\"record_id\"] = digest.String()\n694|\traw, err := json.Marshal(object)\n695|\tif err != nil {\n696|\t\treturn nil, \"\", fmt.Errorf(\"encode identified lease record: %w\", err)\n697|\t}\n698|\tif _, _, err := AttestLeaseRecord(raw); err != nil {\n699|\t\treturn nil, \"\", fmt.Errorf(\"attest minted lease record: %w\", err)\n700|\t}\n701|\treturn raw, digest.String(), nil\n702|}\n703|\n704|// decodeStoredLease validates one stored Lease Record through the\n705|// canonicaljson owner and extracts the bound members. Closed-shape,\n706|// coupling, and identity failures are plain errors for the caller to\n707|// attribute; member extraction re-checks grammar through the environ and\n708|// scalar owners, matching the query-layer admission without forking it.\n709|func decodeStoredLease(sessionID string, raw []byte) (LeaseSummary, error) {\n710|\tvar summary LeaseSummary\n711|\tmembers, fault := environ.DecodeStrictObject(raw)\n712|\tif fault != nil {\n713|\t\treturn summary, fmt.Errorf(\"decode lease record frame: %v\", fault)\n714|\t}\n715|\tschema, err := stringMember(members, \"schema\")\n716|\tif err != nil || schema != leaseRecordSchema {\n717|\t\treturn summary, fmt.Errorf(\"lease record schema %q, want %q\", schema, leaseRecordSchema)\n718|\t}\n719|\tdigest, field, err := AttestLeaseRecord(raw)\n720|\tif err != nil {\n721|\t\treturn summary, fmt.Errorf(\"verify lease record identity: %v\", err)\n722|\t}\n723|\tif field != canonicaljson.SelfRecordID {\n724|\t\treturn summary, fmt.Errorf(\"lease record identity field %q, want record_id\", string(field))\n725|\t}\n726|\trecordSession, ok := environ.CheckUUIDv7(members[\"session_id\"])\n727|\tif !ok {\n728|\t\treturn summary, fmt.Errorf(\"lease record carries no valid session_id member\")\n729|\t}\n730|\tif recordSession.String() != sessionID {\n731|\t\treturn summary, fmt.Errorf(\"lease record session %s does not match stored session %s\", recordSession.String(), sessionID)\n732|\t}\n733|\tleaseID, err := stringMember(members, \"lease_id\")\n734|\tif err != nil {\n735|\t\treturn summary, fmt.Errorf(\"lease record carries no lease_id member: %v\", err)\n736|\t}\n737|\tif _, err := scalar.ParseUUIDv4(leaseID); err != nil {\n738|\t\treturn summary, fmt.Errorf(\"lease record lease_id: %v\", err)\n739|\t}\n740|\tepoch, ok := environ.CheckUint53Bounds(members[\"epoch\"], 1, uint53Max)\n741|\tif !ok {\n742|\t\treturn summary, fmt.Errorf(\"lease record carries no epoch at or above 1\")\n743|\t}\n744|\tholder, ok := environ.CheckUUIDv7(members[\"holder_host_id\"])\n745|\tif !ok {\n746|\t\treturn summary, fmt.Errorf(\"lease record carries no valid holder_host_id member\")\n747|\t}\n748|\tpredecessor, hasPredecessor, err := nullableUUIDv4Member(members, \"predecessor_lease_id\")\n749|\tif err != nil {\n750|\t\treturn summary, fmt.Errorf(\"lease record predecessor_lease_id: %v\", err)\n751|\t}\n752|\tcheckpoint, hasCheckpoint, err := nullableDigestMember(members, \"checkpoint_id\")\n753|\tif err != nil {\n754|\t\treturn summary, fmt.Errorf(\"lease record checkpoint_id: %v\", err)\n755|\t}\n756|\treason, err := stringMember(members, \"reason\")\n757|\tif err != nil {\n758|\t\treturn summary, fmt.Errorf(\"lease record carries no reason member: %v\", err)\n759|\t}\n760|\tsummary = LeaseSummary{RecordID: digest.String(), SessionID: recordSession.String(), LeaseID: leaseID, Epoch: epoch, HolderHostID: holder.String(), Predecessor: predecessor, HasPredecessor: hasPredecessor, Checkpoint: checkpoint, HasCheckpoint: hasCheckpoint, Reason: reason}\n761|\treturn summary, nil\n762|}\n763|\n764|// nullableUUIDv4Member reads a member that is null or a UUIDv4 string. A\n765|// nil pointer binds JSON null without any text comparison.\n766|func nullableUUIDv4Member(members map[string]json.RawMessage, name string) (string, bool, error) {\n767|\traw, ok := members[name]\n768|\tif !ok {\n769|\t\treturn \"\", false, fmt.Errorf(\"member %q is absent\", name)\n770|\t}\n771|\tvar value *string\n772|\tif err := json.Unmarshal(raw, &value); err != nil {\n773|\t\treturn \"\", false, fmt.Errorf(\"member %q is neither a UUID nor null\", name)\n774|\t}\n775|\tif value == nil {\n776|\t\treturn \"\", false, nil\n777|\t}\n778|\tif _, err := scalar.ParseUUIDv4(*value); err != nil {\n779|\t\treturn \"\", false, err\n780|\t}\n781|\treturn *value, true, nil\n782|}\n783|\n784|// nullableDigestMember reads a member that is null or a digest string. A\n785|// nil pointer binds JSON null without any text comparison.\n786|func nullableDigestMember(members map[string]json.RawMessage, name string) (string, bool, error) {\n787|\traw, ok := members[name]\n788|\tif !ok {\n789|\t\treturn \"\", false, fmt.Errorf(\"member %q is absent\", name)\n790|\t}\n791|\tvar value *string\n792|\tif err := json.Unmarshal(raw, &value); err != nil {\n793|\t\treturn \"\", false, fmt.Errorf(\"member %q is neither a digest nor null\", name)\n794|\t}\n795|\tif value == nil {\n796|\t\treturn \"\", false, nil\n797|\t}\n798|\tdigest, err := scalar.ParseDigest(*value)\n799|\tif err != nil {\n800|\t\treturn \"\", false, err\n801|\t}\n802|\treturn digest.String(), true, nil\n803|}","final_result":true}}}
