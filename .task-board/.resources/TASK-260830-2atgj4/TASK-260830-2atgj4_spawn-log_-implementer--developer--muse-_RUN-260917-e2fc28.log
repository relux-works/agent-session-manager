ction. An equal lease and a strictly greater lease — by\n353|// epoch or by lease ID — stand with the winner.\n354|func TestReduceLocalLeaseTupleRule(t *testing.T) {\n355|\trecord := decodeTestRecord(t)\n356|\tspecs := baseBootstrap(record)\n357|\tcases := []struct {\n358|\t\tname      string\n359|\t\tlocal     LeaseHead\n360|\t\twantState State\n361|\t\twantStale bool\n362|\t}{\n363|\t\t{\"equal stands\", LeaseHead{Epoch: 1, LeaseID: testLeaseID}, StateRunning, false},\n364|\t\t{\"greater epoch stands\", LeaseHead{Epoch: 9, LeaseID: testLeaseIDC}, StateRunning, false},\n365|\t\t{\"greater lease id stands\", LeaseHead{Epoch: 1, LeaseID: testLeaseIDC}, StateRunning, false},\n366|\t\t{\"lesser lease stales\", LeaseHead{Epoch: 1, LeaseID: testLeaseIDR}, StateStale, true},\n367|\t}\n368|\tfor _, tc := range cases {\n369|\t\tt.Run(tc.name, func(t *testing.T) {\n370|\t\t\tprojection, err := reduceSpecs(t, record, specs, Input{Local: tc.local})\n371|\t\t\tif err != nil {\n372|\t\t\t\tt.Fatalf(\"Reduce error = %v\", err)\n373|\t\t\t}\n374|\t\t\tif projection.State != tc.wantState {\n375|\t\t\t\tt.Fatalf(\"state = %q, want %q\", projection.State, tc.wantState)\n376|\t\t\t}\n377|\t\t\tif projection.Winner != (LeaseHead{Epoch: 1, LeaseID: testLeaseID}) {\n378|\t\t\t\tt.Fatalf(\"winner = %+v, want the chain head: the local lease never moves the winner\", projection.Winner)\n379|\t\t\t}\n380|\t\t\thasStale := false\n381|\t\t\tfor _, warning := range projection.Warnings {\n382|\t\t\t\tif warning == \"stale_process\" {\n383|\t\t\t\t\thasStale = true\n384|\t\t\t\t}\n385|\t\t\t}\n386|\t\t\tif hasStale != tc.wantStale {\n387|\t\t\t\tt.Fatalf(\"stale_process warning = %v, want %v (warnings = %v)\", hasStale, tc.wantStale, projection.Warnings)\n388|\t\t\t}\n389|\t\t})\n390|\t}\n391|}\n392|\n393|func assertConflictDetailContains(t *testing.T, projection Projection, kind, fragment string) {\n394|\tt.Helper()\n395|\tfor _, conflict := range projection.Conflicts {\n396|\t\tif conflict.Kind == kind {\n397|\t\t\tif !strings.Contains(conflict.Detail, fragment) {\n398|\t\t\t\tt.Fatalf(\"conflict %s detail = %q, want fragment %q\", kind, conflict.Detail, fragment)\n399|\t\t\t}\n400|\t\t\treturn\n401|\t\t}\n402|\t}\n403|\tt.Fatalf(\"no conflict of kind %s in %+v\", kind, projection.Conflicts)\n404|}\n405|\n406|func assertWarning(t *testing.T, projection Projection, warning string) {\n407|\tt.Helper()\n408|\tfor _, candidate := range projection.Warnings {\n409|\t\tif candidate == warning {\n410|\t\t\treturn\n411|\t\t}\n412|\t}\n413|\tt.Fatalf(\"warnings = %v, want %q\", projection.Warnings, warning)\n414|}\n415|\n416|// With no authoritative event there is no owner/process lease to fence.\n417|// Union may report a winner, but Local is ignored, including malformed and\n418|// partial tuples. This is a stated input bound, not invented validation.\n419|func TestReduceEmptyChainLocalIsIgnored(t *testing.T) {\n420|\trecord := decodeTestRecord(t)\n421|\twinner := LeaseHead{Epoch: 3, LeaseID: testLeaseIDC}\n422|\tfor _, union := range []struct {\n423|\t\tname   string\n424|\t\tleases []LeaseHead\n425|\t\twinner LeaseHead\n426|\t}{\n427|\t\t{\"absent_union\", nil, LeaseHead{}},\n428|\t\t{\"selected_union_winner\", []LeaseHead{{Epoch: 2, LeaseID: testLeaseIDB}, winner}, winner},\n429|\t} {\n430|\t\tt.Run(union.name, func(t *testing.T) {\n431|\t\t\tbaseline, err := Reduce(Input{Record: record, Union: union.leases})\n432|\t\t\tif err != nil {\n433|\t\t\t\tt.Fatal(err)\n434|\t\t\t}\n435|\t\t\tif baseline.Winner != union.winner || baseline.State != StateCreating {\n436|\t\t\t\tt.Fatalf(\"union baseline: %+v\", baseline)\n437|\t\t\t}\n438|\t\t\tif len(union.leases) > 0 {\n439|\t\t\t\tfound := false\n440|\t\t\t\tfor _, conflict := range baseline.Conflicts {\n441|\t\t\t\t\tif conflict.Kind == ConflictUnionSupersedesChain && conflict.Rule == ResolveRuleAuthoritativeStateUnchanged {\n442|\t\t\t\t\t\tfound = true\n443|\t\t\t\t\t}\n444|\t\t\t\t}\n445|\t\t\t\tif !found {\n446|\t\t\t\t\tt.Fatal(\"selected union winner has no named unchanged-state conflict\")\n447|\t\t\t\t}\n448|\t\t\t}\n449|\t\t\tfor _, local := range []struct {\n450|\t\t\t\tname string\n451|\t\t\t\thead LeaseHead\n452|\t\t\t}{\n453|\t\t\t\t{\"absent\", LeaseHead{}},\n454|\t\t\t\t{\"lesser\", LeaseHead{Epoch: 1, LeaseID: testLeaseID}},\n455|\t\t\t\t{\"equal_to_union\", winner},\n456|\t\t\t\t{\"greater\", LeaseHead{Epoch: 4, LeaseID: testLeaseIDB}},\n457|\t\t\t\t{\"malformed_id\", LeaseHead{Epoch: 1, LeaseID: \"not-a-uuid\"}},\n458|\t\t\t\t{\"epoch_only\", LeaseHead{Epoch: 1}},\n459|\t\t\t\t{\"id_only\", LeaseHead{LeaseID: testLeaseID}},\n460|\t\t\t} {\n461|\t\t\t\tt.Run(local.name, func(t *testing.T) {\n462|\t\t\t\t\tgot, err := Reduce(Input{Record: record, Union: union.leases, Local: local.head, LocalHostID: testHostID})\n463|\t\t\t\t\tif err != nil {\n464|\t\t\t\t\t\tt.Fatalf(\"empty-chain Local must not be validated: %v\", err)\n465|\t\t\t\t\t}\n466|\t\t\t\t\tif got.LocalRole != \"\" || got.OwnerHostID != \"\" {\n467|\t\t\t\t\t\tt.Fatalf(\"no authoritative owner: %+v\", got)\n468|\t\t\t\t\t}\n469|\t\t\t\t\tif !reflect.DeepEqual(got, baseline) {\n470|\t\t\t\t\t\tt.Fatalf(\"Local changed empty-chain projection: got %+v want %+v\", got, baseline)\n471|\t\t\t\t\t}\n472|\t\t\t\t})\n473|\t\t\t}\n474|\t\t})\n475|\t}\n476|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9b1","stream":{"kind":"session","id":"01a0ae38-1954-7242-9b52-ff7ca6c9b52f"},"sequence":819,"recorded_at":1780531400001633,"record_type":"event","durability":"durable","causation_id":"815552bd-492d-441d-89cf-fcae5a028cc4","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"815552bd-492d-441d-89cf-fcae5a028cc4","run_stream":{"kind":"run","id":"815552bd-492d-441d-89cf-fcae5a028cc4"},"call_id":"call_01a0ae3cbafe72309ba1ec3bda0179c3","text":"{\n  \"chunk_id\": \"exec-26-1\",\n  \"command\": \"sed -n 213,300p internal/fencing/scenarios_test.go\",\n  \"description\": \"Read concurrent takeover scenario test\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"// TestConcurrentForceTakeoversDeterministicWinner drives the\\n// concurrent-takeover row: two force leases at the same epoch from\\n// one base resolve to the bytewise-greater lease ID in either union\\n// order under both tuple rules, the winner authorizes, and the loser\\n// stops accepting input.\\nfunc TestConcurrentForceTakeoversDeterministicWinner(t *testing.T) {\\n\\tbuild := func(t *testing.T, leaseID, holder string) *sessrepo.Repository {\\n\\t\\tt.Helper()\\n\\t\\trepository, _ := openFenceRepository(t)\\n\\t\\tcreateFenceSession(t, repository)\\n\\t\\tbase := mustCreateFenceLease(t, repository, fenceSessionA, sessrepo.CreateLeaseInput{LeaseID: fenceLeaseOld, HolderHostID: fenceHostA, IssuedByHostID: fenceHostA, CreatedAt: fenceLeaseAt})\\n\\t\\tmustSwapFenceLease(t, repository, fenceSessionA, sessrepo.LeaseExpectation{RecordID: base.RecordID}, sessrepo.SuccessorLeaseInput{\\n\\t\\t\\tCreateLeaseInput: sessrepo.CreateLeaseInput{LeaseID: leaseID, HolderHostID: holder, IssuedByHostID: holder, CreatedAt: fenceLeaseAt},\\n\\t\\t\\tReason:           \\\"force_takeover\\\",\\n\\t\\t\\tCheckpointID:     fenceZeroDigest,\\n\\t\\t})\\n\\t\\treturn repository\\n\\t}\\n\\trepoX := build(t, fenceLeaseA, fenceHostB)\\n\\trepoY := build(t, fenceLeaseC2, fenceHostC)\\n\\theadX, err := repoX.WinningLease(fenceSessionA)\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"WinningLease(X) error = %v\\\", err)\\n\\t}\\n\\theadY, err := repoY.WinningLease(fenceSessionA)\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"WinningLease(Y) error = %v\\\", err)\\n\\t}\\n\\tfor _, order := range [][2]sessrepo.LeaseSummary{{headX, headY}, {headY, headX}} {\\n\\t\\twinner := order[0]\\n\\t\\tif sessrepo.CompareLeaseTuple(order[1], winner) > 0 {\\n\\t\\t\\twinner = order[1]\\n\\t\\t}\\n\\t\\tif winner.LeaseID != fenceLeaseC2 {\\n\\t\\t\\tt.Fatalf(\\\"union winner = %s, want the greater lease %s\\\", winner.LeaseID, fenceLeaseC2)\\n\\t\\t}\\n\\t\\tstateWinner := sessstate.LeaseHead{Epoch: order[0].Epoch, LeaseID: order[0].LeaseID}\\n\\t\\tother := sessstate.LeaseHead{Epoch: order[1].Epoch, LeaseID: order[1].LeaseID}\\n\\t\\tif sessstate.Compare(other, stateWinner) > 0 {\\n\\t\\t\\tstateWinner = other\\n\\t\\t}\\n\\t\\tif stateWinner.LeaseID != winner.LeaseID {\\n\\t\\t\\tt.Fatalf(\\\"sessstate winner %s disagrees with store winner %s\\\", stateWinner.LeaseID, winner.LeaseID)\\n\\t\\t}\\n\\t}\\n\\t// The loser stops accepting input once it learns the union\\n\\t// winner: its same-epoch token loses the tie on the winning host.\\n\\tloser := PresentedToken{SessionID: fenceSessionA, Epoch: 2, LeaseID: fenceLeaseA}\\n\\tunion := ObserveInput{LocalHostID: fenceHostC, Verified: true, HasGrant: true, Grant: sessrepo.FencingGrant{SessionID: fenceSessionA, ValidatedAt: fenceValidatedAt}, Policy: fencePolicy, Now: fenceValidatedAt}\\n\\tobservation, err := Observe(repoY, fenceSessionA, union)\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"Observe error = %v\\\", err)\\n\\t}\\n\\t_, err = AuthorizeInput(loser, observation)\\n\\tmustRefuse(t, err, ErrLeaseConflict, \\\"loser/input\\\")\\n\\t_, err = AuthorizeMutation(loser, observation)\\n\\tmustRefuse(t, err, ErrLeaseConflict, \\\"loser/mutation\\\")\\n\\tchampion := PresentedToken{SessionID: fenceSessionA, Epoch: 2, LeaseID: fenceLeaseC2}\\n\\ttoken, err := AuthorizeActivation(champion, observation)\\n\\tmustMintUnion(t, token, err, fenceLeaseC2)\\n}\\n\\n// mustMintUnion is mustMint for a non-default winning lease: the\\n// minted token binds the exact expected triple.\\nfunc mustMintUnion(t *testing.T, token LeaseToken, err error, leaseID string) {\\n\\tt.Helper()\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"union authorize error = %v, want a minted token\\\", err)\\n\\t}\\n\\tbound, err := token.Bind(ProviderCapture)\\n\\tif err != nil {\\n\\t\\tt.Fatalf(\\\"Bind(capture) error = %v\\\", err)\\n\\t}\\n\\tif bound.SessionID != fenceSessionA || bound.Epoch != 2 || bound.LeaseID != leaseID {\\n\\t\\tt.Fatalf(\\\"Bind(capture) = %+v, want the union winner\\\", bound)\\n\\t}\\n}\\n\\n// TestLifecycleCallersPassTheGate models graceful takeover, fork,\\n// stop, and resume as gate callers: each authorizes its entry point\\n// with the winning lease and the exact epoch, and the replica resume\\n// parks remote instead of starting a runtime.\\nfunc TestLifecycleCallersPassTheGate(t *testing.T) {\\n\\tt.Run(\\\"graceful_takeover_commit\\\", func(t *testing.T) {\\n\\t\\trepository, _ := openFenceRepository(t)\\n\\t\\tcreateFenceSession(t, repository)\\n\\t\\tfirst := mustCreateFenceLease(t, repository, fenceSessionA, sessrepo.CreateLeaseInput{LeaseID: fenceLeaseOld, HolderHostID: fenceHostA, IssuedByHostID: fenceHostA, CreatedAt: fenceLeaseAt})\\n\\t\\tmustSwapFenceLease(t, repository, fenceSessionA, sessrepo.LeaseExpectation{RecordID: first.RecordID}, sessrepo.SuccessorLeaseInput{\\n\",\n  \"original_output_bytes\": 4390,\n  \"original_output_tokens\": 1098,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
