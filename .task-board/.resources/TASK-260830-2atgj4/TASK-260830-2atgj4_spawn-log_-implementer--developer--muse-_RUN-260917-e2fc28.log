ds_test.go\\ndeclared_byte_bounds.go\\nfuzz_test.go\\ngolden_test.go\\ngrammar_inventory_test.go\\nidentity_fixtures_test.go\\nmember_shape_refusal_test.go\\nnesting_depth_test.go\\nperformance_test.go\\nrecord_conformance_test.go\\nrefusal_guards_test.go\\nsession_event_payload_inventory_test.go\\nsession_record_versions_test.go\\nstring_admission_test.go\\nterminal_backend_id_test.go\\ntestdata\\nutf8_subsumption_test.go\\nvalidation_config_test.go\\n\\n./internal/canonicaljson/testdata:\\narray-order-constraints.md\\nclosed-vocabularies.md\\nconstraint-enumeration.md\\ncross-platform-identity.golden.json\\nfuzz\\nsession-event-payload-members.md\\n\\n./internal/canonicaljson/testdata/fuzz:\\nFuzzCanonicalizeRoundTrip\\nFuzzClosedIdentityShapeRefusal\\nFuzzObjectIdentityRepresentationInvariant\\n\\n./internal/canonicaljson/testdata/fuzz/FuzzCanonicalizeRoundTrip:\\nduplicate-map-key\\nnesting-depth-over-limit\\nnon-string-map-key\\nunicode-utf16-order\\nunpaired-surrogate\\n\\n./internal/canonicaljson/testdata/fuzz/FuzzClosedIdentityShapeRefusal:\\nblob-coverage\\nblob-index-order\\nblob-offset-gap\\nblob-size-bound\\nblob-unknown-nested\\nblob-unknown-top-level\\nmanifest-entry-unknown-nested\\nmanifest-invalid-extension-key\\nmanifest-member-unknown-nested\\nmanifest-snapshot-unknown-nested\\nmanifest-unknown-top-level\\nmigration-provenance-unknown-nested\\nrecord-impossible-created-at\\nrecord-invalid-extension-key\\nrecord-invalid-name\\nrecord-launch-plan-unknown-nested\\nrecord-malformed-subject\\nrecord-missing-created-by-host\\nrecord-unknown-top-level\\n\\n./internal/canonicaljson/testdata/fuzz/FuzzObjectIdentityRepresentationInvariant:\\nnested-reordered-object\\nunicode-utf16-order\\n\\n./internal/catalog:\\ncatalog_gen.go\\ncatalog_test.go\\ncatalog.go\\ncatalog.v0.5.0.json\\ncatalog.v0.6.0.json\\ncmd\\n\\n./internal/catalog/cmd:\\ncataloggen\\n\\n./internal/catalog/cmd/cataloggen:\\nmain_test.go\\nmain.go\\n\\n./internal/cataloggen:\\ngenerate_test.go\\ngenerate.go\\n\\n./internal/cigate:\\nclaims_test.go\\nclaims.go\\ncontracts_test.go\\ncontracts.go\\ndoc.go\\ntargets_test.go\\ntargets.go\\n\\n./internal/cliresult:\\nbodies_test.go\\nbodies.go\\nclient_test.go\\nclient.go\\ncliresult_test.go\\ncliresult.go\\ncommand.go\\nconfirmation_test.go\\ndatamodel_test.go\\ndecode_test.go\\ndecode.go\\nelements_test.go\\nenvelope_test.go\\n===\\n# Agent Session Manager Repository Instructions\\n\\n`AGENTS.md` is the canonical instruction file for this repository. `CLAUDE.md`\\nmust remain a relative symlink to this file so every supported agent reads the\\nsame rules.\\n\\n## Product and Specification\\n\\n- The product is Agent Session Manager, exposed as the `ax` command.\\n- Treat the [normative AX specification](https://github.com/relux-works/agent-session-manager-spec/blob/main/SPEC.md)\\n  as the authority for product behavior. Do not invent behavior that conflicts\\n  with it.\\n- This repository contains the implementation. Keep specifications and\\n  implementation changes traceable to their task-board work.\\n\\n## Change Workflow\\n\\n- Track every change in `task-board` before implementation begins. Keep the\\n  task status, checklist, notes, and task-scoped outcome evidence current.\\n- An authorized repository-changing task includes automatic delivery: stage\\n  only its reviewed scope, create author-signed commits, publish the feature\\n  branch, open or update the pull request, complete review and checks, and land\\n  the accepted exact head in `main`. Do not stop merely to ask whether the\\n  completed task should be committed, pushed, or landed.\\n- The repository bootstrap is the only direct-bootstrap exception. Every later\\n  change must be reviewed through a pull request. After approval and passing\\n  checks, land the exact signed feature head with a plain fast-forward push to\\n  `main`; never land through GitHub rebase, squash, or merge-commit actions.\\n- Never push unreviewed work, a different commit from the reviewed PR head, or\\n  a forced update to `main`. GitHub records the reviewed PR as indirectly\\n\",\n  \"original_output_bytes\": 6619,\n  \"original_output_tokens\": 1655,\n  \"truncated\": false\n}","final_result":true}}}
