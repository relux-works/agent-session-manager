b-4ccc-8ddd-eeeeeeeeeeee\",\n34|  \"epoch\": 4,\n35|  \"holder_host_id\": \"0198f4c8-7d40-7e55-8e6f-1234567890ab\",\n36|  \"predecessor_lease_id\": \"bbbbbbbb-cccc-4ddd-8eee-ffffffffffff\",\n37|  \"reason\": \"graceful_takeover\",\n38|  \"checkpoint_id\": \"sha256:e051996f51f13ace4f5cdebe1e30fd26fd5fe104cfd6e6a7f9f1206ba3819656\",\n39|  \"issued_by_host_id\": \"0198f4c8-7d40-7e55-8e6f-1234567890ab\",\n40|  \"created_by_host_id\": \"0198f4c8-7d40-7e55-8e6f-1234567890ab\",\n41|  \"created_at\": \"2026-08-19T04:09:00.000Z\",\n42|  \"extensions\": {}\n43|}`\n44|\n45|// createLeaseFixture returns the epoch-1 create input: fencing token A,\n46|// holder and issuer host A, and the fixed diagnostic timestamp.\n47|func createLeaseFixture() CreateLeaseInput {\n48|\treturn CreateLeaseInput{LeaseID: testLeaseID, HolderHostID: testHostID, IssuedByHostID: testHostID, CreatedAt: testLeaseAt}\n49|}\n50|\n51|// successorLeaseFixture returns a successor input: fencing token B, holder\n52|// and issuer host B, graceful_takeover over the zero checkpoint.\n53|func successorLeaseFixture() SuccessorLeaseInput {\n54|\treturn SuccessorLeaseInput{\n55|\t\tCreateLeaseInput: CreateLeaseInput{LeaseID: testLeaseIDB, HolderHostID: testHostIDB, IssuedByHostID: testHostIDB, CreatedAt: testLeaseAt},\n56|\t\tReason:           \"graceful_takeover\",\n57|\t\tCheckpointID:     zeroDigest,\n58|\t}\n59|}\n60|\n61|// mustCreateLease creates the epoch-1 lease or fails the test.\n62|func mustCreateLease(t *testing.T, repository *Repository, sessionID string, input CreateLeaseInput) LeaseRef {\n63|\tt.Helper()\n64|\treference, err := repository.CreateLease(sessionID, input)\n65|\tif err != nil {\n66|\t\tt.Fatalf(\"CreateLease error = %v\", err)\n67|\t}\n68|\treturn reference\n69|}\n70|\n71|// mustCompareAndSwap advances the head or fails the test.\n72|func mustCompareAndSwap(t *testing.T, repository *Repository, sessionID string, expected LeaseExpectation, input SuccessorLeaseInput) LeaseRef {\n73|\tt.Helper()\n74|\treference, err := repository.CompareAndSwapLease(sessionID, expected, input)\n75|\tif err != nil {\n76|\t\tt.Fatalf(\"CompareAndSwapLease error = %v\", err)\n77|\t}\n78|\treturn reference\n79|}\n80|\n81|// mustAttestLease fails unless raw verifies through the canonical owner\n82|// with the record_id self field.\n83|func mustAttestLease(t *testing.T, raw []byte, what string) string {\n84|\tt.Helper()\n85|\tdigest, field, err := canonicaljson.VerifyObjectIdentity(raw)\n86|\tif err != nil {\n87|\t\tt.Fatalf(\"%s VerifyObjectIdentity error = %v\", what, err)\n88|\t}\n89|\tif field != canonicaljson.SelfRecordID {\n90|\t\tt.Fatalf(\"%s self field = %q, want record_id\", what, string(field))\n91|\t}\n92|\treturn digest.String()\n93|}\n94|\n95|func TestNormativeLeaseRecordExampleAttests(t *testing.T) {\n(more lines below)","final_result":true}}}
