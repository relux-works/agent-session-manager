{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d1d7","stream":{"kind":"session","id":"01a0ae38-1954-7242-9b52-ff7ca6c9b52f"},"sequence":1862,"recorded_at":1780531400003719,"record_type":"event","durability":"durable","causation_id":"815552bd-492d-441d-89cf-fcae5a028cc4","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"815552bd-492d-441d-89cf-fcae5a028cc4","run_stream":{"kind":"run","id":"815552bd-492d-441d-89cf-fcae5a028cc4"},"task_stream":{"kind":"task","id":"01a0ae48-687f-7481-89cf-aa25e24055bd"},"task_id":"01a0ae48-687f-7481-89cf-aa25e24055bd","event":{"kind":"output","task_id":"01a0ae48-687f-7481-89cf-aa25e24055bd","chunk":"{\n  \"chunk_id\": \"exec-51-1\",\n  \"command\": \"python3 - <<'EOF'\\nimport json\\npath = 'internal/traceability/ownership.v0.6.0.json'\\nreg = json.load(open(path))\\n\\nnew_cases = [\\n    {\\\"id\\\": \\\"lease-ownership-union-properties\\\",\\n     \\\"production\\\": {\\\"path\\\": \\\"internal/sessstate/sessstate.go\\\", \\\"declaration\\\": \\\"Reduce\\\"},\\n     \\\"tests\\\": [\\n         {\\\"path\\\": \\\"internal/sessstate/ownership_properties_test.go\\\", \\\"declaration\\\": \\\"TestOwnershipUnionOrderIndependent\\\"},\\n         {\\\"path\\\": \\\"internal/sessstate/ownership_properties_test.go\\\", \\\"declaration\\\": \\\"TestOwnershipUnionOrderRegression\\\"},\\n         {\\\"path\\\": \\\"internal/sessstate/ownership_properties_test.go\\\", \\\"declaration\\\": \\\"TestOwnershipUnionPartitionStable\\\"},\\n         {\\\"path\\\": \\\"internal/sessstate/ownership_properties_test.go\\\", \\\"declaration\\\": \\\"TestOwnershipLoserHistoryPreserved\\\"},\\n         {\\\"path\\\": \\\"internal/sessstate/ownership_properties_test.go\\\", \\\"declaration\\\": \\\"TestOwnershipWinnerIsTupleMaximum\\\"},\\n     ]},\\n    {\\\"id\\\": \\\"lease-ownership-store-properties\\\",\\n     \\\"production\\\": {\\\"path\\\": \\\"internal/sessrepo/lease_store.go\\\", \\\"declaration\\\": \\\"WinningLease\\\"},\\n     \\\"tests\\\": [\\n         {\\\"path\\\": \\\"internal/sessrepo/lease_properties_test.go\\\", \\\"declaration\\\": \\\"TestOwnershipStoreClockNonAuthority\\\"},\\n         {\\\"path\\\": \\\"internal/sessrepo/lease_properties_test.go\\\", \\\"declaration\\\": \\\"TestOwnershipStoreSingleAuthorityPerEpoch\\\"},\\n         {\\\"path\\\": \\\"internal/sessrepo/lease_properties_test.go\\\", \\\"declaration\\\": \\\"TestOwnershipStoreLoserBytesPreserved\\\"},\\n         {\\\"path\\\": \\\"internal/sessrepo/lease_properties_test.go\\\", \\\"declaration\\\": \\\"TestOwnershipStoreTwoHandlesOneHead\\\"},\\n     ]},\\n    {\\\"id\\\": \\\"lease-ownership-gate-properties\\\",\\n     \\\"production\\\": {\\\"path\\\": \\\"internal/fencing/gate.go\\\", \\\"declaration\\\": \\\"Authorize\\\"},\\n     \\\"tests\\\": [\\n         {\\\"path\\\": \\\"internal/fencing/ownership_properties_test.go\\\", \\\"declaration\\\": \\\"TestOwnershipGateClockNonAuthority\\\"},\\n         {\\\"path\\\": \\\"internal/fencing/ownership_properties_test.go\\\", \\\"declaration\\\": \\\"TestOwnershipGateSingleAuthorizedOwner\\\"},\\n     ]},\\n]\\nids = {c[\\\"id\\\"] for c in reg[\\\"acceptance_cases\\\"]}\\nassert not any(c[\\\"id\\\"] in ids for c in new_cases), \\\"duplicate case id\\\"\\nreg[\\\"acceptance_cases\\\"].extend(new_cases)\\n\\ndef group(key):\\n    for g in reg[\\\"ownership\\\"]:\\n        if g[\\\"kind\\\"] == \\\"section_binding\\\" and g[\\\"keys\\\"] == [key]:\\n            return g\\n    raise SystemExit(\\\"missing group \\\" + key)\\n\\ng53 = group(\\\"section:5.3\\\")\\nfor cid in (\\\"lease-ownership-union-properties\\\", \\\"lease-ownership-store-properties\\\"):\\n    assert cid not in g53[\\\"acceptance_cases\\\"]\\n    g53[\\\"acceptance_cases\\\"].append(cid)\\nfor clause in g53[\\\"clauses\\\"]:\\n    if clause[\\\"id\\\"] in (\\\"5.3#6\\\", \\\"5.3#7\\\"):\\n        assert \\\"lease-ownership-union-properties\\\" not in clause[\\\"acceptance_cases\\\"]\\n        clause[\\\"acceptance_cases\\\"].append(\\\"lease-ownership-union-properties\\\")\\n\\ng22 = group(\\\"section:2.2\\\")\\nfor cid in (\\\"lease-ownership-union-properties\\\", \\\"lease-ownership-gate-properties\\\"):\\n    assert cid not in g22[\\\"acceptance_cases\\\"]\\n    g22[\\\"acceptance_cases\\\"].append(cid)\\nfor clause in g22[\\\"clauses\\\"]:\\n    if clause[\\\"id\\\"] in (\\\"2.2#1\\\", \\\"2.2#2\\\"):\\n        assert \\\"lease-ownership-gate-properties\\\" not in clause[\\\"acceptance_cases\\\"]\\n        clause[\\\"acceptance_cases\\\"].append(\\\"lease-ownership-gate-properties\\\")\\n    if clause[\\\"id\\\"] == \\\"2.2#4\\\":\\n        assert \\\"lease-ownership-union-properties\\\" not in clause[\\\"acceptance_cases\\\"]\\n        clause[\\\"acceptance_cases\\\"].append(\\\"lease-ownership-union-properties\\\")\\n\\nold53 = \\\"CompareAndSwapLease with the fencing gates discharges 7 of the 8 Section 5.3 clauses; clause 5.3#5 (every new takeover lease MUST use max_observed_epoch + 1 from the initiator's union) stays unimplemented because the union maximum is caller-side input and no takeover flow exists in this repository yet.\\\"\\nassert g53[\\\"gap\\\"] == old53, \\\"5.3 gap drifted\\\"\\ng53[\\\"gap\\\"] = old53 + \\\" The ownership property cases (union-order independence and loser preservation over Reduce, clock non-authority and single authority over the lease store) add executable proofs for the discharged 5.3#6 and 5.3#7 divergent-preservation evidence without changing the 7-of-8 ratio.\\\"\\n\\nold22prefix = \\\"Authorize with the lease store discharges 4 of the 22 Section 2.2 clauses\\\"\\nassert g22[\\\"gap\\\"].startswith(old22prefix), \\\"2.2 gap drifted\\\"\\ng22[\\\"gap\\\"] = g22[\\\"gap\\\"] + \\\" The ownership property cases (exactly-one authorization over Authorize, union-order independence and loser preservation over Reduce) add executable proofs for the discharged 2.2#1, 2.2#2, and 2.2#4 evidence without changing the 4-of-22 ratio.\\\"\\n\\ng172 = group(\\\"section:17.2\\\")\\nold172tail = \\\"because no ownership implementation exists in this repository.\\\"\\nassert g172[\\\"gap\\\"].endswith(old172tail), \\\"17.2 gap drifted\\\"\\ng172[\\\"gap\\\"] = g172[\\\"gap\\\"][:-len(old172tail)] + \\\"Read classifies one completed CLI invocation, whose alphabet carries no lease or security enum, so the rule is discharged for the reader's own enums and silent for enums the reader never observes.\\\"\\n\\njson.dump(reg, open(path, \\\"w\\\"), indent=2)\\nopen(path, \\\"a\\\").write(\\\"\\\\n\\\")\\nprint(\\\"acceptance cases:\\\", len(reg[\\\"acceptance_cases\\\"]))\\nprint(\\\"5.3 cases:\\\", g53[\\\"acceptance_cases\\\"][-2:])\\nprint(\\\"2.2 cases:\\\", g22[\\\"acceptance_cases\\\"][-2:])\\nEOF\",\n  \"description\": \"Add property cases to ownership registry\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"acceptance cases: 113\\n5.3 cases: ['lease-ownership-union-properties', 'lease-ownership-store-properties']\\n2.2 cases: ['lease-ownership-union-properties', 'lease-ownership-gate-properties']\\n\",\n  \"original_output_bytes\": 189,\n  \"original_output_tokens\": 48,\n  \"truncated\": false\n}","final_result":true}}}
