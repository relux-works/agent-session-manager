8:\\tif len(identifiers) != 157 {\\n1139:\\t\\tt.Fatalf(\\\"pinned heading inventory = %d, want 157\\\", len(identifiers))\\n1148:\\t\\tif len(inventory) != 0 {\\n1166:\\tif len(blind) != 19 {\\n1167:\\t\\tt.Fatalf(\\\"scanner-blind headings = %d, want 19 of 157\\\", len(blind))\\n===\\ninternal/traceability/traceability_test.go:22:func TestVerifyRepositoryAcceptsExactOwnership(t *testing.T) {\\ninternal/traceability/traceability_test.go:65:func TestVerifyAssignedSectionsBindsGranularScopeToOwnersAndExecutableCases(t *testing.T) {\\ninternal/traceability/traceability_test.go:103:func TestVerifyAssignedSectionsRejectsPinnedSectionWithoutScopedImplementation(t *testing.T) {\\ninternal/traceability/traceability_test.go:113:func TestVerifyAssignedSectionsRejectsMalformedUnpinnedAndEmptyScope(t *testing.T) {\\ninternal/traceability/traceability_test.go:136:func TestResolveAssignedSectionsRejectsRealButUnpinnedSection(t *testing.T) {\\ninternal/traceability/traceability_test.go:145:func TestVerifyRepositoryRejectsNarrowedOwnership(t *testing.T) {\\ninternal/traceability/traceability_test.go:230:func TestVerifyRepositoryRefusesStaleV050Lock(t *testing.T) {\\ninternal/traceability/traceability_test.go:252:func TestVerifyRepositoryRefusesMissingSelectorContract(t *testing.T) {\\ninternal/traceability/traceability_test.go:281:func TestCatalogSectionBindingCoverageIsExactAndDoesNotClaimUnimplementedScope(t *testing.T) {\\ninternal/traceability/traceability_test.go:305:func TestVerifyRepositoryRejectsAbsentAcceptanceTestDeclaration(t *testing.T) {\\ninternal/traceability/traceability_test.go:313:\\t\\t\\\"func TestRunReportsExactCoverageAndFailsClosed(\\\",\\ninternal/traceability/traceability_test.go:314:\\t\\t\\\"func TestRunReportsExactCoverageAndFailsClosedWithoutOwnership(\\\",\\ninternal/traceability/traceability_test.go:324:func TestSourceCheckerAcceptsNativeFuzzAndRejectsNonExecutableHelpers(t *testing.T) {\\ninternal/traceability/traceability_test.go:349:func TestVerif