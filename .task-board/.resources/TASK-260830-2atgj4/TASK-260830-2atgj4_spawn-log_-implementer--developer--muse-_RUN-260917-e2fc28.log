{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c52b","stream":{"kind":"session","id":"01a0ae38-1954-7242-9b52-ff7ca6c9b52f"},"sequence":240,"recorded_at":1780531400000475,"record_type":"event","durability":"durable","causation_id":"815552bd-492d-441d-89cf-fcae5a028cc4","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"815552bd-492d-441d-89cf-fcae5a028cc4","run_stream":{"kind":"run","id":"815552bd-492d-441d-89cf-fcae5a028cc4"},"call_id":"call_01a0ae389258776ea2b4c2d16099079c","text":"Read text file `internal/sessstate/sessstate.go`.\n(983 line(s) above)\n984|// applyLocalLease derives the local projection: the owner host of the\n985|// newest authoritative event decides the local role against the\n986|// caller-supplied host, and a local lease that lost the tuple rule\n987|// stales the projection exactly where the table lets it go stale.\n988|func (fold *chainFold) applyLocalLease(local LeaseHead, localHostID string) {\n989|\tif localHostID != \"\" && fold.projection.OwnerHostID != \"\" {\n990|\t\tif localHostID == fold.projection.OwnerHostID {\n991|\t\t\tfold.projection.LocalRole = \"owner\"\n992|\t\t} else {\n993|\t\t\tfold.projection.LocalRole = \"replica\"\n994|\t\t}\n995|\t}\n996|\tif local.IsZero() || !fold.haveLease {\n997|\t\treturn\n998|\t}\n999|\t// Only a lease that lost the tuple rule stales the projection:\n1000|\t// an equal or strictly greater local lease stands with the\n1001|\t// winner instead of reporting stale.\n1002|\tif Compare(local, fold.projection.Winner) >= 0 {\n1003|\t\treturn\n1004|\t}\n1005|\tif _, ok := staleSources[fold.state]; !ok {\n1006|\t\treturn\n1007|\t}\n1008|\tfold.state = StateStale\n1009|\tfold.projection.State = StateStale\n1010|}\n1011|\n1012|// emitWarnings publishes the sorted unique warnings this leaf derives:\n1013|// divergent history behind any lease or provider conflict, a stale\n1014|// local process, and the parked blocking reason. Capability,\n1015|// authentication, and sync-age warnings belong to other leaves.\n1016|func (fold *chainFold) emitWarnings() {\n1017|\tfold.projection.State = fold.state\n1018|\twarnings := map[string]struct{}{}\n1019|\tfor _, conflict := range fold.projection.Conflicts {\n1020|\t\tswitch conflict.Kind {\n1021|\t\tcase ConflictSameEpochTie, ConflictEpochGap, ConflictLosingBranchPreserved,\n1022|\t\t\tConflictUnionSupersedesChain, ConflictProviderMismatch:\n1023|\t\t\twarnings[\"divergent_history\"] = struct{}{}\n1024|\t\t}\n1025|\t}\n1026|\tif fold.state == StateStale {\n1027|\t\twarnings[\"stale_process\"] = struct{}{}\n1028|\t}\n1029|\tif fold.projection.Parked != nil {\n1030|\t\twarnings[\"parked: \"+fold.projection.Parked.BlockingReason] = struct{}{}\n1031|\t}\n1032|\tif len(warnings) == 0 {\n1033|\t\treturn\n1034|\t}\n1035|\tordered := make([]string, 0, len(warnings))\n1036|\tfor warning := range warnings {\n1037|\t\tordered = append(ordered, warning)\n1038|\t}\n1039|\tsort.Strings(ordered)\n1040|\tfold.projection.Warnings = ordered\n1041|}\n1042|\n1043|func containsString(haystack []string, needle string) bool {\n1044|\tfor _, candidate := range haystack {\n1045|\t\tif candidate == needle {\n1046|\t\t\treturn true\n1047|\t\t}\n1048|\t}\n1049|\treturn false\n1050|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
