{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4df","stream":{"kind":"session","id":"01a0ae38-1954-7242-9b52-ff7ca6c9b52f"},"sequence":202,"recorded_at":1780531400000399,"record_type":"event","durability":"durable","causation_id":"815552bd-492d-441d-89cf-fcae5a028cc4","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"815552bd-492d-441d-89cf-fcae5a028cc4","run_stream":{"kind":"run","id":"815552bd-492d-441d-89cf-fcae5a028cc4"},"task_stream":{"kind":"task","id":"01a0ae38-8563-7812-8d84-3e33c35f2d44"},"task_id":"01a0ae38-8563-7812-8d84-3e33c35f2d44","event":{"kind":"output","task_id":"01a0ae38-8563-7812-8d84-3e33c35f2d44","chunk":"Read text file `internal/fencing/token.go`.\n1|package fencing\n2|\n3|// leaseSealToken is deliberately unexported and is minted only by the\n4|// free mintLeaseToken constructor below. The type-level census pins\n5|// that construction boundary across every production source file; the\n6|// token then makes a zero or field-assembled LeaseToken unusable at\n7|// runtime. There is no exported constructor and no exported field: a\n8|// caller outside this package cannot spell a live token.\n9|type leaseSealToken struct{}\n10|\n11|// leaseSeal holds the fenced authority a passed gate established: the\n12|// session with the exact winning (epoch, lease_id) tuple. Its fields\n13|// are private so callers cannot treat the minted projection as a\n14|// public record-shaped DTO.\n15|type leaseSeal struct {\n16|\ttoken   *leaseSealToken\n17|\tsession string\n18|\tepoch   uint64\n19|\tleaseID string\n20|}\n21|\n22|// LeaseToken is the sealed fencing capability Authorize mints for a\n23|// passed gate: the Section 7.5 LeaseToken projection\n24|// {session_id, lease_epoch, lease_id} for provider operations. A zero\n25|// value or a value assembled without the constructor-only seal token\n26|// is not authority, even when a caller fills the outer struct.\n27|type LeaseToken struct {\n28|\tseal *leaseSeal\n29|}\n30|\n31|// mintLeaseToken is the single constructor for a live LeaseToken. It\n32|// runs only at the end of Authorize, after every ownership, grant,\n33|// and tuple arm has passed.\n34|func mintLeaseToken(session string, epoch uint64, leaseID string) LeaseToken {\n35|\treturn LeaseToken{seal: &leaseSeal{token: &leaseSealToken{}, session: session, epoch: epoch, leaseID: leaseID}}\n36|}\n37|\n38|// authority opens the seal for the capability consumers. A missing\n39|// seal or seal token refuses lease_conflict before any other check,\n40|// so forgery can never degrade into a different class.\n41|func (token LeaseToken) authority() (*leaseSeal, error) {\n42|\tif token.seal == nil || token.seal.token == nil {\n43|\t\treturn nil, refuse(ErrLeaseConflict, \"fencing capability seal is missing\")\n44|\t}\n45|\treturn token.seal, nil\n46|}\n47|\n48|// ProviderOperation is one Section 7.5 provider operation that carries\n49|// the LeaseToken. Resume, stop, materialize-commit, and\n50|// native-store-plan carry the same triple on the wire; their callers\n51|// have no gate entry in this package yet, so binding them here would\n52|// be an untestable claim and stays a stated bound.\n53|type ProviderOperation string\n54|\n55|const (\n56|\t// ProviderQuiesce binds the token to a quiesce operation.\n57|\tProviderQuiesce ProviderOperation = \"quiesce\"\n58|\t// ProviderCapture binds the token to a capture operation.\n59|\tProviderCapture ProviderOperation = \"capture\"\n60|\t// ProviderMaterialize binds the token to a materialize operation.\n61|\tProviderMaterialize ProviderOperation = \"materialize\"\n62|)\n63|\n64|// validProviderOperation reports whether op is a bound provider\n65|// operation. Anything else is a malformed bind call.\n66|func validProviderOperation(op ProviderOperation) bool {\n67|\tswitch op {\n68|\tcase ProviderQuiesce, ProviderCapture, ProviderMaterialize:\n69|\t\treturn true\n70|\t}\n71|\treturn false\n72|}\n73|\n74|// ProviderLease is the wire projection of a bound capability: the\n75|// Section 7.5 LeaseToken triple with the operation it authorizes. It\n76|// carries no seal because it is evidence of one past authorization,\n77|// not authority for another; only Bind mints it, and only from a live\n78|// sealed token.\n79|type ProviderLease struct {\n80|\tSessionID string\n81|\tEpoch     uint64\n82|\tLeaseID   string\n83|\tOperation ProviderOperation\n84|}\n85|\n86|// Bind projects a live LeaseToken onto one provider operation. A zero\n87|// or forged token refuses lease_conflict; an unknown operation refuses\n88|// invalid_arguments. Only a token minted by a passed Authorize gate\n89|// reaches the projection.\n90|func (token LeaseToken) Bind(operation ProviderOperation) (ProviderLease, error) {\n91|\tseal, err := token.authority()\n92|\tif err != nil {\n93|\t\treturn ProviderLease{}, err\n94|\t}\n95|\tif !validProviderOperation(operation) {\n96|\t\treturn ProviderLease{}, refuse(ErrInvalidArguments, \"unknown provider operation %q\", string(operation))\n97|\t}\n98|\treturn ProviderLease{SessionID: seal.session, Epoch: seal.epoch, LeaseID: seal.leaseID, Operation: operation}, nil\n99|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e1","stream":{"kind":"session","id":"01a0ae38-1954-7242-9b52-ff7ca6c9b52f"},"sequence":203,"recorded_at":1780531400000401,"record_type":"event","durability":"durable","causation_id":"815552bd-492d-441d-89cf-fcae5a028cc4","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"815552bd-492d-441d-89cf-fcae5a028cc4","run_stream":{"kind":"run","id":"815552bd-492d-441d-89cf-fcae5a028cc4"},"task_stream":{"kind":"task","id":"01a0ae38-8563-7812-8d84-3e33c35f2d44"},"task_id":"01a0ae38-8563-7812-8d84-3e33c35f2d44","event":{"kind":"completed","task_id":"01a0ae38-8563-7812-8d84-3e33c35f2d44"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e3","stream":{"kind":"session","id":"01a0ae38-1954-7242-9b52-ff7ca6c9b52f"},"sequence":204,"recorded_at":1780531400000403,"record_type":"event","durability":"durable","causation_id":"815552bd-492d-441d-89cf-fcae5a028cc4","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"815552bd-492d-441d-89cf-fcae5a028cc4","run_stream":{"kind":"run","id":"815552bd-492d-441d-89cf-fcae5a028cc4"},"call_id":"call_01a0ae387db770b391faff4f5c3d4fa1","text":"Read text file `internal/sessstate/sessstate.go`.\n(499 line(s) above)\n500|\t\treturn true, nil\n501|\tdefault:\n502|\t\treturn false, refuse(ErrStaleLease, \"event %s lease epoch %d precedes chain head epoch %d\", event.ID, lease.Epoch, fold.current.Epoch)\n503|\t}\n504|}\n505|\n506|// tailID and tailSeq live beside the fold; declared here to keep the\n507|// struct literal above readable.\n508|func (fold *chainFold) conflict(kind, rule, format string, arguments ...any) {\n509|\tfold.projection.Conflicts = append(fold.projection.Conflicts, Conflict{\n510|\t\tKind:   kind,\n511|\t\tRule:   rule,\n512|\t\tDetail: fmt.Sprintf(format, arguments...),\n513|\t})\n514|}\n515|\n516|// step moves the derivation through the Section 5.7 table. An empty\n517|// target keeps the state (a fact or inert event performs no\n518|// transition); an equal target restates it (a confirming event while\n519|// already there is not a transition); the first event may only open a\n520|// bootstrap state; every other move needs its table edge, else\n521|// invalid_state_transition.\n522|func (fold *chainFold) step(target State, what string) error {\n523|\tif target == \"\" || target == fold.state {\n524|\t\treturn nil\n525|\t}\n526|\tif fold.state == \"\" {\n527|\t\tif _, ok := initialTargets[target]; !ok {\n528|\t\t\treturn refuse(ErrInvalidTransition, \"%s opens unbootstrapped state %q\", what, string(target))\n529|\t\t}\n530|\t\tfold.state = target\n531|\t\treturn nil\n532|\t}\n533|\tif _, ok := allowedTransitions[fold.state][target]; !ok {\n534|\t\treturn refuse(ErrInvalidTransition, \"%s moves %q to %q without a Section 5.7 edge\", what, string(fold.state), string(target))\n535|\t}\n536|\tfold.state = target\n537|\treturn nil\n538|}\n539|\n540|// effect applies one event's lifecycle meaning after continuity and\n541|// lease tracking. Fact events return an empty target and keep the\n542|// state; unknown v1 types and the v2/v3/v4 non-lifecycle types are\n543|// inert by Section 5.2 (retained, never applied).\n544|func (fold *chainFold) effect(event Event, lease LeaseHead, succession bool) error {\n545|\tname := \"event \" + event.Type + \" \" + event.ID\n546|\tswitch event.Type {\n547|\tcase \"session.created\":\n548|\t\treturn fold.effectCreated(event, name)\n549|\tcase \"terminal.created\":\n550|\t\treturn fold.effectTerminalCreated(event, name)\n551|\tcase \"provider.launched\":\n552|\t\treturn fold.effectProviderLaunched(event, name)\n553|\tcase \"provider.identified\":\n554|\t\treturn fold.effectProviderIdentified(event, name)\n555|\tcase \"session.idle\":\n556|\t\treturn fold.step(StateIdle, name)\n557|\tcase \"session.quiescing\":\n558|\t\treturn fold.step(StateQuiescing, name)\n559|\tcase \"checkpoint.created\":\n560|\t\treturn fold.effectCheckpointCreated(event, name)\n561|\tcase \"sync.completed\":\n562|\t\treturn nil\n563|\tcase \"session.stopped\":\n564|\t\treturn fold.effectStopped(event, name)\n565|\tcase \"session.resumed\":\n566|\t\treturn fold.effectResumed(event, name)\n567|\tcase \"session.bootstrap_aborted\":\n568|\t\treturn fold.effectBootstrapAborted(event, name)\n569|\tcase \"lease.transferred\", \"lease.forced\":\n570|\t\treturn fold.effectLease(event, lease, name, succession)\n571|\tcase \"session.parked\":\n572|\t\treturn fold.step(StateParked, name)\n573|\tcase \"session.failed\":\n574|\t\treturn fold.step(StateFailed, name)\n575|\tcase \"fork.created\", \"profile.changed\", \"takeover.force_confirmed\",\n576|\t\t\"replica.replace_confirmed\", \"task_board.adopted\",\n577|\t\t\"tombstone.issued\", \"tombstone.resolved\":\n578|\t\treturn nil\n579|\tcase \"session.tombstoned\":\n580|\t\treturn fold.step(StateTombstoned, name)\n581|\tcase \"task_board.launched\":\n582|\t\treturn fold.effectTaskBoardLaunched(event, name)\n583|\tdefault:\n584|\t\treturn nil\n585|\t}\n586|}\n587|\n588|// effectCreated opens the bootstrap, including the Section 5.7\n589|// failed-to-creating retry: epoch 1 under the same winning create\n590|// lease, no validated checkpoint yet, and no authoritative bootstrap\n591|// abort on record. Anything else that reaches for creating refuses.\n592|func (fold *chainFold) effectCreated(event Event, what string) error {\n593|\tif fold.state == \"\" {\n594|\t\treturn fold.step(StateCreating, what)\n595|\t}\n596|\tif fold.state != StateFailed {\n597|\t\treturn fold.step(StateCreating, what)\n598|\t}\n599|\tif event.LeaseEpoch != 1 || event.LeaseID != fold.createLease.LeaseID ||\n600|\t\tevent.LeaseEpoch != fold.createLease.Epoch {\n601|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap under a new lease\", what)\n602|\t}\n603|\tif fold.seenCheckpoint {\n604|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap past a validated checkpoint\", what)\n605|\t}\n606|\tif fold.seenAbort {\n607|\t\treturn refuse(ErrInvalidTransition, \"%s retries bootstrap past an authoritative abort\", what)\n608|\t}\n609|\treturn fold.step(StateCreating, what)\n610|}\n611|\n612|// effectTerminalCreated records the terminal binding; as the first\n613|// event it also opens the bootstrap in creating.\n614|func (fold *chainFold) effectTerminalCreated(event Event, what string) error {\n615|\tif event.SchemaVersion == \"4.0.0\" {\n616|\t\tbinding, err := payloadString(event.Payload, \"terminal_binding_id\")\n617|\t\tif err != nil {\n618|\t\t\treturn err\n619|\t\t}\n620|\t\tif _, err := scalar.ParseDigest(binding); err != nil {\n621|\t\t\treturn refuse(ErrDerivation, \"%s carries malformed terminal_binding_id: %v\", what, err)\n622|\t\t}\n623|\t\tbackend, err := payloadString(event.Payload, \"terminal_backend_id\")\n624|\t\tif err != nil {\n625|\t\t\treturn err\n626|\t\t}\n627|\t\tif _, err := terminalbackend.ParseID(backend); err != nil {\n628|\t\t\treturn refuse(ErrDerivation, \"%s carries refused terminal backend: %v\", what, err)\n629|\t\t}\n630|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, BindingID: binding, EventID: event.ID}\n631|\t} else {\n632|\t\tbackend, err := payloadString(event.Payload, \"backend\")\n633|\t\tif err != nil {\n634|\t\t\treturn err\n635|\t\t}\n636|\t\tif backend != \"tmux\" && backend != \"conpty\" {\n637|\t\t\treturn refuse(ErrDerivation, \"%s carries unknown terminal backend %q\", what, backend)\n638|\t\t}\n639|\t\tterminalID, err := payloadString(event.Payload, \"terminal_id\")\n640|\t\tif err != nil {\n641|\t\t\treturn err\n642|\t\t}\n643|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, TerminalID: terminalID, EventID: event.ID}\n644|\t}\n645|\tfold.projection.HasTerminal = true\n646|\tif fold.state == \"\" {\n647|\t\treturn fold.step(StateCreating, what)\n648|\t}\n649|\treturn nil\n650|}\n651|\n652|// effectProviderLaunched moves to running and records the launched\n653|// version. The record provider stays authoritative: a launched event\n654|// naming another provider records a provider_mismatch conflict under\n655|// the record-pinned-provider-wins rule instead of rewriting identity.\n656|func (fold *chainFold) effectProviderLaunched(event Event, what string) error {\n657|\tproviderID, err := payloadString(event.Payload, \"provider_id\")\n658|\tif err != nil {\n659|\t\treturn err\n660|\t}\n661|\tversion, err := payloadString(event.Payload, \"provider_version\")\n662|\tif err != nil {\n663|\t\treturn err\n664|\t}\n665|\tif providerID != fold.recordProvider {\n666|\t\tfold.conflict(ConflictProviderMismatch, ResolveRuleRecordPinnedProviderWins,\n667|\t\t\t\"event %s launches provider %q under record provider %q; the record value stays authoritative\",\n668|\t\t\tevent.ID, providerID, fold.recordProvider)\n669|\t} else {\n670|\t\tfold.projection.Provider.Version = version\n671|\t}\n672|\treturn fold.step(StateRunning, what)\n673|}\n674|\n675|// effectProviderIdentified records the newest identity record with\n676|// its confidence.\n677|func (fold *chainFold) effectProviderIdentified(event Event, what string) error {\n678|\trecordID, err := payloadString(event.Payload, \"provider_identity_record_id\")\n679|\tif err != nil {\n680|\t\treturn err\n681|\t}\n682|\tif _, err := scalar.ParseDigest(recordID); err != nil {\n683|\t\treturn refuse(ErrDerivation, \"%s carries malformed provider_identity_record_id: %v\", what, err)\n684|\t}\n685|\tconfidence, err := payloadString(event.Payload, \"confidence\")\n686|\tif err != nil {\n687|\t\treturn err\n688|\t}\n689|\tfold.projection.Provider.IdentityRecordID = recordID\n690|\tfold.projection.Provider.Confidence = confidence\n691|\treturn nil\n692|}\n693|\n694|// effectCheckpointCreated records the newest validated checkpoint and\n695|// moves idle or quiescing into checkpointing, or checkpointing back to\n696|// idle at the validated boundary. Any other lifecycle position refuses:\n697|// a checkpoint cannot land while running, creating, stopped, parked,\n698|// failed, stale, materializing, or tombstoned without the quiesce or\n699|// resume the table requires.\n700|func (fold *chainFold) effectCheckpointCreated(event Event, what string) error {\n701|\tcheckpointID, err := payloadString(event.Payload, \"checkpoint_id\")\n702|\tif err != nil {\n703|\t\treturn err\n704|\t}\n705|\tif _, err := scalar.ParseDigest(checkpointID); err != nil {\n706|\t\treturn refuse(ErrDerivation, \"%s carries malformed checkpoint_id: %v\", what, err)\n707|\t}\n708|\tkind, err := payloadString(event.Payload, \"kind\")\n709|\tif err != nil {\n710|\t\treturn err\n711|\t}\n712|\tfold.noteCheckpoint(checkpointID, kind, event.ID)\n713|\tswitch fold.state {\n714|\tcase \"\", StateIdle, StateQuiescing:\n715|\t\tif fold.state == \"\" {\n716|\t\t\treturn refuse(ErrInvalidTransition, \"%s publishes a checkpoint before any bootstrap\", what)\n717|\t\t}\n718|\t\treturn fold.step(StateCheckpointing, what)\n719|\tcase StateCheckpointing:\n720|\t\treturn fold.step(StateIdle, what)\n721|\tdefault:\n722|\t\treturn fold.step(StateCheckpointing, what)\n723|\t}\n724|}\n725|\n726|// effectStopped derives stopped for a checkpointed closure and failed\n727|// for a bootstrap abort. No event may derive stopped while the newest\n728|// checkpoint is null: the event's own checkpoint counts, so a\n729|// checkpointed stop carries its resumable base with it. A bootstrap\n730|// abort requires the null checkpoint, false resumable and graceful\n731|// values the canonical owner admitted, plus a preceding authoritative\n732|// abort event; an ambiguous live process stays failed with recovery\n733|// diagnostics instead.\n734|func (fold *chainFold) effectStopped(event Event, what string) error {\n735|\tcheckpointID, hasCheckpoint, err := payloadNullableDigest(event.Payload, \"checkpoint_id\")\n736|\tif err != nil {\n737|\t\treturn err\n738|\t}\n739|\tresumable, err := payloadBool(event.Payload, \"resumable\")\n740|\tif err != nil {\n741|\t\treturn err\n742|\t}\n743|\tclosure, err := payloadString(event.Payload, \"closure_kind\")\n744|\tif err != nil {\n745|\t\treturn err\n746|\t}\n747|\tif closure == \"checkpointed\" {\n748|\t\tif !hasCheckpoint || !resumable {\n749|\t\t\treturn refuse(ErrIntegrity, \"%s closes checkpointed without a resumable checkpoint\", what)\n750|\t\t}\n751|\t\tfold.noteCheckpoint(checkpointID, \"\", event.ID)\n752|\t\treturn fold.step(StateStopped, what)\n753|\t}\n754|\tif hasCheckpoint || resumable {\n755|\t\treturn refuse(ErrIntegrity, \"%s closes bootstrap_abort with a checkpoint or resumable set\", what)\n756|\t}\n757|\tif !fold.seenAbort {\n758|\t\treturn refuse(ErrInvalidTransition, \"%s closes bootstrap_abort with no authoritative abort event\", what)\n759|\t}\n760|\treturn fold.step(StateFailed, what)\n761|}\n762|\n763|// effectResumed moves to running under the resumed checkpoint and\n764|// records the terminal binding the resume selected.\n765|func (fold *chainFold) effectResumed(event Event, what string) error {\n766|\tcheckpointID, err := payloadString(event.Payload, \"checkpoint_id\")\n767|\tif err != nil {\n768|\t\treturn err\n769|\t}\n770|\tif _, err := scalar.ParseDigest(checkpointID); err != nil {\n771|\t\treturn refuse(ErrDerivation, \"%s carries malformed checkpoint_id: %v\", what, err)\n772|\t}\n773|\tfold.noteCheckpoint(checkpointID, \"\", event.ID)\n774|\tif event.SchemaVersion == \"4.0.0\" {\n775|\t\tbinding, err := payloadString(event.Payload, \"terminal_binding_id\")\n776|\t\tif err != nil {\n777|\t\t\treturn err\n778|\t\t}\n779|\t\tif _, err := scalar.ParseDigest(binding); err != nil {\n780|\t\t\treturn refuse(ErrDerivation, \"%s carries malformed terminal_binding_id: %v\", what, err)\n781|\t\t}\n782|\t\tbackend, err := payloadString(event.Payload, \"terminal_backend_id\")\n783|\t\tif err != nil {\n784|\t\t\treturn err\n785|\t\t}\n786|\t\tif _, err := terminalbackend.ParseID(backend); err != nil {\n787|\t\t\treturn refuse(ErrDerivation, \"%s carries refused terminal backend: %v\", what, err)\n788|\t\t}\n789|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, BindingID: binding, EventID: event.ID}\n790|\t} else {\n791|\t\tbackend, err := payloadString(event.Payload, \"terminal_backend\")\n792|\t\tif err != nil {\n793|\t\t\treturn err\n794|\t\t}\n795|\t\tif backend != \"tmux\" && backend != \"conpty\" {\n796|\t\t\treturn refuse(ErrDerivation, \"%s carries unknown terminal backend %q\", what, backend)\n797|\t\t}\n798|\t\tnativeID, err := payloadString(event.Payload, \"native_session_id\")\n799|\t\tif err != nil {\n800|\t\t\treturn err\n801|\t\t}\n802|\t\tfold.projection.Terminal = TerminalBinding{Backend: backend, NativeSessionID: nativeID, EventID: event.ID}\n803|\t}\n804|\tfold.projection.HasTerminal = true\n805|\treturn fold.step(StateRunning, what)\n806|}\n807|\n808|// effectBootstrapAborted records the authoritative abort and fails the\n809|// bootstrap. Only the creating session can abort its bootstrap; any\n810|// later abort is invalid_state_transition.\n811|func (fold *chainFold) effectBootstrapAborted(event Event, what string) error {\n812|\tfold.seenAbort = true\n813|\tif fold.state != \"\" && fold.state != StateCreating {\n814|\t\treturn refuse(ErrInvalidTransition, \"%s aborts a bootstrap past creating\", what)\n815|\t}\n816|\treturn fold.step(StateFailed, what)\n817|}\n818|\n819|// effectLease checks the successor-lease payload linkage: the payload\n820|// must name the predecessor the chain stands on and the envelope it\n821|// arrives under, else integrity_failure. The lifecycle move already\n822|// happened in successionMove; a lease event repeating the current\n823|// lease is a fact, not a transition.\n824|func (fold *chainFold) effectLease(event Event, lease LeaseHead, what string, succession bool) error {\n825|\tif !succession {\n826|\t\treturn nil\n827|\t}\n828|\tif event.Type == \"lease.transferred\" {\n829|\t\tpredecessor, err := payloadString(event.Payload, \"predecessor_lease_id\")\n830|\t\tif err != nil {\n831|\t\t\treturn err\n832|\t\t}\n833|\t\tif predecessor != fold.previous.LeaseID {\n834|\t\t\treturn refuse(ErrIntegrity, \"%s transfers from lease %s past chain head lease %s\", what, predecessor, fold.previous.LeaseID)\n835|\t\t}\n836|\t\tsuccessor, err := payloadString(event.Payload, \"new_lease_id\")\n837|\t\tif err != nil {\n838|\t\t\treturn err\n839|\t\t}\n840|\t\tif successor != lease.LeaseID {\n841|\t\t\treturn refuse(ErrIntegrity, \"%s transfers to lease %s outside its envelope lease %s\", what, successor, lease.LeaseID)\n842|\t\t}\n843|\t} else {\n844|\t\tsuccessor, err := payloadString(event.Payload, \"new_lease_id\")\n845|\t\tif err != nil {\n846|\t\t\treturn err\n847|\t\t}\n848|\t\tif successor != lease.LeaseID {\n849|\t\t\treturn refuse(ErrIntegrity, \"%s forces lease %s outside its envelope lease %s\", what, successor, lease.LeaseID)\n850|\t\t}\n851|\t}\n852|\treturn nil\n853|}\n854|\n855|// effectTaskBoardLaunched enforces the Section 5.2 repeat rule — the\n856|// event must repeat the winning creation lease and the Session\n857|// Record's provider and launch mode — then derives the payload's\n858|// running or idle state through the table.\n859|func (fold *chainFold) effectTaskBoardLaunched(event Event, what string) error {\n860|\tproviderID, err := payloadString(event.Payload, \"provider_id\")\n861|\tif err != nil {\n862|\t\treturn err\n863|\t}\n864|\tif providerID != fold.recordProvider {\n865|\t\treturn refuse(ErrIntegrity, \"%s repeats provider %q past record provider %q\", what, providerID, fold.recordProvider)\n866|\t}\n867|\tpayloadEpoch, err := payloadUint(event.Payload, \"lease_epoch\")\n868|\tif err != nil {\n869|\t\treturn err\n870|\t}\n871|\tpayloadLease, err := payloadString(event.Payload, \"lease_id\")\n872|\tif err != nil {\n873|\t\treturn err\n874|\t}\n875|\tif payloadEpoch != fold.createLease.Epoch || payloadLease != fold.createLease.LeaseID {\n876|\t\treturn refuse(ErrIntegrity, \"%s repeats creation lease (%d, %s) past create lease (%d, %s)\", what, payloadEpoch, payloadLease, fold.createLease.Epoch, fold.createLease.LeaseID)\n877|\t}\n878|\treported, err := payloadString(event.Payload, \"state\")\n879|\tif err != nil {\n880|\t\treturn err\n881|\t}\n882|\tif reported == string(StateRunning) {\n883|\t\treturn fold.step(StateRunning, what)\n884|\t}\n885|\treturn fold.step(StateIdle, what)\n886|}\n887|\n888|// noteCheckpoint records the newest validated checkpoint.\n889|func (fold *chainFold) noteCheckpoint(id, kind, eventID string) {\n890|\tfold.seenCheckpoint = true\n891|\tfold.projection.HasCheckpoint = true\n892|\tfold.projection.Newest = Checkpoint{ID: id, Kind: kind, EventID: eventID}\n893|}\n894|\n895|// resolveWinner selects the winning lease over the authoritative chain\n896|// leases and the union leases by the greatest (epoch, lease_id)\n897|// tuple. A same-epoch tie resolves to the bytewise-greater lease ID;\n898|// an off-chain union winner moves the reported winner but never\n899|// rewrites authoritative state; union leases that lose are reported\n900|// preserved-never-applied. With no union the chain head wins alone\n901|// and no conflict is recorded.\n902|func (fold *chainFold) resolveWinner(union []LeaseHead) error {\n903|\twinner := fold.current\n904|\tonChain := map[string]struct{}{}\n905|\tif fold.haveLease {\n906|\t\tonChain[fold.current.LeaseID] = struct{}{}\n907|\t}\n908|\tfor _, lease := range fold.chainLeases() {\n909|\t\tonChain[lease.LeaseID] = struct{}{}\n910|\t}\n911|\tbyEpoch := map[uint64]map[string]struct{}{}\n912|\tnote := func(lease LeaseHead) {\n913|\t\tif byEpoch[lease.Epoch] == nil {\n914|\t\t\tbyEpoch[lease.Epoch] = map[string]struct{}{}\n915|\t\t}\n916|\t\tbyEpoch[lease.Epoch][lease.LeaseID] = struct{}{}\n917|\t}\n918|\tfor _, lease := range fold.chainLeases() {\n919|\t\tnote(lease)\n920|\t}\n921|\toffChainWinner := false\n922|\tfor _, lease := range union {\n923|\t\tif lease.IsZero() {\n924|\t\t\treturn refuse(ErrInvalidEvent, \"union carries an empty lease head\")\n925|\t\t}\n926|\t\tif _, err := scalar.ParseUUIDv4(lease.LeaseID); err != nil {\n927|\t\t\treturn refuse(ErrInvalidEvent, \"union lease %q is not a UUIDv4: %v\", lease.LeaseID, err)\n928|\t\t}\n929|\t\tnote(lease)\n930|\t\tswitch Compare(lease, winner) {\n931|\t\tcase 1:\n932|\t\t\twinner = lease\n933|\t\t\tif _, ok := onChain[lease.LeaseID]; !ok {\n934|\t\t\t\toffChainWinner = true\n935|\t\t\t}\n936|\t\tcase -1:\n937|\t\t\tfold.conflict(ConflictLosingBranchPreserved, ResolveRulePreservedNeverApplied,\n938|\t\t\t\t\"union lease (%d, %s) loses to (%d, %s); its history stays preserved and never applies\",\n939|\t\t\t\tlease.Epoch, lease.LeaseID, winner.Epoch, winner.LeaseID)\n940|\t\tcase 0:\n941|\t\t\t// A duplicate union entry names the tuple already\n942|\t\t\t// selected: the winner and the off-chain flag stand.\n943|\t\t\t// Clearing here would drop a correctly recorded\n944|\t\t\t// union_supersedes_chain conflict (and its\n945|\t\t\t// divergent_history warning) on a repeated entry.\n946|\t\t}\n947|\t}\n948|\tepochs := make([]uint64, 0, len(byEpoch))\n949|\tfor epoch := range byEpoch {\n950|\t\tepochs = append(epochs, epoch)\n951|\t}\n952|\tsort.Slice(epochs, func(i, j int) bool { return epochs[i] < epochs[j] })\n953|\tfor _, epoch := range epochs {\n954|\t\trivals := byEpoch[epoch]\n955|\t\tif len(rivals) < 2 {\n956|\t\t\tcontinue\n957|\t\t}\n958|\t\tordered := make([]string, 0, len(rivals))\n959|\t\tfor id := range rivals {\n960|\t\t\tordered = append(ordered, id)\n961|\t\t}\n962|\t\tsort.Strings(ordered)\n963|\t\tfold.conflict(ConflictSameEpochTie, ResolveRuleGreatestLeaseIDWins,\n964|\t\t\t\"epoch %d is shared by leases %v; the bytewise-greater lease ID %s wins\",\n965|\t\t\tepoch, ordered, ordered[len(ordered)-1])\n966|\t}\n967|\tif offChainWinner {\n968|\t\tfold.conflict(ConflictUnionSupersedesChain, ResolveRuleAuthoritativeStateUnchanged,\n969|\t\t\t\"union winner (%d, %s) stands outside the authoritative chain; derived state is unchanged until an explicit takeover lands\",\n970|\t\t\twinner.Epoch, winner.LeaseID)\n971|\t}\n972|\tfold.projection.Winner = winner\n973|\treturn nil\n974|}\n975|\n976|// chainLeases replays the distinct envelope leases in first-appearance\n977|// order. Every succession appends, so a tie planted at any past epoch\n978|// still resolves against the lease the chain actually stood on. Gaps\n979|// were already recorded at succession time.\n980|func (fold *chainFold) chainLeases() []LeaseHead {\n981|\treturn append([]LeaseHead(nil), fold.leases...)\n982|}\n983|\n984|// applyLocalLease derives the local projection: the owner host of the\n985|// newest authoritative event decides the local role against the\n986|// caller-supplied host, and a local lease that lost the tuple rule\n987|// stales the projection exactly where the table lets it go stale.\n988|func (fold *chainFold) applyLocalLease(local LeaseHead, localHostID string) {\n989|\tif localHostID != \"\" && fold.projection.OwnerHostID != \"\" {\n990|\t\tif localHostID == fold.projection.OwnerHostID {\n991|\t\t\tfold.projection.LocalRole = \"owner\"\n992|\t\t} else {\n993|\t\t\tfold.projection.LocalRole = \"replica\"\n994|\t\t}\n995|\t}\n996|\tif local.IsZero() || !fold.haveLease {\n997|\t\treturn\n998|\t}\n999|\t// Only a lease that lost the tuple rule stales the projection:\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e5","stream":{"kind":"session","id":"01a0ae38-1954-7242-9b52-ff7ca6c9b52f"},"sequence":205,"recorded_at":1780531400000405,"record_type":"event","durability":"durable","causation_id":"815552bd-492d-441d-89cf-fcae5a028cc4","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"815552bd-492d-441d-89cf-fcae5a028cc4","run_stream":{"kind":"run","id":"815552bd-492d-441d-89cf-fcae5a028cc4"},"call_id":"call_01a0ae387f92770ab33d7c54df060e8f","text":"Read text file `internal/fencing/token.go`.\n1|package fencing\n2|\n3|// leaseSealToken is deliberately unexported and is minted only by the\n4|// free mintLeaseToken constructor below. The type-level census pins\n5|// that construction boundary across every production source file; the\n6|// token then makes a zero or field-assembled LeaseToken unusable at\n7|// runtime. There is no exported constructor and no exported field: a\n8|// caller outside this package cannot spell a live token.\n9|type leaseSealToken struct{}\n10|\n11|// leaseSeal holds the fenced authority a passed gate established: the\n12|// session with the exact winning (epoch, lease_id) tuple. Its fields\n13|// are private so callers cannot treat the minted projection as a\n14|// public record-shaped DTO.\n15|type leaseSeal struct {\n16|\ttoken   *leaseSealToken\n17|\tsession string\n18|\tepoch   uint64\n19|\tleaseID string\n20|}\n21|\n22|// LeaseToken is the sealed fencing capability Authorize mints for a\n23|// passed gate: the Section 7.5 LeaseToken projection\n24|// {session_id, lease_epoch, lease_id} for provider operations. A zero\n25|// value or a value assembled without the constructor-only seal token\n26|// is not authority, even when a caller fills the outer struct.\n27|type LeaseToken struct {\n28|\tseal *leaseSeal\n29|}\n30|\n31|// mintLeaseToken is the single constructor for a live LeaseToken. It\n32|// runs only at the end of Authorize, after every ownership, grant,\n33|// and tuple arm has passed.\n34|func mintLeaseToken(session string, epoch uint64, leaseID string) LeaseToken {\n35|\treturn LeaseToken{seal: &leaseSeal{token: &leaseSealToken{}, session: session, epoch: epoch, leaseID: leaseID}}\n36|}\n37|\n38|// authority opens the seal for the capability consumers. A missing\n39|// seal or seal token refuses lease_conflict before any other check,\n40|// so forgery can never degrade into a different class.\n41|func (token LeaseToken) authority() (*leaseSeal, error) {\n42|\tif token.seal == nil || token.seal.token == nil {\n43|\t\treturn nil, refuse(ErrLeaseConflict, \"fencing capability seal is missing\")\n44|\t}\n45|\treturn token.seal, nil\n46|}\n47|\n48|// ProviderOperation is one Section 7.5 provider operation that carries\n49|// the LeaseToken. Resume, stop, materialize-commit, and\n50|// native-store-plan carry the same triple on the wire; their callers\n51|// have no gate entry in this package yet, so binding them here would\n52|// be an untestable claim and stays a stated bound.\n53|type ProviderOperation string\n54|\n55|const (\n56|\t// ProviderQuiesce binds the token to a quiesce operation.\n57|\tProviderQuiesce ProviderOperation = \"quiesce\"\n58|\t// ProviderCapture binds the token to a capture operation.\n59|\tProviderCapture ProviderOperation = \"capture\"\n60|\t// ProviderMaterialize binds the token to a materialize operation.\n61|\tProviderMaterialize ProviderOperation = \"materialize\"\n62|)\n63|\n64|// validProviderOperation reports whether op is a bound provider\n65|// operation. Anything else is a malformed bind call.\n66|func validProviderOperation(op ProviderOperation) bool {\n67|\tswitch op {\n68|\tcase ProviderQuiesce, ProviderCapture, ProviderMaterialize:\n69|\t\treturn true\n70|\t}\n71|\treturn false\n72|}\n73|\n74|// ProviderLease is the wire projection of a bound capability: the\n75|// Section 7.5 LeaseToken triple with the operation it authorizes. It\n76|// carries no seal because it is evidence of one past authorization,\n77|// not authority for another; only Bind mints it, and only from a live\n78|// sealed token.\n79|type ProviderLease struct {\n80|\tSessionID string\n81|\tEpoch     uint64\n82|\tLeaseID   string\n83|\tOperation ProviderOperation\n84|}\n85|\n86|// Bind projects a live LeaseToken onto one provider operation. A zero\n87|// or forged token refuses lease_conflict; an unknown operation refuses\n88|// invalid_arguments. Only a token minted by a passed Authorize gate\n89|// reaches the projection.\n90|func (token LeaseToken) Bind(operation ProviderOperation) (ProviderLease, error) {\n91|\tseal, err := token.authority()\n92|\tif err != nil {\n93|\t\treturn ProviderLease{}, err\n94|\t}\n95|\tif !validProviderOperation(operation) {\n96|\t\treturn ProviderLease{}, refuse(ErrInvalidArguments, \"unknown provider operation %q\", string(operation))\n97|\t}\n98|\treturn ProviderLease{SessionID: seal.session, Epoch: seal.epoch, LeaseID: seal.leaseID, Operation: operation}, nil\n99|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e7","stream":{"kind":"session","id":"01a0ae38-1954-7242-9b52-ff7ca6c9b52f"},"sequence":206,"recorded_at":1780531400000407,"record_type":"event","durability":"durable","causation_id":"815552bd-492d-441d-89cf-fcae5a028cc4","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"815552bd-492d-441d-89cf-fcae5a028cc4","run_stream":{"kind":"run","id":"815552bd-492d-441d-89cf-fcae5a028cc4"},"call_id":"call_01a0ae3880f576beb785671a42208936","text":"Read text file `internal/traceability/traceability.go`.\n1|// Package traceability verifies that the pinned AX specification inventory\n2|// remains bound to concrete production declarations and executable acceptance\n3|// cases. It is a read-only repository gate; it does not advertise runtime\n4|// capabilities or mutate implementation state.\n5|package traceability\n6|\n7|import (\n8|\t\"bytes\"\n9|\t\"crypto/sha256\"\n10|\t\"encoding/hex\"\n11|\t\"encoding/json\"\n12|\t\"errors\"\n13|\t\"fmt\"\n14|\t\"go/ast\"\n15|\t\"go/parser\"\n16|\t\"go/token\"\n17|\t\"io\"\n18|\t\"io/fs\"\n19|\t\"path\"\n20|\t\"regexp\"\n21|\t\"strings\"\n22|\t\"unicode\"\n23|\t\"unicode/utf8\"\n24|\n25|\t\"github.com/relux-works/agent-session-manager/internal/catalog\"\n26|\t\"github.com/relux-works/agent-session-manager/internal/cataloggen\"\n27|\t\"github.com/relux-works/agent-session-manager/internal/specdoc\"\n28|\t\"github.com/relux-works/agent-session-manager/internal/specpin\"\n29|)\n30|\n31|const (\n32|\townershipRegistryPath = \"internal/traceability/ownership.v0.6.0.json\"\n33|\tcontractLockPath      = \"internal/specpin/v0.6.0.lock.json\"\n34|\tcatalogMetadataPath   = \"internal/catalog/catalog.v0.6.0.json\"\n35|\tgeneratedCatalogPath  = \"internal/catalog/catalog_gen.go\"\n36|\n37|\townershipFormat        = \"ax-spec-to-code-ownership\"\n38|\townershipFormatVersion = 1\n39|\n40|\t// reviewedOwnershipCanonicalSHA256 pins the semantic JSON projection. JSON\n41|\t// formatting may change, but ownership claims cannot be self-minted without\n42|\t// an explicit review of this binding.\n43|\treviewedOwnershipCanonicalSHA256 = \"94e589c880a263a61fe3e4e12ed836e076dd7e5bc074b6f6596de35231a53417\"\n44|)\n45|\n46|var ErrTraceability = errors.New(\"spec-to-code traceability check failed\")\n47|\n48|// Report contains inventory coverage only. These counts do not claim that any\n49|// runtime capability is available, enabled, or supported.\n50|type Report struct {\n51|\tContracts              int\n52|\tNormativeSections      int\n53|\tAcceptanceCases        int\n54|\tFixtures               int\n55|\tCompatibilityContracts int\n56|\tAssignedScopes         int\n57|\n58|\t// SectionBindings and the coverage counters below are a measured ratio over\n59|\t// the registered section bindings, not a prose claim. NormativeClauses is\n60|\t// the number of RFC 2119 clause lines the pinned document itself carries in\n61|\t// the bound sections; DischargedClauses is how many of those a binding\n62|\t// enumerates with a verified excerpt and an acceptance owner.\n63|\tSectionBindings     int\n64|\tFullCoverage        int\n65|\tPartialCoverage     int\n66|\tSliverCoverage      int\n67|\tUnevidencedCoverage int\n68|\tUnmeasuredCoverage  int\n69|\tUnownedSections     int\n70|\tNormativeClauses    int\n71|\tDischargedClauses   int\n72|}\n73|\n74|type ownershipKind string\n75|\n76|const (\n77|\townershipContract         ownershipKind = \"contract\"\n78|\townershipNormativeSection ownershipKind = \"normative_section\"\n79|\townershipSectionBinding   ownershipKind = \"section_binding\"\n80|\townershipFixture          ownershipKind = \"fixture\"\n81|)\n82|\n83|type ownershipRegistry struct {\n84|\tFormat          string           `json:\"format\"`\n85|\tFormatVersion   int              `json:\"format_version\"`\n86|\tSource          registrySource   `json:\"source\"`\n87|\tAcceptanceCases []acceptanceCase `json:\"acceptance_cases\"`\n88|\tOwnership       []ownershipGroup `json:\"ownership\"`\n89|\tUnownedSections []unownedSection `json:\"unowned_sections\"`\n90|}\n91|\n92|// unownedSection records a real v0.6.0 section that this repository does not\n93|// implement. It exists so an unimplemented section is disclosed by name rather\n94|// than bound to a symbol from a neighbouring package, which is what an owned\n95|// key would otherwise assert. It is a disclosure, never an exemption: a section\n96|// the generated catalog requires an owner for may not be declared here, and\n97|// assigned-scope admission refuses an unowned section and prints its gap.\n98|type unownedSection struct {\n99|\tKey      string `json:\"key\"`\n100|\tGap      string `json:\"gap\"`\n101|\tEvidence string `json:\"evidence\"`\n102|}\n103|\n104|type registrySource struct {\n105|\tRepository     string `json:\"repository\"`\n106|\tRelease        string `json:\"release\"`\n107|\tCommit         string `json:\"commit\"`\n108|\tDocumentPath   string `json:\"document_path\"`\n109|\tDocumentSHA256 string `json:\"document_sha256\"`\n110|}\n111|\n112|type acceptanceCase struct {\n113|\tID         string          `json:\"id\"`\n114|\tProduction codeReference   `json:\"production\"`\n115|\tTests      []codeReference `json:\"tests\"`\n116|}\n117|\n118|type ownershipGroup struct {\n119|\tKind            ownershipKind      `json:\"kind\"`\n120|\tKeys            []string           `json:\"keys\"`\n121|\tProduction      codeReference      `json:\"production\"`\n122|\tAcceptanceCases []string           `json:\"acceptance_cases\"`\n123|\tCoverage        coverageLevel      `json:\"coverage,omitempty\"`\n124|\tGap             string             `json:\"gap,omitempty\"`\n125|\tClauses         []dischargedClause `json:\"clauses,omitempty\"`\n126|}\n127|\n128|// coverageLevel is how much of a bound section a binding claims to discharge.\n129|// The claim is not taken on trust: the level is recomputed from the clauses the\n130|// binding enumerates against the clause inventory the pinned specification\n131|// itself carries for that section, and a claim that differs from the measured\n132|// level is refused.\n133|type coverageLevel string\n134|\n135|const (\n136|\t// coverageFull means every normative clause the pinned section carries is\n137|\t// enumerated with a verified excerpt and an acceptance owner.\n138|\tcoverageFull coverageLevel = \"full\"\n139|\t// coveragePartial means at least half of them are.\n140|\tcoveragePartial coverageLevel = \"partial\"\n141|\t// coverageSliver means fewer than half are: the binding implements a corner\n142|\t// of the section it is registered against.\n143|\tcoverageSliver coverageLevel = \"sliver\"\n144|\t// coverageUnevidenced means the binding enumerates no clause at all. It says\n145|\t// the registry makes no clause-level claim, not that the implementation\n146|\t// covers nothing.\n147|\tcoverageUnevidenced coverageLevel = \"unevidenced\"\n148|\t// coverageUnmeasured means normativeKeywordPattern finds no clause line\n149|\t// under the section's heading or its subheadings, so the gate cannot\n150|\t// measure the section's obligations at all.\n151|\t//\n152|\t// It is deliberately NOT called \"declarative\", and it does NOT mean the\n153|\t// section carries no obligation. Nineteen of the 157 pinned headings are in\n154|\t// this class and every one of them has a substantive body: Section 15.2 is a\n155|\t// eighteen-row normative exit-code registry and Section 7.3 is the closed\n156|\t// Provider Manifest, both of which state their obligations as tables rather\n157|\t// than in uppercase RFC 2119 keywords. Treating that silence as \"nothing to\n158|\t// discharge\" is the same free pass this gate exists to remove, reached\n159|\t// through the scanner instead of through the label, so an unmeasured binding\n160|\t// carries the same mandatory gap as every other level below full and is\n161|\t// refused for assigned-scope admission.\n162|\tcoverageUnmeasured coverageLevel = \"unmeasured\"\n163|)\n164|\n165|// dischargedClause binds one normative clause of the pinned section to the\n166|// acceptance cases that discharge it. Every field is checked against the\n167|// hash-verified document: the identifier must index the section's own clause\n168|// inventory, the line must be the line that clause occupies, and the excerpt\n169|// must be that clause's text quoted verbatim, so a clause cannot be claimed\n170|// with a true sentence about something else.\n171|type dischargedClause struct {\n172|\tID              string   `json:\"id\"`\n173|\tLine            int      `json:\"line\"`\n174|\tExcerpt         string   `json:\"excerpt\"`\n175|\tAcceptanceCases []string `json:\"acceptance_cases\"`\n176|}\n177|\n178|// normativeClause is one RFC 2119 clause line of the pinned specification,\n179|// measured from the document rather than declared by the registry.\n180|type normativeClause struct {\n181|\tID   string\n182|\tLine int\n183|\tText string\n184|}\n185|\n186|type codeReference struct {\n187|\tPath        string `json:\"path\"`\n188|\tDeclaration string `json:\"declaration\"`\n189|}\n190|\n191|type assignedSectionBinding struct {\n192|\tScope string\n193|\tKeys  []string\n194|}\n195|\n196|var assignedSectionPattern = regexp.MustCompile(`^((?:20|1[0-9]|[1-9])(?:\\.(?:[0-9]+|[A-Za-z]))*)(?:-((?:20|1[0-9]|[1-9])(?:\\.(?:[0-9]+|[A-Za-z]))*))?$`)\n197|var catalogAppendixPattern = regexp.MustCompile(`(?i)^Appendix ([A-D]):`)\n198|\n199|// VerifyRepository is the production CI entry point. It verifies exact pinned\n200|// inputs, stale generated output, compatibility coverage, and every registered\n201|// ownership reference against the supplied repository filesystem.\n202|func VerifyRepository(repository fs.FS) (Report, error) {\n203|\treturn verifyRepository(repository, nil)\n204|}\n205|\n206|// VerifyAssignedSections is the production Story-scope entry point. Each exact\n207|// assigned subsection, or every heading in a same-section range, must have its\n208|// own scoped production declaration and executable acceptance-case link. A\n209|// pinned top-level source owner alone never satisfies assigned-scope admission.\n210|func VerifyAssignedSections(repository fs.FS, sections []string) (Report, error) {\n211|\tif len(sections) == 0 {\n212|\t\treturn Report{}, fail(\"assigned section scope is empty\")\n213|\t}\n214|\treturn verifyRepository(repository, sections)\n215|}\n216|\n217|func verifyRepository(repository fs.FS, assignedSections []string) (Report, error) {\n218|\tif repository == nil {\n219|\t\treturn Report{}, fail(\"repository filesystem is nil\")\n220|\t}\n221|\n222|\tlockBytes, err := readRequired(repository, contractLockPath)\n223|\tif err != nil {\n224|\t\treturn Report{}, err\n225|\t}\n226|\tmanifest, err := specpin.VerifyV060(lockBytes)\n227|\tif err != nil {\n228|\t\treturn Report{}, fail(\"verify normative source lock: %v\", err)\n229|\t}\n230|\n231|\tmetadataBytes, err := readRequired(repository, catalogMetadataPath)\n232|\tif err != nil {\n233|\t\treturn Report{}, err\n234|\t}\n235|\tgenerated, err := cataloggen.Generate(metadataBytes, lockBytes)\n236|\tif err != nil {\n237|\t\treturn Report{}, fail(\"verify reviewed catalog metadata: %v\", err)\n238|\t}\n239|\tcommittedGenerated, err := readRequired(repository, generatedCatalogPath)\n240|\tif err != nil {\n241|\t\treturn Report{}, err\n242|\t}\n243|\tif !bytes.Equal(generated, committedGenerated) {\n244|\t\treturn Report{}, fail(\"generated catalog is stale; run go generate ./internal/catalog\")\n245|\t}\n246|\n247|\tcurrentCatalog, err := catalog.ForRelease(catalog.ReleaseV060)\n248|\tif err != nil {\n249|\t\treturn Report{}, fail(\"load current catalog: %v\", err)\n250|\t}\n251|\tif err := verifyCatalogContracts(manifest.Contracts, currentCatalog.Contracts); err != nil {\n252|\t\treturn Report{}, err\n253|\t}\n254|\t// The legacy projection keeps the superseded v0.5.0 registry honest:\n255|\t// the generated catalog must still carry the exact historical rows the\n256|\t// adopted lock derives, so legacy support claims stay verifiable after\n257|\t// the authority moved to v0.6.0.\n258|\tlegacyContracts, err := manifest.ContractsForRelease(specpin.ReleaseV050)\n259|\tif err != nil {\n260|\t\treturn Report{}, fail(\"derive legacy catalog contracts: %v\", err)\n261|\t}\n262|\tlegacyCatalog, err := catalog.ForRelease(catalog.ReleaseV050)\n263|\tif err != nil {\n264|\t\treturn Report{}, fail(\"load legacy catalog: %v\", err)\n265|\t}\n266|\tif err := verifyCatalogContracts(legacyContracts, legacyCatalog.Contracts); err != nil {\n267|\t\treturn Report{}, err\n268|\t}\n269|\tcompatibilityCatalog, err := catalog.ForRelease(catalog.ReleaseV043)\n270|\tif err != nil {\n271|\t\treturn Report{}, fail(\"load compatibility catalog: %v\", err)\n272|\t}\n273|\n274|\tregistryBytes, err := readRequired(repository, ownershipRegistryPath)\n275|\tif err != nil {\n276|\t\treturn Report{}, err\n277|\t}\n278|\tregistry, err := decodeOwnershipRegistry(registryBytes)\n279|\tif err != nil {\n280|\t\treturn Report{}, err\n281|\t}\n282|\tbindings, err := resolveAssignedSections(manifest.Source.NormativeScope, assignedSections)\n283|\tif err != nil {\n284|\t\treturn Report{}, err\n285|\t}\n286|\tdocument, err := specdoc.LoadV060()\n287|\tif err != nil {\n288|\t\treturn Report{}, fail(\"load pinned specification document: %v\", err)\n289|\t}\n290|\tif manifest.Source.Document.SHA256 != specpin.DocumentSHA256V060 {\n291|\t\treturn Report{}, fail(\n292|\t\t\t\"verified normative lock document digest %s differs from the pinned clause source %s\",\n293|\t\t\tmanifest.Source.Document.SHA256, specpin.DocumentSHA256V060)\n294|\t}\n295|\treturn verifyOwnership(repository, document, registry, manifest, currentCatalog, compatibilityCatalog, bindings)\n296|}\n297|\n298|func readRequired(repository fs.FS, filename string) ([]byte, error) {\n299|\tvalue, err := fs.ReadFile(repository, filename)\n300|\tif err != nil {\n301|\t\treturn nil, fail(\"read required evidence %q: %v\", filename, err)\n302|\t}\n303|\treturn value, nil\n304|}\n305|\n306|func decodeOwnershipRegistry(candidate []byte) (ownershipRegistry, error) {\n307|\tvar decoded ownershipRegistry\n308|\tdecoder := json.NewDecoder(bytes.NewReader(candidate))\n309|\tdecoder.DisallowUnknownFields()\n310|\tif err := decoder.Decode(&decoded); err != nil {\n311|\t\treturn ownershipRegistry{}, fail(\"decode ownership registry: %v\", err)\n312|\t}\n313|\tvar trailing any\n314|\tif err := decoder.Decode(&trailing); !errors.Is(err, io.EOF) {\n315|\t\tif err == nil {\n316|\t\t\treturn ownershipRegistry{}, fail(\"decode ownership registry: multiple JSON values\")\n317|\t\t}\n318|\t\treturn ownershipRegistry{}, fail(\"decode ownership registry trailing data: %v\", err)\n319|\t}\n320|\treturn decoded, nil\n321|}\n322|\n323|func verifyOwnership(\n324|\trepository fs.FS,\n325|\tdocument *specdoc.Document,\n326|\tregistry ownershipRegistry,\n327|\tmanifest specpin.Manifest,\n328|\tcurrentCatalog catalog.Catalog,\n329|\tcompatibilityCatalog catalog.Catalog,\n330|\tassignedBindings []assignedSectionBinding,\n331|) (Report, error) {\n332|\tif registry.Format != ownershipFormat || registry.FormatVersion != ownershipFormatVersion {\n333|\t\treturn Report{}, fail(\"unsupported ownership registry format %q version %d\", registry.Format, registry.FormatVersion)\n334|\t}\n335|\tsource := registry.Source\n336|\tif source.Repository != manifest.Source.Repository ||\n337|\t\tsource.Release != manifest.Source.Release ||\n338|\t\tsource.Commit != manifest.Source.Commit ||\n339|\t\tsource.DocumentPath != manifest.Source.Document.Path ||\n340|\t\tsource.DocumentSHA256 != manifest.Source.Document.SHA256 {\n341|\t\treturn Report{}, fail(\"ownership registry source differs from verified normative lock\")\n342|\t}\n343|\n344|\texpected := map[ownershipKind]map[string]struct{}{\n345|\t\townershipContract:         expectedContracts(manifest.Contracts),\n346|\t\townershipNormativeSection: expectedNormativeSections(manifest, currentCatalog),\n347|\t\townershipSectionBinding:   expectedSectionBindingInventory(),\n348|\t\townershipFixture:          expectedFixtures(manifest, currentCatalog),\n349|\t}\n350|\trequiredSectionBindings, err := expectedCatalogSectionBindings(currentCatalog)\n351|\tif err != nil {\n352|\t\treturn Report{}, err\n353|\t}\n354|\trequired := map[ownershipKind]map[string]struct{}{\n355|\t\townershipContract:         expected[ownershipContract],\n356|\t\townershipNormativeSection: expected[ownershipNormativeSection],\n357|\t\townershipSectionBinding:   requiredSectionBindings,\n358|\t\townershipFixture:          expected[ownershipFixture],\n359|\t}\n360|\tselectedSectionBindings := map[string]struct{}(nil)\n361|\tif assignedBindings != nil {\n362|\t\trequired = cloneOwnershipSets(expected)\n363|\t\tselectedSectionBindings = make(map[string]struct{})\n364|\t\tfor _, binding := range assignedBindings {\n365|\t\t\tfor _, key := range binding.Keys {\n366|\t\t\t\tselectedSectionBindings[key] = struct{}{}\n367|\t\t\t}\n368|\t\t}\n369|\t\trequired[ownershipSectionBinding] = make(map[string]struct{})\n370|\t}\n371|\tchecker := newSourceChecker(repository)\n372|\tacceptanceIDs, err := verifyAcceptanceCases(checker, registry.AcceptanceCases)\n373|\tif err != nil {\n374|\t\treturn Report{}, err\n375|\t}\n376|\t// Coverage is measured over every registered section binding, not only the\n377|\t// assigned ones, so a sliver planted anywhere in the registry reddens both\n378|\t// production entry points rather than only the repository-wide one. It is\n379|\t// measured before ownership resolution so that a section moved to the\n380|\t// unowned disclosure to dodge the catalog's owner requirement is reported\n381|\t// as that dodge rather than as an ordinary missing owner.\n382|\tcoverage, err := verifySectionCoverage(document, registry.Ownership, acceptanceIDs)\n383|\tif err != nil {\n384|\t\treturn Report{}, err\n385|\t}\n386|\townedSections := make(map[string]struct{}, len(coverage))\n387|\tfor key := range coverage {\n388|\t\townedSections[key] = struct{}{}\n389|\t}\n390|\tunowned, err := verifyUnownedSections(\n391|\t\tregistry.UnownedSections, expected[ownershipSectionBinding], requiredSectionBindings, ownedSections)\n392|\tif err != nil {\n393|\t\treturn Report{}, err\n394|\t}\n395|\n396|\towned, err := verifyOwnershipGroups(checker, registry.Ownership, acceptanceIDs, expected, required, selectedSectionBindings)\n397|\tif err != nil {\n398|\t\treturn Report{}, err\n399|\t}\n400|\n401|\tfor _, binding := range assignedBindings {\n402|\t\tfor _, key := range binding.Keys {\n403|\t\t\tif entry, disclosed := unowned[key]; disclosed {\n404|\t\t\t\treturn Report{}, fail(\n405|\t\t\t\t\t\"assigned section %q binding %q is recorded unowned: %s\", binding.Scope, key, entry.Gap)\n406|\t\t\t}\n407|\t\t\tif _, ok := owned[ownershipSectionBinding][key]; !ok {\n408|\t\t\t\treturn Report{}, fail(\"assigned section %q binding %q has no scoped implementation owner\", binding.Scope, key)\n409|\t\t\t}\n410|\t\t\t// Admission requires full and nothing else. coverageUnmeasured is\n411|\t\t\t// deliberately not admitted: the gate cannot see the section's\n412|\t\t\t// obligations, and admitting on an unverifiable justification\n413|\t\t\t// sentence would be self-minted evidence for exactly the class this\n414|\t\t\t// gate exists to refuse. Absence of a scanner-visible clause is a\n415|\t\t\t// failure to measure, not a measured absence of obligation.\n416|\t\t\tmeasured := coverage[key]\n417|\t\t\tif measured.Level != coverageFull {\n418|\t\t\t\treturn Report{}, fail(\n419|\t\t\t\t\t\"assigned section %q binding %q discharges %s normative clauses, which is %s coverage; assigned-scope admission requires full: %s\",\n420|\t\t\t\t\tbinding.Scope, key, measured.Ratio(), measured.Level, measured.Gap)\n421|\t\t\t}\n422|\t\t}\n423|\t}\n424|\tfor _, contract := range compatibilityCatalog.Contracts {\n425|\t\tkey := contractKey(contract.Name, string(contract.ID))\n426|\t\tif _, ok := owned[ownershipContract][key]; !ok {\n427|\t\t\treturn Report{}, fail(\"compatibility contract %q has no implementation owner\", key)\n428|\t\t}\n429|\t}\n430|\n431|\tcanonical, err := json.Marshal(registry)\n432|\tif err != nil {\n433|\t\treturn Report{}, fail(\"encode canonical ownership registry: %v\", err)\n434|\t}\n435|\tdigest := sha256.Sum256(canonical)\n436|\tgotDigest := hex.EncodeToString(digest[:])\n437|\tif gotDigest != reviewedOwnershipCanonicalSHA256 {\n438|\t\treturn Report{}, fail(\"ownership registry projection digest %s differs from reviewed %s\", gotDigest, reviewedOwnershipCanonicalSHA256)\n439|\t}\n440|\n441|\treport := Report{\n442|\t\tContracts:              len(expected[ownershipContract]),\n443|\t\tNormativeSections:      len(expected[ownershipNormativeSection]),\n444|\t\tAcceptanceCases:        len(acceptanceIDs),\n445|\t\tFixtures:               len(expected[ownershipFixture]),\n446|\t\tCompatibilityContracts: len(compatibilityCatalog.Contracts),\n447|\t\tAssignedScopes:         len(assignedBindings),\n448|\t\tSectionBindings:        len(coverage),\n449|\t\tUnownedSections:        len(unowned),\n450|\t}\n451|\tfor _, measured := range coverage {\n452|\t\treport.NormativeClauses += measured.Total\n453|\t\treport.DischargedClauses += measured.Discharged\n454|\t\tswitch measured.Level {\n455|\t\tcase coverageFull:\n456|\t\t\treport.FullCoverage++\n457|\t\tcase coveragePartial:\n458|\t\t\treport.PartialCoverage++\n459|\t\tcase coverageSliver:\n460|\t\t\treport.SliverCoverage++\n461|\t\tcase coverageUnevidenced:\n462|\t\t\treport.UnevidencedCoverage++\n463|\t\tcase coverageUnmeasured:\n464|\t\t\treport.UnmeasuredCoverage++\n465|\t\t}\n466|\t}\n467|\treturn report, nil\n468|}\n469|\n470|// verifySectionCoverage measures every registered section binding against the\n471|// pinned document and refuses a coverage claim on any other ownership kind. A\n472|// contract or fixture owner has no section to be measured against, so a\n473|// coverage field there would be a claim the gate cannot check.\n474|func verifySectionCoverage(\n475|\tdocument *specdoc.Document,\n476|\tgroups []ownershipGroup,\n477|\tacceptanceIDs map[string]struct{},\n478|) (map[string]sectionCoverage, error) {\n479|\tresult := make(map[string]sectionCoverage)\n480|\tfor index, group := range groups {\n481|\t\tif group.Kind != ownershipSectionBinding {\n482|\t\t\tif group.Coverage != \"\" || group.Gap != \"\" || len(group.Clauses) != 0 {\n483|\t\t\t\treturn nil, fail(\n484|\t\t\t\t\t\"ownership group %d (%s) claims section coverage, which only a section binding can be measured for\",\n485|\t\t\t\t\tindex, group.Kind)\n486|\t\t\t}\n487|\t\t\tcontinue\n488|\t\t}\n489|\t\tif len(group.Keys) != 1 {\n490|\t\t\treturn nil, fail(\"section binding ownership group %d has %d keys, want exactly one\", index, len(group.Keys))\n491|\t\t}\n492|\t\tmeasured, err := verifySectionBindingCoverage(document, group, acceptanceIDs)\n493|\t\tif err != nil {\n494|\t\t\treturn nil, err\n495|\t\t}\n496|\t\tif _, duplicate := result[measured.Key]; duplicate {\n497|\t\t\treturn nil, fail(\"duplicate section_binding implementation owner for %q\", measured.Key)\n498|\t\t}\n499|\t\tresult[measured.Key] = measured\n500|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
