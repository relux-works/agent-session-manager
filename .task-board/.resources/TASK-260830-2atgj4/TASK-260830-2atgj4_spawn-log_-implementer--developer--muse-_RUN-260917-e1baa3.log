{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c803","stream":{"kind":"session","id":"01a0af07-89f4-7ab1-8e06-e8d6537acf87"},"sequence":604,"recorded_at":1780531400001203,"record_type":"event","durability":"durable","causation_id":"5cf12a39-f5bf-4b30-87e7-6389df903783","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"5cf12a39-f5bf-4b30-87e7-6389df903783","run_stream":{"kind":"run","id":"5cf12a39-f5bf-4b30-87e7-6389df903783"},"task_stream":{"kind":"task","id":"01a0af0a-3800-7b41-86a7-027f5ff983fc"},"task_id":"01a0af0a-3800-7b41-86a7-027f5ff983fc","event":{"kind":"output","task_id":"01a0af0a-3800-7b41-86a7-027f5ff983fc","chunk":"{\n  \"chunk_id\": \"exec-21-1\",\n  \"command\": \"python3 <<'EOF'\\nimport json\\nB=json.load(open('/tmp/reg_BASE.json')); H=json.load(open('/tmp/reg_HEAD.json')); T=json.load(open('/tmp/reg_THEIRS.json'))\\ndef keyfn(arr,x):\\n    if arr=='acceptance_cases': return x.get('id','?')\\n    if arr=='ownership': return json.dumps(x.get('keys'),sort_keys=True)\\n    return x.get('key','?')\\nfor arr in ['acceptance_cases','ownership','unowned_sections']:\\n    b,h,t = B[arr],H[arr],T[arr]\\n    bi,hi,ti = [keyfn(arr,x) for x in b],[keyfn(arr,x) for x in h],[keyfn(arr,x) for x in t]\\n    print('=== '+arr+' ===')\\n    print('HEAD-added:', sorted(set(hi)-set(bi)))\\n    print('HEAD-removed:', sorted(set(bi)-set(hi)))\\n    print('THEIRS-added:', sorted(set(ti)-set(bi)))\\n    print('THEIRS-removed:', sorted(set(bi)-set(ti)))\\n    bm={keyfn(arr,x):x for x in b}; hm={keyfn(arr,x):x for x in h}; tm={keyfn(arr,x):x for x in t}\\n    for i in sorted(set(bi)&set(hi)):\\n        if bm[i]!=hm[i]: print('HEAD-modified:', i[:120])\\n    for i in sorted(set(bi)&set(ti)):\\n        if bm[i]!=tm[i]: print('THEIRS-modified:', i[:120])\\nEOF\",\n  \"description\": \"Diff registry arrays with correct keys\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"==