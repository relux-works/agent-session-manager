om(merged)\\nfor k in sorted(set(os_) - set(oo)): print('leaf-added row:', k)\\nfor k in sorted(set(os_) & set(oo)):\\n    if os_[k]!=oo[k]: print('leaf-modified row:', k)\\nprint('merged tail cases:', oi(merged)[-6:])\\nEOF\",\n  \"description\": \"Verify merged registry semantics\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"counts cases old/new/stale/merged: 110 128 113 131\\ncounts ownership old/new/stale/merged: 62 65 62 65\\ncounts unowned old/new/stale/merged: 11 11 11 11\\nleaf-added cases: ['lease-ownership-union-properties', 'lease-ownership-store-properties', 'lease-ownership-gate-properties']\\nall leaf-added in merged: True\\nall new-base cases in merged: True\\ndup check: True\\nleaf-modified row: [\\\"section:17.2\\\"]\\nleaf-modified row: [\\\"section:2.2\\\"]\\nleaf-modified row: [\\\"section:5.3\\\"]\\nmerged tail cases: ['lease-fencing-park', 'lease-terminate-stale', 'lease-token-capability', 'lease-ownership-union-properties', 'lease-ownership-store-properties', 'lease-ownership-gate-properties']\\n\",\n  \"original_output_bytes\": 665,\n  \"original_output_tokens\": 167,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
