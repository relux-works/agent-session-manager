code>issued_by_host_id</code> |\\\",\\n+      \\\"acceptance_cases\\\": [\\n+        \\\"core-record-identity-validation\\\"\\n+      ]\\n+    },\\n+    {\\n+      \\\"id\\\": \\\"5.3#2\\\",\\n+      \\\"line\\\": 1957,\\n+      \\\"excerpt\\\": \\\"tie-break. A valid epoch greater than 1 MUST name a known predecessor for the\\\",\\n+      \\\"acceptance_cases\\\": [\\n+        \\\"lease-record-lifecycle\\\",\\n+        \\\"lease-checkpoint-admission\\\"\\n+      ]\\n+    },\\n+    {\\n+      \\\"id\\\": \\\"5.3#3\\\",\\n+      \\\"line\\\": 1958,\\n+      \\\"excerpt\\\": \\\"same session, MUST equal that predecessor's epoch plus one, and MUST reference\\\",\\n+      \\\"acceptance_cases\\\": [\\n+        \\\"lease-record-lifecycle\\\",\\n+        \\\"lease-checkpoint-admission\\\"\\n+      ]\\n+    },\\n+    {\\n+      \\\"id\\\": \\\"5.3#4\\\",\\n+      \\\"line\\\": 1960,\\n+      \\\"excerpt\\\": \\\"<code>create</code> lease MUST have a null predecessor and MAY have a null\\\",\\n+      \\\"acceptance_cases\\\": [\\n+        \\\"lease-record-lifecycle\\\"\\n+      ]\\n+    },\\n+    {\\n+      \\\"id\\\": \\\"5.3#6\\\",\\n+      \\\"line\\\": 1967,\\n+      \\\"excerpt\\\": \\\"lease wins. Events under the losing same-epoch lease and all lower epochs MUST\\\",\\n+      \\\"acceptance_cases\\\": [\\n+        \\\"lease-divergent-preservation\\\",\\n+        \\\"lease-union-resolution\\\"\\n+      ]\\n+    },\\n+    {\\n+      \\\"id\\\": \\\"5.3#7\\\",\\n+      \\\"line\\\": 1968,\\n+      \\\"excerpt\\\": \\\"be preserved in a divergent branch and MUST NOT affect authoritative state.\\\",\\n+      \\\"acceptance_cases\\\": [\\n+        \\\"lease-divergent-preservation\\\",\\n+        \\\"lease-union-resolution\\\"\\n+      ]\\n+    },\\n+    {\\n+      \\\"id\\\": \\\"5.3#8\\\",\\n+      \\\"line\\\": 1970,\\n+      \\\"excerpt\\\": \\\"An owner process MUST revalidate its fencing token before:\\\",\\n+      \\\"acceptance_cases\\\": [\\n+        \\\"lease-fencing-revalidation\\\",\\n+        \\\"lease-fencing-gates\\\"\\n+      ]\\n+    }\\n+  ]\\n }\\n\",\n  \"original_output_bytes\": 3089,\n  \"original_output_tokens\": 773,\n  \"truncated\": false\n}","final_result":true}}}
