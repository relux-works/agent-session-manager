{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c4e7","stream":{"kind":"session","id":"01a0af04-bc42-7011-aaa1-7dd6d116332b"},"sequence":206,"recorded_at":1780531400000407,"record_type":"event","durability":"durable","causation_id":"6b7a75d7-7776-472d-93d3-ae27dee8ebae","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"6b7a75d7-7776-472d-93d3-ae27dee8ebae","run_stream":{"kind":"run","id":"6b7a75d7-7776-472d-93d3-ae27dee8ebae"},"task_stream":{"kind":"task","id":"01a0af05-2728-7601-89e3-88e962c0c3bd"},"task_id":"01a0af05-2728-7601-89e3-88e962c0c3bd","event":{"kind":"output","task_id":"01a0af05-2728-7601-89e3-88e962c0c3bd","chunk":"{\n  \"chunk_id\": \"exec-7-1\",\n  \"command\": \"export TASK_BOARD_DIR=/Users/iv/Developer/ReluxWorks/agent-session-manager/.task-board\\ntask-board worktree --help 2>&1 | head -c 4000\\necho \\\"=====\\\"\\ntask-board q 'get(STORY-260830-1oqfec)' 2>&1 | head -c 3000\",\n  \"description\": \"Check worktree commands and story state\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Inspect and repair the Story-scoped Git workspaces that repository-mutating\\nspawns run in.\\n\\nEach Story gets one managed worktree under .temp/<STORY-ID>/worktree on a\\nshort-lived task-board/story/<STORY-ID> branch forked from trunk. Trunk is\\nspawn.worktree_isolation.integration_base_branch when configured, and otherwise\\nresolves from refs/remotes/origin/HEAD and then the current branch.\\n\\nThese commands require a local authoritative board. On a remote board they\\nrefuse with worktree_isolation_requires_local_board and do nothing else.\\n\\nUsage:\\n  task-board worktree [command]\\n\\nAvailable Commands:\\n  abort                 Stop using a Story workspace, preserving its work by default\\n  checkpoint            Commit an accepted leaf onto its Story branch while preserving integrating\\n  close-landed          Close an element whose accepted candidate is already on the protected trunk\\n  complete              Prove an accepted Story's code landed on its own repository, then record its board state in the board repository\\n  converge              Refresh a pinned Story workspace onto fresh trunk, carrying its uncommitted delta\\n  gc                    Release Story leases whose holding runs are provably terminal\\n  integrate             Land an accepted Story candidate on trunk and commit its board state\\n  integrating           Classify every element parked at integrating: awaiting a landing, board-only, already on trunk, or deferred\\n  invalidate-acceptance Release an invalidated or failed-revalidation acceptance back to rework\\n  obligations           List Change Request revisions that no live run owns\\n  prepare-landed-review Export a signed current-default tree for a new producer handoff and exact-tree review\\n  reconcile-trunk       Move the control root's trunk onto fresh protected authority when every local commit is already delivered there\\n  refresh-candidate     Refresh an initial or rework candidate base without losing uncommitted files\\n  repair                Re-materialize a recorded workspace whose worktree is missing\\n  start-landed-rework   Reprove a landed-review export and durably authorize normal producer rework\\n  status                Report managed Story workspaces and what blocks their cleanup\\n  transaction           Inspect and dispose of a refused or abandoned integration transaction\\n  trunk-rewrite         Report and migrate Story workspaces orphaned by a rewrite of protected trunk history\\n\\nFlags:\\n  -h, --help   help for worktree\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\\nUse \\\"task-board worktree [command] --help\\\" for more information about a command.\\n=====\\n{\\\"id\\\":\\\"STORY-260830-1oqfec\\\",\\\"name\\\":\\\"ownership-leases-and-fencing\\\",\\\"status\\\":\\\"integrating\\\"}\\n\",\n  \"original_output_bytes\": 3254,\n  \"original_output_tokens\": 814,\n  \"truncated\": false\n}","final_result":true}}}
