{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8b3","stream":{"kind":"session","id":"01a0ae9c-cde9-7503-b771-d867bf2eff64"},"sequence":692,"recorded_at":1780531400001379,"record_type":"event","durability":"durable","causation_id":"c50b0c1e-3e8f-47ac-b724-ccf66299a997","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"c50b0c1e-3e8f-47ac-b724-ccf66299a997","run_stream":{"kind":"run","id":"c50b0c1e-3e8f-47ac-b724-ccf66299a997"},"call_id":"call_01a0ae9e6666763bb780be1a83555724","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1oqfec/worktree/internal/sessrepo/lease_properties_test.go`.\n1|package sessrepo\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"errors\"\n6|\t\"math/rand\"\n7|\t\"reflect\"\n8|\t\"testing\"\n9|)\n10|\n11|// Ownership store properties (TASK-260830-2atgj4): the store halves of\n12|// invariants 3 (clock non-authority) and 4 (zero duplicate authorized\n13|// owners) over the landed CreateLease, CompareAndSwapLease,\n14|// WinningLease, ListLeases, GetLease, and VerifyFencingToken entries.\n15|// The reducer halves live in internal/sessstate, the gate halves in\n16|// internal/fencing. Generators use the closed lease/host/reason\n17|// alphabets below with exhaustive enumeration where the space is\n18|// small and bounded seeded-random exploration otherwise (seed and\n19|// iteration counts recorded); no new module dependency.\n20|\n21|// propLeaseIDs is the closed fencing-token alphabet. Every value keeps\n22|// the UUIDv4 nibble and an RFC 4122 variant.\n23|var propLeaseIDs = []string{\n24|\ttestLeaseID,\n25|\ttestLeaseIDB,\n26|\ttestLeaseIDC,\n27|\t\"dddddddd-eeee-4fff-8aaa-333333333333\",\n28|\t\"eeeeeeee-ffff-4000-9bbb-444444444444\",\n29|\t\"ffffffff-0000-4111-abbb-555555555555\",\n30|}\n31|\n32|// propReasons is the closed Section 5.3 reason alphabet.\n33|var propReasons = []string{\"create\", \"graceful_takeover\", \"force_takeover\", \"recovery\"}\n34|\n35|// propClockShifts carries every timestamp vector of the clock\n36|// property: backwards, the suite baseline, an equal repeat of the\n37|// baseline, and a far-future value. All are grammatically valid\n38|// timestamps: grammar still refuses malformed values (landed\n39|// negatives); authority must not consult the value.\n40|var propClockShifts = []string{\n41|\t\"2020-01-01T00:00:00.000Z\",\n42|\ttestLeaseAt,\n43|\ttestLeaseAt,\n44|\t\"2030-12-31T23:59:59.999Z\",\n45|}\n46|\n47|// propAuthority is the authority projection of a lease chain: the\n48|// epochs, fencing tokens, and holders in tuple order. Record digests\n49|// are excluded on purpose: created_at flows into the canonical\n50|// identity bytes, so digests vary across clock shifts while authority\n51|// must not.\n52|type propAuthority struct {\n53|\tepochs  []uint64\n54|\tleases  []string\n55|\tholders []string\n56|}\n57|\n58|func propAuthorityOf(summaries []LeaseSummary) propAuthority {\n59|\tauthority := propAuthority{}\n60|\tfor _, summary := range summaries {\n61|\t\tauthority.epochs = append(authority.epochs, summary.Epoch)\n62|\t\tauthority.leases = append(authority.leases, summary.LeaseID)\n63|\t\tauthority.holders = append(authority.holders, summary.HolderHostID)\n64|\t}\n65|\treturn authority\n66|}\n67|\n68|// propBuildChain creates the epoch-1 lease and one successor per\n69|// reason, stamping created_at from stamps (cycled). It returns the\n70|// stored summaries in tuple order.\n71|func propBuildChain(t *testing.T, repository *Repository, sessionID string, reasons []string, stamps []string) []LeaseSummary {\n72|\tt.Helper()\n73|\tholderFor := func(index int) string {\n74|\t\tif index%2 == 0 {\n75|\t\t\treturn testHostID\n76|\t\t}\n77|\t\treturn testHostIDB\n78|\t}\n79|\tleaseFor := func(index int) string {\n80|\t\treturn propLeaseIDs[index%len(propLeaseIDs)]\n81|\t}\n82|\tstampFor := func(index int) string {\n83|\t\treturn stamps[index%len(stamps)]\n84|\t}\n85|\tholder := holderFor(0)\n86|\tcreated := mustCreateLease(t, repository, sessionID, CreateLeaseInput{\n87|\t\tLeaseID: leaseFor(0), HolderHostID: holder, IssuedByHostID: holder, CreatedAt: stampFor(0),\n88|\t})\n89|\texpected := LeaseExpectation{RecordID: created.RecordID}\n90|\tfor i, reason := range reasons {\n91|\t\tindex := i + 1\n92|\t\tholder = holderFor(index)\n93|\t\tnext := mustCompareAndSwap(t, repository, sessionID, expected, SuccessorLeaseInput{\n94|\t\t\tCreateLeaseInput: CreateLeaseInput{\n95|\t\t\t\tLeaseID: leaseFor(index), HolderHostID: holder,\n96|\t\t\t\tIssuedByHostID: holder, CreatedAt: stampFor(index),\n97|\t\t\t},\n98|\t\t\tReason:       reason,\n99|\t\t\tCheckpointID: zeroDigest,\n100|\t\t})\n101|\t\texpected = LeaseExpectation{RecordID: next.RecordID}\n102|\t}\n103|\tsummaries, err := repository.ListLeases(sessionID)\n104|\tif err != nil {\n105|\t\tt.Fatalf(\"ListLeases error = %v\", err)\n106|\t}\n107|\treturn summaries\n108|}\n109|\n110|// TestOwnershipStoreClockNonAuthority proves invariant 3 over the\n111|// store: shifting every created_at backwards, equal, or far into the\n112|// future leaves epochs, fencing tokens, holders, the winning tuple,\n113|// and every fencing verdict identical. Record digests DO vary —\n114|// created_at is digested into the identity bytes — which is what\n115|// makes the invariant non-vacuous: identity varies, authority does\n116|// not. Four uniform shifts plus one mixed non-monotonic chain.\n117|func TestOwnershipStoreClockNonAuthority(t *testing.T) {\n118|\tvar baseline propAuthority\n119|\tvar baselineDigests []string\n120|\tverdict := func(t *testing.T, repository *Repository, token FencingToken) error {\n121|\t\tt.Helper()\n122|\t\treturn repository.VerifyFencingToken(testSessionID, token)\n123|\t}\n124|\tdigestsByShift := make([][]string, len(propClockShifts))\n125|\tfor shift, stamp := range propClockShifts {\n126|\t\trepository := openTestRepository(t)\n127|\t\tcreateTestSession(t, repository)\n128|\t\tsummaries := propBuildChain(t, repository, testSessionID,\n129|\t\t\t[]string{\"graceful_takeover\", \"force_takeover\"}, []string{stamp})\n130|\t\tauthority := propAuthorityOf(summaries)\n131|\t\tif shift == 0 {\n132|\t\t\tbaseline = authority\n133|\t\t\tfor _, summary := range summaries {\n134|\t\t\t\tbaselineDigests = append(baselineDigests, summary.RecordID)\n135|\t\t\t}\n136|\t\t} else if !reflect.DeepEqual(authority, baseline) {\n137|\t\t\tt.Fatalf(\"shift %q authority = %+v, want baseline %+v\", stamp, authority, baseline)\n138|\t\t}\n139|\t\twinner, err := repository.WinningLease(testSessionID)\n140|\t\tif err != nil {\n141|\t\t\tt.Fatalf(\"shift %q WinningLease error = %v\", stamp, err)\n142|\t\t}\n143|\t\tif winner.Epoch != 3 || winner.LeaseID != propLeaseIDs[2] {\n144|\t\t\tt.Fatalf(\"shift %q winner = %+v, want epoch 3 lease %s\", stamp, winner, propLeaseIDs[2])\n145|\t\t}\n146|\t\twinnerToken := FencingToken{Epoch: winner.Epoch, LeaseID: winner.LeaseID, HolderHostID: winner.HolderHostID}\n147|\t\tif err := verdict(t, repository, winnerToken); err != nil {\n148|\t\t\tt.Fatalf(\"shift %q winner token verdict = %v, want nil\", stamp, err)\n149|\t\t}\n150|\t\tstale := FencingToken{Epoch: 1, LeaseID: propLeaseIDs[0], HolderHostID: testHostID}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8b5","stream":{"kind":"session","id":"01a0ae9c-cde9-7503-b771-d867bf2eff64"},"sequence":693,"recorded_at":1780531400001381,"record_type":"event","durability":"durable","causation_id":"c50b0c1e-3e8f-47ac-b724-ccf66299a997","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"c50b0c1e-3e8f-47ac-b724-ccf66299a997","run_stream":{"kind":"run","id":"c50b0c1e-3e8f-47ac-b724-ccf66299a997"},"call_id":"call_01a0ae9e67c27683b38bf4af7720ad0b","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1oqfec/worktree/internal/fencing/ownership_properties_test.go`.\n1|package fencing\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"testing\"\n6|\t\"time\"\n7|)\n8|\n9|// Ownership gate properties (TASK-260830-2atgj4): the gate halves of\n10|// invariants 3 (clock non-authority) and 4 (zero duplicate authorized\n11|// owners) over the landed Authorize* entries. The reducer halves live\n12|// in internal/sessstate, the store halves in internal/sessrepo.\n13|//\n14|// Clock bound: the absolute wall-clock position is non-authoritative;\n15|// the fencing-grant AGE relative to the refresh policy is\n16|// authoritative by design (sessrepo.CheckFencingExpiry). The property\n17|// therefore translates (ValidatedAt, Now) together and asserts\n18|// identical verdicts at a fixed age, including a lapsed age and the\n19|// exact interval boundary. PresentedToken and Observation carry no\n20|// created_at member, so lease creation time is non-authoritative by\n21|// construction.\n22|\n23|// propLeaseLow is a valid fencing token sorting below the winning\n24|// lease A: the below-winner half of the same-epoch loser pair.\n25|const propLeaseLow = \"00000000-1111-4000-8000-000000000001\"\n26|\n27|// propVerdict encodes an Authorize outcome for invariance\n28|// comparison: authorized, refused with its Section 15 class, or\n29|// parked with the session.parked reason, the cause class, and the\n30|// repeated winning lease.\n31|func propVerdict(err error) string {\n32|\tif err == nil {\n33|\t\treturn \"authorized\"\n34|\t}\n35|\tclasses := []error{ErrLeaseConflict, ErrNotOwner, ErrStaleOwner, ErrInvalidArguments, ErrLocalPreconditionFailed}\n36|\tclassOf := func() string {\n37|\t\tfor _, class := range classes {\n38|\t\t\tif errors.Is(err, class) {\n39|\t\t\t\treturn class.Error()\n40|\t\t\t}\n41|\t\t}\n42|\t\treturn \"unknown\"\n43|\t}\n44|\tif reason, leaseID, ok := ParkDetails(err); ok {\n45|\t\treturn \"parked:\" + string(reason) + \"/\" + classOf() + \"/\" + leaseID\n46|\t}\n47|\treturn \"refused:\" + classOf()\n48|}\n49|\n50|// TestOwnershipGateClockNonAuthority proves invariant 3 over the\n51|// gates: translating the wall clock by -1h, 0, +1h, or +365d with\n52|// the grant age fixed leaves every verdict — authorized, refused\n53|// with its class, or parked with its reason — identical across all\n54|// five operations. Ages cover fresh (30s), the exact interval\n55|// boundary (60s, still current), zero (Now == ValidatedAt), and\n56|// lapsed (61s). 4 ages x 4 translations x 5 operations = 80\n57|// authorizations.\n58|func TestOwnershipGateClockNonAuthority(t *testing.T) {\n59|\ttranslations := []time.Duration{-time.Hour, 0, time.Hour, 365 * 24 * time.Hour}\n60|\tages := []time.Duration{0, 30 * time.Second, time.Minute, time.Minute + time.Second}\n61|\tentries := fenceEntries()\n62|\tfor _, age := range ages {\n63|\t\tfor name, entry := range entries {\n64|\t\t\tvar baseline string\n65|\t\t\tvar first bool\n66|\t\t\tfor _, delta := range translations {\n67|\t\t\t\tobservation := fenceObservation()\n68|\t\t\t\tobservation.Grant.ValidatedAt = fenceValidatedAt.Add(delta)\n69|\t\t\t\tobservation.Now = fenceValidatedAt.Add(delta).Add(age)\n70|\t\t\t\ttoken, err := entry.authorize(fencePresented(), observation)\n71|\t\t\t\tgot := propVerdict(err)\n72|\t\t\t\tif err == nil {\n73|\t\t\t\t\tmustMint(t, token, err, name)\n74|\t\t\t\t}\n75|\t\t\t\tif !first {\n76|\t\t\t\t\tbaseline, first = got, true\n77|\t\t\t\t\tcontinue\n78|\t\t\t\t}\n79|\t\t\t\tif got != baseline {\n80|\t\t\t\t\tt.Fatalf(\"op %s age %v translation %v: verdict %q, want translation-invariant %q\",\n81|\t\t\t\t\t\tname, age, delta, got, baseline)\n82|\t\t\t\t}\n83|\t\t\t}\n84|\t\t\t// The age classes themselves are pinned: a current\n85|\t\t\t// grant authorizes, a lapsed grant refuses\n86|\t\t\t// lease_conflict on every entry including launch.\n87|\t\t\twant := \"authorized\"\n88|\t\t\tif age > fencePolicy.RefreshInterval {\n89|\t\t\t\twant = \"refused:lease_conflict\"\n90|\t\t\t}\n91|\t\t\tif baseline != want {\n92|\t\t\t\tt.Fatalf(\"op %s age %v: verdict %q, want %q\", name, age, baseline, want)\n93|\t\t\t}\n94|\t\t}\n95|\t}\n96|\tt.Logf(\"gate-clock: %d ages x %d translations x %d operations, verdicts translation-invariant\",\n97|\t\tlen(ages), len(translations), len(entries))\n98|}\n99|\n100|// TestOwnershipGateSingleAuthorizedOwner proves invariant 4 over the\n101|// gates: across the presenter grid (exact winner, stale epoch,\n102|// below- and above-winner same-epoch losers, future epoch, foreign\n103|// session) exactly one presenter authorizes per operation — the exact\n104|// winning tuple on the holder's host — and no two distinct\n105|// presenters, hosts, or processes ever both pass an\n106|// activation-class gate for the same session. 6 presenters x 5\n107|// observations x 5 operations = 150 authorizations, exhaustive.\n108|func TestOwnershipGateSingleAuthorizedOwner(t *testing.T) {\n109|\tpresenters := map[string]PresentedToken{\n110|\t\t\"exact\":      fencePresented(),\n111|\t\t\"stale\":      {SessionID: fenceSessionA, Epoch: 1, LeaseID: fenceLeaseOld},\n112|\t\t\"loser_low\":  {SessionID: fenceSessionA, Epoch: 2, LeaseID: propLeaseLow},\n113|\t\t\"loser_high\": {SessionID: fenceSessionA, Epoch: 2, LeaseID: fenceLeaseC},\n114|\t\t\"future\":     {SessionID: fenceSessionA, Epoch: 9, LeaseID: fenceLeaseA},\n115|\t\t\"foreign\":    {SessionID: fenceSessionB, Epoch: 2, LeaseID: fenceLeaseA},\n116|\t}\n117|\tlocal := fenceObservation()\n118|\tremote := fenceObservation()\n119|\tremote.LocalHostID = fenceHostB\n120|\tambiguous := fenceObservation()\n121|\tambiguous.Ambiguous = true\n122|\tfailed := fenceObservation()\n123|\tfailed.HandoffFailed = true\n124|\tunverified := fenceObservation()\n125|\tunverified.Verified = false\n126|\tobservations := map[string]Observation{\n127|\t\t\"local\": local, \"remote\": remote,\n128|\t\t\"ambiguous\": ambiguous, \"failed_handoff\": failed, \"unverified\": unverified,\n129|\t}\n130|\t// verdicts[observation][operation][presenter] is the recorded\n131|\t// table every assertion below reads.\n132|\tverdicts := map[string]map[string]map[string]string{}\n133|\tentries := fenceEntries()\n134|\tfor obsName, observation := range observations {\n135|\t\tverdicts[obsName] = map[string]map[string]string{}\n136|\t\tfor opName, entry := range entries {\n137|\t\t\tverdicts[obsName][opName] = map[string]string{}\n138|\t\t\tfor presenterName, presented := range presenters {\n139|\t\t\t\ttoken, err := entry.authorize(presented, observation)\n140|\t\t\t\tverdicts[obsName][opName][presenterName] = propVerdict(err)\n141|\t\t\t\tif err == nil {\n142|\t\t\t\t\tmustMint(t, token, err, obsName+\"/\"+opName+\"/\"+presenterName)\n143|\t\t\t\t}\n144|\t\t\t}\n145|\t\t}\n146|\t}\n147|\t// The local holder's table is pinned cell by cell: the exact\n148|\t// winner authorizes on every operation; every other presenter\n149|\t// parks or refuses with its landed class.\n150|\twantLocal := map[string]map[string]string{\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
