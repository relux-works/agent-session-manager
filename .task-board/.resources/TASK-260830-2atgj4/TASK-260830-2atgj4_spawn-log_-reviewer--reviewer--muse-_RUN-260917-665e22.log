{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb1d","stream":{"kind":"session","id":"01a0ae9c-cde9-7503-b771-d867bf2eff64"},"sequence":1001,"recorded_at":1780531400001997,"record_type":"event","durability":"durable","causation_id":"c50b0c1e-3e8f-47ac-b724-ccf66299a997","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"c50b0c1e-3e8f-47ac-b724-ccf66299a997","run_stream":{"kind":"run","id":"c50b0c1e-3e8f-47ac-b724-ccf66299a997"},"task_stream":{"kind":"task","id":"01a0ae9f-dc60-7891-9f57-16625e2139b9"},"task_id":"01a0ae9f-dc60-7891-9f57-16625e2139b9","event":{"kind":"output","task_id":"01a0ae9f-dc60-7891-9f57-16625e2139b9","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1oqfec/worktree/internal/fencing/gate.go`.\n(299 line(s) above)\n300|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"presented fencing token session %q is not a UUIDv7: %v\", presented.SessionID, err)\n301|\t}\n302|\tif presented.Epoch == 0 {\n303|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"presented fencing token carries epoch 0, want an epoch at or above 1\")\n304|\t}\n305|\tif _, err := scalar.ParseUUIDv4(presented.LeaseID); err != nil {\n306|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"presented fencing token lease %q is not a UUIDv4: %v\", presented.LeaseID, err)\n307|\t}\n308|\tif presented.SessionID != observation.SessionID {\n309|\t\treturn LeaseToken{}, refuse(ErrLeaseConflict, \"presented fencing token for session %s does not authorize session %s\", presented.SessionID, observation.SessionID)\n310|\t}\n311|\tif !observation.HasWinner {\n312|\t\tif launchClass(operation) {\n313|\t\t\treturn LeaseToken{}, park(ParkRestorePolicy, \"\", ErrLeaseConflict)\n314|\t\t}\n315|\t\treturn LeaseToken{}, refuse(ErrLeaseConflict, \"no winning lease is established for session %s\", observation.SessionID)\n316|\t}\n317|\tif observation.Winner.Epoch == 0 || !validLeaseID(observation.Winner.LeaseID) || !validHostID(observation.Winner.HolderHostID) {\n318|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"fencing observation for session %s carries no well-formed winning lease\", observation.SessionID)\n319|\t}\n320|\tif !observation.Verified {\n321|\t\tif launchClass(operation) {\n322|\t\t\treturn LeaseToken{}, park(ParkRestorePolicy, observation.Winner.LeaseID, ErrLeaseConflict)\n323|\t\t}\n324|\t\treturn LeaseToken{}, refuse(ErrLeaseConflict, \"ownership of session %s is unverified; refresh lease knowledge first\", observation.SessionID)\n325|\t}\n326|\tif observation.Ambiguous {\n327|\t\tif launchClass(operation) {\n328|\t\t\treturn LeaseToken{}, park(ParkRestorePolicy, observation.Winner.LeaseID, ErrLeaseConflict)\n329|\t\t}\n330|\t\treturn LeaseToken{}, refuse(ErrLeaseConflict, \"ownership of session %s is ambiguous; resolve the union rival first\", observation.SessionID)\n331|\t}\n332|\tif observation.HandoffFailed {\n333|\t\tif launchClass(operation) {\n334|\t\t\treturn LeaseToken{}, park(ParkFailedHandoff, observation.Winner.LeaseID, ErrLeaseConflict)\n335|\t\t}\n336|\t\treturn LeaseToken{}, refuse(ErrLeaseConflict, \"handoff for session %s already failed; a losing lease must never activate\", observation.SessionID)\n337|\t}\n338|\tif !observation.HasGrant {\n339|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"fencing observation for session %s carries no grant; validate the winning token first\", observation.SessionID)\n340|\t}\n341|\tif observation.Now.IsZero() {\n342|\t\treturn LeaseToken{}, refuse(ErrInvalidArguments, \"fencing observation for session %s carries no clock reading; expiry cannot be checked\", observation.SessionID)\n343|\t}\n344|\tif err := sessrepo.CheckFencingExpiry(observation.Grant, observation.Policy, observation.Now); err != nil {\n345|\t\tif errors.Is(err, sessrepo.ErrFencingExpired) {\n346|\t\t\treturn LeaseToken{}, refuse(ErrLeaseConflict, \"fencing grant for session %s lapsed;