{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c749","stream":{"kind":"session","id":"01a0ae9c-cde9-7503-b771-d867bf2eff64"},"sequence":511,"recorded_at":1780531400001017,"record_type":"event","durability":"durable","causation_id":"c50b0c1e-3e8f-47ac-b724-ccf66299a997","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"c50b0c1e-3e8f-47ac-b724-ccf66299a997","run_stream":{"kind":"run","id":"c50b0c1e-3e8f-47ac-b724-ccf66299a997"},"call_id":"call_01a0ae9dcf1876f3bb284d47ea803dac","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1oqfec/worktree/internal/sessstate/testdata/mutate_properties.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Run isolated behavioral mutants for the ownership reducer properties; never modify the managed Story checkout.\n3|Usage: PYTHONDONTWRITEBYTECODE=1 python3 internal/sessstate/testdata/mutate_properties.py /absolute/evidence/directory [name-filter]\n4|Every subprocess runs directly, logs its real exit, and has a bounded timeout.\n5|The battery proves each of the four story-pinned ownership invariants by\n6|falsification: every N-mutant keeps its reducer present and weakens it to\n7|admit exactly one member of the class the invariant must reject (or to\n8|consult exactly one forbidden clock signal), and a named ownership property\n9|test must fail. Each plant runs only the smallest property pattern that can\n10|observe it; the control rows run every TestOwnership pattern across the\n11|three packages. Full-package health is proven separately by the committed\n12|suite runs, not by this harness. An optional name-filter runs a subset\n13|(substring match); results merge by concatenating mutants JSON rows.\n14|\"\"\"\n15|import hashlib\n16|import json\n17|from pathlib import Path\n18|import re\n19|import shutil\n20|import subprocess\n21|import sys\n22|\n23|root = Path(__file__).resolve().parents[3]\n24|output = Path(sys.argv[1]).resolve()\n25|output.mkdir(parents=True, exist_ok=True)\n26|name_filter = sys.argv[2] if len(sys.argv) > 2 else \"\"\n27|tag = re.sub(r\"[^a-z0-9]+\", \"-\", name_filter.lower()).strip(\"-\") or \"full\"\n28|copy = output / (\"mutation-source-\" + tag)\n29|if copy.exists():\n30|    raise SystemExit(\"refusing to overwrite an existing mutation source\")\n31|copy.mkdir()\n32|shutil.copytree(root / \"internal\", copy / \"internal\")\n33|for name in (\"go.mod\", \"go.sum\", \"README.md\", \"LOGBOOK.md\"):\n34|    shutil.copy2(root / name, copy / name)\n35|results = []\n36|\n37|LEASEC = \"cccccccc-dddd-4eee-8fff-111111111111\"\n38|HOSTB = \"0198f4c8-4a10-7b22-8b3c-1234567890ac\"\n39|\n40|\n41|def ownership_command(package, pattern):\n42|    return [\"go\", \"test\", \"./internal/\" + package, \"-run\", pattern, \"-count=1\", \"-v\"]\n43|\n44|\n45|# Each mutant: (name, kind, file, edits|add-path+content, command, bound).\n46|# kind edit: [(old, new)] applied to file, each anchored exactly once.\n47|# kind add: writes path with content for the run, then removes it.\n48|MUTANTS = [\n49|    (\"N-compare-tiebreak\", \"edit\", \"internal/sessstate/sessstate.go\",\n50|     [(\"\\tcase a.LeaseID < b.LeaseID:\\n\\t\\treturn -1\",\n51|        \"\\tcase a.LeaseID < b.LeaseID:\\n\\t\\treturn 1\"),\n52|      (\"\\tcase a.LeaseID > b.LeaseID:\\n\\t\\treturn 1\",\n53|        \"\\tcase a.LeaseID > b.LeaseID:\\n\\t\\treturn -1\")],\n54|     ownership_command(\"sessstate\", r\"^TestOwnershipUnionOrderIndependent$\"),\n55|     \"Invert the lease_id tie-break; every permutation still agrees but the winner disagrees with the independent maximum.\"),\n56|    (\"N-union-detail-first\", \"edit\", \"internal/sessstate/sessstate.go\",\n57|     [('\"union lease (%d, %s) loses to (%d, %s); its history stays preserved and never applies\",\\n\\t\\t\\tlease.Epoch, lease.LeaseID, winner.Epoch, winner.LeaseID)',\n58|        '\"union lease (%d, %s) loses to (%d, %s); its history stays preserved and never applies\",\\n\\t\\t\\tlease.Epoch, lease.LeaseID, union[0].Epoch, union[0].LeaseID)')],\n59|     ownership_command(\"sessstate\", r\"^TestOwnershipUnionOrderIndependent$\"),\n60|     \"Name the first-arriving union entry instead of the final winner; arrivals permute the evidence while the winner stands.\"),\n61|    (\"N-loser-drop-same-epoch\", \"edit\", \"internal/sessstate/sessstate.go\",\n62|     [(\"\\t\\tif Compare(lease, winner) < 0 {\",\n63|        \"\\t\\tif Compare(lease, winner) < 0 && lease.Epoch != winner.Epoch {\")],\n64|     ownership_command(\"sessstate\", r\"^TestOwnershipLoserHistoryPreserved$\"),\n65|     \"Drop same-epoch losers from the preserved evidence; lower-epoch losers still report.\"),\n66|    (\"N-loser-drop-lower-epoch\", \"edit\", \"internal/sessstate/sessstate.go\",\n67|     [(\"\\t\\tif Compare(lease, winner) < 0 {\",\n68|        \"\\t\\tif Compare(lease, winner) < 0 && lease.Epoch == winner.Epoch {\")],\n69|     ownership_command(\"sessstate\", r\"^TestOwnershipLoserHistoryPreserved$\"),\n70|     \"Drop lower-epoch losers from the preserved evidence; same-epoch losers still report.\"),\n71|    (\"N-create-clock\", \"edit\", \"internal/sessrepo/lease_store.go\",\n72|     [('\\tcandidate, digest, err := mintLeaseRecord(view.record.sessionID, 1,',\n73|        '\\tif input.CreatedAt < \"2026-01-01T00:00:00.000Z\" {\\n\\t\\treturn LeaseRef{}, refuse(ErrInvalidLease, \"clock plant: creation time precedes the policy epoch\")\\n\\t}\\n\\tcandidate, digest, err := mintLeaseRecord(view.record.sessionID, 1,')],\n74|     ownership_command(\"sessrepo\", r\"^TestOwnershipStoreClockNonAuthority$\"),\n75|     \"Refuse creation timestamps before 2026; the backwards shift errors while baseline shifts still mint.\"),\n76|    (\"N-expiry-absolute\", \"edit\", \"internal/sessrepo/lease_store.go\",\n77|     [(\"\\tif now.Sub(grant.ValidatedAt) > policy.RefreshInterval {\",\n78|        \"\\tif now.Sub(grant.ValidatedAt) > policy.RefreshInterval && grant.ValidatedAt.Year() == 2026 {\")],\n79|     ownership_command(\"fencing\", r\"^TestOwnershipGateClockNonAuthority$\"),\n80|     \"Expire only grants validated in 2026; a lapsed grant translated to 2027 authorizes while the baseline refuses.\"),\n81|    (\"N-gate-same-epoch-loser\", \"edit\", \"internal/fencing/gate.go\",\n82|     [(\"\\tif presented.LeaseID != observation.Winner.LeaseID {\",\n83|        '\\tif presented.LeaseID != observation.Winner.LeaseID && presented.LeaseID != \"' + LEASEC + '\" {')],\n84|     ownership_command(\"fencing\", r\"^TestOwnershipGateSingleAuthorizedOwner$\"),\n85|     \"Admit exactly the above-winner loser past the tie-break; the loser authorizes and exactly-one fails.\"),\n86|    (\"N-gate-remote-holder\", \"edit\", \"internal/fencing/gate.go\",\n87|     [(\"\\tif observation.Winner.HolderHostID != observation.LocalHostID {\",\n88|        '\\tif observation.Winner.HolderHostID != observation.LocalHostID && observation.LocalHostID != \"' + HOSTB + '\" {')],\n89|     ownership_command(\"fencing\", r\"^TestOwnershipGateSingleAuthorizedOwner$\"),\n90|     \"Admit exactly the remote host past the locality arm; the remote exact token authorizes and the two-host exclusion fails.\"),\n91|    (\"C-harmless-comment\", \"edit\", \"internal/sessstate/sessstate.go\",\n92|     [(\"\\t// First pass: validate every union entry and select the greatest\",\n93|        \"\\t// First pass: validate every union entry and select the greatest\\n\\t// classifier control: comment only, no behavior change.\")],\n94|     ownership_command(\"sessstate\", r\"^TestOwnershipUnionOrderIndependent$\"),\n95|     \"Applied control: a behavior-preserving plant survives through the same instrument.\"),\n96|    (\"C-not-applied\", \"edit\", \"internal/sessstate/sessstate.go\",\n97|     [(\"TOKEN_THAT_IS_NOT_PRESENT\", \"replacement\")],\n98|     ownership_command(\"sessstate\", r\"^TestOwnershipUnionOrderIndependent$\"),\n99|     \"Application control: missing patch is not a killed mutant.\"),\n100|    (\"C-compile-failure\", \"edit\", \"internal/sessstate/sessstate.go\",\n101|     [(\"package sessstate\", \"package sessstate\\nthis is invalid Go\")],\n102|     ownership_command(\"sessstate\", r\"^TestOwnershipUnionOrderIndependent$\"),\n103|     \"Compilation control: no named failed behavioral test is not a kill.\"),\n104|]\n105|\n106|selected = [row for row in MUTANTS if name_filter in row[0]]\n107|if name_filter and not selected:\n108|    raise SystemExit(\"name-filter matched no mutant\")\n109|\n110|\n111|def classify(name, command, bound):\n112|    try:\n113|        with (output / (name + \"-\" + tag + \".log\")).open(\"w\") as log:\n114|            process = subprocess.run(command, cwd=copy, stdout=log, stderr=subprocess.STDOUT, timeout=300)\n115|        text = (output / (name + \"-\" + tag + \".log\")).read_text()\n116|        failures = re.findall(r\"^\\s*--- FAIL: ([^ ]+)\", text, re.M)\n117|        ran_tests = re.findall(r\"^=== RUN \", text, re.M)\n118|        classification = \"COMPILE_OR_HARNESS_FAILURE\" if not ran_tests else (\"SURVIVED\" if process.returncode == 0 else (\"KILLED\" if failures else \"COMPILE_OR_HARNESS_FAILURE\"))\n119|        results.append(dict(mutant=name, classification=classification, exit=process.returncode, failed_tests=failures, bound=bound, command=command))\n120|        print(name, classification, process.returncode, \", \".join(failures), flush=True)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
