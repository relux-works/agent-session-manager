{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca53","stream":{"kind":"session","id":"01a0ae9c-cde9-7503-b771-d867bf2eff64"},"sequence":900,"recorded_at":1780531400001795,"record_type":"event","durability":"durable","causation_id":"c50b0c1e-3e8f-47ac-b724-ccf66299a997","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"c50b0c1e-3e8f-47ac-b724-ccf66299a997","run_stream":{"kind":"run","id":"c50b0c1e-3e8f-47ac-b724-ccf66299a997"},"task_stream":{"kind":"task","id":"01a0ae9f-1101-7262-ba6b-4bbfedf99128"},"task_id":"01a0ae9f-1101-7262-ba6b-4bbfedf99128","event":{"kind":"output","task_id":"01a0ae9f-1101-7262-ba6b-4bbfedf99128","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1oqfec/worktree/internal/sessstate/sessstate.go`.\n(473 line(s) above)\n474|func (fold *chainFold) trackLease(event Event, lease LeaseHead) (bool, error) {\n475|\tif !fold.haveLease {\n476|\t\tfold.current = lease\n477|\t\tfold.createLease = lease\n478|\t\tfold.haveLease = true\n479|\t\tfold.leases = append(fold.leases, lease)\n480|\t\tfold.trackTail(event)\n481|\t\treturn false, nil\n482|\t}\n483|\tswitch Compare(lease, fold.current) {\n484|\tcase 0:\n485|\t\tfold.trackTail(event)\n486|\t\treturn false, nil\n487|\tcase 1:\n488|\t\tif lease.Epoch == fold.current.Epoch {\n489|\t\t\treturn false, refuse(ErrDivergentLease, \"event %s under lease %s diverges from chain head lease %s at epoch %d\", event.ID, lease.LeaseID, fold.current.LeaseID, fold.current.Epoch)\n490|\t\t}\n491|\t\tif lease.Epoch > fold.current.Epoch+1 {\n492|\t\t\tfold.conflict(ConflictEpochGap, ResolveRuleGreatestTupleWins,\n493|\t\t\t\t\"lease epoch jumps from %d to %d at event %s; only an explicit takeover checkpoint heals the gap\",\n494|\t\t\t\tfold.current.Epoch, lease.Epoch, event.ID)\n495|\t\t}\n496|\t\tfold.previous = fold.current\n497|\t\tfold.current = lease\n498|\t\tfold.leases = append(fold.leases, lease)\n499|\t\tfold.trackTail(event)\n500|\t\treturn true, nil\n501|\tdefault:\n502|\t\treturn false, refuse(ErrStaleLease, \"event %s lease epoch %d precedes chain head epoch %d\", event.ID, lease.Epoch, fold.current.Epoch)\n503|\t}\n504|}\n505|\n506|// tailID and tailSeq live beside the fold; declared here to keep the\n507|// struct literal above readable.\n508|func (fold *chainFold) conflict(kind, rule, format string, arguments ...any) {\n509|\tfold.projection.Conflicts = append(fold.projection.Conflicts, Conflict{\n510|\t\tKind:   kind,\n511|\t\tRule:   rule,\n512|\t\tDetail: fmt.Sprintf(format, arguments...),\n513|\t})\n514|}\n515|\n516|// step moves the derivation through the Section 5.7 table. An empty\n517|// target keeps the state (a fact or inert event performs no\n518|// transition); an equal target restates it (a confirming event while\n519|// already there is not a transition); the first event may only open a\n520|// bootstrap state; every other move needs its table edge, else\n521|// invalid_state_transition.\n522|func (fold *chainFold) step(target State, what string) error {\n523|\tif target == \"\" || target == fold.state {\n524|\t\treturn nil\n525|\t}\n526|\tif fold.state == \"\" {\n527|\t\tif _, ok := initialTargets[target]; !ok {\n528|\t\t\treturn refuse(ErrInvalidTransition, \"%s opens unbootstrapped state %q\", what, string(target))\n529|\t\t}\n530|\t\tfold.state = target\n531|\t\treturn nil\n532|\t}\n533|\tif _, ok := allowedTransitions[fold.state][target]; !ok {\n534|\t\treturn refuse(ErrInvalidTransition, \"%s moves %q to %q without a Section 5.7 edge\", what, string(fold.state), string(target))\n535|\t}\n536|\tfold.state = target\n537|\treturn nil\n538|}\n539|\n540|// effect applies one event's lifecycle meaning after continuity and\n541|// lease tracking. Fact events return an empty target and keep the\n542|// state; unknown v1 types and the v2/v3/v4 non-lifecycle types are\n543|// inert by Section 5.2 (retained, never applied).\n544|func (fold *chainFold) effect(event Event, lease LeaseHead, succession bool) error {\n545|\tname := \"event \" + event.Type + \" \" + event.ID\n546|\tswitch event.Type {\n547|\tcase \"session.created\":\n548|\t\treturn fold.effectCreated(event, name)\n549|\tcase \"terminal.created\":\n550|\t\treturn fold.effectTerminalCreated(event, name)\n551|\tcase \"provider.launched\":\n552|\t\treturn fold.effectProviderLaunched(event, name)\n553|\tcase \"provider.identified\":\n(more lines below)","final_result":true}}}
