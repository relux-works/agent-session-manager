-ownership-gate-properties\\\"\\n           ]\\n         },\\n         {\\n@@ -4449,7 +4527,8 @@\\n           \\\"excerpt\\\": \\\"2. A replica MUST NOT launch, resume, accept input for, or publish authoritative\\\",\\n           \\\"acceptance_cases\\\": [\\n             \\\"lease-fencing-gates\\\",\\n-            \\\"lease-fencing-park\\\"\\n+            \\\"lease-fencing-park\\\",\\n+            \\\"lease-ownership-gate-properties\\\"\\n           ]\\n         },\\n         {\\n@@ -4466,7 +4545,8 @@\\n           \\\"excerpt\\\": \\\"A peer MUST reject lower-epoch or losing same-epoch events from the\\\",\\n           \\\"acceptance_cases\\\": [\\n             \\\"lease-divergent-preservation\\\",\\n-            \\\"lease-union-resolution\\\"\\n+            \\\"lease-union-resolution\\\",\\n+            \\\"lease-ownership-union-properties\\\"\\n           ]\\n         }\\n       ]\\ndiff --git a/internal/traceability/traceability.go b/internal/traceability/traceability.go\\nindex ab9f7f4..ebc3c4a 100644\\n--- a/internal/traceability/traceability.go\\n+++ b/internal/traceability/traceability.go\\n@@ -40,7 +40,7 @@ const (\\n \\t// reviewedOwnershipCanonicalSHA256 pins the semantic JSON projection. JSON\\n \\t// formatting may change, but ownership claims cannot be self-minted without\\n \\t// an explicit review of this binding.\\n-\\treviewedOwnershipCanonicalSHA256 = \\\"94e589c880a263a61fe3e4e12ed836e076dd7e5bc074b6f6596de35231a53417\\\"\\n+\\treviewedOwnershipCanonicalSHA256 = \\\"63c8379637c5ab72dbc979eed8dcd92b7149969deb3690fa7109a64789e0e121\\\"\\n )\\n \\n var ErrTraceability = errors.New(\\\"spec-to-code traceability check failed\\\")\\ndiff --git a/internal/traceability/traceability_test.go b/internal/traceability/traceability_test.go\\nindex 7426031..10970e9 100644\\n--- a/internal/traceability/traceability_test.go\\n+++ b/internal/traceability/traceability_test.go\\n@@ -29,7 +29,7 @@ func TestVerifyRepositoryAcceptsExactOwnership(t *testing.T) {\\n \\twant := Report{\\n \\t\\tContracts:              63,\\n \\t\\tNormativeSections:      36,\\n-\\t\\tAcceptanceCases:        110,\\n+\\t\\tAcceptanceCases:        113,\\n \\t\\tFixtures:               32,\\n \\t\\tCompatibilityContracts: 55,\\n \\t\\tSectionBindings:        57,\\n\",\n  \"original_output_bytes\": 13456,\n  \"original_output_tokens\": 3364,\n  \"truncated\": false\n}","final_result":true}}}
