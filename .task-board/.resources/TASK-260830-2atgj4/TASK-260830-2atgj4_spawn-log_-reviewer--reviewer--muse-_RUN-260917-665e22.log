{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8ad","stream":{"kind":"session","id":"01a0ae9c-cde9-7503-b771-d867bf2eff64"},"sequence":689,"recorded_at":1780531400001373,"record_type":"event","durability":"durable","causation_id":"c50b0c1e-3e8f-47ac-b724-ccf66299a997","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"c50b0c1e-3e8f-47ac-b724-ccf66299a997","run_stream":{"kind":"run","id":"c50b0c1e-3e8f-47ac-b724-ccf66299a997"},"task_stream":{"kind":"task","id":"01a0ae9e-69ea-7581-930d-1055026e91b8"},"task_id":"01a0ae9e-69ea-7581-930d-1055026e91b8","event":{"kind":"output","task_id":"01a0ae9e-69ea-7581-930d-1055026e91b8","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-1oqfec/worktree/internal/sessstate/ownership_properties_test.go`.\n1|package sessstate\n2|\n3|import (\n4|\t\"fmt\"\n5|\t\"math/rand\"\n6|\t\"reflect\"\n7|\t\"sort\"\n8|\t\"strings\"\n9|\t\"testing\"\n10|)\n11|\n12|// Ownership reducer properties (TASK-260830-2atgj4).\n13|//\n14|// The four story-pinned v0.6.0 invariants over the landed production\n15|// reducers (Reduce/resolveWinner/Compare; sessrepo.WinningLease;\n16|// fencing.Authorize*) under Sections 2.2, 5.3 and 13.6-13.10:\n17|//\n18|//  1. union-order independence — every permutation of a union multiset\n19|//     yields a byte-identical projection;\n20|//  2. loser preservation — a losing lease is never dropped, rewritten\n21|//     or promoted; its history stays visible as conflict evidence;\n22|//  3. clock non-authority — created_at and wall-clock members never\n23|//     influence the winner, the fencing decision or the parked/refused\n24|//     outcome (store and gate halves live in sessrepo and fencing);\n25|//  4. zero duplicate authorized owners — at most one authoritative\n26|//     lease per session and epoch (store and gate halves live in\n27|//     sessrepo and fencing).\n28|//\n29|// This file proves invariants 1 and 2 over Reduce. The generator is a\n30|// closed small alphabet — epochs 1..4, lease IDs R/A/B/C (bytewise\n31|// R < A < B < C) — with exhaustive enumeration where the space is\n32|// small (all multisets of size 0..3, all distinct permutations, all\n33|// ordered 2-partitions, three chain shapes) and bounded seeded-random\n34|// exploration otherwise (seed and iteration counts recorded below).\n35|// No new module dependency: the generators are hand-written loops.\n36|\n37|// propLeaseIDs is the closed lease alphabet in bytewise order.\n38|var propLeaseIDs = []string{testLeaseIDR, testLeaseID, testLeaseIDB, testLeaseIDC}\n39|\n40|// propEpochs is the closed epoch alphabet.\n41|var propEpochs = []uint64{1, 2, 3, 4}\n42|\n43|// propAtoms is every (epoch, lease) pair of the closed alphabet.\n44|func propAtoms() []LeaseHead {\n45|\tvar atoms []LeaseHead\n46|\tfor _, epoch := range propEpochs {\n47|\t\tfor _, leaseID := range propLeaseIDs {\n48|\t\t\tatoms = append(atoms, LeaseHead{Epoch: epoch, LeaseID: leaseID})\n49|\t\t}\n50|\t}\n51|\treturn atoms\n52|}\n53|\n54|// propMax is the independent winner oracle: the greatest (epoch,\n55|// lease_id) tuple using only builtin operators, never production\n56|// Compare. Directional agreement between propMax and Reduce pins the\n57|// bytewise-greater-wins tie-break; a reducer that inverts the\n58|// tie-break still permutes identically but disagrees with propMax.\n59|func propMax(heads []LeaseHead) LeaseHead {\n60|\tvar best LeaseHead\n61|\tfor _, head := range heads {\n62|\t\tif head.Epoch > best.Epoch ||\n63|\t\t\t(head.Epoch == best.Epoch && head.LeaseID > best.LeaseID) {\n64|\t\t\tbest = head\n65|\t\t}\n66|\t}\n67|\treturn best\n68|}\n69|\n70|// propChain is one chain shape with its distinct envelope leases.\n71|type propChain struct {\n72|\tname   string\n73|\tevents []Event\n74|\tleases []LeaseHead\n75|}\n76|\n77|// propChains builds the three chain shapes: empty, one-epoch\n78|// bootstrap under A@1, and a force-takeover succession A@1 -> B@2.\n79|func propChains(t *testing.T, record Record) []propChain {\n80|\tt.Helper()\n81|\traw := buildRecord(t, nil)\n82|\t_, bootstrap, _ := buildChain(t, raw, baseBootstrap(record))\n83|\t_, succession, _ := buildChain(t, raw, append(baseBootstrap(record),\n84|\t\teventSpec{epoch: 2, leaseID: testLeaseIDB, typ: \"lease.transferred\", payload: transferredPayload(testLeaseID, testLeaseIDB)},\n85|\t))\n86|\treturn []propChain{\n87|\t\t{name: \"empty\", events: nil, leases: nil},\n88|\t\t{name: \"bootstrap\", events: bootstrap, leases: []LeaseHead{{Epoch: 1, LeaseID: testLeaseID}}},\n89|\t\t{name: \"succession\", events: succession, leases: []LeaseHead{{Epoch: 1, LeaseID: testLeaseID}, {Epoch: 2, LeaseID: testLeaseIDB}}},\n90|\t}\n91|}\n92|\n93|// propMultisets enumerates every multiset of atoms of size 0..maxSize\n94|// as index combinations with replacement.\n95|func propMultisets(atoms []LeaseHead, maxSize int) [][]LeaseHead {\n96|\tvar out [][]LeaseHead\n97|\tout = append(out, nil)\n98|\tindices := make([]int, 0, maxSize)\n99|\tvar rec func(start, depth, size int)\n100|\tfor size := 1; size <= maxSize; size++ {\n101|\t\tindices = indices[:0]\n102|\t\trec = func(start, depth, _ int) {\n103|\t\t\tif depth == size {\n104|\t\t\t\tmultiset := make([]LeaseHead, size)\n105|\t\t\t\tfor i, index := range indices {\n106|\t\t\t\t\tmultiset[i] = atoms[index]\n107|\t\t\t\t}\n108|\t\t\t\tout = append(out, multiset)\n109|\t\t\t\treturn\n110|\t\t\t}\n111|\t\t\tfor i := start; i < len(atoms); i++ {\n112|\t\t\t\tindices = append(indices, i)\n113|\t\t\t\trec(i, depth+1, size)\n114|\t\t\t\tindices = indices[:len(indices)-1]\n115|\t\t\t}\n116|\t\t}\n117|\t\trec(0, 0, size)\n118|\t}\n119|\treturn out\n120|}\n121|\n122|// propPermutations enumerates every distinct permutation of a\n123|// multiset. Sizes stay small (at most 3! = 6 exhaustive), so a\n124|// Heap's enumeration with an encoding set is enough.\n125|func propPermutations(multiset []LeaseHead) [][]LeaseHead {\n126|\tif len(multiset) == 0 {\n127|\t\treturn [][]LeaseHead{nil}\n128|\t}\n129|\tencode := func(heads []LeaseHead) string {\n130|\t\tvar sb strings.Builder\n131|\t\tfor _, head := range heads {\n132|\t\t\tfmt.Fprintf(&sb, \"%d/%s;\", head.Epoch, head.LeaseID)\n133|\t\t}\n134|\t\treturn sb.String()\n135|\t}\n136|\tvar out [][]LeaseHead\n137|\tseen := map[string]struct{}{}\n138|\twork := append([]LeaseHead(nil), multiset...)\n139|\tvar generate func(n int)\n140|\tgenerate = func(n int) {\n141|\t\tif n == 1 {\n142|\t\t\tif key := encode(work); key != \"\" {\n143|\t\t\t\tif _, dup := seen[key]; !dup {\n144|\t\t\t\t\tseen[key] = struct{}{}\n145|\t\t\t\t\tout = append(out, append([]LeaseHead(nil), work...))\n146|\t\t\t\t}\n147|\t\t\t}\n148|\t\t\treturn\n149|\t\t}\n150|\t\tfor i := 0; i < n; i++ {\n151|\t\t\tgenerate(n - 1)\n152|\t\t\tif n%2 == 1 {\n153|\t\t\t\twork[0], work[n-1] = work[n-1], work[0]\n154|\t\t\t} else {\n155|\t\t\t\twork[i], work[n-1] = work[n-1], work[i]\n156|\t\t\t}\n157|\t\t}\n158|\t}\n159|\tgenerate(len(work))\n160|\treturn out\n161|}\n162|\n163|// propSortedUnion is the canonical representative of a union\n164|// multiset: ascending tuple order by the independent oracle order.\n165|func propSortedUnion(multiset []LeaseHead) []LeaseHead {\n166|\tsorted := append([]LeaseHead(nil), multiset...)\n167|\tsort.Slice(sorted, func(i, j int) bool {\n168|\t\tif sorted[i].Epoch != sorted[j].Epoch {\n169|\t\t\treturn sorted[i].Epoch < sorted[j].Epoch\n170|\t\t}\n171|\t\treturn sorted[i].LeaseID < sorted[j].LeaseID\n172|\t})\n173|\treturn sorted\n174|}\n175|\n176|// propPartitions enumerates every ordered 2-partition concatenation of\n177|// a multiset: the 2^n ways to split its positions into a first and a\n178|// second successive observation, concatenated back into one union\n179|// list. Every concatenation is a permutation of the multiset, so\n180|// permutation-invariance entails partition-invariance; the partition\n181|// test executes the enumeration distinctly as the reconnect\n182|// narrative (observe U1, then U1++U2 after reconnect).\n183|func propPartitions(multiset []LeaseHead) [][]LeaseHead {\n184|\tvar out [][]LeaseHead\n185|\tfor mask := 0; mask < (1 << len(multiset)); mask++ {\n186|\t\tvar first, second []LeaseHead\n187|\t\tfor i, head := range multiset {\n188|\t\t\tif mask&(1<<i) == 0 {\n189|\t\t\t\tfirst = append(first, head)\n190|\t\t\t} else {\n191|\t\t\t\tsecond = append(second, head)\n192|\t\t\t}\n193|\t\t}\n194|\t\tout = append(out, append(first, second...))\n195|\t}\n196|\treturn out\n197|}\n198|\n199|func propReduce(t *testing.T, record Record, chain propChain, union []LeaseHead) Projection {\n200|\tt.Helper()\n(more lines below)","final_result":true}}}
