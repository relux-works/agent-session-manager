alf(\\\"run(assigned sections) output = %q, want %q\\\", output.String(), want)\\ndiff --git a/internal/traceability/ownership.v0.6.0.json b/internal/traceability/ownership.v0.6.0.json\\nindex 3873390..888a329 100644\\n--- a/internal/traceability/ownership.v0.6.0.json\\n+++ b/internal/traceability/ownership.v0.6.0.json\\n@@ -3058,6 +3058,77 @@\\n           \\\"declaration\\\": \\\"TestLeaseTokenConstructorCensus\\\"\\n         }\\n       ]\\n+    },\\n+    {\\n+      \\\"id\\\": \\\"lease-ownership-union-properties\\\",\\n+      \\\"production\\\": {\\n+        \\\"path\\\": \\\"internal/sessstate/sessstate.go\\\",\\n+        \\\"declaration\\\": \\\"Reduce\\\"\\n+      },\\n+      \\\"tests\\\": [\\n+        {\\n+          \\\"path\\\": \\\"internal/sessstate/ownership_properties_test.go\\\",\\n+          \\\"declaration\\\": \\\"TestOwnershipUnionOrderIndependent\\\"\\n+        },\\n+        {\\n+          \\\"path\\\": \\\"internal/sessstate/ownership_properties_test.go\\\",\\n+          \\\"declaration\\\": \\\"TestOwnershipUnionOrderRegression\\\"\\n+        },\\n+        {\\n+          \\\"path\\\": \\\"internal/sessstate/ownership_properties_test.go\\\",\\n+          \\\"declaration\\\": \\\"TestOwnershipUnionPartitionStable\\\"\\n+        },\\n+        {\\n+          \\\"path\\\": \\\"internal/sessstate/ownership_properties_test.go\\\",\\n+          \\\"declaration\\\": \\\"TestOwnershipLoserHistoryPreserved\\\"\\n+        },\\n+        {\\n+          \\\"path\\\": \\\"internal/sessstate/ownership_properties_test.go\\\",\\n+          \\\"declaration\\\": \\\"TestOwnershipWinnerIsTupleMaximum\\\"\\n+        }\\n+      ]\\n+    },\\n+    {\\n+      \\\"id\\\": \\\"lease-ownership-store-properties\\\",\\n+      \\\"production\\\": {\\n+        \\\"path\\\": \\\"internal/sessrepo/lease_store.go\\\",\\n+        \\\"declaration\\\": \\\"WinningLease\\\"\\n+      },\\n+      \\\"tests\\\": [\\n+        {\\n+          \\\"path\\\": \\\"internal/sessrepo/lease_proper