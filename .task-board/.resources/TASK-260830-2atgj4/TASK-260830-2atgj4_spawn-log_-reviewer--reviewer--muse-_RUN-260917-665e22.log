s %+v: %d leases stored, want %d\", reasons, len(summaries), len(reasons)+1)\n208|\t\t}\n209|\t\tseenEpoch := map[uint64]int{}\n210|\t\tfor index, summary := range summaries {\n211|\t\t\tseenEpoch[summary.Epoch]++\n212|\t\t\tif want := uint64(index + 1); summary.Epoch != want {\n213|\t\t\t\tt.Fatalf(\"reasons %+v: lease %d epoch = %d, want %d in tuple order\",\n214|\t\t\t\t\treasons, index, summary.Epoch, want)\n215|\t\t\t}\n216|\t\t\tif _, err := repository.GetLease(testSessionID, summary.RecordID); err != nil {\n217|\t\t\t\tt.Fatalf(\"reasons %+v: GetLease(%s) error = %v\", reasons, summary.RecordID, err)\n218|\t\t\t}\n219|\t\t}\n220|\t\tfor epoch, count := range seenEpoch {\n221|\t\t\tif count != 1 {\n222|\t\t\t\tt.Fatalf(\"reasons %+v: epoch %d carries %d leases, want exactly one\", reasons, epoch, count)\n223|\t\t\t}\n224|\t\t}\n225|\t\twinner, err := repository.WinningLease(testSessionID)\n226|\t\tif err != nil {\n227|\t\t\tt.Fatalf(\"reasons %+v: WinningLease error = %v\", reasons, err)\n228|\t\t}\n229|\t\thead := summaries[len(summaries)-1]\n230|\t\tif winner.RecordID != head.RecordID {\n231|\t\t\tt.Fatalf(\"reasons %+v: winner %s is not the tuple-maximum head %s\", reasons, winner.RecordID, head.RecordID)\n232|\t\t}\n233|\t\tvar best LeaseSummary\n234|\t\tfor i, summary := range summaries {\n235|\t\t\tif i == 0 || CompareLeaseTuple(summary, best) > 0 {\n236|\t\t\t\tbest = summary\n237|\t\t\t}\n238|\t\t}\n239|\t\tif winner.RecordID != best.RecordID {\n240|\t\t\tt.Fatalf(\"reasons %+v: winner %s is not the compared maximum %s\", reasons, winner.RecordID, best.RecordID)\n241|\t\t}\n242|\t}\n243|\tvar exhaustive [][]string\n244|\texhaustive = append(exhaustive, nil)\n245|\tfor _, first := range propReasons {\n246|\t\texhaustive = append(exhaustive, []string{first})\n247|\t\tfor _, second := range propReasons {\n248|\t\t\texhaustive = append(exhaustive, []string{first, second})\n249|\t\t}\n250|\t}\n251|\tfor _, reasons := range exhaustive {\n252|\t\tcheck(t, reasons)\n253|\t}\n254|\trng := rand.New(rand.NewSource(260831))\n255|\tconst randomSequences = 200\n256|\tfor i := 0; i < randomSequences; i++ {\n257|\t\tlength := 3 + rng.Intn(3)\n258|\t\treasons := make([]string, length)\n259|\t\tfor j := range reasons {\n260|\t\t\treasons[j] = propReasons[rng.Intn(len(propReasons))]\n261|\t\t}\n262|\t\tcheck(t, reasons)\n263|\t}\n264|\tt.Logf(\"store-single-authority: %d exhaustive + %d seeded-random sequences (seed 260831)\", len(exhaustive), randomSequences)\n265|}\n266|\n267|// TestOwnershipStoreLoserBytesPreserved proves the durability half of\n268|// invariant 2: a superseded lease is never dropped or rewritten —\n269|// its blob stays byte-identical and verifiable after successions —\n270|// and sessions are isolated: interleaved chains never share\n271|// authority.\n272|func TestOwnershipStoreLoserBytesPreserved(t *testing.T) {\n273|\trepository := openTestRepository(t)\n274|\tcreateTestSession(t, repository)\n275|\tother := buildRecord(t, func(object map[string]any) {\n276|\t\tobject[\"subject_id\"] = testSessionIDB\n277|\t\tobject[\"session_id\"] = testSessionIDB\n278|\t})\n279|\tif _, err := repository.CreateSession(other); err != nil {\n280|\t\tt.Fatalf(\"CreateSession(B) error = %v\", err)\n281|\t}\n282|\tfirst := mustCreateLease(t, repository, testSessionID, createLeaseFixture())\n283|\tbefore := mustGetLease(t, repository, testSessionID, first.RecordID)\n284|\tsecond := mustCompareAndSwap(t, repository, testSessionID,\n285|\t\tLeaseExpectation{RecordID: first.RecordID}, successorLeaseFixture())\n286|\tafter := mustGetLease(t, repository, testSessionID, first.RecordID)\n287|\tif !bytes.Equal(before, after) {\n288|\t\tt.Fatal(\"epoch-1 lease bytes changed across a succession; losers must be immutable\")\n289|\t}\n290|\tthird := mustCompareAndSwap(t, repository, testSessionID,\n291|\t\tLeaseExpectation{RecordID: second.RecordID}, SuccessorLeaseInput{\n292|\t\t\tCreateLeaseInput: CreateLeaseInput{\n293|\t\t\t\tLeaseID: testLeaseIDC, HolderHostID: testHostID,\n294|\t\t\t\tIssuedByHostID: testHostID, CreatedAt: testLeaseAt,\n295|\t\t\t},\n296|\t\t\tReason:       \"force_takeover\",\n297|\t\t\tCheckpointID: zeroDigest,\n298|\t\t})\n299|\t_ = third\n300|\tagain := mustGetLease(t, repository, testSessionID, first.RecordID)\n301|\tif !bytes.Equal(before, again) {\n302|\t\tt.Fatal(\"epoch-1 lease bytes changed across two successions; losers must be immutable\")\n303|\t}\n304|\tsummaries, err := repository.ListLeases(testSessionID)\n305|\tif err != nil {\n306|\t\tt.Fatalf(\"ListLeases(A) error = %v\", err)\n307|\t}\n308|\tif len(summaries) != 3 {\n309|\t\tt.Fatalf(\"ListLeases(A) = %d leases, want 3; no lease may be dropped\", len(summaries))\n310|\t}\n311|\t// The sibling session holds no leases yet: authority never leaks\n312|\t// across sessions.\n313|\tsibling, err := repository.ListLeases(testSessionIDB)\n314|\tif err != nil {\n315|\t\tt.Fatalf(\"ListLeases(B) error = %v\", err)\n316|\t}\n317|\tif len(sibling) != 0 {\n318|\t\tt.Fatalf(\"ListLeases(B) = %+v, want none; sessions must be isolated\", sibling)\n319|\t}\n320|\twinnerA, err := repository.WinningLease(testSessionID)\n321|\tif err != nil {\n322|\t\tt.Fatalf(\"WinningLease(A) error = %v\", err)\n323|\t}\n324|\tif winnerA.Epoch != 3 || winnerA.LeaseID != testLeaseIDC {\n325|\t\tt.Fatalf(\"WinningLease(A) = %+v, want epoch 3 lease C\", winnerA)\n326|\t}\n327|}\n328|\n329|// TestOwnershipStoreTwoHandlesOneHead proves the two-process half of\n330|// invariant 4 at the store layer: the head derives from the blobs on\n331|// every read, so a second handle sees a committed succession\n332|// immediately, and a lagging compare-and-swap refuses stale instead\n333|// of forking a second head.\n334|func TestOwnershipStoreTwoHandlesOneHead(t *testing.T) {\n335|\trepository := openTestRepository(t)\n336|\tcreateTestSession(t, repository)\n337|\tfirst := mustCreateLease(t, repository, testSessionID, createLeaseFixture())\n338|\t// A lagging handle that still expects the epoch-1 head after a\n339|\t// succession refuses stale; it must not fork a second epoch-2.\n340|\tsecond := mustCompareAndSwap(t, repository, testSessionID,\n341|\t\tLeaseExpectation{RecordID: first.RecordID}, successorLeaseFixture())\n342|\tstaleInput := SuccessorLeaseInput{\n343|\t\tCreateLeaseInput: CreateLeaseInput{\n344|\t\t\tLeaseID: testLeaseIDC, HolderHostID: testHostID,\n345|\t\t\tIssuedByHostID: testHostID, CreatedAt: testLeaseAt,\n346|\t\t},\n347|\t\tReason:       \"force_takeover\",\n348|\t\tCheckpointID: zeroDigest,\n349|\t}\n350|\t_, err := repository.CompareAndSwapLease(testSessionID,\n351|\t\tLeaseExpectation{RecordID: first.RecordID}, staleInput)\n352|\tif !errors.Is(err, ErrStaleLeaseEpoch) {\n353|\t\tt.Fatalf(\"lagging CAS error = %v, want stale lease epoch; a second epoch-2 head must not fork\", err)\n354|\t}\n355|\twinner, err := repository.WinningLease(testSessionID)\n356|\tif err != nil {\n357|\t\tt.Fatalf(\"WinningLease error = %v\", err)\n358|\t}\n359|\tif winner.RecordID != second.RecordID {\n360|\t\tt.Fatalf(\"winner = %s, want the single committed head %s\", winner.RecordID, second.RecordID)\n361|\t}\n362|\tsummaries, err := repository.ListLeases(testSessionID)\n363|\tif err != nil {\n364|\t\tt.Fatalf(\"ListLeases error = %v\", err)\n365|\t}\n366|\tif len(summaries) != 2 {\n367|\t\tt.Fatalf(\"ListLeases = %d leases, want 2; the refused CAS must persist nothing\", len(summaries))\n368|\t}\n369|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
