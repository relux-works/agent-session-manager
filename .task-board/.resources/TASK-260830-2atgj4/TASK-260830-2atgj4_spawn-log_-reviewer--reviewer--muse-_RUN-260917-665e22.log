, lease := range fold.chainLeases() {\n922|\t\tnote(lease)\n923|\t}\n924|\t// First pass: validate every union entry and select the greatest\n925|\t// tuple. The winner depends only on the multiset, never on\n926|\t// arrival order.\n927|\tfor _, lease := range union {\n928|\t\tif lease.IsZero() {\n929|\t\t\treturn refuse(ErrInvalidEvent, \"union carries an empty lease head\")\n930|\t\t}\n931|\t\tif _, err := scalar.ParseUUIDv4(lease.LeaseID); err != nil {\n932|\t\t\treturn refuse(ErrInvalidEvent, \"union lease %q is not a UUIDv4: %v\", lease.LeaseID, err)\n933|\t\t}\n934|\t\tnote(lease)\n935|\t\tif Compare(lease, winner) > 0 {\n936|\t\t\twinner = lease\n937|\t\t}\n938|\t}\n939|\t// Second pass: every union entry strictly below the final winner\n940|\t// is reported preserved-never-applied in ascending tuple order,\n941|\t// naming the final winner. Reporting each loss against the\n942|\t// transient arrival-order winner instead would make the conflict\n943|\t// evidence — even its presence — depend on union order. A\n944|\t// duplicate of the winning tuple is neither greater nor lesser,\n945|\t// so it reports nothing and the off-chain flag below stands.\n946|\tlosing := make([]LeaseHead, 0, len(union))\n947|\tfor _, lease := range union {\n948|\t\tif Compare(lease, winner) < 0 {\n949|\t\t\tlosing = append(losing, lease)\n950|\t\t}\n951|\t}\n952|\tsort.Slice(losing, func(i, j int) bool { return Compare(losing[i], losing[j]) < 0 })\n953|\tfor _, lease := range losing {\n954|\t\tfold.conflict(ConflictLosingBranchPreserved, ResolveRulePreservedNeverApplied,\n955|\t\t\t\"union lease (%d, %s) loses to (%d, %s); its history stays preserved and never applies\",\n956|\t\t\tlease.Epoch, lease.LeaseID, winner.Epoch, winner.LeaseID)\n957|\t}\n958|\tepochs := make([]uint64, 0, len(byEpoch))\n959|\tfor epoch := range byEpoch {\n960|\t\tepochs = append(epochs, epoch)\n961|\t}\n962|\tsort.Slice(epochs, func(i, j int) bool { return epochs[i] < epochs[j] })\n963|\tfor _, epoch := range epochs {\n964|\t\trivals := byEpoch[epoch]\n965|\t\tif len(rivals) < 2 {\n966|\t\t\tcontinue\n967|\t\t}\n968|\t\tordered := make([]string, 0, len(rivals))\n969|\t\tfor id := range rivals {\n970|\t\t\tordered = append(ordered, id)\n971|\t\t}\n972|\t\tsort.Strings(ordered)\n973|\t\tfold.conflict(ConflictSameEpochTie, ResolveRuleGreatestLeaseIDWins,\n974|\t\t\t\"epoch %d is shared by leases %v; the bytewise-greater lease ID %s wins\",\n975|\t\t\tepoch, ordered, ordered[len(ordered)-1])\n976|\t}\n977|\t// The off-chain flag is recomputed from the final winner rather\n978|\t// than tracked through the arrival order: it is set exactly when\n979|\t// the winning tuple stands outside the authoritative chain and\n980|\t// arrived in the union. A repeated winning entry keeps the\n981|\t// conflict recorded (and its divergent_history warning raised).\n982|\toffChainWinner := false\n983|\tif _, ok := onChain[winner.LeaseID]; !ok {\n984|\t\tfor _, lease := range union {\n985|\t\t\tif lease == winner {\n986|\t\t\t\toffChainWinner = true\n987|\t\t\t\tbreak\n988|\t\t\t}\n989|\t\t}\n990|\t}\n991|\tif offChainWinner {\n992|\t\tfold.conflict(ConflictUnionSupersedesChain, ResolveRuleAuthoritativeStateUnchanged,\n993|\t\t\t\"union winner (%d, %s) stands outside the authoritative chain; derived state is unchanged until an explicit takeover lands\",\n994|\t\t\twinner.Epoch, winner.LeaseID)\n995|\t}\n996|\tfold.projection.Winner = winner\n997|\treturn nil\n998|}\n999|\n1000|// chainLeases replays the distinct envelope leases in first-appearance\n1001|// order. Every succession appends, so a tie planted at any past epoch\n1002|// still resolves against the lease the chain actually stood on. Gaps\n1003|// were already recorded at succession time.\n1004|func (fold *chainFold) chainLeases() []LeaseHead {\n1005|\treturn append([]LeaseHead(nil), fold.leases...)\n1006|}\n1007|\n1008|// applyLocalLease derives the local projection: the owner host of the\n1009|// newest authoritative event decides the local role against the\n1010|// caller-supplied host, and a local lease that lost the tuple rule\n1011|// stales the projection exactly where the table lets it go stale.\n1012|func (fold *chainFold) applyLocalLease(local LeaseHead, localHostID string) {\n1013|\tif localHostID != \"\" && fold.projection.OwnerHostID != \"\" {\n1014|\t\tif localHostID == fold.projection.OwnerHostID {\n1015|\t\t\tfold.projection.LocalRole = \"owner\"\n1016|\t\t} else {\n1017|\t\t\tfold.projection.LocalRole = \"replica\"\n1018|\t\t}\n1019|\t}\n1020|\tif local.IsZero() || !fold.haveLease {\n1021|\t\treturn\n1022|\t}\n1023|\t// Only a lease that lost the tuple rule stales the projection:\n1024|\t// an equal or strictly greater local lease stands with the\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
