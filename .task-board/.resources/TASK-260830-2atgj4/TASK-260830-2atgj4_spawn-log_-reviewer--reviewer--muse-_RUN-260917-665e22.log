Contracts              int\\n52-\\tNormativeSections      int\\n53-\\tAcceptanceCases        int\\n54-\\tFixtures               int\\n55-\\tCompatibilityContracts int\\n56-\\tAssignedScopes         int\\n57-\\n58-\\t// SectionBindings and the coverage counters below are a measured ratio over\\n59-\\t// the registered section bindings, not a prose claim. NormativeClauses is\\n60-\\t// the number of RFC 2119 clause lines the pinned document itself carries in\\n61-\\t// the bound sections; DischargedClauses is how many of those a binding\\n62-\\t// enumerates with a verified excerpt and an acceptance owner.\\n63-\\tSectionBindings     int\\n64-\\tFullCoverage        int\\n65-\\tPartialCoverage     int\\n66-\\tSliverCoverage      int\\n67-\\tUnevidencedCoverage int\\n68-\\tUnmeasuredCoverage  int\\n--\\n434-\\t}\\n435-\\tdigest := sha256.Sum256(canonical)\\n436-\\tgotDigest := hex.EncodeToString(digest[:])\\n437:\\tif gotDigest != reviewedOwnershipCanonicalSHA256 {\\n438:\\t\\treturn Report{}, fail(\\\"ownership registry projection digest %s differs from reviewed %s\\\", gotDigest, reviewedOwnershipCanonicalSHA256)\\n439-\\t}\\n440-\\n441-\\treport := Report{\\n442-\\t\\tContracts:              len(expected[ownershipContract]),\\n443-\\t\\tNormativeSections:      len(expected[ownershipNormativeSection]),\\n444-\\t\\tAcceptanceCases:        len(acceptanceIDs),\\n445-\\t\\tFixtures:               len(expected[ownershipFixture]),\\n446-\\t\\tCompatibilityContracts: len(compatibilityCatalog.Contracts),\\n447-\\t\\tAssignedScopes:         len(assignedBindings),\\n448-\\t\\tSectionBindings:        len(coverage),\\n449-\\t\\tUnownedSections:        len(unowned),\\n450-\\t}\\n451-\\tfor _, measured := range coverage {\\n452-\\t\\treport.NormativeClauses += measured.Total\\n453-\\t\\treport.DischargedClauses += measured.Discharged\\n454-\\t\\tswitch measured.Level {\\n455-\\t\\tcase coverageFull:\\n456-\\t\\t\\treport.FullCoverage++\\n457-\\t\\tcase coveragePartial:\\n458-\\t\\t\\treport.PartialCoverage++\\n459-\\t\\tcase coverageSliver:\\n460-\\t\\t\\treport.SliverCoverage++\\n\",\n  \"original_output_bytes\": 2647,\n  \"original_output_tokens\": 662,\n  \"truncated\": false\n}","final_result":true}}}
