func TestExecuteRestoreRefreshBounded(t *testing.T) {
	t.Run("deadline", func(t *testing.T) {
		fx := newLifecycleFixture(t, fullLifecycleAdmitted())
		fx.lc.LocalHostID = lxHost
		start := time.Now()
		var deadline time.Time
		var hasDeadline bool
		fx.lc.LeaseRefresh = func(ctx context.Context, sessionID string) (RefreshWinner, error) {
			deadline, hasDeadline = ctx.Deadline()
			return RefreshWinner{LeaseID: lxLease, Epoch: 7, HolderHostID: lxHost}, nil
		}
		recordBinding(t, fx, lxDigestA)
		fx.runner.queue("new-session", "", 0)
		outcome, err := fx.lc.Execute(context.Background(), OpRequest{
			Operation: "restore", Body: lxRestoreBody(t, lxDigestA, nil), Source: "absent", Admitted: fullLifecycleAdmitted(),
		})
		if err != nil {
			t.Fatal(err)
		}
		if !hasDeadline {
			t.Fatal("refresh ran without a deadline")
		}
		if elapsed := deadline.Sub(start); elapsed < 5*time.Second || elapsed > 5*time.Second+30*time.Second {
			t.Fatalf("refresh bound = %v, want 5s", elapsed)
		}
		if outcome.AfterRestore == nil || outcome.AfterRestore.RefreshBoundMs != 5000 {
			t.Fatalf("branch = %+v", outcome.AfterRestore)
		}
	})
