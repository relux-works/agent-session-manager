        path=f"{PACKAGE}/state.go",
        find='\traw, err := os.ReadFile(filepath.Join(store.root, "tmuxlifecycle", "incarnation", instanceID+".json"))\n\tif err != nil {\n\t\tif errors.Is(err, os.ErrNotExist) {\n\t\t\treturn "", false, nil\n',
        replace='\traw, err := os.ReadFile(filepath.Join(store.root, "tmuxlifecycle", "incarnation", instanceID+".json"))\n\tif err != nil {\n\t\tif errors.Is(err, os.ErrNotExist) || strings.Contains(err.Error(), "is a directory") {\n\t\t\treturn "", false, nil\n',
        count=1,
