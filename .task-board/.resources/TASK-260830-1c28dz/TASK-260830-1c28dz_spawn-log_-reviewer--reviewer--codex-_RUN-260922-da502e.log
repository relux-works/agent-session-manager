        replace='\tinfo, err := leaf.Stat()\n\tif err != nil {\n\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: "runtime mode"}\n\t}\n\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o755 {\n',
        count=1,
