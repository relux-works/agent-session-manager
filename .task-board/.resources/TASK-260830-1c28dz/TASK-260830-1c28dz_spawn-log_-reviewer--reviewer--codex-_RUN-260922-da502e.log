        name="N-mode-narrower-create",
        path=f"{PACKAGE}/runtime_unix.go",
        find="\t// leaf above; the mode comparison below is the load-bearing\n\t// arm this gate's tests and mutants pin.\n\tif info.Mode().Perm() != 0o700 {\n",
        replace="\t// leaf above; the mode comparison below is the load-bearing\n\t// arm this gate's tests and mutants pin.\n\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o600 {\n",
        count=1,
        run="TestEnsureRuntimeDirRefusesNarrowerMode",
        expect="KILLED",
        note="Admits exactly a 0600 leaf at the create-path mode arm; every other non-0700 mode (widened and narrower) still refuses. Kill path: Ensure stops refusing the 0600 fixture.",
    ),
    Mutant(
        name="N-mode-narrower-verify",
        path=f"{PACKAGE}/runtime_unix.go",
        find='\tinfo, err := leaf.Stat()\n\tif err != nil {\n\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: "runtime mode"}\n\t}\n\tif info.Mode().Perm() != 0o700 {\n',
        replace='\tinfo, err := leaf.Stat()\n\tif err != nil {\n\t\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: "runtime mode"}\n\t}\n\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o600 {\n',
        count=1,
