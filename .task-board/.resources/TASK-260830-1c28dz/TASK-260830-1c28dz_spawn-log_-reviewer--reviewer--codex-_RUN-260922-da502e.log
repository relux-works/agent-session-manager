result={'"'shared':len(a.keys()&b.keys()),'moved':moved,'base_only':list(a.keys()-b.keys()),'candidate_only':list(b.keys()-a.keys()),'packages':sorted({x[0] for x in a}|{x[0] for x in b})}
(r/'closure-diff.json').write_text(json.dumps(result,indent=2));print(result)
text=pathlib.Path('internal/tmuxserver/TRACEABILITY.md').read_text(); tables=[];lines=text.splitlines()
for i,line in enumerate(lines):
 if line.startswith('| Gate (site) |'):
  rows=[]
  for row in lines[i+2:]:
   if not row.startswith('|'):break
   rows.append(row)
  counts=collections.Counter(c.strip()[0] for row in rows for c in row.split('|')[2:-1]);tables.append({'rows':len(rows),'cells':dict(counts)})
(r/'census.json').write_text(json.dumps(tables,indent=2));print(tables)
