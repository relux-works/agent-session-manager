// lxCreateBody builds the closed create body. mutate adjusts the
// top-level map (nil for valid).
func lxCreateBody(t *testing.T, mutate func(map[string]any)) []byte {
package tmuxserver

import (
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"os"
	"path/filepath"
	"strings"
	"sync"
	"testing"
