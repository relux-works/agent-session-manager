+			Kind:       terminstance.AuthorizationForceStale,
+			ExpiresAt:  expires,
+		},
+	}
+	stub := &stubPerformer{id: "not-a-digest"}
+	outcome, err := fx.lc.runLifecycleEffects(
+		context.Background(),
+		terminalbackend.OperationTerminateStale,
+		mctx,
