+			Operation: "restore", Body: lxRestoreBody(t, lxDigestA, nil),
+			Source: "absent", Admitted: fullLifecycleAdmitted(),
+		})
+		if err == nil {
+			t.Fatalf("corrupt prior admitted: %+v", outcome.Binding)
+		}
