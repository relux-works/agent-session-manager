esent {\n+\t\tcount, err := runner.probeAttached(probeCtx, instance)\n+\t\tif err != nil {\n+\t\t\treturn empty, err\n+\t\t}\n+\t\tattached = count\n+\t}\n","edit_facts":{"tool_name":"edit_file","path":"internal/tmuxserver/status.go","added":28,"removed":16},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
