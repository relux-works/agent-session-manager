{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c793","stream":{"kind":"session","id":"01a0c9a4-cdaf-7691-9123-20534004d71c"},"sequence":548,"recorded_at":1780531400001091,"record_type":"event","durability":"durable","causation_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","run_stream":{"kind":"run","id":"7d4d0da9-54d0-407b-9491-ce60f372e27f"},"task_stream":{"kind":"task","id":"01a0c9a6-0212-76b2-b2e7-5fea27f001ef"},"task_id":"01a0c9a6-0212-76b2-b2e7-5fea27f001ef","event":{"kind":"output","task_id":"01a0c9a6-0212-76b2-b2e7-5fea27f001ef","chunk":"Read text file `internal/termbind/overlap_test.go`.\n1|package termbind\n2|\n3|import (\n4|\t\"os\"\n5|\t\"path/filepath\"\n6|\t\"testing\"\n7|)\n8|\n9|// TestAttachStorePeers pins the stored peer census the attach\n10|// overlap gate fails closed on: every recorded receipt for the\n11|// instance except the requesting client, sorted by client ID.\n12|func TestAttachStorePeers(t *testing.T) {\n13|\tstore, err := OpenAttachStore(t.TempDir())\n14|\tif err != nil {\n15|\t\tt.Fatal(err)\n16|\t}\n17|\tnow := fixtureNow()\n18|\tif _, _, err := store.Attach(fixtureSession, fixtureInstance, fixtureClient, \"local_only\", true, validAttachAuth(t, \"local_only\", true), now); err != nil {\n19|\t\tt.Fatal(err)\n20|\t}\n21|\tif _, _, err := store.Attach(fixtureSession, fixtureInstance, fixtureClientB, \"local_only\", false, validAttachAuth(t, \"local_only\", false), now); err != nil {\n22|\t\tt.Fatal(err)\n23|\t}\n24|\tpeers, err := store.Peers(fixtureSession, fixtureInstance, fixtureClient)\n25|\tif err != nil {\n26|\t\tt.Fatal(err)\n27|\t}\n28|\tif len(peers) != 1 || peers[0].ClientID != fixtureClientB || peers[0].InputAuthorized {\n29|\t\tt.Fatalf(\"peers = %+v, want exactly the other client without input\", peers)\n30|\t}\n31|\tpeers, err = store.Peers(fixtureSession, fixtureInstance, fixtureClientB)\n32|\tif err != nil {\n33|\t\tt.Fatal(err)\n34|\t}\n35|\tif len(peers) != 1 || peers[0].ClientID != fixtureClient || !peers[0].InputAuthorized {\n36|\t\tt.Fatalf(\"peers = %+v, want exactly the input-authorized other client\", peers)\n37|\t}\n38|}\n39|\n40|// TestAttachStorePeersEmpty pins the no-peer cases: an unrecorded\n41|// instance and a lone client both report no peers.\n42|func TestAttachStorePeersEmpty(t *testing.T) {\n43|\tstore, err := OpenAttachStore(t.TempDir())\n44|\tif err != nil {\n45|\t\tt.Fatal(err)\n46|\t}\n47|\tpeers, err := store.Peers(fixtureSession, fixtureInstance, fixtureClient)\n48|\tif err != nil {\n49|\t\tt.Fatal(err)\n50|\t}\n51|\tif len(peers) != 0 {\n52|\t\tt.Fatalf(\"peers = %+v, want none for an unrecorded instance\", peers)\n53|\t}\n54|\tif _, _, err := store.Attach(fixtureSession, fixtureInstance, fixtureClient, \"local_only\", true, validAttachAuth(t, \"local_only\", true), fixtureNow()); err != nil {\n55|\t\tt.Fatal(err)\n56|\t}\n57|\tpeers, err = store.Peers(fixtureSession, fixtureInstance, fixtureClient)\n58|\tif err != nil {\n59|\t\tt.Fatal(err)\n60|\t}\n61|\tif len(peers) != 0 {\n62|\t\tt.Fatalf(\"peers = %+v, want none for a lone client\", peers)\n63|\t}\n64|}\n65|\n66|// TestAttachStorePeersFailsClosed pins the census health rule: an\n67|// unreadable peer receipt is unknown, never an empty census, and\n68|// staging files are skipped rather than decoded.\n69|func TestAttachStorePeersFailsClosed(t *testing.T) {\n70|\tstore, err := OpenAttachStore(t.TempDir())\n71|\tif err != nil {\n72|\t\tt.Fatal(err)\n73|\t}\n74|\tnow := fixtureNow()\n75|\tif _, _, err := store.Attach(fixtureSession, fixtureInstance, fixtureClient, \"local_only\", true, validAttachAuth(t, \"local_only\", true), now); err != nil {\n76|\t\tt.Fatal(err)\n77|\t}\n78|\tif _, _, err := store.Attach(fixtureSession, fixtureInstance, fixtureClientB, \"local_only\", false, validAttachAuth(t, \"local_only\", false), now); err != nil {\n79|\t\tt.Fatal(err)\n80|\t}\n81|\tdir := filepath.Join(store.root, \"termbind\", \"attach\", fixtureInstance)\n82|\tif err := os.WriteFile(filepath.Join(dir, \"attach-staging.tmp\"), []byte(\"incomplete\"), 0o600); err != nil {\n83|\t\tt.Fatal(err)\n84|\t}\n85|\tif peers, err := store.Peers(fixtureSession, fixtureInstance, fixtureClient); err != nil || len(peers) != 1 {\n86|\t\tt.Fatalf(\"peers = %+v, err = %v; want the peer past the staging file\", peers, err)\n87|\t}\n88|\tif err := os.WriteFile(filepath.Join(dir, fixtureClientB+\".json\"), []byte(\"corrupt\"), 0o600); err != nil {\n89|\t\tt.Fatal(err)\n90|\t}\n91|\tif peers, err := store.Peers(fixtureSession, fixtureInstance, fixtureClient); err == nil {\n92|\t\tt.Fatalf(\"peers = %+v, want the decode error instead of a census\", peers)\n93|\t}\n94|}\n95|\n96|// TestAttachStorePeersRejectsForeignReceipt pins the binding rule:\n97|// a receipt filed under this instance that names another session\n98|// or instance is corruption, never a peer.\n99|func TestAttachStorePeersRejectsForeignReceipt(t *testing.T) {\n100|\tstore, err := OpenAttachStore(t.TempDir())\n101|\tif err != nil {\n102|\t\tt.Fatal(err)\n103|\t}\n104|\tnow := fixtureNow()\n105|\tif _, _, err := store.Attach(fixtureSession, fixtureInstance, fixtureClient, \"local_only\", true, validAttachAuth(t, \"local_only\", true), now); err != nil {\n106|\t\tt.Fatal(err)\n107|\t}\n108|\tforeign, err := encodeAttachReceipt(AttachReceipt{\n109|\t\tSessionID:          fixtureSession,\n110|\t\tTerminalInstanceID: fixtureBootstrap,\n111|\t\tClientID:           fixtureClientB,\n112|\t\tTransport:          \"local_only\",\n113|\t}, fixtureCreatedAt)\n114|\tif err != nil {\n115|\t\tt.Fatal(err)\n116|\t}\n117|\tdir := filepath.Join(store.root, \"termbind\", \"attach\", fixtureInstance)\n118|\tif err := os.WriteFile(filepath.Join(dir, fixtureClientB+\".json\"), foreign, 0o600); err != nil {\n119|\t\tt.Fatal(err)\n120|\t}\n121|\tif peers, err := store.Peers(fixtureSession, fixtureInstance, fixtureClient); err == nil {\n122|\t\tt.Fatalf(\"peers = %+v, want the binding error instead of a census\", peers)\n123|\t}\n124|}","final_result":true}}}
