{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c971","stream":{"kind":"session","id":"01a0c9a4-cdaf-7691-9123-20534004d71c"},"sequence":787,"recorded_at":1780531400001569,"record_type":"event","durability":"durable","causation_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","run_stream":{"kind":"run","id":"7d4d0da9-54d0-407b-9491-ce60f372e27f"},"task_stream":{"kind":"task","id":"01a0c9aa-e86c-7823-9f48-aae86e87461e"},"task_id":"01a0c9aa-e86c-7823-9f48-aae86e87461e","event":{"kind":"output","task_id":"01a0c9aa-e86c-7823-9f48-aae86e87461e","chunk":"Read text file `internal/tmuxserver/lifecycle_rev8_unix_test.go`.\n1|//go:build !windows\n2|\n3|package tmuxserver\n4|\n5|import (\n6|\t\"context\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"testing\"\n10|\t\"time\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n13|)\n14|\n15|// This file pins the revision-8 rework findings through the\n16|// production entries: the stop escalation revalidation (rev7 P1-A),\n17|// the deadline/cancellation-bounded waits (rev7 P2), the attach\n18|// overlap fail-closed gate (rev7 P1-B narrowed to this leaf's bound,\n19|// with the liveness census owned by TASK-260922-vcx6yo), and the measured effect-boundary audit over\n20|// every other multi-command or waiting effect. Every test drives\n21|// Lifecycle.Execute (or the documented store entry) and asserts the\n22|// literal effect — the absence of the forbidden command, receipt,\n23|// or wait — never a string report.\n24|\n25|// TestExecuteStopRefusesStaleFactsAfterPoll pins the escalation\n26|// revalidation: the graceful interrupt runs, exactly one admission\n27|// fact changes during the has-session poll, and the escalation must\n28|// refuse without issuing kill-session. The graceful wait expiring\n29|// is the escalation trigger — a graceful timeout escalates — but\n30|// an operation deadline passed, an authorization lapsed, or a\n31|// generation rotated during the poll refuses instead. The test\n32|// asserts the kill absence, not merely the final error: the\n33|// returned result already lists graceful_stop_requested, and no\n34|// late refusal un-runs a kill.\n35|func TestExecuteStopRefusesStaleFactsAfterPoll(t *testing.T) {\n36|\tfor _, fact := range []string{\"generation\", \"authorization\", \"deadline\", \"deadline-instant\"} {\n37|\t\tt.Run(fact, func(t *testing.T) {\n38|\t\t\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n39|\t\t\tgeneration := lxGeneration\n40|\t\t\tfx.lc.CurrentGeneration = func() string { return generation }\n41|\t\t\traw := lxStopBody(t, 5, func(object map[string]any) {\n42|\t\t\t\tcontext := object[\"context\"].(map[string]any)\n43|\t\t\t\tswitch fact {\n44|\t\t\t\tcase \"authorization\":\n45|\t\t\t\t\tcontext[\"authorization\"].(map[string]any)[\"expires_at\"] = \"2026-09-01T12:00:00.003Z\"\n46|\t\t\t\tcase \"deadline\":\n47|\t\t\t\t\tcontext[\"deadline_at\"] = \"2026-09-01T12:00:00.003Z\"\n48|\t\t\t\tcase \"deadline-instant\":\n49|\t\t\t\t\tcontext[\"deadline_at\"] = \"2026-09-01T12:00:00.010Z\"\n50|\t\t\t\t}\n51|\t\t\t})\n52|\t\t\t// The kill and the second confirm are queued so a\n53|\t\t\t// regression fails on the kill-absence assertion\n54|\t\t\t// with the forbidden command recorded — not on an\n55|\t\t\t// unscripted-call error.\n56|\t\t\tfx.runner.queue(\"send-keys\", \"\", 0).queue(\"has-session\", \"\", 0).\n57|\t\t\t\tqueueFull(\"has-session\", \"\", \"can't find session: \"+lxInstance, 1).\n58|\t\t\t\tqueue(\"kill-session\", \"\", 0)\n59|\t\t\tseen := false\n60|\t\t\tfx.runner.onRun = func(argv []string) {\n61|\t\t\t\tif len(argv) >= 4 && argv[3] == \"has-session\" && !seen {\n62|\t\t\t\t\tseen = true\n63|\t\t\t\t\tif fact == \"generation\" {\n64|\t\t\t\t\t\tgeneration = \"generation-two\"\n65|\t\t\t\t\t}\n66|\t\t\t\t\tfx.clock.Sleep(10 * time.Millisecond)\n67|\t\t\t\t}\n68|\t\t\t}\n69|\t\t\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n70|\t\t\t\tOperation: \"request-stop\", Body: raw, Source: \"quiescing\", Admitted: fullLifecycleAdmitted(),\n71|\t\t\t})\n72|\t\t\tfor _, command := range fx.runner.subcommands() {\n73|\t\t\t\tif command == \"kill-session\" {\n74|\t\t\t\t\tt.Fatalf(\"kill-session issued after %s went stale during the poll: err=%v mutation=%+v\", fact, err, outcome.Mutation)\n75|\t\t\t\t}\n76|\t\t\t}\n77|\t\t\tswitch fact {\n78|\t\t\tcase \"generation\":\n79|\t\t\t\trequireEngineCode(t, err, \"terminal_backend_stale_generation\")\n80|\t\t\tcase \"authorization\":\n81|\t\t\t\trequireEngineCode(t, err, \"terminal_backend_unauthorized\")\n82|\t\t\tcase \"deadline\", \"deadline-instant\":\n83|\t\t\t\trequireEngineCode(t, err, \"stop_timeout\")\n84|\t\t\t}\n85|\t\t\tif outcome.Mutation == nil {\n86|\t\t\t\tt.Fatalf(\"refused stop omits its mutation: err=%v\", err)\n87|\t\t\t}\n88|\t\t\tif len(outcome.Mutation.Effects) != 1 || outcome.Mutation.Effects[0] != terminalbackend.EffectGracefulStopRequested {\n89|\t\t\t\tt.Fatalf(\"effects = %v, want exactly the graceful request\", outcome.Mutation.Effects)\n90|\t\t\t}\n91|\t\t\tif outcome.Mutation.After != terminalbackend.StateUnavailable {\n92|\t\t\t\tt.Fatalf(\"after = %s, want unavailable\", outcome.Mutation.After)\n93|\t\t\t}\n94|\t\t})\n95|\t}\n96|}\n97|\n98|// TestExecuteStopEscalatesAfterGracefulTimeoutAlone is the control\n99|// for the escalation revalidation: the graceful wait expiring with\n100|// every other fact still valid escalates exactly once and closes.\n101|// A graceful timeout escalates; only the other facts gate it.\n102|func TestExecuteStopEscalatesAfterGracefulTimeoutAlone(t *testing.T) {\n103|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n104|\tfx.runner.queue(\"send-keys\", \"\", 0).queue(\"has-session\", \"\", 0).\n105|\t\tqueue(\"kill-session\", \"\", 0).\n106|\t\tqueueFull(\"has-session\", \"\", \"can't find session: \"+lxInstance, 1)\n107|\tseen := false\n108|\tfx.runner.onRun = func(argv []string) {\n109|\t\tif len(argv) >= 4 && argv[3] == \"has-session\" && !seen {\n110|\t\t\tseen = true\n111|\t\t\tfx.clock.Sleep(10 * time.Millisecond)\n112|\t\t}\n113|\t}\n114|\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n115|\t\tOperation: \"request-stop\", Body: lxStopBody(t, 5, nil), Source: \"quiescing\", Admitted: fullLifecycleAdmitted(),\n116|\t})\n117|\tif err != nil {\n118|\t\tt.Fatal(err)\n119|\t}\n120|\tif got := fx.runner.subcommands(); len(got) != 4 || got[0] != \"send-keys\" || got[1] != \"has-session\" || got[2] != \"kill-session\" || got[3] != \"has-session\" {\n121|\t\tt.Fatalf(\"calls = %v, want the graceful poll, one escalation, and the re-confirm\", got)\n122|\t}\n123|\tif outcome.Mutation.After != terminalbackend.StateStopped {\n124|\t\tt.Fatalf(\"after = %s\", outcome.Mutation.After)\n125|\t}\n126|}\n127|\n128|// TestExecuteQuiesceRefusesStaleFactsBetweenCommands pins the\n129|// within-effect revalidation on the quiesce path: the lock runs,\n130|// exactly one admission fact changes during its round trip, and\n131|// the detach must refuse without issuing. The lock/detach pair is\n132|// one effect with two destructive commands; the boundary between\n133|// them re-proves the facts the engine checked before the effect.\n134|func TestExecuteQuiesceRefusesStaleFactsBetweenCommands(t *testing.T) {\n135|\tfor _, fact := range []string{\"generation\", \"authorization\", \"deadline\"} {\n136|\t\tt.Run(fact, func(t *testing.T) {\n137|\t\t\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n138|\t\t\tgeneration := lxGeneration\n139|\t\t\tfx.lc.CurrentGeneration = func() string { return generation }\n140|\t\t\traw := lxQuiesceBody(t, func(object map[string]any) {\n141|\t\t\t\tif fact == \"authorization\" {\n142|\t\t\t\t\tobject[\"context\"].(map[string]any)[\"authorization\"].(map[string]any)[\"expires_at\"] = \"2026-09-01T13:00:00.000Z\"\n143|\t\t\t\t}\n144|\t\t\t})\n145|\t\t\t// The detach is queued so a regression fails on\n146|\t\t\t// the detach-absence assertion with the\n147|\t\t\t// forbidden command recorded.\n148|\t\t\tfx.runner.queue(\"lock-session\", \"\", 0).queue(\"detach-client\", \"\", 0)\n149|\t\t\tfx.runner.onRun = func(argv []string) {\n150|\t\t\t\tif len(argv) < 4 || argv[3] != \"lock-session\" {\n151|\t\t\t\t\treturn\n152|\t\t\t\t}\n153|\t\t\t\tswitch fact {\n154|\t\t\t\tcase \"generation\":\n155|\t\t\t\t\tgeneration = \"generation-two\"\n156|\t\t\t\tcase \"authorization\":\n157|\t\t\t\t\tfx.clock.Sleep(2 * time.Hour)\n158|\t\t\t\tcase \"deadline\":\n159|\t\t\t\t\tfx.clock.Sleep(7 * time.Hour)\n160|\t\t\t\t}\n161|\t\t\t}\n162|\t\t\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n163|\t\t\t\tOperation: \"quiesce-input\", Body: raw, Source: \"active\", Admitted: fullLifecycleAdmitted(),\n164|\t\t\t})\n165|\t\t\tfor _, command := range fx.runner.subcommands() {\n166|\t\t\t\tif command == \"detach-client\" {\n167|\t\t\t\t\tt.Fatalf(\"detach-client issued after %s went stale during the lock: err=%v mutation=%+v\", fact, err, outcome.Mutation)\n168|\t\t\t\t}\n169|\t\t\t}\n170|\t\t\tswitch fact {\n171|\t\t\tcase \"generation\":\n172|\t\t\t\trequireEngineCode(t, err, \"terminal_backend_stale_generation\")\n173|\t\t\tcase \"authorization\":\n174|\t\t\t\trequireEngineCode(t, err, \"terminal_backend_unauthorized\")\n175|\t\t\tcase \"deadline\":\n176|\t\t\t\trequireEngineCode(t, err, \"terminal_backend_timeout\")\n177|\t\t\t}\n178|\t\t\tif outcome.Mutation == nil {\n179|\t\t\t\tt.Fatalf(\"refused quiesce omits its mutation: err=%v\", err)\n180|\t\t\t}\n181|\t\t\tif len(outcome.Mutation.Effects) != 0 {\n182|\t\t\t\tt.Fatalf(\"effects = %v, want none performed\", outcome.Mutation.Effects)\n183|\t\t\t}\n184|\t\t})\n185|\t}\n186|}\n187|\n188|// TestBackendPostWaitBoundaryRefusesWithoutRecheck pins the\n189|// fail-closed wiring: a post-wait destructive boundary with no\n190|// configured revalidation refuses instead of running blind. The\n191|// production entries always configure it; this helper-level pin\n192|// documents the nil contract both guarded sites share.\n193|func TestBackendPostWaitBoundaryRefusesWithoutRecheck(t *testing.T) {\n194|\tt.Run(\"escalation\", func(t *testing.T) {\n195|\t\trunner := newFakeRunner().queue(\"has-session\", \"\", 0).queue(\"kill-session\", \"\", 0)\n196|\t\treqBackend := effectBackend(t, terminalbackend.OperationRequestStop, runner)\n197|\t\treqBackend.recheck = nil\n198|\t\treqBackend.deadline = lxNow().Add(-time.Minute)\n199|\t\t_, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectProcessClosed)\n200|\t\trequireEngineCode(t, err, \"terminal_backend_protocol_error\")\n201|\t\tfor _, command := range runner.subcommands() {\n202|\t\t\tif command == \"kill-session\" {\n203|\t\t\t\tt.Fatalf(\"kill-session issued with no revalidation configured\")\n204|\t\t\t}\n205|\t\t}\n206|\t})\n207|\tt.Run(\"detach\", func(t *testing.T) {\n208|\t\trunner := newFakeRunner().queue(\"lock-session\", \"\", 0).queue(\"detach-client\", \"\", 0)\n209|\t\treqBackend := effectBackend(t, terminalbackend.OperationQuiesceInput, runner)\n210|\t\treqBackend.recheck = nil\n211|\t\t_, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectInputClosed)\n212|\t\trequireEngineCode(t, err, \"terminal_backend_protocol_error\")\n213|\t\tfor _, command := range runner.subcommands() {\n214|\t\t\tif command == \"detach-client\" {\n215|\t\t\t\tt.Fatalf(\"detach-client issued with no revalidation configured\")\n216|\t\t\t}\n217|\t\t}\n218|\t})\n219|}\n220|\n221|// TestEffectBoundaryAuditCreateIssuesSingleCommand probes the\n222|// create path for a post-wait destructive interval: the generation\n223|// rotates during the wrapper's only command round trip, and the\n224|// path must still succeed with exactly that one command. The\n225|// script holds no second command, so any future post-wait command\n226|// fails the unscripted call and reddens this probe.\n227|func TestEffectBoundaryAuditCreateIssuesSingleCommand(t *testing.T) {\n228|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n229|\tgeneration := lxGeneration\n230|\tfx.lc.CurrentGeneration = func() string { return generation }\n231|\tfx.runner.queue(\"new-session\", \"\", 0)\n232|\tfx.runner.onRun = func(argv []string) {\n233|\t\tif len(argv) >= 4 && argv[3] == \"new-session\" {\n234|\t\t\tgeneration = \"generation-two\"\n235|\t\t}\n236|\t}\n237|\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n238|\t\tOperation: \"create\", Body: lxCreateBody(t, nil), Source: \"absent\", Admitted: fullLifecycleAdmitted(),\n239|\t})\n240|\tif err != nil {\n241|\t\tt.Fatal(err)\n242|\t}\n243|\tif got := fx.runner.subcommands(); len(got) != 1 || got[0] != \"new-session\" {\n244|\t\tt.Fatalf(\"calls = %v, want exactly the one wrapper command\", got)\n245|\t}\n246|\tif outcome.Mutation.After != terminalbackend.StateActive {\n247|\t\tt.Fatalf(\"after = %s\", outcome.Mutation.After)\n248|\t}\n249|}\n250|\n251|// TestEffectBoundaryAuditRestoreIssuesSingleCommand probes the\n252|// restore path the same way: a rotation during its only command\n253|// round trip changes nothing further, because nothing further\n254|// runs. Any future post-wait command reddens the unscripted call.\n255|func TestEffectBoundaryAuditRestoreIssuesSingleCommand(t *testing.T) {\n256|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n257|\trecordBinding(t, fx, lxDigestA)\n258|\tgeneration := lxGeneration\n259|\tfx.lc.CurrentGeneration = func() string { return generation }\n260|\tfx.runner.queue(\"new-session\", \"\", 0)\n261|\tfx.runner.onRun = func(argv []string) {\n262|\t\tif len(argv) >= 4 && argv[3] == \"new-session\" {\n263|\t\t\tgeneration = \"generation-two\"\n264|\t\t}\n265|\t}\n266|\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n267|\t\tOperation: \"restore\", Body: lxRestoreBody(t, lxDigestA, nil), Source: \"absent\", Admitted: fullLifecycleAdmitted(),\n268|\t})\n269|\tif err != nil {\n270|\t\tt.Fatal(err)\n271|\t}\n272|\tif got := fx.runner.subcommands(); len(got) != 1 || got[0] != \"new-session\" {\n273|\t\tt.Fatalf(\"calls = %v, want exactly the one wrapper command\", got)\n274|\t}\n275|\tif outcome.Mutation.After != terminalbackend.StateParked {\n276|\t\tt.Fatalf(\"after = %s\", outcome.Mutation.After)\n277|\t}\n278|}\n279|\n280|// TestEffectBoundaryAuditTerminateIssuesNoPostWaitCommand probes\n281|// the terminate-stale tail: the kill runs first (the loop\n282|// rechecked before the effect), then the generation rotates\n283|// during the re-confirm poll. No destructive command follows\n284|// that wait — the tail only refuses — so the kill count must stay\n285|// exactly one however the facts moved.\n286|func TestEffectBoundaryAuditTerminateIssuesNoPostWaitCommand(t *testing.T) {\n287|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n288|\tgeneration := lxGeneration\n289|\tfx.lc.CurrentGeneration = func() string { return generation }\n290|\tfx.runner.queue(\"kill-session\", \"\", 0).queue(\"has-session\", \"\", 0)\n291|\tseen := false\n292|\tfx.runner.onRun = func(argv []string) {\n293|\t\tif len(argv) >= 4 && argv[3] == \"has-session\" && !seen {\n294|\t\t\tseen = true\n295|\t\t\tgeneration = \"generation-two\"\n296|\t\t\tfx.clock.Sleep(7 * time.Hour)\n297|\t\t}\n298|\t}\n299|\tpresented, winner := terminateFencing()\n300|\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n301|\t\tOperation: \"terminate-stale\", Body: lxTerminateBody(t, nil), Source: \"stale_fenced\",\n302|\t\tAdmitted: fullLifecycleAdmitted(), Presented: presented, Winner: winner,\n303|\t\tHasWinner: true, ForceRecovery: true, DiagnosticsPreserved: true,\n304|\t})\n305|\trequireLocalCode(t, err, \"terminal_backend_process_failed\", \"backend effect refused\")\n306|\tif outcome.Mutation == nil {\n307|\t\tt.Fatalf(\"refused terminate omits its mutation\")\n308|\t}\n309|\tkills := 0\n310|\tfor _, command := range fx.runner.subcommands() {\n311|\t\tif command == \"kill-session\" {\n312|\t\t\tkills++\n313|\t\t}\n314|\t}\n315|\tif kills != 1 {\n316|\t\tt.Fatalf(\"kill-session issued %d times, want exactly the pre-wait one: %v\", kills, fx.runner.subcommands())\n317|\t}\n318|\tif got := fx.runner.subcommands(); len(got) != 2 || got[0] != \"kill-session\" || got[1] != \"has-session\" {\n319|\t\tt.Fatalf(\"calls = %v, want the kill plus the one re-confirm probe\", got)\n320|\t}\n321|}\n322|\n323|// TestEffectBoundaryAuditBoundaryTailIsReadOnly probes the\n324|// safe-boundary tail: a rotation during the wrapper-signal wait\n325|// must not route to any destructive command — the only\n326|// post-signal command is the read-only provider-rows probe, and\n327|// the observed proof still commits.\n328|func TestEffectBoundaryAuditBoundaryTailIsReadOnly(t *testing.T) {\n329|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n330|\tgeneration := lxGeneration\n331|\tfx.lc.CurrentGeneration = func() string { return generation }\n332|\tfx.runner.queue(\"wait-for\", \"\", 0).queue(\"list-panes\", \"sh\\n\", 0)\n333|\tfx.runner.onRun = func(argv []string) {\n334|\t\tif len(argv) >= 4 && argv[3] == \"wait-for\" {\n335|\t\t\tgeneration = \"generation-two\"\n336|\t\t}\n337|\t}\n338|\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n339|\t\tOperation: \"wait-safe-boundary\", Body: lxBoundaryBody(t, \"provider_quiescence\", 60000, nil),\n340|\t\tSource: \"quiescing\", Admitted: fullLifecycleAdmitted(),\n341|\t})\n342|\tif err != nil {\n343|\t\tt.Fatal(err)\n344|\t}\n345|\tif got := fx.runner.subcommands(); len(got) != 2 || got[0] != \"wait-for\" || got[1] != \"list-panes\" {\n346|\t\tt.Fatalf(\"calls = %v, want the signal wait plus the read-only rows probe\", got)\n347|\t}\n348|\tif outcome.Mutation.After != terminalbackend.StateQuiescing {\n349|\t\tt.Fatalf(\"after = %s\", outcome.Mutation.After)\n350|\t}\n351|}\n352|\n353|// TestAttachWaitBoundedByOperationDeadline pins the waiting half of\n354|// \"a deadline cancels waiting, not a committed effect\": with a\n355|// 200ms operation deadline and an hour-long authorization, a\n356|// blocked server admission or a held barrier lock must refuse the\n357|// timeout at the deadline — not when the waiter is released a\n358|// second later — and the late release must commit nothing. The\n359|// admission fake is deliberately non-cooperative (it ignores\n360|// cancellation and blocks on the test's release channel), so the\n361|// test proves the entry bounds the wait itself rather than relying\n362|// on adapter cooperation. The release instant, not scheduler\n363|// latency, decides the verdict.\n364|func TestAttachWaitBoundedByOperationDeadline(t *testing.T) {\n365|\tfor _, where := range []string{\"admission\", \"barrier\"} {\n366|\t\tt.Run(where, func(t *testing.T) {\n367|\t\t\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n368|\t\t\tfx.lc.Now = time.Now\n369|\t\t\tnow := time.Now().UTC()\n370|\t\t\tdeadline := now.Add(200 * time.Millisecond)\n371|\t\t\tbody := lxAttachBody(t, func(object map[string]any) {\n372|\t\t\t\tobject[\"deadline_at\"] = formatTimestamp(deadline)\n373|\t\t\t\tauth := lxAttachAuth(\"local_only\", true)\n374|\t\t\t\tauth[\"issued_at\"] = formatTimestamp(now.Add(-time.Hour))\n375|\t\t\t\tauth[\"expires_at\"] = formatTimestamp(now.Add(time.Hour))\n376|\t\t\t\tobject[\"authorization\"] = auth\n377|\t\t\t})\n378|\t\t\tentered := make(chan struct{}, 1)\n379|\t\t\trelease := make(chan struct{})\n380|\t\t\tfinished := make(chan struct{})\n381|\t\t\tprevious := fx.lc.ServerAdmission\n382|\t\t\tfx.lc.ServerAdmission = func(ctx context.Context) (RealmAdmission, error) {\n383|\t\t\t\tentered <- struct{}{}\n384|\t\t\t\tif where == \"admission\" {\n385|\t\t\t\t\t<-release\n386|\t\t\t\t\tclose(finished)\n387|\t\t\t\t}\n388|\t\t\t\treturn previous(ctx)\n389|\t\t\t}\n390|\t\t\theld := false\n391|\t\t\tif where == \"barrier\" {\n392|\t\t\t\tfx.lc.barrierMu.Lock()\n393|\t\t\t\theld = true\n394|\t\t\t}\n395|\t\t\treleased := false\n396|\t\t\tcleanup := func() {\n397|\t\t\t\tif where == \"admission\" && !released {\n398|\t\t\t\t\treleased = true\n399|\t\t\t\t\tclose(release)\n400|\t\t\t\t}\n401|\t\t\t\tif held {\n402|\t\t\t\t\theld = false\n403|\t\t\t\t\tfx.lc.barrierMu.Unlock()\n404|\t\t\t\t}\n405|\t\t\t}\n406|\t\t\tdefer cleanup()\n407|\t\t\ttype attachResult struct {\n408|\t\t\t\toutcome OpOutcome\n409|\t\t\t\terr     error\n410|\t\t\t}\n411|\t\t\tdone := make(chan attachResult, 1)\n412|\t\t\tstart := time.Now()\n413|\t\t\tgo func() {\n414|\t\t\t\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n415|\t\t\t\t\tOperation: \"attach\", Body: body, Source: \"parked\", Admitted: fullLifecycleAdmitted(),\n416|\t\t\t\t})\n417|\t\t\t\tdone <- attachResult{outcome: outcome, err: err}\n418|\t\t\t}()\n419|\t\t\tselect {\n420|\t\t\tcase <-entered:\n421|\t\t\tcase res := <-done:\n422|\t\t\t\tt.Fatalf(\"attach returned before reaching the wait: %v\", res.err)\n423|\t\t\tcase <-time.After(10 * time.Second):\n424|\t\t\t\tt.Fatal(\"attach never reached the wait\")\n425|\t\t\t}\n426|\t\t\t// The release lands a second after the deadline:\n427|\t\t\t// a correct entry already refused by then, and\n428|\t\t\t// only a wait-ignoring entry is still blocked.\n429|\t\t\treleaseAt := time.NewTimer(time.Until(deadline) + time.Second)\n430|\t\t\tdefer releaseAt.Stop()\n431|\t\t\tvar res attachResult\n432|\t\t\treceived := false\n433|\t\t\telapsed := time.Since(start)\n434|\t\t\tselect {\n435|\t\t\tcase res = <-done:\n436|\t\t\t\treceived = true\n437|\t\t\t\telapsed = time.Since(start)\n438|\t\t\tcase <-releaseAt.C:\n439|\t\t\t}\n440|\t\t\tcleanup()\n441|\t\t\tif where == \"admission\" {\n442|\t\t\t\tselect {\n443|\t\t\t\tcase <-finished:\n444|\t\t\t\tcase <-time.After(10 * time.Second):\n445|\t\t\t\t\tt.Fatal(\"released admission never returned\")\n446|\t\t\t\t}\n447|\t\t\t}\n448|\t\t\tif !received {\n449|\t\t\t\tres = <-done\n450|\t\t\t\tt.Fatalf(\"attach %s wait ignored the 200ms deadline (blocked until the release): err=%v\", where, res.err)\n(more lines below)","final_result":true}}}
