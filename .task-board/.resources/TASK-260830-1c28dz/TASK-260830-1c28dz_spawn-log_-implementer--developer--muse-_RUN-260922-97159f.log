": \\\"OPERATION(ARGUMENTS) { PROJECTION }; the projection block is optional\\\",\\n  \\\"batch\\\": \\\"STATEMENT; STATEMENT \\\\u2014 statements separated by ';', results keep source order\\\",\\n  \\\"arguments\\\": \\\"comma-separated arguments: the first bare positional value is the element/identifier argument; remaining arguments use key=value; no operators or lists (not key in [a,b], not key!=value)\\\",\\n  \\\"values\\\": \\\"a bare identifier (letters, digits, '_', '-', '.', '/'), an int, a bool (true|false), or a \\\\\\\"double-quoted string\\\\\\\"; quote any value containing spaces, commas or parentheses\\\",\\n  \\\"escapes\\\": [\\n   \\\"\\\\\\\\\\\\\\\"\\\",\\n   \\\"\\\\\\\\\\\\\\\\\\\",\\n   \\\"\\\\\\\\n\\\",\\n   \\\"\\\\\\\\t\\\"\\n  ],\\n  \\\"projection\\\": \\\"field projection: { field preset ... } \\\\u2014 space-separated field names and preset names inside braces; omitted means the default fields\\\",\\n  \\\"tokens\\\": [\\n   \\\"identifier\\\",\\n   \\\"string\\\",\\n   \\\"'('\\\",\\n   \\\"')'\\\",\\n   \\\"'{'\\\",\\n   \\\"'}'\\\",\\n   \\\"'='\\\",\\n   \\\"','\\\",\\n   \\\"';'\\\",\\n   \\\"end of input\\\"\\n  ],\\n  \\\"examples\\\": [\\n   \\\"op()\\\",\\n   \\\"op(key=value)\\\",\\n   \\\"op(key=value, other=42, flag=true)\\\",\\n   \\\"op(key=\\\\\\\"quoted value with \\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\\ \\\\\\\\n \\\\\\\\t\\\\\\\")\\\",\\n   \\\"op(positional)\\\",\\n   \\\"op() { field preset }\\\",\\n   \\\"op(key=value) { field }; other()\\\"\\n  ]\\n },\\n \\\"mutationMetadata\\\": {\\n  \\\"accept_cr\\\": {\\n   \\\"description\\\": \\\"Record an evidence-backed reviewer acceptance and route the element to integrating\\\",\\n   \\\"parameters\\\": [\\n    {\\n     \\\"name\\\": \\\"id\\\",\\n     \\\"type\\\": \\\"string\\\",\\n     \\\"optional\\\": false,\\n     \\\"description\\\": \\\"Element ID carrying the Change Request\\\",\\n     \\\"required\\\": true\\n    },\\n    {\\n     \\\"name\\\": \\\"revision\\\",\\n 