{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d033","stream":{"kind":"session","id":"01a0c9a4-cdaf-7691-9123-20534004d71c"},"sequence":1652,"recorded_at":1780531400003299,"record_type":"event","durability":"durable","causation_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","run_stream":{"kind":"run","id":"7d4d0da9-54d0-407b-9491-ce60f372e27f"},"task_stream":{"kind":"task","id":"01a0c9b6-03d6-75d0-aad1-3076f6a88ea5"},"task_id":"01a0c9b6-03d6-75d0-aad1-3076f6a88ea5","event":{"kind":"output","task_id":"01a0c9b6-03d6-75d0-aad1-3076f6a88ea5","chunk":"edited\nchanged lines: lines 2992-2994\n--- original\n+++ updated\n@@\n-    Mutant(\n-        name=\"C-control\",\n-        path=f\"{PACKAGE}/errors.go\",\n+    Mutant(\n+        name=\"N-attach-peers-dir-skip\",\n+        path=\"internal/termbind/overlap.go\",\n+        find='\\t\\tif entry.IsDir() {\\n\\t\\t\\treturn nil, fmt.Errorf(\"attach peer %q is not a receipt file\", name)\\n\\t\\t}\\n',\n+        replace='\\t\\tif entry.IsDir() {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n',\n+        count=1,\n+        run=\"TestAttachPeerDirectoryFailsClosed\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly receipt-namespace directories past the census shape arm as skips (a directory at a receipt name reads as no peer); undecodable files and foreign receipts still error, staging and non-receipt entries still skip. Kill path: the second attach succeeds past the directory, so the receipt-dir subtest reddens while the still-skipped leg stays green.\",\n+    ),\n+    Mutant(\n+        name=\"N-attach-overlap-replay-unproven\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\\t_, found, err := lc.Attach.Lookup(body.SessionID, body.TerminalInstanceID, body.ClientID)\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif found {\\n\\t\\treturn nil\\n\\t}\\n',\n+        replace='\\t_, found, err := lc.Attach.Lookup(body.SessionID, body.TerminalInstanceID, body.ClientID)\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif found || body.ClientID == \"0198f4c8-8e50-7f66-8f70-555555555552\" {\\n\\t\\treturn nil\\n\\t}\\n',\n+        count=1,\n+        run=\"TestAttachOverlapRequiresMultiAttach\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the receiptless fixture client B past the replay exemption without a recorded receipt (the exemption keys on the bare client ID for one literal member); every other receiptless client still reaches the capability arms, and census failures still error. Kill path: the second attach succeeds without multi_attach, so the test fails at the second refusal assertion.\",\n+    ),\n+    Mutant(\n+        name=\"N-probe-deadline\",\n+        path=f\"{PACKAGE}/backend.go\",\n+        find='\\treturn context.WithTimeout(ctx, deadline.Sub(now()))\\n',\n+        replace='\\treturn context.WithTimeout(ctx, deadline.Sub(now())+time.Hour)\\n',\n+        count=1,\n+        run=\"(TestExecuteStopPollHonorsOperationDeadline|TestExecuteTerminateConfirmHonorsOperationDeadline|TestExecuteStatusProbeHonorsOperationDeadline)\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly probes blocked within the hour past the shared read-only probe bound (the stop poll, terminate confirm, and status probes each wait an hour long); answered probes still follow the clock and caller cancellation still cancels. One shared site, three entries: each deadline test reddens alone (isolated attribution from single-test runs), because each verdict lands at the release instead of the bound.\",\n+    ),\n+    Mutant(\n+        name=\"C-control\",\n+        path=f\"{PACKAGE}/errors.go\",\n","final_result":true}}}
