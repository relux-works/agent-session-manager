ds):\\n    rows = []\\n    for l in lines[h+2:]:\\n        if not l.startswith('| '): break\\n        rows.append(l)\\n    ncols = len(rows[0].split('|')) - 2 if rows else 0\\n    m=b=u=q=0; bad=[]\\n    for r in rows:\\n        cells = [c for c in r.split('|')[2:]]  # skip empty + gate name\\n        if len(cells) != ncols-1: bad.append((r[:60], len(cells), ncols-1))\\n        for c in cells:\\n            k = classify(c)\\n            if k=='M': m+=1\\n            elif k=='B': b+=1\\n            elif k=='U': u+=1\\n            else: q+=1\\n    tag = \\\"ABC\\\"[idx] if idx < 3 else f\\\"T{idx}\\\"\\n    print(f\\\"Table {tag}: rows={len(rows)} cols={ncols} cells={len(rows)*(ncols-1)} M={m} B={b} U={u} ?={q} ragged={len(bad)}\\\")\\n    for x in bad[:5]: print(\\\"  RAGGED:\\\", x)\\nEOF\\npython3 /tmp/c28dz/count_census.py internal/tmuxserver/TRACEABILITY.md\",\n  \"description\": \"Count census cells mechanically\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"header rows at: [302, 364, 418]\\nTable A: rows=24 cols=12 cells=264 M=50 B=0 U=210 ?=28 ragged=24\\n  RAGGED: ('| caller (acquire.go:149) | M TestAcquireRefusesUnknownCalle', 12, 11)\\n  RAGGED: ('| details (acquire.go:152) | M TestAcquireRefusesMissingReal', 12, 11)\\n  RAGGED: ('| render (acquire.go:289) | U2 foreground never renders the ', 12, 11)\\n  RAGGED: ('| dispatch (acquire.go:163) | M TestAcquireForegroundSpawnsD', 12, 11)\\n  RAGGED: ('| plat (runtime.go:76) | M TestAcquireRefusesUnknownPlatform', 12, 11)\\nTable B: rows=24 cols=22 cells=504 M=10 B=0 U=494 ?=24 ragged=24\\n  RAGGED: ('| caller (acquire.go:149) | U2a | U2a | U2a | U2a | U2a | U2', 22, 21)\\n  RAGGED: ('| details (acquire.go:152) | U2a | U2a | U2a | U2a | U2a | U', 22, 21)\\n  RAGGED: ('| render (acquire.go:289) | U2a | U2a | U2a | U2a | U2a | U2', 22, 21)\\n  RAGGED: ('| dispatch (acquire.go:163) | U2a | U2a | U2a | U2a | U2a | ', 22, 21)\\n  RAGGED: ('| plat (runtime.go:76) | U2a | U2a | U2a | U2