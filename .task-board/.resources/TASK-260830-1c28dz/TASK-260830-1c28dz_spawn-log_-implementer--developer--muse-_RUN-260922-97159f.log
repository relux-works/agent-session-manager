{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9a7","stream":{"kind":"session","id":"01a0c9a4-cdaf-7691-9123-20534004d71c"},"sequence":814,"recorded_at":1780531400001623,"record_type":"event","durability":"durable","causation_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","run_stream":{"kind":"run","id":"7d4d0da9-54d0-407b-9491-ce60f372e27f"},"call_id":"call_01a0c9aaf451721e945219a03281b783","text":"Read text file `internal/tmuxserver/lifecycle_rev8_unix_test.go`.\n(449 line(s) above)\n450|\t\t\t\tt.Fatalf(\"attach %s wait ignored the 200ms deadline (blocked until the release): err=%v\", where, res.err)\n451|\t\t\t}\n452|\t\t\trequireLocalCode(t, res.err, \"terminal_backend_timeout\", \"operation deadline\")\n453|\t\t\tif elapsed >= time.Second {\n454|\t\t\t\tt.Fatalf(\"attach refused only after %v, want the deadline refusal before the release\", elapsed)\n455|\t\t\t}\n456|\t\t\tif len(res.outcome.Argv) != 0 {\n457|\t\t\t\tt.Fatalf(\"refused attach built argv %q\", res.outcome.Argv)\n458|\t\t\t}\n459|\t\t\t// No late receipt: the release and a settle\n460|\t\t\t// window must leave the store empty — nothing\n461|\t\t\t// commits after the caller timed out.\n462|\t\t\ttime.Sleep(100 * time.Millisecond)\n463|\t\t\tif _, found, err := fx.lc.Attach.Lookup(lxSession, lxInstance, lxClient); err != nil || found {\n464|\t\t\t\tt.Fatalf(\"lookup = %v, %v; want no late receipt after the release\", found, err)\n465|\t\t\t}\n466|\t\t\tt.Logf(\"%s wait refused at the deadline after %v\", where, elapsed)\n467|\t\t})\n468|\t}\n469|}\n470|\n471|// TestQuiesceBarrierWaitBoundedByOperationDeadline pins the uniform\n472|// barrier contract on the quiesce span: with a 200ms operation\n473|// deadline, a quiesce blocked on a held barrier refuses the\n474|// timeout at the deadline — before any engine effect runs — not\n475|// when the holder releases a second later.\n476|func TestQuiesceBarrierWaitBoundedByOperationDeadline(t *testing.T) {\n477|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n478|\tfx.lc.Now = time.Now\n479|\tnow := time.Now().UTC()\n480|\tdeadline := now.Add(200 * time.Millisecond)\n481|\tauth := map[string]any{\n482|\t\t\"lease_id\":                  lxLease,\n483|\t\t\"lease_epoch\":               float64(7),\n484|\t\t\"holder_host_id\":            lxHost,\n485|\t\t\"authorization_kind\":        \"control\",\n486|\t\t\"issued_at\":                 formatTimestamp(now.Add(-time.Hour)),\n487|\t\t\"expires_at\":                formatTimestamp(now.Add(time.Hour)),\n488|\t\t\"authorization_evidence_id\": lxDigestA,\n489|\t}\n490|\traw := lxQuiesceBody(t, func(object map[string]any) {\n491|\t\tcontext := object[\"context\"].(map[string]any)\n492|\t\tcontext[\"deadline_at\"] = formatTimestamp(deadline)\n493|\t\tcontext[\"authorization\"] = auth\n494|\t})\n495|\tfx.lc.barrierMu.Lock()\n496|\theld := true\n497|\tdefer func() {\n498|\t\tif held {\n499|\t\t\tfx.lc.barrierMu.Unlock()\n500|\t\t}\n501|\t}()\n502|\t// Queued for the regression shape only: a wait-ignoring\n503|\t// entry proceeds after the release and succeeds, which the\n504|\t// timeout assertion below reddens.\n505|\tfx.runner.queue(\"lock-session\", \"\", 0).queue(\"detach-client\", \"\", 0)\n506|\ttype quiesceResult struct {\n507|\t\toutcome OpOutcome\n508|\t\terr     error\n509|\t}\n510|\tdone := make(chan quiesceResult, 1)\n511|\tstart := time.Now()\n512|\tgo func() {\n513|\t\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n514|\t\t\tOperation: \"quiesce-input\", Body: raw, Source: \"active\", Admitted: fullLifecycleAdmitted(),\n515|\t\t})\n516|\t\tdone <- quiesceResult{outcome: outcome, err: err}\n517|\t}()\n518|\t// The release lands a second after the deadline: a correct\n519|\t// entry already refused by then, and only a wait-ignoring\n520|\t// entry is still blocked.\n521|\treleaseAt := time.NewTimer(time.Until(deadline) + time.Second)\n522|\tdefer releaseAt.Stop()\n523|\tvar res quiesceResult\n524|\treceived := false\n525|\tselect {\n526|\tcase res = <-done:\n527|\t\treceived = true\n528|\tcase <-releaseAt.C:\n529|\t}\n530|\theld = false\n531|\tfx.lc.barrierMu.Unlock()\n532|\tif !received {\n533|\t\tres = <-done\n534|\t\tt.Fatalf(\"quiesce barrier wait ignored the 200ms deadline (blocked until the release): err=%v\", res.err)\n535|\t}\n536|\trequireLocalCode(t, res.err, \"terminal_backend_timeout\", \"operation deadline\")\n537|\tif res.outcome.Mutation != nil {\n538|\t\tt.Fatalf(\"mutation = %+v, want no result before the refused wait\", res.outcome.Mutation)\n539|\t}\n540|\tif elapsed := time.Since(start); elapsed >= time.Second {\n541|\t\tt.Fatalf(\"quiesce refused only after %v, want the deadline refusal before the release\", elapsed)\n542|\t}\n543|\tif fx.runner.callCount() != 0 {\n544|\t\tt.Fatalf(\"refused quiesce execed %d commands\", fx.runner.callCount())\n545|\t}\n546|}\n547|\n548|// TestBoundaryCommitWaitBoundedByOperationDeadline pins the uniform\n549|// barrier contract on the boundary report commit: the wrapper\n550|// signal commits outside the lock, the operation deadline passes\n551|// during the wait, and the held barrier then refuses the row\n552|// timeout against the already-committed proof — the success\n553|// mutation stands, only the report is unrecorded.\n554|func TestBoundaryCommitWaitBoundedByOperationDeadline(t *testing.T) {\n555|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n556|\tfx.runner.queue(\"wait-for\", \"\", 0).queue(\"list-panes\", \"sh\\n\", 0)\n557|\tfx.runner.onRun = func(argv []string) {\n558|\t\tif len(argv) >= 4 && argv[3] == \"wait-for\" {\n559|\t\t\tfx.clock.Sleep(7 * time.Hour)\n560|\t\t}\n561|\t}\n562|\tfx.lc.barrierMu.Lock()\n563|\theld := true\n564|\tdefer func() {\n565|\t\tif held {\n566|\t\t\tfx.lc.barrierMu.Unlock()\n567|\t\t}\n568|\t}()\n569|\ttype boundaryResult struct {\n570|\t\toutcome OpOutcome\n571|\t\terr     error\n572|\t}\n573|\tdone := make(chan boundaryResult, 1)\n574|\tgo func() {\n575|\t\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n576|\t\t\tOperation: \"wait-safe-boundary\", Body: lxBoundaryBody(t, \"provider_quiescence\", 60000, nil),\n577|\t\t\tSource: \"quiescing\", Admitted: fullLifecycleAdmitted(),\n578|\t\t})\n579|\t\tdone <- boundaryResult{outcome: outcome, err: err}\n580|\t}()\n581|\tvar res boundaryResult\n582|\tselect {\n583|\tcase res = <-done:\n584|\tcase <-time.After(10 * time.Second):\n585|\t\tt.Fatal(\"boundary report commit blocked on the held barrier past its expired deadline\")\n586|\t}\n587|\theld = false\n588|\tfx.lc.barrierMu.Unlock()\n589|\trequireLocalCode(t, res.err, \"quiesce_timeout\", \"operation deadline\")\n590|\tif res.outcome.Mutation == nil || res.outcome.Mutation.After != terminalbackend.StateQuiescing {\n591|\t\tt.Fatalf(\"mutation = %+v, want the committed proof\", res.outcome.Mutation)\n592|\t}\n593|\tif res.outcome.BoundaryObservedAt != \"\" {\n594|\t\tt.Fatalf(\"observed_at = %q, want no unrecorded report\", res.outcome.BoundaryObservedAt)\n595|\t}\n596|}\n597|\n598|// TestAttachWaitCancelledReturnsPromptly pins the cancellation half\n599|// of the barrier contract: an expired and context-cancelled attach\n600|// waiting on a held barrier returns without any external unlock.\n601|// The holder releases only after the verdict, for goroutine\n602|// cleanup.\n603|func TestAttachWaitCancelledReturnsPromptly(t *testing.T) {\n604|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n605|\tarrived := make(chan struct{}, 1)\n606|\tprevious := fx.lc.ServerAdmission\n607|\tfx.lc.ServerAdmission = func(ctx context.Context) (RealmAdmission, error) {\n608|\t\tadmission, err := previous(ctx)\n609|\t\tarrived <- struct{}{}\n610|\t\treturn admission, err\n611|\t}\n612|\tfx.lc.barrierMu.Lock()\n613|\tdefer fx.lc.barrierMu.Unlock()\n614|\tdone := make(chan error, 1)\n615|\tbody := lxAttachBody(t, nil)\n616|\tctx, cancel := context.WithCancel(context.Background())\n617|\tdefer cancel()\n618|\tgo func() {\n619|\t\t_, err := fx.lc.Execute(ctx, OpRequest{\n620|\t\t\tOperation: \"attach\", Body: body, Source: \"parked\", Admitted: fullLifecycleAdmitted(),\n621|\t\t})\n622|\t\tdone <- err\n623|\t}()\n624|\tselect {\n625|\tcase <-arrived:\n626|\tcase <-time.After(10 * time.Second):\n627|\t\tt.Fatal(\"attach never reached server admission\")\n628|\t}\n629|\tfx.clock.Sleep(7 * time.Hour)\n630|\tcancel()\n631|\tselect {\n632|\tcase err := <-done:\n633|\t\trequireLocalCode(t, err, \"terminal_backend_timeout\", \"operation deadline\")\n634|\t\tif _, found, err := fx.lc.Attach.Lookup(lxSession, lxInstance, lxClient); err != nil || found {\n635|\t\t\tt.Fatalf(\"lookup = %v, %v; want no receipt\", found, err)\n636|\t\t}\n637|\tcase <-time.After(5 * time.Second):\n638|\t\tt.Fatal(\"expired and cancelled attach stayed blocked on the held barrier\")\n639|\t}\n640|}\n641|\n642|// TestQuiesceMalformedDeadlineRefusesBeforeBarrierWait probes the\n643|// unparseable-deadline corner of the uniform barrier contract: the\n644|// operation body parse refuses before any wait runs, so even a\n645|// held barrier cannot hang the path. The holder releases only\n646|// after the prompt verdict.\n647|func TestQuiesceMalformedDeadlineRefusesBeforeBarrierWait(t *testing.T) {\n648|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n649|\tfx.lc.barrierMu.Lock()\n650|\tdefer fx.lc.barrierMu.Unlock()\n651|\traw := lxQuiesceBody(t, func(object map[string]any) {\n652|\t\tobject[\"context\"].(map[string]any)[\"deadline_at\"] = \"not-a-timestamp\"\n653|\t})\n654|\tdone := make(chan error, 1)\n655|\tgo func() {\n656|\t\t_, err := fx.lc.Execute(context.Background(), OpRequest{\n657|\t\t\tOperation: \"quiesce-input\", Body: raw, Source: \"active\", Admitted: fullLifecycleAdmitted(),\n658|\t\t})\n659|\t\tdone <- err\n660|\t}()\n661|\tselect {\n662|\tcase err := <-done:\n663|\t\trequireEngineCode(t, err, \"terminal_backend_protocol_error\")\n664|\t\tif fx.runner.callCount() != 0 {\n665|\t\t\tt.Fatalf(\"refused quiesce execed %d commands\", fx.runner.callCount())\n666|\t\t}\n667|\tcase <-time.After(5 * time.Second):\n668|\t\tt.Fatal(\"malformed-deadline quiesce blocked on the held barrier\")\n669|\t}\n670|}\n671|\n672|// withoutCapability returns the full lifecycle set minus one\n673|// capability.\n674|func withoutCapability(drop string) terminalbackend.Admitted {\n675|\tkept := []string(nil)\n676|\tfor _, capability := range fullLifecycleAdmitted().Capabilities {\n677|\t\tif capability != drop {\n678|\t\t\tkept = append(kept, capability)\n679|\t\t}\n680|\t}\n681|\treturn terminalbackend.Admitted{Capabilities: kept}\n682|}\n683|\n684|// TestAttachOverlapRequiresMultiAttach pins the overlap\n685|// fail-closed gate: the first client attaches without multi_attach\n686|// (no peer exists yet), but the second client — which may overlap\n687|// the recorded first — refuses without it and commits no receipt.\n688|// With the capability the second client attaches; a third client\n689|// without it refuses too, proving the gate counts past the first\n690|// peer.\n691|func TestAttachOverlapRequiresMultiAttach(t *testing.T) {\n692|\tadmitted := withoutCapability(\"multi_attach\")\n693|\tfx := newLifecycleFixture(t, admitted)\n694|\tfirst := lxAttachBody(t, func(object map[string]any) {\n695|\t\tobject[\"input_authorized\"] = false\n696|\t\tobject[\"authorization\"] = lxAttachAuth(\"local_only\", false)\n697|\t})\n698|\tif _, err := fx.lc.Execute(context.Background(), OpRequest{\n699|\t\tOperation: \"attach\", Body: first, Source: \"parked\", Admitted: admitted,\n700|\t}); err != nil {\n701|\t\tt.Fatalf(\"first attach refused without peers: %v\", err)\n702|\t}\n703|\tsecond := lxAttachBody(t, func(object map[string]any) {\n704|\t\tobject[\"client_id\"] = lxClientB\n705|\t\tobject[\"input_authorized\"] = false\n706|\t\tobject[\"authorization\"] = lxAttachAuth(\"local_only\", false)\n707|\t})\n708|\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n709|\t\tOperation: \"attach\", Body: second, Source: \"active\", Admitted: admitted,\n710|\t})\n711|\trequireLocalCode(t, err, \"terminal_backend_capability_unproven\", \"operation capability conditional\")\n712|\tif _, found, err := fx.lc.Attach.Lookup(lxSession, lxInstance, lxClientB); err != nil || found {\n713|\t\tt.Fatalf(\"lookup = %v, %v; want no overlapping receipt\", found, err)\n714|\t}\n715|\tif len(outcome.Argv) != 0 {\n716|\t\tt.Fatalf(\"refused attach built argv %q\", outcome.Argv)\n717|\t}\n718|\tif _, err := fx.lc.Execute(context.Background(), OpRequest{\n719|\t\tOperation: \"attach\", Body: second, Source: \"active\", Admitted: fullLifecycleAdmitted(),\n720|\t}); err != nil {\n721|\t\tt.Fatalf(\"second attach refused with multi_attach: %v\", err)\n722|\t}\n723|\tthird := lxAttachBody(t, func(object map[string]any) {\n724|\t\tobject[\"client_id\"] = \"0198f4c8-8e50-7f66-8f70-555555555553\"\n725|\t\tobject[\"input_authorized\"] = false\n726|\t\tobject[\"authorization\"] = lxAttachAuth(\"local_only\", false)\n727|\t})\n728|\tif _, err := fx.lc.Execute(context.Background(), OpRequest{\n729|\t\tOperation: \"attach\", Body: third, Source: \"active\", Admitted: admitted,\n730|\t}); err == nil {\n731|\t\tt.Fatal(\"third attach admitted past two peers without multi_attach\")\n732|\t} else {\n733|\t\trequireLocalCode(t, err, \"terminal_backend_capability_unproven\", \"operation capability conditional\")\n734|\t}\n735|}\n736|\n737|// TestAttachOverlapInputRequiresMultipleInputClients pins the\n738|// concurrent-input arm: over a recorded input-authorized peer, a\n739|// new input-authorized attach refuses without\n740|// multiple_input_clients (even with multi_attach) and commits no\n741|// receipt or authorized input. A read-only second client stays\n742|// admitted — observation is not input — and the full set admits\n743|// the writable pair.\n744|func TestAttachOverlapInputRequiresMultipleInputClients(t *testing.T) {\n745|\tadmitted := withoutCapability(\"multiple_input_clients\")\n746|\tfx := newLifecycleFixture(t, admitted)\n747|\tif _, err := fx.lc.Execute(context.Background(), OpRequest{\n748|\t\tOperation: \"attach\", Body: lxAttachBody(t, nil), Source: \"parked\", Admitted: admitted,\n749|\t}); err != nil {\n750|\t\tt.Fatalf(\"first writable attach refused: %v\", err)\n751|\t}\n752|\tsecond := lxAttachBody(t, func(object map[string]any) {\n753|\t\tobject[\"client_id\"] = lxClientB\n754|\t})\n755|\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n756|\t\tOperation: \"attach\", Body: second, Source: \"active\", Admitted: admitted,\n757|\t})\n758|\trequireLocalCode(t, err, \"terminal_backend_capability_unproven\", \"operation capability conditional\")\n759|\tif _, found, err := fx.lc.Attach.Lookup(lxSession, lxInstance, lxClientB); err != nil || found {\n760|\t\tt.Fatalf(\"lookup = %v, %v; want no concurrent-input receipt\", found, err)\n761|\t}\n762|\tif outcome.Attach != nil && outcome.Attach.InputAuthorized {\n763|\t\tt.Fatalf(\"refused attach authorized input: %+v\", outcome.Attach)\n764|\t}\n765|\treadonly := lxAttachBody(t, func(object map[string]any) {\n766|\t\tobject[\"client_id\"] = lxClientB\n767|\t\tobject[\"input_authorized\"] = false\n768|\t\tobject[\"authorization\"] = lxAttachAuth(\"local_only\", false)\n769|\t})\n770|\tif _, err := fx.lc.Execute(context.Background(), OpRequest{\n771|\t\tOperation: \"attach\", Body: readonly, Source: \"active\", Admitted: admitted,\n772|\t}); err != nil {\n773|\t\tt.Fatalf(\"read-only second attach refused over an input peer: %v\", err)\n774|\t}\n775|\t// Precision: over two recorded peers the input arm still\n776|\t// refuses without the capability.\n777|\tthird := lxAttachBody(t, func(object map[string]any) {\n778|\t\tobject[\"client_id\"] = \"0198f4c8-8e50-7f66-8f70-555555555553\"\n779|\t})\n780|\tif _, err := fx.lc.Execute(context.Background(), OpRequest{\n781|\t\tOperation: \"attach\", Body: third, Source: \"active\", Admitted: admitted,\n782|\t}); err == nil {\n783|\t\tt.Fatal(\"third writable attach admitted past peers without multiple_input_clients\")\n784|\t} else {\n785|\t\trequireLocalCode(t, err, \"terminal_backend_capability_unproven\", \"operation capability conditional\")\n786|\t}\n787|\tfx2 := newLifecycleFixture(t, fullLifecycleAdmitted())\n788|\tif _, err := fx2.lc.Execute(context.Background(), OpRequest{\n789|\t\tOperation: \"attach\", Body: lxAttachBody(t, nil), Source: \"parked\", Admitted: fullLifecycleAdmitted(),\n790|\t}); err != nil {\n791|\t\tt.Fatal(err)\n792|\t}\n793|\tgranted, err := fx2.lc.Execute(context.Background(), OpRequest{\n794|\t\tOperation: \"attach\", Body: second, Source: \"active\", Admitted: fullLifecycleAdmitted(),\n795|\t})\n796|\tif err != nil {\n797|\t\tt.Fatalf(\"writable pair refused with multiple_input_clients: %v\", err)\n798|\t}\n799|\tif granted.Attach == nil || !granted.Attach.InputAuthorized {\n800|\t\tt.Fatalf(\"attach = %+v, want the authorized pair\", granted.Attach)\n801|\t}\n802|}\n803|\n804|// TestAttachSameClientRetryIgnoresOverlap pins the idempotent\n805|// replay: the same client re-attaching over its own recorded\n806|// receipt is not a new client, so the overlap capabilities are\n807|// not consulted and the retry succeeds on the transport\n808|// capability alone.\n809|func TestAttachSameClientRetryIgnoresOverlap(t *testing.T) {\n810|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n811|\tif _, err := fx.lc.Execute(context.Background(), OpRequest{\n812|\t\tOperation: \"attach\", Body: lxAttachBody(t, nil), Source: \"parked\", Admitted: fullLifecycleAdmitted(),\n813|\t}); err != nil {\n814|\t\tt.Fatal(err)\n815|\t}\n816|\treduced := admittedWith(\"local_attach\")\n817|\treplayed, err := fx.lc.Execute(context.Background(), OpRequest{\n818|\t\tOperation: \"attach\", Body: lxAttachBody(t, nil), Source: \"active\", Admitted: reduced,\n819|\t})\n820|\tif err != nil {\n821|\t\tt.Fatalf(\"same-client retry refused without overlap capabilities: %v\", err)\n822|\t}\n823|\tif replayed.Attach == nil || replayed.Attach.ClientMirrorID != lxClient || !replayed.Attach.InputAuthorized {\n824|\t\tt.Fatalf(\"attach = %+v, want the replayed writable receipt\", replayed.Attach)\n825|\t}\n826|}\n827|\n828|// TestAttachOverlapPeerReadFailureFailsClosed pins the census\n829|// health rule: a peer receipt that cannot be read is unknown, not\n830|// absence, so the overlapping attach errors instead of admitting\n831|// past the unreadable peer.\n832|func TestAttachOverlapPeerReadFailureFailsClosed(t *testing.T) {\n833|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n834|\tif _, err := fx.lc.Execute(context.Background(), OpRequest{\n835|\t\tOperation: \"attach\", Body: lxAttachBody(t, nil), Source: \"parked\", Admitted: fullLifecycleAdmitted(),\n836|\t}); err != nil {\n837|\t\tt.Fatal(err)\n838|\t}\n839|\tpeer := filepath.Join(fx.data, \"attachstore\", \"termbind\", \"attach\", lxInstance, lxClient+\".json\")\n840|\tif err := os.WriteFile(peer, []byte(\"corrupt\"), 0o600); err != nil {\n841|\t\tt.Fatal(err)\n842|\t}\n843|\tsecond := lxAttachBody(t, func(object map[string]any) {\n844|\t\tobject[\"client_id\"] = lxClientB\n845|\t})\n846|\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n847|\t\tOperation: \"attach\", Body: second, Source: \"active\", Admitted: fullLifecycleAdmitted(),\n848|\t})\n849|\tif err == nil {\n850|\t\tt.Fatalf(\"attach admitted past an unreadable peer: %+v\", outcome.Attach)\n851|\t}\n852|\tif _, found, err := fx.lc.Attach.Lookup(lxSession, lxInstance, lxClientB); err != nil || found {\n853|\t\tt.Fatalf(\"lookup = %v, %v; want no receipt past the unreadable peer\", found, err)\n854|\t}\n855|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
