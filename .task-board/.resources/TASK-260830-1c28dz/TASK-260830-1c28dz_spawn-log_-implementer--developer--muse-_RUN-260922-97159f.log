{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c93f","stream":{"kind":"session","id":"01a0c9a4-cdaf-7691-9123-20534004d71c"},"sequence":762,"recorded_at":1780531400001519,"record_type":"event","durability":"durable","causation_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","run_stream":{"kind":"run","id":"7d4d0da9-54d0-407b-9491-ce60f372e27f"},"task_stream":{"kind":"task","id":"01a0c9aa-787e-7a72-a48c-63e36eb82930"},"task_id":"01a0c9aa-787e-7a72-a48c-63e36eb82930","event":{"kind":"output","task_id":"01a0c9aa-787e-7a72-a48c-63e36eb82930","chunk":"Read text file `internal/tmuxserver/mutant_harness.py`.\n(2879 line(s) above)\n2880|        note=\"Admits exactly the EISDIR incarnation read past the absent arm as absence (reviewer R1 shape); every other read failure still errors. Kill path: the barrier scan passes over the directory and the attach succeeds.\",\n2881|    ),\n2882|    Mutant(\n2883|        name=\"N-outcomes-dir-read-absent\",\n2884|        path=f\"{PACKAGE}/state.go\",\n2885|        find='\\tentries, err := os.ReadDir(dir)\\n\\tif err != nil {\\n\\t\\tif errors.Is(err, os.ErrNotExist) {\\n\\t\\t\\treturn false, nil\\n',\n2886|        replace='\\tentries, err := os.ReadDir(dir)\\n\\tif err != nil {\\n\\t\\tif errors.Is(err, os.ErrNotExist) || strings.Contains(err.Error(), \"not a directory\") {\\n\\t\\t\\treturn false, nil\\n',\n2887|        count=1,\n2888|        run=\"TestExecuteAttachErrorsOnOutcomesDirReadFailure\",\n2889|        expect=\"KILLED\",\n2890|        note=\"Admits exactly the ENOTDIR outcomes-directory read past the absent arm as absence (reviewer R2 shape); every other read failure still errors. Kill path: the barrier scan passes over the file and the attach succeeds.\",\n2891|    ),\n2892|    Mutant(\n2893|        name=\"N-outcome-file-read-skip\",\n2894|        path=f\"{PACKAGE}/state.go\",\n2895|        find='\\t\\traw, err := os.ReadFile(filepath.Join(dir, entry.Name()))\\n\\t\\tif err != nil {\\n\\t\\t\\treturn false, fmt.Errorf(\"read tmux operation outcome: %w\", err)\\n\\t\\t}\\n',\n2896|        replace='\\t\\traw, err := os.ReadFile(filepath.Join(dir, entry.Name()))\\n\\t\\tif err != nil {\\n\\t\\t\\tif entry.Name() == \"deadbeef.json\" {\\n\\t\\t\\t\\tcontinue\\n\\t\\t\\t}\\n\\t\\t\\treturn false, fmt.Errorf(\"read tmux operation outcome: %w\", err)\\n\\t\\t}\\n',\n2897|        count=1,\n2898|        run=\"TestExecuteAttachErrorsOnOutcomeFileReadFailure\",\n2899|        expect=\"KILLED\",\n2900|        note=\"Admits exactly the deadbeef.json outcome read failure past the error arm as a skip (reviewer R3 shape); every other unreadable document still errors. Kill path: the barrier scan skips the symlink and the attach succeeds.\",\n2901|    ),\n2902|    Mutant(\n2903|        name=\"N-attach-entry-root-custody\",\n2904|        path=f\"{PACKAGE}/lifecycle.go\",\n2905|        find='\\tif err := CheckSocketCustody(socket, lc.Root, lc.Platform); err != nil {\\n',\n2906|        replace='\\tif err := CheckSocketCustody(socket, lc.Root, lc.Platform); err != nil && operation != terminalbackend.OperationAttach {\\n',\n2907|        count=1,\n2908|        run=\"(TestExecuteAttachRefusesWritableRootValidBody|TestExecuteEachOperationRefusesWritableRoot)\",\n2909|        expect=\"KILLED\",\n2910|        note=\"Admits exactly the attach entry past the custody pre-gate (reviewer R4 shape: the unsafe-root class served under a 0777 root); every other entry still refuses. Kill path: the valid-body attach succeeds through the lifecycle dispatch.\",\n2911|    ),\n2912|    Mutant(\n2913|        name=\"N-stop-escalation-generation\",\n2914|        path=f\"{PACKAGE}/lifecycle.go\",\n2915|        find='\\t\\tif lc.CurrentGeneration() != mctx.BackendGeneration {\\n\\t\\t\\treturn &terminstance.Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation stale\"}\\n\\t\\t}\\n',\n2916|        replace='\\t\\tif lc.CurrentGeneration() != mctx.BackendGeneration && lc.CurrentGeneration() != \"generation-two\" {\\n\\t\\t\\treturn &terminstance.Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation stale\"}\\n\\t\\t}\\n',\n2917|        count=1,\n2918|        run=\"(TestExecuteStopRefusesStaleFactsAfterPoll|TestExecuteQuiesceRefusesStaleFactsBetweenCommands)\",\n2919|        expect=\"KILLED\",\n2920|        note=\"Admits exactly generation-two past the shared within-effect generation recheck (the terminstance.Error return pins the closure site against the two entry sites); every other stale generation still refuses. One shared site, two entries: the stop escalation issues its kill and the quiesce detach issues, so the generation subtests redden on both while the authorization and deadline subtests stay green (attribution per test from the raw log).\",\n2921|    ),\n2922|    Mutant(\n2923|        name=\"N-stop-escalation-expiry\",\n2924|        path=f\"{PACKAGE}/lifecycle.go\",\n2925|        find='\\t\\t\\treturn &terminstance.Error{Code: timeoutCode, Detail: \"operation deadline\"}\\n\\t\\t}\\n\\t\\tif err := terminstance.CheckAuthorization(mctx.Authorization, kind, lc.CurrentLease(), lc.Now()); err != nil {\\n',\n2926|        replace='\\t\\t\\treturn &terminstance.Error{Code: timeoutCode, Detail: \"operation deadline\"}\\n\\t\\t}\\n\\t\\tif err := terminstance.CheckAuthorization(mctx.Authorization, kind, lc.CurrentLease(), lc.Now().Add(-time.Hour)); err != nil {\\n',\n2927|        count=1,\n2928|        run=\"(TestExecuteStopRefusesStaleFactsAfterPoll|TestExecuteQuiesceRefusesStaleFactsBetweenCommands)\",\n2929|        expect=\"KILLED\",\n2930|        note=\"Admits exactly recently-expired authorizations past the shared within-effect authorization recheck (the timeoutCode context pins the closure site against the leaf-loop twin); members expired over an hour still refuse, and lease-drift members are untouched. One shared site, two entries: the authorization subtests redden on both while the generation and deadline subtests stay green (attribution per test from the raw log).\",\n2931|    ),\n2932|    Mutant(\n2933|        name=\"N-stop-escalation-deadline\",\n2934|        path=f\"{PACKAGE}/lifecycle.go\",\n2935|        find='\\t\\tif !lc.Now().Before(opDeadline) {\\n',\n2936|        replace='\\t\\tif lc.Now().After(opDeadline) {\\n',\n2937|        count=1,\n2938|        run=\"(TestExecuteStopRefusesStaleFactsAfterPoll|TestExecuteQuiesceRefusesStaleFactsBetweenCommands)\",\n2939|        expect=\"KILLED\",\n2940|        note=\"Admits exactly the on-deadline instant past the shared within-effect deadline (strict Before becomes After); every strictly-late instant still refuses. One shared site, two entries: the stop deadline-instant subtest reddens (the kill issues at the instant) while the strictly-past deadline subtests stay green (attribution per test from the raw log).\",\n2941|    ),\n2942|    Mutant(\n2943|        name=\"N-stop-escalation-skip\",\n2944|        path=f\"{PACKAGE}/backend.go\",\n2945|        find='\\t\\tif err := runner.recheckPostWait(); err != nil {\\n\\t\\t\\treturn \"\", err\\n\\t\\t}\\n\\t\\targv, err := runner.command(DirectiveKillSession)\\n',\n2946|        replace='\\t\\tif err := runner.recheckPostWait(); err != nil && terminstance.ErrorCode(err) != terminalbackend.CodeStaleGeneration {\\n\\t\\t\\treturn \"\", err\\n\\t\\t}\\n\\t\\targv, err := runner.command(DirectiveKillSession)\\n',\n2947|        count=1,\n2948|        run=\"TestExecuteStopRefusesStaleFactsAfterPoll\",\n2949|        expect=\"KILLED\",\n2950|        note=\"Admits exactly stale-generation members past the escalation boundary (the 2-tab indentation pins the confirmClosed site against the 3-tab closeInput site); unauthorized and timed-out members still refuse there. Kill path: the kill issues under the rotated generation, so the generation subtest reddens while the authorization, deadline, and deadline-instant subtests stay green.\",\n2951|    ),\n2952|    Mutant(\n2953|        name=\"N-quiesce-midsequence-skip\",\n2954|        path=f\"{PACKAGE}/backend.go\",\n2955|        find='\\t\\t\\tif err := runner.recheckPostWait(); err != nil {\\n\\t\\t\\t\\treturn \"\", err\\n\\t\\t\\t}\\n',\n2956|        replace='\\t\\t\\tif err := runner.recheckPostWait(); err != nil && terminstance.ErrorCode(err) != terminalbackend.CodeStaleGeneration {\\n\\t\\t\\t\\treturn \"\", err\\n\\t\\t\\t}\\n',\n2957|        count=1,\n2958|        run=\"TestExecuteQuiesceRefusesStaleFactsBetweenCommands\",\n2959|        expect=\"KILLED\",\n2960|        note=\"Admits exactly stale-generation members past the detach boundary (the 3-tab indentation pins the closeInput site against the 2-tab escalation site); unauthorized and timed-out members still refuse there. Kill path: the detach issues under the rotated generation, so the generation subtest reddens while the authorization and deadline subtests stay green.\",\n2961|    ),\n2962|    Mutant(\n2963|        name=\"N-attach-overlap-multi\",\n2964|        path=f\"{PACKAGE}/ops.go\",\n2965|        find='\\tif !admitted.Has(\"multi_attach\") {\\n\\t\\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\\n\\t}\\n',\n2966|        replace='\\tif len(peers) > 1 && !admitted.Has(\"multi_attach\") {\\n\\t\\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\\n\\t}\\n',\n2967|        count=1,\n2968|        run=\"TestAttachOverlapRequiresMultiAttach\",\n2969|        expect=\"KILLED\",\n2970|        note=\"Admits exactly the one-peer overlap past the multi_attach arm (the second client commits its receipt); two-peer overlaps still refuse. Kill path: the second attach succeeds without the capability while the third-attach precision leg stays refused.\",\n2971|    ),\n2972|    Mutant(\n2973|        name=\"N-attach-overlap-input\",\n2974|        path=f\"{PACKAGE}/ops.go\",\n2975|        find='\\t\\t\\tif !admitted.Has(\"multiple_input_clients\") {\\n\\t\\t\\t\\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\\n\\t\\t\\t}\\n',\n2976|        replace='\\t\\t\\tif len(peers) > 1 && !admitted.Has(\"multiple_input_clients\") {\\n\\t\\t\\t\\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\\n\\t\\t\\t}\\n',\n2977|        count=1,\n2978|        run=\"TestAttachOverlapInputRequiresMultipleInputClients\",\n2979|        expect=\"KILLED\",\n2980|        note=\"Admits exactly the one-peer concurrent input past the multiple_input_clients arm (the second writable client commits its receipt with authorized input); overlaps over two peers still refuse. Kill path: the second attach succeeds without the capability while the third-attach precision leg stays refused.\",\n2981|    ),\n2982|    Mutant(\n2983|        name=\"N-attach-wait-deadline\",\n2984|        path=f\"{PACKAGE}/lifecycle.go\",\n2985|        find='\\treturn context.WithTimeout(ctx, deadline.Sub(lc.Now()))\\n',\n2986|        replace='\\treturn context.WithTimeout(ctx, deadline.Sub(lc.Now())+time.Hour)\\n',\n2987|        count=1,\n2988|        run=\"(TestAttachWaitBoundedByOperationDeadline|TestAttachWaitCancelledReturnsPromptly|TestQuiesceBarrierWaitBoundedByOperationDeadline|TestBoundaryCommitWaitBoundedByOperationDeadline)\",\n2989|        expect=\"KILLED\",\n2990|        note=\"Admits exactly waits expiring within the hour past the shared wait bound (every barrier and admission wait runs an hour long); cancellation still cancels. One shared site, four entries: the attach, quiesce, and boundary deadline tests redden (each blocks until its release) while the cancellation test stays green (attribution per test from the raw log).\",\n2991|    ),\n2992|    Mutant(\n2993|        name=\"C-control\",\n2994|        path=f\"{PACKAGE}/errors.go\",\n2995|        find=\"// Error is a package-local refusal. Code is one of the Code*\",\n2996|        replace=\"// Error is a package-local refusal (harness control: comment-only). Code is one of the Code*\",\n2997|        count=1,\n2998|        run=\"TestSocketPathDerivesOnlyFromRuntimeDir\",\n2999|        expect=\"SURVIVED\",\n3000|        note=\"Harmless control: a comment-only edit that must SURVIVE, proving the harness observes outcomes.\",\n3001|    ),\n3002|]\n3003|\n3004|\n3005|def apply(mutant: Mutant, original: str) -> str:\n3006|    return original.replace(mutant.find, mutant.replace)\n3007|\n3008|\n3009|def run_mutant(mutant: Mutant, log_dir: Path | None) -> str:\n3010|    target = REPO / mutant.path\n3011|    original = target.read_text()\n3012|    found = original.count(mutant.find)\n3013|    if found != mutant.count:\n3014|        return f\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\"\n3015|    with tempfile.TemporaryDirectory() as staging:\n3016|        backup = Path(staging) / \"backup\"\n3017|        shutil.copy2(target, backup)\n3018|        try:\n3019|            target.write_text(apply(mutant, original))\n3020|            run = subprocess.run(\n3021|                [\"go\", \"test\", f\"./{PACKAGE}/\", \"-run\", mutant.run, \"-count=1\"],\n3022|                cwd=REPO,\n3023|                capture_output=True,\n3024|                text=True,\n3025|                timeout=300,\n3026|            )\n3027|        finally:\n3028|            shutil.copy2(backup, target)\n3029|    output = (run.stdout + run.stderr).strip()\n3030|    if os.environ.get(\"AX_MUTANT_VERBOSE\") == \"1\":\n3031|        print(f\"--- raw: {mutant.name}: exit {run.returncode} ---\", flush=True)\n3032|        print(output, flush=True)\n3033|        print(f\"--- end raw: {mutant.name} ---\", flush=True)\n3034|    if log_dir is not None:\n3035|        (log_dir / f\"{mutant.name}.log\").write_text(\n3036|            f\"exit: {run.returncode}\\nrun: go test ./{PACKAGE}/ -run {mutant.run} -count=1\\n\\n{output}\\n\"\n3037|        )\n3038|    if 'build failed' in output or '\\n# ' in output or output.startswith('# '):\n3039|        return f\"ERROR: {mutant.name}: build broke under the patch\"\n3040|    if run.returncode == 0:\n3041|        verdict = \"SURVIVED\"\n3042|    elif '--- FAIL' in output or 'FAIL:' in output:\n3043|        verdict = \"KILLED\"\n3044|    else:\n3045|        return f\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\"\n3046|    mark = \"ok\" if verdict == mutant.expect else \"MISMATCH\"\n3047|    return f\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note} [exit {run.returncode}]\"\n3048|\n3049|\n3050|def main(argv: list[str]) -> int:\n3051|    log_dir: Path | None = None\n3052|    names = list(argv)\n3053|    if \"--log-dir\" in names:\n3054|        idx = names.index(\"--log-dir\")\n3055|        if idx + 1 >= len(names):\n3056|            print(\"--log-dir needs a directory\")\n3057|            return 2\n3058|        log_dir = Path(names[idx + 1])\n3059|        log_dir.mkdir(parents=True, exist_ok=True)\n3060|        del names[idx : idx + 2]\n3061|    selected = [m for m in MUTANTS if not names or m.name in names]\n3062|    if names and len(selected) != len(names):\n3063|        unknown = sorted(set(names) - {m.name for m in selected})\n3064|        print(f\"unknown mutants: {', '.join(unknown)}\")\n3065|        return 2\n3066|    failures = 0\n3067|    for mutant in selected:\n3068|        try:\n3069|            line = run_mutant(mutant, log_dir)\n3070|        except subprocess.TimeoutExpired:\n3071|            line = f\"ERROR: {mutant.name}: killer timed out\"\n3072|        print(line, flush=True)\n3073|        if not line.startswith(\"ok:\"):\n3074|            failures += 1\n3075|    return 1 if failures else 0\n3076|\n3077|\n3078|if __name__ == \"__main__\":\n3079|    sys.exit(main(sys.argv[1:]))","final_result":true}}}
