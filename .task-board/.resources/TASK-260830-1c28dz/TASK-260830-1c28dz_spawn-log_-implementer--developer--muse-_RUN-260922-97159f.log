argv []string) error\\n124:\\t// ViaSpawned: the broker path spawns nothing and the\\n222:\\tif req.Deps.ProbeServer == nil || req.Deps.Spawn == nil {\\n246:\\tif err := req.Deps.Spawn(socket, argv); err != nil {\\n247:\\t\\treturn Outcome{}, &Error{Code: CodeSpawnFailed, Detail: \\\"server spawn\\\"}\\n249:\\treturn Outcome{Via: ViaSpawned, Socket: socket, Argv: argv}, nil\\n\",\n  \"original_output_bytes\": 3024,\n  \"original_output_tokens\": 756,\n  \"truncated\": false\n}","final_result":true}}}
