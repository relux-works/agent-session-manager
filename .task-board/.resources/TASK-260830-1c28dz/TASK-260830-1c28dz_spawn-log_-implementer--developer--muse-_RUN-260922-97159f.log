{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c797","stream":{"kind":"session","id":"01a0c9a4-cdaf-7691-9123-20534004d71c"},"sequence":550,"recorded_at":1780531400001095,"record_type":"event","durability":"durable","causation_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","run_stream":{"kind":"run","id":"7d4d0da9-54d0-407b-9491-ce60f372e27f"},"task_stream":{"kind":"task","id":"01a0c9a6-01f1-7e33-8345-7f4ec81b77d1"},"task_id":"01a0c9a6-01f1-7e33-8345-7f4ec81b77d1","event":{"kind":"output","task_id":"01a0c9a6-01f1-7e33-8345-7f4ec81b77d1","chunk":"Read text file `internal/tmuxserver/lifecycle.go`.\n(499 line(s) above)\n500|\t\t// The poll bound is the graceful wait: the lesser of the\n501|\t\t// request deadline and the graceful timeout. The\n502|\t\t// escalation revalidation below answers to the\n503|\t\t// operation deadline instead — a graceful timeout\n504|\t\t// escalates, an operation deadline passed refuses —\n505|\t\t// so the two bounds stay distinct.\n506|\t\treqBackend.deadline = lc.lesserDeadline(mctx, params.GracefulTimeoutMs)\n507|\t}\n508|\tif operation == terminalbackend.OperationRequestStop || operation == terminalbackend.OperationQuiesceInput {\n509|\t\t// Within-effect revalidation for the paths whose\n510|\t\t// effects issue a destructive command after a wait:\n511|\t\t// the stop escalation after its poll, the quiesce\n512|\t\t// detach after its lock round trip. The boundary\n513|\t\t// wait's tail is observation-only and create's\n514|\t\t// effects are single commands with no wait, so\n515|\t\t// those paths carry no revalidation.\n516|\t\topDeadline, _ := mctx.Deadline.Time()\n517|\t\treqBackend.recheck = lc.effectRecheck(operation, mctx, engineKind(operation), opDeadline)\n518|\t}\n519|\tif operation == terminalbackend.OperationQuiesceInput {\n520|\t\t// Ordering contract, quiesce side: hold the barrier lock\n521|\t\t// across the engine input closure and the report commit\n522|\t\t// below, so no attach receipt commits between the tmux\n523|\t\t// closure effects and their durable proof. The lock\n524|\t\t// releases at return. The boundary wait takes no such\n525|\t\t// span (it blocks on the wrapper signal); only its\n526|\t\t// report commit serializes, in its case branch. The\n527|\t\t// acquisition itself honors the operation deadline\n528|\t\t// and the caller's cancellation like every barrier\n529|\t\t// user: a deadline cancels waiting, not a committed\n530|\t\t// effect.\n531|\t\twaitCtx, waitCancel := lc.waitContext(ctx, mctx)\n532|\t\tdefer waitCancel()\n533|\t\trelease, err := lc.acquireBarrier(waitCtx)\n534|\t\tif err != nil {\n535|\t\t\treturn empty, &Error{Code: rowTimeoutCode(operation), Detail: \"operation deadline\"}\n536|\t\t}\n537|\t\tdefer release()\n538|\t}\n539|\tresult, err := lc.engineFor(reqBackend).ExecuteMutating(ctx, operation, mctx, params, terminalbackend.InstanceState(req.Source), req.Admitted)\n540|\toutcome := OpOutcome{Operation: operation}\n541|\tif result.OperationID != \"\" {\n542|\t\toutcome.Mutation = &result\n543|\t\tif err != nil {\n544|\t\t\t// Failure results record only the honest\n545|\t\t\t// unknown: a pure refusal writes nothing\n546|\t\t\t// instead of overwriting an authoritative\n547|\t\t\t// record with stale caller state.\n548|\t\t\tlc.recordFailure(mctx.TerminalInstanceID, result.After)\n549|\t\t} else if operation != terminalbackend.OperationQuiesceInput && operation != terminalbackend.OperationWaitSafeBoundary {\n550|\t\t\t// Non-barrier successes record best-effort:\n551|\t\t\t// the memory is advisory and a lost write\n552|\t\t\t// never admits input.\n553|\t\t\t_ = lc.recordAfter(mctx.TerminalInstanceID, result.After)\n554|\t\t}\n555|\t\t// Barrier successes record below, checked, after the\n556|\t\t// outcome report commits: the report carries the closure\n557|\t\t// time the retry replays and the incarnation-scoped\n558|\t\t// proof the attach entry enforces, and the memory\n559|\t\t// carries the closure status reconciles against.\n560|\t}\n561|\tif err != nil {\n562|\t\treturn outcome, err\n563|\t}\n564|\tswitch operation {\n565|\tcase terminalbackend.OperationQuiesceInput:\n566|\t\toutcome.QuiescenceGeneration = params.QuiescenceGeneration\n567|\t\tclosedAt, err := lc.reportInputClosedAt(mctx.TerminalInstanceID, mctx.IdempotencyKey)\n568|\t\tif err != nil {\n569|\t\t\treturn outcome, err\n570|\t\t}\n571|\t\tif err := lc.recordAfter(mctx.TerminalInstanceID, result.After); err != nil {\n572|\t\t\treturn outcome, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"quiesce state image\"}\n573|\t\t}\n574|\t\toutcome.InputClosedAt = closedAt\n575|\tcase terminalbackend.OperationWaitSafeBoundary:\n576|\t\t// The boundary transition carries exactly one effect, and the\n577|\t\t// engine evidences every committed effect exactly once, so a\n578|\t\t// successful boundary result carries exactly one evidence ID.\n579|\t\toutcome.SafeBoundaryEvidenceID = result.EvidenceIDs[0]\n580|\t\t// Ordering contract, boundary side: the wait above ran\n581|\t\t// outside the lock; only the report commit below\n582|\t\t// serializes with attach receipts. The lock releases at\n583|\t\t// return. The acquisition honors the operation\n584|\t\t// deadline and the caller's cancellation like every\n585|\t\t// barrier user; a wait refused here reports the row\n586|\t\t// timeout against the already-committed proof.\n587|\t\twaitCtx, waitCancel := lc.waitContext(ctx, mctx)\n588|\t\tdefer waitCancel()\n589|\t\trelease, err := lc.acquireBarrier(waitCtx)\n590|\t\tif err != nil {\n591|\t\t\treturn outcome, &Error{Code: rowTimeoutCode(operation), Detail: \"operation deadline\"}\n592|\t\t}\n593|\t\tdefer release()\n594|\t\tobservedAt, err := lc.reportBoundaryObservedAt(mctx.TerminalInstanceID, mctx.IdempotencyKey)\n595|\t\tif err != nil {\n596|\t\t\treturn outcome, err\n597|\t\t}\n598|\t\tif err := lc.recordAfter(mctx.TerminalInstanceID, result.After); err != nil {\n599|\t\t\treturn outcome, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"boundary state image\"}\n600|\t\t}\n601|\t\toutcome.BoundaryObservedAt = observedAt\n602|\tcase terminalbackend.OperationRequestStop:\n603|\t\toutcome.ProcessClosed = true\n604|\t\toutcome.StoreClosed = true\n605|\t}\n606|\treturn outcome, nil\n607|}\n608|\n609|// reportInputClosedAt replays the recorded input-closed time for one\n610|// quiesce key, recording the current time on first success. The\n611|// first-success record binds the current incarnation, so the report\n612|// proves the barrier exactly for the incarnation it closed. A\n613|// failed or forged lookup is corruption, never absence: the retry\n614|// refuses the integrity failure instead of manufacturing a fresh\n615|// closure time for an already-closed input. A record failure\n616|// refuses the same way: the effect is committed but its time is\n617|// unprovable, so the retry re-records rather than reporting an\n618|// unrecorded time.\n619|func (lc *Lifecycle) reportInputClosedAt(instanceID, key string) (string, error) {\n620|\tstored, found, err := lc.States.LookupOutcome(key)\n621|\tif err != nil {\n622|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"quiesce outcome image\"}\n623|\t}\n624|\tif found {\n625|\t\tif stored.InputClosedAt == \"\" {\n626|\t\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"quiesce outcome image\"}\n627|\t\t}\n628|\t\treturn stored.InputClosedAt, nil\n629|\t}\n630|\tincarnation, _, err := lc.States.LookupIncarnation(instanceID)\n631|\tif err != nil {\n632|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"quiesce outcome image\"}\n633|\t}\n634|\trendered := formatTimestamp(lc.Now())\n635|\tif err := lc.States.RecordOutcome(key, OperationOutcome{Operation: string(terminalbackend.OperationQuiesceInput), InputClosedAt: rendered, Incarnation: incarnation}); err != nil {\n636|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"quiesce outcome image\"}\n637|\t}\n638|\treturn rendered, nil\n639|}\n640|\n641|// reportBoundaryObservedAt replays the recorded boundary-observed\n642|// time for one boundary key, recording the current time on first\n643|// success, with the same corrupt-read and record-failure discipline\n644|// as the quiesce report: no failed read becomes fresh evidence.\n645|// The first-success record binds the current incarnation like the\n646|// quiesce report.\n647|func (lc *Lifecycle) reportBoundaryObservedAt(instanceID, key string) (string, error) {\n648|\tstored, found, err := lc.States.LookupOutcome(key)\n649|\tif err != nil {\n650|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"boundary outcome image\"}\n651|\t}\n652|\tif found {\n653|\t\tif stored.BoundaryObservedAt == \"\" {\n654|\t\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"boundary outcome image\"}\n655|\t\t}\n656|\t\treturn stored.BoundaryObservedAt, nil\n657|\t}\n658|\tincarnation, _, err := lc.States.LookupIncarnation(instanceID)\n659|\tif err != nil {\n660|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"boundary outcome image\"}\n661|\t}\n662|\trendered := formatTimestamp(lc.Now())\n663|\tif err := lc.States.RecordOutcome(key, OperationOutcome{Operation: string(terminalbackend.OperationWaitSafeBoundary), BoundaryObservedAt: rendered, Incarnation: incarnation}); err != nil {\n664|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"boundary outcome image\"}\n665|\t}\n666|\treturn rendered, nil\n667|}\n668|\n669|// boundWait bounds the safe-boundary wait by the lesser of the request\n670|// deadline and the timeout: the wait context carries the minimum, and\n671|// an already-invalid deadline falls back to the timeout alone (the\n672|// engine refuses the malformed deadline before any effect runs, so the\n673|// fallback never binds). The caller cancels the context.\n674|func (lc *Lifecycle) boundWait(ctx context.Context, mctx terminstance.MutationContext, timeoutMs uint64) (context.Context, context.CancelFunc) {\n675|\tbound := lc.Now().Add(time.Duration(timeoutMs) * time.Millisecond)\n676|\tif deadline, err := mctx.Deadline.Time(); err == nil && deadline.Before(bound) {\n677|\t\tbound = deadline\n678|\t}\n679|\treturn context.WithDeadline(ctx, bound)\n680|}\n681|\n682|// lesserDeadline computes the lesser of the request deadline and the\n683|// graceful timeout for the stop close-confirm poll. An invalid\n684|// deadline falls back the same way as the boundary wait.\n685|func (lc *Lifecycle) lesserDeadline(mctx terminstance.MutationContext, timeoutMs uint64) time.Time {\n686|\tbound := lc.Now().Add(time.Duration(timeoutMs) * time.Millisecond)\n687|\tif deadline, err := mctx.Deadline.Time(); err == nil && deadline.Before(bound) {\n688|\t\treturn deadline\n689|\t}\n690|\treturn bound\n691|}\n692|\n693|// engineKind resolves one engine operation's AX authorization kind\n694|// through the landed transition table, mirroring the engine's own\n695|// mapping: the table names the kind and this function honors it. A\n696|// drift resolves to the empty kind, which the authorization check\n697|// refuses exactly like the engine's entry gate would.\n698|func engineKind(operation terminalbackend.Operation) terminstance.AuthorizationKind {\n699|\tlanded, err := terminalbackend.TransitionAuthorization(string(operation))\n700|\tif err != nil {\n701|\t\treturn \"\"\n702|\t}\n703|\tkind, err := terminstance.ParseAuthorizationKind(landed)\n704|\tif err != nil {\n705|\t\treturn \"\"\n706|\t}\n707|\treturn kind\n708|}\n709|\n710|// effectRecheck builds the within-effect authorization revalidation\n711|// for one engine operation: the same three per-effect gates the\n712|// landed loop applies before every effect — the operation deadline,\n713|// the AX authorization over the live lease, and the live server\n714|// generation — evaluated at the destructive command boundary that\n715|// follows a wait. The timeout code is the operation row's own\n716|// member. The authorization gate is the landed CheckAuthorization\n717|// over the same request authorization, kind, lease, and clock the\n718|// engine passes; nothing here re-implements it.\n719|func (lc *Lifecycle) effectRecheck(operation terminalbackend.Operation, mctx terminstance.MutationContext, kind terminstance.AuthorizationKind, opDeadline time.Time) func() error {\n720|\ttimeoutCode := rowTimeoutCode(operation)\n721|\treturn func() error {\n722|\t\tif !lc.Now().Before(opDeadline) {\n723|\t\t\treturn &terminstance.Error{Code: timeoutCode, Detail: \"operation deadline\"}\n724|\t\t}\n725|\t\tif err := terminstance.CheckAuthorization(mctx.Authorization, kind, lc.CurrentLease(), lc.Now()); err != nil {\n726|\t\t\treturn err\n727|\t\t}\n728|\t\tif lc.CurrentGeneration() != mctx.BackendGeneration {\n729|\t\t\treturn &terminstance.Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation stale\"}\n730|\t\t}\n731|\t\treturn nil\n732|\t}\n733|}\n734|\n735|// waitUntil bounds one wait by an absolute operation deadline\n736|// measured on the lifecycle clock, combined with the caller's\n737|// context. The duration comes from the request deadline minus the\n738|// lifecycle now, so fake-clock requests wait out their remaining\n739|// real time and already-passed deadlines refuse at once; the\n740|// caller cancels the context. A deadline cancels waiting, not a\n741|// committed effect.\n742|func (lc *Lifecycle) waitUntil(ctx context.Context, deadline time.Time) (context.Context, context.CancelFunc) {\n743|\treturn context.WithTimeout(ctx, deadline.Sub(lc.Now()))\n744|}\n745|\n746|// waitContext bounds one engine-operation wait by the mutation\n747|// context deadline. An unparseable deadline leaves the caller's\n748|// context unmodified: the operation body parse refuses it before\n749|// any wait runs, so the unmodified wait never binds an effect,\n750|// and a dedicated probe proves the path still returns promptly\n751|// under contention.\n752|func (lc *Lifecycle) waitContext(ctx context.Context, mctx terminstance.MutationContext) (context.Context, context.CancelFunc) {\n753|\tdeadline, err := mctx.Deadline.Time()\n754|\tif err != nil {\n755|\t\treturn ctx, func() {}\n756|\t}\n757|\treturn lc.waitUntil(ctx, deadline)\n758|}\n759|\n760|// acquireBarrier acquires the barrier mutex unless the wait context\n761|// fires first, in which case no lock is held and the waiter reports\n762|// the context error. A waiter that loses the race releases the\n763|// mutex as soon as its orphan acquisition lands, so a timed-out\n764|// waiter never steals the barrier from the next holder and never\n765|// leaves a goroutine behind once the holder releases. Every\n766|// barrier user — attach, the quiesce span, the boundary report\n767|// commit — acquires through this contract.\n768|func (lc *Lifecycle) acquireBarrier(ctx context.Context) (func(), error) {\n769|\t// An already-fired wait never starts its waiter: the\n770|\t// request is refused deterministically instead of racing the\n771|\t// orphan acquisition against the fired context.\n772|\tif err := ctx.Err(); err != nil {\n773|\t\treturn nil, err\n774|\t}\n775|\tacquired := make(chan struct{})\n776|\tgo func() {\n777|\t\tlc.barrierMu.Lock()\n778|\t\tclose(acquired)\n779|\t}()\n780|\tselect {\n781|\tcase <-acquired:\n782|\t\treturn lc.barrierMu.Unlock, nil\n783|\tcase <-ctx.Done():\n784|\t\tgo func() {\n785|\t\t\t<-acquired\n786|\t\t\tlc.barrierMu.Unlock()\n787|\t\t}()\n788|\t\treturn nil, ctx.Err()\n789|\t}\n790|}","final_result":true}}}
