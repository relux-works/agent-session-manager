{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cd6d","stream":{"kind":"session","id":"01a0c9a4-cdaf-7691-9123-20534004d71c"},"sequence":1297,"recorded_at":1780531400002589,"record_type":"event","durability":"durable","causation_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","run_stream":{"kind":"run","id":"7d4d0da9-54d0-407b-9491-ce60f372e27f"},"task_stream":{"kind":"task","id":"01a0c9b2-55d4-7dd1-a9c2-a38d0a798937"},"task_id":"01a0c9b2-55d4-7dd1-a9c2-a38d0a798937","event":{"kind":"output","task_id":"01a0c9b2-55d4-7dd1-a9c2-a38d0a798937","chunk":"edited\nchanged lines: lines 50-65\n--- original\n+++ updated\n@@\n-\tif body.HasTerminalInstanceID && !bindingMatchesQuery(binding, body) {\n-\t\treturn runner.nonMatchObservation(body, binding), nil\n-\t}\n-\tinstance := recorded.TerminalInstanceID\n-\tpresent, panes, err := runner.probePanes(ctx, instance)\n-\tif err != nil {\n-\t\treturn empty, err\n-\t}\n-\tattached := 0\n-\tif present {\n-\t\tcount, err := runner.probeAttached(ctx, instance)\n-\t\tif err != nil {\n-\t\t\treturn empty, err\n-\t\t}\n-\t\tattached = count\n-\t}\n+\tif body.HasTerminalInstanceID && !bindingMatchesQuery(binding, body) {\n+\t\treturn runner.nonMatchObservation(body, binding), nil\n+\t}\n+\t// The live probes run under the query deadline, through the\n+\t// same shared probe context as the close-confirm poll: a probe\n+\t// still blocked when the bound fires concludes unknown — the\n+\t// engine maps the uncoded failure — never absent. An\n+\t// unparseable deadline leaves the caller's context unmodified;\n+\t// the engine refuses it before any probe runs.\n+\tprobeCtx := ctx\n+\tif deadline, err := body.Deadline.Time(); err == nil {\n+\t\tvar cancel context.CancelFunc\n+\t\tprobeCtx, cancel = probeContext(ctx, runner.now, deadline)\n+\t\tdefer cancel()\n+\t}\n+\tinstance := recorded.TerminalInstanceID\n+\tpresent, panes, err := runner.probePanes(probeCtx, instance)\n+\tif err != nil {\n+\t\treturn empty, err\n+\t}\n+\tattached := 0\n+\tif present {\n+\t\tcount, err := runner.probeAttached(probeCtx, instance)\n+\t\tif err != nil {\n+\t\t\treturn empty, err\n+\t\t}\n+\t\tattached = count\n+\t}\n","final_result":true}}}
