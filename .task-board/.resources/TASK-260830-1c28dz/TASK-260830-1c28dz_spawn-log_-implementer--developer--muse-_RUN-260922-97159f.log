{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6e3","stream":{"kind":"session","id":"01a0c9a4-cdaf-7691-9123-20534004d71c"},"sequence":460,"recorded_at":1780531400000915,"record_type":"event","durability":"durable","causation_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","run_stream":{"kind":"run","id":"7d4d0da9-54d0-407b-9491-ce60f372e27f"},"task_stream":{"kind":"task","id":"01a0c9a5-e2d8-72c0-83f0-0ba1113b9fe1"},"task_id":"01a0c9a5-e2d8-72c0-83f0-0ba1113b9fe1","event":{"kind":"output","task_id":"01a0c9a5-e2d8-72c0-83f0-0ba1113b9fe1","chunk":"Read text file `internal/tmuxserver/ops.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"sort\"\n8|\t\"strconv\"\n9|\t\"time\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n17|)\n18|\n19|// This file executes the three lifecycle operations the landed engine\n20|// scope refuses — attach, terminate-stale, and restore — over the same\n21|// landed gates the engine uses (transition matrix, idempotency shapes,\n22|// authorization, capability conferral, receipt and binding stores)\n23|// plus the tmux backend. The recheck loop, receipt discipline, and\n24|// error-to-observation mapping mirror the engine's second side of each\n25|// rule; the census symmetry lines name both sides.\n26|\n27|// sortedEffects copies effects into bytewise order for the wire.\n28|func sortedEffects(effects []terminalbackend.SideEffect) []terminalbackend.SideEffect {\n29|\tordered := append([]terminalbackend.SideEffect(nil), effects...)\n30|\tsort.Slice(ordered, func(i, j int) bool { return ordered[i] < ordered[j] })\n31|\treturn ordered\n32|}\n33|\n34|// sortedEvidence copies evidence IDs into bytewise order for the wire.\n35|func sortedEvidence(evidence []string) []string {\n36|\tordered := append([]string(nil), evidence...)\n37|\tsort.Strings(ordered)\n38|\treturn ordered\n39|}\n40|\n41|// attachDescriptor derives the bound attach descriptor: socket,\n42|// instance, and client joined by newlines. It is host-local (the\n43|// socket path is usable only on the responding host), deterministic,\n44|// and never persisted: the attach handler returns it without writing\n45|// it anywhere, and a dedicated test scans the stores for its bytes.\n46|// Length is bounded by construction — sun_path socket plus two UUIDs\n47|// stay two orders of magnitude below the 4096 cap — so no length arm\n48|// exists to measure; a test pins the maximum instead.\n49|func attachDescriptor(socket, instance, client string) string {\n50|\treturn socket + \"\\n\" + instance + \"\\n\" + client\n51|}\n52|\n53|// createDescriptor derives the unbound create-interactive descriptor:\n54|// socket and instance only, because create carries no client. Same\n55|// non-persistence and length properties as the bound shape.\n56|func createDescriptor(socket, instance string) string {\n57|\treturn socket + \"\\n\" + instance\n58|}\n59|\n60|// executeAttach runs one attach: closed-shape admission, deadline,\n61|// transition, landed attach authorization, capability conferral plus\n62|// the matching-transport arm, the fast-path quiesce barrier check,\n63|// live server attestation (the P3-A wiring: a fresh decoy admission\n64|// refuses), the authoritative barrier recheck under the ordering\n65|// lock, the durable client receipt, and the caller-executed attach\n66|// vector with its descriptor. The entry returns the vector; it never\n67|// execs an interactive attach.\n68|func (lc *Lifecycle) executeAttach(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n69|\tempty := OpOutcome{Operation: terminalbackend.OperationAttach}\n70|\tbody, err := parseAttachBody(req.Body)\n71|\tif err != nil {\n72|\t\treturn empty, err\n73|\t}\n74|\tif err := checkLifecycleBackend(body.TerminalBackendID); err != nil {\n75|\t\treturn empty, err\n76|\t}\n77|\tdeadline, err := body.Deadline.Time()\n78|\tif err != nil {\n79|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body deadline\"}\n80|\t}\n81|\tif !lc.Now().Before(deadline) {\n82|\t\treturn empty, &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n83|\t}\n84|\tif _, _, err := terminalbackend.CheckTransition(string(terminalbackend.OperationAttach), req.Source, false); err != nil {\n85|\t\treturn empty, err\n86|\t}\n87|\tif err := terminalbackend.CheckAttachRequest(body.Authorization, body.Transport, body.InputAuthorized, lc.Now()); err != nil {\n88|\t\treturn empty, err\n89|\t}\n90|\tif err := terminalbackend.CheckOperation(string(terminalbackend.OperationAttach), req.Admitted); err != nil {\n91|\t\treturn empty, err\n92|\t}\n93|\tif err := checkAttachTransportCapability(body.Transport, req.Admitted); err != nil {\n94|\t\treturn empty, err\n95|\t}\n96|\tif err := lc.checkAttachQuiesced(body.TerminalInstanceID, body.InputAuthorized); err != nil {\n97|\t\treturn empty, err\n98|\t}\n99|\tif lc.ServerAdmission == nil {\n100|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle dependencies\"}\n101|\t}\n102|\t// One wait context bounds both waits below — the server\n103|\t// admission and the barrier acquisition — by the operation\n104|\t// deadline and the caller's cancellation: a deadline cancels\n105|\t// waiting, not a committed effect, and a timed-out wait\n106|\t// commits nothing late.\n107|\twaitCtx, waitCancel := lc.waitUntil(ctx, deadline)\n108|\tdefer waitCancel()\n109|\tadmission, err := lc.admitServer(waitCtx)\n110|\tif err != nil {\n111|\t\tif errors.Is(err, context.DeadlineExceeded) || errors.Is(err, context.Canceled) {\n112|\t\t\treturn empty, &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n113|\t\t}\n114|\t\treturn empty, rowError(terminalbackend.OperationAttach, err)\n115|\t}\n116|\tif err := CheckServerAttested(admission, body.BackendGeneration); err != nil {\n117|\t\treturn empty, &Error{Code: terminalbackend.CodeUnauthorized, Detail: \"attach server attestation\"}\n118|\t}\n119|\t// Ordering contract, attach side: the checks above ran before\n120|\t// the (possibly blocking) server admission and the barrier\n121|\t// lock wait, so every live fact they observed may have gone\n122|\t// stale. The effect boundary below re-observes every live\n123|\t// authorization fact under the lock immediately before the\n124|\t// receipt commit, and the lock holds through the receipt, the\n125|\t// returned vector, and the advisory memory record. The\n126|\t// enumeration, first-observed site to revalidation site:\n127|\t// closure (fast path above, rechecked here); server\n128|\t// generation (admission above, live CurrentGeneration here);\n129|\t// request deadline (entry above, live clock here — the lock\n130|\t// wait counts against the deadline, and the deadline stays\n131|\t// distinct from the authorization expiry); authorization\n132|\t// expiry, transport binding, and input binding (entry\n133|\t// CheckAttachRequest above, live clock rechecked inside the\n134|\t// commit call itself, which holds no wait between its check\n135|\t// and its no-replace install, plus the post-commit result\n136|\t// binding for input). Transition, operation capability, and\n137|\t// backend identity are pure checks over request-immutable\n138|\t// members — no live fact, nothing to revalidate. The\n139|\t// attestation value is immutable once returned; its live\n140|\t// counterpart is the generation rechecked here. The overlap\n141|\t// possibility (below) is likewise a live fact: a peer client\n142|\t// may commit between the admission and this lock, so the\n143|\t// receipt census is read here, not earlier. Residual: a\n144|\t// rotation landing between this recheck and the commit —\n145|\t// inside one process or across processes — is not excluded;\n146|\t// the window holds no waits (file I/O only). That remainder\n147|\t// is the B42 in-process scope, extended to the generation\n148|\t// and deadline rechecks.\n149|\trelease, err := lc.acquireBarrier(waitCtx)\n150|\tif err != nil {\n151|\t\treturn empty, &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n152|\t}\n153|\tdefer release()\n154|\tif err := lc.checkAttachQuiesced(body.TerminalInstanceID, body.InputAuthorized); err != nil {\n155|\t\treturn empty, err\n156|\t}\n157|\tif !lc.Now().Before(deadline) {\n158|\t\treturn empty, &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n159|\t}\n160|\tif lc.CurrentGeneration() != body.BackendGeneration {\n161|\t\treturn empty, &Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation stale\"}\n162|\t}\n163|\tif err := lc.checkAttachOverlap(body, req.Admitted); err != nil {\n164|\t\treturn empty, err\n165|\t}\n166|\treqBackend := lc.requestBackend(req, socket, body.SessionID, body.TerminalInstanceID)\n167|\treqBackend.operation = terminalbackend.OperationAttach\n168|\treqBackend.clientID = body.ClientID\n169|\treqBackend.transport = body.Transport\n170|\treqBackend.input = body.InputAuthorized\n171|\treqBackend.authRaw = body.AuthRaw\n172|\tevidenceID, err := reqBackend.PerformEffect(ctx, terminalbackend.EffectAttachClientCreated)\n173|\tif err != nil {\n174|\t\treturn empty, rowError(terminalbackend.OperationAttach, err)\n175|\t}\n176|\targv, err := BuildCommand(DirectiveAttachSession, CommandArgs{\n177|\t\tRuntimeDir:     lc.RuntimeDir,\n178|\t\tSocket:         socket,\n179|\t\tInstanceID:     body.TerminalInstanceID,\n180|\t\tAttachInput:    body.InputAuthorized,\n181|\t\tHasAttachInput: true,\n182|\t})\n183|\tif err != nil {\n184|\t\treturn empty, err\n185|\t}\n186|\tif err := terminalbackend.CheckAttachResult(body.InputAuthorized, body.InputAuthorized, body.Authorization); err != nil {\n187|\t\treturn empty, err\n188|\t}\n189|\t// Only an input-authorized attach adopts the active state: a\n190|\t// read-only attach is observation, and recording active for it\n191|\t// would reopen quiesced input (the quiesce barrier reads this\n192|\t// same memory, so observation must leave it untouched).\n193|\tif body.InputAuthorized {\n194|\t\t_ = lc.recordAfter(body.TerminalInstanceID, terminalbackend.StateActive)\n195|\t}\n196|\treturn OpOutcome{\n197|\t\tOperation: terminalbackend.OperationAttach,\n198|\t\tAttach: &AttachOutcome{\n199|\t\t\tClientMirrorID:  body.ClientID,\n200|\t\t\tDescriptor:      attachDescriptor(socket, body.TerminalInstanceID, body.ClientID),\n201|\t\t\tInputAuthorized: body.InputAuthorized,\n202|\t\t\tEvidenceIDs:     []string{evidenceID},\n203|\t\t},\n204|\t\tArgv: argv,\n205|\t}, nil\n206|}\n207|\n208|// checkAttachQuiesced enforces the quiesce input barrier at the\n209|// attach entry: tmux offers no session freeze (a locked session does\n210|// not lock subsequently attaching clients), so once a closure\n211|// report proves the input closed in the current incarnation, new\n212|// input-authorized attaches refuse the failed local precondition.\n213|// Read-only attaches stay admitted: quiesce stops input while\n214|// retaining observation. The incarnation-scoped closure proof is the\n215|// sole admission verdict: advisory memory, caller-carried source\n216|// state, and failure reporting are never consulted for their value\n217|// here, so none of them can reopen a closed barrier — a stale\n218|// active record, a failure result echoing its source, and a lost\n219|// state write all refuse exactly like the proof itself. Only a\n220|// fresh create or restore success reopens the input, by rotating\n221|// the incarnation the proof is scoped to. Store health still fails\n222|// closed: an unreadable state record is unknown, never admission,\n223|// so the memory read error propagates even though its value is\n224|// ignored. A proof read failure is likewise an error, never\n225|// admission: unknown is not a verdict.\n226|func (lc *Lifecycle) checkAttachQuiesced(instanceID string, inputAuthorized bool) error {\n227|\tif !inputAuthorized {\n228|\t\treturn nil\n229|\t}\n230|\tif _, _, err := lc.States.Lookup(instanceID); err != nil {\n231|\t\treturn err\n232|\t}\n233|\tproven, err := lc.States.QuiesceBarrierProven(instanceID)\n234|\tif err != nil {\n235|\t\treturn err\n236|\t}\n237|\tif proven {\n238|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"attach quiesced input\"}\n239|\t}\n240|\treturn nil\n241|}\n242|\n243|// admissionResult is one server-admission answer from the waiter\n244|// goroutine.\n245|type admissionResult struct {\n246|\tadmission RealmAdmission\n247|\terr       error\n248|}\n249|\n250|// admitServer runs the injected server admission under the wait\n251|// context and reports its verdict: the entry takes whichever\n252|// answers first — the admission or the deadline. The bound is\n253|// enforced, never cooperative: an adapter that ignores\n254|// cancellation still loses at the deadline, and its late answer is\n255|// discarded, never committed. The abandoned waiter send never\n256|// blocks — the channel is buffered — and its goroutine exits when\n257|// the adapter returns, so nothing here waits past the bound and\n258|// nothing commits after the caller timed out.\n259|func (lc *Lifecycle) admitServer(ctx context.Context) (RealmAdmission, error) {\n260|\t// An already-fired wait never starts its admission: the\n261|\t// request is refused deterministically instead of racing the\n262|\t// waiter goroutine against the fired context.\n263|\tif err := ctx.Err(); err != nil {\n264|\t\treturn RealmAdmission{}, err\n265|\t}\n266|\tanswered := make(chan admissionResult, 1)\n267|\tgo func() {\n268|\t\tadmission, err := lc.ServerAdmission(ctx)\n269|\t\tanswered <- admissionResult{admission: admission, err: err}\n270|\t}()\n271|\tselect {\n272|\tcase result := <-answered:\n273|\t\treturn result.admission, result.err\n274|\tcase <-ctx.Done():\n275|\t\treturn RealmAdmission{}, ctx.Err()\n276|\t}\n277|}\n278|\n279|// checkAttachOverlap enforces the §4.C attach overlap capabilities\n280|// at the effect boundary: a new client that may overlap a recorded\n281|// peer needs multi_attach, and new concurrent input over a recorded\n282|// input-authorized peer needs multiple_input_clients. Overlap cannot\n283|// be ruled out here — this leaf has no client-liveness census — so\n284|// a stored peer receipt is treated as possibly live and the gate\n285|// fails closed on the possibility. Same-client retries are exempt:\n286|// the idempotency key names the (instance, client) pair, and a\n287|// retry replays its own receipt rather than adding a client. A\n288|// peer-census read failure is an error, never admission: unknown\n289|// is not a verdict. The liveness census that refines this\n290|// receipt-inferred possibility (including detached clients whose\n291|// receipts still stand) is owned by TASK-260922-vcx6yo; until it\n292|// lands this gate stays over-strict rather than over-permissive.\n293|func (lc *Lifecycle) checkAttachOverlap(body AttachBody, admitted terminalbackend.Admitted) error {\n294|\tpeers, err := lc.Attach.Peers(body.SessionID, body.TerminalInstanceID, body.ClientID)\n295|\tif err != nil {\n296|\t\treturn err\n297|\t}\n298|\tif len(peers) == 0 {\n299|\t\treturn nil\n300|\t}\n301|\tif !admitted.Has(\"multi_attach\") {\n302|\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n303|\t}\n304|\tif !body.InputAuthorized {\n305|\t\treturn nil\n306|\t}\n307|\tfor _, peer := range peers {\n308|\t\tif peer.InputAuthorized {\n309|\t\t\tif !admitted.Has(\"multiple_input_clients\") {\n310|\t\t\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n311|\t\t\t}\n312|\t\t\treturn nil\n313|\t\t}\n314|\t}\n315|\treturn nil\n316|}\n317|\n318|// checkAttachTransportCapability enforces the matching-transport arm:\n319|// local presentation needs local_attach, mesh presentation needs\n320|// remote_attach. The relay member never reaches here — the landed\n321|// attach authorization refuses it first — so no third arm exists.\n322|func checkAttachTransportCapability(transport string, admitted terminalbackend.Admitted) error {\n323|\tswitch transport {\n324|\tcase string(terminalbackend.TransportLocalOnly):\n325|\t\tif !admitted.Has(\"local_attach\") {\n326|\t\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n327|\t\t}\n328|\tcase string(terminalbackend.TransportTrustedPrivateMesh):\n329|\t\tif !admitted.Has(\"remote_attach\") {\n330|\t\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n331|\t\t}\n332|\tdefault:\n333|\t\treturn &Error{Code: terminalbackend.CodeProtocolError, Detail: \"presentation transport vocabulary\"}\n334|\t}\n335|\treturn nil\n336|}\n337|\n338|// executeTerminate runs one terminate-stale: closed-shape admission,\n339|// idempotency material, capability conferral plus the dual conditional,\n340|// transition, force_stale authorization, generation recheck, landed\n341|// fencing authorization, deadline, receipt discipline with\n342|// status-reconciled resume, and the kill plus close-confirm effects.\n343|func (lc *Lifecycle) executeTerminate(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n344|\tempty := OpOutcome{Operation: terminalbackend.OperationTerminateStale}\n345|\tbody, err := parseTerminateBody(req.Body)\n346|\tif err != nil {\n347|\t\treturn empty, err\n348|\t}\n349|\toperation := terminalbackend.OperationTerminateStale\n350|\tmctx := body.Context\n351|\tsource := terminalbackend.InstanceState(req.Source)\n352|\tif err := checkLifecycleBackend(mctx.TerminalBackendID); err != nil {\n353|\t\treturn empty, err\n354|\t}\n355|\tderived, err := terminalbackend.IdempotencyKey(string(operation), mctx.TerminalInstanceID, \"terminate\", body.StaleLeaseID, strconv.FormatUint(body.StaleEpoch, 10))\n356|\tif err != nil {\n357|\t\treturn empty, err\n358|\t}\n359|\tif mctx.IdempotencyKey != derived {\n360|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"idempotency key material\"}\n361|\t}\n362|\tif err := terminalbackend.CheckOperation(string(operation), req.Admitted); err != nil {\n363|\t\tfailure := rowError(operation, err)\n364|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n365|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n366|\t}\n367|\tif err := checkTerminateCapability(req.Admitted); err != nil {\n368|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n369|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n370|\t}\n371|\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), false)\n372|\tif err != nil {\n373|\t\tfailure := rowError(operation, err)\n374|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n375|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n376|\t}\n377|\tif err := terminstance.CheckAuthorization(mctx.Authorization, terminstance.AuthorizationForceStale, lc.CurrentLease(), lc.Now()); err != nil {\n378|\t\tfailure := rowError(operation, err)\n379|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n380|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n381|\t}\n382|\tif lc.CurrentGeneration() != mctx.BackendGeneration {\n383|\t\tfailure := &Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation stale\"}\n384|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n385|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n386|\t}\n387|\tif err := mapFencingError(fencing.AuthorizeTerminateStale(req.Presented, req.Winner, req.HasWinner, req.ForceRecovery, req.DiagnosticsPreserved)); err != nil {\n388|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n389|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n390|\t}\n391|\tif err := checkTerminateTarget(mctx, body, req.Presented); err != nil {\n392|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n393|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n394|\t}\n395|\tif err := checkTerminateWinner(mctx, req.Winner, lc.CurrentLease()); err != nil {\n396|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n397|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n398|\t}\n399|\tdeadline, err := mctx.Deadline.Time()\n400|\tif err != nil {\n401|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"mutation context deadline\"}\n402|\t}\n403|\tif !lc.Now().Before(deadline) {\n404|\t\tfailure := &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n405|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionReplaySame)\n406|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n407|\t}\n408|\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n409|\treqBackend.operation = operation\n410|\treqBackend.deadline = deadline\n411|\treturn lc.executeWithReceipt(ctx, req, socket, operation, mctx, source, target, effects, deadline, terminstance.AuthorizationForceStale, reqBackend, func(result terminstance.Result) OpOutcome {\n412|\t\treturn OpOutcome{Operation: operation, Mutation: &result, TargetClosed: true}\n413|\t})\n414|}\n415|\n416|// checkTerminateCapability enforces the dual conditional: stale\n417|// termination needs stale_process_termination AND\n418|// provider_process_observation. Each arm refuses alone.\n419|func checkTerminateCapability(admitted terminalbackend.Admitted) error {\n420|\tif !admitted.Has(\"stale_process_termination\") {\n421|\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n422|\t}\n423|\tif !admitted.Has(\"provider_process_observation\") {\n424|\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n425|\t}\n426|\treturn nil\n427|}\n428|\n429|// mapFencingError maps the landed terminate-stale authorization onto\n430|// the row's allowed set: malformed fencing material is the protocol\n431|// error, every other fencing refusal — no winner, no force, no\n432|// diagnostics, target mismatch, live owner — is the failed local\n433|// precondition. lease_conflict maps to the precondition too: the row\n434|// has no lease_conflict member, and a target fenced by another\n435|// session's winner fails the fenced-target precondition.\n436|func mapFencingError(err error) error {\n437|\tif err == nil {\n438|\t\treturn nil\n439|\t}\n440|\tif errors.Is(err, fencing.ErrInvalidArguments) {\n441|\t\treturn &Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminate fencing material\"}\n442|\t}\n443|\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate fencing authorization\"}\n444|}\n445|\n446|// checkTerminateTarget binds the presented fencing token to the\n447|// request: session, stale lease, and stale epoch must all agree with\n448|// the context and body. Any disagreement refuses the failed local\n449|// precondition: the retry would authorize a different target than the\n450|// key names.\n451|func checkTerminateTarget(mctx terminstance.MutationContext, body TerminateBody, presented fencing.PresentedToken) error {\n452|\tif presented.SessionID != mctx.SessionID ||\n453|\t\tpresented.LeaseID != body.StaleLeaseID ||\n454|\t\tpresented.Epoch != body.StaleEpoch {\n455|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate target binding\"}\n456|\t}\n457|\treturn nil\n458|}\n459|\n460|// checkTerminateWinner binds the caller-observed winner to the\n461|// re-read current lease: the fencing authorization decides over the\n462|// caller's winner, and only a winner that still wins authorizes. A\n463|// rotated or misobserved winner refuses the failed local\n464|// precondition; the caller re-observes and retries. Absence of a\n465|// winner never reaches here — the fencing gate refuses it first.\n466|func checkTerminateWinner(mctx terminstance.MutationContext, winner sessrepo.LeaseSummary, lease terminstance.LeaseView) error {\n467|\tif winner.SessionID != mctx.SessionID ||\n468|\t\twinner.LeaseID != lease.LeaseID ||\n469|\t\twinner.Epoch != lease.Epoch {\n470|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate winner binding\"}\n471|\t}\n472|\treturn nil\n473|}\n474|\n475|// executeRestore runs one restore: closed-shape admission, idempotency\n476|// material, capability conferral plus the reboot conditional,\n477|// transition, restore authorization, generation recheck, prior-binding\n478|// mismatch, deadline, receipt discipline with status-reconciled\n479|// resume, the persist plus wrapper-restored effects, and the required\n480|// result binding. The wire result is always parked. The backend\n481|// launches no provider: the wrapper owns launch gating through the\n482|// after-restore composition (ExecuteWrapperRestore), and this entry\n483|// only recreates the wrapper process.\n484|//\n485|// The result binding is the create-time document kept alongside the\n486|// bootstrap receipt, re-admitted by termbind on the read — within one\n487|// generation — or its minted successor across a reboot: the termbind\n488|// owner succeeds the prior (the JCS identity rule stays\n489|// termbind-private) and the successor persists under the same pair\n490|// key. The prior-binding mismatch arm proves the carried prior equals\n491|// the recorded digest; the document read proves a valid binding for\n492|// this session, instance, and backend.\n493|func (lc *Lifecycle) executeRestore(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n494|\tempty := OpOutcome{Operation: terminalbackend.OperationRestore}\n495|\tbody, err := parseRestoreBody(req.Body)\n496|\tif err != nil {\n497|\t\treturn empty, err\n498|\t}\n499|\toperation := terminalbackend.OperationRestore\n500|\tmctx := body.Context\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6e5","stream":{"kind":"session","id":"01a0c9a4-cdaf-7691-9123-20534004d71c"},"sequence":461,"recorded_at":1780531400000917,"record_type":"event","durability":"durable","causation_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","run_stream":{"kind":"run","id":"7d4d0da9-54d0-407b-9491-ce60f372e27f"},"task_stream":{"kind":"task","id":"01a0c9a5-e2d8-72c0-83f0-0ba1113b9fe1"},"task_id":"01a0c9a5-e2d8-72c0-83f0-0ba1113b9fe1","event":{"kind":"completed","task_id":"01a0c9a5-e2d8-72c0-83f0-0ba1113b9fe1"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6e7","stream":{"kind":"session","id":"01a0c9a4-cdaf-7691-9123-20534004d71c"},"sequence":462,"recorded_at":1780531400000919,"record_type":"event","durability":"durable","causation_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","run_stream":{"kind":"run","id":"7d4d0da9-54d0-407b-9491-ce60f372e27f"},"call_id":"call_01a0c9a5de6a745baa425c74b7ff1041","text":"Read text file `internal/termbind/overlap.go`.\n1|package termbind\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"sort\"\n9|\t\"strings\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// Peers replays every recorded presentation-client receipt for one\n15|// terminal instance except the requesting client itself: the stored\n16|// peer census the attach overlap gate fails closed on. A stored peer\n17|// is possibly live — receipts outlive their clients, and no\n18|// liveness is decided here — so callers treat a non-empty census as\n19|// possible overlap. The requesting client is excluded by identity:\n20|// a retry replays its own receipt rather than adding a client.\n21|//\n22|// An unrecorded instance has no peers. A read or validation failure\n23|// is an error, never an empty census: unknown is not a verdict.\n24|// Staging files (attach-*.tmp) and non-receipt files are skipped;\n25|// every decoded receipt must name this session and instance, like\n26|// Lookup. Peers arrive sorted by client ID.\n27|func (store *AttachStore) Peers(sessionID, instanceID, clientID string) ([]AttachReceipt, error) {\n28|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n29|\t\treturn nil, fmt.Errorf(\"attach peers session %q is not a UUIDv7: %w\", sessionID, err)\n30|\t}\n31|\tif err := CheckInstanceIdentity(instanceID); err != nil {\n32|\t\treturn nil, err\n33|\t}\n34|\tif err := CheckInstanceIdentity(clientID); err != nil {\n35|\t\treturn nil, err\n36|\t}\n37|\tentries, err := os.ReadDir(store.instanceDir(instanceID))\n38|\tif err != nil {\n39|\t\tif errors.Is(err, os.ErrNotExist) {\n40|\t\t\treturn nil, nil\n41|\t\t}\n42|\t\treturn nil, fmt.Errorf(\"read attach peers: %w\", err)\n43|\t}\n44|\tvar peers []AttachReceipt\n45|\tfor _, entry := range entries {\n46|\t\tname := entry.Name()\n47|\t\tif entry.IsDir() || !strings.HasSuffix(name, \".json\") || strings.HasPrefix(name, \"attach-\") {\n48|\t\t\tcontinue\n49|\t\t}\n50|\t\traw, err := os.ReadFile(filepath.Join(store.instanceDir(instanceID), name))\n51|\t\tif err != nil {\n52|\t\t\treturn nil, fmt.Errorf(\"read attach peer: %w\", err)\n53|\t\t}\n54|\t\treceipt, err := decodeAttachReceipt(raw)\n55|\t\tif err != nil {\n56|\t\t\treturn nil, err\n57|\t\t}\n58|\t\tif receipt.SessionID != sessionID {\n59|\t\t\treturn nil, errors.New(\"attach receipt names another session\")\n60|\t\t}\n61|\t\tif receipt.TerminalInstanceID != instanceID {\n62|\t\t\treturn nil, errors.New(\"attach receipt names another client pair\")\n63|\t\t}\n64|\t\tif receipt.ClientID == clientID {\n65|\t\t\tcontinue\n66|\t\t}\n67|\t\tpeers = append(peers, receipt)\n68|\t}\n69|\tsort.Slice(peers, func(i, j int) bool { return peers[i].ClientID < peers[j].ClientID })\n70|\treturn peers, nil\n71|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6e9","stream":{"kind":"session","id":"01a0c9a4-cdaf-7691-9123-20534004d71c"},"sequence":463,"recorded_at":1780531400000921,"record_type":"event","durability":"durable","causation_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","run_stream":{"kind":"run","id":"7d4d0da9-54d0-407b-9491-ce60f372e27f"},"call_id":"call_01a0c9a5df8d7138b0b6a54f11680bd6","text":"Read text file `internal/tmuxserver/ops.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"sort\"\n8|\t\"strconv\"\n9|\t\"time\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n17|)\n18|\n19|// This file executes the three lifecycle operations the landed engine\n20|// scope refuses — attach, terminate-stale, and restore — over the same\n21|// landed gates the engine uses (transition matrix, idempotency shapes,\n22|// authorization, capability conferral, receipt and binding stores)\n23|// plus the tmux backend. The recheck loop, receipt discipline, and\n24|// error-to-observation mapping mirror the engine's second side of each\n25|// rule; the census symmetry lines name both sides.\n26|\n27|// sortedEffects copies effects into bytewise order for the wire.\n28|func sortedEffects(effects []terminalbackend.SideEffect) []terminalbackend.SideEffect {\n29|\tordered := append([]terminalbackend.SideEffect(nil), effects...)\n30|\tsort.Slice(ordered, func(i, j int) bool { return ordered[i] < ordered[j] })\n31|\treturn ordered\n32|}\n33|\n34|// sortedEvidence copies evidence IDs into bytewise order for the wire.\n35|func sortedEvidence(evidence []string) []string {\n36|\tordered := append([]string(nil), evidence...)\n37|\tsort.Strings(ordered)\n38|\treturn ordered\n39|}\n40|\n41|// attachDescriptor derives the bound attach descriptor: socket,\n42|// instance, and client joined by newlines. It is host-local (the\n43|// socket path is usable only on the responding host), deterministic,\n44|// and never persisted: the attach handler returns it without writing\n45|// it anywhere, and a dedicated test scans the stores for its bytes.\n46|// Length is bounded by construction — sun_path socket plus two UUIDs\n47|// stay two orders of magnitude below the 4096 cap — so no length arm\n48|// exists to measure; a test pins the maximum instead.\n49|func attachDescriptor(socket, instance, client string) string {\n50|\treturn socket + \"\\n\" + instance + \"\\n\" + client\n51|}\n52|\n53|// createDescriptor derives the unbound create-interactive descriptor:\n54|// socket and instance only, because create carries no client. Same\n55|// non-persistence and length properties as the bound shape.\n56|func createDescriptor(socket, instance string) string {\n57|\treturn socket + \"\\n\" + instance\n58|}\n59|\n60|// executeAttach runs one attach: closed-shape admission, deadline,\n61|// transition, landed attach authorization, capability conferral plus\n62|// the matching-transport arm, the fast-path quiesce barrier check,\n63|// live server attestation (the P3-A wiring: a fresh decoy admission\n64|// refuses), the authoritative barrier recheck under the ordering\n65|// lock, the durable client receipt, and the caller-executed attach\n66|// vector with its descriptor. The entry returns the vector; it never\n67|// execs an interactive attach.\n68|func (lc *Lifecycle) executeAttach(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n69|\tempty := OpOutcome{Operation: terminalbackend.OperationAttach}\n70|\tbody, err := parseAttachBody(req.Body)\n71|\tif err != nil {\n72|\t\treturn empty, err\n73|\t}\n74|\tif err := checkLifecycleBackend(body.TerminalBackendID); err != nil {\n75|\t\treturn empty, err\n76|\t}\n77|\tdeadline, err := body.Deadline.Time()\n78|\tif err != nil {\n79|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body deadline\"}\n80|\t}\n81|\tif !lc.Now().Before(deadline) {\n82|\t\treturn empty, &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n83|\t}\n84|\tif _, _, err := terminalbackend.CheckTransition(string(terminalbackend.OperationAttach), req.Source, false); err != nil {\n85|\t\treturn empty, err\n86|\t}\n87|\tif err := terminalbackend.CheckAttachRequest(body.Authorization, body.Transport, body.InputAuthorized, lc.Now()); err != nil {\n88|\t\treturn empty, err\n89|\t}\n90|\tif err := terminalbackend.CheckOperation(string(terminalbackend.OperationAttach), req.Admitted); err != nil {\n91|\t\treturn empty, err\n92|\t}\n93|\tif err := checkAttachTransportCapability(body.Transport, req.Admitted); err != nil {\n94|\t\treturn empty, err\n95|\t}\n96|\tif err := lc.checkAttachQuiesced(body.TerminalInstanceID, body.InputAuthorized); err != nil {\n97|\t\treturn empty, err\n98|\t}\n99|\tif lc.ServerAdmission == nil {\n100|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle dependencies\"}\n101|\t}\n102|\t// One wait context bounds both waits below — the server\n103|\t// admission and the barrier acquisition — by the operation\n104|\t// deadline and the caller's cancellation: a deadline cancels\n105|\t// waiting, not a committed effect, and a timed-out wait\n106|\t// commits nothing late.\n107|\twaitCtx, waitCancel := lc.waitUntil(ctx, deadline)\n108|\tdefer waitCancel()\n109|\tadmission, err := lc.admitServer(waitCtx)\n110|\tif err != nil {\n111|\t\tif errors.Is(err, context.DeadlineExceeded) || errors.Is(err, context.Canceled) {\n112|\t\t\treturn empty, &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n113|\t\t}\n114|\t\treturn empty, rowError(terminalbackend.OperationAttach, err)\n115|\t}\n116|\tif err := CheckServerAttested(admission, body.BackendGeneration); err != nil {\n117|\t\treturn empty, &Error{Code: terminalbackend.CodeUnauthorized, Detail: \"attach server attestation\"}\n118|\t}\n119|\t// Ordering contract, attach side: the checks above ran before\n120|\t// the (possibly blocking) server admission and the barrier\n121|\t// lock wait, so every live fact they observed may have gone\n122|\t// stale. The effect boundary below re-observes every live\n123|\t// authorization fact under the lock immediately before the\n124|\t// receipt commit, and the lock holds through the receipt, the\n125|\t// returned vector, and the advisory memory record. The\n126|\t// enumeration, first-observed site to revalidation site:\n127|\t// closure (fast path above, rechecked here); server\n128|\t// generation (admission above, live CurrentGeneration here);\n129|\t// request deadline (entry above, live clock here — the lock\n130|\t// wait counts against the deadline, and the deadline stays\n131|\t// distinct from the authorization expiry); authorization\n132|\t// expiry, transport binding, and input binding (entry\n133|\t// CheckAttachRequest above, live clock rechecked inside the\n134|\t// commit call itself, which holds no wait between its check\n135|\t// and its no-replace install, plus the post-commit result\n136|\t// binding for input). Transition, operation capability, and\n137|\t// backend identity are pure checks over request-immutable\n138|\t// members — no live fact, nothing to revalidate. The\n139|\t// attestation value is immutable once returned; its live\n140|\t// counterpart is the generation rechecked here. The overlap\n141|\t// possibility (below) is likewise a live fact: a peer client\n142|\t// may commit between the admission and this lock, so the\n143|\t// receipt census is read here, not earlier. Residual: a\n144|\t// rotation landing between this recheck and the commit —\n145|\t// inside one process or across processes — is not excluded;\n146|\t// the window holds no waits (file I/O only). That remainder\n147|\t// is the B42 in-process scope, extended to the generation\n148|\t// and deadline rechecks.\n149|\trelease, err := lc.acquireBarrier(waitCtx)\n150|\tif err != nil {\n151|\t\treturn empty, &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n152|\t}\n153|\tdefer release()\n154|\tif err := lc.checkAttachQuiesced(body.TerminalInstanceID, body.InputAuthorized); err != nil {\n155|\t\treturn empty, err\n156|\t}\n157|\tif !lc.Now().Before(deadline) {\n158|\t\treturn empty, &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n159|\t}\n160|\tif lc.CurrentGeneration() != body.BackendGeneration {\n161|\t\treturn empty, &Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation stale\"}\n162|\t}\n163|\tif err := lc.checkAttachOverlap(body, req.Admitted); err != nil {\n164|\t\treturn empty, err\n165|\t}\n166|\treqBackend := lc.requestBackend(req, socket, body.SessionID, body.TerminalInstanceID)\n167|\treqBackend.operation = terminalbackend.OperationAttach\n168|\treqBackend.clientID = body.ClientID\n169|\treqBackend.transport = body.Transport\n170|\treqBackend.input = body.InputAuthorized\n171|\treqBackend.authRaw = body.AuthRaw\n172|\tevidenceID, err := reqBackend.PerformEffect(ctx, terminalbackend.EffectAttachClientCreated)\n173|\tif err != nil {\n174|\t\treturn empty, rowError(terminalbackend.OperationAttach, err)\n175|\t}\n176|\targv, err := BuildCommand(DirectiveAttachSession, CommandArgs{\n177|\t\tRuntimeDir:     lc.RuntimeDir,\n178|\t\tSocket:         socket,\n179|\t\tInstanceID:     body.TerminalInstanceID,\n180|\t\tAttachInput:    body.InputAuthorized,\n181|\t\tHasAttachInput: true,\n182|\t})\n183|\tif err != nil {\n184|\t\treturn empty, err\n185|\t}\n186|\tif err := terminalbackend.CheckAttachResult(body.InputAuthorized, body.InputAuthorized, body.Authorization); err != nil {\n187|\t\treturn empty, err\n188|\t}\n189|\t// Only an input-authorized attach adopts the active state: a\n190|\t// read-only attach is observation, and recording active for it\n191|\t// would reopen quiesced input (the quiesce barrier reads this\n192|\t// same memory, so observation must leave it untouched).\n193|\tif body.InputAuthorized {\n194|\t\t_ = lc.recordAfter(body.TerminalInstanceID, terminalbackend.StateActive)\n195|\t}\n196|\treturn OpOutcome{\n197|\t\tOperation: terminalbackend.OperationAttach,\n198|\t\tAttach: &AttachOutcome{\n199|\t\t\tClientMirrorID:  body.ClientID,\n200|\t\t\tDescriptor:      attachDescriptor(socket, body.TerminalInstanceID, body.ClientID),\n201|\t\t\tInputAuthorized: body.InputAuthorized,\n202|\t\t\tEvidenceIDs:     []string{evidenceID},\n203|\t\t},\n204|\t\tArgv: argv,\n205|\t}, nil\n206|}\n207|\n208|// checkAttachQuiesced enforces the quiesce input barrier at the\n209|// attach entry: tmux offers no session freeze (a locked session does\n210|// not lock subsequently attaching clients), so once a closure\n211|// report proves the input closed in the current incarnation, new\n212|// input-authorized attaches refuse the failed local precondition.\n213|// Read-only attaches stay admitted: quiesce stops input while\n214|// retaining observation. The incarnation-scoped closure proof is the\n215|// sole admission verdict: advisory memory, caller-carried source\n216|// state, and failure reporting are never consulted for their value\n217|// here, so none of them can reopen a closed barrier — a stale\n218|// active record, a failure result echoing its source, and a lost\n219|// state write all refuse exactly like the proof itself. Only a\n220|// fresh create or restore success reopens the input, by rotating\n221|// the incarnation the proof is scoped to. Store health still fails\n222|// closed: an unreadable state record is unknown, never admission,\n223|// so the memory read error propagates even though its value is\n224|// ignored. A proof read failure is likewise an error, never\n225|// admission: unknown is not a verdict.\n226|func (lc *Lifecycle) checkAttachQuiesced(instanceID string, inputAuthorized bool) error {\n227|\tif !inputAuthorized {\n228|\t\treturn nil\n229|\t}\n230|\tif _, _, err := lc.States.Lookup(instanceID); err != nil {\n231|\t\treturn err\n232|\t}\n233|\tproven, err := lc.States.QuiesceBarrierProven(instanceID)\n234|\tif err != nil {\n235|\t\treturn err\n236|\t}\n237|\tif proven {\n238|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"attach quiesced input\"}\n239|\t}\n240|\treturn nil\n241|}\n242|\n243|// admissionResult is one server-admission answer from the waiter\n244|// goroutine.\n245|type admissionResult struct {\n246|\tadmission RealmAdmission\n247|\terr       error\n248|}\n249|\n250|// admitServer runs the injected server admission under the wait\n251|// context and reports its verdict: the entry takes whichever\n252|// answers first — the admission or the deadline. The bound is\n253|// enforced, never cooperative: an adapter that ignores\n254|// cancellation still loses at the deadline, and its late answer is\n255|// discarded, never committed. The abandoned waiter send never\n256|// blocks — the channel is buffered — and its goroutine exits when\n257|// the adapter returns, so nothing here waits past the bound and\n258|// nothing commits after the caller timed out.\n259|func (lc *Lifecycle) admitServer(ctx context.Context) (RealmAdmission, error) {\n260|\t// An already-fired wait never starts its admission: the\n261|\t// request is refused deterministically instead of racing the\n262|\t// waiter goroutine against the fired context.\n263|\tif err := ctx.Err(); err != nil {\n264|\t\treturn RealmAdmission{}, err\n265|\t}\n266|\tanswered := make(chan admissionResult, 1)\n267|\tgo func() {\n268|\t\tadmission, err := lc.ServerAdmission(ctx)\n269|\t\tanswered <- admissionResult{admission: admission, err: err}\n270|\t}()\n271|\tselect {\n272|\tcase result := <-answered:\n273|\t\treturn result.admission, result.err\n274|\tcase <-ctx.Done():\n275|\t\treturn RealmAdmission{}, ctx.Err()\n276|\t}\n277|}\n278|\n279|// checkAttachOverlap enforces the §4.C attach overlap capabilities\n280|// at the effect boundary: a new client that may overlap a recorded\n281|// peer needs multi_attach, and new concurrent input over a recorded\n282|// input-authorized peer needs multiple_input_clients. Overlap cannot\n283|// be ruled out here — this leaf has no client-liveness census — so\n284|// a stored peer receipt is treated as possibly live and the gate\n285|// fails closed on the possibility. Same-client retries are exempt:\n286|// the idempotency key names the (instance, client) pair, and a\n287|// retry replays its own receipt rather than adding a client. A\n288|// peer-census read failure is an error, never admission: unknown\n289|// is not a verdict. The liveness census that refines this\n290|// receipt-inferred possibility (including detached clients whose\n291|// receipts still stand) is owned by TASK-260922-vcx6yo; until it\n292|// lands this gate stays over-strict rather than over-permissive.\n293|func (lc *Lifecycle) checkAttachOverlap(body AttachBody, admitted terminalbackend.Admitted) error {\n294|\tpeers, err := lc.Attach.Peers(body.SessionID, body.TerminalInstanceID, body.ClientID)\n295|\tif err != nil {\n296|\t\treturn err\n297|\t}\n298|\tif len(peers) == 0 {\n299|\t\treturn nil\n300|\t}\n301|\tif !admitted.Has(\"multi_attach\") {\n302|\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n303|\t}\n304|\tif !body.InputAuthorized {\n305|\t\treturn nil\n306|\t}\n307|\tfor _, peer := range peers {\n308|\t\tif peer.InputAuthorized {\n309|\t\t\tif !admitted.Has(\"multiple_input_clients\") {\n310|\t\t\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n311|\t\t\t}\n312|\t\t\treturn nil\n313|\t\t}\n314|\t}\n315|\treturn nil\n316|}\n317|\n318|// checkAttachTransportCapability enforces the matching-transport arm:\n319|// local presentation needs local_attach, mesh presentation needs\n320|// remote_attach. The relay member never reaches here — the landed\n321|// attach authorization refuses it first — so no third arm exists.\n322|func checkAttachTransportCapability(transport string, admitted terminalbackend.Admitted) error {\n323|\tswitch transport {\n324|\tcase string(terminalbackend.TransportLocalOnly):\n325|\t\tif !admitted.Has(\"local_attach\") {\n326|\t\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n327|\t\t}\n328|\tcase string(terminalbackend.TransportTrustedPrivateMesh):\n329|\t\tif !admitted.Has(\"remote_attach\") {\n330|\t\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n331|\t\t}\n332|\tdefault:\n333|\t\treturn &Error{Code: terminalbackend.CodeProtocolError, Detail: \"presentation transport vocabulary\"}\n334|\t}\n335|\treturn nil\n336|}\n337|\n338|// executeTerminate runs one terminate-stale: closed-shape admission,\n339|// idempotency material, capability conferral plus the dual conditional,\n340|// transition, force_stale authorization, generation recheck, landed\n341|// fencing authorization, deadline, receipt discipline with\n342|// status-reconciled resume, and the kill plus close-confirm effects.\n343|func (lc *Lifecycle) executeTerminate(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n344|\tempty := OpOutcome{Operation: terminalbackend.OperationTerminateStale}\n345|\tbody, err := parseTerminateBody(req.Body)\n346|\tif err != nil {\n347|\t\treturn empty, err\n348|\t}\n349|\toperation := terminalbackend.OperationTerminateStale\n350|\tmctx := body.Context\n351|\tsource := terminalbackend.InstanceState(req.Source)\n352|\tif err := checkLifecycleBackend(mctx.TerminalBackendID); err != nil {\n353|\t\treturn empty, err\n354|\t}\n355|\tderived, err := terminalbackend.IdempotencyKey(string(operation), mctx.TerminalInstanceID, \"terminate\", body.StaleLeaseID, strconv.FormatUint(body.StaleEpoch, 10))\n356|\tif err != nil {\n357|\t\treturn empty, err\n358|\t}\n359|\tif mctx.IdempotencyKey != derived {\n360|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"idempotency key material\"}\n361|\t}\n362|\tif err := terminalbackend.CheckOperation(string(operation), req.Admitted); err != nil {\n363|\t\tfailure := rowError(operation, err)\n364|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n365|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n366|\t}\n367|\tif err := checkTerminateCapability(req.Admitted); err != nil {\n368|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n369|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n370|\t}\n371|\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), false)\n372|\tif err != nil {\n373|\t\tfailure := rowError(operation, err)\n374|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n375|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n376|\t}\n377|\tif err := terminstance.CheckAuthorization(mctx.Authorization, terminstance.AuthorizationForceStale, lc.CurrentLease(), lc.Now()); err != nil {\n378|\t\tfailure := rowError(operation, err)\n379|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n380|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n381|\t}\n382|\tif lc.CurrentGeneration() != mctx.BackendGeneration {\n383|\t\tfailure := &Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation stale\"}\n384|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n385|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n386|\t}\n387|\tif err := mapFencingError(fencing.AuthorizeTerminateStale(req.Presented, req.Winner, req.HasWinner, req.ForceRecovery, req.DiagnosticsPreserved)); err != nil {\n388|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n389|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n390|\t}\n391|\tif err := checkTerminateTarget(mctx, body, req.Presented); err != nil {\n392|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n393|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n394|\t}\n395|\tif err := checkTerminateWinner(mctx, req.Winner, lc.CurrentLease()); err != nil {\n396|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n397|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n398|\t}\n399|\tdeadline, err := mctx.Deadline.Time()\n400|\tif err != nil {\n401|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"mutation context deadline\"}\n402|\t}\n403|\tif !lc.Now().Before(deadline) {\n404|\t\tfailure := &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n405|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionReplaySame)\n406|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n407|\t}\n408|\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n409|\treqBackend.operation = operation\n410|\treqBackend.deadline = deadline\n411|\treturn lc.executeWithReceipt(ctx, req, socket, operation, mctx, source, target, effects, deadline, terminstance.AuthorizationForceStale, reqBackend, func(result terminstance.Result) OpOutcome {\n412|\t\treturn OpOutcome{Operation: operation, Mutation: &result, TargetClosed: true}\n413|\t})\n414|}\n415|\n416|// checkTerminateCapability enforces the dual conditional: stale\n417|// termination needs stale_process_termination AND\n418|// provider_process_observation. Each arm refuses alone.\n419|func checkTerminateCapability(admitted terminalbackend.Admitted) error {\n420|\tif !admitted.Has(\"stale_process_termination\") {\n421|\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n422|\t}\n423|\tif !admitted.Has(\"provider_process_observation\") {\n424|\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n425|\t}\n426|\treturn nil\n427|}\n428|\n429|// mapFencingError maps the landed terminate-stale authorization onto\n430|// the row's allowed set: malformed fencing material is the protocol\n431|// error, every other fencing refusal — no winner, no force, no\n432|// diagnostics, target mismatch, live owner — is the failed local\n433|// precondition. lease_conflict maps to the precondition too: the row\n434|// has no lease_conflict member, and a target fenced by another\n435|// session's winner fails the fenced-target precondition.\n436|func mapFencingError(err error) error {\n437|\tif err == nil {\n438|\t\treturn nil\n439|\t}\n440|\tif errors.Is(err, fencing.ErrInvalidArguments) {\n441|\t\treturn &Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminate fencing material\"}\n442|\t}\n443|\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate fencing authorization\"}\n444|}\n445|\n446|// checkTerminateTarget binds the presented fencing token to the\n447|// request: session, stale lease, and stale epoch must all agree with\n448|// the context and body. Any disagreement refuses the failed local\n449|// precondition: the retry would authorize a different target than the\n450|// key names.\n451|func checkTerminateTarget(mctx terminstance.MutationContext, body TerminateBody, presented fencing.PresentedToken) error {\n452|\tif presented.SessionID != mctx.SessionID ||\n453|\t\tpresented.LeaseID != body.StaleLeaseID ||\n454|\t\tpresented.Epoch != body.StaleEpoch {\n455|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate target binding\"}\n456|\t}\n457|\treturn nil\n458|}\n459|\n460|// checkTerminateWinner binds the caller-observed winner to the\n461|// re-read current lease: the fencing authorization decides over the\n462|// caller's winner, and only a winner that still wins authorizes. A\n463|// rotated or misobserved winner refuses the failed local\n464|// precondition; the caller re-observes and retries. Absence of a\n465|// winner never reaches here — the fencing gate refuses it first.\n466|func checkTerminateWinner(mctx terminstance.MutationContext, winner sessrepo.LeaseSummary, lease terminstance.LeaseView) error {\n467|\tif winner.SessionID != mctx.SessionID ||\n468|\t\twinner.LeaseID != lease.LeaseID ||\n469|\t\twinner.Epoch != lease.Epoch {\n470|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate winner binding\"}\n471|\t}\n472|\treturn nil\n473|}\n474|\n475|// executeRestore runs one restore: closed-shape admission, idempotency\n476|// material, capability conferral plus the reboot conditional,\n477|// transition, restore authorization, generation recheck, prior-binding\n478|// mismatch, deadline, receipt discipline with status-reconciled\n479|// resume, the persist plus wrapper-restored effects, and the required\n480|// result binding. The wire result is always parked. The backend\n481|// launches no provider: the wrapper owns launch gating through the\n482|// after-restore composition (ExecuteWrapperRestore), and this entry\n483|// only recreates the wrapper process.\n484|//\n485|// The result binding is the create-time document kept alongside the\n486|// bootstrap receipt, re-admitted by termbind on the read — within one\n487|// generation — or its minted successor across a reboot: the termbind\n488|// owner succeeds the prior (the JCS identity rule stays\n489|// termbind-private) and the successor persists under the same pair\n490|// key. The prior-binding mismatch arm proves the carried prior equals\n491|// the recorded digest; the document read proves a valid binding for\n492|// this session, instance, and backend.\n493|func (lc *Lifecycle) executeRestore(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n494|\tempty := OpOutcome{Operation: terminalbackend.OperationRestore}\n495|\tbody, err := parseRestoreBody(req.Body)\n496|\tif err != nil {\n497|\t\treturn empty, err\n498|\t}\n499|\toperation := terminalbackend.OperationRestore\n500|\tmctx := body.Context\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
