{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c71b","stream":{"kind":"session","id":"01a0c9a4-cdaf-7691-9123-20534004d71c"},"sequence":488,"recorded_at":1780531400000971,"record_type":"event","durability":"durable","causation_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","run_stream":{"kind":"run","id":"7d4d0da9-54d0-407b-9491-ce60f372e27f"},"task_stream":{"kind":"task","id":"01a0c9a5-ec68-7b43-81ad-3afb957824a7"},"task_id":"01a0c9a5-ec68-7b43-81ad-3afb957824a7","event":{"kind":"output","task_id":"01a0c9a5-ec68-7b43-81ad-3afb957824a7","chunk":"Read text file `internal/tmuxserver/ops.go`.\n(499 line(s) above)\n500|\tmctx := body.Context\n501|\tsource := terminalbackend.InstanceState(req.Source)\n502|\tif err := checkLifecycleBackend(mctx.TerminalBackendID); err != nil {\n503|\t\treturn empty, err\n504|\t}\n505|\tderived, err := terminalbackend.IdempotencyKey(string(operation), mctx.SessionID, body.BootstrapOperationID)\n506|\tif err != nil {\n507|\t\treturn empty, err\n508|\t}\n509|\tif mctx.IdempotencyKey != derived {\n510|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"idempotency key material\"}\n511|\t}\n512|\tif err := terminalbackend.CheckOperation(string(operation), req.Admitted); err != nil {\n513|\t\tfailure := rowError(operation, err)\n514|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n515|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n516|\t}\n517|\tif !req.Admitted.Has(\"reboot_restoration\") {\n518|\t\tfailure := &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n519|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n520|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n521|\t}\n522|\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), false)\n523|\tif err != nil {\n524|\t\tfailure := rowError(operation, err)\n525|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n526|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n527|\t}\n528|\tif err := terminstance.CheckAuthorization(mctx.Authorization, terminstance.AuthorizationRestore, lc.CurrentLease(), lc.Now()); err != nil {\n529|\t\tfailure := rowError(operation, err)\n530|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n531|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n532|\t}\n533|\tif lc.CurrentGeneration() != mctx.BackendGeneration {\n534|\t\tfailure := &Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation stale\"}\n535|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n536|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n537|\t}\n538|\tif err := lc.checkPriorBinding(body); err != nil {\n539|\t\tvar local *Error\n540|\t\tif errors.As(err, &local) && local.Code == terminalbackend.CodeRestoreMismatch {\n541|\t\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n542|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n543|\t\t}\n544|\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n545|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n546|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n547|\t}\n548|\tdeadline, err := mctx.Deadline.Time()\n549|\tif err != nil {\n550|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"mutation context deadline\"}\n551|\t}\n552|\tif !lc.Now().Before(deadline) {\n553|\t\tfailure := &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n554|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionReplaySame)\n555|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n556|\t}\n557|\t// The prior binding validates before the receipt binds and the\n558|\t// wrapper recreates: a missing, corrupt, or disagreeing prior\n559|\t// refuses here, never after the irreversible effects.\n560|\tif _, err := lc.readRestorePrior(mctx, body); err != nil {\n561|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n562|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n563|\t}\n564|\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n565|\treqBackend.operation = operation\n566|\treqBackend.bootstrapID = body.BootstrapOperationID\n567|\t// The persist effect replays the recorded pair receipt (verified\n568|\t// by the mismatch arm above); the candidate carries the matched\n569|\t// prior digest so the store admits its shape on the replay path.\n570|\treqBackend.bindingID = body.PriorBindingID\n571|\toutcome, err := lc.executeWithReceipt(ctx, req, socket, operation, mctx, source, target, effects, deadline, terminstance.AuthorizationRestore, reqBackend, func(result terminstance.Result) OpOutcome {\n572|\t\treturn OpOutcome{Operation: operation, Mutation: &result, PriorBindingID: body.PriorBindingID, RestoredParked: true}\n573|\t})\n574|\tif err != nil {\n575|\t\treturn outcome, err\n576|\t}\n577|\tbinding, err := lc.restoreBinding(mctx, body)\n578|\tif err != nil {\n579|\t\treturn outcome, err\n580|\t}\n581|\toutcome.Binding = binding\n582|\treturn outcome, nil\n583|}\n584|\n585|// readRestorePrior reads the create-time binding document kept under\n586|// the (session, bootstrap) pair, re-admitted by the termbind owner,\n587|// and proves it names this restore's session, instance, and backend.\n588|// Generation is not compared here: after a reboot the restore carries\n589|// the new server generation while the prior still names the old one,\n590|// and succession (not agreement) resolves that drift. A missing\n591|// document is the backend store failure — the receipt proved the\n592|// prior, but the payload is gone, so the required result cannot be\n593|// built. A document that fails termbind admission, or that names\n594|// another session, instance, or backend than the mutation context, is\n595|// the integrity failure: the store disagrees with the receipt it\n596|// stands beside.\n597|func (lc *Lifecycle) readRestorePrior(mctx terminstance.MutationContext, body RestoreBody) (termbind.Binding, error) {\n598|\tempty := termbind.Binding{}\n599|\tdoc, found, err := lc.States.LookupBindingDoc(mctx.SessionID, body.BootstrapOperationID)\n600|\tif err != nil {\n601|\t\treturn empty, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n602|\t}\n603|\tif !found {\n604|\t\treturn empty, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n605|\t}\n606|\tbinding, err := termbind.ParseTerminalBinding(doc)\n607|\tif err != nil {\n608|\t\treturn empty, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n609|\t}\n610|\tif binding.SessionID != mctx.SessionID ||\n611|\t\tbinding.TerminalInstanceID != mctx.TerminalInstanceID ||\n612|\t\tbinding.TerminalBackendID != mctx.TerminalBackendID {\n613|\t\treturn empty, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n614|\t}\n615|\treturn binding, nil\n616|}\n617|\n618|// restoreBinding builds the required restore result binding after the\n619|// effects commit. Within one generation the prior is the result: the\n620|// re-admitted create-time document the pre-effects validation already\n621|// proved. Across a reboot the mutation context carries the new server\n622|// generation, and the result is the minted successor: the termbind\n623|// owner succeeds the prior (new generation, supersedes link, fresh\n624|// identity), the successor persists under the same pair key, and the\n625|// same successor returns. The mint is deterministic, so a retry after\n626|// a crash between the effects and the persist converges on the\n627|// identical document instead of forking, and a retry after the\n628|// persist replays the stored successor without minting again.\n629|func (lc *Lifecycle) restoreBinding(mctx terminstance.MutationContext, body RestoreBody) (*termbind.Binding, error) {\n630|\tprior, err := lc.readRestorePrior(mctx, body)\n631|\tif err != nil {\n632|\t\treturn nil, err\n633|\t}\n634|\tif prior.BackendGeneration == mctx.BackendGeneration {\n635|\t\treturn &prior, nil\n636|\t}\n637|\tminted, raw, err := termbind.MintSuccessorBinding(prior, mctx.BackendGeneration)\n638|\tif err != nil {\n639|\t\treturn nil, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n640|\t}\n641|\tif err := lc.States.RecordBindingDoc(mctx.SessionID, body.BootstrapOperationID, raw); err != nil {\n642|\t\treturn nil, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding write\"}\n643|\t}\n644|\treturn &minted, nil\n645|}\n646|\n647|// checkPriorBinding enforces the restore mismatch rule: the recorded\n648|// bootstrap binding for the (session, bootstrap) pair must exist and\n649|// its digest must equal the carried prior_binding_id. Substituting any\n650|// other binding — including the configured default — refuses the\n651|// restore mismatch. A binding read failure is an error, never a\n652|// mismatch: unknown is not a verdict.\n653|func (lc *Lifecycle) checkPriorBinding(body RestoreBody) error {\n654|\trecorded, found, err := lc.Bindings.Lookup(body.Context.SessionID, body.BootstrapOperationID)\n655|\tif err != nil {\n656|\t\treturn err\n657|\t}\n658|\tif !found || recorded.BindingDigest != body.PriorBindingID {\n659|\t\treturn &Error{Code: terminalbackend.CodeRestoreMismatch, Detail: \"restore prior binding\"}\n660|\t}\n661|\treturn nil\n662|}\n663|\n664|// effectPerformer executes one lifecycle side effect and reports its\n665|// evidence ID, the single capability the receipt-bound effect loop\n666|// needs from the request backend.\n667|type effectPerformer interface {\n668|\tPerformEffect(ctx context.Context, effect terminalbackend.SideEffect) (string, error)\n669|}\n670|\n671|// executeWithReceipt binds the idempotency receipt and runs the\n672|// effects under it, mirroring the engine's bind discipline: an\n673|// identical retry replays the one completion, a bound key without its\n674|// completion reconciles through the production status entry before it\n675|// refuses, and no path binds a second receipt for one key. complete\n676|// maps the successful result into the operation outcome; failures\n677|// return the outcome with the mutation set, mirroring the engine.\n678|func (lc *Lifecycle) executeWithReceipt(ctx context.Context, req OpRequest, socket string, operation terminalbackend.Operation, mctx terminstance.MutationContext, source, target terminalbackend.InstanceState, effects []terminalbackend.SideEffect, deadline time.Time, kind terminstance.AuthorizationKind, reqBackend effectPerformer, complete func(terminstance.Result) OpOutcome) (OpOutcome, error) {\n679|\tkey := mctx.IdempotencyKey\n680|\t_, replayed, err := lc.Receipts.Bind(key, operation, mctx.OperationID)\n681|\tif err != nil {\n682|\t\tif backendErrorCode(err) != \"\" {\n683|\t\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n684|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, rowError(operation, err)\n685|\t\t}\n686|\t\tif _, found, lookupErr := lc.Receipts.Lookup(key); lookupErr == nil && !found {\n687|\t\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"idempotency store failure\"}\n688|\t\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n689|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n690|\t\t}\n691|\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"idempotency store failure\"}\n692|\t\tresult := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n693|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n694|\t}\n695|\tif replayed {\n696|\t\t// A replayed success replays the stored result without\n697|\t\t// touching the incarnation: replaying an old restore\n698|\t\t// must not supersede a newer closure. Only the fresh\n699|\t\t// path rotates, after its effects commit.\n700|\t\tstored, found, err := lc.Receipts.Completed(key)\n701|\t\tif err != nil {\n702|\t\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"idempotency store failure\"}\n703|\t\t\tresult := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n704|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n705|\t\t}\n706|\t\tif !found {\n707|\t\t\treturn lc.resumeUncertain(ctx, req, socket, operation, mctx, source, target, effects, deadline, kind, reqBackend, complete)\n708|\t\t}\n709|\t\tvar result terminstance.Result\n710|\t\tif err := json.Unmarshal(stored, &result); err != nil {\n711|\t\t\tfailure := &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"idempotency result image\"}\n712|\t\t\trebuilt := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n713|\t\t\treturn OpOutcome{Operation: operation, Mutation: &rebuilt}, failure\n714|\t\t}\n715|\t\tif err := terminstance.CheckResult(mctx, source, result); err != nil {\n716|\t\t\tif backendErrorCode(err) == \"\" {\n717|\t\t\t\tfailure := &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"idempotency result image\"}\n718|\t\t\t\trebuilt := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n719|\t\t\t\treturn OpOutcome{Operation: operation, Mutation: &rebuilt}, failure\n720|\t\t\t}\n721|\t\t\trebuilt := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionFor(backendErrorCode(err), true))\n722|\t\t\treturn OpOutcome{Operation: operation, Mutation: &rebuilt}, rowError(operation, err)\n723|\t\t}\n724|\t\treturn complete(result), nil\n725|\t}\n726|\tif lc.Hooks != nil && lc.Hooks.AfterReceipt != nil {\n727|\t\tlc.Hooks.AfterReceipt(operation, key, terminstance.InterimState(operation, source))\n728|\t}\n729|\treturn lc.runLifecycleEffects(ctx, operation, mctx, source, target, effects, deadline, kind, reqBackend, complete)\n730|}\n731|\n732|// resumeUncertain reconciles a bound key without its completion through\n733|// the production status entry: when status proves the presented source\n734|// state — nothing happened — the same operation continues under the\n735|// same receipt; when status proves anything else, or fails, the retry\n736|// refuses uncertain with status_first. No path binds a second receipt\n737|// for one key.\n738|func (lc *Lifecycle) resumeUncertain(ctx context.Context, req OpRequest, socket string, operation terminalbackend.Operation, mctx terminstance.MutationContext, source, target terminalbackend.InstanceState, effects []terminalbackend.SideEffect, deadline time.Time, kind terminstance.AuthorizationKind, reqBackend effectPerformer, complete func(terminstance.Result) OpOutcome) (OpOutcome, error) {\n739|\tbody := terminstance.StatusBody{\n740|\t\tSessionID:                  mctx.SessionID,\n741|\t\tTerminalInstanceID:         mctx.TerminalInstanceID,\n742|\t\tHasTerminalInstanceID:      true,\n743|\t\tTerminalBackendID:          mctx.TerminalBackendID,\n744|\t\tImplementationVersion:      mctx.ImplementationVersion,\n745|\t\tProtocolVersion:            mctx.ProtocolVersion,\n746|\t\tBackendGeneration:          mctx.BackendGeneration,\n747|\t\tHasBackendGeneration:       true,\n748|\t\tIncludeProviderObservation: false,\n749|\t\tDeadline:                   mctx.Deadline,\n750|\t}\n751|\tstatusBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n752|\tstatusBackend.operation = terminalbackend.OperationStatus\n753|\treport, err := lc.engineFor(statusBackend).ExecuteStatus(ctx, body, source, req.Admitted)\n754|\tif err != nil || report.State != source {\n755|\t\tfailure := &Error{Code: terminalbackend.CodeUnavailable, Detail: \"idempotency result uncertain\"}\n756|\t\tresult := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n757|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n758|\t}\n759|\tif lc.Hooks != nil && lc.Hooks.AfterReceipt != nil {\n760|\t\tlc.Hooks.AfterReceipt(operation, mctx.IdempotencyKey, terminstance.InterimState(operation, source))\n761|\t}\n762|\treturn lc.runLifecycleEffects(ctx, operation, mctx, source, target, effects, deadline, kind, reqBackend, complete)\n763|}\n764|\n765|// runLifecycleEffects performs the transition's side effects under an\n766|// already-bound receipt with the per-effect deadline, authorization,\n767|// and generation gates, then completes the key exactly once — the\n768|// engine's runEffects contract, second side. Fresh and resumed runs\n769|// share this loop. On success the after-state records in the AX-side\n770|// memory and the outcome completes; every failure returns the outcome\n771|// with the mutation set, mirroring the engine.\n772|func (lc *Lifecycle) runLifecycleEffects(ctx context.Context, operation terminalbackend.Operation, mctx terminstance.MutationContext, source, target terminalbackend.InstanceState, effects []terminalbackend.SideEffect, deadline time.Time, kind terminstance.AuthorizationKind, reqBackend effectPerformer, complete func(terminstance.Result) OpOutcome) (OpOutcome, error) {\n773|\tkey := mctx.IdempotencyKey\n774|\tcommitted := false\n775|\tevidence := []string(nil)\n776|\tperformed := []terminalbackend.SideEffect(nil)\n777|\tfail := func(code, detail string) (OpOutcome, error) {\n778|\t\tafter := source\n779|\t\tif committed {\n780|\t\t\tafter = terminalbackend.StateUnavailable\n781|\t\t}\n782|\t\tfailure := &Error{Code: code, Detail: detail}\n783|\t\tresult := mutationResult(mctx, source, after, performed, evidence, terminstance.DispositionFor(code, committed))\n784|\t\tlc.recordFailure(mctx.TerminalInstanceID, after)\n785|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n786|\t}\n787|\tfor _, effect := range effects {\n788|\t\tif !lc.Now().Before(deadline) {\n789|\t\t\treturn fail(rowTimeoutCode(operation), \"operation deadline\")\n790|\t\t}\n791|\t\tif err := terminstance.CheckAuthorization(mctx.Authorization, kind, lc.CurrentLease(), lc.Now()); err != nil {\n792|\t\t\tcode := backendErrorCode(err)\n793|\t\t\tif code == \"\" {\n794|\t\t\t\tcode = terminalbackend.CodeUnauthorized\n795|\t\t\t}\n796|\t\t\treturn fail(code, \"lifecycle authorization recheck\")\n797|\t\t}\n798|\t\tif lc.CurrentGeneration() != mctx.BackendGeneration {\n799|\t\t\treturn fail(terminalbackend.CodeStaleGeneration, \"backend_generation stale\")\n800|\t\t}\n801|\t\tif lc.Hooks != nil && lc.Hooks.BeforeEffect != nil {\n802|\t\t\tlc.Hooks.BeforeEffect(effect)\n803|\t\t}\n804|\t\tevidenceID, err := reqBackend.PerformEffect(ctx, effect)\n805|\t\tif lc.Hooks != nil && lc.Hooks.AfterEffect != nil {\n806|\t\t\tlc.Hooks.AfterEffect(effect)\n807|\t\t}\n808|\t\tif err != nil {\n809|\t\t\tcode := backendErrorCode(err)\n810|\t\t\tif code == \"\" {\n811|\t\t\t\treturn fail(terminstance.CodeProcessFailed, \"backend effect uncertain\")\n812|\t\t\t}\n813|\t\t\tif checkErr := terminalbackend.CheckErrorAllowed(string(operation), code); checkErr != nil {\n814|\t\t\t\treturn fail(terminalbackend.CodeProtocolError, \"operation error vocabulary\")\n815|\t\t\t}\n816|\t\t\treturn fail(code, \"backend effect refused\")\n817|\t\t}\n818|\t\tif _, err := scalar.ParseDigest(evidenceID); err != nil {\n819|\t\t\treturn fail(terminalbackend.CodeIntegrityFailure, \"backend effect evidence\")\n820|\t\t}\n821|\t\tcommitted = true\n822|\t\tperformed = append(performed, effect)\n823|\t\tevidence = append(evidence, evidenceID)\n824|\t}\n825|\tresult := mutationResult(mctx, source, target, performed, evidence, terminstance.DispositionReplaySame)\n826|\tencoded, err := json.Marshal(result)\n827|\tif err != nil {\n828|\t\tfailure := &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"idempotency result image\"}\n829|\t\tresult.Disposition = terminstance.DispositionStatusFirst\n830|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n831|\t}\n832|\tif err := lc.Receipts.Complete(key, encoded); err != nil {\n833|\t\tif backendErrorCode(err) == \"\" {\n834|\t\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"idempotency store failure\"}\n835|\t\t\tresult.Disposition = terminstance.DispositionStatusFirst\n836|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n837|\t\t}\n838|\t\tresult.Disposition = terminstance.DispositionStatusFirst\n839|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, rowError(operation, err)\n840|\t}\n841|\tif operation == terminalbackend.OperationRestore {\n842|\t\t// A fresh restore success opens a new incarnation like a\n843|\t\t// fresh create: prior closure reports are superseded.\n844|\t\t// Terminate-stale never rotates — it closes the\n845|\t\t// incarnation toward stopped, which admits no attach —\n846|\t\t// and a failed rotation fails the operation closed.\n847|\t\tif err := lc.States.RecordIncarnation(mctx.TerminalInstanceID, key); err != nil {\n848|\t\t\tfailure := &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore incarnation image\"}\n849|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n850|\t\t}\n851|\t}\n852|\t_ = lc.recordAfter(mctx.TerminalInstanceID, target)\n853|\treturn complete(result), nil\n854|}\n855|\n856|// rowTimeoutCode reports the §4.C timeout vocabulary per operation\n857|// row: the wait row times out quiesce_timeout and the stop row\n858|// stop_timeout, while every other row times out\n859|// terminal_backend_timeout. This mirrors the landed engine's\n860|// per-row mapping for the operations the engine scope leaves out\n861|// and the within-effect revalidation; the literals are pinned by\n862|// the row tests, never derived from the engine constant.\n863|func rowTimeoutCode(operation terminalbackend.Operation) string {\n864|\tswitch operation {\n865|\tcase terminalbackend.OperationWaitSafeBoundary:\n866|\t\treturn terminstance.CodeQuiesceTimeout\n867|\tcase terminalbackend.OperationRequestStop:\n868|\t\treturn terminstance.CodeStopTimeout\n869|\tdefault:\n870|\t\treturn terminstance.CodeTimeout\n871|\t}\n872|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c71d","stream":{"kind":"session","id":"01a0c9a4-cdaf-7691-9123-20534004d71c"},"sequence":489,"recorded_at":1780531400000973,"record_type":"event","durability":"durable","causation_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","run_stream":{"kind":"run","id":"7d4d0da9-54d0-407b-9491-ce60f372e27f"},"task_stream":{"kind":"task","id":"01a0c9a5-ec68-7b43-81ad-3afb957824a7"},"task_id":"01a0c9a5-ec68-7b43-81ad-3afb957824a7","event":{"kind":"completed","task_id":"01a0c9a5-ec68-7b43-81ad-3afb957824a7"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c71f","stream":{"kind":"session","id":"01a0c9a4-cdaf-7691-9123-20534004d71c"},"sequence":490,"recorded_at":1780531400000975,"record_type":"event","durability":"durable","causation_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","run_stream":{"kind":"run","id":"7d4d0da9-54d0-407b-9491-ce60f372e27f"},"task_stream":{"kind":"task","id":"01a0c9a5-ec89-7801-bfa5-cca84ea44207"},"task_id":"01a0c9a5-ec89-7801-bfa5-cca84ea44207","event":{"kind":"output","task_id":"01a0c9a5-ec89-7801-bfa5-cca84ea44207","chunk":"Read text file `internal/tmuxserver/backend.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"errors\"\n6|\t\"strconv\"\n7|\t\"strings\"\n8|\t\"time\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n15|)\n16|\n17|// operationDirectives is the exact lifecycle-to-tmux mapping: every\n18|// operation executes a fixed directive sequence and no other tmux\n19|// command. The table is the contract; the drivers below execute it.\n20|// The boundary list-panes member is conditional: it runs only for\n21|// provider proof kinds, binding contemporaneous provider rows into\n22|// the boundary evidence, and never fails the observation.\n23|var operationDirectives = map[terminalbackend.Operation][]Directive{\n24|\tterminalbackend.OperationCreate:           {DirectiveNewSession},\n25|\tterminalbackend.OperationAttach:           {DirectiveAttachSession},\n26|\tterminalbackend.OperationStatus:           {DirectiveListPanes, DirectiveListSessions},\n27|\tterminalbackend.OperationQuiesceInput:     {DirectiveLockSession, DirectiveDetachClients},\n28|\tterminalbackend.OperationWaitSafeBoundary: {DirectiveWaitBoundary, DirectiveListPanes},\n29|\tterminalbackend.OperationRequestStop:      {DirectiveSendInterrupt, DirectiveHasSession, DirectiveKillSession, DirectiveHasSession},\n30|\tterminalbackend.OperationTerminateStale:   {DirectiveKillSession, DirectiveHasSession},\n31|\tterminalbackend.OperationRestore:          {DirectiveNewSession},\n32|}\n33|\n34|// DirectivesFor reports the fixed tmux directive sequence for one\n35|// lifecycle operation. Manifest and probe are not lifecycle operations\n36|// and refuse; every other unknown operation refuses as well.\n37|func DirectivesFor(operation terminalbackend.Operation) ([]Directive, error) {\n38|\tdirectives, known := operationDirectives[operation]\n39|\tif !known {\n40|\t\treturn nil, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle operation\"}\n41|\t}\n42|\treturn append([]Directive(nil), directives...), nil\n43|}\n44|\n45|// backend is the tmux terminstance.Backend: side-effect execution and\n46|// status observation over the structured commands. It is\n47|// request-scoped — one backend per Execute call — because effects\n48|// carry no identity of their own and the runner, socket, stores, and\n49|// admission are per-request facts.\n50|type backend struct {\n51|\trunner      Runner\n52|\truntimeDir  string\n53|\tsocket      string\n54|\toperation   terminalbackend.Operation\n55|\tsessionID   string\n56|\tinstanceID  string\n57|\tbootstrapID string\n58|\tbindingID   string\n59|\tbindingDoc  []byte\n60|\tchannel     string\n61|\tquiescence  string\n62|\tproofKind   terminstance.ProviderProofKind\n63|\twaitCtx     context.Context\n64|\tdeadline    time.Time\n65|\t// recheck revalidates the live authorization facts (operation\n66|\t// deadline, AX authorization over the current lease, server\n67|\t// generation) at a destructive command boundary that follows a\n68|\t// wait. The lifecycle entry builds it over the same landed\n69|\t// gates the engine's per-effect loop applies; paths whose\n70|\t// effects issue no destructive command after any wait leave it\n71|\t// nil. A nil recheck at a guarded boundary refuses instead of\n72|\t// running blind: the backend never issues a post-wait\n73|\t// destructive command without its revalidation.\n74|\trecheck   func() error\n75|\tnow       func() time.Time\n76|\tsleep     func(time.Duration)\n77|\tpoll      time.Duration\n78|\tadmitted  terminalbackend.Admitted\n79|\tbindings  *axpane.Store\n80|\tattach    *termbind.AttachStore\n81|\tstates    *InstanceStates\n82|\ttransport string\n83|\tinput     bool\n84|\tauthRaw   []byte\n85|\tclientID  string\n86|\t// killExit records the stale-kill exit for the close re-confirm:\n87|\t// a live session after a clean kill and a live session after a\n88|\t// failed kill refuse through the same arm, and the recorded exit\n89|\t// is the member split the narrowing mutant admits exactly one of.\n90|\t// -1 means no kill ran yet on this backend.\n91|\tkillExit int\n92|}\n93|\n94|// effectEvidence derives one evidence digest over the canonical effect\n95|// record: effect name, operation, instance, and outcome facts. The join\n96|// is deterministic; nothing parses it back.\n97|func effectEvidence(effect terminalbackend.SideEffect, operation terminalbackend.Operation, instance string, facts ...string) string {\n98|\trecord := strings.Join(append([]string{string(effect), string(operation), instance}, facts...), \"\\n\")\n99|\treturn scalar.SHA256Digest([]byte(record)).String()\n100|}\n101|\n102|// PerformEffect executes one side effect and reports its evidence ID.\n103|// A nil error proves the commit; a coded error proves the backend\n104|// refused before committing; any other error proves nothing. Every\n105|// tmux command runs through BuildCommand, so no effect addresses any\n106|// server but the derived socket.\n107|func (runner *backend) PerformEffect(ctx context.Context, effect terminalbackend.SideEffect) (string, error) {\n108|\tswitch effect {\n109|\tcase terminalbackend.EffectBindingPersisted:\n110|\t\treturn runner.persistBinding()\n111|\tcase terminalbackend.EffectWrapperStarted:\n112|\t\treturn runner.startWrapper(ctx, terminalbackend.EffectWrapperStarted)\n113|\tcase terminalbackend.EffectAttachClientCreated:\n114|\t\treturn runner.createAttachClient()\n115|\tcase terminalbackend.EffectInputClosed:\n116|\t\treturn runner.closeInput(ctx)\n117|\tcase terminalbackend.EffectSafeBoundaryObserved:\n118|\t\treturn runner.observeBoundary()\n119|\tcase terminalbackend.EffectGracefulStopRequested:\n120|\t\treturn runner.execEvidence(ctx, DirectiveSendInterrupt, terminalbackend.EffectGracefulStopRequested)\n121|\tcase terminalbackend.EffectProcessClosed:\n122|\t\treturn runner.confirmClosed(ctx)\n123|\tcase terminalbackend.EffectBackendStoreClosed:\n124|\t\treturn effectEvidence(effect, runner.operation, runner.instanceID, \"tmux-side closes done\"), nil\n125|\tcase terminalbackend.EffectStaleIncarnationTerminated:\n126|\t\treturn runner.terminateStale(ctx)\n127|\tcase terminalbackend.EffectWrapperRestored:\n128|\t\treturn runner.startWrapper(ctx, terminalbackend.EffectWrapperRestored)\n129|\tdefault:\n130|\t\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend effect vocabulary\"}\n131|\t}\n132|}\n133|\n134|// persistBinding records the bootstrap binding for the create/restore\n135|// pair. A changed operation in the bootstrap window refuses the landed\n136|// idempotency_mismatch; an identical retry replays the one receipt.\n137|// On create the carried binding document is kept alongside the\n138|// receipt, so restore can return the required binding without\n139|// minting; a replayed receipt heals a missing document from the same\n140|// carried bytes, closing the crash window between receipt and\n141|// document.\n142|func (runner *backend) persistBinding() (string, error) {\n143|\tif runner.bindings == nil {\n144|\t\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend binding store\"}\n145|\t}\n146|\trecorded, replayed, err := runner.bindings.Bind(runner.sessionID, runner.bootstrapID, axpane.Binding{\n147|\t\tSessionID:          runner.sessionID,\n148|\t\tOperationID:        runner.bootstrapID,\n149|\t\tTerminalInstanceID: runner.instanceID,\n150|\t\tBindingDigest:      runner.bindingID,\n151|\t})\n152|\tif err != nil {\n153|\t\tif code := backendErrorCode(err); code != \"\" {\n154|\t\t\treturn \"\", &terminstance.Error{Code: code, Detail: \"backend binding conflict\"}\n155|\t\t}\n156|\t\treturn \"\", err\n157|\t}\n158|\tif len(runner.bindingDoc) > 0 && runner.states != nil {\n159|\t\tif !replayed {\n160|\t\t\tif err := runner.states.RecordBindingDoc(runner.sessionID, runner.bootstrapID, runner.bindingDoc); err != nil {\n161|\t\t\t\treturn \"\", err\n162|\t\t\t}\n163|\t\t} else if _, found, err := runner.states.LookupBindingDoc(runner.sessionID, runner.bootstrapID); err != nil {\n164|\t\t\treturn \"\", err\n165|\t\t} else if !found {\n166|\t\t\tif err := runner.states.RecordBindingDoc(runner.sessionID, runner.bootstrapID, runner.bindingDoc); err != nil {\n167|\t\t\t\treturn \"\", err\n168|\t\t\t}\n169|\t\t}\n170|\t}\n171|\treturn recorded.BindingDigest, nil\n172|}\n173|\n174|// closeInput cuts operator input to the instance: lock-session first,\n175|// so attached clients cannot type into the pane during the detach\n176|// window, then detach-client -s, which detaches every client\n177|// currently attached to the session. A locked session does not lock\n178|// subsequently attaching clients (verified on tmux 3.6a), so new\n179|// input-authorized attaches are refused AX-side at the attach entry\n180|// once the quiescing state records; read-only attaches stay admitted\n181|// because quiesce retains observation. Provider input enters only\n182|// through the request-stop effect (the ordered next step), so no\n183|// send-keys runs here. Both commands must exit clean; the evidence\n184|// binds both exits. The detach is a second destructive command after\n185|// the lock's round trip, so the boundary between them revalidates\n186|// the authorization facts the engine checked before the effect: a\n187|// generation rotated, authorization lapsed, or deadline passed\n188|// during the lock refuses before the detach issues.\n189|func (runner *backend) closeInput(ctx context.Context) (string, error) {\n190|\tfor i, directive := range []Directive{DirectiveLockSession, DirectiveDetachClients} {\n191|\t\tif i > 0 {\n192|\t\t\tif err := runner.recheckPostWait(); err != nil {\n193|\t\t\t\treturn \"\", err\n194|\t\t\t}\n195|\t\t}\n196|\t\targv, err := runner.command(directive)\n197|\t\tif err != nil {\n198|\t\t\treturn \"\", err\n199|\t\t}\n200|\t\tresult, err := runner.runner.Run(ctx, argv)\n201|\t\tif err != nil {\n202|\t\t\treturn \"\", err\n203|\t\t}\n204|\t\tif result.ExitCode != 0 {\n205|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n206|\t\t}\n207|\t}\n208|\treturn effectEvidence(terminalbackend.EffectInputClosed, runner.operation, runner.instanceID, \"locked\", \"detached\"), nil\n209|}\n210|\n211|// recheckPostWait runs the entry-configured authorization\n212|// revalidation at a destructive command boundary that follows a\n213|// wait. A missing revalidation refuses: the boundary never runs\n214|// blind.\n215|func (runner *backend) recheckPostWait() error {\n216|\tif runner.recheck == nil {\n217|\t\treturn &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend authorization recheck\"}\n218|\t}\n219|\treturn runner.recheck()\n220|}\n221|\n222|// startWrapper execs the instance new-session vector for create\n223|// (wrapper_started) and restore (wrapper_restored).\n224|func (runner *backend) startWrapper(ctx context.Context, effect terminalbackend.SideEffect) (string, error) {\n225|\treturn runner.execEvidence(ctx, DirectiveNewSession, effect)\n226|}\n227|\n228|// createAttachClient records the presentation client receipt for one\n229|// (instance, client) pair. Every call requires the valid unexpired\n230|// attach authorization the attach handler already admitted; the store\n231|// rechecks it, so a timeout creates no authorized input unless the\n232|// durable receipt says so.\n233|func (runner *backend) createAttachClient() (string, error) {\n234|\tif runner.attach == nil {\n235|\t\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend attach store\"}\n236|\t}\n237|\treceipt, _, err := runner.attach.Attach(runner.sessionID, runner.instanceID, runner.clientID, runner.transport, runner.input, runner.authRaw, runner.now())\n238|\tif err != nil {\n239|\t\tif code := backendErrorCode(err); code != \"\" {\n240|\t\t\treturn \"\", &terminstance.Error{Code: code, Detail: \"backend attach conflict\"}\n241|\t\t}\n242|\t\treturn \"\", err\n243|\t}\n244|\treturn effectEvidence(terminalbackend.EffectAttachClientCreated, runner.operation, runner.instanceID, receipt.ClientID, receipt.Transport), nil\n245|}\n246|\n247|// execEvidence runs one directive and evidences its success. A nonzero\n248|// exit is a coded process failure: the command ran and the effect did\n249|// not commit. A transport error is uncoded: it proves nothing.\n250|func (runner *backend) execEvidence(ctx context.Context, directive Directive, effect terminalbackend.SideEffect) (string, error) {\n251|\targv, err := runner.command(directive)\n252|\tif err != nil {\n253|\t\treturn \"\", err\n254|\t}\n255|\tresult, err := runner.runner.Run(ctx, argv)\n256|\tif err != nil {\n257|\t\treturn \"\", err\n258|\t}\n259|\tif result.ExitCode != 0 {\n260|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n261|\t}\n262|\treturn effectEvidence(effect, runner.operation, runner.instanceID, strconv.Itoa(result.ExitCode)), nil\n263|}\n264|\n265|// observeBoundary waits for the wrapper's safe-boundary signal on the\n266|// quiescence channel with the bare blocking `wait-for` vector. The\n267|// wait context already bounds the lesser of the request deadline and\n268|// the timeout; its expiry is the coded quiesce_timeout proving\n269|// non-commit, never a silent continue. The requested provider proof\n270|// kind is bound into the evidence, so each kind proves its own\n271|// boundary and an identical retry replays the same proof. For\n272|// provider proof kinds the contemporaneous provider rows are bound\n273|// alongside: the signal is the proof, the rows are audit context,\n274|// and a failed row read binds its negative instead of failing the\n275|// observed proof.\n276|func (runner *backend) observeBoundary() (string, error) {\n277|\targv, err := runner.command(DirectiveWaitBoundary)\n278|\tif err != nil {\n279|\t\treturn \"\", err\n280|\t}\n281|\tresult, err := runner.runner.Run(runner.waitCtx, argv)\n282|\tif err != nil {\n283|\t\tif runner.waitCtx.Err() != nil {\n284|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeQuiesceTimeout, Detail: \"backend boundary wait\"}\n285|\t\t}\n286|\t\treturn \"\", err\n287|\t}\n288|\tif result.ExitCode != 0 {\n289|\t\tif runner.waitCtx.Err() != nil {\n290|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeQuiesceTimeout, Detail: \"backend boundary wait\"}\n291|\t\t}\n292|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n293|\t}\n294|\tobserved, err := runner.now().UTC().MarshalText()\n295|\tif err != nil {\n296|\t\treturn \"\", err\n297|\t}\n298|\tfacts := []string{string(runner.proofKind), runner.channel, string(observed)}\n299|\tif terminstance.RequiresProviderObservation(runner.proofKind) {\n300|\t\tfacts = append(facts, runner.boundaryProviderRows())\n301|\t}\n302|\treturn effectEvidence(terminalbackend.EffectSafeBoundaryObserved, runner.operation, runner.instanceID, facts...), nil\n303|}\n304|\n305|// boundaryProviderRows reads the contemporaneous provider rows for a\n306|// provider-kind boundary as bound context. Presence binds the row\n307|// set; absence binds the negative; a failed read binds unknown. The\n308|// verdict never fails: the wrapper signal already proved the\n309|// boundary, and a post-signal crash must not discard that proof.\n310|func (runner *backend) boundaryProviderRows() string {\n311|\tctx := runner.waitCtx\n312|\tif ctx == nil {\n313|\t\tctx = context.Background()\n314|\t}\n315|\tpresent, rows, err := runner.probePanes(ctx, runner.instanceID)\n316|\tif err != nil {\n317|\t\treturn \"provider:unknown\"\n318|\t}\n319|\tif !present {\n320|\t\treturn \"provider:absent\"\n321|\t}\n322|\treturn \"provider:\" + strings.Join(rows, \"\\n\")\n323|}\n324|\n325|// Absence stderr markers, verified against tmux 3.6a. has-session\n326|// against a missing session reports `can't find session`; list-panes\n327|// against a missing target reports `can't find window`; either\n328|// command against a missing server socket reports `error connecting\n329|// to <socket> (No such file or directory)`. Under a derived and\n330|// custody-verified socket, a missing socket proves no listener and\n331|// therefore no session. Every tmux failure exits 1, so the exit code\n332|// alone proves nothing: only these marker-paired exits prove\n333|// absence. Unrecognized stderr — permission failures, refused\n334|// connections, version-drifted strings — fails closed to unknown.\n335|const (\n336|\tabsentMarkerNoSession = \"can't find session\"\n337|\tabsentMarkerNoWindow  = \"can't find window\"\n338|\tabsentMarkerNoSocket  = \"No such file or directory\"\n339|\tabsentMarkerNoConnect = \"error connecting to\"\n340|)\n341|\n342|// errProbeUnknown is the uncoded unknown-probe signal: the probe ran\n343|// (or never answered) without proving presence or absence. Callers\n344|// return it verbatim; the engine and the lifecycle effect loop map\n345|// uncoded backend failures to the row-allowed process failure with\n346|// status_first and the unavailable observation, never to a verdict.\n347|var errProbeUnknown = errors.New(\"tmux probe proves neither presence nor absence\")\n348|\n349|// classifyAbsence sorts one probe run into present, absent, or\n350|// unknown. Exit 0 is present. A negative exit (a killed child that a\n351|// runner reported as data) is unknown, never absent. A positive exit\n352|// proves absence only with an absence marker on stderr; without one\n353|// it is unknown. Callers pass the markers their command emits.\n354|func classifyAbsence(result RunResult, markers ...string) (present, absent bool) {\n355|\tif result.ExitCode == 0 {\n356|\t\treturn true, false\n357|\t}\n358|\tif result.ExitCode < 0 {\n359|\t\treturn false, false\n360|\t}\n361|\tstderr := string(result.Stderr)\n362|\tfor _, marker := range markers {\n363|\t\tif marker == absentMarkerNoSocket {\n364|\t\t\tif strings.Contains(stderr, absentMarkerNoConnect) && strings.Contains(stderr, absentMarkerNoSocket) {\n365|\t\t\t\treturn false, true\n366|\t\t\t}\n367|\t\t\tcontinue\n368|\t\t}\n369|\t\tif strings.Contains(stderr, marker) {\n370|\t\t\treturn false, true\n371|\t\t}\n372|\t}\n373|\treturn false, false\n374|}\n375|\n376|// confirmClosed proves process closure for request-stop and\n377|// terminate-stale. Positively observed absence (has-session exit with\n378|// the no-session marker, or no server socket under the verified\n379|// path) is the proof. A live session on request-stop escalates once\n380|// to kill-session and re-confirms; a still-live session is the coded\n381|// stop_timeout. An unproven session — transport failure, killed\n382|// probe, or unmarked nonzero exit — is unknown at the deadline, never\n383|// closure. A live session on terminate-stale is the coded process\n384|// failure: the kill claimed the incarnation and it still answers.\n385|// The confirm polls to the deadline before it concludes anything.\n386|//\n387|// The stop escalation is a new destructive command after the poll\n388|// wait, so the poll bound (the graceful wait) expiring is exactly\n389|// when the other authorization facts must be re-proved: the\n390|// escalation revalidates the operation deadline, the AX\n391|// authorization over the current lease, and the server generation\n392|// before the kill issues. A graceful timeout escalates — the wait\n393|// did its job — but an operation deadline passed, an authorization\n394|// lapsed, or a generation rotated during the poll refuses without\n395|// issuing the kill. The terminate-stale tail issues no command\n396|// after its poll, so it carries no revalidation: its refusal\n397|// stands however the facts moved.\n398|func (runner *backend) confirmClosed(ctx context.Context) (string, error) {\n399|\tabsent, err := runner.pollSession(ctx)\n400|\tif err != nil {\n401|\t\treturn \"\", err\n402|\t}\n403|\tif absent {\n404|\t\treturn effectEvidence(terminalbackend.EffectProcessClosed, runner.operation, runner.instanceID, \"absent\"), nil\n405|\t}\n406|\tif runner.operation == terminalbackend.OperationRequestStop {\n407|\t\tif err := runner.recheckPostWait(); err != nil {\n408|\t\t\treturn \"\", err\n409|\t\t}\n410|\t\targv, err := runner.command(DirectiveKillSession)\n411|\t\tif err != nil {\n412|\t\t\treturn \"\", err\n413|\t\t}\n414|\t\tif result, err := runner.runner.Run(ctx, argv); err != nil {\n415|\t\t\treturn \"\", err\n416|\t\t} else if result.ExitCode != 0 {\n417|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n418|\t\t}\n419|\t\tabsent, err := runner.pollSession(ctx)\n420|\t\tif err != nil {\n421|\t\t\treturn \"\", err\n422|\t\t}\n423|\t\tif absent {\n424|\t\t\treturn effectEvidence(terminalbackend.EffectProcessClosed, runner.operation, runner.instanceID, \"escalated\"), nil\n425|\t\t}\n426|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeStopTimeout, Detail: \"backend stop wait\"}\n427|\t}\n428|\t// Terminate-stale re-confirm: a live session refuses whether the kill\n429|\t// exited clean or failed — the kill claimed the incarnation and it\n430|\t// still answers. The exit split names both members so each refuses\n431|\t// explicitly; the narrowing mutant admits exactly the failed-kill\n432|\t// member.\n433|\tif runner.killExit != 0 {\n434|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n435|\t}\n436|\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n437|}\n438|\n439|// pollSession probes has-session until the session is absent or the\n440|// deadline passes. Presence polls on; absence returns at once; an\n441|// unproven probe (transport failure, killed child, unmarked exit)\n442|// polls on until the deadline and then reports unknown, never\n443|// closure. Cancellation aborts at once.\n444|func (runner *backend) pollSession(ctx context.Context) (bool, error) {\n445|\tfor {\n446|\t\tif ctx != nil && ctx.Err() != nil {\n447|\t\t\treturn false, ctx.Err()\n448|\t\t}\n449|\t\targv, err := runner.command(DirectiveHasSession)\n450|\t\tif err != nil {\n451|\t\t\treturn false, err\n452|\t\t}\n453|\t\tresult, err := runner.runner.Run(ctx, argv)\n454|\t\tif err != nil {\n455|\t\t\tif !runner.now().Before(runner.deadline) {\n456|\t\t\t\treturn false, errProbeUnknown\n457|\t\t\t}\n458|\t\t\trunner.sleep(runner.poll)\n459|\t\t\tcontinue\n460|\t\t}\n461|\t\tpresent, absent := classifyAbsence(result, absentMarkerNoSession, absentMarkerNoSocket)\n462|\t\tif absent {\n463|\t\t\treturn true, nil\n464|\t\t}\n465|\t\tif !present {\n466|\t\t\tif !runner.now().Before(runner.deadline) {\n467|\t\t\t\treturn false, errProbeUnknown\n468|\t\t\t}\n469|\t\t\trunner.sleep(runner.poll)\n470|\t\t\tcontinue\n471|\t\t}\n472|\t\tif !runner.now().Before(runner.deadline) {\n473|\t\t\treturn false, nil\n474|\t\t}\n475|\t\trunner.sleep(runner.poll)\n476|\t}\n477|}\n478|\n479|// terminateStale kills the fenced stale incarnation session. A clean\n480|// kill proves termination; a failed kill self-confirms — a\n481|// positively absent session is terminated however it closed — and\n482|// only a live session after a failed kill is the coded process\n483|// failure. An unproven confirm is unknown, never termination.\n484|func (runner *backend) terminateStale(ctx context.Context) (string, error) {\n485|\targv, err := runner.command(DirectiveKillSession)\n486|\tif err != nil {\n487|\t\treturn \"\", err\n488|\t}\n489|\tresult, err := runner.runner.Run(ctx, argv)\n490|\tif err != nil {\n491|\t\treturn \"\", err\n492|\t}\n493|\trunner.killExit = result.ExitCode\n494|\tif result.ExitCode == 0 {\n495|\t\treturn effectEvidence(terminalbackend.EffectStaleIncarnationTerminated, runner.operation, runner.instanceID, \"killed\"), nil\n496|\t}\n497|\tconfirm, err := runner.command(DirectiveHasSession)\n498|\tif err != nil {\n499|\t\treturn \"\", err\n500|\t}\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c721","stream":{"kind":"session","id":"01a0c9a4-cdaf-7691-9123-20534004d71c"},"sequence":491,"recorded_at":1780531400000977,"record_type":"event","durability":"durable","causation_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","run_stream":{"kind":"run","id":"7d4d0da9-54d0-407b-9491-ce60f372e27f"},"task_stream":{"kind":"task","id":"01a0c9a5-ec89-7801-bfa5-cca84ea44207"},"task_id":"01a0c9a5-ec89-7801-bfa5-cca84ea44207","event":{"kind":"completed","task_id":"01a0c9a5-ec89-7801-bfa5-cca84ea44207"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c723","stream":{"kind":"session","id":"01a0c9a4-cdaf-7691-9123-20534004d71c"},"sequence":492,"recorded_at":1780531400000979,"record_type":"event","durability":"durable","causation_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","run_stream":{"kind":"run","id":"7d4d0da9-54d0-407b-9491-ce60f372e27f"},"call_id":"call_01a0c9a5e8bf776d87be03ca484a4779","text":"Read text file `internal/tmuxserver/ops.go`.\n(499 line(s) above)\n500|\tmctx := body.Context\n501|\tsource := terminalbackend.InstanceState(req.Source)\n502|\tif err := checkLifecycleBackend(mctx.TerminalBackendID); err != nil {\n503|\t\treturn empty, err\n504|\t}\n505|\tderived, err := terminalbackend.IdempotencyKey(string(operation), mctx.SessionID, body.BootstrapOperationID)\n506|\tif err != nil {\n507|\t\treturn empty, err\n508|\t}\n509|\tif mctx.IdempotencyKey != derived {\n510|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"idempotency key material\"}\n511|\t}\n512|\tif err := terminalbackend.CheckOperation(string(operation), req.Admitted); err != nil {\n513|\t\tfailure := rowError(operation, err)\n514|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n515|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n516|\t}\n517|\tif !req.Admitted.Has(\"reboot_restoration\") {\n518|\t\tfailure := &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n519|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n520|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n521|\t}\n522|\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), false)\n523|\tif err != nil {\n524|\t\tfailure := rowError(operation, err)\n525|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n526|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n527|\t}\n528|\tif err := terminstance.CheckAuthorization(mctx.Authorization, terminstance.AuthorizationRestore, lc.CurrentLease(), lc.Now()); err != nil {\n529|\t\tfailure := rowError(operation, err)\n530|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n531|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n532|\t}\n533|\tif lc.CurrentGeneration() != mctx.BackendGeneration {\n534|\t\tfailure := &Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation stale\"}\n535|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n536|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n537|\t}\n538|\tif err := lc.checkPriorBinding(body); err != nil {\n539|\t\tvar local *Error\n540|\t\tif errors.As(err, &local) && local.Code == terminalbackend.CodeRestoreMismatch {\n541|\t\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n542|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n543|\t\t}\n544|\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n545|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n546|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n547|\t}\n548|\tdeadline, err := mctx.Deadline.Time()\n549|\tif err != nil {\n550|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"mutation context deadline\"}\n551|\t}\n552|\tif !lc.Now().Before(deadline) {\n553|\t\tfailure := &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n554|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionReplaySame)\n555|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n556|\t}\n557|\t// The prior binding validates before the receipt binds and the\n558|\t// wrapper recreates: a missing, corrupt, or disagreeing prior\n559|\t// refuses here, never after the irreversible effects.\n560|\tif _, err := lc.readRestorePrior(mctx, body); err != nil {\n561|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n562|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n563|\t}\n564|\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n565|\treqBackend.operation = operation\n566|\treqBackend.bootstrapID = body.BootstrapOperationID\n567|\t// The persist effect replays the recorded pair receipt (verified\n568|\t// by the mismatch arm above); the candidate carries the matched\n569|\t// prior digest so the store admits its shape on the replay path.\n570|\treqBackend.bindingID = body.PriorBindingID\n571|\toutcome, err := lc.executeWithReceipt(ctx, req, socket, operation, mctx, source, target, effects, deadline, terminstance.AuthorizationRestore, reqBackend, func(result terminstance.Result) OpOutcome {\n572|\t\treturn OpOutcome{Operation: operation, Mutation: &result, PriorBindingID: body.PriorBindingID, RestoredParked: true}\n573|\t})\n574|\tif err != nil {\n575|\t\treturn outcome, err\n576|\t}\n577|\tbinding, err := lc.restoreBinding(mctx, body)\n578|\tif err != nil {\n579|\t\treturn outcome, err\n580|\t}\n581|\toutcome.Binding = binding\n582|\treturn outcome, nil\n583|}\n584|\n585|// readRestorePrior reads the create-time binding document kept under\n586|// the (session, bootstrap) pair, re-admitted by the termbind owner,\n587|// and proves it names this restore's session, instance, and backend.\n588|// Generation is not compared here: after a reboot the restore carries\n589|// the new server generation while the prior still names the old one,\n590|// and succession (not agreement) resolves that drift. A missing\n591|// document is the backend store failure — the receipt proved the\n592|// prior, but the payload is gone, so the required result cannot be\n593|// built. A document that fails termbind admission, or that names\n594|// another session, instance, or backend than the mutation context, is\n595|// the integrity failure: the store disagrees with the receipt it\n596|// stands beside.\n597|func (lc *Lifecycle) readRestorePrior(mctx terminstance.MutationContext, body RestoreBody) (termbind.Binding, error) {\n598|\tempty := termbind.Binding{}\n599|\tdoc, found, err := lc.States.LookupBindingDoc(mctx.SessionID, body.BootstrapOperationID)\n600|\tif err != nil {\n601|\t\treturn empty, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n602|\t}\n603|\tif !found {\n604|\t\treturn empty, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n605|\t}\n606|\tbinding, err := termbind.ParseTerminalBinding(doc)\n607|\tif err != nil {\n608|\t\treturn empty, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n609|\t}\n610|\tif binding.SessionID != mctx.SessionID ||\n611|\t\tbinding.TerminalInstanceID != mctx.TerminalInstanceID ||\n612|\t\tbinding.TerminalBackendID != mctx.TerminalBackendID {\n613|\t\treturn empty, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n614|\t}\n615|\treturn binding, nil\n616|}\n617|\n618|// restoreBinding builds the required restore result binding after the\n619|// effects commit. Within one generation the prior is the result: the\n620|// re-admitted create-time document the pre-effects validation already\n621|// proved. Across a reboot the mutation context carries the new server\n622|// generation, and the result is the minted successor: the termbind\n623|// owner succeeds the prior (new generation, supersedes link, fresh\n624|// identity), the successor persists under the same pair key, and the\n625|// same successor returns. The mint is deterministic, so a retry after\n626|// a crash between the effects and the persist converges on the\n627|// identical document instead of forking, and a retry after the\n628|// persist replays the stored successor without minting again.\n629|func (lc *Lifecycle) restoreBinding(mctx terminstance.MutationContext, body RestoreBody) (*termbind.Binding, error) {\n630|\tprior, err := lc.readRestorePrior(mctx, body)\n631|\tif err != nil {\n632|\t\treturn nil, err\n633|\t}\n634|\tif prior.BackendGeneration == mctx.BackendGeneration {\n635|\t\treturn &prior, nil\n636|\t}\n637|\tminted, raw, err := termbind.MintSuccessorBinding(prior, mctx.BackendGeneration)\n638|\tif err != nil {\n639|\t\treturn nil, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n640|\t}\n641|\tif err := lc.States.RecordBindingDoc(mctx.SessionID, body.BootstrapOperationID, raw); err != nil {\n642|\t\treturn nil, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding write\"}\n643|\t}\n644|\treturn &minted, nil\n645|}\n646|\n647|// checkPriorBinding enforces the restore mismatch rule: the recorded\n648|// bootstrap binding for the (session, bootstrap) pair must exist and\n649|// its digest must equal the carried prior_binding_id. Substituting any\n650|// other binding — including the configured default — refuses the\n651|// restore mismatch. A binding read failure is an error, never a\n652|// mismatch: unknown is not a verdict.\n653|func (lc *Lifecycle) checkPriorBinding(body RestoreBody) error {\n654|\trecorded, found, err := lc.Bindings.Lookup(body.Context.SessionID, body.BootstrapOperationID)\n655|\tif err != nil {\n656|\t\treturn err\n657|\t}\n658|\tif !found || recorded.BindingDigest != body.PriorBindingID {\n659|\t\treturn &Error{Code: terminalbackend.CodeRestoreMismatch, Detail: \"restore prior binding\"}\n660|\t}\n661|\treturn nil\n662|}\n663|\n664|// effectPerformer executes one lifecycle side effect and reports its\n665|// evidence ID, the single capability the receipt-bound effect loop\n666|// needs from the request backend.\n667|type effectPerformer interface {\n668|\tPerformEffect(ctx context.Context, effect terminalbackend.SideEffect) (string, error)\n669|}\n670|\n671|// executeWithReceipt binds the idempotency receipt and runs the\n672|// effects under it, mirroring the engine's bind discipline: an\n673|// identical retry replays the one completion, a bound key without its\n674|// completion reconciles through the production status entry before it\n675|// refuses, and no path binds a second receipt for one key. complete\n676|// maps the successful result into the operation outcome; failures\n677|// return the outcome with the mutation set, mirroring the engine.\n678|func (lc *Lifecycle) executeWithReceipt(ctx context.Context, req OpRequest, socket string, operation terminalbackend.Operation, mctx terminstance.MutationContext, source, target terminalbackend.InstanceState, effects []terminalbackend.SideEffect, deadline time.Time, kind terminstance.AuthorizationKind, reqBackend effectPerformer, complete func(terminstance.Result) OpOutcome) (OpOutcome, error) {\n679|\tkey := mctx.IdempotencyKey\n680|\t_, replayed, err := lc.Receipts.Bind(key, operation, mctx.OperationID)\n681|\tif err != nil {\n682|\t\tif backendErrorCode(err) != \"\" {\n683|\t\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n684|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, rowError(operation, err)\n685|\t\t}\n686|\t\tif _, found, lookupErr := lc.Receipts.Lookup(key); lookupErr == nil && !found {\n687|\t\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"idempotency store failure\"}\n688|\t\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n689|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n690|\t\t}\n691|\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"idempotency store failure\"}\n692|\t\tresult := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n693|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n694|\t}\n695|\tif replayed {\n696|\t\t// A replayed success replays the stored result without\n697|\t\t// touching the incarnation: replaying an old restore\n698|\t\t// must not supersede a newer closure. Only the fresh\n699|\t\t// path rotates, after its effects commit.\n700|\t\tstored, found, err := lc.Receipts.Completed(key)\n701|\t\tif err != nil {\n702|\t\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"idempotency store failure\"}\n703|\t\t\tresult := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n704|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n705|\t\t}\n706|\t\tif !found {\n707|\t\t\treturn lc.resumeUncertain(ctx, req, socket, operation, mctx, source, target, effects, deadline, kind, reqBackend, complete)\n708|\t\t}\n709|\t\tvar result terminstance.Result\n710|\t\tif err := json.Unmarshal(stored, &result); err != nil {\n711|\t\t\tfailure := &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"idempotency result image\"}\n712|\t\t\trebuilt := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n713|\t\t\treturn OpOutcome{Operation: operation, Mutation: &rebuilt}, failure\n714|\t\t}\n715|\t\tif err := terminstance.CheckResult(mctx, source, result); err != nil {\n716|\t\t\tif backendErrorCode(err) == \"\" {\n717|\t\t\t\tfailure := &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"idempotency result image\"}\n718|\t\t\t\trebuilt := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n719|\t\t\t\treturn OpOutcome{Operation: operation, Mutation: &rebuilt}, failure\n720|\t\t\t}\n721|\t\t\trebuilt := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionFor(backendErrorCode(err), true))\n722|\t\t\treturn OpOutcome{Operation: operation, Mutation: &rebuilt}, rowError(operation, err)\n723|\t\t}\n724|\t\treturn complete(result), nil\n725|\t}\n726|\tif lc.Hooks != nil && lc.Hooks.AfterReceipt != nil {\n727|\t\tlc.Hooks.AfterReceipt(operation, key, terminstance.InterimState(operation, source))\n728|\t}\n729|\treturn lc.runLifecycleEffects(ctx, operation, mctx, source, target, effects, deadline, kind, reqBackend, complete)\n730|}\n731|\n732|// resumeUncertain reconciles a bound key without its completion through\n733|// the production status entry: when status proves the presented source\n734|// state — nothing happened — the same operation continues under the\n735|// same receipt; when status proves anything else, or fails, the retry\n736|// refuses uncertain with status_first. No path binds a second receipt\n737|// for one key.\n738|func (lc *Lifecycle) resumeUncertain(ctx context.Context, req OpRequest, socket string, operation terminalbackend.Operation, mctx terminstance.MutationContext, source, target terminalbackend.InstanceState, effects []terminalbackend.SideEffect, deadline time.Time, kind terminstance.AuthorizationKind, reqBackend effectPerformer, complete func(terminstance.Result) OpOutcome) (OpOutcome, error) {\n739|\tbody := terminstance.StatusBody{\n740|\t\tSessionID:                  mctx.SessionID,\n741|\t\tTerminalInstanceID:         mctx.TerminalInstanceID,\n742|\t\tHasTerminalInstanceID:      true,\n743|\t\tTerminalBackendID:          mctx.TerminalBackendID,\n744|\t\tImplementationVersion:      mctx.ImplementationVersion,\n745|\t\tProtocolVersion:            mctx.ProtocolVersion,\n746|\t\tBackendGeneration:          mctx.BackendGeneration,\n747|\t\tHasBackendGeneration:       true,\n748|\t\tIncludeProviderObservation: false,\n749|\t\tDeadline:                   mctx.Deadline,\n750|\t}\n751|\tstatusBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n752|\tstatusBackend.operation = terminalbackend.OperationStatus\n753|\treport, err := lc.engineFor(statusBackend).ExecuteStatus(ctx, body, source, req.Admitted)\n754|\tif err != nil || report.State != source {\n755|\t\tfailure := &Error{Code: terminalbackend.CodeUnavailable, Detail: \"idempotency result uncertain\"}\n756|\t\tresult := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n757|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n758|\t}\n759|\tif lc.Hooks != nil && lc.Hooks.AfterReceipt != nil {\n760|\t\tlc.Hooks.AfterReceipt(operation, mctx.IdempotencyKey, terminstance.InterimState(operation, source))\n761|\t}\n762|\treturn lc.runLifecycleEffects(ctx, operation, mctx, source, target, effects, deadline, kind, reqBackend, complete)\n763|}\n764|\n765|// runLifecycleEffects performs the transition's side effects under an\n766|// already-bound receipt with the per-effect deadline, authorization,\n767|// and generation gates, then completes the key exactly once — the\n768|// engine's runEffects contract, second side. Fresh and resumed runs\n769|// share this loop. On success the after-state records in the AX-side\n770|// memory and the outcome completes; every failure returns the outcome\n771|// with the mutation set, mirroring the engine.\n772|func (lc *Lifecycle) runLifecycleEffects(ctx context.Context, operation terminalbackend.Operation, mctx terminstance.MutationContext, source, target terminalbackend.InstanceState, effects []terminalbackend.SideEffect, deadline time.Time, kind terminstance.AuthorizationKind, reqBackend effectPerformer, complete func(terminstance.Result) OpOutcome) (OpOutcome, error) {\n773|\tkey := mctx.IdempotencyKey\n774|\tcommitted := false\n775|\tevidence := []string(nil)\n776|\tperformed := []terminalbackend.SideEffect(nil)\n777|\tfail := func(code, detail string) (OpOutcome, error) {\n778|\t\tafter := source\n779|\t\tif committed {\n780|\t\t\tafter = terminalbackend.StateUnavailable\n781|\t\t}\n782|\t\tfailure := &Error{Code: code, Detail: detail}\n783|\t\tresult := mutationResult(mctx, source, after, performed, evidence, terminstance.DispositionFor(code, committed))\n784|\t\tlc.recordFailure(mctx.TerminalInstanceID, after)\n785|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n786|\t}\n787|\tfor _, effect := range effects {\n788|\t\tif !lc.Now().Before(deadline) {\n789|\t\t\treturn fail(rowTimeoutCode(operation), \"operation deadline\")\n790|\t\t}\n791|\t\tif err := terminstance.CheckAuthorization(mctx.Authorization, kind, lc.CurrentLease(), lc.Now()); err != nil {\n792|\t\t\tcode := backendErrorCode(err)\n793|\t\t\tif code == \"\" {\n794|\t\t\t\tcode = terminalbackend.CodeUnauthorized\n795|\t\t\t}\n796|\t\t\treturn fail(code, \"lifecycle authorization recheck\")\n797|\t\t}\n798|\t\tif lc.CurrentGeneration() != mctx.BackendGeneration {\n799|\t\t\treturn fail(terminalbackend.CodeStaleGeneration, \"backend_generation stale\")\n800|\t\t}\n801|\t\tif lc.Hooks != nil && lc.Hooks.BeforeEffect != nil {\n802|\t\t\tlc.Hooks.BeforeEffect(effect)\n803|\t\t}\n804|\t\tevidenceID, err := reqBackend.PerformEffect(ctx, effect)\n805|\t\tif lc.Hooks != nil && lc.Hooks.AfterEffect != nil {\n806|\t\t\tlc.Hooks.AfterEffect(effect)\n807|\t\t}\n808|\t\tif err != nil {\n809|\t\t\tcode := backendErrorCode(err)\n810|\t\t\tif code == \"\" {\n811|\t\t\t\treturn fail(terminstance.CodeProcessFailed, \"backend effect uncertain\")\n812|\t\t\t}\n813|\t\t\tif checkErr := terminalbackend.CheckErrorAllowed(string(operation), code); checkErr != nil {\n814|\t\t\t\treturn fail(terminalbackend.CodeProtocolError, \"operation error vocabulary\")\n815|\t\t\t}\n816|\t\t\treturn fail(code, \"backend effect refused\")\n817|\t\t}\n818|\t\tif _, err := scalar.ParseDigest(evidenceID); err != nil {\n819|\t\t\treturn fail(terminalbackend.CodeIntegrityFailure, \"backend effect evidence\")\n820|\t\t}\n821|\t\tcommitted = true\n822|\t\tperformed = append(performed, effect)\n823|\t\tevidence = append(evidence, evidenceID)\n824|\t}\n825|\tresult := mutationResult(mctx, source, target, performed, evidence, terminstance.DispositionReplaySame)\n826|\tencoded, err := json.Marshal(result)\n827|\tif err != nil {\n828|\t\tfailure := &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"idempotency result image\"}\n829|\t\tresult.Disposition = terminstance.DispositionStatusFirst\n830|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n831|\t}\n832|\tif err := lc.Receipts.Complete(key, encoded); err != nil {\n833|\t\tif backendErrorCode(err) == \"\" {\n834|\t\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"idempotency store failure\"}\n835|\t\t\tresult.Disposition = terminstance.DispositionStatusFirst\n836|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n837|\t\t}\n838|\t\tresult.Disposition = terminstance.DispositionStatusFirst\n839|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, rowError(operation, err)\n840|\t}\n841|\tif operation == terminalbackend.OperationRestore {\n842|\t\t// A fresh restore success opens a new incarnation like a\n843|\t\t// fresh create: prior closure reports are superseded.\n844|\t\t// Terminate-stale never rotates — it closes the\n845|\t\t// incarnation toward stopped, which admits no attach —\n846|\t\t// and a failed rotation fails the operation closed.\n847|\t\tif err := lc.States.RecordIncarnation(mctx.TerminalInstanceID, key); err != nil {\n848|\t\t\tfailure := &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore incarnation image\"}\n849|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n850|\t\t}\n851|\t}\n852|\t_ = lc.recordAfter(mctx.TerminalInstanceID, target)\n853|\treturn complete(result), nil\n854|}\n855|\n856|// rowTimeoutCode reports the §4.C timeout vocabulary per operation\n857|// row: the wait row times out quiesce_timeout and the stop row\n858|// stop_timeout, while every other row times out\n859|// terminal_backend_timeout. This mirrors the landed engine's\n860|// per-row mapping for the operations the engine scope leaves out\n861|// and the within-effect revalidation; the literals are pinned by\n862|// the row tests, never derived from the engine constant.\n863|func rowTimeoutCode(operation terminalbackend.Operation) string {\n864|\tswitch operation {\n865|\tcase terminalbackend.OperationWaitSafeBoundary:\n866|\t\treturn terminstance.CodeQuiesceTimeout\n867|\tcase terminalbackend.OperationRequestStop:\n868|\t\treturn terminstance.CodeStopTimeout\n869|\tdefault:\n870|\t\treturn terminstance.CodeTimeout\n871|\t}\n872|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c725","stream":{"kind":"session","id":"01a0c9a4-cdaf-7691-9123-20534004d71c"},"sequence":493,"recorded_at":1780531400000981,"record_type":"event","durability":"durable","causation_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","run_stream":{"kind":"run","id":"7d4d0da9-54d0-407b-9491-ce60f372e27f"},"call_id":"call_01a0c9a5ea7d7218beacdbbb8b49dfe5","text":"Read text file `internal/tmuxserver/backend.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"errors\"\n6|\t\"strconv\"\n7|\t\"strings\"\n8|\t\"time\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n15|)\n16|\n17|// operationDirectives is the exact lifecycle-to-tmux mapping: every\n18|// operation executes a fixed directive sequence and no other tmux\n19|// command. The table is the contract; the drivers below execute it.\n20|// The boundary list-panes member is conditional: it runs only for\n21|// provider proof kinds, binding contemporaneous provider rows into\n22|// the boundary evidence, and never fails the observation.\n23|var operationDirectives = map[terminalbackend.Operation][]Directive{\n24|\tterminalbackend.OperationCreate:           {DirectiveNewSession},\n25|\tterminalbackend.OperationAttach:           {DirectiveAttachSession},\n26|\tterminalbackend.OperationStatus:           {DirectiveListPanes, DirectiveListSessions},\n27|\tterminalbackend.OperationQuiesceInput:     {DirectiveLockSession, DirectiveDetachClients},\n28|\tterminalbackend.OperationWaitSafeBoundary: {DirectiveWaitBoundary, DirectiveListPanes},\n29|\tterminalbackend.OperationRequestStop:      {DirectiveSendInterrupt, DirectiveHasSession, DirectiveKillSession, DirectiveHasSession},\n30|\tterminalbackend.OperationTerminateStale:   {DirectiveKillSession, DirectiveHasSession},\n31|\tterminalbackend.OperationRestore:          {DirectiveNewSession},\n32|}\n33|\n34|// DirectivesFor reports the fixed tmux directive sequence for one\n35|// lifecycle operation. Manifest and probe are not lifecycle operations\n36|// and refuse; every other unknown operation refuses as well.\n37|func DirectivesFor(operation terminalbackend.Operation) ([]Directive, error) {\n38|\tdirectives, known := operationDirectives[operation]\n39|\tif !known {\n40|\t\treturn nil, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle operation\"}\n41|\t}\n42|\treturn append([]Directive(nil), directives...), nil\n43|}\n44|\n45|// backend is the tmux terminstance.Backend: side-effect execution and\n46|// status observation over the structured commands. It is\n47|// request-scoped — one backend per Execute call — because effects\n48|// carry no identity of their own and the runner, socket, stores, and\n49|// admission are per-request facts.\n50|type backend struct {\n51|\trunner      Runner\n52|\truntimeDir  string\n53|\tsocket      string\n54|\toperation   terminalbackend.Operation\n55|\tsessionID   string\n56|\tinstanceID  string\n57|\tbootstrapID string\n58|\tbindingID   string\n59|\tbindingDoc  []byte\n60|\tchannel     string\n61|\tquiescence  string\n62|\tproofKind   terminstance.ProviderProofKind\n63|\twaitCtx     context.Context\n64|\tdeadline    time.Time\n65|\t// recheck revalidates the live authorization facts (operation\n66|\t// deadline, AX authorization over the current lease, server\n67|\t// generation) at a destructive command boundary that follows a\n68|\t// wait. The lifecycle entry builds it over the same landed\n69|\t// gates the engine's per-effect loop applies; paths whose\n70|\t// effects issue no destructive command after any wait leave it\n71|\t// nil. A nil recheck at a guarded boundary refuses instead of\n72|\t// running blind: the backend never issues a post-wait\n73|\t// destructive command without its revalidation.\n74|\trecheck   func() error\n75|\tnow       func() time.Time\n76|\tsleep     func(time.Duration)\n77|\tpoll      time.Duration\n78|\tadmitted  terminalbackend.Admitted\n79|\tbindings  *axpane.Store\n80|\tattach    *termbind.AttachStore\n81|\tstates    *InstanceStates\n82|\ttransport string\n83|\tinput     bool\n84|\tauthRaw   []byte\n85|\tclientID  string\n86|\t// killExit records the stale-kill exit for the close re-confirm:\n87|\t// a live session after a clean kill and a live session after a\n88|\t// failed kill refuse through the same arm, and the recorded exit\n89|\t// is the member split the narrowing mutant admits exactly one of.\n90|\t// -1 means no kill ran yet on this backend.\n91|\tkillExit int\n92|}\n93|\n94|// effectEvidence derives one evidence digest over the canonical effect\n95|// record: effect name, operation, instance, and outcome facts. The join\n96|// is deterministic; nothing parses it back.\n97|func effectEvidence(effect terminalbackend.SideEffect, operation terminalbackend.Operation, instance string, facts ...string) string {\n98|\trecord := strings.Join(append([]string{string(effect), string(operation), instance}, facts...), \"\\n\")\n99|\treturn scalar.SHA256Digest([]byte(record)).String()\n100|}\n101|\n102|// PerformEffect executes one side effect and reports its evidence ID.\n103|// A nil error proves the commit; a coded error proves the backend\n104|// refused before committing; any other error proves nothing. Every\n105|// tmux command runs through BuildCommand, so no effect addresses any\n106|// server but the derived socket.\n107|func (runner *backend) PerformEffect(ctx context.Context, effect terminalbackend.SideEffect) (string, error) {\n108|\tswitch effect {\n109|\tcase terminalbackend.EffectBindingPersisted:\n110|\t\treturn runner.persistBinding()\n111|\tcase terminalbackend.EffectWrapperStarted:\n112|\t\treturn runner.startWrapper(ctx, terminalbackend.EffectWrapperStarted)\n113|\tcase terminalbackend.EffectAttachClientCreated:\n114|\t\treturn runner.createAttachClient()\n115|\tcase terminalbackend.EffectInputClosed:\n116|\t\treturn runner.closeInput(ctx)\n117|\tcase terminalbackend.EffectSafeBoundaryObserved:\n118|\t\treturn runner.observeBoundary()\n119|\tcase terminalbackend.EffectGracefulStopRequested:\n120|\t\treturn runner.execEvidence(ctx, DirectiveSendInterrupt, terminalbackend.EffectGracefulStopRequested)\n121|\tcase terminalbackend.EffectProcessClosed:\n122|\t\treturn runner.confirmClosed(ctx)\n123|\tcase terminalbackend.EffectBackendStoreClosed:\n124|\t\treturn effectEvidence(effect, runner.operation, runner.instanceID, \"tmux-side closes done\"), nil\n125|\tcase terminalbackend.EffectStaleIncarnationTerminated:\n126|\t\treturn runner.terminateStale(ctx)\n127|\tcase terminalbackend.EffectWrapperRestored:\n128|\t\treturn runner.startWrapper(ctx, terminalbackend.EffectWrapperRestored)\n129|\tdefault:\n130|\t\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend effect vocabulary\"}\n131|\t}\n132|}\n133|\n134|// persistBinding records the bootstrap binding for the create/restore\n135|// pair. A changed operation in the bootstrap window refuses the landed\n136|// idempotency_mismatch; an identical retry replays the one receipt.\n137|// On create the carried binding document is kept alongside the\n138|// receipt, so restore can return the required binding without\n139|// minting; a replayed receipt heals a missing document from the same\n140|// carried bytes, closing the crash window between receipt and\n141|// document.\n142|func (runner *backend) persistBinding() (string, error) {\n143|\tif runner.bindings == nil {\n144|\t\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend binding store\"}\n145|\t}\n146|\trecorded, replayed, err := runner.bindings.Bind(runner.sessionID, runner.bootstrapID, axpane.Binding{\n147|\t\tSessionID:          runner.sessionID,\n148|\t\tOperationID:        runner.bootstrapID,\n149|\t\tTerminalInstanceID: runner.instanceID,\n150|\t\tBindingDigest:      runner.bindingID,\n151|\t})\n152|\tif err != nil {\n153|\t\tif code := backendErrorCode(err); code != \"\" {\n154|\t\t\treturn \"\", &terminstance.Error{Code: code, Detail: \"backend binding conflict\"}\n155|\t\t}\n156|\t\treturn \"\", err\n157|\t}\n158|\tif len(runner.bindingDoc) > 0 && runner.states != nil {\n159|\t\tif !replayed {\n160|\t\t\tif err := runner.states.RecordBindingDoc(runner.sessionID, runner.bootstrapID, runner.bindingDoc); err != nil {\n161|\t\t\t\treturn \"\", err\n162|\t\t\t}\n163|\t\t} else if _, found, err := runner.states.LookupBindingDoc(runner.sessionID, runner.bootstrapID); err != nil {\n164|\t\t\treturn \"\", err\n165|\t\t} else if !found {\n166|\t\t\tif err := runner.states.RecordBindingDoc(runner.sessionID, runner.bootstrapID, runner.bindingDoc); err != nil {\n167|\t\t\t\treturn \"\", err\n168|\t\t\t}\n169|\t\t}\n170|\t}\n171|\treturn recorded.BindingDigest, nil\n172|}\n173|\n174|// closeInput cuts operator input to the instance: lock-session first,\n175|// so attached clients cannot type into the pane during the detach\n176|// window, then detach-client -s, which detaches every client\n177|// currently attached to the session. A locked session does not lock\n178|// subsequently attaching clients (verified on tmux 3.6a), so new\n179|// input-authorized attaches are refused AX-side at the attach entry\n180|// once the quiescing state records; read-only attaches stay admitted\n181|// because quiesce retains observation. Provider input enters only\n182|// through the request-stop effect (the ordered next step), so no\n183|// send-keys runs here. Both commands must exit clean; the evidence\n184|// binds both exits. The detach is a second destructive command after\n185|// the lock's round trip, so the boundary between them revalidates\n186|// the authorization facts the engine checked before the effect: a\n187|// generation rotated, authorization lapsed, or deadline passed\n188|// during the lock refuses before the detach issues.\n189|func (runner *backend) closeInput(ctx context.Context) (string, error) {\n190|\tfor i, directive := range []Directive{DirectiveLockSession, DirectiveDetachClients} {\n191|\t\tif i > 0 {\n192|\t\t\tif err := runner.recheckPostWait(); err != nil {\n193|\t\t\t\treturn \"\", err\n194|\t\t\t}\n195|\t\t}\n196|\t\targv, err := runner.command(directive)\n197|\t\tif err != nil {\n198|\t\t\treturn \"\", err\n199|\t\t}\n200|\t\tresult, err := runner.runner.Run(ctx, argv)\n201|\t\tif err != nil {\n202|\t\t\treturn \"\", err\n203|\t\t}\n204|\t\tif result.ExitCode != 0 {\n205|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n206|\t\t}\n207|\t}\n208|\treturn effectEvidence(terminalbackend.EffectInputClosed, runner.operation, runner.instanceID, \"locked\", \"detached\"), nil\n209|}\n210|\n211|// recheckPostWait runs the entry-configured authorization\n212|// revalidation at a destructive command boundary that follows a\n213|// wait. A missing revalidation refuses: the boundary never runs\n214|// blind.\n215|func (runner *backend) recheckPostWait() error {\n216|\tif runner.recheck == nil {\n217|\t\treturn &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend authorization recheck\"}\n218|\t}\n219|\treturn runner.recheck()\n220|}\n221|\n222|// startWrapper execs the instance new-session vector for create\n223|// (wrapper_started) and restore (wrapper_restored).\n224|func (runner *backend) startWrapper(ctx context.Context, effect terminalbackend.SideEffect) (string, error) {\n225|\treturn runner.execEvidence(ctx, DirectiveNewSession, effect)\n226|}\n227|\n228|// createAttachClient records the presentation client receipt for one\n229|// (instance, client) pair. Every call requires the valid unexpired\n230|// attach authorization the attach handler already admitted; the store\n231|// rechecks it, so a timeout creates no authorized input unless the\n232|// durable receipt says so.\n233|func (runner *backend) createAttachClient() (string, error) {\n234|\tif runner.attach == nil {\n235|\t\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend attach store\"}\n236|\t}\n237|\treceipt, _, err := runner.attach.Attach(runner.sessionID, runner.instanceID, runner.clientID, runner.transport, runner.input, runner.authRaw, runner.now())\n238|\tif err != nil {\n239|\t\tif code := backendErrorCode(err); code != \"\" {\n240|\t\t\treturn \"\", &terminstance.Error{Code: code, Detail: \"backend attach conflict\"}\n241|\t\t}\n242|\t\treturn \"\", err\n243|\t}\n244|\treturn effectEvidence(terminalbackend.EffectAttachClientCreated, runner.operation, runner.instanceID, receipt.ClientID, receipt.Transport), nil\n245|}\n246|\n247|// execEvidence runs one directive and evidences its success. A nonzero\n248|// exit is a coded process failure: the command ran and the effect did\n249|// not commit. A transport error is uncoded: it proves nothing.\n250|func (runner *backend) execEvidence(ctx context.Context, directive Directive, effect terminalbackend.SideEffect) (string, error) {\n251|\targv, err := runner.command(directive)\n252|\tif err != nil {\n253|\t\treturn \"\", err\n254|\t}\n255|\tresult, err := runner.runner.Run(ctx, argv)\n256|\tif err != nil {\n257|\t\treturn \"\", err\n258|\t}\n259|\tif result.ExitCode != 0 {\n260|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n261|\t}\n262|\treturn effectEvidence(effect, runner.operation, runner.instanceID, strconv.Itoa(result.ExitCode)), nil\n263|}\n264|\n265|// observeBoundary waits for the wrapper's safe-boundary signal on the\n266|// quiescence channel with the bare blocking `wait-for` vector. The\n267|// wait context already bounds the lesser of the request deadline and\n268|// the timeout; its expiry is the coded quiesce_timeout proving\n269|// non-commit, never a silent continue. The requested provider proof\n270|// kind is bound into the evidence, so each kind proves its own\n271|// boundary and an identical retry replays the same proof. For\n272|// provider proof kinds the contemporaneous provider rows are bound\n273|// alongside: the signal is the proof, the rows are audit context,\n274|// and a failed row read binds its negative instead of failing the\n275|// observed proof.\n276|func (runner *backend) observeBoundary() (string, error) {\n277|\targv, err := runner.command(DirectiveWaitBoundary)\n278|\tif err != nil {\n279|\t\treturn \"\", err\n280|\t}\n281|\tresult, err := runner.runner.Run(runner.waitCtx, argv)\n282|\tif err != nil {\n283|\t\tif runner.waitCtx.Err() != nil {\n284|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeQuiesceTimeout, Detail: \"backend boundary wait\"}\n285|\t\t}\n286|\t\treturn \"\", err\n287|\t}\n288|\tif result.ExitCode != 0 {\n289|\t\tif runner.waitCtx.Err() != nil {\n290|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeQuiesceTimeout, Detail: \"backend boundary wait\"}\n291|\t\t}\n292|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n293|\t}\n294|\tobserved, err := runner.now().UTC().MarshalText()\n295|\tif err != nil {\n296|\t\treturn \"\", err\n297|\t}\n298|\tfacts := []string{string(runner.proofKind), runner.channel, string(observed)}\n299|\tif terminstance.RequiresProviderObservation(runner.proofKind) {\n300|\t\tfacts = append(facts, runner.boundaryProviderRows())\n301|\t}\n302|\treturn effectEvidence(terminalbackend.EffectSafeBoundaryObserved, runner.operation, runner.instanceID, facts...), nil\n303|}\n304|\n305|// boundaryProviderRows reads the contemporaneous provider rows for a\n306|// provider-kind boundary as bound context. Presence binds the row\n307|// set; absence binds the negative; a failed read binds unknown. The\n308|// verdict never fails: the wrapper signal already proved the\n309|// boundary, and a post-signal crash must not discard that proof.\n310|func (runner *backend) boundaryProviderRows() string {\n311|\tctx := runner.waitCtx\n312|\tif ctx == nil {\n313|\t\tctx = context.Background()\n314|\t}\n315|\tpresent, rows, err := runner.probePanes(ctx, runner.instanceID)\n316|\tif err != nil {\n317|\t\treturn \"provider:unknown\"\n318|\t}\n319|\tif !present {\n320|\t\treturn \"provider:absent\"\n321|\t}\n322|\treturn \"provider:\" + strings.Join(rows, \"\\n\")\n323|}\n324|\n325|// Absence stderr markers, verified against tmux 3.6a. has-session\n326|// against a missing session reports `can't find session`; list-panes\n327|// against a missing target reports `can't find window`; either\n328|// command against a missing server socket reports `error connecting\n329|// to <socket> (No such file or directory)`. Under a derived and\n330|// custody-verified socket, a missing socket proves no listener and\n331|// therefore no session. Every tmux failure exits 1, so the exit code\n332|// alone proves nothing: only these marker-paired exits prove\n333|// absence. Unrecognized stderr — permission failures, refused\n334|// connections, version-drifted strings — fails closed to unknown.\n335|const (\n336|\tabsentMarkerNoSession = \"can't find session\"\n337|\tabsentMarkerNoWindow  = \"can't find window\"\n338|\tabsentMarkerNoSocket  = \"No such file or directory\"\n339|\tabsentMarkerNoConnect = \"error connecting to\"\n340|)\n341|\n342|// errProbeUnknown is the uncoded unknown-probe signal: the probe ran\n343|// (or never answered) without proving presence or absence. Callers\n344|// return it verbatim; the engine and the lifecycle effect loop map\n345|// uncoded backend failures to the row-allowed process failure with\n346|// status_first and the unavailable observation, never to a verdict.\n347|var errProbeUnknown = errors.New(\"tmux probe proves neither presence nor absence\")\n348|\n349|// classifyAbsence sorts one probe run into present, absent, or\n350|// unknown. Exit 0 is present. A negative exit (a killed child that a\n351|// runner reported as data) is unknown, never absent. A positive exit\n352|// proves absence only with an absence marker on stderr; without one\n353|// it is unknown. Callers pass the markers their command emits.\n354|func classifyAbsence(result RunResult, markers ...string) (present, absent bool) {\n355|\tif result.ExitCode == 0 {\n356|\t\treturn true, false\n357|\t}\n358|\tif result.ExitCode < 0 {\n359|\t\treturn false, false\n360|\t}\n361|\tstderr := string(result.Stderr)\n362|\tfor _, marker := range markers {\n363|\t\tif marker == absentMarkerNoSocket {\n364|\t\t\tif strings.Contains(stderr, absentMarkerNoConnect) && strings.Contains(stderr, absentMarkerNoSocket) {\n365|\t\t\t\treturn false, true\n366|\t\t\t}\n367|\t\t\tcontinue\n368|\t\t}\n369|\t\tif strings.Contains(stderr, marker) {\n370|\t\t\treturn false, true\n371|\t\t}\n372|\t}\n373|\treturn false, false\n374|}\n375|\n376|// confirmClosed proves process closure for request-stop and\n377|// terminate-stale. Positively observed absence (has-session exit with\n378|// the no-session marker, or no server socket under the verified\n379|// path) is the proof. A live session on request-stop escalates once\n380|// to kill-session and re-confirms; a still-live session is the coded\n381|// stop_timeout. An unproven session — transport failure, killed\n382|// probe, or unmarked nonzero exit — is unknown at the deadline, never\n383|// closure. A live session on terminate-stale is the coded process\n384|// failure: the kill claimed the incarnation and it still answers.\n385|// The confirm polls to the deadline before it concludes anything.\n386|//\n387|// The stop escalation is a new destructive command after the poll\n388|// wait, so the poll bound (the graceful wait) expiring is exactly\n389|// when the other authorization facts must be re-proved: the\n390|// escalation revalidates the operation deadline, the AX\n391|// authorization over the current lease, and the server generation\n392|// before the kill issues. A graceful timeout escalates — the wait\n393|// did its job — but an operation deadline passed, an authorization\n394|// lapsed, or a generation rotated during the poll refuses without\n395|// issuing the kill. The terminate-stale tail issues no command\n396|// after its poll, so it carries no revalidation: its refusal\n397|// stands however the facts moved.\n398|func (runner *backend) confirmClosed(ctx context.Context) (string, error) {\n399|\tabsent, err := runner.pollSession(ctx)\n400|\tif err != nil {\n401|\t\treturn \"\", err\n402|\t}\n403|\tif absent {\n404|\t\treturn effectEvidence(terminalbackend.EffectProcessClosed, runner.operation, runner.instanceID, \"absent\"), nil\n405|\t}\n406|\tif runner.operation == terminalbackend.OperationRequestStop {\n407|\t\tif err := runner.recheckPostWait(); err != nil {\n408|\t\t\treturn \"\", err\n409|\t\t}\n410|\t\targv, err := runner.command(DirectiveKillSession)\n411|\t\tif err != nil {\n412|\t\t\treturn \"\", err\n413|\t\t}\n414|\t\tif result, err := runner.runner.Run(ctx, argv); err != nil {\n415|\t\t\treturn \"\", err\n416|\t\t} else if result.ExitCode != 0 {\n417|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n418|\t\t}\n419|\t\tabsent, err := runner.pollSession(ctx)\n420|\t\tif err != nil {\n421|\t\t\treturn \"\", err\n422|\t\t}\n423|\t\tif absent {\n424|\t\t\treturn effectEvidence(terminalbackend.EffectProcessClosed, runner.operation, runner.instanceID, \"escalated\"), nil\n425|\t\t}\n426|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeStopTimeout, Detail: \"backend stop wait\"}\n427|\t}\n428|\t// Terminate-stale re-confirm: a live session refuses whether the kill\n429|\t// exited clean or failed — the kill claimed the incarnation and it\n430|\t// still answers. The exit split names both members so each refuses\n431|\t// explicitly; the narrowing mutant admits exactly the failed-kill\n432|\t// member.\n433|\tif runner.killExit != 0 {\n434|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n435|\t}\n436|\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n437|}\n438|\n439|// pollSession probes has-session until the session is absent or the\n440|// deadline passes. Presence polls on; absence returns at once; an\n441|// unproven probe (transport failure, killed child, unmarked exit)\n442|// polls on until the deadline and then reports unknown, never\n443|// closure. Cancellation aborts at once.\n444|func (runner *backend) pollSession(ctx context.Context) (bool, error) {\n445|\tfor {\n446|\t\tif ctx != nil && ctx.Err() != nil {\n447|\t\t\treturn false, ctx.Err()\n448|\t\t}\n449|\t\targv, err := runner.command(DirectiveHasSession)\n450|\t\tif err != nil {\n451|\t\t\treturn false, err\n452|\t\t}\n453|\t\tresult, err := runner.runner.Run(ctx, argv)\n454|\t\tif err != nil {\n455|\t\t\tif !runner.now().Before(runner.deadline) {\n456|\t\t\t\treturn false, errProbeUnknown\n457|\t\t\t}\n458|\t\t\trunner.sleep(runner.poll)\n459|\t\t\tcontinue\n460|\t\t}\n461|\t\tpresent, absent := classifyAbsence(result, absentMarkerNoSession, absentMarkerNoSocket)\n462|\t\tif absent {\n463|\t\t\treturn true, nil\n464|\t\t}\n465|\t\tif !present {\n466|\t\t\tif !runner.now().Before(runner.deadline) {\n467|\t\t\t\treturn false, errProbeUnknown\n468|\t\t\t}\n469|\t\t\trunner.sleep(runner.poll)\n470|\t\t\tcontinue\n471|\t\t}\n472|\t\tif !runner.now().Before(runner.deadline) {\n473|\t\t\treturn false, nil\n474|\t\t}\n475|\t\trunner.sleep(runner.poll)\n476|\t}\n477|}\n478|\n479|// terminateStale kills the fenced stale incarnation session. A clean\n480|// kill proves termination; a failed kill self-confirms — a\n481|// positively absent session is terminated however it closed — and\n482|// only a live session after a failed kill is the coded process\n483|// failure. An unproven confirm is unknown, never termination.\n484|func (runner *backend) terminateStale(ctx context.Context) (string, error) {\n485|\targv, err := runner.command(DirectiveKillSession)\n486|\tif err != nil {\n487|\t\treturn \"\", err\n488|\t}\n489|\tresult, err := runner.runner.Run(ctx, argv)\n490|\tif err != nil {\n491|\t\treturn \"\", err\n492|\t}\n493|\trunner.killExit = result.ExitCode\n494|\tif result.ExitCode == 0 {\n495|\t\treturn effectEvidence(terminalbackend.EffectStaleIncarnationTerminated, runner.operation, runner.instanceID, \"killed\"), nil\n496|\t}\n497|\tconfirm, err := runner.command(DirectiveHasSession)\n498|\tif err != nil {\n499|\t\treturn \"\", err\n500|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
