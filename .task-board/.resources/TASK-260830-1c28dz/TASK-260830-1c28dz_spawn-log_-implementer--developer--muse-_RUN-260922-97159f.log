place=\"// Division of authority (composed, never forked; control): v4 payload construction\\n\",\n483|        count=1,\n484|        run=\"TestCheckInstanceIdentityAdmitsUUIDv7\",\n485|        expect=\"SURVIVED\",\n486|        note=\"Harmless control: a comment-only edit must survive.\",\n487|    ),\n488|]\n489|\n490|\n491|def apply(mutant: Mutant, original: str) -> str:\n492|    patched = original.replace(mutant.find, mutant.replace)\n493|    if mutant.find2:\n494|        patched = patched.replace(mutant.find2, mutant.replace2)\n(more lines below)","final_result":true}}}
