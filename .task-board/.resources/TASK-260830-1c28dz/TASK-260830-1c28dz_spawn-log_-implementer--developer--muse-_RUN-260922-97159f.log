{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c827","stream":{"kind":"session","id":"01a0c9a4-cdaf-7691-9123-20534004d71c"},"sequence":622,"recorded_at":1780531400001239,"record_type":"event","durability":"durable","causation_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","run_stream":{"kind":"run","id":"7d4d0da9-54d0-407b-9491-ce60f372e27f"},"task_stream":{"kind":"task","id":"01a0c9a6-2560-7262-adad-b8158f950f0a"},"task_id":"01a0c9a6-2560-7262-adad-b8158f950f0a","event":{"kind":"output","task_id":"01a0c9a6-2560-7262-adad-b8158f950f0a","chunk":"Read text file `internal/termbind/attach.go`.\n1|package termbind\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"fmt\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"runtime\"\n11|\t\"time\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n15|)\n16|\n17|// Attach receipt schema identity. This is an AX-internal host-local durable\n18|// record (the Section 4.E host-local durable metadata class: the durable\n19|// client receipt the Section 4.C attach row requires), not a replicated\n20|// contract: it never leaves the host and never touches the session chain,\n21|// leases, or fencing state.\n22|const (\n23|\tattachSchema        = \"urn:ax:schema:termbind-attach-receipt\"\n24|\tattachSchemaVersion = \"1.0.0\"\n25|)\n26|\n27|// Attach transports from Section 4.E. The enum gate admits all three; the\n28|// landed attach policy refuses the relay transport with unauthorized,\n29|// since current AX admits only the first two.\n30|var attachTransports = []string{\"local_only\", \"trusted_private_mesh\", \"third_party_relay\"}\n31|\n32|// AttachReceipt is the one recorded presentation client for a\n33|// (terminal_instance_id, client_id) pair: the Section 4.C attach\n34|// idempotency key material. Identity is AX-allocated UUIDv7 throughout;\n35|// the receipt carries no chain, lease, or fencing member by construction.\n36|type AttachReceipt struct {\n37|\tSessionID          string `json:\"session_id\"`\n38|\tTerminalInstanceID string `json:\"terminal_instance_id\"`\n39|\tClientID           string `json:\"client_id\"`\n40|\tTransport          string `json:\"transport\"`\n41|\tInputAuthorized    bool   `json:\"input_authorized\"`\n42|\tCreatedAt          string `json:\"created_at\"`\n43|}\n44|\n45|// attachMembers is the exact closed member set of the stored document.\n46|var attachMembers = []string{\n47|\t\"schema\",\n48|\t\"schema_version\",\n49|\t\"session_id\",\n50|\t\"terminal_instance_id\",\n51|\t\"client_id\",\n52|\t\"transport\",\n53|\t\"input_authorized\",\n54|\t\"created_at\",\n55|}\n56|\n57|// AttachHooks arms the crash boundaries of the receipt install: after the\n58|// receipt bytes are staged to the temporary file (before the atomic\n59|// install), and after the install commits (before the directory sync makes\n60|// the commit durable). A nil hook is a no-op; a hook error aborts the call\n61|// with that error.\n62|type AttachHooks struct {\n63|\tAfterStage   func(path string) error\n64|\tAfterInstall func(path string) error\n65|}\n66|\n67|// AttachStore is the durable attach-client receipt store rooted at one\n68|// data directory. Each (terminal_instance_id, client_id) pair keeps its\n69|// own receipt at\n70|// <root>/termbind/attach/<instance_id>/<client_id>.json, installed\n71|// no-replace: an identical retry replays, a conflicting retry refuses\n72|// idempotency_mismatch, and a second client records alongside, never over.\n73|type AttachStore struct {\n74|\troot  string\n75|\thooks *AttachHooks\n76|\tnow   func() time.Time\n77|}\n78|\n79|// OpenAttachStore creates the store, ensuring the root exists. It creates\n80|// no instance directories: those appear with the first Attach.\n81|func OpenAttachStore(root string) (*AttachStore, error) {\n82|\tif root == \"\" {\n83|\t\treturn nil, errors.New(\"termbind attach store root is empty\")\n84|\t}\n85|\tbase := filepath.Join(root, \"termbind\", \"attach\")\n86|\tif err := os.MkdirAll(base, 0o755); err != nil {\n87|\t\treturn nil, fmt.Errorf(\"create termbind attach root: %w\", err)\n88|\t}\n89|\treturn &AttachStore{root: root, now: time.Now}, nil\n90|}\n91|\n92|// WithHooks returns the store with crash hooks armed. It mutates the\n93|// receiver and returns it for call chaining.\n94|func (store *AttachStore) WithHooks(hooks *AttachHooks) *AttachStore {\n95|\tstore.hooks = hooks\n96|\treturn store\n97|}\n98|\n99|func (store *AttachStore) instanceDir(instanceID string) string {\n100|\treturn filepath.Join(store.root, \"termbind\", \"attach\", instanceID)\n101|}\n102|\n103|func (store *AttachStore) receiptPath(instanceID, clientID string) string {\n104|\treturn filepath.Join(store.instanceDir(instanceID), clientID+\".json\")\n105|}\n106|\n107|// Attach records one presentation client under its Section 4.C idempotency\n108|// key (terminal_instance_id + \"/\" + client_id) and returns the receipt. An\n109|// identical retry replays the recorded receipt with replayed true; a retry\n110|// that changes transport or input authorization refuses\n111|// idempotency_mismatch; a second client records its own receipt. Every\n112|// call, including a replay, requires a valid unexpired AttachAuthorization\n113|// equal to the request transport and input: timeout creates no authorized\n114|// input unless the durable receipt says so, and an expired policy never\n115|// replays.\n116|//\n117|// Attach takes no repository, lease, or fencing input and emits no event:\n118|// presentation-client activity cannot change Owner/Replica, lease, or\n119|// fencing state by construction. The zero-events property is proven by\n120|// snapshotting a real chain and lease store around the call.\n121|func (store *AttachStore) Attach(sessionID, instanceID, clientID, transport string, inputAuthorized bool, authRaw []byte, now time.Time) (AttachReceipt, bool, error) {\n122|\tempty := AttachReceipt{}\n123|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n124|\t\treturn empty, false, &terminalbackend.Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach session\"}\n125|\t}\n126|\tif err := CheckInstanceIdentity(instanceID); err != nil {\n127|\t\treturn empty, false, err\n128|\t}\n129|\tif err := CheckInstanceIdentity(clientID); err != nil {\n130|\t\treturn empty, false, err\n131|\t}\n132|\tif !isAttachTransport(transport) {\n133|\t\treturn empty, false, protocolRefusal(\"attach transport\")\n134|\t}\n135|\tauth, err := terminalbackend.ParseAttachAuthorization(authRaw)\n136|\tif err != nil {\n137|\t\treturn empty, false, err\n138|\t}\n139|\tif err := terminalbackend.CheckAttachRequest(auth, transport, inputAuthorized, now); err != nil {\n140|\t\treturn empty, false, err\n141|\t}\n142|\tstored, found, err := store.Lookup(sessionID, instanceID, clientID)\n143|\tif err != nil {\n144|\t\treturn empty, false, err\n145|\t}\n146|\tif found {\n147|\t\tif stored.Transport != transport || stored.InputAuthorized != inputAuthorized {\n148|\t\t\treturn empty, false, &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \"attach client\"}\n149|\t\t}\n150|\t\treturn stored, true, nil\n151|\t}\n152|\treceipt, err := encodeAttachReceipt(AttachReceipt{\n153|\t\tSessionID:          sessionID,\n154|\t\tTerminalInstanceID: instanceID,\n155|\t\tClientID:           clientID,\n156|\t\tTransport:          transport,\n157|\t\tInputAuthorized:    inputAuthorized,\n158|\t}, store.timestamp())\n159|\tif err != nil {\n160|\t\treturn empty, false, err\n161|\t}\n162|\treturn store.install(sessionID, instanceID, clientID, transport, inputAuthorized, receipt)\n163|}\n164|\n165|// Lookup replays the recorded receipt for a (terminal_instance_id,\n166|// client_id) pair, or reports absence when the pair is unrecorded. A read\n167|// or validation failure is an error, never absence: unknown is not absent.\n168|func (store *AttachStore) Lookup(sessionID, instanceID, clientID string) (AttachReceipt, bool, error) {\n169|\tempty := AttachReceipt{}\n170|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n171|\t\treturn empty, false, fmt.Errorf(\"attach lookup session %q is not a UUIDv7: %w\", sessionID, err)\n172|\t}\n173|\tif err := CheckInstanceIdentity(instanceID); err != nil {\n174|\t\treturn empty, false, err\n175|\t}\n176|\tif err := CheckInstanceIdentity(clientID); err != nil {\n177|\t\treturn empty, false, err\n178|\t}\n179|\traw, err := os.ReadFile(store.receiptPath(instanceID, clientID))\n180|\tif err != nil {\n181|\t\tif errors.Is(err, os.ErrNotExist) {\n182|\t\t\treturn empty, false, nil\n183|\t\t}\n184|\t\treturn empty, false, fmt.Errorf(\"read attach receipt: %w\", err)\n185|\t}\n186|\treceipt, err := decodeAttachReceipt(raw)\n187|\tif err != nil {\n188|\t\treturn empty, false, err\n189|\t}\n190|\tif receipt.SessionID != sessionID {\n191|\t\treturn empty, false, errors.New(\"attach receipt names another session\")\n192|\t}\n193|\tif receipt.TerminalInstanceID != instanceID || receipt.ClientID != clientID {\n194|\t\treturn empty, false, errors.New(\"attach receipt names another client pair\")\n195|\t}\n196|\treturn receipt, true, nil\n197|}\n198|\n199|// install stages the receipt to a same-directory temporary file, fsyncs\n200|// it, atomically links it to the receipt path (which must not exist: the\n201|// link is the no-replace commit), removes the staging name, and fsyncs the\n202|// directory. A concurrent same-pair commit wins and the loser converges to\n203|// the winner: an identical retry replays it, a conflicting retry refuses\n204|// idempotency_mismatch. Stale staging files from a pre-commit crash are\n205|// swept before the install.\n206|func (store *AttachStore) install(sessionID, instanceID, clientID, transport string, inputAuthorized bool, receipt []byte) (AttachReceipt, bool, error) {\n207|\tempty := AttachReceipt{}\n208|\tdir := store.instanceDir(instanceID)\n209|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n210|\t\treturn empty, false, fmt.Errorf(\"create attach instance directory: %w\", err)\n211|\t}\n212|\tsweepAttachStaging(dir)\n213|\ttarget := store.receiptPath(instanceID, clientID)\n214|\tstaged, err := os.CreateTemp(dir, \"attach-*.tmp\")\n215|\tif err != nil {\n216|\t\treturn empty, false, fmt.Errorf(\"stage attach receipt: %w\", err)\n217|\t}\n218|\tstagedPath := staged.Name()\n219|\tdefer func() { _ = os.Remove(stagedPath) }()\n220|\tif err := staged.Chmod(0o600); err != nil {\n221|\t\t_ = staged.Close()\n222|\t\treturn empty, false, fmt.Errorf(\"protect attach receipt: %w\", err)\n223|\t}\n224|\tif _, err := staged.Write(receipt); err != nil {\n225|\t\t_ = staged.Close()\n226|\t\treturn empty, false, fmt.Errorf(\"write attach receipt: %w\", err)\n227|\t}\n228|\tif err := staged.Sync(); err != nil {\n229|\t\t_ = staged.Close()\n230|\t\treturn empty, false, fmt.Errorf(\"sync attach receipt: %w\", err)\n231|\t}\n232|\tif err := staged.Close(); err != nil {\n233|\t\treturn empty, false, fmt.Errorf(\"close attach receipt: %w\", err)\n234|\t}\n235|\tif store.hooks != nil && store.hooks.AfterStage != nil {\n236|\t\tif err := store.hooks.AfterStage(stagedPath); err != nil {\n237|\t\t\treturn empty, false, err\n238|\t\t}\n239|\t}\n240|\tif err := os.Link(stagedPath, target); err != nil {\n241|\t\tif errors.Is(err, os.ErrExist) {\n242|\t\t\twinner, found, readErr := store.Lookup(sessionID, instanceID, clientID)\n243|\t\t\tif readErr != nil {\n244|\t\t\t\treturn empty, false, readErr\n245|\t\t\t}\n246|\t\t\tif !found {\n247|\t\t\t\treturn empty, false, errors.New(\"attach receipt vanished after concurrent commit\")\n248|\t\t\t}\n249|\t\t\tif winner.Transport != transport || winner.InputAuthorized != inputAuthorized {\n250|\t\t\t\treturn empty, false, &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \"attach client\"}\n251|\t\t\t}\n252|\t\t\treturn winner, true, nil\n253|\t\t}\n254|\t\treturn empty, false, fmt.Errorf(\"install attach receipt: %w\", err)\n255|\t}\n256|\t_ = os.Remove(stagedPath)\n257|\tif store.hooks != nil && store.hooks.AfterInstall != nil {\n258|\t\tif err := store.hooks.AfterInstall(target); err != nil {\n259|\t\t\treturn empty, false, err\n260|\t\t}\n261|\t}\n262|\tif err := syncAttachDirectory(dir); err != nil {\n263|\t\treturn empty, false, err\n264|\t}\n265|\tstored, found, err := store.Lookup(sessionID, instanceID, clientID)\n266|\tif err != nil {\n267|\t\treturn empty, false, err\n268|\t}\n269|\tif !found {\n270|\t\treturn empty, false, errors.New(\"attach receipt vanished after install\")\n271|\t}\n272|\treturn stored, false, nil\n273|}\n274|\n275|func (store *AttachStore) timestamp() string {\n276|\tnow := time.Now().UTC()\n277|\tif store.now != nil {\n278|\t\tnow = store.now().UTC()\n279|\t}\n280|\treturn now.Format(\"2006-01-02T15:04:05.000Z07:00\")\n281|}\n282|\n283|// isAttachTransport reports whether transport is one of the three Section\n284|// 4.E presentation transports. The literals come from the specification\n285|// table, never from the implementation.\n286|func isAttachTransport(transport string) bool {\n287|\tfor _, member := range attachTransports {\n288|\t\tif transport == member {\n289|\t\t\treturn true\n290|\t\t}\n291|\t}\n292|\treturn false\n293|}\n294|\n295|// sweepAttachStaging removes stale attach-*.tmp files left by a pre-commit\n296|// crash. Only files older than a minute are removed: a concurrent live\n297|// attach stages under the same pattern, and an age gate keeps the sweep\n298|// from deleting its in-flight receipt. It is best-effort and removes only\n299|// the staging pattern.\n300|func sweepAttachStaging(dir string) {\n301|\tmatches, err := filepath.Glob(filepath.Join(dir, \"attach-*.tmp\"))\n302|\tif err != nil {\n303|\t\treturn\n304|\t}\n305|\tcutoff := time.Now().Add(-time.Minute)\n306|\tfor _, match := range matches {\n307|\t\tinfo, err := os.Stat(match)\n308|\t\tif err != nil {\n309|\t\t\tcontinue\n310|\t\t}\n311|\t\tif info.ModTime().After(cutoff) {\n312|\t\t\tcontinue\n313|\t\t}\n314|\t\t_ = os.Remove(match)\n315|\t}\n316|}\n317|\n318|// syncAttachDirectory fsyncs a directory so an install inside it survives\n319|// a crash. Opening a directory fails on Windows, where the install itself\n320|// is the durability boundary; there the sync is skipped, never faked. This\n321|// mirrors the landed matjournal discipline the axpane owner follows.\n322|func syncAttachDirectory(path string) error {\n323|\tif runtime.GOOS == \"windows\" {\n324|\t\treturn nil\n325|\t}\n326|\tdirectory, err := os.Open(path)\n327|\tif err != nil {\n328|\t\treturn fmt.Errorf(\"open directory for fsync: %w\", err)\n329|\t}\n330|\tdefer func() { _ = directory.Close() }()\n331|\tif err := directory.Sync(); err != nil {\n332|\t\treturn fmt.Errorf(\"fsync directory: %w\", err)\n333|\t}\n334|\treturn nil\n335|}\n336|\n337|func encodeAttachReceipt(receipt AttachReceipt, createdAt string) ([]byte, error) {\n338|\tdocument := map[string]any{\n339|\t\t\"schema\":               attachSchema,\n340|\t\t\"schema_version\":       attachSchemaVersion,\n341|\t\t\"session_id\":           receipt.SessionID,\n342|\t\t\"terminal_instance_id\": receipt.TerminalInstanceID,\n343|\t\t\"client_id\":            receipt.ClientID,\n344|\t\t\"transport\":            receipt.Transport,\n345|\t\t\"input_authorized\":     receipt.InputAuthorized,\n346|\t\t\"created_at\":           createdAt,\n347|\t}\n348|\traw, err := json.Marshal(document)\n349|\tif err != nil {\n350|\t\treturn nil, fmt.Errorf(\"encode attach receipt: %w\", err)\n351|\t}\n352|\treturn raw, nil\n353|}\n354|\n355|func decodeAttachReceipt(raw []byte) (AttachReceipt, error) {\n356|\tempty := AttachReceipt{}\n357|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n358|\tdecoder.DisallowUnknownFields()\n359|\tvar document struct {\n360|\t\tSchema             string `json:\"schema\"`\n361|\t\tSchemaVersion      string `json:\"schema_version\"`\n362|\t\tSessionID          string `json:\"session_id\"`\n363|\t\tTerminalInstanceID string `json:\"terminal_instance_id\"`\n364|\t\tClientID           string `json:\"client_id\"`\n365|\t\tTransport          string `json:\"transport\"`\n366|\t\tInputAuthorized    bool   `json:\"input_authorized\"`\n367|\t\tCreatedAt          string `json:\"created_at\"`\n368|\t}\n369|\tif err := decoder.Decode(&document); err != nil {\n370|\t\treturn empty, fmt.Errorf(\"attach receipt is not the closed shape: %w\", err)\n371|\t}\n372|\tif decoder.More() {\n373|\t\treturn empty, fmt.Errorf(\"attach receipt carries trailing data\")\n374|\t}\n375|\tvar members map[string]json.RawMessage\n376|\tif err := json.Unmarshal(raw, &members); err != nil {\n377|\t\treturn empty, fmt.Errorf(\"attach receipt is not an object: %w\", err)\n378|\t}\n379|\tfor _, name := range attachMembers {\n380|\t\tif _, ok := members[name]; !ok {\n381|\t\t\treturn empty, fmt.Errorf(\"attach receipt misses required member %q\", name)\n382|\t\t}\n383|\t}\n384|\tif document.Schema != attachSchema || document.SchemaVersion != attachSchemaVersion {\n385|\t\treturn empty, fmt.Errorf(\"attach receipt schema is not %s %s\", attachSchema, attachSchemaVersion)\n386|\t}\n387|\treceipt := AttachReceipt{\n388|\t\tSessionID:          document.SessionID,\n389|\t\tTerminalInstanceID: document.TerminalInstanceID,\n390|\t\tClientID:           document.ClientID,\n391|\t\tTransport:          document.Transport,\n392|\t\tInputAuthorized:    document.InputAuthorized,\n393|\t\tCreatedAt:          document.CreatedAt,\n394|\t}\n395|\tif _, err := scalar.ParseUUIDv7(receipt.SessionID); err != nil {\n396|\t\treturn empty, fmt.Errorf(\"attach receipt session is not a UUIDv7: %w\", err)\n397|\t}\n398|\tif _, err := scalar.ParseUUIDv7(receipt.TerminalInstanceID); err != nil {\n399|\t\treturn empty, fmt.Errorf(\"attach receipt instance is not a UUIDv7: %w\", err)\n400|\t}\n401|\tif _, err := scalar.ParseUUIDv7(receipt.ClientID); err != nil {\n402|\t\treturn empty, fmt.Errorf(\"attach receipt client is not a UUIDv7: %w\", err)\n403|\t}\n404|\tif _, err := scalar.ParseTimestamp(receipt.CreatedAt); err != nil {\n405|\t\treturn empty, fmt.Errorf(\"attach receipt timestamp is not a timestamp: %w\", err)\n406|\t}\n407|\treturn receipt, nil\n408|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c829","stream":{"kind":"session","id":"01a0c9a4-cdaf-7691-9123-20534004d71c"},"sequence":623,"recorded_at":1780531400001241,"record_type":"event","durability":"durable","causation_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","run_stream":{"kind":"run","id":"7d4d0da9-54d0-407b-9491-ce60f372e27f"},"task_stream":{"kind":"task","id":"01a0c9a6-2560-7262-adad-b8158f950f0a"},"task_id":"01a0c9a6-2560-7262-adad-b8158f950f0a","event":{"kind":"completed","task_id":"01a0c9a6-2560-7262-adad-b8158f950f0a"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c82b","stream":{"kind":"session","id":"01a0c9a4-cdaf-7691-9123-20534004d71c"},"sequence":624,"recorded_at":1780531400001243,"record_type":"event","durability":"durable","causation_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"7d4d0da9-54d0-407b-9491-ce60f372e27f","run_stream":{"kind":"run","id":"7d4d0da9-54d0-407b-9491-ce60f372e27f"},"call_id":"call_01a0c9a6232072889b14a036ef16ced5","text":"Read text file `internal/termbind/attach.go`.\n1|package termbind\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"fmt\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"runtime\"\n11|\t\"time\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n15|)\n16|\n17|// Attach receipt schema identity. This is an AX-internal host-local durable\n18|// record (the Section 4.E host-local durable metadata class: the durable\n19|// client receipt the Section 4.C attach row requires), not a replicated\n20|// contract: it never leaves the host and never touches the session chain,\n21|// leases, or fencing state.\n22|const (\n23|\tattachSchema        = \"urn:ax:schema:termbind-attach-receipt\"\n24|\tattachSchemaVersion = \"1.0.0\"\n25|)\n26|\n27|// Attach transports from Section 4.E. The enum gate admits all three; the\n28|// landed attach policy refuses the relay transport with unauthorized,\n29|// since current AX admits only the first two.\n30|var attachTransports = []string{\"local_only\", \"trusted_private_mesh\", \"third_party_relay\"}\n31|\n32|// AttachReceipt is the one recorded presentation client for a\n33|// (terminal_instance_id, client_id) pair: the Section 4.C attach\n34|// idempotency key material. Identity is AX-allocated UUIDv7 throughout;\n35|// the receipt carries no chain, lease, or fencing member by construction.\n36|type AttachReceipt struct {\n37|\tSessionID          string `json:\"session_id\"`\n38|\tTerminalInstanceID string `json:\"terminal_instance_id\"`\n39|\tClientID           string `json:\"client_id\"`\n40|\tTransport          string `json:\"transport\"`\n41|\tInputAuthorized    bool   `json:\"input_authorized\"`\n42|\tCreatedAt          string `json:\"created_at\"`\n43|}\n44|\n45|// attachMembers is the exact closed member set of the stored document.\n46|var attachMembers = []string{\n47|\t\"schema\",\n48|\t\"schema_version\",\n49|\t\"session_id\",\n50|\t\"terminal_instance_id\",\n51|\t\"client_id\",\n52|\t\"transport\",\n53|\t\"input_authorized\",\n54|\t\"created_at\",\n55|}\n56|\n57|// AttachHooks arms the crash boundaries of the receipt install: after the\n58|// receipt bytes are staged to the temporary file (before the atomic\n59|// install), and after the install commits (before the directory sync makes\n60|// the commit durable). A nil hook is a no-op; a hook error aborts the call\n61|// with that error.\n62|type AttachHooks struct {\n63|\tAfterStage   func(path string) error\n64|\tAfterInstall func(path string) error\n65|}\n66|\n67|// AttachStore is the durable attach-client receipt store rooted at one\n68|// data directory. Each (terminal_instance_id, client_id) pair keeps its\n69|// own receipt at\n70|// <root>/termbind/attach/<instance_id>/<client_id>.json, installed\n71|// no-replace: an identical retry replays, a conflicting retry refuses\n72|// idempotency_mismatch, and a second client records alongside, never over.\n73|type AttachStore struct {\n74|\troot  string\n75|\thooks *AttachHooks\n76|\tnow   func() time.Time\n77|}\n78|\n79|// OpenAttachStore creates the store, ensuring the root exists. It creates\n80|// no instance directories: those appear with the first Attach.\n81|func OpenAttachStore(root string) (*AttachStore, error) {\n82|\tif root == \"\" {\n83|\t\treturn nil, errors.New(\"termbind attach store root is empty\")\n84|\t}\n85|\tbase := filepath.Join(root, \"termbind\", \"attach\")\n86|\tif err := os.MkdirAll(base, 0o755); err != nil {\n87|\t\treturn nil, fmt.Errorf(\"create termbind attach root: %w\", err)\n88|\t}\n89|\treturn &AttachStore{root: root, now: time.Now}, nil\n90|}\n91|\n92|// WithHooks returns the store with crash hooks armed. It mutates the\n93|// receiver and returns it for call chaining.\n94|func (store *AttachStore) WithHooks(hooks *AttachHooks) *AttachStore {\n95|\tstore.hooks = hooks\n96|\treturn store\n97|}\n98|\n99|func (store *AttachStore) instanceDir(instanceID string) string {\n100|\treturn filepath.Join(store.root, \"termbind\", \"attach\", instanceID)\n101|}\n102|\n103|func (store *AttachStore) receiptPath(instanceID, clientID string) string {\n104|\treturn filepath.Join(store.instanceDir(instanceID), clientID+\".json\")\n105|}\n106|\n107|// Attach records one presentation client under its Section 4.C idempotency\n108|// key (terminal_instance_id + \"/\" + client_id) and returns the receipt. An\n109|// identical retry replays the recorded receipt with replayed true; a retry\n110|// that changes transport or input authorization refuses\n111|// idempotency_mismatch; a second client records its own receipt. Every\n112|// call, including a replay, requires a valid unexpired AttachAuthorization\n113|// equal to the request transport and input: timeout creates no authorized\n114|// input unless the durable receipt says so, and an expired policy never\n115|// replays.\n116|//\n117|// Attach takes no repository, lease, or fencing input and emits no event:\n118|// presentation-client activity cannot change Owner/Replica, lease, or\n119|// fencing state by construction. The zero-events property is proven by\n120|// snapshotting a real chain and lease store around the call.\n121|func (store *AttachStore) Attach(sessionID, instanceID, clientID, transport string, inputAuthorized bool, authRaw []byte, now time.Time) (AttachReceipt, bool, error) {\n122|\tempty := AttachReceipt{}\n123|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n124|\t\treturn empty, false, &terminalbackend.Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach session\"}\n125|\t}\n126|\tif err := CheckInstanceIdentity(instanceID); err != nil {\n127|\t\treturn empty, false, err\n128|\t}\n129|\tif err := CheckInstanceIdentity(clientID); err != nil {\n130|\t\treturn empty, false, err\n131|\t}\n132|\tif !isAttachTransport(transport) {\n133|\t\treturn empty, false, protocolRefusal(\"attach transport\")\n134|\t}\n135|\tauth, err := terminalbackend.ParseAttachAuthorization(authRaw)\n136|\tif err != nil {\n137|\t\treturn empty, false, err\n138|\t}\n139|\tif err := terminalbackend.CheckAttachRequest(auth, transport, inputAuthorized, now); err != nil {\n140|\t\treturn empty, false, err\n141|\t}\n142|\tstored, found, err := store.Lookup(sessionID, instanceID, clientID)\n143|\tif err != nil {\n144|\t\treturn empty, false, err\n145|\t}\n146|\tif found {\n147|\t\tif stored.Transport != transport || stored.InputAuthorized != inputAuthorized {\n148|\t\t\treturn empty, false, &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \"attach client\"}\n149|\t\t}\n150|\t\treturn stored, true, nil\n151|\t}\n152|\treceipt, err := encodeAttachReceipt(AttachReceipt{\n153|\t\tSessionID:          sessionID,\n154|\t\tTerminalInstanceID: instanceID,\n155|\t\tClientID:           clientID,\n156|\t\tTransport:          transport,\n157|\t\tInputAuthorized:    inputAuthorized,\n158|\t}, store.timestamp())\n159|\tif err != nil {\n160|\t\treturn empty, false, err\n161|\t}\n162|\treturn store.install(sessionID, instanceID, clientID, transport, inputAuthorized, receipt)\n163|}\n164|\n165|// Lookup replays the recorded receipt for a (terminal_instance_id,\n166|// client_id) pair, or reports absence when the pair is unrecorded. A read\n167|// or validation failure is an error, never absence: unknown is not absent.\n168|func (store *AttachStore) Lookup(sessionID, instanceID, clientID string) (AttachReceipt, bool, error) {\n169|\tempty := AttachReceipt{}\n170|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n171|\t\treturn empty, false, fmt.Errorf(\"attach lookup session %q is not a UUIDv7: %w\", sessionID, err)\n172|\t}\n173|\tif err := CheckInstanceIdentity(instanceID); err != nil {\n174|\t\treturn empty, false, err\n175|\t}\n176|\tif err := CheckInstanceIdentity(clientID); err != nil {\n177|\t\treturn empty, false, err\n178|\t}\n179|\traw, err := os.ReadFile(store.receiptPath(instanceID, clientID))\n180|\tif err != nil {\n181|\t\tif errors.Is(err, os.ErrNotExist) {\n182|\t\t\treturn empty, false, nil\n183|\t\t}\n184|\t\treturn empty, false, fmt.Errorf(\"read attach receipt: %w\", err)\n185|\t}\n186|\treceipt, err := decodeAttachReceipt(raw)\n187|\tif err != nil {\n188|\t\treturn empty, false, err\n189|\t}\n190|\tif receipt.SessionID != sessionID {\n191|\t\treturn empty, false, errors.New(\"attach receipt names another session\")\n192|\t}\n193|\tif receipt.TerminalInstanceID != instanceID || receipt.ClientID != clientID {\n194|\t\treturn empty, false, errors.New(\"attach receipt names another client pair\")\n195|\t}\n196|\treturn receipt, true, nil\n197|}\n198|\n199|// install stages the receipt to a same-directory temporary file, fsyncs\n200|// it, atomically links it to the receipt path (which must not exist: the\n201|// link is the no-replace commit), removes the staging name, and fsyncs the\n202|// directory. A concurrent same-pair commit wins and the loser converges to\n203|// the winner: an identical retry replays it, a conflicting retry refuses\n204|// idempotency_mismatch. Stale staging files from a pre-commit crash are\n205|// swept before the install.\n206|func (store *AttachStore) install(sessionID, instanceID, clientID, transport string, inputAuthorized bool, receipt []byte) (AttachReceipt, bool, error) {\n207|\tempty := AttachReceipt{}\n208|\tdir := store.instanceDir(instanceID)\n209|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n210|\t\treturn empty, false, fmt.Errorf(\"create attach instance directory: %w\", err)\n211|\t}\n212|\tsweepAttachStaging(dir)\n213|\ttarget := store.receiptPath(instanceID, clientID)\n214|\tstaged, err := os.CreateTemp(dir, \"attach-*.tmp\")\n215|\tif err != nil {\n216|\t\treturn empty, false, fmt.Errorf(\"stage attach receipt: %w\", err)\n217|\t}\n218|\tstagedPath := staged.Name()\n219|\tdefer func() { _ = os.Remove(stagedPath) }()\n220|\tif err := staged.Chmod(0o600); err != nil {\n221|\t\t_ = staged.Close()\n222|\t\treturn empty, false, fmt.Errorf(\"protect attach receipt: %w\", err)\n223|\t}\n224|\tif _, err := staged.Write(receipt); err != nil {\n225|\t\t_ = staged.Close()\n226|\t\treturn empty, false, fmt.Errorf(\"write attach receipt: %w\", err)\n227|\t}\n228|\tif err := staged.Sync(); err != nil {\n229|\t\t_ = staged.Close()\n230|\t\treturn empty, false, fmt.Errorf(\"sync attach receipt: %w\", err)\n231|\t}\n232|\tif err := staged.Close(); err != nil {\n233|\t\treturn empty, false, fmt.Errorf(\"close attach receipt: %w\", err)\n234|\t}\n235|\tif store.hooks != nil && store.hooks.AfterStage != nil {\n236|\t\tif err := store.hooks.AfterStage(stagedPath); err != nil {\n237|\t\t\treturn empty, false, err\n238|\t\t}\n239|\t}\n240|\tif err := os.Link(stagedPath, target); err != nil {\n241|\t\tif errors.Is(err, os.ErrExist) {\n242|\t\t\twinner, found, readErr := store.Lookup(sessionID, instanceID, clientID)\n243|\t\t\tif readErr != nil {\n244|\t\t\t\treturn empty, false, readErr\n245|\t\t\t}\n246|\t\t\tif !found {\n247|\t\t\t\treturn empty, false, errors.New(\"attach receipt vanished after concurrent commit\")\n248|\t\t\t}\n249|\t\t\tif winner.Transport != transport || winner.InputAuthorized != inputAuthorized {\n250|\t\t\t\treturn empty, false, &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \"attach client\"}\n251|\t\t\t}\n252|\t\t\treturn winner, true, nil\n253|\t\t}\n254|\t\treturn empty, false, fmt.Errorf(\"install attach receipt: %w\", err)\n255|\t}\n256|\t_ = os.Remove(stagedPath)\n257|\tif store.hooks != nil && store.hooks.AfterInstall != nil {\n258|\t\tif err := store.hooks.AfterInstall(target); err != nil {\n259|\t\t\treturn empty, false, err\n260|\t\t}\n261|\t}\n262|\tif err := syncAttachDirectory(dir); err != nil {\n263|\t\treturn empty, false, err\n264|\t}\n265|\tstored, found, err := store.Lookup(sessionID, instanceID, clientID)\n266|\tif err != nil {\n267|\t\treturn empty, false, err\n268|\t}\n269|\tif !found {\n270|\t\treturn empty, false, errors.New(\"attach receipt vanished after install\")\n271|\t}\n272|\treturn stored, false, nil\n273|}\n274|\n275|func (store *AttachStore) timestamp() string {\n276|\tnow := time.Now().UTC()\n277|\tif store.now != nil {\n278|\t\tnow = store.now().UTC()\n279|\t}\n280|\treturn now.Format(\"2006-01-02T15:04:05.000Z07:00\")\n281|}\n282|\n283|// isAttachTransport reports whether transport is one of the three Section\n284|// 4.E presentation transports. The literals come from the specification\n285|// table, never from the implementation.\n286|func isAttachTransport(transport string) bool {\n287|\tfor _, member := range attachTransports {\n288|\t\tif transport == member {\n289|\t\t\treturn true\n290|\t\t}\n291|\t}\n292|\treturn false\n293|}\n294|\n295|// sweepAttachStaging removes stale attach-*.tmp files left by a pre-commit\n296|// crash. Only files older than a minute are removed: a concurrent live\n297|// attach stages under the same pattern, and an age gate keeps the sweep\n298|// from deleting its in-flight receipt. It is best-effort and removes only\n299|// the staging pattern.\n300|func sweepAttachStaging(dir string) {\n301|\tmatches, err := filepath.Glob(filepath.Join(dir, \"attach-*.tmp\"))\n302|\tif err != nil {\n303|\t\treturn\n304|\t}\n305|\tcutoff := time.Now().Add(-time.Minute)\n306|\tfor _, match := range matches {\n307|\t\tinfo, err := os.Stat(match)\n308|\t\tif err != nil {\n309|\t\t\tcontinue\n310|\t\t}\n311|\t\tif info.ModTime().After(cutoff) {\n312|\t\t\tcontinue\n313|\t\t}\n314|\t\t_ = os.Remove(match)\n315|\t}\n316|}\n317|\n318|// syncAttachDirectory fsyncs a directory so an install inside it survives\n319|// a crash. Opening a directory fails on Windows, where the install itself\n320|// is the durability boundary; there the sync is skipped, never faked. This\n321|// mirrors the landed matjournal discipline the axpane owner follows.\n322|func syncAttachDirectory(path string) error {\n323|\tif runtime.GOOS == \"windows\" {\n324|\t\treturn nil\n325|\t}\n326|\tdirectory, err := os.Open(path)\n327|\tif err != nil {\n328|\t\treturn fmt.Errorf(\"open directory for fsync: %w\", err)\n329|\t}\n330|\tdefer func() { _ = directory.Close() }()\n331|\tif err := directory.Sync(); err != nil {\n332|\t\treturn fmt.Errorf(\"fsync directory: %w\", err)\n333|\t}\n334|\treturn nil\n335|}\n336|\n337|func encodeAttachReceipt(receipt AttachReceipt, createdAt string) ([]byte, error) {\n338|\tdocument := map[string]any{\n339|\t\t\"schema\":               attachSchema,\n340|\t\t\"schema_version\":       attachSchemaVersion,\n341|\t\t\"session_id\":           receipt.SessionID,\n342|\t\t\"terminal_instance_id\": receipt.TerminalInstanceID,\n343|\t\t\"client_id\":            receipt.ClientID,\n344|\t\t\"transport\":            receipt.Transport,\n345|\t\t\"input_authorized\":     receipt.InputAuthorized,\n346|\t\t\"created_at\":           createdAt,\n347|\t}\n348|\traw, err := json.Marshal(document)\n349|\tif err != nil {\n350|\t\treturn nil, fmt.Errorf(\"encode attach receipt: %w\", err)\n351|\t}\n352|\treturn raw, nil\n353|}\n354|\n355|func decodeAttachReceipt(raw []byte) (AttachReceipt, error) {\n356|\tempty := AttachReceipt{}\n357|\tdecoder := json.NewDecoder(bytes.NewReader(raw))\n358|\tdecoder.DisallowUnknownFields()\n359|\tvar document struct {\n360|\t\tSchema             string `json:\"schema\"`\n361|\t\tSchemaVersion      string `json:\"schema_version\"`\n362|\t\tSessionID          string `json:\"session_id\"`\n363|\t\tTerminalInstanceID string `json:\"terminal_instance_id\"`\n364|\t\tClientID           string `json:\"client_id\"`\n365|\t\tTransport          string `json:\"transport\"`\n366|\t\tInputAuthorized    bool   `json:\"input_authorized\"`\n367|\t\tCreatedAt          string `json:\"created_at\"`\n368|\t}\n369|\tif err := decoder.Decode(&document); err != nil {\n370|\t\treturn empty, fmt.Errorf(\"attach receipt is not the closed shape: %w\", err)\n371|\t}\n372|\tif decoder.More() {\n373|\t\treturn empty, fmt.Errorf(\"attach receipt carries trailing data\")\n374|\t}\n375|\tvar members map[string]json.RawMessage\n376|\tif err := json.Unmarshal(raw, &members); err != nil {\n377|\t\treturn empty, fmt.Errorf(\"attach receipt is not an object: %w\", err)\n378|\t}\n379|\tfor _, name := range attachMembers {\n380|\t\tif _, ok := members[name]; !ok {\n381|\t\t\treturn empty, fmt.Errorf(\"attach receipt misses required member %q\", name)\n382|\t\t}\n383|\t}\n384|\tif document.Schema != attachSchema || document.SchemaVersion != attachSchemaVersion {\n385|\t\treturn empty, fmt.Errorf(\"attach receipt schema is not %s %s\", attachSchema, attachSchemaVersion)\n386|\t}\n387|\treceipt := AttachReceipt{\n388|\t\tSessionID:          document.SessionID,\n389|\t\tTerminalInstanceID: document.TerminalInstanceID,\n390|\t\tClientID:           document.ClientID,\n391|\t\tTransport:          document.Transport,\n392|\t\tInputAuthorized:    document.InputAuthorized,\n393|\t\tCreatedAt:          document.CreatedAt,\n394|\t}\n395|\tif _, err := scalar.ParseUUIDv7(receipt.SessionID); err != nil {\n396|\t\treturn empty, fmt.Errorf(\"attach receipt session is not a UUIDv7: %w\", err)\n397|\t}\n398|\tif _, err := scalar.ParseUUIDv7(receipt.TerminalInstanceID); err != nil {\n399|\t\treturn empty, fmt.Errorf(\"attach receipt instance is not a UUIDv7: %w\", err)\n400|\t}\n401|\tif _, err := scalar.ParseUUIDv7(receipt.ClientID); err != nil {\n402|\t\treturn empty, fmt.Errorf(\"attach receipt client is not a UUIDv7: %w\", err)\n403|\t}\n404|\tif _, err := scalar.ParseTimestamp(receipt.CreatedAt); err != nil {\n405|\t\treturn empty, fmt.Errorf(\"attach receipt timestamp is not a timestamp: %w\", err)\n406|\t}\n407|\treturn receipt, nil\n408|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
