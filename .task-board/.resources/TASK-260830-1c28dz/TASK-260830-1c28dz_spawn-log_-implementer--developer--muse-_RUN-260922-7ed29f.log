{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c87f","stream":{"kind":"session","id":"01a0c7e8-b0ce-7b51-a856-c1e5aeba35b8"},"sequence":666,"recorded_at":1780531400001327,"record_type":"event","durability":"durable","causation_id":"1e747257-7dba-4be5-8162-7ca370e28419","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1e747257-7dba-4be5-8162-7ca370e28419","run_stream":{"kind":"run","id":"1e747257-7dba-4be5-8162-7ca370e28419"},"task_stream":{"kind":"task","id":"01a0c7ea-4091-7a31-91b7-72056f836183"},"task_id":"01a0c7ea-4091-7a31-91b7-72056f836183","event":{"kind":"output","task_id":"01a0c7ea-4091-7a31-91b7-72056f836183","chunk":"Read text file `internal/tmuxserver/wrapper.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"time\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n12|)\n13|\n14|// This file orders the §4.2 after-restore sequence at the wrapper\n15|// composition entry: read the latest locally known lease, attempt the\n16|// mesh lease refresh under the measured bound, then decide through\n17|// the landed wrapper owner and route to the decided effects. The\n18|// backend restore entry stays the narrow §4.C row — recreate the\n19|// wrapper under restore authorization and return the parked wire\n20|// result — while this entry owns the order: the refresh runs before\n21|// the decision, so a lapsed local grant under a refreshed remote\n22|// winner offers remote attach instead of refusing at backend\n23|// authorization that the offer path never reaches. Backend restore\n24|// authorization is never weakened to make that path pass: the offer\n25|// and park branches run no backend operation at all.\n26|\n27|// WrapperRestoreRequest is one after-restore composition: the wrapper\n28|// decision input the caller built (mode restore), the local fencing\n29|// facts the ordered observation carries, and the backend restore\n30|// request the resume branches execute.\n31|type WrapperRestoreRequest struct {\n32|\t// Decide is the complete wrapper decision input. Mode must be\n33|\t// restore; Observation is ordered here (the caller-supplied one\n34|\t// is replaced by the refreshed/local observation), every other\n35|\t// member passes through to the landed owner.\n36|\tDecide axpane.Input\n37|\t// Grant is the process-local fencing authorization with its\n38|\t// policy, observed over the ordered winner. Presence is\n39|\t// required; expiry is the landed direction-first arm's verdict,\n40|\t// so a lapsed grant under a remote winner still parks remote\n41|\t// instead of refusing.\n42|\tGrant    sessrepo.FencingGrant\n43|\tHasGrant bool\n44|\tPolicy   sessrepo.FencingPolicy\n45|\t// Restore is the backend restore request the launch and reattach\n46|\t// branches execute. Operation must be restore; the entry\n47|\t// executes nothing else.\n48|\tRestore OpRequest\n49|}\n50|\n51|// WrapperRestoreOutcome is one composed after-restore result: the\n52|// ordered decision, the refresh audit, the winner the decision ran\n53|// over, and the backend restore outcome on the resume branches only.\n54|type WrapperRestoreOutcome struct {\n55|\t// Decision is the landed wrapper verdict: launch, reattach,\n56|\t// attach_remote, takeover_offer, parked, or refused.\n57|\tDecision axpane.Decision\n58|\t// RefreshAttempted reports that the mesh refresh ran; RefreshSucceeded\n59|\t// reports that it answered (a missing adapter, a failed attempt, and\n60|\t// a timed-out attempt all fall back to local knowledge unverified).\n61|\tRefreshAttempted bool\n62|\tRefreshSucceeded bool\n63|\t// RefreshBoundMs is the measured bound one attempt ran under.\n64|\tRefreshBoundMs uint64\n65|\t// WinnerLeaseID and WinnerHostID name the winning lease the\n66|\t// decision ran over: the refreshed winner, or the locally known\n67|\t// lease when the refresh did not answer.\n68|\tWinnerLeaseID string\n69|\tWinnerHostID  string\n70|\t// Restore is the backend restore outcome on launch and reattach,\n71|\t// nil on every other branch (those branches run no backend\n72|\t// operation and launch no provider).\n73|\tRestore *OpOutcome\n74|}\n75|\n76|// ExecuteWrapperRestore runs the §4.2 after-restore sequence to its\n77|// decided effects:\n78|//\n79|//  1. read the latest locally known lease (CurrentLease);\n80|//  2. attempt the mesh lease refresh under the measured bound (a\n81|//     missing, failed, or timed-out attempt falls back to local\n82|//     knowledge, unverified — never verified, never blocking\n83|//     forever);\n84|//  3. decide through the landed wrapper owner over the ordered\n85|//     winner (local win plus valid materialization resumes);\n86|//  4. offer remote attach/takeover when another host owns the session\n87|//     in an interactive terminal;\n88|//  5. park without launching the provider in all other cases.\n89|//\n90|// Only the launch and reattach decisions execute the backend restore;\n91|// the offer, park, and refuse decisions return with no backend\n92|// operation, no tmux exec, and no provider. Union-rival ambiguity is\n93|// not modeled here (bound B38): the entry decides over the single\n94|// refreshed or local winner, and a refresh adapter that observes\n95|// rivals must surface them as refresh failure so the entry parks\n96|// unverified.\n97|func (lc *Lifecycle) ExecuteWrapperRestore(ctx context.Context, req WrapperRestoreRequest) (WrapperRestoreOutcome, error) {\n98|\tempty := WrapperRestoreOutcome{}\n99|\tif lc == nil || lc.CurrentLease == nil || lc.CurrentGeneration == nil || lc.Now == nil ||\n100|\t\tlc.Runner == nil || lc.Receipts == nil || lc.Bindings == nil || lc.Attach == nil || lc.States == nil {\n101|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle dependencies\"}\n102|\t}\n103|\tif req.Decide.Mode != axpane.ModeRestore {\n104|\t\treturn empty, &Error{Code: CodeInvalidArguments, Detail: \"wrapper restore mode\"}\n105|\t}\n106|\tif req.Restore.Operation != string(terminalbackend.OperationRestore) {\n107|\t\treturn empty, &Error{Code: CodeInvalidArguments, Detail: \"wrapper restore operation\"}\n108|\t}\n109|\tlocal := lc.CurrentLease()\n110|\tbound := lc.MeshRefreshTimeout\n111|\tif bound <= 0 {\n112|\t\tbound = DefaultMeshRefreshTimeout\n113|\t}\n114|\twinner, verified, attempted, succeeded := lc.refreshWinner(ctx, req.Decide.SessionID, local, bound)\n115|\tnow := lc.Now()\n116|\tinput := req.Decide\n117|\tinput.Observation = fencing.Observation{\n118|\t\tSessionID:   req.Decide.SessionID,\n119|\t\tWinner:      winner,\n120|\t\tHasWinner:   winner.LeaseID != \"\" && winner.Epoch != 0,\n121|\t\tLocalHostID: lc.LocalHostID,\n122|\t\tVerified:    verified,\n123|\t\tGrant:       req.Grant,\n124|\t\tHasGrant:    req.HasGrant,\n125|\t\tPolicy:      req.Policy,\n126|\t\tNow:         now,\n127|\t}\n128|\tdecision := axpane.Decide(input)\n129|\toutcome := WrapperRestoreOutcome{\n130|\t\tDecision:         decision,\n131|\t\tRefreshAttempted: attempted,\n132|\t\tRefreshSucceeded: succeeded,\n133|\t\tRefreshBoundMs:   uint64(bound.Milliseconds()),\n134|\t\tWinnerLeaseID:    winner.LeaseID,\n135|\t\tWinnerHostID:     winner.HolderHostID,\n136|\t}\n137|\tswitch decision.Action {\n138|\tcase axpane.ActionLaunch, axpane.ActionReattach:\n139|\t\trestored, err := lc.Execute(ctx, req.Restore)\n140|\t\toutcome.Restore = &restored\n141|\t\tif err != nil {\n142|\t\t\treturn outcome, err\n143|\t\t}\n144|\t\treturn outcome, nil\n145|\tdefault:\n146|\t\treturn outcome, nil\n147|\t}\n148|}\n149|\n150|// refreshWinner attempts the §4.2 mesh lease refresh (step 2) under\n151|// the measured bound and reports the ordered winner: the refreshed\n152|// lease verified on success, the locally known lease unverified when\n153|// the adapter is missing, fails, or times out, and the zero winner\n154|// when no lease is known at all. Only a successful refresh verifies:\n155|// local knowledge never self-verifies, so a failed attempt parks\n156|// through the landed unverified arm instead of resuming.\n157|func (lc *Lifecycle) refreshWinner(ctx context.Context, sessionID string, local terminstance.LeaseView, bound time.Duration) (sessrepo.LeaseSummary, bool, bool, bool) {\n158|\tfallback := sessrepo.LeaseSummary{\n159|\t\tSessionID:    sessionID,\n160|\t\tLeaseID:      local.LeaseID,\n161|\t\tEpoch:        local.Epoch,\n162|\t\tHolderHostID: lc.LocalHostID,\n163|\t\tReason:       \"local-knowledge\",\n164|\t}\n165|\tif lc.LeaseRefresh == nil {\n166|\t\treturn fallback, false, false, false\n167|\t}\n168|\trefreshCtx, cancel := context.WithTimeout(ctx, bound)\n169|\trefreshed, err := lc.LeaseRefresh(refreshCtx, sessionID)\n170|\tcancel()\n171|\tif err != nil {\n172|\t\treturn fallback, false, true, false\n173|\t}\n174|\treturn sessrepo.LeaseSummary{\n175|\t\tSessionID:    sessionID,\n176|\t\tLeaseID:      refreshed.LeaseID,\n177|\t\tEpoch:        refreshed.Epoch,\n178|\t\tHolderHostID: refreshed.HolderHostID,\n179|\t\tReason:       \"mesh-refresh\",\n180|\t}, true, true, true\n181|}","final_result":true}}}
