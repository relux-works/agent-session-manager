{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c82b","stream":{"kind":"session","id":"01a0c7e8-b0ce-7b51-a856-c1e5aeba35b8"},"sequence":624,"recorded_at":1780531400001243,"record_type":"event","durability":"durable","causation_id":"1e747257-7dba-4be5-8162-7ca370e28419","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1e747257-7dba-4be5-8162-7ca370e28419","run_stream":{"kind":"run","id":"1e747257-7dba-4be5-8162-7ca370e28419"},"task_stream":{"kind":"task","id":"01a0c7ea-2aac-7bf3-b429-36a9fc150d7d"},"task_id":"01a0c7ea-2aac-7bf3-b429-36a9fc150d7d","event":{"kind":"output","task_id":"01a0c7ea-2aac-7bf3-b429-36a9fc150d7d","chunk":"Read text file `internal/tmuxserver/ops.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"sort\"\n8|\t\"strconv\"\n9|\t\"time\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n17|)\n18|\n19|// This file executes the three lifecycle operations the landed engine\n20|// scope refuses — attach, terminate-stale, and restore — over the same\n21|// landed gates the engine uses (transition matrix, idempotency shapes,\n22|// authorization, capability conferral, receipt and binding stores)\n23|// plus the tmux backend. The recheck loop, receipt discipline, and\n24|// error-to-observation mapping mirror the engine's second side of each\n25|// rule; the census symmetry lines name both sides.\n26|\n27|// sortedEffects copies effects into bytewise order for the wire.\n28|func sortedEffects(effects []terminalbackend.SideEffect) []terminalbackend.SideEffect {\n29|\tordered := append([]terminalbackend.SideEffect(nil), effects...)\n30|\tsort.Slice(ordered, func(i, j int) bool { return ordered[i] < ordered[j] })\n31|\treturn ordered\n32|}\n33|\n34|// sortedEvidence copies evidence IDs into bytewise order for the wire.\n35|func sortedEvidence(evidence []string) []string {\n36|\tordered := append([]string(nil), evidence...)\n37|\tsort.Strings(ordered)\n38|\treturn ordered\n39|}\n40|\n41|// attachDescriptor derives the bound attach descriptor: socket,\n42|// instance, and client joined by newlines. It is host-local (the\n43|// socket path is usable only on the responding host), deterministic,\n44|// and never persisted: the attach handler returns it without writing\n45|// it anywhere, and a dedicated test scans the stores for its bytes.\n46|// Length is bounded by construction — sun_path socket plus two UUIDs\n47|// stay two orders of magnitude below the 4096 cap — so no length arm\n48|// exists to measure; a test pins the maximum instead.\n49|func attachDescriptor(socket, instance, client string) string {\n50|\treturn socket + \"\\n\" + instance + \"\\n\" + client\n51|}\n52|\n53|// createDescriptor derives the unbound create-interactive descriptor:\n54|// socket and instance only, because create carries no client. Same\n55|// non-persistence and length properties as the bound shape.\n56|func createDescriptor(socket, instance string) string {\n57|\treturn socket + \"\\n\" + instance\n58|}\n59|\n60|// executeAttach runs one attach: closed-shape admission, deadline,\n61|// transition, landed attach authorization, capability conferral plus\n62|// the matching-transport arm, live server attestation (the P3-A\n63|// wiring: a fresh decoy admission refuses), the durable client\n64|// receipt, and the caller-executed attach vector with its descriptor.\n65|// The entry returns the vector; it never execs an interactive attach.\n66|func (lc *Lifecycle) executeAttach(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n67|\tempty := OpOutcome{Operation: terminalbackend.OperationAttach}\n68|\tbody, err := parseAttachBody(req.Body)\n69|\tif err != nil {\n70|\t\treturn empty, err\n71|\t}\n72|\tif err := checkLifecycleBackend(body.TerminalBackendID); err != nil {\n73|\t\treturn empty, err\n74|\t}\n75|\tdeadline, err := body.Deadline.Time()\n76|\tif err != nil {\n77|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body deadline\"}\n78|\t}\n79|\tif !lc.Now().Before(deadline) {\n80|\t\treturn empty, &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n81|\t}\n82|\tif _, _, err := terminalbackend.CheckTransition(string(terminalbackend.OperationAttach), req.Source, false); err != nil {\n83|\t\treturn empty, err\n84|\t}\n85|\tif err := terminalbackend.CheckAttachRequest(body.Authorization, body.Transport, body.InputAuthorized, lc.Now()); err != nil {\n86|\t\treturn empty, err\n87|\t}\n88|\tif err := terminalbackend.CheckOperation(string(terminalbackend.OperationAttach), req.Admitted); err != nil {\n89|\t\treturn empty, err\n90|\t}\n91|\tif err := checkAttachTransportCapability(body.Transport, req.Admitted); err != nil {\n92|\t\treturn empty, err\n93|\t}\n94|\tif err := lc.checkAttachQuiesced(body.TerminalInstanceID, body.InputAuthorized); err != nil {\n95|\t\treturn empty, err\n96|\t}\n97|\tif lc.ServerAdmission == nil {\n98|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle dependencies\"}\n99|\t}\n100|\tadmission, err := lc.ServerAdmission()\n101|\tif err != nil {\n102|\t\treturn empty, rowError(terminalbackend.OperationAttach, err)\n103|\t}\n104|\tif err := CheckServerAttested(admission, body.BackendGeneration); err != nil {\n105|\t\treturn empty, &Error{Code: terminalbackend.CodeUnauthorized, Detail: \"attach server attestation\"}\n106|\t}\n107|\treqBackend := lc.requestBackend(req, socket, body.SessionID, body.TerminalInstanceID)\n108|\treqBackend.operation = terminalbackend.OperationAttach\n109|\treqBackend.clientID = body.ClientID\n110|\treqBackend.transport = body.Transport\n111|\treqBackend.input = body.InputAuthorized\n112|\treqBackend.authRaw = body.AuthRaw\n113|\tevidenceID, err := reqBackend.PerformEffect(ctx, terminalbackend.EffectAttachClientCreated)\n114|\tif err != nil {\n115|\t\treturn empty, rowError(terminalbackend.OperationAttach, err)\n116|\t}\n117|\targv, err := BuildCommand(DirectiveAttachSession, CommandArgs{\n118|\t\tRuntimeDir:     lc.RuntimeDir,\n119|\t\tSocket:         socket,\n120|\t\tInstanceID:     body.TerminalInstanceID,\n121|\t\tAttachInput:    body.InputAuthorized,\n122|\t\tHasAttachInput: true,\n123|\t})\n124|\tif err != nil {\n125|\t\treturn empty, err\n126|\t}\n127|\tif err := terminalbackend.CheckAttachResult(body.InputAuthorized, body.InputAuthorized, body.Authorization); err != nil {\n128|\t\treturn empty, err\n129|\t}\n130|\t// Only an input-authorized attach adopts the active state: a\n131|\t// read-only attach is observation, and recording active for it\n132|\t// would reopen quiesced input (the quiesce barrier reads this\n133|\t// same memory, so observation must leave it untouched).\n134|\tif body.InputAuthorized {\n135|\t\tlc.recordAfter(body.TerminalInstanceID, terminalbackend.StateActive)\n136|\t}\n137|\treturn OpOutcome{\n138|\t\tOperation: terminalbackend.OperationAttach,\n139|\t\tAttach: &AttachOutcome{\n140|\t\t\tClientMirrorID:  body.ClientID,\n141|\t\t\tDescriptor:      attachDescriptor(socket, body.TerminalInstanceID, body.ClientID),\n142|\t\t\tInputAuthorized: body.InputAuthorized,\n143|\t\t\tEvidenceIDs:     []string{evidenceID},\n144|\t\t},\n145|\t\tArgv: argv,\n146|\t}, nil\n147|}\n148|\n149|// checkAttachQuiesced enforces the quiesce input barrier at the\n150|// attach entry: tmux offers no session freeze (a locked session does\n151|// not lock subsequently attaching clients), so once the AX-side\n152|// memory records quiescing, new input-authorized attaches refuse the\n153|// failed local precondition. Read-only attaches stay admitted:\n154|// quiesce stops input while retaining observation. A memory read\n155|// failure is an error, never admission: unknown is not a verdict.\n156|func (lc *Lifecycle) checkAttachQuiesced(instanceID string, inputAuthorized bool) error {\n157|\tif !inputAuthorized {\n158|\t\treturn nil\n159|\t}\n160|\tmemory, found, err := lc.States.Lookup(instanceID)\n161|\tif err != nil {\n162|\t\treturn err\n163|\t}\n164|\tif found && memory == terminalbackend.StateQuiescing {\n165|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"attach quiesced input\"}\n166|\t}\n167|\treturn nil\n168|}\n169|\n170|// checkAttachTransportCapability enforces the matching-transport arm:\n171|// local presentation needs local_attach, mesh presentation needs\n172|// remote_attach. The relay member never reaches here — the landed\n173|// attach authorization refuses it first — so no third arm exists.\n174|func checkAttachTransportCapability(transport string, admitted terminalbackend.Admitted) error {\n175|\tswitch transport {\n176|\tcase string(terminalbackend.TransportLocalOnly):\n177|\t\tif !admitted.Has(\"local_attach\") {\n178|\t\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n179|\t\t}\n180|\tcase string(terminalbackend.TransportTrustedPrivateMesh):\n181|\t\tif !admitted.Has(\"remote_attach\") {\n182|\t\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n183|\t\t}\n184|\tdefault:\n185|\t\treturn &Error{Code: terminalbackend.CodeProtocolError, Detail: \"presentation transport vocabulary\"}\n186|\t}\n187|\treturn nil\n188|}\n189|\n190|// executeTerminate runs one terminate-stale: closed-shape admission,\n191|// idempotency material, capability conferral plus the dual conditional,\n192|// transition, force_stale authorization, generation recheck, landed\n193|// fencing authorization, deadline, receipt discipline with\n194|// status-reconciled resume, and the kill plus close-confirm effects.\n195|func (lc *Lifecycle) executeTerminate(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n196|\tempty := OpOutcome{Operation: terminalbackend.OperationTerminateStale}\n197|\tbody, err := parseTerminateBody(req.Body)\n198|\tif err != nil {\n199|\t\treturn empty, err\n200|\t}\n201|\toperation := terminalbackend.OperationTerminateStale\n202|\tmctx := body.Context\n203|\tsource := terminalbackend.InstanceState(req.Source)\n204|\tif err := checkLifecycleBackend(mctx.TerminalBackendID); err != nil {\n205|\t\treturn empty, err\n206|\t}\n207|\tderived, err := terminalbackend.IdempotencyKey(string(operation), mctx.TerminalInstanceID, \"terminate\", body.StaleLeaseID, strconv.FormatUint(body.StaleEpoch, 10))\n208|\tif err != nil {\n209|\t\treturn empty, err\n210|\t}\n211|\tif mctx.IdempotencyKey != derived {\n212|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"idempotency key material\"}\n213|\t}\n214|\tif err := terminalbackend.CheckOperation(string(operation), req.Admitted); err != nil {\n215|\t\tfailure := rowError(operation, err)\n216|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n217|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n218|\t}\n219|\tif err := checkTerminateCapability(req.Admitted); err != nil {\n220|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n221|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n222|\t}\n223|\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), false)\n224|\tif err != nil {\n225|\t\tfailure := rowError(operation, err)\n226|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n227|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n228|\t}\n229|\tif err := terminstance.CheckAuthorization(mctx.Authorization, terminstance.AuthorizationForceStale, lc.CurrentLease(), lc.Now()); err != nil {\n230|\t\tfailure := rowError(operation, err)\n231|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n232|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n233|\t}\n234|\tif lc.CurrentGeneration() != mctx.BackendGeneration {\n235|\t\tfailure := &Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation stale\"}\n236|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n237|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n238|\t}\n239|\tif err := mapFencingError(fencing.AuthorizeTerminateStale(req.Presented, req.Winner, req.HasWinner, req.ForceRecovery, req.DiagnosticsPreserved)); err != nil {\n240|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n241|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n242|\t}\n243|\tif err := checkTerminateTarget(mctx, body, req.Presented); err != nil {\n244|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n245|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n246|\t}\n247|\tif err := checkTerminateWinner(mctx, req.Winner, lc.CurrentLease()); err != nil {\n248|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n249|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n250|\t}\n251|\tdeadline, err := mctx.Deadline.Time()\n252|\tif err != nil {\n253|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"mutation context deadline\"}\n254|\t}\n255|\tif !lc.Now().Before(deadline) {\n256|\t\tfailure := &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n257|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionReplaySame)\n258|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n259|\t}\n260|\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n261|\treqBackend.operation = operation\n262|\treqBackend.deadline = deadline\n263|\treturn lc.executeWithReceipt(ctx, req, socket, operation, mctx, source, target, effects, deadline, terminstance.AuthorizationForceStale, reqBackend, func(result terminstance.Result) OpOutcome {\n264|\t\treturn OpOutcome{Operation: operation, Mutation: &result, TargetClosed: true}\n265|\t})\n266|}\n267|\n268|// checkTerminateCapability enforces the dual conditional: stale\n269|// termination needs stale_process_termination AND\n270|// provider_process_observation. Each arm refuses alone.\n271|func checkTerminateCapability(admitted terminalbackend.Admitted) error {\n272|\tif !admitted.Has(\"stale_process_termination\") {\n273|\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n274|\t}\n275|\tif !admitted.Has(\"provider_process_observation\") {\n276|\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n277|\t}\n278|\treturn nil\n279|}\n280|\n281|// mapFencingError maps the landed terminate-stale authorization onto\n282|// the row's allowed set: malformed fencing material is the protocol\n283|// error, every other fencing refusal — no winner, no force, no\n284|// diagnostics, target mismatch, live owner — is the failed local\n285|// precondition. lease_conflict maps to the precondition too: the row\n286|// has no lease_conflict member, and a target fenced by another\n287|// session's winner fails the fenced-target precondition.\n288|func mapFencingError(err error) error {\n289|\tif err == nil {\n290|\t\treturn nil\n291|\t}\n292|\tif errors.Is(err, fencing.ErrInvalidArguments) {\n293|\t\treturn &Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminate fencing material\"}\n294|\t}\n295|\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate fencing authorization\"}\n296|}\n297|\n298|// checkTerminateTarget binds the presented fencing token to the\n299|// request: session, stale lease, and stale epoch must all agree with\n300|// the context and body. Any disagreement refuses the failed local\n(more lines below)","final_result":true}}}
