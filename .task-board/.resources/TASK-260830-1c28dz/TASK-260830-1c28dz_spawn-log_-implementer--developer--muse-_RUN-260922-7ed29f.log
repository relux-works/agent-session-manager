{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8a9","stream":{"kind":"session","id":"01a0c7e8-b0ce-7b51-a856-c1e5aeba35b8"},"sequence":687,"recorded_at":1780531400001369,"record_type":"event","durability":"durable","causation_id":"1e747257-7dba-4be5-8162-7ca370e28419","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1e747257-7dba-4be5-8162-7ca370e28419","run_stream":{"kind":"run","id":"1e747257-7dba-4be5-8162-7ca370e28419"},"task_stream":{"kind":"task","id":"01a0c7ea-50a4-7990-b5ca-864b1ae23c9a"},"task_id":"01a0c7ea-50a4-7990-b5ca-864b1ae23c9a","event":{"kind":"output","task_id":"01a0c7ea-50a4-7990-b5ca-864b1ae23c9a","chunk":"Read text file `internal/tmuxserver/status.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"errors\"\n6|\t\"sort\"\n7|\t\"strconv\"\n8|\t\"strings\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n15|)\n16|\n17|// ObserveStatus reports the tmux observation for one status body: the\n18|// recorded identity tuple from the durable binding, the live probe\n19|// (list-panes for presence and provider rows, list-sessions for\n20|// attached counts) reconciled against the AX-side state memory, and\n21|// the match verdict comparing the recorded tuple against the query.\n22|// The reported identity is observed, never echoed: every member comes\n23|// from the recorded binding document, so a query under another\n24|// session, instance, backend, or version reads the non-match result\n25|// instead of manufacturing agreement. An error is unknown, never\n26|// absent: transport failures, malformed probe output, contradictory\n27|// probes, and binding read failures all refuse without a report.\n28|func (runner *backend) ObserveStatus(ctx context.Context, body terminstance.StatusBody) (terminstance.StatusObservation, error) {\n29|\tempty := terminstance.StatusObservation{}\n30|\trecorded, bound, err := runner.statusRecordedBinding(body.SessionID)\n31|\tif err != nil {\n32|\t\treturn empty, err\n33|\t}\n34|\tif !bound {\n35|\t\t// A session-scoped query over an unbound session reads\n36|\t\t// absent (the engine adopts the session it asked about).\n37|\t\t// An exact-instance query needs all six recorded members\n38|\t\t// to compare, and an unbound session records none: the\n39|\t\t// identity is unobservable, so the observation is\n40|\t\t// unknown, never a manufactured match.\n41|\t\tif body.HasTerminalInstanceID {\n42|\t\t\treturn empty, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n43|\t\t}\n44|\t\treturn runner.absentObservation(body), nil\n45|\t}\n46|\tbinding, err := runner.statusBindingDoc(body.SessionID, recorded)\n47|\tif err != nil {\n48|\t\treturn empty, err\n49|\t}\n50|\tif body.HasTerminalInstanceID && !bindingMatchesQuery(binding, body) {\n51|\t\treturn runner.nonMatchObservation(body, binding), nil\n52|\t}\n53|\tinstance := recorded.TerminalInstanceID\n54|\tpresent, panes, err := runner.probePanes(ctx, instance)\n55|\tif err != nil {\n56|\t\treturn empty, err\n57|\t}\n58|\tattached := 0\n59|\tif present {\n60|\t\tcount, err := runner.probeAttached(ctx, instance)\n61|\t\tif err != nil {\n62|\t\t\treturn empty, err\n63|\t\t}\n64|\t\tattached = count\n65|\t}\n66|\tmemory, found, err := runner.lookupMemory(instance)\n67|\tif err != nil {\n68|\t\treturn empty, err\n69|\t}\n70|\tstate, wrapper, provider, attachable := ClassifyStatus(ClassifyInput{\n71|\t\tPresent:         present,\n72|\t\tAttached:        attached,\n73|\t\tProviderRows:    len(panes),\n74|\t\tMemory:          memory,\n75|\t\tMemoryFound:     found,\n76|\t\tAttachCapable:   runner.attachCapable(),\n77|\t\tProviderWanted:  body.IncludeProviderObservation,\n78|\t\tProviderCapable: runner.admitted.Has(\"provider_process_observation\"),\n79|\t})\n80|\tproviderPresent, requested, evidenced := providerTriple(body.IncludeProviderObservation, runner.admitted.Has(\"provider_process_observation\"), provider)\n81|\tevidence := statusEvidence(instance, present, panes, attached)\n82|\treturn terminstance.StatusObservation{\n83|\t\tState:             state,\n84|\t\tIdentityMatch:     true,\n85|\t\tWrapperPresent:    wrapper,\n86|\t\tProviderPresent:   providerPresent,\n87|\t\tAttachable:        attachable,\n88|\t\tEvidenceIDs:       evidence,\n89|\t\tProviderRequested: requested,\n90|\t\tProviderEvidenced: evidenced,\n91|\t\tAttachEvidenced:   attachable,\n92|\t\tSessionID:         binding.SessionID,\n93|\t\tInstanceID:        binding.TerminalInstanceID,\n94|\t\tBackendID:         binding.TerminalBackendID,\n95|\t\tImplVersion:       binding.ImplementationVersion,\n96|\t\tProtoVersion:      binding.ProtocolVersion,\n97|\t\tGeneration:        binding.BackendGeneration,\n98|\t}, nil\n99|}\n100|\n101|// statusRecordedBinding reads the session's recorded bootstrap binding\n102|// for identity observation. An unbound session reports found false: it\n103|// reads absent on the session-scoped path and unknown on the exact\n104|// path, never refused. A binding read failure is unknown, never\n105|// absence.\n106|func (runner *backend) statusRecordedBinding(sessionID string) (axpane.Binding, bool, error) {\n107|\tempty := axpane.Binding{}\n108|\tif runner.bindings == nil {\n109|\t\treturn empty, false, &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend binding store\"}\n110|\t}\n111|\tbinding, found, err := runner.bindings.Status(sessionID)\n112|\tif err != nil {\n113|\t\treturn empty, false, err\n114|\t}\n115|\tif !found {\n116|\t\treturn empty, false, nil\n117|\t}\n118|\treturn binding, true, nil\n119|}\n120|\n121|// statusBindingDoc reads and admits the recorded identity tuple for a\n122|// bound session: the create-time binding document under the recorded\n123|// (session, bootstrap) pair, re-admitted by the termbind owner. A\n124|// missing document disagrees with the receipt that proves it, a\n125|// document that fails admission is corrupt, and a document naming\n126|// another session or instance than the receipt anchors is tampered:\n127|// all three refuse the integrity failure, never a match verdict.\n128|func (runner *backend) statusBindingDoc(sessionID string, recorded axpane.Binding) (termbind.Binding, error) {\n129|\tempty := termbind.Binding{}\n130|\tif runner.states == nil {\n131|\t\treturn empty, &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend binding store\"}\n132|\t}\n133|\tdoc, found, err := runner.states.LookupBindingDoc(sessionID, recorded.OperationID)\n134|\tif err != nil {\n135|\t\tvar local *Error\n136|\t\tif errors.As(err, &local) {\n137|\t\t\treturn empty, &terminstance.Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"status binding image\"}\n138|\t\t}\n139|\t\treturn empty, err\n140|\t}\n141|\tif !found {\n142|\t\treturn empty, &terminstance.Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"status binding image\"}\n143|\t}\n144|\tbinding, err := termbind.ParseTerminalBinding(doc)\n145|\tif err != nil {\n146|\t\treturn empty, &terminstance.Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"status binding image\"}\n147|\t}\n148|\tif binding.SessionID != sessionID ||\n149|\t\tbinding.TerminalInstanceID != recorded.TerminalInstanceID {\n150|\t\treturn empty, &terminstance.Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"status binding image\"}\n151|\t}\n152|\treturn binding, nil\n153|}\n154|\n155|// bindingMatchesQuery compares the recorded identity tuple against an\n156|// exact-instance query on the five non-session members: the session\n157|// member already agreed when the receipt anchored this document, so\n158|// only instance, backend, implementation, protocol, and generation\n159|// decide the match. Every member must agree; any drift reads the\n160|// non-match result.\n161|func bindingMatchesQuery(binding termbind.Binding, body terminstance.StatusBody) bool {\n162|\treturn binding.TerminalInstanceID == body.TerminalInstanceID &&\n163|\t\tbinding.TerminalBackendID == body.TerminalBackendID &&\n164|\t\tbinding.ImplementationVersion == body.ImplementationVersion &&\n165|\t\tbinding.ProtocolVersion == body.ProtocolVersion &&\n166|\t\tbinding.BackendGeneration == body.BackendGeneration\n167|}\n168|\n169|// nonMatchObservation reports the prescribed non-match result for an\n170|// exact-instance query the recorded tuple disagrees with: absent with\n171|// no wrapper, no provider, no attachability, and null last fields. It\n172|// probes nothing: the non-match is a binding verdict, and a live tmux\n173|// session under another identity never authorizes fallback. The\n174|// reported tuple is the recorded one, so the engine's own comparison\n175|// recomputes the same non-match.\n176|func (runner *backend) nonMatchObservation(body terminstance.StatusBody, binding termbind.Binding) terminstance.StatusObservation {\n177|\treturn terminstance.StatusObservation{\n178|\t\tState:             terminalbackend.StateAbsent,\n179|\t\tIdentityMatch:     false,\n180|\t\tWrapperPresent:    false,\n181|\t\tProviderPresent:   nil,\n182|\t\tAttachable:        false,\n183|\t\tEvidenceIDs:       []string{scalar.SHA256Digest([]byte(\"identity-nonmatch\\n\" + binding.SessionID + \"\\n\" + binding.TerminalInstanceID)).String()},\n184|\t\tProviderRequested: body.IncludeProviderObservation,\n185|\t\tProviderEvidenced: false,\n186|\t\tAttachEvidenced:   false,\n187|\t\tSessionID:         binding.SessionID,\n188|\t\tInstanceID:        binding.TerminalInstanceID,\n189|\t\tBackendID:         binding.TerminalBackendID,\n190|\t\tImplVersion:       binding.ImplementationVersion,\n191|\t\tProtoVersion:      binding.ProtocolVersion,\n192|\t\tGeneration:        binding.BackendGeneration,\n193|\t}\n194|}\n195|\n196|// absentObservation reports proven absence for an unbound session: the\n197|// absent shape with the queried session echoed, so the engine adopts a\n198|// match on the session it asked about and nothing else.\n199|func (runner *backend) absentObservation(body terminstance.StatusBody) terminstance.StatusObservation {\n200|\treturn terminstance.StatusObservation{\n201|\t\tState:             terminalbackend.StateAbsent,\n202|\t\tIdentityMatch:     true,\n203|\t\tWrapperPresent:    false,\n204|\t\tProviderPresent:   nil,\n205|\t\tAttachable:        false,\n206|\t\tEvidenceIDs:       []string{scalar.SHA256Digest([]byte(\"unbound\\n\" + body.SessionID)).String()},\n207|\t\tProviderRequested: body.IncludeProviderObservation,\n208|\t\tProviderEvidenced: false,\n209|\t\tAttachEvidenced:   false,\n210|\t\tSessionID:         body.SessionID,\n211|\t\tInstanceID:        body.TerminalInstanceID,\n212|\t\tBackendID:         body.TerminalBackendID,\n213|\t\tImplVersion:       body.ImplementationVersion,\n214|\t\tProtoVersion:      body.ProtocolVersion,\n215|\t\tGeneration:        body.BackendGeneration,\n216|\t}\n217|}\n218|\n219|// probePanes runs list-panes for one instance: exit 0 with at least one\n220|// row proves presence; a nonzero exit proves absence only with an\n221|// absence marker on stderr (no session, no window, or no server\n222|// socket under the verified path); any other nonzero exit —\n223|// permission failures, refused connections, killed children — is\n224|// unknown, never absent. A transport error is unknown. An exit-0\n225|// with zero rows is contradictory — a tmux session always has a\n226|// pane — and refuses as unknown rather than inventing presence.\n227|func (runner *backend) probePanes(ctx context.Context, instance string) (bool, []string, error) {\n228|\tsaved := runner.instanceID\n229|\trunner.instanceID = instance\n230|\tdefer func() { runner.instanceID = saved }()\n231|\targv, err := runner.command(DirectiveListPanes)\n232|\tif err != nil {\n233|\t\treturn false, nil, err\n234|\t}\n235|\tresult, err := runner.runner.Run(ctx, argv)\n236|\tif err != nil {\n237|\t\treturn false, nil, err\n238|\t}\n239|\tpresent, absent := classifyAbsence(result, absentMarkerNoSession, absentMarkerNoWindow, absentMarkerNoSocket)\n240|\tif absent {\n241|\t\treturn false, nil, nil\n242|\t}\n243|\tif !present {\n244|\t\treturn false, nil, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n245|\t}\n246|\trows := splitRows(string(result.Stdout))\n247|\tif len(rows) == 0 {\n248|\t\treturn false, nil, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n249|\t}\n250|\treturn true, rows, nil\n251|}\n252|\n253|// probeAttached reads the attached-client count for one present\n254|// instance from list-sessions. A missing row contradicts the presence\n255|// probe (the session vanished between the two commands, or the list is\n256|// corrupt) and refuses as unknown; a malformed count refuses the same\n257|// way. Neither invents attachability.\n258|func (runner *backend) probeAttached(ctx context.Context, instance string) (int, error) {\n259|\targv, err := runner.command(DirectiveListSessions)\n260|\tif err != nil {\n261|\t\treturn 0, err\n262|\t}\n263|\tresult, err := runner.runner.Run(ctx, argv)\n264|\tif err != nil {\n265|\t\treturn 0, err\n266|\t}\n267|\tif result.ExitCode != 0 {\n268|\t\treturn 0, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n269|\t}\n270|\tfor _, row := range splitRows(string(result.Stdout)) {\n271|\t\tname, count, ok := cutRow(row)\n272|\t\tif !ok {\n273|\t\t\treturn 0, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n274|\t\t}\n275|\t\tif name != instance {\n276|\t\t\tcontinue\n277|\t\t}\n278|\t\tattached, err := strconv.Atoi(count)\n279|\t\tif err != nil || attached < 0 {\n280|\t\t\treturn 0, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n281|\t\t}\n282|\t\treturn attached, nil\n283|\t}\n284|\treturn 0, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n285|}\n286|\n287|// lookupMemory reads the AX-side state memory for one instance. The\n288|// store may be nil in unit-scoped backends; a nil store reads as no\n289|// memory rather than refusing, because presence alone still classifies\n290|// the live triad (absent/parked/active).\n291|func (runner *backend) lookupMemory(instance string) (terminalbackend.InstanceState, bool, error) {\n292|\tif runner.states == nil {\n293|\t\treturn \"\", false, nil\n294|\t}\n295|\treturn runner.states.Lookup(instance)\n296|}\n297|\n298|// attachCapable reports whether any admitted attach capability\n299|// evidences presentation right now: local, remote, or web attach.\n300|func (runner *backend) attachCapable() bool {\n301|\treturn runner.admitted.Has(\"local_attach\") ||\n302|\t\trunner.admitted.Has(\"remote_attach\") ||\n303|\t\trunner.admitted.Has(\"web_attach\")\n304|}\n305|\n306|// providerTriple computes the provider_present member and its two\n307|// validation flags: the member is non-null only when observation was\n308|// requested and evidenced; the flags let the landed CheckStatusResult\n309|// verify that rule.\n310|func providerTriple(requested, capable, observed bool) (*bool, bool, bool) {\n311|\tif !requested || !capable {\n312|\t\treturn nil, requested, false\n313|\t}\n314|\tif !observed {\n315|\t\treturn nil, requested, false\n316|\t}\n317|\tpresent := true\n318|\treturn &present, requested, true\n319|}\n320|\n321|// statusEvidence derives the sorted-unique status evidence digests over\n322|// the probe record: presence, pane rows, and attached count. Absence\n323|// evidences the negative probe, never an empty set.\n324|func statusEvidence(instance string, present bool, panes []string, attached int) []string {\n325|\tvar evidence []string\n326|\tif !present {\n327|\t\tevidence = append(evidence, scalar.SHA256Digest([]byte(\"absent\\n\"+instance)).String())\n328|\t} else {\n329|\t\tevidence = append(evidence, scalar.SHA256Digest([]byte(\"panes\\n\"+instance+\"\\n\"+strings.Join(panes, \"\\n\"))).String())\n330|\t\tevidence = append(evidence, scalar.SHA256Digest([]byte(\"sessions\\n\"+instance+\"\\n\"+strconv.Itoa(attached))).String())\n331|\t}\n332|\tsort.Strings(evidence)\n333|\treturn evidence\n334|}\n335|\n336|// splitRows splits probe stdout into non-empty rows. Blank lines are\n337|// skipped: tmux never emits them, and skipping is the tolerant read;\n338|// a wholly blank output yields zero rows, which the callers refuse.\n339|func splitRows(output string) []string {\n340|\tvar rows []string\n341|\tfor _, line := range strings.Split(output, \"\\n\") {\n342|\t\tif line != \"\" {\n343|\t\t\trows = append(rows, line)\n344|\t\t}\n345|\t}\n346|\treturn rows\n347|}\n348|\n349|// cutRow splits one sessions row into name and attached count. Rows\n350|// without the pipe separator are malformed.\n351|func cutRow(row string) (string, string, bool) {\n352|\tname, count, found := strings.Cut(row, \"|\")\n353|\tif !found || name == \"\" || count == \"\" {\n354|\t\treturn \"\", \"\", false\n355|\t}\n356|\treturn name, count, true\n357|}\n358|\n359|// ClassifyInput is the pure status-classification input: the live tmux\n360|// probe (presence, attached count, provider rows) plus the AX-side\n361|// memory and the capability facts.\n362|type ClassifyInput struct {\n363|\tPresent         bool\n364|\tAttached        int\n365|\tProviderRows    int\n366|\tMemory          terminalbackend.InstanceState\n367|\tMemoryFound     bool\n368|\tAttachCapable   bool\n369|\tProviderWanted  bool\n370|\tProviderCapable bool\n371|\t_               struct{}\n372|}\n373|\n374|// ClassifyStatus reconciles the live tmux probe against the AX-side\n375|// state memory into the adopted status: state, wrapper presence,\n376|// provider presence, and attachability. tmux reports only presence;\n377|// the memory carries quiescing, stopped, and stale_fenced, which exist\n378|// only on this side. The rules:\n379|//\n380|//   - absent probe, no memory (or memory absent): absent, no wrapper;\n381|//   - absent probe, memory stopped or stale_fenced: the memory state,\n382|//     no wrapper (a fenced incarnation keeps its fencing without a wrapper);\n383|//   - absent probe, memory quiescing/active/parked/unavailable: unavailable\n384|//     (contradiction: the wrapper vanished, or was never proven);\n385|//   - present probe, memory quiescing or stale_fenced: the memory state\n386|//     (tmux cannot show either; a fenced incarnation with a live wrapper\n387|//     is what terminate-stale kills);\n388|//   - present probe, memory stopped or unavailable: unavailable\n389|//     (contradiction: a session resurrected, or was never proven);\n390|//   - present probe, memory active/parked/absent/none: active when at\n391|//     least one client is attached, otherwise parked.\n392|//\n393|// Attachability needs parked|active plus a currently evidenced attach\n394|// capability; provider presence needs at least one pane row. Memory\n395|// creating is unreachable (Record refuses it) and classifies\n396|// unavailable either way.\n397|func ClassifyStatus(input ClassifyInput) (terminalbackend.InstanceState, bool, bool, bool) {\n398|\tif !input.Present {\n399|\t\treturn classifyAbsent(input)\n400|\t}\n401|\treturn classifyPresent(input)\n402|}\n403|\n404|// classifyAbsent adopts the state for an absent probe.\n405|func classifyAbsent(input ClassifyInput) (terminalbackend.InstanceState, bool, bool, bool) {\n406|\tif !input.MemoryFound || input.Memory == terminalbackend.StateAbsent {\n407|\t\treturn terminalbackend.StateAbsent, false, false, false\n408|\t}\n409|\tswitch input.Memory {\n410|\tcase terminalbackend.StateStopped, terminalbackend.StateStaleFenced:\n411|\t\treturn input.Memory, false, false, false\n412|\tdefault:\n413|\t\treturn terminalbackend.StateUnavailable, false, false, false\n414|\t}\n415|}\n416|\n417|// classifyPresent adopts the state for a present probe.\n418|func classifyPresent(input ClassifyInput) (terminalbackend.InstanceState, bool, bool, bool) {\n419|\tprovider := input.ProviderRows > 0\n420|\tswitch input.Memory {\n421|\tcase terminalbackend.StateQuiescing, terminalbackend.StateStaleFenced:\n422|\t\tif !input.MemoryFound {\n423|\t\t\tbreak\n424|\t\t}\n425|\t\treturn input.Memory, true, provider, false\n426|\tcase terminalbackend.StateStopped, terminalbackend.StateUnavailable:\n427|\t\tif !input.MemoryFound {\n428|\t\t\tbreak\n429|\t\t}\n430|\t\treturn terminalbackend.StateUnavailable, false, false, false\n431|\tcase terminalbackend.StateCreating:\n432|\t\treturn terminalbackend.StateUnavailable, false, false, false\n433|\tdefault:\n434|\t}\n435|\tstate := terminalbackend.StateParked\n436|\tif input.Attached > 0 {\n437|\t\tstate = terminalbackend.StateActive\n438|\t}\n439|\tattachable := input.AttachCapable && (state == terminalbackend.StateParked || state == terminalbackend.StateActive)\n440|\treturn state, true, provider, attachable\n441|}","final_result":true}}}
