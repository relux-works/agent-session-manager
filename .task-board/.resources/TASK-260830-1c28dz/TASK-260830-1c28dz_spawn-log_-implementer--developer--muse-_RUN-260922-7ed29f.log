{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7d1","stream":{"kind":"session","id":"01a0c7e8-b0ce-7b51-a856-c1e5aeba35b8"},"sequence":579,"recorded_at":1780531400001153,"record_type":"event","durability":"durable","causation_id":"1e747257-7dba-4be5-8162-7ca370e28419","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"1e747257-7dba-4be5-8162-7ca370e28419","run_stream":{"kind":"run","id":"1e747257-7dba-4be5-8162-7ca370e28419"},"call_id":"call_01a0c7ea11ac718d9140f2a7b825e4b6","text":"Read text file `internal/tmuxserver/lifecycle.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"time\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n14|)\n15|\n16|// Lifecycle executes the eight tmux lifecycle operations — create,\n17|// attach, status, quiesce-input, wait-safe-boundary, request-stop,\n18|// terminate-stale, restore — over the structured commands. Five\n19|// operations (create, quiesce-input, wait-safe-boundary, request-stop,\n20|// status) delegate to the landed terminstance engine with the tmux\n21|// backend; attach, terminate-stale, and restore — which the engine\n22|// scope gate refuses — execute here over the same landed gates\n23|// (transition matrix, idempotency shapes, authorization, capability\n24|// conferral, receipt and binding stores) plus the tmux backend.\n25|//\n26|// A Lifecycle is constructed whole: every store and function value is\n27|// required (except Sleep/PollInterval, which default, and\n28|// ServerAdmission, which only attach needs). The Execute entry refuses\n29|// before any work when a dependency is missing.\n30|type Lifecycle struct {\n31|\t// RuntimeDir is the tmux runtime directory (<root>/tmux) the\n32|\t// socket derives from.\n33|\tRuntimeDir string\n34|\t// Root is the Runtime IPC root the socket custody verifies.\n35|\tRoot string\n36|\t// Platform selects the sun_path limit.\n37|\tPlatform scalar.Platform\n38|\t// Runner executes the tmux commands.\n39|\tRunner Runner\n40|\t// Receipts is the durable idempotency receipt table.\n41|\tReceipts *terminstance.ReceiptStore\n42|\t// Bindings is the durable bootstrap binding store.\n43|\tBindings *axpane.Store\n44|\t// Attach is the durable attach-client receipt store.\n45|\tAttach *termbind.AttachStore\n46|\t// States is the durable AX-side state memory.\n47|\tStates *InstanceStates\n48|\t// CurrentLease and CurrentGeneration re-read the winning lease\n49|\t// and the validated binding generation at every check point.\n50|\tCurrentLease      func() terminstance.LeaseView\n51|\tCurrentGeneration func() string\n52|\t// Now is the clock.\n53|\tNow func() time.Time\n54|\t// Sleep waits between close-confirm polls. Nil means time.Sleep.\n55|\tSleep func(time.Duration)\n56|\t// PollInterval separates close-confirm polls. Non-positive means\n57|\t// 50 milliseconds.\n58|\tPollInterval time.Duration\n59|\t// ServerAdmission reports the live server attestation the attach\n60|\t// handler binds to the request generation (the P3-A wiring: a\n61|\t// fresh decoy admission refuses here). Nil refuses attach only.\n62|\tServerAdmission func() (RealmAdmission, error)\n63|\t// LocalHostID is the AX host identity the after-restore\n64|\t// composition compares the winning lease holder against. Empty\n65|\t// cannot prove a local win, so the composition parks or offers\n66|\t// remote attach only, never resumes.\n67|\tLocalHostID string\n68|\t// LeaseRefresh attempts the §4.2 mesh lease refresh\n69|\t// (after-restore step 2) under a timeout context. Nil skips the\n70|\t// attempt; a failed attempt also falls back to local knowledge.\n71|\t// Only a successful refresh verifies: the fallback decides\n72|\t// unverified, so it parks instead of resuming.\n73|\tLeaseRefresh func(ctx context.Context, sessionID string) (RefreshWinner, error)\n74|\t// MeshRefreshTimeout bounds one refresh attempt. Non-positive\n75|\t// means DefaultMeshRefreshTimeout. The bound is measured, not\n76|\t// advisory: the refresh context carries exactly this deadline.\n77|\tMeshRefreshTimeout time.Duration\n78|\t// Hooks observes receipts and effects. Nil disables observation.\n79|\tHooks *terminstance.EngineHooks\n80|}\n81|\n82|// DefaultMeshRefreshTimeout bounds the after-restore mesh lease\n83|// refresh when the Lifecycle leaves it unset: five seconds, after\n84|// which the branch proceeds on local knowledge instead of blocking\n85|// forever.\n86|const DefaultMeshRefreshTimeout = 5 * time.Second\n87|\n88|// RefreshWinner is one mesh lease-refresh answer: the winning lease\n89|// tuple and its holder host.\n90|type RefreshWinner struct {\n91|\tLeaseID      string\n92|\tEpoch        uint64\n93|\tHolderHostID string\n94|}\n95|\n96|// OpRequest is one lifecycle operation request: the operation name,\n97|// its closed body, the presented source state, the admitted\n98|// capabilities, and the fencing material (for terminate-stale only).\n99|type OpRequest struct {\n100|\tOperation            string\n101|\tBody                 []byte\n102|\tSource               string\n103|\tAdmitted             terminalbackend.Admitted\n104|\tPresented            fencing.PresentedToken\n105|\tWinner               sessrepo.LeaseSummary\n106|\tHasWinner            bool\n107|\tForceRecovery        bool\n108|\tDiagnosticsPreserved bool\n109|}\n110|\n111|// AttachOutcome is the attach success payload: the client mirror, the\n112|// host-local descriptor, the authorized input boolean, and the\n113|// evidence. The result input boolean always equals the request and the\n114|// authorization; the landed CheckAttachResult proves it on every call.\n115|type AttachOutcome struct {\n116|\tClientMirrorID  string\n117|\tDescriptor      string\n118|\tInputAuthorized bool\n119|\tEvidenceIDs     []string\n120|}\n121|\n122|// OpOutcome is one executed operation: exactly one of Mutation,\n123|// Status, or Attach is set, plus the per-operation success members.\n124|// Mutation is set on every executed mutating path — success and\n125|// coded failure alike, mirroring the engine — and nil only when the\n126|// request was malformed before any result existed.\n127|type OpOutcome struct {\n128|\tOperation              terminalbackend.Operation\n129|\tMutation               *terminstance.Result\n130|\tStatus                 *terminstance.StatusReport\n131|\tAttach                 *AttachOutcome\n132|\tArgv                   []string\n133|\tBinding                *termbind.Binding\n134|\tDescriptor             *string\n135|\tPriorBindingID         string\n136|\tRestoredParked         bool\n137|\tTargetClosed           bool\n138|\tProcessClosed          bool\n139|\tStoreClosed            bool\n140|\tQuiescenceGeneration   string\n141|\tInputClosedAt          string\n142|\tSafeBoundaryEvidenceID string\n143|\tBoundaryObservedAt     string\n144|}\n145|\n146|// Execute runs one lifecycle operation to its outcome. Refusals\n147|// precede side effects: malformed operations, unknown backends, and\n148|// unsafe sockets refuse before any store or tmux interaction. The\n149|// socket custody (before-connect rejection) and length refusal run on\n150|// every operation, because every operation connects.\n151|func (lc *Lifecycle) Execute(ctx context.Context, req OpRequest) (OpOutcome, error) {\n152|\tempty := OpOutcome{}\n153|\tif lc == nil || lc.Runner == nil || lc.Receipts == nil || lc.Bindings == nil ||\n154|\t\tlc.Attach == nil || lc.States == nil ||\n155|\t\tlc.CurrentLease == nil || lc.CurrentGeneration == nil || lc.Now == nil {\n156|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle dependencies\"}\n157|\t}\n158|\toperation, err := terminalbackend.ParseOperation(req.Operation)\n159|\tif err != nil {\n160|\t\treturn empty, err\n161|\t}\n162|\tif _, err := DirectivesFor(operation); err != nil {\n163|\t\treturn empty, err\n164|\t}\n165|\tsocket := SocketPath(lc.RuntimeDir)\n166|\tif err := CheckSocketLength(socket, lc.Platform); err != nil {\n167|\t\treturn empty, err\n168|\t}\n169|\tif err := CheckSocketCustody(socket, lc.Root, lc.Platform); err != nil {\n170|\t\treturn empty, err\n171|\t}\n172|\tswitch operation {\n173|\tcase terminalbackend.OperationCreate:\n174|\t\treturn lc.executeCreate(ctx, req, socket)\n175|\tcase terminalbackend.OperationAttach:\n176|\t\treturn lc.executeAttach(ctx, req, socket)\n177|\tcase terminalbackend.OperationStatus:\n178|\t\treturn lc.executeStatus(ctx, req, socket)\n179|\tcase terminalbackend.OperationQuiesceInput:\n180|\t\treturn lc.executeEngineOp(ctx, req, socket, operation)\n181|\tcase terminalbackend.OperationWaitSafeBoundary:\n182|\t\treturn lc.executeEngineOp(ctx, req, socket, operation)\n183|\tcase terminalbackend.OperationRequestStop:\n184|\t\treturn lc.executeEngineOp(ctx, req, socket, operation)\n185|\tcase terminalbackend.OperationTerminateStale:\n186|\t\treturn lc.executeTerminate(ctx, req, socket)\n187|\tcase terminalbackend.OperationRestore:\n188|\t\treturn lc.executeRestore(ctx, req, socket)\n189|\tdefault:\n190|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle operation\"}\n191|\t}\n192|}\n193|\n194|// engineFor builds the per-call landed engine over a request-scoped\n195|// tmux backend. The engine is a plain struct: constructing one per\n196|// call keeps request identity out of shared state.\n197|func (lc *Lifecycle) engineFor(reqBackend *backend) *terminstance.Engine {\n198|\treturn &terminstance.Engine{\n199|\t\tStore:             lc.Receipts,\n200|\t\tBackend:           reqBackend,\n201|\t\tCurrentLease:      lc.CurrentLease,\n202|\t\tCurrentGeneration: lc.CurrentGeneration,\n203|\t\tNow:               lc.Now,\n204|\t\tHooks:             lc.Hooks,\n205|\t}\n206|}\n207|\n208|// requestBackend builds the request-scoped tmux backend over the\n209|// lifecycle stores and the admitted set.\n210|func (lc *Lifecycle) requestBackend(req OpRequest, socket, session, instance string) *backend {\n211|\tsleep := lc.Sleep\n212|\tif sleep == nil {\n213|\t\tsleep = time.Sleep\n214|\t}\n215|\tpoll := lc.PollInterval\n216|\tif poll <= 0 {\n217|\t\tpoll = 50 * time.Millisecond\n218|\t}\n219|\treturn &backend{\n220|\t\trunner:     lc.Runner,\n221|\t\truntimeDir: lc.RuntimeDir,\n222|\t\tsocket:     socket,\n223|\t\tsessionID:  session,\n224|\t\tinstanceID: instance,\n225|\t\tnow:        lc.Now,\n226|\t\tsleep:      sleep,\n227|\t\tpoll:       poll,\n228|\t\tadmitted:   req.Admitted,\n229|\t\tbindings:   lc.Bindings,\n230|\t\tattach:     lc.Attach,\n231|\t\tstates:     lc.States,\n232|\t\tkillExit:   -1,\n233|\t}\n234|}\n235|\n236|// recordAfter records the adopted after-state in the AX-side memory on\n237|// every executed path. The memory is advisory: the idempotency receipt\n238|// is the commit, and a failed Record leaves later status reads to\n239|// reconcile from live presence — so a Record failure never fails the\n240|// operation it follows, and a hook-staged failure test pins exactly\n241|// that specified behavior.\n242|func (lc *Lifecycle) recordAfter(instance string, after terminalbackend.InstanceState) {\n243|\tif lc.States == nil {\n244|\t\treturn\n245|\t}\n246|\t_ = lc.States.Record(instance, after)\n247|}\n248|\n249|// mutationResult assembles a lifecycle result with the engine's\n250|// buildResult contract: repeated request identities, before/after\n251|// states, bytewise-sorted effects and evidence, and one disposition.\n252|func mutationResult(mctx terminstance.MutationContext, before, after terminalbackend.InstanceState, effects []terminalbackend.SideEffect, evidence []string, disposition terminstance.RetryDisposition) terminstance.Result {\n253|\treturn terminstance.Result{\n254|\t\tOperationID:           mctx.OperationID,\n255|\t\tSessionID:             mctx.SessionID,\n256|\t\tTerminalInstanceID:    mctx.TerminalInstanceID,\n257|\t\tTerminalBackendID:     mctx.TerminalBackendID,\n258|\t\tImplementationVersion: mctx.ImplementationVersion,\n259|\t\tProtocolVersion:       mctx.ProtocolVersion,\n260|\t\tBackendGeneration:     mctx.BackendGeneration,\n261|\t\tBefore:                before,\n262|\t\tAfter:                 after,\n263|\t\tEffects:               sortedEffects(effects),\n264|\t\tEvidenceIDs:           sortedEvidence(evidence),\n265|\t\tDisposition:           disposition,\n266|\t}\n267|}\n268|\n269|// checkLifecycleBackend admits exactly the tmux backend identity: this\n270|// lifecycle executes for ax.tmux and no other backend. A request\n271|// naming any other backend refuses the failed local precondition,\n272|// never executes against the wrong backend.\n273|func checkLifecycleBackend(backendID string) error {\n274|\tif backendID != terminalbackend.BuiltinTmux {\n275|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"lifecycle backend\"}\n276|\t}\n277|\treturn nil\n278|}\n279|\n280|// checkBindingAgreement binds the create binding to its mutation\n281|// context: session, instance, backend, and generation must all agree.\n282|// Any disagreement refuses the failed local precondition: the binding\n283|// names another creation.\n284|func checkBindingAgreement(body CreateBody) error {\n285|\tif body.Binding.SessionID != body.Context.SessionID ||\n286|\t\tbody.Binding.TerminalInstanceID != body.Context.TerminalInstanceID ||\n287|\t\tbody.Binding.TerminalBackendID != body.Context.TerminalBackendID ||\n288|\t\tbody.Binding.BackendGeneration != body.Context.BackendGeneration {\n289|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"create binding agreement\"}\n290|\t}\n291|\treturn nil\n292|}\n293|\n294|// rowError normalizes a backend- or store-reported code against one\n295|// operation's allowed set: an in-row code propagates with its report,\n296|// while an outside-set code is itself refused as the protocol error —\n297|// the engine's CheckErrorAllowed arm, mirrored for the operations the\n298|// engine scope leaves out.\n299|func rowError(operation terminalbackend.Operation, err error) error {\n300|\tcode := backendErrorCode(err)\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
