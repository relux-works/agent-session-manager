    run: go run ./internal/traceability/cmd/tracecheck\\n\\n      # The diff proves the committed catalog matches generator output, but\\n      # `go generate` runs nothing when its directive is disarmed: rewriting\\n      # `//go:generate` as `// go:generate` preserves the token while turning\\n      # the directive into a plain comment, so generation is skipped and the\\n      # diff stays clean. The anchored check refuses that token-preserving\\n      # rewrite; only the exact directive form counts. A new directive\\n      # without a pin update reddens here (and in\\n      # TestGenerateDirectiveStaysRecognizedForm) instead of going unchecked.\\n      - name: Verify generated catalog is current\\n        run: |\\n          test \\\"$(grep -c '^//go:generate' internal/catalog/catalog.go)\\\" -eq 1\\n          go generate ./internal/catalog\\n          git diff --exit-code -- internal/catalog/catalog_gen.go\\n\\n      # The release roots are derived from internal/specpin and\\n      # internal/catalog inside the gate, never retyped here. Each -- PASS\\n      # guard below must match: a selector that runs nothing fails here\\n      # instead of passing silently.\\n      - name: Run pinned contract-version gates\\n        run: |\\n          set +e\\n          go test ./internal/cigate -run 'TestVerifyContractPreservationLive|TestPinnedReleasesAgreeAcrossAuthorities|TestDerivedSetsAreComplete|TestCheckAgreementAdmitsIdenticalSets|TestCheckAgreementRefusals|TestCheckReleaseRootsRefusesDrift' -count=1 -v > cigate-contracts.log 2>&1\\n          code=$?\\n{\\n  \\\"agents\\\": [\\n    \\\"claude_code\\\",\\n    \\\"codex_cli\\\"\\n  ],\\n  \\\"schema_version\\\": 1,\\n  \\\"skills\\\": [\\n    {\\n      \\\"git\\\": \\\"https://github.com/relux-works/skill-go-testing-tools\\\",\\n      \\\"name\\\": \\\"go-testing-tools\\\",\\n      \\\"revision\\\": \\\"90c1515239eed9321068f3bafbeb5d0a0c2aa26a\\\"\\n    }\\n  ]\\n}\\n\",\n  \"original_output_bytes\": 2873,\n  \"original_output_tokens\": 719,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
