{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000de33","stream":{"kind":"session","id":"01a0c7e8-b0ce-7b51-a856-c1e5aeba35b8"},"sequence":3444,"recorded_at":1780531400006883,"record_type":"event","durability":"durable","causation_id":"1e747257-7dba-4be5-8162-7ca370e28419","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1e747257-7dba-4be5-8162-7ca370e28419","run_stream":{"kind":"run","id":"1e747257-7dba-4be5-8162-7ca370e28419"},"task_stream":{"kind":"task","id":"01a0c800-7be3-7fe2-92c3-7bab11af33a2"},"task_id":"01a0c800-7be3-7fe2-92c3-7bab11af33a2","event":{"kind":"output","task_id":"01a0c800-7be3-7fe2-92c3-7bab11af33a2","chunk":"{\n  \"chunk_id\": \"exec-96-1\",\n  \"command\": \"python3 - <<'PYEOF'\\nimport re, subprocess\\nfrom pathlib import Path\\nraw = Path(\\\"internal/tmuxserver/TRACEABILITY.md\\\").read_text()\\ndefined = set(re.findall(r\\\"^func (Test\\\\w+)\\\\(\\\", subprocess.run(\\n    [\\\"grep\\\", \\\"-rh\\\", \\\"^func Test\\\", \\\"internal/tmuxserver/\\\"], capture_output=True, text=True).stdout, re.M))\\nharness = Path(\\\"internal/tmuxserver/mutant_harness.py\\\").read_text()\\nrows = set(re.findall(r'name=\\\"([A-Za-z0-9_-]+)\\\"', harness))\\n# Census M cells: test names after 'M ' up to ' /'\\nmissing_tests, missing_rows = set(), set()\\nfor m in re.finditer(r\\\"M ([A-Za-z0-9_,/()+-][^/]*?) / ([A-Za-z0-9_,\\\\-+() ]+?)(?=\\\\||$)\\\", raw):\\n    tests, nrows = m.group(1), m.group(2)\\n    for t in re.split(r\\\"[,\\\\s]+\\\", tests):\\n        t = t.strip().split(\\\"/\\\")[0].rstrip(\\\")\\\")\\n        if not t or t in (\\\"same\\\", \\\"row\\\", \\\"rows\\\", \\\"shared\\\", \\\"EachOperation\\\", \\\"+\\\", \\\"(B22\\\", \\\"at\\\", \\\"EXS\\\", \\\"rowless\\\"):\\n            continue\\n        if t.startswith(\\\"Test\\\"):\\n            base = t\\n        else:\\n            base = \\\"Test\\\" + t\\n        # skip prose fragments\\n        if re.match(r\\\"Test[A-Z][A-Za-z0-9]*$\\\", base) and base not in defined:\\n            missing_tests.add(base)\\n    for r in re.split(r\\\"[,\\\\s]+\\\", nrows):\\n        r = r.strip().rstrip(\\\").\\\")\\n        if re.match(r\\\"[NCDB]-[a-z0-9-]+$\\\", r) and r not in rows:\\n            missing_rows.add(r)\\nprint(\\\"missing census tests:\\\", sorted(missing_tests) if missing_tests else \\\"none\\\")\\nprint(\\\"missing census rows:\\\", sorted(missing_rows) if missing_rows else \\\"none\\\")\\nPYEOF\",\n  \"description\": \"Check census M-cell references resolve\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"missing census tests: ['TestABG', 'TestAFG', 'TestARG', 'TestAcrossServerGeneration', 'TestAdmitsCompliant', 'TestAncestorKindArm', 'TestAttach', 'TestAttachClient', 'TestAttachErrorsOnCorruptBarrierScan', 'TestAttachReadOnlyVector', 'TestAttachRefusals', 'TestAttachRequiresInputFlag', 'TestAttachedExitIsUnknown', 'TestB', 'TestB22', 'TestB23', 'TestB24', 'TestB25', 'TestB28', 'TestB29', 'TestB39', 'TestBG', 'TestBRO', 'TestBarrierSequence', 'TestBindHookFailure', 'TestBindingAgreement', 'TestBindingConflict', 'TestBindingDocRoundTrip', 'TestBindingTamperRefusesIntegrity', 'TestBoundary', 'TestBoundaryBarrierSurvivesStateWriteFailure', 'TestBoundaryBindsProofKind', 'TestBoundaryRefusedExit', 'TestBoundaryRefusesFailedWait', 'TestBoundaryReplayKeepsProofAndTime', 'TestBoundaryTimeout', 'TestBoundaryWaitTimeout', 'TestBounds', 'TestCLS', 'TestCMD', 'TestCRE', 'TestCUS', 'TestComplete', 'TestCorruptOutcomeRefusesIntegrity', 'TestCountsBytes', 'TestCoversEightRows', 'TestCreateInteractive', 'TestCreatePersistsBindingDocForRestore', 'TestDIAL', 'TestDIRV', 'TestENS', 'TestEX', 'TestEXA', 'TestEXC', 'TestEXE', 'TestEXR', 'TestEXT', 'TestEmitsNoProviderInput', 'TestEmptyRecordedTimeRefusesIntegrity', 'TestEnforcesLengthAndCustody', 'TestEscalationKillFailure', 'TestExactBackendDriftNonMatches', 'TestExactProtocolDriftNonMatches', 'TestExactUnb