{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7f9","stream":{"kind":"session","id":"01a0c7e8-b0ce-7b51-a856-c1e5aeba35b8"},"sequence":599,"recorded_at":1780531400001193,"record_type":"event","durability":"durable","causation_id":"1e747257-7dba-4be5-8162-7ca370e28419","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1e747257-7dba-4be5-8162-7ca370e28419","run_stream":{"kind":"run","id":"1e747257-7dba-4be5-8162-7ca370e28419"},"task_stream":{"kind":"task","id":"01a0c7ea-23bb-7143-990f-b42ff9b37368"},"task_id":"01a0c7ea-23bb-7143-990f-b42ff9b37368","event":{"kind":"output","task_id":"01a0c7ea-23bb-7143-990f-b42ff9b37368","chunk":"Read text file `internal/tmuxserver/lifecycle.go`.\n(299 line(s) above)\n300|\tcode := backendErrorCode(err)\n301|\tif code == \"\" {\n302|\t\treturn err\n303|\t}\n304|\tif checkErr := terminalbackend.CheckErrorAllowed(string(operation), code); checkErr != nil {\n305|\t\treturn &Error{Code: terminalbackend.CodeProtocolError, Detail: \"operation error vocabulary\"}\n306|\t}\n307|\treturn err\n308|}\n309|\n310|// formatTimestamp renders Now in the scalar timestamp grammar: UTC\n311|// RFC3339 with millisecond precision, always carrying the fractional\n312|// digits the grammar requires.\n313|func formatTimestamp(now time.Time) string {\n314|\treturn now.UTC().Format(\"2006-01-02T15:04:05.000Z07:00\")\n315|}\n316|\n317|// executeCreate runs the full create body: closed-shape admission,\n318|// backend and transport gates, binding agreement, then the landed\n319|// engine with the tmux backend. The result echoes the carried binding\n320|// and, exactly when interactive, the unbound attach descriptor.\n321|func (lc *Lifecycle) executeCreate(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n322|\tempty := OpOutcome{Operation: terminalbackend.OperationCreate}\n323|\tbody, err := parseCreateBody(req.Body)\n324|\tif err != nil {\n325|\t\treturn empty, err\n326|\t}\n327|\tif err := checkLifecycleBackend(body.Context.TerminalBackendID); err != nil {\n328|\t\treturn empty, err\n329|\t}\n330|\tif body.Transport == string(terminalbackend.TransportThirdPartyRelay) {\n331|\t\treturn empty, &Error{Code: terminalbackend.CodeUnauthorized, Detail: \"create relay transport\"}\n332|\t}\n333|\tif err := checkBindingAgreement(body); err != nil {\n334|\t\treturn empty, err\n335|\t}\n336|\treqBackend := lc.requestBackend(req, socket, body.Context.SessionID, body.Context.TerminalInstanceID)\n337|\treqBackend.operation = terminalbackend.OperationCreate\n338|\treqBackend.bootstrapID = body.BootstrapOperationID\n339|\treqBackend.bindingID = body.Binding.BindingID\n340|\treqBackend.bindingDoc = append([]byte(nil), body.BindingRaw...)\n341|\tresult, err := lc.engineFor(reqBackend).ExecuteMutating(ctx, terminalbackend.OperationCreate, body.Context, terminstance.Params{\n342|\t\tBootstrapOperationID: body.BootstrapOperationID,\n343|\t\tInteractive:          body.Interactive,\n344|\t}, terminalbackend.InstanceState(req.Source), req.Admitted)\n345|\toutcome := OpOutcome{Operation: terminalbackend.OperationCreate, Binding: &body.Binding}\n346|\tif result.OperationID != \"\" {\n347|\t\toutcome.Mutation = &result\n348|\t\tlc.recordAfter(body.Context.TerminalInstanceID, result.After)\n349|\t}\n350|\tif err != nil {\n351|\t\treturn outcome, err\n352|\t}\n353|\tif body.Interactive {\n354|\t\tdescriptor := createDescriptor(socket, body.Context.TerminalInstanceID)\n355|\t\toutcome.Descriptor = &descriptor\n356|\t}\n357|\treturn outcome, nil\n358|}\n359|\n360|// executeStatus runs one status query through the landed engine with\n361|// the tmux backend: no receipt, no side effects, no authorization.\n362|func (lc *Lifecycle) executeStatus(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n363|\tempty := OpOutcome{Operation: terminalbackend.OperationStatus}\n364|\tbody, err := terminstance.ParseStatusBody(req.Body)\n365|\tif err != nil {\n366|\t\treturn empty, err\n367|\t}\n368|\tif err := checkLifecycleBackend(body.TerminalBackendID); err != nil {\n369|\t\treturn empty, err\n370|\t}\n371|\tinstance := body.TerminalInstanceID\n372|\tif !body.HasTerminalInstanceID {\n373|\t\tinstance = \"\"\n374|\t}\n375|\treqBackend := lc.requestBackend(req, socket, body.SessionID, instance)\n376|\treqBackend.operation = terminalbackend.OperationStatus\n377|\treport, err := lc.engineFor(reqBackend).ExecuteStatus(ctx, body, terminalbackend.InstanceState(req.Source), req.Admitted)\n378|\tif err != nil {\n379|\t\treturn empty, err\n380|\t}\n381|\treturn OpOutcome{Operation: terminalbackend.OperationStatus, Status: &report}, nil\n382|}\n383|\n384|// executeEngineOp runs one quiesce-input, wait-safe-boundary, or\n385|// request-stop body through the landed engine with the tmux backend,\n386|// adding the per-operation success members the engine's receipt scope\n387|// leaves out.\n388|func (lc *Lifecycle) executeEngineOp(ctx context.Context, req OpRequest, socket string, operation terminalbackend.Operation) (OpOutcome, error) {\n389|\tempty := OpOutcome{Operation: operation}\n390|\tmctx, params, err := terminstance.ParseOperationBody(string(operation), req.Body)\n391|\tif err != nil {\n392|\t\treturn empty, err\n393|\t}\n394|\tif err := checkLifecycleBackend(mctx.TerminalBackendID); err != nil {\n395|\t\treturn empty, err\n396|\t}\n397|\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n398|\treqBackend.operation = operation\n399|\tswitch operation {\n400|\tcase terminalbackend.OperationWaitSafeBoundary:\n401|\t\treqBackend.quiescence = params.QuiescenceGeneration\n402|\t\treqBackend.channel = BoundaryChannelPrefix + params.QuiescenceGeneration\n403|\t\treqBackend.proofKind = params.ProviderProofKind\n404|\t\twaitCtx, cancel := lc.boundWait(ctx, mctx, params.TimeoutMs)\n405|\t\tdefer cancel()\n406|\t\treqBackend.waitCtx = waitCtx\n407|\tcase terminalbackend.OperationRequestStop:\n408|\t\treqBackend.deadline = lc.lesserDeadline(mctx, params.GracefulTimeoutMs)\n409|\t}\n410|\tresult, err := lc.engineFor(reqBackend).ExecuteMutating(ctx, operation, mctx, params, terminalbackend.InstanceState(req.Source), req.Admitted)\n411|\toutcome := OpOutcome{Operation: operation}\n412|\tif result.OperationID != \"\" {\n413|\t\toutcome.Mutation = &result\n414|\t\tlc.recordAfter(mctx.TerminalInstanceID, result.After)\n415|\t}\n416|\tif err != nil {\n417|\t\treturn outcome, err\n418|\t}\n419|\tswitch operation {\n420|\tcase terminalbackend.OperationQuiesceInput:\n421|\t\toutcome.QuiescenceGeneration = params.QuiescenceGeneration\n422|\t\tclosedAt, err := lc.reportInputClosedAt(mctx.IdempotencyKey)\n423|\t\tif err != nil {\n424|\t\t\treturn outcome, err\n425|\t\t}\n426|\t\toutcome.InputClosedAt = closedAt\n427|\tcase terminalbackend.OperationWaitSafeBoundary:\n428|\t\t// The boundary transition carries exactly one effect, and the\n429|\t\t// engine evidences every committed effect exactly once, so a\n430|\t\t// successful boundary result carries exactly one evidence ID.\n431|\t\toutcome.SafeBoundaryEvidenceID = result.EvidenceIDs[0]\n432|\t\tobservedAt, err := lc.reportBoundaryObservedAt(mctx.IdempotencyKey)\n433|\t\tif err != nil {\n434|\t\t\treturn outcome, err\n435|\t\t}\n436|\t\toutcome.BoundaryObservedAt = observedAt\n437|\tcase terminalbackend.OperationRequestStop:\n438|\t\toutcome.ProcessClosed = true\n439|\t\toutcome.StoreClosed = true\n440|\t}\n441|\treturn outcome, nil\n442|}\n443|\n444|// reportInputClosedAt replays the recorded input-closed time for one\n445|// quiesce key, recording the current time on first success. A failed\n446|// or forged lookup is corruption, never absence: the retry refuses\n447|// the integrity failure instead of manufacturing a fresh closure\n448|// time for an already-closed input. A record failure refuses the\n449|// same way: the effect is committed but its time is unprovable, so\n450|// the retry re-records rather than reporting an unrecorded time.\n451|func (lc *Lifecycle) reportInputClosedAt(key string) (string, error) {\n452|\tstored, found, err := lc.States.LookupOutcome(key)\n453|\tif err != nil {\n454|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"quiesce outcome image\"}\n455|\t}\n456|\tif found {\n457|\t\tif stored.InputClosedAt == \"\" {\n458|\t\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"quiesce outcome image\"}\n459|\t\t}\n460|\t\treturn stored.InputClosedAt, nil\n461|\t}\n462|\trendered := formatTimestamp(lc.Now())\n463|\tif err := lc.States.RecordOutcome(key, OperationOutcome{Operation: string(terminalbackend.OperationQuiesceInput), InputClosedAt: rendered}); err != nil {\n464|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"quiesce outcome image\"}\n465|\t}\n466|\treturn rendered, nil\n467|}\n468|\n469|// reportBoundaryObservedAt replays the recorded boundary-observed\n470|// time for one boundary key, recording the current time on first\n471|// success, with the same corrupt-read and record-failure discipline\n472|// as the quiesce report: no failed read becomes fresh evidence.\n473|func (lc *Lifecycle) reportBoundaryObservedAt(key string) (string, error) {\n474|\tstored, found, err := lc.States.LookupOutcome(key)\n475|\tif err != nil {\n476|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"boundary outcome image\"}\n477|\t}\n478|\tif found {\n479|\t\tif stored.BoundaryObservedAt == \"\" {\n480|\t\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"boundary outcome image\"}\n481|\t\t}\n482|\t\treturn stored.BoundaryObservedAt, nil\n483|\t}\n484|\trendered := formatTimestamp(lc.Now())\n485|\tif err := lc.States.RecordOutcome(key, OperationOutcome{Operation: string(terminalbackend.OperationWaitSafeBoundary), BoundaryObservedAt: rendered}); err != nil {\n486|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"boundary outcome image\"}\n487|\t}\n488|\treturn rendered, nil\n489|}\n490|\n491|// boundWait bounds the safe-boundary wait by the lesser of the request\n492|// deadline and the timeout: the wait context carries the minimum, and\n493|// an already-invalid deadline falls back to the timeout alone (the\n494|// engine refuses the malformed deadline before any effect runs, so the\n495|// fallback never binds). The caller cancels the context.\n496|func (lc *Lifecycle) boundWait(ctx context.Context, mctx terminstance.MutationContext, timeoutMs uint64) (context.Context, context.CancelFunc) {\n497|\tbound := lc.Now().Add(time.Duration(timeoutMs) * time.Millisecond)\n498|\tif deadline, err := mctx.Deadline.Time(); err == nil && deadline.Before(bound) {\n499|\t\tbound = deadline\n500|\t}\n501|\treturn context.WithDeadline(ctx, bound)\n502|}\n503|\n504|// lesserDeadline computes the lesser of the request deadline and the\n505|// graceful timeout for the stop close-confirm poll. An invalid\n506|// deadline falls back the same way as the boundary wait.\n507|func (lc *Lifecycle) lesserDeadline(mctx terminstance.MutationContext, timeoutMs uint64) time.Time {\n508|\tbound := lc.Now().Add(time.Duration(timeoutMs) * time.Millisecond)\n509|\tif deadline, err := mctx.Deadline.Time(); err == nil && deadline.Before(bound) {\n510|\t\treturn deadline\n511|\t}\n512|\treturn bound\n513|}","final_result":true}}}
