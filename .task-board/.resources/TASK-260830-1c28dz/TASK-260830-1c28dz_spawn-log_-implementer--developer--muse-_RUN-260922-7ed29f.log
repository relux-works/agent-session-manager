{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c855","stream":{"kind":"session","id":"01a0c7e8-b0ce-7b51-a856-c1e5aeba35b8"},"sequence":645,"recorded_at":1780531400001285,"record_type":"event","durability":"durable","causation_id":"1e747257-7dba-4be5-8162-7ca370e28419","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1e747257-7dba-4be5-8162-7ca370e28419","run_stream":{"kind":"run","id":"1e747257-7dba-4be5-8162-7ca370e28419"},"task_stream":{"kind":"task","id":"01a0c7ea-3587-7a32-a2fc-731fae9cd524"},"task_id":"01a0c7ea-3587-7a32-a2fc-731fae9cd524","event":{"kind":"output","task_id":"01a0c7ea-3587-7a32-a2fc-731fae9cd524","chunk":"Read text file `internal/tmuxserver/ops.go`.\n(299 line(s) above)\n300|// the context and body. Any disagreement refuses the failed local\n301|// precondition: the retry would authorize a different target than the\n302|// key names.\n303|func checkTerminateTarget(mctx terminstance.MutationContext, body TerminateBody, presented fencing.PresentedToken) error {\n304|\tif presented.SessionID != mctx.SessionID ||\n305|\t\tpresented.LeaseID != body.StaleLeaseID ||\n306|\t\tpresented.Epoch != body.StaleEpoch {\n307|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate target binding\"}\n308|\t}\n309|\treturn nil\n310|}\n311|\n312|// checkTerminateWinner binds the caller-observed winner to the\n313|// re-read current lease: the fencing authorization decides over the\n314|// caller's winner, and only a winner that still wins authorizes. A\n315|// rotated or misobserved winner refuses the failed local\n316|// precondition; the caller re-observes and retries. Absence of a\n317|// winner never reaches here — the fencing gate refuses it first.\n318|func checkTerminateWinner(mctx terminstance.MutationContext, winner sessrepo.LeaseSummary, lease terminstance.LeaseView) error {\n319|\tif winner.SessionID != mctx.SessionID ||\n320|\t\twinner.LeaseID != lease.LeaseID ||\n321|\t\twinner.Epoch != lease.Epoch {\n322|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate winner binding\"}\n323|\t}\n324|\treturn nil\n325|}\n326|\n327|// executeRestore runs one restore: closed-shape admission, idempotency\n328|// material, capability conferral plus the reboot conditional,\n329|// transition, restore authorization, generation recheck, prior-binding\n330|// mismatch, deadline, receipt discipline with status-reconciled\n331|// resume, the persist plus wrapper-restored effects, and the required\n332|// result binding. The wire result is always parked. The backend\n333|// launches no provider: the wrapper owns launch gating through the\n334|// after-restore composition (ExecuteWrapperRestore), and this entry\n335|// only recreates the wrapper process.\n336|//\n337|// The result binding is the create-time document kept alongside the\n338|// bootstrap receipt, re-admitted by termbind on the read — within one\n339|// generation — or its minted successor across a reboot: the termbind\n340|// owner succeeds the prior (the JCS identity rule stays\n341|// termbind-private) and the successor persists under the same pair\n342|// key. The prior-binding mismatch arm proves the carried prior equals\n343|// the recorded digest; the document read proves a valid binding for\n344|// this session, instance, and backend.\n345|func (lc *Lifecycle) executeRestore(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n346|\tempty := OpOutcome{Operation: terminalbackend.OperationRestore}\n347|\tbody, err := parseRestoreBody(req.Body)\n348|\tif err != nil {\n349|\t\treturn empty, err\n350|\t}\n351|\toperation := terminalbackend.OperationRestore\n352|\tmctx := body.Context\n353|\tsource := terminalbackend.InstanceState(req.Source)\n354|\tif err := checkLifecycleBackend(mctx.TerminalBackendID); err != nil {\n355|\t\treturn empty, err\n356|\t}\n357|\tderived, err := terminalbackend.IdempotencyKey(string(operation), mctx.SessionID, body.BootstrapOperationID)\n358|\tif err != nil {\n359|\t\treturn empty, err\n360|\t}\n361|\tif mctx.IdempotencyKey != derived {\n362|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"idempotency key material\"}\n363|\t}\n364|\tif err := terminalbackend.CheckOperation(string(operation), req.Admitted); err != nil {\n365|\t\tfailure := rowError(operation, err)\n366|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n367|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n368|\t}\n369|\tif !req.Admitted.Has(\"reboot_restoration\") {\n370|\t\tfailure := &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n371|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n372|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n373|\t}\n374|\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), false)\n375|\tif err != nil {\n376|\t\tfailure := rowError(operation, err)\n377|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n378|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n379|\t}\n380|\tif err := terminstance.CheckAuthorization(mctx.Authorization, terminstance.AuthorizationRestore, lc.CurrentLease(), lc.Now()); err != nil {\n381|\t\tfailure := rowError(operation, err)\n382|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n383|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n384|\t}\n385|\tif lc.CurrentGeneration() != mctx.BackendGeneration {\n386|\t\tfailure := &Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation stale\"}\n387|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n388|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n389|\t}\n390|\tif err := lc.checkPriorBinding(body); err != nil {\n391|\t\tvar local *Error\n392|\t\tif errors.As(err, &local) && local.Code == terminalbackend.CodeRestoreMismatch {\n393|\t\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n394|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n395|\t\t}\n396|\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n397|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n398|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n399|\t}\n400|\tdeadline, err := mctx.Deadline.Time()\n401|\tif err != nil {\n402|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"mutation context deadline\"}\n403|\t}\n404|\tif !lc.Now().Before(deadline) {\n405|\t\tfailure := &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n406|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionReplaySame)\n407|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n408|\t}\n409|\t// The prior binding validates before the receipt binds and the\n410|\t// wrapper recreates: a missing, corrupt, or disagreeing prior\n411|\t// refuses here, never after the irreversible effects.\n412|\tif _, err := lc.readRestorePrior(mctx, body); err != nil {\n413|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n414|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n415|\t}\n416|\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n417|\treqBackend.operation = operation\n418|\treqBackend.bootstrapID = body.BootstrapOperationID\n419|\t// The persist effect replays the recorded pair receipt (verified\n420|\t// by the mismatch arm above); the candidate carries the matched\n421|\t// prior digest so the store admits its shape on the replay path.\n422|\treqBackend.bindingID = body.PriorBindingID\n423|\toutcome, err := lc.executeWithReceipt(ctx, req, socket, operation, mctx, source, target, effects, deadline, terminstance.AuthorizationRestore, reqBackend, func(result terminstance.Result) OpOutcome {\n424|\t\treturn OpOutcome{Operation: operation, Mutation: &result, PriorBindingID: body.PriorBindingID, RestoredParked: true}\n425|\t})\n426|\tif err != nil {\n427|\t\treturn outcome, err\n428|\t}\n429|\tbinding, err := lc.restoreBinding(mctx, body)\n430|\tif err != nil {\n431|\t\treturn outcome, err\n432|\t}\n433|\toutcome.Binding = binding\n434|\treturn outcome, nil\n435|}\n436|\n437|// readRestorePrior reads the create-time binding document kept under\n438|// the (session, bootstrap) pair, re-admitted by the termbind owner,\n439|// and proves it names this restore's session, instance, and backend.\n440|// Generation is not compared here: after a reboot the restore carries\n441|// the new server generation while the prior still names the old one,\n442|// and succession (not agreement) resolves that drift. A missing\n443|// document is the backend store failure — the receipt proved the\n444|// prior, but the payload is gone, so the required result cannot be\n445|// built. A document that fails termbind admission, or that names\n446|// another session, instance, or backend than the mutation context, is\n447|// the integrity failure: the store disagrees with the receipt it\n448|// stands beside.\n449|func (lc *Lifecycle) readRestorePrior(mctx terminstance.MutationContext, body RestoreBody) (termbind.Binding, error) {\n450|\tempty := termbind.Binding{}\n451|\tdoc, found, err := lc.States.LookupBindingDoc(mctx.SessionID, body.BootstrapOperationID)\n452|\tif err != nil {\n453|\t\treturn empty, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n454|\t}\n455|\tif !found {\n456|\t\treturn empty, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n457|\t}\n458|\tbinding, err := termbind.ParseTerminalBinding(doc)\n459|\tif err != nil {\n460|\t\treturn empty, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n461|\t}\n462|\tif binding.SessionID != mctx.SessionID ||\n463|\t\tbinding.TerminalInstanceID != mctx.TerminalInstanceID ||\n464|\t\tbinding.TerminalBackendID != mctx.TerminalBackendID {\n465|\t\treturn empty, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n466|\t}\n467|\treturn binding, nil\n468|}\n469|\n470|// restoreBinding builds the required restore result binding after the\n471|// effects commit. Within one generation the prior is the result: the\n472|// re-admitted create-time document the pre-effects validation already\n473|// proved. Across a reboot the mutation context carries the new server\n474|// generation, and the result is the minted successor: the termbind\n475|// owner succeeds the prior (new generation, supersedes link, fresh\n476|// identity), the successor persists under the same pair key, and the\n477|// same successor returns. The mint is deterministic, so a retry after\n478|// a crash between the effects and the persist converges on the\n479|// identical document instead of forking, and a retry after the\n480|// persist replays the stored successor without minting again.\n481|func (lc *Lifecycle) restoreBinding(mctx terminstance.MutationContext, body RestoreBody) (*termbind.Binding, error) {\n482|\tprior, err := lc.readRestorePrior(mctx, body)\n483|\tif err != nil {\n484|\t\treturn nil, err\n485|\t}\n486|\tif prior.BackendGeneration == mctx.BackendGeneration {\n487|\t\treturn &prior, nil\n488|\t}\n489|\tminted, raw, err := termbind.MintSuccessorBinding(prior, mctx.BackendGeneration)\n490|\tif err != nil {\n491|\t\treturn nil, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n492|\t}\n493|\tif err := lc.States.RecordBindingDoc(mctx.SessionID, body.BootstrapOperationID, raw); err != nil {\n494|\t\treturn nil, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding write\"}\n495|\t}\n496|\treturn &minted, nil\n497|}\n498|\n499|// checkPriorBinding enforces the restore mismatch rule: the recorded\n500|// bootstrap binding for the (session, bootstrap) pair must exist and\n501|// its digest must equal the carried prior_binding_id. Substituting any\n502|// other binding — including the configured default — refuses the\n503|// restore mismatch. A binding read failure is an error, never a\n504|// mismatch: unknown is not a verdict.\n505|func (lc *Lifecycle) checkPriorBinding(body RestoreBody) error {\n506|\trecorded, found, err := lc.Bindings.Lookup(body.Context.SessionID, body.BootstrapOperationID)\n507|\tif err != nil {\n508|\t\treturn err\n509|\t}\n510|\tif !found || recorded.BindingDigest != body.PriorBindingID {\n511|\t\treturn &Error{Code: terminalbackend.CodeRestoreMismatch, Detail: \"restore prior binding\"}\n512|\t}\n513|\treturn nil\n514|}\n515|\n516|// effectPerformer executes one lifecycle side effect and reports its\n517|// evidence ID, the single capability the receipt-bound effect loop\n518|// needs from the request backend.\n519|type effectPerformer interface {\n520|\tPerformEffect(ctx context.Context, effect terminalbackend.SideEffect) (string, error)\n521|}\n522|\n523|// executeWithReceipt binds the idempotency receipt and runs the\n524|// effects under it, mirroring the engine's bind discipline: an\n525|// identical retry replays the one completion, a bound key without its\n526|// completion reconciles through the production status entry before it\n527|// refuses, and no path binds a second receipt for one key. complete\n528|// maps the successful result into the operation outcome; failures\n529|// return the outcome with the mutation set, mirroring the engine.\n530|func (lc *Lifecycle) executeWithReceipt(ctx context.Context, req OpRequest, socket string, operation terminalbackend.Operation, mctx terminstance.MutationContext, source, target terminalbackend.InstanceState, effects []terminalbackend.SideEffect, deadline time.Time, kind terminstance.AuthorizationKind, reqBackend effectPerformer, complete func(terminstance.Result) OpOutcome) (OpOutcome, error) {\n531|\tkey := mctx.IdempotencyKey\n532|\t_, replayed, err := lc.Receipts.Bind(key, operation, mctx.OperationID)\n533|\tif err != nil {\n534|\t\tif backendErrorCode(err) != \"\" {\n535|\t\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n536|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, rowError(operation, err)\n537|\t\t}\n538|\t\tif _, found, lookupErr := lc.Receipts.Lookup(key); lookupErr == nil && !found {\n539|\t\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"idempotency store failure\"}\n540|\t\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n541|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n542|\t\t}\n543|\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"idempotency store failure\"}\n544|\t\tresult := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n545|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n546|\t}\n547|\tif replayed {\n548|\t\tstored, found, err := lc.Receipts.Completed(key)\n549|\t\tif err != nil {\n550|\t\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"idempotency store failure\"}\n551|\t\t\tresult := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n552|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n553|\t\t}\n554|\t\tif !found {\n555|\t\t\treturn lc.resumeUncertain(ctx, req, socket, operation, mctx, source, target, effects, deadline, kind, reqBackend, complete)\n556|\t\t}\n557|\t\tvar result terminstance.Result\n558|\t\tif err := json.Unmarshal(stored, &result); err != nil {\n559|\t\t\tfailure := &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"idempotency result image\"}\n560|\t\t\trebuilt := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n561|\t\t\treturn OpOutcome{Operation: operation, Mutation: &rebuilt}, failure\n562|\t\t}\n563|\t\tif err := terminstance.CheckResult(mctx, source, result); err != nil {\n564|\t\t\tif backendErrorCode(err) == \"\" {\n565|\t\t\t\tfailure := &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"idempotency result image\"}\n566|\t\t\t\trebuilt := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n567|\t\t\t\treturn OpOutcome{Operation: operation, Mutation: &rebuilt}, failure\n568|\t\t\t}\n569|\t\t\trebuilt := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionFor(backendErrorCode(err), true))\n570|\t\t\treturn OpOutcome{Operation: operation, Mutation: &rebuilt}, rowError(operation, err)\n571|\t\t}\n572|\t\treturn complete(result), nil\n573|\t}\n574|\tif lc.Hooks != nil && lc.Hooks.AfterReceipt != nil {\n575|\t\tlc.Hooks.AfterReceipt(operation, key, terminstance.InterimState(operation, source))\n576|\t}\n577|\treturn lc.runLifecycleEffects(ctx, operation, mctx, source, target, effects, deadline, kind, reqBackend, complete)\n578|}\n579|\n580|// resumeUncertain reconciles a bound key without its completion through\n581|// the production status entry: when status proves the presented source\n582|// state — nothing happened — the same operation continues under the\n583|// same receipt; when status proves anything else, or fails, the retry\n584|// refuses uncertain with status_first. No path binds a second receipt\n585|// for one key.\n586|func (lc *Lifecycle) resumeUncertain(ctx context.Context, req OpRequest, socket string, operation terminalbackend.Operation, mctx terminstance.MutationContext, source, target terminalbackend.InstanceState, effects []terminalbackend.SideEffect, deadline time.Time, kind terminstance.AuthorizationKind, reqBackend effectPerformer, complete func(terminstance.Result) OpOutcome) (OpOutcome, error) {\n587|\tbody := terminstance.StatusBody{\n588|\t\tSessionID:                  mctx.SessionID,\n589|\t\tTerminalInstanceID:         mctx.TerminalInstanceID,\n590|\t\tHasTerminalInstanceID:      true,\n591|\t\tTerminalBackendID:          mctx.TerminalBackendID,\n592|\t\tImplementationVersion:      mctx.ImplementationVersion,\n593|\t\tProtocolVersion:            mctx.ProtocolVersion,\n594|\t\tBackendGeneration:          mctx.BackendGeneration,\n595|\t\tHasBackendGeneration:       true,\n596|\t\tIncludeProviderObservation: false,\n597|\t\tDeadline:                   mctx.Deadline,\n598|\t}\n599|\tstatusBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n600|\tstatusBackend.operation = terminalbackend.OperationStatus\n601|\treport, err := lc.engineFor(statusBackend).ExecuteStatus(ctx, body, source, req.Admitted)\n602|\tif err != nil || report.State != source {\n603|\t\tfailure := &Error{Code: terminalbackend.CodeUnavailable, Detail: \"idempotency result uncertain\"}\n604|\t\tresult := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n605|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n606|\t}\n607|\tif lc.Hooks != nil && lc.Hooks.AfterReceipt != nil {\n608|\t\tlc.Hooks.AfterReceipt(operation, mctx.IdempotencyKey, terminstance.InterimState(operation, source))\n609|\t}\n610|\treturn lc.runLifecycleEffects(ctx, operation, mctx, source, target, effects, deadline, kind, reqBackend, complete)\n611|}\n612|\n613|// runLifecycleEffects performs the transition's side effects under an\n614|// already-bound receipt with the per-effect deadline, authorization,\n615|// and generation gates, then completes the key exactly once — the\n616|// engine's runEffects contract, second side. Fresh and resumed runs\n617|// share this loop. On success the after-state records in the AX-side\n618|// memory and the outcome completes; every failure returns the outcome\n619|// with the mutation set, mirroring the engine.\n620|func (lc *Lifecycle) runLifecycleEffects(ctx context.Context, operation terminalbackend.Operation, mctx terminstance.MutationContext, source, target terminalbackend.InstanceState, effects []terminalbackend.SideEffect, deadline time.Time, kind terminstance.AuthorizationKind, reqBackend effectPerformer, complete func(terminstance.Result) OpOutcome) (OpOutcome, error) {\n621|\tkey := mctx.IdempotencyKey\n622|\tcommitted := false\n623|\tevidence := []string(nil)\n624|\tperformed := []terminalbackend.SideEffect(nil)\n625|\tfail := func(code, detail string) (OpOutcome, error) {\n626|\t\tafter := source\n627|\t\tif committed {\n628|\t\t\tafter = terminalbackend.StateUnavailable\n629|\t\t}\n630|\t\tfailure := &Error{Code: code, Detail: detail}\n631|\t\tresult := mutationResult(mctx, source, after, performed, evidence, terminstance.DispositionFor(code, committed))\n632|\t\tlc.recordAfter(mctx.TerminalInstanceID, after)\n633|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n634|\t}\n635|\tfor _, effect := range effects {\n636|\t\tif !lc.Now().Before(deadline) {\n637|\t\t\treturn fail(rowTimeoutCode(operation), \"operation deadline\")\n638|\t\t}\n639|\t\tif err := terminstance.CheckAuthorization(mctx.Authorization, kind, lc.CurrentLease(), lc.Now()); err != nil {\n640|\t\t\tcode := backendErrorCode(err)\n641|\t\t\tif code == \"\" {\n642|\t\t\t\tcode = terminalbackend.CodeUnauthorized\n643|\t\t\t}\n644|\t\t\treturn fail(code, \"lifecycle authorization recheck\")\n645|\t\t}\n646|\t\tif lc.CurrentGeneration() != mctx.BackendGeneration {\n647|\t\t\treturn fail(terminalbackend.CodeStaleGeneration, \"backend_generation stale\")\n648|\t\t}\n649|\t\tif lc.Hooks != nil && lc.Hooks.BeforeEffect != nil {\n650|\t\t\tlc.Hooks.BeforeEffect(effect)\n651|\t\t}\n652|\t\tevidenceID, err := reqBackend.PerformEffect(ctx, effect)\n653|\t\tif lc.Hooks != nil && lc.Hooks.AfterEffect != nil {\n654|\t\t\tlc.Hooks.AfterEffect(effect)\n655|\t\t}\n656|\t\tif err != nil {\n657|\t\t\tcode := backendErrorCode(err)\n658|\t\t\tif code == \"\" {\n659|\t\t\t\treturn fail(terminstance.CodeProcessFailed, \"backend effect uncertain\")\n660|\t\t\t}\n661|\t\t\tif checkErr := terminalbackend.CheckErrorAllowed(string(operation), code); checkErr != nil {\n662|\t\t\t\treturn fail(terminalbackend.CodeProtocolError, \"operation error vocabulary\")\n663|\t\t\t}\n664|\t\t\treturn fail(code, \"backend effect refused\")\n665|\t\t}\n666|\t\tif _, err := scalar.ParseDigest(evidenceID); err != nil {\n667|\t\t\treturn fail(terminalbackend.CodeIntegrityFailure, \"backend effect evidence\")\n668|\t\t}\n669|\t\tcommitted = true\n670|\t\tperformed = append(performed, effect)\n671|\t\tevidence = append(evidence, evidenceID)\n672|\t}\n673|\tresult := mutationResult(mctx, source, target, performed, evidence, terminstance.DispositionReplaySame)\n674|\tencoded, err := json.Marshal(result)\n675|\tif err != nil {\n676|\t\tfailure := &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"idempotency result image\"}\n677|\t\tresult.Disposition = terminstance.DispositionStatusFirst\n678|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n679|\t}\n680|\tif err := lc.Receipts.Complete(key, encoded); err != nil {\n681|\t\tif backendErrorCode(err) == \"\" {\n682|\t\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"idempotency store failure\"}\n683|\t\t\tresult.Disposition = terminstance.DispositionStatusFirst\n684|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n685|\t\t}\n686|\t\tresult.Disposition = terminstance.DispositionStatusFirst\n687|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, rowError(operation, err)\n688|\t}\n689|\tlc.recordAfter(mctx.TerminalInstanceID, target)\n690|\treturn complete(result), nil\n691|}\n692|\n693|// rowTimeoutCode reports the timeout code for one lifecycle operation:\n694|// terminal_backend_timeout everywhere (neither terminate-stale nor\n695|// restore names a dedicated timeout).\n696|func rowTimeoutCode(operation terminalbackend.Operation) string {\n697|\t_ = operation\n698|\treturn terminstance.CodeTimeout\n699|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c857","stream":{"kind":"session","id":"01a0c7e8-b0ce-7b51-a856-c1e5aeba35b8"},"sequence":646,"recorded_at":1780531400001287,"record_type":"event","durability":"durable","causation_id":"1e747257-7dba-4be5-8162-7ca370e28419","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1e747257-7dba-4be5-8162-7ca370e28419","run_stream":{"kind":"run","id":"1e747257-7dba-4be5-8162-7ca370e28419"},"task_stream":{"kind":"task","id":"01a0c7ea-3587-7a32-a2fc-731fae9cd524"},"task_id":"01a0c7ea-3587-7a32-a2fc-731fae9cd524","event":{"kind":"completed","task_id":"01a0c7ea-3587-7a32-a2fc-731fae9cd524"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c859","stream":{"kind":"session","id":"01a0c7e8-b0ce-7b51-a856-c1e5aeba35b8"},"sequence":647,"recorded_at":1780531400001289,"record_type":"event","durability":"durable","causation_id":"1e747257-7dba-4be5-8162-7ca370e28419","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"1e747257-7dba-4be5-8162-7ca370e28419","run_stream":{"kind":"run","id":"1e747257-7dba-4be5-8162-7ca370e28419"},"call_id":"call_01a0c7ea316e749ab18a880f47bf6b23","text":"Read text file `internal/tmuxserver/ops.go`.\n(299 line(s) above)\n300|// the context and body. Any disagreement refuses the failed local\n301|// precondition: the retry would authorize a different target than the\n302|// key names.\n303|func checkTerminateTarget(mctx terminstance.MutationContext, body TerminateBody, presented fencing.PresentedToken) error {\n304|\tif presented.SessionID != mctx.SessionID ||\n305|\t\tpresented.LeaseID != body.StaleLeaseID ||\n306|\t\tpresented.Epoch != body.StaleEpoch {\n307|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate target binding\"}\n308|\t}\n309|\treturn nil\n310|}\n311|\n312|// checkTerminateWinner binds the caller-observed winner to the\n313|// re-read current lease: the fencing authorization decides over the\n314|// caller's winner, and only a winner that still wins authorizes. A\n315|// rotated or misobserved winner refuses the failed local\n316|// precondition; the caller re-observes and retries. Absence of a\n317|// winner never reaches here — the fencing gate refuses it first.\n318|func checkTerminateWinner(mctx terminstance.MutationContext, winner sessrepo.LeaseSummary, lease terminstance.LeaseView) error {\n319|\tif winner.SessionID != mctx.SessionID ||\n320|\t\twinner.LeaseID != lease.LeaseID ||\n321|\t\twinner.Epoch != lease.Epoch {\n322|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate winner binding\"}\n323|\t}\n324|\treturn nil\n325|}\n326|\n327|// executeRestore runs one restore: closed-shape admission, idempotency\n328|// material, capability conferral plus the reboot conditional,\n329|// transition, restore authorization, generation recheck, prior-binding\n330|// mismatch, deadline, receipt discipline with status-reconciled\n331|// resume, the persist plus wrapper-restored effects, and the required\n332|// result binding. The wire result is always parked. The backend\n333|// launches no provider: the wrapper owns launch gating through the\n334|// after-restore composition (ExecuteWrapperRestore), and this entry\n335|// only recreates the wrapper process.\n336|//\n337|// The result binding is the create-time document kept alongside the\n338|// bootstrap receipt, re-admitted by termbind on the read — within one\n339|// generation — or its minted successor across a reboot: the termbind\n340|// owner succeeds the prior (the JCS identity rule stays\n341|// termbind-private) and the successor persists under the same pair\n342|// key. The prior-binding mismatch arm proves the carried prior equals\n343|// the recorded digest; the document read proves a valid binding for\n344|// this session, instance, and backend.\n345|func (lc *Lifecycle) executeRestore(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n346|\tempty := OpOutcome{Operation: terminalbackend.OperationRestore}\n347|\tbody, err := parseRestoreBody(req.Body)\n348|\tif err != nil {\n349|\t\treturn empty, err\n350|\t}\n351|\toperation := terminalbackend.OperationRestore\n352|\tmctx := body.Context\n353|\tsource := terminalbackend.InstanceState(req.Source)\n354|\tif err := checkLifecycleBackend(mctx.TerminalBackendID); err != nil {\n355|\t\treturn empty, err\n356|\t}\n357|\tderived, err := terminalbackend.IdempotencyKey(string(operation), mctx.SessionID, body.BootstrapOperationID)\n358|\tif err != nil {\n359|\t\treturn empty, err\n360|\t}\n361|\tif mctx.IdempotencyKey != derived {\n362|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"idempotency key material\"}\n363|\t}\n364|\tif err := terminalbackend.CheckOperation(string(operation), req.Admitted); err != nil {\n365|\t\tfailure := rowError(operation, err)\n366|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n367|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n368|\t}\n369|\tif !req.Admitted.Has(\"reboot_restoration\") {\n370|\t\tfailure := &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n371|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n372|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n373|\t}\n374|\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), false)\n375|\tif err != nil {\n376|\t\tfailure := rowError(operation, err)\n377|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n378|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n379|\t}\n380|\tif err := terminstance.CheckAuthorization(mctx.Authorization, terminstance.AuthorizationRestore, lc.CurrentLease(), lc.Now()); err != nil {\n381|\t\tfailure := rowError(operation, err)\n382|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n383|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n384|\t}\n385|\tif lc.CurrentGeneration() != mctx.BackendGeneration {\n386|\t\tfailure := &Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation stale\"}\n387|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n388|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n389|\t}\n390|\tif err := lc.checkPriorBinding(body); err != nil {\n391|\t\tvar local *Error\n392|\t\tif errors.As(err, &local) && local.Code == terminalbackend.CodeRestoreMismatch {\n393|\t\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n394|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n395|\t\t}\n396|\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n397|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n398|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n399|\t}\n400|\tdeadline, err := mctx.Deadline.Time()\n401|\tif err != nil {\n402|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"mutation context deadline\"}\n403|\t}\n404|\tif !lc.Now().Before(deadline) {\n405|\t\tfailure := &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n406|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionReplaySame)\n407|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n408|\t}\n409|\t// The prior binding validates before the receipt binds and the\n410|\t// wrapper recreates: a missing, corrupt, or disagreeing prior\n411|\t// refuses here, never after the irreversible effects.\n412|\tif _, err := lc.readRestorePrior(mctx, body); err != nil {\n413|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n414|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n415|\t}\n416|\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n417|\treqBackend.operation = operation\n418|\treqBackend.bootstrapID = body.BootstrapOperationID\n419|\t// The persist effect replays the recorded pair receipt (verified\n420|\t// by the mismatch arm above); the candidate carries the matched\n421|\t// prior digest so the store admits its shape on the replay path.\n422|\treqBackend.bindingID = body.PriorBindingID\n423|\toutcome, err := lc.executeWithReceipt(ctx, req, socket, operation, mctx, source, target, effects, deadline, terminstance.AuthorizationRestore, reqBackend, func(result terminstance.Result) OpOutcome {\n424|\t\treturn OpOutcome{Operation: operation, Mutation: &result, PriorBindingID: body.PriorBindingID, RestoredParked: true}\n425|\t})\n426|\tif err != nil {\n427|\t\treturn outcome, err\n428|\t}\n429|\tbinding, err := lc.restoreBinding(mctx, body)\n430|\tif err != nil {\n431|\t\treturn outcome, err\n432|\t}\n433|\toutcome.Binding = binding\n434|\treturn outcome, nil\n435|}\n436|\n437|// readRestorePrior reads the create-time binding document kept under\n438|// the (session, bootstrap) pair, re-admitted by the termbind owner,\n439|// and proves it names this restore's session, instance, and backend.\n440|// Generation is not compared here: after a reboot the restore carries\n441|// the new server generation while the prior still names the old one,\n442|// and succession (not agreement) resolves that drift. A missing\n443|// document is the backend store failure — the receipt proved the\n444|// prior, but the payload is gone, so the required result cannot be\n445|// built. A document that fails termbind admission, or that names\n446|// another session, instance, or backend than the mutation context, is\n447|// the integrity failure: the store disagrees with the receipt it\n448|// stands beside.\n449|func (lc *Lifecycle) readRestorePrior(mctx terminstance.MutationContext, body RestoreBody) (termbind.Binding, error) {\n450|\tempty := termbind.Binding{}\n451|\tdoc, found, err := lc.States.LookupBindingDoc(mctx.SessionID, body.BootstrapOperationID)\n452|\tif err != nil {\n453|\t\treturn empty, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n454|\t}\n455|\tif !found {\n456|\t\treturn empty, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n457|\t}\n458|\tbinding, err := termbind.ParseTerminalBinding(doc)\n459|\tif err != nil {\n460|\t\treturn empty, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n461|\t}\n462|\tif binding.SessionID != mctx.SessionID ||\n463|\t\tbinding.TerminalInstanceID != mctx.TerminalInstanceID ||\n464|\t\tbinding.TerminalBackendID != mctx.TerminalBackendID {\n465|\t\treturn empty, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n466|\t}\n467|\treturn binding, nil\n468|}\n469|\n470|// restoreBinding builds the required restore result binding after the\n471|// effects commit. Within one generation the prior is the result: the\n472|// re-admitted create-time document the pre-effects validation already\n473|// proved. Across a reboot the mutation context carries the new server\n474|// generation, and the result is the minted successor: the termbind\n475|// owner succeeds the prior (new generation, supersedes link, fresh\n476|// identity), the successor persists under the same pair key, and the\n477|// same successor returns. The mint is deterministic, so a retry after\n478|// a crash between the effects and the persist converges on the\n479|// identical document instead of forking, and a retry after the\n480|// persist replays the stored successor without minting again.\n481|func (lc *Lifecycle) restoreBinding(mctx terminstance.MutationContext, body RestoreBody) (*termbind.Binding, error) {\n482|\tprior, err := lc.readRestorePrior(mctx, body)\n483|\tif err != nil {\n484|\t\treturn nil, err\n485|\t}\n486|\tif prior.BackendGeneration == mctx.BackendGeneration {\n487|\t\treturn &prior, nil\n488|\t}\n489|\tminted, raw, err := termbind.MintSuccessorBinding(prior, mctx.BackendGeneration)\n490|\tif err != nil {\n491|\t\treturn nil, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n492|\t}\n493|\tif err := lc.States.RecordBindingDoc(mctx.SessionID, body.BootstrapOperationID, raw); err != nil {\n494|\t\treturn nil, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding write\"}\n495|\t}\n496|\treturn &minted, nil\n497|}\n498|\n499|// checkPriorBinding enforces the restore mismatch rule: the recorded\n500|// bootstrap binding for the (session, bootstrap) pair must exist and\n501|// its digest must equal the carried prior_binding_id. Substituting any\n502|// other binding — including the configured default — refuses the\n503|// restore mismatch. A binding read failure is an error, never a\n504|// mismatch: unknown is not a verdict.\n505|func (lc *Lifecycle) checkPriorBinding(body RestoreBody) error {\n506|\trecorded, found, err := lc.Bindings.Lookup(body.Context.SessionID, body.BootstrapOperationID)\n507|\tif err != nil {\n508|\t\treturn err\n509|\t}\n510|\tif !found || recorded.BindingDigest != body.PriorBindingID {\n511|\t\treturn &Error{Code: terminalbackend.CodeRestoreMismatch, Detail: \"restore prior binding\"}\n512|\t}\n513|\treturn nil\n514|}\n515|\n516|// effectPerformer executes one lifecycle side effect and reports its\n517|// evidence ID, the single capability the receipt-bound effect loop\n518|// needs from the request backend.\n519|type effectPerformer interface {\n520|\tPerformEffect(ctx context.Context, effect terminalbackend.SideEffect) (string, error)\n521|}\n522|\n523|// executeWithReceipt binds the idempotency receipt and runs the\n524|// effects under it, mirroring the engine's bind discipline: an\n525|// identical retry replays the one completion, a bound key without its\n526|// completion reconciles through the production status entry before it\n527|// refuses, and no path binds a second receipt for one key. complete\n528|// maps the successful result into the operation outcome; failures\n529|// return the outcome with the mutation set, mirroring the engine.\n530|func (lc *Lifecycle) executeWithReceipt(ctx context.Context, req OpRequest, socket string, operation terminalbackend.Operation, mctx terminstance.MutationContext, source, target terminalbackend.InstanceState, effects []terminalbackend.SideEffect, deadline time.Time, kind terminstance.AuthorizationKind, reqBackend effectPerformer, complete func(terminstance.Result) OpOutcome) (OpOutcome, error) {\n531|\tkey := mctx.IdempotencyKey\n532|\t_, replayed, err := lc.Receipts.Bind(key, operation, mctx.OperationID)\n533|\tif err != nil {\n534|\t\tif backendErrorCode(err) != \"\" {\n535|\t\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n536|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, rowError(operation, err)\n537|\t\t}\n538|\t\tif _, found, lookupErr := lc.Receipts.Lookup(key); lookupErr == nil && !found {\n539|\t\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"idempotency store failure\"}\n540|\t\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n541|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n542|\t\t}\n543|\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"idempotency store failure\"}\n544|\t\tresult := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n545|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n546|\t}\n547|\tif replayed {\n548|\t\tstored, found, err := lc.Receipts.Completed(key)\n549|\t\tif err != nil {\n550|\t\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"idempotency store failure\"}\n551|\t\t\tresult := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n552|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n553|\t\t}\n554|\t\tif !found {\n555|\t\t\treturn lc.resumeUncertain(ctx, req, socket, operation, mctx, source, target, effects, deadline, kind, reqBackend, complete)\n556|\t\t}\n557|\t\tvar result terminstance.Result\n558|\t\tif err := json.Unmarshal(stored, &result); err != nil {\n559|\t\t\tfailure := &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"idempotency result image\"}\n560|\t\t\trebuilt := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n561|\t\t\treturn OpOutcome{Operation: operation, Mutation: &rebuilt}, failure\n562|\t\t}\n563|\t\tif err := terminstance.CheckResult(mctx, source, result); err != nil {\n564|\t\t\tif backendErrorCode(err) == \"\" {\n565|\t\t\t\tfailure := &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"idempotency result image\"}\n566|\t\t\t\trebuilt := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n567|\t\t\t\treturn OpOutcome{Operation: operation, Mutation: &rebuilt}, failure\n568|\t\t\t}\n569|\t\t\trebuilt := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionFor(backendErrorCode(err), true))\n570|\t\t\treturn OpOutcome{Operation: operation, Mutation: &rebuilt}, rowError(operation, err)\n571|\t\t}\n572|\t\treturn complete(result), nil\n573|\t}\n574|\tif lc.Hooks != nil && lc.Hooks.AfterReceipt != nil {\n575|\t\tlc.Hooks.AfterReceipt(operation, key, terminstance.InterimState(operation, source))\n576|\t}\n577|\treturn lc.runLifecycleEffects(ctx, operation, mctx, source, target, effects, deadline, kind, reqBackend, complete)\n578|}\n579|\n580|// resumeUncertain reconciles a bound key without its completion through\n581|// the production status entry: when status proves the presented source\n582|// state — nothing happened — the same operation continues under the\n583|// same receipt; when status proves anything else, or fails, the retry\n584|// refuses uncertain with status_first. No path binds a second receipt\n585|// for one key.\n586|func (lc *Lifecycle) resumeUncertain(ctx context.Context, req OpRequest, socket string, operation terminalbackend.Operation, mctx terminstance.MutationContext, source, target terminalbackend.InstanceState, effects []terminalbackend.SideEffect, deadline time.Time, kind terminstance.AuthorizationKind, reqBackend effectPerformer, complete func(terminstance.Result) OpOutcome) (OpOutcome, error) {\n587|\tbody := terminstance.StatusBody{\n588|\t\tSessionID:                  mctx.SessionID,\n589|\t\tTerminalInstanceID:         mctx.TerminalInstanceID,\n590|\t\tHasTerminalInstanceID:      true,\n591|\t\tTerminalBackendID:          mctx.TerminalBackendID,\n592|\t\tImplementationVersion:      mctx.ImplementationVersion,\n593|\t\tProtocolVersion:            mctx.ProtocolVersion,\n594|\t\tBackendGeneration:          mctx.BackendGeneration,\n595|\t\tHasBackendGeneration:       true,\n596|\t\tIncludeProviderObservation: false,\n597|\t\tDeadline:                   mctx.Deadline,\n598|\t}\n599|\tstatusBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n600|\tstatusBackend.operation = terminalbackend.OperationStatus\n601|\treport, err := lc.engineFor(statusBackend).ExecuteStatus(ctx, body, source, req.Admitted)\n602|\tif err != nil || report.State != source {\n603|\t\tfailure := &Error{Code: terminalbackend.CodeUnavailable, Detail: \"idempotency result uncertain\"}\n604|\t\tresult := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n605|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n606|\t}\n607|\tif lc.Hooks != nil && lc.Hooks.AfterReceipt != nil {\n608|\t\tlc.Hooks.AfterReceipt(operation, mctx.IdempotencyKey, terminstance.InterimState(operation, source))\n609|\t}\n610|\treturn lc.runLifecycleEffects(ctx, operation, mctx, source, target, effects, deadline, kind, reqBackend, complete)\n611|}\n612|\n613|// runLifecycleEffects performs the transition's side effects under an\n614|// already-bound receipt with the per-effect deadline, authorization,\n615|// and generation gates, then completes the key exactly once — the\n616|// engine's runEffects contract, second side. Fresh and resumed runs\n617|// share this loop. On success the after-state records in the AX-side\n618|// memory and the outcome completes; every failure returns the outcome\n619|// with the mutation set, mirroring the engine.\n620|func (lc *Lifecycle) runLifecycleEffects(ctx context.Context, operation terminalbackend.Operation, mctx terminstance.MutationContext, source, target terminalbackend.InstanceState, effects []terminalbackend.SideEffect, deadline time.Time, kind terminstance.AuthorizationKind, reqBackend effectPerformer, complete func(terminstance.Result) OpOutcome) (OpOutcome, error) {\n621|\tkey := mctx.IdempotencyKey\n622|\tcommitted := false\n623|\tevidence := []string(nil)\n624|\tperformed := []terminalbackend.SideEffect(nil)\n625|\tfail := func(code, detail string) (OpOutcome, error) {\n626|\t\tafter := source\n627|\t\tif committed {\n628|\t\t\tafter = terminalbackend.StateUnavailable\n629|\t\t}\n630|\t\tfailure := &Error{Code: code, Detail: detail}\n631|\t\tresult := mutationResult(mctx, source, after, performed, evidence, terminstance.DispositionFor(code, committed))\n632|\t\tlc.recordAfter(mctx.TerminalInstanceID, after)\n633|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n634|\t}\n635|\tfor _, effect := range effects {\n636|\t\tif !lc.Now().Before(deadline) {\n637|\t\t\treturn fail(rowTimeoutCode(operation), \"operation deadline\")\n638|\t\t}\n639|\t\tif err := terminstance.CheckAuthorization(mctx.Authorization, kind, lc.CurrentLease(), lc.Now()); err != nil {\n640|\t\t\tcode := backendErrorCode(err)\n641|\t\t\tif code == \"\" {\n642|\t\t\t\tcode = terminalbackend.CodeUnauthorized\n643|\t\t\t}\n644|\t\t\treturn fail(code, \"lifecycle authorization recheck\")\n645|\t\t}\n646|\t\tif lc.CurrentGeneration() != mctx.BackendGeneration {\n647|\t\t\treturn fail(terminalbackend.CodeStaleGeneration, \"backend_generation stale\")\n648|\t\t}\n649|\t\tif lc.Hooks != nil && lc.Hooks.BeforeEffect != nil {\n650|\t\t\tlc.Hooks.BeforeEffect(effect)\n651|\t\t}\n652|\t\tevidenceID, err := reqBackend.PerformEffect(ctx, effect)\n653|\t\tif lc.Hooks != nil && lc.Hooks.AfterEffect != nil {\n654|\t\t\tlc.Hooks.AfterEffect(effect)\n655|\t\t}\n656|\t\tif err != nil {\n657|\t\t\tcode := backendErrorCode(err)\n658|\t\t\tif code == \"\" {\n659|\t\t\t\treturn fail(terminstance.CodeProcessFailed, \"backend effect uncertain\")\n660|\t\t\t}\n661|\t\t\tif checkErr := terminalbackend.CheckErrorAllowed(string(operation), code); checkErr != nil {\n662|\t\t\t\treturn fail(terminalbackend.CodeProtocolError, \"operation error vocabulary\")\n663|\t\t\t}\n664|\t\t\treturn fail(code, \"backend effect refused\")\n665|\t\t}\n666|\t\tif _, err := scalar.ParseDigest(evidenceID); err != nil {\n667|\t\t\treturn fail(terminalbackend.CodeIntegrityFailure, \"backend effect evidence\")\n668|\t\t}\n669|\t\tcommitted = true\n670|\t\tperformed = append(performed, effect)\n671|\t\tevidence = append(evidence, evidenceID)\n672|\t}\n673|\tresult := mutationResult(mctx, source, target, performed, evidence, terminstance.DispositionReplaySame)\n674|\tencoded, err := json.Marshal(result)\n675|\tif err != nil {\n676|\t\tfailure := &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"idempotency result image\"}\n677|\t\tresult.Disposition = terminstance.DispositionStatusFirst\n678|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n679|\t}\n680|\tif err := lc.Receipts.Complete(key, encoded); err != nil {\n681|\t\tif backendErrorCode(err) == \"\" {\n682|\t\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"idempotency store failure\"}\n683|\t\t\tresult.Disposition = terminstance.DispositionStatusFirst\n684|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n685|\t\t}\n686|\t\tresult.Disposition = terminstance.DispositionStatusFirst\n687|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, rowError(operation, err)\n688|\t}\n689|\tlc.recordAfter(mctx.TerminalInstanceID, target)\n690|\treturn complete(result), nil\n691|}\n692|\n693|// rowTimeoutCode reports the timeout code for one lifecycle operation:\n694|// terminal_backend_timeout everywhere (neither terminate-stale nor\n695|// restore names a dedicated timeout).\n696|func rowTimeoutCode(operation terminalbackend.Operation) string {\n697|\t_ = operation\n698|\treturn terminstance.CodeTimeout\n699|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
