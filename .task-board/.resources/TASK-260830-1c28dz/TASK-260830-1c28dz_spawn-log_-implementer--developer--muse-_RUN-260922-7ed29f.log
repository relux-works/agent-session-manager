= r.strip().rstrip(\\\").\\\")\\n        if re.match(r\\\"[NCDB]-[a-z0-9-]+$\\\", r) and r not in rows:\\n            missing_rows.add(r)\\nprint(\\\"missing census tests:\\\", sorted(missing_tests) if missing_tests else \\\"none\\\")\\nprint(\\\"missing census rows:\\\", sorted(missing_rows) if missing_rows else \\\"none\\\")\\nPYEOF\",\n  \"description\": \"Check census M-cell references resolve\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"missing census tests: ['TestABG', 'TestAFG', 'TestARG', 'TestAcrossServerGeneration', 'TestAdmitsCompliant', 'TestAncestorKindArm', 'TestAttach', 'TestAttachClient', 'TestAttachErrorsOnCorruptBarrierScan', 'TestAttachReadOnlyVector', 'TestAttachRefusals', 'TestAttachRequiresInputFlag', 'TestAttachedExitIsUnknown', 'TestB', 'TestB22', 'TestB23', 'TestB24', 'TestB25', 'TestB28', 'TestB29', 'TestB39', 'TestBG', 'TestBRO', 'TestBarrierSequence', 'TestBindHookFailure', 'TestBindingAgreement', 'TestBindingConflict', 'TestBindingDocRoundTrip', 'TestBindingTamperRefusesIntegrity', 'TestBoundary', 'TestBoundaryBarrierSurvivesStateWriteFailure', 'TestBoundaryBindsProofKind', 'TestBoundaryRefusedExit', 'TestBoundaryRefusesFailedWait', 'TestBoundaryReplayKeepsProofAndTime', 'TestBoundaryTimeout', 'TestBoundaryWaitTimeout', 'TestBounds', 'TestCLS', 'TestCMD', 'TestCRE', 'TestCUS', 'TestComplete', 'TestCorruptOutcomeRefusesIntegrity', 'TestCountsBytes', 'TestCoversEightRows', 'TestCreateInteractive', 'TestCreatePersistsBindingDocForRestore', 'TestDIAL', 'TestDIRV', 'TestENS', 'TestEX', 'TestEXA', 'TestEXC', 'TestEXE', 'TestEXR', 'TestEXT', 'TestEmitsNoProviderInput', 'TestEmptyRecordedTimeRefusesIntegrity', 'TestEnforcesLengthAndCustody', 'TestEscalationKillFailure', 'TestExactBackendDriftNonMatches', 'TestExactProtocolDriftNonMatches', 'TestExactUnboundSessionRefusesUnknown', 'TestFG', 'TestForeignAttachedRowIsUnknown', 'TestGate', 'TestIdempotent', 'TestIdentityMismatchRefuses', 'TestInputClosed', 'TestLEN