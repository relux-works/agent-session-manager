"\\\", refuse(&Error{Code: CodeProtocolError, Detail: \\\"operation vocabulary\\\"})\\n\\t}\\n\\treturn row.Authorization, nil\\n}\\n\\n\",\n  \"original_output_bytes\": 2946,\n  \"original_output_tokens\": 737,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
