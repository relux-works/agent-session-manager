onAttach,\\n228-\\t\\tInstanceScoped: true,\\n229-\\t},\\n230-\\t{\\n231-\\t\\tOperation: OperationStatus,\\n232-\\t\\tSources: []InstanceState{\\n233-\\t\\t\\tStateAbsent, StateCreating, StateParked, StateActive,\\n234-\\t\\t\\tStateQuiescing, StateStopped, StateStaleFenced, StateUnavailable,\\n235-\\t\\t},\\n236-\\t\\tSameState:      true,\\n237-\\t\\tAuthorization:  authorizationNone,\\n238-\\t\\tInstanceScoped: true,\\n239-\\t},\\n240-\\t{\\n241-\\t\\tOperation:      OperationQuiesceInput,\\n242-\\t\\tSources:        []InstanceState{StateActive, StateParked},\\n243-\\t\\tTarget:         StateQuiescing,\\n244-\\t\\tEffects:        []SideEffect{EffectInputClosed},\\n245-\\t\\tAuthorization:  authorizationControl,\\n246-\\t\\tInstanceScoped: true,\\n247-\\t},\\n248-\\t{\\n249-\\t\\tOperation:      OperationWaitSafeBoundary,\\n250-\\t\\tSources:        []InstanceState{StateQuiescing},\\n251-\\t\\tTarget:         StateQuiescing,\\n252-\\t\\tEffects:        []SideEffect{EffectSafeBoundaryObserved},\\n253-\\t\\tAuthorization:  authorizationControl,\\n254-\\t\\tInstanceScoped: true,\\n255-\\t},\\n256-\\t{\\n257-\\t\\tOperation:      OperationRequestStop,\\n258-\\t\\tSources:        []InstanceState{StateQuiescing},\\n259-\\t\\tTarget:         StateStopped,\\n260-\\t\\tEffects:        []SideEffect{EffectGracefulStopRequested, EffectProcessClosed, EffectBackendStoreClosed},\\n261-\\t\\tAuthorization:  authorizationControl,\\n262-\\t\\tInstanceScoped: true,\\n263-\\t},\\n264-\\t{\\n265-\\t\\tOperation:      OperationTerminateStale,\\n266-\\t\\tSources:        []InstanceState{StateStaleFenced, StateUnavailable},\\n267-\\t\\tTarget:         StateStopped,\\n268-\\t\\tEffects:        []SideEffect{EffectStaleIncarnationTerminated, EffectProcessClosed},\\n269-\\t\\tAuthorization:  authorizationForceStale,\\n270-\\t\\tInstanceScoped: true,\\n271-\\t},\\n272-\\t{\\n273-\\t\\tOperation:      OperationRestore,\\n274-\\t\\tSources:        []InstanceState{StateAbsent, StateStopped, StateUnavailable},\\n275-\\t\\tTarget:         StateParked,\\n276-\\t\\tEffects:        []SideEffect{EffectBindingPersisted, EffectWrapperRestored},\\n277-\\t\\tAuthorization:  authorizationRestore,\\n278-\\t\\tInstanceScoped: true,\\n279-\\t},\\n280-}\\n281-\\n282-// lookupTransition returns the table row for one operation.\\n283-func lookupTransition(operation Operation) (Transition, bool) {\\n284:\\tfor _, row := range transitionTable {\\n285-\\t\\tif row.Operation == operation {\\n286-\\t\\t\\treturn row, true\\n287-\\t\\t}\\n288-\\t}\\n289-\\treturn Transition{}, false\\n290-}\\n291-\\n292-// CheckTransition enforces the §4.C transition matrix. It returns the\\n293-// success target state and the exact side effects. create resolves its\\n294-// target from interactive: active when interactive, otherwise parked. A\\n295-// state reached only by AX fencing observation (stale_fenced) is never\\n296-// entered here: no backend operation targets it, so a row naming it as a\\n297-// target cannot exist and CheckTransition cannot return it except as a\\n298-// status observation of the source itself.\\n299-//\\n300-// An unknown operation or state is a protocol error; a known operation\\n301-// against a disallowed source is a failed local precondition. Only\\n302-// quiesce-input enters quiescing, and creating is never a success target:\\n303-// it exists only between the idempotency receipt and the first side\\n304-// effect, which the Ledger below owns.\\n305-func CheckTransition(operation, source string, interactive bool) (InstanceState, []SideEffect, error) {\\n306-\\tparsedOperation, err := ParseOperation(operation)\\n307-\\tif err != nil {\\n308-\\t\\treturn \\\"\\\", nil, err\\n\",\n  \"original_output_bytes\": 4246,\n  \"original_output_tokens\": 1062,\n  \"truncated\": false\n}","final_result":true}}}
