{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d165","stream":{"kind":"session","id":"01a0c7e8-b0ce-7b51-a856-c1e5aeba35b8"},"sequence":1805,"recorded_at":1780531400003605,"record_type":"event","durability":"durable","causation_id":"1e747257-7dba-4be5-8162-7ca370e28419","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1e747257-7dba-4be5-8162-7ca370e28419","run_stream":{"kind":"run","id":"1e747257-7dba-4be5-8162-7ca370e28419"},"task_stream":{"kind":"task","id":"01a0c7f3-514c-7b73-906c-e1be78e294d3"},"task_id":"01a0c7f3-514c-7b73-906c-e1be78e294d3","event":{"kind":"output","task_id":"01a0c7f3-514c-7b73-906c-e1be78e294d3","chunk":"{\n  \"chunk_id\": \"exec-50-1\",\n  \"command\": \"sed -n '2425,2465p' internal/tmuxserver/mutant_harness.py\",\n  \"description\": \"Read harness patch application\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the fixture session past the refresh-success arm into stale local knowledge; failed attempts still fall back the same way. Kill path: the offer refuses and the resume parks through the wrapper entry, while the park twins hold.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-wrapper-route-material\\\",\\n        path=f\\\"{PACKAGE}/wrapper.go\\\",\\n        find='\\\\tdecision := axpane.Decide(input)\\\\n\\\\toutcome := WrapperRestoreOutcome{\\\\n',\\n        replace='\\\\tdecision := axpane.Decide(input)\\\\n\\\\tif decision.Action == axpane.ActionParked && decision.Cause != nil && decision.Cause.Error() == \\\"required materialization is not admitted\\\" {\\\\n\\\\t\\\\trestored, routeErr := lc.Execute(ctx, req.Restore)\\\\n\\\\t\\\\trouted := WrapperRestoreOutcome{\\\\n\\\\t\\\\t\\\\tDecision:         decision,\\\\n\\\\t\\\\t\\\\tRefreshAttempted: attempted,\\\\n\\\\t\\\\t\\\\tRefreshSucceeded: succeeded,\\\\n\\\\t\\\\t\\\\tRefreshBoundMs:   uint64(bound.Milliseconds()),\\\\n\\\\t\\\\t\\\\tWinnerLeaseID:    winner.LeaseID,\\\\n\\\\t\\\\t\\\\tWinnerHostID:     winner.HolderHostID,\\\\n\\\\t\\\\t\\\\tRestore:          &restored,\\\\n\\\\t\\\\t}\\\\n\\\\t\\\\tif routeErr != nil {\\\\n\\\\t\\\\t\\\\treturn routed, routeErr\\\\n\\\\t\\\\t}\\\\n\\\\t\\\\treturn routed, nil\\\\n\\\\t}\\\\n\\\\toutcome := WrapperRestoreOutcome{\\\\n',\\n        count=1,\\n        run=\\\"TestWrapperRestoreParksWithoutEffects\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the materialization-cause park into backend execution (reviewer R4, superseded site: the seam is gone, the landed journal arm decides); every other park still runs nothing. Kill path: the invalid-material park consumes the wrapper vector and sets Restore through the wrapper entry.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-wrapper-mode\\\",\\n        path=f\\\"{PACKAGE}/wrapper.go\\\",\\n        find='\\\\tif req.Decide.Mode != axpane.ModeRestore {\\\\n',\\n        replace='\\\\tif req.Decide.Mode != axpane.ModeRestore && req.Decide.Mode != axpane.ModeLaunch {\\\\n',\\n        count=1,\\n        run=\\\"TestWrapperRestoreRefusesMalformed\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly launch mode past the restore-only gate; garbage modes still refuse. Kill path: the launch-mode request decides instead of refusing through the wrapper entry.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-wrapper-operation\\\",\\n        path=f\\\"{PACKAGE}/wrapper.go\\\",\\n        find='\\\\tif req.Restore.Operation != string(terminalbackend.OperationRestore) {\\\\n',\\n        replace='\\\\tif req.Restore.Operation != string(terminalbackend.OperationRestore) && req.Restore.Operation != \\\"status\\\" {\\\\n',\\n        count=1,\\n        run=\\\"TestWrapperRestoreRefusesMalformed\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the status operation past the restore-only resume gate; garbage operations still refuse. Kill path: the status resume request decides instead of refusing through the wrapper entry.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-custody-entry-root-create\\\",\\n        path=f\\\"{PACKAGE}/lifecycle.go\\\",\\n        find='\\\\tif err := CheckSocketCustody(socket, lc.Root, lc.Platform); err != nil {\\\\n',\\n        replace='\\\\tif err := CheckSocketCustody(socket, lc.Root, lc.Platform); err != nil && !(operation == terminalbackend.OperationCreate && err.Error() == \\\"tmux server refused: tmux_unsafe_socket_path at socket root\\\") {\\\\n',\\n        count=1,\\n        run=\\\"(TestExecuteCreateRefusesWritableRoot|TestExecuteEachOperationRefusesWritableRoot)\\\",\\n        expect=\\\"KILLED\\\",\\n\",\n  \"original_output_bytes\": 3315,\n  \"original_output_tokens\": 829,\n  \"truncated\": false\n}","final_result":true}}}
