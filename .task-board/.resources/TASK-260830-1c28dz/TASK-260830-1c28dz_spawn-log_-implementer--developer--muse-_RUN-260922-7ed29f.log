{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cec9","stream":{"kind":"session","id":"01a0c7e8-b0ce-7b51-a856-c1e5aeba35b8"},"sequence":1471,"recorded_at":1780531400002937,"record_type":"event","durability":"durable","causation_id":"1e747257-7dba-4be5-8162-7ca370e28419","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1e747257-7dba-4be5-8162-7ca370e28419","run_stream":{"kind":"run","id":"1e747257-7dba-4be5-8162-7ca370e28419"},"task_stream":{"kind":"task","id":"01a0c7f1-9bc5-79b1-97c3-356101ed0887"},"task_id":"01a0c7f1-9bc5-79b1-97c3-356101ed0887","event":{"kind":"output","task_id":"01a0c7f1-9bc5-79b1-97c3-356101ed0887","chunk":"edited\nchanged lines: lines 149-168\n--- original\n+++ updated\n@@\n-// checkAttachQuiesced enforces the quiesce input barrier at the\n-// attach entry: tmux offers no session freeze (a locked session does\n-// not lock subsequently attaching clients), so once the AX-side\n-// memory records quiescing, new input-authorized attaches refuse the\n-// failed local precondition. Read-only attaches stay admitted:\n-// quiesce stops input while retaining observation. A memory read\n-// failure is an error, never admission: unknown is not a verdict.\n-func (lc *Lifecycle) checkAttachQuiesced(instanceID string, inputAuthorized bool) error {\n-\tif !inputAuthorized {\n-\t\treturn nil\n-\t}\n-\tmemory, found, err := lc.States.Lookup(instanceID)\n-\tif err != nil {\n-\t\treturn err\n-\t}\n-\tif found && memory == terminalbackend.StateQuiescing {\n-\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"attach quiesced input\"}\n-\t}\n-\treturn nil\n-}\n+// checkAttachQuiesced enforces the quiesce input barrier at the\n+// attach entry: tmux offers no session freeze (a locked session does\n+// not lock subsequently attaching clients), so once the AX-side\n+// memory records quiescing, new input-authorized attaches refuse the\n+// failed local precondition. Read-only attaches stay admitted:\n+// quiesce stops input while retaining observation. A memory read\n+// failure is an error, never admission: unknown is not a verdict.\n+// When the memory holds no record at all, the barrier recovers from\n+// the completed closure outcomes instead: a recorded quiesce-input\n+// or wait-safe-boundary report for this instance proves the input\n+// closed, so a lost barrier write refuses exactly like the memory\n+// would — absence of memory is not proof of an open input.\n+func (lc *Lifecycle) checkAttachQuiesced(instanceID string, inputAuthorized bool) error {\n+\tif !inputAuthorized {\n+\t\treturn nil\n+\t}\n+\tmemory, found, err := lc.States.Lookup(instanceID)\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tif found {\n+\t\tif memory == terminalbackend.StateQuiescing {\n+\t\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"attach quiesced input\"}\n+\t\t}\n+\t\treturn nil\n+\t}\n+\tproven, err := lc.States.QuiesceBarrierProven(instanceID)\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tif proven {\n+\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"attach quiesced input\"}\n+\t}\n+\treturn nil\n+}\n","final_result":true}}}
