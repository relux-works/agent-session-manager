{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d2c7","stream":{"kind":"session","id":"01a0c7e8-b0ce-7b51-a856-c1e5aeba35b8"},"sequence":1982,"recorded_at":1780531400003959,"record_type":"event","durability":"durable","causation_id":"1e747257-7dba-4be5-8162-7ca370e28419","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1e747257-7dba-4be5-8162-7ca370e28419","run_stream":{"kind":"run","id":"1e747257-7dba-4be5-8162-7ca370e28419"},"task_stream":{"kind":"task","id":"01a0c7f4-5b20-73c1-af7a-0b001f27fd06"},"task_id":"01a0c7f4-5b20-73c1-af7a-0b001f27fd06","event":{"kind":"output","task_id":"01a0c7f4-5b20-73c1-af7a-0b001f27fd06","chunk":"edited\nchanged lines: lines 140-151\n--- original\n+++ updated\n@@\n-\tswitch decision.Action {\n-\tcase axpane.ActionLaunch, axpane.ActionReattach:\n-\t\trestored, err := lc.Execute(ctx, req.Restore)\n-\t\toutcome.Restore = &restored\n-\t\tif err != nil {\n-\t\t\treturn outcome, err\n-\t\t}\n-\t\treturn outcome, nil\n-\tdefault:\n-\t\treturn outcome, nil\n-\t}\n-}\n+\tswitch decision.Action {\n+\tcase axpane.ActionLaunch, axpane.ActionReattach:\n+\t\tif err := checkRestoreWinnerBound(req.Restore.Body, winner); err != nil {\n+\t\t\treturn outcome, err\n+\t\t}\n+\t\trestored, err := lc.Execute(ctx, req.Restore)\n+\t\toutcome.Restore = &restored\n+\t\tif err != nil {\n+\t\t\treturn outcome, err\n+\t\t}\n+\t\treturn outcome, nil\n+\tdefault:\n+\t\treturn outcome, nil\n+\t}\n+}\n+\n+// checkRestoreWinnerBound binds the executed backend restore to the\n+// lease the wrapper decision just ran over: the restore\n+// authorization's (lease_id, lease_epoch) must equal the ordered\n+// winner. The decision authorizes the winner and the backend\n+// authorizes the restore against the current lease, but neither ties\n+// the two together — without this join a refreshed winner for one\n+// lease would authorize effects under another lease's grant, two\n+// gates passing over different leases. A malformed restore body\n+// refuses its own parse error (the same refusal the backend entry\n+// would return), and a divergent authorization refuses the failed\n+// local precondition before any effect runs. Backend restore\n+// authorization is never weakened to make the join fit: this gate\n+// only refuses what the decision did not select.\n+func checkRestoreWinnerBound(raw []byte, winner sessrepo.LeaseSummary) error {\n+\tbody, err := parseRestoreBody(raw)\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tif body.Context.Authorization.LeaseID != winner.LeaseID ||\n+\t\tbody.Context.Authorization.LeaseEpoch != winner.Epoch {\n+\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"wrapper restore winner binding\"}\n+\t}\n+\treturn nil\n+}\n","final_result":true}}}
