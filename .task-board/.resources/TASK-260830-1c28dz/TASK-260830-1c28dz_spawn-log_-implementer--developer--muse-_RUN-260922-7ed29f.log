{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf25","stream":{"kind":"session","id":"01a0c7e8-b0ce-7b51-a856-c1e5aeba35b8"},"sequence":1517,"recorded_at":1780531400003029,"record_type":"event","durability":"durable","causation_id":"1e747257-7dba-4be5-8162-7ca370e28419","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1e747257-7dba-4be5-8162-7ca370e28419","run_stream":{"kind":"run","id":"1e747257-7dba-4be5-8162-7ca370e28419"},"task_stream":{"kind":"task","id":"01a0c7f1-bcda-7573-9e97-433a293b6e68"},"task_id":"01a0c7f1-bcda-7573-9e97-433a293b6e68","event":{"kind":"output","task_id":"01a0c7f1-bcda-7573-9e97-433a293b6e68","chunk":"{\n  \"chunk_id\": \"exec-42-1\",\n  \"command\": \"sed -n '975,1010p;1535,1560p;2105,2120p' internal/tmuxserver/mutant_harness.py\",\n  \"description\": \"Read affected harness rows\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"        path=f\\\"{PACKAGE}/ops.go\\\",\\n        find='deadline, terminstance.AuthorizationForceStale, reqBackend, func(result terminstance.Result) OpOutcome {',\\n        replace='deadline, terminstance.AuthorizationControl, reqBackend, func(result terminstance.Result) OpOutcome {',\\n        count=1,\\n        run=\\\"TestExecuteTerminate\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Rewires exactly the terminate effect loop to the control authorization kind; the entry check still demands force_stale. Kill path: the kind mismatch refuses at the first effect recheck instead of killing.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-lifecycle-record-success\\\",\\n        path=f\\\"{PACKAGE}/ops.go\\\",\\n        find='\\\\tlc.recordAfter(mctx.TerminalInstanceID, target)\\\\n',\\n        replace='\\\\tlc.recordAfter(mctx.TerminalInstanceID, source)\\\\n',\\n        count=1,\\n        run=\\\"(TestExecuteTerminate|TestExecuteRestore)\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Records exactly the source state on the success path instead of the target; the failure path keeps its own row. Kill path: the state memory disagrees with the adopted mutation on both receipt operations.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-lifecycle-record-failure\\\",\\n        path=f\\\"{PACKAGE}/ops.go\\\",\\n        find='\\\\t\\\\tlc.recordAfter(mctx.TerminalInstanceID, after)\\\\n',\\n        replace='\\\\t\\\\tlc.recordAfter(mctx.TerminalInstanceID, target)\\\\n',\\n        count=1,\\n        run=\\\"TestRunLifecycleEffectsRefusesForgedEvidence\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Records exactly the target state on the failure path instead of the adopted after-state; the success path keeps its own row. Kill path: the refused run poisons the memory with an unreached state.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-lifecycle-agreement-session\\\",\\n        path=f\\\"{PACKAGE}/lifecycle.go\\\",\\n        find='\\\\tif body.Binding.SessionID != body.Context.SessionID ||\\\\n\\\\t\\\\tbody.Binding.TerminalInstanceID != body.Context.TerminalInstanceID ||\\\\n',\\n        replace='\\\\tif body.Binding.TerminalInstanceID != body.Context.TerminalInstanceID ||\\\\n',\\n        count=1,\\n        run=\\\"TestExecuteCreateBindingAgreement/session\\\",\\n        expect=\\\"KILLED\\\",\\n        path=f\\\"{PACKAGE}/ops.go\\\",\\n        find='\\\\tif err := CheckServerAttested(admission, body.BackendGeneration); err != nil {\\\\n',\\n        replace='\\\\tif err := CheckServerAttested(admission, body.BackendGeneration); err != nil && err.Error() != \\\"tmux server refused: tmux_readiness_not_authorizing at server attestation\\\" {\\\\n',\\n        count=1,\\n        run=\\\"TestExecuteAttachRefusals/fresh-decoy\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the decoy-membered admission past the attach attestation wiring; the stale-generation member still refuses. Kill path: the unattested server presents instead of refusing.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-attach-record\\\",\\n        path=f\\\"{PACKAGE}/ops.go\\\",\\n        find='\\\\t\\\\tlc.recordAfter(body.TerminalInstanceID, terminalbackend.StateActive)\\\\n',\\n        replace='\\\\t\\\\tlc.recordAfter(body.TerminalInstanceID, terminalbackend.StateParked)\\\\n',\\n        count=1,\\n        run=\\\"TestExecuteAttach\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Records exactly the parked state on the attach success path instead of the adopted active; the receipt paths keep their own rows. Kill path: the state memory disagrees with the presented attach.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-attach-descriptor-order\\\",\\n        path=f\\\"{PACKAGE}/ops.go\\\",\\n        find='\\\\treturn socket + \\\"\\\\\\\\n\\\" + instance + \\\"\\\\\\\\n\\\" + client\\\\n',\\n        replace='\\\\treturn instance + \\\"\\\\\\\\n\\\" + socket + \\\"\\\\\\\\n\\\" + client\\\\n',\\n        count=1,\\n        run=\\\"TestExecuteAttach\\\",\\n        expect=\\\"KILLED\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the exit-1 boundary wait past the refused-exit arm; every other nonzero exit still refuses. Kill path: the failed wait evidences a boundary, at the helper and through the boundary dispatch alike.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-attach-readonly-record\\\",\\n        path=f\\\"{PACKAGE}/ops.go\\\",\\n        find='\\\\tif body.InputAuthorized {\\\\n\\\\t\\\\tlc.recordAfter(body.TerminalInstanceID, terminalbackend.StateActive)\\\\n\\\\t}\\\\n',\\n        replace='\\\\tif body.InputAuthorized || body.ClientID == \\\"0198f4c8-8e50-7f66-8f70-555555555552\\\" {\\\\n\\\\t\\\\tlc.recordAfter(body.TerminalInstanceID, terminalbackend.StateActive)\\\\n\\\\t}\\\\n',\\n        count=1,\\n        run=\\\"TestExecuteReadOnlyAttachPreservesQuiescedInput\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the read-only fixture client into active-state recording; every other read-only attach still observes without recording. Kill path: the read-only attach reopens quiesced input, so the third call succeeds through the attach dispatch.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-quiesce-report-corrupt\\\",\\n        path=f\\\"{PACKAGE}/lifecycle.go\\\",\\n\",\n  \"original_output_bytes\": 4753,\n  \"original_output_tokens\": 1189,\n  \"truncated\": false\n}","final_result":true}}}
