{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ea59","stream":{"kind":"session","id":"01a0c7e8-b0ce-7b51-a856-c1e5aeba35b8"},"sequence":4999,"recorded_at":1780531400009993,"record_type":"event","durability":"durable","causation_id":"1e747257-7dba-4be5-8162-7ca370e28419","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1e747257-7dba-4be5-8162-7ca370e28419","run_stream":{"kind":"run","id":"1e747257-7dba-4be5-8162-7ca370e28419"},"task_stream":{"kind":"task","id":"01a0c80e-8c8f-7540-9942-cdaa4776ba5a"},"task_id":"01a0c80e-8c8f-7540-9942-cdaa4776ba5a","event":{"kind":"output","task_id":"01a0c80e-8c8f-7540-9942-cdaa4776ba5a","chunk":"{\n  \"chunk_id\": \"exec-150-1\",\n  \"command\": \"python3 - <<'PYEOF'\\nimport json\\nfrom collections import Counter\\n\\nclosure = set(json.load(open(\\\"/tmp/rev3ev/importer-closure.json\\\"))[\\\"production_closure\\\"])\\n# closure entries are full import paths; suite packages match.\\n\\ndef outcomes(path):\\n    res, pkgs = {}, {}\\n    with open(path) as f:\\n        for line in f:\\n            try:\\n                e = json.loads(line)\\n            except Exception:\\n                continue\\n            if e.get(\\\"Action\\\") in (\\\"pass\\\", \\\"fail\\\", \\\"skip\\\") and \\\"Test\\\" in e:\\n                res[(e[\\\"Package\\\"], e[\\\"Test\\\"])] = e[\\\"Action\\\"]\\n            elif e.get(\\\"Action\\\") in (\\\"pass\\\", \\\"fail\\\", \\\"skip\\\") and \\\"Test\\\" not in e and \\\"Package\\\" in e:\\n                pkgs[e[\\\"Package\\\"]] = e[\\\"Action\\\"]\\n    return res, pkgs\\n\\nbase, basepkgs = outcomes(\\\".temp/TASK-260830-1c28dz/grid/suite_base.json\\\")\\ncand, candpkgs = outcomes(\\\".temp/TASK-260830-1c28dz/grid/suite_candidate.json\\\")\\n\\ndef scope(keys):\\n    return {k: v for k, v in keys.items() if k[0] in closure}\\n\\nb, c = scope(base), scope(cand)\\nmoved = [(k, b[k], c[k]) for k in b if k in c and b[k] != c[k]]\\nadded = [(k, c[k]) for k in c if k not in b]\\nremoved = [k for k in b if k not in c]\\nprint(f\\\"CLOSURE: {len(closure)} packages; base keys {len(b)}, candidate keys {len(c)}\\\")\\nprint(f\\\"MOVED: {len(moved)}; ADDED: {len(added)}; REMOVED: {len(removed)}\\\")\\nprint(\\\"ADDED outcomes:\\\", Counter(o for _, o in added))\\naddpkgs = Counter(k[0].split(\\\"/\\\")[-1] for k, _ in added)\\nprint(\\\"ADDED by package:\\\", dict(sorted(addpkgs.items())))\\n# Every closure package present in both streams?\\nmissing_b = closure - set(basepkgs)\\nmissing_c = closure - set(candpkgs)\\nprint(\\\"closure pkgs missing base stream:\\\", missing_b or \\\"none\\\")\\nprint(\\\"closure pkgs missing candidate stream:\\\", missing_c or \\\"none\\\")\\n# crashgate/environ status\\nfor p in (\\\"github.com/relux-works/agent-session-manager/internal/crashgate\\\",\\n          \\\"github.com/relux-works/agent-session-manager/internal/environ\\\"):\\n    bt = [k for k in base if k[0] == p]\\n    print(p.split(\\\"/\\\")[-1], \\\"base tests:\\\", len(bt), \\\"pkg:\\\", basepkgs.get(p), \\\"->\\\", candpkgs.get(p))\\n\\nwith open(\\\".temp/TASK-260830-1c28dz/grid/suite_diff.txt\\\", \\\"w\\\") as f:\\n    f.write(f\\\"P2-A suite outcome diff, base d4bd91d0 vs candidate, keyed (package, test) -> pass|fail|skip\\\\n\\\")\\n    f.write(f\\\"closure packages: {len(closure)}; base keys: {len(b)}; candidate keys: {len(c)}\\\\n\\\")\\n    f.write(f\\\"MOVED: {len(moved)}\\\\n\\\")\\n    for k, bb, cc in moved:\\n        f.write(f\\\"  MOVE {k[0]}::{k[1]} {bb} -> {cc}\\\\n\\\")\\n    f.write(f\\\"ADDED: {len(added)} (all passing: {all(o=='pass' for _,o in added)})\\\\n\\\")\\n    for pkg, n in sorted(addpkgs.items()):\\n        f.write(f\\\"  {pkg}: {n} added\\\\n\\\")\\n    f.write(f\\\"REMOVED: {len(removed)}\\\\n\\\")\\nprint(\\\"report written\\\")\\nPYEOF\",\n  \"description\": \"Write closure-scoped diff report\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"CLOSURE: 34 packages; base keys 23054, candidate keys 23530\\nMOVED: 0; ADDED: 476; REMOVED: 0\\nADDED outcomes: Counter({'pass': 476})\\nADDED by package: {'termbind': 5, 'tmuxserver': 471}\\nclosure pkgs missing base stream: none\\nclosure pkgs missing candidate stream: none\\ncrashgate base tests: 112 pkg: pass -> pass\\nenviron base tests: 289 pkg: pass -> pass\\nreport written\\n\",\n  \"original_output_bytes\": 369,\n  \"original_output_tokens\": 93,\n  \"truncated\": false\n}","final_result":true}}}
