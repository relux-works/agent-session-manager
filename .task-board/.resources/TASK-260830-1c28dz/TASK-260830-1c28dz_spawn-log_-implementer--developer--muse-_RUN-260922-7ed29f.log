r line.startswith(\\\"| parked \\\") or line.startswith(\\\"| refuse \\\"):\\n        for name in re.findall(r\\\"WrapperRestore\\\\w+\\\", line):\\n            base = \\\"Test\\\" + name.split(\\\"/\\\")[0]\\n            if base not in defined:\\n                print(\\\"TABLE E MISSING:\\\", base)\\nprint(\\\"table E check done\\\")\\nPYEOF\",\n  \"description\": \"Check all referenced test names resolve\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"all clause-row test names resolve\\ntable E check done\\n\",\n  \"original_output_bytes\": 53,\n  \"original_output_tokens\": 14,\n  \"truncated\": false\n}","final_result":true}}}
