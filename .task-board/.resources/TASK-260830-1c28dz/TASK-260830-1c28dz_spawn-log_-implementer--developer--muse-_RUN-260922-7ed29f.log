{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000dd17","stream":{"kind":"session","id":"01a0c7e8-b0ce-7b51-a856-c1e5aeba35b8"},"sequence":3302,"recorded_at":1780531400006599,"record_type":"event","durability":"durable","causation_id":"1e747257-7dba-4be5-8162-7ca370e28419","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1e747257-7dba-4be5-8162-7ca370e28419","run_stream":{"kind":"run","id":"1e747257-7dba-4be5-8162-7ca370e28419"},"task_stream":{"kind":"task","id":"01a0c7ff-b477-73e0-8b07-ad84604118aa"},"task_id":"01a0c7ff-b477-73e0-8b07-ad84604118aa","event":{"kind":"output","task_id":"01a0c7ff-b477-73e0-8b07-ad84604118aa","chunk":"{\n  \"chunk_id\": \"exec-90-1\",\n  \"command\": \"python3 - <<'PYEOF'\\nfrom pathlib import Path\\np = Path(\\\"internal/tmuxserver/TRACEABILITY.md\\\")\\nraw = p.read_text()\\n\\ndef sub(old, new):\\n    global raw\\n    assert raw.count(old) == 1, \\\"anchor not unique: \\\" + old[:80]\\n    raw = raw.replace(old, new, 1)\\n\\n# 1. Scope paragraph + intro ratio.\\nsub(\\\"second leaf (TASK-260830-1c28dz, rows 59-91) adds the §4.2 production\\\",\\n    \\\"second leaf (TASK-260830-1c28dz, rows 59-92) adds the §4.2 production\\\")\\nsub(\\\"the ratio is not evidence. 91 of 91 AC rows driven: rows 1-58 first\\\",\\n    \\\"the ratio is not evidence. 92 of 92 AC rows driven: rows 1-58 first\\\")\\nsub(\\\"whitespace-override arms); rows 59-91 second leaf (adapters, bind\\\\nstep, eight lifecycle operations, receipt discipline, state memory).\\\",\\n    \\\"whitespace-override arms); rows 59-92 second leaf (adapters, bind\\\\nstep, eight lifecycle operations, receipt discipline, state memory,\\\\nafter-restore composition).\\\")\\n\\n# 2. Row 59: NUL witness.\\nsub(\\\"transport failures and signal deaths pass through as errors and prove nothing. | OSRunner (exec.go) | TestOSRunnerReportsExitAsData, TestOSRunnerCapturesStderr, TestOSRunnerSignalDeathProvesNothing, Tes