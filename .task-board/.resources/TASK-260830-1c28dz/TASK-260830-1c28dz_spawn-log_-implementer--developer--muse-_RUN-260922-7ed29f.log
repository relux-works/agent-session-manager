 \\\"termbind\\\"):\\n        n = sum(1 for _ in open(f\\\".temp/TASK-260830-1c28dz/grid/grid_n_{pkg}.jsonl\\\"))\\n        f.write(f\\\"new-entry {pkg}: {n} keys, all ADDED (base has no such entry)\\\\n\\\")\\nprint(open(\\\".temp/TASK-260830-1c28dz/grid/entry_diff.txt\\\").read())\\nPYEOF\\ngit diff HEAD --stat -- internal/tmuxserver/errors.go internal/tmuxserver/ownership_unix.go internal/tmuxserver/ownership_windows.go internal/termbind/ | head; echo ===; git diff HEAD -- internal/tmuxserver/errors.go | head -60\",\n  \"description\": \"Write entry diff and show additive proof\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"P2-A entry grid diff, base d4bd91d0 vs candidate, keyed (package, entry, input) -> (outcome, code, digest)\\npre-existing tmuxserver: 18 keys; moved=0 added=0 removed=0\\npre-existing termbind: 9 keys; moved=0 added=0 removed=0\\nnew-entry tmuxserver: 25 keys, all ADDED (base has no such entry)\\nnew-entry termbind: 2 keys, all ADDED (base has no such entry)\\n\\n internal/termbind/TRACEABILITY.md        | 14 +++++++++--\\n internal/termbind/mutant_harness.py      | 40 ++++++++++++++++++++++++++++++++\\n internal/tmuxserver/errors.go            | 11 +++++++++\\n internal/tmuxserver/ownership_unix.go    | 12 ++++++++++\\n internal/tmuxserver/ownership_windows.go |  7 ++++++\\n 5 files changed, 82 insertions(+), 2 deletions(-)\\n===\\ndiff --git a/internal/tmuxserver/errors.go b/internal/tmuxserver/errors.go\\nindex fd2ad3b..d8ed4c3 100644\\n--- a/internal/tmuxserver/errors.go\\n+++ b/internal/tmuxserver/errors.go\\n@@ -29,6 +29,17 @@ const (\\n \\t// CodeSpawnFailed reports a dedicated-server spawn failure.\\n \\t// The spawner is caller-supplied; this code carries no fallback.\\n \\tCodeSpawnFailed = \\\"tmux_server_spawn_failed\\\"\\n+\\t// CodeUnsafeSocketPath refuses a socket path, parent, or ancestor\\n+\\t// whose file kind, ownership, or permissions are unsafe, before\\n+\\t// bind or connect (SPEC 810-81