{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c933","stream":{"kind":"session","id":"01a0c7e8-b0ce-7b51-a856-c1e5aeba35b8"},"sequence":756,"recorded_at":1780531400001507,"record_type":"event","durability":"durable","causation_id":"1e747257-7dba-4be5-8162-7ca370e28419","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"1e747257-7dba-4be5-8162-7ca370e28419","run_stream":{"kind":"run","id":"1e747257-7dba-4be5-8162-7ca370e28419"},"call_id":"call_01a0c7ea6a43702e94aca52e974bb4cb","text":"Read text file `internal/tmuxserver/exec.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"context\"\n6|\t\"errors\"\n7|\t\"os\"\n8|\t\"os/exec\"\n9|\t\"strings\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n14|)\n15|\n16|// RunResult is one completed process execution: the exit code and both\n17|// streams are data, never an error. A nonzero exit alone proves\n18|// nothing: tmux reports every failure with exit 1 (verified on 3.6a),\n19|// so absence is proven only by an exit paired with its absence-shaped\n20|// stderr (see classifyAbsence); only a transport failure — the process\n21|// never ran, or died by signal — returns an error, and an error proves\n22|// nothing, not even non-commit.\n23|type RunResult struct {\n24|\tStdout   []byte\n25|\tStderr   []byte\n26|\tExitCode int\n27|}\n28|\n29|// Runner executes one argv vector to completion. Production callers pass\n30|// vectors built by BuildCommand only; tests inject fakes. No Runner\n31|// implementation in the test suite starts a tmux process.\n32|type Runner interface {\n33|\tRun(ctx context.Context, argv []string) (RunResult, error)\n34|}\n35|\n36|// OSRunner is the production Runner: native process start with no\n37|// shell. The child environment scrubs the two ambient tmux variables\n38|// (EnvTMUX, EnvTMUXTmpDir) so an ambient session can never leak into a\n39|// -S-addressed invocation; -S addressing already ignores them, and the\n40|// scrub makes that independence structural rather than relied-upon.\n41|type OSRunner struct {\n42|\t// Command builds the process. Nil means exec.CommandContext.\n43|\t// Tests inject a helper-process fake; production leaves it nil.\n44|\tCommand func(ctx context.Context, name string, args ...string) *exec.Cmd\n45|}\n46|\n47|// Run executes argv and reports its exit code as data. A vector that\n48|// fails the landed argv shape gate refuses before any process starts.\n49|func (runner OSRunner) Run(ctx context.Context, argv []string) (RunResult, error) {\n50|\tif err := secprim.CheckArgv(argv); err != nil {\n51|\t\treturn RunResult{}, &Error{Code: CodeInvalidArguments, Detail: \"command argv\"}\n52|\t}\n53|\tcommand := exec.CommandContext\n54|\tif runner.Command != nil {\n55|\t\tcommand = runner.Command\n56|\t}\n57|\tproc := command(ctx, argv[0], argv[1:]...)\n58|\tproc.Env = scrubTmuxEnv(os.Environ())\n59|\tvar stdout, stderr bytes.Buffer\n60|\tproc.Stdout = &stdout\n61|\tproc.Stderr = &stderr\n62|\tif err := proc.Run(); err != nil {\n63|\t\tvar exitErr *exec.ExitError\n64|\t\tif errors.As(err, &exitErr) {\n65|\t\t\t// A signal-killed child reports ExitCode -1: the process\n66|\t\t\t// never answered, so the run is a transport failure\n67|\t\t\t// (unknown), never exit data. Returning -1 as data\n68|\t\t\t// would let a killed probe manufacture absence or\n69|\t\t\t// closure downstream; every absence classifier also\n70|\t\t\t// refuses negative exits, so both layers fail closed.\n71|\t\t\tif exitErr.ExitCode() < 0 {\n72|\t\t\t\treturn RunResult{}, err\n73|\t\t\t}\n74|\t\t\treturn RunResult{Stdout: stdout.Bytes(), Stderr: stderr.Bytes(), ExitCode: exitErr.ExitCode()}, nil\n75|\t\t}\n76|\t\treturn RunResult{}, err\n77|\t}\n78|\treturn RunResult{Stdout: stdout.Bytes(), Stderr: stderr.Bytes(), ExitCode: 0}, nil\n79|}\n80|\n81|// scrubTmuxEnv removes the ambient tmux session variables from a process\n82|// environment. It matches exact NAME= prefixes, so TMUX_FOO survives\n83|// while TMUX and TMUX_TMPDIR are dropped.\n84|func scrubTmuxEnv(env []string) []string {\n85|\tscrubbed := make([]string, 0, len(env))\n86|\tfor _, entry := range env {\n87|\t\tif strings.HasPrefix(entry, EnvTMUX+\"=\") || strings.HasPrefix(entry, EnvTMUXTmpDir+\"=\") {\n88|\t\t\tcontinue\n89|\t\t}\n90|\t\tscrubbed = append(scrubbed, entry)\n91|\t}\n92|\treturn scrubbed\n93|}\n94|\n95|// Directive is the closed tmux primitive vocabulary this leaf executes.\n96|// Each lifecycle operation maps to a fixed directive sequence (see the\n97|// backend drivers); no operation execs a primitive outside this enum,\n98|// and no primitive addresses any server but the derived -S socket.\n99|type Directive string\n100|\n101|// tmux primitives. The string values are the literal tmux(1) command\n102|// names verified against tmux 3.6a list-commands.\n103|const (\n104|\tDirectiveNewSession    Directive = \"new-session\"\n105|\tDirectiveAttachSession Directive = \"attach-session\"\n106|\tDirectiveListPanes     Directive = \"list-panes\"\n107|\tDirectiveListSessions  Directive = \"list-sessions\"\n108|\tDirectiveLockSession   Directive = \"lock-session\"\n109|\tDirectiveDetachClients Directive = \"detach-client\"\n110|\tDirectiveWaitBoundary  Directive = \"wait-for\"\n111|\tDirectiveSendInterrupt Directive = \"send-keys\"\n112|\tDirectiveHasSession    Directive = \"has-session\"\n113|\tDirectiveKillSession   Directive = \"kill-session\"\n114|)\n115|\n116|// ParseDirective admits exactly the ten tmux primitives.\n117|func ParseDirective(value string) (Directive, error) {\n118|\tswitch Directive(value) {\n119|\tcase DirectiveNewSession, DirectiveAttachSession, DirectiveListPanes,\n120|\t\tDirectiveListSessions, DirectiveLockSession, DirectiveDetachClients,\n121|\t\tDirectiveWaitBoundary, DirectiveSendInterrupt, DirectiveHasSession,\n122|\t\tDirectiveKillSession:\n123|\t\treturn Directive(value), nil\n124|\tdefault:\n125|\t\treturn \"\", &Error{Code: terminalbackend.CodeProtocolError, Detail: \"command vocabulary\"}\n126|\t}\n127|}\n128|\n129|// PanesFormat is the list-panes row shape: the foreground command name\n130|// only. It deliberately excludes pane_pid: identity MUST NOT be a PID\n131|// (pinned SPEC 4.B), so provider presence is proven by a non-empty\n132|// command row, never by a process number.\n133|const PanesFormat = \"#{pane_current_command}\"\n134|\n135|// SessionsFormat is the list-sessions row shape: session name and\n136|// attached-client count, pipe-separated.\n137|const SessionsFormat = \"#{session_name}|#{session_attached}\"\n138|\n139|// BoundaryChannelPrefix prefixes every wait-for channel this leaf\n140|// waits on. The channel is ax-boundary-<quiescence_generation UUIDv7>:\n141|// fixed prefix plus caller-bound generation, never caller free text.\n142|// The observation runs the bare `wait-for <channel>` form, which\n143|// blocks until the wrapper wakes it with `wait-for -S`: the `-L` form\n144|// acquires a channel lock and succeeds immediately on a fresh channel\n145|// without any wrapper signal, so it can never evidence a boundary.\n146|const BoundaryChannelPrefix = \"ax-boundary-\"\n147|\n148|// CommandArgs carries the per-directive identity material. Only the\n149|// members the directive reads are validated; the rest stay zero. Every\n150|// tmux target session name is the terminal instance ID: the one\n151|// dedicated server hosts every logical session, so targets are\n152|// instance-scoped, while the wrapper tail always names the logical\n153|// session (ax pane <session_id>). The acquisition bootstrap vector\n154|// (BuildArgv, session-named) and lifecycle instance vectors coexist as\n155|// distinct sessions on that server; lifecycle entries address instances\n156|// only.\n157|type CommandArgs struct {\n158|\t// RuntimeDir is the tmux runtime directory (<root>/tmux).\n159|\tRuntimeDir string\n160|\t// Socket must equal SocketPath(RuntimeDir): the only admissible\n161|\t// server address. Any other value refuses.\n162|\tSocket string\n163|\t// SessionID is the logical session (create/restore wrapper tail).\n164|\tSessionID string\n165|\t// InstanceID is the tmux target session name.\n166|\tInstanceID string\n167|\t// QuiescenceGeneration selects the wait-for channel (boundary).\n168|\tQuiescenceGeneration string\n169|\t// AttachInput carries the attach input authorization for the\n170|\t// attach-session vector: false emits the read-only `-r` client\n171|\t// (only detach/switch keys have any effect), true emits the\n172|\t// writable vector. HasAttachInput must be set whenever the\n173|\t// attach directive builds: an unstated authorization refuses\n174|\t// instead of defaulting to either vector.\n175|\tAttachInput    bool\n176|\tHasAttachInput bool\n177|}\n178|\n179|// BuildCommand builds one validated tmux -S argv vector for a\n180|// directive. The socket pin mirrors the BuildArgv spawn-socket arm:\n181|// the socket must be the one derived from the runtime directory, so an\n182|// ambient socket passed here refuses instead of being addressed. The\n183|// assembled vector passes the landed argv shape gate before return.\n184|func BuildCommand(directive Directive, args CommandArgs) ([]string, error) {\n185|\tif _, err := ParseDirective(string(directive)); err != nil {\n186|\t\treturn nil, err\n187|\t}\n188|\tif args.Socket != SocketPath(args.RuntimeDir) {\n189|\t\treturn nil, &Error{Code: CodeAmbientReuse, Detail: \"command socket\"}\n190|\t}\n191|\tvar argv []string\n192|\tswitch directive {\n193|\tcase DirectiveNewSession:\n194|\t\tsession, instance, err := commandSessionInstance(args)\n195|\t\tif err != nil {\n196|\t\t\treturn nil, err\n197|\t\t}\n198|\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"new-session\", \"-d\",\n199|\t\t\t\"-s\", instance, \"ax\", \"pane\", session}\n200|\tcase DirectiveAttachSession:\n201|\t\tinstance, err := commandInstance(args)\n202|\t\tif err != nil {\n203|\t\t\treturn nil, err\n204|\t\t}\n205|\t\tif !args.HasAttachInput {\n206|\t\t\treturn nil, &Error{Code: CodeInvalidArguments, Detail: \"command attach authorization\"}\n207|\t\t}\n208|\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"attach-session\", \"-t\", instance}\n209|\t\tif !args.AttachInput {\n210|\t\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"attach-session\", \"-r\", \"-t\", instance}\n211|\t\t}\n212|\tcase DirectiveListPanes:\n213|\t\tinstance, err := commandInstance(args)\n214|\t\tif err != nil {\n215|\t\t\treturn nil, err\n216|\t\t}\n217|\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"list-panes\", \"-t\", instance, \"-F\", PanesFormat}\n218|\tcase DirectiveListSessions:\n219|\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"list-sessions\", \"-F\", SessionsFormat}\n220|\tcase DirectiveLockSession:\n221|\t\tinstance, err := commandInstance(args)\n222|\t\tif err != nil {\n223|\t\t\treturn nil, err\n224|\t\t}\n225|\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"lock-session\", \"-t\", instance}\n226|\tcase DirectiveDetachClients:\n227|\t\tinstance, err := commandInstance(args)\n228|\t\tif err != nil {\n229|\t\t\treturn nil, err\n230|\t\t}\n231|\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"detach-client\", \"-s\", instance}\n232|\tcase DirectiveWaitBoundary:\n233|\t\tchannel, err := commandChannel(args)\n234|\t\tif err != nil {\n235|\t\t\treturn nil, err\n236|\t\t}\n237|\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"wait-for\", channel}\n238|\tcase DirectiveSendInterrupt:\n239|\t\tinstance, err := commandInstance(args)\n240|\t\tif err != nil {\n241|\t\t\treturn nil, err\n242|\t\t}\n243|\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"send-keys\", \"-t\", instance, \"C-c\"}\n244|\tcase DirectiveHasSession:\n245|\t\tinstance, err := commandInstance(args)\n246|\t\tif err != nil {\n247|\t\t\treturn nil, err\n248|\t\t}\n249|\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"has-session\", \"-t\", instance}\n250|\tcase DirectiveKillSession:\n251|\t\tinstance, err := commandInstance(args)\n252|\t\tif err != nil {\n253|\t\t\treturn nil, err\n254|\t\t}\n255|\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"kill-session\", \"-t\", instance}\n256|\tdefault:\n257|\t\treturn nil, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"command vocabulary\"}\n258|\t}\n259|\tif err := secprim.CheckArgv(argv); err != nil {\n260|\t\treturn nil, &Error{Code: CodeInvalidArguments, Detail: \"command argv\"}\n261|\t}\n262|\treturn argv, nil\n263|}\n264|\n265|// commandInstance validates the tmux target: the terminal instance ID\n266|// as canonical UUIDv7.\n267|func commandInstance(args CommandArgs) (string, error) {\n268|\tinstance, err := scalar.ParseUUIDv7(args.InstanceID)\n269|\tif err != nil {\n270|\t\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"command instance\"}\n271|\t}\n272|\treturn instance.String(), nil\n273|}\n274|\n275|// commandSessionInstance validates the create/restore pair: the logical\n276|// session for the wrapper tail and the instance for the target name.\n277|func commandSessionInstance(args CommandArgs) (string, string, error) {\n278|\tsession, err := scalar.ParseUUIDv7(args.SessionID)\n279|\tif err != nil {\n280|\t\treturn \"\", \"\", &Error{Code: CodeInvalidArguments, Detail: \"command session\"}\n281|\t}\n282|\tinstance, err := commandInstance(args)\n283|\tif err != nil {\n284|\t\treturn \"\", \"\", err\n285|\t}\n286|\treturn session.String(), instance, nil\n287|}\n288|\n289|// commandChannel derives the wait-for channel from the quiescence\n290|// generation: fixed prefix plus canonical UUIDv7, never caller text.\n291|func commandChannel(args CommandArgs) (string, error) {\n292|\tgeneration, err := scalar.ParseUUIDv7(args.QuiescenceGeneration)\n293|\tif err != nil {\n294|\t\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"command quiescence\"}\n295|\t}\n296|\treturn BoundaryChannelPrefix + generation.String(), nil\n297|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
