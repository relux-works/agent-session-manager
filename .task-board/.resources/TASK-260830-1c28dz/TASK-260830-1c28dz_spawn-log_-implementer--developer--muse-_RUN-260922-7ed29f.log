/ input after closure.\n+func (lc *Lifecycle) recordAfter(instance string, after terminalbackend.InstanceState) error {\n+\tif lc.States == nil {\n+\t\treturn nil\n+\t}\n+\treturn lc.States.Record(instance, after)\n+}\n","final_result":true}}}
