{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ea2f","stream":{"kind":"session","id":"01a0c7e8-b0ce-7b51-a856-c1e5aeba35b8"},"sequence":4978,"recorded_at":1780531400009951,"record_type":"event","durability":"durable","causation_id":"1e747257-7dba-4be5-8162-7ca370e28419","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"1e747257-7dba-4be5-8162-7ca370e28419","run_stream":{"kind":"run","id":"1e747257-7dba-4be5-8162-7ca370e28419"},"task_stream":{"kind":"task","id":"01a0c80e-4ee8-75d3-ad43-23a14b1a5704"},"task_id":"01a0c80e-4ee8-75d3-ad43-23a14b1a5704","event":{"kind":"output","task_id":"01a0c80e-4ee8-75d3-ad43-23a14b1a5704","chunk":"{\n  \"chunk_id\": \"exec-149-1\",\n  \"command\": \"python3 - <<'PYEOF'\\nimport json\\nfrom collections import Counter\\n\\ndef outcomes(path):\\n    res = {}\\n    pkgs = {}\\n    with open(path) as f:\\n        for line in f:\\n            try:\\n                e = json.loads(line)\\n            except Exception:\\n                continue\\n            if e.get(\\\"Action\\\") in (\\\"pass\\\", \\\"fail\\\", \\\"skip\\\") and \\\"Test\\\" in e:\\n                res[(e[\\\"Package\\\"], e[\\\"Test\\\"])] = e[\\\"Action\\\"]\\n            elif e.get(\\\"Action\\\") in (\\\"pass\\\", \\\"fail\\\", \\\"skip\\\") and \\\"Test\\\" not in e and \\\"Package\\\" in e:\\n                pkgs[e[\\\"Package\\\"]] = e[\\\"Action\\\"]\\n    return res, pkgs\\n\\nbase, basepkgs = outcomes(\\\".temp/TASK-260830-1c28dz/grid/suite_base.json\\\")\\ncand, candpkgs = outcomes(\\\".temp/TASK-260830-1c28dz/grid/suite_candidate.json\\\")\\nprint(f\\\"base tests: {len(base)}, candidate tests: {len(cand)}\\\")\\nprint(f\\\"base pkgs: {len(basepkgs)}, candidate pkgs: {len(candpkgs)}\\\")\\nmoved = [(k, base[k], cand[k]) for k in base if k in cand and base[k] != cand[k]]\\nadded = [k for k in cand if k not in base]\\nremoved = [k for k in base if k not in cand]\\nprint(f\\\"MOVED(outcome changed): {len(moved)}\\\")\\nfor k, b, c in moved[:40]:\\n    print(f\\\"  {k[0].split('/')[-1]}::{k[1]} {b} -> {c}\\\")\\nprint(f\\\"ADDED: {len(added)}\\\")\\naddpkgs = Counter(k[0] for k in added)\\nfor p, n in sorted(addpkgs.items()):\\n    print(f\\\"  {p.split('/')[-1]}: {n}\\\")\\nprint(f\\\"REMOVED: {len(removed)}\\\")\\nfor k in removed[:20]:\\n    print(f\\\"  {k[0].split('/')[-1]}::{k[1]}\\\")\\nprint(\\\"PKG MOVES:\\\", [(p, basepkgs[p], candpkgs[p]) for p in basepkgs if p in candpkgs and basepkgs[p] != candpkgs[p]])\\nprint(\\\"PKG ADDED:\\\", [p for p in candpkgs if p not in basepkgs])\\nprint(\\\"PKG REMOVED:\\\", [p for p in basepkgs if p not in candpkgs])\\nPYEOF\",\n  \"description\": \"Diff suite outcomes base vs candidate\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"base tests: 23874, candidate tests: 24350\\nbase pkgs: 45, candidate pkgs: 45\\nMOVED(outcome changed): 0\\nADDED: 476\\n  termbind: 5\\n  tmuxserver: 471\\nREMOVED: 0\\nPKG MOVES: []\\nPKG ADDED: []\\nPKG REMOVED: []\\n\",\n  \"original_output_bytes\": 200,\n  \"original_output_tokens\": 50,\n  \"truncated\": false\n}","final_result":true}}}
