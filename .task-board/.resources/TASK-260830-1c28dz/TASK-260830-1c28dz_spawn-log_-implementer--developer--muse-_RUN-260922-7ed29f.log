\n+type RefreshHooks struct {\n+\tBeforeSelect func()\n+}\n","edit_facts":{"tool_name":"edit_file","path":"internal/tmuxserver/lifecycle.go","added":22,"removed":9},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d705","stream":{"kind":"session","id":"01a0c7e8-b0ce-7b51-a856-c1e5aeba35b8"},"sequence":2525,"recorded_at":1780531400005045,"record_type":"event","durability":"durable","causation_id":"1e747257-7dba-4be5-8162-7ca370e28419","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"1e747257-7dba-4be5-8162-7ca370e28419","run_stream":{"kind":"run","id":"1e747257-7dba-4be5-8162-7ca370e28419"},"call_id":"call_01a0c7f9948974f6987517b189c013c2","text":"edited\nchanged lines: lines 218-223\n--- original\n+++ updated\n@@\n-\tanswered := make(chan refreshResult, 1)\n-\tgo func() {\n-\t\twinner, err := lc.LeaseRefresh(refreshCtx, sessionID)\n-\t\tanswered <- refreshResult{winner: winner, err: err}\n-\t}()\n-\tselect {\n+\tanswered := make(chan refreshResult, 1)\n+\tgo func() {\n+\t\twinner, err := lc.LeaseRefresh(refreshCtx, sessionID)\n+\t\tanswered <- refreshResult{winner: winner, err: err}\n+\t}()\n+\tif lc.RefreshHooks != nil && lc.RefreshHooks.BeforeSelect != nil {\n+\t\tlc.RefreshHooks.BeforeSelect()\n+\t}\n+\tselect {\n","edit_facts":{"tool_name":"edit_file","path":"internal/tmuxserver/wrapper.go","added":9,"removed":6},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
