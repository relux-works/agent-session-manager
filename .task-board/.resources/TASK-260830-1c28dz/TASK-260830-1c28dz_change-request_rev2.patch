+}
+
+func TestPerformEffectInputClosed(t *testing.T) {
+	runner := newFakeRunner().queue("lock-session", "", 0).queue("detach-client", "", 0)
+	reqBackend := effectBackend(t, terminalbackend.OperationQuiesceInput, runner)
