+	var local *Error
+	if !errors.As(err, &local) {
+		t.Fatalf("want *Error %s at %s, got %T (%v)", code, detail, err, err)
+	}
+	if local.Code != code || local.Detail != detail {
+		t.Fatalf("want %s at %s, got %s at %s", code, detail, local.Code, local.Detail)
+	}
