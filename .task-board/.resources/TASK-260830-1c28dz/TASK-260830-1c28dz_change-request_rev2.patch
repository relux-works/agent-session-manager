+	reqBackend := effectBackend(t, terminalbackend.OperationCreate, runner)
+	if _, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectWrapperStarted); err == nil {
+		t.Fatal("failed exec committed")
