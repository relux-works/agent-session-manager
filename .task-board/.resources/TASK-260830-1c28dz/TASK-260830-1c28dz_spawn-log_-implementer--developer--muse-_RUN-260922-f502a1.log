{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8a7","stream":{"kind":"session","id":"01a0c8e2-bf86-7413-8196-b3968750220e"},"sequence":686,"recorded_at":1780531400001367,"record_type":"event","durability":"durable","causation_id":"b7feb475-a410-4d2f-87a4-514d078fdaaf","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b7feb475-a410-4d2f-87a4-514d078fdaaf","run_stream":{"kind":"run","id":"b7feb475-a410-4d2f-87a4-514d078fdaaf"},"task_stream":{"kind":"task","id":"01a0c8e5-6a5e-7c43-a13e-14d4381c6e5a"},"task_id":"01a0c8e5-6a5e-7c43-a13e-14d4381c6e5a","event":{"kind":"output","task_id":"01a0c8e5-6a5e-7c43-a13e-14d4381c6e5a","chunk":"Read text file `internal/terminstance/auth.go`.\n(159 line(s) above)\n160|\tvar value string\n161|\tif err := json.Unmarshal(raw, &value); err != nil {\n162|\t\treturn \"\", false\n163|\t}\n164|\treturn value, true\n165|}\n166|\n167|// LeaseView is the current winning AX lease as observed by the caller:\n168|// the (lease_id, lease_epoch) tuple the authorization must equal at\n169|// every side effect. Callers derive it from\n170|// fencing.Observation.Winner; the epoch-1 lease carries no checkpoint\n171|// and this view carries none either, so the vacuous checkpoint keying\n172|// the story's predecessor leaf removed cannot reappear here.\n173|type LeaseView struct {\n174|\tLeaseID string\n175|\tEpoch   uint64\n176|}\n177|\n178|// CheckAuthorization enforces the §4.C authorization rule at one check\n179|// point: the authorization names the required kind, is unexpired at now,\n180|// and its lease tuple equals the current winning AX lease. Every\n181|// violation is terminal_backend_unauthorized: a malformed document never\n182|// reaches here (ParseAXAuthorization owns shape), so anything refused\n183|// here is a binding failure, not a parse failure. Lease identity and\n184|// lease epoch are separate arms with separate details so a mutant\n185|// dropping either comparison is killed by its own drift test.\n186|// holder_host_id is parsed (UUIDv7) but never bound: LeaseView carries\n187|// the §5.3 winning (lease_id, epoch) tuple only, so a foreign holder\n188|// under the winning tuple is admitted. That is a stated bound, not a\n189|// bypass: no path here mints authority from the holder member.\n190|func CheckAuthorization(auth AXAuthorization, wantKind AuthorizationKind, lease LeaseView, now time.Time) error {\n191|\tif auth.Kind != wantKind {\n192|\t\treturn refuse(CodeUnauthorized, \"ax authorization kind binding\")\n193|\t}\n194|\texpires, err := auth.ExpiresAt.Time()\n195|\tif err != nil {\n196|\t\treturn refuse(CodeProtocolError, \"ax authorization timestamp\")\n197|\t}\n198|\tif !now.Before(expires) {\n199|\t\treturn refuse(CodeUnauthorized, \"ax authorization expiry\")\n200|\t}\n201|\tif auth.LeaseID != lease.LeaseID {\n202|\t\treturn refuse(CodeUnauthorized, \"ax authorization lease identity\")\n203|\t}\n204|\tif auth.LeaseEpoch != lease.Epoch {\n205|\t\treturn refuse(CodeUnauthorized, \"ax authorization lease epoch\")\n206|\t}\n207|\treturn nil\n208|}","final_result":true}}}
