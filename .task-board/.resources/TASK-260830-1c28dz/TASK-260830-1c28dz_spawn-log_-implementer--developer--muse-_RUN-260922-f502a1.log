ble either.\\n    # Pragmatic: rev6 did name-keyed (package,test) grids; replicate by re-running with -json? Cheaper: parse '^(ok|FAIL)\\\\s+(pkg)\\\\s' summary lines for package list and '--- (PASS|FAIL|SKIP): (Name)' attaching to the package whose block contains them: blocks split by summary lines is wrong order (summaries at end of each package block in -v output? Actually 'ok  pkg  time' prints when package finishes, so lines since previous summary belong to that package).\\n    print(\\\"placeholder\\\")\\nEOF\\necho \\\"---trying test2json approach instead---\\\"\",\n  \"description\": \"Draft verdict stream parser\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"---trying test2json approach instead---\\n\",\n  \"original_output_bytes\": 40,\n  \"original_output_tokens\": 10,\n  \"truncated\": false\n}","final_result":true}}}
