{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7db","stream":{"kind":"session","id":"01a0c8e2-bf86-7413-8196-b3968750220e"},"sequence":584,"recorded_at":1780531400001163,"record_type":"event","durability":"durable","causation_id":"b7feb475-a410-4d2f-87a4-514d078fdaaf","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"b7feb475-a410-4d2f-87a4-514d078fdaaf","run_stream":{"kind":"run","id":"b7feb475-a410-4d2f-87a4-514d078fdaaf"},"call_id":"call_01a0c8e496d572e4a3b4aef92227e83c","text":"Read text file `internal/termbind/attach.go`.\n(59 line(s) above)\n60|// the commit durable). A nil hook is a no-op; a hook error aborts the call\n61|// with that error.\n62|type AttachHooks struct {\n63|\tAfterStage   func(path string) error\n64|\tAfterInstall func(path string) error\n65|}\n66|\n67|// AttachStore is the durable attach-client receipt store rooted at one\n68|// data directory. Each (terminal_instance_id, client_id) pair keeps its\n69|// own receipt at\n70|// <root>/termbind/attach/<instance_id>/<client_id>.json, installed\n71|// no-replace: an identical retry replays, a conflicting retry refuses\n72|// idempotency_mismatch, and a second client records alongside, never over.\n73|type AttachStore struct {\n74|\troot  string\n75|\thooks *AttachHooks\n76|\tnow   func() time.Time\n77|}\n78|\n79|// OpenAttachStore creates the store, ensuring the root exists. It creates\n80|// no instance directories: those appear with the first Attach.\n81|func OpenAttachStore(root string) (*AttachStore, error) {\n82|\tif root == \"\" {\n83|\t\treturn nil, errors.New(\"termbind attach store root is empty\")\n84|\t}\n85|\tbase := filepath.Join(root, \"termbind\", \"attach\")\n86|\tif err := os.MkdirAll(base, 0o755); err != nil {\n87|\t\treturn nil, fmt.Errorf(\"create termbind attach root: %w\", err)\n88|\t}\n89|\treturn &AttachStore{root: root, now: time.Now}, nil\n90|}\n91|\n92|// WithHooks returns the store with crash hooks armed. It mutates the\n93|// receiver and returns it for call chaining.\n94|func (store *AttachStore) WithHooks(hooks *AttachHooks) *AttachStore {\n95|\tstore.hooks = hooks\n96|\treturn store\n97|}\n98|\n99|func (store *AttachStore) instanceDir(instanceID string) string {\n100|\treturn filepath.Join(store.root, \"termbind\", \"attach\", instanceID)\n101|}\n102|\n103|func (store *AttachStore) receiptPath(instanceID, clientID string) string {\n104|\treturn filepath.Join(store.instanceDir(instanceID), clientID+\".json\")\n105|}\n106|\n107|// Attach records one presentation client under its Section 4.C idempotency\n108|// key (terminal_instance_id + \"/\" + client_id) and returns the receipt. An\n109|// identical retry replays the recorded receipt with replayed true; a retry\n110|// that changes transport or input authorization refuses\n111|// idempotency_mismatch; a second client records its own receipt. Every\n112|// call, including a replay, requires a valid unexpired AttachAuthorization\n113|// equal to the request transport and input: timeout creates no authorized\n114|// input unless the durable receipt says so, and an expired policy never\n115|// replays.\n116|//\n117|// Attach takes no repository, lease, or fencing input and emits no event:\n118|// presentation-client activity cannot change Owner/Replica, lease, or\n119|// fencing state by construction. The zero-events property is proven by\n120|// snapshotting a real chain and lease store around the call.\n121|func (store *AttachStore) Attach(sessionID, instanceID, clientID, transport string, inputAuthorized bool, authRaw []byte, now time.Time) (AttachReceipt, bool, error) {\n122|\tempty := AttachReceipt{}\n123|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n124|\t\treturn empty, false, &terminalbackend.Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach session\"}\n125|\t}\n126|\tif err := CheckInstanceIdentity(instanceID); err != nil {\n127|\t\treturn empty, false, err\n128|\t}\n129|\tif err := CheckInstanceIdentity(clientID); err != nil {\n130|\t\treturn empty, false, err\n131|\t}\n132|\tif !isAttachTransport(transport) {\n133|\t\treturn empty, false, protocolRefusal(\"attach transport\")\n134|\t}\n135|\tauth, err := terminalbackend.ParseAttachAuthorization(authRaw)\n136|\tif err != nil {\n137|\t\treturn empty, false, err\n138|\t}\n139|\tif err := terminalbackend.CheckAttachRequest(auth, transport, inputAuthorized, now); err != nil {\n140|\t\treturn empty, false, err\n141|\t}\n142|\tstored, found, err := store.Lookup(sessionID, instanceID, clientID)\n143|\tif err != nil {\n144|\t\treturn empty, false, err\n145|\t}\n146|\tif found {\n147|\t\tif stored.Transport != transport || stored.InputAuthorized != inputAuthorized {\n148|\t\t\treturn empty, false, &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \"attach client\"}\n149|\t\t}\n150|\t\treturn stored, true, nil\n151|\t}\n152|\treceipt, err := encodeAttachReceipt(AttachReceipt{\n153|\t\tSessionID:          sessionID,\n154|\t\tTerminalInstanceID: instanceID,\n155|\t\tClientID:           clientID,\n156|\t\tTransport:          transport,\n157|\t\tInputAuthorized:    inputAuthorized,\n158|\t}, store.timestamp())\n159|\tif err != nil {\n160|\t\treturn empty, false, err\n161|\t}\n162|\treturn store.install(sessionID, instanceID, clientID, transport, inputAuthorized, receipt)\n163|}\n164|\n165|// Lookup replays the recorded receipt for a (terminal_instance_id,\n166|// client_id) pair, or reports absence when the pair is unrecorded. A read\n167|// or validation failure is an error, never absence: unknown is not absent.\n168|func (store *AttachStore) Lookup(sessionID, instanceID, clientID string) (AttachReceipt, bool, error) {\n169|\tempty := AttachReceipt{}\n170|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n171|\t\treturn empty, false, fmt.Errorf(\"attach lookup session %q is not a UUIDv7: %w\", sessionID, err)\n172|\t}\n173|\tif err := CheckInstanceIdentity(instanceID); err != nil {\n174|\t\treturn empty, false, err\n175|\t}\n176|\tif err := CheckInstanceIdentity(clientID); err != nil {\n177|\t\treturn empty, false, err\n178|\t}\n179|\traw, err := os.ReadFile(store.receiptPath(instanceID, clientID))\n180|\tif err != nil {\n181|\t\tif errors.Is(err, os.ErrNotExist) {\n182|\t\t\treturn empty, false, nil\n183|\t\t}\n184|\t\treturn empty, false, fmt.Errorf(\"read attach receipt: %w\", err)\n185|\t}\n186|\treceipt, err := decodeAttachReceipt(raw)\n187|\tif err != nil {\n188|\t\treturn empty, false, err\n189|\t}\n190|\tif receipt.SessionID != sessionID {\n191|\t\treturn empty, false, errors.New(\"attach receipt names another session\")\n192|\t}\n193|\tif receipt.TerminalInstanceID != instanceID || receipt.ClientID != clientID {\n194|\t\treturn empty, false, errors.New(\"attach receipt names another client pair\")\n195|\t}\n196|\treturn receipt, true, nil\n197|}\n198|\n199|// install stages the receipt to a same-directory temporary file, fsyncs\n200|// it, atomically links it to the receipt path (which must not exist: the\n201|// link is the no-replace commit), removes the staging name, and fsyncs the\n202|// directory. A concurrent same-pair commit wins and the loser converges to\n203|// the winner: an identical retry replays it, a conflicting retry refuses\n204|// idempotency_mismatch. Stale staging files from a pre-commit crash are\n205|// swept before the install.\n206|func (store *AttachStore) install(sessionID, instanceID, clientID, transport string, inputAuthorized bool, receipt []byte) (AttachReceipt, bool, error) {\n207|\tempty := AttachReceipt{}\n208|\tdir := store.instanceDir(instanceID)\n209|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
