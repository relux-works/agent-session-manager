{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c605","stream":{"kind":"session","id":"01a0c8e2-bf86-7413-8196-b3968750220e"},"sequence":349,"recorded_at":1780531400000693,"record_type":"event","durability":"durable","causation_id":"b7feb475-a410-4d2f-87a4-514d078fdaaf","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b7feb475-a410-4d2f-87a4-514d078fdaaf","run_stream":{"kind":"run","id":"b7feb475-a410-4d2f-87a4-514d078fdaaf"},"task_stream":{"kind":"task","id":"01a0c8e3-82fb-7da0-9f79-a3f467f4e76a"},"task_id":"01a0c8e3-82fb-7da0-9f79-a3f467f4e76a","event":{"kind":"output","task_id":"01a0c8e3-82fb-7da0-9f79-a3f467f4e76a","chunk":"Read text file `internal/tmuxserver/ops.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"sort\"\n8|\t\"strconv\"\n9|\t\"time\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n17|)\n18|\n19|// This file executes the three lifecycle operations the landed engine\n20|// scope refuses — attach, terminate-stale, and restore — over the same\n21|// landed gates the engine uses (transition matrix, idempotency shapes,\n22|// authorization, capability conferral, receipt and binding stores)\n23|// plus the tmux backend. The recheck loop, receipt discipline, and\n24|// error-to-observation mapping mirror the engine's second side of each\n25|// rule; the census symmetry lines name both sides.\n26|\n27|// sortedEffects copies effects into bytewise order for the wire.\n28|func sortedEffects(effects []terminalbackend.SideEffect) []terminalbackend.SideEffect {\n29|\tordered := append([]terminalbackend.SideEffect(nil), effects...)\n30|\tsort.Slice(ordered, func(i, j int) bool { return ordered[i] < ordered[j] })\n31|\treturn ordered\n32|}\n33|\n34|// sortedEvidence copies evidence IDs into bytewise order for the wire.\n35|func sortedEvidence(evidence []string) []string {\n36|\tordered := append([]string(nil), evidence...)\n37|\tsort.Strings(ordered)\n38|\treturn ordered\n39|}\n40|\n41|// attachDescriptor derives the bound attach descriptor: socket,\n42|// instance, and client joined by newlines. It is host-local (the\n43|// socket path is usable only on the responding host), deterministic,\n44|// and never persisted: the attach handler returns it without writing\n45|// it anywhere, and a dedicated test scans the stores for its bytes.\n46|// Length is bounded by construction — sun_path socket plus two UUIDs\n47|// stay two orders of magnitude below the 4096 cap — so no length arm\n48|// exists to measure; a test pins the maximum instead.\n49|func attachDescriptor(socket, instance, client string) string {\n50|\treturn socket + \"\\n\" + instance + \"\\n\" + client\n51|}\n52|\n53|// createDescriptor derives the unbound create-interactive descriptor:\n54|// socket and instance only, because create carries no client. Same\n55|// non-persistence and length properties as the bound shape.\n56|func createDescriptor(socket, instance string) string {\n57|\treturn socket + \"\\n\" + instance\n58|}\n59|\n60|// executeAttach runs one attach: closed-shape admission, deadline,\n61|// transition, landed attach authorization, capability conferral plus\n62|// the matching-transport arm, the fast-path quiesce barrier check,\n63|// live server attestation (the P3-A wiring: a fresh decoy admission\n64|// refuses), the authoritative barrier recheck under the ordering\n65|// lock, the durable client receipt, and the caller-executed attach\n66|// vector with its descriptor. The entry returns the vector; it never\n67|// execs an interactive attach.\n68|func (lc *Lifecycle) executeAttach(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n69|\tempty := OpOutcome{Operation: terminalbackend.OperationAttach}\n70|\tbody, err := parseAttachBody(req.Body)\n71|\tif err != nil {\n72|\t\treturn empty, err\n73|\t}\n74|\tif err := checkLifecycleBackend(body.TerminalBackendID); err != nil {\n75|\t\treturn empty, err\n76|\t}\n77|\tdeadline, err := body.Deadline.Time()\n78|\tif err != nil {\n79|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body deadline\"}\n80|\t}\n81|\tif !lc.Now().Before(deadline) {\n82|\t\treturn empty, &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n83|\t}\n84|\tif _, _, err := terminalbackend.CheckTransition(string(terminalbackend.OperationAttach), req.Source, false); err != nil {\n85|\t\treturn empty, err\n86|\t}\n87|\tif err := terminalbackend.CheckAttachRequest(body.Authorization, body.Transport, body.InputAuthorized, lc.Now()); err != nil {\n88|\t\treturn empty, err\n89|\t}\n90|\tif err := terminalbackend.CheckOperation(string(terminalbackend.OperationAttach), req.Admitted); err != nil {\n91|\t\treturn empty, err\n92|\t}\n93|\tif err := checkAttachTransportCapability(body.Transport, req.Admitted); err != nil {\n94|\t\treturn empty, err\n95|\t}\n96|\tif err := lc.checkAttachQuiesced(body.TerminalInstanceID, body.InputAuthorized); err != nil {\n97|\t\treturn empty, err\n98|\t}\n99|\tif lc.ServerAdmission == nil {\n100|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle dependencies\"}\n101|\t}\n102|\tadmission, err := lc.ServerAdmission()\n103|\tif err != nil {\n104|\t\treturn empty, rowError(terminalbackend.OperationAttach, err)\n105|\t}\n106|\tif err := CheckServerAttested(admission, body.BackendGeneration); err != nil {\n107|\t\treturn empty, &Error{Code: terminalbackend.CodeUnauthorized, Detail: \"attach server attestation\"}\n108|\t}\n109|\t// Ordering contract, attach side: the fast-path barrier check\n110|\t// above ran before the (possibly blocking) server admission,\n111|\t// so quiescence may have committed since. Revalidate the\n112|\t// barrier under the lock immediately before the receipt\n113|\t// commit, and hold the lock through the receipt, the returned\n114|\t// vector, and the advisory memory record, so no writable\n115|\t// receipt commits after a durable closure report.\n116|\tlc.barrierMu.Lock()\n117|\tdefer lc.barrierMu.Unlock()\n118|\tif err := lc.checkAttachQuiesced(body.TerminalInstanceID, body.InputAuthorized); err != nil {\n119|\t\treturn empty, err\n120|\t}\n121|\treqBackend := lc.requestBackend(req, socket, body.SessionID, body.TerminalInstanceID)\n122|\treqBackend.operation = terminalbackend.OperationAttach\n123|\treqBackend.clientID = body.ClientID\n124|\treqBackend.transport = body.Transport\n125|\treqBackend.input = body.InputAuthorized\n126|\treqBackend.authRaw = body.AuthRaw\n127|\tevidenceID, err := reqBackend.PerformEffect(ctx, terminalbackend.EffectAttachClientCreated)\n128|\tif err != nil {\n129|\t\treturn empty, rowError(terminalbackend.OperationAttach, err)\n130|\t}\n131|\targv, err := BuildCommand(DirectiveAttachSession, CommandArgs{\n132|\t\tRuntimeDir:     lc.RuntimeDir,\n133|\t\tSocket:         socket,\n134|\t\tInstanceID:     body.TerminalInstanceID,\n135|\t\tAttachInput:    body.InputAuthorized,\n136|\t\tHasAttachInput: true,\n137|\t})\n138|\tif err != nil {\n139|\t\treturn empty, err\n140|\t}\n141|\tif err := terminalbackend.CheckAttachResult(body.InputAuthorized, body.InputAuthorized, body.Authorization); err != nil {\n142|\t\treturn empty, err\n143|\t}\n144|\t// Only an input-authorized attach adopts the active state: a\n145|\t// read-only attach is observation, and recording active for it\n146|\t// would reopen quiesced input (the quiesce barrier reads this\n147|\t// same memory, so observation must leave it untouched).\n148|\tif body.InputAuthorized {\n149|\t\t_ = lc.recordAfter(body.TerminalInstanceID, terminalbackend.StateActive)\n150|\t}\n151|\treturn OpOutcome{\n152|\t\tOperation: terminalbackend.OperationAttach,\n153|\t\tAttach: &AttachOutcome{\n154|\t\t\tClientMirrorID:  body.ClientID,\n155|\t\t\tDescriptor:      attachDescriptor(socket, body.TerminalInstanceID, body.ClientID),\n156|\t\t\tInputAuthorized: body.InputAuthorized,\n157|\t\t\tEvidenceIDs:     []string{evidenceID},\n158|\t\t},\n159|\t\tArgv: argv,\n160|\t}, nil\n161|}\n162|\n163|// checkAttachQuiesced enforces the quiesce input barrier at the\n164|// attach entry: tmux offers no session freeze (a locked session does\n165|// not lock subsequently attaching clients), so once a closure\n166|// report proves the input closed in the current incarnation, new\n167|// input-authorized attaches refuse the failed local precondition.\n168|// Read-only attaches stay admitted: quiesce stops input while\n169|// retaining observation. The incarnation-scoped closure proof is the\n170|// sole admission verdict: advisory memory, caller-carried source\n171|// state, and failure reporting are never consulted for their value\n172|// here, so none of them can reopen a closed barrier — a stale\n173|// active record, a failure result echoing its source, and a lost\n174|// state write all refuse exactly like the proof itself. Only a\n175|// fresh create or restore success reopens the input, by rotating\n176|// the incarnation the proof is scoped to. Store health still fails\n177|// closed: an unreadable state record is unknown, never admission,\n178|// so the memory read error propagates even though its value is\n179|// ignored. A proof read failure is likewise an error, never\n180|// admission: unknown is not a verdict.\n181|func (lc *Lifecycle) checkAttachQuiesced(instanceID string, inputAuthorized bool) error {\n182|\tif !inputAuthorized {\n183|\t\treturn nil\n184|\t}\n185|\tif _, _, err := lc.States.Lookup(instanceID); err != nil {\n186|\t\treturn err\n187|\t}\n188|\tproven, err := lc.States.QuiesceBarrierProven(instanceID)\n189|\tif err != nil {\n190|\t\treturn err\n191|\t}\n192|\tif proven {\n193|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"attach quiesced input\"}\n194|\t}\n195|\treturn nil\n196|}\n197|\n198|// checkAttachTransportCapability enforces the matching-transport arm:\n199|// local presentation needs local_attach, mesh presentation needs\n200|// remote_attach. The relay member never reaches here — the landed\n201|// attach authorization refuses it first — so no third arm exists.\n202|func checkAttachTransportCapability(transport string, admitted terminalbackend.Admitted) error {\n203|\tswitch transport {\n204|\tcase string(terminalbackend.TransportLocalOnly):\n205|\t\tif !admitted.Has(\"local_attach\") {\n206|\t\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n207|\t\t}\n208|\tcase string(terminalbackend.TransportTrustedPrivateMesh):\n209|\t\tif !admitted.Has(\"remote_attach\") {\n210|\t\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n211|\t\t}\n212|\tdefault:\n213|\t\treturn &Error{Code: terminalbackend.CodeProtocolError, Detail: \"presentation transport vocabulary\"}\n214|\t}\n215|\treturn nil\n216|}\n217|\n218|// executeTerminate runs one terminate-stale: closed-shape admission,\n219|// idempotency material, capability conferral plus the dual conditional,\n220|// transition, force_stale authorization, generation recheck, landed\n221|// fencing authorization, deadline, receipt discipline with\n222|// status-reconciled resume, and the kill plus close-confirm effects.\n223|func (lc *Lifecycle) executeTerminate(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n224|\tempty := OpOutcome{Operation: terminalbackend.OperationTerminateStale}\n225|\tbody, err := parseTerminateBody(req.Body)\n226|\tif err != nil {\n227|\t\treturn empty, err\n228|\t}\n229|\toperation := terminalbackend.OperationTerminateStale\n230|\tmctx := body.Context\n231|\tsource := terminalbackend.InstanceState(req.Source)\n232|\tif err := checkLifecycleBackend(mctx.TerminalBackendID); err != nil {\n233|\t\treturn empty, err\n234|\t}\n235|\tderived, err := terminalbackend.IdempotencyKey(string(operation), mctx.TerminalInstanceID, \"terminate\", body.StaleLeaseID, strconv.FormatUint(body.StaleEpoch, 10))\n236|\tif err != nil {\n237|\t\treturn empty, err\n238|\t}\n239|\tif mctx.IdempotencyKey != derived {\n240|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"idempotency key material\"}\n241|\t}\n242|\tif err := terminalbackend.CheckOperation(string(operation), req.Admitted); err != nil {\n243|\t\tfailure := rowError(operation, err)\n244|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n245|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n246|\t}\n247|\tif err := checkTerminateCapability(req.Admitted); err != nil {\n248|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n249|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n250|\t}\n251|\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), false)\n252|\tif err != nil {\n253|\t\tfailure := rowError(operation, err)\n254|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n255|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n256|\t}\n257|\tif err := terminstance.CheckAuthorization(mctx.Authorization, terminstance.AuthorizationForceStale, lc.CurrentLease(), lc.Now()); err != nil {\n258|\t\tfailure := rowError(operation, err)\n259|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n260|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n261|\t}\n262|\tif lc.CurrentGeneration() != mctx.BackendGeneration {\n263|\t\tfailure := &Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation stale\"}\n264|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n265|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n266|\t}\n267|\tif err := mapFencingError(fencing.AuthorizeTerminateStale(req.Presented, req.Winner, req.HasWinner, req.ForceRecovery, req.DiagnosticsPreserved)); err != nil {\n268|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n269|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n270|\t}\n271|\tif err := checkTerminateTarget(mctx, body, req.Presented); err != nil {\n272|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n273|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n274|\t}\n275|\tif err := checkTerminateWinner(mctx, req.Winner, lc.CurrentLease()); err != nil {\n276|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n277|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n278|\t}\n279|\tdeadline, err := mctx.Deadline.Time()\n280|\tif err != nil {\n281|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"mutation context deadline\"}\n282|\t}\n283|\tif !lc.Now().Before(deadline) {\n284|\t\tfailure := &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n285|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionReplaySame)\n286|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n287|\t}\n288|\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n289|\treqBackend.operation = operation\n290|\treqBackend.deadline = deadline\n291|\treturn lc.executeWithReceipt(ctx, req, socket, operation, mctx, source, target, effects, deadline, terminstance.AuthorizationForceStale, reqBackend, func(result terminstance.Result) OpOutcome {\n292|\t\treturn OpOutcome{Operation: operation, Mutation: &result, TargetClosed: true}\n293|\t})\n294|}\n295|\n296|// checkTerminateCapability enforces the dual conditional: stale\n297|// termination needs stale_process_termination AND\n298|// provider_process_observation. Each arm refuses alone.\n299|func checkTerminateCapability(admitted terminalbackend.Admitted) error {\n300|\tif !admitted.Has(\"stale_process_termination\") {\n301|\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n302|\t}\n303|\tif !admitted.Has(\"provider_process_observation\") {\n304|\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n305|\t}\n306|\treturn nil\n307|}\n308|\n309|// mapFencingError maps the landed terminate-stale authorization onto\n310|// the row's allowed set: malformed fencing material is the protocol\n311|// error, every other fencing refusal — no winner, no force, no\n312|// diagnostics, target mismatch, live owner — is the failed local\n313|// precondition. lease_conflict maps to the precondition too: the row\n314|// has no lease_conflict member, and a target fenced by another\n315|// session's winner fails the fenced-target precondition.\n316|func mapFencingError(err error) error {\n317|\tif err == nil {\n318|\t\treturn nil\n319|\t}\n320|\tif errors.Is(err, fencing.ErrInvalidArguments) {\n321|\t\treturn &Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminate fencing material\"}\n322|\t}\n323|\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate fencing authorization\"}\n324|}\n325|\n326|// checkTerminateTarget binds the presented fencing token to the\n327|// request: session, stale lease, and stale epoch must all agree with\n328|// the context and body. Any disagreement refuses the failed local\n329|// precondition: the retry would authorize a different target than the\n330|// key names.\n331|func checkTerminateTarget(mctx terminstance.MutationContext, body TerminateBody, presented fencing.PresentedToken) error {\n332|\tif presented.SessionID != mctx.SessionID ||\n333|\t\tpresented.LeaseID != body.StaleLeaseID ||\n334|\t\tpresented.Epoch != body.StaleEpoch {\n335|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate target binding\"}\n336|\t}\n337|\treturn nil\n338|}\n339|\n340|// checkTerminateWinner binds the caller-observed winner to the\n341|// re-read current lease: the fencing authorization decides over the\n342|// caller's winner, and only a winner that still wins authorizes. A\n343|// rotated or misobserved winner refuses the failed local\n344|// precondition; the caller re-observes and retries. Absence of a\n345|// winner never reaches here — the fencing gate refuses it first.\n346|func checkTerminateWinner(mctx terminstance.MutationContext, winner sessrepo.LeaseSummary, lease terminstance.LeaseView) error {\n347|\tif winner.SessionID != mctx.SessionID ||\n348|\t\twinner.LeaseID != lease.LeaseID ||\n349|\t\twinner.Epoch != lease.Epoch {\n350|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate winner binding\"}\n351|\t}\n352|\treturn nil\n353|}\n354|\n355|// executeRestore runs one restore: closed-shape admission, idempotency\n356|// material, capability conferral plus the reboot conditional,\n357|// transition, restore authorization, generation recheck, prior-binding\n358|// mismatch, deadline, receipt discipline with status-reconciled\n359|// resume, the persist plus wrapper-restored effects, and the required\n360|// result binding. The wire result is always parked. The backend\n361|// launches no provider: the wrapper owns launch gating through the\n362|// after-restore composition (ExecuteWrapperRestore), and this entry\n363|// only recreates the wrapper process.\n364|//\n365|// The result binding is the create-time document kept alongside the\n366|// bootstrap receipt, re-admitted by termbind on the read — within one\n367|// generation — or its minted successor across a reboot: the termbind\n368|// owner succeeds the prior (the JCS identity rule stays\n369|// termbind-private) and the successor persists under the same pair\n370|// key. The prior-binding mismatch arm proves the carried prior equals\n371|// the recorded digest; the document read proves a valid binding for\n372|// this session, instance, and backend.\n373|func (lc *Lifecycle) executeRestore(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n374|\tempty := OpOutcome{Operation: terminalbackend.OperationRestore}\n375|\tbody, err := parseRestoreBody(req.Body)\n376|\tif err != nil {\n377|\t\treturn empty, err\n378|\t}\n379|\toperation := terminalbackend.OperationRestore\n380|\tmctx := body.Context\n381|\tsource := terminalbackend.InstanceState(req.Source)\n382|\tif err := checkLifecycleBackend(mctx.TerminalBackendID); err != nil {\n383|\t\treturn empty, err\n384|\t}\n385|\tderived, err := terminalbackend.IdempotencyKey(string(operation), mctx.SessionID, body.BootstrapOperationID)\n386|\tif err != nil {\n387|\t\treturn empty, err\n388|\t}\n389|\tif mctx.IdempotencyKey != derived {\n390|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"idempotency key material\"}\n391|\t}\n392|\tif err := terminalbackend.CheckOperation(string(operation), req.Admitted); err != nil {\n393|\t\tfailure := rowError(operation, err)\n394|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n395|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n396|\t}\n397|\tif !req.Admitted.Has(\"reboot_restoration\") {\n398|\t\tfailure := &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n399|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n400|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n401|\t}\n402|\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), false)\n403|\tif err != nil {\n404|\t\tfailure := rowError(operation, err)\n405|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n406|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n407|\t}\n408|\tif err := terminstance.CheckAuthorization(mctx.Authorization, terminstance.AuthorizationRestore, lc.CurrentLease(), lc.Now()); err != nil {\n409|\t\tfailure := rowError(operation, err)\n410|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n411|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n412|\t}\n413|\tif lc.CurrentGeneration() != mctx.BackendGeneration {\n414|\t\tfailure := &Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation stale\"}\n415|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n416|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n417|\t}\n418|\tif err := lc.checkPriorBinding(body); err != nil {\n419|\t\tvar local *Error\n420|\t\tif errors.As(err, &local) && local.Code == terminalbackend.CodeRestoreMismatch {\n421|\t\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n422|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n423|\t\t}\n424|\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n425|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n426|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n427|\t}\n428|\tdeadline, err := mctx.Deadline.Time()\n429|\tif err != nil {\n430|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"mutation context deadline\"}\n431|\t}\n432|\tif !lc.Now().Before(deadline) {\n433|\t\tfailure := &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n434|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionReplaySame)\n435|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n436|\t}\n437|\t// The prior binding validates before the receipt binds and the\n438|\t// wrapper recreates: a missing, corrupt, or disagreeing prior\n439|\t// refuses here, never after the irreversible effects.\n440|\tif _, err := lc.readRestorePrior(mctx, body); err != nil {\n441|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n442|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n443|\t}\n444|\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n445|\treqBackend.operation = operation\n446|\treqBackend.bootstrapID = body.BootstrapOperationID\n447|\t// The persist effect replays the recorded pair receipt (verified\n448|\t// by the mismatch arm above); the candidate carries the matched\n449|\t// prior digest so the store admits its shape on the replay path.\n450|\treqBackend.bindingID = body.PriorBindingID\n451|\toutcome, err := lc.executeWithReceipt(ctx, req, socket, operation, mctx, source, target, effects, deadline, terminstance.AuthorizationRestore, reqBackend, func(result terminstance.Result) OpOutcome {\n452|\t\treturn OpOutcome{Operation: operation, Mutation: &result, PriorBindingID: body.PriorBindingID, RestoredParked: true}\n453|\t})\n454|\tif err != nil {\n455|\t\treturn outcome, err\n456|\t}\n457|\tbinding, err := lc.restoreBinding(mctx, body)\n458|\tif err != nil {\n459|\t\treturn outcome, err\n460|\t}\n461|\toutcome.Binding = binding\n462|\treturn outcome, nil\n463|}\n464|\n465|// readRestorePrior reads the create-time binding document kept under\n466|// the (session, bootstrap) pair, re-admitted by the termbind owner,\n467|// and proves it names this restore's session, instance, and backend.\n468|// Generation is not compared here: after a reboot the restore carries\n469|// the new server generation while the prior still names the old one,\n470|// and succession (not agreement) resolves that drift. A missing\n471|// document is the backend store failure — the receipt proved the\n472|// prior, but the payload is gone, so the required result cannot be\n473|// built. A document that fails termbind admission, or that names\n474|// another session, instance, or backend than the mutation context, is\n475|// the integrity failure: the store disagrees with the receipt it\n476|// stands beside.\n477|func (lc *Lifecycle) readRestorePrior(mctx terminstance.MutationContext, body RestoreBody) (termbind.Binding, error) {\n478|\tempty := termbind.Binding{}\n479|\tdoc, found, err := lc.States.LookupBindingDoc(mctx.SessionID, body.BootstrapOperationID)\n480|\tif err != nil {\n481|\t\treturn empty, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n482|\t}\n483|\tif !found {\n484|\t\treturn empty, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n485|\t}\n486|\tbinding, err := termbind.ParseTerminalBinding(doc)\n487|\tif err != nil {\n488|\t\treturn empty, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n489|\t}\n490|\tif binding.SessionID != mctx.SessionID ||\n491|\t\tbinding.TerminalInstanceID != mctx.TerminalInstanceID ||\n492|\t\tbinding.TerminalBackendID != mctx.TerminalBackendID {\n493|\t\treturn empty, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n494|\t}\n495|\treturn binding, nil\n496|}\n497|\n498|// restoreBinding builds the required restore result binding after the\n499|// effects commit. Within one generation the prior is the result: the\n500|// re-admitted create-time document the pre-effects validation already\n(more lines below)","final_result":true}}}
