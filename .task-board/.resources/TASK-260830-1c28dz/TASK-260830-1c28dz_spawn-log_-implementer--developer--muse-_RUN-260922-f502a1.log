n',\n+        count=1,\n+        run=\"TestAttachRefusesGenerationRotatedDuringLockWait\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly generation-two past the attach post-lock generation recheck (a rotated attach commits its receipt); every other stale generation still refuses. Kill path: the rotation-during-lock-wait attach succeeds with a writable receipt instead of refusing.\",\n+    ),\n+    Mutant(\n+        name=\"N-attach-postlock-deadline\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\\tif !lc.Now().Before(deadline) {\\n\\t\\treturn empty, &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\\n\\t}\\n\\tif lc.CurrentGeneration() != body.BackendGeneration {\\n',\n+        replace='\\tif lc.Now().After(deadline) {\\n\\t\\treturn empty, &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\\n\\t}\\n\\tif lc.CurrentGeneration() != body.BackendGeneration {\\n',\n+        count=1,\n+        run=\"TestAttachRefusesDeadlineOnTheInstantDuringAdmission\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the on-deadline instant past the attach post-lock deadline (the generation context pins the post-lock site; the entry arm keeps its own row); every late instant still refuses. Kill path: the on-the-instant attach commits its receipt instead of refusing the timeout.\",\n+    ),\n+    Mutant(\n+        name=\"N-attach-input-escalation\",\n+        path=\"internal/terminalbackend/conformance.go\",\n+        find='\\tif requested != auth.Transport || inputAuthorized != auth.InputAuthorized {\\n',\n+        replace='\\tif requested != auth.Transport || (inputAuthorized != auth.InputAuthorized && !inputAuthorized) {\\n',\n+        count=1,\n+        run=\"TestAttachAuthorizationMembersRefuseWithoutReceipt/input\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly true-request/false-authorization input past the shared attach input-binding arm (reviewer A3 shape: false-against-true still refuses); the durable receipt commits before the result binding refuses, so the killer's receipt-absence assertion reddens. The gate stays landed — this row measures the composed entry, no fork.\",\n+    ),\n","edit_facts":{"tool_name":"edit_file","path":"internal/tmuxserver/mutant_harness.py","added":34,"removed":4},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
