ind='\\tcase string(terminalbackend.TransportTrustedPrivateMesh):\\n\\t\\tif !admitted.Has(\"remote_attach\") {\\n\\t\\t\\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\\n\\t\\t}\\n',\n1567|        replace='\\tcase string(terminalbackend.TransportTrustedPrivateMesh):\\n',\n1568|        count=1,\n1569|        run=\"TestExecuteAttachRefusesMeshWithoutCapability\",\n1570|        expect=\"KILLED\",\n1571|        note=\"Admits exactly capability-less mesh presentation past the matching-transport gate (the local arm stays); local without local_attach still refuses. Kill path: the unevidenced attach succeeds instead of refusing.\",\n1572|    ),\n1573|    Mutant(\n1574|        name=\"N-attach-deadline-boundary\",\n1575|        path=f\"{PACKAGE}/ops.go\",\n1576|        find='\\tif !lc.Now().Before(deadline) {\\n\\t\\treturn empty, &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\\n\\t}\\n',\n1577|        replace='\\tif lc.Now().After(deadline) {\\n\\t\\treturn empty, &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\\n\\t}\\n',\n1578|        count=1,\n1579|        run=\"TestExecuteAttachRefusesDeadline/boundary\",\n1580|        expect=\"KILLED\",\n1581|        note=\"Admits exactly the on-deadline instant past the attach entry deadline; every late instant still refuses. Kill path: the expired attach succeeds instead of refusing.\",\n1582|    ),\n1583|    Mutant(\n1584|        name=\"N-attach-attestation-decoy\",\n1585|        path=f\"{PACKAGE}/ops.go\",\n1586|        find='\\tif err := CheckServerAttested(admission, body.BackendGeneration); err != nil {\\n',\n1587|        replace='\\tif err := CheckServerAttested(admission, body.BackendGeneration); err != nil && err.Error() != \"tmux server refused: tmux_readiness_not_authorizing at server attestation\" {\\n',\n1588|        count=1,\n1589|        run=\"TestExecuteAttachRefusals/fresh-decoy\",\n1590|        expect=\"KILLED\",\n1591|        note=\"Admits exactly the decoy-membered admission past the attach attestation wiring; the stale-generation member still refuses. Kill path: the unattested server presents instead of refusing.\",\n1592|    ),\n1593|    Mutant(\n1594|        name=\"N-attach-record\",\n1595|        path=f\"{PACKAGE}/ops.go\",\n1596|        find='\\t\\t_ = lc.recordAfter(body.TerminalInstanceID, terminalbackend.StateActive)\\n',\n1597|        replace='\\t\\t_ = lc.recordAfter(body.TerminalInstanceID, terminalbackend.StateParked)\\n',\n1598|        count=1,\n1599|        run=\"TestExecuteAttach\",\n1600|        expect=\"KILLED\",\n1601|        note=\"Records exactly the parked state on the attach success path instead of the adopted active; the receipt paths keep their own rows. Kill path: the state memory disagrees with the presented attach.\",\n1602|    ),\n1603|    Mutant(\n1604|        name=\"N-attach-descriptor-order\",\n1605|        path=f\"{PACKAGE}/ops.go\",\n1606|        find='\\treturn socket + \"\\\\n\" + instance + \"\\\\n\" + client\\n',\n1607|        replace='\\treturn instance + \"\\\\n\" + socket + \"\\\\n\" + client\\n',\n1608|        count=1,\n1609|        run=\"TestExecuteAttach\",\n1610|        expect=\"KILLED\",\n1611|        note=\"Admits exactly the instance-first descriptor past the fixed attach shape; the field set stays exact. Kill path: the exact-descriptor assertion fails.\",\n1612|    ),\n1613|    Mutant(\n1614|        name=\"N-create-descriptor-order\",\n(more lines below)","final_result":true}}}
