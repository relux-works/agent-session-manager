{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c965","stream":{"kind":"session","id":"01a0c8e2-bf86-7413-8196-b3968750220e"},"sequence":781,"recorded_at":1780531400001557,"record_type":"event","durability":"durable","causation_id":"b7feb475-a410-4d2f-87a4-514d078fdaaf","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b7feb475-a410-4d2f-87a4-514d078fdaaf","run_stream":{"kind":"run","id":"b7feb475-a410-4d2f-87a4-514d078fdaaf"},"task_stream":{"kind":"task","id":"01a0c8e6-8014-7cc2-9573-3790524f8ffc"},"task_id":"01a0c8e6-8014-7cc2-9573-3790524f8ffc","event":{"kind":"output","task_id":"01a0c8e6-8014-7cc2-9573-3790524f8ffc","chunk":"Read text file `internal/tmuxserver/mutant_harness.py`.\n(789 line(s) above)\n790|        expect=\"KILLED\",\n791|        note=\"Admits exactly background callers to the foreground path (the capitalized twin still dispatches background); foreground callers are unaffected. Kill path: the background miss table spawns into the dedicated server instead of refusing the typed unavailable.\",\n792|    ),\n793|    Mutant(\n794|        name=\"D-background-fallback\",\n795|        path=f\"{PACKAGE}/acquire.go\",\n796|        find=\"\\t\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\n\\t\\t\\treturn Outcome{}, backgroundUnavailable(req, err)\\n\\t\\t}\\n\",\n797|        replace=\"\\t\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\n\\t\\t\\tif req.Deps.Spawn != nil {\\n\\t\\t\\t\\t_ = req.Deps.Spawn(socket, nil)\\n\\t\\t\\t}\\n\\t\\t\\treturn Outcome{}, backgroundUnavailable(req, err)\\n\\t\\t}\\n\",\n798|        count=1,\n799|        run=BG_MISS_LINUX,\n800|        expect=\"KILLED\",\n801|        note=\"SUPPLEMENTARY ADDITIVE, not a narrowing: plants the reviewer-shaped direct-creation call on the background miss path. Kill path: every background-miss spy asserts zero spawn calls.\",\n802|    ),\n803|    Mutant(\n804|        name=\"D-background-fallback-foreground\",\n805|        path=f\"{PACKAGE}/acquire.go\",\n806|        find=\"\\t\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\n\\t\\t\\treturn Outcome{}, backgroundUnavailable(req, err)\\n\\t\\t}\\n\",\n807|        replace=\"\\t\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\n\\t\\t\\tif req.Deps.ProbeServer != nil && req.Deps.Spawn != nil {\\n\\t\\t\\t\\treturn acquireForeground(req, socket)\\n\\t\\t\\t}\\n\\t\\t\\treturn Outcome{}, backgroundUnavailable(req, err)\\n\\t\\t}\\n\",\n808|        count=1,\n809|        run=BG_MISS_LINUX,\n810|        expect=\"KILLED\",\n811|        note=\"SUPPLEMENTARY ADDITIVE, not a narrowing: a fallback into acquireForeground on the background miss path, guarded on the foreground probe dependency — the shared-Dependencies shape, where the lifecycle adapter passes one Dependencies value to every caller. Kill path: every background-miss test arms both a spy spawner and a spy server probe and asserts the typed unavailable, so re-entering the foreground path trips the census before it spawns.\",\n812|    ),\n813|    Mutant(\n814|        name=\"N-lifecycle-evidence-digest\",\n815|        path=f\"{PACKAGE}/ops.go\",\n816|        find='\\t\\tif _, err := scalar.ParseDigest(evidenceID); err != nil {\\n',\n817|        replace='\\t\\tif _, err := scalar.ParseDigest(evidenceID); err != nil && evidenceID != \"not-a-digest\" {\\n',\n818|        count=1,\n819|        run=\"TestRunLifecycleEffectsRefusesForgedEvidence\",\n820|        expect=\"KILLED\",\n821|        note=\"Admits exactly the forged non-digest evidence past the receipt-loop digest arm; every other malformed evidence ID still fails the run. Kill path: the forged effect commits and the completion callback fires.\",\n822|    ),\n823|    Mutant(\n824|        name=\"N-lifecycle-winner-lease\",\n825|        path=f\"{PACKAGE}/ops.go\",\n826|        find='\\tif winner.SessionID != mctx.SessionID ||\\n\\t\\twinner.LeaseID != lease.LeaseID ||\\n\\t\\twinner.Epoch != lease.Epoch {\\n',\n827|        replace='\\tif winner.SessionID != mctx.SessionID ||\\n\\t\\twinner.Epoch != lease.Epoch {\\n',\n828|        count=1,\n829|        run=\"TestExecuteTerminateWinnerTracksCurrentLease/winner-lease-identity\",\n830|        expect=\"KILLED\",\n831|        note=\"Admits exactly lease-mismatched winners past the winner binding; epoch- and session-mismatched winners still refuse. Kill path: the admitted terminate execs the kill instead of refusing.\",\n832|    ),\n833|    Mutant(\n834|        name=\"N-lifecycle-winner-epoch\",\n835|        path=f\"{PACKAGE}/ops.go\",\n836|        find='\\tif winner.SessionID != mctx.SessionID ||\\n\\t\\twinner.LeaseID != lease.LeaseID ||\\n\\t\\twinner.Epoch != lease.Epoch {\\n',\n837|        replace='\\tif winner.SessionID != mctx.SessionID ||\\n\\t\\twinner.LeaseID != lease.LeaseID {\\n',\n838|        count=1,\n839|        run=\"TestExecuteTerminateRefusals/winner-rotated\",\n840|        expect=\"KILLED\",\n841|        note=\"Admits exactly epoch-mismatched winners past the winner binding; lease- and session-mismatched winners still refuse. Kill path: the rotated winner authorizes the kill.\",\n842|    ),\n843|    Mutant(\n844|        name=\"N-lifecycle-target-lease\",\n845|        path=f\"{PACKAGE}/ops.go\",\n846|        find='\\tif presented.SessionID != mctx.SessionID ||\\n\\t\\tpresented.LeaseID != body.StaleLeaseID ||\\n\\t\\tpresented.Epoch != body.StaleEpoch {\\n',\n847|        replace='\\tif presented.SessionID != mctx.SessionID ||\\n\\t\\tpresented.Epoch != body.StaleEpoch {\\n',\n848|        count=1,\n849|        run=\"TestExecuteTerminateTargetLeaseIdentity\",\n850|        expect=\"KILLED\",\n851|        note=\"Admits exactly lease-mismatched fencing tokens past the target binding; session- and epoch-mismatched tokens still refuse. Kill path: the fencing decision authorizes a different lease than the key names.\",\n852|    ),\n853|    Mutant(\n854|        name=\"N-lifecycle-target-epoch\",\n855|        path=f\"{PACKAGE}/ops.go\",\n856|        find='\\tif presented.SessionID != mctx.SessionID ||\\n\\t\\tpresented.LeaseID != body.StaleLeaseID ||\\n\\t\\tpresented.Epoch != body.StaleEpoch {\\n',\n857|        replace='\\tif presented.SessionID != mctx.SessionID ||\\n\\t\\tpresented.LeaseID != body.StaleLeaseID {\\n',\n858|        count=1,\n859|        run=\"TestExecuteTerminateRefusals/target-mismatch\",\n860|        expect=\"KILLED\",\n861|        note=\"Admits exactly epoch-mismatched fencing tokens past the target binding; session- and lease-mismatched tokens still refuse. Kill path: the fencing decision authorizes a different epoch than the key names.\",\n862|    ),\n863|    Mutant(\n864|        name=\"N-lifecycle-target-session\",\n865|        path=f\"{PACKAGE}/ops.go\",\n866|        find='\\tif presented.SessionID != mctx.SessionID ||\\n\\t\\tpresented.LeaseID != body.StaleLeaseID ||\\n\\t\\tpresented.Epoch != body.StaleEpoch {\\n',\n867|        replace='\\tif presented.LeaseID != body.StaleLeaseID ||\\n\\t\\tpresented.Epoch != body.StaleEpoch {\\n',\n868|        count=1,\n869|        run=\"TestExecuteTerminateTargetSessionBinds\",\n870|        expect=\"KILLED\",\n871|        note=\"Admits exactly foreign-session fencing tokens past the target binding; lease- and epoch-mismatched tokens still refuse. Kill path: the admitted token reaches the winner binding and refuses there instead.\",\n872|    ),\n873|    Mutant(\n874|        name=\"N-lifecycle-capability-provider\",\n875|        path=f\"{PACKAGE}/ops.go\",\n876|        find='\\tif !admitted.Has(\"provider_process_observation\") {\\n\\t\\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\\n\\t}\\n',\n877|        replace='',\n878|        count=1,\n879|        run=\"TestExecuteTerminateRefusals/missing-capability\",\n880|        expect=\"KILLED\",\n881|        note=\"Admits exactly observation-less admissions past the dual conditional (the stale arm stays); stale-less admissions still refuse. Kill path: the admitted terminate reaches the kill effect instead of refusing.\",\n882|    ),\n883|    Mutant(\n884|        name=\"N-lifecycle-capability-stale\",\n885|        path=f\"{PACKAGE}/ops.go\",\n886|        find='\\tif !admitted.Has(\"stale_process_termination\") {\\n\\t\\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\\n\\t}\\n',\n887|        replace='',\n888|        count=1,\n889|        run=\"TestExecuteTerminateRefusesProviderOnlyCapability\",\n890|        expect=\"KILLED\",\n891|        note=\"Admits exactly stale-less admissions past the dual conditional (the observation arm stays); observation-less admissions still refuse. Kill path: provider observation alone authorizes the kill.\",\n892|    ),\n893|    Mutant(\n894|        name=\"N-lifecycle-restore-capability\",\n895|        path=f\"{PACKAGE}/ops.go\",\n896|        find='\\tif !req.Admitted.Has(\"reboot_restoration\") {\\n',\n897|        replace='\\tif !req.Admitted.Has(\"reboot_restoration\") && !(len(req.Admitted.Capabilities) == 1 && req.Admitted.Capabilities[0] == \"credential_capable_execution_realm\") {\\n',\n898|        count=1,\n899|        run=\"TestExecuteRestoreRefusesWithoutRebootCapability\",\n(more lines below)","final_result":true}}}
