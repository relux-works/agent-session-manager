{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca37","stream":{"kind":"session","id":"01a0c8e2-bf86-7413-8196-b3968750220e"},"sequence":886,"recorded_at":1780531400001767,"record_type":"event","durability":"durable","causation_id":"b7feb475-a410-4d2f-87a4-514d078fdaaf","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b7feb475-a410-4d2f-87a4-514d078fdaaf","run_stream":{"kind":"run","id":"b7feb475-a410-4d2f-87a4-514d078fdaaf"},"task_stream":{"kind":"task","id":"01a0c8e7-0342-7272-80ce-f9d74963498d"},"task_id":"01a0c8e7-0342-7272-80ce-f9d74963498d","event":{"kind":"output","task_id":"01a0c8e7-0342-7272-80ce-f9d74963498d","chunk":"Read text file `internal/tmuxserver/lifecycle_rev6_unix_test.go`.\n1|//go:build !windows\n2|\n3|package tmuxserver\n4|\n5|import (\n6|\t\"context\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\t\"strings\"\n10|\t\"sync\"\n11|\t\"sync/atomic\"\n12|\t\"testing\"\n13|\t\"time\"\n14|\n15|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n16|)\n17|\n18|// TestAttachRefusesAfterQuiescenceWhenAdmittedLate pins the P1-B\n19|// ordering contract at the production entries: an attach paused in\n20|// server admission while quiesce-input commits its durable report\n21|// must refuse once released, never commit a writable receipt after\n22|// quiescence. The attach holds no lock while blocked in admission,\n23|// so quiesce completes; the authoritative recheck under the lock\n24|// then observes the committed report.\n25|func TestAttachRefusesAfterQuiescenceWhenAdmittedLate(t *testing.T) {\n26|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n27|\tfx.runner.queue(\"lock-session\", \"\", 0).queue(\"detach-client\", \"\", 0)\n28|\tattachBody := lxAttachBody(t, nil)\n29|\tquiesceBody := lxQuiesceBody(t, nil)\n30|\tstarted := make(chan struct{})\n31|\trelease := make(chan struct{})\n32|\tvar once sync.Once\n33|\tadmitted := fullLifecycleAdmitted()\n34|\tfx.lc.ServerAdmission = func() (RealmAdmission, error) {\n35|\t\tonce.Do(func() { close(started) })\n36|\t\t<-release\n37|\t\treturn RealmAdmission{Admitted: admitted, RawGeneration: lxGeneration}, nil\n38|\t}\n39|\ttype attachResult struct {\n40|\t\toutcome OpOutcome\n41|\t\terr     error\n42|\t}\n43|\tdone := make(chan attachResult, 1)\n44|\tgo func() {\n45|\t\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n46|\t\t\tOperation: \"attach\", Body: attachBody, Source: \"parked\", Admitted: fullLifecycleAdmitted(),\n47|\t\t})\n48|\t\tdone <- attachResult{outcome: outcome, err: err}\n49|\t}()\n50|\tselect {\n51|\tcase <-started:\n52|\tcase <-time.After(10 * time.Second):\n53|\t\tt.Fatal(\"attach never reached server admission\")\n54|\t}\n55|\tquiesceOutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n56|\t\tOperation: \"quiesce-input\", Body: quiesceBody, Source: \"active\", Admitted: fullLifecycleAdmitted(),\n57|\t})\n58|\tif err != nil {\n59|\t\tclose(release)\n60|\t\tt.Fatalf(\"quiesce: %v\", err)\n61|\t}\n62|\tif quiesceOutcome.Mutation == nil || quiesceOutcome.Mutation.After != terminalbackend.StateQuiescing {\n63|\t\tclose(release)\n64|\t\tt.Fatalf(\"quiesce mutation = %+v\", quiesceOutcome.Mutation)\n65|\t}\n66|\tif proven, err := fx.lc.States.QuiesceBarrierProven(lxInstance); err != nil || !proven {\n67|\t\tclose(release)\n68|\t\tt.Fatalf(\"barrier proven = %v, %v, want the durable report\", proven, err)\n69|\t}\n70|\tclose(release)\n71|\tvar res attachResult\n72|\tselect {\n73|\tcase res = <-done:\n74|\tcase <-time.After(10 * time.Second):\n75|\t\tt.Fatal(\"attach never returned after release\")\n76|\t}\n77|\tif res.err == nil {\n78|\t\tt.Fatalf(\"attach admitted after durable quiescence: %+v\", res.outcome.Attach)\n79|\t}\n80|\trequireLocalCode(t, res.err, \"local_precondition_failed\", \"attach quiesced input\")\n81|\tif len(res.outcome.Argv) != 0 {\n82|\t\tt.Fatalf(\"refused attach built argv %q\", res.outcome.Argv)\n83|\t}\n84|\tif res.outcome.Attach != nil && res.outcome.Attach.InputAuthorized {\n85|\t\tt.Fatalf(\"refused attach authorized input: %+v\", res.outcome.Attach)\n86|\t}\n87|}\n88|\n89|// TestAttachQuiesceOrderingOverlapQuiesce pins that the quiesce\n90|// report commit and the attach receipt commit are mutually\n91|// exclusive: an attach launched from inside the report write (via\n92|// the state crash seam) must not complete until quiesce releases\n93|// the lock, and must then refuse through the recheck. Without\n94|// either side of the lock, or without the recheck, the attach\n95|// completes mid-commit and the test fails.\n96|func TestAttachQuiesceOrderingOverlapQuiesce(t *testing.T) {\n97|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n98|\tfx.runner.queue(\"lock-session\", \"\", 0).queue(\"detach-client\", \"\", 0)\n99|\tattachBody := lxAttachBody(t, nil)\n100|\tquiesceBody := lxQuiesceBody(t, nil)\n(more lines below)","final_result":true}}}
