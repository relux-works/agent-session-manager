{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c81b","stream":{"kind":"session","id":"01a0c8e2-bf86-7413-8196-b3968750220e"},"sequence":616,"recorded_at":1780531400001227,"record_type":"event","durability":"durable","causation_id":"b7feb475-a410-4d2f-87a4-514d078fdaaf","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b7feb475-a410-4d2f-87a4-514d078fdaaf","run_stream":{"kind":"run","id":"b7feb475-a410-4d2f-87a4-514d078fdaaf"},"task_stream":{"kind":"task","id":"01a0c8e5-3c97-7d51-a71c-3d4e8a9c629a"},"task_id":"01a0c8e5-3c97-7d51-a71c-3d4e8a9c629a","event":{"kind":"output","task_id":"01a0c8e5-3c97-7d51-a71c-3d4e8a9c629a","chunk":"Read text file `internal/tmuxserver/mutant_harness.py`.\n(899 line(s) above)\n900|        expect=\"KILLED\",\n901|        note=\"Admits exactly the single-credential admission past the reboot conditional; every other unproven admission still refuses. Kill path: the admitted restore reaches the wrapper start instead of refusing.\",\n902|    ),\n903|    Mutant(\n904|        name=\"N-lifecycle-resume-state\",\n905|        path=f\"{PACKAGE}/ops.go\",\n906|        find='\\tif err != nil || report.State != source {\\n',\n907|        replace='\\tif err != nil {\\n\\t\\t_ = report\\n',\n908|        count=1,\n909|        run=\"TestExecuteResumeRefusesWhenStatusProvesOtherwise\",\n910|        expect=\"KILLED\",\n911|        note=\"Admits exactly otherwise-proven retries past the resume reconciliation (status errors still refuse uncertain); only the state arm is dropped. Kill path: the retry resumes under the receipt and effects run instead of refusing.\",\n912|    ),\n913|    Mutant(\n914|        name=\"N-lifecycle-replay-session\",\n915|        path=f\"{PACKAGE}/ops.go\",\n916|        find='\\t\\tif err := terminstance.CheckResult(mctx, source, result); err != nil {\\n',\n917|        replace='\\t\\tcerr := terminstance.CheckResult(mctx, source, result)\\n\\t\\tif cerr != nil && cerr.Error() != \"terminal instance refused: terminal_backend_protocol_error at result session binding\" {\\n\\t\\t\\terr := cerr\\n',\n918|        count=1,\n919|        run=\"TestExecuteTerminateReplayRefusesTamperedImage/session\",\n920|        expect=\"KILLED\",\n921|        note=\"Admits exactly session-mismatched completions past the replay tamper check; every other tampered member still refuses. Kill path: the forged completion replays as success instead of refusing.\",\n922|    ),\n923|    Mutant(\n924|        name=\"N-lifecycle-loop-deadline\",\n925|        path=f\"{PACKAGE}/ops.go\",\n926|        find='\\t\\tif !lc.Now().Before(deadline) {\\n\\t\\t\\treturn fail(rowTimeoutCode(operation), \"operation deadline\")\\n\\t\\t}\\n',\n927|        replace='\\t\\tif lc.Now().After(deadline) {\\n\\t\\t\\treturn fail(rowTimeoutCode(operation), \"operation deadline\")\\n\\t\\t}\\n',\n928|        count=1,\n929|        run=\"TestExecuteRestoreRefusesOnDeadlineEffect\",\n930|        expect=\"KILLED\",\n931|        note=\"Admits exactly the on-deadline instant past the per-effect deadline (strict Before becomes After); every late instant still refuses. Kill path: the second effect runs instead of refusing the timeout.\",\n932|    ),\n933|    Mutant(\n934|        name=\"N-lifecycle-entry-deadline-terminate\",\n935|        path=f\"{PACKAGE}/ops.go\",\n936|        find='\\t\\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\\n\\t\\treturn OpOutcome{Operation: operation, Mutation: &result}, err\\n\\t}\\n\\tdeadline, err := mctx.Deadline.Time()\\n\\tif err != nil {\\n\\t\\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"mutation context deadline\"}\\n\\t}\\n\\tif !lc.Now().Before(deadline) {\\n',\n937|        replace='\\t\\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\\n\\t\\treturn OpOutcome{Operation: operation, Mu