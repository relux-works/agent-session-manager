{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c969","stream":{"kind":"session","id":"01a0c8e2-bf86-7413-8196-b3968750220e"},"sequence":783,"recorded_at":1780531400001561,"record_type":"event","durability":"durable","causation_id":"b7feb475-a410-4d2f-87a4-514d078fdaaf","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b7feb475-a410-4d2f-87a4-514d078fdaaf","run_stream":{"kind":"run","id":"b7feb475-a410-4d2f-87a4-514d078fdaaf"},"task_stream":{"kind":"task","id":"01a0c8e6-8030-7052-9c02-a147844d9a59"},"task_id":"01a0c8e6-8030-7052-9c02-a147844d9a59","event":{"kind":"output","task_id":"01a0c8e6-8030-7052-9c02-a147844d9a59","chunk":"Read text file `internal/tmuxserver/mutant_harness.py`.\n(1659 line(s) above)\n1660|        expect=\"KILLED\",\n1661|        note=\"Reports exactly the open process marker on the stop success path instead of the closed one; the store marker keeps its own row. Kill path: the outcome marker assertion fails.\",\n1662|    ),\n1663|    Mutant(\n1664|        name=\"N-engineop-stop-store\",\n1665|        path=f\"{PACKAGE}/lifecycle.go\",\n1666|        find='\\t\\toutcome.StoreClosed = true\\n',\n1667|        replace='\\t\\toutcome.StoreClosed = false\\n',\n1668|        count=1,\n1669|        run=\"TestExecuteStop\",\n1670|        expect=\"KILLED\",\n1671|        note=\"Reports exactly the open store marker on the stop success path instead of the closed one; the process marker keeps its own row. Kill path: the outcome marker assertion fails.\",\n1672|    ),\n1673|    Mutant(\n1674|        name=\"N-entry-authkind-terminate\",\n1675|        path=f\"{PACKAGE}/ops.go\",\n1676|        find='terminstance.CheckAuthorization(mctx.Authorization, terminstance.AuthorizationForceStale, lc.CurrentLease(), lc.Now())',\n1677|        replace='terminstance.CheckAuthorization(mctx.Authorization, terminstance.AuthorizationControl, lc.CurrentLease(), lc.Now())',\n1678|        count=1,\n1679|        run=\"TestExecuteTerminate\",\n1680|        expect=\"KILLED\",\n1681|        note=\"Rewires exactly the terminate entry check to the control authorization kind; the effect-loop kind keeps its own row. Kill path: the kind mismatch refuses at entry instead of killing.\",\n1682|    ),\n1683|    Mutant(\n1684|        name=\"N-entry-authkind-restore\",\n1685|        path=f\"{PACKAGE}/ops.go\",\n1686|        find='terminstance.CheckAuthorization(mctx.Authorization, terminstance.AuthorizationRestore, lc.CurrentLease(), lc.Now())',\n1687|        replace='terminstance.CheckAuthorization(mctx.Authorization, terminstance.AuthorizationControl, lc.CurrentLease(), lc.Now())',\n1688|        count=1,\n1689|        run=\"TestExecuteRestore\",\n1690|        expect=\"KILLED\",\n1691|        note=\"Rewires exactly the restore entry check to the control authorization kind; the effect-loop kind keeps its own row. Kill path: the kind mismatch refuses at entry instead of restoring.\",\n1692|    ),\n1693|    Mutant(\n1694|        name=\"N-entry-generation\",\n1695|        path=f\"{PACKAGE}/ops.go\",\n1696|        find='\\n\\tif lc.CurrentGeneration() != mctx.BackendGeneration {\\n',\n1697|        replace='\\n\\tif lc.CurrentGeneration() != mctx.BackendGeneration && mctx.BackendGeneration != \"generation-two\" {\\n',\n1698|        count=2,\n1699|        run=\"TestExecuteEntryRefusesStaleGeneration/(terminate|restore)\",\n1700|        expect=\"KILLED\",\n1701|        note=\"Admits exactly generation-two past both entry generation gates; every other stale generation still refuses, and the loop recheck keeps its own row. Two sites, two kills: each admitted entry binds a receipt the loop then refuses, so both no-bind assertions redden (attribution verified per subtest from the raw log).\",\n1702|    ),\n1703|    Mutant(\n1704|        name=\"N-key-material-terminate\",\n1705|        path=f\"{PACKAGE}/ops.go\",\n1706|        find='\"terminate\", body.StaleLeaseID, strconv.FormatUint(body.StaleEpoch, 10))\\n\\tif err != nil {\\n\\t\\treturn empty, err\\n\\t}\\n\\tif mctx.IdempotencyKey != derived {\\n',\n1707|        replace='\"terminate\", body.StaleLeaseID, strconv.FormatUint(body.StaleEpoch, 10))\\n\\tif err != nil {\\n\\t\\treturn empty, err\\n\\t}\\n\\tif mctx.IdempotencyKey != derived && mctx.IdempotencyKey != \"wrong/key\" {\\n',\n1708|        count=1,\n1709|        run=\"TestExecuteRefusesWrongIdempotencyKey/terminate\",\n1710|        expect=\"KILLED\",\n1711|        note=\"Admits exactly the wrong/key presented key past the terminate key-material gate; every other underived key still refuses, and the restore gate keeps its own row. Kill path: the miskeyed terminate reaches the kill effect.\",\n1712|    ),\n1713|    Mutant(\n1714|        name=\"N-key-material-restore\",\n1715|        path=f\"{PACKAGE}/ops.go\",\n1716|        find='mctx.SessionID, body.BootstrapOperationID)\\n\\tif err != nil {\\n\\t\\treturn empty, err\\n\\t}\\n\\tif mctx.IdempotencyKey != derived {\\n',\n1717|        replace='mctx.SessionID, body.BootstrapOperationID)\\n\\tif err != nil {\\n\\t\\treturn empty, err\\n\\t}\\n\\tif mctx.IdempotencyKey != derived && mctx.IdempotencyKey != \"wrong/key\" {\\n',\n1718|        count=1,\n1719|        run=\"TestExecuteRefusesWrongIdempotencyKey/restore\",\n1720|        expect=\"KILLED\",\n1721|        note=\"Admits exactly the wrong/key presented key past the restore key-material gate; every other underived key still refuses, and the terminate gate keeps its own row. Kill path: the miskeyed restore reaches the wrapper start.\",\n1722|    ),\n1723|    Mutant(\n1724|        name=\"N-fencing-invalid-reroute\",\n1725|        path=f\"{PACKAGE}/ops.go\",\n1726|        find='\\tif errors.Is(err, fencing.ErrInvalidArguments) {\\n',\n1727|        replace='\\tif errors.Is(err, fencing.ErrLeaseConflict) {\\n',\n1728|        count=1,\n1729|        run=\"TestExecuteTerminateRefusals/malformed-presented\",\n1730|        expect=\"KILLED\",\n1731|        note=\"Admits exactly malformed fencing material past the protocol mapping (it reroutes to the precondition like every other fencing refusal); the force member keeps its own row. Kill path: the malformed target refuses with the wrong verdict.\",\n1732|    ),\n1733|    Mutant(\n1734|        name=\"N-bind-mismatch-map\",\n1735|        path=f\"{PACKAGE}/ops.go\",\n1736|        find='\\t_, replayed, err := lc.Receipts.Bind(key, operation, mctx.OperationID)\\n\\tif err != nil {\\n\\t\\tif backendErrorCode(err) != \"\" {\\n',\n1737|        replace='\\t_, replayed, err := lc.Receipts.Bind(key, operation, mctx.OperationID)\\n\\tif err != nil {\\n\\t\\tif backendErrorCode(err) != \"\" && backendErrorCode(err) != \"idempotency_mismatch\" {\\n',\n1738|        count=1,\n1739|        run=\"TestExecuteTerminateRedriveMismatch\",\n(more lines below)","final_result":true}}}
