{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c70b","stream":{"kind":"session","id":"01a0c8e2-bf86-7413-8196-b3968750220e"},"sequence":480,"recorded_at":1780531400000955,"record_type":"event","durability":"durable","causation_id":"b7feb475-a410-4d2f-87a4-514d078fdaaf","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"b7feb475-a410-4d2f-87a4-514d078fdaaf","run_stream":{"kind":"run","id":"b7feb475-a410-4d2f-87a4-514d078fdaaf"},"task_stream":{"kind":"task","id":"01a0c8e4-50d1-79f2-a00b-00f84110c4b8"},"task_id":"01a0c8e4-50d1-79f2-a00b-00f84110c4b8","event":{"kind":"output","task_id":"01a0c8e4-50d1-79f2-a00b-00f84110c4b8","chunk":"Read text file `internal/terminalbackend/conformance.go`.\n(639 line(s) above)\n640|\tif !known {\n641|\t\treturn AttachAuthorization{}, mismatchf(\"document members\")\n642|\t}\n643|\tinputAuthorized, ok := inputRaw.(bool)\n644|\tif !ok {\n645|\t\treturn AttachAuthorization{}, mismatchf(\"document member type\")\n646|\t}\n647|\tissuedAt, err := timestampMember(object, \"issued_at\")\n648|\tif err != nil {\n649|\t\treturn AttachAuthorization{}, err\n650|\t}\n651|\texpiresAt, err := timestampMember(object, \"expires_at\")\n652|\tif err != nil {\n653|\t\treturn AttachAuthorization{}, err\n654|\t}\n655|\tissued, err := issuedAt.Time()\n656|\tif err != nil {\n657|\t\treturn AttachAuthorization{}, mismatchf(\"document timestamp\")\n658|\t}\n659|\texpires, err := expiresAt.Time()\n660|\tif err != nil {\n661|\t\treturn AttachAuthorization{}, mismatchf(\"document timestamp\")\n662|\t}\n663|\tif !expires.After(issued) {\n664|\t\treturn AttachAuthorization{}, refuse(&Error{Code: CodeUnauthorized, Detail: \"attach authorization expiry\"})\n665|\t}\n666|\treturn AttachAuthorization{\n667|\t\tPolicyEvidenceID:  policyEvidenceID,\n668|\t\tAuthorizingHostID: authorizingHostID,\n669|\t\tTransport:         transport,\n670|\t\tInputAuthorized:   inputAuthorized,\n671|\t\tIssuedAt:          issuedAt,\n672|\t\tExpiresAt:         expiresAt,\n673|\t}, nil\n674|}\n675|\n676|// CheckAttachRequest authorizes one attach request against its policy at\n677|// the given instant. The request transport and input boolean must equal\n678|// the authorized ones; a relay transport is refused even when authorized\n679|// on paper, because current AX admits only local and trusted-mesh\n680|// presentation (§4.E). Expiry is checked against now: an expired policy\n681|// authorizes nothing, and a lease-shaped bypass cannot exist because the\n682|// policy has no lease member to consult.\n683|func CheckAttachRequest(auth AttachAuthorization, transport string, inputAuthorized bool, now time.Time) error {\n684|\trequested, err := parseTransport(transport)\n685|\tif err != nil {\n686|\t\treturn err\n687|\t}\n688|\tif requested != auth.Transport || inputAuthorized != auth.InputAuthorized {\n689|\t\treturn refuse(&Error{Code: CodeUnauthorized, Detail: \"attach authorization binding\"})\n690|\t}\n691|\tif requested == TransportThirdPartyRelay {\n692|\t\treturn refuse(&Error{Code: CodeUnauthorized, Detail: \"attach relay transport\"})\n693|\t}\n694|\texpires, err := auth.ExpiresAt.Time()\n695|\tif err != nil {\n696|\t\treturn mismatchf(\"document timestamp\")\n697|\t}\n698|\tif !now.Before(expires) {\n699|\t\treturn refuse(&Error{Code: CodeUnauthorized, Detail: \"attach authorization expiry\"})\n700|\t}\n701|\treturn nil\n702|}\n703|\n704|// CheckAttachResult enforces the §4.C attach result rule: the result\n705|// input boolean MUST equal both the request and the AttachAuthorization.\n706|// A backend reporting input the policy did not authorize is refused even\n707|// when the request itself was authorized.\n708|func CheckAttachResult(requestInputAuthorized, resultInputAuthorized bool, auth AttachAuthorization) error {\n709|\tif resultInputAuthorized != requestInputAuthorized || resultInputAuthorized != auth.InputAuthorized {\n710|\t\treturn refuse(&Error{Code: CodeUnauthorized, Detail: \"attach input binding\"})\n711|\t}\n712|\treturn nil\n713|}\n714|\n715|// CheckEntrypoint enforces the §4.A stable entrypoint rule: every\n716|// backend-created runtime ultimately executes exactly\n717|// `ax pane SESSION_ID`, and a raw provider command is forbidden as a\n718|// durable entry point. argv must be exactly the three literals ax, pane,\n719|// and the canonical request Session UUIDv7 string, and the carried\n720|// session must equal the session under creation.\n721|func CheckEntrypoint(argv []string, sessionID string) error {\n722|\tif len(argv) != 3 || argv[0] != \"ax\" || argv[1] != \"pane\" {\n723|\t\treturn refuse(&Error{Code: CodePreconditionFailed, Detail: \"entrypoint argv\"})\n724|\t}\n725|\tsession, err := scalar.ParseUUIDv7(sessionID)\n726|\tif err != nil {\n727|\t\treturn refuse(&Error{Code: CodePreconditionFailed, Detail: \"entrypoint session binding\"})\n728|\t}\n729|\tcarried, err := scalar.ParseUUIDv7(argv[2])\n730|\tif err != nil {\n731|\t\treturn refuse(&Error{Code: CodePreconditionFailed, Detail: \"entrypoint session binding\"})\n732|\t}\n733|\tif carried.String() != session.String() {\n734|\t\treturn refuse(&Error{Code: CodePreconditionFailed, Detail: \"entrypoint session binding\"})\n735|\t}\n736|\treturn nil\n737|}\n738|\n739|// StatusResult is the §4.C status success body in harness form. Pointer\n740|// members distinguish null from false: provider observation is null\n741|// unless requested and evidenced, and the last-operation fields are null\n742|// when the backend reports no prior operation.\n743|type StatusResult struct {\n744|\tState             InstanceState\n745|\tIdentityMatch     bool\n746|\tWrapperPresent    bool\n747|\tProviderPresent   *bool\n748|\tAttachable        bool\n749|\tLastOperationID   *string\n750|\tLastEffect        *SideEffect\n751|\tProviderRequested bool\n752|\tProviderEvidenced bool\n753|\tAttachEvidenced   bool\n754|}\n755|\n756|// CheckStatusResult enforces the §4.C exact-instance lookup rules. A\n757|// non-match sets identity_match false, state absent, wrapper absent,\n758|// provider null, attachable false, and both last fields null, and does\n759|// not authorize fallback: any deviation from that canonical false form\n(more lines below)","final_result":true}}}
