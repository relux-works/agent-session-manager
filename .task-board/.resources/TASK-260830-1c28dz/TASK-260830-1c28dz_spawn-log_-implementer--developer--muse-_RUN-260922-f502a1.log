 kind, engine.CurrentLease(), engine.Now()); err != nil {\\n419:\\t\\tif engine.CurrentGeneration() != context.BackendGeneration {\\n501:\\tif !engine.Now().Before(deadline) {\\n\",\n  \"original_output_bytes\": 1222,\n  \"original_output_tokens\": 306,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
