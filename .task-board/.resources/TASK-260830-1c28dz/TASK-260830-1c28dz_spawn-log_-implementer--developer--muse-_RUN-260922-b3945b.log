{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d0d9","stream":{"kind":"session","id":"01a0c765-6a15-7930-81af-9d81d9b3108a"},"sequence":1735,"recorded_at":1780531400003465,"record_type":"event","durability":"durable","causation_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","run_stream":{"kind":"run","id":"eb24712a-98eb-41ba-85bf-fe73b2577481"},"task_stream":{"kind":"task","id":"01a0c775-11a6-7a31-9d18-9d51fe4828e0"},"task_id":"01a0c775-11a6-7a31-9d18-9d51fe4828e0","event":{"kind":"output","task_id":"01a0c775-11a6-7a31-9d18-9d51fe4828e0","chunk":"Read text file `internal/tmuxserver/ops.go`.\n(499 line(s) above)\n500|\taction := AfterRestoreParked\n501|\tswitch {\n502|\tcase localWins && material:\n503|\t\taction = AfterRestoreResumed\n504|\tcase !localWins && remoteOwns && req.Interactive:\n505|\t\taction = AfterRestoreRemoteOffer\n506|\t}\n507|\treturn AfterRestoreOutcome{\n508|\t\tAction:           action,\n509|\t\tWinnerLeaseID:    winner.LeaseID,\n510|\t\tWinnerHostID:     winner.HolderHostID,\n511|\t\tRefreshAttempted: attempted,\n512|\t\tRefreshBoundMs:   uint64(bound.Milliseconds()),\n513|\t}\n514|}\n515|\n516|// checkPriorBinding enforces the restore mismatch rule: the recorded\n517|// bootstrap binding for the (session, bootstrap) pair must exist and\n518|// its digest must equal the carried prior_binding_id. Substituting any\n519|// other binding — including the configured default — refuses the\n520|// restore mismatch. A binding read failure is an error, never a\n521|// mismatch: unknown is not a verdict.\n522|func (lc *Lifecycle) checkPriorBinding(body RestoreBody) error {\n523|\trecorded, found, err := lc.Bindings.Lookup(body.Context.SessionID, body.BootstrapOperationID)\n524|\tif err != nil {\n525|\t\treturn err\n526|\t}\n527|\tif !found || recorded.BindingDigest != body.PriorBindingID {\n528|\t\treturn &Error{Code: terminalbackend.CodeRestoreMismatch, Detail: \"restore prior binding\"}\n529|\t}\n530|\treturn nil\n531|}\n532|\n533|// effectPerformer executes one lifecycle side effect and reports its\n534|// evidence ID, the single capability the receipt-bound effect loop\n535|// needs from the request backend.\n536|type effectPerformer interface {\n537|\tPerformEffect(ctx context.Context, effect terminalbackend.SideEffect) (string, error)\n538|}\n539|\n540|// executeWithReceipt binds the idempotency receipt and runs the\n541|// effects under it, mirroring the engine's bind discipline: an\n542|// identical retry replays the one completion, a bound key without its\n543|// completion reconciles through the production status entry before it\n544|// refuses, and no path binds a second receipt for one key. complete\n545|// maps the successful result into the operation outcome; failures\n546|// return the outcome with the mutation set, mirroring the engine.\n547|func (lc *Lifecycle) executeWithReceipt(ctx context.Context, req OpRequest, socket string, operation terminalbackend.Operation, mctx terminstance.MutationContext, source, target terminalbackend.InstanceState, effects []terminalbackend.SideEffect, deadline time.Time, kind terminstance.AuthorizationKind, reqBackend effectPerformer, complete func(terminstance.Result) OpOutcome) (OpOutcome, error) {\n548|\tkey := mctx.IdempotencyKey\n549|\t_, replayed, err := lc.Receipts.Bind(key, operation, mctx.OperationID)\n550|\tif err != nil {\n551|\t\tif backendErrorCode(err) != \"\" {\n552|\t\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n553|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, rowError(operation, err)\n554|\t\t}\n555|\t\tif _, found, lookupErr := lc.Receipts.Lookup(key); lookupErr == nil && !found {\n556|\t\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"idempotency store failure\"}\n557|\t\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n558|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n559|\t\t}\n560|\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"idempotency store failure\"}\n561|\t\tresult := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n562|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n563|\t}\n564|\tif replayed {\n565|\t\tstored, found, err := lc.Receipts.Completed(key)\n566|\t\tif err != nil {\n567|\t\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"idempotency store failure\"}\n568|\t\t\tresult := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n569|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n570|\t\t}\n571|\t\tif !found {\n572|\t\t\treturn lc.resumeUncertain(ctx, req, socket, operation, mctx, source, target, effects, deadline, kind, reqBackend, complete)\n573|\t\t}\n574|\t\tvar result terminstance.Result\n575|\t\tif err := json.Unmarshal(stored, &result); err != nil {\n576|\t\t\tfailure := &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"idempotency result image\"}\n577|\t\t\trebuilt := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n578|\t\t\treturn OpOutcome{Operation: operation, Mutation: &rebuilt}, failure\n579|\t\t}\n580|\t\tif err := terminstance.CheckResult(mctx, source, result); err != nil {\n581|\t\t\tif backendErrorCode(err) == \"\" {\n582|\t\t\t\tfailure := &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"idempotency result image\"}\n583|\t\t\t\trebuilt := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n584|\t\t\t\treturn OpOutcome{Operation: operation, Mutation: &rebui