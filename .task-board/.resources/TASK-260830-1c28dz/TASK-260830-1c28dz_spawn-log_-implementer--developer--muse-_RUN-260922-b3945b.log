{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d13d","stream":{"kind":"session","id":"01a0c765-6a15-7930-81af-9d81d9b3108a"},"sequence":1785,"recorded_at":1780531400003565,"record_type":"event","durability":"durable","causation_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","run_stream":{"kind":"run","id":"eb24712a-98eb-41ba-85bf-fe73b2577481"},"task_stream":{"kind":"task","id":"01a0c775-295e-7851-90e4-85e423dd7d3c"},"task_id":"01a0c775-295e-7851-90e4-85e423dd7d3c","event":{"kind":"output","task_id":"01a0c775-295e-7851-90e4-85e423dd7d3c","chunk":"Read text file `internal/tmuxserver/lifecycle.go`.\n(499 line(s) above)\n500|// deadline and the timeout: the wait context carries the minimum, and\n501|// an already-invalid deadline falls back to the timeout alone (the\n502|// engine refuses the malformed deadline before any effect runs, so the\n503|// fallback never binds). The caller cancels the context.\n504|func (lc *Lifecycle) boundWait(ctx context.Context, mctx terminstance.MutationContext, timeoutMs uint64) (context.Context, context.CancelFunc) {\n505|\tbound := lc.Now().Add(time.Duration(timeoutMs) * time.Millisecond)\n506|\tif deadline, err := mctx.Deadline.Time(); err == nil && deadline.Before(bound) {\n507|\t\tbound = deadline\n508|\t}\n509|\treturn context.WithDeadline(ctx, bound)\n510|}\n511|\n512|// lesserDeadline computes the lesser of the request deadline and the\n513|// graceful timeout for the stop close-confirm poll. An invalid\n514|// deadline falls back the same way as the boundary wait.\n515|func (lc *Lifecycle) lesserDeadline(mctx terminstance.MutationContext, timeoutMs uint64) time.Time {\n516|\tbound := lc.Now().Add(time.Duration(timeoutMs) * time.Millisecond)\n517|\tif deadline, err := mctx.Deadline.Time(); err == nil && deadline.Before(bound) {\n518|\t\treturn deadline\n519|\t}\n520|\treturn bound\n521|}","final_result":true}}}
