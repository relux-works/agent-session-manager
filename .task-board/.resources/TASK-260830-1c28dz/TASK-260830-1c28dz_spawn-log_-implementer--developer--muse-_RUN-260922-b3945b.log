{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d17b","stream":{"kind":"session","id":"01a0c765-6a15-7930-81af-9d81d9b3108a"},"sequence":1816,"recorded_at":1780531400003627,"record_type":"event","durability":"durable","causation_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","run_stream":{"kind":"run","id":"eb24712a-98eb-41ba-85bf-fe73b2577481"},"task_stream":{"kind":"task","id":"01a0c775-3534-74c0-b909-f34650e3b0ed"},"task_id":"01a0c775-3534-74c0-b909-f34650e3b0ed","event":{"kind":"output","task_id":"01a0c775-3534-74c0-b909-f34650e3b0ed","chunk":"Read text file `internal/tmuxserver/status.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"sort\"\n6|\t\"strconv\"\n7|\t\"strings\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n12|)\n13|\n14|// ObserveStatus reports the tmux observation for one status body: the\n15|// live probe (list-panes for presence and provider rows, list-sessions\n16|// for attached counts) reconciled against the AX-side state memory. An\n17|// error is unknown, never absent: transport failures, malformed probe\n18|// output, and contradictory probes all refuse without a report.\n19|func (runner *backend) ObserveStatus(ctx context.Context, body terminstance.StatusBody) (terminstance.StatusObservation, error) {\n20|\tempty := terminstance.StatusObservation{}\n21|\tinstance := body.TerminalInstanceID\n22|\tif !body.HasTerminalInstanceID {\n23|\t\tresolved, err := runner.resolveSessionInstance(body.SessionID)\n24|\t\tif err != nil {\n25|\t\t\treturn empty, err\n26|\t\t}\n27|\t\tif resolved == \"\" {\n28|\t\t\treturn runner.absentObservation(body), nil\n29|\t\t}\n30|\t\tinstance = resolved\n31|\t}\n32|\tpresent, panes, err := runner.probePanes(ctx, instance)\n33|\tif err != nil {\n34|\t\treturn empty, err\n35|\t}\n36|\tattached := 0\n37|\tif present {\n38|\t\tcount, err := runner.probeAttached(ctx, instance)\n39|\t\tif err != nil {\n40|\t\t\treturn empty, err\n41|\t\t}\n42|\t\tattached = count\n43|\t}\n44|\tmemory, found, err := runner.lookupMemory(instance)\n45|\tif err != nil {\n46|\t\treturn empty, err\n47|\t}\n48|\tstate, wrapper, provider, attachable := ClassifyStatus(ClassifyInput{\n49|\t\tPresent:         present,\n50|\t\tAttached:        attached,\n51|\t\tProviderRows:    len(panes),\n52|\t\tMemory:          memory,\n53|\t\tMemoryFound:     found,\n54|\t\tAttachCapable:   runner.attachCapable(),\n55|\t\tProviderWanted:  body.IncludeProviderObservation,\n56|\t\tProviderCapable: runner.admitted.Has(\"provider_process_observation\"),\n57|\t})\n58|\tproviderPresent, requested, evidenced := providerTriple(body.IncludeProviderObservation, runner.admitted.Has(\"provider_process_observation\"), provider)\n59|\tevidence := statusEvidence(instance, present, panes, attached)\n60|\treturn terminstance.StatusObservation{\n61|\t\tState:             state,\n62|\t\tIdentityMatch:     true,\n63|\t\tWrapperPresent:    wrapper,\n64|\t\tProviderPresent:   providerPresent,\n65|\t\tAttachable:        attachable,\n66|\t\tEvidenceIDs:       evidence,\n67|\t\tProviderRequested: requested,\n68|\t\tProviderEvidenced: evidenced,\n69|\t\tAttachEvidenced:   attachable,\n70|\t\tSessionID:         body.SessionID,\n71|\t\tInstanceID:        instance,\n72|\t\tBackendID:         body.TerminalBackendID,\n73|\t\tImplVersion:       body.ImplementationVersion,\n74|\t\tProtoVersion:      body.ProtocolVersion,\n75|\t\tGeneration:        body.BackendGeneration,\n76|\t}, nil\n77|}\n78|\n79|// resolveSessionInstance resolves a session-scoped query to the\n80|// session's recorded instance through the bootstrap binding store. An\n81|// unbound session resolves empty: it reads absent, never refused. A\n82|// binding read failure is unknown, never absence.\n83|func (runner *backend) resolveSessionInstance(sessionID string) (string, error) {\n84|\tif runner.bindings == nil {\n85|\t\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend binding store\"}\n86|\t}\n87|\tbinding, found, err := runner.bindings.Status(sessionID)\n88|\tif err != nil {\n89|\t\treturn \"\", err\n90|\t}\n91|\tif !found {\n92|\t\treturn \"\", nil\n93|\t}\n94|\treturn binding.TerminalInstanceID, nil\n95|}\n96|\n97|// absentObservation reports proven absence for an unbound session: the\n98|// absent shape with the queried session echoed, so the engine adopts a\n99|// match on the session it asked about and nothing else.\n100|func (runner *backend) absentObservation(body terminstance.StatusBody) terminstance.StatusObservation {\n101|\treturn terminstance.StatusObservation{\n102|\t\tState:             terminalbackend.StateAbsent,\n103|\t\tIdentityMatch:     true,\n104|\t\tWrapperPresent:    false,\n105|\t\tProviderPresent:   nil,\n106|\t\tAttachable:        false,\n107|\t\tEvidenceIDs:       []string{scalar.SHA256Digest([]byte(\"unbound\\n\" + body.SessionID)).String()},\n108|\t\tProviderRequested: body.IncludeProviderObservation,\n109|\t\tProviderEvidenced: false,\n110|\t\tAttachEvidenced:   false,\n111|\t\tSessionID:         body.SessionID,\n112|\t\tInstanceID:        body.TerminalInstanceID,\n113|\t\tBackendID:         body.TerminalBackendID,\n114|\t\tImplVersion:       body.ImplementationVersion,\n115|\t\tProtoVersion:      body.ProtocolVersion,\n116|\t\tGeneration:        body.BackendGeneration,\n117|\t}\n118|}\n119|\n120|// probePanes runs list-panes for one instance: exit 0 with at least one\n121|// row proves presence; a nonzero exit proves absence only with an\n122|// absence marker on stderr (no session, no window, or no server\n123|// socket under the verified path); any other nonzero exit —\n124|// permission failures, refused connections, killed children — is\n125|// unknown, never absent. A transport error is unknown. An exit-0\n126|// with zero rows is contradictory — a tmux session always has a\n127|// pane — and refuses as unknown rather than inventing presence.\n128|func (runner *backend) probePanes(ctx context.Context, instance string) (bool, []string, error) {\n129|\tsaved := runner.instanceID\n130|\trunner.instanceID = instance\n131|\tdefer func() { runner.instanceID = saved }()\n132|\targv, err := runner.command(DirectiveListPanes)\n133|\tif err != nil {\n134|\t\treturn false, nil, err\n135|\t}\n136|\tresult, err := runner.runner.Run(ctx, argv)\n137|\tif err != nil {\n138|\t\treturn false, nil, err\n139|\t}\n140|\tpresent, absent := classifyAbsence(result, absentMarkerNoSession, absentMarkerNoWindow, absentMarkerNoSocket)\n141|\tif absent {\n142|\t\treturn false, nil, nil\n143|\t}\n144|\tif !present {\n145|\t\treturn false, nil, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n146|\t}\n147|\trows := splitRows(string(result.Stdout))\n148|\tif len(rows) == 0 {\n149|\t\treturn false, nil, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n150|\t}\n151|\treturn true, rows, nil\n152|}\n153|\n154|// probeAttached reads the attached-client count for one present\n155|// instance from list-sessions. A missing row contradicts the presence\n156|// probe (the session vanished between the two commands, or the list is\n157|// corrupt) and refuses as unknown; a malformed count refuses the same\n158|// way. Neither invents attachability.\n159|func (runner *backend) probeAttached(ctx context.Context, instance string) (int, error) {\n160|\targv, err := runner.command(DirectiveListSessions)\n161|\tif err != nil {\n162|\t\treturn 0, err\n163|\t}\n164|\tresult, err := runner.runner.Run(ctx, argv)\n165|\tif err != nil {\n166|\t\treturn 0, err\n167|\t}\n168|\tif result.ExitCode != 0 {\n169|\t\treturn 0, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n170|\t}\n171|\tfor _, row := range splitRows(string(result.Stdout)) {\n172|\t\tname, count, ok := cutRow(row)\n173|\t\tif !ok {\n174|\t\t\treturn 0, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n175|\t\t}\n176|\t\tif name != instance {\n177|\t\t\tcontinue\n178|\t\t}\n179|\t\tattached, err := strconv.Atoi(count)\n180|\t\tif err != nil || attached < 0 {\n181|\t\t\treturn 0, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n182|\t\t}\n183|\t\treturn attached, nil\n184|\t}\n185|\treturn 0, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n186|}\n187|\n188|// lookupMemory reads the AX-side state memory for one instance. The\n189|// store may be nil in unit-scoped backends; a nil store reads as no\n190|// memory rather than refusing, because presence alone still classifies\n191|// the live triad (absent/parked/active).\n192|func (runner *backend) lookupMemory(instance string) (terminalbackend.InstanceState, bool, error) {\n193|\tif runner.states == nil {\n194|\t\treturn \"\", false, nil\n195|\t}\n196|\treturn runner.states.Lookup(instance)\n197|}\n198|\n199|// attachCapable reports whether any admitted attach capability\n200|// evidences presentation right now: local, remote, or web attach.\n201|func (runner *backend) attachCapable() bool {\n202|\treturn runner.admitted.Has(\"local_attach\") ||\n203|\t\trunner.admitted.Has(\"remote_attach\") ||\n204|\t\trunner.admitted.Has(\"web_attach\")\n205|}\n206|\n207|// providerTriple computes the provider_present member and its two\n208|// validation flags: the member is non-null only when observation was\n209|// requested and evidenced; the flags let the landed CheckStatusResult\n210|// verify that rule.\n211|func providerTriple(requested, capable, observed bool) (*bool, bool, bool) {\n212|\tif !requested || !capable {\n213|\t\treturn nil, requested, false\n214|\t}\n215|\tif !observed {\n216|\t\treturn nil, requested, false\n217|\t}\n218|\tpresent := true\n219|\treturn &present, requested, true\n220|}\n221|\n222|// statusEvidence derives the sorted-unique status evidence digests over\n223|// the probe record: presence, pane rows, and attached count. Absence\n224|// evidences the negative probe, never an empty set.\n225|func statusEvidence(instance string, present bool, panes []string, attached int) []string {\n226|\tvar evidence []string\n227|\tif !present {\n228|\t\tevidence = append(evidence, scalar.SHA256Digest([]byte(\"absent\\n\"+instance)).String())\n229|\t} else {\n230|\t\tevidence = append(evidence, scalar.SHA256Digest([]byte(\"panes\\n\"+instance+\"\\n\"+strings.Join(panes, \"\\n\"))).String())\n231|\t\tevidence = append(evidence, scalar.SHA256Digest([]byte(\"sessions\\n\"+instance+\"\\n\"+strconv.Itoa(attached))).String())\n232|\t}\n233|\tsort.Strings(evidence)\n234|\treturn evidence\n235|}\n236|\n237|// splitRows splits probe stdout into non-empty rows. Blank lines are\n238|// skipped: tmux never emits them, and skipping is the tolerant read;\n239|// a wholly blank output yields zero rows, which the callers refuse.\n240|func splitRows(output string) []string {\n241|\tvar rows []string\n242|\tfor _, line := range strings.Split(output, \"\\n\") {\n243|\t\tif line != \"\" {\n244|\t\t\trows = append(rows, line)\n245|\t\t}\n246|\t}\n247|\treturn rows\n248|}\n249|\n250|// cutRow splits one sessions row into name and attached count. Rows\n251|// without the pipe separator are malformed.\n252|func cutRow(row string) (string, string, bool) {\n253|\tname, count, found := strings.Cut(row, \"|\")\n254|\tif !found || name == \"\" || count == \"\" {\n255|\t\treturn \"\", \"\", false\n256|\t}\n257|\treturn name, count, true\n258|}\n259|\n260|// ClassifyInput is the pure status-classification input: the live tmux\n261|// probe (presence, attached count, provider rows) plus the AX-side\n262|// memory and the capability facts.\n263|type ClassifyInput struct {\n264|\tPresent         bool\n265|\tAttached        int\n266|\tProviderRows    int\n267|\tMemory          terminalbackend.InstanceState\n268|\tMemoryFound     bool\n269|\tAttachCapable   bool\n270|\tProviderWanted  bool\n271|\tProviderCapable bool\n272|\t_               struct{}\n273|}\n274|\n275|// ClassifyStatus reconciles the live tmux probe against the AX-side\n276|// state memory into the adopted status: state, wrapper presence,\n277|// provider presence, and attachability. tmux reports only presence;\n278|// the memory carries quiescing, stopped, and stale_fenced, which exist\n279|// only on this side. The rules:\n280|//\n281|//   - absent probe, no memory (or memory absent): absent, no wrapper;\n282|//   - absent probe, memory stopped or stale_fenced: the memory state,\n283|//     no wrapper (a fenced incarnation keeps its fencing without a wrapper);\n284|//   - absent probe, memory quiescing/active/parked/unavailable: unavailable\n285|//     (contradiction: the wrapper vanished, or was never proven);\n286|//   - present probe, memory quiescing or stale_fenced: the memory state\n287|//     (tmux cannot show either; a fenced incarnation with a live wrapper\n288|//     is what terminate-stale kills);\n289|//   - present probe, memory stopped or unavailable: unavailable\n290|//     (contradiction: a session resurrected, or was never proven);\n291|//   - present probe, memory active/parked/absent/none: active when at\n292|//     least one client is attached, otherwise parked.\n293|//\n294|// Attachability needs parked|active plus a currently evidenced attach\n295|// capability; provider presence needs at least one pane row. Memory\n296|// creating is unreachable (Record refuses it) and classifies\n297|// unavailable either way.\n298|func ClassifyStatus(input ClassifyInput) (terminalbackend.InstanceState, bool, bool, bool) {\n299|\tif !input.Present {\n300|\t\treturn classifyAbsent(input)\n301|\t}\n302|\treturn classifyPresent(input)\n303|}\n304|\n305|// classifyAbsent adopts the state for an absent probe.\n306|func classifyAbsent(input ClassifyInput) (terminalbackend.InstanceState, bool, bool, bool) {\n307|\tif !input.MemoryFound || input.Memory == terminalbackend.StateAbsent {\n308|\t\treturn terminalbackend.StateAbsent, false, false, false\n309|\t}\n310|\tswitch input.Memory {\n311|\tcase terminalbackend.StateStopped, terminalbackend.StateStaleFenced:\n312|\t\treturn input.Memory, false, false, false\n313|\tdefault:\n314|\t\treturn terminalbackend.StateUnavailable, false, false, false\n315|\t}\n316|}\n317|\n318|// classifyPresent adopts the state for a present probe.\n319|func classifyPresent(input ClassifyInput) (terminalbackend.InstanceState, bool, bool, bool) {\n320|\tprovider := input.ProviderRows > 0\n321|\tswitch input.Memory {\n322|\tcase terminalbackend.StateQuiescing, terminalbackend.StateStaleFenced:\n323|\t\tif !input.MemoryFound {\n324|\t\t\tbreak\n325|\t\t}\n326|\t\treturn input.Memory, true, provider, false\n327|\tcase terminalbackend.StateStopped, terminalbackend.StateUnavailable:\n328|\t\tif !input.MemoryFound {\n329|\t\t\tbreak\n330|\t\t}\n331|\t\treturn terminalbackend.StateUnavailable, false, false, false\n332|\tcase terminalbackend.StateCreating:\n333|\t\treturn terminalbackend.StateUnavailable, false, false, false\n334|\tdefault:\n335|\t}\n336|\tstate := terminalbackend.StateParked\n337|\tif input.Attached > 0 {\n338|\t\tstate = terminalbackend.StateActive\n339|\t}\n340|\tattachable := input.AttachCapable && (state == terminalbackend.StateParked || state == terminalbackend.StateActive)\n341|\treturn state, true, provider, attachable\n342|}","final_result":true}}}
