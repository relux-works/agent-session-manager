{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d3fd","stream":{"kind":"session","id":"01a0c765-6a15-7930-81af-9d81d9b3108a"},"sequence":2137,"recorded_at":1780531400004269,"record_type":"event","durability":"durable","causation_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","run_stream":{"kind":"run","id":"eb24712a-98eb-41ba-85bf-fe73b2577481"},"task_stream":{"kind":"task","id":"01a0c776-926f-7312-a341-2f2a007bbfe3"},"task_id":"01a0c776-926f-7312-a341-2f2a007bbfe3","event":{"kind":"output","task_id":"01a0c776-926f-7312-a341-2f2a007bbfe3","chunk":"Read text file `internal/terminstance/execute.go`.\n(469 line(s) above)\n470|\t\t\tresult.Disposition = DispositionStatusFirst\n471|\t\t\treturn result, uncoded\n472|\t\t}\n473|\t\tresult.Disposition = DispositionStatusFirst\n474|\t\treturn result, failure\n475|\t}\n476|\treturn result, nil\n477|}\n478|\n479|// ExecuteStatus executes one status query: no receipt, no side effects,\n480|// no authorization and no transition bookkeeping of its own. The\n481|// reported state is adopted verbatim; the engine validates the report\n482|// (the reported match must equal the compared tuple, the landed\n483|// CheckStatusResult must admit it, evidence must be sorted-unique\n484|// digests) and enforces the provider-observation capability conditional.\n485|// A timeout or read failure is unknown, never absent: it returns an\n486|// error with no report.\n487|func (engine *Engine) ExecuteStatus(ctx context.Context, body StatusBody, source terminalbackend.InstanceState, admitted terminalbackend.Admitted) (StatusReport, error) {\n488|\tempty := StatusReport{}\n489|\tif engine == nil || engine.Backend == nil || engine.Now == nil {\n490|\t\treturn empty, refuse(CodeProtocolError, \"engine unavailable\")\n491|\t}\n492|\tif source != \"\" {\n493|\t\tif _, _, err := terminalbackend.CheckTransition(string(terminalbackend.OperationStatus), string(source), false); err != nil {\n494|\t\t\treturn empty, wrapLanded(err)\n495|\t\t}\n496|\t}\n497|\tdeadline, err := body.Deadline.Time()\n498|\tif err != nil {\n499|\t\treturn empty, refuse(CodeProtocolError, \"status body deadline\")\n500|\t}\n501|\tif !engine.Now().Before(deadline) {\n502|\t\treturn empty, refuse(CodeTimeout, \"operation deadline\")\n503|\t}\n504|\tif body.IncludeProviderObservation && !admitted.Has(\"provider_process_observation\") {\n505|\t\treturn empty, refuse(CodeCapabilityUnproven, \"operation capability conditional\")\n506|\t}\n507|\tobserved, err := engine.Backend.ObserveStatus(ctx, body)\n508|\tif err != nil {\n509|\t\tcode := ErrorCode(err)\n510|\t\tif code == \"\" {\n511|\t\t\treturn empty, refuse(CodeUnavailable, \"status observation unknown\")\n512|\t\t}\n513|\t\tif err := terminalbackend.CheckErrorAllowed(string(terminalbackend.OperationStatus), code); err != nil {\n514|\t\t\treturn empty, refuse(CodeProtocolError, \"operation error vocabulary\")\n515|\t\t}\n516|\t\treturn empty, refuse(code, \"status observation unknown\")\n517|\t}\n518|\tif _, err := terminalbackend.ParseInstanceState(string(observed.State)); err != nil {\n519|\t\treturn empty, wrapLanded(err)\n520|\t}\n521|\tcomputed, err := statusIdentityMatch(body, observed)\n522|\tif err != nil {\n523|\t\treturn empty, err\n524|\t}\n525|\tif observed.IdentityMatch != computed {\n526|\t\treturn empty, refuse(CodeProtocolError, \"status identity binding\")\n527|\t}\n528|\tconverted := terminalbackend.StatusResult{\n529|\t\tState:             observed.State,\n530|\t\tIdentityMatch:     observed.IdentityMatch,\n531|\t\tWrapperPresent:    observed.WrapperPresent,\n532|\t\tProviderPresent:   observed.ProviderPresent,\n533|\t\tAttachable:        observed.Attachable,\n534|\t\tLastOperationID:   observed.LastOperationID,\n535|\t\tLastEffect:        observed.LastEffect,\n536|\t\tProviderRequested: observed.ProviderRequested,\n537|\t\tProviderEvidenced: observed.ProviderEvidenced,\n538|\t\tAttachEvidenced:   observed.AttachEvidenced,\n539|\t}\n540|\tif observed.LastOperationID != nil {\n541|\t\tif _, err := scalar.ParseUUIDv7(*observed.LastOperationID); err != nil {\n542|\t\t\treturn empty, refuse(CodeProtocolError, \"status report operation\")\n543|\t\t}\n544|\t}\n545|\tif err := terminalbackend.CheckStatusResult(computed, converted); err != nil {\n546|\t\treturn empty, wrapLanded(err)\n547|\t}\n548|\tif err := checkSortedUniqueStatusEvidence(observed.EvidenceIDs); err != nil {\n549|\t\treturn empty, err\n550|\t}\n551|\treturn StatusReport{\n552|\t\tState:           observed.State,\n553|\t\tIdentityMatch:   observed.IdentityMatch,\n554|\t\tWrapperPresent:  observed.WrapperPresent,\n555|\t\tProviderPresent: observed.ProviderPresent,\n556|\t\tAttachable:      observed.Attachable,\n557|\t\tLastOperationID: observed.LastOperationID,\n558|\t\tLastEffect:      observed.LastEffect,\n559|\t\tEvidenceIDs:     append([]string(nil), observed.EvidenceIDs...),\n560|\t}, nil\n561|}\n562|\n563|// statusIdentityMatch compares the reported identity tuple against the\n564|// query: exact-instance lookup requires Session, instance, backend,\n565|// implementation, protocol and generation to all match; Session-scoped\n566|// lookup requires the reported session to match and adopts the rest.\n567|// Reported members are shape-validated first, so a malformed report is\n568|// refused instead of compared.\n569|func statusIdentityMatch(body StatusBody, observed StatusObservation) (bool, error) {\n570|\tif _, err := scalar.ParseUUIDv7(observed.SessionID); err != nil {\n571|\t\treturn false, refuse(CodeProtocolError, \"status report session\")\n572|\t}\n573|\tif _, err := terminalbackend.ParseID(observed.BackendID); err != nil {\n574|\t\treturn false, wrapLanded(err)\n575|\t}\n576|\tif err := checkVersionTuple(observed.BackendID, observed.ImplVersion, observed.ProtoVersion); err != nil {\n577|\t\treturn false, err\n578|\t}\n579|\tif observed.SessionID != body.SessionID {\n580|\t\treturn false, nil\n581|\t}\n582|\tif !body.HasTerminalInstanceID {\n583|\t\treturn true, nil\n584|\t}\n585|\tif _, err := scalar.ParseUUIDv7(observed.InstanceID); err != nil {\n586|\t\treturn false, refuse(CodeProtocolError, \"status report instance\")\n587|\t}\n588|\tif err := checkGenerationBound(observed.Generation); err != nil {\n589|\t\treturn false, refuse(CodeProtocolError, \"status report generation\")\n(more lines below)","final_result":true}}}
