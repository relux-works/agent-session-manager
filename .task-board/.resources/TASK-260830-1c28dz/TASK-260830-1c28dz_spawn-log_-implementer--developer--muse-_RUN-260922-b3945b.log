074c8009b04ae TASK-260830-35urbp: TASK-260830-35urbp: implement-private-tmux-server-management\\n===\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"OUTCOME-keyed base-vs-candidate comparison for go test -json streams.\\n\\nKeys final per-test outcomes by full test name (subtests included as\\nParent/Child). Reports: base PASS retained, regressions (base PASS that\\nis missing/failed/skipped in candidate), and new candidate tests.\\nExit 1 on any regression.\\n\\\"\\\"\\\"\\nimport json\\nimport sys\\n\\n\\ndef outcomes(path):\\n    out = {}\\n    with open(path) as f:\\n        for line in f:\\n            line = line.strip()\\n            if not line.startswith(\\\"{\\\"):\\n                continue\\n            try:\\n                ev = json.loads(line)\\n            except ValueError:\\n                continue\\n            if ev.get(\\\"Action\\\") in (\\\"pass\\\", \\\"fail\\\", \\\"skip\\\") and ev.get(\\\"Test\\\"):\\n                out[ev[\\\"Test\\\"]] = ev[\\\"Action\\\"]\\n    return out\\n\\n\\ndef main(base_path, cand_path):\\n    base = outcomes(base_path)\\n    cand = outcomes(cand_path)\\n    base_pass = {t for t, a in base.items() if a == \\\"pass\\\"}\\n    base_nonpass = {t: a for t, a in base.items() if a != \\\"pass\\\"}\\n    regressions = {}\\n    for t in sorted(base_pass):\\n        if t not in cand:\\n            regressions[t] = \\\"MISSING in candidate\\\"\\n        elif cand[t] != \\\"pass\\\":\\n            regressions[t] = f\\\"base pass -> candidate {cand[t]}\\\"\\n    new_tests = sorted(t for t in cand if t not in base)\\n\",\n  \"original_output_bytes\": 38920,\n  \"original_output_tokens\": 9730,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
