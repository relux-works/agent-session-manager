{"schema_version":1,"id":"018f0000-0000-7000-8000-0000000116c9","stream":{"kind":"session","id":"01a0c765-6a15-7930-81af-9d81d9b3108a"},"sequence":10687,"recorded_at":1780531400021369,"record_type":"event","durability":"durable","causation_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","run_stream":{"kind":"run","id":"eb24712a-98eb-41ba-85bf-fe73b2577481"},"task_stream":{"kind":"task","id":"01a0c7cc-8a79-7523-9472-6dd293034503"},"task_id":"01a0c7cc-8a79-7523-9472-6dd293034503","event":{"kind":"output","task_id":"01a0c7cc-8a79-7523-9472-6dd293034503","chunk":"{\n  \"chunk_id\": \"exec-358-1\",\n  \"command\": \"task-board m --help 2>&1 | head -30\",\n  \"description\": \"Check mutation syntax\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Execute a write operation against the board using the DSL.\\n\\nMutations:\\n  set_status(ID, status=..., commit_ack=scope_committed?)\\n                                        Change status; acknowledge enforced done transitions\\n  normalize_legacy_status(ID, expected_raw=..., status=...)\\n                                        Repair one exact unparseable raw status (local boards)\\n  handoff(ID, role=..., status=...)     Verify checklist/outcome evidence and change status\\n  set_estimate(ID, estimate=..., ...)  Set Task/Bug story-point estimate\\n  create(type=..., name=..., ...)      Create element\\n  set_details(ID, title=..., ...)      Update README fields\\n  rename(ID, name=...)                 Rename element name/slug\\n  delete(ID)                           Delete element (destructive)\\n  assign(ID, agent=...)                Assign agent\\n  unassign(ID)                         Remove assignment\\n  link(ID, blocked_by=...)             Add dependency\\n  unlink(ID, blocked_by=...)           Remove dependency\\n  check_item(ID, item=N)              Check checklist item\\n  uncheck_item(ID, item=N)            Uncheck checklist item\\n  add_checklist_item(ID, text=...)     Add checklist item\\n  remove_checklist_item(ID, item=N)    Remove obsolete checklist item (destructive)\\n  set_notes(ID, text=..., set=bool?)   Append/set notes\\n  set_parent(ID, parent=...)           Move to new parent\\n  accept_cr(ID, revision=N, evidence=...) Record a reviewer acceptance of a Change Request revision (local board only)\\n  integrate_external(ID, evidence=...)     Close accepted empty-delta external work by evidence (local board only)\\n  withdraw_cr(ID, revision=N, reason=...) Retire an unintegrated revision (local board only)\\n  defer_cr(ID, revision=N, reason=...)    Mark an accepted revision deferred by human decision (local board only)\\n  undefer_cr(ID, revision=N)              Clear the deferral marker (local board only)\\n  add_resource(ID, name=..., content=..., type=..., description=...)\\n  update_resource(ID, name=..., content=..., type=..., description=...)\\n\",\n  \"original_output_bytes\": 2053,\n  \"original_output_tokens\": 514,\n  \"truncated\": false\n}","final_result":true}}}
