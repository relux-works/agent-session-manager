ts instead of refusing.\\\",\\\\n'\\n    \\\"    ),\\\\n\\\"\\n    \\\"    Mutant(\\\\n\\\"\\n    '        name=\\\"N-successor-supersedes\\\",\\\\n'\\n    '        path=f\\\"{PACKAGE}/successor.go\\\",\\\\n'\\n    f\\\"        find='{T}\\\\\\\"supersedes_binding_id\\\\\\\":  prior.BindingID,{N}',\\\\n\\\"\\n    f\\\"        replace='{T}\\\\\\\"supersedes_binding_id\\\\\\\":  nil,{N}',\\\\n\\\"\\n    \\\"        count=1,\\\\n\\\"\\n    '        run=\\\"TestMintSuccessorBindingSuccessesAcrossGenerations\\\",\\\\n'\\n    '        expect=\\\"KILLED\\\",\\\\n'\\n    '        note=\\\"Admits exactly the linkless successor past the supersedes arm (the link is a singleton presence: nil vs set, and the prior pins nil). Kill path: the minted successor omits its prior link.\\\",\\\\n'\\n    \\\"    ),\\\\n\\\"\\n    \\\"    Mutant(\\\\n\\\"\\n    '        name=\\\"N-successor-identity-field\\\",\\\\n'\\n    '        path=f\\\"{PACKAGE}/successor.go\\\",\\\\n'\\n    f\\\"        find='{T}identity, err := bindingIdentity(staged, \\\\\\\"binding_id\\\\\\\"){N}',\\\\n\\\"\\n    f\\\"        replace='{T}identity, err := bindingIdentity(staged, \\\\\\\"session_id\\\\\\\"){N}',\\\\n\\\"\\n    \\\"        count=1,\\\\n\\\"\\n    '        run=\\\"(TestMintSuccessorBindingSuccessesAcrossGenerations|TestMintSuccessorBindingIdentityBinds)\\\",\\\\n'\\n    '        expect=\\\"KILLED\\\",\\\\n'\\n    '        note=\\\"Admits exactly the wrong omit-field past the identity arm; the tampered-rebound parse still refuses. Kill path: the minted identity fails its own re-admission self-check.\\\",\\\\n'\\n    \\\"    ),\\\\n\\\"\\n    \\\"    Mutant(\\\\n\\\"\\n    '        name=\\\"N-successor-generation-inherit\\\",\\\\n'\\n    '        path=f\\\"{PACKAGE}/successor.go\\\",\\\\n'\\n    f\\\"        find='{T}\\\\\\\"backend_generation\\\\\\\":     generation,{N}',\\\\n\\\"\\n    f\\\"        replace='{T}\\\\\\\"backend_generation\\\\\\\":     prior.BackendGeneration,{N}',\\\\n\\\"\\n    \\\"        count=1,\\\\n\\\"\\n    '        run=\\\"(TestMintSuccessorBindingSuccessesAcrossGenerations|TestMintSuccessorBindingRefusesSameGeneration)\\\",\\\\n'\\n    '        expect=\\\"KILLED\\\",\\\\n'\\n    '        note=\\\"Admits exactly the stale generation into the successor body; the succession-contradiction arm still compares the parameter. Kill path: the minted successor names the prior generation.\\\",\\\\n'\\n    \\\"    ),\\\\n\\\"\\n)\\nanchor = '    Mutant(\\\\n        name=\\\"C-control\\\",'\\nassert s.count(anchor) == 1\\ns = s.replace(anchor, rows + anchor)\\np.write_text(s)\\nprint(\\\"appended 4 termbind rows\\\")\\nPYEOF\\npython3 -c \\\"import ast; ast.parse(open('internal/termbind/mutant_harness.py').read()); print('termbind harness parses')\\\"\",\n  \"description\": \"Add termbind mint rows\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"appended 4 termbind rows\\ntermbind harness parses\\n\",\n  \"original_output_bytes\": 49,\n  \"original_output_tokens\": 13,\n  \"truncated\": false\n}","final_result":true}}}
