{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d2c7","stream":{"kind":"session","id":"01a0c765-6a15-7930-81af-9d81d9b3108a"},"sequence":1982,"recorded_at":1780531400003959,"record_type":"event","durability":"durable","causation_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","run_stream":{"kind":"run","id":"eb24712a-98eb-41ba-85bf-fe73b2577481"},"task_stream":{"kind":"task","id":"01a0c776-1894-7030-9132-7cb986081fc1"},"task_id":"01a0c776-1894-7030-9132-7cb986081fc1","event":{"kind":"output","task_id":"01a0c776-1894-7030-9132-7cb986081fc1","chunk":"Read text file `internal/axpane/decide.go`.\n(119 line(s) above)\n120|// Closed capability names the wrapper's conditional arms evaluate.\n121|// They repeat the §4.D registry rows the backend admission proves;\n122|// the wrapper invents no capability.\n123|const (\n124|\t// credentialRealmCapability is the §4.D row a background caller\n125|\t// must hold: the exact-instance sentinel plus provider-auth\n126|\t// smoke bound to the terminal binding, provider build,\n127|\t// generation digest, OS version, and expiry.\n128|\tcredentialRealmCapability = \"credential_capable_execution_realm\"\n129|\t// headlessCreationCapability is the §4.C create-row conditional\n130|\t// a non-interactive create must hold.\n131|\theadlessCreationCapability = \"headless_creation\"\n132|)\n133|\n134|// ProviderFacts carries the probed provider build, the stored\n135|// identity, and the optional discovery proof the provider-identity\n136|// arm decides over.\n137|type ProviderFacts struct {\n138|\t// Build is the exact probed build tuple.\n139|\tBuild provhost.BuildTuple\n140|\t// Identity is the stored Provider Identity Record document.\n141|\tIdentity []byte\n142|\t// Discovery is the NativeDiscoveryProof document, meaningful\n143|\t// only when HasDiscovery is set.\n144|\tDiscovery    []byte\n145|\tHasDiscovery bool\n146|\t// DiscoveryContext binds the proof to host-side facts.\n147|\tDiscoveryContext provhost.DiscoveryContext\n148|}\n149|\n150|// SmokeFacts carries the provider-auth smoke precondition: the\n151|// stored smoke record plus the typed target-auth details the\n152|// target_auth_missing refusal carries when the smoke is required\n153|// and fails.\n154|type SmokeFacts struct {\n155|\t// Required reports that provider credentials are required, so\n156|\t// the smoke must pass (the §4.C create/restore rows).\n157|\tRequired bool\n158|\t// Record is the stored smoke record document.\n159|\tRecord []byte\n160|\t// Target carries the typed provider/build/version/generation\n161|\t// details. Every member is required when the smoke is\n162|\t// required: an empty member refuses invalid_arguments instead\n163|\t// of emitting an untyped refusal.\n164|\tTarget axerror.TargetAuth\n165|\t// MacOSVersion is recorded here because TargetAuth carries it;\n166|\t// it is the version the smoke evidence binds, not a fresh\n167|\t// observation.\n168|}\n169|\n170|// BackendFacts carries the backend identity documents the §4.B arm\n171|// decides over.\n172|type BackendFacts struct {\n173|\t// Manifest, Probe, and Evidence are the raw documents parsed by\n174|\t// the terminalbackend owner.\n175|\tManifest []byte\n176|\tProbe    []byte\n177|\tEvidence [][]byte\n178|\t// RawGeneration is the AX-known raw generation the admission\n179|\t// binds to; Verify checks evidence signatures.\n180|\tRawGeneration string\n181|\tVerify        terminalbackend.SignatureVerifier\n182|\t// Now is the admission instant for evidence liveness.\n183|\tNow time.Time\n184|}\n185|\n186|// Input is the complete Decide surface: validated configuration,\n187|// the loaded session, the local lease view, materialization and\n188|// checkpoint state, the profile chain, provider identity, backend\n189|// identity, realm readiness, and the bootstrap binding. I/O-free\n190|// callers build it by hand; Run builds it through the gates.go\n191|// adapters over the durable stores.\n192|type Input struct {\n193|\t// SessionID is the logical session under decision.\n194|\tSessionID string\n195|\t// BootstrapOperationID is the caller-stable bootstrap operation.\n196|\tBootstrapOperationID string\n197|\t// Mode selects the fencing entry and capability row.\n198|\tMode Mode\n199|\n200|\t// ConfigErr is the ValidateConfig outcome; non-nil refuses\n201|\t// invalid_config.\n202|\tConfigErr error\n203|\t// SessionKnown reports that the logical session loaded; false\n204|\t// refuses invalid_arguments.\n205|\tSessionKnown bool\n206|\n207|\t// ExistingBinding is the proven bootstrap receipt for THIS\n208|\t// (session_id, bootstrap_operation_id) pair, or nil when the\n209|\t// pair is unrecorded. A recorded pair reattaches; an\n210|\t// unrecorded pair on a bound session inside the bootstrap\n211|\t// window refuses idempotency_mismatch; an unrecorded pair\n212|\t// after the window closed installs a new receipt and\n213|\t// launches. Superseded pairs keep their receipts, so an\n214|\t// identical retry of any recorded pair replays its own\n215|\t// receipt even after later pairs superseded it.\n216|\tExistingBinding *Binding\n217|\t// SessionBound reports that the session has any recorded\n218|\t// binding (the first-binding anchor or any pair receipt).\n219|\t// Together with the window predicate it drives the\n220|\t// changed-operation arm: an unrecorded pair on a bound\n221|\t// session inside the window refuses idempotency_mismatch,\n222|\t// while an unbound session binds fresh.\n223|\tSessionBound bool\n224|\t// HasNewestCheckpoint and NewestCheckpointID carry the\n225|\t// landed chain fold's newest checkpoint (sessstate.Reduce\n226|\t// over the authoritative chain: Projection.HasCheckpoint\n227|\t// and Newest.ID from checkpoint.created, checkpointed\n228|\t// session.stopped, and session.resumed). This is the\n229|\t// authoritative \"newest checkpoint\" (§5.7\n230|\t// newest_checkpoint_id, §14.4): the window predicate,\n231|\t// checkpoint admission, and journal source binding all read\n232|\t// this fact — never the lease record's own checkpoint,\n233|\t// which is null for every epoch-1 owner. Run loads it\n234|\t// through the fold adapter; I/O-free callers supply it by\n235|\t// hand. A successor lease's Checkpoint is the handoff base\n236|\t// at takeover time and never moves, so it is never\n237|\t// compared against this fact: the fold is the sole newest\n238|\t// authority, and the only implication the winner's\n239|\t// checkpoint carries — a checkpoint-carrying winner means\n240|\t// the chain published a newest — is asserted once, directly\n241|\t// after the fencing arm.\n242|\tHasNewestCheckpoint bool\n243|\tNewestCheckpointID  string\n244|\n245|\t// Presented is the local fencing token; Observation is the\n246|\t// verified lease view, built by fencing.Observe.\n247|\tPresented   fencing.PresentedToken\n248|\tObservation fencing.Observation\n249|\n250|\t// Backend carries the §4.B identity documents.\n251|\tBackend BackendFacts\n252|\n253|\t// Journal is the loaded materialization journal; JournalOK\n254|\t// reports that the matjournal owner admitted it. When\n255|\t// MaterializationRequired is set (the after-restore step 3),\n256|\t// a local launch additionally requires the committed phase\n257|\t// sourced from the fold's newest published checkpoint. A\n258|\t// fresh launch (§13.1 steps 3-4) runs before the journal\n259|\t// commits and leaves the requirement unset.\n260|\tMaterializationRequired bool\n261|\tJournal                 matjournal.Journal\n262|\tJournalOK               bool\n263|\n264|\t// Checkpoint carries the resume checkpoint: Required when the\n265|\t// path resumes from a checkpoint, Doc with its bytes, ID with\n266|\t// the expected digest. Admission attests through the sessrepo\n267|\t// owner, requires exactly the fold's newest published\n268|\t// checkpoint, and binds the checkpoint's own session_id to\n269|\t// this session. The winning lease's handoff base is never\n270|\t// compared here: the fold is the sole newest authority.\n271|\tCheckpointRequired bool\n272|\tCheckpointDoc      []byte\n273|\tCheckpointID       string\n274|\n275|\t// ProfileRecord and ProfileEvents are the decoded session\n276|\t// surface the sessprofile reducer derives the effective pair\n277|\t// from. ProfileHeads, when non-empty, is the validated\n278|\t// checkpoint's event-head closure: resume derives from the\n279|\t// closure (DeriveForHeads), never the session head, so a\n280|\t// head-only or losing-lease change cannot become the launch\n281|\t// profile. Run loads the heads from the checkpoint actually\n282|\t// resumed — the required checkpoint when one is required,\n283|\t// else the fold's newest — never the winning lease's handoff\n284|\t// base; I/O-free callers supply them by hand.\n285|\tProfileRecord sessprofile.Record\n286|\tProfileEvents []sessprofile.Event\n287|\tProfileHeads  []string\n288|\n289|\t// Provider carries the probed build, stored identity, and\n290|\t// optional discovery proof.\n291|\tProvider ProviderFacts\n292|\n293|\t// Smoke carries the provider-auth smoke precondition.\n294|\tSmoke SmokeFacts\n295|\n296|\t// Realm carries the caller realm and broker readiness.\n297|\tRealm Realm\n298|\n299|\t// Entrypoint is the wrapper argv, checked against the §4.A\n300|\t// stable entrypoint rule.\n301|\tEntrypoint []string\n302|\n303|\t// Descriptor is the §7.A provider descriptor document the\n304|\t// wrapper supplies; HostBinding is the AX-validated host-local\n305|\t// binding it must match. Admission runs on the launch and\n306|\t// reattach paths only: parked, refused, and remote-offer\n307|\t// outcomes start no local provider.\n308|\tDescriptor  []byte\n309|\tHostBinding terminalbackend.InstanceBinding\n310|\n311|\t// RemoteInteractive reports that the remote owner holds the\n312|\t// session in an interactive terminal (after-restore step 4).\n313|\tRemoteInteractive bool\n314|\n315|\t// Interactive reports that the local pane runs in an\n316|\t// interactive terminal. A non-interactive create must hold the\n317|\t// headless_creation conditional (§4.C create row); the field\n318|\t// selects that arm and shapes the supplied descriptor.\n319|\tInteractive bool\n320|}\n321|\n322|// Decision is the one outcome Decide returns.\n323|type Decision struct {\n324|\t// Action is the outcome.\n325|\tAction Action\n326|\t// ParkReason and WinningLeaseID carry the session.parked\n327|\t// vocabulary when Action is parked. The lease ID is empty when\n328|\t// no winner is established.\n329|\tParkReason     fencing.ParkReason\n330|\tWinningLeaseID string\n331|\t// Class is the Section 15 refusal code when Action is refused.\n332|\tClass string\n333|\t// Detail is the static refusal or park detail. It carries\n334|\t// member names and the landed cause, never credentials,\n335|\t// generations, or native references.\n336|\tDetail string\n337|\t// Cause is the underlying landed error.\n338|\tCause error\n339|\t// Token is the sealed fencing token the passed gate minted,\n340|\t// set on launch and reattach only. The provider receives it\n341|\t// separately from the descriptor (§7.A).\n342|\tToken fencing.LeaseToken\n343|\t// HasToken reports that Token is minted. The zero token never\n344|\t// authorizes: decisions without a passed gate carry none.\n345|\tHasToken bool\n346|\t// Profile is the effective persisted pair the launch carries.\n347|\tProfile sessprofile.Pair\n348|\t// Mapping is the resolved provider adapter flag (empty for\n349|\t// standard).\n350|\tMapping string\n351|\t// Admitted is the reconciled backend capability set.\n352|\tAdmitted terminalbackend.Admitted\n353|\t// Descriptor is the admitted §7.A provider descriptor, set on\n354|\t// launch and reattach only. On reattach the recorded Binding\n355|\t// terminal instance ID is authoritative: the descriptor names the\n356|\t// request's own freshly minted instance, never the recorded child,\n357|\t// so no caller may target the descriptor instance on reattach.\n358|\tDescriptor terminalbackend.ProviderDescriptor\n359|\t// RealmFailure is the composed typed Structured Error for the\n360|\t// capability_unavailable and target_auth_missing refusals.\n361|\tRealmFailure *axerror.Error\n362|}\n363|\n364|func refused(class, detail string, cause error) Decision {\n365|\treturn Decision{Action: ActionRefused, Class: class, Detail: detail, Cause: cause}\n366|}\n367|\n368|func parked(reason fencing.ParkReason, winningLeaseID string, cause error) Decision {\n369|\treturn Decision{\n(more lines below)","final_result":true}}}
