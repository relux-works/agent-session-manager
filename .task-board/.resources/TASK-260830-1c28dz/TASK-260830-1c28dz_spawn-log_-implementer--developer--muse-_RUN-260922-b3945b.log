{"schema_version":1,"id":"018f0000-0000-7000-8000-000000010361","stream":{"kind":"session","id":"01a0c765-6a15-7930-81af-9d81d9b3108a"},"sequence":8203,"recorded_at":1780531400016401,"record_type":"event","durability":"durable","causation_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","run_stream":{"kind":"run","id":"eb24712a-98eb-41ba-85bf-fe73b2577481"},"task_stream":{"kind":"task","id":"01a0c7b5-58cf-7e12-b53d-5d25e43d7a3f"},"task_id":"01a0c7b5-58cf-7e12-b53d-5d25e43d7a3f","event":{"kind":"output","task_id":"01a0c7b5-58cf-7e12-b53d-5d25e43d7a3f","chunk":"Read text file `internal/tmuxserver/lifecycle.go`.\n(139 line(s) above)\n140|\tQuiescenceGeneration   string\n141|\tInputClosedAt          string\n142|\tSafeBoundaryEvidenceID string\n143|\tBoundaryObservedAt     string\n144|}\n145|\n146|// Execute runs one lifecycle operation to its outcome. Refusals\n147|// precede side effects: malformed operations, unknown backends, and\n148|// unsafe sockets refuse before any store or tmux interaction. The\n149|// socket custody (before-connect rejection) and length refusal run on\n150|// every operation, because every operation connects.\n151|func (lc *Lifecycle) Execute(ctx context.Context, req OpRequest) (OpOutcome, error) {\n152|\tempty := OpOutcome{}\n153|\tif lc == nil || lc.Runner == nil || lc.Receipts == nil || lc.Bindings == nil ||\n154|\t\tlc.Attach == nil || lc.States == nil ||\n155|\t\tlc.CurrentLease == nil || lc.CurrentGeneration == nil || lc.Now == nil {\n156|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle dependencies\"}\n157|\t}\n158|\toperation, err := terminalbackend.ParseOperation(req.Operation)\n159|\tif err != nil {\n160|\t\treturn empty, err\n161|\t}\n162|\tif _, err := DirectivesFor(operation); err != nil {\n163|\t\treturn empty, err\n164|\t}\n165|\tsocket := SocketPath(lc.RuntimeDir)\n166|\tif err := CheckSocketLength(socket, lc.Platform); err != nil {\n167|\t\treturn empty, err\n168|\t}\n169|\tif err := CheckSocketCustody(socket, lc.Root, lc.Platform); err != nil {\n170|\t\treturn empty, err\n171|\t}\n172|\tswitch operation {\n173|\tcase terminalbackend.OperationCreate:\n174|\t\treturn lc.executeCreate(ctx, req, socket)\n175|\tcase terminalbackend.OperationAttach:\n176|\t\treturn lc.executeAttach(ctx, req, socket)\n177|\tcase terminalbackend.OperationStatus:\n178|\t\treturn lc.executeStatus(ctx, req, socket)\n179|\tcase terminalbackend.OperationQuiesceInput:\n(more lines below)","final_result":true}}}
