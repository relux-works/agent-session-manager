{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000deef","stream":{"kind":"session","id":"01a0c765-6a15-7930-81af-9d81d9b3108a"},"sequence":3538,"recorded_at":1780531400007071,"record_type":"event","durability":"durable","causation_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","run_stream":{"kind":"run","id":"eb24712a-98eb-41ba-85bf-fe73b2577481"},"task_stream":{"kind":"task","id":"01a0c785-5a39-77c1-a90d-173998c28f31"},"task_id":"01a0c785-5a39-77c1-a90d-173998c28f31","event":{"kind":"output","task_id":"01a0c785-5a39-77c1-a90d-173998c28f31","chunk":"edited\nchanged lines: lines 96-141\n--- original\n+++ updated\n@@\n-// After-restore branch actions: the §4.2 steps 3-5 outcome the\n-// restore entry reports alongside the parked wire result.\n-const (\n-\t// AfterRestoreResumed reports a local resume: the local host\n-\t// holds the winning lease and the materialization is valid.\n-\tAfterRestoreResumed = \"resumed_locally\"\n-\t// AfterRestoreRemoteOffer reports a remote offer: another host\n-\t// owns the session and the restore runs in an interactive\n-\t// terminal.\n-\tAfterRestoreRemoteOffer = \"remote_offered\"\n-\t// AfterRestoreParked reports parked: every other case, with no\n-\t// provider launched.\n-\tAfterRestoreParked = \"parked\"\n-)\n-\n-// AfterRestoreOutcome is the restore entry's §4.2 branch report: the\n-// winning lease the branch decided over, whether the mesh refresh\n-// was attempted, the measured refresh bound in milliseconds, and the\n-// action. The backend never launches a provider on any branch — the\n-// wrapper owns launch gating through its own decision — so this\n-// report steers the caller, never a local provider.\n-type AfterRestoreOutcome struct {\n-\tAction           string\n-\tWinnerLeaseID    string\n-\tWinnerHostID     string\n-\tRefreshAttempted bool\n-\tRefreshBoundMs   uint64\n-}\n-\n-// OpRequest is one lifecycle operation request: the operation name,\n-// its closed body, the presented source state, the admitted\n-// capabilities, the fencing material (for terminate-stale only), and\n-// the interactive flag (for restore only: whether the restore runs in\n-// an interactive terminal, which selects the remote-offer branch).\n-type OpRequest struct {\n-\tOperation            string\n-\tBody                 []byte\n-\tSource               string\n-\tAdmitted             terminalbackend.Admitted\n-\tPresented            fencing.PresentedToken\n-\tWinner               sessrepo.LeaseSummary\n-\tHasWinner            bool\n-\tForceRecovery        bool\n-\tDiagnosticsPreserved bool\n-\tInteractive          bool\n-}\n+// OpRequest is one lifecycle operation request: the operation name,\n+// its closed body, the presented source state, the admitted\n+// capabilities, and the fencing material (for terminate-stale only).\n+type OpRequest struct {\n+\tOperation            string\n+\tBody                 []byte\n+\tSource               string\n+\tAdmitted             terminalbackend.Admitted\n+\tPresented            fencing.PresentedToken\n+\tWinner               sessrepo.LeaseSummary\n+\tHasWinner            bool\n+\tForceRecovery        bool\n+\tDiagnosticsPreserved bool\n+}\n","final_result":true}}}
