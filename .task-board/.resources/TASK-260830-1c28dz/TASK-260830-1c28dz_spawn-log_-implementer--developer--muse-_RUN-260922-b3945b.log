{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d635","stream":{"kind":"session","id":"01a0c765-6a15-7930-81af-9d81d9b3108a"},"sequence":2421,"recorded_at":1780531400004837,"record_type":"event","durability":"durable","causation_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","run_stream":{"kind":"run","id":"eb24712a-98eb-41ba-85bf-fe73b2577481"},"task_stream":{"kind":"task","id":"01a0c77a-aacd-71d1-ac8d-a0457aa4f469"},"task_id":"01a0c77a-aacd-71d1-ac8d-a0457aa4f469","event":{"kind":"output","task_id":"01a0c77a-aacd-71d1-ac8d-a0457aa4f469","chunk":"Read text file `internal/axpane/run.go`.\n1|package axpane\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/config\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n11|)\n12|\n13|// Request is the complete Run surface: the session and bootstrap\n14|// operation under decision plus every modeled-caller fact the\n15|// adapters cannot load from the durable stores (sync state,\n16|// provider build and identity, backend documents, realm readiness,\n17|// presentation geometry). The stores supply configuration,\n18|// sessions, leases, journals, checkpoints, and bindings.\n19|type Request struct {\n20|\tSessionID            string\n21|\tBootstrapOperationID string\n22|\tMode                 Mode\n23|\n24|\tConfigInputs    config.Inputs\n25|\tConfigOverrides config.Overrides\n26|\n27|\t// Presented is the local fencing token; Observe carries the\n28|\t// caller-reported sync, handoff, grant, and clock facts.\n29|\tPresented fencing.PresentedToken\n30|\tObserve   fencing.ObserveInput\n31|\n32|\t// Materialization selects the required journal: when Required\n33|\t// is set the adapter loads ID and the decision requires the\n34|\t// committed phase (after-restore step 3).\n35|\tMaterializationID       string\n36|\tMaterializationRequired bool\n37|\n38|\t// Checkpoint selects the resume checkpoint: when Required is\n39|\t// set the adapter loads ID and the decision admits it.\n40|\tCheckpointID       string\n41|\tCheckpointRequired bool\n42|\n43|\tProvider ProviderFacts\n44|\tSmoke    SmokeFacts\n45|\tRealm    Realm\n46|\tBackend  BackendFacts\n47|\n48|\t// Entrypoint is the wrapper argv.\n49|\tEntrypoint []string\n50|\n51|\t// HostBinding is the AX-validated host-local binding subset\n52|\t// the supplied descriptor must match. Geometry and\n53|\t// interactivity shape the supplied descriptor; InstanceID\n54|\t// pins the terminal instance, or mints a fresh UUIDv7 when\n55|\t// empty.\n56|\tHostBinding terminalbackend.InstanceBinding\n57|\tInteractive bool\n58|\tColumns     uint16\n59|\tRows        uint16\n60|\tInstanceID  string\n61|\n62|\t// RemoteInteractive reports that the remote owner holds the\n63|\t// session in an interactive terminal (after-restore step 4).\n64|\tRemoteInteractive bool\n65|\n66|\t// LocalHostID authors parked events; CreatedAt stamps them.\n67|\tLocalHostID string\n68|\tCreatedAt   string\n69|\n70|\t// Hooks arms the bootstrap binding crash boundaries.\n71|\tHooks *Hooks\n72|}\n73|\n74|// Outcome is the one Run result: the decision plus the durable\n75|// effects it authorized. Exactly one effect applies: a launch binds\n76|// the bootstrap pair (superseding after the window closed), a\n77|// reattach returns the recorded binding, a parked or remote-offer\n78|// decision with a locally held, verified winner and a foldable\n79|// lifecycle authors the parked event, and every other outcome\n80|// writes nothing.\n81|type Outcome struct {\n82|\tDecision Decision\n83|\t// Binding is the bound receipt on launch and the recorded\n84|\t// receipt on reattach, nil otherwise.\n85|\tBinding *Binding\n86|\t// Event is the authored parked event reference and bytes;\n87|\t// Emitted is false when the decision parks without a locally\n88|\t// held winner, without a foldable lifecycle, or when the\n89|\t// outcome is neither parked nor a remote offer. A park without\n90|\t// chain authority parks without evidence, never by manufacturing\n91|\t// a sequence collision under another host's lease.\n92|\tEvent     *sessrepo.EventRef\n93|\tEventJSON []byte\n94|\tEmitted   bool\n95|}\n96|\n97|// Run orchestrates the wrapper: validate configuration, load the\n98|// logical session, derive the fold's newest checkpoint, prove the\n99|// bootstrap binding state, observe the winning lease, load\n100|// materialization, checkpoint, and profile state, decide through\n101|// the pure core, then apply exactly the authorized durable\n102|// effect. A store failure propagates as an error with no decision:\n103|// unknown is never absence and never a launch.\n104|func Run(stores Stores, request Request) (Outcome, error) {\n105|\tempty := Outcome{}\n106|\tif stores.Repo == nil || stores.Pane == nil {\n107|\t\treturn empty, fmt.Errorf(\"axpane run carries no repository or binding store\")\n108|\t}\n109|\t// The request hooks arm a copy of the binding handle: Run never\n110|\t// mutates the caller's store.\n111|\tpane := *stores.Pane\n112|\tpaneStore := pane.WithHooks(request.Hooks)\n113|\tinput := Input{\n114|\t\tSessionID:               request.SessionID,\n115|\t\tBootstrapOperationID:    request.BootstrapOperationID,\n116|\t\tMode:                    request.Mode,\n117|\t\tPresented:               request.Presented,\n118|\t\tProvider:                request.Provider,\n119|\t\tSmoke:                   request.Smoke,\n120|\t\tRealm:                   request.Realm,\n121|\t\tBackend:                 request.Backend,\n122|\t\tEntrypoint:              request.Entrypoint,\n123|\t\tHostBinding:             request.HostBinding,\n124|\t\tRemoteInteractive:       request.RemoteInteractive,\n125|\t\tInteractive:             request.Interactive,\n126|\t\tCheckpointRequired:      request.CheckpointRequired,\n127|\t\tCheckpointID:            request.CheckpointID,\n128|\t\tMaterializationRequired: request.MaterializationRequired,\n129|\t}\n130|\tinput.ConfigErr = ValidateConfig(request.ConfigInputs, request.ConfigOverrides)\n131|\n132|\tknown, _, err := LoadSession(stores.Repo, request.SessionID)\n133|\tif err != nil {\n134|\t\treturn empty, err\n135|\t}\n136|\tinput.SessionKnown = known\n137|\n138|\tpair, pairFound, err := paneStore.Lookup(request.SessionID, request.BootstrapOperationID)\n139|\tif err != nil {\n140|\t\treturn empty, err\n141|\t}\n142|\tif pairFound {\n143|\t\tduplicate := pair\n144|\t\tinput.ExistingBinding = &duplicate\n145|\t}\n146|\tbound, err := paneStore.SessionBound(request.SessionID)\n147|\tif err != nil {\n148|\t\treturn empty, err\n149|\t}\n150|\tinput.SessionBound = bound\n151|\n152|\tif known {\n153|\t\thas, newest, err := LoadNewestCheckpoint(stores.Repo, request.SessionID)\n154|\t\tif err != nil {\n155|\t\t\treturn empty, err\n156|\t\t}\n157|\t\tinput.HasNewestCheckpoint = has\n158|\t\tinput.NewestCheckpointID = newest\n159|\t}\n160|\n161|\tvar observation fencing.Observation\n162|\tif known {\n163|\t\tobserved, err := ObserveOwnership(stores.Repo, request.SessionID, request.Observe)\n164|\t\tif err != nil {\n165|\t\t\treturn empty, err\n166|\t\t}\n167|\t\tobservation = observed\n168|\t}\n169|\tinput.Observation = observation\n170|\n171|\t// The fold's newest checkpoint drives the resume profile\n172|\t// closure, so a published newest with no checkpoint store\n173|\t// bound is unknown, not \"no closure\": deriving from the\n174|\t// session head instead would silently promote a head-only\n175|\t// change to the launch profile. Fail the run. (A required\n176|\t// checkpoint with no store fails at its own load below; a\n177|\t// null fold needs no store at all.)\n178|\tif known && input.HasNewestCheckpoint && stores.Ckpt == nil {\n179|\t\treturn empty, fmt.Errorf(\"axpane run requires the newest checkpoint closure with no checkpoint store\")\n180|\t}\n(more lines below)","final_result":true}}}
