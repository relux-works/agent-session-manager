{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d2f1","stream":{"kind":"session","id":"01a0c765-6a15-7930-81af-9d81d9b3108a"},"sequence":2003,"recorded_at":1780531400004001,"record_type":"event","durability":"durable","causation_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","run_stream":{"kind":"run","id":"eb24712a-98eb-41ba-85bf-fe73b2577481"},"task_stream":{"kind":"task","id":"01a0c776-221e-7740-97b8-a5bc66990e07"},"task_id":"01a0c776-221e-7740-97b8-a5bc66990e07","event":{"kind":"output","task_id":"01a0c776-221e-7740-97b8-a5bc66990e07","chunk":"Read text file `internal/axpane/decide.go`.\n(368 line(s) above)\n369|\treturn Decision{\n370|\t\tAction:         ActionParked,\n371|\t\tParkReason:     reason,\n372|\t\tWinningLeaseID: winningLeaseID,\n373|\t\tDetail:         \"park (\" + string(reason) + \") without launching the provider\",\n374|\t\tCause:          cause,\n375|\t}\n376|}\n377|\n378|// Decide is the pure wrapper core: configuration, session, bootstrap\n379|// idempotency with the window predicate, backend identity and\n380|// capability admission with the §4.C conditionals, fencing, the\n381|// successor-lease null-fold arm, materialization with the\n382|// fold-newest source binding, checkpoint admission bound to the\n383|// fold newest and session, provider identity, provider-auth smoke\n384|// with the target binding, realm evidence, profile derivation from\n385|// the checkpoint closure on resume and mapping, entrypoint, and\n386|// provider descriptor, in that precedence, then the outcome\n387|// selection. Fencing precedes materialization: a remote owner\n388|// offers attach/takeover even when the local materialization is\n389|// stale (the after-restore order). The tuple gate precedes mapping\n390|// so a tuple refusal keeps its own class instead of wearing\n391|// profile_mapping_unavailable. Decide performs no I/O, reads no\n392|// clock except the instants the input carries, and mints no lease,\n393|// binding, or event: Run owns the durable effects. Every refusal\n394|// carries the Section 15 code the arm names; every park carries\n395|// the session.parked vocabulary.\n396|func Decide(input Input) Decision {\n397|\tif input.ConfigErr != nil {\n398|\t\treturn refused(ClassInvalidConfig, \"configuration is invalid\", input.ConfigErr)\n399|\t}\n400|\tif input.Mode != ModeLaunch && input.Mode != ModeRestore {\n401|\t\treturn refused(ClassInvalidArguments, \"wrapper mode is not launch or restore\", errWrapperMode(input.Mode))\n402|\t}\n403|\tif !input.SessionKnown {\n404|\t\treturn refused(ClassInvalidArguments, \"logical session is unknown\", errUnknownSession(input.SessionID))\n405|\t}\n406|\tif (input.ExistingBinding == nil || input.ExistingBinding.OperationID != input.BootstrapOperationID) && input.SessionBound && !bootstrapWindowClosed(input) {\n407|\t\treturn refused(terminalbackend.CodeIdempotencyMismatch,\n408|\t\t\t\"bootstrap operation changed inside the bootstrap window\",\n409|\t\t\terrIdempotencyChanged(input.SessionID))\n410|\t}\n411|\tif err := checkRealmVocabulary(input.Realm.Caller); err != nil {\n412|\t\treturn refused(ClassInvalidArguments, \"caller realm is not foreground or background\", err)\n413|\t}\n414|\n415|\tadmitted, evidence, err := admitBackend(input)\n416|\tif err != nil {\n417|\t\tvar malformed errInvalidArguments\n418|\t\tif errors.As(err, &malformed) {\n419|\t\t\treturn refused(ClassInvalidArguments, \"caller realm details are incomplete\", err)\n420|\t\t}\n421|\t\tvar typed *axerror.Error\n422|\t\tif errors.As(err, &typed) {\n423|\t\t\tdecision := refused(string(typed.Code()), \"caller has no usable realm evidence\", err)\n424|\t\t\tdecision.RealmFailure = typed\n425|\t\t\treturn decision\n426|\t\t}\n427|\t\treturn refused(backendClass(err), \"terminal backend identity or capability admission failed\", err)\n428|\t}\n429|\tif input.Mode == ModeLaunch && !input.Interactive && !admitted.Has(headlessCreationCapability) {\n430|\t\treturn refused(terminalbackend.CodeCapabilityUnproven,\n431|\t\t\t\"non-interactive create requires headless_creation\",\n432|\t\t\terrHeadlessRequired())\n433|\t}\n434|\n435|\ttoken, err := authorize(input)\n436|\tif err != nil {\n437|\t\tif fencing.IsParked(err) {\n438|\t\t\treason, winning, _ := fencing.ParkDetails(err)\n439|\t\t\treturn decideParked(input, admitted, reason, winning, err)\n440|\t\t}\n441|\t\treturn refused(fencingClass(err), \"fencing refused the wrapper\", err)\n442|\t}\n443|\n444|\t// A checkpoint-carrying winner implies the fold has a\n445|\t// published newest: the successor lease's checkpoint is the\n446|\t// handoff base at takeover time and never moves, while every\n447|\t// checkpoint the successor owner publishes afterwards lands\n448|\t// on the chain — so the fold is the sole newest authority\n449|\t// and this implication is the only fact the lease's base\n450|\t// asserts, at this one site every launch-class path passes\n451|\t// (launch and restore alike, with or without a required\n452|\t// checkpoint or journal). A checkpoint-carrying winner over\n453|\t// a null fold parks: the chain is behind the lease in a way\n454|\t// no local launch may paper over. Nothing else about the\n455|\t// base is asserted here — binding the base to a checkpoint\n456|\t// the chain published is the takeover leaf's obligation\n457|\t// (stated bound).\n458|\tif input.Observation.HasWinner && input.Observation.Winner.HasCheckpoint && !input.HasNewestCheckpoint {\n459|\t\treturn parked(fencing.ParkRestorePolicy, input.Observation.Winner.LeaseID, errSuccessorNullFold())\n460|\t}\n461|\n462|\tif input.MaterializationRequired {\n463|\t\tif err := checkMaterialization(input); err != nil {\n464|\t\t\treturn parked(fencing.ParkRestorePolicy, input.Observation.Winner.LeaseID, err)\n465|\t\t}\n466|\t}\n467|\tif input.CheckpointRequired {\n468|\t\tif _, err := admitCheckpoint(input); err != nil {\n469|\t\t\treturn parked(fencing.ParkRestorePolicy, input.Observation.Winner.LeaseID, err)\n470|\t\t}\n471|\t}\n472|\n473|\tif err := checkProviderIdentity(input.Provider, input.SessionID); err != nil {\n474|\t\treturn refused(providerClass(err), \"provider identity is unresolved\", err)\n475|\t}\n476|\tif err := checkSmoke(input); err != nil {\n477|\t\tdecision := refused(smokeClass(err), \"provider-auth smoke precondition failed\", err)\n478|\t\tvar typed *axerror.Error\n479|\t\tif errors.As(err, &typed) {\n480|\t\t\tdecision.RealmFailure = typed\n481|\t\t}\n482|\t\treturn decision\n483|\t}\n484|\tif err := checkRealm(input, admitted, evidence); err != nil {\n485|\t\tvar malformed errInvalidArguments\n486|\t\tif errors.As(err, &malformed) {\n487|\t\t\treturn refused(ClassInvalidArguments, \"caller realm details are incomplete\", err)\n488|\t\t}\n489|\t\tvar typed *axerror.Error\n490|\t\tif errors.As(err, &typed) {\n491|\t\t\tdecision := refused(string(typed.Code()), \"caller has no admitted realm evidence\", err)\n492|\t\t\tdecision.RealmFailure = typed\n493|\t\t\treturn decision\n494|\t\t}\n495|\t\treturn refused(ClassInvalidArguments, \"caller realm is unverifiable\", err)\n496|\t}\n497|\tpair, err := deriveProfile(input)\n498|\tif err != nil {\n499|\t\treturn refused(ClassIntegrityFailure, \"effective profile derivation failed\", err)\n500|\t}\n501|\t// The tuple gate above already admitted the probed build, so a\n502|\t// ResolveMapping failure here is the mapping gap Section 2.4\n503|\t// names, never a tuple refusal wearing the mapping class.\n504|\tresolved, err := provhost.ResolveMapping(input.Provider.Build.ProviderID, pair.Profile, input.Provider.Build)\n505|\tif err != nil {\n506|\t\treturn refused(ClassProfileMappingUnavailable, \"adapter cannot map the stored profile\", err)\n507|\t}\n508|\tif err := terminalbackend.CheckEntrypoint(input.Entrypoint, input.SessionID); err != nil {\n509|\t\treturn refused(backendClass(err), \"stable entrypoint is not ax pane SESSION_ID\", err)\n510|\t}\n511|\n512|\tdecision := Decision{\n513|\t\tAction:   ActionLaunch,\n514|\t\tToken:    token,\n515|\t\tHasToken: true,\n516|\t\tProfile:  pair,\n517|\t\tMapping:  resolved.Mapping,\n518|\t\tAdmitted: admitted,\n(more lines below)","final_result":true}}}
