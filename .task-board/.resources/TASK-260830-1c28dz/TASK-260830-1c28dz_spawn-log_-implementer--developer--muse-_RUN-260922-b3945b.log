{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d925","stream":{"kind":"session","id":"01a0c765-6a15-7930-81af-9d81d9b3108a"},"sequence":2797,"recorded_at":1780531400005589,"record_type":"event","durability":"durable","causation_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","run_stream":{"kind":"run","id":"eb24712a-98eb-41ba-85bf-fe73b2577481"},"task_stream":{"kind":"task","id":"01a0c77f-2016-70f0-a00e-3803c58c041b"},"task_id":"01a0c77f-2016-70f0-a00e-3803c58c041b","event":{"kind":"output","task_id":"01a0c77f-2016-70f0-a00e-3803c58c041b","chunk":"Read text file `internal/tmuxserver/bind.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"os\"\n5|\t\"path/filepath\"\n6|\t\"strings\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n10|)\n11|\n12|// Unix socket path limits: sun_path byte size including the trailing\n13|// NUL, per platform. macOS (darwin) allows 104 bytes; Linux and WSL2\n14|// allow 108. A derived socket at or beyond the limit can never bind or\n15|// connect, so the adapter refuses it before exec rather than surfacing\n16|// a spawn failure.\n17|const (\n18|\tsunPathLimitDarwin = 104\n19|\tsunPathLimitLinux  = 108\n20|)\n21|\n22|// CheckSocketLength refuses a derived socket path that cannot fit the\n23|// platform sun_path (bound B18, decided here): the byte length must\n24|// stay strictly below the platform limit, leaving room for the NUL.\n25|// The check runs on every bind and every connect, before any custody\n26|// or exec work, so a deep runtime root reports the length refusal, not\n27|// a spawn failure. Native Windows refuses upstream: no tmux socket\n28|// exists there.\n29|func CheckSocketLength(socket string, platform scalar.Platform) error {\n30|\tlimit := sunPathLimitLinux\n31|\tif platform == scalar.PlatformMacOS {\n32|\t\tlimit = sunPathLimitDarwin\n33|\t}\n34|\tif len(socket) >= limit {\n35|\t\treturn &Error{Code: CodeSocketPathTooLong, Detail: \"socket path length\"}\n36|\t}\n37|\treturn nil\n38|}\n39|\n40|// CheckSocketCustody enforces the SPEC 810-812 before-bind/connect\n41|// rejection (bounds B19/B20, decided here): before bind, connect,\n42|// rename, or unlink, AX rejects a socket path, parent, or ancestor\n43|// whose file kind, ownership, or permissions are unsafe. It answers\n44|// for one derived socket under one Runtime IPC root:\n45|//\n46|//   - the socket must name the runtime leaf exactly (<root>/tmux/ax.sock):\n47|//     a socket elsewhere is a substitution and refuses;\n48|//   - the runtime leaf must pass the landed leaf custody (mode,\n49|//     ownership, kind, containment via VerifyRuntimeDir);\n50|//   - the root itself must be an euid-owned directory, never a\n51|//     symlink, never group/world-writable unless sticky;\n52|//   - every ancestor above the root up to / must be a directory,\n53|//     never a symlink, never group/world-writable unless sticky\n54|//     (ownership is not required above the root: system prefixes are\n55|//     root-owned by design, e.g. 0755 /var or sticky 1777 /tmp);\n56|//   - the socket path itself, when present, must be a socket: the\n57|//     adapter unlinks a stale socket before bind and must never unlink\n58|//     any other kind. Absence is bindable.\n59|//\n60|// The root and every ancestor open through the landed no-follow\n61|// owner and verify through the open descriptor; a symlink at any\n62|// level refuses, and the root handle is bound back to its path. A\n63|// residual TOCTOU (rename between check and bind) stays a stated\n64|// bound: post-spawn the adapter probes the bound socket and the\n65|// generation-bound admission refuses a swapped server, so a race\n66|// fails into attestation, never into use.\n67|func CheckSocketCustody(socket, root string, platform scalar.Platform) error {\n68|\tif socket != filepath.Join(root, RuntimeDirName, SocketName) {\n69|\t\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket placement\"}\n70|\t}\n71|\tif err := VerifyRuntimeDir(root, RuntimeDirName, platform); err != nil {\n72|\t\treturn err\n73|\t}\n74|\tif err := checkCustodyRoot(root); err != nil {\n75|\t\treturn err\n76|\t}\n77|\tif err := checkCustodyAncestors(root); err != nil {\n78|\t\treturn err\n79|\t}\n80|\treturn checkCustodySocket(socket)\n81|}\n82|\n83|// checkCustodyRoot gates the Runtime IPC root itself: an euid-owned\n84|// directory, never a symlink, never writable by group or other unless\n85|// the sticky bit civilizes the write (a 0777 root refuses here — the\n86|// hole the first leaf left for this bind step). The directory is\n87|// opened through the landed no-follow owner and verified through the\n88|// open descriptor, then bound to the path: the descriptor and a fresh\n89|// lstat must name the same directory, so a swap between open and use\n90|// refuses instead of verifying one directory and using another.\n91|func checkCustodyRoot(root string) error {\n92|\tdir, err := secprim.OpenNoFollowDir(root)\n93|\tif err != nil {\n94|\t\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket root\"}\n95|\t}\n96|\tdefer func() { _ = dir.Close() }()\n97|\tinfo, err := dir.Stat()\n98|\tif err != nil || !info.IsDir() {\n99|\t\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket root\"}\n100|\t}\n101|\tif !ownershipMatches(info) {\n102|\t\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket root\"}\n103|\t}\n104|\tif writableByOthers(info) {\n105|\t\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket root\"}\n106|\t}\n107|\tpathed, err := os.Lstat(root)\n108|\tif err != nil || !sameCustodyIdentity(info, pathed) {\n109|\t\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket root\"}\n110|\t}\n111|\treturn nil\n112|}\n113|\n114|// sameCustodyIdentity reports whether two stat results name the same\n115|// filesystem object. It is a variable only so seam-failure tests can\n116|// force the identity-mismatch path through the production entry: a\n117|// swap between open and stat cannot be staged deterministically, and\n118|// without the seam the mismatch branch is untestable. Production code\n119|// never reassigns it.\n120|var sameCustodyIdentity = os.SameFile\n121|\n122|// checkCustodyAncestors walks every ancestor above the root up to the\n123|// filesystem root: each must be a directory, never a symlink, and\n124|// never writable by group or other unless sticky. Ownership is not\n125|// decided above the root: system prefixes are root-owned by design.\n126|//\n127|// The walk climbs the LEXICAL path and opens every ancestor through\n128|// the landed no-follow owner: a symlink at any level — including an\n129|// intermediate alias above an otherwise valid root — refuses, because\n130|// writes through an alias land outside the verified tree. The walk\n131|// never resolves: resolving first would verify one path and use\n132|// another. Callers pass a canonical root (the runtime-root owner\n133|// canonicalizes at creation); system-conventional symlinks such as\n134|// macOS /tmp are resolved by the caller, never excused here.\n135|func checkCustodyAncestors(root string) error {\n136|\tcleaned := filepath.Clean(root)\n137|\tfor {\n138|\t\tparent := filepath.Dir(cleaned)\n139|\t\tif parent == cleaned {\n140|\t\t\treturn nil\n141|\t\t}\n142|\t\tdir, err := secprim.OpenNoFollowDir(parent)\n143|\t\tif err != nil {\n144|\t\t\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket ancestor\"}\n145|\t\t}\n146|\t\tinfo, statErr := dir.Stat()\n147|\t\t_ = dir.Close()\n148|\t\tif statErr != nil || !info.IsDir() {\n149|\t\t\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket ancestor\"}\n150|\t\t}\n151|\t\tif writableByOthers(info) {\n152|\t\t\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket ancestor\"}\n153|\t\t}\n154|\t\tif isFilesystemRoot(parent) {\n155|\t\t\treturn nil\n156|\t\t}\n157|\t\tcleaned = parent\n158|\t}\n159|}\n160|\n161|// isFilesystemRoot reports the end of the ancestor walk: the cleaned\n162|// path is the volume root (/ on unix; a drive root on Windows, which\n163|// refuses upstream before this walk ever runs).\n164|func isFilesystemRoot(path string) bool {\n165|\treturn path == string(filepath.Separator) || strings.HasSuffix(path, \":\\\\\")\n166|}\n167|\n168|// writableByOthers reports group/world writability without the sticky\n169|// bit: sticky directories (1777 /tmp) admit group writes by design,\n170|// while a plain 0777 or 0770 admits an unsafe rename.\n171|func writableByOthers(info os.FileInfo) bool {\n172|\tperm := info.Mode().Perm()\n173|\tif perm&0o022 == 0 {\n174|\t\treturn false\n175|\t}\n176|\treturn info.Mode()&os.ModeSticky == 0\n177|}\n178|\n179|// checkCustodySocket gates the socket path itself: absence is bindable,\n180|// a socket is unlinkable-before-bind, and any other kind refuses so\n181|// the stale-unlink step can never remove a non-socket.\n182|func checkCustodySocket(socket string) error {\n183|\tinfo, err := os.Lstat(socket)\n184|\tif err != nil {\n185|\t\tif os.IsNotExist(err) {\n186|\t\t\treturn nil\n187|\t\t}\n188|\t\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket kind\"}\n189|\t}\n190|\tif info.Mode().Type() != os.ModeSocket {\n191|\t\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket kind\"}\n192|\t}\n193|\treturn nil\n194|}","final_result":true}}}
