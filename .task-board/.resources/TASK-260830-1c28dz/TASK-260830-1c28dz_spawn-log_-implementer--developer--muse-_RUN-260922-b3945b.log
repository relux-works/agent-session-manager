te.go\\\",\\n        find='\\\\tif key == \\\"\\\" {\\\\n\\\\t\\\\treturn &Error{Code: CodeInvalidArguments, Detail: \\\"instance outcome key\\\"}\\\\n\\\\t}\\\\n',\\n        replace='\\\\tif key == \\\"\\\" && outcome.Operation != \\\"\\\" {\\\\n\\\\t\\\\treturn &Error{Code: CodeInvalidArguments, Detail: \\\"instance outcome key\\\"}\\\\n\\\\t}\\\\n',\\n        count=1,\\n        run=\\\"TestInstanceStatesOutcomeRoundTrip\\\",\\n        path=f\\\"{PACKAGE}/ops.go\\\",\\n        find='\\\\tif err := lc.States.RecordBindingDoc(mctx.SessionID, body.BootstrapOperationID, raw); err != nil {\\\\n\\\\t\\\\treturn nil, &Error{Code: terminstance.CodeProcessFailed, Detail: \\\"backend binding write\\\"}\\\\n\\\\t}\\\\n',\\n        replace='\\\\tif mctx.BackendGeneration != \\\"generation-after-reboot\\\" {\\\\n\\\\t\\\\tif err := lc.States.RecordBindingDoc(mctx.SessionID, body.BootstrapOperationID, raw); err != nil {\\\\n\\\\t\\\\t\\\\treturn nil, &Error{Code: terminstance.CodeProcessFailed, Detail: \\\"backend binding write\\\"}\\\\n\\\\t\\\\t}\\\\n\\\\t}\\\\n',\\n        count=1,\\n        run=\\\"TestExecuteRestoreAcrossServerGeneration\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the reboot generation past the successor persist (the minted result returns unpersisted); every other generation still persists. Kill path: the stored document is the stale prior through the restore dispatch.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-wrapper-reorder-refresh\\\",\\n        path=f\\\"{PACKAGE}/wrapper.go\\\",\\n        find='\\\\trefreshCtx, cancel := context.WithTimeout(ctx, bound)\\\\n\\\\trefreshed, err := lc.LeaseRefresh(refreshCtx, sessionID)\\\\n\\\\tcancel()\\\\n\\\\tif err != nil {\\\\n\\\\t\\\\treturn fallback, false, true, false\\\\n\\\\t}\\\\n',\\n        replace='\\\\trefreshCtx, cancel := context.WithTimeout(ctx, bound)\\\\n\\\\trefreshed, err := lc.LeaseRefresh(refreshCtx, sessionID)\\\\n\\\\tcancel()\\\\n\\\\tif err != nil || sessionID == \\\"0198f4c8-8e50-7f66-8f70-111111111111\\\" {\\\\n\\\\t\\\\treturn fallback, false, true, false\\\\n\\\\t}\\\\n',\\n        count=1,\\n        run=\\\"(TestWrapperRestoreLapsedGrantRemoteOffer|TestWrapperRestoreLocalWinResumes|TestWrapperRestoreParksWithoutEffects)\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the fixture session past the refresh-success arm into stale local knowledge; failed attempts still fall back the same way. Kill path: the offer refuses and the resume parks through the wrapper entry, while the park twins hold.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-wrapper-route-material\\\",\\n        path=f\\\"{PACKAGE}/wrapper.go\\\",\\n\",\n  \"original_output_bytes\": 3166,\n  \"original_output_tokens\": 792,\n  \"truncated\": false\n}","final_result":true}}}
