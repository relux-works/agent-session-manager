{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000de5b","stream":{"kind":"session","id":"01a0c765-6a15-7930-81af-9d81d9b3108a"},"sequence":3464,"recorded_at":1780531400006923,"record_type":"event","durability":"durable","causation_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","run_stream":{"kind":"run","id":"eb24712a-98eb-41ba-85bf-fe73b2577481"},"task_stream":{"kind":"task","id":"01a0c785-0b19-79e0-95ab-6a23ee8a2caa"},"task_id":"01a0c785-0b19-79e0-95ab-6a23ee8a2caa","event":{"kind":"output","task_id":"01a0c785-0b19-79e0-95ab-6a23ee8a2caa","chunk":"edited\nchanged lines: lines 500-561\n--- original\n+++ updated\n@@\n-// afterRestoreBranch runs the §4.2 after-restore sequence over the\n-// winning-lease view: read the latest locally known lease, attempt\n-// the mesh refresh under the measured bound, then branch. Local\n-// resume requires the local host to hold the lease the refresh (or,\n-// without one, local knowledge) names AND a valid materialization;\n-// a winner another host holds offers remote attach/takeover in an\n-// interactive terminal; every other case — including a\n-// locally-held winner under an unseen lease tuple — parks without\n-// launching a provider. The refresh is attempted, never required: a\n-// missing, failed, or timed-out attempt falls back to local\n-// knowledge.\n-func (lc *Lifecycle) afterRestoreBranch(ctx context.Context, req OpRequest, mctx terminstance.MutationContext, body RestoreBody) AfterRestoreOutcome {\n-\tlocal := lc.CurrentLease()\n-\tbound := lc.MeshRefreshTimeout\n-\tif bound <= 0 {\n-\t\tbound = DefaultMeshRefreshTimeout\n-\t}\n-\twinner := RefreshWinner{LeaseID: local.LeaseID, Epoch: local.Epoch, HolderHostID: mctx.Authorization.HolderHostID}\n-\tattempted := false\n-\tif lc.LeaseRefresh != nil {\n-\t\tattempted = true\n-\t\trefreshCtx, cancel := context.WithTimeout(ctx, bound)\n-\t\trefreshed, err := lc.LeaseRefresh(refreshCtx, mctx.SessionID)\n-\t\tcancel()\n-\t\tif err == nil {\n-\t\t\twinner = refreshed\n-\t\t}\n-\t}\n-\tlocalWins := lc.LocalHostID != \"\" &&\n-\t\twinner.HolderHostID == lc.LocalHostID &&\n-\t\twinner.LeaseID == local.LeaseID &&\n-\t\twinner.Epoch == local.Epoch\n-\t// A remote offer names another host: a winner the local host\n-\t// holds under an unseen lease tuple is not remote (local\n-\t// knowledge lags the mesh), and an unknown self proves neither\n-\t// side. Both park without launching.\n-\tremoteOwns := lc.LocalHostID != \"\" &&\n-\t\twinner.HolderHostID != \"\" &&\n-\t\twinner.HolderHostID != lc.LocalHostID\n-\tmaterial := false\n-\tif lc.Materialization != nil {\n-\t\tif valid, err := lc.Materialization(mctx.SessionID, body.CheckpointID); err == nil && valid {\n-\t\t\tmaterial = true\n-\t\t}\n-\t}\n-\taction := AfterRestoreParked\n-\tswitch {\n-\tcase localWins && material:\n-\t\taction = AfterRestoreResumed\n-\tcase !localWins && remoteOwns && req.Interactive:\n-\t\taction = AfterRestoreRemoteOffer\n-\t}\n-\treturn AfterRestoreOutcome{\n-\t\tAction:           action,\n-\t\tWinnerLeaseID:    winner.LeaseID,\n-\t\tWinnerHostID:     winner.HolderHostID,\n-\t\tRefreshAttempted: attempted,\n-\t\tRefreshBoundMs:   uint64(bound.Milliseconds()),\n-\t}\n-}\n-\n-// checkPriorBinding enforces the restore mismatch rule: the recorded\n+// checkPriorBinding enforces the restore mismatch rule: the recorded\n","final_result":true}}}
