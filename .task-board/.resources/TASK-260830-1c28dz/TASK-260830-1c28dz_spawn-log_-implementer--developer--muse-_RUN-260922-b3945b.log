149|\n150|// refreshWinner attempts the §4.2 mesh lease refresh (step 2) under\n151|// the measured bound and reports the ordered winner: the refreshed\n152|// lease verified on success, the locally known lease unverified when\n153|// the adapter is missing, fails, or times out, and the zero winner\n154|// when no lease is known at all. Only a successful refresh verifies:\n155|// local knowledge never self-verifies, so a failed attempt parks\n156|// through the landed unverified arm instead of resuming.\n157|func (lc *Lifecycle) refreshWinner(ctx context.Context, sessionID string, local terminstance.LeaseView, bound time.Duration) (sessrepo.LeaseSummary, bool, bool, bool) {\n158|\tfallback := sessrepo.LeaseSummary{\n159|\t\tSessionID:    sessionID,\n160|\t\tLeaseID:      local.LeaseID,\n161|\t\tEpoch:        local.Epoch,\n162|\t\tHolderHostID: lc.LocalHostID,\n163|\t\tReason:       \"local-knowledge\",\n164|\t}\n165|\tif lc.LeaseRefresh == nil {\n166|\t\treturn fallback, false, false, false\n167|\t}\n168|\trefreshCtx, cancel := context.WithTimeout(ctx, bound)\n169|\trefreshed, err := lc.LeaseRefresh(refreshCtx, sessionID)\n170|\tcancel()\n171|\tif err != nil {\n172|\t\treturn fallback, false, true, false\n173|\t}\n174|\treturn sessrepo.LeaseSummary{\n175|\t\tSessionID:    sessionID,\n176|\t\tLeaseID:      refreshed.LeaseID,\n177|\t\tEpoch:        refreshed.Epoch,\n178|\t\tHolderHostID: refreshed.HolderHostID,\n179|\t\tReason:       \"mesh-refresh\",\n180|\t}, true, true, true\n181|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
