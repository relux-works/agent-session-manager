{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d1ab","stream":{"kind":"session","id":"01a0c765-6a15-7930-81af-9d81d9b3108a"},"sequence":1840,"recorded_at":1780531400003675,"record_type":"event","durability":"durable","causation_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","run_stream":{"kind":"run","id":"eb24712a-98eb-41ba-85bf-fe73b2577481"},"task_stream":{"kind":"task","id":"01a0c775-422e-7b50-9dd4-569859d53c90"},"task_id":"01a0c775-422e-7b50-9dd4-569859d53c90","event":{"kind":"output","task_id":"01a0c775-422e-7b50-9dd4-569859d53c90","chunk":"Read text file `internal/tmuxserver/backend.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"errors\"\n6|\t\"strconv\"\n7|\t\"strings\"\n8|\t\"time\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n15|)\n16|\n17|// operationDirectives is the exact lifecycle-to-tmux mapping: every\n18|// operation executes a fixed directive sequence and no other tmux\n19|// command. The table is the contract; the drivers below execute it.\n20|// The boundary list-panes member is conditional: it runs only for\n21|// provider proof kinds, binding contemporaneous provider rows into\n22|// the boundary evidence, and never fails the observation.\n23|var operationDirectives = map[terminalbackend.Operation][]Directive{\n24|\tterminalbackend.OperationCreate:           {DirectiveNewSession},\n25|\tterminalbackend.OperationAttach:           {DirectiveAttachSession},\n26|\tterminalbackend.OperationStatus:           {DirectiveListPanes, DirectiveListSessions},\n27|\tterminalbackend.OperationQuiesceInput:     {DirectiveLockSession, DirectiveDetachClients},\n28|\tterminalbackend.OperationWaitSafeBoundary: {DirectiveWaitBoundary, DirectiveListPanes},\n29|\tterminalbackend.OperationRequestStop:      {DirectiveSendInterrupt, DirectiveHasSession, DirectiveKillSession, DirectiveHasSession},\n30|\tterminalbackend.OperationTerminateStale:   {DirectiveKillSession, DirectiveHasSession},\n31|\tterminalbackend.OperationRestore:          {DirectiveNewSession},\n32|}\n33|\n34|// DirectivesFor reports the fixed tmux directive sequence for one\n35|// lifecycle operation. Manifest and probe are not lifecycle operations\n36|// and refuse; every other unknown operation refuses as well.\n37|func DirectivesFor(operation terminalbackend.Operation) ([]Directive, error) {\n38|\tdirectives, known := operationDirectives[operation]\n39|\tif !known {\n40|\t\treturn nil, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle operation\"}\n41|\t}\n42|\treturn append([]Directive(nil), directives...), nil\n43|}\n44|\n45|// backend is the tmux terminstance.Backend: side-effect execution and\n46|// status observation over the structured commands. It is\n47|// request-scoped — one backend per Execute call — because effects\n48|// carry no identity of their own and the runner, socket, stores, and\n49|// admission are per-request facts.\n50|type backend struct {\n51|\trunner      Runner\n52|\truntimeDir  string\n53|\tsocket      string\n54|\toperation   terminalbackend.Operation\n55|\tsessionID   string\n56|\tinstanceID  string\n57|\tbootstrapID string\n58|\tbindingID   string\n59|\tbindingDoc  []byte\n60|\tchannel     string\n61|\tquiescence  string\n62|\tproofKind   terminstance.ProviderProofKind\n63|\twaitCtx     context.Context\n64|\tdeadline    time.Time\n65|\tnow         func() time.Time\n66|\tsleep       func(time.Duration)\n67|\tpoll        time.Duration\n68|\tadmitted    terminalbackend.Admitted\n69|\tbindings    *axpane.Store\n70|\tattach      *termbind.AttachStore\n71|\tstates      *InstanceStates\n72|\ttransport   string\n73|\tinput       bool\n74|\tauthRaw     []byte\n75|\tclientID    string\n76|\t// killExit records the stale-kill exit for the close re-confirm:\n77|\t// a live session after a clean kill and a live session after a\n78|\t// failed kill refuse through the same arm, and the recorded exit\n79|\t// is the member split the narrowing mutant admits exactly one of.\n80|\t// -1 means no kill ran yet on this backend.\n81|\tkillExit int\n82|}\n83|\n84|// effectEvidence derives one evidence digest over the canonical effect\n85|// record: effect name, operation, instance, and outcome facts. The join\n86|// is deterministic; nothing parses it back.\n87|func effectEvidence(effect terminalbackend.SideEffect, operation terminalbackend.Operation, instance string, facts ...string) string {\n88|\trecord := strings.Join(append([]string{string(effect), string(operation), instance}, facts...), \"\\n\")\n89|\treturn scalar.SHA256Digest([]byte(record)).String()\n90|}\n91|\n92|// PerformEffect executes one side effect and reports its evidence ID.\n93|// A nil error proves the commit; a coded error proves the backend\n94|// refused before committing; any other error proves nothing. Every\n95|// tmux command runs through BuildCommand, so no effect addresses any\n96|// server but the derived socket.\n97|func (runner *backend) PerformEffect(ctx context.Context, effect terminalbackend.SideEffect) (string, error) {\n98|\tswitch effect {\n99|\tcase terminalbackend.EffectBindingPersisted:\n100|\t\treturn runner.persistBinding()\n101|\tcase terminalbackend.EffectWrapperStarted:\n102|\t\treturn runner.startWrapper(ctx, terminalbackend.EffectWrapperStarted)\n103|\tcase terminalbackend.EffectAttachClientCreated:\n104|\t\treturn runner.createAttachClient()\n105|\tcase terminalbackend.EffectInputClosed:\n106|\t\treturn runner.closeInput(ctx)\n107|\tcase terminalbackend.EffectSafeBoundaryObserved:\n108|\t\treturn runner.observeBoundary()\n109|\tcase terminalbackend.EffectGracefulStopRequested:\n110|\t\treturn runner.execEvidence(ctx, DirectiveSendInterrupt, terminalbackend.EffectGracefulStopRequested)\n111|\tcase terminalbackend.EffectProcessClosed:\n112|\t\treturn runner.confirmClosed(ctx)\n113|\tcase terminalbackend.EffectBackendStoreClosed:\n114|\t\treturn effectEvidence(effect, runner.operation, runner.instanceID, \"tmux-side closes done\"), nil\n115|\tcase terminalbackend.EffectStaleIncarnationTerminated:\n116|\t\treturn runner.terminateStale(ctx)\n117|\tcase terminalbackend.EffectWrapperRestored:\n118|\t\treturn runner.startWrapper(ctx, terminalbackend.EffectWrapperRestored)\n119|\tdefault:\n120|\t\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend effect vocabulary\"}\n121|\t}\n122|}\n123|\n124|// persistBinding records the bootstrap binding for the create/restore\n125|// pair. A changed operation in the bootstrap window refuses the landed\n126|// idempotency_mismatch; an identical retry replays the one receipt.\n127|// On create the carried binding document is kept alongside the\n128|// receipt, so restore can return the required binding without\n129|// minting; a replayed receipt heals a missing document from the same\n130|// carried bytes, closing the crash window between receipt and\n131|// document.\n132|func (runner *backend) persistBinding() (string, error) {\n133|\tif runner.bindings == nil {\n134|\t\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend binding store\"}\n135|\t}\n136|\trecorded, replayed, err := runner.bindings.Bind(runner.sessionID, runner.bootstrapID, axpane.Binding{\n137|\t\tSessionID:          runner.sessionID,\n138|\t\tOperationID:        runner.bootstrapID,\n139|\t\tTerminalInstanceID: runner.instanceID,\n140|\t\tBindingDigest:      runner.bindingID,\n141|\t})\n142|\tif err != nil {\n143|\t\tif code := backendErrorCode(err); code != \"\" {\n144|\t\t\treturn \"\", &terminstance.Error{Code: code, Detail: \"backend binding conflict\"}\n145|\t\t}\n146|\t\treturn \"\", err\n147|\t}\n148|\tif len(runner.bindingDoc) > 0 && runner.states != nil {\n149|\t\tif !replayed {\n150|\t\t\tif err := runner.states.RecordBindingDoc(runner.sessionID, runner.bootstrapID, runner.bindingDoc); err != nil {\n151|\t\t\t\treturn \"\", err\n152|\t\t\t}\n153|\t\t} else if _, found, err := runner.states.LookupBindingDoc(runner.sessionID, runner.bootstrapID); err != nil {\n154|\t\t\treturn \"\", err\n155|\t\t} else if !found {\n156|\t\t\tif err := runner.states.RecordBindingDoc(runner.sessionID, runner.bootstrapID, runner.bindingDoc); err != nil {\n157|\t\t\t\treturn \"\", err\n158|\t\t\t}\n159|\t\t}\n160|\t}\n161|\treturn recorded.BindingDigest, nil\n162|}\n163|\n164|// closeInput cuts operator input to the instance: lock-session first,\n165|// so attached clients cannot type into the pane during the detach\n166|// window, then detach-client -s, which detaches every client\n167|// currently attached to the session. A locked session does not lock\n168|// subsequently attaching clients (verified on tmux 3.6a), so new\n169|// input-authorized attaches are refused AX-side at the attach entry\n170|// once the quiescing state records; read-only attaches stay admitted\n171|// because quiesce retains observation. Provider input enters only\n172|// through the request-stop effect (the ordered next step), so no\n173|// send-keys runs here. Both commands must exit clean; the evidence\n174|// binds both exits.\n175|func (runner *backend) closeInput(ctx context.Context) (string, error) {\n176|\tfor _, directive := range []Directive{DirectiveLockSession, DirectiveDetachClients} {\n177|\t\targv, err := runner.command(directive)\n178|\t\tif err != nil {\n179|\t\t\treturn \"\", err\n180|\t\t}\n181|\t\tresult, err := runner.runner.Run(ctx, argv)\n182|\t\tif err != nil {\n183|\t\t\treturn \"\", err\n184|\t\t}\n185|\t\tif result.ExitCode != 0 {\n186|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n187|\t\t}\n188|\t}\n189|\treturn effectEvidence(terminalbackend.EffectInputClosed, runner.operation, runner.instanceID, \"locked\", \"detached\"), nil\n190|}\n191|\n192|// startWrapper execs the instance new-session vector for create\n193|// (wrapper_started) and restore (wrapper_restored).\n194|func (runner *backend) startWrapper(ctx context.Context, effect terminalbackend.SideEffect) (string, error) {\n195|\treturn runner.execEvidence(ctx, DirectiveNewSession, effect)\n196|}\n197|\n198|// createAttachClient records the presentation client receipt for one\n199|// (instance, client) pair. Every call requires the valid unexpired\n200|// attach authorization the attach handler already admitted; the store\n201|// rechecks it, so a timeout creates no authorized input unless the\n202|// durable receipt says so.\n203|func (runner *backend) createAttachClient() (string, error) {\n204|\tif runner.attach == nil {\n205|\t\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend attach store\"}\n206|\t}\n207|\treceipt, _, err := runner.attach.Attach(runner.sessionID, runner.instanceID, runner.clientID, runner.transport, runner.input, runner.authRaw, runner.now())\n208|\tif err != nil {\n209|\t\tif code := backendErrorCode(err); code != \"\" {\n210|\t\t\treturn \"\", &terminstance.Error{Code: code, Detail: \"backend attach conflict\"}\n211|\t\t}\n212|\t\treturn \"\", err\n213|\t}\n214|\treturn effectEvidence(terminalbackend.EffectAttachClientCreated, runner.operation, runner.instanceID, receipt.ClientID, receipt.Transport), nil\n215|}\n216|\n217|// execEvidence runs one directive and evidences its success. A nonzero\n218|// exit is a coded process failure: the command ran and the effect did\n219|// not commit. A transport error is uncoded: it proves nothing.\n220|func (runner *backend) execEvidence(ctx context.Context, directive Directive, effect terminalbackend.SideEffect) (string, error) {\n221|\targv, err := runner.command(directive)\n222|\tif err != nil {\n223|\t\treturn \"\", err\n224|\t}\n225|\tresult, err := runner.runner.Run(ctx, argv)\n226|\tif err != nil {\n227|\t\treturn \"\", err\n228|\t}\n229|\tif result.ExitCode != 0 {\n230|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n231|\t}\n232|\treturn effectEvidence(effect, runner.operation, runner.instanceID, strconv.Itoa(result.ExitCode)), nil\n233|}\n234|\n235|// observeBoundary waits for the wrapper's safe-boundary signal on the\n236|// quiescence channel with the bare blocking `wait-for` vector. The\n237|// wait context already bounds the lesser of the request deadline and\n238|// the timeout; its expiry is the coded quiesce_timeout proving\n239|// non-commit, never a silent continue. The requested provider proof\n240|// kind is bound into the evidence, so each kind proves its own\n241|// boundary and an identical retry replays the same proof. For\n242|// provider proof kinds the contemporaneous provider rows are bound\n243|// alongside: the signal is the proof, the rows are audit context,\n244|// and a failed row read binds its negative instead of failing the\n245|// observed proof.\n246|func (runner *backend) observeBoundary() (string, error) {\n247|\targv, err := runner.command(DirectiveWaitBoundary)\n248|\tif err != nil {\n249|\t\treturn \"\", err\n250|\t}\n251|\tresult, err := runner.runner.Run(runner.waitCtx, argv)\n252|\tif err != nil {\n253|\t\tif runner.waitCtx.Err() != nil {\n254|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeQuiesceTimeout, Detail: \"backend boundary wait\"}\n255|\t\t}\n256|\t\treturn \"\", err\n257|\t}\n258|\tif result.ExitCode != 0 {\n259|\t\tif runner.waitCtx.Err() != nil {\n260|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeQuiesceTimeout, Detail: \"backend boundary wait\"}\n261|\t\t}\n262|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n263|\t}\n264|\tobserved, err := runner.now().UTC().MarshalText()\n265|\tif err != nil {\n266|\t\treturn \"\", err\n267|\t}\n268|\tfacts := []string{string(runner.proofKind), runner.channel, string(observed)}\n269|\tif terminstance.RequiresProviderObservation(runner.proofKind) {\n270|\t\tfacts = append(facts, runner.boundaryProviderRows())\n271|\t}\n272|\treturn effectEvidence(terminalbackend.EffectSafeBoundaryObserved, runner.operation, runner.instanceID, facts...), nil\n273|}\n274|\n275|// boundaryProviderRows reads the contemporaneous provider rows for a\n276|// provider-kind boundary as bound context. Presence binds the row\n277|// set; absence binds the negative; a failed read binds unknown. The\n278|// verdict never fails: the wrapper signal already proved the\n279|// boundary, and a post-signal crash must not discard that proof.\n280|func (runner *backend) boundaryProviderRows() string {\n281|\tctx := runner.waitCtx\n282|\tif ctx == nil {\n283|\t\tctx = context.Background()\n284|\t}\n285|\tpresent, rows, err := runner.probePanes(ctx, runner.instanceID)\n286|\tif err != nil {\n287|\t\treturn \"provider:unknown\"\n288|\t}\n289|\tif !present {\n290|\t\treturn \"provider:absent\"\n291|\t}\n292|\treturn \"provider:\" + strings.Join(rows, \"\\n\")\n293|}\n294|\n295|// Absence stderr markers, verified against tmux 3.6a. has-session\n296|// against a missing session reports `can't find session`; list-panes\n297|// against a missing target reports `can't find window`; either\n298|// command against a missing server socket reports `error connecting\n299|// to <socket> (No such file or directory)`. Under a derived and\n300|// custody-verified socket, a missing socket proves no listener and\n301|// therefore no session. Every tmux failure exits 1, so the exit code\n302|// alone proves nothing: only these marker-paired exits prove\n303|// absence. Unrecognized stderr — permission failures, refused\n304|// connections, version-drifted strings — fails closed to unknown.\n305|const (\n306|\tabsentMarkerNoSession = \"can't find session\"\n307|\tabsentMarkerNoWindow  = \"can't find window\"\n308|\tabsentMarkerNoSocket  = \"No such file or directory\"\n309|\tabsentMarkerNoConnect = \"error connecting to\"\n310|)\n311|\n312|// errProbeUnknown is the uncoded unknown-probe signal: the probe ran\n313|// (or never answered) without proving presence or absence. Callers\n314|// return it verbatim; the engine and the lifecycle effect loop map\n315|// uncoded backend failures to the row-allowed process failure with\n316|// status_first and the unavailable observation, never to a verdict.\n317|var errProbeUnknown = errors.New(\"tmux probe proves neither presence nor absence\")\n318|\n319|// classifyAbsence sorts one probe run into present, absent, or\n320|// unknown. Exit 0 is present. A negative exit (a killed child that a\n321|// runner reported as data) is unknown, never absent. A positive exit\n322|// proves absence only with an absence marker on stderr; without one\n323|// it is unknown. Callers pass the markers their command emits.\n324|func classifyAbsence(result RunResult, markers ...string) (present, absent bool) {\n325|\tif result.ExitCode == 0 {\n326|\t\treturn true, false\n327|\t}\n328|\tif result.ExitCode < 0 {\n329|\t\treturn false, false\n330|\t}\n331|\tstderr := string(result.Stderr)\n332|\tfor _, marker := range markers {\n333|\t\tif marker == absentMarkerNoSocket {\n334|\t\t\tif strings.Contains(stderr, absentMarkerNoConnect) && strings.Contains(stderr, absentMarkerNoSocket) {\n335|\t\t\t\treturn false, true\n336|\t\t\t}\n337|\t\t\tcontinue\n338|\t\t}\n339|\t\tif strings.Contains(stderr, marker) {\n340|\t\t\treturn false, true\n341|\t\t}\n342|\t}\n343|\treturn false, false\n344|}\n345|\n346|// confirmClosed proves process closure for request-stop and\n347|// terminate-stale. Positively observed absence (has-session exit with\n348|// the no-session marker, or no server socket under the verified\n349|// path) is the proof. A live session on request-stop escalates once\n350|// to kill-session and re-confirms; a still-live session is the coded\n351|// stop_timeout. An unproven session — transport failure, killed\n352|// probe, or unmarked nonzero exit — is unknown at the deadline, never\n353|// closure. A live session on terminate-stale is the coded process\n354|// failure: the kill claimed the incarnation and it still answers.\n355|// The confirm polls to the deadline before it concludes anything.\n356|func (runner *backend) confirmClosed(ctx context.Context) (string, error) {\n357|\tabsent, err := runner.pollSession(ctx)\n358|\tif err != nil {\n359|\t\treturn \"\", err\n360|\t}\n361|\tif absent {\n362|\t\treturn effectEvidence(terminalbackend.EffectProcessClosed, runner.operation, runner.instanceID, \"absent\"), nil\n363|\t}\n364|\tif runner.operation == terminalbackend.OperationRequestStop {\n365|\t\targv, err := runner.command(DirectiveKillSession)\n366|\t\tif err != nil {\n367|\t\t\treturn \"\", err\n368|\t\t}\n369|\t\tif result, err := runner.runner.Run(ctx, argv); err != nil {\n370|\t\t\treturn \"\", err\n371|\t\t} else if result.ExitCode != 0 {\n372|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n373|\t\t}\n374|\t\tabsent, err := runner.pollSession(ctx)\n375|\t\tif err != nil {\n376|\t\t\treturn \"\", err\n377|\t\t}\n378|\t\tif absent {\n379|\t\t\treturn effectEvidence(terminalbackend.EffectProcessClosed, runner.operation, runner.instanceID, \"escalated\"), nil\n380|\t\t}\n381|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeStopTimeout, Detail: \"backend stop wait\"}\n382|\t}\n383|\t// Terminate-stale re-confirm: a live session refuses whether the kill\n384|\t// exited clean or failed — the kill claimed the incarnation and it\n385|\t// still answers. The exit split names both members so each refuses\n386|\t// explicitly; the narrowing mutant admits exactly the failed-kill\n387|\t// member.\n388|\tif runner.killExit != 0 {\n389|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n390|\t}\n391|\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n392|}\n393|\n394|// pollSession probes has-session until the session is absent or the\n395|// deadline passes. Presence polls on; absence returns at once; an\n396|// unproven probe (transport failure, killed child, unmarked exit)\n397|// polls on until the deadline and then reports unknown, never\n398|// closure. Cancellation aborts at once.\n399|func (runner *backend) pollSession(ctx context.Context) (bool, error) {\n400|\tfor {\n401|\t\tif ctx != nil && ctx.Err() != nil {\n402|\t\t\treturn false, ctx.Err()\n403|\t\t}\n404|\t\targv, err := runner.command(DirectiveHasSession)\n405|\t\tif err != nil {\n406|\t\t\treturn false, err\n407|\t\t}\n408|\t\tresult, err := runner.runner.Run(ctx, argv)\n409|\t\tif err != nil {\n410|\t\t\tif !runner.now().Before(runner.deadline) {\n411|\t\t\t\treturn false, errProbeUnknown\n412|\t\t\t}\n413|\t\t\trunner.sleep(runner.poll)\n414|\t\t\tcontinue\n415|\t\t}\n416|\t\tpresent, absent := classifyAbsence(result, absentMarkerNoSession, absentMarkerNoSocket)\n417|\t\tif absent {\n418|\t\t\treturn true, nil\n419|\t\t}\n420|\t\tif !present {\n421|\t\t\tif !runner.now().Before(runner.deadline) {\n422|\t\t\t\treturn false, errProbeUnknown\n423|\t\t\t}\n424|\t\t\trunner.sleep(runner.poll)\n425|\t\t\tcontinue\n426|\t\t}\n427|\t\tif !runner.now().Before(runner.deadline) {\n428|\t\t\treturn false, nil\n429|\t\t}\n430|\t\trunner.sleep(runner.poll)\n431|\t}\n432|}\n433|\n434|// terminateStale kills the fenced stale incarnation session. A clean\n435|// kill proves termination; a failed kill self-confirms — a\n436|// positively absent session is terminated however it closed — and\n437|// only a live session after a failed kill is the coded process\n438|// failure. An unproven confirm is unknown, never termination.\n439|func (runner *backend) terminateStale(ctx context.Context) (string, error) {\n440|\targv, err := runner.command(DirectiveKillSession)\n441|\tif err != nil {\n442|\t\treturn \"\", err\n443|\t}\n444|\tresult, err := runner.runner.Run(ctx, argv)\n445|\tif err != nil {\n446|\t\treturn \"\", err\n447|\t}\n448|\trunner.killExit = result.ExitCode\n449|\tif result.ExitCode == 0 {\n450|\t\treturn effectEvidence(terminalbackend.EffectStaleIncarnationTerminated, runner.operation, runner.instanceID, \"killed\"), nil\n451|\t}\n452|\tconfirm, err := runner.command(DirectiveHasSession)\n453|\tif err != nil {\n454|\t\treturn \"\", err\n455|\t}\n456|\tobserved, err := runner.runner.Run(ctx, confirm)\n457|\tif err != nil {\n458|\t\treturn \"\", errProbeUnknown\n459|\t}\n460|\tpresent, absent := classifyAbsence(observed, absentMarkerNoSession, absentMarkerNoSocket)\n461|\tif absent {\n462|\t\treturn effectEvidence(terminalbackend.EffectStaleIncarnationTerminated, runner.operation, runner.instanceID, \"confirmed-absent\"), nil\n463|\t}\n464|\tif !present {\n465|\t\treturn \"\", errProbeUnknown\n466|\t}\n467|\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n468|}\n469|\n470|// command builds the argv for one directive over the request identity.\n471|func (runner *backend) command(directive Directive) ([]string, error) {\n472|\tbuilt, err := BuildCommand(directive, CommandArgs{\n473|\t\tRuntimeDir:           runner.runtimeDir,\n474|\t\tSocket:               runner.socket,\n475|\t\tSessionID:            runner.sessionID,\n476|\t\tInstanceID:           runner.instanceID,\n477|\t\tQuiescenceGeneration: runner.quiescence,\n478|\t})\n479|\tif err != nil {\n480|\t\tif code := backendErrorCode(err); code != \"\" {\n481|\t\t\treturn nil, &terminstance.Error{Code: code, Detail: \"backend command refused\"}\n482|\t\t}\n483|\t\treturn nil, err\n484|\t}\n485|\treturn built, nil\n486|}\n487|\n488|// backendErrorCode reads the wire code off a backend-construction or\n489|// store error: landed terminalbackend and terminstance refusals plus\n490|// local tmuxserver refusals all carry one. Anything else is uncoded.\n491|func backendErrorCode(err error) string {\n492|\tif code := terminstance.ErrorCode(err); code != \"\" {\n493|\t\treturn code\n494|\t}\n495|\tvar local *Error\n496|\tif errors.As(err, &local) {\n497|\t\treturn local.Code\n498|\t}\n499|\treturn \"\"\n500|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d1ad","stream":{"kind":"session","id":"01a0c765-6a15-7930-81af-9d81d9b3108a"},"sequence":1841,"recorded_at":1780531400003677,"record_type":"event","durability":"durable","causation_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","run_stream":{"kind":"run","id":"eb24712a-98eb-41ba-85bf-fe73b2577481"},"task_stream":{"kind":"task","id":"01a0c775-422e-7b50-9dd4-569859d53c90"},"task_id":"01a0c775-422e-7b50-9dd4-569859d53c90","event":{"kind":"completed","task_id":"01a0c775-422e-7b50-9dd4-569859d53c90"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d1af","stream":{"kind":"session","id":"01a0c765-6a15-7930-81af-9d81d9b3108a"},"sequence":1842,"recorded_at":1780531400003679,"record_type":"event","durability":"durable","causation_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","run_stream":{"kind":"run","id":"eb24712a-98eb-41ba-85bf-fe73b2577481"},"call_id":"call_01a0c7753dcd749790abf8fecd3d3f60","text":"Read text file `internal/tmuxserver/backend.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"errors\"\n6|\t\"strconv\"\n7|\t\"strings\"\n8|\t\"time\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n15|)\n16|\n17|// operationDirectives is the exact lifecycle-to-tmux mapping: every\n18|// operation executes a fixed directive sequence and no other tmux\n19|// command. The table is the contract; the drivers below execute it.\n20|// The boundary list-panes member is conditional: it runs only for\n21|// provider proof kinds, binding contemporaneous provider rows into\n22|// the boundary evidence, and never fails the observation.\n23|var operationDirectives = map[terminalbackend.Operation][]Directive{\n24|\tterminalbackend.OperationCreate:           {DirectiveNewSession},\n25|\tterminalbackend.OperationAttach:           {DirectiveAttachSession},\n26|\tterminalbackend.OperationStatus:           {DirectiveListPanes, DirectiveListSessions},\n27|\tterminalbackend.OperationQuiesceInput:     {DirectiveLockSession, DirectiveDetachClients},\n28|\tterminalbackend.OperationWaitSafeBoundary: {DirectiveWaitBoundary, DirectiveListPanes},\n29|\tterminalbackend.OperationRequestStop:      {DirectiveSendInterrupt, DirectiveHasSession, DirectiveKillSession, DirectiveHasSession},\n30|\tterminalbackend.OperationTerminateStale:   {DirectiveKillSession, DirectiveHasSession},\n31|\tterminalbackend.OperationRestore:          {DirectiveNewSession},\n32|}\n33|\n34|// DirectivesFor reports the fixed tmux directive sequence for one\n35|// lifecycle operation. Manifest and probe are not lifecycle operations\n36|// and refuse; every other unknown operation refuses as well.\n37|func DirectivesFor(operation terminalbackend.Operation) ([]Directive, error) {\n38|\tdirectives, known := operationDirectives[operation]\n39|\tif !known {\n40|\t\treturn nil, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle operation\"}\n41|\t}\n42|\treturn append([]Directive(nil), directives...), nil\n43|}\n44|\n45|// backend is the tmux terminstance.Backend: side-effect execution and\n46|// status observation over the structured commands. It is\n47|// request-scoped — one backend per Execute call — because effects\n48|// carry no identity of their own and the runner, socket, stores, and\n49|// admission are per-request facts.\n50|type backend struct {\n51|\trunner      Runner\n52|\truntimeDir  string\n53|\tsocket      string\n54|\toperation   terminalbackend.Operation\n55|\tsessionID   string\n56|\tinstanceID  string\n57|\tbootstrapID string\n58|\tbindingID   string\n59|\tbindingDoc  []byte\n60|\tchannel     string\n61|\tquiescence  string\n62|\tproofKind   terminstance.ProviderProofKind\n63|\twaitCtx     context.Context\n64|\tdeadline    time.Time\n65|\tnow         func() time.Time\n66|\tsleep       func(time.Duration)\n67|\tpoll        time.Duration\n68|\tadmitted    terminalbackend.Admitted\n69|\tbindings    *axpane.Store\n70|\tattach      *termbind.AttachStore\n71|\tstates      *InstanceStates\n72|\ttransport   string\n73|\tinput       bool\n74|\tauthRaw     []byte\n75|\tclientID    string\n76|\t// killExit records the stale-kill exit for the close re-confirm:\n77|\t// a live session after a clean kill and a live session after a\n78|\t// failed kill refuse through the same arm, and the recorded exit\n79|\t// is the member split the narrowing mutant admits exactly one of.\n80|\t// -1 means no kill ran yet on this backend.\n81|\tkillExit int\n82|}\n83|\n84|// effectEvidence derives one evidence digest over the canonical effect\n85|// record: effect name, operation, instance, and outcome facts. The join\n86|// is deterministic; nothing parses it back.\n87|func effectEvidence(effect terminalbackend.SideEffect, operation terminalbackend.Operation, instance string, facts ...string) string {\n88|\trecord := strings.Join(append([]string{string(effect), string(operation), instance}, facts...), \"\\n\")\n89|\treturn scalar.SHA256Digest([]byte(record)).String()\n90|}\n91|\n92|// PerformEffect executes one side effect and reports its evidence ID.\n93|// A nil error proves the commit; a coded error proves the backend\n94|// refused before committing; any other error proves nothing. Every\n95|// tmux command runs through BuildCommand, so no effect addresses any\n96|// server but the derived socket.\n97|func (runner *backend) PerformEffect(ctx context.Context, effect terminalbackend.SideEffect) (string, error) {\n98|\tswitch effect {\n99|\tcase terminalbackend.EffectBindingPersisted:\n100|\t\treturn runner.persistBinding()\n101|\tcase terminalbackend.EffectWrapperStarted:\n102|\t\treturn runner.startWrapper(ctx, terminalbackend.EffectWrapperStarted)\n103|\tcase terminalbackend.EffectAttachClientCreated:\n104|\t\treturn runner.createAttachClient()\n105|\tcase terminalbackend.EffectInputClosed:\n106|\t\treturn runner.closeInput(ctx)\n107|\tcase terminalbackend.EffectSafeBoundaryObserved:\n108|\t\treturn runner.observeBoundary()\n109|\tcase terminalbackend.EffectGracefulStopRequested:\n110|\t\treturn runner.execEvidence(ctx, DirectiveSendInterrupt, terminalbackend.EffectGracefulStopRequested)\n111|\tcase terminalbackend.EffectProcessClosed:\n112|\t\treturn runner.confirmClosed(ctx)\n113|\tcase terminalbackend.EffectBackendStoreClosed:\n114|\t\treturn effectEvidence(effect, runner.operation, runner.instanceID, \"tmux-side closes done\"), nil\n115|\tcase terminalbackend.EffectStaleIncarnationTerminated:\n116|\t\treturn runner.terminateStale(ctx)\n117|\tcase terminalbackend.EffectWrapperRestored:\n118|\t\treturn runner.startWrapper(ctx, terminalbackend.EffectWrapperRestored)\n119|\tdefault:\n120|\t\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend effect vocabulary\"}\n121|\t}\n122|}\n123|\n124|// persistBinding records the bootstrap binding for the create/restore\n125|// pair. A changed operation in the bootstrap window refuses the landed\n126|// idempotency_mismatch; an identical retry replays the one receipt.\n127|// On create the carried binding document is kept alongside the\n128|// receipt, so restore can return the required binding without\n129|// minting; a replayed receipt heals a missing document from the same\n130|// carried bytes, closing the crash window between receipt and\n131|// document.\n132|func (runner *backend) persistBinding() (string, error) {\n133|\tif runner.bindings == nil {\n134|\t\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend binding store\"}\n135|\t}\n136|\trecorded, replayed, err := runner.bindings.Bind(runner.sessionID, runner.bootstrapID, axpane.Binding{\n137|\t\tSessionID:          runner.sessionID,\n138|\t\tOperationID:        runner.bootstrapID,\n139|\t\tTerminalInstanceID: runner.instanceID,\n140|\t\tBindingDigest:      runner.bindingID,\n141|\t})\n142|\tif err != nil {\n143|\t\tif code := backendErrorCode(err); code != \"\" {\n144|\t\t\treturn \"\", &terminstance.Error{Code: code, Detail: \"backend binding conflict\"}\n145|\t\t}\n146|\t\treturn \"\", err\n147|\t}\n148|\tif len(runner.bindingDoc) > 0 && runner.states != nil {\n149|\t\tif !replayed {\n150|\t\t\tif err := runner.states.RecordBindingDoc(runner.sessionID, runner.bootstrapID, runner.bindingDoc); err != nil {\n151|\t\t\t\treturn \"\", err\n152|\t\t\t}\n153|\t\t} else if _, found, err := runner.states.LookupBindingDoc(runner.sessionID, runner.bootstrapID); err != nil {\n154|\t\t\treturn \"\", err\n155|\t\t} else if !found {\n156|\t\t\tif err := runner.states.RecordBindingDoc(runner.sessionID, runner.bootstrapID, runner.bindingDoc); err != nil {\n157|\t\t\t\treturn \"\", err\n158|\t\t\t}\n159|\t\t}\n160|\t}\n161|\treturn recorded.BindingDigest, nil\n162|}\n163|\n164|// closeInput cuts operator input to the instance: lock-session first,\n165|// so attached clients cannot type into the pane during the detach\n166|// window, then detach-client -s, which detaches every client\n167|// currently attached to the session. A locked session does not lock\n168|// subsequently attaching clients (verified on tmux 3.6a), so new\n169|// input-authorized attaches are refused AX-side at the attach entry\n170|// once the quiescing state records; read-only attaches stay admitted\n171|// because quiesce retains observation. Provider input enters only\n172|// through the request-stop effect (the ordered next step), so no\n173|// send-keys runs here. Both commands must exit clean; the evidence\n174|// binds both exits.\n175|func (runner *backend) closeInput(ctx context.Context) (string, error) {\n176|\tfor _, directive := range []Directive{DirectiveLockSession, DirectiveDetachClients} {\n177|\t\targv, err := runner.command(directive)\n178|\t\tif err != nil {\n179|\t\t\treturn \"\", err\n180|\t\t}\n181|\t\tresult, err := runner.runner.Run(ctx, argv)\n182|\t\tif err != nil {\n183|\t\t\treturn \"\", err\n184|\t\t}\n185|\t\tif result.ExitCode != 0 {\n186|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n187|\t\t}\n188|\t}\n189|\treturn effectEvidence(terminalbackend.EffectInputClosed, runner.operation, runner.instanceID, \"locked\", \"detached\"), nil\n190|}\n191|\n192|// startWrapper execs the instance new-session vector for create\n193|// (wrapper_started) and restore (wrapper_restored).\n194|func (runner *backend) startWrapper(ctx context.Context, effect terminalbackend.SideEffect) (string, error) {\n195|\treturn runner.execEvidence(ctx, DirectiveNewSession, effect)\n196|}\n197|\n198|// createAttachClient records the presentation client receipt for one\n199|// (instance, client) pair. Every call requires the valid unexpired\n200|// attach authorization the attach handler already admitted; the store\n201|// rechecks it, so a timeout creates no authorized input unless the\n202|// durable receipt says so.\n203|func (runner *backend) createAttachClient() (string, error) {\n204|\tif runner.attach == nil {\n205|\t\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend attach store\"}\n206|\t}\n207|\treceipt, _, err := runner.attach.Attach(runner.sessionID, runner.instanceID, runner.clientID, runner.transport, runner.input, runner.authRaw, runner.now())\n208|\tif err != nil {\n209|\t\tif code := backendErrorCode(err); code != \"\" {\n210|\t\t\treturn \"\", &terminstance.Error{Code: code, Detail: \"backend attach conflict\"}\n211|\t\t}\n212|\t\treturn \"\", err\n213|\t}\n214|\treturn effectEvidence(terminalbackend.EffectAttachClientCreated, runner.operation, runner.instanceID, receipt.ClientID, receipt.Transport), nil\n215|}\n216|\n217|// execEvidence runs one directive and evidences its success. A nonzero\n218|// exit is a coded process failure: the command ran and the effect did\n219|// not commit. A transport error is uncoded: it proves nothing.\n220|func (runner *backend) execEvidence(ctx context.Context, directive Directive, effect terminalbackend.SideEffect) (string, error) {\n221|\targv, err := runner.command(directive)\n222|\tif err != nil {\n223|\t\treturn \"\", err\n224|\t}\n225|\tresult, err := runner.runner.Run(ctx, argv)\n226|\tif err != nil {\n227|\t\treturn \"\", err\n228|\t}\n229|\tif result.ExitCode != 0 {\n230|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n231|\t}\n232|\treturn effectEvidence(effect, runner.operation, runner.instanceID, strconv.Itoa(result.ExitCode)), nil\n233|}\n234|\n235|// observeBoundary waits for the wrapper's safe-boundary signal on the\n236|// quiescence channel with the bare blocking `wait-for` vector. The\n237|// wait context already bounds the lesser of the request deadline and\n238|// the timeout; its expiry is the coded quiesce_timeout proving\n239|// non-commit, never a silent continue. The requested provider proof\n240|// kind is bound into the evidence, so each kind proves its own\n241|// boundary and an identical retry replays the same proof. For\n242|// provider proof kinds the contemporaneous provider rows are bound\n243|// alongside: the signal is the proof, the rows are audit context,\n244|// and a failed row read binds its negative instead of failing the\n245|// observed proof.\n246|func (runner *backend) observeBoundary() (string, error) {\n247|\targv, err := runner.command(DirectiveWaitBoundary)\n248|\tif err != nil {\n249|\t\treturn \"\", err\n250|\t}\n251|\tresult, err := runner.runner.Run(runner.waitCtx, argv)\n252|\tif err != nil {\n253|\t\tif runner.waitCtx.Err() != nil {\n254|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeQuiesceTimeout, Detail: \"backend boundary wait\"}\n255|\t\t}\n256|\t\treturn \"\", err\n257|\t}\n258|\tif result.ExitCode != 0 {\n259|\t\tif runner.waitCtx.Err() != nil {\n260|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeQuiesceTimeout, Detail: \"backend boundary wait\"}\n261|\t\t}\n262|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n263|\t}\n264|\tobserved, err := runner.now().UTC().MarshalText()\n265|\tif err != nil {\n266|\t\treturn \"\", err\n267|\t}\n268|\tfacts := []string{string(runner.proofKind), runner.channel, string(observed)}\n269|\tif terminstance.RequiresProviderObservation(runner.proofKind) {\n270|\t\tfacts = append(facts, runner.boundaryProviderRows())\n271|\t}\n272|\treturn effectEvidence(terminalbackend.EffectSafeBoundaryObserved, runner.operation, runner.instanceID, facts...), nil\n273|}\n274|\n275|// boundaryProviderRows reads the contemporaneous provider rows for a\n276|// provider-kind boundary as bound context. Presence binds the row\n277|// set; absence binds the negative; a failed read binds unknown. The\n278|// verdict never fails: the wrapper signal already proved the\n279|// boundary, and a post-signal crash must not discard that proof.\n280|func (runner *backend) boundaryProviderRows() string {\n281|\tctx := runner.waitCtx\n282|\tif ctx == nil {\n283|\t\tctx = context.Background()\n284|\t}\n285|\tpresent, rows, err := runner.probePanes(ctx, runner.instanceID)\n286|\tif err != nil {\n287|\t\treturn \"provider:unknown\"\n288|\t}\n289|\tif !present {\n290|\t\treturn \"provider:absent\"\n291|\t}\n292|\treturn \"provider:\" + strings.Join(rows, \"\\n\")\n293|}\n294|\n295|// Absence stderr markers, verified against tmux 3.6a. has-session\n296|// against a missing session reports `can't find session`; list-panes\n297|// against a missing target reports `can't find window`; either\n298|// command against a missing server socket reports `error connecting\n299|// to <socket> (No such file or directory)`. Under a derived and\n300|// custody-verified socket, a missing socket proves no listener and\n301|// therefore no session. Every tmux failure exits 1, so the exit code\n302|// alone proves nothing: only these marker-paired exits prove\n303|// absence. Unrecognized stderr — permission failures, refused\n304|// connections, version-drifted strings — fails closed to unknown.\n305|const (\n306|\tabsentMarkerNoSession = \"can't find session\"\n307|\tabsentMarkerNoWindow  = \"can't find window\"\n308|\tabsentMarkerNoSocket  = \"No such file or directory\"\n309|\tabsentMarkerNoConnect = \"error connecting to\"\n310|)\n311|\n312|// errProbeUnknown is the uncoded unknown-probe signal: the probe ran\n313|// (or never answered) without proving presence or absence. Callers\n314|// return it verbatim; the engine and the lifecycle effect loop map\n315|// uncoded backend failures to the row-allowed process failure with\n316|// status_first and the unavailable observation, never to a verdict.\n317|var errProbeUnknown = errors.New(\"tmux probe proves neither presence nor absence\")\n318|\n319|// classifyAbsence sorts one probe run into present, absent, or\n320|// unknown. Exit 0 is present. A negative exit (a killed child that a\n321|// runner reported as data) is unknown, never absent. A positive exit\n322|// proves absence only with an absence marker on stderr; without one\n323|// it is unknown. Callers pass the markers their command emits.\n324|func classifyAbsence(result RunResult, markers ...string) (present, absent bool) {\n325|\tif result.ExitCode == 0 {\n326|\t\treturn true, false\n327|\t}\n328|\tif result.ExitCode < 0 {\n329|\t\treturn false, false\n330|\t}\n331|\tstderr := string(result.Stderr)\n332|\tfor _, marker := range markers {\n333|\t\tif marker == absentMarkerNoSocket {\n334|\t\t\tif strings.Contains(stderr, absentMarkerNoConnect) && strings.Contains(stderr, absentMarkerNoSocket) {\n335|\t\t\t\treturn false, true\n336|\t\t\t}\n337|\t\t\tcontinue\n338|\t\t}\n339|\t\tif strings.Contains(stderr, marker) {\n340|\t\t\treturn false, true\n341|\t\t}\n342|\t}\n343|\treturn false, false\n344|}\n345|\n346|// confirmClosed proves process closure for request-stop and\n347|// terminate-stale. Positively observed absence (has-session exit with\n348|// the no-session marker, or no server socket under the verified\n349|// path) is the proof. A live session on request-stop escalates once\n350|// to kill-session and re-confirms; a still-live session is the coded\n351|// stop_timeout. An unproven session — transport failure, killed\n352|// probe, or unmarked nonzero exit — is unknown at the deadline, never\n353|// closure. A live session on terminate-stale is the coded process\n354|// failure: the kill claimed the incarnation and it still answers.\n355|// The confirm polls to the deadline before it concludes anything.\n356|func (runner *backend) confirmClosed(ctx context.Context) (string, error) {\n357|\tabsent, err := runner.pollSession(ctx)\n358|\tif err != nil {\n359|\t\treturn \"\", err\n360|\t}\n361|\tif absent {\n362|\t\treturn effectEvidence(terminalbackend.EffectProcessClosed, runner.operation, runner.instanceID, \"absent\"), nil\n363|\t}\n364|\tif runner.operation == terminalbackend.OperationRequestStop {\n365|\t\targv, err := runner.command(DirectiveKillSession)\n366|\t\tif err != nil {\n367|\t\t\treturn \"\", err\n368|\t\t}\n369|\t\tif result, err := runner.runner.Run(ctx, argv); err != nil {\n370|\t\t\treturn \"\", err\n371|\t\t} else if result.ExitCode != 0 {\n372|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n373|\t\t}\n374|\t\tabsent, err := runner.pollSession(ctx)\n375|\t\tif err != nil {\n376|\t\t\treturn \"\", err\n377|\t\t}\n378|\t\tif absent {\n379|\t\t\treturn effectEvidence(terminalbackend.EffectProcessClosed, runner.operation, runner.instanceID, \"escalated\"), nil\n380|\t\t}\n381|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeStopTimeout, Detail: \"backend stop wait\"}\n382|\t}\n383|\t// Terminate-stale re-confirm: a live session refuses whether the kill\n384|\t// exited clean or failed — the kill claimed the incarnation and it\n385|\t// still answers. The exit split names both members so each refuses\n386|\t// explicitly; the narrowing mutant admits exactly the failed-kill\n387|\t// member.\n388|\tif runner.killExit != 0 {\n389|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n390|\t}\n391|\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n392|}\n393|\n394|// pollSession probes has-session until the session is absent or the\n395|// deadline passes. Presence polls on; absence returns at once; an\n396|// unproven probe (transport failure, killed child, unmarked exit)\n397|// polls on until the deadline and then reports unknown, never\n398|// closure. Cancellation aborts at once.\n399|func (runner *backend) pollSession(ctx context.Context) (bool, error) {\n400|\tfor {\n401|\t\tif ctx != nil && ctx.Err() != nil {\n402|\t\t\treturn false, ctx.Err()\n403|\t\t}\n404|\t\targv, err := runner.command(DirectiveHasSession)\n405|\t\tif err != nil {\n406|\t\t\treturn false, err\n407|\t\t}\n408|\t\tresult, err := runner.runner.Run(ctx, argv)\n409|\t\tif err != nil {\n410|\t\t\tif !runner.now().Before(runner.deadline) {\n411|\t\t\t\treturn false, errProbeUnknown\n412|\t\t\t}\n413|\t\t\trunner.sleep(runner.poll)\n414|\t\t\tcontinue\n415|\t\t}\n416|\t\tpresent, absent := classifyAbsence(result, absentMarkerNoSession, absentMarkerNoSocket)\n417|\t\tif absent {\n418|\t\t\treturn true, nil\n419|\t\t}\n420|\t\tif !present {\n421|\t\t\tif !runner.now().Before(runner.deadline) {\n422|\t\t\t\treturn false, errProbeUnknown\n423|\t\t\t}\n424|\t\t\trunner.sleep(runner.poll)\n425|\t\t\tcontinue\n426|\t\t}\n427|\t\tif !runner.now().Before(runner.deadline) {\n428|\t\t\treturn false, nil\n429|\t\t}\n430|\t\trunner.sleep(runner.poll)\n431|\t}\n432|}\n433|\n434|// terminateStale kills the fenced stale incarnation session. A clean\n435|// kill proves termination; a failed kill self-confirms — a\n436|// positively absent session is terminated however it closed — and\n437|// only a live session after a failed kill is the coded process\n438|// failure. An unproven confirm is unknown, never termination.\n439|func (runner *backend) terminateStale(ctx context.Context) (string, error) {\n440|\targv, err := runner.command(DirectiveKillSession)\n441|\tif err != nil {\n442|\t\treturn \"\", err\n443|\t}\n444|\tresult, err := runner.runner.Run(ctx, argv)\n445|\tif err != nil {\n446|\t\treturn \"\", err\n447|\t}\n448|\trunner.killExit = result.ExitCode\n449|\tif result.ExitCode == 0 {\n450|\t\treturn effectEvidence(terminalbackend.EffectStaleIncarnationTerminated, runner.operation, runner.instanceID, \"killed\"), nil\n451|\t}\n452|\tconfirm, err := runner.command(DirectiveHasSession)\n453|\tif err != nil {\n454|\t\treturn \"\", err\n455|\t}\n456|\tobserved, err := runner.runner.Run(ctx, confirm)\n457|\tif err != nil {\n458|\t\treturn \"\", errProbeUnknown\n459|\t}\n460|\tpresent, absent := classifyAbsence(observed, absentMarkerNoSession, absentMarkerNoSocket)\n461|\tif absent {\n462|\t\treturn effectEvidence(terminalbackend.EffectStaleIncarnationTerminated, runner.operation, runner.instanceID, \"confirmed-absent\"), nil\n463|\t}\n464|\tif !present {\n465|\t\treturn \"\", errProbeUnknown\n466|\t}\n467|\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n468|}\n469|\n470|// command builds the argv for one directive over the request identity.\n471|func (runner *backend) command(directive Directive) ([]string, error) {\n472|\tbuilt, err := BuildCommand(directive, CommandArgs{\n473|\t\tRuntimeDir:           runner.runtimeDir,\n474|\t\tSocket:               runner.socket,\n475|\t\tSessionID:            runner.sessionID,\n476|\t\tInstanceID:           runner.instanceID,\n477|\t\tQuiescenceGeneration: runner.quiescence,\n478|\t})\n479|\tif err != nil {\n480|\t\tif code := backendErrorCode(err); code != \"\" {\n481|\t\t\treturn nil, &terminstance.Error{Code: code, Detail: \"backend command refused\"}\n482|\t\t}\n483|\t\treturn nil, err\n484|\t}\n485|\treturn built, nil\n486|}\n487|\n488|// backendErrorCode reads the wire code off a backend-construction or\n489|// store error: landed terminalbackend and terminstance refusals plus\n490|// local tmuxserver refusals all carry one. Anything else is uncoded.\n491|func backendErrorCode(err error) string {\n492|\tif code := terminstance.ErrorCode(err); code != \"\" {\n493|\t\treturn code\n494|\t}\n495|\tvar local *Error\n496|\tif errors.As(err, &local) {\n497|\t\treturn local.Code\n498|\t}\n499|\treturn \"\"\n500|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
