\\\\t\\\\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \\\"socket root\\\"}\\\\n',\\n        replace='\\\\tif writableByOthers(info) && info.Mode().Perm() != 0o777 {\\\\n\\\\t\\\\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \\\"socket root\\\"}\\\\n',\\n        count=1,\\n        run=\\\"TestCheckSocketCustodyRefusesUnsafeRoot\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly 0777 roots past the root writability arm; every other writable root still refuses, and the ancestor arm keeps its own row. Kill path: the world-writable root verifies clean.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-bind-ancestor-writable\\\",\\n        path=f\\\"{PACKAGE}/bind.go\\\",\\n        find='\\\\t\\\\tif writableByOthers(info) {\\\\n\\\\t\\\\t\\\\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \\\"socket ancestor\\\"}\\\\n',\\n        replace='\\\\t\\\\tif writableByOthers(info) && info.Mode().Perm() != 0o777 {\\\\n\\\\t\\\\t\\\\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \\\"socket ancestor\\\"}\\\\n',\\n        count=1,\\n        run=\\\"TestCheckSocketCustodyRefusesWritableAncestor\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly 0777 ancestors past the ancestor writability arm; every other writable ancestor still refuses, and the root arm keeps its own row. Kill path: the world-writable ancestor verifies clean.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-bind-socket-kind\\\",\\n        path=f\\\"{PACKAGE}/bind.go\\\",\\n        find='\\\\tif info.Mode().Type() != os.ModeSocket {\\\\n\\\\t\\\\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \\\"socket kind\\\"}\\\\n\\\\t}\\\\n',\\n        replace='\\\\tif info.Mode().Type() != os.ModeSocket && !info.Mode().IsRegular() {\\\\n\\\\t\\\\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \\\"socket kind\\\"}\\\\n\\\\t}\\\\n',\\n        count=1,\\n        run=\\\"TestCheckSocketCustodyRefusesNonSocketFile\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\