{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d1e1","stream":{"kind":"session","id":"01a0c765-6a15-7930-81af-9d81d9b3108a"},"sequence":1867,"recorded_at":1780531400003729,"record_type":"event","durability":"durable","causation_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","run_stream":{"kind":"run","id":"eb24712a-98eb-41ba-85bf-fe73b2577481"},"call_id":"call_01a0c775c88276188da0ea9fd963cda6","text":"Read text file `internal/tmuxserver/bodies.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n11|)\n12|\n13|// This file admits the four closed operation bodies the landed engine\n14|// leaves out: the full create body (the engine runs create in receipt\n15|// scope only), attach, terminate-stale, and restore. Quiesce-input,\n16|// wait-safe-boundary, and request-stop bodies stay owned by\n17|// terminstance.ParseOperationBody and status bodies by\n18|// terminstance.ParseStatusBody; those parsers are reused, never\n19|// re-implemented. Every nested document (mutation context, binding,\n20|// attach authorization) is admitted by its landed owner; only the\n21|// member lists — which only these schemas can name — are local.\n22|\n23|// CreateBody is the closed §4.C create body: context, binding,\n24|// bootstrap_operation_id, entrypoint, presentation_transport, and\n25|// interactive. BindingRaw carries the binding member's exact bytes so\n26|// the backend keeps the carried document for the restore read without\n27|// re-encoding it.\n28|type CreateBody struct {\n29|\tContext              terminstance.MutationContext\n30|\tBinding              termbind.Binding\n31|\tBindingRaw           json.RawMessage\n32|\tBootstrapOperationID string\n33|\tTransport            string\n34|\tInteractive          bool\n35|}\n36|\n37|// createBodyMembers is the exact closed member set.\n38|var createBodyMembers = []string{\n39|\t\"context\",\n40|\t\"binding\",\n41|\t\"bootstrap_operation_id\",\n42|\t\"entrypoint\",\n43|\t\"presentation_transport\",\n44|\t\"interactive\",\n45|}\n46|\n47|// parseCreateBody admits one closed create body. The nested mutation\n48|// context, terminal instance binding, and entrypoint are admitted by\n49|// their landed owners; the transport admits the three-literal closed\n50|// vocabulary here and the relay member refuses at the handler (create\n51|// carries no attach authorization, so no landed relay arm stands\n52|// downstream).\n53|func parseCreateBody(raw []byte) (CreateBody, error) {\n54|\tmembers, fault := environ.DecodeStrictObject(raw)\n55|\tif fault != nil {\n56|\t\treturn CreateBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"create body frame\"}\n57|\t}\n58|\tif len(members) != len(createBodyMembers) {\n59|\t\treturn CreateBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"create body members\"}\n60|\t}\n61|\tfor _, member := range createBodyMembers {\n62|\t\tif _, known := members[member]; !known {\n63|\t\t\treturn CreateBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"create body members\"}\n64|\t\t}\n65|\t}\n66|\tcontext, err := terminstance.ParseMutationContext(members[\"context\"])\n67|\tif err != nil {\n68|\t\treturn CreateBody{}, err\n69|\t}\n70|\tbinding, err := termbind.ParseTerminalBinding(members[\"binding\"])\n71|\tif err != nil {\n72|\t\treturn CreateBody{}, err\n73|\t}\n74|\tbootstrap, ok := environ.CheckUUIDv7(members[\"bootstrap_operation_id\"])\n75|\tif !ok {\n76|\t\treturn CreateBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"create body bootstrap\"}\n77|\t}\n78|\targv, err := parseEntrypointArgv(members[\"entrypoint\"])\n79|\tif err != nil {\n80|\t\treturn CreateBody{}, err\n81|\t}\n82|\tif err := terminalbackend.CheckEntrypoint(argv, context.SessionID); err != nil {\n83|\t\treturn CreateBody{}, err\n84|\t}\n85|\ttransport, err := parsePresentationTransport(members[\"presentation_transport\"])\n86|\tif err != nil {\n87|\t\treturn CreateBody{}, err\n88|\t}\n89|\tvar interactive bool\n90|\tif err := json.Unmarshal(members[\"interactive\"], &interactive); err != nil {\n91|\t\treturn CreateBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"create body interactive\"}\n92|\t}\n93|\treturn CreateBody{\n94|\t\tContext:              context,\n95|\t\tBinding:              binding,\n96|\t\tBindingRaw:           members[\"binding\"],\n97|\t\tBootstrapOperationID: bootstrap.String(),\n98|\t\tTransport:            transport,\n99|\t\tInteractive:          interactive,\n100|\t}, nil\n101|}\n102|\n103|// parseEntrypointArgv admits the closed Entrypoint object {argv} and\n104|// reads its three-element vector. Length and literals are the landed\n105|// CheckEntrypoint's verdict, not this function's.\n106|func parseEntrypointArgv(raw json.RawMessage) ([]string, error) {\n107|\tobject, fault := environ.DecodeStrictObject(raw)\n108|\tif fault != nil {\n109|\t\treturn nil, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"create body entrypoint\"}\n110|\t}\n111|\tif len(object) != 1 {\n112|\t\treturn nil, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"create body entrypoint\"}\n113|\t}\n114|\tmember, known := object[\"argv\"]\n115|\tif !known {\n116|\t\treturn nil, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"create body entrypoint\"}\n117|\t}\n118|\tvar argv []string\n119|\tif err := json.Unmarshal(member, &argv); err != nil {\n120|\t\treturn nil, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"create body entrypoint\"}\n121|\t}\n122|\treturn argv, nil\n123|}\n124|\n125|// parsePresentationTransport admits the closed three-literal transport\n126|// vocabulary. Admission is not authorization: the relay member parses\n127|// and refuses downstream (landed attach arm for attach, the create\n128|// relay arm for create).\n129|func parsePresentationTransport(raw json.RawMessage) (string, error) {\n130|\ttransport, ok := bodyString(raw)\n131|\tif !ok {\n132|\t\treturn \"\", &Error{Code: terminalbackend.CodeProtocolError, Detail: \"presentation transport vocabulary\"}\n133|\t}\n134|\tswitch transport {\n135|\tcase string(terminalbackend.TransportLocalOnly),\n136|\t\tstring(terminalbackend.TransportTrustedPrivateMesh),\n137|\t\tstring(terminalbackend.TransportThirdPartyRelay):\n138|\t\treturn transport, nil\n139|\tdefault:\n140|\t\treturn \"\", &Error{Code: terminalbackend.CodeProtocolError, Detail: \"presentation transport vocabulary\"}\n141|\t}\n142|}\n143|\n144|// AttachBody is the closed §4.C attach body: the flat identity tuple,\n145|// client, transport, input boolean, deadline, and attach authorization.\n146|// AuthRaw carries the authorization member's raw bytes so the attach\n147|// store re-admits the exact presented document without a re-frame.\n148|type AttachBody struct {\n149|\tSessionID             string\n150|\tTerminalInstanceID    string\n151|\tTerminalBackendID     string\n152|\tImplementationVersion string\n153|\tProtocolVersion       string\n154|\tBackendGeneration     string\n155|\tClientID              string\n156|\tTransport             string\n157|\tInputAuthorized       bool\n158|\tDeadline              scalar.Timestamp\n159|\tAuthorization         terminalbackend.AttachAuthorization\n160|\tAuthRaw               json.RawMessage\n161|}\n162|\n163|// attachBodyMembers is the exact closed member set.\n164|var attachBodyMembers = []string{\n165|\t\"session_id\",\n166|\t\"terminal_instance_id\",\n167|\t\"terminal_backend_id\",\n168|\t\"implementation_version\",\n169|\t\"protocol_version\",\n170|\t\"backend_generation\",\n171|\t\"client_id\",\n172|\t\"transport\",\n173|\t\"input_authorized\",\n174|\t\"deadline_at\",\n175|\t\"authorization\",\n176|}\n177|\n178|// parseAttachBody admits one closed attach body. The nested attach\n179|// authorization is admitted by its landed owner; version-tuple and\n180|// generation grammars delegate to the landed gates the status body\n181|// already uses.\n182|func parseAttachBody(raw []byte) (AttachBody, error) {\n183|\tmembers, fault := environ.DecodeStrictObject(raw)\n184|\tif fault != nil {\n185|\t\treturn AttachBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body frame\"}\n186|\t}\n187|\tif len(members) != len(attachBodyMembers) {\n188|\t\treturn AttachBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body members\"}\n189|\t}\n190|\tfor _, member := range attachBodyMembers {\n191|\t\tif _, known := members[member]; !known {\n192|\t\t\treturn AttachBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body members\"}\n193|\t\t}\n194|\t}\n195|\tsession, ok := environ.CheckUUIDv7(members[\"session_id\"])\n196|\tif !ok {\n197|\t\treturn AttachBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body session\"}\n198|\t}\n199|\tinstance, ok := environ.CheckUUIDv7(members[\"terminal_instance_id\"])\n200|\tif !ok {\n201|\t\treturn AttachBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body instance\"}\n202|\t}\n203|\tbackendID, ok := bodyString(members[\"terminal_backend_id\"])\n204|\tif !ok {\n205|\t\treturn AttachBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body backend\"}\n206|\t}\n207|\tif _, err := terminalbackend.ParseID(backendID); err != nil {\n208|\t\treturn AttachBody{}, err\n209|\t}\n210|\timplementationVersion, ok := bodyString(members[\"implementation_version\"])\n211|\tif !ok {\n212|\t\treturn AttachBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body versions\"}\n213|\t}\n214|\tprotocolVersion, ok := bodyString(members[\"protocol_version\"])\n215|\tif !ok {\n216|\t\treturn AttachBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body versions\"}\n217|\t}\n218|\tif err := terminalbackend.CheckVersionTuple(backendID, implementationVersion, protocolVersion, []string{protocolVersion}); err != nil {\n219|\t\treturn AttachBody{}, err\n220|\t}\n221|\tgeneration, ok := environ.CheckStringBounds(members[\"backend_generation\"], 1, 256)\n222|\tif !ok {\n223|\t\treturn AttachBody{}, &Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation bound\"}\n224|\t}\n225|\tclient, ok := environ.CheckUUIDv7(members[\"client_id\"])\n226|\tif !ok {\n227|\t\treturn AttachBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body client\"}\n228|\t}\n229|\ttransport, err := parsePresentationTransport(members[\"transport\"])\n230|\tif err != nil {\n231|\t\treturn AttachBody{}, err\n232|\t}\n233|\tvar inputAuthorized bool\n234|\tif err := json.Unmarshal(members[\"input_authorized\"], &inputAuthorized); err != nil {\n235|\t\treturn AttachBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body input\"}\n236|\t}\n237|\tdeadline, ok := environ.CheckTimestamp(members[\"deadline_at\"])\n238|\tif !ok {\n239|\t\treturn AttachBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body deadline\"}\n240|\t}\n241|\tauthorization, err := terminalbackend.ParseAttachAuthorization(members[\"authorization\"])\n242|\tif err != nil {\n243|\t\treturn AttachBody{}, err\n244|\t}\n245|\treturn AttachBody{\n246|\t\tSessionID:             session.String(),\n247|\t\tTerminalInstanceID:    instance.String(),\n248|\t\tTerminalBackendID:     backendID,\n249|\t\tImplementationVersion: implementationVersion,\n250|\t\tProtocolVersion:       protocolVersion,\n251|\t\tBackendGeneration:     generation,\n252|\t\tClientID:              client.String(),\n253|\t\tTransport:             transport,\n254|\t\tInputAuthorized:       inputAuthorized,\n255|\t\tDeadline:              deadline,\n256|\t\tAuthorization:         authorization,\n257|\t\tAuthRaw:               members[\"authorization\"],\n258|\t}, nil\n259|}\n260|\n261|// TerminateBody is the closed §4.C terminate-stale body: context,\n262|// stale_lease_id, stale_epoch, and diagnostic_evidence_id.\n263|type TerminateBody struct {\n264|\tContext              terminstance.MutationContext\n265|\tStaleLeaseID         string\n266|\tStaleEpoch           uint64\n267|\tDiagnosticEvidenceID string\n268|}\n269|\n270|// terminateBodyMembers is the exact closed member set.\n271|var terminateBodyMembers = []string{\n272|\t\"context\",\n273|\t\"stale_lease_id\",\n274|\t\"stale_epoch\",\n275|\t\"diagnostic_evidence_id\",\n276|}\n277|\n278|// parseTerminateBody admits one closed terminate-stale body.\n279|func parseTerminateBody(raw []byte) (TerminateBody, error) {\n280|\tmembers, fault := environ.DecodeStrictObject(raw)\n281|\tif fault != nil {\n282|\t\treturn TerminateBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminate body frame\"}\n283|\t}\n284|\tif len(members) != len(terminateBodyMembers) {\n285|\t\treturn TerminateBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminate body members\"}\n286|\t}\n287|\tfor _, member := range terminateBodyMembers {\n288|\t\tif _, known := members[member]; !known {\n289|\t\t\treturn TerminateBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminate body members\"}\n290|\t\t}\n291|\t}\n292|\tcontext, err := terminstance.ParseMutationContext(members[\"context\"])\n293|\tif err != nil {\n294|\t\treturn TerminateBody{}, err\n295|\t}\n296|\tleaseRaw, ok := bodyString(members[\"stale_lease_id\"])\n297|\tif !ok {\n298|\t\treturn TerminateBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminate body lease\"}\n299|\t}\n300|\tlease, err := scalar.ParseUUIDv4(leaseRaw)\n301|\tif err != nil {\n302|\t\treturn TerminateBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminate body lease\"}\n303|\t}\n304|\tepoch, ok := environ.CheckUint53Bounds(members[\"stale_epoch\"], 1, scalar.MaxUint53)\n305|\tif !ok {\n306|\t\treturn TerminateBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminate body epoch\"}\n307|\t}\n308|\tdiagnostic, ok := environ.CheckDigest(members[\"diagnostic_evidence_id\"])\n309|\tif !ok {\n310|\t\treturn TerminateBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminate body evidence\"}\n311|\t}\n312|\treturn TerminateBody{\n313|\t\tContext:              context,\n314|\t\tStaleLeaseID:         lease.String(),\n315|\t\tStaleEpoch:           epoch,\n316|\t\tDiagnosticEvidenceID: diagnostic.String(),\n317|\t}, nil\n318|}\n319|\n320|// RestoreBody is the closed §4.C restore body: context,\n321|// prior_binding_id, checkpoint_id, and bootstrap_operation_id.\n322|type RestoreBody struct {\n323|\tContext              terminstance.MutationContext\n324|\tPriorBindingID       string\n325|\tCheckpointID         string\n326|\tBootstrapOperationID string\n327|}\n328|\n329|// restoreBodyMembers is the exact closed member set.\n330|var restoreBodyMembers = []string{\n331|\t\"context\",\n332|\t\"prior_binding_id\",\n333|\t\"checkpoint_id\",\n334|\t\"bootstrap_operation_id\",\n335|}\n336|\n337|// parseRestoreBody admits one closed restore body.\n338|func parseRestoreBody(raw []byte) (RestoreBody, error) {\n339|\tmembers, fault := environ.DecodeStrictObject(raw)\n340|\tif fault != nil {\n341|\t\treturn RestoreBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"restore body frame\"}\n342|\t}\n343|\tif len(members) != len(restoreBodyMembers) {\n344|\t\treturn RestoreBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"restore body members\"}\n345|\t}\n346|\tfor _, member := range restoreBodyMembers {\n347|\t\tif _, known := members[member]; !known {\n348|\t\t\treturn RestoreBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"restore body members\"}\n349|\t\t}\n350|\t}\n351|\tcontext, err := terminstance.ParseMutationContext(members[\"context\"])\n352|\tif err != nil {\n353|\t\treturn RestoreBody{}, err\n354|\t}\n355|\tprior, ok := environ.CheckDigest(members[\"prior_binding_id\"])\n356|\tif !ok {\n357|\t\treturn RestoreBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"restore body binding\"}\n358|\t}\n359|\tcheckpoint, ok := environ.CheckDigest(members[\"checkpoint_id\"])\n360|\tif !ok {\n361|\t\treturn RestoreBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"restore body checkpoint\"}\n362|\t}\n363|\tbootstrap, ok := environ.CheckUUIDv7(members[\"bootstrap_operation_id\"])\n364|\tif !ok {\n365|\t\treturn RestoreBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"restore body bootstrap\"}\n366|\t}\n367|\treturn RestoreBody{\n368|\t\tContext:              context,\n369|\t\tPriorBindingID:       prior.String(),\n370|\t\tCheckpointID:         checkpoint.String(),\n371|\t\tBootstrapOperationID: bootstrap.String(),\n372|\t}, nil\n373|}\n374|\n375|// bodyString reads a JSON string member. Non-string members are\n376|// malformed, never coerced.\n377|func bodyString(raw json.RawMessage) (string, bool) {\n378|\tvar value string\n379|\tif err := json.Unmarshal(raw, &value); err != nil {\n380|\t\treturn \"\", false\n381|\t}\n382|\treturn value, true\n383|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
