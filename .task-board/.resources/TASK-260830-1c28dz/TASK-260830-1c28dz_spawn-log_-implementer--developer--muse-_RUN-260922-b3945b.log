{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d323","stream":{"kind":"session","id":"01a0c765-6a15-7930-81af-9d81d9b3108a"},"sequence":2028,"recorded_at":1780531400004051,"record_type":"event","durability":"durable","causation_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","run_stream":{"kind":"run","id":"eb24712a-98eb-41ba-85bf-fe73b2577481"},"task_stream":{"kind":"task","id":"01a0c776-31f2-7fe0-ad0e-e68bd5c2ec14"},"task_id":"01a0c776-31f2-7fe0-ad0e-e68bd5c2ec14","event":{"kind":"output","task_id":"01a0c776-31f2-7fe0-ad0e-e68bd5c2ec14","chunk":"Read text file `internal/axpane/decide.go`.\n(518 line(s) above)\n519|\t\tDetail:   \"launch under the winning lease\",\n520|\t}\n521|\tif input.ExistingBinding != nil && input.ExistingBinding.OperationID == input.BootstrapOperationID {\n522|\t\tdecision.Action = ActionReattach\n523|\t\tdecision.Detail = \"reattach to the one recorded wrapper/child\"\n524|\t}\n525|\tdescriptor, err := terminalbackend.AdmitProviderDescriptor(input.Descriptor, input.HostBinding)\n526|\tif err != nil {\n527|\t\treturn refused(backendClass(err), \"provider descriptor does not match the validated binding\", err)\n528|\t}\n529|\tdecision.Descriptor = descriptor\n530|\treturn decision\n531|}\n532|\n533|// decideParked resolves a fencing park into the parked outcome or,\n534|// for a remote owner in an interactive terminal, the attach/takeover\n535|// offer of after-restore step 4. Attach requires the admitted attach\n536|// capability; an interactive remote owner without it offers takeover\n537|// instead of starting a runtime. A remote owner outside an\n538|// interactive terminal parks with the remote_owner reason (§4.2 step\n539|// 5: parked in all other cases). Non-remote parks carry the fencing\n540|// reason unchanged.\n541|func decideParked(input Input, admitted terminalbackend.Admitted, reason fencing.ParkReason, winning string, cause error) Decision {\n542|\tif reason != fencing.ParkRemoteOwner {\n543|\t\treturn parked(reason, winning, cause)\n544|\t}\n545|\tif !input.RemoteInteractive {\n546|\t\treturn parked(reason, winning, cause)\n547|\t}\n548|\tif terminalbackend.CheckOperation(\"attach\", admitted) == nil {\n549|\t\treturn Decision{\n550|\t\t\tAction:         ActionAttachRemote,\n551|\t\t\tParkReason:     reason,\n552|\t\t\tWinningLeaseID: winning,\n553|\t\t\tAdmitted:       admitted,\n554|\t\t\tDetail:         \"offer remote attach; no lease mutation\",\n555|\t\t\tCause:          cause,\n556|\t\t}\n557|\t}\n558|\treturn Decision{\n559|\t\tAction:         ActionTakeoverOffer,\n560|\t\tParkReason:     reason,\n561|\t\tWinningLeaseID: winning,\n562|\t\tAdmitted:       admitted,\n563|\t\tDetail:         \"offer takeover; no runtime started\",\n564|\t\tCause:          cause,\n565|\t}\n566|}\n567|\n568|// bootstrapWindowClosed reports whether the §13.1 bootstrap window\n569|// has closed: the chain fold published a newest checkpoint, so a\n570|// new bootstrap operation is a legitimate post-window binding, not\n571|// an in-window mismatch. The predicate reads only the fold fact,\n572|// never a caller claim and never the lease record's own\n573|// checkpoint, which is null for every epoch-1 owner. A successor\n574|// lease (epoch 2 or later) carries the handoff checkpoint and so\n575|// implies a published newest, but the fold is the authority the\n576|// window closes on.\n577|func bootstrapWindowClosed(input Input) bool {\n578|\treturn input.HasNewestCheckpoint\n579|}\n580|\n581|// authorize selects the fencing entry by mode: activation for a\n582|// fresh launch, restore for the after-restore first start. Both are\n583|// launch-class entries: ownership that is remote, ambiguous,\n584|// unverified, or absent parks with the session.parked vocabulary,\n585|// while malformed calls, foreign sessions, and lapsed grants refuse.\n586|func authorize(input Input) (fencing.LeaseToken, error) {\n587|\tif input.Mode == ModeRestore {\n588|\t\treturn fencing.AuthorizeRestore(input.Presented, input.Observation)\n589|\t}\n590|\treturn fencing.AuthorizeActivation(input.Presented, input.Observation)\n591|}\n592|\n593|// admitBackend parses the §4.B identity documents through the\n594|// terminalbackend owner, reconciles the Probe against the Manifest\n595|// with the returned evidence bound to the AX-known raw generation,\n596|// and gates the mode operation against the admitted set. Only the\n597|// exact admitted capability rows authorize the action; no\n598|// capability map is invented here. The parsed evidence is returned\n599|// alongside the admitted set so the realm arm can bind the\n600|// credential-realm row to the host binding and probed build\n601|// without re-parsing.\n602|func admitBackend(input Input) (terminalbackend.Admitted, []terminalbackend.Evidence, error) {\n603|\tmanifest, err := terminalbackend.ParseManifest(input.Backend.Manifest)\n604|\tif err != nil {\n605|\t\treturn terminalbackend.Admitted{}, nil, err\n606|\t}\n607|\tprobe, err := terminalbackend.ParseProbe(input.Backend.Probe)\n608|\tif err != nil {\n609|\t\treturn terminalbackend.Admitted{}, nil, err\n610|\t}\n611|\tevidence := make([]terminalbackend.Evidence, 0, len(input.Backend.Evidence))\n612|\tfor _, doc := range input.Backend.Evidence {\n613|\t\tparsed, err := terminalbackend.ParseEvidence(doc)\n614|\t\tif err != nil {\n615|\t\t\treturn terminalbackend.Admitted{}, nil, err\n616|\t\t}\n617|\t\tevidence = append(evidence, parsed)\n618|\t}\n619|\tadmitted, err := terminalbackend.Reconcile(manifest, probe, evidence, input.Backend.RawGeneration, input.Backend.Now, input.Backend.Verify)\n620|\tif err != nil {\n621|\t\t// A caller that needs the realm row but submitted only\n622|\t\t// dead realm evidence (expired at the admission instant\n623|\t\t// or bound to a superseded generation) refuses the §4.2\n624|\t\t// capability_unavailable with typed realm/readiness\n625|\t\t// details, not the backend reconcile class: the realm\n626|\t\t// evidence is unusable however the reconcile failed.\n627|\t\tif realmErr := deadRealmRefusal(input, evidence, err); realmErr != nil {\n628|\t\t\treturn terminalbackend.Admitted{}, nil, realmErr\n629|\t\t}\n630|\t\treturn terminalbackend.Admitted{}, nil, err\n631|\t}\n632|\toperation := \"create\"\n633|\tif input.Mode == ModeRestore {\n634|\t\toperation = \"restore\"\n635|\t}\n636|\tif err := terminalbackend.CheckOperation(operation, admitted); err != nil {\n637|\t\treturn terminalbackend.Admitted{}, nil, err\n638|\t}\n639|\treturn admitted, evidence, nil\n640|}\n641|\n642|// checkMaterialization enforces after-restore step 3: the required\n643|// journal must be admitted by the matjournal owner, committed, and\n644|// sourced from the fold's newest published checkpoint. A committed\n645|// journal one generation behind the newest checkpoint is stale,\n646|// never valid; with no published checkpoint the requirement parks,\n647|// never launches. The winning lease's handoff base is never\n648|// consulted: the fold is the sole newest authority.\n(more lines below)","final_result":true}}}
