{"schema_version":1,"id":"018f0000-0000-7000-8000-000000010a37","stream":{"kind":"session","id":"01a0c765-6a15-7930-81af-9d81d9b3108a"},"sequence":9078,"recorded_at":1780531400018151,"record_type":"event","durability":"durable","causation_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","run_stream":{"kind":"run","id":"eb24712a-98eb-41ba-85bf-fe73b2577481"},"call_id":"call_01a0c7b8157877cc8cb218b629bb6655","text":"Read text file `internal/termbind/successor.go`.\n1|package termbind\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n7|)\n8|\n9|// MintSuccessorBinding mints the reboot-successor Terminal Instance\n10|// Binding for a new backend generation over a parsed prior: the\n11|// §4.C restore row requires the restore result to carry the new\n12|// binding, and only this owner computes the Section 4.B identity, so\n13|// the backend succeeds the prior through this entry instead of\n14|// re-encoding or echoing it.\n15|//\n16|// The successor inherits every prior member except three: the backend\n17|// generation moves to the new generation, supersedes_binding_id names\n18|// the prior digest, and binding_id is the recomputed omit-self\n19|// identity. The mint is deterministic and clock-free: the same prior\n20|// and generation always mint the same document, so a retry after a\n21|// crash between the restore effects and the successor persist\n22|// converges instead of forking. The minted document is re-admitted\n23|// before return: a mint this entry cannot parse is refused rather\n24|// than persisted anywhere.\n25|func MintSuccessorBinding(prior Binding, generation string) (Binding, []byte, error) {\n26|\tempty := Binding{}\n27|\tif _, err := terminalbackend.GenerationDigest(generation); err != nil {\n28|\t\treturn empty, nil, err\n29|\t}\n30|\tif generation == prior.BackendGeneration {\n31|\t\treturn empty, nil, protocolRefusal(\"binding successor generation\")\n32|\t}\n33|\tobject := map[string]any{\n34|\t\t\"schema\":                 BindingSchema,\n35|\t\t\"schema_version\":         BindingSchemaVersion,\n36|\t\t\"binding_id\":             \"\",\n37|\t\t\"session_id\":             prior.SessionID,\n38|\t\t\"host_id\":                prior.HostID,\n39|\t\t\"host_incarnation_id\":    prior.HostIncarnationID,\n40|\t\t\"terminal_instance_id\":   prior.TerminalInstanceID,\n41|\t\t\"terminal_backend_id\":    prior.TerminalBackendID,\n42|\t\t\"implementation_version\": prior.ImplementationVersion,\n43|\t\t\"protocol_version\":       prior.ProtocolVersion,\n44|\t\t\"backend_generation\":     generation,\n45|\t\t\"native_reference\":       prior.NativeReference,\n46|\t\t\"created_at\":             prior.CreatedAt,\n47|\t\t\"supersedes_binding_id\":  prior.BindingID,\n48|\t\t\"extensions\":             map[string]any{},\n49|\t}\n50|\tstaged, err := json.Marshal(object)\n51|\tif err != nil {\n52|\t\treturn empty, nil, protocolRefusal(\"binding successor frame\")\n53|\t}\n54|\tidentity, err := bindingIdentity(staged, \"binding_id\")\n55|\tif err != nil {\n56|\t\treturn empty, nil, err\n57|\t}\n58|\tobject[\"binding_id\"] = identity\n59|\traw, err := json.Marshal(object)\n60|\tif err != nil {\n61|\t\treturn empty, nil, protocolRefusal(\"binding successor frame\")\n62|\t}\n63|\tminted, err := ParseTerminalBinding(raw)\n64|\tif err != nil {\n65|\t\treturn empty, nil, protocolRefusal(\"binding successor image\")\n66|\t}\n67|\treturn minted, raw, nil\n68|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
