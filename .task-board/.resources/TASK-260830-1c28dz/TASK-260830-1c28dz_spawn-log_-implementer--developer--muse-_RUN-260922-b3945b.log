{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d17f","stream":{"kind":"session","id":"01a0c765-6a15-7930-81af-9d81d9b3108a"},"sequence":1818,"recorded_at":1780531400003631,"record_type":"event","durability":"durable","causation_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","run_stream":{"kind":"run","id":"eb24712a-98eb-41ba-85bf-fe73b2577481"},"task_stream":{"kind":"task","id":"01a0c775-3550-7c03-b14b-ec810c7a036e"},"task_id":"01a0c775-3550-7c03-b14b-ec810c7a036e","event":{"kind":"output","task_id":"01a0c775-3550-7c03-b14b-ec810c7a036e","chunk":"Read text file `internal/tmuxserver/state.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"encoding/json\"\n7|\t\"errors\"\n8|\t\"fmt\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n14|)\n15|\n16|// InstanceStates is the durable AX-side state memory for tmux-hosted\n17|// terminal instances: one JSON document per instance under\n18|// <root>/tmuxlifecycle/instances/<instance_id>.json, installed by\n19|// atomic rename. tmux itself reports only presence (sessions, panes,\n20|// attached counts); the AX states quiescing, stopped, and stale_fenced\n21|// exist only on this side, so status reconciles the live tmux probe\n22|// against this memory (see ClassifyStatus). The store is MUTABLE —\n23|// every mutating operation records its after-state — unlike the\n24|// no-replace idempotency receipts, whose keys can never name a state.\n25|//\n26|// The store is rooted at a DURABLE data root, never the runtime root:\n27|// the runtime root is per-boot temporary, while status after reboot\n28|// must still distinguish a stopped instance from an absent one.\n29|type InstanceStates struct {\n30|\troot  string\n31|\thooks *StateHooks\n32|}\n33|\n34|// StateHooks arms the crash boundaries of the state install: after the\n35|// state bytes are staged to the temporary file (before the atomic\n36|// rename), and after the rename commits (before the directory sync\n37|// makes the commit durable). A nil hook is a no-op; a hook error aborts\n38|// the call with that error. Hooks is nil in production.\n39|type StateHooks struct {\n40|\tAfterStage   func(path string) error\n41|\tAfterInstall func(path string) error\n42|}\n43|\n44|// stateDocument is the stored shape: exactly schema, schema_version,\n45|// terminal_instance_id, and state.\n46|type stateDocument struct {\n47|\tSchema             string `json:\"schema\"`\n48|\tSchemaVersion      string `json:\"schema_version\"`\n49|\tTerminalInstanceID string `json:\"terminal_instance_id\"`\n50|\tState              string `json:\"state\"`\n51|}\n52|\n53|// OpenInstanceStates creates the store, ensuring the root exists. It\n54|// creates no instance documents: those appear with the first Record.\n55|func OpenInstanceStates(root string) (*InstanceStates, error) {\n56|\tif root == \"\" {\n57|\t\treturn nil, errors.New(\"tmux instance state root is empty\")\n58|\t}\n59|\tbase := filepath.Join(root, \"tmuxlifecycle\", \"instances\")\n60|\tif err := os.MkdirAll(base, 0o755); err != nil {\n61|\t\treturn nil, fmt.Errorf(\"create tmux instance state root: %w\", err)\n62|\t}\n63|\treturn &InstanceStates{root: root}, nil\n64|}\n65|\n66|// WithHooks returns the store with crash hooks armed.\n67|func (store *InstanceStates) WithHooks(hooks *StateHooks) *InstanceStates {\n68|\tstore.hooks = hooks\n69|\treturn store\n70|}\n71|\n72|func (store *InstanceStates) instancePath(instanceID string) string {\n73|\treturn filepath.Join(store.root, \"tmuxlifecycle\", \"instances\", instanceID+\".json\")\n74|}\n75|\n76|// Record stores the after-state of one mutating operation for one\n77|// instance. The install is atomic (stage, fsync, rename, directory\n78|// fsync): a crash leaves the previous state or the new state, never a\n79|// torn document, and a retry converges by re-recording. Only AX\n80|// lifecycle states record; creating never records (it exists only\n81|// between the idempotency receipt and the first side effect, and the\n82|// receipt already proves that window).\n83|func (store *InstanceStates) Record(instanceID string, state terminalbackend.InstanceState) error {\n84|\tif store == nil {\n85|\t\treturn errors.New(\"tmux instance state store is nil\")\n86|\t}\n87|\tif _, err := scalar.ParseUUIDv7(instanceID); err != nil {\n88|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance state identity\"}\n89|\t}\n90|\tif _, err := terminalbackend.ParseInstanceState(string(state)); err != nil {\n91|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance state value\"}\n92|\t}\n93|\tif state == terminalbackend.StateCreating {\n94|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance state value\"}\n95|\t}\n96|\traw, err := json.Marshal(stateDocument{\n97|\t\tSchema:             \"urn:ax:schema:tmux-instance-state\",\n98|\t\tSchemaVersion:      \"1.0.0\",\n99|\t\tTerminalInstanceID: instanceID,\n100|\t\tState:              string(state),\n101|\t})\n102|\tif err != nil {\n103|\t\treturn fmt.Errorf(\"encode tmux instance state: %w\", err)\n104|\t}\n105|\treturn store.install(instanceID, raw)\n106|}\n107|\n108|// Lookup replays the recorded state for one instance, or reports\n109|// absence when the instance was never recorded. A read or validation\n110|// failure is an error, never absence: unknown is not absent.\n111|func (store *InstanceStates) Lookup(instanceID string) (terminalbackend.InstanceState, bool, error) {\n112|\tif store == nil {\n113|\t\treturn \"\", false, errors.New(\"tmux instance state store is nil\")\n114|\t}\n115|\tif _, err := scalar.ParseUUIDv7(instanceID); err != nil {\n116|\t\treturn \"\", false, &Error{Code: CodeInvalidArguments, Detail: \"instance state identity\"}\n117|\t}\n118|\traw, err := os.ReadFile(store.instancePath(instanceID))\n119|\tif err != nil {\n120|\t\tif errors.Is(err, os.ErrNotExist) {\n121|\t\t\treturn \"\", false, nil\n122|\t\t}\n123|\t\treturn \"\", false, fmt.Errorf(\"read tmux instance state: %w\", err)\n124|\t}\n125|\tvar document stateDocument\n126|\tif err := json.Unmarshal(raw, &document); err != nil {\n127|\t\treturn \"\", false, fmt.Errorf(\"decode tmux instance state: %w\", err)\n128|\t}\n129|\tif document.TerminalInstanceID != instanceID {\n130|\t\treturn \"\", false, &Error{Code: CodeInvalidArguments, Detail: \"instance state identity\"}\n131|\t}\n132|\tstate, err := terminalbackend.ParseInstanceState(document.State)\n133|\tif err != nil {\n134|\t\treturn \"\", false, &Error{Code: CodeInvalidArguments, Detail: \"instance state value\"}\n135|\t}\n136|\treturn state, true, nil\n137|}\n138|\n139|// OperationOutcome is the persisted operation-specific report for one\n140|// idempotency key: the closure timestamps the wire result carries\n141|// outside the mutation receipt (InputClosedAt for quiesce-input,\n142|// BoundaryObservedAt for wait-safe-boundary). The receipt proves the\n143|// effect; this document proves the reported time. First success\n144|// records; every retry replays the recorded values, so the same\n145|// receipt never changes its closure time.\n146|type OperationOutcome struct {\n147|\tOperation          string\n148|\tInputClosedAt      string\n149|\tBoundaryObservedAt string\n150|}\n151|\n152|// outcomeDocument is the stored outcome shape.\n153|type outcomeDocument struct {\n154|\tSchema             string `json:\"schema\"`\n155|\tSchemaVersion      string `json:\"schema_version\"`\n156|\tIdempotencyKey     string `json:\"idempotency_key\"`\n157|\tOperation          string `json:\"operation\"`\n158|\tInputClosedAt      string `json:\"input_closed_at\"`\n159|\tBoundaryObservedAt string `json:\"boundary_observed_at\"`\n160|}\n161|\n162|// RecordOutcome stores the operation-specific report for one\n163|// idempotency key. Keys carry slashes, so the document name is the\n164|// hex SHA-256 of the key; the key itself is echoed inside for the\n165|// lookup to verify. The install is atomic like Record. A concurrent\n166|// duplicate first-completion may record either report; sequential\n167|// retries are stable, which is the tested property.\n168|func (store *InstanceStates) RecordOutcome(key string, outcome OperationOutcome) error {\n169|\tif store == nil {\n170|\t\treturn errors.New(\"tmux instance state store is nil\")\n171|\t}\n172|\tif key == \"\" {\n173|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance outcome key\"}\n174|\t}\n175|\traw, err := json.Marshal(outcomeDocument{\n176|\t\tSchema:             \"urn:ax:schema:tmux-operation-outcome\",\n177|\t\tSchemaVersion:      \"1.0.0\",\n178|\t\tIdempotencyKey:     key,\n179|\t\tOperation:          outcome.Operation,\n180|\t\tInputClosedAt:      outcome.InputClosedAt,\n181|\t\tBoundaryObservedAt: outcome.BoundaryObservedAt,\n182|\t})\n183|\tif err != nil {\n184|\t\treturn fmt.Errorf(\"encode tmux operation outcome: %w\", err)\n185|\t}\n186|\tsum := sha256.Sum256([]byte(key))\n187|\treturn store.installDocument(filepath.Join(\"tmuxlifecycle\", \"outcomes\"), hex.EncodeToString(sum[:])+\".json\", raw)\n188|}\n189|\n190|// LookupOutcome replays the recorded report for one idempotency key,\n191|// or reports absence when the key never completed an outcome record.\n192|// A read or validation failure is an error, never absence.\n193|func (store *InstanceStates) LookupOutcome(key string) (OperationOutcome, bool, error) {\n194|\tif store == nil {\n195|\t\treturn OperationOutcome{}, false, errors.New(\"tmux instance state store is nil\")\n196|\t}\n197|\tif key == \"\" {\n198|\t\treturn OperationOutcome{}, false, &Error{Code: CodeInvalidArguments, Detail: \"instance outcome key\"}\n199|\t}\n200|\tsum := sha256.Sum256([]byte(key))\n201|\traw, err := os.ReadFile(filepath.Join(store.root, \"tmuxlifecycle\", \"outcomes\", hex.EncodeToString(sum[:])+\".json\"))\n202|\tif err != nil {\n203|\t\tif errors.Is(err, os.ErrNotExist) {\n204|\t\t\treturn OperationOutcome{}, false, nil\n205|\t\t}\n206|\t\treturn OperationOutcome{}, false, fmt.Errorf(\"read tmux operation outcome: %w\", err)\n207|\t}\n208|\tvar document outcomeDocument\n209|\tif err := json.Unmarshal(raw, &document); err != nil {\n210|\t\treturn OperationOutcome{}, false, fmt.Errorf(\"decode tmux operation outcome: %w\", err)\n211|\t}\n212|\tif document.IdempotencyKey != key {\n213|\t\treturn OperationOutcome{}, false, &Error{Code: CodeInvalidArguments, Detail: \"instance outcome key\"}\n214|\t}\n215|\treturn OperationOutcome{\n216|\t\tOperation:          document.Operation,\n217|\t\tInputClosedAt:      document.InputClosedAt,\n218|\t\tBoundaryObservedAt: document.BoundaryObservedAt,\n219|\t}, true, nil\n220|}\n221|\n222|// RecordBindingDoc stores the create-time Terminal Instance Binding\n223|// document for one (session, bootstrap) pair, so restore can return\n224|// the required binding without minting (the JCS identity rule stays\n225|// termbind-private: this store never computes digests, it only keeps\n226|// the bytes create carried). The document must be a JSON object; its\n227|// binding identity is re-admitted by termbind on the restore read,\n228|// never here.\n229|func (store *InstanceStates) RecordBindingDoc(sessionID, bootstrapID string, doc []byte) error {\n230|\tif store == nil {\n231|\t\treturn errors.New(\"tmux instance state store is nil\")\n232|\t}\n233|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n234|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance binding identity\"}\n235|\t}\n236|\tif _, err := scalar.ParseUUIDv7(bootstrapID); err != nil {\n237|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance binding identity\"}\n238|\t}\n239|\tvar probe map[string]any\n240|\tif err := json.Unmarshal(doc, &probe); err != nil {\n241|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance binding document\"}\n242|\t}\n243|\treturn store.installDocument(filepath.Join(\"tmuxlifecycle\", \"bindings\", sessionID), bootstrapID+\".json\", doc)\n244|}\n245|\n246|// LookupBindingDoc replays the stored binding document for one\n247|// (session, bootstrap) pair, or reports absence when the pair never\n248|// recorded one. A read failure is an error, never absence.\n249|func (store *InstanceStates) LookupBindingDoc(sessionID, bootstrapID string) ([]byte, bool, error) {\n250|\tif store == nil {\n251|\t\treturn nil, false, errors.New(\"tmux instance state store is nil\")\n252|\t}\n253|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n254|\t\treturn nil, false, &Error{Code: CodeInvalidArguments, Detail: \"instance binding identity\"}\n255|\t}\n256|\tif _, err := scalar.ParseUUIDv7(bootstrapID); err != nil {\n257|\t\treturn nil, false, &Error{Code: CodeInvalidArguments, Detail: \"instance binding identity\"}\n258|\t}\n259|\traw, err := os.ReadFile(filepath.Join(store.root, \"tmuxlifecycle\", \"bindings\", sessionID, bootstrapID+\".json\"))\n260|\tif err != nil {\n261|\t\tif errors.Is(err, os.ErrNotExist) {\n262|\t\t\treturn nil, false, nil\n263|\t\t}\n264|\t\treturn nil, false, fmt.Errorf(\"read tmux binding document: %w\", err)\n265|\t}\n266|\treturn raw, true, nil\n267|}\n268|\n269|// install stages the state bytes to a same-directory temporary file,\n270|// fsyncs it, atomically renames it over the instance document (rename\n271|// is the mutable commit: the new state supersedes), removes no prior\n272|// name, and fsyncs the directory. Stale staging files from a\n273|// pre-commit crash are swept before the install.\n274|func (store *InstanceStates) install(instanceID string, raw []byte) error {\n275|\treturn store.installDocument(filepath.Join(\"tmuxlifecycle\", \"instances\"), instanceID+\".json\", raw)\n276|}\n277|\n278|// installDocument stages raw bytes to a same-directory temporary file\n279|// and atomically renames them over the named document under the\n280|// store root, sweeping stale staging files first and fsyncing the\n281|// directory after. Crash hooks fire at the same two boundaries as the\n282|// state install. rel is relative to the store root.\n283|func (store *InstanceStates) installDocument(rel, name string, raw []byte) error {\n284|\tdir := filepath.Join(store.root, rel)\n285|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n286|\t\treturn fmt.Errorf(\"create tmux instance state directory: %w\", err)\n287|\t}\n288|\tsweepStateStaging(dir)\n289|\ttarget := filepath.Join(dir, name)\n290|\tstaged, err := os.CreateTemp(dir, \"state-*.tmp\")\n291|\tif err != nil {\n292|\t\treturn fmt.Errorf(\"stage tmux instance state: %w\", err)\n293|\t}\n294|\tstagedPath := staged.Name()\n295|\tcommitted := false\n296|\tdefer func() {\n297|\t\tif !committed {\n298|\t\t\t_ = os.Remove(stagedPath)\n299|\t\t}\n300|\t}()\n301|\tif err := staged.Chmod(0o600); err != nil {\n302|\t\t_ = staged.Close()\n303|\t\treturn fmt.Errorf(\"protect tmux instance state: %w\", err)\n304|\t}\n305|\tif _, err := staged.Write(raw); err != nil {\n306|\t\t_ = staged.Close()\n307|\t\treturn fmt.Errorf(\"write tmux instance state: %w\", err)\n308|\t}\n309|\tif err := staged.Sync(); err != nil {\n310|\t\t_ = staged.Close()\n311|\t\treturn fmt.Errorf(\"sync tmux instance state: %w\", err)\n312|\t}\n313|\tif err := staged.Close(); err != nil {\n314|\t\treturn fmt.Errorf(\"close tmux instance state: %w\", err)\n315|\t}\n316|\tif store.hooks != nil && store.hooks.AfterStage != nil {\n317|\t\tif err := store.hooks.AfterStage(stagedPath); err != nil {\n318|\t\t\treturn err\n319|\t\t}\n320|\t}\n321|\tif err := os.Rename(stagedPath, target); err != nil {\n322|\t\treturn fmt.Errorf(\"install tmux instance state: %w\", err)\n323|\t}\n324|\tcommitted = true\n325|\tif store.hooks != nil && store.hooks.AfterInstall != nil {\n326|\t\tif err := store.hooks.AfterInstall(target); err != nil {\n327|\t\t\treturn err\n328|\t\t}\n329|\t}\n330|\tif err := syncStateDirectory(dir); err != nil {\n331|\t\treturn err\n332|\t}\n333|\treturn nil\n334|}\n335|\n336|// sweepStateStaging removes stale staging files from pre-commit\n337|// crashes. Only the state-*.tmp pattern is swept; instance documents\n338|// are never touched.\n339|func sweepStateStaging(dir string) {\n340|\tentries, err := os.ReadDir(dir)\n341|\tif err != nil {\n342|\t\treturn\n343|\t}\n344|\tfor _, entry := range entries {\n345|\t\tname := entry.Name()\n346|\t\tif len(name) > 10 && name[:6] == \"state-\" && filepath.Ext(name) == \".tmp\" {\n347|\t\t\t_ = os.Remove(filepath.Join(dir, name))\n348|\t\t}\n349|\t}\n350|}\n351|\n352|// syncStateDirectory fsyncs the directory so the rename commit is\n353|// durable before Record returns.\n354|func syncStateDirectory(path string) error {\n355|\tdir, err := os.Open(path)\n356|\tif err != nil {\n357|\t\treturn err\n358|\t}\n359|\tdefer func() { _ = dir.Close() }()\n360|\treturn dir.Sync()\n361|}","final_result":true}}}
