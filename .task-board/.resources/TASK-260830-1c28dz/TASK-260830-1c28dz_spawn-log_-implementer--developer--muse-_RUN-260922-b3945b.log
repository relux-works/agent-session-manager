{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ed95","stream":{"kind":"session","id":"01a0c765-6a15-7930-81af-9d81d9b3108a"},"sequence":5413,"recorded_at":1780531400010821,"record_type":"event","durability":"durable","causation_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","run_stream":{"kind":"run","id":"eb24712a-98eb-41ba-85bf-fe73b2577481"},"task_stream":{"kind":"task","id":"01a0c791-a5fe-7472-abdd-389a51ae9ff3"},"task_id":"01a0c791-a5fe-7472-abdd-389a51ae9ff3","event":{"kind":"output","task_id":"01a0c791-a5fe-7472-abdd-389a51ae9ff3","chunk":"{\n  \"chunk_id\": \"exec-183-1\",\n  \"command\": \"cd /Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2t4g7i/worktree && sed -n '1,64p' internal/tmuxserver/mutant_harness.py; echo \\\"=== deps rows ===\\\"; grep -n '\\\"N-lifecycle-deps\\\\|lifecycle dependencies' internal/tmuxserver/mutant_harness.py | head -6; echo \\\"=== termbind harness ===\\\"; ls internal/termbind/mutant_harness.py 2>&1\",\n  \"description\": \"Read harness structure and deps rows\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"#!/usr/bin/env python3\\n\\\"\\\"\\\"Narrowing-mutant harness for internal/tmuxserver.\\n\\nEvery gate ships a narrowing mutant: the gate stays present and is\\nweakened to admit exactly one member of the class it must reject, and\\nthe named killer tests must fail. A delete-only mutant proves only that\\nthe gate exists and is not accepted as evidence; rows D-background-fallback\\nand D-background-fallback-foreground are the two explicitly supplementary\\nadditive plants (reviewer-shaped direct-creation calls on the background\\npath), labeled as such and not counted as any gate's narrowing.\\n\\nEach row runs M (mutate production files in place), R (run the scoped Go\\nkillers through the production entries), V (verdict from the Go exit code\\nplus a FAIL kill-line: KILLED iff R fails with a test failure line,\\nSURVIVED iff R passes, ERROR for anything else -- unapplied patches,\\nbuild breaks, timeouts). M failures and R infrastructure errors are\\nERROR, never kills or survivals. Files are restored from backups after\\nevery row, pass or fail.\\n\\nRow C-control is the harmless control: a comment-only edit that must\\nSURVIVE, proving the harness observes test outcomes instead of\\nhard-coding kills.\\n\\nUsage:\\n  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py\\n  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py N-mode-create\\n  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py --log-dir /tmp/mutant-logs\\n  AX_MUTANT_VERBOSE=1 PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py N-mode-create\\n\\\"\\\"\\\"\\n\\nimport os\\nimport shutil\\nimport subprocess\\nimport sys\\nimport tempfile\\nfrom dataclasses import dataclass\\nfrom pathlib import Path\\n\\nREPO = Path(__file__).resolve().parents[2]\\nPACKAGE = \\\"internal/tmuxserver\\\"\\n\\n\\n@dataclass(frozen=True)\\nclass Mutant:\\n    name: str\\n    path: str\\n    find: str\\n    replace: str\\n    count: int\\n    run: str\\n    expect: str\\n    note: str\\n\\n\\nBG_MISS = \\\"TestAcquireBackgroundMissReturnsTypedUnavailable\\\"\\nBG_MISS_LINUX = \\\"(TestAcquireBackgroundMissReturnsTypedUnavailable|TestAcquireBackgroundMissOnLinuxAlsoRefusesWithoutFallback)\\\"\\nOVERRIDE = \\\"TestAcquireRefusesEveryAmbientOverrideVector\\\"\\nRES_OVERRIDE = \\\"(TestAcquireRefusesEveryAmbientOverrideVector|TestResolveSocketRefusesEveryOverrideVector)\\\"\\nWIDENED = \\\"TestEnsureRuntimeDirRefusesWidenedMode\\\"\\nCOLLISION = \\\"(TestResolveSocketRefusesAmbientCollision|TestAcquireRefusesAmbientCollision)\\\"\\n\\nMUTANTS = [\\n    Mutant(\\n        name=\\\"N-mode-create\\\",\\n=== deps rows ===\\n=== termbind harness ===\\ninternal/termbind/mutant_harness.py\\n\",\n  \"original_output_bytes\": 2553,\n  \"original_output_tokens\": 639,\n  \"truncated\": false\n}","final_result":true}}}
