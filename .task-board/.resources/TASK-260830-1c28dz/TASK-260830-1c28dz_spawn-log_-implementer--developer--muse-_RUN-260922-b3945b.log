{"schema_version":1,"id":"018f0000-0000-7000-8000-000000010263","stream":{"kind":"session","id":"01a0c765-6a15-7930-81af-9d81d9b3108a"},"sequence":8076,"recorded_at":1780531400016147,"record_type":"event","durability":"durable","causation_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","run_stream":{"kind":"run","id":"eb24712a-98eb-41ba-85bf-fe73b2577481"},"task_stream":{"kind":"task","id":"01a0c7b4-df68-75a1-9180-9d326bfae9f2"},"task_id":"01a0c7b4-df68-75a1-9180-9d326bfae9f2","event":{"kind":"output","task_id":"01a0c7b4-df68-75a1-9180-9d326bfae9f2","chunk":"Read text file `internal/tmuxserver/wrapper_unix_test.go`.\n(394 line(s) above)\n395|// local grant under a refreshed remote winner offers remote attach\n396|// (or takeover when attach is not capable) without running any\n397|// backend operation. The refresh runs before the decision, so the\n398|// offer path never presents the lapsed grant to backend restore\n399|// authorization — backend authorization stays intact and is never\n400|// consulted here.\n401|func TestWrapperRestoreLapsedGrantRemoteOffer(t *testing.T) {\n402|\tcases := []struct {\n403|\t\tname           string\n404|\t\tattachAdmitted bool\n405|\t\twant           axpane.Action\n406|\t}{\n407|\t\t{\"attach\", true, axpane.ActionAttachRemote},\n408|\t\t{\"takeover\", false, axpane.ActionTakeoverOffer},\n409|\t}\n410|\tfor _, tc := range cases {\n411|\t\tt.Run(tc.name, func(t *testing.T) {\n412|\t\t\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n413|\t\t\tfx.lc.LocalHostID = lxHost\n414|\t\t\trefreshed := false\n415|\t\t\tfx.lc.LeaseRefresh = func(ctx context.Context, session string) (RefreshWinner, error) {\n416|\t\t\t\trefreshed = true\n417|\t\t\t\tif session != lxSession {\n418|\t\t\t\t\tt.Errorf(\"refresh session = %s\", session)\n419|\t\t\t\t}\n420|\t\t\t\treturn RefreshWinner{LeaseID: lxLeaseB, Epoch: 9, HolderHostID: lxRemoteHost}, nil\n421|\t\t\t}\n422|\t\t\toutcome, err := fx.lc.ExecuteWrapperRestore(context.Background(), WrapperRestoreRequest{\n423|\t\t\t\tDecide:   wDecideInput(t, tc.attachAdmitted),\n424|\t\t\t\tGrant:    wGrant(t, wLapsedValidatedAt),\n425|\t\t\t\tHasGrant: true,\n426|\t\t\t\tPolicy:   wPolicy(),\n427|\t\t\t\tRestore:  wRestoreRequest(t),\n428|\t\t\t})\n429|\t\t\tif err != nil {\n430|\t\t\t\tt.Fatal(err)\n431|\t\t\t}\n432|\t\t\tif !refreshed {\n433|\t\t\t\tt.Fatal(\"decision ran without the mesh refresh\")\n434|\t\t\t}\n435|\t\t\tif outcome.Decision.Action != tc.want {\n436|\t\t\t\tt.Fatalf(\"action = %s (%v), want %s\", outcome.Decision.Action, outcome.Decision.Cause, tc.want)\n437|\t\t\t}\n438|\t\t\tif !outcome.RefreshAttempted || !outcome.RefreshSucceeded {\n439|\t\t\t\tt.Fatalf(\"refresh audit = %+v\", outcome)\n440|\t\t\t}\n441|\t\t\tif outcome.WinnerLeaseID != lxLeaseB || outcome.WinnerHostID != lxRemoteHost {\n442|\t\t\t\tt.Fatalf(\"winner = %+v\", outcome)\n443|\t\t\t}\n444|\t\t\tif outcome.Restore != nil {\n445|\t\t\t\tt.Fatalf(\"offer executed backend restore: %+v\", outcome.Restore)\n446|\t\t\t}\n447|\t\t\tif fx.runner.callCount() != 0 {\n448|\t\t\t\tt.Fatalf(\"offer executed %v\", fx.runner.subcommands())\n449|\t\t\t}\n450|\t\t})\n451|\t}\n452|}\n453|\n454|// TestWrapperRestoreLocalWinResumes pins the resume effect: a\n455|// verified local win with valid materialization launches, and the\n456|// launch executes the backend restore exactly once (the wrapper\n457|// recreates; the bindings prove it).\n458|func TestWrapperRestoreLocalWinResumes(t *testing.T) {\n459|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n460|\tfx.lc.LocalHostID = lxHost\n461|\tfx.lc.LeaseRefresh = func(ctx context.Context, session string) (RefreshWinner, error) {\n462|\t\treturn RefreshWinner{LeaseID: lxLease, Epoch: 7, HolderHostID: lxHost}, nil\n463|\t}\n464|\trecordBinding(t, fx, lxDigestA)\n465|\tfx.runner.queue(\"new-session\", \"\", 0)\n466|\toutcome, err := fx.lc.ExecuteWrapperRestore(context.Background(), WrapperRestoreRequest{\n467|\t\tDecide:   wDecideInput(t, true),\n468|\t\tGrant:    wGrant(t, wFreshValidatedAt),\n469|\t\tHasGrant: true,\n470|\t\tPolicy:   wPolicy(),\n471|\t\tRestore:  wRestoreRequest(t),\n472|\t})\n473|\tif err != nil {\n474|\t\tt.Fatal(err)\n475|\t}\n476|\tif outcome.Decision.Action != axpane.ActionLaunch {\n477|\t\tt.Fatalf(\"action = %s (%v), want launch\", outcome.Decision.Action, outcome.Decision.Cause)\n478|\t}\n479|\tif outcome.Restore == nil || outcome.Restore.Binding == nil {\n480|\t\tt.Fatalf(\"resume omits its restore outcome: %+v\", outcome.Restore)\n481|\t}\n482|\tif !outcome.Restore.RestoredParked {\n483|\t\tt.Fatalf(\"restore outcome = %+v\", outcome.Restore)\n484|\t}\n485|\tif got := fx.runner.subcommands(); len(got) != 1 || got[0] != \"new-session\" {\n486|\t\tt.Fatalf(\"resume executed %v, want exactly one wrapper recreation\", got)\n487|\t}\n488|}\n489|\n490|// TestWrapperRestoreReattachReplaysBackend pins the reattach route: a\n491|// recorded bootstrap pair reattaches through the backend restore,\n492|// which recreates the wrapper when the reboot-volatile receipt is\n493|// gone.\n494|func TestWrapperRestoreReattachReplaysBackend(t *testing.T) {\n495|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n496|\tfx.lc.LocalHostID = lxHost\n497|\tfx.lc.LeaseRefresh = func(ctx context.Context, session string) (RefreshWinner, error) {\n498|\t\treturn RefreshWinner{LeaseID: lxLease, Epoch: 7, HolderHostID: lxHost}, nil\n499|\t}\n500|\trecordBinding(t, fx, lxDigestA)\n501|\tfx.runner.queue(\"new-session\", \"\", 0)\n502|\tinput := wDecideInput(t, true)\n503|\tinput.SessionBound = true\n504|\tpair := recordedAxpaneBinding()\n505|\tinput.ExistingBinding = &pair\n506|\toutcome, err := fx.lc.ExecuteWrapperRestore(context.Background(), WrapperRestoreRequest{\n507|\t\tDecide:   input,\n508|\t\tGrant:    wGrant(t, wFreshValidatedAt),\n509|\t\tHasGrant: true,\n510|\t\tPolicy:   wPolicy(),\n511|\t\tRestore:  wRestoreRequest(t),\n512|\t})\n513|\tif err != nil {\n514|\t\tt.Fatal(err)\n515|\t}\n516|\tif outcome.Decision.Action != axpane.ActionReattach {\n517|\t\tt.Fatalf(\"action = %s (%v), want reattach\", outcome.Decision.Action, outcome.Decision.Cause)\n518|\t}\n519|\tif outcome.Restore == nil || outcome.Restore.Binding == nil {\n520|\t\tt.Fatalf(\"reattach omits its restore outcome: %+v\", outcome.Restore)\n521|\t}\n522|\tif got := fx.runner.subcommands(); len(got) != 1 || got[0] != \"new-session\" {\n523|\t\tt.Fatalf(\"reattach executed %v\", got)\n524|\t}\n525|}\n526|\n527|// TestWrapperRestoreParksWithoutEffects pins every park branch: a\n528|// non-interactive remote owner, a failed refresh (unverified local\n529|// knowledge), a missing refresh adapter, no known lease at all, and\n530|// an invalid materialization each park with no backend operation, no\n531|// tmux exec, and no provider.\n532|func TestWrapperRestoreParksWithoutEffects(t *testing.T) {\n533|\tsetup := func(t *testing.T, mutate func(fx *lxFixture, input *axpane.Input)) (*lxFixture, axpane.Input) {\n534|\t\tt.Helper()\n535|\t\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n536|\t\tfx.lc.LocalHostID = lxHost\n537|\t\tinput := wDecideInput(t, true)\n538|\t\tmutate(fx, &input)\n539|\t\treturn fx, input\n540|\t}\n541|\tcases := []struct {\n542|\t\tname  string\n543|\t\tgrant string\n544|\t\tsetup func(t *testing.T) (*lxFixture, axpane.Input)\n545|\t}{\n546|\t\t{\"remote-noninteractive\", wLapsedValidatedAt, func(t *testing.T) (*lxFixture, axpane.Input) {\n547|\t\t\treturn setup(t, func(fx *lxFixture, input *axpane.Input) {\n548|\t\t\t\tfx.lc.LeaseRefresh = func(ctx context.Context, session string) (RefreshWinner, error) {\n549|\t\t\t\t\treturn RefreshWinner{LeaseID: lxLeaseB, Epoch: 9, HolderHostID: lxRemoteHost}, nil\n550|\t\t\t\t}\n551|\t\t\t\tinput.RemoteInteractive = false\n552|\t\t\t})\n553|\t\t}},\n554|\t\t{\"refresh-failed\", wFreshValidatedAt, func(t *testing.T) (*lxFixture, axpane.Input) {\n555|\t\t\treturn setup(t, func(fx *lxFixture, input *axpane.Input) {\n556|\t\t\t\tfx.lc.LeaseRefresh = func(ctx context.Context, session string) (RefreshWinner, error) {\n557|\t\t\t\t\treturn RefreshWinner{}, context.DeadlineExceeded\n558|\t\t\t\t}\n559|\t\t\t})\n560|\t\t}},\n561|\t\t{\"no-adapter\", wFreshValidatedAt, func(t *testing.T) (*lxFixture, axpane.Input) {\n562|\t\t\treturn setup(t, func(fx *lxFixture, input *axpane.Input) {})\n563|\t\t}},\n564|\t\t{\"no-known-lease\", wFreshValidatedAt, func(t *testing.T) (*lxFixture, axpane.Input) {\n565|\t\t\treturn setup(t, func(fx *lxFixture, input *axpane.Input) {\n566|\t\t\t\tfx.lc.LeaseRefresh = func(ctx context.Context, session string) (RefreshWinner, error) {\n567|\t\t\t\t\treturn RefreshWinner{}, context.DeadlineExceeded\n568|\t\t\t\t}\n569|\t\t\t\tfx.lc.CurrentLease = func() terminstance.LeaseView { return terminstance.LeaseView{} }\n570|\t\t\t})\n571|\t\t}},\n572|\t\t{\"invalid-material\", wFreshValidatedAt, func(t *testing.T) (*lxFixture, axpane.Input) {\n573|\t\t\treturn setup(t, func(fx *lxFixture, input *axpane.Input) {\n574|\t\t\t\tfx.lc.LeaseRefresh = func(ctx context.Context, session string) (RefreshWinner, error) {\n575|\t\t\t\t\treturn RefreshWinner{LeaseID: lxLease, Epoch: 7, HolderHostID: lxHost}, nil\n576|\t\t\t\t}\n577|\t\t\t\tinput.JournalOK = false\n578|\t\t\t\t// The backend stands ready: a routing mutant that\n579|\t\t\t\t// admits this park into execution consumes the\n580|\t\t\t\t// vector and sets Restore, failing both pins.\n581|\t\t\t\trecordBinding(t, fx, lxDigestA)\n582|\t\t\t\tfx.runner.queue(\"new-session\", \"\", 0)\n583|\t\t\t})\n584|\t\t}},\n585|\t}\n586|\tfor _, tc := range cases {\n587|\t\tt.Run(tc.name, func(t *testing.T) {\n588|\t\t\tfx, input := tc.setup(t)\n589|\t\t\toutcome, err := fx.lc.ExecuteWrapperRestore(context.Background(), WrapperRestoreRequest{\n590|\t\t\t\tDecide:   input,\n591|\t\t\t\tGrant:    wGrant(t, tc.grant),\n592|\t\t\t\tHasGrant: true,\n593|\t\t\t\tPolicy:   wPolicy(),\n594|\t\t\t\tRestore:  wRestoreRequest(t),\n595|\t\t\t})\n596|\t\t\tif err != nil {\n597|\t\t\t\tt.Fatal(err)\n598|\t\t\t}\n599|\t\t\tif outcome.Decision.Action != axpane.ActionParked {\n600|\t\t\t\tt.Fatalf(\"action = %s (%v), want parked\", outcome.Decision.Action, outcome.Decision.Cause)\n601|\t\t\t}\n602|\t\t\tif outcome.Restore != nil {\n603|\t\t\t\tt.Fatalf(\"park executed backend restore: %+v\", outcome.Restore)\n604|\t\t\t}\n605|\t\t\tif fx.runner.callCount() != 0 {\n606|\t\t\t\tt.Fatalf(\"park executed %v\", fx.runner.subcommands())\n607|\t\t\t}\n608|\t\t\tif tc.name == \"invalid-material\" {\n609|\t\t\t\tif outcome.Decision.Cause == nil ||\n610|\t\t\t\t\toutcome.Decision.Cause.Error() != \"required materialization is not admitted\" {\n611|\t\t\t\t\tt.Fatalf(\"cause = %v\", outcome.Decision.Cause)\n612|\t\t\t\t}\n613|\t\t\t}\n614|\t\t})\n615|\t}\n616|}\n617|\n618|// TestWrapperRestoreRefusesMalformed pins the entry's own gates: a\n619|// non-restore mode, a non-restore resume request, and missing\n620|// lifecycle dependencies each refuse before any decision or effect.\n621|func TestWrapperRestoreRefusesMalformed(t *testing.T) {\n622|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n623|\tfx.lc.LocalHostID = lxHost\n624|\tlaunch := wDecideInput(t, true)\n625|\tlaunch.Mode = axpane.ModeLaunch\n626|\tif _, err := fx.lc.ExecuteWrapperRestore(context.Background(), WrapperRestoreRequest{\n627|\t\tDecide: launch, Grant: wGrant(t, wFreshValidatedAt), HasGrant: true, Policy: wPolicy(), Restore: wRestoreRequest(t),\n628|\t}); err == nil {\n629|\t\tt.Fatal(\"non-restore mode admitted\")\n630|\t} else {\n631|\t\trequireLocalCode(t, err, \"tmux_invalid_arguments\", \"wrapper restore mode\")\n632|\t}\n633|\tstatusReq := wRestoreRequest(t)\n634|\tstatusReq.Operation = \"status\"\n635|\tif _, err := fx.lc.ExecuteWrapperRestore(context.Background(), WrapperRestoreRequest{\n636|\t\tDecide: wDecideInput(t, true), Grant: wGrant(t, wFreshValidatedAt), HasGrant: true, Policy: wPolicy(), Restore: statusReq,\n637|\t}); err == nil {\n638|\t\tt.Fatal(\"non-restore resume request admitted\")\n639|\t} else {\n640|\t\trequireLocalCode(t, err, \"tmux_invalid_arguments\", \"wrapper restore operation\")\n641|\t}\n642|\t// Garbage values stay refused while the narrowing rows admit\n643|\t// exactly one shape each (narrowness in the log).\n644|\tevilMode := wDecideInput(t, true)\n645|\tevilMode.Mode = axpane.Mode(\"evil\")\n646|\tif _, err := fx.lc.ExecuteWrapperRestore(context.Background(), WrapperRestoreRequest{\n647|\t\tDecide: evilMode, Grant: wGrant(t, wFreshValidatedAt), HasGrant: true, Policy: wPolicy(), Restore: wRestoreRequest(t),\n648|\t}); err == nil {\n649|\t\tt.Fatal(\"garbage mode admitted\")\n650|\t} else {\n651|\t\trequireLocalCode(t, err, \"tmux_invalid_arguments\", \"wrapper restore mode\")\n652|\t}\n653|\tevilOp := wRestoreRequest(t)\n654|\tevilOp.Operation = \"evil-operation\"\n655|\tif _, err := fx.lc.ExecuteWrapperRestore(context.Background(), WrapperRestoreRequest{\n656|\t\tDecide: wDecideInput(t, true), Grant: wGrant(t, wFreshValidatedAt), HasGrant: true, Policy: wPolicy(), Restore: evilOp,\n657|\t}); err == nil {\n658|\t\tt.Fatal(\"garbage resume operation admitted\")\n659|\t} else {\n660|\t\trequireLocalCode(t, err, \"tmux_invalid_arguments\", \"wrapper restore operation\")\n661|\t}\n662|\tbare := &Lifecycle{}\n663|\tif _, err := bare.ExecuteWrapperRestore(context.Background(), WrapperRestoreRequest{\n664|\t\tDecide: wDecideInput(t, true), Grant: wGrant(t, wFreshValidatedAt), HasGrant: true, Policy: wPolicy(), Restore: wRestoreRequest(t),\n665|\t}); err == nil {\n666|\t\tt.Fatal(\"bare lifecycle admitted\")\n667|\t} else {\n668|\t\trequireLocalCode(t, err, \"terminal_backend_protocol_error\", \"lifecycle dependencies\")\n669|\t}\n670|\tif fx.runner.callCount() != 0 {\n671|\t\tt.Fatalf(\"malformed entries executed %v\", fx.runner.subcommands())\n672|\t}\n673|}\n674|\n675|// TestWrapperRestoreRefreshBoundMeasured pins the measured refresh\n676|// bound: a refresh that blocks until cancellation returns at the\n677|// configured bound (not never), the attempt is audited, a missing\n678|// configuration audits the default bound, and the entry parks over\n679|// unverified local knowledge.\n680|func TestWrapperRestoreRefreshBoundMeasured(t *testing.T) {\n681|\tt.Run(\"configured-50ms\", func(t *testing.T) {\n682|\t\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n683|\t\tfx.lc.LocalHostID = lxHost\n684|\t\tfx.lc.MeshRefreshTimeout = 50 * time.Millisecond\n685|\t\tvar observed error\n686|\t\tfx.lc.LeaseRefresh = func(ctx context.Context, session string) (RefreshWinner, error) {\n687|\t\t\t<-ctx.Done()\n688|\t\t\tobserved = ctx.Err()\n689|\t\t\treturn RefreshWinner{}, ctx.Err()\n690|\t\t}\n691|\t\tstart := time.Now()\n692|\t\toutcome, err := fx.lc.ExecuteWrapperRestore(context.Background(), WrapperRestoreRequest{\n693|\t\t\tDecide: wDecideInput(t, true), Grant: wGrant(t, wFreshValidatedAt), HasGrant: true, Policy: wPolicy(), Restore: wRestoreRequest(t),\n694|\t\t})\n695|\t\telapsed := time.Since(start)\n696|\t\tif err != nil {\n697|\t\t\tt.Fatal(err)\n698|\t\t}\n699|\t\tif outcome.Decision.Action != axpane.ActionParked {\n700|\t\t\tt.Fatalf(\"action = %s (%v), want parked\", outcome.Decision.Action, outcome.Decision.Cause)\n701|\t\t}\n702|\t\tif !outcome.RefreshAttempted || outcome.RefreshSucceeded {\n703|\t\t\tt.Fatalf(\"refresh audit = %+v\", outcome)\n704|\t\t}\n705|\t\tif outcome.RefreshBoundMs != 50 {\n706|\t\t\tt.Fatalf(\"bound = %dms, want exactly the configured 50ms\", outcome.RefreshBoundMs)\n707|\t\t}\n708|\t\tif observed != context.DeadlineExceeded {\n709|\t\t\tt.Fatalf(\"refresh returned %v, want deadline-exceeded at the bound\", observed)\n710|\t\t}\n711|\t\tif elapsed >= 5*time.Second {\n712|\t\t\tt.Fatalf(\"refresh blocked %v under a 50ms bound\", elapsed)\n713|\t\t}\n714|\t\tif outcome.Restore != nil || fx.runner.callCount() != 0 {\n715|\t\t\tt.Fatalf(\"timed-out refresh executed: %+v %v\", outcome.Restore, fx.runner.subcommands())\n716|\t\t}\n717|\t\tt.Logf(\"refresh bound 50ms, wall elapsed %v, audit attempted=%v succeeded=%v\", elapsed, outcome.RefreshAttempted, outcome.RefreshSucceeded)\n718|\t})\n719|\tt.Run(\"default-5000ms\", func(t *testing.T) {\n720|\t\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n721|\t\tfx.lc.LocalHostID = lxHost\n722|\t\tfx.lc.LeaseRefresh = func(ctx context.Context, session string) (RefreshWinner, error) {\n723|\t\t\treturn RefreshWinner{}, context.DeadlineExceeded\n724|\t\t}\n(more lines below)","final_result":true}}}
