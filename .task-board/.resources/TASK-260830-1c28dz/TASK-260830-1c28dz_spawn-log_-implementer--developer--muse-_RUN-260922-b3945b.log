ities, the fencing material (for terminate-stale only), and\n-// the interactive flag (for restore only: whether the restore runs in\n-// an interactive terminal, which selects the remote-offer branch).\n-type OpRequest struct {\n-\tOperation            string\n-\tBody                 []byte\n-\tSource               string\n-\tAdmitted             terminalbackend.Admitted\n-\tPresented            fencing.PresentedToken\n-\tWinner               sessrepo.LeaseSummary\n-\tHasWinner            bool\n-\tForceRecovery        bool\n-\tDiagnosticsPreserved bool\n-\tInteractive          bool\n-}\n+// OpRequest is one lifecycle operation request: the operation name,\n+// its closed body, the presented source state, the admitted\n+// capabilities, and the fencing material (for terminate-stale only).\n+type OpRequest struct {\n+\tOperation            string\n+\tBody                 []byte\n+\tSource               string\n+\tAdmitted             terminalbackend.Admitted\n+\tPresented            fencing.PresentedToken\n+\tWinner               sessrepo.LeaseSummary\n+\tHasWinner            bool\n+\tForceRecovery        bool\n+\tDiagnosticsPreserved bool\n+}\n","edit_facts":{"tool_name":"edit_file","path":"internal/tmuxserver/lifecycle.go","added":14,"removed":46},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
