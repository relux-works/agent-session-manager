x := newLifecycleFixture(t, fullLifecycleAdmitted())\\n\\\\trecordBinding(t, fx, lxDigestA)\\n\\\\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\\n\\\\t\\\\tOperation: \\\"restore\\\",\\n\\\\t\\\\tBody: lxRestoreBody(t, lxDigestA, func(object map[string]any) {\\n\\\\t\\\\t\\\\tobject[\\\"context\\\"].(map[string]any)[\\\"authorization\\\"].(map[string]any)[\\\"expires_at\\\"] = \\\"2026-09-01T11:00:00.000Z\\\"\\n\\\\t\\\\t}),\\n\\\\t\\\\tSource: \\\"absent\\\", Admitted: fullLifecycleAdmitted(),\\n\\\\t})\\n\\\\tif err == nil {\\n\\\\t\\\\tt.Fatalf(\\\"expired grant admitted: %+v\\\", outcome.Binding)\\n\\\\t}\\n\\\\trequireEngineCode(t, err, \\\"terminal_backend_unauthorized\\\")\\n\\\\tif fx.runner.callCount() != 0 {\\n\\\\t\\\\tt.Fatalf(\\\"refused restore executed %v\\\", fx.runner.subcommands())\\n\\\\t}\\n}\\n\\n'''\\nlines[565:803] = [new_test]\\nopen(path, 'w').writelines(lines)\\nprint('replaced')\\nEOF\\ngofmt -l internal/tmuxserver/ ; go vet ./internal/tmuxserver/ 2>&1 | head -5\",\n  \"description\": \"Replace superseded tests with repurposed test\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"replaced\\n\",\n  \"original_output_bytes\": 9,\n  \"original_output_tokens\": 3,\n  \"truncated\": false\n}","final_result":true}}}
