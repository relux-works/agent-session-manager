{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d183","stream":{"kind":"session","id":"01a0c765-6a15-7930-81af-9d81d9b3108a"},"sequence":1820,"recorded_at":1780531400003635,"record_type":"event","durability":"durable","causation_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","run_stream":{"kind":"run","id":"eb24712a-98eb-41ba-85bf-fe73b2577481"},"call_id":"call_01a0c7753087738cb9dd16df715c6ccf","text":"Read text file `internal/tmuxserver/status.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"sort\"\n6|\t\"strconv\"\n7|\t\"strings\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n12|)\n13|\n14|// ObserveStatus reports the tmux observation for one status body: the\n15|// live probe (list-panes for presence and provider rows, list-sessions\n16|// for attached counts) reconciled against the AX-side state memory. An\n17|// error is unknown, never absent: transport failures, malformed probe\n18|// output, and contradictory probes all refuse without a report.\n19|func (runner *backend) ObserveStatus(ctx context.Context, body terminstance.StatusBody) (terminstance.StatusObservation, error) {\n20|\tempty := terminstance.StatusObservation{}\n21|\tinstance := body.TerminalInstanceID\n22|\tif !body.HasTerminalInstanceID {\n23|\t\tresolved, err := runner.resolveSessionInstance(body.SessionID)\n24|\t\tif err != nil {\n25|\t\t\treturn empty, err\n26|\t\t}\n27|\t\tif resolved == \"\" {\n28|\t\t\treturn runner.absentObservation(body), nil\n29|\t\t}\n30|\t\tinstance = resolved\n31|\t}\n32|\tpresent, panes, err := runner.probePanes(ctx, instance)\n33|\tif err != nil {\n34|\t\treturn empty, err\n35|\t}\n36|\tattached := 0\n37|\tif present {\n38|\t\tcount, err := runner.probeAttached(ctx, instance)\n39|\t\tif err != nil {\n40|\t\t\treturn empty, err\n41|\t\t}\n42|\t\tattached = count\n43|\t}\n44|\tmemory, found, err := runner.lookupMemory(instance)\n45|\tif err != nil {\n46|\t\treturn empty, err\n47|\t}\n48|\tstate, wrapper, provider, attachable := ClassifyStatus(ClassifyInput{\n49|\t\tPresent:         present,\n50|\t\tAttached:        attached,\n51|\t\tProviderRows:    len(panes),\n52|\t\tMemory:          memory,\n53|\t\tMemoryFound:     found,\n54|\t\tAttachCapable:   runner.attachCapable(),\n55|\t\tProviderWanted:  body.IncludeProviderObservation,\n56|\t\tProviderCapable: runner.admitted.Has(\"provider_process_observation\"),\n57|\t})\n58|\tproviderPresent, requested, evidenced := providerTriple(body.IncludeProviderObservation, runner.admitted.Has(\"provider_process_observation\"), provider)\n59|\tevidence := statusEvidence(instance, present, panes, attached)\n60|\treturn terminstance.StatusObservation{\n61|\t\tState:             state,\n62|\t\tIdentityMatch:     true,\n63|\t\tWrapperPresent:    wrapper,\n64|\t\tProviderPresent:   providerPresent,\n65|\t\tAttachable:        attachable,\n66|\t\tEvidenceIDs:       evidence,\n67|\t\tProviderRequested: requested,\n68|\t\tProviderEvidenced: evidenced,\n69|\t\tAttachEvidenced:   attachable,\n70|\t\tSessionID:         body.SessionID,\n71|\t\tInstanceID:        instance,\n72|\t\tBackendID:         body.TerminalBackendID,\n73|\t\tImplVersion:       body.ImplementationVersion,\n74|\t\tProtoVersion:      body.ProtocolVersion,\n75|\t\tGeneration:        body.BackendGeneration,\n76|\t}, nil\n77|}\n78|\n79|// resolveSessionInstance resolves a session-scoped query to the\n80|// session's recorded instance through the bootstrap binding store. An\n81|// unbound session resolves empty: it reads absent, never refused. A\n82|// binding read failure is unknown, never absence.\n83|func (runner *backend) resolveSessionInstance(sessionID string) (string, error) {\n84|\tif runner.bindings == nil {\n85|\t\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend binding store\"}\n86|\t}\n87|\tbinding, found, err := runner.bindings.Status(sessionID)\n88|\tif err != nil {\n89|\t\treturn \"\", err\n90|\t}\n91|\tif !found {\n92|\t\treturn \"\", nil\n93|\t}\n94|\treturn binding.TerminalInstanceID, nil\n95|}\n96|\n97|// absentObservation reports proven absence for an unbound session: the\n98|// absent shape with the queried session echoed, so the engine adopts a\n99|// match on the session it asked about and nothing else.\n100|func (runner *backend) absentObservation(body terminstance.StatusBody) terminstance.StatusObservation {\n101|\treturn terminstance.StatusObservation{\n102|\t\tState:             terminalbackend.StateAbsent,\n103|\t\tIdentityMatch:     true,\n104|\t\tWrapperPresent:    false,\n105|\t\tProviderPresent:   nil,\n106|\t\tAttachable:        false,\n107|\t\tEvidenceIDs:       []string{scalar.SHA256Digest([]byte(\"unbound\\n\" + body.SessionID)).String()},\n108|\t\tProviderRequested: body.IncludeProviderObservation,\n109|\t\tProviderEvidenced: false,\n110|\t\tAttachEvidenced:   false,\n111|\t\tSessionID:         body.SessionID,\n112|\t\tInstanceID:        body.TerminalInstanceID,\n113|\t\tBackendID:         body.TerminalBackendID,\n114|\t\tImplVersion:       body.ImplementationVersion,\n115|\t\tProtoVersion:      body.ProtocolVersion,\n116|\t\tGeneration:        body.BackendGeneration,\n117|\t}\n118|}\n119|\n120|// probePanes runs list-panes for one instance: exit 0 with at least one\n121|// row proves presence; a nonzero exit proves absence only with an\n122|// absence marker on stderr (no session, no window, or no server\n123|// socket under the verified path); any other nonzero exit —\n124|// permission failures, refused connections, killed children — is\n125|// unknown, never absent. A transport error is unknown. An exit-0\n126|// with zero rows is contradictory — a tmux session always has a\n127|// pane — and refuses as unknown rather than inventing presence.\n128|func (runner *backend) probePanes(ctx context.Context, instance string) (bool, []string, error) {\n129|\tsaved := runner.instanceID\n130|\trunner.instanceID = instance\n131|\tdefer func() { runner.instanceID = saved }()\n132|\targv, err := runner.command(DirectiveListPanes)\n133|\tif err != nil {\n134|\t\treturn false, nil, err\n135|\t}\n136|\tresult, err := runner.runner.Run(ctx, argv)\n137|\tif err != nil {\n138|\t\treturn false, nil, err\n139|\t}\n140|\tpresent, absent := classifyAbsence(result, absentMarkerNoSession, absentMarkerNoWindow, absentMarkerNoSocket)\n141|\tif absent {\n142|\t\treturn false, nil, nil\n143|\t}\n144|\tif !present {\n145|\t\treturn false, nil, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n146|\t}\n147|\trows := splitRows(string(result.Stdout))\n148|\tif len(rows) == 0 {\n149|\t\treturn false, nil, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n150|\t}\n151|\treturn true, rows, nil\n152|}\n153|\n154|// probeAttached reads the attached-client count for one present\n155|// instance from list-sessions. A missing row contradicts the presence\n156|// probe (the session vanished between the two commands, or the list is\n157|// corrupt) and refuses as unknown; a malformed count refuses the same\n158|// way. Neither invents attachability.\n159|func (runner *backend) probeAttached(ctx context.Context, instance string) (int, error) {\n160|\targv, err := runner.command(DirectiveListSessions)\n161|\tif err != nil {\n162|\t\treturn 0, err\n163|\t}\n164|\tresult, err := runner.runner.Run(ctx, argv)\n165|\tif err != nil {\n166|\t\treturn 0, err\n167|\t}\n168|\tif result.ExitCode != 0 {\n169|\t\treturn 0, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n170|\t}\n171|\tfor _, row := range splitRows(string(result.Stdout)) {\n172|\t\tname, count, ok := cutRow(row)\n173|\t\tif !ok {\n174|\t\t\treturn 0, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n175|\t\t}\n176|\t\tif name != instance {\n177|\t\t\tcontinue\n178|\t\t}\n179|\t\tattached, err := strconv.Atoi(count)\n180|\t\tif err != nil || attached < 0 {\n181|\t\t\treturn 0, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n182|\t\t}\n183|\t\treturn attached, nil\n184|\t}\n185|\treturn 0, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n186|}\n187|\n188|// lookupMemory reads the AX-side state memory for one instance. The\n189|// store may be nil in unit-scoped backends; a nil store reads as no\n190|// memory rather than refusing, because presence alone still classifies\n191|// the live triad (absent/parked/active).\n192|func (runner *backend) lookupMemory(instance string) (terminalbackend.InstanceState, bool, error) {\n193|\tif runner.states == nil {\n194|\t\treturn \"\", false, nil\n195|\t}\n196|\treturn runner.states.Lookup(instance)\n197|}\n198|\n199|// attachCapable reports whether any admitted attach capability\n200|// evidences presentation right now: local, remote, or web attach.\n201|func (runner *backend) attachCapable() bool {\n202|\treturn runner.admitted.Has(\"local_attach\") ||\n203|\t\trunner.admitted.Has(\"remote_attach\") ||\n204|\t\trunner.admitted.Has(\"web_attach\")\n205|}\n206|\n207|// providerTriple computes the provider_present member and its two\n208|// validation flags: the member is non-null only when observation was\n209|// requested and evidenced; the flags let the landed CheckStatusResult\n210|// verify that rule.\n211|func providerTriple(requested, capable, observed bool) (*bool, bool, bool) {\n212|\tif !requested || !capable {\n213|\t\treturn nil, requested, false\n214|\t}\n215|\tif !observed {\n216|\t\treturn nil, requested, false\n217|\t}\n218|\tpresent := true\n219|\treturn &present, requested, true\n220|}\n221|\n222|// statusEvidence derives the sorted-unique status evidence digests over\n223|// the probe record: presence, pane rows, and attached count. Absence\n224|// evidences the negative probe, never an empty set.\n225|func statusEvidence(instance string, present bool, panes []string, attached int) []string {\n226|\tvar evidence []string\n227|\tif !present {\n228|\t\tevidence = append(evidence, scalar.SHA256Digest([]byte(\"absent\\n\"+instance)).String())\n229|\t} else {\n230|\t\tevidence = append(evidence, scalar.SHA256Digest([]byte(\"panes\\n\"+instance+\"\\n\"+strings.Join(panes, \"\\n\"))).String())\n231|\t\tevidence = append(evidence, scalar.SHA256Digest([]byte(\"sessions\\n\"+instance+\"\\n\"+strconv.Itoa(attached))).String())\n232|\t}\n233|\tsort.Strings(evidence)\n234|\treturn evidence\n235|}\n236|\n237|// splitRows splits probe stdout into non-empty rows. Blank lines are\n238|// skipped: tmux never emits them, and skipping is the tolerant read;\n239|// a wholly blank output yields zero rows, which the callers refuse.\n240|func splitRows(output string) []string {\n241|\tvar rows []string\n242|\tfor _, line := range strings.Split(output, \"\\n\") {\n243|\t\tif line != \"\" {\n244|\t\t\trows = append(rows, line)\n245|\t\t}\n246|\t}\n247|\treturn rows\n248|}\n249|\n250|// cutRow splits one sessions row into name and attached count. Rows\n251|// without the pipe separator are malformed.\n252|func cutRow(row string) (string, string, bool) {\n253|\tname, count, found := strings.Cut(row, \"|\")\n254|\tif !found || name == \"\" || count == \"\" {\n255|\t\treturn \"\", \"\", false\n256|\t}\n257|\treturn name, count, true\n258|}\n259|\n260|// ClassifyInput is the pure status-classification input: the live tmux\n261|// probe (presence, attached count, provider rows) plus the AX-side\n262|// memory and the capability facts.\n263|type ClassifyInput struct {\n264|\tPresent         bool\n265|\tAttached        int\n266|\tProviderRows    int\n267|\tMemory          terminalbackend.InstanceState\n268|\tMemoryFound     bool\n269|\tAttachCapable   bool\n270|\tProviderWanted  bool\n271|\tProviderCapable bool\n272|\t_               struct{}\n273|}\n274|\n275|// ClassifyStatus reconciles the live tmux probe against the AX-side\n276|// state memory into the adopted status: state, wrapper presence,\n277|// provider presence, and attachability. tmux reports only presence;\n278|// the memory carries quiescing, stopped, and stale_fenced, which exist\n279|// only on this side. The rules:\n280|//\n281|//   - absent probe, no memory (or memory absent): absent, no wrapper;\n282|//   - absent probe, memory stopped or stale_fenced: the memory state,\n283|//     no wrapper (a fenced incarnation keeps its fencing without a wrapper);\n284|//   - absent probe, memory quiescing/active/parked/unavailable: unavailable\n285|//     (contradiction: the wrapper vanished, or was never proven);\n286|//   - present probe, memory quiescing or stale_fenced: the memory state\n287|//     (tmux cannot show either; a fenced incarnation with a live wrapper\n288|//     is what terminate-stale kills);\n289|//   - present probe, memory stopped or unavailable: unavailable\n290|//     (contradiction: a session resurrected, or was never proven);\n291|//   - present probe, memory active/parked/absent/none: active when at\n292|//     least one client is attached, otherwise parked.\n293|//\n294|// Attachability needs parked|active plus a currently evidenced attach\n295|// capability; provider presence needs at least one pane row. Memory\n296|// creating is unreachable (Record refuses it) and classifies\n297|// unavailable either way.\n298|func ClassifyStatus(input ClassifyInput) (terminalbackend.InstanceState, bool, bool, bool) {\n299|\tif !input.Present {\n300|\t\treturn classifyAbsent(input)\n301|\t}\n302|\treturn classifyPresent(input)\n303|}\n304|\n305|// classifyAbsent adopts the state for an absent probe.\n306|func classifyAbsent(input ClassifyInput) (terminalbackend.InstanceState, bool, bool, bool) {\n307|\tif !input.MemoryFound || input.Memory == terminalbackend.StateAbsent {\n308|\t\treturn terminalbackend.StateAbsent, false, false, false\n309|\t}\n310|\tswitch input.Memory {\n311|\tcase terminalbackend.StateStopped, terminalbackend.StateStaleFenced:\n312|\t\treturn input.Memory, false, false, false\n313|\tdefault:\n314|\t\treturn terminalbackend.StateUnavailable, false, false, false\n315|\t}\n316|}\n317|\n318|// classifyPresent adopts the state for a present probe.\n319|func classifyPresent(input ClassifyInput) (terminalbackend.InstanceState, bool, bool, bool) {\n320|\tprovider := input.ProviderRows > 0\n321|\tswitch input.Memory {\n322|\tcase terminalbackend.StateQuiescing, terminalbackend.StateStaleFenced:\n323|\t\tif !input.MemoryFound {\n324|\t\t\tbreak\n325|\t\t}\n326|\t\treturn input.Memory, true, provider, false\n327|\tcase terminalbackend.StateStopped, terminalbackend.StateUnavailable:\n328|\t\tif !input.MemoryFound {\n329|\t\t\tbreak\n330|\t\t}\n331|\t\treturn terminalbackend.StateUnavailable, false, false, false\n332|\tcase terminalbackend.StateCreating:\n333|\t\treturn terminalbackend.StateUnavailable, false, false, false\n334|\tdefault:\n335|\t}\n336|\tstate := terminalbackend.StateParked\n337|\tif input.Attached > 0 {\n338|\t\tstate = terminalbackend.StateActive\n339|\t}\n340|\tattachable := input.AttachCapable && (state == terminalbackend.StateParked || state == terminalbackend.StateActive)\n341|\treturn state, true, provider, attachable\n342|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d185","stream":{"kind":"session","id":"01a0c765-6a15-7930-81af-9d81d9b3108a"},"sequence":1821,"recorded_at":1780531400003637,"record_type":"event","durability":"durable","causation_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","run_stream":{"kind":"run","id":"eb24712a-98eb-41ba-85bf-fe73b2577481"},"call_id":"call_01a0c775315672f8b436e83e14fc0a4a","text":"Read text file `internal/tmuxserver/state.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"encoding/json\"\n7|\t\"errors\"\n8|\t\"fmt\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n14|)\n15|\n16|// InstanceStates is the durable AX-side state memory for tmux-hosted\n17|// terminal instances: one JSON document per instance under\n18|// <root>/tmuxlifecycle/instances/<instance_id>.json, installed by\n19|// atomic rename. tmux itself reports only presence (sessions, panes,\n20|// attached counts); the AX states quiescing, stopped, and stale_fenced\n21|// exist only on this side, so status reconciles the live tmux probe\n22|// against this memory (see ClassifyStatus). The store is MUTABLE —\n23|// every mutating operation records its after-state — unlike the\n24|// no-replace idempotency receipts, whose keys can never name a state.\n25|//\n26|// The store is rooted at a DURABLE data root, never the runtime root:\n27|// the runtime root is per-boot temporary, while status after reboot\n28|// must still distinguish a stopped instance from an absent one.\n29|type InstanceStates struct {\n30|\troot  string\n31|\thooks *StateHooks\n32|}\n33|\n34|// StateHooks arms the crash boundaries of the state install: after the\n35|// state bytes are staged to the temporary file (before the atomic\n36|// rename), and after the rename commits (before the directory sync\n37|// makes the commit durable). A nil hook is a no-op; a hook error aborts\n38|// the call with that error. Hooks is nil in production.\n39|type StateHooks struct {\n40|\tAfterStage   func(path string) error\n41|\tAfterInstall func(path string) error\n42|}\n43|\n44|// stateDocument is the stored shape: exactly schema, schema_version,\n45|// terminal_instance_id, and state.\n46|type stateDocument struct {\n47|\tSchema             string `json:\"schema\"`\n48|\tSchemaVersion      string `json:\"schema_version\"`\n49|\tTerminalInstanceID string `json:\"terminal_instance_id\"`\n50|\tState              string `json:\"state\"`\n51|}\n52|\n53|// OpenInstanceStates creates the store, ensuring the root exists. It\n54|// creates no instance documents: those appear with the first Record.\n55|func OpenInstanceStates(root string) (*InstanceStates, error) {\n56|\tif root == \"\" {\n57|\t\treturn nil, errors.New(\"tmux instance state root is empty\")\n58|\t}\n59|\tbase := filepath.Join(root, \"tmuxlifecycle\", \"instances\")\n60|\tif err := os.MkdirAll(base, 0o755); err != nil {\n61|\t\treturn nil, fmt.Errorf(\"create tmux instance state root: %w\", err)\n62|\t}\n63|\treturn &InstanceStates{root: root}, nil\n64|}\n65|\n66|// WithHooks returns the store with crash hooks armed.\n67|func (store *InstanceStates) WithHooks(hooks *StateHooks) *InstanceStates {\n68|\tstore.hooks = hooks\n69|\treturn store\n70|}\n71|\n72|func (store *InstanceStates) instancePath(instanceID string) string {\n73|\treturn filepath.Join(store.root, \"tmuxlifecycle\", \"instances\", instanceID+\".json\")\n74|}\n75|\n76|// Record stores the after-state of one mutating operation for one\n77|// instance. The install is atomic (stage, fsync, rename, directory\n78|// fsync): a crash leaves the previous state or the new state, never a\n79|// torn document, and a retry converges by re-recording. Only AX\n80|// lifecycle states record; creating never records (it exists only\n81|// between the idempotency receipt and the first side effect, and the\n82|// receipt already proves that window).\n83|func (store *InstanceStates) Record(instanceID string, state terminalbackend.InstanceState) error {\n84|\tif store == nil {\n85|\t\treturn errors.New(\"tmux instance state store is nil\")\n86|\t}\n87|\tif _, err := scalar.ParseUUIDv7(instanceID); err != nil {\n88|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance state identity\"}\n89|\t}\n90|\tif _, err := terminalbackend.ParseInstanceState(string(state)); err != nil {\n91|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance state value\"}\n92|\t}\n93|\tif state == terminalbackend.StateCreating {\n94|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance state value\"}\n95|\t}\n96|\traw, err := json.Marshal(stateDocument{\n97|\t\tSchema:             \"urn:ax:schema:tmux-instance-state\",\n98|\t\tSchemaVersion:      \"1.0.0\",\n99|\t\tTerminalInstanceID: instanceID,\n100|\t\tState:              string(state),\n101|\t})\n102|\tif err != nil {\n103|\t\treturn fmt.Errorf(\"encode tmux instance state: %w\", err)\n104|\t}\n105|\treturn store.install(instanceID, raw)\n106|}\n107|\n108|// Lookup replays the recorded state for one instance, or reports\n109|// absence when the instance was never recorded. A read or validation\n110|// failure is an error, never absence: unknown is not absent.\n111|func (store *InstanceStates) Lookup(instanceID string) (terminalbackend.InstanceState, bool, error) {\n112|\tif store == nil {\n113|\t\treturn \"\", false, errors.New(\"tmux instance state store is nil\")\n114|\t}\n115|\tif _, err := scalar.ParseUUIDv7(instanceID); err != nil {\n116|\t\treturn \"\", false, &Error{Code: CodeInvalidArguments, Detail: \"instance state identity\"}\n117|\t}\n118|\traw, err := os.ReadFile(store.instancePath(instanceID))\n119|\tif err != nil {\n120|\t\tif errors.Is(err, os.ErrNotExist) {\n121|\t\t\treturn \"\", false, nil\n122|\t\t}\n123|\t\treturn \"\", false, fmt.Errorf(\"read tmux instance state: %w\", err)\n124|\t}\n125|\tvar document stateDocument\n126|\tif err := json.Unmarshal(raw, &document); err != nil {\n127|\t\treturn \"\", false, fmt.Errorf(\"decode tmux instance state: %w\", err)\n128|\t}\n129|\tif document.TerminalInstanceID != instanceID {\n130|\t\treturn \"\", false, &Error{Code: CodeInvalidArguments, Detail: \"instance state identity\"}\n131|\t}\n132|\tstate, err := terminalbackend.ParseInstanceState(document.State)\n133|\tif err != nil {\n134|\t\treturn \"\", false, &Error{Code: CodeInvalidArguments, Detail: \"instance state value\"}\n135|\t}\n136|\treturn state, true, nil\n137|}\n138|\n139|// OperationOutcome is the persisted operation-specific report for one\n140|// idempotency key: the closure timestamps the wire result carries\n141|// outside the mutation receipt (InputClosedAt for quiesce-input,\n142|// BoundaryObservedAt for wait-safe-boundary). The receipt proves the\n143|// effect; this document proves the reported time. First success\n144|// records; every retry replays the recorded values, so the same\n145|// receipt never changes its closure time.\n146|type OperationOutcome struct {\n147|\tOperation          string\n148|\tInputClosedAt      string\n149|\tBoundaryObservedAt string\n150|}\n151|\n152|// outcomeDocument is the stored outcome shape.\n153|type outcomeDocument struct {\n154|\tSchema             string `json:\"schema\"`\n155|\tSchemaVersion      string `json:\"schema_version\"`\n156|\tIdempotencyKey     string `json:\"idempotency_key\"`\n157|\tOperation          string `json:\"operation\"`\n158|\tInputClosedAt      string `json:\"input_closed_at\"`\n159|\tBoundaryObservedAt string `json:\"boundary_observed_at\"`\n160|}\n161|\n162|// RecordOutcome stores the operation-specific report for one\n163|// idempotency key. Keys carry slashes, so the document name is the\n164|// hex SHA-256 of the key; the key itself is echoed inside for the\n165|// lookup to verify. The install is atomic like Record. A concurrent\n166|// duplicate first-completion may record either report; sequential\n167|// retries are stable, which is the tested property.\n168|func (store *InstanceStates) RecordOutcome(key string, outcome OperationOutcome) error {\n169|\tif store == nil {\n170|\t\treturn errors.New(\"tmux instance state store is nil\")\n171|\t}\n172|\tif key == \"\" {\n173|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance outcome key\"}\n174|\t}\n175|\traw, err := json.Marshal(outcomeDocument{\n176|\t\tSchema:             \"urn:ax:schema:tmux-operation-outcome\",\n177|\t\tSchemaVersion:      \"1.0.0\",\n178|\t\tIdempotencyKey:     key,\n179|\t\tOperation:          outcome.Operation,\n180|\t\tInputClosedAt:      outcome.InputClosedAt,\n181|\t\tBoundaryObservedAt: outcome.BoundaryObservedAt,\n182|\t})\n183|\tif err != nil {\n184|\t\treturn fmt.Errorf(\"encode tmux operation outcome: %w\", err)\n185|\t}\n186|\tsum := sha256.Sum256([]byte(key))\n187|\treturn store.installDocument(filepath.Join(\"tmuxlifecycle\", \"outcomes\"), hex.EncodeToString(sum[:])+\".json\", raw)\n188|}\n189|\n190|// LookupOutcome replays the recorded report for one idempotency key,\n191|// or reports absence when the key never completed an outcome record.\n192|// A read or validation failure is an error, never absence.\n193|func (store *InstanceStates) LookupOutcome(key string) (OperationOutcome, bool, error) {\n194|\tif store == nil {\n195|\t\treturn OperationOutcome{}, false, errors.New(\"tmux instance state store is nil\")\n196|\t}\n197|\tif key == \"\" {\n198|\t\treturn OperationOutcome{}, false, &Error{Code: CodeInvalidArguments, Detail: \"instance outcome key\"}\n199|\t}\n200|\tsum := sha256.Sum256([]byte(key))\n201|\traw, err := os.ReadFile(filepath.Join(store.root, \"tmuxlifecycle\", \"outcomes\", hex.EncodeToString(sum[:])+\".json\"))\n202|\tif err != nil {\n203|\t\tif errors.Is(err, os.ErrNotExist) {\n204|\t\t\treturn OperationOutcome{}, false, nil\n205|\t\t}\n206|\t\treturn OperationOutcome{}, false, fmt.Errorf(\"read tmux operation outcome: %w\", err)\n207|\t}\n208|\tvar document outcomeDocument\n209|\tif err := json.Unmarshal(raw, &document); err != nil {\n210|\t\treturn OperationOutcome{}, false, fmt.Errorf(\"decode tmux operation outcome: %w\", err)\n211|\t}\n212|\tif document.IdempotencyKey != key {\n213|\t\treturn OperationOutcome{}, false, &Error{Code: CodeInvalidArguments, Detail: \"instance outcome key\"}\n214|\t}\n215|\treturn OperationOutcome{\n216|\t\tOperation:          document.Operation,\n217|\t\tInputClosedAt:      document.InputClosedAt,\n218|\t\tBoundaryObservedAt: document.BoundaryObservedAt,\n219|\t}, true, nil\n220|}\n221|\n222|// RecordBindingDoc stores the create-time Terminal Instance Binding\n223|// document for one (session, bootstrap) pair, so restore can return\n224|// the required binding without minting (the JCS identity rule stays\n225|// termbind-private: this store never computes digests, it only keeps\n226|// the bytes create carried). The document must be a JSON object; its\n227|// binding identity is re-admitted by termbind on the restore read,\n228|// never here.\n229|func (store *InstanceStates) RecordBindingDoc(sessionID, bootstrapID string, doc []byte) error {\n230|\tif store == nil {\n231|\t\treturn errors.New(\"tmux instance state store is nil\")\n232|\t}\n233|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n234|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance binding identity\"}\n235|\t}\n236|\tif _, err := scalar.ParseUUIDv7(bootstrapID); err != nil {\n237|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance binding identity\"}\n238|\t}\n239|\tvar probe map[string]any\n240|\tif err := json.Unmarshal(doc, &probe); err != nil {\n241|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance binding document\"}\n242|\t}\n243|\treturn store.installDocument(filepath.Join(\"tmuxlifecycle\", \"bindings\", sessionID), bootstrapID+\".json\", doc)\n244|}\n245|\n246|// LookupBindingDoc replays the stored binding document for one\n247|// (session, bootstrap) pair, or reports absence when the pair never\n248|// recorded one. A read failure is an error, never absence.\n249|func (store *InstanceStates) LookupBindingDoc(sessionID, bootstrapID string) ([]byte, bool, error) {\n250|\tif store == nil {\n251|\t\treturn nil, false, errors.New(\"tmux instance state store is nil\")\n252|\t}\n253|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n254|\t\treturn nil, false, &Error{Code: CodeInvalidArguments, Detail: \"instance binding identity\"}\n255|\t}\n256|\tif _, err := scalar.ParseUUIDv7(bootstrapID); err != nil {\n257|\t\treturn nil, false, &Error{Code: CodeInvalidArguments, Detail: \"instance binding identity\"}\n258|\t}\n259|\traw, err := os.ReadFile(filepath.Join(store.root, \"tmuxlifecycle\", \"bindings\", sessionID, bootstrapID+\".json\"))\n260|\tif err != nil {\n261|\t\tif errors.Is(err, os.ErrNotExist) {\n262|\t\t\treturn nil, false, nil\n263|\t\t}\n264|\t\treturn nil, false, fmt.Errorf(\"read tmux binding document: %w\", err)\n265|\t}\n266|\treturn raw, true, nil\n267|}\n268|\n269|// install stages the state bytes to a same-directory temporary file,\n270|// fsyncs it, atomically renames it over the instance document (rename\n271|// is the mutable commit: the new state supersedes), removes no prior\n272|// name, and fsyncs the directory. Stale staging files from a\n273|// pre-commit crash are swept before the install.\n274|func (store *InstanceStates) install(instanceID string, raw []byte) error {\n275|\treturn store.installDocument(filepath.Join(\"tmuxlifecycle\", \"instances\"), instanceID+\".json\", raw)\n276|}\n277|\n278|// installDocument stages raw bytes to a same-directory temporary file\n279|// and atomically renames them over the named document under the\n280|// store root, sweeping stale staging files first and fsyncing the\n281|// directory after. Crash hooks fire at the same two boundaries as the\n282|// state install. rel is relative to the store root.\n283|func (store *InstanceStates) installDocument(rel, name string, raw []byte) error {\n284|\tdir := filepath.Join(store.root, rel)\n285|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n286|\t\treturn fmt.Errorf(\"create tmux instance state directory: %w\", err)\n287|\t}\n288|\tsweepStateStaging(dir)\n289|\ttarget := filepath.Join(dir, name)\n290|\tstaged, err := os.CreateTemp(dir, \"state-*.tmp\")\n291|\tif err != nil {\n292|\t\treturn fmt.Errorf(\"stage tmux instance state: %w\", err)\n293|\t}\n294|\tstagedPath := staged.Name()\n295|\tcommitted := false\n296|\tdefer func() {\n297|\t\tif !committed {\n298|\t\t\t_ = os.Remove(stagedPath)\n299|\t\t}\n300|\t}()\n301|\tif err := staged.Chmod(0o600); err != nil {\n302|\t\t_ = staged.Close()\n303|\t\treturn fmt.Errorf(\"protect tmux instance state: %w\", err)\n304|\t}\n305|\tif _, err := staged.Write(raw); err != nil {\n306|\t\t_ = staged.Close()\n307|\t\treturn fmt.Errorf(\"write tmux instance state: %w\", err)\n308|\t}\n309|\tif err := staged.Sync(); err != nil {\n310|\t\t_ = staged.Close()\n311|\t\treturn fmt.Errorf(\"sync tmux instance state: %w\", err)\n312|\t}\n313|\tif err := staged.Close(); err != nil {\n314|\t\treturn fmt.Errorf(\"close tmux instance state: %w\", err)\n315|\t}\n316|\tif store.hooks != nil && store.hooks.AfterStage != nil {\n317|\t\tif err := store.hooks.AfterStage(stagedPath); err != nil {\n318|\t\t\treturn err\n319|\t\t}\n320|\t}\n321|\tif err := os.Rename(stagedPath, target); err != nil {\n322|\t\treturn fmt.Errorf(\"install tmux instance state: %w\", err)\n323|\t}\n324|\tcommitted = true\n325|\tif store.hooks != nil && store.hooks.AfterInstall != nil {\n326|\t\tif err := store.hooks.AfterInstall(target); err != nil {\n327|\t\t\treturn err\n328|\t\t}\n329|\t}\n330|\tif err := syncStateDirectory(dir); err != nil {\n331|\t\treturn err\n332|\t}\n333|\treturn nil\n334|}\n335|\n336|// sweepStateStaging removes stale staging files from pre-commit\n337|// crashes. Only the state-*.tmp pattern is swept; instance documents\n338|// are never touched.\n339|func sweepStateStaging(dir string) {\n340|\tentries, err := os.ReadDir(dir)\n341|\tif err != nil {\n342|\t\treturn\n343|\t}\n344|\tfor _, entry := range entries {\n345|\t\tname := entry.Name()\n346|\t\tif len(name) > 10 && name[:6] == \"state-\" && filepath.Ext(name) == \".tmp\" {\n347|\t\t\t_ = os.Remove(filepath.Join(dir, name))\n348|\t\t}\n349|\t}\n350|}\n351|\n352|// syncStateDirectory fsyncs the directory so the rename commit is\n353|// durable before Record returns.\n354|func syncStateDirectory(path string) error {\n355|\tdir, err := os.Open(path)\n356|\tif err != nil {\n357|\t\treturn err\n358|\t}\n359|\tdefer func() { _ = dir.Close() }()\n360|\treturn dir.Sync()\n361|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
