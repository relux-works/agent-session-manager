{PACKAGE}/successor.go\\\",\\n        find='\\\\t\\\\t\\\"supersedes_binding_id\\\":  prior.BindingID,\\\\n',\\n        replace='\\\\t\\\\t\\\"supersedes_binding_id\\\":  nil,\\\\n',\\n        count=1,\\n        run=\\\"TestMintSuccessorBindingSuccessesAcrossGenerations\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the linkless successor past the supersedes arm (the link is a singleton presence: nil vs set, and the prior pins nil). Kill path: the minted successor omits its prior link.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-successor-identity-field\\\",\\n        path=f\\\"{PACKAGE}/successor.go\\\",\\n        find='\\\\tidentity, err := bindingIdentity(staged, \\\"binding_id\\\")\\\\n',\\n        replace='\\\\tidentity, err := bindingIdentity(staged, \\\"session_id\\\")\\\\n',\\n        count=1,\\n        run=\\\"(TestMintSuccessorBindingSuccessesAcrossGenerations|TestMintSuccessorBindingIdentityBinds)\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the wrong omit-field past the identity arm; the tampered-rebound parse still refuses. Kill path: the minted identity fails its own re-admission self-check.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-successor-generation-inherit\\\",\\n        path=f\\\"{PACKAGE}/successor.go\\\",\\n        find='\\\\t\\\\t\\\"backend_generation\\\":     generation,\\\\n',\\n        replace='\\\\t\\\\t\\\"backend_generation\\\":     prior.BackendGeneration,\\\\n',\\n        count=1,\\n        run=\\\"(TestMintSuccessorBindingSuccessesAcrossGenerations|TestMintSuccessorBindingRefusesSameGeneration)\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the stale generation into the successor body; the succession-contradiction arm still compares the parameter. Kill path: the minted successor names the prior generation.\\\",\\n    ),\\n    Mutant(\\n\",\n  \"original_output_bytes\": 2495,\n  \"original_output_tokens\": 624,\n  \"truncated\": false\n}","final_result":true}}}
