{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d0af","stream":{"kind":"session","id":"01a0c765-6a15-7930-81af-9d81d9b3108a"},"sequence":1714,"recorded_at":1780531400003423,"record_type":"event","durability":"durable","causation_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","run_stream":{"kind":"run","id":"eb24712a-98eb-41ba-85bf-fe73b2577481"},"task_stream":{"kind":"task","id":"01a0c775-0508-7f91-b4a7-42a23bc952f2"},"task_id":"01a0c775-0508-7f91-b4a7-42a23bc952f2","event":{"kind":"output","task_id":"01a0c775-0508-7f91-b4a7-42a23bc952f2","chunk":"Read text file `internal/tmuxserver/ops.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"sort\"\n8|\t\"strconv\"\n9|\t\"time\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n17|)\n18|\n19|// This file executes the three lifecycle operations the landed engine\n20|// scope refuses — attach, terminate-stale, and restore — over the same\n21|// landed gates the engine uses (transition matrix, idempotency shapes,\n22|// authorization, capability conferral, receipt and binding stores)\n23|// plus the tmux backend. The recheck loop, receipt discipline, and\n24|// error-to-observation mapping mirror the engine's second side of each\n25|// rule; the census symmetry lines name both sides.\n26|\n27|// sortedEffects copies effects into bytewise order for the wire.\n28|func sortedEffects(effects []terminalbackend.SideEffect) []terminalbackend.SideEffect {\n29|\tordered := append([]terminalbackend.SideEffect(nil), effects...)\n30|\tsort.Slice(ordered, func(i, j int) bool { return ordered[i] < ordered[j] })\n31|\treturn ordered\n32|}\n33|\n34|// sortedEvidence copies evidence IDs into bytewise order for the wire.\n35|func sortedEvidence(evidence []string) []string {\n36|\tordered := append([]string(nil), evidence...)\n37|\tsort.Strings(ordered)\n38|\treturn ordered\n39|}\n40|\n41|// attachDescriptor derives the bound attach descriptor: socket,\n42|// instance, and client joined by newlines. It is host-local (the\n43|// socket path is usable only on the responding host), deterministic,\n44|// and never persisted: the attach handler returns it without writing\n45|// it anywhere, and a dedicated test scans the stores for its bytes.\n46|// Length is bounded by construction — sun_path socket plus two UUIDs\n47|// stay two orders of magnitude below the 4096 cap — so no length arm\n48|// exists to measure; a test pins the maximum instead.\n49|func attachDescriptor(socket, instance, client string) string {\n50|\treturn socket + \"\\n\" + instance + \"\\n\" + client\n51|}\n52|\n53|// createDescriptor derives the unbound create-interactive descriptor:\n54|// socket and instance only, because create carries no client. Same\n55|// non-persistence and length properties as the bound shape.\n56|func createDescriptor(socket, instance string) string {\n57|\treturn socket + \"\\n\" + instance\n58|}\n59|\n60|// executeAttach runs one attach: closed-shape admission, deadline,\n61|// transition, landed attach authorization, capability conferral plus\n62|// the matching-transport arm, live server attestation (the P3-A\n63|// wiring: a fresh decoy admission refuses), the durable client\n64|// receipt, and the caller-executed attach vector with its descriptor.\n65|// The entry returns the vector; it never execs an interactive attach.\n66|func (lc *Lifecycle) executeAttach(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n67|\tempty := OpOutcome{Operation: terminalbackend.OperationAttach}\n68|\tbody, err := parseAttachBody(req.Body)\n69|\tif err != nil {\n70|\t\treturn empty, err\n71|\t}\n72|\tif err := checkLifecycleBackend(body.TerminalBackendID); err != nil {\n73|\t\treturn empty, err\n74|\t}\n75|\tdeadline, err := body.Deadline.Time()\n76|\tif err != nil {\n77|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body deadline\"}\n78|\t}\n79|\tif !lc.Now().Before(deadline) {\n80|\t\treturn empty, &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n81|\t}\n82|\tif _, _, err := terminalbackend.CheckTransition(string(terminalbackend.OperationAttach), req.Source, false); err != nil {\n83|\t\treturn empty, err\n84|\t}\n85|\tif err := terminalbackend.CheckAttachRequest(body.Authorization, body.Transport, body.InputAuthorized, lc.Now()); err != nil {\n86|\t\treturn empty, err\n87|\t}\n88|\tif err := terminalbackend.CheckOperation(string(terminalbackend.OperationAttach), req.Admitted); err != nil {\n89|\t\treturn empty, err\n90|\t}\n91|\tif err := checkAttachTransportCapability(body.Transport, req.Admitted); err != nil {\n92|\t\treturn empty, err\n93|\t}\n94|\tif err := lc.checkAttachQuiesced(body.TerminalInstanceID, body.InputAuthorized); err != nil {\n95|\t\treturn empty, err\n96|\t}\n97|\tif lc.ServerAdmission == nil {\n98|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle dependencies\"}\n99|\t}\n100|\tadmission, err := lc.ServerAdmission()\n101|\tif err != nil {\n102|\t\treturn empty, rowError(terminalbackend.OperationAttach, err)\n103|\t}\n104|\tif err := CheckServerAttested(admission, body.BackendGeneration); err != nil {\n105|\t\treturn empty, &Error{Code: terminalbackend.CodeUnauthorized, Detail: \"attach server attestation\"}\n106|\t}\n107|\treqBackend := lc.requestBackend(req, socket, body.SessionID, body.TerminalInstanceID)\n108|\treqBackend.operation = terminalbackend.OperationAttach\n109|\treqBackend.clientID = body.ClientID\n110|\treqBackend.transport = body.Transport\n111|\treqBackend.input = body.InputAuthorized\n112|\treqBackend.authRaw = body.AuthRaw\n113|\tevidenceID, err := reqBackend.PerformEffect(ctx, terminalbackend.EffectAttachClientCreated)\n114|\tif err != nil {\n115|\t\treturn empty, rowError(terminalbackend.OperationAttach, err)\n116|\t}\n117|\targv, err := BuildCommand(DirectiveAttachSession, CommandArgs{\n118|\t\tRuntimeDir:     lc.RuntimeDir,\n119|\t\tSocket:         socket,\n120|\t\tInstanceID:     body.TerminalInstanceID,\n121|\t\tAttachInput:    body.InputAuthorized,\n122|\t\tHasAttachInput: true,\n123|\t})\n124|\tif err != nil {\n125|\t\treturn empty, err\n126|\t}\n127|\tif err := terminalbackend.CheckAttachResult(body.InputAuthorized, body.InputAuthorized, body.Authorization); err != nil {\n128|\t\treturn empty, err\n129|\t}\n130|\tlc.recordAfter(body.TerminalInstanceID, terminalbackend.StateActive)\n131|\treturn OpOutcome{\n132|\t\tOperation: terminalbackend.OperationAttach,\n133|\t\tAttach: &AttachOutcome{\n134|\t\t\tClientMirrorID:  body.ClientID,\n135|\t\t\tDescriptor:      attachDescriptor(socket, body.TerminalInstanceID, body.ClientID),\n136|\t\t\tInputAuthorized: body.InputAuthorized,\n137|\t\t\tEvidenceIDs:     []string{evidenceID},\n138|\t\t},\n139|\t\tArgv: argv,\n140|\t}, nil\n141|}\n142|\n143|// checkAttachQuiesced enforces the quiesce input barrier at the\n144|// attach entry: tmux offers no session freeze (a locked session does\n145|// not lock subsequently attaching clients), so once the AX-side\n146|// memory records quiescing, new input-authorized attaches refuse the\n147|// failed local precondition. Read-only attaches stay admitted:\n148|// quiesce stops input while retaining observation. A memory read\n149|// failure is an error, never admission: unknown is not a verdict.\n150|func (lc *Lifecycle) checkAttachQuiesced(instanceID string, inputAuthorized bool) error {\n151|\tif !inputAuthorized {\n152|\t\treturn nil\n153|\t}\n154|\tmemory, found, err := lc.States.Lookup(instanceID)\n155|\tif err != nil {\n156|\t\treturn err\n157|\t}\n158|\tif found && memory == terminalbackend.StateQuiescing {\n159|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"attach quiesced input\"}\n160|\t}\n161|\treturn nil\n162|}\n163|\n164|// checkAttachTransportCapability enforces the matching-transport arm:\n165|// local presentation needs local_attach, mesh presentation needs\n166|// remote_attach. The relay member never reaches here — the landed\n167|// attach authorization refuses it first — so no third arm exists.\n168|func checkAttachTransportCapability(transport string, admitted terminalbackend.Admitted) error {\n169|\tswitch transport {\n170|\tcase string(terminalbackend.TransportLocalOnly):\n171|\t\tif !admitted.Has(\"local_attach\") {\n172|\t\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n173|\t\t}\n174|\tcase string(terminalbackend.TransportTrustedPrivateMesh):\n175|\t\tif !admitted.Has(\"remote_attach\") {\n176|\t\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n177|\t\t}\n178|\tdefault:\n179|\t\treturn &Error{Code: terminalbackend.CodeProtocolError, Detail: \"presentation transport vocabulary\"}\n180|\t}\n181|\treturn nil\n182|}\n183|\n184|// executeTerminate runs one terminate-stale: closed-shape admission,\n185|// idempotency material, capability conferral plus the dual conditional,\n186|// transition, force_stale authorization, generation recheck, landed\n187|// fencing authorization, deadline, receipt discipline with\n188|// status-reconciled resume, and the kill plus close-confirm effects.\n189|func (lc *Lifecycle) executeTerminate(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n190|\tempty := OpOutcome{Operation: terminalbackend.OperationTerminateStale}\n191|\tbody, err := parseTerminateBody(req.Body)\n192|\tif err != nil {\n193|\t\treturn empty, err\n194|\t}\n195|\toperation := terminalbackend.OperationTerminateStale\n196|\tmctx := body.Context\n197|\tsource := terminalbackend.InstanceState(req.Source)\n198|\tif err := checkLifecycleBackend(mctx.TerminalBackendID); err != nil {\n199|\t\treturn empty, err\n200|\t}\n201|\tderived, err := terminalbackend.IdempotencyKey(string(operation), mctx.TerminalInstanceID, \"terminate\", body.StaleLeaseID, strconv.FormatUint(body.StaleEpoch, 10))\n202|\tif err != nil {\n203|\t\treturn empty, err\n204|\t}\n205|\tif mctx.IdempotencyKey != derived {\n206|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"idempotency key material\"}\n207|\t}\n208|\tif err := terminalbackend.CheckOperation(string(operation), req.Admitted); err != nil {\n209|\t\tfailure := rowError(operation, err)\n210|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n211|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n212|\t}\n213|\tif err := checkTerminateCapability(req.Admitted); err != nil {\n214|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n215|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n216|\t}\n217|\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), false)\n218|\tif err != nil {\n219|\t\tfailure := rowError(operation, err)\n220|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n221|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n222|\t}\n223|\tif err := terminstance.CheckAuthorization(mctx.Authorization, terminstance.AuthorizationForceStale, lc.CurrentLease(), lc.Now()); err != nil {\n224|\t\tfailure := rowError(operation, err)\n225|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n226|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n227|\t}\n228|\tif lc.CurrentGeneration() != mctx.BackendGeneration {\n229|\t\tfailure := &Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation stale\"}\n230|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n231|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n232|\t}\n233|\tif err := mapFencingError(fencing.AuthorizeTerminateStale(req.Presented, req.Winner, req.HasWinner, req.ForceRecovery, req.DiagnosticsPreserved)); err != nil {\n234|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n235|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n236|\t}\n237|\tif err := checkTerminateTarget(mctx, body, req.Presented); err != nil {\n238|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n239|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n240|\t}\n241|\tif err := checkTerminateWinner(mctx, req.Winner, lc.CurrentLease()); err != nil {\n242|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n243|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n244|\t}\n245|\tdeadline, err := mctx.Deadline.Time()\n246|\tif err != nil {\n247|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"mutation context deadline\"}\n248|\t}\n249|\tif !lc.Now().Before(deadline) {\n250|\t\tfailure := &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n251|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionReplaySame)\n252|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n253|\t}\n254|\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n255|\treqBackend.operation = operation\n256|\treqBackend.deadline = deadline\n257|\treturn lc.executeWithReceipt(ctx, req, socket, operation, mctx, source, target, effects, deadline, terminstance.AuthorizationForceStale, reqBackend, func(result terminstance.Result) OpOutcome {\n258|\t\treturn OpOutcome{Operation: operation, Mutation: &result, TargetClosed: true}\n259|\t})\n260|}\n261|\n262|// checkTerminateCapability enforces the dual conditional: stale\n263|// termination needs stale_process_termination AND\n264|// provider_process_observation. Each arm refuses alone.\n265|func checkTerminateCapability(admitted terminalbackend.Admitted) error {\n266|\tif !admitted.Has(\"stale_process_termination\") {\n267|\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n268|\t}\n269|\tif !admitted.Has(\"provider_process_observation\") {\n270|\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n271|\t}\n272|\treturn nil\n273|}\n274|\n275|// mapFencingError maps the landed terminate-stale authorization onto\n276|// the row's allowed set: malformed fencing material is the protocol\n277|// error, every other fencing refusal — no winner, no force, no\n278|// diagnostics, target mismatch, live owner — is the failed local\n279|// precondition. lease_conflict maps to the precondition too: the row\n280|// has no lease_conflict member, and a target fenced by another\n281|// session's winner fails the fenced-target precondition.\n282|func mapFencingError(err error) error {\n283|\tif err == nil {\n284|\t\treturn nil\n285|\t}\n286|\tif errors.Is(err, fencing.ErrInvalidArguments) {\n287|\t\treturn &Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminate fencing material\"}\n288|\t}\n289|\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate fencing authorization\"}\n290|}\n291|\n292|// checkTerminateTarget binds the presented fencing token to the\n293|// request: session, stale lease, and stale epoch must all agree with\n294|// the context and body. Any disagreement refuses the failed local\n295|// precondition: the retry would authorize a different target than the\n296|// key names.\n297|func checkTerminateTarget(mctx terminstance.MutationContext, body TerminateBody, presented fencing.PresentedToken) error {\n298|\tif presented.SessionID != mctx.SessionID ||\n299|\t\tpresented.LeaseID != body.StaleLeaseID ||\n300|\t\tpresented.Epoch != body.StaleEpoch {\n301|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate target binding\"}\n302|\t}\n303|\treturn nil\n304|}\n305|\n306|// checkTerminateWinner binds the caller-observed winner to the\n307|// re-read current lease: the fencing authorization decides over the\n308|// caller's winner, and only a winner that still wins authorizes. A\n309|// rotated or misobserved winner refuses the failed local\n310|// precondition; the caller re-observes and retries. Absence of a\n311|// winner never reaches here — the fencing gate refuses it first.\n312|func checkTerminateWinner(mctx terminstance.MutationContext, winner sessrepo.LeaseSummary, lease terminstance.LeaseView) error {\n313|\tif winner.SessionID != mctx.SessionID ||\n314|\t\twinner.LeaseID != lease.LeaseID ||\n315|\t\twinner.Epoch != lease.Epoch {\n316|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate winner binding\"}\n317|\t}\n318|\treturn nil\n319|}\n320|\n321|// executeRestore runs one restore: closed-shape admission, idempotency\n322|// material, capability conferral plus the reboot conditional,\n323|// transition, restore authorization, generation recheck, prior-binding\n324|// mismatch, deadline, receipt discipline with status-reconciled\n325|// resume, the persist plus wrapper-restored effects, the required\n326|// result binding, and the §4.2 after-restore branch report. The wire\n327|// result is always parked; the branch report (resumed, remote offer,\n328|// or parked) steers the caller. The backend launches no provider on\n329|// any branch: the wrapper owns launch gating through its own\n330|// decision, and this entry only recreates the wrapper process.\n331|//\n332|// The result binding is the create-time document kept alongside the\n333|// bootstrap receipt, re-admitted by termbind on the read: restore\n334|// mints nothing (the JCS identity rule stays termbind-private) and\n335|// echoes nothing. The prior-binding mismatch arm proves the carried\n336|// prior equals the recorded digest; the document read proves a valid\n337|// binding for this session, instance, backend, and generation.\n338|func (lc *Lifecycle) executeRestore(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n339|\tempty := OpOutcome{Operation: terminalbackend.OperationRestore}\n340|\tbody, err := parseRestoreBody(req.Body)\n341|\tif err != nil {\n342|\t\treturn empty, err\n343|\t}\n344|\toperation := terminalbackend.OperationRestore\n345|\tmctx := body.Context\n346|\tsource := terminalbackend.InstanceState(req.Source)\n347|\tif err := checkLifecycleBackend(mctx.TerminalBackendID); err != nil {\n348|\t\treturn empty, err\n349|\t}\n350|\tderived, err := terminalbackend.IdempotencyKey(string(operation), mctx.SessionID, body.BootstrapOperationID)\n351|\tif err != nil {\n352|\t\treturn empty, err\n353|\t}\n354|\tif mctx.IdempotencyKey != derived {\n355|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"idempotency key material\"}\n356|\t}\n357|\tif err := terminalbackend.CheckOperation(string(operation), req.Admitted); err != nil {\n358|\t\tfailure := rowError(operation, err)\n359|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n360|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n361|\t}\n362|\tif !req.Admitted.Has(\"reboot_restoration\") {\n363|\t\tfailure := &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n364|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n365|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n366|\t}\n367|\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), false)\n368|\tif err != nil {\n369|\t\tfailure := rowError(operation, err)\n370|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n371|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n372|\t}\n373|\tif err := terminstance.CheckAuthorization(mctx.Authorization, terminstance.AuthorizationRestore, lc.CurrentLease(), lc.Now()); err != nil {\n374|\t\tfailure := rowError(operation, err)\n375|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n376|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n377|\t}\n378|\tif lc.CurrentGeneration() != mctx.BackendGeneration {\n379|\t\tfailure := &Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation stale\"}\n380|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n381|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n382|\t}\n383|\tif err := lc.checkPriorBinding(body); err != nil {\n384|\t\tvar local *Error\n385|\t\tif errors.As(err, &local) && local.Code == terminalbackend.CodeRestoreMismatch {\n386|\t\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n387|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n388|\t\t}\n389|\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n390|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n391|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n392|\t}\n393|\tdeadline, err := mctx.Deadline.Time()\n394|\tif err != nil {\n395|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"mutation context deadline\"}\n396|\t}\n397|\tif !lc.Now().Before(deadline) {\n398|\t\tfailure := &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n399|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionReplaySame)\n400|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n401|\t}\n402|\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n403|\treqBackend.operation = operation\n404|\treqBackend.bootstrapID = body.BootstrapOperationID\n405|\t// The persist effect replays the recorded pair receipt (verified\n406|\t// by the mismatch arm above); the candidate carries the matched\n407|\t// prior digest so the store admits its shape on the replay path.\n408|\treqBackend.bindingID = body.PriorBindingID\n409|\toutcome, err := lc.executeWithReceipt(ctx, req, socket, operation, mctx, source, target, effects, deadline, terminstance.AuthorizationRestore, reqBackend, func(result terminstance.Result) OpOutcome {\n410|\t\treturn OpOutcome{Operation: operation, Mutation: &result, PriorBindingID: body.PriorBindingID, RestoredParked: true}\n411|\t})\n412|\tif err != nil {\n413|\t\treturn outcome, err\n414|\t}\n415|\tbinding, err := lc.restoreBinding(mctx, body)\n416|\tif err != nil {\n417|\t\treturn outcome, err\n418|\t}\n419|\toutcome.Binding = binding\n420|\tbranch := lc.afterRestoreBranch(ctx, req, mctx, body)\n421|\toutcome.AfterRestore = &branch\n422|\treturn outcome, nil\n423|}\n424|\n425|// restoreBinding reads the required restore result binding: the\n426|// create-time document kept under the (session, bootstrap) pair,\n427|// re-admitted by the termbind owner. A missing document is the\n428|// backend store failure — the receipt proved the prior, but the\n429|// payload is gone, so the required result cannot be built. A\n430|// document that fails termbind admission, or that names another\n431|// session, instance, backend, or generation than the mutation\n432|// context, is the integrity failure: the store disagrees with the\n433|// receipt it stands beside.\n434|func (lc *Lifecycle) restoreBinding(mctx terminstance.MutationContext, body RestoreBody) (*termbind.Binding, error) {\n435|\tdoc, found, err := lc.States.LookupBindingDoc(mctx.SessionID, body.BootstrapOperationID)\n436|\tif err != nil {\n437|\t\treturn nil, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n438|\t}\n439|\tif !found {\n440|\t\treturn nil, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n441|\t}\n442|\tbinding, err := termbind.ParseTerminalBinding(doc)\n443|\tif err != nil {\n444|\t\treturn nil, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n445|\t}\n446|\tif binding.SessionID != mctx.SessionID ||\n447|\t\tbinding.TerminalInstanceID != mctx.TerminalInstanceID ||\n448|\t\tbinding.TerminalBackendID != mctx.TerminalBackendID ||\n449|\t\tbinding.BackendGeneration != mctx.BackendGeneration {\n450|\t\treturn nil, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n451|\t}\n452|\treturn &binding, nil\n453|}\n454|\n455|// afterRestoreBranch runs the §4.2 after-restore sequence over the\n456|// winning-lease view: read the latest locally known lease, attempt\n457|// the mesh refresh under the measured bound, then branch. Local\n458|// resume requires the local host to hold the lease the refresh (or,\n459|// without one, local knowledge) names AND a valid materialization;\n460|// a winner another host holds offers remote attach/takeover in an\n461|// interactive terminal; every other case — including a\n462|// locally-held winner under an unseen lease tuple — parks without\n463|// launching a provider. The refresh is attempted, never required: a\n464|// missing, failed, or timed-out attempt falls back to local\n465|// knowledge.\n466|func (lc *Lifecycle) afterRestoreBranch(ctx context.Context, req OpRequest, mctx terminstance.MutationContext, body RestoreBody) AfterRestoreOutcome {\n467|\tlocal := lc.CurrentLease()\n468|\tbound := lc.MeshRefreshTimeout\n469|\tif bound <= 0 {\n470|\t\tbound = DefaultMeshRefreshTimeout\n471|\t}\n472|\twinner := RefreshWinner{LeaseID: local.LeaseID, Epoch: local.Epoch, HolderHostID: mctx.Authorization.HolderHostID}\n473|\tattempted := false\n474|\tif lc.LeaseRefresh != nil {\n475|\t\tattempted = true\n476|\t\trefreshCtx, cancel := context.WithTimeout(ctx, bound)\n477|\t\trefreshed, err := lc.LeaseRefresh(refreshCtx, mctx.SessionID)\n478|\t\tcancel()\n479|\t\tif err == nil {\n480|\t\t\twinner = refreshed\n481|\t\t}\n482|\t}\n483|\tlocalWins := lc.LocalHostID != \"\" &&\n484|\t\twinner.HolderHostID == lc.LocalHostID &&\n485|\t\twinner.LeaseID == local.LeaseID &&\n486|\t\twinner.Epoch == local.Epoch\n487|\t// A remote offer names another host: a winner the local host\n488|\t// holds under an unseen lease tuple is not remote (local\n489|\t// knowledge lags the mesh), and an unknown self proves neither\n490|\t// side. Both park without launching.\n491|\tremoteOwns := lc.LocalHostID != \"\" &&\n492|\t\twinner.HolderHostID != \"\" &&\n493|\t\twinner.HolderHostID != lc.LocalHostID\n494|\tmaterial := false\n495|\tif lc.Materialization != nil {\n496|\t\tif valid, err := lc.Materialization(mctx.SessionID, body.CheckpointID); err == nil && valid {\n497|\t\t\tmaterial = true\n498|\t\t}\n499|\t}\n500|\taction := AfterRestoreParked\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d0b1","stream":{"kind":"session","id":"01a0c765-6a15-7930-81af-9d81d9b3108a"},"sequence":1715,"recorded_at":1780531400003425,"record_type":"event","durability":"durable","causation_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","run_stream":{"kind":"run","id":"eb24712a-98eb-41ba-85bf-fe73b2577481"},"task_stream":{"kind":"task","id":"01a0c775-0508-7f91-b4a7-42a23bc952f2"},"task_id":"01a0c775-0508-7f91-b4a7-42a23bc952f2","event":{"kind":"completed","task_id":"01a0c775-0508-7f91-b4a7-42a23bc952f2"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d0b3","stream":{"kind":"session","id":"01a0c765-6a15-7930-81af-9d81d9b3108a"},"sequence":1716,"recorded_at":1780531400003427,"record_type":"event","durability":"durable","causation_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","run_stream":{"kind":"run","id":"eb24712a-98eb-41ba-85bf-fe73b2577481"},"call_id":"call_01a0c77502f7704e863320fa1711b797","text":"Read text file `internal/tmuxserver/ops.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"sort\"\n8|\t\"strconv\"\n9|\t\"time\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n17|)\n18|\n19|// This file executes the three lifecycle operations the landed engine\n20|// scope refuses — attach, terminate-stale, and restore — over the same\n21|// landed gates the engine uses (transition matrix, idempotency shapes,\n22|// authorization, capability conferral, receipt and binding stores)\n23|// plus the tmux backend. The recheck loop, receipt discipline, and\n24|// error-to-observation mapping mirror the engine's second side of each\n25|// rule; the census symmetry lines name both sides.\n26|\n27|// sortedEffects copies effects into bytewise order for the wire.\n28|func sortedEffects(effects []terminalbackend.SideEffect) []terminalbackend.SideEffect {\n29|\tordered := append([]terminalbackend.SideEffect(nil), effects...)\n30|\tsort.Slice(ordered, func(i, j int) bool { return ordered[i] < ordered[j] })\n31|\treturn ordered\n32|}\n33|\n34|// sortedEvidence copies evidence IDs into bytewise order for the wire.\n35|func sortedEvidence(evidence []string) []string {\n36|\tordered := append([]string(nil), evidence...)\n37|\tsort.Strings(ordered)\n38|\treturn ordered\n39|}\n40|\n41|// attachDescriptor derives the bound attach descriptor: socket,\n42|// instance, and client joined by newlines. It is host-local (the\n43|// socket path is usable only on the responding host), deterministic,\n44|// and never persisted: the attach handler returns it without writing\n45|// it anywhere, and a dedicated test scans the stores for its bytes.\n46|// Length is bounded by construction — sun_path socket plus two UUIDs\n47|// stay two orders of magnitude below the 4096 cap — so no length arm\n48|// exists to measure; a test pins the maximum instead.\n49|func attachDescriptor(socket, instance, client string) string {\n50|\treturn socket + \"\\n\" + instance + \"\\n\" + client\n51|}\n52|\n53|// createDescriptor derives the unbound create-interactive descriptor:\n54|// socket and instance only, because create carries no client. Same\n55|// non-persistence and length properties as the bound shape.\n56|func createDescriptor(socket, instance string) string {\n57|\treturn socket + \"\\n\" + instance\n58|}\n59|\n60|// executeAttach runs one attach: closed-shape admission, deadline,\n61|// transition, landed attach authorization, capability conferral plus\n62|// the matching-transport arm, live server attestation (the P3-A\n63|// wiring: a fresh decoy admission refuses), the durable client\n64|// receipt, and the caller-executed attach vector with its descriptor.\n65|// The entry returns the vector; it never execs an interactive attach.\n66|func (lc *Lifecycle) executeAttach(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n67|\tempty := OpOutcome{Operation: terminalbackend.OperationAttach}\n68|\tbody, err := parseAttachBody(req.Body)\n69|\tif err != nil {\n70|\t\treturn empty, err\n71|\t}\n72|\tif err := checkLifecycleBackend(body.TerminalBackendID); err != nil {\n73|\t\treturn empty, err\n74|\t}\n75|\tdeadline, err := body.Deadline.Time()\n76|\tif err != nil {\n77|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body deadline\"}\n78|\t}\n79|\tif !lc.Now().Before(deadline) {\n80|\t\treturn empty, &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n81|\t}\n82|\tif _, _, err := terminalbackend.CheckTransition(string(terminalbackend.OperationAttach), req.Source, false); err != nil {\n83|\t\treturn empty, err\n84|\t}\n85|\tif err := terminalbackend.CheckAttachRequest(body.Authorization, body.Transport, body.InputAuthorized, lc.Now()); err != nil {\n86|\t\treturn empty, err\n87|\t}\n88|\tif err := terminalbackend.CheckOperation(string(terminalbackend.OperationAttach), req.Admitted); err != nil {\n89|\t\treturn empty, err\n90|\t}\n91|\tif err := checkAttachTransportCapability(body.Transport, req.Admitted); err != nil {\n92|\t\treturn empty, err\n93|\t}\n94|\tif err := lc.checkAttachQuiesced(body.TerminalInstanceID, body.InputAuthorized); err != nil {\n95|\t\treturn empty, err\n96|\t}\n97|\tif lc.ServerAdmission == nil {\n98|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle dependencies\"}\n99|\t}\n100|\tadmission, err := lc.ServerAdmission()\n101|\tif err != nil {\n102|\t\treturn empty, rowError(terminalbackend.OperationAttach, err)\n103|\t}\n104|\tif err := CheckServerAttested(admission, body.BackendGeneration); err != nil {\n105|\t\treturn empty, &Error{Code: terminalbackend.CodeUnauthorized, Detail: \"attach server attestation\"}\n106|\t}\n107|\treqBackend := lc.requestBackend(req, socket, body.SessionID, body.TerminalInstanceID)\n108|\treqBackend.operation = terminalbackend.OperationAttach\n109|\treqBackend.clientID = body.ClientID\n110|\treqBackend.transport = body.Transport\n111|\treqBackend.input = body.InputAuthorized\n112|\treqBackend.authRaw = body.AuthRaw\n113|\tevidenceID, err := reqBackend.PerformEffect(ctx, terminalbackend.EffectAttachClientCreated)\n114|\tif err != nil {\n115|\t\treturn empty, rowError(terminalbackend.OperationAttach, err)\n116|\t}\n117|\targv, err := BuildCommand(DirectiveAttachSession, CommandArgs{\n118|\t\tRuntimeDir:     lc.RuntimeDir,\n119|\t\tSocket:         socket,\n120|\t\tInstanceID:     body.TerminalInstanceID,\n121|\t\tAttachInput:    body.InputAuthorized,\n122|\t\tHasAttachInput: true,\n123|\t})\n124|\tif err != nil {\n125|\t\treturn empty, err\n126|\t}\n127|\tif err := terminalbackend.CheckAttachResult(body.InputAuthorized, body.InputAuthorized, body.Authorization); err != nil {\n128|\t\treturn empty, err\n129|\t}\n130|\tlc.recordAfter(body.TerminalInstanceID, terminalbackend.StateActive)\n131|\treturn OpOutcome{\n132|\t\tOperation: terminalbackend.OperationAttach,\n133|\t\tAttach: &AttachOutcome{\n134|\t\t\tClientMirrorID:  body.ClientID,\n135|\t\t\tDescriptor:      attachDescriptor(socket, body.TerminalInstanceID, body.ClientID),\n136|\t\t\tInputAuthorized: body.InputAuthorized,\n137|\t\t\tEvidenceIDs:     []string{evidenceID},\n138|\t\t},\n139|\t\tArgv: argv,\n140|\t}, nil\n141|}\n142|\n143|// checkAttachQuiesced enforces the quiesce input barrier at the\n144|// attach entry: tmux offers no session freeze (a locked session does\n145|// not lock subsequently attaching clients), so once the AX-side\n146|// memory records quiescing, new input-authorized attaches refuse the\n147|// failed local precondition. Read-only attaches stay admitted:\n148|// quiesce stops input while retaining observation. A memory read\n149|// failure is an error, never admission: unknown is not a verdict.\n150|func (lc *Lifecycle) checkAttachQuiesced(instanceID string, inputAuthorized bool) error {\n151|\tif !inputAuthorized {\n152|\t\treturn nil\n153|\t}\n154|\tmemory, found, err := lc.States.Lookup(instanceID)\n155|\tif err != nil {\n156|\t\treturn err\n157|\t}\n158|\tif found && memory == terminalbackend.StateQuiescing {\n159|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"attach quiesced input\"}\n160|\t}\n161|\treturn nil\n162|}\n163|\n164|// checkAttachTransportCapability enforces the matching-transport arm:\n165|// local presentation needs local_attach, mesh presentation needs\n166|// remote_attach. The relay member never reaches here — the landed\n167|// attach authorization refuses it first — so no third arm exists.\n168|func checkAttachTransportCapability(transport string, admitted terminalbackend.Admitted) error {\n169|\tswitch transport {\n170|\tcase string(terminalbackend.TransportLocalOnly):\n171|\t\tif !admitted.Has(\"local_attach\") {\n172|\t\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n173|\t\t}\n174|\tcase string(terminalbackend.TransportTrustedPrivateMesh):\n175|\t\tif !admitted.Has(\"remote_attach\") {\n176|\t\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n177|\t\t}\n178|\tdefault:\n179|\t\treturn &Error{Code: terminalbackend.CodeProtocolError, Detail: \"presentation transport vocabulary\"}\n180|\t}\n181|\treturn nil\n182|}\n183|\n184|// executeTerminate runs one terminate-stale: closed-shape admission,\n185|// idempotency material, capability conferral plus the dual conditional,\n186|// transition, force_stale authorization, generation recheck, landed\n187|// fencing authorization, deadline, receipt discipline with\n188|// status-reconciled resume, and the kill plus close-confirm effects.\n189|func (lc *Lifecycle) executeTerminate(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n190|\tempty := OpOutcome{Operation: terminalbackend.OperationTerminateStale}\n191|\tbody, err := parseTerminateBody(req.Body)\n192|\tif err != nil {\n193|\t\treturn empty, err\n194|\t}\n195|\toperation := terminalbackend.OperationTerminateStale\n196|\tmctx := body.Context\n197|\tsource := terminalbackend.InstanceState(req.Source)\n198|\tif err := checkLifecycleBackend(mctx.TerminalBackendID); err != nil {\n199|\t\treturn empty, err\n200|\t}\n201|\tderived, err := terminalbackend.IdempotencyKey(string(operation), mctx.TerminalInstanceID, \"terminate\", body.StaleLeaseID, strconv.FormatUint(body.StaleEpoch, 10))\n202|\tif err != nil {\n203|\t\treturn empty, err\n204|\t}\n205|\tif mctx.IdempotencyKey != derived {\n206|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"idempotency key material\"}\n207|\t}\n208|\tif err := terminalbackend.CheckOperation(string(operation), req.Admitted); err != nil {\n209|\t\tfailure := rowError(operation, err)\n210|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n211|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n212|\t}\n213|\tif err := checkTerminateCapability(req.Admitted); err != nil {\n214|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n215|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n216|\t}\n217|\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), false)\n218|\tif err != nil {\n219|\t\tfailure := rowError(operation, err)\n220|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n221|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n222|\t}\n223|\tif err := terminstance.CheckAuthorization(mctx.Authorization, terminstance.AuthorizationForceStale, lc.CurrentLease(), lc.Now()); err != nil {\n224|\t\tfailure := rowError(operation, err)\n225|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n226|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n227|\t}\n228|\tif lc.CurrentGeneration() != mctx.BackendGeneration {\n229|\t\tfailure := &Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation stale\"}\n230|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n231|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n232|\t}\n233|\tif err := mapFencingError(fencing.AuthorizeTerminateStale(req.Presented, req.Winner, req.HasWinner, req.ForceRecovery, req.DiagnosticsPreserved)); err != nil {\n234|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n235|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n236|\t}\n237|\tif err := checkTerminateTarget(mctx, body, req.Presented); err != nil {\n238|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n239|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n240|\t}\n241|\tif err := checkTerminateWinner(mctx, req.Winner, lc.CurrentLease()); err != nil {\n242|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n243|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n244|\t}\n245|\tdeadline, err := mctx.Deadline.Time()\n246|\tif err != nil {\n247|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"mutation context deadline\"}\n248|\t}\n249|\tif !lc.Now().Before(deadline) {\n250|\t\tfailure := &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n251|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionReplaySame)\n252|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n253|\t}\n254|\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n255|\treqBackend.operation = operation\n256|\treqBackend.deadline = deadline\n257|\treturn lc.executeWithReceipt(ctx, req, socket, operation, mctx, source, target, effects, deadline, terminstance.AuthorizationForceStale, reqBackend, func(result terminstance.Result) OpOutcome {\n258|\t\treturn OpOutcome{Operation: operation, Mutation: &result, TargetClosed: true}\n259|\t})\n260|}\n261|\n262|// checkTerminateCapability enforces the dual conditional: stale\n263|// termination needs stale_process_termination AND\n264|// provider_process_observation. Each arm refuses alone.\n265|func checkTerminateCapability(admitted terminalbackend.Admitted) error {\n266|\tif !admitted.Has(\"stale_process_termination\") {\n267|\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n268|\t}\n269|\tif !admitted.Has(\"provider_process_observation\") {\n270|\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n271|\t}\n272|\treturn nil\n273|}\n274|\n275|// mapFencingError maps the landed terminate-stale authorization onto\n276|// the row's allowed set: malformed fencing material is the protocol\n277|// error, every other fencing refusal — no winner, no force, no\n278|// diagnostics, target mismatch, live owner — is the failed local\n279|// precondition. lease_conflict maps to the precondition too: the row\n280|// has no lease_conflict member, and a target fenced by another\n281|// session's winner fails the fenced-target precondition.\n282|func mapFencingError(err error) error {\n283|\tif err == nil {\n284|\t\treturn nil\n285|\t}\n286|\tif errors.Is(err, fencing.ErrInvalidArguments) {\n287|\t\treturn &Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminate fencing material\"}\n288|\t}\n289|\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate fencing authorization\"}\n290|}\n291|\n292|// checkTerminateTarget binds the presented fencing token to the\n293|// request: session, stale lease, and stale epoch must all agree with\n294|// the context and body. Any disagreement refuses the failed local\n295|// precondition: the retry would authorize a different target than the\n296|// key names.\n297|func checkTerminateTarget(mctx terminstance.MutationContext, body TerminateBody, presented fencing.PresentedToken) error {\n298|\tif presented.SessionID != mctx.SessionID ||\n299|\t\tpresented.LeaseID != body.StaleLeaseID ||\n300|\t\tpresented.Epoch != body.StaleEpoch {\n301|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate target binding\"}\n302|\t}\n303|\treturn nil\n304|}\n305|\n306|// checkTerminateWinner binds the caller-observed winner to the\n307|// re-read current lease: the fencing authorization decides over the\n308|// caller's winner, and only a winner that still wins authorizes. A\n309|// rotated or misobserved winner refuses the failed local\n310|// precondition; the caller re-observes and retries. Absence of a\n311|// winner never reaches here — the fencing gate refuses it first.\n312|func checkTerminateWinner(mctx terminstance.MutationContext, winner sessrepo.LeaseSummary, lease terminstance.LeaseView) error {\n313|\tif winner.SessionID != mctx.SessionID ||\n314|\t\twinner.LeaseID != lease.LeaseID ||\n315|\t\twinner.Epoch != lease.Epoch {\n316|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate winner binding\"}\n317|\t}\n318|\treturn nil\n319|}\n320|\n321|// executeRestore runs one restore: closed-shape admission, idempotency\n322|// material, capability conferral plus the reboot conditional,\n323|// transition, restore authorization, generation recheck, prior-binding\n324|// mismatch, deadline, receipt discipline with status-reconciled\n325|// resume, the persist plus wrapper-restored effects, the required\n326|// result binding, and the §4.2 after-restore branch report. The wire\n327|// result is always parked; the branch report (resumed, remote offer,\n328|// or parked) steers the caller. The backend launches no provider on\n329|// any branch: the wrapper owns launch gating through its own\n330|// decision, and this entry only recreates the wrapper process.\n331|//\n332|// The result binding is the create-time document kept alongside the\n333|// bootstrap receipt, re-admitted by termbind on the read: restore\n334|// mints nothing (the JCS identity rule stays termbind-private) and\n335|// echoes nothing. The prior-binding mismatch arm proves the carried\n336|// prior equals the recorded digest; the document read proves a valid\n337|// binding for this session, instance, backend, and generation.\n338|func (lc *Lifecycle) executeRestore(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n339|\tempty := OpOutcome{Operation: terminalbackend.OperationRestore}\n340|\tbody, err := parseRestoreBody(req.Body)\n341|\tif err != nil {\n342|\t\treturn empty, err\n343|\t}\n344|\toperation := terminalbackend.OperationRestore\n345|\tmctx := body.Context\n346|\tsource := terminalbackend.InstanceState(req.Source)\n347|\tif err := checkLifecycleBackend(mctx.TerminalBackendID); err != nil {\n348|\t\treturn empty, err\n349|\t}\n350|\tderived, err := terminalbackend.IdempotencyKey(string(operation), mctx.SessionID, body.BootstrapOperationID)\n351|\tif err != nil {\n352|\t\treturn empty, err\n353|\t}\n354|\tif mctx.IdempotencyKey != derived {\n355|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"idempotency key material\"}\n356|\t}\n357|\tif err := terminalbackend.CheckOperation(string(operation), req.Admitted); err != nil {\n358|\t\tfailure := rowError(operation, err)\n359|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n360|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n361|\t}\n362|\tif !req.Admitted.Has(\"reboot_restoration\") {\n363|\t\tfailure := &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n364|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n365|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n366|\t}\n367|\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), false)\n368|\tif err != nil {\n369|\t\tfailure := rowError(operation, err)\n370|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n371|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n372|\t}\n373|\tif err := terminstance.CheckAuthorization(mctx.Authorization, terminstance.AuthorizationRestore, lc.CurrentLease(), lc.Now()); err != nil {\n374|\t\tfailure := rowError(operation, err)\n375|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n376|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n377|\t}\n378|\tif lc.CurrentGeneration() != mctx.BackendGeneration {\n379|\t\tfailure := &Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation stale\"}\n380|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n381|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n382|\t}\n383|\tif err := lc.checkPriorBinding(body); err != nil {\n384|\t\tvar local *Error\n385|\t\tif errors.As(err, &local) && local.Code == terminalbackend.CodeRestoreMismatch {\n386|\t\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n387|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n388|\t\t}\n389|\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n390|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n391|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n392|\t}\n393|\tdeadline, err := mctx.Deadline.Time()\n394|\tif err != nil {\n395|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"mutation context deadline\"}\n396|\t}\n397|\tif !lc.Now().Before(deadline) {\n398|\t\tfailure := &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n399|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionReplaySame)\n400|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n401|\t}\n402|\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n403|\treqBackend.operation = operation\n404|\treqBackend.bootstrapID = body.BootstrapOperationID\n405|\t// The persist effect replays the recorded pair receipt (verified\n406|\t// by the mismatch arm above); the candidate carries the matched\n407|\t// prior digest so the store admits its shape on the replay path.\n408|\treqBackend.bindingID = body.PriorBindingID\n409|\toutcome, err := lc.executeWithReceipt(ctx, req, socket, operation, mctx, source, target, effects, deadline, terminstance.AuthorizationRestore, reqBackend, func(result terminstance.Result) OpOutcome {\n410|\t\treturn OpOutcome{Operation: operation, Mutation: &result, PriorBindingID: body.PriorBindingID, RestoredParked: true}\n411|\t})\n412|\tif err != nil {\n413|\t\treturn outcome, err\n414|\t}\n415|\tbinding, err := lc.restoreBinding(mctx, body)\n416|\tif err != nil {\n417|\t\treturn outcome, err\n418|\t}\n419|\toutcome.Binding = binding\n420|\tbranch := lc.afterRestoreBranch(ctx, req, mctx, body)\n421|\toutcome.AfterRestore = &branch\n422|\treturn outcome, nil\n423|}\n424|\n425|// restoreBinding reads the required restore result binding: the\n426|// create-time document kept under the (session, bootstrap) pair,\n427|// re-admitted by the termbind owner. A missing document is the\n428|// backend store failure — the receipt proved the prior, but the\n429|// payload is gone, so the required result cannot be built. A\n430|// document that fails termbind admission, or that names another\n431|// session, instance, backend, or generation than the mutation\n432|// context, is the integrity failure: the store disagrees with the\n433|// receipt it stands beside.\n434|func (lc *Lifecycle) restoreBinding(mctx terminstance.MutationContext, body RestoreBody) (*termbind.Binding, error) {\n435|\tdoc, found, err := lc.States.LookupBindingDoc(mctx.SessionID, body.BootstrapOperationID)\n436|\tif err != nil {\n437|\t\treturn nil, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n438|\t}\n439|\tif !found {\n440|\t\treturn nil, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n441|\t}\n442|\tbinding, err := termbind.ParseTerminalBinding(doc)\n443|\tif err != nil {\n444|\t\treturn nil, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n445|\t}\n446|\tif binding.SessionID != mctx.SessionID ||\n447|\t\tbinding.TerminalInstanceID != mctx.TerminalInstanceID ||\n448|\t\tbinding.TerminalBackendID != mctx.TerminalBackendID ||\n449|\t\tbinding.BackendGeneration != mctx.BackendGeneration {\n450|\t\treturn nil, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n451|\t}\n452|\treturn &binding, nil\n453|}\n454|\n455|// afterRestoreBranch runs the §4.2 after-restore sequence over the\n456|// winning-lease view: read the latest locally known lease, attempt\n457|// the mesh refresh under the measured bound, then branch. Local\n458|// resume requires the local host to hold the lease the refresh (or,\n459|// without one, local knowledge) names AND a valid materialization;\n460|// a winner another host holds offers remote attach/takeover in an\n461|// interactive terminal; every other case — including a\n462|// locally-held winner under an unseen lease tuple — parks without\n463|// launching a provider. The refresh is attempted, never required: a\n464|// missing, failed, or timed-out attempt falls back to local\n465|// knowledge.\n466|func (lc *Lifecycle) afterRestoreBranch(ctx context.Context, req OpRequest, mctx terminstance.MutationContext, body RestoreBody) AfterRestoreOutcome {\n467|\tlocal := lc.CurrentLease()\n468|\tbound := lc.MeshRefreshTimeout\n469|\tif bound <= 0 {\n470|\t\tbound = DefaultMeshRefreshTimeout\n471|\t}\n472|\twinner := RefreshWinner{LeaseID: local.LeaseID, Epoch: local.Epoch, HolderHostID: mctx.Authorization.HolderHostID}\n473|\tattempted := false\n474|\tif lc.LeaseRefresh != nil {\n475|\t\tattempted = true\n476|\t\trefreshCtx, cancel := context.WithTimeout(ctx, bound)\n477|\t\trefreshed, err := lc.LeaseRefresh(refreshCtx, mctx.SessionID)\n478|\t\tcancel()\n479|\t\tif err == nil {\n480|\t\t\twinner = refreshed\n481|\t\t}\n482|\t}\n483|\tlocalWins := lc.LocalHostID != \"\" &&\n484|\t\twinner.HolderHostID == lc.LocalHostID &&\n485|\t\twinner.LeaseID == local.LeaseID &&\n486|\t\twinner.Epoch == local.Epoch\n487|\t// A remote offer names another host: a winner the local host\n488|\t// holds under an unseen lease tuple is not remote (local\n489|\t// knowledge lags the mesh), and an unknown self proves neither\n490|\t// side. Both park without launching.\n491|\tremoteOwns := lc.LocalHostID != \"\" &&\n492|\t\twinner.HolderHostID != \"\" &&\n493|\t\twinner.HolderHostID != lc.LocalHostID\n494|\tmaterial := false\n495|\tif lc.Materialization != nil {\n496|\t\tif valid, err := lc.Materialization(mctx.SessionID, body.CheckpointID); err == nil && valid {\n497|\t\t\tmaterial = true\n498|\t\t}\n499|\t}\n500|\taction := AfterRestoreParked\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
