{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000fffd","stream":{"kind":"session","id":"01a0c765-6a15-7930-81af-9d81d9b3108a"},"sequence":7769,"recorded_at":1780531400015533,"record_type":"event","durability":"durable","causation_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"eb24712a-98eb-41ba-85bf-fe73b2577481","run_stream":{"kind":"run","id":"eb24712a-98eb-41ba-85bf-fe73b2577481"},"task_stream":{"kind":"task","id":"01a0c7b3-5cdd-7951-8167-2e52b14fcd1c"},"task_id":"01a0c7b3-5cdd-7951-8167-2e52b14fcd1c","event":{"kind":"output","task_id":"01a0c7b3-5cdd-7951-8167-2e52b14fcd1c","chunk":"Read text file `internal/tmuxserver/wrapper.go`.\n(75 line(s) above)\n76|// ExecuteWrapperRestore runs the §4.2 after-restore sequence to its\n77|// decided effects:\n78|//\n79|//  1. read the latest locally known lease (CurrentLease);\n80|//  2. attempt the mesh lease refresh under the measured bound (a\n81|//     missing, failed, or timed-out attempt falls back to local\n82|//     knowledge, unverified — never verified, never blocking\n83|//     forever);\n84|//  3. decide through the landed wrapper owner over the ordered\n85|//     winner (local win plus valid materialization resumes);\n86|//  4. offer remote attach/takeover when another host owns the session\n87|//     in an interactive terminal;\n88|//  5. park without launching the provider in all other cases.\n89|//\n90|// Only the launch and reattach decisions execute the backend restore;\n91|// the offer, park, and refuse decisions return with no backend\n92|// operation, no tmux exec, and no provider. Union-rival ambiguity is\n93|// not modeled here (bound B38): the entry decides over the single\n94|// refreshed or local winner, and a refresh adapter that observes\n95|// rivals must surface them as refresh failure so the entry parks\n96|// unverified.\n97|func (lc *Lifecycle) ExecuteWrapperRestore(ctx context.Context, req WrapperRestoreRequest) (WrapperRestoreOutcome, error) {\n98|\tempty := WrapperRestoreOutcome{}\n99|\tif lc == nil || lc.CurrentLease == nil || lc.CurrentGeneration == nil || lc.Now == nil ||\n100|\t\tlc.Runner == nil || lc.Receipts == nil || lc.Bindings == nil || lc.Attach == nil || lc.States == nil {\n101|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle dependencies\"}\n102|\t}\n103|\tif req.Decide.Mode != axpane.ModeRestore {\n104|\t\treturn empty, &Error{Code: CodeInvalidArguments, Detail: \"wrapper restore mode\"}\n105|\t}\n106|\tif req.Restore.Operation != string(terminalbackend.OperationRestore) {\n107|\t\treturn empty, &Error{Code: CodeInvalidArguments, Detail: \"wrapper restore operation\"}\n108|\t}\n109|\tlocal := lc.CurrentLease()\n110|\tbound := lc.MeshRefreshTimeout\n111|\tif bound <= 0 {\n112|\t\tbound = DefaultMeshRefreshTimeout\n113|\t}\n114|\twinner, verified, attempted, succeeded := lc.refreshWinner(ctx, req.Decide.SessionID, local, bound)\n115|\tnow := lc.Now()\n116|\tinput := req.Decide\n117|\tinput.Observation = fencing.Observation{\n118|\t\tSessionID:   req.Decide.SessionID,\n119|\t\tWinner:      winner,\n120|\t\tHasWinner:   winner.LeaseID != \"\" && winner.Epoch != 0,\n121|\t\tLocalHostID: lc.LocalHostID,\n122|\t\tVerified:    verified,\n123|\t\tGrant:       req.Grant,\n124|\t\tHasGrant:    req.HasGrant,\n125|\t\tPolicy:      req.Policy,\n126|\t\tNow:         now,\n127|\t}\n128|\tdecision := axpane.Decide(input)\n129|\toutcome := WrapperRestoreOutcome{\n130|\t\tDecision:         decision,\n131|\t\tRefreshAttempted: attempted,\n132|\t\tRefreshSucceeded: succeeded,\n133|\t\tRefreshBoundMs:   uint64(bound.Milliseconds()),\n134|\t\tWinnerLeaseID:    winner.LeaseID,\n135|\t\tWinnerHostID:     winner.HolderHostID,\n136|\t}\n137|\tswitch decision.Action {\n138|\tcase axpane.ActionLaunch, axpane.ActionReattach:\n139|\t\trestored, err := lc.Execute(ctx, req.Restore)\n140|\t\toutcome.Restore = &restored\n141|\t\tif err != nil {\n142|\t\t\treturn outcome, err\n143|\t\t}\n144|\t\treturn outcome, nil\n145|\tdefault:\n146|\t\treturn outcome, nil\n147|\t}\n148|}\n149|\n150|// refreshWinner attempts the §4.2 mesh lease refresh (step 2) under\n151|// the measured bound and reports the ordered winner: the refreshed\n152|// lease verified on success, the locally known lease unverified when\n153|// the adapter is missing, fails, or times out, and the zero winner\n154|// when no lease is known at all. Only a successful refresh verifies:\n155|// local knowledge never self-verifies, so a failed attempt parks\n156|// through the landed unverified arm instead of resuming.\n157|func (lc *Lifecycle) refreshWinner(ctx context.Context, sessionID string, local terminstance.LeaseView, bound time.Duration) (sessrepo.LeaseSummary, bool, bool, bool) {\n158|\tfallback := sessrepo.LeaseSummary{\n159|\t\tSessionID:    sessionID,\n160|\t\tLeaseID:      local.LeaseID,\n161|\t\tEpoch:        local.Epoch,\n162|\t\tHolderHostID: lc.LocalHostID,\n163|\t\tReason:       \"local-knowledge\",\n164|\t}\n165|\tif lc.LeaseRefresh == nil {\n166|\t\treturn fallback, false, false, false\n167|\t}\n168|\trefreshCtx, cancel := context.WithTimeout(ctx, bound)\n169|\trefreshed, err := lc.LeaseRefresh(refreshCtx, sessionID)\n170|\tcancel()\n171|\tif err != nil {\n172|\t\treturn fallback, false, true, false\n173|\t}\n174|\treturn sessrepo.LeaseSummary{\n175|\t\tSessionID:    sessionID,\n176|\t\tLeaseID:      refreshed.LeaseID,\n177|\t\tEpoch:        refreshed.Epoch,\n178|\t\tHolderHostID: refreshed.HolderHostID,\n179|\t\tReason:       \"mesh-refresh\",\n180|\t}, true, true, true\n181|}","final_result":true}}}
