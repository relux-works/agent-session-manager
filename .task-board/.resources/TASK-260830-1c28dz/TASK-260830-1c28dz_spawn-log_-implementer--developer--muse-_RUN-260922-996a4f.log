{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d187","stream":{"kind":"session","id":"01a0c930-3251-7961-8bb5-544ec0b1a36c"},"sequence":1822,"recorded_at":1780531400003639,"record_type":"event","durability":"durable","causation_id":"54c40bac-01d0-401d-8b14-649734ac40cf","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"54c40bac-01d0-401d-8b14-649734ac40cf","run_stream":{"kind":"run","id":"54c40bac-01d0-401d-8b14-649734ac40cf"},"task_stream":{"kind":"task","id":"01a0c93d-d770-7c11-96f9-4363fa9ceebb"},"task_id":"01a0c93d-d770-7c11-96f9-4363fa9ceebb","event":{"kind":"output","task_id":"01a0c93d-d770-7c11-96f9-4363fa9ceebb","chunk":"edited\nchanged lines: lines 850-856\n--- original\n+++ updated\n@@\n-// rowTimeoutCode reports the timeout code for one lifecycle operation:\n-// terminal_backend_timeout everywhere (neither terminate-stale nor\n-// restore names a dedicated timeout).\n-func rowTimeoutCode(operation terminalbackend.Operation) string {\n-\t_ = operation\n-\treturn terminstance.CodeTimeout\n-}\n+// rowTimeoutCode reports the §4.C timeout vocabulary per operation\n+// row: the wait row times out quiesce_timeout and the stop row\n+// stop_timeout, while every other row times out\n+// terminal_backend_timeout. This mirrors the landed engine's\n+// per-row mapping for the operations the engine scope leaves out\n+// and the within-effect revalidation; the literals are pinned by\n+// the row tests, never derived from the engine constant.\n+func rowTimeoutCode(operation terminalbackend.Operation) string {\n+\tswitch operation {\n+\tcase terminalbackend.OperationWaitSafeBoundary:\n+\t\treturn terminstance.CodeQuiesceTimeout\n+\tcase terminalbackend.OperationRequestStop:\n+\t\treturn terminstance.CodeStopTimeout\n+\tdefault:\n+\t\treturn terminstance.CodeTimeout\n+\t}\n+}\n","final_result":true}}}
