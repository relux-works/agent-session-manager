bbbbbbbbbbbbbbbbbbbbbbbb\"\n33|\tlxDigestC    = \"sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc\"\n34|\tlxIssued     = \"2026-09-01T00:00:00.000Z\"\n35|\tlxExpires    = \"2026-09-02T00:00:00.000Z\"\n36|\tlxDeadline   = \"2026-09-01T18:00:00.000Z\"\n37|\tlxImpl       = \"1.2.3\"\n38|\tlxProto      = \"1.0.0\"\n39|\tlxGeneration = \"generation-one\"\n40|)\n41|\n42|func lxNow() time.Time {\n43|\tnow, err := time.Parse(time.RFC3339Nano, \"2026-09-01T12:00:00.000Z\")\n44|\tif err != nil {\n45|\t\tpanic(err)\n46|\t}\n47|\treturn now\n48|}\n49|\n50|// lxAuth builds the closed AXAuthorization member map for one kind.\n51|func lxAuth(kind string) map[string]any {\n52|\treturn map[string]any{\n53|\t\t\"lease_id\":                  lxLease,\n54|\t\t\"lease_epoch\":               float64(7),\n55|\t\t\"holder_host_id\":            lxHost,\n56|\t\t\"authorization_kind\":        kind,\n57|\t\t\"issued_at\":                 lxIssued,\n58|\t\t\"expires_at\":                lxExpires,\n59|\t\t\"authorization_evidence_id\": lxDigestA,\n60|\t}\n61|}\n62|\n63|// lxContext builds the closed MutationContext member map. The caller\n64|// supplies the operation's canonical idempotency key.\n65|func lxContext(key string) map[string]any {\n66|\treturn map[string]any{\n67|\t\t\"operation_id\":           lxOperation,\n68|\t\t\"session_id\":             lxSession,\n69|\t\t\"terminal_instance_id\":   lxInstance,\n70|\t\t\"terminal_backend_id\":    \"ax.tmux\",\n71|\t\t\"implementation_version\": lxImpl,\n72|\t\t\"protocol_version\":       lxProto,\n73|\t\t\"backend_generation\":     lxGeneration,\n74|\t\t\"idempotency_key\":        key,\n75|\t\t\"deadline_at\":            lxDeadline,\n76|\t\t\"authorization\":          lxAuth(\"create\"),\n77|\t}\n78|}\n79|\n80|// lxContextJSON marshals a context map. mutate adjusts the map before\n81|// marshal (nil for the valid shape).\n82|func lxContextJSON(t *testing.T, key string, mutate func(map[string]any)) json.RawMessage {\n83|\tt.Helper()\n84|\tobject := lxContext(key)\n85|\tif mutate != nil {\n86|\t\tmutate(object)\n87|\t}\n88|\traw, err := json.Marshal(object)\n89|\tif err != nil {\n90|\t\tt.Fatal(err)\n91|\t}\n92|\treturn raw\n93|}\n94|\n95|// lxBindingDoc builds a valid Terminal Instance Binding 1.0.0\n96|// document minted through the test-only JCS identity, bound to the\n97|// lifecycle session/instance/generation. mutate adjusts the object\n98|// before the ID is minted (nil for the valid shape); a mutate that\n99|// sets binding_id to a non-empty value keeps it (for mismatch tests).\n100|func lxBindingDoc(t *testing.T, mutate func(map[string]any)) json.RawMessage {\n101|\tt.Helper()\n102|\tobject := map[string]any{\n103|\t\t\"schema\":                 \"urn:ax:schema:terminal-instance-binding\",\n104|\t\t\"schema_version\":         \"1.0.0\",\n105|\t\t\"binding_id\":             \"\",\n106|\t\t\"session_id\":             lxSession,\n107|\t\t\"host_id\":                lxHost,\n108|\t\t\"host_incarnation_id\":    lxHost,\n109|\t\t\"terminal_instance_id\":   lxInstance,\n110|\t\t\"terminal_backend_id\":    \"ax.tmux\",\n111|\t\t\"implementation_version\": lxImpl,\n112|\t\t\"protocol_version\":       lxProto,\n113|\t\t\"backend_generation\":     lxGeneration,\n114|\t\t\"native_reference\":       \"tmux-session-fixture-0\",\n115|\t\t\"created_at\":             \"2026-09-01T00:00:00.000Z\",\n116|\t\t\"supersedes_binding_id\":  nil,\n117|\t\t\"extensions\":             map[string]any{},\n118|\t}\n119|\tif mutate != nil {\n120|\t\tmutate(object)\n121|\t}\n122|\tif id, ok := object[\"binding_id\"].(string); ok && id == \"\" {\n123|\t\tobject[\"binding_id\"] = lxMintIdentity(t, object, \"binding_id\")\n124|\t}\n125|\traw, err := json.Marshal(object)\n126|\tif err != nil {\n127|\t\tt.Fatal(err)\n128|\t}\n129|\treturn raw\n130|}\n131|\n132|// lxMintIdentity derives the JCS omit-self digest for test fixtures.\n133|// It mirrors the termbind test helper; production never mints.\n134|func lxMintIdentity(t *testing.T, object map[string]any, selfField string) string {\n135|\tt.Helper()\n136|\tomitted := make(map[string]any, len(object))\n137|\tfor name, member := range object {\n138|\t\tif name != selfField {\n139|\t\t\tomitted[name] = member\n140|\t\t}\n141|\t}\n142|\tserialized, err := json.Marshal(omitted)\n143|\tif err != nil {\n144|\t\tt.Fatal(err)\n145|\t}\n146|\tcanonical, err := jcs.Transform(serialized)\n147|\tif err != nil {\n148|\t\tt.Fatal(err)\n149|\t}\n150|\tsum := sha256.Sum256(canonical)\n151|\treturn \"sha256:\" + hex.EncodeToString(sum[:])\n152|}\n153|\n154|// lxAttachAuth builds the closed AttachAuthorization member map.\n155|func lxAttachAuth(transport string, input bool) map[string]any {\n156|\treturn map[string]any{\n157|\t\t\"policy_evidence_id\":  lxDigestA,\n158|\t\t\"authorizing_host_id\": lxHost,\n159|\t\t\"transport\":           transport,\n160|\t\t\"input_authorized\":    input,\n161|\t\t\"issued_at\":           lxIssued,\n162|\t\t\"expires_at\":          lxExpires,\n163|\t}\n164|}\n165|\n166|// lxBody marshals a top-level operation body map.\n167|func lxBody(t *testing.T, object map[string]any) []byte {\n168|\tt.Helper()\n169|\traw, err := json.Marshal(object)\n170|\tif err != nil {\n171|\t\tt.Fatal(err)\n172|\t}\n173|\treturn raw\n174|}\n175|\n176|// lxCreateKey is the canonical create/restore key for the fixtures.\n177|func lxCreateKey() string { return lxSession + \"/\" + lxBootstrap }\n178|\n179|// lxQuiesceKey is the canonical quiesce-input key for the fixtures.\n180|func lxQuiesceKey() string { return lxInstance + \"/quiesce/\" + lxQuiesce }\n181|\n182|// lxBoundaryKey is the canonical wait-safe-boundary key.\n183|func lxBoundaryKey(kind string) string {\n184|\treturn lxInstance + \"/boundary/\" + lxQuiesce + \"/\" + kind\n185|}\n186|\n187|// lxStopKey is the canonical request-stop key.\n188|func lxStopKey() string { return lxInstance + \"/stop/\" + lxDigestA }\n189|\n190|// lxTerminateKey is the canonical terminate-stale key.\n191|func lxTerminateKey() string { return lxInstance + \"/terminate/\" + lxLeaseB + \"/9\" }\n192|\n193|// lxCreateBody builds the closed create body. mutate adjusts the\n194|// top-level map (nil for valid).\n195|func lxCreateBody(t *testing.T, mutate func(map[string]any)) []byte {\n196|\tt.Helper()\n197|\tcontext := lxContext(lxCreateKey())\n198|\tcontext[\"authorization\"] = lxAuth(\"create\")\n199|\tobject := map[string]any{\n200|\t\t\"context\":                context,\n201|\t\t\"binding\":                json.RawMessage(lxBindingDoc(t, nil)),\n202|\t\t\"bootstrap_operation_id\": lxBootstrap,\n203|\t\t\"entrypoint\":             map[string]any{\"argv\": []string{\"ax\", \"pane\", lxSession}},\n204|\t\t\"presentation_transport\": \"local_only\",\n205|\t\t\"interactive\":            true,\n206|\t}\n207|\tif mutate != nil {\n208|\t\tmutate(object)\n209|\t}\n210|\treturn lxBody(t, object)\n211|}\n212|\n213|// lxAttachBody builds the closed attach body.\n214|func lxAttachBody(t *testing.T, mutate func(map[string]any)) []byte {\n215|\tt.Helper()\n216|\tobject := map[string]any{\n217|\t\t\"session_id\":             lxSession,\n218|\t\t\"terminal_instance_id\":   lxInstance,\n219|\t\t\"terminal_backend_id\":    \"ax.tmux\",\n220|\t\t\"implementation_version\": lxImpl,\n221|\t\t\"protocol_version\":       lxProto,\n222|\t\t\"backend_generation\":     lxGeneration,\n223|\t\t\"client_id\":              lxClient,\n224|\t\t\"transport\":              \"local_only\",\n225|\t\t\"input_authorized\":       true,\n226|\t\t\"deadline_at\":            lxDeadline,\n227|\t\t\"authorization\":          lxAttachAuth(\"local_only\", true),\n228|\t}\n229|\tif mutate != nil {\n230|\t\tmutate(object)\n231|\t}\n232|\treturn lxBody(t, object)\n233|}\n234|\n235|// lxTerminateBody builds the closed terminate-stale body.\n236|func lxTerminateBody(t *testing.T, mutate func(map[string]any)) []byte {\n237|\tt.Helper()\n238|\tcontext := lxContext(lxTerminateKey())\n239|\tcontext[\"authorization\"] = lxAuth(\"force_stale\")\n240|\tobject := map[string]any{\n241|\t\t\"context\":                context,\n242|\t\t\"stale_lease_id\":         lxLeaseB,\n243|\t\t\"stale_epoch\":            float64(9),\n244|\t\t\"diagnostic_evidence_id\": lxDigestC,\n245|\t}\n246|\tif mutate != nil {\n247|\t\tmutate(object)\n248|\t}\n249|\treturn lxBody(t, object)\n250|}\n251|\n252|// lxRestoreBody builds the closed restore body. prior names the\n253|// carried prior_binding_id (lxDigestA unless the caller rebinds).\n254|func lxRestoreBody(t *testing.T, prior string, mutate func(map[string]any)) []byte {\n255|\tt.Helper()\n256|\tcontext := lxContext(lxCreateKey())\n257|\tcontext[\"authorization\"] = lxAuth(\"restore\")\n258|\tobject := map[string]any{\n259|\t\t\"context\":                context,\n260|\t\t\"prior_binding_id\":       prior,\n261|\t\t\"checkpoint_id\":          lxDigestC,\n262|\t\t\"bootstrap_operation_id\": lxBootstrap,\n263|\t}\n264|\tif mutate != nil {\n265|\t\tmutate(object)\n266|\t}\n267|\treturn lxBody(t, object)\n268|}\n269|\n270|// lxStatusBody builds the closed status body. exact selects the\n271|// exact-instance shape (both non-null) versus session-scoped (both null).\n272|func lxStatusBody(t *testing.T, exact, provider bool, mutate func(map[string]any)) []byte {\n273|\tt.Helper()\n274|\tvar instance, generation any\n275|\tif exact {\n276|\t\tinstance, generation = lxInstance, lxGeneration\n277|\t}\n278|\tobject := map[string]any{\n279|\t\t\"session_id\":                   lxSession,\n280|\t\t\"terminal_instance_id\":         instance,\n281|\t\t\"terminal_backend_id\":          \"ax.tmux\",\n282|\t\t\"implementation_version\":       lxImpl,\n283|\t\t\"protocol_version\":             lxProto,\n284|\t\t\"backend_generation\":           generation,\n285|\t\t\"include_provider_observation\": provider,\n286|\t\t\"deadline_at\":                  lxDeadline,\n287|\t}\n288|\tif mutate != nil {\n289|\t\tmutate(object)\n290|\t}\n291|\treturn lxBody(t, object)\n292|}\n293|\n294|// lxQuiesceBody builds the closed quiesce-input body.\n295|func lxQuiesceBody(t *testing.T, mutate func(map[string]any)) []byte {\n296|\tt.Helper()\n297|\tcontext := lxContext(lxQuiesceKey())\n298|\tcontext[\"authorization\"] = lxAuth(\"control\")\n299|\tobject := map[string]any{\n300|\t\t\"context\":               context,\n301|\t\t\"quiescence_generation\": lxQuiesce,\n302|\t}\n303|\tif mutate != nil {\n304|\t\tmutate(object)\n305|\t}\n306|\treturn lxBody(t, object)\n307|}\n308|\n309|// lxBoundaryBody builds the closed wait-safe-boundary body.\n310|func lxBoundaryBody(t *testing.T, kind string, timeout float64, mutate func(map[string]any)) []byte {\n311|\tt.Helper()\n312|\tcontext := lxContext(lxBoundaryKey(kind))\n313|\tcontext[\"authorization\"] = lxAuth(\"control\")\n314|\tobject := map[string]any{\n315|\t\t\"context\":               context,\n316|\t\t\"quiescence_generation\": lxQuiesce,\n317|\t\t\"provider_proof_kind\":   kind,\n318|\t\t\"timeout_ms\":            timeout,\n319|\t}\n320|\tif mutate != nil {\n321|\t\tmutate(object)\n322|\t}\n323|\treturn lxBody(t, object)\n324|}\n325|\n326|// lxStopBody builds the closed request-stop body.\n327|func lxStopBody(t *testing.T, timeout float64, mutate func(map[string]any)) []byte {\n328|\tt.Helper()\n329|\tcontext := lxContext(lxStopKey())\n330|\tcontext[\"authorization\"] = lxAuth(\"control\")\n331|\tobject := map[string]any{\n332|\t\t\"context\":                   context,\n333|\t\t\"safe_boundary_evidence_id\": lxDigestA,\n334|\t\t\"graceful_timeout_ms\":       timeout,\n335|\t}\n336|\tif mutate != nil {\n337|\t\tmutate(object)\n338|\t}\n339|\treturn lxBody(t, object)\n340|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
