{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9d3","stream":{"kind":"session","id":"01a0c930-3251-7961-8bb5-544ec0b1a36c"},"sequence":836,"recorded_at":1780531400001667,"record_type":"event","durability":"durable","causation_id":"54c40bac-01d0-401d-8b14-649734ac40cf","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"54c40bac-01d0-401d-8b14-649734ac40cf","run_stream":{"kind":"run","id":"54c40bac-01d0-401d-8b14-649734ac40cf"},"task_stream":{"kind":"task","id":"01a0c935-7ad3-7ea1-a31b-b58132c85d92"},"task_id":"01a0c935-7ad3-7ea1-a31b-b58132c85d92","event":{"kind":"output","task_id":"01a0c935-7ad3-7ea1-a31b-b58132c85d92","chunk":"Read text file `internal/terminstance/execute.go`.\n(391 line(s) above)\n392|// runEffects performs the transition's side effects under an already\n393|// bound receipt — freshly bound by ExecuteMutating or resumed by\n394|// resumeUncertain after status proved the source — with the per-effect\n395|// deadline, authorization and generation gates, then completes the key\n396|// exactly once. Fresh and resumed runs share this loop, so the recheck\n397|// and error rules exist once, never as a resumed twin.\n398|func (engine *Engine) runEffects(ctx context.Context, operation terminalbackend.Operation, context MutationContext, source, target terminalbackend.InstanceState, effects []terminalbackend.SideEffect, deadline time.Time, kind AuthorizationKind) (Result, error) {\n399|\tkey := context.IdempotencyKey\n400|\tcommitted := false\n401|\tevidence := []string(nil)\n402|\tperformed := []terminalbackend.SideEffect(nil)\n403|\tfor _, effect := range effects {\n404|\t\tif !engine.Now().Before(deadline) {\n405|\t\t\tfailure := refuse(rowTimeoutCode(operation), \"operation deadline\")\n406|\t\t\tif committed {\n407|\t\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, performed, evidence, DispositionStatusFirst), failure\n408|\t\t\t}\n409|\t\t\treturn buildResult(context, source, source, performed, evidence, DispositionReplaySame), failure\n410|\t\t}\n411|\t\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil {\n412|\t\t\tfailure := err.(*Error)\n413|\t\t\tafter := source\n414|\t\t\tif committed {\n415|\t\t\t\tafter = terminalbackend.StateUnavailable\n416|\t\t\t}\n417|\t\t\treturn buildResult(context, source, after, performed, evidence, DispositionFor(failure.Code, committed)), failure\n418|\t\t}\n419|\t\tif engine.CurrentGeneration() != context.BackendGeneration {\n420|\t\t\tfailure := refuse(CodeStaleGeneration, \"backend_generation stale\")\n421|\t\t\tafter := source\n422|\t\t\tif committed {\n423|\t\t\t\tafter = terminalbackend.StateUnavailable\n424|\t\t\t}\n425|\t\t\treturn buildResult(context, source, after, performed, evidence, DispositionFor(failure.Code, committed)), failure\n426|\t\t}\n427|\t\tif engine.Hooks != nil && engine.Hooks.BeforeEffect != nil {\n428|\t\t\tengine.Hooks.BeforeEffect(effect)\n429|\t\t}\n430|\t\tevidenceID, err := engine.Backend.PerformEffect(ctx, effect)\n431|\t\tif engine.Hooks != nil && engine.Hooks.AfterEffect != nil {\n432|\t\t\tengine.Hooks.AfterEffect(effect)\n433|\t\t}\n434|\t\tif err != nil {\n435|\t\t\tcode := ErrorCode(err)\n436|\t\t\tif code == \"\" {\n437|\t\t\t\tfailure := refuse(CodeProcessFailed, \"backend effect uncertain\")\n438|\t\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, performed, evidence, DispositionStatusFirst), failure\n439|\t\t\t}\n440|\t\t\tif err := terminalbackend.CheckErrorAllowed(string(operation), code); err != nil {\n441|\t\t\t\tfailure := refuse(CodeProtocolError, \"operation error vocabulary\")\n442|\t\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, performed, evidence, DispositionStatusFirst), failure\n443|\t\t\t}\n444|\t\t\tafter := source\n445|\t\t\tif committed {\n446|\t\t\t\tafter = terminalbackend.StateUnavailable\n447|\t\t\t}\n448|\t\t\tfailure := refuse(code, \"backend effect refused\")\n449|\t\t\treturn buildResult(context, source, after, performed, evidence, DispositionFor(code, committed)), failure\n450|\t\t}\n451|\t\tif _, err := scalar.ParseDigest(evidenceID); err != nil {\n452|\t\t\tfailure := refuse(CodeIntegrityFailure, \"backend effect evidence\")\n453|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, performed, evidence, DispositionStatusFirst), failure\n454|\t\t}\n455|\t\tcommitted = true\n456|\t\tperformed = append(performed, effect)\n457|\t\tevidence = append(evidence, evidenceID)\n458|\t}\n459|\tresult := buildResult(context, source, target, performed, evidence, DispositionReplaySame)\n460|\tencoded, err := json.Marshal(result)\n461|\tif err != nil {\n462|\t\tfailure := refuse(CodeIntegrityFailure, \"idempotency result image\")\n463|\t\tresult.Disposition = DispositionStatusFirst\n464|\t\treturn result, failure\n465|\t}\n466|\tif err := engine.Store.Complete(key, encoded); err != nil {\n467|\t\tfailure, ok := err.(*Error)\n468|\t\tif !ok {\n469|\t\t\tuncoded := refuse(CodeProcessFailed, \"idempotency store failure\")\n470|\t\t\tresult.Disposition = DispositionStatusFirst\n471|\t\t\treturn result, uncoded\n472|\t\t}\n473|\t\tresult.Disposition = DispositionStatusFirst\n474|\t\treturn result, failure\n475|\t}\n476|\treturn result, nil\n477|}\n478|\n479|// ExecuteStatus executes one status query: no receipt, no side effects,\n480|// no authorization and no transition bookkeeping of its own. The\n481|// reported state is adopted verbatim; the engine validates the report\n482|// (the reported match must equal the compared tuple, the landed\n483|// CheckStatusResult must admit it, evidence must be sorted-unique\n484|// digests) and enforces the provider-observation capability conditional.\n485|// A timeout or read failure is unknown, never absent: it returns an\n486|// error with no report.\n487|func (engine *Engine) ExecuteStatus(ctx context.Context, body StatusBody, source terminalbackend.InstanceState, admitted terminalbackend.Admitted) (StatusReport, error) {\n488|\tempty := StatusReport{}\n489|\tif engine == nil || engine.Backend == nil || engine.Now == nil {\n490|\t\treturn empty, refuse(CodeProtocolError, \"engine unavailable\")\n491|\t}\n492|\tif source != \"\" {\n493|\t\tif _, _, err := terminalbackend.CheckTransition(string(terminalbackend.OperationStatus), string(source), false); err != nil {\n494|\t\t\treturn empty, wrapLanded(err)\n495|\t\t}\n496|\t}\n497|\tdeadline, err := body.Deadline.Time()\n498|\tif err != nil {\n499|\t\treturn empty, refuse(CodeProtocolError, \"status body deadline\")\n500|\t}\n501|\tif !engine.Now().Before(deadline) {\n502|\t\treturn empty, refuse(CodeTimeout, \"operation deadline\")\n503|\t}\n504|\tif body.IncludeProviderObservation && !admitted.Has(\"provider_process_observation\") {\n505|\t\treturn empty, refuse(CodeCapabilityUnproven, \"operation capability conditional\")\n506|\t}\n507|\tobserved, err := engine.Backend.ObserveStatus(ctx, body)\n508|\tif err != nil {\n509|\t\tcode := ErrorCode(err)\n510|\t\tif code == \"\" {\n511|\t\t\treturn empty, refuse(CodeUnavailable, \"status observation unknown\")\n(more lines below)","final_result":true}}}
