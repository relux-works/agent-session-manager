{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ccaf","stream":{"kind":"session","id":"01a0c930-3251-7961-8bb5-544ec0b1a36c"},"sequence":1202,"recorded_at":1780531400002399,"record_type":"event","durability":"durable","causation_id":"54c40bac-01d0-401d-8b14-649734ac40cf","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"54c40bac-01d0-401d-8b14-649734ac40cf","run_stream":{"kind":"run","id":"54c40bac-01d0-401d-8b14-649734ac40cf"},"task_stream":{"kind":"task","id":"01a0c938-9a26-7760-a6d0-2c851d535729"},"task_id":"01a0c938-9a26-7760-a6d0-2c851d535729","event":{"kind":"output","task_id":"01a0c938-9a26-7760-a6d0-2c851d535729","chunk":"Read text file `internal/tmuxserver/wrapper.go`.\n(229 line(s) above)\n230|// still loses at the bound, and an answer that arrives after the\n231|// deadline elapsed is rejected even with a nil error (the expiry is\n232|// checked on the answer path too, because both arms can be ready at\n233|// once). The abandoned adapter send never blocks — the channel is\n234|// buffered — and its goroutine exits when the adapter returns, so\n235|// nothing here waits past the bound.\n236|func (lc *Lifecycle) refreshWinner(ctx context.Context, sessionID string, local terminstance.LeaseView, bound time.Duration) (sessrepo.LeaseSummary, bool, bool, bool) {\n237|\tfallback := sessrepo.LeaseSummary{\n238|\t\tSessionID:    sessionID,\n239|\t\tLeaseID:      local.LeaseID,\n240|\t\tEpoch:        local.Epoch,\n241|\t\tHolderHostID: lc.LocalHostID,\n242|\t\tReason:       \"local-knowledge\",\n243|\t}\n244|\tif lc.LeaseRefresh == nil {\n245|\t\treturn fallback, false, false, false\n246|\t}\n247|\trefreshCtx, cancel := context.WithTimeout(ctx, bound)\n248|\tdefer cancel()\n249|\tanswered := make(chan refreshResult, 1)\n250|\tgo func() {\n251|\t\twinner, err := lc.LeaseRefresh(refreshCtx, sessionID)\n252|\t\tanswered <- refreshResult{winner: winner, err: err}\n253|\t}()\n254|\tif lc.RefreshHooks != nil && lc.RefreshHooks.BeforeSelect != nil {\n255|\t\tlc.RefreshHooks.BeforeSelect()\n256|\t}\n257|\tselect {\n258|\tcase result := <-answered:\n259|\t\tif result.err != nil || refreshCtx.Err() != nil {\n260|\t\t\treturn fallback, false, true, false\n261|\t\t}\n262|\t\treturn sessrepo.LeaseSummary{\n263|\t\t\tSessionID:    sessionID,\n264|\t\t\tLeaseID:      result.winner.LeaseID,\n265|\t\t\tEpoch:        result.winner.Epoch,\n266|\t\t\tHolderHostID: result.winner.HolderHostID,\n267|\t\t\tReason:       \"mesh-refresh\",\n268|\t\t}, true, true, true\n269|\tcase <-refreshCtx.Done():\n270|\t\treturn fallback, false, true, false\n271|\t}\n272|}","final_result":true}}}
