{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c9ad","stream":{"kind":"session","id":"01a0c930-3251-7961-8bb5-544ec0b1a36c"},"sequence":817,"recorded_at":1780531400001629,"record_type":"event","durability":"durable","causation_id":"54c40bac-01d0-401d-8b14-649734ac40cf","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"54c40bac-01d0-401d-8b14-649734ac40cf","run_stream":{"kind":"run","id":"54c40bac-01d0-401d-8b14-649734ac40cf"},"call_id":"call_01a0c9356df17110b1c971f4d14e9735","text":"Read text file `internal/terminstance/execute.go`.\n(99 line(s) above)\n100|\t}\n101|\treturn source\n102|}\n103|\n104|// kindFor maps an engine operation to its AXAuthorization kind through the\n105|// landed transition-table authorization column: the table names the kind\n106|// and this function honors only the two the engine executes (create,\n107|// control). The force_stale and restore kinds parse but no engine\n108|// operation requests them — terminate-stale and restore recovery belongs\n109|// to the story's final leaf — and attach and none are never\n110|// AXAuthorization kinds. A drift between the table and this mapping fails\n111|// TestKindForAgreesWithLandedTable; no second table is restated here.\n112|func kindFor(operation terminalbackend.Operation) (AuthorizationKind, bool) {\n113|\tlanded, err := terminalbackend.TransitionAuthorization(string(operation))\n114|\tif err != nil {\n115|\t\treturn \"\", false\n116|\t}\n117|\tswitch AuthorizationKind(landed) {\n118|\tcase AuthorizationCreate:\n119|\t\treturn AuthorizationCreate, true\n120|\tcase AuthorizationControl:\n121|\t\treturn AuthorizationControl, true\n122|\tdefault:\n123|\t\treturn \"\", false\n124|\t}\n125|}\n126|\n127|// rowTimeoutCode is the §4.C timeout vocabulary per engine row: the wait\n128|// row times out quiesce_timeout and the stop row stop_timeout, while\n129|// create and quiesce-input time out terminal_backend_timeout.\n130|//\n131|// An engine deadline cancel before any attempt reports replay_same on\n132|// every row, including stop: nothing was attempted, so the identical\n133|// retry is safe. That differs deliberately from a backend-REPORTED\n134|// stop_timeout, which maps through DispositionFor (status_first even\n135|// uncommitted): a graceful wait that ran and timed out may have left\n136|// the provider mid-shutdown, while a cancel before the first attempt\n137|// proves nothing happened. The two directions are pinned together by\n138|// TestExecuteEntryDeadlineCodes and the stop rows of\n139|// TestExecuteBackendRowErrorSets.\n140|func rowTimeoutCode(operation terminalbackend.Operation) string {\n141|\tswitch operation {\n142|\tcase terminalbackend.OperationWaitSafeBoundary:\n143|\t\treturn CodeQuiesceTimeout\n144|\tcase terminalbackend.OperationRequestStop:\n145|\t\treturn CodeStopTimeout\n146|\tdefault:\n147|\t\treturn CodeTimeout\n148|\t}\n149|}\n150|\n151|// engineScope admits exactly the operations this engine executes: the\n152|// status, quiesce-input, wait-safe-boundary and request-stop rows plus\n153|// the create receipt rule. Status has its own entry; attach, restore,\n154|// terminate-stale, manifest and probe are refused here.\n155|func engineScope(operation terminalbackend.Operation) error {\n156|\tswitch operation {\n157|\tcase terminalbackend.OperationCreate, terminalbackend.OperationQuiesceInput,\n158|\t\tterminalbackend.OperationWaitSafeBoundary, terminalbackend.OperationRequestStop:\n159|\t\treturn nil\n160|\tdefault:\n161|\t\treturn refuse(CodeProtocolError, \"operation lifecycle scope\")\n162|\t}\n163|}\n164|\n165|// checkCapabilityConditional evaluates the §4.C conditional capability\n166|// dependencies at the operation call site, the half the landed\n167|// CheckOperation explicitly leaves to the lifecycle owner: headless\n168|// creation for non-interactive create, and safe-boundary observation\n169|// (plus provider-process observation for provider proof kinds) for\n170|// wait-safe-boundary. Quiesce-input and request-stop carry no conditional\n171|// beyond conferral — input_quiescence and graceful_stop are their sole\n172|// conferring capabilities, so the landed CheckOperation decides those\n173|// rows alone and no second arm restates it. The credential-realm\n174|// conditional is a stated bound: credential need is not modeled on this\n175|// path.\n176|func checkCapabilityConditional(operation terminalbackend.Operation, params Params, admitted terminalbackend.Admitted) error {\n177|\tswitch operation {\n178|\tcase terminalbackend.OperationCreate:\n179|\t\tif !params.Interactive && !admitted.Has(\"headless_creation\") {\n180|\t\t\treturn refuse(CodeCapabilityUnproven, \"operation capability conditional\")\n181|\t\t}\n182|\t\treturn nil\n183|\tcase terminalbackend.OperationQuiesceInput, terminalbackend.OperationRequestStop:\n184|\t\treturn nil\n185|\tcase terminalbackend.OperationWaitSafeBoundary:\n186|\t\tif !admitted.Has(\"safe_boundary_observation\") {\n187|\t\t\treturn refuse(CodeCapabilityUnproven, \"operation capability conditional\")\n188|\t\t}\n189|\t\tif RequiresProviderObservation(params.ProviderProofKind) && !admitted.Has(\"provider_process_observation\") {\n190|\t\t\treturn refuse(CodeCapabilityUnproven, \"operation capability conditional\")\n191|\t\t}\n192|\t\treturn nil\n193|\tdefault:\n194|\t\treturn refuse(CodeProtocolError, \"operation lifecycle scope\")\n195|\t}\n196|}\n197|\n198|// ExecuteMutating executes one create, quiesce-input, wait-safe-boundary\n199|// or request-stop request from the source state. A nil error is success\n200|// (after is the transition target, disposition replay_same: re-sending\n201|// replays). A non-nil execution error carries the row code with after\n202|// and disposition per the §4.C error rules: an error before the first\n203|// side effect restores the source state, while an error after a\n204|// committed effect whose result cannot be proven moves the local\n205|// observation to unavailable with status_first (new_authorization when\n206|// the failure names auth drift) and never claims absent. Malformed\n207|// requests (unknown operation, unparseable source or context) return an\n208|// empty result with the error, because a result repeating unvalidated\n209|// identities would echo data the gates refused. Authorization and\n210|// generation are rechecked immediately before each side effect, not\n211|// once at entry; a deadline cancels waiting, never a committed effect.\n212|//\n213|// Emission bound: the §4.C row sets govern backend REPORTS, which the\n214|// engine routes through CheckErrorAllowed (an outside-set code is\n215|// refused as a protocol error). The engine's own AX-side seam verdicts\n216|// are outside that rule: an uncoded effect outcome classifies\n217|// terminal_backend_process_failed, and an uncertain retry (receipt\n218|// without completion) whose status reconciliation proves nothing refuses\n219|// terminal_backend_unavailable, both with after unavailable and\n220|// status_first per the row recovery columns (\"uncertainty requires\n221|// status\", \"an error after an effect whose result cannot be proven\").\n222|// Those codes are the leaf's contract for failures the backend never\n223|// coded, pinned literally below.\n224|//\n225|// Recovery: a bound key without its completion reconciles through the\n226|// production status entry before it refuses. When status proves the\n227|// presented source state — nothing happened — the same operation\n228|// continues under the same receipt and completes it, so the §4.C\n229|// recovery columns (\"then same-key retry only if not closed\", \"Create\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
