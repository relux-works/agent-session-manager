{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ccdd","stream":{"kind":"session","id":"01a0c930-3251-7961-8bb5-544ec0b1a36c"},"sequence":1225,"recorded_at":1780531400002445,"record_type":"event","durability":"durable","causation_id":"54c40bac-01d0-401d-8b14-649734ac40cf","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"54c40bac-01d0-401d-8b14-649734ac40cf","run_stream":{"kind":"run","id":"54c40bac-01d0-401d-8b14-649734ac40cf"},"call_id":"call_01a0c938bf3c765f845c0d43954fb855","text":"Read text file `internal/tmuxserver/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/tmuxserver.\n3|\n4|Every gate ships a narrowing mutant: the gate stays present and is\n5|weakened to admit exactly one member of the class it must reject, and\n6|the named killer tests must fail. A delete-only mutant proves only that\n7|the gate exists and is not accepted as evidence; the five D- rows are\n8|explicitly supplementary and not counted as any gate's narrowing: three\n9|additive plants (D-background-fallback,\n10|D-background-fallback-foreground, D-restore-replay-rotation) and two\n11|positive-path wiring checks (D-lifecycle-restore-authkind,\n12|D-lifecycle-terminate-authkind), each labeled as such in its note.\n13|\n14|Each row runs M (mutate production files in place), R (run the scoped Go\n15|killers through the production entries), V (verdict from the Go exit code\n16|plus a FAIL kill-line: KILLED iff R fails with a test failure line,\n17|SURVIVED iff R passes, ERROR for anything else -- unapplied patches,\n18|build breaks, timeouts). M failures and R infrastructure errors are\n19|ERROR, never kills or survivals. Files are restored from backups after\n20|every row, pass or fail.\n21|\n22|Row C-control is the harmless control: a comment-only edit that must\n23|SURVIVE, proving the harness observes test outcomes instead of\n24|hard-coding kills.\n25|\n26|Usage:\n27|  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py\n28|  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py N-mode-create\n29|  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py --log-dir /tmp/mutant-logs\n30|  AX_MUTANT_VERBOSE=1 PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py N-mode-create\n31|\"\"\"\n32|\n33|import os\n34|import shutil\n35|import subprocess\n36|import sys\n37|import tempfile\n38|from dataclasses import dataclass\n39|from pathlib import Path\n40|\n41|REPO = Path(__file__).resolve().parents[2]\n42|PACKAGE = \"internal/tmuxserver\"\n43|\n44|\n45|@dataclass(frozen=True)\n46|class Mutant:\n47|    name: str\n48|    path: str\n49|    find: str\n50|    replace: str\n51|    count: int\n52|    run: str\n53|    expect: str\n54|    note: str\n55|\n56|\n57|BG_MISS = \"TestAcquireBackgroundMissReturnsTypedUnavailable\"\n58|BG_MISS_LINUX = \"(TestAcquireBackgroundMissReturnsTypedUnavailable|TestAcquireBackgroundMissOnLinuxAlsoRefusesWithoutFallback)\"\n59|OVERRIDE = \"TestAcquireRefusesEveryAmbientOverrideVector\"\n60|RES_OVERRIDE = \"(TestAcquireRefusesEveryAmbientOverrideVector|TestResolveSocketRefusesEveryOverrideVector)\"\n61|WIDENED = \"TestEnsureRuntimeDirRefusesWidenedMode\"\n62|COLLISION = \"(TestResolveSocketRefusesAmbientCollision|TestAcquireRefusesAmbientCollision)\"\n63|\n64|MUTANTS = [\n65|    Mutant(\n66|        name=\"N-mode-create\",\n67|        path=f\"{PACKAGE}/runtime_unix.go\",\n68|        find=\"\\t// leaf above; the mode comparison below is the load-bearing\\n\\t// arm this gate's tests and mutants pin.\\n\\tif info.Mode().Perm() != 0o700 {\\n\",\n69|        replace=\"\\t// leaf above; the mode comparison below is the load-bearing\\n\\t// arm this gate's tests and mutants pin.\\n\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o755 {\\n\",\n70|        count=1,\n71|        run=WIDENED,\n72|        expect=\"KILLED\",\n73|        note=\"Admits exactly 0755 at the create-path mode arm; other widened modes still refuse. Kill path: Ensure stops refusing.\",\n74|    ),\n75|    Mutant(\n76|        name=\"N-mode-verify\",\n77|        path=f\"{PACKAGE}/runtime_unix.go\",\n78|        find='\\tinfo, err := leaf.Stat()\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\\n\\t}\\n\\tif info.Mode().Perm() != 0o700 {\\n',\n79|        replace='\\tinfo, err := leaf.Stat()\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\\n\\t}\\n\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o755 {\\n',\n80|        count=1,\n81|        run=WIDENED,\n82|        expect=\"KILLED\",\n83|        note=\"Admits exactly 0755 at the verify-path mode arm; the create arm still refuses. Kill path: Verify stops refusing.\",\n84|    ),\n85|    Mutant(\n86|        name=\"N-mode-narrower-create\",\n87|        path=f\"{PACKAGE}/runtime_unix.go\",\n88|        find=\"\\t// leaf above; the mode comparison below is the load-bearing\\n\\t// arm this gate's tests and mutants pin.\\n\\tif info.Mode().Perm() != 0o700 {\\n\",\n89|        replace=\"\\t// leaf above; the mode comparison below is the load-bearing\\n\\t// arm this gate's tests and mutants pin.\\n\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o600 {\\n\",\n90|        count=1,\n91|        run=\"TestEnsureRuntimeDirRefusesNarrowerMode\",\n92|        expect=\"KILLED\",\n93|        note=\"Admits exactly a 0600 leaf at the create-path mode arm; every other non-0700 mode (widened and narrower) still refuses. Kill path: Ensure stops refusing the 0600 fixture.\",\n94|    ),\n95|    Mutant(\n96|        name=\"N-mode-narrower-verify\",\n97|        path=f\"{PACKAGE}/runtime_unix.go\",\n98|        find='\\tinfo, err := leaf.Stat()\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\\n\\t}\\n\\tif info.Mode().Perm() != 0o700 {\\n',\n99|        replace='\\tinfo, err := leaf.Stat()\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\\n\\t}\\n\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o600 {\\n',\n100|        count=1,\n101|        run=\"TestEnsureRuntimeDirRefusesNarrowerMode\",\n102|        expect=\"KILLED\",\n103|        note=\"Admits exactly a 0600 leaf at the verify-path mode arm; the create arm still refuses, so the kill comes from the Verify leg of the narrower-mode test. Narrower 0500 still refuses on both arms.\",\n104|    ),\n105|    Mutant(\n106|        name=\"N-fchmod-umask\",\n107|        path=f\"{PACKAGE}/runtime_unix.go\",\n108|        find=\"\\tif created {\\n\",\n109|        replace=\"\\tif created && os.Geteuid() == 0 {\\n\",\n110|        count=1,\n111|        run=\"TestEnsureRuntimeDirEnforcesModeUnderRestrictiveUmask\",\n112|        expect=\"KILLED\",\n113|        note=\"Admits exactly non-root creates past the explicit post-mkdirat chmod; root creates still chmod. Kill path: under umask 0177 the leaf stays 0600 and the mode gate refuses. Non-root load-bearing, like the same-shaped reviewer plant.\",\n114|    ),\n115|    Mutant(\n116|        name=\"N-ownership-uid\",\n117|        path=f\"{PACKAGE}/ownership_unix.go\",\n118|        find=\"\\tif stat.Uid != uint32(effectiveUID()) {\\n\",\n119|        replace=\"\\tif stat.Uid != uint32(effectiveUID()) && stat.Uid != uint32(effectiveUID())-100000 {\\n\",\n120|        count=1,\n121|        run=\"TestEnsureRuntimeDirRefusesForeignOwnership\",\n122|        expect=\"KILLED\",\n123|        note=\"Admits exactly the seam-shifted foreign UID; every other foreign UID still refuses.\",\n124|    ),\n125|    Mutant(\n126|        name=\"N-containment-slash\",\n127|        path=f\"{PACKAGE}/runtime.go\",\n128|        find='\\tif strings.Contains(name, \"/\") {\\n',\n129|        replace='\\tif strings.Contains(name, \"/\") && name != \"a/b\" {\\n',\n130|        count=1,\n131|        run=\"(TestEnsureRuntimeDirRefusesBadNames|TestVerifyRuntimeDirRefusesBadLexical)\",\n132|        expect=\"KILLED\",\n133|        note=\"Admits exactly the nested a/b name past the single-segment arm; every other multi-segment name still refuses. One shared site, both custody entries: kill reroutes past the invalid-name refusal on each.\",\n134|    ),\n135|    Mutant(\n136|        name=\"N-containment-mismatch\",\n137|        path=f\"{PACKAGE}/runtime.go\",\n138|        find=\"\\treturn sameDirectory(handleInfo, pathInfo)\\n\",\n139|        replace=\"\\treturn sameDirectory(handleInfo, pathInfo) || handleInfo.IsDir()\\n\",\n140|        count=1,\n141|        run=\"(TestEnsureRuntimeDirRefusesHandleMismatch|TestAcquireBackgroundRefusesHandleMismatch)\",\n142|        expect=\"KILLED\",\n143|        note=\"Admits exactly directory handles past the handle-binding check; the mismatch still refuses for non-directories. One shared site, three entries: the commit, verify, and background-acquisition mismatch tests admit the bound handle.\",\n144|    ),\n145|    Mutant(\n146|        name=\"N-containment-symlink\",\n147|        path=f\"{PACKAGE}/runtime_unix.go\",\n148|        find=\"\\tleafFd, err := unix.Openat(rootFd, name,\\n\\t\\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\",\n149|        replace=\"\\tleafFd, err := unix.Openat(rootFd, name,\\n\\t\\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\tif err != nil {\\n\\t\\tleafFd, err = unix.Openat(rootFd, name,\\n\\t\\t\\tunix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\t}\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\",\n150|        count=1,\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
