   verified,\n126|\t\tGrant:       req.Grant,\n127|\t\tHasGrant:    req.HasGrant,\n128|\t\tPolicy:      req.Policy,\n129|\t\tNow:         now,\n130|\t}\n131|\tdecision := axpane.Decide(input)\n132|\toutcome := WrapperRestoreOutcome{\n133|\t\tDecision:         decision,\n134|\t\tRefreshAttempted: attempted,\n135|\t\tRefreshSucceeded: succeeded,\n136|\t\tRefreshBoundMs:   uint64(bound.Milliseconds()),\n137|\t\tWinnerLeaseID:    winner.LeaseID,\n138|\t\tWinnerHostID:     winner.HolderHostID,\n139|\t}\n140|\tswitch decision.Action {\n141|\tcase axpane.ActionLaunch, axpane.ActionReattach:\n142|\t\tif err := checkRestoreComposedBound(req.Decide, decision, req.Restore.Body, winner); err != nil {\n143|\t\t\treturn outcome, err\n144|\t\t}\n145|\t\trestored, err := lc.Execute(ctx, req.Restore)\n146|\t\toutcome.Restore = &restored\n147|\t\tif err != nil {\n148|\t\t\treturn outcome, err\n149|\t\t}\n150|\t\treturn outcome, nil\n151|\tdefault:\n152|\t\treturn outcome, nil\n153|\t}\n154|}\n155|\n156|// checkRestoreComposedBound binds the executed backend restore to the\n157|// wrapper decision as one composed authorization: every identity the\n158|// effect names must equal the identity the decision authorized, or\n159|// the entry refuses the failed local precondition before any effect\n160|// runs. The joined members are the session, the bootstrap operation,\n161|// the admitted descriptor's instance, backend, and generation triple\n162|// (parsed and matched by the landed terminalbackend owner inside\n163|// Decide — this gate compares its output, never re-parses the\n164|// bytes), and the ordered winner's (lease_id, lease_epoch) against\n165|// the restore authorization. Matching a lease alone does not\n166|// establish that the effect is the restore the decision authorized:\n167|// without the full join a valid decision for one session,\n168|// bootstrap, or instance would authorize effects under another's\n169|// restore. A malformed restore body refuses its own parse error\n170|// (the same refusal the backend entry would return). Backend restore\n171|// authorization is never weakened to make the join fit: this gate\n172|// only refuses what the decision did not select.\n173|//\n174|// Deliberately unjoined, with reasons: the restore authorization's\n175|// holder host (the backend CheckAuthorization binds kind, expiry,\n176|// lease, and epoch only — the holder routes inside Decide's fencing\n177|// arm); materialization and checkpoint state (decision-local gates\n178|// enforced inside Decide, and the restore checkpoint_id is opaque\n179|// carried evidence with no production consumer); the prior binding\n180|// (bound to the recorded receipt by checkPriorBinding, while the\n181|// decision's ExistingBinding drives the bootstrap-window verdict);\n182|// and the descriptor's versions and binding digest (provider-build\n183|// and host-local namespaces that honestly differ from the AX API\n184|// versions and the bootstrap binding the restore carries).\n185|func checkRestoreComposedBound(decide axpane.Input, decision axpane.Decision, raw []byte, winner sessrepo.LeaseSummary) error {\n186|\tbody, err := parseRestoreBody(raw)\n187|\tif err != nil {\n188|\t\treturn err\n189|\t}\n190|\tif body.Context.SessionID != decide.SessionID {\n191|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"wrapper restore session binding\"}\n192|\t}\n193|\tif body.BootstrapOperationID != decide.BootstrapOperationID {\n194|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"wrapper restore bootstrap binding\"}\n195|\t}\n196|\tif body.Context.TerminalInstanceID != decision.Descriptor.TerminalInstanceID {\n197|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"wrapper restore instance binding\"}\n198|\t}\n199|\tif body.Context.TerminalBackendID != decision.Descriptor.TerminalBackendID {\n200|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"wrapper restore backend binding\"}\n201|\t}\n202|\tif body.Context.BackendGeneration != decision.Descriptor.BackendGeneration {\n203|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"wrapper restore generation binding\"}\n204|\t}\n205|\tif body.Context.Authorization.LeaseID != winner.LeaseID ||\n206|\t\tbody.Context.Authorization.LeaseEpoch != winner.Epoch {\n207|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"wrapper restore winner binding\"}\n208|\t}\n209|\treturn nil\n210|}\n211|\n212|// refreshResult is one mesh lease-refresh answer from the adapter\n213|// goroutine.\n214|type refreshResult struct {\n215|\twinner RefreshWinner\n216|\terr    error\n217|}\n218|\n219|// refreshWinner attempts the §4.2 mesh lease refresh (step 2) under\n220|// the measured bound and reports the ordered winner: the refreshed\n221|// lease verified on success, the locally known lease unverified when\n222|// the adapter is missing, fails, or times out, and the zero winner\n223|// when no lease is known at all. Only a successful refresh verifies:\n224|// local knowledge never self-verifies, so a failed attempt parks\n225|// through the landed unverified arm instead of resuming.\n226|//\n227|// The bound is enforced, never cooperative: the adapter runs on its\n228|// own goroutine and the entry takes whichever answers first — the\n229|// adapter or the deadline. An adapter that ignores cancellation\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
