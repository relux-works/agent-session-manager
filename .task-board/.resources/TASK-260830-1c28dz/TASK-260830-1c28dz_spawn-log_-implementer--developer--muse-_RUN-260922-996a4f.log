{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000da41","stream":{"kind":"session","id":"01a0c930-3251-7961-8bb5-544ec0b1a36c"},"sequence":2939,"recorded_at":1780531400005873,"record_type":"event","durability":"durable","causation_id":"54c40bac-01d0-401d-8b14-649734ac40cf","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"54c40bac-01d0-401d-8b14-649734ac40cf","run_stream":{"kind":"run","id":"54c40bac-01d0-401d-8b14-649734ac40cf"},"task_stream":{"kind":"task","id":"01a0c946-534f-7942-9c7d-7bae6a4e9e7c"},"task_id":"01a0c946-534f-7942-9c7d-7bae6a4e9e7c","event":{"kind":"output","task_id":"01a0c946-534f-7942-9c7d-7bae6a4e9e7c","chunk":"edited\nchanged lines: lines 2910-2912\n--- original\n+++ updated\n@@\n-    Mutant(\n-        name=\"C-control\",\n-        path=f\"{PACKAGE}/errors.go\",\n+    Mutant(\n+        name=\"N-stop-escalation-generation\",\n+        path=f\"{PACKAGE}/lifecycle.go\",\n+        find='\\tif lc.CurrentGeneration() != mctx.BackendGeneration {\\n\\t\\treturn &terminstance.Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation stale\"}\\n\\t}\\n',\n+        replace='\\tif lc.CurrentGeneration() != mctx.BackendGeneration && lc.CurrentGeneration() != \"generation-two\" {\\n\\t\\treturn &terminstance.Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation stale\"}\\n\\t}\\n',\n+        count=1,\n+        run=\"(TestExecuteStopRefusesStaleFactsAfterPoll|TestExecuteQuiesceRefusesStaleFactsBetweenCommands)\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly generation-two past the shared within-effect generation recheck (the terminstance.Error return pins the closure site against the two entry sites); every other stale generation still refuses. One shared site, two entries: the stop escalation issues its kill and the quiesce detach issues, so the generation subtests redden on both while the authorization and deadline subtests stay green (attribution per test from the raw log).\",\n+    ),\n+    Mutant(\n+        name=\"N-stop-escalation-expiry\",\n+        path=f\"{PACKAGE}/lifecycle.go\",\n+        find='\\t\\t\\treturn &terminstance.Error{Code: timeoutCode, Detail: \"operation deadline\"}\\n\\t\\t}\\n\\t\\tif err := terminstance.CheckAuthorization(mctx.Authorization, kind, lc.CurrentLease(), lc.Now()); err != nil {\\n',\n+        replace='\\t\\t\\treturn &terminstance.Error{Code: timeoutCode, Detail: \"operation deadline\"}\\n\\t\\t}\\n\\t\\tif err := terminstance.CheckAuthorization(mctx.Authorization, kind, lc.CurrentLease(), lc.Now().Add(-time.Hour)); err != nil {\\n',\n+        count=1,\n+        run=\"(TestExecuteStopRefusesStaleFactsAfterPoll|TestExecuteQuiesceRefusesStaleFactsBetweenCommands)\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly recently-expired authorizations past the shared within-effect authorization recheck (the timeoutCode context pins the closure site against the leaf-loop twin); members expired over an hour still refuse, and lease-drift members are untouched. One shared site, two entries: the authorization subtests redden on both while the generation and deadline subtests stay green (attribution per test from the raw log).\",\n+    ),\n+    Mutant(\n+        name=\"N-stop-escalation-deadline\",\n+        path=f\"{PACKAGE}/lifecycle.go\",\n+        find='\\t\\tif !lc.Now().Before(opDeadline) {\\n',\n+        replace='\\t\\tif lc.Now().After(opDeadline) {\\n',\n+        count=1,\n+        run=\"(TestExecuteStopRefusesStaleFactsAfterPoll|TestExecuteQuiesceRefusesStaleFactsBetweenCommands)\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the on-deadline instant past the shared within-effect deadline (strict Before becomes After); every strictly-late instant still refuses. One shared site, two entries: the stop deadline-instant subtest reddens (the kill issues at the instant) while the strictly-past deadline subtests stay green (attribution per test from the raw log).\",\n+    ),\n+    Mutant(\n+        name=\"N-stop-escalation-skip\",\n+        path=f\"{PACKAGE}/backend.go\",\n+        find='\\t\\tif err := runner.recheckPostWait(); err != nil {\\n\\t\\t\\treturn \"\", err\\n\\t\\t}\\n',\n+        replace='\\t\\tif err := runner.recheckPostWait(); err != nil && terminstance.ErrorCode(err) != terminalbackend.CodeStaleGeneration {\\n\\t\\t\\treturn \"\", err\\n\\t\\t}\\n',\n+        count=1,\n+        run=\"TestExecuteStopRefusesStaleFactsAfterPoll\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly stale-generation members past the escalation boundary (the 2-tab indentation pins the confirmClosed site against the 3-tab closeInput site); unauthorized and timed-out members still refuse there. Kill path: the kill issues under the rotated generation, so the generation subtest reddens while the authorization, deadline, and deadline-instant subtests stay green.\",\n+    ),\n+    Mutant(\n+        name=\"N-quiesce-midsequence-skip\",\n+        path=f\"{PACKAGE}/backend.go\",\n+        find='\\t\\t\\tif err := runner.recheckPostWait(); err != nil {\\n\\t\\t\\t\\treturn \"\", err\\n\\t\\t\\t}\\n',\n+        replace='\\t\\t\\tif err := runner.recheckPostWait(); err != nil && terminstance.ErrorCode(err) != terminalbackend.CodeStaleGeneration {\\n\\t\\t\\t\\treturn \"\", err\\n\\t\\t\\t}\\n',\n+        count=1,\n+        run=\"TestExecuteQuiesceRefusesStaleFactsBetweenCommands\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly stale-generation members past the detach boundary (the 3-tab indentation pins the closeInput site against the 2-tab escalation site); unauthorized and timed-out members still refuse there. Kill path: the detach issues under the rotated generation, so the generation subtest reddens while the authorization and deadline subtests stay green.\",\n+    ),\n+    Mutant(\n+        name=\"N-attach-overlap-multi\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\\tif !admitted.Has(\"multi_attach\") {\\n\\t\\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\\n\\t}\\n',\n+        replace='\\tif len(peers) > 1 && !admitted.Has(\"multi_attach\") {\\n\\t\\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\\n\\t}\\n',\n+        count=1,\n+        run=\"TestAttachOverlapRequiresMultiAttach\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the one-peer overlap past the multi_attach arm (the second client commits its receipt); two-peer overlaps still refuse. Kill path: the second attach succeeds without the capability while the third-attach precision leg stays refused.\",\n+    ),\n+    Mutant(\n+        name=\"N-attach-overlap-input\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\\t\\t\\tif !admitted.Has(\"multiple_input_clients\") {\\n\\t\\t\\t\\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\\n\\t\\t\\t}\\n',\n+        replace='\\t\\t\\tif len(peers) > 1 && !admitted.Has(\"multiple_input_clients\") {\\n\\t\\t\\t\\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\\n\\t\\t\\t}\\n',\n+        count=1,\n+        run=\"TestAttachOverlapInputRequiresMultipleInputClients\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the one-peer concurrent input past the multiple_input_clients arm (the second writable client commits its receipt with authorized input); overlaps over two peers still refuse. Kill path: the second attach succeeds without the capability while the third-attach precision leg stays refused.\",\n+    ),\n+    Mutant(\n+        name=\"N-attach-wait-deadline\",\n+        path=f\"{PACKAGE}/lifecycle.go\",\n+        find='\\treturn context.WithTimeout(ctx, deadline.Sub(lc.Now()))\\n',\n+        replace='\\treturn context.WithTimeout(ctx, deadline.Sub(lc.Now())+time.Hour)\\n',\n+        count=1,\n+        run=\"(TestAttachWaitBoundedByOperationDeadline|TestAttachWaitCancelledReturnsPromptly|TestQuiesceBarrierWaitBoundedByOperationDeadline|TestBoundaryCommitWaitBoundedByOperationDeadline)\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly waits expiring within the hour past the shared wait bound (every barrier and admission wait runs an hour long); cancellation still cancels. One shared site, four entries: the attach, quiesce, and boundary deadline tests redden (each blocks until its release) while the cancellation test stays green (attribution per test from the raw log).\",\n+    ),\n+    Mutant(\n+        name=\"C-control\",\n+        path=f\"{PACKAGE}/errors.go\",\n","final_result":true}}}
