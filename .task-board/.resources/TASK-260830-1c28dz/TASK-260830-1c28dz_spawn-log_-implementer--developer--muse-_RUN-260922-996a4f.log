{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7bb","stream":{"kind":"session","id":"01a0c930-3251-7961-8bb5-544ec0b1a36c"},"sequence":568,"recorded_at":1780531400001131,"record_type":"event","durability":"durable","causation_id":"54c40bac-01d0-401d-8b14-649734ac40cf","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"54c40bac-01d0-401d-8b14-649734ac40cf","run_stream":{"kind":"run","id":"54c40bac-01d0-401d-8b14-649734ac40cf"},"call_id":"call_01a0c932376873798255ef6ab68dba28","text":"Read text file `internal/tmuxserver/lifecycle.go`.\n(499 line(s) above)\n500|\t\t// below, so no attach receipt commits between the tmux\n501|\t\t// closure effects and their durable proof. The lock\n502|\t\t// releases at return. The boundary wait takes no such\n503|\t\t// span (it blocks on the wrapper signal); only its\n504|\t\t// report commit serializes, in its case branch.\n505|\t\tlc.barrierMu.Lock()\n506|\t\tdefer lc.barrierMu.Unlock()\n507|\t}\n508|\tresult, err := lc.engineFor(reqBackend).ExecuteMutating(ctx, operation, mctx, params, terminalbackend.InstanceState(req.Source), req.Admitted)\n509|\toutcome := OpOutcome{Operation: operation}\n510|\tif result.OperationID != \"\" {\n511|\t\toutcome.Mutation = &result\n512|\t\tif err != nil {\n513|\t\t\t// Failure results record only the honest\n514|\t\t\t// unknown: a pure refusal writes nothing\n515|\t\t\t// instead of overwriting an authoritative\n516|\t\t\t// record with stale caller state.\n517|\t\t\tlc.recordFailure(mctx.TerminalInstanceID, result.After)\n518|\t\t} else if operation != terminalbackend.OperationQuiesceInput && operation != terminalbackend.OperationWaitSafeBoundary {\n519|\t\t\t// Non-barrier successes record best-effort:\n520|\t\t\t// the memory is advisory and a lost write\n521|\t\t\t// never admits input.\n522|\t\t\t_ = lc.recordAfter(mctx.TerminalInstanceID, result.After)\n523|\t\t}\n524|\t\t// Barrier successes record below, checked, after the\n525|\t\t// outcome report commits: the report carries the closure\n526|\t\t// time the retry replays and the incarnation-scoped\n527|\t\t// proof the attach entry enforces, and the memory\n528|\t\t// carries the closure status reconciles against.\n529|\t}\n530|\tif err != nil {\n531|\t\treturn outcome, err\n532|\t}\n533|\tswitch operation {\n534|\tcase terminalbackend.OperationQuiesceInput:\n535|\t\toutcome.QuiescenceGeneration = params.QuiescenceGeneration\n536|\t\tclosedAt, err := lc.reportInputClosedAt(mctx.TerminalInstanceID, mctx.IdempotencyKey)\n537|\t\tif err != nil {\n538|\t\t\treturn outcome, err\n539|\t\t}\n540|\t\tif err := lc.recordAfter(mctx.TerminalInstanceID, result.After); err != nil {\n541|\t\t\treturn outcome, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"quiesce state image\"}\n542|\t\t}\n543|\t\toutcome.InputClosedAt = closedAt\n544|\tcase terminalbackend.OperationWaitSafeBoundary:\n545|\t\t// The boundary transition carries exactly one effect, and the\n546|\t\t// engine evidences every committed effect exactly once, so a\n547|\t\t// successful boundary result carries exactly one evidence ID.\n548|\t\toutcome.SafeBoundaryEvidenceID = result.EvidenceIDs[0]\n549|\t\t// Ordering contract, boundary side: the wait above ran\n550|\t\t// outside the lock; only the report commit below\n551|\t\t// serializes with attach receipts. The lock releases at\n552|\t\t// return.\n553|\t\tlc.barrierMu.Lock()\n554|\t\tdefer lc.barrierMu.Unlock()\n555|\t\tobservedAt, err := lc.reportBoundaryObservedAt(mctx.TerminalInstanceID, mctx.IdempotencyKey)\n556|\t\tif err != nil {\n557|\t\t\treturn outcome, err\n558|\t\t}\n559|\t\tif err := lc.recordAfter(mctx.TerminalInstanceID, result.After); err != nil {\n560|\t\t\treturn outcome, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"boundary state image\"}\n561|\t\t}\n562|\t\toutcome.BoundaryObservedAt = observedAt\n563|\tcase terminalbackend.OperationRequestStop:\n564|\t\toutcome.ProcessClosed = true\n565|\t\toutcome.StoreClosed = true\n566|\t}\n567|\treturn outcome, nil\n568|}\n569|\n570|// reportInputClosedAt replays the recorded input-closed time for one\n571|// quiesce key, recording the current time on first success. The\n572|// first-success record binds the current incarnation, so the report\n573|// proves the barrier exactly for the incarnation it closed. A\n574|// failed or forged lookup is corruption, never absence: the retry\n575|// refuses the integrity failure instead of manufacturing a fresh\n576|// closure time for an already-closed input. A record failure\n577|// refuses the same way: the effect is committed but its time is\n578|// unprovable, so the retry re-records rather than reporting an\n579|// unrecorded time.\n580|func (lc *Lifecycle) reportInputClosedAt(instanceID, key string) (string, error) {\n581|\tstored, found, err := lc.States.LookupOutcome(key)\n582|\tif err != nil {\n583|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"quiesce outcome image\"}\n584|\t}\n585|\tif found {\n586|\t\tif stored.InputClosedAt == \"\" {\n587|\t\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"quiesce outcome image\"}\n588|\t\t}\n589|\t\treturn stored.InputClosedAt, nil\n590|\t}\n591|\tincarnation, _, err := lc.States.LookupIncarnation(instanceID)\n592|\tif err != nil {\n593|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"quiesce outcome image\"}\n594|\t}\n595|\trendered := formatTimestamp(lc.Now())\n596|\tif err := lc.States.RecordOutcome(key, OperationOutcome{Operation: string(terminalbackend.OperationQuiesceInput), InputClosedAt: rendered, Incarnation: incarnation}); err != nil {\n597|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"quiesce outcome image\"}\n598|\t}\n599|\treturn rendered, nil\n600|}\n601|\n602|// reportBoundaryObservedAt replays the recorded boundary-observed\n603|// time for one boundary key, recording the current time on first\n604|// success, with the same corrupt-read and record-failure discipline\n605|// as the quiesce report: no failed read becomes fresh evidence.\n606|// The first-success record binds the current incarnation like the\n607|// quiesce report.\n608|func (lc *Lifecycle) reportBoundaryObservedAt(instanceID, key string) (string, error) {\n609|\tstored, found, err := lc.States.LookupOutcome(key)\n610|\tif err != nil {\n611|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"boundary outcome image\"}\n612|\t}\n613|\tif found {\n614|\t\tif stored.BoundaryObservedAt == \"\" {\n615|\t\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"boundary outcome image\"}\n616|\t\t}\n617|\t\treturn stored.BoundaryObservedAt, nil\n618|\t}\n619|\tincarnation, _, err := lc.States.LookupIncarnation(instanceID)\n620|\tif err != nil {\n621|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"boundary outcome image\"}\n622|\t}\n623|\trendered := formatTimestamp(lc.Now())\n624|\tif err := lc.States.RecordOutcome(key, OperationOutcome{Operation: string(terminalbackend.OperationWaitSafeBoundary), BoundaryObservedAt: rendered, Incarnation: incarnation}); err != nil {\n625|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"boundary outcome image\"}\n626|\t}\n627|\treturn rendered, nil\n628|}\n629|\n630|// boundWait bounds the safe-boundary wait by the lesser of the request\n631|// deadline and the timeout: the wait context carries the minimum, and\n632|// an already-invalid deadline falls back to the timeout alone (the\n633|// engine refuses the malformed deadline before any effect runs, so the\n634|// fallback never binds). The caller cancels the context.\n635|func (lc *Lifecycle) boundWait(ctx context.Context, mctx terminstance.MutationContext, timeoutMs uint64) (context.Context, context.CancelFunc) {\n636|\tbound := lc.Now().Add(time.Duration(timeoutMs) * time.Millisecond)\n637|\tif deadline, err := mctx.Deadline.Time(); err == nil && deadline.Before(bound) {\n638|\t\tbound = deadline\n639|\t}\n640|\treturn context.WithDeadline(ctx, bound)\n641|}\n642|\n643|// lesserDeadline computes the lesser of the request deadline and the\n644|// graceful timeout for the stop close-confirm poll. An invalid\n645|// deadline falls back the same way as the boundary wait.\n646|func (lc *Lifecycle) lesserDeadline(mctx terminstance.MutationContext, timeoutMs uint64) time.Time {\n647|\tbound := lc.Now().Add(time.Duration(timeoutMs) * time.Millisecond)\n648|\tif deadline, err := mctx.Deadline.Time(); err == nil && deadline.Before(bound) {\n649|\t\treturn deadline\n650|\t}\n651|\treturn bound\n652|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
