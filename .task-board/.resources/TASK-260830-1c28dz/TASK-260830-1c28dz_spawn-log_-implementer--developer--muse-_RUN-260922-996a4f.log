on} {\\n',\n1920|        count=1,\n1921|        run=\"(TestPerformEffectInputClosed|TestExecuteQuiesceBarrierSequence)\",\n1922|        expect=\"KILLED\",\n1923|        note=\"Admits exactly the lock-only barrier past the detach step; the lock step stays. Kill path: quiesce detaches nothing, at the helper and through the quiesce dispatch alike.\",\n1924|    ),\n1925|    Mutant(\n1926|        name=\"N-quiesce-sendkeys-absent\",\n1927|        path=f\"{PACKAGE}/backend.go\",\n1928|        find='\\tfor _, directive := range []Directive{DirectiveLockSession, DirectiveDetachClients} {\\n',\n1929|        replace='\\tfor _, directive := range []Directive{DirectiveLockSession, DirectiveSendInterrupt, DirectiveDetachClients} {\\n',\n1930|        count=1,\n1931|        run=\"TestExecuteQuiesceEmitsNoProviderInput\",\n1932|        expect=\"KILLED\",\n1933|        note=\"Admits exactly a provider-input step into the quiesce sequence; the lock/detach steps stay. Kill path: quiesce emits send-keys through the quiesce dispatch (the unscripted vector fails the run).\",\n1934|    ),\n1935|    Mutant(\n1936|        name=\"N-quiesce-attach-gate\",\n1937|        path=f\"{PACKAGE}/ops.go\",\n1938|        find='\\tproven, err := lc.States.QuiesceBarrierProven(instanceID)\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif proven {\\n',\n1939|        replace='\\tproven, err := lc.States.QuiesceBarrierProven(instanceID)\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif proven && instanceID != \"0198f4c8-8e50-7f66-8f70-222222222221\" {\\n',\n1940|        count=1,\n1941|        run=\"TestExecuteAttachRefusesInputWhenQuiescing\",\n1942|        expect=\"KILLED\",\n1943|        note=\"Admits exactly input-authorized attaches for the fixture instance past the incarnation-scoped closure proof; every other closed instance still refuses. Kill path: the quiesced input attach succeeds through the attach dispatch.\",\n1944|    ),\n1945|    Mutant(\n1946|        name=\"N-quiesce-state-record\",\n1947|        path=f\"{PACKAGE}/lifecycle.go\",\n1948|        find='\\t\\tif err := lc.recordAfter(mctx.TerminalInstanceID, result.After); err != nil {\\n\\t\\t\\treturn outcome, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \\\"quiesce state image\\\"}\\n',\n1949|        replace='\\t\\tif err := lc.recordAfter(mctx.TerminalInstanceID, result.After); err != nil && mctx.TerminalInstanceID != \\\"0198f4c8-8e50-7f66-8f70-222222222221\\\" {\\n\\t\\t\\treturn outcome, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \\\"quiesce state image\\\"}\\n',\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
