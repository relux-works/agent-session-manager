\\t\\t\\tif !runner.now().Before(runner.deadline) {\\ninternal/tmuxserver/backend.go:421:\\t\\t\\tif !runner.now().Before(runner.deadline) {\\ninternal/tmuxserver/backend.go:427:\\t\\tif !runner.now().Before(runner.deadline) {\\ninternal/tmuxserver/ops.go:316:\\treqBackend.deadline = deadline\\n\",\n  \"original_output_bytes\": 975,\n  \"original_output_tokens\": 244,\n  \"truncated\": false\n}","final_result":true}}}
