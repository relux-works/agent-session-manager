mpty, &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\\n\\t}\\n\\tif _, _, err := terminalbackend.CheckTransition(string(terminalbackend.OperationAttach), req.Source, false); err != nil {\\n',\n+        replace='\\tif lc.Now().After(deadline) {\\n\\t\\treturn empty, &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\\n\\t}\\n\\tif _, _, err := terminalbackend.CheckTransition(string(terminalbackend.OperationAttach), req.Source, false); err != nil {\\n',\n+        count=1,\n+        run=\"TestExecuteAttachRefusesDeadline/boundary\",\n+        expect=\"SURVIVED\",\n+        note=\"SUPPLEMENTARY SHADOWED NARROWING (not counted as any gate's narrowing): admits exactly the on-deadline instant past the attach entry deadline, but the wait bound refuses the same instant with the same verdict before any admission runs, so the plant survives by reroute. The entry arm stays as fail-fast precedence (pinned behaviorally: the killer passes with no admission); the enforced boundary is measured by N-attach-postlock-deadline and N-attach-wait-deadline.\",\n","final_result":true}}}
