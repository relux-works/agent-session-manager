{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc53","stream":{"kind":"session","id":"01a0c930-3251-7961-8bb5-544ec0b1a36c"},"sequence":1156,"recorded_at":1780531400002307,"record_type":"event","durability":"durable","causation_id":"54c40bac-01d0-401d-8b14-649734ac40cf","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"54c40bac-01d0-401d-8b14-649734ac40cf","run_stream":{"kind":"run","id":"54c40bac-01d0-401d-8b14-649734ac40cf"},"task_stream":{"kind":"task","id":"01a0c938-4df8-7d13-8968-7cda67fa0e97"},"task_id":"01a0c938-4df8-7d13-8968-7cda67fa0e97","event":{"kind":"output","task_id":"01a0c938-4df8-7d13-8968-7cda67fa0e97","chunk":"{\n  \"chunk_id\": \"exec-30-1\",\n  \"command\": \"grep -n \\\"TestWrapperRestoreRefreshBoundEnforced\\\" -A 60 internal/tmuxserver/wrapper_unix_test.go | head -n 80; echo ===; grep -n \\\"func \\\\|50 \\\\* time\\\\|Millisecond\\\" internal/tmuxserver/wrapper.go | head -n 30\",\n  \"description\": \"Read flaky timing test and wrapper code\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"881:// TestWrapperRestoreRefreshBoundEnforced pins the bound against a\\n882-// non-cooperative adapter: the callback sleeps a hundred times past\\n883-// the 1ms bound while ignoring cancellation, and the entry still\\n884-// returns at the bound, parks unverified, and runs nothing.\\n885:func TestWrapperRestoreRefreshBoundEnforced(t *testing.T) {\\n886-\\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\\n887-\\tfx.lc.LocalHostID = lxHost\\n888-\\tfx.lc.MeshRefreshTimeout = time.Millisecond\\n889-\\tfx.lc.LeaseRefresh = func(ctx context.Context, session string) (RefreshWinner, error) {\\n890-\\t\\ttime.Sleep(100 * time.Millisecond)\\n891-\\t\\treturn RefreshWinner{}, context.DeadlineExceeded\\n892-\\t}\\n893-\\trecordBinding(t, fx, lxDigestA)\\n894-\\tfx.runner.queue(\\\"new-session\\\", \\\"\\\", 0)\\n895-\\tstart := time.Now()\\n896-\\toutcome, err := fx.lc.ExecuteWrapperRestore(context.Background(), WrapperRestoreRequest{\\n897-\\t\\tDecide: wDecideInput(t, true), Grant: wGrant(t, wFreshValidatedAt), HasGrant: true, Policy: wPolicy(), Restore: wRestoreRequest(t),\\n898-\\t})\\n899-\\telapsed := time.Since(start)\\n900-\\tif err != nil {\\n901-\\t\\tt.Fatal(err)\\n902-\\t}\\n903-\\tif outcome.Decision.Action != axpane.ActionParked {\\n904-\\t\\tt.Fatalf(\\\"action = %s (%v), want parked\\\", outcome.Decision.Action, outcome.Decision.Cause)\\n905-\\t}\\n906-\\tif !outcome.RefreshAttempted || outcome.RefreshSucceeded {\\n907-\\t\\tt.Fatalf(\\\"refresh audit = %+v, want attempted without success\\\", outcome)\\n908-\\t}\\n909-\\tif elapsed >= 50*time.Millisecond {\\n910-\\t\\tt.Fatalf(\\\"configured 1ms refresh blocked %v\\\", elapsed)\\n911-\\t}\\n912-\\tif outcome.Restore != nil || fx.runner.callCount() != 0 {\\n913-\\t\\tt.Fatalf(\\\"unbounded refresh executed: %+v %v\\\", outcome.Restore, fx.runner.subcommands())\\n914-\\t}\\n915-\\tt.Logf(\\\"refresh bound 1ms against a 100ms cooperative-ignoring adapter, wall elapsed %v\\\", elapsed)\\n916-}\\n917-\\n918-// TestWrapperRestoreRefreshRaceRejectsLateAnswer forces the\\n919-// both-ready race deterministically: the adapter answers at once\\n920-// while the select hook stalls twenty times past the 1ms bound, so\\n921-// the answer and the deadline are both ready at every selection. A\\n922-// late answer never verifies no matter which arm the select takes —\\n923-// twenty consecutive parks, no execution.\\n924-func TestWrapperRestoreRefreshRaceRejectsLateAnswer(t *testing.T) {\\n925-\\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\\n926-\\tfx.lc.LocalHostID = lxHost\\n927-\\tfx.lc.MeshRefreshTimeout = time.Millisecond\\n928-\\tfx.lc.LeaseRefresh = func(ctx context.Context, session string) (RefreshWinner, error) {\\n929-\\t\\treturn RefreshWinner{LeaseID: lxLease, Epoch: 7, HolderHostID: lxHost}, nil\\n930-\\t}\\n931-\\tfx.lc.RefreshHooks = &RefreshHooks{BeforeSelect: func() { time.Sleep(20 * time.Millisecond) }}\\n932-\\trecordBinding(t, fx, lxDigestA)\\n933-\\tfor i := 0; i < 20; i++ {\\n934-\\t\\tfx.runner.queue(\\\"new-session\\\", \\\"\\\", 0)\\n935-\\t}\\n936-\\tfor i := 0; i < 20; i++ {\\n937-\\t\\toutcome, err := fx.lc.ExecuteWrapperRestore(context.Background(), WrapperRestoreRequest{\\n938-\\t\\t\\tDecide: wDecideInput(t, true), Grant: wGrant(t, wFreshValidatedAt), HasGrant: true, Policy: wPolicy(), Restore: wRestoreRequest(t),\\n939-\\t\\t})\\n940-\\t\\tif err != nil {\\n941-\\t\\t\\tt.Fatalf(\\\"iteration %d: %v\\\", i, err)\\n942-\\t\\t}\\n943-\\t\\tif outcome.Decision.Action != axpane.ActionParked {\\n944-\\t\\t\\tt.Fatalf(\\\"iteration %d: action = %s (%v), want parked over the late answer\\\", i, outcome.Decision.Action, outcome.Decision.Cause)\\n945-\\t\\t}\\n===\\n100:func (lc *Lifecycle) ExecuteWrapperRestore(ctx context.Context, req WrapperRestoreRequest) (WrapperRestoreOutcome, error) {\\n136:\\t\\tRefreshBoundMs:   uint64(bound.Milliseconds()),\\n185:func checkRestoreComposedBound(decide axpane.Input, decision axpane.Decision, raw []byte, winner sessrepo.LeaseSummary) error {\\n236:func (lc *Lifecycle) refreshWinner(ctx context.Context, sessionID string, local terminstance.LeaseView, bound time.Duration) (sessrepo.LeaseSummary, bool, bool, bool) {\\n\",\n  \"original_output_bytes\": 3860,\n  \"original_output_tokens\": 965,\n  \"truncated\": false\n}","final_result":true}}}
