{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc25","stream":{"kind":"session","id":"01a0c930-3251-7961-8bb5-544ec0b1a36c"},"sequence":1133,"recorded_at":1780531400002261,"record_type":"event","durability":"durable","causation_id":"54c40bac-01d0-401d-8b14-649734ac40cf","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"54c40bac-01d0-401d-8b14-649734ac40cf","run_stream":{"kind":"run","id":"54c40bac-01d0-401d-8b14-649734ac40cf"},"call_id":"call_01a0c93838a573ea80f4a901a2d61f11","text":"Read text file `internal/tmuxserver/lifecycle_rev7_unix_test.go`.\n1|//go:build !windows\n2|\n3|package tmuxserver\n4|\n5|import (\n6|\t\"context\"\n7|\t\"sync/atomic\"\n8|\t\"testing\"\n9|\t\"time\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n13|)\n14|\n15|// TestAttachRefusesGenerationRotatedDuringLockWait pins the P1\n16|// effect-boundary generation recheck: the server admission binds\n17|// the request generation, then the generation rotates while the\n18|// attach waits for the barrier lock. The post-lock recheck must\n19|// refuse the stale generation instead of committing a writable\n20|// receipt under it. The rotation lands strictly between the\n21|// admission read and the lock release (channel-ordered), so the\n22|// test is deterministic with no sleeps.\n23|func TestAttachRefusesGenerationRotatedDuringLockWait(t *testing.T) {\n24|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n25|\tvar changed atomic.Bool\n26|\tarrived := make(chan struct{}, 1)\n27|\tfx.lc.CurrentGeneration = func() string {\n28|\t\tif changed.Load() {\n29|\t\t\treturn \"generation-two\"\n30|\t\t}\n31|\t\treturn lxGeneration\n32|\t}\n33|\tadmitted := fullLifecycleAdmitted()\n34|\tfx.lc.ServerAdmission = func() (RealmAdmission, error) {\n35|\t\tgeneration := fx.lc.CurrentGeneration()\n36|\t\tarrived <- struct{}{}\n37|\t\treturn RealmAdmission{Admitted: admitted, RawGeneration: generation}, nil\n38|\t}\n39|\tfx.lc.barrierMu.Lock()\n40|\ttype attachResult struct {\n41|\t\toutcome OpOutcome\n42|\t\terr     error\n43|\t}\n44|\tdone := make(chan attachResult, 1)\n45|\tbody := lxAttachBody(t, nil)\n46|\tgo func() {\n47|\t\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n48|\t\t\tOperation: \"attach\", Body: body, Source: \"parked\", Admitted: fullLifecycleAdmitted(),\n49|\t\t})\n50|\t\tdone <- attachResult{outcome: outcome, err: err}\n51|\t}()\n52|\tselect {\n53|\tcase <-arrived:\n54|\tcase <-time.After(10 * time.Second):\n55|\t\tfx.lc.barrierMu.Unlock()\n56|\t\tt.Fatal(\"attach never reached server admission\")\n57|\t}\n58|\tchanged.Store(true)\n59|\tfx.lc.barrierMu.Unlock()\n60|\tvar res attachResult\n61|\tselect {\n62|\tcase res = <-done:\n63|\tcase <-time.After(10 * time.Second):\n64|\t\tt.Fatal(\"attach never returned after unlock\")\n65|\t}\n66|\trequireLocalCode(t, res.err, \"terminal_backend_stale_generation\", \"backend_generation stale\")\n67|\tif _, found, err := fx.lc.Attach.Lookup(lxSession, lxInstance, lxClient); err != nil || found {\n68|\t\tt.Fatalf(\"lookup = %v, %v; want no receipt\", found, err)\n69|\t}\n70|\tif len(res.outcome.Argv) != 0 {\n71|\t\tt.Fatalf(\"refused attach built argv %q\", res.outcome.Argv)\n72|\t}\n73|\tif res.outcome.Attach != nil && res.outcome.Attach.InputAuthorized {\n74|\t\tt.Fatalf(\"refused attach authorized input: %+v\", res.outcome.Attach)\n75|\t}\n76|}\n77|\n78|// TestAttachRefusesDeadlineExpiredDuringAdmission pins the P2-A\n79|// effect-boundary deadline recheck: the server admission advances\n80|// the clock past the operation deadline (18:00) while the\n81|// authorization stays valid (until the next day). The post-lock\n82|// recheck must refuse the timeout — the operation expired even\n83|// though its authorization did not — and commit no receipt.\n84|func TestAttachRefusesDeadlineExpiredDuringAdmission(t *testing.T) {\n85|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n86|\tadmitted := fullLifecycleAdmitted()\n87|\tfx.lc.ServerAdmission = func() (RealmAdmission, error) {\n88|\t\tfx.clock.Sleep(7 * time.Hour)\n89|\t\treturn RealmAdmission{Admitted: admitted, RawGeneration: lxGeneration}, nil\n90|\t}\n91|\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n92|\t\tOperation: \"attach\", Body: lxAttachBody(t, nil), Source: \"parked\", Admitted: fullLifecycleAdmitted(),\n93|\t})\n94|\trequireLocalCode(t, err, \"terminal_backend_timeout\", \"operation deadline\")\n95|\tif _, found, err := fx.lc.Attach.Lookup(lxSession, lxInstance, lxClient); err != nil || found {\n96|\t\tt.Fatalf(\"lookup = %v, %v; want no receipt\", found, err)\n97|\t}\n98|\tif len(outcome.Argv) != 0 {\n99|\t\tt.Fatalf(\"refused attach built argv %q\", outcome.Argv)\n100|\t}\n101|\tif outcome.Attach != nil && outcome.Attach.InputAuthorized {\n102|\t\tt.Fatalf(\"refused attach authorized input: %+v\", outcome.Attach)\n103|\t}\n104|}\n105|\n106|// TestAttachRefusesDeadlineOnTheInstantDuringAdmission pins the\n107|// strict bound at the same recheck: now equal to the deadline\n108|// when the lock releases refuses exactly like a late instant.\n109|func TestAttachRefusesDeadlineOnTheInstantDuringAdmission(t *testing.T) {\n110|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n111|\tadmitted := fullLifecycleAdmitted()\n112|\tfx.lc.ServerAdmission = func() (RealmAdmission, error) {\n113|\t\tfx.clock.Sleep(6 * time.Hour)\n114|\t\treturn RealmAdmission{Admitted: admitted, RawGeneration: lxGeneration}, nil\n115|\t}\n116|\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n117|\t\tOperation: \"attach\", Body: lxAttachBody(t, nil), Source: \"parked\", Admitted: fullLifecycleAdmitted(),\n118|\t})\n119|\trequireLocalCode(t, err, \"terminal_backend_timeout\", \"operation deadline\")\n120|\tif _, found, err := fx.lc.Attach.Lookup(lxSession, lxInstance, lxClient); err != nil || found {\n121|\t\tt.Fatalf(\"lookup = %v, %v; want no receipt\", found, err)\n122|\t}\n123|\tif len(outcome.Argv) != 0 {\n124|\t\tt.Fatalf(\"refused attach built argv %q\", outcome.Argv)\n125|\t}\n126|\tif outcome.Attach != nil && outcome.Attach.InputAuthorized {\n127|\t\tt.Fatalf(\"refused attach authorized input: %+v\", outcome.Attach)\n128|\t}\n129|}\n130|\n131|// TestAttachAuthorizationMembersRefuseWithoutReceipt pins the\n132|// composed attach authorization negative: each member the landed\n133|// gate binds — expiry, input, transport — refuses through the\n134|// production attach entry with no durable receipt. The input\n135|// member is the P2-B witness: asserting the returned error alone\n136|// is not enough, because a weakened input arm commits the\n137|// writable receipt before the result binding refuses — so the\n138|// test asserts the receipt absence as well as the refusal.\n139|func TestAttachAuthorizationMembersRefuseWithoutReceipt(t *testing.T) {\n140|\tfor _, member := range []string{\"expiry\", \"input\", \"transport\"} {\n141|\t\tt.Run(member, func(t *testing.T) {\n142|\t\t\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n143|\t\t\tbody := lxAttachBody(t, func(object map[string]any) {\n144|\t\t\t\tauth := lxAttachAuth(\"local_only\", true)\n145|\t\t\t\tswitch member {\n146|\t\t\t\tcase \"expiry\":\n147|\t\t\t\t\tauth[\"expires_at\"] = fx.clock.Now().Format(\"2006-01-02T15:04:05.000Z\")\n148|\t\t\t\tcase \"input\":\n149|\t\t\t\t\tauth[\"input_authorized\"] = false\n150|\t\t\t\tcase \"transport\":\n151|\t\t\t\t\tauth[\"transport\"] = \"trusted_private_mesh\"\n152|\t\t\t\t}\n153|\t\t\t\tobject[\"authorization\"] = auth\n154|\t\t\t})\n155|\t\t\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n156|\t\t\t\tOperation: \"attach\", Body: body, Source: \"parked\", Admitted: fullLifecycleAdmitted(),\n157|\t\t\t})\n158|\t\t\t_, found, lookupErr := fx.lc.Attach.Lookup(lxSession, lxInstance, lxClient)\n159|\t\t\tif lookupErr != nil {\n160|\t\t\t\tt.Fatal(lookupErr)\n161|\t\t\t}\n162|\t\t\tif err == nil || found {\n163|\t\t\t\tt.Fatalf(\"unauthorized effect: member=%s err=%v receipt=%v attach=%+v\", member, err, found, outcome.Attach)\n164|\t\t\t}\n165|\t\t\trequireLandedCode(t, err, \"terminal_backend_unauthorized\")\n166|\t\t\tif outcome.Attach != nil && outcome.Attach.InputAuthorized {\n167|\t\t\t\tt.Fatalf(\"refused attach authorized input: %+v\", outcome.Attach)\n168|\t\t\t}\n169|\t\t})\n170|\t}\n171|}\n172|\n173|// TestExecuteTerminateRefusesAuthorizationExpiredAfterReceipt pins\n174|// the per-effect authorization recheck as a negative witness: the\n175|// authorization is valid at entry (12:00, expiring 13:00) and\n176|// expires before the first effect runs (the receipt hook advances\n177|// the clock to 14:00, still before the 18:00 deadline). The loop\n178|// must refuse before any effect executes — zero tmux commands —\n179|// rather than running the kill under the lapsed grant.\n180|func TestExecuteTerminateRefusesAuthorizationExpiredAfterReceipt(t *testing.T) {\n181|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n182|\traw := lxTerminateBody(t, func(object map[string]any) {\n183|\t\tobject[\"context\"].(map[string]any)[\"authorization\"].(map[string]any)[\"expires_at\"] = \"2026-09-01T13:00:00.000Z\"\n184|\t})\n185|\tpresented, winner := terminateFencing()\n186|\tfx.lc.Hooks = &terminstance.EngineHooks{\n187|\t\tAfterReceipt: func(terminalbackend.Operation, string, terminalbackend.InstanceState) {\n188|\t\t\tfx.clock.Sleep(2 * time.Hour)\n189|\t\t},\n190|\t}\n191|\tfx.runner.queue(\"kill-session\", \"\", 0)\n192|\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n193|\t\tOperation: \"terminate-stale\", Body: raw, Source: \"stale_fenced\",\n194|\t\tAdmitted: fullLifecycleAdmitted(), Presented: presented, Winner: winner,\n195|\t\tHasWinner: true, ForceRecovery: true, DiagnosticsPreserved: true,\n196|\t})\n197|\trequireLocalCode(t, err, \"terminal_backend_unauthorized\", \"lifecycle authorization recheck\")\n198|\tif outcome.Mutation == nil || outcome.Mutation.After != terminalbackend.StateStaleFenced {\n199|\t\tt.Fatalf(\"mutation = %+v\", outcome.Mutation)\n200|\t}\n201|\tif fx.runner.callCount() != 0 {\n202|\t\tt.Fatalf(\"refused terminate execed %d commands\", fx.runner.callCount())\n203|\t}\n204|}\n205|\n206|// TestExecuteRestoreRefusesAuthorizationExpiredAfterReceipt pins the\n207|// same per-effect recheck through the restore entry: the\n208|// authorization lapses between the receipt and the first effect,\n209|// so the loop refuses with nothing committed instead of running\n210|// the persist under the stale grant.\n211|func TestExecuteRestoreRefusesAuthorizationExpiredAfterReceipt(t *testing.T) {\n212|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n213|\trecordBinding(t, fx, lxDigestA)\n214|\traw := lxRestoreBody(t, lxDigestA, func(object map[string]any) {\n215|\t\tobject[\"context\"].(map[string]any)[\"authorization\"].(map[string]any)[\"expires_at\"] = \"2026-09-01T13:00:00.000Z\"\n216|\t})\n217|\tfx.lc.Hooks = &terminstance.EngineHooks{\n218|\t\tAfterReceipt: func(terminalbackend.Operation, string, terminalbackend.InstanceState) {\n219|\t\t\tfx.clock.Sleep(2 * time.Hour)\n220|\t\t},\n221|\t}\n222|\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n223|\t\tOperation: \"restore\", Body: raw, Source: \"absent\", Admitted: fullLifecycleAdmitted(),\n224|\t})\n225|\trequireLocalCode(t, err, \"terminal_backend_unauthorized\", \"lifecycle authorization recheck\")\n226|\tif outcome.Mutation == nil || outcome.Mutation.After != terminalbackend.StateAbsent {\n227|\t\tt.Fatalf(\"mutation = %+v\", outcome.Mutation)\n228|\t}\n229|\tif _, found, err := fx.lc.Receipts.Completed(lxCreateKey()); err != nil || found {\n230|\t\tt.Fatalf(\"completed = %v, %v; want no completion\", found, err)\n231|\t}\n232|\tif fx.runner.callCount() != 0 {\n233|\t\tt.Fatalf(\"refused restore execed %d commands\", fx.runner.callCount())\n234|\t}\n235|}\n236|\n237|// TestExecuteEntryRefusesWrongAuthorizationKind pins the entry\n238|// authorization kind as a genuinely admitting gate: a\n239|// control-kind body refuses at the entry check before any store\n240|// side effect — the effect loop would refuse the same verdict,\n241|// but only the entry arm leaves the key unbound. A mutant\n242|// rewiring the entry to the control kind admits the body past\n243|// the entry, binds the receipt, and refuses only at the loop, so\n244|// the no-bind assertion reddens.\n245|func TestExecuteEntryRefusesWrongAuthorizationKind(t *testing.T) {\n246|\tt.Run(\"terminate\", func(t *testing.T) {\n247|\t\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n248|\t\traw := lxTerminateBody(t, func(object map[string]any) {\n249|\t\t\tobject[\"context\"].(map[string]any)[\"authorization\"].(map[string]any)[\"authorization_kind\"] = \"control\"\n250|\t\t})\n251|\t\tpresented, winner := terminateFencing()\n252|\t\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n253|\t\t\tOperation: \"terminate-stale\", Body: raw, Source: \"stale_fenced\",\n254|\t\t\tAdmitted: fullLifecycleAdmitted(), Presented: presented, Winner: winner,\n255|\t\t\tHasWinner: true, ForceRecovery: true, DiagnosticsPreserved: true,\n256|\t\t})\n257|\t\trequireEngineCode(t, err, \"terminal_backend_unauthorized\")\n258|\t\tif outcome.Mutation == nil || outcome.Mutation.After != terminalbackend.StateStaleFenced {\n259|\t\t\tt.Fatalf(\"mutation = %+v\", outcome.Mutation)\n260|\t\t}\n261|\t\tif _, found, err := fx.lc.Receipts.Lookup(lxTerminateKey()); err != nil || found {\n262|\t\t\tt.Fatalf(\"lookup = %v, %v; want no receipt\", found, err)\n263|\t\t}\n264|\t\tif fx.runner.callCount() != 0 {\n265|\t\t\tt.Fatalf(\"refused terminate execed %d commands\", fx.runner.callCount())\n266|\t\t}\n267|\t})\n268|\tt.Run(\"restore\", func(t *testing.T) {\n269|\t\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n270|\t\trecordBinding(t, fx, lxDigestA)\n271|\t\traw := lxRestoreBody(t, lxDigestA, func(object map[string]any) {\n272|\t\t\tobject[\"context\"].(map[string]any)[\"authorization\"].(map[string]any)[\"authorization_kind\"] = \"control\"\n273|\t\t})\n274|\t\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n275|\t\t\tOperation: \"restore\", Body: raw, Source: \"absent\", Admitted: fullLifecycleAdmitted(),\n276|\t\t})\n277|\t\trequireEngineCode(t, err, \"terminal_backend_unauthorized\")\n278|\t\tif outcome.Mutation == nil || outcome.Mutation.After != terminalbackend.StateAbsent {\n279|\t\t\tt.Fatalf(\"mutation = %+v\", outcome.Mutation)\n280|\t\t}\n281|\t\tif _, found, err := fx.lc.Receipts.Lookup(lxCreateKey()); err != nil || found {\n282|\t\t\tt.Fatalf(\"lookup = %v, %v; want no receipt\", found, err)\n283|\t\t}\n284|\t\tif fx.runner.callCount() != 0 {\n285|\t\t\tt.Fatalf(\"refused restore execed %d commands\", fx.runner.callCount())\n286|\t\t}\n287|\t})\n288|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
