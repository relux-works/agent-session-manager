{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c75b","stream":{"kind":"session","id":"01a0c930-3251-7961-8bb5-544ec0b1a36c"},"sequence":520,"recorded_at":1780531400001035,"record_type":"event","durability":"durable","causation_id":"54c40bac-01d0-401d-8b14-649734ac40cf","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"54c40bac-01d0-401d-8b14-649734ac40cf","run_stream":{"kind":"run","id":"54c40bac-01d0-401d-8b14-649734ac40cf"},"task_stream":{"kind":"task","id":"01a0c932-2336-7540-8631-df9acd48d797"},"task_id":"01a0c932-2336-7540-8631-df9acd48d797","event":{"kind":"output","task_id":"01a0c932-2336-7540-8631-df9acd48d797","chunk":"Read text file `internal/tmuxserver/ops.go`.\n(499 line(s) above)\n500|// another session, instance, or backend than the mutation context, is\n501|// the integrity failure: the store disagrees with the receipt it\n502|// stands beside.\n503|func (lc *Lifecycle) readRestorePrior(mctx terminstance.MutationContext, body RestoreBody) (termbind.Binding, error) {\n504|\tempty := termbind.Binding{}\n505|\tdoc, found, err := lc.States.LookupBindingDoc(mctx.SessionID, body.BootstrapOperationID)\n506|\tif err != nil {\n507|\t\treturn empty, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n508|\t}\n509|\tif !found {\n510|\t\treturn empty, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n511|\t}\n512|\tbinding, err := termbind.ParseTerminalBinding(doc)\n513|\tif err != nil {\n514|\t\treturn empty, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n515|\t}\n516|\tif binding.SessionID != mctx.SessionID ||\n517|\t\tbinding.TerminalInstanceID != mctx.TerminalInstanceID ||\n518|\t\tbinding.TerminalBackendID != mctx.TerminalBackendID {\n519|\t\treturn empty, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n520|\t}\n521|\treturn binding, nil\n522|}\n523|\n524|// restoreBinding builds the required restore result binding after the\n525|// effects commit. Within one generation the prior is the result: the\n526|// re-admitted create-time document the pre-effects validation already\n527|// proved. Across a reboot the mutation context carries the new server\n528|// generation, and the result is the minted successor: the termbind\n529|// owner succeeds the prior (new generation, supersedes link, fresh\n530|// identity), the successor persists under the same pair key, and the\n531|// same successor returns. The mint is deterministic, so a retry after\n532|// a crash between the effects and the persist converges on the\n533|// identical document instead of forking, and a retry after the\n534|// persist replays the stored successor without minting again.\n535|func (lc *Lifecycle) restoreBinding(mctx terminstance.MutationContext, body RestoreBody) (*termbind.Binding, error) {\n536|\tprior, err := lc.readRestorePrior(mctx, body)\n537|\tif err != nil {\n538|\t\treturn nil, err\n539|\t}\n540|\tif prior.BackendGeneration == mctx.BackendGeneration {\n541|\t\treturn &prior, nil\n542|\t}\n543|\tminted, raw, err := termbind.MintSuccessorBinding(prior, mctx.BackendGeneration)\n544|\tif err != nil {\n545|\t\treturn nil, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n546|\t}\n547|\tif err := lc.States.RecordBindingDoc(mctx.SessionID, body.BootstrapOperationID, raw); err != nil {\n548|\t\treturn nil, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding write\"}\n549|\t}\n550|\treturn &minted, nil\n551|}\n552|\n553|// checkPriorBinding enforces the restore mismatch rule: the recorded\n554|// bootstrap binding for the (session, bootstrap) pair must exist and\n555|// its digest must equal the carried prior_binding_id. Substituting any\n556|// other binding — including the configured default — refuses the\n557|// restore mismatch. A binding read failure is an error, never a\n558|// mismatch: unknown is not a verdict.\n559|func (lc *Lifecycle) checkPriorBinding(body RestoreBody) error {\n560|\trecorded, found, err := lc.Bindings.Lookup(body.Context.SessionID, body.BootstrapOperationID)\n561|\tif err != nil {\n562|\t\treturn err\n563|\t}\n564|\tif !found || recorded.BindingDigest != body.PriorBindingID {\n565|\t\treturn &Error{Code: terminalbackend.CodeRestoreMismatch, Detail: \"restore prior binding\"}\n566|\t}\n567|\treturn nil\n568|}\n569|\n570|// effectPerformer executes one lifecycle side effect and reports its\n571|// evidence ID, the single capability the receipt-bound effect loop\n572|// needs from the request backend.\n573|type effectPerformer interface {\n574|\tPerformEffect(ctx context.Context, effect terminalbackend.SideEffect) (string, error)\n575|}\n576|\n577|// executeWithReceipt binds the idempotency receipt and runs the\n578|// effects under it, mirroring the engine's bind discipline: an\n579|// identical retry replays the one completion, a bound key without its\n580|// completion reconciles through the production status entry before it\n581|// refuses, and no path binds a second receipt for one key. complete\n582|// maps the successful result into the operation outcome; failures\n583|// return the outcome with the mutation set, mirroring the engine.\n584|func (lc *Lifecycle) executeWithReceipt(ctx context.Context, req OpRequest, socket string, operation terminalbackend.Operation, mctx terminstance.MutationContext, source, target terminalbackend.InstanceState, effects []terminalbackend.SideEffect, deadline time.Time, kind terminstance.AuthorizationKind, reqBackend effectPerformer, complete func(terminstance.Result) OpOutcome) (OpOutcome, error) {\n585|\tkey := mctx.IdempotencyKey\n586|\t_, replayed, err := lc.Receipts.Bind(key, operation, mctx.OperationID)\n587|\tif err != nil {\n588|\t\tif backendErrorCode(err) != \"\" {\n589|\t\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n590|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, rowError(operation, err)\n591|\t\t}\n592|\t\tif _, found, lookupErr := lc.Receipts.Lookup(key); lookupErr == nil && !found {\n593|\t\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"idempotency store failure\"}\n594|\t\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n595|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n596|\t\t}\n597|\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"idempotency store failure\"}\n598|\t\tresult := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n599|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n600|\t}\n601|\tif replayed {\n602|\t\t// A replayed success replays the stored result without\n603|\t\t// touching the incarnation: replaying an old restore\n604|\t\t// must not supersede a newer closure. Only the fresh\n605|\t\t// path rotates, after its effects commit.\n606|\t\tstored, found, err := lc.Receipts.Completed(key)\n607|\t\tif err != nil {\n608|\t\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"idempotency store failure\"}\n609|\t\t\tresult := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n610|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n611|\t\t}\n612|\t\tif !found {\n613|\t\t\treturn lc.resumeUncertain(ctx, req, socket, operation, mctx, source, target, effects, deadline, kind, reqBackend, complete)\n614|\t\t}\n615|\t\tvar result terminstance.Result\n616|\t\tif err := json.Unmarshal(stored, &result); err != nil {\n617|\t\t\tfailure := &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"idempotency result image\"}\n618|\t\t\trebuilt := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n619|\t\t\treturn OpOutcome{Operation: operation, Mutation: &rebuilt}, failure\n620|\t\t}\n621|\t\tif err := terminstance.CheckResult(mctx, source, result); err != nil {\n622|\t\t\tif backendErrorCode(err) == \"\" {\n623|\t\t\t\tfailure := &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"idempotency result image\"}\n624|\t\t\t\trebuilt := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n625|\t\t\t\treturn OpOutcome{Operation: operation, Mutation: &rebuilt}, failure\n626|\t\t\t}\n627|\t\t\trebuilt := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionFor(backendErrorCode(err), true))\n628|\t\t\treturn OpOutcome{Operation: operation, Mutation: &rebuilt}, rowError(operation, err)\n629|\t\t}\n630|\t\treturn complete(result), nil\n631|\t}\n632|\tif lc.Hooks != nil && lc.Hooks.AfterReceipt != nil {\n633|\t\tlc.Hooks.AfterReceipt(operation, key, terminstance.InterimState(operation, source))\n634|\t}\n635|\treturn lc.runLifecycleEffects(ctx, operation, mctx, source, target, effects, deadline, kind, reqBackend, complete)\n636|}\n637|\n638|// resumeUncertain reconciles a bound key without its completion through\n639|// the production status entry: when status proves the presented source\n640|// state — nothing happened — the same operation continues under the\n641|// same receipt; when status proves anything else, or fails, the retry\n642|// refuses uncertain with status_first. No path binds a second receipt\n643|// for one key.\n644|func (lc *Lifecycle) resumeUncertain(ctx context.Context, req OpRequest, socket string, operation terminalbackend.Operation, mctx terminstance.MutationContext, source, target terminalbackend.InstanceState, effects []terminalbackend.SideEffect, deadline time.Time, kind terminstance.AuthorizationKind, reqBackend effectPerformer, complete func(terminstance.Result) OpOutcome) (OpOutcome, error) {\n645|\tbody := terminstance.StatusBody{\n646|\t\tSessionID:                  mctx.SessionID,\n647|\t\tTerminalInstanceID:         mctx.TerminalInstanceID,\n648|\t\tHasTerminalInstanceID:      true,\n649|\t\tTerminalBackendID:          mctx.TerminalBackendID,\n650|\t\tImplementationVersion:      mctx.ImplementationVersion,\n651|\t\tProtocolVersion:            mctx.ProtocolVersion,\n652|\t\tBackendGeneration:          mctx.BackendGeneration,\n653|\t\tHasBackendGeneration:       true,\n654|\t\tIncludeProviderObservation: false,\n655|\t\tDeadline:                   mctx.Deadline,\n656|\t}\n657|\tstatusBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n658|\tstatusBackend.operation = terminalbackend.OperationStatus\n659|\treport, err := lc.engineFor(statusBackend).ExecuteStatus(ctx, body, source, req.Admitted)\n660|\tif err != nil || report.State != source {\n661|\t\tfailure := &Error{Code: terminalbackend.CodeUnavailable, Detail: \"idempotency result uncertain\"}\n662|\t\tresult := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n663|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n664|\t}\n665|\tif lc.Hooks != nil && lc.Hooks.AfterReceipt != nil {\n666|\t\tlc.Hooks.AfterReceipt(operation, mctx.IdempotencyKey, terminstance.InterimState(operation, source))\n667|\t}\n668|\treturn lc.runLifecycleEffects(ctx, operation, mctx, source, target, effects, deadline, kind, reqBackend, complete)\n669|}\n670|\n671|// runLifecycleEffects performs the transition's side effects under an\n672|// already-bound receipt with the per-effect deadline, authorization,\n673|// and generation gates, then completes the key exactly once — the\n674|// engine's runEffects contract, second side. Fresh and resumed runs\n675|// share this loop. On success the after-state records in the AX-side\n676|// memory and the outcome completes; every failure returns the outcome\n677|// with the mutation set, mirroring the engine.\n678|func (lc *Lifecycle) runLifecycleEffects(ctx context.Context, operation terminalbackend.Operation, mctx terminstance.MutationContext, source, target terminalbackend.InstanceState, effects []terminalbackend.SideEffect, deadline time.Time, kind terminstance.AuthorizationKind, reqBackend effectPerformer, complete func(terminstance.Result) OpOutcome) (OpOutcome, error) {\n679|\tkey := mctx.IdempotencyKey\n680|\tcommitted := false\n681|\tevidence := []string(nil)\n682|\tperformed := []terminalbackend.SideEffect(nil)\n683|\tfail := func(code, detail string) (OpOutcome, error) {\n684|\t\tafter := source\n685|\t\tif committed {\n686|\t\t\tafter = terminalbackend.StateUnavailable\n687|\t\t}\n688|\t\tfailure := &Error{Code: code, Detail: detail}\n689|\t\tresult := mutationResult(mctx, source, after, performed, evidence, terminstance.DispositionFor(code, committed))\n690|\t\tlc.recordFailure(mctx.TerminalInstanceID, after)\n691|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n692|\t}\n693|\tfor _, effect := range effects {\n694|\t\tif !lc.Now().Before(deadline) {\n695|\t\t\treturn fail(rowTimeoutCode(operation), \"operation deadline\")\n696|\t\t}\n697|\t\tif err := terminstance.CheckAuthorization(mctx.Authorization, kind, lc.CurrentLease(), lc.Now()); err != nil {\n698|\t\t\tcode := backendErrorCode(err)\n699|\t\t\tif code == \"\" {\n700|\t\t\t\tcode = terminalbackend.CodeUnauthorized\n701|\t\t\t}\n702|\t\t\treturn fail(code, \"lifecycle authorization recheck\")\n703|\t\t}\n704|\t\tif lc.CurrentGeneration() != mctx.BackendGeneration {\n705|\t\t\treturn fail(terminalbackend.CodeStaleGeneration, \"backend_generation stale\")\n706|\t\t}\n707|\t\tif lc.Hooks != nil && lc.Hooks.BeforeEffect != nil {\n708|\t\t\tlc.Hooks.BeforeEffect(effect)\n709|\t\t}\n710|\t\tevidenceID, err := reqBackend.PerformEffect(ctx, effect)\n711|\t\tif lc.Hooks != nil && lc.Hooks.AfterEffect != nil {\n712|\t\t\tlc.Hooks.AfterEffect(effect)\n713|\t\t}\n714|\t\tif err != nil {\n715|\t\t\tcode := backendErrorCode(err)\n716|\t\t\tif code == \"\" {\n717|\t\t\t\treturn fail(terminstance.CodeProcessFailed, \"backend effect uncertain\")\n718|\t\t\t}\n719|\t\t\tif checkErr := terminalbackend.CheckErrorAllowed(string(operation), code); checkErr != nil {\n720|\t\t\t\treturn fail(terminalbackend.CodeProtocolError, \"operation error vocabulary\")\n721|\t\t\t}\n722|\t\t\treturn fail(code, \"backend effect refused\")\n723|\t\t}\n724|\t\tif _, err := scalar.ParseDigest(evidenceID); err != nil {\n725|\t\t\treturn fail(terminalbackend.CodeIntegrityFailure, \"backend effect evidence\")\n726|\t\t}\n727|\t\tcommitted = true\n728|\t\tperformed = append(performed, effect)\n729|\t\tevidence = append(evidence, evidenceID)\n730|\t}\n731|\tresult := mutationResult(mctx, source, target, performed, evidence, terminstance.DispositionReplaySame)\n732|\tencoded, err := json.Marshal(result)\n733|\tif err != nil {\n734|\t\tfailure := &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"idempotency result image\"}\n735|\t\tresult.Disposition = terminstance.DispositionStatusFirst\n736|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n737|\t}\n738|\tif err := lc.Receipts.Complete(key, encoded); err != nil {\n739|\t\tif backendErrorCode(err) == \"\" {\n740|\t\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"idempotency store failure\"}\n741|\t\t\tresult.Disposition = terminstance.DispositionStatusFirst\n742|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n743|\t\t}\n744|\t\tresult.Disposition = terminstance.DispositionStatusFirst\n745|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, rowError(operation, err)\n746|\t}\n747|\tif operation == terminalbackend.OperationRestore {\n748|\t\t// A fresh restore success opens a new incarnation like a\n749|\t\t// fresh create: prior closure reports are superseded.\n750|\t\t// Terminate-stale never rotates — it