{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf4d","stream":{"kind":"session","id":"01a0c836-a2d8-7092-9401-37d2858a2ec3"},"sequence":1537,"recorded_at":1780531400003069,"record_type":"event","durability":"durable","causation_id":"a68a1bdc-1b82-44d2-b715-51014e29fd57","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a68a1bdc-1b82-44d2-b715-51014e29fd57","run_stream":{"kind":"run","id":"a68a1bdc-1b82-44d2-b715-51014e29fd57"},"task_stream":{"kind":"task","id":"01a0c840-3390-7832-8cfb-d447029c5ce2"},"task_id":"01a0c840-3390-7832-8cfb-d447029c5ce2","event":{"kind":"output","task_id":"01a0c840-3390-7832-8cfb-d447029c5ce2","chunk":"edited\nchanged lines: lines 251-266\n--- original\n+++ updated\n@@\n-// recordAfter records the adopted after-state in the AX-side memory on\n-// every executed path. The memory is advisory on every path except\n-// the input-barrier successes (quiesce-input and wait-safe-boundary):\n-// elsewhere the idempotency receipt is the commit and a failed Record\n-// leaves later reads to reconcile — a hook-staged create failure test\n-// pins exactly that specified behavior. On the barrier successes the\n-// caller checks the returned error and fails closed instead: the\n-// attach entry enforces the input barrier from this memory, so a lost\n-// barrier write that still reported success would admit writable\n-// input after closure.\n-func (lc *Lifecycle) recordAfter(instance string, after terminalbackend.InstanceState) error {\n-\tif lc.States == nil {\n-\t\treturn nil\n-\t}\n-\treturn lc.States.Record(instance, after)\n-}\n+// recordAfter records the adopted after-state in the AX-side memory on\n+// success paths. The memory is advisory everywhere: status\n+// reconciles the live probe against it, but attach admission never\n+// consults it — only the incarnation-scoped closure proof decides\n+// admission, so a stale or lost memory record can neither reopen a\n+// closed barrier nor close an open one. On the barrier successes\n+// (quiesce-input and wait-safe-boundary) the caller still checks the\n+// returned error and fails closed, keeping the status memory\n+// faithful to the closure the operation just proved.\n+func (lc *Lifecycle) recordAfter(instance string, after terminalbackend.InstanceState) error {\n+\tif lc.States == nil {\n+\t\treturn nil\n+\t}\n+\treturn lc.States.Record(instance, after)\n+}\n+\n+// recordFailure records the after-state of a failed operation only\n+// when the failure is the honest unknown: committed effects with an\n+// uncertain tail (After unavailable). A pure refusal proves nothing\n+// about the instance — its After echoes the caller-carried source —\n+// so it writes nothing instead of overwriting an authoritative\n+// record with stale caller state. Failure reporting can never\n+// reopen a closed barrier: it either preserves the prior record or\n+// records the non-admitting unknown.\n+func (lc *Lifecycle) recordFailure(instance string, after terminalbackend.InstanceState) {\n+\tif after != terminalbackend.StateUnavailable {\n+\t\treturn\n+\t}\n+\t_ = lc.recordAfter(instance, after)\n+}\n","final_result":true}}}
