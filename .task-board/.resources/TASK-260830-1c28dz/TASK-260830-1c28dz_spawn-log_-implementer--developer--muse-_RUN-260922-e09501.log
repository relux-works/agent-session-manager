{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cf21","stream":{"kind":"session","id":"01a0c836-a2d8-7092-9401-37d2858a2ec3"},"sequence":1515,"recorded_at":1780531400003025,"record_type":"event","durability":"durable","causation_id":"a68a1bdc-1b82-44d2-b715-51014e29fd57","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a68a1bdc-1b82-44d2-b715-51014e29fd57","run_stream":{"kind":"run","id":"a68a1bdc-1b82-44d2-b715-51014e29fd57"},"task_stream":{"kind":"task","id":"01a0c840-17f9-76d1-aef3-c9fe69503d46"},"task_id":"01a0c840-17f9-76d1-aef3-c9fe69503d46","event":{"kind":"output","task_id":"01a0c840-17f9-76d1-aef3-c9fe69503d46","chunk":"edited\nchanged lines: lines 149-183\n--- original\n+++ updated\n@@\n-// checkAttachQuiesced enforces the quiesce input barrier at the\n-// attach entry: tmux offers no session freeze (a locked session does\n-// not lock subsequently attaching clients), so once the AX-side\n-// memory records quiescing, new input-authorized attaches refuse the\n-// failed local precondition. Read-only attaches stay admitted:\n-// quiesce stops input while retaining observation. A memory read\n-// failure is an error, never admission: unknown is not a verdict.\n-// When the memory holds no record at all, the barrier recovers from\n-// the completed closure outcomes instead: a recorded quiesce-input\n-// or wait-safe-boundary report for this instance proves the input\n-// closed, so a lost barrier write refuses exactly like the memory\n-// would — absence of memory is not proof of an open input.\n-func (lc *Lifecycle) checkAttachQuiesced(instanceID string, inputAuthorized bool) error {\n-\tif !inputAuthorized {\n-\t\treturn nil\n-\t}\n-\tmemory, found, err := lc.States.Lookup(instanceID)\n-\tif err != nil {\n-\t\treturn err\n-\t}\n-\tif found {\n-\t\tif memory == terminalbackend.StateQuiescing {\n-\t\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"attach quiesced input\"}\n-\t\t}\n-\t\treturn nil\n-\t}\n-\tproven, err := lc.States.QuiesceBarrierProven(instanceID)\n-\tif err != nil {\n-\t\treturn err\n-\t}\n-\tif proven {\n-\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"attach quiesced input\"}\n-\t}\n-\treturn nil\n-}\n+// checkAttachQuiesced enforces the quiesce input barrier at the\n+// attach entry: tmux offers no session freeze (a locked session does\n+// not lock subsequently attaching clients), so once a closure\n+// report proves the input closed in the current incarnation, new\n+// input-authorized attaches refuse the failed local precondition.\n+// Read-only attaches stay admitted: quiesce stops input while\n+// retaining observation. The incarnation-scoped closure proof is the\n+// sole admission verdict: advisory memory, caller-carried source\n+// state, and failure reporting are never consulted here, so none of\n+// them can reopen a closed barrier — a stale active record, a\n+// failure result echoing its source, and a lost state write all\n+// refuse exactly like the proof itself. Only a fresh create or\n+// restore success reopens the input, by rotating the incarnation\n+// the proof is scoped to. A proof read failure is an error, never\n+// admission: unknown is not a verdict.\n+func (lc *Lifecycle) checkAttachQuiesced(instanceID string, inputAuthorized bool) error {\n+\tif !inputAuthorized {\n+\t\treturn nil\n+\t}\n+\tproven, err := lc.States.QuiesceBarrierProven(instanceID)\n+\tif err != nil {\n+\t\treturn err\n+\t}\n+\tif proven {\n+\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"attach quiesced input\"}\n+\t}\n+\treturn nil\n+}\n","final_result":true}}}
