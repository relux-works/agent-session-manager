{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c759","stream":{"kind":"session","id":"01a0c836-a2d8-7092-9401-37d2858a2ec3"},"sequence":519,"recorded_at":1780531400001033,"record_type":"event","durability":"durable","causation_id":"a68a1bdc-1b82-44d2-b715-51014e29fd57","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a68a1bdc-1b82-44d2-b715-51014e29fd57","run_stream":{"kind":"run","id":"a68a1bdc-1b82-44d2-b715-51014e29fd57"},"call_id":"call_01a0c837d03371688337211034e62c7e","text":"Read text file `internal/tmuxserver/state.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"encoding/json\"\n7|\t\"errors\"\n8|\t\"fmt\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"strings\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n15|)\n16|\n17|// InstanceStates is the durable AX-side state memory for tmux-hosted\n18|// terminal instances: one JSON document per instance under\n19|// <root>/tmuxlifecycle/instances/<instance_id>.json, installed by\n20|// atomic rename. tmux itself reports only presence (sessions, panes,\n21|// attached counts); the AX states quiescing, stopped, and stale_fenced\n22|// exist only on this side, so status reconciles the live tmux probe\n23|// against this memory (see ClassifyStatus). The store is MUTABLE —\n24|// every mutating operation records its after-state — unlike the\n25|// no-replace idempotency receipts, whose keys can never name a state.\n26|//\n27|// The store is rooted at a DURABLE data root, never the runtime root:\n28|// the runtime root is per-boot temporary, while status after reboot\n29|// must still distinguish a stopped instance from an absent one.\n30|type InstanceStates struct {\n31|\troot  string\n32|\thooks *StateHooks\n33|}\n34|\n35|// StateHooks arms the crash boundaries of the state install: after the\n36|// state bytes are staged to the temporary file (before the atomic\n37|// rename), and after the rename commits (before the directory sync\n38|// makes the commit durable). A nil hook is a no-op; a hook error aborts\n39|// the call with that error. Hooks is nil in production.\n40|type StateHooks struct {\n41|\tAfterStage   func(path string) error\n42|\tAfterInstall func(path string) error\n43|}\n44|\n45|// stateDocument is the stored shape: exactly schema, schema_version,\n46|// terminal_instance_id, and state.\n47|type stateDocument struct {\n48|\tSchema             string `json:\"schema\"`\n49|\tSchemaVersion      string `json:\"schema_version\"`\n50|\tTerminalInstanceID string `json:\"terminal_instance_id\"`\n51|\tState              string `json:\"state\"`\n52|}\n53|\n54|// OpenInstanceStates creates the store, ensuring the root exists. It\n55|// creates no instance documents: those appear with the first Record.\n56|func OpenInstanceStates(root string) (*InstanceStates, error) {\n57|\tif root == \"\" {\n58|\t\treturn nil, errors.New(\"tmux instance state root is empty\")\n59|\t}\n60|\tbase := filepath.Join(root, \"tmuxlifecycle\", \"instances\")\n61|\tif err := os.MkdirAll(base, 0o755); err != nil {\n62|\t\treturn nil, fmt.Errorf(\"create tmux instance state root: %w\", err)\n63|\t}\n64|\treturn &InstanceStates{root: root}, nil\n65|}\n66|\n67|// WithHooks returns the store with crash hooks armed.\n68|func (store *InstanceStates) WithHooks(hooks *StateHooks) *InstanceStates {\n69|\tstore.hooks = hooks\n70|\treturn store\n71|}\n72|\n73|func (store *InstanceStates) instancePath(instanceID string) string {\n74|\treturn filepath.Join(store.root, \"tmuxlifecycle\", \"instances\", instanceID+\".json\")\n75|}\n76|\n77|// Record stores the after-state of one mutating operation for one\n78|// instance. The install is atomic (stage, fsync, rename, directory\n79|// fsync): a crash leaves the previous state or the new state, never a\n80|// torn document, and a retry converges by re-recording. Only AX\n81|// lifecycle states record; creating never records (it exists only\n82|// between the idempotency receipt and the first side effect, and the\n83|// receipt already proves that window).\n84|func (store *InstanceStates) Record(instanceID string, state terminalbackend.InstanceState) error {\n85|\tif store == nil {\n86|\t\treturn errors.New(\"tmux instance state store is nil\")\n87|\t}\n88|\tif _, err := scalar.ParseUUIDv7(instanceID); err != nil {\n89|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance state identity\"}\n90|\t}\n91|\tif _, err := terminalbackend.ParseInstanceState(string(state)); err != nil {\n92|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance state value\"}\n93|\t}\n94|\tif state == terminalbackend.StateCreating {\n95|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance state value\"}\n96|\t}\n97|\traw, err := json.Marshal(stateDocument{\n98|\t\tSchema:             \"urn:ax:schema:tmux-instance-state\",\n99|\t\tSchemaVersion:      \"1.0.0\",\n100|\t\tTerminalInstanceID: instanceID,\n101|\t\tState:              string(state),\n102|\t})\n103|\tif err != nil {\n104|\t\treturn fmt.Errorf(\"encode tmux instance state: %w\", err)\n105|\t}\n106|\treturn store.install(instanceID, raw)\n107|}\n108|\n109|// Lookup replays the recorded state for one instance, or reports\n110|// absence when the instance was never recorded. A read or validation\n111|// failure is an error, never absence: unknown is not absent.\n112|func (store *InstanceStates) Lookup(instanceID string) (terminalbackend.InstanceState, bool, error) {\n113|\tif store == nil {\n114|\t\treturn \"\", false, errors.New(\"tmux instance state store is nil\")\n115|\t}\n116|\tif _, err := scalar.ParseUUIDv7(instanceID); err != nil {\n117|\t\treturn \"\", false, &Error{Code: CodeInvalidArguments, Detail: \"instance state identity\"}\n118|\t}\n119|\traw, err := os.ReadFile(store.instancePath(instanceID))\n120|\tif err != nil {\n121|\t\tif errors.Is(err, os.ErrNotExist) {\n122|\t\t\treturn \"\", false, nil\n123|\t\t}\n124|\t\treturn \"\", false, fmt.Errorf(\"read tmux instance state: %w\", err)\n125|\t}\n126|\tvar document stateDocument\n127|\tif err := json.Unmarshal(raw, &document); err != nil {\n128|\t\treturn \"\", false, fmt.Errorf(\"decode tmux instance state: %w\", err)\n129|\t}\n130|\tif document.TerminalInstanceID != instanceID {\n131|\t\treturn \"\", false, &Error{Code: CodeInvalidArguments, Detail: \"instance state identity\"}\n132|\t}\n133|\tstate, err := terminalbackend.ParseInstanceState(document.State)\n134|\tif err != nil {\n135|\t\treturn \"\", false, &Error{Code: CodeInvalidArguments, Detail: \"instance state value\"}\n136|\t}\n137|\treturn state, true, nil\n138|}\n139|\n140|// OperationOutcome is the persisted operation-specific report for one\n141|// idempotency key: the closure timestamps the wire result carries\n142|// outside the mutation receipt (InputClosedAt for quiesce-input,\n143|// BoundaryObservedAt for wait-safe-boundary). The receipt proves the\n144|// effect; this document proves the reported time. First success\n145|// records; every retry replays the recorded values, so the same\n146|// receipt never changes its closure time.\n147|type OperationOutcome struct {\n148|\tOperation          string\n149|\tInputClosedAt      string\n150|\tBoundaryObservedAt string\n151|}\n152|\n153|// outcomeDocument is the stored outcome shape.\n154|type outcomeDocument struct {\n155|\tSchema             string `json:\"schema\"`\n156|\tSchemaVersion      string `json:\"schema_version\"`\n157|\tIdempotencyKey     string `json:\"idempotency_key\"`\n158|\tOperation          string `json:\"operation\"`\n159|\tInputClosedAt      string `json:\"input_closed_at\"`\n160|\tBoundaryObservedAt string `json:\"boundary_observed_at\"`\n161|}\n162|\n163|// RecordOutcome stores the operation-specific report for one\n164|// idempotency key. Keys carry slashes, so the document name is the\n165|// hex SHA-256 of the key; the key itself is echoed inside for the\n166|// lookup to verify. The install is atomic like Record. A concurrent\n167|// duplicate first-completion may record either report; sequential\n168|// retries are stable, which is the tested property.\n169|func (store *InstanceStates) RecordOutcome(key string, outcome OperationOutcome) error {\n170|\tif store == nil {\n171|\t\treturn errors.New(\"tmux instance state store is nil\")\n172|\t}\n173|\tif key == \"\" {\n174|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance outcome key\"}\n175|\t}\n176|\traw, err := json.Marshal(outcomeDocument{\n177|\t\tSchema:             \"urn:ax:schema:tmux-operation-outcome\",\n178|\t\tSchemaVersion:      \"1.0.0\",\n179|\t\tIdempotencyKey:     key,\n180|\t\tOperation:          outcome.Operation,\n181|\t\tInputClosedAt:      outcome.InputClosedAt,\n182|\t\tBoundaryObservedAt: outcome.BoundaryObservedAt,\n183|\t})\n184|\tif err != nil {\n185|\t\treturn fmt.Errorf(\"encode tmux operation outcome: %w\", err)\n186|\t}\n187|\tsum := sha256.Sum256([]byte(key))\n188|\treturn store.installDocument(filepath.Join(\"tmuxlifecycle\", \"outcomes\"), hex.EncodeToString(sum[:])+\".json\", raw)\n189|}\n190|\n191|// LookupOutcome replays the recorded report for one idempotency key,\n192|// or reports absence when the key never completed an outcome record.\n193|// A read or validation failure is an error, never absence.\n194|func (store *InstanceStates) LookupOutcome(key string) (OperationOutcome, bool, error) {\n195|\tif store == nil {\n196|\t\treturn OperationOutcome{}, false, errors.New(\"tmux instance state store is nil\")\n197|\t}\n198|\tif key == \"\" {\n199|\t\treturn OperationOutcome{}, false, &Error{Code: CodeInvalidArguments, Detail: \"instance outcome key\"}\n200|\t}\n201|\tsum := sha256.Sum256([]byte(key))\n202|\traw, err := os.ReadFile(filepath.Join(store.root, \"tmuxlifecycle\", \"outcomes\", hex.EncodeToString(sum[:])+\".json\"))\n203|\tif err != nil {\n204|\t\tif errors.Is(err, os.ErrNotExist) {\n205|\t\t\treturn OperationOutcome{}, false, nil\n206|\t\t}\n207|\t\treturn OperationOutcome{}, false, fmt.Errorf(\"read tmux operation outcome: %w\", err)\n208|\t}\n209|\tvar document outcomeDocument\n210|\tif err := json.Unmarshal(raw, &document); err != nil {\n211|\t\treturn OperationOutcome{}, false, fmt.Errorf(\"decode tmux operation outcome: %w\", err)\n212|\t}\n213|\tif document.IdempotencyKey != key {\n214|\t\treturn OperationOutcome{}, false, &Error{Code: CodeInvalidArguments, Detail: \"instance outcome key\"}\n215|\t}\n216|\treturn OperationOutcome{\n217|\t\tOperation:          document.Operation,\n218|\t\tInputClosedAt:      document.InputClosedAt,\n219|\t\tBoundaryObservedAt: document.BoundaryObservedAt,\n220|\t}, true, nil\n221|}\n222|\n223|// QuiesceBarrierProven reports whether a completed input-closure\n224|// outcome exists for one instance: a recorded quiesce-input or\n225|// wait-safe-boundary report whose idempotency key names this\n226|// instance. The attach entry consults it when the state memory has\n227|// no record for the instance, recovering the input barrier from the\n228|// authoritative closure proof instead of mistaking a lost state\n229|// write for an open input. A missing outcomes directory reports no\n230|// barrier; any read or decode failure is an error, never absence —\n231|// unknown is not a verdict. A matching report with an empty closure\n232|// time is corrupt (the exact read refuses it the same way) and\n233|// errors instead of proving the barrier.\n234|func (store *InstanceStates) QuiesceBarrierProven(instanceID string) (bool, error) {\n235|\tif store == nil {\n236|\t\treturn false, errors.New(\"tmux instance state store is nil\")\n237|\t}\n238|\tif _, err := scalar.ParseUUIDv7(instanceID); err != nil {\n239|\t\treturn false, &Error{Code: CodeInvalidArguments, Detail: \"instance state identity\"}\n240|\t}\n241|\tdir := filepath.Join(store.root, \"tmuxlifecycle\", \"outcomes\")\n242|\tentries, err := os.ReadDir(dir)\n243|\tif err != nil {\n244|\t\tif errors.Is(err, os.ErrNotExist) {\n245|\t\t\treturn false, nil\n246|\t\t}\n247|\t\treturn false, fmt.Errorf(\"read tmux operation outcomes: %w\", err)\n248|\t}\n249|\tfor _, entry := range entries {\n250|\t\tif entry.IsDir() || filepath.Ext(entry.Name()) != \".json\" {\n251|\t\t\tcontinue\n252|\t\t}\n253|\t\traw, err := os.ReadFile(filepath.Join(dir, entry.Name()))\n254|\t\tif err != nil {\n255|\t\t\treturn false, fmt.Errorf(\"read tmux operation outcome: %w\", err)\n256|\t\t}\n257|\t\tvar document outcomeDocument\n258|\t\tif err := json.Unmarshal(raw, &document); err != nil {\n259|\t\t\treturn false, fmt.Errorf(\"decode tmux barrier outcome: %w\", err)\n260|\t\t}\n261|\t\tif document.IdempotencyKey == \"\" {\n262|\t\t\treturn false, &Error{Code: CodeInvalidArguments, Detail: \"instance outcome key\"}\n263|\t\t}\n264|\t\t// The key is authoritative for the family, exactly as on\n265|\t\t// the exact read (which never consults the echoed\n266|\t\t// operation): a closure key for this instance proves the\n267|\t\t// barrier when its time is present.\n268|\t\tquiesce := strings.HasPrefix(document.IdempotencyKey, instanceID+\"/quiesce/\")\n269|\t\tboundary := !quiesce && strings.HasPrefix(document.IdempotencyKey, instanceID+\"/boundary/\")\n270|\t\tif !quiesce && !boundary {\n271|\t\t\tcontinue\n272|\t\t}\n273|\t\tif quiesce && document.InputClosedAt == \"\" {\n274|\t\t\treturn false, &Error{Code: CodeInvalidArguments, Detail: \"instance outcome key\"}\n275|\t\t}\n276|\t\tif boundary && document.BoundaryObservedAt == \"\" {\n277|\t\t\treturn false, &Error{Code: CodeInvalidArguments, Detail: \"instance outcome key\"}\n278|\t\t}\n279|\t\treturn true, nil\n280|\t}\n281|\treturn false, nil\n282|}\n283|\n284|// RecordBindingDoc stores the create-time Terminal Instance Binding\n285|// document for one (session, bootstrap) pair, so restore can return\n286|// the required binding without minting (the JCS identity rule stays\n287|// termbind-private: this store never computes digests, it only keeps\n288|// the bytes create carried). The document must be a JSON object; its\n289|// binding identity is re-admitted by termbind on the restore read,\n290|// never here.\n291|func (store *InstanceStates) RecordBindingDoc(sessionID, bootstrapID string, doc []byte) error {\n292|\tif store == nil {\n293|\t\treturn errors.New(\"tmux instance state store is nil\")\n294|\t}\n295|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n296|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance binding identity\"}\n297|\t}\n298|\tif _, err := scalar.ParseUUIDv7(bootstrapID); err != nil {\n299|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance binding identity\"}\n300|\t}\n301|\tvar probe map[string]any\n302|\tif err := json.Unmarshal(doc, &probe); err != nil {\n303|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance binding document\"}\n304|\t}\n305|\treturn store.installDocument(filepath.Join(\"tmuxlifecycle\", \"bindings\", sessionID), bootstrapID+\".json\", doc)\n306|}\n307|\n308|// LookupBindingDoc replays the stored binding document for one\n309|// (session, bootstrap) pair, or reports absence when the pair never\n310|// recorded one. A read failure is an error, never absence.\n311|func (store *InstanceStates) LookupBindingDoc(sessionID, bootstrapID string) ([]byte, bool, error) {\n312|\tif store == nil {\n313|\t\treturn nil, false, errors.New(\"tmux instance state store is nil\")\n314|\t}\n315|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n316|\t\treturn nil, false, &Error{Code: CodeInvalidArguments, Detail: \"instance binding identity\"}\n317|\t}\n318|\tif _, err := scalar.ParseUUIDv7(bootstrapID); err != nil {\n319|\t\treturn nil, false, &Error{Code: CodeInvalidArguments, Detail: \"instance binding identity\"}\n320|\t}\n321|\traw, err := os.ReadFile(filepath.Join(store.root, \"tmuxlifecycle\", \"bindings\", sessionID, bootstrapID+\".json\"))\n322|\tif err != nil {\n323|\t\tif errors.Is(err, os.ErrNotExist) {\n324|\t\t\treturn nil, false, nil\n325|\t\t}\n326|\t\treturn nil, false, fmt.Errorf(\"read tmux binding document: %w\", err)\n327|\t}\n328|\treturn raw, true, nil\n329|}\n330|\n331|// install stages the state bytes to a same-directory temporary file,\n332|// fsyncs it, atomically renames it over the instance document (rename\n333|// is the mutable commit: the new state supersedes), removes no prior\n334|// name, and fsyncs the directory. Stale staging files from a\n335|// pre-commit crash are swept before the install.\n336|func (store *InstanceStates) install(instanceID string, raw []byte) error {\n337|\treturn store.installDocument(filepath.Join(\"tmuxlifecycle\", \"instances\"), instanceID+\".json\", raw)\n338|}\n339|\n340|// installDocument stages raw bytes to a same-directory temporary file\n341|// and atomically renames them over the named document under the\n342|// store root, sweeping stale staging files first and fsyncing the\n343|// directory after. Crash hooks fire at the same two boundaries as the\n344|// state install. rel is relative to the store root.\n345|func (store *InstanceStates) installDocument(rel, name string, raw []byte) error {\n346|\tdir := filepath.Join(store.root, rel)\n347|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n348|\t\treturn fmt.Errorf(\"create tmux instance state directory: %w\", err)\n349|\t}\n350|\tsweepStateStaging(dir)\n351|\ttarget := filepath.Join(dir, name)\n352|\tstaged, err := os.CreateTemp(dir, \"state-*.tmp\")\n353|\tif err != nil {\n354|\t\treturn fmt.Errorf(\"stage tmux instance state: %w\", err)\n355|\t}\n356|\tstagedPath := staged.Name()\n357|\tcommitted := false\n358|\tdefer func() {\n359|\t\tif !committed {\n360|\t\t\t_ = os.Remove(stagedPath)\n361|\t\t}\n362|\t}()\n363|\tif err := staged.Chmod(0o600); err != nil {\n364|\t\t_ = staged.Close()\n365|\t\treturn fmt.Errorf(\"protect tmux instance state: %w\", err)\n366|\t}\n367|\tif _, err := staged.Write(raw); err != nil {\n368|\t\t_ = staged.Close()\n369|\t\treturn fmt.Errorf(\"write tmux instance state: %w\", err)\n370|\t}\n371|\tif err := staged.Sync(); err != nil {\n372|\t\t_ = staged.Close()\n373|\t\treturn fmt.Errorf(\"sync tmux instance state: %w\", err)\n374|\t}\n375|\tif err := staged.Close(); err != nil {\n376|\t\treturn fmt.Errorf(\"close tmux instance state: %w\", err)\n377|\t}\n378|\tif store.hooks != nil && store.hooks.AfterStage != nil {\n379|\t\tif err := store.hooks.AfterStage(stagedPath); err != nil {\n380|\t\t\treturn err\n381|\t\t}\n382|\t}\n383|\tif err := os.Rename(stagedPath, target); err != nil {\n384|\t\treturn fmt.Errorf(\"install tmux instance state: %w\", err)\n385|\t}\n386|\tcommitted = true\n387|\tif store.hooks != nil && store.hooks.AfterInstall != nil {\n388|\t\tif err := store.hooks.AfterInstall(target); err != nil {\n389|\t\t\treturn err\n390|\t\t}\n391|\t}\n392|\tif err := syncStateDirectory(dir); err != nil {\n393|\t\treturn err\n394|\t}\n395|\treturn nil\n396|}\n397|\n398|// sweepStateStaging removes stale staging files from pre-commit\n399|// crashes. Only the state-*.tmp pattern is swept; instance documents\n400|// are never touched.\n401|func sweepStateStaging(dir string) {\n402|\tentries, err := os.ReadDir(dir)\n403|\tif err != nil {\n404|\t\treturn\n405|\t}\n406|\tfor _, entry := range entries {\n407|\t\tname := entry.Name()\n408|\t\tif len(name) > 10 && name[:6] == \"state-\" && filepath.Ext(name) == \".tmp\" {\n409|\t\t\t_ = os.Remove(filepath.Join(dir, name))\n410|\t\t}\n411|\t}\n412|}\n413|\n414|// syncStateDirectory fsyncs the directory so the rename commit is\n415|// durable before Record returns.\n416|func syncStateDirectory(path string) error {\n417|\tdir, err := os.Open(path)\n418|\tif err != nil {\n419|\t\treturn err\n420|\t}\n421|\tdefer func() { _ = dir.Close() }()\n422|\treturn dir.Sync()\n423|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
