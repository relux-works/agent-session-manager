{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c8bf","stream":{"kind":"session","id":"01a0c836-a2d8-7092-9401-37d2858a2ec3"},"sequence":698,"recorded_at":1780531400001391,"record_type":"event","durability":"durable","causation_id":"a68a1bdc-1b82-44d2-b715-51014e29fd57","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a68a1bdc-1b82-44d2-b715-51014e29fd57","run_stream":{"kind":"run","id":"a68a1bdc-1b82-44d2-b715-51014e29fd57"},"task_stream":{"kind":"task","id":"01a0c838-30d3-7b41-9b5d-d7f6ff0876ef"},"task_id":"01a0c838-30d3-7b41-9b5d-d7f6ff0876ef","event":{"kind":"output","task_id":"01a0c838-30d3-7b41-9b5d-d7f6ff0876ef","chunk":"Read text file `internal/tmuxserver/wrapper_unix_test.go`.\n(279 line(s) above)\n280|\n281|// --- wrapper decision input ---\n282|\n283|func wBuild() provhost.BuildTuple {\n284|\treturn provhost.BuildTuple{\n285|\t\tProviderID:      \"codex\",\n286|\t\tProviderVersion: \"0.147.0\",\n287|\t\tPlatform:        \"linux\",\n288|\t\tArchitecture:    \"amd64\",\n289|\t}\n290|}\n291|\n292|func wIdentity(t *testing.T) []byte {\n293|\tt.Helper()\n294|\trecord, err := provhost.CreateIdentity(provhost.IdentityParams{\n295|\t\tSessionID:            lxSession,\n296|\t\tProviderID:           \"codex\",\n297|\t\tProviderVersion:      \"0.147.0\",\n298|\t\tProviderVersionRange: \"opaque-range\",\n299|\t\tNativeSessionID:      \"native-session-lx\",\n300|\t\tIdentityKind:         \"session_uuid\",\n301|\t\tLogicalWorkspaceID:   lxHost,\n302|\t\tCreatedByHostID:      lxHost,\n303|\t\tCreatedAt:            lxIssued,\n304|\t})\n305|\tif err != nil {\n306|\t\tt.Fatalf(\"CreateIdentity() error = %v\", err)\n307|\t}\n308|\treturn record\n309|}\n310|\n311|// wDecideInput returns the ModeRestore decision input that launches\n312|// over a local win: every gate passes through its landed owner with\n313|// real documents, and the tests mutate one arm at a time.\n314|func wDecideInput(t *testing.T, attachAdmitted bool) axpane.Input {\n315|\tt.Helper()\n316|\tuniverse := wBuildBackendUniverse(t, attachAdmitted)\n317|\thostBinding := universe.hostBinding()\n318|\tdescriptor, err := axpane.BuildDescriptor(axpane.DescriptorParams{\n319|\t\tBinding: axpane.BindingRef{\n320|\t\t\tBindingDigest:         hostBinding.TerminalBindingID,\n321|\t\t\tBackendID:             hostBinding.BackendID,\n322|\t\t\tImplementationVersion: hostBinding.ImplementationVersion,\n323|\t\t\tProtocolVersion:       hostBinding.ProtocolVersion,\n324|\t\t\tGeneration:            hostBinding.Generation,\n325|\t\t},\n326|\t\tInstanceID:  lxInstance,\n327|\t\tInteractive: true,\n328|\t\tColumns:     80,\n329|\t\tRows:        24,\n330|\t})\n331|\tif err != nil {\n332|\t\tt.Fatalf(\"BuildDescriptor() error = %v\", err)\n333|\t}\n334|\treturn axpane.Input{\n335|\t\tSessionID:               lxSession,\n336|\t\tBootstrapOperationID:    lxBootstrap,\n337|\t\tMode:                    axpane.ModeRestore,\n338|\t\tSessionKnown:            true,\n339|\t\tSessionBound:            false,\n340|\t\tPresented:               fencing.PresentedToken{SessionID: lxSession, Epoch: 7, LeaseID: lxLease},\n341|\t\tBackend:                 universe.facts(t),\n342|\t\tMaterializationRequired: true,\n343|\t\tJournal: matjournal.Journal{\n344|\t\t\tPhase:              matjournal.PhaseCommitted,\n345|\t\t\tMaterializationID:  \"mat-lx-1\",\n346|\t\t\tSourceCheckpointID: \"ckpt-lx-newest\",\n347|\t\t},\n348|\t\tJournalOK:           true,\n349|\t\tHasNewestCheckpoint: true,\n350|\t\tNewestCheckpointID:  \"ckpt-lx-newest\",\n351|\t\tCheckpointRequired:  false,\n352|\t\tProfileRecord:       sessprofile.Record{SessionID: lxSession, RecordID: \"profile-record-lx\", Creation: sessprofile.ProfileStandard},\n353|\t\tProvider:            axpane.ProviderFacts{Build: wBuild(), Identity: wIdentity(t)},\n354|\t\tSmoke:               axpane.SmokeFacts{Required: false},\n355|\t\tRealm:               axpane.Realm{Caller: axpane.CallerForeground, BrokerState: \"broker-running\", ServerGeneration: lxGeneration, Remediation: \"launch the aqua broker\"},\n356|\t\tEntrypoint:          []string{\"ax\", \"pane\", lxSession},\n357|\t\tDescriptor:          descriptor,\n358|\t\tHostBinding:         hostBinding,\n359|\t\tInteractive:         true,\n360|\t\tRemoteInteractive:   true,\n361|\t}\n362|}\n363|\n364|// wRestoreRequest is the backend restore request the resume branches\n365|// execute: the recorded prior under the fixture generation.\n366|func wRestoreRequest(t *testing.T) OpRequest {\n367|\tt.Helper()\n368|\treturn OpRequest{\n369|\t\tOperation: \"restore\", Body: lxRestoreBody(t, lxDigestA, nil),\n370|\t\tSource: \"absent\", Admitted: fullLifecycleAdmitted(),\n371|\t}\n372|}\n373|\n374|const (\n375|\twFreshValidatedAt  = \"2026-09-01T11:59:00.000Z\"\n376|\twLapsedValidatedAt = \"2026-09-01T10:00:00.000Z\"\n377|)\n378|\n379|func wGrant(t *testing.T, validatedAt string) sessrepo.FencingGrant {\n380|\tt.Helper()\n381|\tat, err := time.Parse(time.RFC3339Nano, validatedAt)\n382|\tif err != nil {\n383|\t\tt.Fatal(err)\n384|\t}\n385|\treturn sessrepo.FencingGrant{SessionID: lxSession, RecordID: \"grant-lx-1\", ValidatedAt: at}\n386|}\n387|\n388|func wPolicy() sessrepo.FencingPolicy {\n389|\treturn sessrepo.FencingPolicy{RefreshInterval: time.Hour}\n390|}\n391|\n392|// --- P1-D composition tests ---\n393|\n394|// TestWrapperRestoreLapsedGrantRemoteOffer is the P1-D core: a lapsed\n395|// local grant under a refreshed remote winner offers remote attach\n396|// (or takeover when attach is not capable) without running any\n397|// backend operation. The refresh runs before the decision, so the\n398|// offer path never presents the lapsed grant to backend restore\n399|// authorization — backend authorization stays intact and is never\n400|// consulted here.\n401|func TestWrapperRestoreLapsedGrantRemoteOffer(t *testing.T) {\n402|\tcases := []struct {\n403|\t\tname           string\n404|\t\tattachAdmitted bool\n405|\t\twant           axpane.Action\n406|\t}{\n407|\t\t{\"attach\", true, axpane.ActionAttachRemote},\n408|\t\t{\"takeover\", false, axpane.ActionTakeoverOffer},\n409|\t}\n410|\tfor _, tc := range cases {\n411|\t\tt.Run(tc.name, func(t *testing.T) {\n412|\t\t\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n413|\t\t\tfx.lc.LocalHostID = lxHost\n414|\t\t\trefreshed := false\n415|\t\t\tfx.lc.LeaseRefresh = func(ctx context.Context, session string) (RefreshWinner, error) {\n416|\t\t\t\trefreshed = true\n417|\t\t\t\tif session != lxSession {\n418|\t\t\t\t\tt.Errorf(\"refresh session = %s\", session)\n419|\t\t\t\t}\n420|\t\t\t\treturn RefreshWinner{LeaseID: lxLeaseB, Epoch: 9, HolderHostID: lxRemoteHost}, nil\n421|\t\t\t}\n422|\t\t\toutcome, err := fx.lc.ExecuteWrapperRestore(context.Background(), WrapperRestoreRequest{\n423|\t\t\t\tDecide:   wDecideInput(t, tc.attachAdmitted),\n424|\t\t\t\tGrant:    wGrant(t, wLapsedValidatedAt),\n425|\t\t\t\tHasGrant: true,\n426|\t\t\t\tPolicy:   wPolicy(),\n427|\t\t\t\tRestore:  wRestoreRequest(t),\n428|\t\t\t})\n429|\t\t\tif err != nil {\n430|\t\t\t\tt.Fatal(err)\n431|\t\t\t}\n432|\t\t\tif !refreshed {\n433|\t\t\t\tt.Fatal(\"decision ran without the mesh refresh\")\n434|\t\t\t}\n435|\t\t\tif outcome.Decision.Action != tc.want {\n436|\t\t\t\tt.Fatalf(\"action = %s (%v), want %s\", outcome.Decision.Action, outcome.Decision.Cause, tc.want)\n437|\t\t\t}\n438|\t\t\tif !outcome.RefreshAttempted || !outcome.RefreshSucceeded {\n439|\t\t\t\tt.Fatalf(\"refresh audit = %+v\", outcome)\n440|\t\t\t}\n441|\t\t\tif outcome.WinnerLeaseID != lxLeaseB || outcome.WinnerHostID != lxRemoteHost {\n442|\t\t\t\tt.Fatalf(\"winner = %+v\", outcome)\n443|\t\t\t}\n444|\t\t\tif outcome.Restore != nil {\n445|\t\t\t\tt.Fatalf(\"offer executed backend restore: %+v\", outcome.Restore)\n446|\t\t\t}\n447|\t\t\tif fx.runner.callCount() != 0 {\n448|\t\t\t\tt.Fatalf(\"offer executed %v\", fx.runner.subcommands())\n449|\t\t\t}\n450|\t\t})\n451|\t}\n452|}\n453|\n454|// TestWrapperRestoreLocalWinResumes pins the resume effect: a\n455|// verified local win with valid materialization launches, and the\n456|// launch executes the backend restore exactly once (the wrapper\n457|// recreates; the bindings prove it).\n458|func TestWrapperRestoreLocalWinResumes(t *testing.T) {\n459|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n460|\tfx.lc.LocalHostID = lxHost\n461|\tfx.lc.LeaseRefresh = func(ctx context.Context, session string) (RefreshWinner, error) {\n462|\t\treturn RefreshWinner{LeaseID: lxLease, Epoch: 7, HolderHostID: lxHost}, nil\n463|\t}\n464|\trecordBinding(t, fx, lxDigestA)\n465|\tfx.runner.queue(\"new-session\", \"\", 0)\n466|\toutcome, err := fx.lc.ExecuteWrapperRestore(context.Background(), WrapperRestoreRequest{\n467|\t\tDecide:   wDecideInput(t, true),\n468|\t\tGrant:    wGrant(t, wFreshValidatedAt),\n469|\t\tHasGrant: true,\n470|\t\tPolicy:   wPolicy(),\n471|\t\tRestore:  wRestoreRequest(t),\n472|\t})\n473|\tif err != nil {\n474|\t\tt.Fatal(err)\n475|\t}\n476|\tif outcome.Decision.Action != axpane.ActionLaunch {\n477|\t\tt.Fatalf(\"action = %s (%v), want launch\", outcome.Decision.Action, outcome.Decision.Cause)\n478|\t}\n479|\tif outcome.Restore == nil || outcome.Restore.Binding == nil {\n(more lines below)","final_result":true}}}
