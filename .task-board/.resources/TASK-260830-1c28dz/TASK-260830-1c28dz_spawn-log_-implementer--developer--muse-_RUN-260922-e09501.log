{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d2bb","stream":{"kind":"session","id":"01a0c836-a2d8-7092-9401-37d2858a2ec3"},"sequence":1976,"recorded_at":1780531400003947,"record_type":"event","durability":"durable","causation_id":"a68a1bdc-1b82-44d2-b715-51014e29fd57","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a68a1bdc-1b82-44d2-b715-51014e29fd57","run_stream":{"kind":"run","id":"a68a1bdc-1b82-44d2-b715-51014e29fd57"},"task_stream":{"kind":"task","id":"01a0c843-8db7-7511-b7f0-d56eb7d9b9b2"},"task_id":"01a0c843-8db7-7511-b7f0-d56eb7d9b9b2","event":{"kind":"output","task_id":"01a0c843-8db7-7511-b7f0-d56eb7d9b9b2","chunk":"{\n  \"chunk_id\": \"exec-52-1\",\n  \"command\": \"sed -n 153,185p internal/tmuxserver/lifecycle_rev4_unix_test.go; echo \\\"===state-setup===\\\"; sed -n 1,30p internal/tmuxserver/state_test.go; echo \\\"===divergent-winner-test===\\\"; grep -n \\\"TestWrapperRestoreRefusesDivergentWinner\\\\b\\\" -A 30 internal/tmuxserver/wrapper_unix_test.go | head -n 40\",\n  \"description\": \"Check assertion styles\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"func TestExecuteAttachErrorsOnCorruptBarrierScan(t *testing.T) {\\n\\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\\n\\tdir := filepath.Join(fx.data, \\\"states\\\", \\\"tmuxlifecycle\\\", \\\"outcomes\\\")\\n\\tif err := os.MkdirAll(dir, 0o755); err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tif err := os.WriteFile(filepath.Join(dir, \\\"corrupt-barrier-probe.json\\\"), []byte(\\\"{broken\\\"), 0o600); err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\t// A corrupt barrier report is unknown, never an open input.\\n\\tif _, err := fx.lc.Execute(context.Background(), OpRequest{\\n\\t\\tOperation: \\\"attach\\\", Body: lxAttachBody(t, nil), Source: \\\"parked\\\", Admitted: fullLifecycleAdmitted(),\\n\\t}); err == nil {\\n\\t\\tt.Fatal(\\\"attach admitted under a corrupt barrier scan\\\")\\n\\t} else if !strings.Contains(err.Error(), \\\"decode tmux barrier outcome\\\") {\\n\\t\\tt.Fatalf(\\\"attach error = %v, want the barrier decode failure\\\", err)\\n\\t}\\n\\tif fx.runner.callCount() != 0 {\\n\\t\\tt.Fatalf(\\\"refused attach executed %v\\\", fx.runner.subcommands())\\n\\t}\\n}\\n\\n// Revision-4 clause witnesses: four admitting narrowings the\\n// reviewer planted against the status probes and the argv gate, each\\n// surviving the committed suite twice, plus the spawner-side custody\\n// narrowing that closes the SPW/B39 gap. Each test drives the\\n// production entry and refuses the exact admitted member.\\n\\n// TestExecuteStatusAttachedExitIsUnknown pins that a nonzero\\n// list-sessions exit proves nothing even with plausible stdout:\\n// exit 1 with a well-formed attached-count row is unknown, never a\\n// count.\\nfunc TestExecuteStatusAttachedExitIsUnknown(t *testing.T) {\\n===state-setup===\\npackage tmuxserver\\n\\nimport (\\n\\t\\\"errors\\\"\\n\\t\\\"os\\\"\\n\\t\\\"path/filepath\\\"\\n\\t\\\"testing\\\"\\n\\n\\t\\\"github.com/relux-works/agent-session-manager/internal/terminalbackend\\\"\\n)\\n\\nfunc TestInstanceStatesRoundTrip(t *testing.T) {\\n\\tstore, err := OpenInstanceStates(t.TempDir())\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tfor _, state := range []terminalbackend.InstanceState{\\n\\t\\tterminalbackend.StateAbsent,\\n\\t\\tterminalbackend.StateParked,\\n\\t\\tterminalbackend.StateActive,\\n\\t\\tterminalbackend.StateQuiescing,\\n\\t\\tterminalbackend.StateStopped,\\n\\t\\tterminalbackend.StateStaleFenced,\\n\\t\\tterminalbackend.StateUnavailable,\\n\\t} {\\n\\t\\tif err := store.Record(lxInstance, state); err != nil {\\n\\t\\t\\tt.Fatalf(\\\"Record(%s): %v\\\", state, err)\\n\\t\\t}\\n\\t\\tgot, found, err := store.Lookup(lxInstance)\\n\\t\\tif err != nil || !found {\\n===divergent-winner-test===\\n785:// TestWrapperRestoreRefusesDivergentWinner pins the winner binding:\\n786-// a refreshed winner for lease B at epoch 9 launches the decision,\\n787-// but the backend restore still carries lease A at epoch 7, so the\\n788-// entry refuses before any effect instead of executing under the old\\n789-// authorization. The decision stays launched — the refusal is the\\n790-// join, not the decision — and backend authorization is untouched.\\n791:func TestWrapperRestoreRefusesDivergentWinner(t *testing.T) {\\n792-\\tfx, outcome, err := wDivergentWinner(t,\\n793-\\t\\tRefreshWinner{LeaseID: lxLeaseB, Epoch: 9, HolderHostID: lxHost},\\n794-\\t\\tterminstance.LeaseView{LeaseID: lxLease, Epoch: 7}, lxLease, 7)\\n795-\\tif err == nil {\\n796-\\t\\tt.Fatal(\\\"winner epoch 9 authorized a restore carrying old epoch 7\\\")\\n797-\\t}\\n798-\\trequireLocalCode(t, err, \\\"local_precondition_failed\\\", \\\"wrapper restore winner binding\\\")\\n799-\\tif outcome.Decision.Action != axpane.ActionLaunch {\\n800-\\t\\tt.Fatalf(\\\"action = %s (%v), want the launched decision the binding refuses\\\", outcome.Decision.Action, outcome.Decision.Cause)\\n801-\\t}\\n802-\\tif outcome.Restore != nil {\\n803-\\t\\tt.Fatalf(\\\"divergent restore executed: %+v\\\", outcome.Restore)\\n804-\\t}\\n805-\\tif fx.runner.callCount() != 0 {\\n806-\\t\\tt.Fatalf(\\\"divergent restore executed %v\\\", fx.runner.subcommands())\\n807-\\t}\\n808-}\\n809-\\n810-// TestWrapperRestoreRefusesDivergentWinnerLease isolates the lease\\n811-// arm: the epoch agrees (9) while the lease diverges (A vs B). The\\n812-// backend would authorize the carried (A,9) against the current\\n813-// (A,9) — only the binding refuses.\\n814-func TestWrapperRestoreRefusesDivergentWinnerLease(t *testing.T) {\\n815-\\tfx, outcome, err := wDivergentWinner(t,\\n816-\\t\\tRefreshWinner{LeaseID: lxLeaseB, Epoch: 9, HolderHostID: lxHost},\\n817-\\t\\tterminstance.LeaseView{LeaseID: lxLease, Epoch: 9}, lxLease, 9)\\n818-\\tif err == nil {\\n819-\\t\\tt.Fatal(\\\"winner lease B authorized a restore carrying lease A\\\")\\n820-\\t}\\n821-\\trequireLocalCode(t, err, \\\"local_precondition_failed\\\", \\\"wrapper restore winner binding\\\")\\n\",\n  \"original_output_bytes\": 4354,\n  \"original_output_tokens\": 1089,\n  \"truncated\": false\n}","final_result":true}}}
