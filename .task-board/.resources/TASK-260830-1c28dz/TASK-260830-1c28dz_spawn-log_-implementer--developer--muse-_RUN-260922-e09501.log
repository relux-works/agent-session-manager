{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c729","stream":{"kind":"session","id":"01a0c836-a2d8-7092-9401-37d2858a2ec3"},"sequence":495,"recorded_at":1780531400000985,"record_type":"event","durability":"durable","causation_id":"a68a1bdc-1b82-44d2-b715-51014e29fd57","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a68a1bdc-1b82-44d2-b715-51014e29fd57","run_stream":{"kind":"run","id":"a68a1bdc-1b82-44d2-b715-51014e29fd57"},"task_stream":{"kind":"task","id":"01a0c837-c9b5-71b0-883d-0cd630734d0f"},"task_id":"01a0c837-c9b5-71b0-883d-0cd630734d0f","event":{"kind":"output","task_id":"01a0c837-c9b5-71b0-883d-0cd630734d0f","chunk":"Read text file `internal/tmuxserver/lifecycle.go`.\n(499 line(s) above)\n500|\treturn rendered, nil\n501|}\n502|\n503|// reportBoundaryObservedAt replays the recorded boundary-observed\n504|// time for one boundary key, recording the current time on first\n505|// success, with the same corrupt-read and record-failure discipline\n506|// as the quiesce report: no failed read becomes fresh evidence.\n507|func (lc *Lifecycle) reportBoundaryObservedAt(key string) (string, error) {\n508|\tstored, found, err := lc.States.LookupOutcome(key)\n509|\tif err != nil {\n510|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"boundary outcome image\"}\n511|\t}\n512|\tif found {\n513|\t\tif stored.BoundaryObservedAt == \"\" {\n514|\t\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"boundary outcome image\"}\n515|\t\t}\n516|\t\treturn stored.BoundaryObservedAt, nil\n517|\t}\n518|\trendered := formatTimestamp(lc.Now())\n519|\tif err := lc.States.RecordOutcome(key, OperationOutcome{Operation: string(terminalbackend.OperationWaitSafeBoundary), BoundaryObservedAt: rendered}); err != nil {\n520|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"boundary outcome image\"}\n521|\t}\n522|\treturn rendered, nil\n523|}\n524|\n525|// boundWait bounds the safe-boundary wait by the lesser of the request\n526|// deadline and the timeout: the wait context carries the minimum, and\n527|// an already-invalid deadline falls back to the timeout alone (the\n528|// engine refuses the malformed deadline before any effect runs, so the\n529|// fallback never binds). The caller cancels the context.\n530|func (lc *Lifecycle) boundWait(ctx context.Context, mctx terminstance.MutationContext, timeoutMs uint64) (context.Context, context.CancelFunc) {\n531|\tbound := lc.Now().Add(time.Duration(timeoutMs) * time.Millisecond)\n532|\tif deadline, err := mctx.Deadline.Time(); err == nil && deadline.Before(bound) {\n533|\t\tbound = deadline\n534|\t}\n535|\treturn context.WithDeadline(ctx, bound)\n536|}\n537|\n538|// lesserDeadline computes the lesser of the request deadline and the\n539|// graceful timeout for the stop close-confirm poll. An invalid\n540|// deadline falls back the same way as the boundary wait.\n541|func (lc *Lifecycle) lesserDeadline(mctx terminstance.MutationContext, timeoutMs uint64) time.Time {\n542|\tbound := lc.Now().Add(time.Duration(timeoutMs) * time.Millisecond)\n543|\tif deadline, err := mctx.Deadline.Time(); err == nil && deadline.Before(bound) {\n544|\t\treturn deadline\n545|\t}\n546|\treturn bound\n547|}","final_result":true}}}
