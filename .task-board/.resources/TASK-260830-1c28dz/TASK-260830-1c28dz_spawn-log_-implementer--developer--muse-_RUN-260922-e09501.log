cand = load('/tmp/1c28dz/evidence-rev5/verdicts-base.jsonl'), load('/tmp/1c28dz/evidence-rev5/verdicts-candidate.jsonl')\\nprint(f'base tests: {len(base)}; candidate tests: {len(cand)}')\\nmoved = [(k, base[k], cand[k]) for k in base if k in cand and base[k] != cand[k]]\\nprint(f'MOVED verdicts: {len(moved)}')\\nfor k, b, c in moved[:20]: print(' ', k, b, '->', c)\\nprint(f'BASE-ONLY: {len(set(base) - set(cand))}')\\nrest = sorted(set(cand) - set(base))\\nprint(f'CAND-ONLY: {len(rest)}')\\nprint(Counter(p for p, t in rest))\\nfails = [k for k in cand if cand[k] == 'fail']\\nprint(f'candidate FAILs: {len(fails)}')\\nEOF\\ncat $E/closure-diff.txt | head -n 8; grep -E \\\"MOVED|BASE-ONLY|CAND-ONLY|FAIL\\\" $E/verdicts-diff.txt\",\n  \"description\": \"Generate diff summaries\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"base keys: 193; candidate keys: 200\\nMOVED: 0\\nBASE-ONLY: []\\nCAND-ONLY: 7\\n  ('tmuxserver', 'CheckSocketLength', 'long') -> ('error', 'tmux server refused: tmux_socket_path_too_long at socket path length', '')\\n  ('tmuxserver', 'CheckSocketLength', 'short') -> ('ok', '', 'nil-error')\\n  ('tmuxserver', 'ClassifyStatus', 'absent') -> ('ok', '', 'absent/false/false/false')\\n  ('tmuxserver', 'ClassifyStatus', 'live-tri') -> ('ok', '', 'active/true/false/true')\\nMOVED verdicts: 0\\nBASE-ONLY: 0\\nCAND-ONLY: 498\\ncandidate FAILs: 0\\n\",\n  \"original_output_bytes\": 520,\n  \"original_output_tokens\": 130,\n  \"truncated\": false\n}","final_result":true}}}
