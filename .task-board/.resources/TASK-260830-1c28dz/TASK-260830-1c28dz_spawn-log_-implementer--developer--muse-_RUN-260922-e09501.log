{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cec1","stream":{"kind":"session","id":"01a0c836-a2d8-7092-9401-37d2858a2ec3"},"sequence":1467,"recorded_at":1780531400002929,"record_type":"event","durability":"durable","causation_id":"a68a1bdc-1b82-44d2-b715-51014e29fd57","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a68a1bdc-1b82-44d2-b715-51014e29fd57","run_stream":{"kind":"run","id":"a68a1bdc-1b82-44d2-b715-51014e29fd57"},"task_stream":{"kind":"task","id":"01a0c83f-e8aa-70b2-8a14-cfe335641d77"},"task_id":"01a0c83f-e8aa-70b2-8a14-cfe335641d77","event":{"kind":"output","task_id":"01a0c83f-e8aa-70b2-8a14-cfe335641d77","chunk":"edited\nchanged lines: lines 302-320\n--- original\n+++ updated\n@@\n-// QuiesceBarrierProven reports whether a completed input-closure\n-// outcome exists for one instance: a recorded quiesce-input or\n-// wait-safe-boundary report whose idempotency key names this\n-// instance. The attach entry consults it when the state memory has\n-// no record for the instance, recovering the input barrier from the\n-// authoritative closure proof instead of mistaking a lost state\n-// write for an open input. A missing outcomes directory reports no\n-// barrier; any read or decode failure is an error, never absence —\n-// unknown is not a verdict. A matching report with an empty closure\n-// time is corrupt (the exact read refuses it the same way) and\n-// errors instead of proving the barrier.\n-func (store *InstanceStates) QuiesceBarrierProven(instanceID string) (bool, error) {\n-\tif store == nil {\n-\t\treturn false, errors.New(\"tmux instance state store is nil\")\n-\t}\n-\tif _, err := scalar.ParseUUIDv7(instanceID); err != nil {\n-\t\treturn false, &Error{Code: CodeInvalidArguments, Detail: \"instance state identity\"}\n-\t}\n-\tdir := filepath.Join(store.root, \"tmuxlifecycle\", \"outcomes\")\n+// QuiesceBarrierProven reports whether a completed input-closure\n+// outcome exists for one instance in its current incarnation: a\n+// recorded quiesce-input or wait-safe-boundary report whose\n+// idempotency key names this instance and whose incarnation equals\n+// the current one. The attach entry consults it as the sole\n+// admission verdict: advisory memory, caller-carried source state,\n+// and failure reporting are never consulted, so none of them can\n+// reopen a closed barrier. A report from a superseded incarnation\n+// is skipped, never an error: the rotation that superseded it is\n+// itself the authoritative reopen proof. A missing outcomes\n+// directory reports no barrier; any read or decode failure is an\n+// error, never absence — unknown is not a verdict. A matching\n+// current-incarnation report with an empty closure time is corrupt\n+// (the exact read refuses it the same way) and errors instead of\n+// proving the barrier.\n+func (store *InstanceStates) QuiesceBarrierProven(instanceID string) (bool, error) {\n+\tif store == nil {\n+\t\treturn false, errors.New(\"tmux instance state store is nil\")\n+\t}\n+\tif _, err := scalar.ParseUUIDv7(instanceID); err != nil {\n+\t\treturn false, &Error{Code: CodeInvalidArguments, Detail: \"instance state identity\"}\n+\t}\n+\tcurrent, _, err := store.LookupIncarnation(instanceID)\n+\tif err != nil {\n+\t\treturn false, err\n+\t}\n+\tdir := filepath.Join(store.root, \"tmuxlifecycle\", \"outcomes\")\n","final_result":true}}}
