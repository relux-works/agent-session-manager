ded; false\\ninternal/axpane/decide.go-204-\\t// refuses invalid_arguments.\\ninternal/axpane/decide.go-205-\\tSessionKnown bool\\ninternal/axpane/decide.go-206-\\ninternal/axpane/decide.go-207-\\t// ExistingBinding is the proven bootstrap receipt for THIS\\ninternal/axpane/decide.go-208-\\t// (session_id, bootstrap_operation_id) pair, or nil when the\\ninternal/axpane/decide.go-209-\\t// pair is unrecorded. A recorded pair reattaches; an\\ninternal/axpane/decide.go-210-\\t// unrecorded pair on a bound session inside the bootstrap\\ninternal/axpane/decide.go-211-\\t// window refuses idempotency_mismatch; an unrecorded pair\\ninternal/axpane/decide.go-212-\\t// after the window closed installs a new receipt and\\ninternal/axpane/decide.go-213-\\t// launches. Superseded pairs keep their receipts, so an\\ninternal/axpane/decide.go-214-\\t// identical retry of any recorded pair replays its own\\ninternal/axpane/decide.go-215-\\t// receipt even after later pairs superseded it.\\ninternal/axpane/decide.go-216-\\tExistingBinding *Binding\\ninternal/axpane/decide.go-217-\\t// SessionBound reports that the session has any recorded\\ninternal/axpane/decide.go-218-\\t// binding (the first-binding anchor or any pair receipt).\\ninternal/axpane/decide.go-219-\\t// Together with the window predicate it drives the\\ninternal/axpane/decide.go-220-\\t// changed-operation arm: an unrecorded pair on a bound\\ninternal/axpane/decide.go-221-\\t// session inside the window refuses idempotency_mismatch,\\ninternal/axpane/decide.go-222-\\t// while an unbound session binds fresh.\\ninternal/axpane/decide.go-223-\\tSessionBound bool\\ninternal/axpane/decide.go-224-\\t// HasNewestCheckpoint and NewestCheckpointID carry the\\ninternal/axpane/decide.go-225-\\t// landed chain fold's newest checkpoint (sessstate.Reduce\\ninternal/axpane/decide.go-226-\\t// over the authoritative chain: Projection.HasCheckpoint\\ninternal/axpane/decide.go-227-\\t// and Newest.ID from checkpoint.created, checkpointed\\ninternal/axpane/decide.go-228-\\t// session.stopped, and session.resumed). This is the\\ninternal/axpane/decide.go-229-\\t// authoritative \\\"newest checkpoint\\\" (§5.7\\ninternal/axpane/decide.go-230-\\t// newest_checkpoint_id, §14.4): the window predicate,\\ninternal/axpane/decide.go-231-\\t// checkpoint admission, and journal source binding all read\\ninternal/axpane/decide.go-232-\\t// this fact — never the lease record's own checkpoint,\\ninternal/axpane/decide.go-233-\\t// which is null for every epoch-1 owner. Run loads it\\ninternal/axpane/decide.go-234-\\t// through the fold adapter; I/O-free callers supply it by\\ninternal/axpane/decide.go-235-\\t// hand. A successor lease's Checkpoint is the handoff base\\ninternal/axpane/decide.go-236-\\t// at takeover time and never moves, so it is never\\ninternal/axpane/decide.go-237-\\t// compared against this fact: the fold is the sole newest\\ninternal/axpane/decide.go-238-\\t// authority, and the only implication the winner's\\ninternal/axpane/decide.go-239-\\t// checkpoint carries — a checkpoint-carrying winner means\\ninternal/axpane/decide.go-240-\\t// the chain published a newest — is asserted once, directly\\ninternal/axpane/decide.go-241-\\t// after the fencing arm.\\ninternal/axpane/decide.go-242-\\tHasNewestCheckpoint bool\\ninternal/axpane/decide.go-243-\\tNewestCheckpointID  string\\ninternal/axpane/decide.go-244-\\ninternal/axpane/decide.go-245-\\t// Presented is the local fencing token; Observation is the\\ninternal/axpane/decide.go-246-\\t// verified lease view, built by fencing.Observe.\\ninternal/axpane/decide.go-247-\\tPresented   fencing.PresentedToken\\ninternal/axpane/decide.go-248-\\tObservation fencing.Observation\\ninternal/axpane/decide.go-249-\\ninternal/axpane/decide.go-250-\\t// Backend carries the §4.B identity documents.\\ninternal/axpane/decide.go-251-\\tBackend BackendFacts\\ninternal/axpane/decide.go-252-\\n===DECISION===\\ninternal/axpane/decide.go:323:type Decision struct {\\ninternal/axpane/decide.go-324-\\t// Action is the outcome.\\ninternal/axpane/decide.go-325-\\tAction Action\\ninternal/axpane/decide.go-326-\\t// ParkReason and WinningLeaseID carry the session.parked\\ninternal/axpane/decide.go-327-\\t// vocabulary when Action is parked. The lease ID is empty when\\ninternal/axpane/decide.go-328-\\t// no winner is established.\\ninternal/axpane/decide.go-329-\\tParkReason     fencing.ParkReason\\ninternal/axpane/decide.go-330-\\tWinningLeaseID string\\ninternal/axpane/decide.go-331-\\t// Class is the Section 15 refusal code when Action is refused.\\ninternal/axpane/decide.go-332-\\tClass string\\ninternal/axpane/decide.go-333-\\t// Detail is the static refusal or park detail. It carries\\ninternal/axpane/decide.go-334-\\t// member names and the landed cause, never credentials,\\ninternal/axpane/decide.go-335-\\t// generations, or native references.\\ninternal/axpane/decide.go-336-\\tDetail string\\ninternal/axpane/decide.go-337-\\t// Cause is the underlying landed error.\\ninternal/axpane/decide.go-338-\\tCause error\\ninternal/axpane/decide.go-339-\\t// Token is the sealed fencing token the passed gate minted,\\ninternal/axpane/decide.go-340-\\t// set on launch and reattach only. The provider receives it\\ninternal/axpane/decide.go-341-\\t// separately from the descriptor (§7.A).\\ninternal/axpane/decide.go-342-\\tToken fencing.LeaseToken\\ninternal/axpane/decide.go-343-\\t// HasToken reports that Token is minted. The zero token never\\ninternal/axpane/decide.go-344-\\t// authorizes: decisions without a passed gate carry none.\\ninternal/axpane/decide.go-345-\\tHasToken bool\\ninternal/axpane/decide.go-346-\\t// Profile is the effective persisted pair the launch carries.\\ninternal/axpane/decide.go-347-\\tProfile sessprofile.Pair\\ninternal/axpane/decide.go-348-\\t// Mapping is the resolved provider adapter flag (empty for\\ninternal/axpane/decide.go-349-\\t// standard).\\ninternal/axpane/decide.go-350-\\tMapping string\\ninternal/axpane/decide.go-351-\\t// Admitted is the reconciled backend capability set.\\ninternal/axpane/decide.go-352-\\tAdmitted terminalbackend.Admitted\\ninternal/axpane/decide.go-353-\\t// Descriptor is the admitted §7.A provider descriptor, set on\\n===wDecideInput===\\ninternal/tmuxserver/wrapper_unix_test.go:314:func wDecideInput(t *testing.T, attachAdmitted bool) axpane.Input {\\n\",\n  \"original_output_bytes\": 6838,\n  \"original_output_tokens\": 1710,\n  \"truncated\": false\n}","final_result":true}}}
