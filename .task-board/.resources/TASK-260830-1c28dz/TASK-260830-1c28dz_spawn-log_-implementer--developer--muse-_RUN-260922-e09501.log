mba = next(i for i, l in enumerate(matrix) if l.startswith('## Bounds (mirrored'))\\nmbb = next(i for i, l in enumerate(matrix) if l == '## Mutant battery')\\ntbody = [l for l in trace[bstart:bend]]\\nwhile tbody and tbody[-1] == '': tbody.pop()\\nmbody = matrix[mba+1:mbb]\\nwhile mbody and mbody[0] == '': mbody.pop(0)\\nwhile mbody and mbody[-1] == '': mbody.pop()\\nprint('bounds identical:', tbody == mbody)\\nEOF\\ncat $E/mirror-check.log; cp /tmp/1c28dz/TASK-260830-1c28dz_conformance-matrix-rev5.md $E/conformance-matrix-rev5.md; cp /tmp/1c28dz/TASK-260830-1c28dz_results-rev5.md $E/results-rev5.md; cd /tmp/1c28dz && find evidence-rev5 -type f | sort | xargs sha256sum > evidence-rev5/SHA256SUMS && tar -czf TASK-260830-1c28dz_rework-evidence-rev5.tar.gz evidence-rev5 && ls -lh TASK-260830-1c28dz_rework-evidence-rev5.tar.gz\",\n  \"description\": \"Mirror check and build tarball\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"ac mismatches: 0\\ncensus identical: True\\nbounds identical: True\\n-rw-r--r--@ 1 iv  wheel   3.1M Sep 22 13:19 TASK-260830-1c28dz_rework-evidence-rev5.tar.gz\\n\",\n  \"original_output_bytes\": 154,\n  \"original_output_tokens\": 39,\n  \"truncated\": false\n}","final_result":true}}}
