{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d411","stream":{"kind":"session","id":"01a0c836-a2d8-7092-9401-37d2858a2ec3"},"sequence":2147,"recorded_at":1780531400004289,"record_type":"event","durability":"durable","causation_id":"a68a1bdc-1b82-44d2-b715-51014e29fd57","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a68a1bdc-1b82-44d2-b715-51014e29fd57","run_stream":{"kind":"run","id":"a68a1bdc-1b82-44d2-b715-51014e29fd57"},"task_stream":{"kind":"task","id":"01a0c844-e232-73b1-bd03-f4423ae9d528"},"task_id":"01a0c844-e232-73b1-bd03-f4423ae9d528","event":{"kind":"output","task_id":"01a0c844-e232-73b1-bd03-f4423ae9d528","chunk":"{\n  \"chunk_id\": \"exec-55-1\",\n  \"command\": \"grep -n \\\"bootstrap binding\\\" internal/tmuxserver/*.go internal/axpane/*.go | grep -v test | head; echo ===; grep -n \\\"func (store \\\\*Store) Bind\\\" -A 50 internal/axpane/binding.go | head -n 70\",\n  \"description\": \"Find bootstrap binding mismatch source\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"internal/tmuxserver/backend.go:124:// persistBinding records the bootstrap binding for the create/restore\\ninternal/tmuxserver/lifecycle.go:42:\\t// Bindings is the durable bootstrap binding store.\\ninternal/tmuxserver/ops.go:514:// bootstrap binding for the (session, bootstrap) pair must exist and\\ninternal/tmuxserver/status.go:101:// statusRecordedBinding reads the session's recorded bootstrap binding\\ninternal/tmuxserver/wrapper.go:184:// versions and the bootstrap binding the restore carries).\\ninternal/tmuxserver/wrapper.go:194:\\t\\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \\\"wrapper restore bootstrap binding\\\"}\\ninternal/axpane/binding.go:66:// Store is the durable bootstrap binding store rooted at one data\\ninternal/axpane/binding.go:158:\\t\\t\\treturn empty, false, &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \\\"bootstrap binding\\\"}\\ninternal/axpane/binding.go:186:\\t\\treturn empty, false, errors.New(\\\"bootstrap binding vanished after install\\\")\\ninternal/axpane/binding.go:207:\\t\\treturn empty, false, fmt.Errorf(\\\"read bootstrap binding: %w\\\", err)\\n===\\n131:func (store *Store) Bind(sessionID, operationID string, candidate Binding) (Binding, bool, error) {\\n132-\\tempty := Binding{}\\n133-\\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\\n134-\\t\\treturn empty, false, fmt.Errorf(\\\"bind session %q is not a UUIDv7: %w\\\", sessionID, err)\\n135-\\t}\\n136-\\tif _, err := scalar.ParseUUIDv7(operationID); err != nil {\\n137-\\t\\treturn empty, false, fmt.Errorf(\\\"bind operation %q is not a UUIDv7: %w\\\", operationID, err)\\n138-\\t}\\n139-\\tif candidate.SessionID != sessionID || candidate.OperationID != operationID {\\n140-\\t\\treturn empty, false, fmt.Errorf(\\\"bind candidate names another bootstrap pair\\\")\\n141-\\t}\\n142-\\tif err := checkBindingCandidate(candidate); err != nil {\\n143-\\t\\treturn empty, false, err\\n144-\\t}\\n145-\\tpair, pairFound, err := store.Lookup(sessionID, operationID)\\n146-\\tif err != nil {\\n147-\\t\\treturn empty, false, err\\n148-\\t}\\n149-\\tif pairFound {\\n150-\\t\\treturn pair, true, nil\\n151-\\t}\\n152-\\texisting, found, err := store.Status(sessionID)\\n153-\\tif err != nil {\\n154-\\t\\treturn empty, false, err\\n155-\\t}\\n156-\\tif found {\\n157-\\t\\tif existing.OperationID != operationID {\\n158-\\t\\t\\treturn empty, false, &terminalbackend.Error{Code: terminalbackend.CodeIdempotencyMismatch, Detail: \\\"bootstrap binding\\\"}\\n159-\\t\\t}\\n160-\\t\\t// The anchor names this operation but the pair\\n161-\\t\\t// receipt is absent: a crash landed between the two\\n162-\\t\\t// installs. Converge the pair receipt from the\\n163-\\t\\t// anchor bytes and reattach to the one child.\\n164-\\t\\tconverged, err := store.convergePairFromFirst(sessionID, operationID)\\n165-\\t\\tif err != nil {\\n166-\\t\\t\\treturn empty, false, err\\n167-\\t\\t}\\n168-\\t\\treturn converged, true, nil\\n169-\\t}\\n170-\\treceipt, err := encodeBinding(candidate, store.timestamp())\\n171-\\tif err != nil {\\n172-\\t\\treturn empty, false, err\\n173-\\t}\\n174-\\tif err := store.install(sessionID, operationID, receipt); err != nil {\\n175-\\t\\tvar concurrent errConcurrentWinner\\n176-\\t\\tif errors.As(err, &concurrent) {\\n177-\\t\\t\\treturn concurrent.bound, true, nil\\n178-\\t\\t}\\n179-\\t\\treturn empty, false, err\\n180-\\t}\\n181-\\tstored, found, err := store.Lookup(sessionID, operationID)\\n\",\n  \"original_output_bytes\": 3158,\n  \"original_output_tokens\": 790,\n  \"truncated\": false\n}","final_result":true}}}
