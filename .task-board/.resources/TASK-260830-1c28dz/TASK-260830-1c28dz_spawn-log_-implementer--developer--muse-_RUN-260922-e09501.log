ion: \"attach\", Body: lxAttachBody(t, func(o map[string]any) { o[\"client_id\"] = lxClientB }), Source: \"parked\", Admitted: fullLifecycleAdmitted()})\n30|\tif err == nil {\n31|\t\tt.Fatalf(\"writable attach admitted after durable closure with stale active memory: %+v argv=%v\", out.Attach, out.Argv)\n32|\t}\n33|}\n34|\n35|func TestReviewWrapperBootstrapMustBindExecutedRestore(t *testing.T) {\n36|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n37|\tfx.lc.LocalHostID = lxHost\n38|\tfx.lc.LeaseRefresh = func(context.Context, string) (RefreshWinner, error) {\n39|\t\treturn RefreshWinner{LeaseID: lxLease, Epoch: 7, HolderHostID: lxHost}, nil\n40|\t}\n41|\trecordBinding(t, fx, lxDigestA)\n42|\tfx.runner.queue(\"new-session\", \"\", 0)\n43|\tinput := wDecideInput(t, true)\n44|\tinput.BootstrapOperationID = lxOperation\n45|\tout, err := fx.lc.ExecuteWrapperRestore(context.Background(), WrapperRestoreRequest{Decide: input, Grant: wGrant(t, wFreshValidatedAt), HasGrant: true, Policy: wPolicy(), Restore: wRestoreRequest(t)})\n46|\tif err == nil && out.Decision.Action == axpane.ActionLaunch && fx.runner.callCount() > 0 {\n47|\t\tt.Fatalf(\"launch decision for bootstrap %s executed restore for different bootstrap %s: commands=%v\", input.BootstrapOperationID, lxBootstrap, fx.runner.subcommands())\n48|\t}\n49|}\n50|\n51|func TestReviewWrapperInstanceMustBindExecutedRestore(t *testing.T) {\n52|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n53|\tfx.lc.LocalHostID = lxHost\n54|\tfx.lc.LeaseRefresh = func(context.Context, string) (RefreshWinner, error) {\n55|\t\treturn RefreshWinner{LeaseID: lxLease, Epoch: 7, HolderHostID: lxHost}, nil\n56|\t}\n57|\trecordBinding(t, fx, lxDigestA)\n58|\tfx.runner.queue(\"new-session\", \"\", 0)\n59|\tinput := wDecideInput(t, true)\n60|\tdescriptor, err := axpane.BuildDescriptor(axpane.DescriptorParams{Binding: axpane.BindingRef{BindingDigest: input.HostBinding.TerminalBindingID, BackendID: input.HostBinding.BackendID, ImplementationVersion: input.HostBinding.ImplementationVersion, ProtocolVersion: input.HostBinding.ProtocolVersion, Generation: input.HostBinding.Generation}, InstanceID: lxClientB, Interactive: true, Columns: 80, Rows: 24})\n61|\tif err != nil {\n62|\t\tt.Fatal(err)\n63|\t}\n64|\tinput.Descriptor = descriptor\n65|\tout, err := fx.lc.ExecuteWrapperRestore(context.Background(), WrapperRestoreRequest{Decide: input, Grant: wGrant(t, wFreshValidatedAt), HasGrant: true, Policy: wPolicy(), Restore: wRestoreRequest(t)})\n66|\tif err == nil && out.Decision.Action == axpane.ActionLaunch && fx.runner.callCount() > 0 {\n67|\t\tt.Fatalf(\"launch decision for instance %s executed restore for different instance %s: commands=%v\", lxClientB, lxInstance, fx.runner.subcommands())\n68|\t}\n69|}\n70|\n71|func TestReviewFailedStopCannotEraseQuiescence(t *testing.T) {\n72|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n73|\tfx.runner.queue(\"lock-session\", \"\", 0).queue(\"detach-client\", \"\", 0)\n74|\tif _, err := fx.lc.Execute(context.Background(), OpRequest{Operation: \"quiesce-input\", Body: lxQuiesceBody(t, nil), Source: \"active\", Admitted: fullLifecycleAdmitted()}); err != nil {\n75|\t\tt.Fatal(err)\n76|\t}\n77|\tbody := lxStopBody(t, 60000, func(o map[string]any) {\n78|\t\to[\"context\"].(map[string]any)[\"authorization\"].(map[string]any)[\"expires_at\"] = \"2026-09-01T01:00:00.000Z\"\n79|\t})\n80|\tif _, err := fx.lc.Execute(context.Background(), OpRequest{Operation: \"request-stop\", Body: body, Source: \"active\", Admitted: fullLifecycleAdmitted()}); err == nil {\n81|\t\tt.Fatal(\"expired stop admitted\")\n82|\t}\n83|\tout, err := fx.lc.Execute(context.Background(), OpRequest{Operation: \"attach\", Body: lxAttachBody(t, nil), Source: \"parked\", Admitted: fullLifecycleAdmitted()})\n84|\tif err == nil {\n85|\t\tt.Fatalf(\"failed stop erased successful quiescence: attach=%+v\", out.Attach)\n86|\t}\n87|}","final_result":true}}}
