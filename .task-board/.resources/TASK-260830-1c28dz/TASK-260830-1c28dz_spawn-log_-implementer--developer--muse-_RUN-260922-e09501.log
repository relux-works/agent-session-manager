{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6ed","stream":{"kind":"session","id":"01a0c836-a2d8-7092-9401-37d2858a2ec3"},"sequence":465,"recorded_at":1780531400000925,"record_type":"event","durability":"durable","causation_id":"a68a1bdc-1b82-44d2-b715-51014e29fd57","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a68a1bdc-1b82-44d2-b715-51014e29fd57","run_stream":{"kind":"run","id":"a68a1bdc-1b82-44d2-b715-51014e29fd57"},"task_stream":{"kind":"task","id":"01a0c837-bfce-7471-bad3-e500f408dd73"},"task_id":"01a0c837-bfce-7471-bad3-e500f408dd73","event":{"kind":"output","task_id":"01a0c837-bfce-7471-bad3-e500f408dd73","chunk":"Read text file `internal/tmuxserver/ops.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"sort\"\n8|\t\"strconv\"\n9|\t\"time\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n17|)\n18|\n19|// This file executes the three lifecycle operations the landed engine\n20|// scope refuses — attach, terminate-stale, and restore — over the same\n21|// landed gates the engine uses (transition matrix, idempotency shapes,\n22|// authorization, capability conferral, receipt and binding stores)\n23|// plus the tmux backend. The recheck loop, receipt discipline, and\n24|// error-to-observation mapping mirror the engine's second side of each\n25|// rule; the census symmetry lines name both sides.\n26|\n27|// sortedEffects copies effects into bytewise order for the wire.\n28|func sortedEffects(effects []terminalbackend.SideEffect) []terminalbackend.SideEffect {\n29|\tordered := append([]terminalbackend.SideEffect(nil), effects...)\n30|\tsort.Slice(ordered, func(i, j int) bool { return ordered[i] < ordered[j] })\n31|\treturn ordered\n32|}\n33|\n34|// sortedEvidence copies evidence IDs into bytewise order for the wire.\n35|func sortedEvidence(evidence []string) []string {\n36|\tordered := append([]string(nil), evidence...)\n37|\tsort.Strings(ordered)\n38|\treturn ordered\n39|}\n40|\n41|// attachDescriptor derives the bound attach descriptor: socket,\n42|// instance, and client joined by newlines. It is host-local (the\n43|// socket path is usable only on the responding host), deterministic,\n44|// and never persisted: the attach handler returns it without writing\n45|// it anywhere, and a dedicated test scans the stores for its bytes.\n46|// Length is bounded by construction — sun_path socket plus two UUIDs\n47|// stay two orders of magnitude below the 4096 cap — so no length arm\n48|// exists to measure; a test pins the maximum instead.\n49|func attachDescriptor(socket, instance, client string) string {\n50|\treturn socket + \"\\n\" + instance + \"\\n\" + client\n51|}\n52|\n53|// createDescriptor derives the unbound create-interactive descriptor:\n54|// socket and instance only, because create carries no client. Same\n55|// non-persistence and length properties as the bound shape.\n56|func createDescriptor(socket, instance string) string {\n57|\treturn socket + \"\\n\" + instance\n58|}\n59|\n60|// executeAttach runs one attach: closed-shape admission, deadline,\n61|// transition, landed attach authorization, capability conferral plus\n62|// the matching-transport arm, live server attestation (the P3-A\n63|// wiring: a fresh decoy admission refuses), the durable client\n64|// receipt, and the caller-executed attach vector with its descriptor.\n65|// The entry returns the vector; it never execs an interactive attach.\n66|func (lc *Lifecycle) executeAttach(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n67|\tempty := OpOutcome{Operation: terminalbackend.OperationAttach}\n68|\tbody, err := parseAttachBody(req.Body)\n69|\tif err != nil {\n70|\t\treturn empty, err\n71|\t}\n72|\tif err := checkLifecycleBackend(body.TerminalBackendID); err != nil {\n73|\t\treturn empty, err\n74|\t}\n75|\tdeadline, err := body.Deadline.Time()\n76|\tif err != nil {\n77|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body deadline\"}\n78|\t}\n79|\tif !lc.Now().Before(deadline) {\n80|\t\treturn empty, &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n81|\t}\n82|\tif _, _, err := terminalbackend.CheckTransition(string(terminalbackend.OperationAttach), req.Source, false); err != nil {\n83|\t\treturn empty, err\n84|\t}\n85|\tif err := terminalbackend.CheckAttachRequest(body.Authorization, body.Transport, body.InputAuthorized, lc.Now()); err != nil {\n86|\t\treturn empty, err\n87|\t}\n88|\tif err := terminalbackend.CheckOperation(string(terminalbackend.OperationAttach), req.Admitted); err != nil {\n89|\t\treturn empty, err\n90|\t}\n91|\tif err := checkAttachTransportCapability(body.Transport, req.Admitted); err != nil {\n92|\t\treturn empty, err\n93|\t}\n94|\tif err := lc.checkAttachQuiesced(body.TerminalInstanceID, body.InputAuthorized); err != nil {\n95|\t\treturn empty, err\n96|\t}\n97|\tif lc.ServerAdmission == nil {\n98|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle dependencies\"}\n99|\t}\n100|\tadmission, err := lc.ServerAdmission()\n101|\tif err != nil {\n102|\t\treturn empty, rowError(terminalbackend.OperationAttach, err)\n103|\t}\n104|\tif err := CheckServerAttested(admission, body.BackendGeneration); err != nil {\n105|\t\treturn empty, &Error{Code: terminalbackend.CodeUnauthorized, Detail: \"attach server attestation\"}\n106|\t}\n107|\treqBackend := lc.requestBackend(req, socket, body.SessionID, body.TerminalInstanceID)\n108|\treqBackend.operation = terminalbackend.OperationAttach\n109|\treqBackend.clientID = body.ClientID\n110|\treqBackend.transport = body.Transport\n111|\treqBackend.input = body.InputAuthorized\n112|\treqBackend.authRaw = body.AuthRaw\n113|\tevidenceID, err := reqBackend.PerformEffect(ctx, terminalbackend.EffectAttachClientCreated)\n114|\tif err != nil {\n115|\t\treturn empty, rowError(terminalbackend.OperationAttach, err)\n116|\t}\n117|\targv, err := BuildCommand(DirectiveAttachSession, CommandArgs{\n118|\t\tRuntimeDir:     lc.RuntimeDir,\n119|\t\tSocket:         socket,\n120|\t\tInstanceID:     body.TerminalInstanceID,\n121|\t\tAttachInput:    body.InputAuthorized,\n122|\t\tHasAttachInput: true,\n123|\t})\n124|\tif err != nil {\n125|\t\treturn empty, err\n126|\t}\n127|\tif err := terminalbackend.CheckAttachResult(body.InputAuthorized, body.InputAuthorized, body.Authorization); err != nil {\n128|\t\treturn empty, err\n129|\t}\n130|\t// Only an input-authorized attach adopts the active state: a\n131|\t// read-only attach is observation, and recording active for it\n132|\t// would reopen quiesced input (the quiesce barrier reads this\n133|\t// same memory, so observation must leave it untouched).\n134|\tif body.InputAuthorized {\n135|\t\t_ = lc.recordAfter(body.TerminalInstanceID, terminalbackend.StateActive)\n136|\t}\n137|\treturn OpOutcome{\n138|\t\tOperation: terminalbackend.OperationAttach,\n139|\t\tAttach: &AttachOutcome{\n140|\t\t\tClientMirrorID:  body.ClientID,\n141|\t\t\tDescriptor:      attachDescriptor(socket, body.TerminalInstanceID, body.ClientID),\n142|\t\t\tInputAuthorized: body.InputAuthorized,\n143|\t\t\tEvidenceIDs:     []string{evidenceID},\n144|\t\t},\n145|\t\tArgv: argv,\n146|\t}, nil\n147|}\n148|\n149|// checkAttachQuiesced enforces the quiesce input barrier at the\n150|// attach entry: tmux offers no session freeze (a locked session does\n151|// not lock subsequently attaching clients), so once the AX-side\n152|// memory records quiescing, new input-authorized attaches refuse the\n153|// failed local precondition. Read-only attaches stay admitted:\n154|// quiesce stops input while retaining observation. A memory read\n155|// failure is an error, never admission: unknown is not a verdict.\n156|// When the memory holds no record at all, the barrier recovers from\n157|// the completed closure outcomes instead: a recorded quiesce-input\n158|// or wait-safe-boundary report for this instance proves the input\n159|// closed, so a lost barrier write refuses exactly like the memory\n160|// would — absence of memory is not proof of an open input.\n161|func (lc *Lifecycle) checkAttachQuiesced(instanceID string, inputAuthorized bool) error {\n162|\tif !inputAuthorized {\n163|\t\treturn nil\n164|\t}\n165|\tmemory, found, err := lc.States.Lookup(instanceID)\n166|\tif err != nil {\n167|\t\treturn err\n168|\t}\n169|\tif found {\n170|\t\tif memory == terminalbackend.StateQuiescing {\n171|\t\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"attach quiesced input\"}\n172|\t\t}\n173|\t\treturn nil\n174|\t}\n175|\tproven, err := lc.States.QuiesceBarrierProven(instanceID)\n176|\tif err != nil {\n177|\t\treturn err\n178|\t}\n179|\tif proven {\n180|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"attach quiesced input\"}\n181|\t}\n182|\treturn nil\n183|}\n184|\n185|// checkAttachTransportCapability enforces the matching-transport arm:\n186|// local presentation needs local_attach, mesh presentation needs\n187|// remote_attach. The relay member never reaches here — the landed\n188|// attach authorization refuses it first — so no third arm exists.\n189|func checkAttachTransportCapability(transport string, admitted terminalbackend.Admitted) error {\n190|\tswitch transport {\n191|\tcase string(terminalbackend.TransportLocalOnly):\n192|\t\tif !admitted.Has(\"local_attach\") {\n193|\t\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n194|\t\t}\n195|\tcase string(terminalbackend.TransportTrustedPrivateMesh):\n196|\t\tif !admitted.Has(\"remote_attach\") {\n197|\t\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n198|\t\t}\n199|\tdefault:\n200|\t\treturn &Error{Code: terminalbackend.CodeProtocolError, Detail: \"presentation transport vocabulary\"}\n201|\t}\n202|\treturn nil\n203|}\n204|\n205|// executeTerminate runs one terminate-stale: closed-shape admission,\n206|// idempotency material, capability conferral plus the dual conditional,\n207|// transition, force_stale authorization, generation recheck, landed\n208|// fencing authorization, deadline, receipt discipline with\n209|// status-reconciled resume, and the kill plus close-confirm effects.\n210|func (lc *Lifecycle) executeTerminate(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n211|\tempty := OpOutcome{Operation: terminalbackend.OperationTerminateStale}\n212|\tbody, err := parseTerminateBody(req.Body)\n213|\tif err != nil {\n214|\t\treturn empty, err\n215|\t}\n216|\toperation := terminalbackend.OperationTerminateStale\n217|\tmctx := body.Context\n218|\tsource := terminalbackend.InstanceState(req.Source)\n219|\tif err := checkLifecycleBackend(mctx.TerminalBackendID); err != nil {\n220|\t\treturn empty, err\n221|\t}\n222|\tderived, err := terminalbackend.IdempotencyKey(string(operation), mctx.TerminalInstanceID, \"terminate\", body.StaleLeaseID, strconv.FormatUint(body.StaleEpoch, 10))\n223|\tif err != nil {\n224|\t\treturn empty, err\n225|\t}\n226|\tif mctx.IdempotencyKey != derived {\n227|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"idempotency key material\"}\n228|\t}\n229|\tif err := terminalbackend.CheckOperation(string(operation), req.Admitted); err != nil {\n230|\t\tfailure := rowError(operation, err)\n231|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n232|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n233|\t}\n234|\tif err := checkTerminateCapability(req.Admitted); err != nil {\n235|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n236|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n237|\t}\n238|\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), false)\n239|\tif err != nil {\n240|\t\tfailure := rowError(operation, err)\n241|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n242|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n243|\t}\n244|\tif err := terminstance.CheckAuthorization(mctx.Authorization, terminstance.AuthorizationForceStale, lc.CurrentLease(), lc.Now()); err != nil {\n245|\t\tfailure := rowError(operation, err)\n246|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n247|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n248|\t}\n249|\tif lc.CurrentGeneration() != mctx.BackendGeneration {\n250|\t\tfailure := &Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation stale\"}\n251|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n252|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n253|\t}\n254|\tif err := mapFencingError(fencing.AuthorizeTerminateStale(req.Presented, req.Winner, req.HasWinner, req.ForceRecovery, req.DiagnosticsPreserved)); err != nil {\n255|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n256|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n257|\t}\n258|\tif err := checkTerminateTarget(mctx, body, req.Presented); err != nil {\n259|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n260|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n261|\t}\n262|\tif err := checkTerminateWinner(mctx, req.Winner, lc.CurrentLease()); err != nil {\n263|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n264|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n265|\t}\n266|\tdeadline, err := mctx.Deadline.Time()\n267|\tif err != nil {\n268|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"mutation context deadline\"}\n269|\t}\n270|\tif !lc.Now().Before(deadline) {\n271|\t\tfailure := &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n272|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionReplaySame)\n273|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n274|\t}\n275|\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n276|\treqBackend.operation = operation\n277|\treqBackend.deadline = deadline\n278|\treturn lc.executeWithReceipt(ctx, req, socket, operation, mctx, source, target, effects, deadline, terminstance.AuthorizationForceStale, reqBackend, func(result terminstance.Result) OpOutcome {\n279|\t\treturn OpOutcome{Operation: operation, Mutation: &result, TargetClosed: true}\n280|\t})\n281|}\n282|\n283|// checkTerminateCapability enforces the dual conditional: stale\n284|// termination needs stale_process_termination AND\n285|// provider_process_observation. Each arm refuses alone.\n286|func checkTerminateCapability(admitted terminalbackend.Admitted) error {\n287|\tif !admitted.Has(\"stale_process_termination\") {\n288|\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n289|\t}\n290|\tif !admitted.Has(\"provider_process_observation\") {\n291|\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n292|\t}\n293|\treturn nil\n294|}\n295|\n296|// mapFencingError maps the landed terminate-stale authorization onto\n297|// the row's allowed set: malformed fencing material is the protocol\n298|// error, every other fencing refusal — no winner, no force, no\n299|// diagnostics, target mismatch, live owner — is the failed local\n300|// precondition. lease_conflict maps to the precondition too: the row\n301|// has no lease_conflict member, and a target fenced by another\n302|// session's winner fails the fenced-target precondition.\n303|func mapFencingError(err error) error {\n304|\tif err == nil {\n305|\t\treturn nil\n306|\t}\n307|\tif errors.Is(err, fencing.ErrInvalidArguments) {\n308|\t\treturn &Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminate fencing material\"}\n309|\t}\n310|\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate fencing authorization\"}\n311|}\n312|\n313|// checkTerminateTarget binds the presented fencing token to the\n314|// request: session, stale lease, and stale epoch must all agree with\n315|// the context and body. Any disagreement refuses the failed local\n316|// precondition: the retry would authorize a different target than the\n317|// key names.\n318|func checkTerminateTarget(mctx terminstance.MutationContext, body TerminateBody, presented fencing.PresentedToken) error {\n319|\tif presented.SessionID != mctx.SessionID ||\n320|\t\tpresented.LeaseID != body.StaleLeaseID ||\n321|\t\tpresented.Epoch != body.StaleEpoch {\n322|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate target binding\"}\n323|\t}\n324|\treturn nil\n325|}\n326|\n327|// checkTerminateWinner binds the caller-observed winner to the\n328|// re-read current lease: the fencing authorization decides over the\n329|// caller's winner, and only a winner that still wins authorizes. A\n330|// rotated or misobserved winner refuses the failed local\n331|// precondition; the caller re-observes and retries. Absence of a\n332|// winner never reaches here — the fencing gate refuses it first.\n333|func checkTerminateWinner(mctx terminstance.MutationContext, winner sessrepo.LeaseSummary, lease terminstance.LeaseView) error {\n334|\tif winner.SessionID != mctx.SessionID ||\n335|\t\twinner.LeaseID != lease.LeaseID ||\n336|\t\twinner.Epoch != lease.Epoch {\n337|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate winner binding\"}\n338|\t}\n339|\treturn nil\n340|}\n341|\n342|// executeRestore runs one restore: closed-shape admission, idempotency\n343|// material, capability conferral plus the reboot conditional,\n344|// transition, restore authorization, generation recheck, prior-binding\n345|// mismatch, deadline, receipt discipline with status-reconciled\n346|// resume, the persist plus wrapper-restored effects, and the required\n347|// result binding. The wire result is always parked. The backend\n348|// launches no provider: the wrapper owns launch gating through the\n349|// after-restore composition (ExecuteWrapperRestore), and this entry\n350|// only recreates the wrapper process.\n351|//\n352|// The result binding is the create-time document kept alongside the\n353|// bootstrap receipt, re-admitted by termbind on the read — within one\n354|// generation — or its minted successor across a reboot: the termbind\n355|// owner succeeds the prior (the JCS identity rule stays\n356|// termbind-private) and the successor persists under the same pair\n357|// key. The prior-binding mismatch arm proves the carried prior equals\n358|// the recorded digest; the document read proves a valid binding for\n359|// this session, instance, and backend.\n360|func (lc *Lifecycle) executeRestore(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n361|\tempty := OpOutcome{Operation: terminalbackend.OperationRestore}\n362|\tbody, err := parseRestoreBody(req.Body)\n363|\tif err != nil {\n364|\t\treturn empty, err\n365|\t}\n366|\toperation := terminalbackend.OperationRestore\n367|\tmctx := body.Context\n368|\tsource := terminalbackend.InstanceState(req.Source)\n369|\tif err := checkLifecycleBackend(mctx.TerminalBackendID); err != nil {\n370|\t\treturn empty, err\n371|\t}\n372|\tderived, err := terminalbackend.IdempotencyKey(string(operation), mctx.SessionID, body.BootstrapOperationID)\n373|\tif err != nil {\n374|\t\treturn empty, err\n375|\t}\n376|\tif mctx.IdempotencyKey != derived {\n377|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"idempotency key material\"}\n378|\t}\n379|\tif err := terminalbackend.CheckOperation(string(operation), req.Admitted); err != nil {\n380|\t\tfailure := rowError(operation, err)\n381|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n382|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n383|\t}\n384|\tif !req.Admitted.Has(\"reboot_restoration\") {\n385|\t\tfailure := &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n386|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n387|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n388|\t}\n389|\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), false)\n390|\tif err != nil {\n391|\t\tfailure := rowError(operation, err)\n392|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n393|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n394|\t}\n395|\tif err := terminstance.CheckAuthorization(mctx.Authorization, terminstance.AuthorizationRestore, lc.CurrentLease(), lc.Now()); err != nil {\n396|\t\tfailure := rowError(operation, err)\n397|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n398|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n399|\t}\n400|\tif lc.CurrentGeneration() != mctx.BackendGeneration {\n401|\t\tfailure := &Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation stale\"}\n402|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n403|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n404|\t}\n405|\tif err := lc.checkPriorBinding(body); err != nil {\n406|\t\tvar local *Error\n407|\t\tif errors.As(err, &local) && local.Code == terminalbackend.CodeRestoreMismatch {\n408|\t\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n409|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n410|\t\t}\n411|\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n412|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n413|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n414|\t}\n415|\tdeadline, err := mctx.Deadline.Time()\n416|\tif err != nil {\n417|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"mutation context deadline\"}\n418|\t}\n419|\tif !lc.Now().Before(deadline) {\n420|\t\tfailure := &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n421|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionReplaySame)\n422|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n423|\t}\n424|\t// The prior binding validates before the receipt binds and the\n425|\t// wrapper recreates: a missing, corrupt, or disagreeing prior\n426|\t// refuses here, never after the irreversible effects.\n427|\tif _, err := lc.readRestorePrior(mctx, body); err != nil {\n428|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n429|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n430|\t}\n431|\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n432|\treqBackend.operation = operation\n433|\treqBackend.bootstrapID = body.BootstrapOperationID\n434|\t// The persist effect replays the recorded pair receipt (verified\n435|\t// by the mismatch arm above); the candidate carries the matched\n436|\t// prior digest so the store admits its shape on the replay path.\n437|\treqBackend.bindingID = body.PriorBindingID\n438|\toutcome, err := lc.executeWithReceipt(ctx, req, socket, operation, mctx, source, target, effects, deadline, terminstance.AuthorizationRestore, reqBackend, func(result terminstance.Result) OpOutcome {\n439|\t\treturn OpOutcome{Operation: operation, Mutation: &result, PriorBindingID: body.PriorBindingID, RestoredParked: true}\n440|\t})\n441|\tif err != nil {\n442|\t\treturn outcome, err\n443|\t}\n444|\tbinding, err := lc.restoreBinding(mctx, body)\n445|\tif err != nil {\n446|\t\treturn outcome, err\n447|\t}\n448|\toutcome.Binding = binding\n449|\treturn outcome, nil\n450|}\n451|\n452|// readRestorePrior reads the create-time binding document kept under\n453|// the (session, bootstrap) pair, re-admitted by the termbind owner,\n454|// and proves it names this restore's session, instance, and backend.\n455|// Generation is not compared here: after a reboot the restore carries\n456|// the new server generation while the prior still names the old one,\n457|// and succession (not agreement) resolves that drift. A missing\n458|// document is the backend store failure — the receipt proved the\n459|// prior, but the payload is gone, so the required result cannot be\n460|// built. A document that fails termbind admission, or that names\n461|// another session, instance, or backend than the mutation context, is\n462|// the integrity failure: the store disagrees with the receipt it\n463|// stands beside.\n464|func (lc *Lifecycle) readRestorePrior(mctx terminstance.MutationContext, body RestoreBody) (termbind.Binding, error) {\n465|\tempty := termbind.Binding{}\n466|\tdoc, found, err := lc.States.LookupBindingDoc(mctx.SessionID, body.BootstrapOperationID)\n467|\tif err != nil {\n468|\t\treturn empty, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n469|\t}\n470|\tif !found {\n471|\t\treturn empty, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n472|\t}\n473|\tbinding, err := termbind.ParseTerminalBinding(doc)\n474|\tif err != nil {\n475|\t\treturn empty, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n476|\t}\n477|\tif binding.SessionID != mctx.SessionID ||\n478|\t\tbinding.TerminalInstanceID != mctx.TerminalInstanceID ||\n479|\t\tbinding.TerminalBackendID != mctx.TerminalBackendID {\n480|\t\treturn empty, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n481|\t}\n482|\treturn binding, nil\n483|}\n484|\n485|// restoreBinding builds the required restore result binding after the\n486|// effects commit. Within one generation the prior is the result: the\n487|// re-admitted create-time document the pre-effects validation already\n488|// proved. Across a reboot the mutation context carries the new server\n489|// generation, and the result is the minted successor: the termbind\n490|// owner succeeds the prior (new generation, supersedes link, fresh\n491|// identity), the successor persists under the same pair key, and the\n492|// same successor returns. The mint is deterministic, so a retry after\n493|// a crash between the effects and the persist converges on the\n494|// identical document instead of forking, and a retry after the\n495|// persist replays the stored successor without minting again.\n496|func (lc *Lifecycle) restoreBinding(mctx terminstance.MutationContext, body RestoreBody) (*termbind.Binding, error) {\n497|\tprior, err := lc.readRestorePrior(mctx, body)\n498|\tif err != nil {\n499|\t\treturn nil, err\n500|\t}\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6ef","stream":{"kind":"session","id":"01a0c836-a2d8-7092-9401-37d2858a2ec3"},"sequence":466,"recorded_at":1780531400000927,"record_type":"event","durability":"durable","causation_id":"a68a1bdc-1b82-44d2-b715-51014e29fd57","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a68a1bdc-1b82-44d2-b715-51014e29fd57","run_stream":{"kind":"run","id":"a68a1bdc-1b82-44d2-b715-51014e29fd57"},"task_stream":{"kind":"task","id":"01a0c837-bfce-7471-bad3-e500f408dd73"},"task_id":"01a0c837-bfce-7471-bad3-e500f408dd73","event":{"kind":"completed","task_id":"01a0c837-bfce-7471-bad3-e500f408dd73"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6f1","stream":{"kind":"session","id":"01a0c836-a2d8-7092-9401-37d2858a2ec3"},"sequence":467,"recorded_at":1780531400000929,"record_type":"event","durability":"durable","causation_id":"a68a1bdc-1b82-44d2-b715-51014e29fd57","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a68a1bdc-1b82-44d2-b715-51014e29fd57","run_stream":{"kind":"run","id":"a68a1bdc-1b82-44d2-b715-51014e29fd57"},"call_id":"call_01a0c837bc9a76489c177076a8893305","text":"Read text file `internal/tmuxserver/ops.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"sort\"\n8|\t\"strconv\"\n9|\t\"time\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n17|)\n18|\n19|// This file executes the three lifecycle operations the landed engine\n20|// scope refuses — attach, terminate-stale, and restore — over the same\n21|// landed gates the engine uses (transition matrix, idempotency shapes,\n22|// authorization, capability conferral, receipt and binding stores)\n23|// plus the tmux backend. The recheck loop, receipt discipline, and\n24|// error-to-observation mapping mirror the engine's second side of each\n25|// rule; the census symmetry lines name both sides.\n26|\n27|// sortedEffects copies effects into bytewise order for the wire.\n28|func sortedEffects(effects []terminalbackend.SideEffect) []terminalbackend.SideEffect {\n29|\tordered := append([]terminalbackend.SideEffect(nil), effects...)\n30|\tsort.Slice(ordered, func(i, j int) bool { return ordered[i] < ordered[j] })\n31|\treturn ordered\n32|}\n33|\n34|// sortedEvidence copies evidence IDs into bytewise order for the wire.\n35|func sortedEvidence(evidence []string) []string {\n36|\tordered := append([]string(nil), evidence...)\n37|\tsort.Strings(ordered)\n38|\treturn ordered\n39|}\n40|\n41|// attachDescriptor derives the bound attach descriptor: socket,\n42|// instance, and client joined by newlines. It is host-local (the\n43|// socket path is usable only on the responding host), deterministic,\n44|// and never persisted: the attach handler returns it without writing\n45|// it anywhere, and a dedicated test scans the stores for its bytes.\n46|// Length is bounded by construction — sun_path socket plus two UUIDs\n47|// stay two orders of magnitude below the 4096 cap — so no length arm\n48|// exists to measure; a test pins the maximum instead.\n49|func attachDescriptor(socket, instance, client string) string {\n50|\treturn socket + \"\\n\" + instance + \"\\n\" + client\n51|}\n52|\n53|// createDescriptor derives the unbound create-interactive descriptor:\n54|// socket and instance only, because create carries no client. Same\n55|// non-persistence and length properties as the bound shape.\n56|func createDescriptor(socket, instance string) string {\n57|\treturn socket + \"\\n\" + instance\n58|}\n59|\n60|// executeAttach runs one attach: closed-shape admission, deadline,\n61|// transition, landed attach authorization, capability conferral plus\n62|// the matching-transport arm, live server attestation (the P3-A\n63|// wiring: a fresh decoy admission refuses), the durable client\n64|// receipt, and the caller-executed attach vector with its descriptor.\n65|// The entry returns the vector; it never execs an interactive attach.\n66|func (lc *Lifecycle) executeAttach(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n67|\tempty := OpOutcome{Operation: terminalbackend.OperationAttach}\n68|\tbody, err := parseAttachBody(req.Body)\n69|\tif err != nil {\n70|\t\treturn empty, err\n71|\t}\n72|\tif err := checkLifecycleBackend(body.TerminalBackendID); err != nil {\n73|\t\treturn empty, err\n74|\t}\n75|\tdeadline, err := body.Deadline.Time()\n76|\tif err != nil {\n77|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body deadline\"}\n78|\t}\n79|\tif !lc.Now().Before(deadline) {\n80|\t\treturn empty, &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n81|\t}\n82|\tif _, _, err := terminalbackend.CheckTransition(string(terminalbackend.OperationAttach), req.Source, false); err != nil {\n83|\t\treturn empty, err\n84|\t}\n85|\tif err := terminalbackend.CheckAttachRequest(body.Authorization, body.Transport, body.InputAuthorized, lc.Now()); err != nil {\n86|\t\treturn empty, err\n87|\t}\n88|\tif err := terminalbackend.CheckOperation(string(terminalbackend.OperationAttach), req.Admitted); err != nil {\n89|\t\treturn empty, err\n90|\t}\n91|\tif err := checkAttachTransportCapability(body.Transport, req.Admitted); err != nil {\n92|\t\treturn empty, err\n93|\t}\n94|\tif err := lc.checkAttachQuiesced(body.TerminalInstanceID, body.InputAuthorized); err != nil {\n95|\t\treturn empty, err\n96|\t}\n97|\tif lc.ServerAdmission == nil {\n98|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle dependencies\"}\n99|\t}\n100|\tadmission, err := lc.ServerAdmission()\n101|\tif err != nil {\n102|\t\treturn empty, rowError(terminalbackend.OperationAttach, err)\n103|\t}\n104|\tif err := CheckServerAttested(admission, body.BackendGeneration); err != nil {\n105|\t\treturn empty, &Error{Code: terminalbackend.CodeUnauthorized, Detail: \"attach server attestation\"}\n106|\t}\n107|\treqBackend := lc.requestBackend(req, socket, body.SessionID, body.TerminalInstanceID)\n108|\treqBackend.operation = terminalbackend.OperationAttach\n109|\treqBackend.clientID = body.ClientID\n110|\treqBackend.transport = body.Transport\n111|\treqBackend.input = body.InputAuthorized\n112|\treqBackend.authRaw = body.AuthRaw\n113|\tevidenceID, err := reqBackend.PerformEffect(ctx, terminalbackend.EffectAttachClientCreated)\n114|\tif err != nil {\n115|\t\treturn empty, rowError(terminalbackend.OperationAttach, err)\n116|\t}\n117|\targv, err := BuildCommand(DirectiveAttachSession, CommandArgs{\n118|\t\tRuntimeDir:     lc.RuntimeDir,\n119|\t\tSocket:         socket,\n120|\t\tInstanceID:     body.TerminalInstanceID,\n121|\t\tAttachInput:    body.InputAuthorized,\n122|\t\tHasAttachInput: true,\n123|\t})\n124|\tif err != nil {\n125|\t\treturn empty, err\n126|\t}\n127|\tif err := terminalbackend.CheckAttachResult(body.InputAuthorized, body.InputAuthorized, body.Authorization); err != nil {\n128|\t\treturn empty, err\n129|\t}\n130|\t// Only an input-authorized attach adopts the active state: a\n131|\t// read-only attach is observation, and recording active for it\n132|\t// would reopen quiesced input (the quiesce barrier reads this\n133|\t// same memory, so observation must leave it untouched).\n134|\tif body.InputAuthorized {\n135|\t\t_ = lc.recordAfter(body.TerminalInstanceID, terminalbackend.StateActive)\n136|\t}\n137|\treturn OpOutcome{\n138|\t\tOperation: terminalbackend.OperationAttach,\n139|\t\tAttach: &AttachOutcome{\n140|\t\t\tClientMirrorID:  body.ClientID,\n141|\t\t\tDescriptor:      attachDescriptor(socket, body.TerminalInstanceID, body.ClientID),\n142|\t\t\tInputAuthorized: body.InputAuthorized,\n143|\t\t\tEvidenceIDs:     []string{evidenceID},\n144|\t\t},\n145|\t\tArgv: argv,\n146|\t}, nil\n147|}\n148|\n149|// checkAttachQuiesced enforces the quiesce input barrier at the\n150|// attach entry: tmux offers no session freeze (a locked session does\n151|// not lock subsequently attaching clients), so once the AX-side\n152|// memory records quiescing, new input-authorized attaches refuse the\n153|// failed local precondition. Read-only attaches stay admitted:\n154|// quiesce stops input while retaining observation. A memory read\n155|// failure is an error, never admission: unknown is not a verdict.\n156|// When the memory holds no record at all, the barrier recovers from\n157|// the completed closure outcomes instead: a recorded quiesce-input\n158|// or wait-safe-boundary report for this instance proves the input\n159|// closed, so a lost barrier write refuses exactly like the memory\n160|// would — absence of memory is not proof of an open input.\n161|func (lc *Lifecycle) checkAttachQuiesced(instanceID string, inputAuthorized bool) error {\n162|\tif !inputAuthorized {\n163|\t\treturn nil\n164|\t}\n165|\tmemory, found, err := lc.States.Lookup(instanceID)\n166|\tif err != nil {\n167|\t\treturn err\n168|\t}\n169|\tif found {\n170|\t\tif memory == terminalbackend.StateQuiescing {\n171|\t\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"attach quiesced input\"}\n172|\t\t}\n173|\t\treturn nil\n174|\t}\n175|\tproven, err := lc.States.QuiesceBarrierProven(instanceID)\n176|\tif err != nil {\n177|\t\treturn err\n178|\t}\n179|\tif proven {\n180|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"attach quiesced input\"}\n181|\t}\n182|\treturn nil\n183|}\n184|\n185|// checkAttachTransportCapability enforces the matching-transport arm:\n186|// local presentation needs local_attach, mesh presentation needs\n187|// remote_attach. The relay member never reaches here — the landed\n188|// attach authorization refuses it first — so no third arm exists.\n189|func checkAttachTransportCapability(transport string, admitted terminalbackend.Admitted) error {\n190|\tswitch transport {\n191|\tcase string(terminalbackend.TransportLocalOnly):\n192|\t\tif !admitted.Has(\"local_attach\") {\n193|\t\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n194|\t\t}\n195|\tcase string(terminalbackend.TransportTrustedPrivateMesh):\n196|\t\tif !admitted.Has(\"remote_attach\") {\n197|\t\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n198|\t\t}\n199|\tdefault:\n200|\t\treturn &Error{Code: terminalbackend.CodeProtocolError, Detail: \"presentation transport vocabulary\"}\n201|\t}\n202|\treturn nil\n203|}\n204|\n205|// executeTerminate runs one terminate-stale: closed-shape admission,\n206|// idempotency material, capability conferral plus the dual conditional,\n207|// transition, force_stale authorization, generation recheck, landed\n208|// fencing authorization, deadline, receipt discipline with\n209|// status-reconciled resume, and the kill plus close-confirm effects.\n210|func (lc *Lifecycle) executeTerminate(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n211|\tempty := OpOutcome{Operation: terminalbackend.OperationTerminateStale}\n212|\tbody, err := parseTerminateBody(req.Body)\n213|\tif err != nil {\n214|\t\treturn empty, err\n215|\t}\n216|\toperation := terminalbackend.OperationTerminateStale\n217|\tmctx := body.Context\n218|\tsource := terminalbackend.InstanceState(req.Source)\n219|\tif err := checkLifecycleBackend(mctx.TerminalBackendID); err != nil {\n220|\t\treturn empty, err\n221|\t}\n222|\tderived, err := terminalbackend.IdempotencyKey(string(operation), mctx.TerminalInstanceID, \"terminate\", body.StaleLeaseID, strconv.FormatUint(body.StaleEpoch, 10))\n223|\tif err != nil {\n224|\t\treturn empty, err\n225|\t}\n226|\tif mctx.IdempotencyKey != derived {\n227|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"idempotency key material\"}\n228|\t}\n229|\tif err := terminalbackend.CheckOperation(string(operation), req.Admitted); err != nil {\n230|\t\tfailure := rowError(operation, err)\n231|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n232|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n233|\t}\n234|\tif err := checkTerminateCapability(req.Admitted); err != nil {\n235|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n236|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n237|\t}\n238|\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), false)\n239|\tif err != nil {\n240|\t\tfailure := rowError(operation, err)\n241|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n242|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n243|\t}\n244|\tif err := terminstance.CheckAuthorization(mctx.Authorization, terminstance.AuthorizationForceStale, lc.CurrentLease(), lc.Now()); err != nil {\n245|\t\tfailure := rowError(operation, err)\n246|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n247|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n248|\t}\n249|\tif lc.CurrentGeneration() != mctx.BackendGeneration {\n250|\t\tfailure := &Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation stale\"}\n251|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n252|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n253|\t}\n254|\tif err := mapFencingError(fencing.AuthorizeTerminateStale(req.Presented, req.Winner, req.HasWinner, req.ForceRecovery, req.DiagnosticsPreserved)); err != nil {\n255|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n256|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n257|\t}\n258|\tif err := checkTerminateTarget(mctx, body, req.Presented); err != nil {\n259|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n260|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n261|\t}\n262|\tif err := checkTerminateWinner(mctx, req.Winner, lc.CurrentLease()); err != nil {\n263|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n264|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n265|\t}\n266|\tdeadline, err := mctx.Deadline.Time()\n267|\tif err != nil {\n268|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"mutation context deadline\"}\n269|\t}\n270|\tif !lc.Now().Before(deadline) {\n271|\t\tfailure := &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n272|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionReplaySame)\n273|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n274|\t}\n275|\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n276|\treqBackend.operation = operation\n277|\treqBackend.deadline = deadline\n278|\treturn lc.executeWithReceipt(ctx, req, socket, operation, mctx, source, target, effects, deadline, terminstance.AuthorizationForceStale, reqBackend, func(result terminstance.Result) OpOutcome {\n279|\t\treturn OpOutcome{Operation: operation, Mutation: &result, TargetClosed: true}\n280|\t})\n281|}\n282|\n283|// checkTerminateCapability enforces the dual conditional: stale\n284|// termination needs stale_process_termination AND\n285|// provider_process_observation. Each arm refuses alone.\n286|func checkTerminateCapability(admitted terminalbackend.Admitted) error {\n287|\tif !admitted.Has(\"stale_process_termination\") {\n288|\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n289|\t}\n290|\tif !admitted.Has(\"provider_process_observation\") {\n291|\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n292|\t}\n293|\treturn nil\n294|}\n295|\n296|// mapFencingError maps the landed terminate-stale authorization onto\n297|// the row's allowed set: malformed fencing material is the protocol\n298|// error, every other fencing refusal — no winner, no force, no\n299|// diagnostics, target mismatch, live owner — is the failed local\n300|// precondition. lease_conflict maps to the precondition too: the row\n301|// has no lease_conflict member, and a target fenced by another\n302|// session's winner fails the fenced-target precondition.\n303|func mapFencingError(err error) error {\n304|\tif err == nil {\n305|\t\treturn nil\n306|\t}\n307|\tif errors.Is(err, fencing.ErrInvalidArguments) {\n308|\t\treturn &Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminate fencing material\"}\n309|\t}\n310|\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate fencing authorization\"}\n311|}\n312|\n313|// checkTerminateTarget binds the presented fencing token to the\n314|// request: session, stale lease, and stale epoch must all agree with\n315|// the context and body. Any disagreement refuses the failed local\n316|// precondition: the retry would authorize a different target than the\n317|// key names.\n318|func checkTerminateTarget(mctx terminstance.MutationContext, body TerminateBody, presented fencing.PresentedToken) error {\n319|\tif presented.SessionID != mctx.SessionID ||\n320|\t\tpresented.LeaseID != body.StaleLeaseID ||\n321|\t\tpresented.Epoch != body.StaleEpoch {\n322|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate target binding\"}\n323|\t}\n324|\treturn nil\n325|}\n326|\n327|// checkTerminateWinner binds the caller-observed winner to the\n328|// re-read current lease: the fencing authorization decides over the\n329|// caller's winner, and only a winner that still wins authorizes. A\n330|// rotated or misobserved winner refuses the failed local\n331|// precondition; the caller re-observes and retries. Absence of a\n332|// winner never reaches here — the fencing gate refuses it first.\n333|func checkTerminateWinner(mctx terminstance.MutationContext, winner sessrepo.LeaseSummary, lease terminstance.LeaseView) error {\n334|\tif winner.SessionID != mctx.SessionID ||\n335|\t\twinner.LeaseID != lease.LeaseID ||\n336|\t\twinner.Epoch != lease.Epoch {\n337|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate winner binding\"}\n338|\t}\n339|\treturn nil\n340|}\n341|\n342|// executeRestore runs one restore: closed-shape admission, idempotency\n343|// material, capability conferral plus the reboot conditional,\n344|// transition, restore authorization, generation recheck, prior-binding\n345|// mismatch, deadline, receipt discipline with status-reconciled\n346|// resume, the persist plus wrapper-restored effects, and the required\n347|// result binding. The wire result is always parked. The backend\n348|// launches no provider: the wrapper owns launch gating through the\n349|// after-restore composition (ExecuteWrapperRestore), and this entry\n350|// only recreates the wrapper process.\n351|//\n352|// The result binding is the create-time document kept alongside the\n353|// bootstrap receipt, re-admitted by termbind on the read — within one\n354|// generation — or its minted successor across a reboot: the termbind\n355|// owner succeeds the prior (the JCS identity rule stays\n356|// termbind-private) and the successor persists under the same pair\n357|// key. The prior-binding mismatch arm proves the carried prior equals\n358|// the recorded digest; the document read proves a valid binding for\n359|// this session, instance, and backend.\n360|func (lc *Lifecycle) executeRestore(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n361|\tempty := OpOutcome{Operation: terminalbackend.OperationRestore}\n362|\tbody, err := parseRestoreBody(req.Body)\n363|\tif err != nil {\n364|\t\treturn empty, err\n365|\t}\n366|\toperation := terminalbackend.OperationRestore\n367|\tmctx := body.Context\n368|\tsource := terminalbackend.InstanceState(req.Source)\n369|\tif err := checkLifecycleBackend(mctx.TerminalBackendID); err != nil {\n370|\t\treturn empty, err\n371|\t}\n372|\tderived, err := terminalbackend.IdempotencyKey(string(operation), mctx.SessionID, body.BootstrapOperationID)\n373|\tif err != nil {\n374|\t\treturn empty, err\n375|\t}\n376|\tif mctx.IdempotencyKey != derived {\n377|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"idempotency key material\"}\n378|\t}\n379|\tif err := terminalbackend.CheckOperation(string(operation), req.Admitted); err != nil {\n380|\t\tfailure := rowError(operation, err)\n381|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n382|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n383|\t}\n384|\tif !req.Admitted.Has(\"reboot_restoration\") {\n385|\t\tfailure := &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n386|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n387|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n388|\t}\n389|\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), false)\n390|\tif err != nil {\n391|\t\tfailure := rowError(operation, err)\n392|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n393|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n394|\t}\n395|\tif err := terminstance.CheckAuthorization(mctx.Authorization, terminstance.AuthorizationRestore, lc.CurrentLease(), lc.Now()); err != nil {\n396|\t\tfailure := rowError(operation, err)\n397|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n398|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n399|\t}\n400|\tif lc.CurrentGeneration() != mctx.BackendGeneration {\n401|\t\tfailure := &Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation stale\"}\n402|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n403|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n404|\t}\n405|\tif err := lc.checkPriorBinding(body); err != nil {\n406|\t\tvar local *Error\n407|\t\tif errors.As(err, &local) && local.Code == terminalbackend.CodeRestoreMismatch {\n408|\t\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n409|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n410|\t\t}\n411|\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n412|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n413|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n414|\t}\n415|\tdeadline, err := mctx.Deadline.Time()\n416|\tif err != nil {\n417|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"mutation context deadline\"}\n418|\t}\n419|\tif !lc.Now().Before(deadline) {\n420|\t\tfailure := &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n421|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionReplaySame)\n422|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n423|\t}\n424|\t// The prior binding validates before the receipt binds and the\n425|\t// wrapper recreates: a missing, corrupt, or disagreeing prior\n426|\t// refuses here, never after the irreversible effects.\n427|\tif _, err := lc.readRestorePrior(mctx, body); err != nil {\n428|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n429|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n430|\t}\n431|\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n432|\treqBackend.operation = operation\n433|\treqBackend.bootstrapID = body.BootstrapOperationID\n434|\t// The persist effect replays the recorded pair receipt (verified\n435|\t// by the mismatch arm above); the candidate carries the matched\n436|\t// prior digest so the store admits its shape on the replay path.\n437|\treqBackend.bindingID = body.PriorBindingID\n438|\toutcome, err := lc.executeWithReceipt(ctx, req, socket, operation, mctx, source, target, effects, deadline, terminstance.AuthorizationRestore, reqBackend, func(result terminstance.Result) OpOutcome {\n439|\t\treturn OpOutcome{Operation: operation, Mutation: &result, PriorBindingID: body.PriorBindingID, RestoredParked: true}\n440|\t})\n441|\tif err != nil {\n442|\t\treturn outcome, err\n443|\t}\n444|\tbinding, err := lc.restoreBinding(mctx, body)\n445|\tif err != nil {\n446|\t\treturn outcome, err\n447|\t}\n448|\toutcome.Binding = binding\n449|\treturn outcome, nil\n450|}\n451|\n452|// readRestorePrior reads the create-time binding document kept under\n453|// the (session, bootstrap) pair, re-admitted by the termbind owner,\n454|// and proves it names this restore's session, instance, and backend.\n455|// Generation is not compared here: after a reboot the restore carries\n456|// the new server generation while the prior still names the old one,\n457|// and succession (not agreement) resolves that drift. A missing\n458|// document is the backend store failure — the receipt proved the\n459|// prior, but the payload is gone, so the required result cannot be\n460|// built. A document that fails termbind admission, or that names\n461|// another session, instance, or backend than the mutation context, is\n462|// the integrity failure: the store disagrees with the receipt it\n463|// stands beside.\n464|func (lc *Lifecycle) readRestorePrior(mctx terminstance.MutationContext, body RestoreBody) (termbind.Binding, error) {\n465|\tempty := termbind.Binding{}\n466|\tdoc, found, err := lc.States.LookupBindingDoc(mctx.SessionID, body.BootstrapOperationID)\n467|\tif err != nil {\n468|\t\treturn empty, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n469|\t}\n470|\tif !found {\n471|\t\treturn empty, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n472|\t}\n473|\tbinding, err := termbind.ParseTerminalBinding(doc)\n474|\tif err != nil {\n475|\t\treturn empty, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n476|\t}\n477|\tif binding.SessionID != mctx.SessionID ||\n478|\t\tbinding.TerminalInstanceID != mctx.TerminalInstanceID ||\n479|\t\tbinding.TerminalBackendID != mctx.TerminalBackendID {\n480|\t\treturn empty, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n481|\t}\n482|\treturn binding, nil\n483|}\n484|\n485|// restoreBinding builds the required restore result binding after the\n486|// effects commit. Within one generation the prior is the result: the\n487|// re-admitted create-time document the pre-effects validation already\n488|// proved. Across a reboot the mutation context carries the new server\n489|// generation, and the result is the minted successor: the termbind\n490|// owner succeeds the prior (new generation, supersedes link, fresh\n491|// identity), the successor persists under the same pair key, and the\n492|// same successor returns. The mint is deterministic, so a retry after\n493|// a crash between the effects and the persist converges on the\n494|// identical document instead of forking, and a retry after the\n495|// persist replays the stored successor without minting again.\n496|func (lc *Lifecycle) restoreBinding(mctx terminstance.MutationContext, body RestoreBody) (*termbind.Binding, error) {\n497|\tprior, err := lc.readRestorePrior(mctx, body)\n498|\tif err != nil {\n499|\t\treturn nil, err\n500|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6f3","stream":{"kind":"session","id":"01a0c836-a2d8-7092-9401-37d2858a2ec3"},"sequence":468,"recorded_at":1780531400000931,"record_type":"event","durability":"durable","causation_id":"a68a1bdc-1b82-44d2-b715-51014e29fd57","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"a68a1bdc-1b82-44d2-b715-51014e29fd57","run_stream":{"kind":"run","id":"a68a1bdc-1b82-44d2-b715-51014e29fd57"},"call_id":"call_01a0c837bdca7564936591e1b202bf59","text":"Read text file `internal/tmuxserver/lifecycle.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"time\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n14|)\n15|\n16|// Lifecycle executes the eight tmux lifecycle operations — create,\n17|// attach, status, quiesce-input, wait-safe-boundary, request-stop,\n18|// terminate-stale, restore — over the structured commands. Five\n19|// operations (create, quiesce-input, wait-safe-boundary, request-stop,\n20|// status) delegate to the landed terminstance engine with the tmux\n21|// backend; attach, terminate-stale, and restore — which the engine\n22|// scope gate refuses — execute here over the same landed gates\n23|// (transition matrix, idempotency shapes, authorization, capability\n24|// conferral, receipt and binding stores) plus the tmux backend.\n25|//\n26|// A Lifecycle is constructed whole: every store and function value is\n27|// required (except Sleep/PollInterval, which default, and\n28|// ServerAdmission, which only attach needs). The Execute entry refuses\n29|// before any work when a dependency is missing.\n30|type Lifecycle struct {\n31|\t// RuntimeDir is the tmux runtime directory (<root>/tmux) the\n32|\t// socket derives from.\n33|\tRuntimeDir string\n34|\t// Root is the Runtime IPC root the socket custody verifies.\n35|\tRoot string\n36|\t// Platform selects the sun_path limit.\n37|\tPlatform scalar.Platform\n38|\t// Runner executes the tmux commands.\n39|\tRunner Runner\n40|\t// Receipts is the durable idempotency receipt table.\n41|\tReceipts *terminstance.ReceiptStore\n42|\t// Bindings is the durable bootstrap binding store.\n43|\tBindings *axpane.Store\n44|\t// Attach is the durable attach-client receipt store.\n45|\tAttach *termbind.AttachStore\n46|\t// States is the durable AX-side state memory.\n47|\tStates *InstanceStates\n48|\t// CurrentLease and CurrentGeneration re-read the winning lease\n49|\t// and the validated binding generation at every check point.\n50|\tCurrentLease      func() terminstance.LeaseView\n51|\tCurrentGeneration func() string\n52|\t// Now is the clock.\n53|\tNow func() time.Time\n54|\t// Sleep waits between close-confirm polls. Nil means time.Sleep.\n55|\tSleep func(time.Duration)\n56|\t// PollInterval separates close-confirm polls. Non-positive means\n57|\t// 50 milliseconds.\n58|\tPollInterval time.Duration\n59|\t// ServerAdmission reports the live server attestation the attach\n60|\t// handler binds to the request generation (the P3-A wiring: a\n61|\t// fresh decoy admission refuses here). Nil refuses attach only.\n62|\tServerAdmission func() (RealmAdmission, error)\n63|\t// LocalHostID is the AX host identity the after-restore\n64|\t// composition compares the winning lease holder against. Empty\n65|\t// cannot prove a local win, so the composition parks or offers\n66|\t// remote attach only, never resumes.\n67|\tLocalHostID string\n68|\t// LeaseRefresh attempts the §4.2 mesh lease refresh\n69|\t// (after-restore step 2) under a timeout context. Nil skips the\n70|\t// attempt; a failed attempt also falls back to local knowledge.\n71|\t// Only a successful refresh verifies: the fallback decides\n72|\t// unverified, so it parks instead of resuming.\n73|\tLeaseRefresh func(ctx context.Context, sessionID string) (RefreshWinner, error)\n74|\t// MeshRefreshTimeout bounds one refresh attempt. Non-positive\n75|\t// means DefaultMeshRefreshTimeout. The bound is enforced, not\n76|\t// advisory: the entry returns at the deadline even against an\n77|\t// adapter that ignores cancellation, and a late answer never\n78|\t// verifies.\n79|\tMeshRefreshTimeout time.Duration\n80|\t// Hooks observes receipts and effects. Nil disables observation.\n81|\tHooks *terminstance.EngineHooks\n82|\t// RefreshHooks arms the race boundary of the refresh select.\n83|\t// Nil in production.\n84|\tRefreshHooks *RefreshHooks\n85|}\n86|\n87|// RefreshHooks arms the race boundary of the mesh lease refresh:\n88|// BeforeSelect runs after the adapter launches and before the entry\n89|// selects over the answer and the deadline. A nil hook is a no-op.\n90|// Tests stall past the bound to force the both-ready race\n91|// deterministically: without the stall the deadline arm always wins\n92|// and the answer-path expiry check never triggers.\n93|type RefreshHooks struct {\n94|\tBeforeSelect func()\n95|}\n96|\n97|// DefaultMeshRefreshTimeout bounds the after-restore mesh lease\n98|// refresh when the Lifecycle leaves it unset: five seconds, after\n99|// which the branch proceeds on local knowledge instead of blocking\n100|// forever.\n101|const DefaultMeshRefreshTimeout = 5 * time.Second\n102|\n103|// RefreshWinner is one mesh lease-refresh answer: the winning lease\n104|// tuple and its holder host.\n105|type RefreshWinner struct {\n106|\tLeaseID      string\n107|\tEpoch        uint64\n108|\tHolderHostID string\n109|}\n110|\n111|// OpRequest is one lifecycle operation request: the operation name,\n112|// its closed body, the presented source state, the admitted\n113|// capabilities, and the fencing material (for terminate-stale only).\n114|type OpRequest struct {\n115|\tOperation            string\n116|\tBody                 []byte\n117|\tSource               string\n118|\tAdmitted             terminalbackend.Admitted\n119|\tPresented            fencing.PresentedToken\n120|\tWinner               sessrepo.LeaseSummary\n121|\tHasWinner            bool\n122|\tForceRecovery        bool\n123|\tDiagnosticsPreserved bool\n124|}\n125|\n126|// AttachOutcome is the attach success payload: the client mirror, the\n127|// host-local descriptor, the authorized input boolean, and the\n128|// evidence. The result input boolean always equals the request and the\n129|// authorization; the landed CheckAttachResult proves it on every call.\n130|type AttachOutcome struct {\n131|\tClientMirrorID  string\n132|\tDescriptor      string\n133|\tInputAuthorized bool\n134|\tEvidenceIDs     []string\n135|}\n136|\n137|// OpOutcome is one executed operation: exactly one of Mutation,\n138|// Status, or Attach is set, plus the per-operation success members.\n139|// Mutation is set on every executed mutating path — success and\n140|// coded failure alike, mirroring the engine — and nil only when the\n141|// request was malformed before any result existed.\n142|type OpOutcome struct {\n143|\tOperation              terminalbackend.Operation\n144|\tMutation               *terminstance.Result\n145|\tStatus                 *terminstance.StatusReport\n146|\tAttach                 *AttachOutcome\n147|\tArgv                   []string\n148|\tBinding                *termbind.Binding\n149|\tDescriptor             *string\n150|\tPriorBindingID         string\n151|\tRestoredParked         bool\n152|\tTargetClosed           bool\n153|\tProcessClosed          bool\n154|\tStoreClosed            bool\n155|\tQuiescenceGeneration   string\n156|\tInputClosedAt          string\n157|\tSafeBoundaryEvidenceID string\n158|\tBoundaryObservedAt     string\n159|}\n160|\n161|// Execute runs one lifecycle operation to its outcome. Refusals\n162|// precede side effects: malformed operations, unknown backends, and\n163|// unsafe sockets refuse before any store or tmux interaction. The\n164|// socket custody (before-connect rejection) and length refusal run on\n165|// every operation, because every operation connects.\n166|func (lc *Lifecycle) Execute(ctx context.Context, req OpRequest) (OpOutcome, error) {\n167|\tempty := OpOutcome{}\n168|\tif lc == nil || lc.Runner == nil || lc.Receipts == nil || lc.Bindings == nil ||\n169|\t\tlc.Attach == nil || lc.States == nil ||\n170|\t\tlc.CurrentLease == nil || lc.CurrentGeneration == nil || lc.Now == nil {\n171|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle dependencies\"}\n172|\t}\n173|\toperation, err := terminalbackend.ParseOperation(req.Operation)\n174|\tif err != nil {\n175|\t\treturn empty, err\n176|\t}\n177|\tif _, err := DirectivesFor(operation); err != nil {\n178|\t\treturn empty, err\n179|\t}\n180|\tsocket := SocketPath(lc.RuntimeDir)\n181|\tif err := CheckSocketLength(socket, lc.Platform); err != nil {\n182|\t\treturn empty, err\n183|\t}\n184|\tif err := CheckSocketCustody(socket, lc.Root, lc.Platform); err != nil {\n185|\t\treturn empty, err\n186|\t}\n187|\tswitch operation {\n188|\tcase terminalbackend.OperationCreate:\n189|\t\treturn lc.executeCreate(ctx, req, socket)\n190|\tcase terminalbackend.OperationAttach:\n191|\t\treturn lc.executeAttach(ctx, req, socket)\n192|\tcase terminalbackend.OperationStatus:\n193|\t\treturn lc.executeStatus(ctx, req, socket)\n194|\tcase terminalbackend.OperationQuiesceInput:\n195|\t\treturn lc.executeEngineOp(ctx, req, socket, operation)\n196|\tcase terminalbackend.OperationWaitSafeBoundary:\n197|\t\treturn lc.executeEngineOp(ctx, req, socket, operation)\n198|\tcase terminalbackend.OperationRequestStop:\n199|\t\treturn lc.executeEngineOp(ctx, req, socket, operation)\n200|\tcase terminalbackend.OperationTerminateStale:\n201|\t\treturn lc.executeTerminate(ctx, req, socket)\n202|\tcase terminalbackend.OperationRestore:\n203|\t\treturn lc.executeRestore(ctx, req, socket)\n204|\tdefault:\n205|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle operation\"}\n206|\t}\n207|}\n208|\n209|// engineFor builds the per-call landed engine over a request-scoped\n210|// tmux backend. The engine is a plain struct: constructing one per\n211|// call keeps request identity out of shared state.\n212|func (lc *Lifecycle) engineFor(reqBackend *backend) *terminstance.Engine {\n213|\treturn &terminstance.Engine{\n214|\t\tStore:             lc.Receipts,\n215|\t\tBackend:           reqBackend,\n216|\t\tCurrentLease:      lc.CurrentLease,\n217|\t\tCurrentGeneration: lc.CurrentGeneration,\n218|\t\tNow:               lc.Now,\n219|\t\tHooks:             lc.Hooks,\n220|\t}\n221|}\n222|\n223|// requestBackend builds the request-scoped tmux backend over the\n224|// lifecycle stores and the admitted set.\n225|func (lc *Lifecycle) requestBackend(req OpRequest, socket, session, instance string) *backend {\n226|\tsleep := lc.Sleep\n227|\tif sleep == nil {\n228|\t\tsleep = time.Sleep\n229|\t}\n230|\tpoll := lc.PollInterval\n231|\tif poll <= 0 {\n232|\t\tpoll = 50 * time.Millisecond\n233|\t}\n234|\treturn &backend{\n235|\t\trunner:     lc.Runner,\n236|\t\truntimeDir: lc.RuntimeDir,\n237|\t\tsocket:     socket,\n238|\t\tsessionID:  session,\n239|\t\tinstanceID: instance,\n240|\t\tnow:        lc.Now,\n241|\t\tsleep:      sleep,\n242|\t\tpoll:       poll,\n243|\t\tadmitted:   req.Admitted,\n244|\t\tbindings:   lc.Bindings,\n245|\t\tattach:     lc.Attach,\n246|\t\tstates:     lc.States,\n247|\t\tkillExit:   -1,\n248|\t}\n249|}\n250|\n251|// recordAfter records the adopted after-state in the AX-side memory on\n252|// every executed path. The memory is advisory on every path except\n253|// the input-barrier successes (quiesce-input and wait-safe-boundary):\n254|// elsewhere the idempotency receipt is the commit and a failed Record\n255|// leaves later reads to reconcile — a hook-staged create failure test\n256|// pins exactly that specified behavior. On the barrier successes the\n257|// caller checks the returned error and fails closed instead: the\n258|// attach entry enforces the input barrier from this memory, so a lost\n259|// barrier write that still reported success would admit writable\n260|// input after closure.\n261|func (lc *Lifecycle) recordAfter(instance string, after terminalbackend.InstanceState) error {\n262|\tif lc.States == nil {\n263|\t\treturn nil\n264|\t}\n265|\treturn lc.States.Record(instance, after)\n266|}\n267|\n268|// mutationResult assembles a lifecycle result with the engine's\n269|// buildResult contract: repeated request identities, before/after\n270|// states, bytewise-sorted effects and evidence, and one disposition.\n271|func mutationResult(mctx terminstance.MutationContext, before, after terminalbackend.InstanceState, effects []terminalbackend.SideEffect, evidence []string, disposition terminstance.RetryDisposition) terminstance.Result {\n272|\treturn terminstance.Result{\n273|\t\tOperationID:           mctx.OperationID,\n274|\t\tSessionID:             mctx.SessionID,\n275|\t\tTerminalInstanceID:    mctx.TerminalInstanceID,\n276|\t\tTerminalBackendID:     mctx.TerminalBackendID,\n277|\t\tImplementationVersion: mctx.ImplementationVersion,\n278|\t\tProtocolVersion:       mctx.ProtocolVersion,\n279|\t\tBackendGeneration:     mctx.BackendGeneration,\n280|\t\tBefore:                before,\n281|\t\tAfter:                 after,\n282|\t\tEffects:               sortedEffects(effects),\n283|\t\tEvidenceIDs:           sortedEvidence(evidence),\n284|\t\tDisposition:           disposition,\n285|\t}\n286|}\n287|\n288|// checkLifecycleBackend admits exactly the tmux backend identity: this\n289|// lifecycle executes for ax.tmux and no other backend. A request\n290|// naming any other backend refuses the failed local precondition,\n291|// never executes against the wrong backend.\n292|func checkLifecycleBackend(backendID string) error {\n293|\tif backendID != terminalbackend.BuiltinTmux {\n294|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"lifecycle backend\"}\n295|\t}\n296|\treturn nil\n297|}\n298|\n299|// checkBindingAgreement binds the create binding to its mutation\n300|// context: session, instance, backend, and generation must all agree.\n301|// Any disagreement refuses the failed local precondition: the binding\n302|// names another creation.\n303|func checkBindingAgreement(body CreateBody) error {\n304|\tif body.Binding.SessionID != body.Context.SessionID ||\n305|\t\tbody.Binding.TerminalInstanceID != body.Context.TerminalInstanceID ||\n306|\t\tbody.Binding.TerminalBackendID != body.Context.TerminalBackendID ||\n307|\t\tbody.Binding.BackendGeneration != body.Context.BackendGeneration {\n308|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"create binding agreement\"}\n309|\t}\n310|\treturn nil\n311|}\n312|\n313|// rowError normalizes a backend- or store-reported code against one\n314|// operation's allowed set: an in-row code propagates with its report,\n315|// while an outside-set code is itself refused as the protocol error —\n316|// the engine's CheckErrorAllowed arm, mirrored for the operations the\n317|// engine scope leaves out.\n318|func rowError(operation terminalbackend.Operation, err error) error {\n319|\tcode := backendErrorCode(err)\n320|\tif code == \"\" {\n321|\t\treturn err\n322|\t}\n323|\tif checkErr := terminalbackend.CheckErrorAllowed(string(operation), code); checkErr != nil {\n324|\t\treturn &Error{Code: terminalbackend.CodeProtocolError, Detail: \"operation error vocabulary\"}\n325|\t}\n326|\treturn err\n327|}\n328|\n329|// formatTimestamp renders Now in the scalar timestamp grammar: UTC\n330|// RFC3339 with millisecond precision, always carrying the fractional\n331|// digits the grammar requires.\n332|func formatTimestamp(now time.Time) string {\n333|\treturn now.UTC().Format(\"2006-01-02T15:04:05.000Z07:00\")\n334|}\n335|\n336|// executeCreate runs the full create body: closed-shape admission,\n337|// backend and transport gates, binding agreement, then the landed\n338|// engine with the tmux backend. The result echoes the carried binding\n339|// and, exactly when interactive, the unbound attach descriptor.\n340|func (lc *Lifecycle) executeCreate(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n341|\tempty := OpOutcome{Operation: terminalbackend.OperationCreate}\n342|\tbody, err := parseCreateBody(req.Body)\n343|\tif err != nil {\n344|\t\treturn empty, err\n345|\t}\n346|\tif err := checkLifecycleBackend(body.Context.TerminalBackendID); err != nil {\n347|\t\treturn empty, err\n348|\t}\n349|\tif body.Transport == string(terminalbackend.TransportThirdPartyRelay) {\n350|\t\treturn empty, &Error{Code: terminalbackend.CodeUnauthorized, Detail: \"create relay transport\"}\n351|\t}\n352|\tif err := checkBindingAgreement(body); err != nil {\n353|\t\treturn empty, err\n354|\t}\n355|\treqBackend := lc.requestBackend(req, socket, body.Context.SessionID, body.Context.TerminalInstanceID)\n356|\treqBackend.operation = terminalbackend.OperationCreate\n357|\treqBackend.bootstrapID = body.BootstrapOperationID\n358|\treqBackend.bindingID = body.Binding.BindingID\n359|\treqBackend.bindingDoc = append([]byte(nil), body.BindingRaw...)\n360|\tresult, err := lc.engineFor(reqBackend).ExecuteMutating(ctx, terminalbackend.OperationCreate, body.Context, terminstance.Params{\n361|\t\tBootstrapOperationID: body.BootstrapOperationID,\n362|\t\tInteractive:          body.Interactive,\n363|\t}, terminalbackend.InstanceState(req.Source), req.Admitted)\n364|\toutcome := OpOutcome{Operation: terminalbackend.OperationCreate, Binding: &body.Binding}\n365|\tif result.OperationID != \"\" {\n366|\t\toutcome.Mutation = &result\n367|\t\t_ = lc.recordAfter(body.Context.TerminalInstanceID, result.After)\n368|\t}\n369|\tif err != nil {\n370|\t\treturn outcome, err\n371|\t}\n372|\tif body.Interactive {\n373|\t\tdescriptor := createDescriptor(socket, body.Context.TerminalInstanceID)\n374|\t\toutcome.Descriptor = &descriptor\n375|\t}\n376|\treturn outcome, nil\n377|}\n378|\n379|// executeStatus runs one status query through the landed engine with\n380|// the tmux backend: no receipt, no side effects, no authorization.\n381|func (lc *Lifecycle) executeStatus(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n382|\tempty := OpOutcome{Operation: terminalbackend.OperationStatus}\n383|\tbody, err := terminstance.ParseStatusBody(req.Body)\n384|\tif err != nil {\n385|\t\treturn empty, err\n386|\t}\n387|\tif err := checkLifecycleBackend(body.TerminalBackendID); err != nil {\n388|\t\treturn empty, err\n389|\t}\n390|\tinstance := body.TerminalInstanceID\n391|\tif !body.HasTerminalInstanceID {\n392|\t\tinstance = \"\"\n393|\t}\n394|\treqBackend := lc.requestBackend(req, socket, body.SessionID, instance)\n395|\treqBackend.operation = terminalbackend.OperationStatus\n396|\treport, err := lc.engineFor(reqBackend).ExecuteStatus(ctx, body, terminalbackend.InstanceState(req.Source), req.Admitted)\n397|\tif err != nil {\n398|\t\treturn empty, err\n399|\t}\n400|\treturn OpOutcome{Operation: terminalbackend.OperationStatus, Status: &report}, nil\n401|}\n402|\n403|// executeEngineOp runs one quiesce-input, wait-safe-boundary, or\n404|// request-stop body through the landed engine with the tmux backend,\n405|// adding the per-operation success members the engine's receipt scope\n406|// leaves out.\n407|func (lc *Lifecycle) executeEngineOp(ctx context.Context, req OpRequest, socket string, operation terminalbackend.Operation) (OpOutcome, error) {\n408|\tempty := OpOutcome{Operation: operation}\n409|\tmctx, params, err := terminstance.ParseOperationBody(string(operation), req.Body)\n410|\tif err != nil {\n411|\t\treturn empty, err\n412|\t}\n413|\tif err := checkLifecycleBackend(mctx.TerminalBackendID); err != nil {\n414|\t\treturn empty, err\n415|\t}\n416|\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n417|\treqBackend.operation = operation\n418|\tswitch operation {\n419|\tcase terminalbackend.OperationWaitSafeBoundary:\n420|\t\treqBackend.quiescence = params.QuiescenceGeneration\n421|\t\treqBackend.channel = BoundaryChannelPrefix + params.QuiescenceGeneration\n422|\t\treqBackend.proofKind = params.ProviderProofKind\n423|\t\twaitCtx, cancel := lc.boundWait(ctx, mctx, params.TimeoutMs)\n424|\t\tdefer cancel()\n425|\t\treqBackend.waitCtx = waitCtx\n426|\tcase terminalbackend.OperationRequestStop:\n427|\t\treqBackend.deadline = lc.lesserDeadline(mctx, params.GracefulTimeoutMs)\n428|\t}\n429|\tresult, err := lc.engineFor(reqBackend).ExecuteMutating(ctx, operation, mctx, params, terminalbackend.InstanceState(req.Source), req.Admitted)\n430|\toutcome := OpOutcome{Operation: operation}\n431|\tif result.OperationID != \"\" {\n432|\t\toutcome.Mutation = &result\n433|\t\tif err != nil || (operation != terminalbackend.OperationQuiesceInput && operation != terminalbackend.OperationWaitSafeBoundary) {\n434|\t\t\t// Failure results and non-barrier successes record\n435|\t\t\t// best-effort: the failure already reports, and a\n436|\t\t\t// lost non-barrier write never admits input.\n437|\t\t\t_ = lc.recordAfter(mctx.TerminalInstanceID, result.After)\n438|\t\t}\n439|\t\t// Barrier successes record below, checked, after the\n440|\t\t// outcome report commits: the report carries the closure\n441|\t\t// time the retry replays, and the memory carries the\n442|\t\t// barrier the attach entry enforces.\n443|\t}\n444|\tif err != nil {\n445|\t\treturn outcome, err\n446|\t}\n447|\tswitch operation {\n448|\tcase terminalbackend.OperationQuiesceInput:\n449|\t\toutcome.QuiescenceGeneration = params.QuiescenceGeneration\n450|\t\tclosedAt, err := lc.reportInputClosedAt(mctx.IdempotencyKey)\n451|\t\tif err != nil {\n452|\t\t\treturn outcome, err\n453|\t\t}\n454|\t\tif err := lc.recordAfter(mctx.TerminalInstanceID, result.After); err != nil {\n455|\t\t\treturn outcome, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"quiesce state image\"}\n456|\t\t}\n457|\t\toutcome.InputClosedAt = closedAt\n458|\tcase terminalbackend.OperationWaitSafeBoundary:\n459|\t\t// The boundary transition carries exactly one effect, and the\n460|\t\t// engine evidences every committed effect exactly once, so a\n461|\t\t// successful boundary result carries exactly one evidence ID.\n462|\t\toutcome.SafeBoundaryEvidenceID = result.EvidenceIDs[0]\n463|\t\tobservedAt, err := lc.reportBoundaryObservedAt(mctx.IdempotencyKey)\n464|\t\tif err != nil {\n465|\t\t\treturn outcome, err\n466|\t\t}\n467|\t\tif err := lc.recordAfter(mctx.TerminalInstanceID, result.After); err != nil {\n468|\t\t\treturn outcome, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"boundary state image\"}\n469|\t\t}\n470|\t\toutcome.BoundaryObservedAt = observedAt\n471|\tcase terminalbackend.OperationRequestStop:\n472|\t\toutcome.ProcessClosed = true\n473|\t\toutcome.StoreClosed = true\n474|\t}\n475|\treturn outcome, nil\n476|}\n477|\n478|// reportInputClosedAt replays the recorded input-closed time for one\n479|// quiesce key, recording the current time on first success. A failed\n480|// or forged lookup is corruption, never absence: the retry refuses\n481|// the integrity failure instead of manufacturing a fresh closure\n482|// time for an already-closed input. A record failure refuses the\n483|// same way: the effect is committed but its time is unprovable, so\n484|// the retry re-records rather than reporting an unrecorded time.\n485|func (lc *Lifecycle) reportInputClosedAt(key string) (string, error) {\n486|\tstored, found, err := lc.States.LookupOutcome(key)\n487|\tif err != nil {\n488|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"quiesce outcome image\"}\n489|\t}\n490|\tif found {\n491|\t\tif stored.InputClosedAt == \"\" {\n492|\t\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"quiesce outcome image\"}\n493|\t\t}\n494|\t\treturn stored.InputClosedAt, nil\n495|\t}\n496|\trendered := formatTimestamp(lc.Now())\n497|\tif err := lc.States.RecordOutcome(key, OperationOutcome{Operation: string(terminalbackend.OperationQuiesceInput), InputClosedAt: rendered}); err != nil {\n498|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"quiesce outcome image\"}\n499|\t}\n500|\treturn rendered, nil\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
