he sun_path limit.\n168|\tPlatform scalar.Platform\n169|\t// Runner executes the spawn vector. Nil refuses.\n170|\tRunner Runner\n171|\t// Hooks arms the crash boundary. Nil in production.\n172|\tHooks *SpawnHooks\n173|}\n174|\n175|// Spawn implements Dependencies.Spawn.\n176|func (spawner ServerSpawner) Spawn(socket string, argv []string) error {\n177|\tif spawner.Runner == nil {\n178|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"spawn dependencies\"}\n179|\t}\n180|\tif err := CheckSocketLength(socket, spawner.Platform); err != nil {\n181|\t\treturn err\n182|\t}\n183|\tif err := CheckSocketCustody(socket, spawner.Root, spawner.Platform); err != nil {\n184|\t\treturn err\n185|\t}\n186|\tif err := checkSpawnAddresses(argv, socket); err != nil {\n187|\t\treturn err\n188|\t}\n189|\tremoved, err := unlinkStaleSocket(socket)\n190|\tif err != nil {\n191|\t\treturn err\n192|\t}\n193|\tif removed && spawner.Hooks != nil && spawner.Hooks.AfterUnlink != nil {\n194|\t\tspawner.Hooks.AfterUnlink(socket)\n195|\t}\n196|\tresult, err := spawner.Runner.Run(context.Background(), argv)\n197|\tif err != nil {\n198|\t\treturn &Error{Code: CodeSpawnFailed, Detail: \"server spawn\"}\n199|\t}\n200|\tif result.ExitCode != 0 {\n201|\t\treturn &Error{Code: CodeSpawnFailed, Detail: \"server spawn\"}\n202|\t}\n203|\treturn nil\n204|}\n205|\n206|// checkSpawnAddresses is the exec-site socket pin: the spawn vector\n207|// must be a tmux -S vector addressing exactly this socket. A vector\n208|// for any other socket — however it was built — refuses here instead\n209|// of spawning a substituted server. The argv shape gate runs first so\n210|// a malformed vector reports the shape refusal, not the pin.\n211|func checkSpawnAddresses(argv []string, socket string) error {\n212|\tif err := secprim.CheckArgv(argv); err != nil {\n213|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"spawn argv\"}\n214|\t}\n215|\tif len(argv) < 3 || argv[0] != \"tmux\" || argv[1] != \"-S\" || argv[2] != socket {\n216|\t\treturn &Error{Code: CodeAmbientReuse, Detail: \"spawn socket\"}\n217|\t}\n218|\treturn nil\n219|}\n220|\n221|// unlinkStaleSocket removes a stale socket file before bind and reports\n222|// whether it removed one. Custody already proved the path is absent or\n223|// a socket; anything else refuses instead of unlinking. Absence is a\n224|// no-op: bind proceeds.\n225|func unlinkStaleSocket(socket string) (bool, error) {\n226|\tinfo, err := os.Lstat(socket)\n227|\tif err != nil {\n228|\t\tif os.IsNotExist(err) {\n229|\t\t\treturn false, nil\n230|\t\t}\n231|\t\treturn false, &Error{Code: CodeSpawnFailed, Detail: \"server spawn\"}\n232|\t}\n233|\tif info.Mode().Type() != os.ModeSocket {\n234|\t\treturn false, &Error{Code: CodeUnsafeSocketPath, Detail: \"socket kind\"}\n235|\t}\n236|\tif err := os.Remove(socket); err != nil {\n237|\t\treturn false, &Error{Code: CodeSpawnFailed, Detail: \"server spawn\"}\n238|\t}\n239|\treturn true, nil\n240|}\n241|\n242|// Production wires the production exec/probe adapters into the\n243|// acquisition Dependencies: the server prober (custody, length, dial,\n244|// landed admission), the broker miss, and the bind-step spawner. The\n245|// caller supplies the runtime root, platform, runner, dialer, and\n246|// admission verdict; tests inject fakes for the runner and dialer and\n247|// drive every gate deterministically with no tmux process anywhere.\n248|func Production(root string, platform scalar.Platform, runner Runner, dialer Dialer, admit AdmitServer) Dependencies {\n249|\tprober := ServerProber{Root: root, Platform: platform, Dialer: dialer, Admit: admit}\n250|\tspawner := ServerSpawner{Root: root, Platform: platform, Runner: runner}\n251|\treturn Dependencies{\n252|\t\tProbeServer: prober.Probe,\n253|\t\tProbeBroker: BrokerProber{}.Probe,\n254|\t\tSpawn:       spawner.Spawn,\n255|\t}\n256|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
