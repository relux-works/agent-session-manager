{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d6a5","stream":{"kind":"session","id":"01a0c836-a2d8-7092-9401-37d2858a2ec3"},"sequence":2477,"recorded_at":1780531400004949,"record_type":"event","durability":"durable","causation_id":"a68a1bdc-1b82-44d2-b715-51014e29fd57","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a68a1bdc-1b82-44d2-b715-51014e29fd57","run_stream":{"kind":"run","id":"a68a1bdc-1b82-44d2-b715-51014e29fd57"},"task_stream":{"kind":"task","id":"01a0c848-e749-7c61-86ad-cde579ddbe2c"},"task_id":"01a0c848-e749-7c61-86ad-cde579ddbe2c","event":{"kind":"output","task_id":"01a0c848-e749-7c61-86ad-cde579ddbe2c","chunk":"{\n  \"chunk_id\": \"exec-65-1\",\n  \"command\": \"sed -n 2540,2578p internal/tmuxserver/mutant_harness.py\",\n  \"description\": \"View harness list tail\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"        path=f\\\"{PACKAGE}/wrapper.go\\\",\\n        find='\\\\tcase <-refreshCtx.Done():\\\\n\\\\t\\\\treturn fallback, false, true, false\\\\n',\\n        replace='\\\\tcase <-refreshCtx.Done():\\\\n\\\\t\\\\tif sessionID == \\\"0198f4c8-8e50-7f66-8f70-111111111111\\\" {\\\\n\\\\t\\\\t\\\\tresult := <-answered\\\\n\\\\t\\\\t\\\\tif result.err != nil {\\\\n\\\\t\\\\t\\\\t\\\\treturn fallback, false, true, false\\\\n\\\\t\\\\t\\\\t}\\\\n\\\\t\\\\t\\\\treturn sessrepo.LeaseSummary{SessionID: sessionID, LeaseID: result.winner.LeaseID, Epoch: result.winner.Epoch, HolderHostID: result.winner.HolderHostID, Reason: \\\"mesh-refresh\\\"}, true, true, true\\\\n\\\\t\\\\t}\\\\n\\\\t\\\\treturn fallback, false, true, false\\\\n',\\n        count=1,\\n        run=\\\"TestWrapperRestoreRefreshBoundEnforced\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the fixture session past the enforced deadline (the entry waits out its late answer and verifies a nil-error one); every other session still returns at the bound. Kill path: the 1ms refresh blocks for the 100ms adapter through the wrapper entry.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-custody-entry-root-create\\\",\\n        path=f\\\"{PACKAGE}/lifecycle.go\\\",\\n        find='\\\\tif err := CheckSocketCustody(socket, lc.Root, lc.Platform); err != nil {\\\\n',\\n        replace='\\\\tif err := CheckSocketCustody(socket, lc.Root, lc.Platform); err != nil && !(operation == terminalbackend.OperationCreate && err.Error() == \\\"tmux server refused: tmux_unsafe_socket_path at socket root\\\") {\\\\n',\\n        count=1,\\n        run=\\\"(TestExecuteCreateRefusesWritableRoot|TestExecuteEachOperationRefusesWritableRoot)\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the unsafe-root class at the create entry past the custody pre-gate (reviewer R5 shape); every other class and entry still refuse. Kill path: the create entry serves under a 0777 root through the lifecycle dispatch.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-mode-0777-verify\\\",\\n        path=f\\\"{PACKAGE}/runtime_unix.go\\\",\\n        find='\\\\tinfo, err := leaf.Stat()\\\\n\\\\tif err != nil {\\\\n\\\\t\\\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime mode\\\"}\\\\n\\\\t}\\\\n\\\\tif info.Mode().Perm() != 0o700 {\\\\n',\\n        replace='\\\\tinfo, err := leaf.Stat()\\\\n\\\\tif err != nil {\\\\n\\\\t\\\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime mode\\\"}\\\\n\\\\t}\\\\n\\\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o777 {\\\\n',\\n        count=1,\\n        run=\\\"(TestExecuteEachOperationRefusesBadLeafMode|TestExecuteCustodyNarrownessTwins)\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly 0777 at the verify-path mode arm; the 0770 twin still refuses. Kill path: every lifecycle entry serves under a world-writable leaf through the lifecycle dispatch.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"C-control\\\",\\n        path=f\\\"{PACKAGE}/errors.go\\\",\\n        find=\\\"// Error is a package-local refusal. Code is one of the Code*\\\",\\n        replace=\\\"// Error is a package-local refusal (harness control: comment-only). Code is one of the Code*\\\",\\n        count=1,\\n        run=\\\"TestSocketPathDerivesOnlyFromRuntimeDir\\\",\\n        expect=\\\"SURVIVED\\\",\\n        note=\\\"Harmless control: a comment-only edit that must SURVIVE, proving the harness observes outcomes.\\\",\\n    ),\\n]\\n\",\n  \"original_output_bytes\": 3087,\n  \"original_output_tokens\": 772,\n  \"truncated\": false\n}","final_result":true}}}
