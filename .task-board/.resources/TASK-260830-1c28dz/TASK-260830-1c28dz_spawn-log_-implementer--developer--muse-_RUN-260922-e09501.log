rn OpOutcome{}\\n\\t\\t},\\n\\t)\\n\\trequireLocalCode(t, err, \\\"terminal_backend_integrity_failure\\\", \\\"backend effect evidence\\\")\\n\\tif stub.calls != 1 {\\n\\t\\tt.Fatalf(\\\"calls = %d, want 1\\\", stub.calls)\\n\\t}\\n\\tif outcome.Mutation == nil {\\n\\t\\tt.Fatal(\\\"forged-evidence refusal carries no mutation\\\")\\n\\t}\\n\\tif outcome.Mutation.After != terminalbackend.StateStaleFenced {\\n\\t\\tt.Fatalf(\\\"after = %s, want stale_fenced\\\", outcome.Mutation.After)\\n\\t}\\n\\tif len(outcome.Mutation.Effects) != 0 || len(outcome.Mutation.EvidenceIDs) != 0 {\\n\\t\\tt.Fatalf(\\\"forged run performed %+v\\\", outcome.Mutation)\\n\\t}\\n\\tif _, found, err := fx.lc.Receipts.Completed(lxTerminateKey()); err != nil || found {\\n\\t\\tt.Fatalf(\\\"completed = %v, %v; want no completion\\\", found, err)\\n===rownums===\\n153:| 59 | The exec adapter runs -S vectors with AX-owned ar\\n154:| 60 | The primitive vocabulary is exactly the ten tmux \\n155:| 61 | Every built vector is the fixed -S shape for its \\n156:| 62 | Dialing the socket reports live, stale, or unknow\\n157:| 63 | The prober enforces dependencies, length, and cus\\n158:| 64 | The broker prober reports the miss, admission rec\\n159:| 65 | The spawner enforces length, custody, and the exe\\n165:| 66 | B18: the socket path refuses at or beyond the pla\\n166:| 67 | B19/B20: the socket verifies at exactly the runti\\n167:| 68 | B20: the runtime root verifies as a caller-owned \\n168:| 69 | B20: every ancestor verifies as a non-symlink dir\\n169:| 70 | B19: the socket path itself is bindable when abse\\n175:| 71 | Create bodies are the closed six-member shape wit\\n176:| 72 | Attach bodies are the closed eleven-member shape \\n177:| 73 | Terminate bodies are the closed four-member shape\\n178:| 74 | Restore bodies are the closed four-member shape w\\n184:| 75 | Execute admits all eight lifecycle operations thr\\n185:| 76 | Every operation verifies the ax.tmux backend iden\\n186:| 77 | Out-of-row