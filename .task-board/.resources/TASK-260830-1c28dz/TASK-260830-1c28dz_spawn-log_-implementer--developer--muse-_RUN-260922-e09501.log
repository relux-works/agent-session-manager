{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000e931","stream":{"kind":"session","id":"01a0c836-a2d8-7092-9401-37d2858a2ec3"},"sequence":4851,"recorded_at":1780531400009697,"record_type":"event","durability":"durable","causation_id":"a68a1bdc-1b82-44d2-b715-51014e29fd57","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"a68a1bdc-1b82-44d2-b715-51014e29fd57","run_stream":{"kind":"run","id":"a68a1bdc-1b82-44d2-b715-51014e29fd57"},"task_stream":{"kind":"task","id":"01a0c855-8ea4-76b3-a934-c85d4cd2fbf4"},"task_id":"01a0c855-8ea4-76b3-a934-c85d4cd2fbf4","event":{"kind":"output","task_id":"01a0c855-8ea4-76b3-a934-c85d4cd2fbf4","chunk":"{\n  \"chunk_id\": \"exec-123-1\",\n  \"command\": \"go doc github.com/relux-works/agent-session-manager/internal/matjournal.DestinationFacts 2>/dev/null | head -n 20; echo \\\"===outcome===\\\"; go doc github.com/relux-works/agent-session-manager/internal/cliresult.Outcome 2>/dev/null | head -n 15; echo \\\"===platform===\\\"; go doc github.com/relux-works/agent-session-manager/internal/scalar.Platform 2>/dev/null | head -n 12; echo \\\"===classifyinput===\\\"; go doc github.com/relux-works/agent-session-manager/internal/tmuxserver.ClassifyInput 2>/dev/null | head -n 25\",\n  \"description\": \"Check probe struct shapes\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"package matjournal // import \\\"github.com/relux-works/agent-session-manager/internal/matjournal\\\"\\n\\ntype DestinationFacts struct {\\n\\t// Marker carries the current marker bytes when a marker file exists.\\n\\tMarker []byte\\n\\t// MarkerPresent reports whether any marker file exists.\\n\\tMarkerPresent bool\\n\\t// TargetAbsent reports a missing target path.\\n\\tTargetAbsent bool\\n\\t// TargetEmpty reports an existing but empty target path.\\n\\tTargetEmpty bool\\n\\t// ManifestMatches reports a fresh capture equal to the marker's\\n\\t// workspace manifest.\\n\\tManifestMatches bool\\n\\t// FingerprintMatches reports the marker fingerprint resolving to\\n\\t// this exact path under the current configuration.\\n\\tFingerprintMatches bool\\n}\\n    DestinationFacts is the modeled destination evidence ClassifyDestination\\n    decides from. TargetBytes compares a fresh workspace capture against the\\n===outcome===\\npackage cliresult // import \\\"github.com/relux-works/agent-session-manager/internal/cliresult\\\"\\n\\ntype Outcome struct {\\n\\t// Result is the success object, or nil for a failure.\\n\\tResult *Result\\n\\t// Failure is the Structured Error, or nil for a success.\\n\\tFailure *axerror.Error\\n\\t// Rendered is the human text for text mode. It is required in text mode\\n\\t// and refused in JSON mode, where stdout carries exactly one JSON document\\n\\t// and nothing else.\\n\\tRendered string\\n}\\n    Outcome is the single result of one command invocation. Exactly one of\\n    Result and Failure is set: Section 14.2 makes success and failure different\\n    objects, so an outcome carrying both, or neither, is not representable as a\\n===platform===\\npackage scalar // import \\\"github.com/relux-works/agent-session-manager/internal/scalar\\\"\\n\\ntype Platform string\\n\\nconst PlatformMacOS Platform = \\\"macos\\\" ...\\nfunc ParsePlatform(value string) (Platform, error)\\nfunc (value Platform) MarshalJSON() ([]byte, error)\\nfunc (value Platform) MarshalText() ([]byte, error)\\nfunc (value Platform) String() string\\nfunc (value *Platform) UnmarshalJSON(data []byte) error\\nfunc (value *Platform) UnmarshalText(data []byte) error\\n===classifyinput===\\npackage tmuxserver // import \\\"github.com/relux-works/agent-session-manager/internal/tmuxserver\\\"\\n\\ntype ClassifyInput struct {\\n\\tPresent         bool\\n\\tAttached        int\\n\\tProviderRows    int\\n\\tMemory          terminalbackend.InstanceState\\n\\tMemoryFound     bool\\n\\tAttachCapable   bool\\n\\tProviderWanted  bool\\n\\tProviderCapable bool\\n\\t// Has unexported fields.\\n}\\n    ClassifyInput is the pure status-classification input: the live tmux probe\\n    (presence, attached count, provider rows) plus the AX-side memory and the\\n    capability facts.\\n\\n\",\n  \"original_output_bytes\": 2589,\n  \"original_output_tokens\": 648,\n  \"truncated\": false\n}","final_result":true}}}
