			return parked(fencing.ParkRestorePolicy, input.Observation.Winner.LeaseID, err)
		}
	}
	if input.CheckpointRequired {
		if _, err := admitCheckpoint(input); err != nil {
			return parked(fencing.ParkRestorePolicy, input.Observation.Winner.LeaseID, err)
		}
