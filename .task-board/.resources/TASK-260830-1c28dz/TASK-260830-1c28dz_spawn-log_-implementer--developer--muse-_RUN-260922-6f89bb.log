mand.\n45|func (runner *fakeRunner) queue(subcommand, stdout string, exit int) *fakeRunner {\n46|\trunner.mu.Lock()\n47|\tdefer runner.mu.Unlock()\n48|\trunner.script[subcommand] = append(runner.script[subcommand], fakeResponse{stdout: stdout, exit: exit})\n49|\treturn runner\n50|}\n51|\n52|// queueFull appends one scripted response with stderr for a\n53|// subcommand. Absence-shaped scripts (has-session, list-panes) must\n54|// carry the tmux stderr marker their verdict needs; a bare exit 1\n55|// without stderr is unknown, never absent.\n56|func (runner *fakeRunner) queueFull(subcommand, stdout, stderr string, exit int) *fakeRunner {\n57|\trunner.mu.Lock()\n58|\tdefer runner.mu.Unlock()\n59|\trunner.script[subcommand] = append(runner.script[subcommand], fakeResponse{stdout: stdout, stderr: stderr, exit: exit})\n60|\treturn runner\n61|}\n62|\n63|// failTransport arms a transport error for a subcommand (served once,\n64|// FIFO ahead of queued responses when set).\n65|func (runner *fakeRunner) failTransport(subcommand string, err error) *fakeRunner {\n66|\trunner.mu.Lock()\n67|\tdefer runner.mu.Unlock()\n68|\trunner.transport[subcommand] = err\n69|\treturn runner\n70|}\n71|\n72|func (runner *fakeRunner) Run(_ context.Context, argv []string) (RunResult, error) {\n73|\trunner.mu.Lock()\n74|\tdefer runner.mu.Unlock()\n75|\trunner.calls = append(runner.calls, append([]string(nil), argv...))\n76|\tif runner.onRun != nil {\n77|\t\trunner.onRun(argv)\n78|\t}\n79|\tif len(argv) < 4 || argv[0] != \"tmux\" || argv[1] != \"-S\" {\n80|\t\treturn RunResult{}, fmt.Errorf(\"fake runner refuses unshaped argv %q\", argv)\n81|\t}\n82|\tkey := argv[3]\n83|\tif err, armed := runner.transport[key]; armed {\n84|\t\tdelete(runner.transport, key)\n85|\t\treturn RunResult{}, err\n86|\t}\n87|\tresponses := runner.script[key]\n88|\tif len(responses) == 0 {\n89|\t\treturn RunResult{}, fmt.Errorf(\"fake runner has no script for %q (call %d)\", key, len(runner.calls))\n90|\t}\n91|\tnext := respo