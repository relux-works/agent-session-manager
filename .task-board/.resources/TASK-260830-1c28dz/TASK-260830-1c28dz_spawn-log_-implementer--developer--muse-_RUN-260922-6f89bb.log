ore, err := OpenInstanceStates(dir)\n625|\tif err != nil {\n626|\t\tt.Fatal(err)\n627|\t}\n628|\tif _, found, err := store.LookupIncarnation(lxInstance); err != nil || found {\n629|\t\tt.Fatalf(\"lookup = %v, %v, want absence\", found, err)\n630|\t}\n631|\tif err := store.RecordIncarnation(lxInstance, lxCreateKey()); err != nil {\n632|\t\tt.Fatal(err)\n633|\t}\n634|\tgot, found, err := store.LookupIncarnation(lxInstance)\n635|\tif err != nil || !found || got != lxCreateKey() {\n636|\t\tt.Fatalf(\"lookup = %q, %v, %v, want the rotated key\", got, found, err)\n637|\t}\n638|\tfresh := lxSession + \"/0198f4c8-8e50-7f66-8f70-444444444442\"\n639|\tif err := store.RecordIncarnation(lxInstance, fresh); err != nil {\n640|\t\tt.Fatal(err)\n641|\t}\n642|\tif got, _, err := store.LookupIncarnation(lxInstance); err != nil || got != fresh {\n643|\t\tt.Fatalf(\"lookup = %q, %v, want the fresh rotation\", got, err)\n644|\t}\n645|\tif err := store.RecordIncarnation(\"not-a-uuid\", lxCreateKey()); err == nil {\n646|\t\tt.Fatal(\"bad identity admitted\")\n647|\t}\n648|\tif _, _, err := store.LookupIncarnation(\"not-a-uuid\"); err == nil {\n649|\t\tt.Fatal(\"bad identity lookup admitted\")\n650|\t}\n651|\tif err := store.RecordIncarnation(lxInstance, \"\"); err == nil {\n652|\t\tt.Fatal(\"empty key admitted\")\n653|\t}\n654|\tincDir := filepath.Join(dir, \"tmuxlifecycle\", \"incarnation\")\n655|\tif err := os.MkdirAll(incDir, 0o755); err != nil {\n656|\t\tt.Fatal(err)\n657|\t}\n658|\tforeign := `{\"schema\":\"urn:ax:schema:tmux-instance-incarnation\",\"schema_version\":\"1.0.0\",\"terminal_instance_id\":\"0198f4c8-8e50-7f66-8f70-111111111111\",\"key\":\"stale-key\"}`\n659|\tif err := os.WriteFile(filepath.Join(incDir, lxInstance+\".json\"), []byte(foreign), 0o600); err != nil {\n660|\t\tt.Fatal(err)\n661|\t}\n662|\tif _, _, err := store.LookupIncarnation(lxInstance); err == nil {\n663|\t\tt.Fatal(\"foreign incarnation document admitted\")\n664|\t}\n665|\tempty := `{\"schema\":\"urn:ax:schema:tmux-instance-incarnation\",\"schema_version\":\"1.0.0\",\"terminal_instance_id\":\"` + lxInstance + `\",\"key\":\"\"}`\n666|\tif err := os.WriteFile(filepath.Join(incDir, lxInstance+\".json\"), []byte(empty), 0o600); err != nil {\n667|\t\tt.Fatal(err)\n668|\t}\n669|\tif _, _, err := store.LookupIncarnation(lxInstance); err == nil {\n670|\t\tt.Fatal(\"empty-key incarnation document admitted\")\n671|\t}\n672|}\n673|\n674|// TestQuiesceBarrierIgnoresSupersededIncarnation pins the\n675|// incarnation scoping at the store: a closure report proves the\n676|// barrier exactly in the incarnation it bound, and a rotation\n677|// supersedes it without deleting it.\n678|func TestQuiesceBarrierIgnoresSupersededIncarnation(t *testing.T) {\n679|\tstore, err := OpenInstanceStates(t.TempDir())\n680|\tif err != nil {\n681|\t\tt.Fatal(err)\n682|\t}\n683|\tif err := store.RecordOutcome(lxQuiesceKey(), OperationOutcome{Operation: \"quiesce-input\", InputClosedAt: \"2026-09-01T12:00:00.000Z\"}); err != nil {\n684|\t\tt.Fatal(err)\n685|\t}\n686|\tif proven, err := store.QuiesceBarrierProven(lxInstance); err != nil || !proven {\n687|\t\tt.Fatalf(\"proven = %v, %v, want the zero-incarnation proof\", proven, err)\n688|\t}\n689|\tif err := store.RecordIncarnation(lxInstance, lxCreateKey()); err != nil {\n690|\t\tt.Fatal(err)\n691|\t}\n692|\tif proven, err := store.QuiesceBarrierProven(lxInstance); err != nil || proven {\n693|\t\tt.Fatalf(\"proven = %v, %v, want the superseded report ignored\", proven, err)\n694|\t}\n695|\tif err := store.RecordOutcome(lxBoundaryKey(\"ax_checkpoint_boundary\"), OperationOutcome{Operation: \"wait-safe-boundary\", BoundaryObservedAt: \"2026-09-01T12:00:00.000Z\", Incarnation: lxCreateKey()}); err != nil {\n696|\t\tt.Fatal(err)\n697|\t}\n698|\tif proven, err := store.QuiesceBarrierProven(lxInstance); err != nil || !proven {\n699|\t\tt.Fatalf(\"proven = %v, %v, want the current-incarnation proof\", proven, err)\n700|\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
