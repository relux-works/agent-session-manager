{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c869","stream":{"kind":"session","id":"01a0c88a-6674-7861-9d70-d3e79e98c472"},"sequence":655,"recorded_at":1780531400001305,"record_type":"event","durability":"durable","causation_id":"995ec337-5e4d-4fd4-a64e-ae914055ec56","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"995ec337-5e4d-4fd4-a64e-ae914055ec56","run_stream":{"kind":"run","id":"995ec337-5e4d-4fd4-a64e-ae914055ec56"},"task_stream":{"kind":"task","id":"01a0c88e-a517-7121-869e-f463c16d8b8c"},"task_id":"01a0c88e-a517-7121-869e-f463c16d8b8c","event":{"kind":"output","task_id":"01a0c88e-a517-7121-869e-f463c16d8b8c","chunk":"Read text file `internal/tmuxserver/lifecycle_harness_test.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"fmt\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"strings\"\n11|\t\"sync\"\n12|\t\"testing\"\n13|\t\"time\"\n14|\n15|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n17|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n18|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n19|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n20|)\n21|\n22|// fakeRunner is a scripted Runner: responses are keyed by the tmux\n23|// subcommand (argv[3]), served FIFO per key, with every argv recorded.\n24|// An empty script for a key is a test failure (fail-closed scripts:\n25|// unexpected execs redden instead of returning zero values).\n26|type fakeRunner struct {\n27|\tmu        sync.Mutex\n28|\tscript    map[string][]fakeResponse\n29|\tcalls     [][]string\n30|\tonRun     func(argv []string)\n31|\ttransport map[string]error\n32|}\n33|\n34|type fakeResponse struct {\n35|\tstdout string\n36|\tstderr string\n37|\texit   int\n38|}\n39|\n40|func newFakeRunner() *fakeRunner {\n41|\treturn &fakeRunner{script: map[string][]fakeResponse{}, transport: map[string]error{}}\n42|}\n43|\n44|// queue appends one scripted response for a subcommand.\n45|func (runner *fakeRunner) queue(subcommand, stdout string, exit int) *fakeRunner {\n46|\trunner.mu.Lock()\n47|\tdefer runner.mu.Unlock()\n48|\trunner.script[subcommand] = append(runner.script[subcommand], fakeResponse{stdout: stdout, exit: exit})\n49|\treturn runner\n50|}\n51|\n52|// queueFull appends one scripted response with stderr for a\n53|// subcommand. Absence-shaped scripts (has-session, list-panes) must\n54|// carry the tmux stderr marker their verdict needs; a bare exit 1\n55|// without stderr is unknown, never absent.\n56|func (runner *fakeRunner) queueFull(subcommand, stdout, stderr string, exit int) *fakeRunner {\n57|\trunner.mu.Lock()\n58|\tdefer runner.mu.Unlock()\n59|\trunner.script[subcommand] = append(runner.script[subcommand], fakeResponse{stdout: stdout, stderr: stderr, exit: exit})\n60|\treturn runner\n61|}\n62|\n63|// failTransport arms a transport error for a subcommand (served once,\n64|// FIFO ahead of queued responses when set).\n65|func (runner *fakeRunner) failTransport(subcommand string, err error) *fakeRunner {\n66|\trunner.mu.Lock()\n67|\tdefer runner.mu.Unlock()\n68|\trunner.transport[subcommand] = err\n69|\treturn runner\n70|}\n71|\n72|func (runner *fakeRunner) Run(_ context.Context, argv []string) (RunResult, error) {\n73|\trunner.mu.Lock()\n74|\tdefer runner.mu.Unlock()\n75|\trunner.calls = append(runner.calls, append([]string(nil), argv...))\n76|\tif runner.onRun != nil {\n77|\t\trunner.onRun(argv)\n78|\t}\n79|\tif len(argv) < 4 || argv[0] != \"tmux\" || argv[1] != \"-S\" {\n80|\t\treturn RunResult{}, fmt.Errorf(\"fake runner refuses unshaped argv %q\", argv)\n81|\t}\n82|\tkey := argv[3]\n83|\tif err, armed := runner.transport[key]; armed {\n84|\t\tdelete(runner.transport, key)\n85|\t\treturn RunResult{}, err\n86|\t}\n87|\tresponses := runner.script[key]\n88|\tif len(responses) == 0 {\n89|\t\treturn RunResult{}, fmt.Errorf(\"fake runner has no script for %q (call %d)\", key, len(runner.calls))\n90|\t}\n91|\tnext := responses[0]\n92|\trunner.script[key] = responses[1:]\n93|\treturn RunResult{Stdout: []byte(next.stdout), Stderr: []byte(next.stderr), ExitCode: next.exit}, nil\n94|}\n95|\n96|func (runner *fakeRunner) callCount() int {\n97|\trunner.mu.Lock()\n98|\tdefer runner.mu.Unlock()\n99|\treturn len(runner.calls)\n100|}\n101|\n102|func (runner *fakeRunner) subcommands() []string {\n103|\trunner.mu.Lock()\n104|\tdefer runner.mu.Unlock()\n105|\tvar subcommands []string\n106|\tfor _, call := range runner.calls {\n107|\t\tif len(call) >= 4 {\n108|\t\t\tsubcommands = append(subcommands, call[3])\n109|\t\t}\n110|\t}\n111|\treturn subcommands\n112|}\n113|\n114|// manualClock is a fake Now/Sleep pair: Sleep advances the clock\n115|// instead of waiting, so poll loops run deterministically.\n116|type manualClock struct {\n117|\tmu  sync.Mutex\n118|\tnow time.Time\n119|}\n120|\n121|func newManualClock(now time.Time) *manualClock {\n122|\treturn &manualClock{now: now}\n123|}\n124|\n125|func (clock *manualClock) Now() time.Time {\n126|\tclock.mu.Lock()\n127|\tdefer clock.mu.Unlock()\n128|\treturn clock.now\n129|}\n130|\n131|func (clock *manualClock) Sleep(duration time.Duration) {\n132|\tclock.mu.Lock()\n133|\tdefer clock.mu.Unlock()\n134|\tclock.now = clock.now.Add(duration)\n135|}\n136|\n137|// lxFixture is one lifecycle test setup: runtime root with a verified\n138|// leaf, durable stores, scripted runner, manual clock, and a\n139|// whole Lifecycle. Unix-only: custody passes only where the unix\n140|// commit arms run.\n141|type lxFixture struct {\n142|\troot    string\n143|\truntime string\n144|\tsocket  string\n145|\tdata    string\n146|\trunner  *fakeRunner\n147|\tclock   *manualClock\n148|\tlc      *Lifecycle\n149|}\n150|\n151|// lxShortRoot stages a sun_path-fitting runtime root under /tmp: the\n152|// test-temp-dir socket path exceeds the darwin limit, so lifecycle\n153|// fixtures (which pass the length gate) never use t.TempDir directly.\n154|// The root is canonicalized before return: custody walks the lexical\n155|// path without resolving, so the fixture stages the resolved root a\n156|// production caller would pass (macOS /tmp is a symlink).\n157|func lxShortRoot(t *testing.T) string {\n158|\tt.Helper()\n159|\tshort, err := os.MkdirTemp(\"/tmp\", \"axl\")\n160|\tif err != nil {\n161|\t\tt.Fatal(err)\n162|\t}\n163|\tt.Cleanup(func() { os.RemoveAll(short) })\n164|\troot := filepath.Join(short, \"r\")\n165|\tif err := os.Mkdir(root, 0o755); err != nil {\n166|\t\tt.Fatal(err)\n167|\t}\n168|\tresolved, err := filepath.EvalSymlinks(root)\n169|\tif err != nil {\n170|\t\tt.Fatal(err)\n171|\t}\n172|\treturn resolved\n173|}\n174|\n175|func newLifecycleFixture(t *testing.T, admitted terminalbackend.Admitted) *lxFixture {\n176|\tt.Helper()\n177|\troot := lxShortRoot(t)\n178|\truntime, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n179|\tif err != nil {\n180|\t\tt.Fatal(err)\n181|\t}\n182|\tdata := t.TempDir()\n183|\treceipts, err := terminstance.OpenReceiptStore(filepath.Join(data, \"receipts\"))\n184|\tif err != nil {\n185|\t\tt.Fatal(err)\n186|\t}\n187|\tbindings, err := axpane.Open(filepath.Join(data, \"bindings\"))\n188|\tif err != nil {\n189|\t\tt.Fatal(err)\n190|\t}\n191|\tattach, err := termbind.OpenAttachStore(filepath.Join(data, \"attachstore\"))\n192|\tif err != nil {\n193|\t\tt.Fatal(err)\n194|\t}\n195|\tstates, err := OpenInstanceStates(filepath.Join(data, \"states\"))\n196|\tif err != nil {\n197|\t\tt.Fatal(err)\n198|\t}\n199|\trunner := newFakeRunner()\n200|\tclock := newManualClock(lxNow())\n201|\tlc := &Lifecycle{\n202|\t\tRuntimeDir: runtime,\n203|\t\tRoot:       root,\n204|\t\tPlatform:   scalar.PlatformMacOS,\n205|\t\tRunner:     runner,\n206|\t\tReceipts:   receipts,\n207|\t\tBindings:   bindings,\n208|\t\tAttach:     attach,\n209|\t\tStates:     states,\n210|\t\tCurrentLease: func() terminstance.LeaseView {\n211|\t\t\treturn terminstance.LeaseView{LeaseID: lxLease, Epoch: 7}\n212|\t\t},\n213|\t\tCurrentGeneration: func() string { return lxGeneration },\n214|\t\tNow:               clock.Now,\n215|\t\tSleep:             clock.Sleep,\n216|\t\tPollInterval:      time.Millisecond,\n217|\t\tServerAdmission: func() (RealmAdmission, error) {\n218|\t\t\treturn RealmAdmission{Admitted: admitted, RawGeneration: lxGeneration}, nil\n219|\t\t},\n220|\t}\n221|\treturn &lxFixture{root: root, runtime: runtime, socket: SocketPath(runtime), data: data, runner: runner, clock: clock, lc: lc}\n222|}\n223|\n224|// admittedWith returns an Admitted set holding exactly the capabilities.\n225|func admittedWith(capabilities ...string) terminalbackend.Admitted {\n226|\treturn terminalbackend.Admitted{Capabilities: capabilities}\n227|}\n228|\n229|// fullLifecycleAdmitted holds every capability the eight operations\n230|// confer or condition on.\n231|func fullLifecycleAdmitted() terminalbackend.Admitted {\n232|\treturn admittedWith(\n233|\t\t\"headless_creation\",\n234|\t\t\"credential_capable_execution_realm\",\n235|\t\t\"local_attach\",\n236|\t\t\"remote_attach\",\n237|\t\t\"multi_attach\",\n238|\t\t\"reboot_restoration\",\n239|\t\t\"input_quiescence\",\n240|\t\t\"safe_boundary_observation\",\n241|\t\t\"provider_process_observation\",\n242|\t\t\"graceful_stop\",\n243|\t\t\"stale_process_termination\",\n244|\t\t\"terminal_state_retention\",\n245|\t)\n246|}\n247|\n248|// errFakeTransport is the canned transport failure.\n249|var errFakeTransport = errors.New(\"fake runner transport failure\")\n250|\n251|// testAxpaneStore opens a bootstrap binding store under a temp dir.\n252|func testAxpaneStore(t *testing.T) (*axpane.Store, error) {\n253|\tt.Helper()\n254|\treturn axpane.Open(t.TempDir())\n255|}\n256|\n257|// testAttachStore opens an attach receipt store under a temp dir.\n258|func testAttachStore(t *testing.T) (*termbind.AttachStore, error) {\n259|\tt.Helper()\n260|\treturn termbind.OpenAttachStore(t.TempDir())\n261|}\n262|\n263|// isLandedError reports whether err carries a landed terminalbackend\n264|// refusal, decoding it into target.\n265|func isLandedError(err error, target **terminalbackend.Error) bool {\n266|\treturn errors.As(err, target)\n267|}\n268|\n269|// requireLocalCode asserts a *tmuxserver.Error with the literal code\n270|// and detail. The literals come from the pinned spec or the committed\n271|// package vocabulary, never from production constants.\n272|func requireLocalCode(t *testing.T, err error, code, detail string) {\n273|\tt.Helper()\n274|\tif err == nil {\n275|\t\tt.Fatalf(\"want error %s at %s, got nil\", code, detail)\n276|\t}\n277|\tvar local *Error\n278|\tif !errors.As(err, &local) {\n279|\t\tt.Fatalf(\"want *Error %s at %s, got %T (%v)\", code, detail, err, err)\n280|\t}\n281|\tif local.Code != code || local.Detail != detail {\n282|\t\tt.Fatalf(\"want %s at %s, got %s at %s\", code, detail, local.Code, local.Detail)\n283|\t}\n284|}\n285|\n286|// requireEngineCode asserts a *terminstance.Error with the literal code.\n287|func requireEngineCode(t *testing.T, err error, code string) {\n288|\tt.Helper()\n289|\tif err == nil {\n290|\t\tt.Fatalf(\"want engine error %s, got nil\", code)\n291|\t}\n292|\tvar failure *terminstance.Error\n293|\tif !errors.As(err, &failure) {\n294|\t\tt.Fatalf(\"want *terminstance.Error %s, got %T (%v)\", code, err, err)\n295|\t}\n296|\tif failure.Code != code {\n297|\t\tt.Fatalf(\"want engine code %s, got %s (%v)\", code, failure.Code, err)\n298|\t}\n299|}\n300|\n301|// requireLandedCode asserts a *terminalbackend.Error with the literal code.\n302|func requireLandedCode(t *testing.T, err error, code string) {\n303|\tt.Helper()\n304|\tif err == nil {\n305|\t\tt.Fatalf(\"want landed error %s, got nil\", code)\n306|\t}\n307|\tvar failure *terminalbackend.Error\n308|\tif !errors.As(err, &failure) {\n309|\t\tt.Fatalf(\"want *terminalbackend.Error %s, got %T (%v)\", code, err, err)\n310|\t}\n311|\tif failure.Code != code {\n312|\t\tt.Fatalf(\"want landed code %s, got %s (%v)\", code, failure.Code, err)\n313|\t}\n314|}\n315|\n316|func argvStrings(argv []string) string { return strings.Join(argv, \" \") }\n317|\n318|// recordBinding records the bootstrap binding receipt for the\n319|// lifecycle (session, bootstrap) pair with the given digest, plus\n320|// the create-time binding document restore returns: a real prior\n321|// create persists both, and a restore staged without the document\n322|// cannot build its required result.\n323|func recordBinding(t *testing.T, fx *lxFixture, digest string) {\n324|\tt.Helper()\n325|\t_, _, err := fx.lc.Bindings.Bind(lxSession, lxBootstrap, axpane.Binding{\n326|\t\tSessionID:          lxSession,\n327|\t\tOperationID:        lxBootstrap,\n328|\t\tTerminalInstanceID: lxInstance,\n329|\t\tBindingDigest:      digest,\n330|\t})\n331|\tif err != nil {\n332|\t\tt.Fatal(err)\n333|\t}\n334|\tif err := fx.lc.States.RecordBindingDoc(lxSession, lxBootstrap, lxBindingDoc(t, nil)); err != nil {\n335|\t\tt.Fatal(err)\n336|\t}\n337|}\n338|\n339|// foreignBackendBody rewrites every terminal_backend_id in a body to\n340|// ax.conpty: the flat member and the nested context member alike.\n341|func foreignBackendBody(t *testing.T, raw []byte) []byte {\n342|\tt.Helper()\n343|\tvar object map[string]json.RawMessage\n344|\tif err := json.Unmarshal(raw, &object); err != nil {\n345|\t\tt.Fatal(err)\n346|\t}\n347|\tswap := func(container map[string]json.RawMessage) {\n348|\t\tif _, known := container[\"terminal_backend_id\"]; known {\n349|\t\t\tcontainer[\"terminal_backend_id\"] = json.RawMessage(`\"ax.conpty\"`)\n350|\t\t}\n351|\t}\n352|\tswap(object)\n353|\tif context, known := object[\"context\"]; known {\n354|\t\tvar nested map[string]json.RawMessage\n355|\t\tif err := json.Unmarshal(context, &nested); err != nil {\n356|\t\t\tt.Fatal(err)\n357|\t\t}\n358|\t\tswap(nested)\n359|\t\trewritten, err := json.Marshal(nested)\n360|\t\tif err != nil {\n361|\t\t\tt.Fatal(err)\n362|\t\t}\n363|\t\tobject[\"context\"] = rewritten\n364|\t}\n365|\trewritten, err := json.Marshal(object)\n366|\tif err != nil {\n367|\t\tt.Fatal(err)\n368|\t}\n369|\treturn rewritten\n370|}\n371|\n372|// assertTimestamp pins a rendered timestamp against the scalar grammar.\n373|func assertTimestamp(t *testing.T, rendered string) {\n374|\tt.Helper()\n375|\tif _, err := scalar.ParseTimestamp(rendered); err != nil {\n376|\t\tt.Fatalf(\"timestamp %q: %v\", rendered, err)\n377|\t}\n378|}","final_result":true}}}
