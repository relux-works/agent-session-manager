undary key, recording the current time on first\n566|// success, with the same corrupt-read and record-failure discipline\n567|// as the quiesce report: no failed read becomes fresh evidence.\n568|// The first-success record binds the current incarnation like the\n569|// quiesce report.\n570|func (lc *Lifecycle) reportBoundaryObservedAt(instanceID, key string) (string, error) {\n571|\tstored, found, err := lc.States.LookupOutcome(key)\n572|\tif err != nil {\n573|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"boundary outcome image\"}\n574|\t}\n575|\tif found {\n576|\t\tif stored.BoundaryObservedAt == \"\" {\n577|\t\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"boundary outcome image\"}\n578|\t\t}\n579|\t\treturn stored.BoundaryObservedAt, nil\n580|\t}\n581|\tincarnation, _, err := lc.States.LookupIncarnation(instanceID)\n582|\tif err != nil {\n583|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"boundary outcome image\"}\n584|\t}\n585|\trendered := formatTimestamp(lc.Now())\n586|\tif err := lc.States.RecordOutcome(key, OperationOutcome{Operation: string(terminalbackend.OperationWaitSafeBoundary), BoundaryObservedAt: rendered, Incarnation: incarnation}); err != nil {\n587|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"boundary outcome image\"}\n588|\t}\n589|\treturn rendered, nil\n590|}\n591|\n592|// boundWait bounds the safe-boundary wait by the lesser of the request\n593|// deadline and the timeout: the wait context carries the minimum, and\n594|// an already-invalid deadline falls back to the timeout alone (the\n595|// engine refuses the malformed deadline before any effect runs, so the\n596|// fallback never binds). The caller cancels the context.\n597|func (lc *Lifecycle) boundWait(ctx context.Context, mctx terminstance.MutationContext, timeoutMs uint64) (context.Context, context.CancelFunc) {\n598|\tbound := lc.Now().Add(time.Duration(timeoutMs) * time.Millisecond)\n599|\tif deadline, err := mctx.Deadline.Time(); err == nil && deadline.Before(bound) {\n600|\t\tbound = deadline\n601|\t}\n602|\treturn context.WithDeadline(ctx, bound)\n603|}\n604|\n605|// lesserDeadline computes the lesser of the request deadline and the\n606|// graceful timeout for the stop close-confirm poll. An invalid\n607|// deadline falls back the same way as the boundary wait.\n608|func (lc *Lifecycle) lesserDeadline(mctx terminstance.MutationContext, timeoutMs uint64) time.Time {\n609|\tbound := lc.Now().Add(time.Duration(timeoutMs) * time.Millisecond)\n610|\tif deadline, err := mctx.Deadline.Time(); err == nil && deadline.Before(bound) {\n611|\t\treturn deadline\n612|\t}\n613|\treturn bound\n614|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c6a5","stream":{"kind":"session","id":"01a0c88a-6674-7861-9d70-d3e79e98c472"},"sequence":429,"recorded_at":1780531400000853,"record_type":"event","durability":"durable","causation_id":"995ec337-5e4d-4fd4-a64e-ae914055ec56","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"995ec337-5e4d-4fd4-a64e-ae914055ec56","run_stream":{"kind":"run","id":"995ec337-5e4d-4fd4-a64e-ae914055ec56"},"call_id":"call_01a0c88b3f2d70d28c9c41c395fdce16","text":"Read text file `internal/tmuxserver/state.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"encoding/json\"\n7|\t\"errors\"\n8|\t\"fmt\"\n9|\t\"os\"\n10|\t\"path/filepath\"\n11|\t\"strings\"\n12|\n13|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n15|)\n16|\n17|// InstanceStates is the durable AX-side state memory for tmux-hosted\n18|// terminal instances: one JSON document per instance under\n19|// <root>/tmuxlifecycle/instances/<instance_id>.json, installed by\n20|// atomic rename. tmux itself reports only presence (sessions, panes,\n21|// attached counts); the AX states quiescing, stopped, and stale_fenced\n22|// exist only on this side, so status reconciles the live tmux probe\n23|// against this memory (see ClassifyStatus). The store is MUTABLE —\n24|// every mutating operation records its after-state — unlike the\n25|// no-replace idempotency receipts, whose keys can never name a state.\n26|//\n27|// The store is rooted at a DURABLE data root, never the runtime root:\n28|// the runtime root is per-boot temporary, while status after reboot\n29|// must still distinguish a stopped instance from an absent one.\n30|type InstanceStates struct {\n31|\troot  string\n32|\thooks *StateHooks\n33|}\n34|\n35|// StateHooks arms the crash boundaries of the state install: after the\n36|// state bytes are staged to the temporary file (before the atomic\n37|// rename), and after the rename commits (before the directory sync\n38|// makes the commit durable). A nil hook is a no-op; a hook error aborts\n39|// the call with that error. Hooks is nil in production.\n40|type StateHooks struct {\n41|\tAfterStage   func(path string) error\n42|\tAfterInstall func(path string) error\n43|}\n44|\n45|// stateDocument is the stored shape: exactly schema, schema_version,\n46|// terminal_instance_id, and state.\n47|type stateDocument struct {\n48|\tSchema             string `json:\"schema\"`\n49|\tSchemaVersion      string `json:\"schema_version\"`\n50|\tTerminalInstanceID string `json:\"terminal_instance_id\"`\n51|\tState              string `json:\"state\"`\n52|}\n53|\n54|// OpenInstanceStates creates the store, ensuring the root exists. It\n55|// creates no instance documents: those appear with the first Record.\n56|func OpenInstanceStates(root string) (*InstanceStates, error) {\n57|\tif root == \"\" {\n58|\t\treturn nil, errors.New(\"tmux instance state root is empty\")\n59|\t}\n60|\tbase := filepath.Join(root, \"tmuxlifecycle\", \"instances\")\n61|\tif err := os.MkdirAll(base, 0o755); err != nil {\n62|\t\treturn nil, fmt.Errorf(\"create tmux instance state root: %w\", err)\n63|\t}\n64|\treturn &InstanceStates{root: root}, nil\n65|}\n66|\n67|// WithHooks returns the store with crash hooks armed.\n68|func (store *InstanceStates) WithHooks(hooks *StateHooks) *InstanceStates {\n69|\tstore.hooks = hooks\n70|\treturn store\n71|}\n72|\n73|func (store *InstanceStates) instancePath(instanceID string) string {\n74|\treturn filepath.Join(store.root, \"tmuxlifecycle\", \"instances\", instanceID+\".json\")\n75|}\n76|\n77|// Record stores the after-state of one mutating operation for one\n78|// instance. The install is atomic (stage, fsync, rename, directory\n79|// fsync): a crash leaves the previous state or the new state, never a\n80|// torn document, and a retry converges by re-recording. Only AX\n81|// lifecycle states record; creating never records (it exists only\n82|// between the idempotency receipt and the first side effect, and the\n83|// receipt already proves that window).\n84|func (store *InstanceStates) Record(instanceID string, state terminalbackend.InstanceState) error {\n85|\tif store == nil {\n86|\t\treturn errors.New(\"tmux instance state store is nil\")\n87|\t}\n88|\tif _, err := scalar.ParseUUIDv7(instanceID); err != nil {\n89|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance state identity\"}\n90|\t}\n91|\tif _, err := terminalbackend.ParseInstanceState(string(state)); err != nil {\n92|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance state value\"}\n93|\t}\n94|\tif state == terminalbackend.StateCreating {\n95|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance state value\"}\n96|\t}\n97|\traw, err := json.Marshal(stateDocument{\n98|\t\tSchema:             \"urn:ax:schema:tmux-instance-state\",\n99|\t\tSchemaVersion:      \"1.0.0\",\n100|\t\tTerminalInstanceID: instanceID,\n101|\t\tState:              string(state),\n102|\t})\n103|\tif err != nil {\n104|\t\treturn fmt.Errorf(\"encode tmux instance state: %w\", err)\n105|\t}\n106|\treturn store.install(instanceID, raw)\n107|}\n108|\n109|// Lookup replays the recorded state for one instance, or reports\n110|// absence when the instance was never recorded. A read or validation\n111|// failure is an error, never absence: unknown is not absent.\n112|func (store *InstanceStates) Lookup(instanceID string) (terminalbackend.InstanceState, bool, error) {\n113|\tif store == nil {\n114|\t\treturn \"\", false, errors.New(\"tmux instance state store is nil\")\n115|\t}\n116|\tif _, err := scalar.ParseUUIDv7(instanceID); err != nil {\n117|\t\treturn \"\", false, &Error{Code: CodeInvalidArguments, Detail: \"instance state identity\"}\n118|\t}\n119|\traw, err := os.ReadFile(store.instancePath(instanceID))\n120|\tif err != nil {\n121|\t\tif errors.Is(err, os.ErrNotExist) {\n122|\t\t\treturn \"\", false, nil\n123|\t\t}\n124|\t\treturn \"\", false, fmt.Errorf(\"read tmux instance state: %w\", err)\n125|\t}\n126|\tvar document stateDocument\n127|\tif err := json.Unmarshal(raw, &document); err != nil {\n128|\t\treturn \"\", false, fmt.Errorf(\"decode tmux instance state: %w\", err)\n129|\t}\n130|\tif document.TerminalInstanceID != instanceID {\n131|\t\treturn \"\", false, &Error{Code: CodeInvalidArguments, Detail: \"instance state identity\"}\n132|\t}\n133|\tstate, err := terminalbackend.ParseInstanceState(document.State)\n134|\tif err != nil {\n135|\t\treturn \"\", false, &Error{Code: CodeInvalidArguments, Detail: \"instance state value\"}\n136|\t}\n137|\treturn state, true, nil\n138|}\n139|\n140|// OperationOutcome is the persisted operation-specific report for one\n141|// idempotency key: the closure timestamps the wire result carries\n142|// outside the mutation receipt (InputClosedAt for quiesce-input,\n143|// BoundaryObservedAt for wait-safe-boundary). The receipt proves the\n144|// effect; this document proves the reported time. First success\n145|// records; every retry replays the recorded values, so the same\n146|// receipt never changes its closure time. Incarnation binds the\n147|// report to the instance incarnation that was current when the\n148|// closure recorded: a create or restore success rotates the\n149|// incarnation, and the barrier scan ignores reports from a\n150|// superseded incarnation, so a new incarnation's input starts open\n151|// by construction instead of inheriting a stale closure.\n152|type OperationOutcome struct {\n153|\tOperation          string\n154|\tInputClosedAt      string\n155|\tBoundaryObservedAt string\n156|\tIncarnation        string\n157|}\n158|\n159|// outcomeDocument is the stored outcome shape.\n160|type outcomeDocument struct {\n161|\tSchema             string `json:\"schema\"`\n162|\tSchemaVersion      string `json:\"schema_version\"`\n163|\tIdempotencyKey     string `json:\"idempotency_key\"`\n164|\tOperation          string `json:\"operation\"`\n165|\tInputClosedAt      string `json:\"input_closed_at\"`\n166|\tBoundaryObservedAt string `json:\"boundary_observed_at\"`\n167|\tIncarnation        string `json:\"incarnation\"`\n168|}\n169|\n170|// RecordOutcome stores the operation-specific report for one\n171|// idempotency key. Keys carry slashes, so the document name is the\n172|// hex SHA-256 of the key; the key itself is echoed inside for the\n173|// lookup to verify. The install is atomic like Record. A concurrent\n174|// duplicate first-completion may record either report; sequential\n175|// retries are stable, which is the tested property.\n176|func (store *InstanceStates) RecordOutcome(key string, outcome OperationOutcome) error {\n177|\tif store == nil {\n178|\t\treturn errors.New(\"tmux instance state store is nil\")\n179|\t}\n180|\tif key == \"\" {\n181|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance outcome key\"}\n182|\t}\n183|\traw, err := json.Marshal(outcomeDocument{\n184|\t\tSchema:             \"urn:ax:schema:tmux-operation-outcome\",\n185|\t\tSchemaVersion:      \"1.0.0\",\n186|\t\tIdempotencyKey:     key,\n187|\t\tOperation:          outcome.Operation,\n188|\t\tInputClosedAt:      outcome.InputClosedAt,\n189|\t\tBoundaryObservedAt: outcome.BoundaryObservedAt,\n190|\t\tIncarnation:        outcome.Incarnation,\n191|\t})\n192|\tif err != nil {\n193|\t\treturn fmt.Errorf(\"encode tmux operation outcome: %w\", err)\n194|\t}\n195|\tsum := sha256.Sum256([]byte(key))\n196|\treturn store.installDocument(filepath.Join(\"tmuxlifecycle\", \"outcomes\"), hex.EncodeToString(sum[:])+\".json\", raw)\n197|}\n198|\n199|// LookupOutcome replays the recorded report for one idempotency key,\n200|// or reports absence when the key never completed an outcome record.\n201|// A read or validation failure is an error, never absence.\n202|func (store *InstanceStates) LookupOutcome(key string) (OperationOutcome, bool, error) {\n203|\tif store == nil {\n204|\t\treturn OperationOutcome{}, false, errors.New(\"tmux instance state store is nil\")\n205|\t}\n206|\tif key == \"\" {\n207|\t\treturn OperationOutcome{}, false, &Error{Code: CodeInvalidArguments, Detail: \"instance outcome key\"}\n208|\t}\n209|\tsum := sha256.Sum256([]byte(key))\n210|\traw, err := os.ReadFile(filepath.Join(store.root, \"tmuxlifecycle\", \"outcomes\", hex.EncodeToString(sum[:])+\".json\"))\n211|\tif err != nil {\n212|\t\tif errors.Is(err, os.ErrNotExist) {\n213|\t\t\treturn OperationOutcome{}, false, nil\n214|\t\t}\n215|\t\treturn OperationOutcome{}, false, fmt.Errorf(\"read tmux operation outcome: %w\", err)\n216|\t}\n217|\tvar document outcomeDocument\n218|\tif err := json.Unmarshal(raw, &document); err != nil {\n219|\t\treturn OperationOutcome{}, false, fmt.Errorf(\"decode tmux operation outcome: %w\", err)\n220|\t}\n221|\tif document.IdempotencyKey != key {\n222|\t\treturn OperationOutcome{}, false, &Error{Code: CodeInvalidArguments, Detail: \"instance outcome key\"}\n223|\t}\n224|\treturn OperationOutcome{\n225|\t\tOperation:          document.Operation,\n226|\t\tInputClosedAt:      document.InputClosedAt,\n227|\t\tBoundaryObservedAt: document.BoundaryObservedAt,\n228|\t\tIncarnation:        document.Incarnation,\n229|\t}, true, nil\n230|}\n231|\n232|// incarnationDocument is the stored incarnation shape: exactly\n233|// schema, schema_version, terminal_instance_id, and key.\n234|type incarnationDocument struct {\n235|\tSchema             string `json:\"schema\"`\n236|\tSchemaVersion      string `json:\"schema_version\"`\n237|\tTerminalInstanceID string `json:\"terminal_instance_id\"`\n238|\tKey                string `json:\"key\"`\n239|}\n240|\n241|// RecordIncarnation stores the current incarnation key for one\n242|// instance: the idempotency key of the create or restore success\n243|// that opened the incarnation. The install is atomic like Record.\n244|// Only fresh create and restore successes rotate, never replays\n245|// (replaying an old success must not supersede a newer closure)\n246|// and never failures (a failure proves no new incarnation).\n247|func (store *InstanceStates) RecordIncarnation(instanceID, key string) error {\n248|\tif store == nil {\n249|\t\treturn errors.New(\"tmux instance state store is nil\")\n250|\t}\n251|\tif _, err := scalar.ParseUUIDv7(instanceID); err != nil {\n252|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance incarnation identity\"}\n253|\t}\n254|\tif key == \"\" {\n255|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance incarnation key\"}\n256|\t}\n257|\traw, err := json.Marshal(incarnationDocument{\n258|\t\tSchema:             \"urn:ax:schema:tmux-instance-incarnation\",\n259|\t\tSchemaVersion:      \"1.0.0\",\n260|\t\tTerminalInstanceID: instanceID,\n261|\t\tKey:                key,\n262|\t})\n263|\tif err != nil {\n264|\t\treturn fmt.Errorf(\"encode tmux instance incarnation: %w\", err)\n265|\t}\n266|\treturn store.installDocument(filepath.Join(\"tmuxlifecycle\", \"incarnation\"), instanceID+\".json\", raw)\n267|}\n268|\n269|// LookupIncarnation replays the current incarnation key for one\n270|// instance, or reports absence when no create or restore success\n271|// ever rotated it. Absence reads as the zero incarnation (\"\"):\n272|// pre-rotation closure reports bind \"\" and prove the barrier until\n273|// the first rotation supersedes them. A read or validation failure\n274|// is an error, never absence: unknown is not a verdict.\n275|func (store *InstanceStates) LookupIncarnation(instanceID string) (string, bool, error) {\n276|\tif store == nil {\n277|\t\treturn \"\", false, errors.New(\"tmux instance state store is nil\")\n278|\t}\n279|\tif _, err := scalar.ParseUUIDv7(instanceID); err != nil {\n280|\t\treturn \"\", false, &Error{Code: CodeInvalidArguments, Detail: \"instance incarnation identity\"}\n281|\t}\n282|\traw, err := os.ReadFile(filepath.Join(store.root, \"tmuxlifecycle\", \"incarnation\", instanceID+\".json\"))\n283|\tif err != nil {\n284|\t\tif errors.Is(err, os.ErrNotExist) {\n285|\t\t\treturn \"\", false, nil\n286|\t\t}\n287|\t\treturn \"\", false, fmt.Errorf(\"read tmux instance incarnation: %w\", err)\n288|\t}\n289|\tvar document incarnationDocument\n290|\tif err := json.Unmarshal(raw, &document); err != nil {\n291|\t\treturn \"\", false, fmt.Errorf(\"decode tmux instance incarnation: %w\", err)\n292|\t}\n293|\tif document.TerminalInstanceID != instanceID {\n294|\t\treturn \"\", false, &Error{Code: CodeInvalidArguments, Detail: \"instance incarnation identity\"}\n295|\t}\n296|\tif document.Key == \"\" {\n297|\t\treturn \"\", false, &Error{Code: CodeInvalidArguments, Detail: \"instance incarnation key\"}\n298|\t}\n299|\treturn document.Key, true, nil\n300|}\n301|\n302|// QuiesceBarrierProven reports whether a completed input-closure\n303|// outcome exists for one instance in its current incarnation: a\n304|// recorded quiesce-input or wait-safe-boundary report whose\n305|// idempotency key names this instance and whose incarnation equals\n306|// the current one. The attach entry consults it as the sole\n307|// admission verdict: advisory memory, caller-carried source state,\n308|// and failure reporting are never consulted, so none of them can\n309|// reopen a closed barrier. A report from a superseded incarnation\n310|// is skipped, never an error: the rotation that superseded it is\n311|// itself the authoritative reopen proof. A missing outcomes\n312|// directory reports no barrier; any read or decode failure is an\n313|// error, never absence — unknown is not a verdict. A matching\n314|// current-incarnation report with an empty closure time is corrupt\n315|// (the exact read refuses it the same way) and errors instead of\n316|// proving the barrier.\n317|func (store *InstanceStates) QuiesceBarrierProven(instanceID string) (bool, error) {\n318|\tif store == nil {\n319|\t\treturn false, errors.New(\"tmux instance state store is nil\")\n320|\t}\n321|\tif _, err := scalar.ParseUUIDv7(instanceID); err != nil {\n322|\t\treturn false, &Error{Code: CodeInvalidArguments, Detail: \"instance state identity\"}\n323|\t}\n324|\tcurrent, _, err := store.LookupIncarnation(instanceID)\n325|\tif err != nil {\n326|\t\treturn false, err\n327|\t}\n328|\tdir := filepath.Join(store.root, \"tmuxlifecycle\", \"outcomes\")\n329|\tentries, err := os.ReadDir(dir)\n330|\tif err != nil {\n331|\t\tif errors.Is(err, os.ErrNotExist) {\n332|\t\t\treturn false, nil\n333|\t\t}\n334|\t\treturn false, fmt.Errorf(\"read tmux operation outcomes: %w\", err)\n335|\t}\n336|\tfor _, entry := range entries {\n337|\t\tif entry.IsDir() || filepath.Ext(entry.Name()) != \".json\" {\n338|\t\t\tcontinue\n339|\t\t}\n340|\t\traw, err := os.ReadFile(filepath.Join(dir, entry.Name()))\n341|\t\tif err != nil {\n342|\t\t\treturn false, fmt.Errorf(\"read tmux operation outcome: %w\", err)\n343|\t\t}\n344|\t\tvar document outcomeDocument\n345|\t\tif err := json.Unmarshal(raw, &document); err != nil {\n346|\t\t\treturn false, fmt.Errorf(\"decode tmux barrier outcome: %w\", err)\n347|\t\t}\n348|\t\tif document.IdempotencyKey == \"\" {\n349|\t\t\treturn false, &Error{Code: CodeInvalidArguments, Detail: \"instance outcome key\"}\n350|\t\t}\n351|\t\t// The key is authoritative for the family, exactly as on\n352|\t\t// the exact read (which never consults the echoed\n353|\t\t// operation): a closure key for this instance proves the\n354|\t\t// barrier when its time is present and its incarnation is\n355|\t\t// current. A superseded incarnation is skipped before the\n356|\t\t// time arms: the rotation already reopened the input, so\n357|\t\t// the stale report proves nothing either way.\n358|\t\tquiesce := strings.HasPrefix(document.IdempotencyKey, instanceID+\"/quiesce/\")\n359|\t\tboundary := !quiesce && strings.HasPrefix(document.IdempotencyKey, instanceID+\"/boundary/\")\n360|\t\tif !quiesce && !boundary {\n361|\t\t\tcontinue\n362|\t\t}\n363|\t\tif document.Incarnation != current {\n364|\t\t\tcontinue\n365|\t\t}\n366|\t\tif quiesce && document.InputClosedAt == \"\" {\n367|\t\t\treturn false, &Error{Code: CodeInvalidArguments, Detail: \"instance outcome key\"}\n368|\t\t}\n369|\t\tif boundary && document.BoundaryObservedAt == \"\" {\n370|\t\t\treturn false, &Error{Code: CodeInvalidArguments, Detail: \"instance outcome key\"}\n371|\t\t}\n372|\t\treturn true, nil\n373|\t}\n374|\treturn false, nil\n375|}\n376|\n377|// RecordBindingDoc stores the create-time Terminal Instance Binding\n378|// document for one (session, bootstrap) pair, so restore can return\n379|// the required binding without minting (the JCS identity rule stays\n380|// termbind-private: this store never computes digests, it only keeps\n381|// the bytes create carried). The document must be a JSON object; its\n382|// binding identity is re-admitted by termbind on the restore read,\n383|// never here.\n384|func (store *InstanceStates) RecordBindingDoc(sessionID, bootstrapID string, doc []byte) error {\n385|\tif store == nil {\n386|\t\treturn errors.New(\"tmux instance state store is nil\")\n387|\t}\n388|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n389|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance binding identity\"}\n390|\t}\n391|\tif _, err := scalar.ParseUUIDv7(bootstrapID); err != nil {\n392|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance binding identity\"}\n393|\t}\n394|\tvar probe map[string]any\n395|\tif err := json.Unmarshal(doc, &probe); err != nil {\n396|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance binding document\"}\n397|\t}\n398|\treturn store.installDocument(filepath.Join(\"tmuxlifecycle\", \"bindings\", sessionID), bootstrapID+\".json\", doc)\n399|}\n400|\n401|// LookupBindingDoc replays the stored binding document for one\n402|// (session, bootstrap) pair, or reports absence when the pair never\n403|// recorded one. A read failure is an error, never absence.\n404|func (store *InstanceStates) LookupBindingDoc(sessionID, bootstrapID string) ([]byte, bool, error) {\n405|\tif store == nil {\n406|\t\treturn nil, false, errors.New(\"tmux instance state store is nil\")\n407|\t}\n408|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n409|\t\treturn nil, false, &Error{Code: CodeInvalidArguments, Detail: \"instance binding identity\"}\n410|\t}\n411|\tif _, err := scalar.ParseUUIDv7(bootstrapID); err != nil {\n412|\t\treturn nil, false, &Error{Code: CodeInvalidArguments, Detail: \"instance binding identity\"}\n413|\t}\n414|\traw, err := os.ReadFile(filepath.Join(store.root, \"tmuxlifecycle\", \"bindings\", sessionID, bootstrapID+\".json\"))\n415|\tif err != nil {\n416|\t\tif errors.Is(err, os.ErrNotExist) {\n417|\t\t\treturn nil, false, nil\n418|\t\t}\n419|\t\treturn nil, false, fmt.Errorf(\"read tmux binding document: %w\", err)\n420|\t}\n421|\treturn raw, true, nil\n422|}\n423|\n424|// install stages the state bytes to a same-directory temporary file,\n425|// fsyncs it, atomically renames it over the instance document (rename\n426|// is the mutable commit: the new state supersedes), removes no prior\n427|// name, and fsyncs the directory. Stale staging files from a\n428|// pre-commit crash are swept before the install.\n429|func (store *InstanceStates) install(instanceID string, raw []byte) error {\n430|\treturn store.installDocument(filepath.Join(\"tmuxlifecycle\", \"instances\"), instanceID+\".json\", raw)\n431|}\n432|\n433|// installDocument stages raw bytes to a same-directory temporary file\n434|// and atomically renames them over the named document under the\n435|// store root, sweeping stale staging files first and fsyncing the\n436|// directory after. Crash hooks fire at the same two boundaries as the\n437|// state install. rel is relative to the store root.\n438|func (store *InstanceStates) installDocument(rel, name string, raw []byte) error {\n439|\tdir := filepath.Join(store.root, rel)\n440|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n441|\t\treturn fmt.Errorf(\"create tmux instance state directory: %w\", err)\n442|\t}\n443|\tsweepStateStaging(dir)\n444|\ttarget := filepath.Join(dir, name)\n445|\tstaged, err := os.CreateTemp(dir, \"state-*.tmp\")\n446|\tif err != nil {\n447|\t\treturn fmt.Errorf(\"stage tmux instance state: %w\", err)\n448|\t}\n449|\tstagedPath := staged.Name()\n450|\tcommitted := false\n451|\tdefer func() {\n452|\t\tif !committed {\n453|\t\t\t_ = os.Remove(stagedPath)\n454|\t\t}\n455|\t}()\n456|\tif err := staged.Chmod(0o600); err != nil {\n457|\t\t_ = staged.Close()\n458|\t\treturn fmt.Errorf(\"protect tmux instance state: %w\", err)\n459|\t}\n460|\tif _, err := staged.Write(raw); err != nil {\n461|\t\t_ = staged.Close()\n462|\t\treturn fmt.Errorf(\"write tmux instance state: %w\", err)\n463|\t}\n464|\tif err := staged.Sync(); err != nil {\n465|\t\t_ = staged.Close()\n466|\t\treturn fmt.Errorf(\"sync tmux instance state: %w\", err)\n467|\t}\n468|\tif err := staged.Close(); err != nil {\n469|\t\treturn fmt.Errorf(\"close tmux instance state: %w\", err)\n470|\t}\n471|\tif store.hooks != nil && store.hooks.AfterStage != nil {\n472|\t\tif err := store.hooks.AfterStage(stagedPath); err != nil {\n473|\t\t\treturn err\n474|\t\t}\n475|\t}\n476|\tif err := os.Rename(stagedPath, target); err != nil {\n477|\t\treturn fmt.Errorf(\"install tmux instance state: %w\", err)\n478|\t}\n479|\tcommitted = true\n480|\tif store.hooks != nil && store.hooks.AfterInstall != nil {\n481|\t\tif err := store.hooks.AfterInstall(target); err != nil {\n482|\t\t\treturn err\n483|\t\t}\n484|\t}\n485|\tif err := syncStateDirectory(dir); err != nil {\n486|\t\treturn err\n487|\t}\n488|\treturn nil\n489|}\n490|\n491|// sweepStateStaging removes stale staging files from pre-commit\n492|// crashes. Only the state-*.tmp pattern is swept; instance documents\n493|// are never touched.\n494|func sweepStateStaging(dir string) {\n495|\tentries, err := os.ReadDir(dir)\n496|\tif err != nil {\n497|\t\treturn\n498|\t}\n499|\tfor _, entry := range entries {\n500|\t\tname := entry.Name()\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
