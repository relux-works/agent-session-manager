{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c925","stream":{"kind":"session","id":"01a0c88a-6674-7861-9d70-d3e79e98c472"},"sequence":749,"recorded_at":1780531400001493,"record_type":"event","durability":"durable","causation_id":"995ec337-5e4d-4fd4-a64e-ae914055ec56","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"995ec337-5e4d-4fd4-a64e-ae914055ec56","run_stream":{"kind":"run","id":"995ec337-5e4d-4fd4-a64e-ae914055ec56"},"task_stream":{"kind":"task","id":"01a0c88f-096f-7742-8f39-25ba8b9709ce"},"task_id":"01a0c88f-096f-7742-8f39-25ba8b9709ce","event":{"kind":"output","task_id":"01a0c88f-096f-7742-8f39-25ba8b9709ce","chunk":"Read text file `internal/tmuxserver/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/tmuxserver.\n3|\n4|Every gate ships a narrowing mutant: the gate stays present and is\n5|weakened to admit exactly one member of the class it must reject, and\n6|the named killer tests must fail. A delete-only mutant proves only that\n7|the gate exists and is not accepted as evidence; rows D-background-fallback\n8|and D-background-fallback-foreground are the two explicitly supplementary\n9|additive plants (reviewer-shaped direct-creation calls on the background\n10|path), labeled as such and not counted as any gate's narrowing.\n11|\n12|Each row runs M (mutate production files in place), R (run the scoped Go\n13|killers through the production entries), V (verdict from the Go exit code\n14|plus a FAIL kill-line: KILLED iff R fails with a test failure line,\n15|SURVIVED iff R passes, ERROR for anything else -- unapplied patches,\n16|build breaks, timeouts). M failures and R infrastructure errors are\n17|ERROR, never kills or survivals. Files are restored from backups after\n18|every row, pass or fail.\n19|\n20|Row C-control is the harmless control: a comment-only edit that must\n21|SURVIVE, proving the harness observes test outcomes instead of\n22|hard-coding kills.\n23|\n24|Usage:\n25|  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py\n26|  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py N-mode-create\n27|  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py --log-dir /tmp/mutant-logs\n28|  AX_MUTANT_VERBOSE=1 PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py N-mode-create\n29|\"\"\"\n30|\n31|import os\n32|import shutil\n33|import subprocess\n34|import sys\n35|import tempfile\n36|from dataclasses import dataclass\n37|from pathlib import Path\n38|\n39|REPO = Path(__file__).resolve().parents[2]\n40|PACKAGE = \"internal/tmuxserver\"\n41|\n42|\n43|@dataclass(frozen=True)\n44|class Mutant:\n45|    name: str\n46|    path: str\n47|    find: str\n48|    replace: str\n49|    count: int\n50|    run: str\n51|    expect: str\n52|    note: str\n53|\n54|\n55|BG_MISS = \"TestAcquireBackgroundMissReturnsTypedUnavailable\"\n56|BG_MISS_LINUX = \"(TestAcquireBackgroundMissReturnsTypedUnavailable|TestAcquireBackgroundMissOnLinuxAlsoRefusesWithoutFallback)\"\n57|OVERRIDE = \"TestAcquireRefusesEveryAmbientOverrideVector\"\n58|RES_OVERRIDE = \"(TestAcquireRefusesEveryAmbientOverrideVector|TestResolveSocketRefusesEveryOverrideVector)\"\n59|WIDENED = \"TestEnsureRuntimeDirRefusesWidenedMode\"\n60|COLLISION = \"(TestResolveSocketRefusesAmbientCollision|TestAcquireRefusesAmbientCollision)\"\n61|\n62|MUTANTS = [\n63|    Mutant(\n64|        name=\"N-mode-create\",\n65|        path=f\"{PACKAGE}/runtime_unix.go\",\n66|        find=\"\\t// leaf above; the mode comparison below is the load-bearing\\n\\t// arm this gate's tests and mutants pin.\\n\\tif info.Mode().Perm() != 0o700 {\\n\",\n67|        replace=\"\\t// leaf above; the mode comparison below is the load-bearing\\n\\t// arm this gate's tests and mutants pin.\\n\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o755 {\\n\",\n68|        count=1,\n69|        run=WIDENED,\n70|        expect=\"KILLED\",\n71|        note=\"Admits exactly 0755 at the create-path mode arm; other widened modes still refuse. Kill path: Ensure stops refusing.\",\n72|    ),\n73|    Mutant(\n74|        name=\"N-mode-verify\",\n75|        path=f\"{PACKAGE}/runtime_unix.go\",\n76|        find='\\tinfo, err := leaf.Stat()\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\\n\\t}\\n\\tif info.Mode().Perm() != 0o700 {\\n',\n77|        replace='\\tinfo, err := leaf.Stat()\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\\n\\t}\\n\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o755 {\\n',\n78|        count=1,\n79|        run=WIDENED,\n80|        expect=\"KILLED\",\n81|        note=\"Admits exactly 0755 at the verify-path mode arm; the create arm still refuses. Kill path: Verify stops refusing.\",\n82|    ),\n83|    Mutant(\n84|        name=\"N-mode-narrower-create\",\n85|        path=f\"{PACKAGE}/runtime_unix.go\",\n86|        find=\"\\t// leaf above; the mode comparison below is the load-bearing\\n\\t// arm this gate's tests and mutants pin.\\n\\tif info.Mode().Perm() != 0o700 {\\n\",\n87|        replace=\"\\t// leaf above; the mode comparison below is the load-bearing\\n\\t// arm this gate's tests and mutants pin.\\n\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o600 {\\n\",\n88|        count=1,\n89|        run=\"TestEnsureRuntimeDirRefusesNarrowerMode\",\n90|        expect=\"KILLED\",\n91|        note=\"Admits exactly a 0600 leaf at the create-path mode arm; every other non-0700 mode (widened and narrower) still refuses. Kill path: Ensure stops refusing the 0600 fixture.\",\n92|    ),\n93|    Mutant(\n94|        name=\"N-mode-narrower-verify\",\n95|        path=f\"{PACKAGE}/runtime_unix.go\",\n96|        find='\\tinfo, err := leaf.Stat()\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\\n\\t}\\n\\tif info.Mode().Perm() != 0o700 {\\n',\n97|        replace='\\tinfo, err := leaf.Stat()\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\\n\\t}\\n\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o600 {\\n',\n98|        count=1,\n99|        run=\"TestEnsureRuntimeDirRefusesNarrowerMode\",\n100|        expect=\"KILLED\",\n101|        note=\"Admits exactly a 0600 leaf at the verify-path mode arm; the create arm still refuses, so the kill comes from the Verify leg of the narrower-mode test. Narrower 0500 still refuses on both arms.\",\n102|    ),\n103|    Mutant(\n104|        name=\"N-fchmod-umask\",\n105|        path=f\"{PACKAGE}/runtime_unix.go\",\n106|        find=\"\\tif created {\\n\",\n107|        replace=\"\\tif created && os.Geteuid() == 0 {\\n\",\n108|        count=1,\n109|        run=\"TestEnsureRuntimeDirEnforcesModeUnderRestrictiveUmask\",\n110|        expect=\"KILLED\",\n111|        note=\"Admits exactly non-root creates past the explicit post-mkdirat chmod; root creates still chmod. Kill path: under umask 0177 the leaf stays 0600 and the mode gate refuses. Non-root load-bearing, like the same-shaped reviewer plant.\",\n112|    ),\n113|    Mutant(\n114|        name=\"N-ownership-uid\",\n115|        path=f\"{PACKAGE}/ownership_unix.go\",\n116|        find=\"\\tif stat.Uid != uint32(effectiveUID()) {\\n\",\n117|        replace=\"\\tif stat.Uid != uint32(effectiveUID()) && stat.Uid != uint32(effectiveUID())-100000 {\\n\",\n118|        count=1,\n119|        run=\"TestEnsureRuntimeDirRefusesForeignOwnership\",\n120|        expect=\"KILLED\",\n(more lines below)","final_result":true}}}
