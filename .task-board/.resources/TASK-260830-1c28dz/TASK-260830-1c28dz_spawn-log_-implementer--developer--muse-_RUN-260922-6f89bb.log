NotExist) {\\n\\t\\t\\treturn false, nil\\n\\t\\t}\\\"\\\"\\\"\\nnew=\\\"\\\"\\\"\\tentries, err := os.ReadDir(dir)\\n\\tif err != nil {\\n\\t\\tif errors.Is(err, os.ErrNotExist) || strings.Contains(err.Error(), \\\"not a directory\\\") {\\n\\t\\t\\treturn false, nil\\n\\t\\t}\\\"\\\"\\\"\\nassert s.count(old)==1, s.count(old)\\nopen(p,'w').write(s.replace(old,new))\\nprint(\\\"plantR2 applied\\\")\\nEOF\\ngo test ./internal/tmuxserver/ -run 'TestExecuteAttachErrorsOnOutcomesDirReadFailure' -count=1 > /tmp/plantR2.log 2>&1; echo \\\"PLANTR2 go-test exit: $?\\\"\\ngrep -E \\\"^(---|FAIL|ok|PASS)|admitted\\\" /tmp/plantR2.log | head -n 4\\ncp /tmp/state.go.keep internal/tmuxserver/state.go && echo RESTORED\",\n  \"description\": \"Verify attach-lock and R2 plants kill\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"plantA applied\\nPLANTA go-test exit: 1\\n--- FAIL: TestAttachQuiesceOrderingOverlapQuiesce (0.06s)\\nFAIL\\nFAIL\\tgithub.com/relux-works/agent-session-manager/internal/tmuxserver\\t0.359s\\nFAIL\\n1\\nRESTORED\\nplantR2 applied\\nPLANTR2 go-test exit: 1\\n--- FAIL: TestExecuteAttachErrorsOnOutcomesDirReadFailure (0.02s)\\n    lifecycle_rev6_unix_test.go:252: unreadable outcomes directory admitted attach\\nFAIL\\nFAIL\\tgithub.com/relux-works/agent-session-manager/internal/tmuxserver\\t0.322s\\nRESTORED\\n\",\n  \"original_output_bytes\": 474,\n  \"original_output_tokens\": 119,\n  \"truncated\": false\n}","final_result":true}}}
