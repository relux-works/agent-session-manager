{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c62d","stream":{"kind":"session","id":"01a0c88a-6674-7861-9d70-d3e79e98c472"},"sequence":369,"recorded_at":1780531400000733,"record_type":"event","durability":"durable","causation_id":"995ec337-5e4d-4fd4-a64e-ae914055ec56","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"995ec337-5e4d-4fd4-a64e-ae914055ec56","run_stream":{"kind":"run","id":"995ec337-5e4d-4fd4-a64e-ae914055ec56"},"call_id":"call_01a0c88b25c4773d941ab75e02ae2046","text":"Read text file `internal/tmuxserver/ops.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"sort\"\n8|\t\"strconv\"\n9|\t\"time\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n17|)\n18|\n19|// This file executes the three lifecycle operations the landed engine\n20|// scope refuses — attach, terminate-stale, and restore — over the same\n21|// landed gates the engine uses (transition matrix, idempotency shapes,\n22|// authorization, capability conferral, receipt and binding stores)\n23|// plus the tmux backend. The recheck loop, receipt discipline, and\n24|// error-to-observation mapping mirror the engine's second side of each\n25|// rule; the census symmetry lines name both sides.\n26|\n27|// sortedEffects copies effects into bytewise order for the wire.\n28|func sortedEffects(effects []terminalbackend.SideEffect) []terminalbackend.SideEffect {\n29|\tordered := append([]terminalbackend.SideEffect(nil), effects...)\n30|\tsort.Slice(ordered, func(i, j int) bool { return ordered[i] < ordered[j] })\n31|\treturn ordered\n32|}\n33|\n34|// sortedEvidence copies evidence IDs into bytewise order for the wire.\n35|func sortedEvidence(evidence []string) []string {\n36|\tordered := append([]string(nil), evidence...)\n37|\tsort.Strings(ordered)\n38|\treturn ordered\n39|}\n40|\n41|// attachDescriptor derives the bound attach descriptor: socket,\n42|// instance, and client joined by newlines. It is host-local (the\n43|// socket path is usable only on the responding host), deterministic,\n44|// and never persisted: the attach handler returns it without writing\n45|// it anywhere, and a dedicated test scans the stores for its bytes.\n46|// Length is bounded by construction — sun_path socket plus two UUIDs\n47|// stay two orders of magnitude below the 4096 cap — so no length arm\n48|// exists to measure; a test pins the maximum instead.\n49|func attachDescriptor(socket, instance, client string) string {\n50|\treturn socket + \"\\n\" + instance + \"\\n\" + client\n51|}\n52|\n53|// createDescriptor derives the unbound create-interactive descriptor:\n54|// socket and instance only, because create carries no client. Same\n55|// non-persistence and length properties as the bound shape.\n56|func createDescriptor(socket, instance string) string {\n57|\treturn socket + \"\\n\" + instance\n58|}\n59|\n60|// executeAttach runs one attach: closed-shape admission, deadline,\n61|// transition, landed attach authorization, capability conferral plus\n62|// the matching-transport arm, live server attestation (the P3-A\n63|// wiring: a fresh decoy admission refuses), the durable client\n64|// receipt, and the caller-executed attach vector with its descriptor.\n65|// The entry returns the vector; it never execs an interactive attach.\n66|func (lc *Lifecycle) executeAttach(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n67|\tempty := OpOutcome{Operation: terminalbackend.OperationAttach}\n68|\tbody, err := parseAttachBody(req.Body)\n69|\tif err != nil {\n70|\t\treturn empty, err\n71|\t}\n72|\tif err := checkLifecycleBackend(body.TerminalBackendID); err != nil {\n73|\t\treturn empty, err\n74|\t}\n75|\tdeadline, err := body.Deadline.Time()\n76|\tif err != nil {\n77|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body deadline\"}\n78|\t}\n79|\tif !lc.Now().Before(deadline) {\n80|\t\treturn empty, &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n81|\t}\n82|\tif _, _, err := terminalbackend.CheckTransition(string(terminalbackend.OperationAttach), req.Source, false); err != nil {\n83|\t\treturn empty, err\n84|\t}\n85|\tif err := terminalbackend.CheckAttachRequest(body.Authorization, body.Transport, body.InputAuthorized, lc.Now()); err != nil {\n86|\t\treturn empty, err\n87|\t}\n88|\tif err := terminalbackend.CheckOperation(string(terminalbackend.OperationAttach), req.Admitted); err != nil {\n89|\t\treturn empty, err\n90|\t}\n91|\tif err := checkAttachTransportCapability(body.Transport, req.Admitted); err != nil {\n92|\t\treturn empty, err\n93|\t}\n94|\tif err := lc.checkAttachQuiesced(body.TerminalInstanceID, body.InputAuthorized); err != nil {\n95|\t\treturn empty, err\n96|\t}\n97|\tif lc.ServerAdmission == nil {\n98|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle dependencies\"}\n99|\t}\n100|\tadmission, err := lc.ServerAdmission()\n101|\tif err != nil {\n102|\t\treturn empty, rowError(terminalbackend.OperationAttach, err)\n103|\t}\n104|\tif err := CheckServerAttested(admission, body.BackendGeneration); err != nil {\n105|\t\treturn empty, &Error{Code: terminalbackend.CodeUnauthorized, Detail: \"attach server attestation\"}\n106|\t}\n107|\treqBackend := lc.requestBackend(req, socket, body.SessionID, body.TerminalInstanceID)\n108|\treqBackend.operation = terminalbackend.OperationAttach\n109|\treqBackend.clientID = body.ClientID\n110|\treqBackend.transport = body.Transport\n111|\treqBackend.input = body.InputAuthorized\n112|\treqBackend.authRaw = body.AuthRaw\n113|\tevidenceID, err := reqBackend.PerformEffect(ctx, terminalbackend.EffectAttachClientCreated)\n114|\tif err != nil {\n115|\t\treturn empty, rowError(terminalbackend.OperationAttach, err)\n116|\t}\n117|\targv, err := BuildCommand(DirectiveAttachSession, CommandArgs{\n118|\t\tRuntimeDir:     lc.RuntimeDir,\n119|\t\tSocket:         socket,\n120|\t\tInstanceID:     body.TerminalInstanceID,\n121|\t\tAttachInput:    body.InputAuthorized,\n122|\t\tHasAttachInput: true,\n123|\t})\n124|\tif err != nil {\n125|\t\treturn empty, err\n126|\t}\n127|\tif err := terminalbackend.CheckAttachResult(body.InputAuthorized, body.InputAuthorized, body.Authorization); err != nil {\n128|\t\treturn empty, err\n129|\t}\n130|\t// Only an input-authorized attach adopts the active state: a\n131|\t// read-only attach is observation, and recording active for it\n132|\t// would reopen quiesced input (the quiesce barrier reads this\n133|\t// same memory, so observation must leave it untouched).\n134|\tif body.InputAuthorized {\n135|\t\t_ = lc.recordAfter(body.TerminalInstanceID, terminalbackend.StateActive)\n136|\t}\n137|\treturn OpOutcome{\n138|\t\tOperation: terminalbackend.OperationAttach,\n139|\t\tAttach: &AttachOutcome{\n140|\t\t\tClientMirrorID:  body.ClientID,\n141|\t\t\tDescriptor:      attachDescriptor(socket, body.TerminalInstanceID, body.ClientID),\n142|\t\t\tInputAuthorized: body.InputAuthorized,\n143|\t\t\tEvidenceIDs:     []string{evidenceID},\n144|\t\t},\n145|\t\tArgv: argv,\n146|\t}, nil\n147|}\n148|\n149|// checkAttachQuiesced enforces the quiesce input barrier at the\n150|// attach entry: tmux offers no session freeze (a locked session does\n151|// not lock subsequently attaching clients), so once a closure\n152|// report proves the input closed in the current incarnation, new\n153|// input-authorized attaches refuse the failed local precondition.\n154|// Read-only attaches stay admitted: quiesce stops input while\n155|// retaining observation. The incarnation-scoped closure proof is the\n156|// sole admission verdict: advisory memory, caller-carried source\n157|// state, and failure reporting are never consulted for their value\n158|// here, so none of them can reopen a closed barrier — a stale\n159|// active record, a failure result echoing its source, and a lost\n160|// state write all refuse exactly like the proof itself. Only a\n161|// fresh create or restore success reopens the input, by rotating\n162|// the incarnation the proof is scoped to. Store health still fails\n163|// closed: an unreadable state record is unknown, never admission,\n164|// so the memory read error propagates even though its value is\n165|// ignored. A proof read failure is likewise an error, never\n166|// admission: unknown is not a verdict.\n167|func (lc *Lifecycle) checkAttachQuiesced(instanceID string, inputAuthorized bool) error {\n168|\tif !inputAuthorized {\n169|\t\treturn nil\n170|\t}\n171|\tif _, _, err := lc.States.Lookup(instanceID); err != nil {\n172|\t\treturn err\n173|\t}\n174|\tproven, err := lc.States.QuiesceBarrierProven(instanceID)\n175|\tif err != nil {\n176|\t\treturn err\n177|\t}\n178|\tif proven {\n179|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"attach quiesced input\"}\n180|\t}\n181|\treturn nil\n182|}\n183|\n184|// checkAttachTransportCapability enforces the matching-transport arm:\n185|// local presentation needs local_attach, mesh presentation needs\n186|// remote_attach. The relay member never reaches here — the landed\n187|// attach authorization refuses it first — so no third arm exists.\n188|func checkAttachTransportCapability(transport string, admitted terminalbackend.Admitted) error {\n189|\tswitch transport {\n190|\tcase string(terminalbackend.TransportLocalOnly):\n191|\t\tif !admitted.Has(\"local_attach\") {\n192|\t\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n193|\t\t}\n194|\tcase string(terminalbackend.TransportTrustedPrivateMesh):\n195|\t\tif !admitted.Has(\"remote_attach\") {\n196|\t\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n197|\t\t}\n198|\tdefault:\n199|\t\treturn &Error{Code: terminalbackend.CodeProtocolError, Detail: \"presentation transport vocabulary\"}\n200|\t}\n201|\treturn nil\n202|}\n203|\n204|// executeTerminate runs one terminate-stale: closed-shape admission,\n205|// idempotency material, capability conferral plus the dual conditional,\n206|// transition, force_stale authorization, generation recheck, landed\n207|// fencing authorization, deadline, receipt discipline with\n208|// status-reconciled resume, and the kill plus close-confirm effects.\n209|func (lc *Lifecycle) executeTerminate(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n210|\tempty := OpOutcome{Operation: terminalbackend.OperationTerminateStale}\n211|\tbody, err := parseTerminateBody(req.Body)\n212|\tif err != nil {\n213|\t\treturn empty, err\n214|\t}\n215|\toperation := terminalbackend.OperationTerminateStale\n216|\tmctx := body.Context\n217|\tsource := terminalbackend.InstanceState(req.Source)\n218|\tif err := checkLifecycleBackend(mctx.TerminalBackendID); err != nil {\n219|\t\treturn empty, err\n220|\t}\n221|\tderived, err := terminalbackend.IdempotencyKey(string(operation), mctx.TerminalInstanceID, \"terminate\", body.StaleLeaseID, strconv.FormatUint(body.StaleEpoch, 10))\n222|\tif err != nil {\n223|\t\treturn empty, err\n224|\t}\n225|\tif mctx.IdempotencyKey != derived {\n226|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"idempotency key material\"}\n227|\t}\n228|\tif err := terminalbackend.CheckOperation(string(operation), req.Admitted); err != nil {\n229|\t\tfailure := rowError(operation, err)\n230|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n231|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n232|\t}\n233|\tif err := checkTerminateCapability(req.Admitted); err != nil {\n234|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n235|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n236|\t}\n237|\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), false)\n238|\tif err != nil {\n239|\t\tfailure := rowError(operation, err)\n240|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n241|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n242|\t}\n243|\tif err := terminstance.CheckAuthorization(mctx.Authorization, terminstance.AuthorizationForceStale, lc.CurrentLease(), lc.Now()); err != nil {\n244|\t\tfailure := rowError(operation, err)\n245|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n246|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n247|\t}\n248|\tif lc.CurrentGeneration() != mctx.BackendGeneration {\n249|\t\tfailure := &Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation stale\"}\n250|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n251|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n252|\t}\n253|\tif err := mapFencingError(fencing.AuthorizeTerminateStale(req.Presented, req.Winner, req.HasWinner, req.ForceRecovery, req.DiagnosticsPreserved)); err != nil {\n254|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n255|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n256|\t}\n257|\tif err := checkTerminateTarget(mctx, body, req.Presented); err != nil {\n258|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n259|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n260|\t}\n261|\tif err := checkTerminateWinner(mctx, req.Winner, lc.CurrentLease()); err != nil {\n262|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n263|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n264|\t}\n265|\tdeadline, err := mctx.Deadline.Time()\n266|\tif err != nil {\n267|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"mutation context deadline\"}\n268|\t}\n269|\tif !lc.Now().Before(deadline) {\n270|\t\tfailure := &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n271|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionReplaySame)\n272|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n273|\t}\n274|\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n275|\treqBackend.operation = operation\n276|\treqBackend.deadline = deadline\n277|\treturn lc.executeWithReceipt(ctx, req, socket, operation, mctx, source, target, effects, deadline, terminstance.AuthorizationForceStale, reqBackend, func(result terminstance.Result) OpOutcome {\n278|\t\treturn OpOutcome{Operation: operation, Mutation: &result, TargetClosed: true}\n279|\t})\n280|}\n281|\n282|// checkTerminateCapability enforces the dual conditional: stale\n283|// termination needs stale_process_termination AND\n284|// provider_process_observation. Each arm refuses alone.\n285|func checkTerminateCapability(admitted terminalbackend.Admitted) error {\n286|\tif !admitted.Has(\"stale_process_termination\") {\n287|\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n288|\t}\n289|\tif !admitted.Has(\"provider_process_observation\") {\n290|\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n291|\t}\n292|\treturn nil\n293|}\n294|\n295|// mapFencingError maps the landed terminate-stale authorization onto\n296|// the row's allowed set: malformed fencing material is the protocol\n297|// error, every other fencing refusal — no winner, no force, no\n298|// diagnostics, target mismatch, live owner — is the failed local\n299|// precondition. lease_conflict maps to the precondition too: the row\n300|// has no lease_conflict member, and a target fenced by another\n301|// session's winner fails the fenced-target precondition.\n302|func mapFencingError(err error) error {\n303|\tif err == nil {\n304|\t\treturn nil\n305|\t}\n306|\tif errors.Is(err, fencing.ErrInvalidArguments) {\n307|\t\treturn &Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminate fencing material\"}\n308|\t}\n309|\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate fencing authorization\"}\n310|}\n311|\n312|// checkTerminateTarget binds the presented fencing token to the\n313|// request: session, stale lease, and stale epoch must all agree with\n314|// the context and body. Any disagreement refuses the failed local\n315|// precondition: the retry would authorize a different target than the\n316|// key names.\n317|func checkTerminateTarget(mctx terminstance.MutationContext, body TerminateBody, presented fencing.PresentedToken) error {\n318|\tif presented.SessionID != mctx.SessionID ||\n319|\t\tpresented.LeaseID != body.StaleLeaseID ||\n320|\t\tpresented.Epoch != body.StaleEpoch {\n321|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate target binding\"}\n322|\t}\n323|\treturn nil\n324|}\n325|\n326|// checkTerminateWinner binds the caller-observed winner to the\n327|// re-read current lease: the fencing authorization decides over the\n328|// caller's winner, and only a winner that still wins authorizes. A\n329|// rotated or misobserved winner refuses the failed local\n330|// precondition; the caller re-observes and retries. Absence of a\n331|// winner never reaches here — the fencing gate refuses it first.\n332|func checkTerminateWinner(mctx terminstance.MutationContext, winner sessrepo.LeaseSummary, lease terminstance.LeaseView) error {\n333|\tif winner.SessionID != mctx.SessionID ||\n334|\t\twinner.LeaseID != lease.LeaseID ||\n335|\t\twinner.Epoch != lease.Epoch {\n336|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate winner binding\"}\n337|\t}\n338|\treturn nil\n339|}\n340|\n341|// executeRestore runs one restore: closed-shape admission, idempotency\n342|// material, capability conferral plus the reboot conditional,\n343|// transition, restore authorization, generation recheck, prior-binding\n344|// mismatch, deadline, receipt discipline with status-reconciled\n345|// resume, the persist plus wrapper-restored effects, and the required\n346|// result binding. The wire result is always parked. The backend\n347|// launches no provider: the wrapper owns launch gating through the\n348|// after-restore composition (ExecuteWrapperRestore), and this entry\n349|// only recreates the wrapper process.\n350|//\n351|// The result binding is the create-time document kept alongside the\n352|// bootstrap receipt, re-admitted by termbind on the read — within one\n353|// generation — or its minted successor across a reboot: the termbind\n354|// owner succeeds the prior (the JCS identity rule stays\n355|// termbind-private) and the successor persists under the same pair\n356|// key. The prior-binding mismatch arm proves the carried prior equals\n357|// the recorded digest; the document read proves a valid binding for\n358|// this session, instance, and backend.\n359|func (lc *Lifecycle) executeRestore(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n360|\tempty := OpOutcome{Operation: terminalbackend.OperationRestore}\n361|\tbody, err := parseRestoreBody(req.Body)\n362|\tif err != nil {\n363|\t\treturn empty, err\n364|\t}\n365|\toperation := terminalbackend.OperationRestore\n366|\tmctx := body.Context\n367|\tsource := terminalbackend.InstanceState(req.Source)\n368|\tif err := checkLifecycleBackend(mctx.TerminalBackendID); err != nil {\n369|\t\treturn empty, err\n370|\t}\n371|\tderived, err := terminalbackend.IdempotencyKey(string(operation), mctx.SessionID, body.BootstrapOperationID)\n372|\tif err != nil {\n373|\t\treturn empty, err\n374|\t}\n375|\tif mctx.IdempotencyKey != derived {\n376|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"idempotency key material\"}\n377|\t}\n378|\tif err := terminalbackend.CheckOperation(string(operation), req.Admitted); err != nil {\n379|\t\tfailure := rowError(operation, err)\n380|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n381|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n382|\t}\n383|\tif !req.Admitted.Has(\"reboot_restoration\") {\n384|\t\tfailure := &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n385|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n386|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n387|\t}\n388|\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), false)\n389|\tif err != nil {\n390|\t\tfailure := rowError(operation, err)\n391|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n392|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n393|\t}\n394|\tif err := terminstance.CheckAuthorization(mctx.Authorization, terminstance.AuthorizationRestore, lc.CurrentLease(), lc.Now()); err != nil {\n395|\t\tfailure := rowError(operation, err)\n396|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n397|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n398|\t}\n399|\tif lc.CurrentGeneration() != mctx.BackendGeneration {\n400|\t\tfailure := &Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation stale\"}\n401|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n402|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n403|\t}\n404|\tif err := lc.checkPriorBinding(body); err != nil {\n405|\t\tvar local *Error\n406|\t\tif errors.As(err, &local) && local.Code == terminalbackend.CodeRestoreMismatch {\n407|\t\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n408|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n409|\t\t}\n410|\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n411|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n412|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n413|\t}\n414|\tdeadline, err := mctx.Deadline.Time()\n415|\tif err != nil {\n416|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"mutation context deadline\"}\n417|\t}\n418|\tif !lc.Now().Before(deadline) {\n419|\t\tfailure := &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n420|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionReplaySame)\n421|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n422|\t}\n423|\t// The prior binding validates before the receipt binds and the\n424|\t// wrapper recreates: a missing, corrupt, or disagreeing prior\n425|\t// refuses here, never after the irreversible effects.\n426|\tif _, err := lc.readRestorePrior(mctx, body); err != nil {\n427|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n428|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n429|\t}\n430|\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n431|\treqBackend.operation = operation\n432|\treqBackend.bootstrapID = body.BootstrapOperationID\n433|\t// The persist effect replays the recorded pair receipt (verified\n434|\t// by the mismatch arm above); the candidate carries the matched\n435|\t// prior digest so the store admits its shape on the replay path.\n436|\treqBackend.bindingID = body.PriorBindingID\n437|\toutcome, err := lc.executeWithReceipt(ctx, req, socket, operation, mctx, source, target, effects, deadline, terminstance.AuthorizationRestore, reqBackend, func(result terminstance.Result) OpOutcome {\n438|\t\treturn OpOutcome{Operation: operation, Mutation: &result, PriorBindingID: body.PriorBindingID, RestoredParked: true}\n439|\t})\n440|\tif err != nil {\n441|\t\treturn outcome, err\n442|\t}\n443|\tbinding, err := lc.restoreBinding(mctx, body)\n444|\tif err != nil {\n445|\t\treturn outcome, err\n446|\t}\n447|\toutcome.Binding = binding\n448|\treturn outcome, nil\n449|}\n450|\n451|// readRestorePrior reads the create-time binding document kept under\n452|// the (session, bootstrap) pair, re-admitted by the termbind owner,\n453|// and proves it names this restore's session, instance, and backend.\n454|// Generation is not compared here: after a reboot the restore carries\n455|// the new server generation while the prior still names the old one,\n456|// and succession (not agreement) resolves that drift. A missing\n457|// document is the backend store failure — the receipt proved the\n458|// prior, but the payload is gone, so the required result cannot be\n459|// built. A document that fails termbind admission, or that names\n460|// another session, instance, or backend than the mutation context, is\n461|// the integrity failure: the store disagrees with the receipt it\n462|// stands beside.\n463|func (lc *Lifecycle) readRestorePrior(mctx terminstance.MutationContext, body RestoreBody) (termbind.Binding, error) {\n464|\tempty := termbind.Binding{}\n465|\tdoc, found, err := lc.States.LookupBindingDoc(mctx.SessionID, body.BootstrapOperationID)\n466|\tif err != nil {\n467|\t\treturn empty, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n468|\t}\n469|\tif !found {\n470|\t\treturn empty, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n471|\t}\n472|\tbinding, err := termbind.ParseTerminalBinding(doc)\n473|\tif err != nil {\n474|\t\treturn empty, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n475|\t}\n476|\tif binding.SessionID != mctx.SessionID ||\n477|\t\tbinding.TerminalInstanceID != mctx.TerminalInstanceID ||\n478|\t\tbinding.TerminalBackendID != mctx.TerminalBackendID {\n479|\t\treturn empty, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n480|\t}\n481|\treturn binding, nil\n482|}\n483|\n484|// restoreBinding builds the required restore result binding after the\n485|// effects commit. Within one generation the prior is the result: the\n486|// re-admitted create-time document the pre-effects validation already\n487|// proved. Across a reboot the mutation context carries the new server\n488|// generation, and the result is the minted successor: the termbind\n489|// owner succeeds the prior (new generation, supersedes link, fresh\n490|// identity), the successor persists under the same pair key, and the\n491|// same successor returns. The mint is deterministic, so a retry after\n492|// a crash between the effects and the persist converges on the\n493|// identical document instead of forking, and a retry after the\n494|// persist replays the stored successor without minting again.\n495|func (lc *Lifecycle) restoreBinding(mctx terminstance.MutationContext, body RestoreBody) (*termbind.Binding, error) {\n496|\tprior, err := lc.readRestorePrior(mctx, body)\n497|\tif err != nil {\n498|\t\treturn nil, err\n499|\t}\n500|\tif prior.BackendGeneration == mctx.BackendGeneration {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
