{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c65f","stream":{"kind":"session","id":"01a0c88a-6674-7861-9d70-d3e79e98c472"},"sequence":394,"recorded_at":1780531400000783,"record_type":"event","durability":"durable","causation_id":"995ec337-5e4d-4fd4-a64e-ae914055ec56","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"995ec337-5e4d-4fd4-a64e-ae914055ec56","run_stream":{"kind":"run","id":"995ec337-5e4d-4fd4-a64e-ae914055ec56"},"task_stream":{"kind":"task","id":"01a0c88b-359e-78e1-b548-ae2f20d48a09"},"task_id":"01a0c88b-359e-78e1-b548-ae2f20d48a09","event":{"kind":"output","task_id":"01a0c88b-359e-78e1-b548-ae2f20d48a09","chunk":"Read text file `internal/tmuxserver/lifecycle.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"time\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n14|)\n15|\n16|// Lifecycle executes the eight tmux lifecycle operations — create,\n17|// attach, status, quiesce-input, wait-safe-boundary, request-stop,\n18|// terminate-stale, restore — over the structured commands. Five\n19|// operations (create, quiesce-input, wait-safe-boundary, request-stop,\n20|// status) delegate to the landed terminstance engine with the tmux\n21|// backend; attach, terminate-stale, and restore — which the engine\n22|// scope gate refuses — execute here over the same landed gates\n23|// (transition matrix, idempotency shapes, authorization, capability\n24|// conferral, receipt and binding stores) plus the tmux backend.\n25|//\n26|// A Lifecycle is constructed whole: every store and function value is\n27|// required (except Sleep/PollInterval, which default, and\n28|// ServerAdmission, which only attach needs). The Execute entry refuses\n29|// before any work when a dependency is missing.\n30|type Lifecycle struct {\n31|\t// RuntimeDir is the tmux runtime directory (<root>/tmux) the\n32|\t// socket derives from.\n33|\tRuntimeDir string\n34|\t// Root is the Runtime IPC root the socket custody verifies.\n35|\tRoot string\n36|\t// Platform selects the sun_path limit.\n37|\tPlatform scalar.Platform\n38|\t// Runner executes the tmux commands.\n39|\tRunner Runner\n40|\t// Receipts is the durable idempotency receipt table.\n41|\tReceipts *terminstance.ReceiptStore\n42|\t// Bindings is the durable bootstrap binding store.\n43|\tBindings *axpane.Store\n44|\t// Attach is the durable attach-client receipt store.\n45|\tAttach *termbind.AttachStore\n46|\t// States is the durable AX-side state memory.\n47|\tStates *InstanceStates\n48|\t// CurrentLease and CurrentGeneration re-read the winning lease\n49|\t// and the validated binding generation at every check point.\n50|\tCurrentLease      func() terminstance.LeaseView\n51|\tCurrentGeneration func() string\n52|\t// Now is the clock.\n53|\tNow func() time.Time\n54|\t// Sleep waits between close-confirm polls. Nil means time.Sleep.\n55|\tSleep func(time.Duration)\n56|\t// PollInterval separates close-confirm polls. Non-positive means\n57|\t// 50 milliseconds.\n58|\tPollInterval time.Duration\n59|\t// ServerAdmission reports the live server attestation the attach\n60|\t// handler binds to the request generation (the P3-A wiring: a\n61|\t// fresh decoy admission refuses here). Nil refuses attach only.\n62|\tServerAdmission func() (RealmAdmission, error)\n63|\t// LocalHostID is the AX host identity the after-restore\n64|\t// composition compares the winning lease holder against. Empty\n65|\t// cannot prove a local win, so the composition parks or offers\n66|\t// remote attach only, never resumes.\n67|\tLocalHostID string\n68|\t// LeaseRefresh attempts the §4.2 mesh lease refresh\n69|\t// (after-restore step 2) under a timeout context. Nil skips the\n70|\t// attempt; a failed attempt also falls back to local knowledge.\n71|\t// Only a successful refresh verifies: the fallback decides\n72|\t// unverified, so it parks instead of resuming.\n73|\tLeaseRefresh func(ctx context.Context, sessionID string) (RefreshWinner, error)\n74|\t// MeshRefreshTimeout bounds one refresh attempt. Non-positive\n75|\t// means DefaultMeshRefreshTimeout. The bound is enforced, not\n76|\t// advisory: the entry returns at the deadline even against an\n77|\t// adapter that ignores cancellation, and a late answer never\n78|\t// verifies.\n79|\tMeshRefreshTimeout time.Duration\n80|\t// Hooks observes receipts and effects. Nil disables observation.\n81|\tHooks *terminstance.EngineHooks\n82|\t// RefreshHooks arms the race boundary of the refresh select.\n83|\t// Nil in production.\n84|\tRefreshHooks *RefreshHooks\n85|}\n86|\n87|// RefreshHooks arms the race boundary of the mesh lease refresh:\n88|// BeforeSelect runs after the adapter launches and before the entry\n89|// selects over the answer and the deadline. A nil hook is a no-op.\n90|// Tests stall past the bound to force the both-ready race\n91|// deterministically: without the stall the deadline arm always wins\n92|// and the answer-path expiry check never triggers.\n93|type RefreshHooks struct {\n94|\tBeforeSelect func()\n95|}\n96|\n97|// DefaultMeshRefreshTimeout bounds the after-restore mesh lease\n98|// refresh when the Lifecycle leaves it unset: five seconds, after\n99|// which the branch proceeds on local knowledge instead of blocking\n100|// forever.\n101|const DefaultMeshRefreshTimeout = 5 * time.Second\n102|\n103|// RefreshWinner is one mesh lease-refresh answer: the winning lease\n104|// tuple and its holder host.\n105|type RefreshWinner struct {\n106|\tLeaseID      string\n107|\tEpoch        uint64\n108|\tHolderHostID string\n109|}\n110|\n111|// OpRequest is one lifecycle operation request: the operation name,\n112|// its closed body, the presented source state, the admitted\n113|// capabilities, and the fencing material (for terminate-stale only).\n114|type OpRequest struct {\n115|\tOperation            string\n116|\tBody                 []byte\n117|\tSource               string\n118|\tAdmitted             terminalbackend.Admitted\n119|\tPresented            fencing.PresentedToken\n120|\tWinner               sessrepo.LeaseSummary\n121|\tHasWinner            bool\n122|\tForceRecovery        bool\n123|\tDiagnosticsPreserved bool\n124|}\n125|\n126|// AttachOutcome is the attach success payload: the client mirror, the\n127|// host-local descriptor, the authorized input boolean, and the\n128|// evidence. The result input boolean always equals the request and the\n129|// authorization; the landed CheckAttachResult proves it on every call.\n130|type AttachOutcome struct {\n131|\tClientMirrorID  string\n132|\tDescriptor      string\n133|\tInputAuthorized bool\n134|\tEvidenceIDs     []string\n135|}\n136|\n137|// OpOutcome is one executed operation: exactly one of Mutation,\n138|// Status, or Attach is set, plus the per-operation success members.\n139|// Mutation is set on every executed mutating path — success and\n140|// coded failure alike, mirroring the engine — and nil only when the\n141|// request was malformed before any result existed.\n142|type OpOutcome struct {\n143|\tOperation              terminalbackend.Operation\n144|\tMutation               *terminstance.Result\n145|\tStatus                 *terminstance.StatusReport\n146|\tAttach                 *AttachOutcome\n147|\tArgv                   []string\n148|\tBinding                *termbind.Binding\n149|\tDescriptor             *string\n150|\tPriorBindingID         string\n151|\tRestoredParked         bool\n152|\tTargetClosed           bool\n153|\tProcessClosed          bool\n154|\tStoreClosed            bool\n155|\tQuiescenceGeneration   string\n156|\tInputClosedAt          string\n157|\tSafeBoundaryEvidenceID string\n158|\tBoundaryObservedAt     string\n159|}\n160|\n161|// Execute runs one lifecycle operation to its outcome. Refusals\n162|// precede side effects: malformed operations, unknown backends, and\n163|// unsafe sockets refuse before any store or tmux interaction. The\n164|// socket custody (before-connect rejection) and length refusal run on\n165|// every operation, because every operation connects.\n166|func (lc *Lifecycle) Execute(ctx context.Context, req OpRequest) (OpOutcome, error) {\n167|\tempty := OpOutcome{}\n168|\tif lc == nil || lc.Runner == nil || lc.Receipts == nil || lc.Bindings == nil ||\n169|\t\tlc.Attach == nil || lc.States == nil ||\n170|\t\tlc.CurrentLease == nil || lc.CurrentGeneration == nil || lc.Now == nil {\n171|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle dependencies\"}\n172|\t}\n173|\toperation, err := terminalbackend.ParseOperation(req.Operation)\n174|\tif err != nil {\n175|\t\treturn empty, err\n176|\t}\n177|\tif _, err := DirectivesFor(operation); err != nil {\n178|\t\treturn empty, err\n179|\t}\n180|\tsocket := SocketPath(lc.RuntimeDir)\n181|\tif err := CheckSocketLength(socket, lc.Platform); err != nil {\n182|\t\treturn empty, err\n183|\t}\n184|\tif err := CheckSocketCustody(socket, lc.Root, lc.Platform); err != nil {\n185|\t\treturn empty, err\n186|\t}\n187|\tswitch operation {\n188|\tcase terminalbackend.OperationCreate:\n189|\t\treturn lc.executeCreate(ctx, req, socket)\n190|\tcase terminalbackend.OperationAttach:\n191|\t\treturn lc.executeAttach(ctx, req, socket)\n192|\tcase terminalbackend.OperationStatus:\n193|\t\treturn lc.executeStatus(ctx, req, socket)\n194|\tcase terminalbackend.OperationQuiesceInput:\n195|\t\treturn lc.executeEngineOp(ctx, req, socket, operation)\n196|\tcase terminalbackend.OperationWaitSafeBoundary:\n197|\t\treturn lc.executeEngineOp(ctx, req, socket, operation)\n198|\tcase terminalbackend.OperationRequestStop:\n199|\t\treturn lc.executeEngineOp(ctx, req, socket, operation)\n200|\tcase terminalbackend.OperationTerminateStale:\n201|\t\treturn lc.executeTerminate(ctx, req, socket)\n202|\tcase terminalbackend.OperationRestore:\n203|\t\treturn lc.executeRestore(ctx, req, socket)\n204|\tdefault:\n205|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle operation\"}\n206|\t}\n207|}\n208|\n209|// engineFor builds the per-call landed engine over a request-scoped\n210|// tmux backend. The engine is a plain struct: constructing one per\n211|// call keeps request identity out of shared state.\n212|func (lc *Lifecycle) engineFor(reqBackend *backend) *terminstance.Engine {\n213|\treturn &terminstance.Engine{\n214|\t\tStore:             lc.Receipts,\n215|\t\tBackend:           reqBackend,\n216|\t\tCurrentLease:      lc.CurrentLease,\n217|\t\tCurrentGeneration: lc.CurrentGeneration,\n218|\t\tNow:               lc.Now,\n219|\t\tHooks:             lc.Hooks,\n220|\t}\n221|}\n222|\n223|// requestBackend builds the request-scoped tmux backend over the\n224|// lifecycle stores and the admitted set.\n225|func (lc *Lifecycle) requestBackend(req OpRequest, socket, session, instance string) *backend {\n226|\tsleep := lc.Sleep\n227|\tif sleep == nil {\n228|\t\tsleep = time.Sleep\n229|\t}\n230|\tpoll := lc.PollInterval\n231|\tif poll <= 0 {\n232|\t\tpoll = 50 * time.Millisecond\n233|\t}\n234|\treturn &backend{\n235|\t\trunner:     lc.Runner,\n236|\t\truntimeDir: lc.RuntimeDir,\n237|\t\tsocket:     socket,\n238|\t\tsessionID:  session,\n239|\t\tinstanceID: instance,\n240|\t\tnow:        lc.Now,\n241|\t\tsleep:      sleep,\n242|\t\tpoll:       poll,\n243|\t\tadmitted:   req.Admitted,\n244|\t\tbindings:   lc.Bindings,\n245|\t\tattach:     lc.Attach,\n246|\t\tstates:     lc.States,\n247|\t\tkillExit:   -1,\n248|\t}\n249|}\n250|\n251|// recordAfter records the adopted after-state in the AX-side memory on\n252|// success paths. The memory is advisory everywhere: status\n253|// reconciles the live probe against it, but attach admission never\n254|// consults it — only the incarnation-scoped closure proof decides\n255|// admission, so a stale or lost memory record can neither reopen a\n256|// closed barrier nor close an open one. On the barrier successes\n257|// (quiesce-input and wait-safe-boundary) the caller still checks the\n258|// returned error and fails closed, keeping the status memory\n259|// faithful to the closure the operation just proved.\n260|func (lc *Lifecycle) recordAfter(instance string, after terminalbackend.InstanceState) error {\n261|\tif lc.States == nil {\n262|\t\treturn nil\n263|\t}\n264|\treturn lc.States.Record(instance, after)\n265|}\n266|\n267|// recordFailure records the after-state of a failed operation. A\n268|// failure with committed effects and an uncertain tail (After\n269|// unavailable) overwrites with the honest unknown: the prior record\n270|// no longer describes the instance. A pure refusal proves nothing —\n271|// its After echoes the caller-carried source — so it installs that\n272|// echo only when the memory holds no record at all (letting the\n273|// uncertain-resume path reconcile a first-operation failure) and\n274|// never overwrites an authoritative record with stale caller state.\n275|// Failure reporting can never reopen a closed barrier: attach\n276|// admission never consults this memory, and a refusal either\n277|// preserves the prior record, installs a first echo, or records the\n278|// non-admitting unknown.\n279|func (lc *Lifecycle) recordFailure(instance string, after terminalbackend.InstanceState) {\n280|\tif lc.States == nil {\n281|\t\treturn\n282|\t}\n283|\tif after == terminalbackend.StateUnavailable {\n284|\t\t_ = lc.recordAfter(instance, after)\n285|\t\treturn\n286|\t}\n287|\t_, found, err := lc.States.Lookup(instance)\n288|\tif err != nil || found {\n289|\t\treturn\n290|\t}\n291|\t_ = lc.recordAfter(instance, after)\n292|}\n293|\n294|// mutationResult assembles a lifecycle result with the engine's\n295|// buildResult contract: repeated request identities, before/after\n296|// states, bytewise-sorted effects and evidence, and one disposition.\n297|func mutationResult(mctx terminstance.MutationContext, before, after terminalbackend.InstanceState, effects []terminalbackend.SideEffect, evidence []string, disposition terminstance.RetryDisposition) terminstance.Result {\n298|\treturn terminstance.Result{\n299|\t\tOperationID:           mctx.OperationID,\n300|\t\tSessionID:             mctx.SessionID,\n301|\t\tTerminalInstanceID:    mctx.TerminalInstanceID,\n302|\t\tTerminalBackendID:     mctx.TerminalBackendID,\n303|\t\tImplementationVersion: mctx.ImplementationVersion,\n304|\t\tProtocolVersion:       mctx.ProtocolVersion,\n305|\t\tBackendGeneration:     mctx.BackendGeneration,\n306|\t\tBefore:                before,\n307|\t\tAfter:                 after,\n308|\t\tEffects:               sortedEffects(effects),\n309|\t\tEvidenceIDs:           sortedEvidence(evidence),\n310|\t\tDisposition:           disposition,\n311|\t}\n312|}\n313|\n314|// checkLifecycleBackend admits exactly the tmux backend identity: this\n315|// lifecycle executes for ax.tmux and no other backend. A request\n316|// naming any other backend refuses the failed local precondition,\n317|// never executes against the wrong backend.\n318|func checkLifecycleBackend(backendID string) error {\n319|\tif backendID != terminalbackend.BuiltinTmux {\n320|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"lifecycle backend\"}\n321|\t}\n322|\treturn nil\n323|}\n324|\n325|// checkBindingAgreement binds the create binding to its mutation\n326|// context: session, instance, backend, and generation must all agree.\n327|// Any disagreement refuses the failed local precondition: the binding\n328|// names another creation.\n329|func checkBindingAgreement(body CreateBody) error {\n330|\tif body.Binding.SessionID != body.Context.SessionID ||\n331|\t\tbody.Binding.TerminalInstanceID != body.Context.TerminalInstanceID ||\n332|\t\tbody.Binding.TerminalBackendID != body.Context.TerminalBackendID ||\n333|\t\tbody.Binding.BackendGeneration != body.Context.BackendGeneration {\n334|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"create binding agreement\"}\n335|\t}\n336|\treturn nil\n337|}\n338|\n339|// rowError normalizes a backend- or store-reported code against one\n340|// operation's allowed set: an in-row code propagates with its report,\n341|// while an outside-set code is itself refused as the protocol error —\n342|// the engine's CheckErrorAllowed arm, mirrored for the operations the\n343|// engine scope leaves out.\n344|func rowError(operation terminalbackend.Operation, err error) error {\n345|\tcode := backendErrorCode(err)\n346|\tif code == \"\" {\n347|\t\treturn err\n348|\t}\n349|\tif checkErr := terminalbackend.CheckErrorAllowed(string(operation), code); checkErr != nil {\n350|\t\treturn &Error{Code: terminalbackend.CodeProtocolError, Detail: \"operation error vocabulary\"}\n351|\t}\n352|\treturn err\n353|}\n354|\n355|// formatTimestamp renders Now in the scalar timestamp grammar: UTC\n356|// RFC3339 with millisecond precision, always carrying the fractional\n357|// digits the grammar requires.\n358|func formatTimestamp(now time.Time) string {\n359|\treturn now.UTC().Format(\"2006-01-02T15:04:05.000Z07:00\")\n360|}\n361|\n362|// executeCreate runs the full create body: closed-shape admission,\n363|// backend and transport gates, binding agreement, then the landed\n364|// engine with the tmux backend. The result echoes the carried binding\n365|// and, exactly when interactive, the unbound attach descriptor.\n366|func (lc *Lifecycle) executeCreate(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n367|\tempty := OpOutcome{Operation: terminalbackend.OperationCreate}\n368|\tbody, err := parseCreateBody(req.Body)\n369|\tif err != nil {\n370|\t\treturn empty, err\n371|\t}\n372|\tif err := checkLifecycleBackend(body.Context.TerminalBackendID); err != nil {\n373|\t\treturn empty, err\n374|\t}\n375|\tif body.Transport == string(terminalbackend.TransportThirdPartyRelay) {\n376|\t\treturn empty, &Error{Code: terminalbackend.CodeUnauthorized, Detail: \"create relay transport\"}\n377|\t}\n378|\tif err := checkBindingAgreement(body); err != nil {\n379|\t\treturn empty, err\n380|\t}\n381|\treqBackend := lc.requestBackend(req, socket, body.Context.SessionID, body.Context.TerminalInstanceID)\n382|\treqBackend.operation = terminalbackend.OperationCreate\n383|\treqBackend.bootstrapID = body.BootstrapOperationID\n384|\treqBackend.bindingID = body.Binding.BindingID\n385|\treqBackend.bindingDoc = append([]byte(nil), body.BindingRaw...)\n386|\t_, completedBefore, err := lc.Receipts.Completed(body.Context.IdempotencyKey)\n387|\tif err != nil {\n388|\t\treturn empty, &Error{Code: terminstance.CodeProcessFailed, Detail: \"idempotency store failure\"}\n389|\t}\n390|\tresult, err := lc.engineFor(reqBackend).ExecuteMutating(ctx, terminalbackend.OperationCreate, body.Context, terminstance.Params{\n391|\t\tBootstrapOperationID: body.BootstrapOperationID,\n392|\t\tInteractive:          body.Interactive,\n393|\t}, terminalbackend.InstanceState(req.Source), req.Admitted)\n394|\toutcome := OpOutcome{Operation: terminalbackend.OperationCreate, Binding: &body.Binding}\n395|\tif result.OperationID != \"\" {\n396|\t\toutcome.Mutation = &result\n397|\t\tif err != nil {\n398|\t\t\tlc.recordFailure(body.Context.TerminalInstanceID, result.After)\n399|\t\t} else {\n400|\t\t\t_ = lc.recordAfter(body.Context.TerminalInstanceID, result.After)\n401|\t\t}\n402|\t}\n403|\tif err != nil {\n404|\t\treturn outcome, err\n405|\t}\n406|\tif !completedBefore {\n407|\t\t// A fresh create success opens a new incarnation: prior\n408|\t\t// closure reports are superseded, so the new\n409|\t\t// incarnation's input starts open. Replays skip the\n410|\t\t// rotation — replaying an old success must not erase a\n411|\t\t// newer closure — and a failed rotation fails the\n412|\t\t// operation closed: the incarnation keeps its prior\n413|\t\t// value, prior proofs stay valid, and recovery is a\n414|\t\t// fresh create or restore.\n415|\t\tif err := lc.States.RecordIncarnation(body.Context.TerminalInstanceID, body.Context.IdempotencyKey); err != nil {\n416|\t\t\treturn outcome, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"create incarnation image\"}\n417|\t\t}\n418|\t}\n419|\tif body.Interactive {\n420|\t\tdescriptor := createDescriptor(socket, body.Context.TerminalInstanceID)\n421|\t\toutcome.Descriptor = &descriptor\n422|\t}\n423|\treturn outcome, nil\n424|}\n425|\n426|// executeStatus runs one status query through the landed engine with\n427|// the tmux backend: no receipt, no side effects, no authorization.\n428|func (lc *Lifecycle) executeStatus(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n429|\tempty := OpOutcome{Operation: terminalbackend.OperationStatus}\n430|\tbody, err := terminstance.ParseStatusBody(req.Body)\n431|\tif err != nil {\n432|\t\treturn empty, err\n433|\t}\n434|\tif err := checkLifecycleBackend(body.TerminalBackendID); err != nil {\n435|\t\treturn empty, err\n436|\t}\n437|\tinstance := body.TerminalInstanceID\n438|\tif !body.HasTerminalInstanceID {\n439|\t\tinstance = \"\"\n440|\t}\n441|\treqBackend := lc.requestBackend(req, socket, body.SessionID, instance)\n442|\treqBackend.operation = terminalbackend.OperationStatus\n443|\treport, err := lc.engineFor(reqBackend).ExecuteStatus(ctx, body, terminalbackend.InstanceState(req.Source), req.Admitted)\n444|\tif err != nil {\n445|\t\treturn empty, err\n446|\t}\n447|\treturn OpOutcome{Operation: terminalbackend.OperationStatus, Status: &report}, nil\n448|}\n449|\n450|// executeEngineOp runs one quiesce-input, wait-safe-boundary, or\n451|// request-stop body through the landed engine with the tmux backend,\n452|// adding the per-operation success members the engine's receipt scope\n453|// leaves out.\n454|func (lc *Lifecycle) executeEngineOp(ctx context.Context, req OpRequest, socket string, operation terminalbackend.Operation) (OpOutcome, error) {\n455|\tempty := OpOutcome{Operation: operation}\n456|\tmctx, params, err := terminstance.ParseOperationBody(string(operation), req.Body)\n457|\tif err != nil {\n458|\t\treturn empty, err\n459|\t}\n460|\tif err := checkLifecycleBackend(mctx.TerminalBackendID); err != nil {\n461|\t\treturn empty, err\n462|\t}\n463|\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n464|\treqBackend.operation = operation\n465|\tswitch operation {\n466|\tcase terminalbackend.OperationWaitSafeBoundary:\n467|\t\treqBackend.quiescence = params.QuiescenceGeneration\n468|\t\treqBackend.channel = BoundaryChannelPrefix + params.QuiescenceGeneration\n469|\t\treqBackend.proofKind = params.ProviderProofKind\n470|\t\twaitCtx, cancel := lc.boundWait(ctx, mctx, params.TimeoutMs)\n471|\t\tdefer cancel()\n472|\t\treqBackend.waitCtx = waitCtx\n473|\tcase terminalbackend.OperationRequestStop:\n474|\t\treqBackend.deadline = lc.lesserDeadline(mctx, params.GracefulTimeoutMs)\n475|\t}\n476|\tresult, err := lc.engineFor(reqBackend).ExecuteMutating(ctx, operation, mctx, params, terminalbackend.InstanceState(req.Source), req.Admitted)\n477|\toutcome := OpOutcome{Operation: operation}\n478|\tif result.OperationID != \"\" {\n479|\t\toutcome.Mutation = &result\n480|\t\tif err != nil {\n481|\t\t\t// Failure results record only the honest\n482|\t\t\t// unknown: a pure refusal writes nothing\n483|\t\t\t// instead of overwriting an authoritative\n484|\t\t\t// record with stale caller state.\n485|\t\t\tlc.recordFailure(mctx.TerminalInstanceID, result.After)\n486|\t\t} else if operation != terminalbackend.OperationQuiesceInput && operation != terminalbackend.OperationWaitSafeBoundary {\n487|\t\t\t// Non-barrier successes record best-effort:\n488|\t\t\t// the memory is advisory and a lost write\n489|\t\t\t// never admits input.\n490|\t\t\t_ = lc.recordAfter(mctx.TerminalInstanceID, result.After)\n491|\t\t}\n492|\t\t// Barrier successes record below, checked, after the\n493|\t\t// outcome report commits: the report carries the closure\n494|\t\t// time the retry replays and the incarnation-scoped\n495|\t\t// proof the attach entry enforces, and the memory\n496|\t\t// carries the closure status reconciles against.\n497|\t}\n498|\tif err != nil {\n499|\t\treturn outcome, err\n500|\t}\n(more lines below)","final_result":true}}}
