{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ca17","stream":{"kind":"session","id":"01a0c88a-6674-7861-9d70-d3e79e98c472"},"sequence":870,"recorded_at":1780531400001735,"record_type":"event","durability":"durable","causation_id":"995ec337-5e4d-4fd4-a64e-ae914055ec56","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"995ec337-5e4d-4fd4-a64e-ae914055ec56","run_stream":{"kind":"run","id":"995ec337-5e4d-4fd4-a64e-ae914055ec56"},"task_stream":{"kind":"task","id":"01a0c891-3cd7-7600-95f9-75eb27514a95"},"task_id":"01a0c891-3cd7-7600-95f9-75eb27514a95","event":{"kind":"output","task_id":"01a0c891-3cd7-7600-95f9-75eb27514a95","chunk":"Read text file `internal/tmuxserver/lifecycle_test.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"os\"\n6|\t\"path/filepath\"\n7|\t\"strings\"\n8|\t\"testing\"\n9|\t\"time\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n14|)\n15|\n16|// lifecycleShell builds a Lifecycle with temp stores for portable\n17|// dispatch tests: custody never passes here, so only pre-custody arms\n18|// are reachable (dependencies, vocabulary, scope, length).\n19|func lifecycleShell(t *testing.T) *Lifecycle {\n20|\tt.Helper()\n21|\treceipts, err := terminstance.OpenReceiptStore(t.TempDir())\n22|\tif err != nil {\n23|\t\tt.Fatal(err)\n24|\t}\n25|\tbindings, err := testAxpaneStore(t)\n26|\tif err != nil {\n27|\t\tt.Fatal(err)\n28|\t}\n29|\tattach, err := testAttachStore(t)\n30|\tif err != nil {\n31|\t\tt.Fatal(err)\n32|\t}\n33|\tstates, err := OpenInstanceStates(t.TempDir())\n34|\tif err != nil {\n35|\t\tt.Fatal(err)\n36|\t}\n37|\t// Short shared root (never the test-temp dir: its socket path\n38|\t// exceeds sun_path on macOS). The leaf stays absent by design.\n39|\troot := filepath.Join(os.TempDir(), \"axshell\")\n40|\tif err := os.MkdirAll(root, 0o755); err != nil {\n41|\t\tt.Fatal(err)\n42|\t}\n43|\treturn &Lifecycle{\n44|\t\tRuntimeDir: root + \"/tmux\",\n45|\t\tRoot:       root,\n46|\t\tPlatform:   scalar.PlatformMacOS,\n47|\t\tRunner:     newFakeRunner(),\n48|\t\tReceipts:   receipts,\n49|\t\tBindings:   bindings,\n50|\t\tAttach:     attach,\n51|\t\tStates:     states,\n52|\t\tCurrentLease: func() terminstance.LeaseView {\n53|\t\t\treturn terminstance.LeaseView{LeaseID: lxLease, Epoch: 7}\n54|\t\t},\n55|\t\tCurrentGeneration: func() string { return lxGeneration },\n56|\t\tNow:               lxNow,\n57|\t}\n58|}\n59|\n60|func TestExecuteRefusesUnknownOperation(t *testing.T) {\n61|\tlc := lifecycleShell(t)\n62|\tif _, err := lc.Execute(context.Background(), OpRequest{Operation: \"suspend\"}); err == nil {\n63|\t\tt.Fatal(\"unknown operation admitted\")\n64|\t} else {\n65|\t\trequireLandedCode(t, err, \"terminal_backend_protocol_error\")\n66|\t}\n67|}\n68|\n69|func TestExecuteRefusesNonLifecycleScope(t *testing.T) {\n70|\tlc := lifecycleShell(t)\n71|\tfor _, operation := range []string{\"manifest\", \"probe\"} {\n72|\t\tif _, err := lc.Execute(context.Background(), OpRequest{Operation: operation}); err == nil {\n73|\t\t\tt.Fatalf(\"%s admitted to lifecycle\", operation)\n74|\t\t} else {\n75|\t\t\trequireLocalCode(t, err, \"terminal_backend_protocol_error\", \"lifecycle operation\")\n76|\t\t}\n77|\t}\n78|}\n79|\n80|func TestExecuteRefusesMissingDependencies(t *testing.T) {\n81|\tlc := lifecycleShell(t)\n82|\tlc.Runner = nil\n83|\tif _, err := lc.Execute(context.Background(), OpRequest{Operation: \"status\"}); err == nil {\n84|\t\tt.Fatal(\"nil runner admitted\")\n85|\t} else {\n86|\t\trequireLocalCode(t, err, \"terminal_backend_protocol_error\", \"lifecycle dependencies\")\n87|\t}\n88|\tvar nilLifecycle *Lifecycle\n89|\tif _, err := nilLifecycle.Execute(context.Background(), OpRequest{}); err == nil {\n90|\t\tt.Fatal(\"nil lifecycle admitted\")\n91|\t} else {\n92|\t\trequireLocalCode(t, err, \"terminal_backend_protocol_error\", \"lifecycle dependencies\")\n93|\t}\n94|}\n95|\n96|func TestExecuteRefusesLongSocket(t *testing.T) {\n97|\tlc := lifecycleShell(t)\n98|\tlc.RuntimeDir = \"/root/\" + strings.Repeat(\"d\", 200)\n99|\tif _, err := lc.Execute(context.Background(), OpRequest{Operation: \"status\", Body: lxStatusBody(t, true, false, nil)}); err == nil {\n100|\t\tt.Fatal(\"overlong socket admitted\")\n101|\t} else {\n102|\t\trequireLocalCode(t, err, \"tmux_socket_path_too_long\", \"socket path length\")\n103|\t}\n104|}\n105|\n106|func TestExecuteRefusesAtLimitSocket(t *testing.T) {\n107|\t// The length pre-gate is strict-below on every operation: a socket\n108|\t// at exactly the platform limit refuses before custody, which\n109|\t// would refuse the same requests with the absence verdict.\n110|\tfor _, operation := range []string{\"create\", \"attach\", \"status\", \"quiesce-input\", \"wait-safe-boundary\", \"request-stop\", \"terminate-stale\", \"restore\"} {\n111|\t\tt.Run(operation, func(t *testing.T) {\n112|\t\t\tlc := lifecycleShell(t)\n113|\t\t\tlc.RuntimeDir = \"/root/\" + strings.Repeat(\"d\", 90)\n114|\t\t\tif _, err := lc.Execute(context.Background(), OpRequest{Operation: operation}); err == nil {\n115|\t\t\t\tt.Fatalf(\"%s admitted the at-limit socket\", operation)\n116|\t\t\t} else {\n117|\t\t\t\trequireLocalCode(t, err, \"tmux_socket_path_too_long\", \"socket path length\")\n118|\t\t\t}\n119|\t\t})\n120|\t}\n121|}\n122|\n123|func TestExecuteRefusesUnsafeSocket(t *testing.T) {\n124|\t// No leaf staged: the delegated leaf custody refuses, propagated —\n125|\t// identically on every operation, because custody precedes dispatch\n126|\t// and never sees the body.\n127|\tfor _, operation := range []string{\"create\", \"attach\", \"status\", \"quiesce-input\", \"wait-safe-boundary\", \"request-stop\", \"terminate-stale\", \"restore\"} {\n128|\t\tt.Run(operation, func(t *testing.T) {\n129|\t\t\tlc := lifecycleShell(t)\n130|\t\t\tif _, err := lc.Execute(context.Background(), OpRequest{Operation: operation}); err == nil {\n131|\t\t\t\tt.Fatalf(\"%s admitted the unsafe socket\", operation)\n132|\t\t\t} else {\n133|\t\t\t\trequireLocalCode(t, err, \"tmux_unsafe_runtime_dir\", \"runtime absent\")\n134|\t\t\t}\n135|\t\t})\n136|\t}\n137|}\n138|\n139|func TestRowErrorNormalizesOutsideSet(t *testing.T) {\n140|\t// In-row codes propagate with their report; outside-set codes are\n141|\t// themselves refused as the protocol error.\n142|\tinRow := rowError(terminalbackend.OperationTerminateStale,\n143|\t\t&terminalbackend.Error{Code: \"terminal_backend_process_failed\", Detail: \"x\"})\n144|\tvar landed *terminalbackend.Error\n145|\tif !isLandedError(inRow, &landed) || landed.Code != \"terminal_backend_process_failed\" {\n146|\t\tt.Fatalf(\"in-row normalized: %v\", inRow)\n147|\t}\n148|\toutRow := rowError(terminalbackend.OperationTerminateStale,\n149|\t\t&terminalbackend.Error{Code: \"terminal_backend_restore_mismatch\", Detail: \"x\"})\n150|\trequireLocalCode(t, outRow, \"terminal_backend_protocol_error\", \"operation error vocabulary\")\n151|\tif uncoded := rowError(terminalbackend.OperationAttach, errFakeTransport); uncoded != errFakeTransport {\n152|\t\tt.Fatalf(\"uncoded mapped: %v\", uncoded)\n153|\t}\n154|}\n155|\n156|func TestRowErrorCoversEightRows(t *testing.T) {\n157|\t// rowError agrees with the landed allowed-set oracle on every row:\n158|\t// a code the row admits propagates; any other code normalizes.\n159|\tprobes := []string{\n160|\t\t\"terminal_backend_timeout\", \"terminal_backend_process_failed\",\n161|\t\t\"terminal_backend_restore_mismatch\", \"quiesce_timeout\", \"stop_timeout\",\n162|\t\t\"idempotency_mismatch\", \"terminal_backend_unavailable\",\n163|\t}\n164|\tfor _, operation := range []terminalbackend.Operation{\n165|\t\tterminalbackend.OperationCreate, terminalbackend.OperationAttach,\n166|\t\tterminalbackend.OperationStatus, terminalbackend.OperationQuiesceInput,\n167|\t\tterminalbackend.OperationWaitSafeBoundary, terminalbackend.OperationRequestStop,\n168|\t\tterminalbackend.OperationTerminateStale, terminalbackend.OperationRestore,\n169|\t} {\n170|\t\tfor _, code := range probes {\n171|\t\t\treported := &terminalbackend.Error{Code: code, Detail: \"x\"}\n172|\t\t\tgot := rowError(operation, reported)\n173|\t\t\tallowed := terminalbackend.CheckErrorAllowed(string(operation), code) == nil\n174|\t\t\tvar landed *terminalbackend.Error\n175|\t\t\tif allowed {\n176|\t\t\t\tif !isLandedError(got, &landed) || landed.Code != code {\n177|\t\t\t\t\tt.Fatalf(\"row %s normalized admitted %s: %v\", operation, code, got)\n178|\t\t\t\t}\n179|\t\t\t\tcontinue\n180|\t\t\t}\n181|\t\t\trequireLocalCode(t, got, \"terminal_backend_protocol_error\", \"operation error vocabulary\")\n182|\t\t}\n183|\t}\n184|}\n185|\n186|func TestDescriptorsBoundedByConstruction(t *testing.T) {\n187|\t// Maximum descriptor: longest socket plus two UUIDs plus separators.\n188|\tsocket := \"/\" + strings.Repeat(\"s\", 106)\n189|\tbound := attachDescriptor(socket, lxInstance, lxClient)\n190|\tif len(bound) > 4096 {\n191|\t\tt.Fatalf(\"bound descriptor length %d exceeds 4096\", len(bound))\n192|\t}\n193|\tif !strings.Contains(bound, socket) || !strings.Contains(bound, lxClient) {\n194|\t\tt.Fatalf(\"bound descriptor = %q\", bound)\n195|\t}\n196|\tunbound := createDescriptor(socket, lxInstance)\n197|\tif len(unbound) > 4096 || strings.Contains(unbound, lxClient) {\n198|\t\tt.Fatalf(\"unbound descriptor = %q\", unbound)\n199|\t}\n200|}\n201|\n202|func TestFormatTimestampParses(t *testing.T) {\n203|\trendered := formatTimestamp(lxNow())\n204|\tif _, err := scalar.ParseTimestamp(rendered); err != nil {\n205|\t\tt.Fatalf(\"format %q: %v\", rendered, err)\n206|\t}\n207|\tif rendered != \"2026-09-01T12:00:00.000Z\" {\n208|\t\tt.Fatalf(\"format = %q\", rendered)\n209|\t}\n210|\t// Fractional instants keep their precision.\n211|\tprecise, err := scalar.ParseTimestamp(\"2026-09-01T12:00:00.123456789Z\")\n212|\tif err != nil {\n213|\t\tt.Fatal(err)\n214|\t}\n215|\tinstant, err := precise.Time()\n216|\tif err != nil {\n217|\t\tt.Fatal(err)\n218|\t}\n219|\tif got := formatTimestamp(instant); got != \"2026-09-01T12:00:00.123Z\" {\n220|\t\tt.Fatalf(\"precise format = %q\", got)\n221|\t}\n222|}\n223|\n224|func TestFormatTimestampUsesUTC(t *testing.T) {\n225|\teastern := time.FixedZone(\"EST\", -5*3600)\n226|\tnow := time.Date(2026, 9, 1, 7, 0, 0, 0, eastern)\n227|\tif got := formatTimestamp(now); got != \"2026-09-01T12:00:00.000Z\" {\n228|\t\tt.Fatalf(\"utc format = %q\", got)\n229|\t}\n230|}","final_result":true}}}
