{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c69f","stream":{"kind":"session","id":"01a0c88a-6674-7861-9d70-d3e79e98c472"},"sequence":426,"recorded_at":1780531400000847,"record_type":"event","durability":"durable","causation_id":"995ec337-5e4d-4fd4-a64e-ae914055ec56","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"995ec337-5e4d-4fd4-a64e-ae914055ec56","run_stream":{"kind":"run","id":"995ec337-5e4d-4fd4-a64e-ae914055ec56"},"task_stream":{"kind":"task","id":"01a0c88b-42ca-7213-b748-355bce0cc45d"},"task_id":"01a0c88b-42ca-7213-b748-355bce0cc45d","event":{"kind":"output","task_id":"01a0c88b-42ca-7213-b748-355bce0cc45d","chunk":"Read text file `internal/tmuxserver/lifecycle.go`.\n(499 line(s) above)\n500|\t}\n501|\tswitch operation {\n502|\tcase terminalbackend.OperationQuiesceInput:\n503|\t\toutcome.QuiescenceGeneration = params.QuiescenceGeneration\n504|\t\tclosedAt, err := lc.reportInputClosedAt(mctx.TerminalInstanceID, mctx.IdempotencyKey)\n505|\t\tif err != nil {\n506|\t\t\treturn outcome, err\n507|\t\t}\n508|\t\tif err := lc.recordAfter(mctx.TerminalInstanceID, result.After); err != nil {\n509|\t\t\treturn outcome, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"quiesce state image\"}\n510|\t\t}\n511|\t\toutcome.InputClosedAt = closedAt\n512|\tcase terminalbackend.OperationWaitSafeBoundary:\n513|\t\t// The boundary transition carries exactly one effect, and the\n514|\t\t// engine evidences every committed effect exactly once, so a\n515|\t\t// successful boundary result carries exactly one evidence ID.\n516|\t\toutcome.SafeBoundaryEvidenceID = result.EvidenceIDs[0]\n517|\t\tobservedAt, err := lc.reportBoundaryObservedAt(mctx.TerminalInstanceID, mctx.IdempotencyKey)\n518|\t\tif err != nil {\n519|\t\t\treturn outcome, err\n520|\t\t}\n521|\t\tif err := lc.recordAfter(mctx.TerminalInstanceID, result.After); err != nil {\n522|\t\t\treturn outcome, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"boundary state image\"}\n523|\t\t}\n524|\t\toutcome.BoundaryObservedAt = observedAt\n525|\tcase terminalbackend.OperationRequestStop:\n526|\t\toutcome.ProcessClosed = true\n527|\t\toutcome.StoreClosed = true\n528|\t}\n529|\treturn outcome, nil\n530|}\n531|\n532|// reportInputClosedAt replays the recorded input-closed time for one\n533|// quiesce key, recording the current time on first success. The\n534|// first-success record binds the current incarnation, so the report\n535|// proves the barrier exactly for the incarnation it closed. A\n536|// failed or forged lookup is corruption, never absence: the retry\n537|// refuses the integrity failure instead of manufacturing a fresh\n538|// closure time for an already-closed input. A record failure\n539|// refuses the same way: the effect is committed but its time is\n540|// unprovable, so the retry re-records rather than reporting an\n541|// unrecorded time.\n542|func (lc *Lifecycle) reportInputClosedAt(instanceID, key string) (string, error) {\n543|\tstored, found, err := lc.States.LookupOutcome(key)\n544|\tif err != nil {\n545|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"quiesce outcome image\"}\n546|\t}\n547|\tif found {\n548|\t\tif stored.InputClosedAt == \"\" {\n549|\t\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"quiesce outcome image\"}\n550|\t\t}\n551|\t\treturn stored.InputClosedAt, nil\n552|\t}\n553|\tincarnation, _, err := lc.States.LookupIncarnation(instanceID)\n554|\tif err != nil {\n555|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"quiesce outcome image\"}\n556|\t}\n557|\trendered := formatTimestamp(lc.Now())\n558|\tif err := lc.States.RecordOutcome(key, OperationOutcome{Operation: string(terminalbackend.OperationQuiesceInput), InputClosedAt: rendered, Incarnation: incarnation}); err != nil {\n559|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"quiesce outcome image\"}\n560|\t}\n561|\treturn rendered, nil\n562|}\n563|\n564|// reportBoundaryObservedAt replays the recorded boundary-observed\n565|// time for one boundary key, recording the current time on first\n566|// success, with the same corrupt-read and record-failure discipline\n567|// as the quiesce report: no failed read becomes fresh evidence.\n568|// The first-success record binds the current incarnation like the\n569|// quiesce report.\n570|func (lc *Lifecycle) reportBoundaryObservedAt(instanceID, key string) (string, error) {\n571|\tstored, found, err := lc.States.LookupOutcome(key)\n572|\tif err != nil {\n573|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"boundary outcome image\"}\n574|\t}\n575|\tif found {\n576|\t\tif stored.BoundaryObservedAt == \"\" {\n577|\t\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"boundary outcome image\"}\n578|\t\t}\n579|\t\treturn stored.BoundaryObservedAt, nil\n580|\t}\n581|\tincarnation, _, err := lc.States.LookupIncarnation(instanceID)\n582|\tif err != nil {\n583|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"boundary outcome image\"}\n584|\t}\n585|\trendered := formatTimestamp(lc.Now())\n586|\tif err := lc.States.RecordOutcome(key, OperationOutcome{Operation: string(terminalbackend.OperationWaitSafeBoundary), BoundaryObservedAt: rendered, Incarnation: incarnation}); err != nil {\n587|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"boundary outcome image\"}\n588|\t}\n589|\treturn rendered, nil\n590|}\n591|\n592|// boundWait bounds the safe-boundary wait by the lesser of the request\n593|// deadline and the timeout: the wait context carries the minimum, and\n594|// an already-invalid deadline falls back to the timeout alone (the\n595|// engine refuses the malformed deadline before any effect runs, so the\n596|// fallback never binds). The caller cancels the context.\n597|func (lc *Lifecycle) boundWait(ctx context.Context, mctx terminstance.MutationContext, timeoutMs uint64) (context.Context, context.CancelFunc) {\n598|\tbound := lc.Now().Add(time.Duration(timeoutMs) * time.Millisecond)\n599|\tif deadline, err := mctx.Deadline.Time(); err == nil && deadline.Before(bound) {\n600|\t\tbound = deadline\n601|\t}\n602|\treturn context.WithDeadline(ctx, bound)\n603|}\n604|\n605|// lesserDeadline computes the lesser of the request deadline and the\n606|// graceful timeout for the stop close-confirm poll. An invalid\n607|// deadline falls back the same way as the boundary wait.\n608|func (lc *Lifecycle) lesserDeadline(mctx terminstance.MutationContext, timeoutMs uint64) time.Time {\n609|\tbound := lc.Now().Add(time.Duration(timeoutMs) * time.Millisecond)\n610|\tif deadline, err := mctx.Deadline.Time(); err == nil && deadline.Before(bound) {\n611|\t\treturn deadline\n612|\t}\n613|\treturn bound\n614|}","final_result":true}}}
