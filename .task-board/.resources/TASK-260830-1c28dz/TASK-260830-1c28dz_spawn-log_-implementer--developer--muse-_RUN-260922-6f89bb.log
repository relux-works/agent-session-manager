{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc83","stream":{"kind":"session","id":"01a0c88a-6674-7861-9d70-d3e79e98c472"},"sequence":1180,"recorded_at":1780531400002355,"record_type":"event","durability":"durable","causation_id":"995ec337-5e4d-4fd4-a64e-ae914055ec56","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"995ec337-5e4d-4fd4-a64e-ae914055ec56","run_stream":{"kind":"run","id":"995ec337-5e4d-4fd4-a64e-ae914055ec56"},"task_stream":{"kind":"task","id":"01a0c892-86ac-7b82-86f9-bdccccf4dd03"},"task_id":"01a0c892-86ac-7b82-86f9-bdccccf4dd03","event":{"kind":"output","task_id":"01a0c892-86ac-7b82-86f9-bdccccf4dd03","chunk":"Read text file `internal/tmuxserver/lifecycle_ops_unix_test.go`.\n1|//go:build !windows\n2|\n3|package tmuxserver\n4|\n5|import (\n6|\t\"context\"\n7|\t\"testing\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n12|)\n13|\n14|// terminateFencing returns the fencing material for a fenced target:\n15|// presented (session, stale epoch/lease) differs from the winning\n16|// (session, current epoch/lease), with explicit force recovery and\n17|// preserved diagnostics.\n18|func terminateFencing() (fencing.PresentedToken, sessrepo.LeaseSummary) {\n19|\tpresented := fencing.PresentedToken{SessionID: lxSession, Epoch: 9, LeaseID: lxLeaseB}\n20|\twinner := sessrepo.LeaseSummary{SessionID: lxSession, LeaseID: lxLease, Epoch: 7}\n21|\treturn presented, winner\n22|}\n23|\n24|func TestExecuteCreateInteractive(t *testing.T) {\n25|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n26|\tfx.runner.queue(\"new-session\", \"\", 0)\n27|\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n28|\t\tOperation: \"create\", Body: lxCreateBody(t, nil), Source: \"absent\", Admitted: fullLifecycleAdmitted(),\n29|\t})\n30|\tif err != nil {\n31|\t\tt.Fatal(err)\n32|\t}\n33|\tif outcome.Mutation == nil || outcome.Mutation.After != terminalbackend.StateActive {\n34|\t\tt.Fatalf(\"mutation = %+v\", outcome.Mutation)\n35|\t}\n36|\tif outcome.Binding == nil || outcome.Binding.TerminalInstanceID != lxInstance {\n37|\t\tt.Fatalf(\"binding = %+v\", outcome.Binding)\n38|\t}\n39|\tif outcome.Descriptor == nil || *outcome.Descriptor != fx.socket+\"\\n\"+lxInstance {\n40|\t\tt.Fatalf(\"descriptor = %+v\", outcome.Descriptor)\n41|\t}\n42|\tif fx.runner.callCount() != 1 {\n43|\t\tt.Fatalf(\"calls = %d, want 1\", fx.runner.callCount())\n44|\t}\n45|\twantArgv := []string{\"tmux\", \"-S\", fx.socket, \"new-session\", \"-d\", \"-s\", lxInstance, \"ax\", \"pane\", lxSession}\n46|\tif got := fx.runner.calls[0]; len(got) != len(wantArgv) {\n47|\t\tt.Fatalf(\"argv = %q, want %q\", got, wantArgv)\n48|\t} else {\n49|\t\tfor i := range wantArgv {\n50|\t\t\tif got[i] != wantArgv[i] {\n51|\t\t\t\tt.Fatalf(\"argv = %q, want %q\", got, wantArgv)\n52|\t\t\t}\n53|\t\t}\n54|\t}\n55|\tstate, found, err := fx.lc.States.Lookup(lxInstance)\n56|\tif err != nil || !found || state != terminalbackend.StateActive {\n57|\t\tt.Fatalf(\"memory = %s, %v, %v\", state, found, err)\n58|\t}\n59|}\n60|\n61|func TestExecuteCreateHeadless(t *testing.T) {\n62|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n63|\tfx.runner.queue(\"new-session\", \"\", 0)\n64|\traw := lxCreateBody(t, func(object map[string]any) { object[\"interactive\"] = false })\n65|\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n66|\t\tOperation: \"create\", Body: raw, Source: \"stopped\", Admitted: fullLifecycleAdmitted(),\n67|\t})\n68|\tif err != nil {\n69|\t\tt.Fatal(err)\n70|\t}\n71|\tif outcome.Mutation.After != terminalbackend.StateParked {\n72|\t\tt.Fatalf(\"after = %s\", outcome.Mutation.After)\n73|\t}\n74|\tif outcome.Descriptor != nil {\n75|\t\tt.Fatalf(\"headless descriptor = %q\", *outcome.Descriptor)\n76|\t}\n77|}\n78|\n79|func TestExecuteCreateRefusals(t *testing.T) {\n80|\tt.Run(\"relay\", func(t *testing.T) {\n81|\t\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n82|\t\traw := lxCreateBody(t, func(object map[string]any) { object[\"presentation_transport\"] = \"third_party_relay\" })\n83|\t\t_, err := fx.lc.Execute(context.Background(), OpRequest{Operation: \"create\", Body: raw, Source: \"absent\", Admitted: fullLifecycleAdmitted()})\n84|\t\trequireLocalCode(t, err, \"terminal_backend_unauthorized\", \"create relay transport\")\n85|\t\tif fx.runner.callCount() != 0 {\n86|\t\t\tt.Fatalf(\"refused create execed %d commands\", fx.runner.callCount())\n87|\t\t}\n88|\t})\n89|\tt.Run(\"headless-without-capability\", func(t *testing.T) {\n90|\t\tfx := newLifecycleFixture(t, admittedWith(\"credential_capable_execution_realm\"))\n91|\t\traw := lxCreateBody(t, func(object map[string]any) { object[\"interactive\"] = false })\n92|\t\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{Operation: \"create\", Body: raw, Source: \"absent\", Admitted: admittedWith(\"credential_capable_execution_realm\")})\n93|\t\trequireEngineCode(t, err, \"terminal_backend_capability_unproven\")\n94|\t\tif outcome.Mutation == nil || outcome.Mutation.After != terminalbackend.StateAbsent {\n95|\t\t\tt.Fatalf(\"mutation = %+v\", outcome.Mutation)\n96|\t\t}\n97|\t})\n98|\tt.Run(\"bad-source\", func(t *testing.T) {\n99|\t\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n100|\t\t_, err := fx.lc.Execute(context.Background(), OpRequest{Operation: \"create\", Body: lxCreateBody(t, nil), Source: \"active\", Admitted: fullLifecycleAdmitted()})\n101|\t\trequireEngineCode(t, err, \"local_precondition_failed\")\n102|\t})\n103|}\n104|\n105|func TestExecuteCreateBindingAgreement(t *testing.T) {\n106|\tmembers := []struct {\n107|\t\tname   string\n108|\t\tmutate func(map[string]any)\n109|\t}{\n110|\t\t{\"session\", func(binding map[string]any) { binding[\"session_id\"] = lxSessionB }},\n111|\t\t{\"instance\", func(binding map[string]any) { binding[\"terminal_instance_id\"] = lxSessionB }},\n112|\t\t{\"backend\", func(binding map[string]any) { binding[\"terminal_backend_id\"] = \"ax.conpty\" }},\n113|\t\t{\"generation\", func(binding map[string]any) { binding[\"backend_generation\"] = \"generation-two\" }},\n114|\t}\n115|\tfor _, tc := range members {\n116|\t\tt.Run(tc.name, func(t *testing.T) {\n117|\t\t\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n118|\t\t\traw := lxCreateBody(t, func(object map[string]any) {\n119|\t\t\t\tobject[\"binding\"] = lxBindingDoc(t, tc.mutate)\n120|\t\t\t})\n121|\t\t\t_, err := fx.lc.Execute(context.Background(), OpRequest{Operation: \"create\", Body: raw, Source: \"absent\", Admitted: fullLifecycleAdmitted()})\n122|\t\t\trequireLocalCode(t, err, \"local_precondition_failed\", \"create binding agreement\")\n123|\t\t\tif fx.runner.callCount() != 0 {\n124|\t\t\t\tt.Fatalf(\"disagreeing create execed %d commands\", fx.runner.callCount())\n125|\t\t\t}\n126|\t\t})\n127|\t}\n128|}\n129|\n130|func TestExecuteCreateIdempotent(t *testing.T) {\n131|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n132|\tfx.runner.queue(\"new-session\", \"\", 0)\n133|\traw := lxCreateBody(t, nil)\n134|\tfirst, err := fx.lc.Execute(context.Background(), OpRequest{Operation: \"create\", Body: raw, Source: \"absent\", Admitted: fullLifecycleAdmitted()})\n135|\tif err != nil {\n136|\t\tt.Fatal(err)\n137|\t}\n138|\tsecond, err := fx.lc.Execute(context.Background(), OpRequest{Operation: \"create\", Body: raw, Source: \"absent\", Admitted: fullLifecycleAdmitted()})\n139|\tif err != nil {\n140|\t\tt.Fatal(err)\n141|\t}\n142|\tif fx.runner.callCount() != 1 {\n143|\t\tt.Fatalf(\"calls = %d, want 1\", fx.runner.callCount())\n144|\t}\n145|\tif second.Mutation.After != first.Mutation.After || len(second.Mutation.EvidenceIDs) != len(first.Mutation.EvidenceIDs) {\n146|\t\tt.Fatalf(\"replay diverged: %+v vs %+v\", second.Mutation, first.Mutation)\n147|\t}\n148|}\n149|\n150|func TestExecuteAttach(t *testing.T) {\n151|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n152|\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n153|\t\tOperation: \"attach\", Body: lxAttachBody(t, nil), Source: \"parked\", Admitted: fullLifecycleAdmitted(),\n154|\t})\n155|\tif err != nil {\n156|\t\tt.Fatal(err)\n157|\t}\n158|\tif outcome.Attach == nil || outcome.Attach.ClientMirrorID != lxClient || !outcome.Attach.InputAuthorized {\n159|\t\tt.Fatalf(\"attach = %+v\", outcome.Attach)\n160|\t}\n161|\tif outcome.Attach.Descriptor != fx.socket+\"\\n\"+lxInstance+\"\\n\"+lxClient {\n162|\t\tt.Fatalf(\"descriptor = %q\", outcome.Attach.Descriptor)\n163|\t}\n164|\twantArgv := []string{\"tmux\", \"-S\", fx.socket, \"attach-session\", \"-t\", lxInstance}\n165|\tif len(outcome.Argv) != len(wantArgv) {\n166|\t\tt.Fatalf(\"argv = %q\", outcome.Argv)\n167|\t}\n168|\tfor i := range wantArgv {\n169|\t\tif outcome.Argv[i] != wantArgv[i] {\n170|\t\t\tt.Fatalf(\"argv = %q, want %q\", outcome.Argv, wantArgv)\n171|\t\t}\n172|\t}\n173|\tif fx.runner.callCount() != 0 {\n174|\t\tt.Fatalf(\"attach execed %d commands\", fx.runner.callCount())\n175|\t}\n176|\tstate, found, err := fx.lc.States.Lookup(lxInstance)\n177|\tif err != nil || !found || state != terminalbackend.StateActive {\n178|\t\tt.Fatalf(\"memory = %s, %v, %v\", state, found, err)\n179|\t}\n180|}\n181|\n182|func TestExecuteAttachRefusals(t *testing.T) {\n183|\tt.Run(\"fresh-decoy\", func(t *testing.T) {\n184|\t\tadmitted := admittedWith(\"local_attach\")\n185|\t\tfx := newLifecycleFixture(t, admitted)\n186|\t\tfx.lc.ServerAdmission = func() (RealmAdmission, error) {\n187|\t\t\treturn RealmAdmission{Admitted: admittedWith(\"local_attach\"), RawGeneration: lxGeneration}, nil\n188|\t\t}\n189|\t\t_, err := fx.lc.Execute(context.Background(), OpRequest{Operation: \"attach\", Body: lxAttachBody(t, nil), Source: \"parked\", Admitted: admitted})\n190|\t\trequireLocalCode(t, err, \"terminal_backend_unauthorized\", \"attach server attestation\")\n191|\t})\n192|\tt.Run(\"stale-admission\", func(t *testing.T) {\n193|\t\tadmitted := fullLifecycleAdmitted()\n194|\t\tfx := newLifecycleFixture(t, admitted)\n195|\t\tfx.lc.ServerAdmission = func() (RealmAdmission, error) {\n196|\t\t\treturn RealmAdmission{Admitted: admitted, RawGeneration: \"generation-two\"}, nil\n197|\t\t}\n198|\t\t_, err := fx.lc.Execute(context.Background(), OpRequest{Operation: \"attach\", Body: lxAttachBody(t, nil), Source: \"parked\", Admitted: admitted})\n199|\t\trequireLocalCode(t, err, \"terminal_backend_unauthorized\", \"attach server attestation\")\n200|\t})\n201|\tt.Run(\"wrong-transport-capability\", func(t *testing.T) {\n202|\t\tadmitted := admittedWith(\"remote_attach\")\n203|\t\tfx := newLifecycleFixture(t, admitted)\n204|\t\t_, err := fx.lc.Execute(context.Background(), OpRequest{Operation: \"attach\", Body: lxAttachBody(t, nil), Source: \"parked\", Admitted: admitted})\n205|\t\trequireLocalCode(t, err, \"terminal_backend_capability_unproven\", \"operation capability conditional\")\n206|\t})\n207|\tt.Run(\"relay\", func(t *testing.T) {\n208|\t\tadmitted := fullLifecycleAdmitted()\n209|\t\tfx := newLifecycleFixture(t, admitted)\n210|\t\traw := lxAttachBody(t, func(object map[string]any) {\n211|\t\t\tobject[\"transport\"] = \"third_party_relay\"\n212|\t\t\tobject[\"authorization\"] = lxAttachAuth(\"third_party_relay\", true)\n213|\t\t})\n214|\t\t_, err := fx.lc.Execute(context.Background(), OpRequest{Operation: \"attach\", Body: raw, Source: \"parked\", Admitted: admitted})\n215|\t\trequireLandedCode(t, err, \"terminal_backend_unauthorized\")\n216|\t})\n217|\tt.Run(\"bad-source\", func(t *testing.T) {\n218|\t\tadmitted := fullLifecycleAdmitted()\n219|\t\tfx := newLifecycleFixture(t, admitted)\n220|\t\t_, err := fx.lc.Execute(context.Background(), OpRequest{Operation: \"attach\", Body: lxAttachBody(t, nil), Source: \"stopped\", Admitted: admitted})\n221|\t\trequireLandedCode(t, err, \"local_precondition_failed\")\n222|\t})\n223|\tt.Run(\"no-admission\", func(t *testing.T) {\n224|\t\tadmitted := fullLifecycleAdmitted()\n225|\t\tfx := newLifecycleFixture(t, admitted)\n226|\t\tfx.lc.ServerAdmission = nil\n227|\t\t_, err := fx.lc.Execute(context.Background(), OpRequest{Operation: \"attach\", Body: lxAttachBody(t, nil), Source: \"parked\", Admitted: admitted})\n228|\t\trequireLocalCode(t, err, \"terminal_backend_protocol_error\", \"lifecycle dependencies\")\n229|\t})\n230|}\n(more lines below)","final_result":true}}}
