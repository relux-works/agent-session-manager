{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c711","stream":{"kind":"session","id":"01a0c88a-6674-7861-9d70-d3e79e98c472"},"sequence":483,"recorded_at":1780531400000961,"record_type":"event","durability":"durable","causation_id":"995ec337-5e4d-4fd4-a64e-ae914055ec56","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"995ec337-5e4d-4fd4-a64e-ae914055ec56","run_stream":{"kind":"run","id":"995ec337-5e4d-4fd4-a64e-ae914055ec56"},"task_stream":{"kind":"task","id":"01a0c88b-8262-7b51-bd11-a57a39cbaffc"},"task_id":"01a0c88b-8262-7b51-bd11-a57a39cbaffc","event":{"kind":"output","task_id":"01a0c88b-8262-7b51-bd11-a57a39cbaffc","chunk":"Read text file `internal/terminstance/store.go`.\n1|package terminstance\n2|\n3|import (\n4|\t\"crypto/sha256\"\n5|\t\"encoding/hex\"\n6|\t\"errors\"\n7|\t\"fmt\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"sort\"\n11|\t\"strings\"\n12|\t\"sync\"\n13|\t\"time\"\n14|\n15|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n16|)\n17|\n18|// Receipt is one durable idempotency record: the canonical key, the\n19|// operation it was bound for, and the operation ID it was bound with.\n20|// The shape extends the landed terminalbackend.Receipt triple\n21|// (Key/Operation/ResultID); ResultID is the MutationContext operation\n22|// ID, so an identical retry (same key, same operation, same operation\n23|// ID) replays and a changed operation in the window is\n24|// idempotency_mismatch.\n25|type Receipt struct {\n26|\tKey         string\n27|\tOperation   terminalbackend.Operation\n28|\tOperationID string\n29|}\n30|\n31|// StoreHooks arms the crash seams of the receipt store. AfterCommit runs\n32|// after the no-replace link lands and before the directory sync, exactly\n33|// like the predecessor leaf's AfterInstall: a hook error propagates to\n34|// the caller but the receipt stands, so the identical retry reconciles\n35|// through the production status entry — it replays when a completion\n36|// exists, resumes under the same receipt when status proves the source,\n37|// and refuses uncertain otherwise — instead of binding a second receipt.\n38|type StoreHooks struct {\n39|\tAfterCommit func(path string) error\n40|}\n41|\n42|// ReceiptStore is the durable idempotency receipt table backing the §4.C\n43|// recovery rules: persist the receipt before the first side effect,\n44|// identical retry replays it, a changed operation in the window is\n45|// idempotency_mismatch, and uncertainty requires status. Each receipt is\n46|// one file committed by temp-stage, fsync, no-replace link and directory\n47|// sync; readers see absence or the complete receipt, never a torn\n48|// prefix. Completion (the recorded result) is a second no-replace file,\n49|// because updating the receipt in place would break no-replace: a\n50|// pending receipt without its completion proves an interrupted attempt,\n51|// never a result, and the engine reconciles its retry through the\n52|// production status entry: the same operation resumes under the same\n53|// receipt when status proves the source, and refuses uncertain\n54|// otherwise. No path binds a second receipt for one key.\n55|type ReceiptStore struct {\n56|\tmutex sync.Mutex\n57|\tbase  string\n58|\thooks *StoreHooks\n59|}\n60|\n61|// OpenReceiptStore opens (creating) the receipt store rooted at base.\n62|func OpenReceiptStore(base string) (*ReceiptStore, error) {\n63|\tif err := os.MkdirAll(base, 0o755); err != nil {\n64|\t\treturn nil, fmt.Errorf(\"create receipt store: %w\", err)\n65|\t}\n66|\tif err := os.MkdirAll(filepath.Join(base, \"pending\"), 0o755); err != nil {\n67|\t\treturn nil, fmt.Errorf(\"create receipt pending directory: %w\", err)\n68|\t}\n69|\tif err := os.MkdirAll(filepath.Join(base, \"done\"), 0o755); err != nil {\n70|\t\treturn nil, fmt.Errorf(\"create receipt done directory: %w\", err)\n71|\t}\n72|\treturn &ReceiptStore{base: base}, nil\n73|}\n74|\n75|// WithHooks arms the crash seams. A nil hooks value disarms them.\n76|func (store *ReceiptStore) WithHooks(hooks *StoreHooks) {\n77|\tstore.mutex.Lock()\n78|\tdefer store.mutex.Unlock()\n79|\tstore.hooks = hooks\n80|}\n81|\n82|// receiptName maps a key to its file name: the hex sha256 of the key.\n83|// The key itself is embedded in the file content, so the name is a\n84|// lookup optimization the content re-validates, never trusted identity.\n85|func receiptName(key string) string {\n86|\tsum := sha256.Sum256([]byte(key))\n87|\treturn hex.EncodeToString(sum[:])\n88|}\n89|\n90|// encodeReceipt renders one receipt as the landed per-receipt triple:\n91|// key, operation and operation ID on three lines. The encoding matches\n92|// terminalbackend.Ledger.Export line for line, so Export below produces\n93|// bytes ImportLedger admits.\n94|func encodeReceipt(receipt Receipt) []byte {\n95|\treturn []byte(receipt.Key + \"\\n\" + string(receipt.Operation) + \"\\n\" + receipt.OperationID + \"\\n\")\n96|}\n97|\n98|// decodeReceipt parses one receipt file. A torn or malformed file is an\n99|// integrity failure, never absence and never a partial receipt.\n100|func decodeReceipt(raw []byte) (Receipt, error) {\n101|\tlines := strings.Split(string(raw), \"\\n\")\n102|\tif len(lines) != 4 || lines[3] != \"\" || lines[0] == \"\" || lines[2] == \"\" {\n103|\t\treturn Receipt{}, refuse(CodeIntegrityFailure, \"idempotency receipt image\")\n104|\t}\n105|\toperation, err := terminalbackend.ParseOperation(lines[1])\n106|\tif err != nil {\n107|\t\treturn Receipt{}, refuse(CodeIntegrityFailure, \"idempotency receipt image\")\n108|\t}\n109|\treturn Receipt{Key: lines[0], Operation: operation, OperationID: lines[2]}, nil\n110|}\n111|\n112|// Bind records the receipt for a key before the first side effect. A key\n113|// bound for the first time is durably stored and reported fresh. A key\n114|// bound again with the identical operation and operation ID replays the\n115|// stored receipt. A key bound again with a different operation or\n116|// operation ID is idempotency_mismatch: only a successful status read\n117|// proves absence, never a second binding.\n118|func (store *ReceiptStore) Bind(key string, operation terminalbackend.Operation, operationID string) (Receipt, bool, error) {\n119|\tif store == nil {\n120|\t\treturn Receipt{}, false, refuse(CodeProtocolError, \"idempotency store unavailable\")\n121|\t}\n122|\tif key == \"\" || operationID == \"\" {\n123|\t\treturn Receipt{}, false, refuse(CodeProtocolError, \"idempotency key shape\")\n124|\t}\n125|\tif _, err := terminalbackend.ParseOperation(string(operation)); err != nil {\n126|\t\treturn Receipt{}, false, wrapLanded(err)\n127|\t}\n128|\tdir := filepath.Join(store.base, \"pending\")\n129|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n130|\t\treturn Receipt{}, false, fmt.Errorf(\"create receipt pending directory: %w\", err)\n131|\t}\n132|\tsweepStaging(dir)\n133|\ttarget := filepath.Join(dir, receiptName(key))\n134|\treceipt := Receipt{Key: key, Operation: operation, OperationID: operationID}\n135|\tstaged, err := os.CreateTemp(dir, \"receipt-*.tmp\")\n136|\tif err != nil {\n137|\t\treturn Receipt{}, false, fmt.Errorf(\"stage idempotency receipt: %w\", err)\n138|\t}\n139|\tstagedPath := staged.Name()\n140|\tdefer func() { _ = os.Remove(stagedPath) }()\n141|\tif err := staged.Chmod(0o600); err != nil {\n142|\t\t_ = staged.Close()\n143|\t\treturn Receipt{}, false, fmt.Errorf(\"protect idempotency receipt: %w\", err)\n144|\t}\n145|\tif _, err := staged.Write(encodeReceipt(receipt)); err != nil {\n146|\t\t_ = staged.Close()\n147|\t\treturn Receipt{}, false, fmt.Errorf(\"write idempotency receipt: %w\", err)\n148|\t}\n149|\tif err := staged.Sync(); err != nil {\n150|\t\t_ = staged.Close()\n151|\t\treturn Receipt{}, false, fmt.Errorf(\"sync idempotency receipt: %w\", err)\n152|\t}\n153|\tif err := staged.Close(); err != nil {\n154|\t\treturn Receipt{}, false, fmt.Errorf(\"close idempotency receipt: %w\", err)\n155|\t}\n156|\tif err := os.Link(stagedPath, target); err != nil {\n157|\t\tif errors.Is(err, os.ErrExist) {\n158|\t\t\twinner, found, readErr := store.Lookup(key)\n159|\t\t\tif readErr != nil {\n160|\t\t\t\treturn Receipt{}, false, readErr\n161|\t\t\t}\n162|\t\t\tif !found {\n163|\t\t\t\treturn Receipt{}, false, refuse(CodeIntegrityFailure, \"idempotency receipt image\")\n164|\t\t\t}\n165|\t\t\tif winner.Operation != operation || winner.OperationID != operationID {\n166|\t\t\t\treturn Receipt{}, false, refuse(CodeIdempotencyMismatch, \"idempotency key conflict\")\n167|\t\t\t}\n168|\t\t\treturn winner, true, nil\n169|\t\t}\n170|\t\treturn Receipt{}, false, fmt.Errorf(\"install idempotency receipt: %w\", err)\n171|\t}\n172|\t_ = os.Remove(stagedPath)\n173|\tstore.mutex.Lock()\n174|\thooks := store.hooks\n175|\tstore.mutex.Unlock()\n176|\tif hooks != nil && hooks.AfterCommit != nil {\n177|\t\tif err := hooks.AfterCommit(target); err != nil {\n178|\t\t\treturn Receipt{}, false, err\n179|\t\t}\n180|\t}\n181|\tif err := syncDirectory(dir); err != nil {\n182|\t\treturn Receipt{}, false, err\n183|\t}\n184|\treturn receipt, false, nil\n185|}\n186|\n187|// Lookup returns the stored receipt for a key. Absence of a receipt\n188|// proves nothing and reports false; a torn receipt file is an integrity\n189|// failure, never absence.\n190|func (store *ReceiptStore) Lookup(key string) (Receipt, bool, error) {\n191|\tif store == nil || key == \"\" {\n192|\t\treturn Receipt{}, false, nil\n193|\t}\n194|\ttarget := filepath.Join(store.base, \"pending\", receiptName(key))\n195|\traw, err := os.ReadFile(target)\n196|\tif err != nil {\n197|\t\tif errors.Is(err, os.ErrNotExist) {\n198|\t\t\treturn Receipt{}, false, nil\n199|\t\t}\n200|\t\treturn Receipt{}, false, fmt.Errorf(\"read idempotency receipt: %w\", err)\n201|\t}\n202|\treceipt, err := decodeReceipt(raw)\n203|\tif err != nil {\n204|\t\treturn Receipt{}, false, err\n205|\t}\n206|\tif receipt.Key != key {\n207|\t\treturn Receipt{}, false, refuse(CodeIntegrityFailure, \"idempotency receipt image\")\n208|\t}\n209|\treturn receipt, true, nil\n210|}\n211|\n212|// Complete records the result of a bound key. The result bytes commit\n213|// through the same no-replace link as the receipt: a second completion\n214|// with identical bytes replays, a second completion with different bytes\n215|// is an integrity failure, because one attempt has exactly one result.\n216|// Completing an unbound key is a failed local precondition.\n217|func (store *ReceiptStore) Complete(key string, result []byte) error {\n218|\tif store == nil {\n219|\t\treturn refuse(CodeProtocolError, \"idempotency store unavailable\")\n220|\t}\n221|\tif _, found, err := store.Lookup(key); err != nil {\n222|\t\treturn err\n223|\t} else if !found {\n224|\t\treturn refuse(CodePreconditionFailed, \"idempotency completion without receipt\")\n225|\t}\n226|\tdir := filepath.Join(store.base, \"done\")\n227|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n228|\t\treturn fmt.Errorf(\"create receipt done directory: %w\", err)\n229|\t}\n230|\tsweepStaging(dir)\n231|\ttarget := filepath.Join(dir, receiptName(key))\n232|\tstaged, err := os.CreateTemp(dir, \"result-*.tmp\")\n233|\tif err != nil {\n234|\t\treturn fmt.Errorf(\"stage idempotency result: %w\", err)\n235|\t}\n236|\tstagedPath := staged.Name()\n237|\tdefer func() { _ = os.Remove(stagedPath) }()\n238|\tif err := staged.Chmod(0o600); err != nil {\n239|\t\t_ = staged.Close()\n240|\t\treturn fmt.Errorf(\"protect idempotency result: %w\", err)\n241|\t}\n242|\tif _, err := staged.Write(result); err != nil {\n243|\t\t_ = staged.Close()\n244|\t\treturn fmt.Errorf(\"write idempotency result: %w\", err)\n245|\t}\n246|\tif err := staged.Sync(); err != nil {\n247|\t\t_ = staged.Close()\n248|\t\treturn fmt.Errorf(\"sync idempotency result: %w\", err)\n249|\t}\n250|\tif err := staged.Close(); err != nil {\n251|\t\treturn fmt.Errorf(\"close idempotency result: %w\", err)\n252|\t}\n253|\tif err := os.Link(stagedPath, target); err != nil {\n254|\t\tif errors.Is(err, os.ErrExist) {\n255|\t\t\twinner, readErr := os.ReadFile(target)\n256|\t\t\tif readErr != nil {\n257|\t\t\t\treturn fmt.Errorf(\"read idempotency result: %w\", readErr)\n258|\t\t\t}\n259|\t\t\tif string(winner) != string(result) {\n260|\t\t\t\treturn refuse(CodeIntegrityFailure, \"idempotency result conflict\")\n261|\t\t\t}\n262|\t\t\treturn nil\n263|\t\t}\n264|\t\treturn fmt.Errorf(\"install idempotency result: %w\", err)\n265|\t}\n266|\t_ = os.Remove(stagedPath)\n267|\tif err := syncDirectory(dir); err != nil {\n268|\t\treturn err\n269|\t}\n270|\treturn nil\n271|}\n272|\n273|// Completed returns the recorded result for a key. A bound key without\n274|// its completion reports found false: the attempt was interrupted and\n275|// only status recovers the observation, never a second binding.\n276|func (store *ReceiptStore) Completed(key string) ([]byte, bool, error) {\n277|\tif store == nil || key == \"\" {\n278|\t\treturn nil, false, nil\n279|\t}\n280|\ttarget := filepath.Join(store.base, \"done\", receiptName(key))\n281|\traw, err := os.ReadFile(target)\n282|\tif err != nil {\n283|\t\tif errors.Is(err, os.ErrNotExist) {\n284|\t\t\treturn nil, false, nil\n285|\t\t}\n286|\t\treturn nil, false, fmt.Errorf(\"read idempotency result: %w\", err)\n287|\t}\n288|\treturn raw, true, nil\n289|}\n290|\n291|// Export renders the pending table as stable bytes: receipts sorted by\n292|// key, one triple per receipt. The bytes equal what a\n293|// terminalbackend.Ledger holding the same receipts exports, so they feed\n294|// ImportLedger directly; the agreement is pinned by\n295|// TestStoreExportAgreesWithLedger. Staging garbage is never exported.\n296|func (store *ReceiptStore) Export() ([]byte, error) {\n297|\tif store == nil {\n298|\t\treturn nil, refuse(CodeProtocolError, \"idempotency store unavailable\")\n299|\t}\n300|\tdir := filepath.Join(store.base, \"pending\")\n301|\tentries, err := os.ReadDir(dir)\n302|\tif err != nil {\n303|\t\tif errors.Is(err, os.ErrNotExist) {\n304|\t\t\treturn nil, nil\n305|\t\t}\n306|\t\treturn nil, fmt.Errorf(\"read receipt table: %w\", err)\n307|\t}\n308|\treceipts := make([]Receipt, 0, len(entries))\n309|\tfor _, entry := range entries {\n310|\t\tif entry.IsDir() || !isReceiptName(entry.Name()) {\n311|\t\t\tcontinue\n312|\t\t}\n313|\t\traw, err := os.ReadFile(filepath.Join(dir, entry.Name()))\n314|\t\tif err != nil {\n315|\t\t\treturn nil, fmt.Errorf(\"read idempotency receipt: %w\", err)\n316|\t\t}\n317|\t\treceipt, err := decodeReceipt(raw)\n318|\t\tif err != nil {\n319|\t\t\treturn nil, err\n320|\t\t}\n321|\t\treceipts = append(receipts, receipt)\n322|\t}\n323|\tsort.Slice(receipts, func(i, j int) bool { return receipts[i].Key < receipts[j].Key })\n324|\tvar image strings.Builder\n325|\tfor _, receipt := range receipts {\n326|\t\timage.WriteString(receipt.Key + \"\\n\" + string(receipt.Operation) + \"\\n\" + receipt.OperationID + \"\\n\")\n327|\t}\n328|\treturn []byte(image.String()), nil\n329|}\n330|\n331|// isReceiptName reports whether a directory entry is a committed receipt\n332|// file: exactly 64 lowercase hex characters. Staging files\n333|// (receipt-*.tmp, result-*.tmp) and anything else are ignored.\n334|func isReceiptName(name string) bool {\n335|\tif len(name) != 64 {\n336|\t\treturn false\n337|\t}\n338|\tfor i := 0; i < len(name); i++ {\n339|\t\tdigit := name[i]\n340|\t\tif (digit < '0' || digit > '9') && (digit < 'a' || digit > 'f') {\n341|\t\t\treturn false\n342|\t\t}\n343|\t}\n344|\treturn true\n345|}\n346|\n347|// stagingSweepAge is the minimum age of a staging file the sweep may\n348|// remove. A concurrent Bind stages its own *.tmp between our stage and\n349|// our link; sweeping only files older than this bound keeps a live\n350|// stage alive, while crash garbage (whose mtime stops at the crash)\n351|// ages out on a later call. Readers and Export ignore staging names,\n352|// so a young leftover is invisible until it ages.\n353|const stagingSweepAge = time.Minute\n354|\n355|// sweepStaging removes staging garbage a pre-commit crash left behind.\n356|// Staging files carry the *.tmp suffix; committed receipts never do, so\n357|// the sweep cannot remove a commit. Only files older than\n358|// stagingSweepAge are removed, so a concurrent live stage is never\n359|// deleted: without the age gate a racing Bind would lose its staged\n360|// file and fail its no-replace link with a spurious install error.\n361|func sweepStaging(dir string) {\n362|\tentries, err := os.ReadDir(dir)\n363|\tif err != nil {\n364|\t\treturn\n365|\t}\n366|\tnow := time.Now()\n367|\tfor _, entry := range entries {\n368|\t\tif entry.IsDir() || !strings.HasSuffix(entry.Name(), \".tmp\") {\n369|\t\t\tcontinue\n370|\t\t}\n371|\t\tinfo, err := entry.Info()\n372|\t\tif err != nil {\n373|\t\t\tcontinue\n374|\t\t}\n375|\t\tif now.Sub(info.ModTime()) < stagingSweepAge {\n376|\t\t\tcontinue\n377|\t\t}\n378|\t\t_ = os.Remove(filepath.Join(dir, entry.Name()))\n379|\t}\n380|}\n381|\n382|// syncDirectory fsyncs a directory so committed links survive a crash.\n383|func syncDirectory(dir string) error {\n384|\thandle, err := os.Open(dir)\n385|\tif err != nil {\n386|\t\treturn fmt.Errorf(\"open receipt directory: %w\", err)\n387|\t}\n388|\tdefer func() { _ = handle.Close() }()\n389|\tif err := handle.Sync(); err != nil {\n390|\t\treturn fmt.Errorf(\"sync receipt directory: %w\", err)\n391|\t}\n392|\treturn nil\n393|}","final_result":true}}}
