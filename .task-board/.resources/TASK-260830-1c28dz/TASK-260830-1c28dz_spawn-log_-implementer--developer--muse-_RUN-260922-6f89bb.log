  ),\n2768|    Mutant(\n2769|        name=\"N-incarnation-foreign\",\n2770|        path=f\"{PACKAGE}/state.go\",\n2771|        find='\\tif document.TerminalInstanceID != instanceID {\\n\\t\\treturn \"\", false, &Error{Code: CodeInvalidArguments, Detail: \"instance incarnation identity\"}\\n\\t}\\n',\n2772|        replace='\\tif document.TerminalInstanceID != instanceID && document.TerminalInstanceID != \"0198f4c8-8e50-7f66-8f70-111111111111\" {\\n\\t\\treturn \"\", false, &Error{Code: CodeInvalidArguments, Detail: \"instance incarnation identity\"}\\n\\t}\\n',\n2773|        count=1,\n2774|        run=\"TestInstanceIncarnationRoundTrip\",\n2775|        expect=\"KILLED\",\n2776|        note=\"Admits exactly the foreign incarnation document past the lookup identity binding; every other foreign document still refuses. Kill path: the adopted document reports another incarnation as this one.\",\n2777|    ),\n2778|    Mutant(\n2779|        name=\"N-incarnation-empty-key\",\n2780|        path=f\"{PACKAGE}/state.go\",\n2781|        find='\\tif document.Key == \"\" {\\n\\t\\treturn \"\", false, &Error{Code: CodeInvalidArguments, Detail: \"instance incarnation key\"}\\n\\t}\\n',\n2782|        replace='\\tif document.Key == \"\" && document.TerminalInstanceID != \"0198f4c8-8e50-7f66-8f70-222222222221\" {\\n\\t\\treturn \"\", false, &Error{Code: CodeInvalidArguments, Detail: \"instance incarnation key\"}\\n\\t}\\n',\n2783|        count=1,\n2784|        run=\"TestInstanceIncarnationRoundTrip\",\n2785|        expect=\"KILLED\",\n2786|        note=\"Admits exactly the empty-key document for the fixture instance past the lookup key arm; empty keys for other instances still refuse. Kill path: the keyless incarnation replays as the zero rotation.\",\n2787|    ),\n2788|    Mutant(\n2789|        name=\"C-control\",\n2790|        path=f\"{PACKAGE}/errors.go\",\n2791|        find=\"// Error is a package-local refusal. Code is one of the Code*\",\n2792|        replace=\"// Error is a package-local refusal (harness control: comment-only). Code is one of the Code*\",\n2793|        count=1,\n2794|        run=\"TestSocketPathDerivesOnlyFromRuntimeDir\",\n2795|        expect=\"SURVIVED\",\n2796|        note=\"Harmless control: a comment-only edit that must SURVIVE, proving the harness observes outcomes.\",\n2797|    ),\n2798|]\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
