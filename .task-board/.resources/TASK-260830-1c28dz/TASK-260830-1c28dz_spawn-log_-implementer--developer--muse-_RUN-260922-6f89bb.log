.Platform); err != nil {\\n\\t\\treturn empty, err\\n\\t}\\\"\\\"\\\"\\nnew=\\\"\\\"\\\"\\tif err := CheckSocketCustody(socket, lc.Root, lc.Platform); err != nil && operation != terminalbackend.OperationAttach {\\n\\t\\treturn empty, err\\n\\t}\\\"\\\"\\\"\\nassert s.count(old)==1, s.count(old)\\nopen(p,'w').write(s.replace(old,new))\\nprint(\\\"plantC applied\\\")\\nEOF\\ngo test ./internal/tmuxserver/ -run 'TestExecuteAttachRefusesWritableRootValidBody' -count=1 > /tmp/plantC.log 2>&1; echo \\\"PLANTC go-test exit: $?\\\"\\ngrep -E \\\"^(---|FAIL|ok|PASS)|want\\\" /tmp/plantC.log | head -n 5\\ncp /tmp/lifecycle.go.keep internal/tmuxserver/lifecycle.go && echo RESTORED\\ngit status --short internal/tmuxserver/ops.go internal/tmuxserver/lifecycle.go internal/tmuxserver/state.go; git diff --stat internal/tmuxserver/ops.go internal/tmuxserver/lifecycle.go internal/tmuxserver/state.go | tail -n 5\",\n  \"description\": \"Verify R3 and custody plants kill\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"plantR3 applied\\nPLANTR3 go-test exit: 1\\n--- FAIL: TestExecuteAttachErrorsOnOutcomeFileReadFailure (0.02s)\\n    lifecycle_rev6_unix_test.go:283: unreadable outcome document admitted attach\\nFAIL\\nFAIL\\tgithub.com/relux-works/agent-session-manager/internal/tmuxserver\\t0.316s\\nRESTORED\\nplantC applied\\nPLANTC go-test exit: 1\\n--- FAIL: TestExecuteAttachRefusesWritableRootValidBody (0.02s)\\n    lifecycle_rev6_unix_test.go:305: want error tmux_unsafe_socket_path at socket root, got nil\\nFAIL\\nFAIL\\tgithub.com/relux-works/agent-session-manager/internal/tmuxserver\\t0.327s\\nFAIL\\nRESTORED\\n?? internal/tmuxserver/lifecycle.go\\n?? internal/tmuxserver/ops.go\\n?? internal/tmuxserver/state.go\\n\",\n  \"original_output_bytes\": 670,\n  \"original_output_tokens\": 168,\n  \"truncated\": false\n}","final_result":true}}}
