Err(\"canonicaljson\", \"Canonicalize\", \"valid\", err)\n162|\t} else {\n163|\t\temit(\"canonicaljson\", \"Canonicalize\", \"valid\", \"ok\", \"\", string(raw))\n164|\t}\n165|\t_, err = canonicaljson.Canonicalize([]byte(`{\"a\":`))\n166|\temitErr(\"canonicaljson\", \"Canonicalize\", \"truncated\", err)\n167|\t_, err = canonicaljson.Canonicalize(nil)\n168|\temitErr(\"canonicaljson\", \"Canonicalize\", \"empty\", err)\n169|\temitErr(\"canonicaljson\", \"ValidateObservationEvent\", \"garbage\", canonicaljson.ValidateObservationEvent([]byte(`[1,2`)))\n170|\temitErr(\"canonicaljson\", \"ValidateObservationEvent\", \"empty-object\", canonicaljson.ValidateObservationEvent([]byte(`{}`)))\n171|\temitErr(\"canonicaljson\", \"ValidateObservationStream\", \"empty\", canonicaljson.ValidateObservationStream(nil))\n172|}\n173|\n174|// --- cigate ---\n175|\n176|func gridCigate() {\n177|\tids, err := cigate.CapabilityIDs()\n178|\tif err != nil {\n179|\t\temitErr(\"cigate\", \"CapabilityIDs\", \"none\", err)\n180|\t} else {\n181|\t\temit(\"cigate\", \"CapabilityIDs\", \"none\", \"ok\", \"\", joinSorted(ids))\n182|\t}\n183|\ttargets, err := cigate.FuzzTargets()\n184|\tif err != nil {\n185|\t\temitErr(\"cigate\", \"FuzzTargets\", \"none\", err)\n186|\t} else {\n187|\t\temit(\"cigate\", \"FuzzTargets\", \"none\", \"ok\", \"\", joinSorted(targets))\n188|\t}\n189|\treleases, err := cigate.PinnedReleases()\n190|\tif err != nil {\n191|\t\temitErr(\"cigate\", \"PinnedReleases\", \"none\", err)\n192|\t} else {\n193|\t\temit(\"cigate\", \"PinnedReleases\", \"none\", \"ok\", \"\", joinSorted(releases))\n194|\t}\n195|\temit(\"cigate\", \"SortedReleases\", \"fixed\", \"ok\", \"\", strings.Join(cigate.SortedReleases(map[string][]cigate.ContractVersions{\n196|\t\t\"b\": {{Name: \"c\", Versions: []string{\"1.0\"}}},\n197|\t\t\"a\": {{Name: \"c\", Versions: []string{\"1.0\"}}},\n198|\t}), \",\"))\n199|\temitErr(\"cigate\", \"VerifyContractPreservation\", \"none\", cigate.VerifyContractPreservation())\n(more lines below)","final_result":true}}}
