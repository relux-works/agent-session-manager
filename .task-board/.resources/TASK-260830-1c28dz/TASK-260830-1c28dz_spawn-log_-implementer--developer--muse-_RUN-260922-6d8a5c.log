{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000daf1","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":3027,"recorded_at":1780531400006049,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"task_stream":{"kind":"task","id":"01a0c6f6-b716-73f2-b84b-63149e372a29"},"task_id":"01a0c6f6-b716-73f2-b84b-63149e372a29","event":{"kind":"output","task_id":"01a0c6f6-b716-73f2-b84b-63149e372a29","chunk":"Read text file `internal/tmuxserver/backend_test.go`.\n(59 line(s) above)\n60|\treqBackend := effectBackend(t, terminalbackend.OperationCreate, newFakeRunner())\n61|\tid, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectBindingPersisted)\n62|\tif err != nil {\n63|\t\tt.Fatal(err)\n64|\t}\n65|\tif id != lxDigestA {\n66|\t\tt.Fatalf(\"evidence = %s\", id)\n67|\t}\n68|\t// Identical retry replays the one receipt.\n69|\tid2, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectBindingPersisted)\n70|\tif err != nil || id2 != id {\n71|\t\tt.Fatalf(\"replay = %s, %v\", id2, err)\n72|\t}\n73|}\n74|\n75|func TestPerformEffectWrapperStart(t *testing.T) {\n76|\trunner := newFakeRunner().queue(\"new-session\", \"\", 0)\n77|\treqBackend := effectBackend(t, terminalbackend.OperationCreate, runner)\n78|\tid, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectWrapperStarted)\n79|\tif err != nil {\n80|\t\tt.Fatal(err)\n81|\t}\n82|\trequireDigest(t, id)\n83|\tcalls := runner.subcommands()\n84|\tif len(calls) != 1 || calls[0] != \"new-session\" {\n85|\t\tt.Fatalf(\"calls = %v\", calls)\n86|\t}\n87|}\n88|\n89|func TestPerformEffectRefusesFailedExec(t *testing.T) {\n90|\trunner := newFakeRunner().queue(\"new-session\", \"\", 1)\n91|\treqBackend := effectBackend(t, terminalbackend.OperationCreate, runner)\n92|\tif _, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectWrapperStarted); err == nil {\n93|\t\tt.Fatal(\"failed exec committed\")\n94|\t} else {\n95|\t\trequireEngineCode(t, err, \"terminal_backend_process_failed\")\n96|\t}\n97|}\n98|\n99|func TestPerformEffectTransportProvesNothing(t *testing.T) {\n100|\trunner := newFakeRunner().failTransport(\"new-session\", errFakeTransport)\n101|\treqBackend := effectBackend(t, terminalbackend.OperationCreate, runner)\n102|\t_, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectWrapperStarted)\n103|\tif err != errFakeTransport {\n104|\t\tt.Fatalf(\"err = %v, want the transport failure\", err)\n105|\t}\n106|}\n107|\n108|func TestPerformEffectInputClosed(t *testing.T) {\n109|\trunner := newFakeRunner().queue(\"lock-session\", \"\", 0)\n110|\treqBackend := effectBackend(t, terminalbackend.OperationQuiesceInput, runner)\n111|\tid, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectInputClosed)\n112|\tif err != nil {\n113|\t\tt.Fatal(err)\n114|\t}\n115|\trequireDigest(t, id)\n116|}\n117|\n118|func TestPerformEffectBoundaryObserved(t *testing.T) {\n119|\trunner := newFakeRunner().queue(\"wait-for\", \"\", 0)\n120|\treqBackend := effectBackend(t, terminalbackend.OperationWaitSafeBoundary, runner)\n121|\treqBackend.quiescence = lxQuiesce\n122|\treqBackend.channel = BoundaryChannelPrefix + lxQuiesce\n123|\treqBackend.waitCtx = context.Background()\n124|\tid, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectSafeBoundaryObserved)\n125|\tif err != nil {\n126|\t\tt.Fatal(err)\n127|\t}\n128|\trequireDigest(t, id)\n129|}\n130|\n131|func TestPerformEffectBoundaryTimeout(t *testing.T) {\n132|\tctx, cancel := context.WithCancel(context.Background())\n133|\tcancel()\n134|\trunner := newFakeRunner().failTransport(\"wait-for\", context.Canceled)\n135|\treqBackend := effectBackend(t, terminalbackend.OperationWaitSafeBoundary, runner)\n136|\treqBackend.quiescence = lxQuiesce\n137|\treqBackend.channel = BoundaryChannelPrefix + lxQuiesce\n138|\treqBackend.waitCtx = ctx\n139|\tif _, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectSafeBoundaryObserved); err == nil {\n140|\t\tt.Fatal(\"expired wait committed\")\n141|\t} else {\n142|\t\trequireEngineCode(t, err, \"quiesce_timeout\")\n143|\t}\n144|}\n145|\n146|func TestPerformEffectStopLadder(t *testing.T) {\n147|\t// Graceful close on first confirm: send-keys, has (absent).\n148|\trunner := newFakeRunner().queueFull(\"has-session\", \"\", \"can't find session: \" + lxInstance, 1)\n149|\treqBackend := effectBackend(t, terminalbackend.OperationRequestStop, runner)\n150|\tid, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectProcessClosed)\n151|\tif err != nil {\n152|\t\tt.Fatal(err)\n153|\t}\n154|\trequireDigest(t, id)\n155|\tif got := runner.subcommands(); len(got) != 1 || got[0] != \"has-session\" {\n156|\t\tt.Fatalf(\"calls = %v\", got)\n157|\t}\n158|}\n159|\n160|func TestPerformEffectStopEscalates(t *testing.T) {\n161|\t// Live, live, then absent after the kill escalation.\n162|\trunner := newFakeRunner().\n163|\t\tqueue(\"has-session\", \"\", 0).\n164|\t\tqueue(\"kill-session\", \"\", 0).\n165|\t\tqueueFull(\"has-session\", \"\", \"can't find session: \" + lxInstance, 1)\n166|\treqBackend := effectBackend(t, terminalbackend.OperationRequestStop, runner)\n167|\treqBackend.deadline = lxNow().Add(-time.Minute)\n168|\tif _, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectProcessClosed); err != nil {\n169|\t\tt.Fatal(err)\n170|\t}\n171|\tgot := runner.subcommands()\n172|\twant := []string{\"has-session\", \"kill-session\", \"has-session\"}\n173|\tif len(got) != 3 {\n174|\t\tt.Fatalf(\"calls = %v\", got)\n175|\t}\n176|\tfor i := range want {\n177|\t\tif got[i] != want[i] {\n178|\t\t\tt.Fatalf(\"calls = %v, want %v\", got, want)\n179|\t\t}\n(more lines below)","final_result":true}}}
