{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7cb","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":576,"recorded_at":1780531400001147,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"task_stream":{"kind":"task","id":"01a0c6da-e52d-7e40-9b10-286a1ee02460"},"task_id":"01a0c6da-e52d-7e40-9b10-286a1ee02460","event":{"kind":"output","task_id":"01a0c6da-e52d-7e40-9b10-286a1ee02460","chunk":"Read text file `internal/tmuxserver/state.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\t\"errors\"\n6|\t\"fmt\"\n7|\t\"os\"\n8|\t\"path/filepath\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n12|)\n13|\n14|// InstanceStates is the durable AX-side state memory for tmux-hosted\n15|// terminal instances: one JSON document per instance under\n16|// <root>/tmuxlifecycle/instances/<instance_id>.json, installed by\n17|// atomic rename. tmux itself reports only presence (sessions, panes,\n18|// attached counts); the AX states quiescing, stopped, and stale_fenced\n19|// exist only on this side, so status reconciles the live tmux probe\n20|// against this memory (see ClassifyStatus). The store is MUTABLE —\n21|// every mutating operation records its after-state — unlike the\n22|// no-replace idempotency receipts, whose keys can never name a state.\n23|//\n24|// The store is rooted at a DURABLE data root, never the runtime root:\n25|// the runtime root is per-boot temporary, while status after reboot\n26|// must still distinguish a stopped instance from an absent one.\n27|type InstanceStates struct {\n28|\troot  string\n29|\thooks *StateHooks\n30|}\n31|\n32|// StateHooks arms the crash boundaries of the state install: after the\n33|// state bytes are staged to the temporary file (before the atomic\n34|// rename), and after the rename commits (before the directory sync\n35|// makes the commit durable). A nil hook is a no-op; a hook error aborts\n36|// the call with that error. Hooks is nil in production.\n37|type StateHooks struct {\n38|\tAfterStage   func(path string) error\n39|\tAfterInstall func(path string) error\n40|}\n41|\n42|// stateDocument is the stored shape: exactly schema, schema_version,\n43|// terminal_instance_id, and state.\n44|type stateDocument struct {\n45|\tSchema             string `json:\"schema\"`\n46|\tSchemaVersion      string `json:\"schema_version\"`\n47|\tTerminalInstanceID string `json:\"terminal_instance_id\"`\n48|\tState              string `json:\"state\"`\n49|}\n50|\n51|// OpenInstanceStates creates the store, ensuring the root exists. It\n52|// creates no instance documents: those appear with the first Record.\n53|func OpenInstanceStates(root string) (*InstanceStates, error) {\n54|\tif root == \"\" {\n55|\t\treturn nil, errors.New(\"tmux instance state root is empty\")\n56|\t}\n57|\tbase := filepath.Join(root, \"tmuxlifecycle\", \"instances\")\n58|\tif err := os.MkdirAll(base, 0o755); err != nil {\n59|\t\treturn nil, fmt.Errorf(\"create tmux instance state root: %w\", err)\n60|\t}\n61|\treturn &InstanceStates{root: root}, nil\n62|}\n63|\n64|// WithHooks returns the store with crash hooks armed.\n65|func (store *InstanceStates) WithHooks(hooks *StateHooks) *InstanceStates {\n66|\tstore.hooks = hooks\n67|\treturn store\n68|}\n69|\n70|func (store *InstanceStates) instancePath(instanceID string) string {\n71|\treturn filepath.Join(store.root, \"tmuxlifecycle\", \"instances\", instanceID+\".json\")\n72|}\n73|\n74|// Record stores the after-state of one mutating operation for one\n75|// instance. The install is atomic (stage, fsync, rename, directory\n76|// fsync): a crash leaves the previous state or the new state, never a\n77|// torn document, and a retry converges by re-recording. Only AX\n78|// lifecycle states record; creating never records (it exists only\n79|// between the idempotency receipt and the first side effect, and the\n80|// receipt already proves that window).\n81|func (store *InstanceStates) Record(instanceID string, state terminalbackend.InstanceState) error {\n82|\tif store == nil {\n83|\t\treturn errors.New(\"tmux instance state store is nil\")\n84|\t}\n85|\tif _, err := scalar.ParseUUIDv7(instanceID); err != nil {\n86|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance state identity\"}\n87|\t}\n88|\tif _, err := terminalbackend.ParseInstanceState(string(state)); err != nil {\n89|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance state value\"}\n90|\t}\n91|\tif state == terminalbackend.StateCreating {\n92|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance state value\"}\n93|\t}\n94|\traw, err := json.Marshal(stateDocument{\n95|\t\tSchema:             \"urn:ax:schema:tmux-instance-state\",\n96|\t\tSchemaVersion:      \"1.0.0\",\n97|\t\tTerminalInstanceID: instanceID,\n98|\t\tState:              string(state),\n99|\t})\n100|\tif err != nil {\n101|\t\treturn fmt.Errorf(\"encode tmux instance state: %w\", err)\n102|\t}\n103|\treturn store.install(instanceID, raw)\n104|}\n105|\n106|// Lookup replays the recorded state for one instance, or reports\n107|// absence when the instance was never recorded. A read or validation\n108|// failure is an error, never absence: unknown is not absent.\n109|func (store *InstanceStates) Lookup(instanceID string) (terminalbackend.InstanceState, bool, error) {\n110|\tif store == nil {\n111|\t\treturn \"\", false, errors.New(\"tmux instance state store is nil\")\n112|\t}\n113|\tif _, err := scalar.ParseUUIDv7(instanceID); err != nil {\n114|\t\treturn \"\", false, &Error{Code: CodeInvalidArguments, Detail: \"instance state identity\"}\n115|\t}\n116|\traw, err := os.ReadFile(store.instancePath(instanceID))\n117|\tif err != nil {\n118|\t\tif errors.Is(err, os.ErrNotExist) {\n119|\t\t\treturn \"\", false, nil\n120|\t\t}\n121|\t\treturn \"\", false, fmt.Errorf(\"read tmux instance state: %w\", err)\n122|\t}\n123|\tvar document stateDocument\n124|\tif err := json.Unmarshal(raw, &document); err != nil {\n125|\t\treturn \"\", false, fmt.Errorf(\"decode tmux instance state: %w\", err)\n126|\t}\n127|\tif document.TerminalInstanceID != instanceID {\n128|\t\treturn \"\", false, &Error{Code: CodeInvalidArguments, Detail: \"instance state identity\"}\n129|\t}\n130|\tstate, err := terminalbackend.ParseInstanceState(document.State)\n131|\tif err != nil {\n132|\t\treturn \"\", false, &Error{Code: CodeInvalidArguments, Detail: \"instance state value\"}\n133|\t}\n134|\treturn state, true, nil\n135|}\n136|\n137|// install stages the state bytes to a same-directory temporary file,\n138|// fsyncs it, atomically renames it over the instance document (rename\n139|// is the mutable commit: the new state supersedes), removes no prior\n140|// name, and fsyncs the directory. Stale staging files from a\n141|// pre-commit crash are swept before the install.\n142|func (store *InstanceStates) install(instanceID string, raw []byte) error {\n143|\tdir := filepath.Join(store.root, \"tmuxlifecycle\", \"instances\")\n144|\tif err := os.MkdirAll(dir, 0o755); err != nil {\n145|\t\treturn fmt.Errorf(\"create tmux instance state directory: %w\", err)\n146|\t}\n147|\tsweepStateStaging(dir)\n148|\tstaged, err := os.CreateTemp(dir, \"state-*.tmp\")\n149|\tif err != nil {\n150|\t\treturn fmt.Errorf(\"stage tmux instance state: %w\", err)\n151|\t}\n152|\tstagedPath := staged.Name()\n153|\tcommitted := false\n154|\tdefer func() {\n155|\t\tif !committed {\n156|\t\t\t_ = os.Remove(stagedPath)\n157|\t\t}\n158|\t}()\n159|\tif err := staged.Chmod(0o600); err != nil {\n160|\t\t_ = staged.Close()\n161|\t\treturn fmt.Errorf(\"protect tmux instance state: %w\", err)\n162|\t}\n163|\tif _, err := staged.Write(raw); err != nil {\n164|\t\t_ = staged.Close()\n165|\t\treturn fmt.Errorf(\"write tmux instance state: %w\", err)\n166|\t}\n167|\tif err := staged.Sync(); err != nil {\n168|\t\t_ = staged.Close()\n169|\t\treturn fmt.Errorf(\"sync tmux instance state: %w\", err)\n170|\t}\n171|\tif err := staged.Close(); err != nil {\n172|\t\treturn fmt.Errorf(\"close tmux instance state: %w\", err)\n173|\t}\n174|\tif store.hooks != nil && store.hooks.AfterStage != nil {\n175|\t\tif err := store.hooks.AfterStage(stagedPath); err != nil {\n176|\t\t\treturn err\n177|\t\t}\n178|\t}\n179|\tif err := os.Rename(stagedPath, store.instancePath(instanceID)); err != nil {\n180|\t\treturn fmt.Errorf(\"install tmux instance state: %w\", err)\n181|\t}\n182|\tcommitted = true\n183|\tif store.hooks != nil && store.hooks.AfterInstall != nil {\n184|\t\tif err := store.hooks.AfterInstall(store.instancePath(instanceID)); err != nil {\n185|\t\t\treturn err\n186|\t\t}\n187|\t}\n188|\tif err := syncStateDirectory(dir); err != nil {\n189|\t\treturn err\n190|\t}\n191|\treturn nil\n192|}\n193|\n194|// sweepStateStaging removes stale staging files from pre-commit\n195|// crashes. Only the state-*.tmp pattern is swept; instance documents\n196|// are never touched.\n197|func sweepStateStaging(dir string) {\n198|\tentries, err := os.ReadDir(dir)\n199|\tif err != nil {\n200|\t\treturn\n201|\t}\n202|\tfor _, entry := range entries {\n203|\t\tname := entry.Name()\n204|\t\tif len(name) > 10 && name[:6] == \"state-\" && filepath.Ext(name) == \".tmp\" {\n205|\t\t\t_ = os.Remove(filepath.Join(dir, name))\n206|\t\t}\n207|\t}\n208|}\n209|\n210|// syncStateDirectory fsyncs the directory so the rename commit is\n211|// durable before Record returns.\n212|func syncStateDirectory(path string) error {\n213|\tdir, err := os.Open(path)\n214|\tif err != nil {\n215|\t\treturn err\n216|\t}\n217|\tdefer func() { _ = dir.Close() }()\n218|\treturn dir.Sync()\n219|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7cd","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":577,"recorded_at":1780531400001149,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"task_stream":{"kind":"task","id":"01a0c6da-e52d-7e40-9b10-286a1ee02460"},"task_id":"01a0c6da-e52d-7e40-9b10-286a1ee02460","event":{"kind":"completed","task_id":"01a0c6da-e52d-7e40-9b10-286a1ee02460"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7cf","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":578,"recorded_at":1780531400001151,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"task_stream":{"kind":"task","id":"01a0c6da-e54a-7330-912b-b247a9ba7472"},"task_id":"01a0c6da-e54a-7330-912b-b247a9ba7472","event":{"kind":"output","task_id":"01a0c6da-e54a-7330-912b-b247a9ba7472","chunk":"Read text file `internal/tmuxserver/errors.go`.\n1|package tmuxserver\n2|\n3|// Local refusal codes. The spec names capability_unavailable for the\n4|// background broker-or-refuse path (emitted through axerror with its\n5|// typed details); the codes below name the package-local safety gates\n6|// the spec states as MUST NOT rules without assigning a wire code.\n7|// Tests assert the literal strings, never these constants.\n8|const (\n9|\t// CodeAmbientReuse refuses an explicit socket override: the only\n10|\t// admissible server socket is the one derived from the runtime\n11|\t// directory, so any caller-supplied socket (ambient environment\n12|\t// value, inherited socket, default path, or conventional name)\n13|\t// refuses instead of redirecting acquisition.\n14|\tCodeAmbientReuse = \"tmux_ambient_server_reuse\"\n15|\t// CodeBackgroundCreationRefused refuses direct server creation\n16|\t// on the background path. A background caller never creates; it\n17|\t// contacts the broker or receives capability_unavailable.\n18|\tCodeBackgroundCreationRefused = \"tmux_background_creation_refused\"\n19|\t// CodeUnsafeRuntimeDir refuses a runtime directory that fails\n20|\t// any of the three custody gates: mode, ownership, containment.\n21|\tCodeUnsafeRuntimeDir = \"tmux_unsafe_runtime_dir\"\n22|\t// CodeReadinessNotAuthorizing refuses an authorization attempt\n23|\t// backed only by a diagnostic hint or a cached observation.\n24|\tCodeReadinessNotAuthorizing = \"tmux_readiness_not_authorizing\"\n25|\t// CodeInvalidArguments refuses a malformed acquisition request:\n26|\t// unknown caller, unknown platform, malformed generation, or\n27|\t// missing typed-detail members.\n28|\tCodeInvalidArguments = \"tmux_invalid_arguments\"\n29|\t// CodeSpawnFailed reports a dedicated-server spawn failure.\n30|\t// The spawner is caller-supplied; this code carries no fallback.\n31|\tCodeSpawnFailed = \"tmux_server_spawn_failed\"\n32|\t// CodeUnsafeSocketPath refuses a socket path, parent, or ancestor\n33|\t// whose file kind, ownership, or permissions are unsafe, before\n34|\t// bind or connect (SPEC 810-812). It names the lifecycle bind\n35|\t// step's rejection; the runtime leaf custody it delegates to keeps\n36|\t// its own code.\n37|\tCodeUnsafeSocketPath = \"tmux_unsafe_socket_path\"\n38|\t// CodeSocketPathTooLong refuses a derived socket path that cannot\n39|\t// fit the platform sun_path, before bind or connect, so a deep\n40|\t// runtime root reports the length refusal instead of surfacing as\n41|\t// a spawn failure in the adapter.\n42|\tCodeSocketPathTooLong = \"tmux_socket_path_too_long\"\n43|)\n44|\n45|// Error is a package-local refusal. Code is one of the Code*\n46|// constants; Detail is a static clause naming the gate. It never\n47|// echoes paths, socket names, generations, or environment values.\n48|type Error struct {\n49|\tCode   string\n50|\tDetail string\n51|}\n52|\n53|func (err *Error) Error() string {\n54|\treturn \"tmux server refused: \" + err.Code + \" at \" + err.Detail\n55|}","final_result":true}}}
