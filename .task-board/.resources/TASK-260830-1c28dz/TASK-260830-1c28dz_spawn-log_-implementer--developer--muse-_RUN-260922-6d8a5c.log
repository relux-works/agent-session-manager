{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000dd2b","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":3312,"recorded_at":1780531400006619,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"task_stream":{"kind":"task","id":"01a0c6f8-1a2b-7402-b95c-2446cb59947d"},"task_id":"01a0c6f8-1a2b-7402-b95c-2446cb59947d","event":{"kind":"output","task_id":"01a0c6f8-1a2b-7402-b95c-2446cb59947d","chunk":"Read text file `internal/tmuxserver/lifecycle_extra_unix_test.go`.\n(299 line(s) above)\n300|\t// outcomes, outside the backend-report rule the rows govern —\n301|\t// mirroring the landed engine, which reports the same verdict on\n302|\t// quiesce-input, wait-safe-boundary, and request-stop, whose rows\n303|\t// likewise lack the member. The verdict is pinned through the\n304|\t// resume-refusal tests, not through this oracle.\n305|}\n306|\n307|func TestRecordFailureLeavesPresenceReconciliation(t *testing.T) {\n308|\t// The state memory is advisory: when Record fails, the operation\n309|\t// still succeeds and later status reconciles from live presence.\n310|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n311|\tfx.lc.States.WithHooks(&StateHooks{AfterInstall: func(string) error {\n312|\t\treturn errFakeTransport\n313|\t}})\n314|\tfx.runner.queue(\"new-session\", \"\", 0)\n315|\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n316|\t\tOperation: \"create\", Body: lxCreateBody(t, nil), Source: \"absent\", Admitted: fullLifecycleAdmitted(),\n317|\t})\n318|\tif err != nil {\n319|\t\tt.Fatalf(\"create failed on memory failure: %v\", err)\n320|\t}\n321|\tif outcome.Mutation.After != terminalbackend.StateActive {\n322|\t\tt.Fatalf(\"after = %s\", outcome.Mutation.After)\n323|\t}\n324|\tfx.lc.States.WithHooks(nil)\n325|\t// No memory plus a live session reads parked (zero attached).\n326|\tfx.runner.queue(\"list-panes\", \"sh\\n\", 0).queue(\"list-sessions\", lxInstance+\"|0\\n\", 0)\n327|\tstatus, err := fx.lc.Execute(context.Background(), OpRequest{\n328|\t\tOperation: \"status\", Body: lxStatusBody(t, true, false, nil), Admitted: fullLifecycleAdmitted(),\n329|\t})\n330|\tif err != nil {\n331|\t\tt.Fatal(err)\n332|\t}\n333|\tif status.Status.State != terminalbackend.StateParked {\n334|\t\tt.Fatalf(\"status = %s\", status.Status.State)\n335|\t}\n336|}\n337|\n338|func TestQuiesceTimeoutCodeUnreachableOnWrongRows(t *testing.T) {\n339|\t// quiesce_timeout is admitted only on wait-safe-boundary and\n340|\t// stop_timeout only on request-stop: the oracle pins both.\n341|\tif err := terminalbackend.CheckErrorAllowed(\"wait-safe-boundary\", \"quiesce_timeout\"); err != nil {\n342|\t\tt.Fatalf(\"boundary refuses its timeout: %v\", err)\n343|\t}\n344|\tif err := terminalbackend.CheckErrorAllowed(\"request-stop\", \"stop_timeout\"); err != nil {\n345|\t\tt.Fatalf(\"stop refuses its timeout: %v\", err)\n346|\t}\n347|\tfor _, operation := range []string{\"create\", \"attach\", \"status\", \"quiesce-input\", \"terminate-stale\", \"restore\"} {\n348|\t\tif err := terminalbackend.CheckErrorAllowed(operation, \"quiesce_timeout\"); err == nil {\n349|\t\t\tt.Fatalf(\"row %s admits quiesce_timeout\", operation)\n(more lines below)","final_result":true}}}
