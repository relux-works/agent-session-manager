rt) })\n41|\troot := filepath.Join(short, \"r\")\n42|\tif err := os.Mkdir(root, 0o755); err != nil {\n43|\t\tt.Fatal(err)\n44|\t}\n45|\truntime, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n46|\tif err != nil {\n47|\t\tt.Fatal(err)\n48|\t}\n49|\tsocket := SocketPath(runtime)\n50|\tlistener, err := net.Listen(\"unix\", socket)\n51|\tif err != nil {\n52|\t\tt.Fatal(err)\n53|\t}\n54|\tdefer listener.Close()\n55|\tif err := CheckSocketCustody(socket, root, scalar.PlatformMacOS); err != nil {\n56|\t\tt.Fatalf(\"live socket refused: %v\", err)\n57|\t}\n58|}\n59|\n60|func TestCheckSocketCustodyRefusesUnsafeRoot(t *testing.T) {\n61|\troot, socket := lxCustodyRoot(t)\n62|\tif err := os.Chmod(root, 0o777); err != nil {\n63|\t\tt.Fatal(err)\n64|\t}\n65|\tdefer os.Chmod(root, 0o755)\n66|\tif err := CheckSocketCustody(socket, root, scalar.PlatformMacOS); err == nil {\n67|\t\tt.Fatal(\"0777 root admitted\")\n68|\t} else {\n69|\t\trequireLocalCode(t, err, \"tmux_unsafe_socket_path\", \"socket root\")\n70|\t}\n71|}\n72|\n73|func TestCheckSocketCustodyRefusesForeignRoot(t *testing.T) {\n74|\troot, socket := lxCustodyRoot(t)\n75|\tprevious := effectiveUID\n76|\teffectiveUID = func() int { return previous() + 100000 }\n77|\tdefer func() { effectiveUID = previous }()\n78|\t// The leaf custody delegates to the same seam, so a foreign root\n79|\t// refuses at the leaf ownership arm first; the bind step still\n80|\t// refuses rather than admitting.\n(more lines below)","final_result":true}}}
