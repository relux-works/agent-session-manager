{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d5cb","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":2368,"recorded_at":1780531400004731,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"task_stream":{"kind":"task","id":"01a0c6f2-8c9d-74e2-868e-5342c9e84aa0"},"task_id":"01a0c6f2-8c9d-74e2-868e-5342c9e84aa0","event":{"kind":"output","task_id":"01a0c6f2-8c9d-74e2-868e-5342c9e84aa0","chunk":"edited\nchanged lines: lines 59-65\n--- original\n+++ updated\n@@\n-\t// ServerAdmission reports the live server attestation the attach\n-\t// handler binds to the request generation (the P3-A wiring: a\n-\t// fresh decoy admission refuses here). Nil refuses attach only.\n-\tServerAdmission func() (RealmAdmission, error)\n-\t// Hooks observes receipts and effects. Nil disables observation.\n-\tHooks *terminstance.EngineHooks\n-}\n+\t// ServerAdmission reports the live server attestation the attach\n+\t// handler binds to the request generation (the P3-A wiring: a\n+\t// fresh decoy admission refuses here). Nil refuses attach only.\n+\tServerAdmission func() (RealmAdmission, error)\n+\t// LocalHostID is the AX host identity the after-restore branch\n+\t// compares the winning lease holder against. Empty cannot prove\n+\t// a local win, so restores report parked or a remote offer only.\n+\tLocalHostID string\n+\t// LeaseRefresh attempts the §4.2 mesh lease refresh (after-restore\n+\t// step 2) under a timeout context. Nil skips the attempt and the\n+\t// branch decides over the locally known lease. A failed attempt\n+\t// also falls back to local knowledge: the refresh is attempted,\n+\t// never required.\n+\tLeaseRefresh func(ctx context.Context, sessionID string) (RefreshWinner, error)\n+\t// MeshRefreshTimeout bounds one refresh attempt. Non-positive\n+\t// means DefaultMeshRefreshTimeout. The bound is measured, not\n+\t// advisory: the refresh context carries exactly this deadline.\n+\tMeshRefreshTimeout time.Duration\n+\t// Materialization reports whether the required materialization\n+\t// for a restore checkpoint is valid (after-restore step 3). Nil\n+\t// reports invalid: local resume requires positive proof.\n+\tMaterialization func(sessionID, checkpointID string) (bool, error)\n+\t// Hooks observes receipts and effects. Nil disables observation.\n+\tHooks *terminstance.EngineHooks\n+}\n+\n+// DefaultMeshRefreshTimeout bounds the after-restore mesh lease\n+// refresh when the Lifecycle leaves it unset: five seconds, after\n+// which the branch proceeds on local knowledge instead of blocking\n+// forever.\n+const DefaultMeshRefreshTimeout = 5 * time.Second\n+\n+// RefreshWinner is one mesh lease-refresh answer: the winning lease\n+// tuple and its holder host.\n+type RefreshWinner struct {\n+\tLeaseID      string\n+\tEpoch        uint64\n+\tHolderHostID string\n+}\n+\n+// After-restore branch actions: the §4.2 steps 3-5 outcome the\n+// restore entry reports alongside the parked wire result.\n+const (\n+\t// AfterRestoreResumed reports a local resume: the local host\n+\t// holds the winning lease and the materialization is valid.\n+\tAfterRestoreResumed = \"resumed_locally\"\n+\t// AfterRestoreRemoteOffer reports a remote offer: another host\n+\t// owns the session and the restore runs in an interactive\n+\t// terminal.\n+\tAfterRestoreRemoteOffer = \"remote_offered\"\n+\t// AfterRestoreParked reports parked: every other case, with no\n+\t// provider launched.\n+\tAfterRestoreParked = \"parked\"\n+)\n+\n+// AfterRestoreOutcome is the restore entry's §4.2 branch report: the\n+// winning lease the branch decided over, whether the mesh refresh\n+// was attempted, the measured refresh bound in milliseconds, and the\n+// action. The backend never launches a provider on any branch — the\n+// wrapper owns launch gating through its own decision — so this\n+// report steers the caller, never a local provider.\n+type AfterRestoreOutcome struct {\n+\tAction           string\n+\tWinnerLeaseID    string\n+\tWinnerHostID     string\n+\tRefreshAttempted bool\n+\tRefreshBoundMs   uint64\n+}\n","final_result":true}}}
