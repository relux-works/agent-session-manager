{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000e8db","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":4808,"recorded_at":1780531400009611,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"task_stream":{"kind":"task","id":"01a0c711-1110-71f0-ad6c-d10c3b322186"},"task_id":"01a0c711-1110-71f0-ad6c-d10c3b322186","event":{"kind":"output","task_id":"01a0c711-1110-71f0-ad6c-d10c3b322186","chunk":"{\n  \"chunk_id\": \"exec-90-1\",\n  \"command\": \"python3 - <<'PYEOF'\\nfrom pathlib import Path\\np = Path(\\\"internal/tmuxserver/mutant_harness.py\\\")\\ntext = p.read_text()\\nanchor = '''    Mutant(\\n        name=\\\"C-control\\\",'''\\nassert text.count(anchor) == 1\\nrows = '''    Mutant(\\n        name=\\\"N-quiesce-close-exit\\\",\\n        path=f\\\"{PACKAGE}/backend.go\\\",\\n        find='\\\\\\\\t\\\\\\\\tif result.ExitCode != 0 {\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\treturn \\\"\\\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \\\"backend effect refused\\\"}\\\\\\\\n\\\\\\\\t\\\\\\\\t}\\\\\\\\n',\\n        replace='\\\\\\\\t\\\\\\\\tif result.ExitCode != 0 && result.ExitCode != 1 {\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\treturn \\\"\\\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \\\"backend effect refused\\\"}\\\\\\\\n\\\\\\\\t\\\\\\\\t}\\\\\\\\n',\\n        count=1,\\n        run=\\\"TestExecuteQuiesceRefusesFailedClose\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the exit-1 close step past the barrier exit arm; every other nonzero exit still refuses. Kill path: the failed lock/detach commits through the quiesce dispatch.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-restore-branch-holder\\\",\\n        path=f\\\"{PACKAGE}/ops.go\\\",\\n        find='\\\\\\\\t\\\\\\\\twinner.HolderHostID == lc.LocalHostID &&\\\\\\\\n',\\n        replace='\\\\\\\\t\\\\\\\\t(winner.HolderHostID == lc.LocalHostID || winner.HolderHostID == \\\"0198f4c8-8e50-7f66-8f70-777777777772\\\") &&\\\\\\\\n',\\n        count=1,\\n        run=\\\"TestExecuteRestoreRemoteOfferOnLapsedGrant\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the remote holder as a local win past the holder arm; every other holder still compares. Kill path: the lapsed grant resumes instead of offering through the restore dispatch.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-restore-branch-tuple\\\",\\n        path=f\\\"{PACKAGE}/ops.go\\\",\\n        find='\\\\\\\\t\\\\\\\\twinner.LeaseID == local.LeaseID &&\\\\\\\\n\\\\\\\\t\\\\\\\\twinner.Epoch == local.Epoch\\\\\\\\n',\\n        replace='\\\\\\\\t\\\\\\\\t((winner.LeaseID == local.LeaseID && winner.Epoch == local.Epoch) || (winner.LeaseID == \\\"0198f4c8-8e50-7f66-8f70-333333333334\\\" && winner.Epoch == 9))\\\\\\\\n',\\n        count=1,\\n        run=\\\"TestExecuteRestoreParksOtherwise\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the unseen (leaseB, 9) tuple as a local win past the tuple arm; every other tuple still compares. Kill path: the stale-tuple grant resumes instead of parking through the restore dispatch.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-restore-branch-material\\\",\\n        path=f\\\"{PACKAGE}/ops.go\\\",\\n        find='\\\\\\\\t\\\\\\\\tif valid, err := lc.Materialization(mctx.SessionID, body.CheckpointID); err == nil && valid {\\\\\\\\n',\\n        replace='\\\\\\\\t\\\\\\\\tif valid, err := lc.Materialization(mctx.SessionID, body.CheckpointID); err == nil && (valid || !valid) {\\\\\\\\n',\\n        count=1,\\n        run=\\\"TestExecuteRestoreParksOtherwise\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the invalid-but-unerrored materialization past the validity arm; errored reads still fail closed. Kill path: the invalid material resumes instead of parking through the restore dispatch.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-restore-branch-remote\\\",\\n        path=f\\\"{PACKAGE}/ops.go\\\",\\n        find='\\\\\\\\t\\\\\\\\twinner.HolderHostID != lc.LocalHostID\\\\\\\\n',\\n        replace='\\\\\\\\t\\\\\\\\t(winner.HolderHostID != lc.LocalHostID || winner.HolderHostID == lc.LocalHostID)\\\\\\\\n',\\n        count=1,\\n        run=\\\"TestExecuteRestoreParksOtherwise\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the self holder as remote past the remoteness arm; empty holders still park. Kill path: the stale-tuple grant offers instead of parking through the restore dispatch.\\\",\\n    ),\\n'''\\ntext = text.replace(anchor, rows + anchor)\\np.write_text(text)\\nprint(\\\"branch rows added\\\")\\nPYEOF\\ngrep -c 'name=\\\"N-' internal/tmuxserver/mutant_harness.py\",\n  \"description\": \"Add close and branch narrowing rows\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"branch rows added\\n205\\n\",\n  \"original_output_bytes\": 22,\n  \"original_output_tokens\": 6,\n  \"truncated\": false\n}","final_result":true}}}
