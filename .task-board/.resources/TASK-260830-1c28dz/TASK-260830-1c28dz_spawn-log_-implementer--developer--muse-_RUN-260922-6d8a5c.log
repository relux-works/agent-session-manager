{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c729","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":495,"recorded_at":1780531400000985,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"call_id":"call_01a0c6dab5b5704cb0bb4a0b0c19cb4f","text":"Read text file `internal/tmuxserver/exec.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"bytes\"\n5|\t\"context\"\n6|\t\"errors\"\n7|\t\"os\"\n8|\t\"os/exec\"\n9|\t\"strings\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n14|)\n15|\n16|// RunResult is one completed process execution: the exit code is data,\n17|// never an error. A nonzero exit from a well-formed probe (has-session\n18|// against a missing session reports exit 1) proves the negative; only a\n19|// transport failure — the process never ran — returns an error, and an\n20|// error proves nothing, not even non-commit.\n21|type RunResult struct {\n22|\tStdout   []byte\n23|\tExitCode int\n24|}\n25|\n26|// Runner executes one argv vector to completion. Production callers pass\n27|// vectors built by BuildCommand only; tests inject fakes. No Runner\n28|// implementation in the test suite starts a tmux process.\n29|type Runner interface {\n30|\tRun(ctx context.Context, argv []string) (RunResult, error)\n31|}\n32|\n33|// OSRunner is the production Runner: native process start with no\n34|// shell. The child environment scrubs the two ambient tmux variables\n35|// (EnvTMUX, EnvTMUXTmpDir) so an ambient session can never leak into a\n36|// -S-addressed invocation; -S addressing already ignores them, and the\n37|// scrub makes that independence structural rather than relied-upon.\n38|type OSRunner struct {\n39|\t// Command builds the process. Nil means exec.CommandContext.\n40|\t// Tests inject a helper-process fake; production leaves it nil.\n41|\tCommand func(ctx context.Context, name string, args ...string) *exec.Cmd\n42|}\n43|\n44|// Run executes argv and reports its exit code as data. A vector that\n45|// fails the landed argv shape gate refuses before any process starts.\n46|func (runner OSRunner) Run(ctx context.Context, argv []string) (RunResult, error) {\n47|\tif err := secprim.CheckArgv(argv); err != nil {\n48|\t\treturn RunResult{}, &Error{Code: CodeInvalidArguments, Detail: \"command argv\"}\n49|\t}\n50|\tcommand := exec.CommandContext\n51|\tif runner.Command != nil {\n52|\t\tcommand = runner.Command\n53|\t}\n54|\tproc := command(ctx, argv[0], argv[1:]...)\n55|\tproc.Env = scrubTmuxEnv(os.Environ())\n56|\tvar stdout, stderr bytes.Buffer\n57|\tproc.Stdout = &stdout\n58|\tproc.Stderr = &stderr\n59|\tif err := proc.Run(); err != nil {\n60|\t\tvar exitErr *exec.ExitError\n61|\t\tif errors.As(err, &exitErr) {\n62|\t\t\treturn RunResult{Stdout: stdout.Bytes(), ExitCode: exitErr.ExitCode()}, nil\n63|\t\t}\n64|\t\treturn RunResult{}, err\n65|\t}\n66|\treturn RunResult{Stdout: stdout.Bytes(), ExitCode: 0}, nil\n67|}\n68|\n69|// scrubTmuxEnv removes the ambient tmux session variables from a process\n70|// environment. It matches exact NAME= prefixes, so TMUX_FOO survives\n71|// while TMUX and TMUX_TMPDIR are dropped.\n72|func scrubTmuxEnv(env []string) []string {\n73|\tscrubbed := make([]string, 0, len(env))\n74|\tfor _, entry := range env {\n75|\t\tif strings.HasPrefix(entry, EnvTMUX+\"=\") || strings.HasPrefix(entry, EnvTMUXTmpDir+\"=\") {\n76|\t\t\tcontinue\n77|\t\t}\n78|\t\tscrubbed = append(scrubbed, entry)\n79|\t}\n80|\treturn scrubbed\n81|}\n82|\n83|// Directive is the closed tmux primitive vocabulary this leaf executes.\n84|// Each lifecycle operation maps to a fixed directive sequence (see the\n85|// backend drivers); no operation execs a primitive outside this enum,\n86|// and no primitive addresses any server but the derived -S socket.\n87|type Directive string\n88|\n89|// tmux primitives. The string values are the literal tmux(1) command\n90|// names verified against tmux 3.6a list-commands.\n91|const (\n92|\tDirectiveNewSession    Directive = \"new-session\"\n93|\tDirectiveAttachSession Directive = \"attach-session\"\n94|\tDirectiveListPanes     Directive = \"list-panes\"\n95|\tDirectiveListSessions  Directive = \"list-sessions\"\n96|\tDirectiveLockSession   Directive = \"lock-session\"\n97|\tDirectiveWaitBoundary  Directive = \"wait-for\"\n98|\tDirectiveSendInterrupt Directive = \"send-keys\"\n99|\tDirectiveHasSession    Directive = \"has-session\"\n100|\tDirectiveKillSession   Directive = \"kill-session\"\n101|)\n102|\n103|// ParseDirective admits exactly the nine tmux primitives.\n104|func ParseDirective(value string) (Directive, error) {\n105|\tswitch Directive(value) {\n106|\tcase DirectiveNewSession, DirectiveAttachSession, DirectiveListPanes,\n107|\t\tDirectiveListSessions, DirectiveLockSession, DirectiveWaitBoundary,\n108|\t\tDirectiveSendInterrupt, DirectiveHasSession, DirectiveKillSession:\n109|\t\treturn Directive(value), nil\n110|\tdefault:\n111|\t\treturn \"\", &Error{Code: terminalbackend.CodeProtocolError, Detail: \"command vocabulary\"}\n112|\t}\n113|}\n114|\n115|// PanesFormat is the list-panes row shape: the foreground command name\n116|// only. It deliberately excludes pane_pid: identity MUST NOT be a PID\n117|// (pinned SPEC 4.B), so provider presence is proven by a non-empty\n118|// command row, never by a process number.\n119|const PanesFormat = \"#{pane_current_command}\"\n120|\n121|// SessionsFormat is the list-sessions row shape: session name and\n122|// attached-client count, pipe-separated.\n123|const SessionsFormat = \"#{session_name}|#{session_attached}\"\n124|\n125|// BoundaryChannelPrefix prefixes every wait-for channel this leaf\n126|// locks on. The channel is ax-boundary-<quiescence_generation UUIDv7>:\n127|// fixed prefix plus caller-bound generation, never caller free text.\n128|const BoundaryChannelPrefix = \"ax-boundary-\"\n129|\n130|// CommandArgs carries the per-directive identity material. Only the\n131|// members the directive reads are validated; the rest stay zero. Every\n132|// tmux target session name is the terminal instance ID: the one\n133|// dedicated server hosts every logical session, so targets are\n134|// instance-scoped, while the wrapper tail always names the logical\n135|// session (ax pane <session_id>). The acquisition bootstrap vector\n136|// (BuildArgv, session-named) and lifecycle instance vectors coexist as\n137|// distinct sessions on that server; lifecycle entries address instances\n138|// only.\n139|type CommandArgs struct {\n140|\t// RuntimeDir is the tmux runtime directory (<root>/tmux).\n141|\tRuntimeDir string\n142|\t// Socket must equal SocketPath(RuntimeDir): the only admissible\n143|\t// server address. Any other value refuses.\n144|\tSocket string\n145|\t// SessionID is the logical session (create/restore wrapper tail).\n146|\tSessionID string\n147|\t// InstanceID is the tmux target session name.\n148|\tInstanceID string\n149|\t// QuiescenceGeneration selects the wait-for channel (boundary).\n150|\tQuiescenceGeneration string\n151|}\n152|\n153|// BuildCommand builds one validated tmux -S argv vector for a\n154|// directive. The socket pin mirrors the BuildArgv spawn-socket arm:\n155|// the socket must be the one derived from the runtime directory, so an\n156|// ambient socket passed here refuses instead of being addressed. The\n157|// assembled vector passes the landed argv shape gate before return.\n158|func BuildCommand(directive Directive, args CommandArgs) ([]string, error) {\n159|\tif _, err := ParseDirective(string(directive)); err != nil {\n160|\t\treturn nil, err\n161|\t}\n162|\tif args.Socket != SocketPath(args.RuntimeDir) {\n163|\t\treturn nil, &Error{Code: CodeAmbientReuse, Detail: \"command socket\"}\n164|\t}\n165|\tvar argv []string\n166|\tswitch directive {\n167|\tcase DirectiveNewSession:\n168|\t\tsession, instance, err := commandSessionInstance(args)\n169|\t\tif err != nil {\n170|\t\t\treturn nil, err\n171|\t\t}\n172|\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"new-session\", \"-d\",\n173|\t\t\t\"-s\", instance, \"ax\", \"pane\", session}\n174|\tcase DirectiveAttachSession:\n175|\t\tinstance, err := commandInstance(args)\n176|\t\tif err != nil {\n177|\t\t\treturn nil, err\n178|\t\t}\n179|\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"attach-session\", \"-t\", instance}\n180|\tcase DirectiveListPanes:\n181|\t\tinstance, err := commandInstance(args)\n182|\t\tif err != nil {\n183|\t\t\treturn nil, err\n184|\t\t}\n185|\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"list-panes\", \"-t\", instance, \"-F\", PanesFormat}\n186|\tcase DirectiveListSessions:\n187|\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"list-sessions\", \"-F\", SessionsFormat}\n188|\tcase DirectiveLockSession:\n189|\t\tinstance, err := commandInstance(args)\n190|\t\tif err != nil {\n191|\t\t\treturn nil, err\n192|\t\t}\n193|\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"lock-session\", \"-t\", instance}\n194|\tcase DirectiveWaitBoundary:\n195|\t\tchannel, err := commandChannel(args)\n196|\t\tif err != nil {\n197|\t\t\treturn nil, err\n198|\t\t}\n199|\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"wait-for\", \"-L\", channel}\n200|\tcase DirectiveSendInterrupt:\n201|\t\tinstance, err := commandInstance(args)\n202|\t\tif err != nil {\n203|\t\t\treturn nil, err\n204|\t\t}\n205|\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"send-keys\", \"-t\", instance, \"C-c\"}\n206|\tcase DirectiveHasSession:\n207|\t\tinstance, err := commandInstance(args)\n208|\t\tif err != nil {\n209|\t\t\treturn nil, err\n210|\t\t}\n211|\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"has-session\", \"-t\", instance}\n212|\tcase DirectiveKillSession:\n213|\t\tinstance, err := commandInstance(args)\n214|\t\tif err != nil {\n215|\t\t\treturn nil, err\n216|\t\t}\n217|\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"kill-session\", \"-t\", instance}\n218|\tdefault:\n219|\t\treturn nil, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"command vocabulary\"}\n220|\t}\n221|\tif err := secprim.CheckArgv(argv); err != nil {\n222|\t\treturn nil, &Error{Code: CodeInvalidArguments, Detail: \"command argv\"}\n223|\t}\n224|\treturn argv, nil\n225|}\n226|\n227|// commandInstance validates the tmux target: the terminal instance ID\n228|// as canonical UUIDv7.\n229|func commandInstance(args CommandArgs) (string, error) {\n230|\tinstance, err := scalar.ParseUUIDv7(args.InstanceID)\n231|\tif err != nil {\n232|\t\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"command instance\"}\n233|\t}\n234|\treturn instance.String(), nil\n235|}\n236|\n237|// commandSessionInstance validates the create/restore pair: the logical\n238|// session for the wrapper tail and the instance for the target name.\n239|func commandSessionInstance(args CommandArgs) (string, string, error) {\n240|\tsession, err := scalar.ParseUUIDv7(args.SessionID)\n241|\tif err != nil {\n242|\t\treturn \"\", \"\", &Error{Code: CodeInvalidArguments, Detail: \"command session\"}\n243|\t}\n244|\tinstance, err := commandInstance(args)\n245|\tif err != nil {\n246|\t\treturn \"\", \"\", err\n247|\t}\n248|\treturn session.String(), instance, nil\n249|}\n250|\n251|// commandChannel derives the wait-for channel from the quiescence\n252|// generation: fixed prefix plus canonical UUIDv7, never caller text.\n253|func commandChannel(args CommandArgs) (string, error) {\n254|\tgeneration, err := scalar.ParseUUIDv7(args.QuiescenceGeneration)\n255|\tif err != nil {\n256|\t\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"command quiescence\"}\n257|\t}\n258|\treturn BoundaryChannelPrefix + generation.String(), nil\n259|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c72b","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":496,"recorded_at":1780531400000987,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"call_id":"call_01a0c6dab77e75528a1bf08a184f5522","text":"Read text file `internal/tmuxserver/backend.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"errors\"\n6|\t\"strconv\"\n7|\t\"strings\"\n8|\t\"time\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n15|)\n16|\n17|// operationDirectives is the exact lifecycle-to-tmux mapping: every\n18|// operation executes a fixed directive sequence and no other tmux\n19|// command. The table is the contract; the drivers below execute it.\n20|var operationDirectives = map[terminalbackend.Operation][]Directive{\n21|\tterminalbackend.OperationCreate:           {DirectiveNewSession},\n22|\tterminalbackend.OperationAttach:           {DirectiveAttachSession},\n23|\tterminalbackend.OperationStatus:           {DirectiveListPanes, DirectiveListSessions},\n24|\tterminalbackend.OperationQuiesceInput:     {DirectiveLockSession},\n25|\tterminalbackend.OperationWaitSafeBoundary: {DirectiveWaitBoundary},\n26|\tterminalbackend.OperationRequestStop:      {DirectiveSendInterrupt, DirectiveHasSession, DirectiveKillSession, DirectiveHasSession},\n27|\tterminalbackend.OperationTerminateStale:   {DirectiveKillSession, DirectiveHasSession},\n28|\tterminalbackend.OperationRestore:          {DirectiveNewSession},\n29|}\n30|\n31|// DirectivesFor reports the fixed tmux directive sequence for one\n32|// lifecycle operation. Manifest and probe are not lifecycle operations\n33|// and refuse; every other unknown operation refuses as well.\n34|func DirectivesFor(operation terminalbackend.Operation) ([]Directive, error) {\n35|\tdirectives, known := operationDirectives[operation]\n36|\tif !known {\n37|\t\treturn nil, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle operation\"}\n38|\t}\n39|\treturn append([]Directive(nil), directives...), nil\n40|}\n41|\n42|// backend is the tmux terminstance.Backend: side-effect execution and\n43|// status observation over the structured commands. It is\n44|// request-scoped — one backend per Execute call — because effects\n45|// carry no identity of their own and the runner, socket, stores, and\n46|// admission are per-request facts.\n47|type backend struct {\n48|\trunner      Runner\n49|\truntimeDir  string\n50|\tsocket      string\n51|\toperation   terminalbackend.Operation\n52|\tsessionID   string\n53|\tinstanceID  string\n54|\tbootstrapID string\n55|\tbindingID   string\n56|\tchannel     string\n57|\tquiescence  string\n58|\twaitCtx     context.Context\n59|\tdeadline    time.Time\n60|\tnow         func() time.Time\n61|\tsleep       func(time.Duration)\n62|\tpoll        time.Duration\n63|\tadmitted    terminalbackend.Admitted\n64|\tbindings    *axpane.Store\n65|\tattach      *termbind.AttachStore\n66|\tstates      *InstanceStates\n67|\ttransport   string\n68|\tinput       bool\n69|\tauthRaw     []byte\n70|\tclientID    string\n71|\t// killExit records the stale-kill exit for the close re-confirm:\n72|\t// a live session after a clean kill and a live session after a\n73|\t// failed kill refuse through the same arm, and the recorded exit\n74|\t// is the member split the narrowing mutant admits exactly one of.\n75|\t// -1 means no kill ran yet on this backend.\n76|\tkillExit int\n77|}\n78|\n79|// effectEvidence derives one evidence digest over the canonical effect\n80|// record: effect name, operation, instance, and outcome facts. The join\n81|// is deterministic; nothing parses it back.\n82|func effectEvidence(effect terminalbackend.SideEffect, operation terminalbackend.Operation, instance string, facts ...string) string {\n83|\trecord := strings.Join(append([]string{string(effect), string(operation), instance}, facts...), \"\\n\")\n84|\treturn scalar.SHA256Digest([]byte(record)).String()\n85|}\n86|\n87|// PerformEffect executes one side effect and reports its evidence ID.\n88|// A nil error proves the commit; a coded error proves the backend\n89|// refused before committing; any other error proves nothing. Every\n90|// tmux command runs through BuildCommand, so no effect addresses any\n91|// server but the derived socket.\n92|func (runner *backend) PerformEffect(ctx context.Context, effect terminalbackend.SideEffect) (string, error) {\n93|\tswitch effect {\n94|\tcase terminalbackend.EffectBindingPersisted:\n95|\t\treturn runner.persistBinding()\n96|\tcase terminalbackend.EffectWrapperStarted:\n97|\t\treturn runner.startWrapper(ctx, terminalbackend.EffectWrapperStarted)\n98|\tcase terminalbackend.EffectAttachClientCreated:\n99|\t\treturn runner.createAttachClient()\n100|\tcase terminalbackend.EffectInputClosed:\n101|\t\treturn runner.execEvidence(ctx, DirectiveLockSession, terminalbackend.EffectInputClosed)\n102|\tcase terminalbackend.EffectSafeBoundaryObserved:\n103|\t\treturn runner.observeBoundary()\n104|\tcase terminalbackend.EffectGracefulStopRequested:\n105|\t\treturn runner.execEvidence(ctx, DirectiveSendInterrupt, terminalbackend.EffectGracefulStopRequested)\n106|\tcase terminalbackend.EffectProcessClosed:\n107|\t\treturn runner.confirmClosed(ctx)\n108|\tcase terminalbackend.EffectBackendStoreClosed:\n109|\t\treturn effectEvidence(effect, runner.operation, runner.instanceID, \"tmux-side closes done\"), nil\n110|\tcase terminalbackend.EffectStaleIncarnationTerminated:\n111|\t\treturn runner.terminateStale(ctx)\n112|\tcase terminalbackend.EffectWrapperRestored:\n113|\t\treturn runner.startWrapper(ctx, terminalbackend.EffectWrapperRestored)\n114|\tdefault:\n115|\t\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend effect vocabulary\"}\n116|\t}\n117|}\n118|\n119|// persistBinding records the bootstrap binding for the create/restore\n120|// pair. A changed operation in the bootstrap window refuses the landed\n121|// idempotency_mismatch; an identical retry replays the one receipt.\n122|func (runner *backend) persistBinding() (string, error) {\n123|\tif runner.bindings == nil {\n124|\t\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend binding store\"}\n125|\t}\n126|\trecorded, _, err := runner.bindings.Bind(runner.sessionID, runner.bootstrapID, axpane.Binding{\n127|\t\tSessionID:          runner.sessionID,\n128|\t\tOperationID:        runner.bootstrapID,\n129|\t\tTerminalInstanceID: runner.instanceID,\n130|\t\tBindingDigest:      runner.bindingID,\n131|\t})\n132|\tif err != nil {\n133|\t\tif code := backendErrorCode(err); code != \"\" {\n134|\t\t\treturn \"\", &terminstance.Error{Code: code, Detail: \"backend binding conflict\"}\n135|\t\t}\n136|\t\treturn \"\", err\n137|\t}\n138|\treturn recorded.BindingDigest, nil\n139|}\n140|\n141|// startWrapper execs the instance new-session vector for create\n142|// (wrapper_started) and restore (wrapper_restored).\n143|func (runner *backend) startWrapper(ctx context.Context, effect terminalbackend.SideEffect) (string, error) {\n144|\treturn runner.execEvidence(ctx, DirectiveNewSession, effect)\n145|}\n146|\n147|// createAttachClient records the presentation client receipt for one\n148|// (instance, client) pair. Every call requires the valid unexpired\n149|// attach authorization the attach handler already admitted; the store\n150|// rechecks it, so a timeout creates no authorized input unless the\n151|// durable receipt says so.\n152|func (runner *backend) createAttachClient() (string, error) {\n153|\tif runner.attach == nil {\n154|\t\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend attach store\"}\n155|\t}\n156|\treceipt, _, err := runner.attach.Attach(runner.sessionID, runner.instanceID, runner.clientID, runner.transport, runner.input, runner.authRaw, runner.now())\n157|\tif err != nil {\n158|\t\tif code := backendErrorCode(err); code != \"\" {\n159|\t\t\treturn \"\", &terminstance.Error{Code: code, Detail: \"backend attach conflict\"}\n160|\t\t}\n161|\t\treturn \"\", err\n162|\t}\n163|\treturn effectEvidence(terminalbackend.EffectAttachClientCreated, runner.operation, runner.instanceID, receipt.ClientID, receipt.Transport), nil\n164|}\n165|\n166|// execEvidence runs one directive and evidences its success. A nonzero\n167|// exit is a coded process failure: the command ran and the effect did\n168|// not commit. A transport error is uncoded: it proves nothing.\n169|func (runner *backend) execEvidence(ctx context.Context, directive Directive, effect terminalbackend.SideEffect) (string, error) {\n170|\targv, err := runner.command(directive)\n171|\tif err != nil {\n172|\t\treturn \"\", err\n173|\t}\n174|\tresult, err := runner.runner.Run(ctx, argv)\n175|\tif err != nil {\n176|\t\treturn \"\", err\n177|\t}\n178|\tif result.ExitCode != 0 {\n179|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n180|\t}\n181|\treturn effectEvidence(effect, runner.operation, runner.instanceID, strconv.Itoa(result.ExitCode)), nil\n182|}\n183|\n184|// observeBoundary waits for the wrapper's safe-boundary signal on the\n185|// quiescence channel. The wait context already bounds the lesser of\n186|// the request deadline and the timeout; its expiry is the coded\n187|// quiesce_timeout proving non-commit, never a silent continue.\n188|func (runner *backend) observeBoundary() (string, error) {\n189|\targv, err := runner.command(DirectiveWaitBoundary)\n190|\tif err != nil {\n191|\t\treturn \"\", err\n192|\t}\n193|\tresult, err := runner.runner.Run(runner.waitCtx, argv)\n194|\tif err != nil {\n195|\t\tif runner.waitCtx.Err() != nil {\n196|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeQuiesceTimeout, Detail: \"backend boundary wait\"}\n197|\t\t}\n198|\t\treturn \"\", err\n199|\t}\n200|\tif result.ExitCode != 0 {\n201|\t\tif runner.waitCtx.Err() != nil {\n202|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeQuiesceTimeout, Detail: \"backend boundary wait\"}\n203|\t\t}\n204|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n205|\t}\n206|\tobserved, err := runner.now().UTC().MarshalText()\n207|\tif err != nil {\n208|\t\treturn \"\", err\n209|\t}\n210|\treturn effectEvidence(terminalbackend.EffectSafeBoundaryObserved, runner.operation, runner.instanceID, runner.channel, string(observed)), nil\n211|}\n212|\n213|// confirmClosed proves process closure for request-stop and\n214|// terminate-stale. Absence (has-session exit 1) is the proof. A live\n215|// session on request-stop escalates once to kill-session and\n216|// re-confirms; a still-live session is the coded stop_timeout. A live\n217|// session on terminate-stale is the coded process failure: the kill\n218|// claimed the incarnation and it still answers. The confirm polls to\n219|// the deadline before it concludes anything.\n220|func (runner *backend) confirmClosed(ctx context.Context) (string, error) {\n221|\tif runner.pollForAbsence(ctx) {\n222|\t\treturn effectEvidence(terminalbackend.EffectProcessClosed, runner.operation, runner.instanceID, \"absent\"), nil\n223|\t}\n224|\tif runner.operation == terminalbackend.OperationRequestStop {\n225|\t\targv, err := runner.command(DirectiveKillSession)\n226|\t\tif err != nil {\n227|\t\t\treturn \"\", err\n228|\t\t}\n229|\t\tif result, err := runner.runner.Run(ctx, argv); err != nil {\n230|\t\t\treturn \"\", err\n231|\t\t} else if result.ExitCode != 0 {\n232|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n233|\t\t}\n234|\t\tif runner.pollForAbsence(ctx) {\n235|\t\t\treturn effectEvidence(terminalbackend.EffectProcessClosed, runner.operation, runner.instanceID, \"escalated\"), nil\n236|\t\t}\n237|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeStopTimeout, Detail: \"backend stop wait\"}\n238|\t}\n239|\t// Terminate-stale re-confirm: a live session refuses whether the kill\n240|\t// exited clean or failed — the kill claimed the incarnation and it\n241|\t// still answers. The exit split names both members so each refuses\n242|\t// explicitly; the narrowing mutant admits exactly the failed-kill\n243|\t// member.\n244|\tif runner.killExit != 0 {\n245|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n246|\t}\n247|\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n248|}\n249|\n250|// pollForAbsence probes has-session until the session is absent or the\n251|// deadline passes. A transport error aborts the poll as unknown: the\n252|// caller classifies it, never this loop.\n253|func (runner *backend) pollForAbsence(ctx context.Context) bool {\n254|\tfor {\n255|\t\targv, err := runner.command(DirectiveHasSession)\n256|\t\tif err != nil {\n257|\t\t\treturn false\n258|\t\t}\n259|\t\tresult, err := runner.runner.Run(ctx, argv)\n260|\t\tif err != nil {\n261|\t\t\treturn false\n262|\t\t}\n263|\t\tif result.ExitCode != 0 {\n264|\t\t\treturn true\n265|\t\t}\n266|\t\tif !runner.now().Before(runner.deadline) {\n267|\t\t\treturn false\n268|\t\t}\n269|\t\trunner.sleep(runner.poll)\n270|\t}\n271|}\n272|\n273|// terminateStale kills the fenced stale incarnation session. A clean\n274|// kill proves termination; a failed kill self-confirms — an absent\n275|// session is terminated however it closed — and only a live session\n276|// after a failed kill is the coded process failure.\n277|func (runner *backend) terminateStale(ctx context.Context) (string, error) {\n278|\targv, err := runner.command(DirectiveKillSession)\n279|\tif err != nil {\n280|\t\treturn \"\", err\n281|\t}\n282|\tresult, err := runner.runner.Run(ctx, argv)\n283|\tif err != nil {\n284|\t\treturn \"\", err\n285|\t}\n286|\trunner.killExit = result.ExitCode\n287|\tif result.ExitCode == 0 {\n288|\t\treturn effectEvidence(terminalbackend.EffectStaleIncarnationTerminated, runner.operation, runner.instanceID, \"killed\"), nil\n289|\t}\n290|\tconfirm, err := runner.command(DirectiveHasSession)\n291|\tif err != nil {\n292|\t\treturn \"\", err\n293|\t}\n294|\tobserved, err := runner.runner.Run(ctx, confirm)\n295|\tif err != nil {\n296|\t\treturn \"\", err\n297|\t}\n298|\tif observed.ExitCode != 0 {\n299|\t\treturn effectEvidence(terminalbackend.EffectStaleIncarnationTerminated, runner.operation, runner.instanceID, \"confirmed-absent\"), nil\n300|\t}\n301|\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n302|}\n303|\n304|// command builds the argv for one directive over the request identity.\n305|func (runner *backend) command(directive Directive) ([]string, error) {\n306|\tbuilt, err := BuildCommand(directive, CommandArgs{\n307|\t\tRuntimeDir:           runner.runtimeDir,\n308|\t\tSocket:               runner.socket,\n309|\t\tSessionID:            runner.sessionID,\n310|\t\tInstanceID:           runner.instanceID,\n311|\t\tQuiescenceGeneration: runner.quiescence,\n312|\t})\n313|\tif err != nil {\n314|\t\tif code := backendErrorCode(err); code != \"\" {\n315|\t\t\treturn nil, &terminstance.Error{Code: code, Detail: \"backend command refused\"}\n316|\t\t}\n317|\t\treturn nil, err\n318|\t}\n319|\treturn built, nil\n320|}\n321|\n322|// backendErrorCode reads the wire code off a backend-construction or\n323|// store error: landed terminalbackend and terminstance refusals plus\n324|// local tmuxserver refusals all carry one. Anything else is uncoded.\n325|func backendErrorCode(err error) string {\n326|\tif code := terminstance.ErrorCode(err); code != \"\" {\n327|\t\treturn code\n328|\t}\n329|\tvar local *Error\n330|\tif errors.As(err, &local) {\n331|\t\treturn local.Code\n332|\t}\n333|\treturn \"\"\n334|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c72d","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":497,"recorded_at":1780531400000989,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"call_id":"call_01a0c6dab95276c09bdb1bb5a189fe70","text":"Read text file `internal/tmuxserver/ops.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"sort\"\n8|\t\"strconv\"\n9|\t\"time\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n15|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n16|)\n17|\n18|// This file executes the three lifecycle operations the landed engine\n19|// scope refuses — attach, terminate-stale, and restore — over the same\n20|// landed gates the engine uses (transition matrix, idempotency shapes,\n21|// authorization, capability conferral, receipt and binding stores)\n22|// plus the tmux backend. The recheck loop, receipt discipline, and\n23|// error-to-observation mapping mirror the engine's second side of each\n24|// rule; the census symmetry lines name both sides.\n25|\n26|// sortedEffects copies effects into bytewise order for the wire.\n27|func sortedEffects(effects []terminalbackend.SideEffect) []terminalbackend.SideEffect {\n28|\tordered := append([]terminalbackend.SideEffect(nil), effects...)\n29|\tsort.Slice(ordered, func(i, j int) bool { return ordered[i] < ordered[j] })\n30|\treturn ordered\n31|}\n32|\n33|// sortedEvidence copies evidence IDs into bytewise order for the wire.\n34|func sortedEvidence(evidence []string) []string {\n35|\tordered := append([]string(nil), evidence...)\n36|\tsort.Strings(ordered)\n37|\treturn ordered\n38|}\n39|\n40|// attachDescriptor derives the bound attach descriptor: socket,\n41|// instance, and client joined by newlines. It is host-local (the\n42|// socket path is usable only on the responding host), deterministic,\n43|// and never persisted: the attach handler returns it without writing\n44|// it anywhere, and a dedicated test scans the stores for its bytes.\n45|// Length is bounded by construction — sun_path socket plus two UUIDs\n46|// stay two orders of magnitude below the 4096 cap — so no length arm\n47|// exists to measure; a test pins the maximum instead.\n48|func attachDescriptor(socket, instance, client string) string {\n49|\treturn socket + \"\\n\" + instance + \"\\n\" + client\n50|}\n51|\n52|// createDescriptor derives the unbound create-interactive descriptor:\n53|// socket and instance only, because create carries no client. Same\n54|// non-persistence and length properties as the bound shape.\n55|func createDescriptor(socket, instance string) string {\n56|\treturn socket + \"\\n\" + instance\n57|}\n58|\n59|// executeAttach runs one attach: closed-shape admission, deadline,\n60|// transition, landed attach authorization, capability conferral plus\n61|// the matching-transport arm, live server attestation (the P3-A\n62|// wiring: a fresh decoy admission refuses), the durable client\n63|// receipt, and the caller-executed attach vector with its descriptor.\n64|// The entry returns the vector; it never execs an interactive attach.\n65|func (lc *Lifecycle) executeAttach(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n66|\tempty := OpOutcome{Operation: terminalbackend.OperationAttach}\n67|\tbody, err := parseAttachBody(req.Body)\n68|\tif err != nil {\n69|\t\treturn empty, err\n70|\t}\n71|\tif err := checkLifecycleBackend(body.TerminalBackendID); err != nil {\n72|\t\treturn empty, err\n73|\t}\n74|\tdeadline, err := body.Deadline.Time()\n75|\tif err != nil {\n76|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body deadline\"}\n77|\t}\n78|\tif !lc.Now().Before(deadline) {\n79|\t\treturn empty, &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n80|\t}\n81|\tif _, _, err := terminalbackend.CheckTransition(string(terminalbackend.OperationAttach), req.Source, false); err != nil {\n82|\t\treturn empty, err\n83|\t}\n84|\tif err := terminalbackend.CheckAttachRequest(body.Authorization, body.Transport, body.InputAuthorized, lc.Now()); err != nil {\n85|\t\treturn empty, err\n86|\t}\n87|\tif err := terminalbackend.CheckOperation(string(terminalbackend.OperationAttach), req.Admitted); err != nil {\n88|\t\treturn empty, err\n89|\t}\n90|\tif err := checkAttachTransportCapability(body.Transport, req.Admitted); err != nil {\n91|\t\treturn empty, err\n92|\t}\n93|\tif lc.ServerAdmission == nil {\n94|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle dependencies\"}\n95|\t}\n96|\tadmission, err := lc.ServerAdmission()\n97|\tif err != nil {\n98|\t\treturn empty, rowError(terminalbackend.OperationAttach, err)\n99|\t}\n100|\tif err := CheckServerAttested(admission, body.BackendGeneration); err != nil {\n101|\t\treturn empty, &Error{Code: terminalbackend.CodeUnauthorized, Detail: \"attach server attestation\"}\n102|\t}\n103|\treqBackend := lc.requestBackend(req, socket, body.SessionID, body.TerminalInstanceID)\n104|\treqBackend.operation = terminalbackend.OperationAttach\n105|\treqBackend.clientID = body.ClientID\n106|\treqBackend.transport = body.Transport\n107|\treqBackend.input = body.InputAuthorized\n108|\treqBackend.authRaw = body.AuthRaw\n109|\tevidenceID, err := reqBackend.PerformEffect(ctx, terminalbackend.EffectAttachClientCreated)\n110|\tif err != nil {\n111|\t\treturn empty, rowError(terminalbackend.OperationAttach, err)\n112|\t}\n113|\targv, err := BuildCommand(DirectiveAttachSession, CommandArgs{\n114|\t\tRuntimeDir: lc.RuntimeDir,\n115|\t\tSocket:     socket,\n116|\t\tInstanceID: body.TerminalInstanceID,\n117|\t})\n118|\tif err != nil {\n119|\t\treturn empty, err\n120|\t}\n121|\tif err := terminalbackend.CheckAttachResult(body.InputAuthorized, body.InputAuthorized, body.Authorization); err != nil {\n122|\t\treturn empty, err\n123|\t}\n124|\tlc.recordAfter(body.TerminalInstanceID, terminalbackend.StateActive)\n125|\treturn OpOutcome{\n126|\t\tOperation: terminalbackend.OperationAttach,\n127|\t\tAttach: &AttachOutcome{\n128|\t\t\tClientMirrorID:  body.ClientID,\n129|\t\t\tDescriptor:      attachDescriptor(socket, body.TerminalInstanceID, body.ClientID),\n130|\t\t\tInputAuthorized: body.InputAuthorized,\n131|\t\t\tEvidenceIDs:     []string{evidenceID},\n132|\t\t},\n133|\t\tArgv: argv,\n134|\t}, nil\n135|}\n136|\n137|// checkAttachTransportCapability enforces the matching-transport arm:\n138|// local presentation needs local_attach, mesh presentation needs\n139|// remote_attach. The relay member never reaches here — the landed\n140|// attach authorization refuses it first — so no third arm exists.\n141|func checkAttachTransportCapability(transport string, admitted terminalbackend.Admitted) error {\n142|\tswitch transport {\n143|\tcase string(terminalbackend.TransportLocalOnly):\n144|\t\tif !admitted.Has(\"local_attach\") {\n145|\t\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n146|\t\t}\n147|\tcase string(terminalbackend.TransportTrustedPrivateMesh):\n148|\t\tif !admitted.Has(\"remote_attach\") {\n149|\t\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n150|\t\t}\n151|\tdefault:\n152|\t\treturn &Error{Code: terminalbackend.CodeProtocolError, Detail: \"presentation transport vocabulary\"}\n153|\t}\n154|\treturn nil\n155|}\n156|\n157|// executeTerminate runs one terminate-stale: closed-shape admission,\n158|// idempotency material, capability conferral plus the dual conditional,\n159|// transition, force_stale authorization, generation recheck, landed\n160|// fencing authorization, deadline, receipt discipline with\n161|// status-reconciled resume, and the kill plus close-confirm effects.\n162|func (lc *Lifecycle) executeTerminate(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n163|\tempty := OpOutcome{Operation: terminalbackend.OperationTerminateStale}\n164|\tbody, err := parseTerminateBody(req.Body)\n165|\tif err != nil {\n166|\t\treturn empty, err\n167|\t}\n168|\toperation := terminalbackend.OperationTerminateStale\n169|\tmctx := body.Context\n170|\tsource := terminalbackend.InstanceState(req.Source)\n171|\tif err := checkLifecycleBackend(mctx.TerminalBackendID); err != nil {\n172|\t\treturn empty, err\n173|\t}\n174|\tderived, err := terminalbackend.IdempotencyKey(string(operation), mctx.TerminalInstanceID, \"terminate\", body.StaleLeaseID, strconv.FormatUint(body.StaleEpoch, 10))\n175|\tif err != nil {\n176|\t\treturn empty, err\n177|\t}\n178|\tif mctx.IdempotencyKey != derived {\n179|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"idempotency key material\"}\n180|\t}\n181|\tif err := terminalbackend.CheckOperation(string(operation), req.Admitted); err != nil {\n182|\t\tfailure := rowError(operation, err)\n183|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n184|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n185|\t}\n186|\tif err := checkTerminateCapability(req.Admitted); err != nil {\n187|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n188|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n189|\t}\n190|\ttarget, effects, err := terminalbackend.CheckTransition(stri