{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d991","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":2851,"recorded_at":1780531400005697,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"call_id":"call_01a0c6f52ad67397a35e529786abcd94","text":"Read text file `internal/tmuxserver/exec_test.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n6|\t\"os\"\n7|\t\"os/exec\"\n8|\t\"strconv\"\n9|\t\"testing\"\n10|)\n11|\n12|func TestParseDirectiveAdmitsNinePrimitives(t *testing.T) {\n13|\tfor _, directive := range []string{\n14|\t\t\"new-session\", \"attach-session\", \"list-panes\", \"list-sessions\",\n15|\t\t\"lock-session\", \"wait-for\", \"send-keys\", \"has-session\", \"kill-session\",\n16|\t} {\n17|\t\tparsed, err := ParseDirective(directive)\n18|\t\tif err != nil {\n19|\t\t\tt.Fatalf(\"ParseDirective(%q): %v\", directive, err)\n20|\t\t}\n21|\t\tif string(parsed) != directive {\n22|\t\t\tt.Fatalf(\"ParseDirective(%q) = %q\", directive, parsed)\n23|\t\t}\n24|\t}\n25|}\n26|\n27|func TestParseDirectiveRefusesUnknown(t *testing.T) {\n28|\tfor _, value := range []string{\"\", \"kill-server\", \"new\", \"attach\", \"NEW-SESSION\", \"new-session \", \"run-shell\"} {\n29|\t\tif _, err := ParseDirective(value); err == nil {\n30|\t\t\tt.Fatalf(\"ParseDirective(%q) admitted\", value)\n31|\t\t} else {\n32|\t\t\trequireLocalCode(t, err, \"terminal_backend_protocol_error\", \"command vocabulary\")\n33|\t\t}\n34|\t}\n35|}\n36|\n37|func TestDirectivesForMapsEightOperations(t *testing.T) {\n38|\tcases := map[string][]Directive{\n39|\t\t\"create\":             {DirectiveNewSession},\n40|\t\t\"attach\":             {DirectiveAttachSession},\n41|\t\t\"status\":             {DirectiveListPanes, DirectiveListSessions},\n42|\t\t\"quiesce-input\":      {DirectiveLockSession},\n43|\t\t\"wait-safe-boundary\": {DirectiveWaitBoundary},\n44|\t\t\"request-stop\":       {DirectiveSendInterrupt, DirectiveHasSession, DirectiveKillSession, DirectiveHasSession},\n45|\t\t\"terminate-stale\":    {DirectiveKillSession, DirectiveHasSession},\n46|\t\t\"restore\":            {DirectiveNewSession},\n47|\t}\n48|\tfor operation, want := range cases {\n49|\t\tgot, err := DirectivesFor(terminalbackend.Operation(operation))\n50|\t\tif err != nil {\n51|\t\t\tt.Fatalf(\"DirectivesFor(%q): %v\", operation, err)\n52|\t\t}\n53|\t\tif len(got) != len(want) {\n54|\t\t\tt.Fatalf(\"DirectivesFor(%q) = %v, want %v\", operation, got, want)\n55|\t\t}\n56|\t\tfor i := range want {\n57|\t\t\tif got[i] != want[i] {\n58|\t\t\t\tt.Fatalf(\"DirectivesFor(%q) = %v, want %v\", operation, got, want)\n59|\t\t\t}\n60|\t\t}\n61|\t}\n62|}\n63|\n64|func TestDirectivesForRefusesNonLifecycle(t *testing.T) {\n65|\tfor _, operation := range []string{\"manifest\", \"probe\", \"suspend\", \"\"} {\n66|\t\tif _, err := DirectivesFor(terminalbackend.Operation(operation)); err == nil {\n67|\t\t\tt.Fatalf(\"DirectivesFor(%q) admitted\", operation)\n68|\t\t} else {\n69|\t\t\trequireLocalCode(t, err, \"terminal_backend_protocol_error\", \"lifecycle operation\")\n70|\t\t}\n71|\t}\n72|}\n73|\n74|func lxCommandArgs(socket string) CommandArgs {\n75|\treturn CommandArgs{\n76|\t\tRuntimeDir:           \"/root/tmux\",\n77|\t\tSocket:               socket,\n78|\t\tSessionID:            lxSession,\n79|\t\tInstanceID:           lxInstance,\n80|\t\tQuiescenceGeneration: lxQuiesce,\n81|\t}\n82|}\n83|\n84|func TestBuildCommandVectors(t *testing.T) {\n85|\tsocket := \"/root/tmux/ax.sock\"\n86|\tcases := []struct {\n87|\t\tname      string\n88|\t\tdirective Directive\n89|\t\twant      []string\n90|\t}{\n91|\t\t{\"new-session\", DirectiveNewSession, []string{\"tmux\", \"-S\", socket, \"new-session\", \"-d\", \"-s\", lxInstance, \"ax\", \"pane\", lxSession}},\n92|\t\t{\"attach\", DirectiveAttachSession, []string{\"tmux\", \"-S\", socket, \"attach-session\", \"-t\", lxInstance}},\n93|\t\t{\"list-panes\", DirectiveListPanes, []string{\"tmux\", \"-S\", socket, \"list-panes\", \"-t\", lxInstance, \"-F\", \"#{pane_current_command}\"}},\n94|\t\t{\"list-sessions\", DirectiveListSessions, []string{\"tmux\", \"-S\", socket, \"list-sessions\", \"-F\", \"#{session_name}|#{session_attached}\"}},\n95|\t\t{\"lock\", DirectiveLockSession, []string{\"tmux\", \"-S\", socket, \"lock-session\", \"-t\", lxInstance}},\n96|\t\t{\"wait\", DirectiveWaitBoundary, []string{\"tmux\", \"-S\", socket, \"wait-for\", \"-L\", \"ax-boundary-\" + lxQuiesce}},\n97|\t\t{\"send-keys\", DirectiveSendInterrupt, []string{\"tmux\", \"-S\", socket, \"send-keys\", \"-t\", lxInstance, \"C-c\"}},\n98|\t\t{\"has\", DirectiveHasSession, []string{\"tmux\", \"-S\", socket, \"has-session\", \"-t\", lxInstance}},\n99|\t\t{\"kill\", DirectiveKillSession, []string{\"tmux\", \"-S\", socket, \"kill-session\", \"-t\", lxInstance}},\n100|\t}\n101|\tfor _, tc := range cases {\n102|\t\tt.Run(tc.name, func(t *testing.T) {\n103|\t\t\tgot, err := BuildCommand(tc.directive, lxCommandArgs(socket))\n104|\t\t\tif err != nil {\n105|\t\t\t\tt.Fatal(err)\n106|\t\t\t}\n107|\t\t\tif len(got) != len(tc.want) {\n108|\t\t\t\tt.Fatalf(\"argv = %q, want %q\", got, tc.want)\n109|\t\t\t}\n110|\t\t\tfor i := range tc.want {\n111|\t\t\t\tif got[i] != tc.want[i] {\n112|\t\t\t\t\tt.Fatalf(\"argv = %q, want %q\", got, tc.want)\n113|\t\t\t\t}\n114|\t\t\t}\n115|\t\t})\n116|\t}\n117|}\n118|\n119|func TestBuildCommandRefusesUnknownDirective(t *testing.T) {\n120|\t// The builder re-parses its directive: a foreign primitive refuses\n121|\t// the vocabulary before the socket pin ever runs.\n122|\tif _, err := BuildCommand(Directive(\"kill-server\"), CommandArgs{}); err == nil {\n123|\t\tt.Fatal(\"unknown directive built\")\n124|\t} else {\n125|\t\trequireLocalCode(t, err, \"terminal_backend_protocol_error\", \"command vocabulary\")\n126|\t}\n127|}\n128|\n129|func TestBuildCommandRefusesAmbientSocket(t *testing.T) {\n130|\tsockets := []string{\n131|\t\t\"/tmp/ax-ambient.sock\",\n132|\t\t\"/root/tmux/default\",\n133|\t\t\"/root/tmux/ax.sock.evil\",\n134|\t\t\"/other/tmux/ax.sock\",\n135|\t\t\"ax.sock\",\n136|\t\t\"\",\n137|\t}\n138|\tfor _, socket := range sockets {\n139|\t\targs := lxCommandArgs(socket)\n140|\t\tfor _, directive := range []Directive{DirectiveNewSession, DirectiveAttachSession, DirectiveKillSession, DirectiveHasSession} {\n141|\t\t\tif _, err := BuildCommand(directive, args); err == nil {\n142|\t\t\t\tt.Fatalf(\"BuildCommand(%s, socket %q) admitted\", directive, socket)\n143|\t\t\t} else {\n144|\t\t\t\trequireLocalCode(t, err, \"tmux_ambient_server_reuse\", \"command socket\")\n145|\t\t\t}\n146|\t\t}\n147|\t}\n148|}\n149|\n150|func TestBuildCommandRefusesBadIdentity(t *testing.T) {\n151|\tsocket := \"/root/tmux/ax.sock\"\n152|\targs := lxCommandArgs(socket)\n153|\targs.InstanceID = \"not-a-uuid\"\n154|\tif _, err := BuildCommand(DirectiveHasSession, args); err == nil {\n155|\t\tt.Fatal(\"bad instance admitted\")\n156|\t} else {\n157|\t\trequireLocalCode(t, err, \"tmux_invalid_arguments\", \"command instance\")\n158|\t}\n159|\targs = lxCommandArgs(socket)\n160|\targs.SessionID = \"not-a-uuid\"\n161|\tif _, err := BuildCommand(DirectiveNewSession, args); err == nil {\n162|\t\tt.Fatal(\"bad session admitted\")\n163|\t} else {\n164|\t\trequireLocalCode(t, err, \"tmux_invalid_arguments\", \"command session\")\n165|\t}\n166|\targs = lxCommandArgs(socket)\n167|\targs.QuiescenceGeneration = \"not-a-uuid\"\n168|\tif _, err := BuildCommand(DirectiveWaitBoundary, args); err == nil {\n169|\t\tt.Fatal(\"bad quiescence admitted\")\n170|\t} else {\n171|\t\trequireLocalCode(t, err, \"tmux_invalid_arguments\", \"command quiescence\")\n172|\t}\n173|}\n174|\n175|func TestScrubTmuxEnv(t *testing.T) {\n176|\tenv := []string{\n177|\t\t\"PATH=/usr/bin\",\n178|\t\t\"TMUX=/tmp/tmux-1000/default,1234,0\",\n179|\t\t\"TMUX_TMPDIR=/tmp/ambient\",\n180|\t\t\"TMUX_FOO=keep\",\n181|\t\t\"AX_TMUX=keep\",\n182|\t}\n183|\tscrubbed := scrubTmuxEnv(env)\n184|\tfor _, entry := range scrubbed {\n185|\t\tif entry == env[1] || entry == env[2] {\n186|\t\t\tt.Fatalf(\"ambient survived scrub: %q\", entry)\n187|\t\t}\n188|\t}\n189|\tif len(scrubbed) != 3 {\n190|\t\tt.Fatalf(\"scrubbed = %q\", scrubbed)\n191|\t}\n192|}\n193|\n194|// TestHelperProcess re-execs the test binary as a canned child process\n195|// for OSRunner tests: no shell, no tmux, deterministic exit/stdout.\n196|func TestHelperProcess(t *testing.T) {\n197|\tif os.Getenv(\"GO_WANT_HELPER_PROCESS\") != \"1\" {\n198|\t\treturn\n199|\t}\n200|\tif os.Getenv(\"TMUX\") != \"\" || os.Getenv(\"TMUX_TMPDIR\") != \"\" {\n201|\t\tos.Exit(42)\n202|\t}\n203|\tos.Stdout.WriteString(os.Getenv(\"HELPER_STDOUT\"))\n204|\tcode, _ := strconv.Atoi(os.Getenv(\"HELPER_EXIT\"))\n205|\tos.Exit(code)\n206|}\n207|\n208|func helperCommand(record *[][]string) func(context.Context, string, ...string) *exec.Cmd {\n209|\treturn func(ctx context.Context, name string, args ...string) *exec.Cmd {\n210|\t\t*record = append(*record, append([]string{name}, args...))\n211|\t\treturn exec.CommandContext(ctx, os.Args[0], \"-test.run=TestHelperProcess\", \"--\")\n212|\t}\n213|}\n214|\n215|func TestOSRunnerReportsExitAsData(t *testing.T) {\n216|\tt.Setenv(\"GO_WANT_HELPER_PROCESS\", \"1\")\n217|\tt.Setenv(\"HELPER_STDOUT\", \"out\\n\")\n218|\tt.Setenv(\"HELPER_EXIT\", \"3\")\n219|\tvar recorded [][]string\n220|\trunner := OSRunner{Command: helperCommand(&recorded)}\n221|\tresult, err := runner.Run(context.Background(), []string{\"tmux\", \"-S\", \"sock\", \"has-session\"})\n222|\tif err != nil {\n223|\t\tt.Fatal(err)\n224|\t}\n225|\tif result.ExitCode != 3 || string(result.Stdout) != \"out\\n\" {\n226|\t\tt.Fatalf(\"result = %+v\", result)\n227|\t}\n228|\tif len(recorded) != 1 || recorded[0][0] != \"tmux\" {\n229|\t\tt.Fatalf(\"recorded = %q\", recorded)\n230|\t}\n231|}\n232|\n233|func TestOSRunnerScrubsAmbientInChild(t *testing.T) {\n234|\tt.Setenv(\"TMUX\", \"/tmp/tmux-1000/default,1234,0\")\n235|\tt.Setenv(\"TMUX_TMPDIR\", \"/tmp/ambient\")\n236|\tt.Setenv(\"GO_WANT_HELPER_PROCESS\", \"1\")\n237|\tt.Setenv(\"HELPER_STDOUT\", \"\")\n238|\tt.Setenv(\"HELPER_EXIT\", \"0\")\n239|\tvar recorded [][]string\n240|\trunner := OSRunner{Command: helperCommand(&recorded)}\n241|\tresult, err := runner.Run(context.Background(), []string{\"tmux\", \"ls\"})\n242|\tif err != nil {\n243|\t\tt.Fatal(err)\n244|\t}\n245|\tif result.ExitCode == 42 {\n246|\t\tt.Fatal(\"child observed ambient tmux variables\")\n247|\t}\n248|\tif result.ExitCode != 0 {\n249|\t\tt.Fatalf(\"exit = %d\", result.ExitCode)\n250|\t}\n251|}\n252|\n253|func TestOSRunnerRefusesBadArgv(t *testing.T) {\n254|\trunner := OSRunner{}\n255|\tif _, err := runner.Run(context.Background(), nil); err == nil {\n256|\t\tt.Fatal(\"empty argv admitted\")\n257|\t} else {\n258|\t\trequireLocalCode(t, err, \"tmux_invalid_arguments\", \"command argv\")\n259|\t}\n260|\tif _, err := runner.Run(context.Background(), []string{\"tmux\", \"\"}); err == nil {\n261|\t\tt.Fatal(\"empty element admitted\")\n262|\t} else {\n263|\t\trequireLocalCode(t, err, \"tmux_invalid_arguments\", \"command argv\")\n264|\t}\n265|}\n266|\n267|func TestOSRunnerTransportErrorProvesNothing(t *testing.T) {\n268|\trunner := OSRunner{Command: func(ctx context.Context, name string, args ...string) *exec.Cmd {\n269|\t\treturn exec.CommandContext(ctx, \"/nonexistent-ax-binary-xyz\", args...)\n270|\t}}\n271|\tif _, err := runner.Run(context.Background(), []string{\"/nonexistent-ax-binary-xyz\"}); err == nil {\n272|\t\tt.Fatal(\"missing binary reported success\")\n273|\t}\n274|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
