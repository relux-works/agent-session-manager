 path=f\\\"{PACKAGE}/backend.go\\\",\\n        find='\\\\\\\\tif result.ExitCode != 0 {\\\\\\\\n\\\\\\\\t\\\\\\\\tif runner.waitCtx.Err() != nil {\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\treturn \\\"\\\", &terminstance.Error{Code: terminstance.CodeQuiesceTimeout, Detail: \\\"backend boundary wait\\\"}\\\\\\\\n\\\\\\\\t\\\\\\\\t}\\\\\\\\n\\\\\\\\t\\\\\\\\treturn \\\"\\\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \\\"backend effect refused\\\"}\\\\\\\\n\\\\\\\\t}\\\\\\\\n',\\n        replace='\\\\\\\\tif result.ExitCode != 0 && result.ExitCode != 1 {\\\\\\\\n\\\\\\\\t\\\\\\\\tif runner.waitCtx.Err() != nil {\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\treturn \\\"\\\", &terminstance.Error{Code: terminstance.CodeQuiesceTimeout, Detail: \\\"backend boundary wait\\\"}\\\\\\\\n\\\\\\\\t\\\\\\\\t}\\\\\\\\n\\\\\\\\t\\\\\\\\treturn \\\"\\\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \\\"backend effect refused\\\"}\\\\\\\\n\\\\\\\\t}\\\\\\\\n',\\n        count=1,\\n        run=\\\"(TestPerformEffectBoundaryRefusedExit|TestExecuteBoundaryRefusesFailedWait)\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the exit-1 boundary wait past the refused-exit arm; every other nonzero exit still refuses. Kill path: the failed wait evidences a boundary, at the helper and through the boundary dispatch alike.\\\",\\n    ),\\n'''\\ntext = text.replace(anchor, rows + anchor)\\np.write_text(text)\\nprint(\\\"rows added\\\")\\nPYEOF\\ngrep -c 'name=\\\"N-' internal/tmuxserver/mutant_harness.py\",\n  \"description\": \"Add lookup and exit mutants\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"rows added\\n207\\n\",\n  \"original_output_bytes\": 15,\n  \"original_output_tokens\": 4,\n  \"truncated\": false\n}","final_result":true}}}
