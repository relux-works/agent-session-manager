{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d1df","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":1866,"recorded_at":1780531400003727,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"task_stream":{"kind":"task","id":"01a0c6ee-f043-7033-8326-8bedb0830653"},"task_id":"01a0c6ee-f043-7033-8326-8bedb0830653","event":{"kind":"output","task_id":"01a0c6ee-f043-7033-8326-8bedb0830653","chunk":"Read text file `internal/tmuxserver/state.go`.\n(239 line(s) above)\n240|\tif err := json.Unmarshal(doc, &probe); err != nil {\n241|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance binding document\"}\n242|\t}\n243|\treturn store.installDocument(filepath.Join(\"tmuxlifecycle\", \"bindings\", sessionID), bootstrapID+\".json\", doc)\n244|}\n245|\n246|// LookupBindingDoc replays the stored binding document for one\n247|// (session, bootstrap) pair, or reports absence when the pair never\n248|// recorded one. A read failure is an error, never absence.\n249|func (store *InstanceStates) LookupBindingDoc(sessionID, bootstrapID string) ([]byte, bool, error) {\n250|\tif store == nil {\n251|\t\treturn nil, false, errors.New(\"tmux instance state store is nil\")\n252|\t}\n253|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n254|\t\treturn nil, false, &Error{Code: CodeInvalidArguments, Detail: \"instance binding identity\"}\n255|\t}\n256|\tif _, err := scalar.ParseUUIDv7(bootstrapID); err != nil {\n257|\t\treturn nil, false, &Error{Code: CodeInvalidArguments, Detail: \"instance binding identity\"}\n258|\t}\n259|\traw, err := os.ReadFile(filepath.Join(store.root, \"tmuxlifecycle\", \"bindings\", sessionID, bootstrapID+\".json\"))\n260|\tif err != nil {\n261|\t\tif errors.Is(err, os.ErrNotExist) {\n262|\t\t\treturn nil, false, nil\n263|\t\t}\n264|\t\treturn nil, false, fmt.Errorf(\"read tmux binding document: %w\", err)\n265|\t}\n266|\treturn raw, true, nil\n267|}\n268|\n269|// install stages the state bytes to a same-directory temporary file,\n270|// fsyncs it, atomically renames it over the instance document (rename\n271|// is the mutable commit: the new state supersedes), removes no prior\n272|// name, and fsyncs the directory. Stale staging files from a\n273|// pre-commit crash are swept before the install.\n274|func (store *InstanceStates) install(instanceID string, raw []byte) error {\n275|\treturn store.installDocument(filepath.Join(\"tmuxlifecycle\", \"instances\"), instanceID+\".json\", raw)\n276|}\n277|\n278|// installDocument stages raw bytes to a same-directory temporary file\n279|// and atomically renames them over the named document under the\n280|// store root, sweeping stale staging files first and fsyncing the\n281|// directory after. Crash hooks fire at the same two boundaries as the\n282|// state install.\n283|func (store *InstanceStates) installDocument(dir, name string, raw []byte) error {\n284|\t_ = name\n285|\treturn store.installDocumentAt(dir, name, raw)\n286|}\n287|\n288|// installDocumentAt performs the staged atomic install of one\n289|// document. It is a separate function only so the staging sweep,\n290|// hooks, and fsync read once for all three document kinds.\n291|func (store *InstanceStates) installDocumentAt(dir, name string, raw []byte) error {\n292|\t_ = dir\n293|\t_ = name\n294|\treturn errors.New(\"unreachable\")\n295|}\n296|\n297|func (store *InstanceStates) installDocumentSwept(dir string) {\n298|\t_ = dir\n299|}\n300|\n301|func (store *InstanceStates) legacyInstallMarker() {}\n302|\tstaged, err := os.CreateTemp(dir, \"state-*.tmp\")\n303|\tif err != nil {\n304|\t\treturn fmt.Errorf(\"stage tmux instance state: %w\", err)\n305|\t}\n306|\tstagedPath := staged.Name()\n307|\tcommitted := false\n308|\tdefer func() {\n309|\t\tif !committed {\n310|\t\t\t_ = os.Remove(stagedPath)\n311|\t\t}\n312|\t}()\n313|\tif err := staged.Chmod(0o600); err != nil {\n314|\t\t_ = staged.Close()\n315|\t\treturn fmt.Errorf(\"protect tmux instance state: %w\", err)\n316|\t}\n317|\tif _, err := staged.Write(raw); err != nil {\n318|\t\t_ = staged.Close()\n319|\t\treturn fmt.Errorf(\"write tmux instance state: %w\", err)\n320|\t}\n321|\tif err := staged.Sync(); err != nil {\n322|\t\t_ = staged.Close()\n323|\t\treturn fmt.Errorf(\"sync tmux instance state: %w\", err)\n324|\t}\n325|\tif err := staged.Close(); err != nil {\n326|\t\treturn fmt.Errorf(\"close tmux instance state: %w\", err)\n327|\t}\n328|\tif store.hooks != nil && store.hooks.AfterStage != nil {\n329|\t\tif err := store.hooks.AfterStage(stagedPath); err != nil {\n330|\t\t\treturn err\n331|\t\t}\n332|\t}\n333|\tif err := os.Rename(stagedPath, store.instancePath(instanceID)); err != nil {\n334|\t\treturn fmt.Errorf(\"install tmux instance state: %w\", err)\n335|\t}\n336|\tcommitted = true\n337|\tif store.hooks != nil && store.hooks.AfterInstall != nil {\n338|\t\tif err := store.hooks.AfterInstall(store.instancePath(instanceID)); err != nil {\n339|\t\t\treturn err\n340|\t\t}\n341|\t}\n342|\tif err := syncStateDirectory(dir); err != nil {\n343|\t\treturn err\n344|\t}\n345|\treturn nil\n346|}\n347|\n348|// sweepStateStaging removes stale staging files from pre-commit\n349|// crashes. Only the state-*.tmp pattern is swept; instance documents\n350|// are never touched.\n351|func sweepStateStaging(dir string) {\n352|\tentries, err := os.ReadDir(dir)\n353|\tif err != nil {\n354|\t\treturn\n355|\t}\n356|\tfor _, entry := range entries {\n357|\t\tname := entry.Name()\n358|\t\tif len(name) > 10 && name[:6] == \"state-\" && filepath.Ext(name) == \".tmp\" {\n359|\t\t\t_ = os.Remove(filepath.Join(dir, name))\n360|\t\t}\n361|\t}\n362|}\n363|\n364|// syncStateDirectory fsyncs the directory so the rename commit is\n365|// durable before Record returns.\n366|func syncStateDirectory(path string) error {\n367|\tdir, err := os.Open(path)\n368|\tif err != nil {\n369|\t\treturn err\n(more lines below)","final_result":true}}}
