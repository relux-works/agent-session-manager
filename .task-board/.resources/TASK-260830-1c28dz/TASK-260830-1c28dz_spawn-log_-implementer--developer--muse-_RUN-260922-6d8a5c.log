 name=\\\"N-outcome-key-record\\\",\\n        path=f\\\"{PACKAGE}/state.go\\\",\\n        find='\\\\\\\\tif key == \\\"\\\" {\\\\\\\\n\\\\\\\\t\\\\\\\\treturn &Error{Code: CodeInvalidArguments, Detail: \\\"instance outcome key\\\"}\\\\\\\\n\\\\\\\\t}\\\\\\\\n',\\n        replace='\\\\\\\\tif key == \\\"\\\" && outcome.Operation != \\\"\\\" {\\\\\\\\n\\\\\\\\t\\\\\\\\treturn &Error{Code: CodeInvalidArguments, Detail: \\\"instance outcome key\\\"}\\\\\\\\n\\\\\\\\t}\\\\\\\\n',\\n        count=1,\\n        run=\\\"TestInstanceStatesOutcomeRoundTrip\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the empty-key empty-operation outcome past the record key arm; empty keys with an operation still refuse. Kill path: the keyless outcome records.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-binddoc-session-identity\\\",\\n        path=f\\\"{PACKAGE}/state.go\\\",\\n        find='\\\\\\\\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\\\\\\\\n\\\\\\\\t\\\\\\\\treturn &Error{Code: CodeInvalidArguments, Detail: \\\"instance binding identity\\\"}\\\\\\\\n\\\\\\\\t}\\\\\\\\n',\\n        replace='\\\\\\\\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil && sessionID != \\\"not-a-uuid\\\" {\\\\\\\\n\\\\\\\\t\\\\\\\\treturn &Error{Code: CodeInvalidArguments, Detail: \\\"instance binding identity\\\"}\\\\\\\\n\\\\\\\\t}\\\\\\\\n',\\n        count=1,\\n        run=\\\"TestInstanceStatesBindingDocRoundTrip\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the malformed session past the binding-doc identity arm; every other malformed identity still refuses. Kill path: the unparseable pair records a document.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-binddoc-document-shape\\\",\\n        path=f\\\"{PACKAGE}/state.go\\\",\\n        find='\\\\\\\\tvar probe map[string]any\\\\\\\\n\\\\\\\\tif err := json.Unmarshal(doc, &probe); err != nil {\\\\\\\\n',\\n        replace='\\\\\\\\tvar probe map[string]any\\\\\\\\n\\\\\\\\t