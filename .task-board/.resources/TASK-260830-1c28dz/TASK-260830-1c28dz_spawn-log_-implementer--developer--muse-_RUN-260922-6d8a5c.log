{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000f25d","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":6025,"recorded_at":1780531400012045,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"task_stream":{"kind":"task","id":"01a0c723-35c5-7221-844f-224749464e30"},"task_id":"01a0c723-35c5-7221-844f-224749464e30","event":{"kind":"output","task_id":"01a0c723-35c5-7221-844f-224749464e30","chunk":"{\n  \"chunk_id\": \"exec-122-1\",\n  \"command\": \"python3 - <<'PYEOF'\\nimport json\\nfrom pathlib import Path\\n\\ndef outcomes(path):\\n    grid = {}\\n    for line in Path(path).read_text().splitlines():\\n        try:\\n            event = json.loads(line)\\n        except json.JSONDecodeError:\\n            continue\\n        if event.get(\\\"Action\\\") in (\\\"pass\\\", \\\"fail\\\", \\\"skip\\\") and event.get(\\\"Test\\\"):\\n            test = event[\\\"Test\\\"]\\n            if \\\"/\\\" in test:  # subtests roll up to parents; keep top-level only for the grid\\n                continue\\n            pkg = event.get(\\\"Package\\\", \\\"\\\").split(\\\"/\\\")[-1]\\n            grid[(pkg, test)] = event[\\\"Action\\\"]\\n    return grid\\n\\nbase = outcomes(\\\"/tmp/c28dz/importer-base.json\\\")\\ncand = outcomes(\\\"/tmp/c28dz/importer-cand.json\\\")\\nprint(\\\"base inputs:\\\", len(base), \\\"cand inputs:\\\", len(cand))\\nmoved = [(k, base[k], cand[k]) for k in base if k in cand and base[k] != cand[k]]\\nadded = sorted(k for k in cand if k not in base)\\nremoved = sorted(k for k in base if k not in cand)\\nprint(\\\"MOVED:\\\", len(moved))\\nfor k, b, c in moved:\\n    print(\\\" \\\", k, b, \\\"->\\\", c)\\nprint(\\\"ADDED:\\\", len(added))\\npkgs = {}\\nfor pkg, test in added:\\n    pkgs.setdefault(pkg, []).append(test)\\nfor pkg in sorted(pkgs):\\n    print(f\\\"  {pkg}: {len(pkgs[pkg])} added\\\")\\nprint(\\\"REMOVED:\\\", len(removed))\\nfor k in removed:\\n    print(\\\" -\\\", k)\\n# save full added list for the evidence file\\nPath(\\\"/tmp/c28dz/importer-added.txt\\\").write_text(\\\"\\\\n\\\".join(f\\\"{p}/{t} {cand[(p,t)]}\\\" for p, t in added) + \\\"\\\\n\\\")\\nPYEOF\",\n  \"description\": \"Outcome-keyed JSON diff\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"base inputs: 2662 cand inputs: 2867\\nMOVED: 0\\nADDED: 205\\n  tmuxserver: 205 added\\nREMOVED: 0\\n\",\n  \"original_output_bytes\": 91,\n  \"original_output_tokens\": 23,\n  \"truncated\": false\n}","final_result":true}}}
