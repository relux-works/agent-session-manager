{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c965","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":781,"recorded_at":1780531400001557,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"task_stream":{"kind":"task","id":"01a0c6dc-8039-7882-8a75-71356a07365e"},"task_id":"01a0c6dc-8039-7882-8a75-71356a07365e","event":{"kind":"output","task_id":"01a0c6dc-8039-7882-8a75-71356a07365e","chunk":"Read text file `internal/tmuxserver/socket.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"path/filepath\"\n5|\t\"strings\"\n6|)\n7|\n8|// SocketName is the fixed private socket leaf inside the runtime\n9|// directory: pinned SPEC 806-807 selects the dedicated server by\n10|// `tmux -S <runtime>/tmux/ax.sock`, so the leaf is `ax.sock`. AX\n11|// derives its server socket from this name under the owner-only\n12|// directory and from nothing else.\n13|const SocketName = \"ax.sock\"\n14|\n15|// Ambient environment names the four discovery vectors AX must never\n16|// use. TMUXEnv and TMUXTmpDir name the two environment variables\n17|// whose values may carry an ambient socket; InheritedSocket is a\n18|// socket path handed to the process out of band; DefaultPath is the\n19|// operator default socket path; ConventionalName is the bare\n20|// conventional socket name. No member of this struct ever selects\n21|// the acquisition socket: ResolveSocket derives the socket from the\n22|// runtime directory and refuses any explicit override.\n23|type Ambient struct {\n24|\tTMUXEnv          string\n25|\tTMUXTmpDir       string\n26|\tInheritedSocket  string\n27|\tDefaultPath      string\n28|\tConventionalName string\n29|}\n30|\n31|// Ambient environment variable names. These are the lookup keys the\n32|// caller passes to its own environment function; ObserveAmbient\n33|// records whatever the lookup returns for them without validating\n34|// names or values, because the observation is evidence only and\n35|// resolution never reads it.\n36|const (\n37|\t// EnvTMUX is the tmux(1) session environment variable.\n38|\tEnvTMUX = \"TMUX\"\n39|\t// EnvTMUXTmpDir is the tmux(1) socket-directory override.\n40|\tEnvTMUXTmpDir = \"TMUX_TMPDIR\"\n41|)\n42|\n43|// ConventionalSocketName is the operator default socket leaf that AX\n44|// must never resolve to.\n45|const ConventionalSocketName = \"default\"\n46|\n47|// ObserveAmbient records the ambient socket facts visible to the\n48|// caller without using any of them. The lookup is caller-supplied so\n49|// the production entry never reads the process environment itself:\n50|// ambient discovery cannot hide in an os.Getenv call this package\n51|// never makes. The observation is evidence only; resolution derives\n52|// the socket from the runtime directory and never reads it.\n53|func ObserveAmbient(lookup func(name string) (string, bool), inherited, defPath, conventional string) Ambient {\n54|\tobserved := Ambient{\n55|\t\tInheritedSocket:  inherited,\n56|\t\tDefaultPath:      defPath,\n57|\t\tConventionalName: conventional,\n58|\t}\n59|\tif lookup == nil {\n60|\t\treturn observed\n61|\t}\n62|\tif value, ok := lookup(EnvTMUX); ok {\n63|\t\tobserved.TMUXEnv = value\n64|\t}\n65|\tif value, ok := lookup(EnvTMUXTmpDir); ok {\n66|\t\tobserved.TMUXTmpDir = value\n67|\t}\n68|\treturn observed\n69|}\n70|\n71|// SocketPath derives the dedicated server socket from the runtime\n72|// directory. It is the only socket constructor: acquisition never\n73|// substitutes an ambient value for its result.\n74|func SocketPath(runtimeDir string) string {\n75|\treturn filepath.Join(runtimeDir, SocketName)\n76|}\n77|\n78|// ResolveSocket returns the acquisition socket for the runtime\n79|// directory. An explicit override refuses with the ambient code no\n80|// matter which vector supplied it: there is no override surface,\n81|// only the derived socket. The ambient observation is carried for\n82|// evidence and asserted disjoint from the result by the caller\n83|// tests; resolution never reads it.\n84|func ResolveSocket(runtimeDir string, override string, ambient Ambient) (string, error) {\n85|\tif override != \"\" {\n86|\t\treturn \"\", &Error{Code: CodeAmbientReuse, Detail: \"socket override\"}\n87|\t}\n88|\tsocket := SocketPath(runtimeDir)\n89|\tif err := checkAmbientDisjoint(socket, ambient); err != nil {\n90|\t\treturn \"\", err\n91|\t}\n92|\treturn socket, nil\n93|}\n94|\n95|// checkAmbientDisjoint refuses the degenerate case where an ambient\n96|// value already names the derived socket: using the socket then\n97|// would be indistinguishable from reusing the ambient server, so\n98|// acquisition refuses instead of proceeding on an ambiguous fact.\n99|// The comparison runs over cleaned spellings, so an ambient value\n100|// that names the socket through a `/./` segment or a doubled\n101|// separator refuses like the byte-identical spelling; the TMUX\n102|// member compares its socket component, because tmux(1) encodes that\n103|// variable as `<socket>,<pid>,<index>`. A symlink alias of the root\n104|// that resolves to the same socket is not detected and stays a\n105|// stated bound.\n106|func checkAmbientDisjoint(socket string, ambient Ambient) error {\n107|\tfor _, candidate := range []string{\n108|\t\ttmuxEnvSocket(ambient.TMUXEnv),\n109|\t\tambient.TMUXTmpDir,\n110|\t\tambient.InheritedSocket,\n111|\t\tambient.DefaultPath,\n112|\t\tambient.ConventionalName,\n113|\t} {\n114|\t\tif candidate != \"\" && filepath.Clean(candidate) == socket {\n115|\t\t\treturn &Error{Code: CodeAmbientReuse, Detail: \"ambient collision\"}\n116|\t\t}\n117|\t}\n118|\treturn nil\n119|}\n120|\n121|// tmuxEnvSocket returns the socket component of a TMUX environment\n122|// value, which tmux(1) encodes as `<socket>,<pid>,<index>`: the\n123|// substring before the first comma. A value without a comma compares\n124|// whole, and an empty component compares as absent.\n125|func tmuxEnvSocket(value string) string {\n126|\tif i := strings.IndexByte(value, ','); i >= 0 {\n127|\t\treturn value[:i]\n128|\t}\n129|\treturn value\n130|}","final_result":true}}}
