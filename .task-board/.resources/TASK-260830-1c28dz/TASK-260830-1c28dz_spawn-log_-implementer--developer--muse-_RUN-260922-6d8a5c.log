ver_rebooted effect past the closed effect vocabulary; every other unknown effect still refuses. Kill path: the foreign effect commits with evidence.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-backend-exit-refused\\\",\\n        path=f\\\"{PACKAGE}/backend.go\\\",\\n        find='\\\\tresult, err := runner.runner.Run(ctx, argv)\\\\n\\\\tif err != nil {\\\\n\\\\t\\\\treturn \\\"\\\", err\\\\n\\\\t}\\\\n\\\\tif result.ExitCode != 0 {\\\\n',\\n        replace='\\\\tresult, err := runner.runner.Run(ctx, argv)\\\\n\\\\tif err != nil {\\\\n\\\\t\\\\treturn \\\"\\\", err\\\\n\\\\t}\\\\n\\\\tif result.ExitCode != 0 && result.ExitCode != 1 {\\\\n',\\n        count=1,\\n        run=\\\"TestPerformEffectRefusesFailedExec\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly exit-1 effects past the nonzero-exit refusal; every other nonzero exit still refuses. Kill path: the failed exec evidences a commit.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-backend-transport-unknown\\\",\\n        path=f\\\"{PACKAGE}/backend.go\\\",\\n        find='\\\\tresult, err := runner.runner.Run(ctx, argv)\\\\n\\\\tif err != nil {\\\\n\\\\t\\\\treturn \\\"\\\", err\\\\n\\\\t}\\\\n\\\\tif result.ExitCode != 0 {\\\\n',\\n        replace='\\\\tresult, err := runner.runner.Run(ctx, argv)\\\\n\\\\tif err != nil && err.Error() != \\\"fake runner transport failure\\\" {\\\\n\\\\t\\\\treturn \\\"\\\", err\\\\n\\\\t}\\\\n\\\\tif result.ExitCode != 0 {\\\\n',\\n        count=1,\\n        run=\\\"TestPerformEffectTransportProvesNothing\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the fixture transport failure past the unknown pass-through (it falls into the zero-result exit check and commits); every other transport failure still passes through uncoded. Kill path: the unproven effect evidences a commit.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-backend-reconfirm-failed-kill\\\",\\n        path=f\\\"{PACKAGE}/backend.go\\\",\\n        find='\\\\tif runner.killExit != 0 {\\\\n\\\\t\\\\treturn \\\"\\\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \\\"backend effect refused\\\"}\\\\n\\\\t}\\\\n',\\n        replace='\\\\tif runner.killExit != 0 {\\\\n\\\\t\\\\treturn effectEvidence(terminalbackend.EffectProcessClosed, runner.operation, runner.instanceID, \\\"failed-kill-live\\\"), nil\\\\n\\\\t}\\\\n',\\n        count=1,\\n        run=\\\"TestPerformEffectTerminateReconfirmRefusesFailedKill\\\",\\n        expect=\\\"KILLED\\\",\\n====\\n454:        name=\\\"N-probe-swallow-foreground\\\",\\n464:        name=\\\"N-probe-swallow-background\\\",\\n554:        name=\\\"N-verify-absence-detail\\\",\\n564:        name=\\\"N-background-absence-remap\\\",\\n574:        name=\\\"N-absence-remap-widen\\\",\\n634:        name=\\\"N-absence-remap-ownership\\\",\\n714:        name=\\\"N-absence-remap-containment\\\",\\n724:        name=\\\"N-absence-remap-invalid\\\",\\n894:        name=\\\"N-lifecycle-restore-capability\\\",\\n914:        name=\\\"N-lifecycle-replay-session\\\",\\n944:        name=\\\"N-lifecycle-entry-deadline-restore\\\",\\n964:        name=\\\"N-lifecycle-restore-authkind\\\",\\n1054:        name=\\\"N-lifecycle-restore-mismatch\\\",\\n1114:        name=\\\"N-exec-quiescence-identity\\\",\\n1244:        name=\\\"N-bodies-restore-count\\\",\\n1304:        name=\\\"N-backend-reconfirm-failed-kill\\\",\\n1314:        name=\\\"N-backend-boundary-timeout\\\",\\n1374:        name=\\\"N-probe-dial-refused\\\",\\n1384:        name=\\\"N-probe-dial-enoent\\\",\\n1394:        name=\\\"N-probe-unknown-passthrough\\\",\\n1404:        name=\\\"N-probe-deps-dialer\\\",\\n1414:        name=\\\"N-probe-deps-admit\\\",\\n1454:        name=\\\"N-bind-length-boundary\\\",\\n1484:        name=\\\"N-bind-ancestor-writable\\\",\\n1524:        name=\\\"N-attach-deadline-boundary\\\",\\n1584:        name=\\\"N-engineop-quiesce-generation\\\",\\n1594:        name=\\\"N-engineop-boundary-evidence\\\",\\n1634