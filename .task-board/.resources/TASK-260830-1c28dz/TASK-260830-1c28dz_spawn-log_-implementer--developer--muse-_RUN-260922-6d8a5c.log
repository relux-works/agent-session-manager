cute(context.Background(), OpRequest{\n+\t\t\tOperation: \"restore\", Body: lxRestoreBody(t, lxDigestA, nil), Source: \"absent\", Admitted: fullLifecycleAdmitted(),\n+\t\t})\n+\t\tif err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tbranch := outcome.AfterRestore\n+\t\tif branch == nil || branch.Action != \"parked\" || branch.RefreshAttempted {\n+\t\t\tt.Fatalf(\"branch = %+v\", branch)\n+\t\t}\n+\t})\n+\tt.Run(\"remote-noninteractive\", func(t *testing.T) {\n+\t\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n+\t\tfx.lc.LocalHostID = lxHost\n+\t\tfx.lc.LeaseRefresh = func(ctx context.Context, sessionID string) (RefreshWinner, error) {\n+\t\t\treturn RefreshWinner{LeaseID: lxLeaseB, Epoch: 9, HolderHostID: lxRemoteHost}, nil\n+\t\t}\n+\t\trecordBinding(t, fx, lxDigestA)\n+\t\tfx.runner.queue(\"new-session\", \"\", 0)\n+\t\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n+\t\t\tOperation: \"restore\", Body: lxRestoreBody(t, lxDigestA, nil), Source: \"absent\", Admitted: fullLifecycleAdmitted(),\n+\t\t})\n+\t\tif err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tif outcome.AfterRestore == nil || outcome.AfterRestore.Action != \"parked\" {\n+\t\t\tt.Fatalf(\"branch = %+v\", outcome.AfterRestore)\n+\t\t}\n+\t})\n+\tt.Run(\"local-invalid-material\", func(t *testing.T) {\n+\t\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n+\t\tfx.lc.LocalHostID = lxHost\n+\t\tfx.lc.LeaseRefresh = func(ctx context.Context, sessionID string) (RefreshWinner, error) {\n+\t\t\treturn RefreshWinner{LeaseID: lxLease, Epoch: 7, HolderHostID: lxHost}, nil\n+\t\t}\n+\t\tfx.lc.Materialization = func(sessionID, checkpointID string) (bool, error) { return false, nil }\n+\t\trecordBinding(t, fx, lxDigestA)\n+\t\tfx.runner.queue(\"new-session\", \"\", 0)\n+\t\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n+\t\t\tOperation: \"restore\", Body: lxRestoreBody(t, lxDigestA, nil), Source: \"absent\",\n+\t\t\tAdmitted: fullLifecycleAdmitted(), Interactive: true,\n+\t\t})\n+\t\tif err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tif outcome.AfterRestore == nil || outcome.AfterRestore.Action != \"parked\" {\n+\t\t\tt.Fatalf(\"branch = %+v\", outcome.AfterRestore)\n+\t\t}\n+\t})\n+\tt.Run(\"refresh-failure-falls-back\", func(t *testing.T) {\n+\t\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n+\t\tfx.lc.LocalHostID = lxHost\n+\t\tfx.lc.LeaseRefresh = func(ctx context.Context, sessionID string) (RefreshWinner, error) {\n+\t\t\treturn RefreshWinner{}, errors.New(\"mesh unreachable\")\n+\t\t}\n+\t\trecordBinding(t, fx, lxDigestA)\n+\t\tfx.runner.queue(\"new-session\", \"\", 0)\n+\t\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n+\t\t\tOperation: \"restore\", Body: lxRestoreBody(t, lxDigestA, nil), Source: \"absent\", Admitted: fullLifecycleAdmitted(),\n+\t\t})\n+\t\tif err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tbranch := outcome.AfterRestore\n+\t\tif branch == nil || branch.Action != \"parked\" || !branch.RefreshAttempted {\n+\t\t\tt.Fatalf(\"branch = %+v\", branch)\n+\t\t}\n+\t})\n+}\n+\n+func TestExecuteRestoreRefreshBounded(t *testing.T) {\n+\tt.Run(\"deadline\", func(t *testing.T) {\n+\t\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n+\t\tfx.lc.LocalHostID = lxHost\n+\t\tstart := time.Now()\n+\t\tvar deadline time.Time\n+\t\tvar hasDeadline bool\n+\t\tfx.lc.LeaseRefresh = func(ctx context.Context, sessionID string) (RefreshWinner, error) {\n+\t\t\tdeadline, hasDeadline = ctx.Deadline()\n+\t\t\treturn RefreshWinner{LeaseID: lxLease, Epoch: 7, HolderHostID: lxHost}, nil\n+\t\t}\n+\t\trecordBinding(t, fx, lxDigestA)\n+\t\tfx.runner.queue(\"new-session\", \"\", 0)\n+\t\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n+\t\t\tOperation: \"restore\", Body: lxRestoreBody(t, lxDigestA, nil), Source: \"absent\", Admitted: fullLifecycleAdmitted(),\n+\t\t})\n+\t\tif err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tif !hasDeadline {\n+\t\t\tt.Fatal(\"refresh ran without a deadline\")\n+\t\t}\n+\t\tif elapsed := deadline.Sub(start); elapsed < 5*time.Second || elapsed > 5*time.Second+30*time.Second {\n+\t\t\tt.Fatalf(\"refresh bound = %v, want 5s\", elapsed)\n+\t\t}\n+\t\tif outcome.AfterRestore == nil || outcome.AfterRestore.RefreshBoundMs != 5000 {\n+\t\t\tt.Fatalf(\"branch = %+v\", outcome.AfterRestore)\n+\t\t}\n+\t})\n+\tt.Run(\"blocking-refresh-completes\", func(t *testing.T) {\n+\t\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n+\t\tfx.lc.LocalHostID = lxHost\n+\t\tfx.lc.MeshRefreshTimeout = 50 * time.Millisecond\n+\t\tfx.lc.LeaseRefresh = func(ctx context.Context, sessionID string) (RefreshWinner, error) {\n+\t\t\t<-ctx.Done()\n+\t\t\treturn RefreshWinner{}, ctx.Err()\n+\t\t}\n+\t\trecordBinding(t, fx, lxDigestA)\n+\t\tfx.runner.queue(\"new-session\", \"\", 0)\n+\t\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n+\t\t\tOperation: \"restore\", Body: lxRestoreBody(t, lxDigestA, nil), Source: \"absent\", Admitted: fullLifecycleAdmitted(),\n+\t\t})\n+\t\tif err != nil {\n+\t\t\tt.Fatal(err)\n+\t\t}\n+\t\tif outcome.AfterRestore == nil || outcome.AfterRestore.Action != \"parked\" {\n+\t\t\tt.Fatalf(\"branch = %+v\", outcome.AfterRestore)\n+\t\t}\n+\t\tif outcome.AfterRestore.RefreshBoundMs != 50 {\n+\t\t\tt.Fatalf(\"branch = %+v\", outcome.AfterRestore)\n+\t\t}\n+\t})\n+}\n","edit_facts":{"tool_name":"edit_file","path":"internal/tmuxserver/lifecycle_rework_unix_test.go","added":286,"removed":8},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
