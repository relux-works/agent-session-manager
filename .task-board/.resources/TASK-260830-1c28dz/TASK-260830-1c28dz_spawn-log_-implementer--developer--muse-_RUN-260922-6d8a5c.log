{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d7a3","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":2604,"recorded_at":1780531400005203,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"call_id":"call_01a0c6f3965b7630a94383023d08b7a7","text":"edited\nchanged lines: lines 401-411\n--- original\n+++ updated\n@@\n-\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n-\treqBackend.operation = operation\n-\treqBackend.bootstrapID = body.BootstrapOperationID\n-\t// The persist effect replays the recorded pair receipt (verified\n-\t// by the mismatch arm above); the candidate carries the matched\n-\t// prior digest so the store admits its shape on the replay path.\n-\treqBackend.bindingID = body.PriorBindingID\n-\treturn lc.executeWithReceipt(ctx, req, socket, operation, mctx, source, target, effects, deadline, terminstance.AuthorizationRestore, reqBackend, func(result terminstance.Result) OpOutcome {\n-\t\treturn OpOutcome{Operation: operation, Mutation: &result, PriorBindingID: body.PriorBindingID, RestoredParked: true}\n-\t})\n-}\n+\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n+\treqBackend.operation = operation\n+\treqBackend.bootstrapID = body.BootstrapOperationID\n+\t// The persist effect replays the recorded pair receipt (verified\n+\t// by the mismatch arm above); the candidate carries the matched\n+\t// prior digest so the store admits its shape on the replay path.\n+\treqBackend.bindingID = body.PriorBindingID\n+\toutcome, err := lc.executeWithReceipt(ctx, req, socket, operation, mctx, source, target, effects, deadline, terminstance.AuthorizationRestore, reqBackend, func(result terminstance.Result) OpOutcome {\n+\t\treturn OpOutcome{Operation: operation, Mutation: &result, PriorBindingID: body.PriorBindingID, RestoredParked: true}\n+\t})\n+\tif err != nil {\n+\t\treturn outcome, err\n+\t}\n+\tbinding, err := lc.restoreBinding(mctx, body)\n+\tif err != nil {\n+\t\treturn outcome, err\n+\t}\n+\toutcome.Binding = binding\n+\tbranch := lc.afterRestoreBranch(ctx, req, mctx, body)\n+\toutcome.AfterRestore = &branch\n+\treturn outcome, nil\n+}\n+\n+// restoreBinding reads the required restore result binding: the\n+// create-time document kept under the (session, bootstrap) pair,\n+// re-admitted by the termbind owner. A missing document is the\n+// backend store failure — the receipt proved the prior, but the\n+// payload is gone, so the required result cannot be built. A\n+// document that fails termbind admission, or that names another\n+// session, instance, backend, or generation than the mutation\n+// context, is the integrity failure: the store disagrees with the\n+// receipt it stands beside.\n+func (lc *Lifecycle) restoreBinding(mctx terminstance.MutationContext, body RestoreBody) (*termbind.Binding, error) {\n+\tdoc, found, err := lc.States.LookupBindingDoc(mctx.SessionID, body.BootstrapOperationID)\n+\tif err != nil {\n+\t\treturn nil, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n+\t}\n+\tif !found {\n+\t\treturn nil, &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n+\t}\n+\tbinding, err := termbind.ParseTerminalBinding(doc)\n+\tif err != nil {\n+\t\treturn nil, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n+\t}\n+\tif binding.SessionID != mctx.SessionID ||\n+\t\tbinding.TerminalInstanceID != mctx.TerminalInstanceID ||\n+\t\tbinding.TerminalBackendID != mctx.TerminalBackendID ||\n+\t\tbinding.BackendGeneration != mctx.BackendGeneration {\n+\t\treturn nil, &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"restore binding image\"}\n+\t}\n+\treturn &binding, nil\n+}\n+\n+// afterRestoreBranch runs the §4.2 after-restore sequence over the\n+// winning-lease view: read the latest locally known lease, attempt\n+// the mesh refresh under the measured bound, then branch. Local\n+// resume requires the local host to hold the lease the refresh (or,\n+// without one, local knowledge) names AND a valid materialization;\n+// a remote winner in an interactive terminal offers remote\n+// attach/takeover; every other case parks without launching a\n+// provider. The refresh is attempted, never required: a missing,\n+// failed, or timed-out attempt falls back to local knowledge.\n+func (lc *Lifecycle) afterRestoreBranch(ctx context.Context, req OpRequest, mctx terminstance.MutationContext, body RestoreBody) AfterRestoreOutcome {\n+\tlocal := lc.CurrentLease()\n+\tbound := lc.MeshRefreshTimeout\n+\tif bound <= 0 {\n+\t\tbound = DefaultMeshRefreshTimeout\n+\t}\n+\twinner := RefreshWinner{LeaseID: local.LeaseID, Epoch: local.Epoch, HolderHostID: mctx.Authorization.HolderHostID}\n+\tattempted := false\n+\tif lc.LeaseRefresh != nil {\n+\t\tattempted = true\n+\t\trefreshCtx, cancel := context.WithTimeout(ctx, bound)\n+\t\trefreshed, err := lc.LeaseRefresh(refreshCtx, mctx.SessionID)\n+\t\tcancel()\n+\t\tif err == nil {\n+\t\t\twinner = refreshed\n+\t\t}\n+\t}\n+\tlocalWins := lc.LocalHostID != \"\" &&\n+\t\twinner.HolderHostID == lc.LocalHostID &&\n+\t\twinner.LeaseID == local.LeaseID &&\n+\t\twinner.Epoch == local.Epoch\n+\tmaterial := false\n+\tif lc.Materialization != nil {\n+\t\tif valid, err := lc.Materialization(mctx.SessionID, body.CheckpointID); err == nil && valid {\n+\t\t\tmaterial = true\n+\t\t}\n+\t}\n+\taction := AfterRestoreParked\n+\tswitch {\n+\tcase localWins && material:\n+\t\taction = AfterRestoreResumed\n+\tcase !localWins && req.Interactive:\n+\t\taction = AfterRestoreRemoteOffer\n+\t}\n+\treturn AfterRestoreOutcome{\n+\t\tAction:           action,\n+\t\tWinnerLeaseID:    winner.LeaseID,\n+\t\tWinnerHostID:     winner.HolderHostID,\n+\t\tRefreshAttempted: attempted,\n+\t\tRefreshBoundMs:   uint64(bound.Milliseconds()),\n+\t}\n+}\n","edit_facts":{"tool_name":"edit_file","path":"internal/tmuxserver/ops.go","added":104,"removed":11},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
