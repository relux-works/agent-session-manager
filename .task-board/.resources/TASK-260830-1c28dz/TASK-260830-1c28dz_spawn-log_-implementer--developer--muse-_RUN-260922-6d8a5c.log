|\tsocket := filepath.Join(root, RuntimeDirName, SocketName)\n139|\tif err := CheckSocketCustody(socket, root, scalar.PlatformMacOS); err != nil {\n140|\t\tt.Fatalf(\"sticky ancestor refused: %v\", err)\n141|\t}\n142|}\n143|\n144|func TestCheckSocketCustodyRefusesFileAncestor(t *testing.T) {\n145|\tbase := t.TempDir()\n146|\tblocker := filepath.Join(base, \"axevil\")\n147|\tif err := os.WriteFile(blocker, []byte(\"x\"), 0o600); err != nil {\n148|\t\tt.Fatal(err)\n149|\t}\n150|\troot := filepath.Join(blocker, \"root\")\n151|\tsocket := filepath.Join(root, RuntimeDirName, SocketName)\n152|\t// The leaf custody refuses first (no directory under a file), so\n153|\t// this input pins the refusal without naming the ancestor arm.\n154|\tif err := CheckSocketCustody(socket, root, scalar.PlatformMacOS); err == nil {\n155|\t\tt.Fatal(\"file ancestor admitted\")\n156|\t}\n157|}\n158|\n159|func TestCheckSocketAncestorKindArm(t *testing.T) {\n160|\t// The ancestor kind arm refuses a regular file directly: a file\n161|\t// staged as an ancestor of a RESOLVED root. The root itself lives\n162|\t// under the temp dir; the file ancestor is resolved through.\n163|\tbase := t.TempDir()\n164|\tfileAncestor := filepath.Join(base, \"fileancestor\")\n165|\tif err := os.WriteFile(fileAncestor, []byte(\"x\"), 0o600); err != nil {\n166|\t\tt.Fatal(err)\n167|\t}\n168|\troot := filepath.Join(base, \"root\")\n169|\tif err := os.Mkdir(root, 0o755); err != nil {\n170|\t\tt.Fatal(err)\n171|\t}\n172|\t// Point the walk at a root whose ancestor chain contains the file\n173|\t// by nesting the root under a directory that IS the file: lexical\n174|\t// root = file/root. EvalSymlinks fails (no such dir), which the\n175|\t// ancestor arm refuses.\n176|\tnested := filepath.Join(fileAncestor, \"root\")\n177|\tif err := checkCustodyAncestors(nested); err == nil {\n178|\t\tt.Fatal(\"file ancestor admitted\")\n179|\t} else {\n180|\t\trequireLocalCode(t, err, \"tmux_unsafe_socket_path\", \"socket ancestor\")\n181|\t}\n182|\tif err := checkCustodyAncestors(root); err != nil {\n183|\t\tt.Fatalf(\"clean ancestors refused: %v\", err)\n184|\t}\n185|}\n186|\n187|func TestCheckSocketCustodyRefusesNonSocketFile(t *testing.T) {\n188|\troot, socket := lxCustodyRoot(t)\n189|\tif err := os.WriteFile(socket, []byte(\"not a socket\"), 0o600); err != nil {\n190|\t\tt.Fatal(err)\n191|\t}\n192|\tif err := CheckSocketCustody(socket, root, scalar.PlatformMacOS); err == nil {\n193|\t\tt.Fatal(\"regular file at socket path admitted\")\n194|\t} else {\n195|\t\trequireLocalCode(t, err, \"tmux_unsafe_socket_path\", \"socket kind\")\n196|\t}\n197|}\n198|\n199|func TestCheckSocketCustodyPropagatesLeafRefusal(t *testing.T) {\n200|\troot := t.TempDir()\n201|\tsocket := filepath.Join(root, RuntimeDirName, SocketName)\n202|\t// No leaf: the delegated leaf custody refuses with its own code,\n203|\t// which the bind step propagates instead of masking.\n204|\tif err := CheckSocketCustody(socket, root, scalar.PlatformMacOS); err == nil {\n205|\t\tt.Fatal(\"absent leaf admitted\")\n206|\t} else {\n207|\t\trequireLocalCode(t, err, \"tmux_unsafe_runtime_dir\", \"runtime absent\")\n208|\t}\n209|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
