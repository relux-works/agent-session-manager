{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cdfd","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":1369,"recorded_at":1780531400002733,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"task_stream":{"kind":"task","id":"01a0c6e8-8807-7db1-a658-a38132e8843c"},"task_id":"01a0c6e8-8807-7db1-a658-a38132e8843c","event":{"kind":"output","task_id":"01a0c6e8-8807-7db1-a658-a38132e8843c","chunk":"Read text file `internal/terminstance/execute.go`.\n(234 line(s) above)\n235|func (engine *Engine) ExecuteMutating(ctx context.Context, operation terminalbackend.Operation, context MutationContext, params Params, source terminalbackend.InstanceState, admitted terminalbackend.Admitted) (Result, error) {\n236|\tempty := Result{}\n237|\tif engine == nil || engine.Store == nil || engine.Backend == nil ||\n238|\t\tengine.CurrentLease == nil || engine.CurrentGeneration == nil || engine.Now == nil {\n239|\t\treturn empty, refuse(CodeProtocolError, \"engine unavailable\")\n240|\t}\n241|\tif _, err := terminalbackend.ParseOperation(string(operation)); err != nil {\n242|\t\treturn empty, wrapLanded(err)\n243|\t}\n244|\tif err := engineScope(operation); err != nil {\n245|\t\treturn empty, err\n246|\t}\n247|\tif _, err := terminalbackend.ParseInstanceState(string(source)); err != nil {\n248|\t\treturn empty, wrapLanded(err)\n249|\t}\n250|\tif err := CheckMutationContext(operation, context, params); err != nil {\n251|\t\treturn empty, err\n252|\t}\n253|\tif err := terminalbackend.CheckOperation(string(operation), admitted); err != nil {\n254|\t\tfailure := wrapLanded(err)\n255|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n256|\t}\n257|\tif err := checkCapabilityConditional(operation, params, admitted); err != nil {\n258|\t\tfailure := err.(*Error)\n259|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n260|\t}\n261|\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), params.Interactive)\n262|\tif err != nil {\n263|\t\tfailure := wrapLanded(err)\n264|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n265|\t}\n266|\tkind, _ := kindFor(operation)\n267|\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil {\n268|\t\tfailure := err.(*Error)\n269|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n270|\t}\n271|\tif engine.CurrentGeneration() != context.BackendGeneration {\n272|\t\tfailure := refuse(CodeStaleGeneration, \"backend_generation stale\")\n273|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n274|\t}\n275|\tdeadline, err := context.Deadline.Time()\n276|\tif err != nil {\n277|\t\treturn empty, refuse(CodeProtocolError, \"mutation context deadline\")\n278|\t}\n279|\tif !engine.Now().Before(deadline) {\n280|\t\tfailure := refuse(rowTimeoutCode(operation), \"operation deadline\")\n281|\t\treturn buildResult(context, source, source, nil, nil, DispositionReplaySame), failure\n282|\t}\n283|\tkey := context.IdempotencyKey\n284|\t_, replayed, err := engine.Store.Bind(key, operation, context.OperationID)\n285|\tif err != nil {\n286|\t\tfailure, ok := err.(*Error)\n287|\t\tif !ok {\n288|\t\t\t// Uncoded store failure: the Lookup below decides what is\n289|\t\t\t// durable. Nothing linked (a pre-link stage, write, sync or\n290|\t\t\t// link failure — no side effect ran and no receipt stands)\n291|\t\t\t// restores the source state, so the identical retry is\n292|\t\t\t// safe. A standing receipt (a post-link hook or\n293|\t\t\t// directory-sync failure) or an unreadable store is\n294|\t\t\t// genuinely uncertain.\n295|\t\t\tif _, found, lookupErr := engine.Store.Lookup(key); lookupErr == nil && !found {\n296|\t\t\t\tprelink := refuse(CodeProcessFailed, \"idempotency store failure\")\n297|\t\t\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(prelink.Code, false)), prelink\n298|\t\t\t}\n299|\t\t\tuncoded := refuse(CodeProcessFailed, \"idempotency store failure\")\n300|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), uncoded\n301|\t\t}\n302|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n303|\t}\n304|\tif replayed {\n305|\t\tstored, found, err := engine.Store.Completed(key)\n306|\t\tif err != nil {\n307|\t\t\tuncoded := refuse(CodeProcessFailed, \"idempotency store failure\")\n308|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), uncoded\n309|\t\t}\n310|\t\tif !found {\n311|\t\t\treturn engine.resumeUncertain(ctx, operation, context, source, admitted, target, effects, deadline, kind)\n312|\t\t}\n313|\t\tvar result Result\n314|\t\tif err := json.Unmarshal(stored, &result); err != nil {\n315|\t\t\tfailure := refuse(CodeIntegrityFailure, \"idempotency result image\")\n316|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), failure\n317|\t\t}\n318|\t\tif err := CheckResult(context, source, result); err != nil {\n319|\t\t\tfailure, ok := err.(*Error)\n320|\t\t\tif !ok {\n321|\t\t\t\tuncoded := refuse(CodeIntegrityFailure, \"idempotency result image\")\n322|\t\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), uncoded\n323|\t\t\t}\n324|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionFor(failure.Code, true)), failure\n325|\t\t}\n326|\t\treturn result, nil\n327|\t}\n328|\tif engine.Hooks != nil && engine.Hooks.AfterReceipt != nil {\n329|\t\tengine.Hooks.AfterReceipt(operation, key, InterimState(operation, source))\n330|\t}\n331|\treturn engine.runEffects(ctx, operation, context, source, target, effects, deadline, kind)\n332|}\n333|\n334|// resumeUncertain reconciles a bound key without its completion through\n335|// the production status entry, executing the §4.C recovery columns\n336|// (\"uncertainty requires status\" on create and quiesce-input,\n337|// \"uncertainty uses status\" on restore, \"lost result requires status,\n338|// then same-key retry only if not closed\" on request-stop, \"Create is\n339|// idempotent on (session_id, bootstrap_operation_id) across controller\n340|// crash and lost result\"). The reconciliation query is the exact\n341|// instance the request names — Session, instance, backend,\n342|// implementation, protocol and generation — validated by the same\n343|// ExecuteStatus arms every caller-driven status passes, so a lying or\n344|// drifting backend cannot authorize a resumption.\n345|//\n346|// When status proves the presented source state, nothing happened and\n347|// the same operation continues under the same receipt: the receipt is\n348|// already bound, so no second receipt is created, and the resumed run\n349|// completes it exactly once. For wait-safe-boundary the source is the\n350|// target, so a proven quiescing resumes and the resumed observation\n351|// supersedes any lost one; at most one completion exists per key either\n352|// way. Re-issue under the same key relies on the backend's own\n353|// key binding (§4.C: \"AX and backend durably bind the pair before the\n354|// first child side effect\"; §13.13 safe_retry): the engine never issues\n355|// the same logical operation under a second key, so no second process\n356|// is allocated.\n357|//\n358|// When status proves anything else — the target (the effects may have\n359|// committed but their evidence cannot be proven), a contradictory state,\n360|// or nothing at all (the read fails) — the retry refuses uncertain\n361|// with status_first. Re-issuing from a non-source observation would\n362|// violate the transition matrix, and inventing evidence would fabricate\n363|// a result; the caller reconciles through its own status read instead.\n364|func (engine *Engine) resumeUncertain(ctx context.Context, operation terminalbackend.Operation, context MutationContext, source terminalbackend.InstanceState, admitted terminalbackend.Admitted, target terminalbackend.InstanceState, effects []terminalbackend.SideEffect, deadline time.Time, kind AuthorizationKind) (Result, error) {\n(more lines below)","final_result":true}}}
