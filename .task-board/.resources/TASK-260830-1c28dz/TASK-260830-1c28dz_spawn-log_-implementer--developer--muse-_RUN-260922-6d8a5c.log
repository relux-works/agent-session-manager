  count=1,\\n        run=\\\"TestBuildCommandAttachRequiresInputFlag\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the unstated-but-writable attach past the authorization-stated arm; unstated read-only still refuses. Kill path: the unstated vector builds instead of refusing.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-boundary-blocking-vector\\\",\\n        path=f\\\"{PACKAGE}/exec.go\\\",\\n        find='\\\\\\\\t\\\\\\\\targv = []string{\\\"tmux\\\", \\\"-S\\\", args.Socket, \\\"wait-for\\\", channel}\\\\\\\\n',\\n        replace='\\\\\\\\t\\\\\\\\targv = []string{\\\"tmux\\\", \\\"-S\\\", args.Socket, \\\"wait-for\\\", \\\"-L\\\", channel}\\\\\\\\n',\\n        count=1,\\n        run=\\\"(TestBuildCommandVectors|TestExecuteBoundaryWaitsForSignal)\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the lock-acquisition vector past the blocking-wait builder (a fresh channel would succeed with no signal); every other vector element stays exact. Kill path: the wait argv carries -L, at the helper and through the boundary dispatch alike.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-boundary-proof-kind\\\",\\n        path=f\\\"{PACKAGE}/backend.go\\\",\\n        find='\\\\\\\\tfacts := []string{string(runner.proofKind), runner.channel, string(observed)}\\\\\\\\n',\\n        replace='\\\\\\\\tfacts := []string{runner.channel, string(observed)}\\\\\\\\n',\\n        count=1,\\n        run=\\\"TestExecuteBoundaryBindsProofKind\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly kind-indifferent boundary proofs past the proof-kind binding; channel and time stay bound. Kill path: two proof kinds evidence identically through the boundary dispatch.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-quiesce-detach-step\\\",\\n        path=f\\\"{PACKAGE}/backend.go\\\",\\n        find='\\\\\\\\tfor _, directive := range []Directive{DirectiveLockSession, DirectiveDetachClients} {\\\\\\\\n',\\n        replace='\\\\\\\\tfor _, directive := range []Directive{DirectiveLockSession} {\\\\\\\\n',\\n        count=1,\\n        run=\\\"(TestPerformEffectInputClosed|TestExecuteQuiesceBarrierSequence)\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the lock-only barrier past the detach step; the lock step stays. Kill path: quiesce detaches nothing, at the helper and through the quiesce dispatch alike.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-quiesce-sendkeys-absent\\\",\\n        path=f\\\"{PACKAGE}/backend.go\\\",\\n        find='\\\\\\\\tfor _, directive := range []Directive{DirectiveLockSession, DirectiveDetachClients} {\\\\\\\\n',\\n        replace='\\\\\\\\tfor _, directive := range []Directive{DirectiveLockSession, DirectiveSendInterrupt, DirectiveDetachClients} {\\\\\\\\n',\\n        count=1,\\n        run=\\\"TestExecuteQuiesceEmitsNoProviderInput\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly a provider-input step into the quiesce sequence; the lock/detach steps stay. Kill path: quiesce emits send-keys through the quiesce dispatch (the unscripted vector fails the run).\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-quiesce-attach-gate\\\",\\n        path=f\\\"{PACKAGE}/ops.go\\\",\\n        find='\\\\\\\\tif found && memory == terminalbackend.StateQuiescing {\\\\\\\\n',\\n        replace='\\\\\\\\tif found && memory == terminalbackend.StateQuiescing && instanceID != \\\"0198f4c8-8e50-7f66-8f70-222222222221\\\" {\\\\\\\\n',\\n        count=1,\\n        run=\\\"TestExecuteAttachRefusesInputWhenQuiescing\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly input-authorized attaches for the fixture instance past the quiescing barrier; every other quiescing instance still refuses. Kill path: the quiesced input attach succeeds through the attach dispatch.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-probe-negative-exit\\\",\\n        path=f\\\"{PACKAGE}/backend.go\\\",\\n        find='\\\\\\\\tif result.ExitCode < 0 {\\\\\\\\n\\\\\\\\t\\\\\\\\treturn false, false\\\\\\\\n\\\\\\\\t}\\\\\\\\n',\\n        replace='\\\\\\\\tif result.ExitCode < 0 {\\\\\\\\n\\\\\\\\t\\\\\\\\treturn false, true\\\\\\\\n\\\\\\\\t}\\\\\\\\n',\\n        count=1,\\n        run=\\\"TestExecuteStopUnknownProbeIsNotClosure\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly killed-probe absence past the negative-exit arm; unmarked positive exits keep their own row. Kill path: the signal-killed probe closes through the stop dispatch.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-probe-unmarked-exit\\\",\\n        path=f\\\"{PACKAGE}/backend.go\\\",\\n        find='\\\\\\\\t\\\\\\\\tif strings.Contains(stderr, marker) {\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\treturn false, true\\\\\\\\n\\\\\\\\t\\\\\\\\t}\\\\\\\\n\\\\\\\\t}\\\\\\\\n\\\\\\\\treturn false, false\\\\\\\\n}\\\\\\\\n',\\n        replace='\\\\\\\\t\\\\\\\\tif strings.Contains(stderr, marker) {\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\treturn false, true\\\\\\\\n\\\\\\\\t\\\\\\\\t}\\\\\\\\n\\\\\\\\t}\\\\\\\\n\\\\\\\\treturn false, true\\\\\\\\n}\\\\\\\\n',\\n        count=1,\\n        run=\\\"(TestExecuteStopUnmarkedExitIsNotClosure|TestExecuteStatusUnknownProbeIsUnavailable|TestExecuteTerminateUnknownConfirmIsNotTerminated)\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly unmarked-nonzero absence past the marker gate; marker-paired exits are unaffected. Kill path: the unproven probe verdicts absence through the stop, status, and terminate dispatches alike.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-osrunner-signal-death\\\",\\n        path=f\\\"{PACKAGE}/exec.go\\\",\\n        find='\\\\\\\\t\\\\\\\\t\\\\\\\\tif exitErr.ExitCode() < 0 {\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\t\\\\\\\\treturn RunResult{}, err\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\t}\\\\\\\\n',\\n        replace='\\\\\\\\t\\\\\\\\t\\\\\\\\tif exitErr.ExitCode() < -1 {\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\t\\\\\\\\treturn RunResult{}, err\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\t}\\\\\\\\n',\\n        count=1,\\n        run=\\\"TestOSRunnerSignalDeathProvesNothing\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the -1 signal death past the transport-failure arm as exit data; every other failure still errors. Kill path: the killed child reports data.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-custody-identity-bind\\\",\\n        path=f\\\"{PACKAGE}/bind.go\\\",\\n        find='\\\\\\\\tpathed, err := os.Lstat(root)\\\\\\\\n\\\\\\\\tif err != nil || !sameCustodyIdentity(info, pathed) {\\\\\\\\n',\\n        replace='\\\\\\\\tpathed, err := os.Lstat(root)\\\\\\\\n\\\\\\\\tif err != nil && !sameCustodyIdentity(info, pathed) {\\\\\\\\n',\\n        count=1,\\n        run=\\\"TestCheckSocketCustodyIdentityMismatchRefuses\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the identity-mismatched root past the handle-binding arm when the lstat succeeds; lstat failures with matching identity still refuse. Kill path: the swapped root verifies clean.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-custody-alias-skip\\\",\\n        path=f\\\"{PACKAGE}/bind.go\\\",\\n        find='\\\\\\\\t\\\\\\\\tdir, err := secprim.OpenNoFollowDir(parent)\\\\\\\\n\\\\\\\\t\\\\\\\\tif err != nil {\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \\\"socket ancestor\\\"}\\\\\\\\n\\\\\\\\t\\\\\\\\t}\\\\\\\\n',\\n        replace='\\\\\\\\t\\\\\\\\tdir, err := secprim.OpenNoFollowDir(parent)\\\\\\\\n\\\\\\\\t\\\\\\\\tif err != nil && !strings.HasSuffix(parent, \\\"alias\\\") {\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \\\"socket ancestor\\\"}\\\\\\\\n\\\\\\\\t\\\\\\\\t}\\\\\\\\n\\\\\\\\t\\\\\\\\tif err != nil {\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\tif isFilesystemRoot(parent) {\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\t\\\\\\\\treturn nil\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\t}\\\\\\\\n\\\\\\\\t\\\\\\\\t\\\\\\\\tcleaned = p