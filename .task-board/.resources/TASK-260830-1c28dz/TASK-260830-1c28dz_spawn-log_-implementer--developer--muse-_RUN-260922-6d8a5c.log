{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ce01","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":1371,"recorded_at":1780531400002737,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"task_stream":{"kind":"task","id":"01a0c6e8-888c-7f30-9476-022fb091b5e8"},"task_id":"01a0c6e8-888c-7f30-9476-022fb091b5e8","event":{"kind":"output","task_id":"01a0c6e8-888c-7f30-9476-022fb091b5e8","chunk":"Read text file `internal/tmuxserver/lifecycle_harness_test.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"fmt\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"strings\"\n11|\t\"sync\"\n12|\t\"testing\"\n13|\t\"time\"\n14|\n15|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n17|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n18|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n19|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n20|)\n21|\n22|// fakeRunner is a scripted Runner: responses are keyed by the tmux\n23|// subcommand (argv[3]), served FIFO per key, with every argv recorded.\n24|// An empty script for a key is a test failure (fail-closed scripts:\n25|// unexpected execs redden instead of returning zero values).\n26|type fakeRunner struct {\n27|\tmu        sync.Mutex\n28|\tscript    map[string][]fakeResponse\n29|\tcalls     [][]string\n30|\tonRun     func(argv []string)\n31|\ttransport map[string]error\n32|}\n33|\n34|type fakeResponse struct {\n35|\tstdout string\n36|\texit   int\n37|}\n38|\n39|func newFakeRunner() *fakeRunner {\n40|\treturn &fakeRunner{script: map[string][]fakeResponse{}, transport: map[string]error{}}\n41|}\n42|\n43|// queue appends one scripted response for a subcommand.\n44|func (runner *fakeRunner) queue(subcommand, stdout string, exit int) *fakeRunner {\n45|\trunner.mu.Lock()\n46|\tdefer runner.mu.Unlock()\n47|\trunner.script[subcommand] = append(runner.script[subcommand], fakeResponse{stdout: stdout, exit: exit})\n48|\treturn runner\n49|}\n50|\n51|// failTransport arms a transport error for a subcommand (served once,\n52|// FIFO ahead of queued responses when set).\n53|func (runner *fakeRunner) failTransport(subcommand string, err error) *fakeRunner {\n54|\trunner.mu.Lock()\n55|\tdefer runner.mu.Unlock()\n56|\trunner.transport[subcommand] = err\n57|\treturn runner\n58|}\n59|\n60|func (runner *fakeRunner) Run(_ context.Context, argv []string) (RunResult, error) {\n61|\trunner.mu.Lock()\n62|\tdefer runner.mu.Unlock()\n63|\trunner.calls = append(runner.calls, append([]string(nil), argv...))\n64|\tif runner.onRun != nil {\n65|\t\trunner.onRun(argv)\n66|\t}\n67|\tif len(argv) < 4 || argv[0] != \"tmux\" || argv[1] != \"-S\" {\n68|\t\treturn RunResult{}, fmt.Errorf(\"fake runner refuses unshaped argv %q\", argv)\n69|\t}\n70|\tkey := argv[3]\n71|\tif err, armed := runner.transport[key]; armed {\n72|\t\tdelete(runner.transport, key)\n73|\t\treturn RunResult{}, err\n74|\t}\n75|\tresponses := runner.script[key]\n76|\tif len(responses) == 0 {\n77|\t\treturn RunResult{}, fmt.Errorf(\"fake runner has no script for %q (call %d)\", key, len(runner.calls))\n78|\t}\n79|\tnext := responses[0]\n80|\trunner.script[key] = responses[1:]\n81|\treturn RunResult{Stdout: []byte(next.stdout), ExitCode: next.exit}, nil\n82|}\n83|\n84|func (runner *fakeRunner) callCount() int {\n85|\trunner.mu.Lock()\n86|\tdefer runner.mu.Unlock()\n87|\treturn len(runner.calls)\n88|}\n89|\n90|func (runner *fakeRunner) subcommands() []string {\n91|\trunner.mu.Lock()\n92|\tdefer runner.mu.Unlock()\n93|\tvar subcommands []string\n94|\tfor _, call := range runner.calls {\n95|\t\tif len(call) >= 4 {\n96|\t\t\tsubcommands = append(subcommands, call[3])\n97|\t\t}\n98|\t}\n99|\treturn subcommands\n100|}\n101|\n102|// manualClock is a fake Now/Sleep pair: Sleep advances the clock\n103|// instead of waiting, so poll loops run deterministically.\n104|type manualClock struct {\n105|\tmu  sync.Mutex\n106|\tnow time.Time\n107|}\n108|\n109|func newManualClock(now time.Time) *manualClock {\n110|\treturn &manualClock{now: now}\n111|}\n112|\n113|func (clock *manualClock) Now() time.Time {\n114|\tclock.mu.Lock()\n115|\tdefer clock.mu.Unlock()\n116|\treturn clock.now\n117|}\n118|\n119|func (clock *manualClock) Sleep(duration time.Duration) {\n120|\tclock.mu.Lock()\n121|\tdefer clock.mu.Unlock()\n122|\tclock.now = clock.now.Add(duration)\n123|}\n124|\n125|// lxFixture is one lifecycle test setup: runtime root with a verified\n126|// leaf, durable stores, scripted runner, manual clock, and a\n127|// whole Lifecycle. Unix-only: custody passes only where the unix\n128|// commit arms run.\n129|type lxFixture struct {\n130|\troot    string\n131|\truntime string\n132|\tsocket  string\n133|\tdata    string\n134|\trunner  *fakeRunner\n135|\tclock   *manualClock\n136|\tlc      *Lifecycle\n137|}\n138|\n139|// lxShortRoot stages a sun_path-fitting runtime root under /tmp: the\n140|// test-temp-dir socket path exceeds the darwin limit, so lifecycle\n141|// fixtures (which pass the length gate) never use t.TempDir directly.\n142|func lxShortRoot(t *testing.T) string {\n143|\tt.Helper()\n144|\tshort, err := os.MkdirTemp(\"/tmp\", \"axl\")\n145|\tif err != nil {\n146|\t\tt.Fatal(err)\n147|\t}\n148|\tt.Cleanup(func() { os.RemoveAll(short) })\n149|\troot := filepath.Join(short, \"r\")\n150|\tif err := os.Mkdir(root, 0o755); err != nil {\n151|\t\tt.Fatal(err)\n152|\t}\n153|\treturn root\n154|}\n155|\n156|func newLifecycleFixture(t *testing.T, admitted terminalbackend.Admitted) *lxFixture {\n157|\tt.Helper()\n158|\troot := lxShortRoot(t)\n159|\truntime, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n160|\tif err != nil {\n161|\t\tt.Fatal(err)\n162|\t}\n163|\tdata := t.TempDir()\n164|\treceipts, err := terminstance.OpenReceiptStore(filepath.Join(data, \"receipts\"))\n165|\tif err != nil {\n166|\t\tt.Fatal(err)\n167|\t}\n168|\tbindings, err := axpane.Open(filepath.Join(data, \"bindings\"))\n169|\tif err != nil {\n170|\t\tt.Fatal(err)\n171|\t}\n172|\tattach, err := termbind.OpenAttachStore(filepath.Join(data, \"attachstore\"))\n173|\tif err != nil {\n174|\t\tt.Fatal(err)\n175|\t}\n176|\tstates, err := OpenInstanceStates(filepath.Join(data, \"states\"))\n177|\tif err != nil {\n178|\t\tt.Fatal(err)\n179|\t}\n180|\trunner := newFakeRunner()\n181|\tclock := newManualClock(lxNow())\n182|\tlc := &Lifecycle{\n183|\t\tRuntimeDir: runtime,\n184|\t\tRoot:       root,\n185|\t\tPlatform:   scalar.PlatformMacOS,\n186|\t\tRunner:     runner,\n187|\t\tReceipts:   receipts,\n188|\t\tBindings:   bindings,\n189|\t\tAttach:     attach,\n190|\t\tStates:     states,\n191|\t\tCurrentLease: func() terminstance.LeaseView {\n192|\t\t\treturn terminstance.LeaseView{LeaseID: lxLease, Epoch: 7}\n193|\t\t},\n194|\t\tCurrentGeneration: func() string { return lxGeneration },\n195|\t\tNow:               clock.Now,\n196|\t\tSleep:             clock.Sleep,\n197|\t\tPollInterval:      time.Millisecond,\n198|\t\tServerAdmission: func() (RealmAdmission, error) {\n199|\t\t\treturn RealmAdmission{Admitted: admitted, RawGeneration: lxGeneration}, nil\n200|\t\t},\n201|\t}\n202|\treturn &lxFixture{root: root, runtime: runtime, socket: SocketPath(runtime), data: data, runner: runner, clock: clock, lc: lc}\n203|}\n204|\n205|// admittedWith returns an Admitted set holding exactly the capabilities.\n206|func admittedWith(capabilities ...string) terminalbackend.Admitted {\n207|\treturn terminalbackend.Admitted{Capabilities: capabilities}\n208|}\n209|\n210|// fullLifecycleAdmitted holds every capability the eight operations\n211|// confer or condition on.\n212|func fullLifecycleAdmitted() terminalbackend.Admitted {\n213|\treturn admittedWith(\n214|\t\t\"headless_creation\",\n215|\t\t\"credential_capable_execution_realm\",\n216|\t\t\"local_attach\",\n217|\t\t\"remote_attach\",\n218|\t\t\"multi_attach\",\n219|\t\t\"reboot_restoration\",\n220|\t\t\"input_quiescence\",\n221|\t\t\"safe_boundary_observation\",\n222|\t\t\"provider_process_observation\",\n223|\t\t\"graceful_stop\",\n224|\t\t\"stale_process_termination\",\n225|\t\t\"terminal_state_retention\",\n226|\t)\n227|}\n228|\n229|// errFakeTransport is the canned transport failure.\n230|var errFakeTransport = errors.New(\"fake runner transport failure\")\n231|\n232|// testAxpaneStore opens a bootstrap binding store under a temp dir.\n233|func testAxpaneStore(t *testing.T) (*axpane.Store, error) {\n234|\tt.Helper()\n235|\treturn axpane.Open(t.TempDir())\n236|}\n237|\n238|// testAttachStore opens an attach receipt store under a temp dir.\n239|func testAttachStore(t *testing.T) (*termbind.AttachStore, error) {\n240|\tt.Helper()\n241|\treturn termbind.OpenAttachStore(t.TempDir())\n242|}\n243|\n244|// isLandedError reports whether err carries a landed terminalbackend\n245|// refusal, decoding it into target.\n246|func isLandedError(err error, target **terminalbackend.Error) bool {\n247|\treturn errors.As(err, target)\n248|}\n249|\n250|// requireLocalCode asserts a *tmuxserver.Error with the literal code\n251|// and detail. The literals come from the pinned spec or the committed\n252|// package vocabulary, never from production constants.\n253|func requireLocalCode(t *testing.T, err error, code, detail string) {\n254|\tt.Helper()\n255|\tif err == nil {\n256|\t\tt.Fatalf(\"want error %s at %s, got nil\", code, detail)\n257|\t}\n258|\tvar local *Error\n259|\tif !errors.As(err, &local) {\n260|\t\tt.Fatalf(\"want *Error %s at %s, got %T (%v)\", code, detail, err, err)\n261|\t}\n262|\tif local.Code != code || local.Detail != detail {\n263|\t\tt.Fatalf(\"want %s at %s, got %s at %s\", code, detail, local.Code, local.Detail)\n264|\t}\n265|}\n266|\n267|// requireEngineCode asserts a *terminstance.Error with the literal code.\n268|func requireEngineCode(t *testing.T, err error, code string) {\n269|\tt.Helper()\n270|\tif err == nil {\n271|\t\tt.Fatalf(\"want engine error %s, got nil\", code)\n272|\t}\n273|\tvar failure *terminstance.Error\n274|\tif !errors.As(err, &failure) {\n275|\t\tt.Fatalf(\"want *terminstance.Error %s, got %T (%v)\", code, err, err)\n276|\t}\n277|\tif failure.Code != code {\n278|\t\tt.Fatalf(\"want engine code %s, got %s (%v)\", code, failure.Code, err)\n279|\t}\n280|}\n281|\n282|// requireLandedCode asserts a *terminalbackend.Error with the literal code.\n283|func requireLandedCode(t *testing.T, err error, code string) {\n284|\tt.Helper()\n285|\tif err == nil {\n286|\t\tt.Fatalf(\"want landed error %s, got nil\", code)\n287|\t}\n288|\tvar failure *terminalbackend.Error\n289|\tif !errors.As(err, &failure) {\n290|\t\tt.Fatalf(\"want *terminalbackend.Error %s, got %T (%v)\", code, err, err)\n291|\t}\n292|\tif failure.Code != code {\n293|\t\tt.Fatalf(\"want landed code %s, got %s (%v)\", code, failure.Code, err)\n294|\t}\n295|}\n296|\n297|func argvStrings(argv []string) string { return strings.Join(argv, \" \") }\n298|\n299|// recordBinding records the bootstrap binding receipt for the\n300|// lifecycle (session, bootstrap) pair with the given digest.\n301|func recordBinding(t *testing.T, fx *lxFixture, digest string) {\n302|\tt.Helper()\n303|\t_, _, err := fx.lc.Bindings.Bind(lxSession, lxBootstrap, axpane.Binding{\n304|\t\tSessionID:          lxSession,\n305|\t\tOperationID:        lxBootstrap,\n306|\t\tTerminalInstanceID: lxInstance,\n307|\t\tBindingDigest:      digest,\n308|\t})\n309|\tif err != nil {\n310|\t\tt.Fatal(err)\n311|\t}\n312|}\n313|\n314|// foreignBackendBody rewrites every terminal_backend_id in a body to\n315|// ax.conpty: the flat member and the nested context member alike.\n316|func foreignBackendBody(t *testing.T, raw []byte) []byte {\n317|\tt.Helper()\n318|\tvar object map[string]json.RawMessage\n319|\tif err := json.Unmarshal(raw, &object); err != nil {\n320|\t\tt.Fatal(err)\n321|\t}\n322|\tswap := func(container map[string]json.RawMessage) {\n323|\t\tif _, known := container[\"terminal_backend_id\"]; known {\n324|\t\t\tcontainer[\"terminal_backend_id\"] = json.RawMessage(`\"ax.conpty\"`)\n325|\t\t}\n326|\t}\n327|\tswap(object)\n328|\tif context, known := object[\"context\"]; known {\n329|\t\tvar nested map[string]json.RawMessage\n330|\t\tif err := json.Unmarshal(context, &nested); err != nil {\n331|\t\t\tt.Fatal(err)\n332|\t\t}\n333|\t\tswap(nested)\n334|\t\trewritten, err := json.Marshal(nested)\n335|\t\tif err != nil {\n336|\t\t\tt.Fatal(err)\n337|\t\t}\n338|\t\tobject[\"context\"] = rewritten\n339|\t}\n340|\trewritten, err := json.Marshal(object)\n341|\tif err != nil {\n342|\t\tt.Fatal(err)\n343|\t}\n344|\treturn rewritten\n345|}\n346|\n347|// assertTimestamp pins a rendered timestamp against the scalar grammar.\n348|func assertTimestamp(t *testing.T, rendered string) {\n349|\tt.Helper()\n350|\tif _, err := scalar.ParseTimestamp(rendered); err != nil {\n351|\t\tt.Fatalf(\"timestamp %q: %v\", rendered, err)\n352|\t}\n353|}","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ce03","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":1372,"recorded_at":1780531400002739,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"task_stream":{"kind":"task","id":"01a0c6e8-888c-7f30-9476-022fb091b5e8"},"task_id":"01a0c6e8-888c-7f30-9476-022fb091b5e8","event":{"kind":"completed","task_id":"01a0c6e8-888c-7f30-9476-022fb091b5e8"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ce05","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":1373,"recorded_at":1780531400002741,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"call_id":"call_01a0c6e88096725f9e185198c52b4bd6","text":"Read text file `internal/terminstance/execute.go`.\n(234 line(s) above)\n235|func (engine *Engine) ExecuteMutating(ctx context.Context, operation terminalbackend.Operation, context MutationContext, params Params, source terminalbackend.InstanceState, admitted terminalbackend.Admitted) (Result, error) {\n236|\tempty := Result{}\n237|\tif engine == nil || engine.Store == nil || engine.Backend == nil ||\n238|\t\tengine.CurrentLease == nil || engine.CurrentGeneration == nil || engine.Now == nil {\n239|\t\treturn empty, refuse(CodeProtocolError, \"engine unavailable\")\n240|\t}\n241|\tif _, err := terminalbackend.ParseOperation(string(operation)); err != nil {\n242|\t\treturn empty, wrapLanded(err)\n243|\t}\n244|\tif err := engineScope(operation); err != nil {\n245|\t\treturn empty, err\n246|\t}\n247|\tif _, err := terminalbackend.ParseInstanceState(string(source)); err != nil {\n248|\t\treturn empty, wrapLanded(err)\n249|\t}\n250|\tif err := CheckMutationContext(operation, context, params); err != nil {\n251|\t\treturn empty, err\n252|\t}\n253|\tif err := terminalbackend.CheckOperation(string(operation), admitted); err != nil {\n254|\t\tfailure := wrapLanded(err)\n255|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n256|\t}\n257|\tif err := checkCapabilityConditional(operation, params, admitted); err != nil {\n258|\t\tfailure := err.(*Error)\n259|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n260|\t}\n261|\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), params.Interactive)\n262|\tif err != nil {\n263|\t\tfailure := wrapLanded(err)\n264|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n265|\t}\n266|\tkind, _ := kindFor(operation)\n267|\tif err := CheckAuthorization(context.Authorization, kind, engine.CurrentLease(), engine.Now()); err != nil {\n268|\t\tfailure := err.(*Error)\n269|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n270|\t}\n271|\tif engine.CurrentGeneration() != context.BackendGeneration {\n272|\t\tfailure := refuse(CodeStaleGeneration, \"backend_generation stale\")\n273|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n274|\t}\n275|\tdeadline, err := context.Deadline.Time()\n276|\tif err != nil {\n277|\t\treturn empty, refuse(CodeProtocolError, \"mutation context deadline\")\n278|\t}\n279|\tif !engine.Now().Before(deadline) {\n280|\t\tfailure := refuse(rowTimeoutCode(operation), \"operation deadline\")\n281|\t\treturn buildResult(context, source, source, nil, nil, DispositionReplaySame), failure\n282|\t}\n283|\tkey := context.IdempotencyKey\n284|\t_, replayed, err := engine.Store.Bind(key, operation, context.OperationID)\n285|\tif err != nil {\n286|\t\tfailure, ok := err.(*Error)\n287|\t\tif !ok {\n288|\t\t\t// Uncoded store failure: the Lookup below decides what is\n289|\t\t\t// durable. Nothing linked (a pre-link stage, write, sync or\n290|\t\t\t// link failure — no side effect ran and no receipt stands)\n291|\t\t\t// restores the source state, so the identical retry is\n292|\t\t\t// safe. A standing receipt (a post-link hook or\n293|\t\t\t// directory-sync failure) or an unreadable store is\n294|\t\t\t// genuinely uncertain.\n295|\t\t\tif _, found, lookupErr := engine.Store.Lookup(key); lookupErr == nil && !found {\n296|\t\t\t\tprelink := refuse(CodeProcessFailed, \"idempotency store failure\")\n297|\t\t\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(prelink.Code, false)), prelink\n298|\t\t\t}\n299|\t\t\tuncoded := refuse(CodeProcessFailed, \"idempotency store failure\")\n300|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), uncoded\n301|\t\t}\n302|\t\treturn buildResult(context, source, source, nil, nil, DispositionFor(failure.Code, false)), failure\n303|\t}\n304|\tif replayed {\n305|\t\tstored, found, err := engine.Store.Completed(key)\n306|\t\tif err != nil {\n307|\t\t\tuncoded := refuse(CodeProcessFailed, \"idempotency store failure\")\n308|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), uncoded\n309|\t\t}\n310|\t\tif !found {\n311|\t\t\treturn engine.resumeUncertain(ctx, operation, context, source, admitted, target, effects, deadline, kind)\n312|\t\t}\n313|\t\tvar result Result\n314|\t\tif err := json.Unmarshal(stored, &result); err != nil {\n315|\t\t\tfailure := refuse(CodeIntegrityFailure, \"idempotency result image\")\n316|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), failure\n317|\t\t}\n318|\t\tif err := CheckResult(context, source, result); err != nil {\n319|\t\t\tfailure, ok := err.(*Error)\n320|\t\t\tif !ok {\n321|\t\t\t\tuncoded := refuse(CodeIntegrityFailure, \"idempotency result image\")\n322|\t\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionStatusFirst), uncoded\n323|\t\t\t}\n324|\t\t\treturn buildResult(context, source, terminalbackend.StateUnavailable, nil, nil, DispositionFor(failure.Code, true)), failure\n325|\t\t}\n326|\t\treturn result, nil\n327|\t}\n328|\tif engine.Hooks != nil && engine.Hooks.AfterReceipt != nil {\n329|\t\tengine.Hooks.AfterReceipt(operation, key, InterimState(operation, source))\n330|\t}\n331|\treturn engine.runEffects(ctx, operation, context, source, target, effects, deadline, kind)\n332|}\n333|\n334|// resumeUncertain reconciles a bound key without its completion through\n335|// the production status entry, executing the §4.C recovery columns\n336|// (\"uncertainty requires status\" on create and quiesce-input,\n337|// \"uncertainty uses status\" on restore, \"lost result requires status,\n338|// then same-key retry only if not closed\" on request-stop, \"Create is\n339|// idempotent on (session_id, bootstrap_operation_id) across controller\n340|// crash and lost result\"). The reconciliation query is the exact\n341|// instance the request names — Session, instance, backend,\n342|// implementation, protocol and generation — validated by the same\n343|// ExecuteStatus arms every caller-driven status passes, so a lying or\n344|// drifting backend cannot authorize a resumption.\n345|//\n346|// When status proves the presented source state, nothing happened and\n347|// the same operation continues under the same receipt: the receipt is\n348|// already bound, so no second receipt is created, and the resumed run\n349|// completes it exactly once. For wait-safe-boundary the source is the\n350|// target, so a proven quiescing resumes and the resumed observation\n351|// supersedes any lost one; at most one completion exists per key either\n352|// way. Re-issue under the same key relies on the backend's own\n353|// key binding (§4.C: \"AX and backend durably bind the pair before the\n354|// first child side effect\"; §13.13 safe_retry): the engine never issues\n355|// the same logical operation under a second key, so no second process\n356|// is allocated.\n357|//\n358|// When status proves anything else — the target (the effects may have\n359|// committed but their evidence cannot be proven), a contradictory state,\n360|// or nothing at all (the read fails) — the retry refuses uncertain\n361|// with status_first. Re-issuing from a non-source observation would\n362|// violate the transition matrix, and inventing evidence would fabricate\n363|// a result; the caller reconciles through its own status read instead.\n364|func (engine *Engine) resumeUncertain(ctx context.Context, operation terminalbackend.Operation, context MutationContext, source terminalbackend.InstanceState, admitted terminalbackend.Admitted, target terminalbackend.InstanceState, effects []terminalbackend.SideEffect, deadline time.Time, kind AuthorizationKind) (Result, error) {\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ce07","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":1374,"recorded_at":1780531400002743,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"call_id":"call_01a0c6e883e17229812120f52c0da003","text":"Read text file `internal/tmuxserver/lifecycle_harness_test.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"fmt\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"strings\"\n11|\t\"sync\"\n12|\t\"testing\"\n13|\t\"time\"\n14|\n15|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n17|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n18|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n19|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n20|)\n21|\n22|// fakeRunner is a scripted Runner: responses are keyed by the tmux\n23|// subcommand (argv[3]), served FIFO per key, with every argv recorded.\n24|// An empty script for a key is a test failure (fail-closed scripts:\n25|// unexpected execs redden instead of returning zero values).\n26|type fakeRunner struct {\n27|\tmu        sync.Mutex\n28|\tscript    map[string][]fakeResponse\n29|\tcalls     [][]string\n30|\tonRun     func(argv []string)\n31|\ttransport map[string]error\n32|}\n33|\n34|type fakeResponse struct {\n35|\tstdout string\n36|\texit   int\n37|}\n38|\n39|func newFakeRunner() *fakeRunner {\n40|\treturn &fakeRunner{script: map[string][]fakeResponse{}, transport: map[string]error{}}\n41|}\n42|\n43|// queue appends one scripted response for a subcommand.\n44|func (runner *fakeRunner) queue(subcommand, stdout string, exit int) *fakeRunner {\n45|\trunner.mu.Lock()\n46|\tdefer runner.mu.Unlock()\n47|\trunner.script[subcommand] = append(runner.script[subcommand], fakeResponse{stdout: stdout, exit: exit})\n48|\treturn runner\n49|}\n50|\n51|// failTransport arms a transport error for a subcommand (served once,\n52|// FIFO ahead of queued responses when set).\n53|func (runner *fakeRunner) failTransport(subcommand string, err error) *fakeRunner {\n54|\trunner.mu.Lock()\n55|\tdefer runner.mu.Unlock()\n56|\trunner.transport[subcommand] = err\n57|\treturn runner\n58|}\n59|\n60|func (runner *fakeRunner) Run(_ context.Context, argv []string) (RunResult, error) {\n61|\trunner.mu.Lock()\n62|\tdefer runner.mu.Unlock()\n63|\trunner.calls = append(runner.calls, append([]string(nil), argv...))\n64|\tif runner.onRun != nil {\n65|\t\trunner.onRun(argv)\n66|\t}\n67|\tif len(argv) < 4 || argv[0] != \"tmux\" || argv[1] != \"-S\" {\n68|\t\treturn RunResult{}, fmt.Errorf(\"fake runner refuses unshaped argv %q\", argv)\n69|\t}\n70|\tkey := argv[3]\n71|\tif err, armed := runner.transport[key]; armed {\n72|\t\tdelete(runner.transport, key)\n73|\t\treturn RunResult{}, err\n74|\t}\n75|\tresponses := runner.script[key]\n76|\tif len(responses) == 0 {\n77|\t\treturn RunResult{}, fmt.Errorf(\"fake runner has no script for %q (call %d)\", key, len(runner.calls))\n78|\t}\n79|\tnext := responses[0]\n80|\trunner.script[key] = responses[1:]\n81|\treturn RunResult{Stdout: []byte(next.stdout), ExitCode: next.exit}, nil\n82|}\n83|\n84|func (runner *fakeRunner) callCount() int {\n85|\trunner.mu.Lock()\n86|\tdefer runner.mu.Unlock()\n87|\treturn len(runner.calls)\n88|}\n89|\n90|func (runner *fakeRunner) subcommands() []string {\n91|\trunner.mu.Lock()\n92|\tdefer runner.mu.Unlock()\n93|\tvar subcommands []string\n94|\tfor _, call := range runner.calls {\n95|\t\tif len(call) >= 4 {\n96|\t\t\tsubcommands = append(subcommands, call[3])\n97|\t\t}\n98|\t}\n99|\treturn subcommands\n100|}\n101|\n102|// manualClock is a fake Now/Sleep pair: Sleep advances the clock\n103|// instead of waiting, so poll loops run deterministically.\n104|type manualClock struct {\n105|\tmu  sync.Mutex\n106|\tnow time.Time\n107|}\n108|\n109|func newManualClock(now time.Time) *manualClock {\n110|\treturn &manualClock{now: now}\n111|}\n112|\n113|func (clock *manualClock) Now() time.Time {\n114|\tclock.mu.Lock()\n115|\tdefer clock.mu.Unlock()\n116|\treturn clock.now\n117|}\n118|\n119|func (clock *manualClock) Sleep(duration time.Duration) {\n120|\tclock.mu.Lock()\n121|\tdefer clock.mu.Unlock()\n122|\tclock.now = clock.now.Add(duration)\n123|}\n124|\n125|// lxFixture is one lifecycle test setup: runtime root with a verified\n126|// leaf, durable stores, scripted runner, manual clock, and a\n127|// whole Lifecycle. Unix-only: custody passes only where the unix\n128|// commit arms run.\n129|type lxFixture struct {\n130|\troot    string\n131|\truntime string\n132|\tsocket  string\n133|\tdata    string\n134|\trunner  *fakeRunner\n135|\tclock   *manualClock\n136|\tlc      *Lifecycle\n137|}\n138|\n139|// lxShortRoot stages a sun_path-fitting runtime root under /tmp: the\n140|// test-temp-dir socket path exceeds the darwin limit, so lifecycle\n141|// fixtures (which pass the length gate) never use t.TempDir directly.\n142|func lxShortRoot(t *testing.T) string {\n143|\tt.Helper()\n144|\tshort, err := os.MkdirTemp(\"/tmp\", \"axl\")\n145|\tif err != nil {\n146|\t\tt.Fatal(err)\n147|\t}\n148|\tt.Cleanup(func() { os.RemoveAll(short) })\n149|\troot := filepath.Join(short, \"r\")\n150|\tif err := os.Mkdir(root, 0o755); err != nil {\n151|\t\tt.Fatal(err)\n152|\t}\n153|\treturn root\n154|}\n155|\n156|func newLifecycleFixture(t *testing.T, admitted terminalbackend.Admitted) *lxFixture {\n157|\tt.Helper()\n158|\troot := lxShortRoot(t)\n159|\truntime, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n160|\tif err != nil {\n161|\t\tt.Fatal(err)\n162|\t}\n163|\tdata := t.TempDir()\n164|\treceipts, err := terminstance.OpenReceiptStore(filepath.Join(data, \"receipts\"))\n165|\tif err != nil {\n166|\t\tt.Fatal(err)\n167|\t}\n168|\tbindings, err := axpane.Open(filepath.Join(data, \"bindings\"))\n169|\tif err != nil {\n170|\t\tt.Fatal(err)\n171|\t}\n172|\tattach, err := termbind.OpenAttachStore(filepath.Join(data, \"attachstore\"))\n173|\tif err != nil {\n174|\t\tt.Fatal(err)\n175|\t}\n176|\tstates, err := OpenInstanceStates(filepath.Join(data, \"states\"))\n177|\tif err != nil {\n178|\t\tt.Fatal(err)\n179|\t}\n180|\trunner := newFakeRunner()\n181|\tclock := newManualClock(lxNow())\n182|\tlc := &Lifecycle{\n183|\t\tRuntimeDir: runtime,\n184|\t\tRoot:       root,\n185|\t\tPlatform:   scalar.PlatformMacOS,\n186|\t\tRunner:     runner,\n187|\t\tReceipts:   receipts,\n188|\t\tBindings:   bindings,\n189|\t\tAttach:     attach,\n190|\t\tStates:     states,\n191|\t\tCurrentLease: func() terminstance.LeaseView {\n192|\t\t\treturn terminstance.LeaseView{LeaseID: lxLease, Epoch: 7}\n193|\t\t},\n194|\t\tCurrentGeneration: func() string { return lxGeneration },\n195|\t\tNow:               clock.Now,\n196|\t\tSleep:             clock.Sleep,\n197|\t\tPollInterval:      time.Millisecond,\n198|\t\tServerAdmission: func() (RealmAdmission, error) {\n199|\t\t\treturn RealmAdmission{Admitted: admitted, RawGeneration: lxGeneration}, nil\n200|\t\t},\n201|\t}\n202|\treturn &lxFixture{root: root, runtime: runtime, socket: SocketPath(runtime), data: data, runner: runner, clock: clock, lc: lc}\n203|}\n204|\n205|// admittedWith returns an Admitted set holding exactly the capabilities.\n206|func admittedWith(capabilities ...string) terminalbackend.Admitted {\n207|\treturn terminalbackend.Admitted{Capabilities: capabilities}\n208|}\n209|\n210|// fullLifecycleAdmitted holds every capability the eight operations\n211|// confer or condition on.\n212|func fullLifecycleAdmitted() terminalbackend.Admitted {\n213|\treturn admittedWith(\n214|\t\t\"headless_creation\",\n215|\t\t\"credential_capable_execution_realm\",\n216|\t\t\"local_attach\",\n217|\t\t\"remote_attach\",\n218|\t\t\"multi_attach\",\n219|\t\t\"reboot_restoration\",\n220|\t\t\"input_quiescence\",\n221|\t\t\"safe_boundary_observation\",\n222|\t\t\"provider_process_observation\",\n223|\t\t\"graceful_stop\",\n224|\t\t\"stale_process_termination\",\n225|\t\t\"terminal_state_retention\",\n226|\t)\n227|}\n228|\n229|// errFakeTransport is the canned transport failure.\n230|var errFakeTransport = errors.New(\"fake runner transport failure\")\n231|\n232|// testAxpaneStore opens a bootstrap binding store under a temp dir.\n233|func testAxpaneStore(t *testing.T) (*axpane.Store, error) {\n234|\tt.Helper()\n235|\treturn axpane.Open(t.TempDir())\n236|}\n237|\n238|// testAttachStore opens an attach receipt store under a temp dir.\n239|func testAttachStore(t *testing.T) (*termbind.AttachStore, error) {\n240|\tt.Helper()\n241|\treturn termbind.OpenAttachStore(t.TempDir())\n242|}\n243|\n244|// isLandedError reports whether err carries a landed terminalbackend\n245|// refusal, decoding it into target.\n246|func isLandedError(err error, target **terminalbackend.Error) bool {\n247|\treturn errors.As(err, target)\n248|}\n249|\n250|// requireLocalCode asserts a *tmuxserver.Error with the literal code\n251|// and detail. The literals come from the pinned spec or the committed\n252|// package vocabulary, never from production constants.\n253|func requireLocalCode(t *testing.T, err error, code, detail string) {\n254|\tt.Helper()\n255|\tif err == nil {\n256|\t\tt.Fatalf(\"want error %s at %s, got nil\", code, detail)\n257|\t}\n258|\tvar local *Error\n259|\tif !errors.As(err, &local) {\n260|\t\tt.Fatalf(\"want *Error %s at %s, got %T (%v)\", code, detail, err, err)\n261|\t}\n262|\tif local.Code != code || local.Detail != detail {\n263|\t\tt.Fatalf(\"want %s at %s, got %s at %s\", code, detail, local.Code, local.Detail)\n264|\t}\n265|}\n266|\n267|// requireEngineCode asserts a *terminstance.Error with the literal code.\n268|func requireEngineCode(t *testing.T, err error, code string) {\n269|\tt.Helper()\n270|\tif err == nil {\n271|\t\tt.Fatalf(\"want engine error %s, got nil\", code)\n272|\t}\n273|\tvar failure *terminstance.Error\n274|\tif !errors.As(err, &failure) {\n275|\t\tt.Fatalf(\"want *terminstance.Error %s, got %T (%v)\", code, err, err)\n276|\t}\n277|\tif failure.Code != code {\n278|\t\tt.Fatalf(\"want engine code %s, got %s (%v)\", code, failure.Code, err)\n279|\t}\n280|}\n281|\n282|// requireLandedCode asserts a *terminalbackend.Error with the literal code.\n283|func requireLandedCode(t *testing.T, err error, code string) {\n284|\tt.Helper()\n285|\tif err == nil {\n286|\t\tt.Fatalf(\"want landed error %s, got nil\", code)\n287|\t}\n288|\tvar failure *terminalbackend.Error\n289|\tif !errors.As(err, &failure) {\n290|\t\tt.Fatalf(\"want *terminalbackend.Error %s, got %T (%v)\", code, err, err)\n291|\t}\n292|\tif failure.Code != code {\n293|\t\tt.Fatalf(\"want landed code %s, got %s (%v)\", code, failure.Code, err)\n294|\t}\n295|}\n296|\n297|func argvStrings(argv []string) string { return strings.Join(argv, \" \") }\n298|\n299|// recordBinding records the bootstrap binding receipt for the\n300|// lifecycle (session, bootstrap) pair with the given digest.\n301|func recordBinding(t *testing.T, fx *lxFixture, digest string) {\n302|\tt.Helper()\n303|\t_, _, err := fx.lc.Bindings.Bind(lxSession, lxBootstrap, axpane.Binding{\n304|\t\tSessionID:          lxSession,\n305|\t\tOperationID:        lxBootstrap,\n306|\t\tTerminalInstanceID: lxInstance,\n307|\t\tBindingDigest:      digest,\n308|\t})\n309|\tif err != nil {\n310|\t\tt.Fatal(err)\n311|\t}\n312|}\n313|\n314|// foreignBackendBody rewrites every terminal_backend_id in a body to\n315|// ax.conpty: the flat member and the nested context member alike.\n316|func foreignBackendBody(t *testing.T, raw []byte) []byte {\n317|\tt.Helper()\n318|\tvar object map[string]json.RawMessage\n319|\tif err := json.Unmarshal(raw, &object); err != nil {\n320|\t\tt.Fatal(err)\n321|\t}\n322|\tswap := func(container map[string]json.RawMessage) {\n323|\t\tif _, known := container[\"terminal_backend_id\"]; known {\n324|\t\t\tcontainer[\"terminal_backend_id\"] = json.RawMessage(`\"ax.conpty\"`)\n325|\t\t}\n326|\t}\n327|\tswap(object)\n328|\tif context, known := object[\"context\"]; known {\n329|\t\tvar nested map[string]json.RawMessage\n330|\t\tif err := json.Unmarshal(context, &nested); err != nil {\n331|\t\t\tt.Fatal(err)\n332|\t\t}\n333|\t\tswap(nested)\n334|\t\trewritten, err := json.Marshal(nested)\n335|\t\tif err != nil {\n336|\t\t\tt.Fatal(err)\n337|\t\t}\n338|\t\tobject[\"context\"] = rewritten\n339|\t}\n340|\trewritten, err := json.Marshal(object)\n341|\tif err != nil {\n342|\t\tt.Fatal(err)\n343|\t}\n344|\treturn rewritten\n345|}\n346|\n347|// assertTimestamp pins a rendered timestamp against the scalar grammar.\n348|func assertTimestamp(t *testing.T, rendered string) {\n349|\tt.Helper()\n350|\tif _, err := scalar.ParseTimestamp(rendered); err != nil {\n351|\t\tt.Fatalf(\"timestamp %q: %v\", rendered, err)\n352|\t}\n353|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
