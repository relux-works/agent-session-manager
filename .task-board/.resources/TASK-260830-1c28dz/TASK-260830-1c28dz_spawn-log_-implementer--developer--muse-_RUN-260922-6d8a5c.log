{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c90b","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":736,"recorded_at":1780531400001467,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"task_stream":{"kind":"task","id":"01a0c6db-417a-7c81-8982-62b62da12954"},"task_id":"01a0c6db-417a-7c81-8982-62b62da12954","event":{"kind":"output","task_id":"01a0c6db-417a-7c81-8982-62b62da12954","chunk":"Read text file `/tmp/c28dz/rev/reviewer_unix_test.go.txt`.\n1|//go:build !windows\n2|package tmuxserver\n3|import(\"context\";\"testing\";\"os\";\"path/filepath\";\"github.com/relux-works/agent-session-manager/internal/scalar\")\n4|func TestReviewStopUnknownExit(t *testing.T) {\n5| fx:=newLifecycleFixture(t,fullLifecycleAdmitted()); fx.runner.queue(\"send-keys\",\"\",0).queue(\"has-session\",\"\",-1)\n6| out,err:=fx.lc.Execute(context.Background(),OpRequest{Operation:\"request-stop\",Body:lxStopBody(t,60000,nil),Source:\"quiescing\",Admitted:fullLifecycleAdmitted()})\n7| if err==nil {t.Fatalf(\"signal-killed probe accepted as closure: ProcessClosed=%v StoreClosed=%v\",out.ProcessClosed,out.StoreClosed)}\n8|}\n9|func TestReviewCustodyIntermediateSymlink(t *testing.T) {\n10| fx:=newLifecycleFixture(t,fullLifecycleAdmitted()); alias:=filepath.Join(filepath.Dir(fx.root),\"alias\"); if err:=os.Symlink(filepath.Dir(fx.root),alias);err!=nil{t.Fatal(err)}\n11| root:=filepath.Join(alias,filepath.Base(fx.root)); if err:=CheckSocketCustody(filepath.Join(root,\"tmux\",\"ax.sock\"),root,scalar.PlatformMacOS);err==nil{t.Fatal(\"intermediate symlink admitted at before-connect custody\")}\n12|}\n13|func TestReviewBoundaryNeedsSignal(t *testing.T) {\n14| fx:=newLifecycleFixture(t,fullLifecycleAdmitted()); fx.runner.queue(\"wait-for\",\"\",0)\n15| fx.runner.onRun=func(argv []string){if argv[3]==\"wait-for\" && len(argv)>4 && argv[4]==\"-L\" {t.Error(\"fresh channel lock succeeds without any wrapper boundary signal\")}}\n16| _,_ =fx.lc.Execute(context.Background(),OpRequest{Operation:\"wait-safe-boundary\",Body:lxBoundaryBody(t,\"ax_checkpoint_boundary\",60000,nil),Source:\"quiescing\",Admitted:fullLifecycleAdmitted()})\n17|}\n18|func TestReviewQuiesceReplayTimestamp(t *testing.T) {\n19| fx:=newLifecycleFixture(t,fullLifecycleAdmitted());fx.runner.queue(\"lock-session\",\"\",0)\n20| req:=OpRequest{Operation:\"quiesce-input\",Body:lxQuiesceBody(t,nil),Source:\"active\",Admitted:fullLifecycleAdmitted()}\n21| a,err:=fx.lc.Execute(context.Background(),req);if err!=nil{t.Fatal(err)};fx.clock.Sleep(1000000000)\n22| b,err:=fx.lc.Execute(context.Background(),req);if err!=nil{t.Fatal(err)};if a.InputClosedAt!=b.InputClosedAt{t.Fatalf(\"same receipt changed closure time: %s -> %s\",a.InputClosedAt,b.InputClosedAt)}\n23|}\n24|func TestReviewReadOnlyAttach(t *testing.T) {\n25| fx:=newLifecycleFixture(t,fullLifecycleAdmitted());out,err:=fx.lc.Execute(context.Background(),OpRequest{Operation:\"attach\",Body:lxAttachBody(t,func(m map[string]any){m[\"input_authorized\"]=false;m[\"authorization\"]=lxAttachAuth(\"local_only\",false)}),Source:\"parked\",Admitted:fullLifecycleAdmitted()});if err!=nil{t.Fatal(err)}\n26| for _,arg:=range out.Argv {if arg==\"-r\" {return}}\n27| t.Fatalf(\"input_authorized=false returns writable attach vector: %q\",out.Argv)\n28|}\n29|func TestReviewCustodyEntryRoots(t *testing.T) {\n30| for _,entry:=range []string{\"status\",\"restore\"}{for _,which:=range []string{\"root\",\"ancestor\"}{t.Run(entry+\"/\"+which,func(t *testing.T){\n31| fx:=newLifecycleFixture(t,fullLifecycleAdmitted());path:=fx.root;if which==\"ancestor\"{path=filepath.Dir(fx.root)};if err:=os.Chmod(path,0777);err!=nil{t.Fatal(err)}\n32| req:=OpRequest{Operation:entry,Body:lxStatusBody(t,true,false,nil),Source:\"parked\",Admitted:fullLifecycleAdmitted()};if entry==\"restore\"{req.Body=lxRestoreBody(t,lxDigestA,nil)}\n33| _,err:=fx.lc.Execute(context.Background(),req);want:=\"tmux server refused: tmux_unsafe_socket_path at socket \"+which;if err==nil||err.Error()!=want{t.Fatalf(\"want %s got %v\",want,err)}\n34| })}}\n35|}\n36|func TestReviewRestoreRequiredBinding(t *testing.T) {\n37| fx:=newLifecycleFixture(t,fullLifecycleAdmitted());recordBinding(t,fx,lxDigestA);fx.runner.queue(\"new-session\",\"\",0)\n38| out,err:=fx.lc.Execute(context.Background(),OpRequest{Operation:\"restore\",Body:lxRestoreBody(t,lxDigestA,nil),Source:\"absent\",Admitted:fullLifecycleAdmitted()});if err!=nil{t.Fatal(err)};if out.Binding==nil{t.Fatal(\"successful restore omits required TerminalInstanceBinding\")}\n39|}","final_result":true}}}
