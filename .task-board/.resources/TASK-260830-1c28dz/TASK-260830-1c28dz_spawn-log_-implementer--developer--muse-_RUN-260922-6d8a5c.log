 source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n356|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n357|\t\t}\n358|\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"backend binding read\"}\n359|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n360|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n361|\t}\n362|\tdeadline, err := mctx.Deadline.Time()\n363|\tif err != nil {\n364|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"mutation context deadline\"}\n365|\t}\n366|\tif !lc.Now().Before(deadline) {\n367|\t\tfailure := &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n368|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionReplaySame)\n369|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n370|\t}\n371|\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n372|\treqBackend.operation = operation\n373|\treqBackend.bootstrapID = body.BootstrapOperationID\n374|\t// The persist effect replays the recorded pair receipt (verified\n375|\t// by the mismatch arm above); the candidate carries the matched\n376|\t// prior digest so the store admits its shape on the replay path.\n377|\treqBackend.bindingID = body.PriorBindingID\n378|\treturn lc.executeWithReceipt(ctx, req, socket, operation, mctx, source, target, effects, deadline, terminstance.AuthorizationRestore, reqBackend, func(result terminstance.Result) OpOutcome {\n379|\t\treturn OpOutcome{Operation: operation, Mutation: &result, PriorBindingID: body.PriorBindingID, RestoredParked: true}\n380|\t})\n381|}\n382|\n383|// checkPriorBinding enforces the restore mismatch rule: the recorded\n384|// bootstrap binding for the (session, bootstrap) pair must exist and\n385|// its digest must equal the carried prior_binding_id. Substituting any\n386|// other binding — including the configured default — refuses the\n387|// restore mismatch. A binding read failure is an error, never a\n388|// mismatch: unknown is not a verdict.\n389|func (lc *Lifecycle) checkPriorBinding(body RestoreBody) error {\n390|\trecorded, found, err := lc.Bindings.Lookup(body.Context.SessionID, body.BootstrapOperationID)\n391|\tif err != nil {\n392|\t\treturn err\n393|\t}\n394|\tif !found || recorded.BindingDigest != body.PriorBindingID {\n395|\t\treturn &Error{Code: terminalbackend.CodeRestoreMismatch, Detail: \"restore prior binding\"}\n396|\t}\n397|\treturn nil\n398|}\n399|\n400|// effectPerformer executes one lifecycle side effect and reports its\n401|// evidence ID, the single capability the receipt-bound effect loop\n402|// needs from the request backend.\n403|type effectPerformer interface {\n404|\tPerformEffect(ctx context.Context, effect terminalbackend.SideEffect) (string, error)\n405|}\n406|\n407|// executeWithReceipt binds the idempotency receipt and runs the\n408|// effects under it, mirroring the engine's bind discipline: an\n409|// identical retry replays the one completion, a bound key without its\n410|// completion reconciles through the production status entry before it\n411|// refuses, and no path binds a second receipt for one key. complete\n412|// maps the successful result into the operation outcome; failures\n413|// return the outcome with the mutation set, mirroring the engine.\n414|func (lc *Lifecycle) executeWithReceipt(ctx context.Context, req OpRequest, socket string, operation terminalbackend.Operation, mctx terminstance.MutationContext, source, target terminalbackend.InstanceState, effects []terminalbackend.SideEffect, deadline time.Time, kind terminstance.AuthorizationKind, reqBackend effectPerformer, complete func(terminstance.Result) OpOutcome) (OpOutcome, error) {\n415|\tkey := mctx.IdempotencyKey\n416|\t_, replayed, err := lc.Receipts.Bind(key, operation, mctx.OperationID)\n417|\tif err != nil {\n418|\t\tif backendErrorCode(err) != \"\" {\n419|\t\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n420|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, rowError(operation, err)\n421|\t\t}\n422|\t\tif _, found, lookupErr := lc.Receipts.Lookup(key); lookupErr == nil && !found {\n423|\t\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"idempotency store failure\"}\n424|\t\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n425|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n426|\t\t}\n427|\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"idempotency store failure\"}\n428|\t\tresult := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n429|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n430|\t}\n431|\tif replayed {\n432|\t\tstored, found, err := lc.Receipts.Completed(key)\n433|\t\tif err != nil {\n434|\t\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"idempotency store failure\"}\n435|\t\t\tresult := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n436|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n437|\t\t}\n438|\t\tif !found {\n439|\t\t\treturn lc.resumeUncertain(ctx, req, socket, operation, mctx, source, target, effects, deadline, kind, reqBackend, complete)\n440|\t\t}\n441|\t\tvar result terminstance.Result\n442|\t\tif err := json.Unmarshal(stored, &result); err != nil {\n443|\t\t\tfailure := &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"idempotency result image\"}\n444|\t\t\trebuilt := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n445|\t\t\treturn OpOutcome{Operation: operation, Mutation: &rebuilt}, failure\n446|\t\t}\n447|\t\tif err := terminstance.CheckResult(mctx, source, result); err != nil {\n448|\t\t\tif backendErrorCode(err) == \"\" {\n449|\t\t\t\tfailure := &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"idempotency result image\"}\n450|\t\t\t\trebuilt := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n451|\t\t\t\treturn OpOutcome{Operation: operation, Mutation: &rebuilt}, failure\n452|\t\t\t}\n453|\t\t\trebuilt := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionFor(backendErrorCode(err), true))\n454|\t\t\treturn OpOutcome{Operation: operation, Mutation: &rebuilt}, rowError(operation, err)\n455|\t\t}\n456|\t\treturn complete(result), nil\n457|\t}\n458|\tif lc.Hooks != nil && lc.Hooks.AfterReceipt != nil {\n459|\t\tlc.Hooks.AfterReceipt(operation, key, terminstance.InterimState(operation, source))\n460|\t}\n461|\treturn lc.runLifecycleEffects(ctx, operation, mctx, source, target, effects, deadline, kind, reqBackend, complete)\n462|}\n463|\n464|// resumeUncertain reconciles a bound key without its completion through\n465|// the production status entry: when status proves the presented source\n466|// state — nothing happened — the same operation continues under the\n467|// same receipt; when status proves anything else, or fails, the retry\n468|// refuses uncertain with status_first. No path binds a second receipt\n469|// for one key.\n470|func (lc *Lifecycle) resumeUncertain(ctx context.Context, req OpRequest, socket string, operation terminalbackend.Operation, mctx terminstance.MutationContext, source, target terminalbackend.InstanceState, effects []terminalbackend.SideEffect, deadline time.Time, kind terminstance.AuthorizationKind, reqBackend effectPerformer, complete func(terminstance.Result) OpOutcome) (OpOutcome, error) {\n471|\tbody := terminstance.StatusBody{\n472|\t\tSessionID:                  mctx.SessionID,\n473|\t\tTerminalInstanceID:         mctx.TerminalInstanceID,\n474|\t\tHasTerminalInstanceID:      true,\n475|\t\tTerminalBackendID:          mctx.TerminalBackendID,\n476|\t\tImplementationVersion:      mctx.ImplementationVersion,\n477|\t\tProtocolVersion:            mctx.ProtocolVersion,\n478|\t\tBackendGeneration:          mctx.BackendGeneration,\n479|\t\tHasBackendGeneration:       true,\n480|\t\tIncludeProviderObservation: false,\n481|\t\tDeadline:                   mctx.Deadline,\n482|\t}\n483|\tstatusBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n484|\tstatusBackend.operation = terminalbackend.OperationStatus\n485|\treport, err := lc.engineFor(statusBackend).ExecuteStatus(ctx, body, source, req.Admitted)\n486|\tif err != nil || report.State != source {\n487|\t\tfailure := &Error{Code: terminalbackend.CodeUnavailable, Detail: \"idempotency result uncertain\"}\n488|\t\tresult := mutationResult(mctx, source, terminalbackend.StateUnavailable, nil, nil, terminstance.DispositionStatusFirst)\n489|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n490|\t}\n491|\tif lc.Hooks != nil && lc.Hooks.AfterReceipt != nil {\n492|\t\tlc.Hooks.AfterReceipt(operation, mctx.IdempotencyKey, terminstance.InterimState(operation, source))\n493|\t}\n494|\treturn lc.runLifecycleEffects(ctx, operation, mctx, source, target, effects, deadline, kind, reqBackend, complete)\n495|}\n496|\n497|// runLifecycleEffects performs the transition's side effects under an\n498|// already-bound receipt with the per-effect deadline, authorization,\n499|// and generation gates, then completes the key exactly once — the\n500|// engine's runEffects contract, second side. Fresh and resumed runs\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c72f","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":498,"recorded_at":1780531400000991,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"call_id":"call_01a0c6dabb4c71c5afe65786c855a211","text":"Read text file `internal/tmuxserver/lifecycle.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"time\"\n6|\n7|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n14|)\n15|\n16|// Lifecycle executes the eight tmux lifecycle operations — create,\n17|// attach, status, quiesce-input, wait-safe-boundary, request-stop,\n18|// terminate-stale, restore — over the structured commands. Five\n19|// operations (create, quiesce-input, wait-safe-boundary, request-stop,\n20|// status) delegate to the landed terminstance engine with the tmux\n21|// backend; attach, terminate-stale, and restore — which the engine\n22|// scope gate refuses — execute here over the same landed gates\n23|// (transition matrix, idempotency shapes, authorization, capability\n24|// conferral, receipt and binding stores) plus the tmux backend.\n25|//\n26|// A Lifecycle is constructed whole: every store and function value is\n27|// required (except Sleep/PollInterval, which default, and\n28|// ServerAdmission, which only attach needs). The Execute entry refuses\n29|// before any work when a dependency is missing.\n30|type Lifecycle struct {\n31|\t// RuntimeDir is the tmux runtime directory (<root>/tmux) the\n32|\t// socket derives from.\n33|\tRuntimeDir string\n34|\t// Root is the Runtime IPC root the socket custody verifies.\n35|\tRoot string\n36|\t// Platform selects the sun_path limit.\n37|\tPlatform scalar.Platform\n38|\t// Runner executes the tmux commands.\n39|\tRunner Runner\n40|\t// Receipts is the durable idempotency receipt table.\n41|\tReceipts *terminstance.ReceiptStore\n42|\t// Bindings is the durable bootstrap binding store.\n43|\tBindings *axpane.Store\n44|\t// Attach is the durable attach-client receipt store.\n45|\tAttach *termbind.AttachStore\n46|\t// States is the durable AX-side state memory.\n47|\tStates *InstanceStates\n48|\t// CurrentLease and CurrentGeneration re-read the winning lease\n49|\t// and the validated binding generation at every check point.\n50|\tCurrentLease      func() terminstance.LeaseView\n51|\tCurrentGeneration func() string\n52|\t// Now is the clock.\n53|\tNow func() time.Time\n54|\t// Sleep waits between close-confirm polls. Nil means time.Sleep.\n55|\tSleep func(time.Duration)\n56|\t// PollInterval separates close-confirm polls. Non-positive means\n57|\t// 50 milliseconds.\n58|\tPollInterval time.Duration\n59|\t// ServerAdmission reports the live server attestation the attach\n60|\t// handler binds to the request generation (the P3-A wiring: a\n61|\t// fresh decoy admission refuses here). Nil refuses attach only.\n62|\tServerAdmission func() (RealmAdmission, error)\n63|\t// Hooks observes receipts and effects. Nil disables observation.\n64|\tHooks *terminstance.EngineHooks\n65|}\n66|\n67|// OpRequest is one lifecycle operation request: the operation name,\n68|// its closed body, the presented source state, the admitted\n69|// capabilities, and — for terminate-stale only — the fencing material.\n70|type OpRequest struct {\n71|\tOperation            string\n72|\tBody                 []byte\n73|\tSource               string\n74|\tAdmitted             terminalbackend.Admitted\n75|\tPresented            fencing.PresentedToken\n76|\tWinner               sessrepo.LeaseSummary\n77|\tHasWinner            bool\n78|\tForceRecovery        bool\n79|\tDiagnosticsPreserved bool\n80|}\n81|\n82|// AttachOutcome is the attach success payload: the client mirror, the\n83|// host-local descriptor, the authorized input boolean, and the\n84|// evidence. The result input boolean always equals the request and the\n85|// authorization; the landed CheckAttachResult proves it on every call.\n86|type AttachOutcome struct {\n87|\tClientMirrorID  string\n88|\tDescriptor      string\n89|\tInputAuthorized bool\n90|\tEvidenceIDs     []string\n91|}\n92|\n93|// OpOutcome is one executed operation: exactly one of Mutation,\n94|// Status, or Attach is set, plus the per-operation success members.\n95|// Mutation is set on every executed mutating path — success and\n96|// coded failure alike, mirroring the engine — and nil only when the\n97|// request was malformed before any result existed.\n98|type OpOutcome struct {\n99|\tOperation              terminalbackend.Operation\n100|\tMutation               *terminstance.Result\n101|\tStatus                 *terminstance.StatusReport\n102|\tAttach                 *AttachOutcome\n103|\tArgv                   []string\n104|\tBinding                *termbind.Binding\n105|\tDescriptor             *string\n106|\tPriorBindingID         string\n107|\tRestoredParked         bool\n108|\tTargetClosed           bool\n109|\tProcessClosed          bool\n110|\tStoreClosed            bool\n111|\tQuiescenceGeneration   string\n112|\tInputClosedAt          string\n113|\tSafeBoundaryEvidenceID string\n114|\tBoundaryObservedAt     string\n115|}\n116|\n117|// Execute runs one lifecycle operation to its outcome. Refusals\n118|// precede side effects: malformed operations, unknown backends, and\n119|// unsafe sockets refuse before any store or tmux interaction. The\n120|// socket custody (before-connect rejection) and length refusal run on\n121|// every operation, because every operation connects.\n122|func (lc *Lifecycle) Execute(ctx context.Context, req OpRequest) (OpOutcome, error) {\n123|\tempty := OpOutcome{}\n124|\tif lc == nil || lc.Runner == nil || lc.Receipts == nil || lc.Bindings == nil ||\n125|\t\tlc.Attach == nil || lc.States == nil ||\n126|\t\tlc.CurrentLease == nil || lc.CurrentGeneration == nil || lc.Now == nil {\n127|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle dependencies\"}\n128|\t}\n129|\toperation, err := terminalbackend.ParseOperation(req.Operation)\n130|\tif err != nil {\n131|\t\treturn empty, err\n132|\t}\n133|\tif _, err := DirectivesFor(operation); err != nil {\n134|\t\treturn empty, err\n135|\t}\n136|\tsocket := SocketPath(lc.RuntimeDir)\n137|\tif err := CheckSocketLength(socket, lc.Platform); err != nil {\n138|\t\treturn empty, err\n139|\t}\n140|\tif err := CheckSocketCustody(socket, lc.Root, lc.Platform); err != nil {\n141|\t\treturn empty, err\n142|\t}\n143|\tswitch operation {\n144|\tcase terminalbackend.OperationCreate:\n145|\t\treturn lc.executeCreate(ctx, req, socket)\n146|\tcase terminalbackend.OperationAttach:\n147|\t\treturn lc.executeAttach(ctx, req, socket)\n148|\tcase terminalbackend.OperationStatus:\n149|\t\treturn lc.executeStatus(ctx, req, socket)\n150|\tcase terminalbackend.OperationQuiesceInput:\n151|\t\treturn lc.executeEngineOp(ctx, req, socket, operation)\n152|\tcase terminalbackend.OperationWaitSafeBoundary:\n153|\t\treturn lc.executeEngineOp(ctx, req, socket, operation)\n154|\tcase terminalbackend.OperationRequestStop:\n155|\t\treturn lc.executeEngineOp(ctx, req, socket, operation)\n156|\tcase terminalbackend.OperationTerminateStale:\n157|\t\treturn lc.executeTerminate(ctx, req, socket)\n158|\tcase terminalbackend.OperationRestore:\n159|\t\treturn lc.executeRestore(ctx, req, socket)\n160|\tdefault:\n161|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle operation\"}\n162|\t}\n163|}\n164|\n165|// engineFor builds the per-call landed engine over a request-scoped\n166|// tmux backend. The engine is a plain struct: constructing one per\n167|// call keeps request identity out of shared state.\n168|func (lc *Lifecycle) engineFor(reqBackend *backend) *terminstance.Engine {\n169|\treturn &terminstance.Engine{\n170|\t\tStore:             lc.Receipts,\n171|\t\tBackend:           reqBackend,\n172|\t\tCurrentLease:      lc.CurrentLease,\n173|\t\tCurrentGeneration: lc.CurrentGeneration,\n174|\t\tNow:               lc.Now,\n175|\t\tHooks:             lc.Hooks,\n176|\t}\n177|}\n178|\n179|// requestBackend builds the request-scoped tmux backend over the\n180|// lifecycle stores and the admitted set.\n181|func (lc *Lifecycle) requestBackend(req OpRequest, socket, session, instance string) *backend {\n182|\tsleep := lc.Sleep\n183|\tif sleep == nil {\n184|\t\tsleep = time.Sleep\n185|\t}\n186|\tpoll := lc.PollInterval\n187|\tif poll <= 0 {\n188|\t\tpoll = 50 * time.Millisecond\n189|\t}\n190|\treturn &backend{\n191|\t\trunner:     lc.Runner,\n192|\t\truntimeDir: lc.RuntimeDir,\n193|\t\tsocket:     socket,\n194|\t\tsessionID:  session,\n195|\t\tinstanceID: instance,\n196|\t\tnow:        lc.Now,\n197|\t\tsleep:      sleep,\n198|\t\tpoll:       poll,\n199|\t\tadmitted:   req.Admitted,\n200|\t\tbindings:   lc.Bindings,\n201|\t\tattach:     lc.Attach,\n202|\t\tstates:     lc.States,\n203|\t\tkillExit:   -1,\n204|\t}\n205|}\n206|\n207|// recordAfter records the adopted after-state in the AX-side memory on\n208|// every executed path. The memory is advisory: the idempotency receipt\n209|// is the commit, and a failed Record leaves later status reads to\n210|// reconcile from live presence — so a Record failure never fails the\n211|// operation it follows, and a hook-staged failure test pins exactly\n212|// that specified behavior.\n213|func (lc *Lifecycle) recordAfter(instance string, after terminalbackend.InstanceState) {\n214|\tif lc.States == nil {\n215|\t\treturn\n216|\t}\n217|\t_ = lc.States.Record(instance, after)\n218|}\n219|\n220|// mutationResult assembles a lifecycle result with the engine's\n221|// buildResult contract: repeated request identities, before/after\n222|// states, bytewise-sorted effects and evidence, and one disposition.\n223|func mutationResult(mctx terminstance.MutationContext, before, after terminalbackend.InstanceState, effects []terminalbackend.SideEffect, evidence []string, disposition terminstance.RetryDisposition) terminstance.Result {\n224|\treturn terminstance.Result{\n225|\t\tOperationID:           mctx.OperationID,\n226|\t\tSessionID:             mctx.SessionID,\n227|\t\tTerminalInstanceID:    mctx.TerminalInstanceID,\n228|\t\tTerminalBackendID:     mctx.TerminalBackendID,\n229|\t\tImplementationVersion: mctx.ImplementationVersion,\n230|\t\tProtocolVersion:       mctx.ProtocolVersion,\n231|\t\tBackendGeneration:     mctx.BackendGeneration,\n232|\t\tBefore:                before,\n233|\t\tAfter:                 after,\n234|\t\tEffects:               sortedEffects(effects),\n235|\t\tEvidenceIDs:           sortedEvidence(evidence),\n236|\t\tDisposition:           disposition,\n237|\t}\n238|}\n239|\n240|// checkLifecycleBackend admits exactly the tmux backend identity: this\n241|// lifecycle executes for ax.tmux and no other backend. A request\n242|// naming any other backend refuses the failed local precondition,\n243|// never executes against the wrong backend.\n244|func checkLifecycleBackend(backendID string) error {\n245|\tif backendID != terminalbackend.BuiltinTmux {\n246|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"lifecycle backend\"}\n247|\t}\n248|\treturn nil\n249|}\n250|\n251|// checkBindingAgreement binds the create binding to its mutation\n252|// context: session, instance, backend, and generation must all agree.\n253|// Any disagreement refuses the failed local precondition: the binding\n254|// names another creation.\n255|func checkBindingAgreement(body CreateBody) error {\n256|\tif body.Binding.SessionID != body.Context.SessionID ||\n257|\t\tbody.Binding.TerminalInstanceID != body.Context.TerminalInstanceID ||\n258|\t\tbody.Binding.TerminalBackendID != body.Context.TerminalBackendID ||\n259|\t\tbody.Binding.BackendGeneration != body.Context.BackendGeneration {\n260|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"create binding agreement\"}\n261|\t}\n262|\treturn nil\n263|}\n264|\n265|// rowError normalizes a backend- or store-reported code against one\n266|// operation's allowed set: an in-row code propagates with its report,\n267|// while an outside-set code is itself refused as the protocol error —\n268|// the engine's CheckErrorAllowed arm, mirrored for the operations the\n269|// engine scope leaves out.\n270|func rowError(operation terminalbackend.Operation, err error) error {\n271|\tcode := backendErrorCode(err)\n272|\tif code == \"\" {\n273|\t\treturn err\n274|\t}\n275|\tif checkErr := terminalbackend.CheckErrorAllowed(string(operation), code); checkErr != nil {\n276|\t\treturn &Error{Code: terminalbackend.CodeProtocolError, Detail: \"operation error vocabulary\"}\n277|\t}\n278|\treturn err\n279|}\n280|\n281|// formatTimestamp renders Now in the scalar timestamp grammar: UTC\n282|// RFC3339 with millisecond precision, always carrying the fractional\n283|// digits the grammar requires.\n284|func formatTimestamp(now time.Time) string {\n285|\treturn now.UTC().Format(\"2006-01-02T15:04:05.000Z07:00\")\n286|}\n287|\n288|// executeCreate runs the full create body: closed-shape admission,\n289|// backend and transport gates, binding agreement, then the landed\n290|// engine with the tmux backend. The result echoes the carried binding\n291|// and, exactly when interactive, the unbound attach descriptor.\n292|func (lc *Lifecycle) executeCreate(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n293|\tempty := OpOutcome{Operation: terminalbackend.OperationCreate}\n294|\tbody, err := parseCreateBody(req.Body)\n295|\tif err != nil {\n296|\t\treturn empty, err\n297|\t}\n298|\tif err := checkLifecycleBackend(body.Context.TerminalBackendID); err != nil {\n299|\t\treturn empty, err\n300|\t}\n301|\tif body.Transport == string(terminalbackend.TransportThirdPartyRelay) {\n302|\t\treturn empty, &Error{Code: terminalbackend.CodeUnauthorized, Detail: \"create relay transport\"}\n303|\t}\n304|\tif err := checkBindingAgreement(body); err != nil {\n305|\t\treturn empty, err\n306|\t}\n307|\treqBackend := lc.requestBackend(req, socket, body.Context.SessionID, body.Context.TerminalInstanceID)\n308|\treqBackend.operation = terminalbackend.OperationCreate\n309|\treqBackend.bootstrapID = body.BootstrapOperationID\n310|\treqBackend.bindingID = body.Binding.BindingID\n311|\tresult, err := lc.engineFor(reqBackend).ExecuteMutating(ctx, terminalbackend.OperationCreate, body.Context, terminstance.Params{\n312|\t\tBootstrapOperationID: body.BootstrapOperationID,\n313|\t\tInteractive:          body.Interactive,\n314|\t}, terminalbackend.InstanceState(req.Source), req.Admitted)\n315|\toutcome := OpOutcome{Operation: terminalbackend.OperationCreate, Binding: &body.Binding}\n316|\tif result.OperationID != \"\" {\n317|\t\toutcome.Mutation = &result\n318|\t\tlc.recordAfter(body.Context.TerminalInstanceID, result.After)\n319|\t}\n320|\tif err != nil {\n321|\t\treturn outcome, err\n322|\t}\n323|\tif body.Interactive {\n324|\t\tdescriptor := createDescriptor(socket, body.Context.TerminalInstanceID)\n325|\t\toutcome.Descriptor = &descriptor\n326|\t}\n327|\treturn outcome, nil\n328|}\n329|\n330|// executeStatus runs one status query through the landed engine with\n331|// the tmux backend: no receipt, no side effects, no authorization.\n332|func (lc *Lifecycle) executeStatus(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n333|\tempty := OpOutcome{Operation: terminalbackend.OperationStatus}\n334|\tbody, err := terminstance.ParseStatusBody(req.Body)\n335|\tif err != nil {\n336|\t\treturn empty, err\n337|\t}\n338|\tif err := checkLifecycleBackend(body.TerminalBackendID); err != nil {\n339|\t\treturn empty, err\n340|\t}\n341|\tinstance := body.TerminalInstanceID\n342|\tif !body.HasTerminalInstanceID {\n343|\t\tinstance = \"\"\n344|\t}\n345|\treqBackend := lc.requestBackend(req, socket, body.SessionID, instance)\n346|\treqBackend.operation = terminalbackend.OperationStatus\n347|\treport, err := lc.engineFor(reqBackend).ExecuteStatus(ctx, body, terminalbackend.InstanceState(req.Source), req.Admitted)\n348|\tif err != nil {\n349|\t\treturn empty, err\n350|\t}\n351|\treturn OpOutcome{Operation: terminalbackend.OperationStatus, Status: &report}, nil\n352|}\n353|\n354|// executeEngineOp runs one quiesce-input, wait-safe-boundary, or\n355|// request-stop body through the landed engine with the tmux backend,\n356|// adding the per-operation success members the engine's receipt scope\n357|// leaves out.\n358|func (lc *Lifecycle) executeEngineOp(ctx context.Context, req OpRequest, socket string, operation terminalbackend.Operation) (OpOutcome, error) {\n359|\tempty := OpOutcome{Operation: operation}\n360|\tmctx, params, err := terminstance.ParseOperationBody(string(operation), req.Body)\n361|\tif err != nil {\n362|\t\treturn empty, err\n363|\t}\n364|\tif err := checkLifecycleBackend(mctx.TerminalBackendID); err != nil {\n365|\t\treturn empty, err\n366|\t}\n367|\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n368|\treqBackend.operation = operation\n369|\tswitch operation {\n370|\tcase terminalbackend.OperationWaitSafeBoundary:\n371|\t\treqBackend.quiescence = params.QuiescenceGeneration\n372|\t\treqBackend.channel = BoundaryChannelPrefix + params.QuiescenceGeneration\n373|\t\twaitCtx, cancel := lc.boundWait(ctx, mctx, params.TimeoutMs)\n374|\t\tdefer cancel()\n375|\t\treqBackend.waitCtx = waitCtx\n376|\tcase terminalbackend.OperationRequestStop:\n377|\t\treqBackend.deadline = lc.lesserDeadline(mctx, params.GracefulTimeoutMs)\n378|\t}\n379|\tresult, err := lc.engineFor(reqBackend).ExecuteMutating(ctx, operation, mctx, params, terminalbackend.InstanceState(req.Source), req.Admitted)\n380|\toutcome := OpOutcome{Operation: operation}\n381|\tif result.OperationID != \"\" {\n382|\t\toutcome.Mutation = &result\n383|\t\tlc.recordAfter(mctx.TerminalInstanceID, result.After)\n384|\t}\n385|\tif err != nil {\n386|\t\treturn outcome, err\n387|\t}\n388|\tswitch operation {\n389|\tcase terminalbackend.OperationQuiesceInput:\n390|\t\toutcome.QuiescenceGeneration = params.QuiescenceGeneration\n391|\t\toutcome.InputClosedAt = formatTimestamp(lc.Now())\n392|\tcase terminalbackend.OperationWaitSafeBoundary:\n393|\t\t// The boundary transition carries exactly one effect, and the\n394|\t\t// engine evidences every committed effect exactly once, so a\n395|\t\t// successful boundary result carries exactly one evidence ID.\n396|\t\toutcome.SafeBoundaryEvidenceID = result.EvidenceIDs[0]\n397|\t\toutcome.BoundaryObservedAt = formatTimestamp(lc.Now())\n398|\tcase terminalbackend.OperationRequestStop:\n399|\t\toutcome.ProcessClosed = true\n400|\t\toutcome.StoreClosed = true\n401|\t}\n402|\treturn outcome, nil\n403|}\n404|\n405|// boundWait bounds the safe-boundary wait by the lesser of the request\n406|// deadline and the timeout: the wait context carries the minimum, and\n407|// an already-invalid deadline falls back to the timeout alone (the\n408|// engine refuses the malformed deadline before any effect runs, so the\n409|// fallback never binds). The caller cancels the context.\n410|func (lc *Lifecycle) boundWait(ctx context.Context, mctx terminstance.MutationContext, timeoutMs uint64) (context.Context, context.CancelFunc) {\n411|\tbound := lc.Now().Add(time.Duration(timeoutMs) * time.Millisecond)\n412|\tif deadline, err := mctx.Deadline.Time(); err == nil && deadline.Before(bound) {\n413|\t\tbound = deadline\n414|\t}\n415|\treturn context.WithDeadline(ctx, bound)\n416|}\n417|\n418|// lesserDeadline computes the lesser of the request deadline and the\n419|// graceful timeout for the stop close-confirm poll. An invalid\n420|// deadline falls back the same way as the boundary wait.\n421|func (lc *Lifecycle) lesserDeadline(mctx terminstance.MutationContext, timeoutMs uint64) time.Time {\n422|\tbound := lc.Now().Add(time.Duration(timeoutMs) * time.Millisecond)\n423|\tif deadline, err := mctx.Deadline.Time(); err == nil && deadline.Before(bound) {\n424|\t\treturn deadline\n425|\t}\n426|\treturn bound\n427|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
