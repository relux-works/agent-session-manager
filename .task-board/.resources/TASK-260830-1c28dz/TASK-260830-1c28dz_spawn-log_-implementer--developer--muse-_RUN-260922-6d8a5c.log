{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000e447","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":4222,"recorded_at":1780531400008439,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"task_stream":{"kind":"task","id":"01a0c6ff-f662-7582-822a-1594c03fc928"},"task_id":"01a0c6ff-f662-7582-822a-1594c03fc928","event":{"kind":"output","task_id":"01a0c6ff-f662-7582-822a-1594c03fc928","chunk":"{\n  \"chunk_id\": \"exec-73-1\",\n  \"command\": \"sed -n '1871,1900p' internal/tmuxserver/mutant_harness.py; echo ===; sed -n '1470,1484p' internal/tmuxserver/mutant_harness.py\",\n  \"description\": \"Read harness main and root row\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"def main(argv: list[str]) -> int:\\n    log_dir: Path | None = None\\n    names = list(argv)\\n    if \\\"--log-dir\\\" in names:\\n        idx = names.index(\\\"--log-dir\\\")\\n        if idx + 1 >= len(names):\\n            print(\\\"--log-dir needs a directory\\\")\\n            return 2\\n        log_dir = Path(names[idx + 1])\\n        log_dir.mkdir(parents=True, exist_ok=True)\\n        del names[idx : idx + 2]\\n    selected = [m for m in MUTANTS if not names or m.name in names]\\n    if names and len(selected) != len(names):\\n        unknown = sorted(set(names) - {m.name for m in selected})\\n        print(f\\\"unknown mutants: {', '.join(unknown)}\\\")\\n        return 2\\n    failures = 0\\n    for mutant in selected:\\n        try:\\n            line = run_mutant(mutant, log_dir)\\n        except subprocess.TimeoutExpired:\\n            line = f\\\"ERROR: {mutant.name}: killer timed out\\\"\\n        print(line, flush=True)\\n        if not line.startswith(\\\"ok:\\\"):\\n            failures += 1\\n    return 1 if failures else 0\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    sys.exit(main(sys.argv[1:]))\\n===\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the ambient socket past the placement arm; every other misplaced socket still refuses. Kill path: the substituted path reaches leaf custody and refuses there instead, at the gate and through the prober alike (attribution verified per test from the raw log).\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-bind-root-writable\\\",\\n        path=f\\\"{PACKAGE}/bind.go\\\",\\n        find='\\\\tif writableByOthers(info) {\\\\n\\\\t\\\\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \\\"socket root\\\"}\\\\n',\\n        replace='\\\\tif writableByOthers(info) && info.Mode().Perm() != 0o777 {\\\\n\\\\t\\\\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \\\"socket root\\\"}\\\\n',\\n        count=1,\\n        run=\\\"TestCheckSocketCustodyRefusesUnsafeRoot\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly 0777 roots past the root writability arm; every other writable root still refuses, and the ancestor arm keeps its own row. Kill path: the world-writable root verifies clean.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-bind-ancestor-writable\\\",\\n\",\n  \"original_output_bytes\": 2077,\n  \"original_output_tokens\": 520,\n  \"truncated\": false\n}","final_result":true}}}
