d per test from the raw log).\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-status-absent-quiescing\\\",\\n        path=f\\\"{PACKAGE}/status.go\\\",\\n        find='\\\\tcase terminalbackend.StateStopped, terminalbackend.StateStaleFenced:\\\\n\\\\t\\\\treturn input.Memory, false, false, false\\\\n',\\n        replace='\\\\tcase terminalbackend.StateStopped, terminalbackend.StateStaleFenced, terminalbackend.StateQuiescing:\\\\n\\\\t\\\\treturn input.Memory, false, false, false\\\\n',\\n        count=1,\\n        run=\\\"(TestClassifyStatusAbsentProbe|TestExecuteStatusContradictions)\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly quiescing memory past the absent-probe contradiction arm; every other contradictory memory still reads unavailable. Kill path: the vanished wrapper adopts quiescing instead of unavailable, at the helper and through the status dispatch alike (attribution verified per test from the raw log).\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-status-present-stopped\\\",\\n        path=f\\\"{PACKAGE}/status.go\\\",\\n        find='\\\\tcase terminalbackend.StateStopped, terminalbackend.StateUnavailable:\\\\n',\\n        replace='\\\\tcase terminalbackend.StateUnavailable:\\\\n',\\n        count=1,\\n        run=\\\"(TestClassifyStatusPresentProbe|TestExecuteStatusContradictions|TestObserveStatusMemoryReconciles)\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly stopped memory past the present-probe contradiction arm (it falls into the live triad); unavailable memory still reads unavailable. Kill path: the resurrected session reads parked instead of unavailable, at the helper and through the status dispatch alike (attribution verified per test from the raw log).\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-status-attachable\\\",\\n        path=f\\\"{PACKAGE}/status.go\\\",\\n=== ancestor row ===\\n        name=\\\"N-bind-ancestor-writable\\\",\\n        path=f\\\"{PACKAGE}/bind.go\\\",\\n        find='\\\\t\\\\tif writableByOthers(info) {\\\\n\\\\t\\\\t\\\\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \\\"socket ancestor\\\"}\\\\n',\\n        replace='\\\\t\\\\tif writableByOthers(info) && info.Mode().Perm() != 0o777 {\\\\n\\\\t\\\\t\\\\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \\\"socket ancestor\\\"}\\\\n',\\n        count=1,\\n        run=\\\"TestCheckSocketCustodyRefusesWritableAncestor\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly 0777 ancestors past the ancestor writability arm; every other writable ancestor still refuses, and the root arm keeps its own row. Kill path: the world-writable ancestor verifies clean.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-bind-socket-kind\\\",\\n        path=f\\\"{PACKAGE}/bind.go\\\",\\n        find='\\\\tif info.Mode().Type() != os.ModeSocket {\\\\n\\\\t\\\\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \\\"socket kind\\\"}\\\\n\\\\t}\\\\n',\\n        replace='\\\\tif info.Mode().Type() != os.ModeSocket && !info.Mode().IsRegular() {\\\\n\\\\t\\\\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \\\"socket kind\\\"}\\\\n\\\\t}\\\\n',\\n        count=1,\\n        run=\\\"TestCheckSocketCustodyRefusesNonSocketFile\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly regular files past the socket kind arm (the unlink step would remove one); every other non-socket kind still refuses. Kill path: the regular file at the socket path verifies clean.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-attach-capability-local\\\",\\n        path=f\\\"{PACKAGE}/ops.go\\\",\\n        find='\\\\tcase string(terminalbackend.TransportLocalOnly):\\\\n\\\\t\\\\tif !admitted.Has(\\\"local_attach\\\") {\\\\n\\\\t\\\\t\\\\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \\\"operation capability conditional\\\"}\\\\n\\\\t\\\\t}\\\\n',\\n        replace='\\\\tcase string(terminalbackend.TransportLocalOnly):\\\\n',\\n        count=1,\\n        run=\\\"TestExecuteAttachRefusals/wrong-transport-capability\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly capability-less local presentation past the matching-transport gate (the mesh arm stays); mesh without remote_attach still refuses. Kill path: the unevidenced attach succeeds instead of refusing.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-attach-capability-mesh\\\",\\n        path=f\\\"{PACKAGE}/ops.go\\\",\\n        find='\\\\tcase string(terminalbackend.TransportTrustedPrivateMesh):\\\\n\\\\t\\\\tif !admitted.Has(\\\"remote_attach\\\") {\\\\n\\\\t\\\\t\\\\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \\\"operation capability conditional\\\"}\\\\n\\\\t\\\\t}\\\\n',\\n        replace='\\\\tcase string(terminalbackend.TransportTrustedPrivateMesh):\\\\n',\\n        count=1,\\n        run=\\\"TestExecuteAttachRefusesMeshWithoutCapability\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly capability-less mesh presentation past the matching-transport gate (the local arm stays); local without local_attach still refuses. Kill path: the unevidenced attach succeeds instead of refusing.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-attach-deadline-boundary\\\",\\n=== greps ===\\n1325:        path=f\\\"{PACKAGE}/status.go\\\",\\n1335:        path=f\\\"{PACKAGE}/status.go\\\",\\n1345:        path=f\\\"{PACKAGE}/status.go\\\",\\n1355:        path=f\\\"{PACKAGE}/status.go\\\",\\n1365:        path=f\\\"{PACKAGE}/status.go\\\",\\n1735:        path=f\\\"{PACKAGE}/status.go\\\",\\n\",\n  \"original_output_bytes\": 5732,\n  \"original_output_tokens\": 1433,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
