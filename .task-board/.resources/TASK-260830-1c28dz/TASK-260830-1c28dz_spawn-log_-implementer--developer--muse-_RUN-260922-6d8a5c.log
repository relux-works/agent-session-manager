{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000dd27","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":3310,"recorded_at":1780531400006615,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"task_stream":{"kind":"task","id":"01a0c6f8-1a0e-7be3-8343-393e99c8e011"},"task_id":"01a0c6f8-1a0e-7be3-8343-393e99c8e011","event":{"kind":"output","task_id":"01a0c6f8-1a0e-7be3-8343-393e99c8e011","chunk":"Read text file `internal/tmuxserver/probe_unix_test.go`.\n(13 line(s) above)\n14|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n15|)\n16|\n17|// lxProbeRoot stages a short runtime root (sun_path-fitting) with a\n18|// verified leaf for dial/probe/spawn tests.\n19|func lxProbeRoot(t *testing.T) (string, string) {\n20|\tt.Helper()\n21|\tshort, err := os.MkdirTemp(\"/tmp\", \"axprobe\")\n22|\tif err != nil {\n23|\t\tt.Fatal(err)\n24|\t}\n25|\tt.Cleanup(func() { os.RemoveAll(short) })\n26|\troot := filepath.Join(short, \"r\")\n27|\tif err := os.Mkdir(root, 0o755); err != nil {\n28|\t\tt.Fatal(err)\n29|\t}\n30|\truntime, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n31|\tif err != nil {\n32|\t\tt.Fatal(err)\n33|\t}\n34|\treturn root, SocketPath(runtime)\n35|}\n36|\n37|// lxBareRoot stages a short runtime root with no leaf: the shape an\n38|// unstaged root leaves behind (the delegated leaf custody refuses).\n39|func lxBareRoot(t *testing.T) (string, string) {\n40|\tt.Helper()\n41|\tshort, err := os.MkdirTemp(\"/tmp\", \"axbare\")\n42|\tif err != nil {\n43|\t\tt.Fatal(err)\n44|\t}\n45|\tt.Cleanup(func() { os.RemoveAll(short) })\n46|\troot := filepath.Join(short, \"r\")\n47|\tif err := os.Mkdir(root, 0o755); err != nil {\n48|\t\tt.Fatal(err)\n49|\t}\n50|\treturn root, filepath.Join(root, RuntimeDirName, SocketName)\n51|}\n52|\n53|// stageStaleSocket binds a unix socket and closes the descriptor\n54|// without unlinking the path: the shape a SIGKILLed server leaves\n55|// behind (Go's net listener unlinks on close, so raw syscalls stage\n56|// it). Dialing the staged path reports ECONNREFUSED.\n57|func stageStaleSocket(t *testing.T, socket string) {\n58|\tt.Helper()\n59|\tfd, err := syscall.Socket(syscall.AF_UNIX, syscall.SOCK_STREAM, 0)\n60|\tif err != nil {\n61|\t\tt.Fatal(err)\n62|\t}\n63|\tdefer syscall.Close(fd)\n64|\tif err := syscall.Bind(fd, &syscall.SockaddrUnix{Name: socket}); err != nil {\n65|\t\tt.Fatal(err)\n66|\t}\n67|}\n68|\n69|func TestUnixDialerLiveStaleUnknown(t *testing.T) {\n70|\t_, socket := lxProbeRoot(t)\n71|\tdialer := UnixDialer{}\n72|\tlistener, err := net.Listen(\"unix\", socket)\n73|\tif err != nil {\n(more lines below)","final_result":true}}}
