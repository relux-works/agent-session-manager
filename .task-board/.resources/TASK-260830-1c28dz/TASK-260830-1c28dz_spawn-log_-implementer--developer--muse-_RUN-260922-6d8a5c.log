{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c7d3","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":580,"recorded_at":1780531400001155,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"task_stream":{"kind":"task","id":"01a0c6da-e50f-7873-91ab-b2eeadbb707f"},"task_id":"01a0c6da-e50f-7873-91ab-b2eeadbb707f","event":{"kind":"output","task_id":"01a0c6da-e50f-7873-91ab-b2eeadbb707f","chunk":"Read text file `internal/tmuxserver/ops.go`.\n(499 line(s) above)\n500|// engine's runEffects contract, second side. Fresh and resumed runs\n501|// share this loop. On success the after-state records in the AX-side\n502|// memory and the outcome completes; every failure returns the outcome\n503|// with the mutation set, mirroring the engine.\n504|func (lc *Lifecycle) runLifecycleEffects(ctx context.Context, operation terminalbackend.Operation, mctx terminstance.MutationContext, source, target terminalbackend.InstanceState, effects []terminalbackend.SideEffect, deadline time.Time, kind terminstance.AuthorizationKind, reqBackend effectPerformer, complete func(terminstance.Result) OpOutcome) (OpOutcome, error) {\n505|\tkey := mctx.IdempotencyKey\n506|\tcommitted := false\n507|\tevidence := []string(nil)\n508|\tperformed := []terminalbackend.SideEffect(nil)\n509|\tfail := func(code, detail string) (OpOutcome, error) {\n510|\t\tafter := source\n511|\t\tif committed {\n512|\t\t\tafter = terminalbackend.StateUnavailable\n513|\t\t}\n514|\t\tfailure := &Error{Code: code, Detail: detail}\n515|\t\tresult := mutationResult(mctx, source, after, performed, evidence, terminstance.DispositionFor(code, committed))\n516|\t\tlc.recordAfter(mctx.TerminalInstanceID, after)\n517|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n518|\t}\n519|\tfor _, effect := range effects {\n520|\t\tif !lc.Now().Before(deadline) {\n521|\t\t\treturn fail(rowTimeoutCode(operation), \"operation deadline\")\n522|\t\t}\n523|\t\tif err := terminstance.CheckAuthorization(mctx.Authorization, kind, lc.CurrentLease(), lc.Now()); err != nil {\n524|\t\t\tcode := backendErrorCode(err)\n525|\t\t\tif code == \"\" {\n526|\t\t\t\tcode = terminalbackend.CodeUnauthorized\n527|\t\t\t}\n528|\t\t\treturn fail(code, \"lifecycle authorization recheck\")\n529|\t\t}\n530|\t\tif lc.CurrentGeneration() != mctx.BackendGeneration {\n531|\t\t\treturn fail(terminalbackend.CodeStaleGeneration, \"backend_generation stale\")\n532|\t\t}\n533|\t\tif lc.Hooks != nil && lc.Hooks.BeforeEffect != nil {\n534|\t\t\tlc.Hooks.BeforeEffect(effect)\n535|\t\t}\n536|\t\tevidenceID, err := reqBackend.PerformEffect(ctx, effect)\n537|\t\tif lc.Hooks != nil && lc.Hooks.AfterEffect != nil {\n538|\t\t\tlc.Hooks.AfterEffect(effect)\n539|\t\t}\n540|\t\tif err != nil {\n541|\t\t\tcode := backendErrorCode(err)\n542|\t\t\tif code == \"\" {\n543|\t\t\t\treturn fail(terminstance.CodeProcessFailed, \"backend effect uncertain\")\n544|\t\t\t}\n545|\t\t\tif checkErr := terminalbackend.CheckErrorAllowed(string(operation), code); checkErr != nil {\n546|\t\t\t\treturn fail(terminalbackend.CodeProtocolError, \"operation error vocabulary\")\n547|\t\t\t}\n548|\t\t\treturn fail(code, \"backend effect refused\")\n549|\t\t}\n550|\t\tif _, err := scalar.ParseDigest(evidenceID); err != nil {\n551|\t\t\treturn fail(terminalbackend.CodeIntegrityFailure, \"backend effect evidence\")\n552|\t\t}\n553|\t\tcommitted = true\n554|\t\tperformed = append(performed, effect)\n555|\t\tevidence = append(evidence, evidenceID)\n556|\t}\n557|\tresult := mutationResult(mctx, source, target, performed, evidence, terminstance.DispositionReplaySame)\n558|\tencoded, err := json.Marshal(result)\n559|\tif err != nil {\n560|\t\tfailure := &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"idempotency result image\"}\n561|\t\tresult.Disposition = terminstance.DispositionStatusFirst\n562|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n563|\t}\n564|\tif err := lc.Receipts.Complete(key, encoded); err != nil {\n565|\t\tif backendErrorCode(err) == \"\" {\n566|\t\t\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \"idempotency store failure\"}\n567|\t\t\tresult.Disposition = terminstance.DispositionStatusFirst\n568|\t\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n569|\t\t}\n570|\t\tresult.Disposition = terminstance.DispositionStatusFirst\n571|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, rowError(operation, err)\n572|\t}\n573|\tlc.recordAfter(mctx.TerminalInstanceID, target)\n574|\treturn complete(result), nil\n575|}\n576|\n577|// rowTimeoutCode reports the timeout code for one lifecycle operation:\n578|// terminal_backend_timeout everywhere (neither terminate-stale nor\n579|// restore names a dedicated timeout).\n580|func rowTimeoutCode(operation terminalbackend.Operation) string {\n581|\t_ = operation\n582|\treturn terminstance.CodeTimeout\n583|}","final_result":true}}}
