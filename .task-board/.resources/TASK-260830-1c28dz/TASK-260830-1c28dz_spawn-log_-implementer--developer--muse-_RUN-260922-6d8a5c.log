{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000dd63","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":3340,"recorded_at":1780531400006675,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"task_stream":{"kind":"task","id":"01a0c6f8-4536-7db3-891e-c7b713ae682c"},"task_id":"01a0c6f8-4536-7db3-891e-c7b713ae682c","event":{"kind":"output","task_id":"01a0c6f8-4536-7db3-891e-c7b713ae682c","chunk":"Read text file `internal/tmuxserver/crash_spawn_unix_test.go`.\n1|//go:build darwin || linux\n2|\n3|package tmuxserver\n4|\n5|import (\n6|\t\"context\"\n7|\t\"errors\"\n8|\t\"os\"\n9|\t\"os/exec\"\n10|\t\"syscall\"\n11|\t\"testing\"\n12|\t\"time\"\n13|\n14|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n15|)\n16|\n17|// Real process-termination evidence for the spawn seam. The child runs\n18|// the genuine production unlinkStaleSocket over a staged stale socket\n19|// and SIGKILLs itself where the spawn commit would run — after the\n20|// unlink, before the server spawn. The parent proves the interrupted\n21|// run left a clean bind behind: the retry spawns exactly once through\n22|// the production spawner with no tmux process anywhere (fake runner).\n23|const (\n24|\tspawnCrashChildMode   = \"AX_TMUXSERVER_SPAWN_CRASH_MODE\"\n25|\tspawnCrashChildSocket = \"AX_TMUXSERVER_SPAWN_CRASH_SOCKET\"\n26|)\n27|\n28|func TestSpawnCrashBetweenUnlinkAndSpawnConverges(t *testing.T) {\n29|\tif os.Getenv(spawnCrashChildMode) == \"unlink\" {\n30|\t\tspawnCrashChild(t)\n31|\t\treturn\n32|\t}\n33|\troot, socket := lxProbeRoot(t)\n34|\tstageStaleSocket(t, socket)\n35|\tctx, cancel := context.WithTimeout(context.Background(), 60*time.Second)\n36|\tdefer cancel()\n37|\tchild := exec.CommandContext(ctx, os.Args[0],\n38|\t\t\"-test.run=^TestSpawnCrashBetweenUnlinkAndSpawnConverges$\",\n39|\t\t\"-test.count=1\",\n40|\t)\n41|\tchild.Env = append(os.Environ(),\n42|\t\tspawnCrashChildMode+\"=unlink\",\n43|\t\tspawnCrashChildSocket+\"=\"+socket,\n44|\t)\n45|\tchildOut, runErr := child.CombinedOutput()\n46|\tvar exitErr *exec.ExitError\n47|\tif !errors.As(runErr, &exitErr) {\n48|\t\tt.Fatalf(\"child run = %v (output: %s), want a signal-kill exit\", runErr, childOut)\n49|\t}\n50|\tstatus, ok := exitErr.Sys().(syscall.WaitStatus)\n51|\tif !ok || !status.Signaled() || status.Signal() != syscall.SIGKILL {\n52|\t\tt.Fatalf(\"child status = %v (output: %s), want killed by SIGKILL\", exitErr, childOut)\n53|\t}\n54|\tif _, err := os.Lstat(socket); !os.IsNotExist(err) {\n55|\t\tt.Fatalf(\"stale socket after kill: %v\", err)\n56|\t}\n57|\trunner := newFakeRunner().queue(\"new-session\", \"\", 0)\n58|\tspawner := ServerSpawner{Root: root, Platform: scalar.PlatformMacOS, Runner: runner}\n59|\tgood, err := BuildArgv(root+\"/tmux\", socket, lxSession)\n60|\tif err != nil {\n61|\t\tt.Fatal(err)\n62|\t}\n63|\tif err := spawner.Spawn(socket, good); err != nil {\n64|\t\tt.Fatalf(\"Spawn() retry after kill error = %v\", err)\n65|\t}\n66|\tif runner.callCount() != 1 {\n67|\t\tt.Fatalf(\"spawn calls = %d, want 1\", runner.callCount())\n68|\t}\n69|}\n70|\n71|func spawnCrashChild(t *testing.T) {\n72|\tt.Helper()\n73|\tsocket := os.Getenv(spawnCrashChildSocket)\n74|\tif _, err := unlinkStaleSocket(socket); err != nil {\n75|\t\tt.Fatalf(\"child unlink: %v\", err)\n76|\t}\n77|\t_ = syscall.Kill(syscall.Getpid(), syscall.SIGKILL)\n78|\tt.Fatal(\"crash child survived its kill\")\n79|}","final_result":true}}}
