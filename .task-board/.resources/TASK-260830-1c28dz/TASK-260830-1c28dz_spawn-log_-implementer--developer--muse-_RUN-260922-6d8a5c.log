{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d76b","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":2576,"recorded_at":1780531400005147,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"task_stream":{"kind":"task","id":"01a0c6f3-8b5e-7b70-b8ad-4e6ea067d9d0"},"task_id":"01a0c6f3-8b5e-7b70-b8ad-4e6ea067d9d0","event":{"kind":"output","task_id":"01a0c6f3-8b5e-7b70-b8ad-4e6ea067d9d0","chunk":"edited\nchanged lines: lines 320-333\n--- original\n+++ updated\n@@\n-// executeRestore runs one restore: closed-shape admission, idempotency\n-// material, capability conferral plus the reboot conditional,\n-// transition, restore authorization, generation recheck, prior-binding\n-// mismatch, deadline, receipt discipline with status-reconciled\n-// resume, and the persist plus wrapper-restored effects. The result is\n-// always parked: the wrapper's after-restore sequence (landed axpane\n-// Decide) owns resume, never the backend.\n-//\n-// The result binding echo is a stated bound: restore carries digests\n-// only, and no binding minter exists in the tree (the JCS identity\n-// rule is termbind-private), so the outcome echoes the matched prior\n-// digest instead of a minted doc. The provisioning surface owns the\n-// minter.\n-func (lc *Lifecycle) executeRestore(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n+// executeRestore runs one restore: closed-shape admission, idempotency\n+// material, capability conferral plus the reboot conditional,\n+// transition, restore authorization, generation recheck, prior-binding\n+// mismatch, deadline, receipt discipline with status-reconciled\n+// resume, the persist plus wrapper-restored effects, the required\n+// result binding, and the §4.2 after-restore branch report. The wire\n+// result is always parked; the branch report (resumed, remote offer,\n+// or parked) steers the caller. The backend launches no provider on\n+// any branch: the wrapper owns launch gating through its own\n+// decision, and this entry only recreates the wrapper process.\n+//\n+// The result binding is the create-time document kept alongside the\n+// bootstrap receipt, re-admitted by termbind on the read: restore\n+// mints nothing (the JCS identity rule stays termbind-private) and\n+// echoes nothing. The prior-binding mismatch arm proves the carried\n+// prior equals the recorded digest; the document read proves a valid\n+// binding for this session, instance, backend, and generation.\n+func (lc *Lifecycle) executeRestore(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n","final_result":true}}}
