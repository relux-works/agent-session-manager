34|\tif _, err := scalar.ParseUUIDv7(value); err != nil {\n35|\t\treturn &terminalbackend.Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminal instance identity\"}\n36|\t}\n37|\treturn nil\n38|}\n39|\n40|// Binding is the parsed Terminal Instance Binding 1.0.0 closed object: the\n41|// host-local durable metadata Section 4.B defines. It is never replicated;\n42|// replicated Session Events carry only its digest as an opaque audit\n43|// reference.\n44|type Binding struct {\n45|\tBindingID             string\n46|\tSessionID             string\n47|\tHostID                string\n48|\tHostIncarnationID     string\n49|\tTerminalInstanceID    string\n50|\tTerminalBackendID     string\n51|\tImplementationVersion string\n52|\tProtocolVersion       string\n53|\tBackendGeneration     string\n54|\tNativeReference       string\n55|\tCreatedAt             string\n56|\tSupersedesBindingID   string\n57|\tHasSupersedes         bool\n58|}\n59|\n60|// bindingMembers is the exact closed member set of the binding document,\n61|// in the order Section 4.B lists it.\n62|var bindingMembers = []string{\n63|\t\"schema\",\n64|\t\"schema_version\",\n65|\t\"binding_id\",\n66|\t\"session_id\",\n67|\t\"host_id\",\n68|\t\"host_incarnation_id\",\n69|\t\"terminal_instance_id\",\n70|\t\"terminal_backend_id\",\n71|\t\"implementation_version\",\n72|\t\"protocol_version\",\n73|\t\"backend_generation\",\n74|\t\"native_reference\",\n75|\t\"created_at\",\n76|\t\"supersedes_binding_id\",\n77|\t\"extensions\",\n78|}\n79|\n80|// ParseTerminalBinding admits one closed Terminal Instance Binding 1.0.0\n81|// document. No parser exists on trunk for this schema, so this entry owns\n82|// it; every grammar delegates to its landed owner (frame to environ,\n83|// UUIDv7/digest/timestamp to scalar, backend ID and generation to\n84|// terminalbackend, semver to environ). The protocol_version member must\n85|// additionally select Terminal Backend Protocol major 1 and the\n86|// extensions member must be exactly the empty object {}, per the Section\n87|// 4.B table. The terminal_instance_id member passes through the coded\n88|// identity gate: a forbidden identity form refuses\n89|// terminal_backend_protocol_error. The binding_id member is recomputed by\n90|// the Section 4.B identity rule (digest of the RFC 8785 JCS bytes with the\n91|// ID member omitted, numbers and nested duplicates refused before the\n92|// transform) and must equal the carried value; a reader recompute\n93|// mismatch refuses terminal_backend_manifest_probe_mismatch. Member-type\n94|// faults refuse the same protocol class as the landed descriptor parser:\n95|// a mistyped binding member is a malformed local document.\n96|func ParseTerminalBinding(raw []byte) (Binding, error) {\n97|\tempty := Binding{}\n98|\tmembers, fault := environ.DecodeStrictObject(raw)\n99|\tif fault != nil {\n100|\t\treturn empty, protocolRefusal(\"binding frame\")\n101|\t}\n102|\tif len(members) != len(bindingMembers) {\n103|\t\treturn empty, protocolRefusal(\"binding member set\")\n104|\t}\n105|\tfor _, name := range bindingMembers {\n106|\t\tif _, known := members[name]; !known {\n107|\t\t\treturn empty, protocolRefusal(\"binding member set\")\n108|\t\t}\n109|\t}\n110|\tvar parsed Binding\n111|\ttext := func(name string) (string, error) {\n112|\t\tvar value string\n113|\t\tdecoder := json.NewDecoder(bytes.NewReader(members[name]))\n114|\t\tif err := decoder.Decode(&value); err != nil {\n115|\t\t\treturn \"\", protocolRefusal(\"binding \" + name)\n116|\t\t}\n117|\t\tif decoder.More() {\n118|\t\t\treturn \"\", protocolRefusal(\"binding \" + name)\n119|\t\t}\n120|\t\treturn value, nil\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
