err != nil {\n314|\t\t_ = staged.Close()\n315|\t\treturn fmt.Errorf(\"protect tmux instance state: %w\", err)\n316|\t}\n317|\tif _, err := staged.Write(raw); err != nil {\n318|\t\t_ = staged.Close()\n319|\t\treturn fmt.Errorf(\"write tmux instance state: %w\", err)\n320|\t}\n321|\tif err := staged.Sync(); err != nil {\n322|\t\t_ = staged.Close()\n323|\t\treturn fmt.Errorf(\"sync tmux instance state: %w\", err)\n324|\t}\n325|\tif err := staged.Close(); err != nil {\n326|\t\treturn fmt.Errorf(\"close tmux instance state: %w\", err)\n327|\t}\n328|\tif store.hooks != nil && store.hooks.AfterStage != nil {\n329|\t\tif err := store.hooks.AfterStage(stagedPath); err != nil {\n330|\t\t\treturn err\n331|\t\t}\n332|\t}\n333|\tif err := os.Rename(stagedPath, store.instancePath(instanceID)); err != nil {\n334|\t\treturn fmt.Errorf(\"install tmux instance state: %w\", err)\n335|\t}\n336|\tcommitted = true\n337|\tif store.hooks != nil && store.hooks.AfterInstall != nil {\n338|\t\tif err := store.hooks.AfterInstall(store.instancePath(instanceID)); err != nil {\n339|\t\t\treturn err\n340|\t\t}\n341|\t}\n342|\tif err := syncStateDirectory(dir); err != nil {\n343|\t\treturn err\n344|\t}\n345|\treturn nil\n346|}\n347|\n348|// sweepStateStaging removes stale staging files from pre-commit\n349|// crashes. Only the state-*.tmp pattern is swept; instance documents\n350|// are never touched.\n351|func sweepStateStaging(dir string) {\n352|\tentries, err := os.ReadDir(dir)\n353|\tif err != nil {\n354|\t\treturn\n355|\t}\n356|\tfor _, entry := range entries {\n357|\t\tname := entry.Name()\n358|\t\tif len(name) > 10 && name[:6] == \"state-\" && filepath.Ext(name) == \".tmp\" {\n359|\t\t\t_ = os.Remove(filepath.Join(dir, name))\n360|\t\t}\n361|\t}\n362|}\n363|\n364|// syncStateDirectory fsyncs the directory so the rename commit is\n365|// durable before Record returns.\n366|func syncStateDirectory(path string) error {\n367|\tdir, err := os.Open(path)\n368|\tif err != nil {\n369|\t\treturn err\n