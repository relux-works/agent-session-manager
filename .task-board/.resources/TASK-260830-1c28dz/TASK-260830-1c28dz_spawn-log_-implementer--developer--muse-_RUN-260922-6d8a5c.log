r nothing new.\\nfunc TestExecuteBoundaryIdempotent(t *testing.T) {\\n\\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\\n\\tfx.runner.queue(\\\"wait-for\\\", \\\"\\\", 0)\\n\",\n  \"original_output_bytes\": 1199,\n  \"original_output_tokens\": 300,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
