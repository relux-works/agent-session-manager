{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d9e9","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":2895,"recorded_at":1780531400005785,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"task_stream":{"kind":"task","id":"01a0c6f5-c5f6-7091-a65d-d64c091e8b65"},"task_id":"01a0c6f5-c5f6-7091-a65d-d64c091e8b65","event":{"kind":"output","task_id":"01a0c6f5-c5f6-7091-a65d-d64c091e8b65","chunk":"{\n  \"chunk_id\": \"exec-45-1\",\n  \"command\": \"sed -n '1140,1200p' internal/tmuxserver/mutant_harness.py; echo \\\"=====\\\"; sed -n '1560,1600p' internal/tmuxserver/mutant_harness.py\",\n  \"description\": \"Read vector-related harness rows\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly TMUX_TMPDIR-carrying entries past the child scrub (the TMUX arm stays); TMUX still scrubs. Kill path: the ambient socket directory leaks, at the scrub helper and into the real child environment alike (attribution verified per test from the raw log).\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-exec-directives-manifest\\\",\\n        path=f\\\"{PACKAGE}/backend.go\\\",\\n        find='\\\\tif !known {\\\\n\\\\t\\\\treturn nil, &Error{Code: terminalbackend.CodeProtocolError, Detail: \\\"lifecycle operation\\\"}\\\\n\\\\t}\\\\n',\\n        replace='\\\\tif !known && operation != terminalbackend.OperationManifest {\\\\n\\\\t\\\\treturn nil, &Error{Code: terminalbackend.CodeProtocolError, Detail: \\\"lifecycle operation\\\"}\\\\n\\\\t}\\\\n',\\n        count=1,\\n        run=\\\"(TestDirectivesForRefusesNonLifecycle|TestExecuteRefusesNonLifecycleScope)\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly manifest past the lifecycle-operation mapping; probe and every other unknown operation still refuse. One site, both entries: the helper and the dispatch scope test admit the manifest scope.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-exec-vector-detached\\\",\\n        path=f\\\"{PACKAGE}/exec.go\\\",\\n        find='\\\\t\\\\targv = []string{\\\"tmux\\\", \\\"-S\\\", args.Socket, \\\"new-session\\\", \\\"-d\\\",\\\\n\\\\t\\\\t\\\\t\\\"-s\\\", instance, \\\"ax\\\", \\\"pane\\\", session}\\\\n',\\n        replace='\\\\t\\\\targv = []string{\\\"tmux\\\", \\\"-S\\\", args.Socket, \\\"new-session\\\",\\\\n\\\\t\\\\t\\\\t\\\"-s\\\", instance, \\\"ax\\\", \\\"pane\\\", session}\\\\n',\\n        count=1,\\n        run=\\\"(TestBuildCommandVectors|TestExecuteCreateInteractive|TestExecuteRestore)\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the attached spawn vector past the fixed-shape builder (the spawned server would try to attach the caller); every other vector element stays exact. One site, three entries: the exact-vector assertions fail at the helper and through the create and restore dispatches alike.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-state-creating\\\",\\n        path=f\\\"{PACKAGE}/state.go\\\",\\n        find='\\\\tif state == terminalbackend.StateCreating {\\\\n',\\n        replace='\\\\tif state == terminalbackend.StateCreating && instanceID != \\\"0198f4c8-8e50-7f66-8f70-222222222221\\\" {\\\\n',\\n        count=1,\\n        run=\\\"TestInstanceStatesRefusesCreating\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the creating state for the fixture instance past the record gate; creating for any other instance still refuses. Kill path: the interim state durably records.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-state-record-identity\\\",\\n        path=f\\\"{PACKAGE}/state.go\\\",\\n        find='\\\\tif _, err := scalar.ParseUUIDv7(instanceID); err != nil {\\\\n\\\\t\\\\treturn &Error{Code: CodeInvalidArguments, Detail: \\\"instance state identity\\\"}\\\\n\\\\t}\\\\n',\\n        replace='\\\\tif _, err := scalar.ParseUUIDv7(instanceID); err != nil && instanceID != \\\"not-a-uuid\\\" {\\\\n\\\\t\\\\treturn &Error{Code: CodeInvalidArguments, Detail: \\\"instance state identity\\\"}\\\\n\\\\t}\\\\n',\\n        count=1,\\n        run=\\\"TestInstanceStatesRefusesBadIdentity\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the malformed identity past the record grammar; the lookup arm keeps its own row. Kill path: the unparseable instance records a document.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-state-lookup-identity\\\",\\n        path=f\\\"{PACKAGE}/state.go\\\",\\n        find='\\\\tif _, err := scalar.ParseUUIDv7(instanceID); err != nil {\\\\n\\\\t\\\\treturn \\\"\\\", false, &Error{Code: CodeInvalidArguments, Detail: \\\"instance state identity\\\"}\\\\n\\\\t}\\\\n',\\n        replace='\\\\tif _, err := scalar.ParseUUIDv7(instanceID); err != nil && instanceID != \\\"not-a-uuid\\\" {\\\\n\\\\t\\\\treturn \\\"\\\", false, &Error{Code: CodeInvalidArguments, Detail: \\\"instance state identity\\\"}\\\\n\\\\t}\\\\n',\\n        count=1,\\n        run=\\\"TestInstanceStatesRefusesBadIdentity\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly the malformed identity past the lookup grammar (it reads as absent); the record arm keeps its own row. Kill path: the unparseable lookup reports absence instead of refusing.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-state-unknown\\\",\\n        path=f\\\"{PACKAGE}/state.go\\\",\\n        find='\\\\tif _, err := terminalbackend.ParseInstanceState(string(state)); err != nil {\\\\n',\\n        replace='\\\\tif _, err := terminalbackend.ParseInstanceState(string(state)); err != nil && state != \\\"launched\\\" {\\\\n',\\n        count=1,\\n        run=\\\"TestInstanceStatesRefusesUnknownState\\\",\\n        expect=\\\