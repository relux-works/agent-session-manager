m_end = mx.index(\\\"## Bounds (mirrored B22-B32 plus carried dispositions)\\\")\\nmx = mx[:m_start] + t_block + \\\"\\\\n\\\" + mx[m_end:]\\nprint(\\\"census block replaced\\\")\\n\\n# 3. Bounds B22+: from \\\"## Stated bounds\\\" B22 part to end of TRACEABILITY; matrix bounds section to \\\"## Mutant battery\\\".\\nt_bounds = trace[trace.index(\\\"## Stated bounds\\\"):]\\n# take B22..B35 + carried paragraph\\nb22 = t_bounds.index(\\\"- B22 \\\")\\nt_bounds = t_bounds[b22:].rstrip() + \\\"\\\\n\\\"\\nm_bstart = mx.index(\\\"## Bounds (mirrored B22-B32 plus carried dispositions)\\\")\\nm_bend = mx.index(\\\"## Mutant battery\\\")\\nmx = mx[:m_bstart] + \\\"## Bounds (mirrored B22-B35 plus carried dispositions)\\\\n\\\\n\\\" + t_bounds + \\\"\\\\n\\\" + mx[m_bend:]\\nprint(\\\"bounds replaced\\\")\\n\\nPath(\\\"/tmp/c28dz/matrix-new.md\\\").write_text(mx)\\nprint(\\\"written\\\", len(mx.splitlines()), \\\"lines\\\")\\nPYEOF\",\n  \"description\": \"Regenerate matrix from traceability\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"trace rows: 33\\nmatrix rows replaced: 66\\ncensus block replaced\\nbounds replaced\\nwritten 514 lines\\n\",\n  \"original_output_bytes\": 96,\n  \"original_output_tokens\": 24,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
