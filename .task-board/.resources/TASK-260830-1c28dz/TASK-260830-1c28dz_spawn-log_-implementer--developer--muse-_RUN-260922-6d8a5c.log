{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c529","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":239,"recorded_at":1780531400000473,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"task_stream":{"kind":"task","id":"01a0c6d9-ff75-7c73-9eef-f7c8e705b210"},"task_id":"01a0c6d9-ff75-7c73-9eef-f7c8e705b210","event":{"kind":"output","task_id":"01a0c6d9-ff75-7c73-9eef-f7c8e705b210","chunk":"{\n  \"chunk_id\": \"exec-7-1\",\n  \"command\": \"task-board resource --help 2>&1 | head -n 40\\necho ===\\ntask-board q 'schema(operation=list)' 2>&1 | head -c 3000\",\n  \"description\": \"Learn resource download syntax\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"Manage attached resources such as screenshots, docs, logs, and other files.\\n\\nUse \\\"task-board resource add\\\" to create a new attached resource, \\\"task-board\\nresource adopt\\\" to register an orphaned local payload, \\\"task-board resource\\nupdate\\\" to replace an existing one, \\\"task-board resource delete\\\" to remove it,\\nand \\\"task-board resource get\\\" to materialize a resource back to the local\\nfilesystem for inspection.\\n\\nUsage:\\n  task-board resource [command]\\n\\nAvailable Commands:\\n  add         Attach a new file resource to an element\\n  adopt       Register an existing unreferenced local resource payload\\n  delete      Delete a resource from an element (requires --confirm)\\n  get         Download a resource to the local filesystem\\n  update      Replace an existing file resource on an element\\n\\nFlags:\\n  -h, --help   help for resource\\n\\nGlobal Flags:\\n      --board-dir string         Path to the board directory (overrides TASK_BOARD_DIR and config local.board_dir) (default \\\".task-board\\\")\\n      --context-profile string   Agent context profile override: full or lite\\n      --insecure                 Skip TLS certificate verification (for self-signed certs)\\n      --json                     Output in JSON format\\n      --no-update-check          Disable automatic update check\\n      --remote string            Remote board server URL (overrides TASK_BOARD_REMOTE)\\n      --remote-board string      Remote board ID (overrides TASK_BOARD_ID)\\n\\nUse \\\"task-board resource [command] --help\\\" for more information about a command.\\n===\\n{\\\"description\\\":\\\"List elements with optional filters and pagination\\\",\\\"examples\\\":[\\\"list(type=task, status=development) { overview }\\\",\\\"list(take=5) { minimal }\\\",\\\"list(type=story, skip=10, take=5) { overview }\\\"],\\\"kind\\\":\\\"operation\\\",\\\"name\\\":\\\"list\\\",\\\"parameters\\\":[{\\\"name\\\":\\\"type\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Filter by element type (epic, story, task, bug)\\\"},{\\\"name\\\":\\\"status\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Filter by status\\\"},{\\\"name\\\":\\\"parent\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Filter by parent ID\\\"},{\\\"name\\\":\\\"assignee\\\",\\\"type\\\":\\\"string\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Filter by assignee\\\"},{\\\"name\\\":\\\"blocked\\\",\\\"type\\\":\\\"bool\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Filter by hard or advisory blocked scheduling state\\\"},{\\\"name\\\":\\\"skip\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"default\\\":0,\\\"description\\\":\\\"Number of items to skip\\\"},{\\\"name\\\":\\\"take\\\",\\\"type\\\":\\\"int\\\",\\\"optional\\\":true,\\\"description\\\":\\\"Maximum number of items to return\\\"}],\\\"signature\\\":\\\"list(type?:string, status?:string, parent?:string, assignee?:string, blocked?:bool, skip?:int, take?:int)\\\",\\\"syntax\\\":\\\"OPERATION(element-or-identifier, key=value, key=\\\\\\\"quoted string\\\\\\\") { field preset }; statements separated by ';'; the first bare positional value is the element/identifier argument; remaining arguments use key=value (no operators or lists); string escapes: \\\\\\\\\\\\\\\" \\\\\\\\\\\\\\\\ \\\\\\\\n \\\\\\\\t\\\"}\\n\",\n  \"original_output_bytes\": 2857,\n  \"original_output_tokens\": 715,\n  \"truncated\": false\n}","final_result":true}}}
