{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c781","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":539,"recorded_at":1780531400001073,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"call_id":"call_01a0c6dac89677c2bffca4c9e45a6746","text":"Read text file `internal/tmuxserver/bind.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"os\"\n5|\t\"path/filepath\"\n6|\t\"strings\"\n7|\n8|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n9|)\n10|\n11|// Unix socket path limits: sun_path byte size including the trailing\n12|// NUL, per platform. macOS (darwin) allows 104 bytes; Linux and WSL2\n13|// allow 108. A derived socket at or beyond the limit can never bind or\n14|// connect, so the adapter refuses it before exec rather than surfacing\n15|// a spawn failure.\n16|const (\n17|\tsunPathLimitDarwin = 104\n18|\tsunPathLimitLinux  = 108\n19|)\n20|\n21|// CheckSocketLength refuses a derived socket path that cannot fit the\n22|// platform sun_path (bound B18, decided here): the byte length must\n23|// stay strictly below the platform limit, leaving room for the NUL.\n24|// The check runs on every bind and every connect, before any custody\n25|// or exec work, so a deep runtime root reports the length refusal, not\n26|// a spawn failure. Native Windows refuses upstream: no tmux socket\n27|// exists there.\n28|func CheckSocketLength(socket string, platform scalar.Platform) error {\n29|\tlimit := sunPathLimitLinux\n30|\tif platform == scalar.PlatformMacOS {\n31|\t\tlimit = sunPathLimitDarwin\n32|\t}\n33|\tif len(socket) >= limit {\n34|\t\treturn &Error{Code: CodeSocketPathTooLong, Detail: \"socket path length\"}\n35|\t}\n36|\treturn nil\n37|}\n38|\n39|// CheckSocketCustody enforces the SPEC 810-812 before-bind/connect\n40|// rejection (bounds B19/B20, decided here): before bind, connect,\n41|// rename, or unlink, AX rejects a socket path, parent, or ancestor\n42|// whose file kind, ownership, or permissions are unsafe. It answers\n43|// for one derived socket under one Runtime IPC root:\n44|//\n45|//   - the socket must name the runtime leaf exactly (<root>/tmux/ax.sock):\n46|//     a socket elsewhere is a substitution and refuses;\n47|//   - the runtime leaf must pass the landed leaf custody (mode,\n48|//     ownership, kind, containment via VerifyRuntimeDir);\n49|//   - the root itself must be an euid-owned directory, never a\n50|//     symlink, never group/world-writable unless sticky;\n51|//   - every ancestor above the root up to / must be a directory,\n52|//     never a symlink, never group/world-writable unless sticky\n53|//     (ownership is not required above the root: system prefixes are\n54|//     root-owned by design, e.g. 0755 /var or sticky 1777 /tmp);\n55|//   - the socket path itself, when present, must be a socket: the\n56|//     adapter unlinks a stale socket before bind and must never unlink\n57|//     any other kind. Absence is bindable.\n58|//\n59|// The walk uses lstat and never follows a symlink; a symlink at any\n60|// level refuses. A residual TOCTOU (rename between check and bind)\n61|// stays a stated bound: post-spawn the adapter probes the bound socket\n62|// and the generation-bound admission refuses a swapped server, so a\n63|// race fails into attestation, never into use.\n64|func CheckSocketCustody(socket, root string, platform scalar.Platform) error {\n65|\tif socket != filepath.Join(root, RuntimeDirName, SocketName) {\n66|\t\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket placement\"}\n67|\t}\n68|\tif err := VerifyRuntimeDir(root, RuntimeDirName, platform); err != nil {\n69|\t\treturn err\n70|\t}\n71|\tif err := checkCustodyRoot(root); err != nil {\n72|\t\treturn err\n73|\t}\n74|\tif err := checkCustodyAncestors(root); err != nil {\n75|\t\treturn err\n76|\t}\n77|\treturn checkCustodySocket(socket)\n78|}\n79|\n80|// checkCustodyRoot gates the Runtime IPC root itself: an euid-owned\n81|// directory, never a symlink, never writable by group or other unless\n82|// the sticky bit civilizes the write (a 0777 root refuses here — the\n83|// hole the first leaf left for this bind step).\n84|func checkCustodyRoot(root string) error {\n85|\tinfo, err := os.Lstat(root)\n86|\tif err != nil {\n87|\t\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket root\"}\n88|\t}\n89|\tif info.Mode()&os.ModeSymlink != 0 || !info.IsDir() {\n90|\t\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket root\"}\n91|\t}\n92|\tif !ownershipMatches(info) {\n93|\t\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket root\"}\n94|\t}\n95|\tif writableByOthers(info) {\n96|\t\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket root\"}\n97|\t}\n98|\treturn nil\n99|}\n100|\n101|// checkCustodyAncestors walks every ancestor above the root up to the\n102|// filesystem root: each must be a directory and never writable by\n103|// group or other unless sticky. Ownership is not decided above the\n104|// root: system prefixes are root-owned by design.\n105|//\n106|// The walk climbs the RESOLVED root (EvalSymlinks once up front):\n107|// system prefixes are conventional symlinks on macOS (/var, /tmp),\n108|// so a lexical climb would refuse every macOS root, while resolving\n109|// verifies the location writes actually land — the sound target. The\n110|// kind arm uses lstat without following, so a symlink, file, or any\n111|// other non-directory at any level refuses through this one arm; the\n112|// committed negative stages a regular-file ancestor, and a symlinked\n113|// ancestor above the resolved root shares the arm (unstageable without\n114|// privilege, documented, never a separate unmeasured check).\n115|func checkCustodyAncestors(root string) error {\n116|\tresolved, err := filepath.EvalSymlinks(root)\n117|\tif err != nil {\n118|\t\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket ancestor\"}\n119|\t}\n120|\tcleaned := resolved\n121|\tfor {\n122|\t\tparent := filepath.Dir(cleaned)\n123|\t\tif parent == cleaned {\n124|\t\t\treturn nil\n125|\t\t}\n126|\t\tinfo, err := os.Lstat(parent)\n127|\t\tif err != nil {\n128|\t\t\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket ancestor\"}\n129|\t\t}\n130|\t\tif !info.IsDir() {\n131|\t\t\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket ancestor\"}\n132|\t\t}\n133|\t\tif writableByOthers(info) {\n134|\t\t\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket ancestor\"}\n135|\t\t}\n136|\t\tif isFilesystemRoot(parent) {\n137|\t\t\treturn nil\n138|\t\t}\n139|\t\tcleaned = parent\n140|\t}\n141|}\n142|\n143|// isFilesystemRoot reports the end of the ancestor walk: the cleaned\n144|// path is the volume root (/ on unix; a drive root on Windows, which\n145|// refuses upstream before this walk ever runs).\n146|func isFilesystemRoot(path string) bool {\n147|\treturn path == string(filepath.Separator) || strings.HasSuffix(path, \":\\\\\")\n148|}\n149|\n150|// writableByOthers reports group/world writability without the sticky\n151|// bit: sticky directories (1777 /tmp) admit group writes by design,\n152|// while a plain 0777 or 0770 admits an unsafe rename.\n153|func writableByOthers(info os.FileInfo) bool {\n154|\tperm := info.Mode().Perm()\n155|\tif perm&0o022 == 0 {\n156|\t\treturn false\n157|\t}\n158|\treturn info.Mode()&os.ModeSticky == 0\n159|}\n160|\n161|// checkCustodySocket gates the socket path itself: absence is bindable,\n162|// a socket is unlinkable-before-bind, and any other kind refuses so\n163|// the stale-unlink step can never remove a non-socket.\n164|func checkCustodySocket(socket string) error {\n165|\tinfo, err := os.Lstat(socket)\n166|\tif err != nil {\n167|\t\tif os.IsNotExist(err) {\n168|\t\t\treturn nil\n169|\t\t}\n170|\t\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket kind\"}\n171|\t}\n172|\tif info.Mode().Type() != os.ModeSocket {\n173|\t\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket kind\"}\n174|\t}\n175|\treturn nil\n176|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c783","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":540,"recorded_at":1780531400001075,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"call_id":"call_01a0c6daca8474428203087d48deb652","text":"Read text file `internal/tmuxserver/probe.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"errors\"\n6|\t\"net\"\n7|\t\"os\"\n8|\t\"syscall\"\n9|\t\"time\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n14|)\n15|\n16|// DialOutcome is one unix-socket dial verdict: the socket answers, the\n17|// socket is stale (connection refused: no listener), or the dial\n18|// proves nothing (any other failure). Liveness is decided by connect,\n19|// never by parsing daemon stderr: no gate here inspects source text.\n20|type DialOutcome string\n21|\n22|// Dial outcomes.\n23|const (\n24|\tDialLive    DialOutcome = \"live\"\n25|\tDialStale   DialOutcome = \"stale\"\n26|\tDialUnknown DialOutcome = \"unknown\"\n27|)\n28|\n29|// Dialer dials the dedicated socket and reports the outcome. The\n30|// production dialer connects over unix with a short timeout; tests\n31|// inject fakes. A live outcome never proves attestation — only that a\n32|// listener answers — and a stale outcome never proves absence of all\n33|// servers, only that this socket has no listener.\n34|type Dialer interface {\n35|\tDial(socket string) DialOutcome\n36|}\n37|\n38|// UnixDialer is the production Dialer.\n39|type UnixDialer struct {\n40|\t// Timeout bounds one dial. Zero means one second.\n41|\tTimeout time.Duration\n42|}\n43|\n44|// Dial connects to socket over unix: success is live; ECONNREFUSED or\n45|// ENOENT is stale; every other failure (timeout, permission,\n46|// impossible length) is unknown. ENOENT is stale rather than unknown\n47|// because the caller length-gates and custody-checks first: under a\n48|// verified parent, a missing socket proves no bind, not a broken\n49|// tree. This function dials only.\n50|func (dialer UnixDialer) Dial(socket string) DialOutcome {\n51|\ttimeout := dialer.Timeout\n52|\tif timeout <= 0 {\n53|\t\ttimeout = time.Second\n54|\t}\n55|\tconn, err := net.DialTimeout(\"unix\", socket, timeout)\n56|\tif err == nil {\n57|\t\t_ = conn.Close()\n58|\t\treturn DialLive\n59|\t}\n60|\tvar errno syscall.Errno\n61|\tif errors.As(err, &errno) && (errno == syscall.ECONNREFUSED || errno == syscall.ENOENT) {\n62|\t\treturn DialStale\n63|\t}\n64|\treturn DialUnknown\n65|}\n66|\n67|// AdmitServer is the server attestation verdict over the exact live\n68|// socket: the landed Reconcile admission the probe binds to the\n69|// request generation. Production wires terminalbackend.Reconcile over\n70|// the caller-supplied Manifest, Probe, evidence, generation, clock,\n71|// and signature verifier; tests inject verdicts directly.\n72|type AdmitServer func() (RealmAdmission, error)\n73|\n74|// ReconcileAdmission closes AdmitServer over the landed admission:\n75|// manifest, probe, evidence, the AX-known raw generation, the\n76|// admission instant, and the trusted-registry signature verifier. A\n77|// nil verifier fails closed inside Reconcile, never here.\n78|func ReconcileAdmission(manifest terminalbackend.Manifest, probe terminalbackend.Probe, evidence []terminalbackend.Evidence, rawGeneration string, now time.Time, verify terminalbackend.SignatureVerifier) AdmitServer {\n79|\treturn func() (RealmAdmission, error) {\n80|\t\tadmitted, err := terminalbackend.Reconcile(manifest, probe, evidence, rawGeneration, now, verify)\n81|\t\tif err != nil {\n82|\t\t\treturn RealmAdmission{}, err\n83|\t\t}\n84|\t\treturn RealmAdmission{Admitted: admitted, RawGeneration: rawGeneration}, nil\n85|\t}\n86|}\n87|\n88|// ServerProber is the production ProbeServer dependency: custody,\n89|// length, dial, then admission. Before connect it enforces the\n90|// before-connect custody rejection and the sun_path length refusal; a\n91|// live socket reports the admission verdict, a stale socket reports\n92|// not-running, and an unknown dial passes through as unknown (never\n93|// unavailable, never absent).\n94|type ServerProber struct {\n95|\t// Root is the Runtime IPC root the socket must sit under.\n96|\tRoot string\n97|\t// Platform selects the sun_path limit.\n98|\tPlatform scalar.Platform\n99|\t// Dialer connects to the socket. Nil refuses: no probe runs\n100|\t// without its dependency.\n101|\tDialer Dialer\n102|\t// Admit reports the landed admission verdict. Nil refuses.\n103|\tAdmit AdmitServer\n104|}\n105|\n106|// Probe implements Dependencies.ProbeServer.\n107|func (prober ServerProber) Probe(socket string) (ServerReport, error) {\n108|\tif prober.Dialer == nil || prober.Admit == nil {\n109|\t\treturn ServerReport{}, &Error{Code: CodeInvalidArguments, Detail: \"probe dependencies\"}\n110|\t}\n111|\tif err := CheckSocketLength(socket, prober.Platform); err != nil {\n112|\t\treturn ServerReport{}, err\n113|\t}\n114|\tif err := CheckSocketCustody(socket, prober.Root, prober.Platform); err != nil {\n115|\t\treturn ServerReport{}, err\n116|\t}\n117|\tswitch prober.Dialer.Dial(socket) {\n118|\tcase DialStale:\n119|\t\treturn ServerReport{Running: false}, nil\n120|\tcase DialUnknown:\n121|\t\treturn ServerReport{}, &Error{Code: CodeSpawnFailed, Detail: \"server probe\"}\n122|\tcase DialLive:\n123|\t\tadmission, err := prober.Admit()\n124|\t\tif err != nil {\n125|\t\t\treturn ServerReport{}, err\n126|\t\t}\n127|\t\treturn ServerReport{Running: true, Admission: admission}, nil\n128|\tdefault:\n129|\t\treturn ServerReport{}, &Error{Code: CodeSpawnFailed, Detail: \"server probe\"}\n130|\t}\n131|}\n132|\n133|// BrokerProber is the production ProbeBroker dependency. No Aqua broker\n134|// IPC exists in the tree, so the production probe reports the miss:\n135|// the zero report (no authenticated principal, no attested server),\n136|// which the broker-or-refuse rule maps to the typed\n137|// capability_unavailable. Contacting a broker is MAY in the spec, so\n138|// an honest miss is compliant; the broker path stays reachable through\n139|// injected Dependencies (proven by the acquisition suite), and a\n140|// future broker-IPC task owns the transport. This bound is stated, not\n141|// silent: Probe documents it on every call site.\n142|type BrokerProber struct{}\n143|\n144|// Probe implements Dependencies.ProbeBroker by reporting no broker.\n145|func (BrokerProber) Probe() (BrokerReport, error) {\n146|\treturn BrokerReport{}, nil\n147|}\n148|\n149|// SpawnHooks arms the crash boundary of the spawn commit. AfterUnlink\n150|// runs after a stale socket is unlinked and before the server is\n151|// spawned — only when a stale file was actually removed — so a crash\n152|// there leaves a retry that binds clean. Hooks is nil in production.\n153|type SpawnHooks struct {\n154|\tAfterUnlink func(socket string)\n155|}\n156|\n157|// ServerSpawner is the production Dependencies.Spawn dependency: the\n158|// bind step. Before bind it enforces the length refusal, the\n159|// before-bind custody rejection, and the exec-site socket pin (the\n160|// argv must address exactly this socket — the second side of the pin\n161|// gate whose first side is BuildCommand/BuildArgv); then it unlinks a\n162|// stale socket, if any, and spawns through the runner. A crash between\n163|// unlink and spawn leaves no socket behind, so a retry binds clean.\n164|type ServerSpawner struct {\n165|\t// Root is the Runtime IPC root the socket must sit under.\n166|\tRoot string\n167|\t// Platform selects the sun_path limit.\n168|\tPlatform scalar.Platform\n169|\t// Runner executes the spawn vector. Nil refuses.\n170|\tRunner Runner\n171|\t// Hooks arms the crash boundary. Nil in production.\n172|\tHooks *SpawnHooks\n173|}\n174|\n175|// Spawn implements Dependencies.Spawn.\n176|func (spawner ServerSpawner) Spawn(socket string, argv []string) error {\n177|\tif spawner.Runner == nil {\n178|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"spawn dependencies\"}\n179|\t}\n180|\tif err := CheckSocketLength(socket, spawner.Platform); err != nil {\n181|\t\treturn err\n182|\t}\n183|\tif err := CheckSocketCustody(socket, spawner.Root, spawner.Platform); err != nil {\n184|\t\treturn err\n185|\t}\n186|\tif err := checkSpawnAddresses(argv, socket); err != nil {\n187|\t\treturn err\n188|\t}\n189|\tremoved, err := unlinkStaleSocket(socket)\n190|\tif err != nil {\n191|\t\treturn err\n192|\t}\n193|\tif removed && spawner.Hooks != nil && spawner.Hooks.AfterUnlink != nil {\n194|\t\tspawner.Hooks.AfterUnlink(socket)\n195|\t}\n196|\tresult, err := spawner.Runner.Run(context.Background(), argv)\n197|\tif err != nil {\n198|\t\treturn &Error{Code: CodeSpawnFailed, Detail: \"server spawn\"}\n199|\t}\n200|\tif result.ExitCode != 0 {\n201|\t\treturn &Error{Code: CodeSpawnFailed, Detail: \"server spawn\"}\n202|\t}\n203|\treturn nil\n204|}\n205|\n206|// checkSpawnAddresses is the exec-site socket pin: the spawn vector\n207|// must be a tmux -S vector addressing exactly this socket. A vector\n208|// for any other socket — however it was built — refuses here instead\n209|// of spawning a substituted server. The argv shape gate runs first so\n210|// a malformed vector reports the shape refusal, not the pin.\n211|func checkSpawnAddresses(argv []string, socket string) error {\n212|\tif err := secprim.CheckArgv(argv); err != nil {\n213|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"spawn argv\"}\n214|\t}\n215|\tif len(argv) < 3 || argv[0] != \"tmux\" || argv[1] != \"-S\" || argv[2] != socket {\n216|\t\treturn &Error{Code: CodeAmbientReuse, Detail: \"spawn socket\"}\n217|\t}\n218|\treturn nil\n219|}\n220|\n221|// unlinkStaleSocket removes a stale socket file before bind and reports\n222|// whether it removed one. Custody already proved the path is absent or\n223|// a socket; anything else refuses instead of unlinking. Absence is a\n224|// no-op: bind proceeds.\n225|func unlinkStaleSocket(socket string) (bool, error) {\n226|\tinfo, err := os.Lstat(socket)\n227|\tif err != nil {\n228|\t\tif os.IsNotExist(err) {\n229|\t\t\treturn false, nil\n230|\t\t}\n231|\t\treturn false, &Error{Code: CodeSpawnFailed, Detail: \"server spawn\"}\n232|\t}\n233|\tif info.Mode().Type() != os.ModeSocket {\n234|\t\treturn false, &Error{Code: CodeUnsafeSocketPath, Detail: \"socket kind\"}\n235|\t}\n236|\tif err := os.Remove(socket); err != nil {\n237|\t\treturn false, &Error{Code: CodeSpawnFailed, Detail: \"server spawn\"}\n238|\t}\n239|\treturn true, nil\n240|}\n241|\n242|// Production wires the production exec/probe adapters into the\n243|// acquisition Dependencies: the server prober (custody, length, dial,\n244|// landed admission), the broker miss, and the bind-step spawner. The\n245|// caller supplies the runtime root, platform, runner, dialer, and\n246|// admission verdict; tests inject fakes for the runner and dialer and\n247|// drive every gate deterministically with no tmux process anywhere.\n248|func Production(root string, platform scalar.Platform, runner Runner, dialer Dialer, admit AdmitServer) Dependencies {\n249|\tprober := ServerProber{Root: root, Platform: platform, Dialer: dialer, Admit: admit}\n250|\tspawner := ServerSpawner{Root: root, Platform: platform, Runner: runner}\n251|\treturn Dependencies{\n252|\t\tProbeServer: prober.Probe,\n253|\t\tProbeBroker: BrokerProber{}.Probe,\n254|\t\tSpawn:       spawner.Spawn,\n255|\t}\n256|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c785","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":541,"recorded_at":1780531400001077,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"call_id":"call_01a0c6dacc6b73568fe29ee2452aabd3","text":"Read text file `internal/tmuxserver/status.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"sort\"\n6|\t\"strconv\"\n7|\t\"strings\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n12|)\n13|\n14|// ObserveStatus reports the tmux observation for one status body: the\n15|// live probe (list-panes for presence and provider rows, list-sessions\n16|// for attached counts) reconciled against the AX-side state memory. An\n17|// error is unknown, never absent: transport failures, malformed probe\n18|// output, and contradictory probes all refuse without a report.\n19|func (runner *backend) ObserveStatus(ctx context.Context, body terminstance.StatusBody) (terminstance.StatusObservation, error) {\n20|\tempty := terminstance.StatusObservation{}\n21|\tinstance := body.TerminalInstanceID\n22|\tif !body.HasTerminalInstanceID {\n23|\t\tresolved, err := runner.resolveSessionInstance(body.SessionID)\n24|\t\tif err != nil {\n25|\t\t\treturn empty, err\n26|\t\t}\n27|\t\tif resolved == \"\" {\n28|\t\t\treturn runner.absentObservation(body), nil\n29|\t\t}\n30|\t\tinstance = resolved\n31|\t}\n32|\tpresent, panes, err := runner.probePanes(ctx, instance)\n33|\tif err != nil {\n34|\t\treturn empty, err\n35|\t}\n36|\tattached := 0\n37|\tif present {\n38|\t\tcount, err := runner.probeAttached(ctx, instance)\n39|\t\tif err != nil {\n40|\t\t\treturn empty, err\n41|\t\t}\n42|\t\tattached = count\n43|\t}\n44|\tmemory, found, err := runner.lookupMemory(instance)\n45|\tif err != nil {\n46|\t\treturn empty, err\n47|\t}\n48|\tstate, wrapper, provider, attachable := ClassifyStatus(ClassifyInput{\n49|\t\tPresent:         present,\n50|\t\tAttached:        attached,\n51|\t\tProviderRows:    len(panes),\n52|\t\tMemory:          memory,\n53|\t\tMemoryFound:     found,\n54|\t\tAttachCapable:   runner.attachCapable(),\n55|\t\tProviderWanted:  body.IncludeProviderObservation,\n56|\t\tProviderCapable: runner.admitted.Has(\"provider_process_observation\"),\n57|\t})\n58|\tproviderPresent, requested, evidenced := providerTriple(body.IncludeProviderObservation, runner.admitted.Has(\"provider_process_observation\"), provider)\n59|\tevidence := statusEvidence(instance, present, panes, attached)\n60|\treturn terminstance.StatusObservation{\n61|\t\tState:             state,\n62|\t\tIdentityMatch:     true,\n63|\t\tWrapperPresent:    wrapper,\n64|\t\tProviderPresent:   providerPresent,\n65|\t\tAttachable:        attachable,\n66|\t\tEvidenceIDs:       evidence,\n67|\t\tProviderRequested: requested,\n68|\t\tProviderEvidenced: evidenced,\n69|\t\tAttachEvidenced:   attachable,\n70|\t\tSessionID:         body.SessionID,\n71|\t\tInstanceID:        instance,\n72|\t\tBackendID:         body.TerminalBackendID,\n73|\t\tImplVersion:       body.ImplementationVersion,\n74|\t\tProtoVersion:      body.ProtocolVersion,\n75|\t\tGeneration:        body.BackendGeneration,\n76|\t}, nil\n77|}\n78|\n79|// resolveSessionInstance resolves a session-scoped query to the\n80|// session's recorded instance through the bootstrap binding store. An\n81|// unbound session resolves empty: it reads absent, never refused. A\n82|// binding read failure is unknown, never absence.\n83|func (runner *backend) resolveSessionInstance(sessionID string) (string, error) {\n84|\tif runner.bindings == nil {\n85|\t\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend binding store\"}\n86|\t}\n87|\tbinding, found, err := runner.bindings.Status(sessionID)\n88|\tif err != nil {\n89|\t\treturn \"\", err\n90|\t}\n91|\tif !found {\n92|\t\treturn \"\", nil\n93|\t}\n94|\treturn binding.TerminalInstanceID, nil\n95|}\n96|\n97|// absentObservation reports proven absence for an unbound session: the\n98|// absent shape with the queried session echoed, so the engine adopts a\n99|// match on the session it asked about and nothing else.\n100|func (runner *backend) absentObservation(body terminstance.StatusBody) terminstance.StatusObservation {\n101|\treturn terminstance.StatusObservation{\n102|\t\tState:             terminalbackend.StateAbsent,\n103|\t\tIdentityMatch:     true,\n104|\t\tWrapperPresent:    false,\n105|\t\tProviderPresent:   nil,\n106|\t\tAttachable:        false,\n107|\t\tEvidenceIDs:       []string{scalar.SHA256Digest([]byte(\"unbound\\n\" + body.SessionID)).String()},\n108|\t\tProviderRequested: body.IncludeProviderObservation,\n109|\t\tProviderEvidenced: false,\n110|\t\tAttachEvidenced:   false,\n111|\t\tSessionID:         body.SessionID,\n112|\t\tInstanceID:        body.TerminalInstanceID,\n113|\t\tBackendID:         body.TerminalBackendID,\n114|\t\tImplVersion:       body.ImplementationVersion,\n115|\t\tProtoVersion:      body.ProtocolVersion,\n116|\t\tGeneration:        body.BackendGeneration,\n117|\t}\n118|}\n119|\n120|// probePanes runs list-panes for one instance: exit 0 with at least one\n121|// row proves presence; any other exit proves absence of the session\n122|// (no stderr is parsed: the exit code is the verdict); a transport\n123|// error is unknown. An exit-0 with zero rows is contradictory — a tmux\n124|// session always has a pane — and refuses as unknown rather than\n125|// inventing presence.\n126|func (runner *backend) probePanes(ctx context.Context, instance string) (bool, []string, error) {\n127|\tsaved := runner.instanceID\n128|\trunner.instanceID = instance\n129|\tdefer func() { runner.instanceID = saved }()\n130|\targv, err := runner.command(DirectiveListPanes)\n131|\tif err != nil {\n132|\t\treturn false, nil, err\n133|\t}\n134|\tresult, err := runner.runner.Run(ctx, argv)\n135|\tif err != nil {\n136|\t\treturn false, nil, err\n137|\t}\n138|\tif result.ExitCode != 0 {\n139|\t\treturn false, nil, nil\n140|\t}\n141|\trows := splitRows(string(result.Stdout))\n142|\tif len(rows) == 0 {\n143|\t\treturn false, nil, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n144|\t}\n145|\treturn true, rows, nil\n146|}\n147|\n148|// probeAttached reads the attached-client count for one present\n149|// instance from list-sessions. A missing row contradicts the presence\n150|// probe (the session vanished between the two commands, or the list is\n151|// corrupt) and refuses as unknown; a malformed count refuses the same\n152|// way. Neither invents attachability.\n153|func (runner *backend) probeAttached(ctx context.Context, instance string) (int, error) {\n154|\targv, err := runner.command(DirectiveListSessions)\n155|\tif err != nil {\n156|\t\treturn 0, err\n157|\t}\n158|\tresult, err := runner.runner.Run(ctx, argv)\n159|\tif err != nil {\n160|\t\treturn 0, err\n161|\t}\n162|\tif result.ExitCode != 0 {\n163|\t\treturn 0, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n164|\t}\n165|\tfor _, row := range splitRows(string(result.Stdout)) {\n166|\t\tname, count, ok := cutRow(row)\n167|\t\tif !ok {\n168|\t\t\treturn 0, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n169|\t\t}\n170|\t\tif name != instance {\n171|\t\t\tcontinue\n172|\t\t}\n173|\t\tattached, err := strconv.Atoi(count)\n174|\t\tif err != nil || attached < 0 {\n175|\t\t\treturn 0, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n176|\t\t}\n177|\t\treturn attached, nil\n178|\t}\n179|\treturn 0, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n180|}\n181|\n182|// lookupMemory reads the AX-side state memory for one instance. The\n183|// store may be nil in unit-scoped backends; a nil store reads as no\n184|// memory rather than refusing, because presence alone still classifies\n185|// the live triad (absent/parked/active).\n186|func (runner *backend) lookupMemory(instance string) (terminalbackend.InstanceState, bool, error) {\n187|\tif runner.states == nil {\n188|\t\treturn \"\", false, nil\n189|\t}\n190|\treturn runner.states.Lookup(instance)\n191|}\n192|\n193|// attachCapable reports whether any admitted attach capability\n194|// evidences presentation right now: local, remote, or web attach.\n195|func (runner *backend) attachCapable() bool {\n196|\treturn runner.admitted.Has(\"local_attach\") ||\n197|\t\trunner.admitted.Has(\"remote_attach\") ||\n198|\t\trunner.admitted.Has(\"web_attach\")\n199|}\n200|\n201|// providerTriple computes the provider_present member and its two\n202|// validation flags: the member is non-null only when observation was\n203|// requested and evidenced; the flags let the landed CheckStatusResult\n204|// verify that rule.\n205|func providerTriple(requested, capable, observed bool) (*bool, bool, bool) {\n206|\tif !requested || !capable {\n207|\t\treturn nil, requested, false\n208|\t}\n209|\tif !observed {\n210|\t\treturn nil, requested, false\n211|\t}\n212|\tpresent := true\n213|\treturn &present, requested, true\n214|}\n215|\n216|// statusEvidence derives the sorted-unique status evidence digests over\n217|// the probe record: presence, pane rows, and attached count. Absence\n218|// evidences the negative probe, never an empty set.\n219|func statusEvidence(instance string, present bool, panes []string, attached int) []string {\n220|\tvar evidence []string\n221|\tif !present {\n222|\t\tevidence = append(evidence, scalar.SHA256Digest([]byte(\"absent\\n\"+instance)).String())\n223|\t} else {\n224|\t\tevidence = append(evidence, scalar.SHA256Digest([]byte(\"panes\\n\"+instance+\"\\n\"+strings.Join(panes, \"\\n\"))).String())\n225|\t\tevidence = append(evidence, scalar.SHA256Digest([]byte(\"sessions\\n\"+instance+\"\\n\"+strconv.Itoa(attached))).String())\n226|\t}\n227|\tsort.Strings(evidence)\n228|\treturn evidence\n229|}\n230|\n231|// splitRows splits probe stdout into non-empty rows. Blank lines are\n232|// skipped: tmux never emits them, and skipping is the tolerant read;\n233|// a wholly blank output yields zero rows, which the callers refuse.\n234|func splitRows(output string) []string {\n235|\tvar rows []string\n236|\tfor _, line := range strings.Split(output, \"\\n\") {\n237|\t\tif line != \"\" {\n238|\t\t\trows = append(rows, line)\n239|\t\t}\n240|\t}\n241|\treturn rows\n242|}\n243|\n244|// cutRow splits one sessions row into name and attached count. Rows\n245|// without the pipe separator are malformed.\n246|func cutRow(row string) (string, string, bool) {\n247|\tname, count, found := strings.Cut(row, \"|\")\n248|\tif !found || name == \"\" || count == \"\" {\n249|\t\treturn \"\", \"\", false\n250|\t}\n251|\treturn name, count, true\n252|}\n253|\n254|// ClassifyInput is the pure status-classification input: the live tmux\n255|// probe (presence, attached count, provider rows) plus the AX-side\n256|// memory and the capability facts.\n257|type ClassifyInput struct {\n258|\tPresent         bool\n259|\tAttached        int\n260|\tProviderRows    int\n261|\tMemory          terminalbackend.InstanceState\n262|\tMemoryFound     bool\n263|\tAttachCapable   bool\n264|\tProviderWanted  bool\n265|\tProviderCapable bool\n266|\t_               struct{}\n267|}\n268|\n269|// ClassifyStatus reconciles the live tmux probe against the AX-side\n270|// state memory into the adopted status: state, wrapper presence,\n271|// provider presence, and attachability. tmux reports only presence;\n272|// the memory carries quiescing, stopped, and stale_fenced, which exist\n273|// only on this side. The rules:\n274|//\n275|//   - absent probe, no memory (or memory absent): absent, no wrapper;\n276|//   - absent probe, memory stopped or stale_fenced: the memory state,\n277|//     no wrapper (a fenced incarnation keeps its fencing without a wrapper);\n278|//   - absent probe, memory quiescing/active/parked/unavailable: unavailable\n279|//     (contradiction: the wrapper vanished, or was never proven);\n280|//   - present probe, memory quiescing or stale_fenced: the memory state\n281|//     (tmux cannot show either; a fenced incarnation with a live wrapper\n282|//     is what terminate-stale kills);\n283|//   - present probe, memory stopped or unavailable: unavailable\n284|//     (contradiction: a session resurrected, or was never proven);\n285|//   - present probe, memory active/parked/absent/none: active when at\n286|//     least one client is attached, otherwise parked.\n287|//\n288|// Attachability needs parked|active plus a currently evidenced attach\n289|// capability; provider presence needs at least one pane row. Memory\n290|// creating is unreachable (Record refuses it) and classifies\n291|// unavailable either way.\n292|func ClassifyStatus(input ClassifyInput) (terminalbackend.InstanceState, bool, bool, bool) {\n293|\tif !input.Present {\n294|\t\treturn classifyAbsent(input)\n295|\t}\n296|\treturn classifyPresent(input)\n297|}\n298|\n299|// classifyAbsent adopts the state for an absent probe.\n300|func classifyAbsent(input ClassifyInput) (terminalbackend.InstanceState, bool, bool, bool) {\n301|\tif !input.MemoryFound || input.Memory == terminalbackend.StateAbsent {\n302|\t\treturn terminalbackend.StateAbsent, false, false, false\n303|\t}\n304|\tswitch input.Memory {\n305|\tcase terminalbackend.StateStopped, terminalbackend.StateStaleFenced:\n306|\t\treturn input.Memory, false, false, false\n307|\tdefault:\n308|\t\treturn terminalbackend.StateUnavailable, false, false, false\n309|\t}\n310|}\n311|\n312|// classifyPresent adopts the state for a present probe.\n313|func classifyPresent(input ClassifyInput) (terminalbackend.InstanceState, bool, bool, bool) {\n314|\tprovider := input.ProviderRows > 0\n315|\tswitch input.Memory {\n316|\tcase terminalbackend.StateQuiescing, terminalbackend.StateStaleFenced:\n317|\t\tif !input.MemoryFound {\n318|\t\t\tbreak\n319|\t\t}\n320|\t\treturn input.Memory, true, provider, false\n321|\tcase terminalbackend.StateStopped, terminalbackend.StateUnavailable:\n322|\t\tif !input.MemoryFound {\n323|\t\t\tbreak\n324|\t\t}\n325|\t\treturn terminalbackend.StateUnavailable, false, false, false\n326|\tcase terminalbackend.StateCreating:\n327|\t\treturn terminalbackend.StateUnavailable, false, false, false\n328|\tdefault:\n329|\t}\n330|\tstate := terminalbackend.StateParked\n331|\tif input.Attached > 0 {\n332|\t\tstate = terminalbackend.StateActive\n333|\t}\n334|\tattachable := input.AttachCapable && (state == terminalbackend.StateParked || state == terminalbackend.StateActive)\n335|\treturn state, true, provider, attachable\n336|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
