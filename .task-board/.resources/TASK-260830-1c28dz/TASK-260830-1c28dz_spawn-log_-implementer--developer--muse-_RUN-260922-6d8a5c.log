h-session\\n1286:.Ic attach-session ) .\\n\",\n  \"original_output_bytes\": 1057,\n  \"original_output_tokens\": 265,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
