OpOutcome{Operation: operation, Mutation: &result}, err\n217|\t}\n218|\tdeadline, err := mctx.Deadline.Time()\n219|\tif err != nil {\n220|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"mutation context deadline\"}\n221|\t}\n222|\tif !lc.Now().Before(deadline) {\n223|\t\tfailure := &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n224|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionReplaySame)\n225|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n226|\t}\n227|\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n228|\treqBackend.operation = operation\n229|\treqBackend.deadline = deadline\n230|\treturn lc.executeWithReceipt(ctx, req, socket, operation, mctx, source, target, effects, deadline, terminstance.AuthorizationForceStale, reqBackend, func(result terminstance.Result) OpOutcome {\n231|\t\treturn OpOutcome{Operation: operation, Mutation: &result, TargetClosed: true}\n232|\t})\n233|}\n234|\n235|// checkTerminateCapability enforces the dual conditional: stale\n236|// termination needs stale_process_termination AND\n237|// provider_process_observation. Each arm refuses alone.\n238|func checkTerminateCapability(admitted terminalbackend.Admitted) error {\n239|\tif !admitted.Has(\"stale_process_termination\") {\n240|\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n241|\t}\n242|\tif !admitted.Has(\"provider_process_observation\") {\n243|\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n244|\t}\n245|\treturn nil\n246|}\n247|\n248|// mapFencingError maps the landed terminate-stale authorization onto\n249|// the row's allowed set: malformed fencing material is the protocol\n250|// error, every other fencing refusal — no winner, no force, no\n251|// diagnostics, target mismatch, live owner — is the failed local\n252|// precondition. lease_conflict maps to the precondition too: the row\n253|// has no lease_conflict member, and a target fenced by another\n254|// session's winner fails the fenced-target precondition.\n255|func mapFencingError(err error) error {\n256|\tif err == nil {\n257|\t\treturn nil\n258|\t}\n259|\tif errors.Is(err, fencing.ErrInvalidArguments) {\n260|\t\treturn &Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminate fencing material\"}\n261|\t}\n262|\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate fencing authorization\"}\n263|}\n264|\n265|// checkTerminateTarget binds the presented fencing token to the\n266|// request: session, stale lease, and stale epoch must all agree with\n267|// the context and body. Any disagreement refuses the failed local\n268|// precondition: the retry would authorize a different target than the\n269|// key names.\n270|func checkTerminateTarget(mctx terminstance.MutationContext, body TerminateBody, presented fencing.PresentedToken) error {\n271|\tif presented.SessionID != mctx.SessionID ||\n272|\t\tpresented.LeaseID != body.StaleLeaseID ||\n273|\t\tpresented.Epoch != body.StaleEpoch {\n274|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate target binding\"}\n275|\t}\n276|\treturn nil\n277|}\n278|\n279|// checkTerminateWinner binds the caller-observed winner to the\n280|// re-read current lease: the fencing authorization decides over the\n281|// caller's winner, and only a winner that still wins authorizes. A\n282|// rotated or misobserved winner refuses the failed local\n283|// precondition; the caller re-observes and retries. Absence of a\n284|// winner never reaches here — the fencing gate refuses it first.\n285|func checkTerminateWinner(mctx terminstance.MutationContext, winner sessrepo.LeaseSummary, lease terminstance.LeaseView) error {\n286|\tif winner.SessionID != mctx.SessionID ||\n287|\t\twinner.LeaseID != lease.LeaseID ||\n288|\t\twinner.Ep