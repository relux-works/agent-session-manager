{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000db6d","stream":{"kind":"session","id":"01a0c6d9-138d-7c82-92f1-7d0657d57a0f"},"sequence":3089,"recorded_at":1780531400006173,"record_type":"event","durability":"durable","causation_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"69dcebcf-aab8-4829-be62-f7110c555cc6","run_stream":{"kind":"run","id":"69dcebcf-aab8-4829-be62-f7110c555cc6"},"task_stream":{"kind":"task","id":"01a0c6f7-1e88-7601-9cd7-8aa5c0b6ddce"},"task_id":"01a0c6f7-1e88-7601-9cd7-8aa5c0b6ddce","event":{"kind":"output","task_id":"01a0c6f7-1e88-7601-9cd7-8aa5c0b6ddce","chunk":"Read text file `internal/tmuxserver/backend_test.go`.\n(179 line(s) above)\n180|\t}\n181|}\n182|\n183|func TestPerformEffectStopTimeout(t *testing.T) {\n184|\trunner := newFakeRunner().\n185|\t\tqueue(\"has-session\", \"\", 0).\n186|\t\tqueue(\"kill-session\", \"\", 0).\n187|\t\tqueue(\"has-session\", \"\", 0)\n188|\treqBackend := effectBackend(t, terminalbackend.OperationRequestStop, runner)\n189|\treqBackend.deadline = lxNow().Add(-time.Minute)\n190|\tif _, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectProcessClosed); err == nil {\n191|\t\tt.Fatal(\"stubborn session closed\")\n192|\t} else {\n193|\t\trequireEngineCode(t, err, \"stop_timeout\")\n194|\t}\n195|}\n196|\n197|func TestPerformEffectStopEscalationKillFailure(t *testing.T) {\n198|\t// Live session plus a failed escalation kill: the coded process\n199|\t// failure, before any re-confirm — the kill did not prove the\n200|\t// incarnation dead.\n201|\trunner := newFakeRunner().\n202|\t\tqueue(\"has-session\", \"\", 0).\n203|\t\tqueue(\"kill-session\", \"\", 1).\n204|\t\tqueueFull(\"has-session\", \"\", \"can't find session: \" + lxInstance, 1)\n205|\treqBackend := effectBackend(t, terminalbackend.OperationRequestStop, runner)\n206|\treqBackend.deadline = lxNow().Add(-time.Minute)\n207|\tif _, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectProcessClosed); err == nil {\n208|\t\tt.Fatal(\"failed escalation kill closed\")\n209|\t} else {\n210|\t\trequireEngineCode(t, err, \"terminal_backend_process_failed\")\n211|\t}\n212|\tif got := runner.subcommands(); len(got) != 2 || got[1] != \"kill-session\" {\n213|\t\tt.Fatalf(\"calls = %v, want has-session then kill-session\", got)\n214|\t}\n215|}\n216|\n217|func TestPerformEffectBindingConflict(t *testing.T) {\n218|\t// A changed binding for the recorded pair is the landed mismatch,\n219|\t// mapped with the persist detail — never a silent re-record.\n220|\treqBackend := effectBackend(t, terminalbackend.OperationCreate, newFakeRunner())\n221|\tif _, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectBindingPersisted); err != nil {\n222|\t\tt.Fatal(err)\n223|\t}\n224|\treqBackend.bootstrapID = lxQuiesce\n225|\t_, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectBindingPersisted)\n226|\tif err == nil {\n227|\t\tt.Fatal(\"conflicting binding persisted\")\n228|\t}\n229|\tvar engine *terminstance.Error\n230|\tif !errors.As(err, &engine) {\n231|\t\tt.Fatalf(\"want *terminstance.Error, got %T (%v)\", err, err)\n232|\t}\n233|\tif engine.Code != \"idempotency_mismatch\" || engine.Detail != \"backend binding conflict\" {\n234|\t\tt.Fatalf(\"want mismatch at backend binding conflict, got %s at %s\", engine.Code, engine.Detail)\n235|\t}\n236|}\n237|\n238|func TestPerformEffectTerminateKill(t *testing.T) {\n239|\trunner := newFakeRunner().queue(\"kill-session\", \"\", 0)\n240|\treqBackend := effectBackend(t, terminalbackend.OperationTerminateStale, runner)\n241|\tid, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectStaleIncarnationTerminated)\n242|\tif err != nil {\n243|\t\tt.Fatal(err)\n244|\t}\n245|\trequireDigest(t, id)\n246|\t// The kill claimed the incarnation; the re-confirm proves absence.\n247|\trunner.queueFull(\"has-session\", \"\", \"can't find session: \" + lxInstance, 1)\n248|\tif _, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectProcessClosed); err != nil {\n249|\t\tt.Fatal(err)\n250|\t}\n251|}\n252|\n253|func TestPerformEffectTerminateSelfConfirms(t *testing.T) {\n254|\t// Failed kill plus absent session: terminated however it closed.\n255|\trunner := newFakeRunner().\n256|\t\tqueue(\"kill-session\", \"\", 1).\n257|\t\tqueueFull(\"has-session\", \"\", \"can't find session: \" + lxInstance, 1)\n258|\treqBackend := effectBackend(t, terminalbackend.OperationTerminateStale, runner)\n259|\tif _, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectStaleIncarnationTerminated); err != nil {\n260|\t\tt.Fatal(err)\n261|\t}\n262|}\n263|\n264|func TestPerformEffectTerminateLiveRefuses(t *testing.T) {\n265|\t// Failed kill plus live session: the process failure, both at the\n266|\t// self-confirm and (after a clean kill) at the re-confirm.\n267|\trunner := newFakeRunner().\n268|\t\tqueue(\"kill-session\", \"\", 1).\n269|\t\tqueue(\"has-session\", \"\", 0)\n270|\treqBackend := effectBackend(t, terminalbackend.OperationTerminateStale, runner)\n271|\tif _, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectStaleIncarnationTerminated); err == nil {\n272|\t\tt.Fatal(\"live session terminated\")\n273|\t} else {\n274|\t\trequireEngineCode(t, err, \"terminal_backend_process_failed\")\n275|\t}\n276|\trunner2 := newFakeRunner().\n277|\t\tqueue(\"kill-session\", \"\", 0).\n278|\t\tqueue(\"has-session\", \"\", 0)\n279|\treqBackend2 := effectBackend(t, terminalbackend.OperationTerminateStale, runner2)\n280|\treqBackend2.deadline = lxNow().Add(-time.Minute)\n281|\tif _, err := reqBackend2.PerformEffect(context.Background(), terminalbackend.EffectStaleIncarnationTerminated); err != nil {\n282|\t\tt.Fatal(err)\n283|\t}\n284|\tif _, err := reqBackend2.PerformEffect(context.Background(), terminalbackend.EffectProcessClosed); err == nil {\n285|\t\tt.Fatal(\"resurrected session closed\")\n286|\t} else {\n287|\t\trequireEngineCode(t, err, \"terminal_backend_process_failed\")\n288|\t}\n289|}\n290|\n291|func TestPerformEffectTerminateReconfirmRefusesFailedKill(t *testing.T) {\n292|\t// Failed kill plus live session at the re-confirm: the recorded\n293|\t// failed-kill member refuses exactly like the clean-kill member —\n294|\t// the kill claimed the incarnation and it still answers.\n295|\trunner := newFakeRunner().\n296|\t\tqueue(\"kill-session\", \"\", 1).\n297|\t\tqueue(\"has-session\", \"\", 0).\n298|\t\tqueue(\"has-session\", \"\", 0)\n299|\treqBackend := effectBackend(t, terminalbackend.OperationTerminateStale, runner)\n300|\treqBackend.deadline = lxNow().Add(-time.Minute)\n301|\tif _, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectStaleIncarnationTerminated); err == nil {\n302|\t\tt.Fatal(\"live session terminated at self-confirm\")\n303|\t} else {\n304|\t\trequireEngineCode(t, err, \"terminal_backend_process_failed\")\n305|\t}\n306|\tif _, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectProcessClosed); err == nil {\n307|\t\tt.Fatal(\"live session closed after failed kill\")\n308|\t} else {\n309|\t\trequireEngineCode(t, err, \"terminal_backend_process_failed\")\n310|\t}\n311|}\n312|\n313|func TestPerformEffectNilStoresRefuse(t *testing.T) {\n314|\t// The durable effects fail closed without their stores: a missing\n315|\t// binding store or attach store is a local wiring refusal, never a\n316|\t// silent no-op.\n317|\tpersist := effectBackend(t, terminalbackend.OperationCreate, newFakeRunner())\n318|\tpersist.bindings = nil\n319|\tif _, err := persist.PerformEffect(context.Background(), terminalbackend.EffectBindingPersisted); err == nil {\n320|\t\tt.Fatal(\"persist without store committed\")\n321|\t}\n322|\tclient := effectBackend(t, terminalbackend.OperationAttach, newFakeRunner())\n323|\tclient.attach = nil\n324|\tif _, err := client.PerformEffect(context.Background(), terminalbackend.EffectAttachClientCreated); err == nil {\n325|\t\tt.Fatal(\"attach without store committed\")\n326|\t}\n327|}\n328|\n329|func TestPerformEffectStoreClosedIsLocal(t *testing.T) {\n330|\trunner := newFakeRunner()\n331|\treqBackend := effectBackend(t, terminalbackend.OperationRequestStop, runner)\n332|\tid, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectBackendStoreClosed)\n333|\tif err != nil {\n334|\t\tt.Fatal(err)\n335|\t}\n336|\trequireDigest(t, id)\n337|\tif runner.callCount() != 0 {\n338|\t\tt.Fatalf(\"local effect execed %d commands\", runner.callCount())\n339|\t}\n340|}\n341|\n342|func TestPerformEffectRefusesUnknownVocabulary(t *testing.T) {\n343|\treqBackend := effectBackend(t, terminalbackend.OperationCreate, newFakeRunner())\n344|\tif _, err := reqBackend.PerformEffect(context.Background(), \"server_rebooted\"); err == nil {\n345|\t\tt.Fatal(\"unknown effect committed\")\n346|\t} else {\n347|\t\trequireEngineCode(t, err, \"terminal_backend_protocol_error\")\n348|\t}\n349|}\n350|\n351|func TestPerformEffectAttachClient(t *testing.T) {\n352|\treqBackend := effectBackend(t, terminalbackend.OperationAttach, newFakeRunner())\n353|\treqBackend.clientID = lxClient\n354|\treqBackend.transport = \"local_only\"\n355|\treqBackend.input = true\n356|\tauth, err := parseAttachBody(lxAttachBody(t, nil))\n357|\tif err != nil {\n358|\t\tt.Fatal(err)\n359|\t}\n360|\treqBackend.authRaw = auth.AuthRaw\n361|\tid, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectAttachClientCreated)\n362|\tif err != nil {\n363|\t\tt.Fatal(err)\n364|\t}\n365|\trequireDigest(t, id)\n366|\t// Identical retry replays; conflicting retry mismatches.\n367|\tif _, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectAttachClientCreated); err != nil {\n368|\t\tt.Fatalf(\"replay: %v\", err)\n369|\t}\n370|\t// A conflicting retry carries matching authorization for the new\n371|\t// input boolean (the store rechecks auth before the conflict arm).\n372|\tfalseAuth, err := parseAttachBody(lxAttachBody(t, func(object map[string]any) {\n373|\t\tobject[\"input_authorized\"] = false\n374|\t\tobject[\"authorization\"] = lxAttachAuth(\"local_only\", false)\n375|\t}))\n376|\tif err != nil {\n377|\t\tt.Fatal(err)\n378|\t}\n379|\treqBackend.input = false\n380|\treqBackend.authRaw = falseAuth.AuthRaw\n381|\tif _, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectAttachClientCreated); err == nil {\n382|\t\tt.Fatal(\"conflicting attach committed\")\n383|\t} else {\n384|\t\trequireEngineCode(t, err, \"idempotency_mismatch\")\n385|\t}\n386|}","final_result":true}}}
