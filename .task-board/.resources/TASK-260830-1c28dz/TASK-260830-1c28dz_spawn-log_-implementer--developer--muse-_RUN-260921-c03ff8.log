ctiveHasSession},\n28|\tterminalbackend.OperationRestore:          {DirectiveNewSession},\n29|}\n30|\n31|// DirectivesFor reports the fixed tmux directive sequence for one\n32|// lifecycle operation. Manifest and probe are not lifecycle operations\n33|// and refuse; every other unknown operation refuses as well.\n34|func DirectivesFor(operation terminalbackend.Operation) ([]Directive, error) {\n35|\tdirectives, known := operationDirectives[operation]\n36|\tif !known {\n37|\t\treturn nil, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle operation\"}\n38|\t}\n39|\treturn append([]Directive(nil), directives...), nil\n40|}\n41|\n42|// backend is the tmux terminstance.Backend: side-effect execution and\n43|// status observation over the structured commands. It is\n44|// request-scoped — one backend per Execute call — because effects\n45|// carry no identity of their own and the runner, socket, stores, and\n46|// admission are per-request facts.\n47|type backend struct {\n48|\trunner      Runner\n49|\truntimeDir  string\n50|\tsocket      string\n51|\toperation   terminalbackend.Operation\n52|\tsessionID   string\n53|\tinstanceID  string\n54|\tbootstrapID string\n55|\tbindingID   string\n56|\tchannel     string\n57|\tquiescence  string\n58|\twaitCtx     context.Context\n59|\tdeadline    time.Time\n60|\tnow         func() time.Time\n61|\tsleep       func(time.Duration)\n62|\tpoll        time.Duration\n63|\tadmitted    terminalbackend.Admitted\n64|\tbindings    *axpane.Store\n65|\tattach      *termbind.AttachStore\n66|\tstates      *InstanceStates\n67|\ttransport   string\n68|\tinput       bool\n69|\tauthRaw     []byte\n70|\tclientID    string\n71|\t// killExit records the stale-kill exit for the close re-confirm:\n72|\t// a live session after a clean kill and a live session after a\n73|\t// failed kill refuse through the same arm, and the recorded exit\n74|\t// is the member split the narrowing mutant admits exactly one of.\n75|\t// -1 means no kill ran yet on this backend.\n76|\tkillExit int\n77|}\n78|\n79|// effectEvidence derives one evidence digest over the canonical effect\n80|// record: effect name, operation, instance, and outcome facts. The join\n81|// is deterministic; nothing parses it back.\n82|func effectEvidence(effect terminalbackend.SideEffect, operation terminalbackend.Operation, instance string, facts ...string) string {\n83|\trecord := strings.Join(append([]string{string(effect), string(operation), instance}, facts...), \"\\n\")\n84|\treturn scalar.SHA256Digest([]byte(record)).String()\n85|}\n86|\n87|// PerformEffect executes one side effect and reports its evidence ID.\n88|// A nil error proves the commit; a coded error proves the backend\n89|// refused before committing; any other error proves nothing. Every\n90|// tmux command runs through BuildCommand, so no effect addresses any\n91|// server but the derived socket.\n92|func (runner *backend) PerformEffect(ctx context.Context, effect terminalbackend.SideEffect) (string, error) {\n93|\tswitch effect {\n94|\tcase terminalbackend.EffectBindingPersisted:\n95|\t\treturn runner.persistBinding()\n96|\tcase terminalbackend.EffectWrapperStarted:\n97|\t\treturn runner.startWrapper(ctx, terminalbackend.EffectWrapperStarted)\n98|\tcase terminalbackend.EffectAttachClientCreated:\n99|\t\treturn runner.createAttachClient()\n100|\tcase terminalbackend.EffectInputClosed:\n101|\t\treturn runner.execEvidence(ctx, DirectiveLockSession, terminalbackend.EffectInputClosed)\n102|\tcase terminalbackend.EffectSafeBoundaryObserved:\n103|\t\treturn runner.observeBoundary()\n104|\tcase terminalbackend.EffectGracefulStopRequested:\n105|\t\treturn runner.execEvidence(ctx, DirectiveSendInterrupt, terminalbackend.EffectGracefulStopRequested)\n106|\tcase terminalbackend.EffectProcessClosed:\n107|\t\treturn runner.confirmClosed(ctx)\n108|\tcase terminalbackend.EffectBackendStoreClosed:\n109|\t\treturn effectEvidence(effect, runner.operation, runner.instanceID, \"tmux-side closes done\"), nil\n110|\tcase terminalbackend.EffectStaleIncarnationTerminated:\n111|\t\treturn runner.terminateStale(ctx)\n112|\tcase terminalbackend.EffectWrapperRestored:\n113|\t\treturn runner.startWrapper(ctx, terminalbackend.EffectWrapperRestored)\n114|\tdefault:\n115|\t\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend effect vocabulary\"}\n116|\t}\n117|}\n118|\n119|// persistBinding records the bootstrap binding for the create/restore\n120|// pair. A changed operation in the bootstrap window refuses the landed\n121|// idempotency_mismatch; an identical retry replays the one receipt.\n122|func (runner *backend) persistBinding() (string, error) {\n123|\tif runner.bindings == nil {\n124|\t\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend binding store\"}\n125|\t}\n126|\trecorded, _, err := runner.bindings.Bind(runner.sessionID, runner.bootstrapID, axpane.Binding{\n127|\t\tSessionID:          runner.sessionID,\n128|\t\tOperationID:        runner.bootstrapID,\n129|\t\tTerminalInstanceID: runner.instanceID,\n130|\t\tBindingDigest:      runner.bindingID,\n131|\t})\n132|\tif err != nil {\n133|\t\tif code := backendErrorCode(err); code != \"\" {\n134|\t\t\treturn \"\", &terminstance.Error{Code: code, Detail: \"backend binding conflict\"}\n135|\t\t}\n136|\t\treturn \"\", err\n137|\t}\n138|\treturn recorded.BindingDigest, nil\n139|}\n140|\n141|// startWrapper execs the instance new-session vector for create\n142|// (wrapper_started) and restore (wrapper_restored).\n143|func (runner *backend) startWrapper(ctx context.Context, effect terminalbackend.SideEffect) (string, error) {\n144|\treturn runner.execEvidence(ctx, DirectiveNewSession, effect)\n145|}\n146|\n147|// createAttachClient records the presentation client receipt for one\n148|// (instance, client) pair. Every call requires the valid unexpired\n149|// attach authorization the attach handler already admitted; the store\n150|// rechecks it, so a timeout creates no authorized input unless the\n151|// durable receipt says so.\n152|func (runner *backend) createAttachClient() (string, error) {\n153|\tif runner.attach == nil {\n154|\t\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend attach store\"}\n155|\t}\n156|\treceipt, _, err := runner.attach.Attach(runner.sessionID, runner.instanceID, runner.clientID, runner.transport, runner.input, runner.authRaw, runner.now())\n157|\tif err != nil {\n158|\t\tif code := backendErrorCode(err); code != \"\" {\n159|\t\t\treturn \"\", &terminstance.Error{Code: code, Detail: \"backend attach conflict\"}\n160|\t\t}\n161|\t\treturn \"\", err\n162|\t}\n163|\treturn effectEvidence(terminalbackend.EffectAttachClientCreated, runner.operation, runner.instanceID, receipt.ClientID, receipt.Transport), nil\n164|}\n165|\n166|// execEvidence runs one directive and evidences its success. A nonzero\n167|// exit is a coded process failure: the command ran and the effect did\n168|// not commit. A transport error is uncoded: it proves nothing.\n169|func (runner *backend) execEvidence(ctx context.Context, directive Directive, effect terminalbackend.SideEffect) (string, error) {\n170|\targv, err := runner.command(directive)\n171|\tif err != nil {\n172|\t\treturn \"\", err\n173|\t}\n174|\tresult, err := runner.runner.Run(ctx, argv)\n175|\tif err != nil {\n176|\t\treturn \"\", err\n177|\t}\n178|\tif result.ExitCode != 0 {\n179|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n180|\t}\n181|\treturn effectEvidence(effect, runner.operation, runner.instanceID, strconv.Itoa(result.ExitCode)), nil\n182|}\n183|\n184|// observeBoundary waits for the wrapper's safe-boundary signal on the\n185|// quiescence channel. The wait context already bounds the lesser of\n186|// the request deadline and the timeout; its expiry is the coded\n187|// quiesce_timeout proving non-commit, never a silent continue.\n188|func (runner *backend) observeBoundary() (string, error) {\n189|\targv, err := runner.command(DirectiveWaitBoundary)\n190|\tif err != nil {\n191|\t\treturn \"\", err\n192|\t}\n193|\tresult, err := runner.runner.Run(runner.waitCtx, argv)\n194|\tif err != nil {\n195|\t\tif runner.waitCtx.Err() != nil {\n196|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeQuiesceTimeout, Detail: \"backend boundary wait\"}\n197|\t\t}\n198|\t\treturn \"\", err\n199|\t}\n200|\tif result.ExitCode != 0 {\n201|\t\tif runner.waitCtx.Err() != nil {\n202|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeQuiesceTimeout, Detail: \"backend boundary wait\"}\n203|\t\t}\n204|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n205|\t}\n206|\tobserved, err := runner.now().UTC().MarshalText()\n207|\tif err != nil {\n208|\t\treturn \"\", err\n209|\t}\n210|\treturn effectEvidence(terminalbackend.EffectSafeBoundaryObserved, runner.operation, runner.instanceID, runner.channel, string(observed)), nil\n211|}\n212|\n213|// confirmClosed proves process closure for request-stop and\n214|// terminate-stale. Absence (has-session exit 1) is the proof. A live\n215|// session on request-stop escalates once to kill-session and\n216|// re-confirms; a still-live session is the coded stop_timeout. A live\n217|// session on terminate-stale is the coded process failure: the kill\n218|// claimed the incarnation and it still answers. The confirm polls to\n219|// the deadline before it concludes anything.\n220|func (runner *backend) confirmClosed(ctx context.Context) (string, error) {\n221|\tif runner.pollForAbsence(ctx) {\n222|\t\treturn effectEvidence(terminalbackend.EffectProcessClosed, runner.operation, runner.instanceID, \"absent\"), nil\n223|\t}\n224|\tif runner.operation == terminalbackend.OperationRequestStop {\n225|\t\targv, err := runner.command(DirectiveKillSession)\n226|\t\tif err != nil {\n227|\t\t\treturn \"\", err\n228|\t\t}\n229|\t\tif result, err := runner.runner.Run(ctx, argv); err != nil {\n230|\t\t\treturn \"\", err\n231|\t\t} else if result.ExitCode != 0 {\n232|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n233|\t\t}\n234|\t\tif runner.pollForAbsence(ctx) {\n235|\t\t\treturn effectEvidence(terminalbackend.EffectProcessClosed, runner.operation, runner.instanceID, \"escalated\"), nil\n236|\t\t}\n237|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeStopTimeout, Detail: \"backend stop wait\"}\n238|\t}\n239|\t// Terminate-stale re-confirm: a live session refuses whether the kill\n240|\t// exited clean or failed — the kill claimed the incarnation and it\n241|\t// still answers. The exit split names both members so each refuses\n242|\t// explicitly; the narrowing mutant admits exactly the failed-kill\n243|\t// member.\n244|\tif runner.killExit != 0 {\n245|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n246|\t}\n247|\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n248|}\n249|\n250|// pollForAbsence probes has-session until the session is absent or the\n251|// deadline passes. A transport error aborts the poll as unknown: the\n252|// caller classifies it, never this loop.\n253|func (runner *backend) pollForAbsence(ctx context.Context) bool {\n254|\tfor {\n255|\t\targv, err := runner.command(DirectiveHasSession)\n256|\t\tif err != nil {\n257|\t\t\treturn false\n258|\t\t}\n259|\t\tresult, err := runner.runner.Run(ctx, argv)\n260|\t\tif err != nil {\n261|\t\t\treturn false\n262|\t\t}\n263|\t\tif result.ExitCode != 0 {\n264|\t\t\treturn true\n265|\t\t}\n266|\t\tif !runner.now().Before(runner.deadline) {\n267|\t\t\treturn false\n268|\t\t}\n269|\t\trunner.sleep(runner.poll)\n270|\t}\n271|}\n272|\n273|// terminateStale kills the fenced stale incarnation session. A clean\n274|// kill proves termination; a failed kill self-confirms — an absent\n275|// session is terminated however it closed — and only a live session\n276|// after a failed kill is the coded process failure.\n277|func (runner *backend) terminateStale(ctx context.Context) (string, error) {\n278|\targv, err := runner.command(DirectiveKillSession)\n279|\tif err != nil {\n280|\t\treturn \"\", err\n281|\t}\n282|\tresult, err := runner.runner.Run(ctx, argv)\n283|\tif err != nil {\n284|\t\treturn \"\", err\n285|\t}\n286|\trunner.killExit = result.ExitCode\n287|\tif result.ExitCode == 0 {\n288|\t\treturn effectEvidence(terminalbackend.EffectStaleIncarnationTerminated, runner.operation, runner.instanceID, \"killed\"), nil\n289|\t}\n290|\tconfirm, err := runner.command(DirectiveHasSession)\n291|\tif err != nil {\n292|\t\treturn \"\", err\n293|\t}\n294|\tobserved, err := runner.runner.Run(ctx, confirm)\n295|\tif err != nil {\n296|\t\treturn \"\", err\n297|\t}\n298|\tif observed.ExitCode != 0 {\n299|\t\treturn effectEvidence(terminalbackend.EffectStaleIncarnationTerminated, runner.operation, runner.instanceID, \"confirmed-absent\"), nil\n300|\t}\n301|\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n302|}\n303|\n304|// command builds the argv for one directive over the request identity.\n305|func (runner *backend) command(directive Directive) ([]string, error) {\n306|\tbuilt, err := BuildCommand(directive, CommandArgs{\n307|\t\tRuntimeDir:           runner.runtimeDir,\n308|\t\tSocket:               runner.socket,\n309|\t\tSessionID:            runner.sessionID,\n310|\t\tInstanceID:           runner.instanceID,\n311|\t\tQuiescenceGeneration: runner.quiescence,\n312|\t})\n313|\tif err != nil {\n314|\t\tif code := backendErrorCode(err); code != \"\" {\n315|\t\t\treturn nil, &terminstance.Error{Code: code, Detail: \"backend command refused\"}\n316|\t\t}\n317|\t\treturn nil, err\n318|\t}\n319|\treturn built, nil\n320|}\n321|\n322|// backendErrorCode reads the wire code off a backend-construction or\n323|// store error: landed terminalbackend and terminstance refusals plus\n324|// local tmuxserver refusals all carry one. Anything else is uncoded.\n325|func backendErrorCode(err error) string {\n326|\tif code := terminstance.ErrorCode(err); code != \"\" {\n327|\t\treturn code\n328|\t}\n329|\tvar local *Error\n330|\tif errors.As(err, &local) {\n331|\t\treturn local.Code\n332|\t}\n333|\treturn \"\"\n334|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
