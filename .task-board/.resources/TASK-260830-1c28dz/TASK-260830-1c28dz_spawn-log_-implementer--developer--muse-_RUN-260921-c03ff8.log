rentLease(), lc.Now()); err != nil {\\n\\t\\tfailure := rowError(operation, err)\\n\\t\\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\\n\\t\\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\\n\\t}\\n\\tif lc.CurrentGeneration() != mctx.BackendGeneration {\\n\\t\\tfailure := &Error{Code: terminalbackend.CodeStaleGeneration, Detail: \\\"backend_generation stale\\\"}\\n\\t\\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\\n\\t\\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\\n\\t}\\n\\tif err := lc.checkPriorBinding(body); err != nil {\\n\\t\\tvar local *Error\\n\\t\\tif errors.As(err, &local) && local.Code == terminalbackend.CodeRestoreMismatch {\\n\\t\\t\\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\\n\\t\\t\\treturn OpOutcome{Operation: operation, Mutation: &result}, err\\n\\t\\t}\\n\\t\\tfailure := &Error{Code: terminstance.CodeProcessFailed, Detail: \\\"backend binding read\\\"}\\n\\t\\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\\n\\t\\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\\n\\t}\\n\\tdeadline, err := mctx.Deadline.Time()\\n\\tif err != nil {\\n\\t\\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \\\"mutation context deadline\\\"}\\n\\t}\\n\\tif !lc.Now().Before(deadline) {\\n\\t\\tfailure := &Error{Code: terminstance.CodeTimeout, Detail: \\\"operation deadline\\\"}\\n\\t\\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionReplaySame)\\n\\t\\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\\n\\t}\\n\\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\\n\\treqBackend.operation = operation\\n\\treqBackend.bootstrapID = body.BootstrapOperationID\\n\\t// The persist effect replays the recorded pair receipt (verified\\n\\t// by the mismatch arm above); the candidate carries the matched\\n\\t// prior digest so the store admits its shape on the replay path.\\n\\treqBackend.bindingID = body.PriorBindingID\\n\\treturn lc.executeWithReceipt(ctx, req, socket, operation, mctx, source, target, effects, deadline, terminstance.AuthorizationRestore, reqBackend, func(result terminstance.Result) OpOutcome {\\n\\t\\treturn OpOutcome{Operation: operation, Mutation: &result, PriorBindingID: body.PriorBindingID, RestoredParked: true}\\n\\t})\\n}\\n\\n// checkPriorBinding enforces the restore mismatch rule: the recorded\\n// bootstrap binding for the (session, bootstrap) pair must exist and\\n// its digest must equal the carried prior_binding_id. Substituting any\\n// other binding — including the configured default — refuses the\\n// restore mismatch. A binding read failure is an error, never a\\n// mismatch: unknown is not a verdict.\\nfunc (lc *Lifecycle) checkPriorBinding(body RestoreBody) error {\\n\\trecorded, found, err := lc.Bindings.Lookup(body.Context.SessionID, body.BootstrapOperationID)\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif !found || recorded.BindingDigest != body.PriorBindingID {\\n\\t\\treturn &Error{Code: terminalbackend.CodeRestoreMismatch, Detail: \\\"restore prior binding\\\"}\\n\\t}\\n\\treturn nil\\n}\\n\\n// effectPerformer executes one lifecycle side effect and reports its\\n\",\n  \"original_output_bytes\": 4368,\n  \"original_output_tokens\": 1092,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000f065","stream":{"kind":"session","id":"01a0c620-a10f-77d2-842c-eaf24fab8e2e"},"sequence":5773,"recorded_at":1780531400011541,"record_type":"event","durability":"durable","causation_id":"0cdc816d-6145-48a9-a49c-390655512ae9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"0cdc816d-6145-48a9-a49c-390655512ae9","run_stream":{"kind":"run","id":"0cdc816d-6145-48a9-a49c-390655512ae9"},"call_id":"call_01a0c66514e7778183314e494490c29e","text":"{\n  \"chunk_id\": \"exec-162-1\",\n  \"command\": \"grep -n \\\"ErrLocalPreconditionFailed\\\\|ErrInvalidArguments\\\\|ErrLeaseConflict\\\" internal/fencing/*.go | grep -v _test | head; echo ===; grep -rn \\\"func.*refuse\\\\|errors.New\\\\|fmt.Errorf\\\" internal/fencing/gate.go internal/fencing/terminate.go 2>/dev/null | head\",\n  \"description\": \"Read fencing error constructors\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"internal/fencing/gate.go:13:\\t// ErrLeaseConflict is the Section 15 lease_conflict refusal at exit\\ninternal/fencing/gate.go:18:\\tErrLeaseConflict = errors.New(\\\"lease_conflict\\\")\\ninternal/fencing/gate.go:32:\\t// ErrInvalidArguments is the Section 15 invalid_arguments refusal\\ninternal/fencing/gate.go:37:\\tErrInvalidArguments = errors.New(\\\"invalid_arguments\\\")\\ninternal/fencing/gate.go:38:\\t// ErrLocalPreconditionFailed is the Section 15\\ninternal/fencing/gate.go:43:\\tErrLocalPreconditionFailed = errors.New(\\\"local_precondition_failed\\\")\\ninternal/fencing/gate.go:297:\\t\\treturn LeaseToken{}, refuse(ErrInvalidArguments, \\\"unknown fencing operation %q\\\", string(operation))\\ninternal/fencing/gate.go:300:\\t\\treturn LeaseToken{}, refuse(ErrInvalidArguments, \\\"presented fencing token session %q is not a UUIDv7: %v\\\", presented.SessionID, err)\\ninternal/fencing/gate.go:303:\\t\\treturn LeaseToken{}, refuse(ErrInvalidArguments, \\\"presented fencing token carries epoch 0, want an epoch at or above 1\\\")\\ninternal/fencing/gate.go:306:\\t\\treturn LeaseToken{}, refuse(ErrInvalidArguments, \\\"presented fencing token lease %q is not a UUIDv4: %v\\\", presented.LeaseID, err)\\n===\\ninternal/fencing/gate.go:18:\\tErrLeaseConflict = errors.New(\\\"lease_conflict\\\")\\ninternal/fencing/gate.go:22:\\tErrNotOwner = errors.New(\\\"not_owner\\\")\\ninternal/fencing/gate.go:26:\\tErrStaleOwner = errors.New(\\\"stale_owner\\\")\\ninternal/fencing/gate.go:31:\\tErrParked = errors.New(\\\"parked\\\")\\ninternal/fencing/gate.go:37:\\tErrInvalidArguments = errors.New(\\\"invalid_arguments\\\")\\ninternal/fencing/gate.go:43:\\tErrLocalPreconditionFailed = errors.New(\\\"local_precondition_failed\\\")\\ninternal/fencing/gate.go:47:// through. No production path wraps a sentinel with fmt.Errorf directly.\\ninternal/fencing/gate.go:49:\\treturn fmt.Errorf(\\\"%w: %s\\\", sentinel, fmt.Sprintf(format, arguments...))\\n\",\n  \"original_output_bytes\": 1802,\n  \"original_output_tokens\": 451,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
