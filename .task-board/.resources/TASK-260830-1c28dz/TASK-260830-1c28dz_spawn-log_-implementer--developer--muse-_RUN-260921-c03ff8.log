{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000f91b","stream":{"kind":"session","id":"01a0c620-a10f-77d2-842c-eaf24fab8e2e"},"sequence":6888,"recorded_at":1780531400013771,"record_type":"event","durability":"durable","causation_id":"0cdc816d-6145-48a9-a49c-390655512ae9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0cdc816d-6145-48a9-a49c-390655512ae9","run_stream":{"kind":"run","id":"0cdc816d-6145-48a9-a49c-390655512ae9"},"task_stream":{"kind":"task","id":"01a0c674-28db-7491-a1b1-097388810467"},"task_id":"01a0c674-28db-7491-a1b1-097388810467","event":{"kind":"output","task_id":"01a0c674-28db-7491-a1b1-097388810467","chunk":"edited\nchanged lines: lines 1273-1274\n--- original\n+++ updated\n@@\n-    Mutant(\n-        name=\"C-control\",\n+    Mutant(\n+        name=\"N-backend-effect-vocabulary\",\n+        path=f\"{PACKAGE}/backend.go\",\n+        find='\\tdefault:\\n\\t\\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend effect vocabulary\"}\\n\\t}\\n',\n+        replace='\\tdefault:\\n\\t\\tif effect == \"server_rebooted\" {\\n\\t\\t\\treturn effectEvidence(effect, runner.operation, runner.instanceID, \"rebooted\"), nil\\n\\t\\t}\\n\\t\\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend effect vocabulary\"}\\n\\t}\\n',\n+        count=1,\n+        run=\"TestPerformEffectRefusesUnknownVocabulary\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the server_rebooted effect past the closed effect vocabulary; every other unknown effect still refuses. Kill path: the foreign effect commits with evidence.\",\n+    ),\n+    Mutant(\n+        name=\"N-backend-exit-refused\",\n+        path=f\"{PACKAGE}/backend.go\",\n+        find='\\tresult, err := runner.runner.Run(ctx, argv)\\n\\tif err != nil {\\n\\t\\treturn \"\", err\\n\\t}\\n\\tif result.ExitCode != 0 {\\n',\n+        replace='\\tresult, err := runner.runner.Run(ctx, argv)\\n\\tif err != nil {\\n\\t\\treturn \"\", err\\n\\t}\\n\\tif result.ExitCode != 0 && result.ExitCode != 1 {\\n',\n+        count=1,\n+        run=\"TestPerformEffectRefusesFailedExec\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly exit-1 effects past the nonzero-exit refusal; every other nonzero exit still refuses. Kill path: the failed exec evidences a commit.\",\n+    ),\n+    Mutant(\n+        name=\"N-backend-transport-unknown\",\n+        path=f\"{PACKAGE}/backend.go\",\n+        find='\\tresult, err := runner.runner.Run(ctx, argv)\\n\\tif err != nil {\\n\\t\\treturn \"\", err\\n\\t}\\n\\tif result.ExitCode != 0 {\\n',\n+        replace='\\tresult, err := runner.runner.Run(ctx, argv)\\n\\tif err != nil && err.Error() != \"fake runner transport failure\" {\\n\\t\\treturn \"\", err\\n\\t}\\n\\tif result.ExitCode != 0 {\\n',\n+        count=1,\n+        run=\"TestPerformEffectTransportProvesNothing\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the fixture transport failure past the unknown pass-through (it falls into the zero-result exit check and commits); every other transport failure still passes through uncoded. Kill path: the unproven effect evidences a commit.\",\n+    ),\n+    Mutant(\n+        name=\"N-backend-reconfirm-failed-kill\",\n+        path=f\"{PACKAGE}/backend.go\",\n+        find='\\tif runner.killExit != 0 {\\n\\t\\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\\n\\t}\\n',\n+        replace='\\tif runner.killExit != 0 {\\n\\t\\treturn effectEvidence(terminalbackend.EffectProcessClosed, runner.operation, runner.instanceID, \"failed-kill-live\"), nil\\n\\t}\\n',\n+        count=1,\n+        run=\"TestPerformEffectTerminateReconfirmRefusesFailedKill\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the failed-kill-live member past the terminate re-confirm split; the clean-kill-live member still refuses. Kill