{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000eba1","stream":{"kind":"session","id":"01a0c620-a10f-77d2-842c-eaf24fab8e2e"},"sequence":5163,"recorded_at":1780531400010321,"record_type":"event","durability":"durable","causation_id":"0cdc816d-6145-48a9-a49c-390655512ae9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0cdc816d-6145-48a9-a49c-390655512ae9","run_stream":{"kind":"run","id":"0cdc816d-6145-48a9-a49c-390655512ae9"},"task_stream":{"kind":"task","id":"01a0c65f-714a-7ac3-9410-742c3eb955ec"},"task_id":"01a0c65f-714a-7ac3-9410-742c3eb955ec","event":{"kind":"output","task_id":"01a0c65f-714a-7ac3-9410-742c3eb955ec","chunk":"Read text file `internal/tmuxserver/mutant_harness.py`.\n1|#!/usr/bin/env python3\n2|\"\"\"Narrowing-mutant harness for internal/tmuxserver.\n3|\n4|Every gate ships a narrowing mutant: the gate stays present and is\n5|weakened to admit exactly one member of the class it must reject, and\n6|the named killer tests must fail. A delete-only mutant proves only that\n7|the gate exists and is not accepted as evidence; rows D-background-fallback\n8|and D-background-fallback-foreground are the two explicitly supplementary\n9|additive plants (reviewer-shaped direct-creation calls on the background\n10|path), labeled as such and not counted as any gate's narrowing.\n11|\n12|Each row runs M (mutate production files in place), R (run the scoped Go\n13|killers through the production entries), V (verdict from the Go exit code\n14|plus a FAIL kill-line: KILLED iff R fails with a test failure line,\n15|SURVIVED iff R passes, ERROR for anything else -- unapplied patches,\n16|build breaks, timeouts). M failures and R infrastructure errors are\n17|ERROR, never kills or survivals. Files are restored from backups after\n18|every row, pass or fail.\n19|\n20|Row C-control is the harmless control: a comment-only edit that must\n21|SURVIVE, proving the harness observes test outcomes instead of\n22|hard-coding kills.\n23|\n24|Usage:\n25|  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py\n26|  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py N-mode-create\n27|  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py --log-dir /tmp/mutant-logs\n28|  AX_MUTANT_VERBOSE=1 PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py N-mode-create\n29|\"\"\"\n30|\n31|import os\n32|import shutil\n33|import subprocess\n34|import sys\n35|import tempfile\n36|from dataclasses import dataclass\n37|from pathlib import Path\n38|\n39|REPO = Path(__file__).resolve().parents[2]\n40|PACKAGE = \"internal/tmuxserver\"\n41|\n42|\n43|@dataclass(frozen=True)\n44|class Mutant:\n45|    name: str\n46|    path: str\n47|    find: str\n48|    replace: str\n49|    count: int\n50|    run: str\n51|    expect: str\n52|    note: str\n53|\n54|\n55|BG_MISS = \"TestAcquireBackgroundMissReturnsTypedUnavailable\"\n56|BG_MISS_LINUX = \"(TestAcquireBackgroundMissReturnsTypedUnavailable|TestAcquireBackgroundMissOnLinuxAlsoRefusesWithoutFallback)\"\n57|OVERRIDE = \"TestAcquireRefusesEveryAmbientOverrideVector\"\n58|RES_OVERRIDE = \"(TestAcquireRefusesEveryAmbientOverrideVector|TestResolveSocketRefusesEveryOverrideVector)\"\n59|WIDENED = \"TestEnsureRuntimeDirRefusesWidenedMode\"\n60|COLLISION = \"(TestResolveSocketRefusesAmbientCollision|TestAcquireRefusesAmbientCollision)\"\n61|\n62|MUTANTS = [\n63|    Mutant(\n64|        name=\"N-mode-create\",\n65|        path=f\"{PACKAGE}/runtime_unix.go\",\n66|        find=\"\\t// leaf above; the mode comparison below is the load-bearing\\n\\t// arm this gate's tests and mutants pin.\\n\\tif info.Mode().Perm() != 0o700 {\\n\",\n67|        replace=\"\\t// leaf above; the mode comparison below is the load-bearing\\n\\t// arm this gate's tests and mutants pin.\\n\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o755 {\\n\",\n68|        count=1,\n69|        run=WIDENED,\n70|        expect=\"KILLED\",\n71|        note=\"Admits exactly 0755 at the create-path mode arm; other widened modes still refuse. Kill path: Ensure stops refusing.\",\n72|    ),\n73|    Mutant(\n74|        name=\"N-mode-verify\",\n75|        path=f\"{PACKAGE}/runtime_unix.go\",\n76|        find='\\tinfo, err := leaf.Stat()\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\\n\\t}\\n\\tif info.Mode().Perm() != 0o700 {\\n',\n77|        replace='\\tinfo, err := leaf.Stat()\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\\n\\t}\\n\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o755 {\\n',\n78|        count=1,\n79|        run=WIDENED,\n80|        expect=\"KILLED\",\n81|        note=\"Admits exactly 0755 at the verify-path mode arm; the create arm still refuses. Kill path: Verify stops refusing.\",\n82|    ),\n83|    Mutant(\n84|        name=\"N-mode-narrower-create\",\n85|        path=f\"{PACKAGE}/runtime_unix.go\",\n86|        find=\"\\t// leaf above; the mode comparison below is the load-bearing\\n\\t// arm this gate's tests and mutants pin.\\n\\tif info.Mode().Perm() != 0o700 {\\n\",\n87|        replace=\"\\t// leaf above; the mode comparison below is the load-bearing\\n\\t// arm this gate's tests and mutants pin.\\n\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o600 {\\n\",\n88|        count=1,\n89|        run=\"TestEnsureRuntimeDirRefusesNarrowerMode\",\n90|        expect=\"KILLED\",\n91|        note=\"Admits exactly a 0600 leaf at the create-path mode arm; every other non-0700 mode (widened and narrower) still refuses. Kill path: Ensure stops refusing the 0600 fixture.\",\n92|    ),\n93|    Mutant(\n94|        name=\"N-mode-narrower-verify\",\n95|        path=f\"{PACKAGE}/runtime_unix.go\",\n96|        find='\\tinfo, err := leaf.Stat()\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\\n\\t}\\n\\tif info.Mode().Perm() != 0o700 {\\n',\n97|        replace='\\tinfo, err := leaf.Stat()\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \"runtime mode\"}\\n\\t}\\n\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o600 {\\n',\n98|        count=1,\n99|        run=\"TestEnsureRuntimeDirRefusesNarrowerMode\",\n100|        expect=\"KILLED\",\n101|        note=\"Admits exactly a 0600 leaf at the verify-path mode arm; the create arm still refuses, so the kill comes from the Verify leg of the narrower-mode test. Narrower 0500 still refuses on both arms.\",\n102|    ),\n103|    Mutant(\n104|        name=\"N-fchmod-umask\",\n105|        path=f\"{PACKAGE}/runtime_unix.go\",\n106|        find=\"\\tif created {\\n\",\n107|        replace=\"\\tif created && os.Geteuid() == 0 {\\n\",\n108|        count=1,\n109|        run=\"TestEnsureRuntimeDirEnforcesModeUnderRestrictiveUmask\",\n110|        expect=\"KILLED\",\n111|        note=\"Admits exactly non-root creates past the explicit post-mkdirat chmod; root creates still chmod. Kill path: under umask 0177 the leaf stays 0600 and the mode gate refuses. Non-root load-bearing, like the same-shaped reviewer plant.\",\n112|    ),\n113|    Mutant(\n114|        name=\"N-ownership-uid\",\n115|        path=f\"{PACKAGE}/ownership_unix.go\",\n116|        find=\"\\tif stat.Uid != uint32(effectiveUID()) {\\n\",\n117|        replace=\"\\tif stat.Uid != uint32(effectiveUID()) && stat.Uid != uint32(effectiveUID())-100000 {\\n\",\n118|        count=1,\n119|        run=\"TestEnsureRuntimeDirRefusesForeignOwnership\",\n120|        expect=\"KILLED\",\n121|        note=\"Admits exactly the seam-shifted foreign UID; every other foreign UID still refuses.\",\n122|    ),\n123|    Mutant(\n124|        name=\"N-containment-slash\",\n125|        path=f\"{PACKAGE}/runtime.go\",\n126|        find='\\tif strings.Contains(name, \"/\") {\\n',\n127|        replace='\\tif strings.Contains(name, \"/\") && name != \"a/b\" {\\n',\n128|        count=1,\n129|        run=\"(TestEnsureRuntimeDirRefusesBadNames|TestVerifyRuntimeDirRefusesBadLexical)\",\n130|        expect=\"KILLED\",\n131|        note=\"Admits exactly the nested a/b name past the single-segment arm; every other multi-segment name still refuses. One shared site, both custody entries: kill reroutes past the invalid-name refusal on each.\",\n132|    ),\n133|    Mutant(\n134|        name=\"N-containment-mismatch\",\n135|        path=f\"{PACKAGE}/runtime.go\",\n136|        find=\"\\treturn sameDirectory(handleInfo, pathInfo)\\n\",\n137|        replace=\"\\treturn sameDirectory(handleInfo, pathInfo) || handleInfo.IsDir()\\n\",\n138|        count=1,\n139|        run=\"(TestEnsureRuntimeDirRefusesHandleMismatch|TestAcquireBackgroundRefusesHandleMismatch)\",\n140|        expect=\"KILLED\",\n141|        note=\"Admits exactly directory handles past the handle-binding check; the mismatch still refuses for non-directories. One shared site, three entries: the commit, verify, and background-acquisition mismatch tests admit the bound handle.\",\n142|    ),\n143|    Mutant(\n144|        name=\"N-containment-symlink\",\n145|        path=f\"{PACKAGE}/runtime_unix.go\",\n146|        find=\"\\tleafFd, err := unix.Openat(rootFd, name,\\n\\t\\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\",\n147|        replace=\"\\tleafFd, err := unix.Openat(rootFd, name,\\n\\t\\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\tif err != nil {\\n\\t\\tleafFd, err = unix.Openat(rootFd, name,\\n\\t\\t\\tunix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\t}\\n\\tif err != nil {\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\",\n148|        count=1,\n149|        run=\"TestEnsureRuntimeDirRefusesSymlinkLeaf\",\n150|        expect=\"KILLED\",\n151|        note=\"Admits exactly symlink leaves via an ELOOP fallback open; every other commit failure still refuses.\",\n152|    ),\n153|    Mutant(\n154|        name=\"N-containment-symlink-verify\",\n155|        path=f\"{PACKAGE}/runtime_unix.go\",\n156|        find=\"\\tleafFd, err := unix.Openat(int(rootHandle.Fd()), name,\\n\\t\\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\tif err != nil {\\n\\t\\tif errors.Is(err, unix.ENOENT) {\\n\\t\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime absent\\\"}\\n\\t\\t}\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\",\n157|        replace=\"\\tleafFd, err := unix.Openat(int(rootHandle.Fd()), name,\\n\\t\\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\tif err != nil {\\n\\t\\tleafFd, err = unix.Openat(int(rootHandle.Fd()), name,\\n\\t\\t\\tunix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\\t}\\n\\tif err != nil {\\n\\t\\tif errors.Is(err, unix.ENOENT) {\\n\\t\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime absent\\\"}\\n\\t\\t}\\n\\t\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime containment\\\"}\\n\\t}\\n\",\n158|        count=1,\n159|        run=\"(TestVerifyRuntimeDirRefusesSymlinkLeaf|TestAcquireBackgroundRefusesSymlinkLeaf)\",\n160|        expect=\"KILLED\",\n161|        note=\"Admits exactly symlink leaves via an ELOOP fallback open on the verify side; the commit side still refuses. One site, both entries: Verify follows the leaf and the mode gate passes on the compliant target, and the background entry contacts the broker past it.\",\n162|    ),\n163|    Mutant(\n164|        name=\"N-containment-odirectory-verify\",\n165|        path=f\"{PACKAGE}/runtime_unix.go\",\n166|        find=\"\\tleafFd, err := unix.Openat(int(rootHandle.Fd()), name,\\n\\t\\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\",\n167|        replace=\"\\tleafFd, err := unix.Openat(int(rootHandle.Fd()), name,\\n\\t\\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)\\n\",\n168|        count=1,\n169|        run=\"(TestVerifyRuntimeDirRefusesNonDirectoryLeaf|TestAcquireBackgroundRefusesNonDirectoryLeaf)\",\n170|        expect=\"KILLED\",\n171|        note=\"Admits exactly non-directory leaves past the verify-side O_DIRECTORY arm; O_NOFOLLOW stays, so symlink leaves still refuse, and the commit-side arm carries its own row N-containment-odirectory-commit. Kill path: the 0700 regular file verifies clean through both entries, and the FIFO stalls past the 5s deadline.\",\n172|    ),\n173|    Mutant(\n174|        name=\"N-containment-odirectory-commit\",\n175|        path=f\"{PACKAGE}/runtime_unix.go\",\n176|        find=\"\\tleafFd, err := unix.Openat(rootFd, name,\\n\\t\\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_DIRECTORY|unix.O_CLOEXEC, 0)\\n\",\n177|        replace=\"\\tleafFd, err := unix.Openat(rootFd, name,\\n\\t\\tunix.O_RDONLY|unix.O_NOFOLLOW|unix.O_CLOEXEC, 0)\\n\",\n178|        count=1,\n179|        run=\"(TestEnsureRuntimeDirRefusesNonDirectoryLeaf|TestAcquireForegroundRefusesNonDirectoryLeaf)\",\n180|        expect=\"KILLED\",\n181|        note=\"Admits exactly non-directory leaves past the commit-side O_DIRECTORY arm; O_NOFOLLOW stays, so symlink leaves still refuse, and the verify-side arm carries its own row N-containment-odirectory-verify. Kill path: the 0700 regular file is admitted on Ensure and through the foreground entry (which then probes the server and spawns), and the FIFO stalls past the 5s deadline; the 0600 fixture fails by reroute to the mode gate.\",\n182|    ),\n183|    Mutant(\n184|        name=\"N-root-wiring\",\n185|        path=f\"{PACKAGE}/runtime.go\",\n186|        find='\\tif _, err := scalar.ParseAbsolutePath(platform, root); err != nil {\\n\\t\\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"runtime root\"}\\n\\t}\\n',\n187|        replace='\\tif _, err := scalar.ParseAbsolutePath(platform, root); err != nil && root != \"relative/root\" {\\n\\t\\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"runtime root\"}\\n\\t}\\n',\n188|        count=1,\n189|        run=\"(TestEnsureRuntimeDirRefusesBadRoots|TestVerifyRuntimeDirRefusesBadLexical|TestAcquireForegroundRefusesBadRoot)\",\n190|        expect=\"KILLED\",\n191|        note=\"Admits exactly the relative-root fixture past our wiring of the landed grammar; every other malformed root still refuses. One shared site, three entries: kill reroutes to the guard refusal on each.\",\n192|    ),\n193|    Mutant(\n194|        name=\"N-platform-wiring\",\n195|        path=f\"{PACKAGE}/runtime.go\",\n196|        find=\"\\tif _, err := scalar.ParsePlatform(string(platform)); err != nil {\\n\",\n197|        replace='\\tif _, err := scalar.ParsePlatform(string(platform)); err != nil && platform != \"plan9\" {\\n',\n198|        count=1,\n199|        run=\"(TestEnsureRuntimeDirRefusesBadPlatform|TestVerifyRuntimeDirRefusesBadLexical|TestAcquireRefusesUnknownPlatform)\",\n200|        expect=\"KILLED\",\n201|        note=\"Admits exactly the plan9 platform past our wiring of the landed vocabulary; every other unknown platform still refuses. One shared site, three entries: kill reroutes to the root refusal on each.\",\n202|    ),\n203|    Mutant(\n204|        name=\"N-platform-windows\",\n205|        path=f\"{PACKAGE}/runtime.go\",\n206|        find=\"\\tif platform == scalar.PlatformWindows {\\n\",\n207|        replace='\\tif platform == scalar.PlatformWindows && root != \"C:\\\\\\\\ax-runtime\" {\\n',\n208|        count=1,\n209|        run=\"(TestEnsureRuntimeDirRefusesWindowsOnUnixHost|TestAcquireRefusesWindowsPlatform)\",\n210|        expect=\"KILLED\",\n211|        note=\"Admits exactly the C: fixture root past the lexical Windows refusal; every other Windows root still refuses there. One shared site, three entries: kill reroutes to the root refusal, which reports runtime root instead of runtime platform.\",\n212|    ),\n213|    Mutant(\n214|        name=\"N-override-env\",\n215|        path=f\"{PACKAGE}/socket.go\",\n216|        find='\\tif override != \"\" {\\n',\n217|        replace='\\tif override != \"\" && override != \"/tmp/tmux-501/default,12345,0\" {\\n',\n218|        count=1,\n219|        run=f\"{RES_OVERRIDE}/environment_variable\",\n220|        expect=\"KILLED\",\n221|        note=\"Admits exactly the TMUX environment value as an override through both the Acquire and the direct ResolveSocket entries; the other four vectors still refuse.\",\n222|    ),\n223|    Mutant(\n224|        name=\"N-override-inherited\",\n225|        path=f\"{PACKAGE}/socket.go\",\n226|        find='\\tif override != \"\" {\\n',\n227|        replace='\\tif override != \"\" && override != \"/tmp/inherited.sock\" {\\n',\n228|        count=1,\n229|        run=f\"{RES_OVERRIDE}/inherited_socket\",\n230|        expect=\"KILLED\",\n231|        note=\"Admits exactly the inherited socket as an override through both the Acquire and the direct ResolveSocket entries; the other four vectors still refuse.\",\n232|    ),\n233|    Mutant(\n234|        name=\"N-override-default\",\n235|        path=f\"{PACKAGE}/socket.go\",\n236|        find='\\tif override != \"\" {\\n',\n237|        replace='\\tif override != \"\" && override != \"/tmp/tmux-501/default\" {\\n',\n238|        count=1,\n239|        run=f\"{RES_OVERRIDE}/default_path\",\n240|        expect=\"KILLED\",\n241|        note=\"Admits exactly the default path as an override through both the Acquire and the direct ResolveSocket entries; the other four vectors still refuse.\",\n242|    ),\n243|    Mutant(\n244|        name=\"N-override-conventional\",\n245|        path=f\"{PACKAGE}/socket.go\",\n246|        find='\\tif override != \"\" {\\n',\n247|        replace='\\tif override != \"\" && override != \"default\" {\\n',\n248|        count=1,\n249|        run=f\"{RES_OVERRIDE}/conventional_name\",\n250|        expect=\"KILLED\",\n251|        note=\"Admits exactly the conventional name as an override through both the Acquire and the direct ResolveSocket entries; the other four vectors still refuse.\",\n252|    ),\n253|    Mutant(\n254|        name=\"N-override-tmpdir\",\n255|        path=f\"{PACKAGE}/socket.go\",\n256|        find='\\tif override != \"\" {\\n',\n257|        replace='\\tif override != \"\" && override != \"/tmp/operator-tmux\" {\\n',\n258|        count=1,\n259|        run=f\"{RES_OVERRIDE}/tmux_tmpdir\",\n260|        expect=\"KILLED\",\n261|        note=\"Admits exactly the TMUX_TMPDIR value as an override through both the Acquire and the direct ResolveSocket entries — the member tmux uses to relocate its default socket directory; the other four vectors still refuse.\",\n262|    ),\n263|    Mutant(\n264|        name=\"N-collision\",\n265|        path=f\"{PACKAGE}/socket.go\",\n266|        find='\\tif candidate != \"\" && filepath.Clean(candidate) == socket {\\n',\n267|        replace='\\tif candidate != \"\" && filepath.Clean(candidate) == socket && candidate != ambient.DefaultPath {\\n',\n268|        count=1,\n269|        run=f\"{COLLISION}/default_path\",\n270|        expect=\"KILLED\",\n271|        note=\"Admits exactly the default-path collision; collisions on the other four ambient members still refuse.\",\n272|    ),\n273|    Mutant(\n274|        name=\"N-collision-inherited\",\n275|        path=f\"{PACKAGE}/socket.go\",\n276|        find='\\tif candidate != \"\" && filepath.Clean(candidate) == socket {\\n',\n277|        replace='\\tif candidate != \"\" && filepath.Clean(candidate) == socket && candidate != ambient.InheritedSocket {\\n',\n278|        count=1,\n279|        run=f\"{COLLISION}/inherited_socket\",\n280|        expect=\"KILLED\",\n281|        note=\"Admits exactly the inherited-socket collision; the other four members still refuse.\",\n282|    ),\n283|    Mutant(\n284|        name=\"N-collision-tmuxenv\",\n285|        path=f\"{PACKAGE}/socket.go\",\n286|        find='\\tif candidate != \"\" && filepath.Clean(candidate) == socket {\\n',\n287|        replace='\\tif candidate != \"\" && filepath.Clean(candidate) == socket && candidate != ambient.TMUXEnv {\\n',\n288|        count=1,\n289|        run=f\"{COLLISION}/tmux_env\",\n290|        expect=\"KILLED\",\n291|        note=\"Admits exactly the TMUX-env collision; the other four members still refuse.\",\n292|    ),\n293|    Mutant(\n294|        name=\"N-collision-tmpdir\",\n295|        path=f\"{PACKAGE}/socket.go\",\n296|        find='\\tif candidate != \"\" && filepath.Clean(candidate) == socket {\\n',\n297|        replace='\\tif candidate != \"\" && filepath.Clean(candidate) == socket && candidate != ambient.TMUXTmpDir {\\n',\n298|        count=1,\n299|        run=f\"{COLLISION}/tmux_tmpdir\",\n300|        expect=\"KILLED\",\n301|        note=\"Admits exactly the TMUX_TMPDIR collision; the other four members still refuse.\",\n302|    ),\n303|    Mutant(\n304|        name=\"N-collision-conventional\",\n305|        path=f\"{PACKAGE}/socket.go\",\n306|        find='\\tif candidate != \"\" && filepath.Clean(candidate) == socket {\\n',\n307|        replace='\\tif candidate != \"\" && filepath.Clean(candidate) == socket && candidate != ambient.ConventionalName {\\n',\n308|        count=1,\n309|        run=f\"{COLLISION}/conventional_name\",\n310|        expect=\"KILLED\",\n311|        note=\"Admits exactly the conventional-name collision; the other four members still refuse.\",\n312|    ),\n313|    Mutant(\n314|        name=\"N-collision-unclean\",\n315|        path=f\"{PACKAGE}/socket.go\",\n316|        find='\\tif candidate != \"\" && filepath.Clean(candidate) == socket {\\n',\n317|        replace='\\tif candidate != \"\" && candidate == socket {\\n',\n318|        count=1,\n319|        run=\"(TestResolveSocketRefusesAmbientCollisionUncleanSpellings|TestAcquireRefusesAmbientCollisionUncleanSpelling)\",\n320|        expect=\"KILLED\",\n321|        note=\"Admits exactly unclean spellings of the derived socket past the normalization arm; byte-identical collisions still refuse. Narrowing: the equality gate stays, only Clean is dropped.\",\n322|    ),\n323|    Mutant(\n324|        name=\"N-realm-membership\",\n325|        path=f\"{PACKAGE}/readiness.go\",\n326|        find=\"\\tif !admission.Admitted.Has(realmCapability) {\\n\",\n327|        replace='\\tif !admission.Admitted.Has(realmCapability) && !admission.Admitted.Has(\"headless_creation\") {\\n',\n328|        count=1,\n329|        run=f\"(TestCheckServerAttestedRefusesEachMissingConjunct|TestAcquireForegroundRefusesRunningUnattested|TestCheckBrokerContactRefusesEachMissingFact|{BG_MISS}|TestCheckServerAttestedRefusesEveryCatalogDecoy|TestAcquireBackgroundRefusesEveryCatalogDecoy)\",\n330|        expect=\"KILLED\",\n331|        note=\"Admits exactly decoy-capability admissions past the membership arm; every admission without the realm row still refuses. One site, four entries: the foreground entry attaches to a headless-only server, and the broker helper, broker contact, and background miss tables admit the decoy-only report; the catalog-decoy tables kill on their headless_creation member and the all-together set.\",\n332|    ),\n333|    Mutant(\n334|        name=\"N-realm-generation\",\n335|        path=f\"{PACKAGE}/readiness.go\",\n336|        find=\"\\tif wantGeneration == \\\"\\\" || admission.RawGeneration != wantGeneration {\\n\",\n337|        replace='\\tif wantGeneration == \"\" || admission.RawGeneration != wantGeneration && admission.RawGeneration != \"generation-6\" {\\n',\n338|        count=1,\n339|        run=f\"(TestCheckServerAttestedRefusesEachMissingConjunct|TestAcquireForegroundRefusesWrongGenerationAdmission|TestCheckBrokerContactRefusesEachMissingFact|{BG_MISS})\",\n340|        expect=\"KILLED\",\n341|        note=\"Admits exactly stale generation-6 admissions past the generation arm; every other unbound generation still refuses. One site, four entries: a replayed yesterday-proof attaches or contacts through the helper, foreground, broker-contact, and background-miss tables alike.\",\n342|    ),\n343|    Mutant(\n344|        name=\"N-realm-empty-want\",\n345|        path=f\"{PACKAGE}/readiness.go\",\n346|        find='\\tif wantGeneration == \"\" || admission.RawGeneration != wantGeneration {\\n',\n347|        replace='\\tif admission.RawGeneration != wantGeneration {\\n',\n348|        count=1,\n349|        run=\"TestCheckServerAttestedRefusesEachMissingConjunct\",\n350|        expect=\"KILLED\",\n351|        note=\"Admits exactly the both-empty generation pair past the wanted-empty arm; every pair with a non-empty side still refuses on the inequality (the empty-wanted row keeps a bound Raw, the empty-raw row keeps a bound want). Narrowing, not a delete: the inequality arm stays.\",\n352|    ),\n353|    Mutant(\n354|        name=\"N-broker-uid\",\n355|        path=f\"{PACKAGE}/readiness.go\",\n356|        find=\"\\tif report.Principal.UID != currentUID {\\n\",\n357|        replace=\"\\tif report.Principal.UID != currentUID && report.Principal.UID != currentUID+100000 {\\n\",\n358|        count=1,\n359|        run=f\"(TestCheckBrokerContactRefusesEachMissingFact|{BG_MISS})\",\n360|        expect=\"KILLED\",\n361|        note=\"Admits exactly the seam-shifted foreign UID past the same-user arm; every other foreign UID still refuses.\",\n362|    ),\n363|    Mutant(\n364|        name=\"N-broker-generation\",\n365|        path=f\"{PACKAGE}/readiness.go\",\n366|        find='\\tif report.Principal.Generation == \"\" || report.Principal.Generation != wantGeneration {\\n',\n367|        replace='\\tif report.Principal.Generation == \"\" || report.Principal.Generation != wantGeneration && report.Principal.Generation != \"generation-6\" {\\n',\n368|        count=1,\n369|        run=f\"(TestCheckBrokerContactRefusesEachMissingFact|TestAcquireBackgroundMissReturnsTypedUnavailable/generation-unbound_principal)\",\n370|        expect=\"KILLED\",\n371|        note=\"Admits exactly generation-6 broker principals past the principal-binding arm; every other unbound principal still refuses.\",\n372|    ),\n373|    Mutant(\n374|        name=\"N-broker-empty-generation\",\n375|        path=f\"{PACKAGE}/readiness.go\",\n376|        find='\\tif report.Principal.Generation == \"\" || report.Principal.Generation != wantGeneration {\\n',\n377|        replace='\\tif report.Principal.Generation != wantGeneration {\\n',\n378|        count=1,\n379|        run=\"TestCheckBrokerContactRefusesEachMissingFact\",\n380|        expect=\"KILLED\",\n381|        note=\"Admits exactly the both-empty principal pair past the principal-empty arm; every other unbound principal still refuses. Kill reroutes to the server-generation refusal (the empty wanted generation reaches CheckServerAttested), which mismatches the broker-generation detail the row asserts. Through Acquire the pair is unreachable: the typed-details check refuses an empty Generation first.\",\n382|    ),\n383|    Mutant(\n384|        name=\"N-creation-literal\",\n385|        path=f\"{PACKAGE}/acquire.go\",\n386|        find=\"\\tif caller == CallerBackground {\\n\",\n387|        replace='\\tif caller == \"Background\" {\\n',\n388|        count=1,\n389|        run=f\"(TestCheckCreationAllowedRefusesBackground|{BG_MISS_LINUX})\",\n390|        expect=\"KILLED\",\n391|        note=\"Admits exactly the background caller at the creation choke point; the gate still refuses the capitalized twin. Kill path: the background miss consults the gate by call and reports the creation code instead of the typed unavailable.\",\n392|    ),\n393|    Mutant(\n394|        name=\"N-caller-vocabulary\",\n395|        path=f\"{PACKAGE}/acquire.go\",\n396|        find=\"\\tif req.Caller != CallerForeground && req.Caller != CallerBackground {\\n\",\n397|        replace='\\tif req.Caller != CallerForeground && req.Caller != CallerBackground && req.Caller != \"operator\" {\\n',\n398|        count=1,\n399|        run=\"TestAcquireRefusesUnknownCaller\",\n400|        expect=\"KILLED\",\n401|        note=\"Admits exactly the operator caller past the vocabulary arm; every other unknown caller still refuses. Kill path: the admitted operator dispatches foreground (its value differs from the background caller) and spawns, tripping both post-admission spies and succeeding instead of refusing.\",\n402|    ),\n403|    Mutant(\n404|        name=\"N-details-remediation\",\n405|        path=f\"{PACKAGE}/acquire.go\",\n406|        find='\\tif req.Generation == \"\" || req.BrokerState == \"\" || req.Remediation == \"\" {\\n',\n407|        replace='\\tif req.Generation == \"\" || req.BrokerState == \"\" {\\n',\n408|        count=1,\n409|        run=\"TestAcquireRefusesMissingRealmDetails\",\n410|        expect=\"KILLED\",\n411|        note=\"Admits exactly remediation-less requests past the typed-details arm; generation- and broker-less still refuse. Kill reroutes to the dependencies refusal.\",\n412|    ),\n413|    Mutant(\n414|        name=\"N-unattested-foreground\",\n415|        path=f\"{PACKAGE}/acquire.go\",\n416|        find=\"\\t\\tif err := CheckServerAttested(report.Admission, req.Generation); err != nil {\\n\\t\\t\\treturn Outcome{}, err\\n\\t\\t}\\n\",\n417|        replace='\\t\\tif err := CheckServerAttested(report.Admission, req.Generation); err != nil && err.Error() != \"tmux server refused: tmux_readiness_not_authorizing at server generation\" {\\n\\t\\t\\treturn Outcome{}, err\\n\\t\\t}\\n',\n418|        count=1,\n419|        run=\"TestAcquireForegroundRefusesWrongGenerationAdmission\",\n420|        expect=\"KILLED\",\n421|        note=\"Admits exactly generation-refused running servers to attach past the foreground wiring; membership refusals still refuse. Kill path: a stale admission attaches instead of refusing.\",\n422|    ),\n423|    Mutant(\n424|        name=\"N-acquire-commit-refusal\",\n425|        path=f\"{PACKAGE}/acquire.go\",\n426|        find=\"\\tensured, err := EnsureRuntimeDir(req.Root, RuntimeDirName, req.Platform, nil)\\n\\tif err != nil {\\n\",\n427|        replace=\"\\tensured, err := EnsureRuntimeDir(req.Root, RuntimeDirName, req.Platform, nil)\\n\\tif err != nil && ensured == \\\"\\\" {\\n\",\n428|        count=1,\n429|        run=\"TestAcquireForegroundStagesCommitPhaseCustodyRefusal\",\n430|        expect=\"KILLED\",\n431|        note=\"Admits exactly commit-phase custody refusals past the foreground wiring (commit failures carry the joined path; lexical failures carry \\\"\\\"); lexical refusals still refuse. Kill path: the entry probes and spawns past a widened mode.\",\n432|    ),\n433|    Mutant(\n434|        name=\"N-acquire-verify-refusal\",\n435|        path=f\"{PACKAGE}/acquire.go\",\n436|        find=\"\\tif verr != nil {\\n\\t\\treturn Outcome{}, verr\\n\\t}\\n\",\n437|        replace='\\tif verr != nil && verr.Error() != \"tmux server refused: tmux_unsafe_runtime_dir at runtime mode\" {\\n\\t\\treturn Outcome{}, verr\\n\\t}\\n',\n438|        count=1,\n439|        run=\"TestAcquireBackgroundStagesVerifyCustodyRefusal\",\n440|        expect=\"KILLED\",\n441|        note=\"Admits exactly mode refusals past the background verify wiring; absence maps to unavailable above and every other custody refusal still refuses. Kill path: the entry contacts the broker past a widened mode.\",\n442|    ),\n443|    Mutant(\n444|        name=\"N-spawn-swallow\",\n445|        path=f\"{PACKAGE}/acquire.go\",\n446|        find=\"\\tif err := req.Deps.Spawn(socket, argv); err != nil {\\n\",\n447|        replace='\\tif err := req.Deps.Spawn(socket, argv); err != nil && err.Error() != \"exec failed\" {\\n',\n448|        count=1,\n449|        run=\"TestAcquireForegroundSpawnFailureReportsWithoutFallback\",\n450|        expect=\"KILLED\",\n451|        note=\"Admits exactly the fixture spawn failure as success; every other spawn failure still reports.\",\n452|    ),\n453|    Mutant(\n454|        name=\"N-probe-swallow-foreground\",\n455|        path=f\"{PACKAGE}/acquire.go\",\n456|        find=\"\\treport, err := req.Deps.ProbeServer(socket)\\n\\tif err != nil {\\n\",\n457|        replace='\\treport, err := req.Deps.ProbeServer(socket)\\n\\tif err != nil && err.Error() != \"probe boom\" {\\n',\n458|        count=1,\n459|        run=\"TestAcquireForegroundProbeFailurePassesThrough\",\n460|        expect=\"KILLED\",\n461|        note=\"Admits exactly the fixture probe failure as an absent server (then spawns); every other probe failure still passes through.\",\n462|    ),\n463|    Mutant(\n464|        name=\"N-probe-swallow-background\",\n465|        path=f\"{PACKAGE}/acquire.go\",\n466|        find=\"\\tstatus, err := req.Deps.ProbeBroker()\\n\\tif err != nil {\\n\",\n467|        replace='\\tstatus, err := req.Deps.ProbeBroker()\\n\\tif err != nil && err.Error() != \"probe boom\" {\\n',\n468|        count=1,\n469|        run=\"TestAcquireBackgroundProbeFailurePassesThrough\",\n470|        expect=\"KILLED\",\n471|        note=\"Admits exactly the fixture probe failure as a broker miss (then reports unavailable); every other probe failure still passes through.\",\n472|    ),\n473|    Mutant(\n474|        name=\"N-argv-socket\",\n475|        path=f\"{PACKAGE}/argv.go\",\n476|        find=\"\\tif socket != SocketPath(runtimeDir) {\\n\",\n477|        replace='\\tif socket != SocketPath(runtimeDir) && socket != \"/tmp/tmux-501/default\" {\\n',\n478|        count=1,\n479|        run=\"TestBuildArgvRefusesAmbientSocket\",\n480|        expect=\"KILLED\",\n481|        note=\"Admits exactly the default path at the spawn-socket arm; every other ambient socket still refuses.\",\n482|    ),\n483|    Mutant(\n484|        name=\"N-argv-tmuxenv\",\n485|        path=f\"{PACKAGE}/argv.go\",\n486|        find=\"\\tif socket != SocketPath(runtimeDir) {\\n\",\n487|        replace='\\tif socket != SocketPath(runtimeDir) && socket != \"/tmp/tmux-501/default,12345,0\" {\\n',\n488|        count=1,\n489|        run=\"TestBuildArgvRefusesAmbientSocket/tmux_env_value\",\n490|        expect=\"KILLED\",\n491|        note=\"Admits exactly the TMUX environment value at the spawn-socket arm; every other ambient socket still refuses.\",\n492|    ),\n493|    Mutant(\n494|        name=\"N-argv-shape\",\n495|        path=f\"{PACKAGE}/argv.go\",\n496|        find=\"\\tif err := secprim.CheckArgv(argv); err != nil {\\n\",\n497|        replace='\\tif err := secprim.CheckArgv(argv); err != nil && argv[0] != \"tmux\" {\\n',\n498|        count=1,\n499|        run=\"TestBuildArgvRefusesInvalidArgvShape\",\n500|        expect=\"KILLED\",\n(more lines below)","final_result":true}}}
