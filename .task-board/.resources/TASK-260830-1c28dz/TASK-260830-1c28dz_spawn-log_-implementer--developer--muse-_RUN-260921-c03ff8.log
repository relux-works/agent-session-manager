es. Kill path: the foreign creation reaches the engine instead of refusing.\",\n+    ),\n+    Mutant(\n+        name=\"N-lifecycle-agreement-instance\",\n+        path=f\"{PACKAGE}/lifecycle.go\",\n+        find='\\t\\tbody.Binding.TerminalInstanceID != body.Context.TerminalInstanceID ||\\n',\n+        replace='',\n+        count=1,\n+        run=\"TestExecuteCreateBindingAgreement/instance\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly instance-disagreeing bindings past the create agreement; every other disagreement still refuses. Kill path: the foreign creation reaches the engine instead of refusing.\",\n+    ),\n+    Mutant(\n+        name=\"N-lifecycle-agreement-backend\",\n+        path=f\"{PACKAGE}/lifecycle.go\",\n+        find='\\t\\tbody.Binding.TerminalBackendID != body.Context.TerminalBackendID ||\\n',\n+        replace='',\n+        count=1,\n+        run=\"TestExecuteCreateBindingAgreement/backend\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly backend-disagreeing bindings past the create agreement; every other disagreement still refuses. Kill path: the foreign creation reaches the engine instead of refusing.\",\n+    ),\n+    Mutant(\n+        name=\"N-lifecycle-agreement-generation\",\n+        path=f\"{PACKAGE}/lifecycle.go\",\n+        find='\\t\\tbody.Binding.TerminalBackendID != body.Context.TerminalBackendID ||\\n\\t\\tbody.Binding.BackendGeneration != body.Context.BackendGeneration {\\n',\n+        replace='\\t\\tbody.Binding.TerminalBackendID != body.Context.TerminalBackendID {\\n',\n+        count=1,\n+        run=\"TestExecuteCreateBindingAgreement/generation\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly generation-disagreeing bindings past the create agreement; every other disagreement still refuses. Kill path: the foreign creation reaches the engine instead of refusing.\",\n+    ),\n+    Mutant(\n+        name=\"N-lifecycle-backend-identity\",\n+        path=f\"{PACKAGE}/lifecycle.go\",\n+ 