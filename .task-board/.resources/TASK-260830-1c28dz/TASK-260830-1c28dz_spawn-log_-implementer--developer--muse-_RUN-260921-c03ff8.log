{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000f299","stream":{"kind":"session","id":"01a0c620-a10f-77d2-842c-eaf24fab8e2e"},"sequence":6055,"recorded_at":1780531400012105,"record_type":"event","durability":"durable","causation_id":"0cdc816d-6145-48a9-a49c-390655512ae9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"0cdc816d-6145-48a9-a49c-390655512ae9","run_stream":{"kind":"run","id":"0cdc816d-6145-48a9-a49c-390655512ae9"},"call_id":"call_01a0c668658d7454bf01cd81d54a4ab2","text":"Read text file `internal/tmuxserver/status.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"sort\"\n6|\t\"strconv\"\n7|\t\"strings\"\n8|\n9|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n12|)\n13|\n14|// ObserveStatus reports the tmux observation for one status body: the\n15|// live probe (list-panes for presence and provider rows, list-sessions\n16|// for attached counts) reconciled against the AX-side state memory. An\n17|// error is unknown, never absent: transport failures, malformed probe\n18|// output, and contradictory probes all refuse without a report.\n19|func (runner *backend) ObserveStatus(ctx context.Context, body terminstance.StatusBody) (terminstance.StatusObservation, error) {\n20|\tempty := terminstance.StatusObservation{}\n21|\tinstance := body.TerminalInstanceID\n22|\tif !body.HasTerminalInstanceID {\n23|\t\tresolved, err := runner.resolveSessionInstance(body.SessionID)\n24|\t\tif err != nil {\n25|\t\t\treturn empty, err\n26|\t\t}\n27|\t\tif resolved == \"\" {\n28|\t\t\treturn runner.absentObservation(body), nil\n29|\t\t}\n30|\t\tinstance = resolved\n31|\t}\n32|\tpresent, panes, err := runner.probePanes(ctx, instance)\n33|\tif err != nil {\n34|\t\treturn empty, err\n35|\t}\n36|\tattached := 0\n37|\tif present {\n38|\t\tcount, err := runner.probeAttached(ctx, instance)\n39|\t\tif err != nil {\n40|\t\t\treturn empty, err\n41|\t\t}\n42|\t\tattached = count\n43|\t}\n44|\tmemory, found, err := runner.lookupMemory(instance)\n45|\tif err != nil {\n46|\t\treturn empty, err\n47|\t}\n48|\tstate, wrapper, provider, attachable := ClassifyStatus(ClassifyInput{\n49|\t\tPresent:        present,\n50|\t\tAttached:       attached,\n51|\t\tProviderRows:   len(panes),\n52|\t\tMemory:         memory,\n53|\t\tMemoryFound:    found,\n54|\t\tAttachCapable:  runner.attachCapable(),\n55|\t\tProviderWanted: body.IncludeProviderObservation,\n56|\t\tProviderCapable: runner.admitted.Has(\"provider_process_observation\"),\n57|\t})\n58|\tproviderPresent, requested, evidenced := providerTriple(body.IncludeProviderObservation, runner.admitted.Has(\"provider_process_observation\"), provider)\n59|\tevidence := statusEvidence(instance, present, panes, attached)\n60|\treturn terminstance.StatusObservation{\n61|\t\tState:             state,\n62|\t\tIdentityMatch:     true,\n63|\t\tWrapperPresent:    wrapper,\n64|\t\tProviderPresent:   providerPresent,\n65|\t\tAttachable:        attachable,\n66|\t\tEvidenceIDs:       evidence,\n67|\t\tProviderRequested: requested,\n68|\t\tProviderEvidenced: evidenced,\n69|\t\tAttachEvidenced:   attachable,\n70|\t\tSessionID:         body.SessionID,\n71|\t\tInstanceID:        instance,\n72|\t\tBackendID:         body.TerminalBackendID,\n73|\t\tImplVersion:       body.ImplementationVersion,\n74|\t\tProtoVersion:      body.ProtocolVersion,\n75|\t\tGeneration:        body.BackendGeneration,\n76|\t}, nil\n77|}\n78|\n79|// resolveSessionInstance resolves a session-scoped query to the\n80|// session's recorded instance through the bootstrap binding store. An\n81|// unbound session resolves empty: it reads absent, never refused. A\n82|// binding read failure is unknown, never absence.\n83|func (runner *backend) resolveSessionInstance(sessionID string) (string, error) {\n84|\tif runner.bindings == nil {\n85|\t\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend binding store\"}\n86|\t}\n87|\tbinding, found, err := runner.bindings.Status(sessionID)\n88|\tif err != nil {\n89|\t\treturn \"\", err\n90|\t}\n91|\tif !found {\n92|\t\treturn \"\", nil\n93|\t}\n94|\treturn binding.TerminalInstanceID, nil\n95|}\n96|\n97|// absentObservation reports proven absence for an unbound session: the\n98|// absent shape with the queried session echoed, so the engine adopts a\n99|// match on the session it asked about and nothing else.\n100|func (runner *backend) absentObservation(body terminstance.StatusBody) terminstance.StatusObservation {\n101|\treturn terminstance.StatusObservation{\n102|\t\tState:             terminalbackend.StateAbsent,\n103|\t\tIdentityMatch:     true,\n104|\t\tWrapperPresent:    false,\n105|\t\tProviderPresent:   nil,\n106|\t\tAttachable:        false,\n107|\t\tEvidenceIDs:       []string{scalar.SHA256Digest([]byte(\"unbound\\n\" + body.SessionID)).String()},\n108|\t\tProviderRequested: body.IncludeProviderObservation,\n109|\t\tProviderEvidenced: false,\n110|\t\tAttachEvidenced:   false,\n111|\t\tSessionID:         body.SessionID,\n112|\t\tInstanceID:        body.TerminalInstanceID,\n113|\t\tBackendID:         body.TerminalBackendID,\n114|\t\tImplVersion:       body.ImplementationVersion,\n115|\t\tProtoVersion:      body.ProtocolVersion,\n116|\t\tGeneration:        body.BackendGeneration,\n117|\t}\n118|}\n119|\n120|// probePanes runs list-panes for one instance: exit 0 with at least one\n121|// row proves presence; any other exit proves absence of the session\n122|// (no stderr is parsed: the exit code is the verdict); a transport\n123|// error is unknown. An exit-0 with zero rows is contradictory — a tmux\n124|// session always has a pane — and refuses as unknown rather than\n125|// inventing presence.\n126|func (runner *backend) probePanes(ctx context.Context, instance string) (bool, []string, error) {\n127|\tsaved := runner.instanceID\n128|\trunner.instanceID = instance\n129|\tdefer func() { runner.instanceID = saved }()\n130|\targv, err := runner.command(DirectiveListPanes)\n131|\tif err != nil {\n132|\t\treturn false, nil, err\n133|\t}\n134|\tresult, err := runner.runner.Run(ctx, argv)\n135|\tif err != nil {\n136|\t\treturn false, nil, err\n137|\t}\n138|\tif result.ExitCode != 0 {\n139|\t\treturn false, nil, nil\n140|\t}\n141|\trows := splitRows(string(result.Stdout))\n142|\tif len(rows) == 0 {\n143|\t\treturn false, nil, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n144|\t}\n145|\treturn true, rows, nil\n146|}\n147|\n148|// probeAttached reads the attached-client count for one present\n149|// instance from list-sessions. A missing row contradicts the presence\n150|// probe (the session vanished between the two commands, or the list is\n151|// corrupt) and refuses as unknown; a malformed count refuses the same\n152|// way. Neither invents attachability.\n153|func (runner *backend) probeAttached(ctx context.Context, instance string) (int, error) {\n154|\targv, err := runner.command(DirectiveListSessions)\n155|\tif err != nil {\n156|\t\treturn 0, err\n157|\t}\n158|\tresult, err := runner.runner.Run(ctx, argv)\n159|\tif err != nil {\n160|\t\treturn 0, err\n161|\t}\n162|\tif result.ExitCode != 0 {\n163|\t\treturn 0, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n164|\t}\n165|\tfor _, row := range splitRows(string(result.Stdout)) {\n166|\t\tname, count, ok := cutRow(row)\n167|\t\tif !ok {\n168|\t\t\treturn 0, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n169|\t\t}\n170|\t\tif name != instance {\n171|\t\t\tcontinue\n172|\t\t}\n173|\t\tattached, err := strconv.Atoi(count)\n174|\t\tif err != nil || attached < 0 {\n175|\t\t\treturn 0, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n176|\t\t}\n177|\t\treturn attached, nil\n178|\t}\n179|\treturn 0, &terminstance.Error{Code: terminalbackend.CodeUnavailable, Detail: \"status observation unknown\"}\n180|}\n181|\n182|// lookupMemory reads the AX-side state memory for one instance. The\n183|// store may be nil in unit-scoped backends; a nil store reads as no\n184|// memory rather than refusing, because presence alone still classifies\n185|// the live triad (absent/parked/active).\n186|func (runner *backend) lookupMemory(instance string) (terminalbackend.InstanceState, bool, error) {\n187|\tif runner.states == nil {\n188|\t\treturn \"\", false, nil\n189|\t}\n190|\treturn runner.states.Lookup(instance)\n191|}\n192|\n193|// attachCapable reports whether any admitted attach capability\n194|// evidences presentation right now: local, remote, or web attach.\n195|func (runner *backend) attachCapable() bool {\n196|\treturn runner.admitted.Has(\"local_attach\") ||\n197|\t\trunner.admitted.Has(\"remote_attach\") ||\n198|\t\trunner.admitted.Has(\"web_attach\")\n199|}\n200|\n201|// providerTriple computes the provider_present member and its two\n202|// validation flags: the member is non-null only when observation was\n203|// requested and evidenced; the flags let the landed CheckStatusResult\n204|// verify that rule.\n205|func providerTriple(requested, capable, observed bool) (*bool, bool, bool) {\n206|\tif !requested || !capable {\n207|\t\treturn nil, requested, false\n208|\t}\n209|\tif !observed {\n210|\t\treturn nil, requested, false\n211|\t}\n212|\tpresent := true\n213|\treturn &present, requested, true\n214|}\n215|\n216|// statusEvidence derives the sorted-unique status evidence digests over\n217|// the probe record: presence, pane rows, and attached count. Absence\n218|// evidences the negative probe, never an empty set.\n219|func statusEvidence(instance string, present bool, panes []string, attached int) []string {\n220|\tvar evidence []string\n221|\tif !present {\n222|\t\tevidence = append(evidence, scalar.SHA256Digest([]byte(\"absent\\n\"+instance)).String())\n223|\t} else {\n224|\t\tevidence = append(evidence, scalar.SHA256Digest([]byte(\"panes\\n\"+instance+\"\\n\"+strings.Join(panes, \"\\n\"))).String())\n225|\t\tevidence = append(evidence, scalar.SHA256Digest([]byte(\"sessions\\n\"+instance+\"\\n\"+strconv.Itoa(attached))).String())\n226|\t}\n227|\tsort.Strings(evidence)\n228|\treturn evidence\n229|}\n230|\n231|// splitRows splits probe stdout into non-empty rows. Blank lines are\n232|// skipped: tmux never emits them, and skipping is the tolerant read;\n233|// a wholly blank output yields zero rows, which the callers refuse.\n234|func splitRows(output string) []string {\n235|\tvar rows []string\n236|\tfor _, line := range strings.Split(output, \"\\n\") {\n237|\t\tif line != \"\" {\n238|\t\t\trows = append(rows, line)\n239|\t\t}\n240|\t}\n241|\treturn rows\n242|}\n243|\n244|// cutRow splits one sessions row into name and attached count. Rows\n245|// without the pipe separator are malformed.\n246|func cutRow(row string) (string, string, bool) {\n247|\tname, count, found := strings.Cut(row, \"|\")\n248|\tif !found || name == \"\" || count == \"\" {\n249|\t\treturn \"\", \"\", false\n250|\t}\n251|\treturn name, count, true\n252|}\n253|\n254|// ClassifyInput is the pure status-classification input: the live tmux\n255|// probe (presence, attached count, provider rows) plus the AX-side\n256|// memory and the capability facts.\n257|type ClassifyInput struct {\n258|\tPresent         bool\n259|\tAttached        int\n260|\tProviderRows    int\n261|\tMemory          terminalbackend.InstanceState\n262|\tMemoryFound     bool\n263|\tAttachCapable   bool\n264|\tProviderWanted  bool\n265|\tProviderCapable bool\n266|\t_               struct{}\n267|}\n268|\n269|// ClassifyStatus reconciles the live tmux probe against the AX-side\n270|// state memory into the adopted status: state, wrapper presence,\n271|// provider presence, and attachability. tmux reports only presence;\n272|// the memory carries quiescing, stopped, and stale_fenced, which exist\n273|// only on this side. The rules:\n274|//\n275|//   - absent probe, no memory (or memory absent): absent, no wrapper;\n276|//   - absent probe, memory stopped or stale_fenced: the memory state,\n277|//     no wrapper (a fenced incarnation keeps its fencing without a wrapper);\n278|//   - absent probe, memory quiescing/active/parked/unavailable: unavailable\n279|//     (contradiction: the wrapper vanished, or was never proven);\n280|//   - present probe, memory quiescing or stale_fenced: the memory state\n281|//     (tmux cannot show either; a fenced incarnation with a live wrapper\n282|//     is what terminate-stale kills);\n283|//   - present probe, memory stopped or unavailable: unavailable\n284|//     (contradiction: a session resurrected, or was never proven);\n285|//   - present probe, memory active/parked/absent/none: active when at\n286|//     least one client is attached, otherwise parked.\n287|//\n288|// Attachability needs parked|active plus a currently evidenced attach\n289|// capability; provider presence needs at least one pane row. Memory\n290|// creating is unreachable (Record refuses it) and classifies\n291|// unavailable either way.\n292|func ClassifyStatus(input ClassifyInput) (terminalbackend.InstanceState, bool, bool, bool) {\n293|\tif !input.Present {\n294|\t\treturn classifyAbsent(input)\n295|\t}\n296|\treturn classifyPresent(input)\n297|}\n298|\n299|// classifyAbsent adopts the state for an absent probe.\n300|func classifyAbsent(input ClassifyInput) (terminalbackend.InstanceState, bool, bool, bool) {\n301|\tif !input.MemoryFound || input.Memory == terminalbackend.StateAbsent {\n302|\t\treturn terminalbackend.StateAbsent, false, false, false\n303|\t}\n304|\tswitch input.Memory {\n305|\tcase terminalbackend.StateStopped, terminalbackend.StateStaleFenced:\n306|\t\treturn input.Memory, false, false, false\n307|\tdefault:\n308|\t\treturn terminalbackend.StateUnavailable, false, false, false\n309|\t}\n310|}\n311|\n312|// classifyPresent adopts the state for a present probe.\n313|func classifyPresent(input ClassifyInput) (terminalbackend.InstanceState, bool, bool, bool) {\n314|\tprovider := input.ProviderRows > 0\n315|\tswitch input.Memory {\n316|\tcase terminalbackend.StateQuiescing, terminalbackend.StateStaleFenced:\n317|\t\tif !input.MemoryFound {\n318|\t\t\tbreak\n319|\t\t}\n320|\t\treturn input.Memory, true, provider, false\n321|\tcase terminalbackend.StateStopped, terminalbackend.StateUnavailable:\n322|\t\tif !input.MemoryFound {\n323|\t\t\tbreak\n324|\t\t}\n325|\t\treturn terminalbackend.StateUnavailable, false, false, false\n326|\tcase terminalbackend.StateCreating:\n327|\t\treturn terminalbackend.StateUnavailable, false, false, false\n328|\tdefault:\n329|\t}\n330|\tstate := terminalbackend.StateParked\n331|\tif input.Attached > 0 {\n332|\t\tstate = terminalbackend.StateActive\n333|\t}\n334|\tattachable := input.AttachCapable && (state == terminalbackend.StateParked || state == terminalbackend.StateActive)\n335|\treturn state, true, provider, attachable\n336|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
