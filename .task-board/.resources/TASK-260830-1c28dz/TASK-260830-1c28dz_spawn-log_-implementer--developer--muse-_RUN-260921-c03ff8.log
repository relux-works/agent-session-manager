 != tc.wantFlags[1] {\n+\t\t\tt.Fatalf(\"flags(%v,%v,%v) = %v/%v\", tc.requested, tc.capable, tc.observed, requested, evidenced)\n+\t\t}\n+\t}\n+}\n+\n+func TestCutRowShapes(t *testing.T) {\n","final_result":true}}}
