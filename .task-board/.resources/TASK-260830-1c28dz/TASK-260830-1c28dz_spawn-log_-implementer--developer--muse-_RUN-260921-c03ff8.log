{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ea31","stream":{"kind":"session","id":"01a0c620-a10f-77d2-842c-eaf24fab8e2e"},"sequence":4979,"recorded_at":1780531400009953,"record_type":"event","durability":"durable","causation_id":"0cdc816d-6145-48a9-a49c-390655512ae9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0cdc816d-6145-48a9-a49c-390655512ae9","run_stream":{"kind":"run","id":"0cdc816d-6145-48a9-a49c-390655512ae9"},"task_stream":{"kind":"task","id":"01a0c65d-b850-7870-90fb-ffb18e5b6870"},"task_id":"01a0c65d-b850-7870-90fb-ffb18e5b6870","event":{"kind":"output","task_id":"01a0c65d-b850-7870-90fb-ffb18e5b6870","chunk":"Read text file `internal/tmuxserver/ops.go`.\n(149 line(s) above)\n150|\t\t}\n151|\tdefault:\n152|\t\treturn &Error{Code: terminalbackend.CodeProtocolError, Detail: \"presentation transport vocabulary\"}\n153|\t}\n154|\treturn nil\n155|}\n156|\n157|// executeTerminate runs one terminate-stale: closed-shape admission,\n158|// idempotency material, capability conferral plus the dual conditional,\n159|// transition, force_stale authorization, generation recheck, landed\n160|// fencing authorization, deadline, receipt discipline with\n161|// status-reconciled resume, and the kill plus close-confirm effects.\n162|func (lc *Lifecycle) executeTerminate(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\n163|\tempty := OpOutcome{Operation: terminalbackend.OperationTerminateStale}\n164|\tbody, err := parseTerminateBody(req.Body)\n165|\tif err != nil {\n166|\t\treturn empty, err\n167|\t}\n168|\toperation := terminalbackend.OperationTerminateStale\n169|\tmctx := body.Context\n170|\tsource := terminalbackend.InstanceState(req.Source)\n171|\tif err := checkLifecycleBackend(mctx.TerminalBackendID); err != nil {\n172|\t\treturn empty, err\n173|\t}\n174|\tderived, err := terminalbackend.IdempotencyKey(string(operation), mctx.TerminalInstanceID, \"terminate\", body.StaleLeaseID, strconv.FormatUint(body.StaleEpoch, 10))\n175|\tif err != nil {\n176|\t\treturn empty, err\n177|\t}\n178|\tif mctx.IdempotencyKey != derived {\n179|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"idempotency key material\"}\n180|\t}\n181|\tif err := terminalbackend.CheckOperation(string(operation), req.Admitted); err != nil {\n182|\t\tfailure := rowError(operation, err)\n183|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n184|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n185|\t}\n186|\tif err := checkTerminateCapability(req.Admitted); err != nil {\n187|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n188|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n189|\t}\n190|\ttarget, effects, err := terminalbackend.CheckTransition(string(operation), string(source), false)\n191|\tif err != nil {\n192|\t\tfailure := rowError(operation, err)\n193|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n194|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n195|\t}\n196|\tif err := terminstance.CheckAuthorization(mctx.Authorization, terminstance.AuthorizationForceStale, lc.CurrentLease(), lc.Now()); err != nil {\n197|\t\tfailure := rowError(operation, err)\n198|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n199|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n200|\t}\n201|\tif lc.CurrentGeneration() != mctx.BackendGeneration {\n202|\t\tfailure := &Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation stale\"}\n203|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\n204|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n205|\t}\n206|\tif err := mapFencingError(fencing.AuthorizeTerminateStale(req.Presented, req.Winner, req.HasWinner, req.ForceRecovery, req.DiagnosticsPreserved)); err != nil {\n207|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n208|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n209|\t}\n210|\tif err := checkTerminateTarget(mctx, body, req.Presented); err != nil {\n211|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n212|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n213|\t}\n214|\tif err := checkTerminateWinner(mctx, req.Winner, lc.CurrentLease()); err != nil {\n215|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(err), false))\n216|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, err\n217|\t}\n218|\tdeadline, err := mctx.Deadline.Time()\n219|\tif err != nil {\n220|\t\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"mutation context deadline\"}\n221|\t}\n222|\tif !lc.Now().Before(deadline) {\n223|\t\tfailure := &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\n224|\t\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionReplaySame)\n225|\t\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\n226|\t}\n227|\treqBackend := lc.requestBackend(req, socket, mctx.SessionID, mctx.TerminalInstanceID)\n228|\treqBackend.operation = operation\n229|\treqBackend.deadline = deadline\n230|\treturn lc.executeWithReceipt(ctx, req, socket, operation, mctx, source, target, effects, deadline, terminstance.AuthorizationForceStale, reqBackend, func(result terminstance.Result) OpOutcome {\n231|\t\treturn OpOutcome{Operation: operation, Mutation: &result, TargetClosed: true}\n232|\t})\n233|}\n234|\n235|// checkTerminateCapability enforces the dual conditional: stale\n236|// termination needs stale_process_termination AND\n237|// provider_process_observation. Each arm refuses alone.\n238|func checkTerminateCapability(admitted terminalbackend.Admitted) error {\n239|\tif !admitted.Has(\"stale_process_termination\") {\n240|\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n241|\t}\n242|\tif !admitted.Has(\"provider_process_observation\") {\n243|\t\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\n244|\t}\n245|\treturn nil\n246|}\n247|\n248|// mapFencingError maps the landed terminate-stale authorization onto\n249|// the row's allowed set: malformed fencing material is the protocol\n250|// error, every other fencing refusal — no winner, no force, no\n251|// diagnostics, target mismatch, live owner — is the failed local\n252|// precondition. lease_conflict maps to the precondition too: the row\n253|// has no lease_conflict member, and a target fenced by another\n254|// session's winner fails the fenced-target precondition.\n255|func mapFencingError(err error) error {\n256|\tif err == nil {\n257|\t\treturn nil\n258|\t}\n259|\tif errors.Is(err, fencing.ErrInvalidArguments) {\n260|\t\treturn &Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminate fencing material\"}\n261|\t}\n262|\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate fencing authorization\"}\n263|}\n264|\n265|// checkTerminateTarget binds the presented fencing token to the\n266|// request: session, stale lease, and stale epoch must all agree with\n267|// the context and body. Any disagreement refuses the failed local\n268|// precondition: the retry would authorize a different target than the\n269|// key names.\n270|func checkTerminateTarget(mctx terminstance.MutationContext, body TerminateBody, presented fencing.PresentedToken) error {\n271|\tif presented.SessionID != mctx.SessionID ||\n272|\t\tpresented.LeaseID != body.StaleLeaseID ||\n273|\t\tpresented.Epoch != body.StaleEpoch {\n274|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate target binding\"}\n275|\t}\n276|\treturn nil\n277|}\n278|\n279|// checkTerminateWinner binds the caller-observed winner to the\n280|// re-read current lease: the fencing authorization decides over the\n281|// caller's winner, and only a winner that still wins authorizes. A\n282|// rotated or misobserved winner refuses the failed local\n283|// precondition; the caller re-observes and retries. Absence of a\n284|// winner never reaches here — the fencing gate refuses it first.\n285|func checkTerminateWinner(mctx terminstance.MutationContext, winner sessrepo.LeaseSummary, lease terminstance.LeaseView) error {\n286|\tif winner.SessionID != mctx.SessionID ||\n287|\t\twinner.LeaseID != lease.LeaseID ||\n288|\t\twinner.Epoch != lease.Epoch {\n289|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate winner binding\"}\n290|\t}\n291|\treturn nil\n292|}\n293|\n294|// executeRestore runs one restore: closed-shape admission, idempotency\n(more lines below)","final_result":true}}}
