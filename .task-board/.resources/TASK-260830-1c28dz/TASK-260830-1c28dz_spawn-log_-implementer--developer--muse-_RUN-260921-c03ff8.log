{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000f2fb","stream":{"kind":"session","id":"01a0c620-a10f-77d2-842c-eaf24fab8e2e"},"sequence":6104,"recorded_at":1780531400012203,"record_type":"event","durability":"durable","causation_id":"0cdc816d-6145-48a9-a49c-390655512ae9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0cdc816d-6145-48a9-a49c-390655512ae9","run_stream":{"kind":"run","id":"0cdc816d-6145-48a9-a49c-390655512ae9"},"task_stream":{"kind":"task","id":"01a0c668-c95e-7981-a4bb-acb2f7c26492"},"task_id":"01a0c668-c95e-7981-a4bb-acb2f7c26492","event":{"kind":"output","task_id":"01a0c668-c95e-7981-a4bb-acb2f7c26492","chunk":"Read text file `internal/tmuxserver/probe.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"errors\"\n6|\t\"net\"\n7|\t\"os\"\n8|\t\"syscall\"\n9|\t\"time\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n14|)\n15|\n16|// DialOutcome is one unix-socket dial verdict: the socket answers, the\n17|// socket is stale (connection refused: no listener), or the dial\n18|// proves nothing (any other failure). Liveness is decided by connect,\n19|// never by parsing daemon stderr: no gate here inspects source text.\n20|type DialOutcome string\n21|\n22|// Dial outcomes.\n23|const (\n24|\tDialLive    DialOutcome = \"live\"\n25|\tDialStale   DialOutcome = \"stale\"\n26|\tDialUnknown DialOutcome = \"unknown\"\n27|)\n28|\n29|// Dialer dials the dedicated socket and reports the outcome. The\n30|// production dialer connects over unix with a short timeout; tests\n31|// inject fakes. A live outcome never proves attestation — only that a\n32|// listener answers — and a stale outcome never proves absence of all\n33|// servers, only that this socket has no listener.\n34|type Dialer interface {\n35|\tDial(socket string) DialOutcome\n36|}\n37|\n38|// UnixDialer is the production Dialer.\n39|type UnixDialer struct {\n40|\t// Timeout bounds one dial. Zero means one second.\n41|\tTimeout time.Duration\n42|}\n43|\n44|// Dial connects to socket over unix: success is live; ECONNREFUSED or\n45|// ENOENT is stale; every other failure (timeout, permission,\n46|// impossible length) is unknown. ENOENT is stale rather than unknown\n47|// because the caller length-gates and custody-checks first: under a\n48|// verified parent, a missing socket proves no bind, not a broken\n49|// tree. This function dials only.\n50|func (dialer UnixDialer) Dial(socket string) DialOutcome {\n51|\ttimeout := dialer.Timeout\n52|\tif timeout <= 0 {\n53|\t\ttimeout = time.Second\n54|\t}\n55|\tconn, err := net.DialTimeout(\"unix\", socket, timeout)\n56|\tif err == nil {\n57|\t\t_ = conn.Close()\n58|\t\treturn DialLive\n59|\t}\n60|\tvar errno syscall.Errno\n61|\tif errors.As(err, &errno) && (errno == syscall.ECONNREFUSED || errno == syscall.ENOENT) {\n62|\t\treturn DialStale\n63|\t}\n64|\treturn DialUnknown\n65|}\n66|\n67|// AdmitServer is the server attestation verdict over the exact live\n68|// socket: the landed Reconcile admission the probe binds to the\n69|// request generation. Production wires terminalbackend.Reconcile over\n70|// the caller-supplied Manifest, Probe, evidence, generation, clock,\n71|// and signature verifier; tests inject verdicts directly.\n72|type AdmitServer func() (RealmAdmission, error)\n73|\n74|// ReconcileAdmission closes AdmitServer over the landed admission:\n75|// manifest, probe, evidence, the AX-known raw generation, the\n76|// admission instant, and the trusted-registry signature verifier. A\n77|// nil verifier fails closed inside Reconcile, never here.\n78|func ReconcileAdmission(manifest terminalbackend.Manifest, probe terminalbackend.Probe, evidence []terminalbackend.Evidence, rawGeneration string, now time.Time, verify terminalbackend.SignatureVerifier) AdmitServer {\n79|\treturn func() (RealmAdmission, error) {\n80|\t\tadmitted, err := terminalbackend.Reconcile(manifest, probe, evidence, rawGeneration, now, verify)\n81|\t\tif err != nil {\n82|\t\t\treturn RealmAdmission{}, err\n83|\t\t}\n84|\t\treturn RealmAdmission{Admitted: admitted, RawGeneration: rawGeneration}, nil\n85|\t}\n86|}\n87|\n88|// ServerProber is the production ProbeServer dependency: custody,\n89|// length, dial, then admission. Before connect it enforces the\n90|// before-connect custody rejection and the sun_path length refusal; a\n91|// live socket reports the admission verdict, a stale socket reports\n92|// not-running, and an unknown dial passes through as unknown (never\n93|// unavailable, never absent).\n94|type ServerProber struct {\n95|\t// Root is the Runtime IPC root the socket must sit under.\n96|\tRoot string\n97|\t// Platform selects the sun_path limit.\n98|\tPlatform scalar.Platform\n99|\t// Dialer connects to the socket. Nil refuses: no probe runs\n100|\t// without its dependency.\n101|\tDialer Dialer\n102|\t// Admit reports the landed admission verdict. Nil refuses.\n103|\tAdmit AdmitServer\n104|}\n105|\n106|// Probe implements Dependencies.ProbeServer.\n107|func (prober ServerProber) Probe(socket string) (ServerReport, error) {\n108|\tif prober.Dialer == nil || prober.Admit == nil {\n109|\t\treturn ServerReport{}, &Error{Code: CodeInvalidArguments, Detail: \"probe dependencies\"}\n110|\t}\n111|\tif err := CheckSocketLength(socket, prober.Platform); err != nil {\n112|\t\treturn ServerReport{}, err\n113|\t}\n114|\tif err := CheckSocketCustody(socket, prober.Root, prober.Platform); err != nil {\n115|\t\treturn ServerReport{}, err\n116|\t}\n117|\tswitch prober.Dialer.Dial(socket) {\n118|\tcase DialStale:\n119|\t\treturn ServerReport{Running: false}, nil\n120|\tcase DialUnknown:\n121|\t\treturn ServerReport{}, &Error{Code: CodeSpawnFailed, Detail: \"server probe\"}\n122|\tcase DialLive:\n123|\t\tadmission, err := prober.Admit()\n124|\t\tif err != nil {\n125|\t\t\treturn ServerReport{}, err\n126|\t\t}\n127|\t\treturn ServerReport{Running: true, Admission: admission}, nil\n128|\tdefault:\n129|\t\treturn ServerReport{}, &Error{Code: CodeSpawnFailed, Detail: \"server probe\"}\n130|\t}\n131|}\n132|\n133|// BrokerProber is the production ProbeBroker dependency. No Aqua broker\n134|// IPC exists in the tree, so the production probe reports the miss:\n135|// the zero report (no authenticated principal, no attested server),\n136|// which the broker-or-refuse rule maps to the typed\n137|// capability_unavailable. Contacting a broker is MAY in the spec, so\n138|// an honest miss is compliant; the broker path stays reachable through\n139|// injected Dependencies (proven by the acquisition suite), and a\n140|// future broker-IPC task owns the transport. This bound is stated, not\n141|// silent: Probe documents it on every call site.\n142|type BrokerProber struct{}\n143|\n144|// Probe implements Dependencies.ProbeBroker by reporting no broker.\n145|func (BrokerProber) Probe() (BrokerReport, error) {\n146|\treturn BrokerReport{}, nil\n147|}\n148|\n149|// SpawnHooks arms the crash boundary of the spawn commit. AfterUnlink\n150|// runs after a stale socket is unlinked and before the server is\n151|// spawned — only when a stale file was actually removed — so a crash\n152|// there leaves a retry that binds clean. Hooks is nil in production.\n153|type SpawnHooks struct {\n154|\tAfterUnlink func(socket string)\n155|}\n156|\n157|// ServerSpawner is the production Dependencies.Spawn dependency: the\n158|// bind step. Before bind it enforces the length refusal, the\n159|// before-bind custody rejection, and the exec-site socket pin (the\n160|// argv must address exactly this socket — the second side of the pin\n161|// gate whose first side is BuildCommand/BuildArgv); then it unlinks a\n162|// stale socket, if any, and spawns through the runner. A crash between\n163|// unlink and spawn leaves no socket behind, so a retry binds clean.\n164|type ServerSpawner struct {\n165|\t// Root is the Runtime IPC root the socket must sit under.\n166|\tRoot string\n167|\t// Platform selects the sun_path limit.\n168|\tPlatform scalar.Platform\n169|\t// Runner executes the spawn vector. Nil refuses.\n170|\tRunner Runner\n171|\t// Hooks arms the crash boundary. Nil in production.\n172|\tHooks *SpawnHooks\n173|}\n174|\n175|// Spawn implements Dependencies.Spawn.\n176|func (spawner ServerSpawner) Spawn(socket string, argv []string) error {\n177|\tif spawner.Runner == nil {\n178|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"spawn dependencies\"}\n179|\t}\n180|\tif err := CheckSocketLength(socket, spawner.Platform); err != nil {\n181|\t\treturn err\n182|\t}\n183|\tif err := CheckSocketCustody(socket, spawner.Root, spawner.Platform); err != nil {\n184|\t\treturn err\n185|\t}\n186|\tif err := checkSpawnAddresses(argv, socket); err != nil {\n187|\t\treturn err\n188|\t}\n189|\tremoved, err := unlinkStaleSocket(socket)\n190|\tif err != nil {\n191|\t\treturn err\n192|\t}\n193|\tif removed && spawner.Hooks != nil && spawner.Hooks.AfterUnlink != nil {\n194|\t\tspawner.Hooks.AfterUnlink(socket)\n195|\t}\n196|\tresult, err := spawner.Runner.Run(context.Background(), argv)\n197|\tif err != nil {\n198|\t\treturn &Error{Code: CodeSpawnFailed, Detail: \"server spawn\"}\n199|\t}\n200|\tif result.ExitCode != 0 {\n201|\t\treturn &Error{Code: CodeSpawnFailed, Detail: \"server spawn\"}\n202|\t}\n203|\treturn nil\n204|}\n205|\n206|// checkSpawnAddresses is the exec-site socket pin: the spawn vector\n207|// must be a tmux -S vector addressing exactly this socket. A vector\n208|// for any other socket — however it was built — refuses here instead\n209|// of spawning a substituted server. The argv shape gate runs first so\n210|// a malformed vector reports the shape refusal, not the pin.\n211|func checkSpawnAddresses(argv []string, socket string) error {\n212|\tif err := secprim.CheckArgv(argv); err != nil {\n213|\t\treturn &Error{Code: CodeInvalidArguments, Detail: \"spawn argv\"}\n214|\t}\n215|\tif len(argv) < 3 || argv[0] != \"tmux\" || argv[1] != \"-S\" || argv[2] != socket {\n216|\t\treturn &Error{Code: CodeAmbientReuse, Detail: \"spawn socket\"}\n217|\t}\n218|\treturn nil\n219|}\n220|\n221|// unlinkStaleSocket removes a stale socket file before bind and reports\n222|// whether it removed one. Custody already proved the path is absent or\n223|// a socket; anything else refuses instead of unlinking. Absence is a\n224|// no-op: bind proceeds.\n225|func unlinkStaleSocket(socket string) (bool, error) {\n226|\tinfo, err := os.Lstat(socket)\n227|\tif err != nil {\n228|\t\tif os.IsNotExist(err) {\n229|\t\t\treturn false, nil\n230|\t\t}\n231|\t\treturn false, &Error{Code: CodeSpawnFailed, Detail: \"server spawn\"}\n232|\t}\n233|\tif info.Mode().Type() != os.ModeSocket {\n234|\t\treturn false, &Error{Code: CodeUnsafeSocketPath, Detail: \"socket kind\"}\n235|\t}\n236|\tif err := os.Remove(socket); err != nil {\n237|\t\treturn false, &Error{Code: CodeSpawnFailed, Detail: \"server spawn\"}\n238|\t}\n239|\treturn true, nil\n240|}\n241|\n242|// Production wires the production exec/probe adapters into the\n243|// acquisition Dependencies: the server prober (custody, length, dial,\n244|// landed admission), the broker miss, and the bind-step spawner. The\n245|// caller supplies the runtime root, platform, runner, dialer, and\n246|// admission verdict; tests inject fakes for the runner and dialer and\n247|// drive every gate deterministically with no tmux process anywhere.\n248|func Production(root string, platform scalar.Platform, runner Runner, dialer Dialer, admit AdmitServer) Dependencies {\n249|\tprober := ServerProber{Root: root, Platform: platform, Dialer: dialer, Admit: admit}\n250|\tspawner := ServerSpawner{Root: root, Platform: platform, Runner: runner}\n251|\treturn Dependencies{\n252|\t\tProbeServer: prober.Probe,\n253|\t\tProbeBroker: BrokerProber{}.Probe,\n254|\t\tSpawn:       spawner.Spawn,\n255|\t}\n256|}","final_result":true}}}
