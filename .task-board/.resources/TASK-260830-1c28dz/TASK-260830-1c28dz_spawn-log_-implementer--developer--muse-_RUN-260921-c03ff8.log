{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ef11","stream":{"kind":"session","id":"01a0c620-a10f-77d2-842c-eaf24fab8e2e"},"sequence":5603,"recorded_at":1780531400011201,"record_type":"event","durability":"durable","causation_id":"0cdc816d-6145-48a9-a49c-390655512ae9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0cdc816d-6145-48a9-a49c-390655512ae9","run_stream":{"kind":"run","id":"0cdc816d-6145-48a9-a49c-390655512ae9"},"task_stream":{"kind":"task","id":"01a0c663-f2a9-7e61-8438-ce6407eb7d80"},"task_id":"01a0c663-f2a9-7e61-8438-ce6407eb7d80","event":{"kind":"output","task_id":"01a0c663-f2a9-7e61-8438-ce6407eb7d80","chunk":"{\n  \"chunk_id\": \"exec-153-1\",\n  \"command\": \"grep -n \\\"type Hooks\\\" -A 10 internal/tmuxserver/*.go | grep -v _test | head -14; echo ===RESTORE-TEST===; sed -n '436,486p' internal/tmuxserver/lifecycle_ops_unix_test.go\",\n  \"description\": \"Read Hooks and restore tests\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"internal/tmuxserver/runtime.go:23:type Hooks struct {\\ninternal/tmuxserver/runtime.go-24-\\tAfterMkdir func(dir string)\\ninternal/tmuxserver/runtime.go-25-}\\ninternal/tmuxserver/runtime.go-26-\\ninternal/tmuxserver/runtime.go-27-// EnsureRuntimeDir creates the owner-only runtime directory\\ninternal/tmuxserver/runtime.go-28-// root/name when absent and verifies it when present, returning the\\ninternal/tmuxserver/runtime.go-29-// joined path. Creation and verification enforce three independent\\ninternal/tmuxserver/runtime.go-30-// gates — containment, mode, ownership — and each refuses alone:\\ninternal/tmuxserver/runtime.go-31-//\\ninternal/tmuxserver/runtime.go-32-//   - containment: the root must be an absolute path on the platform\\ninternal/tmuxserver/runtime.go-33-//     grammar, the name must be one relative segment, and the commit\\n===RESTORE-TEST===\\nfunc TestExecuteRestore(t *testing.T) {\\n\\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\\n\\trecordBinding(t, fx, lxDigestA)\\n\\tfx.runner.queue(\\\"new-session\\\", \\\"\\\", 0)\\n\\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\\n\\t\\tOperation: \\\"restore\\\", Body: lxRestoreBody(t, lxDigestA, nil), Source: \\\"absent\\\", Admitted: fullLifecycleAdmitted(),\\n\\t})\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tif outcome.Mutation.After != terminalbackend.StateParked || !outcome.RestoredParked {\\n\\t\\tt.Fatalf(\\\"outcome = %+v\\\", outcome)\\n\\t}\\n\\tif outcome.PriorBindingID != lxDigestA {\\n\\t\\tt.Fatalf(\\\"prior = %q\\\", outcome.PriorBindingID)\\n\\t}\\n\\tstate, _, _ := fx.lc.States.Lookup(lxInstance)\\n\\tif state != terminalbackend.StateParked {\\n\\t\\tt.Fatalf(\\\"memory = %s\\\", state)\\n\\t}\\n}\\n\\nfunc TestExecuteRestoreMismatch(t *testing.T) {\\n\\tt.Run(\\\"wrong-digest\\\", func(t *testing.T) {\\n\\t\\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\\n\\t\\trecordBinding(t, fx, lxDigestA)\\n\\t\\t_, err := fx.lc.Execute(context.Background(), OpRequest{\\n\\t\\t\\tOperation: \\\"restore\\\", Body: lxRestoreBody(t, lxDigestB, nil), Source: \\\"absent\\\", Admitted: fullLifecycleAdmitted(),\\n\\t\\t})\\n\\t\\trequireLocalCode(t, err, \\\"terminal_backend_restore_mismatch\\\", \\\"restore prior binding\\\")\\n\\t\\tif fx.runner.callCount() != 0 {\\n\\t\\t\\tt.Fatalf(\\\"mismatched restore execed %d commands\\\", fx.runner.callCount())\\n\\t\\t}\\n\\t})\\n\\tt.Run(\\\"unrecorded\\\", func(t *testing.T) {\\n\\t\\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\\n\\t\\t_, err := fx.lc.Execute(context.Background(), OpRequest{\\n\\t\\t\\tOperation: \\\"restore\\\", Body: lxRestoreBody(t, lxDigestA, nil), Source: \\\"absent\\\", Admitted: fullLifecycleAdmitted(),\\n\\t\\t})\\n\\t\\trequireLocalCode(t, err, \\\"terminal_backend_restore_mismatch\\\", \\\"restore prior binding\\\")\\n\\t})\\n\\tt.Run(\\\"bad-source\\\", func(t *testing.T) {\\n\\t\\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\\n\\t\\trecordBinding(t, fx, lxDigestA)\\n\\t\\t_, err := fx.lc.Execute(context.Background(), OpRequest{\\n\\t\\t\\tOperation: \\\"restore\\\", Body: lxRestoreBody(t, lxDigestA, nil), Source: \\\"active\\\", Admitted: fullLifecycleAdmitted(),\\n\\t\\t})\\n\\t\\trequireLandedCode(t, err, \\\"local_precondition_failed\\\")\\n\\t})\\n}\\n\\n\",\n  \"original_output_bytes\": 2916,\n  \"original_output_tokens\": 729,\n  \"truncated\": false\n}","final_result":true}}}
