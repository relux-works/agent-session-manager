{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000e235","stream":{"kind":"session","id":"01a0c620-a10f-77d2-842c-eaf24fab8e2e"},"sequence":3957,"recorded_at":1780531400007909,"record_type":"event","durability":"durable","causation_id":"0cdc816d-6145-48a9-a49c-390655512ae9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0cdc816d-6145-48a9-a49c-390655512ae9","run_stream":{"kind":"run","id":"0cdc816d-6145-48a9-a49c-390655512ae9"},"task_stream":{"kind":"task","id":"01a0c651-880e-7463-a623-c9f91df93d79"},"task_id":"01a0c651-880e-7463-a623-c9f91df93d79","event":{"kind":"output","task_id":"01a0c651-880e-7463-a623-c9f91df93d79","chunk":"edited\nchanged lines: lines 125-155\n--- original\n+++ updated\n@@\n-func TestRowErrorCoversEightRows(t *testing.T) {\n-\t// Every row keeps its timeout/process codes and normalizes the\n-\t// restore mismatch (admitted only on restore).\n-\tfor _, operation := range []terminalbackend.Operation{\n-\t\tterminalbackend.OperationCreate, terminalbackend.OperationAttach,\n-\t\tterminalbackend.OperationStatus, terminalbackend.OperationQuiesceInput,\n-\t\tterminalbackend.OperationWaitSafeBoundary, terminalbackend.OperationRequestStop,\n-\t\tterminalbackend.OperationTerminateStale, terminalbackend.OperationRestore,\n-\t} {\n-\t\tkept := rowError(operation, &terminalbackend.Error{Code: \"terminal_backend_timeout\", Detail: \"x\"})\n-\t\tvar landed *terminalbackend.Error\n-\t\tif operation == terminalbackend.OperationStatus || operation == terminalbackend.OperationWaitSafeBoundary ||\n-\t\t\toperation == terminalbackend.OperationRequestStop {\n-\t\t\t// status carries terminal_backend_timeout; boundary and\n-\t\t\t// stop carry their dedicated timeouts instead.\n-\t\t\tif operation != terminalbackend.OperationStatus {\n-\t\t\t\tcontinue\n-\t\t\t}\n-\t\t}\n-\t\t_ = kept\n-\t\t_ = landed\n-\t\tmismatch := rowError(operation, &terminalbackend.Error{Code: \"terminal_backend_restore_mismatch\", Detail: \"x\"})\n-\t\tif operation == terminalbackend.OperationRestore {\n-\t\t\tif !isLandedError(mismatch, &landed) || landed.Code != \"terminal_backend_restore_mismatch\" {\n-\t\t\t\tt.Fatalf(\"restore normalized its own mismatch: %v\", mismatch)\n-\t\t\t}\n-\t\t\tcontinue\n-\t\t}\n-\t\trequireLocalCode(t, mismatch, \"terminal_backend_protocol_error\", \"operation error vocabulary\")\n-\t}\n-}\n+func TestRowErrorCoversEightRows(t *testing.T) {\n+\t// rowError agrees with the landed allowed-set oracle on every row:\n+\t// a code the row admits propagates; any other code normalizes.\n+\tprobes := []string{\n+\t\t\"terminal_backend_timeout\", \"terminal_backend_process_failed\",\n+\t\t\"terminal_backend_restore_mismatch\", \"quiesce_timeout\", \"stop_timeout\",\n+\t\t\"idempotency_mismatch\", \"terminal_backend_unavailable\",\n+\t}\n+\tfor _, operation := range []terminalbackend.Operation{\n+\t\tterminalbackend.OperationCreate, terminalbackend.OperationAttach,\n+\t\tterminalbackend.OperationStatus, terminalbackend.OperationQuiesceInput,\n+\t\tterminalbackend.OperationWaitSafeBoundary, terminalbackend.OperationRequestStop,\n+\t\tterminalbackend.OperationTerminateStale, terminalbackend.OperationRestore,\n+\t} {\n+\t\tfor _, code := range probes {\n+\t\t\treported := &terminalbackend.Error{Code: code, Detail: \"x\"}\n+\t\t\tgot := rowError(operation, reported)\n+\t\t\tallowed := terminalbackend.CheckErrorAllowed(string(operation), code) == nil\n+\t\t\tvar landed *terminalbackend.Error\n+\t\t\tif allowed {\n+\t\t\t\tif !isLandedError(got, &landed) || landed.Code != code {\n+\t\t\t\t\tt.Fatalf(\"row %s normalized admitted %s: %v\", operation, code, got)\n+\t\t\t\t}\n+\t\t\t\tcontinue\n+\t\t\t}\n+\t\t\trequireLocalCode(t, got, \"terminal_backend_protocol_error\", \"operation error vocabulary\")\n+\t\t}\n+\t}\n+}\n","final_result":true}}}
