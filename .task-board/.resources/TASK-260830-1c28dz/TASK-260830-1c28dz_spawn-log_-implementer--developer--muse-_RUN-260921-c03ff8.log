unsafe rename.\n153|func writableByOthers(info os.FileInfo) bool {\n154|\tperm := info.Mode().Perm()\n155|\tif perm&0o022 == 0 {\n156|\t\treturn false\n157|\t}\n158|\treturn info.Mode()&os.ModeSticky == 0\n159|}\n160|\n161|// checkCustodySocket gates the socket path itself: absence is bindable,\n162|// a socket is unlinkable-before-bind, and any other kind refuses so\n163|// the stale-unlink step can never remove a non-socket.\n164|func checkCustodySocket(socket string) error {\n165|\tinfo, err := os.Lstat(socket)\n166|\tif err != nil {\n167|\t\tif os.IsNotExist(err) {\n168|\t\t\treturn nil\n169|\t\t}\n170|\t\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket kind\"}\n171|\t}\n172|\tif info.Mode().Type() != os.ModeSocket {\n173|\t\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket kind\"}\n174|\t}\n175|\treturn nil\n176|}","final_result":true}}}
