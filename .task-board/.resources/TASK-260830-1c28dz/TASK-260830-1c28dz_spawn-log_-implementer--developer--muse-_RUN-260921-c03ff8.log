{\n274|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate target binding\"}\n275|\t}\n276|\treturn nil\n277|}\n278|\n279|// checkTerminateWinner binds the caller-observed winner to the\n280|// re-read current lease: the fencing authorization decides over the\n281|// caller's winner, and only a winner that still wins authorizes. A\n282|// rotated or misobserved winner refuses the failed local\n283|// precondition; the caller re-observes and retries. Absence of a\n284|// winner never reaches here — the fencing gate refuses it first.\n285|func checkTerminateWinner(mctx terminstance.MutationContext, winner sessrepo.LeaseSummary, lease terminstance.LeaseView) error {\n286|\tif winner.SessionID != mctx.SessionID ||\n287|\t\twinner.LeaseID != lease.LeaseID ||\n288|\t\twinner.Epoch != lease.Epoch {\n289|\t\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate winner binding\"}\n290|\t}\n291|\treturn nil\n292|}\n293|\n294|// executeRestore runs one restore: closed-shape admission, idempotency\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
