",\n215|\t\t\"credential_capable_execution_realm\",\n216|\t\t\"local_attach\",\n217|\t\t\"remote_attach\",\n218|\t\t\"multi_attach\",\n219|\t\t\"reboot_restoration\",\n220|\t\t\"input_quiescence\",\n221|\t\t\"safe_boundary_observation\",\n222|\t\t\"provider_process_observation\",\n223|\t\t\"graceful_stop\",\n224|\t\t\"stale_process_termination\",\n225|\t\t\"terminal_state_retention\",\n226|\t)\n227|}\n228|\n229|// errFakeTransport is the canned transport failure.\n230|var errFakeTransport = errors.New(\"fake runner transport failure\")\n231|\n232|// testAxpaneStore opens a bootstrap binding store under a temp dir.\n233|func testAxpaneStore(t *testing.T) (*axpane.Store, error) {\n234|\tt.Helper()\n235|\treturn axpane.Open(t.TempDir())\n236|}\n237|\n238|// testAttachStore opens an attach receipt store under a temp dir.\n239|func testAttachStore(t *testing.T) (*termbind.AttachStore, error) {\n240|\tt.Helper()\n241|\treturn termbind.OpenAttachStore(t.TempDir())\n242|}\n243|\n244|// isLandedError reports whether err carries a landed terminalbackend\n245|// refusal, decoding it into target.\n246|func isLandedError(err error, target **terminalbackend.Error) bool {\n247|\treturn errors.As(err, target)\n248|}\n249|\n250|// requireLocalCode asserts a *tmuxserver.Error with the literal code\n251|// and detail. The literals come from the pinned spec or the committed\n252|// package vocabulary, never from production constants.\n253|func requireLocalCode(t *testing.T, err error, code, detail string) {\n254|\tt.Helper()\n255|\tif err == nil {\n256|\t\tt.Fatalf(\"want error %s at %s, got nil\", code, detail)\n257|\t}\n258|\tvar local *Error\n259|\tif !errors.As(err, &local) {\n260|\t\tt.Fatalf(\"want *Error %s at %s, got %T (%v)\", code, detail, err, err)\n261|\t}\n262|\tif local.Code != code || local.Detail != detail {\n263|\t\tt.Fatalf(\"want %s at %s, got %s at %s\", code, detail, local.Code, local.Detail)\n264|\t}\n265|}\n266|\n267|// requireEngineCode asserts a *terminstance.Error with the literal code.\n268|func requireEngineCode(t *testing.T, err error, code string) {\n269|\tt.Helper()\n270|\tif err == nil {\n271|\t\tt.Fatalf(\"want engine error %s, got nil\", code)\n272|\t}\n273|\tvar failure *terminstance.Error\n274|\tif !errors.As(err, &failure) {\n275|\t\tt.Fatalf(\"want *terminstance.Error %s, got %T (%v)\", code, err, err)\n276|\t}\n277|\tif failure.Code != code {\n278|\t\tt.Fatalf(\"want engine code %s, got %s (%v)\", code, failure.Code, err)\n279|\t}\n280|}\n281|\n282|// requireLandedCode asserts a *terminalbackend.Error with the literal code.\n283|func requireLandedCode(t *testing.T, err error, code string) {\n284|\tt.Helper()\n285|\tif err == nil {\n286|\t\tt.Fatalf(\"want landed error %s, got nil\", code)\n287|\t}\n288|\tvar failure *terminalbackend.Error\n289|\tif !errors.As(err, &failure) {\n290|\t\tt.Fatalf(\"want *terminalbackend.Error %s, got %T (%v)\", code, err, err)\n291|\t}\n292|\tif failure.Code != code {\n293|\t\tt.Fatalf(\"want landed code %s, got %s (%v)\", code, failure.Code, err)\n294|\t}\n295|}\n296|\n297|func argvStrings(argv []string) string { return strings.Join(argv, \" \") }\n298|\n299|// recordBinding records the bootstrap binding receipt for the\n300|// lifecycle (session, bootstrap) pair with the given digest.\n301|func recordBinding(t *testing.T, fx *lxFixture, digest string) {\n302|\tt.Helper()\n303|\t_, _, err := fx.lc.Bindings.Bind(lxSession, lxBootstrap, axpane.Binding{\n304|\t\tSessionID:          lxSession,\n305|\t\tOperationID:        lxBootstrap,\n306|\t\tTerminalInstanceID: lxInstance,\n307|\t\tBindingDigest:      digest,\n308|\t})\n309|\tif err != nil {\n310|\t\tt.Fatal(err)\n311|\t}\n312|}\n313|\n314|// foreignBackendBody rewrites every terminal_backend_id in a body to\n315|// ax.conpty: the flat member and the nested context member alike.\n316|func foreignBackendBody(t *testing.T, raw []byte) []byte {\n317|\tt.Helper()\n318|\tvar object map[string]json.RawMessage\n319|\tif err := json.Unmarshal(raw, &object); err != nil {\n320|\t\tt.Fatal(err)\n321|\t}\n322|\tswap := func(container map[string]json.RawMessage) {\n323|\t\tif _, known := container[\"terminal_backend_id\"]; known {\n324|\t\t\tcontainer[\"terminal_backend_id\"] = json.RawMessage(`\"ax.conpty\"`)\n325|\t\t}\n326|\t}\n327|\tswap(object)\n328|\tif context, known := object[\"context\"]; known {\n329|\t\tvar nested map[string]json.RawMessage\n330|\t\tif err := json.Unmarshal(context, &nested); err != nil {\n331|\t\t\tt.Fatal(err)\n332|\t\t}\n333|\t\tswap(nested)\n334|\t\trewritten, err := json.Marshal(nested)\n335|\t\tif err != nil {\n336|\t\t\tt.Fatal(err)\n337|\t\t}\n338|\t\tobject[\"context\"] = rewritten\n339|\t}\n340|\trewritten, err := json.Marshal(object)\n341|\tif err != nil {\n342|\t\tt.Fatal(err)\n343|\t}\n344|\treturn rewritten\n345|}\n346|\n347|// assertTimestamp pins a rendered timestamp against the scalar grammar.\n348|func assertTimestamp(t *testing.T, rendered string) {\n349|\tt.Helper()\n350|\tif _, err := scalar.ParseTimestamp(rendered); err != nil {\n351|\t\tt.Fatalf(\"timestamp %q: %v\", rendered, err)\n352|\t}\n353|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
