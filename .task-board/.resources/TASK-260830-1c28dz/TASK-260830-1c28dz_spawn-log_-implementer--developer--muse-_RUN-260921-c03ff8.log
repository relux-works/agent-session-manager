{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000e7a1","stream":{"kind":"session","id":"01a0c620-a10f-77d2-842c-eaf24fab8e2e"},"sequence":4651,"recorded_at":1780531400009297,"record_type":"event","durability":"durable","causation_id":"0cdc816d-6145-48a9-a49c-390655512ae9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0cdc816d-6145-48a9-a49c-390655512ae9","run_stream":{"kind":"run","id":"0cdc816d-6145-48a9-a49c-390655512ae9"},"task_stream":{"kind":"task","id":"01a0c657-fa7e-7452-852b-957ada782748"},"task_id":"01a0c657-fa7e-7452-852b-957ada782748","event":{"kind":"output","task_id":"01a0c657-fa7e-7452-852b-957ada782748","chunk":"{\n  \"chunk_id\": \"exec-120-1\",\n  \"command\": \"sed -n '790,900p' internal/tmuxserver/mutant_harness.py\",\n  \"description\": \"Read harness tail format\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly background callers to the foreground path (the capitalized twin still dispatches background); foreground callers are unaffected. Kill path: the background miss table spawns into the dedicated server instead of refusing the typed unavailable.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"D-background-fallback\\\",\\n        path=f\\\"{PACKAGE}/acquire.go\\\",\\n        find=\\\"\\\\t\\\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\\\n\\\\t\\\\t\\\\treturn Outcome{}, backgroundUnavailable(req, err)\\\\n\\\\t\\\\t}\\\\n\\\",\\n        replace=\\\"\\\\t\\\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\\\n\\\\t\\\\t\\\\tif req.Deps.Spawn != nil {\\\\n\\\\t\\\\t\\\\t\\\\t_ = req.Deps.Spawn(socket, nil)\\\\n\\\\t\\\\t\\\\t}\\\\n\\\\t\\\\t\\\\treturn Outcome{}, backgroundUnavailable(req, err)\\\\n\\\\t\\\\t}\\\\n\\\",\\n        count=1,\\n        run=BG_MISS_LINUX,\\n        expect=\\\"KILLED\\\",\\n        note=\\\"SUPPLEMENTARY ADDITIVE, not a narrowing: plants the reviewer-shaped direct-creation call on the background miss path. Kill path: every background-miss spy asserts zero spawn calls.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"D-background-fallback-foreground\\\",\\n        path=f\\\"{PACKAGE}/acquire.go\\\",\\n        find=\\\"\\\\t\\\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\\\n\\\\t\\\\t\\\\treturn Outcome{}, backgroundUnavailable(req, err)\\\\n\\\\t\\\\t}\\\\n\\\",\\n        replace=\\\"\\\\t\\\\tif cerr := checkCreationAllowed(req.Caller); cerr != nil {\\\\n\\\\t\\\\t\\\\tif req.Deps.ProbeServer != nil && req.Deps.Spawn != nil {\\\\n\\\\t\\\\t\\\\t\\\\treturn acquireForeground(req, socket)\\\\n\\\\t\\\\t\\\\t}\\\\n\\\\t\\\\t\\\\treturn Outcome{}, backgroundUnavailable(req, err)\\\\n\\\\t\\\\t}\\\\n\\\",\\n        count=1,\\n        run=BG_MISS_LINUX,\\n        expect=\\\"KILLED\\\",\\n        note=\\\"SUPPLEMENTARY ADDITIVE, not a narrowing: a fallback into acquireForeground on the background miss path, guarded on the foreground probe dependency — the shared-Dependencies shape, where the lifecycle adapter passes one Dependencies value to every caller. Kill path: every background-miss test arms both a spy spawner and a spy server probe and asserts the typed unavailable, so re-entering the foreground path trips the census before it spawns.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"C-control\\\",\\n        path=f\\\"{PACKAGE}/errors.go\\\",\\n        find=\\\"// Error is a package-local refusal. Code is one of the Code*\\\",\\n        replace=\\\"// Error is a package-local refusal (harness control: comment-only). Code is one of the Code*\\\",\\n        count=1,\\n        run=\\\"TestSocketPathDerivesOnlyFromRuntimeDir\\\",\\n        expect=\\\"SURVIVED\\\",\\n        note=\\\"Harmless control: a comment-only edit that must SURVIVE, proving the harness observes outcomes.\\\",\\n    ),\\n]\\n\\n\\ndef apply(mutant: Mutant, original: str) -> str:\\n    return original.replace(mutant.find, mutant.replace)\\n\\n\\ndef run_mutant(mutant: Mutant, log_dir: Path | None) -> str:\\n    target = REPO / mutant.path\\n    original = target.read_text()\\n    found = original.count(mutant.find)\\n    if found != mutant.count:\\n        return f\\\"ERROR: {mutant.name}: patch anchors {found}, want {mutant.count}\\\"\\n    with tempfile.TemporaryDirectory() as staging:\\n        backup = Path(staging) / \\\"backup\\\"\\n        shutil.copy2(target, backup)\\n        try:\\n            target.write_text(apply(mutant, original))\\n            run = subprocess.run(\\n                [\\\"go\\\", \\\"test\\\", f\\\"./{PACKAGE}/\\\", \\\"-run\\\", mutant.run, \\\"-count=1\\\"],\\n                cwd=REPO,\\n                capture_output=True,\\n                text=True,\\n                timeout=300,\\n            )\\n        finally:\\n            shutil.copy2(backup, target)\\n    output = (run.stdout + run.stderr).strip()\\n    if os.environ.get(\\\"AX_MUTANT_VERBOSE\\\") == \\\"1\\\":\\n        print(f\\\"--- raw: {mutant.name}: exit {run.returncode} ---\\\", flush=True)\\n        print(output, flush=True)\\n        print(f\\\"--- end raw: {mutant.name} ---\\\", flush=True)\\n    if log_dir is not None:\\n        (log_dir / f\\\"{mutant.name}.log\\\").write_text(\\n            f\\\"exit: {run.returncode}\\\\nrun: go test ./{PACKAGE}/ -run {mutant.run} -count=1\\\\n\\\\n{output}\\\\n\\\"\\n        )\\n    if 'build failed' in output or '\\\\n# ' in output or output.startswith('# '):\\n        return f\\\"ERROR: {mutant.name}: build broke under the patch\\\"\\n    if run.returncode == 0:\\n        verdict = \\\"SURVIVED\\\"\\n    elif '--- FAIL' in output or 'FAIL:' in output:\\n        verdict = \\\"KILLED\\\"\\n    else:\\n        return f\\\"ERROR: {mutant.name}: exit {run.returncode} with no kill line\\\"\\n    mark = \\\"ok\\\" if verdict == mutant.expect else \\\"MISMATCH\\\"\\n    return f\\\"{mark}: {mutant.name}: {verdict} (want {mutant.expect}) :: {mutant.note} [exit {run.returncode}]\\\"\\n\\n\\ndef main(argv: list[str]) -> int:\\n    log_dir: Path | None = None\\n    names = list(argv)\\n    if \\\"--log-dir\\\" in names:\\n        idx = names.index(\\\"--log-dir\\\")\\n        if idx + 1 >= len(names):\\n            print(\\\"--log-dir needs a directory\\\")\\n            return 2\\n        log_dir = Path(names[idx + 1])\\n        log_dir.mkdir(parents=True, exist_ok=True)\\n        del names[idx : idx + 2]\\n    selected = [m for m in MUTANTS if not names or m.name in names]\\n    if names and len(selected) != len(names):\\n        unknown = sorted(set(names) - {m.name for m in selected})\\n        print(f\\\"unknown mutants: {', '.join(unknown)}\\\")\\n        return 2\\n    failures = 0\\n    for mutant in selected:\\n        try:\\n            line = run_mutant(mutant, log_dir)\\n        except subprocess.TimeoutExpired:\\n            line = f\\\"ERROR: {mutant.name}: killer timed out\\\"\\n        print(line, flush=True)\\n        if not line.startswith(\\\"ok:\\\"):\\n            failures += 1\\n    return 1 if failures else 0\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    sys.exit(main(sys.argv[1:]))\\n\",\n  \"original_output_bytes\": 5528,\n  \"original_output_tokens\": 1382,\n  \"truncated\": false\n}","final_result":true}}}
