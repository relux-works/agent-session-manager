rnal/tmuxserver/ops.go-105-\\treqBackend.clientID = body.ClientID\\ninternal/tmuxserver/ops.go-106-\\treqBackend.transport = body.Transport\\ninternal/tmuxserver/ops.go-107-\\treqBackend.input = body.InputAuthorized\\ninternal/tmuxserver/ops.go-108-\\treqBackend.authRaw = body.AuthRaw\\ninternal/tmuxserver/ops.go-109-\\tevidenceID, err := reqBackend.PerformEffect(ctx, terminalbackend.EffectAttachClientCreated)\\ninternal/tmuxserver/ops.go-110-\\tif err != nil {\\ninternal/tmuxserver/ops.go-111-\\t\\treturn empty, rowError(terminalbackend.OperationAttach, err)\\ninternal/tmuxserver/ops.go-112-\\t}\\ninternal/tmuxserver/ops.go-113-\\targv, err := BuildCommand(DirectiveAttachSession, CommandArgs{\\ninternal/tmuxserver/ops.go-114-\\t\\tRuntimeDir: lc.RuntimeDir,\\ninternal/tmuxserver/ops.go-115-\\t\\tSocket:     socket,\\ninternal/tmuxserver/ops.go-116-\\t\\tInstanceID: body.TerminalInstanceID,\\ninternal/tmuxserver/ops.go-117-\\t})\\ninternal/tmuxserver/ops.go-118-\\tif err != nil {\\ninternal/tmuxserver/ops.go-119-\\t\\treturn empty, err\\ninternal/tmuxserver/ops.go-120-\\t}\\ninternal/tmuxserver/ops.go-121-\\tif err := terminalbackend.CheckAttachResult(body.InputAuthorized, body.InputAuthorized, body.Authorization); err != nil {\\ninternal/tmuxserver/ops.go-122-\\t\\treturn empty, err\\ninternal/tmuxserver/ops.go-123-\\t}\\ninternal/tmuxserver/ops.go-124-\\tlc.recordAfter(body.TerminalInstanceID, terminalbackend.StateActive)\\ninternal/tmuxserver/ops.go-125-\\treturn OpOutcome{\\n\",\n  \"original_output_bytes\": 4360,\n  \"original_output_tokens\": 1090,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000ff7b","stream":{"kind":"session","id":"01a0c620-a10f-77d2-842c-eaf24fab8e2e"},"sequence":7704,"recorded_at":1780531400015403,"record_type":"event","durability":"durable","causation_id":"0cdc816d-6145-48a9-a49c-390655512ae9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"0cdc816d-6145-48a9-a49c-390655512ae9","run_stream":{"kind":"run","id":"0cdc816d-6145-48a9-a49c-390655512ae9"},"call_id":"call_01a0c67d9e2d72c9a230fa36ef911a2a","text":"{\n  \"chunk_id\": \"exec-226-1\",\n  \"command\": \"sed -n '57,86p;144,195p' internal/tmuxserver/backend_test.go; sed -n '270,300p' internal/tmuxserver/backend_test.go\",\n  \"description\": \"Read backend effect tests\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"func TestPerformEffectBindingPersisted(t *testing.T) {\\n\\treqBackend := effectBackend(t, terminalbackend.OperationCreate, newFakeRunner())\\n\\tid, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectBindingPersisted)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tif id != lxDigestA {\\n\\t\\tt.Fatalf(\\\"evidence = %s\\\", id)\\n\\t}\\n\\t// Identical retry replays the one receipt.\\n\\tid2, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectBindingPersisted)\\n\\tif err != nil || id2 != id {\\n\\t\\tt.Fatalf(\\\"replay = %s, %v\\\", id2, err)\\n\\t}\\n}\\n\\nfunc TestPerformEffectWrapperStart(t *testing.T) {\\n\\trunner := newFakeRunner().queue(\\\"new-session\\\", \\\"\\\", 0)\\n\\treqBackend := effectBackend(t, terminalbackend.OperationCreate, runner)\\n\\tid, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectWrapperStarted)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\trequireDigest(t, id)\\n\\tcalls := runner.subcommands()\\n\\tif len(calls) != 1 || calls[0] != \\\"new-session\\\" {\\n\\t\\tt.Fatalf(\\\"calls = %v\\\", calls)\\n\\t}\\n}\\n\\nfunc TestPerformEffectStopLadder(t *testing.T) {\\n\\t// Graceful close on first confirm: send-keys, has (absent).\\n\\trunner := newFakeRunner().queue(\\\"has-session\\\", \\\"\\\", 1)\\n\\treqBackend := effectBackend(t, terminalbackend.OperationRequestStop, runner)\\n\\tid, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectProcessClosed)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\trequireDigest(t, id)\\n\\tif got := runner.subcommands(); len(got) != 1 || got[0] != \\\"has-session\\\" {\\n\\t\\tt.Fatalf(\\\"calls = %v\\\", got)\\n\\t}\\n}\\n\\nfunc TestPerformEffectStopEscalates(t *testing.T) {\\n\\t// Live, live, then absent after the kill escalation.\\n\\trunner := newFakeRunner().\\n\\t\\tqueue(\\\"has-session\\\", \\\"\\\", 0).\\n\\t\\tqueue(\\\"kill-session\\\", \\\"\\\", 0).\\n\\t\\tqueue(\\\"has-session\\\", \\\"\\\", 1)\\n\\treqBackend := effectBackend(t, terminalbackend.OperationRequestStop, runner)\\n\\treqBackend.deadline = lxNow().Add(-time.Minute)\\n\\tif _, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectProcessClosed); err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\tgot := runner.subcommands()\\n\\twant := []string{\\\"has-session\\\", \\\"kill-session\\\", \\\"has-session\\\"}\\n\\tif len(got) != 3 {\\n\\t\\tt.Fatalf(\\\"calls = %v\\\", got)\\n\\t}\\n\\tfor i := range want {\\n\\t\\tif got[i] != want[i] {\\n\\t\\t\\tt.Fatalf(\\\"calls = %v, want %v\\\", got, want)\\n\\t\\t}\\n\\t}\\n}\\n\\nfunc TestPerformEffectStopTimeout(t *testing.T) {\\n\\trunner := newFakeRunner().\\n\\t\\tqueue(\\\"has-session\\\", \\\"\\\", 0).\\n\\t\\tqueue(\\\"kill-session\\\", \\\"\\\", 0).\\n\\t\\tqueue(\\\"has-session\\\", \\\"\\\", 0)\\n\\treqBackend := effectBackend(t, terminalbackend.OperationRequestStop, runner)\\n\\treqBackend.deadline = lxNow().Add(-time.Minute)\\n\\tif _, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectProcessClosed); err == nil {\\n\\t\\tt.Fatal(\\\"stubborn session closed\\\")\\n\\t} else {\\n\\t\\trequireEngineCode(t, err, \\\"stop_timeout\\\")\\n\\t}\\n}\\n\\nfunc TestPerformEffectTerminateKill(t *testing.T) {\\nfunc TestPerformEffectStoreClosedIsLocal(t *testing.T) {\\n\\trunner := newFakeRunner()\\n\\treqBackend := effectBackend(t, terminalbackend.OperationRequestStop, runner)\\n\\tid, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectBackendStoreClosed)\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\\trequireDigest(t, id)\\n\\tif runner.callCount() != 0 {\\n\\t\\tt.Fatalf(\\\"local effect execed %d commands\\\", runner.callCount())\\n\\t}\\n}\\n\\nfunc TestPerformEffectRefusesUnknownVocabulary(t *testing.T) {\\n\\treqBackend := effectBackend(t, terminalbackend.OperationCreate, newFakeRunner())\\n\\tif _, err := reqBackend.PerformEffect(context.Background(), \\\"server_rebooted\\\"); err == nil {\\n\\t\\tt.Fatal(\\\"unknown effect committed\\\")\\n\\t} else {\\n\\t\\trequireEngineCode(t, err, \\\"terminal_backend_protocol_error\\\")\\n\\t}\\n}\\n\\nfunc TestPerformEffectAttachClient(t *testing.T) {\\n\\treqBackend := effectBackend(t, terminalbackend.OperationAttach, newFakeRunner())\\n\\treqBackend.clientID = lxClient\\n\\treqBackend.transport = \\\"local_only\\\"\\n\\treqBackend.input = true\\n\\tauth, err := parseAttachBody(lxAttachBody(t, nil))\\n\\tif err != nil {\\n\\t\\tt.Fatal(err)\\n\\t}\\n\",\n  \"original_output_bytes\": 3897,\n  \"original_output_tokens\": 975,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
