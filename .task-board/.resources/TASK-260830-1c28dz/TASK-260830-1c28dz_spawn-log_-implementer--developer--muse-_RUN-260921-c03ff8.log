\\n146-\\t\\tt.Fatalf(\\\"replay diverged: %+v vs %+v\\\", second.Mutation, first.Mutation)\\n147-\\t}\\n148-}\\n149-\\n150-func TestExecuteAttach(t *testing.T) {\\n151-\\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\\n152-\\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\\n316:func TestExecuteBoundary(t *testing.T) {\\n317-\\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\\n318-\\tfx.runner.queue(\\\"wait-for\\\", \\\"\\\", 0)\\n319-\\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\\n320-\\t\\tOperation: \\\"wait-safe-boundary\\\", Body: lxBoundaryBody(t, \\\"ax_checkpoint_boundary\\\", 60000, nil), Source: \\\"quiescing\\\", Admitted: fullLifecycleAdmitted(),\\n321-\\t})\\n322-\\tif err != nil {\\n323-\\t\\tt.Fatal(err)\\n324-\\t}\\n325-\\tif outcome.Mutation.After != terminalbackend.StateQuiescing {\\n326-\\t\\tt.Fatalf(\\\"after = %s\\\", outcome.Mutation.After)\\n327-\\t}\\n328-\\tif len(outcome.Mutation.EvidenceIDs) != 1 || outcome.SafeBoundaryEvidenceID != outcome.Mutation.EvidenceIDs[0] {\\n334:func TestExecuteStop(t *testing.T) {\\n335-\\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\\n336-\\tfx.runner.queue(\\\"send-keys\\\", \\\"\\\", 0).queue(\\\"has-session\\\", \\\"\\\", 1)\\n337-\\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\\n338-\\t\\tOperation: \\\"request-stop\\\", Body: lxStopBody(t, 60000, nil), Source: \\\"quiescing\\\", Admitted: fullLifecycleAdmitted(),\\n339-\\t})\\n340-\\tif err != nil {\\n341-\\t\\tt.Fatal(err)\\n342-\\t}\\n343-\\tif outcome.Mutation.After != terminalbackend.StateStopped {\\n344-\\t\\tt.Fatalf(\\\"after = %s\\\", outcome.Mutation.After)\\n345-\\t}\\n346-\\tif !outcome.ProcessClosed || !outcome.StoreClosed {\\n\",\n  \"original_output_bytes\": 2349,\n  \"original_output_tokens\": 588,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
