() ([]byte, error) {\\n112:\\t\\t_, err := ParseTimestamp(candidate)\\n117:func (value *Timestamp) UnmarshalJSON(data []byte) error {\\n16:func ParseTimestamp(value string) (Timestamp, error) {\\n17-\\tif !timestampPattern.MatchString(value) {\\n18-\\t\\treturn Timestamp{}, invalid(\\\"timestamp\\\", \\\"must be UTC RFC3339 with at least 3 fractional digits\\\")\\n19-\\t}\\n20-\\tinstant, err := parseTimestampInstant(value)\\n21-\\tif err != nil {\\n22-\\t\\treturn Timestamp{}, invalid(\\\"timestamp\\\", \\\"must identify a real calendar instant\\\")\\n23-\\t}\\n24-\\t_, offset := instant.Zone()\\n25-\\tif offset != 0 {\\n26-\\t\\treturn Timestamp{}, invalid(\\\"timestamp\\\", \\\"must use UTC\\\")\\n27-\\t}\\n28-\\treturn Timestamp{value: value}, nil\\n29-}\\n30-\\n31-func (value Timestamp) String() string { return value.value }\\n32-\\n33-func (value Timestamp) MarshalText() ([]byte, error) {\\n34-\\treturn marshalValidatedText(value.value, func(candidate string) error {\\n35-\\t\\t_, err := ParseTimestamp(candidate)\\n36-\\t\\treturn err\\n37-\\t})\\n38-}\\n39-\\n40-func (value *Timestamp) UnmarshalText(data []byte) error {\\n41-\\tparsed, err := ParseTimestamp(string(data))\\n\",\n  \"original_output_bytes\": 1897,\n  \"original_output_tokens\": 475,\n  \"truncated\": false\n}","final_result":true}}}
