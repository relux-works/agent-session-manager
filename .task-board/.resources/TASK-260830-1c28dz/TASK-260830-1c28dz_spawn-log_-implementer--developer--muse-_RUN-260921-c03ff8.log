{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000f0e7","stream":{"kind":"session","id":"01a0c620-a10f-77d2-842c-eaf24fab8e2e"},"sequence":5838,"recorded_at":1780531400011671,"record_type":"event","durability":"durable","causation_id":"0cdc816d-6145-48a9-a49c-390655512ae9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0cdc816d-6145-48a9-a49c-390655512ae9","run_stream":{"kind":"run","id":"0cdc816d-6145-48a9-a49c-390655512ae9"},"task_stream":{"kind":"task","id":"01a0c666-11f9-78f1-8509-d4b31c547da6"},"task_id":"01a0c666-11f9-78f1-8509-d4b31c547da6","event":{"kind":"output","task_id":"01a0c666-11f9-78f1-8509-d4b31c547da6","chunk":"Read text file `internal/tmuxserver/exec.go`.\n(59 line(s) above)\n60|\t\tvar exitErr *exec.ExitError\n61|\t\tif errors.As(err, &exitErr) {\n62|\t\t\treturn RunResult{Stdout: stdout.Bytes(), ExitCode: exitErr.ExitCode()}, nil\n63|\t\t}\n64|\t\treturn RunResult{}, err\n65|\t}\n66|\treturn RunResult{Stdout: stdout.Bytes(), ExitCode: 0}, nil\n67|}\n68|\n69|// scrubTmuxEnv removes the ambient tmux session variables from a process\n70|// environment. It matches exact NAME= prefixes, so TMUX_FOO survives\n71|// while TMUX and TMUX_TMPDIR are dropped.\n72|func scrubTmuxEnv(env []string) []string {\n73|\tscrubbed := make([]string, 0, len(env))\n74|\tfor _, entry := range env {\n75|\t\tif strings.HasPrefix(entry, EnvTMUX+\"=\") || strings.HasPrefix(entry, EnvTMUXTmpDir+\"=\") {\n76|\t\t\tcontinue\n77|\t\t}\n78|\t\tscrubbed = append(scrubbed, entry)\n79|\t}\n80|\treturn scrubbed\n81|}\n82|\n83|// Directive is the closed tmux primitive vocabulary this leaf executes.\n84|// Each lifecycle operation maps to a fixed directive sequence (see the\n85|// backend drivers); no operation execs a primitive outside this enum,\n86|// and no primitive addresses any server but the derived -S socket.\n87|type Directive string\n88|\n89|// tmux primitives. The string values are the literal tmux(1) command\n90|// names verified against tmux 3.6a list-commands.\n91|const (\n92|\tDirectiveNewSession    Directive = \"new-session\"\n93|\tDirectiveAttachSession Directive = \"attach-session\"\n94|\tDirectiveListPanes     Directive = \"list-panes\"\n95|\tDirectiveListSessions  Directive = \"list-sessions\"\n96|\tDirectiveLockSession   Directive = \"lock-session\"\n97|\tDirectiveWaitBoundary  Directive = \"wait-for\"\n98|\tDirectiveSendInterrupt Directive = \"send-keys\"\n99|\tDirectiveHasSession    Directive = \"has-session\"\n100|\tDirectiveKillSession   Directive = \"kill-session\"\n101|)\n102|\n103|// ParseDirective admits exactly the nine tmux primitives.\n104|func ParseDirective(value string) (Directive, error) {\n105|\tswitch Directive(value) {\n106|\tcase DirectiveNewSession, DirectiveAttachSession, DirectiveListPanes,\n107|\t\tDirectiveListSessions, DirectiveLockSession, DirectiveWaitBoundary,\n108|\t\tDirectiveSendInterrupt, DirectiveHasSession, DirectiveKillSession:\n109|\t\treturn Directive(value), nil\n110|\tdefault:\n111|\t\treturn \"\", &Error{Code: terminalbackend.CodeProtocolError, Detail: \"command vocabulary\"}\n112|\t}\n113|}\n114|\n115|// PanesFormat is the list-panes row shape: the foreground command name\n116|// only. It deliberately excludes pane_pid: identity MUST NOT be a PID\n117|// (pinned SPEC 4.B), so provider presence is proven by a non-empty\n118|// command row, never by a process number.\n119|const PanesFormat = \"#{pane_current_command}\"\n120|\n121|// SessionsFormat is the list-sessions row shape: session name and\n122|// attached-client count, pipe-separated.\n123|const SessionsFormat = \"#{session_name}|#{session_attached}\"\n124|\n125|// BoundaryChannelPrefix prefixes every wait-for channel this leaf\n126|// locks on. The channel is ax-boundary-<quiescence_generation UUIDv7>:\n127|// fixed prefix plus caller-bound generation, never caller free text.\n128|const BoundaryChannelPrefix = \"ax-boundary-\"\n129|\n130|// CommandArgs carries the per-directive identity material. Only the\n131|// members the directive reads are validated; the rest stay zero. Every\n132|// tmux target session name is the terminal instance ID: the one\n133|// dedicated server hosts every logical session, so targets are\n134|// instance-scoped, while the wrapper tail always names the logical\n135|// session (ax pane <session_id>). The acquisition bootstrap vector\n136|// (BuildArgv, session-named) and lifecycle instance vectors coexist as\n137|// distinct sessions on that server; lifecycle entries address instances\n138|// only.\n139|type CommandArgs struct {\n140|\t// RuntimeDir is the tmux runtime directory (<root>/tmux).\n141|\tRuntimeDir string\n142|\t// Socket must equal SocketPath(RuntimeDir): the only admissible\n143|\t// server address. Any other value refuses.\n144|\tSocket string\n145|\t// SessionID is the logical session (create/restore wrapper tail).\n146|\tSessionID string\n147|\t// InstanceID is the tmux target session name.\n148|\tInstanceID string\n149|\t// QuiescenceGeneration selects the wait-for channel (boundary).\n150|\tQuiescenceGeneration string\n151|}\n152|\n153|// BuildCommand builds one validated tmux -S argv vector for a\n154|// directive. The socket pin mirrors the BuildArgv spawn-socket arm:\n155|// the socket must be the one derived from the runtime directory, so an\n156|// ambient socket passed here refuses instead of being addressed. The\n157|// assembled vector passes the landed argv shape gate before return.\n158|func BuildCommand(directive Directive, args CommandArgs) ([]string, error) {\n159|\tif _, err := ParseDirective(string(directive)); err != nil {\n160|\t\treturn nil, err\n161|\t}\n162|\tif args.Socket != SocketPath(args.RuntimeDir) {\n163|\t\treturn nil, &Error{Code: CodeAmbientReuse, Detail: \"command socket\"}\n164|\t}\n165|\tvar argv []string\n166|\tswitch directive {\n167|\tcase DirectiveNewSession:\n168|\t\tsession, instance, err := commandSessionInstance(args)\n169|\t\tif err != nil {\n170|\t\t\treturn nil, err\n171|\t\t}\n172|\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"new-session\", \"-d\",\n173|\t\t\t\"-s\", instance, \"ax\", \"pane\", session}\n174|\tcase DirectiveAttachSession:\n175|\t\tinstance, err := commandInstance(args)\n176|\t\tif err != nil {\n177|\t\t\treturn nil, err\n178|\t\t}\n179|\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"attach-session\", \"-t\", instance}\n180|\tcase DirectiveListPanes:\n181|\t\tinstance, err := commandInstance(args)\n182|\t\tif err != nil {\n183|\t\t\treturn nil, err\n184|\t\t}\n185|\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"list-panes\", \"-t\", instance, \"-F\", PanesFormat}\n186|\tcase DirectiveListSessions:\n187|\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"list-sessions\", \"-F\", SessionsFormat}\n188|\tcase DirectiveLockSession:\n189|\t\tinstance, err := commandInstance(args)\n190|\t\tif err != nil {\n191|\t\t\treturn nil, err\n192|\t\t}\n193|\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"lock-session\", \"-t\", instance}\n194|\tcase DirectiveWaitBoundary:\n195|\t\tchannel, err := commandChannel(args)\n196|\t\tif err != nil {\n197|\t\t\treturn nil, err\n198|\t\t}\n199|\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"wait-for\", \"-L\", channel}\n(more lines below)","final_result":true}}}
