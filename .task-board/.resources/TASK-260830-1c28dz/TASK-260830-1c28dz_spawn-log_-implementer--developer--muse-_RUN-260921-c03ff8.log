ver.\",\n+    ),\n+    Mutant(\n+        name=\"N-exec-instance-identity\",\n+        path=f\"{PACKAGE}/exec.go\",\n+        find='\\tinstance, err := scalar.ParseUUIDv7(args.InstanceID)\\n\\tif err != nil {\\n',\n+        replace='\\tinstance, err := scalar.ParseUUIDv7(args.InstanceID)\\n\\tif err != nil && args.InstanceID != \"not-a-uuid\" {\\n',\n+        count=1,\n+        run=\"TestBuildCommandRefusesBadIdentity\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the malformed instance past the target grammar; every other malformed identity still refuses, and the session and quiescence arms keep their own rows. Kill path: the unparseable target builds.\",\n+    ),\n+    Mutant(\n+        name=\"N-exec-session-identity\",\n+        path=f\"{PACKAGE}/exec.go\",\n+        find='\\tsession, err := scalar.ParseUUIDv7(args.SessionID)\\n\\tif err != nil {\\n',\n+        replace='\\tsession, err := scalar.ParseUUIDv7(args.SessionID)\\n\\tif err != nil && args.SessionID != \"not-a-uuid\" {\\n',\n+        count=1,\n+        run=\"TestBuildCommandRefusesBadIdentity\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the malformed session past the wrapper-tail grammar; every other malformed identity still refuses, and the instance and quiescence arms keep their own rows. Kill path: the unparseable tail builds.\",\n+    ),\n+    Mutant(\n+        name=\"N-exec-quiescence-identity\",\n+        path=f\"{PACKAGE}/exec.go\",\n+        find='\\tgeneration, err := scalar.ParseUUIDv7(args.QuiescenceGeneration)\\n\\tif err != nil {\\n',\n+        replace='\\tgeneration, err := scalar.ParseUUIDv7(args.QuiescenceGeneration)\\n\\tif err != nil && args.QuiescenceGeneration != \"not-a-uuid\" {\\n',\n+        count=1,\n+        run=\"TestBuildCommandRefusesBadIdentity\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the malformed quiescence generation past the channel grammar; every other malformed identity still refuses, and the instance and session arms keep their own rows. Kill path: the unparseable channel builds.\",\n+    ),\n+    Mutant(\n+        name=\"N-exec-scrub-tmux\",\n+        path=f\"{PACKAGE}/exec.go\",\n+        find='\\t\\tif strings.HasPrefix(entry, EnvTMUX+\"=\") || strings.HasPrefix(entry, EnvTMUXTmpDir+\"=\") {\\n',\n+        replace='\\t\\tif strings.HasPrefix(entry, EnvTMUXTmpDir+\"=\") {\\n',\n+        count=1,\n+        run=\"TestScrubTmuxEnv\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly TMUX-carrying entries past the child scrub (the TMPDIR arm stays); TMUX_TMPDIR still scrubs. Kill path: the ambient session leaks into the child environment.\",\n+    ),\n+    Mutant(\n+        name=\"N-exec-scrub-tmpdir\",\n+        path=f\"{PACKAGE}/exec.go\",\n+        find='\\t\\tif strings.HasPrefix(entry, EnvTMUX+\"=\") || strings.HasPrefix(entry, EnvTMUXTmpDir+\"=\") {\\n',\n+        replace='\\t\\tif strings.HasPrefix(entry, EnvTMUX+\"=\") {\\n',\n+        count=1,\n+        run=\"TestScrubTmuxEnv\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly TMUX_TMPDIR-carrying entries past the child scrub (the TMUX arm stays); TMUX still scrubs. Kill path: the ambient socket directory leaks into the child environment.\",\n+    ),\n+    Mutant(\n+        name=\"N-exec-directives-manifest\",\n+        path=f\"{PACKAGE}/backend.go\",\n+        find='\\tif !known {\\n\\t\\treturn nil, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle operation\"}\\n\\t}\\n',\n+        replace='\\tif !known && operation != terminalbackend.OperationManifest {\\n\\t\\treturn nil, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle operation\"}\\n\\t}\\n',\n+        count=1,\n+        run=\"(TestDirectivesForRefusesNonLifecycle|TestExecuteRefusesNonLifecycleScope)\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly manifest past the lifecycle-operation mapping; probe and every other unknown operation still refuse. One site, both entries: the helper and the dispatch scope test admit the manifest scope.\",\n+    ),\n+    Mutant(\n+        name=\"N-exec-vector-detached\",\n+        path=f\"{PACKAGE}/exec.go\",\n+        find='\\t\\targv = []string{\"tmux\", \"-S\", args.Socket, \"new-session\", \"-d\",\\n\\t\\t\\t\"-s\", instance, \"ax\", \"pane\", session}\\n',\n+        replace='\\t\\targv = []string{\"tmux\", \"-S\", args.Socket, \"new-session\",\\n\\t\\t\\t\"-s\", instance, \"ax\", \"pane\", session}\\n',\n+        count=1,\n+        run=\"TestBuildCommandVectors/new-session\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the attached spawn vector past the fixed-shape builder (the spawned server would try to attach the caller); every other vector element stays exact. Kill path: the exact-vector assertion fails.\",\n+    ),\n+    Mutant(\n+        name=\"N-state-creating\",\n+        path=f\"{PACKAGE}/state.go\",\n+        find='\\tif state == terminalbackend.StateCreating {\\n',\n+        replace='\\tif state == terminalbackend.StateCreating && instanceID != \"0198f4c8-8e50-7f66-8f70-222222222221\" {\\n',\n+        count=1,\n+        run=\"TestInstanceStatesRefusesCreating\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the creating state for the fixture instance past the record gate; creating for any other instance still refuses. Kill path: the interim state durably records.\",\n+    ),\n+    Mutant(\n+        name=\"N-state-record-identity\",\n+        path=f\"{PACKAGE}/state.go\",\n+        find='\\tif _, err := scalar.ParseUUIDv7(instanceID); err != nil {\\n\\t\\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance state identity\"}\\n\\t}\\n',\n+        replace='\\tif _, err := scalar.ParseUUIDv7(instanceID); err != nil && instanceID != \"not-a-uuid\" {\\n\\t\\treturn &Error{Code: CodeInvalidArguments, Detail: \"instance state identity\"}\\n\\t}\\n',\n+        count=1,\n+        run=\"TestInstanceStatesRefusesBadIdentity\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the malformed identity past the record grammar; the lookup arm keeps its own row. Kill path: the unparseable instance records a document.\",\n+    ),\n+    Mutant(\n+        name=\"N-state-lookup-identity\",\n+        path=f\"{PACKAGE}/state.go\",\n+        find='\\tif _, err := scalar.ParseUUIDv7(instanceID); err != nil {\\n\\t\\treturn \"\", false, &Error{Code: CodeInvalidArguments, Detail: \"instance state identity\"}\\n\\t}\\n',\n+        replace='\\tif _, err := scalar.ParseUUIDv7(instanceID); err != nil && instanceID != \"not-a-uuid\" {\\n\\t\\treturn \"\", false, &Error{Code: CodeInvalidArguments, Detail: \"instance state identity\"}\\n\\t}\\n',\n+        count=1,\n+        run=\"TestInstanceStatesRefusesBadIdentity\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the malformed identity past the lookup grammar (it reads as absent); the record arm keeps its own row. Kill path: the unparseable lookup reports absence instead of refusing.\",\n+    ),\n+    Mutant(\n+        name=\"N-state-unknown\",\n+        path=f\"{PACKAGE}/state.go\",\n+        find='\\tif _, err := terminalbackend.ParseInstanceState(string(state)); err != nil {\\n',\n+        replace='\\tif _, err := terminalbackend.ParseInstanceState(string(state)); err != nil && state != \"launched\" {\\n',\n+        count=1,\n+        run=\"TestInstanceStatesRefusesUnknownState\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the launched state past the record value grammar; every other unknown state still refuses. Kill path: the out-of-vocabulary state durably records.\",\n+    ),\n+    Mutant(\n+        name=\"N-state-foreign\",\n+        path=f\"{PACKAGE}/state.go\",\n+        find='\\tif document.TerminalInstanceID != instanceID {\\n',\n+        replace='\\tif document.TerminalInstanceID != instanceID && document.TerminalInstanceID != \"0198f4c8-8e50-7f66-8f70-111111111111\" {\\n',\n+        count=1,\n+        run=\"TestInstanceStatesRefusesForeignDocument\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the session-rewritten document past the lookup identity binding; every other foreign document still refuses. Kill path: the adopted document reports another instance's state as this one.\",\n+    ),\n+    Mutant(\n+        name=\"N-bodies-create-count\",\n+        path=f\"{PACKAGE}/bodies.go\",\n+        find='\\tif len(members) != len(createBodyMembers) {\\n',\n+        replace='\\tif len(members) != len(createBodyMembers) && len(members) != len(createBodyMembers)-1 {\\n',\n+        count=1,\n+        run=\"TestParseCreateBodyMemberSet\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly five-member create bodies past the member count; every other wrong count still refuses, and the other three bodies keep their own rows. Kill path: member-less bodies reach their nested verdicts.\",\n+    ),\n+    Mutant(\n+        name=\"N-bodies-attach-count\",\n+        path=f\"{PACKAGE}/bodies.go\",\n+        find='\\tif len(members) != len(attachBodyMembers) {\\n',\n+        replace='\\tif len(members) != len(attachBodyMembers) && len(members) != len(attachBodyMembers)-1 {\\n',\n+        count=1,\n+        run=\"TestParseAttachBodyMemberSet\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly ten-member attach bodies past the member count; every other wrong count still refuses, and the other three bodies keep their own rows. Kill path: member-less bodies reach their nested verdicts.\",\n+    ),\n+    Mutant(\n+        name=\"N-bodies-terminate-count\",\n+        path=f\"{PACKAGE}/bodies.go\",\n+        find='\\tif len(members) != len(terminateBodyMembers) {\\n',\n+        replace='\\tif len(members) != len(terminateBodyMembers) && len(members) != len(terminateBodyMembers)-1 {\\n',\n+        count=1,\n+        run=\"TestParseTerminateBodyViolations\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly three-member terminate bodies past the member count; every other wrong count still refuses, and the other three bodies keep their own rows. Kill path: member-less bodies reach their nested verdicts.\",\n+    ),\n+    Mutant(\n+        name=\"N-bodies-restore-count\",\n+        path=f\"{PACKAGE}/bodies.go\",\n+        find='\\tif len(members) != len(restoreBodyMembers) {\\n',\n+        replace='\\tif len(members) != len(restoreBodyMembers) && len(members) != len(restoreBodyMembers)-1 {\\n',\n+        count=1,\n+        run=\"TestParseRestoreBodyViolations\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly three-member restore bodies past the member count; every other wrong count still refuses, and the other three bodies keep their own rows. Kill path: member-less bodies reach their nested verdicts.\",\n+    ),\n+    Mutant(\n+        name=\"N-bodies-transport\",\n+        path=f\"{PACKAGE}/bodies.go\",\n+        find='\\t\\tstring(terminalbackend.TransportThirdPartyRelay):\\n\\t\\treturn transport, nil\\n\\tdefault:\\n',\n+        replace='\\t\\tstring(terminalbackend.TransportThirdPartyRelay):\\n\\t\\treturn transport, nil\\n\\tcase \"pigeon\":\\n\\t\\treturn transport, nil\\n\\tdefault:\\n',\n+        count=1,\n+        run=\"(TestParseCreateBodyMembers|TestParseAttachBodyMembers)\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the pigeon transport past the closed transport vocabulary; every other unknown transport still refuses. One site, both bodies: the create and attach member tables admit the pigeon body.\",\n+    ),\n+    Mutant(\n+        name=\"N-bodies-epoch-zero\",\n+        path=f\"{PACKAGE}/bodies.go\",\n+        find='environ.CheckUint53Bounds(members[\"stale_epoch\"], 1, scalar.MaxUint53)',\n+        replace='environ.CheckUint53Bounds(members[\"stale_epoch\"], 0, scalar.MaxUint53)',\n+        count=1,\n+        run=\"TestParseTerminateBodyViolations/epoch-zero\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly epoch zero past the stale-epoch bound; the huge epoch still refuses on the upper bound. Kill path: the epoch-less fencing target parses.\",\n+    ),\n+    Mutant(\n+        name=\"C-control\",\n","final_result":true}}}
