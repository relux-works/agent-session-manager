{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000f539","stream":{"kind":"session","id":"01a0c620-a10f-77d2-842c-eaf24fab8e2e"},"sequence":6391,"recorded_at":1780531400012777,"record_type":"event","durability":"durable","causation_id":"0cdc816d-6145-48a9-a49c-390655512ae9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0cdc816d-6145-48a9-a49c-390655512ae9","run_stream":{"kind":"run","id":"0cdc816d-6145-48a9-a49c-390655512ae9"},"task_stream":{"kind":"task","id":"01a0c66d-ed47-7b21-9601-d7ecb5554c22"},"task_id":"01a0c66d-ed47-7b21-9601-d7ecb5554c22","event":{"kind":"output","task_id":"01a0c66d-ed47-7b21-9601-d7ecb5554c22","chunk":"edited\nchanged lines: lines 813-814\n--- original\n+++ updated\n@@\n-    Mutant(\n-        name=\"C-control\",\n+    Mutant(\n+        name=\"N-lifecycle-evidence-digest\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\\t\\tif _, err := scalar.ParseDigest(evidenceID); err != nil {\\n',\n+        replace='\\t\\tif _, err := scalar.ParseDigest(evidenceID); err != nil && evidenceID != \"not-a-digest\" {\\n',\n+        count=1,\n+        run=\"TestRunLifecycleEffectsRefusesForgedEvidence\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the forged non-digest evidence past the receipt-loop digest arm; every other malformed evidence ID still fails the run. Kill path: the forged effect commits and the completion callback fires.\",\n+    ),\n+    Mutant(\n+        name=\"N-lifecycle-winner-lease\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\\tif winner.SessionID != mctx.SessionID ||\\n\\t\\twinner.LeaseID != lease.LeaseID ||\\n\\t\\twinner.Epoch != lease.Epoch {\\n',\n+        replace='\\tif winner.SessionID != mctx.SessionID ||\\n\\t\\twinner.Epoch != lease.Epoch {\\n',\n+        count=1,\n+        run=\"TestExecuteTerminateWinnerTracksCurrentLease/winner-lease-identity\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly lease-mismatched winners past the winner binding; epoch- and session-mismatched winners still refuse. Kill path: the admitted terminate execs the kill instead of refusing.\",\n+    ),\n+    Mutant(\n+        name=\"N-lifecycle-winner-epoch\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\\tif winner.SessionID != mctx.SessionID ||\\n\\t\\twinner.LeaseID != lease.LeaseID ||\\n\\t\\twinner.Epoch != lease.Epoch {\\n',\n+        replace='\\tif winner.SessionID != mctx.SessionID ||\\n\\t\\twinner.LeaseID != lease.LeaseID {\\n',\n+        count=1,\n+        run=\"TestExecuteTerminateRefusals/winner-rotated\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly epoch-mismatched winners past the winner binding; lease- and session-mismatched winners still refuse. Kill path: the rotated winner authorizes the kill.\",\n+    ),\n+    Mutant(\n+        name=\"N-lifecycle-target-lease\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\\tif presented.SessionID != mctx.SessionID ||\\n\\t\\tpresented.LeaseID != body.StaleLeaseID ||\\n\\t\\tpresented.Epoch != body.StaleEpoch {\\n',\n+        replace='\\tif presented.SessionID != mctx.SessionID ||\\n\\t\\tpresented.Epoch != body.StaleEpoch {\\n',\n+        count=1,\n+        run=\"TestExecuteTerminateTargetLeaseIdentity\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly lease-mismatched fencing tokens past the target binding; session- and epoch-mismatched tokens still refuse. Kill path: the fencing decision authorizes a different lease than the key names.\",\n+    ),\n+    Mutant(\n+        name=\"N-lifecycle-target-epoch\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\\tif presented.SessionID != mctx.SessionID ||\\n\\t\\tpresented.LeaseID != body.StaleLeaseID ||\\n\\t\\tpresented.Epoch != body.StaleEpoch {\\n',\n+        replace='\\tif presented.SessionID != mctx.SessionID ||\\n\\t\\tpresented.LeaseID != body.StaleLeaseID {\\n',\n+        count=1,\n+        run=\"TestExecuteTerminateRefusals/target-mismatch\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly epoch-mismatched fencing tokens past the target binding; session- and lease-mismatched tokens still refuse. Kill path: the fencing decision authorizes a different epoch than the key names.\",\n+    ),\n+    Mutant(\n+        name=\"N-lifecycle-target-session\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\\tif presented.SessionID != mctx.SessionID ||\\n\\t\\tpresented.LeaseID != body.StaleLeaseID ||\\n\\t\\tpresented.Epoch != body.StaleEpoch {\\n',\n+        replace='\\tif presented.LeaseID != body.StaleLeaseID ||\\n\\t\\tpresented.Epoch != body.StaleEpoch {\\n',\n+        count=1,\n+        run=\"TestExecuteTerminateTargetSessionBinds\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly foreign-session fencing tokens past the target binding; lease- and epoch-mismatched tokens still refuse. Kill path: the admitted token reaches the winner binding and refuses there instead.\",\n+    ),\n+    Mutant(\n+        name=\"N-lifecycle-capability-provider\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\\tif !admitted.Has(\"provider_process_termination\") {\\n',\n+        replace='\\tif !admitted.Has(\"provider_process_termination\") {\\n',\n+        count=0,\n+        run=\"TestExecuteTerminateRefusals/missing-capability\",\n+        expect=\"KILLED\",\n+        note=\"PLACEHOLDER\",\n+    ),\n+    Mutant(\n+        name=\"C-control\",\n","final_result":true}}}
