{"schema_version":1,"id":"018f0000-0000-7000-8000-000000011279","stream":{"kind":"session","id":"01a0c620-a10f-77d2-842c-eaf24fab8e2e"},"sequence":10135,"recorded_at":1780531400020265,"record_type":"event","durability":"durable","causation_id":"0cdc816d-6145-48a9-a49c-390655512ae9","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"0cdc816d-6145-48a9-a49c-390655512ae9","run_stream":{"kind":"run","id":"0cdc816d-6145-48a9-a49c-390655512ae9"},"call_id":"call_01a0c69d028e70eab08a46ffa4b1ce9f","text":"{\n  \"chunk_id\": \"exec-303-1\",\n  \"command\": \"cd internal/tmuxserver && python3 - <<'EOF'\\nsrc = open('mutant_harness.py').read()\\nfixes = [\\n ('run=\\\"TestParseDirectiveRefusesUnknown\\\",',\\n  'run=\\\"(TestParseDirectiveRefusesUnknown|TestBuildCommandRefusesUnknownDirective)\\\",'),\\n ('Kill path: the server-wide kill parses as a lifecycle directive.',\\n  'Kill path: the server-wide kill parses as a lifecycle directive, at the parser and through the command builder alike (attribution verified per test from the raw log).'),\\n ('run=\\\"TestScrubTmuxEnv\\\",\\\\n        expect=\\\"KILLED\\\",\\\\n        note=\\\"Admits exactly TMUX-carrying entries',\\n  'run=\\\"(TestScrubTmuxEnv|TestOSRunnerScrubsAmbientInChild)\\\",\\\\n        expect=\\\"KILLED\\\",\\\\n        note=\\\"Admits exactly TMUX-carrying entries'),\\n ('Kill path: the ambient session leaks into the child environment.',\\n  'Kill path: the ambient session leaks, at the scrub helper and into the real child environment alike (attribution verified per test from the raw log).'),\\n ('run=\\\"TestScrubTmuxEnv\\\",\\\\n        expect=\\\"KILLED\\\",\\\\n        note=\\\"Admits exactly TMUX_TMPDIR-carrying entries',\\n  'run=\\\"(TestScrubTmuxEnv|TestOSRunnerScrubsAmbientInChild)\\\",\\\\n        expect=\\\"KILLED\\\",\\\\n        note=\\\"Admits exactly TMUX_TMPDIR-carrying entries'),\\n ('Kill path: the ambient socket directory leaks into the child