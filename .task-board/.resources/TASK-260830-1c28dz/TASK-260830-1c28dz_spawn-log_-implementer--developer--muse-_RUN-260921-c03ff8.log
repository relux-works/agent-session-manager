{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000f0ed","stream":{"kind":"session","id":"01a0c620-a10f-77d2-842c-eaf24fab8e2e"},"sequence":5841,"recorded_at":1780531400011677,"record_type":"event","durability":"durable","causation_id":"0cdc816d-6145-48a9-a49c-390655512ae9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0cdc816d-6145-48a9-a49c-390655512ae9","run_stream":{"kind":"run","id":"0cdc816d-6145-48a9-a49c-390655512ae9"},"task_stream":{"kind":"task","id":"01a0c666-1216-7c83-911a-77f37691b131"},"task_id":"01a0c666-1216-7c83-911a-77f37691b131","event":{"kind":"output","task_id":"01a0c666-1216-7c83-911a-77f37691b131","chunk":"{\n  \"chunk_id\": \"exec-165-1\",\n  \"command\": \"grep -n \\\"TestExecuteRefusesForeignBackend\\\" -A 30 internal/tmuxserver/lifecycle_ops_unix_test.go | head -35; echo ===LEN-TEST===; sed -n '10,47p' internal/tmuxserver/bind_test.go\",\n  \"description\": \"Read foreign backend and length tests\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"487:func TestExecuteRefusesForeignBackend(t *testing.T) {\\n488-\\tcases := []struct {\\n489-\\t\\toperation string\\n490-\\t\\tbody      func(*testing.T) []byte\\n491-\\t\\tsource    string\\n492-\\t}{\\n493-\\t\\t{\\\"create\\\", func(t *testing.T) []byte { return foreignBackendBody(t, lxCreateBody(t, nil)) }, \\\"absent\\\"},\\n494-\\t\\t{\\\"attach\\\", func(t *testing.T) []byte { return foreignBackendBody(t, lxAttachBody(t, nil)) }, \\\"parked\\\"},\\n495-\\t\\t{\\\"status\\\", func(t *testing.T) []byte { return foreignBackendBody(t, lxStatusBody(t, true, false, nil)) }, \\\"\\\"},\\n496-\\t\\t{\\\"quiesce-input\\\", func(t *testing.T) []byte { return foreignBackendBody(t, lxQuiesceBody(t, nil)) }, \\\"active\\\"},\\n497-\\t\\t{\\\"wait-safe-boundary\\\", func(t *testing.T) []byte { return foreignBackendBody(t, lxBoundaryBody(t, \\\"ax_checkpoint_boundary\\\", 60000, nil)) }, \\\"quiescing\\\"},\\n498-\\t\\t{\\\"request-stop\\\", func(t *testing.T) []byte { return foreignBackendBody(t, lxStopBody(t, 60000, nil)) }, \\\"quiescing\\\"},\\n499-\\t\\t{\\\"terminate-stale\\\", func(t *testing.T) []byte { return foreignBackendBody(t, lxTerminateBody(t, nil)) }, \\\"stale_fenced\\\"},\\n500-\\t\\t{\\\"restore\\\", func(t *testing.T) []byte { return foreignBackendBody(t, lxRestoreBody(t, lxDigestA, nil)) }, \\\"absent\\\"},\\n501-\\t}\\n502-\\tfor _, tc := range cases {\\n503-\\t\\tt.Run(tc.operation, func(t *testing.T) {\\n504-\\t\\t\\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\\n505-\\t\\t\\tpresented, winner := terminateFencing()\\n506-\\t\\t\\t_, err := fx.lc.Execute(context.Background(), OpRequest{\\n507-\\t\\t\\t\\tOperation: tc.operation, Body: tc.body(t), Source: tc.source,\\n508-\\t\\t\\t\\tAdmitted: fullLifecycleAdmitted(), Presented: presented, Winner: winner,\\n509-\\t\\t\\t\\tHasWinner: true, ForceRecovery: true, DiagnosticsPreserved: true,\\n510-\\t\\t\\t})\\n511-\\t\\t\\trequireLocalCode(t, err, \\\"local_precondition_failed\\\", \\\"lifecycle backend\\\")\\n512-\\t\\t\\tif fx.runner.callCount() != 0 {\\n513-\\t\\t\\t\\tt.Fatalf(\\\"%s execed %d commands\\\", tc.operation, fx.runner.callCount())\\n514-\\t\\t\\t}\\n515-\\t\\t})\\n516-\\t}\\n517-}\\n===LEN-TEST===\\nfunc TestCheckSocketLengthBounds(t *testing.T) {\\n\\tcases := []struct {\\n\\t\\tname     string\\n\\t\\tplatform scalar.Platform\\n\\t\\tadmit    int\\n\\t\\trefuse   int\\n\\t}{\\n\\t\\t{\\\"darwin\\\", scalar.PlatformMacOS, 103, 104},\\n\\t\\t{\\\"linux\\\", scalar.PlatformLinux, 107, 108},\\n\\t\\t{\\\"wsl2\\\", scalar.PlatformWSL2, 107, 108},\\n\\t}\\n\\tfor _, tc := range cases {\\n\\t\\tt.Run(tc.name, func(t *testing.T) {\\n\\t\\t\\tif err := CheckSocketLength(strings.Repeat(\\\"a\\\", tc.admit), tc.platform); err != nil {\\n\\t\\t\\t\\tt.Fatalf(\\\"length %d refused: %v\\\", tc.admit, err)\\n\\t\\t\\t}\\n\\t\\t\\tif err := CheckSocketLength(strings.Repeat(\\\"a\\\", tc.refuse), tc.platform); err == nil {\\n\\t\\t\\t\\tt.Fatalf(\\\"length %d admitted\\\", tc.refuse)\\n\\t\\t\\t} else {\\n\\t\\t\\t\\trequireLocalCode(t, err, \\\"tmux_socket_path_too_long\\\", \\\"socket path length\\\")\\n\\t\\t\\t}\\n\\t\\t})\\n\\t}\\n}\\n\\nfunc TestCheckSocketLengthCountsBytes(t *testing.T) {\\n\\t// Multibyte runes count their UTF-8 bytes: 52 two-byte runes are\\n\\t// 104 bytes and refuse on darwin, while 51 (102 bytes) admit.\\n\\tif err := CheckSocketLength(strings.Repeat(\\\"é\\\", 51), scalar.PlatformMacOS); err != nil {\\n\\t\\tt.Fatalf(\\\"102-byte socket refused: %v\\\", err)\\n\\t}\\n\\tif err := CheckSocketLength(strings.Repeat(\\\"é\\\", 52), scalar.PlatformMacOS); err == nil {\\n\\t\\tt.Fatal(\\\"104-byte socket admitted\\\")\\n\\t} else {\\n\\t\\trequireLocalCode(t, err, \\\"tmux_socket_path_too_long\\\", \\\"socket path length\\\")\\n\\t}\\n}\\n\\n\",\n  \"original_output_bytes\": 3198,\n  \"original_output_tokens\": 800,\n  \"truncated\": false\n}","final_result":true}}}
