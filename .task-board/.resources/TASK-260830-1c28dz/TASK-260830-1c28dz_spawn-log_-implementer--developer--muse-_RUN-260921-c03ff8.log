nal/tmuxserver/lifecycle.go-283-// digits the grammar requires.\\ninternal/tmuxserver/lifecycle.go-284-func formatTimestamp(now time.Time) string {\\ninternal/tmuxserver/lifecycle.go-285-\\treturn now.UTC().Format(\\\"2006-01-02T15:04:05.000Z07:00\\\")\\ninternal/tmuxserver/lifecycle.go-286-}\\ninternal/tmuxserver/lifecycle.go-287-\\ninternal/tmuxserver/lifecycle.go-288-// executeCreate runs the full create body: closed-shape admission,\\ninternal/tmuxserver/lifecycle.go-289-// backend and transport gates, binding agreement, then the landed\\ninternal/tmuxserver/lifecycle.go-290-// engine with the tmux backend. The result echoes the carried binding\\ninternal/tmuxserver/lifecycle.go-291-// and, exactly when interactive, the unbound attach descriptor.\\ninternal/tmuxserver/lifecycle.go-292-func (lc *Lifecycle) executeCreate(ctx context.Context, req OpRequest, socket string) (OpOutcome, error) {\\ninternal/tmuxserver/lifecycle.go-293-\\tempty := OpOutcome{Operation: terminalbackend.OperationCreate}\\ninternal/tmuxserver/lifecycle.go-294-\\tbody, err := parseCreateBody(req.Body)\\ninternal/tmuxserver/lifecycle.go-295-\\tif err != nil {\\ninternal/tmuxserver/lifecycle.go-296-\\t\\treturn empty, err\\ninternal/tmuxserver/lifecycle.go-297-\\t}\\ninternal/tmuxserver/lifecycle.go-298-\\tif err := checkLifecycleBackend(body.Context.TerminalBackendID); err != nil {\\ninternal/tmuxserver/lifecycle.go-299-\\t\\treturn empty, err\\ninternal/tmuxserver/lifecycle.go-300-\\t}\\n--\\ninternal/tmuxserver/lifecycle.go:270:func rowError(operation terminalbackend.Operation, err error) error {\\ninternal/tmuxserver/lifecycle.go-271-\\tcode := backendErrorCode(err)\\ninternal/tmuxserver/lifecycle.go-272-\\tif code == \\\"\\\" {\\ninternal/tmuxserver/lifecycle.go-273-\\t\\treturn err\\ninternal/tmuxserver/lifecycle.go-274-\\t}\\ninternal/tmuxserver/lifecycle.go-275-\\tif checkErr := terminalbackend.CheckErrorAllowed(string(operation), code); checkErr != nil {\\ninternal/tmuxserver/lifecycl