{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000da8d","stream":{"kind":"session","id":"01a0c620-a10f-77d2-842c-eaf24fab8e2e"},"sequence":2977,"recorded_at":1780531400005949,"record_type":"event","durability":"durable","causation_id":"0cdc816d-6145-48a9-a49c-390655512ae9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0cdc816d-6145-48a9-a49c-390655512ae9","run_stream":{"kind":"run","id":"0cdc816d-6145-48a9-a49c-390655512ae9"},"task_stream":{"kind":"task","id":"01a0c649-509a-7001-ae3b-ade51b64227f"},"task_id":"01a0c649-509a-7001-ae3b-ade51b64227f","event":{"kind":"output","task_id":"01a0c649-509a-7001-ae3b-ade51b64227f","chunk":"edited\nchanged lines: lines 36-58\n--- original\n+++ updated\n@@\n-func TestUnixDialerLiveStaleUnknown(t *testing.T) {\n-\troot, socket := lxProbeRoot(t)\n-\tdialer := UnixDialer{}\n-\tif got := dialer.Dial(socket); got != DialUnknown {\n-\t\tt.Fatalf(\"missing socket = %s, want unknown\", got)\n-\t}\n-\tlistener, err := net.Listen(\"unix\", socket)\n-\tif err != nil {\n-\t\tt.Fatal(err)\n-\t}\n-\tif got := dialer.Dial(socket); got != DialLive {\n-\t\tt.Fatalf(\"live socket = %s, want live\", got)\n-\t}\n-\tif err := listener.Close(); err != nil {\n-\t\tt.Fatal(err)\n-\t}\n-\t// Closing the listener without removing the path leaves a refused\n-\t// (stale) socket: ECONNREFUSED, never unknown, never live.\n-\tif got := dialer.Dial(socket); got != DialStale {\n-\t\tt.Fatalf(\"stale socket = %s, want stale\", got)\n-\t}\n-\t_ = root\n-}\n+// stageStaleSocket binds a unix socket and closes the descriptor\n+// without unlinking the path: the shape a SIGKILLed server leaves\n+// behind (Go's net listener unlinks on close, so raw syscalls stage\n+// it). Dialing the staged path reports ECONNREFUSED.\n+func stageStaleSocket(t *testing.T, socket string) {\n+\tt.Helper()\n+\tfd, err := syscall.Socket(syscall.AF_UNIX, syscall.SOCK_STREAM, 0)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tdefer syscall.Close(fd)\n+\tif err := syscall.Bind(fd, &syscall.SockaddrUnix{Name: socket}); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+}\n+\n+func TestUnixDialerLiveStaleUnknown(t *testing.T) {\n+\t_, socket := lxProbeRoot(t)\n+\tdialer := UnixDialer{}\n+\tlistener, err := net.Listen(\"unix\", socket)\n+\tif err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tif got := dialer.Dial(socket); got != DialLive {\n+\t\tlistener.Close()\n+\t\tt.Fatalf(\"live socket = %s, want live\", got)\n+\t}\n+\t// A refused socket stages through a bound-then-closed descriptor;\n+\t// closing the Go listener would unlink the path instead.\n+\taddr := listener.Addr().String()\n+\tif err := listener.Close(); err != nil {\n+\t\tt.Fatal(err)\n+\t}\n+\tstageStaleSocket(t, addr)\n+\tif got := dialer.Dial(socket); got != DialStale {\n+\t\tt.Fatalf(\"stale socket = %s, want stale\", got)\n+\t}\n+}\n","final_result":true}}}
