c.append(\\\"internal/tmuxserver/mutant_harness.py`: 100 second-leaf\\\")\\ndoc.append(\\\"narrowing rows KILLED, 1 harmless control SURVIVED (shared with\\\")\\ndoc.append(\\\"the first leaf's 76 rows, all still green), full pass with one\\\")\\ndoc.append(\\\"raw log per plant in the evidence tarball. Multi-entry rows\\\")\\ndoc.append(\\\"list every entry their killers cover, attribution verified per\\\")\\ndoc.append(\\\"test from the raw logs (see the row notes). Singleton refusal\\\")\\ndoc.append(\\\"arms ship no row by bound B22; engine-normalized status details\\\")\\ndoc.append(\\\"measure at the helper by bound B23.\\\")\\ndoc.append(\\\"\\\")\\ndoc.append(\\\"## Crash, idempotency, and determinism\\\")\\ndoc.append(\\\"\\\")\\ndoc.append(\\\"Every mutating operation replays the identical request without\\\")\\ndoc.append(\\\"new execs (seven idempotency tests, one per mutating op);\\\")\\ndoc.append(\\\"uncertain receipts reconcile through status before resuming\\\")\\ndoc.append(\\\"(resume tests for effect failure, recheck failure, and\\\")\\ndoc.append(\\\"otherwise-proven status); tampered and corrupt replays refuse\\\")\\ndoc.append(\\\"(per-member tamper table, corrupt-image, hook-failure tests).\\\")\\ndoc.append(\\\"No committed test execs a real tmux, dials a real socket, or\\\")\\ndoc.append(\\\"reads wall time: the scripted runner, staged sockets, and\\\")\\ndoc.append(\\\"manual clock are the only tmux the suite sees, and the suite\\\")\\ndoc.append(\\\"passes with no tmux installed (bound B1).\\\")\\ndoc.append(\\\"\\\")\\ndoc.append(\\\"## Validation and evidence\\\")\\ndoc.append(\\\"\\\")\\ndoc.append(\\\"Full 30-command configured suite green firsthand on the frozen\\\")\\ndoc.append(\\\"tree (gofmt, build, vet, full suite, race gate, cover, all fuzz\\\")\\ndoc.append(\\\"gates, tracecheck, cataloggen, linux/windows builds, JSON\\\")\\ndoc.append(\\\"check, board validate, diff check, windows vet); the\\\")\\ndoc.append(\\\"OUTCOME-keyed