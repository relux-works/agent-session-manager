y_authorization\\\", \\\"runtime_probe\\\"},\\n137-\\t},\\n138-\\t\\\"remote_attach\\\": {\\n139-\\t\\tgenerationVariable:   true,\\n140:\\t\\tdependentOperations:  []string{\\\"attach\\\"},\\n141-\\t\\tevidenceRequirements: []string{\\\"conformance_fixture\\\", \\\"policy_authorization\\\", \\\"runtime_probe\\\"},\\n142-\\t},\\n143-\\t\\\"web_attach\\\": {\\n144-\\t\\tgenerationVariable:   true,\\n133:\\t\\\"local_attach\\\": {\\n138:\\t\\\"remote_attach\\\": {\\n143:\\t\\\"web_attach\\\": {\\n===RETRYDISP===\\ninternal/terminstance/disposition.go:16:func ParseRetryDisposition(value string) (RetryDisposition, error) {\\ninternal/terminstance/disposition.go-17-\\tswitch RetryDisposition(value) {\\ninternal/terminstance/disposition.go-18-\\tcase DispositionReplaySame, DispositionStatusFirst,\\ninternal/terminstance/disposition.go-19-\\t\\tDispositionNewAuthorization, DispositionRequiredOperatorAction:\\ninternal/terminstance/disposition.go-20-\\t\\treturn RetryDisposition(value), nil\\ninternal/terminstance/disposition.go-21-\\tdefault:\\ninternal/terminstance/disposition.go-22-\\t\\treturn \\\"\\\", refuse(CodeProtocolError, \\\"retry disposition vocabulary\\\")\\ninternal/terminstance/disposition.go-23-\\t}\\ninternal/terminstance/disposition.go-24-}\\ninternal/terminstance/disposition.go-25-\\ninternal/terminstance/disposition.go-26-// DispositionFor maps a terminal failure code to its retry disposition.\\ninternal/terminstance/disposition.go-27-// committed reports whether any side effect committed before the failure:\\ninternal/terminstance/disposition.go-28-// an error before the first effect restores the source state and may be\\n===ERRFMT===\\n53:func (err *Error) Error() string {\\n54-\\treturn \\\"tmux server refused: \\\" + err.Code + \\\" at \\\" + err.Detail\\n55-}\\ninternal/tmuxserver/errors.go:24:\\tCodeReadinessNotAuthorizing = \\\"tmux_readiness_not_authorizing\\\"\\n\",\n  \"original_output_bytes\": 2273,\n  \"original_output_tokens\": 569,\n  \"tr