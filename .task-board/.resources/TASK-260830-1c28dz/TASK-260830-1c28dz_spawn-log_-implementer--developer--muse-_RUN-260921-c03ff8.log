{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000f217","stream":{"kind":"session","id":"01a0c620-a10f-77d2-842c-eaf24fab8e2e"},"sequence":5990,"recorded_at":1780531400011975,"record_type":"event","durability":"durable","causation_id":"0cdc816d-6145-48a9-a49c-390655512ae9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0cdc816d-6145-48a9-a49c-390655512ae9","run_stream":{"kind":"run","id":"0cdc816d-6145-48a9-a49c-390655512ae9"},"task_stream":{"kind":"task","id":"01a0c667-b5b5-7373-8c9b-675cec2e46e8"},"task_id":"01a0c667-b5b5-7373-8c9b-675cec2e46e8","event":{"kind":"output","task_id":"01a0c667-b5b5-7373-8c9b-675cec2e46e8","chunk":"Read text file `internal/tmuxserver/bodies.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"encoding/json\"\n5|\n6|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n7|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n8|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n9|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n10|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n11|)\n12|\n13|// This file admits the four closed operation bodies the landed engine\n14|// leaves out: the full create body (the engine runs create in receipt\n15|// scope only), attach, terminate-stale, and restore. Quiesce-input,\n16|// wait-safe-boundary, and request-stop bodies stay owned by\n17|// terminstance.ParseOperationBody and status bodies by\n18|// terminstance.ParseStatusBody; those parsers are reused, never\n19|// re-implemented. Every nested document (mutation context, binding,\n20|// attach authorization) is admitted by its landed owner; only the\n21|// member lists — which only these schemas can name — are local.\n22|\n23|// CreateBody is the closed §4.C create body: context, binding,\n24|// bootstrap_operation_id, entrypoint, presentation_transport, and\n25|// interactive.\n26|type CreateBody struct {\n27|\tContext              terminstance.MutationContext\n28|\tBinding              termbind.Binding\n29|\tBootstrapOperationID string\n30|\tTransport            string\n31|\tInteractive          bool\n32|}\n33|\n34|// createBodyMembers is the exact closed member set.\n35|var createBodyMembers = []string{\n36|\t\"context\",\n37|\t\"binding\",\n38|\t\"bootstrap_operation_id\",\n39|\t\"entrypoint\",\n40|\t\"presentation_transport\",\n41|\t\"interactive\",\n42|}\n43|\n44|// parseCreateBody admits one closed create body. The nested mutation\n45|// context, terminal instance binding, and entrypoint are admitted by\n46|// their landed owners; the transport admits the three-literal closed\n47|// vocabulary here and the relay member refuses at the handler (create\n48|// carries no attach authorization, so no landed relay arm stands\n49|// downstream).\n50|func parseCreateBody(raw []byte) (CreateBody, error) {\n51|\tmembers, fault := environ.DecodeStrictObject(raw)\n52|\tif fault != nil {\n53|\t\treturn CreateBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"create body frame\"}\n54|\t}\n55|\tif len(members) != len(createBodyMembers) {\n56|\t\treturn CreateBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"create body members\"}\n57|\t}\n58|\tfor _, member := range createBodyMembers {\n59|\t\tif _, known := members[member]; !known {\n60|\t\t\treturn CreateBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"create body members\"}\n61|\t\t}\n62|\t}\n63|\tcontext, err := terminstance.ParseMutationContext(members[\"context\"])\n64|\tif err != nil {\n65|\t\treturn CreateBody{}, err\n66|\t}\n67|\tbinding, err := termbind.ParseTerminalBinding(members[\"binding\"])\n68|\tif err != nil {\n69|\t\treturn CreateBody{}, err\n70|\t}\n71|\tbootstrap, ok := environ.CheckUUIDv7(members[\"bootstrap_operation_id\"])\n72|\tif !ok {\n73|\t\treturn CreateBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"create body bootstrap\"}\n74|\t}\n75|\targv, err := parseEntrypointArgv(members[\"entrypoint\"])\n76|\tif err != nil {\n77|\t\treturn CreateBody{}, err\n78|\t}\n79|\tif err := terminalbackend.CheckEntrypoint(argv, context.SessionID); err != nil {\n80|\t\treturn CreateBody{}, err\n81|\t}\n82|\ttransport, err := parsePresentationTransport(members[\"presentation_transport\"])\n83|\tif err != nil {\n84|\t\treturn CreateBody{}, err\n85|\t}\n86|\tvar interactive bool\n87|\tif err := json.Unmarshal(members[\"interactive\"], &interactive); err != nil {\n88|\t\treturn CreateBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"create body interactive\"}\n89|\t}\n90|\treturn CreateBody{\n91|\t\tContext:              context,\n92|\t\tBinding:              binding,\n93|\t\tBootstrapOperationID: bootstrap.String(),\n94|\t\tTransport:            transport,\n95|\t\tInteractive:          interactive,\n96|\t}, nil\n97|}\n98|\n99|// parseEntrypointArgv admits the closed Entrypoint object {argv} and\n100|// reads its three-element vector. Length and literals are the landed\n101|// CheckEntrypoint's verdict, not this function's.\n102|func parseEntrypointArgv(raw json.RawMessage) ([]string, error) {\n103|\tobject, fault := environ.DecodeStrictObject(raw)\n104|\tif fault != nil {\n105|\t\treturn nil, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"create body entrypoint\"}\n106|\t}\n107|\tif len(object) != 1 {\n108|\t\treturn nil, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"create body entrypoint\"}\n109|\t}\n110|\tmember, known := object[\"argv\"]\n111|\tif !known {\n112|\t\treturn nil, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"create body entrypoint\"}\n113|\t}\n114|\tvar argv []string\n115|\tif err := json.Unmarshal(member, &argv); err != nil {\n116|\t\treturn nil, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"create body entrypoint\"}\n117|\t}\n118|\treturn argv, nil\n119|}\n120|\n121|// parsePresentationTransport admits the closed three-literal transport\n122|// vocabulary. Admission is not authorization: the relay member parses\n123|// and refuses downstream (landed attach arm for attach, the create\n124|// relay arm for create).\n125|func parsePresentationTransport(raw json.RawMessage) (string, error) {\n126|\ttransport, ok := bodyString(raw)\n127|\tif !ok {\n128|\t\treturn \"\", &Error{Code: terminalbackend.CodeProtocolError, Detail: \"presentation transport vocabulary\"}\n129|\t}\n130|\tswitch transport {\n131|\tcase string(terminalbackend.TransportLocalOnly),\n132|\t\tstring(terminalbackend.TransportTrustedPrivateMesh),\n133|\t\tstring(terminalbackend.TransportThirdPartyRelay):\n134|\t\treturn transport, nil\n135|\tdefault:\n136|\t\treturn \"\", &Error{Code: terminalbackend.CodeProtocolError, Detail: \"presentation transport vocabulary\"}\n137|\t}\n138|}\n139|\n140|// AttachBody is the closed §4.C attach body: the flat identity tuple,\n141|// client, transport, input boolean, deadline, and attach authorization.\n142|// AuthRaw carries the authorization member's raw bytes so the attach\n143|// store re-admits the exact presented document without a re-frame.\n144|type AttachBody struct {\n145|\tSessionID             string\n146|\tTerminalInstanceID    string\n147|\tTerminalBackendID     string\n148|\tImplementationVersion string\n149|\tProtocolVersion       string\n150|\tBackendGeneration     string\n151|\tClientID              string\n152|\tTransport             string\n153|\tInputAuthorized       bool\n154|\tDeadline              scalar.Timestamp\n155|\tAuthorization         terminalbackend.AttachAuthorization\n156|\tAuthRaw               json.RawMessage\n157|}\n158|\n159|// attachBodyMembers is the exact closed member set.\n160|var attachBodyMembers = []string{\n161|\t\"session_id\",\n162|\t\"terminal_instance_id\",\n163|\t\"terminal_backend_id\",\n164|\t\"implementation_version\",\n165|\t\"protocol_version\",\n166|\t\"backend_generation\",\n167|\t\"client_id\",\n168|\t\"transport\",\n169|\t\"input_authorized\",\n170|\t\"deadline_at\",\n171|\t\"authorization\",\n172|}\n173|\n174|// parseAttachBody admits one closed attach body. The nested attach\n175|// authorization is admitted by its landed owner; version-tuple and\n176|// generation grammars delegate to the landed gates the status body\n177|// already uses.\n178|func parseAttachBody(raw []byte) (AttachBody, error) {\n179|\tmembers, fault := environ.DecodeStrictObject(raw)\n180|\tif fault != nil {\n181|\t\treturn AttachBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body frame\"}\n182|\t}\n183|\tif len(members) != len(attachBodyMembers) {\n184|\t\treturn AttachBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body members\"}\n185|\t}\n186|\tfor _, member := range attachBodyMembers {\n187|\t\tif _, known := members[member]; !known {\n188|\t\t\treturn AttachBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body members\"}\n189|\t\t}\n190|\t}\n191|\tsession, ok := environ.CheckUUIDv7(members[\"session_id\"])\n192|\tif !ok {\n193|\t\treturn AttachBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body session\"}\n194|\t}\n195|\tinstance, ok := environ.CheckUUIDv7(members[\"terminal_instance_id\"])\n196|\tif !ok {\n197|\t\treturn AttachBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body instance\"}\n198|\t}\n199|\tbackendID, ok := bodyString(members[\"terminal_backend_id\"])\n200|\tif !ok {\n201|\t\treturn AttachBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body backend\"}\n202|\t}\n203|\tif _, err := terminalbackend.ParseID(backendID); err != nil {\n204|\t\treturn AttachBody{}, err\n205|\t}\n206|\timplementationVersion, ok := bodyString(members[\"implementation_version\"])\n207|\tif !ok {\n208|\t\treturn AttachBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body versions\"}\n209|\t}\n210|\tprotocolVersion, ok := bodyString(members[\"protocol_version\"])\n211|\tif !ok {\n212|\t\treturn AttachBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body versions\"}\n213|\t}\n214|\tif err := terminalbackend.CheckVersionTuple(backendID, implementationVersion, protocolVersion, []string{protocolVersion}); err != nil {\n215|\t\treturn AttachBody{}, err\n216|\t}\n217|\tgeneration, ok := environ.CheckStringBounds(members[\"backend_generation\"], 1, 256)\n218|\tif !ok {\n219|\t\treturn AttachBody{}, &Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation bound\"}\n220|\t}\n221|\tclient, ok := environ.CheckUUIDv7(members[\"client_id\"])\n222|\tif !ok {\n223|\t\treturn AttachBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body client\"}\n224|\t}\n225|\ttransport, err := parsePresentationTransport(members[\"transport\"])\n226|\tif err != nil {\n227|\t\treturn AttachBody{}, err\n228|\t}\n229|\tvar inputAuthorized bool\n230|\tif err := json.Unmarshal(members[\"input_authorized\"], &inputAuthorized); err != nil {\n231|\t\treturn AttachBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body input\"}\n232|\t}\n233|\tdeadline, ok := environ.CheckTimestamp(members[\"deadline_at\"])\n234|\tif !ok {\n235|\t\treturn AttachBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"attach body deadline\"}\n236|\t}\n237|\tauthorization, err := terminalbackend.ParseAttachAuthorization(members[\"authorization\"])\n238|\tif err != nil {\n239|\t\treturn AttachBody{}, err\n240|\t}\n241|\treturn AttachBody{\n242|\t\tSessionID:             session.String(),\n243|\t\tTerminalInstanceID:    instance.String(),\n244|\t\tTerminalBackendID:     backendID,\n245|\t\tImplementationVersion: implementationVersion,\n246|\t\tProtocolVersion:       protocolVersion,\n247|\t\tBackendGeneration:     generation,\n248|\t\tClientID:              client.String(),\n249|\t\tTransport:             transport,\n250|\t\tInputAuthorized:       inputAuthorized,\n251|\t\tDeadline:              deadline,\n252|\t\tAuthorization:         authorization,\n253|\t\tAuthRaw:               members[\"authorization\"],\n254|\t}, nil\n255|}\n256|\n257|// TerminateBody is the closed §4.C terminate-stale body: context,\n258|// stale_lease_id, stale_epoch, and diagnostic_evidence_id.\n259|type TerminateBody struct {\n260|\tContext             terminstance.MutationContext\n261|\tStaleLeaseID        string\n262|\tStaleEpoch          uint64\n263|\tDiagnosticEvidenceID string\n264|}\n265|\n266|// terminateBodyMembers is the exact closed member set.\n267|var terminateBodyMembers = []string{\n268|\t\"context\",\n269|\t\"stale_lease_id\",\n270|\t\"stale_epoch\",\n271|\t\"diagnostic_evidence_id\",\n272|}\n273|\n274|// parseTerminateBody admits one closed terminate-stale body.\n275|func parseTerminateBody(raw []byte) (TerminateBody, error) {\n276|\tmembers, fault := environ.DecodeStrictObject(raw)\n277|\tif fault != nil {\n278|\t\treturn TerminateBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminate body frame\"}\n279|\t}\n280|\tif len(members) != len(terminateBodyMembers) {\n281|\t\treturn TerminateBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminate body members\"}\n282|\t}\n283|\tfor _, member := range terminateBodyMembers {\n284|\t\tif _, known := members[member]; !known {\n285|\t\t\treturn TerminateBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminate body members\"}\n286|\t\t}\n287|\t}\n288|\tcontext, err := terminstance.ParseMutationContext(members[\"context\"])\n289|\tif err != nil {\n290|\t\treturn TerminateBody{}, err\n291|\t}\n292|\tleaseRaw, ok := bodyString(members[\"stale_lease_id\"])\n293|\tif !ok {\n294|\t\treturn TerminateBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminate body lease\"}\n295|\t}\n296|\tlease, err := scalar.ParseUUIDv4(leaseRaw)\n297|\tif err != nil {\n298|\t\treturn TerminateBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminate body lease\"}\n299|\t}\n300|\tepoch, ok := environ.CheckUint53Bounds(members[\"stale_epoch\"], 1, scalar.MaxUint53)\n301|\tif !ok {\n302|\t\treturn TerminateBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminate body epoch\"}\n303|\t}\n304|\tdiagnostic, ok := environ.CheckDigest(members[\"diagnostic_evidence_id\"])\n305|\tif !ok {\n306|\t\treturn TerminateBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminate body evidence\"}\n307|\t}\n308|\treturn TerminateBody{\n309|\t\tContext:             context,\n310|\t\tStaleLeaseID:        lease.String(),\n311|\t\tStaleEpoch:          epoch,\n312|\t\tDiagnosticEvidenceID: diagnostic.String(),\n313|\t}, nil\n314|}\n315|\n316|// RestoreBody is the closed §4.C restore body: context,\n317|// prior_binding_id, checkpoint_id, and bootstrap_operation_id.\n318|type RestoreBody struct {\n319|\tContext              terminstance.MutationContext\n320|\tPriorBindingID       string\n321|\tCheckpointID         string\n322|\tBootstrapOperationID string\n323|}\n324|\n325|// restoreBodyMembers is the exact closed member set.\n326|var restoreBodyMembers = []string{\n327|\t\"context\",\n328|\t\"prior_binding_id\",\n329|\t\"checkpoint_id\",\n330|\t\"bootstrap_operation_id\",\n331|}\n332|\n333|// parseRestoreBody admits one closed restore body.\n334|func parseRestoreBody(raw []byte) (RestoreBody, error) {\n335|\tmembers, fault := environ.DecodeStrictObject(raw)\n336|\tif fault != nil {\n337|\t\treturn RestoreBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"restore body frame\"}\n338|\t}\n339|\tif len(members) != len(restoreBodyMembers) {\n340|\t\treturn RestoreBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"restore body members\"}\n341|\t}\n342|\tfor _, member := range restoreBodyMembers {\n343|\t\tif _, known := members[member]; !known {\n344|\t\t\treturn RestoreBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"restore body members\"}\n345|\t\t}\n346|\t}\n347|\tcontext, err := terminstance.ParseMutationContext(members[\"context\"])\n348|\tif err != nil {\n349|\t\treturn RestoreBody{}, err\n350|\t}\n351|\tprior, ok := environ.CheckDigest(members[\"prior_binding_id\"])\n352|\tif !ok {\n353|\t\treturn RestoreBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"restore body binding\"}\n354|\t}\n355|\tcheckpoint, ok := environ.CheckDigest(members[\"checkpoint_id\"])\n356|\tif !ok {\n357|\t\treturn RestoreBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"restore body checkpoint\"}\n358|\t}\n359|\tbootstrap, ok := environ.CheckUUIDv7(members[\"bootstrap_operation_id\"])\n360|\tif !ok {\n361|\t\treturn RestoreBody{}, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"restore body bootstrap\"}\n362|\t}\n363|\treturn RestoreBody{\n364|\t\tContext:              context,\n365|\t\tPriorBindingID:       prior.String(),\n366|\t\tCheckpointID:         checkpoint.String(),\n367|\t\tBootstrapOperationID: bootstrap.String(),\n368|\t}, nil\n369|}\n370|\n371|// bodyString reads a JSON string member. Non-string members are\n372|// malformed, never coerced.\n373|func bodyString(raw json.RawMessage) (string, bool) {\n374|\tvar value string\n375|\tif err := json.Unmarshal(raw, &value); err != nil {\n376|\t\treturn \"\", false\n377|\t}\n378|\treturn value, true\n379|}","final_result":true}}}
