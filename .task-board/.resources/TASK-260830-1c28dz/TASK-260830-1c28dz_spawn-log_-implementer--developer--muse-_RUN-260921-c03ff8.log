{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cb63","stream":{"kind":"session","id":"01a0c620-a10f-77d2-842c-eaf24fab8e2e"},"sequence":1036,"recorded_at":1780531400002067,"record_type":"event","durability":"durable","causation_id":"0cdc816d-6145-48a9-a49c-390655512ae9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0cdc816d-6145-48a9-a49c-390655512ae9","run_stream":{"kind":"run","id":"0cdc816d-6145-48a9-a49c-390655512ae9"},"task_stream":{"kind":"task","id":"01a0c627-bde2-7e02-a785-eac22bbe19b0"},"task_id":"01a0c627-bde2-7e02-a785-eac22bbe19b0","event":{"kind":"output","task_id":"01a0c627-bde2-7e02-a785-eac22bbe19b0","chunk":"{\n  \"chunk_id\": \"exec-45-1\",\n  \"command\": \"head -n 120 internal/tmuxserver/mutant_harness.py; echo \\\"...\\\"; grep -n \\\"ROWS\\\\|\\\\\\\"id\\\\\\\"\\\\|def main\\\\|subprocess\\\\|run(\\\" internal/tmuxserver/mutant_harness.py | head -n 30\",\n  \"description\": \"Survey harness structure\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"#!/usr/bin/env python3\\n\\\"\\\"\\\"Narrowing-mutant harness for internal/tmuxserver.\\n\\nEvery gate ships a narrowing mutant: the gate stays present and is\\nweakened to admit exactly one member of the class it must reject, and\\nthe named killer tests must fail. A delete-only mutant proves only that\\nthe gate exists and is not accepted as evidence; rows D-background-fallback\\nand D-background-fallback-foreground are the two explicitly supplementary\\nadditive plants (reviewer-shaped direct-creation calls on the background\\npath), labeled as such and not counted as any gate's narrowing.\\n\\nEach row runs M (mutate production files in place), R (run the scoped Go\\nkillers through the production entries), V (verdict from the Go exit code\\nplus a FAIL kill-line: KILLED iff R fails with a test failure line,\\nSURVIVED iff R passes, ERROR for anything else -- unapplied patches,\\nbuild breaks, timeouts). M failures and R infrastructure errors are\\nERROR, never kills or survivals. Files are restored from backups after\\nevery row, pass or fail.\\n\\nRow C-control is the harmless control: a comment-only edit that must\\nSURVIVE, proving the harness observes test outcomes instead of\\nhard-coding kills.\\n\\nUsage:\\n  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py\\n  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py N-mode-create\\n  PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py --log-dir /tmp/mutant-logs\\n  AX_MUTANT_VERBOSE=1 PYTHONDONTWRITEBYTECODE=1 python3 internal/tmuxserver/mutant_harness.py N-mode-create\\n\\\"\\\"\\\"\\n\\nimport os\\nimport shutil\\nimport subprocess\\nimport sys\\nimport tempfile\\nfrom dataclasses import dataclass\\nfrom pathlib import Path\\n\\nREPO = Path(__file__).resolve().parents[2]\\nPACKAGE = \\\"internal/tmuxserver\\\"\\n\\n\\n@dataclass(frozen=True)\\nclass Mutant:\\n    name: str\\n    path: str\\n    find: str\\n    replace: str\\n    count: int\\n    run: str\\n    expect: str\\n    note: str\\n\\n\\nBG_MISS = \\\"TestAcquireBackgroundMissReturnsTypedUnavailable\\\"\\nBG_MISS_LINUX = \\\"(TestAcquireBackgroundMissReturnsTypedUnavailable|TestAcquireBackgroundMissOnLinuxAlsoRefusesWithoutFallback)\\\"\\nOVERRIDE = \\\"TestAcquireRefusesEveryAmbientOverrideVector\\\"\\nRES_OVERRIDE = \\\"(TestAcquireRefusesEveryAmbientOverrideVector|TestResolveSocketRefusesEveryOverrideVector)\\\"\\nWIDENED = \\\"TestEnsureRuntimeDirRefusesWidenedMode\\\"\\nCOLLISION = \\\"(TestResolveSocketRefusesAmbientCollision|TestAcquireRefusesAmbientCollision)\\\"\\n\\nMUTANTS = [\\n    Mutant(\\n        name=\\\"N-mode-create\\\",\\n        path=f\\\"{PACKAGE}/runtime_unix.go\\\",\\n        find=\\\"\\\\t// leaf above; the mode comparison below is the load-bearing\\\\n\\\\t// arm this gate's tests and mutants pin.\\\\n\\\\tif info.Mode().Perm() != 0o700 {\\\\n\\\",\\n        replace=\\\"\\\\t// leaf above; the mode comparison below is the load-bearing\\\\n\\\\t// arm this gate's tests and mutants pin.\\\\n\\\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o755 {\\\\n\\\",\\n        count=1,\\n        run=WIDENED,\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly 0755 at the create-path mode arm; other widened modes still refuse. Kill path: Ensure stops refusing.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-mode-verify\\\",\\n        path=f\\\"{PACKAGE}/runtime_unix.go\\\",\\n        find='\\\\tinfo, err := leaf.Stat()\\\\n\\\\tif err != nil {\\\\n\\\\t\\\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime mode\\\"}\\\\n\\\\t}\\\\n\\\\tif info.Mode().Perm() != 0o700 {\\\\n',\\n        replace='\\\\tinfo, err := leaf.Stat()\\\\n\\\\tif err != nil {\\\\n\\\\t\\\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime mode\\\"}\\\\n\\\\t}\\\\n\\\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o755 {\\\\n',\\n        count=1,\\n        run=WIDENED,\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly 0755 at the verify-path mode arm; the create arm still refuses. Kill path: Verify stops refusing.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-mode-narrower-create\\\",\\n        path=f\\\"{PACKAGE}/runtime_unix.go\\\",\\n        find=\\\"\\\\t// leaf above; the mode comparison below is the load-bearing\\\\n\\\\t// arm this gate's tests and mutants pin.\\\\n\\\\tif info.Mode().Perm() != 0o700 {\\\\n\\\",\\n        replace=\\\"\\\\t// leaf above; the mode comparison below is the load-bearing\\\\n\\\\t// arm this gate's tests and mutants pin.\\\\n\\\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o600 {\\\\n\\\",\\n        count=1,\\n        run=\\\"TestEnsureRuntimeDirRefusesNarrowerMode\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly a 0600 leaf at the create-path mode arm; every other non-0700 mode (widened and narrower) still refuses. Kill path: Ensure stops refusing the 0600 fixture.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-mode-narrower-verify\\\",\\n        path=f\\\"{PACKAGE}/runtime_unix.go\\\",\\n        find='\\\\tinfo, err := leaf.Stat()\\\\n\\\\tif err != nil {\\\\n\\\\t\\\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime mode\\\"}\\\\n\\\\t}\\\\n\\\\tif info.Mode().Perm() != 0o700 {\\\\n',\\n        replace='\\\\tinfo, err := leaf.Stat()\\\\n\\\\tif err != nil {\\\\n\\\\t\\\\treturn &Error{Code: CodeUnsafeRuntimeDir, Detail: \\\"runtime mode\\\"}\\\\n\\\\t}\\\\n\\\\tif info.Mode().Perm() != 0o700 && info.Mode().Perm() != 0o600 {\\\\n',\\n        count=1,\\n        run=\\\"TestEnsureRuntimeDirRefusesNarrowerMode\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly a 0600 leaf at the verify-path mode arm; the create arm still refuses, so the kill comes from the Verify leg of the narrower-mode test. Narrower 0500 still refuses on both arms.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-fchmod-umask\\\",\\n        path=f\\\"{PACKAGE}/runtime_unix.go\\\",\\n        find=\\\"\\\\tif created {\\\\n\\\",\\n        replace=\\\"\\\\tif created && os.Geteuid() == 0 {\\\\n\\\",\\n        count=1,\\n        run=\\\"TestEnsureRuntimeDirEnforcesModeUnderRestrictiveUmask\\\",\\n        expect=\\\"KILLED\\\",\\n        note=\\\"Admits exactly non-root creates past the explicit post-mkdirat chmod; root creates still chmod. Kill path: under umask 0177 the leaf stays 0600 and the mode gate refuses. Non-root load-bearing, like the same-shaped reviewer plant.\\\",\\n    ),\\n    Mutant(\\n        name=\\\"N-ownership-uid\\\",\\n        path=f\\\"{PACKAGE}/ownership_unix.go\\\",\\n        find=\\\"\\\\tif stat.Uid != uint32(effectiveUID()) {\\\\n\\\",\\n        replace=\\\"\\\\tif stat.Uid != uint32(effectiveUID()) && stat.Uid != uint32(effectiveUID())-100000 {\\\\n\\\",\\n        count=1,\\n        run=\\\"TestEnsureRuntimeDirRefusesForeignOwnership\\\",\\n        expect=\\\"KILLED\\\",\\n...\\n33:import subprocess\\n841:            run = subprocess.run(\\n871:def main(argv: list[str]) -> int:\\n891:        except subprocess.TimeoutExpired:\\n\",\n  \"original_output_bytes\": 6330,\n  \"original_output_tokens\": 1583,\n  \"truncated\": false\n}","final_result":true}}}
