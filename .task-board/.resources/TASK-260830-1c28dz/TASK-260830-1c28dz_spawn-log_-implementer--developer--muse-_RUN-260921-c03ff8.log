{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000e981","stream":{"kind":"session","id":"01a0c620-a10f-77d2-842c-eaf24fab8e2e"},"sequence":4891,"recorded_at":1780531400009777,"record_type":"event","durability":"durable","causation_id":"0cdc816d-6145-48a9-a49c-390655512ae9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0cdc816d-6145-48a9-a49c-390655512ae9","run_stream":{"kind":"run","id":"0cdc816d-6145-48a9-a49c-390655512ae9"},"task_stream":{"kind":"task","id":"01a0c65d-21a3-7572-a3e8-142d9268b8d6"},"task_id":"01a0c65d-21a3-7572-a3e8-142d9268b8d6","event":{"kind":"output","task_id":"01a0c65d-21a3-7572-a3e8-142d9268b8d6","chunk":"Read text file `internal/tmuxserver/lifecycle_harness_test.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"fmt\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"strings\"\n11|\t\"sync\"\n12|\t\"testing\"\n13|\t\"time\"\n14|\n15|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n17|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n18|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n19|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n20|)\n21|\n22|// fakeRunner is a scripted Runner: responses are keyed by the tmux\n23|// subcommand (argv[3]), served FIFO per key, with every argv recorded.\n24|// An empty script for a key is a test failure (fail-closed scripts:\n25|// unexpected execs redden instead of returning zero values).\n26|type fakeRunner struct {\n27|\tmu        sync.Mutex\n28|\tscript    map[string][]fakeResponse\n29|\tcalls     [][]string\n30|\tonRun     func(argv []string)\n31|\ttransport map[string]error\n32|}\n33|\n34|type fakeResponse struct {\n35|\tstdout string\n36|\texit   int\n37|}\n38|\n39|func newFakeRunner() *fakeRunner {\n40|\treturn &fakeRunner{script: map[string][]fakeResponse{}, transport: map[string]error{}}\n41|}\n42|\n43|// queue appends one scripted response for a subcommand.\n44|func (runner *fakeRunner) queue(subcommand, stdout string, exit int) *fakeRunner {\n45|\trunner.mu.Lock()\n46|\tdefer runner.mu.Unlock()\n47|\trunner.script[subcommand] = append(runner.script[subcommand], fakeResponse{stdout: stdout, exit: exit})\n48|\treturn runner\n49|}\n50|\n51|// failTransport arms a transport error for a subcommand (served once,\n52|// FIFO ahead of queued responses when set).\n53|func (runner *fakeRunner) failTransport(subcommand string, err error) *fakeRunner {\n54|\trunner.mu.Lock()\n55|\tdefer runner.mu.Unlock()\n56|\trunner.transport[subcommand] = err\n57|\treturn runner\n58|}\n59|\n60|func (runner *fakeRunner) Run(_ context.Context, argv []string) (RunResult, error) {\n61|\trunner.mu.Lock()\n62|\tdefer runner.mu.Unlock()\n63|\trunner.calls = append(runner.calls, append([]string(nil), argv...))\n64|\tif runner.onRun != nil {\n65|\t\trunner.onRun(argv)\n66|\t}\n67|\tif len(argv) < 4 || argv[0] != \"tmux\" || argv[1] != \"-S\" {\n68|\t\treturn RunResult{}, fmt.Errorf(\"fake runner refuses unshaped argv %q\", argv)\n69|\t}\n70|\tkey := argv[3]\n71|\tif err, armed := runner.transport[key]; armed {\n72|\t\tdelete(runner.transport, key)\n73|\t\treturn RunResult{}, err\n74|\t}\n75|\tresponses := runner.script[key]\n76|\tif len(responses) == 0 {\n77|\t\treturn RunResult{}, fmt.Errorf(\"fake runner has no script for %q (call %d)\", key, len(runner.calls))\n78|\t}\n79|\tnext := responses[0]\n80|\trunner.script[key] = responses[1:]\n81|\treturn RunResult{Stdout: []byte(next.stdout), ExitCode: next.exit}, nil\n82|}\n83|\n84|func (runner *fakeRunner) callCount() int {\n85|\trunner.mu.Lock()\n86|\tdefer runner.mu.Unlock()\n87|\treturn len(runner.calls)\n88|}\n89|\n90|func (runner *fakeRunner) subcommands() []string {\n91|\trunner.mu.Lock()\n92|\tdefer runner.mu.Unlock()\n93|\tvar subcommands []string\n94|\tfor _, call := range runner.calls {\n95|\t\tif len(call) >= 4 {\n96|\t\t\tsubcommands = append(subcommands, call[3])\n97|\t\t}\n98|\t}\n99|\treturn subcommands\n100|}\n101|\n102|// manualClock is a fake Now/Sleep pair: Sleep advances the clock\n103|// instead of waiting, so poll loops run deterministically.\n104|type manualClock struct {\n105|\tmu  sync.Mutex\n106|\tnow time.Time\n107|}\n108|\n109|func newManualClock(now time.Time) *manualClock {\n110|\treturn &manualClock{now: now}\n111|}\n112|\n113|func (clock *manualClock) Now() time.Time {\n114|\tclock.mu.Lock()\n115|\tdefer clock.mu.Unlock()\n116|\treturn clock.now\n117|}\n118|\n119|func (clock *manualClock) Sleep(duration time.Duration) {\n120|\tclock.mu.Lock()\n121|\tdefer clock.mu.Unlock()\n122|\tclock.now = clock.now.Add(duration)\n123|}\n124|\n125|// lxFixture is one lifecycle test setup: runtime root with a verified\n126|// leaf, durable stores, scripted runner, manual clock, and a\n127|// whole Lifecycle. Unix-only: custody passes only where the unix\n128|// commit arms run.\n129|type lxFixture struct {\n130|\troot    string\n131|\truntime string\n132|\tsocket  string\n133|\tdata    string\n134|\trunner  *fakeRunner\n135|\tclock   *manualClock\n136|\tlc      *Lifecycle\n137|}\n138|\n139|// lxShortRoot stages a sun_path-fitting runtime root under /tmp: the\n140|// test-temp-dir socket path exceeds the darwin limit, so lifecycle\n141|// fixtures (which pass the length gate) never use t.TempDir directly.\n142|func lxShortRoot(t *testing.T) string {\n143|\tt.Helper()\n144|\tshort, err := os.MkdirTemp(\"/tmp\", \"axl\")\n145|\tif err != nil {\n146|\t\tt.Fatal(err)\n147|\t}\n148|\tt.Cleanup(func() { os.RemoveAll(short) })\n149|\troot := filepath.Join(short, \"r\")\n150|\tif err := os.Mkdir(root, 0o755); err != nil {\n151|\t\tt.Fatal(err)\n152|\t}\n153|\treturn root\n154|}\n155|\n156|func newLifecycleFixture(t *testing.T, admitted terminalbackend.Admitted) *lxFixture {\n157|\tt.Helper()\n158|\troot := lxShortRoot(t)\n159|\truntime, err := EnsureRuntimeDir(root, RuntimeDirName, scalar.PlatformMacOS, nil)\n160|\tif err != nil {\n161|\t\tt.Fatal(err)\n162|\t}\n163|\tdata := t.TempDir()\n164|\treceipts, err := terminstance.OpenReceiptStore(filepath.Join(data, \"receipts\"))\n165|\tif err != nil {\n166|\t\tt.Fatal(err)\n167|\t}\n168|\tbindings, err := axpane.Open(filepath.Join(data, \"bindings\"))\n169|\tif err != nil {\n170|\t\tt.Fatal(err)\n171|\t}\n172|\tattach, err := termbind.OpenAttachStore(filepath.Join(data, \"attachstore\"))\n173|\tif err != nil {\n174|\t\tt.Fatal(err)\n175|\t}\n176|\tstates, err := OpenInstanceStates(filepath.Join(data, \"states\"))\n177|\tif err != nil {\n178|\t\tt.Fatal(err)\n179|\t}\n180|\trunner := newFakeRunner()\n181|\tclock := newManualClock(lxNow())\n182|\tlc := &Lifecycle{\n183|\t\tRuntimeDir: runtime,\n184|\t\tRoot:       root,\n185|\t\tPlatform:   scalar.PlatformMacOS,\n186|\t\tRunner:     runner,\n187|\t\tReceipts:   receipts,\n188|\t\tBindings:   bindings,\n189|\t\tAttach:     attach,\n190|\t\tStates:     states,\n191|\t\tCurrentLease: func() terminstance.LeaseView {\n192|\t\t\treturn terminstance.LeaseView{LeaseID: lxLease, Epoch: 7}\n193|\t\t},\n194|\t\tCurrentGeneration: func() string { return lxGeneration },\n195|\t\tNow:               clock.Now,\n196|\t\tSleep:             clock.Sleep,\n197|\t\tPollInterval:      time.Millisecond,\n198|\t\tServerAdmission: func() (RealmAdmission, error) {\n199|\t\t\treturn RealmAdmission{Admitted: admitted, RawGeneration: lxGeneration}, nil\n200|\t\t},\n201|\t}\n202|\treturn &lxFixture{root: root, runtime: runtime, socket: SocketPath(runtime), data: data, runner: runner, clock: clock, lc: lc}\n203|}\n204|\n205|// admittedWith returns an Admitted set holding exactly the capabilities.\n206|func admittedWith(capabilities ...string) terminalbackend.Admitted {\n207|\treturn terminalbackend.Admitted{Capabilities: capabilities}\n208|}\n209|\n210|// fullLifecycleAdmitted holds every capability the eight 