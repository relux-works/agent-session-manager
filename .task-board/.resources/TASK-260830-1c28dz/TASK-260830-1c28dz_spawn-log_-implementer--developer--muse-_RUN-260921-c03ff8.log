{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000f129","stream":{"kind":"session","id":"01a0c620-a10f-77d2-842c-eaf24fab8e2e"},"sequence":5871,"recorded_at":1780531400011737,"record_type":"event","durability":"durable","causation_id":"0cdc816d-6145-48a9-a49c-390655512ae9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0cdc816d-6145-48a9-a49c-390655512ae9","run_stream":{"kind":"run","id":"0cdc816d-6145-48a9-a49c-390655512ae9"},"task_stream":{"kind":"task","id":"01a0c666-3e80-72d3-a53f-e7fbec1ba00a"},"task_id":"01a0c666-3e80-72d3-a53f-e7fbec1ba00a","event":{"kind":"output","task_id":"01a0c666-3e80-72d3-a53f-e7fbec1ba00a","chunk":"Read text file `internal/tmuxserver/exec.go`.\n(199 line(s) above)\n200|\tcase DirectiveSendInterrupt:\n201|\t\tinstance, err := commandInstance(args)\n202|\t\tif err != nil {\n203|\t\t\treturn nil, err\n204|\t\t}\n205|\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"send-keys\", \"-t\", instance, \"C-c\"}\n206|\tcase DirectiveHasSession:\n207|\t\tinstance, err := commandInstance(args)\n208|\t\tif err != nil {\n209|\t\t\treturn nil, err\n210|\t\t}\n211|\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"has-session\", \"-t\", instance}\n212|\tcase DirectiveKillSession:\n213|\t\tinstance, err := commandInstance(args)\n214|\t\tif err != nil {\n215|\t\t\treturn nil, err\n216|\t\t}\n217|\t\targv = []string{\"tmux\", \"-S\", args.Socket, \"kill-session\", \"-t\", instance}\n218|\tdefault:\n219|\t\treturn nil, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"command vocabulary\"}\n220|\t}\n221|\tif err := secprim.CheckArgv(argv); err != nil {\n222|\t\treturn nil, &Error{Code: CodeInvalidArguments, Detail: \"command argv\"}\n223|\t}\n224|\treturn argv, nil\n225|}\n226|\n227|// commandInstance validates the tmux target: the terminal instance ID\n228|// as canonical UUIDv7.\n229|func commandInstance(args CommandArgs) (string, error) {\n230|\tinstance, err := scalar.ParseUUIDv7(args.InstanceID)\n231|\tif err != nil {\n232|\t\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"command instance\"}\n233|\t}\n234|\treturn instance.String(), nil\n235|}\n236|\n237|// commandSessionInstance validates the create/restore pair: the logical\n238|// session for the wrapper tail and the instance for the target name.\n239|func commandSessionInstance(args CommandArgs) (string, string, error) {\n240|\tsession, err := scalar.ParseUUIDv7(args.SessionID)\n241|\tif err != nil {\n242|\t\treturn \"\", \"\", &Error{Code: CodeInvalidArguments, Detail: \"command session\"}\n243|\t}\n244|\tinstance, err := commandInstance(args)\n245|\tif err != nil {\n246|\t\treturn \"\", \"\", err\n247|\t}\n248|\treturn session.String(), instance, nil\n249|}\n250|\n251|// commandChannel derives the wait-for channel from the quiescence\n252|// generation: fixed prefix plus canonical UUIDv7, never caller text.\n253|func commandChannel(args CommandArgs) (string, error) {\n254|\tgeneration, err := scalar.ParseUUIDv7(args.QuiescenceGeneration)\n255|\tif err != nil {\n256|\t\treturn \"\", &Error{Code: CodeInvalidArguments, Detail: \"command quiescence\"}\n257|\t}\n258|\treturn BoundaryChannelPrefix + generation.String(), nil\n259|}","final_result":true}}}
