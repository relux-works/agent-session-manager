     expect=\\\"KILLED\\\",\\\\n        note=\\\"Admits exactly TMUX_TMPDIR-carrying entries'),\\n ('Kill path: the ambient socket directory leaks into the child environment.',\\n  'Kill path: the ambient socket directory leaks, at the scrub helper and into the real child environment alike (attribution verified per test from the raw log).'),\\n ('run=\\\"(TestCheckSocketLengthBounds|TestCheckSocketLengthCountsBytes)\\\",',\\n  'run=\\\"(TestCheckSocketLengthBounds|TestCheckSocketLengthCountsBytes|TestExecuteRefusesAtLimitSocket)\\\",'),\\n ('Kill path: the unbindable path proceeds to custody.',\\n  'Kill path: the unbindable path proceeds to custody, at the helper and through all eight dispatch pre-gates alike (attribution verified per test from the raw log).'),\\n ('run=\\\"TestPerformEffectBoundaryTimeout\\\",',\\n  'run=\\\"(TestPerformEffectBoundaryTimeout|TestExecuteBoundaryWaitTimeout)\\\",'),\\n ('Kill path: the expired boundary reports the raw cancellation.',\\n  'Kill path: the expired boundary reports the raw cancellation, at the helper and through the boundary dispatch alike (attribution verified per test from the raw log).'),\\n]\\nfor old, new in fixes:\\n    assert src.count(old) == 1, old[:70]\\n    src = src.replace(old, new)\\n# present-stopped block only\\nstart = src.index('name=\\\"N-status-present-stopped\\\"')\\nend = src.index('Mutant(', start + 10)\\nblock = src[start:end]\\nmask_old = 'run=\\\"(TestClassifyStatusPresentProbe|TestExecuteStatusContradictions)\\\",'\\nassert block.count(mask_old) == 1\\nblock = block.replace(mask_old, 'run=\\\"(TestClassifyStatusPresentProbe|TestExecuteStatusContradictions|TestObserveStatusMemoryReconciles)\\\",')\\nsrc = src[:start] + block + src[end:]\\nopen('mutant_harness.py','w').write(src)\\nprint(\\\"masks extended\\\")\\nEOF\",\n  \"description\": \"Extend masks with block scoping\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"masks extended\\n\",\n  \"original_output_bytes\": 15,\n  \"original_output_tokens\": 4,\n  \"truncated\": false\n}","final_result":true}}}
