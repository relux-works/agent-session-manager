adline.Time()\\n\\tif err != nil {\\n\\t\\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"mutation context deadline\"}\\n\\t}\\n\\tif lc.Now().After(deadline) {\\n',\n+        count=1,\n+        run=\"TestExecuteTerminateRefusesOnDeadline\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the on-deadline instant past the terminate entry deadline; every late instant still refuses, and the restore entry keeps its own row. Kill path: the expired terminate binds a receipt and effects run.\",\n+    ),\n+    Mutant(\n+        name=\"N-lifecycle-entry-deadline-restore\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\\t\\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\\n\\t\\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\\n\\t}\\n\\tdeadline, err := mctx.Deadline.Time()\\n\\tif err != nil {\\n\\t\\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"mutation context deadline\"}\\n\\t}\\n\\tif !lc.Now().Before(deadline) {\\n',\n+        replace='\\t\\tresult := mutationResult(mctx, source, source, nil, nil, terminstance.DispositionFor(backendErrorCode(failure), false))\\n\\t\\treturn OpOutcome{Operation: operation, Mutation: &result}, failure\\n\\t}\\n\\tdeadline, err := mctx.Deadline.Time()\\n\\tif err != nil {\\n\\t\\treturn empty, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"mutation context deadline\"}\\n\\t}\\n\\tif lc.Now().After(deadline) {\\n',\n+        count=1,\n+        run=\"TestExecuteRestoreRefusesOnDeadline\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the on-deadline instant past the restore entry deadline; every late instant still refuses, and the terminate entry keeps its own row. Kill path: the expired restore binds a receipt and effects run.\",\n+    ),\n+    Mutant(\n+        name=\"N-lifecycle-loop-generation\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\\t\\tif lc.CurrentGeneration() != mctx.BackendGeneration {\\n\\t\\t\\treturn fail(terminalbackend.CodeStaleGeneration, \"backend_generation stale\")\\n\\t\\t}\\n',\n+        replace='\\t\\tif lc.CurrentGeneration() != mctx.BackendGeneration && lc.CurrentGeneration() != \"generation-two\" {\\n\\t\\t\\treturn fail(terminalbackend.CodeStaleGeneration, \"backend_generation stale\")\\n\\t\\t}\\n',\n+        count=1,\n+        run=\"TestExecuteRestoreRefusesGenerationDrift\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly generation-two past the per-effect generation recheck; every other stale generation still refuses. Kill path: the drifted restore executes under the stale binding instead of refusing.\",\n+    ),\n+    Mutant(\n+        name=\"N-lifecycle-restore-authkind\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='deadline, terminstance.AuthorizationRestore, reqBackend, func(result terminstance.Result) OpOutcome {',\n+        replace='deadline, terminstance.AuthorizationControl, reqBackend, func(result terminstance.Result) OpOutcome {',\n+        count=1,\n+        run=\"TestExecuteRestore\",\n+        expect=\"KILLED\",\n+        note=\"Rewires exactly the restore effect loop to the control authorization kind; the entry check still demands restore. Kill path: the kind mismatch refuses at the first effect recheck instead of restoring.\",\n+    ),\n+    Mutant(\n+        name=\"N-lifecycle-terminate-authkind\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='deadline, terminstance.AuthorizationForceStale, reqBackend, func(result terminstance.Result) OpOutcome {',\n+        replace='deadline, terminstance.AuthorizationControl, reqBackend, func(result terminstance.Result) OpOutcome {',\n+        count=1,\n+        run=\"TestExecuteTerminate\",\n+        expect=\"KILLED\",\n+        note=\"Rewires exactly the terminate effect loop to the control authorization kind; the entry check still demands force_stale. Kill path: the kind mismatch refuses at the first effect recheck instead of killing.\",\n+    ),\n+    Mutant(\n+        name=\"N-lifecycle-record-success\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\\tlc.recordAfter(mctx.TerminalInstanceID, target)\\n',\n+        replace='\\tlc.recordAfter(mctx.TerminalInstanceID, source)\\n',\n+        count=1,\n+        run=\"(TestExecuteTerminate|TestExecuteRestore)\",\n+        expect=\"KILLED\",\n+        note=\"Records exactly the source state on the success path instead of the target; the failure path keeps its own row. Kill path: the state memory disagrees with the adopted mutation on both receipt operations.\",\n+    ),\n+    Mutant(\n+        name=\"N-lifecycle-record-failure\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\\t\\tlc.recordAfter(mctx.TerminalInstanceID, after)\\n',\n+        replace='\\t\\tlc.recordAfter(mctx.TerminalInstanceID, target)\\n',\n+        count=1,\n+        run=\"TestRunLifecycleEffectsRefusesForgedEvidence\",\n+        expect=\"KILLED\",\n+        note=\"Records exactly the target state on the failure path instead of the adopted after-state; the success path keeps its own row. Kill path: the refused run poisons the memory with an unreached state.\",\n+    ),\n+    Mutant(\n+        name=\"N-lifecycle-agreement-session\",\n+        path=f\"{PACKAGE}/lifecycle.go\",\n+        find='\\tif body.Binding.SessionID != body.Context.SessionID ||\\n\\t\\tbody.Binding.TerminalInstanceID != body.Context.TerminalInstanceID ||\\n',\n+        replace='\\tif body.Binding.TerminalInstanceID != body.Context.TerminalInstanceID ||\\n',\n+        count=1,\n+        run=\"TestExecuteCreateBindingAgreement/session\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly session-disagreeing bindings past the create agreement; every other disagreement still refuses. Kill path: the foreign creation reaches the engine instead of refusing.\",\n+    ),\n+    Mutant(\n+        name=\"N-lifecycle-agreement-instance\",\n+        path=f\"{PACKAGE}/lifecycle.go\",\n+        find='\\t\\tbody.Binding.TerminalInstanceID != body.Context.TerminalInstanceID ||\\n',\n+        replace='',\n+        count=1,\n+        run=\"TestExecuteCreateBindingAgreement/instance\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly instance-disagreeing bindings past the create agreement; every other disagreement still refuses. Kill path: the foreign creation reaches the engine instead of refusing.\",\n+    ),\n+    Mutant(\n+        name=\"N-lifecycle-agreement-backend\",\n+        path=f\"{PACKAGE}/lifecycle.go\",\n+        find='\\t\\tbody.Binding.TerminalBackendID != body.Context.TerminalBackendID ||\\n',\n+        replace='',\n+        count=1,\n+        run=\"TestExecuteCreateBindingAgreement/backend\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly backend-disagreeing bindings past the create agreement; every other disagreement still refuses. Kill path: the foreign creation reaches the engine instead of refusing.\",\n+    ),\n+    Mutant(\n+        name=\"N-lifecycle-agreement-generation\",\n+        path=f\"{PACKAGE}/lifecycle.go\",\n+        find='\\t\\tbody.Binding.TerminalBackendID != body.Context.TerminalBackendID ||\\n\\t\\tbody.Binding.BackendGeneration != body.Context.BackendGeneration {\\n',\n+        replace='\\t\\tbody.Binding.TerminalBackendID != body.Context.TerminalBackendID {\\n',\n+        count=1,\n+        run=\"TestExecuteCreateBindingAgreement/generation\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly generation-disagreeing bindings past the create agreement; every other disagreement still refuses. Kill path: the foreign creation reaches the engine instead of refusing.\",\n+    ),\n+    Mutant(\n+        name=\"N-lifecycle-backend-identity\",\n+        path=f\"{PACKAGE}/lifecycle.go\",\n+        find='\\tif backendID != terminalbackend.BuiltinTmux {\\n',\n+        replace='\\tif backendID != terminalbackend.BuiltinTmux && backendID != \"ax.conpty\" {\\n',\n+        count=1,\n+        run=\"TestExecuteRefusesForeignBackend\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the conpty backend past the lifecycle backend gate; every other foreign backend still refuses. Kill path: all eight operations proceed past the gate and fail with their downstream verdicts.\",\n+    ),\n+    Mutant(\n+        name=\"N-lifecycle-restore-mismatch\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\\tif !found || recorded.BindingDigest != body.PriorBindingID {\\n',\n+        replace='\\tif !found || recorded.BindingDigest != body.PriorBindingID && body.PriorBindingID != \"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\" {\\n',\n+        count=1,\n+        run=\"TestExecuteRestoreMismatch/wrong-digest\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the digest-B prior past the restore mismatch rule; every other substituted binding still refuses. Kill path: the substituted restore reaches the persist conflict instead of refusing the mismatch.\",\n+    ),\n+    Mutant(\n+        name=\"N-lifecycle-fencing-force\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\\tif errors.Is(err, fencing.ErrInvalidArguments) {\\n\\t\\treturn &Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminate fencing material\"}\\n\\t}\\n\\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate fencing authorization\"}\\n',\n+        replace='\\tif errors.Is(err, fencing.ErrInvalidArguments) {\\n\\t\\treturn &Error{Code: terminalbackend.CodeProtocolError, Detail: \"terminate fencing material\"}\\n\\t}\\n\\tif err.Error() == \"local_precondition_failed: terminate-stale requires explicit force recovery\" {\\n\\t\\treturn nil\\n\\t}\\n\\treturn &Error{Code: terminalbackend.CodePreconditionFailed, Detail: \"terminate fencing authorization\"}\\n',\n+        count=1,\n+        run=\"TestExecuteTerminateRefusals/no-force\",\n+        expect=\"KILLED\",\n+        n