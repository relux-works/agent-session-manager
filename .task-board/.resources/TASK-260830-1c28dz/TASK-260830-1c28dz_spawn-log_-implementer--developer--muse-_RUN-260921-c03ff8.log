{"schema_version":1,"id":"018f0000-0000-7000-8000-000000010319","stream":{"kind":"session","id":"01a0c620-a10f-77d2-842c-eaf24fab8e2e"},"sequence":8167,"recorded_at":1780531400016329,"record_type":"event","durability":"durable","causation_id":"0cdc816d-6145-48a9-a49c-390655512ae9","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"0cdc816d-6145-48a9-a49c-390655512ae9","run_stream":{"kind":"run","id":"0cdc816d-6145-48a9-a49c-390655512ae9"},"task_stream":{"kind":"task","id":"01a0c686-13cc-7883-9936-ce227cc0e124"},"task_id":"01a0c686-13cc-7883-9936-ce227cc0e124","event":{"kind":"output","task_id":"01a0c686-13cc-7883-9936-ce227cc0e124","chunk":"edited\nchanged lines: lines 1503-1504\n--- original\n+++ updated\n@@\n-    Mutant(\n-        name=\"C-control\",\n+    Mutant(\n+        name=\"N-attach-capability-local\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\\tcase string(terminalbackend.TransportLocalOnly):\\n\\t\\tif !admitted.Has(\"local_attach\") {\\n\\t\\t\\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\\n\\t\\t}\\n',\n+        replace='\\tcase string(terminalbackend.TransportLocalOnly):\\n',\n+        count=1,\n+        run=\"TestExecuteAttachRefusals/wrong-transport-capability\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly capability-less local presentation past the matching-transport gate (the mesh arm stays); mesh without remote_attach still refuses. Kill path: the unevidenced attach succeeds instead of refusing.\",\n+    ),\n+    Mutant(\n+        name=\"N-attach-capability-mesh\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\\tcase string(terminalbackend.TransportTrustedPrivateMesh):\\n\\t\\tif !admitted.Has(\"remote_attach\") {\\n\\t\\t\\treturn &Error{Code: terminalbackend.CodeCapabilityUnproven, Detail: \"operation capability conditional\"}\\n\\t\\t}\\n',\n+        replace='\\tcase string(terminalbackend.TransportTrustedPrivateMesh):\\n',\n+        count=1,\n+        run=\"TestExecuteAttachRefusesMeshWithoutCapability\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly capability-less mesh presentation past the matching-transport gate (the local arm stays); local without local_attach still refuses. Kill path: the unevidenced attach succeeds instead of refusing.\",\n+    ),\n+    Mutant(\n+        name=\"N-attach-deadline-boundary\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\\tif !lc.Now().Before(deadline) {\\n\\t\\treturn empty, &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\\n\\t}\\n',\n+        replace='\\tif lc.Now().After(deadline) {\\n\\t\\treturn empty, &Error{Code: terminstance.CodeTimeout, Detail: \"operation deadline\"}\\n\\t}\\n',\n+        count=1,\n+        run=\"TestExecuteAttachRefusesDeadline/boundary\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the on-deadline instant past the attach entry deadline; every late instant still refuses. Kill path: the expired attach succeeds instead of refusing.\",\n+    ),\n+    Mutant(\n+        name=\"N-attach-attestation-decoy\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\\tif err := CheckServerAttested(admission, body.BackendGeneration); err != nil {\\n',\n+        replace='\\tif err := CheckServerAttested(admission, body.BackendGeneration); err != nil && err.Error() != \"tmux server refused: tmux_readiness_not_authorizing at server attestation\" {\\n',\n+        count=1,\n+        run=\"TestExecuteAttachRefusals/fresh-decoy\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the decoy-membered admission past the attach attestation wiring; the stale-generation member still refuses. Kill path: the unattested server presents instead of refusing.\",\n+    ),\n+    Mutant(\n+        name=\"N-attach-record\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\\tlc.recordAfter(body.TerminalInstanceID, terminalbackend.StateActive)\\n',\n+        replace='\\tlc.recordAfter(body.TerminalInstanceID, terminalbackend.StateParked)\\n',\n+        count=1,\n+        run=\"TestExecuteAttach\",\n+        expect=\"KILLED\",\n+        note=\"Records exactly the parked state on the attach success path instead of the adopted active; the receipt paths keep their own rows. Kill path: the state memory disagrees with the presented attach.\",\n+    ),\n+    Mutant(\n+        name=\"N-attach-descriptor-order\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\\treturn socket + \"\\\\n\" + instance + \"\\\\n\" + client\\n',\n+        replace='\\treturn instance + \"\\\\n\" + socket + \"\\\\n\" + client\\n',\n+        count=1,\n+        run=\"TestExecuteAttach\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the instance-first descriptor past the fixed attach shape; the field set stays exact. Kill path: the exact-descriptor assertion fails.\",\n+    ),\n+    Mutant(\n+        name=\"N-create-descriptor-order\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\\treturn socket + \"\\\\n\" + instance\\n',\n+        replace='\\treturn instance + \"\\\\n\" + socket\\n',\n+        count=1,\n+        run=\"TestExecuteCreateInteractive\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the instance-first descriptor past the fixed create shape; the field set stays exact. Kill path: the exact-descriptor assertion fails.\",\n+    ),\n+    Mutant(\n+        name=\"N-cmdvector-attach\",\n+        path=f\"{PACKAGE}/exec.go\",\n+        find='\\t\\targv = []string{\"tmux\", \"-S\", args.Socket, \"attach-session\", \"-t\", instance}\\n',\n+        replace='\\t\\targv = []string{\"tmux\", \"-S\", args.Socket, \"attach-session\", instance}\\n',\n+        count=1,\n+        run=\"(TestBuildCommandVectors/attach|TestExecuteAttach)\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the flag-less attach vector past the fixed-shape builder; every other vector element stays exact. One site, both entries: the exact-vector assertions fail at the helper and through the attach dispatch alike.\",\n+    ),\n+    Mutant(\n+        name=\"N-engineop-quiesce-generation\",\n+        path=f\"{PACKAGE}/lifecycle.go\",\n+        find='\\t\\toutcome.QuiescenceGeneration = params.QuiescenceGeneration\\n',\n+        replace='\\t\\toutcome.QuiescenceGeneration = \"\"\\n',\n+        count=1,\n+        run=\"TestExecuteQuiesce\",\n+        expect=\"KILLED\",\n+        note=\"Reports exactly the empty quiescence generation on the quiesce success path instead of the admitted one; the boundary and stop members keep their own rows. Kill path: the outcome generation assertion fails.\",\n+    ),\n+    Mutant(\n+        name=\"N-engineop-boundary-evidence\",\n+        path=f\"{PACKAGE}/lifecycle.go\",\n+        find='\\t\\toutcome.SafeBoundaryEvidenceID = result.EvidenceIDs[0]\\n',\n+        replace='\\t\\toutcome.SafeBoundaryEvidenceID = \"\"\\n',\n+        count=1,\n+        run=\"TestExecuteBoundary\",\n+        expect=\"KILLED\",\n+        note=\"Reports exactly the empty boundary evidence on the boundary success path instead of the committed one; the quiesce and stop members keep their own rows. Kill path: the outcome evidence assertion fails.\",\n+    ),\n+    Mutant(\n+        name=\"N-engineop-stop-process\",\n+        path=f\"{PACKAGE}/lifecycle.go\",\n+        find='\\t\\toutcome.ProcessClosed = true\\n',\n+        replace='\\t\\toutcome.ProcessClosed = false\\n',\n+        count=1,\n+        run=\"TestExecuteStop\",\n+        expect=\"KILLED\",\n+        note=\"Reports exactly the open process marker on the stop success path instead of the closed one; the store marker keeps its own row. Kill path: the outcome marker assertion fails.\",\n+    ),\n+    Mutant(\n+        name=\"N-engineop-stop-store\",\n+        path=f\"{PACKAGE}/lifecycle.go\",\n+        find='\\t\\toutcome.StoreClosed = true\\n',\n+        replace='\\t\\toutcome.StoreClosed = false\\n',\n+        count=1,\n+        run=\"TestExecuteStop\",\n+        expect=\"KILLED\",\n+        note=\"Reports exactly the open store marker on the stop success path instead of the closed one; the process marker keeps its own row. Kill path: the outcome marker assertion fails.\",\n+    ),\n+    Mutant(\n+        name=\"N-entry-authkind-terminate\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='terminstance.CheckAuthorization(mctx.Authorization, terminstance.AuthorizationForceStale, lc.CurrentLease(), lc.Now())',\n+        replace='terminstance.CheckAuthorization(mctx.Authorization, terminstance.AuthorizationControl, lc.CurrentLease(), lc.Now())',\n+        count=1,\n+        run=\"TestExecuteTerminate\",\n+        expect=\"KILLED\",\n+        note=\"Rewires exactly the terminate entry check to the control authorization kind; the effect-loop kind keeps its own row. Kill path: the kind mismatch refuses at entry instead of killing.\",\n+    ),\n+    Mutant(\n+        name=\"N-entry-authkind-restore\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='terminstance.CheckAuthorization(mctx.Authorization, terminstance.AuthorizationRestore, lc.CurrentLease(), lc.Now())',\n+        replace='terminstance.CheckAuthorization(mctx.Authorization, terminstance.AuthorizationControl, lc.CurrentLease(), lc.Now())',\n+        count=1,\n+        run=\"TestExecuteRestore\",\n+        expect=\"KILLED\",\n+        note=\"Rewires exactly the restore entry check to the control authorization kind; the effect-loop kind keeps its own row. Kill path: the kind mismatch refuses at entry instead of restoring.\",\n+    ),\n+    Mutant(\n+        name=\"N-entry-generation\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\\n\\tif lc.CurrentGeneration() != mctx.BackendGeneration {\\n',\n+        replace='\\n\\tif lc.CurrentGeneration() != mctx.BackendGeneration && mctx.BackendGeneration != \"generation-two\" {\\n',\n+        count=2,\n+        run=\"(TestExecuteEntryRefusesStaleGeneration/terminate|TestExecuteEntryRefusesStaleGeneration/restore)\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly generation-two past both entry generation gates; every other stale generation still refuses, and the loop recheck keeps its own row. Two sites, two kills: each admitted entry binds a receipt the loop then refuses, so both no-bind assertions redden (attribution verified per subtest from the raw log).\",\n+    ),\n+    Mutant(\n+        name=\"N-key-material-terminate\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\"terminate\", body.StaleLeaseID, strconv.FormatUint(body.StaleEpoch, 10))\\n\\tif err != nil {\\n\\t\\treturn empty, err\\n\\t}\\n\\tif mctx.IdempotencyKey != derived {\\n',\n+        replace='\"terminate\", body.StaleLeaseID, strconv.FormatUint(body.StaleEpoch, 10))\\n\\tif err != nil {\\n\\t\\treturn empty, err\\n\\t}\\n\\tif mctx.IdempotencyKey != derived && mctx.IdempotencyKey != \"wrong/key\" {\\n',\n+        count=1,\n+        run=\"TestExecuteRefusesWrongIdempotencyKey/terminate\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the wrong/key presented key past the terminate key-material gate; every other underived key still refuses, and the restore gate keeps its own row. Kill path: the miskeyed terminate reaches the kill effect.\",\n+    ),\n+    Mutant(\n+        name=\"N-key-material-restore\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='mctx.SessionID, body.BootstrapOperationID)\\n\\tif err != nil {\\n\\t\\treturn empty, err\\n\\t}\\n\\tif mctx.IdempotencyKey != derived {\\n',\n+        replace='mctx.SessionID, body.BootstrapOperationID)\\n\\tif err != nil {\\n\\t\\treturn empty, err\\n\\t}\\n\\tif mctx.IdempotencyKey != derived && mctx.IdempotencyKey != \"wrong/key\" {\\n',\n+        count=1,\n+        run=\"TestExecuteRefusesWrongIdempotencyKey/restore\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the wrong/key presented key past the restore key-material gate; every other underived key still refuses, and the terminate gate keeps its own row. Kill path: the miskeyed restore reaches the wrapper start.\",\n+    ),\n+    Mutant(\n+        name=\"N-fencing-invalid-reroute\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\\tif errors.Is(err, fencing.ErrInvalidArguments) {\\n',\n+        replace='\\tif errors.Is(err, fencing.ErrLeaseConflict) {\\n',\n+        count=1,\n+        run=\"TestExecuteTerminateRefusals/malformed-presented\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly malformed fencing material past the protocol mapping (it reroutes to the precondition like every other fencing refusal); the force member keeps its own row. Kill path: the malformed target refuses with the wrong verdict.\",\n+    ),\n+    Mutant(\n+        name=\"N-bind-mismatch-map\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\\t_, replayed, err := lc.Receipts.Bind(key, operation, mctx.OperationID)\\n\\tif err != nil {\\n\\t\\tif backendErrorCode(err) != \"\" {\\n',\n+        replace='\\t_, replayed, err := lc.Receipts.Bind(key, operation, mctx.OperationID)\\n\\tif err != nil {\\n\\t\\tif backendErrorCode(err) != \"\" && backendErrorCode(err) != \"idempotency_mismatch\" {\\n',\n+        count=1,\n+        run=\"TestExecuteTerminateRedriveMismatch\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the idempotency mismatch past the Bind coded-error mapping (it reroutes to the store-failure arm); every other coded Bind error still maps. Kill path: the redrive reports a store failure instead of the mismatch.\",\n+    ),\n+    Mutant(\n+        name=\"N-replay-corrupt-image\",\n+        path=f\"{PACKAGE}/ops.go\",\n+        find='\\t\\tif err := json.Unmarshal(stored, &result); err != nil {\\n',\n+        replace='\\t\\tif err := json.Unmarshal(stored, &result); err != nil && string(stored) != \"not-json{{\" {\\n',\n+        count=1,\n+        run=\"TestExecuteTerminateReplayRefusesCorruptImage\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the corrupt completion past the image-integrity arm; the zero result then fails the operation binding instead. Kill path: the corrupt replay refuses with the wrong verdict.\",\n+    ),\n+    Mutant(\n+        name=\"N-stop-escalation-kill\",\n+        path=f\"{PACKAGE}/backend.go\",\n+        find='\\t\\t} else if result.ExitCode != 0 {\\n\\t\\t\\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\\n\\t\\t}\\n',\n+        replace='\\t\\t} else if result.ExitCode != 0 && result.ExitCode != 1 {\\n\\t\\t\\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\\n\\t\\t}\\n',\n+        count=1,\n+        run=\"TestPerformEffectStopEscalationKillFailure\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the exit-1 escalation kill past the escalation-failure arm (the re-confirm then proves absence and the close commits); every other failed escalation still refuses. Kill path: the unproven close reports escalated.\",\n+    ),\n+    Mutant(\n+        name=\"N-persist-conflict-map\",\n+        path=f\"{PACKAGE}/backend.go\",\n+        find='\\t\\tif code := backendErrorCode(err); code != \"\" {\\n\\t\\t\\treturn \"\", &terminstance.Error{Code: code, Detail: \"backend binding conflict\"}\\n\\t\\t}\\n',\n+        replace='\\t\\tif code := backendErrorCode(err); code != \"\" && code != \"idempotency_mismatch\" {\\n\\t\\t\\treturn \"\", &terminstance.Error{Code: code, Detail: \"backend binding conflict\"}\\n\\t\\t}\\n',\n+        count=1,\n+        run=\"TestPerformEffectBindingConflict\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the binding mismatch past the persist conflict mapping (the raw store error returns unwrapped); every other coded store error still maps. Kill path: the conflict reports the raw store verdict.\",\n+    ),\n+    Mutant(\n+        name=\"N-attach-conflict-map\",\n+        p