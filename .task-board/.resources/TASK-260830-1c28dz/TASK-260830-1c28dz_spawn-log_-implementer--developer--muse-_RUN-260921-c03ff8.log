eign binary spawns instead of refusing.\",\n+    ),\n+    Mutant(\n+        name=\"N-spawn-exit\",\n+        path=f\"{PACKAGE}/probe.go\",\n+        find='\\tif result.ExitCode != 0 {\\n\\t\\treturn &Error{Code: CodeSpawnFailed, Detail: \"server spawn\"}\\n',\n+        replace='\\tif result.ExitCode != 0 && result.ExitCode != 1 {\\n\\t\\treturn &Error{Code: CodeSpawnFailed, Detail: \"server spawn\"}\\n',\n+        count=1,\n+        run=\"TestServerSpawnerMapsRunnerOutcome\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly exit-1 spawns past the spawn-failure mapping; every other nonzero exit still maps. Kill path: the failed spawn reports success.\",\n+    ),\n+    Mutant(\n+        name=\"N-bind-length-boundary\",\n+        path=f\"{PACKAGE}/bind.go\",\n+        find='\\tif len(socket) >= limit {\\n',\n+        replace='\\tif len(socket) > limit {\\n',\n+        count=1,\n+        run=\"(TestCheckSocketLengthBounds|TestCheckSocketLengthCountsBytes)\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly at-limit sockets past the sun_path refusal (strict below becomes at-or-below); every overlong socket still refuses. Kill path: the unbindable path proceeds to custody.\",\n+    ),\n+    Mutant(\n+        name=\"N-bind-placement\",\n+        path=f\"{PACKAGE}/bind.go\",\n+        find='\\tif socket != filepath.Join(root, RuntimeDirName, SocketName) {\\n',\n+        replace='\\tif socket != filepath.Join(root, RuntimeDirName, SocketName) && socket != \"/tmp/ax-ambient.sock\" {\\n',\n+        count=1,\n+        run=\"TestCheckSocketCustodyRefusesMisplacedSocket\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the ambient socket past the placement arm; every other misplaced socket still refuses. Kill path: the substituted path reaches leaf custody and refuses there instead.\",\n+    ),\n+    Mutant(\n+        name=\"N-bind-root-writable\",\n+        path=f\"{PACKAGE}/bind.go\",\n+        find='\\tif writableByOthers(info) {\\n\\t\\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket root\"}\\n',\n+        replace='\\tif writableByOthers(info) && info.Mode().Perm() != 0o777 {\\n\\t\\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket root\"}\\n',\n+        count=1,\n+        run=\"TestCheckSocketCustodyRefusesUnsafeRoot\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly 0777 roots past the root writability arm; every other writable root still refuses, and the ancestor arm keeps its own row. Kill path: the world-writable root verifies clean.\",\n+    ),\n+    Mutant(\n+        name=\"N-bind-ancestor-writable\",\n+        path=f\"{PACKAGE}/bind.go\",\n+        find='\\t\\tif writableByOthers(info) {\\n\\t\\t\\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket ancestor\"}\\n',\n+        replace='\\t\\tif writableByOthers(info) && info.Mode().Perm() != 0o777 {\\n\\t\\t\\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket ancestor\"}\\n',\n+        count=1,\n+        run=\"TestCheckSocketCustodyRefusesWritableAncestor\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly 0777 ancestors past the ancestor writability arm; every other writable ancestor still refuses, and the root arm keeps its own row. Kill path: the world-writable ancestor verifies clean.\",\n+    ),\n+    Mutant(\n+        name=\"N-bind-socket-kind\",\n+        path=f\"{PACKAGE}/bind.go\",\n+        find='\\tif info.Mode().Type() != os.ModeSocket {\\n\\t\\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket kind\"}\\n\\t}\\n',\n+        replace='\\tif info.Mode().Type() != os.ModeSocket && !info.Mode().IsRegular() {\\n\\t\\treturn &Error{Code: CodeUnsafeSocketPath, Detail: \"socket kind\"}\\n\\t}\\n',\n+        count=1,\n+        run=\"TestCheckSocketCustodyRefusesNonSocketFile\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly regular files past the socket kind arm (the unlink step would remove one); every other non-socket kind still refuses. Kill path: the regular file at the socket path verifies clean.\",\n+    ),\n+    Mutant(\n+        name=\"C-control\",\n","edit_facts":{"tool_name":"edit_file","path":"internal/tmuxserver/mutant_harness.py","added":232,"removed":2},"correlation_facts":{"tool_name":"edit_file","outcome":"success"}}}
