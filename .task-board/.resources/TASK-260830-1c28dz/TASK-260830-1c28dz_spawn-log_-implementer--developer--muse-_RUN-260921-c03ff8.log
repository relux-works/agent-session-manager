{\n+\tbound := lc.Now().Add(time.Duration(timeoutMs) * time.Millisecond)\n+\tif deadline, err := mctx.Deadline.Time(); err == nil && deadline.Before(bound) {\n+\t\tbound = deadline\n+\t}\n+\treturn context.WithDeadline(ctx, bound)\n+}\n","final_result":true}}}
