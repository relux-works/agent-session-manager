nalbackend.EffectStaleIncarnationTerminated, runner.operation, runner.instanceID, \"killed\"), nil\n528|\t}\n529|\tconfirm, err := runner.command(DirectiveHasSession)\n530|\tif err != nil {\n531|\t\treturn \"\", err\n532|\t}\n533|\tconfirmCtx, cancel := probeContext(ctx, runner.now, runner.deadline)\n534|\tdefer cancel()\n535|\tobserved, err := runner.runner.Run(confirmCtx, confirm)\n536|\tif err != nil {\n537|\t\treturn \"\", errProbeUnknown\n538|\t}\n539|\tpresent, absent := classifyAbsence(observed, absentMarkerNoSession, absentMarkerNoSocket)\n540|\tif absent {\n541|\t\treturn effectEvidence(terminalbackend.EffectStaleIncarnationTerminated, runner.operation, runner.instanceID, \"confirmed-absent\"), nil\n542|\t}\n543|\tif !present {\n544|\t\treturn \"\", errProbeUnknown\n545|\t}\n546|\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n547|}\n548|\n549|// command builds the argv for one directive over the request identity.\n550|func (runner *backend) command(directive Directive) ([]string, error) {\n551|\tbuilt, err := BuildCommand(directive, CommandArgs{\n552|\t\tRuntimeDir:           runner.runtimeDir,\n553|\t\tSocket:               runner.socket,\n554|\t\tSessionID:            runner.sessionID,\n555|\t\tInstanceID:           runner.instanceID,\n556|\t\tQuiescenceGeneration: runner.quiescence,\n557|\t})\n558|\tif err != nil {\n559|\t\tif code := backendErrorCode(err); code != \"\" {\n560|\t\t\treturn nil, &terminstance.Error{Code: code, Detail: \"backend command refused\"}\n561|\t\t}\n562|\t\treturn nil, err\n563|\t}\n564|\treturn built, nil\n565|}\n566|\n567|// backendErrorCode reads the wire code off a backend-construction or\n568|// store error: landed terminalbackend and terminstance refusals plus\n569|// local tmuxserver refusals all carry one. Anything else is uncoded.\n570|func backendErrorCode(err error) string {\n571|\tif code := terminstance.ErrorCode(err); code != \"\" {\n572|\t\treturn code\n573|\t}\n574|\tvar local *Error\n575|\tif errors.As(err, &local) {\n576|\t\treturn local.Code\n577|\t}\n578|\treturn \"\"\n579|}","final_result":true}}}
