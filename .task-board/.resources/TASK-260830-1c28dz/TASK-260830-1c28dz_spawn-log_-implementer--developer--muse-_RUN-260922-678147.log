tach succeeds past the directory, so the receipt-dir subtest reddens while the still-skipped leg stays green.\",\n3001|    ),\n3002|    Mutant(\n3003|        name=\"N-attach-overlap-replay-unproven\",\n3004|        path=f\"{PACKAGE}/ops.go\",\n3005|        find='\\t_, found, err := lc.Attach.Lookup(body.SessionID, body.TerminalInstanceID, body.ClientID)\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif found {\\n\\t\\treturn nil\\n\\t}\\n',\n3006|        replace='\\t_, found, err := lc.Attach.Lookup(body.SessionID, body.TerminalInstanceID, body.ClientID)\\n\\tif err != nil {\\n\\t\\treturn err\\n\\t}\\n\\tif found || body.ClientID == \"0198f4c8-8e50-7f66-8f70-555555555552\" {\\n\\t\\treturn nil\\n\\t}\\n',\n3007|        count=1,\n3008|        run=\"TestAttachOverlapRequiresMultiAttach\",\n3009|        expect=\"KILLED\",\n3010|        note=\"Admits exactly the receiptless fixture client B past the replay exemption without a recorded receipt (the exemption keys on the bare client ID for one literal member); every other receiptless client still reaches the capability arms, and census failures still error. Kill path: the second attach succeeds without multi_attach, so the test fails at the second refusal assertion.\",\n3011|    ),\n3012|    Mutant(\n3013|        name=\"N-probe-deadline\",\n3014|        path=f\"{PACKAGE}/backend.go\",\n3015|        find='\\treturn context.WithTimeout(ctx, deadline.Sub(now()))\\n',\n3016|        replace='\\treturn context.WithTimeout(ctx, deadline.Sub(now())+time.Hour)\\n',\n3017|        count=1,\n3018|        run=\"(TestExecuteStopPollHonorsOperationDeadline|TestExecuteTerminateConfirmHonorsOperationDeadline|TestExecuteStatusProbeHonorsOperationDeadline)\",\n3019|        expect=\"KILLED\",\n(more lines below)","final_result":true}}}
