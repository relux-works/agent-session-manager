]\\nprint(f'suite: shared={len(shared)} moved={len(mv)} base-only={len([k for k in b if k not in c])} cand-only={len(conly)}')\\nprint('cand-only by package:', Counter(k[0].split('/internal/')[-1] for k in conly))\\nprint('cand fails:', sum(1 for k in c if c[k]=='fail'), 'base fails:', sum(1 for k in b if b[k]=='fail'))\\nEOF\\nrm -f ev10-staging-tmp.jsonl; python3 /tmp/p2b/ev10/suite_grid.py > /tmp/p2b/ev10/suite-grid.txt 2>&1; cat /tmp/p2b/ev10/suite-grid.txt\",\n  \"description\": \"Recompute composition diffs on final tree\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"corpus: base=193 cand=215 moved=0 base-only=0 cand-only=22\\nsuite: shared=2894 moved=0 base-only=0 cand-only=319\\ncand-only by package: Counter({'tmuxserver': 308, 'termbind': 11})\\ncand fails: 0 base fails: 0\\nshared keys: 2894; retained: 2894; moved: 0\\nbase-only: 0; candidate-only: 319\\nbase fails: 0; candidate fails: 0\\ncandidate-only additions: 319\\n\",\n  \"original_output_bytes\": 349,\n  \"original_output_tokens\": 88,\n  \"truncated\": false\n}","final_result":true}}}
