nil {\n434|\t\temitErr(\"meshneg\", \"PeerOffer\", \"zero\", err)\n435|\t} else {\n436|\t\temit(\"meshneg\", \"PeerOffer\", \"zero\", \"ok\", \"\", fmt.Sprintf(\"%d\", offer))\n437|\t}\n438|}\n439|\n440|// --- peeridentity (zero Target: degenerate but deterministic) ---\n441|\n442|func gridPeeridentity() {\n443|\tvar target peeridentity.Target\n444|\temit(\"peeridentity\", \"String\", \"zero\", \"ok\", \"\", target.String())\n445|\temit(\"peeridentity\", \"GoString\", \"zero\", \"ok\", \"\", target.GoString())\n446|\temit(\"peeridentity\", \"KeyProvenance\", \"zero\", \"ok\", \"\", target.KeyProvenance())\n447|\temitErr(\"peeridentity\", \"CheckProtocolHost\", \"zero\", target.CheckProtocolHost(\"host-1\"))\n448|\targv, err := target.RPCArgv()\n449|\tif err != nil {\n450|\t\temitErr(\"peeridentity\", \"RPCArgv\", \"zero\", err)\n451|\t} else {\n452|\t\temit(\"peeridentity\", \"RPCArgv\", \"zero\", \"ok\", \"\", strings.Join(argv, \" \"))\n453|\t}\n454|}\n455|\n456|// --- provhost ---\n457|\n458|func gridProvhost() {\n459|\temit(\"provhost\", \"Capabilities\", \"none\", \"ok\", \"\", joinSorted(provhost.Capabilities()))\n460|\temit(\"provhost\", \"CapabilityUsable\", \"ready-true\", \"ok\", \"\", fmt.Sprintf(\"%v\", provhost.CapabilityUsable(\"ready\", true)))\n461|\temit(\"provhost\", \"CapabilityUsable\", \"ready-false\", \"ok\", \"\", fmt.Sprintf(\"%v\", provhost.CapabilityUsable(\"ready\", false)))\n462|\temit(\"provhost\", \"CapabilityUsable\", \"bogus-true\", \"ok\", \"\", fmt.Sprintf(\"%v\", provhost.CapabilityUsable(\"bogus\", true)))\n463|\temitErr(\"provhost\", \"CheckResumeTuple\", \"zero\", provhost.CheckResumeTuple(provhost.BuildTuple{}))\n464|\temitErr(\"provhost\", \"DecodeProbe\", \"empty-object\", provhost.DecodeProbe([]byte(`{}`)))\n465|\temitErr(\"provhost\", \"DecodeProbe\", \"truncated\", provhost.DecodeProbe([]byte(`[`)))\n466|\temitErr(\"provhost\", \"DecodeManifest\", \"empty-object\", provhost.DecodeManifest([]byte(`{}`)))\n467|}\n468|\n469|// --- provider ---\n470|\n471|type gridSystem struct{ err error }\n472|\n473|func (s gridSystem) ReadDir(string) ([]string, error) { return nil, s.err }\n474|func (s gridSystem) Canonicalize(string) (string, error) {\n475|\treturn \"\", s.err\n476|}\n477|func (s gridSystem) Inspect(string) (provider.FileInfo, error) {\n478|\treturn provider.FileInfo{}, s.err\n479|}\n480|func (s gridSystem) ReadFile(string) ([]byte, error) { return nil, s.err }\n481|func (s gridSystem) PathDirs() []string              { return []string{\"/fixed/bin\"} }\n482|\n483|func gridProvider() {\n484|\temit(\"provider\", \"Builtins\", \"none\", \"ok\", \"\", joinSorted(provider.Builtins()))\n485|\tlifted, err := provider.Lift(provider.Error{})\n486|\tif err != nil {\n487|\t\temitErr(\"provider\", \"Lift\", \"zero\", err)\n488|\t} else if lifted == nil {\n489|\t\temit(\"provider\", \"Lift\", \"zero\", \"ok\", \"\", \"nil\")\n490|\t} else {\n491|\t\temit(\"provider\", \"Lift\", \"zero\", \"ok\", \"\", normalize(lifted.Error()))\n492|\t}\n493|\tstub := gridSystem{err: errors.New(\"grid: no filesystem\")}\n494|\temitErr(\"provider\", \"Verify\", \"zero\", provider.Verify(provider.TrustRecord{}, provider.OwnerPolicy{}, stub))\n495|}\n496|\n497|// --- resumesmoke ---\n498|\n499|func gridResumesmoke() {\n500|\t// Refusal arms only: a valid record needs the sealed digest\n(more lines below)","final_result":true}}}
