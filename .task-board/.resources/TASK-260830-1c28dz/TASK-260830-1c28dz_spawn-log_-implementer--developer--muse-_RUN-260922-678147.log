{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000dde7","stream":{"kind":"session","id":"01a0ca08-6c63-7352-b762-5bc242c771c8"},"sequence":3406,"recorded_at":1780531400006807,"record_type":"event","durability":"durable","causation_id":"cd8feb9b-6d69-49ce-a85c-818ca818e251","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cd8feb9b-6d69-49ce-a85c-818ca818e251","run_stream":{"kind":"run","id":"cd8feb9b-6d69-49ce-a85c-818ca818e251"},"task_stream":{"kind":"task","id":"01a0ca22-8085-7a91-b52d-6916e1411782"},"task_id":"01a0ca22-8085-7a91-b52d-6916e1411782","event":{"kind":"output","task_id":"01a0ca22-8085-7a91-b52d-6916e1411782","chunk":"edited\nchanged lines: lines 80-92\n--- original\n+++ updated\n@@\n-def ac_row(lines, num):\n-    prefix = f\"| {num} |\"\n-    hits = [l for l in lines if l.startswith(prefix)]\n-    assert len(hits) == 1, f\"AC row {num}: {len(hits)} hits\"\n-    return hits[0]\n-\n-\n-for num in (\"79\", \"81\"):\n-    old, new = ac_row(mat.splitlines(), num), ac_row(trace.splitlines(), num)\n-    # Matrix carries both copies of each AC row; TRACEABILITY carries one.\n-    n = mat.count(old)\n-    assert n == 2, f\"AC row {num}: {n} matrix copies, want 2\"\n-    mat = mat.replace(old, new)\n+def ac_row(lines, num, want):\n+    prefix = f\"| {num} |\"\n+    hits = [l for l in lines if l.startswith(prefix)]\n+    assert len(hits) == want, f\"AC row {num}: {len(hits)} hits, want {want}\"\n+    assert len(set(hits)) == 1, f\"AC row {num}: copies differ\"\n+    return hits[0]\n+\n+\n+for num in (\"79\", \"81\"):\n+    # Matrix carries both copies of each AC row; TRACEABILITY carries one.\n+    old, new = ac_row(mat.splitlines(), num, 2), ac_row(trace.splitlines(), num, 1)\n+    mat = mat.replace(old, new)\n","final_result":true}}}
