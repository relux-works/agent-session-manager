{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc89","stream":{"kind":"session","id":"01a0ca08-6c63-7352-b762-5bc242c771c8"},"sequence":1183,"recorded_at":1780531400002361,"record_type":"event","durability":"durable","causation_id":"cd8feb9b-6d69-49ce-a85c-818ca818e251","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cd8feb9b-6d69-49ce-a85c-818ca818e251","run_stream":{"kind":"run","id":"cd8feb9b-6d69-49ce-a85c-818ca818e251"},"task_stream":{"kind":"task","id":"01a0ca0e-edae-7cb0-ac2d-0ccf619e4594"},"task_id":"01a0ca0e-edae-7cb0-ac2d-0ccf619e4594","event":{"kind":"output","task_id":"01a0ca0e-edae-7cb0-ac2d-0ccf619e4594","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2t4g7i/worktree/internal/tmuxserver/lifecycle.go`.\n(659 line(s) above)\n660|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"boundary outcome image\"}\n661|\t}\n662|\trendered := formatTimestamp(lc.Now())\n663|\tif err := lc.States.RecordOutcome(key, OperationOutcome{Operation: string(terminalbackend.OperationWaitSafeBoundary), BoundaryObservedAt: rendered, Incarnation: incarnation}); err != nil {\n664|\t\treturn \"\", &Error{Code: terminalbackend.CodeIntegrityFailure, Detail: \"boundary outcome image\"}\n665|\t}\n666|\treturn rendered, nil\n667|}\n668|\n669|// boundWait bounds the safe-boundary wait by the lesser of the request\n670|// deadline and the timeout: the wait context carries the minimum, and\n671|// an already-invalid deadline falls back to the timeout alone (the\n672|// engine refuses the malformed deadline before any effect runs, so the\n673|// fallback never binds). The caller cancels the context.\n674|func (lc *Lifecycle) boundWait(ctx context.Context, mctx terminstance.MutationContext, timeoutMs uint64) (context.Context, context.CancelFunc) {\n675|\tbound := lc.Now().Add(time.Duration(timeoutMs) * time.Millisecond)\n676|\tif deadline, err := mctx.Deadline.Time(); err == nil && deadline.Before(bound) {\n677|\t\tbound = deadline\n678|\t}\n679|\treturn context.WithDeadline(ctx, bound)\n680|}\n681|\n682|// lesserDeadline computes the lesser of the request deadline and the\n683|// graceful timeout for the stop close-confirm poll. An invalid\n684|// deadline falls back the same way as the boundary wait.\n685|func (lc *Lifecycle) lesserDeadline(mctx terminstance.MutationContext, timeoutMs uint64) time.Time {\n686|\tbound := lc.Now().Add(time.Duration(timeoutMs) * time.Millisecond)\n687|\tif deadline, err := mctx.Deadline.Time(); err == nil && deadline.Before(bound) {\n688|\t\treturn deadline\n689|\t}\n690|\treturn bound\n691|}\n692|\n693|// engineKind resolves one engine operation's AX authorization kind\n694|// through the landed transition table, mirroring the engine's own\n695|// mapping: the table names the kind and this function honors it. A\n696|// drift resolves to the empty kind, which the authorization check\n697|// refuses exactly like the engine's entry gate would.\n698|func engineKind(operation terminalbackend.Operation) terminstance.AuthorizationKind {\n699|\tlanded, err := terminalbackend.TransitionAuthorization(string(operation))\n700|\tif err != nil {\n701|\t\treturn \"\"\n702|\t}\n703|\tkind, err := terminstance.ParseAuthorizationKind(landed)\n704|\tif err != nil {\n705|\t\treturn \"\"\n706|\t}\n707|\treturn kind\n708|}\n709|\n710|// effectRecheck builds the within-effect authorization revalidation\n711|// for one engine operation: the same three per-effect gates the\n712|// landed loop applies before every effect — the operation deadline,\n713|// the AX authorization over the live lease, and the live server\n714|// generation — evaluated at the destructive command boundary that\n715|// follows a wait. The timeout code is the operation row's own\n716|// member. The authorization gate is the landed CheckAuthorization\n717|// over the same request authorization, kind, lease, and clock the\n718|// engine passes; nothing here re-implements it.\n719|func (lc *Lifecycle) effectRecheck(operation terminalbackend.Operation, mctx terminstance.MutationContext, kind terminstance.AuthorizationKind, opDeadline time.Time) func() error {\n720|\ttimeoutCode := rowTimeoutCode(operation)\n721|\treturn func() error {\n722|\t\tif !lc.Now().Before(opDeadline) {\n723|\t\t\treturn &terminstance.Error{Code: timeoutCode, Detail: \"operation deadline\"}\n724|\t\t}\n725|\t\tif err := terminstance.CheckAuthorization(mctx.Authorization, kind, lc.CurrentLease(), lc.Now()); err != nil {\n726|\t\t\treturn err\n727|\t\t}\n728|\t\tif lc.CurrentGeneration() != mctx.BackendGeneration {\n729|\t\t\treturn &terminstance.Error{Code: terminalbackend.CodeStaleGeneration, Detail: \"backend_generation stale\"}\n730|\t\t}\n731|\t\treturn nil\n732|\t}\n733|}\n734|\n735|// waitUntil bounds one wait by an absolute operation deadline\n736|// measured on the lifecycle clock, combined with the caller's\n737|// context. The duration comes from the request deadline minus the\n738|// lifecycle now, so fake-clock requests wait out their remaining\n739|// real time and already-passed deadlines refuse at once; the\n740|// caller cancels the context. A deadline cancels waiting, not a\n741|// committed effect.\n742|func (lc *Lifecycle) waitUntil(ctx context.Context, deadline time.Time) (context.Context, context.CancelFunc) {\n743|\treturn context.WithTimeout(ctx, deadline.Sub(lc.Now()))\n744|}\n745|\n746|// waitContext bounds one engine-operation wait by the mutation\n747|// context deadline. An unparseable deadline leaves the caller's\n748|// context unmodified: the operation body parse refuses it before\n749|// any wait runs, so the unmodified wait never binds an effect,\n750|// and a dedicated probe proves the path still returns promptly\n751|// under contention.\n752|func (lc *Lifecycle) waitContext(ctx context.Context, mctx terminstance.MutationContext) (context.Context, context.CancelFunc) {\n753|\tdeadline, err := mctx.Deadline.Time()\n754|\tif err != nil {\n755|\t\treturn ctx, func() {}\n756|\t}\n757|\treturn lc.waitUntil(ctx, deadline)\n758|}\n759|\n760|// acquireBarrier acquires the barrier mutex unless the wait context\n761|// fires first, in which case no lock is held and the waiter reports\n762|// the context error. A waiter that loses the race releases the\n763|// mutex as soon as its orphan acquisition lands, so a timed-out\n764|// waiter never steals the barrier from the next holder and never\n765|// leaves a goroutine behind once the holder releases. Every\n766|// barrier user — attach, the quiesce span, the boundary report\n767|// commit — acquires through this contract.\n768|func (lc *Lifecycle) acquireBarrier(ctx context.Context) (func(), error) {\n769|\t// An already-fired wait never starts its waiter: the\n770|\t// request is refused deterministically instead of racing the\n771|\t// orphan acquisition against the fired context.\n772|\tif err := ctx.Err(); err != nil {\n773|\t\treturn nil, err\n774|\t}\n775|\tacquired := make(chan struct{})\n776|\tgo func() {\n777|\t\tlc.barrierMu.Lock()\n778|\t\tclose(acquired)\n779|\t}()\n(more lines below)","final_result":true}}}
