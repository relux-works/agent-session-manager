{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cdc7","stream":{"kind":"session","id":"01a0ca08-6c63-7352-b762-5bc242c771c8"},"sequence":1342,"recorded_at":1780531400002679,"record_type":"event","durability":"durable","causation_id":"cd8feb9b-6d69-49ce-a85c-818ca818e251","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cd8feb9b-6d69-49ce-a85c-818ca818e251","run_stream":{"kind":"run","id":"cd8feb9b-6d69-49ce-a85c-818ca818e251"},"task_stream":{"kind":"task","id":"01a0ca10-c78f-7530-87e9-bcb0e77dcd6b"},"task_id":"01a0ca10-c78f-7530-87e9-bcb0e77dcd6b","event":{"kind":"output","task_id":"01a0ca10-c78f-7530-87e9-bcb0e77dcd6b","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2t4g7i/worktree/internal/tmuxserver/lifecycle_rev9_unix_test.go`.\n(115 line(s) above)\n116|func TestAttachPeerDirectoryFailsClosed(t *testing.T) {\n117|\tt.Run(\"receipt-dir refuses\", func(t *testing.T) {\n118|\t\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n119|\t\tif _, err := fx.lc.Execute(context.Background(), OpRequest{\n120|\t\t\tOperation: \"attach\", Body: lxAttachBody(t, nil), Source: \"parked\", Admitted: fullLifecycleAdmitted(),\n121|\t\t}); err != nil {\n122|\t\t\tt.Fatal(err)\n123|\t\t}\n124|\t\treceipt := filepath.Join(fx.data, \"attachstore\", \"termbind\", \"attach\", lxInstance, lxClient+\".json\")\n125|\t\traw, err := os.ReadFile(receipt)\n126|\t\tif err != nil {\n127|\t\t\tt.Fatal(err)\n128|\t\t}\n129|\t\tif err := os.Remove(receipt); err != nil {\n130|\t\t\tt.Fatal(err)\n131|\t\t}\n132|\t\tif err := os.Mkdir(receipt, 0o755); err != nil {\n133|\t\t\tt.Fatal(err)\n134|\t\t}\n135|\t\tif err := os.WriteFile(filepath.Join(receipt, \"original.json\"), raw, 0o600); err != nil {\n136|\t\t\tt.Fatal(err)\n137|\t\t}\n138|\t\tsecond := lxAttachBody(t, func(object map[string]any) {\n139|\t\t\tobject[\"client_id\"] = lxClientB\n140|\t\t})\n141|\t\toutcome, err :=