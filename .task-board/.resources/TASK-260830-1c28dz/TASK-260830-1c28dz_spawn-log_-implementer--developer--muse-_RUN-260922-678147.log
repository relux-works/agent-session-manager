f err != nil {\\n\\t\\t\\treturn nil, err\\n\\t\\t}\\n',\n+        replace='\\t\\tkeyed, found, err := store.Lookup(sessionID, instanceID, stem)\\n\\t\\tif err != nil {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n',\n+        count=1,\n+        run=\"TestAttachPeerFilenameMismatchFailsClosed\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the key-binding-failed peer past the census filename arm as a skip (a valid receipt misfiled under another client's name reads as no peer); undecodable files, foreign receipts, directories, and malformed stems still error, staging and non-receipt entries still skip. Kill path: the second attach succeeds past the misfiled receipt with a fresh receipt, argv, and input authorization, so every assertion reddens.\",\n+    ),\n+    Mutant(\n+        name=\"N-attach-overlap-replay-unproven\",\n","final_result":true}}}
