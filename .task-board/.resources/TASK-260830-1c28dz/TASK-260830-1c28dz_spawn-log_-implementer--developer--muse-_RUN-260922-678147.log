= event.get(\\\"Package\\\", \\\"\\\")\\n            if not test or \\\"/\\\" in test:\\n                # Top-level tests only; subtests roll into their parent.\\n                if \\\"/\\\" in test:\\n                    continue\\n                if not test:\\n                    continue\\n            key = (package, test)\\n            # Final verdict wins (run/pass/fail sequence per test).\\n            verdicts[key] = event[\\\"Action\\\"]\\n    return verdicts\\n\",\n  \"original_output_bytes\": 1354,\n  \"original_output_tokens\": 339,\n  \"truncated\": false\n}","final_result":true}}}
