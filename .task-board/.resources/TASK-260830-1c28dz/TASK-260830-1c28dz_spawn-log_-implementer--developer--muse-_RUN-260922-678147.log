{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d1f1","stream":{"kind":"session","id":"01a0ca08-6c63-7352-b762-5bc242c771c8"},"sequence":1875,"recorded_at":1780531400003745,"record_type":"event","durability":"durable","causation_id":"cd8feb9b-6d69-49ce-a85c-818ca818e251","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cd8feb9b-6d69-49ce-a85c-818ca818e251","run_stream":{"kind":"run","id":"cd8feb9b-6d69-49ce-a85c-818ca818e251"},"task_stream":{"kind":"task","id":"01a0ca14-6cee-7630-bf7f-037bcb379b58"},"task_id":"01a0ca14-6cee-7630-bf7f-037bcb379b58","event":{"kind":"output","task_id":"01a0ca14-6cee-7630-bf7f-037bcb379b58","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2t4g7i/worktree/internal/tmuxserver/lifecycle_harness_test.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"encoding/json\"\n6|\t\"errors\"\n7|\t\"fmt\"\n8|\t\"os\"\n9|\t\"path/filepath\"\n10|\t\"strings\"\n11|\t\"sync\"\n12|\t\"testing\"\n13|\t\"time\"\n14|\n15|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n16|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n17|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n18|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n19|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n20|)\n21|\n22|// fakeRunner is a scripted Runner: responses are keyed by the tmux\n23|// subcommand (argv[3]), served FIFO per key, with every argv recorded.\n24|// An empty script for a key is a test failure (fail-closed scripts:\n25|// unexpected execs redden instead of returning zero values).\n26|type fakeRunner struct {\n27|\tmu        sync.Mutex\n28|\tscript    map[string][]fakeResponse\n29|\tcalls     [][]string\n30|\tonRun     func(argv []string)\n31|\ttransport map[string]error\n32|}\n33|\n34|type fakeResponse struct {\n35|\tstdout string\n36|\tstderr string\n37|\texit   int\n38|}\n39|\n40|func newFakeRunner() *fakeRunner {\n41|\treturn &fakeRunner{script: map[string][]fakeResponse{}, transport: map[string]error{}}\n42|}\n43|\n44|// queue appends one scripted response for a subcommand.\n45|func (runner *fakeRunner) queue(subcommand, stdout string, exit int) *fakeRunner {\n46|\trunner.mu.Lock()\n47|\tdefer runner.mu.Unlock()\n48|\trunner.script[subcommand] = append(runner.script[subcommand], fakeResponse{stdout: stdout, exit: exit})\n49|\treturn runner\n50|}\n51|\n52|// queueFull appends one scripted response with stderr for a\n53|// subcommand. Absence-shaped scripts (has-session, list-panes) must\n54|// carry the tmux stderr marker their verdict needs; a bare exit 1\n55|// without stderr is unknown, never absent.\n56|func (runner *fakeRunner) queueFull(subcommand, stdout, stderr string, exit int) *fakeRunner {\n57|\trunner.mu.Lock()\n58|\tdefer runner.mu.Unlock()\n59|\trunner.script[subcommand] = append(runner.script[subcommand], fakeResponse{stdout: stdout, stderr: stderr, exit: exit})\n60|\treturn runner\n61|}\n62|\n63|// failTransport arms a transport error for a subcommand (served once,\n64|// FIFO ahead of queued responses when set).\n65|func (runner *fakeRunner) failTransport(subcommand string, err error) *fakeRunner {\n66|\trunner.mu.Lock()\n67|\tdefer runner.mu.Unlock()\n68|\trunner.transport[subcommand] = err\n69|\treturn runner\n70|}\n71|\n72|func (runner *fakeRunner) Run(_ context.Context, argv []string) (RunResult, error) {\n73|\trunner.mu.Lock()\n74|\tdefer runner.mu.Unlock()\n75|\trunner.calls = append(runner.calls, append([]string(nil), argv...))\n76|\tif runner.onRun != nil {\n77|\t\trunner.onRun(argv)\n78|\t}\n79|\tif len(argv) < 4 || argv[0] != \"tmux\" || argv[1] != \"-S\" {\n80|\t\treturn RunResult{}, fmt.Errorf(\"fake runner refuses unshaped argv %q\", argv)\n81|\t}\n82|\tkey := argv[3]\n83|\tif err, armed := runner.transport[key]; armed {\n84|\t\tdelete(runner.transport, key)\n85|\t\treturn RunResult{}, err\n86|\t}\n87|\tresponses := runner.script[key]\n88|\tif len(responses) == 0 {\n89|\t\treturn RunResult{}, fmt.Errorf(\"fake runner has no script for %q (call %d)\", key, len(runner.calls))\n90|\t}\n91|\tnext := responses[0]\n92|\trunner.script[key] = responses[1:]\n93|\treturn RunResult{Stdout: []byte(next.stdout), Stderr: []byte(next.stderr), ExitCode: next.exit}, nil\n94|}\n95|\n96|func (runner *fakeRunner) callCount() int {\n97|\trunner.mu.Lock()\n98|\tdefer runner.mu.Unlock()\n99|\treturn len(runner.calls)\n100|}\n101|\n102|func (runner *fakeRunner) subcommands() []string {\n103|\trunner.mu.Lock()\n104|\tdefer runner.mu.Unlock()\n105|\tvar subcommands []string\n106|\tfor _, call := range runner.calls {\n107|\t\tif len(call) >= 4 {\n108|\t\t\tsubcommands = append(subcommands, call[3])\n109|\t\t}\n110|\t}\n111|\treturn subcommands\n112|}\n113|\n114|// manualClock is a fake Now/Sleep pair: Sleep advances the clock\n115|// instead of waiting, so poll loops run deterministically.\n116|type manualClock struct {\n117|\tmu  sync.Mutex\n118|\tnow time.Time\n119|}\n120|\n(more lines below)","final_result":true}}}
