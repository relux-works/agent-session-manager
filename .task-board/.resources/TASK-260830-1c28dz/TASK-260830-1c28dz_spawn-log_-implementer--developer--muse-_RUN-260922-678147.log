{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5a3","stream":{"kind":"session","id":"01a0ca08-6c63-7352-b762-5bc242c771c8"},"sequence":300,"recorded_at":1780531400000595,"record_type":"event","durability":"durable","causation_id":"cd8feb9b-6d69-49ce-a85c-818ca818e251","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cd8feb9b-6d69-49ce-a85c-818ca818e251","run_stream":{"kind":"run","id":"cd8feb9b-6d69-49ce-a85c-818ca818e251"},"task_stream":{"kind":"task","id":"01a0ca09-02c9-7590-beef-7cd96d63de4a"},"task_id":"01a0ca09-02c9-7590-beef-7cd96d63de4a","event":{"kind":"output","task_id":"01a0ca09-02c9-7590-beef-7cd96d63de4a","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2t4g7i/worktree/internal/tmuxserver/backend.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"errors\"\n6|\t\"strconv\"\n7|\t\"strings\"\n8|\t\"time\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n15|)\n16|\n17|// operationDirectives is the exact lifecycle-to-tmux mapping: every\n18|// operation executes a fixed directive sequence and no other tmux\n19|// command. The table is the contract; the drivers below execute it.\n20|// The boundary list-panes member is conditional: it runs only for\n21|// provider proof kinds, binding contemporaneous provider rows into\n22|// the boundary evidence, and never fails the observation.\n23|var operationDirectives = map[terminalbackend.Operation][]Directive{\n24|\tterminalbackend.OperationCreate:           {DirectiveNewSession},\n25|\tterminalbackend.OperationAttach:           {DirectiveAttachSession},\n26|\tterminalbackend.OperationStatus:           {DirectiveListPanes, DirectiveListSessions},\n27|\tterminalbackend.OperationQuiesceInput:     {DirectiveLockSession, DirectiveDetachClients},\n28|\tterminalbackend.OperationWaitSafeBoundary: {DirectiveWaitBoundary, DirectiveListPanes},\n29|\tterminalbackend.OperationRequestStop:      {DirectiveSendInterrupt, DirectiveHasSession, DirectiveKillSession, DirectiveHasSession},\n30|\tterminalbackend.OperationTerminateStale:   {DirectiveKillSession, DirectiveHasSession},\n31|\tterminalbackend.OperationRestore:          {DirectiveNewSession},\n32|}\n33|\n34|// DirectivesFor reports the fixed tmux directive sequence for one\n35|// lifecycle operation. Manifest and probe are not lifecycle operations\n36|// and refuse; every other unknown operation refuses as well.\n37|func DirectivesFor(operation terminalbackend.Operation) ([]Directive, error) {\n38|\tdirectives, known := operationDirectives[operation]\n39|\tif !known {\n40|\t\treturn nil, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle operation\"}\n41|\t}\n42|\treturn append([]Directive(nil), directives...), nil\n43|}\n44|\n45|// backend is the tmux terminstance.Backend: side-effect execution and\n46|// status observation over the structured commands. It is\n47|// request-scoped — one backend per Execute call — because effects\n48|// carry no identity of their own and the runner, socket, stores, and\n49|// admission are per-request facts.\n50|type backend struct {\n51|\trunner      Runner\n52|\truntimeDir  string\n53|\tsocket      string\n54|\toperation   terminalbackend.Operation\n55|\tsessionID   string\n56|\tinstanceID  string\n57|\tbootstrapID string\n58|\tbindingID   string\n59|\tbindingDoc  []byte\n60|\tchannel     string\n61|\tquiescence  string\n62|\tproofKind   terminstance.ProviderProofKind\n63|\twaitCtx     context.Context\n64|\tdeadline    time.Time\n65|\t// recheck revalidates the live authorization facts (operation\n66|\t// deadline, AX authorization over the current lease, server\n67|\t// generation) at a destructive command boundary that follows a\n68|\t// wait. The lifecycle entry builds it over the same landed\n69|\t// gates the engine's per-effect loop applies; paths whose\n70|\t// effects issue no destructive command after any wait leave it\n71|\t// nil. A nil recheck at a guarded boundary refuses instead of\n72|\t// running blind: the backend never issues a post-wait\n73|\t// destructive command without its revalidation.\n74|\trecheck   func() error\n75|\tnow       func() time.Time\n76|\tsleep     func(time.Duration)\n77|\tpoll      time.Duration\n78|\tadmitted  terminalbackend.Admitted\n79|\tbindings  *axpane.Store\n80|\tattach    *termbind.AttachStore\n81|\tstates    *InstanceStates\n82|\ttransport string\n83|\tinput     bool\n84|\tauthRaw   []byte\n85|\tclientID  string\n86|\t// killExit records the stale-kill exit for the close re-confirm:\n87|\t// a live session after a clean kill and a live session after a\n88|\t// failed kill refuse through the same arm, and the recorded exit\n89|\t// is the member split the narrowing mutant admits exactly one of.\n90|\t// -1 means no kill ran yet on this backend.\n91|\tkillExit int\n92|}\n93|\n94|// effectEvidence derives one evidence digest over the canonical effect\n95|// record: effect name, operation, instance, and outcome facts. The join\n96|// is deterministic; nothing parses it back.\n97|func effectEvidence(effect terminalbackend.SideEffect, operation terminalbackend.Operation, instance string, facts ...string) string {\n98|\trecord := strings.Join(append([]string{string(effect), string(operation), instance}, facts...), \"\\n\")\n99|\treturn scalar.SHA256Digest([]byte(record)).String()\n100|}\n101|\n102|// PerformEffect executes one side effect and reports its evidence ID.\n103|// A nil error proves the commit; a coded error proves the backend\n104|// refused before committing; any other error proves nothing. Every\n105|// tmux command runs through BuildCommand, so no effect addresses any\n106|// server but the derived socket.\n107|func (runner *backend) PerformEffect(ctx context.Context, effect terminalbackend.SideEffect) (string, error) {\n108|\tswitch effect {\n109|\tcase terminalbackend.EffectBindingPersisted:\n110|\t\treturn runner.persistBinding()\n111|\tcase terminalbackend.EffectWrapperStarted:\n112|\t\treturn runner.startWrapper(ctx, terminalbackend.EffectWrapperStarted)\n113|\tcase terminalbackend.EffectAttachClientCreated:\n114|\t\treturn runner.createAttachClient()\n115|\tcase terminalbackend.EffectInputClosed:\n116|\t\treturn runner.closeInput(ctx)\n117|\tcase terminalbackend.EffectSafeBoundaryObserved:\n118|\t\treturn runner.observeBoundary()\n119|\tcase terminalbackend.EffectGracefulStopRequested:\n120|\t\treturn runner.execEvidence(ctx, DirectiveSendInterrupt, terminalbackend.EffectGracefulStopRequested)\n121|\tcase terminalbackend.EffectProcessClosed:\n122|\t\treturn runner.confirmClosed(ctx)\n123|\tcase terminalbackend.EffectBackendStoreClosed:\n124|\t\treturn effectEvidence(effect, runner.operation, runner.instanceID, \"tmux-side closes done\"), nil\n125|\tcase terminalbackend.EffectStaleIncarnationTerminated:\n126|\t\treturn runner.terminateStale(ctx)\n127|\tcase terminalbackend.EffectWrapperRestored:\n128|\t\treturn runner.startWrapper(ctx, terminalbackend.EffectWrapperRestored)\n129|\tdefault:\n130|\t\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend effect vocabulary\"}\n131|\t}\n132|}\n133|\n134|// persistBinding records the bootstrap binding for the create/restore\n135|// pair. A changed operation in the bootstrap window refuses the landed\n136|// idempotency_mismatch; an identical retry replays the one receipt.\n137|// On create the carried binding document is kept alongside the\n138|// receipt, so restore can return the required binding without\n139|// minting; a replayed receipt heals a missing document from the same\n140|// carried bytes, closing the crash window between receipt and\n141|// document.\n142|func (runner *backend) persistBinding() (string, error) {\n143|\tif runner.bindings == nil {\n144|\t\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend binding store\"}\n145|\t}\n146|\trecorded, replayed, err := runner.bindings.Bind(runner.sessionID, runner.bootstrapID, axpane.Binding{\n147|\t\tSessionID:          runner.sessionID,\n148|\t\tOperationID:        runner.bootstrapID,\n149|\t\tTerminalInstanceID: runner.instanceID,\n150|\t\tBindingDigest:      runner.bindingID,\n151|\t})\n152|\tif err != nil {\n153|\t\tif code := backendErrorCode(err); code != \"\" {\n154|\t\t\treturn \"\", &terminstance.Error{Code: code, Detail: \"backend binding conflict\"}\n155|\t\t}\n156|\t\treturn \"\", err\n157|\t}\n158|\tif len(runner.bindingDoc) > 0 && runner.states != nil {\n159|\t\tif !replayed {\n160|\t\t\tif err := runner.states.RecordBindingDoc(runner.sessionID, runner.bootstrapID, runner.bindingDoc); err != nil {\n161|\t\t\t\treturn \"\", err\n162|\t\t\t}\n163|\t\t} else if _, found, err := runner.states.LookupBindingDoc(runner.sessionID, runner.bootstrapID); err != nil {\n164|\t\t\treturn \"\", err\n165|\t\t} else if !found {\n166|\t\t\tif err := runner.states.RecordBindingDoc(runner.sessionID, runner.bootstrapID, runner.bindingDoc); err != nil {\n167|\t\t\t\treturn \"\", err\n168|\t\t\t}\n169|\t\t}\n170|\t}\n171|\treturn recorded.BindingDigest, nil\n172|}\n173|\n174|// closeInput cuts operator input to the instance: lock-session first,\n175|// so attached clients cannot type into the pane during the detach\n176|// window, then detach-client -s, which detaches every client\n177|// currently attached to the session. A locked session does not lock\n178|// subsequently attaching clients (verified on tmux 3.6a), so new\n179|// input-authorized attaches are refused AX-side at the attach entry\n180|// once the quiescing state records; read-only attaches stay admitted\n181|// because quiesce retains observation. Provider input enters only\n182|// through the request-stop effect (the ordered next step), so no\n183|// send-keys runs here. Both commands must exit clean; the evidence\n184|// binds both exits. The detach is a second destructive command after\n185|// the lock's round trip, so the boundary between them revalidates\n186|// the authorization facts the engine checked before the effect: a\n187|// generation rotated, authorization lapsed, or deadline passed\n188|// during the lock refuses before the detach issues.\n189|func (runner *backend) closeInput(ctx context.Context) (string, error) {\n190|\tfor i, directive := range []Directive{DirectiveLockSession, DirectiveDetachClients} {\n191|\t\tif i > 0 {\n192|\t\t\tif err := runner.recheckPostWait(); err != nil {\n193|\t\t\t\treturn \"\", err\n194|\t\t\t}\n195|\t\t}\n196|\t\targv, err := runner.command(directive)\n197|\t\tif err != nil {\n198|\t\t\treturn \"\", err\n199|\t\t}\n200|\t\tresult, err := runner.runner.Run(ctx, argv)\n201|\t\tif err != nil {\n202|\t\t\treturn \"\", err\n203|\t\t}\n204|\t\tif result.ExitCode != 0 {\n205|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n206|\t\t}\n207|\t}\n208|\treturn effectEvidence(terminalbackend.EffectInputClosed, runner.operation, runner.instanceID, \"locked\", \"detached\"), nil\n209|}\n210|\n211|// recheckPostWait runs the entry-configured authorization\n212|// revalidation at a destructive command boundary that follows a\n213|// wait. A missing revalidation refuses: the boundary never runs\n214|// blind.\n215|func (runner *backend) recheckPostWait() error {\n216|\tif runner.recheck == nil {\n217|\t\treturn &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend authorization recheck\"}\n218|\t}\n219|\treturn runner.recheck()\n220|}\n221|\n222|// startWrapper execs the instance new-session vector for create\n223|// (wrapper_started) and restore (wrapper_restored).\n224|func (runner *backend) startWrapper(ctx context.Context, effect terminalbackend.SideEffect) (string, error) {\n225|\treturn runner.execEvidence(ctx, DirectiveNewSession, effect)\n226|}\n227|\n228|// createAttachClient records the presentation client receipt for one\n229|// (instance, client) pair. Every call requires the valid unexpired\n230|// attach authorization the attach handler already admitted; the store\n231|// rechecks it, so a timeout creates no authorized input unless the\n232|// durable receipt says so.\n233|func (runner *backend) createAttachClient() (string, error) {\n234|\tif runner.attach == nil {\n235|\t\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend attach store\"}\n236|\t}\n237|\treceipt, _, err := runner.attach.Attach(runner.sessionID, runner.instanceID, runner.clientID, runner.transport, runner.input, runner.authRaw, runner.now())\n238|\tif err != nil {\n239|\t\tif code := backendErrorCode(err); code != \"\" {\n240|\t\t\treturn \"\", &terminstance.Error{Code: code, Detail: \"backend attach conflict\"}\n241|\t\t}\n242|\t\treturn \"\", err\n243|\t}\n244|\treturn effectEvidence(terminalbackend.EffectAttachClientCreated, runner.operation, runner.instanceID, receipt.ClientID, receipt.Transport), nil\n245|}\n246|\n247|// execEvidence runs one directive and evidences its success. A nonzero\n248|// exit is a coded process failure: the command ran and the effect did\n249|// not commit. A transport error is uncoded: it proves nothing.\n250|func (runner *backend) execEvidence(ctx context.Context, directive Directive, effect terminalbackend.SideEffect) (string, error) {\n251|\targv, err := runner.command(directive)\n252|\tif err != nil {\n253|\t\treturn \"\", err\n254|\t}\n255|\tresult, err := runner.runner.Run(ctx, argv)\n256|\tif err != nil {\n257|\t\treturn \"\", err\n258|\t}\n259|\tif result.ExitCode != 0 {\n260|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n261|\t}\n262|\treturn effectEvidence(effect, runner.operation, runner.instanceID, strconv.Itoa(result.ExitCode)), nil\n263|}\n264|\n265|// observeBoundary waits for the wrapper's safe-boundary signal on the\n266|// quiescence channel with the bare blocking `wait-for` vector. The\n267|// wait context already bounds the lesser of the request deadline and\n268|// the timeout; its expiry is the coded quiesce_timeout proving\n269|// non-commit, never a silent continue. The requested provider proof\n270|// kind is bound into the evidence, so each kind proves its own\n271|// boundary and an identical retry replays the same proof. For\n272|// provider proof kinds the contemporaneous provider rows are bound\n273|// alongside: the signal is the proof, the rows are audit context,\n274|// and a failed row read binds its negative instead of failing the\n275|// observed proof.\n276|func (runner *backend) observeBoundary() (string, error) {\n277|\targv, err := runner.command(DirectiveWaitBoundary)\n278|\tif err != nil {\n279|\t\treturn \"\", err\n280|\t}\n281|\tresult, err := runner.runner.Run(runner.waitCtx, argv)\n282|\tif err != nil {\n283|\t\tif runner.waitCtx.Err() != nil {\n284|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeQuiesceTimeout, Detail: \"backend boundary wait\"}\n285|\t\t}\n286|\t\treturn \"\", err\n287|\t}\n288|\tif result.ExitCode != 0 {\n289|\t\tif runner.waitCtx.Err() != nil {\n290|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeQuiesceTimeout, Detail: \"backend boundary wait\"}\n291|\t\t}\n292|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n293|\t}\n294|\tobserved, err := runner.now().UTC().MarshalText()\n295|\tif err != nil {\n296|\t\treturn \"\", err\n297|\t}\n298|\tfacts := []string{string(runner.proofKind), runner.channel, string(observed)}\n299|\tif terminstance.RequiresProviderObservation(runner.proofKind) {\n300|\t\tfacts = append(facts, runner.boundaryProviderRows())\n301|\t}\n302|\treturn effectEvidence(terminalbackend.EffectSafeBoundaryObserved, runner.operation, runner.instanceID, facts...), nil\n303|}\n304|\n305|// boundaryProviderRows reads the contemporaneous provider rows for a\n306|// provider-kind boundary as bound context. Presence binds the row\n307|// set; absence binds the negative; a failed read binds unknown. The\n308|// verdict never fails: the wrapper signal already proved the\n309|// boundary, and a post-signal crash must not discard that proof.\n310|func (runner *backend) boundaryProviderRows() string {\n311|\tctx := runner.waitCtx\n312|\tif ctx == nil {\n313|\t\tctx = context.Background()\n314|\t}\n315|\tpresent, rows, err := runner.probePanes(ctx, runner.instanceID)\n316|\tif err != nil {\n317|\t\treturn \"provider:unknown\"\n318|\t}\n319|\tif !present {\n320|\t\treturn \"provider:absent\"\n321|\t}\n322|\treturn \"provider:\" + strings.Join(rows, \"\\n\")\n323|}\n324|\n325|// Absence stderr markers, verified against tmux 3.6a. has-session\n326|// against a missing session reports `can't find session`; list-panes\n327|// against a missing target reports `can't find window`; either\n328|// command against a missing server socket reports `error connecting\n329|// to <socket> (No such file or directory)`. Under a derived and\n330|// custody-verified socket, a missing socket proves no listener and\n331|// therefore no session. Every tmux failure exits 1, so the exit code\n332|// alone proves nothing: only these marker-paired exits prove\n333|// absence. Unrecognized stderr — permission failures, refused\n334|// connections, version-drifted strings — fails closed to unknown.\n335|const (\n336|\tabsentMarkerNoSession = \"can't find session\"\n337|\tabsentMarkerNoWindow  = \"can't find window\"\n338|\tabsentMarkerNoSocket  = \"No such file or directory\"\n339|\tabsentMarkerNoConnect = \"error connecting to\"\n340|)\n341|\n342|// errProbeUnknown is the uncoded unknown-probe signal: the probe ran\n343|// (or never answered) without proving presence or absence. Callers\n344|// return it verbatim; the engine and the lifecycle effect loop map\n345|// uncoded backend failures to the row-allowed process failure with\n346|// status_first and the unavailable observation, never to a verdict.\n347|var errProbeUnknown = errors.New(\"tmux probe proves neither presence nor absence\")\n348|\n349|// classifyAbsence sorts one probe run into present, absent, or\n350|// unknown. Exit 0 is present. A negative exit (a killed child that a\n351|// runner reported as data) is unknown, never absent. A positive exit\n352|// proves absence only with an absence marker on stderr; without one\n353|// it is unknown. Callers pass the markers their command emits.\n354|func classifyAbsence(result RunResult, markers ...string) (present, absent bool) {\n355|\tif result.ExitCode == 0 {\n356|\t\treturn true, false\n357|\t}\n358|\tif result.ExitCode < 0 {\n359|\t\treturn false, false\n360|\t}\n361|\tstderr := string(result.Stderr)\n362|\tfor _, marker := range markers {\n363|\t\tif marker == absentMarkerNoSocket {\n364|\t\t\tif strings.Contains(stderr, absentMarkerNoConnect) && strings.Contains(stderr, absentMarkerNoSocket) {\n365|\t\t\t\treturn false, true\n366|\t\t\t}\n367|\t\t\tcontinue\n368|\t\t}\n369|\t\tif strings.Contains(stderr, marker) {\n370|\t\t\treturn false, true\n371|\t\t}\n372|\t}\n373|\treturn false, false\n374|}\n375|\n376|// confirmClosed proves process closure for request-stop and\n377|// terminate-stale. Positively observed absence (has-session exit with\n378|// the no-session marker, or no server socket under the verified\n379|// path) is the proof. A live session on request-stop escalates once\n380|// to kill-session and re-confirms; a still-live session is the coded\n381|// stop_timeout. An unproven session — transport failure, killed\n382|// probe, or unmarked nonzero exit — is unknown at the deadline, never\n383|// closure. A live session on terminate-stale is the coded process\n384|// failure: the kill claimed the incarnation and it still answers.\n385|// The confirm polls to the deadline before it concludes anything.\n386|//\n387|// The stop escalation is a new destructive command after the poll\n388|// wait, so the poll bound (the graceful wait) expiring is exactly\n389|// when the other authorization facts must be re-proved: the\n390|// escalation revalidates the operation deadline, the AX\n391|// authorization over the current lease, and the server generation\n392|// before the kill issues. A graceful timeout escalates — the wait\n393|// did its job — but an operation deadline passed, an authorization\n394|// lapsed, or a generation rotated during the poll refuses without\n395|// issuing the kill. The terminate-stale tail issues no command\n396|// after its poll, so it carries no revalidation: its refusal\n397|// stands however the facts moved.\n398|func (runner *backend) confirmClosed(ctx context.Context) (string, error) {\n399|\tabsent, err := runner.pollSession(ctx)\n400|\tif err != nil {\n401|\t\treturn \"\", err\n402|\t}\n403|\tif absent {\n404|\t\treturn effectEvidence(terminalbackend.EffectProcessClosed, runner.operation, runner.instanceID, \"absent\"), nil\n405|\t}\n406|\tif runner.operation == terminalbackend.OperationRequestStop {\n407|\t\tif err := runner.recheckPostWait(); err != nil {\n408|\t\t\treturn \"\", err\n409|\t\t}\n410|\t\targv, err := runner.command(DirectiveKillSession)\n411|\t\tif err != nil {\n412|\t\t\treturn \"\", err\n413|\t\t}\n414|\t\tif result, err := runner.runner.Run(ctx, argv); err != nil {\n415|\t\t\treturn \"\", err\n416|\t\t} else if result.ExitCode != 0 {\n417|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n418|\t\t}\n419|\t\tabsent, err := runner.pollSession(ctx)\n420|\t\tif err != nil {\n421|\t\t\treturn \"\", err\n422|\t\t}\n423|\t\tif absent {\n424|\t\t\treturn effectEvidence(terminalbackend.EffectProcessClosed, runner.operation, runner.instanceID, \"escalated\"), nil\n425|\t\t}\n426|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeStopTimeout, Detail: \"backend stop wait\"}\n427|\t}\n428|\t// Terminate-stale re-confirm: a live session refuses whether the kill\n429|\t// exited clean or failed — the kill claimed the incarnation and it\n430|\t// still answers. The exit split names both members so each refuses\n431|\t// explicitly; the narrowing mutant admits exactly the failed-kill\n432|\t// member.\n433|\tif runner.killExit != 0 {\n434|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n435|\t}\n436|\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n437|}\n438|\n439|// probeContext bounds one read-only probe by an absolute deadline:\n440|// the duration from the backend clock to the deadline, enforced as\n441|// a real-time context timeout, so a blocked probe returns at the\n442|// bound even when the clock never advances. Duration-based, like\n443|// the barrier waitUntil contract: fake-clock deadlines bound real\n444|// waits. A zero deadline (paths with no poll contract) or a nil\n445|// clock leaves the caller's context unmodified. Callers treat\n446|// bound expiry as unknown — a timed-out probe proves neither\n447|// presence nor absence — never as a verdict.\n448|func probeContext(ctx context.Context, now func() time.Time, deadline time.Time) (context.Context, context.CancelFunc) {\n449|\tif ctx == nil {\n450|\t\tctx = context.Background()\n451|\t}\n452|\tif now == nil || deadline.IsZero() {\n453|\t\treturn ctx, func() {}\n454|\t}\n455|\treturn context.WithTimeout(ctx, deadline.Sub(now()))\n456|}\n457|\n458|// pollSession probes has-session until the session is absent or the\n459|// deadline passes. Presence polls on; absence returns at once; an\n460|// unproven probe (transport failure, killed child, unmarked exit,\n461|// or a probe still blocked when the bound fires) polls on until\n462|// the deadline and then reports unknown, never closure. The bound\n463|// cancels the in-flight probe itself, not just the loop around it:\n464|// clock checks after Run cannot cancel a Run that has not\n465|// returned. Answered probes follow the clock exactly as before;\n466|// only a probe that never answered concludes by the context.\n467|// Cancellation aborts at once.\n468|func (runner *backend) pollSession(ctx context.Context) (bool, error) {\n469|\tpollCtx, cancel := probeContext(ctx, runner.now, runner.deadline)\n470|\tdefer cancel()\n471|\tfor {\n472|\t\tif ctx != nil && ctx.Err() != nil {\n473|\t\t\treturn false, ctx.Err()\n474|\t\t}\n475|\t\targv, err := runner.command(DirectiveHasSession)\n476|\t\tif err != nil {\n477|\t\t\treturn false, err\n478|\t\t}\n479|\t\tresult, err := runner.runner.Run(pollCtx, argv)\n480|\t\tif err != nil {\n481|\t\t\tif ctx != nil && ctx.Err() != nil {\n482|\t\t\t\treturn false, ctx.Err()\n483|\t\t\t}\n484|\t\t\tif pollCtx.Err() != nil || !runner.now().Before(runner.deadline) {\n485|\t\t\t\treturn false, errProbeUnknown\n486|\t\t\t}\n487|\t\t\trunner.sleep(runner.poll)\n488|\t\t\tcontinue\n489|\t\t}\n490|\t\tpresent, absent := classifyAbsence(result, absentMarkerNoSession, absentMarkerNoSocket)\n491|\t\tif absent {\n492|\t\t\treturn true, nil\n493|\t\t}\n494|\t\tif !present {\n495|\t\t\tif !runner.now().Before(runner.deadline) {\n496|\t\t\t\treturn false, errProbeUnknown\n497|\t\t\t}\n498|\t\t\trunner.sleep(runner.poll)\n499|\t\t\tcontinue\n500|\t\t}\n(more lines below)","final_result":true}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5a5","stream":{"kind":"session","id":"01a0ca08-6c63-7352-b762-5bc242c771c8"},"sequence":301,"recorded_at":1780531400000597,"record_type":"event","durability":"durable","causation_id":"cd8feb9b-6d69-49ce-a85c-818ca818e251","payload_type":"task.lifecycle.completed","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cd8feb9b-6d69-49ce-a85c-818ca818e251","run_stream":{"kind":"run","id":"cd8feb9b-6d69-49ce-a85c-818ca818e251"},"task_stream":{"kind":"task","id":"01a0ca09-02c9-7590-beef-7cd96d63de4a"},"task_id":"01a0ca09-02c9-7590-beef-7cd96d63de4a","event":{"kind":"completed","task_id":"01a0ca09-02c9-7590-beef-7cd96d63de4a"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5a7","stream":{"kind":"session","id":"01a0ca08-6c63-7352-b762-5bc242c771c8"},"sequence":302,"recorded_at":1780531400000599,"record_type":"event","durability":"durable","causation_id":"cd8feb9b-6d69-49ce-a85c-818ca818e251","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"cd8feb9b-6d69-49ce-a85c-818ca818e251","run_stream":{"kind":"run","id":"cd8feb9b-6d69-49ce-a85c-818ca818e251"},"call_id":"call_01a0ca08fdef760187dc4887934574f6","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2t4g7i/worktree/internal/termbind/overlap.go`.\n1|package termbind\n2|\n3|import (\n4|\t\"errors\"\n5|\t\"fmt\"\n6|\t\"os\"\n7|\t\"path/filepath\"\n8|\t\"sort\"\n9|\t\"strings\"\n10|\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|)\n13|\n14|// Peers replays every recorded presentation-client receipt for one\n15|// terminal instance except the requesting client itself: the stored\n16|// peer census the attach overlap gate fails closed on. A stored peer\n17|// is possibly live — receipts outlive their clients, and no\n18|// liveness is decided here — so callers treat a non-empty census as\n19|// possible overlap. The requesting client is excluded by identity:\n20|// a retry replays its own receipt rather than adding a client.\n21|//\n22|// An unrecorded instance has no peers. A read or validation failure\n23|// is an error, never an empty census: unknown is not a verdict.\n24|// Staging entries (attach-*) and non-receipt names (anything without\n25|// the .json suffix) are skipped; every other entry sits inside the\n26|// receipt namespace and must read as a valid receipt file, so a\n27|// directory at a receipt-shaped name is corruption and errors —\n28|// never a skip, which would read a corrupt census as no peers.\n29|// Every decoded receipt must name this session and instance, like\n30|// Lookup. Peers arrive sorted by client ID.\n31|func (store *AttachStore) Peers(sessionID, instanceID, clientID string) ([]AttachReceipt, error) {\n32|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n33|\t\treturn nil, fmt.Errorf(\"attach peers session %q is not a UUIDv7: %w\", sessionID, err)\n34|\t}\n35|\tif err := CheckInstanceIdentity(instanceID); err != nil {\n36|\t\treturn nil, err\n37|\t}\n38|\tif err := CheckInstanceIdentity(clientID); err != nil {\n39|\t\treturn nil, err\n40|\t}\n41|\tentries, err := os.ReadDir(store.instanceDir(instanceID))\n42|\tif err != nil {\n43|\t\tif errors.Is(err, os.ErrNotExist) {\n44|\t\t\treturn nil, nil\n45|\t\t}\n46|\t\treturn nil, fmt.Errorf(\"read attach peers: %w\", err)\n47|\t}\n48|\tvar peers []AttachReceipt\n49|\tfor _, entry := range entries {\n50|\t\tname := entry.Name()\n51|\t\tif strings.HasPrefix(name, \"attach-\") || !strings.HasSuffix(name, \".json\") {\n52|\t\t\tcontinue\n53|\t\t}\n54|\t\tif entry.IsDir() {\n55|\t\t\treturn nil, fmt.Errorf(\"attach peer %q is not a receipt file\", name)\n56|\t\t}\n57|\t\traw, err := os.ReadFile(filepath.Join(store.instanceDir(instanceID), name))\n58|\t\tif err != nil {\n59|\t\t\treturn nil, fmt.Errorf(\"read attach peer: %w\", err)\n60|\t\t}\n61|\t\treceipt, err := decodeAttachReceipt(raw)\n62|\t\tif err != nil {\n63|\t\t\treturn nil, err\n64|\t\t}\n65|\t\tif receipt.SessionID != sessionID {\n66|\t\t\treturn nil, errors.New(\"attach receipt names another session\")\n67|\t\t}\n68|\t\tif receipt.TerminalInstanceID != instanceID {\n69|\t\t\treturn nil, errors.New(\"attach receipt names another client pair\")\n70|\t\t}\n71|\t\tif receipt.ClientID == clientID {\n72|\t\t\tcontinue\n73|\t\t}\n74|\t\tpeers = append(peers, receipt)\n75|\t}\n76|\tsort.Slice(peers, func(i, j int) bool { return peers[i].ClientID < peers[j].ClientID })\n77|\treturn peers, nil\n78|}","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c5a9","stream":{"kind":"session","id":"01a0ca08-6c63-7352-b762-5bc242c771c8"},"sequence":303,"recorded_at":1780531400000601,"record_type":"event","durability":"durable","causation_id":"cd8feb9b-6d69-49ce-a85c-818ca818e251","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"cd8feb9b-6d69-49ce-a85c-818ca818e251","run_stream":{"kind":"run","id":"cd8feb9b-6d69-49ce-a85c-818ca818e251"},"call_id":"call_01a0ca08ffe6761b81e996af41829178","text":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2t4g7i/worktree/internal/tmuxserver/backend.go`.\n1|package tmuxserver\n2|\n3|import (\n4|\t\"context\"\n5|\t\"errors\"\n6|\t\"strconv\"\n7|\t\"strings\"\n8|\t\"time\"\n9|\n10|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n11|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n12|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n13|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n14|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n15|)\n16|\n17|// operationDirectives is the exact lifecycle-to-tmux mapping: every\n18|// operation executes a fixed directive sequence and no other tmux\n19|// command. The table is the contract; the drivers below execute it.\n20|// The boundary list-panes member is conditional: it runs only for\n21|// provider proof kinds, binding contemporaneous provider rows into\n22|// the boundary evidence, and never fails the observation.\n23|var operationDirectives = map[terminalbackend.Operation][]Directive{\n24|\tterminalbackend.OperationCreate:           {DirectiveNewSession},\n25|\tterminalbackend.OperationAttach:           {DirectiveAttachSession},\n26|\tterminalbackend.OperationStatus:           {DirectiveListPanes, DirectiveListSessions},\n27|\tterminalbackend.OperationQuiesceInput:     {DirectiveLockSession, DirectiveDetachClients},\n28|\tterminalbackend.OperationWaitSafeBoundary: {DirectiveWaitBoundary, DirectiveListPanes},\n29|\tterminalbackend.OperationRequestStop:      {DirectiveSendInterrupt, DirectiveHasSession, DirectiveKillSession, DirectiveHasSession},\n30|\tterminalbackend.OperationTerminateStale:   {DirectiveKillSession, DirectiveHasSession},\n31|\tterminalbackend.OperationRestore:          {DirectiveNewSession},\n32|}\n33|\n34|// DirectivesFor reports the fixed tmux directive sequence for one\n35|// lifecycle operation. Manifest and probe are not lifecycle operations\n36|// and refuse; every other unknown operation refuses as well.\n37|func DirectivesFor(operation terminalbackend.Operation) ([]Directive, error) {\n38|\tdirectives, known := operationDirectives[operation]\n39|\tif !known {\n40|\t\treturn nil, &Error{Code: terminalbackend.CodeProtocolError, Detail: \"lifecycle operation\"}\n41|\t}\n42|\treturn append([]Directive(nil), directives...), nil\n43|}\n44|\n45|// backend is the tmux terminstance.Backend: side-effect execution and\n46|// status observation over the structured commands. It is\n47|// request-scoped — one backend per Execute call — because effects\n48|// carry no identity of their own and the runner, socket, stores, and\n49|// admission are per-request facts.\n50|type backend struct {\n51|\trunner      Runner\n52|\truntimeDir  string\n53|\tsocket      string\n54|\toperation   terminalbackend.Operation\n55|\tsessionID   string\n56|\tinstanceID  string\n57|\tbootstrapID string\n58|\tbindingID   string\n59|\tbindingDoc  []byte\n60|\tchannel     string\n61|\tquiescence  string\n62|\tproofKind   terminstance.ProviderProofKind\n63|\twaitCtx     context.Context\n64|\tdeadline    time.Time\n65|\t// recheck revalidates the live authorization facts (operation\n66|\t// deadline, AX authorization over the current lease, server\n67|\t// generation) at a destructive command boundary that follows a\n68|\t// wait. The lifecycle entry builds it over the same landed\n69|\t// gates the engine's per-effect loop applies; paths whose\n70|\t// effects issue no destructive command after any wait leave it\n71|\t// nil. A nil recheck at a guarded boundary refuses instead of\n72|\t// running blind: the backend never issues a post-wait\n73|\t// destructive command without its revalidation.\n74|\trecheck   func() error\n75|\tnow       func() time.Time\n76|\tsleep     func(time.Duration)\n77|\tpoll      time.Duration\n78|\tadmitted  terminalbackend.Admitted\n79|\tbindings  *axpane.Store\n80|\tattach    *termbind.AttachStore\n81|\tstates    *InstanceStates\n82|\ttransport string\n83|\tinput     bool\n84|\tauthRaw   []byte\n85|\tclientID  string\n86|\t// killExit records the stale-kill exit for the close re-confirm:\n87|\t// a live session after a clean kill and a live session after a\n88|\t// failed kill refuse through the same arm, and the recorded exit\n89|\t// is the member split the narrowing mutant admits exactly one of.\n90|\t// -1 means no kill ran yet on this backend.\n91|\tkillExit int\n92|}\n93|\n94|// effectEvidence derives one evidence digest over the canonical effect\n95|// record: effect name, operation, instance, and outcome facts. The join\n96|// is deterministic; nothing parses it back.\n97|func effectEvidence(effect terminalbackend.SideEffect, operation terminalbackend.Operation, instance string, facts ...string) string {\n98|\trecord := strings.Join(append([]string{string(effect), string(operation), instance}, facts...), \"\\n\")\n99|\treturn scalar.SHA256Digest([]byte(record)).String()\n100|}\n101|\n102|// PerformEffect executes one side effect and reports its evidence ID.\n103|// A nil error proves the commit; a coded error proves the backend\n104|// refused before committing; any other error proves nothing. Every\n105|// tmux command runs through BuildCommand, so no effect addresses any\n106|// server but the derived socket.\n107|func (runner *backend) PerformEffect(ctx context.Context, effect terminalbackend.SideEffect) (string, error) {\n108|\tswitch effect {\n109|\tcase terminalbackend.EffectBindingPersisted:\n110|\t\treturn runner.persistBinding()\n111|\tcase terminalbackend.EffectWrapperStarted:\n112|\t\treturn runner.startWrapper(ctx, terminalbackend.EffectWrapperStarted)\n113|\tcase terminalbackend.EffectAttachClientCreated:\n114|\t\treturn runner.createAttachClient()\n115|\tcase terminalbackend.EffectInputClosed:\n116|\t\treturn runner.closeInput(ctx)\n117|\tcase terminalbackend.EffectSafeBoundaryObserved:\n118|\t\treturn runner.observeBoundary()\n119|\tcase terminalbackend.EffectGracefulStopRequested:\n120|\t\treturn runner.execEvidence(ctx, DirectiveSendInterrupt, terminalbackend.EffectGracefulStopRequested)\n121|\tcase terminalbackend.EffectProcessClosed:\n122|\t\treturn runner.confirmClosed(ctx)\n123|\tcase terminalbackend.EffectBackendStoreClosed:\n124|\t\treturn effectEvidence(effect, runner.operation, runner.instanceID, \"tmux-side closes done\"), nil\n125|\tcase terminalbackend.EffectStaleIncarnationTerminated:\n126|\t\treturn runner.terminateStale(ctx)\n127|\tcase terminalbackend.EffectWrapperRestored:\n128|\t\treturn runner.startWrapper(ctx, terminalbackend.EffectWrapperRestored)\n129|\tdefault:\n130|\t\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend effect vocabulary\"}\n131|\t}\n132|}\n133|\n134|// persistBinding records the bootstrap binding for the create/restore\n135|// pair. A changed operation in the bootstrap window refuses the landed\n136|// idempotency_mismatch; an identical retry replays the one receipt.\n137|// On create the carried binding document is kept alongside the\n138|// receipt, so restore can return the required binding without\n139|// minting; a replayed receipt heals a missing document from the same\n140|// carried bytes, closing the crash window between receipt and\n141|// document.\n142|func (runner *backend) persistBinding() (string, error) {\n143|\tif runner.bindings == nil {\n144|\t\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend binding store\"}\n145|\t}\n146|\trecorded, replayed, err := runner.bindings.Bind(runner.sessionID, runner.bootstrapID, axpane.Binding{\n147|\t\tSessionID:          runner.sessionID,\n148|\t\tOperationID:        runner.bootstrapID,\n149|\t\tTerminalInstanceID: runner.instanceID,\n150|\t\tBindingDigest:      runner.bindingID,\n151|\t})\n152|\tif err != nil {\n153|\t\tif code := backendErrorCode(err); code != \"\" {\n154|\t\t\treturn \"\", &terminstance.Error{Code: code, Detail: \"backend binding conflict\"}\n155|\t\t}\n156|\t\treturn \"\", err\n157|\t}\n158|\tif len(runner.bindingDoc) > 0 && runner.states != nil {\n159|\t\tif !replayed {\n160|\t\t\tif err := runner.states.RecordBindingDoc(runner.sessionID, runner.bootstrapID, runner.bindingDoc); err != nil {\n161|\t\t\t\treturn \"\", err\n162|\t\t\t}\n163|\t\t} else if _, found, err := runner.states.LookupBindingDoc(runner.sessionID, runner.bootstrapID); err != nil {\n164|\t\t\treturn \"\", err\n165|\t\t} else if !found {\n166|\t\t\tif err := runner.states.RecordBindingDoc(runner.sessionID, runner.bootstrapID, runner.bindingDoc); err != nil {\n167|\t\t\t\treturn \"\", err\n168|\t\t\t}\n169|\t\t}\n170|\t}\n171|\treturn recorded.BindingDigest, nil\n172|}\n173|\n174|// closeInput cuts operator input to the instance: lock-session first,\n175|// so attached clients cannot type into the pane during the detach\n176|// window, then detach-client -s, which detaches every client\n177|// currently attached to the session. A locked session does not lock\n178|// subsequently attaching clients (verified on tmux 3.6a), so new\n179|// input-authorized attaches are refused AX-side at the attach entry\n180|// once the quiescing state records; read-only attaches stay admitted\n181|// because quiesce retains observation. Provider input enters only\n182|// through the request-stop effect (the ordered next step), so no\n183|// send-keys runs here. Both commands must exit clean; the evidence\n184|// binds both exits. The detach is a second destructive command after\n185|// the lock's round trip, so the boundary between them revalidates\n186|// the authorization facts the engine checked before the effect: a\n187|// generation rotated, authorization lapsed, or deadline passed\n188|// during the lock refuses before the detach issues.\n189|func (runner *backend) closeInput(ctx context.Context) (string, error) {\n190|\tfor i, directive := range []Directive{DirectiveLockSession, DirectiveDetachClients} {\n191|\t\tif i > 0 {\n192|\t\t\tif err := runner.recheckPostWait(); err != nil {\n193|\t\t\t\treturn \"\", err\n194|\t\t\t}\n195|\t\t}\n196|\t\targv, err := runner.command(directive)\n197|\t\tif err != nil {\n198|\t\t\treturn \"\", err\n199|\t\t}\n200|\t\tresult, err := runner.runner.Run(ctx, argv)\n201|\t\tif err != nil {\n202|\t\t\treturn \"\", err\n203|\t\t}\n204|\t\tif result.ExitCode != 0 {\n205|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n206|\t\t}\n207|\t}\n208|\treturn effectEvidence(terminalbackend.EffectInputClosed, runner.operation, runner.instanceID, \"locked\", \"detached\"), nil\n209|}\n210|\n211|// recheckPostWait runs the entry-configured authorization\n212|// revalidation at a destructive command boundary that follows a\n213|// wait. A missing revalidation refuses: the boundary never runs\n214|// blind.\n215|func (runner *backend) recheckPostWait() error {\n216|\tif runner.recheck == nil {\n217|\t\treturn &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend authorization recheck\"}\n218|\t}\n219|\treturn runner.recheck()\n220|}\n221|\n222|// startWrapper execs the instance new-session vector for create\n223|// (wrapper_started) and restore (wrapper_restored).\n224|func (runner *backend) startWrapper(ctx context.Context, effect terminalbackend.SideEffect) (string, error) {\n225|\treturn runner.execEvidence(ctx, DirectiveNewSession, effect)\n226|}\n227|\n228|// createAttachClient records the presentation client receipt for one\n229|// (instance, client) pair. Every call requires the valid unexpired\n230|// attach authorization the attach handler already admitted; the store\n231|// rechecks it, so a timeout creates no authorized input unless the\n232|// durable receipt says so.\n233|func (runner *backend) createAttachClient() (string, error) {\n234|\tif runner.attach == nil {\n235|\t\treturn \"\", &terminstance.Error{Code: terminalbackend.CodeProtocolError, Detail: \"backend attach store\"}\n236|\t}\n237|\treceipt, _, err := runner.attach.Attach(runner.sessionID, runner.instanceID, runner.clientID, runner.transport, runner.input, runner.authRaw, runner.now())\n238|\tif err != nil {\n239|\t\tif code := backendErrorCode(err); code != \"\" {\n240|\t\t\treturn \"\", &terminstance.Error{Code: code, Detail: \"backend attach conflict\"}\n241|\t\t}\n242|\t\treturn \"\", err\n243|\t}\n244|\treturn effectEvidence(terminalbackend.EffectAttachClientCreated, runner.operation, runner.instanceID, receipt.ClientID, receipt.Transport), nil\n245|}\n246|\n247|// execEvidence runs one directive and evidences its success. A nonzero\n248|// exit is a coded process failure: the command ran and the effect did\n249|// not commit. A transport error is uncoded: it proves nothing.\n250|func (runner *backend) execEvidence(ctx context.Context, directive Directive, effect terminalbackend.SideEffect) (string, error) {\n251|\targv, err := runner.command(directive)\n252|\tif err != nil {\n253|\t\treturn \"\", err\n254|\t}\n255|\tresult, err := runner.runner.Run(ctx, argv)\n256|\tif err != nil {\n257|\t\treturn \"\", err\n258|\t}\n259|\tif result.ExitCode != 0 {\n260|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n261|\t}\n262|\treturn effectEvidence(effect, runner.operation, runner.instanceID, strconv.Itoa(result.ExitCode)), nil\n263|}\n264|\n265|// observeBoundary waits for the wrapper's safe-boundary signal on the\n266|// quiescence channel with the bare blocking `wait-for` vector. The\n267|// wait context already bounds the lesser of the request deadline and\n268|// the timeout; its expiry is the coded quiesce_timeout proving\n269|// non-commit, never a silent continue. The requested provider proof\n270|// kind is bound into the evidence, so each kind proves its own\n271|// boundary and an identical retry replays the same proof. For\n272|// provider proof kinds the contemporaneous provider rows are bound\n273|// alongside: the signal is the proof, the rows are audit context,\n274|// and a failed row read binds its negative instead of failing the\n275|// observed proof.\n276|func (runner *backend) observeBoundary() (string, error) {\n277|\targv, err := runner.command(DirectiveWaitBoundary)\n278|\tif err != nil {\n279|\t\treturn \"\", err\n280|\t}\n281|\tresult, err := runner.runner.Run(runner.waitCtx, argv)\n282|\tif err != nil {\n283|\t\tif runner.waitCtx.Err() != nil {\n284|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeQuiesceTimeout, Detail: \"backend boundary wait\"}\n285|\t\t}\n286|\t\treturn \"\", err\n287|\t}\n288|\tif result.ExitCode != 0 {\n289|\t\tif runner.waitCtx.Err() != nil {\n290|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeQuiesceTimeout, Detail: \"backend boundary wait\"}\n291|\t\t}\n292|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n293|\t}\n294|\tobserved, err := runner.now().UTC().MarshalText()\n295|\tif err != nil {\n296|\t\treturn \"\", err\n297|\t}\n298|\tfacts := []string{string(runner.proofKind), runner.channel, string(observed)}\n299|\tif terminstance.RequiresProviderObservation(runner.proofKind) {\n300|\t\tfacts = append(facts, runner.boundaryProviderRows())\n301|\t}\n302|\treturn effectEvidence(terminalbackend.EffectSafeBoundaryObserved, runner.operation, runner.instanceID, facts...), nil\n303|}\n304|\n305|// boundaryProviderRows reads the contemporaneous provider rows for a\n306|// provider-kind boundary as bound context. Presence binds the row\n307|// set; absence binds the negative; a failed read binds unknown. The\n308|// verdict never fails: the wrapper signal already proved the\n309|// boundary, and a post-signal crash must not discard that proof.\n310|func (runner *backend) boundaryProviderRows() string {\n311|\tctx := runner.waitCtx\n312|\tif ctx == nil {\n313|\t\tctx = context.Background()\n314|\t}\n315|\tpresent, rows, err := runner.probePanes(ctx, runner.instanceID)\n316|\tif err != nil {\n317|\t\treturn \"provider:unknown\"\n318|\t}\n319|\tif !present {\n320|\t\treturn \"provider:absent\"\n321|\t}\n322|\treturn \"provider:\" + strings.Join(rows, \"\\n\")\n323|}\n324|\n325|// Absence stderr markers, verified against tmux 3.6a. has-session\n326|// against a missing session reports `can't find session`; list-panes\n327|// against a missing target reports `can't find window`; either\n328|// command against a missing server socket reports `error connecting\n329|// to <socket> (No such file or directory)`. Under a derived and\n330|// custody-verified socket, a missing socket proves no listener and\n331|// therefore no session. Every tmux failure exits 1, so the exit code\n332|// alone proves nothing: only these marker-paired exits prove\n333|// absence. Unrecognized stderr — permission failures, refused\n334|// connections, version-drifted strings — fails closed to unknown.\n335|const (\n336|\tabsentMarkerNoSession = \"can't find session\"\n337|\tabsentMarkerNoWindow  = \"can't find window\"\n338|\tabsentMarkerNoSocket  = \"No such file or directory\"\n339|\tabsentMarkerNoConnect = \"error connecting to\"\n340|)\n341|\n342|// errProbeUnknown is the uncoded unknown-probe signal: the probe ran\n343|// (or never answered) without proving presence or absence. Callers\n344|// return it verbatim; the engine and the lifecycle effect loop map\n345|// uncoded backend failures to the row-allowed process failure with\n346|// status_first and the unavailable observation, never to a verdict.\n347|var errProbeUnknown = errors.New(\"tmux probe proves neither presence nor absence\")\n348|\n349|// classifyAbsence sorts one probe run into present, absent, or\n350|// unknown. Exit 0 is present. A negative exit (a killed child that a\n351|// runner reported as data) is unknown, never absent. A positive exit\n352|// proves absence only with an absence marker on stderr; without one\n353|// it is unknown. Callers pass the markers their command emits.\n354|func classifyAbsence(result RunResult, markers ...string) (present, absent bool) {\n355|\tif result.ExitCode == 0 {\n356|\t\treturn true, false\n357|\t}\n358|\tif result.ExitCode < 0 {\n359|\t\treturn false, false\n360|\t}\n361|\tstderr := string(result.Stderr)\n362|\tfor _, marker := range markers {\n363|\t\tif marker == absentMarkerNoSocket {\n364|\t\t\tif strings.Contains(stderr, absentMarkerNoConnect) && strings.Contains(stderr, absentMarkerNoSocket) {\n365|\t\t\t\treturn false, true\n366|\t\t\t}\n367|\t\t\tcontinue\n368|\t\t}\n369|\t\tif strings.Contains(stderr, marker) {\n370|\t\t\treturn false, true\n371|\t\t}\n372|\t}\n373|\treturn false, false\n374|}\n375|\n376|// confirmClosed proves process closure for request-stop and\n377|// terminate-stale. Positively observed absence (has-session exit with\n378|// the no-session marker, or no server socket under the verified\n379|// path) is the proof. A live session on request-stop escalates once\n380|// to kill-session and re-confirms; a still-live session is the coded\n381|// stop_timeout. An unproven session — transport failure, killed\n382|// probe, or unmarked nonzero exit — is unknown at the deadline, never\n383|// closure. A live session on terminate-stale is the coded process\n384|// failure: the kill claimed the incarnation and it still answers.\n385|// The confirm polls to the deadline before it concludes anything.\n386|//\n387|// The stop escalation is a new destructive command after the poll\n388|// wait, so the poll bound (the graceful wait) expiring is exactly\n389|// when the other authorization facts must be re-proved: the\n390|// escalation revalidates the operation deadline, the AX\n391|// authorization over the current lease, and the server generation\n392|// before the kill issues. A graceful timeout escalates — the wait\n393|// did its job — but an operation deadline passed, an authorization\n394|// lapsed, or a generation rotated during the poll refuses without\n395|// issuing the kill. The terminate-stale tail issues no command\n396|// after its poll, so it carries no revalidation: its refusal\n397|// stands however the facts moved.\n398|func (runner *backend) confirmClosed(ctx context.Context) (string, error) {\n399|\tabsent, err := runner.pollSession(ctx)\n400|\tif err != nil {\n401|\t\treturn \"\", err\n402|\t}\n403|\tif absent {\n404|\t\treturn effectEvidence(terminalbackend.EffectProcessClosed, runner.operation, runner.instanceID, \"absent\"), nil\n405|\t}\n406|\tif runner.operation == terminalbackend.OperationRequestStop {\n407|\t\tif err := runner.recheckPostWait(); err != nil {\n408|\t\t\treturn \"\", err\n409|\t\t}\n410|\t\targv, err := runner.command(DirectiveKillSession)\n411|\t\tif err != nil {\n412|\t\t\treturn \"\", err\n413|\t\t}\n414|\t\tif result, err := runner.runner.Run(ctx, argv); err != nil {\n415|\t\t\treturn \"\", err\n416|\t\t} else if result.ExitCode != 0 {\n417|\t\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n418|\t\t}\n419|\t\tabsent, err := runner.pollSession(ctx)\n420|\t\tif err != nil {\n421|\t\t\treturn \"\", err\n422|\t\t}\n423|\t\tif absent {\n424|\t\t\treturn effectEvidence(terminalbackend.EffectProcessClosed, runner.operation, runner.instanceID, \"escalated\"), nil\n425|\t\t}\n426|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeStopTimeout, Detail: \"backend stop wait\"}\n427|\t}\n428|\t// Terminate-stale re-confirm: a live session refuses whether the kill\n429|\t// exited clean or failed — the kill claimed the incarnation and it\n430|\t// still answers. The exit split names both members so each refuses\n431|\t// explicitly; the narrowing mutant admits exactly the failed-kill\n432|\t// member.\n433|\tif runner.killExit != 0 {\n434|\t\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n435|\t}\n436|\treturn \"\", &terminstance.Error{Code: terminstance.CodeProcessFailed, Detail: \"backend effect refused\"}\n437|}\n438|\n439|// probeContext bounds one read-only probe by an absolute deadline:\n440|// the duration from the backend clock to the deadline, enforced as\n441|// a real-time context timeout, so a blocked probe returns at the\n442|// bound even when the clock never advances. Duration-based, like\n443|// the barrier waitUntil contract: fake-clock deadlines bound real\n444|// waits. A zero deadline (paths with no poll contract) or a nil\n445|// clock leaves the caller's context unmodified. Callers treat\n446|// bound expiry as unknown — a timed-out probe proves neither\n447|// presence nor absence — never as a verdict.\n448|func probeContext(ctx context.Context, now func() time.Time, deadline time.Time) (context.Context, context.CancelFunc) {\n449|\tif ctx == nil {\n450|\t\tctx = context.Background()\n451|\t}\n452|\tif now == nil || deadline.IsZero() {\n453|\t\treturn ctx, func() {}\n454|\t}\n455|\treturn context.WithTimeout(ctx, deadline.Sub(now()))\n456|}\n457|\n458|// pollSession probes has-session until the session is absent or the\n459|// deadline passes. Presence polls on; absence returns at once; an\n460|// unproven probe (transport failure, killed child, unmarked exit,\n461|// or a probe still blocked when the bound fires) polls on until\n462|// the deadline and then reports unknown, never closure. The bound\n463|// cancels the in-flight probe itself, not just the loop around it:\n464|// clock checks after Run cannot cancel a Run that has not\n465|// returned. Answered probes follow the clock exactly as before;\n466|// only a probe that never answered concludes by the context.\n467|// Cancellation aborts at once.\n468|func (runner *backend) pollSession(ctx context.Context) (bool, error) {\n469|\tpollCtx, cancel := probeContext(ctx, runner.now, runner.deadline)\n470|\tdefer cancel()\n471|\tfor {\n472|\t\tif ctx != nil && ctx.Err() != nil {\n473|\t\t\treturn false, ctx.Err()\n474|\t\t}\n475|\t\targv, err := runner.command(DirectiveHasSession)\n476|\t\tif err != nil {\n477|\t\t\treturn false, err\n478|\t\t}\n479|\t\tresult, err := runner.runner.Run(pollCtx, argv)\n480|\t\tif err != nil {\n481|\t\t\tif ctx != nil && ctx.Err() != nil {\n482|\t\t\t\treturn false, ctx.Err()\n483|\t\t\t}\n484|\t\t\tif pollCtx.Err() != nil || !runner.now().Before(runner.deadline) {\n485|\t\t\t\treturn false, errProbeUnknown\n486|\t\t\t}\n487|\t\t\trunner.sleep(runner.poll)\n488|\t\t\tcontinue\n489|\t\t}\n490|\t\tpresent, absent := classifyAbsence(result, absentMarkerNoSession, absentMarkerNoSocket)\n491|\t\tif absent {\n492|\t\t\treturn true, nil\n493|\t\t}\n494|\t\tif !present {\n495|\t\t\tif !runner.now().Before(runner.deadline) {\n496|\t\t\t\treturn false, errProbeUnknown\n497|\t\t\t}\n498|\t\t\trunner.sleep(runner.poll)\n499|\t\t\tcontinue\n500|\t\t}\n(more lines below)","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
