{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000d0b1","stream":{"kind":"session","id":"01a0ca08-6c63-7352-b762-5bc242c771c8"},"sequence":1715,"recorded_at":1780531400003425,"record_type":"event","durability":"durable","causation_id":"cd8feb9b-6d69-49ce-a85c-818ca818e251","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cd8feb9b-6d69-49ce-a85c-818ca818e251","run_stream":{"kind":"run","id":"cd8feb9b-6d69-49ce-a85c-818ca818e251"},"task_stream":{"kind":"task","id":"01a0ca13-ee0c-72d0-b542-5912d793ff36"},"task_id":"01a0ca13-ee0c-72d0-b542-5912d793ff36","event":{"kind":"output","task_id":"01a0ca13-ee0c-72d0-b542-5912d793ff36","chunk":"edited\nchanged lines: lines 478-487\n--- original\n+++ updated\n@@\n-    Mutant(\n-        name=\"N-attach-peers-dir\",\n-        path=f\"{PACKAGE}/overlap.go\",\n-        find='\\t\\tif entry.IsDir() {\\n\\t\\t\\treturn nil, fmt.Errorf(\"attach peer %q is not a receipt file\", name)\\n\\t\\t}\\n',\n-        replace='\\t\\tif entry.IsDir() {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n',\n-        count=1,\n-        run=\"TestAttachStorePeersDirectoryFailsClosed\",\n-        expect=\"KILLED\",\n-        note=\"Admits exactly receipt-namespace directories past the census shape arm as skips (a directory at a receipt name reads as no peer); undecodable files and foreign receipts still error, staging and non-receipt entries still skip. Kill path: the peer scan passes over the receipt directory instead of refusing the census.\",\n-    ),\n+    Mutant(\n+        name=\"N-attach-peers-dir\",\n+        path=f\"{PACKAGE}/overlap.go\",\n+        find='\\t\\tif entry.IsDir() {\\n\\t\\t\\treturn nil, fmt.Errorf(\"attach peer %q is not a receipt file\", name)\\n\\t\\t}\\n',\n+        replace='\\t\\tif entry.IsDir() {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n',\n+        count=1,\n+        run=\"TestAttachStorePeersDirectoryFailsClosed\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly receipt-namespace directories past the census shape arm as skips (a directory at a receipt name reads as no peer); undecodable files and foreign receipts still error, staging and non-receipt entries still skip. Kill path: the peer scan passes over the receipt directory instead of refusing the census.\",\n+    ),\n+    Mutant(\n+        name=\"N-attach-peers-filename\",\n+        path=f\"{PACKAGE}/overlap.go\",\n+        find='\\t\\tkeyed, found, err := store.Lookup(sessionID, instanceID, stem)\\n\\t\\tif err != nil {\\n\\t\\t\\treturn nil, err\\n\\t\\t}\\n',\n+        replace='\\t\\tkeyed, found, err := store.Lookup(sessionID, instanceID, stem)\\n\\t\\tif err != nil {\\n\\t\\t\\tcontinue\\n\\t\\t}\\n',\n+        count=1,\n+        run=\"TestAttachStorePeersRejectsFilenameMismatch\",\n+        expect=\"KILLED\",\n+        note=\"Admits exactly the key-binding-failed peer past the census filename arm as a skip (a valid receipt misfiled under another client's name reads as no peer); undecodable files, foreign receipts, directories, and malformed stems still error, staging and non-receipt entries still skip. Kill path: the peer scan passes over the misfiled receipt instead of refusing the census.\",\n+    ),\n","final_result":true}}}
