ation-generation\\\": ([STOP, QUIESCE], []),\\n    \\\"N-stop-escalation-expiry\\\": ([STOP, QUIESCE], []),\\n    \\\"N-stop-escalation-deadline\\\": ([STOP, QUIESCE], []),\\n    \\\"N-attach-wait-deadline\\\": (\\n        [\\n            \\\"TestAttachWaitBoundedByOperationDeadline\\\",\\n            \\\"TestQuiesceBarrierWaitBoundedByOperationDeadline\\\",\\n            \\\"TestBoundaryCommitWaitBoundedByOperationDeadline\\\",\\n        ],\\n        [\\\"TestAttachWaitCancelledReturnsPromptly\\\"],\\n    ),\\n    \\\"N-probe-deadline\\\": (\\n        [\\n            \\\"TestExecuteStopPollHonorsOperationDeadline\\\",\\n            \\\"TestExecuteTerminateConfirmHonorsOperationDeadline\\\",\\n            \\\"TestExecuteStatusProbeHonorsOperationDeadline\\\",\\n        ],\\n        [],\\n    ),\\n}\\n\\nMUTANTS = {m.name: m for m in H.MUTANTS}\\n\\n\\ndef run_single(test, log_path):\\n    run = subprocess.run(\\n        [\\\"go\\\", \\\"test\\\", \\\"./internal/tmuxserver/\\\", \\\"-run\\\", f\\\"^{test}$\\\",\\n         \\\"-count=1\\\", \\\"-v\\\"],\\n        cwd=H.REPO,\\n=== new-row pass1 logs:\\nN-attach-peers-filename-skip.log\\nN-stop-escalation-budget.log\\n\\nexit: 1\\nrun: go test ./internal/tmuxserver/ -run TestExecuteStopEscalationSucceedsWithContextHonoringRunner -count=1\\n\\n--- FAIL: TestExecuteStopEscalationSucceedsWithContextHonoringRunner (0.02s)\\n    lifecycle_rev10_unix_test.go:109: terminal instance refused: terminal_backend_process_failed at backend effect uncertain\\nFAIL\\nFAIL\\tgithub.com/relux-works/agent-session-manager/internal/tmuxserver\\t0.323s\\nFAIL\\n\",\n  \"original_output_bytes\": 2150,\n  \"original_output_tokens\": 538,\n  \"truncated\": false\n}","final_result":true}}}
