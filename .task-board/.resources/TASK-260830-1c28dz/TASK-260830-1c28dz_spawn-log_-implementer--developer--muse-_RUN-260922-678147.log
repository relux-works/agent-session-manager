alidation failure is an error, never absence: unknown is not absent.\n168|func (store *AttachStore) Lookup(sessionID, instanceID, clientID string) (AttachReceipt, bool, error) {\n169|\tempty := AttachReceipt{}\n170|\tif _, err := scalar.ParseUUIDv7(sessionID); err != nil {\n171|\t\treturn empty, false, fmt.Errorf(\"attach lookup session %q is not a UUIDv7: %w\", sessionID, err)\n172|\t}\n173|\tif err := CheckInstanceIdentity(instanceID); err != nil {\n174|\t\treturn empty, false, err\n175|\t}\n176|\tif err := CheckInstanceIdentity(clientID); err != nil {\n177|\t\treturn empty, false, err\n178|\t}\n179|\traw, err := os.ReadFile(store.receiptPath(instanceID, clientID))\n180|\tif err != nil {\n181|\t\tif errors.Is(err, os.ErrNotExist) {\n182|\t\t\treturn empty, false, nil\n183|\t\t}\n184|\t\treturn empty, false, fmt.Errorf(\"read attach receipt: %w\", err)\n185|\t}\n186|\treceipt, err := decodeAttachReceipt(raw)\n187|\tif err != nil {\n188|\t\treturn empty, false, err\n189|\t}\n190|\tif receipt.SessionID != sessionID {\n191|\t\treturn empty, false, errors.New(\"attach receipt names another session\")\n192|\t}\n193|\tif receipt.TerminalInstanceID != instanceID || receipt.ClientID != clientID {\n194|\t\treturn empty, false, errors.New(\"attach receipt names another client pair\")\n195|\t}\n196|\treturn receipt, true, nil\n197|}\n198|\n199|// install stages the receipt to a same-directory temporary file, fsyncs\n200|// it, atomically links it to the receipt path (which must not exist: the\n201|// link is the no-replace commit), removes the staging name, and fsyncs the\n202|// directory. A concurrent same-pair commit wins and the loser converges to\n203|// the winner: an identical retry replays it, a conflicting retry refuses\n204|// idempotency_mismatch. Stale staging files from a pre-commit crash are\n205|// swept before the install.\n206|func (store *AttachStore) install(sessionID, instanceID, clientID, transport string, inputAuthorized bool, receipt []byte) (AttachRece