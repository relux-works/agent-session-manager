n    \\\"Ratio: 267 measured of 5536 (50+10+207 M across Tables A/B/D;\\\\nTable C all U); 191 bound; 5078 unreachable with reasons.\\\",\\n    'ratio')\\nrep(\\\"159 named undriven gaps (B24/B25/B26/B28/B31 cells\\\\nand the 152 B39 reachable-undriven cells)\\\",\\n    \\\"160 named undriven gaps (B24/B25/B26/B28/B31 cells\\\\nand the 153 B39 reachable-undriven cells)\\\",\\n    'boundsplit')\\nopen(p, 'w').write(t)\\nprint('census updated')\\nEOF\\npython3 /tmp/rev9prod/evidence/count_census.py internal/tmuxserver/TRACEABILITY.md\",\n  \"description\": \"Update census tables and recount\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"census updated\\nTable A: rows=24 cells=264 M=50 B=4 U=210 ?=0 bad=0\\nTable B: rows=24 cells=504 M=10 B=0 U=494 ?=0 bad=0\\nTable D: rows=149 cells=3129 M=207 B=187 U=2735 ?=0 bad=0\\n\",\n  \"original_output_bytes\": 177,\n  \"original_output_tokens\": 45,\n  \"truncated\": false\n}","correlation_facts":{"tool_name":"bash","outcome":"success"}}}
