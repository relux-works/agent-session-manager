{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000df57","stream":{"kind":"session","id":"01a0ca08-6c63-7352-b762-5bc242c771c8"},"sequence":3590,"recorded_at":1780531400007175,"record_type":"event","durability":"durable","causation_id":"cd8feb9b-6d69-49ce-a85c-818ca818e251","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cd8feb9b-6d69-49ce-a85c-818ca818e251","run_stream":{"kind":"run","id":"cd8feb9b-6d69-49ce-a85c-818ca818e251"},"task_stream":{"kind":"task","id":"01a0ca2b-7921-7093-ad0a-f40dc91bc9e8"},"task_id":"01a0ca2b-7921-7093-ad0a-f40dc91bc9e8","event":{"kind":"output","task_id":"01a0ca2b-7921-7093-ad0a-f40dc91bc9e8","chunk":"{\n  \"chunk_id\": \"exec-108-1\",\n  \"command\": \"cd /tmp/p2b && python3 - <<'EOF'\\nimport json\\nfrom collections import Counter\\ndef grid(path):\\n    v = {}\\n    for line in open(path):\\n        line = line.strip()\\n        if not line: continue\\n        try: e = json.loads(line)\\n        except: continue\\n        if e.get('Action') not in ('pass','fail','skip'): continue\\n        t = e.get('Test','')\\n        if not t or '/' in t: continue\\n        v[(e.get('Package'), t)] = e['Action']\\n    return v\\nbase, cand = grid('ev10/base-suite.json'), grid('ev10/candidate-suite.json')\\nconly = [k for k in cand if k not in base]\\nprint('cand-only by package:', Counter(k[0].split('/internal/')[-1] for k in conly))\\nprint('cand-only verdicts:', Counter(cand[k] for k in conly))\\nmoved = [(k, base[k], cand[k]) for k in base if k in cand and base[k] != cand[k]]\\nprint('moved:', moved)\\nbaseonly = [k for k in base if k not in cand]\\nprint('base-only:', baseonly)\\n# skips on either side\\nprint('base skips:', sum(1 for k in base if base[k]=='skip'), 'cand skips:', sum(1 for k in cand if cand[k]=='skip'))\\nEOF\",\n  \"description\": \"Detail suite grid diff\",\n  \"exit_code\": 0,\n  \"terminal_status\": \"completed\",\n  \"output\": \"cand-only by package: Counter({'tmuxserver': 308, 'termbind': 11})\\ncand-only verdicts: Counter({'pass': 319})\\nmoved: []\\nbase-only: []\\nbase skips: 2 cand skips: 2\\n\",\n  \"original_output_bytes\": 162,\n  \"original_output_tokens\": 41,\n  \"truncated\": false\n}","final_result":true}}}
