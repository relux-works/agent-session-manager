{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000c779","stream":{"kind":"session","id":"01a0ca08-6c63-7352-b762-5bc242c771c8"},"sequence":535,"recorded_at":1780531400001065,"record_type":"event","durability":"durable","causation_id":"cd8feb9b-6d69-49ce-a85c-818ca818e251","payload_type":"tool.result","payload_schema_version":1,"payload":{"kind":"tool_result","command_id":"cd8feb9b-6d69-49ce-a85c-818ca818e251","run_stream":{"kind":"run","id":"cd8feb9b-6d69-49ce-a85c-818ca818e251"},"call_id":"call_01a0ca09ac0a718992fafd54dd95bdda","text":"Read text file `/tmp/rev5ev/evidence-rev5/closuregrid/main.go`.\n1|// Command closuregrid emits fixed-corpus production-entry outcome records\n2|// for the 36-package composing closure (34 production packages plus the\n3|// two test-only closure members). One JSON object per line:\n4|//\n5|//\t{\"package\":\"...\",\"entry\":\"...\",\"input\":\"...\",\"outcome\":\"ok|error\",\n6|//\t \"code\":\"...\",\"detail\":\"...\"}\n7|//\n8|//   - outcome \"ok\": code is empty and detail summarizes the returned\n9|//     value with explicit scalar fields (never map dumps or pointers).\n10|//   - outcome \"error\": code carries the normalized error string (which\n11|//     embeds the refusal code token) and detail is empty.\n12|//\n13|// The corpus is fixed literals; no clock, no randomness, no network.\n14|// Filesystem probes use a fresh work directory whose path is normalized\n15|// to <tmp> before recording. The same driver runs against the CR base\n16|// and the candidate; the diff key is (package, entry, input) and the\n17|// value is (outcome, code, detail). Three closure members have no\n18|// exported pure callable surface (cloneproject, crashgate,\n19|// sshtransport) and are declared as bounds in the results; their\n20|// behavior stays fenced by the suite-verdict grid.\n21|package main\n22|\n23|import (\n24|\t\"crypto/sha256\"\n25|\t\"encoding/hex\"\n26|\t\"encoding/json\"\n27|\t\"errors\"\n28|\t\"fmt\"\n29|\t\"os\"\n30|\t\"path/filepath\"\n31|\t\"sort\"\n32|\t\"strings\"\n33|\n34|\t\"github.com/relux-works/agent-session-manager/internal/axerror\"\n35|\t\"github.com/relux-works/agent-session-manager/internal/axpane\"\n36|\t\"github.com/relux-works/agent-session-manager/internal/canonicaljson\"\n37|\t\"github.com/relux-works/agent-session-manager/internal/cigate\"\n38|\t\"github.com/relux-works/agent-session-manager/internal/cliresult\"\n39|\t\"github.com/relux-works/agent-session-manager/internal/clonebundle\"\n40|\t\"github.com/relux-works/agent-session-manager/internal/clonesnap\"\n41|\t\"github.com/relux-works/agent-session-manager/internal/config\"\n42|\t\"github.com/relux-works/agent-session-manager/internal/dirnode\"\n43|\t\"github.com/relux-works/agent-session-manager/internal/environ\"\n44|\t\"github.com/relux-works/agent-session-manager/internal/fencing\"\n45|\t\"github.com/relux-works/agent-session-manager/internal/hostchannel\"\n46|\t\"github.com/relux-works/agent-session-manager/internal/hosttrust\"\n47|\t\"github.com/relux-works/agent-session-manager/internal/localstore\"\n48|\t\"github.com/relux-works/agent-session-manager/internal/matjournal\"\n49|\t\"github.com/relux-works/agent-session-manager/internal/meshneg\"\n50|\t\"github.com/relux-works/agent-session-manager/internal/peeridentity\"\n51|\t\"github.com/relux-works/agent-session-manager/internal/provhost\"\n52|\t\"github.com/relux-works/agent-session-manager/internal/provider\"\n53|\t\"github.com/relux-works/agent-session-manager/internal/resumesmoke\"\n54|\t\"github.com/relux-works/agent-session-manager/internal/rpcwire\"\n55|\t\"github.com/relux-works/agent-session-manager/internal/secconftest\"\n56|\t\"github.com/relux-works/agent-session-manager/internal/secprim\"\n57|\t\"github.com/relux-works/agent-session-manager/internal/sessadapter\"\n58|\t\"github.com/relux-works/agent-session-manager/internal/sessckpt\"\n59|\t\"github.com/relux-works/agent-session-manager/internal/sessprofile\"\n60|\t\"github.com/relux-works/agent-session-manager/internal/sessquery\"\n61|\t\"github.com/relux-works/agent-session-manager/internal/sessrepo\"\n62|\t\"github.com/relux-works/agent-session-manager/internal/sessstate\"\n63|\t\"github.com/relux-works/agent-session-manager/internal/scalar\"\n64|\t\"github.com/relux-works/agent-session-manager/internal/termbind\"\n65|\t\"github.com/relux-works/agent-session-manager/internal/terminalbackend\"\n66|\t\"github.com/relux-works/agent-session-manager/internal/terminstance\"\n67|\t\"github.com/relux-works/agent-session-manager/internal/tmuxserver\"\n68|)\n69|\n70|type record struct {\n71|\tPackage string `json:\"package\"`\n72|\tEntry   string `json:\"entry\"`\n73|\tInput   string `json:\"input\"`\n74|\tOutcome string `json:\"outcome\"`\n75|\tCode    string `json:\"code\"`\n76|\tDetail  string `json:\"detail\"`\n77|}\n78|\n79|var workdir string\n80|\n81|func normalize(s string) string {\n82|\ts = strings.ReplaceAll(s, workdir, \"<tmp>\")\n83|\ts = strings.ReplaceAll(s, os.TempDir(), \"<tmp>\")\n84|\treturn s\n85|}\n86|\n87|func emit(pkg, entry, input, outcome, code, detail string) {\n88|\traw, err := json.Marshal(record{\n89|\t\tPackage: pkg, Entry: entry, Input: input,\n90|\t\tOutcome: outcome, Code: normalize(code), Detail: normalize(detail),\n91|\t})\n92|\tif err != nil {\n93|\t\tpanic(err)\n94|\t}\n95|\tfmt.Println(string(raw))\n96|}\n97|\n98|func emitErr(pkg, entry, input string, err error) {\n99|\tif err == nil {\n100|\t\temit(pkg, entry, input, \"ok\", \"\", \"nil-error\")\n101|\t\treturn\n102|\t}\n103|\temit(pkg, entry, input, \"error\", err.Error(), \"\")\n104|}\n105|\n106|func digestOf(data []byte) string {\n107|\tsum := sha256.Sum256(data)\n108|\treturn hex.EncodeToString(sum[:16])\n109|}\n110|\n111|func joinSorted(values []string) string {\n112|\tout := append([]string(nil), values...)\n113|\tsort.Strings(out)\n114|\treturn strings.Join(out, \",\")\n115|}\n116|\n117|// --- axerror ---\n118|\n119|func gridAxerror() {\n120|\tfor _, status := range []int{0, 1, 2, 99, 231} {\n121|\t\tmeaning, ok := axerror.ExitStatusMeaning(status)\n122|\t\temit(\"axerror\", \"ExitStatusMeaning\", fmt.Sprintf(\"status=%d\", status), \"ok\", \"\", fmt.Sprintf(\"%q/%v\", meaning, ok))\n123|\t\temit(\"axerror\", \"IsFailureExitStatus\", fmt.Sprintf(\"status=%d\", status), \"ok\", \"\", fmt.Sprintf(\"%v\", axerror.IsFailureExitStatus(status)))\n124|\t}\n125|}\n126|\n127|// --- axpane ---\n128|\n129|func gridAxpane() {\n130|\temit(\"axpane\", \"BindingDigest\", \"filled\", \"ok\", \"\", axpane.BindingDigest(axpane.Binding{\n131|\t\tSessionID: \"0198f4c8-8e50-7f66-8f70-111111111111\", OperationID: \"0198f4c8-8e50-7f66-8f70-333333333331\",\n132|\t\tTerminalInstanceID: \"0198f4c8-8e50-7f66-8f70-222222222221\", BindingDigest: \"sha256:aaaa\",\n133|\t}))\n134|\temit(\"axpane\", \"BindingDigest\", \"zero\", \"ok\", \"\", axpane.BindingDigest(axpane.Binding{}))\n135|\tparams := axpane.DescriptorParams{\n136|\t\tBinding:     axpane.BindingRef{BindingDigest: \"sha256:bbbb\", BackendID: \"ax.tmux\", ImplementationVersion: \"2.1.0\", ProtocolVersion: \"1.1.0\", Generation: \"generation-one\"},\n137|\t\tInstanceID:  \"0198f4c8-8e50-7f66-8f70-222222222221\",\n138|\t\tInteractive: true, Columns: 80, Rows: 24,\n139|\t}\n140|\traw, err := axpane.BuildDescriptor(params)\n141|\tif err != nil {\n142|\t\temitErr(\"axpane\", \"BuildDescriptor\", \"valid\", err)\n143|\t} else {\n144|\t\temit(\"axpane\", \"BuildDescriptor\", \"valid\", \"ok\", \"\", digestOf(raw))\n145|\t}\n146|\tbad := params\n147|\tbad.InstanceID = \"not-a-uuid\"\n148|\t_, err = axpane.BuildDescriptor(bad)\n149|\temitErr(\"axpane\", \"BuildDescriptor\", \"bad-instance\", err)\n150|\tbad = params\n151|\tbad.Binding.BackendID = \"bogus backend !!\"\n152|\t_, err = axpane.BuildDescriptor(bad)\n153|\temitErr(\"axpane\", \"BuildDescriptor\", \"bad-backend\", err)\n154|}\n155|\n156|// --- canonicaljson ---\n157|\n158|func gridCanonicaljson() {\n159|\traw, err := canonicaljson.Canonicalize([]byte(`{\"b\":2,\"a\":[3,2,1]}`))\n160|\tif err != nil {\n161|\t\temitErr(\"canonicaljson\", \"Canonicalize\", \"valid\", err)\n162|\t} else {\n163|\t\temit(\"canonicaljson\", \"Canonicalize\", \"valid\", \"ok\", \"\", string(raw))\n164|\t}\n165|\t_, err = canonicaljson.Canonicalize([]byte(`{\"a\":`))\n166|\temitErr(\"canonicaljson\", \"Canonicalize\", \"truncated\", err)\n167|\t_, err = canonicaljson.Canonicalize(nil)\n168|\temitErr(\"canonicaljson\", \"Canonicalize\", \"empty\", err)\n169|\temitErr(\"canonicaljson\", \"ValidateObservationEvent\", \"garbage\", canonicaljson.ValidateObservationEvent([]byte(`[1,2`)))\n170|\temitErr(\"canonicaljson\", \"ValidateObservationEvent\", \"empty-object\", canonicaljson.ValidateObservationEvent([]byte(`{}`)))\n171|\temitErr(\"canonicaljson\", \"ValidateObservationStream\", \"empty\", canonicaljson.ValidateObservationStream(nil))\n172|}\n173|\n174|// --- cigate ---\n175|\n176|func gridCigate() {\n177|\tids, err := cigate.CapabilityIDs()\n178|\tif err != nil {\n179|\t\temitErr(\"cigate\", \"CapabilityIDs\", \"none\", err)\n180|\t} else {\n181|\t\temit(\"cigate\", \"CapabilityIDs\", \"none\", \"ok\", \"\", joinSorted(ids))\n182|\t}\n183|\ttargets, err := cigate.FuzzTargets()\n184|\tif err != nil {\n185|\t\temitErr(\"cigate\", \"FuzzTargets\", \"none\", err)\n186|\t} else {\n187|\t\temit(\"cigate\", \"FuzzTargets\", \"none\", \"ok\", \"\", joinSorted(targets))\n188|\t}\n189|\treleases, err := cigate.PinnedReleases()\n190|\tif err != nil {\n191|\t\temitErr(\"cigate\", \"PinnedReleases\", \"none\", err)\n192|\t} else {\n193|\t\temit(\"cigate\", \"PinnedReleases\", \"none\", \"ok\", \"\", joinSorted(releases))\n194|\t}\n195|\temit(\"cigate\", \"SortedReleases\", \"fixed\", \"ok\", \"\", strings.Join(cigate.SortedReleases(map[string][]cigate.ContractVersions{\n196|\t\t\"b\": {{Name: \"c\", Versions: []string{\"1.0\"}}},\n197|\t\t\"a\": {{Name: \"c\", Versions: []string{\"1.0\"}}},\n198|\t}), \",\"))\n199|\temitErr(\"cigate\", \"VerifyContractPreservation\", \"none\", cigate.VerifyContractPreservation())\n200|}\n201|\n202|// --- cliresult ---\n203|\n204|func gridCliresult() {\n205|\temit(\"cliresult\", \"CapabilityNames\", \"none\", \"ok\", \"\", joinSorted(cliresult.CapabilityNames()))\n206|\temit(\"cliresult\", \"ContractNames\", \"none\", \"ok\", \"\", joinSorted(cliresult.ContractNames()))\n207|\tstatus, err := cliresult.ExitStatus(cliresult.Outcome{})\n208|\tif err != nil {\n209|\t\temitErr(\"cliresult\", \"ExitStatus\", \"zero\", err)\n210|\t} else {\n211|\t\temit(\"cliresult\", \"ExitStatus\", \"zero\", \"ok\", \"\", fmt.Sprintf(\"%d\", status))\n212|\t}\n213|\tstatus, err = cliresult.ExitStatus(cliresult.Outcome{Rendered: \"done\"})\n214|\tif err != nil {\n215|\t\temitErr(\"cliresult\", \"ExitStatus\", \"rendered\", err)\n216|\t} else {\n217|\t\temit(\"cliresult\", \"ExitStatus\", \"rendered\", \"ok\", \"\", fmt.Sprintf(\"%d\", status))\n218|\t}\n219|}\n220|\n221|// --- clonebundle ---\n222|\n223|func gridClonebundle() {\n224|\tdigestA, err := scalar.ParseDigest(\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\")\n225|\tif err != nil {\n226|\t\tpanic(err)\n227|\t}\n228|\tdigestB, err := scalar.ParseDigest(\"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\")\n229|\tif err != nil {\n230|\t\tpanic(err)\n231|\t}\n232|\temitErr(\"clonebundle\", \"CheckDigestsEqual\", \"equal\", clonebundle.CheckDigestsEqual(digestA, digestA))\n233|\temitErr(\"clonebundle\", \"CheckDigestsEqual\", \"different\", clonebundle.CheckDigestsEqual(digestA, digestB))\n234|\temitErr(\"clonebundle\", \"CheckOrdinalContiguity\", \"contiguous\", clonebundle.CheckOrdinalContiguity([]uint64{1, 2, 3}))\n235|\temitErr(\"clonebundle\", \"CheckOrdinalContiguity\", \"gap\", clonebundle.CheckOrdinalContiguity([]uint64{1, 3}))\n236|\temitErr(\"clonebundle\", \"CheckOrdinalContiguity\", \"empty\", clonebundle.CheckOrdinalContiguity(nil))\n237|\temit(\"clonebundle\", \"ValidCaptureClass\", \"raw\", \"ok\", \"\", fmt.Sprintf(\"%v\", clonebundle.ValidCaptureClass(\"raw\")))\n238|\temit(\"clonebundle\", \"ValidCaptureClass\", \"bogus\", \"ok\", \"\", fmt.Sprintf(\"%v\", clonebundle.ValidCaptureClass(\"bogus!!\")))\n239|\temitErr(\"clonebundle\", \"SanitizeNativeKey\", \"ok\", clonebundle.SanitizeNativeKey(\"session-1\"))\n240|\temitErr(\"clonebundle\", \"SanitizeNativeKey\", \"empty\", clonebundle.SanitizeNativeKey(\"\"))\n241|\temitErr(\"clonebundle\", \"SanitizeNativeKey\", \"slash\", clonebundle.SanitizeNativeKey(\"a/b\"))\n242|}\n243|\n244|// --- clonesnap ---\n245|\n246|func gridClonesnap() {\n247|\t_, err := clonesnap.AdmitForTarget([]byte(`{}`), \"stable\")\n248|\temitErr(\"clonesnap\", \"AdmitForTarget\", \"empty-object\", err)\n249|\t_, err = clonesnap.AdmitForTarget([]byte(`[`), \"stable\")\n250|\temitErr(\"clonesnap\", \"AdmitForTarget\", \"truncated\", err)\n251|\t_, err = clonesnap.AdmitForTarget(nil, \"bogus-profile!!\")\n252|\temitErr(\"clonesnap\", \"AdmitForTarget\", \"nil-bogus-profile\", err)\n253|\tdigestA, err := scalar.ParseDigest(\"sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\")\n254|\tif err != nil {\n255|\t\tpanic(err)\n256|\t}\n257|\tdigestB, err := scalar.ParseDigest(\"sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\")\n258|\tif err != nil {\n259|\t\tpanic(err)\n260|\t}\n261|\traw, err := clonesnap.BuildAdmissionReceipt(digestA, digestB, \"stable\")\n262|\tif err != nil {\n263|\t\temitErr(\"clonesnap\", \"BuildAdmissionReceipt\", \"stable\", err)\n264|\t} else {\n265|\t\temit(\"clonesnap\", \"BuildAdmissionReceipt\", \"stable\", \"ok\", \"\", digestOf(raw))\n266|\t}\n267|\t_, err = clonesnap.BuildAdmissionReceipt(digestA, digestB, \"\")\n268|\temitErr(\"clonesnap\", \"BuildAdmissionReceipt\", \"empty-profile\", err)\n269|}\n270|\n271|// --- config ---\n272|\n273|func gridConfig() {\n274|\traw, err := config.EncodeCurrent(config.Configuration{}, config.DecodeContext{})\n275|\tif err != nil {\n276|\t\temitErr(\"config\", \"EncodeCurrent\", \"zero\", err)\n277|\t} else {\n278|\t\temit(\"config\", \"EncodeCurrent\", \"zero\", \"ok\", \"\", digestOf(raw))\n279|\t}\n280|\traw, err = config.EncodeVersion4(config.Configuration{}, config.DecodeContext{})\n281|\tif err != nil {\n282|\t\temitErr(\"config\", \"EncodeVersion4\", \"zero\", err)\n283|\t} else {\n284|\t\temit(\"config\", \"EncodeVersion4\", \"zero\", \"ok\", \"\", digestOf(raw))\n285|\t}\n286|}\n287|\n288|// --- dirnode ---\n289|\n290|func gridDirnode() {\n291|\tfor _, version := range []string{\"1.0\", \"9.9\", \"bogus\", \"\"} {\n292|\t\tmajor, ok := dirnode.MajorForVersion(version)\n293|\t\temit(\"dirnode\", \"MajorForVersion\", fmt.Sprintf(\"version=%q\", version), \"ok\", \"\", fmt.Sprintf(\"%d/%v\", major, ok))\n294|\t}\n295|\tfor _, major := range []int{3, 1, 0, -1} {\n296|\t\tlower, ok := dirnode.NextLowerMajor(major)\n297|\t\temit(\"dirnode\", \"NextLowerMajor\", fmt.Sprintf(\"major=%d\", major), \"ok\", \"\", fmt.Sprintf(\"%d/%v\", lower, ok))\n298|\t}\n299|\temit(\"dirnode\", \"AvailableCapabilities\", \"zero\", \"ok\", \"\", joinSorted(dirnode.AvailableCapabilities(dirnode.Manifest{})))\n300|\temitErr(\"dirnode\", \"CheckCursorReuse\", \"fresh\", dirnode.CheckCursorReuse(\"cursor-1\", false))\n301|\temitErr(\"dirnode\", \"CheckCursorReuse\", \"reuse-bounds-changed\", dirnode.CheckCursorReuse(\"cursor-1\", true))\n302|\temitErr(\"dirnode\", \"CheckCursorReuse\", \"empty\", dirnode.CheckCursorReuse(\"\", false))\n303|}\n304|\n305|// --- environ ---\n306|\n307|func gridEnviron() {\n308|\tfor _, value := range []string{\"production\", \"bogus env!!\", \"\"} {\n309|\t\temit(\"environ\", \"CheckEnvironmentID\", fmt.Sprintf(\"value=%q\", value), \"ok\", \"\", fmt.Sprintf(\"%v\", environ.CheckEnvironmentID(value)))\n310|\t}\n311|\tfor _, value := range []string{\"1.2.3\", \"1.2\", \"bogus\"} {\n312|\t\temit(\"environ\", \"CheckSemver\", fmt.Sprintf(\"value=%q\", value), \"ok\", \"\", fmt.Sprintf(\"%v\", environ.CheckSemver(value)))\n313|\t}\n314|\temit(\"environ\", \"StringLength\", \"empty\", \"ok\", \"\", fmt.Sprintf(\"%d\", environ.StringLength(\"\")))\n315|\temit(\"environ\", \"StringLength\", \"abc\", \"ok\", \"\", fmt.Sprintf(\"%d\", environ.StringLength(\"abc\")))\n316|\temit(\"environ\", \"HasLoneSurrogateEscape\", \"clean\", \"ok\", \"\", fmt.Sprintf(\"%v\", environ.HasLoneSurrogateEscape([]byte(`{\"a\":\"b\"}`))))\n317|\temit(\"environ\", \"HasLoneSurrogateEscape\", \"lone\", \"ok\", \"\", fmt.Sprintf(\"%v\", environ.HasLoneSurrogateEscape([]byte(`{\"a\":\"\\ud800\"}`))))\n318|}\n319|\n320|// --- fencing ---\n321|\n322|func gridFencing() {\n323|\tfor _, tc := range []struct {\n324|\t\tname      string\n325|\t\thasWinner bool\n326|\t\tforce     bool\n327|\t\tpreserved bool\n328|\t}{\n329|\t\t{\"no-winner\", false, false, false},\n330|\t\t{\"winner\", true, false, false},\n331|\t\t{\"winner-force\", true, true, false},\n332|\t\t{\"winner-preserved\", true, false, true},\n333|\t} {\n334|\t\temitErr(\"fencing\", \"AuthorizeTerminateStale\", tc.name, fencing.AuthorizeTerminateStale(\n335|\t\t\tfencing.PresentedToken{}, sessrepo.LeaseSummary{}, tc.hasWinner, tc.force, tc.preserved))\n336|\t}\n337|\tstale, decided := fencing.StaleRelativeToWinner(fencing.PresentedToken{}, fencing.Observation{})\n338|\temit(\"fencing\", \"StaleRelativeToWinner\", \"zero\", \"ok\", \"\", fmt.Sprintf(\"%v/%v\", stale, decided))\n339|\temit(\"fencing\", \"IsParked\", \"nil\", \"ok\", \"\", fmt.Sprintf(\"%v\", fencing.IsParked(nil)))\n340|}\n341|\n342|// --- hostchannel ---\n343|\n344|func gridHostchannel() {\n345|\targv, err := hostchannel.LaunchArgv(peeridentity.Target{})\n346|\tif err != nil {\n347|\t\temitErr(\"hostchannel\", \"LaunchArgv\", \"zero-target\", err)\n348|\t} else {\n349|\t\temit(\"hostchannel\", \"LaunchArgv\", \"zero-target\", \"ok\", \"\", strings.Join(argv, \" \"))\n350|\t}\n351|\temit(\"hostchannel\", \"AuthorityListOverflow\", \"nil\", \"ok\", \"\", fmt.Sprintf(\"%v\", hostchannel.AuthorityListOverflow(nil)))\n352|\temit(\"hostchannel\", \"AuthorityListOverflow\", \"one\", \"ok\", \"\", fmt.Sprintf(\"%v\", hostchannel.AuthorityListOverflow([][]byte{[]byte(\"a\")})))\n353|\tline, err := hostchannel.ReadLine(strings.NewReader(\"hello\\nrest\"))\n354|\tif err != nil {\n355|\t\temitErr(\"hostchannel\", \"ReadLine\", \"line\", err)\n356|\t} else {\n357|\t\temit(\"hostchannel\", \"ReadLine\", \"line\", \"ok\", \"\", string(line))\n358|\t}\n359|\t_, err = hostchannel.ReadLine(strings.NewReader(\"\"))\n360|\temitErr(\"hostchannel\", \"ReadLine\", \"empty\", err)\n361|}\n362|\n363|// --- hosttrust ---\n364|\n365|func gridHosttrust() {\n366|\temit(\"hosttrust\", \"SHA256HexOf\", \"fixed\", \"ok\", \"\", hosttrust.SHA256HexOf([]byte(\"grid-fixture\")))\n367|\tfor _, relative := range []string{\"trust/roots.json\", \"sessions/data.json\", \"\"} {\n368|\t\temit(\"hosttrust\", \"MatchExcludedFromReplication\", fmt.Sprintf(\"relative=%q\", relative), \"ok\", \"\", fmt.Sprintf(\"%v\", hosttrust.MatchExcludedFromReplication(relative)))\n369|\t}\n370|\tfor _, base := range []string{\"tmp\", \"trust\", \"\"} {\n371|\t\temit(\"hosttrust\", \"ExcludedConfigDirName\", fmt.Sprintf(\"base=%q\", base), \"ok\", \"\", fmt.Sprintf(\"%v\", hosttrust.ExcludedConfigDirName(base)))\n372|\t}\n373|\temit(\"hosttrust\", \"ExcludedFromReplication\", \"none\", \"ok\", \"\", joinSorted(hosttrust.ExcludedFromReplication()))\n374|}\n375|\n376|// --- localstore ---\n377|\n378|func gridLocalstore() {\n379|\tzero := scalar.Digest{}\n380|\tpath, err := localstore.DigestPathV1(zero, localstore.PathStylePOSIX)\n381|\tif err != nil {\n382|\t\temitErr(\"localstore\", \"DigestPathV1\", \"zero-posix\", err)\n383|\t} else {\n384|\t\temit(\"localstore\", \"DigestPathV1\", \"zero-posix\", \"ok\", \"\", path)\n385|\t}\n386|\t_, err = localstore.DigestPathV1(zero, \"bogus-style\")\n387|\temitErr(\"localstore\", \"DigestPathV1\", \"zero-bogus-styl