{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cc4b","stream":{"kind":"session","id":"01a0ca08-6c63-7352-b762-5bc242c771c8"},"sequence":1152,"recorded_at":1780531400002299,"record_type":"event","durability":"durable","causation_id":"cd8feb9b-6d69-49ce-a85c-818ca818e251","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cd8feb9b-6d69-49ce-a85c-818ca818e251","run_stream":{"kind":"run","id":"cd8feb9b-6d69-49ce-a85c-818ca818e251"},"task_stream":{"kind":"task","id":"01a0ca0e-5daf-7d72-ac92-8e706a143518"},"task_id":"01a0ca0e-5daf-7d72-ac92-8e706a143518","event":{"kind":"output","task_id":"01a0ca0e-5daf-7d72-ac92-8e706a143518","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2t4g7i/worktree/internal/termbind/overlap_test.go`.\n1|package termbind\n2|\n3|import (\n4|\t\"os\"\n5|\t\"path/filepath\"\n6|\t\"testing\"\n7|)\n8|\n9|// TestAttachStorePeers pins the stored peer census the attach\n10|// overlap gate fails closed on: every recorded receipt for the\n11|// instance except the requesting client, sorted by client ID.\n12|func TestAttachStorePeers(t *testing.T) {\n13|\tstore, err := OpenAttachStore(t.TempDir())\n14|\tif err != nil {\n15|\t\tt.Fatal(err)\n16|\t}\n17|\tnow := fixtureNow()\n18|\tif _, _, err := store.Attach(fixtureSession, fixtureInstance, fixtureClient, \"local_only\", true, validAttachAuth(t, \"local_only\", true), now); err != nil {\n19|\t\tt.Fatal(err)\n20|\t}\n21|\tif _, _, err := store.Attach(fixtureSession, fixtureInstance, fixtureClientB, \"local_only\", false, validAttachAuth(t, \"local_only\", false), now); err != nil {\n22|\t\tt.Fatal(err)\n23|\t}\n24|\tpeers, err := store.Peers(fixtureSession, fixtureInstance, fixtureClient)\n25|\tif err != nil {\n26|\t\tt.Fatal(err)\n27|\t}\n28|\tif len(peers) != 1 || peers[0].ClientID != fixtureClientB || peers[0].InputAuthorized {\n29|\t\tt.Fatalf(\"peers = %+v, want exactly the other client without input\", peers)\n30|\t}\n31|\tpeers, err = store.Peers(fixtureSession, fixtureInstance, fixtureClientB)\n32|\tif err != nil {\n33|\t\tt.Fatal(err)\n34|\t}\n35|\tif len(peers) != 1 || peers[0].ClientID != fixtureClient || !peers[0].InputAuthorized {\n36|\t\tt.Fatalf(\"peers = %+v, want exactly the input-authorized other client\", peers)\n37|\t}\n38|}\n39|\n40|// TestAttachStorePeersEmpty pins the no-peer cases: an unrecorded\n41|// instance and a lone client both report no peers.\n42|func TestAttachStorePeersEmpty(t *testing.T) {\n43|\tstore, err := OpenAttachStore(t.TempDir())\n44|\tif err != nil {\n45|\t\tt.Fatal(err)\n46|\t}\n47|\tpeers, err := store.Peers(fixtureSession, fixtureInstance, fixtureClient)\n48|\tif err != nil {\n49|\t\tt.Fatal(err)\n50|\t}\n51|\tif len(peers) != 0 {\n52|\t\tt.Fatalf(\"peers = %+v, want none for an unrecorded instance\", peers)\n53|\t}\n54|\tif _, _, err := store.Attach(fixtureSession, fixtureInstance, fixtureClient, \"local_only\", true, validAttachAuth(t, \"local_only\", true), fixtureNow()); err != nil {\n55|\t\tt.Fatal(err)\n56|\t}\n57|\tpeers, err = store.Peers(fixtureSession, fixtureInstance, fixtureClient)\n58|\tif err != nil {\n59|\t\tt.Fatal(err)\n60|\t}\n61|\tif len(peers) != 0 {\n62|\t\tt.Fatalf(\"peers = %+v, want none for a lone client\", peers)\n63|\t}\n64|}\n65|\n66|// TestAttachStorePeersFailsClosed pins the census health rule: an\n67|// unreadable peer receipt is unknown, never an empty census, and\n68|// staging files are skipped rather than decoded.\n69|func TestAttachStorePeersFailsClosed(t *testing.T) {\n70|\tstore, err := OpenAttachStore(t.TempDir())\n71|\tif err != nil {\n72|\t\tt.Fatal(err)\n73|\t}\n74|\tnow := fixtureNow()\n75|\tif _, _, err := store.Attach(fixtureSession, fixtureInstance, fixtureClient, \"local_only\", true, validAttachAuth(t, \"local_only\", true), now); err != nil {\n76|\t\tt.Fatal(err)\n77|\t}\n78|\tif _, _, err := store.Attach(fixtureSession, fixtureInstance, fixtureClientB, \"local_only\", false, validAttachAuth(t, \"local_only\", false), now); err != nil {\n79|\t\tt.Fatal(err)\n80|\t}\n81|\tdir := filepath.Join(store.root, \"termbind\", \"attach\", fixtureInstance)\n82|\tif err := os.WriteFile(filepath.Join(dir, \"attach-staging.tmp\"), []byte(\"incomplete\"), 0o600); err != nil {\n83|\t\tt.Fatal(err)\n84|\t}\n85|\tif peers, err := store.Peers(fixtureSession, fixtureInstance, fixtureClient); err != nil || len(peers) != 1 {\n86|\t\tt.Fatalf(\"peers = %+v, err = %v; want the peer past the staging file\", peers, err)\n87|\t}\n88|\tif err := os.WriteFile(filepath.Join(dir, fixtureClientB+\".json\"), []byte(\"corrupt\"), 0o600); err != nil {\n89|\t\tt.Fatal(err)\n90|\t}\n91|\tif peers, err := store.Peers(fixtureSession, fixtureInstance, fixtureClient); err == nil {\n92|\t\tt.Fatalf(\"peers = %+v, want the decode error instead of a census\", peers)\n93|\t}\n94|}\n95|\n96|// TestAttachStorePeersDirectoryFailsClosed pins the census\n97|// namespace rule: entries outside the receipt namespace — staging\n98|// entries (attach-*) and non-receipt names, files or directories —\n99|// are skipped, but a directory at a receipt-shaped name is\n100|// corruption and errors instead of reading as no peers.\n101|func TestAttachStorePeersDirectoryFailsClosed(t *testing.T) {\n102|\tstore, err := OpenAttachStore(t.TempDir())\n103|\tif err != nil {\n104|\t\tt.Fatal(err)\n105|\t}\n106|\tnow := fixtureNow()\n107|\tif _, _, err := store.Attach(fixtureSession, fixtureInstance, fixtureClient, \"local_only\", true, validAttachAuth(t, \"local_only\", true), now); err != nil {\n108|\t\tt.Fatal(err)\n109|\t}\n110|\tif _, _, err := store.Attach(fixtureSession, fixtureInstance, fixtureClientB, \"local_only\", false, validAttachAuth(t, \"local_only\", false), now); err != nil {\n111|\t\tt.Fatal(err)\n112|\t}\n113|\tdir := filepath.Join(store.root, \"termbind\", \"attach\", fixtureInstance)\n114|\tif err := os.WriteFile(filepath.Join(dir, \"attach-staging.tmp\"), []byte(\"incomplete\"), 0o600); err != nil {\n115|\t\tt.Fatal(err)\n116|\t}\n117|\tif err := os.Mkdir(filepath.Join(dir, \"attach-old.tmp\"), 0o755); err != nil {\n118|\t\tt.Fatal(err)\n119|\t}\n120|\tif err := os.Mkdir(filepath.Join(dir, \"scratch\"), 0o755); err != nil {\n121|\t\tt.Fatal(err)\n122|\t}\n123|\tif err := os.WriteFile(filepath.Join(dir, \"notes.txt\"), []byte(\"operator notes\"), 0o600); err != nil {\n124|\t\tt.Fatal(err)\n125|\t}\n126|\tif peers, err := store.Peers(fixtureSession, fixtureInstance, fixtureClient); err != nil || len(peers) != 1 {\n127|\t\tt.Fatalf(\"peers = %+v, err = %v; want the peer past the non-receipt entries\", peers, err)\n128|\t}\n129|\treceipt := filepath.Join(dir, fixtureClientB+\".json\")\n130|\traw, err := os.ReadFile(receipt)\n131|\tif err != nil {\n132|\t\tt.Fatal(err)\n133|\t}\n134|\tif err := os.Remove(receipt); err != nil {\n135|\t\tt.Fatal(err)\n136|\t}\n137|\tif err := os.Mkdir(receipt, 0o755); err != nil {\n138|\t\tt.Fatal(err)\n139|\t}\n140|\tif err := os.WriteFile(filepath.Join(receipt, \"original.json\"), raw, 0o600); err != nil {\n141|\t\tt.Fatal(err)\n142|\t}\n143|\tif peers, err := store.Peers(fixtureSession, fixtureInstance, fixtureClient); err == nil {\n144|\t\tt.Fatalf(\"peers = %+v, want the census error instead of a census past the receipt directory\", peers)\n145|\t}\n146|}\n147|\n148|// TestAttachStorePeersRejectsForeignReceipt pins the binding rule:\n149|// a receipt filed under this instance that names another session\n150|// or instance is corruption, never a peer.\n151|func TestAttachStorePeersRejectsForeignReceipt(t *testing.T) {\n152|\tstore, err := OpenAttachStore(t.TempDir())\n153|\tif err != nil {\n154|\t\tt.Fatal(err)\n155|\t}\n156|\tnow := fixtureNow()\n157|\tif _, _, err := store.Attach(fixtureSession, fixtureInstance, fixtureClient, \"local_only\", true, validAttachAuth(t, \"local_only\", true), now); err != nil {\n158|\t\tt.Fatal(err)\n159|\t}\n160|\tforeign, err := encodeAttachReceipt(AttachReceipt{\n161|\t\tSessionID:          fixtureSession,\n162|\t\tTerminalInstanceID: fixtureBootstrap,\n163|\t\tClientID:           fixtureClientB,\n164|\t\tTransport:          \"local_only\",\n165|\t}, fixtureCreatedAt)\n166|\tif err != nil {\n167|\t\tt.Fatal(err)\n168|\t}\n169|\tdir := filepath.Join(store.root, \"termbind\", \"attach\", fixtureInstance)\n170|\tif err := os.WriteFile(filepath.Join(dir, fixtureClientB+\".json\"), foreign, 0o600); err != nil {\n171|\t\tt.Fatal(err)\n172|\t}\n173|\tif peers, err := store.Peers(fixtureSession, fixtureInstance, fixtureClient); err == nil {\n174|\t\tt.Fatalf(\"peers = %+v, want the binding error instead of a census\", peers)\n175|\t}\n176|}","final_result":true}}}
