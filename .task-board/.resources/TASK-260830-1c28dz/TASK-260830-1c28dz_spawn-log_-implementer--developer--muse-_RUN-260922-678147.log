{"schema_version":1,"id":"018f0000-0000-7000-8000-00000000cccf","stream":{"kind":"session","id":"01a0ca08-6c63-7352-b762-5bc242c771c8"},"sequence":1218,"recorded_at":1780531400002431,"record_type":"event","durability":"durable","causation_id":"cd8feb9b-6d69-49ce-a85c-818ca818e251","payload_type":"task.lifecycle.output","payload_schema_version":1,"payload":{"kind":"task_lifecycle","command_id":"cd8feb9b-6d69-49ce-a85c-818ca818e251","run_stream":{"kind":"run","id":"cd8feb9b-6d69-49ce-a85c-818ca818e251"},"task_stream":{"kind":"task","id":"01a0ca0f-06dd-7c83-8267-4b4f75c8b399"},"task_id":"01a0ca0f-06dd-7c83-8267-4b4f75c8b399","event":{"kind":"output","task_id":"01a0ca0f-06dd-7c83-8267-4b4f75c8b399","chunk":"Read text file `/Users/iv/Developer/ReluxWorks/agent-session-manager/.temp/STORY-260830-2t4g7i/worktree/internal/tmuxserver/lifecycle_rev8_unix_test.go`.\n(101 line(s) above)\n102|func TestExecuteStopEscalatesAfterGracefulTimeoutAlone(t *testing.T) {\n103|\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n104|\tfx.runner.queue(\"send-keys\", \"\", 0).queue(\"has-session\", \"\", 0).\n105|\t\tqueue(\"kill-session\", \"\", 0).\n106|\t\tqueueFull(\"has-session\", \"\", \"can't find session: \"+lxInstance, 1)\n107|\tseen := false\n108|\tfx.runner.onRun = func(argv []string) {\n109|\t\tif len(argv) >= 4 && argv[3] == \"has-session\" && !seen {\n110|\t\t\tseen = true\n111|\t\t\tfx.clock.Sleep(10 * time.Millisecond)\n112|\t\t}\n113|\t}\n114|\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n115|\t\tOperation: \"request-stop\", Body: lxStopBody(t, 5, nil), Source: \"quiescing\", Admitted: fullLifecycleAdmitted(),\n116|\t})\n117|\tif err != nil {\n118|\t\tt.Fatal(err)\n119|\t}\n120|\tif got := fx.runner.subcommands(); len(got) != 4 || got[0] != \"send-keys\" || got[1] != \"has-session\" || got[2] != \"kill-session\" || got[3] != \"has-session\" {\n121|\t\tt.Fatalf(\"calls = %v, want the graceful poll, one escalation, and the re-confirm\", got)\n122|\t}\n123|\tif outcome.Mutation.After != terminalbackend.StateStopped {\n124|\t\tt.Fatalf(\"after = %s\", outcome.Mutation.After)\n125|\t}\n126|}\n127|\n128|// TestExecuteQuiesceRefusesStaleFactsBetweenCommands pins the\n129|// within-effect revalidation on the quiesce path: the lock runs,\n130|// exactly one admission fact changes during its round trip, and\n131|// the detach must refuse without issuing. The lock/detach pair is\n132|// one effect with two destructive commands; the boundary between\n133|// them re-proves the facts the engine checked before the effect.\n134|// The deadline fact probes both the strictly-past instant and the\n135|// on-deadline instant: both refuse, and the authorization expired\n136|// thirty minutes before the recheck, so the minus-one-hour\n137|// narrowing admits it while the unmutated clock still refuses.\n138|func TestExecuteQuiesceRefusesStaleFactsBetweenCommands(t *testing.T) {\n139|\tfor _, fact := range []string{\"generation\", \"authorization\", \"deadline\", \"deadline-instant\"} {\n140|\t\tt.Run(fact, func(t *testing.T) {\n141|\t\t\tfx := newLifecycleFixture(t, fullLifecycleAdmitted())\n142|\t\t\tgeneration := lxGeneration\n143|\t\t\tfx.lc.CurrentGeneration = func() string { return generation }\n144|\t\t\traw := lxQuiesceBody(t, func(object map[string]any) {\n145|\t\t\t\tif fact == \"authorization\" {\n146|\t\t\t\t\tobject[\"context\"].(map[string]any)[\"authorization\"].(map[string]any)[\"expires_at\"] = \"2026-09-01T13:30:00.000Z\"\n147|\t\t\t\t}\n148|\t\t\t})\n149|\t\t\t// The detach is queued so a regression fails on\n150|\t\t\t// the detach-absence assertion with the\n151|\t\t\t// forbidden command recorded.\n152|\t\t\tfx.runner.queue(\"lock-session\", \"\", 0).queue(\"detach-client\", \"\", 0)\n153|\t\t\tfx.runner.onRun = func(argv []string) {\n154|\t\t\t\tif len(argv) < 4 || argv[3] != \"lock-session\" {\n155|\t\t\t\t\treturn\n156|\t\t\t\t}\n157|\t\t\t\tswitch fact {\n158|\t\t\t\tcase \"generation\":\n159|\t\t\t\t\tgeneration = \"generation-two\"\n160|\t\t\t\tcase \"authorization\":\n161|\t\t\t\t\tfx.clock.Sleep(2 * time.Hour)\n162|\t\t\t\tcase \"deadline\":\n163|\t\t\t\t\tfx.clock.Sleep(7 * time.Hour)\n164|\t\t\t\tcase \"deadline-instant\":\n165|\t\t\t\t\tfx.clock.Sleep(6 * time.Hour)\n166|\t\t\t\t}\n167|\t\t\t}\n168|\t\t\toutcome, err := fx.lc.Execute(context.Background(), OpRequest{\n169|\t\t\t\tOperation: \"quiesce-input\", Body: raw, Source: \"active\", Admitted: fullLifecycleAdmitted(),\n170|\t\t\t})\n171|\t\t\tfor _, command := range fx.runner.subcommands() {\n172|\t\t\t\tif command == \"detach-client\" {\n173|\t\t\t\t\tt.Fatalf(\"detach-client issued after %s went stale during the lock: err=%v mutation=%+v\", fact, err, outcome.Mutation)\n174|\t\t\t\t}\n175|\t\t\t}\n176|\t\t\tswitch fact {\n177|\t\t\tcase \"generation\":\n178|\t\t\t\trequireEngineCode(t, err, \"terminal_backend_stale_generation\")\n179|\t\t\tcase \"authorization\":\n180|\t\t\t\trequireEngineCode(t, err, \"terminal_backend_unauthorized\")\n181|\t\t\tcase \"deadline\", \"deadline-instant\":\n182|\t\t\t\trequireEngineCode(t, err, \"terminal_backend_timeout\")\n183|\t\t\t}\n184|\t\t\tif outcome.Mutation == nil {\n185|\t\t\t\tt.Fatalf(\"refused quiesce omits its mutation: err=%v\", err)\n186|\t\t\t}\n187|\t\t\tif len(outcome.Mutation.Effects) != 0 {\n188|\t\t\t\tt.Fatalf(\"effects = %v, want none performed\", outcome.Mutation.Effects)\n189|\t\t\t}\n190|\t\t})\n191|\t}\n192|}\n193|\n194|// TestBackendPostWaitBoundaryRefusesWithoutRecheck pins the\n195|// fail-closed wiring: a post-wait destructive boundary with no\n196|// configured revalidation refuses instead of running blind. The\n197|// production entries always configure it; this helper-level pin\n198|// documents the nil contract both guarded sites share.\n199|func TestBackendPostWaitBoundaryRefusesWithoutRecheck(t *testing.T) {\n200|\tt.Run(\"escalation\", func(t *testing.T) {\n201|\t\trunner := newFakeRunner().queue(\"has-session\", \"\", 0).queue(\"kill-session\", \"\", 0)\n202|\t\treqBackend := effectBackend(t, terminalbackend.OperationRequestStop, runner)\n203|\t\treqBackend.recheck = nil\n204|\t\treqBackend.deadline = lxNow().Add(-time.Minute)\n205|\t\t_, err := reqBackend.PerformEffect(context.Background(), terminalbackend.EffectProcessClosed)\n206|\t\trequireEngineCode(t, err, \"terminal_backend_protocol_error\")\n207|\t\tfor _, command := range runner.subcommands() {\n208|\t\t\tif command == \"kill-session\" {\n209|\t\t\t\tt.Fatalf(\"kill-session issued with no revalidation configured\")\n210|\t\t\t}\n211|\t\t}\n(more lines below)","final_result":true}}}
