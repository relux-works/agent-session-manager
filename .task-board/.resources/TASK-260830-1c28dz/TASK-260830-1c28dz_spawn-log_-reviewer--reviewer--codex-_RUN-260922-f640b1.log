#!/usr/bin/env python3
"""OUTCOME-keyed base-vs-candidate comparison for go test -json streams.

Keys final per-test outcomes by full test name (subtests included as
Parent/Child). Reports: base PASS retained, regressions (base PASS that
is missing/failed/skipped in candidate), and new candidate tests.
Exit 1 on any regression.
"""
import json
import sys


def outcomes(path):
    out = {}
    with open(path) as f:
        for line in f:
            line = line.strip()
            if not line.startswith("{"):
                continue
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            if ev.get("Action") in ("pass", "fail", "skip") and ev.get("Test"):
                out[ev["Test"]] = ev["Action"]
    return out


def main(base_path, cand_path):
    base = outcomes(base_path)
    cand = outcomes(cand_path)
    base_pass = {t for t, a in base.items() if a == "pass"}
    base_nonpass = {t: a for t, a in base.items() if a != "pass"}
    regressions = {}
    for t in sorted(base_pass):
        if t not in cand:
            regressions[t] = "MISSING in candidate"
        elif cand[t] != "pass":
            regressions[t] = f"base pass -> candidate {cand[t]}"
    new_tests = sorted(t for t in cand if t not in base)
    removed = sorted(t for t in base if t not in cand)

    print(f"base: {len(base)} tests "
          f"({len(base_pass)} pass, {len(base_nonpass)} non-pass)")
    for t, a in sorted(base_nonpass.items()):
        print(f"  base non-pass: {t} :: {a}")
    print(f"candidate: {len(cand)} tests "
          f"({sum(1 for a in cand.values() if a == 'pass')} pass, "
          f"{sum(1 for a in cand.values() if a == 'fail')} fail, "
          f"{sum(1 for a in cand.values() if a == 'skip')} skip)")
    print(f"base PASS retained: {len(base_pass) - len(regressions)}/{len(base_pass)}")
    if regressions:
        print(f"REGRESSIONS ({len(regressions)}):")
        for t, why in regressions.items():
            print(f"  {t} :: {why}")
    if [t for t in removed if t not in base_pass]:
        print("removed non-pass base tests:")
        for t in removed:
            if t not in base_pass:
                print(f"  {t} :: was {base[t]}")
    print(f"new candidate tests ({len(new_tests)}):")
    for t in new_tests:
        print(f"  + {t} :: {cand[t]}")
    if regressions:
        return 1
    print("COMPARISON CLEAN: zero regressions")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1], sys.argv[2]))
