					mustPark(t, err, ParkStaleOwner, fenceLeaseA, ErrStaleOwner, name+"/"+vector)
				} else {
					mustRefuse(t, err, ErrStaleOwner, name+"/"+vector)
				}
			})
		}
	}
}

