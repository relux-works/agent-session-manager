+		"stale_epoch":  {SessionID: fixtureSessionA, Epoch: 1, LeaseID: fixtureLeaseB},
+		"losing_lease": {SessionID: fixtureSessionA, Epoch: 2, LeaseID: fixtureLeaseB},
