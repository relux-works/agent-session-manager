+			if !strings.Contains(err.Error(), "lease_conflict") || strings.Contains(err.Error(), "stale_owner") {
+				t.Fatalf("%s/local_lapsed_stale = %v, want literal lease_conflict without stale_owner", name, err)
+			}
+		})
+	}
+}
