					sh.shape(&observation)
					state, transitioned, err := ObserveFencing(current, tok.p, observation)
					t.Logf("%s / %s / %s / from %s :: state=%s transitioned=%v err=%v", winner.name, tok.name, sh.name, current, state, transitioned, err)
				}
			}
		}
	}
}
