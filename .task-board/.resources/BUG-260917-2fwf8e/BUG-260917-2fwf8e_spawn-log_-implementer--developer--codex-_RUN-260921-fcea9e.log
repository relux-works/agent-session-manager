package axpane

// Reviewer probes for CR-BUG-260917-2fwf8e-1 (rev 1): probe 10 of
// TASK-260830-1geqhj_review-evidence-rev1 reproduced verbatim at the
// composed Decide entry, plus the step-away vectors. Report-only.

import (
