   100	// observeRemoteWinner resolves a remote-winner park: the winner is on
   101	// another host and the presented token may be stale relative to it (the
   102	// force-takeover case) or the winning token itself observed from afar.
   103	// The landed gate decides from the winner's own host; only a stale
   104	// verdict fences, and only from a live incarnation.
   105	func observeRemoteWinner(current terminalbackend.InstanceState, presented fencing.PresentedToken, observation fencing.Observation, authErr error) (terminalbackend.InstanceState, bool, error) {
   106		relative := observation
   107		relative.LocalHostID = observation.Winner.HolderHostID
   108		_, relativeErr := fencing.Authorize(fencing.OperationRestore, presented, relative)
   109		if relativeErr == nil {
   110			return current, false, authErr
   111		}
   112		if relativeReason, _, relativeParked := fencing.ParkDetails(relativeErr); relativeParked && relativeReason == fencing.ParkStaleOwner {
   113			return fenceLive(current, authErr)
   114		}
   115		// A lapsed grant can defer the relative question before its tuple arm;
   116		// the grant-independent verdict still fences a stale incarnation.
   117		if stale, decided := fencing.StaleRelativeToWinner(presented, observation); decided && stale {
   118			return fenceLive(current, authErr)
   119		}
   120		return current, false, authErr
   121	}
