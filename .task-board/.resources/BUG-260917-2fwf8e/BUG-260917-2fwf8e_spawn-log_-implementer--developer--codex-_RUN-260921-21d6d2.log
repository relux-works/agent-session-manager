   123	// fenceLive moves a live incarnation to stale_fenced and leaves every
   124	// other source untouched with the refusal or park that proved
   125	// staleness. Absent and stopped name no incarnation, stale_fenced is
   126	// already fenced, and unavailable is unknown: none of them transitions.
   127	func fenceLive(current terminalbackend.InstanceState, authErr error) (terminalbackend.InstanceState, bool, error) {
   128		switch current {
   129		case terminalbackend.StateCreating, terminalbackend.StateParked,
   130			terminalbackend.StateActive, terminalbackend.StateQuiescing:
   131			return terminalbackend.StateStaleFenced, true, nil
   132		default:
   133			return current, false, authErr
   134		}
