+// TestBUG260917Probe10BeforeFix reproduces the archived reviewer vector on
+// the current tree without importing the other archived probes.
+func TestBUG260917Probe10BeforeFix(t *testing.T) {
+	deps := buildDecideDeps(t, true)
+	input := validInput(t, deps)
+	input.Observation = lapsedObservation(fixtureNow())
