+func TestDecideLapsedRemoteOwnerOffersOrParksByInteractiveContext(t *testing.T) {
+	cases := []struct {
+		name             string
+		attachAdmitted   bool
+		remoteInteractive bool
+		want             Action
+		wantReason       fencing.ParkReason
+	}{
+		{name: "interactive_attach", attachAdmitted: true, remoteInteractive: true, want: ActionAttachRemote},
+		{name: "interactive_takeover", attachAdmitted: false, remoteInteractive: true, want: ActionTakeoverOffer},
+		{name: "noninteractive_park", attachAdmitted: true, remoteInteractive: false, want: ActionParked, wantReason: fencing.ParkRemoteOwner},
+	}
+	for _, tc := range cases {
