+// remote owner parks with the existing remote_owner vocabulary.
+func TestDecideLapsedRemoteOwnerOffersOrParksByInteractiveContext(t *testing.T) {
+	cases := []struct {
+		name             string
+		attachAdmitted   bool
+		remoteInteractive bool
