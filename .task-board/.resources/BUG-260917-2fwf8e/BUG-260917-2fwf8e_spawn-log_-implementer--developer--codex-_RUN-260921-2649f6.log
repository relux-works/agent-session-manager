			CreateLeaseInput: sessrepo.CreateLeaseInput{LeaseID: fenceLeaseA, HolderHostID: fenceHostB, IssuedByHostID: fenceHostB, CreatedAt: fenceLeaseAt},
			Reason:           "graceful_takeover",
			CheckpointID:     fenceZeroDigest,
		})
