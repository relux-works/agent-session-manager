+func TestDecideLapsedRemoteOwnerOffersOrParksByInteractiveContext(t *testing.T) {
+	cases := []struct {
+		name              string
+		attachAdmitted    bool
+		remoteInteractive bool
+		want              Action
+		wantLiteral       string
+		wantReason        fencing.ParkReason
+		wantReasonLiteral string
+	}{
+		{name: "interactive_attach", attachAdmitted: true, remoteInteractive: true, want: ActionAttachRemote, wantLiteral: "attach_remote"},
+		{name: "interactive_takeover", attachAdmitted: false, remoteInteractive: true, want: ActionTakeoverOffer, wantLiteral: "takeover_offer"},
+		{name: "noninteractive_park", attachAdmitted: true, remoteInteractive: false, want: ActionParked, wantLiteral: "parked", wantReason: fencing.ParkRemoteOwner, wantReasonLiteral: "remote_owner"},
+	}
+	for _, tc := range cases {
